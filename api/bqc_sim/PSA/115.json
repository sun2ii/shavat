{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":115,"content":[{"type":"heading","content":["Dii mɛ́ ì báaadańgu"]},{"type":"verse","number":1,"content":[{"text":"I kɛ wá tↄ́ mɛ́ a bↄo Dii,","poem":1},{"lineBreak":true},{"text":"i kɛ wá tↄ́ mɛ́ a bↄo.","poem":1},{"lineBreak":true},{"text":"Ǹ nzĩa tↄbↄ n gbɛ̃kɛ ń n náaio yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Àkɛa buipãleↄ ì wá la aa mɛ","poem":1},{"lineBreak":true},{"text":"wá Lua kú má niɛi?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wá Lua ku musu,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ a yei ì kɛɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa ń diiↄ pì ń ã́nusuo ń vuao,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩna ↄgbɛɛ.","poem":1},{"noteId":215}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa lɛ́ vĩ, aali yã'oo,","poem":1},{"lineBreak":true},{"text":"aa wɛ́ vĩ, aali gu'e sↄ̃o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa swã́ vĩ, aali yãmao,","poem":1},{"lineBreak":true},{"text":"aa ní vĩ, kási aali pↄ́ gĩmao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa ↄ vĩ, aali kã́ pↄ́wao,","poem":1},{"lineBreak":true},{"text":"aa gbá vĩ, kási aali táa'oo.","poem":1},{"lineBreak":true},{"text":"Aali kolokɛkɛo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"An pinaↄ gↄ̃ńwaɛ","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ lɛ́ ń náaikɛↄ.","poem":1},{"noteId":216}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Isailiↄ, à Dii náaikɛ!","poem":1},{"lineBreak":true},{"text":"Ɔ̃mɛ á sɛ̀ngbao ũ, ì dↄálɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aalona buiↄ, à Dii náaikɛ!","poem":1},{"lineBreak":true},{"text":"Ɔ̃mɛ á sɛ̀ngbao ũ, ì dↄálɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii vĩakɛnaↄ, à Dii náaikɛ!","poem":1},{"lineBreak":true},{"text":"Ɔ̃mɛ á sɛ̀ngbao ũ, ì dↄálɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wá yã́ lí sã́ Diiguo,","poem":1},{"lineBreak":true},{"text":"a báaadawágu.","poem":1},{"lineBreak":true},{"text":"A báaada Isaili buiↄgu,","poem":1},{"lineBreak":true},{"text":"a báaada Aalona buiↄgu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dii a báaada a vĩakɛnaↄgu,","poem":1},{"lineBreak":true},{"text":"nɛ́fɛ̃nɛn gbɛ̃zↄ̃ↄ.","poem":1},{"noteId":217}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii kã́fĩakɛɛ́,","poem":1},{"lineBreak":true},{"text":"ápiↄ ń á nɛ́ↄ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dii mɛ́ a báaadaágu,","poem":1},{"lineBreak":true},{"text":"musu ń tↄↄlɛo Kɛnapi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Musuá Dii bɛɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à tↄↄlɛ nà gbɛ̃nazĩnaↄnɛ ń ↄzĩ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I kɛ gɛↄ mɛ́ lí Dii táasilɛo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kú bɛdauↄ ìↄ ku kílikiliɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wápiↄ, wáↄ Dii sáaukpa","poem":1},{"lineBreak":true},{"text":"za gbã e gↄↄpiiɛ.","poem":1},{"lineBreak":true},{"text":"Àleluya!","poem":1}]}],"footnotes":[{"noteId":215,"caller":"+","text":"115.4 Zia 9.20","reference":{"chapter":115,"verse":4}},{"noteId":216,"caller":"+","text":"115.8 Soũ 135.15-18","reference":{"chapter":115,"verse":8}},{"noteId":217,"caller":"+","text":"115.13 Zia 11.18, 19.5","reference":{"chapter":115,"verse":13}}]},"thisChapterLink":"/api/bqc_sim/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}