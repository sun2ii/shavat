{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":116,"content":[{"type":"heading","content":["Gbɛ̃́ pↄ́ bↄ̀ ga lɛ́zĩ Dii sáaukpaa"]},{"type":"verse","number":1,"content":[{"text":"Má ye Diizi,","poem":1},{"lineBreak":true},{"text":"asa à ma yãmàɛ,","poem":1},{"lineBreak":true},{"text":"à ma wiilɛawa mà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Máↄ aà sísi e ma wɛ̃ni lɛ́uɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ à swãdↄ̀mazi yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ga fùa kpàmɛɛ yãa,","poem":1},{"lineBreak":true},{"text":"má kú yeelɛa zↄ̃ↄ guu,","poem":1},{"lineBreak":true},{"text":"taasi ń pↄsiao tↄ̃̀a.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɔ̃ ma lɛzù Diizi ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Dii, n yã́ na, ma misi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii sùuu vĩ mɛ́ a maa,","poem":1},{"lineBreak":true},{"text":"wá Lua sósobi vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii ì yɛ̃̀ɛɛsaideↄ dↄ̃́a.","poem":1},{"lineBreak":true},{"text":"Kɛ́ ma gↄ̃ dↄ̀lↄlↄ, à ma suabà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma nↄ̀sɛ aↄ nínia sa,","poem":1},{"lineBreak":true},{"text":"asa Dii yãmaakɛ̀mɛɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii ma bↄ ga lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"à wɛ́'i gògomɛɛ,","poem":1},{"lineBreak":true},{"text":"i to ma gɛ̃nalɛ̀o,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kɛ́ màↄ ku dṹnia guu,","poem":1},{"lineBreak":true},{"text":"míↄ bɛ aà aɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kɛ́ taasi tↄ̃̀a, ma gↄ̃ búɛbuɛ.","poem":1},{"lineBreak":true},{"text":"Ma aà náaikɛ̀, ↄ̃ ma yã'ò.","poem":1},{"noteId":218}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gili gɛ̃̀magu ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Gbɛ̃e mↄafilisaio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bↄ́ má fĩaboò Diiɛ","poem":1},{"lineBreak":true},{"text":"maa pↄ́ a kɛ̀mɛɛ píi yã́ musui?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Má Dii gbɛ̃́ suabaa imibↄ sɛ musu,","poem":1},{"lineBreak":true},{"text":"mí aà sísiò.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Má lɛ́ pↄ́ má kɛ̀ Diiwaↄ fĩabo","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃́ↄ wáa píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dii yãmanaↄ gaa gbiaɛ̀.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dii, n yã́ na, n zↄ̀blenan ma ũ.","poem":1},{"lineBreak":true},{"text":"Nↄɛ pↄ́ zↄblènɛ nɛ́n ma ũ,","poem":1},{"lineBreak":true},{"text":"n ma bↄ bau.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Má sáaukpa sa'oma,","poem":1},{"lineBreak":true},{"text":"mí ń sísiò, Dii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Má lɛ́ pↄ́ má kɛ̀ Diiwaↄ fĩabo","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃́ↄ wáa píi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Má fĩaboɛ̀ aà ua Yelusalɛũ.","poem":1},{"lineBreak":true},{"text":"Àleluya!","poem":1}]}],"footnotes":[{"noteId":218,"caller":"+","text":"116.10 2Kln 4.13","reference":{"chapter":116,"verse":10}}]},"thisChapterLink":"/api/bqc_sim/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}