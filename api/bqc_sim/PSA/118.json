{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":118,"content":[{"type":"heading","content":["Gɛa Dii ua ń sáaukpaao"]},{"type":"verse","number":1,"content":[{"text":"À Dii sáaukpa, asa a maa,","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃kɛ láaa vĩo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Isailiↄ o,","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃kɛ láaa vĩo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aalona buiↄ o,","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃kɛ láaa vĩo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aà vĩakɛnaↄ o,","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃kɛ láaa vĩo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma lɛzù Diizi ma yeelɛa guu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ a wèa à ma gba dɛ̀ɛpookĩi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii kumanↄ, vĩa a ma kũo,","poem":1},{"lineBreak":true},{"text":"bↄ́ gbɛ̃nazĩna a fↄ̃ kɛmɛɛi?","poem":1},{"noteId":220}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii kumanↄ ma dↄnlɛde ũ,","poem":1},{"lineBreak":true},{"text":"má tidↄ ma ibɛɛↄlaɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Naa Diizi maa dɛ","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩna náaikɛala.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Naa Diizi maa dɛ","poem":1},{"lineBreak":true},{"text":"gbãadeↄ náaikɛala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bui píi lìamazi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma ń kwɛ́ ń Dii tↄ́o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa lìamazi ↄplaai ń zɛɛo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma ń kwɛ́ ń Dii tↄ́o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa fĩ̀a lán zↄdaↄwa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa mìdɛ lán sɛ̃̀ tɛ́kũawa,","poem":1},{"lineBreak":true},{"text":"ma ń kwɛ́ ń Dii tↄ́o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Aa ↄzↄ̃̀mazi pãsĩpãsĩ,","poem":1},{"lineBreak":true},{"text":"má ye lɛ́lɛi, ↄ̃ Dii dↄ̀malɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii mɛ́ ma gbãa ũ, aà táasi mi lɛ́,","poem":1},{"lineBreak":true},{"text":"à gↄ̃̀ ma Suabana ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"À ma, kúkua dↄ gbɛ̃maaↄ bòou,","poem":1},{"lineBreak":true},{"text":"Dii ↄplaa gbãa zĩkɛ̀.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dii ↄplaa dↄa musu,","poem":1},{"lineBreak":true},{"text":"Dii ↄplaa gbãa zĩkɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Má gao, máↄ kuɛ,","poem":1},{"lineBreak":true},{"text":"míↄ Dii yãkɛaↄ galikɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dii ma swãgàga maamaa,","poem":1},{"lineBreak":true},{"text":"ãma i to ga ma sɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"À gbɛ̃́ suabaa bↄlɛ gbaↄ wɛ̃mɛɛ","poem":1},{"lineBreak":true},{"text":"mà gɛ̃ mà Dii sáaukpa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii ua bↄlɛ kɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maaↄ mɛ́ ì gɛ̃u.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ma n sáaukɛ̀ Dii, asa ń wèa,","poem":1},{"lineBreak":true},{"text":"n gↄ̃ ma Suabana ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Gbɛ pↄ́ ɛ̃bonaↄ pãkpài","poem":1},{"lineBreak":true},{"text":"mɛ́ gↄ̃̀ gbɛↄ mide ũ.","poem":1},{"noteId":221}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dii mɛ́ bee kɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à kɛ̀wɛ̃ɛ yãbↄnsaɛ ũ.","poem":1},{"noteId":222}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gↄↄ pↄ́ Dii dìlɛn kɛ.","poem":1},{"lineBreak":true},{"text":"Wà pↄnakɛu wà yáalↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"N yã́ na Dii! Wá suaba!","poem":1},{"lineBreak":true},{"text":"Suɛ Dii! Wá daɛ ń gòmio!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ lɛ́ mↄ́ ń Dii tↄ́o ũ,","poem":1},{"lineBreak":true},{"text":"kua Dii ua wálɛ gbãakpanzi.","poem":1},{"noteId":223}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Dii mɛ́ Lua ũ, à gupùwɛ̃ɛ.","poem":1},{"lineBreak":true},{"text":"À ba dↄdↄ sa'obↄↄwa,","poem":1},{"lineBreak":true},{"text":"í poo gbagbakĩizi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ma Luan n ũ, má n sáaukpa,","poem":1},{"lineBreak":true},{"text":"ma Lua, má n tↄbↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"À Dii sáaukpa, asa a maa,","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃kɛ láaa vĩo.","poem":1}]}],"footnotes":[{"noteId":220,"caller":"+","text":"118.6 Ɛbɛ 13.6","reference":{"chapter":118,"verse":6}},{"noteId":221,"caller":"+","text":"118.22 Luk 20.17, Zĩn 4.11, 1Piɛ 2.7","reference":{"chapter":118,"verse":22}},{"noteId":222,"caller":"+","text":"118.23 Mat 21.42, Maa 12.10-11","reference":{"chapter":118,"verse":23}},{"noteId":223,"caller":"+","text":"118.26 Mat 21.9, Maa 11.9, Luk 19.38, Zãa 12.13","reference":{"chapter":118,"verse":26}}]},"thisChapterLink":"/api/bqc_sim/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}