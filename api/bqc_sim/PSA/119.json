{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":119,"content":[{"type":"heading","content":["Gbãakpaa Lua yã́wa"]},{"type":"verse","number":1,"content":[{"text":"Báaadeↄn gbɛ̃́ pↄ́ aa ku tàaesai","poem":1},{"lineBreak":true},{"text":"aa Dii ikoyã kũaↄ ũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Báaadeↄn gbɛ̃́ pↄ́ aaì Dii yã'onɛ ma","poem":1},{"lineBreak":true},{"text":"aaì aà kĩ́i wɛɛlɛ ń nↄ̀sɛmɛndooↄ ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aali yãkpaanlakɛo,","poem":1},{"lineBreak":true},{"text":"aaì aà dↄ̀ↄ sɛ́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N n ↄtondↄkĩi ↄ̀lↄwɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ wàↄ tɛi ń laaio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Má ye màↄ ku ma dↄ̀ↄwaɛ,","poem":1},{"lineBreak":true},{"text":"míↄ n yãdilɛnɛↄ kũa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó má n yãdilɛaↄ kũa píi,","poem":1},{"lineBreak":true},{"text":"bee a to wí ma kũo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gↄↄ pↄ́ málɛ n yãmaapiↄ dada,","poem":1},{"lineBreak":true},{"text":"má n sáaukpa ń nↄ̀sɛpuaoɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Máↄ n yãdilɛnɛↄ kũaɛ,","poem":1},{"lineBreak":true},{"text":"ńsu ma to we míↄmiↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kpelewa ɛ̀waaso a kɛ àↄ ku gbãlɛsaii?","poem":1},{"lineBreak":true},{"text":"Sema aà yãkɛa kpaaĩ ń n yã́o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Málɛ n kĩ́i wɛɛlɛ ń nↄ̀sɛmɛndoo,","poem":1},{"lineBreak":true},{"text":"ńsu to mà pãalɛ n yãdilɛaↄnɛo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma n yã́ dà ma sↄ̃ guu,","poem":1},{"noteId":224},{"lineBreak":true},{"text":"kɛ́ másu duunakɛnɛo yã́i.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma n sáaukɛ̀, Dii,","poem":1},{"lineBreak":true},{"text":"ǹ n yãdilɛnɛↄ damɛɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N ikoyã pↄ́ bↄ̀ ń lɛ́uↄ píi,","poem":1},{"lineBreak":true},{"text":"má dau siu nɛ́ɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Málɛ pↄnakɛ ń n yã'onɛↄ","poem":1},{"lineBreak":true},{"text":"lá wì kɛ ń àizɛɛowa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Málɛ n ↄtondↄkĩi wàaipa,","poem":1},{"lineBreak":true},{"text":"ma làasoo ku n kɛkɛáↄwa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma pↄ kɛ̀na n yãdilɛaↄwa,","poem":1},{"lineBreak":true},{"text":"n yã́ a sãmaguo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Yãmaakɛ mapi n zↄ̀blenaɛ,","poem":1},{"lineBreak":true},{"text":"mí e màↄ ku màↄ n yã́ kũa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ma wɛ́ kɛ̃́mɛɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ mà wɛsi n ikoyã bↄnsaɛↄlɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Bↄ̀mↄn ma ũ dṹnia guu,","poem":1},{"noteId":225},{"lineBreak":true},{"text":"ńsu ǹ n yãdilɛaↄ ulɛmɛɛo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N ikoyãↄ nidɛa gↄↄpii","poem":1},{"lineBreak":true},{"text":"mɛ́ tò ma nisĩna vùa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ni waladeↄ lele, ni láaikɛmá,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ pã̀alɛ n yãdilɛaↄnɛpiↄ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ma bↄ sↄ̃́sↄ̃a ń sa pↄ́ aaì kamaguou,","poem":1},{"lineBreak":true},{"text":"asa má n yã'onɛↄ kũaɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Baa kɛ́ kíaↄ zↄ̃̀lɛ lɛkpàaĩmazi,","poem":1},{"lineBreak":true},{"text":"ma làasoo aↄ ku n yãdilɛnɛↄwaɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"N yã'onɛↄ mɛ́ ì ma pↄ kɛ na,","poem":1},{"lineBreak":true},{"text":"n yã́pi mɛ́ ì lɛdaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ma nisĩna naa líwa.","poem":1},{"lineBreak":true},{"text":"Ma misi lá ń òwa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ma a yãkɛaↄ dↄ̀dↄnɛ, ↄ̃ ń wèa.","poem":1},{"lineBreak":true},{"text":"Ǹ n yãdilɛnɛↄ damɛɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"To mà n ↄtondↄkĩiↄ dↄ̃,","poem":1},{"lineBreak":true},{"text":"ma làasoo iↄ ku n yãbↄnsaɛↄwa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kua pↄsiau ma nↄ̀sɛ ↄ́ↄlↄ̀.","poem":1},{"lineBreak":true},{"text":"Ma gba gbãa lá ń òwa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ma kɛ̃ sã́sãzɛwa,","poem":1},{"lineBreak":true},{"text":"ní ma gba zɛ́ mà zɛ ń n ikoyão.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ma sĩana zɛ́ sɛ̀,","poem":1},{"lineBreak":true},{"text":"ma sↄ̃ ìↄ ku n ikoyãwa.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Má n yã'onɛↄ kũa ↄplapla.","poem":1},{"lineBreak":true},{"text":"Dii, ńsu to wí ma kũo.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Má wãa ń n yãdilɛaↄ,","poem":1},{"lineBreak":true},{"text":"asa n ma sↄ̃ dàmɛɛ doũɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Dii, ǹ n yãdilɛnɛↄ zɛ́ ↄlↄmɛɛ","poem":1},{"lineBreak":true},{"text":"màↄ kũa e ma wɛ̃ni lɛ́u.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ma gba ↄ̃nↄ màↄ n ikoyã kũa,","poem":1},{"lineBreak":true},{"text":"míↄ zĩkɛwà ń nↄ̀sɛmɛndoo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ma da n yãdilɛaↄ zɛ́u,","poem":1},{"lineBreak":true},{"text":"asa bee mɛ́ ì kamagu.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"To ma sↄ̃ ta n yã'onɛↄwa,","poem":1},{"lineBreak":true},{"text":"asu tá gbɛ̃ble'aiwao.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"To ma wɛma pↄ́ gianaↄla,","poem":1},{"lineBreak":true},{"text":"ma lɛ́ ń láo n zɛ́ guu.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ ń ò kɛ mapi n zↄ̀blenaɛ,","poem":1},{"lineBreak":true},{"text":"lɛ́ pↄ́ ń gbɛ̃̀ n vĩakɛnaↄnɛpi.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"To sↄ̃́sↄ̃a pↄ́ má a vĩa vĩ gɛ̃ ma swã́ kpɛ,","poem":1},{"lineBreak":true},{"text":"asa n yãkɛkɛa maaɛ.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Má ye n ↄtondↄkĩii fá,","poem":1},{"lineBreak":true},{"text":"ma lɛ́ ń láo n maakɛa guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"Dii, mↄ gbɛ̃kɛkɛmɛɛ,","poem":1},{"lineBreak":true},{"text":"ma suaba lá ń òwa,","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"mí yã́zãsi ma sↄ̃̀sↄ̃nawa,","poem":1},{"lineBreak":true},{"text":"asa málɛ n yã́ náaikɛ.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ńsu to màↄ ku sĩana'oanɛ́ saio,","poem":1},{"lineBreak":true},{"text":"asa n ikoyãↄ ↄ̃ ma wɛ́ dↄi.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Máↄ n ikoyãↄ kũa","poem":1},{"lineBreak":true},{"text":"za gbã e gↄↄpiiɛ,","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"míↄ bɛ ma laaiwa,","poem":1},{"lineBreak":true},{"text":"asa ma n ↄtondↄkĩi wɛ̀ɛlɛɛ.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Má n yã'onɛↄ o kíaↄnɛ,","poem":1},{"lineBreak":true},{"text":"wí a ma kũo.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"N yãdilɛaↄ ì ma pↄ kɛ na,","poem":1},{"lineBreak":true},{"text":"asa má ye yã́piↄiɛ.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Má ye n yãdilɛaↄi ↄ̃ ma ↄdↄi,","poem":1},{"lineBreak":true},{"text":"mi làasookɛ n yãdilɛnɛↄwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"To yã́ pↄ́ ń ò n zↄ̀blenaɛ dↄngu,","poem":1},{"lineBreak":true},{"text":"asa ń tò ma wɛ́ dↄiɛ.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Ma nↄ̀sɛ ì níni ma taasikɛa guu,","poem":1},{"lineBreak":true},{"text":"asa n yã́ mɛ́ ì ma lɛ́ ń láo.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Waladeↄ lɛ́ ma yáalↄ maamaaɛ,","poem":1},{"lineBreak":true},{"text":"ń beeo má pãalɛ n ikoyãɛo.","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Mi làasookɛ n ikoyã yãaↄwa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aaì ma nↄ̀sɛ nínimɛɛ, Dii.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Ma pↄ ì pa maamaa","poem":1},{"lineBreak":true},{"text":"vãikɛnaↄ pãkpaa n ikoyãi yã́i.","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"Mi lɛsi n yãdilɛnɛↄ musu","poem":1},{"lineBreak":true},{"text":"ma kua dṹniau bↄ̀mↄ ũ guu.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"N yã́ ìↄ dↄmagu gwã́, Dii,","poem":1},{"lineBreak":true},{"text":"ↄ̃ miↄ n ikoyãↄ kũa.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"Má yã́ beeↄ dↄ́ɛ dↄ̃,","poem":1},{"lineBreak":true},{"text":"asa miↄ n ↄtondↄkĩi gwaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":57,"content":[{"text":"Dii mɛ́ ma baa ũ,","poem":1},{"lineBreak":true},{"text":"ma lɛgbɛ̃̀ ma mɛ̀ má n yãma.","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"Mi awakpanɛ ń nↄ̀sɛmɛndoo,","poem":1},{"lineBreak":true},{"text":"sùuukɛmanↄ lá ń òwa.","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"Ma a yãkɛaↄ gwà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma n yã́zɛ sɛ̀.","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"Máↄ wãa, má zɛzɛo,","poem":1},{"lineBreak":true},{"text":"má n yãdilɛaↄ da.","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"Baa tó gbɛ̃vãiↄ ba lìamazi,","poem":1},{"lineBreak":true},{"text":"n ikoyãↄ sãmaguo.","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"Mi fɛlɛ mà n sáaukpa wɛɛdo","poem":1},{"lineBreak":true},{"text":"n ikoyã maapiↄ musu.","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"N vĩakɛnaↄ gbɛ̃nan ma ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aaì n ↄtondↄkĩi gwaↄ.","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"Dii, n gbɛ̃kɛ dṹnia pà.","poem":1},{"lineBreak":true},{"text":"Ǹ n yãdilɛnɛↄ damɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"N maakɛ̀ mapi n zↄ̀blenaɛ,","poem":1},{"lineBreak":true},{"text":"lá ń òwa, Dii.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"Wɛzɛ̃ ń dↄ̃ao damɛɛ,","poem":1},{"lineBreak":true},{"text":"asa ma n yãdilɛaↄ sìɛ.","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"E ǹyↄ̃ gɛ́ ↄtↄ̃ↄlɛia, má sã́sãaɛ,","poem":1},{"lineBreak":true},{"text":"ãma tiasa má n yã́ kũa.","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"Ń maa mɛ́ ni yãmaakɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ n yãdilɛnɛↄ damɛɛ.","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"Baa kɛ́ waladeↄ yã́sia lì wa nànaa,","poem":1},{"lineBreak":true},{"text":"miↄ n ↄtondↄkĩi gwa ń nↄ̀sɛmɛndooɛ.","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"An swã́ yìaa, aa sↄũkũ̀,","poem":1},{"lineBreak":true},{"text":"mapi sↄ̃ ma pↄ na n ikoyãwa.","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"N ↄtↄ̃ↄlɛaa kɛ̀ maaɛ,","poem":1},{"lineBreak":true},{"text":"asa ma e ma n yãdanɛↄ dàdaɛ.","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"Ikoyã pↄ́ lɛ́ bↄ n lɛ́u maamɛɛ","poem":1},{"lineBreak":true},{"text":"dɛ vua ń ã́nusu ↄwatɛ̃ ↄ̀aa sↄoↄla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":73,"content":[{"text":"N ↄ mɛ́ ma ikàsa, ↄ̃ n ma kɛ.","poem":1},{"lineBreak":true},{"text":"Ma gba ↄ̃nↄ mà n yãdilɛaↄ dada.","poem":1}]},{"type":"verse","number":74,"content":[{"lineBreak":true},{"text":"Tó n vĩakɛnaↄ ma e, an pↄ ì kɛ na,","poem":1},{"lineBreak":true},{"text":"asa n yã́ ↄ̃ ma wɛ́ dↄi.","poem":1}]},{"type":"verse","number":75,"content":[{"lineBreak":true},{"text":"Dii, má dↄ̃ kɛ́ n ikoyãↄ maa,","poem":1},{"lineBreak":true},{"text":"kɛ́ ń náai vĩ yã́i ↄ̃ n ↄtↄ̃̀ↄlɛa.","poem":1}]},{"type":"verse","number":76,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛkɛmɛɛ, ma nↄ̀sɛ i níni,","poem":1},{"lineBreak":true},{"text":"lá ń ò mapi n zↄ̀blenaɛwa.","poem":1}]},{"type":"verse","number":77,"content":[{"lineBreak":true},{"text":"Mↄ ǹ wɛ̃nadↄ̃mɛɛ màↄ ku aafia,","poem":1},{"lineBreak":true},{"text":"asa n ikoyãↄ mɛ́ ma pↄnakɛbↄ ũ.","poem":1}]},{"type":"verse","number":78,"content":[{"lineBreak":true},{"text":"To wí waladeↄ kṹ, asa aa yãdↄ̀aɛ,","poem":1},{"lineBreak":true},{"text":"mí làasookɛ n ↄtondↄkĩiwa.","poem":1}]},{"type":"verse","number":79,"content":[{"lineBreak":true},{"text":"To n vĩakɛnaↄ mↄ ma kĩ́i,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aa n yã'onɛ dↄ̃piↄ.","poem":1}]},{"type":"verse","number":80,"content":[{"lineBreak":true},{"text":"To màↄ ku tàaesai n yã́ↄ musu,","poem":1},{"lineBreak":true},{"text":"kɛ́ wí su ma kũo yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":81,"content":[{"text":"Ma sↄ̃anzi ǹ ma suaba e ma nisĩna lòo,","poem":1},{"lineBreak":true},{"text":"n yã́ ↄ̃ ma wɛ́ dↄi.","poem":1}]},{"type":"verse","number":82,"content":[{"lineBreak":true},{"text":"Ma wɛdↄ̀dↄ n lɛgbɛ̃ai e ma wɛ́ wò,","poem":1},{"lineBreak":true},{"text":"bↄɛ ńyↄ̃ ma nↄ̀sɛ nínimɛɛi?","poem":1}]},{"type":"verse","number":83,"content":[{"lineBreak":true},{"text":"Má dɛ lán báa bↄ̀ↄ pↄ́ tɛ́zãna màwaɛ,","poem":1},{"lineBreak":true},{"text":"ń beeo n yãdilɛnɛↄ lí sãmaguo.","poem":1}]},{"type":"verse","number":84,"content":[{"lineBreak":true},{"text":"Mapi n zↄ̀blena máↄ n dã e bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Bↄɛ ńyↄ̃ ĩada ma wɛ̀lɛↄwai?","poem":1}]},{"type":"verse","number":85,"content":[{"lineBreak":true},{"text":"Waladeↄ ì ɛyↄ̃mɛɛ,","poem":1},{"lineBreak":true},{"text":"an yã́ lí kↄ̃'e ń n ikoyãoo.","poem":1}]},{"type":"verse","number":86,"content":[{"lineBreak":true},{"text":"N yãdilɛaↄ píi náai vĩ.","poem":1},{"lineBreak":true},{"text":"Dↄmalɛ, asa wàlɛ ĩadaa pãɛ.","poem":1}]},{"type":"verse","number":87,"content":[{"lineBreak":true},{"text":"À gↄ̃̀ yↄↄ aa ma bↄ dṹniauɛ,","poem":1},{"lineBreak":true},{"text":"mapi sↄ̃ mi n ↄtondↄkĩi tó weo.","poem":1}]},{"type":"verse","number":88,"content":[{"lineBreak":true},{"text":"Ma lɛ́ ń láo n gbɛ̃kɛ yã́i,","poem":1},{"lineBreak":true},{"text":"mí n yã'onɛ ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":89,"content":[{"text":"Dii, n yã́ ìↄ ku gↄↄpiiɛ,","poem":1},{"noteId":226},{"lineBreak":true},{"text":"a zĩ́napɛlɛa musu n bɛ.","poem":1}]},{"type":"verse","number":90,"content":[{"lineBreak":true},{"text":"Ń náai vĩ wɛ̃ ń wɛ̃o,","poem":1},{"lineBreak":true},{"text":"n dṹnia kàlɛ, ↄ̃ a ku.","poem":1}]},{"type":"verse","number":91,"content":[{"lineBreak":true},{"text":"N ikoyãↄ mɛ́ tò pↄ́pii kú gbã,","poem":1},{"lineBreak":true},{"text":"asa pↄ́pii misiilɛanɛ.","poem":1}]},{"type":"verse","number":92,"content":[{"lineBreak":true},{"text":"Tó n ikoyã mɛ́ ma pↄnakɛbↄ ũo,","poem":1},{"lineBreak":true},{"text":"dↄ̃ ma mìdɛ ma taasikɛa guu.","poem":1}]},{"type":"verse","number":93,"content":[{"lineBreak":true},{"text":"N ↄtondↄkĩi a sãmagu bauo,","poem":1},{"lineBreak":true},{"text":"asa a sabai ↄ̃ n ma lɛ ń láo.","poem":1}]},{"type":"verse","number":94,"content":[{"lineBreak":true},{"text":"N pↄ́n ma ũ, ma suaba,","poem":1},{"lineBreak":true},{"text":"asa miↄ n ↄtondↄkĩi wɛɛlɛɛ.","poem":1}]},{"type":"verse","number":95,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãiↄ lɛ́ ma wɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma laai ku n yã'onɛↄwa.","poem":1}]},{"type":"verse","number":96,"content":[{"lineBreak":true},{"text":"Má è pↄ́pii maa lɛ́ kuɛ,","poem":1},{"lineBreak":true},{"text":"ãma n yãdilɛaↄ zↄ̃ↄ lɛ́ vĩo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":97,"content":[{"text":"Má ye n ikoyãi à kɛ̀ zài,","poem":1},{"lineBreak":true},{"text":"miↄ làasookɛwà gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":98,"content":[{"lineBreak":true},{"text":"N yã́ tò ma ↄ̃nↄ dɛ ma ibɛɛↄla,","poem":1},{"lineBreak":true},{"text":"asa a ku ma sↄ̃u gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":99,"content":[{"lineBreak":true},{"text":"Ma wɛzɛ̃ dɛ ma yãdanɛdeↄla,","poem":1},{"lineBreak":true},{"text":"asa ma làasoo ìↄ ku n yã'onɛↄwaɛ.","poem":1}]},{"type":"verse","number":100,"content":[{"lineBreak":true},{"text":"Ma ↄ̃nↄ dɛ maezↄ̃ↄↄla,","poem":1},{"lineBreak":true},{"text":"asa miↄ n ↄtondↄkĩiↄ gwaɛ.","poem":1}]},{"type":"verse","number":101,"content":[{"lineBreak":true},{"text":"Mi gbápɛlɛ zɛ́ vãie guuo,","poem":1},{"lineBreak":true},{"text":"kɛ́ mà e màↄ n yã́ kũa yã́i.","poem":1}]},{"type":"verse","number":102,"content":[{"lineBreak":true},{"text":"Mi kɛ̃ n ikoyãↄwao,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ ń dàmɛɛ.","poem":1}]},{"type":"verse","number":103,"content":[{"lineBreak":true},{"text":"N yã́ↄ namɛɛ à kɛ̀ zài,","poem":1},{"lineBreak":true},{"text":"a na dɛ zↄ́a ma lɛ́u.","poem":1}]},{"type":"verse","number":104,"content":[{"lineBreak":true},{"text":"N ↄtondↄkĩi ì ma gba ↄ̃nↄ,","poem":1},{"lineBreak":true},{"text":"a yã́i tò má za sã́sãzɛ píiu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":105,"content":[{"text":"N yã́ mɛ́ filia ũ ma gbázĩ,","poem":1},{"noteId":227},{"lineBreak":true},{"text":"ì gupumɛɛ zɛ́u.","poem":1}]},{"type":"verse","number":106,"content":[{"lineBreak":true},{"text":"Ma lɛgbɛ̃̀ ↄ̃ ma kpalɛ ma siwà,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀ máↄ zĩkɛ n ikoyãↄwaɛ.","poem":1}]},{"type":"verse","number":107,"content":[{"lineBreak":true},{"text":"Ma taasikɛa kɛ̀ zài, Dii.","poem":1},{"lineBreak":true},{"text":"Ma lɛ́ ń láo lá ń òwa.","poem":1}]},{"type":"verse","number":108,"content":[{"lineBreak":true},{"text":"To n sáau pↄ́ málɛ kpá kángu,","poem":1},{"noteId":228},{"lineBreak":true},{"text":"ní n ikoyãↄ damɛɛ, Dii.","poem":1}]},{"type":"verse","number":109,"content":[{"lineBreak":true},{"text":"Gↄↄpii miↄ ku ga lɛ́zĩɛ,","poem":1},{"lineBreak":true},{"text":"ń beeo n ikoyãↄ lí sãmaguo.","poem":1}]},{"type":"verse","number":110,"content":[{"lineBreak":true},{"text":"Vãikɛnaↄ baikpàmɛɛ,","poem":1},{"lineBreak":true},{"text":"kási mi zã n ↄtondↄkĩiwao.","poem":1}]},{"type":"verse","number":111,"content":[{"lineBreak":true},{"text":"N yã'onɛↄá ma pↄ́ɛ gↄↄpii,","poem":1},{"lineBreak":true},{"text":"aaì to ma pↄ kɛ na.","poem":1}]},{"type":"verse","number":112,"content":[{"lineBreak":true},{"text":"Ma a sↄ̃ kpà n yãdilɛnɛↄwa,","poem":1},{"lineBreak":true},{"text":"máↄ kũa gↄↄpii e ma wɛ̃ni lɛ́uɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":113,"content":[{"text":"Má za nↄ̀sɛmɛmpladeↄgu,","poem":1},{"lineBreak":true},{"text":"má ye n ikoyãi.","poem":1}]},{"type":"verse","number":114,"content":[{"lineBreak":true},{"text":"Ḿmɛ ń ma ulɛkĩi ń ma sɛ̀ngbaoo ũ,","poem":1},{"lineBreak":true},{"text":"n yã́ ↄ̃ ma wɛ́ dↄi.","poem":1}]},{"type":"verse","number":115,"content":[{"lineBreak":true},{"text":"À gomala vãikɛnaↄ,","poem":1},{"lineBreak":true},{"text":"kɛ́ mà zĩkɛ ma Lua yãdilɛaↄwa.","poem":1}]},{"type":"verse","number":116,"content":[{"lineBreak":true},{"text":"Ǹyↄ̃ ma kũa lá ń òwa, míↄ ku,","poem":1},{"lineBreak":true},{"text":"ńsu to tãmaa ma nɛo.","poem":1},{"noteId":229}]},{"type":"verse","number":117,"content":[{"lineBreak":true},{"text":"Ǹyↄ̃ dɛ ma gbãa ũ, míↄ aafia,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ iↄ pɛ n yãdilɛnɛwa láasai.","poem":1}]},{"type":"verse","number":118,"content":[{"lineBreak":true},{"text":"Ɔzↄ̃ gbɛ̃́ pↄ́ pã̀alɛ n yãdilɛnɛɛi,","poem":1},{"lineBreak":true},{"text":"an mↄafiliyã a àikɛnɛ́o.","poem":1}]},{"type":"verse","number":119,"content":[{"lineBreak":true},{"text":"Ni dṹnia vãikɛnaↄ waa bìsa ũ,","poem":1},{"lineBreak":true},{"text":"a yã́i tò má ye n yã'onɛi.","poem":1}]},{"type":"verse","number":120,"content":[{"lineBreak":true},{"text":"Má n vĩa vĩ, ma mɛ ì seenata,","poem":1},{"lineBreak":true},{"text":"n ikoyãↄ ì to vĩa ma kũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":121,"content":[{"text":"Ma yãkɛ̀ a zɛ́wa wásawasaɛ,","poem":1},{"lineBreak":true},{"text":"ńsu ma to ma ĩadamadeↄnɛo.","poem":1}]},{"type":"verse","number":122,"content":[{"lineBreak":true},{"text":"Kpɛ́gaausi mapi n zↄ̀blenaɛ,","poem":1},{"lineBreak":true},{"text":"ńsu to waladeↄ ma wɛtão.","poem":1}]},{"type":"verse","number":123,"content":[{"lineBreak":true},{"text":"Ma wɛ́ dↄ n dↄnlɛi e ma wɛ́ wò,","poem":1},{"lineBreak":true},{"text":"má sↄ̃́anzi ǹ ma suaba lá ń òwa.","poem":1}]},{"type":"verse","number":124,"content":[{"lineBreak":true},{"text":"Yãkɛmɛɛ n gbɛ̃kɛ guu,","poem":1},{"lineBreak":true},{"text":"ní n yã́ da mapi n zↄ̀blenaɛ.","poem":1}]},{"type":"verse","number":125,"content":[{"lineBreak":true},{"text":"N zↄ̀blenan ma ũ, ma gba ↄ̃nↄ,","poem":1},{"lineBreak":true},{"text":"kɛ́ mà n yã'onɛↄ yáasi dↄ̃.","poem":1}]},{"type":"verse","number":126,"content":[{"lineBreak":true},{"text":"N yãkɛgↄↄ kà, Dii,","poem":1},{"lineBreak":true},{"text":"wàlɛ bↄ n ikoyã kpɛ.","poem":1}]},{"type":"verse","number":127,"content":[{"lineBreak":true},{"text":"Má ye n yãdilɛaↄi dɛ vuaa,","poem":1},{"lineBreak":true},{"text":"baa vua baasaa.","poem":1}]},{"type":"verse","number":128,"content":[{"lineBreak":true},{"text":"Má è n ↄtondↄkĩi maa,","poem":1},{"lineBreak":true},{"text":"a yã́i má za sã́sãzɛ píiu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":129,"content":[{"text":"N yã'onɛↄ dɛmɛɛ yãbↄnsaɛ ũ,","poem":1},{"lineBreak":true},{"text":"Ayãmɛto má dà ma sↄ̃u.","poem":1}]},{"type":"verse","number":130,"content":[{"lineBreak":true},{"text":"N yã́ bↄↄlɛkɛa ì gupunɛ́,","poem":1},{"lineBreak":true},{"text":"ì nↄ̀sɛdoũdeↄ gba ↄ̃nↄ.","poem":1}]},{"type":"verse","number":131,"content":[{"lineBreak":true},{"text":"Ma lɛ́ ɛlɛa, málɛ we fòofoo,","poem":1},{"lineBreak":true},{"text":"asa n ikoyãↄ ni lɛ́ ma dɛɛ.","poem":1}]},{"type":"verse","number":132,"content":[{"lineBreak":true},{"text":"Ma wɛgwa, sùuukɛmanↄ,","poem":1},{"lineBreak":true},{"text":"lá ni kɛ gbɛ̃́ pↄ́ ye n tↄ́iↄnɛwa.","poem":1}]},{"type":"verse","number":133,"content":[{"lineBreak":true},{"text":"Ma dazɛwa lá ń òwa,","poem":1},{"lineBreak":true},{"text":"ńsu to yãvãie kibleao.","poem":1}]},{"type":"verse","number":134,"content":[{"lineBreak":true},{"text":"Ma bↄ gbɛ̃́ taiinkɛnaↄ ↄzĩ,","poem":1},{"lineBreak":true},{"text":"kɛ́ màↄ n ↄtondↄkĩi gwa.","poem":1}]},{"type":"verse","number":135,"content":[{"lineBreak":true},{"text":"Mapi n zↄ̀blena wɛgwa,","poem":1},{"lineBreak":true},{"text":"ní tó mà n yãdilɛnɛↄ dↄ̃.","poem":1}]},{"type":"verse","number":136,"content":[{"lineBreak":true},{"text":"Wɛ́'i lɛ́ bàalɛ ma kùawa,","poem":1},{"lineBreak":true},{"text":"kɛ́ wa n ikoyã kũao yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":137,"content":[{"text":"Dii, ń maa,","poem":1},{"lineBreak":true},{"text":"n yãkɛkɛaↄ zɛvĩ.","poem":1}]},{"type":"verse","number":138,"content":[{"lineBreak":true},{"text":"N n yã́ↄ dìlɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"aa náai vĩ maamaaɛ.","poem":1}]},{"type":"verse","number":139,"content":[{"lineBreak":true},{"text":"N yã́ lɛ́ kɛ ma ibɛɛↄnɛ yãe ũo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ a yã́ lɛ́ ma dɛ.","poem":1}]},{"type":"verse","number":140,"content":[{"lineBreak":true},{"text":"Wa è n yã́ sãa vĩo,","poem":1},{"lineBreak":true},{"text":"mapi n zↄ̀blena, má yei maamaaɛ.","poem":1}]},{"type":"verse","number":141,"content":[{"lineBreak":true},{"text":"Pↄen ma ũo, wì sakamagu,","poem":1},{"lineBreak":true},{"text":"ń beeo n ↄtondↄkĩi lí sãmaguo.","poem":1}]},{"type":"verse","number":142,"content":[{"lineBreak":true},{"text":"N yã́ ìↄ zɛvĩ gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"n ikoyã sĩana vĩ.","poem":1}]},{"type":"verse","number":143,"content":[{"lineBreak":true},{"text":"Taasi n yã'ↄ̃mao ma le,","poem":1},{"lineBreak":true},{"text":"ãma n yãdilɛaↄ mɛ́ ma pↄnakɛbↄ ũ.","poem":1}]},{"type":"verse","number":144,"content":[{"lineBreak":true},{"text":"N yã'onɛↄ maa gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"ma gba ↄ̃nↄ kɛ́ màↄ ku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":145,"content":[{"text":"Mi n sísi ń nↄ̀sɛmɛndoo,","poem":1},{"lineBreak":true},{"text":"wea Dii, míↄ n yãdilɛnɛↄ kũa.","poem":1}]},{"type":"verse","number":146,"content":[{"lineBreak":true},{"text":"Mi lɛzunzi,","poem":1},{"lineBreak":true},{"text":"ma suaba, míↄ n yã'onɛↄ kũa.","poem":1}]},{"type":"verse","number":147,"content":[{"lineBreak":true},{"text":"Mi fɛlɛ gudↄsai mà wiilɛma,","poem":1},{"lineBreak":true},{"text":"n yã́ ma wɛ́ dↄi.","poem":1}]},{"type":"verse","number":148,"content":[{"lineBreak":true},{"text":"I lí na ma wɛ́u gwãasĩnao,","poem":1},{"lineBreak":true},{"text":"kɛ́ mà e làasookɛ n yã́wa yã́i.","poem":1}]},{"type":"verse","number":149,"content":[{"lineBreak":true},{"text":"Ma yãma n gbɛ̃kɛ yã́i, Dii,","poem":1},{"lineBreak":true},{"text":"ma lɛ́ ń láo lá n ikoyã'òwa.","poem":1}]},{"type":"verse","number":150,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ lɛkpaaĩmaziↄ kãi,","poem":1},{"lineBreak":true},{"text":"aa zã̀ ń n ikoyão.","poem":1}]},{"type":"verse","number":151,"content":[{"lineBreak":true},{"text":"Ń kumanↄ kãi, Dii,","poem":1},{"lineBreak":true},{"text":"n ikoyã píi sĩana vĩ.","poem":1}]},{"type":"verse","number":152,"content":[{"lineBreak":true},{"text":"Má dↄ̃̀ n yã'onɛↄwa à gɛ̃̀gɛ̃,","poem":1},{"lineBreak":true},{"text":"kɛ́ ń dìlɛ àↄ ku gↄↄpii yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":153,"content":[{"text":"Ma taasi gwa, ní ma suaba,","poem":1},{"lineBreak":true},{"text":"asa n ikoyã i sãmaguo.","poem":1}]},{"type":"verse","number":154,"content":[{"lineBreak":true},{"text":"Zɛmanↄ, ní ma bↄ,","poem":1},{"lineBreak":true},{"text":"ma lɛ́ ń láo lá n a lɛgbɛ̃̀wa.","poem":1}]},{"type":"verse","number":155,"content":[{"lineBreak":true},{"text":"N dↄnlɛ zã̀ ń vãikɛnaↄ,","poem":1},{"lineBreak":true},{"text":"asa aali n yãdilɛnɛↄ wɛɛlɛo.","poem":1}]},{"type":"verse","number":156,"content":[{"lineBreak":true},{"text":"Ń sósobi vĩ zↄ̃ↄ, Dii,","poem":1},{"lineBreak":true},{"text":"ma lɛ́ ń láo lá n ikoyã'òwa.","poem":1}]},{"type":"verse","number":157,"content":[{"lineBreak":true},{"text":"Ma ĩadamadeↄ ń ma wɛ̀lɛↄ dasi,","poem":1},{"lineBreak":true},{"text":"ãma mi pãalɛ n yã'onɛↄnɛo.","poem":1}]},{"type":"verse","number":158,"content":[{"lineBreak":true},{"text":"Má ye n náaikɛnsaiↄ gĩyãio,","poem":1},{"lineBreak":true},{"text":"kɛ́ aaliↄ n yã́ kũao yã́i.","poem":1}]},{"type":"verse","number":159,"content":[{"lineBreak":true},{"text":"Gwa lá má ye n ↄtondↄkĩii.","poem":1},{"lineBreak":true},{"text":"Dii, ma lɛ́ ń láo n gbɛ̃kɛ yã́i.","poem":1}]},{"type":"verse","number":160,"content":[{"lineBreak":true},{"text":"N yã́pii zĩ́naá sĩanaɛ,","poem":1},{"lineBreak":true},{"text":"n ikoyãↄ maa, aa láaa vĩo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":161,"content":[{"text":"Gbãadeↄ ì ĩadaa pã,","poem":1},{"lineBreak":true},{"text":"ãma n yã́ ↄ̃ má a vĩa vĩ.","poem":1}]},{"type":"verse","number":162,"content":[{"lineBreak":true},{"text":"Mi pↄnakɛ ń n lɛgbɛ̃ao,","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃́ pↄ́ àizɛɛ zↄ̃ↄ kↄ̃mpawa.","poem":1}]},{"type":"verse","number":163,"content":[{"lineBreak":true},{"text":"Má za mↄafiliu, má ye a yã́io,","poem":1},{"lineBreak":true},{"text":"n ikoyã má yei.","poem":1}]},{"type":"verse","number":164,"content":[{"lineBreak":true},{"text":"Miↄ n táasilɛ gↄↄ do gɛ̃n soplapla","poem":1},{"lineBreak":true},{"text":"kɛ́ n ikoyãↄ maa yã́i.","poem":1}]},{"type":"verse","number":165,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ye n ikoyãiↄ aafia zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"yãe lí tó aa fùo.","poem":1},{"noteId":230}]},{"type":"verse","number":166,"content":[{"lineBreak":true},{"text":"Ma wɛ́ dↄi ǹ ma suaba, Dii,","poem":1},{"lineBreak":true},{"text":"mi zĩkɛ n yãdilɛaↄwa.","poem":1}]},{"type":"verse","number":167,"content":[{"lineBreak":true},{"text":"Má n yã'onɛↄ kũa ń nↄ̀sɛo,","poem":1},{"lineBreak":true},{"text":"má yei maamaaɛ.","poem":1}]},{"type":"verse","number":168,"content":[{"lineBreak":true},{"text":"Mi n ↄtondↄkĩi gwa, mi n yãma,","poem":1},{"lineBreak":true},{"text":"asa ma kɛkɛá píi kú n ↄzĩɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":169,"content":[{"text":"To ma wiilɛa kama, Dii,","poem":1},{"lineBreak":true},{"text":"ma gba ↄ̃nↄ lá ń òwa.","poem":1}]},{"type":"verse","number":170,"content":[{"lineBreak":true},{"text":"To ma wabikɛa n le,","poem":1},{"lineBreak":true},{"text":"ma suaba lá n a lɛgbɛ̃̀wa.","poem":1}]},{"type":"verse","number":171,"content":[{"lineBreak":true},{"text":"N táasilɛa aↄ dↄ ma lɛ́uɛ,","poem":1},{"lineBreak":true},{"text":"asa ni n yãdilɛnɛↄ damɛɛ.","poem":1}]},{"type":"verse","number":172,"content":[{"lineBreak":true},{"text":"Má lɛsi n lɛgbɛ̃a musu,","poem":1},{"lineBreak":true},{"text":"asa n yãdilɛaↄ maa píiɛ.","poem":1}]},{"type":"verse","number":173,"content":[{"lineBreak":true},{"text":"Ǹyↄ̃ kú ń dↄamalɛ sↄuo,","poem":1},{"lineBreak":true},{"text":"asa ma zɛ ń n ↄtondↄkĩioɛ.","poem":1}]},{"type":"verse","number":174,"content":[{"lineBreak":true},{"text":"Málɛ a nidɛ ǹ ma suaba, Dii,","poem":1},{"lineBreak":true},{"text":"n ikoyã mɛ́ ma pↄnakɛbↄ ũ.","poem":1}]},{"type":"verse","number":175,"content":[{"lineBreak":true},{"text":"To màↄ ku, míↄ n táasilɛ,","poem":1},{"lineBreak":true},{"text":"to n ikoyãↄ aaↄ ma kũa.","poem":1}]},{"type":"verse","number":176,"content":[{"lineBreak":true},{"text":"Ma liaa lán sã pↄ́ sã̀sãwa,","poem":1},{"lineBreak":true},{"text":"mapi n zↄ̀blena, ma wɛɛlɛ,","poem":1},{"noteId":231},{"lineBreak":true},{"text":"asa n yã́ↄ i sãmaguo.","poem":1}]}],"footnotes":[{"noteId":224,"caller":"+","text":"119.11 Luk 2.19","reference":{"chapter":119,"verse":11}},{"noteId":225,"caller":"+","text":"119.19 Ɛbɛ 11.13","reference":{"chapter":119,"verse":19}},{"noteId":226,"caller":"+","text":"119.89 Mat 24.35, 1Piɛ 1.25","reference":{"chapter":119,"verse":89}},{"noteId":227,"caller":"+","text":"119.105 Yaa 6.23","reference":{"chapter":119,"verse":105}},{"noteId":228,"caller":"+","text":"119.108 Ɛbɛ 13.15","reference":{"chapter":119,"verse":108}},{"noteId":229,"caller":"+","text":"119.116 Lom 5.5","reference":{"chapter":119,"verse":116}},{"noteId":230,"caller":"+","text":"119.165 1Zãa 2.10","reference":{"chapter":119,"verse":165}},{"noteId":231,"caller":"+","text":"119.176 Luk 15.4","reference":{"chapter":119,"verse":176}}]},"thisChapterLink":"/api/bqc_sim/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}