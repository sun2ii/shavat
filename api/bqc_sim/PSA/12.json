{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":12,"content":[{"type":"heading","content":["Gbɛ̃nazĩna bɛ̃̀ɛboa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ. Wì sí ń kúulɛaoɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ma suaba Dii!","poem":1},{"lineBreak":true},{"text":"Asa gbɛ̃maa ku lↄo,","poem":1},{"lineBreak":true},{"text":"náaide làa gbɛ̃nazĩnaↄ guu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Baade ì ɛɛto a gbɛ̃́deeɛɛ,","poem":1},{"lineBreak":true},{"text":"ì lɛna kɛɛ̀ ń nↄ̀sɛmɛmplao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii, lɛnade gyawi","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ ì azĩa sɛ lɛsĩo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aaì mɛ ń lɛ́ mɛ́ a tidↄ gbɛ̃́a,","poem":1},{"lineBreak":true},{"text":"wa mɛ́ wa ń lɛ́ vĩ,","poem":1},{"lineBreak":true},{"text":"démɛ a kiblemái?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gbɛ̃́ busɛↄ wɛtãa","poem":1},{"lineBreak":true},{"text":"ń wɛ̃nadeↄ aaukɛao yã́i,","poem":1},{"lineBreak":true},{"text":"Dii mɛ̀ á fɛlɛ sa,","poem":1},{"lineBreak":true},{"text":"á ń gba bↄkĩi pↄ́ aalɛ a nidɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dii yã́ sãa vĩo,","poem":1},{"lineBreak":true},{"text":"a dɛ lán ã́nusu pↄ́ wa yↄ̀ mua tɛ́u","poem":1},{"lineBreak":true},{"text":"wa bàasa gɛ̃n soplawa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mpi Dii, ńyↄ̃ↄ wá dↄ̃́a gↄↄpii,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ wá sí gbɛ̃́ bee taaↄwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ↄ yãbɛ̃ɛ kũ̀ ↄplapla,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ ìↄ bɛ ń yↄ̃̀ↄo gupiiuɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":9}