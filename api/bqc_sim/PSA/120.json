{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":120,"content":[{"type":"heading","content":["Kua yãkeledeↄ guu"]},{"type":"hebrew_subtitle","content":["Gɛa Yelusalɛũ lɛ."]},{"type":"verse","number":1,"content":[{"text":"Ma kua yeelɛa guu ma wiilɛ̀ Diizi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ma yãmà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma si yã́siadeↄ yãdↄmawa","poem":1},{"lineBreak":true},{"text":"ń mↄafilide yã́o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mↄafilide, kpelewa Lua a sɛnnↄi?","poem":1},{"lineBreak":true},{"text":"Bↄ́ a fĩaboonɛi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gↄ̃sa gbãa kà lɛnaↄ","poem":1},{"lineBreak":true},{"text":"ń sɛ̃́ sĩsĩ wãao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waiyoo mapi kua Mɛsɛkiↄ guu,","poem":1},{"noteId":232},{"lineBreak":true},{"text":"zↄ̃lɛa Kedaaↄ zwã̀akpɛu.","poem":1},{"noteId":233}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma zↄ̃lɛ gbɛ̃́ pↄ́ za aafiauↄ guu à gɛ̃̀gɛ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yãkelesaiden ma ũ,","poem":1},{"lineBreak":true},{"text":"tó ma a yã'ò, sòle aaì fɛlɛò.","poem":1}]}],"footnotes":[{"noteId":232,"caller":"+","text":"120.5 Daa 10.2, Eze 38.2-3","reference":{"chapter":120,"verse":5}},{"noteId":233,"caller":"+","text":"120.5 Daa 25.13, Isa 21.16-17","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/bqc_sim/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}