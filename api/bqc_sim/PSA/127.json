{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":127,"content":[{"type":"heading","content":["Luakpama yãdaa"]},{"type":"hebrew_subtitle","content":["Gɛa Yelusalɛũ lɛ pↄ́ Salomↄↄ dà."]},{"type":"verse","number":1,"content":[{"text":"Mɛ́ i kɛ Dii mɛ́ lɛ́ kpɛdↄo,","poem":1},{"lineBreak":true},{"text":"kpɛdↄnaↄ lɛ́ zĩ pã kɛɛ.","poem":1},{"lineBreak":true},{"text":"Mɛ́ i kɛ Dii mɛ́ lɛ́ wɛ̃́lɛ dↄ̃́ao,","poem":1},{"lineBreak":true},{"text":"gudↄ̃anaↄ lɛ́ itɛ̃kɛ pãɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fɛlɛa káaukaau, wúlɛa wɛɛdo,","poem":1},{"lineBreak":true},{"text":"zĩkɛa ń leeleo blɛ yã́iá pãɛ,","poem":1},{"lineBreak":true},{"text":"asa Dii mɛ́ ì a yenzideↄ gba ĩ́ampaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nɛgↄ̃ɛnaↄá Dii gbaɛ,","poem":1},{"lineBreak":true},{"text":"nɛ́ píiá aà kpámaɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lá ka ìↄ ka gↄ̃sa gbãa ↄu,","poem":1},{"lineBreak":true},{"text":"màa ɛ̀waasogↄↄ nɛgↄ̃ɛnaↄ dɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ aà gbàla pàò ũ.","poem":1},{"lineBreak":true},{"text":"Tó aà ibɛɛↄ aà lè gãaɛ,","poem":1},{"lineBreak":true},{"text":"wí a aà kũo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}