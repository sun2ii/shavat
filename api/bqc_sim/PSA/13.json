{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":13,"content":[{"type":"heading","content":["Lɛzua Luazi"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"E bↄɛ, Dii?","poem":1},{"lineBreak":true},{"text":"Ma yã́ aↄ sãangu gↄↄpii yã̀?","poem":1},{"lineBreak":true},{"text":"N mikpɛ aↄ dↄamɛɛ e bↄɛ ni?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Máↄ dɛ̃ɛka ń ma làasooↄ e bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Ma pↄ ìↄ sia lá gu lɛ́ dↄ,","poem":1},{"lineBreak":true},{"text":"ma ibɛɛ aↄ gbãablea e bↄɛ ni?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dii ma Lua, ma gwa ní ma yãma.","poem":1},{"lineBreak":true},{"text":"Ma oa weemɛɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ másu ga i oo yã́i,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"kɛ́ ma ibɛɛ su mɛ a tidↄ̀malao,","poem":1},{"lineBreak":true},{"text":"kɛ́ ma wɛ̀lɛↄ su pↄnakɛ ma fua yã́ musuo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Málɛ n gbɛ̃kɛ náaikɛ,","poem":1},{"lineBreak":true},{"text":"ma pↄ na kɛ́ ńyↄ̃ ma suaba.","poem":1},{"lineBreak":true},{"text":"Má lɛsi Diiɛ,","poem":1},{"lineBreak":true},{"text":"asa à yãmaakɛ̀mɛɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}