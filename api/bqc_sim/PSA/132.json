{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":132,"content":[{"type":"heading","content":["Davidi buiↄ zↄ̃lɛa báawa Siↄna"]},{"type":"hebrew_subtitle","content":["Gɛa Yelusalɛũ lɛ."]},{"type":"verse","number":1,"content":[{"text":"Dii, ńsu to Davidi yã́ sãngu","poem":1},{"lineBreak":true},{"text":"ń taasi pↄ́ a kɛ̀o píi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À lɛkɛ̀ Yakↄbu Lua gbãadewa,","poem":1},{"lineBreak":true},{"text":"à lɛgbɛ̃̀ Diiɛ à mɛ̀,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"á tá kpɛ́uo,","poem":1},{"lineBreak":true},{"text":"á wúlɛ a liiwao,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"á we i a wɛ́baa gbiakũo,","poem":1},{"lineBreak":true},{"text":"á tó i na a wɛ́uo,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"e à gɛ uakpaò Diiɛ,","poem":1},{"lineBreak":true},{"text":"i kpɛdↄ Yakↄbu Lua gbãadepiɛ.","poem":1},{"noteId":242}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wá mà a ku Ɛflata bùsuu,","poem":1},{"lineBreak":true},{"text":"wá è Kiliayaaliũdeↄ bua.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wà gɛ́ aà kúkĩi,","poem":1},{"lineBreak":true},{"text":"wà kúlɛ aà gbadibↄ aɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii, fɛlɛ su n pilakĩi,","poem":1},{"lineBreak":true},{"text":"mpi ń n kpagolo ikodeo.","poem":1},{"noteId":243}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N gbàgbanaↄ gbɛ̃suabaa da ula ũ,","poem":1},{"lineBreak":true},{"text":"n yãmanaↄ gula iↄ dↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ńsu mikpɛdↄ kía pↄ́ ń kpàɛo","poem":1},{"lineBreak":true},{"text":"n zↄ̀blena Davidi yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dii lɛgbɛ̃̀ Davidiɛ,","poem":1},{"lineBreak":true},{"text":"a náai vĩ, a lɛ́ lilɛo, à mɛ̀:","poem":1},{"lineBreak":true},{"text":"Má n bui zↄ̃lɛ n kpalabaawa.","poem":1},{"noteId":244}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó n buiↄ ma bàakuańnↄ yãdà,","poem":1},{"lineBreak":true},{"text":"mɛ́ aa yã́ pↄ́ má dànɛ́ↄ kũa,","poem":1},{"lineBreak":true},{"text":"an buiↄ aaↄ zↄ̃lɛ n kpalabaawa gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Asa Dii Siↄna sɛ̀,","poem":1},{"lineBreak":true},{"text":"a ye àↄ dɛ a zↄ̃lɛkĩi ũ à mɛ̀:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Guɛ bee máↄ kuu gↄↄpii,","poem":1},{"lineBreak":true},{"text":"la máↄ zↄ̃lɛau, asa à ma pↄ́ gbàɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Má báaadau, mí kũ̀sũa diɛ̀,","poem":1},{"lineBreak":true},{"text":"má blɛ kpa a wɛ̃nadeↄwa aa kã́.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Má gbɛ̃suabaa da sa'onaↄnɛ ula ũ,","poem":1},{"lineBreak":true},{"text":"ma yãmanaↄ lɛtɛ̃ iↄ dↄ ń pↄnao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"We má Davidi bui kía gbãade bↄu,","poem":1},{"noteId":245},{"lineBreak":true},{"text":"we kía pↄ́ má kpà filia aↄ dↄu.","poem":1},{"noteId":246}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Má wida aà ibɛɛↄwa,","poem":1},{"lineBreak":true},{"text":"aà kíafua iↄ pipi aà musu.","poem":1}]}],"footnotes":[{"noteId":242,"caller":"+","text":"132.5 1Kia 8.17, Zĩn 7.46","reference":{"chapter":132,"verse":5}},{"noteId":243,"caller":"+","text":"132.8 Nao 10.35-36","reference":{"chapter":132,"verse":8}},{"noteId":244,"caller":"+","text":"132.11 2Sam 7.12-16, Luk 1.32-33, Zĩn 2.30","reference":{"chapter":132,"verse":11}},{"noteId":245,"caller":"+","text":"132.17 Luk 1.69","reference":{"chapter":132,"verse":17}},{"noteId":246,"caller":"+","text":"132.17 1Kia 11.36, 2Kia 8.19","reference":{"chapter":132,"verse":17}}]},"thisChapterLink":"/api/bqc_sim/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}