{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":135,"content":[{"type":"heading","content":["Dii táasilɛa"]},{"type":"verse","number":1,"content":[{"text":"Àleluya!","poem":1},{"lineBreak":true},{"text":"À Dii tↄbↄ!","poem":1},{"lineBreak":true},{"text":"À Dii táasilɛ aà zĩkɛnaↄ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Á gbɛ̃́ pↄ́ i zĩkɛ wá Lua uaↄ,","poem":1},{"lineBreak":true},{"text":"á gbɛ̃́ pↄ́ iↄ sĩ Dii kpɛ́ kpɛɛlɛↄ,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"à Dii tↄbↄ, asa a maaɛ,","poem":1},{"lineBreak":true},{"text":"à lɛ́mawà, asa bee mɛ́ na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii Yakↄbu buiↄ sɛ̀ a pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"à Isailiↄ dìlɛ a gbɛ̃́ yenzideↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Má dↄ̃ kɛ́ Dii zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"wá Lua mɛ́ dɛ diiↄla píi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii ì yã́ pↄ́ kàagu kɛ musu ń zĩ́lɛo,","poem":1},{"lineBreak":true},{"text":"ísia guu ń tↄↄlɛ nↄnauo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɔ̃mɛ ì to lou sisi tↄↄlɛ lɛ́wa,","poem":1},{"lineBreak":true},{"text":"ì to lou ma ń pílɛao,","poem":1},{"lineBreak":true},{"text":"ì bↄ ń zàa'ĩanao a làasiu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"À Egipiↄ yoaↄ dɛ̀dɛ","poem":1},{"noteId":248},{"lineBreak":true},{"text":"ń pↄtuo nɛ́ sɛ̃́iaↄ píi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À seelaↄ ń dabudabuↄ kɛ̀ Egipi,","poem":1},{"noteId":249},{"lineBreak":true},{"text":"à Falaↄ̃ↄ ń a gbɛ̃́ↄ fù píi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À buiↄ mìdɛ dasi,","poem":1},{"lineBreak":true},{"text":"à kía gbãadeↄ dɛ̀dɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amↄleↄ kí Siↄ̃ ń Basana kí Oguo","poem":1},{"noteId":250},{"lineBreak":true},{"text":"ń Kanaa bùsu kíaↄ píi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À gbadà ń ń bùsuo,","poem":1},{"lineBreak":true},{"text":"a kpà a gbɛ̃́ Isailiↄwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dii, n tↄ́ gaa vĩo,","poem":1},{"lineBreak":true},{"text":"Dii, n yã́ aↄ dↄ gbɛ̃́ↄgu gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Asa Dii a yãkɛkɛ a gbɛ̃́ↄnɛ,","poem":1},{"lineBreak":true},{"text":"i a zↄ̀blenapiↄ wɛ̃nagwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Buipãleↄ ń diiↄ pì ń ã́nusuo ń vuaoɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩna ↄgbɛↄnɛ.","poem":1},{"noteId":251}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa lɛ́ vĩ, aali yã'oo,","poem":1},{"lineBreak":true},{"text":"aa wɛ́ vĩ, aali gu'e sↄ̃o.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aa swã́ vĩ, aali yãmao,","poem":1},{"lineBreak":true},{"text":"an lɛ́ ĩ́ana vĩo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"An pinaↄ gↄ̃ńwaɛ","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ lɛ́ ń náaikɛↄ píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Isailiↄ, à Dii sáaukpa!","poem":1},{"lineBreak":true},{"text":"Aalona buiↄ, à Dii sáaukpa!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Levii buiↄ, à Dii sáaukpa!","poem":1},{"lineBreak":true},{"text":"Dii vĩakɛnaↄ, à Dii sáaukpa!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wà Dii sáaukpa Siↄna,","poem":1},{"lineBreak":true},{"text":"à bɛkpà Yelusalɛũ.","poem":1},{"lineBreak":true},{"text":"Àleluya!","poem":1}]}],"footnotes":[{"noteId":248,"caller":"+","text":"135.8 Bↄa 12.29","reference":{"chapter":135,"verse":8}},{"noteId":249,"caller":"+","text":"135.9 Bↄa 7.3","reference":{"chapter":135,"verse":9}},{"noteId":250,"caller":"+","text":"135.11 Nao 21.21-24, 33-35","reference":{"chapter":135,"verse":11}},{"noteId":251,"caller":"+","text":"135.15 Soũ 115.4-8, Zia 9.20","reference":{"chapter":135,"verse":15}}]},"thisChapterLink":"/api/bqc_sim/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}