{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":137,"content":[{"type":"heading","content":["Zĩ̀zↄↄ ↄ́ↄlↄa"]},{"type":"verse","number":1,"content":[{"text":"Zↄ̃lɛa Babɛli bùsu swaↄ saɛ","poem":1},{"noteId":257},{"lineBreak":true},{"text":"Siↄna yã́ dↄ̀wágu, ↄ̃ wa ↄ́ↄlↄ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wa wá mↄↄnaↄ tò looa swagbalaliↄwa we.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aa wá kũaↄ lɛ gbɛ̀awá,","poem":1},{"lineBreak":true},{"text":"wá wɛtãnaↄ mɛ̀ wà ń pↄna yá,","poem":1},{"lineBreak":true},{"text":"wà Siↄna lɛe sínɛ́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kpelewa wá Dii lɛↄ si","poem":1},{"lineBreak":true},{"text":"kua buipãleↄ bùsu guui?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó Yelusalɛũ yã́ sã̀magu,","poem":1},{"lineBreak":true},{"text":"to ma ↄplaa imi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó Yelusalɛũ yã́ lí dↄmaguo,","poem":1},{"lineBreak":true},{"text":"mɛ́ mi aà dilɛ ma pↄnakɛbↄ mide ũo,","poem":1},{"lineBreak":true},{"text":"to ma lɛ́na naalɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dii, tó yã́ pↄ́ Ɛdↄũↄ kɛ̀ Yelusalɛũ wãgↄↄ dↄngu aa mɛ̀:","poem":1},{"lineBreak":true},{"text":"À wíwi, à wíwi, à daaĩ míↄmiↄ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pↄ́kaalɛaↄá Babɛli bùsudeↄ!","poem":1},{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ a yã́ pↄ́ á kɛ̀wɛ̃ɛ fĩaboɛ́ ũ.","poem":1},{"noteId":258}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ a á nɛ́ↄ kṹkũ","poem":1},{"lineBreak":true},{"text":"à ń wíwi gbɛsiwa ũ.","poem":1},{"noteId":259}]}],"footnotes":[{"noteId":257,"caller":"+","text":"137.1 Eze 1.1, 3","reference":{"chapter":137,"verse":1}},{"noteId":258,"caller":"+","text":"137.8 Zia 18.6","reference":{"chapter":137,"verse":8}},{"noteId":259,"caller":"+","text":"137.9 Isa 13.16","reference":{"chapter":137,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}