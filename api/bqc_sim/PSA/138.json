{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":138,"content":[{"type":"heading","content":["Dii sáaukpaa aà gbɛ̃kɛ yã́i"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Má n sáaukpa ń nↄ̀sɛmɛndoo,","poem":1},{"lineBreak":true},{"text":"má n táasilɛ gbãadeↄ aɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Má kúlɛ n kpɛ́ pↄ́ a kua adoa aɛ,","poem":1},{"noteId":260},{"lineBreak":true},{"text":"má n tↄbↄ n gbɛ̃kɛ ń n náaio yã́i,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ ń tò n tↄ́ ń n yã́o zↄ̃ↄ dɛ pↄ́piia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gↄↄ pↄ́ ma lɛzùnzi, ń wèa,","poem":1},{"lineBreak":true},{"text":"n ma gba wↄ́ↄ ń gbãao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tó dṹnia kíaↄ yã́ pↄ́ ń ò mà,","poem":1},{"lineBreak":true},{"text":"aa n sáaukpa ń píi, Dii.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa lɛsi Dii kɛkɛáↄ yã́ musu,","poem":1},{"lineBreak":true},{"text":"asa Dii gawi zↄ̃ↄɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Baa ń Dii kuamusukɛo,","poem":1},{"lineBreak":true},{"text":"ì gbɛ̃́ kɛ̃́sãanaↄ wɛgwa,","poem":1},{"noteId":261},{"lineBreak":true},{"text":"ì wɛvĩ gbɛ̃́ pↄ́ aalɛ e wà kàↄla.","poem":1},{"noteId":262}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Baa tó má yooyea, ni ma bↄ,","poem":1},{"lineBreak":true},{"text":"ni ma ibɛɛↄ pↄkũma kpálɛ,","poem":1},{"lineBreak":true},{"text":"ni ma suaba ń n gã̀sa gbãao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii a ma yã́ píi lɛkpaaĩmɛɛ,","poem":1},{"noteId":263},{"lineBreak":true},{"text":"Dii, n gbɛ̃kɛ láaa vĩo.","poem":1},{"lineBreak":true},{"text":"Ńsu zĩ pↄ́ n ↄkpàwà too.","poem":1}]}],"footnotes":[{"noteId":260,"caller":"+","text":"138.2 1Kia 8.29","reference":{"chapter":138,"verse":2}},{"noteId":261,"caller":"+","text":"138.6 Luk 1.48","reference":{"chapter":138,"verse":6}},{"noteId":262,"caller":"+","text":"138.6 Zaa 4.6","reference":{"chapter":138,"verse":6}},{"noteId":263,"caller":"+","text":"138.8 Flp 1.6","reference":{"chapter":138,"verse":8}}]},"thisChapterLink":"/api/bqc_sim/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}