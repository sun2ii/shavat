{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":139,"content":[{"type":"heading","content":["Dii yã́pii dↄ̃a"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Dii, n ma tàasikà ń dↄ̃̀,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ń ma zↄ̃lɛa ń ma fɛlɛao dↄ̃.","poem":1},{"lineBreak":true},{"text":"Ń n zãkɛo ń yã́ pↄ́ málɛ yáↄ kũa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ni ma táa'oa ń ma wúlɛao gwa,","poem":1},{"lineBreak":true},{"text":"ma kɛkɛá píi dↄ́ɛkɛ̀nnↄ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E yã́ àↄ gɛ́ bↄi ma lɛ́u,","poem":1},{"lineBreak":true},{"text":"Dii, ń dↄ̃ sã́asã.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ń liaamazi kpɛ ń aɛo,","poem":1},{"lineBreak":true},{"text":"n ↄ kumala.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dↄ̃a bee dɛmɛɛ dabuyã ũɛ,","poem":1},{"lineBreak":true},{"text":"a dɛmala, ma ↄ̃nↄ i kawào.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Má má gɛ́u mà pili n Nisĩnawai?","poem":1},{"lineBreak":true},{"text":"Má má bàalɛ tau, ńyↄ̃ↄ ku weo ni?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tó ma fɛlɛ gɛ́ musu, ń kú we!","poem":1},{"lineBreak":true},{"text":"Tó ma tòo sↄ̀ miau, ń kɛ́!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó ma fɛlɛ gɛ ĩatɛ̃bilɛkĩi gukpɛ,","poem":1},{"lineBreak":true},{"text":"tó ma gɛ zↄ̃lɛ ísia baale bɛ'aɛ,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"baa wekĩi má naa n ↄzĩɛ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ↄ ma kũa n ↄplaauɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tó ma mɛ̀ gusia kumala,","poem":1},{"lineBreak":true},{"text":"ge gupua pↄ́ má kúu li gwã́ ũ,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"gu líↄ sianɛo,","poem":1},{"noteId":264},{"lineBreak":true},{"text":"gwã́ ìↄ puanɛ lán fãanɛwaɛ,","poem":1},{"lineBreak":true},{"text":"asa gupua ń gusiao doũ nɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ḿmɛ n ma sↄ̃ pɛ̀mɛɛ,","poem":1},{"lineBreak":true},{"text":"n ma ikàsa ma da nↄ̀sɛu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma n sáaukɛ̀, n yãkɛa ì dia,","poem":1},{"lineBreak":true},{"text":"ma kɛa dɛ dabuyã ũ, à bↄ̀ ma saɛ,","poem":1},{"lineBreak":true},{"text":"a yã́ ma kũa gbãa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gↄↄ pↄ́ ma daalɛ nɛasakpɛ guu,","poem":1},{"lineBreak":true},{"text":"ma wáe ulɛanɛo.","poem":1},{"lineBreak":true},{"text":"Kɛ́ ma mɛ lɛ́ i asii guu we,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"n wɛsìmalɛ nↄ'itɛ̃na ũ.","poem":1},{"lineBreak":true},{"text":"Lá n ma gↄↄ dìlɛ píi,","poem":1},{"lineBreak":true},{"text":"a lɛ́ kú n taalau","poem":1},{"lineBreak":true},{"text":"zadↄ̃ a kee i daalɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Lua, n làasoo gbiamɛɛ maamaaɛ,","poem":1},{"lineBreak":true},{"text":"a naoa zↄ̃ↄ fá!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó má ye nao, an dasi dɛ ũfãaa.","poem":1},{"lineBreak":true},{"text":"Tó ma vu, miↄ kunnↄɛ e tia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lua, bↄ́ ńlɛ dã́ ń gbɛ̃vãiↄi?","poem":1},{"lineBreak":true},{"text":"À gomala gbɛ̃dɛnaↄ!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N ibɛɛↄ ì n yã'o ń nↄ̀sɛvãioɛ,","poem":1},{"lineBreak":true},{"text":"n tↄ́ gbia ń lɛ́uo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dii, má za n zangudeↄguo lé?","poem":1},{"lineBreak":true},{"text":"Má ye gbɛ̃́ pↄ́ fɛ̀lɛnnↄↄ gĩyãio.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Má zańgu vãivãi,","poem":1},{"lineBreak":true},{"text":"ma ń dílɛ ma ibɛɛↄ ũɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Lua, ma gwagwa, ní ma nↄ̀sɛ dↄ̃,","poem":1},{"lineBreak":true},{"text":"ma tàasika, níↄ ma asiiↄ kũa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gwa tó má dↄ́ɛ'ĩi vĩ,","poem":1},{"lineBreak":true},{"text":"ní dↄaamɛɛ n zɛ́ gasai guu.","poem":1}]}],"footnotes":[{"noteId":264,"caller":"+","text":"139.12 Dan 2.22","reference":{"chapter":139,"verse":12}}]},"thisChapterLink":"/api/bqc_sim/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}