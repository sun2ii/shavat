{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":14,"content":[{"type":"heading","content":["Mìsaide yã'oa"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Mìsaideↄ ì o ń sↄ̃ guu Lua kuo.","poem":1},{"lineBreak":true},{"text":"Aa ↄ̃̀ↄkpà, an yãkɛa vãi,","poem":1},{"lineBreak":true},{"text":"yãmaakɛna kú ń guuo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Za musu Dii ì wɛ́tɛ gbɛ̃nazĩnaↄzi,","poem":1},{"lineBreak":true},{"text":"ì gwa tó gbɛ̃e ↄ̃nↄ kà a kĩ́i wɛɛlɛa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa sã̀sã píi, aa gↄ̃̀ dↄ̀ↄsai míↄmiↄ,","poem":1},{"lineBreak":true},{"text":"yãmaakɛna kuo, baa do.","poem":1},{"noteId":11}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vãikɛna wɛ́ lí gu'eo lé?","poem":1},{"lineBreak":true},{"text":"Aaì ma gbɛ̃́ↄ mↄ́mↄ lán úwa,","poem":1},{"lineBreak":true},{"text":"aali lɛzu Diizio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gwa, vĩa a ń kṹ we maamaa,","poem":1},{"lineBreak":true},{"text":"asa Lua a zɛ ń gbɛ̃maaↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vãikɛna ì kpa taasideɛ a pↄeãu,","poem":1},{"lineBreak":true},{"text":"kási sↄ̃ Dii mɛ́ taaside ulɛkĩi ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lua, bↄ Siↄna mↄ ǹ Isailiↄ bↄ!","poem":1},{"lineBreak":true},{"text":"Tó Dii sù ń a gbɛ̃́ↄ ń pá ziu,","poem":1},{"lineBreak":true},{"text":"Yakↄbu buiↄ pↄnakɛ,","poem":1},{"lineBreak":true},{"text":"Isailiↄ yáalↄ.","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"14.3 Lom 3.10-12","reference":{"chapter":14,"verse":3}}]},"thisChapterLink":"/api/bqc_sim/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}