{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":140,"content":[{"type":"heading","content":["Wabikɛa gbɛ̃vãiↄ yã́ musu"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dii, ma si gbɛ̃vãiↄwa,","poem":1},{"lineBreak":true},{"text":"ma dↄ̃́a gbɛ̃́ pãsĩpiↄ yã́i.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aaì yãvãi wàaipa ń sↄ̃ guu,","poem":1},{"lineBreak":true},{"text":"sòle lɛ́ ↄ̃ aaìↄ wɛ́ gↄↄpii.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aaì ń lɛ́ kɛkɛ lán mlɛ̃wa,","poem":1},{"lineBreak":true},{"text":"an lɛgbɛ'iá sↄ̀gbala sɛwɛɛ.","poem":1},{"noteId":265}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii, ńsu to gbɛ̃vãiↄ ↄkãao,","poem":1},{"lineBreak":true},{"text":"ma si gbɛ̃́ pãsĩpiↄwa,","poem":1},{"lineBreak":true},{"text":"aaì ↄzↄ̃amazi lɛkpaaĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waladepiↄ ɛyↄ̃̀mɛɛ,","poem":1},{"lineBreak":true},{"text":"aa filifilimbakpàmɛɛ,","poem":1},{"lineBreak":true},{"text":"aa baikpàmɛɛ zɛ́u.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Má ò Diiɛ: Ma Luan n ũ,","poem":1},{"lineBreak":true},{"text":"swã́kpa ma wɛ̃na wiii, Dii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii Lua, ma Suabana gbãa,","poem":1},{"lineBreak":true},{"text":"ni ↄkumala zĩ guu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ńsu to gbɛ̃vãiↄ pↄeã zɛkɛo,","poem":1},{"lineBreak":true},{"text":"Dii, ńsu to an lɛkpaaĩ kↄ̃sɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"To gbɛ̃́ pↄ́ liaamaziↄ midɛ,","poem":1},{"lineBreak":true},{"text":"to vãi pↄ́ aalɛ o wí ń musu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"To tɛyↄ̃ wãa ɛ́lɛmá,","poem":1},{"lineBreak":true},{"text":"to aa si ɛ pↄ́ aa fↄ̃ bↄuo guu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ńsu to yã́siade zɛkĩi e dṹniauo,","poem":1},{"lineBreak":true},{"text":"to vãi aↄ gbɛ̃́ pãsĩ wɛ zɛsaiɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Má dↄ̃ Dii ì yãnakpa wɛ̃nadeↄwa,","poem":1},{"lineBreak":true},{"text":"ì yãkɛkɛ taasideↄnɛ a zɛ́wa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ mɛ́ aa n tↄbↄ,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuadeↄ mɛ́ aaↄ ku n kĩ́i.","poem":1}]}],"footnotes":[{"noteId":265,"caller":"+","text":"140.4 Lom 3.13","reference":{"chapter":140,"verse":4}}]},"thisChapterLink":"/api/bqc_sim/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":14}