{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":141,"content":[{"type":"heading","content":["Suabaa wabikɛa"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Dii, málɛ wiilɛnzi, kɛ kpakpa,","poem":1},{"lineBreak":true},{"text":"tó ma lɛzùnzi, swã́kpa ma yã́i.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma wabikɛa a kama","poem":1},{"lineBreak":true},{"text":"lán tulaleti súɛlɛwa,","poem":1},{"noteId":266},{"lineBreak":true},{"text":"ma ↄ dↄa musu iↄ dɛnɛ sa oosi oa ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dii, ma lɛ́na dↄ̃́amɛɛ.","poem":1},{"lineBreak":true},{"text":"To mà a lɛ́ fↄ̃́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ńsu to ma nↄ̀sɛ ta yãvãiwa","poem":1},{"lineBreak":true},{"text":"mà gↄ̃ dàade ũ ń vãikɛnaↄ,","poem":1},{"lineBreak":true},{"text":"mà ↄdaaańnↄ ń blɛnablea guuo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃maa ma gbɛ̃, gbɛ̃kɛkɛaɛ!","poem":1},{"lineBreak":true},{"text":"Tó à ma swãgàga, má gíio,","poem":1},{"lineBreak":true},{"text":"à nísikà ma miwa.","poem":1},{"lineBreak":true},{"text":"Miↄ wabikɛ kɛ́ gbɛ̃vãiↄ yãkɛaↄ su zɛkɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tó wà ń gbɛ̃zↄ̃ↄↄ kwɛ̀ yãtɛ̃u,","poem":1},{"lineBreak":true},{"text":"wa si sa kɛ́ ma yã́ mɛ́ na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lá wì yàa paa a fɛ́ɛnaↄ fãaa,","poem":1},{"lineBreak":true},{"text":"màa an wá aↄ kálɛ ń mia'ɛlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii Lua, ḿmɛ ma wɛ́ pɛ́ma,","poem":1},{"lineBreak":true},{"text":"ma nanziɛ, ńsu ma kpámáo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma suaba ń mↄ pↄ́ aa kpàmɛɛo,","poem":1},{"lineBreak":true},{"text":"to mà zã bai pↄ́ vãikɛnaↄ kpàmɛɛi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"To gbɛ̃vãipiↄ si ńzĩa bai guu,","poem":1},{"lineBreak":true},{"text":"mapi sↄ̃ mí dↄi aafia.","poem":1}]}],"footnotes":[{"noteId":266,"caller":"+","text":"141.2 Zia 5.8, 8.3","reference":{"chapter":141,"verse":2}}]},"thisChapterLink":"/api/bqc_sim/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}