{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":142,"content":[{"type":"heading","content":["Wabikɛa gbɛ̀'ɛu"]},{"type":"verse","number":1,"content":[{"text":"Davidi wabikɛa gↄↄ pↄ́ a ku gbɛ̀'ɛu.","descriptive":true},{"noteId":267}]},{"type":"verse","number":2,"content":[{"text":"Málɛ ↄ́ gbãa dↄ Diiɛ,","poem":1},{"lineBreak":true},{"text":"málɛ wɛ̃na wii lɛ Diiwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Málɛ a yã'ↄ̃ma bↄlɛɛ̀,","poem":1},{"lineBreak":true},{"text":"málɛ a taasikɛa siuɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó ma wɛ̃ni gↄ̃̀ lɛɛ,","poem":1},{"lineBreak":true},{"text":"ḿmɛ niↄ ma kua dↄ̃.","poem":1},{"lineBreak":true},{"text":"Wà baikpàmɛɛ ma táa'ozɛu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wɛ́sɛ ǹ ma ↄplaa gwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e lɛ́ ma yãdao.","poem":1},{"lineBreak":true},{"text":"Ulɛkĩi làaa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e lɛ́ ma aafia gbɛao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dii, málɛ wiilɛma ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Ḿmɛ ń ma ulɛkĩi ũ,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ń ma baa ũ dṹniaɛ beeu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Swãdↄ ma wiilɛai,","poem":1},{"lineBreak":true},{"text":"asa ma gↄ̃ mugɛɛnnↄɛ.","poem":1},{"lineBreak":true},{"text":"Ma si ma gbɛ̀sɛlɛnaↄwa,","poem":1},{"lineBreak":true},{"text":"asa an gbãa dɛmalaɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma bↄ yooyeaɛ beeu,","poem":1},{"lineBreak":true},{"text":"kɛ́ mà n tↄbↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maaↄ i kãaamazi,","poem":1},{"lineBreak":true},{"text":"kɛ́ n maakɛ̀mɛɛ yã́i.","poem":1}]}],"footnotes":[{"noteId":267,"caller":"+","text":"142.1 1Sam 22.1","reference":{"chapter":142,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}