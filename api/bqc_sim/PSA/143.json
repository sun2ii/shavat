{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":143,"content":[{"type":"heading","content":["Kua ibɛɛↄ ↄzĩ wabikɛa"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Dii, ma wabikɛa sí,","poem":1},{"lineBreak":true},{"text":"swãdↄ ma wɛ̃na wiii.","poem":1},{"lineBreak":true},{"text":"Wea n náai ń n maao yã́i.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ńsu yã́kpalɛkɛ ń mapi n zↄ̀blenaoo,","poem":1},{"lineBreak":true},{"text":"asa gbɛ̃e kunɛ tàaesaio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ma ibɛɛ ma gbɛsɛ̀lɛ à ↄ̃zↄ̃̀a,","poem":1},{"lineBreak":true},{"text":"a tò má kú gusiau","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃́ pↄ́ gà à gɛ̃̀gɛ̃wa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɔ̃ ma wɛ̃ni gↄ̃̀ lɛɛ,","poem":1},{"lineBreak":true},{"text":"ma pↄ yà dúuduu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gĩa dↄ̀magu,","poem":1},{"lineBreak":true},{"text":"málɛ làasookɛ n zĩkɛaↄwa,","poem":1},{"lineBreak":true},{"text":"málɛ n yãkɛaↄ wàaipa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma ↄ dↄnzi,","poem":1},{"lineBreak":true},{"text":"málɛ n mↄ̀sɛ nidɛ lán gugiiwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wea kpakpa Dii, ma yɛ̃̀ɛɛ làa.","poem":1},{"lineBreak":true},{"text":"Ńsu bↄ ma kpɛ mà gↄ̃","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃́ pↄ́ sì bɛdauↄwao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ n gbɛ̃kɛ ↄlↄmɛɛ kↄↄ,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ má n náai vĩ.","poem":1},{"lineBreak":true},{"text":"Ma da zɛ́ pↄ́ dɛ mà sɛwa,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ ma azĩa kpàma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma si ma ibɛɛↄwa, Dii,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ma nanzi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ḿmɛ ń ma Lua ũ,","poem":1},{"lineBreak":true},{"text":"ǹ n pↄeãkɛa damɛɛ.","poem":1},{"lineBreak":true},{"text":"N Nisĩna maa dↄaamɛɛ gusalalau.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma lɛ́ ń láo n tↄ́ yã́i, Dii,","poem":1},{"lineBreak":true},{"text":"ma bↄ taasi guu n maa yã́i.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma ibɛɛↄ midɛ n gbɛ̃kɛ yã́i,","poem":1},{"lineBreak":true},{"text":"ma wɛ̀lɛↄ dɛdɛ píi,","poem":1},{"lineBreak":true},{"text":"asa n zↄ̀blenan ma ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}