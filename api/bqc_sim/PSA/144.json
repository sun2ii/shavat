{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":144,"content":[{"type":"heading","content":["Wabikɛa misia yã́ musu"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Má Dii ma gbɛsi sáaukpa,","poem":1},{"lineBreak":true},{"text":"ì zĩkaa ↄ na damɛɛ,","poem":1},{"lineBreak":true},{"text":"ì to ma ↄ àↄ kai vĩ zĩ guu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɔ̃mɛ ma ulɛkĩi ũ, ì gbɛ̃kɛkɛmɛɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ ma zɛgikĩi ũ, ì ma suaba.","poem":1},{"lineBreak":true},{"text":"Ɔ̃mɛ ma sɛ̀ngbao pↄ́ mi mikpai ũ,","poem":1},{"lineBreak":true},{"text":"ì to buiↄ mikpaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dii, bↄ́n gbɛ̃nazĩna ũ an yã́ ìↄ dↄngui?","poem":1},{"lineBreak":true},{"text":"Bↄ́n ń ũ, ni laaidↄmái?","poem":1},{"noteId":268}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna dɛ lán kàsafiiwaɛ,","poem":1},{"lineBreak":true},{"text":"aà wɛ̃ni ì gɛ̃zɛa lán uenawaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii, ǹ n bɛ siilɛ ǹ pila,","poem":1},{"lineBreak":true},{"text":"ↄkã gbɛ̀sĩsĩↄwa aa súɛlɛbↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"To lou pílɛpilɛ ǹ gbɛ̃́ↄ fãaa,","poem":1},{"lineBreak":true},{"text":"ka fã́ńgu, gili i gɛ̃ńgu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɔbↄ za musu ǹ ma kṹ.","poem":1},{"lineBreak":true},{"text":"Ma bↄ í zↄ̃ↄ guu,","poem":1},{"lineBreak":true},{"text":"ma si bui zĩ̀loↄwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yã pã oa mɛ́ ń lɛ́ pà,","poem":1},{"lineBreak":true},{"text":"aaì ↄlɛlɛ ń lɛ́ pã gbɛ̃ao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lua, má lɛ̀ dafu sínɛ,","poem":1},{"lineBreak":true},{"text":"má n táasilɛ ń kúu bakwio.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ni to kíaↄ zĩble,","poem":1},{"lineBreak":true},{"text":"ni n zↄ̀blena Davidi bↄ fɛ̃n'ↄↄ lɛ́zĩ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma kũ ǹ ma bↄ bui zĩ̀loↄ guu,","poem":1},{"lineBreak":true},{"text":"yãpã oa mɛ́ ń lɛ́ pà,","poem":1},{"lineBreak":true},{"text":"aaì ↄlɛlɛ ń lɛ́ pã gbɛ̃ao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wá nɛgↄ̃ɛↄ pɛ́lɛ ń ɛ̀waasokɛu lán lí pɛawa,","poem":1},{"lineBreak":true},{"text":"wá nɛnↄɛↄ aaↄ dɛ lán kibɛ gbɛ̀pɛlɛ kɛfɛnawa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wá dↄ̃ↄ pa, aaↄ pↄ́pii vĩ,","poem":1},{"lineBreak":true},{"text":"wá pↄtuoↄ kↄ̃ lɛɛ ↄ̀aa sↄo,","poem":1},{"lineBreak":true},{"text":"aa ka ↄ̀aasↄsↄo lɛɛ kwi wá kpàsau.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wá zuↄ aso zↄ̃ↄ sɛ́sɛ.","poem":1},{"lineBreak":true},{"text":"Bĩ́igbooa aↄ kuo, lala'oa aↄ kuo,","poem":1},{"lineBreak":true},{"text":"búbuapɛa aↄ ku gãaɛ lↄo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Báaadeↄn gbɛ̃́ pↄ́ an kua dɛ màaↄ ũ.","poem":1},{"lineBreak":true},{"text":"Báaadeↄn gbɛ̃́ pↄ́ Dii dɛ ń Lua ũↄ ũ.","poem":1}]}],"footnotes":[{"noteId":268,"caller":"+","text":"144.3 Soũ 8.4, Ɛbɛ 2.6","reference":{"chapter":144,"verse":3}}]},"thisChapterLink":"/api/bqc_sim/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}