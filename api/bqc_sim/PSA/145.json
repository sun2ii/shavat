{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":145,"content":[{"type":"heading","content":["Dii táasilɛa aà maakɛa yã́i"]},{"type":"hebrew_subtitle","content":["Dii táasi pↄ́ Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Má n táasilɛ ma Lua, ma Kía,","poem":1},{"lineBreak":true},{"text":"máↄ n tↄbↄ gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Máↄ n sáaukpa lá gu lɛ́ dↄ,","poem":1},{"lineBreak":true},{"text":"máↄ n táasilɛ láasaiɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii zↄ̃ↄ, à kà wà aà táasilɛ,","poem":1},{"lineBreak":true},{"text":"aà zↄ̃ↄkɛ lɛ́ vĩo.","poem":1},{"noteId":269}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kpàiↄ n yãkɛaↄ sáaukpa Wueↄnɛ,","poem":1},{"lineBreak":true},{"text":"aa n yãzↄ̃ↄkɛaↄ galikɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa n maa zↄ̃ↄ gawide yã'o,","poem":1},{"lineBreak":true},{"text":"má n yãbↄnsaɛkɛaↄ wàaipa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa n dabudabukɛa gbãa yã'o,","poem":1},{"lineBreak":true},{"text":"mí n zↄ̃ↄkɛ dau siunɛ́.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa n maakɛa zↄ̃ↄ baokpa,","poem":1},{"lineBreak":true},{"text":"aai gulakɛ n yã́zɛdekɛaↄ yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii sùuu vĩ ń sósobio,","poem":1},{"lineBreak":true},{"text":"aà pↄ lí pa kpaao, a gbɛ̃kɛ vĩ zↄ̃ↄ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii ì maakɛ gbɛ̃́piiɛ,","poem":1},{"lineBreak":true},{"text":"ì a pↄkɛaↄ wɛ̃nagwa píi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii, n pↄkɛaↄ n sáaukpa píi,","poem":1},{"lineBreak":true},{"text":"n yãmanaↄ n tↄbↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa n kpala gawi faai bo,","poem":1},{"lineBreak":true},{"text":"aa n iko gbãa yã'o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa n yãzↄ̃ↄkɛaↄ da gbɛ̃́ↄnɛ","poem":1},{"lineBreak":true},{"text":"ń n kpala maa gawide yã́o.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N kpalaá kpala láasaiɛ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ↄ dɛ kía ũ wɛ̃̀ píiɛ.","poem":1},{"lineBreak":true},{"text":"Dii náai vĩ a yã́pii musu,","poem":1},{"lineBreak":true},{"text":"a sùuu vĩ ń a pↄkɛaↄ píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dii ì gbɛ̃́ pↄ́ lɛ́ lɛ́lɛↄ kṹ,","poem":1},{"lineBreak":true},{"text":"ì gbɛ̃́ pↄ́ taasi tↄ̃̀máↄ fɛlɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pↄ́pii wɛ́ dↄnzi,","poem":1},{"lineBreak":true},{"text":"ni blɛ kpámá a gↄↄwa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ni ↄ poonɛ́, pↄ́ mↄ́má,","poem":1},{"lineBreak":true},{"text":"ni pↄ́ bɛ̃́ɛ píi pↄeã bↄↄlɛkɛɛ̀.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dii kɛkɛáↄ maa píi,","poem":1},{"lineBreak":true},{"text":"a gbɛ̃kɛ vĩ a yã́pii kɛa guu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dii kãi ń a sìsinaↄ píi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aaì aà sísi ń sĩanaoↄ.","poem":1},{"noteId":270}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ì a vĩakɛnaↄ pↄeã bↄↄlɛnɛ́,","poem":1},{"lineBreak":true},{"text":"ì ń wiilɛa ma, i ń suaba.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii ì gbɛ̃́ pↄ́ yeaziↄ dↄ̃́a píi,","poem":1},{"lineBreak":true},{"text":"ãma a vãikɛnaↄ míↄnzↄ̃ɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dii táasilɛa aↄ dↄ ma lɛ́uɛ.","poem":1},{"lineBreak":true},{"text":"Pↄ́pii aaↄ aà tↄbↄgↄↄ píi, asa a kua adoaɛ.","poem":1}]}],"footnotes":[{"noteId":269,"caller":"+","text":"145.3 Lom 11.33","reference":{"chapter":145,"verse":3}},{"noteId":270,"caller":"+","text":"145.18 Zãa 4.24","reference":{"chapter":145,"verse":18}}]},"thisChapterLink":"/api/bqc_sim/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}