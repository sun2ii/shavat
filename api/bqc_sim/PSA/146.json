{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":146,"content":[{"type":"heading","content":["Dii laaidↄa wɛ̃nadeↄwa"]},{"type":"verse","number":1,"content":[{"text":"Àleluya!","poem":1},{"lineBreak":true},{"text":"Mapi, má Dii táasilɛ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"máↄ Dii táasilɛ e ma wɛ̃ni lɛ́uɛ,","poem":1},{"lineBreak":true},{"text":"máↄ lɛsi ma Luaɛ ma kua lɛ́uɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ásu sↄ̃kpalɛ gbãadeↄzio,","poem":1},{"lineBreak":true},{"text":"gbɛ̃suabaa ku gbɛ̃nazĩna kĩ́io.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó an wea làa, aaì ɛa gɛ̃ tíuɛ,","poem":1},{"lineBreak":true},{"text":"zĩbeezĩ yã́ pↄ́ aalɛ yá ì midɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Báaaden gbɛ̃́ pↄ́ Yakↄbu Lua mɛ́ aà dↄnlɛde ũ ũ,","poem":1},{"lineBreak":true},{"text":"aà wɛ́ ìↄ dↄ Dii a Luazi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɔ̃mɛ musu ń zĩ́lɛo kɛ̀,","poem":1},{"lineBreak":true},{"text":"ísia ń pↄ́ pↄ́ kú a guuↄ píi.","poem":1},{"noteId":271}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ì yãnakpa gbɛ̃́ pↄ́ wàlɛ gbãamↄnɛ́ↄwa,","poem":1},{"lineBreak":true},{"text":"ì blɛ kpa nↄandɛnaↄwa.","poem":1},{"lineBreak":true},{"text":"Dii ì babↄ gbɛ̃́ pↄ́ yeelɛaↄwa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii ì vĩ̀aↄ wɛ́ wɛ̃nɛ́,","poem":1},{"noteId":272},{"lineBreak":true},{"text":"Dii ì gbɛ̃́ pↄ́ taasi tↄ̃̀máↄ fɛlɛ,","poem":1},{"lineBreak":true},{"text":"Dii ìↄ ye gbɛ̃maaↄzi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii ì bↄ̀mↄↄ gwa,","poem":1},{"lineBreak":true},{"text":"ì ↄda gyaaↄ ń tonɛↄwa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì zɛ́ kaaũ gbɛ̃vãiↄnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dii ìↄ kible gↄↄpiiɛ.","poem":1},{"lineBreak":true},{"text":"Siↄnadeↄ, á Lua ìↄ ku e á buiwaɛ.","poem":1},{"lineBreak":true},{"text":"Àleluya!","poem":1}]}],"footnotes":[{"noteId":271,"caller":"+","text":"146.6 Zĩn 4.24, 14.15","reference":{"chapter":146,"verse":6}},{"noteId":272,"caller":"+","text":"146.8 Mat 9.30, Zãa 9.7","reference":{"chapter":146,"verse":8}}]},"thisChapterLink":"/api/bqc_sim/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}