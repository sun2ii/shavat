{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":147,"content":[{"type":"heading","content":["Pↄ́pii kua Lua ↄzĩ"]},{"type":"verse","number":1,"content":[{"text":"Àleluya!","poem":1},{"lineBreak":true},{"text":"Lɛsia wá Luaɛ maa mɛ́ a na,","poem":1},{"lineBreak":true},{"text":"à kũ̀ wà aà táasilɛɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii lɛ́ Yelusalɛũ fɛlɛ lↄ,","poem":1},{"lineBreak":true},{"text":"à Isaili zĩ̀zↄↄ nàaa lɛ́ suńnↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ì gbɛ̃́ pↄ́ an pↄ yàↄ nↄ̀sɛ níninɛ́,","poem":1},{"lineBreak":true},{"text":"ì nísidↄↄ ń gu'ĩaↄwa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ì saanaↄ nao,","poem":1},{"lineBreak":true},{"text":"a ń baade dↄ̃ ń a tↄ́o.","poem":1},{"noteId":273}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wá Dii zↄ̃ↄ, a iko vĩ maamaaɛ,","poem":1},{"lineBreak":true},{"text":"aà ↄ̃nↄ lɛ́ vĩo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii ì zĩabusanaↄ gba gbãa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì ↄtↄ̃ vãikɛnaↄwa e zĩ́lɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À lɛsi Diiɛ ń aà sáaukpaao,","poem":1},{"lineBreak":true},{"text":"à wá Lua táasilɛ ń mↄↄnao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ì to lou sisi,","poem":1},{"lineBreak":true},{"text":"ì tↄↄlɛ gba lou,","poem":1},{"lineBreak":true},{"text":"ì to sɛ̃ bↄlɛ sĩ̀sĩa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ì blɛ kpa nↄ̀bↄↄwa","poem":1},{"lineBreak":true},{"text":"ń gbagbaa nɛ́ↄ, tó aalɛ wiipɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I kɛ sↄ̃́ gbãaↄ mɛ́ ì kaaàguo,","poem":1},{"lineBreak":true},{"text":"i kɛ gↄ̃sagbãakɛ mɛ́ ì kɛɛ̀o.","poem":1},{"noteId":274}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aa aà vĩa vĩↄ mɛ́ ì kaaàgu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ an wɛ́ dↄ aà gbɛ̃kɛipiↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yelusalɛũdeↄ, à Dii tↄbↄ,","poem":1},{"lineBreak":true},{"text":"Siↄnadeↄ, à á Lua táasilɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Asa ì báaadaáguɛ,","poem":1},{"lineBreak":true},{"text":"ì á wɛ̃́lɛ bↄlɛ gbã́aↄ gba gbãa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ì á gba aafiaʼe á bùsu lɛ́ lɛ́u,","poem":1},{"lineBreak":true},{"text":"ì pↄbui maa kpáwá à kã́.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ì yã'o kpã́sã tↄↄlɛ,","poem":1},{"lineBreak":true},{"text":"aà yã́ ì ká ń bao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ì nɛɛzi kwɛ púuu lán sãkãwa,","poem":1},{"lineBreak":true},{"text":"ì to fíi kpá lán túfuwa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ì lougbɛ fã́ɛ lán gbɛ̀kↄsↄwa.","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ zɛ a ĩ́anaii?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ì yã'o kpã́sã, ↄ̃ lougbɛpi ì yↄ́,","poem":1},{"lineBreak":true},{"text":"ì ĩ́ana gbaɛ, a í ì bàalɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ì to Yakↄbu buiↄ a yã́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"ì ikoyã pↄ́ á dìlɛↄ da Isailiↄnɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I bee kɛ buipãleↄnɛo,","poem":1},{"lineBreak":true},{"text":"aa aà yãdilɛaↄ dↄ̃o.","poem":1},{"lineBreak":true},{"text":"Àleluya!","poem":1}]}],"footnotes":[{"noteId":273,"caller":"+","text":"147.4 Isa 40.26","reference":{"chapter":147,"verse":4}},{"noteId":274,"caller":"+","text":"147.10 1Sam 16.7","reference":{"chapter":147,"verse":10}}]},"thisChapterLink":"/api/bqc_sim/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}