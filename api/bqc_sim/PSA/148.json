}]}],"footnotes":[{"noteId":275,"caller":"+","text":"148.4 Daa 1.7","reference":{"chapter":148,"verse":4}},{"noteId":276,"caller":"+","text":"148.5 Daa 1.1, 3","reference":{"chapter":148,"verse":5}},{"noteId":277,"caller":"+","text":"148.6 Daa 1.14","reference":{"chapter":148,"verse":6}},{"noteId":278,"caller":"+","text":"148.7 Daa 1.21","reference":{"chapter":148,"verse":7}}]},"thisChapterLink":"/api/bqc_sim/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}