{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":148,"content":[{"type":"heading","content":["Dii pↄkɛaↄ aà táasilɛa"]},{"type":"verse","number":1,"content":[{"text":"Àleluya!","poem":1},{"lineBreak":true},{"text":"À Dii táasilɛ aà bɛdeↄ!","poem":1},{"lineBreak":true},{"text":"À aà táasilɛ za musu!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À aà táasilɛ aà malaikaↄ píi!","poem":1},{"lineBreak":true},{"text":"À aà táasilɛ aà ìwaↄ píi!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À aà táasilɛ ĩatɛ̃ ń mↄvuao!","poem":1},{"lineBreak":true},{"text":"À aà táasilɛ saan'inaↄ píi!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bàluma kpɛle pↄ́ↄ","poem":1},{"lineBreak":true},{"text":"ń í pↄ́ kú luabɛpuanaaↄ,","poem":1},{"noteId":275},{"lineBreak":true},{"text":"à aà táasilɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aa Dii tↄbↄ,","poem":1},{"lineBreak":true},{"text":"asa ↄ̃m