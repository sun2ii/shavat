{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":16,"content":[{"type":"heading","content":["Naa Luazi"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Ma dↄ̃́a Lua,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ma nanzi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Má ò Diiɛ ma diin n ũ,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ń ma aafia ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N gbɛ̃́ pↄ́ kú ma bùsuuↄ","poem":1},{"lineBreak":true},{"text":"mɛ́ dɛ gawide pↄ́ ì kamaguↄ ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aaì wã gɛ́ tã́a kĩ́iↄ","poem":1},{"lineBreak":true},{"text":"aaì yã'ↄ̃ma kpá ńzĩaziɛ.","poem":1},{"lineBreak":true},{"text":"Má sa'o'i tↄ̃́lɛńnↄo,","poem":1},{"lineBreak":true},{"text":"wa ń tã́aↄ tↄ́ ma ma lɛ́uo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii, n ma ka ma baawa,","poem":1},{"lineBreak":true},{"text":"ma wɛ̃ni ku n ↄzĩɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N kↄↄ dàmɛɛ gumaau,","poem":1},{"lineBreak":true},{"text":"gba pↄ́ ń dàmɛɛ kàmagu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Má Dii táasilɛ kɛ́ ì lɛdaa,","poem":1},{"lineBreak":true},{"text":"baa gwã́ ì to ma sↄ̃ ma gba laai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Miↄ Dii e ma wɛ́u gↄↄpii,","poem":1},{"lineBreak":true},{"text":"lá a kumanↄ, má kpaguao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bee yã́i ma pↄ ìↄ na,","poem":1},{"lineBreak":true},{"text":"ma nↄ̀sɛ ìↄ yáalↄ,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ dↄi lↄ ma mɛ aↄ ku aafia.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Asa ńyↄ̃ ma to miauo,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ we n yãmana yaikɛo.","poem":1},{"noteId":12}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ma ka wɛ̃ni zɛ́wa,","poem":1},{"lineBreak":true},{"text":"n kĩ́i pↄna ìↄ pɛɛau,","poem":1},{"lineBreak":true},{"text":"pↄmaaↄ ku n ↄzĩ gↄↄpii.","poem":1},{"noteId":13}]}],"footnotes":[{"noteId":12,"caller":"+","text":"16.10 Zĩn 13.35","reference":{"chapter":16,"verse":10}},{"noteId":13,"caller":"+","text":"16.11 Zĩn 2.25-31","reference":{"chapter":16,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}