{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":17,"content":[{"type":"heading","content":["Wabikɛa"]},{"type":"hebrew_subtitle","content":["Davidi wabikɛa."]},{"type":"verse","number":1,"content":[{"text":"Dii, ma yãma,","poem":1},{"lineBreak":true},{"text":"asa ma yã́ naɛ,","poem":1},{"lineBreak":true},{"text":"swãdↄ ma wiilɛai,","poem":1},{"lineBreak":true},{"text":"ma wabikɛa ma,","poem":1},{"lineBreak":true},{"text":"asa málɛ kɛ ń mↄafilioo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N kĩ́i má yãna eu,","poem":1},{"lineBreak":true},{"text":"n wɛ́ lɛ́ yã́ pↄ́ zɛvĩ e sã́asã.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ma sↄ̃ gwà, n wɛ́tɛmazi gwã́,","poem":1},{"lineBreak":true},{"text":"n ma tàasikà, ni yãe eao,","poem":1},{"lineBreak":true},{"text":"asa ma zɛò ma lɛ́ a ma kalikɛ̃o.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mili tɛ́ gbɛ̃nazĩna yãkɛaↄzio,","poem":1},{"lineBreak":true},{"text":"mili gbɛ̃́ pãsĩↄ ↄlɛsɛo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma bɛ n zɛ́u súsu,","poem":1},{"lineBreak":true},{"text":"mi pãalɛ n yã́ɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Málɛ lɛzunzi, asa ńyↄ̃ wea.","poem":1},{"lineBreak":true},{"text":"Lua, swã́sɛ ma wabikɛai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ n gbɛ̃kɛ bↄnsaɛ kɛmɛɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ nànziↄ bↄ ń ibɛɛↄ ↄzĩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Laaidↄa lá ń wɛ́bɛsianawa,","poem":1},{"lineBreak":true},{"text":"ní ma sↄlↄ n kúlukulunau.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma si gbɛ̃vãi pↄ́ aaì ĩadaaↄwa,","poem":1},{"lineBreak":true},{"text":"ma ibɛɛ pↄ́ liaamazipiↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aali gbɛ̃e wɛgwao,","poem":1},{"lineBreak":true},{"text":"an lɛ́ ì yↄ̃̀ↄ yã'o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa pɛ̀lɛmazi aa lìamazi,","poem":1},{"lineBreak":true},{"text":"aa wɛbìia kɛ́ aa e ma pã́lɛ zĩ́lɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa ye ma taitai","poem":1},{"lineBreak":true},{"text":"lán nↄ̀ↄmusu nↄandɛnawa,","poem":1},{"lineBreak":true},{"text":"lán nↄ̀ↄkusi pↄ́ naalɛa gusaɛnawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dii, fɛlɛ dańlɛ, ní ń kwɛ́,","poem":1},{"lineBreak":true},{"text":"ma si gbɛ̃vãipiↄwa ń n fɛ̃ndao,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ma bↄ gbɛ̃́piↄ ↄzĩ ń n gbãao.","poem":1},{"lineBreak":true},{"text":"An baa ku dṹniaɛ bee guu,","poem":1},{"lineBreak":true},{"text":"an àizɛɛ ìↄ dińzi, an nɛ́ↄ ì kã́,","poem":1},{"lineBreak":true},{"text":"aaì pↄ́ pↄ́ fɛ̃̀ↄ kálɛ ń nɛ́piↄnɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Má wɛsinlɛ ma nↄ̀sɛmaa yã́i,","poem":1},{"lineBreak":true},{"text":"tó ma n e ma vugↄↄ, bee a mↄa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}