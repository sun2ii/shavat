{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":18,"content":[{"type":"heading","content":["Zĩblea sáaukpaa"]},{"type":"verse","number":1,"content":[{"text":"Lɛ pↄ́ Dii zↄ̀blena Davidi sìɛ̀ gↄↄ pↄ́ à aà bↄ̀ Saulu ń aà ibɛɛ kĩniↄ ↄzĩ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Má yenzi Dii,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ń ma gbãa ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lua mɛ́ ma gbɛsi ũ,","poem":1},{"lineBreak":true},{"text":"mi naaàzi,","poem":1},{"lineBreak":true},{"text":"ma Lua mɛ́ ma zɛgikĩi ũ,","poem":1},{"lineBreak":true},{"text":"ì ma misi.","poem":1},{"lineBreak":true},{"text":"A dɛ ma sɛ̀ngbao ũ,","poem":1},{"lineBreak":true},{"text":"má aà náai vĩ,","poem":1},{"lineBreak":true},{"text":"a dɛ ma suaban gbãa ũ,","poem":1},{"lineBreak":true},{"text":"ì ma dↄ̃́a.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii kà wà aà sáaukpa.","poem":1},{"lineBreak":true},{"text":"Mi lɛzuaàzi,","poem":1},{"lineBreak":true},{"text":"ì ma bↄ ma ibɛɛↄ ↄzĩ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gó kpàlɛmanↄ,","poem":1},{"lineBreak":true},{"text":"kaalɛ swa lɛ́ ma ble.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mia baↄ galakpàmɛɛ,","poem":1},{"lineBreak":true},{"text":"ga baikpàmɛɛ ma aɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma yeelɛa guu màa ma Dii sìsi,","poem":1},{"lineBreak":true},{"text":"ma lɛzù ma Luazi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ma lↄↄ mà za a bɛ,","poem":1},{"lineBreak":true},{"text":"ma wii kàwà, à gɛ̃̀ aà swã́u.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tↄↄlɛ lùalua à zĩ̀azĩa,","poem":1},{"lineBreak":true},{"text":"gbɛ̀sĩsĩↄ dèedee ń zĩ́nau,","poem":1},{"lineBreak":true},{"text":"aa lùalua kɛ́ aà pↄ pà yã́i.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Súɛlɛ bↄ̀ aà níu,","poem":1},{"lineBreak":true},{"text":"tɛ́ pↄ́ ì kṹmá bↄ̀ aà lɛ́u,","poem":1},{"lineBreak":true},{"text":"a yↄ̃ↄ lɛ́ pipi aà aɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À gu kɛ̃̀aa musu à pìla,","poem":1},{"lineBreak":true},{"text":"lou sìsi aà gbá zíɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Àlɛ vua dia malaika gã̀sĩade kpɛ,","poem":1},{"lineBreak":true},{"text":"àlɛ yàakpa ń ĩ́anao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À gusia kù azĩala,","poem":1},{"lineBreak":true},{"text":"à luabɛsiana kɛ̀ a kúkĩi ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lousisia dↄ̀aa aà gawi pílɛaɛ,","poem":1},{"lineBreak":true},{"text":"lougbɛ kwɛ̀, lou pìlɛpilɛ pãsĩpãsĩ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii Musude pàla za musu,","poem":1},{"lineBreak":true},{"text":"aà lↄↄ dↄ louvĩa ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À ka fã̀ ma ibɛɛↄgu à ń fãaa,","poem":1},{"lineBreak":true},{"text":"Lua sùmá à ń yá.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kɛ́ n palamá Dii,","poem":1},{"lineBreak":true},{"text":"ísia tↄↄlɛ bↄ̀ gupuau,","poem":1},{"lineBreak":true},{"text":"kɛ́ n pↄbↄ̀ n níu,","poem":1},{"lineBreak":true},{"text":"dṹnia zĩ́na bↄ̀ puizi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"À ↄbↄ̀ za musu à ma kũ,","poem":1},{"lineBreak":true},{"text":"à ma bↄ ísiu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"À ma si ma ibɛɛ gbãawa","poem":1},{"lineBreak":true},{"text":"ń ma wɛ̀lɛ pↄ́ an gbãa dɛmalaↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aa ã̀naa ma wɛ̃nakɛgↄↄ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ Dii zɛ̀manↄ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"À ma bↄ à ma gba dɛ̀ɛpookĩi,","poem":1},{"lineBreak":true},{"text":"à ma mìsi kɛ́ a yemazi yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dii yãkɛ̀mɛɛ ma nↄ̀sɛmaa lɛ́u,","poem":1},{"lineBreak":true},{"text":"à fĩabòmɛɛ ma gbãsĩsai lɛ́u.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Asa má Dii yãdilɛaↄ kũa,","poem":1},{"lineBreak":true},{"text":"mi vãikɛ ma a Lua tò weo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Aà ikoyãↄ ìↄ dↄaaamɛɛ,","poem":1},{"lineBreak":true},{"text":"mi bↄ yã́ pↄ́ a dìlɛↄ kpɛo.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ma kua tàae vĩ Diiɛo,","poem":1},{"lineBreak":true},{"text":"má azĩa kũa duunasai.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dii fĩabòmɛɛ ma nↄ̀sɛmaa lɛ́u,","poem":1},{"lineBreak":true},{"text":"asa a è má kú gbãsĩsaiɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ń náai vĩ náaideↄnɛ,","poem":1},{"lineBreak":true},{"text":"tàaesaiden n ũ tàaesaideↄnɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ń wásawasa gbɛ̃́ wásawasaↄnɛ,","poem":1},{"lineBreak":true},{"text":"ãma ni kↄ̃nikɛ gbɛ̃́ dↄ̀ↄsaiↄnɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ni zĩabusanaↄ suaba,","poem":1},{"lineBreak":true},{"text":"ni gbɛ̃́ pↄ́ aaì ńzĩa sɛ lɛsĩↄ busa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Dii, ni ma filia tɛfɛlɛ,","poem":1},{"lineBreak":true},{"text":"ma Lua, ni ma gusia lilɛ gupua ũ.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ń n gbãao má fↄ̃ kuadi kaawa,","poem":1},{"lineBreak":true},{"text":"ń ma Lua dↄnlɛo má fↄ̃ vĩ gĩa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Luapi sↄ̃, aà yãkɛa bↄ̀lɛi.","poem":1},{"lineBreak":true},{"text":"Dii yã́ sãa vĩo.","poem":1},{"lineBreak":true},{"text":"A dɛ sɛ̀ngbao ũ gbɛ̃́ pↄ́ nàaziↄnɛ.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Dii bàasio, démɛ Lua ũi?","poem":1},{"lineBreak":true},{"text":"Wá Lua bàasio, démɛ gbɛsi ũi?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Lua mɛ́ ì ma gba gbãa,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ ì zɛpoomɛɛ súsu.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ì to ma wá nakũ lán tuewa,","poem":1},{"lineBreak":true},{"text":"ì to màↄ bɛ bùsu gulɛsĩↄ musu.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ì zĩkaa dadamɛɛ","poem":1},{"lineBreak":true},{"text":"e ma gã̀sĩ fↄ̃ mↄgotɛ̃ sá gá.","poem":1}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"Ni n zĩblesɛ̀ngbao kpaa,","poem":1},{"lineBreak":true},{"text":"ń ma kũa ń n ↄplaao,","poem":1},{"lineBreak":true},{"text":"ni naalɛ ǹ ma tↄbↄ.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ni ma zɛ́ yàasa kũmɛɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma gbá lí gbãlɛo.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Ma pɛlɛ ma wɛ̀lɛↄzi ma ń kũkũ,","poem":1},{"lineBreak":true},{"text":"mi kpɛkpao e ma gɛ ń dɛdɛò.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Ma ń wiwi, aai e fɛ̀lɛo,","poem":1},{"lineBreak":true},{"text":"aa kwɛ̀ gↄ̃̀ kálɛa ma gbá zíɛ.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"N ma gba gbãa, ma zĩkàò,","poem":1},{"lineBreak":true},{"text":"ń tò ma ibɛɛↄ mikpàa.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Ń tò ma wɛ̀lɛↄ kpɛkpà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma a zangudepiↄ mìdɛ.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Aa wiilɛ̀, gbɛ̃e i ń suabao,","poem":1},{"lineBreak":true},{"text":"aa lɛzù Diizi, i yãmamáo.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ma ń kɛ́ búɛbuɛ","poem":1},{"lineBreak":true},{"text":"lán luutɛ̃ pↄ́ ĩ́ana sɛ̀wa,","poem":1},{"lineBreak":true},{"text":"ma táa'òmá lán zɛ́ guu pɛ̀lɛawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"N ma bↄ gbɛ̃́ pↄ́ fɛ̀lɛmanↄↄ ↄzĩ,","poem":1},{"lineBreak":true},{"text":"n ma kɛ buiↄ mide ũ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ má ń dↄ̃oↄ lɛ́ zↄblemɛɛ.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Bui zĩ̀loↄ ì vlãnaumɛɛ,","poem":1},{"lineBreak":true},{"text":"tó aa ma yãmà, aaì misiilɛmɛɛ.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Buipãleↄ kúsu ì kwɛ́,","poem":1},{"lineBreak":true},{"text":"aaì bↄ ń zɛgikĩiↄu ń lualuao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Dii ku! Báaaden ma gbɛsi ũ!","poem":1},{"lineBreak":true},{"text":"Wà Lua ma Suabana tↄbↄ.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Lua mɛ́ ì tↄsimɛɛ,","poem":1},{"lineBreak":true},{"text":"ì buiↄ totomɛɛ.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Ń tò ma pili ma ibɛɛↄwa,","poem":1},{"lineBreak":true},{"text":"n ma gba gbãa dɛ ma wɛ̀lɛↄla,","poem":1},{"lineBreak":true},{"text":"n ma bↄ gbɛ̃́ pãsĩↄ ↄzĩ.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"A yã́i má n sáaukpa buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"má n táasilɛ, Dii.","poem":1},{"noteId":14}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Dii ì zĩ̀ zↄ̃ↄ ble kía pↄ́ á sɛ̀ɛ,","poem":1},{"lineBreak":true},{"text":"ì gbɛ̃kɛkɛ kía pↄ́ á kpàpiɛ,","poem":1},{"lineBreak":true},{"text":"ma Davidi ń ma buiↄ e gↄↄpii.","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"18.50 Lom 15.9","reference":{"chapter":18,"verse":50}}]},"thisChapterLink":"/api/bqc_sim/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":51}