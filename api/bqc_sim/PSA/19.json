{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":19,"content":[{"type":"heading","content":["Luabɛ gawi ń Lua yã gawio"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Musu ì Lua gawi bↄ gupuau,","poem":1},{"lineBreak":true},{"text":"bàluma pↄ́ↄ ì aà zĩ ↄlↄnɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ìↄ yãdanɛ́ lá gu lɛ́ dↄ,","poem":1},{"lineBreak":true},{"text":"ì dↄ̃a kpámá gwã́ ń gwã́o.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ìli yã'oo, aà yã'oa bui kuo,","poem":1},{"lineBreak":true},{"text":"wìli a kĩ́a mao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aà lↄↄ ì gɛ́ dṹnia guu píi,","poem":1},{"lineBreak":true},{"text":"aà yã'oa ì gɛ́ e tↄↄlɛ lɛ́wa.","poem":1},{"noteId":15},{"lineBreak":true},{"text":"Lua kpɛdↄ̀ ĩatɛ̃ɛ we,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ì bↄ kpɛ́u à bilɛ lán nↄsɛnawa,","poem":1},{"lineBreak":true},{"text":"ì fɛlɛ ń táo ń pↄnao lán nɛgↄ̃nawa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ì fɛlɛ luabɛ lɛ́la,","poem":1},{"lineBreak":true},{"text":"ì pãa gɛ́ e a lɛ́le,","poem":1},{"lineBreak":true},{"text":"pↄe líↄ ulɛa a pusuio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii ikoyã paɛa,","poem":1},{"lineBreak":true},{"text":"ì ń nↄ̀sɛ níninɛ́.","poem":1},{"lineBreak":true},{"text":"Dii yã́ náai vĩ,","poem":1},{"lineBreak":true},{"text":"ì lɛda ↄ̃nↄsaideↄwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii ì ↄtona dↄnɛ́ súsu,","poem":1},{"lineBreak":true},{"text":"ì ń pↄ kɛ na.","poem":1},{"lineBreak":true},{"text":"Dii yãdilɛaↄ gbãsĩ vĩo,","poem":1},{"lineBreak":true},{"text":"ì ń oa weenɛ́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Misiilɛa Diiɛ zɛ́pi wɛbↄa,","poem":1},{"lineBreak":true},{"text":"waↄ tɛi gↄↄpii,","poem":1},{"lineBreak":true},{"text":"Dii yã́kpalɛkɛa sĩana vĩ,","poem":1},{"lineBreak":true},{"text":"yã́pi ìↄ maa wásawasa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aà yãmaa dɛ vuaa, baa vua maa,","poem":1},{"lineBreak":true},{"text":"a na dɛ zↄ́'ia, baa zↄ́ bùsu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ni lɛda mapi n zↄ̀blenawa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ n yã́ kũa ài ìↄ zↄ̃ↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Démɛ a fↄ̃ yã́ pↄ́ álɛ zãwàↄ dↄ̃i?","poem":1},{"lineBreak":true},{"text":"Sùuukɛmanↄ ń ma tàae pↄ́ ulɛaↄ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ńsu to mapi n zↄ̀blena dↄ́ɛnnↄo,","poem":1},{"lineBreak":true},{"text":"duuna su gbãableao,","poem":1},{"lineBreak":true},{"text":"míↄ kú wásawasa tàae zↄ̃ↄ sai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"To yã́ pↄ́ lɛ́ bↄ ma lɛ́u","poem":1},{"lineBreak":true},{"text":"ń làasoo pↄ́ kú ma sↄ̃uo kangu","poem":1},{"lineBreak":true},{"text":"Dii, ma gbɛsi, ma Suabana.","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"19.5 Lom 10.18","reference":{"chapter":19,"verse":5}}]},"thisChapterLink":"/api/bqc_sim/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":15}