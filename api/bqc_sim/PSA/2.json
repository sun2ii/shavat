{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":2,"content":[{"type":"heading","content":["Kía pↄ́ Lua kpà"]},{"type":"verse","number":1,"content":[{"text":"Bↄ́yãi bui ń buio lɛ́ zↄakai?","poem":1},{"lineBreak":true},{"text":"Àkɛa wàlɛ lɛ́ pã kpaaĩi?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dṹnia kíaↄ lɛ́ zĩ̀ sↄukɛ,","poem":1},{"lineBreak":true},{"text":"kpalablenaↄ lɛ́ kãaa Dii","poem":1},{"lineBreak":true},{"text":"ń Kía pↄ́ a kpàozi.","poem":1},{"noteId":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aalɛ mɛ: Wà ń mↄdaonaↄ kɛ̃́kɛ̃,","poem":1},{"lineBreak":true},{"text":"wà ń ba polowá.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dii lɛ́ ń àlafiikɛ,","poem":1},{"lineBreak":true},{"text":"zↄ̃lɛa musu àlɛ ń yáalↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A palamá ń pↄfɛ̃o,","poem":1},{"lineBreak":true},{"text":"aà kpɛ̃nɛ ì to vĩa ń kṹ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À mɛ̀ a a Kía kpà","poem":1},{"lineBreak":true},{"text":"a gbɛ̀sĩsĩ Siↄna musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Má yã́ pↄ́ Dii dìlɛmɛɛ o à mɛ̀:","poem":1},{"lineBreak":true},{"text":"Ma nɛ́n n ũ, n Maen ma ũ gbã.","poem":1},{"noteId":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wabikɛa, mí n gba bui píi,","poem":1},{"lineBreak":true},{"text":"mí dṹnia gola síiↄ̃ kpama n pↄ́ ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ kiblemá ń mↄ̀ gopanao,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ ń wíwi lá wì gĩ̀ oo wiwa.","poem":1},{"noteId":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kíaↄ, à lɛdamaɛ bee ma,","poem":1},{"lineBreak":true},{"text":"dṹnia kpalablenaↄ, à ↄ̃nↄkũ sa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"À zↄble Diiɛ ń vĩakɛaɛ̀o,","poem":1},{"lineBreak":true},{"text":"à kúlɛ bùsu sɛɛ̀ ń lualuao,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"kɛ́ aà pↄ su fɛ̃́ázi à gaga zɛ́uo,","poem":1},{"lineBreak":true},{"text":"asa aà pↄ ì pa kã́ndoɛ.","poem":1},{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ nàaàzi ũ.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"2.2 Zĩn 4.25-26","reference":{"chapter":2,"verse":2}},{"noteId":2,"caller":"+","text":"2.7 2Sam 7.14, Mat 3.17, Zĩn 13.33, Ɛbɛ 1.5, 5.5","reference":{"chapter":2,"verse":7}},{"noteId":3,"caller":"+","text":"2.9 Zia 2.26-27, 12.5, 19.15","reference":{"chapter":2,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}