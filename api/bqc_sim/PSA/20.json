{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":20,"content":[{"type":"heading","content":["Zĩblea wabikɛa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dii sinnↄ n yeelɛa guu,","poem":1},{"lineBreak":true},{"text":"Yakↄbu buiↄ Lua n sɛ lɛsĩ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kua za aà kúkĩi a n suaba,","poem":1},{"lineBreak":true},{"text":"kua za Siↄna a dↄnlɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aà n sa'oa píi sí,","poem":1},{"lineBreak":true},{"text":"n sa'obↄↄ i dↄaàgu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aà pↄ́ pↄ́ n pↄ gbà kpama,","poem":1},{"lineBreak":true},{"text":"aà to ǹ yã́ pↄ́ ńlɛ yá le,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"wí gulakɛ zĩ pↄ́ ń blè yã́ musu,","poem":1},{"lineBreak":true},{"text":"wí dàlapoo da ń wá Lua tↄ́o.","poem":1},{"lineBreak":true},{"text":"Dii wabi pↄ́ ń kɛ̀ sinnↄ píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Má dↄ̃̀ sa Dii ì kía pↄ́ a kpà suaba,","poem":1},{"lineBreak":true},{"text":"ì siaànↄ za a bɛ pↄ́ a kua adoau,","poem":1},{"lineBreak":true},{"text":"i to aà zĩble ń a gã̀sa gbãao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃eↄ ì zĩkasↄ̃goↄ náaikɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃eↄ ì sↄ̃́ↄ náaikɛ,","poem":1},{"lineBreak":true},{"text":"wápiↄ sↄ̃, Dii wá Lua náai wi kɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ampiↄ, aa kúlɛ aa lɛ́lɛ,","poem":1},{"lineBreak":true},{"text":"wápiↄ sↄ̃ wáↄ zɛa gíũgiũɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dii, to kí zĩble,","poem":1},{"lineBreak":true},{"text":"tó wa lɛzùnzi, síwanↄ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}