{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":21,"content":[{"type":"heading","content":["Zĩblea sáaukpaa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dii, kí lɛ́ pↄnakɛ ń n gbãao,","poem":1},{"lineBreak":true},{"text":"aà pↄ na maamaa kɛ́ ń tò à zĩblè.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N pↄ́ pↄ́ aà pↄ gbà kpàwà,","poem":1},{"lineBreak":true},{"text":"ni gí aà wabikɛa síiaànↄo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N danlɛ kɛ̀ɛ̀ ń ɛ̀fãai zↄ̃ↄo,","poem":1},{"lineBreak":true},{"text":"n vua fùa kpàɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À wɛ̃ni gbɛ̀ama, ↄ̃ ń kpàwà,","poem":1},{"lineBreak":true},{"text":"ń tò a ku e gↄↄpii.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aà gawi zↄ̃ↄ kɛ́ ń tò à zĩblè,","poem":1},{"lineBreak":true},{"text":"n gawi ń zↄ̃ↄkɛo kpàwà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Niↄ báaadaaàgu gↄↄpii,","poem":1},{"lineBreak":true},{"text":"n kuaaànↄ tò aà pↄ kɛ̀na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa kí Dii náai vĩ,","poem":1},{"lineBreak":true},{"text":"kua Musude gbɛ̃kɛu a kpaguao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ńyↄ̃ ↄdiɛ n ibɛɛↄwa,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ n wɛ̀lɛↄ kṹ ń n ↄplaao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ ń kɛ mua yàa ũ n mↄgↄↄ,","poem":1},{"lineBreak":true},{"text":"Dii a ń míↄnzↄ̃ a pↄfɛ̃gↄↄ,","poem":1},{"lineBreak":true},{"text":"i to tɛ́kũmá.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ ń nɛ́ↄ midɛ dṹnia guu,","poem":1},{"lineBreak":true},{"text":"ní ń buiↄ kɛ̃ gbɛ̃nazĩnaↄwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Baa tó aa lɛkpàaĩnzi,","poem":1},{"lineBreak":true},{"text":"an pↄeã a fↄ̃ zĩkɛo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ ka dↄdↄ ń wɛ́wa,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ to aa kpɛkpa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"N gbãa guu, Dii, ǹ nzĩa kã́fĩ,","poem":1},{"lineBreak":true},{"text":"wí lɛsi wà n gↄ̃sakɛ táasilɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":14}