{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":22,"content":[{"type":"heading","content":["Wiilɛa Luawa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ma Lua, ma Lua,","poem":1},{"lineBreak":true},{"text":"bↄ́yãi n ma to wei?","poem":1},{"noteId":16},{"lineBreak":true},{"text":"Ma wiilɛ̀,","poem":1},{"lineBreak":true},{"text":"àkɛa ńlɛ mↄ́ ma suabaio ni?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma Lua, ma lɛzùnzi fãanɛ,","poem":1},{"lineBreak":true},{"text":"ni weao,","poem":1},{"lineBreak":true},{"text":"ma wiilɛ̀ma gwãasĩna,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ń nílɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N kua adoa, ń zↄ̃lɛa báawa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ Isailiↄ ì ń táasilɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ḿmɛ wá deziↄ n náaikɛ̀,","poem":1},{"lineBreak":true},{"text":"aa n náaikɛ̀ ↄ̃ n ń mìsi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aa lɛzùnzi ↄ̃ aa bↄkĩi è,","poem":1},{"lineBreak":true},{"text":"aa n náaikɛ̀ ↄ̃ wí i ń kũo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kↄ̀ↄtɛ̃n ma ũ, gbɛ̃nazĩnan ma ũo,","poem":1},{"lineBreak":true},{"text":"wàlɛ ma sↄ̃sↄ̃, wàlɛ sakamagu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ ma gwaↄ lɛ́ ma yáalↄ,","poem":1},{"lineBreak":true},{"text":"aalɛ lɛsuikɛa,","poem":1},{"lineBreak":true},{"text":"aalɛ mikɛ déũdeũ aalɛ mɛ:","poem":1},{"noteId":17}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lá àlɛ Dii náaikɛ, aà aà bↄ,","poem":1},{"lineBreak":true},{"text":"tó aà yã́ kàaàguɛ, aà aà misi.","poem":1},{"noteId":18}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ḿmɛ n ma bↄ ma da nↄ̀sɛu,","poem":1},{"lineBreak":true},{"text":"n ma dↄ aà yↄ̃́wa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má na n ↄzĩ za nɛasakpɛuɛ,","poem":1},{"lineBreak":true},{"text":"ń dɛ ma Lua ũ za ma da nↄ̀sɛu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ńsu ǹyↄ̃ kumanↄ zã̀o,","poem":1},{"lineBreak":true},{"text":"asa taasi lɛ́ mɛkpa,","poem":1},{"lineBreak":true},{"text":"mɛ́ gbɛ̃e ku à dↄmalɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wa liaamazi dasidasi lán zugaaeↄwa,","poem":1},{"lineBreak":true},{"text":"wa pooamazi lán Basana zuswanaↄwa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wàlɛ lɛdↄdↄa lán nↄ̀ↄmusu ↄↄlↄna pↄ́ aalɛ pↄ́ taitaiↄwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma gbãa gɛ̃̀zɛa lán í kↄ́lɛawa,","poem":1},{"lineBreak":true},{"text":"ma guↄ bↄ̀ↄũ píi,","poem":1},{"lineBreak":true},{"text":"ma mɛ yↄ̀ lán zↄsawa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma kòlo giigàga lán pɛ̃nkasowa,","poem":1},{"lineBreak":true},{"text":"ma lɛ́na nàalɛ ma lɛ́ musu.","poem":1},{"noteId":19},{"lineBreak":true},{"text":"Wà ma wulɛ lán gɛwa bùsutiu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Gbɛ̃́ↄ liaamazi dasidasi lán gbɛ̃ↄwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãipiↄ nↄ̀nↄaamazi,","poem":1},{"lineBreak":true},{"text":"aa ma ↄↄ ń ma gbáↄ fↄ̃̀fↄ̃.","poem":1},{"noteId":20}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Má fↄ̃ mà a wáↄ nao píi.","poem":1},{"lineBreak":true},{"text":"Wà wɛbìibii, wàlɛ ma gwa,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"wàlɛ ma pↄkasaↄ kpaalɛ,","poem":1},{"lineBreak":true},{"text":"wàlɛ tɛ́lɛpa ma ulatao yã́ musu.","poem":1},{"noteId":21}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dii, ńsu ǹyↄ̃ kumanↄ zã̀o,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ń ma gbãa ũ,","poem":1},{"lineBreak":true},{"text":"mↄ dↄmalɛ kpakpa,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ma bↄ an fɛ̃nda lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"ma wɛ̃ni si gbɛ̃piↄ swaawa,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ma bↄ nↄ̀ↄmusupiↄ lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"ma si zùsɛ̃lɛpiↄ kↄ́bawa,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"mí n tↄbↄ ma gbɛ̃́ↄnɛ,","poem":1},{"lineBreak":true},{"text":"mí n táasilɛ kↄ̃kãaa guu.","poem":1},{"noteId":22}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Á Dii vĩakɛnaↄ, à aà táasilɛ,","poem":1},{"lineBreak":true},{"text":"á Yakↄbu buiↄ, à aà tↄbↄ,","poem":1},{"lineBreak":true},{"text":"á Isailiↄ, à misiilɛɛ̀.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Asa i saka taasideguo,","poem":1},{"lineBreak":true},{"text":"i aà wɛ̃nadekɛ yaboo,","poem":1},{"lineBreak":true},{"text":"i mikpɛdↄɛ̀o,","poem":1},{"lineBreak":true},{"text":"à swãkpà aà wiilɛai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Má n táasilɛ balu guu,","poem":1},{"lineBreak":true},{"text":"má lɛ́ pↄ́ má kɛ̀ma fĩabo n vĩakɛnaↄ wáa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Taasideↄ pↄble aa kã́,","poem":1},{"lineBreak":true},{"text":"Dii kĩ́i wɛ̀ɛlɛnaↄ aa aà táasilɛ,","poem":1},{"lineBreak":true},{"text":"aaiↄ ku gↄↄpii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Dṹnia bṹu gbɛ̃́ↄ Dii dↄ̃, aai zɛaànↄ,","poem":1},{"lineBreak":true},{"text":"bui pↄ́ kúuↄ kúlɛɛ̀ píi,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"asa kpalableaá Dii yã́ɛ,","poem":1},{"lineBreak":true},{"text":"ì kible bui píiwa.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Dṹnia gbãadeↄ kúlɛɛ̀ píi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ gɛ̀ gɛ́kĩiↄ misiilɛɛ̀ píi.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"An buiↄ zↄbleɛ̀,","poem":1},{"lineBreak":true},{"text":"aa Dii yã́ dau siu ziadeↄnɛ,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"aai o gbɛ̃́ pↄ́ wi ń i yãaoↄnɛ","poem":1},{"lineBreak":true},{"text":"lá à yãnakpàmá,","poem":1},{"lineBreak":true},{"text":"asa a kɛ̀.","poem":1}]}],"footnotes":[{"noteId":16,"caller":"+","text":"22.2 Mat 27.46, Maa 15.34","reference":{"chapter":22,"verse":2}},{"noteId":17,"caller":"+","text":"22.8 Mat 27.39, Maa 15.29, Luk 23.35","reference":{"chapter":22,"verse":8}},{"noteId":18,"caller":"+","text":"22.9 Mat 27.43","reference":{"chapter":22,"verse":9}},{"noteId":19,"caller":"+","text":"22.16 Zãa 19.28","reference":{"chapter":22,"verse":16}},{"noteId":20,"caller":"+","text":"22.17 Zãa 20.27","reference":{"chapter":22,"verse":17}},{"noteId":21,"caller":"+","text":"22.19 Mat 27.35, Maa 15.24, Luk 23.34, Zãa 19.24","reference":{"chapter":22,"verse":19}},{"noteId":22,"caller":"+","text":"22.23 Ɛbɛ 2.12","reference":{"chapter":22,"verse":23}}]},"thisChapterLink":"/api/bqc_sim/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":32}