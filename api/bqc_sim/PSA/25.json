{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":25,"content":[{"type":"heading","content":["Lua wá dↄ̃̀ana"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Dii, ma azĩa kpàmaɛ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ma Lua, málɛ n náaikɛ.","poem":1},{"lineBreak":true},{"text":"Ńsu to wí ma kũo,","poem":1},{"lineBreak":true},{"text":"ńsu to ma ibɛɛↄ tidↄmalao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wí a gbɛ̃́ pↄ́ an wɛ́ dↄnziↄ kũo,","poem":1},{"lineBreak":true},{"text":"sema gbɛ̃́ pↄ́ bↄ̀ n kpɛ pãↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dii, ǹ n zɛ́ ↄlↄmɛɛ,","poem":1},{"lineBreak":true},{"text":"ní n yã́ dadamɛɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gɛmanↄ n sĩanau, ní dadamɛɛ,","poem":1},{"lineBreak":true},{"text":"asa Lua ma Suabanan n ũ,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ ìↄ dↄnziɛ gↄↄpii.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N sùuu ń n gbɛ̃kɛo aↄ dↄngu,","poem":1},{"lineBreak":true},{"text":"asa ń vĩ za káauɛ, Dii.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ńsu tàae pↄ́ má kɛ̀ↄ yãdao","poem":1},{"lineBreak":true},{"text":"ge duuna pↄ́ má kɛ̀ ma ɛ̀waasogↄↄ.","poem":1},{"lineBreak":true},{"text":"Ma yã́ àↄ dↄngu gbɛ̃kɛ guu,","poem":1},{"lineBreak":true},{"text":"kɛ́ ń maa yã́i, Dii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii maa, ì yãkɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"bee yã́i ì a yãdada duunkɛnaↄnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ì zĩabusanaↄ da a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"ì yãmaa dadanɛ́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii ìↄ gbɛ̃kɛ ń náaio vĩ","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ zɛ̀ ń a bàakuańnↄ yã́o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Baa kɛ́ ma duuna zↄ̃ↄ Dii,","poem":1},{"lineBreak":true},{"text":"sùuukɛmanↄ n tↄ́ yã́i.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Démɛ Dii vĩa vĩi?","poem":1},{"lineBreak":true},{"text":"Dii ì ade da zɛ́ pↄ́ dɛ aà sɛwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ade aↄ ku nama guu,","poem":1},{"lineBreak":true},{"text":"aà buiↄ mɛ́ aa gↄ̃ ń bùsu vĩ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii gbɛ̃kɛ vĩ ń a vĩakɛnaↄ,","poem":1},{"lineBreak":true},{"text":"ì to aaↄ a bàakuańnↄ yã́ dↄ̃.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma wɛ́ ìↄ pɛ Diiwa gↄↄpii,","poem":1},{"lineBreak":true},{"text":"asa ↄ̃mɛ ì ma gbá bↄ bau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ma wɛgwa, wɛ̃nadↄ̃mɛɛ,","poem":1},{"lineBreak":true},{"text":"asa má kú mado ń taasio.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma yã'ↄ̃maↄ kↄ̃̀ ma nↄ̀sɛ guu,","poem":1},{"lineBreak":true},{"text":"ma bↄ ma wɛ́tɛ̃api guu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ma taasi ń ma pↄsiao gwa,","poem":1},{"lineBreak":true},{"text":"ní ma duuna woloa píi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gwa lá ma ibɛɛↄ lìgua,","poem":1},{"lineBreak":true},{"text":"aa zamagu pãsĩpãsĩ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma wɛ̃ni dↄ̃́a, ní ma misi,","poem":1},{"lineBreak":true},{"text":"ńsu to wí ma kũo, asa ma nanziɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"To sĩana ń kua maao àↄ ma dↄ̃́a,","poem":1},{"lineBreak":true},{"text":"asa ma wɛ́ ìↄ dↄnziɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Lua, Isailiↄ bↄ ń taasikɛaↄu píi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}