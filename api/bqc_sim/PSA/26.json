e_break"},{"type":"verse","number":6,"content":[{"text":"Ma a ↄ pìpi tàaesai seela ũ,","poem":1},{"noteId":28},{"lineBreak":true},{"text":"málɛ lia n gbagbakĩizi, Dii,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kɛ́ mà e n sáaukpa lɛsia guu,","poem":1},{"lineBreak":true},{"text":"mí n yãbↄnsaɛↄ kpàwakɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii, má ye n kpɛ́ pↄ́ niↄ kuuzi,","poem":1},{"lineBreak":true},{"text":"gu pↄ́ n gawi ì pilau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ńsu ǹ ma naaa ń duunkɛnaↄo,","poem":1},{"lineBreak":true},{"text":"ńsu ǹ ma baa daaa ń gbɛ̃dɛnaↄo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Vãi làasoo mɛ́ ìↄ dↄaanɛ́,","poem":1},{"lineBreak":true},{"text":"an ↄ ìↄ pai ń gbagusaɛↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mapi sↄ̃ mi yãkɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"wɛ̃nadↄ̃mɛɛ ní ma suaba.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma zɛkĩi è gumaau,","poem":1},{"lineBreak":true},{"text":"má Dii sáaukpa balu guu.","poem":1}]}],"footnotes":[{"noteId":28,"caller":"+","text":"26.6 Iko 21.6-7, Mat 27.24","reference":{"chapter":26,"verse":6}}]},"thisChapterLink":"/api/bqc_sim/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}