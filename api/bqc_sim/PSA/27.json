{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":27,"content":[{"type":"heading","content":["Dii mɛ́ ma gupua ũ"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Dii mɛ́ ma gupua ũ, ma Suabana ũ,","poem":1},{"lineBreak":true},{"text":"dé má vĩakɛɛ̀i?","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ ma ulɛkĩi ũ,","poem":1},{"lineBreak":true},{"text":"dé vĩa mɛ́ a ma kṹi?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃vãiↄ sìmazi ma taitaia yã́i,","poem":1},{"lineBreak":true},{"text":"ge tó ma ibɛɛↄ ń ma wɛ̀lɛↄ ã̀naa,","poem":1},{"lineBreak":true},{"text":"aa gɛ̃mbↄlɛ aa lɛ́lɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Baa tó zĩgↄ̃ↄ koezↄ̃̀mazi,","poem":1},{"lineBreak":true},{"text":"ma sↄ̃ a vĩo.","poem":1},{"lineBreak":true},{"text":"Baa tó gbɛ̃́ↄ fɛ̀lɛa ń zĩo,","poem":1},{"lineBreak":true},{"text":"ma sↄ̃ aↄ dilɛaɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yã́ mɛ̀ndo málɛ a wabikɛ Diiwa,","poem":1},{"lineBreak":true},{"text":"yã́pi málɛ wɛɛlɛ maamaa.","poem":1},{"lineBreak":true},{"text":"Má ye màↄ ku Dii ua e ma gↄↄ lɛ́waɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ màↄ aà aɛya aà kpɛ́u we,","poem":1},{"lineBreak":true},{"text":"mí wɛ́pɛ aà kɛfɛnkɛwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A ma ulɛ a kpɛ́u taasikɛgↄↄ,","poem":1},{"lineBreak":true},{"text":"a ma gwa a zwã̀akpɛu,","poem":1},{"lineBreak":true},{"text":"i ma zɛ gbɛ musu aafia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma mi a fu ma ibɛɛ pↄ́ liaamaziↄla,","poem":1},{"lineBreak":true},{"text":"mí sa'o Dii ua ń gulakɛao,","poem":1},{"lineBreak":true},{"text":"mí lɛsi mà aà táasilɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tó ma lɛzùnzi Dii, wea.","poem":1},{"lineBreak":true},{"text":"Ma wɛ̃nagwa ní ma yãma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma nↄ̀sɛ lɛ́ lɛdaa mà n aɛya,","poem":1},{"lineBreak":true},{"text":"Dii, málɛ n aɛya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ńsu mikpɛdↄ mapi n zↄ̀blenaɛo,","poem":1},{"lineBreak":true},{"text":"ńsu bↄ ma kpɛ ń pↄfɛ̃oo.","poem":1},{"lineBreak":true},{"text":"Ma Dↄnlɛden n ũ, ńsu ma vũaao,","poem":1},{"lineBreak":true},{"text":"Lua ma Suabana, ńsu ma to weo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó ma de ń ma dao pãkpàmazi,","poem":1},{"lineBreak":true},{"text":"Dii a ↄliamazi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii, ma da n zɛ́wa,","poem":1},{"lineBreak":true},{"text":"dↄaamɛɛ zɛ́ súsu guu ma kpàkpanaↄ yã́i.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ńsu to ma ibɛɛↄ ń pↄeã kɛao,","poem":1},{"lineBreak":true},{"text":"asa seelade ɛgɛnaↄ lɛ́ yãdↄa,","poem":1},{"lineBreak":true},{"text":"mɛ́ gbɛ̃́ pãsĩↄ lɛ́ pↄbↄ ń níu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Má yã́ɛ bee náai vĩ kɛ́ má e:","poem":1},{"lineBreak":true},{"text":"Dii a maakɛmɛɛ dṹniaɛ bee guu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wɛdↄ Diizi.","poem":1},{"lineBreak":true},{"text":"Zɛ gbãa, ní sↄ̃dilɛ.","poem":1},{"lineBreak":true},{"text":"Wɛdↄ Diizi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}