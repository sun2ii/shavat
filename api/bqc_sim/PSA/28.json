{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":28,"content":[{"type":"heading","content":["Wabikɛa ń sáaukpaao"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Dii ma gbɛsi, málɛ lɛzunzi,","poem":1},{"lineBreak":true},{"text":"ńsu ǹ n swã́ kákamɛɛo.","poem":1},{"lineBreak":true},{"text":"Tó ń nílɛ,","poem":1},{"lineBreak":true},{"text":"má gↄ̃ lán gbɛ̃́ pↄ́ aa sì bɛdauↄwaɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Málɛ wɛ̃na wii lɛma, swã́sɛmazi,","poem":1},{"lineBreak":true},{"text":"málɛ ma ↄ sɛ n kúkĩi oi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ńsu ma gálɛ ń gbɛ̃́ bɛ̃̀ɛↄ ge vãikɛnaↄ sãnuo.","poem":1},{"lineBreak":true},{"text":"Aaì yãna o ń gbɛ̃́deeɛ,","poem":1},{"lineBreak":true},{"text":"ãma an zaa gbɛ̃́ↄu kɛ̀ zài.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛnɛ́ ń yãkɛa ń ń vãikɛaowa,","poem":1},{"lineBreak":true},{"text":"fĩabonɛ́ ń dàawa,","poem":1},{"lineBreak":true},{"text":"a gbɛ i wí ń musu.","poem":1},{"noteId":29}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aali Dii yãkɛa ń aà zĩkɛao yãdao,","poem":1},{"lineBreak":true},{"text":"a ń fuangba, a ń zɛdↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma Dii sáaukpà,","poem":1},{"lineBreak":true},{"text":"asa à swãsɛ̀ ma wɛ̃na wiilɛai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii mɛ́ ma gbãa ń ma sɛ̀ngbaoo ũ,","poem":1},{"lineBreak":true},{"text":"má aà náai vĩ ma sↄ̃u.","poem":1},{"lineBreak":true},{"text":"Ì dↄmalɛ, ma nↄ̀sɛ ì yáalↄ,","poem":1},{"lineBreak":true},{"text":"mi aà sáaukpa ń lɛsiao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii mɛ́ a gbɛ̃́ↄ gbãa ũ,","poem":1},{"lineBreak":true},{"text":"a dɛ ulɛkĩi ũ kía pↄ́ a kpàɛ,","poem":1},{"lineBreak":true},{"text":"ì aà suaba.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ n gbɛ̃́ↄ suaba, ní báaadańgu.","poem":1},{"lineBreak":true},{"text":"Ǹ ń dã́dã, níↄ ń kũa gↄↄpii.","poem":1}]}],"footnotes":[{"noteId":29,"caller":"+","text":"28.4 2Tim 4.14","reference":{"chapter":28,"verse":4}}]},"thisChapterLink":"/api/bqc_sim/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}