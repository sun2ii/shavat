:1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ì to Libã gbɛ̀sĩsĩↄ vĩvĩ lán zunɛwa,","poem":1},{"lineBreak":true},{"text":"ì to Ɛɛmↄ gbɛ vĩvĩ lán gáaenawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dii lↄↄ ì bↄ ń loupilɛaↄ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii lↄↄ ì gbáa dee,","poem":1},{"lineBreak":true},{"text":"Dii ì Kadɛsi guwaiwai dee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii lↄↄ ì líↄ zĩa,","poem":1},{"lineBreak":true},{"text":"ì líkpɛ puakũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kú aà uaↄ i oɛ̀, Gawideɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii ku í pↄ́ daa dṹniaa musu,","poem":1},{"lineBreak":true},{"text":"Dii ìↄ zↄ̃lɛa Kía ũ gↄↄpii.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii ì a gbɛ̃́ↄ gba gbãa,","poem":1},{"lineBreak":true},{"text":"Dii ì báaadańgu aaↄ aafia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}