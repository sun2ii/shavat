{"lineBreak":true},{"text":"Mi wúlɛ i'o ń a nao,","poem":1},{"lineBreak":true},{"text":"mi vu aafia, asa Dii mɛ́ ma ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃ↄn ↄ̀aasↄsↄo lɛɛ kwi lɛ́ ma wɛ,","poem":1},{"lineBreak":true},{"text":"kási mili vĩakɛnɛ́o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Fɛlɛ Dii,","poem":1},{"lineBreak":true},{"text":"ní ma ibɛɛↄ lɛgbeomble,","poem":1},{"lineBreak":true},{"text":"ma suaba ma Lua,","poem":1},{"lineBreak":true},{"text":"ní gbɛ̃vãipiↄ swaa ɛ́'ɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii mɛ́ ì gbɛ̃́ suaba.","poem":1},{"lineBreak":true},{"text":"Báaada n gbɛ̃́ↄgu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}