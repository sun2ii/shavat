{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":30,"content":[{"type":"heading","content":["Dii sáaukpaa"]},{"type":"verse","number":1,"content":[{"text":"Lɛ pↄ́ Davidi dà Lua kpɛ́ sakɛ̃pↄ ũ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Má n kã́fĩ Dii, asa n ma sɛ lɛsĩ,","poem":1},{"lineBreak":true},{"text":"ni to ma ibɛɛↄ tidↄ̀malao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dii ma Lua, ma wiilɛ̀ma,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n ma gbãgbã.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii, n ma si miawa,","poem":1},{"lineBreak":true},{"text":"ni to ma si bɛdauo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii náaikɛnaↄ, à aà táasilɛ,","poem":1},{"lineBreak":true},{"text":"à aà tↄbↄ, asa a kua adoaɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Asa aa pↄfɛ̃a lí la ń lao leo,","poem":1},{"lineBreak":true},{"text":"aà ɛ̀fãai mɛ́ ìↄ ku e gbɛ̃́ wɛ̃ni lɛ́u.","poem":1},{"lineBreak":true},{"text":"Ɔ́ↄlↄa ìↄ ku gwã́,","poem":1},{"lineBreak":true},{"text":"ↄ̃ gu ì dↄ ń pↄnao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kɛ́ má kú nama guu, ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Má kpagua bauo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii, kɛ́ n ɛ̀fãaikɛ̀mɛɛ,","poem":1},{"lineBreak":true},{"text":"n ma zɛ gíũgiũ lán gbɛsiwa.","poem":1},{"lineBreak":true},{"text":"Kɛ́ n mikpɛdↄ̀mɛɛ,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ bíli guu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ḿmɛ ma lɛzùnzi Dii,","poem":1},{"lineBreak":true},{"text":"ma kulɛkɛ̀ ma diiɛ ma mɛ̀:","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bↄ́ ài ma gaa ge ma sia bɛdau vĩi?","poem":1},{"lineBreak":true},{"text":"Ma papa a n tↄbↄe?","poem":1},{"lineBreak":true},{"text":"A n náai kpàwakɛe?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma yãma Dii, wɛ̃nadↄ̃mɛɛ.","poem":1},{"lineBreak":true},{"text":"Dii, ǹyↄ̃ dɛ ma Dↄnlɛde ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"N ma ↄ́ↄlↄa lìlɛ ↄ̃wãa ũ,","poem":1},{"lineBreak":true},{"text":"n ma zwã̀nkasaↄ wòloa,","poem":1},{"lineBreak":true},{"text":"n pↄna dàmɛɛ pↄkasa ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Máↄ nílɛo, máↄ n táasilɛɛ,","poem":1},{"lineBreak":true},{"text":"Dii ma Lua, máↄ n sáaukpa láasaiɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":13}