{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":31,"content":[{"type":"heading","content":["Zĩakpaa Diiwa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dii, ḿmɛ ma nanzi,","poem":1},{"lineBreak":true},{"text":"ńsuli tó wí ma kũo.","poem":1},{"lineBreak":true},{"text":"Lá ni yãkɛ a zɛ́wa, ma misi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Swãdↄmazi, ní ma bↄ kpakpa.","poem":1},{"lineBreak":true},{"text":"Gↄ̃mɛɛ ma misigbɛ ũ,","poem":1},{"lineBreak":true},{"text":"zɛgikĩi pↄ́ a ma suaba ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma gbɛsi ń ma ulɛkĩion n ũ,","poem":1},{"lineBreak":true},{"text":"dↄaamɛɛ, ní gɛmanↄ n tↄ́ yã́i.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ńsu to mà zu ba pↄ́ wa kpàmɛɛuo,","poem":1},{"lineBreak":true},{"text":"asa ma Mìsinan n ũ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma a wɛ̃ni nànɛ n ↄzĩ,","poem":1},{"noteId":30},{"lineBreak":true},{"text":"ma bↄ, Dii Lua Sĩande.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Má za tã́a gbàgbanaↄgu,","poem":1},{"lineBreak":true},{"text":"Dii má aà náai vĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Má yáalↄ má pↄnakɛ ń n gbɛ̃kɛo,","poem":1},{"lineBreak":true},{"text":"asa n ma gwa ma taasikɛa guu,","poem":1},{"lineBreak":true},{"text":"ń dↄ̃̀manↄ ma yooyea guu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ni ma na ma ibɛɛↄnɛ ń ↄzĩo,","poem":1},{"lineBreak":true},{"text":"n ma gba dɛ̀ɛpookĩi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ma wɛ̃nagwa Dii, asa má yooyeaɛ,","poem":1},{"lineBreak":true},{"text":"pↄsia tò ma wɛ́ gↄ̃̀ sùii,","poem":1},{"lineBreak":true},{"text":"ma pↄ yà, ma nↄ̀sɛ ↄ̃̀ↄkpà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pↄsia lɛ́ ma wɛ̃ni mↄsↄ,","poem":1},{"lineBreak":true},{"text":"aaukɛa lɛ́ ma wɛ̃ lao,","poem":1},{"lineBreak":true},{"text":"làasoo tò má yɛ̃̀ɛɛ vĩ lↄo,","poem":1},{"lineBreak":true},{"text":"ma wáↄ kɛ̀ múumuunnↄ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃́deeↄ ì sakamagu ma ibɛɛↄ yã́i,","poem":1},{"lineBreak":true},{"text":"ma yã́ ì ma gbɛ̃́ↄ vĩakũ maamaaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ lɛ́ kpaaũmanↄ gãaɛↄ ì pãalɛmɛɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ma yã́ i dↄ gbɛ̃egu lↄo","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ lán gɛwa,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃nɛ́ lán oogboowa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Miↄ ma gbɛ̃́ dasiↄ lɛ́ ma pe,","poem":1},{"lineBreak":true},{"text":"vĩa pↄ́ↄ liaamazi.","poem":1},{"lineBreak":true},{"text":"Aaì kãaa aa lɛkpaaĩmazi,","poem":1},{"lineBreak":true},{"text":"aaì lɛdoũkɛ ma wɛ̃nibↄa yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mapi sↄ̃, ḿmɛ má n náai vĩ, Dii,","poem":1},{"lineBreak":true},{"text":"mi mɛ ma Luan n ũ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma wɛ̃ni ìↄ ku n ↄzĩ gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"ma si ma ibɛɛ pↄ́ lɛ́ ma wɛↄwa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mapi n zↄ̀blenawa wɛgwa,","poem":1},{"lineBreak":true},{"text":"ma suaba n gbɛ̃kɛ yã́i.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dii, ńsu to wí ma kũo,","poem":1},{"lineBreak":true},{"text":"asa ma lɛzùnzi.","poem":1},{"lineBreak":true},{"text":"To wí vãikɛnaↄ kṹ,","poem":1},{"lineBreak":true},{"text":"to an lɛ́ àↄ kpaaũa tɛ̃́ɛnau,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"to an lɛ́na ɛɛtonaↄ naalɛ.","poem":1},{"lineBreak":true},{"text":"Aaì dↄ́ɛ ń gbɛ̃maaↄ,","poem":1},{"lineBreak":true},{"text":"aaì sakańgu ń ĩ́andãao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Àizɛɛ pↄ́ ń kã̀aa n vĩakɛnaↄnɛ zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"ni ɛ̀fãaikɛ gbɛ̃́ pↄ́ nanziↄnɛ gbɛ̃́pii wáa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃́ↄ lɛkpàaĩńzi,","poem":1},{"lineBreak":true},{"text":"ni ↄkuńla,","poem":1},{"lineBreak":true},{"text":"tó wàlɛ lɛkpaakɛńnↄ,","poem":1},{"lineBreak":true},{"text":"ni ń ulɛ n guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ma Dii sáaukpà,","poem":1},{"lineBreak":true},{"text":"asa a yemazi zↄ̃ↄ","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛ pↄ́ wà koezↄ̃̀i guu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gili gɛ̃̀magu we,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma mɛ̀: N ma vũaaɛ.","poem":1},{"lineBreak":true},{"text":"Kɛ́ ma suabalɛ zùnzi,","poem":1},{"lineBreak":true},{"text":"n ma wɛ̃na wiilɛa mà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dii yãmanaↄ, àↄ yeaàzi.","poem":1},{"lineBreak":true},{"text":"Dii ì a náaikɛnaↄ dↄ̃́a,","poem":1},{"lineBreak":true},{"text":"ì fĩabo zĩakãfĩnaↄnɛ a lɛ́ gbɛu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Á gbɛ̃́ pↄ́ á wɛ́ dↄ Diiziↄ,","poem":1},{"lineBreak":true},{"text":"àↄ gbãa à á sↄ̃dilɛ.","poem":1}]}],"footnotes":[{"noteId":30,"caller":"+","text":"31.6 Luk 23.46","reference":{"chapter":31,"verse":6}}]},"thisChapterLink":"/api/bqc_sim/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":25}