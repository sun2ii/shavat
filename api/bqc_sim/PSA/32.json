{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":32,"content":[{"type":"heading","content":["Duuna'oa Luaɛ"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Báaaden gbɛ̃́ pↄ́ Dii aà tàae wòlowà","poem":1},{"lineBreak":true},{"text":"à aà duuna kɛ̃̀wà ũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ Dii lí aà tàae yãda lↄo","poem":1},{"lineBreak":true},{"text":"mɛ́ mↄafili kú aà nↄ̀sɛ guuo ũ.","poem":1},{"noteId":31}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kɛ́ má nílɛ ń ma duunao, ma ibàba,","poem":1},{"lineBreak":true},{"text":"ma wii ìↄ dↄ za kↄↄ e oosi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N ↄtↄ̃ↄlɛaa fãanɛ ń gwãasĩnao,","poem":1},{"lineBreak":true},{"text":"ma yɛ̃̀ɛɛ làa lá guantɛ̃na ĩatɛ̃ ma gbɛ̃wa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɔ̃ ma wenɛ ma duunai,","poem":1},{"lineBreak":true},{"text":"mi a yãvãi ulɛnɛ lↄo.","poem":1},{"lineBreak":true},{"text":"Ma mɛ̀ má a tàaeↄ onɛ Dii,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n ma duuna kɛ̃̀a.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N náaikɛna wabikɛma a gↄↄwa,","poem":1},{"lineBreak":true},{"text":"tó yã'ĩa lɛ́ mↄ́, a aà le lↄo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma ulɛkĩin n ũ,","poem":1},{"lineBreak":true},{"text":"ni ma bↄ wɛ́tɛ̃a guu,","poem":1},{"lineBreak":true},{"text":"ni liamazi ǹ ma suaba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii òmɛɛ à mɛ̀: Má yãdanɛ,","poem":1},{"lineBreak":true},{"text":"mí n da zɛ́ pↄ́ dɛ ǹ sɛwa,","poem":1},{"lineBreak":true},{"text":"má lɛdama, míↄ wɛ́tɛnzi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ńsu ǹyↄ̃ ku làasoosai","poem":1},{"lineBreak":true},{"text":"lán sↄ̃́ ge sↄ̃baonawao.","poem":1},{"lineBreak":true},{"text":"Tó ni ã̀asĩna kánɛ́ ge kpío,","poem":1},{"lineBreak":true},{"text":"aali n dↄ̀ↄ sɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yã'ↄ̃ma ì li gbɛ̃vãiↄla,","poem":1},{"lineBreak":true},{"text":"Dii gbɛ̃kɛ ì li aà náaikɛnaↄla.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ, à pↄnakɛ ń Diio,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuadeↄ, à gulakɛ, í yáalↄ.","poem":1}]}],"footnotes":[{"noteId":31,"caller":"+","text":"32.2 Lom 4.7-8","reference":{"chapter":32,"verse":2}}]},"thisChapterLink":"/api/bqc_sim/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}