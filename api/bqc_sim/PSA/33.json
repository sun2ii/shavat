{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":33,"content":[{"type":"heading","content":["Lua táasilɛa"]},{"type":"verse","number":1,"content":[{"text":"À gulakɛ Diiɛ gbɛ̃maaↄ,","poem":1},{"lineBreak":true},{"text":"à kũ̀ nↄ̀sɛpuadeↄ aà táasilɛɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À Dii tↄbↄ ń domao,","poem":1},{"lineBreak":true},{"text":"à lɛsiɛ̀ ń mↄↄnao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À lɛ̀ dafu siɛ̀,","poem":1},{"lineBreak":true},{"text":"à pↄ́ lɛ́ ń dↄ̃ao ń pↄna wiio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asa yã́ pↄ́ Dii ò sĩana vĩ,","poem":1},{"lineBreak":true},{"text":"a náai vĩ a yãkɛa píi guu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A ye yãmaai ń yã́zɛdeo,","poem":1},{"lineBreak":true},{"text":"Dii gbɛ̃kɛ dṹnia pà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii yã'oa mɛ́ musu kɛ̀,","poem":1},{"lineBreak":true},{"text":"aà lɛ́'ĩana mɛ́ musupↄↄ pɛ̀pɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À ikàlɛ gudoũ, à gↄ̃̀ ísia ũ,","poem":1},{"lineBreak":true},{"text":"à íↄ kã̀aa, à gↄ̃̀ ísi ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dṹnia gbɛ̃́pii, à vĩakɛ Diiɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ bɛ̃́ɛↄ píi, à misiilɛɛ̀.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Asa à yã'ò ↄ̃ dṹnia kɛ̀,","poem":1},{"lineBreak":true},{"text":"à yãdìlɛ ↄ̃ à gↄ̃̀ kálɛa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dii ì lɛ́ pↄ́ buiↄ kpàaĩ gboo,","poem":1},{"lineBreak":true},{"text":"ì kpa bùsudeↄnɛ ń yã́ pↄ́ aalɛ yáo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ Dii zɛ̀ò ìↄ zɛa gíũgiũ,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ aà pↄ gbà ìↄ ku gↄↄpii.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Báaaden bui pↄ́ Dii dɛ ń Lua ũ","poem":1},{"lineBreak":true},{"text":"à ń sɛ́ a pↄ́ ũↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Za musu Dii ì gugwa zĩ́lɛ,","poem":1},{"lineBreak":true},{"text":"ì gbɛ̃nazĩnaↄ e píi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Za aà kúkĩi ì wɛpã","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kú dṹnia guuↄla píi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aàpi mɛ́ sↄ̃ dↄ̀ baadeɛ,","poem":1},{"lineBreak":true},{"text":"ì wɛsi ń yãkɛaↄlɛ píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kía lí zĩble a zĩgↄ̃ dasikɛ yã́io,","poem":1},{"lineBreak":true},{"text":"zĩ̀kanae lí bↄ a gↄ̃sakɛ yã́io.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sↄ̃́ náaikɛa à ń bↄ ɛɛ vĩ,","poem":1},{"lineBreak":true},{"text":"baa ń a gbãakɛo a fↄ̃ gbɛ̃́ suabao.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dii wɛ́ pɛa a vĩakɛnaↄwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ an wɛ́ dↄ aà gbɛ̃kɛziↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A ń bↄ ga lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"a ń gwa aafia nↄana gↄↄ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wá wɛ́ ìↄ dↄ Diizi,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ wá Dↄnlɛde ũ, wá sɛ̀ngbao ũ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Asa Dii ↄ̃ wá pↄ ì kɛwà na,","poem":1},{"lineBreak":true},{"text":"wá aà tↄ́ pↄ́ a kua adoa náai vĩ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dii, n gbɛ̃kɛ àↄ kúwanↄ","poem":1},{"lineBreak":true},{"text":"lá wá wɛ́ dↄnziwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}