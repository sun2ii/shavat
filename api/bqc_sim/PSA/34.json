{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":34,"content":[{"type":"heading","content":["Dii maakɛa"]},{"type":"verse","number":1,"content":[{"text":"Lɛ pↄ́ Davidi dà gↄↄ pↄ́ à azĩa dìlɛ ĩ́ande ũ Abimɛlɛki aɛ, ↄ̃ Abimɛlɛki aà yà, à tà.","descriptive":true},{"noteId":32}]},{"type":"verse","number":2,"content":[{"text":"Máↄ Dii sáaukpa gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"míↄ aà táasilɛ lá gu lɛ́ dↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Máↄ ĩ́anadã Dii yã́ musu,","poem":1},{"lineBreak":true},{"text":"taasideↄ i ma, aai pↄnakɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À zↄ̃ↄkɛ dↄ̃ Diiɛmanↄ,","poem":1},{"lineBreak":true},{"text":"wí aà tↄbↄ sãnu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma Dii kĩ́i wɛ̀ɛlɛ ↄ̃ a wèa,","poem":1},{"lineBreak":true},{"text":"à ma bↄ ma sↄ̃̀deedee guu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aà wɛ́ dↄaàzi a yáalↄ,","poem":1},{"lineBreak":true},{"text":"aà gɛɛ a gↄ̃ kpa aà wɛ́i bauo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma taasidekɛ guu ma lɛzù Diizi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ma yãmà à ma bↄ ma yooyea píi guu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii Malaika ìↄ ku a vĩakɛnaↄ saɛ,","poem":1},{"lineBreak":true},{"text":"ì ń bↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"À iɛ àↄ dↄ̃ lá Dii maa,","poem":1},{"noteId":33},{"lineBreak":true},{"text":"báaaden gbɛ̃́ pↄ́ nàaàzi ũ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii gbɛ̃́ↄ, à vĩakɛɛ̀,","poem":1},{"lineBreak":true},{"text":"pↄe lí kɛ̃́sã aà vĩakɛnaↄwao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nↄana ì nↄ̀ↄmusu dɛ, pↄblea ì kɛ̃́sãwà,","poem":1},{"lineBreak":true},{"text":"ãma pↄmaae lí kɛ̃́sã Dii kĩ́i wɛ̀ɛlɛnaↄwao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gbɛ̃́ↄ, à mↄ ma yãma,","poem":1},{"lineBreak":true},{"text":"mí vĩakɛa Diiɛ dadaɛ́.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ye a wɛ̃ni àↄ maa,","poem":1},{"lineBreak":true},{"text":"mɛ́ a ye a kua àↄ na,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"aà a lɛ́ fↄ̃́ ń yãvãi oao,","poem":1},{"lineBreak":true},{"text":"asu to ɛɛ bↄ a lɛ́uo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aà mikɛ̃ vãiwa, i maakɛ,","poem":1},{"lineBreak":true},{"text":"aà aafia zɛ́ wɛɛlɛ, iↄ tɛi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dii ìↄ wɛ́tɛ gbɛ̃maaↄzi,","poem":1},{"lineBreak":true},{"text":"ì swã́kpa ń wiilɛai.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dii ì mikpɛdↄ vãikɛnaↄnɛ,","poem":1},{"noteId":34},{"lineBreak":true},{"text":"kɛ́ an yã́ su dↄ gbɛ̃egu lↄo yã́i.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó wà lɛzù Diizi, ì ma,","poem":1},{"lineBreak":true},{"text":"ì ń bↄ ń yooyea píi guu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dii kãi ń gbɛ̃́ pↄ́ an pↄ yàↄ,","poem":1},{"lineBreak":true},{"text":"ì dↄ gbɛ̃́ pↄ́ an kã́ gàↄlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Taasi ìↄ gbɛ̃maa le mↄ̀ↄmↄↄ,","poem":1},{"lineBreak":true},{"text":"ãma Dii ì aà bↄ a guu píi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ì aa wáↄ dↄ̃́aɛ̀ píi,","poem":1},{"lineBreak":true},{"text":"ìli ɛ́o, baa mɛ̀ndo.","poem":1},{"noteId":35}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kìsia a gbɛ̃vãiↄ dɛdɛ,","poem":1},{"lineBreak":true},{"text":"yã́ a zↄ̃lɛ gbɛ̃maa ibɛɛↄwa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dii ì a zↄ̀blenaↄ suaba,","poem":1},{"lineBreak":true},{"text":"yã́ a zↄ̃lɛ gbɛ̃́ pↄ́ nàaàziwao.","poem":1}]}],"footnotes":[{"noteId":32,"caller":"+","text":"34.1 1Sam 21.13-15","reference":{"chapter":34,"verse":1}},{"noteId":33,"caller":"+","text":"34.9 1Piɛ 2.3","reference":{"chapter":34,"verse":9}},{"noteId":34,"caller":"+","text":"34.17 1Piɛ 3.10-12","reference":{"chapter":34,"verse":17}},{"noteId":35,"caller":"+","text":"34.21 Zãa 19.36","reference":{"chapter":34,"verse":21}}]},"thisChapterLink":"/api/bqc_sim/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":23}