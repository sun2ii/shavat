{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":35,"content":[{"type":"heading","content":["Gbɛ̃maa wiilɛa Diiwa"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Dii, íbɛlɛsɛ ń ma ibɛɛↄ,","poem":1},{"lineBreak":true},{"text":"zĩka ń gbɛ̃́ pↄ́ aalɛ kamanↄↄ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ n sɛ̀ngbao ń n gↄ̃kɛbↄↄ sɛ́lɛ,","poem":1},{"lineBreak":true},{"text":"ní fɛlɛ dↄmalɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ǹ n sↄ̃na ń n fɛ̃ndao sɛ dↄ,","poem":1},{"lineBreak":true},{"text":"gɛ da gbɛ̃́ pↄ́ pɛ̀lɛmaziↄlɛ.","poem":1},{"lineBreak":true},{"text":"Omɛɛ ma Suabanan n ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"To gbɛ̃́ pↄ́ lɛ́ ma wɛↄ kpɛkpa,","poem":1},{"lineBreak":true},{"text":"wí i ń kṹ.","poem":1},{"lineBreak":true},{"text":"To gbɛ̃́ pↄ́ lɛ́ vãikpaaĩmanↄↄ fua,","poem":1},{"lineBreak":true},{"text":"mí ń kpɛ e.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aaↄ dɛ lán ése ṹa pↄ́ ĩ́ana sɛ̀lɛwa,","poem":1},{"lineBreak":true},{"text":"Dii Malaika i pɛ́lɛńzi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"An zɛ́ àↄ gusia vĩ ń zãanao,","poem":1},{"lineBreak":true},{"text":"Dii Malaika i ↄzↄ̃ńzi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Asa aa ɛyↄ̃̀mɛɛ pãɛ,","poem":1},{"lineBreak":true},{"text":"mi yãe kɛnɛ́o, ↄ̃ aa ba kpàmɛɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To músi ń le, i kɛnɛ́ zãma ũ.","poem":1},{"lineBreak":true},{"text":"To ba pↄ́ aa kpàmɛɛ ń kṹ,","poem":1},{"lineBreak":true},{"text":"aai lɛ́lɛ ɛ pↄ́ aa yↄ̃̀pi guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ma pↄ i gbasa kɛ Diiwa na,","poem":1},{"lineBreak":true},{"text":"mí pↄnakɛ kɛ́ à ma suabà yã́i.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Má o ń nↄ̀sɛmɛndoo,","poem":1},{"lineBreak":true},{"text":"Dii, démɛ kànwai?","poem":1},{"lineBreak":true},{"text":"Ni taasideↄ si gbãamↄnɛdeↄwa,","poem":1},{"lineBreak":true},{"text":"ni wɛ̃nadeↄ bↄ ń wɛtãnaↄ ↄzĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Seelade ɛgɛnaↄ ì fɛlɛmanↄ,","poem":1},{"lineBreak":true},{"text":"aaì yã́ pↄ́ má a yã́ dↄ̃o lalaa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aaì maa fĩabomɛɛ ń vãio,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma gↄ̃ gbɛ̃ando ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó aalɛ gyãkɛ yãa sↄ̃,","poem":1},{"lineBreak":true},{"text":"mi zwã̀nkasa daɛ,","poem":1},{"lineBreak":true},{"text":"mi azĩa kɛ̃́sã ń lɛyeao,","poem":1},{"lineBreak":true},{"text":"mi wabikɛnɛ́ láasai,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"lá aa dɛ ma gbɛ̃na ge ma gbɛ̃́ ũwa.","poem":1},{"lineBreak":true},{"text":"Miↄ bɛ mipɛlɛa ń oosisio,","poem":1},{"lineBreak":true},{"text":"lá ma da málɛ wɛ̃nakɛɛ̀wa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ãma kɛ́ ma gɛ̃mbↄlɛ,","poem":1},{"lineBreak":true},{"text":"aa kã̀aamazi ń pↄnao,","poem":1},{"lineBreak":true},{"text":"aa ma zãmakɛ̀ aa ã̀naa,","poem":1},{"lineBreak":true},{"text":"aa ĩadàa láasai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa ma àlafiikɛ̀ pãsĩpãsĩ,","poem":1},{"lineBreak":true},{"text":"aa lɛ́sakã̀mazi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dii, ńyↄ̃ↄ ma gwa màa e bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Nↄ̀ↄmusupiↄ lɛ́ ma taitai,","poem":1},{"lineBreak":true},{"text":"ma símá màↄ ku.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Má n tↄbↄ balu guu,","poem":1},{"lineBreak":true},{"text":"má n táasilɛ dasi guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ńsu to ma ibɛɛↄ tidↄmalao,","poem":1},{"lineBreak":true},{"text":"ńsu to gbɛ̃́ pↄ́ zamagu pãↄ","poem":1},{"noteId":36},{"text":"ma gwa ń wɛdooo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yãna lí bↄ ń lɛ́uo,","poem":1},{"lineBreak":true},{"text":"aaì yãdↄ yãkelesaideↄwa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aaì lɛ́ ɛlɛa aa mɛ:","poem":1},{"lineBreak":true},{"text":"Ɛ̃hɛ̃, ɛ̃hɛ̃, wá wɛ́ mɛ́ è.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dii, n wɛsìɛ, ńsu ǹyↄ̃ nílɛao,","poem":1},{"lineBreak":true},{"text":"ma Dii, ńsu ǹyↄ̃ zã̀manↄo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ma Lua, fɛlɛ zɛmanↄ,","poem":1},{"lineBreak":true},{"text":"ma Dii, tó yã́ bↄmanↄ na.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ni yãkɛ a zɛ́wa Dii, yãnakpaa,","poem":1},{"lineBreak":true},{"text":"ma Lua, ńsu to aa tidↄmalao.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ńsu to aa o ń sↄ̃u wa ma nɛo,","poem":1},{"lineBreak":true},{"text":"ńsu to aa o wa ma mↄ bɛ̃̀ɛo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Lá aalɛ pↄnakɛ ma yã'ea musu,","poem":1},{"lineBreak":true},{"text":"to wí ń kṹ, mí ń kpɛ e.","poem":1},{"lineBreak":true},{"text":"Lá aalɛ zↄ̃ↄkɛ blea,","poem":1},{"lineBreak":true},{"text":"widamá, ní ń kpɛbↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"To gbɛ̃́ pↄ́ ma bↄa maa ì kɛnɛ́ naↄ pↄnakɛ, aai wiidↄi.","poem":1},{"lineBreak":true},{"text":"To gbɛ̃́ pↄ́ ma bↄa aafia ì káńguↄ o gↄↄpii, Dii mɛ́ zↄ̃ↄ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mapi sↄ̃ má n náaiyã'ò,","poem":1},{"lineBreak":true},{"text":"míↄ n táasilɛ gↄↄpii.","poem":1}]}],"footnotes":[{"noteId":36,"caller":"+","text":"35.19 Zãa 15.25","reference":{"chapter":35,"verse":19}}]},"thisChapterLink":"/api/bqc_sim/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}