gbɛ̃kɛ zↄ̃ↄ kà saanaↄwa,","poem":1},{"lineBreak":true},{"text":"ń náai vĩ maamaa à zↄ̃̀ Luawa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N maakɛa zↄ̃ↄ lán gbɛ̀sĩsĩↄwa,","poem":1},{"lineBreak":true},{"text":"n yã́gↄ̃gↄ̃a lɛ́ vĩo lán ísia ɛwa.","poem":1},{"lineBreak":true},{"text":"Dii, ni gbɛ̃nazĩnaↄ ń nↄ̀bↄↄ bↄ píi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lua, n gbɛ̃kɛ bɛɛɛ vĩ fá,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩnaↄ ì sↄlↄ ń kúlukulunau.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aaì n ua blɛ níside ble aa kã́,","poem":1},{"lineBreak":true},{"text":"ni n swa'i pↄnade kpámá aa mi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Asa ḿmɛ ń wɛ̃ni mi ũ,","poem":1},{"lineBreak":true},{"text":"kua ń gupuau mɛ́ wá wɛ́ kɛ̃̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ǹyↄ̃ gbɛ̃kɛkɛ gbɛ̃́ pↄ́ aa n dↄ̃ↄnɛ ǹyↄ̃ gɛ́,","poem":1},{"lineBreak":true},{"text":"gi ǹyↄ̃ nↄ̀sɛpuadeↄ suaba.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ńsu to zĩakãfĩnaↄ ↄ̃zↄ̃ao,","poem":1},{"lineBreak":true},{"text":"ńsu to vãikɛnaↄ ↄkɛmɛɛ yàayaao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gwa, mↄafilidepiↄ lɛ̀lɛ,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃̀ kálɛa sↄlↄlↄ, aa fↄ̃ fɛlɛo.","poem":1}]}],"footnotes":[{"noteId":37,"caller":"+","text":"36.2 Lom 3.18","reference":{"chapter":36,"verse":2}}]},"thisChapterLink":"/api/bqc_sim/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":13}