{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":37,"content":[{"type":"heading","content":["Gbɛ̃maaↄ ń gbɛ̃vãiↄ zia"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Ńsu to gbɛ̃vãiↄ yã́ n kũ gbãao,","poem":1},{"lineBreak":true},{"text":"ńsu vãikɛnaↄ gwea nidɛo,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"asa aa giigaga gↄ̃̀ↄ lán sɛ̃waɛ,","poem":1},{"lineBreak":true},{"text":"an maa a láa lán sɛ̃la ísiwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dii náaikɛ, níↄ yãmaakɛ.","poem":1},{"lineBreak":true},{"text":"Zɛ n bùsuu, níↄ inamiu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"To n pↄ kɛ Diiwa na,","poem":1},{"lineBreak":true},{"text":"i n gba pↄ́ pↄ́ n nↄ̀sɛ yei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Zɛ ń Diio,","poem":1},{"lineBreak":true},{"text":"ǹ aà náaikɛ, i yã́ɛ beeↄ kɛnɛ:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A tó yã́ bↄnnↄ na lán gudↄawa,","poem":1},{"lineBreak":true},{"text":"a to ǹ bↄ maa lán fãanɛwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lɛkpaaũ Dii aɛ, ní sↄ̃́aaàzi,","poem":1},{"lineBreak":true},{"text":"ńsu to saasɛna yã́ n kũ gbãa","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ aà yã́ lɛ́ bↄlɛiɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Pↄkũma tó, mikɛ̃ pↄpaawa.","poem":1},{"lineBreak":true},{"text":"Ńsu to yã́ lí n kũ gbãao,","poem":1},{"lineBreak":true},{"text":"ì mↄ́ ń vãikɛaoɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Asa gbɛ̃vãiↄ midɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ an wɛ́ dↄ Diiziↄ mɛ́ aa gↄ̃ bùsu vĩ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À gↄ̃̀ yↄↄ kɛ́ gbɛ̃vãiↄ aaↄ ku lↄo,","poem":1},{"lineBreak":true},{"text":"baa tó n ń wɛɛlɛ, ńyↄ̃ ń eo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zĩabusanaↄ mɛ́ aaↄ bùsu vĩ,","poem":1},{"noteId":38},{"lineBreak":true},{"text":"aaiↄ pↄnakɛò ń aafia zↄ̃ↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gbɛ̃vãi ì vãikpaaĩ ń gbɛ̃maao,","poem":1},{"lineBreak":true},{"text":"ì lɛ́sakãaàzi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ãma Dii ìↄ aà yáalↄ,","poem":1},{"lineBreak":true},{"text":"asa a dↄ̃ aà gↄↄ a pa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Gbɛ̃vãiↄ ì fɛ̃nda wo,","poem":1},{"lineBreak":true},{"text":"aaì ń kakpa sáa,","poem":1},{"lineBreak":true},{"text":"kɛ́ aa e taasideↄ ń wɛ̃nadeↄ kwɛò,","poem":1},{"lineBreak":true},{"text":"aai gbɛ̃́ pↄ́ an yãkɛa maaↄ dɛdɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"An zĩa fɛ̃nda a ń zↄ̃ ń sↄ̃u,","poem":1},{"lineBreak":true},{"text":"wa ń sáↄ ɛ́'ɛnɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yↄↄna pↄ́ gbɛ̃maa vĩ","poem":1},{"lineBreak":true},{"text":"dɛ gbɛ̃vãi dasiↄ àizɛɛa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Asa gbɛ̃vãiↄ gbãa a midɛ,","poem":1},{"lineBreak":true},{"text":"ãma Dii ìↄ gbɛ̃maaↄ kũa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dii tàaesaideↄ yã́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"an kpaalɛ ìↄ dɛ ń pↄ́ ũ gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wí a ń kṹ yãpãsĩgↄↄo,","poem":1},{"lineBreak":true},{"text":"baa tó nↄana kà, aaↄ kãaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ãma gaga a gɛ̃ gbɛ̃vãiↄgu,","poem":1},{"lineBreak":true},{"text":"Dii ibɛɛↄ láa lá sɛ̃̀bↄlↄ ì láawa,","poem":1},{"lineBreak":true},{"text":"aa gɛ̃lɛ lán súɛlɛwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Gbɛ̃vãi ì pↄ́ sɛ̃amá,","poem":1},{"lineBreak":true},{"text":"ìli a fĩaboo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maa sↄ̃ ì gbada sↄũsↄũ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ Dii báaadàńguↄ mɛ́ aa gↄ̃ bùsu vĩ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ à lɛkɛ̀nɛ́ↄ sↄ̃ aa midɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dii mɛ́ ì zɛmikũ gbɛ̃́ɛ,","poem":1},{"lineBreak":true},{"text":"aà pↄ ìↄ na aà kuawa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Baa tó àlɛ lɛlɛ, a lɛ́lɛ sↄlↄlↄo,","poem":1},{"lineBreak":true},{"text":"kɛ́ Dii aà kũa yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ɛ̀waason ma ũ yãa, ↄ̃ ma zikũ̀,","poem":1},{"lineBreak":true},{"text":"mi e Lua gbɛ̃maa vũ̀aa bauo,","poem":1},{"lineBreak":true},{"text":"mi e aà nɛ́ↄ lɛ́ baakɛo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ìↄ gbada gↄↄpii ìↄ pↄ́ sɛ̃anɛ́,","poem":1},{"lineBreak":true},{"text":"aà nɛ́ↄ aaↄ dɛ báaadeↄ ũɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Mikɛ̃ yãvãiwa, níↄ yãmaakɛ,","poem":1},{"lineBreak":true},{"text":"ní e ǹyↄ̃ ku gↄↄpii.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Asa Dii ye maakɛai,","poem":1},{"lineBreak":true},{"text":"a a náaikɛnaↄ vũaao.","poem":1},{"lineBreak":true},{"text":"Aaↄ ku aafiaɛ gↄↄpii,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ sↄ̃ aa midɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ mɛ́ aa gↄ̃ bùsu vĩ,","poem":1},{"lineBreak":true},{"text":"aaiↄ ku we gↄↄpii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ɔ̃nↄyã ì bↄ gbɛ̃maa lɛ́u,","poem":1},{"lineBreak":true},{"text":"aà lɛ́ ì yã́zɛde o.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Aà Lua ikoyã dↄ aà sↄ̃wa,","poem":1},{"lineBreak":true},{"text":"aà gbá lí tii pↄewao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Gbɛ̃vãi ì gbɛ̃maa kpákpa","poem":1},{"lineBreak":true},{"text":"kɛ́ à e aà dɛ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Dii a gbɛ̃maapi to aà ↄzĩo,","poem":1},{"lineBreak":true},{"text":"a we yã́kpalɛ aà bleo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Sↄ̃́a Diizi, níↄ aà yã́ kũa,","poem":1},{"lineBreak":true},{"text":"i n kã́fĩ, ní gↄ̃ bùsu vĩ,","poem":1},{"lineBreak":true},{"text":"ní gbɛ̃vãiↄ midɛa e.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Ma gbɛ̃vãi gbãadee è yãa,","poem":1},{"lineBreak":true},{"text":"àlɛ ↄta lán lí pↄ́ gu kɛ̀ɛ̀ nawa.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Kɛ́ tá ma kpa we, a ku we lↄo,","poem":1},{"lineBreak":true},{"text":"ma aà wɛ̀ɛlɛ, mi aà eo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Tàaesaide yã́ gwa,","poem":1},{"lineBreak":true},{"text":"wɛ́tɛ gbɛ̃maa yã́i,","poem":1},{"lineBreak":true},{"text":"asa nↄ̀sɛniɛde buiↄ gↄ̃ bui ũ.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Ãma duunkɛnaↄ bãdɛ sãnusãnu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ bui a midɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Dii mɛ́ a gbɛ̃maaↄ suaba,","poem":1},{"lineBreak":true},{"text":"aↄ dɛnɛ́ ulɛkĩi ũ taasikɛgↄↄ.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Dii a dↄńlɛ, i ń bↄ,","poem":1},{"lineBreak":true},{"text":"a ń sí gbɛ̃vãiↄwa, i ń suaba","poem":1},{"lineBreak":true},{"text":"kɛ́ aa nàaàzi yã́i.","poem":1}]}],"footnotes":[{"noteId":38,"caller":"+","text":"37.11 Mat 5.5","reference":{"chapter":37,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}