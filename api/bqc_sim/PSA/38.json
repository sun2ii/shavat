"lineBreak":true},{"text":"Má kooa ma gↄ̃ dↄ̀lↄlↄ,","poem":1},{"lineBreak":true},{"text":"miↄ bɛ oosisiaɛ gↄↄpii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ma wó lɛ́ wí sĩana,","poem":1},{"lineBreak":true},{"text":"ma mɛ dáamavĩo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Má yɛ̃̀ɛɛ vĩo, ma mɛ kɛ̀ múɛmuɛ,","poem":1},{"lineBreak":true},{"text":"málɛ wiilɛ ma sↄ̃̀ pusubↄa yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dii, ń pↄ́ pↄ́ má yei dↄ̃ píi,","poem":1},{"lineBreak":true},{"text":"ni ma wea fɛ̀ɛɛ ma sã́asã.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma sↄ̃ lɛ́ vĩ gbò gbò, ma gbãa yã̀a,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ lɛ́ tɛkɛ lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ma gbɛ̃naↄ ń ma gbɛ̃́ↄ ì ɛ̃mɛɛɛ,","poem":1},{"lineBreak":true},{"text":"ma daɛↄ ì zɛmɛɛ zã̀zã ma bↄ yã́i.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ ye ma kaikɛↄ ì ma pá,","poem":1},{"lineBreak":true},{"text":"ma wɛnaↄ ì vãikpaaĩmanↄ,","poem":1},{"lineBreak":true},{"text":"aaìↄ mↄafiliyã gwa ń kↄ̃o gↄↄpii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ma gↄ̃ lán swãdowa,","poem":1},{"lineBreak":true},{"text":"mili yãmao,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ lán lɛ́nanaalɛadewa,","poem":1},{"lineBreak":true},{"text":"mili lɛwɛ̃aao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Má dɛ lán gbɛ̃́ pↄ́ lí yãmaowa,","poem":1},{"lineBreak":true},{"text":"mili yã́zãsimáo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dii, ḿmɛ ma wɛ́ dↄnzi,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ ma yãma, Dii ma Lua.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma mɛ̀ ńsu to aa tidↄmalao,","poem":1},{"lineBreak":true},{"text":"ńsu to aa ĩ́anadã ma tiia guwa yã́io.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ma ka lɛ́lɛa,","poem":1},{"lineBreak":true},{"text":"miↄ ku yã'ↄ̃mauɛ gↄↄpii.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Má a yãvãiↄ siunɛ sa,","poem":1},{"lineBreak":true},{"text":"asa ma duuna yã́i ma pↄ yaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ma ibɛɛↄ gbãa mɛ́ aa aafia,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ zamagu pãↄ dasi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aaì maa fĩabomɛɛ ń vãio,","poem":1},{"lineBreak":true},{"text":"maa má tɛ́i, ↄ̃ aa íbɛlɛsɛ̀manↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dii, ńsu ma vũaao,","poem":1},{"lineBreak":true},{"text":"ma Lua, ńsu ǹyↄ̃ kumanↄ zã̀o.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mↄ dↄmalɛ kpakpa,","poem":1},{"lineBreak":true},{"text":"ma Dii, ma Suabana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":23}