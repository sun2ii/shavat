{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":39,"content":[{"type":"heading","content":["Taaside wiilɛa Luawa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ma mɛ̀ máↄ azĩa kũa dↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"má tó ma lɛ́ ma da duunauo.","poem":1},{"lineBreak":true},{"text":"Tó gbɛ̃vãiↄ kumanↄ, má a lɛ́ fↄ̃́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma lɛ́ kpaaũa, má kú kílikili,","poem":1},{"lineBreak":true},{"text":"mi yãe oo, baa yãmaa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma yã'ↄ̃ma ɛ̀a kã̀fĩ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma sↄ̃ pusu bↄ̀ ma guu,","poem":1},{"lineBreak":true},{"text":"kɛ́ ma làasookɛ̀, ma nↄ̀sɛ tɛ́ bↄ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma yã'ò ma mɛ̀:","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii, to mà a kua lɛ́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"ń ma gↄↄ dasilɛo.","poem":1},{"lineBreak":true},{"text":"To mà dↄ̃ lá ma wɛ̃ni ì gɛ̃zɛa àa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N ma wɛ̃ni lɛ́ yↄ̃̀ n ↄtão,","poem":1},{"lineBreak":true},{"text":"ma kua dɛ wɛ́ ń níola n kĩ́io.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́pii ì gɛ̃zɛa lán ĩ́anawaɛ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"gbɛ̃nazĩna bɛa ìↄ dɛ lán uenawaɛ.","poem":1},{"lineBreak":true},{"text":"Ì kɛ bã̀abãa ì àizɛɛ kãaa,","poem":1},{"lineBreak":true},{"text":"ãma a dↄ̃ dé a gↄ̃ɛ̀o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lá màaɛ, bↄ́ má wɛ́ aↄ dↄi lↄi?","poem":1},{"lineBreak":true},{"text":"Ḿmɛ ma wɛ́ dↄnzi, Dii.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma tàaeↄ kɛ̃a,","poem":1},{"lineBreak":true},{"text":"ńsu to mìsaideↄ ma àlafiikɛo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma lɛ́ kpaaũa, mi a lɛ́ wɛ̃aao,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ n yã́pi kɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ńsu ma gbɛ̃ lↄo,","poem":1},{"lineBreak":true},{"text":"n ↄgbala lɛ́ ma kãsãnkɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ni gbɛ̃́ toto,","poem":1},{"lineBreak":true},{"text":"ni aà wɛtã aà duuna yã́i,","poem":1},{"lineBreak":true},{"text":"ni aà àizɛɛ sóso lán blɛ́wa.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́pii ì gɛ̃zɛa lán ĩ́anawaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ma wabikɛa si Dii,","poem":1},{"lineBreak":true},{"text":"swã́kpa ma wiilɛai.","poem":1},{"lineBreak":true},{"text":"Ńsu swã́kaka ma ↄ́ↄlↄaɛo,","poem":1},{"lineBreak":true},{"text":"asa n nibↄn ma ũ,","poem":1},{"lineBreak":true},{"text":"má dɛ bↄ̀mↄ ũ lán ma deziↄwaɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wɛwoa kɛ́ mà e màↄ weea,","poem":1},{"lineBreak":true},{"text":"e màↄ kɛsai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":14}