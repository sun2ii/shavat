{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":4,"content":[{"type":"heading","content":["Wabi oosi kɛa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ. Wì sí ń mↄↄnlɛaoɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Tó ma n sisi, wea Lua ma Zɛnnↄde.","poem":1},{"lineBreak":true},{"text":"Tó má yeelɛa, ni ma gba dɛ̀ɛpookĩi.","poem":1},{"lineBreak":true},{"text":"Wɛ̃nadↄ̃mɛɛ, ní ma wabikɛa ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gbɛ̃́ↄ, á zɛ widaa ma Lua gawidewaɛ bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Iↄ ye pↄpãↄzi, iↄ tɛ tã́aↄzi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Àↄ dↄ̃ kɛ́ Dii a gbɛ̃́ↄ dìlɛ adoa,","poem":1},{"lineBreak":true},{"text":"tó ma aà sìsi, a ma yãma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À kpakpanaga, ásu duunakɛo,","poem":1},{"lineBreak":true},{"text":"à làasookɛ á wúlɛkĩi, í nílɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À sa pↄ́ dɛ à o o,","poem":1},{"lineBreak":true},{"text":"í Dii náaikɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dasi ì mɛ: Démɛ a ɛ̀fãaikɛwɛ̃ɛi?","poem":1},{"lineBreak":true},{"text":"Wá wɛgwa Dii, báaadawágu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Baa tó pↄ́wɛna ń vɛ̃ɛo dińzi,","poem":1},{"lineBreak":true},{"text":"pↄna pↄ́ ń dàmɛɛ ma sↄ̃u dɛ ń pↄ́a.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mi wúlɛ i'o ń a nao kau,","poem":1},{"lineBreak":true},{"text":"asa Dii, ḿmɛ ni to màↄ ku dↄdↄa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}