{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":40,"content":[{"type":"heading","content":["Dii sáaukpaa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ma wɛdↄ̀ Diizi maamaa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ma wɛgwà à ma wiilɛa mà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À ma bↄ gbã́o kↄ̃fĩde guu,","poem":1},{"lineBreak":true},{"text":"à ma si dɛɛwa.","poem":1},{"lineBreak":true},{"text":"À ma gbá pɛ̀lɛ gbɛsi musu,","poem":1},{"lineBreak":true},{"text":"à ma zɛ we gíũgiũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À lɛ̀ dafu dà ma lɛ́u,","poem":1},{"lineBreak":true},{"text":"wá Lua táasilɛa pↄ́ ũ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ↄ e dasi, vĩa i ń kṹ,","poem":1},{"lineBreak":true},{"text":"aai Dii náaikɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ Dii náai vĩ","poem":1},{"lineBreak":true},{"text":"mɛ́ ìli zɛ ń waladeↄ ń tã́agbagbanaↄo ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dii ma Lua, n yãbↄnsaɛkɛaↄ dasi,","poem":1},{"lineBreak":true},{"text":"wa fↄ̃ yã́ pↄ́ ńlɛ yáwanↄↄ dↄdↄo.","poem":1},{"lineBreak":true},{"text":"Tó má dàu lɛ́ siunɛ́,","poem":1},{"lineBreak":true},{"text":"a lɛ́ vĩo, má fↄ̃ o píio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ń ye sa'obↄ ge gbaio,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ń tò ma swã́ mà.","poem":1},{"lineBreak":true},{"text":"Ni sa pↄ́ wì a pↄ́ kátɛu à tɛ́kũ","poem":1},{"lineBreak":true},{"text":"ge duun awakpabↄ gbɛao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɔ̃ ma mɛ̀: Má kɛ́!","poem":1},{"lineBreak":true},{"text":"Lá a ku lá guu ma yã́ musuwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Má ye n pↄeã kɛaiɛ, ma Lua,","poem":1},{"lineBreak":true},{"text":"n ikoyã ku ma sↄ̃ guu.","poem":1},{"noteId":39}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Má yã́zɛde baokpa balu guu,","poem":1},{"lineBreak":true},{"text":"má a lɛ́ kpaaũo lá ń dↄ̃wà Dii.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lá ni yãnakpámá, má nílɛo,","poem":1},{"lineBreak":true},{"text":"má n náai ń n gbɛ̃suabaao yã'o.","poem":1},{"lineBreak":true},{"text":"Má gí n gbɛ̃kɛ ń n sĩandekɛo oi balu guuo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dii, ńsu gí ma wɛ̃nagwaio,","poem":1},{"lineBreak":true},{"text":"to n gbɛ̃kɛ ń n sĩandekɛo ma dↄ̃́a.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Asa vãi pↄ́ liaamazi lɛ́ vĩo,","poem":1},{"lineBreak":true},{"text":"ma tàaeↄ dàmala, má fↄ̃ gu'eo,","poem":1},{"lineBreak":true},{"text":"a dasi dɛ ma mikãa, sↄ̃ kɛ̃̀magu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dii, suɛ, ma misi,","poem":1},{"lineBreak":true},{"text":"Dii, kɛ kpakpa, mↄ dↄmalɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"To wí ma wɛnaↄ kṹ,","poem":1},{"lineBreak":true},{"text":"aa ń mi pɛlɛ.","poem":1},{"lineBreak":true},{"text":"To gbɛ̃́ pↄ́ ye mà yã'eↄ kpɛkpa,","poem":1},{"lineBreak":true},{"text":"an gɛɛ gↄ̃ kpá ń wɛ́i.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aaì omɛɛ, tàalɛ, tàalɛↄ,","poem":1},{"lineBreak":true},{"text":"to wí gↄ̃ ń ú ũ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aalɛ n kĩ́i wɛɛlɛↄ,","poem":1},{"lineBreak":true},{"text":"to an pↄ kɛma na aa yáalↄ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ an wɛ́ dↄi ǹ ń suabaↄ,","poem":1},{"lineBreak":true},{"text":"aaↄ o láasai Dii zↄ̃ↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Taaside wɛ̃naden ma ũ,","poem":1},{"lineBreak":true},{"text":"làasookɛ ma yã́wa, Dii.","poem":1},{"lineBreak":true},{"text":"Ḿmɛ ń ma Dↄnlɛde ũ,","poem":1},{"lineBreak":true},{"text":"ma Mìsina ũ.","poem":1},{"lineBreak":true},{"text":"Ma Lua, ńsu gɛ̃gɛ̃o.","poem":1}]}],"footnotes":[{"noteId":39,"caller":"+","text":"40.9 Ɛbɛ 10.5-7","reference":{"chapter":40,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":18}