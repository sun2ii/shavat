{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":41,"content":[{"type":"heading","content":["Gyãe wabikɛa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Báaaden gbɛ̃́ pↄ́ ì yɛ̃̀ɛɛsaide yãda ũ,","poem":1},{"lineBreak":true},{"text":"Dii ì aà bↄ taasikɛgↄↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii a aà dↄ̃́a, a aà gba wɛ̃ni,","poem":1},{"lineBreak":true},{"text":"a báaadaaàgu aà bùsuu,","poem":1},{"lineBreak":true},{"text":"a aà kpa aà ibɛɛↄwa aa ń pↄeã daɛ̀o.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii a zɛaànↄ aà gyãkɛa guu,","poem":1},{"lineBreak":true},{"text":"a to aà gyãpi ble.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma mɛ̀: Dii, ma duunakɛ̀nɛ,","poem":1},{"lineBreak":true},{"text":"ma wɛ̃nagwa, ní ma gbã́gbã.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma ibɛɛↄ lɛ́ ga kpaaĩmanↄ aa mɛ̀:","poem":1},{"lineBreak":true},{"text":"A ga bↄɛ ni? Bↄɛ aà tↄ́ a midɛi?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tó aa mↄ̀ ma gwai,","poem":1},{"lineBreak":true},{"text":"yãyaaa aaì bↄlɛmɛɛ,","poem":1},{"lineBreak":true},{"text":"aaì bao vãi wɛɛlɛ ma yã́ musu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aaì fɛlɛ gɛ fãaa bàasi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ma zangudeↄ ì vãikpaaĩmanↄ,","poem":1},{"lineBreak":true},{"text":"aaì àsi bɛ̃̀ɛ dↄa aaì mɛ:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gagyã mɛ́ aà lè,","poem":1},{"lineBreak":true},{"text":"a fɛlɛ a wúlɛkĩi beeu lↄo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Baa ma kpàasia pↄ́ má aà náai vĩ","poem":1},{"lineBreak":true},{"text":"wi pↄble sãnu bↄ̀ ma kpɛ.","poem":1},{"noteId":40}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mpi sↄ̃ Dii, ma wɛ̃nagwa,","poem":1},{"lineBreak":true},{"text":"ma gbã́gbã, mí fĩabonɛ́.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó ma ibɛɛↄ i kúkua dↄao,","poem":1},{"lineBreak":true},{"text":"máↄ dↄ̃ sa kɛ́ ma yã́ kàngu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ń ma kũa ma nↄ̀sɛmaa yã́i,","poem":1},{"lineBreak":true},{"text":"n aɛ ìↄ dↄa gↄↄpii.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Báaade Dii, Isailiↄ Lua","poem":1},{"lineBreak":true},{"text":"za asĩnizĩ e gↄↄpii!","poem":1},{"lineBreak":true},{"text":"Ãmi! Ãmi!","poem":1}]}],"footnotes":[{"noteId":40,"caller":"+","text":"41.10 Mat 26.23, Maa 14.18, Luk 22.21, Zãa 13.18","reference":{"chapter":41,"verse":10}}]},"thisChapterLink":"/api/bqc_sim/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":14}