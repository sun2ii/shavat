ↄↄnao, Lua ma Lua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bↄ́yãi ma sↄ̃ ↄ̃̀ↄkpài?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi ma nↄ̀sɛ yài?","poem":1},{"lineBreak":true},{"text":"Máↄ wɛdↄ Luazi,","poem":1},{"lineBreak":true},{"text":"asa má ɛa màↄ aà táasilɛ,","poem":1},{"lineBreak":true},{"text":"ma Suabana, ma Lua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}