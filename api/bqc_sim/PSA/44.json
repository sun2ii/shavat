{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":44,"content":[{"type":"heading","content":["Isailiↄ wɛ̃nakɛa"]},{"type":"verse","number":1,"content":[{"text":"Kole buiↄ lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Lua, yã́ pↄ́ ń kɛ̀ wá deziↄ gↄↄ,","poem":1},{"lineBreak":true},{"text":"aa òwɛ̃ɛ wá swã́ mà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ↄpɛ̀ buipãleↄwa n ĩadàmá,","poem":1},{"lineBreak":true},{"text":"n wá deziↄ kàlɛ ń gbɛu aa ↄtàu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"An fɛ̃nda mɛ́ ń ká bùsupiwao,","poem":1},{"lineBreak":true},{"text":"an gã̀sa gbãa ↄ̃ aa zĩblèòo.","poem":1},{"lineBreak":true},{"text":"N zĩa gã̀sa gbãa mɛ́ kɛ̀,","poem":1},{"lineBreak":true},{"text":"n kuańnↄ gupùnɛ́, kɛ́ ń yeńzi yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ḿmɛ ń ma kía ũ ma Lua,","poem":1},{"lineBreak":true},{"text":"ni to Yakↄbu buiↄ zĩble.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ń n báaao wi ↄpɛ wá ibɛɛↄwa,","poem":1},{"lineBreak":true},{"text":"ń n tↄ́o wi ↄ̃zↄ̃ wá wɛ̀lɛpiↄwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I kɛ ma sá málɛ a náaikɛo,","poem":1},{"lineBreak":true},{"text":"i kɛ ma fɛ̃nda mɛ́ ì ma bↄo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa ḿmɛ ni wá sí wá ibɛɛↄwa,","poem":1},{"lineBreak":true},{"text":"ni wida wá zangudeↄwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lua, wiↄ n táasilɛ gↄↄpii,","poem":1},{"lineBreak":true},{"text":"wiↄ n tↄbↄ láasai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ń beeo n ↄpɛ̀wá ń tò wí wá kṹ,","poem":1},{"lineBreak":true},{"text":"nili bↄ ń wá zĩgↄ̃ↄ lↄo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ń tò wa pↄ̀ↄbↄzãkɛ̀ wá ibɛɛↄnɛ,","poem":1},{"lineBreak":true},{"text":"ń tò wá zangudepiↄ wá pↄ́ↄ nàaa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N ń gbá zɛ́ aa wá dɛdɛ lán sãↄwa,","poem":1},{"lineBreak":true},{"text":"n wá fãaa buipãleↄ guu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N n gbɛ̃́ↄ yìa àa'aa,","poem":1},{"lineBreak":true},{"text":"ni ài'e ń yíaa yã́ musuo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ń tò wá saɛdeↄ wá sↄ̃sↄ̃,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ liaawáziↄ wá láanikɛ̀.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ń tò wa gↄ̃ yãa ũ buipãleↄnɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ↄ ìↄ midɛwɛ̃ɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Miↄ kú ń wío gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"ma gɛɛ gↄ̃̀ kpa ma wɛ́i,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ma láanikɛnaↄ ń ma sↄ̃̀sↄ̃naↄ yã́i","poem":1},{"lineBreak":true},{"text":"ń ma ibɛɛ pↄ́ aa ye tↄsiaↄ yã́o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bee wá lé píi,","poem":1},{"lineBreak":true},{"text":"baa kɛ́ n yã́ i sã́wáguo,","poem":1},{"lineBreak":true},{"text":"mɛ́ wi ń bàakuawanↄ yã́ gbooo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wá nↄ̀sɛ i liaamao,","poem":1},{"lineBreak":true},{"text":"wi kɛ̃ n zɛ́wao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N wá wiwi n wá ká gu gbɛ̃gbondeu,","poem":1},{"lineBreak":true},{"text":"n gusia zↄ̃ↄ kũ̀aawá.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tó wá Lua tↄ́ sã̀wágu,","poem":1},{"lineBreak":true},{"text":"ge tó wa wɛdↄ̀ dii zĩ̀lozi yãaɛ,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lua a gí eie?","poem":1},{"lineBreak":true},{"text":"Asa ↄ̃mɛ wá nↄ̀sɛ yã́ dↄ̃ píi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N yã́i wá kú ga lɛ́zĩ gↄↄpii,","poem":1},{"lineBreak":true},{"text":"wì wá dilɛ lán sã pↄ́ wa ń kòlokpaↄwa.","poem":1},{"noteId":41}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Vu, Dii! Àkɛa ńlɛ i'oi?","poem":1},{"lineBreak":true},{"text":"Fɛlɛ! Ńsu wá vũaa gↄↄpiio.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Àkɛa n mikpɛlìwɛ̃ɛi?","poem":1},{"lineBreak":true},{"text":"Wá wɛ̃nakɛa ń wá wɛtãao sã̀ngu yã̀?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wa gↄ̃ ye bùsutiu,","poem":1},{"lineBreak":true},{"text":"wa gↄ̃ wúlɛa tↄↄlɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Fɛlɛ dↄwálɛ!","poem":1},{"lineBreak":true},{"text":"Mↄ ǹ wá misi n gbɛ̃kɛ yã́i.","poem":1}]}],"footnotes":[{"noteId":41,"caller":"+","text":"44.23 Lom 8.36","reference":{"chapter":44,"verse":23}}]},"thisChapterLink":"/api/bqc_sim/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":27}