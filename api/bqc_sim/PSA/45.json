{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":45,"content":[{"type":"heading","content":["Kía nↄsɛlɛ"]},{"type":"verse","number":1,"content":[{"text":"Gbɛ̃́ yenzide lɛ pↄ́ Kole buiↄ dà.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Yãna lɛ́ pipi ma sↄ̃ guu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ málɛ lɛɛ bee da ń kío.","poem":1},{"lineBreak":true},{"text":"Ma lɛ́ na lán ladↄ̃n maa lákɛ̃bↄwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"N kɛfɛnkɛ dɛ gbɛ̃́piia,","poem":1},{"lineBreak":true},{"text":"n lɛgbɛ'i ìↄ na,","poem":1},{"lineBreak":true},{"text":"báaa pↄ́ Lua dàngu láaa vĩo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zĩgↄ̃ pãsĩ, ǹ ń fɛ̃nda sɛ ǹ loo","poem":1},{"lineBreak":true},{"text":"n kíakɛgawi seela ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Di sↄ̃́ kpɛ gɛ zĩble n gawi guu","poem":1},{"lineBreak":true},{"text":"sĩana ń yã́zɛdeo yã́i.","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ ì dimá kɛ ń n ↄplaa gbãao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kí, n kaↄ lɛ́ sↄ̃́nɛ,","poem":1},{"lineBreak":true},{"text":"a gɛ̃ n ibɛɛↄ sↄ̃ kṹ,","poem":1},{"lineBreak":true},{"text":"buiↄ kwɛ n gbázĩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lua, ńyↄ̃ↄ zↄ̃lɛa báawa gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"niↄ n kíakɛ lípana kũa yã́zɛde ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ń ye yã́zɛdei, ń za vãigu.","poem":1},{"lineBreak":true},{"text":"A yã́i tò Lua, n Lua, n kpa kpalau,","poem":1},{"lineBreak":true},{"text":"à pↄna pìsima dɛ n gbɛ̃́ↄla.","poem":1},{"noteId":42}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lí'ↄ gĩnana pìsi ń pↄkasaↄwa,","poem":1},{"lineBreak":true},{"text":"mↄↄna'ↄ a n pↄ kɛ na","poem":1},{"lineBreak":true},{"text":"n kpɛ́ pↄ́ wa kɛ̀kɛ ń wesa swaao guu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kí nɛnↄɛↄ ku n nↄ yenzideↄ guu,","poem":1},{"lineBreak":true},{"text":"n nↄ dafu kú n ↄplaai,","poem":1},{"lineBreak":true},{"text":"a Ofii bùsu vua zãblebↄↄ daa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nɛnↄɛna, swã́kpa ǹ ma!","poem":1},{"lineBreak":true},{"text":"N mae bɛ ń n gbɛ̃́ↄ yã́ su dↄaanɛo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N kɛfɛnkɛ lɛ́ kí mɛ lua,","poem":1},{"lineBreak":true},{"text":"misiilɛɛ̀, asa n diin aà ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tiideↄ mↄ gbadanɛ,","poem":1},{"lineBreak":true},{"text":"ↄdeↄ n aɛ wɛɛlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kí nɛnↄɛpi zↄ̃lɛ kpɛa ń gawio,","poem":1},{"lineBreak":true},{"text":"wà vua ba kɛ̃̀ aà pↄkasaↄwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wàlɛ mↄaànↄ kípiɛ","poem":1},{"lineBreak":true},{"text":"ń aà pↄkasa wɛ̃̀sãdeↄ daa.","poem":1},{"lineBreak":true},{"text":"Nɛ́ wɛ̃́ndiapi mↄtɛnziↄ tɛaàzi,","poem":1},{"lineBreak":true},{"text":"aalɛ mↄaànↄ aà kĩ́i.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wàlɛ gɛ̃ńnↄ kibɛ,","poem":1},{"lineBreak":true},{"text":"wàlɛ pↄnakɛ ń gulakɛao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"N nɛgↄ̃ɛↄ gↄ̃ n maeↄ gɛ̃ɛ ũ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ ń dilɛdilɛ kíaↄ ũ dṹnia guu píi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Má tó n tↄ́ àↄ dↄ gbɛ̃́ↄgu láasai,","poem":1},{"lineBreak":true},{"text":"bui píi iↄ n sáaukpa gↄↄpii.","poem":1}]}],"footnotes":[{"noteId":42,"caller":"+","text":"45.8 Ɛbɛ 1.8-9","reference":{"chapter":45,"verse":8}}]},"thisChapterLink":"/api/bqc_sim/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":18}