{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":47,"content":[{"type":"heading","content":["Lua mɛ́ dṹnia gbɛ̃́pii kía ũ"]},{"type":"verse","number":1,"content":[{"text":"Kole buiↄ lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Bui píi, à ↄtaalɛ,","poem":1},{"lineBreak":true},{"text":"à kúkuakɛ Luaɛ ń gulao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Asa Dii Musude kà wàↄ aà vĩa vĩ,","poem":1},{"lineBreak":true},{"text":"dṹnia gbɛ̃́pii Kía zↄ̃ↄn aà ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A tò wa zĩblè buiↄwa,","poem":1},{"lineBreak":true},{"text":"a tò wa ↄ̃zↄ̃̀ gbɛ̃́piↄwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À kpaalɛsɛ̀wɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"wápiↄ aà yenzide Yakↄbu buiↄ ĩ́andãbↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lua fɛ̀lɛ, wàlɛ gulakɛ,","poem":1},{"lineBreak":true},{"text":"Dii zɛa, wàlɛ kã̀aepɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À lɛsi Luaɛ, à lɛsiɛ̀,","poem":1},{"lineBreak":true},{"text":"à lɛsi wá Kíaɛ, à lɛsiɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa dṹnia píi Kían aà ũ.","poem":1},{"lineBreak":true},{"text":"À lɛsiɛ̀ ń dↄ̃ao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lua lɛ́ kible bui píiwa,","poem":1},{"lineBreak":true},{"text":"a zↄ̃lɛa a báa pↄ́ a kua adoawa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bui píi kpalablenaↄ lɛ́ kãaa","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ dɛ Ablahaũ Lua gbɛ̃́ↄ ũↄ,","poem":1},{"lineBreak":true},{"text":"asa dṹnia kíaↄá Lua pↄ́ɛ.","poem":1},{"lineBreak":true},{"text":"A dɛńla píi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}