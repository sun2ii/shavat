{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":49,"content":[{"type":"heading","content":["Àizɛɛ náaikɛaá mìsaiyãɛ"]},{"type":"verse","number":1,"content":[{"text":"Kole buiↄ lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Bui píi, à yã́ɛ bee ma,","poem":1},{"lineBreak":true},{"text":"dṹnia gbɛ̃́pii, à swã́kpa,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"kíaↄ ń táaaↄ,","poem":1},{"lineBreak":true},{"text":"ↄdeↄ ń taasideↄ píi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɔ̃nↄyã kú ma lɛ́u,","poem":1},{"lineBreak":true},{"text":"dↄ̃a ku ma sↄ̃u.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Má swãdↄ yáasi yã́i,","poem":1},{"lineBreak":true},{"text":"mí polo mↄↄnlɛa guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Má vĩakɛ yãpãsĩgↄↄo,","poem":1},{"lineBreak":true},{"text":"baa tó ma wɛ̀lɛↄ liaamazi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa ń àizɛɛ náai vĩ,","poem":1},{"lineBreak":true},{"text":"aaì ń ↄda ĩ́anadã.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃e a fↄ̃ gí ń a dee wɛ̃nioo,","poem":1},{"lineBreak":true},{"text":"a e pↄe kpa Luawa à aà wɛ̃ni boòo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Asa gbɛ̃́ wɛ̃ni boa zĩ'ũ,","poem":1},{"lineBreak":true},{"text":"àizɛɛ a fↄ̃ bo bauo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A fↄ̃ to aàↄ ku gↄↄpiio,","poem":1},{"lineBreak":true},{"text":"a fↄ̃ giɛ̀ aà wɛsi bɛdalɛo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Asa wa dↄ̃ baa ↄ̃nↄnaↄ ì ga,","poem":1},{"lineBreak":true},{"text":"mìsaideↄ ń sↄũↄ ì midɛ màa píi,","poem":1},{"lineBreak":true},{"text":"aaì ń àizɛɛ tó gbɛ̃pãleↄnɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Baa kɛ́ wà ńzĩa tↄ́ kpà bùsuↄnɛ yãa,","poem":1},{"lineBreak":true},{"text":"an mia aↄ dɛ ń bɛ ũɛ gↄↄpii,","poem":1},{"lineBreak":true},{"text":"an kúkĩi ũ e ń buiwa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna ń a bɛɛɛkɛo","poem":1},{"lineBreak":true},{"text":"ìliↄ ku gↄↄpiio,","poem":1},{"lineBreak":true},{"text":"a ta lán nↄ̀bↄↄwaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mìsaideↄ láaan we,","poem":1},{"lineBreak":true},{"text":"màaɛ lↄ ń gbɛ̃́ pↄ́ tɛ́ ń iaiↄ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aa si bɛdau lán sãↄwa,","poem":1},{"lineBreak":true},{"text":"ga mɛ́ aↄ dɛ ń dã̀dãna ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ gbɛ̃maaↄ kiblemá zia.","poem":1},{"lineBreak":true},{"text":"An mɛↄ yaikɛ miau,","poem":1},{"lineBreak":true},{"text":"aaↄ kpɛ́ vĩ lↄo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ãma Lua a ma wɛ̃ni si bɛdawa,","poem":1},{"lineBreak":true},{"text":"i gbãakpamazi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tó gbɛ̃́ lɛ́ gↄ̃ ↄde ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ aà bɛ tↄ́ lɛ́ nakṹ,","poem":1},{"lineBreak":true},{"text":"ńsu to à kɛnɛ yãe ũo,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"asa a a kee e sɛ taò a gagↄↄo,","poem":1},{"lineBreak":true},{"text":"aà àizɛɛↄ e pɛ́lɛaàzio.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Baa tó à azĩa dↄ̃̀ ɛ̀fãaide ũ a wɛ̃nigↄↄ,","poem":1},{"lineBreak":true},{"text":"mɛ́ wà aà sáaukpà aà namablea yã́i,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"a ta a deziↄ kĩ́i,","poem":1},{"lineBreak":true},{"text":"a wɛsi gupualɛ bau lↄo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna ń a bɛɛɛkɛo,","poem":1},{"lineBreak":true},{"text":"tó aà wɛ́ i kɛ̃o,","poem":1},{"lineBreak":true},{"text":"a ta lán nↄ̀bↄↄwaɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":21}