{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":5,"content":[{"type":"heading","content":["Wabi kↄↄ kɛa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ. Wì sí ń kulɛpɛaoɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Swã́kpa ma yã́i Dii,","poem":1},{"lineBreak":true},{"text":"laaidↄ ma yãwaaipaawa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma Kía, málɛ wiilɛma,","poem":1},{"lineBreak":true},{"text":"ma Lua, málɛ wabikɛma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii, ni ma yãma gufɛ̃nɛ,","poem":1},{"lineBreak":true},{"text":"mi a yã́ↄ dↄdↄnɛ kↄↄ,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ iↄ dↄnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Luan n ũ, ń ye vãizio,","poem":1},{"lineBreak":true},{"text":"nili gbɛ̃vãi dilɛo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zĩakãfĩna lí e zɛ̀ n aɛo,","poem":1},{"lineBreak":true},{"text":"ń za vãikɛnaↄgu píiɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii, ni ɛɛdeↄ midɛ,","poem":1},{"lineBreak":true},{"text":"ń ye gbɛ̃dɛnaↄ ń gbɛ̃blenaↄ gĩyãio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mapi má gɛ̃ n ua n gbɛ̃kɛ zↄ̃ↄ yã́i,","poem":1},{"lineBreak":true},{"text":"má kúlɛ n kpɛɛlɛ mà misiilɛnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii, dↄaamɛɛ n náai yã́i,","poem":1},{"lineBreak":true},{"text":"zɛpoomɛɛ ma dã̀dãnaↄ yã́i.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Asa an yãe náai vĩo,","poem":1},{"lineBreak":true},{"text":"aaì lɛnakasa gbɛ̃́ↄnɛ.","poem":1},{"lineBreak":true},{"text":"An nↄ̀sɛ dɛ lán kaadↄɛmbɛwaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ ↄ̃̀ↄkpaa yã́ kↄ̃̀ ń sↄ̃u.","poem":1},{"noteId":4}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"To yã́ zↄ̃lɛmá Lua,","poem":1},{"lineBreak":true},{"text":"to aa ↄzu ńzĩa wɛ́u.","poem":1},{"lineBreak":true},{"text":"Ǹ ń yá n aɛ an tàae dasiↄ yã́i,","poem":1},{"lineBreak":true},{"text":"asa aa gì n yãmaiɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"To gbɛ̃́ pↄ́ nà n kpɛↄ yáalↄ,","poem":1},{"lineBreak":true},{"text":"aaiↄ wiilɛ ń pↄnao gↄↄpii.","poem":1},{"lineBreak":true},{"text":"Ɔku gbɛ̃́ pↄ́ yenziↄla,","poem":1},{"lineBreak":true},{"text":"aai vĩ aaↄ kɛ̃aa n yã́ musu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dii, ni báaada gbɛ̃maaↄgu,","poem":1},{"lineBreak":true},{"text":"n yeańzi ì kàedańzi.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"5.10 Lom 3.13","reference":{"chapter":5,"verse":10}}]},"thisChapterLink":"/api/bqc_sim/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":13}