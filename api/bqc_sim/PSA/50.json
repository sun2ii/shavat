{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":50,"content":[{"type":"heading","content":["Lousisia sĩana"]},{"type":"hebrew_subtitle","content":["Asafa lɛ."]},{"type":"verse","number":1,"content":[{"text":"Dii Lua Gbãapiide lɛ́ yã'o,","poem":1},{"lineBreak":true},{"text":"àlɛ lɛzu dṹnia gbɛ̃́ↄzi","poem":1},{"lineBreak":true},{"text":"za ĩatɛ̃bilɛkĩi e a gɛ̃kpɛukĩi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lua gawi bìlɛ Siↄna,","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛ pↄ́ a kɛfɛnkɛ bↄlɛi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wá Luapi lɛ́ mↄ́, aↄ ku kílikilio.","poem":1},{"lineBreak":true},{"text":"Tɛ́ pↄ́ ì kṹmá kú aà aɛ,","poem":1},{"lineBreak":true},{"text":"zàa pãsĩ liaaaàzi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Àlɛ lɛzu musudeↄ ń zĩ́lɛdeↄzi,","poem":1},{"lineBreak":true},{"text":"kɛ́ à e yã́kpalɛkɛ ń a gbɛ̃́ↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À mɛ̀: À ma yãmanaↄ kãaamɛɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ma bàa kúńnↄ sa'oaa yã́iↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lua mɛ́ yã́kpalɛkɛna ũ,","poem":1},{"lineBreak":true},{"text":"musudeↄ ì aà yãkɛa a zɛ́wa kpàwakɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À ma ma gbɛ̃́ↄ, má yãvĩ mà oɛ́,","poem":1},{"lineBreak":true},{"text":"Isailiↄ, má bↄbↄánↄ,","poem":1},{"lineBreak":true},{"text":"mámɛmaa Lua á Lua.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Málɛ zↄadↄwá á sa'oa yã́io,","poem":1},{"lineBreak":true},{"text":"asa i sa pↄ́ wì a pↄ́ kátɛu à tɛ́kũ oa kↄ̃sↄ̃kↄ̃sↄ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Má zuswana pↄ́ kú á kpàsau ni vĩo,","poem":1},{"lineBreak":true},{"text":"ge ble pↄ́ kú á kaau,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"asa sɛ̃̀anↄbↄↄá ma pↄ́ↄnɛ","poem":1},{"lineBreak":true},{"text":"ń pↄtuo wai pↄ́ kú sĩ̀sĩ píi musuↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má gbɛ̀ musu bãↄ dↄ̃ píi,","poem":1},{"lineBreak":true},{"text":"mɛ́ sɛ̃sao pↄkelenaↄ ku ma pↄ́ ũɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó nↄa lɛ́ ma dɛ, má oɛ́o,","poem":1},{"lineBreak":true},{"text":"asa mámɛ má dṹnia vĩ ń a pↄ́ↄ píi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mi zuswana nↄ̀ↄ so yã̀?","poem":1},{"lineBreak":true},{"text":"Mi blesana au mi yã̀?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À sa'oa ma sáaukpaa ũ,","poem":1},{"lineBreak":true},{"text":"à lɛ́ pↄ́ á kɛ̀ ma Musudewa fĩabo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À lɛzumazi taasikɛgↄↄ,","poem":1},{"lineBreak":true},{"text":"mí á bↄu, í ma kpɛla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɔ̃ Lua ò vãikɛnaↄnɛ:","poem":1},{"lineBreak":true},{"text":"Àkɛa álɛ ma yãdilɛaↄ dↄdↄi,","poem":1},{"lineBreak":true},{"text":"mɛ́ ma bàakuańnↄ yã́ dↄ á lɛ́ui?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Á ye ma yãdanɛio,","poem":1},{"lineBreak":true},{"text":"a ma yã́ↄ kpà kpɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó a kpã́i è, i aà kɛ á gbɛ̃́ ũɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ á bàa ìↄ kú ń gbãsĩkɛnaↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Á lɛgbɛ'i vãi,","poem":1},{"lineBreak":true},{"text":"mɛ́ i lɛnakasanɛ́.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I zↄ̃lɛ ń á gbɛ̃do tↄ́o,","poem":1},{"lineBreak":true},{"text":"mɛ́ i á da nɛ́ bɛ̃̀ɛbo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A yã́ beeↄ kɛ̀ ↄ̃ má nílɛ.","poem":1},{"lineBreak":true},{"text":"Álɛ e má dɛáwaɛ,","poem":1},{"lineBreak":true},{"text":"ãma má zↄadↄwá, mí bↄbↄánↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Á gbɛ̃́ pↄ́ ma yã́ sã̀águↄ","poem":1},{"lineBreak":true},{"text":"à yã́pi ma.","poem":1},{"lineBreak":true},{"text":"Tó màan sↄ̃o, má á taitai,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e a e á siao.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ sa'òa ma sáaukpaa ũ","poem":1},{"lineBreak":true},{"text":"ade ma kpɛlàɛ,","poem":1},{"lineBreak":true},{"text":"àlɛ ma gba zɛ́ mà ↄlↄɛ","poem":1},{"lineBreak":true},{"text":"lá mi gbɛ̃́ↄ suabaɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}