{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":51,"content":[{"type":"heading","content":["Sùuugbɛaa Luawa"]},{"type":"verse","number":1,"content":[{"text":"Lɛ pↄ́ Davidi dà gↄↄ pↄ́ ãnabi Natã gɛ̀ aà kĩ́i aà gbãsĩkɛa ń Basɛbao gbɛa.","descriptive":true},{"noteId":44}]},{"type":"verse","number":3,"content":[{"text":"Lua, wɛ̃nadↄ̃mɛɛ n gbɛ̃kɛ guu,","poem":1},{"lineBreak":true},{"text":"ma tàaeↄ midɛ n maa zↄ̃ↄ yã́i.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma gbãsĩ woloa mà gↄ̃ wásawasa,","poem":1},{"lineBreak":true},{"text":"ma duuna kɛ̃a míↄmiↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Má a tàaeↄ dↄ̃ sa,","poem":1},{"lineBreak":true},{"text":"ma duuna lí sãmaguo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ḿmɛ ma duunakɛ̀nɛ,","poem":1},{"lineBreak":true},{"text":"ma yã́ pↄ́ ń yeio kɛ̀.","poem":1},{"lineBreak":true},{"text":"Tó n fɛlɛa ń yã́o, n yã́ aↄ naɛ,","poem":1},{"lineBreak":true},{"text":"tó n yãdàmala, n yã́ aↄ zɛvĩ.","poem":1},{"noteId":45}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Za ma da nↄ̀sɛu má vãi,","poem":1},{"lineBreak":true},{"text":"má duuna vĩ za ma igↄↄɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nↄ̀sɛmaa mɛ́ ì kangu,","poem":1},{"lineBreak":true},{"text":"ↄ̃nↄ damɛɛ ma sↄ̃ guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ma zu'o ń saoo mà zɛ̃ wásawasa,","poem":1},{"lineBreak":true},{"text":"ma nↄ̀sɛ pípi mà gↄ̃ púnvlãvlã.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"To mà pↄnakɛ ń yaalↄo,","poem":1},{"lineBreak":true},{"text":"to ma wá pↄ́ ń bùsa wee.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ńsu ma duuna yãdao,","poem":1},{"lineBreak":true},{"text":"ma yãvãiↄ bↄ dilɛ píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lua, nↄ̀sɛpua damɛɛ,","poem":1},{"lineBreak":true},{"text":"ɛa to ma sↄ̃ àↄ dilɛa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ńsu ma vũaao,","poem":1},{"lineBreak":true},{"text":"ńsu ǹ n Nisĩna siao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɛa to ma pↄ kɛ na","poem":1},{"lineBreak":true},{"text":"kɛ́ n ma suabà yã́i.","poem":1},{"lineBreak":true},{"text":"To pↄeã maa dↄaamɛɛ,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"mí n yã́ dada vãikɛnaↄnɛ,","poem":1},{"lineBreak":true},{"text":"duunkɛnapiↄ i ɛa zɛnnↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lua, ma bↄ gbɛ̃dɛa yã́u,","poem":1},{"lineBreak":true},{"text":"mí lɛsi n yãkɛa a zɛ́wa musu,","poem":1},{"lineBreak":true},{"text":"Lua ma Suabana.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dii, ma gba lɛ́,","poem":1},{"lineBreak":true},{"text":"mí n táasilɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Sa'oa lí kɛnɛ nao,","poem":1},{"lineBreak":true},{"text":"tó bee no, dↄ̃ má ò.","poem":1},{"lineBreak":true},{"text":"Sa pↄ́ wì a pↄ́ kátɛu à tɛ́kũ lí kánguo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sa pↄ́ málɛ oma mɛ́ nↄ̀sɛniɛ ũ,","poem":1},{"lineBreak":true},{"text":"nili saka nↄ̀sɛniɛ sùuudeguo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lua, ɛ̀fãaikɛ Siↄnaɛ n pↄeã maa guu.","poem":1},{"lineBreak":true},{"text":"Yelusalɛũ bĩ́i gba gbãa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A gbɛa sa'oa a zɛ́wa a kangu","poem":1},{"lineBreak":true},{"text":"ń sa pↄ́ wì a pↄ́ kátɛu à tɛ́kũo,","poem":1},{"lineBreak":true},{"text":"wi sa'o ń swanaↄ n gbagbakĩiwa.","poem":1}]}],"footnotes":[{"noteId":44,"caller":"+","text":"51.1-2 2Sam 12.1-15","reference":{"chapter":51,"verse":1}},{"noteId":45,"caller":"+","text":"51.6 Lom 3.4","reference":{"chapter":51,"verse":6}}]},"thisChapterLink":"/api/bqc_sim/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":20}