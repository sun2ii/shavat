{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":53,"content":[{"type":"heading","content":["Mìsaide yã'oa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Mìsaideↄ ì o ń sↄ̃ guu Lua kuo,","poem":1},{"lineBreak":true},{"text":"aa ↄ̃̀ↄkpà, an yãkɛa vãi,","poem":1},{"lineBreak":true},{"text":"yãmaakɛna kú ń guuo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Za musu Lua ì wɛ́tɛ gbɛ̃nazĩnaↄzi,","poem":1},{"lineBreak":true},{"text":"ì gwa tó gbɛ̃e ↄ̃nↄ kà a kĩ́i wɛɛlɛa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aa sã̀sã píi aa gↄ̃̀ dↄ̀ↄsai míↄmiↄ,","poem":1},{"lineBreak":true},{"text":"yãmaakɛna kú ń guuo, baa do.","poem":1},{"noteId":47}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vãikɛnaↄ wɛ́ lí gu'eo lé?","poem":1},{"lineBreak":true},{"text":"Aaì ma gbɛ̃́ↄ mↄ́mↄ lán úwa,","poem":1},{"lineBreak":true},{"text":"aali lɛzu Luazio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vĩa ń kṹ maamaa,","poem":1},{"lineBreak":true},{"text":"vĩa pↄ́ↄ ku we sↄ̃o.","poem":1},{"lineBreak":true},{"text":"Lua tò gbɛ̃́ pↄ́ lɛ̀lɛwáↄ gↄ̃̀ kálɛa gɛↄ ũ,","poem":1},{"lineBreak":true},{"text":"a widàmá kɛ́ Lua gìńzi yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lua, bↄ Siↄna mↄ ǹ Isailiↄ suaba!","poem":1},{"lineBreak":true},{"text":"Tó Lua sù ń a gbɛ̃́ↄ ń pá ziu,","poem":1},{"lineBreak":true},{"text":"Yakↄbu buiↄ pↄnakɛ,","poem":1},{"lineBreak":true},{"text":"Isailiↄ yáalↄ.","poem":1}]}],"footnotes":[{"noteId":47,"caller":"+","text":"53.4 Lom 3.10-12","reference":{"chapter":53,"verse":4}}]},"thisChapterLink":"/api/bqc_sim/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":7}