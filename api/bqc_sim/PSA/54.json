{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":54,"content":[{"type":"heading","content":["Gbɛ̃́ pↄ́ wàlɛ ĩadawà wabikɛa"]},{"type":"verse","number":1,"content":[{"text":"Lɛ pↄ́ Davidi dà gↄↄ pↄ́ Zifideↄ gɛ ò Sauluɛ aa mɛ̀ Davidi ulɛa ń bùsuu.","descriptive":true},{"noteId":48}]},{"type":"verse","number":3,"content":[{"text":"Lua, ma suaba n tↄ́ yã́i,","poem":1},{"lineBreak":true},{"text":"yã́simanↄ ń n gbãao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lua, ma wabikɛama ma,","poem":1},{"lineBreak":true},{"text":"swã́kpa ma yã'oai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Asa buipãleↄ fɛ̀lɛmanↄɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pãsĩpiↄ lɛ́ ma wɛ,","poem":1},{"lineBreak":true},{"text":"aali Lua yãdao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lua mɛ́ ma dↄnlɛde ũ,","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ ma wɛ̃nikũna ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ lɛ́ ma wɛↄ vãi sↄaamá,","poem":1},{"lineBreak":true},{"text":"ǹ ń bãdɛ n náai yã́i.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Má sa'oma ń ma pↄeãoɛ,","poem":1},{"lineBreak":true},{"text":"má n tↄbↄ Dii, asa ń maa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À ma bↄ ma yooyea píi guu,","poem":1},{"lineBreak":true},{"text":"a tò ma tidↄ̀ ma ibɛɛↄla.","poem":1}]}],"footnotes":[{"noteId":48,"caller":"+","text":"54.1-2 1Sam 23.19, 26.1","reference":{"chapter":54,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":8}