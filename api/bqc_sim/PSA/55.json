{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":55,"content":[{"type":"heading","content":["Wabikɛa Luawa kua ĩadama guu"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ. Wì sí ń kúuↄɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Lua, ma wabikɛama ma,","poem":1},{"lineBreak":true},{"text":"ńsu láka ma yã́ao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Swã́sɛ ma yã́i, ní wea,","poem":1},{"lineBreak":true},{"text":"ma làasoo lìaa ma gↄ̃ bíli guu,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ma ibɛɛↄ yã'oa ń gbɛ̃vãiↄ wɛbiiaao yã́i.","poem":1},{"lineBreak":true},{"text":"Asa aalɛ taasi daaɛ,","poem":1},{"lineBreak":true},{"text":"aa ma kũa ń kpɛ̃nɛo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sↄ̃ kɛ̃̀magu,","poem":1},{"lineBreak":true},{"text":"ga tòlobi zùmagu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Vĩa ma kũ ń lualuaao,","poem":1},{"lineBreak":true},{"text":"iwãa pãsĩ kà ma pↄa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tó má gã̀sĩa vĩ lán felenawa,","poem":1},{"lineBreak":true},{"text":"má vua gɛ́ kã́maboiɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Má bàalɛ gɛ́ zã̀zãɛ,","poem":1},{"lineBreak":true},{"text":"mí gɛ zↄ̃lɛ guwaiwaiu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Má wã gɛ ulɛkĩi wɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ zàa'ĩan gbãa su ma leo yã́i.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹ ń fu Dii, ǹ ń yã́ yãalɛnɛ́,","poem":1},{"lineBreak":true},{"text":"asa má è zↄa ń sòleo kú wá wɛ̃́lɛuɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aaì kpálɛkɛ bĩ́i musu fãanɛ ń gwãasĩnao,","poem":1},{"lineBreak":true},{"text":"yãvãi ń yã́ gbãao di wɛ̃́lɛpiuɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃dɛdɛa yã́ mɛ́ wɛ̃́lɛpi pà,","poem":1},{"lineBreak":true},{"text":"gbãamↄanɛ́ ń mↄafilio lí kɛ̃́lɛ a gãaɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tó ibɛɛ mɛ́ lɛ́ ma wɛ yãa, a sã̀ↄ,","poem":1},{"lineBreak":true},{"text":"tó ma wɛ̀lɛ mɛ́ fɛ̀lɛmanↄ, má ulɛɛ̀ɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"É'e mpi! N gbɛ̃́ pↄ́ wá sáa,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃do pↄ́ dɛ ma gbɛ̃na ũɛa?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wi faaibo ń kↄ̃o yãa nana,","poem":1},{"lineBreak":true},{"text":"wiↄ tɛkↄ̃i dasi guu Lua uaa?","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ga a zãmakɛ ma ibɛɛↄnɛ,","poem":1},{"lineBreak":true},{"text":"aai si bɛdau ń gbãagↄↄ,","poem":1},{"lineBreak":true},{"text":"asa vãi zↄ̃lɛkĩi è ń guuɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mapi sↄ̃ mi lɛzu Luazi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ Dii ì ma suaba.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kↄↄ, fãanɛ ń oosio","poem":1},{"lineBreak":true},{"text":"miↄ a yã'ↄ̃maↄ bↄlɛɛ̀ ń aauo,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì ma yãma.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Baa kɛ́ ma ibɛɛↄ dasi, aali ma leo,","poem":1},{"lineBreak":true},{"text":"Lua ì ma bↄ sòleu aafia.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Luapi ìↄ zↄ̃lɛa báawa gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"a ma yãma, i widamá.","poem":1},{"lineBreak":true},{"text":"Aali nↄ̀sɛlilɛo, aaliↄ aà vĩa vĩo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Gbɛ̃́pi ↄ wãa ń a gbɛ̃́ↄ,","poem":1},{"lineBreak":true},{"text":"à bↄ̀ lɛdoũ pↄ́ aa kɛ̀ ń kↄ̃o kpɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ì na o ń wáa lán zↄ́wa,","poem":1},{"lineBreak":true},{"text":"ãma sòle làasoo mɛ́ kú aà sↄ̃u.","poem":1},{"lineBreak":true},{"text":"Ì lɛnakasanɛ́ páipai,","poem":1},{"lineBreak":true},{"text":"ãma yaalↄma ba da bↄ̀ↄuɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ɔzↄ̃ Diiɛ n yã'ↄ̃maↄi, iↄ n kũa,","poem":1},{"noteId":49},{"lineBreak":true},{"text":"ìli tó gbɛ̃maa fù bauo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Gbɛ̃dɛna náaisaidepiↄ ń gↄↄ guo leo.","poem":1},{"lineBreak":true},{"text":"Lua, ńyↄ̃ to aa si bɛda gbã́ou.","poem":1},{"lineBreak":true},{"text":"Mapi sↄ̃ máↄ n náai vĩ.","poem":1}]}],"footnotes":[{"noteId":49,"caller":"+","text":"55.23 1Piɛ 5.7","reference":{"chapter":55,"verse":23}}]},"thisChapterLink":"/api/bqc_sim/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":24}