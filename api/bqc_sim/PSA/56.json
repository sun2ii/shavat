{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":56,"content":[{"type":"heading","content":["Zĩakpaa Luawa"]},{"type":"verse","number":1,"content":[{"text":"Lɛ pↄ́ Davidi dà gↄↄ pↄ́ Filitɛ̃ↄ aà kũ̀ Gata.","descriptive":true},{"noteId":50}]},{"type":"verse","number":2,"content":[{"text":"Ma wɛ̃nagwa Lua, wàlɛ pɛa,","poem":1},{"lineBreak":true},{"text":"wìↄ zĩkamanↄ wàↄ ĩadaa gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma kpàkpanapiↄ ìↄ pɛa gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"an wala yã́i aalɛ zĩkaimanↄ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó vĩa lɛ́ ma kṹ, má n náai vĩ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Má Lua táasilɛ yã́ pↄ́ a ò yã́i,","poem":1},{"lineBreak":true},{"text":"má Lua náai vĩ, má vĩakɛo.","poem":1},{"lineBreak":true},{"text":"Bↄ́ gbɛ̃nazĩna a fↄ̃ kɛmɛɛi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aaìↄ ma yã́ kpaanlabo gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"aaì vãi lɛkpaaĩmazi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aaì sòle da, aaì ulɛmɛɛ,","poem":1},{"lineBreak":true},{"text":"aaì ma kpákpa, aaìↄ ye ma dɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lua, ńsu to an gbɛ̃e bↄo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́piↄ nɛ ń pↄkũmao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ma bàalɛ̀ liaaliaaaↄ yãda,","poem":1},{"lineBreak":true},{"text":"ma wɛ́'ika n tùuna guu.","poem":1},{"lineBreak":true},{"text":"A ku n taala guuo lé?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó ma lɛzù Luazi,","poem":1},{"lineBreak":true},{"text":"ma ibɛɛↄ kpɛkpa,","poem":1},{"lineBreak":true},{"text":"míↄ dↄ̃ kɛ́ à yãsìmanↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má Lua táasilɛ yã́ pↄ́ a ò yã́i,","poem":1},{"lineBreak":true},{"text":"ao, má Dii táasilɛ yã́pi oa yã́i.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Má Lua náai vĩ, má vĩakɛo.","poem":1},{"lineBreak":true},{"text":"Bↄ́ gbɛ̃nazĩna a fↄ̃ kɛmɛɛi?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lua, má lɛ́ pↄ́ má kɛ̀maↄ fĩabo,","poem":1},{"lineBreak":true},{"text":"má sáaukpa sa'oma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Asa n ma si gawa,","poem":1},{"lineBreak":true},{"text":"n ma gbá vĩ̀ lí miↄn pãsĩa,","poem":1},{"lineBreak":true},{"text":"kɛ́ màↄ bɛnnↄ gupua pↄ́ ì wɛ̃ni kpámáu.","poem":1}]}],"footnotes":[{"noteId":50,"caller":"+","text":"56.1 1Sam 21.13-15","reference":{"chapter":56,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":14}