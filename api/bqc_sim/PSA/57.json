{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":57,"content":[{"type":"heading","content":["Wiilɛa Lua Musudewa"]},{"type":"verse","number":1,"content":[{"text":"Lɛ pↄ́ Davidi dà gↄↄ pↄ́ à bàalɛ̀ Sauluɛ à ùlɛ gbɛ̀'ɛu.","descriptive":true},{"noteId":51}]},{"type":"verse","number":2,"content":[{"text":"Wɛ̃nadↄ̃mɛɛ, Lua, wɛ̃nadↄ̃mɛɛ,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ mi nanzi.","poem":1},{"lineBreak":true},{"text":"Ma sↄlↄ n kúlukulunau","poem":1},{"lineBreak":true},{"text":"mi bↄ ga lɛ́zĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Málɛ wiilɛ Lua Musudewa,","poem":1},{"lineBreak":true},{"text":"Lua ì ma yã́ píi bↄↄlɛkɛmɛɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A to dↄnlɛ bↄ za musu à ma suaba,","poem":1},{"lineBreak":true},{"text":"a zↄadↄ gbɛ̃́ pↄ́ aalɛ pɛaↄwa.","poem":1},{"lineBreak":true},{"text":"A a gbɛ̃kɛ ń a náaiyão kɛmɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Má kú nↄ̀ↄmusuↄ sↄ̀ↄu,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ wúlɛa wàiↄ guu.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́piↄ lɛ́na na lán fɛ̃ndawa,","poem":1},{"lineBreak":true},{"text":"an swaa dɛ lán sↄ̃naↄ ge kaↄwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lua, ǹ ńzĩa tↄbↄ e a zↄ̃ma,","poem":1},{"lineBreak":true},{"text":"to n gawi li dṹniaa píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aa baikpàmɛɛ ma táa'ozɛu","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma gↄ̃ yeelɛa,","poem":1},{"lineBreak":true},{"text":"aa ɛyↄ̃̀ ma aɛ ↄ̃ aa zù ɛpiu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ma sↄ̃ dilɛa Lua, ma sↄ̃ dilɛa,","poem":1},{"lineBreak":true},{"text":"má lɛsi mà n táasilɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma nisĩna, su!","poem":1},{"lineBreak":true},{"text":"Ma mↄↄna ń ma domao, vu!","poem":1},{"lineBreak":true},{"text":"Mí gbãakpa gudↄazi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii, má n sáaukpa buiↄ guu,","poem":1},{"lineBreak":true},{"text":"má n táasilɛ gbɛ̃́ↄnɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Asa n gbɛ̃kɛ zↄ̃ↄ zↄ̃̀ma,","poem":1},{"lineBreak":true},{"text":"mɛ́ n náai zↄ̃̀ luabɛpuanawa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lua, ǹ nzĩa tↄbↄ e a zↄ̃ma,","poem":1},{"lineBreak":true},{"text":"to n gawi li dṹniaa píi.","poem":1},{"noteId":52}]}],"footnotes":[{"noteId":51,"caller":"+","text":"57.1 1Sam 22.1, 24.3","reference":{"chapter":57,"verse":1}},{"noteId":52,"caller":"+","text":"57.12 Soũ 108.2-6","reference":{"chapter":57,"verse":12}}]},"thisChapterLink":"/api/bqc_sim/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":12}