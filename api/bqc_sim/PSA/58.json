{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":58,"content":[{"type":"heading","content":["Gbɛ̃vãiↄ kaa Luawa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Gbãadeↄ, i yã'o a zɛ́waa?","poem":1},{"lineBreak":true},{"text":"I yã́kpalɛkɛ ń gbɛ̃́ↄ a zɛ́waa?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I yã́ kolea wàaipa á sↄ̃ guu,","poem":1},{"lineBreak":true},{"text":"i gbãamↄ gbɛ̃́ↄnɛ á bùsuu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gbɛ̃vãiↄ sã́sãa za ń igↄↄɛ,","poem":1},{"lineBreak":true},{"text":"ɛɛdeↄ ↄ̃̀ↄkpaa za ń da nↄ̀sɛuɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"An lɛgbɛ'i dɛ lán mlɛ̃̀ sɛwɛwa,","poem":1},{"lineBreak":true},{"text":"aa dɛ lán kyã́ pↄ́ a swã́ kàkawa,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"asa ìli a kↄ̃̀ↄ'ona kulɛ'ↄ mao,","poem":1},{"lineBreak":true},{"text":"ìli a wɛliaanɛde gↄ̃i eo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lua, ǹ ń swaa ɛ́'ɛnɛ́ ń lɛ́u,","poem":1},{"lineBreak":true},{"text":"Dii, nↄ̀ↄmusupiↄ kãnkãnaↄ wolo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"aai gɛ̃zɛa lán í bàalɛawa.","poem":1},{"lineBreak":true},{"text":"Tó aa sagòlɛ, ǹ ń kaↄ ɛ́'ɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aa giigaga zɛ́u lán kòlo lɛ́'iwa,","poem":1},{"lineBreak":true},{"text":"aaↄ dɛ lán nɛ́ pↄ́ wa ì gɛ̀, i ĩatɛ̃ eowa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"E lɛ̀ yàa miↄn tɛ́ àↄ gɛ́ oo wãi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãiↄ gɛ̃zɛa ń ĩ́anaoɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tó gbɛ̃maaↄ è Lua tↄsìnɛ́ gbɛ̃vãipiↄwa,","poem":1},{"lineBreak":true},{"text":"mɛ́ aa ń gbá pìpi ń ń auo,","poem":1},{"lineBreak":true},{"text":"an pↄ a kɛ na.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ↄ i mɛ: Gbɛ̃maaↄ ài vĩ fá!","poem":1},{"lineBreak":true},{"text":"Lua ku, ì yã́kpalɛkɛ dṹniau.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":12}