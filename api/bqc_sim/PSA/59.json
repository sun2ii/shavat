{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":59,"content":[{"type":"heading","content":["Ma si ma ibɛɛↄwa"]},{"type":"verse","number":1,"content":[{"text":"Lɛ pↄ́ Davidi dà gↄↄ pↄ́ Saulu gbɛ̃́ↄ zĩ̀ aa aà dã́dã aà bɛ aa aà dɛ.","descriptive":true},{"noteId":53}]},{"type":"verse","number":2,"content":[{"text":"Ma Lua, ma si ma ibɛɛↄwa,","poem":1},{"lineBreak":true},{"text":"ma bↄ gbɛ̃́ pↄ́ fɛ̀lɛmanↄↄ guu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma si vãikɛnaↄwa,","poem":1},{"lineBreak":true},{"text":"ma bↄ gbɛ̃dɛnaↄ ↄzĩ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gwa, aalɛ ma kpakpaɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pãsĩↄ lɛ́ sòlekɛmanↄ.","poem":1},{"lineBreak":true},{"text":"Dii, mi tàae ge duunakɛnɛ́o,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"mi zãnɛ́ yãewao,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa kú ń naaamanↄ sↄuo.","poem":1},{"lineBreak":true},{"text":"Ma wɛgwa! Fɛlɛ mↄ dↄmalɛ!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mpi Dii Lua Zĩgↄ̃de, Isailiↄ Lua,","poem":1},{"lineBreak":true},{"text":"fɛlɛ ĩada bui píiwa.","poem":1},{"lineBreak":true},{"text":"Ńsu bↄnkpɛde vãipiↄ wɛ̃nagwao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aaì ɛa su oosi lↄ, aaì wɛ̃́lɛ kɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"aaì hɛ̃̀ɛkɛa lán gbɛ̃ↄwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gwa, an lɛ́'i lɛ́ tↄ̃́,","poem":1},{"lineBreak":true},{"text":"fɛ̃na kpá ń lɛ́u.","poem":1},{"lineBreak":true},{"text":"Aaì mɛ ńlɛ ń yãmao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mpi sↄ̃ Dii, ni ń yáalↄ,","poem":1},{"lineBreak":true},{"text":"ni bui píi láanikɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lua ma gbãa, ma wɛ́ dↄnzi,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ń ma aafia'ekĩi ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lua a dↄaamɛɛ a gbɛ̃kɛ guu,","poem":1},{"lineBreak":true},{"text":"a to mà tidↄ ma wɛ̀lɛpiↄla.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dii wá sɛ̀ngbao, ńsu ǹ ń dɛdɛo,","poem":1},{"lineBreak":true},{"text":"kɛ́ an yã́ su sã ma gbɛ̃́ↄguo yã́i.","poem":1},{"lineBreak":true},{"text":"To aa olo'olobo,","poem":1},{"lineBreak":true},{"text":"ní ń kwɛ́ ń n gbãao.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yã́ pↄ́ ì bↄ ń lɛ́uá duunaɛ.","poem":1},{"lineBreak":true},{"text":"To an tòe ń pui,","poem":1},{"lineBreak":true},{"text":"asa aaì lɛgbɛ̃ pãɛ aaì gbɛ̃́ ká.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹ ń midɛ ń pↄkũmao,","poem":1},{"lineBreak":true},{"text":"ǹ ń bãdɛ, aasu wàↄ ku lↄo.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ kú e tↄↄlɛ lɛ́waↄ i dↄ̃","poem":1},{"lineBreak":true},{"text":"Lua mɛ́ lɛ́ kible Yakↄbu buiↄwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Aaì ɛa su oosi, aaì wɛ̃́lɛ kɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"aaì hɛ̃̀ɛkɛa lán gbɛ̃ↄwa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aaì liaaliaa wàↄ pↄblea wɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"tó aai kão, aaì gbokɛɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mapi sↄ̃ má lɛsi n gbãa yã́ musu,","poem":1},{"lineBreak":true},{"text":"má gulakɛ kↄↄ n gbɛ̃kɛ yã́ musu,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ ń ma aafia'ekĩi ũ,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ń ma ulɛkĩi ũ taasikɛgↄↄzĩ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lua ma gbãa, má n táasilɛ,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ ń ma aafia'ekĩi ũ,","poem":1},{"lineBreak":true},{"text":"ni gbɛ̃kɛkɛmɛɛ.","poem":1}]}],"footnotes":[{"noteId":53,"caller":"+","text":"59.1 1Sam 19.11","reference":{"chapter":59,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":18}