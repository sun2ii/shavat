{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":6,"content":[{"type":"heading","content":["Wiilɛa Luawa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ. Wì sí ń kúulɛaoɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dii, ńsu ma lele ń kpɛ̃nɛoo,","poem":1},{"lineBreak":true},{"text":"ńsu ma toto ń pↄkũmaoo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wɛ̃nadↄ̃mɛɛ Dii,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ déedeennↄɛ,","poem":1},{"lineBreak":true},{"text":"ma gbã́gbã Dii, asa ma wá lɛ́ wíɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma pↄ yà dúuduuɛ, Dii,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ dↄmalɛ bↄɛ ni?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɛa ǹ ma misi, Dii,","poem":1},{"lineBreak":true},{"text":"ma suaba n gbɛ̃kɛ yã́i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Asa gɛ lí e lɛmàma lↄo,","poem":1},{"lineBreak":true},{"text":"wìli n táasilɛ miauo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma wɛ̃nakɛ̀ ma kpasa,","poem":1},{"lineBreak":true},{"text":"ma mìbↄↄ ì gá ń wɛ́'io,","poem":1},{"lineBreak":true},{"text":"ma wúlɛkĩi ìↄ niɛɛ e gu gɛ dↄò.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma wɛ́ ìↄ bↄbↄ ń pↄsiao,","poem":1},{"lineBreak":true},{"text":"ìↄ wo, kɛ́ ma ibɛɛↄ dasi yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"À go ma kĩ́i vãikɛnaↄ,","poem":1},{"noteId":5},{"lineBreak":true},{"text":"asa Dii ma ↄↄlↄ mà.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii ma wiilɛa mà,","poem":1},{"lineBreak":true},{"text":"Dii ma wabikɛa sì.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wí a ma ibɛɛↄ kũ píi,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃ bíli guu,","poem":1},{"lineBreak":true},{"text":"aa fua kã́ndo, aai kpɛkpa.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"6.9 Mat 7.23, Luk 13.27","reference":{"chapter":6,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}