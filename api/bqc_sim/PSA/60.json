{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":60,"content":[{"type":"heading","content":["Wá zĩble ń Lua gbãao"]},{"type":"verse","number":1,"content":[{"text":"Lɛ pↄ́ Davidi dà gↄↄ pↄ́ à zĩkà ń Sili pↄ́ kú Mɛsↄpↄtami bùsuu ń Zoba bùsuuↄ, ↄ̃ Yoabu sù à Ɛdↄũↄ dɛ̀dɛ Guzulɛ Wisideu gbɛ̃ↄn ↄ̀aasↄsↄo lɛɛ kuɛpla (12.000).","descriptive":true},{"noteId":54}]},{"type":"verse","number":3,"content":[{"text":"Lua, n pↄ pàwázi,","poem":1},{"lineBreak":true},{"text":"n ↄpɛ̀wá n wá vũaa,","poem":1},{"lineBreak":true},{"text":"ɛa ↄkawázi sa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ń tò wá bùsu lùa e à pàa,","poem":1},{"lineBreak":true},{"text":"ɛa ǹ a gbɛ tata, asa à gↄ̃̀ looaɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ń tò n gbɛ̃́ↄ yã́ zĩ'ũ è,","poem":1},{"lineBreak":true},{"text":"n í gbãa kàkawɛ̃ɛ ↄ̃ wa pãpãzɛa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N dàlapoo dà n vĩakɛnaↄnɛ","poem":1},{"lineBreak":true},{"text":"kɛ́ aa e bↄ gbɛ̃́ↄ ka lɛ́zĩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wewá, wá suaba ń n gã̀sa gbãao,","poem":1},{"lineBreak":true},{"text":"kɛ́ wápiↄ n gbɛ̃́ yenzideↄ wá e bↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lua yã'ò za a kúkĩi à mɛ̀:","poem":1},{"lineBreak":true},{"text":"Má Sikɛũ kpaalɛ ń tidↄańlao,","poem":1},{"lineBreak":true},{"text":"mí Suko guzulɛ kpámá.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Galada bùsuá ma pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"Manase buiↄ bùsuá ma pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"Ɛflaiũ buiↄ bùsuá ma mↄ̀ fùaɛ,","poem":1},{"lineBreak":true},{"text":"Yuda bùsuá ma lípanaɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mↄabuↄ bùsuá ma zion zu'obↄɛ,","poem":1},{"lineBreak":true},{"text":"mi a kyale kálɛ Ɛdↄũↄ bùsuwa,","poem":1},{"lineBreak":true},{"text":"mi kúkua dↄ Filitɛ̃ↄ bùsuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Démɛ a gɛ̃manↄ wɛ̃́lɛ bĩ́ideui?","poem":1},{"lineBreak":true},{"text":"Démɛ a dↄaamɛɛ e Ɛdↄũↄ bùsuui?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lua, mɛ́ i kɛ n gbɛ̃́ pↄ́ n wá vũaa","poem":1},{"lineBreak":true},{"text":"nili bↄ ń wá zĩgↄ̃ↄ lↄo bàasio.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɔdawá wá ibɛɛↄ yã́ musu,","poem":1},{"lineBreak":true},{"text":"asa gbɛ̃nazĩna gbɛ̃suabaaá pãɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wá zĩble ń Lua gbãao,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ a ↄ̃zↄ̃ wá ibɛɛↄwa.","poem":1},{"noteId":55}]}],"footnotes":[{"noteId":54,"caller":"+","text":"60.1-2 2Sam 8.13","reference":{"chapter":60,"verse":1}},{"noteId":55,"caller":"+","text":"60.14 Soũ 108.7-14","reference":{"chapter":60,"verse":14}}]},"thisChapterLink":"/api/bqc_sim/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":13}