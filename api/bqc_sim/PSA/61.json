{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":61,"content":[{"type":"heading","content":["Kía wabikɛa Luawa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Lua, swã́sɛ ma wiilɛai,","poem":1},{"lineBreak":true},{"text":"laaidↄ ma wabikɛawa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kua za tↄↄlɛ lɛ́wa ma lɛzùnzi.","poem":1},{"lineBreak":true},{"text":"Ma sↄ̃ lɛ́ wo ↄ̃ ma n sisi.","poem":1},{"lineBreak":true},{"text":"Gɛmanↄ gbɛsi pↄ́ a lɛsĩ dɛmala kĩ́i.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asa ḿmɛ ń ma aafia'ekĩi ũ,","poem":1},{"lineBreak":true},{"text":"ma kalanga gbãa ũ ma ibɛɛↄ aɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Má ye màↄ ku n ua gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"míↄ sↄlↄa n kúlukulunau.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lua, asa n ma lɛgbɛ̃anɛ mà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n gba pↄ́ ni da n vĩakɛnaↄnɛ dàmɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kía wɛ̃ni dↄɛ̀ ń mↄgalao,","poem":1},{"lineBreak":true},{"text":"to aà ka a gↄↄwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aàↄ kpalable n dↄ̃a guu gↄↄpii,","poem":1},{"lineBreak":true},{"text":"ǹ aà dↄ̃́a n gbɛ̃kɛ ń n náaio yã́i,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"míↄ n táasilɛ lá gu lɛ́ dↄ,","poem":1},{"lineBreak":true},{"text":"míↄ lɛ́ pↄ́ má kɛ̀ma fĩabo gↄↄpii.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}