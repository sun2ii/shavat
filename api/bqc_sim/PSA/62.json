{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":62,"content":[{"type":"heading","content":["Lua mɛ́ ulɛkĩi ũ"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Lua ado mɛ́ tò ma sↄ̃ dilɛa,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ ì ma suaba.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɔ̃mɛ ma gbɛsi ũ, ma Suabana ũ.","poem":1},{"lineBreak":true},{"text":"Mi gbãa'ewà, má fu bauo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gɛ̃n ũma áↄ ãna'ãna gbɛ̃́wai?","poem":1},{"lineBreak":true},{"text":"Á aà nɛ lán gĩ̀ yɛɛlɛa ge kaa ziwa yã̀?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aà goa a tía lɛ́ ↄ̃ álɛ kpaaĩ,","poem":1},{"lineBreak":true},{"text":"ɛɛtoa mɛ́ ì kɛɛ́ na.","poem":1},{"lineBreak":true},{"text":"I samaa'o gbɛ̃́ɛ ń lɛ́oɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ i ń ká á sↄ̃ guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lua ado mɛ́ tò ma sↄ̃ dilɛa,","poem":1},{"lineBreak":true},{"text":"asa aàpi ma wɛ́ dↄi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɔ̃mɛ ma gbɛsi ũ, ma Suabana ũ.","poem":1},{"lineBreak":true},{"text":"Mi gbãa'ewà, má fu bauo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma aafia ń ma bɛɛɛo ì bↄ aà kĩ́iɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ ma gbɛsi gbãa ũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ ma ulɛkĩi ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ↄ, àↄ aà náai vĩ gↄↄpii,","poem":1},{"lineBreak":true},{"text":"à á sↄ̃ wɛ̃ɛ̀, ↄ̃mɛ wá ulɛkĩi ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gbɛ̃nazĩnaↄ dɛ lán lɛ́'ĩanawaɛ,","poem":1},{"lineBreak":true},{"text":"an kee náai vĩo.","poem":1},{"lineBreak":true},{"text":"Tó wà ń yↄ̃́ kiloowa,","poem":1},{"lineBreak":true},{"text":"ampii aaↄ dɛ fauunnↄɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ásu gbɛ̃ble'ↄ̃a náaikɛo,","poem":1},{"lineBreak":true},{"text":"ásu ĩ́anadã ń kpã́i pↄ́oo.","poem":1},{"lineBreak":true},{"text":"Tó á àizɛɛ lɛ́ kↄ̃́,","poem":1},{"lineBreak":true},{"text":"ásu to à á sↄ̃ bleo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yã́ mɛ̀ndo Lua ò,","poem":1},{"lineBreak":true},{"text":"yã́ mɛ̀n plaɛ beeↄ má mà:","poem":1},{"lineBreak":true},{"text":"Lua mɛ́ gbãa vĩ,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"mɛ́ mpi Dii, ḿmɛ ń gbɛ̃kɛ vĩ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ni fĩaboò baadeɛ a yãkɛawa.","poem":1},{"noteId":56}]}],"footnotes":[{"noteId":56,"caller":"+","text":"62.13 Mat 16.27, Lom 2.6, Zia 2.23","reference":{"chapter":62,"verse":13}}]},"thisChapterLink":"/api/bqc_sim/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":13}