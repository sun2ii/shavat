{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":63,"content":[{"type":"heading","content":["Lua nidɛa"]},{"type":"verse","number":1,"content":[{"text":"Lɛ pↄ́ Davidi dà gↄↄ pↄ́ a ku Yuda gbáau.","descriptive":true},{"noteId":57}]},{"type":"verse","number":2,"content":[{"text":"Lua, ma Luan n ũ,","poem":1},{"lineBreak":true},{"text":"málɛ n aɛya,","poem":1},{"lineBreak":true},{"text":"ma nisĩna yenzi,","poem":1},{"lineBreak":true},{"text":"málɛ n nidɛ","poem":1},{"lineBreak":true},{"text":"lán guwaiwai pↄ́ lɛ́ í nidɛwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma n e n kúkĩi,","poem":1},{"lineBreak":true},{"text":"ma n gbãa ń n gawio gwà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N gbɛ̃kɛ maamɛɛ dɛ wɛ̃nia,","poem":1},{"lineBreak":true},{"text":"a yã́i n táasilɛa aↄ dↄ ma lɛ́u.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Máↄ n sáaukpa e ma wɛ̃ni lɛ́u,","poem":1},{"lineBreak":true},{"text":"má ↄsɛ musu mà n sísi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Má kã́ lá wì nↄ̀ↄ bↄ́ↄ gbɛ̃ wà kãwa,","poem":1},{"lineBreak":true},{"text":"n táasilɛa aↄ dↄ ma lɛ́u ń gulakɛao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N yã́ ì dↄmagu ma wúlɛkĩi,","poem":1},{"lineBreak":true},{"text":"mi làasookɛma gwãasĩna.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Málɛ lɛsi sↄlↄa ń kúlukulunau,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ ń ma dↄnlɛde ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma nisĩna yenzi,","poem":1},{"lineBreak":true},{"text":"ń ma kũa n ↄplaau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gbɛ̃́ pↄ́ aalɛ ma wɛↄ midɛ,","poem":1},{"lineBreak":true},{"text":"aa si tↄↄlɛ nↄnau.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lua a to wà ń dɛdɛ ń fɛ̃ndaoɛ,","poem":1},{"lineBreak":true},{"text":"aai gↄ̃ gbɛ̃gbonaↄ blɛ ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kí sↄ̃ a pↄ a kɛ ń Luawa nao.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ mɛ̀ amↄↄma Lua á sìò","poem":1},{"lineBreak":true},{"text":"aↄ vĩvĩ ń pↄnaoɛ,","poem":1},{"lineBreak":true},{"text":"ɛɛdeↄ sↄ̃ an lɛ́ a gↄ̃ kpaaũaɛ.","poem":1}]}],"footnotes":[{"noteId":57,"caller":"+","text":"63.1 1Sam 23.14","reference":{"chapter":63,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":12}