{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":64,"content":[{"type":"heading","content":["Ma si gbɛ̃vãiↄwa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Lua, ma aaukɛa wii ma,","poem":1},{"lineBreak":true},{"text":"ma bↄ ma ibɛɛ pↄ́ má ń vĩa vĩↄ ↄzĩ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma si gbɛ̃vãiↄ lɛkpaaĩamaziwa,","poem":1},{"lineBreak":true},{"text":"ma bↄ vãikɛnaↄ zↄau.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aaì ń lɛ́ kɛkɛ lán fɛ̃ndawa,","poem":1},{"lineBreak":true},{"text":"aaì yãpãsĩↄ o lán kazuawa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aaì ye láu aa tàaesaide gbã́,","poem":1},{"lineBreak":true},{"text":"aaì aà pá kã́ndo, vĩa lí ń kũo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aaì tɛ́kpakↄ̃u ń vãikɛa guu,","poem":1},{"lineBreak":true},{"text":"aaì bai pↄ́ aalɛ kpánɛ́ↄ yã'o.","poem":1},{"lineBreak":true},{"text":"Aaì mɛ: Gbɛ̃e a wá eo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"An vãi lɛkpaaĩa kↄ̃sɛ̀ aa mɛ̀,","poem":1},{"lineBreak":true},{"text":"lɛ́ pↄ́ wá kpàaĩ bↄ̀lɛi.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃nazĩna nↄ̀sɛ guu yã́ↄ asii zↄ̃ↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ãma Lua a ń gbã́ ń kao,","poem":1},{"lineBreak":true},{"text":"a ń kɛ'ĩa kã́ndo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A tó yã́ pↄ́ aa ò wí ń musu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ń é píi iↄ mikɛ déũdeũ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Vĩa a gbɛ̃́pii kṹ,","poem":1},{"lineBreak":true},{"text":"aai Lua yãkɛaↄ galikɛ,","poem":1},{"lineBreak":true},{"text":"aaiↄ zĩ pↄ́ a kɛ̀ↄ tàasi kũa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ pↄ a kɛ Diiwa na,","poem":1},{"lineBreak":true},{"text":"aa naaàzi,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuadeↄ aà táasilɛ ḿpii.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}