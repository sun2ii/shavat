{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":65,"content":[{"type":"heading","content":["Bui píi wɛ́ dↄ Luazi"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Lua, à kũ̀ wà n táasilɛ Siↄnaɛ,","poem":1},{"lineBreak":true},{"text":"wi lɛ́ pↄ́ wa kɛ̀maↄ fĩabo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lá ni gbɛ̃́ wabikɛa ma,","poem":1},{"lineBreak":true},{"text":"bui píi a wi danlaɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wá yãvãiↄ làasoo wá kṹ gbãa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n wá tàaeↄ kɛ̃̀wá.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Báaaden gbɛ̃́ pↄ́ ń sɛ̀","poem":1},{"lineBreak":true},{"text":"n gɛ̃aànↄ n ua ũ.","poem":1},{"lineBreak":true},{"text":"N kpɛ́ pↄmaaↄ wá kã́,","poem":1},{"lineBreak":true},{"text":"n kpɛ́ pↄ́ a kua adoapi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ni wewá a zɛ́wa ń yãbↄnsaɛkɛao,","poem":1},{"lineBreak":true},{"text":"Lua wá Suabana.","poem":1},{"lineBreak":true},{"text":"Za dṹnia lɛ́wa ń ísia baaleo","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ↄ wɛ́ dↄnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ń gbãa daa ula ũ,","poem":1},{"lineBreak":true},{"text":"n gbɛ̀sĩsĩↄ kɛ̀ ń n ikoo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ni ísia ń a ísↄ̃ↄ kↄ̃fĩo kpálɛ,","poem":1},{"lineBreak":true},{"text":"ni buipãleↄ zↄa midɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N dabudabukɛa dì gbɛ̃́ pↄ́ kú tↄↄlɛ lɛ́ↄwa,","poem":1},{"lineBreak":true},{"text":"wì guladↄma za ĩatɛ̃bilɛkĩi ń a gɛ̃kpɛukĩio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ni laaidↄ dṹniawa,","poem":1},{"lineBreak":true},{"text":"ni táaekɛ tↄↄlɛɛ.","poem":1},{"lineBreak":true},{"text":"Ni aà gba í, n swaↄ pai ń ío,","poem":1},{"lineBreak":true},{"text":"ni to blɛwɛna kɛ, asa màa n zɛò.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ni idagua e bugbaanaↄ pa,","poem":1},{"lineBreak":true},{"text":"ni guↄ foofↄ̃ ń louo,","poem":1},{"lineBreak":true},{"text":"ni báaada pↄ́ pↄ́ bↄ̀lɛu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ni ɛ̀fãaida buazĩu wɛ̃ ń wɛ̃o,","poem":1},{"lineBreak":true},{"text":"blɛ níside ì kwɛ n iau.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sɛ̃sao dã́dãkɛkĩiↄ sɛ̃̀bↄlↄ kɛ̀,","poem":1},{"lineBreak":true},{"text":"sĩ̀sĩↄ pↄna ula dà.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pↄtuoↄ lì dã́dãkɛkĩiↄla,","poem":1},{"lineBreak":true},{"text":"blɛwɛna daa gua sĩ̀sĩpↄlɛu.","poem":1},{"lineBreak":true},{"text":"Wàlɛ wiilɛ ń pↄnao, wàlɛ lɛsi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":14}