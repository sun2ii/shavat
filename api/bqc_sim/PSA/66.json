{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":66,"content":[{"type":"heading","content":["Lua sáaukpaa"]},{"type":"verse","number":1,"content":[{"text":"Dṹnia gbɛ̃́pii, à guladↄ Diiwa,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"à lɛsi aà tↄ́ gawi yã́ musu,","poem":1},{"lineBreak":true},{"text":"à aà táasilɛ à aà tↄbↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À o Luaɛ: N yãkɛaↄ ì dimá,","poem":1},{"lineBreak":true},{"text":"n gbãa zↄ̃ↄ ì to n ibɛɛↄ vlãnau.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dṹnia gbɛ̃́pii ì kúlɛnɛ,","poem":1},{"lineBreak":true},{"text":"aaì n táasilɛ aa n tↄbↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"À mↄ Lua yãkɛaↄ gwa,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ a kɛ̀ gbɛ̃nazĩnaↄnɛ i diwá.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À ísia lì gugii ũ","poem":1},{"noteId":58},{"lineBreak":true},{"text":"aa bùa swawa kɛ̀sɛ.","poem":1},{"noteId":59},{"lineBreak":true},{"text":"Wà pↄnakɛ aà yã́ musu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ìↄ kible ń a gbãao gↄↄpii,","poem":1},{"lineBreak":true},{"text":"aà wɛ́ ìↄ ku bui píiwa.","poem":1},{"lineBreak":true},{"text":"Swã́gbãadeↄ su dↄ́ɛaànↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Buipãleↄ, à wá Lua sáaukpa,","poem":1},{"lineBreak":true},{"text":"aà táasilɛa àↄ dↄ á lɛ́u.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ìↄ wá wɛ̃ni dↄ̃́awɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"ìli tó wa kpaguao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lua, asa n wá yↄ̃́,","poem":1},{"lineBreak":true},{"text":"n wá baasa lán ã́nusuwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N gɛwanↄ gukpaoloonau,","poem":1},{"lineBreak":true},{"text":"n wá wó wì ń aso gbiao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ń tò wà ↄzↄ̃̀zↄ̃ wá mikpɛi,","poem":1},{"lineBreak":true},{"text":"wà tɛ́ dìwɛ̃ɛ, í wá kṹ wá nↄɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n mↄwanↄ gu namadeɛ beeu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Má mↄ́ n ua ń sa pↄ́ wì a pↄ́ kátɛu à tɛ́kũ obↄo,","poem":1},{"lineBreak":true},{"text":"má lɛ́ pↄ́ má kɛ̀maↄ fĩabo,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"yã́ pↄ́ bↄ̀ ma lɛ́u ma taasikɛgↄↄ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Má sa'oma ń pↄ́ mɛkpaaↄ,","poem":1},{"lineBreak":true},{"text":"má sãsakaoↄ kpasanɛ,","poem":1},{"lineBreak":true},{"text":"mí n gbagba ń zuswanaↄ ń blesanaↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Á gbɛ̃́ pↄ́ á Lua vĩa vĩↄ, à mↄ ma,","poem":1},{"lineBreak":true},{"text":"mí yã́ pↄ́ a kɛ̀mɛɛ oɛ́.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma wiilɛ̀wà,","poem":1},{"lineBreak":true},{"text":"aà táasilɛa dↄ ma lɛ́u.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó má yãvãi kũa ma sↄ̃u,","poem":1},{"lineBreak":true},{"text":"dↄ̃ Dii gì ma yãmai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ãma à ma yãmà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ma wabikɛa sì.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Má Lua sáaukpa,","poem":1},{"lineBreak":true},{"text":"i gí ma wabikɛa maio,","poem":1},{"lineBreak":true},{"text":"i gí gbɛ̃kɛkɛimɛɛo.","poem":1}]}],"footnotes":[{"noteId":58,"caller":"+","text":"66.6 Bↄa 14.21","reference":{"chapter":66,"verse":6}},{"noteId":59,"caller":"+","text":"66.6 Yoz 3.14-17","reference":{"chapter":66,"verse":6}}]},"thisChapterLink":"/api/bqc_sim/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}