{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":68,"content":[{"type":"heading","content":["Lua zↄ̃ↄkɛ"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Lua lɛ́ fɛlɛ, aà ibɛɛↄ lɛ́ fãaa,","poem":1},{"lineBreak":true},{"text":"aà zangudeↄ lɛ́ bàalɛɛ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lá súɛlɛ ì gɛ̃ ń ĩ́anao,","poem":1},{"lineBreak":true},{"text":"kɛnɛ́ màa, Lua,","poem":1},{"lineBreak":true},{"text":"lá zↄ́ nísi ì yↄ tɛ́ saɛ,","poem":1},{"lineBreak":true},{"text":"vãikɛnaↄ midɛ n aɛ màa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ sↄ̃ aa pↄnakɛ,","poem":1},{"lineBreak":true},{"text":"aa yáalↄ Lua aɛ,","poem":1},{"lineBreak":true},{"text":"aa vĩvĩ ń pↄna zↄ̃ↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"À lɛsi Luaɛ à lɛ́mawà.","poem":1},{"lineBreak":true},{"text":"A di luabɛpuana kpɛ, à aà tↄbↄ.","poem":1},{"lineBreak":true},{"text":"Aà tↄ́n Dii, à kúkuakɛ aà aɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kua aà gu pↄ́ a kua adoa guu,","poem":1},{"lineBreak":true},{"text":"Luaá tonɛↄ maeɛ,","poem":1},{"lineBreak":true},{"text":"gyaaↄ zɛnnↄdeɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lua ì bɛkpa zĩ̀loↄnɛ,","poem":1},{"lineBreak":true},{"text":"ì zĩ̀zↄↄ bↄlɛ à ń da namau.","poem":1},{"lineBreak":true},{"text":"Swã́gbãadeↄ sↄ̃ aaↄ ku gugiiuɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lua, kɛ́ n dↄaa n gbɛ̃́ↄnɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ n bɛɛlɛńnↄ guwaiwaiu,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"tↄↄlɛ lùalua, lou kwɛ̀ n aɛ,","poem":1},{"lineBreak":true},{"text":"n Lua pↄ́ n yã'ò Sinai gbɛ musu,","poem":1},{"noteId":60},{"lineBreak":true},{"text":"Lua, Isailiↄ Lua.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lua, n ɛ̀fãai pìsinɛ́ kↄ̃sↄ̃kↄ̃sↄ̃,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n ń bùsu kpɛɛna gbà gbãa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N gbɛ̃́ↄ zↄ̃̀lɛ a guu Lua,","poem":1},{"lineBreak":true},{"text":"n wɛ̃nadeↄ gbà pↄ́ n maakɛa yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dii yã'ò,","poem":1},{"lineBreak":true},{"text":"ↄ̃ bíla gↄ̃̀ aà baokpanaↄ ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kíaↄ ń ń zĩgↄ̃ↄ lɛ́ tílɛ kpakpa,","poem":1},{"lineBreak":true},{"text":"gↄ̃ɛ pↄ́ gↄ̃̀ bòouↄ lɛ́ ń pↄ́ↄ kpaalɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Baa kɛ́ a i sã kaaↄ sↄ̀ↄu,","poem":1},{"lineBreak":true},{"text":"ã́nusu kú ma felena gã̀sĩaa,","poem":1},{"lineBreak":true},{"text":"a kã́ↄ lɛ́ tɛkɛ lán vuawa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kɛ́ Gbãapiide kíaↄ fã̀aa,","poem":1},{"lineBreak":true},{"text":"aa lì tↄↄlɛa lán Zalamↄ gbɛ̀ nɛɛziwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Basana gbɛ̀sĩsĩ dɛ a kĩniↄla,","poem":1},{"lineBreak":true},{"text":"Basana gbɛ̀sĩsĩ misonaↄ dasi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Á gbɛ̀ misonaↄ, bↄ́yãi álɛ wɛbii","poem":1},{"lineBreak":true},{"text":"gbɛ pↄ́ Lua sɛ̀ a kiblekĩi ũwai?","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ aↄ ku we gↄↄpii.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dii sↄ̃́goↄ lɛ́ vĩo, à kà miliↄ̃ do.","poem":1},{"lineBreak":true},{"text":"Dii bↄ̀ò za Sinai,","poem":1},{"lineBreak":true},{"text":"à mↄ̀ pìla a gu pↄ́ a kua adoau.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N dɛdɛ musu ń zĩ̀zↄↄ,","poem":1},{"noteId":61},{"lineBreak":true},{"text":"n gba sì gbɛ̃́ↄwa falu ũ,","poem":1},{"lineBreak":true},{"text":"baa swã́gbãadeↄ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ n zↄ̃lɛ we, Dii Lua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wà Dii sáaukpa, Lua wá Suabana,","poem":1},{"lineBreak":true},{"text":"ìↄ wá aso kũawɛ̃ɛ lá gu lɛ́ dↄɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wá Luaá Lua pↄ́ ì gbɛ̃́ suabaɛ,","poem":1},{"lineBreak":true},{"text":"Dii Lua mɛ́ ì wá bↄ ga lɛ́zĩ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lua a a ibɛɛↄ mi wíwinɛ́,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩn mikã dↄ̀ɛ pↄ́ aa tɛ́ ń duunawaↄ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dii mɛ̀: Má á bↄlɛ Basana bùsuu,","poem":1},{"lineBreak":true},{"text":"má á bↄlɛ ísia títiu,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"kɛ́ à á gbáↄ pípi ń á ibɛɛↄ auo,","poem":1},{"lineBreak":true},{"text":"á gbɛ̃ↄ lɛ́naↄ i ń baa ewà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Lua, wa n gbɛ̃́ↄ è aa dↄ̀dↄkↄ̃wa,","poem":1},{"lineBreak":true},{"text":"ma Lua ma Kía, aalɛ mↄ́ n kúkĩi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Lɛ̀sinaↄ dↄaaa, pↄlɛnaↄ tɛ zã́,","poem":1},{"lineBreak":true},{"text":"wɛ̃́ndia sɛ̃́sɛ̃mpanaↄ ku guo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"À Lua tↄbↄ balu guu,","poem":1},{"lineBreak":true},{"text":"à Dii kpɛla Isailiↄ kↄ̃kãaau.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nɛ́ gↄ̃zãna Bɛ̃yãmɛɛ buiↄ mɛ́ dↄaaa,","poem":1},{"lineBreak":true},{"text":"bee gbɛa Yuda kíaↄ ń ń gbɛ̃́ↄ","poem":1},{"lineBreak":true},{"text":"ń Zabulↄni bui kíaↄ ń Nɛfatali bui kíaↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Á Lua dìlɛɛ́ àↄ gbãa.","poem":1},{"lineBreak":true},{"text":"Lua, bↄ ń n gbãa pↄ́ ń ↄ̀lↄwɛ̃ɛo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Kíaↄ mↄnɛ ń ń gbaↄ","poem":1},{"lineBreak":true},{"text":"n kpɛ́ pↄ́ kú Yelusalɛũ yã́i.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Zↄa dↄ ílɛnↄbↄ Egipiwa,","poem":1},{"lineBreak":true},{"text":"zↄadↄ buiↄ swanaↄ ń ń gbɛ̃́ↄwa.","poem":1},{"lineBreak":true},{"text":"Ãnusu gopana tↄ̃́má,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ zĩkaa ì kɛnɛ́ naↄ fãaa.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Egipiↄ gbɛ̃́ↄ zĩma,","poem":1},{"lineBreak":true},{"text":"Etiopiↄ wã aa ↄdↄnzi, Lua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Dṹnia kpalablenaↄ, à lɛsi Luaɛ,","poem":1},{"lineBreak":true},{"text":"à Dii táasilɛ.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"A di lounaa kpɛ musumusu za zizi,","poem":1},{"lineBreak":true},{"text":"à ma, àlɛ pũna gbã́ugbãu.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"À Lua gbãa galikɛ,","poem":1},{"lineBreak":true},{"text":"wa aà zↄ̃ↄkɛ dↄ̃ Isailiↄwa,","poem":1},{"lineBreak":true},{"text":"aà gbãa ku luabɛpuanau.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Lua, kua n kúkĩi ń zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"Isailiↄ Lua ì gbãa ń ikoo kpa a gbɛ̃́ↄwa.","poem":1},{"lineBreak":true},{"text":"Wà Lua sáaukpa!","poem":1}]}],"footnotes":[{"noteId":60,"caller":"+","text":"68.9 Bↄa 19.18","reference":{"chapter":68,"verse":9}},{"noteId":61,"caller":"+","text":"68.19 Ɛfɛ 4.8","reference":{"chapter":68,"verse":19}}]},"thisChapterLink":"/api/bqc_sim/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":36}