{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":69,"content":[{"type":"heading","content":["Wabikɛa Luawa kua ĩadama guu"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Lua, ma suaba,","poem":1},{"lineBreak":true},{"text":"asa í ma kũ ma nↄɛɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dɛɛ lɛ́ ma mↄ́, ma ka zã̀,","poem":1},{"lineBreak":true},{"text":"tepɛkĩi kuo.","poem":1},{"lineBreak":true},{"text":"Ma kpalɛ ísiu,","poem":1},{"lineBreak":true},{"text":"ísↄ̃ lɛ́ damala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma wiilɛ̀ ma kpasa,","poem":1},{"lineBreak":true},{"text":"ma kòlo nàaa,","poem":1},{"lineBreak":true},{"text":"ma wɛdↄ̀ ma Luazi","poem":1},{"lineBreak":true},{"text":"e ma wɛ́ gɛ̀ lɛ́ wo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ aa zamagu pãↄ","poem":1},{"noteId":62},{"text":"dasi dɛ ma mikãa,","poem":1},{"lineBreak":true},{"text":"ma ibɛɛ pↄ́ aa ye ma dɛ pↄewiwinɛ́saiↄ lɛ́ vĩo.","poem":1},{"lineBreak":true},{"text":"Pↄ́ pↄ́ mi a kpã́i'oo ↄ̃ aa mɛ̀ mà a nɛ'i mà kpá.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lua, ń ma mìsaiyãↄ dↄ̃,","poem":1},{"lineBreak":true},{"text":"ma tàaeↄ ulɛanɛo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii Lua Zĩgↄ̃de, gbɛ̃́ pↄ́ an wɛ́ dↄnziↄ","poem":1},{"lineBreak":true},{"text":"ńsu to wí ń kṹ ma yã́io.","poem":1},{"lineBreak":true},{"text":"Isailiↄ Lua, gbɛ̃́ pↄ́ aaì n kĩ́i wɛɛlɛↄ","poem":1},{"lineBreak":true},{"text":"ńsu to an tↄ́ ↄ̃̀ↄkpa ma yã́io.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa n yã́i mi sↄ̃́sↄ̃a fↄ̃i,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma gɛɛ gↄ̃̀ kpa ma wɛ́i.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma gↄ̃ zĩ̀lo ũ ma gbɛ̃́ↄ guu,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ gbɛ̃ando ũ ma da bɛdeↄ guu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N kpɛ́ yã́ ma kũ gbãa,","poem":1},{"lineBreak":true},{"text":"àlɛ ma ibaba,","poem":1},{"noteId":63},{"lineBreak":true},{"text":"n sↄ̃̀sↄ̃naↄ n sↄ̃́sↄ̃a gↄ̃̀mɛɛ.","poem":1},{"noteId":64}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mi lɛye pↄsia guu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wìↄ ma sↄ̃sↄ̃.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mi zwã̀nkasaↄ fĩfĩa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ wìↄ ma kɛ pↄ́ↄpↄↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ zↄ̃lɛ gãaɛↄ ì ma pe,","poem":1},{"lineBreak":true},{"text":"ígbãaminaↄ ì lɛdamanↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dii, málɛ wabikɛma,","poem":1},{"lineBreak":true},{"text":"ńsu to à bↄ n pↄ kpɛo,","poem":1},{"lineBreak":true},{"text":"wea Lua, n gbɛ̃kɛ zↄ̃ↄ yã́i,","poem":1},{"lineBreak":true},{"text":"ní ma suaba sĩana.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma bↄ bɛ̀lɛu,","poem":1},{"lineBreak":true},{"text":"ńsu to mà kpálɛuo.","poem":1},{"lineBreak":true},{"text":"Ma bↄ ísiu,","poem":1},{"lineBreak":true},{"text":"ma si ma zangudeↄwa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ńsu to ísↄ̃ damalao,","poem":1},{"lineBreak":true},{"text":"ńsu to mà kpálɛ ísiuo,","poem":1},{"lineBreak":true},{"text":"ńsu to wà tɛ̃́ɛna kamalao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wea Dii, asa n gbɛ̃kɛ maa,","poem":1},{"lineBreak":true},{"text":"ma wɛgwa n sùuu zↄ̃ↄ guu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ńsu mikpɛli n zↄ̀blenaɛo,","poem":1},{"lineBreak":true},{"text":"wea kpakpa, asa ma gↄ̃ yeelɛaɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sↄ̃mazi, ma misi,","poem":1},{"lineBreak":true},{"text":"ma suaba ma ibɛɛↄ yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ń ma sↄ̃́sↄ̃a ń widaaao ń ma kpɛbↄao dↄ̃,","poem":1},{"lineBreak":true},{"text":"ńlɛ gbɛ̃́ pↄ́ aa yã́kũamanↄↄ e.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sↄ̃́sↄ̃a ma sↄ̃ zↄ̃̀, ma gↄ̃ yɛ̃̀ɛɛsai,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ a ma wɛgwa ↄ̃ má wɛ̀ɛlɛ, mi eo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ a ma nↄ̀sɛ nínimɛɛ ↄ̃ ma wɛdↄ̀i, a kuo.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aa ɛsɛ vãi kàmɛɛ blɛu,","poem":1},{"lineBreak":true},{"text":"kɛ́ imi ma kũ gbãa, aa vɛ̃ɛ kũ̀ma kpàa.","poem":1},{"noteId":65}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"To an dikpɛkɛa gↄ̃nɛ́ bai ũ, wà ń kṹ,","poem":1},{"lineBreak":true},{"text":"to an kua aafia yã'inɛ́.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"To an wɛ́ siakũ, kɛ́ aasu gu'eo,","poem":1},{"lineBreak":true},{"text":"to an wó gↄ̃ koolonnↄ gↄↄpii.","poem":1},{"noteId":66}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ǹ n kpɛ̃nɛmuu bↄbↄmá,","poem":1},{"lineBreak":true},{"text":"ǹ n pↄkũma pãsĩ pisimá.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"An bòo gↄ̃ bòo zia ũ,","poem":1},{"lineBreak":true},{"text":"an gbɛ̃e su àↄ ku kɛ́ à zↄ̃lɛ ń kpɛ́u lↄo,","poem":1},{"noteId":67}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"asa aaì ĩada gbɛ̃́ pↄ́ ń gbɛ̃̀waɛ,","poem":1},{"lineBreak":true},{"text":"aaì gbɛ̃́ pↄ́ ń zↄ̃̀ wãwã galikɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ǹ ń yã́ píi tàaeↄ dańla,","poem":1},{"lineBreak":true},{"text":"an baa su àↄ ku n gbɛ̃suabaa guuo.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ǹ ń tↄ́ waa wɛ̃ni taala guu,","poem":1},{"noteId":68},{"lineBreak":true},{"text":"an tↄ́ su àↄ ku lá doũ guu ń gbɛ̃maaↄ tↄ́oo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Lua, má kú taasi ń yã'ↄ̃mao guu,","poem":1},{"lineBreak":true},{"text":"ma sɛ lɛsĩ mà bↄu aafia.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Má Lua tↄbↄ lɛsia guu,","poem":1},{"lineBreak":true},{"text":"má aà sáaukpa mà aà kã́fĩ.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Bee a ka Diigu dɛ sa'oa ń zuoa,","poem":1},{"lineBreak":true},{"text":"a kɛɛ̀ na dɛ zugaaena kↄ́badea.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Taasideↄ e, aai pↄnakɛ,","poem":1},{"lineBreak":true},{"text":"á luakĩiwɛɛlɛnaↄ á sↄ̃ i níni.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Asa Dii ì wɛ̃nadeↄ yãma,","poem":1},{"lineBreak":true},{"text":"ìli saka a gbɛ̃́ pↄ́ dɛ zĩ̀zↄ ũↄguo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"À aà táasilɛ musu ń tↄↄlɛo,","poem":1},{"lineBreak":true},{"text":"ísia ń pↄ́ pↄ́ kú a guuↄ píi.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Asa Lua a Siↄna suaba,","poem":1},{"lineBreak":true},{"text":"a ɛa Yuda wɛ̃́lɛↄ kálɛ,","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃́ↄ i zↄ̃lɛu ń pↄ́ ũ.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Aà zↄ̀blenaↄ nɛ́ↄ mɛ́ aa gↄ̃ vĩ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ye aà tↄ́ naipiↄ iↄ ku a guu.","poem":1}]}],"footnotes":[{"noteId":62,"caller":"+","text":"69.5 Zãa 15.25","reference":{"chapter":69,"verse":5}},{"noteId":63,"caller":"+","text":"69.10 Zãa 2.17","reference":{"chapter":69,"verse":10}},{"noteId":64,"caller":"+","text":"69.10 Lom 15.3","reference":{"chapter":69,"verse":10}},{"noteId":65,"caller":"+","text":"69.22 Mat 27.48, Maa 15.36, Luk 23.36, Zãa 19.28-29","reference":{"chapter":69,"verse":22}},{"noteId":66,"caller":"+","text":"69.24 Lom 11.9-10","reference":{"chapter":69,"verse":24}},{"noteId":67,"caller":"+","text":"69.26 Zĩn 1.20","reference":{"chapter":69,"verse":26}},{"noteId":68,"caller":"+","text":"69.29 Bↄa 32.32, Zia 3.5, 13.8, 17.8","reference":{"chapter":69,"verse":29}}]},"thisChapterLink":"/api/bqc_sim/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":37}