{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":7,"content":[{"type":"heading","content":["Yãnakpaa, Dii!"]},{"type":"verse","number":1,"content":[{"text":"Lɛ pↄ́ Davidi sì Diiɛ Bɛ̃yãmɛɛ bui Kusi yã́ musu.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dii ma Lua, ma nanziɛ,","poem":1},{"lineBreak":true},{"text":"ma suaba ǹ ma bↄ gbɛ̃́ pↄ́ pɛ̀lɛmaziↄ ↄzĩ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tó màa no,","poem":1},{"lineBreak":true},{"text":"aa ma taitai lán nↄ̀ↄmusuwaɛ,","poem":1},{"lineBreak":true},{"text":"aa ma kɛ̃́kɛ̃kↄ̃ɛɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e a ma misio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dii ma Lua, tó ma tàaekɛ̀ɛ sↄ̃,","poem":1},{"lineBreak":true},{"text":"tó ma ↄ ku yãvãiu,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"tó ma vãikɛ̀ ma gbɛ̃́deeɛ,","poem":1},{"lineBreak":true},{"text":"ge tó ma gbãamↄ̀ ma wɛ̀lɛɛ pã,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ma ibɛɛpi pɛ́lɛmazi aà ma kṹ,","poem":1},{"lineBreak":true},{"text":"i ↄ̃zↄ̃a tↄↄlɛ,","poem":1},{"lineBreak":true},{"text":"i ma tↄ́ vĩlɛ bùsu'ũfãau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Fɛlɛ zɛ ń pↄfɛ̃o Dii,","poem":1},{"lineBreak":true},{"text":"fɛlɛ kpɛ̃nɛbↄbↄ ma ibɛɛↄwa.","poem":1},{"lineBreak":true},{"text":"Ǹ n mɛ sɛ́, ma Lua,","poem":1},{"lineBreak":true},{"text":"ní yã́gↄ̃gↄ̃ a zɛ́wa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"To gbɛ̃́ↄ kãaanzi,","poem":1},{"lineBreak":true},{"text":"ní kiblemá kua za musu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii, ni yã́kpalɛkɛ ń gbɛ̃́ↄ.","poem":1},{"lineBreak":true},{"text":"Dii, to yã́ bↄmanↄ na ma yã́zɛde lɛ́u,","poem":1},{"lineBreak":true},{"text":"Musude, kɛmɛɛ ma nↄ̀sɛpua lɛ́u.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lua, ḿmɛ ń maa,","poem":1},{"lineBreak":true},{"text":"ni nↄ̀sɛ ń làasooo yↄɛ.","poem":1},{"noteId":6},{"lineBreak":true},{"text":"Gbɛ̃vãiↄ pãsĩkɛa midɛ,","poem":1},{"lineBreak":true},{"text":"ní gbɛ̃maaↄ gba zɛkĩi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lua Musude mɛ́ ma sɛ̀ngbao ũ,","poem":1},{"lineBreak":true},{"text":"ì nↄ̀sɛmaadeↄ suaba.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lua ì yã́kpalɛkɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"ì to yã́ àↄ zↄ̃lɛmá gↄↄpii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tó gbɛ̃́ i nↄ̀sɛlilɛo,","poem":1},{"lineBreak":true},{"text":"Lua ì a fɛ̃nda lɛkɛ, ì a sá kã́.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ì a ka gbaɛ̀,","poem":1},{"lineBreak":true},{"text":"ì a gↄ̃kɛbↄ pↄ́ ì ga inɛ́ↄ kɛkɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gwa, vãi ì nↄdↄ gbɛ̃́piu,","poem":1},{"lineBreak":true},{"text":"ì yãdↄnwɛia nↄsi à nɛ'iɛ̀ ɛgɛ ũ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ì ɛyↄ̃ gbɛ̃́ↄnɛ zã̀zã bai ũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ì zu ɛ pↄ́ a yↄ̃̀pi guu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aà yãdↄnwɛia a wi aà musu,","poem":1},{"lineBreak":true},{"text":"aà gbɛ̃́ↄ wɛtãa a sↄaa aà miwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Má Dii sáaukpa aà maakɛ yã́i,","poem":1},{"lineBreak":true},{"text":"má Dii Musude tↄbↄ ń lɛsiao.","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"7.10 Zia 2.23","reference":{"chapter":7,"verse":10}}]},"thisChapterLink":"/api/bqc_sim/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":18}