{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":71,"content":[{"type":"heading","content":["Mae zↄ̃ↄ wabikɛa Luawa"]},{"type":"verse","number":1,"content":[{"text":"Dii, ma nanziɛ,","poem":1},{"lineBreak":true},{"text":"ńsu to wí ma kũ bauo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma misi, ma bↄ n maakɛa yã́i,","poem":1},{"lineBreak":true},{"text":"swã́kpamazi, ma suaba.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma gbɛsi pↄ́ máli gɛ́ ulɛi a guun n ũ.","poem":1},{"lineBreak":true},{"text":"Ń dìlɛ ǹ ma suaba,","poem":1},{"lineBreak":true},{"text":"asa ma gbɛsi ń ma zɛgikĩion n ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma Lua, ma bↄ vãikɛnaↄ ↄzĩ,","poem":1},{"lineBreak":true},{"text":"ma si gbɛ̃́ bɛ̃̀ɛ pãsĩↄwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ḿmɛ ma wɛ́ dↄnzi, Dii Lua,","poem":1},{"lineBreak":true},{"text":"ḿmɛ má n náai vĩ za ma ɛ̀waasogↄↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma sↄ̃ kpálɛanzi za nɛasakpɛuɛ,","poem":1},{"lineBreak":true},{"text":"ḿmɛ n ma bↄ ma da nↄ̀sɛu.","poem":1},{"lineBreak":true},{"text":"N táasi miↄ lɛ gↄↄpii.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma kua dɛ yãbↄnsaɛ ũ gbɛ̃́ dasideɛ,","poem":1},{"lineBreak":true},{"text":"asa ḿmɛ ń ma ulɛkĩi gbãa ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N táasilɛa ìↄ dↄ ma lɛ́u,","poem":1},{"lineBreak":true},{"text":"miↄ n maabo kↄↄ ń oosio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ńsu pãkpamazi ma zikũa yã́io,","poem":1},{"lineBreak":true},{"text":"ńsu ma vũaa ma gbãa láaa yã́io.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Asa ma ibɛɛↄ lɛ́ ma yã'o,","poem":1},{"lineBreak":true},{"text":"ma wɛ̀lɛↄ lɛ́ lɛkpaaĩ ma wɛ̃nibↄai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa mɛ̀: Lua gìaàziɛ,","poem":1},{"lineBreak":true},{"text":"wà aà ya kṹ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e ku à aà suabao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lua, ńsu ǹyↄ̃ kumanↄ zã̀o,","poem":1},{"lineBreak":true},{"text":"ma Lua, kɛ kpakpa mↄ dↄmalɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"To wí gbɛ̃́ pↄ́ lɛ́ yãdↄaↄ kṹ,","poem":1},{"lineBreak":true},{"text":"aa midɛ,","poem":1},{"lineBreak":true},{"text":"to sↄ̃́sↄ̃a da gbɛ̃́ pↄ́ lɛ́ ĩadaaↄla,","poem":1},{"lineBreak":true},{"text":"an tↄ́ ↄ̃̀ↄkpa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mapi sↄ̃, ma wɛ́ ìↄ dↄnzi láasaiɛ,","poem":1},{"lineBreak":true},{"text":"miↄ n táasilɛ màↄ gɛ́.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N maakɛa aↄ dↄ ma lɛ́u gↄↄpiiɛ","poem":1},{"lineBreak":true},{"text":"ń n gbɛ̃suabaa pↄ́ má a lɛ́ dↄ̃oo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Má mↄ mà Dii Lua gↄ̃sakɛyãↄ galikɛ,","poem":1},{"lineBreak":true},{"text":"n mɛ̀ndo maakɛa má dↄ gbɛ̃́ↄgu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"N yãdàdamɛɛ za ma ɛ̀waasogↄↄ,","poem":1},{"lineBreak":true},{"text":"Lua, e tia málɛ n yãbↄnsaɛↄ o'o.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Baa kɛ́ ma zikũ̀, ma mikã pua,","poem":1},{"lineBreak":true},{"text":"ńsu ma to weo, Lua,","poem":1},{"lineBreak":true},{"text":"kɛ́ mà e n gbãa galikɛ tiadeↄnɛ,","poem":1},{"lineBreak":true},{"text":"mí n gↄ̃sakɛyã dau siu gbɛ̃́ pↄ́ aalɛ fɛlɛↄnɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lua, n maakɛa zↄ̃̀ma,","poem":1},{"lineBreak":true},{"text":"n yãzↄ̃ↄkɛ̀, démɛ muaannↄi?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ń tò taasi pãsĩ ma le dasidasi,","poem":1},{"lineBreak":true},{"text":"ãma ńyↄ̃ ɛa ǹ ma gba wɛ̃ni,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ ɛa ǹ ma bↄ tↄↄlɛ nↄnau.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ ma bɛɛɛ kã́fĩmɛɛ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ ɛa ma nↄ̀sɛ nínimɛɛ lↄ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ma Lua, má n sáaukpa ń mↄↄnao n náai yã́i.","poem":1},{"lineBreak":true},{"text":"Isailiↄ Lua pↄ́ n kua adoa, má n táasilɛ ń kúuo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gula aↄ dↄ ma lɛ́u.","poem":1},{"lineBreak":true},{"text":"Ma gbɛ̃́ pↄ́ n ma mìsi,","poem":1},{"lineBreak":true},{"text":"má n táasilɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Máↄ n maakɛa o gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"asa wí gbɛ̃́ pↄ́ lɛ́ ma vãi wɛɛlɛↄ kũ̀,","poem":1},{"lineBreak":true},{"text":"an gɛɛ gↄ̃̀ kpá ń wɛ́i.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}