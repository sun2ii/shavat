{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":72,"content":[{"type":"heading","content":["Wabikɛa Luawa"]},{"type":"hebrew_subtitle","content":["Salomↄↄ lɛ."]},{"type":"verse","number":1,"content":[{"text":"Lua, ǹ n iko kpa kíawa,","poem":1},{"lineBreak":true},{"text":"ǹ n maakɛ kpa kíabuipiwa,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kɛ́ aà dↄaa n gbɛ̃́ↄnɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"i yã́gↄ̃gↄ̃ táaaↄnɛ a zɛ́wa,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"gbɛ̀sĩsĩↄ i mↄ gbɛ̃́ↄnɛ ń aafiao,","poem":1},{"lineBreak":true},{"text":"sĩ̀sĩↄnaↄ i to aaↄ ku nama guu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kía a to yã́ bↄ ń táaaↄ na,","poem":1},{"lineBreak":true},{"text":"a taaside nɛ́ↄ suaba,","poem":1},{"lineBreak":true},{"text":"i gbãamↄnɛdeↄ wíwi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aↄ ku lá ĩatɛ̃ ìↄ ku gↄↄpiiwa,","poem":1},{"lineBreak":true},{"text":"lán mↄvua kua wɛ̃ ń wɛ̃owa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aↄ dɛ lán zuↄ louwa,","poem":1},{"lineBreak":true},{"text":"lán mↄ̀sɛ pↄ́ ì pisi tↄↄlɛwawa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ ↄta aà gↄↄ,","poem":1},{"lineBreak":true},{"text":"nama a kɛ zài e mↄ gɛ midɛò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"A kible za ísialɛ la ń a lɛ́leo,","poem":1},{"lineBreak":true},{"text":"za Uflata e dṹnia lɛ́wa.","poem":1},{"noteId":69}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bui pↄ́ kú guwaiwaiuↄ mↄ kúlɛɛ̀,","poem":1},{"lineBreak":true},{"text":"aà ibɛɛↄ wúlɛ ń gbɛɛu aà aɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Taasisi ń ísia baa kíaↄ falubↄɛ̀,","poem":1},{"lineBreak":true},{"text":"Seba ń Saba kíaↄ mↄ gbadaɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kíaↄ mↄ kúlɛɛ̀ ḿpii,","poem":1},{"lineBreak":true},{"text":"bui píi a misiilɛɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Asa a wɛ̃nade pↄ́ an wii dↄↄ bↄɛ,","poem":1},{"lineBreak":true},{"text":"a taaside pↄ́ dↄnlɛde vĩoↄ misi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A yɛ̃̀ɛɛsaideↄ wɛ̃nagwa,","poem":1},{"lineBreak":true},{"text":"a taasideↄ bↄ ga lɛ́zĩ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A ń bↄ gbãamↄnɛdeↄ ń gbɛ̃́ pãsĩↄ ↄzĩ,","poem":1},{"lineBreak":true},{"text":"asa an kua bɛɛɛ vĩɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Lua kía dↄ̃ ń aafiao!","poem":1},{"lineBreak":true},{"text":"Wiↄ aà gba Seba bùsu vua,","poem":1},{"lineBreak":true},{"text":"wiↄ wabikɛɛ̀ Luawa gↄↄpii,","poem":1},{"lineBreak":true},{"text":"wiↄ samaa'oɛ̀ láasai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bua pↄ́ↄ kɛ aà bùsuu maamaa,","poem":1},{"lineBreak":true},{"text":"a láↄ aↄ da sĩ̀sĩↄ musu síii,","poem":1},{"lineBreak":true},{"text":"aa nɛ'i aa pia lán Libã lákpɛwa,","poem":1},{"lineBreak":true},{"text":"aa gbã lán kàsapuwa sɛ̃saou.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aà tↄ́ aↄ ku gↄↄpii lán ĩatɛ̃waɛ,","poem":1},{"lineBreak":true},{"text":"bui píi a báaa e aà sabai, aai aà tↄnasi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wà Dii Lua, Isailiↄ Lua sáaukpa!","poem":1},{"lineBreak":true},{"text":"Ɔ̃mɛ ì yãbↄnsaɛↄ kɛ ado.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wàↄ Lua gawidepi tↄbↄ gↄↄpii,","poem":1},{"lineBreak":true},{"text":"aà gawi i li dṹniaa píi.","poem":1},{"lineBreak":true},{"text":"Ãmi! Ãmi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["Yɛse nɛ́ Davidi wabikɛa lɛ́n we."]}],"footnotes":[{"noteId":69,"caller":"+","text":"72.8 Zkl 9.10","reference":{"chapter":72,"verse":8}}]},"thisChapterLink":"/api/bqc_sim/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}