{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":73,"content":[{"type":"heading","content":["Vãikɛnaↄ kã́fĩa'ea yã́"]},{"type":"hebrew_subtitle","content":["Asafa lɛ."]},{"type":"verse","number":1,"content":[{"text":"Lua ì ɛ̀fãaikɛ Isailiↄnɛ sĩanaɛ,","poem":1},{"lineBreak":true},{"text":"ì maakɛ nↄ̀sɛpuadeↄnɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mapi sↄ̃ ma kãikũ̀ ń lɛ́lɛao,","poem":1},{"lineBreak":true},{"text":"ma gbá ye zãi guwa yãaɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kɛ́ ma vãikɛnaↄ kua maa è,","poem":1},{"lineBreak":true},{"text":"ma ĩ́andãnapiↄ gwea nidɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yãe lí kpàlikpanɛ́o,","poem":1},{"lineBreak":true},{"text":"aa aafia mɛ́ aa mɛkpaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"An wá lí wã lán dãↄwao,","poem":1},{"lineBreak":true},{"text":"aali gyãkɛ lán deↄwao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aaì ĩ́andãa da ń nↄɛ yàbaa ũ,","poem":1},{"lineBreak":true},{"text":"aaì pãsĩ nańzi pↄkasa ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"An oa ìↄ nísi bↄ,","poem":1},{"lineBreak":true},{"text":"an kàamai dɛ ń pia.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa gbɛ̃́laani vĩ,","poem":1},{"lineBreak":true},{"text":"aaì boo gbɛ̃̀nɛ onɛ́,","poem":1},{"lineBreak":true},{"text":"aaì naɛnaɛmá ń zↄ̃ↄkɛ yã́i.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aaì mɛ: Lua pila wà dɛ̃ɛka,","poem":1},{"lineBreak":true},{"text":"mɛ́ an yã́ ì li dṹniaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ayãmɛto wì kɛnɛ́ kɛ̀kɛ,","poem":1},{"lineBreak":true},{"text":"wì yã́ pↄ́ aa ò píi sí sĩana ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aaì mɛ: Lua a dↄ̃ má ni?","poem":1},{"lineBreak":true},{"text":"Musude dↄ̃a kà màae?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Vãikɛnapiↄ gwa, aa yãe kã̀a vĩo,","poem":1},{"lineBreak":true},{"text":"an gwea ìↄ kã́fĩ gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Asi ma nↄ̀sɛ pua pã yã̀?","poem":1},{"lineBreak":true},{"text":"Ma a ↄbↄ̀lɛ tàaeu wásawasa pãɛa?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Niↄ ma gbɛ̃ gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"niↄ ma swã́gaga lá gu lɛ́ dↄ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tó ma zɛ ń yã́ bee taa oaoɛ,","poem":1},{"lineBreak":true},{"text":"bee aↄ dɛ bↄa n gbɛ̃́ↄ kpɛ ũɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kɛ́ ma làasookɛ̀ yã́piwa mà dↄ̃,","poem":1},{"lineBreak":true},{"text":"à kɛ̀mɛɛ zĩ'ũɛ,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"e ma gɛ gɛ̃ò Lua kúkĩi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma wɛ́ gbàsa kɛ̃̀ an láaa yã́ musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ni ń da gu zãandeu,","poem":1},{"lineBreak":true},{"text":"ni ↄzↄ̃ńzi aa gↄ̃ ń liaao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aaì gↄ̃ kaalɛpↄ ũ kã́ndo,","poem":1},{"lineBreak":true},{"text":"vĩa pↄ́ↄ ì ń le, aa midɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Lá nana ì gɛ̃zɛa, tó gbɛ̃́ vù,","poem":1},{"lineBreak":true},{"text":"tó n fɛlɛ Dii, ńyↄ̃ to aa gɛ̃ ń ĩ́anao màaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kɛ́ ma nↄ̀sɛ ↄ̃̀ↄkpà,","poem":1},{"lineBreak":true},{"text":"mɛ́ ma pↄ yà,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ma sↄũkũ̀, má yãe dↄ̃o,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ n kĩ́i lán nↄ̀bↄwa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N beeo má kunnↄ gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"n ma kũ ma ↄplaawa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ni dↄaamɛɛ ń n lɛdaaao,","poem":1},{"lineBreak":true},{"text":"bee gbɛa ńyↄ̃ ma ka àizãnawa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ma wɛ́ dↄ gbɛ̃ezi musuo, n bàasio,","poem":1},{"lineBreak":true},{"text":"kuannↄ guu pↄe ni lɛ́ ma dɛ tↄↄlɛo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Baa tó ma mɛ ń ma sↄ̃o yɛ̃̀ɛɛ lɛ́ láa,","poem":1},{"lineBreak":true},{"text":"Lua mɛ́ ì to ma sↄ̃ gbãakũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ ma baa ũ gↄↄpii.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Asa gbɛ̃́ pↄ́ kɛ̃̀maↄ midɛɛ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ n gbɛ̃́ pↄ́ bↄ̀ n kpɛↄ bãdɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Lua, sↄ̃́aanzi mɛ́ kɛ̀mɛɛ na,","poem":1},{"lineBreak":true},{"text":"Dii Lua, ma n kɛ ma ulɛkĩi ũɛ.","poem":1},{"lineBreak":true},{"text":"Má n yãkɛaↄ dau mà siunɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}