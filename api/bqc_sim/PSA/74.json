{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":74,"content":[{"type":"heading","content":["Wiilɛa Luai aà kpɛ́ wia yã́ musu"]},{"type":"hebrew_subtitle","content":["Asafa lɛ."]},{"type":"verse","number":1,"content":[{"text":"Lua, bↄ́yãi n giwázi e gↄↄpiii?","poem":1},{"lineBreak":true},{"text":"Àkɛa ńlɛ pↄbↄ n níu n kpàsa sãↄ yã́ musui?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ n ń sí za ziↄ yã́ dↄngu,","poem":1},{"lineBreak":true},{"text":"bui pↄ́ ń bò aa gↄ̃̀ ń pↄ́ ũↄ","poem":1},{"lineBreak":true},{"text":"ń Siↄna gbɛ̀sĩsĩ pↄ́ ń kɛ̀ n kúkĩi ũo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"N ibɛɛↄ n kúkĩi dàaĩ míↄmiↄ.","poem":1},{"lineBreak":true},{"text":"Dɛdɛ ń laaio, à ↄ̃̀ↄkpà píi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N wɛ̀lɛↄ kã̀aa gu pↄ́ ni dauwálɛ,","poem":1},{"lineBreak":true},{"text":"aa ńzĩa seelaↄ pɛ̀lɛ we.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wá è, an mↄona dↄ musu,","poem":1},{"lineBreak":true},{"text":"aalɛ kɛ lá wìↄ dào gbɛ̃wa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lí yↄↄa kɛfɛna pↄ́ wa kpà a gĩwa,","poem":1},{"lineBreak":true},{"text":"aa gbɛ̃̀ wa gbòo ń mↄoo ń fɛ̃nkĩnio.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aa tɛsↄ̃̀ n kúkĩiwa, à kwɛ̀,","poem":1},{"lineBreak":true},{"text":"aa tò kpɛ́ pↄ́ n tↄ́ kuwàpi gbãlɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa ò ń nↄ̀sɛu: Wà ↄtↄ̃má míↄmiↄ.","poem":1},{"lineBreak":true},{"text":"Aa tɛsↄ̃̀ wá bùsu lousisikpɛↄwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N kpɛ́ lousisibↄↄ gɛ̃̀zɛa,","poem":1},{"lineBreak":true},{"text":"ãnabie ku lↄo.","poem":1},{"lineBreak":true},{"text":"Wáↄ ku màa e bↄɛn yã̀?","poem":1},{"lineBreak":true},{"text":"Wá gbɛ̃e dↄ̃o.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lua, ńyↄ̃ to n ibɛɛↄ aaↄ n yáalↄ e bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"N wɛ̀lɛↄ aaↄ sakangu láasai yã̀?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bↄ́yãi n ↄ kpaaũai?","poem":1},{"lineBreak":true},{"text":"Ɔgo n kùɛ, ní ń dɛdɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lua mɛ́ ma kía ũ za asĩnizĩ,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ ì gbɛ̃́ suaba dṹniau.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ḿmɛ n ísia zↄ̃̀ɛ ń n gbãao,","poem":1},{"noteId":70},{"lineBreak":true},{"text":"n kwãsa mi wì í guu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N Egipiↄ mìdɛ we,","poem":1},{"lineBreak":true},{"text":"n ń gɛↄ kpà wàiↄwa pↄblea ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N swaↄ bↄ̀, n zɛwɛ̃̀ nibↄnaↄnɛ,","poem":1},{"lineBreak":true},{"text":"n swa pↄ́ a í baa vĩo zↄ̃̀ɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Fãanɛ ń gwãasĩnao dɛ n pↄ́ ũɛ,","poem":1},{"lineBreak":true},{"text":"n mↄvua ń ĩatɛ̃o kúkĩi dìlɛnɛ́.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ḿmɛ n kↄↄ dàda bùsu píiu,","poem":1},{"lineBreak":true},{"text":"n saɛ ń buziɛo gↄↄ dìlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yá pↄ́ n ibɛɛↄ dↄ̀ yã́ dↄngu Dii,","poem":1},{"lineBreak":true},{"text":"mìsaidepiↄ sakà n tↄ́uɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ńsu ǹ n felena kpá wàiↄwao,","poem":1},{"lineBreak":true},{"text":"n wɛ̃nadeↄ yã́ su sãnguo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Laaidↄ n bàakuawanↄwa,","poem":1},{"lineBreak":true},{"text":"asa wá bùsu gbɛ̀'ɛↄ pãsĩkũ̀ píiɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wá gbɛ̃́ pↄ́ wàlɛ gbãamↄwɛ̃ɛↄ,","poem":1},{"lineBreak":true},{"text":"ńsu to wà kpɛkpa ń wíoo.","poem":1},{"lineBreak":true},{"text":"To wɛ̃nadeↄ ń taasideↄ n táasilɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lua, fɛlɛ gí ń nzĩao.","poem":1},{"lineBreak":true},{"text":"N yá pↄ́ mìsaideↄ lɛ́ dↄ zɛsai màé!","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ńsu zↄa pↄ́ n ibɛɛↄ lɛ́ kánzi kpa swã́ao,","poem":1},{"lineBreak":true},{"text":"n wɛ̀lɛpiↄ kↄ̃fĩ dↄ gↄↄpiiɛ.","poem":1}]}],"footnotes":[{"noteId":70,"caller":"+","text":"74.13 Bↄa 14.21","reference":{"chapter":74,"verse":13}}]},"thisChapterLink":"/api/bqc_sim/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}