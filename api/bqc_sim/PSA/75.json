{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":75,"content":[{"type":"heading","content":["Lua mɛ́ yã́kpalɛkɛna ũ"]},{"type":"verse","number":1,"content":[{"text":"Asafa lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Wa n sáaukɛ̀ Lua,","poem":1},{"lineBreak":true},{"text":"wa n sáaukɛ̀.","poem":1},{"lineBreak":true},{"text":"Tó wà n yãbↄnsaɛↄ galikɛ̀,","poem":1},{"lineBreak":true},{"text":"ń kú kãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lua mɛ̀: Ma gↄↄdìlɛ,","poem":1},{"lineBreak":true},{"text":"má yã́kpalɛkɛ a zɛ́wa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó dṹnia dèe, a gbɛ̃́ↄ lɛ́ kɛ sèee,","poem":1},{"lineBreak":true},{"text":"mámɛ mi a gbapɛlɛ kṹ gíũgiũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mi o yↄ̃̀ↄdeↄnɛ aasu ń gasa fɛlɛo,","poem":1},{"lineBreak":true},{"text":"mi o vãikɛnaↄnɛ aasu káakuo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ásu à á gasa fɛlɛao,","poem":1},{"lineBreak":true},{"text":"ásu kàamai kɛmanↄo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Asa gbãa lí bↄ gukpɛ ge bɛ'aɛo,","poem":1},{"lineBreak":true},{"text":"ìli bↄ guwaiwai guu no,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lua mɛ́ yã́kpalɛkɛna ũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ ì gbɛ̃do sↄ̃ↄlɛ, ì gbɛ̃do fɛlɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Imibↄ ku Dii ↄzĩ, í gbãa ka a pai,","poem":1},{"lineBreak":true},{"text":"àlɛ pí aà pↄkũma ũ.","poem":1},{"lineBreak":true},{"text":"Ì kↄ́lɛ dṹnia vãikɛnaↄwa píi,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aaì mi wesai ń a gbↄ̃ↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mapi sↄ̃ máↄ yã́pi o gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"mí Yakↄbu Lua táasilɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má vãikɛnaↄ gasa kwɛ́,","poem":1},{"lineBreak":true},{"text":"gbɛ̃maaↄ gasa iↄ ku musu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":11}