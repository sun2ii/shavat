{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":76,"content":[{"type":"heading","content":["Lua mɛ́ zĩblea gbãa ũ"]},{"type":"verse","number":1,"content":[{"text":"Asafa lɛ. Wì sí ń kúuↄɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Wa Lua dↄ̃ Yuda bùsuuɛ,","poem":1},{"lineBreak":true},{"text":"aà tↄ́ gbãa Isailiↄnɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aà zwã̀akpɛ kú Salɛma,","poem":1},{"lineBreak":true},{"text":"aà kúkĩi kú Siↄna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kua we à kà wãaↄ ɛ̀'ɛ","poem":1},{"lineBreak":true},{"text":"ń sɛ̀ngbaoↄ ń fɛ̃ndaↄ ń zĩkabↄↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ni gupu, niↄ tɛkɛ,","poem":1},{"lineBreak":true},{"text":"n zↄ̃ↄ dɛ gbɛ̀sĩsĩ pↄ́ kú gↄↄpiia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N gbãa dɛnla kɛ̀ gↄ̃sa gbãaↄnɛ,","poem":1},{"lineBreak":true},{"text":"aa wúlɛa ń ń i gbɛzão,","poem":1},{"lineBreak":true},{"text":"gↄ̃ gɛ̀bɛɛpiↄ gbɛ̃e i fↄ̃ ↄsɛ̀o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yakↄbu Lua, n ń lele,","poem":1},{"lineBreak":true},{"text":"ↄ̃ sↄ̃deↄ ń ń sↄ̃́ↄ gↄ̃̀ kálɛa ń izↄ̃ↄo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ḿmɛ ń gbɛ̃́ pↄ́ dɛ wà vĩakɛɛ̀ ũ,","poem":1},{"lineBreak":true},{"text":"tó n pↄbↄ̀ n níu,","poem":1},{"lineBreak":true},{"text":"démɛ a fↄ̃ zɛ n aɛi?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kua musu n yã́kpalɛkɛ̀,","poem":1},{"lineBreak":true},{"text":"ↄ̃ vĩa dṹnia kũ̀, à gↄ̃̀ kílikili.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lua, n fɛlɛ n yãgↄ̃̀gↄ̃ dṹniaɛ,","poem":1},{"lineBreak":true},{"text":"n yɛ̃̀ɛɛsaideↄ suabà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃nazĩna pↄkũma ì n tↄbↄ,","poem":1},{"lineBreak":true},{"text":"n pↄkũma kĩni ìↄ dↄa n piɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"À lɛkɛ Dii á Luawa, í a fĩabo.","poem":1},{"lineBreak":true},{"text":"Á gbɛ̃́ pↄ́ á liaawáziↄ,","poem":1},{"lineBreak":true},{"text":"à mↄ Lua pↄ́ dɛ wàↄ aà vĩa vĩ gba pↄ́.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ì kpalablenaↄ kãdɛ,","poem":1},{"lineBreak":true},{"text":"ì to vĩa dṹnia kíaↄ kṹ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":13}