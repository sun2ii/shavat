{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":77,"content":[{"type":"heading","content":["Lua dↄnlɛ bɛɛkɛa taasi guu"]},{"type":"verse","number":1,"content":[{"text":"Asafa lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ma lɛzù Luazi,","poem":1},{"lineBreak":true},{"text":"ma wiilɛ̀wà,","poem":1},{"lineBreak":true},{"text":"ma lɛzù Luazi aà ma yãma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kua taasi guu ma Dii kĩ́i wɛ̀ɛlɛ,","poem":1},{"lineBreak":true},{"text":"ma ↄ dↄa Luazi gwã́ kpasasai,","poem":1},{"lineBreak":true},{"text":"ma nↄ̀sɛ i nínio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛ́ ma làasoo tà Lua kĩ́i,","poem":1},{"lineBreak":true},{"text":"ↄ̃ málɛ kãsãnkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ ma aà wàaipà,","poem":1},{"lineBreak":true},{"text":"ma nisĩna vùa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ń ma wɛ́ kũa, mi e i'òo,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ bíli guu, mi dↄ̃ lá má oo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma làasookɛ̀ yãawa","poem":1},{"lineBreak":true},{"text":"ń wɛ̃̀ zizi pↄ́ gɛ̃̀ↄ yã́o.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lɛ pↄ́ má dà yãa dↄ̀magu gwã́,","poem":1},{"lineBreak":true},{"text":"ma làasookɛ̀wà mà wɛɛlɛ dↄ̃.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma mɛ̀: Dii wá vũaa gↄↄpii yã̀?","poem":1},{"lineBreak":true},{"text":"Wá yã́ a kaaàgu lↄoa?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aà gbɛ̃kɛ mìdɛ míↄmiↄ yã̀?","poem":1},{"lineBreak":true},{"text":"Aà yã́ aↄ gbooa gↄↄpii yã̀?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wá wɛ̃nagwaa yã́ sã̀ Luagu yã̀?","poem":1},{"lineBreak":true},{"text":"Aà pↄ pàwázi, a wá wɛgwa lↄoa?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɔ̃ ma mɛ̀: Yã́ pↄ́ má kũan kɛ:","poem":1},{"lineBreak":true},{"text":"Musude ↄzɛɛdↄ̀wɛ̃ɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Má làasookɛ Dii yãbↄnsaɛↄwa,","poem":1},{"lineBreak":true},{"text":"mí aà yã́ pↄ́ a kɛ̀ yãaↄ dↄ gbɛ̃́ↄgu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Má n dabudabukɛaↄ wàaipa píi,","poem":1},{"lineBreak":true},{"text":"mí n yãzↄ̃ↄkɛaↄ onɛ́.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lua, n zɛ́ gbãsĩ vĩo.","poem":1},{"lineBreak":true},{"text":"Dii kpele mɛ́ zↄ̃ↄ lán Luawai?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ḿmɛ ń Lua dabudabukɛna ũ,","poem":1},{"lineBreak":true},{"text":"n n gbãa ↄ̀lↄ buiↄnɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N n gbɛ̃́ↄ mìsi ń n gã̀sa gbãao,","poem":1},{"lineBreak":true},{"text":"wá Yakↄbu ń Yosɛfuo buiↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ísia wɛsìnlɛ Lua,","poem":1},{"lineBreak":true},{"text":"ísia wɛsìnlɛ ↄ̃ à kↄ̃dɛ̀,","poem":1},{"lineBreak":true},{"text":"à lùalua za a ɛu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lou kwɛ̀, a pũnaa kↄ̃fĩ dↄ̀ luabɛ,","poem":1},{"lineBreak":true},{"text":"n kà tɛdeↄ kpa loupilɛa ũ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N pũnaa kↄ̃fĩ dↄ zàa'ĩana guu,","poem":1},{"lineBreak":true},{"text":"loupilɛa dṹnia pù píi.","poem":1},{"lineBreak":true},{"text":"Tↄↄlɛ gbãlɛ à lùalua.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N zɛ́ dà ísiau,","poem":1},{"lineBreak":true},{"text":"n gɛ̃kĩi bↄ̀ í zↄ̃ↄ guu,","poem":1},{"lineBreak":true},{"text":"wi n kɛ̀sɛgbɛ eo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"N dↄaa n gbɛ̃́ↄnɛ lán sã waiwa","poem":1},{"lineBreak":true},{"text":"Mↄizi ń Aalonao sabai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":21}