{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":78,"content":[{"type":"heading","content":["Lɛdaawá Isailiↄ yã́ musu"]},{"type":"hebrew_subtitle","content":["Asafa lɛ."]},{"type":"verse","number":1,"content":[{"text":"Ma gbɛ̃́ↄ, à ma lɛdama ma,","poem":1},{"lineBreak":true},{"text":"à swã́kpa ma yã́i.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Má yã'oɛ́ ń yáasio,","poem":1},{"lineBreak":true},{"text":"má yã́ pↄ́ ulɛa za zi bↄↄlɛkɛɛ́,","poem":1},{"noteId":71}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"yã́ pↄ́ wá mà mɛ́ wá dↄ̃,","poem":1},{"lineBreak":true},{"text":"yã́ pↄ́ wá maeↄ a galikɛ̀wɛ̃ɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wá yã́pi ulɛ wá nɛ́ↄnɛo,","poem":1},{"lineBreak":true},{"text":"wá Dii táasilɛa da wá tↄũnaↄnɛ","poem":1},{"lineBreak":true},{"text":"ń aà gbãao ń yãbↄnsaɛ pↄ́ a kɛ̀ↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À yãdìlɛ Yakↄbu buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"à a ikoyã dà Isailiↄnɛ.","poem":1},{"lineBreak":true},{"text":"A ò wá deziↄnɛ aa tó ń nɛ́ↄ dↄ̃,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"i gↄ̃ ń bui pↄ́ kpɛ́ↄnɛ fɛlɛkaa ũ,","poem":1},{"lineBreak":true},{"text":"aai fɛlɛ dada ń nɛ́ↄnɛ sↄ̃,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kɛ́ aa e Lua náaikɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ Lua yãkɛaↄ su sã́ńguo,","poem":1},{"lineBreak":true},{"text":"aaiↄ aà yãdilɛaↄ kũa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kɛ́ aasu wàↄ dɛ lán ń deziↄwao,","poem":1},{"lineBreak":true},{"text":"asa aa swã́gbãakɛ̀ aa gì Lua yã́i,","poem":1},{"lineBreak":true},{"text":"an sↄ̃ ku Luawao, aa náai vĩɛ̀o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ɛflaiũ buiↄá kàzunaↄnɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa kpɛkpà zĩ guu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aai zɛ ń Luabaakuańnↄoo,","poem":1},{"lineBreak":true},{"text":"aa gì tɛ́i aà ikoyãi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aà yãkɛaↄ sã̀ńgu","poem":1},{"lineBreak":true},{"text":"ń aà yãbↄnsaɛ pↄ́ a ↄ̀lↄnɛ́ↄ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À dabudabuↄ kɛ̀ an deziↄ wáa","poem":1},{"lineBreak":true},{"text":"Zoã wɛ̃́lɛu, Egipi bùsuu.","poem":1},{"noteId":72}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"À ísia zↄ̃̀ɛ à bùańnↄ,","poem":1},{"lineBreak":true},{"text":"à í bĩ́ibò.","poem":1},{"noteId":73}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À dↄ̀aanɛ́ tɛlu guu fãanɛ,","poem":1},{"lineBreak":true},{"text":"gwãasĩna sↄ̃ ń tɛ́ gupuao.","poem":1},{"noteId":74}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À gbɛsi pàa guwaiwaiu,","poem":1},{"lineBreak":true},{"text":"à í kpàmá zↄ̃ↄ lán ísia íwa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A tò í bↄ̀nɛ́ gbɛu,","poem":1},{"lineBreak":true},{"text":"ípi bàalɛ̀ lán swadawa.","poem":1},{"noteId":75}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ɔ̃ aa gì tɛ duunawa,","poem":1},{"lineBreak":true},{"text":"aa gì Musude yãmai guwaiwaiu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aa gí kɛ̀ aa Lua lɛwɛ,","poem":1},{"lineBreak":true},{"text":"aa ń pↄeã blɛ gbɛ̀awà.","poem":1},{"noteId":76}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aa Lua bɛ̃̀ɛbò aa mɛ̀:","poem":1},{"lineBreak":true},{"text":"A fↄ̃ ↄpi'i dilɛwɛ̃ɛ sɛ̃u lae?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gwa, à gbɛ lɛ̀, í bↄ̀ dàgua mɛ!","poem":1},{"lineBreak":true},{"text":"A fↄ̃ blɛ ge nↄ̀ↄ kpáwá sↄ̃a?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kɛ́ Dii yã́pi mà, aà pↄ pà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ tɛ́ kũ̀ Yakↄbu buiↄwa,","poem":1},{"lineBreak":true},{"text":"à pↄkũmabↄ̀bↄ Isailiↄwa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Asa aai Lua yã́ sio,","poem":1},{"lineBreak":true},{"text":"aa aà gbɛ̃́ suabaa gbãa náai vĩo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"À yãdà bàlumaɛ,","poem":1},{"lineBreak":true},{"text":"à zɛwɛ̃̀ musu,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ↄ̃ mana kwɛ̀nɛ́ blɛ ũ,","poem":1},{"noteId":77},{"lineBreak":true},{"text":"à musu pↄ́wɛna gbↄ̃ yònɛ́.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Aa malaikaↄ blɛ blè,","poem":1},{"lineBreak":true},{"text":"à kũ̀sũakɛ̀nɛ́, à dìńla.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"A tò ĩ́an gbãa bↄ̀ gukpɛ,","poem":1},{"lineBreak":true},{"text":"ń aà gbãao à bↄ̀ gɛↄmidↄkĩi oi lↄ,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ↄ̃ à nↄ̀ↄ kwɛ̀nɛ́ lán luutɛ̃wa,","poem":1},{"lineBreak":true},{"text":"bãↄ lìńla lán ísialɛ ũfãawa.","poem":1},{"noteId":78}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"A tò aa kwɛ̀ ń bòou,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃̀ kálɛa liaa ń kpɛ́ↄi.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Lua pↄ́ pↄ́ aa a ni vĩ kpàmá,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa sò aa kã̀ pã́upãu.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"E a ni àↄ gɛ́ bↄińla,","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ blɛpi da ń lɛ́u,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Lua fɛ̀lɛ fɛ̃̀ńnↄ,","poem":1},{"lineBreak":true},{"text":"à Isaili gↄ̃gbãaↄ dɛ̀dɛ,","poem":1},{"lineBreak":true},{"text":"à ń ɛ̀waasoↄ kwɛ̀.","poem":1},{"noteId":79}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Gia ń beeo aa gì tɛ duunawaɛ,","poem":1},{"lineBreak":true},{"text":"ń aà yãbↄnsaɛkɛaↄ aai aà náaikɛo.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ɔ̃ à ń wɛ̃ni kɛ̀nɛ́ lán lɛ́'ĩanawa,","poem":1},{"lineBreak":true},{"text":"a tò ↄ̃̀ↄnɛkɛa ń mìdɛ.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Tó à ń pisabò, aaì aà aɛya,","poem":1},{"lineBreak":true},{"text":"aaì ɛa wà aà kĩ́i wɛɛlɛ ń wãao.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Aa dↄ̃̀ sa Lua mɛ́ ń gbɛsi ũ,","poem":1},{"lineBreak":true},{"text":"Lua Musude mɛ́ ń Mìsina ũ.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ãma aaì lɛ́mawà,","poem":1},{"lineBreak":true},{"text":"aaì ɛɛtoɛ̀,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"an sↄ̃ kuwào,","poem":1},{"lineBreak":true},{"text":"aa aà bàakuańnↄ yã́ gbòo.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Aàpi sↄ̃ à ń wɛ̃nagwà,","poem":1},{"lineBreak":true},{"text":"à ń duuna kɛ̃̀má, i ń midɛo.","poem":1},{"lineBreak":true},{"text":"Ìↄ azĩa zùukɛ mↄ̀ↄmↄↄɛ,","poem":1},{"lineBreak":true},{"text":"i a pↄkũmabↄbↄmá píio.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"À ń gbɛ̃nazĩnkɛ dↄ̃̀má,","poem":1},{"lineBreak":true},{"text":"asa aaì gɛ̃zɛa susai lán ĩ́anawaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Aa swã́gbãakɛ̀ guwaiwaiu gɛ̃n ũma'ũma!","poem":1},{"lineBreak":true},{"text":"Aa aà pↄ yàɛ̀ sɛ̃u we à kɛ̀ zài.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Aa Lua lɛwɛ,","poem":1},{"lineBreak":true},{"text":"aa Lua lɛwɛ,","poem":1},{"lineBreak":true},{"text":"aa Isailiↄ Lua pↄ́ a kua adoa fɛ̃̀.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Aà iko gbãa sã̀ńgu,","poem":1},{"lineBreak":true},{"text":"lá à ń sí ń ibɛɛↄwa,","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"lá à dabudabuↄ kɛ̀ Egipi,","poem":1},{"lineBreak":true},{"text":"mɛ́ à yãbↄnsaɛↄ kɛ̀ Zoã bùsuu.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"À ń swa'iↄ lìlɛ au ũ,","poem":1},{"noteId":80},{"lineBreak":true},{"text":"ↄ̃ aai fↄ̃ aa a imì lↄo.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"À ũsĩnaↄ kàńgu, aa ń soso,","poem":1},{"noteId":81},{"lineBreak":true},{"text":"ń blↄↄↄ lↄ, aa yãyìamá.","poem":1},{"noteId":82}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"A tò kwaↄ ń pↄ́wɛnaↄ blè,","poem":1},{"lineBreak":true},{"text":"à kwasutɛ̃ kà ń buapↄ́ↄu.","poem":1},{"noteId":83}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"A tò lougbɛ ń vɛ̃ɛbuↄ kɛ̀ kɛ́lɛkɛlɛ,","poem":1},{"lineBreak":true},{"text":"a zàa'ĩana ń kaa líↄ ɛ̀'ɛ.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"À ń pↄtuoↄ músikɛ̀ ń lougbɛpio,","poem":1},{"lineBreak":true},{"text":"lua sù ń kpàsaↄwa.","poem":1},{"noteId":84}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"À a pↄkũma zↄ̃ↄ bↄ̀bↄmá,","poem":1},{"lineBreak":true},{"text":"à ĩ́isɛ̀ńnↄ ń pↄfɛ̃o ń kpɛ̃nɛo,","poem":1},{"lineBreak":true},{"text":"à músi malaikaↄ gbàɛmá.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"À a pↄkũma gbà zɛ́,","poem":1},{"lineBreak":true},{"text":"i zɛzↄ̃ gaɛ lↄo, à gagyãkàńgu.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"À Egipi nɛgↄ̃ɛ sɛ̃́iaↄ dɛ̀dɛ píi,","poem":1},{"noteId":85},{"lineBreak":true},{"text":"Haũ bui gↄ̃sakɛ nɛ́piↄ gàga.","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"À bↄ̀ ń a gbɛ̃́ↄ lán sãↄwa,","poem":1},{"lineBreak":true},{"text":"à dↄ̀aanɛ́ guwaiwaiu lán sã waiↄwa.","poem":1},{"noteId":86}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"A bɛńnↄ, aa ku dↄdↄa vĩasai,","poem":1},{"lineBreak":true},{"text":"an ibɛɛↄ sↄ̃, ísia kũ̀aamá.","poem":1},{"noteId":87}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"À kàńnↄ a bùsu zↄ̃lɛu,","poem":1},{"noteId":88},{"lineBreak":true},{"text":"gusĩsĩde pↄ́ a sì ń a gbãaopiu.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"À buipãleↄ yànɛ́,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ń bùsu kpaalɛ̀nɛ́ ń pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"à uakpàkpa Isaili buipiↄnɛ.","poem":1},{"noteId":89}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"Ɔ̃ aa Lua lɛwɛ aa gì aà yãmai,","poem":1},{"lineBreak":true},{"text":"aa Musude yãdilɛaↄ kũao.","poem":1},{"noteId":90}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Aa kpɛkpà aa bↄ̀ aà kpɛ lán ń maeↄwa,","poem":1},{"lineBreak":true},{"text":"aa náai vĩo lán sá gia baiwa.","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"Aa aà pↄ fɛ̀lɛɛ̀ ń ń sa'okĩio,","poem":1},{"lineBreak":true},{"text":"aa aà zafɛ̃̀ɛ̀ ń ń tã́aↄ.","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"Kɛ́ Lua è màa, ↄ̃ aà pↄ pà,","poem":1},{"lineBreak":true},{"text":"à ↄzↄ̃̀ Isailiↄzi pãsĩpãsĩ.","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"À a zwã̀akpɛ tò Silo","poem":1},{"noteId":91},{"text":"we,","poem":1},{"lineBreak":true},{"text":"aà bɛ pↄ́ a kpà gbɛ̃nazĩnaↄ guupi.","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"A tò an wɛ̀lɛↄ mↄ̀ a kpagolo sɛ̀,","poem":1},{"noteId":92},{"lineBreak":true},{"text":"ↄ̃mɛ aà gbãa ń aà gawio kúkĩi ũ.","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"A tò wà a gbɛ̃́ↄ dɛ̀dɛ ń fɛ̃ndao,","poem":1},{"lineBreak":true},{"text":"aà pↄ pà bui pↄ́ a sɛ̀pizi.","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"An ɛ̀waasoↄ tɛkũ̀ zĩ guu,","poem":1},{"lineBreak":true},{"text":"an wɛ̃́ndiaↄ i zãkɛlɛ dↄ̃ lↄo.","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"Wà ń sa'onaↄ dɛ̀dɛ ń fɛ̃ndao,","poem":1},{"lineBreak":true},{"text":"an gyaaↄ i fↄ̃ ↄ́ↄlↄ̀o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Ɔ̃ Dii vù ń io sa,","poem":1},{"lineBreak":true},{"text":"lán gↄ̃sa pↄ́ vù ń wɛ̃'iowa.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"À ń wɛ̀lɛↄ gbɛ̃̀, aa kpɛkpà,","poem":1},{"lineBreak":true},{"text":"a tò aa gↄ̃̀ ń wío gↄↄpii.","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"Ɔ̃ à gì Ɛflaiũ buiↄzi,","poem":1},{"lineBreak":true},{"text":"i Yosɛfu buipi sɛ lↄo.","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"Yuda bui ↄ̃ a sɛ̀ sa","poem":1},{"lineBreak":true},{"text":"ń Siↄna gbɛ̀sĩsĩ pↄ́ á yeio.","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"À a kúkĩi dↄ̀ musumusu we,","poem":1},{"lineBreak":true},{"text":"aↄ ku gↄↄpii lán dṹnia kálɛawa.","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"Ɔ̃ à a zↄ̀blena Davidi sɛ̀,","poem":1},{"noteId":93},{"lineBreak":true},{"text":"à aà bↄ̀ sã kaau.","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"À aà bↄ̀ sãdãu, à dↄ̀aa Isailiↄnɛ,","poem":1},{"noteId":94},{"lineBreak":true},{"text":"Lua gbɛ̃́ Yakↄbu buipiↄ kíaɛ.","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"Davidi ń kpá a kpɛ ń nↄ̀sɛmɛndoo,","poem":1},{"lineBreak":true},{"text":"à dↄ̀aanɛ́ ń a ↄ báaadeo.","poem":1}]}],"footnotes":[{"noteId":71,"caller":"+","text":"78.2 Mat 13.35","reference":{"chapter":78,"verse":2}},{"noteId":72,"caller":"+","text":"78.12 Bↄa 7.8-12.32","reference":{"chapter":78,"verse":12}},{"noteId":73,"caller":"+","text":"78.13 Bↄa 14.21-22","reference":{"chapter":78,"verse":13}},{"noteId":74,"caller":"+","text":"78.14 Bↄa 13.21-22","reference":{"chapter":78,"verse":14}},{"noteId":75,"caller":"+","text":"78.16 Bↄa 17.1-7, Nao 20.2-13","reference":{"chapter":78,"verse":16}},{"noteId":76,"caller":"+","text":"78.18 Bↄa 16.3, Nao 11.4-5","reference":{"chapter":78,"verse":18}},{"noteId":77,"caller":"+","text":"78.24 Bↄa 16.14-15, Nao 11.7-9, Zãa 6.31","reference":{"chapter":78,"verse":24}},{"noteId":78,"caller":"+","text":"78.27 Bↄa 16.13, Nao 11.31-32","reference":{"chapter":78,"verse":27}},{"noteId":79,"caller":"+","text":"78.31 Nao 11.33","reference":{"chapter":78,"verse":31}},{"noteId":80,"caller":"+","text":"78.44 Bↄa 7.17-21","refer