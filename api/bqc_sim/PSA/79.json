{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":79,"content":[{"type":"heading","content":["Yelusalɛũ dɛɛlɛa wii"]},{"type":"hebrew_subtitle","content":["Asafa lɛ."]},{"type":"verse","number":1,"content":[{"text":"Lua, buipãleↄ sì ń bùsuu,","poem":1},{"lineBreak":true},{"text":"aa n kpɛ́ pↄ́ a kua adoa ↄ̃̀ↄkpà,","poem":1},{"lineBreak":true},{"text":"aa Yelusalɛũ dɛ̀ɛlɛ.","poem":1},{"noteId":95}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aa n zↄ̀blenaↄ dɛ̀dɛ aa ń gɛ kpà bãↄwa,","poem":1},{"lineBreak":true},{"text":"aa n yãmanaↄ gɛ tò wàiↄnɛ blɛ ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"An au bàalɛ̀ lán íwa Yelusalɛũ bĩ́i kpɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e ku à ń vĩo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wa gↄ̃ pↄ́ yáalↄaↄ ũ wá saɛdeↄnɛ,","poem":1},{"lineBreak":true},{"text":"láanipↄ ũ gbɛ̃́ pↄ́ liaawáziↄnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii, n pↄ aↄ paawázi e bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"N kpɛ̃nɛ tɛ́ aↄ kũ gↄↄpii yã̀?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pↄkũma bↄbↄ bui pↄ́ aa n dↄ̃oↄwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aali ń sísioↄ bùsuↄwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Asa aa Yakↄbu buiↄ blè,","poem":1},{"lineBreak":true},{"text":"aa ń bùsu ↄ̃̀ↄkpàɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ńsu wá maeↄ duuna wi wá musuo.","poem":1},{"lineBreak":true},{"text":"Wɛ̃nadↄ̃wɛ̃ɛ kpakpa,","poem":1},{"lineBreak":true},{"text":"asa wa busa dúuduuɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dↄwálɛ, Lua wá Suabana.","poem":1},{"lineBreak":true},{"text":"Wá misi, kɛ́ ǹ tↄbↄ,","poem":1},{"lineBreak":true},{"text":"wá duuna kɛ̃́wá n tↄ́ yã́i.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bↄ́yãi ńyↄ̃ to buipãleↄ wá lá:","poem":1},{"lineBreak":true},{"text":"Wá Lua ku máɛ la?","poem":1},{"lineBreak":true},{"text":"To buipãleↄ dↄ̃ wá aɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ ni n zↄ̀blenaↄ dɛdɛa tↄsimá.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"To zĩ̀zↄↄ ↄↄlↄ gɛ̃ n swã́u,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ kú ga lɛ́zĩpiↄ bↄ","poem":1},{"lineBreak":true},{"text":"ń n gã̀sa gbãao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Láani pↄ́ wá saɛdeↄ zĩ̀ma,","poem":1},{"lineBreak":true},{"text":"fĩabonɛ́ gɛ̃n sopla, Dii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wápiↄ n gbɛ̃́ↄ, n kpàsa sãↄ,","poem":1},{"lineBreak":true},{"text":"wíↄ n sáaukpa gↄↄpii,","poem":1},{"lineBreak":true},{"text":"wíↄ n tↄ́ galikɛ e wá buiwa.","poem":1}]}],"footnotes":[{"noteId":95,"caller":"+","text":"79.1 2Kia 25.8-10, Zel 52.12-14","reference":{"chapter":79,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}