{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":8,"content":[{"type":"heading","content":["Lua zↄ̃ↄkɛ oa"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dii wá Dii, n tↄbↄ̀ dṹnia guu,","poem":1},{"lineBreak":true},{"text":"n gawi bↄ̀ gupuau musu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ń dà nɛ́fɛ̃nɛnaↄnɛ ń nɛ́ yↄ̃minaↄ","poem":1},{"lineBreak":true},{"text":"aa n táasilɛ,","poem":1},{"noteId":7},{"lineBreak":true},{"text":"kɛ́ n ibɛɛↄ ń n wɛ̀lɛↄ nílɛ yã́i,","poem":1},{"lineBreak":true},{"text":"n mↄakanaↄ lɛ́ i gↄ̃ kpaaũa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kɛ́ ma n zĩ gwà musu,","poem":1},{"lineBreak":true},{"text":"mↄvua ń saana pↄ́ ń pɛ̀pɛ weↄ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ma mɛ̀ bↄ́n gbɛ̃nazĩna ũ an yã́ ìↄ dↄngui?","poem":1},{"lineBreak":true},{"text":"Bↄ́n ń ũ ni laaidↄmái?","poem":1},{"noteId":8}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N aà kɛ̀ kɛ̃́sãa malaikaↄzi gↄↄpla,","poem":1},{"lineBreak":true},{"text":"n aà kpà kpalau ń gawio ń bɛɛɛo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ń tò à iko vĩ pↄ́ pↄ́ ń kɛ̀ↄwa,","poem":1},{"lineBreak":true},{"text":"ń tò pↄ́pii misìilɛɛ̀,","poem":1},{"noteId":9}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"sãↄ ń zuↄ ń sɛ̃̀anↄbↄↄ píi,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"bãↄ ń kpↄↄ ń pↄ́ pↄ́ kú ísia guuↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dii wá Dii, n tↄbↄ̀ dṹnia guu.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"8.3 Mat 21.16","reference":{"chapter":8,"verse":3}},{"noteId":8,"caller":"+","text":"8.5 Soũ 144.3, Ɛbɛ 2.6-8","reference":{"chapter":8,"verse":5}},{"noteId":9,"caller":"+","text":"8.7 1Kln 15.27, Ɛfɛ 1.22, Ɛbɛ 2.8","reference":{"chapter":8,"verse":7}}]},"thisChapterLink":"/api/bqc_sim/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}