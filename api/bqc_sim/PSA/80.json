{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":80,"content":[{"type":"heading","content":["Isailiↄ sua ń pá ziu wabikɛa"]},{"type":"verse","number":1,"content":[{"text":"Asafa lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Swã́kpa Isailiↄ Dↄaana,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃́ pↄ́ ni Yosɛfu buiↄ dã lán sãↄwa.","poem":1},{"lineBreak":true},{"text":"Bↄ gupuau, n gbɛ̃́ pↄ́ ń zↄ̃lɛa malaika gã̀sĩadeↄ zãnguo,","poem":1},{"noteId":96}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ní dↄaa Ɛflaiũ buiↄnɛ","poem":1},{"lineBreak":true},{"text":"ń Bɛ̃yãmɛɛ buiↄ ń Manase buiↄ.","poem":1},{"lineBreak":true},{"text":"Fɛlɛ ń n gbãao, mↄ ǹ wá suaba!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lua, to wà ɛa su wá pá ziu.","poem":1},{"lineBreak":true},{"text":"Wá wɛgwa wà aafiaʼe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii Lua Zĩgↄ̃de,","poem":1},{"lineBreak":true},{"text":"ńlɛ pↄbↄ n níu e tia,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ n gbɛ̃́ↄ wabikɛa mamá bↄɛ ni?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N wɛ́'i kpàmá blɛ ũ,","poem":1},{"lineBreak":true},{"text":"n ń wɛ́'i yↄ̃̀nɛ́ pↄ́ pai aa mì.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ń tò wa gↄ̃ láanipↄ ũ wá saɛdeↄnɛ,","poem":1},{"lineBreak":true},{"text":"wá ibɛɛpiↄ lɛ́ wá kɛ pↄ́ↄpↄↄ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lua Zĩgↄ̃de, to wà su wá pá ziu,","poem":1},{"lineBreak":true},{"text":"wá wɛgwa wà aafiaʼe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"N vɛ̃ɛli wò Egipi,","poem":1},{"lineBreak":true},{"text":"n buipãleↄ yà ↄ̃ ń pɛ̀ ń gbɛu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N gukɛ̀kɛɛ̀, à zĩ́napɛ̀lɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ à ↄtà à a bùsu pà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A uedà gbɛ̀sĩsĩↄla,","poem":1},{"lineBreak":true},{"text":"a gↄ̃naↄ dɛ sɛdɛ lí zↄ̃ↄↄla.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À ↄtà à gɛ̀ e ísialɛ,","poem":1},{"lineBreak":true},{"text":"a ↄnɛↄ gɛ̀ e Uflatai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bↄ́yãi n a kaa gbòo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ lɛ́ gɛ̃zɛaↄ ìↄ ↄmalɛii?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dào sàwa ì lɛ́ kái,","poem":1},{"lineBreak":true},{"text":"sɛ̃̀anↄbↄↄ ì mↄ a lá blei.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N yã́ na! Lua Zĩgↄ̃de, wá wɛgwa!","poem":1},{"lineBreak":true},{"text":"Kua za musu wɛzu ǹ gwa!","poem":1},{"lineBreak":true},{"text":"Laaidↄ vɛ̃ɛlipiwa,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"bui pↄ́ ń pɛ̀ nzĩa,","poem":1},{"lineBreak":true},{"text":"nɛ́ pↄ́ ń sì n pↄ́ ũpi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wà n vɛ̃ɛlipi zↄ̃̀ wà tɛsↄ̃̀wà.","poem":1},{"lineBreak":true},{"text":"Wɛpãsĩ biimá aa midɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ɔda gbɛ̃́ pↄ́ kú n ↄplaaiwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nazĩn nɛ́ pↄ́ ń sì n pↄ́ ũ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wá kɛ̃ma lↄo.","poem":1},{"lineBreak":true},{"text":"Wá lɛ́ ń láo, wí n sísi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii Lua Zĩgↄ̃de,","poem":1},{"lineBreak":true},{"text":"to wà su wá pá ziu,","poem":1},{"lineBreak":true},{"text":"wá wɛgwa wà aafiaʼe.","poem":1}]}],"footnotes":[{"noteId":96,"caller":"+","text":"80.2 Bↄa 25.22","reference":{"chapter":80,"verse":2}}]},"thisChapterLink":"/api/bqc_sim/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":20}