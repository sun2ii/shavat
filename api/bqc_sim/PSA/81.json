{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":81,"content":[{"type":"heading","content":["Isailiↄ dikpɛ lɛ"]},{"type":"verse","number":1,"content":[{"text":"Asafa lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"À guladↄ Lua wá gbãawa.","poem":1},{"lineBreak":true},{"text":"À kúkuakɛ Yakↄbu buiↄ Luaɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À bↄ ń lɛo, í bala lɛ́","poem":1},{"lineBreak":true},{"text":"ń mↄↄna'ↄ nao ń domao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À kuupɛ mↄbↄzĩ,","poem":1},{"noteId":97},{"lineBreak":true},{"text":"í pɛ́ a vua zã́ wá dikpɛgↄↄ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"asa a dɛ ikoyã ũ Isailiↄnɛɛ.","poem":1},{"lineBreak":true},{"text":"Yã́ pↄ́ Yakↄbu buiↄ Lua dìlɛn we.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À yã́pi dà Yosɛfu buiↄnɛ","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ à ã̀na Egipiↄwa.","poem":1},{"lineBreak":true},{"text":"Aa lↄↄ pↄ́ aai ma yãao mà à mɛ̀:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma aso gò á gã̀u,","poem":1},{"lineBreak":true},{"text":"ma á ↄ bↄ̀ ɛ̃u.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A wiilɛ̀a taasikɛgↄↄ, ↄ̃ ma á bↄ́,","poem":1},{"lineBreak":true},{"text":"má wèwá asii guu ń louvĩao.","poem":1},{"lineBreak":true},{"text":"Ma á lɛ́ ma á gwá Mɛliba í kĩ́i.","poem":1},{"noteId":98}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À swã́kpa ma gbɛ̃́ↄ, mí lɛdawá.","poem":1},{"lineBreak":true},{"text":"Á Isailiↄ, à ma yãma lé!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ásu àↄ dii pãle vĩo,","poem":1},{"lineBreak":true},{"text":"ásu kúlɛ dii zĩ̀loɛo.","poem":1},{"noteId":99}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mámɛ má Dii á Lua ũ,","poem":1},{"lineBreak":true},{"text":"ma á bↄ́lɛ Egipiɛ.","poem":1},{"lineBreak":true},{"text":"À á lɛ́ ɛlɛ, mí tó à kã́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ɔ̃ Isailiↄ i ma yãmao,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́piↄ i misiilɛmɛɛo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ɔ̃ ma ń tó ń ń swã́gbãao,","poem":1},{"noteId":100},{"lineBreak":true},{"text":"aa tɛ́ ńzĩa pↄeãi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tó Isailiↄ sↄ̃́amazi,","poem":1},{"lineBreak":true},{"text":"tó ma gbɛ̃́piↄ tɛ ma yã́i,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"dↄ̃ ma ń ibɛɛↄ bùsanɛ́ gↄ̃̀ↄgↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"ma ↄzↄ̃̀ ń wɛ̀lɛpiↄzi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma zangudeↄ i vlãnau ma aɛ,","poem":1},{"lineBreak":true},{"text":"an ĩadama aↄ láaa vĩo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mí á gwa ń pↄ́wɛn gawideo,","poem":1},{"lineBreak":true},{"text":"mí gbɛ̀ zↄ́'i kpáwá à kã́.","poem":1}]}],"footnotes":[{"noteId":97,"caller":"+","text":"81.4 Nao 10.10","reference":{"chapter":81,"verse":4}},{"noteId":98,"caller":"+","text":"81.8 Bↄa 17.7, Nao 20.13","reference":{"chapter":81,"verse":8}},{"noteId":99,"caller":"+","text":"81.10 Bↄa 20.2-3","reference":{"chapter":81,"verse":10}},{"noteId":100,"caller":"+","text":"81.13 Lom 1.24","reference":{"chapter":81,"verse":13}}]},"thisChapterLink":"/api/bqc_sim/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":17}