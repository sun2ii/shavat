̃ i to sↄ̃ kɛ̃́ńgu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"To an gɛɛ gↄ̃ kpá ń wɛ́i,","poem":1},{"lineBreak":true},{"text":"aai n gbãa dↄ̃ Dii.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wí líↄ ń kṹ gↄↄpii ń bílio,","poem":1},{"lineBreak":true},{"text":"aa kpɛbↄ aa midɛ,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"kɛ́ aa e dↄ̃ kɛ́ n tↄ́n Dii,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ń Musude ũ dṹniau píi.","poem":1}]}],"footnotes":[{"noteId":102,"caller":"+","text":"83.10 Dↄa 7.1-23","reference":{"chapter":83,"verse":10}},{"noteId":103,"caller":"+","text":"83.10 Dↄa 4.6-22","reference":{"chapter":83,"verse":10}},{"noteId":104,"caller":"+","text":"83.12 Dↄa 7.25","reference":{"chapter":83,"verse":12}},{"noteId":105,"caller":"+","text":"83.12 Dↄa 8.12","reference":{"chapter":83,"verse":12}}]},"thisChapterLink":"/api/bqc_sim/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":19}