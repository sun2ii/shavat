{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":84,"content":[{"type":"heading","content":["Lua ua bɛɛkɛa"]},{"type":"verse","number":1,"content":[{"text":"Kole buiↄ lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N kúkĩi maa fá, Dii Zĩgↄ̃de!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Málɛ Dii ua bɛɛkɛ e gu gɛ̀ lɛ́ lia,","poem":1},{"lineBreak":true},{"text":"ma nisĩna ń ma mɛo lɛ́ lua Lua bɛ̃́ɛi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii Zĩgↄ̃de, ma Kía, ma Lua,","poem":1},{"lineBreak":true},{"text":"gòlegolena kpɛ́ è ń gbagbakĩi saɛ,","poem":1},{"lineBreak":true},{"text":"luakibãna sakpɛdà we à a nɛ́ↄ kàu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Báaadeↄn gbɛ̃́ pↄ́ kú n ua","poem":1},{"lineBreak":true},{"text":"aaìↄ n táasilɛ gↄↄpiiↄ ũ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Báaadeↄn gbɛ̃́ pↄ́ an gbãa bↄ̀ n kĩ́i","poem":1},{"lineBreak":true},{"text":"mɛ́ n kpɛ́ gɛa yã́ kú ń sↄ̃ guuↄ ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tó aalɛ pã Baka guzulɛa,","poem":1},{"lineBreak":true},{"text":"aaì to à gↄ̃ lán gu nibↄnadewa,","poem":1},{"lineBreak":true},{"text":"káabuan lou ì to ɛ̀fãai ligua.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"An gɛa guu an gbãa ìↄ kã́fĩɛ","poem":1},{"lineBreak":true},{"text":"e aa gɛ kaò n kĩ́i Siↄna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dii Lua Zĩgↄ̃de, ma wabikɛa sí,","poem":1},{"lineBreak":true},{"text":"swã́sɛ ma yã́i, Yakↄbu buiↄ Lua.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lua, kía wá sɛ̀ngbao gwa,","poem":1},{"lineBreak":true},{"text":"wɛ́tɛ kía pↄ́ ń kpài.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kua n kpɛ́ kpɛɛlɛ gↄↄ do maa","poem":1},{"lineBreak":true},{"text":"dɛ kua gupãlei gↄↄ ↄ̀aa sↄola.","poem":1},{"lineBreak":true},{"text":"Ma Lua ua bĩ́ibↄlɛdↄ̃anakɛ sì","poem":1},{"lineBreak":true},{"text":"dɛ kua ua doũ ń vãikɛnaↄla.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dii Lua dɛnɛ́ ĩatɛ̃","poem":1},{"noteId":106},{"text":"ń sɛ̀ngbaoo ũ.","poem":1},{"lineBreak":true},{"text":"Dii ì báaadańgu ń kã́fĩao,","poem":1},{"lineBreak":true},{"text":"ìli gí maakɛi tàaesaideɛo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dii Zĩgↄ̃de,","poem":1},{"lineBreak":true},{"text":"báaaden gbɛ̃́ pↄ́ lɛ́ n náaikɛ ũ.","poem":1}]}],"footnotes":[{"noteId":106,"caller":"+","text":"84.12 Mal 4.2, Zia 21.23","reference":{"chapter":84,"verse":12}}]},"thisChapterLink":"/api/bqc_sim/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":13}