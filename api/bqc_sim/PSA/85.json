{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":85,"content":[{"type":"heading","content":["Isailiↄ aafia wabikɛa"]},{"type":"verse","number":1,"content":[{"text":"Kole buiↄ lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N báaadà n bùsuu, Dii,","poem":1},{"lineBreak":true},{"text":"n su ń Yakↄbu buiↄ ń pá ziu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N n gbɛ̃́ↄ tàaeↄ wòlomá,","poem":1},{"lineBreak":true},{"text":"n ń duuna kɛ̃̀má píi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N pↄ wèemá,","poem":1},{"lineBreak":true},{"text":"n n pↄkũma pãsĩ kpà kpɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Suwanↄ wá pá ziu,","poem":1},{"lineBreak":true},{"text":"Lua wá Suabana,","poem":1},{"lineBreak":true},{"text":"kpɛ̃nɛ pↄ́ ń kɛ̀wanↄ suumpa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N pↄ aↄ paawázi gↄↄpii yã̀?","poem":1},{"lineBreak":true},{"text":"Ńyↄ̃ↄ n pↄfɛ̃gↄↄ gága wɛ̃ ń wɛ̃o yã̀?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ ɛa ǹ n gbɛ̃́ↄ lɛ́ ń láo","poem":1},{"lineBreak":true},{"text":"kɛ́ an pↄ e kɛma nao lé?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii, ǹ n gbɛ̃kɛ ↄlↄwɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"wá suaba ń n gbãao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ma swã́ dↄ Dii Lua yã'oai,","poem":1},{"lineBreak":true},{"text":"asa ì aafia lɛgbɛ̃ a yãmanaↄnɛɛ,","poem":1},{"lineBreak":true},{"text":"tó aai ɛa sù ń mìsaiyãↄwao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aà vĩakɛnaↄ suabaa zã̀o,","poem":1},{"lineBreak":true},{"text":"kɛ́ aà gawi e àↄ kú wá bùsuu yã́i.","poem":1},{"noteId":107}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛ ń náaio kpàaũ,","poem":1},{"lineBreak":true},{"text":"yã́zɛde ń aafiao dàkↄ̃lɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Náai ì ↄ poo musu,","poem":1},{"lineBreak":true},{"text":"yã́zɛde ì ↄnↄnↄ zĩ́lɛi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dii a maakɛwɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"wá tↄↄlɛ i blɛkɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yã́zɛde ìↄ bɛ aà aɛ,","poem":1},{"lineBreak":true},{"text":"ì zɛkɛkɛɛ̀.","poem":1}]}],"footnotes":[{"noteId":107,"caller":"+","text":"85.10 Zãa 1.14","reference":{"chapter":85,"verse":10}}]},"thisChapterLink":"/api/bqc_sim/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":14}