{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":86,"content":[{"type":"heading","content":["Kowɛkɛa Luaɛ"]},{"type":"hebrew_subtitle","content":["Davidi lɛ."]},{"type":"verse","number":1,"content":[{"text":"Dii, swã́kpa ma yã́i, ní wea,","poem":1},{"lineBreak":true},{"text":"asa taaside wɛ̃naden ma ũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma wɛ̃ni dↄ̃́a, asa má n yã́ↄ kũaɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ n zↄ̀blena suaba,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ń ma Lua ũ, málɛ n náaikɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sùuukɛmanↄ, Dii,","poem":1},{"lineBreak":true},{"text":"asa miↄ lɛzunzi kↄↄ ń oosioɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ǹ n zↄ̀blena pↄ kɛ na,","poem":1},{"lineBreak":true},{"text":"asa ma laai tà n kĩ́i, Dii.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ń maa mɛ́ ń sùuu vĩ, Dii,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃kɛ zↄ̃ↄ n sìsinaↄnɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii, swã́kpa ma wabikɛai,","poem":1},{"lineBreak":true},{"text":"laaidↄ ma wɛ̃na wiiwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Má lɛzunzi ma taasikɛgↄↄzĩ,","poem":1},{"lineBreak":true},{"text":"asa ni wea.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tã́ae muaannↄo, Dii,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e lí fↄ̃ n kɛa kɛ̀o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bui pↄ́ ń kɛ̀ↄ mↄ́ kúlɛnɛ,","poem":1},{"noteId":108},{"lineBreak":true},{"text":"aa n tↄbↄ ḿpii.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Asa ń zↄ̃ↄ mɛ́ ni dabudabuↄ kɛ,","poem":1},{"lineBreak":true},{"text":"ḿmɛ ń Lua ũ ndo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ǹ n zɛ́ ↄlↄmɛɛ Dii,","poem":1},{"lineBreak":true},{"text":"míↄ bɛ n sĩana guu.","poem":1},{"lineBreak":true},{"text":"Ma sↄ̃ damɛɛ doũ, míↄ n vĩa vĩ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Má n sáaukpa ń nↄ̀sɛmɛndoo,","poem":1},{"lineBreak":true},{"text":"Dii ma Lua, máↄ n tↄbↄ gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Asa gbɛ̃kɛ pↄ́ ń kɛ̀mɛɛ zↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"n ma wɛ̃ni sì bɛda ɛ̀ títiwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lua, kàamaideↄ lɛ́ fɛlɛmanↄ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pãsĩↄ lɛ́ ma wɛ, aali n yãdao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mpi Dii, Lua sósobiden n ũ,","poem":1},{"lineBreak":true},{"text":"ń sùuu vĩ mɛ́ n pↄ lí pa kpaao,","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃kɛ ń náaio vĩ zↄ̃ↄ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma wɛgwa, wɛ̃nadↄ̃mɛɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ n zↄ̀blena gba gbãa,","poem":1},{"lineBreak":true},{"text":"mapi n nↄɛ zĩkɛna nɛ́ suaba.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Maakɛamɛɛ seela kɛ,","poem":1},{"lineBreak":true},{"text":"ma wɛ̀lɛↄ i e, wí i ń kṹ,","poem":1},{"lineBreak":true},{"text":"asa Dii, n dↄmalɛ,","poem":1},{"lineBreak":true},{"text":"n ma nↄ̀sɛ nìnimɛɛ.","poem":1}]}],"footnotes":[{"noteId":108,"caller":"+","text":"86.9 Zia 15.4","reference":{"chapter":86,"verse":9}}]},"thisChapterLink":"/api/bqc_sim/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}