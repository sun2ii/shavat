{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":88,"content":[{"type":"heading","content":["Kua ga lɛ́zĩ wiilɛa"]},{"type":"verse","number":1,"content":[{"text":"Ɛzala bui Emani","descriptive":true},{"noteId":110},{"text":"lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dii Lua ma Suabana,","poem":1},{"lineBreak":true},{"text":"málɛ wiilɛma fãanɛ ń gwãasĩnao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"To ma wabikɛa kama,","poem":1},{"lineBreak":true},{"text":"swã́kpa ma wiilɛai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Asa yã'ↄ̃ma kↄ̃̀ ma nↄ̀sɛuɛ,","poem":1},{"lineBreak":true},{"text":"ma wɛ̃ni sↄ̃̀ ɛ̀ lɛ́i.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wà ma da gbɛ̃́ pↄ́ aalɛ si bɛdauↄu,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ lán yɛ̃̀ɛɛsaidewa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wà ma ya ma kpa gɛↄ guu","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃́ pↄ́ wúlɛa miau sↄlↄlↄↄwa.","poem":1},{"lineBreak":true},{"text":"An yã́ dↄngu lↄo, aa bↄ̀ n ↄu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N ma zu ɛ̀ zòolo guu","poem":1},{"lineBreak":true},{"text":"e tↄↄlɛ nↄna gbã́o gusiau.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N pↄkũma tↄ̃̀a,","poem":1},{"lineBreak":true},{"text":"a ísↄ̃ lɛ́ ma lɛ́.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ń tò ma gbɛ̃́ↄ ma vũaa,","poem":1},{"lineBreak":true},{"text":"ń tò aa ye ma gĩyãio.","poem":1},{"lineBreak":true},{"text":"Wà ma kaka, bↄkĩi kuo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ĩadama ma wɛ́ siakũ̀,","poem":1},{"lineBreak":true},{"text":"málɛ lɛzunzi za kↄↄ e oosi,","poem":1},{"lineBreak":true},{"text":"ma ↄↄ dↄanzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gɛↄ ni yãbↄnsaɛkɛnɛ́a?","poem":1},{"lineBreak":true},{"text":"Gyaadeↄ mɛ́ aaì fɛlɛ n sáaukpaa?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wì n gbɛ̃kɛ galikɛ miau yã̀?","poem":1},{"lineBreak":true},{"text":"Wì n náaiyã'ò kaalɛu yã̀?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wa n dabudabuↄ dↄ̃ a gusiau yã̀?","poem":1},{"lineBreak":true},{"text":"N maakɛaↄ dↄ̃a ku wɛ́sia guu yã̀?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dii, mi wiilɛma,","poem":1},{"lineBreak":true},{"text":"ma wabikɛa kↄↄ ì ka n kĩ́i.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bↄ́yãi ńlɛ gímazii, Dii?","poem":1},{"lineBreak":true},{"text":"Àkɛa n mikpɛlìmɛɛi?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Má kú ga lɛ́zĩ wɛ̃nannↄ za ma ɛ̀waasogↄↄ,","poem":1},{"lineBreak":true},{"text":"n wɛ́tɛ̃amↄanɛ́ tↄ̃̀a, ma gↄ̃ sã̀ii.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N pↄpaamazi mà ma mia,","poem":1},{"lineBreak":true},{"text":"n vĩa pↄ́ↄ lɛ́ ma midɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A daamala lán íwa za kↄↄ e oosi,","poem":1},{"lineBreak":true},{"text":"à kũ̀aaa míↄmiↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ń tò ma gbɛ̃́ yenzideↄ ma vũaa,","poem":1},{"lineBreak":true},{"text":"gusia mɛ́ gↄ̃̀ ma gbɛ̃na ũ.","poem":1}]}],"footnotes":[{"noteId":110,"caller":"+","text":"88.1 1Kia 5.11","reference":{"chapter":88,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":19}