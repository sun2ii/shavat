{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":89,"content":[{"type":"heading","content":["Lua lɛgbɛ̃a Davidiɛ"]},{"type":"verse","number":1,"content":[{"text":"Ɛzala bui Etani","descriptive":true},{"noteId":111},{"text":"lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dii, máↄ lɛsi n gbɛ̃kɛ yã́ musu láasaiɛ,","poem":1},{"lineBreak":true},{"text":"máↄ n náaiyã kpàwakɛ wɛ̃ ń wɛ̃o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Má o n gbɛ̃kɛ líↄ kpálɛa vĩo,","poem":1},{"lineBreak":true},{"text":"n náaidekɛ zĩ́napɛlɛa musu n bɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N mɛ̀ n bàa kú ń gbɛ̃́ pↄ́ ń sɛ̀o,","poem":1},{"lineBreak":true},{"text":"n lɛgbɛ̃̀ n zↄ̀blena Davidiɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ to aà bui àↄ kible gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ aà kpala gba gbãa e aà buiwa.","poem":1},{"noteId":112}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musudeↄ n dabuyãↄ sáaukpa, Dii,","poem":1},{"lineBreak":true},{"text":"malaikaↄ n náaiyã'ò balu guu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Asa gbɛ̃e ku musu à kà Diiwao,","poem":1},{"lineBreak":true},{"text":"malaikae muaaaànↄo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Baa malaikaↄ kã̀aa, Lua mɛ́ fuańla,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ liaaaàziↄ mɛ ì seena ta.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii Lua Zĩgↄ̃de, démɛ muaannↄi?","poem":1},{"lineBreak":true},{"text":"Ń gbãa ń náaio vĩ yã́pii guu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ni gbãamↄ ísiaɛ,","poem":1},{"lineBreak":true},{"text":"tó à fɛ̀lɛ ń vĩvĩao, ni a zùukɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N Egipiↄ suumpà aa gↄ̃̀ gɛↄ ũ,","poem":1},{"lineBreak":true},{"text":"n n wɛ̀lɛpiↄ fã̀aa ń n gã̀sa gbãao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Musu ń zĩ́lɛoá n pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"n dṹnia kàlɛ ń pↄ́ pↄ́ kú a guuↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N gugbãntoo ń gɛↄmidↄkĩio kɛ̀,","poem":1},{"lineBreak":true},{"text":"Taboo ń Ɛɛmↄ gbɛↄ ì guladↄma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N gã̀saá gↄ̃sa pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"n ↄ gbãa mɛ́ n ↄplaa dↄ musu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yãmaa ń yã́zɛdeo mɛ́ n gĩ́na ɛ̃kpalɛ ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃kɛ ń náaio mɛ́ dia n aɛwa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Báaadeↄn gbɛ̃́ pↄ́ aa guladↄama dↄ̃,","poem":1},{"lineBreak":true},{"text":"aaìↄ bɛ n aɛ gupuauↄ ũ, Dii.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aaìↄ pↄnakɛ ń n tↄ́o gↄↄpii,","poem":1},{"lineBreak":true},{"text":"aaì ĩ́anadã ń n maakɛao.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Asa an gawi ń ń gbãaon n ũ,","poem":1},{"lineBreak":true},{"text":"n zɛawanↄ yã́i wá mi daa ía.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wá sɛ̀ngbaoá Dii pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"wá kíapiá wá Isailiↄ Lua pↄ́ɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"N yã'ò n yãmanaↄnɛ yãa","poem":1},{"lineBreak":true},{"text":"wɛ́pungu'ea guu n mɛ̀:","poem":1},{"lineBreak":true},{"text":"Ma dↄnlɛkɛ̀ nɛgↄ̃naɛ,","poem":1},{"lineBreak":true},{"text":"ma ɛ̀waasopi sɛ̀ lɛsĩ a gbɛ̃́ↄ guu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ma a zↄ̀blena Davidi è,","poem":1},{"lineBreak":true},{"text":"ma a nísikàwà ma aà dìlɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Máↄ aà kũa ma ↄzĩɛ,","poem":1},{"lineBreak":true},{"text":"ma gã̀sa gbãa aↄ kuaànↄ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ibɛɛ a fↄ̃ falusiwào,","poem":1},{"lineBreak":true},{"text":"gbɛ̃vãi a e ↄnaalɛwào.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Má aà wɛ̀lɛↄ wíwi aà aɛ,","poem":1},{"lineBreak":true},{"text":"má aà zangudeↄ kwɛ́.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Máↄ náai vĩɛ̀ ń gbɛ̃kɛo,","poem":1},{"lineBreak":true},{"text":"aà mi iↄ daa ía ń ma tↄ́o.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Má ísia naɛ̀ a ↄzĩɛ,","poem":1},{"lineBreak":true},{"text":"iↄ iko vĩ swaↄwa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"A lɛzumazi à mɛ,","poem":1},{"lineBreak":true},{"text":"má dɛ a Mae ń a Luao ũ,","poem":1},{"lineBreak":true},{"text":"a gbɛsi ń a Suabanao ũ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Má aà kɛ ma yoa ũ,","poem":1},{"lineBreak":true},{"text":"iↄ dɛ dṹnia kíaↄ mide ũ.","poem":1},{"noteId":113}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Máↄ gbɛ̃kɛ vĩaànↄ gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"ma bàa pↄ́ kuaànↄ gbooa vĩo.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Má tó aà bui àↄ kible gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"aà kpala iↄ ku e dṹnia gɛ láaò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Tó aà buiↄ pãkpà ma ikoyãi,","poem":1},{"lineBreak":true},{"text":"mɛ́ aai tɛ ma yãdilɛaↄzio,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"tó aa bↄ̀ ma yã́ kpɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ aa ma yãdanɛↄ kũao,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"má gotↄ̃má an tàaeↄ yã́iɛ,","poem":1},{"lineBreak":true},{"text":"mí ń kɛ búubuu an vãi yã́ musu,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"ãma gbɛ̃kɛ pↄ́ má vĩaànↄ a midɛo,","poem":1},{"lineBreak":true},{"text":"má fↄ̃ náaisaiyãkɛo.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Má a bàa pↄ́ kuaànↄ yã́ gbooo,","poem":1},{"lineBreak":true},{"text":"má lɛ́ pↄ́ má gbɛ̃̀ɛ̀ lilɛo.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ma lɛgbɛ̃̀ ń mazĩa kuao gɛ̃n do,","poem":1},{"lineBreak":true},{"text":"má ɛɛto Davidiɛo, ma mɛ̀,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"aà bui aↄ ku gↄↄpiiɛ,","poem":1},{"lineBreak":true},{"text":"aà kpala aↄ ku ma aɛ lán ĩatɛ̃wa.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Lá mↄvua dɛ seela náaide ũ musu,","poem":1},{"lineBreak":true},{"text":"màa aà kpala aↄ ku gↄↄpii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Ń beeo n gi kía pↄ́ ń kpài,","poem":1},{"lineBreak":true},{"text":"n ↄkpàaàzi, n kolokɛ̀aànↄ.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"N n bàa kua ń n zↄ̀blenao yã́ gbòo,","poem":1},{"lineBreak":true},{"text":"n sakà aà kíafuau, ń zù zĩ́lɛ.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"N aà wɛ̃́lɛ bĩ́iↄ gbòo,","poem":1},{"lineBreak":true},{"text":"n aà zɛgikĩiↄ kwɛ̀ ń dàaĩ.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Gɛ̃zɛadeↄ lɛ́ ń baa sɛu,","poem":1},{"lineBreak":true},{"text":"à gↄ̃̀ láanipↄ ũ a saɛdeↄnɛ.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Ń tò aà wɛ̀lɛↄ gã gbã̀ɛ,","poem":1},{"lineBreak":true},{"text":"ń tò aà ibɛɛↄ pↄnakɛ̀.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"N aà fɛ̃nda lɛ́ dɛ̀,","poem":1},{"lineBreak":true},{"text":"ni zɛaànↄ zĩ guuo.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"N aà gawi kↄ'ɛ̀,","poem":1},{"lineBreak":true},{"text":"n aà báa bↄ̀aàla.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Ń tò à zikũ̀ a gbãau,","poem":1},{"lineBreak":true},{"text":"n widàwà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Dii, ńyↄ̃ↄ ulɛawɛ̃ɛ gↄↄpii yã̀?","poem":1},{"lineBreak":true},{"text":"N pↄkũma tɛ́ aↄ kũ e bↄɛ ni?","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Làasookɛ ma wɛ̃ni kulunkɛwa,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃nazĩna kɛ̀ pã yã̀?","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Gↄ̃sa kpele mɛ́ aↄ ku à gí gaii?","poem":1},{"lineBreak":true},{"text":"Démɛ a fↄ̃ azĩa si mia ikowai?","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Dii, gbɛ̃kɛ pↄ́ ń vĩ yãa gɛ̀ má ni?","poem":1},{"lineBreak":true},{"text":"Lɛ́ pↄ́ ń gbɛ̃̀ Davidiɛ ń náaio sↄ̃ bɛ?","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"To n zↄ̀blena láanikɛa yã́ dↄngu,","poem":1},{"lineBreak":true},{"text":"buiↄ ma kɛa pↄ́ↄpↄↄ ma sↄ̃ zↄ̃̀.","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"N ibɛɛↄ kía pↄ́ ń kpà láanikɛ̀,","poem":1},{"lineBreak":true},{"text":"e gu pↄ́ aà kɛ̀sɛ zɛ̀u, Dii.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Wà Dii sáaukpa gↄↄpii!","poem":1},{"lineBreak":true},{"text":"Ãmi! Ãmi!","poem":1}]}],"footnotes":[{"noteId":111,"caller":"+","text":"89.1 1Kia 5.11","reference":{"chapter":89,"verse":1}},{"noteId":112,"caller":"+","text":"89.5 2Sam 7.12-16, Soũ 132.11, Zĩn 2.30","reference":{"chapter":89,"verse":5}},{"noteId":113,"caller":"+","text":"89.28 Zia 1.5","reference":{"chapter":89,"verse":28}}]},"thisChapterLink":"/api/bqc_sim/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":53}