{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":9,"content":[{"type":"heading","content":["Lua sáaukpaa kɛ́ ì yãkɛkɛ gbɛ̃́ↄnɛ yã́i"]},{"type":"verse","number":1,"content":[{"text":"Davidi lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Dii, má n táasilɛ ń nↄ̀sɛmɛndoo,","poem":1},{"lineBreak":true},{"text":"má n yãbↄnsaɛkɛaↄ kpàwakɛnɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Má pↄnakɛ, má yáalↄ n yã́ musu,","poem":1},{"lineBreak":true},{"text":"Musude, má n tↄbↄ ń lɛsiao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ma ibɛɛↄ ì kpɛkpa,","poem":1},{"lineBreak":true},{"text":"aaì gɛ̃mbↄlɛ aa gaga n aɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Asa n zɛmanↄ, n yãnakpàa,","poem":1},{"lineBreak":true},{"text":"zↄ̃lɛa n gĩ́naa n yãgↄ̃̀gↄ̃ a zɛ́wa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N buipãleↄ lèle,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃vãipiↄ míↄnzↄ̃,","poem":1},{"lineBreak":true},{"text":"n ń tↄ́ dɛ̀ míↄmiↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N músi láasai kpà ma wɛ̀lɛↄzi,","poem":1},{"lineBreak":true},{"text":"n ń wɛ̃́lɛↄ kwɛ̀,","poem":1},{"lineBreak":true},{"text":"an yã́ dↄ gbɛ̃egu lↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii ì kible gↄↄpii,","poem":1},{"lineBreak":true},{"text":"à a kpala dìlɛ yã́kpalɛkɛa yã́i.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A yã́kpalɛkɛ ń dṹnia gbɛ̃́ↄ súsu,","poem":1},{"lineBreak":true},{"text":"a kible buiↄwa a zɛ́wa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dii mɛ́ ulɛkĩi ũ","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ wàlɛ gbãamↄnɛ́ↄnɛ,","poem":1},{"lineBreak":true},{"text":"a dɛnɛ́ aafia'ekĩi ũ taasikɛgↄↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii, gbɛ̃́ pↄ́ n tↄ́ dↄ̃ↄ n náai vĩ,","poem":1},{"lineBreak":true},{"text":"nili n aɛyanaↄ vũaao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"À lɛsi Diiɛ, àlɛ kible Siↄna,","poem":1},{"lineBreak":true},{"text":"à aà yãkɛaↄ kpàwakɛ bui píiɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Asa yã́ lí sãaaguo,","poem":1},{"lineBreak":true},{"text":"ì tↄsi gbɛ̃dɛnawa,","poem":1},{"lineBreak":true},{"text":"ì taasideↄ wiilɛa yãda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Gwa lá ma ibɛɛↄ lɛ́ ĩadaa, Dii,","poem":1},{"lineBreak":true},{"text":"wɛ̃nadↄ̃mɛɛ, ní ma bↄ ga lɛ́zĩ,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"mí lɛ́mama Siↄna bĩ́ibↄlɛu,","poem":1},{"lineBreak":true},{"text":"mí pↄnakɛ kɛ́ n ma suabà yã́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Buiↄ sì ɛ pↄ́ aa yↄ̃̀u,","poem":1},{"lineBreak":true},{"text":"an gbá zù ba pↄ́ aa kpàu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wa Dii dↄ̃ ń yã́kpalɛkɛa a zɛ́waoɛ,","poem":1},{"lineBreak":true},{"text":"ì to gbɛ̃vãi yãkɛa labadaaàla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Gbɛ̃vãiↄ ì ta bɛdau,","poem":1},{"lineBreak":true},{"text":"bui pↄ́ aali Lua yãdaopiↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wɛ̃nadeↄ yã́ a sãaàgu bauo,","poem":1},{"lineBreak":true},{"text":"taaside wɛdↄaaàzi láaa vĩo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Fɛlɛ Dii,","poem":1},{"lineBreak":true},{"text":"ńsu to gbɛ̃nazĩna n gã fĩo,","poem":1},{"lineBreak":true},{"text":"bui píi kãaa, ní yã́kpalɛkɛńnↄ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dii, to vĩa buiↄ kṹ,","poem":1},{"lineBreak":true},{"text":"kɛ́ aa e dↄ̃ wa dɛ gbɛ̃nazĩnaↄ ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}