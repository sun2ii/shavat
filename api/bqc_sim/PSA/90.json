{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":90,"content":[{"type":"heading","content":["Lua ń gbɛ̃nazĩnao"]},{"type":"hebrew_subtitle","content":["Lua gbɛ̃́ Mↄizi wabikɛa."]},{"type":"verse","number":1,"content":[{"text":"Dii, wá ulɛkĩin n ũ wɛ̃ ń wɛ̃o.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E ǹyↄ̃ gɛ́ gbɛ̀sĩsĩↄ kɛi,","poem":1},{"lineBreak":true},{"text":"e ǹyↄ̃ gɛ́ tↄↄlɛ ń dṹniao kálɛi,","poem":1},{"lineBreak":true},{"text":"Luan n ũ za asĩnizĩ e gↄↄpii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ni dilɛ gbɛ̃nazĩnaɛ aà gɛ̃ tɛ̃́ɛnau,","poem":1},{"lineBreak":true},{"text":"ni to aà ɛa gↄ̃ bùsuti ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wɛ̃̀ ↄ̀aa sↄo dɛnɛ lán gↄↄ dowa,","poem":1},{"noteId":114},{"lineBreak":true},{"text":"ì gɛ̃nɛ lán gĩa ge gwãasĩnawa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ni to i dańla aai gaga,","poem":1},{"lineBreak":true},{"text":"aa dɛ lán sɛ̃ pↄ́ ì bↄlɛ kↄↄwa,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ì bↄlɛ kↄↄ, i gbã́,","poem":1},{"lineBreak":true},{"text":"ì i'o oosi, i giigaga.","poem":1},{"noteId":115}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N pↄkũma ì wá suumpa,","poem":1},{"lineBreak":true},{"text":"n kòlokɛa ì gili gɛ̃wágu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wá yãvãiↄ kálɛa n aɛ,","poem":1},{"lineBreak":true},{"text":"wá asiiyãↄ bↄ̀ gupuau n kuu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wá gↄↄ ì gɛ̃kↄ̃u n kpɛ̃nɛ yã́i,","poem":1},{"lineBreak":true},{"text":"wá wɛ̃ni ì midɛ wá wea dóũdoũnau.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wá wɛ̃ ì ka bàaↄ̃kwi taawa,","poem":1},{"lineBreak":true},{"text":"tó wá gbãa sↄ̃, basiiↄ̃.","poem":1},{"lineBreak":true},{"text":"Wɛ̃piↄ guu baa a pↄ́ pↄ́ na","poem":1},{"lineBreak":true},{"text":"ì mↄ́ ń taasio ń pↄsiaoɛ,","poem":1},{"lineBreak":true},{"text":"ì gɛ̃zɛa kpakpa, ↄ̃ wi kpagui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Démɛ n pↄkũma gbãa lɛ́ dↄ̃i?","poem":1},{"lineBreak":true},{"text":"Démɛ n kpɛ̃nɛ lɛ́ dↄ̃ à vĩakɛɛ̀i?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dadawɛ̃ɛ wàↄ wá wɛ̃ni dↄ̃ màa,","poem":1},{"lineBreak":true},{"text":"kɛ́ wà ↄ̃nↄ e wá sↄ̃ guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dii, ńyↄ̃ ɛa wá wɛgwa bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Wɛ̃nadↄ̃ n zↄ̀blenaↄnɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tó gu dↄ̀, to n gbɛ̃kɛ mↄ́wá,","poem":1},{"lineBreak":true},{"text":"wíↄ pↄnakɛ ń gulakɛao gↄↄpii.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wá gba pↄna ↄ pↄ́ ń tↄ̃̀wá gↄↄ lɛ́u,","poem":1},{"lineBreak":true},{"text":"taasi pↄ́ wá kɛ̀ wɛ̃̀ lɛ́u.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ǹ n yãkɛaↄ ↄlↄ n zↄ̀blenaↄnɛ,","poem":1},{"lineBreak":true},{"text":"ní tó wá nɛ́ↄ n iko gbãa dↄ̃.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dii wá Lua, báaadawágu nana,","poem":1},{"lineBreak":true},{"text":"ɛ̀fãaida wá zĩu wàↄ kã́fĩakɛ,","poem":1},{"lineBreak":true},{"text":"ao, ɛ̀fãaida wá zĩu wàↄ kã́fĩakɛ.","poem":1}]}],"footnotes":[{"noteId":114,"caller":"+","text":"90.4 2Piɛ 3.8","reference":{"chapter":90,"verse":4}},{"noteId":115,"caller":"+","text":"90.6 Zaa 1.11","reference":{"chapter":90,"verse":6}}]},"thisChapterLink":"/api/bqc_sim/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}