{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":91,"content":[{"type":"heading","content":["Lua mɛ́ wá dↄ̃̀ana ũ"]},{"type":"verse","number":1,"content":[{"text":"Gbɛ̃́ pↄ́ ulɛa Musude ↄ guu,","poem":1},{"lineBreak":true},{"text":"mɛ́ a ku Gbãapiide uei,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ì mɛ Dii mɛ́ a zɛgikĩi ũ,","poem":1},{"lineBreak":true},{"text":"a Lua mɛ́ a ulɛkĩi ũ, á aà náai vĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"A n si kaiwa,","poem":1},{"lineBreak":true},{"text":"a n suaba ń gagyão.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A n sↄlↄ a pↄlɛu,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ↄ ulɛa aà kúlukulunau.","poem":1},{"lineBreak":true},{"text":"Aà náai mɛ́ aↄ dɛ n sɛ̀ngbao ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gwãasĩn pↄ́ↄ ń fãanɛ kà kpán'ãaↄ","poem":1},{"lineBreak":true},{"text":"an kee vĩa a n kũo,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ge gagyã pↄ́ ìↄ bɛ gusiau","poem":1},{"lineBreak":true},{"text":"ge gyãkawɛ̃lɛ pↄ́ ì ń le fãanɛ gbãa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Baa tó gbɛ̃ↄn ↄ̀aa sↄo lɛ́ kwɛ́ n saɛ,","poem":1},{"lineBreak":true},{"text":"ge gbɛ̃ↄn ↄ̀aasↄsↄo lɛɛ kwi lɛ́ fu n ↄplaai,","poem":1},{"lineBreak":true},{"text":"pↄe a n leo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wɛzu ǹ gwa,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ e lá wì ĩada vãikɛnaↄwa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó n Musude dìlɛ n ulɛkĩi ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ n Dii dìlɛ n kúkĩi ũ,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"vãie a sↄ̃nzio,","poem":1},{"lineBreak":true},{"text":"músi a gɛ̃ n uao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Asa a n yã'o a malaikaↄnɛ","poem":1},{"lineBreak":true},{"text":"aa n dↄ̃́a gu pↄ́ ńlɛ gɛ́u píiɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aa ↄdama,","poem":1},{"lineBreak":true},{"text":"kɛ́ ńsu gɛ̃nalɛ gbɛwao yã́i.","poem":1},{"noteId":116}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ńyↄ̃ táa'o nↄ̀ↄmusuwa ń kyã́o,","poem":1},{"lineBreak":true},{"text":"ńyↄ̃ ↄ̃zↄ̃ nↄ̀ↄkusiwa ń mlɛ̃̀ pãsĩo.","poem":1},{"noteId":117}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dii mɛ̀: Lá à nàmazi, má aà bↄ,","poem":1},{"lineBreak":true},{"text":"lá a ma dↄ̃, má aà sɛ musu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A lɛzumazi, mí wewà.","poem":1},{"lineBreak":true},{"text":"Tó yã́ nàɛwà, máↄ kuaànↄ,","poem":1},{"lineBreak":true},{"text":"má aà suaba, mí aà kpɛla.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Má báaadaaàgu ń wɛ̃ni gbã̀ao,","poem":1},{"lineBreak":true},{"text":"má aà suaba, i pↄnakɛò.","poem":1}]}],"footnotes":[{"noteId":116,"caller":"+","text":"91.12 Mat 4.6, Luk 4.10-11","reference":{"chapter":91,"verse":12}},{"noteId":117,"caller":"+","text":"91.13 Luk 10.19, Lom 16.20","reference":{"chapter":91,"verse":13}}]},"thisChapterLink":"/api/bqc_sim/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}