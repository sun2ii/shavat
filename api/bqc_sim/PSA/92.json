{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":92,"content":[{"type":"heading","content":["Lua sáaukpaa"]},{"type":"verse","number":1,"content":[{"text":"Kã́mabogↄↄ lɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"A maa wà n sáaukpaɛ, Dii,","poem":1},{"lineBreak":true},{"text":"wá lɛsi wà n tↄbↄ, Musude,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"wí n gbɛ̃kɛ galikɛ kↄↄ,","poem":1},{"lineBreak":true},{"text":"wí n náaiyã'ò gwã́,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"wí n táasilɛ ń mↄↄnao","poem":1},{"lineBreak":true},{"text":"ń domao ń kotilio.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N yãkɛaↄ ì ma pↄ kɛ na, Dii,","poem":1},{"lineBreak":true},{"text":"mi guladↄ n ↄzĩkɛaↄwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii, n yãkɛaↄ zↄ̃ↄ maamaaɛ,","poem":1},{"lineBreak":true},{"text":"n làasooↄ gbia à kɛ̀ zài.","poem":1},{"noteId":118}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sↄũ yã́pi dↄ̃o,","poem":1},{"lineBreak":true},{"text":"mìsaide a fↄ̃ mao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Baa tó gbɛ̃vãiↄ ↄtà lán kàewa,","poem":1},{"lineBreak":true},{"text":"mɛ́ vãikɛnaↄ kã́fĩa è ḿpii,","poem":1},{"lineBreak":true},{"text":"an zia dɛ kaalɛ láasai ũɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mpi sↄ̃ Dii, ńyↄ̃ↄ kã́fĩa gↄↄpiiɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹ n ibɛɛↄ gwa, aalɛ midɛ,","poem":1},{"lineBreak":true},{"text":"vãikɛnaↄ lɛ́ fãaa píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"N ma gba gbãa lán zùsɛ̃lɛwa,","poem":1},{"lineBreak":true},{"text":"n nísi ↄde kà ma miwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma wɛsì ma wɛ̀lɛↄ fualɛ,","poem":1},{"lineBreak":true},{"text":"ma swã́ ma ibɛɛ vãiↄ wii mà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ gbã lán daminaliↄwa,","poem":1},{"lineBreak":true},{"text":"aa zↄ̃ↄkũ lán Libã sɛdɛ líↄwa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Pɛ́lɛa Dii kpɛ́ kpɛɛlɛ","poem":1},{"lineBreak":true},{"text":"aa gbã wá Lua ua.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ń ń zikũakɛo aaↄ nɛ'iɛ,","poem":1},{"noteId":119},{"lineBreak":true},{"text":"an lá aↄ nísi bↄɛ si plɛ̀plɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aa mɛ Dii maa,","poem":1},{"lineBreak":true},{"text":"ↄ̃mɛ wá gbɛsi ũ,","poem":1},{"lineBreak":true},{"text":"vãie ku aà guuo.","poem":1}]}],"footnotes":[{"noteId":118,"caller":"+","text":"92.6 Lom 11.34","reference":{"chapter":92,"verse":6}},{"noteId":119,"caller":"+","text":"92.15 Zãa 15.2","reference":{"chapter":92,"verse":15}}]},