{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":94,"content":[{"type":"heading","content":["Lua mɛ́ yã́kpalɛkɛna ũ"]},{"type":"verse","number":1,"content":[{"text":"Dii á Lua pↄ́ ì tↄsimáɛ.","poem":1},{"lineBreak":true},{"text":"Lua pↄ́ ì tↄsimá, bↄ gupuau!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dṹnia yã́kpalɛkɛna, fɛlɛ!","poem":1},{"lineBreak":true},{"text":"Fĩa bo ĩ́andãnaↄnɛ ń yãkɛawa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃vãiↄ aaↄ pↄnakɛ e bↄɛ ni?","poem":1},{"lineBreak":true},{"text":"Aaↄ tidↄwála e bↄɛ ni, Dii?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vãikɛnapiↄ ì gↄ̃sagↄ̃sa yã'o,","poem":1},{"lineBreak":true},{"text":"aaì yãbↄlɛ, aaì ĩ́anadã ḿpii.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii, aaì táa'o n gbɛ̃́ↄwa,","poem":1},{"lineBreak":true},{"text":"aaì gbãamↄ gbɛ̃́ pↄ́ n ń sɛ́piↄnɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aaì gyaa gbɛ̃andoↄ ń bↄ̀mↄↄ dɛdɛ,","poem":1},{"lineBreak":true},{"text":"aaì tonɛ pↄ́ gwana vĩoↄ suumpa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aaì mɛ Dii lɛ́ ń eo,","poem":1},{"lineBreak":true},{"text":"Yakↄbu buiↄ Lua laai kúmáo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Á sↄũↄ, à laaika!","poem":1},{"lineBreak":true},{"text":"Á mìsaideↄ, á ↄ̃nↄkũ bↄɛɛ la?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Lua swã́ pɛ̀, ìli yãmao lé?","poem":1},{"lineBreak":true},{"text":"À wɛ́ kàsa, ìli gu'eo lé?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ì bui píi toto, a ń swã́gagaoa?","poem":1},{"lineBreak":true},{"text":"Ì yãdanɛ́, a dↄ̃a vĩoa?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii gbɛ̃nazĩna làasooↄ dↄ̃,","poem":1},{"lineBreak":true},{"text":"a dↄ̃ kɛ́ aa yãfũu lán gbɛ́ tíwa.","poem":1},{"noteId":120}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Báaaden gbɛ̃́ pↄ́ ni toto,","poem":1},{"lineBreak":true},{"text":"ni n ikoyã dadaɛ ũ, Dii.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ni aà nↄ̀sɛ daɛ̀ doũ taasikɛgↄↄ,","poem":1},{"lineBreak":true},{"text":"e wà gɛ ɛyↄ̃ vãikɛnaɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii a pãkpa a gbɛ̃́ↄzio,","poem":1},{"lineBreak":true},{"text":"a gbɛ̃́ pↄ́ á sɛ̀ a pↄ́ ũↄ vũaao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wa ɛa yã́kpalɛkɛ a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuadeↄ i zɛò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Démɛ a fɛlɛmɛɛ gbɛ̃vãiↄwai?","poem":1},{"lineBreak":true},{"text":"Démɛ a zɛmanↄ vãikɛnaↄ musui?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mɛ́ i kɛ Dii dↄnlɛkɛ̀mɛɛ yãa no,","poem":1},{"lineBreak":true},{"text":"dↄ̃ má kú miau kílikili gↄ̃̀ↄ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kɛ́ ma mɛ̀ zãana lɛ́ ma sɛ́lɛ,","poem":1},{"lineBreak":true},{"text":"n ma kũ n gbɛ̃kɛ guu, Dii.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kɛ́ ma làasoo kↄ̃̀ ma sↄ̃u,","poem":1},{"lineBreak":true},{"text":"n ma sↄ̃ nìnimɛɛ n ma pↄ kɛ̀na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"N lɛ́ líↄ ku yã́gↄ̃gↄ̃n koleaↄ yã́uo,","poem":1},{"lineBreak":true},{"text":"an yãdilɛaↄ ì mↄnɛ́ ń taasio.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aaì lɛkpaaĩ gbɛ̃maazi,","poem":1},{"lineBreak":true},{"text":"aaì yãda tàaesaidea wà aà dɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dii mɛ́ ma zɛgikĩi ũ,","poem":1},{"lineBreak":true},{"text":"ma Lua mɛ́ gbɛsi pↄ́ mi ulɛu ũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A ń vãikɛa sↄaamáɛ,","poem":1},{"lineBreak":true},{"text":"i ń buibↄ an tàaeↄ yã́i,","poem":1},{"lineBreak":true},{"text":"Dii wá Lua a ń buibↄ.","poem":1}]}],"footnotes":[{"noteId":120,"caller":"+","text":"94.11 1Kln 3.20","reference":{"chapter":94,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}