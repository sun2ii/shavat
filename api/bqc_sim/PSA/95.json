wá gbɛɛu","poem":1},{"lineBreak":true},{"text":"wà kúlɛ Dii wá Kɛna aɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Asa aàpi mɛ́ wá Lua ũ,","poem":1},{"lineBreak":true},{"text":"wá dɛ aà kpàsa gbɛ̃́ↄ ũɛ,","poem":1},{"lineBreak":true},{"text":"aà sã pↄ́ àlɛ ń dãↄ ũ.","poem":1},{"lineBreak":true},{"text":"Tó a aà lↄↄ mà gbã,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ásu swã́gbãakɛ lá á deziↄ kɛ̀ Mɛliba","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ aa ku Masa guwaiwaiuwao.","poem":1},{"noteId":121}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Baa kɛ́ aa ma yãkɛaↄ è,","poem":1},{"lineBreak":true},{"text":"aa ma yↄ̃ aa ma gbãa lɛgwà.","poem":1},{"noteId":122}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɔ̃ má ye ń gĩyãio e wɛ̃̀ bla,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀ gbɛ̃́ sã́sãaↄnɛ,","poem":1},{"lineBreak":true},{"text":"aa ma yãkɛaↄ dↄ̃o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má ò ń mazĩao ń pↄfɛ̃o ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"aa gɛ̃ ma kã́mabokĩiuo.","poem":1},{"noteId":123}]}],"footnotes":[{"noteId":121,"caller":"+","text":"95.8 Ɛbɛ 3.15","reference":{"chapter":95,"verse":8}},{"noteId":122,"caller":"+","text":"95.9 Bↄa 17.1-7, Ɛbɛ 3.7-11","reference":{"chapter":95,"verse":9}},{"noteId":123,"caller":"+","text":"95.11 Nao 14.20-23, Ɛbɛ 4.3, 5","reference":{"chapter":95,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}