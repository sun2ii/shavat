{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":96,"content":[{"type":"heading","content":["Dii mɛ́ Kía zↄ̃ↄ ũ"]},{"type":"verse","number":1,"content":[{"text":"À lɛ̀ dafu sí Diiɛ,","poem":1},{"lineBreak":true},{"text":"dṹnia gbɛ̃́pii, à lɛsi Diiɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À lɛsi Diiɛ, í aà tↄbↄ,","poem":1},{"lineBreak":true},{"text":"àↄ aà zĩblea baokpa lá gu lɛ́ dↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À aà gawi yã'o buiↄnɛ,","poem":1},{"lineBreak":true},{"text":"à aà yãbↄnsaɛↄ galikɛ gbɛ̃́piiɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii zↄ̃ↄ, à kà wà aà táasilɛ,","poem":1},{"lineBreak":true},{"text":"à kà wà vĩakɛɛ̀ dɛ diiↄla píi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Buipãleↄ diiↄá pↄ́ gianaↄnɛ,","poem":1},{"lineBreak":true},{"text":"Dii mɛ́ musu kɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zↄ̃ↄkɛ ń bɛɛɛo kuwà,","poem":1},{"lineBreak":true},{"text":"gbãa ń gawio ku aà kĩ́iɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À gawi ń gbãao dↄ̃ Diiɛ,","poem":1},{"lineBreak":true},{"text":"bùsu píi gbɛ̃́ↄ, à dↄ̃ Diiɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À Dii tↄ́ gawi dↄ̃ɛ̀,","poem":1},{"lineBreak":true},{"text":"à mↄ aà ua, í aà gba pↄ́.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À kúlɛ Diiɛ ń lousisi'ulaↄ daa,","poem":1},{"lineBreak":true},{"text":"zĩ́lɛdeↄ, à tó á mɛ àↄ kukɛ aà aɛ,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"í o bui píiɛ, Dii mɛ́ lɛ́ kible.","poem":1},{"lineBreak":true},{"text":"À dṹnia kàlɛ gíũgiũ, a deea vĩo.","poem":1},{"lineBreak":true},{"text":"A yã́kpalɛkɛ ń gbɛ̃́piio a zɛ́wa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Musudeↄ, à pↄnakɛ,","poem":1},{"lineBreak":true},{"text":"zĩ́lɛdeↄ, à vĩ àↄ kɛ̃aa,","poem":1},{"lineBreak":true},{"text":"ísia ń pↄ́ pↄ́ kúuↄ, à kↄ̃fĩkɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sɛ̃̀a ń pↄ́ pↄ́ kúuↄ, à kúkuakɛ,","poem":1},{"lineBreak":true},{"text":"lí pↄ́ kú lákpɛuↄ i gulakɛ píi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aa pↄnakɛ Dii aɛ, asa àlɛ mↄ́,","poem":1},{"lineBreak":true},{"text":"àlɛ mↄ́ yã́kpalɛkɛi ń dṹniaoɛ.","poem":1},{"lineBreak":true},{"text":"A yã́kpalɛkɛ ń dṹniao a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"a yã́gↄ̃gↄ̃ gbɛ̃́ↄnɛ ń sĩanao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}