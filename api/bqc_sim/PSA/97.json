{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":97,"content":[{"type":"heading","content":["Dii mↄa"]},{"type":"verse","number":1,"content":[{"text":"Dii mɛ́ lɛ́ kible!","poem":1},{"lineBreak":true},{"text":"Dṹnia gbɛ̃́ↄ, à pↄnakɛ,","poem":1},{"lineBreak":true},{"text":"ísiabaadeↄ, àↄ ku pↄna guu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Luabɛpuana ń a sianao liaaaàzi,","poem":1},{"lineBreak":true},{"text":"yã́zɛde ń yãmaao mɛ́ aà kpala zĩ́na ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɛ́ ìↄ dↄaaaɛ̀,","poem":1},{"lineBreak":true},{"text":"ì kũ aà ibɛɛ pↄ́ liaaaàziↄwa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aà loupilɛaↄ ì tↄↄlɛ pu,","poem":1},{"lineBreak":true},{"text":"tó dṹnia è, ì lualua.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̀sĩsĩↄ ì yↄ lán zↄ́nisiwa Dii aɛ,","poem":1},{"lineBreak":true},{"text":"dṹnia gbɛ̃́pii Diipi aɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Musudeↄ ì aà maakɛa kpàwakɛ,","poem":1},{"lineBreak":true},{"text":"bùsu píi gbɛ̃́ↄ ì aà gawi e.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wí ì tã́agbagbanaↄ kṹ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aaì ĩ́anadã ń tã́apiↄ.","poem":1},{"lineBreak":true},{"text":"Diipiↄ kúlɛ aà aɛ ḿpiiɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tó Siↄnadeↄ mà, aa pↄnakɛ,","poem":1},{"lineBreak":true},{"text":"Yuda wɛ̃́lɛdeↄ aaↄ ku pↄna guu","poem":1},{"lineBreak":true},{"text":"n yã́kpalɛkɛaↄ yã́i, Dii.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii Musuden n ũ dṹnia gbɛ̃́piiɛ,","poem":1},{"lineBreak":true},{"text":"n zↄ̃ↄ dɛ diiↄla píi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gbɛ̃́ pↄ́ ye Diiziↄ, à za vãigu.","poem":1},{"lineBreak":true},{"text":"Ìↄ a yãmanaↄ wɛ̃ni kũanɛ́,","poem":1},{"lineBreak":true},{"text":"ì ń bↄ vãikɛnaↄ ↄu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ì gupu gbɛ̃maaↄnɛ ń zɛ́u,","poem":1},{"lineBreak":true},{"text":"ì pↄna tↄ̃ nↄ̀sɛpuadeↄ guu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃maaↄ, à tó á pↄ kɛ Diiwa na,","poem":1},{"lineBreak":true},{"text":"à aà tↄbↄ, asa a ku adoa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}