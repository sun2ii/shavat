{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":98,"content":[{"type":"heading","content":["Dii mↄa táasilɛa"]},{"type":"verse","number":1,"content":[{"text":"À lɛ̀ dafu sí Diiɛ,","poem":1},{"lineBreak":true},{"text":"asa à yãbↄnsaɛↄ kɛ̀,","poem":1},{"lineBreak":true},{"text":"à zĩblè ń a gã̀sa pↄ́ a kua adoa gbãao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii tò wa dↄ̃̀ a zĩblè,","poem":1},{"lineBreak":true},{"text":"à a gbɛ̃suabaa gbãa ↄ̀lↄ bui píiɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛ ń náai pↄ́ a vĩ ń wá Isailiↄ dↄaàgu.","poem":1},{"lineBreak":true},{"text":"E dṹnia lɛ́wa wa è lá wá Lua zĩblè.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dṹnia gbɛ̃́pii, à pↄna wii dↄ Diiwa,","poem":1},{"lineBreak":true},{"text":"à vĩ ń wiio, à gulakɛ à lɛ̀ sí.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À lɛsi Diiɛ ń mↄↄnlɛao,","poem":1},{"lineBreak":true},{"text":"ń mↄↄnlɛao ń lɛtɛ̃dↄawao","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ń kã̀aepɛao ń kuu'ↄo,","poem":1},{"lineBreak":true},{"text":"à pↄna wii dↄ Dii wá Kíawa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ísia ń pↄ́ pↄ́ kúuↄ, à kↄ̃fĩkɛ,","poem":1},{"lineBreak":true},{"text":"ń tↄↄlɛo ń gbɛ̃́ pↄ́ kuwàↄ píi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Swaↄ, à gã̀alɛ Dii aɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̀sĩsĩↄ, à gulakɛ sãnusãnu,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"asa àlɛ mↄ́ yã́kpalɛkɛi tↄↄlɛɛ.","poem":1},{"lineBreak":true},{"text":"A yã́kpalɛkɛ ń dṹniao a zɛ́wa,","poem":1},{"lineBreak":true},{"text":"a yã́gↄ̃gↄ̃ gbɛ̃́ↄnɛ ń sĩanao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}