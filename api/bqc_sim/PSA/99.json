{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"PSA","translationId":"bqc_sim","name":"Soũↄ","commonName":"Soũↄ","title":"SOŨƆ","order":19,"numberOfChapters":150,"sha256":"cd8145a8b7405035eb756530c8703931d5353730b4dfeea2200cac65c342641e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqc_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":99,"content":[{"type":"heading","content":["Lua kuaadoade"]},{"type":"verse","number":1,"content":[{"text":"Dii mɛ́ lɛ́ kible,","poem":1},{"lineBreak":true},{"text":"bui píi lɛ́ lualua,","poem":1},{"lineBreak":true},{"text":"a zↄ̃lɛa malaika gã̀sĩadeↄ zãnguo,","poem":1},{"noteId":124},{"lineBreak":true},{"text":"dṹnia lòo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii zↄ̃ↄ Siↄna,","poem":1},{"lineBreak":true},{"text":"a ku musu, a dɛ bui píila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aa aà tↄ́ zↄ̃ↄ pↄ́ ì to vĩa ń kṹ bↄ,","poem":1},{"lineBreak":true},{"text":"asa aà kua adoaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wá Kía gbãa vĩ, a ye yã́zɛdei,","poem":1},{"lineBreak":true},{"text":"Ɔ̃mɛ yã́kpalɛkɛa a zɛ́wa dà,","poem":1},{"lineBreak":true},{"text":"à yãgↄ̃̀gↄ̃ Yakↄbu buiↄnɛ a zɛ́wa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À Dii wá Lua tↄbↄ,","poem":1},{"lineBreak":true},{"text":"à kúlɛ aà gbadibↄ saɛ,","poem":1},{"lineBreak":true},{"text":"aà kua adoaɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mↄizi ń Aalonao mɛ́ aà gbàgbanaↄ ũ,","poem":1},{"lineBreak":true},{"text":"Samuɛli mɛ́ aà sìsinaↄ do ũ.","poem":1},{"lineBreak":true},{"text":"Aa lɛzùaàzi, ↄ̃ a wèmá.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kua tɛlu guu à yã'ònɛ́,","poem":1},{"noteId":125},{"lineBreak":true},{"text":"aa aà ikoyã ń aà yãdilɛnɛↄ kũa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii wá Lua, ń wèmá,","poem":1},{"lineBreak":true},{"text":"Lua sùuuden n ũ.","poem":1},{"lineBreak":true},{"text":"Ń beeo n ń yãvãiↄ wìnɛ́ ń musu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À Dii wá Lua tↄbↄ,","poem":1},{"lineBreak":true},{"text":"à kúlɛɛ̀ aà gbɛ̀sĩsĩ pↄ́ a kua adoa musu,","poem":1},{"lineBreak":true},{"text":"asa Dii wá Lua kua adoaɛ.","poem":1}]}],"footnotes":[{"noteId":124,"caller":"+","text":"99.1 Bↄa 25.22","reference":{"chapter":99,"verse":1}},{"noteId":125,"caller":"+","text":"99.7 Bↄa 33.9","reference":{"chapter":99,"verse":7}}]},"thisChapterLink":"/api/bqc_sim/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}