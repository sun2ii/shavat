{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"REV","translationId":"bqc_sim","name":"Zia yã́","commonName":"Zia yã́","title":"ZIA YÃ","order":66,"numberOfChapters":22,"sha256":"bc71d20855ddd41d8e3c332eb4bdb7f2633f20e57c8486fec3e8072b3ba67918","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bqc_sim/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":15,"content":[{"type":"heading","content":["Kìsia gbɛzã mɛ̀n soplaↄ kpaańzi"]},{"type":"verse","number":1,"content":["Ɔ̃ ma seela pãle è luabɛ, a zↄ̃ↄ, à bↄ̀ ma saɛ. Malaika gbɛ̃ↄn soplaↄ kìsia gbɛzã mɛ̀n soplaↄ kũa. Bee Lua a a pↄkũmabↄbↄama midɛò."]},{"type":"verse","number":2,"content":["Ɔ̃ ma pↄe è lán ísiwa, a da lán díiwa yãalɛa ń tɛ́o. Ma gbɛ̃́ pↄ́ aa zĩblè wàiwa ń aà taao ń aà tↄ́ nimɛloooↄ è zɛa díi pↄ́ da lán ísiwapi saɛ, aa mↄↄna pↄ́ Lua kpàmáↄ kũa."]},{"type":"verse","number":3,"content":["Aalɛ Lua zↄ̀blena Mↄizi lɛ",{"noteId":110},"sí ń Sã pↄ́o aa mɛ̀:",{"text":"Dii Lua Gbãapiide,","poem":1},{"lineBreak":true},{"text":"n yãkɛaↄ zↄ̃ↄ, aa bↄ̀ wá saɛ.","poem":1},{"lineBreak":true},{"text":"Bui píi Kía,","poem":1},{"lineBreak":true},{"text":"ni yãkɛ a zɛ́wa ń sĩanao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii, démɛ n vĩa vĩo ni?","poem":1},{"lineBreak":true},{"text":"Démɛ a gí n tↄbↄii?","poem":1},{"lineBreak":true},{"text":"Asa ndo n kua mɛ́ adoa.","poem":1},{"lineBreak":true},{"text":"Bui píi a mↄ kúlɛnɛ,","poem":1},{"noteId":111},{"lineBreak":true},{"text":"asa n maakɛaↄ bↄ̀ gupuau.","poem":1}]},{"type":"verse","number":5,"content":["Bee gbɛa ma Lua kpɛ́ è wɛ̃a musu, zwã̀akpɛ pↄ́ aà ikoyã kúu ũ.",{"noteId":112}]},{"type":"verse","number":6,"content":["Ɔ̃ malaika gbɛ̃ↄn sopla pↄ́ kìsia mɛ̀n sopla kũaↄ bↄ̀lɛ kpɛ́piu. Aa bàabaa pua táitai tɛkɛa dadaa, vua asana dↄdↄa ń kùawa."]},{"type":"verse","number":7,"content":["Ɔ̃ pↄ́ bɛ̃́ɛ mɛ̀n síiↄ̃ↄ do vua tùu kpà malaika gbɛ̃ↄn soplapiↄwa ń miwa. Lua pↄ́ ìↄ bɛ̃́ɛ gↄↄpii pↄkũma ká ń pai."]},{"type":"verse","number":8,"content":["Lua gawi ń a gbãao súɛlɛ kpɛ́pi pà.",{"noteId":113},"Gbɛ̃e a fↄ̃ gɛ̃uo e malaika gbɛ̃ↄn soplaↄ kìsia mɛ̀n soplapiↄ gɛ midɛò."]}],"footnotes":[{"noteId":110,"caller":"+","text":"15.3 Bↄa 15.1","reference":{"chapter":15,"verse":3}},{"noteId":111,"caller":"+","text":"15.4 Soũ 86.9","reference":{"chapter":15,"verse":4}},{"noteId":112,"caller":"+","text":"15.5 Bↄa 40.34","reference":{"chapter":15,"verse":5}},{"noteId":113,"caller":"+","text":"15.8 1Kia 8.10-11, Isa 6.4","reference":{"chapter":15,"verse":8}}]},"thisChapterLink":"/api/bqc_sim/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}