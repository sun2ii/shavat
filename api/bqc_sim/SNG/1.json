{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"SNG","translationId":"bqc_sim","name":"Salomↄↄ lɛ","commonName":"Salomↄↄ lɛ","title":"SALOMƆƆ LƐ","order":22,"numberOfChapters":8,"sha256":"93595c3b8dfe8da739db092b2caab86401d5855caaa0acc858a58fe278108496","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/bqc_sim/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Lɛↄ mide pↄ́ Salomↄↄ dà.",{"noteId":0}]},{"type":"verse","number":2,"content":[{"text":"Lɛ́pɛ ma lɛ́wa,","poem":1},{"lineBreak":true},{"text":"asa n yeamazi na dɛmɛɛ vɛ̃ɛa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N tulaleↄ gĩ na.","poem":1},{"lineBreak":true},{"text":"N tↄ́ na lán tulale lɛ́kulɛa gĩwa.","poem":1},{"lineBreak":true},{"text":"Bee yã́ mɛ́ tò wɛ̃́ndiaↄ yenzi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma sɛ wà ta kpakpa.","poem":1},{"lineBreak":true},{"text":"Kí, gɛ̃manↄ n kpɛ́u.","poem":1},"Yelusalɛũ nɛnↄnaↄ",{"text":"Kí, wálɛ pↄnakɛ n yã́ musu,","poem":1},{"lineBreak":true},{"text":"wálɛ yasenapa,","poem":1},{"lineBreak":true},{"text":"wá n yeańzi na bo dɛ vɛ̃ɛa.","poem":1},"Nↄɛ",{"text":"Aaìↄ yenzi a zɛ́wa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yelusalɛũ nɛnↄnaↄ,","poem":1},{"lineBreak":true},{"text":"má sia mɛ́ má kɛfɛũ.","poem":1},{"lineBreak":true},{"text":"Má sia lán Kedaa zwã̀akpɛↄwa,","poem":1},{"lineBreak":true},{"text":"má kɛfɛũ lán Salomↄↄ kpɛ́ zwãaↄwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ásu àↄ ma gwa ma siakɛ yã́io,","poem":1},{"lineBreak":true},{"text":"ĩatɛ̃ mɛ́ ma lɛ.","poem":1},{"lineBreak":true},{"text":"Ma dãↄↄ pↄ pàmaziɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ aa ma da vɛ̃ɛbugwaa zĩu.","poem":1},{"lineBreak":true},{"text":"Mi e ma azĩa pↄ́ kɛ̀kɛo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N gbɛ̃́ pↄ́ ma nisĩna yenzi,","poem":1},{"lineBreak":true},{"text":"ǹ n sãↄ dã́dãkɛkĩi omɛɛ.","poem":1},{"lineBreak":true},{"text":"Mákĩi ni to aa ĩatɛ̃ dɛui?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi máↄ ku n gbɛ̃́ↄ sã waiↄ saɛ sã́sãai?","poem":1}]},{"type":"verse","number":8,"content":[{"text":"N gbɛ̃́ pↄ́ n nↄankɛ dɛ nↄɛↄla píi,","poem":1},{"lineBreak":true},{"text":"tó ń gupi dↄ̃o, tɛ sãↄ iai,","poem":1},{"lineBreak":true},{"text":"ní n blenɛↄ dã sãdãnaↄ bòo saɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃na, ń kɛfɛũmɛɛ","poem":1},{"lineBreak":true},{"text":"lán Falaↄ̃ↄ sↄ̃da pↄ́ ì godↄnɛ́ↄ dowa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N gɛɛↄ maa, n swã́liↄ n sɛ,","poem":1},{"lineBreak":true},{"text":"n ↄ̃nɛɛↄ kↄ̃sì ń n nↄɛo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wá swã́liↄ pinɛ ń vuao,","poem":1},{"lineBreak":true},{"text":"wí ã́nusu pɛ́lɛpɛlɛu.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"Gↄↄ pↄ́ kía gɛngɛsɛkɛa,","poem":1},{"lineBreak":true},{"text":"ma tulale gĩ dↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ma yenzide dɛmɛɛ","poem":1},{"lineBreak":true},{"text":"lí'ↄ gĩnana pↄ́ looa ma yↄ̃́ taau ũ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma yenzide dɛmɛɛ ãyã ligↄ̃n vude","poem":1},{"lineBreak":true},{"text":"pↄ́ wà bↄ̀ò Ɛ̃ngɛdi vɛ̃ɛbua ũɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Ma gbɛ̃na, ń kɛfɛũ fá!","poem":1},{"lineBreak":true},{"text":"N wɛ́ kɛfɛũ lán felen wɛ́wa.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Ma yenzide, ń kɛfɛũ fá!","poem":1},{"lineBreak":true},{"text":"N zɛa maa!","poem":1},{"lineBreak":true},{"text":"Wá wúlɛkĩiá sɛ̃̀bↄlↄɛ,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"wá kpɛ́ zaↄá sɛdɛ líↄnɛ,","poem":1},{"lineBreak":true},{"text":"wá kpɛ́ bala líↄá pɛ̃liↄnɛ.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 1Kia 5.12","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}