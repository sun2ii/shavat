{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"SNG","translationId":"bqc_sim","name":"Salomↄↄ lɛ","commonName":"Salomↄↄ lɛ","title":"SALOMƆƆ LƐ","order":22,"numberOfChapters":8,"sha256":"93595c3b8dfe8da739db092b2caab86401d5855caaa0acc858a58fe278108496","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/bqc_sim/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Má dɛ lán Salↄna nàalɛvuwa,",{"text":"lán guzulɛ sũmaavuwa.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Lá lávu kɛfɛna dɛ lɛↄ guu,","poem":1},{"lineBreak":true},{"text":"màa ma gbɛ̃na dɛ wɛ̃́ndiaↄ guu.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Lá mao lí dɛ líkpɛu,","poem":1},{"lineBreak":true},{"text":"màa ma yenzide dɛ ɛ̀waasoↄ guu.","poem":1},{"lineBreak":true},{"text":"Zↄ̃lɛa a uenai ì kamagu,","poem":1},{"lineBreak":true},{"text":"a bɛ blea ì kɛmɛɛ na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À gɛ̃̀manↄ a pↄnablɛblekpɛu,","poem":1},{"lineBreak":true},{"text":"aà dàlapoo pooamala báasɛ̃ ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À vɛ̃ɛbɛ gii kpaa kɛ́ mà yɛ̃̀ɛɛ e,","poem":1},{"lineBreak":true},{"text":"à ma gba mao kɛ́ ma mɛ su,","poem":1},{"lineBreak":true},{"text":"asa aà báasɛ̃ lɛ́ ma gyãkɛɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aà ↄzɛɛ ku ma mi zíɛ,","poem":1},{"lineBreak":true},{"text":"aà ↄplaa liaamazi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yelusalɛũ nɛnↄnaↄ,","poem":1},{"lineBreak":true},{"text":"ma naɛ́ tueↄ ń zↄ̃́tɛ̃naↄzi,","poem":1},{"lineBreak":true},{"text":"ásu dúsakũkpawɛ̃ɛo,","poem":1},{"lineBreak":true},{"text":"ásu wá báasɛ̃ gbooo e a lɛ́ ká.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Ma yenzide kĩ́i ma, àlɛ mↄ́,","poem":1},{"lineBreak":true},{"text":"à vĩ̀ lɛ́ pɛ́lɛpɛlɛ gbɛ̀sĩsĩↄwa,","poem":1},{"lineBreak":true},{"text":"àlɛ bàalɛ sĩ̀sĩ musu, àlɛ vĩvĩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma yenzide dɛmɛɛ","poem":1},{"lineBreak":true},{"text":"lán tue ge bùasanawa.","poem":1},{"lineBreak":true},{"text":"À aà gwa zɛ wá kpɛ́ kpɛ.","poem":1},{"lineBreak":true},{"text":"Àlɛ wɛ́kpalɛ fɛnɛntiu,","poem":1},{"lineBreak":true},{"text":"àlɛ gugwagwa a mↄↄ zãnguo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma yenzide yã'òmɛɛ à mɛ̀:","poem":1},"Kía",{"text":"Ma gbɛ̃na kɛfɛna, fɛlɛ wà gɛ́,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"asa lou làa, buziɛ gɛ̃̀zɛa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pↄ́pii lɛ́ vukɛ tↄↄlɛwa,","poem":1},{"lineBreak":true},{"text":"lɛsigↄↄ kà,","poem":1},{"lineBreak":true},{"text":"felenkↄpunaↄ ↄ́ lìgua wá bùsuu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kaadↄɛnliↄ nɛ́ sɛ̃́ia dàalɛ,","poem":1},{"lineBreak":true},{"text":"vɛ̃ɛliↄ vukɛ̀, a gĩ lòo.","poem":1},{"lineBreak":true},{"text":"Ma gbɛ̃na kɛfɛna, fɛlɛ wà gɛ́.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma felena,","poem":1},{"lineBreak":true},{"text":"ń pɛ gbɛ̀sↄↄu n ulɛkĩi.","poem":1},{"lineBreak":true},{"text":"To ma n wɛgwa, to ma n lↄↄ ma,","poem":1},{"lineBreak":true},{"text":"asa n lↄↄ na, mɛ́ n oa kɛfɛũ kɛ̀ zài.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À gbɛ̃gbonaↄ kṹkũwɛ̃ɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃gbon kelepiↄ,","poem":1},{"lineBreak":true},{"text":"aalɛ wá vɛ̃ɛbuↄ ásookɛɛ,","poem":1},{"lineBreak":true},{"text":"wá vɛ̃ɛ pↄ́ lɛ́ vukɛpiↄ.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Ma yenzideá ma pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ aà pↄ́n ma ũ,","poem":1},{"lineBreak":true},{"text":"àlɛ pↄble sũmaavuↄ guu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma yenzide, e gu àↄ gɛ́ dↄi,","poem":1},{"lineBreak":true},{"text":"e guwɛ àↄ gɛ́ kɛ̃́i,","poem":1},{"lineBreak":true},{"text":"ɛa ǹ kɛ lá tue ge bùasan bↄlↄna","poem":1},{"lineBreak":true},{"text":"ì kɛ gbɛ̀sĩsĩↄwawa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}