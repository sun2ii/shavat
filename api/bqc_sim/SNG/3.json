{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"SNG","translationId":"bqc_sim","name":"Salomↄↄ lɛ","commonName":"Salomↄↄ lɛ","title":"SALOMƆƆ LƐ","order":22,"numberOfChapters":8,"sha256":"93595c3b8dfe8da739db092b2caab86401d5855caaa0acc858a58fe278108496","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/bqc_sim/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Ma wɛ́ dↄ ma yenzidezi gwãasĩna ma wúlɛkĩi,",{"text":"ma aà wɛ̀ɛlɛ, mi aà eo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Má fɛlɛ gɛ́ zɛaↄ kɛɛlɛi saɛ,","poem":1},{"lineBreak":true},{"text":"mí gbɛ̃́ pↄ́ ma nisĩna yeipi wɛɛlɛ gãaɛↄ.","poem":1},{"lineBreak":true},{"text":"Ɔ̃ ma aà wɛ̀ɛlɛ, mi aà eo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gudↄ̃anaↄ bↄ̀a, kɛ́ aalɛ bɛbɛ wɛ̃́lɛu,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"A gbɛ̃́ pↄ́ ma nisĩna yei è lae?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛ́ ma gɛ̃má gↄ̃̀ↄ,","poem":1},{"lineBreak":true},{"text":"ma bↄ gbɛ̃́ pↄ́ ma nisĩna yeipiwa.","poem":1},{"lineBreak":true},{"text":"Ma aà kũ̀, mi we ma aà gbàɛ lↄo","poem":1},{"lineBreak":true},{"text":"e ma gɛ gɛ̃aànↄ ma dakpɛu","poem":1},{"lineBreak":true},{"text":"e kpɛa pↄ́ à ma nↄsìu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yelusalɛũ nɛnↄnaↄ,","poem":1},{"lineBreak":true},{"text":"ma naɛ́ tueↄ ń zↄ̃́tɛ̃naↄzi,","poem":1},{"lineBreak":true},{"text":"ásu dúsakũkpawɛ̃ɛo,","poem":1},{"lineBreak":true},{"text":"ásu wá báasɛ̃ gbooo e a lɛ́ ká.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Démɛ bↄ̀ gbáau,","poem":1},{"lineBreak":true},{"text":"àlɛ mↄ́ lán tɛluwa keei?","poem":1},{"lineBreak":true},{"text":"À lí'ↄ gĩnana tulaletikàtɛa","poem":1},{"lineBreak":true},{"text":"ń laatanaↄ pↄ́ gĩnanaↄ píi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Salomↄↄ mákɛlɛ gwa kɛ,","poem":1},{"lineBreak":true},{"text":"gↄ̃saↄ liaai gbɛ̃ↄn bàaↄ̃","poem":1},{"lineBreak":true},{"text":"Isaili nɛgↄ̃naↄnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aa fɛ̃ndaↄ kũa ḿpii,","poem":1},{"lineBreak":true},{"text":"zĩ̀kan saↄnɛ!","poem":1},{"lineBreak":true},{"text":"An baade fɛ̃nda looa gwãasĩn yã́ↄ yã́i.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kí Salomↄↄ a sɛbↄpi kɛ̀","poem":1},{"lineBreak":true},{"text":"ń Libã bùsu líoɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A lipɛlɛↄá ã́nusuɛ,","poem":1},{"lineBreak":true},{"text":"a kpɛnakĩiá vuaɛ.","poem":1},{"lineBreak":true},{"text":"Zwã̀a gàalulade kpa a zↄ̃lɛkĩia,","poem":1},{"lineBreak":true},{"text":"a guuá Yelusalɛũ nɛnↄnaↄ yeanzi ↄgbɛɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siↄna nɛnↄnaↄ,","poem":1},{"lineBreak":true},{"text":"à bↄlɛ à mↄ́ kí Salomↄↄ gwa,","poem":1},{"lineBreak":true},{"text":"a a kíakɛfua kpaa.","poem":1},{"lineBreak":true},{"text":"Aà da mɛ́ kpàɛ̀ aà nↄsɛzĩ,","poem":1},{"lineBreak":true},{"text":"gↄↄ pↄ́ aà nↄ̀sɛ lɛ́ yáalↄ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}