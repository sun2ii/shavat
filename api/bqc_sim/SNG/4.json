{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"SNG","translationId":"bqc_sim","name":"Salomↄↄ lɛ","commonName":"Salomↄↄ lɛ","title":"SALOMƆƆ LƐ","order":22,"numberOfChapters":8,"sha256":"93595c3b8dfe8da739db092b2caab86401d5855caaa0acc858a58fe278108496","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/bqc_sim/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":["Ń kɛfɛũ ma gbɛ̃na, ń kɛfɛũ fá!",{"text":"N wɛ́ dɛ lán felen wɛ́wa n sálana fòou,","poem":1},{"lineBreak":true},{"text":"n mikã dɛ lán blè wiilaↄ pilaa Galada sĩ̀sĩwawa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N swaa pua lán sã pↄ́ wà ń kãkɛ̃̀ɛlɛ","poem":1},{"lineBreak":true},{"text":"aa bↄ̀ zu'okĩi aalɛ suↄwa.","poem":1},{"lineBreak":true},{"text":"Aa kↄ̃sɛ̀ plapla píi,","poem":1},{"lineBreak":true},{"text":"a kee i pↄsɛ bↄo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N lɛ́baa dɛ lán wↄ̃ↄtɛ̃n nian dowa,","poem":1},{"lineBreak":true},{"text":"n lɛ́ kɛfɛũ.","poem":1},{"lineBreak":true},{"text":"N gɛɛ dɛ lán gbɛafu pɛɛwa n sálana fòou.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N nↄɛ dɛ lán Davidi kalangawa.","poem":1},{"lineBreak":true},{"text":"Sɛngbao mɛ̀n ↄ̀aa sↄo looawà,","poem":1},{"lineBreak":true},{"text":"nɛgↄ̃naↄ gↄ̃kɛbↄɛ píi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N yↄ̃́ dɛ lán tue nɛ́ sìa pↄ́ aalɛ pↄble sũmaavuↄ guuwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E gu àↄ gɛ́ dↄi,","poem":1},{"lineBreak":true},{"text":"e guwɛ àↄ gɛ́ kɛ̃́i,","poem":1},{"lineBreak":true},{"text":"má gɛ́ gbɛ̀sĩsĩ lí'ↄ gĩnanade musu,","poem":1},{"lineBreak":true},{"text":"má dɛdɛ sĩ̀sĩ tulaletidewa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃na, n gupii kɛfɛũ,","poem":1},{"lineBreak":true},{"text":"n gue sãa vĩo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma nↄkpama,","poem":1},{"lineBreak":true},{"text":"to wà pila Libã gusĩsĩdewa","poem":1},{"lineBreak":true},{"text":"za Amana misonawa","poem":1},{"lineBreak":true},{"text":"ń Senii gbɛ̀ misonao ń Ɛɛmↄ gbɛ̀ misonao,","poem":1},{"lineBreak":true},{"text":"za nↄ̀ↄmusuↄ tòopiu,","poem":1},{"lineBreak":true},{"text":"za gbɛaantɛ̃naↄ gusĩsĩdepiu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N yã́ ma sↄ̃ blè ma nↄkpama, ma báasɛ̃de,","poem":1},{"lineBreak":true},{"text":"wɛ́ pↄ́ n ma gwaò ma sↄ̃ blè","poem":1},{"lineBreak":true},{"text":"ń n ↄ̃nɛɛ pↄ́ mɛ̀ndoeo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma nↄkpama, ma báasɛ̃de,","poem":1},{"lineBreak":true},{"text":"n yeamazi kɛ̀ zài,","poem":1},{"lineBreak":true},{"text":"n yeamazi namɛɛ dɛ vɛ̃ɛa,","poem":1},{"lineBreak":true},{"text":"n nísi gĩ namɛɛ dɛ pↄ́ gĩnanaↄla píi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N lɛ́baa mↄ̀sɛ dɛmɛɛ lán zↄsapunawa.","poem":1},{"lineBreak":true},{"text":"Ma nↄkpama,","poem":1},{"lineBreak":true},{"text":"zↄ́ ń vĩo mɛ́ kú n lɛ́na zíɛ,","poem":1},{"lineBreak":true},{"text":"n pↄkasaↄ gĩ dɛ","poem":1},{"lineBreak":true},{"text":"lán Libã bùsu líkpɛ gĩwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ń dɛ lán kaa pↄ́ wà a zɛtà","poem":1},{"lineBreak":true},{"text":"wà kilidàuwa.","poem":1},{"lineBreak":true},{"text":"Ma báasɛ̃de, ma nↄkpama,","poem":1},{"lineBreak":true},{"text":"ń dɛ lán bia pↄ́ wà kaa dàiwa,","poem":1},{"lineBreak":true},{"text":"lán nibↄna pↄ́ wà zɛtàɛ̀wa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N lu pↄ́ↄá gbɛafuɛ","poem":1},{"lineBreak":true},{"text":"ń libɛ maaↄ ń ãyãlio ń naadilio","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ń sũmaao ń fee bui gĩnanao","poem":1},{"lineBreak":true},{"text":"ń sinamↄ lío ń lí'ↄ gĩnanaↄ píi.","poem":1},{"lineBreak":true},{"text":"Zↄ̃go lí'ↄ ń aloe lí'ↄo ku we","poem":1},{"lineBreak":true},{"text":"ń pↄ́ pↄ́ a gĩ na dɛńlaↄ píi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kaa lↄ̀ↄn n ũ,","poem":1},{"lineBreak":true},{"text":"nibↄna í wɛ̃nide pↄ́ lɛ́ bↄ za Libã gusĩsĩdeu ũ.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Gugbãntoo ĩ́ana, fɛlɛ!","poem":1},{"lineBreak":true},{"text":"Gɛↄmidↄkĩi ĩ́ana,","poem":1},{"lineBreak":true},{"text":"káka su ma kaawa,","poem":1},{"lineBreak":true},{"text":"a pↄ́ↄ gĩ na i ligua,","poem":1},{"lineBreak":true},{"text":"ma yenzide i gɛ̃u,","poem":1},{"lineBreak":true},{"text":"i a libɛ nanaↄ ble.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}