{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"SNG","translationId":"bqc_sim","name":"Salomↄↄ lɛ","commonName":"Salomↄↄ lɛ","title":"SALOMƆƆ LƐ","order":22,"numberOfChapters":8,"sha256":"93595c3b8dfe8da739db092b2caab86401d5855caaa0acc858a58fe278108496","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/bqc_sim/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":["Ma gɛ̃ ma kaau, ma nↄkpama báasɛ̃de,",{"text":"ma a zↄ̃go lí'ↄ gò ń pↄ́ gĩnanaↄ,","poem":1},{"lineBreak":true},{"text":"ma a zↄsapuna blè ń a ío,","poem":1},{"lineBreak":true},{"text":"ma a vɛ̃ɛ mì ń ma vĩo.","poem":1},"Yelusalɛũ nɛnↄnaↄ",{"text":"À pↄble gbɛ̃́ↄ,","poem":1},{"lineBreak":true},{"text":"à imi à kã́ á bↄ̃̀nↄblenaↄ.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Málɛ i'o, ãma ma làasoo bɛ̃́ɛ,","poem":1},{"lineBreak":true},{"text":"ma yenzide ma, àlɛ gbalɛ.","poem":1},"Kía",{"text":"Gba wɛ̃mɛɛ ma gbɛ̃na báasɛ̃de,","poem":1},{"lineBreak":true},{"text":"ma felen sãasaide!","poem":1},{"lineBreak":true},{"text":"Fíi kpà ma miwa,","poem":1},{"lineBreak":true},{"text":"gwãasĩna mↄ̀sɛ ma mikã nìni.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Ma a ula bↄ̀, mí ɛa mà da lↄa?","poem":1},{"lineBreak":true},{"text":"Ma gbá pìpi, i ɛa gbãsĩkpa lↄa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma yenzide ↄgɛ̃̀ gbà fòou,","poem":1},{"lineBreak":true},{"text":"ↄ̃ ma mɛ lɛ́ kɛ fèfe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma fɛlɛ gɛ gbawɛ̃i ma yenzideɛ,","poem":1},{"lineBreak":true},{"text":"ma ↄ lɛ́ yↄyↄ ń zↄ̃go lí'ↄ tulaleo,","poem":1},{"lineBreak":true},{"text":"zↄ̃go lípi nísi lɛ́ bàalɛ ma ↄnɛↄwa,","poem":1},{"lineBreak":true},{"text":"à fĩ̀ gbatabↄwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma gbawɛ̃̀ ma yenzideɛ,","poem":1},{"lineBreak":true},{"text":"ãma à gɛ̃̀zɛa à tà kↄ̀.","poem":1},{"lineBreak":true},{"text":"Kɛ́ àlɛ yã'o, aà ni ma kũ.","poem":1},{"lineBreak":true},{"text":"Ma aà wɛ̀ɛlɛ, mi aà eo,","poem":1},{"lineBreak":true},{"text":"ma lɛzùzuaàzi, i weao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gudↄ̃anaↄ bↄ̀a,","poem":1},{"lineBreak":true},{"text":"kɛ́ aalɛ bɛbɛ wɛ̃́lɛ guu.","poem":1},{"lineBreak":true},{"text":"Aa ma gbɛ̃ aa ma wiwi,","poem":1},{"lineBreak":true},{"text":"bĩ́idↄ̃anapiↄ ma pↄlↄgãu wòlomala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yelusalɛũ nɛnↄnaↄ,","poem":1},{"lineBreak":true},{"text":"tó a ma yenzide è,","poem":1},{"lineBreak":true},{"text":"á oɛ̀ kpelewa ni?","poem":1},{"lineBreak":true},{"text":"Ma naɛ́ Luazi à oɛ̀mɛɛ,","poem":1},{"lineBreak":true},{"text":"ma yeaaàzi ma mɛ bùsa.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Bↄ́ n yenzide dɛò dãↄlai?","poem":1},{"lineBreak":true},{"text":"N gbɛ̃́ pↄ́ ń kɛfɛũ dɛ nↄɛↄla píi,","poem":1},{"lineBreak":true},{"text":"bↄ́ n yenzide dɛò dãↄla","poem":1},{"lineBreak":true},{"text":"ↄ̃ n gbasa n nawɛ̃ɛ Luazi màai?","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Ma yenzide tɛ̃a pípia,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ↄn ↄ̀aasↄsↄo lɛɛ kwiↄ guu ↄ̃mɛ vua ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aà miá vua tɛ̃ɛtɛ̃ɛɛ,","poem":1},{"lineBreak":true},{"text":"aà mikã dɛ sí plɛ̀ɛɛ","poem":1},{"lineBreak":true},{"text":"lán gbagbaa kã́wa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aà wɛ́ dɛ lán felen pɛ́lɛa íuwa,","poem":1},{"lineBreak":true},{"text":"aà wɛ́pi pípia ń vĩo, mɛ́ a sàlala.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aà gɛɛ dɛ lán pↄ́ gĩnanaↄ buawa,","poem":1},{"lineBreak":true},{"text":"a gĩdↄ nanannↄ.","poem":1},{"lineBreak":true},{"text":"Aà lɛ́baa dɛ lán lávuwa,","poem":1},{"lineBreak":true},{"text":"àlɛ yↄyↄ ń zↄ̃go lí nísio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aà ↄ dɛ lán vua lipↄ̃ↄↄ pↄ́ diamaa dadauwa,","poem":1},{"lineBreak":true},{"text":"aà gbɛɛ dɛ lán wesa swaa yↄↄa pↄ́ wà safii gbɛ pɛ̀pɛwawa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aà gbáↄ dɛ lán gbɛ̀pɛlɛ bɛɛɛde","poem":1},{"lineBreak":true},{"text":"pↄ́ wà a zɛbↄ pì ń vuaowa.","poem":1},{"lineBreak":true},{"text":"À bↄ̀ lán Libã bùsuwa,","poem":1},{"lineBreak":true},{"text":"aà zɛa maa lán sɛdɛ líwa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aà lɛ́á zↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"aà gupii kɛfɛũ.","poem":1},{"lineBreak":true},{"text":"Yelusalɛũ nɛnↄnaↄ,","poem":1},{"lineBreak":true},{"text":"lá ma gbɛ̃na yenzide dɛn we.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}