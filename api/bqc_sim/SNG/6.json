{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"SNG","translationId":"bqc_sim","name":"Salomↄↄ lɛ","commonName":"Salomↄↄ lɛ","title":"SALOMƆƆ LƐ","order":22,"numberOfChapters":8,"sha256":"93595c3b8dfe8da739db092b2caab86401d5855caaa0acc858a58fe278108496","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/bqc_sim/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["N gbɛ̃́ pↄ́ ń kɛfɛũ dɛ nↄɛↄla píi,",{"text":"n yenzide gɛ̀ má ni?","poem":1},{"lineBreak":true},{"text":"N yenzide mi dì má oiɛ","poem":1},{"lineBreak":true},{"text":"kɛ́ wà e wà aà wɛɛlɛnnↄi?","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ma yenzide gɛ̀ a pↄ́ gĩnana buaɛ,","poem":1},{"lineBreak":true},{"text":"à gɛ̀ pↄblei a kaauɛ,","poem":1},{"lineBreak":true},{"text":"i lávuↄ wɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma yenzideá ma pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ aà pↄ́n ma ũ,","poem":1},{"lineBreak":true},{"text":"àlɛ pↄble sũmaavuↄ guuɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"Ma gbɛ̃na, ń kɛfɛũ lán Tiizawa,","poem":1},{"lineBreak":true},{"text":"ń maa lán Yelusalɛũwa.","poem":1},{"lineBreak":true},{"text":"N yã́ ì dimá","poem":1},{"lineBreak":true},{"text":"lán zĩgↄ̃ pↄ́ dàlapoo kũaↄwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wɛgoa, asa málɛ liɛ.","poem":1},{"lineBreak":true},{"text":"N mikã dɛ lán blè wiilaↄ pilaa Galada sĩ̀sĩwawa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N swaa pua lán sã pↄ́ aa bↄ̀lɛ zu'okĩi aalɛ suↄwa.","poem":1},{"lineBreak":true},{"text":"Aa kↄ̃sɛ̀ plapla píi,","poem":1},{"lineBreak":true},{"text":"an kee i pↄsɛ bↄo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N gɛɛ dɛ lán gbɛafu pɛɛwa","poem":1},{"lineBreak":true},{"text":"n sálana fòou.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma naↄ kà bàaↄ̃,","poem":1},{"lineBreak":true},{"text":"a pↄ́ mi mɛ́sɛdilɛnɛ́oↄ basiiↄ̃,","poem":1},{"lineBreak":true},{"text":"a lɛ́soↄ lɛ́ vĩo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ãma ma felen sãasai adoaɛ,","poem":1},{"lineBreak":true},{"text":"aà da nɛ́ mɛ̀ndonan we,","poem":1},{"lineBreak":true},{"text":"aà da'iapi pↄ dↄwàɛ.","poem":1},{"lineBreak":true},{"text":"Tó nɛnↄnaↄ aà è, aaì aà sáaukpaɛ,","poem":1},{"lineBreak":true},{"text":"ma nↄpiↄ ì aà tↄbↄ ḿpii.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Démɛ bↄ̀ lɛ́ mↄ́ kee lán gudↄawai?","poem":1},{"lineBreak":true},{"text":"A kɛfɛũ lán mↄvuawa,","poem":1},{"lineBreak":true},{"text":"a pípia lán ĩatɛ̃wa.","poem":1},{"lineBreak":true},{"text":"Aà yã́ ì dimá","poem":1},{"lineBreak":true},{"text":"lán zĩgↄ̃ pↄ́ dàlapoo kũaↄwa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma gɛ lí pↄ́ wì a wɛ́na só kaau,","poem":1},{"lineBreak":true},{"text":"ma pila swa'ɛu pↄ́ↄ lá taa gwaiɛ.","poem":1},{"lineBreak":true},{"text":"Ma gɛ gwai tó vɛ̃ɛↄ bↄlↄbↄ̀,","poem":1},{"lineBreak":true},{"text":"tó gbɛafuↄ vukɛ̀.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mi dↄ̃ kɛ́ ma nisĩna ma sɛ","poem":1},{"lineBreak":true},{"text":"gɛ̀manↄ ma kía deeↄ sↄ̃́goↄ guuo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":12}