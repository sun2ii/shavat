{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"SNG","translationId":"bqc_sim","name":"Salomↄↄ lɛ","commonName":"Salomↄↄ lɛ","title":"SALOMƆƆ LƐ","order":22,"numberOfChapters":8,"sha256":"93595c3b8dfe8da739db092b2caab86401d5855caaa0acc858a58fe278108496","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/bqc_sim/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["Ɛa su, ɛa su Sulami nↄɛ!",{"text":"Ɛa su, ɛa su wà wɛfĩma!","poem":1},"Kía",{"text":"Bↄ́yãi á ye wɛfĩ Sulami nↄɛwa","poem":1},{"lineBreak":true},{"text":"lán zã̀ lɛɛ pla ↄ̃gwaawai?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kía bui nↄɛ,","poem":1},{"lineBreak":true},{"text":"n gbála maa n kyaleu,","poem":1},{"lineBreak":true},{"text":"n gbala ú dɛ bũunnↄ,","poem":1},{"lineBreak":true},{"text":"a dɛ lán gↄ̃ide ↄzĩwaɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kɛɛona pↄ́ vɛ̃ɛli láa a guuo ku we,","poem":1},{"lineBreak":true},{"text":"pↄ́wɛn zɛ pↄ́ sũmaavuↄ liaai ku we.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N yↄ̃́ dɛ lán bua nɛ́ mɛ̀n plaↄwa,","poem":1},{"lineBreak":true},{"text":"lán tue nɛ́ sìaↄwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N nↄɛ dɛ lán kalanga pↄ́ wa bò ń wesa swaaowa.","poem":1},{"lineBreak":true},{"text":"N wɛ́ dɛ lán Ɛsɛbↄ̃ íkalɛkĩi pↄ́ kú Balabiũ bĩ́ibↄlɛ saɛwa.","poem":1},{"lineBreak":true},{"text":"N ní dɛ lán Libã bùsu kalanga pↄ́ bↄaa ń Damasiowa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N mi maa lán Kaamɛli gbɛ̀sĩsĩwa.","poem":1},{"lineBreak":true},{"text":"N mikã dɛ lán zwã̀a gàaluladewa,","poem":1},{"lineBreak":true},{"text":"a dɛ plɛ̀ɛɛ, ì ma laai sia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ń kɛfɛũ fá, ni kamagu,","poem":1},{"lineBreak":true},{"text":"wá yeakↄ̃i gɛ̃agɛ̃̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N zɛa maa lán daminaliwa,","poem":1},{"lineBreak":true},{"text":"n yↄ̃́ dɛ lá a kↄ́wa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma mɛ̀ má dɛdɛ lípiwa,","poem":1},{"lineBreak":true},{"text":"mí a bɛ kṹ.","poem":1},{"lineBreak":true},{"text":"N yↄ̃́ dɛmɛɛ lán vɛ̃ɛ kↄ́wa,","poem":1},{"lineBreak":true},{"text":"n lɛ́'ĩana dɛ lán mao gĩwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N lɛ́'i na","poem":1},{"lineBreak":true},{"text":"lán vɛ̃ɛ pↄ́ a na dɛńlawa.","poem":1},"Nↄɛ",{"text":"Vɛ̃ɛpi lɛ́ gɛ̃ ma yenzide lɛ́u sàaa,","poem":1},{"lineBreak":true},{"text":"àlɛ táa'o aà lɛ́baa ń aà swaaowa yↄlↄlↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má dɛ ma yenzide pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"ma ni kuwà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma yenzide, mↄ wà gɛ́ sɛ̃u,","poem":1},{"lineBreak":true},{"text":"wí gɛ́ ii zↄ̃ɛwiaↄu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gufɛ̃nɛ wí gɛ́ vɛ̃ɛbua,","poem":1},{"lineBreak":true},{"text":"wà gwa tó vɛ̃ɛↄ bↄlↄbↄ̀,","poem":1},{"lineBreak":true},{"text":"wà e tó gbɛafuↄ vú pìa.","poem":1},{"lineBreak":true},{"text":"We má yeanzi ↄlↄunɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sɛ́ɛ lávu gĩ dàgua,","poem":1},{"lineBreak":true},{"text":"libɛ nana bui píi kú wá kpɛɛlɛ.","poem":1},{"lineBreak":true},{"text":"Ma a zi ń a dafuo kàlɛnɛ,","poem":1},{"lineBreak":true},{"text":"ma yenzide.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":14}