{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"SNG","translationId":"bqc_sim","name":"Salomↄↄ lɛ","commonName":"Salomↄↄ lɛ","title":"SALOMƆƆ LƐ","order":22,"numberOfChapters":8,"sha256":"93595c3b8dfe8da739db092b2caab86401d5855caaa0acc858a58fe278108496","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/bqc_sim/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["Tó ma dãↄn n ũ",{"text":"wa yↄ̃́ mì wá kpàkↄ̃wa yãaɛ lé!","poem":1},{"lineBreak":true},{"text":"Tó ma kpaaũnnↄ bàasi,","poem":1},{"lineBreak":true},{"text":"dↄ̃ má lɛ́pɛma, wa sakamaguo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dↄ̃ ma gɛnnↄ ma da'ia kpɛ́u,","poem":1},{"lineBreak":true},{"text":"mí vɛ̃ɛ gĩ na kpama ǹ mi","poem":1},{"lineBreak":true},{"text":"ń gbɛafu í nanao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aà ↄzɛɛ ku ma mi zíɛ,","poem":1},{"lineBreak":true},{"text":"aà ↄplaa liaamazi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yelusalɛũ nɛnↄnaↄ, ma naɛ́ Luazi,","poem":1},{"lineBreak":true},{"text":"ásu dúsakũkpawɛ̃ɛo,","poem":1},{"lineBreak":true},{"text":"ásu wá báasɛ̃ gbooo e a lɛ́ ká.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Démɛ bↄ̀ gbáau, àlɛ mↄ́,","poem":1},{"lineBreak":true},{"text":"àlɛ gbãa'e a yenzidewa keei?","poem":1},"Nↄɛ",{"text":"Ma n vu mao lí gbáu,","poem":1},{"lineBreak":true},{"text":"wekĩi n da n nↄsìu,","poem":1},{"lineBreak":true},{"text":"wekĩi nↄwãwã mↄ̀uwà ↄ̃ à n i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma na n sↄ̃wa lán seelakɛbↄ pↄ́ wì da ń nↄɛ ge ń ↄwawa,","poem":1},{"lineBreak":true},{"text":"asa yeagↄ̃ɛi ì mↄ́má lán gawaɛ,","poem":1},{"lineBreak":true},{"text":"báasɛ̃pi pãsĩ lán mia'ɛwaɛ.","poem":1},{"lineBreak":true},{"text":"Ì namá lán tɛ́waɛ,","poem":1},{"lineBreak":true},{"text":"ì kṹmá lán tɛ́ sà zↄ̃ↄwaɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Baa ísi a fↄ̃ báasɛ̃ tɛdɛo,","poem":1},{"lineBreak":true},{"text":"baa swada í a fↄ̃ daao.","poem":1},{"lineBreak":true},{"text":"Tó gbɛ̃́ a bɛ àizɛɛↄ kpà píi","poem":1},{"lineBreak":true},{"text":"báasɛ̃ lua yã́i,","poem":1},{"lineBreak":true},{"text":"wa sakaaàgu búubuuɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Wá dãuna vĩ, i yↄ̃́ bↄbↄo.","poem":1},{"lineBreak":true},{"text":"Kpelewa wá kɛ","poem":1},{"lineBreak":true},{"text":"tó gbɛ̃e ye gɛ̃ aà yã́ui?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó a dɛ bĩ́i ũɛ,","poem":1},{"lineBreak":true},{"text":"wá gulɛsĩↄ bowà ń ã́nusuoɛ.","poem":1},{"lineBreak":true},{"text":"Tó a dɛ bĩ́ibↄlɛ ũɛ,","poem":1},{"lineBreak":true},{"text":"wá káka ń sɛdɛ líoɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Bĩ́in ma ũ,","poem":1},{"lineBreak":true},{"text":"ma yↄ̃́ mɛ́ a gulɛsĩↄ ũ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ má dɛ ma yenzideɛ","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ ì aafia iɛ̀ ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Salomↄↄ vɛ̃ɛbu vĩ Baalamↄ,","poem":1},{"lineBreak":true},{"text":"à búpi nà gbɛ̀winaↄnɛ ń ↄzĩ.","poem":1},{"lineBreak":true},{"text":"An baade líↄ fĩabo ã́nusu ↄwatɛ̃ ↄ̀aasↄsↄo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Salomↄↄ, má azĩa vɛ̃ɛbu vĩɛ,","poem":1},{"lineBreak":true},{"text":"má ã́nusu ↄwatɛ̃ ↄ̀aa sↄo kpama,","poem":1},{"lineBreak":true},{"text":"mí a ↄ̀aa do kpa vɛ̃ɛbu zĩkɛnaↄwa.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"N gbɛ̃́ pↄ́ niↄ ku kaaↄ guu,","poem":1},{"lineBreak":true},{"text":"wì swãdↄnzi,","poem":1},{"lineBreak":true},{"text":"to mà n lↄↄ ma.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Ma yenzide, mↄ kpakpa,","poem":1},{"lineBreak":true},{"text":"ní kɛ lá tue ge bùasan bↄlↄna","poem":1},{"lineBreak":true},{"text":"ì kɛ sĩ̀sĩ pↄgĩnadeↄ musuwa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqc_sim/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}