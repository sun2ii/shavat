{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ZEC","translationId":"bqc_sim","name":"Zakali","commonName":"Zakali","title":"ZAKALI","order":38,"numberOfChapters":14,"sha256":"7156aa0fc5ea3bc301106542fb4aaba33e1a3b18a89c3dc15a34fad37c73ed24","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/ZEC/14.json","totalNumberOfVerses":210},"chapter":{"number":10,"content":[{"type":"heading","content":["Dii ↄliaa Yudaↄzi"]},{"type":"verse","number":1,"content":[{"text":"À lou gbɛa Diiwa káabuana,","poem":1},{"lineBreak":true},{"text":"asa Dii mɛ́ ì to lou kɛkɛ,","poem":1},{"lineBreak":true},{"text":"ì to lou kwɛ́nɛ́,","poem":1},{"lineBreak":true},{"text":"ì to buapↄ́ kɛ baadeɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tã́aↄ ì yãyaaa'o,","poem":1},{"lineBreak":true},{"text":"màsokɛnaↄ ì yã́ ɛgɛna e.","poem":1},{"lineBreak":true},{"text":"Wɛ́pungu'enaↄ yã́á mↄafiliɛ,","poem":1},{"lineBreak":true},{"text":"an gbɛ̃́ↄ nↄ̀sɛninianɛá pãɛ.","poem":1},{"lineBreak":true},{"text":"A yã́i tò gbɛ̃́ↄ liaaa lán sãↄwa,","poem":1},{"lineBreak":true},{"text":"an kúsu kwɛa kɛ́ aa dãna vĩo yã́i.","poem":1},{"noteId":21}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"ma pↄ paa an dãnaↄzi,","poem":1},{"lineBreak":true},{"text":"má ĩada blesanapiↄwa.","poem":1},{"lineBreak":true},{"text":"Ma Dii Zĩgↄ̃de má ↄlia Yudaↄzi ma kpàsa pↄ́ↄ ũ,","poem":1},{"lineBreak":true},{"text":"má ń kɛ zĩkasↄ̃ gawide ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃́ pↄ́ dɛ lán ɛ̃daalɛgbɛwa","poem":1},{"noteId":22},{"text":"a bↄ ń guu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ dɛ lán kálo","poem":1},{"noteId":23},{"text":"ge zĩkasawa a bↄ we,","poem":1},{"lineBreak":true},{"text":"kpalablenaↄ bↄ we píiɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aaↄ dɛ nɛgↄ̃naↄ ũɛ,","poem":1},{"lineBreak":true},{"text":"aa ↄ̃zↄ̃ ń ibɛɛↄwa zĩkawɛ̃lɛ zɛ́u lán pɛ̀lɛawa.","poem":1},{"lineBreak":true},{"text":"Lá má kúńnↄ,","poem":1},{"lineBreak":true},{"text":"aa zĩka, aai sↄ̃deↄ fu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Má Yudaↄ gba gbãa,","poem":1},{"lineBreak":true},{"text":"má Yosɛfu buiↄ suaba,","poem":1},{"lineBreak":true},{"text":"mí suńnↄ ń pá ziu,","poem":1},{"lineBreak":true},{"text":"kɛ́ má ń wɛ̃na vĩ yã́i.","poem":1},{"lineBreak":true},{"text":"Aaↄ dɛ lá mi ń vũaa yãaowa,","poem":1},{"lineBreak":true},{"text":"asa mámɛmaa Dii ń Lua,","poem":1},{"lineBreak":true},{"text":"má yãmamá.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɛflaiũ buiↄ gↄ̃ nɛgↄ̃naↄ ũ,","poem":1},{"lineBreak":true},{"text":"an pↄ iↄ na lán vɛ̃ɛ zↄ̃̀lɛmáwa.","poem":1},{"lineBreak":true},{"text":"An nɛ́ↄ e, aai pↄnakɛ,","poem":1},{"lineBreak":true},{"text":"an pↄ́ a kɛ na Diiwa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Má swe pɛ́ńzi, mí ń kãaa,","poem":1},{"lineBreak":true},{"text":"má ń boɛ, aaiↄ dasi lán yãawa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Baa tó ma ń fãaa buiↄ guu,","poem":1},{"lineBreak":true},{"text":"ma yã́ aↄ dↄńgu za bùsu zã̀zãↄuɛ.","poem":1},{"lineBreak":true},{"text":"Ampiↄ ń ń nɛ́ↄ aaↄ kuɛ, aai su.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Má ń bↄ Egipi bùsuu mà suńnↄ,","poem":1},{"lineBreak":true},{"text":"má ń kãaa Asili bùsuu,","poem":1},{"lineBreak":true},{"text":"mí suńnↄ Galada bùsuu ń Libão.","poem":1},{"lineBreak":true},{"text":"Gu a mↄ́máo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aa bua Egipi ísiawa,","poem":1},{"lineBreak":true},{"text":"aa a ikooaↄ fu,","poem":1},{"lineBreak":true},{"text":"Niili ísiↄ ba.","poem":1},{"lineBreak":true},{"text":"Asiliↄ wala a kpálɛ,","poem":1},{"lineBreak":true},{"text":"Egipiↄ iko a láa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma Dii Zĩgↄ̃de ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃́ↄ gbãa'e ma kĩ́i,","poem":1},{"lineBreak":true},{"text":"aaiↄ tɛmazi.","poem":1}]}],"footnotes":[{"noteId":21,"caller":"+","text":"10.2 Mat 9.36","reference":{"chapter":10,"verse":2}},{"noteId":22,"caller":"+","text":"10.4 Isa 28.16, Ɛfɛ 2.20","reference":{"chapter":10,"verse":4}},{"noteId":23,"caller":"+","text":"10.4 Isa 22.23","reference":{"chapter":10,"verse":4}}]},"thisChapterLink":"/api/bqc_sim/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}