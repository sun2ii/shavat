{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ZEC","translationId":"bqc_sim","name":"Zakali","commonName":"Zakali","title":"ZAKALI","order":38,"numberOfChapters":14,"sha256":"7156aa0fc5ea3bc301106542fb4aaba33e1a3b18a89c3dc15a34fad37c73ed24","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/ZEC/14.json","totalNumberOfVerses":210},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":["Gↄↄ bee nibↄna a wɛ̃ Davidi buiↄnɛ ń Yelusalɛũdeↄ píi duunawoloama ń gbãbↄanɛ́o yã́i."]},{"type":"verse","number":2,"content":["Gↄↄ bee má tã́aↄ tↄ́ bãdɛ ń bùsuu, aↄ dↄ gbɛ̃egu lↄo. Ma Dii Zĩgↄ̃de mámɛ má ò. Má ãnabi ɛgɛnaↄ midɛ ń bùsuu ń wɛlɛna pↄ́ lɛ́ ń gba lɛ́ↄ."]},{"type":"verse","number":3,"content":["Tó gbɛ̃́ gì lɛ́ ãnabikɛkɛ, aà de ń aà da'iao oɛ̀ à làawàn we, asa à ɛɛtò ń ma tↄ́oɛ. Tó àlɛ ãnabikɛkɛ, aà de ń aà da'iaopiↄ mɛ́ aa aà zↄ̃ aa dɛ."]},{"type":"verse","number":4,"content":["Gↄↄ bee wí a ãnabi píi kṹ yã́ pↄ́ aalɛ e oa yã́ musu. Aa ãnabikɛ pↄ́kã ula da aa gbɛ̃́ↄ sã́sãò lↄo."]},{"type":"verse","number":5,"content":["A mɛ ãnabin a ũo, zↄ̃ɛn a ũ, álɛ buakɛ za a nɛgↄↄɛ."]},{"type":"verse","number":6,"content":["Tó wà aà là: Bↄ́ ia mɛ́ tɛ́tɛ n ↄↄwa sↄ̃? A mɛ: É'e! Ma kɛ'ĩa ma gbɛ̃́ↄ bɛɛ."]},{"type":"verse","number":7,"content":[{"text":"Ma Dii Zĩgↄ̃de ma mɛ̀:","poem":1},{"lineBreak":true},{"text":"Fɛ̃nda, fɛlɛ ń ma sãdãnao,","poem":1},{"lineBreak":true},{"text":"gↄ̃ pↄ́ dɛ ma gbɛ̃do ũpi.","poem":1},{"lineBreak":true},{"text":"Sãdãnapi lɛ́, sãↄ i fãaa,","poem":1},{"noteId":28},{"lineBreak":true},{"text":"mí ↄlia an gbɛ̃́ kpɛɛnaↄzi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wa bùsudeↄ lɛɛ pla lɛ wà ń dɛdɛ,","poem":1},{"lineBreak":true},{"text":"lɛɛ do i gↄ̃ a guu.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Má lɛɛ dopi baasa ń tɛ́o","poem":1},{"lineBreak":true},{"text":"lán ã́nusu baasaawa,","poem":1},{"lineBreak":true},{"text":"má ń maa lɛgwa,","poem":1},{"lineBreak":true},{"text":"lá wì vua maa lɛgwawa.","poem":1},{"lineBreak":true},{"text":"Aa ma sísi, mí wemá.","poem":1},{"lineBreak":true},{"text":"Má mɛnɛ́ ma gbɛ̃́ↄ,","poem":1},{"lineBreak":true},{"text":"aai omɛɛ Dii ń Lua.","poem":1}]}],"footnotes":[{"noteId":28,"caller":"+","text":"13.7 Mat 26.31, Maa 14.27","reference":{"chapter":13,"verse":7}}]},"thisChapterLink":"/api/bqc_sim/ZEC/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ZEC/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ZEC/12.json","previousChapterAudioLinks":{},"numberOfVerses":9}