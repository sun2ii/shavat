{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ZEC","translationId":"bqc_sim","name":"Zakali","commonName":"Zakali","title":"ZAKALI","order":38,"numberOfChapters":14,"sha256":"7156aa0fc5ea3bc301106542fb4aaba33e1a3b18a89c3dc15a34fad37c73ed24","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/bqc_sim/ZEC/14.json","totalNumberOfVerses":210},"chapter":{"number":9,"content":[{"type":"heading","content":["Yã́ zↄ̃lɛa Isailiↄ ibɛɛↄwa"]},{"type":"verse","number":1,"content":[{"text":"Dii a yãda Adalaka bùsula,","poem":1},{"lineBreak":true},{"text":"i to yã́ zↄ̃lɛ Damasiwa,","poem":1},{"noteId":15},{"lineBreak":true},{"text":"asa Sili mɛɛwiapiá aà pↄ́ɛ,","poem":1},{"lineBreak":true},{"text":"i kɛ Isaili buiↄ ńtɛ̃ɛ no.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yã́pi a zↄ̃lɛ Amatawa lↄɛ","poem":1},{"lineBreak":true},{"text":"ń Tiio ń Sidↄ̃o,","poem":1},{"noteId":16},{"lineBreak":true},{"text":"baa kɛ́ aa dɛ ↄ̃nↄnaↄ ũ maamaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tiideↄ bĩ́i gbãa bo lìa ń wɛ̃́lɛi,","poem":1},{"lineBreak":true},{"text":"aa ã́nusu kã̀aańzi lán ũfãawa,","poem":1},{"lineBreak":true},{"text":"aa vua nↄ̀nↄaańzi lán zɛ́ guu pɛ̀lɛawa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gwa! Dii a ń pↄ́ↄ símá,","poem":1},{"lineBreak":true},{"text":"i zɛ́ pↄ́ aa vĩ ísiaa midɛ.","poem":1},{"lineBreak":true},{"text":"Tɛ́ mɛ́ a kṹ ń wɛ̃́lɛpiwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Asekelonideↄ e, vĩa i ń kṹ.","poem":1},{"lineBreak":true},{"text":"Gazadeↄ lualua maamaa","poem":1},{"lineBreak":true},{"text":"ń Ɛkɛlonideↄ lↄ, asa tãmaa a ń nɛ́ɛ.","poem":1},{"lineBreak":true},{"text":"Gazadeↄ kua ń kíawa,","poem":1},{"lineBreak":true},{"text":"Asekeloni a gↄ̃ bɛzia ũ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Buipãleↄ zↄ̃lɛ Asedoda,","poem":1},{"lineBreak":true},{"text":"Dii i Filitɛ̃ↄ","poem":1},{"noteId":17},{"text":"wala midɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I nↄ̀ↄ kòlokpasai bↄ ń lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"i tɛ̃ bↄ ń lɛ́u.","poem":1},{"lineBreak":true},{"text":"An gbɛ̃́ pↄ́ gↄ̃̀ↄ gↄ̃ wá Lua pↄ́ ũɛ,","poem":1},{"lineBreak":true},{"text":"aa gↄ̃ lán Yudaↄ buiewa,","poem":1},{"lineBreak":true},{"text":"Ɛkɛlonideↄ gↄ̃ aà gbɛ̃́ↄ ũ lá Yebusiↄ kɛ̀wa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii i a bùsu ń a gbɛ̃́ↄ dↄ̃́a","poem":1},{"lineBreak":true},{"text":"zĩgↄ̃ pↄ́ lɛ́ mↄ́ lɛ́lɛimáↄ yã́i.","poem":1},{"lineBreak":true},{"text":"Gbãamↄnɛdeↄ gbãablemá lↄo,","poem":1},{"lineBreak":true},{"text":"asa aↄ wɛ́tɛńzi saɛ.","poem":1}]},{"type":"heading","content":["Siↄna Kía mↄa"]},{"type":"verse","number":9,"content":[{"text":"Á Siↄnadeↄ, à pↄnakɛ maamaa,","poem":1},{"lineBreak":true},{"text":"á Yelusalɛũdeↄ, à kúkuakɛ.","poem":1},{"lineBreak":true},{"text":"À gwa, á kía lɛ́ mↄ́wá,","poem":1},{"lineBreak":true},{"text":"ì yãkɛ a zɛ́wa mɛ́ zĩ̀blenaɛ.","poem":1},{"lineBreak":true},{"text":"Aà nↄ̀sɛ niɛ mɛ́ a di zàa'ĩna kpɛ,","poem":1},{"lineBreak":true},{"text":"a di zàa'ĩn nɛ́ bↄlↄ kpɛ.","poem":1},{"noteId":18}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A zĩkasↄ̃goↄ bↄlɛ Ɛflaiũ bùsuu,","poem":1},{"lineBreak":true},{"text":"a to zĩkasↄ̃ↄ ku Yelusalɛũ lↄo,","poem":1},{"lineBreak":true},{"text":"wi zĩkasaↄ ɛ́'ɛ.","poem":1},{"lineBreak":true},{"text":"A aafia kpàwakɛ bui píiɛ,","poem":1},{"lineBreak":true},{"text":"i kible za ísialɛ la ń a lɛ́leo,","poem":1},{"lineBreak":true},{"text":"za Uflatai e dṹnia lɛ́wa.","poem":1},{"noteId":19}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Á gbɛ̃́ pↄ́ á dɛ zĩ̀zↄↄ ũ sↄ̃,","poem":1},{"lineBreak":true},{"text":"má á bↄlɛ ɛ̀ isaipiu","poem":1},{"lineBreak":true},{"text":"ma bàakuaánↄ au","poem":1},{"noteId":20},{"text":"yã́i.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Á zĩ̀zↄ pↄ́ á dↄ̃ á bↄↄ,","poem":1},{"lineBreak":true},{"text":"à su á wɛ̃́lɛ bĩ́ideu,","poem":1},{"lineBreak":true},{"text":"baa gbã málɛ oɛ́,","poem":1},{"lineBreak":true},{"text":"má ɛa asea kpáwá lɛɛ pla.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yudaↄ mɛ́ ma sá ũ, má sápi kã́,","poem":1},{"lineBreak":true},{"text":"Ɛflaiũ buiↄ mɛ́ ma ka ũ, má dau,","poem":1},{"lineBreak":true},{"text":"mí Siↄnadepiↄ gbaɛ Gɛlɛkiↄwa.","poem":1},{"lineBreak":true},{"text":"Aa gↄ̃mɛɛ lán nɛgↄ̃na fɛ̃ndawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Za musu Dii a bↄ a gbɛ̃́piↄwa,","poem":1},{"lineBreak":true},{"text":"aà ka a gɛ̃ fìoo lán loupilɛawa.","poem":1},{"lineBreak":true},{"text":"Dii Lua a kã̀aepɛ,","poem":1},{"lineBreak":true},{"text":"i mↄ gɛↄmidↄkĩi oi zàa'ĩana guu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dii Zĩgↄ̃de a ↄlia a gbɛ̃́ↄzi,","poem":1},{"lineBreak":true},{"text":"aa ń ibɛɛↄ taitai,","poem":1},{"lineBreak":true},{"text":"aai ↄ̃zↄ̃ ń gↄ̃kɛbↄↄwa.","poem":1},{"lineBreak":true},{"text":"Aa ń bↄ́ↄ'i mi,","poem":1},{"lineBreak":true},{"text":"aai pala lán vɛ̃ɛminawa.","poem":1},{"lineBreak":true},{"text":"Aa kɛ zĩ́uzĩu","poem":1},{"lineBreak":true},{"text":"lán ta pↄ́ wì au ɛ́lɛò sa'okĩiwawa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dii an Lua a ń suaba gↄↄ bee","poem":1},{"lineBreak":true},{"text":"a kpàsa sãↄ ũ,","poem":1},{"lineBreak":true},{"text":"aaiↄ tɛkɛ aà bùsuu","poem":1},{"lineBreak":true},{"text":"lán kíafua gbɛ̀ bɛɛɛdeↄwa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aaↄ maa mɛ́ an kɛfɛna a kɛ zài.","poem":1},{"lineBreak":true},{"text":"Ɛ̀waasoↄ lɛkpɛↄ yↄ́yↄ pↄ́wɛna yã́i,","poem":1},{"lineBreak":true},{"text":"wɛ̃́ndiaↄ wɛ̃wɛ̃, kɛ́ vɛ̃ɛ di yã́i.","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"9.1 Isa 17.1-3","reference":{"chapter":9,"verse":1}},{"noteId":16,"caller":"+","text":"9.2 Isa 23.1-18, Yoɛ 4.4-8","reference":{"chapter":9,"verse":2}},{"noteId":17,"caller":"+","text":"9.6 Isa 14.29","reference":{"chapter":9,"verse":6}},{"noteId":18,"caller":"+","text":"9.9 Mat 21.5, Zãa 12.15","reference":{"chapter":9,"verse":9}},{"noteId":19,"caller":"+","text":"9.10 Soũ 72.8","reference":{"chapter":9,"verse":10}},{"noteId":20,"caller":"+","text":"9.11 Bↄa 24.8","reference":{"chapter":9,"verse":11}}]},"thisChapterLink":"/api/bqc_sim/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}