{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ZEP","translationId":"bqc_sim","name":"Sofoni","commonName":"Sofoni","title":"SOFONI","order":36,"numberOfChapters":3,"sha256":"4d9793f0c28bd8ad610594f3720798e35bf13d05990a99cb7291603172adc492","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/bqc_sim/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"heading","content":["Dii yã́kpalɛkɛa ń dṹniao"]},{"type":"verse","number":1,"content":["Dii yã'ò Kusi nɛ́ Sofoniɛ gↄↄ pↄ́ Amↄ nɛ́ Yosia",{"noteId":0},"dɛ Yudaↄ kía ũ. Sofonipiá Gedalia tↄũnaɛ, Amalia sĩ́wɛnaɛ, Ezekia sↄ̃kpaɛɛ."]},{"type":"verse","number":2,"content":[{"text":"Má pↄ́pii waa tↄↄlɛwa.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Má gbɛ̃nazĩnaↄ ń nↄ̀bↄↄ waa píiɛ,","poem":1},{"lineBreak":true},{"text":"má bãↄ ń kpↄↄ waa píiɛ.","poem":1},{"lineBreak":true},{"text":"Má vãikɛnaↄ fu,","poem":1},{"lineBreak":true},{"text":"mí gbɛ̃nazĩnaↄ kaalɛ tↄↄlɛ.","poem":1},{"lineBreak":true},{"text":"Ma Dii mámɛ má ò.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Má ↄloo Yudaↄ ń Yelusalɛũdeↄla píiɛ.","poem":1},{"lineBreak":true},{"text":"Má guɛ bee zↄ̃ Baali gbàgbana pↄ́ gↄ̃̀ↄnɛ,","poem":1},{"lineBreak":true},{"text":"mí gulɛsĩ sa'onaↄ ń tã́a sa'onaↄ tↄ́ bãdɛ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aaì kúlɛ musupↄↄnɛ kpɛ́ musuↄ","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ aaì kúlɛmɛɛ","poem":1},{"lineBreak":true},{"text":"aaì lɛgbɛ̃ ń ma tↄ́o,","poem":1},{"lineBreak":true},{"text":"aaì ɛa gbɛ̃ ń tã́a Mↄlↄkuoↄ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ pↄ̀ↄbↄzãkɛ̀ aai tɛmazi lↄoↄ.","poem":1},{"lineBreak":true},{"text":"Aali ma kĩ́i wɛɛlɛ aa yãgbɛaao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À kɛ kílikili Dii Lua aɛ,","poem":1},{"lineBreak":true},{"text":"asa Dii gↄↄ kãikũ̀.","poem":1},{"lineBreak":true},{"text":"À sa'obↄ dìlɛ Yudaↄ ũ,","poem":1},{"lineBreak":true},{"text":"à gbãbↄ̀ gbɛ̃́ pↄ́ à ń sisiↄnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ma gbagbagↄↄzĩ","poem":1},{"lineBreak":true},{"text":"má ĩada kíaↄ ń kíanɛↄwa","poem":1},{"lineBreak":true},{"text":"ń gbɛ̃́ pↄ́ buipãle pↄkasa daaↄ píi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gↄↄ bee má ĩada","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aaì vĩvĩ kpɛɛlɛ bèeↄwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aaì ń dii kpɛ́ pa","poem":1},{"lineBreak":true},{"text":"ń yãpãsĩo ń mↄafilioↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀,","poem":1},{"lineBreak":true},{"text":"gↄↄpi zĩ́ wa ↄ́ gbãa dↄ Kpↄ̀ Bↄlɛu,","poem":1},{"lineBreak":true},{"text":"Fã́ani dafu a wã ń wiio,","poem":1},{"lineBreak":true},{"text":"mɛ́ wa zↄa zↄ̃ↄ ma gbɛ̀sĩsĩↄ musu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɛlɛfãanideↄ, à wiipɛ,","poem":1},{"lineBreak":true},{"text":"asa laatanaↄ midɛ píiɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ ↄde gbãngbooↄ kaalɛ míↄmiↄɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zĩbeezĩ má Yelusalɛũ kɛɛlɛ ń filiaↄ,","poem":1},{"lineBreak":true},{"text":"mí ĩada gbɛ̃́ pↄ́ kálɛa we","poem":1},{"lineBreak":true},{"text":"lán wɛ̃ pↄ́ kú ń a gbↄ̃oↄwa.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃́piↄ ì o ń sↄ̃ guu aa mɛ","poem":1},{"lineBreak":true},{"text":"má yãe kɛo, a maa ge a vãin nò.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wa ń àizɛɛↄ naaa,","poem":1},{"lineBreak":true},{"text":"an bɛↄ i gↄ̃ yàaa.","poem":1},{"lineBreak":true},{"text":"Aa bɛkpakpa,","poem":1},{"lineBreak":true},{"text":"kási aa e zↄ̃lɛuo,","poem":1},{"lineBreak":true},{"text":"aa vɛ̃ɛli pɛ́pɛ,","poem":1},{"lineBreak":true},{"text":"kási aa e a imio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii gↄↄ zↄ̃ↄ kãikũ̀,","poem":1},{"lineBreak":true},{"text":"À kà kãi, àlɛ ká ń bao.","poem":1},{"lineBreak":true},{"text":"Dii gↄↄ zↄa aↄ dↄ wɛ̃nannↄ,","poem":1},{"lineBreak":true},{"text":"baa nɛgↄ̃na a wiipɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gↄↄpiá kpɛ̃nɛmuugↄↄɛ,","poem":1},{"lineBreak":true},{"text":"taasi ń yeelɛao gↄↄɛ lↄ.","poem":1},{"lineBreak":true},{"text":"Músi ń gudɛao gↄↄɛ,","poem":1},{"lineBreak":true},{"text":"gubeebee gↄↄɛ, gu a siakũ,","poem":1},{"lineBreak":true},{"text":"lou guduuduu gↄↄɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Zĩbeezĩ kã̀ae'ↄ ń zĩkawiio aↄ dↄ","poem":1},{"lineBreak":true},{"text":"wɛ̃́lɛ bĩ́ideↄ ń bĩ́ipi gulɛsĩↄu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Má gbɛ̃nazĩnaↄ da taasiu,","poem":1},{"lineBreak":true},{"text":"aai táa'o lán vĩ̀aↄwa,","poem":1},{"lineBreak":true},{"text":"asa aa duunakɛ̀mɛɛɛ.","poem":1},{"lineBreak":true},{"text":"Wa ń au daada lán íwa,","poem":1},{"lineBreak":true},{"text":"an gɛↄ aↄ kpálɛa lán bìsawa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"An ã́nusu ge an vua a fↄ̃ ń bↄ","poem":1},{"lineBreak":true},{"text":"Dii kpɛ̃nɛmuugↄↄpi zĩ́o.","poem":1},{"lineBreak":true},{"text":"Aà zafɛ̃a tɛ́ a kṹ dṹniawa píiɛ,","poem":1},{"lineBreak":true},{"text":"a gbɛ̃́ pↄ́ kú a guuↄ midɛ kã́ndo.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"1.1 2Kia 22.1","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/bqc_sim/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}