{"translation":{"id":"bqc_sim","name":"Bibeli Luayãtaalá","website":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqcsim","licenseNotes":null,"shortName":"SIM","englishName":"Boko (Benin) Bible","language":"bqc","textDirection":"ltr","sha256":"9e89745b32b4dff5f8dcdd0b61dceae7dafa416c90600c1ca9f7ccb603667c93","availableFormats":["json"],"listOfBooksApiLink":"/api/bqc_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30984,"languageName":"Boko (Benin)","languageEnglishName":"Boko (Benin)"},"book":{"id":"ZEP","translationId":"bqc_sim","name":"Sofoni","commonName":"Sofoni","title":"SOFONI","order":36,"numberOfChapters":3,"sha256":"4d9793f0c28bd8ad610594f3720798e35bf13d05990a99cb7291603172adc492","firstChapterNumber":1,"firstChapterApiLink":"/api/bqc_sim/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/bqc_sim/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Yelusalɛũ"]},{"type":"verse","number":1,"content":[{"text":"Waiyoo mɛɛwia gbãamↄnɛdeↄ!","poem":1},{"lineBreak":true},{"text":"A gbɛ̃́ↄ swã́ gbãa mɛ́ aa gbãlɛa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aali gbɛ̃e yã́ sio,","poem":1},{"lineBreak":true},{"text":"aali lɛdama mao.","poem":1},{"lineBreak":true},{"text":"Aa Dii náai vĩo,","poem":1},{"lineBreak":true},{"text":"aali sↄ̃ ń Luazio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mɛɛwiapi kíaↄ dɛ","poem":1},{"lineBreak":true},{"text":"lán nↄ̀ↄmusu fɛ̃awa,","poem":1},{"lineBreak":true},{"text":"a yãgↄ̃gↄ̃naↄ dɛ lán àwalɛwan","poem":1},{"lineBreak":true},{"text":"oosiɛlɛ pↄ́ aali pↄe to gu dↄ̀wàoↄwa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A ãnabiↄá yãbↄlɛnaↄnɛ,","poem":1},{"lineBreak":true},{"text":"náaisaideↄnɛ.","poem":1},{"lineBreak":true},{"text":"A sa'onaↄ ì Dii pↄ́ↄ gbãlɛ,","poem":1},{"lineBreak":true},{"text":"aaì aà ikoyã ↄ̃̀ↄkpa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii ku wɛ̃́lɛpi guu,","poem":1},{"lineBreak":true},{"text":"a maa, ìli vãikɛo.","poem":1},{"lineBreak":true},{"text":"Lá gu lɛ́ dↄ ìↄ yã́zɛde danɛ́,","poem":1},{"lineBreak":true},{"text":"ìli fu bauo.","poem":1},{"lineBreak":true},{"text":"Ń beeo dↄ̀ↄsaideↄ líↄ wí dↄ̃o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma buieↄ bãdɛ̀,","poem":1},{"lineBreak":true},{"text":"ma ń bĩ́i gulɛsĩↄ dɛɛlɛmpà.","poem":1},{"lineBreak":true},{"text":"Má tò an wɛ̃́lɛↄ gↄ̃̀ bɛziaↄ ũ,","poem":1},{"lineBreak":true},{"text":"wìli a zɛ́kpaaↄ sɛ lↄo.","poem":1},{"lineBreak":true},{"text":"Wa ku we lↄo, baa do.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma mɛ̀ Yelusalɛũdeↄ ma vĩa vĩ,","poem":1},{"lineBreak":true},{"text":"aa ma lɛdama sio lé?","poem":1},{"lineBreak":true},{"text":"Tó màa no, má ń mɛɛwia dúuzↄ̃","poem":1},{"lineBreak":true},{"text":"ń yã́ pↄ́ má dìlɛ mà mↄɛ̀ↄ píiɛ.","poem":1},{"lineBreak":true},{"text":"Ń beeo an mɛ wã̀ ń yãdↄↄsaikɛao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma Dii ma mɛ̀, à sↄ̃́amazi","poem":1},{"lineBreak":true},{"text":"e gↄↄ pↄ́ má fɛlɛ bↄbↄńnↄ.","poem":1},{"lineBreak":true},{"text":"Asa má dìlɛ mà buiↄ kãaa,","poem":1},{"lineBreak":true},{"text":"mà bùsu píi gbɛ̃́ↄ naaa,","poem":1},{"lineBreak":true},{"text":"mí a pↄkpɛ̃nɛ bↄbↄmá,","poem":1},{"lineBreak":true},{"text":"baa ma pↄkũma pãsĩ píi.","poem":1},{"lineBreak":true},{"text":"Ma zafɛ̃a tɛ́ i kũ dṹniawa píi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bee gbɛa má gbãbↄ gbɛ̃́ↄ lɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ ampii aa ma sísi,","poem":1},{"lineBreak":true},{"text":"aai zↄblemɛɛ ń lɛdoũo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Za Etiopi swaↄ baale","poem":1},{"lineBreak":true},{"text":"ma sìsina pↄ́ fãaaaↄ mↄmɛɛ ń gbaↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gↄↄ bee wí a á kṹ","poem":1},{"lineBreak":true},{"text":"tàae pↄ́ á kɛ̀mɛɛ yãaↄ yã́ musuo,","poem":1},{"lineBreak":true},{"text":"asa ĩ́andãna pↄ́ aaì ńzĩa sɛ lɛsĩↄ","poem":1},{"lineBreak":true},{"text":"ↄ̃ má ń bↄlɛ á wɛ̃́lɛɛ bee guu.","poem":1},{"lineBreak":true},{"text":"Á ázĩa sɛ lɛsĩ ma gbɛ̀sĩsĩ","poem":1},{"lineBreak":true},{"text":"pↄ́ a kua adoa musu lↄo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Má taasideↄ ń wɛ̃nadeↄ to wɛ̃́lɛɛ bee guu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ aaì namaziↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Isaili kↄ̃napiↄ gbɛ̃́ↄ wɛtã lↄo,","poem":1},{"lineBreak":true},{"text":"aa gbɛ̃́ↄ sã́são,","poem":1},{"lineBreak":true},{"text":"mɛ́ wa ɛɛ ma dↄ ń lɛ́uo.","poem":1},{"noteId":2},{"lineBreak":true},{"text":"Aali pↄble, aali wúlɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃e yã́ a ń vĩakũo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Siↄnadeↄ, à gulakɛ!","poem":1},{"lineBreak":true},{"text":"Isailiↄ, à kúkuakɛ!","poem":1},{"lineBreak":true},{"text":"Yelusalɛũdeↄ, à wiilɛ ń pↄnao!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dii á bↄ́ yã́kpalɛu,","poem":1},{"lineBreak":true},{"text":"a tò á wɛ̀lɛↄ kpɛkpà.","poem":1},{"lineBreak":true},{"text":"Dii á Isailiↄ kía kú á guu,","poem":1},{"lineBreak":true},{"text":"áↄ yãe vĩa vĩ lↄo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gↄↄbeezĩ wa mɛ:","poem":1},{"lineBreak":true},{"text":"Yelusalɛũdeↄ, ásu to vĩa á kũo,","poem":1},{"lineBreak":true},{"text":"Siↄnadeↄ, á ↄ su gↄ̃ dↄ̀lↄlↄo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dii á Lua kú á guu","poem":1},{"lineBreak":true},{"text":"gↄ̃sa pↄ́ ì ń suaba ũ.","poem":1},{"lineBreak":true},{"text":"A koo pũna á yã́ musu ń pↄnao,","poem":1},{"lineBreak":true},{"text":"a á gba wɛ̃ni dafu a yeaázi guu.","poem":1},{"lineBreak":true},{"text":"A pↄnakɛ á yã́ musu ń gulakɛao,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"lá wì kɛ dikpɛgↄↄwa.","poem":1},{"lineBreak":true},{"text":"Ma Dii ma mɛ̀, má á aso pilaɛ́,","poem":1},{"lineBreak":true},{"text":"má á bↄ sↄ̃́sↄ̃au.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gↄↄ bee má yãkɛ","poem":1},{"lineBreak":true},{"text":"gbɛ̃́ pↄ́ gbãamↄ̀ɛ́ↄnɛ.","poem":1},{"lineBreak":true},{"text":"Má á gbɛ̃́ tↄ̃̀ↄlɛnaↄ misi,","poem":1},{"lineBreak":true},{"text":"má á gbɛ̃́ pↄ́ wà ń yáↄ kãaa.","poem":1},{"lineBreak":true},{"text":"Bùsu pↄ́ wà widàuwáↄ guu píi,","poem":1},{"lineBreak":true},{"text":"má á tↄbↄu, má á kpɛla.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Zĩbeezĩ má á kãaa,","poem":1},{"lineBreak":true},{"text":"gↄↄbeezĩ má suánↄ, mí á tↄbↄ.","poem":1},{"lineBreak":true},{"text":"Má á kpɛla dṹnia gbɛ̃́pii wáa,","poem":1},{"lineBreak":true},{"text":"má suánↄ á pá ziu, á wɛsiɛ.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"3.13 Zia 14.5","reference":{"chapter":3,"verse":13}}]},"thisChapterLink":"/api/bqc_sim/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqc_sim/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqc_sim/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}