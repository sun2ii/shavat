{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"ECC","translationId":"bqp_sim","name":"LAASUNDE","commonName":"LAASUNDE","title":"LAASUNDE","order":21,"numberOfChapters":12,"sha256":"2297ea1e73ad4dc69e7a26b238bec47147407e94dd2b893200704af99b49cffe","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bqp_sim/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["Ǹ gba da kũ pↄ́bleo gbɛ̃nↄnɛ,",{"text":"zĩkea ĩni le dↄ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ kpaatɛtɛ gbɛ̃nↄn supplanↄnɛ ke sↄraakↄ̃,","poem":1},{"lineBreak":true},{"text":"zaakũ ń kisira kũ ani bùsu le dↄ̃ro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tó ludambɛ sira kũ̀ kũ ío,","poem":1},{"lineBreak":true},{"text":"àdi ma zĩtɛ legũ ũmɛ,","poem":1},{"lineBreak":true},{"text":"tó lí lɛ̀tɛ ifãboki kpa ke ifãlɛtɛ kpa,","poem":1},{"lineBreak":true},{"text":"gu kũ à lɛ̀tɛn, gwen àdigↄ̃ wútɛn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kũ à wɛ́ dↄ ĩai dì pↄ́ tↄ̃ro,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ àtɛn ludambɛ sira gwa dì pↄ́ kɛ̃ro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lákũ ń wɛ̃̀ndiboki dↄ̃ro nà","poem":1},{"lineBreak":true},{"text":"ke nɛ́ kasana a da gbɛrɛn,","poem":1},{"lineBreak":true},{"text":"ĩni fↄ̃ ǹ Luda Pↄ́sĩndapinkikɛri zĩ dↄ̃ro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹ pↄ́ tↄ̃ kↄnkↄ,","poem":1},{"lineBreak":true},{"text":"ǹsun ma'ã kũ ↄkↄsiro,","poem":1},{"lineBreak":true},{"text":"zaakũ ń dↄ̃ a kpate mɛ́ ani arubarika kɛro.","poem":1},{"lineBreak":true},{"text":"Adíkĩnan yá ke adirekũn yá,","poem":1},{"lineBreak":true},{"text":"ke onigↄ̃ mana ń pínkin yá, ń dↄ̃ro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gupura nna,","poem":1},{"lineBreak":true},{"text":"ifãntɛ̃'ena dì káńgu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bee tó gbɛ̃ wɛ̃̀ndi gbã̀na fↄ̃ àgↄ̃ dera,","poem":1},{"lineBreak":true},{"text":"à pↄnna kɛn pínki.","poem":1},{"lineBreak":true},{"text":"Bee kũ abireo à laasun lɛ́ gusira gↄrↄa,","poem":1},{"lineBreak":true},{"text":"zaakũ onigↄ̃ dasimɛ.","poem":1},{"lineBreak":true},{"text":"Yã kũ àtɛn su pínki pãmɛ.","poem":1}]},{"type":"heading","content":["Lɛ́dana kɛfɛnnanↄa"]},{"type":"verse","number":9,"content":[{"text":"Kɛfɛnna, ǹ pↄnna kɛ n kɛfɛnnakɛgↄrↄa,","poem":1},{"lineBreak":true},{"text":"ǹ tó n pↄ kɛ nna n nɛ́gↄ̃gbɛ̃kɛgↄrↄ zĩ.","poem":1},{"lineBreak":true},{"text":"Ǹ yã kũ à n pↄ gbà kɛ","poem":1},{"lineBreak":true},{"text":"ǹ tɛ́ pↄ́ kũ à kàngui,","poem":1},{"lineBreak":true},{"text":"ama a pínki gũn ǹgↄ̃ dↄ̃ kũ","poem":1},{"lineBreak":true},{"text":"Luda ni yãkpatɛ kɛ kũnwo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹsun tó n pↄ yakaro,","poem":1},{"lineBreak":true},{"text":"ǹ n mɛ̀'ũmmanↄ gonla,","poem":1},{"lineBreak":true},{"text":"zaakũ kɛfɛnnakɛ kũ mìkã sirao dì gɛ̃ zɛ́lamɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}