{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"JOB","translationId":"bqp_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"3511bf0b289ad3bb2703cb20e89827096c9845db58fc8744a3751ed969350b13","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqp_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":14,"content":[{"type":"heading","content":["Ayuba yã'ona Ludanɛ"]},{"type":"verse","number":1,"content":[{"text":"Bisãsiri dì bo nↄgbɛ̃ kĩnaamɛ,","poem":1},{"lineBreak":true},{"text":"a wɛ̃̀ndii kusu, àdigↄ̃ kun yãkete sariro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Àdi pia lán lávu bà àdi kori kɛ,","poem":1},{"lineBreak":true},{"text":"àdi gɛ̃tɛ lán uraa bà àdi gì kɛro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃ dí takan ĩni wɛ́ dↄa","poem":1},{"lineBreak":true},{"text":"ǹ yãkpatɛ kɛ kãao yá?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pↄ́ gbãsĩ ni fↄ̃ à pↄ́ gbãsĩsari i yá?","poem":1},{"lineBreak":true},{"text":"Ani sí kɛro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N bisãsiri gↄrↄ dìtɛnɛ,","poem":1},{"lineBreak":true},{"text":"a mↄ lɛ́ kú n ↄĩ,","poem":1},{"lineBreak":true},{"text":"n a wɛ̃̀ lɛ́ dànɛ, ani fↄ̃ à vĩalaro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹ wɛ́ goa ǹ a tó gwe","poem":1},{"lineBreak":true},{"text":"ari a gↄrↄ lɛ́ papa lán zamalingakɛrii bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lí dìgↄ̃ tãmaa vĩmɛ,","poem":1},{"lineBreak":true},{"text":"zaakũ tó ò zↄ̃̀, àdi ɛra à bↄ̀tↄ pá,","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ a bↄ̀tↄ dufu pìi dì furo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bee tó a zĩni zĩ kũ̀ zĩtɛ gũn,","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ a mukutu gà bùsun,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"tó à í gbĩ mà, ani bↄ̀tↄ pá,","poem":1},{"lineBreak":true},{"text":"ani gã̀ bo lán lí kũ ò pɛ̀ɛ bà.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃ gà sↄ̃, àdigↄ̃ wutɛna sↄ̀rↄrↄ,","poem":1},{"lineBreak":true},{"text":"àdi tá àdigↄ̃ kun doro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lákũ sɛ̀bɛ'i dì lago nà,","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ swa'i dì baba à láka,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"lɛn bisãsiri dì wútɛ lɛ àdi futɛ doro,","poem":1},{"lineBreak":true},{"text":"ari ludambɛ gɛ́ gɛ̃tɛo, ani vuro,","poem":1},{"lineBreak":true},{"text":"ani vu kũ i pìioro.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó ĩni ma utɛ gyãwãnn","poem":1},{"lineBreak":true},{"text":"ǹ ↄ kúma ari n pↄ gòma dé!","poem":1},{"lineBreak":true},{"text":"Tó ĩni gↄrↄ lɛ́ ditɛmɛnɛ gwe","poem":1},{"lineBreak":true},{"text":"gbasa ǹ dↄ ma yãn dé!","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tó gbɛ̃ gà, ani ɛra àgↄ̃ kun yá?","poem":1},{"lineBreak":true},{"text":"Tó lɛmɛ, manigↄ̃ wɛ́ dↄ ma vunaai","poem":1},{"lineBreak":true},{"text":"ma ↄsikanaa gũn gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ĩni lɛ́ zumai mani wemma,","poem":1},{"lineBreak":true},{"text":"ĩni makũ kũ má de n ↄzĩ ũ bɛgɛ kɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gↄrↄ birea n wɛ́ nigↄ̃ tɛ́ ma yãkɛnanↄi,","poem":1},{"lineBreak":true},{"text":"ama ĩni ma durunna yã da doro.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ĩni ma taarinↄ ká bↄ̀kↄn ǹ yĩ ǹ ditɛ,","poem":1},{"lineBreak":true},{"text":"ĩni lá kú ma yãvãnikɛnaa pìnↄa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Lákũ kpi dì gboro à fãkↄ̃a nà,","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ sĩ̀sĩ musu gbɛ̀ gbɛ̃̀ntɛ̃ɛ dì sↄ̃sↄ̃,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"lákũ swa'i dì gbɛ̀ lↄ́lↄ nà,","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ í dì bùsu sɛ́tɛ à táo,","poem":1},{"lineBreak":true},{"text":"lɛn ndì bisãsiri tãmaa nɛnɛ lɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ndì gbãna mↄnɛ à tá, àdi su doro,","poem":1},{"lineBreak":true},{"text":"ndì tó a ãn litɛ à andunia tó.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tó a nɛ́nↄ gↄ̃̀ gbɛ̃ bɛ̀ɛrɛdenↄ ũ, ani dↄ̃ro,","poem":1},{"lineBreak":true},{"text":"tó ò kɛ̀ gbɛ̃ fítinↄ ũmɛ sↄ̃, ani ero.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wãwãn anigↄ̃ ma ado,","poem":1},{"lineBreak":true},{"text":"a zĩda pↄsiran àdigↄ̃ kɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":22}