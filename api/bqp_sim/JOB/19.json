{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"JOB","translationId":"bqp_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"3511bf0b289ad3bb2703cb20e89827096c9845db58fc8744a3751ed969350b13","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqp_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":19,"content":[{"type":"heading","content":["Ayuba wena a gbɛ̃nnanↄa"]},{"type":"verse","number":1,"content":[{"text":"Akũ Ayuba wè a gbɛ̃nnanↄla à pì:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ari bↄrɛn ánigↄ̃ wari dↄma,","poem":1},{"lineBreak":true},{"text":"àgↄ̃ ma nɛ̀sɛ yakamɛnɛ kũ yãzↄ̃zↄ̃naaoo?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A ma sↄ̃sↄ̃ à kɛ̀ gɛ̃̀n kuri sà,","poem":1},{"lineBreak":true},{"text":"átɛni ma fobo, wé'i dì á kũro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó ma sãtɛmɛ yãpura,","poem":1},{"lineBreak":true},{"text":"ma taari de ma zĩda yã ũmɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó a gi átɛni á zĩda sɛ́ lei demala,","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ átɛni ma taari e yã kũ à ma le musu,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"àgↄ̃ dↄ̃ kũ Luda mɛ́ à yã dí kɛ̀mɛnɛ kpɛdangara,","poem":1},{"lineBreak":true},{"text":"à tankutɛ kpàkpamɛnɛ à ma kũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Madì faaba wiki lɛ́, gbɛ̃ke dì wemaro,","poem":1},{"lineBreak":true},{"text":"madì surabana ↄ́ↄ dↄ, yãzɛde kunlo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Luda zɛ́ zↄ̃̀mɛnɛ, gɛ̃ki kunlo,","poem":1},{"lineBreak":true},{"text":"à gusira dà ma zɛ́la.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À ma kpe bò,","poem":1},{"lineBreak":true},{"text":"à ma fùraa gò.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Àdi ma wíwi kpa sĩnda pínkia ari ma laka,","poem":1},{"lineBreak":true},{"text":"àdi ma tãmaa nɛ lákũ òdi lí nɛ́ nà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Àdi a pↄfɛ̃ kipama,","poem":1},{"lineBreak":true},{"text":"àdi ma ditɛ a ibɛrɛ ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A zĩ̀karinↄ dì futɛmai lɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"òdi ma kagura kɛ,","poem":1},{"lineBreak":true},{"text":"òdi bùra kátɛ ò lika ma kpɛ́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"À tò ma gbɛ̃nↄ dì kakara kũmao doro,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ ò ma dↄ̃nↄ lɛ̀ɛ zↄ̃̀ ò tàtamalɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma danɛnↄ pã kpàmai,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃nnanↄ sã̀ ma yãn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma gↄ̃ nibↄ ũ ma bɛ zĩkɛrinↄnɛ,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ńnɛ lán buri zĩ̀tↄↄ bà.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó ma a bɛgwarii sìsi, àdi wema doro,","poem":1},{"lineBreak":true},{"text":"bee tó ma kútɛ kɛ̀nɛ kũ ma zĩda lɛ́o.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma lɛ́'ĩa dì kɛ ma nanↄnɛ lɛ́fↄtↄ ũmɛ,","poem":1},{"lineBreak":true},{"text":"ma vĩ̀ninↄ kũ ma dakũnanↄ yemai doro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bee nɛ́ ketenↄ dì ma gya bo se,","poem":1},{"lineBreak":true},{"text":"tó ma futɛ ma zɛ, òdigↄ̃ ma lalandi kɛmɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma kpàasinↄn ye ma yãiro,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃ yenyĩdenↄ bò ma kpɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma mɛ̀ yitoro kũ̀,","poem":1},{"lineBreak":true},{"text":"à gↄ̃̀ fíti mà ga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"À ma wɛ̃nda gwa ma gbɛ̃nnanↄ,","poem":1},{"lineBreak":true},{"text":"à ma wɛ̃nda gwa, zaakũ Luda ↄ tↄ̃̀mamɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"À kɛ̀ dera adì wɛ́ dↄma lán Luda dì wɛ́ dↄma nà?","poem":1},{"lineBreak":true},{"text":"Ma nↄ̀bↄ sona dí mↄ́áwa lɛroo?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"De ò ma yãnↄ kɛ̃̀","poem":1},{"lineBreak":true},{"text":"ò kà takadan.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"De ò kɛ̃̀ gbɛ̀ɛa kũ gão,","poem":1},{"lineBreak":true},{"text":"ò daruma kpàtɛn àgↄ̃ kun ari gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Zaakũ má dↄ̃ kũ ma Zɛkũnwode kun,","poem":1},{"lineBreak":true},{"text":"ani futɛ à zɛ ma sèedade ũ kpɛkpɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tó ma mɛ̀bara díkĩna kàkatɛ,","poem":1},{"lineBreak":true},{"text":"mani wɛ́ si Ludalɛ mɛ̀ɛ sari.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mani wɛ́ sialɛ ma zĩda,","poem":1},{"lineBreak":true},{"text":"ani kɛmɛnɛ gbɛ̃ zĩ̀tↄ ũro.","poem":1},{"lineBreak":true},{"text":"Yã pì ma kũna gbãna ma swɛ̃̀ɛ gũn.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"À kɛ̀ dera a wɛ́ dↄ̀mɛnɛ,","poem":1},{"lineBreak":true},{"text":"a pì makũ ma a zĩda lèoo?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"À vĩna kɛ Luda fɛ̃nɛdanɛ,","poem":1},{"lineBreak":true},{"text":"zaakũ ani pↄfɛ̃ kipao yãvãnikɛrinↄa,","poem":1},{"lineBreak":true},{"text":"de àgↄ̃ dↄ̃ kũ yãkpatɛ tɛni á dã.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":29}