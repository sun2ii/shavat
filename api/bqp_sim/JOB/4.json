{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"JOB","translationId":"bqp_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"3511bf0b289ad3bb2703cb20e89827096c9845db58fc8744a3751ed969350b13","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqp_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":4,"content":[{"type":"heading","content":["Ɛlifaza yãwena Ayubaa"]},{"type":"verse","number":1,"content":["Akũ Temana gbɛ̃ Ɛlifaza yã wèa à pì:"]},{"type":"verse","number":2,"content":[{"text":"Asa tó gbɛ̃ yã ònnɛ, ĩni pↄ fɛ̃roo?","poem":1},{"lineBreak":true},{"text":"Zaakũ mani fↄ̃ màgↄ̃ yĩtɛnaro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ǹ dↄn lákũ n lɛ́ dà gbɛ̃nↄa dasi nà,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃ kũ ń gbãna làkanↄ gbà swɛ̃̀ɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N yã gbɛ̃ kũ òtɛn funↄ sɛ̀ lei,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃ kũ ò busananↄ gbà gbãna.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kũ yã n le sà, akũ ntɛn fu,","poem":1},{"lineBreak":true},{"text":"kũ à sùmma, n bídi kɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N vĩnakɛna Ludanɛ dí n laakari kpátɛroo?","poem":1},{"lineBreak":true},{"text":"N kunna taari sari dì tó ǹgↄ̃ tãmaa vĩroo?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ laasun lɛ́ ǹ gwa!","poem":1},{"lineBreak":true},{"text":"Kisira taarisaride lè ziki ari à gà yá?","poem":1},{"lineBreak":true},{"text":"Mán ò gbɛ̃ mananↄ kàkatɛn zikii?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kũ à yã vãni bú wì à yãkete tↄ̃̀a,","poem":1},{"lineBreak":true},{"text":"ma è abire mɛ́ àdi butɛnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Luda lɛ́'ĩa mɛ́ àdi a kakatɛ,","poem":1},{"lineBreak":true},{"text":"a pↄ́ bona a yĩn mɛ́ àdi a dúgu zↄ̃.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A pũtãna kũ kòto gbãnao lán músuu bà dì láka,","poem":1},{"lineBreak":true},{"text":"Luda dì a saka woronɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Àdi ga lán músu kũ à nↄ̀bↄↄ wɛ̀tɛ à kùraii bà,","poem":1},{"lineBreak":true},{"text":"a nɛ́nↄ ni gbasa ò fãkↄ̃a.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yã sùma kpãni asiri gũn,","poem":1},{"lineBreak":true},{"text":"a ĩa gɛ̃̀ ma sãn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gↄrↄ kũ matɛn nana bɛ̃̀nɛ o gwãani,","poem":1},{"lineBreak":true},{"text":"gↄrↄ kũ gbɛ̃nↄ i ò ò kà zã̀,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"vĩna ma kũ matɛn lukaluka,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀gu sĩnda pínki tɛn luka.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ĩa ke buri ma pa ma ãnnwa,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀kãsɛsɛɛ fùtɛ à zɛ̀.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kũ à zɛ̀, mádi a taka dↄ̃ro,","poem":1},{"lineBreak":true},{"text":"pↄ́ pì kú ma arɛ,","poem":1},{"lineBreak":true},{"text":"akũ ma a kòto kpãni mà à pì,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"bisãsiri ni fↄ̃ àgↄ̃ de yãnnade ũ Ludanɛ yá?","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ ni fↄ̃ àgↄ̃ zɛ̃na a Kɛ̀ri arɛ yá?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Zaakũ Luda dì a malaikanↄ náani kɛro,","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ àdi a zĩkɛrii pìnↄ taari le,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ókↄ̃nↄ kũ ó mɛ̀ de lán ɛ̃ kpɛ́ bà,","poem":1},{"lineBreak":true},{"text":"ó kasana de bùsu kori ũ","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ òdi ó dúgu zↄ̃ lán dã̀mboroo bà,","poem":1},{"lineBreak":true},{"text":"oni ó pↄ́ o dↄ yá?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Zaa kↄnkↄ ari ↄkↄsi gbɛ̃nↄ dì gaga,","poem":1},{"lineBreak":true},{"text":"òdi kakatɛ ari gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"òdi ń tàasi káro.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Luda dì ń kuta lí gborońnɛ,","poem":1},{"lineBreak":true},{"text":"akũ òdi ga ↄ̃ndↄ̃ sari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}