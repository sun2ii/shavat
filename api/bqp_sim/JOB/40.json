{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"JOB","translationId":"bqp_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"3511bf0b289ad3bb2703cb20e89827096c9845db58fc8744a3751ed969350b13","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqp_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":40,"content":[{"type":"heading","content":["Bisãsiri dì fↄ̃ à Luda vãni boro"]},{"type":"verse","number":1,"content":["Akũ Dikiri ɛ̀ra à pì Ayubanɛ:"]},{"type":"verse","number":2,"content":[{"text":"Makũ Gbãnasĩndapinkide,","poem":1},{"lineBreak":true},{"text":"ĩni ma taari e ǹ ma gba laakari yá?","poem":1},{"lineBreak":true},{"text":"Ludavãnibori, ǹ yã wema sà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Akũ Ayuba wèa à pì:"]},{"type":"verse","number":4,"content":[{"text":"Pↄ́ken ma ũro fá! Deran mani wemmaa?","poem":1},{"lineBreak":true},{"text":"Séde mà ↄ kú ma lɛ́a baasiro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma yã ò gɛ̃̀n do, mani ɛra mà o doro,","poem":1},{"lineBreak":true},{"text":"ma ò gɛ̃̀n pla se, mani yã wemma doro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Akũ Dikiri ɛ̀ra à yã ò Ayubanɛ zàga'ĩa gũn à pì:"]},{"type":"verse","number":7,"content":[{"text":"Ǹ futɛ ǹ zɛ lán nɛ́gↄ̃gbɛ̃ bà,","poem":1},{"lineBreak":true},{"text":"mani n lala yãi, ĩni wema.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ĩni lá kú ma yãkɛna a zɛ́alan yá?","poem":1},{"lineBreak":true},{"text":"Ń ye ǹ ma taari e de n yã bo nnan yá?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N gã̀sã gbãna kà ma pↄ́ ũ yá?","poem":1},{"lineBreak":true},{"text":"N kòto ni fↄ̃ à gu yĩgã lán ma pↄ́ bà yá?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹ zↄ̃kↄ̃kɛ kũ kíkɛo da pↄ́kasa mananↄ ũ,","poem":1},{"lineBreak":true},{"text":"ǹ gakuri kũ bɛ̀ɛrɛɛo da uta zↄ̃kↄ̃ ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹ n pↄfɛ̃ kipaḿma,","poem":1},{"lineBreak":true},{"text":"ǹ zĩdabirinↄ gwa kũ wɛ́ pãsĩo ǹ wé'i daḿma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹ zĩdabirinↄ gwa kũ wɛ́ pãsĩo ǹ ń busa,","poem":1},{"lineBreak":true},{"text":"ǹ ń dúgu zↄ̃ gu kũ ò kún,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ǹ ń vĩ zĩtɛ ń pínki,","poem":1},{"lineBreak":true},{"text":"ǹ ń yĩyĩ ǹ ń ká gyãwãnn,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"gbasa mà n sáabu kpá,","poem":1},{"lineBreak":true},{"text":"kũ n zĩ̀i blè kũ n gã̀sã gbãnao yãi.","poem":1}]},{"type":"heading","content":["Ũma yã"]},{"type":"verse","number":15,"content":[{"text":"Ǹ ũma gwa,","poem":1},{"lineBreak":true},{"text":"kũ ma a kɛ̀ lákũ ma n kɛ nà.","poem":1},{"lineBreak":true},{"text":"Àdi sɛ̃̀ ble lán zùu bàmɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A gbãna kú a wógbaaamɛ,","poem":1},{"lineBreak":true},{"text":"a iko kú a gbɛrɛ báasiamɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A vlã porona lán sida lí bà,","poem":1},{"lineBreak":true},{"text":"a gbáda tĩ de lán bà tãnaa bà.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A wánↄ gbãna lán mↄ̀gotɛ̃ bà,","poem":1},{"lineBreak":true},{"text":"a gbánↄ de lán mↄ̀ gòo bà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A zↄ̃kↄ̃ mɛ́ à de pↄ́ bɛ̃nɛ kũ ma kɛ̀nↄla pínki,","poem":1},{"lineBreak":true},{"text":"a Kɛ̀ri ado mɛ́ ani a fↄ̃.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Sĩ̀sĩnↄ musun àdi pↄ́ blen,","poem":1},{"lineBreak":true},{"text":"gwen nↄ̀bↄsɛ̃ntɛnↄ dì fàai bon ń pínki.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Àdi wútɛ lɛ̀'itɛ gbáru,","poem":1},{"lineBreak":true},{"text":"àdigↄ̃ sↄtↄ vↄ̃n dã̀dãa gũn.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lɛ̀'itɛ uraa dì daala,","poem":1},{"lineBreak":true},{"text":"swa sarɛ lubanↄ dì likai.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bee tó ísↄ̃ tɛn vĩvĩ, àdi bídi kɛro,","poem":1},{"lineBreak":true},{"text":"tó Yoda ísↄ̃kɛna tɛni a lɛ́ pá,","poem":1},{"lineBreak":true},{"text":"a laakarii dìgↄ̃ kpátɛnamɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Oni fↄ̃ ò a wɛ́ wíwi ò a kũ yá?","poem":1},{"lineBreak":true},{"text":"Oni fↄ̃ ò ↄ̃ndↄ̃ kɛnɛ ò a yĩ fↄ̃ yá?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}