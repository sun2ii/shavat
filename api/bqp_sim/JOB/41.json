{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"JOB","translationId":"bqp_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"3511bf0b289ad3bb2703cb20e89827096c9845db58fc8744a3751ed969350b13","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqp_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":41,"content":[{"type":"heading","content":["Kwã kàsaraa"]},{"type":"verse","number":1,"content":[{"text":"Ĩni fↄ̃ ǹ kwã kàsara kũ kũ daburuuo","poem":1},{"lineBreak":true},{"text":"ǹ gátɛ ǹ boo yá?","poem":1},{"lineBreak":true},{"text":"Ĩni fↄ̃ ǹ bà dↄ a nɛ́nɛa yá?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ĩni fↄ̃ ǹ bà ká a yĩn yá?","poem":1},{"lineBreak":true},{"text":"Ĩni fↄ̃ ǹ a lɛ́gbako fↄ̃ kũ kúrao yá?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ani kútɛ kɛnnɛ ǹ a gbarɛ yá?","poem":1},{"lineBreak":true},{"text":"Ani pinnɛ ǹ sùru kɛ yá?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ani wennɛ ǹ a sɛ́ n zↄ̀ ũ","poem":1},{"lineBreak":true},{"text":"ari a wɛ̃̀ndi lɛ́n yá?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĩni a dato lákũ òdi bã dato nà yá?","poem":1},{"lineBreak":true},{"text":"Ĩni bà dↄa ǹ kpá n nɛ́nↄgbɛ̃nↄa yá?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sↄrↄkↄnↄ ni kwã kàsaraa pì tↄkɛḿma yá?","poem":1},{"lineBreak":true},{"text":"Oni a líli lagatarinↄnɛ yá?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ĩni fↄ̃ ǹ a pápa kũ sakao ǹ a bára fↄ̃ yá?","poem":1},{"lineBreak":true},{"text":"Ĩni fↄ̃ ǹ a mì kɛ yákiyaki kũ sário yá?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ wɛtɛ ǹ ↄ naa ǹ gwa!","poem":1},{"lineBreak":true},{"text":"Ɔsi pì yã ni sãnguro,","poem":1},{"lineBreak":true},{"text":"ĩni we ǹ a buri kɛ doro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó ntɛn da ĩni a fↄ̃, ntɛni n zĩda kɛkɛmɛ,","poem":1},{"lineBreak":true},{"text":"tó n wɛ́ sìalɛ, ndìgↄ̃ sùummɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zaakũ gbɛ̃ke wↄ́rↄgↄ dí ká à a go a gbɛ̀nlo,","poem":1},{"lineBreak":true},{"text":"dí mɛ́ ani fↄ̃ à zɛ ma arɛ sↄ̃ↄ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dí fĩna mɛ́ à dↄma kũ mani bonɛɛ?","poem":1},{"lineBreak":true},{"text":"Pↄ́ kũ à kú andunia gũn sĩnda pínki bi ma pↄ́mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mani gí kwã kàsaraa pì gbánↄ yã oiro","poem":1},{"lineBreak":true},{"text":"ke a gↄ̃sagbãnakɛ ke a manakɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dí mɛ́ ani fↄ̃ à a tɛ̀kɛɛ gogoo?","poem":1},{"lineBreak":true},{"text":"Dí mɛ́ ani we à sↄ̃mↄ kánɛɛ?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dí mɛ́ ani we à a lɛ́ wɛ̃kↄ̃aa?","poem":1},{"lineBreak":true},{"text":"A saka kà à gbɛ̃ naasi kũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A tɛ̀kɛ de lán sɛ̃gbakonↄ bà a kpɛ,","poem":1},{"lineBreak":true},{"text":"à didikↄ̃ana sarapura sari dↄ̀rↄdↄrↄ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A tɛ̀kɛɛ pìnↄ nanakↄ̃amɛ,","poem":1},{"lineBreak":true},{"text":"bee ĩa dì gɛ̃ki lero.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ò pɛ́pɛkɛrɛna gíngin,","poem":1},{"lineBreak":true},{"text":"oni sí gokↄ̃aro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó à yĩ sã̀, gu dì pumɛ,","poem":1},{"lineBreak":true},{"text":"a wɛ́ de lán ifãntɛ̃ bina kↄnkↄ bà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tɛ́nɛnɛ dì bↄtɛ a lɛ́n,","poem":1},{"lineBreak":true},{"text":"sĩsĩ tɛ́de dì bon dↄ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Túsukpɛ dìgↄ̃ bↄtɛ a yĩn","poem":1},{"lineBreak":true},{"text":"lán í kũ ò dì tɛ́a àtɛn pípi puusu bà.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A lɛ́'ĩa dì tó sĩsĩ tɛ́ sɛ́,","poem":1},{"lineBreak":true},{"text":"tɛ́nɛnɛ dì bo a lɛ́n.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A gbãna kú a wakaaamɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ à bòa mɛ̀ɛ dì kɛ kpã̀m.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A báasi dìgↄ̃ sↄ̃sↄ̃kↄ̃ana gíngin,","poem":1},{"lineBreak":true},{"text":"à naa gbãngbãn, àdi yĩgãro.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"A kù gbãna lán gbɛ̀ɛ bà,","poem":1},{"lineBreak":true},{"text":"lán wísilↄgbɛ da bà.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tó à fùtɛ, swɛ̃̀ɛ dì kɛ̃ gↄ̃sa gbãnanↄgu,","poem":1},{"lineBreak":true},{"text":"òdi kↄ̃ kɛ̃ kùo ò kura gɛ́kii.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Fɛ̃nɛda kũ ò a lɛ̀o pínki dì pↄ́ke kɛnɛro","poem":1},{"lineBreak":true},{"text":"ke sári ke kà ke saka.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Àdi mↄ̀si gwa lán leba bàmɛ,","poem":1},{"lineBreak":true},{"text":"mↄ̀gotɛ̃ dìgↄ̃ denɛ lán lí mùkumukuu bàmɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Àdi bàa lɛ́ kàanɛro,","poem":1},{"lineBreak":true},{"text":"gbɛ̀mba gbɛ̀ɛ dìgↄ̃ denɛ lán ése ũkã bàmɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Àdigↄ̃ gò gwa lán sɛ̃̀ kori bàmɛ,","poem":1},{"lineBreak":true},{"text":"sári kĩni dìgↄ̃ denɛ yáadↄyã ũmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"A gbɛrɛ tɛ̀kɛ de lán takaso bà,","poem":1},{"lineBreak":true},{"text":"a gbɛ̀ɛ dìgↄ̃ tɛ́ bↄkↄtↄn","poem":1},{"lineBreak":true},{"text":"lán zùswa guwibↄↄ bà.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Àdi í lòkoto ya lán í kũ àtɛn pípi oron bà,","poem":1},{"lineBreak":true},{"text":"àdi ísira dɛ lán nísidɛnaa bà.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Íwisi dìgↄ̃ tɛ́ a kpɛ,","poem":1},{"lineBreak":true},{"text":"ísira pìi dì ya a kpɛ púu.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"A sára kú andunia gũnlo,","poem":1},{"lineBreak":true},{"text":"ma pↄ́nↄ tɛ́ àkũ mɛ́ à vĩna vĩro.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Àdi nↄ̀bↄ kũ òdi ń zĩda binↄ da pↄ́ke ũro,","poem":1},{"lineBreak":true},{"text":"àkũmɛ nↄ̀bↄ kũ ò dìtɛ ò kànↄ kína ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}