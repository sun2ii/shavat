{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"JOB","translationId":"bqp_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"3511bf0b289ad3bb2703cb20e89827096c9845db58fc8744a3751ed969350b13","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bqp_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Ǹ lɛ́ zú sà ǹ ma tó gbɛ̃ke ni wemma.","poem":1},{"lineBreak":true},{"text":"Malaika kpaten ĩni arɛ dↄaa?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Íbɛtɛsɛnaa dì yↄ̃nkↄ dɛ,","poem":1},{"lineBreak":true},{"text":"nɛ̀sɛgↄ̃baa dì mìsaride kakatɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma è yↄ̃nkↄ zĩni pɛ̀tɛ,","poem":1},{"lineBreak":true},{"text":"akũ zĩni pìi yↄ̀ kãnto.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A nɛ́nↄ zã̀ kũ aafia kĩnaao,","poem":1},{"lineBreak":true},{"text":"òdi ń yãnↄ mátɛmatɛńnɛ yãkpatɛkɛkia,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ke dì zɛ kũńworo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nàdɛrinↄ dì a burapↄnↄ ble,","poem":1},{"lineBreak":true},{"text":"bee pↄ́ kũ à lɛ̀ɛ lìkainↄ,","poem":1},{"lineBreak":true},{"text":"ímidɛrinↄ dì luka a aruzɛkɛi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kisira dì futɛ bùsunlo,","poem":1},{"lineBreak":true},{"text":"wari dì butɛ zĩtɛro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lákũ tɛ́pũtãna gɛna musu sika vĩro nà,","poem":1},{"lineBreak":true},{"text":"lɛn gbɛ̃ kũ ò ì pínki dì wari le lɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tó makũmɛ sↄ̃, Ludan mani gbɛka,","poem":1},{"lineBreak":true},{"text":"mani ma yã kpátɛ a arɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Àdi yã zↄ̃kↄ̃ kɛ kũ oni fↄ̃ ò a gbá dↄ̃ro,","poem":1},{"lineBreak":true},{"text":"oni fↄ̃ ò a yãbonsarɛkɛnanↄ lɛ́ dↄ̃ro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Àdi tó legũ ma zĩtɛ,","poem":1},{"lineBreak":true},{"text":"àdi tó a í dagula sɛ̃̀ntɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Àdi gbɛ̃ busananↄ sɛ́ lei,","poem":1},{"lineBreak":true},{"text":"àdi wɛ̃ndadenↄ da pↄnnan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Àdi yã kũ manafikidenↄ tɛn pɛ́a gboro,","poem":1},{"lineBreak":true},{"text":"de ń ↄzĩ súngↄ̃ arubarika vĩro yãi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Àdi ↄ̃ndↄ̃rinↄ kũ ń wɛ́zɛ̃ gũn,","poem":1},{"lineBreak":true},{"text":"àdi tó yãlɛkpɛrɛ'orinↄ yãgↄ̃gↄ̃na kɛ pã.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gu dì sira kũḿma fãnantɛ̃,","poem":1},{"lineBreak":true},{"text":"òdi ↄ mátɛmatɛ fãnantɛ̃ lán gwãani bà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Àdi takasidenↄ bo ga lɛ́i,","poem":1},{"lineBreak":true},{"text":"àdi pↄ́saridenↄ bo gbãnamↄnnɛrinↄ ↄĩ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A yã mɛ́ à tò gbãnasaridenↄn tãmaa vĩ,","poem":1},{"lineBreak":true},{"text":"yãzɛdesaridenↄ dì yĩtɛ kyáu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Arubarikaden gbɛ̃ kũ Luda dì a toto ũ.","poem":1},{"lineBreak":true},{"text":"Tó àtɛni n sã gaga, ǹsun yãvunu káro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Zaakũ àdi gbɛ̃ kĩnna akũ àdi a bↄ̀ gwa,","poem":1},{"lineBreak":true},{"text":"àdi gbɛ̃ wíwi akũ àdi a werekↄ̃a.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ani n bo yãn gɛ̃̀n suddo,","poem":1},{"lineBreak":true},{"text":"bee tó à kà gɛ̃̀n suppla, kisira ni n lero.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ani n sí gaa nàgↄrↄ,","poem":1},{"lineBreak":true},{"text":"ani n bo fɛ̃nɛda lɛ́i zĩ̀lan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dikiri ni n bo gbɛ̃yakarinↄ ↄĩ,","poem":1},{"lineBreak":true},{"text":"tó yakanaa sù, vĩna ni n kũro.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ĩni yakana kũ nàao yáa dↄ,","poem":1},{"lineBreak":true},{"text":"ĩni vĩna kɛ nↄ̀bↄ pãsĩnↄnɛro.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Zaakũ ĩnigↄ̃ kun aafia kũ gbɛ̀nↄ,","poem":1},{"lineBreak":true},{"text":"ĩnigↄ̃ nna kũ nↄ̀bↄsɛ̃ntɛnↄ,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ĩnigↄ̃ dↄ̃ kũ n ↄn nigↄ̃ nna,","poem":1},{"lineBreak":true},{"text":"tó n gɛ n kpàsan, pↄ́ke ni kĩaro.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ĩnigↄ̃ dↄ̃ kũ n nɛ́nↄ ni kɛ dasi,","poem":1},{"lineBreak":true},{"text":"n burinↄ ni dagula lán sɛ̃̀ɛ bà.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ĩni zĩ kũ yúkuyuku gbasa ǹ ga","poem":1},{"lineBreak":true},{"text":"lán ése kũ à mà ò kɛ̃̀ a gↄrↄaa bà.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Kũ o yã pìi asiri gbɛ̀ka, lɛn à de lɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ yã pì sí ńgↄ̃ dↄ̃ kũ n zĩda yãmɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}