{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"JOL","translationId":"bqp_sim","name":"Yoɛli","commonName":"Yoɛli","title":"YOƐLI","order":29,"numberOfChapters":4,"sha256":"51e3254381a1c450f099e5d2632be6c5acf19154286be04f73702c7259c5a53f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bqp_sim/JOL/4.json","totalNumberOfVerses":71},"chapter":{"number":3,"content":[{"type":"heading","content":["Yinni Gusunɔ u koo"]},{"type":"heading","content":["win Hunde doke tɔmbu sɔɔ"]},{"type":"verse","number":1,"content":[{"text":"Yen biru kon nɛn Hunde doke tɔmbu kpuro sɔɔ.","poem":1},{"lineBreak":true},{"text":"Bɛɛn bii tɔn durɔbu kɑ tɔn kurɔbu bɑ koo nɛn gɑri gere,","poem":1},{"lineBreak":true},{"text":"kpɑ bɛɛn durɔ tɔkɔnu nu n dosusu mɔ̀,","poem":1},{"lineBreak":true},{"text":"kpɑ bɛɛn ɑluwɑɑsibɑ bu kɑ̃sinu wɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bɑɑ kɑ yobɔ, kon bu nɛn Hunde wɛ̃wɑ tɔ̃ɔ te.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yen tɔ̃ɔ te sɔɔ, kon mɑɑmɑɑkibɑ ko.","poem":1},{"lineBreak":true},{"text":"Kon de yɛm kɑ dɔ̃ɔ kɑ wii bɑkɑsu sɔ̃ɔsirɑ wɔllɔ kɑ temɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sɔ̃ɔ u koo yɑm tĩrɑ,","poem":1},{"lineBreak":true},{"text":"kpɑ suru u swɛ̃rɑ nge yɛm,","poem":1},{"lineBreak":true},{"text":"Yinni Gusunɔn tɔ̃ɔ nɑnumgii te, tu sere tunumɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Adɑmɑ yen tɔ̃ɔ te,","poem":1},{"lineBreak":true},{"text":"wi u Yinni Gusunɔ sokɑ, u koo fɑɑbɑ wɑ.","poem":1},{"lineBreak":true},{"text":"Gɑbu bɑ koo kisirɑ nɔni swɑ̃ɑ ten di","poem":1},{"lineBreak":true},{"text":"Siɔnin guurɔ Yerusɑlɛmuɔ","poem":1},{"lineBreak":true},{"text":"nge mɛ Yinni Gusunɔ u geruɑ.","poem":1},{"lineBreak":true},{"text":"Beyɑ be u sokɑ bɑ n kɑ wɑ̃ɑru mɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/JOL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}