{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"LUK","translationId":"bqp_sim","name":"LUKU","commonName":"LUKU","title":"LUKU","order":42,"numberOfChapters":24,"sha256":"7a1c4ed22884666243fff3cd54435667e1d74870ae32d98bf94c75064a7bf5b5","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bqp_sim/LUK/24.json","totalNumberOfVerses":1148},"chapter":{"number":3,"content":[{"type":"heading","content":["Yahaya Da'itɛkɛri waazikɛnaa"]},{"type":"verse","number":1,"content":["Siza Tiberia kíblena wɛ̃̀ gɛ̃rode gũn Pↄntiu Pilati mɛ́ à Yudea bùsu gbɛ̃ zↄ̃kↄ̃ ũ, Hɛrↄdu tɛn kí ble Galili, a vĩ̀ni Filipi tɛn kí ble Iturea bùsun kũ Tarakↄniti bùsuuo, Lisania sↄ̃ àtɛn kí ble Abilɛnɛ bùsun."]},{"type":"verse","number":2,"content":["Anasa kũ Kayafaoomɛ sa'orikinↄ ũ. Gↄrↄ kũ̀a Luda yã ò Zakari nɛ́ Yahayanɛ gbárannan."]},{"type":"verse","number":3,"content":["Akũ à fùtɛ àtɛn kure Yoda bara dire kũ bara laooi pínki, àtɛn waazi kɛ gbɛ̃nↄnɛ. À òńnɛ ò ń nɛ̀sɛ litɛ ò da'itɛ kɛ, Luda ni ń durunnanↄ kɛ̃ḿma."]},{"type":"verse","number":4,"content":["Lákũ à kú annabi Isaya takada gũn nà à pì:",{"text":"À baarukparii kòto ma dↄ gbárannan,","poem":1},{"lineBreak":true},{"text":"àtɛn pi à zɛ́ kɛkɛ Dikirinɛ,","poem":1},{"lineBreak":true},{"text":"à zɛ́ térerenↄ poronɛ súsu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Guvutɛ pínki ni tata,","poem":1},{"lineBreak":true},{"text":"kpinↄ kũ sĩ̀sĩnↄ ni datɛ pínki.","poem":1},{"lineBreak":true},{"text":"Zɛ́ kotinanↄ ni poro súsu,","poem":1},{"lineBreak":true},{"text":"zɛ́ wókũwokũnↄ ni kpákũsũ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"gbɛ̃ sĩnda pínki ni e lákũ Luda dì ń sura ba nà.","poem":1}]},{"type":"verse","number":7,"content":["Gbɛ̃nↄ dìgↄ̃ su a kĩnaa dasi ò da'itɛ kɛ, akũ àdi ońnɛ: Bisãsiri pitikonↄ! De mɛ́ à lɛ́ dàáwa à bàa sí pↄfɛ̃ kũ Luda ni kipaḿmanɛɛ?"]},{"type":"verse","number":8,"content":["À nɛ̀sɛlitɛna yã kɛ, onigↄ̃ dↄ̃ kũ a litɛ. Kũ Ibrahĩ de á dizi ũ, àsungↄ̃ da kũ abirekũ mɛ́ ani á boro. Matɛn oárɛ, Luda ni fↄ̃ à gbɛ̀ dínↄ kɛ Ibrahĩ burinↄ ũ."]},{"type":"verse","number":9,"content":["Kpása ditɛna línↄi kↄ̀. Lí kũ àdi nɛ́ mana iro, Luda ni zↄ̃ à zu tɛ́ gũn."]},{"type":"verse","number":10,"content":["Gbɛ̃nↄ a là ò pì: Tó lɛmɛ, óni kɛ deraa?"]},{"type":"verse","number":11,"content":["À wèḿma à pì: Gbɛ̃ kũ à uta vĩ mɛ̀n pla, à a do kpá gbɛ̃ kũ à vĩroa. Gbɛ̃ kũ à pↄ́ble vĩ, à kɛ lɛ dↄ."]},{"type":"verse","number":12,"content":["Bɛ'ↄgↄsirinↄ sù da'itɛ kɛ, akũ ò a là ò pì: Dannɛri, óni kɛ deraa?"]},{"type":"verse","number":13,"content":["À wèḿma à pì: Ásun bɛ'ↄgↄ síḿma de lákũ ò dìtɛ nàlaro."]},{"type":"verse","number":14,"content":["Sozanↄ a là: Ókↄ̃nↄ sↄ̃, óni kɛ deraa? À òńnɛ: Ásun gbãna mↄ gbɛ̃nↄnɛ à ń blero. À zɛ kũ fĩna kũ òdi boárɛo."]},{"type":"verse","number":15,"content":["Gbɛ̃nↄ wɛ́dↄina tɛn kara. Baadi pínki tɛn laasun lɛ́ a nɛ̀sɛɛ gũn Yahaya yãa, tó àkũmɛ Arumasihu ũ."]},{"type":"verse","number":16,"content":["Yahaya òńnɛ ń pínki à pì: Madì á da'itɛ kɛ kũ íomɛ. Ama gbɛ̃ke ni su a gbãna demala, mádi ká mà a kyate bobonɛro. Àkũ mɛ́ ani á da'itɛ kɛ kũ Luda Ninio kũ tɛ́o."]},{"type":"verse","number":17,"content":["À gbaka kũna kũ ani pↄ́ fão. Ani pↄ́blewɛ ká a dↄ̃̀n, ani a sàko ká tɛ́ kũ àdi garo gũn."]},{"type":"verse","number":18,"content":["Yahaya baaru nna kpannɛnaa gũn, à nàkaraḿma kũ yã pãndenↄo dasi."]},{"type":"verse","number":19,"content":["Akũ à yã kpã̀kɛ̃ kína Hɛrↄdui a vĩ̀ni nanↄ Hɛrↄdia yã musu kũ yã vãni pãnde kũ à kɛ̀nↄ pínki,"]},{"type":"verse","number":20,"content":["akũ Hɛrↄdu ɛ̀ra à yã vãni kɛ̀ dↄ, à Yahaya dà kpɛ́siran."]},{"type":"heading","content":["Yesu da'itɛkɛnaa"]},{"type":"verse","number":21,"content":["Kũ Yahaya tɛn gbɛ̃nↄ da'itɛ kɛ ń pínki, à Yesu da'itɛ kɛ̀ se. Gↄrↄ kũ Yesu tɛn adua kɛ, ludambɛ wɛ̃̀kↄ̃a,"]},{"type":"verse","number":22,"content":["akũ Luda Nini sùa à de lán potɛ̃nɛ bà. Akũ à kòto ke mà bona ludambɛ à pì: Mↄkↄ̃n ma Nɛ́ mɛ̀n do légelege yenyĩde ũ, kũ ma pↄ nnamma manamana."]},{"type":"heading","content":["Yesu buri bozirɛ"]},{"type":"verse","number":23,"content":["Gↄrↄ kũ Yesu nà a zĩa, à kà wɛ̃̀ baraakuri taka. Òtɛn da Yusufu nɛ́'inaamɛ.",{"text":"Yusufu sↄ̃ Eli nɛ́mɛ,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Eli sↄ̃ Matata nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Matata sↄ̃ Levi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Levi sↄ̃ Mɛlɛki nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Mɛlɛki sↄ̃ Yanai nɛ́mɛ,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yanai sↄ̃ Yusufu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yusufu sↄ̃ Matatia nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Matatia sↄ̃ Amↄsi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Amↄsi sↄ̃ Naumu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Naumu sↄ̃ Ɛsɛli nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛsɛli sↄ̃ Nagai nɛ́mɛ,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nagai sↄ̃ Maata nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Maata sↄ̃ Matatia nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Matatia sↄ̃ Sɛmɛi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Sɛmɛi sↄ̃ Yosɛki nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yosɛki sↄ̃ Yoda nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yoda sↄ̃ Yoanana nɛ́mɛ,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yoanana sↄ̃ Resa nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Resa sↄ̃ Zɛrubabɛli nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Zɛrubabɛli sↄ̃ Sealatiɛli nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Sealatiɛli sↄ̃ Nɛri nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Nɛri sↄ̃ Mɛlɛki nɛ́mɛ,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mɛlɛki sↄ̃ Adi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Adi sↄ̃ Kosamu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Kosamu sↄ̃ Ɛlɛmadamu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛlɛmadamu sↄ̃ Ɛɛ nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛɛ sↄ̃ Yↄsua nɛ́mɛ,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yↄsua sↄ̃ Ɛliɛza nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛliɛza sↄ̃ Yorimu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yorimu sↄ̃ Matata nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Matata sↄ̃ Levi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Levi sↄ̃ Simɛↄ nɛ́mɛ,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Simɛↄ sↄ̃ Yuda nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yuda sↄ̃ Yusufu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yusufu sↄ̃ Yonamu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yonamu sↄ̃ Ɛliakimu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛliakimu sↄ̃ Mɛlɛa nɛ́mɛ,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mɛlɛa sↄ̃ Mɛna nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Mɛna sↄ̃ Matata nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Matata sↄ̃ Natã nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Natã sↄ̃ Dauda nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Dauda sↄ̃ Yɛsɛ nɛ́mɛ,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Yɛsɛ sↄ̃ Ɔbɛdi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɔbɛdi sↄ̃ Bↄaza nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Bↄaza sↄ̃ Salamↄ nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Salamↄ sↄ̃ Nasↄ̃ nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Nasↄ̃ sↄ̃ Aminadabu nɛ́mɛ,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Aminadabu sↄ̃ Ramu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ramu sↄ̃ Ɛzɛrↄnu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛzɛrↄnu sↄ̃ Pɛrɛzi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Pɛrɛzi sↄ̃ Yuda nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yuda sↄ̃ Yakubu nɛ́mɛ,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Yakubu sↄ̃ Isaaku nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Isaaku sↄ̃ Ibrahĩ nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ibrahĩ sↄ̃ Tera nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Tera sↄ̃ Nao nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Nao sↄ̃ Serugu nɛ́mɛ,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Serugu sↄ̃ Rɛu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Rɛu sↄ̃ Pɛlɛgi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Pɛlɛgi sↄ̃ Eberu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Eberu sↄ̃ Sela nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Sela sↄ̃ Kaina nɛ́mɛ,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Kaina sↄ̃ Apasada nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Apasada sↄ̃ Sɛmu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Sɛmu sↄ̃ Nuhu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Nuhu sↄ̃ Lamɛki nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Lamɛki sↄ̃ Mɛtusela nɛ́mɛ,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Mɛtusela sↄ̃ Ɛnↄku nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛnↄku sↄ̃ Yarɛdi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yarɛdi sↄ̃ Malalɛli nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Malalɛli sↄ̃ Kenana nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Kenana sↄ̃ Ɛnↄsu nɛ́mɛ,","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Ɛnↄsu sↄ̃ Sɛti nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Sɛti sↄ̃ Adamu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Adamu sↄ̃ Luda nɛ́mɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/LUK/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/LUK/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/LUK/2.json","previousChapterAudioLinks":{},"numberOfVerses":38}