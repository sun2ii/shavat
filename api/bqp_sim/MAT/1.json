{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"MAT","translationId":"bqp_sim","name":"MATIU","commonName":"MATIU","title":"MATIU","order":40,"numberOfChapters":28,"sha256":"3e1931a51025b15e4cc8e7ba204eb3f5622054a2355782d05eb1d1919018ada1","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bqp_sim/MAT/28.json","totalNumberOfVerses":1068},"chapter":{"number":1,"content":[{"type":"heading","content":["Yesu Kirisi buri bozirɛ"]},{"type":"verse","number":1,"content":["Ibrahĩ kũ Daudao buri Yesu Kirisi bozirɛn dí:"]},{"type":"verse","number":2,"content":[{"text":"Ibrahĩ Isaaku ì,","poem":1},{"lineBreak":true},{"text":"Isaaku Yakubu ì,","poem":1},{"lineBreak":true},{"text":"Yakubu Yuda ì kũ a vĩ̀ninↄ kũ a dakũnanↄ,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuda Pɛrɛzi kũ Zɛrao ì kũ a nↄ Tamao,","poem":1},{"lineBreak":true},{"text":"Pɛrɛzi Ɛzɛrↄnu ì,","poem":1},{"lineBreak":true},{"text":"Ɛzɛrↄnu Ramu ì,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ramu Aminadabu ì,","poem":1},{"lineBreak":true},{"text":"Aminadabu Nasↄ̃ ì,","poem":1},{"lineBreak":true},{"text":"Nasↄ̃ Salamↄ ì,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salamↄ Bↄaza ì kũ a nↄ Rahabuo.","poem":1},{"lineBreak":true},{"text":"Bↄaza Ɔbɛdi ì kũ a nↄ Rutuo,","poem":1},{"lineBreak":true},{"text":"Ɔbɛdi Yɛsɛ ì,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"akũ Yɛsɛ kína Dauda ì.","poem":1},{"lineBreak":true},{"text":"Akũ Dauda Sulemanu ì kũ Uria nanↄo,","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Sulemanu Reoboamu ì,","poem":1},{"lineBreak":true},{"text":"Reoboamu Abia ì,","poem":1},{"lineBreak":true},{"text":"Abia Asa ì,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa Yosafata ì,","poem":1},{"lineBreak":true},{"text":"Yosafata Yehoramu ì,","poem":1},{"lineBreak":true},{"text":"Yehoramu Uzia ì,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Uzia Yotamu ì,","poem":1},{"lineBreak":true},{"text":"Yotamu Aza ì,","poem":1},{"lineBreak":true},{"text":"Aza Ɛzɛkaya ì,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɛzɛkaya Manase ì,","poem":1},{"lineBreak":true},{"text":"Manase Amↄ ì,","poem":1},{"lineBreak":true},{"text":"Amↄ Yosia ì,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yosia Yoyakini ì kũ a dakũnanↄ gↄrↄ kũ ò gbɛ̃nↄ kũ̀kũ ò tà kũńwo Babilↄnu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Tana kũ gbɛ̃nↄ Babilↄnu gbɛran Yoyakini Sealatiɛli ì,",{"text":"Sealatiɛli Zɛrubabɛli ì,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zɛrubabɛli Abiudu ì,","poem":1},{"lineBreak":true},{"text":"Abiudu Ɛliakimu ì,","poem":1},{"lineBreak":true},{"text":"Ɛliakimu Azↄ ì,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azↄ Zadↄki ì,","poem":1},{"lineBreak":true},{"text":"Zadↄki Akimu ì,","poem":1},{"lineBreak":true},{"text":"Akimu Ɛliudu ì,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ɛliudu Ɛlɛaza ì,","poem":1},{"lineBreak":true},{"text":"Ɛlɛaza Matã ì,","poem":1},{"lineBreak":true},{"text":"Matã Yakubu ì,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yakubu Mariama zã Yusufu ì,","poem":1},{"lineBreak":true},{"text":"akũ Mariama Yesu kũ òdi pinɛ Arumasihu ì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":["Zaa Ibrahĩ gↄrↄa ari à gɛ̀ɛ pɛ́ Daudaa, de kũ a nɛ́o kun gɛ̃ro donsarimɛ. Zaa Dauda gↄrↄa ari gↄrↄ kũ ò tà kũ gbɛ̃nↄo Babilↄnu, de kũ a nɛ́o kun gɛ̃ro donsarimɛ. Zaa tana kũ gbɛ̃nↄo Babilↄnu ari à gɛ̀ɛ pɛ́ Arumasihua, de kũ a nɛ́o kun gɛ̃ro donsarimɛ."]},{"type":"heading","content":["Yesu Kirisi inaa"]},{"type":"verse","number":18,"content":["Deran ò Yesu Kirisi ì nàn dí: A da Mariama kun Yusufu nↄkpamma ũmɛ. Ari àgↄ̃ gɛ́ zã kɛ, à nↄ̀ sì kũ Luda Nini gbãnao."]},{"type":"verse","number":19,"content":["A gↄ̃kpamma Yusufu bi gbɛ̃ manamɛ, à ye à wé'i daaro, akũ à zɛ̀o kũ áni bo a yãn asiri gũn."]},{"type":"verse","number":20,"content":["Gↄrↄ kũ àtɛn laasun lɛ́ yã pìia, Dikiri malaika bò à sùa nana gũn à pìnɛ: Dauda buri Yusufu, ǹsun bídi kɛ n nↄkpamma Mariama sɛna yã musuro, zaakũ nↄ̀ kũ à sinaa bò Luda Nini kĩnaamɛ."]},{"type":"verse","number":21,"content":["Ani nɛ́ i gↄ̃gbɛ̃ ũ, ĩni tↄ́ kpánɛ Yesu, zaakũ ani a gbɛ̃nↄ bo ń durunnanↄ gũn."]},{"type":"verse","number":22,"content":["Abirekũ kɛ̀ pínki, de yã kũ Dikiri dà annabii gãi kɛ, à pì:"]},{"type":"verse","number":23,"content":[{"text":"Nↄkpare lési mɛ́ ani nↄ̀ sí","poem":1},{"lineBreak":true},{"text":"à nɛ́ i gↄ̃gbɛ̃ ũ,","poem":1},{"lineBreak":true},{"text":"oni tↄ́ kpánɛ Imanuɛli.","poem":1},"Tↄ́ pìi pì, Luda kú kũoo."]},{"type":"verse","number":24,"content":["Kũ Yusufu vù, à kɛ̀ lákũ Dikiri malaika dìtɛnɛ nà, à a nↄ pìi sɛ̀."]},{"type":"verse","number":25,"content":["Ama adi a dↄ̃ nↄgbɛ̃ ũro ari à gɛ̀ɛ à nɛ́gↄ̃gbɛ̃ pìi ì. Akũ à tↄ́ kpànɛ Yesu."]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/MAL/4.json","previousChapterAudioLinks":{},"numberOfVerses":25}