{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"NEH","translationId":"bqp_sim","name":"NƐƐMAYA","commonName":"NƐƐMAYA","title":"NƐƐMAYA","order":16,"numberOfChapters":8,"sha256":"027f9bc0f1ecc09f800f40c0c588d2c512cd9d4a4c5f36e96717183a38b3ef9e","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/NEH/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/bqp_sim/NEH/9.json","totalNumberOfVerses":151},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["Kũ o bĩni bò akũsↄ̃ ma a lɛ́ gbànↄ pɛ̀tɛpɛtɛ, ò zɛ́dãkpãrinↄ kũ lɛ̀sirinↄ kũ Levinↄ dìtɛ."]},{"type":"verse","number":2,"content":["Akũ ma a dakũna Anani dìtɛ Yurusalɛmu gbɛ̃ zↄ̃kↄ̃ ũ kũ zɛki gbãna gbɛ̃ zↄ̃kↄ̃ Ananiao, zaakũ gbɛ̃ náanidemɛ. À Luda vĩna vĩ de gbɛ̃ dasinↄla."]},{"type":"verse","number":3,"content":["Ma pìńnɛ: Òsungↄ̃ Yurusalɛmu bĩnilɛ gbànↄ wɛ̃ro ari ifãntɛ̃ gɛ́ gbãna kũ. Ògↄ̃ zɛ́ tata ò lígurukpanↄ dan ari zɛ́dãkpãrinↄ tá. Ò Yurusalɛmudenↄ ditɛditɛ gudãkpãrinↄ ũ dↄ, ń gbɛ̃kenↄ gↄ̃ kú dãkpãkia, ń gbɛ̃kenↄ ń bɛ sarɛ."]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/NEH/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/NEH/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/NEH/6.json","previousChapterAudioLinks":{},"numberOfVerses":3}