{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PRO","translationId":"bqp_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"43db1ce29ddacdbd2b699df058f8582757839afde1c3f66de758b6e995c36763","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqp_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":2,"content":[{"type":"heading","content":["Tɛna ↄ̃ndↄ̃i àree"]},{"type":"verse","number":1,"content":["Ma nɛ́, tó n ma yã sì,",{"text":"tó ń ma yãditɛnanↄ kũna n swɛ̃̀n,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"tó ntɛn sã kpá ↄ̃ndↄ̃yãi,","poem":1},{"lineBreak":true},{"text":"tó n swɛ̃̀ɛ kpà yã asãnsia,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"tó n lɛ́ zù wɛ́zɛ̃i,","poem":1},{"lineBreak":true},{"text":"tó n wiki lɛ̀ yã dↄ̀rↄ dↄ̃naaa,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"tó n kpatɛ kɛ̀i lán andurufuu bà,","poem":1},{"lineBreak":true},{"text":"tó n wɛ̀tɛ lán aruzɛkɛ kũ à utɛnaa bà,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ĩnigↄ̃ vĩnakɛna Dikirinɛ dↄ̃ sà,","poem":1},{"lineBreak":true},{"text":"ĩni bo Luda dↄ̃naaa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zaakũ Dikiri mɛ́ àdi ń gba ↄ̃ndↄ̃,","poem":1},{"lineBreak":true},{"text":"dↄ̃na kũ yã dↄ̀rↄ dↄ̃naao dì bo a kĩnaamɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À zĩ̀blena kũna gbɛ̃ mananↄnɛ,","poem":1},{"lineBreak":true},{"text":"à de sɛ̃gbako ũ taarisaridenↄnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Àdi ↄ lika gbɛ̃ mananↄi ń zɛ́ gũn,","poem":1},{"lineBreak":true},{"text":"àdi a yãmarinↄ dãkpã ń táa'onaa gũn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ĩnigↄ̃ yãzɛde dↄ̃ sà kũ yã súsuo","poem":1},{"lineBreak":true},{"text":"kũ yã manao kũ zɛ́ manao pínki.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zaakũ ↄ̃ndↄ̃ ni gɛ̃ n swɛ̃̀n,","poem":1},{"lineBreak":true},{"text":"dↄ̃na ni n pↄ kɛ nna.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N laakari ni n dãkpã,","poem":1},{"lineBreak":true},{"text":"asãnsi ni ↄ likanyĩ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ani n bo gbɛ̃ vãninↄ zɛ́n","poem":1},{"lineBreak":true},{"text":"ani n sí yãbɛ̃nɛ'orinↄ ↄĩ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃ pìnↄ pã̀ zɛ́ súsunɛ,","poem":1},{"lineBreak":true},{"text":"ò gusira zɛ́ sɛ̀.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Òdi pↄnna kɛ vãnikɛnaa gũn,","poem":1},{"lineBreak":true},{"text":"òdi yã vãni fayasari nna ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ń yãkɛna súsuro,","poem":1},{"lineBreak":true},{"text":"òdigↄ̃ yã kɛ kũ manafikiomɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɔ̃ndↄ̃ pì ni n sí zinakɛri ↄĩ,","poem":1},{"lineBreak":true},{"text":"ani n bo karua yãnnanna'onnɛnan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nↄgbɛ̃ pì pã kpà a nɛ́nↄkparekɛgↄrↄ gↄ̃i,","poem":1},{"lineBreak":true},{"text":"à Luda bàka kunna kãao yã gbòro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A bɛ dì mì pɛ́ kũńwo gaamɛ,","poem":1},{"lineBreak":true},{"text":"a kpɛ́ zɛ́ dì tá kũńwo gyãwãn.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kũ à gɛ̃̀ii dì nɛ̀sɛ litɛro,","poem":1},{"lineBreak":true},{"text":"àdi wɛ̃̀ndi zɛ́ le doro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ɔ̃ndↄ̃ pì ni n da gbɛ̃ mananↄ zɛ́a,","poem":1},{"lineBreak":true},{"text":"ĩnigↄ̃ dↄ̀rↄdenↄ zɛ́ kũna.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Zaakũ nɛ̀sɛpuradenↄ mɛ́ oni gↄ̃ bùsu vĩ,","poem":1},{"lineBreak":true},{"text":"taarisaridenↄ mɛ́ onigↄ̃ kú a gũn.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yãvãnikɛrinↄ sↄ̃, oni pɛ́ḿma ò ń bↄtɛ bùsun,","poem":1},{"lineBreak":true},{"text":"oni náanisaridenↄ kpakɛ a gũn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}