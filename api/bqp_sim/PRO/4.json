{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PRO","translationId":"bqp_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"43db1ce29ddacdbd2b699df058f8582757839afde1c3f66de758b6e995c36763","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqp_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":4,"content":[{"type":"heading","content":["Gbɛ̃ zↄ̃kↄ̃ lɛ́damma"]},{"type":"verse","number":1,"content":["Ma nɛ́nↄ, à gbɛ̃ zↄ̃kↄ̃ lɛ́damma ma,",{"text":"à laakari dↄa de à asãnsi le.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dↄ̃na súsun matɛn daárɛ,","poem":1},{"lineBreak":true},{"text":"àsun pã kpá ma yãdannɛnaairo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kũ má kun nɛ́ ũ ma de ↄĩ,","poem":1},{"lineBreak":true},{"text":"má busana ma da nɛ́ mɛ̀n do légelege ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma de yã dàmɛnɛ à pì:","poem":1},{"lineBreak":true},{"text":"Ǹgↄ̃ ma yã kũna n swɛ̃̀ɛ gũn,","poem":1},{"lineBreak":true},{"text":"ǹ ma yãditɛnanↄ da ĩnigↄ̃ kun.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ǹ ↄ̃ndↄ̃ kũ ǹgↄ̃ dↄ̃na vĩ,","poem":1},{"lineBreak":true},{"text":"ǹsun sãsãi ǹ pã ma yãnɛro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹsun pã kpá ↄ̃ndↄ̃iro, ani n dãkpã,","poem":1},{"lineBreak":true},{"text":"ǹgↄ̃ yei, ani ↄ kúmma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ ↄ̃ndↄ̃ kũ, àkũmɛ yã sĩnda pínki mì ũ,","poem":1},{"lineBreak":true},{"text":"ǹ dↄ̃na wɛtɛ kũ aruzɛkɛ kũ ń vĩo pínki.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ a kũ gbãngbãn, ani n kara,","poem":1},{"lineBreak":true},{"text":"ǹ a kũ ↄplapla, ani bɛ̀ɛrɛ línnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Anigↄ̃ de fùra mana ũ n mìia,","poem":1},{"lineBreak":true},{"text":"anigↄ̃ dennɛ kífura gakuride ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ma nɛ́, ǹ sã kpá ma yãi,","poem":1},{"lineBreak":true},{"text":"ǹ yã pì da, n wɛ̃̀ndi nigↄ̃ gbã̀na.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma ↄ̃ndↄ̃ zɛ́ mↄ̀nnɛ,","poem":1},{"lineBreak":true},{"text":"ma n da yã mana zɛ́n.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó ntɛn táa on, pↄ́ke ni kpánnɛro,","poem":1},{"lineBreak":true},{"text":"tó ntɛn bàa lɛ́n, ĩni gɛ̃̀ síro.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ǹgↄ̃ ma lɛ́damma kũna, ǹsun gbarɛro,","poem":1},{"lineBreak":true},{"text":"ǹ a kũ gbãna, zaakũ àkũmɛ n wɛ̃̀ndi ũ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹsun yãvãnikɛrinↄ zɛ́ sɛ́ro,","poem":1},{"lineBreak":true},{"text":"ǹsun tɛ́ gbɛ̃ vãninↄ zɛ́iro.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ǹ pãńnɛ, ǹsun naḿmaro,","poem":1},{"lineBreak":true},{"text":"ǹ kɛ̃ḿma ǹ n gɛna kɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó odi vãni le ò kɛ̀ro, òdi i oro,","poem":1},{"lineBreak":true},{"text":"tó odi gbɛ̃ le ò kari boro, i dì gɛ̃ ń wɛ́nlo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Zaakũ vãnikɛnaamɛ ń pↄ́ble ũ,","poem":1},{"lineBreak":true},{"text":"wɛ́tãna gbɛ̃nↄaamɛ ń pↄ́mina ũ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gbɛ̃ mananↄ zɛ́ de lán gudↄnaa bàmɛ,","poem":1},{"lineBreak":true},{"text":"a gupura dìgↄ̃ bo lán ifãntɛ̃ bonaa bà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yãvãnikɛrinↄ zɛ́ de lán gusira níkiniki bàmɛ,","poem":1},{"lineBreak":true},{"text":"òdi pↄ́ kũ à tò òdi gɛ̃̀ sí dↄ̃ro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ma nɛ́, ǹ laakari dↄ yã pìnↄa,","poem":1},{"lineBreak":true},{"text":"ǹ sã kpá ma yã'onnɛnaaa.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ǹsun kpá sãkotoro,","poem":1},{"lineBreak":true},{"text":"ǹgↄ̃ kũna n swɛ̃̀ɛ gũn.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Zaakũ à de wɛ̃̀ndi ũ gbɛ̃ kũ à lè à kũnaanɛ,","poem":1},{"lineBreak":true},{"text":"à de mɛ̀ pínki aafia ũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A kũ à denla ǹ laakari dↄ n swɛ̃̀ yãa,","poem":1},{"lineBreak":true},{"text":"zaakũ wɛ̃̀ndi zĩni bò swɛ̃̀ kĩnaamɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ǹ bo yãvãni'onan,","poem":1},{"lineBreak":true},{"text":"ǹ mì kɛ̃ yãlɛkpɛrɛ'onaaa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ǹ wɛ́ dↄ n arɛ,","poem":1},{"lineBreak":true},{"text":"ǹ gu gwa n kuru súsu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ǹ zɛ́ sɛ́ súsu,","poem":1},{"lineBreak":true},{"text":"n yãkɛnanↄ pínki ni bo mana.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ǹsun na ↄplai ke ↄzɛiro,","poem":1},{"lineBreak":true},{"text":"ǹsun gbá pɛ́tɛ yã vãni zɛ́nlo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}