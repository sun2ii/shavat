zɛ́aro,","poem":1},{"lineBreak":true},{"text":"à dↄ̃ a zã zɛ́ pìiaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma nɛ́, ǹ sã kpá ma yãi sà,","poem":1},{"lineBreak":true},{"text":"ǹsun kpɛ li ma lɛ́dammanɛro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ pã nↄgbɛ̃ dí takanɛ zã̀zã,","poem":1},{"lineBreak":true},{"text":"ǹsun na a bɛ gãnulɛiro,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"de n bɛ̀ɛrɛ sún gↄ̃ gbɛ̃ pãndenↄnɛro,","poem":1},{"lineBreak":true},{"text":"de ǹsun n wɛ̃̀ndi kpá gbɛ̃ pãsĩnↄaro,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"de n aruzɛkɛnↄ sún gↄ̃ dakenↄnɛro,","poem":1},{"lineBreak":true},{"text":"de n zĩ àre sún gↄ̃ ↄn pãnde bedenↄnɛro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ĩnigↄ̃ nda n gↄrↄ lakanaaa,","poem":1},{"lineBreak":true},{"text":"ĩni fɛ̃fɛ̃ n gbãna ni láka.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ĩni pi: Ma gi lɛ́dammai fá!","poem":1},{"lineBreak":true},{"text":"Ma dↄkɛna kũ foruo mɛ́ à tò.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mádi arufannanↄ yã'onnɛna maro,","poem":1},{"lineBreak":true},{"text":"mádi sã kpá ma yãdannɛrinↄiro.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À gↄ̃̀ fíti kũ mà kpe bo","poem":1},{"lineBreak":true},{"text":"andunia dagura.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ǹ n zĩda orozã í mi,","poem":1},{"lineBreak":true},{"text":"ǹ zɛ kũ n zĩda lↄ̀gↄ'io.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N í kↄtɛna bàai manaro.","poem":1},{"lineBreak":true},{"text":"N í bona gãnulɛa zɛ́ vĩro.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ǹ tó àgↄ̃ de n nanↄ pↄ́ ũ ado,","poem":1},{"lineBreak":true},{"text":"àsungↄ̃ de gbɛ̃ pãnde pↄ́ ũro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Luda arubarika da n íboki pìn,","poem":1},{"lineBreak":true},{"text":"ǹ pↄnna kɛ kũ n kɛfɛnnakɛgↄrↄ nↄo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N gã yenyĩde! N bikyao mana!","poem":1},{"lineBreak":true},{"text":"Ǹ tó a bã̀ndaragana gↄ̃ kɛnnɛ nna,","poem":1},{"lineBreak":true},{"text":"ǹ a yenyĩ ni dɛ lákũ gu dìgↄ̃ dↄ nà.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma nɛ́, bↄ́yãin ĩni karua ni dɛɛ?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãin ĩni bã̀ndara gá kũ gbɛ̃ pãnde nↄoo?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bisãsiri yãkɛna ke utɛna Dikirinɛro,","poem":1},{"lineBreak":true},{"text":"àdigↄ̃ zɛ́ kũ à sɛ̀ dↄ̃ pínki.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yãvãnikɛri taari dì bà kpákpanɛ,","poem":1},{"lineBreak":true},{"text":"a durunna dì a kũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Lɛ́dammamanasari ni a kpá gai,","poem":1},{"lineBreak":true},{"text":"a yↄ̃nkↄkɛ zↄ̃kↄ̃ ni a sãtɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}