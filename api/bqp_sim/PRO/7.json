{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PRO","translationId":"bqp_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"43db1ce29ddacdbd2b699df058f8582757839afde1c3f66de758b6e995c36763","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqp_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":7,"content":[{"type":"heading","content":["Laakarikɛna karuaai"]},{"type":"verse","number":1,"content":["Ma nɛ́, ǹgↄ̃ ma yãnↄ kũna,",{"text":"ǹ ma yãditɛnanↄ da n nɛ̀sɛn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹgↄ̃ ma yãditɛnanↄ kũna ĩnigↄ̃ kun kũ wɛ̃̀ndiio,","poem":1},{"lineBreak":true},{"text":"ǹ laakari dↄ ma yãdannɛnaaa lán n wɛ́nɛ bà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ǹ da n ↄnɛa tãnka ũ,","poem":1},{"lineBreak":true},{"text":"ǹ kɛ̃ n swɛ̃̀ɛa lákũ òdi kɛ̃ anloa nà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ǹ o ↄ̃ndↄ̃nɛ n dãren a ũ,","poem":1},{"lineBreak":true},{"text":"ǹ asãnsi sísi n gbɛ̃ ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ani n sí bona karua ↄĩ,","poem":1},{"lineBreak":true},{"text":"ani n bo gbɛ̃ pãnde nↄ yãnnanna'onnɛnan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Má zɛna ma kpɛ́ wondoo gũn,","poem":1},{"lineBreak":true},{"text":"matɛn bàai gwa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Akũ ma gↄ̃ gbãna kenↄ è, ↄ̃ndↄ̃ kĩ̀aḿma,","poem":1},{"lineBreak":true},{"text":"kɛfɛnna ke kú ń tɛ́, à laasun vĩro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Àtɛn likara karua gãnulɛa,","poem":1},{"lineBreak":true},{"text":"àtɛn wakalokũ kɛkɛi a bɛ kpa","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"zaa ifãntɛ̃ lɛtɛnaao ari gwãani,","poem":1},{"lineBreak":true},{"text":"ari gu gɛ̀ɛ à sira kũ̀ manamana.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Akũ nↄgbɛ̃ pìi bò à sù daalɛ ↄ̃ndↄ̃'ↄ̃ndↄ̃,","poem":1},{"lineBreak":true},{"text":"àtɛn ↄ má a zĩdaa lán karuaa bà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kùgbãnademɛ, à wé'isari vĩ,","poem":1},{"lineBreak":true},{"text":"a pↄ̀rↄ dì pɛ́tɛ bɛro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zĩkenↄa àdigↄ̃ kú zɛ́dan, zĩkenↄa gãnulɛa,","poem":1},{"lineBreak":true},{"text":"àdigↄ̃ kpátɛ kɛ zɛ́rankpakↄ̃a.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Akũ à kɛfɛnna pìi kũ̀ à lɛ́ pɛ̀a,","poem":1},{"lineBreak":true},{"text":"à wɛ́kpãntɛ̃ màtɛi à pì:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sáabukpa sa'ona kúma yã,","poem":1},{"lineBreak":true},{"text":"akũ ma lɛ́ kũ ma gbɛ̃̀ɛ pì fĩnaa bò gbãra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ó kↄ̃'ena yãin ma boi,","poem":1},{"lineBreak":true},{"text":"matɛni n wɛtɛ ma n e la sↄ̃.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma bↄrↄgↄ kpàtɛ ma gádoa","poem":1},{"lineBreak":true},{"text":"kũ Misila bùsu biza wɛ́ manao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma turare'i fã̀kɛ ma wútɛkia","poem":1},{"lineBreak":true},{"text":"kũ ò kɛ̀ kũ lí'ↄ gbĩ nnao kũ lítɛkɛɛo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ǹ mↄ́ ò yenyĩ kɛ ari gu gɛ́ dↄo,","poem":1},{"lineBreak":true},{"text":"ò ó pↄyeina kɛ ari à mↄ́wá.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Zaakũ ma zã kú bɛro,","poem":1},{"lineBreak":true},{"text":"wɛ̃tɛ kũ à gɛ̀ɛn zã̀.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"À ↄgↄsↄ̃nↄↄ yĩ̀ à gɛ̀ɛo,","poem":1},{"lineBreak":true},{"text":"ari àgↄ̃ gɛ́ su mↄ ni kɛ papana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"À a swɛ̃̀ɛ blè kũ yã dasi fãnaao,","poem":1},{"lineBreak":true},{"text":"à gã nàa kũ yãnnanna'onaao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Akũ kɛfɛnna pìi bò à tɛ̀i gↄ̃̀nↄ,","poem":1},{"lineBreak":true},{"text":"lán zù kũ òtɛn gɛ́ a kùtu kpá bà,","poem":1},{"lineBreak":true},{"text":"lán gã kũ àtɛn gbá pɛ́tɛ goron bà,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"lán bã kũ àtɛn wã à sì gbɛ̀saan bà.","poem":1},{"lineBreak":true},{"text":"Adi dↄ̃ kũ a a zĩda kpà gairo,","poem":1},{"lineBreak":true},{"text":"ari kàa gɛ̀ɛ à a swɛ̃̀ɛ kũ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Tera sà, ma nɛ́nↄ, à ma yã ma,","poem":1},{"lineBreak":true},{"text":"à laakari dↄ yã kũ àtɛn bo ma lɛ́nwa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Àsun tó á laasun tá a kĩnaaro,","poem":1},{"lineBreak":true},{"text":"àsun sãtɛ à gɛ̃ a zɛ́nlo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kũ à ń nɛ́ à ń kakatɛnↄn dasi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ à ń dɛdɛ pìnↄ lɛ́ vĩro.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"A bɛ bi mira zɛ́damɛ,","poem":1},{"lineBreak":true},{"text":"àdi gɛ̃ kũńwo gyãwãn kpɛ́nɛn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}