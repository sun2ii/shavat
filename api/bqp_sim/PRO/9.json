{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PRO","translationId":"bqp_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"43db1ce29ddacdbd2b699df058f8582757839afde1c3f66de758b6e995c36763","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bqp_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":9,"content":[{"type":"heading","content":["Ɔ̃ndↄ̃ kũ yↄ̃nkↄkɛo"]},{"type":"verse","number":1,"content":["Ɔ̃ndↄ̃ a kpɛ́ bò,",{"text":"à a gbɛ̀gbanↄ à mɛ̀n suppla à pɛ̀tɛpɛtɛ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"à nↄ̀bↄↄ dɛ̀ à sèwɛ̃ bà,","poem":1},{"lineBreak":true},{"text":"à pↄ́blenↄ soru kɛ̀ à kàtɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À a nↄkpare zĩkɛrinↄ zĩ̀,","poem":1},{"lineBreak":true},{"text":"àtɛn lɛ́ zu wɛ̃tɛ sĩ̀sĩ mìsↄ̃ntɛa à pì:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ákↄ̃nↄ fayasaridenↄ à ɛra à mↄ́ la!","poem":1},{"lineBreak":true},{"text":"Àkↄ̃nↄ laasunsaridenↄ matɛn oárɛ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"à mↄ́ à ma pↄ́ble ble,","poem":1},{"lineBreak":true},{"text":"à wɛ̃ kũ ma bà mi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À á yↄ̃nkↄkɛ tó, anigↄ̃ kun wɛ̃̀ndiio,","poem":1},{"lineBreak":true},{"text":"à táa o wɛ̃kɛ̃na zɛ́n.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gbɛ̃ kũ àtɛn lalandide da zɛ́a tɛn sↄ̃sↄ̃ wɛtɛmɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ àtɛn kpãkɛ̃ yãvãnikɛriii tɛn taari wɛtɛ a zĩdanɛmɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹsun kpãkɛ̃ lalandideiro, ani kɛ kũnwo ĩni,","poem":1},{"lineBreak":true},{"text":"ǹ ↄ̃ndↄ̃de da zɛ́a, anigↄ̃ yenyĩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ yã da ↄ̃ndↄ̃denɛ, a ↄ̃ndↄ̃ nigↄ̃ din,","poem":1},{"lineBreak":true},{"text":"ǹ yã o gbɛ̃ mananɛ, a dↄ̃na ni kara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vĩnakɛna Dikirinɛɛmɛ ↄ̃ndↄ̃ naana ũ,","poem":1},{"lineBreak":true},{"text":"Luda kũ à kú adona dↄ̃naamɛ wɛ́kɛ̃na zɛ́ ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zaakũ ĩni gì kɛ ma gãi,","poem":1},{"lineBreak":true},{"text":"n wɛ̃̀ndi gbã̀na ni kara.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó ń ↄ̃ndↄ̃, n zĩdanɛmɛ,","poem":1},{"lineBreak":true},{"text":"tó lalandidemɛ n ũ, n mìi musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yↄ̃nkↄkɛ de lán nↄgbɛ̃ lɛ́de bàmɛ,","poem":1},{"lineBreak":true},{"text":"à ↄ̃ndↄ̃ vĩro akũsↄ̃ à yãke dↄ̃ro.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Àdi vutɛ gbàaa a kpɛ́lɛlɛa,","poem":1},{"lineBreak":true},{"text":"a kpɛ́ kú wɛ̃tɛ sĩ̀sĩia,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"àtɛn lɛ́ zu gbɛ̃ kũ òtɛn gɛ̃tɛnↄi,","poem":1},{"lineBreak":true},{"text":"àtɛn pi gbɛ̃ kũ ò tɛ́ zɛ́n súsunↄnɛ:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ákↄ̃nↄ fayasaridenↄ à ɛra à mↄ́ la!","poem":1},{"lineBreak":true},{"text":"Ákↄ̃nↄ laasunsaridenↄ, matɛn oárɛ,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"í kpãni minaa dìgↄ̃ nna,","poem":1},{"lineBreak":true},{"text":"pↄ́blenaa asiri gũn bi zↄ́mɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gbɛ̃ pìnↄn dↄ̃ kũ abire bi gyãwãn zɛ́nlo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ yↄ̃nkↄkɛ ń sisinↄ sì gyãwãn tↄ̃̀nↄwɛɛn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}