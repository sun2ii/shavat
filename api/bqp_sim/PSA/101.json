{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":101,"content":[{"type":"heading","content":["Kína lɛ́sɛna Ludanɛ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Mani lɛ̀ da gbɛ̃kɛ kũ yãzɛdeoo musu,","poem":1},{"lineBreak":true},{"text":"mani lɛ̀ sínnɛ, Dikiri.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mani laakari kɛ màgↄ̃ kun taari sari,","poem":1},{"lineBreak":true},{"text":"bↄrɛn ĩni sumaa?","poem":1},{"lineBreak":true},{"text":"Manigↄ̃ kú ma ↄnn kũ nɛ̀sɛpurao.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma wɛ́ nigↄ̃ kú pↄ́ ginaaaro,","poem":1},{"lineBreak":true},{"text":"mani zã yãdↄrↄsarikɛnan, ani namaro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma nɛ̀sɛ nigↄ̃ manafiki vĩro,","poem":1},{"lineBreak":true},{"text":"ma bàka nigↄ̃ kú kũ yã vãnioro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mani gbɛ̃ kũ àdi a gbɛ̃dake yaka a kpɛ kakatɛ,","poem":1},{"lineBreak":true},{"text":"mani sùru fↄ̃ kũ karambaanidenↄ kũ zĩdabirinↄoro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma wɛ́ nigↄ̃ kú ma bùsu náanidenↄa,","poem":1},{"lineBreak":true},{"text":"de ògↄ̃ kú kũmao,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ àdigↄ̃ kú taari sari nigↄ̃ de ma zĩkɛri ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mani we gbɛ̃sãtɛri gↄ̃ kú ma bɛaro,","poem":1},{"lineBreak":true},{"text":"mani tó manafikide zɛ ma arɛro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Manigↄ̃ ma bùsu gbɛ̃ vãninↄ láka lákũ gu dìgↄ̃ dↄ nà,","poem":1},{"lineBreak":true},{"text":"manigↄ̃ yãvãnikɛrinↄ buri bo Dikiri wɛ̃tɛ gũn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}