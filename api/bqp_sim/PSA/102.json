{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":102,"content":[{"type":"heading","content":["Gbãnasaride aduakɛnaa"]},{"type":"hebrew_subtitle","content":["Wɛ̃ndade gbãnasaride kũ àtɛni a yã'ũmmananↄ bↄtɛ Dikirinɛɛ aduakɛnaa."]},{"type":"verse","number":1,"content":[{"text":"Dikiri, ǹ ma aduakɛna ma,","poem":1},{"lineBreak":true},{"text":"ǹ tó ma wiki n ki le.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹsun wɛ́ utɛmɛnɛ ma warikɛgↄrↄaro,","poem":1},{"lineBreak":true},{"text":"ǹ sã kpámai,","poem":1},{"lineBreak":true},{"text":"tó ma n sisi, ǹ wema likalika.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zaakũ ma gↄrↄ tɛn gɛ̃tɛ lán túsukpɛ bà,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀ tɛn puusu bo lán tɛ́yↄ̃ↄ bà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma nɛ̀sɛɛ yàka, ma gↄ̃ lán sɛ̃̀ kori bà,","poem":1},{"lineBreak":true},{"text":"ma sã pↄ́bleyãn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma ndana gbãna mɛ́ à tò","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ wàakuu ũ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma gↄ̃ lán gbáranna tiongo bà,","poem":1},{"lineBreak":true},{"text":"lán bɛzĩ kóro bà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I dì gɛ̃ ma wɛ́nlo,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ lán bã kũ à di kpɛ́ musu ado bà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma ibɛrɛnↄ dìgↄ̃ ma sↄ̃sↄ̃ gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"ma foborinↄ dì gbɛ̃ ká kũ ma tↄ́o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Túbumɛ ma pↄ́blee ũ,","poem":1},{"lineBreak":true},{"text":"ma wɛ́'i dì ká ma ímibↄn","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"n pↄfɛ̃ kũ n pɛ̃tɛ̃o yãi,","poem":1},{"lineBreak":true},{"text":"zaakũ n ma sɛ n ma zukũna.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma gↄrↄ tɛn gɛ̃tɛ lán uraa bà,","poem":1},{"lineBreak":true},{"text":"akũ matɛn kori kɛ lán sɛ̃̀ɛ bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mↄkↄ̃n sↄ̃ Dikiri,","poem":1},{"lineBreak":true},{"text":"ndìgↄ̃ kú kpatan gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"n tↄ́ ni garo ari ó buria.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ĩni futɛ ǹ Zaiↄ̃ wɛ̃nda gwa, zaakũ gↄrↄ kà,","poem":1},{"lineBreak":true},{"text":"gↄrↄ kũ n dìtɛ kà, kũ ĩni a pↄnna wɛtɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A gbɛ̀nↄ kɛ̀ n zↄ̀blerinↄnɛ mana,","poem":1},{"lineBreak":true},{"text":"a gborona bùsuu dì kɛńnɛ wɛ̃nda.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Buri sĩnda pínki ni vĩna kɛnnɛ, Dikiri,","poem":1},{"lineBreak":true},{"text":"andunia kínanↄ ni n kíkɛ dↄ̃ ń pínki.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Zaakũ Dikiri ni Zaiↄ̃ kɛkɛ à bo dↄ,","poem":1},{"lineBreak":true},{"text":"ani bo à suḿma kũ gakurio.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ani takasidenↄ aduakɛna sí,","poem":1},{"lineBreak":true},{"text":"ani ń wɛ́kɛna kpá sãkotoro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ò yã dí kɛ̃ kpɛdenↄ yãi","poem":1},{"lineBreak":true},{"text":"de gbɛ̃ kũ ò kpɛ́nↄ Dikiri táaki lɛ́.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dikiri zĩtɛ gwà zaa a kúkia,","poem":1},{"lineBreak":true},{"text":"zaa musu à wɛ́ kpàtɛ zĩtɛ,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"de à gbɛ̃nↄ zↄ̀ble ↄ́ↄ dↄ ma","poem":1},{"lineBreak":true},{"text":"à ń bo ga lɛ́i yãi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Oni Dikiri tↄ́ bo Zaiↄ̃,","poem":1},{"lineBreak":true},{"text":"oni a táaki lɛ́ Yurusalɛmu,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"zĩ kũ bùsu sĩnda pínki gbɛ̃nↄ ni kↄ̃ kakara gwe,","poem":1},{"lineBreak":true},{"text":"kũ kpatablerinↄ ò donyĩ kɛnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"À ma gbãna bùsa zɛ́gbãn,","poem":1},{"lineBreak":true},{"text":"à ma wɛ̃̀ndi kɛ̀ kutu,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"akũ ma pì: Ma Luda,","poem":1},{"lineBreak":true},{"text":"ǹsun ma wɛ̃̀ndi bo gugbãnlo,","poem":1},{"lineBreak":true},{"text":"mↄkↄ̃n kũ ń kun ari ó buria.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"N andunia zĩni pɛ̀tɛ zaa káaku,","poem":1},{"lineBreak":true},{"text":"musu bi n ↄzĩmɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ń pínki ni gɛ̃tɛ, ama ĩnigↄ̃ kun,","poem":1},{"lineBreak":true},{"text":"oni zĩ kũ lán pↄ́kasa bà,","poem":1},{"lineBreak":true},{"text":"ĩni ń litɛ lán uta bà ǹ ń zukũna.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mↄkↄ̃n sↄ̃ n kunnaa dìgↄ̃ dokↄ̃nↄ,","poem":1},{"lineBreak":true},{"text":"n gↄrↄ lakana vĩro.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"N zↄ̀blerinↄ nɛ́nↄ nigↄ̃ kun aafia,","poem":1},{"lineBreak":true},{"text":"ń burinↄ ni zĩni pɛ́tɛ n kuru.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}