{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":108,"content":[{"type":"heading","content":["Luda mɛ́ àdi tó ò zĩ̀ ble"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Ma laakari kpatɛna, Luda,","poem":1},{"lineBreak":true},{"text":"mani lɛ̀ sí mà n táaki lɛ́ kũ nɛ̀sɛdoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma mↄrↄ kũ ma gidigboo kú máa?","poem":1},{"lineBreak":true},{"text":"Mani gudↄ pá mìio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dikiri, mani n sáabu kpá burinↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"mani n táaki lɛ́ gbɛ̃nↄnɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zaakũ n gbɛ̃kɛ zↄ̃kↄ̃ↄ kà n kĩnaa,","poem":1},{"lineBreak":true},{"text":"n náanikɛnaa ludambɛ luku lè.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Luda, ò n tↄ́ sɛ́ lei ari n kukia,","poem":1},{"lineBreak":true},{"text":"ǹ tó n gakuri da anduniala pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ǹ wewá ǹ ó sura ba kũ n gã̀sã gbãnao,","poem":1},{"lineBreak":true},{"text":"de ókↄ̃nↄ n gbɛ̃ yenyĩdenↄ le ò bo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Luda yã ò zaa a kúkia à pì:","poem":1},{"lineBreak":true},{"text":"Mani Sɛkɛmu kpaatɛtɛ kũ kùwikio,","poem":1},{"lineBreak":true},{"text":"mani Suko guvutɛ kpáḿma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Giliada bùsu bi ma pↄ́mɛ,","poem":1},{"lineBreak":true},{"text":"Manase burinↄ bùsu bi ma pↄ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛflaimu burinↄ bùsu bi ma mↄ̀furaamɛ,","poem":1},{"lineBreak":true},{"text":"Yuda bùsu bi ma gòomɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mↄabunↄ bùsu bi ma ↄpipibↄↄmɛ,","poem":1},{"lineBreak":true},{"text":"madì ma kyate kátɛ Ɛdↄmunↄ bùsuua,","poem":1},{"lineBreak":true},{"text":"madì kùwiki dↄ Filisitininↄ bùsuua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dí mɛ́ ani gɛ̃ kũmao wɛ̃tɛ bĩnide gũnn?","poem":1},{"lineBreak":true},{"text":"Dí mɛ́ ani domɛnɛ arɛ ari Ɛdↄmunↄ bùsunn?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Luda, à de mↄkↄ̃n mɛ́ n ↄ gbàrɛwái,","poem":1},{"lineBreak":true},{"text":"ndì bo kũ ó zĩ̀karinↄ doroo?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹ ↄ dawá ó ibɛrɛnↄ yãi,","poem":1},{"lineBreak":true},{"text":"zaakũ bisãsiri kpányĩ bi yã pãmɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Óni zĩ̀ ble kũ Luda gbãnao,","poem":1},{"lineBreak":true},{"text":"àkũ mɛ́ ani gɛ̀sɛ pɛ́tɛpɛtɛ ó ibɛrɛnↄa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}