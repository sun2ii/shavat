{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":109,"content":[{"type":"heading","content":["Sa vãni ona ibɛrɛɛnɛ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Luda, mↄkↄ̃nn madì n táaki lɛ́,","poem":1},{"lineBreak":true},{"text":"ǹsungↄ̃ yĩtɛnaro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zaakũ gbɛ̃ vãni bonkpɛdenↄ dì ma yaka,","poem":1},{"lineBreak":true},{"text":"òdi lɛ́ bo ò ɛ́kɛyã dima.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Òdi likamai kũ zãnguyão,","poem":1},{"lineBreak":true},{"text":"òdi fìti kɛ kũmao pↄ́ke wíwinnɛnaa sari.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Òdi yenyĩ ɛramɛnɛ kũ yãdimmanaao,","poem":1},{"lineBreak":true},{"text":"bee kũ madì adua kɛńnɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Òdi yã mana fĩna bomɛnɛ kũ a vãnio,","poem":1},{"lineBreak":true},{"text":"yenyĩ sↄ̃, kũ zãnguo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ǹ Setan sùu kɛa,","poem":1},{"lineBreak":true},{"text":"ǹ a kpakũ kũ Ibilisio.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ tó yãkpatɛ a nɛ,","poem":1},{"lineBreak":true},{"text":"ǹ tó a aduakɛna yã inɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A wɛ̃̀ndi gↄ̃ kutu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ pãnde gↄ̃ a gɛ̃nɛ ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ tó a nɛ́nↄ gↄ̃ de sari,","poem":1},{"lineBreak":true},{"text":"a nanↄ gↄ̃ gyaanↄ ũ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A nɛ́nↄ gↄ̃ likarazↄ̃rinↄ ũ ògↄ̃ bara kɛ,","poem":1},{"lineBreak":true},{"text":"ògↄ̃ ń kpakɛ ń bɛ zĩinↄ gũn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A fĩnade a pↄ́nↄ nakↄ̃a pínki,","poem":1},{"lineBreak":true},{"text":"buri zĩ̀tↄnↄ a zĩ àre sía.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃ke sún gbɛ̃kɛ kɛnɛro,","poem":1},{"lineBreak":true},{"text":"òsun wɛ̃nda dↄ̃ a nɛ́ kũ à tònↄnɛro.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ǹ tó a burinↄ láka,","poem":1},{"lineBreak":true},{"text":"ń tↄ́ súngↄ̃ kú buri kũ oni futɛnↄ tɛ́ro.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A dizinↄ vãnikɛna yã gↄ̃ dↄngu, Dikiri,","poem":1},{"lineBreak":true},{"text":"ǹsun tó a da durunna kɛ̃a zikiro.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ń durunna gↄ̃ dↄngu, Dikiri,","poem":1},{"lineBreak":true},{"text":"ń yã sã gbɛ̃nↄgu andunia gũn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Zaakũ adi dↄn à gbɛ̃kɛ kɛ gbɛ̃kenɛro,","poem":1},{"lineBreak":true},{"text":"àdi wɛ́ tã takasidenↄa kũ wɛ̃ndadenↄ","poem":1},{"lineBreak":true},{"text":"kũ pↄsiradenↄo ari gyãwãn.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"À ye sa vãni onnɛnaai,","poem":1},{"lineBreak":true},{"text":"ǹ tó à wí a musu.","poem":1},{"lineBreak":true},{"text":"Sa mana onnɛnaa dì kánɛro,","poem":1},{"lineBreak":true},{"text":"ǹ tó arubarika kɛ kãao zã̀.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"À lɛ́kɛnnɛnaa dà lán uta bà,","poem":1},{"lineBreak":true},{"text":"à a mɛ̀ɛ yàku lán í bà,","poem":1},{"lineBreak":true},{"text":"à gɛ̃̀ a wánↄn lán nísi bà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kanaa pì gↄ̃ daala lán uta bà,","poem":1},{"lineBreak":true},{"text":"àgↄ̃ dↄ a pi lán asa bà.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dikiri fĩna bo ma yãdimmarinↄa lɛ","poem":1},{"lineBreak":true},{"text":"kũ gbɛ̃ kũ òdi yã vãni o ma musunↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dikiri Gbãnasĩndapinkide,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ̃nda gwa n tↄ́ yãi,","poem":1},{"lineBreak":true},{"text":"ǹ ma bo n manakɛ kũ n gbɛ̃kɛo yãi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Zaakũ takaside wɛ̃ndademɛ ma ũ,","poem":1},{"lineBreak":true},{"text":"ma pↄ yàka búgubugu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Matɛn gɛ̃tɛ lán ↄkↄsi uraa bà,","poem":1},{"lineBreak":true},{"text":"má de lán kwa kũ ĩa tɛn sɛ́ bà.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Lɛ́yĩnaa tò ma gbá dì sí sɛ́ doro,","poem":1},{"lineBreak":true},{"text":"ma fɛ̃fɛ̃ ma gↄ̃ wàakuu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ma gↄ̃ yáadↄnapↄ ũ ma yãdimmarinↄnɛ,","poem":1},{"lineBreak":true},{"text":"òdi ma gwa ò mì gbãkɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ǹ kpámai, Dikiri ma Luda,","poem":1},{"lineBreak":true},{"text":"ǹ ma sura ba n gbɛ̃kɛ yãi,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"de ò dↄ̃ kũ n ↄ mɛ́ à kɛ̀,","poem":1},{"lineBreak":true},{"text":"mↄkↄ̃n Dikiri, n kɛnaamɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Bee tó ò ma ka, ĩni arubarika damagu,","poem":1},{"lineBreak":true},{"text":"tó ò fùtɛmai, wé'i ni ń kũ,","poem":1},{"lineBreak":true},{"text":"makũ n zↄ̀bleri mani pↄnna kɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tↄ́ vãni ni gↄ̃ ma yãdimmarinↄnɛ uta ũ,","poem":1},{"lineBreak":true},{"text":"oni wé'i daḿma lán arukĩmbaa bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Mani Dikiri sáabu kpá kũ kòto gbãnao,","poem":1},{"lineBreak":true},{"text":"mani a táaki lɛ́ dasi kↄ̃kakaranaa gũn.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Zaakũ àdi zɛ kũ wɛ̃ndadenↄ,","poem":1},{"lineBreak":true},{"text":"àdi ń sí gbɛ̃ kũ òdi yã vútɛḿmanↄa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}