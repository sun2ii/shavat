{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":11,"content":[{"type":"heading","content":["Laakarikpatɛnaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Ma na Dikirii.","poem":1},{"lineBreak":true},{"text":"Bↄ́ yã mɛ́ à tò átɛn pimɛnɛ mà vura","poem":1},{"lineBreak":true},{"text":"mà tá kpi musu lán bã bàa?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À yãvãnikɛrinↄ gwa, ò kàa kpà sála,","poem":1},{"lineBreak":true},{"text":"ò nàtɛ gusarɛ ò ń sá gà,","poem":1},{"lineBreak":true},{"text":"ò kàa dↄ̀dↄ nɛ̀sɛmanadenↄa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tó futɛokarayã tɛn kakatɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ mananↄ ni kɛ deramɛɛ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dikiri kú a kpɛ́ kũ à kú adonaa gũn,","poem":1},{"lineBreak":true},{"text":"à vutɛna kpatan musu gwe.","poem":1},{"lineBreak":true},{"text":"Àdi wɛ́ pɛ́ bisãsirinↄla à ń tàasi ká.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dikiri dì gbɛ̃ mananↄ gwagwa,","poem":1},{"lineBreak":true},{"text":"ama à zã̀ yãvãnikɛrinↄgu","poem":1},{"lineBreak":true},{"text":"kũ gbɛ̃ kũ yã pãsĩ dì kɛńnɛ nnanↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ani tɛ́yↄ̃ kũ ifãntɛ̃gbↄ̃ↄo kú yãvãnikɛrinↄa,","poem":1},{"lineBreak":true},{"text":"ĩa wãna mɛ́ anigↄ̃ de ń baka ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zaakũ Dikiri dì yã kɛ a zɛ́a,","poem":1},{"lineBreak":true},{"text":"yãmanakɛnaa dì kɛnɛ nna,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ mananↄ ni wɛ́ kɛ kãao pla.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}