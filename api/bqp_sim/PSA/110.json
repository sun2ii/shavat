{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":110,"content":[{"type":"heading","content":["Arumasihu kíkɛ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri pì ma dikiriinɛ à vutɛ a ↄplai","poem":1},{"lineBreak":true},{"text":"ari àgↄ̃ a ibɛrɛnↄ kɛnɛ a tìntin ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dikiri ni tó n iko dagula,","poem":1},{"lineBreak":true},{"text":"ĩni kí ble n ibɛrɛnↄa zaa Zaiↄ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N gbɛ̃nↄ ni ń zĩda kpámma zĩ̀kagↄrↄ","poem":1},{"lineBreak":true},{"text":"kpi kũ à kú adona musu,","poem":1},{"lineBreak":true},{"text":"n kɛfɛnnanↄ ni su n kĩnaa lán gudↄ plíkpanaa bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dikiri la dà, ani lɛ́ sukparo à pì:","poem":1},{"lineBreak":true},{"text":"Ĩnigↄ̃ de sa'ori ũ ari gↄrↄ sĩnda pínki","poem":1},{"lineBreak":true},{"text":"lán Mɛlɛkizɛdɛki bàmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dikiri kú n ↄplai,","poem":1},{"lineBreak":true},{"text":"ani kínanↄ dúgu zↄ̃ a pↄfɛ̃gↄrↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ani yãkpatɛ kɛ kũ burinↄo,","poem":1},{"lineBreak":true},{"text":"ń gɛ̀nↄ nigↄ̃ kpá,","poem":1},{"lineBreak":true},{"text":"ani andunia pínki kínanↄ dúgu zↄ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ani í mi swai zɛ́ lɛ́a,","poem":1},{"lineBreak":true},{"text":"abire yãin a mì nigↄ̃ dana íla.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}