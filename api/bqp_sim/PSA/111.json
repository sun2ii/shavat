{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":111,"content":[{"type":"heading","content":["Dikiri tↄ́bonaa"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Mani Dikiri sáabu kpá kũ nɛ̀sɛdoo","poem":1},{"lineBreak":true},{"text":"gbɛ̃ mananↄ kↄ̃kakaranaa gũn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dikiri yãkɛnanↄn zↄ̃kↄ̃,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ a yã kɛ̀ńnɛ nnanↄ dì a laasun lɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A yãkɛnanↄn bɛ̀ɛrɛ vĩ kũ gakurio,","poem":1},{"lineBreak":true},{"text":"a yãmanakɛna lakana vĩro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dikiri tò a yãbonsarɛkɛnanↄ dↄ̀ógu,","poem":1},{"lineBreak":true},{"text":"à sùru vĩ kũ wɛ̃ndao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Àdi pↄ́ble kpá a vĩnakɛrinↄa,","poem":1},{"lineBreak":true},{"text":"àdigↄ̃ dↄ a bàka kunna kũńwo yãn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À a yãkɛnanↄ gbãna mↄ̀ a gbɛ̃nↄnɛ,","poem":1},{"lineBreak":true},{"text":"à buri pãndenↄ bùsunↄ sì à kpàḿma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A yãkɛnanↄn náani vĩ akũsↄ̃ à zɛ́ vĩ,","poem":1},{"lineBreak":true},{"text":"a yãdannɛnanↄn yãpura vĩ pínki.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yã pìnↄ zĩni pɛtɛna gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"àdi yã kɛ a zɛ́a kũ náanio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À surabarii zĩ̀ à a gbɛ̃nↄ bò,","poem":1},{"lineBreak":true},{"text":"a bàka kú kũńwo gↄrↄ sĩnda pínki.","poem":1},{"lineBreak":true},{"text":"A tↄ́ kú adona, à naasi vĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vĩnakɛna Dikirinɛɛmɛ ↄ̃ndↄ̃ zĩni ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ ò a vĩna vĩnↄmɛ asãnsĩnidenↄ ũ.","poem":1},{"lineBreak":true},{"text":"A táakilɛna nigↄ̃ lakana vĩro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}