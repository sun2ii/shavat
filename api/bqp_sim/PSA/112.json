ext":"akusↄ̃ àdi yã kɛ a zɛ́a, yã dì bo kãao nna.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pↄ́ke ni gbɛ̃ mana lá ble zikiro,","poem":1},{"lineBreak":true},{"text":"a yã nigↄ̃ dↄńgu gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Baaru vãni dì a vĩna kũro,","poem":1},{"lineBreak":true},{"text":"a laakarii dìgↄ̃ kpatɛna, àdigↄ̃ Dikiri náani vĩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A kùu dì vĩro, vĩna dì a kũro","poem":1},{"lineBreak":true},{"text":"ari à gɛ́ à yↄ̃̀gↄ̃ kɛ a ibɛrɛnↄa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Àdi pↄ́ fã takasidenↄnɛ,","poem":1},{"lineBreak":true},{"text":"a yãmanakɛna lakana vĩro,","poem":1},{"lineBreak":true},{"text":"a gbãna dìgↄ̃ kara kũ bɛ̀ɛrɛɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gbɛ̃ vãni dì a e à pↄ fɛ̃,","poem":1},{"lineBreak":true},{"text":"àdi saka kakũn à nagui,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ vãni pↄyeinaa dì kɛ pã.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}