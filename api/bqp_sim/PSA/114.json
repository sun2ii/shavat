{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":114,"content":[{"type":"heading","content":["Vĩnla dikpɛ lɛ̀ɛ"]},{"type":"verse","number":1,"content":[{"text":"Kũ Isarailanↄ bò Misila,","poem":1},{"lineBreak":true},{"text":"kũ Yakubu burinↄ bò gbɛ̃ zĩ̀tↄnↄ tɛ́,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yudanↄ bùsuu gↄ̃̀ Dikiri kúki ũ,","poem":1},{"lineBreak":true},{"text":"Isarailanↄ bùsuu gↄ̃̀ a kíbleki ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Isira Tɛ̃ra wɛ́ sìńlɛ à bàa lɛ̀,","poem":1},{"lineBreak":true},{"text":"Yoda í ɛ̀ra kpɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kpinↄ vĩ̀vĩ lán sãkaronↄ bà,","poem":1},{"lineBreak":true},{"text":"sĩ̀sĩnↄ kↄrↄ lɛ̀ lán sãnɛnↄ bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ísira, bↄ́ mɛ́ à n le n bàa lɛ̀ɛ?","poem":1},{"lineBreak":true},{"text":"Yoda, à kɛ̀ dera n ɛ̀ra kpɛɛ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kpinↄ, bↄ́yãin a vĩvĩ lán sãkaronↄ bàa?","poem":1},{"lineBreak":true},{"text":"Sĩ̀sĩnↄ, à kɛ̀ dera a kↄrↄ lɛ̀ lán sãnɛnↄ bàa?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Andunia, ǹ yĩgãyĩgã Dikiri arɛ,","poem":1},{"lineBreak":true},{"text":"Yakubu Luda arɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À gbɛ̀si kɛ̀ íkatɛki ũ,","poem":1},{"lineBreak":true},{"text":"à gbɛ̀pu lì ísɛ̃boki ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}