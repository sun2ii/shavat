}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ò sã vĩ, ama òdi yã maro,","poem":1},{"lineBreak":true},{"text":"ò yĩ vĩ, ama òdi pↄ́ gbĩ maro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ò ↄ vĩ, ama òdi pↄ́ kũro,","poem":1},{"lineBreak":true},{"text":"ò gbá vĩ, ama òdi táa oro,","poem":1},{"lineBreak":true},{"text":"òdi kòto kɛkɛro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ń pìrinↄn lɛɛlɛ kũńwomɛ","poem":1},{"lineBreak":true},{"text":"kũ gbɛ̃ kũ òtɛni ń náani kɛnↄ ń pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Isarailanↄ, à Dikiri náani kɛ!","poem":1},{"lineBreak":true},{"text":"Àkũmɛ á kpanyĩri ũ kũ á sɛ̃gbakoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Haruna burinↄ, à Dikiri náani kɛ!","poem":1},{"lineBreak":true},{"text":"Àkũmɛ á kpanyĩri ũ kũ á sɛ̃gbakoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dikiri vĩnakɛrinↄ, à Dikiri náani kɛ!","poem":1},{"lineBreak":true},{"text":"Àkũmɛ á kpanyĩri ũ kũ á sɛ̃gbakoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dikiri dↄ̀ ó yãn,","poem":1},{"lineBreak":true},{"text":"ani arubarika daógu.","poem":1},{"lineBreak":true},{"text":"Ani arubarika da Isaraila burinↄgu,","poem":1},{"lineBreak":true},{"text":"ani arubarika da Haruna burinↄgu,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ani arubarika da a vĩnakɛrinↄgu,","poem":1},{"lineBreak":true},{"text":"nɛ́ fíti gbɛ̃ zↄ̃kↄ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dikiri á buri kara,","poem":1},{"lineBreak":true},{"text":"ákↄ̃nↄ kũ á nɛ́nↄ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dikiri arubarika daágu,","poem":1},{"lineBreak":true},{"text":"musu kũ zĩtɛo Kɛ̀rii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Musu bi Dikiri pↄ́mɛ,","poem":1},{"lineBreak":true},{"text":"ama à zĩtɛ nà bisãsirinↄnɛ ń ↄĩ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Adi kɛ gɛ̀nↄ mɛ́ òdi Dikiri táaki lɛ́ro,","poem":1},{"lineBreak":true},{"text":"kesↄ̃ gbɛ̃ kũ ń lɛ́ yĩtɛnↄ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ókↄ̃nↄ, ónigↄ̃ Dikiri sáabu kpá","poem":1},{"lineBreak":true},{"text":"zaa tera ari gↄrↄ sĩnda pínki.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}