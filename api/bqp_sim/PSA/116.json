{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":116,"content":[{"type":"heading","content":["Gbɛ̃ kũ à bò ga lɛ́i Dikiri sáabukpanaa"]},{"type":"verse","number":1,"content":[{"text":"Má ye Dikirii, zaakũ à ma yã mà,","poem":1},{"lineBreak":true},{"text":"à ma wikilɛnaawa mà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Manigↄ̃ a sísi ari ma wɛ̃̀ndi lɛ́n,","poem":1},{"lineBreak":true},{"text":"kũ à sã kpàmai yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ga bàa fĩ̀kãmai yã,","poem":1},{"lineBreak":true},{"text":"mira wãwã tↄ̃̀ma,","poem":1},{"lineBreak":true},{"text":"wɛ́tãmmana kũ pↄsirao dàmala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Akũ ma Dikiri sìsi ma pì:","poem":1},{"lineBreak":true},{"text":"Dikiri, n yã nna, ǹ ma mì sí.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dikirin sùru vĩ akũsↄ̃ à mana,","poem":1},{"lineBreak":true},{"text":"ó Luda wɛ̃nda vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dikiri dì gbãnasaridenↄ dãkpã,","poem":1},{"lineBreak":true},{"text":"kũ ma busa, à ma sura bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma swɛ̃̀, ǹ kɛkɛ ǹ kpátɛ,","poem":1},{"lineBreak":true},{"text":"zaakũ Dikiri yã mana kɛ̀nnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dikiri, n ma bo ga lɛ́i,","poem":1},{"lineBreak":true},{"text":"n wɛ́'i wàramɛnɛ, ńdi tó ma gɛ̃̀ síro,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"de màgↄ̃ tɛ́ n arɛ gbɛ̃ bɛ̃nɛnↄ kukia la.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bee kũ wari tↄ̃̀ma ma gↄ̃ búgubugu,","poem":1},{"lineBreak":true},{"text":"má kpɛ́ a náanikɛna, akũ ma yã ò.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bídi ma kũ ma pì:","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ sĩnda pínki bi ɛ́kɛdenↄmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bↄ́n mani fĩna boo Dikirinɛ","poem":1},{"lineBreak":true},{"text":"yã mana kũ à kɛ̀mɛnɛ pínki musuu?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mani Dikiri surabana toko sɛ́ musu,","poem":1},{"lineBreak":true},{"text":"mani a sísio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mani lɛ́ kũ ma kɛ̀ Dikirianↄ papa","poem":1},{"lineBreak":true},{"text":"a gbɛ̃nↄ wára ń pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dikiri yãmarinↄ gana bɛ̀ɛrɛ vĩnɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dikiri, n yã nna, n zↄ̀bleriimɛ ma ũ,","poem":1},{"lineBreak":true},{"text":"nↄgbɛ̃ kũ à zↄ̀ↄ blènnɛ nɛ́mɛ ma ũ,","poem":1},{"lineBreak":true},{"text":"n ma bo bàn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mani kɛnnakũkↄ̃o sa omma,","poem":1},{"lineBreak":true},{"text":"mani n sísio, Dikiri.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mani lɛ́ kũ ma kɛ̀ Dikirianↄ papa","poem":1},{"lineBreak":true},{"text":"a gbɛ̃nↄ wára ń pínki","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"a kpɛ́ ↄnn Yurusalɛmu gũn.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}