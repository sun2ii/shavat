{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":118,"content":[{"type":"heading","content":["Gɛna Dikiri ↄnn kũ sáabukɛnaao"]},{"type":"verse","number":1,"content":[{"text":"À Dikiri sáabu kɛ, zaakũ à mana,","poem":1},{"lineBreak":true},{"text":"a gbɛ̃kɛ lakana vĩro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Isarailanↄ o:","poem":1},{"lineBreak":true},{"text":"A gbɛ̃kɛ lakana vĩro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Haruna burinↄ o:","poem":1},{"lineBreak":true},{"text":"A gbɛ̃kɛ lakana vĩro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A vĩnakɛrinↄ o:","poem":1},{"lineBreak":true},{"text":"A gbɛ̃kɛ lakana vĩro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma lɛ́ zù Dikirii ma warikɛnaa gũn,","poem":1},{"lineBreak":true},{"text":"akũ à wèma à ma gba mɛ̀poroki.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dikiri kú kũmao, vĩna ni ma kũro.","poem":1},{"lineBreak":true},{"text":"Bↄ́n bisãsiri ni fↄ̃ à kɛmɛnɛɛ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dikiri kú kũmao ma kpanyĩri ũ,","poem":1},{"lineBreak":true},{"text":"mani yↄ̃̀gↄ̃ kɛ ma ibɛrɛnↄa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nana Dikirii mana de","poem":1},{"lineBreak":true},{"text":"bisãsiri náanikɛnala.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nana Dikirii mana de","poem":1},{"lineBreak":true},{"text":"gbãnadenↄ náanikɛnala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Buri sĩnda pínki lìkamai,","poem":1},{"lineBreak":true},{"text":"akũ ma ń kakatɛ kũ Dikiri tↄ́o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ò lìkamai kpa sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"akũ ma ń kakatɛ kũ Dikiri tↄ́o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ò fĩ̀ma lán zↄ́nↄ bà,","poem":1},{"lineBreak":true},{"text":"akũ ò làka lán kãni tɛ́kũnaa bà,","poem":1},{"lineBreak":true},{"text":"ma ń kakatɛ kũ Dikiri tↄ́o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ò ↄ sↄ̃̀mai kpɛ, má ye mà lɛ́tɛ,","poem":1},{"lineBreak":true},{"text":"akũ Dikiri kpàmai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dikiri mɛ́ à ma gbãna ũ, a táakin madì lɛ́,","poem":1},{"lineBreak":true},{"text":"àkũ mɛ́ à gↄ̃̀ ma surabari ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"À ma, pↄnna wiki dↄ gbɛ̃ mananↄ bùran,","poem":1},{"lineBreak":true},{"text":"Dikiri ↄpla zĩ zↄ̃kↄ̃ↄ kɛ̀.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dikiri ↄpla kú musu,","poem":1},{"lineBreak":true},{"text":"Dikiri ↄpla zĩ zↄ̃kↄ̃ↄ kɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mani garo, manigↄ̃ kun,","poem":1},{"lineBreak":true},{"text":"manigↄ̃ Dikiri yãkɛnanↄ baba.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dikiri ma toto manamana,","poem":1},{"lineBreak":true},{"text":"ama adi tó ga ma sɛro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"À zɛ́ mana gbànↄ wɛ̃mɛnɛ,","poem":1},{"lineBreak":true},{"text":"de mà gɛ̃ mà Dikiri sáabu kpá.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dikiri ↄn zɛ́n dí,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ mananↄ mɛ́ òdi gɛ̃n.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ma n sáabu kɛ̀ Dikiri, zaakũ n wema,","poem":1},{"lineBreak":true},{"text":"n gↄ̃ ma surabari ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Gbɛ̀ kũ kpɛ́borinↄ pã kpài","poem":1},{"lineBreak":true},{"text":"mɛ́ à gↄ̃̀ kpɛ́ kusuru gbɛ̀ mìde ũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dikiri mɛ́ à abirekũ kɛ̀,","poem":1},{"lineBreak":true},{"text":"akũ à kɛ̀wɛrɛ yãbonsarɛ ũ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gↄrↄ kũ Dikiri dìtɛn dí,","poem":1},{"lineBreak":true},{"text":"ò pↄnna kɛn ó nɛ̀sɛ kɛ nna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"N yã nna Dikiri! Ǹ ó sura ba!","poem":1},{"lineBreak":true},{"text":"Ǹ sùru kɛ Dikiri! Ǹ tó ò sa'a le!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Arubarikademɛ gbɛ̃ kũ àtɛn su kũ Dikiri tↄ́o ũ,","poem":1},{"lineBreak":true},{"text":"zaa Dikiri ↄnn ótɛn gbãnakɛ kpányĩ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Dikirimɛ Luda ũ, à gu pùwɛrɛ.","poem":1},{"lineBreak":true},{"text":"À zà lá kpákpa àgↄ̃ tɛ́o dikpɛkɛrinↄi","poem":1},{"lineBreak":true},{"text":"ari sa'oki bɛ̃nɛnↄ kĩnaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ma Ludamɛ n ũ, mani n sáabu kɛ,","poem":1},{"lineBreak":true},{"text":"ma Luda, mani n tↄ́ sɛ́ lei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"À Dikiri sáabu kɛ, zaakũ à mana,","poem":1},{"lineBreak":true},{"text":"a gbɛ̃kɛ lakana vĩro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}