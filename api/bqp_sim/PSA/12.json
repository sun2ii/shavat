{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":12,"content":[{"type":"heading","content":["Bisãsiri vãnikɛ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ. Òdi sí kũ mↄrↄlɛnaaomɛ."]},{"type":"verse","number":1,"content":[{"text":"Ǹ ma sura ba, Dikiri,","poem":1},{"lineBreak":true},{"text":"zaakũ gbɛ̃ mana ke kun doro,","poem":1},{"lineBreak":true},{"text":"náanide làka bisãsirinↄ tɛ́.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Baadi dì ɛ́kɛ to a gbɛ̃dakenɛ,","poem":1},{"lineBreak":true},{"text":"àdi lɛ́nna kásańnɛ kũ nɛ̀sɛplao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dikiri, ǹ lɛ́nnade lɛ́ kↄ̀ ɛ́","poem":1},{"lineBreak":true},{"text":"kũ zĩdabiri pínki pↄ́o.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Òdi pi ń lɛ́ mɛ́ ani tó ò zĩ̀ ble,","poem":1},{"lineBreak":true},{"text":"ò ń lɛ́ vĩ, dí mɛ́ ani kí bleḿmaa?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wɛ́tãna gbɛ̃ busɛnↄa","poem":1},{"lineBreak":true},{"text":"kũ wɛ̃ndadenↄ ndanaao yãi","poem":1},{"lineBreak":true},{"text":"Dikiri pì áni futɛ sà","poem":1},{"lineBreak":true},{"text":"à ń gba zɛ́boki kũ òtɛni a ni dɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dikiri yã mamberu vĩro,","poem":1},{"lineBreak":true},{"text":"à de lán andurufu kũ ò yↄ̀ tɛ́vuraa gũn","poem":1},{"lineBreak":true},{"text":"ò bàasa gɛ̃̀n suppla bà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mↄkↄ̃n Dikiri, ĩnigↄ̃ ó dãkpã gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"ń ó sí gbɛ̃ bire takanↄa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃nↄ yã bɛ̃̀nɛ kũ̀ ↄplapla,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ vãninↄ dìgↄ̃ kure kũ zĩdabio gu sĩnda pínkia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}