{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":120,"content":[{"type":"heading","content":["Kunna yãketedenↄ tɛ́"]},{"type":"hebrew_subtitle","content":["Gɛna Yurusalɛmu lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Ma warikɛnaa gũn ma Dikiri sìsi,","poem":1},{"lineBreak":true},{"text":"akũ à wèma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ ma sí yãsiradenↄ ↄĩ","poem":1},{"lineBreak":true},{"text":"kũ manafikidenↄ lɛ́o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Manafikide, deran Luda ni kɛ nà kũnwoo?","poem":1},{"lineBreak":true},{"text":"Ke bↄ́n ani kɛnnɛɛ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ani wɛ́ tãma kũ gↄ̃sa kà lɛ́ nnanↄ","poem":1},{"lineBreak":true},{"text":"kũ sɛ̃ lí sĩsĩ wãnao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waiyoo makũ kũ má kú Mɛsɛkinↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"má vutɛna Kedanↄ bizakutan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma vutɛ à gìi kɛ̀ manamana","poem":1},{"lineBreak":true},{"text":"kũ gbɛ̃ kũ ò zã̀ aafianↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vutɛna aafiaan má yei,","poem":1},{"lineBreak":true},{"text":"ama tó ma yã ò, fìtiin òdi futɛomai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}