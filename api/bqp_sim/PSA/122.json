":"verse","number":6,"content":[{"text":"À aafia wɛ́ kɛ Yurusalɛmunɛ à pi:","poem":1},{"lineBreak":true},{"text":"Luda tó gbɛ̃ kũ ò yenyĩnↄ arubarika le!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aafia gↄ̃ kú n bĩninↄ dagura,","poem":1},{"lineBreak":true},{"text":"n gudãkpãkinↄ gↄ̃ katɛna nna.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃nↄ kũ ma gbɛ̃nnanↄ yãi mani pi,","poem":1},{"lineBreak":true},{"text":"Luda n gba aafia.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dikiri ó Luda kpɛ́ yãi","poem":1},{"lineBreak":true},{"text":"mani yã mana wɛ́ kɛnnɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}