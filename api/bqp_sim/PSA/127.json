{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":127,"content":[{"type":"heading","content":["Pↄ́ sĩnda pínki bi Luda gbamɛ"]},{"type":"hebrew_subtitle","content":["Gɛna Yurusalɛmu lɛ̀ kũ Sulemanu dàa."]},{"type":"verse","number":1,"content":[{"text":"Tó adi kɛ Dikiri mɛ́ à kpɛ́ bòro,","poem":1},{"lineBreak":true},{"text":"a bòrinↄ tɛn zĩ pã kɛmɛ.","poem":1},{"lineBreak":true},{"text":"Tó adi kɛ Dikiri mɛ́ à wɛ̃tɛ dã̀kpãro,","poem":1},{"lineBreak":true},{"text":"a dãkpãrinↄ tɛn ibɛ̃nɛ kɛ pãmɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Futɛna kↄnkↄkↄnkↄ, wutɛna lizãndo,","poem":1},{"lineBreak":true},{"text":"zĩkɛna bã̀mbãm pↄ́ble yãi bi pãmɛ,","poem":1},{"lineBreak":true},{"text":"zaakũ Dikiri dì a gbɛ̃ yenyĩdenↄ gba ĩampanaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nɛ́gↄ̃gbɛ̃nↄ bi Dikiri gbamɛ,","poem":1},{"lineBreak":true},{"text":"nɛ́nↄ bi a láadamɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lákũ kànↄn de nà zĩ̀kari ↄĩ,","poem":1},{"lineBreak":true},{"text":"lɛn kɛfɛnnakɛgↄrↄ nɛ́gↄ̃gbɛ̃nↄn de lɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Arubarikaden gbɛ̃ kũ a gbàta pana kũńwo ũ,","poem":1},{"lineBreak":true},{"text":"tó a ibɛrɛnↄ a lè gãnulɛa, wé'i ni a kũro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}