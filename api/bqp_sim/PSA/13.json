{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":13,"content":[{"type":"heading","content":["Wikilɛna Ludaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Ari bↄrɛɛ, Dikiri?","poem":1},{"lineBreak":true},{"text":"Ma yã nigↄ̃ sãngu gↄrↄ sĩnda pínkin yá?","poem":1},{"lineBreak":true},{"text":"Ĩni kpɛ limɛnɛ ari bↄrɛmɛɛ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Manigↄ̃ ↄsi ká kũ ma laasunnↄ ari bↄrɛmɛɛ?","poem":1},{"lineBreak":true},{"text":"Ma pↄ dìgↄ̃ sira lákũ gu dìgↄ̃ dↄ nà,","poem":1},{"lineBreak":true},{"text":"ma ibɛrɛ nigↄ̃ gbãna blema ari bↄrɛmɛɛ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dikiri ma Luda, ǹ ma gwa ǹ ma yã ma,","poem":1},{"lineBreak":true},{"text":"ǹ ma ãn weremɛnɛ de màsun garo yãi,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"de ma ibɛrɛ sún pi a ma nɛro yãi,","poem":1},{"lineBreak":true},{"text":"de ma zãngurinↄ sún pↄnna kɛ ma fuana yã musuro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Matɛni n gbɛ̃kɛ náani kɛ,","poem":1},{"lineBreak":true},{"text":"ma pↄ kɛ̀ nna kũ n ma sura bà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mani lɛ̀ sí Dikirinɛ,","poem":1},{"lineBreak":true},{"text":"zaakũ à yã mana kɛ̀mɛnɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}