{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":130,"content":[{"type":"heading","content":["Wɛ́dↄna Dikirii"]},{"type":"hebrew_subtitle","content":["Gɛna Yurusalɛmu lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Zaa í lòkoton ma wiki lɛ̀ Dikiria ma pì,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dikiri, ǹ ma yã ma,","poem":1},{"lineBreak":true},{"text":"ǹ sã kpá ma wikilɛnaai ǹ ma wɛ́ gwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dikiri, tó ndì ó durunnanↄ kɛ̃ ǹ ditɛmɛ,","poem":1},{"lineBreak":true},{"text":"Dikiri, dí mɛ́ ani boo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mↄkↄ̃n mɛ́ ń durunnakɛ̃mmana zɛ́ vĩ,","poem":1},{"lineBreak":true},{"text":"abire yãin òdi vĩna kɛnnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma wɛ́ dìgↄ̃ dↄ Dikirii, matɛni a dã,","poem":1},{"lineBreak":true},{"text":"a yã náanin má vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lákũ gudãkpãrinↄ wɛ́ dìgↄ̃ dↄ gudↄnaai nà,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ dìgↄ̃ dↄ Dikirii deńla,","poem":1},{"lineBreak":true},{"text":"ee, à de gudãkpãrinↄ wɛ́dↄna gudↄnaaila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ákↄ̃nↄ Isarailanↄ, à wɛ́ dↄ Dikirii,","poem":1},{"lineBreak":true},{"text":"zaakũ Dikiri gbɛ̃kɛ vĩ,","poem":1},{"lineBreak":true},{"text":"à surabana gbãna vĩ papana.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Àkũ mɛ́ ani Isarailanↄ bo","poem":1},{"lineBreak":true},{"text":"ń durunnanↄ gũn pínki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}