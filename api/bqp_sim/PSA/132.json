{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":132,"content":[{"type":"heading","content":["Dauda burinↄ vutɛna kpatan Zaiↄ̃"]},{"type":"hebrew_subtitle","content":["Gɛna Yurusalɛmu lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri, ǹ tó Dauda yã gↄ̃ dↄngu","poem":1},{"lineBreak":true},{"text":"kũ wari kũ à kɛ̀nↄ pínki.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À la dà Dikirinɛ,","poem":1},{"lineBreak":true},{"text":"à lɛ́ sɛ̀ Yakubu Luda gbãnadenɛ à pì,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"áni gɛ̃ kpɛ́nlo,","poem":1},{"lineBreak":true},{"text":"áni wútɛ a gádoaro,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"áni we à idekũ dɛro,","poem":1},{"lineBreak":true},{"text":"áni tó i na a wɛ́aro,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ari à gɛ́ gu leo Dikirinɛ","poem":1},{"lineBreak":true},{"text":"à kpɛ́ bo Yakubu Luda gbãnadenɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O a baaruu mà Ɛflata bùsun,","poem":1},{"lineBreak":true},{"text":"o boa Yarimu bura.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ò gɛ́ a kúkia,","poem":1},{"lineBreak":true},{"text":"ò kútɛ a tìntin arɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dikiri, ǹ futɛ ǹ su n kipakia,","poem":1},{"lineBreak":true},{"text":"mↄkↄ̃n kũ n gbãnakɛ àkpatiio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N gbàgbarinↄ manakɛ da uta ũ,","poem":1},{"lineBreak":true},{"text":"n yãmarinↄ ayuwii gↄ̃ dↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ǹsun mìkpɛrɛ zu kína kũ n kàanɛro","poem":1},{"lineBreak":true},{"text":"n zↄ̀bleri Dauda yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dikiri sì kũ a kunnaao Daudanɛ,","poem":1},{"lineBreak":true},{"text":"à náani vĩ, ani lɛ́ litɛro, à pì:","poem":1},{"lineBreak":true},{"text":"Mani n burinↄ doke ká n kpatan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó n burinↄ ma bàka kunna kũńwo yã dà,","poem":1},{"lineBreak":true},{"text":"tó ò yã kũ ma dàńnɛnↄ kũna,","poem":1},{"lineBreak":true},{"text":"ń burinↄ nigↄ̃ vutɛ n kpatan gↄrↄ sĩnda pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Zaakũ Dikiri Zaiↄ̃ sɛ̀,","poem":1},{"lineBreak":true},{"text":"à ye àgↄ̃ de a vutɛki ũ, à pì:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Gu dín manigↄ̃ kun gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"lan manigↄ̃ vutɛna, zaakũ à ma pↄ gbàmɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mani arubarika dan manamana,","poem":1},{"lineBreak":true},{"text":"mani pↄ́ble kpá a takasidenↄa à mↄ́ḿma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mani surabana da a sa'orinↄnɛ uta ũ,","poem":1},{"lineBreak":true},{"text":"ma yãmarinↄ ayuwii nigↄ̃ dↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Gwen mani Dauda buri kína gbãnade bon,","poem":1},{"lineBreak":true},{"text":"gwen kína kũ ma kà tɛ́ nigↄ̃ kún.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mani wé'i da a ibɛrɛnↄa,","poem":1},{"lineBreak":true},{"text":"a kífura nigↄ̃ pí a mìia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}