{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":135,"content":[{"type":"heading","content":["Dikiri táakilɛnaa"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"À Dikiri tↄ́ bo!","poem":1},{"lineBreak":true},{"text":"À Dikiri sáabu kpá, ákↄ̃nↄ a zĩkɛrinↄ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ákↄ̃nↄ kũ adì zĩ kɛ Dikiri bɛanↄ,","poem":1},{"lineBreak":true},{"text":"á gbɛ̃ kũ adìgↄ̃ zɛna ó Luda ↄnnnↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"À Dikiri tↄ́ bo, zaakũ à mana,","poem":1},{"lineBreak":true},{"text":"à a táaki lɛ́, zaakũ abirekũ mɛ́ à nna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dikiri Yakubu burinↄ sɛ̀ a pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"à Isarailanↄ dìtɛ a gbɛ̃ yenyĩdenↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Má dↄ̃ kũ Dikirin zↄ̃kↄ̃,","poem":1},{"lineBreak":true},{"text":"ó Luda mɛ́ à de tãnanↄla ń pínki.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dikiri dì yã kũ à yei kɛ","poem":1},{"lineBreak":true},{"text":"musu kũ zĩtɛo,","poem":1},{"lineBreak":true},{"text":"ísira gũn kũ a lↄ̀nↄo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Àdi tó legũ sisi ari andunia lɛ́zɛkia,","poem":1},{"lineBreak":true},{"text":"àdi tó legũ ma kũ a pinaao,","poem":1},{"lineBreak":true},{"text":"àdi bo kũ zàga'ĩao a pↄ́katɛkin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"À Misila daudunↄ dɛ̀dɛ","poem":1},{"lineBreak":true},{"text":"kũ pↄ́kãde nɛ́ káakunↄ pínki.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À sèedanↄ kũ daboyãnↄ kɛ̀ Misila,","poem":1},{"lineBreak":true},{"text":"à wɛ́ tã̀ Firi'auna kũ a ìbanↄa ń pínki.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À burinↄ làka dasi,","poem":1},{"lineBreak":true},{"text":"à kína gbãnadenↄ dɛ̀dɛ,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amↄrinↄ kína Siↄ̃","poem":1},{"lineBreak":true},{"text":"kũ Basã kína Oguo","poem":1},{"lineBreak":true},{"text":"kũ Kanaanↄ bùsu kínanↄ ń pínki.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À ń bùsu sì à kpà","poem":1},{"lineBreak":true},{"text":"a gbɛ̃ Isarailanↄa túbi ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dikiri, n tↄ́ dìgↄ̃ kun gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"Dikiri, n yã nigↄ̃ dↄ gbɛ̃nↄgu ari ó buria.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zaakũ Dikiri ni tó a gbɛ̃nↄ bo mana,","poem":1},{"lineBreak":true},{"text":"ani a zↄ̀blerinↄ wɛ̃nda gwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Burinↄ ń tãnanↄ pì kũ andurufuuo kũ wuraao,","poem":1},{"lineBreak":true},{"text":"bisãsiri ↄzĩnↄmɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ò lɛ́ vĩ, ama òdi yã oro,","poem":1},{"lineBreak":true},{"text":"ò wɛ́ vĩ, ama òdi gu ero,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ò sã vĩ, ama òdi yã maro,","poem":1},{"lineBreak":true},{"text":"òdi wesa boro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ń pìrinↄn lɛɛlɛ kũńwomɛ","poem":1},{"lineBreak":true},{"text":"kũ gbɛ̃ kũ òtɛni ń náani kɛnↄ ń pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Isarailanↄ, à Dikiri sáabu kpá!","poem":1},{"lineBreak":true},{"text":"Haruna burinↄ, à Dikiri sáabu kpá!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Levi burinↄ, à Dikiri sáabu kpá!","poem":1},{"lineBreak":true},{"text":"Dikiri vĩnakɛrinↄ, à Dikiri sáabu kpá!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Arubarikademɛ Dikiri ũ zaa Zaiↄ̃,","poem":1},{"lineBreak":true},{"text":"àkũ kũ à kú Yurusalɛmu.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}