{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":138,"content":[{"type":"heading","content":["Dikiri sáabukpana a gbɛ̃kɛ yãi"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Mani n sáabu kpá kũ nɛ̀sɛdoo,","poem":1},{"lineBreak":true},{"text":"mani n táaki lɛ́ gbãnadenↄ arɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mani kútɛ mà arɛ dↄ","poem":1},{"lineBreak":true},{"text":"n kpɛ́ kũ à kú adona kpa,","poem":1},{"lineBreak":true},{"text":"mani n tↄ́ bo n gbɛ̃kɛ kũ n náanio yãi,","poem":1},{"lineBreak":true},{"text":"zaakũ n n tↄ́ kũ n yãoo sɛ̀ lei de pↄ́ sĩnda pínkila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kũ ma n sisi, n wema,","poem":1},{"lineBreak":true},{"text":"ǹ ma kù kɛ gbãna, ǹ ma swɛ̃̀ kpátɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tó andunia kínanↄ yã kũ n òo mà,","poem":1},{"lineBreak":true},{"text":"oni n sáabu kpá ń pínki, Dikiri.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oni lɛ̀ sí Dikiri yãkɛnanↄ musu,","poem":1},{"lineBreak":true},{"text":"zaakũ Dikiri gakuri zↄ̃kↄ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bee kũ Dikiri kunnamusukɛo,","poem":1},{"lineBreak":true},{"text":"àdi gbɛ̃ kĩananↄ wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"àdi wɛ́ tá zĩdabirinↄla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bee tó wɛ́tãmmanaa lìkamai,","poem":1},{"lineBreak":true},{"text":"ndì ma wɛ̃̀ndi dãkpã,","poem":1},{"lineBreak":true},{"text":"ndì ma ibɛrɛnↄ pↄfɛ̃ kpátɛ,","poem":1},{"lineBreak":true},{"text":"ndì ma sura ba kũ n gã̀ gbãnao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dikiri ni yã kũ à ò papamɛnɛ.","poem":1},{"lineBreak":true},{"text":"Dikiri, n gbɛ̃kɛ lakana vĩro,","poem":1},{"lineBreak":true},{"text":"ǹsun makũ kũ n ma kɛ tóro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}