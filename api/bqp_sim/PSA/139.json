{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":139,"content":[{"type":"heading","content":["Dikiri yã sĩnda pínki dↄ̃"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri, n ma yã gwàgwa n dↄ̃̀,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ń ma vutɛna kũ ma futɛnaao dↄ̃,","poem":1},{"lineBreak":true},{"text":"zaa zã̀zã ń ma laasunnↄ dↄ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndì ma táa'ona kũ ma wutɛnaao tàasi ká,","poem":1},{"lineBreak":true},{"text":"n kↄ̃ dↄ̃̀ kũ ma yãnↄ pínki.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ari yã gↄ̃ bo ma lɛ́n,","poem":1},{"lineBreak":true},{"text":"Dikiri, ń dↄ̃ sãnsãn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ń likamai kpɛ kũ arɛo,","poem":1},{"lineBreak":true},{"text":"n ↄ kúmala.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dↄ̃na bire demɛnɛ daboyã ũmɛ,","poem":1},{"lineBreak":true},{"text":"à demala, ma ↄ̃ndↄ̃ dí káaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mán mani gɛ́n mà kɛ̃ n Niniaa?","poem":1},{"lineBreak":true},{"text":"Mán mani bàa sí mà gɛ́n mà kuranyĩi?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tó ma futɛ ma gɛ musu, ń kú gwe!","poem":1},{"lineBreak":true},{"text":"Tó ma wutɛki kɛ̀ gyãwãn, mↄkↄ̃mmɛ gwe!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó ma futɛ ma gɛ ifãboki kpa,","poem":1},{"lineBreak":true},{"text":"tó ma gɛ vutɛ ísira bara ifãlɛtɛ kpa,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"bee gwemɛ má na n ↄĩ,","poem":1},{"lineBreak":true},{"text":"ĩnigↄ̃ ma kũna kũ n ↄplao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tó ma pì gusira damala,","poem":1},{"lineBreak":true},{"text":"ke gupura kũ à likamai li gwãani ũ,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"gu dìgↄ̃ sirannɛro,","poem":1},{"lineBreak":true},{"text":"gwãani dìgↄ̃ dennɛ lán fãnantɛ̃ bàmɛ,","poem":1},{"lineBreak":true},{"text":"gupura kũ gusirao dìgↄ̃ lɛɛlɛnnɛmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mↄkↄ̃n mɛ́ n ma gũn kɛ̀,","poem":1},{"lineBreak":true},{"text":"n ma í kàsa ma da nɛ̀sɛn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma n sáabu kɛ̀ kũ ma kɛna naasi vĩ","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ à yãbonsarɛ vĩ.","poem":1},{"lineBreak":true},{"text":"N yãkɛnanↄ dì bo ń sarɛ,","poem":1},{"lineBreak":true},{"text":"má dↄ̃ sãnsãn ma nɛ̀sɛn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gↄrↄ kũ n ma í kàsa nɛ́'isↄↄ gũn,","poem":1},{"lineBreak":true},{"text":"ma wá ke utɛnannɛro.","poem":1},{"lineBreak":true},{"text":"Kũ ma mɛ̀ tɛn li asiri gũn gwe,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"n wɛ́ sì ma nɛ́gbĩnilɛ.","poem":1},{"lineBreak":true},{"text":"Lákũ n ma gↄrↄ dìtɛ nà pínki,","poem":1},{"lineBreak":true},{"text":"a lɛ́ kú n takadan","poem":1},{"lineBreak":true},{"text":"zaade a ke dí naaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Luda, n laasunn bɛ̀ɛrɛ vĩmɛnɛ manamana,","poem":1},{"lineBreak":true},{"text":"a lɛ́ vĩro fá!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó má ye mà naro,","poem":1},{"lineBreak":true},{"text":"ń dasi de bùsu'atɛ̃la,","poem":1},{"lineBreak":true},{"text":"tó ma vu,","poem":1},{"lineBreak":true},{"text":"madìgↄ̃ kú kũnwo ari tera.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Luda, tó ĩni gbɛ̃ vãninↄ dɛdɛ dé?","poem":1},{"lineBreak":true},{"text":"À gomala, ákↄ̃nↄ gbɛ̃dɛrinↄ!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N ibɛrɛnↄ dì n yã o kũ nɛ̀sɛ vãnio,","poem":1},{"lineBreak":true},{"text":"n tↄ́ bɛ̀ɛrɛ vĩ n lɛ́nlo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dikiri, madì zã gbɛ̃ kũ ò zã̀ngunↄguroo?","poem":1},{"lineBreak":true},{"text":"Madì gí gbɛ̃ kũ ò fùtɛnyĩnↄ kãi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Má yãke vĩńnɛro, se zãngu,","poem":1},{"lineBreak":true},{"text":"madì ń ditɛ ma ibɛrɛnↄ ũmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Luda, ǹ ma gwagwa ǹ ma nɛ̀sɛ dↄ̃,","poem":1},{"lineBreak":true},{"text":"ǹ ma yↄ̃ ǹ ma gwa ǹ ma laasun dↄ̃.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ǹ gwa tó má laasun vãni ke vĩ,","poem":1},{"lineBreak":true},{"text":"ǹ ma da zɛ́ kũ àdigↄ̃ kun gↄrↄ sĩnda pínkiaa gũn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}