{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":14,"content":[{"type":"heading","content":["Yↄ̃nkↄ yã'onaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Yↄ̃nkↄ dì o a swɛ̃̀n Luda kunlo.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃nↄ yàku kpà, ń yãkɛna vãni,","poem":1},{"lineBreak":true},{"text":"yãmanakɛri ke kú ń tɛ́ro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Zaa musu Dikiri dì bisãsirinↄa tàasi ká","poem":1},{"lineBreak":true},{"text":"à gwa tó gbɛ̃ke ↄ̃ndↄ̃ kà à a ki wɛtɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ò sã̀tɛ ń pínki ò gↄ̃̀ dↄ̀rↄↄ sari míↄmiↄ,","poem":1},{"lineBreak":true},{"text":"yãmanakɛri ke kú ń tɛ́ro, bee mɛ̀n do.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vãnikɛrinↄn dↄ̃na vĩnloo?","poem":1},{"lineBreak":true},{"text":"Òdi ma gbɛ̃nↄ mↄ́mↄ lán ú bà,","poem":1},{"lineBreak":true},{"text":"òdi Dikiri sísiro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gwen vĩna ń kũn manamana,","poem":1},{"lineBreak":true},{"text":"zaakũ Luda kú kũ gbɛ̃ mananↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Òdi kpá takasidenɛ a pↄyeinakɛnaa,","poem":1},{"lineBreak":true},{"text":"ama Dikirimɛ a utɛki ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Luda, ǹ bo Zaiↄ̃ ǹ mↄ́ ǹ Isarailanↄ sura ba!","poem":1},{"lineBreak":true},{"text":"Tó Dikiri sù kũ a gbɛ̃nↄ ń gwena zĩn,","poem":1},{"lineBreak":true},{"text":"Yakubu burinↄ ni pↄnna kɛ,","poem":1},{"lineBreak":true},{"text":"Isarailanↄ ni yáa dↄ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}