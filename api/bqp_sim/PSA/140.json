{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":140,"content":[{"type":"heading","content":["Aduakɛna gbɛ̃ vãninↄ musu"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri, ǹ ma sí gbɛ̃ vãninↄa,","poem":1},{"lineBreak":true},{"text":"ǹ ma dãkpã gbɛ̃ pãsĩnↄ yãi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Òdi yã vãni laasun lɛ́ ń swɛ̃̀ɛ gũn,","poem":1},{"lineBreak":true},{"text":"fìtiin òdigↄ̃ wɛtɛ gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Òdi ń lɛ́ kɛkɛ lán mlɛ̃̀ɛ bà,","poem":1},{"lineBreak":true},{"text":"ń lɛ́gbɛ bi pitiko sɛwɛmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dikiri, ǹsun tó gbɛ̃ vãninↄ ↄ namaro,","poem":1},{"lineBreak":true},{"text":"ǹ ma sí gbɛ̃ pãsĩnↄa,","poem":1},{"lineBreak":true},{"text":"òdi lɛ́ kpákũsũ de ò ma pãtɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zĩdabirinↄ wɛ̀ɛɛ yↄ̃̀mɛnɛ,","poem":1},{"lineBreak":true},{"text":"ò tankutɛ kpàkpamɛnɛ,","poem":1},{"lineBreak":true},{"text":"ò bàa kpàmɛnɛ zɛ́n.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dikiri, ma pìnnɛ: Ma Ludamɛ n ũ,","poem":1},{"lineBreak":true},{"text":"ǹ sã kpá ma wɛ̃nda wikii, Dikiri.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dikiri Luda, ma surabari gbãna,","poem":1},{"lineBreak":true},{"text":"mↄkↄ̃n kũ ndì ↄ kúmala zĩ̀lan,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ǹsun tó gbɛ̃ vãninↄ ń pↄyeina zɛ́ lero,","poem":1},{"lineBreak":true},{"text":"Dikiri, ǹsun tó ń lɛ́kpakũsũna kↄ̃ sɛ́ro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gbɛ̃ kũ ò likamainↄ,","poem":1},{"lineBreak":true},{"text":"ǹ tó yã vãni kũ òtɛni ma kpákpao wí ń musu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹ tó tɛ́yↄ̃ wãna kúḿma, ǹ tó ò ń zu tɛ́n,","poem":1},{"lineBreak":true},{"text":"ǹ tó ò si wɛ̀ɛ kũ oni bonlo gũn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹsun tó gbɛ̃yakarinↄ zɛki le andunia gũnlo,","poem":1},{"lineBreak":true},{"text":"ǹ tó kisira gↄ̃ gbɛ̃ pãsĩnↄ wɛ zɛnaa sari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Má dↄ̃ kũ Dikiri dì yã nna kpá wɛ̃ndadenↄa,","poem":1},{"lineBreak":true},{"text":"àdi yã kɛkɛ takasidenↄnɛ a zɛ́a.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yãpura, gbɛ̃ mananↄ ni n tↄ́ bo,","poem":1},{"lineBreak":true},{"text":"nɛ̀sɛpuradenↄ nigↄ̃ kú n arɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}