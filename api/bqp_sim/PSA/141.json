{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":141,"content":[{"type":"heading","content":["Surabana aduakɛnaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri, matɛn wiki lɛ́nyĩ, ǹ kɛ likalika,","poem":1},{"lineBreak":true},{"text":"tó ma n sisi, ǹ sã kpá ma yãi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ tó ma aduakɛna ká n kĩnaa","poem":1},{"lineBreak":true},{"text":"lán turaretiti túsukpɛ bà.","poem":1},{"lineBreak":true},{"text":"Ǹ tó ma ↄ dↄna musu gↄ̃ dennɛ","poem":1},{"lineBreak":true},{"text":"sa ↄkↄsi ona ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dikiri, ǹ lɛ́sↄ damɛnɛ ma lɛ́nɛ,","poem":1},{"lineBreak":true},{"text":"ǹ tó mà a lɛ́ fↄ̃.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ǹsun tó yã vãni ma swɛ̃̀ gátɛro,","poem":1},{"lineBreak":true},{"text":"de màsun kakara kũ yãvãnikɛrinↄ","poem":1},{"lineBreak":true},{"text":"ń yãvãnikɛnaa gũnlo,","poem":1},{"lineBreak":true},{"text":"de màsun ń pↄ́ nnanↄ ble kũńworo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tó gbɛ̃ mana ma lɛ, à gbɛ̃kɛ kɛ̀mɛnɛmɛ!","poem":1},{"lineBreak":true},{"text":"Tó à kpã̀kɛ̃mai, mani gíiro,","poem":1},{"lineBreak":true},{"text":"nísi kũ a kpɛ̃̀oomɛ.","poem":1},{"lineBreak":true},{"text":"Madìgↄ̃ adua kɛ baala'i","poem":1},{"lineBreak":true},{"text":"de gbɛ̃ vãninↄ yãkɛna gboro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó ò ń gbãnadenↄ kà sĩ̀sĩgororo wɛ̀ɛn,","poem":1},{"lineBreak":true},{"text":"yãvãnikɛrinↄ ni sí kũ ma yã mɛ́ à nna.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lákũ òdi yàkaa para a bùru fãkↄ̃a nà,","poem":1},{"lineBreak":true},{"text":"lɛn ń wá nigↄ̃ fãkↄ̃ana ń mira lɛ́a lɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dikiri Luda, mↄkↄ̃mmɛ ma wɛ́ dↄnyĩ,","poem":1},{"lineBreak":true},{"text":"ma nanyĩ, ǹsun ma kpá gairo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ ma bo tankutɛ kũ ò kpàkpamɛnɛnↄn,","poem":1},{"lineBreak":true},{"text":"bà kũ yãvãnikɛrinↄ kpàkpamɛnɛnↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹ tó gbɛ̃ vãninↄ si ń zĩda bàa gũn,","poem":1},{"lineBreak":true},{"text":"makũ sↄ̃ mani gɛ̃tɛ aafia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}