{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":143,"content":[{"type":"heading","content":["Kunna ibɛrɛnↄ ↄĩ aduakɛnaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri, ǹ ma aduakɛna sí,","poem":1},{"lineBreak":true},{"text":"ǹ sã kpá ma wɛ̃nda wikii,","poem":1},{"lineBreak":true},{"text":"ǹ wema n náani kũ n manao yãi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹsun yãkpatɛ kɛ kũ makũ n zↄ̀bleriioro,","poem":1},{"lineBreak":true},{"text":"zaakũ gbɛ̃ke taari sari n kĩnaaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ma ibɛrɛ pɛ̀tɛmai à ma nɛ,","poem":1},{"lineBreak":true},{"text":"à tò má kú gusiran","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃ kũ à gà zaa gìkɛnaa bà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Akũ ma nɛ̀sɛɛ yàka manamana,","poem":1},{"lineBreak":true},{"text":"ma sↄ̃pɛ̀tɛ vãni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yã zĩzĩnↄ dↄ̀magu,","poem":1},{"lineBreak":true},{"text":"madì laasun lɛ́ n zĩkɛnanↄa,","poem":1},{"lineBreak":true},{"text":"madì n yãkɛnanↄ da.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma a ↄ dↄnyĩ,","poem":1},{"lineBreak":true},{"text":"madì n ni dɛ lán gukori dì í ni dɛ nà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ǹ wema likalika Dikiri,","poem":1},{"lineBreak":true},{"text":"ma gbãna làka.","poem":1},{"lineBreak":true},{"text":"Ǹsun mìkpɛrɛ zumɛnɛro,","poem":1},{"lineBreak":true},{"text":"de màsun gↄ̃ lán gbɛ̃ kũ ò sì gyãwãnnↄ bàro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ n gbɛ̃kɛ mↄmɛnɛ kↄnkↄ,","poem":1},{"lineBreak":true},{"text":"zaakũ mↄkↄ̃mmɛ má n náani vĩ.","poem":1},{"lineBreak":true},{"text":"Ǹ ma da zɛ́ kũ à de mà sɛ́a,","poem":1},{"lineBreak":true},{"text":"zaakũ mↄkↄ̃mmɛ ma a swɛ̃̀ɛ kpàmma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ ma sí ma ibɛrɛnↄa, Dikiri,","poem":1},{"lineBreak":true},{"text":"mↄkↄ̃mmɛ ma nanyĩ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mↄkↄ̃mmɛ ma Luda ũ,","poem":1},{"lineBreak":true},{"text":"ǹ n pↄyenyĩna yã damɛnɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ tó n Nini mana domɛnɛ arɛ gusaran.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹ ma wɛ̃̀ndi dãkpã n tↄ́ yãi, Dikiri,","poem":1},{"lineBreak":true},{"text":"ǹ ma bo yã'ũmmanaa gũn n mana yãi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹ ma ibɛrɛnↄ láka n gbɛ̃kɛ yãi,","poem":1},{"lineBreak":true},{"text":"ǹ ma zãngurinↄ dɛdɛ ń pínki,","poem":1},{"lineBreak":true},{"text":"zaakũ n zↄ̀bleriimɛ ma ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}