{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":144,"content":[{"type":"heading","content":["Aduakɛna surabana yã musu"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Arubarikademɛ Dikiri ma gbɛ̀si ũ,","poem":1},{"lineBreak":true},{"text":"àdi zĩ̀kana dadamɛnɛ,","poem":1},{"lineBreak":true},{"text":"àdi ma ↄ tùtu kɛ zĩ̀kana yãi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Àkũmɛ ma utɛki ũ, àdi gbɛ̃kɛ kɛmɛnɛ,","poem":1},{"lineBreak":true},{"text":"à de ma zɛki gbãna ũ, àdi ma sura ba.","poem":1},{"lineBreak":true},{"text":"À de ma sɛ̃ngbako ũ kũ madì nai,","poem":1},{"lineBreak":true},{"text":"àdi tó burinↄ mì natɛmɛnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dikiri, bↄ́n bisãsiri ũ","poem":1},{"lineBreak":true},{"text":"kũ a yã dìgↄ̃ dↄnguu?","poem":1},{"lineBreak":true},{"text":"Bↄ́n a ũ kũ ndì laakari dↄaa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bisãsiri de lán kàsa plí bàmɛ,","poem":1},{"lineBreak":true},{"text":"a wɛ̃̀ndii dì gɛ̃tɛ lán uraa bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dikiri, ǹ musu natɛ ǹ kipa,","poem":1},{"lineBreak":true},{"text":"ǹ ↄ na kpinↄa de ò túsukpɛ bo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹ tó legũ pí ǹ gbɛ̃nↄ fãkↄ̃a,","poem":1},{"lineBreak":true},{"text":"ǹ kà fã ń tɛ́ ò lɛkↄ̃a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ ↄ bo zaa musu ǹ ma kũ,","poem":1},{"lineBreak":true},{"text":"ǹ ma bo í zↄ̃kↄ̃ↄ gũn,","poem":1},{"lineBreak":true},{"text":"ǹ ma sí buri zĩ̀tↄnↄa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɛ́kɛtona ń lɛ́ pà,","poem":1},{"lineBreak":true},{"text":"òdi ↄ pãtɛ kũ lɛ́pãgbɛ̃naao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Luda, mani lɛ̀ dufu sínnɛ,","poem":1},{"lineBreak":true},{"text":"mani n táaki lɛ́ kũ mↄrↄ bà mɛ̀n kurideo,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"mↄkↄ̃n kũ ndì tó kínanↄ zĩ̀ ble,","poem":1},{"lineBreak":true},{"text":"ndì n zↄ̀bleri Dauda bo fɛ̃nɛda pãsĩ lɛ́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ǹ ma sí ǹ ma bo buri zĩ̀tↄnↄ ↄĩ,","poem":1},{"lineBreak":true},{"text":"ɛ́kɛtona ń lɛ́ pà,","poem":1},{"lineBreak":true},{"text":"òdi ↄ pãtɛ kũ lɛ́pãgbɛ̃naao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ó nɛ́gↄ̃gbɛ̃nↄ ni futɛ ń kɛfɛnnakɛgↄrↄa","poem":1},{"lineBreak":true},{"text":"lán lí kũ à nna màa bà,","poem":1},{"lineBreak":true},{"text":"ó nɛ́nↄgbɛ̃nↄ gↄ̃ de","poem":1},{"lineBreak":true},{"text":"lán kínabɛ gbɛ̀gba kũ ò zã blèaa bà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ó dↄ̃̀nↄ ni pa kũ pↄ́ buri sĩnda pínkio.","poem":1},{"lineBreak":true},{"text":"Ó sãnↄ ni kↄ̃ lɛu wàa do,","poem":1},{"lineBreak":true},{"text":"oni ká ũgbangba ó kpàsan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ó zùnↄ nigↄ̃ de nɛ́randenↄ ũ,","poem":1},{"lineBreak":true},{"text":"nↄ̀bↄtɛna nigↄ̃ kunlo,","poem":1},{"lineBreak":true},{"text":"lagona nigↄ̃ kunlo,","poem":1},{"lineBreak":true},{"text":"wɛ̃nda'ↄ́ↄdↄna nigↄ̃ kú gãnulɛaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Arubarikadenↄmɛ gbɛ̃ kũ ń kunna de lɛnↄ ũ,","poem":1},{"lineBreak":true},{"text":"arubarikadenↄmɛ gbɛ̃ kũ Dikiri de ń Luda ũnↄ ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}