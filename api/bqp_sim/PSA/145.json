{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":145,"content":[{"type":"heading","content":["Dikiri táakilɛna a manakɛna yãi"]},{"type":"hebrew_subtitle","content":["Dikiri táaki kũ Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Mani n táaki lɛ́, ma Luda ma Kína,","poem":1},{"lineBreak":true},{"text":"manigↄ̃ n tↄ́ bo gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Manigↄ̃ n sáabu kpá lákũ gu dìgↄ̃ dↄ nà,","poem":1},{"lineBreak":true},{"text":"manigↄ̃ n táaki lɛ́ lakanaa sari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dikiri zↄ̃kↄ̃, à kà ò a táaki lɛ́,","poem":1},{"lineBreak":true},{"text":"a zↄ̃kↄ̃kɛ lɛ́ vĩro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kpàinↄ ni n yãkɛnanↄ sáabu kpá Wurenↄnɛ,","poem":1},{"lineBreak":true},{"text":"oni n yãzↄ̃kↄ̃kɛnanↄ kpàkpa kɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oni n manakɛ zↄ̃kↄ̃ gakuride yã o,","poem":1},{"lineBreak":true},{"text":"mani n yãbonsarɛkɛnanↄ laasun lɛ́.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oni n yãkɛna naasi gbãna yã o,","poem":1},{"lineBreak":true},{"text":"mani n zↄ̃kↄ̃kɛ gadi kɛńnɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Oni n manakɛ zↄ̃kↄ̃ baaru kpá,","poem":1},{"lineBreak":true},{"text":"oni ayuwii kɛ n yãzɛdekɛnanↄ yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dikiri sùru vĩ kũ wɛ̃ndao,","poem":1},{"lineBreak":true},{"text":"àdi pↄ fɛ̃ likaro, à gbɛ̃kɛ vĩ zↄ̃kↄ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dikiri dì yã mana kɛ gbɛ̃ sĩnda pínkinɛ,","poem":1},{"lineBreak":true},{"text":"àdi a pↄ́ kũ à kɛ̀nↄ wɛ̃nda gwa ń pínki.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pↄ́ kũ n kɛ̀nↄ ni n sáabu kpá ń pínki,","poem":1},{"lineBreak":true},{"text":"n yãmarinↄ ni n tↄ́ sɛ́ lei, Dikiri.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Oni n kpata gakuri gadi kɛ,","poem":1},{"lineBreak":true},{"text":"oni n iko gbãna yã o,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"de gbɛ̃ sĩnda pínki n yãzↄ̃kↄ̃kɛnanↄ dↄ̃","poem":1},{"lineBreak":true},{"text":"kũ n kpata mana gakuride yão.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N kpata bi kpata lakanasarimɛ,","poem":1},{"lineBreak":true},{"text":"ĩnigↄ̃ de kína ũ ari ó buria.","poem":1},{"lineBreak":true},{"text":"Dikirin náani vĩ yã kũ à ò musu pínki,","poem":1},{"lineBreak":true},{"text":"à sùru vĩ kũ pↄ́ kũ à kɛ̀nↄ ń pínki.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dikiri dì gbɛ̃ kũ òtɛn lɛ́tɛnↄ kũ,","poem":1},{"lineBreak":true},{"text":"àdi gbɛ̃ kũ wari tↄ̃̀ḿmanↄ futɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pↄ́ sĩnda pínki wɛ́ dↄnyĩ,","poem":1},{"lineBreak":true},{"text":"ndì pↄ́ble kpáḿma a gↄrↄa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ndì ↄ porońnɛ pↄ́ mↄ́ḿma,","poem":1},{"lineBreak":true},{"text":"ndì pↄ́ sĩnda pínki pↄyeina bↄkↄtɛnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dikiri yãkɛnanↄn mana pínki,","poem":1},{"lineBreak":true},{"text":"à gbɛ̃kɛ vĩ a yã sĩnda pínki kɛnaa gũn.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dikiri kãni kũ a sìsirinↄ ń pínki,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ òdi a sísi kũ yãpuraonↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Àdi a vĩnakɛrinↄ pↄyeina bↄkↄtɛńnɛ,","poem":1},{"lineBreak":true},{"text":"àdi ń wikilɛna ma à ń sura ba.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dikiri dì gbɛ̃ kũ ò yeainↄ dãkpã ń pínki,","poem":1},{"lineBreak":true},{"text":"ama ani yãvãnikɛrinↄ kakatɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dikiri táakilɛna nigↄ̃ da ma lɛ́n,","poem":1},{"lineBreak":true},{"text":"pↄ́ sĩnda pínki gↄ̃ a tↄ́ kũ à kú adona bo","poem":1},{"lineBreak":true},{"text":"gↄrↄ sĩnda pínki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}