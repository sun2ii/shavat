{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":146,"content":[{"type":"heading","content":["Dikiri laakaridↄna wɛ̃ndadenↄa"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Ma swɛ̃̀, ǹ Dikiri táaki lɛ́.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Manigↄ̃ Dikiri táaki lɛ́ ari ma wɛ̃̀ndi lɛ́a,","poem":1},{"lineBreak":true},{"text":"manigↄ̃ lɛ̀ sí ma Ludanɛ ari ma kunna lɛ́a.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Àsun náani kpá gbãnadenↄaro,","poem":1},{"lineBreak":true},{"text":"surabana kú bisãsiri kĩnaaro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó ń wɛ̃̀ndii tà, òdi ɛra ò gɛ̃ bùsun,","poem":1},{"lineBreak":true},{"text":"zĩ birean yã kũ òtɛn pɛ́a dì láka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Arubarikademɛ gbɛ̃ kũ Yakubu Luda de a kpanyĩri ũ ũ,","poem":1},{"lineBreak":true},{"text":"kũ à wɛ́ dↄ Dikiri a Ludai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Àkũ mɛ́ à musu kũ zĩtɛo kɛ̀,","poem":1},{"lineBreak":true},{"text":"ísira kũ pↄ́ kũ ò kú a gũnnↄ pínki.","poem":1},{"lineBreak":true},{"text":"Dikiri náani vĩ gↄrↄ sĩnda pínki,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"àdi yã sí kũ gbɛ̃ kũ òtɛn gbãna mↄńnɛnↄo,","poem":1},{"lineBreak":true},{"text":"àdi pↄ́ble kpá nàdɛrinↄa.","poem":1},{"lineBreak":true},{"text":"Dikiri dì bàa poro gbɛ̃ kũ ò yĩnanↄa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dikiri dì vĩ̀nanↄ wɛ́ wɛ̃ńnɛ,","poem":1},{"lineBreak":true},{"text":"Dikiri dì gbɛ̃ kũ wari tↄ̃̀ḿmanↄ futɛ,","poem":1},{"lineBreak":true},{"text":"Dikiri dìgↄ̃ ye gbɛ̃ mananↄi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dikiri dì bòasunↄ gwa,","poem":1},{"lineBreak":true},{"text":"àdi ↄ da gyaanↄnↄa kũ tonɛnↄo,","poem":1},{"lineBreak":true},{"text":"ama àdi zɛ́ yãkatɛ gbɛ̃ vãninↄnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dikiri dìgↄ̃ kí ble gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"Zaiↄ̃denↄ, á Luda dìgↄ̃ kun ari á buria.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}