{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":147,"content":[{"type":"heading","content":["Pↄ́ sĩnda pínki kú Luda ↄĩ"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Lɛ̀sina ó Ludanɛ mana,","poem":1},{"lineBreak":true},{"text":"à nna akũsↄ̃ à kũ̀ ò a táaki lɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dikiri tɛn Yurusalɛmu futɛ dↄ,","poem":1},{"lineBreak":true},{"text":"à Isaraila zĩ̀zↄnↄ kàkara àtɛn ɛra à su kũńwo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Àdi gbɛ̃ kũ ń nɛ̀sɛɛ yàkanↄ laakari kpátɛńnɛ,","poem":1},{"lineBreak":true},{"text":"àdi ń bↄ̀ pípińnɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À susunɛnↄ lɛ́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"àdi ń baadi sísi a tↄ́a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ó Dikiri zↄ̃kↄ̃, à iko vĩ manamana,","poem":1},{"lineBreak":true},{"text":"a ↄ̃ndↄ̃ lɛ́ vĩro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dikiri dì zĩdabusarinↄ gba gbãna,","poem":1},{"lineBreak":true},{"text":"ama àdi ↄ tↄ̃ yãvãnikɛrinↄa ari zĩtɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À lɛ̀ sí Dikirinɛ kũ a sáabukɛnaao,","poem":1},{"lineBreak":true},{"text":"à ó Luda táaki lɛ́ kũ mↄrↄↄo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Àdi tó legũ sisi,","poem":1},{"lineBreak":true},{"text":"àdi zĩtɛ gba legũ,","poem":1},{"lineBreak":true},{"text":"àdi tó sɛ̃̀ butɛ sĩ̀sĩnↄa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Àdi pↄ́ble kpá nↄ̀bↄnↄa","poem":1},{"lineBreak":true},{"text":"kũ kãakãanna nɛ́nↄ, tó òtɛn wiki pɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Adi kɛ sↄ̃ gbãnakɛ mɛ́ àdi kánɛro,","poem":1},{"lineBreak":true},{"text":"adi kɛ gↄ̃sagbãnakɛ mɛ́ àdi kɛnɛro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kũ ò a vĩna vĩnↄ mɛ́ àdi kánɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ ń wɛ́ dↄ a gbɛ̃kɛinↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yurusalɛmudenↄ, à Dikiri tↄ́ bo,","poem":1},{"lineBreak":true},{"text":"Zaiↄ̃denↄ, à á Luda táaki lɛ́.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zaakũ àdi arubarika daágu,","poem":1},{"lineBreak":true},{"text":"àdi á wɛ̃tɛ bĩnilɛnↄ gbãna karaárɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Àdi á gba aafia ari á bùsulɛ lɛ́n,","poem":1},{"lineBreak":true},{"text":"àdi pↄ́buri mana kpááwa à kã.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Àdi yã o à kpãzã zĩtɛnɛ,","poem":1},{"lineBreak":true},{"text":"a yã dì ká gↄ̃̀nↄgↄ̃nↄ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Àdi tó legũgbɛ kↄ́tɛ púu lán buu bà,","poem":1},{"lineBreak":true},{"text":"àdi tó plí kpá lán túbu bà,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"àdi legũgbɛ fã lán gbɛ̀kↄsↄↄ bà.","poem":1},{"lineBreak":true},{"text":"Dí mɛ́ ani fↄ̃ à zɛ a ĩa yĩdaii?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Àdi yã o à kpãzã, legũgbɛɛ dì yↄ́,","poem":1},{"lineBreak":true},{"text":"àdi ĩa gbarɛ, a í dì bàa lɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Àdi tó Yakubu burinↄ gↄ̃ a yã dↄ̃,","poem":1},{"lineBreak":true},{"text":"àdi doka kũ à dìtɛnↄ da Isarailanↄnɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Adi abirekũ kɛ buri pãnde kenɛro,","poem":1},{"lineBreak":true},{"text":"ò a yãditɛnanↄ dↄ̃ro.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}