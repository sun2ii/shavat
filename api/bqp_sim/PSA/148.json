{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":148,"content":[{"type":"heading","content":["Dikiri pↄ́ kũ à kɛ̀nↄ a táakilɛnaa"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"À Dikiri táaki lɛ́, a bedenↄ!","poem":1},{"lineBreak":true},{"text":"À a táaki lɛ́ zaa musu!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À a táaki lɛ́, a malaikanↄ á pínki!","poem":1},{"lineBreak":true},{"text":"À a táaki lɛ́, a ìbanↄ á pínki!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À a táaki lɛ́, ifãntɛ̃ kũ mↄvuraao!","poem":1},{"lineBreak":true},{"text":"À a táaki lɛ́, susunɛ ínnanↄ pínki!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À à táaki lɛ́, sarapura musumusu pↄ́nↄ","poem":1},{"lineBreak":true},{"text":"kũ í kũ à kú ludambɛlanↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ò Dikiri tↄ́ bo,","poem":1},{"lineBreak":true},{"text":"zaakũ à yã ò, akũ ò kun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À ń pɛpɛ ń pɛ́pɛkia","poem":1},{"lineBreak":true},{"text":"de ògↄ̃ kú gwe gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"à doka dìtɛńnɛ, oni fↄ̃ ò vĩalaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À Dikiri táaki lɛ́, pↄ́ kũ ò kú zĩtɛnↄ,","poem":1},{"lineBreak":true},{"text":"kpↄ̀ gbɛ̃̀ntɛ̃nↄ kũ ísira lↄ̀nↄ","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kũ legũpinaao kũ legũgbɛɛo kũ legũsisinaao","poem":1},{"lineBreak":true},{"text":"kũ zàga'ĩa kũ àdi mìi natɛ a yãnɛɛo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kũ kpinↄ kũ sĩ̀sĩnↄ pínki","poem":1},{"lineBreak":true},{"text":"kũ lí nɛ́'irinↄ kũ sida línↄ pínki,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"kũ nↄ̀bↄsɛ̃ntɛnↄ kũ pↄ́kãdenↄ pínki","poem":1},{"lineBreak":true},{"text":"kũ pↄ́ kũ òdi táa o kũ kùaonↄ kũ bãnↄ,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"kũ andunia kínanↄ kũ burinↄ pínki","poem":1},{"lineBreak":true},{"text":"kũ kínanɛnↄ kũ bùsu gbãnadenↄ ń pínki,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"kũ kɛfɛnnanↄ kũ nↄkparenↄ ń pínki","poem":1},{"lineBreak":true},{"text":"kũ gbɛ̃ zↄ̃kↄ̃nↄ kũ nɛ́ fítinↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ò Dikiri tↄ́ bo,","poem":1},{"lineBreak":true},{"text":"zaakũ a mɛ̀n do tↄ́ mɛ́ à zↄ̃kↄ̃,","poem":1},{"lineBreak":true},{"text":"a gakuri de musu kũ zĩtɛola.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À kína kà a gbɛ̃nↄnɛ,","poem":1},{"lineBreak":true},{"text":"kũ a yãmarinↄ dì a táaki lɛ́,","poem":1},{"lineBreak":true},{"text":"Isaraila kũ ò kãni kãaonↄ.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}