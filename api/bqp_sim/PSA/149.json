i kɛ ń wutɛbↄↄ musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Luda táakilɛna gↄ̃ da ń lɛ́n,","poem":1},{"lineBreak":true},{"text":"fɛ̃nɛda lɛ́kpaplade gↄ̃ na ń ↄĩ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"de ò mↄra káo burinↄa,","poem":1},{"lineBreak":true},{"text":"ò bùsu sĩnda pínki gbɛ̃nↄ wɛ́ tão,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"de ò ń kínanↄ yĩyĩ kũ mↄ̀kakↄ̃ananↄ,","poem":1},{"lineBreak":true},{"text":"ò mↄ̀ ká ń kínɛnↄa,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"de ò yã dańla lákũ à kɛ̃na takada gũn nà.","poem":1},{"lineBreak":true},{"text":"Gakuri kũ Dikiri yãmarinↄ ni len gwe.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}