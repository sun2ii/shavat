{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":16,"content":[{"type":"heading","content":["Nana Ludai aduaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Ǹ ma dãkpã Luda, mↄkↄ̃n ma nanyĩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma pì Dikirinɛ: Mↄkↄ̃mmɛ ma Dikiri ũ,","poem":1},{"lineBreak":true},{"text":"n baasiro má pↄ́ mana ke vĩro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N gbɛ̃ kũ ò kú bùsu dí gũnnↄ,","poem":1},{"lineBreak":true},{"text":"mↄ́kↄ̃nↄmɛ gakuride kũ ò kàmagunↄ ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kũ òdi wã ò gɛ́ tãna kĩnaanↄ","poem":1},{"lineBreak":true},{"text":"dì yã'ũmmana kpá ń zĩdaimɛ.","poem":1},{"lineBreak":true},{"text":"Mani sa'o'aru kↄ́tɛ kũńworo,","poem":1},{"lineBreak":true},{"text":"oni ń tãnanↄ tↄ́ ma ma lɛ́nlo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dikiri, mↄkↄ̃mmɛ má n vĩ ndo,","poem":1},{"lineBreak":true},{"text":"n ma ka ma bakaaa,","poem":1},{"lineBreak":true},{"text":"ma wɛ̃̀ndi kú n ↄĩmɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N zĩtɛ lɛ́zɛkinↄ dàmɛnɛ gu mana gũn,","poem":1},{"lineBreak":true},{"text":"gba kũ n dàmɛnɛ kàmagu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mani Dikiri sáabu kpá kũ àdi lɛ́ dama yãi,","poem":1},{"lineBreak":true},{"text":"bee gwãani àdi tó ma swɛ̃̀ ma gba laakarii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Madìgↄ̃ Dikiri e ma wɛ́n baala'i,","poem":1},{"lineBreak":true},{"text":"lákũ à kú ma ↄplai nà, pɛ́ke ni ma lukaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Abire yãi ma pↄ dìgↄ̃ nna,","poem":1},{"lineBreak":true},{"text":"ma nɛ̀sɛgũn pù.","poem":1},{"lineBreak":true},{"text":"Má tãmaa vĩ kũ ma mɛ̀ nigↄ̃ kun,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"zaakũ ĩni ma tó mira gũnlo,","poem":1},{"lineBreak":true},{"text":"ĩni we n gbɛ̃ kũ à kú adona yagi kũro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ma da wɛ̃̀ndi zɛ́a,","poem":1},{"lineBreak":true},{"text":"ma pↄnna nigↄ̃ pana n kĩnaa,","poem":1},{"lineBreak":true},{"text":"pↄ́ mananↄ nigↄ̃ kú n ↄĩ gↄrↄ sĩnda pínki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}