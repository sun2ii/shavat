{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":17,"content":[{"type":"heading","content":["Taarisaride aduakɛnaa"]},{"type":"hebrew_subtitle","content":["Dauda aduakɛnaa"]},{"type":"verse","number":1,"content":[{"text":"Dikiri, ǹ ma yãzɛde ma,","poem":1},{"lineBreak":true},{"text":"ǹ sã kpá ma wikilɛnaai,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ́kɛna sí,","poem":1},{"lineBreak":true},{"text":"zaakũ matɛn kɛ kũ manafikioro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N kĩnaan mani yã nna len,","poem":1},{"lineBreak":true},{"text":"n wɛ́ tɛn yã kũ à zɛ́ vĩ e sãnsãn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ma swɛ̃̀ɛ gwà, n wɛ́ tɛ́mai gwãani,","poem":1},{"lineBreak":true},{"text":"n ma tàasii kà, ńdi yãke emaro,","poem":1},{"lineBreak":true},{"text":"zaakũ ma zɛo kũ ma lɛ́ ni ma kari boro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Madì tɛ́ bisãsiri yãkɛnanↄiro,","poem":1},{"lineBreak":true},{"text":"madì gbɛ̃ pãsĩnↄ turuba sɛ́ro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma kure n zɛ́n súsu,","poem":1},{"lineBreak":true},{"text":"mádi pã n yãnɛro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Matɛn lɛ́ zunyĩ, zaakũ ĩni wema.","poem":1},{"lineBreak":true},{"text":"Luda, ǹ sã kpá ma aduakɛnaai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ n gbɛ̃kɛ yãbonsarɛ kɛmɛnɛ,","poem":1},{"lineBreak":true},{"text":"ǹ gbɛ̃ kũ ò nànyĩnↄ bo ń ibɛrɛnↄ ↄĩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ laakari dↄma lán n wɛ́nɛ bà,","poem":1},{"lineBreak":true},{"text":"ǹ ma sↄtↄ n orun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ ma sí gbɛ̃ pãsĩ kũ òdi wari dↄmanↄa,","poem":1},{"lineBreak":true},{"text":"ma ibɛrɛ kũ ò likanamai pìnↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Òdi gbɛ̃ke wɛ́ gwaro,","poem":1},{"lineBreak":true},{"text":"ń lɛ́ dì zĩda sɛna lei yã o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ò pɛ̀tɛmai ò lìkamai,","poem":1},{"lineBreak":true},{"text":"ò wɛ́ pìtima de ò le ò ma pãtɛ zĩtɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ò ye ò ma kɛ yákiyaki","poem":1},{"lineBreak":true},{"text":"lákũ músu nàdɛri dì kɛ nà,","poem":1},{"lineBreak":true},{"text":"lán músu kũ à natɛna gukpado bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dikiri, ǹ futɛ ǹ dańlɛ ǹ ń nɛ,","poem":1},{"lineBreak":true},{"text":"ǹ ma sí gbɛ̃ pãsĩnↄa kũ n fɛ̃nɛdao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹ ma bo ń ↄĩ kũ n gbãnao.","poem":1},{"lineBreak":true},{"text":"Ń baka kú andunia díkĩna gũn,","poem":1},{"lineBreak":true},{"text":"ń aruzɛkɛ dìgↄ̃ dińyĩ, ń nɛ́nↄ dì kã,","poem":1},{"lineBreak":true},{"text":"òdi pↄ́ kũ à dìńyĩnↄ kátɛ ń nɛ́nↄnɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Makũ sↄ̃, mani wɛ́ kɛ pla kũnwo ma nɛ̀sɛmana yãi,","poem":1},{"lineBreak":true},{"text":"tó ma n e ma vugↄrↄa, abirekũ ni ma kã.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}