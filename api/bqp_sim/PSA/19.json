{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":19,"content":[{"type":"heading","content":["Ludambɛ gakuri kũ Luda yã gakurio"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Musu dì Luda gakuri bo gupuraa,","poem":1},{"lineBreak":true},{"text":"sarapurapↄnↄ dì a ↄzĩ mↄńnɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Àdigↄ̃ yã o'ońnɛ lán gu dìgↄ̃ dↄ nà,","poem":1},{"lineBreak":true},{"text":"àdi dↄ̃na kpáńnɛ gwãani kũ gwãanio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Àdi yã oro, a yã'ona buri ke kunlo,","poem":1},{"lineBreak":true},{"text":"òdi a kĩni maro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A kòtoo dì da anduniala pínki,","poem":1},{"lineBreak":true},{"text":"a yã'onaa dì gɛ́ ari zĩtɛ lɛ́a.","poem":1},{"lineBreak":true},{"text":"Luda kpɛ́ bò ifãntɛ̃nɛ gwe,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"àdi bo kpɛ́n à futɛ lán nↄsɛrii bà,","poem":1},{"lineBreak":true},{"text":"àdi futɛ táo kũ pↄnnao lán gↄ̃sa gbãna bà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Àdi futɛ ludambɛlɛa la,","poem":1},{"lineBreak":true},{"text":"àdi bikũ à gɛ́ ari a lɛ́a dire,","poem":1},{"lineBreak":true},{"text":"pↄ́ke dìgↄ̃ utɛna a puusuiro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dikiri doka papana,","poem":1},{"lineBreak":true},{"text":"àdi ń kunna kɛkɛ à kɛńnɛ dↄ.","poem":1},{"lineBreak":true},{"text":"Dikiri yã náani vĩ,","poem":1},{"lineBreak":true},{"text":"àdi lɛ́ da ↄ̃ndↄ̃saridenↄa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dikiri dì ↄdↄki dↄńnɛ súsu,","poem":1},{"lineBreak":true},{"text":"àdi ń pↄ kɛ nna.","poem":1},{"lineBreak":true},{"text":"Dikiri yãditɛnanↄn gbãsĩ vĩro,","poem":1},{"lineBreak":true},{"text":"àdi ń ãn wereńnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mìnatɛna Dikirinɛ zɛ́ pì wɛ́bona,","poem":1},{"lineBreak":true},{"text":"onigↄ̃ tɛ́i gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"Dikiri yãkpatɛkɛna yãpura vĩ,","poem":1},{"lineBreak":true},{"text":"àdigↄ̃ mana swáswa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A mana de wurala, bee wura mana,","poem":1},{"lineBreak":true},{"text":"a nna de zↄ́'ila, bee zↄ́ búsu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Abire musu ndì lɛ́ da makũ n zↄ̀bleriia,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ à n yã kũnaa àree dìgↄ̃ zↄ̃kↄ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dí mɛ́ ani fↄ̃ à yã kũ à zã̀anↄ dↄ̃ↄ?","poem":1},{"lineBreak":true},{"text":"Ǹ sùru kɛ kũmao kũ ma taari kũ ò utɛnanↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ǹsun tó makũ n zↄ̀bleri taari kɛnnɛ gbĩnigbĩniro,","poem":1},{"lineBreak":true},{"text":"ǹsun tó durunnanↄ kí blemaro,","poem":1},{"lineBreak":true},{"text":"manigↄ̃ kun swáswa taari zↄ̃kↄ̃ sari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ǹ tó yã kũ àtɛn bo ma lɛ́n kángu","poem":1},{"lineBreak":true},{"text":"kũ laasun kũ à kú ma swɛ̃̀ɛ gũnwo,","poem":1},{"lineBreak":true},{"text":"Dikiri, ma gbɛ̀si, ma surabarii.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}