{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":2,"content":[{"type":"heading","content":["Kína kũ Luda kà"]},{"type":"verse","number":1,"content":[{"text":"Bↄ́yãi burinↄ tɛn zuka káa?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dera òtɛn lɛ́ pã kpákũsũu?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Andunia kínanↄ tɛn zĩ̀ soru kɛ,","poem":1},{"lineBreak":true},{"text":"kpatablerinↄ tɛn kakara Dikirii","poem":1},{"lineBreak":true},{"text":"kũ Kína kũ à kào.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Òtɛn pi: Ò ń mↄ̀kakↄ̃ananↄ kɛ̃kɛ̃,","poem":1},{"lineBreak":true},{"text":"ò ń bàa porowá.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dikiri tɛni ń fobo,","poem":1},{"lineBreak":true},{"text":"à vutɛna musu, àtɛni ń yáa dↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Àtɛn pataḿma kũ pↄfɛ̃o,","poem":1},{"lineBreak":true},{"text":"a pɛ̃tɛ̃ dì ń gba vĩna.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À pì a a Kína kà a kpi Zaiↄ̃ musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mani yã kũ Dikiri dìtɛmɛnɛ o kũ à pì:","poem":1},{"lineBreak":true},{"text":"Ma Nɛ́mɛ n ũ, gbãran ma n i.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ wɛ́ kɛma,","poem":1},{"lineBreak":true},{"text":"mani buri sĩnda pínki kpámma n pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"mani n gba andunia kusuru siikↄ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ĩni kí bleḿma kũ mↄ̀ gòoo,","poem":1},{"lineBreak":true},{"text":"ĩni ń wíwi lákũ òdi oro wíwi nà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kínanↄ, à lɛ́damma díkĩna ma,","poem":1},{"lineBreak":true},{"text":"andunia kpatablerinↄ, à ↄ̃ndↄ̃ kũ sà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"À do Dikirii kũ vĩnao,","poem":1},{"lineBreak":true},{"text":"à pↄnna kɛo kũ lukanaao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À lɛ́ pɛ́ a Nɛ́a","poem":1},{"lineBreak":true},{"text":"de a pↄ sún fɛ̃ái à gaga zɛ́nlo,","poem":1},{"lineBreak":true},{"text":"zaakũ a pↄ dì fɛ̃ kãntomɛ.","poem":1},{"lineBreak":true},{"text":"Arubarikaden gbɛ̃ kũ à nài ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}