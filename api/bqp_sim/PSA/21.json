{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":21,"content":[{"type":"heading","content":["Zĩ̀ble sáabukpana"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri, kína tɛn pↄnna kɛ kũ n gbãnao,","poem":1},{"lineBreak":true},{"text":"a pↄ nna manamana kũ n tò à zĩ̀i blè.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N pↄ́ kũ a pↄ yeii kpàa,","poem":1},{"lineBreak":true},{"text":"ńdi gí a wɛ́kɛna síiro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N daalɛ kũ arubarika zↄ̃kↄ̃ↄo,","poem":1},{"lineBreak":true},{"text":"n wura fùraa kùnɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À wɛ̃̀ndii gbɛ̀kamma, akũ n kpàa,","poem":1},{"lineBreak":true},{"text":"n tò àgↄ̃ kun ari gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A gakuri zↄ̃kↄ̃ kũ n tò à zĩ̀i blè,","poem":1},{"lineBreak":true},{"text":"n bɛ̀ɛrɛ kũ zↄ̃kↄ̃kɛo kpàa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndìgↄ̃ arubarika daagu gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"n kunna kãao tò a pↄ kɛ̀ nna.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zaakũ kína Dikiri náani kɛ̀,","poem":1},{"lineBreak":true},{"text":"kunna Luda Musude gbɛ̃kɛn ani yĩgãro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"N ↄ ni n ibɛrɛnↄ kũ ń pínki,","poem":1},{"lineBreak":true},{"text":"ĩni n zãngurinↄ kũ kũ n ↄplao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ĩni ń kɛ tãmatɛ yàka ũ n sugↄrↄa.","poem":1},{"lineBreak":true},{"text":"Dikiri ni ń kakatɛ a pↄfɛ̃gↄrↄa,","poem":1},{"lineBreak":true},{"text":"ani tó tɛ́ ń ble.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ĩni ń nɛ́nↄ dɛdɛ andunia gũn,","poem":1},{"lineBreak":true},{"text":"ĩni ń burinↄ kɛ̃ bisãsirinↄa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bee tó ò lɛ́ kpàkũsũnyĩ,","poem":1},{"lineBreak":true},{"text":"ń pↄyeinayã ni zĩ kɛro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ĩni kà dↄdↄ ń wɛ́a,","poem":1},{"lineBreak":true},{"text":"ĩni tó ò kpɛ li.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"N gbãnakɛ gũn, Dikiri, ǹ n zĩda sɛ́ lei,","poem":1},{"lineBreak":true},{"text":"óni lɛ̀ sí ò n zↄ̃kↄ̃kɛ sáabu kpá.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}