{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":23,"content":[{"type":"heading","content":["Dikirimɛ ma dã̀ri ũ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikirimɛ ma dã̀ri ũ,","poem":1},{"lineBreak":true},{"text":"pↄ́ke ni kĩamaro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Àdi ma wútɛ sɛ̃̀la bↄ̀tↄnↄn,","poem":1},{"lineBreak":true},{"text":"àdi gɛ́ kũmao í katɛna kítikiti sarɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Àdi ma kunna kɛkɛ dↄ,","poem":1},{"lineBreak":true},{"text":"àdi domɛnɛ arɛ zɛ́ mananↄ gũn a tↄ́bona yãi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bee tó ma táa ò guvutɛ sira pãsĩn,","poem":1},{"lineBreak":true},{"text":"mani yã vãni vĩna kɛro, zaakũ ń kú kũmao,","poem":1},{"lineBreak":true},{"text":"n sári kũ n gòo dì ma laakari kpátɛmɛnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndì pↄ́ble kátɛ ma arɛ ma ibɛrɛnↄ wára,","poem":1},{"lineBreak":true},{"text":"ndì nísi gbĩnnade kú ma mìia,","poem":1},{"lineBreak":true},{"text":"ndì í ká ma tokon ari à pa yɛ́rɛrɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yãpura Dikiri gbɛ̃kɛ kũ a yenyĩo nigↄ̃ kú kũmao gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"manigↄ̃ kú a ↄnn ari ma wɛ̃̀ndi lɛ́n.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}