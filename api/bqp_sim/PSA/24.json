{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":24,"content":[{"type":"heading","content":["Dikiri gɛ̃na a kpɛ́ gũn"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Zĩtɛ kũ pↄ́ kũ ò kúnnↄ bi Dikiri pↄ́mɛ,","poem":1},{"lineBreak":true},{"text":"andunia kũ gbɛ̃ kũ ò kúnↄ ń pínki.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À zĩtɛ zĩni pɛ̀tɛ ísiran,","poem":1},{"lineBreak":true},{"text":"à andunia kàtɛ kũ swanↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dí mɛ́ à zɛ́ vĩ à didi Dikiri kpiaa?","poem":1},{"lineBreak":true},{"text":"Dí mɛ́ ani fↄ̃ à gɛ̃ a ↄnnn?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kũ à taari vĩro akũsↄ̃ a nɛ̀sɛ mana,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ a laakari dì tá tãnanↄ kparo","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ àdi sí kũ tãna tↄ́oro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dikiri ni arubarika da adegu,","poem":1},{"lineBreak":true},{"text":"Luda a surabari ni tó yã bo kãao nna.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lɛn à de lɛ kũ a ki wɛtɛrinↄ,","poem":1},{"lineBreak":true},{"text":"Yakubu burinↄ Luda arɛ wɛtɛrinↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À bĩnilɛnↄ wɛ̃wɛ̃,","poem":1},{"lineBreak":true},{"text":"à gbà zĩnↄ wɛ̃wɛ̃,","poem":1},{"lineBreak":true},{"text":"à tó Kína gakuride gɛ̃.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dímɛ Kína gakuride pì ũu?","poem":1},{"lineBreak":true},{"text":"Dikiri gbãnazↄ̃kↄ̃demɛ,","poem":1},{"lineBreak":true},{"text":"àkũmɛ Dikiri zĩ̀kari gbãnade pì ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À bĩnilɛnↄ wɛ̃wɛ̃,","poem":1},{"lineBreak":true},{"text":"à gbà zĩnↄ wɛ̃wɛ̃,","poem":1},{"lineBreak":true},{"text":"à tó Kína gakuride gɛ̃.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dín Kína gakuride pì ũu?","poem":1},{"lineBreak":true},{"text":"Dikiri Zĩ̀karidemɛ Kína gakuride pì ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}