{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":25,"content":[{"type":"heading","content":["Luda ó dãkpãrii"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri, ma a swɛ̃̀ɛ kpàmma,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma Luda, matɛni n náani kɛ,","poem":1},{"lineBreak":true},{"text":"ǹsun tó wé'i ma kũro,","poem":1},{"lineBreak":true},{"text":"ǹsun tó ma ibɛrɛnↄ ma nɛro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wé'i ni gbɛ̃ kũ ò wɛ́ dↄnyĩnↄ kũ zikiro,","poem":1},{"lineBreak":true},{"text":"sé gbɛ̃ kũ ò bò n kpɛ sèeda ke sarinↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dikiri, ǹ n zɛ́ mↄmɛnɛ,","poem":1},{"lineBreak":true},{"text":"ǹ n yã dadamɛnɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ǹ ma da n yãpura zɛ́n,","poem":1},{"lineBreak":true},{"text":"ǹ a yã dadamɛnɛ,","poem":1},{"lineBreak":true},{"text":"zaakũ Luda ma surabariimɛ n ũ,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ dìgↄ̃ dↄnyĩmɛ gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N wɛ̃nda kũ n yenyĩo gↄ̃ dↄngu,","poem":1},{"lineBreak":true},{"text":"zaakũ abirekũnↄ kú kũnwo zaa zĩ, Dikiri.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹsun taari kũ ma kɛ̀nↄ yã daro","poem":1},{"lineBreak":true},{"text":"ke durunna kũ ma kɛ̀ ma kɛfɛnnakɛgↄrↄanↄ.","poem":1},{"lineBreak":true},{"text":"Ǹ tó ma yã gↄ̃ dↄngu yenyĩ gũn,","poem":1},{"lineBreak":true},{"text":"kũ ń mana yãi, Dikiri.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dikiri mana, àdi yã kɛ a zɛ́a,","poem":1},{"lineBreak":true},{"text":"abire yãi àdi a yã dada durunnakɛrinↄnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Àdi zĩdabusarinↄ da a zɛ́a,","poem":1},{"lineBreak":true},{"text":"àdi yã mana dadańnɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dikiri dìgↄ̃ yenyĩ kũ náanio vĩ","poem":1},{"lineBreak":true},{"text":"kũ gbɛ̃ kũ ò a bàka kunna kũńwo yã kũnanↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bee kũ ma durunna zↄ̃kↄ̃ Dikiri,","poem":1},{"lineBreak":true},{"text":"ǹ kɛ̃ma n tↄ́bona yãi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dí mɛ́ à Dikiri vĩna vĩi?","poem":1},{"lineBreak":true},{"text":"Dikiri dì ade da zɛ́ kũ à de à sɛ́a.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ade nigↄ̃ kú nnamanaa gũn,","poem":1},{"lineBreak":true},{"text":"a burinↄ mɛ́ onigↄ̃ ń bùsu vĩ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dikiri nna kũ a vĩnakɛrinↄ,","poem":1},{"lineBreak":true},{"text":"àdi tó ògↄ̃ a bàka kunna kũńwo yã dↄ̃.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma wɛ́ dìgↄ̃ dↄ Dikiria baala'i,","poem":1},{"lineBreak":true},{"text":"àkũ mɛ́ àdi ma gbá bo bàn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ǹ arɛ dↄma, ń ma wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"zaakũ má kú mado wɛ́tãmma gũn.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma yã'ũmmananↄ kàra ma nɛ̀sɛɛ gũn,","poem":1},{"lineBreak":true},{"text":"ǹ ma bo ma wari pìn.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ǹ ma wɛ́tãmma kũ ma pↄsirao gwa,","poem":1},{"lineBreak":true},{"text":"ǹ ma durunnanↄ kɛ̃ma pínki.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ǹ gwa lákũ ma ibɛrɛnↄ dàgula nà,","poem":1},{"lineBreak":true},{"text":"ò zã̀magu pãsĩpãsĩ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ǹ ma wɛ̃̀ndi dãkpã, ń ma sura ba,","poem":1},{"lineBreak":true},{"text":"ǹsun tó wé'i ma kũro, zaakũ ma nanyĩ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ǹ tó yãpura kũ kunna manao gↄ̃ ma dãkpã,","poem":1},{"lineBreak":true},{"text":"zaakũ ma wɛ́ dìgↄ̃ dↄnyĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Luda, ǹ Isarailanↄ bo ń warikɛnanↄn pínki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}