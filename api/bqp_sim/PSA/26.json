{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":26,"content":[{"type":"heading","content":["Gbɛ̃ mana aduakɛnaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Ǹ yã nna kpáma Dikiri,","poem":1},{"lineBreak":true},{"text":"zaakũ ma yã kɛ̀ a zɛ́a,","poem":1},{"lineBreak":true},{"text":"ma n náani kɛ̀ sikaa sari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ ma yↄ̃ ǹ ma gwa Dikiri,","poem":1},{"lineBreak":true},{"text":"ń ma nɛ̀sɛ kũ ma laasunnↄ gwa,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"zaakũ n yenyĩ dìgↄ̃ domɛnɛ arɛ,","poem":1},{"lineBreak":true},{"text":"madì zĩ kɛ n yãpuraa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Madì vutɛ kũ ɛ́kɛdenↄoro,","poem":1},{"lineBreak":true},{"text":"madì gɛ̃ manafikidenↄ tɛ́ro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma zã durunnakɛrinↄ kↄ̃kakaranan,","poem":1},{"lineBreak":true},{"text":"madì vutɛ kũ gbɛ̃ vãninↄoro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma ↄ pìpi ma taarisarikɛ sèeda ũ,","poem":1},{"lineBreak":true},{"text":"matɛn lika n gbagbakii, Dikiri,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"de mà le mà n sáabu kpá lɛ̀sinaa gũn,","poem":1},{"lineBreak":true},{"text":"mà n yãbonsarɛnↄ kpàkpa kɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dikiri, má ye n kpɛ́ kũ ndìgↄ̃ kunyĩ,","poem":1},{"lineBreak":true},{"text":"gu kũ n gakuri dì kipan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ǹsun ma kakara kũ durunnakɛrinↄoro,","poem":1},{"lineBreak":true},{"text":"ǹsun ma baka kakara kũ gbɛ̃dɛrinↄ pↄ́oro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Laasun vãni mɛ́ àdigↄ̃ dońnɛ arɛ,","poem":1},{"lineBreak":true},{"text":"ń ↄ dìgↄ̃ pa kũ ↄdↄnkpɛgbanↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Makũ sↄ̃, madì yã kɛ a zɛ́a,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ̃nda gwa, ń ma sura ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ma zɛki è gu manan,","poem":1},{"lineBreak":true},{"text":"mani Dikiri sáabu kpá pari kↄ̃kakaranaa gũn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}