{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":27,"content":[{"type":"heading","content":["Dikirimɛ ma gupura ũ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikirimɛ ma gupura ũ kũ ma surabariio,","poem":1},{"lineBreak":true},{"text":"dín mani vĩna kɛnɛɛ?","poem":1},{"lineBreak":true},{"text":"Dikirimɛ ma utɛki ũ,","poem":1},{"lineBreak":true},{"text":"dí vĩnan mani kɛɛ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃ vãninↄ sìmagu de ò ma kɛ yákiyaki","poem":1},{"lineBreak":true},{"text":"ke tó ma ibɛrɛnↄ kũ ma zãngurinↄ lɛ̀tɛma,","poem":1},{"lineBreak":true},{"text":"ò gɛ̃̀ sí ò lɛ́tɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bee tó zĩ̀karinↄ lìkamai,","poem":1},{"lineBreak":true},{"text":"ma kù ni vĩro,","poem":1},{"lineBreak":true},{"text":"bee tó gbɛ̃nↄ fùtɛma kũ zĩ̀io,","poem":1},{"lineBreak":true},{"text":"ma laakari nigↄ̃ kpatɛna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yã mɛ̀n don matɛn gbɛka Dikiria,","poem":1},{"lineBreak":true},{"text":"yã pìn matɛn wɛtɛ manamana.","poem":1},{"lineBreak":true},{"text":"Má ye màgↄ̃ kú Dikiri ↄnn ari ma wɛ̃̀ndi lɛ́n,","poem":1},{"lineBreak":true},{"text":"de mà le màgↄ̃ a arɛ wɛtɛ a kpɛ́n gwe,","poem":1},{"lineBreak":true},{"text":"má wɛ́ dↄ a manakɛnaai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ani ma utɛ a kpɛ́n warikɛgↄrↄa,","poem":1},{"lineBreak":true},{"text":"ani ma gwa a bizakutan,","poem":1},{"lineBreak":true},{"text":"ani ma zɛ gbɛ̀ɛ musu aafia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma mì ni bo ma ibɛrɛ kũ ò likamainↄ pↄ́la,","poem":1},{"lineBreak":true},{"text":"má sa o Dikiri ↄnn kũ ayuwiikɛnaao,","poem":1},{"lineBreak":true},{"text":"má lɛ̀ sí mà a sáabu kpá.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tó ma n sisi Dikiri, ǹ wema,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ̃nda gwa, ń ma yã ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma nɛ̀sɛ tɛn lɛ́ dama mà n arɛ wɛtɛ,","poem":1},{"lineBreak":true},{"text":"Dikiri, matɛni n arɛ wɛtɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹsun n mìkpɛrɛ zu makũ n zↄ̀bleriinɛro,","poem":1},{"lineBreak":true},{"text":"ǹsun kpɛ dↄmɛnɛ kũ pↄfɛ̃oro.","poem":1},{"lineBreak":true},{"text":"Ma kpanyĩriimɛ n ũ, ǹsun ma zukũnaro,","poem":1},{"lineBreak":true},{"text":"Luda ma surabarii, ǹsun ma tónlo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó ma de kũ ma dao pã kpàmai,","poem":1},{"lineBreak":true},{"text":"Dikiri ni ↄ likamai.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dikiri, ǹ ma da n zɛ́a,","poem":1},{"lineBreak":true},{"text":"ǹ domɛnɛ arɛ zɛ́ súsu gũn ma wɛ́tãmmarinↄ yãi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹsun tó ma ibɛrɛnↄ pↄyeina kɛmɛnɛro,","poem":1},{"lineBreak":true},{"text":"zaakũ sèeda ɛ́kɛdenↄ tɛn yã dima,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ pãsĩnↄ tɛn yĩ fɛ̃ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Má yã díkĩna náanikɛna,","poem":1},{"lineBreak":true},{"text":"kũ Dikiri ni yã mana kɛmɛnɛ andunia díkĩna gũn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹ wɛ́ dↄ Dikirii,","poem":1},{"lineBreak":true},{"text":"ǹ zɛ gbãna, ń laakari kpátɛ,","poem":1},{"lineBreak":true},{"text":"ǹ wɛ́ dↄ Dikirii.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}