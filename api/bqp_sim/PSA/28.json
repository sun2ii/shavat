vãnikɛnaao,","poem":1},{"lineBreak":true},{"text":"ǹ fĩna bońnɛ ń dàaa","poem":1},{"lineBreak":true},{"text":"de a gbɛ̀ wí ń musu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Òdi Dikiri yãkɛna kũ à zĩkɛnaao yã daro,","poem":1},{"lineBreak":true},{"text":"ani ń litɛ kpɛdangara, ani ń futɛ doro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Arubarikademɛ Dikiri ũ,","poem":1},{"lineBreak":true},{"text":"zaakũ à sã kpà ma wɛ̃nda wikilɛnaai.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dikirimɛ ma gbãna ũ kũ ma sɛ̃gbakoo,","poem":1},{"lineBreak":true},{"text":"má a náani vĩ ma swɛ̃̀n.","poem":1},{"lineBreak":true},{"text":"Àdi kpámai, ma pↄ dì kɛ nna,","poem":1},{"lineBreak":true},{"text":"madì a sáabu kpá kũ lɛ̀sinaao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dikirimɛ a gbɛ̃nↄ gbãna ũ,","poem":1},{"lineBreak":true},{"text":"à de utɛki ũ kína kũ à kàanɛ, àdi a sura ba.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ n gbɛ̃nↄ sura ba ǹ arubarika dańgu,","poem":1},{"lineBreak":true},{"text":"ǹ ń dãkpã ǹgↄ̃ ń kũna gↄrↄ sĩnda pínki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}