ikiri dì Lɛbana bùsu sida línↄ para.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Àdi tó Lɛbana kpinↄ vĩvĩ lán zùnɛ bà,","poem":1},{"lineBreak":true},{"text":"Ɛmↄ gbɛ̀ sↄ̃ lán zùsanɛ bↄ̀rↄↄ bà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dikiri kòtoo dì bo kũ legũpinanↄ,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dikiri kòtoo dì gbáranna yĩgãyĩgã,","poem":1},{"lineBreak":true},{"text":"Dikiri dì Kadɛsi gbáranna yĩgãyĩgã.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dikiri kòtoo dì línↄ yĩgãyĩgã,","poem":1},{"lineBreak":true},{"text":"àdi líkpɛnↄ pura kũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ ò kú à ↄnnↄ tɛn pinɛ,","poem":1},{"lineBreak":true},{"text":"Gakuridemɛ a ũ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dikiri kú í kũ à da anduniala musu,","poem":1},{"lineBreak":true},{"text":"Dikiri vutɛna Kína ũ gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dikiri dì a gbɛ̃nↄ gba gbãna,","poem":1},{"lineBreak":true},{"text":"Dikiri dì arubarika dańgu ògↄ̃ aafia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}