{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":30,"content":[{"type":"heading","content":["Dikiri sáabukpanaa"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kũ Dauda dà Luda ↄn sakɛna yãi."]},{"type":"verse","number":1,"content":[{"text":"Mani n tↄ́ sɛ́ lei Dikiri,","poem":1},{"lineBreak":true},{"text":"zaakũ n ma kara,","poem":1},{"lineBreak":true},{"text":"ńdi tó ma ibɛrɛnↄ ma nɛro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dikiri ma Luda, ma ↄ́ↄ dↄ̀nnɛ,","poem":1},{"lineBreak":true},{"text":"akũ n ma gba aafia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dikiri, n ma si miraa,","poem":1},{"lineBreak":true},{"text":"ńdi tó ma si gyãwãnnlo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dikiri gbɛ̃nↄ, à a tↄ́ kpá,","poem":1},{"lineBreak":true},{"text":"à a tↄ́ kũ à kú adona sáabu kpá.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zaakũ a pↄfɛ̃naa dì la kũ lao lero,","poem":1},{"lineBreak":true},{"text":"à arubarika mɛ́ àdigↄ̃ kun ari gbɛ̃ wɛ̃̀ndi lɛ́n.","poem":1},{"lineBreak":true},{"text":"Ɔ́ↄdↄnaa dìgↄ̃ kun gwãani,","poem":1},{"lineBreak":true},{"text":"akũ gu dì dↄ kũ pↄnnao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kũ má kú nnamanaa gũn ma pì:","poem":1},{"lineBreak":true},{"text":"Mani kpágula zikiro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dikiri, kũ n arubarikaa dàmagu,","poem":1},{"lineBreak":true},{"text":"n ma zɛ gíngin lán kpi bà.","poem":1},{"lineBreak":true},{"text":"Ama kũ n kpɛ lìmɛnɛ,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ bídi gũn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mↄkↄ̃n Dikiri, ma n sisi,","poem":1},{"lineBreak":true},{"text":"ma kútɛ kɛ̀ ma dikiriinɛ ma pì:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bↄ́ àreen ma gana ke ma sina gyãwãn vĩi?","poem":1},{"lineBreak":true},{"text":"Ma mira ni n tↄ́ kpán yá?","poem":1},{"lineBreak":true},{"text":"Ani n náani kpàkpa kɛn yá?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹ ma yã ma Dikiri ǹ ma wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"Dikiri, ǹgↄ̃ de ma kpanyĩri ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"N ma ↄ́ↄdↄnaa lìtɛ ũwãna ũ,","poem":1},{"lineBreak":true},{"text":"n ma uta kasanↄ bↄ̀tɛma,","poem":1},{"lineBreak":true},{"text":"n pↄnna dàmɛnɛ pↄ́kasa ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Manigↄ̃ yĩtɛnaro, manigↄ̃ n tↄ́ kpámɛ,","poem":1},{"lineBreak":true},{"text":"Dikiri ma Luda,","poem":1},{"lineBreak":true},{"text":"manigↄ̃ n sáabu kpá gↄrↄ sĩnda pínki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}