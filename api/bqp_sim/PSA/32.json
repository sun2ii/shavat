{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":32,"content":[{"type":"heading","content":["Durunna'ona Ludanɛ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Arubarikademɛ gbɛ̃ kũ Luda a taarinↄ tònɛ","poem":1},{"lineBreak":true},{"text":"à a durunnanↄ kɛ̃̀nɛ ũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Arubarikademɛ gbɛ̃ kũ Dikiri dì a durunna yã daro ũ,","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ manafiki kú à nɛ̀sɛɛ gũnlo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kũ ma yĩtɛ kũ ma durunnao, ma fɛ̃fɛ̃,","poem":1},{"lineBreak":true},{"text":"ma wiki dìgↄ̃ dↄ zaa kↄnkↄ ari ↄkↄsi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N ↄ dìgↄ̃ tↄ̃nama fãnantɛ̃ kũ gwãanio,","poem":1},{"lineBreak":true},{"text":"ma gbãna làka lákũ guwãnagↄrↄ ifãntɛ̃ ma lɛ bà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Akũ ma wennɛ ma durunnai,","poem":1},{"lineBreak":true},{"text":"mádi ma yã vãni utɛnnɛ doro.","poem":1},{"lineBreak":true},{"text":"Ma pì, mani ma taarinↄ o Dikirinɛ,","poem":1},{"lineBreak":true},{"text":"akũ a ma durunna kɛ̃̀mɛnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Abire yãi n náanikɛri wɛ́ kɛmma a gↄrↄa,","poem":1},{"lineBreak":true},{"text":"tó kisira tɛn su, ani a lero.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma utɛkimɛ n ũ,","poem":1},{"lineBreak":true},{"text":"ndì ma bo wɛ́tãmmanaa gũn,","poem":1},{"lineBreak":true},{"text":"ndì likamai ǹ ma sura ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mani yã dannɛ mà n da zɛ́ kũ à de ǹ sɛ́a,","poem":1},{"lineBreak":true},{"text":"mani lɛ́ damma, ma wɛ́ gↄ̃ tɛ́nyĩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹsungↄ̃ kun laasunn sari","poem":1},{"lineBreak":true},{"text":"lán sↄ̃ ke baragbãsↄ̃ bàro,","poem":1},{"lineBreak":true},{"text":"tó ńdi sↄ̃mↄ káńnɛ kũ a bàaoro,","poem":1},{"lineBreak":true},{"text":"òdi da n dↄ̀rↄↄaro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yã'ũmmanaa dì da gbɛ̃ vãninↄla,","poem":1},{"lineBreak":true},{"text":"Dikiri yenyĩ dì lika a náanikɛrinↄa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gbɛ̃ mananↄ, à pↄnna kɛ Dikiri yãi,","poem":1},{"lineBreak":true},{"text":"nɛ̀sɛpuradenↄ, à ayuwii kɛ à yáa dↄ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}