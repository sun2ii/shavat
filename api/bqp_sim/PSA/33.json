{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":33,"content":[{"type":"heading","content":["Luda sáabukpanaa"]},{"type":"verse","number":1,"content":[{"text":"À ayuwii kɛ Dikirinɛ gbɛ̃ mananↄ,","poem":1},{"lineBreak":true},{"text":"à kũ̀ nɛ̀sɛpuradenↄ a sáabu kpá.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À Dikiri tↄ́ kpá kũ gidigboo,","poem":1},{"lineBreak":true},{"text":"à lɛ̀ sínɛ kũ mↄrↄↄo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À lɛ̀ dufu sínɛ,","poem":1},{"lineBreak":true},{"text":"à pↄ́'ũborinↄ lɛ́ kũ dↄ̃naao kũ pↄnna wikio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Zaakũ yã kũ Dikiri ò bi yãpuramɛ,","poem":1},{"lineBreak":true},{"text":"à náani vĩ a yãkɛnaa gũn pínki.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À ye yã manai kũ yãzɛdeo,","poem":1},{"lineBreak":true},{"text":"Dikiri yenyĩ andunia pà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dikiri yã'ona mɛ́ à musu kɛ̀,","poem":1},{"lineBreak":true},{"text":"a lɛ́'ĩa mɛ́ à musupↄnↄ pɛ̀pɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À í kàtɛ gu dokↄ̃nↄ, à gↄ̃̀ ísira ũ,","poem":1},{"lineBreak":true},{"text":"à ínↄ kàkara, à gↄ̃̀ í lòkoto ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Andunia gbɛ̃ sĩnda pínki, à vĩna kɛ Dikirinɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ bɛ̃nɛnↄ pínki, à mì natɛnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Zaakũ à yã ò, akũ andunia gↄ̃̀ katɛna,","poem":1},{"lineBreak":true},{"text":"à yã dìtɛ, akũ pↄ́ sĩnda pínki gↄ̃̀ kun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dikiri dì lɛ́ kũ burinↄ kpàkũsũ kɛ pã,","poem":1},{"lineBreak":true},{"text":"àdi kpá bùsudenↄnɛ kũ pↄ́ kũ òtɛn pɛ́aao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yã kũ Dikiri zɛ̀o dìgↄ̃ zɛna gíngin,","poem":1},{"lineBreak":true},{"text":"yã kũ à a pↄ gbà dìgↄ̃ kun gↄrↄ sĩnda pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Arubarikaden buri kũ Dikiri de a Luda ũ ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ à ń sɛ́ a pↄ́ ũnↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zaa musu Dikiri dì gu gwa zĩtɛ,","poem":1},{"lineBreak":true},{"text":"àdi bisãsirinↄ e ń pínki.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zaa gu kũ à kun àdi wɛ́ pã","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ ò kú andunia gũnnↄla ń pínki.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Àkũ mɛ́ à gbɛ̃ sĩnda pínki swɛ̃̀ɛ kɛ̀,","poem":1},{"lineBreak":true},{"text":"àdi ń yãkɛnanↄ dↄ̃ pínki.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kína ke dì zĩ̀ ble a zĩ̀kari gbãnanↄ yãiro,","poem":1},{"lineBreak":true},{"text":"zĩ̀kari ke dì bo a gↄ̃sagbãnakɛ yãiro.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sↄ̃ náanikɛna à n mì sí bi ɛ́kɛmɛ,","poem":1},{"lineBreak":true},{"text":"bee kũ a gbãnakɛnao ani fↄ̃ à gbɛ̃ sura baro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dikiri wɛ́ kú a vĩnakɛrinↄa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ ń wɛ́ dↄ a yenyĩanↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ani ń bo ga lɛ́i,","poem":1},{"lineBreak":true},{"text":"ani ń gwa nàgↄrↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ó wɛ́ dìgↄ̃ dↄ Dikirii,","poem":1},{"lineBreak":true},{"text":"àkũmɛ ó kpanyĩri ũ kũ ó sɛ̃gbakoo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Zaakũ Dikirin ó pↄ dìgↄ̃ nna kãao,","poem":1},{"lineBreak":true},{"text":"ó a tↄ́ kũ à kú adona náani vĩ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dikiri, ǹ tó n yenyĩ gↄ̃ kú kũoo","poem":1},{"lineBreak":true},{"text":"lákũ ó wɛ́ dↄnyĩ nà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}