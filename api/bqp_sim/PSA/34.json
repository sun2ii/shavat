{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":34,"content":[{"type":"heading","content":["Dikiri manakɛnaa"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kũ Dauda dà gↄrↄ kũ à a zĩda dìtɛ ĩade ũ Abimɛlɛki arɛ, ari Abimɛlɛki pɛ̀a à tà."]},{"type":"verse","number":1,"content":[{"text":"Manigↄ̃ Dikiri tↄ́ sɛ́ lei lakanaa sari,","poem":1},{"lineBreak":true},{"text":"manigↄ̃ a tↄ́ kpá lákũ gu dìgↄ̃ dↄ nà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Manigↄ̃ ĩa dã Dikiri yã musu,","poem":1},{"lineBreak":true},{"text":"takasidenↄ ni ma ò pↄnna kɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À zↄ̃kↄ̃kɛ dↄ̃ Dikirinɛ kũmao,","poem":1},{"lineBreak":true},{"text":"ò a tↄ́ bo lɛɛlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ma Dikiri ki wɛ̀tɛ, akũ à wèma,","poem":1},{"lineBreak":true},{"text":"à ma bo ma vĩnanↄ gũn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kũ ń wɛ́ dↄinↄ ãn nigↄ̃ werena,","poem":1},{"lineBreak":true},{"text":"wé'i ni ń kũ zikiro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃ takaside dí Dikiri sìsi, akũ à wèa,","poem":1},{"lineBreak":true},{"text":"à a bò a warinↄ gũn pínki.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dikiri Malaika dìgↄ̃ kú a vĩnakɛrinↄ sarɛ,","poem":1},{"lineBreak":true},{"text":"àdi ń mì sí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"À lɛ́ kɛ à gwa, áni dↄ̃ kũ Dikiri nna,","poem":1},{"lineBreak":true},{"text":"arubarikaden gbɛ̃ kũ à nài ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dikiri gbɛ̃nↄ, à vĩna kɛnɛ,","poem":1},{"lineBreak":true},{"text":"pↄ́ke dì kĩa à vĩnakɛrinↄaro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nà dì músunↄ dɛ, pↄ́ble dì kĩaḿma,","poem":1},{"lineBreak":true},{"text":"ama pↄ́ mana ke dì kĩa Dikiri ki wɛtɛrinↄaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gbɛ̃nↄ, à mↄ́ à ma yã ma,","poem":1},{"lineBreak":true},{"text":"mà vĩnakɛna Dikirinɛɛ dadaárɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ákↄ̃nↄ kũ á ye á wɛ̃̀ndi gↄ̃ mana","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ á ye á kunna gↄ̃ nna,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"à á lɛ́ kũ kũ yãvãni'onaao,","poem":1},{"lineBreak":true},{"text":"àsun tó ɛ́kɛ bo á lɛ́nlo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À kpɛ li yã vãninɛ à yã mana kɛ,","poem":1},{"lineBreak":true},{"text":"à aafia zɛ́ wɛtɛ àgↄ̃ tɛ́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dikiri dìgↄ̃ wɛ́ tɛ́ gbɛ̃ mananↄi,","poem":1},{"lineBreak":true},{"text":"àdi sã kpá ń ↄ́ↄdↄnaai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dikiri dì kpɛ li yãvãnikɛrinↄnɛ,","poem":1},{"lineBreak":true},{"text":"de ń yã sún dↄ gbɛ̃keguro yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tó gbɛ̃ mananↄ lɛ́ zù Dikirii, àdi ma,","poem":1},{"lineBreak":true},{"text":"àdi ń bo ń warinↄ gũn pínki.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dikiri kãni kũ gbɛ̃ kũ ń pↄ yàkanↄ,","poem":1},{"lineBreak":true},{"text":"àdi kpá gbɛ̃ kũ ń ãn sisinanↄi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wari dìgↄ̃ gbɛ̃ mana le gɛ̃̀n baaakↄ̃,","poem":1},{"lineBreak":true},{"text":"ama Dikiri dì a bo a gũn pínki.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Àdi a wánↄ dãkpã pínki,","poem":1},{"lineBreak":true},{"text":"a ke dì ɛ́ro, bee mɛ̀n do.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kisira ni gbɛ̃ vãninↄ dɛdɛ,","poem":1},{"lineBreak":true},{"text":"yã ni vutɛ gbɛ̃ mana ibɛrɛnↄa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dikiri dì a zↄ̀blerinↄ mì sí,","poem":1},{"lineBreak":true},{"text":"yã ni vutɛ gbɛ̃ kũ à naiaro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}