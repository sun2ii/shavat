{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":36,"content":[{"type":"heading","content":["Bisãsiri vãni"]},{"type":"hebrew_subtitle","content":["Dikiri zↄ̀bleri Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Gbɛ̃ vãni durunna yã dↄ ma swɛ̃̀ɛa,","poem":1},{"lineBreak":true},{"text":"à wɛ́ dìgↄ̃ Luda wé'i vĩro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zaakũ àdigↄ̃ a zĩda e gbɛ̃ mana ũmɛ,","poem":1},{"lineBreak":true},{"text":"àdi a durunna dↄ̃ gbasa à zãnlo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛ́kɛ kũ manafikio kú a lɛ́n,","poem":1},{"lineBreak":true},{"text":"à ↄ̃ndↄ̃ kũ manakɛnaaoo tò.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Àdi yã vãni laasun lɛ́ a wútɛkia,","poem":1},{"lineBreak":true},{"text":"àdi gí yã pãsĩiro,","poem":1},{"lineBreak":true},{"text":"àdi a zĩda da zɛ́ fayasariden.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dikiri, n yenyĩ zↄ̃kↄ̃ↄ kà ludambɛa,","poem":1},{"lineBreak":true},{"text":"ń náani vĩ manamana, à zↄ̃̀ susunɛnↄa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N manakɛna zↄ̃kↄ̃ lán kpinↄ bà,","poem":1},{"lineBreak":true},{"text":"n yãzɛdekɛ lɛ́ vĩro lán ísira lòkotoo bà.","poem":1},{"lineBreak":true},{"text":"Dikiri, ndì bisãsirinↄ kũ nↄ̀bↄnↄ bo pínki.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Luda, n yenyĩ bɛ̀ɛrɛ vĩ fá,","poem":1},{"lineBreak":true},{"text":"bisãsirinↄ dì utɛ n orun.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Òdi n ↄn pↄ́ble níside ble ò kã,","poem":1},{"lineBreak":true},{"text":"ndì n swa'i pↄnnade kpáḿma ò mi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Zaakũ mↄkↄ̃mmɛ wɛ̃̀ndiboki ũ,","poem":1},{"lineBreak":true},{"text":"ó kunna n gupuran mɛ́ à ó wɛ́ kɛ̃̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ǹgↄ̃ yenyĩ mↄ gbɛ̃ kũ ò n dↄ̃nↄnɛ,","poem":1},{"lineBreak":true},{"text":"ǹgↄ̃ nɛ̀sɛpuradenↄ sura ba ǹgↄ̃ gɛ́.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹsun tó zĩdabirinↄ gɛ̀sɛ pɛ́tɛpɛtɛmaro,","poem":1},{"lineBreak":true},{"text":"ǹsun tó yãvãnikɛrinↄ ↄ sↄ̃mairo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹ gwa, manafikide pìnↄ lɛ̀tɛ,","poem":1},{"lineBreak":true},{"text":"ò gↄ̃̀ wutɛna sↄ̀rↄrↄ, oni fↄ̃ ò futɛro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}