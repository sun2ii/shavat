{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":38,"content":[{"type":"heading","content":["Takaside aduakɛnaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri, ǹsun ma toto kũ pↄfɛ̃oro,","poem":1},{"lineBreak":true},{"text":"ǹsun ma sã fĩ kũ pɛ̃tɛ̃oro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N kànↄ ma papa,","poem":1},{"lineBreak":true},{"text":"n ↄ tↄ̃̀ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma mɛ̀ gbãna làka n pɛ̃tɛ̃ yãi,","poem":1},{"lineBreak":true},{"text":"ma wá aafiaro ma durunna yãi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma taarinↄ dàmala,","poem":1},{"lineBreak":true},{"text":"ò tↄ̃̀ma lán aso tìkisii bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma bↄ̀nↄ lì fↄ̃nna ũ,","poem":1},{"lineBreak":true},{"text":"ò yagi kɛ̀ ma yↄ̃nkↄkɛ yãi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Má kuna, ma gↄ̃ zↄ̀lↄlↄ,","poem":1},{"lineBreak":true},{"text":"madìgↄ̃ tɛ́ ãnsisinamɛ gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma kpɛwa tɛn wí yãpura,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀ gbãna vĩro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Má gbãna vĩro, ma mɛ̀ɛ kɛ̀ búgubugu,","poem":1},{"lineBreak":true},{"text":"matɛn wiki lɛ́ ma pↄyakana yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dikiri, ń pↄ́ kũ má yei dↄ̃ pínki,","poem":1},{"lineBreak":true},{"text":"ndì ma ndana ma sãnsãn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma kù tɛn vĩ gbì gbì, ma gbãna làka,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ tɛn tɛ́ kɛ doro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃nnanↄ kũ ma gbɛ̃nↄ dì gbãtɛmɛnɛ,","poem":1},{"lineBreak":true},{"text":"ma danɛnↄ dì bàa lɛ́mɛnɛ ma bↄ̀nↄ yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gbɛ̃ kũ ò wɛtɛ ò ma dɛnↄ dì bà kpákpamɛnɛ,","poem":1},{"lineBreak":true},{"text":"ma wɛtɛrinↄ dì yã vãni kpákũsũ kũmao,","poem":1},{"lineBreak":true},{"text":"òdigↄ̃ manafikiyã gwa kũ kↄ̃o gↄrↄ sĩnda pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ma gↄ̃ lán sãto bà, madì yã maro,","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃ kũ a nɛ́nɛ nàtɛ bà, madì lɛ́ wɛ̃kↄ̃aro.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Má de lán gbɛ̃ kũ àdi yã maro bà,","poem":1},{"lineBreak":true},{"text":"madì weḿmaro.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dikiri, mↄkↄ̃mmɛ ma wɛ́ dↄnyĩ,","poem":1},{"lineBreak":true},{"text":"ĩni ma yã ma, Dikiri ma Luda.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma pì, ǹsun tó ò yↄ̃̀gↄ̃ kɛmaro,","poem":1},{"lineBreak":true},{"text":"ǹsun tó ò ĩa dã ma satana yãiro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ma ka lɛtɛna,","poem":1},{"lineBreak":true},{"text":"madìgↄ̃ kú yã'ũmmanaa gũn.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mani ma yã vãninↄ onnɛ sà,","poem":1},{"lineBreak":true},{"text":"zaakũ ma durunna yãin ma pↄ yakana.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma ibɛrɛ pãsĩnↄn lɛ́ vĩro,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ ò zã̀magu pãpãnↄn dasi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Òdi yã mana fĩna bomɛnɛ kũ yã vãnio,","poem":1},{"lineBreak":true},{"text":"yã manan má tɛ́i, akũ ò ibɛrɛɛ sɛ̀ kũmao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dikiri, ǹsun ma zukũnaro,","poem":1},{"lineBreak":true},{"text":"ma Luda, ǹsungↄ̃ kú kũmao zã̀ro.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ǹ mↄ́ ǹ kpámai likalika,","poem":1},{"lineBreak":true},{"text":"ma Dikiri, ma surabarii.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}