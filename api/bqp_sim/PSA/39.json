{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":39,"content":[{"type":"heading","content":["Takaside ↄ́ↄdↄna Ludanɛ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Ma pì, manigↄ̃ ma zĩda kũna dↄ̃,","poem":1},{"lineBreak":true},{"text":"mani tó ma lɛ́ ma da durunnakɛnaa gũnlo.","poem":1},{"lineBreak":true},{"text":"Tó gbɛ̃ vãni kú kũmao, mani ma lɛ́ kũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma lɛ́ nakↄ̃ana, ma yĩtɛ kítikiti,","poem":1},{"lineBreak":true},{"text":"mádi yãke oro, bee yã mana se,","poem":1},{"lineBreak":true},{"text":"akũ ma yã'ũmmanaa ɛ̀ra à kàra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma swɛ̃̀ɛ puusu bò ma gũn,","poem":1},{"lineBreak":true},{"text":"kũ ma laasunn lɛ̀, ma nɛ̀sɛɛ wã̀,","poem":1},{"lineBreak":true},{"text":"akũ ma lɛ́ bò ma pì:","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dikiri, ǹ tó mà a wɛ̃̀ndigↄrↄ lɛ́ dↄ̃","poem":1},{"lineBreak":true},{"text":"kũ ma gↄrↄ dasi lɛ́o.","poem":1},{"lineBreak":true},{"text":"Ǹ tó màgↄ̃ dↄ̃ lákũ ma wɛ̃̀ndii ni láka nà araga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N ma wɛ̃̀ndi lɛ́ yↄ̃̀ n ↄla lɛ́n,","poem":1},{"lineBreak":true},{"text":"ma kunna de wɛ́ kũ yĩola n kĩnaaro.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ sĩnda pínki dì gɛ̃tɛ lán ĩa bàmɛ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"bisãsiri tɛna dìgↄ̃ de lán uraa bàmɛ.","poem":1},{"lineBreak":true},{"text":"Àdi kɛ gàragara à aruzɛkɛ kakara,","poem":1},{"lineBreak":true},{"text":"ama à dↄ̃ ke dín ani gↄ̃nɛro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tó lɛmɛ, bↄ́ tãmaan manigↄ̃ vĩi?","poem":1},{"lineBreak":true},{"text":"Mↄkↄ̃mmɛ ma wɛ́ donyĩ, Dikiri.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ ma taarinↄ kɛ̃ma,","poem":1},{"lineBreak":true},{"text":"ǹsun tó yↄ̃nkↄnↄ ma foboro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma lɛ́ nakↄ̃ana, mádi ma lɛ́ wɛ̃kↄ̃aro,","poem":1},{"lineBreak":true},{"text":"zaakũ mↄkↄ̃n mɛ́ n yã bire kɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ǹsun ma lɛ́ doro,","poem":1},{"lineBreak":true},{"text":"n okũ tɛni ma ká gaa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ndì gbɛ̃ toto ndì wɛ́ tãa a durunna yãi,","poem":1},{"lineBreak":true},{"text":"ndì a aruzɛkɛ ble lán blɛ́ bà.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ sĩnda pínki dì gɛ̃tɛ lán ĩa bàmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ǹ ma aduakɛna sí Dikiri,","poem":1},{"lineBreak":true},{"text":"ǹ sã kpá ma wikilɛnaaa.","poem":1},{"lineBreak":true},{"text":"Ǹsun sã tata ma ↄ́ↄdↄnaanɛro,","poem":1},{"lineBreak":true},{"text":"zaakũ n nibↄↄn ma ũ,","poem":1},{"lineBreak":true},{"text":"má de gbɛ̃ zĩ̀tↄ ũ lán ma dizinↄ bà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ǹ wɛ́ goma de ma pↄ le àgↄ̃ nna dↄ,","poem":1},{"lineBreak":true},{"text":"ari màgↄ̃ gɛ́ andunia tó.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}