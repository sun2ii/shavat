{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":4,"content":[{"type":"heading","content":["Ɔkↄsi aduakɛnaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ. Òdi sí kũ mↄrↄlɛnaaomɛ."]},{"type":"verse","number":1,"content":[{"text":"Tó ma n sisi, ǹ wema Luda ma zɛkũnwode,","poem":1},{"lineBreak":true},{"text":"tó má kakũnna, ǹ ma gba ĩampaki,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ̃nda gwa ǹ ma aduakɛna sí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gbɛ̃nↄ, áni gí àgↄ̃ wé'i da ma Luda gakuridea ari bↄrɛmɛɛ?","poem":1},{"lineBreak":true},{"text":"Ánigↄ̃ ye pↄ́ pãnↄi àgↄ̃ tɛ́ tãnanↄin yá?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Àgↄ̃ dↄ̃ kũ Dikiri a gbɛ̃nↄ dìtɛ adona,","poem":1},{"lineBreak":true},{"text":"tó ma a sìsi, ani ma yã ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tó a pↄ fɛ̃̀, àsun durunna kɛro,","poem":1},{"lineBreak":true},{"text":"à laasun lɛ́ á wutɛbↄ musu à yĩtɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"À sa kũ à de à o o,","poem":1},{"lineBreak":true},{"text":"à Dikiri náani kɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Parinↄ dì pi: Dí mɛ́ ani yã mana kɛwɛrɛɛ?","poem":1},{"lineBreak":true},{"text":"Ǹ ãn werewá, Dikiri, ǹ arubarika daógu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bee tó pↄ́blewɛ kũ sèwɛ̃o dińyĩ,","poem":1},{"lineBreak":true},{"text":"pↄnna kũ ń dàmɛnɛ ma swɛ̃̀n de ń pↄ́la.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Madì wútɛ mà i o nnanna,","poem":1},{"lineBreak":true},{"text":"zaakũ Dikiri, mↄkↄ̃mmɛ ndì tó màgↄ̃ kú ma laakariia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}