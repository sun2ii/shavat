{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":40,"content":[{"type":"heading","content":["Dikiri sáabukpanaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Ma wɛ́ dↄ̀ Dikirii manamana,","poem":1},{"lineBreak":true},{"text":"akũ à arɛ dↄ̀ma à ma ↄ́ↄdↄnaa mà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À ma bo tↄ̃̀nↄwɛɛɛ gũn,","poem":1},{"lineBreak":true},{"text":"à ma bo fokon.","poem":1},{"lineBreak":true},{"text":"À ma gbá pɛ̀tɛ gbɛ̀si musu,","poem":1},{"lineBreak":true},{"text":"à ma zɛ gwe gíngin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À lɛ̀ dufu dàmɛnɛ ma lɛ́n","poem":1},{"lineBreak":true},{"text":"ó Luda sáabukpana pↄ́ ũ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃nↄ ni e dasi, vĩna ni ń kũ,","poem":1},{"lineBreak":true},{"text":"ò Dikiri náani kɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Arubarikaden gbɛ̃ kũ à Dikiri náani vĩ ũ,","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ àdi arɛ dↄ zĩdabirinↄ kũ tãnagbagbarinↄaro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dikiri ma Luda, n yãbonsarɛkɛnanↄn dasi,","poem":1},{"lineBreak":true},{"text":"oni fↄ̃ ò yã kũ ntɛn pɛ́awɛrɛ dↄdↄro.","poem":1},{"lineBreak":true},{"text":"Tó matɛn babannɛ, à lɛ́ vĩro,","poem":1},{"lineBreak":true},{"text":"mani fↄ̃ mà o pínkiro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ń ye sa'opↄ ke gbairo,","poem":1},{"lineBreak":true},{"text":"akũ n ma gba sã mà yã mao.","poem":1},{"lineBreak":true},{"text":"Ńdi sa'opↄ kũ òdi ká tɛ́n à tɛ́ kũ","poem":1},{"lineBreak":true},{"text":"ke durunna kútɛkɛbↄ gbɛkaro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Akũ ma pì: Makũmɛ la,","poem":1},{"lineBreak":true},{"text":"ma su lákũ à kɛ̃na takadan ma yã musu nà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Má ye n pↄyenyĩna kɛmɛ, ma Luda,","poem":1},{"lineBreak":true},{"text":"n doka kú ma swɛ̃̀ɛ gũn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mani yãzɛde baaru kpá pari kↄ̃kakaranaa gũn,","poem":1},{"lineBreak":true},{"text":"mani ma lɛ́ nakↄ̃aro, lákũ ń dↄ̃ nà Dikiri.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mádi n yãzɛdekɛ utɛńnɛro,","poem":1},{"lineBreak":true},{"text":"ma n náani kũ n surabanaao yã ò.","poem":1},{"lineBreak":true},{"text":"Mádi gí n yenyĩ kũ n yãpurao oi","poem":1},{"lineBreak":true},{"text":"pari kↄ̃kakaranaa gũnlo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dikiri, ǹsun gí ma wɛ̃nda gwairo,","poem":1},{"lineBreak":true},{"text":"n yenyĩ kũ n yãpurao gↄ̃ ma dãkpã.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zaakũ yã vãni kũ à likanamai lɛ́ vĩro,","poem":1},{"lineBreak":true},{"text":"ma taarinↄ dàmala, matɛn gu ero,","poem":1},{"lineBreak":true},{"text":"à dasi de ma mìkãla, swɛ̃̀ɛ kɛ̃̀magu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dikiri, ǹ sùru kɛ ǹ ma sura ba,","poem":1},{"lineBreak":true},{"text":"Dikiri, ǹ kɛ likalika ǹ mↄ́ ǹ kpámai.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wé'i gbɛ̃ kũ òtɛn wɛtɛ ò ma dɛnↄ kũ,","poem":1},{"lineBreak":true},{"text":"ò ń mì pɛ́tɛ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ kũ ò ye mà kisira enↄ kpɛ li,","poem":1},{"lineBreak":true},{"text":"ń ãn gↄ̃ sisina.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kũ òdi pimɛnɛ, taarɛ, taarɛnↄ,","poem":1},{"lineBreak":true},{"text":"wé'i ń kũ ò gↄ̃ gìri.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kũ òtɛni n ki wɛtɛnↄ,","poem":1},{"lineBreak":true},{"text":"ǹ tò ń pↄ kɛmma nna ò yáa dↄ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ kũ ò ye n surabanainↄ","poem":1},{"lineBreak":true},{"text":"gↄ̃ pi Dikiri zↄ̃kↄ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Takaside wɛ̃ndademɛ ma ũ,","poem":1},{"lineBreak":true},{"text":"ǹ laasun lɛ́ ma yãa, Dikiri.","poem":1},{"lineBreak":true},{"text":"Mↄkↄ̃mmɛ ma kpanyĩri ũ kũ ma mìsiriio,","poem":1},{"lineBreak":true},{"text":"ma Luda, ǹsun gì kɛro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}