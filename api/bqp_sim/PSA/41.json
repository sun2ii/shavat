{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":41,"content":[{"type":"heading","content":["Gyãre aduakɛnaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Arubarikaden gbɛ̃ kũ àdi gbãnasaride yã da ũ,","poem":1},{"lineBreak":true},{"text":"Dikiri dì a bo warikɛnagↄrↄa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dikiri ni à dãkpã à a gba wɛ̃̀ndi gbã̀na,","poem":1},{"lineBreak":true},{"text":"ani arubarika daagu a bùsun,","poem":1},{"lineBreak":true},{"text":"ani a kpá a ibɛrɛnↄa ò ń pↄyeina kɛaro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dikiri ni zɛ kãao tó à wutɛna gyãn,","poem":1},{"lineBreak":true},{"text":"ani tó à futɛ gyã pìn aafia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ma pì: Dikiri, ma durunna kɛ̀nnɛ,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ̃nda gwa, ń ma gba aafiaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma ibɛrɛnↄ tɛni ma wɛtɛ kũ gao ò pì:","poem":1},{"lineBreak":true},{"text":"Bↄrɛn ani ga de a tↄ́ sãtɛɛ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó ò sù ma gwa, yã pãn òdi omɛnɛ,","poem":1},{"lineBreak":true},{"text":"òdi baaru vãni wɛtɛ ma yã musu,","poem":1},{"lineBreak":true},{"text":"gbasa òdi futɛ ò gɛ́ ò yã pì fã bàai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma zãngurinↄ dì ma kpákpa kũ yã vãnio,","poem":1},{"lineBreak":true},{"text":"ń pínki òdi àlesi vãni dↄma ò pi:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gagagyã mɛ́ à a lè,","poem":1},{"lineBreak":true},{"text":"ani futɛ a wutɛna bire gũn doro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bee ma gbɛ̃nna kũ ma a náani kɛ̀,","poem":1},{"lineBreak":true},{"text":"kũ odì ↄ kakara ta dokↄ̃nↄ gũn bò ma kpɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mↄkↄ̃n sↄ̃ Dikiri, ǹ ma wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"ǹ ma gba aafiaa de mà fĩna bońnɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tó ma ibɛrɛnↄ dí ma yↄ̃̀gↄ̃ kɛmaro,","poem":1},{"lineBreak":true},{"text":"manigↄ̃ dↄ̃ sà kũ ma yã kàngu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ń ma kũna ma nɛ̀sɛmana yãi,","poem":1},{"lineBreak":true},{"text":"ń tò màgↄ̃ kú n arɛ gↄrↄ sĩnda pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Arubarikade Dikiri, Isarailanↄ Luda","poem":1},{"lineBreak":true},{"text":"zaa káaku ari gↄrↄ sĩnda pínki!","poem":1},{"lineBreak":true},{"text":"Aami! Aami!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}