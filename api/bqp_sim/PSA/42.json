{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":42,"content":[{"type":"heading","content":["Zĩ̀zↄ ↄ́ↄdↄnaa"]},{"type":"hebrew_subtitle","content":["Kora burinↄ lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Lákũ zↄ̃ dì swa sarɛ ni dɛ nà,","poem":1},{"lineBreak":true},{"text":"lɛn n ni dì ma dɛ lɛ, Luda.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma nini tɛn Luda ni dɛ, Luda Wɛ̃̀ndide pìi.","poem":1},{"lineBreak":true},{"text":"Bↄrɛn mani le mà gɛ́ daalɛɛ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wɛ́tɛ̃ mɛ́ à gↄ̃̀ ma pↄ́ble ũ","poem":1},{"lineBreak":true},{"text":"fãnantɛ̃ kũ gwãanio,","poem":1},{"lineBreak":true},{"text":"òdigↄ̃ pimɛnɛ gↄrↄ sĩnda pínki:","poem":1},{"lineBreak":true},{"text":"N Luda kú máa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma nɛ̀sɛɛ wɛ̃̀nnɛ, akũ yã díkĩnanↄ dↄ̀magu,","poem":1},{"lineBreak":true},{"text":"lákũ madì gɛ́ pari gũn nà ari Luda ↄnn,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nↄ dìgↄ̃ tɛ́tɛ ma kpɛ kũ ayuwiio,","poem":1},{"lineBreak":true},{"text":"dikpɛkɛrinↄ dì dodomai kũ sáabukpanaao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bↄ́yãin ma nɛ̀sɛɛ yàkaa?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dera ma laakarii fùtɛɛ?","poem":1},{"lineBreak":true},{"text":"Séde màgↄ̃ wɛ́ dↄ Ludai,","poem":1},{"lineBreak":true},{"text":"zaakũ mani ɛra màgↄ̃ à sáabu kpá,","poem":1},{"lineBreak":true},{"text":"ma Surabari, ma Luda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma nɛ̀sɛɛ yàka, akũ n yã dↄ̀magu","poem":1},{"lineBreak":true},{"text":"zaa Miza kpigɛrɛɛi ari Yoda mìia,","poem":1},{"lineBreak":true},{"text":"zaa Ɛmↄ kpinↄ musu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ndì tó ísↄ̃kɛna kĩni gↄ̃ dↄ,","poem":1},{"lineBreak":true},{"text":"í lòkotonↄ tɛn lɛ́ zukↄ̃i.","poem":1},{"lineBreak":true},{"text":"N tò í tɛn damala,","poem":1},{"lineBreak":true},{"text":"a sↄ̃ tɛn tá kũmao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dikiri dì yenyĩ mↄmɛnɛ fãnantɛ̃,","poem":1},{"lineBreak":true},{"text":"a lɛ̀ɛ dìgↄ̃ dↄ ma lɛ́n gwãani,","poem":1},{"lineBreak":true},{"text":"matɛn wɛ́ kɛ Luda kũ à de ma wɛ̃̀ndi ũa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Madì pi Luda ma gbɛ̀sinɛ:","poem":1},{"lineBreak":true},{"text":"Bↄ́yãin ma yã sã̀nguu?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dera n tò màgↄ̃ tɛ́ kũ pↄsirao","poem":1},{"lineBreak":true},{"text":"ma ibɛrɛ wɛ́tãmmana yãii?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma waridↄmmarinↄ dì ma sↄ̃sↄ̃,","poem":1},{"lineBreak":true},{"text":"akũ ma wánↄ dìgↄ̃ wí,","poem":1},{"lineBreak":true},{"text":"òdigↄ̃ pimɛnɛ gↄrↄ sĩnda pínki:","poem":1},{"lineBreak":true},{"text":"N Luda kú máa?","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bↄ́yãin ma nɛ̀sɛɛ yàkaa?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dera ma laakarii fùtɛɛ?","poem":1},{"lineBreak":true},{"text":"Séde màgↄ̃ wɛ́ dↄ Ludai,","poem":1},{"lineBreak":true},{"text":"zaakũ mani ɛra màgↄ̃ a sáabu kpá,","poem":1},{"lineBreak":true},{"text":"ma Surabari, ma Luda.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}