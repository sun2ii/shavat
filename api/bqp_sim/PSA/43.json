{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Ǹ ma yã nna kpáma Luda,","poem":1},{"lineBreak":true},{"text":"ǹ zɛ kũmao buri ludadↄ̃risarinↄ yã musu,","poem":1},{"lineBreak":true},{"text":"ǹ ma bo gbɛ̃ vãni manafikidenↄ ↄĩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Luda, mↄkↄ̃mmɛ ma utɛki ũ,","poem":1},{"lineBreak":true},{"text":"bↄ́yãin n gimaii?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dera n tò ma gↄ̃ tɛ́ kũ pↄsirao","poem":1},{"lineBreak":true},{"text":"ma ibɛrɛ wɛ́tãmmana yãii?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ǹ n gupura kũ n yãpurao zĩma,","poem":1},{"lineBreak":true},{"text":"à domɛnɛ arɛ n kpi musu,","poem":1},{"lineBreak":true},{"text":"à gɛ́ kũmao ari n kúkia gwe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbasa mà gɛ́ n gbagbakia Luda,","poem":1},{"lineBreak":true},{"text":"ma pↄ ni kɛmma nna, Luda ma pↄnna,","poem":1},{"lineBreak":true},{"text":"mani n tↄ́ kpá kũ mↄrↄↄo,","poem":1},{"lineBreak":true},{"text":"Luda ma Luda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bↄ́yãin ma nɛ̀sɛɛ yàkaa?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dera ma laakarii fùtɛɛ?","poem":1},{"lineBreak":true},{"text":"Manigↄ̃ wɛ́ dↄ Ludai,","poem":1},{"lineBreak":true},{"text":"zaakũ mani ɛra màgↄ̃ a sáabu kpá,","poem":1},{"lineBreak":true},{"text":"ma Surabari, ma Luda.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}