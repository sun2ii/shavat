{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":44,"content":[{"type":"heading","content":["Isarailanↄ faaba wɛ́kɛnaa"]},{"type":"hebrew_subtitle","content":["Kora burinↄ lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Luda, yã kũ n kɛ̀ zaa gìkɛna ó dizinↄ gↄrↄa,","poem":1},{"lineBreak":true},{"text":"ò òwɛrɛ ó sã mà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N ↄ sↄ̃̀ burinↄi n wari dↄ̀ḿma,","poem":1},{"lineBreak":true},{"text":"n ó dizinↄ kàtɛ ń gbɛ̀n,","poem":1},{"lineBreak":true},{"text":"n ń kara ò dàgula.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Adi kɛ ń fɛ̃nɛda mɛ́ à ń ká bùsu díaro,","poem":1},{"lineBreak":true},{"text":"ń gã̀sã gbãnan ò zĩ̀i blèoro.","poem":1},{"lineBreak":true},{"text":"N zĩda gã̀sã gbãna mɛ́ à tò,","poem":1},{"lineBreak":true},{"text":"n arɛ dↄ̀ḿma kũ ń yeńyĩ yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mↄkↄ̃mmɛ ma Kína ũ ma Luda,","poem":1},{"lineBreak":true},{"text":"ndì tó Yakubu burinↄ zĩ̀ ble.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N gãin odì ↄ sↄ̃ ó ibɛrɛnↄi,","poem":1},{"lineBreak":true},{"text":"kũ n tↄ́on odì gbá pɛ́tɛpɛtɛ ó zãngurinↄa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Adi kɛ ma sá náanikɛnanlo,","poem":1},{"lineBreak":true},{"text":"adi kɛ ma fɛ̃nɛda mɛ́ àdi ma boro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zaakũ mↄkↄ̃n mɛ́ ndì ó sí ó ibɛrɛnↄa,","poem":1},{"lineBreak":true},{"text":"ndì wé'i da ó zãngurinↄa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Luda, odìgↄ̃ n sáabu kpá gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"odìgↄ̃ n tↄ́ kpá lakanaa sari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bee kũ abireo n giwái n tò wé'i ó kũ,","poem":1},{"lineBreak":true},{"text":"ndì bo kũ ó zĩ̀karinↄ doro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N tò o boru kpɛ ó ibɛrɛnↄnɛ,","poem":1},{"lineBreak":true},{"text":"n tò ó zãngurinↄ ó pↄ́nↄ nàkↄ̃a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ń gbá zɛ́ ò ó dɛdɛ lán sãnↄ bà,","poem":1},{"lineBreak":true},{"text":"n ó fãkↄ̃a burinↄ tɛ́.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N n gbɛ̃nↄ yìa araga,","poem":1},{"lineBreak":true},{"text":"ńdi àre le a gũnlo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"N tò ó gbɛ̃dakenↄ ó sↄ̃sↄ̃,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ ò kú ó sarɛnↄ ó lalandii kɛ̀.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N tò o gↄ̃ baaru pↄ́ ũ burinↄnɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nↄ dì ń mì yĩgãwɛrɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Madìgↄ̃ kú kũ wé'io gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"ma gasuu gↄ̃̀ kpá ma wɛ́i","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ma lalandikɛrinↄ kũ ma sↄ̃̀sↄ̃rinↄ yãi","poem":1},{"lineBreak":true},{"text":"kũ ma ibɛrɛ kũ ò ye ò fĩna bomanↄ yão.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Abirekũ ó lé pínki,","poem":1},{"lineBreak":true},{"text":"bee kũ n yã dí sãóguro,","poem":1},{"lineBreak":true},{"text":"ódi n bàka kunna kũoo yã gbororo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ó laasun dí kɛ̃mmaro,","poem":1},{"lineBreak":true},{"text":"ódi kɛ̃ n zɛ́aro.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N ó kɛ́ dúgudugu,","poem":1},{"lineBreak":true},{"text":"n ó bùsu kɛ̀ gbɛ̃gbonnↄ kureki ũ,","poem":1},{"lineBreak":true},{"text":"n gusira níkiniki dàóla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tó ó Dikiri tↄ́ sã̀ógu yã,","poem":1},{"lineBreak":true},{"text":"ke tó ó wɛ́ dↄ̀ buri zĩ̀tↄnↄ tãnanↄi,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Luda ni gí ei yá?","poem":1},{"lineBreak":true},{"text":"Zaakũ àkũ mɛ́ à ó nɛ̀sɛgũnyãnↄ dↄ̃ pínki.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"N yãi ó kú ga lɛ́i zaa kↄnkↄ ari ↄkↄsi,","poem":1},{"lineBreak":true},{"text":"òdi ó ditɛ lán sã kũ oni ń kùtu kpánↄ bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ǹ vu Dikiri! À kɛ̀ dera ntɛn i oo?","poem":1},{"lineBreak":true},{"text":"Ǹ futɛ! Ǹsun gíwái gↄrↄ sĩnda pínkiro.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"À kɛ̀ dera n kↄ̀kↄtↄↄ dↄ̀wɛrɛɛ?","poem":1},{"lineBreak":true},{"text":"Ó wɛ̃ndakɛ kũ ó wɛ́tãmmanaao sã̀ngun yá?","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"O gↄ̃ yĩna lukutɛ̃n,","poem":1},{"lineBreak":true},{"text":"o gↄ̃ wutɛna zĩtɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ǹ futɛ ǹ kpáwái,","poem":1},{"lineBreak":true},{"text":"ǹ mↄ́ ǹ ó bo n yenyĩ yãi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}