{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":46,"content":[{"type":"heading","content":["Luda kú kũoo"]},{"type":"hebrew_subtitle","content":["Kora burinↄ lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Ludan ó utɛki ũ kũ ó gbãnao,","poem":1},{"lineBreak":true},{"text":"àdigↄ̃ kpáwái gↄrↄ sĩnda pínki ó warikɛnaa gũn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A yã mɛ́ à tò bee tó andunia yàka","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ kpinↄ lɛ̀tɛ ò sì ísiran,","poem":1},{"lineBreak":true},{"text":"bee tó í pì kĩni kà à fùtaa bò","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ kpinↄ dège kũ kĩnio,","poem":1},{"lineBreak":true},{"text":"swɛ̃̀ ni kɛ̃óguro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Swa ke kun kũ a í dì su kũ pↄnnao Luda wɛ̃tɛ gũn,","poem":1},{"lineBreak":true},{"text":"Luda Musude kúki kũ à kú adonaa pìi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Luda kú wɛ̃tɛ pìi gũn, ani gↄ̃ bɛzĩ ũro,","poem":1},{"lineBreak":true},{"text":"Luda ni kpái gudↄo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Burinↄ tɛn wiki lɛ́, kpatanↄ tɛn yĩgã,","poem":1},{"lineBreak":true},{"text":"Luda pũ̀tã, akũ andunia yↄ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dikiri Zĩ̀karide kú kũoo,","poem":1},{"lineBreak":true},{"text":"Yakubu Ludan ó utɛki ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"À mↄ́ à Dikiri yãkɛnanↄ gwa,","poem":1},{"lineBreak":true},{"text":"lákũ à yã yìa anduniaa nà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Àkũ mɛ́ àdi zĩ̀i mì dɛ ari andunia lɛ́n,","poem":1},{"lineBreak":true},{"text":"àdi sánↄ ɛ́'ɛ àdi sárinↄ dúgu zↄ̃,","poem":1},{"lineBreak":true},{"text":"àdi tɛ́ sↄ̃ sɛ̃gbakonↄa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À zɛ tɛɛnɛ àgↄ̃ dↄ̃ kũ makũmɛ Luda ũ.","poem":1},{"lineBreak":true},{"text":"Burinↄ ni ma tↄ́ sɛ́ lei,","poem":1},{"lineBreak":true},{"text":"oni ma tↄ́ kpá andunia gũn pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dikiri Zĩ̀karide kú kũoo,","poem":1},{"lineBreak":true},{"text":"Yakubu Ludan ó utɛki ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":10}