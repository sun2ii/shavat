{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":47,"content":[{"type":"heading","content":["Ludamɛ andunia pínki kína ũ"]},{"type":"hebrew_subtitle","content":["Kora burinↄ lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Buri sĩnda pínki, à ↄkpa lɛ́,","poem":1},{"lineBreak":true},{"text":"à pↄnna wiki lɛ́ Ludanɛ kũ ayuwiio.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zaakũ Dikiri Musude naasi vĩ,","poem":1},{"lineBreak":true},{"text":"andunia pínki Kína zↄ̃kↄ̃ↄmɛ a ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À tò o zĩ̀i blè burinↄa,","poem":1},{"lineBreak":true},{"text":"à tò o gɛ̀sɛɛ pɛ̀tɛ gbɛ̃nↄa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À ó zĩtɛ bakaa kpàwá,","poem":1},{"lineBreak":true},{"text":"a yenyĩde Yakubu burinↄ ĩadãbↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Luda fùtɛ, òtɛn ayuwii kɛ,","poem":1},{"lineBreak":true},{"text":"Dikiri zɛna, òtɛn kuru pɛ́.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À lɛ̀ sí Ludanɛ, à lɛ̀ sínɛ,","poem":1},{"lineBreak":true},{"text":"à lɛ̀ sí ó Kínanɛ, à lɛ̀ sínɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zaakũ andunia pínki Kínamɛ a ũ,","poem":1},{"lineBreak":true},{"text":"à lɛ̀ sínɛ kũ dↄ̃naao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Luda tɛn kí ble burinↄa,","poem":1},{"lineBreak":true},{"text":"à vutɛna a kpata kũ à kú adonaaa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Burinↄ kpatablerinↄ tɛn kↄ̃ kakara","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ ò de Ibrahĩ Luda gbɛ̃nↄ ũ,","poem":1},{"lineBreak":true},{"text":"zaakũ andunia kínanↄ bi Luda pↄ́mɛ.","poem":1},{"lineBreak":true},{"text":"À deńla ń pínki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}