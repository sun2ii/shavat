{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":48,"content":[{"type":"heading","content":["Zaiↄ̃ bi Luda wɛ̃tɛmɛ"]},{"type":"hebrew_subtitle","content":["Kora burinↄ lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri zↄ̃kↄ̃, à kà ò a sáabu kpá manamana","poem":1},{"lineBreak":true},{"text":"ó Luda wɛ̃tɛ gũn a kpi kũ à kú adonaa musu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zaiↄ̃ gbɛ̀ katɛna mana,","poem":1},{"lineBreak":true},{"text":"à de andunia gbɛ̃ sĩnda pínkinɛ pↄnna ũ.","poem":1},{"lineBreak":true},{"text":"Kína zↄ̃kↄ̃ wɛ̃tɛ pì kú kpi gugbãnduru kpa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Luda kú a gudãkpãkinↄ gũn,","poem":1},{"lineBreak":true},{"text":"à tò ò a dↄ̃ aafialeki ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kũ kínanↄ lɛ́dokↄ̃nↄ kɛ̀","poem":1},{"lineBreak":true},{"text":"de ò su ò lɛ́tɛa lɛɛlɛ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"kũ ò wɛ̃tɛ pìi è lɛ, akũ à bò ń sarɛ,","poem":1},{"lineBreak":true},{"text":"vĩna ń kũ, akũ ò bàa lɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ò gↄ̃̀ kũ lukanaao","poem":1},{"lineBreak":true},{"text":"lán nↄgbɛ̃ nↄ̀wãwãkɛrii bà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N ń kɛ́ dúgudugu","poem":1},{"lineBreak":true},{"text":"lákũ ifãboki ĩa dì lagatarinↄ gó'itɛnↄ kakatɛ nà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yã kũ o màan ó wɛ́ è","poem":1},{"lineBreak":true},{"text":"Dikiri Zĩ̀karide ó Luda wɛ̃tɛ gũn.","poem":1},{"lineBreak":true},{"text":"Luda wɛ̃tɛ pìi kàtɛ àgↄ̃ kun gↄrↄ sĩnda pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Luda, ó kú n kpɛ́ ↄnn,","poem":1},{"lineBreak":true},{"text":"ótɛn laasun lɛ́ n yenyĩkɛnaaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Luda, lákũ n tↄ́ dàgula ari andunia lɛ́n nà,","poem":1},{"lineBreak":true},{"text":"lɛn n sáabukpanaa dàgula lɛ dↄ.","poem":1},{"lineBreak":true},{"text":"Ndì yã gↄ̃gↄ̃ n gbɛ̃nↄnɛ a zɛ́a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zaiↄ̃ kpidenↄ tɛn pↄnna kɛ,","poem":1},{"lineBreak":true},{"text":"Yudanↄ bùsu wɛ̃tɛdenↄ pↄ kɛ̀ nna,","poem":1},{"lineBreak":true},{"text":"yãkpatɛ kũ n kɛ̀nↄ yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"À dↄdↄkↄ̃a à lika Zaiↄ̃i,","poem":1},{"lineBreak":true},{"text":"à a bĩni dãkpãki lei dasinↄ naro.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"À a bĩninↄ tàasi ká kũ a zɛki gbãnanↄ","poem":1},{"lineBreak":true},{"text":"de à le à baba ziadenↄnɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zaakũ Luda dímɛ ó Luda ũ gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"àdi dowɛrɛ arɛ ari ò gɛ́ gao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}