{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":49,"content":[{"type":"heading","content":["Aruzɛkɛ náanikɛna bi yↄ̃nkↄyãmɛ"]},{"type":"hebrew_subtitle","content":["Kora burinↄ lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Buri sĩnda pínki, à yã díkĩna ma,","poem":1},{"lineBreak":true},{"text":"andunia pínki, à sã kpá,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kínanↄ kũ talakanↄ,","poem":1},{"lineBreak":true},{"text":"aruzɛkɛdenↄ kũ takasidenↄ á pínki.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɔ̃ndↄ̃yã kú ma lɛ́n,","poem":1},{"lineBreak":true},{"text":"dↄ̃na kú ma swɛ̃̀n.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mani sã dↄ yáasi yãi","poem":1},{"lineBreak":true},{"text":"mà a bↄkↄtɛ kɛ kũ mↄrↄlɛnaao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mani vĩna kɛ yã pãsĩ gↄrↄnɛro,","poem":1},{"lineBreak":true},{"text":"bee tó ma zãngurinↄ likanamai.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ò ń aruzɛkɛ náani vĩ,","poem":1},{"lineBreak":true},{"text":"òdi ń ↄgↄda ĩa dã.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃ke ni fↄ̃ à gí a gbɛ̃dakenɛ ga kũ ani gairo,","poem":1},{"lineBreak":true},{"text":"ani le à pↄ́ke kpá Ludaa à a wɛ̃̀ndi booro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zaakũ gbɛ̃ wɛ̃̀ndi bona zĩ'ũ,","poem":1},{"lineBreak":true},{"text":"aruzɛkɛ ni fↄ̃ à bo zikiro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ani fↄ̃ à tó àgↄ̃ kun gↄrↄ sĩnda pínkiro,","poem":1},{"lineBreak":true},{"text":"ani fↄ̃ à gínɛ àsun wɛ́ kɛ pla kũ gyãwãnworo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Zaakũ ò dↄ̃ kũ bee ↄ̃ndↄ̃rinↄ dì ga,","poem":1},{"lineBreak":true},{"text":"mìsaridenↄ kũ yↄ̃nkↄnↄ dì mì dɛ lɛ se,","poem":1},{"lineBreak":true},{"text":"òdi ń aruzɛkɛ tó gbɛ̃ pãndenↄnɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bee kũ ò ń tↄ́nↄ kpà bùsunↄnɛ yã,","poem":1},{"lineBreak":true},{"text":"ń mira nigↄ̃ de ń bɛ ũmɛ gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"anigↄ̃ ń kúki ũ ari ń buria.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bisãsiri kũ a bɛ̀ɛrɛkɛo","poem":1},{"lineBreak":true},{"text":"dìgↄ̃ kun gↄrↄ sĩnda pínkiro,","poem":1},{"lineBreak":true},{"text":"ani kakatɛ lán nↄ̀bↄnↄ bàmɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mìsaridenↄ lakanaan gwe,","poem":1},{"lineBreak":true},{"text":"lɛmɛ à de lɛ dↄ kũ gbɛ̃ kũ ò tɛ́ ń ágbainↄ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Oni si gyãwãnn lán sãnↄ bà,","poem":1},{"lineBreak":true},{"text":"ga mɛ́ anigↄ̃ de ń dã̀ri ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ mananↄ ni kí bleḿma gudↄo.","poem":1},{"lineBreak":true},{"text":"Ń mɛ̀nↄ ni yagi kũ miran,","poem":1},{"lineBreak":true},{"text":"gyãwãn mɛ́ anigↄ̃ de ń bɛ ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ama Luda ni ma wɛ̃̀ndi sí gyãwãnnwa","poem":1},{"lineBreak":true},{"text":"à gbãnakɛ kpámai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tó gbɛ̃ tɛn gↄ̃ aruzɛkɛde ũ","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ a bɛ tↄ́ tɛn bo nna,","poem":1},{"lineBreak":true},{"text":"ǹsun tó à kɛnnɛ yãke ũro,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"zaakũ ani le à pↄ́ke sɛ́ à táo a gagↄrↄro,","poem":1},{"lineBreak":true},{"text":"a aruzɛkɛnↄ ni bo tɛ́iro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bee tó à a zĩda dↄ̃̀ arubarikade ũ a wɛ̃̀ndi gↄrↄ","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ ò a sáabu kpà a nnamana yãi,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ani ká a dizinↄlamɛ,","poem":1},{"lineBreak":true},{"text":"ani wɛ́ kɛ pla kũ gupurao ziki doro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Bisãsiri kũ a bɛ̀ɛrɛkɛo,","poem":1},{"lineBreak":true},{"text":"tó a wɛ́ dí kɛ̃ro,","poem":1},{"lineBreak":true},{"text":"ani gɛ̃tɛ lán nↄ̀bↄnↄ bàmɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}