{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":5,"content":[{"type":"heading","content":["Kↄnkↄ aduakɛnaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ. Òdi sí kũ kutɛpɛnaaomɛ."]},{"type":"verse","number":1,"content":[{"text":"Ǹ sã kpá ma yãi, Dikiri,","poem":1},{"lineBreak":true},{"text":"ǹ laakari dↄ ma ndanaaa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma Kína, ǹ ma ↄ́ↄdↄna ma,","poem":1},{"lineBreak":true},{"text":"ma Luda, matɛn wɛ́ kɛmma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dikiri, ndì ma kòto ma gudↄo,","poem":1},{"lineBreak":true},{"text":"madì ma yãnↄ dↄdↄnnɛ kↄnkↄ,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ dìgↄ̃ dↄnyĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mↄkↄ̃n Luda ń ye yã vãniiro,","poem":1},{"lineBreak":true},{"text":"ndìgↄ̃ kú lɛɛlɛ kũ gbɛ̃ vãnioro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĩadãrii dì le à zɛ n arɛro,","poem":1},{"lineBreak":true},{"text":"n zã yãvãnikɛrinↄi ń pínki.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dikiri, ndì ɛ́kɛdenↄ mì dɛ,","poem":1},{"lineBreak":true},{"text":"ń ye gbɛ̃dɛrinↄ kũ gbɛ̃blerinↄ kãiro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Makũ sↄ̃, mani gɛ̃ n ↄnn n gbɛ̃kɛ zↄ̃kↄ̃ yãi,","poem":1},{"lineBreak":true},{"text":"mani kútɛ mà arɛ dↄ n kpɛ́a mà mì natɛnnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dikiri, ǹ ma da zɛ́n n náanikɛna yãi,","poem":1},{"lineBreak":true},{"text":"ǹ zɛ́ poromɛnɛ ma wɛtɛrinↄ yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zaakũ ń yãke náani vĩro,","poem":1},{"lineBreak":true},{"text":"ń nɛ̀sɛ de lán kaka bɛ bàmɛ,","poem":1},{"lineBreak":true},{"text":"ń kòto de lán mira wɛ̃naa bàmɛ,","poem":1},{"lineBreak":true},{"text":"òdi lɛ́nna kɛńnɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹ tó yã vutɛḿma Luda,","poem":1},{"lineBreak":true},{"text":"ǹ tó yã vãni kũ òtɛn kpákpanↄ wí ń musu.","poem":1},{"lineBreak":true},{"text":"Ǹ pɛ́ḿma n arɛ ń taari dasinↄ yãi,","poem":1},{"lineBreak":true},{"text":"zaakũ ò gì n yã mai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ǹ tó gbɛ̃ kũ ò utɛna n kĩnaanↄ yáa dↄ,","poem":1},{"lineBreak":true},{"text":"ògↄ̃ lɛ̀ sí kũ pↄnnao gↄrↄ sĩnda pínki.","poem":1},{"lineBreak":true},{"text":"Ǹ ↄ kú gbɛ̃ kũ ò yenyĩnↄa,","poem":1},{"lineBreak":true},{"text":"de ò pↄnna kɛ n yã musu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dikiri, ndì arubarika da gbɛ̃ mananↄgu,","poem":1},{"lineBreak":true},{"text":"ndì likańyĩ kũ yenyĩo lán sɛ̃gbako bà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}