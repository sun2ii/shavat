{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":50,"content":[{"type":"heading","content":["Donyĩkɛna yãpura"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri Luda Gbãnasĩndapinkide tɛn yã o,","poem":1},{"lineBreak":true},{"text":"àtɛn lɛ́ zu andunia gbɛ̃nↄi","poem":1},{"lineBreak":true},{"text":"zaa ifãboki kpa ari a lɛ́tɛ kpa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Luda gakuri tɛn bi Zaiↄ̃,","poem":1},{"lineBreak":true},{"text":"wɛ̃tɛ kũ a manakɛ papana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ó Luda tɛn su, anigↄ̃ yĩtɛnaro.","poem":1},{"lineBreak":true},{"text":"Tɛ́ kũ àdi ń ble kú a arɛ,","poem":1},{"lineBreak":true},{"text":"zàga'ĩa pãsĩ likai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Àtɛn musudenↄ sísi kũ zĩtɛdenↄo","poem":1},{"lineBreak":true},{"text":"de à le à yãkpatɛ kɛ kũ a gbɛ̃nↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À pì: À ma yãmarinↄ kakaramɛnɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ ma bàka kú kũńwo sa'onaa gãinↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ludamɛ yãkpatɛkɛri ũ,","poem":1},{"lineBreak":true},{"text":"musudenↄ dì a yãkɛna a zɛ́a kpàkpa kɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À ma, ma gbɛ̃nↄ, má yã vĩ mà oárɛ,","poem":1},{"lineBreak":true},{"text":"Isarailanↄ, mani á dà bobo,","poem":1},{"lineBreak":true},{"text":"makũmɛ Luda á Luda ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Matɛn zuka káái á sa'ona yãiro,","poem":1},{"lineBreak":true},{"text":"ke sa'opↄ kũ adìgↄ̃ ká tɛ́n à tɛ́ kũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Má zùsa kũ à kú á kpàsan ni vĩro,","poem":1},{"lineBreak":true},{"text":"kesↄ̃ blè kũ à kú á karaa gũn,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"zaakũ nↄ̀bↄsɛ̃ntɛnↄ bi ma pↄ́nↄmɛ","poem":1},{"lineBreak":true},{"text":"kũ pↄ́kãde kpàsa kũ ò kú sĩ̀sĩ dasinↄ musuo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má kpi musu bãnↄ dↄ̃ pínki,","poem":1},{"lineBreak":true},{"text":"sɛ̃̀ntɛ pↄ́ ketenↄ kun ma pↄ́ ũmɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó nà tɛni ma dɛ, mani oárɛro,","poem":1},{"lineBreak":true},{"text":"zaakũ makũmɛ má andunia vĩ","poem":1},{"lineBreak":true},{"text":"kũ pↄ́ kũ ò kunnↄ pínki.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Madì zùsa nↄ̀bↄ són yá?","poem":1},{"lineBreak":true},{"text":"Madì blèkofĩnii aru min yá?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À sa oma kɛnnakũkↄ̃o pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"à lɛ́ kũ a gbɛ̃̀ makũ Luda Musudea fĩna bo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À ma sísi warikɛgↄrↄa,","poem":1},{"lineBreak":true},{"text":"mani á bo, áni bɛ̀ɛrɛ límɛnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Akũ Luda pì yãvãnikɛrinↄnɛ:","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dera átɛni ma yãditɛnanↄ dↄdↄↄ?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãi ma bàka kunna kũńwo yã da á lɛ́nn?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Á ye ma yãdannɛnaairo,","poem":1},{"lineBreak":true},{"text":"a ma yãnↄ kpà kpɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó a kpãni è, adì a kɛ á gbɛ̃nna ũmɛ,","poem":1},{"lineBreak":true},{"text":"á bàkaa dìgↄ̃ kú kũ zinakɛrinↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Á lɛ́gbɛɛ vãni,","poem":1},{"lineBreak":true},{"text":"adì lɛ́nna kɛńnɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Adìgↄ̃ á gbɛ̃ndo pi,","poem":1},{"lineBreak":true},{"text":"adì á da nɛ́ ɛ́kɛ bo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A yã birenↄ kɛ̀, akũ má yĩtɛna.","poem":1},{"lineBreak":true},{"text":"Átɛn da má de lán á bàmɛ,","poem":1},{"lineBreak":true},{"text":"ama mani kpãkɛ̃ái mà á dà bobo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ákↄ̃nↄ kũ ma yã sã̀águnↄ, à yã pì ma.","poem":1},{"lineBreak":true},{"text":"Tó lɛn sↄ̃ro, mani á kɛ yákiyaki,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ke ni fↄ̃ à á símaro.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kũ à kɛnnakũkↄ̃o sa òma zↄ̃kↄ̃kɛ dↄ̃̀mɛnɛ,","poem":1},{"lineBreak":true},{"text":"àtɛni ma gba zɛ́ mà mↄárɛ","poem":1},{"lineBreak":true},{"text":"lákũ madì gbɛ̃nↄ sura ba nà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}