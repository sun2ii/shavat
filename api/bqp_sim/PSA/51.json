{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":51,"content":[{"type":"heading","content":["Sùrukpana Ludaa"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kũ Dauda dà gↄrↄ kũ annabi Natã gɛ̀ɛ a kĩnaa a zinakɛna kũ Basɛbao gbɛra"]},{"type":"verse","number":1,"content":[{"text":"Luda, ǹ ma wɛ̃nda gwa n yenyĩ gũn,","poem":1},{"lineBreak":true},{"text":"ǹ ma taarinↄ gogo n mana zↄ̃kↄ̃ yãi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ ma durunna kɛ̃ma mà gↄ̃ swáswa,","poem":1},{"lineBreak":true},{"text":"ǹ ma durunna kɛ̃ma míↄmiↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Má a taarinↄ dↄ̃ sà,","poem":1},{"lineBreak":true},{"text":"ma durunna dìgↄ̃ sãmaguro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mↄkↄ̃mmɛ ma durunna kɛ̀nnɛ,","poem":1},{"lineBreak":true},{"text":"ma yã kũ ń yeiro kɛ̀.","poem":1},{"lineBreak":true},{"text":"Tó n yã ò, n yã nigↄ̃ zɛ́ vĩ,","poem":1},{"lineBreak":true},{"text":"tó n yãkpatɛ kɛ̀ kũmao, n yã nigↄ̃ nna.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zaa ma da nɛ̀sɛn má vãni,","poem":1},{"lineBreak":true},{"text":"má durunna vĩ zaa ma ina gↄrↄmɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɛ̀sɛmana mɛ́ àdi kángu,","poem":1},{"lineBreak":true},{"text":"ǹ ↄ̃ndↄ̃ damɛnɛ ma swɛ̃̀ɛ gũn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ǹ ma zú o kũ sakoo mà pu swáswa,","poem":1},{"lineBreak":true},{"text":"ǹ ma nɛ̀sɛ pípimɛnɛ mà gↄ̃ púu táitai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ tó mà pↄnna kɛ kũ yáadↄnaao,","poem":1},{"lineBreak":true},{"text":"ǹ tó ma wá kũ n bùsanↄ were.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹsun ma durunnanↄ yã daro,","poem":1},{"lineBreak":true},{"text":"ǹ ma yã vãninↄ bo ǹ zukũna pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Luda, ǹ nɛ̀sɛpura damɛnɛ,","poem":1},{"lineBreak":true},{"text":"ǹ ɛra ǹ tó ma laakari gↄ̃ kpatɛna.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹsun ma zukũnaro,","poem":1},{"lineBreak":true},{"text":"ǹsun n Nini símaro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹ ɛra ǹ tó ma pↄ kɛ nna","poem":1},{"lineBreak":true},{"text":"kũ n ma sura bà yãi.","poem":1},{"lineBreak":true},{"text":"Ǹ ma nini gba màgↄ̃ n yã ma,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"gbasa mà n yã dada yãvãnikɛrinↄnɛ,","poem":1},{"lineBreak":true},{"text":"durunnakɛrinↄ ni ɛra ò arɛ dↄmma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ǹ ma bo gbɛ̃dɛna yãn,","poem":1},{"lineBreak":true},{"text":"Luda, Luda ma surabarii,","poem":1},{"lineBreak":true},{"text":"mani lɛ̀ sí n yãkɛna a zɛ́a musu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dikiri, ǹ ma gba lɛ́","poem":1},{"lineBreak":true},{"text":"mà n sáabu kpá.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sa'onaa dì kɛnnɛ nnaro,","poem":1},{"lineBreak":true},{"text":"tó lɛnlo de ma ò.","poem":1},{"lineBreak":true},{"text":"Sa'opↄ kũ òdi ká tɛ́n à tɛ́ kũ dì kánguro.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sa kũ matɛn ommamɛ ma nɛ̀sɛyĩda ũ,","poem":1},{"lineBreak":true},{"text":"ndì wɛ̃ndade sùrude gya boro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Luda, ǹ arubarika da Zaiↄ̃gu","poem":1},{"lineBreak":true},{"text":"n pↄyeina mana gũn,","poem":1},{"lineBreak":true},{"text":"ǹ Yurusalɛmu bĩni gba gbãna,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"gbasa sa'ona a zɛ́a ni kángu","poem":1},{"lineBreak":true},{"text":"kũ sa'opↄ kũ òdi ká tɛ́n à tɛ́ kũo,","poem":1},{"lineBreak":true},{"text":"oni sa o kũ zùsanɛnↄ n gbagbakia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}