{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":52,"content":[{"type":"heading","content":["Aruzɛkɛde ĩadãnaa"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kũ Dauda dà gↄrↄ kũ à gɛ̀ɛ Aimɛlɛki bɛa, akũ Ɛdↄmu gbɛ̃ Doɛgi gɛ̀ɛ à ò Solunɛɛ"]},{"type":"verse","number":1,"content":[{"text":"Gↄ̃sa gbãna, Luda gbɛ̃kɛ kun gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"à kɛ̀ dera ntɛn ĩa dã kũ yã vãnioo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ndìgↄ̃ lɛ́fↄtↄ kɛ kũ gbɛ̃nↄ gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"n lɛ́ nna lán gɛ̃ mìbobↄↄ bà,","poem":1},{"lineBreak":true},{"text":"ndì gbɛ̃nↄ gbákĩ zↄ̃o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ń ye yã vãnii de a manala,","poem":1},{"lineBreak":true},{"text":"ɛ́kɛtonaa dì kɛnnɛ nna de yãpurala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ń ye gbɛ̃kakatɛna yãi,","poem":1},{"lineBreak":true},{"text":"manafikiyã mɛ́ à da n lɛ́n.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Luda ni n gbãna kↄ̀ ɛ́ ari gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"ani n kũ à bo kũnwo n kpɛ́n,","poem":1},{"lineBreak":true},{"text":"ani n bo gbɛ̃ bɛ̃nɛnↄ tɛ́.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃ mananↄ è, vĩna ni ń kũ,","poem":1},{"lineBreak":true},{"text":"oni n lalandi kɛ ò pi:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kũ adi Luda kɛ a utɛki ũron dí!","poem":1},{"lineBreak":true},{"text":"À náani kpà a aruzɛkɛ zↄ̃kↄ̃ↄa,","poem":1},{"lineBreak":true},{"text":"à gↄ̃̀ gbãnade ũ gbɛ̃kakatɛnaa gũn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Má de lán kù lásirade kũ à kú Luda ↄnn bà,","poem":1},{"lineBreak":true},{"text":"manigↄ̃ zɛ kũ Luda yenyĩo gↄrↄ sĩnda pínkimɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Manigↄ̃ n sáabu kpá gↄrↄ sĩnda pínki","poem":1},{"lineBreak":true},{"text":"yã kũ n kɛ̀ yãi,","poem":1},{"lineBreak":true},{"text":"mani n tↄ́ sɛ́ lei n yãmarinↄ wára,","poem":1},{"lineBreak":true},{"text":"kũ ń mana yãi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}