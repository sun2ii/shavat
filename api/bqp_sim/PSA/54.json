{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":54,"content":[{"type":"heading","content":["Gbɛ̃ kũ òtɛn wɛ́ tãa aduakɛnaa"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kũ Dauda dà gↄrↄ kũ Zifidenↄ gɛ̀ɛ ò pì Solunɛ, Dauda utɛna ń bùsun."]},{"type":"verse","number":1,"content":[{"text":"Luda, ǹ ma sura ba n tↄ́ yãi,","poem":1},{"lineBreak":true},{"text":"ǹ yã símɛnɛ kũ n gbãnao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Luda, ǹ ma aduakɛna ma,","poem":1},{"lineBreak":true},{"text":"ǹ sã kpá ma yã'onaai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zaakũ buri pãndenↄ fùtɛmai,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ pãsĩnↄ tɛni ma wɛ ò ma dɛ,","poem":1},{"lineBreak":true},{"text":"òdi Luda yã daro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ludamɛ ma kpanyĩri ũ,","poem":1},{"lineBreak":true},{"text":"Dikiri mɛ́ à ma kũna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ǹ ma zãngurinↄ vãni ɛraḿma,","poem":1},{"lineBreak":true},{"text":"ǹ ń dúgu zↄ̃ n náani yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mani sa omma kũ ma pↄyeinaao,","poem":1},{"lineBreak":true},{"text":"mani n tↄ́ bo Dikiri, zaakũ ń mana.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À ma bo ma warinↄ gũn pínki,","poem":1},{"lineBreak":true},{"text":"à tò ma yↄ̃̀gↄ̃ kɛ̀ ma ibɛrɛnↄa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}