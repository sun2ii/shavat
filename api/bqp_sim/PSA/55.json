{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":55,"content":[{"type":"heading","content":["Aduakɛna kunna wɛ́tãmmanaa gũn"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ. Òdi sí kũ guruminↄmɛ."]},{"type":"verse","number":1,"content":[{"text":"Luda, ǹ ma aduakɛna ma,","poem":1},{"lineBreak":true},{"text":"ǹsun lá kú ma yãlaro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ sã wɛ̃ ma yãi ǹ wema,","poem":1},{"lineBreak":true},{"text":"ma laasun ma likara ma gↄ̃ bídi gũn,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ma ibɛrɛnↄ yã'ona yãi","poem":1},{"lineBreak":true},{"text":"kũ gbɛ̃ vãninↄ wɛ́birimanaao,","poem":1},{"lineBreak":true},{"text":"zaakũ òtɛn wari dↄmamɛ,","poem":1},{"lineBreak":true},{"text":"ò ma kũna kũ pↄfɛ̃o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Swɛ̃̀ɛ kɛ̃̀magu,","poem":1},{"lineBreak":true},{"text":"ga vĩna gɛ̃̀magu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vĩna ma kũ, matɛn lukaluka,","poem":1},{"lineBreak":true},{"text":"ma nini vùra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó má dɛ̀mbɛrɛ vĩ lán potɛ̃nɛ bà,","poem":1},{"lineBreak":true},{"text":"de mani vura mà gɛ́ kámma bo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"mani bàa lɛ́ mà gɛ́ zã̀zã,","poem":1},{"lineBreak":true},{"text":"mani gɛ́ mà vutɛ gbárannan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mani wã mà gɛ́ mà utɛki wɛtɛ,","poem":1},{"lineBreak":true},{"text":"de zàga'ĩa gbãna sún ma lero yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ǹ ń yã gboro, Dikiri, ǹ ń yã yãkatɛńnɛ,","poem":1},{"lineBreak":true},{"text":"zaakũ ma è zuka kũ fìtiio kú wɛ̃tɛ gũn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Òdi kpátɛ kɛ bĩni musu fãnantɛ̃ kũ gwãanio,","poem":1},{"lineBreak":true},{"text":"yã vãni kũ yã gbãnao di wɛ̃tɛ gũn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃dɛdɛyã mɛ́ à wɛ̃tɛ pìi pà,","poem":1},{"lineBreak":true},{"text":"gbãnamↄnnɛna kũ manafikio dì kɛ̃ a batunlo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tó ma ibɛrɛ mɛ́ àtɛni ma sↄ̃sↄ̃ yã, mani mɛna,","poem":1},{"lineBreak":true},{"text":"tó ma zãnguri mɛ́ à fùtɛmai, mani utɛnɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ama mↄkↄ̃n, mↄkↄ̃n kũ ó sára lɛ́lɛ,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃ndo, ma gbɛ̃nna!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Odì fàai bo kũ kↄ̃o yã nnanna,","poem":1},{"lineBreak":true},{"text":"odìgↄ̃ tɛ́kↄ̃i pari tɛ́ Luda ↄnn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ga ni zãmba kɛ ma ibɛrɛnↄnɛ,","poem":1},{"lineBreak":true},{"text":"ò si gyãwãn ń gbãnagↄrↄ,","poem":1},{"lineBreak":true},{"text":"zaakũ vãni vutɛki è ń gũn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Makũ sↄ̃, madì Luda sísi,","poem":1},{"lineBreak":true},{"text":"akũ Dikiri dì ma sura ba.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kↄnkↄ, fãnantɛ̃ kũ ↄkↄsio","poem":1},{"lineBreak":true},{"text":"madìgↄ̃ ma yã'ũmmananↄ bↄtɛnɛ kũ ndanaao,","poem":1},{"lineBreak":true},{"text":"akũ àdi ma yã ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bee kũ ma ibɛrɛnↄn dasi,","poem":1},{"lineBreak":true},{"text":"àdi ma sí à ma bo fìtin aafia.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Luda dìgↄ̃ vutɛna kpatan gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"ani ma yã ma, ani wé'i daḿma,","poem":1},{"lineBreak":true},{"text":"zaakũ òdi ń dà litɛro, ò Luda vĩna vĩro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ma gbɛ̃ pìi fìti kɛ̀ kũ a gbɛ̃nↄo,","poem":1},{"lineBreak":true},{"text":"à bò lɛ́dokↄ̃nↄ kũ ò kɛ̀ kũ kↄ̃o kpɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Àdi yã nna o lán zↄ́ bà,","poem":1},{"lineBreak":true},{"text":"ama fìti laasun kú a swɛ̃̀n.","poem":1},{"lineBreak":true},{"text":"Àdi lɛ́nna kɛńnɛ páipai,","poem":1},{"lineBreak":true},{"text":"ama yáadↄmma bà da a bↄ̀kↄmmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ǹ n yã'ũmmananↄ tó Dikirinɛ,","poem":1},{"lineBreak":true},{"text":"anigↄ̃ n kũna,","poem":1},{"lineBreak":true},{"text":"àdi tó gbɛ̃ mana fu zikiro.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gbɛ̃dɛri náanisaridenↄ ni ń gↄrↄ dagura lero,","poem":1},{"lineBreak":true},{"text":"Luda, ĩni tó ò si gyãwãn tↄ̃̀nↄwɛɛn.","poem":1},{"lineBreak":true},{"text":"Makũ sↄ̃, manigↄ̃ n náani vĩ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}