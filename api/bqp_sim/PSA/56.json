{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":56,"content":[{"type":"heading","content":["Zĩdakpana Ludaa"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kũ Dauda dà gↄrↄ kũ Filisitininↄ a kũ̀ zaa Gata."]},{"type":"verse","number":1,"content":[{"text":"Ǹ ma wɛ̃nda gwa Luda, òtɛn pɛ́ma,","poem":1},{"lineBreak":true},{"text":"òdigↄ̃ zĩ̀ ká kũmao ògↄ̃ wɛ́ tãma gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma kpàkparinↄ dìgↄ̃ pɛ́ma gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"ń karambaani yãin òtɛn zĩ̀ ká kũmao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tó vĩna tɛni ma kũ, mani n náani kɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mani Luda tↄ́ kpá yã kũ à ò yãi,","poem":1},{"lineBreak":true},{"text":"má Luda náani vĩ, mani vĩna kɛro.","poem":1},{"lineBreak":true},{"text":"Bↄ́n bisãsiri ni fↄ̃ à kɛmɛnɛɛ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Òdigↄ̃ ma yã litɛ kpɛdangara gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"òdigↄ̃ ma kpákpa kũ yã vãnio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Òdi kↄ̃ kakaramai ò natɛmɛnɛ,","poem":1},{"lineBreak":true},{"text":"òdi ma kpákpa ògↄ̃ ye ò ma dɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Luda, ǹsun tó ń gbɛ̃ke boro,","poem":1},{"lineBreak":true},{"text":"ǹ burinↄ nɛ kũ pↄfɛ̃o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ ma warikɛna yã da,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ́tɛ̃kↄtɛna ká n tùruu gũn.","poem":1},{"lineBreak":true},{"text":"À kú n takada gũnloo?","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tó ma lɛ́ zù Ludai,","poem":1},{"lineBreak":true},{"text":"ma ibɛrɛnↄ ni boru kũ kpɛo,","poem":1},{"lineBreak":true},{"text":"manigↄ̃ dↄ̃ kũ à yã sìmɛnɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mani Luda tↄ́ kpá yã kũ à ò yãi,","poem":1},{"lineBreak":true},{"text":"ee, mani Dikiri tↄ́ kpá yã pì ona yãi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má Luda náani vĩ, mani vĩna kɛro.","poem":1},{"lineBreak":true},{"text":"Bↄ́n bisãsiri ni fↄ̃ à kɛmɛnɛɛ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Luda, mani lɛ́ kũ ma gbɛ̃̀nnɛnↄ fĩna bo,","poem":1},{"lineBreak":true},{"text":"mani kɛnnakũkↄ̃o sa omma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zaakũ n ma si ga lɛ́i,","poem":1},{"lineBreak":true},{"text":"ńdi tó ma gɛ̃̀ɛ sìro,","poem":1},{"lineBreak":true},{"text":"de màgↄ̃ kure kũnwo","poem":1},{"lineBreak":true},{"text":"gupura kũ àdi wɛ̃̀ndi kpáḿma gũn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}