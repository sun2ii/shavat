{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":57,"content":[{"type":"heading","content":["Wikilɛna Luda Musudei"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kũ Dauda dà gↄrↄ kũ à bàa lɛ̀ Solunɛ à ùtɛ gbɛ̀wɛɛn."]},{"type":"verse","number":1,"content":[{"text":"Ǹ ma wɛ̃nda gwa Luda, ǹ ma wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"zaakũ mↄkↄ̃mmɛ ma nanyĩ.","poem":1},{"lineBreak":true},{"text":"Ǹ ma sↄtↄ n orun ari ma bo ga lɛ́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Matɛn wiki lɛ́ Luda Musudei,","poem":1},{"lineBreak":true},{"text":"Luda kũ àdi yã kũ à ò papamɛnɛ pìi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ani tó kpányĩ bo zaa musu à ma sura ba,","poem":1},{"lineBreak":true},{"text":"ani wé'i da gbɛ̃ kũ òtɛn pɛ́manↄa,","poem":1},{"lineBreak":true},{"text":"ani a gbɛ̃kɛ kũ a náaniyão kɛmɛnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Má kú músunↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ wutɛna nↄ̀bↄ pãsĩnↄ dagura.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ pìnↄ nɛ́nɛ nna lán fɛ̃nɛda bà,","poem":1},{"lineBreak":true},{"text":"ń saka bi sárimɛ kũ kàao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Luda, ǹ n zĩda tↄ́ sɛ́ lei ari musumusu,","poem":1},{"lineBreak":true},{"text":"ǹ tó n gakuri da anduniala pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ò tankutɛ kpàkpamɛnɛ ma zɛ́n,","poem":1},{"lineBreak":true},{"text":"akũ ma gↄ̃ wari gũn,","poem":1},{"lineBreak":true},{"text":"ò wɛ̀ɛɛ yↄ̃̀ ma arɛ, akũ ò zù wɛ̀ɛɛ pìn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma laakari kpatɛna Luda, ma laakari kpatɛna,","poem":1},{"lineBreak":true},{"text":"mani lɛ̀ sí mà n táaki lɛ́.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ vu, ma swɛ̃̀!","poem":1},{"lineBreak":true},{"text":"Ma mↄrↄ kũ ma gidigboo kú máa?","poem":1},{"lineBreak":true},{"text":"Mani gudↄ pá mìio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dikiri, mani n sáabu kpá burinↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"mani n táaki lɛ́ gbɛ̃nↄnɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zaakũ n gbɛ̃kɛ zↄ̃kↄ̃ↄ kà n kĩnaa,","poem":1},{"lineBreak":true},{"text":"n náani ludambɛ luku lè.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Luda, ǹ n zĩda tↄ́ sɛ́ lei ari músumusu,","poem":1},{"lineBreak":true},{"text":"ǹ tó n gakuri da anduniala pínki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}