{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":58,"content":[{"type":"heading","content":["Gbɛ̃ vãninↄ tona kũ Ludao"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Gbãnadenↄ, adì yã o a zɛ́a sↄ̃ yá?","poem":1},{"lineBreak":true},{"text":"Adì yãkpatɛ kɛ kũ gbɛ̃nↄo súsu yá?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Adì yã vãni laasun lɛ́ á swɛ̃̀ɛ gũn,","poem":1},{"lineBreak":true},{"text":"adì gbãna mↄ gbɛ̃nↄnɛ á bùsun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃ vãninↄn sãtɛna zaa ń ina gↄrↄmɛ,","poem":1},{"lineBreak":true},{"text":"ɛ́kɛdenↄn yakana zaa ń da nɛ̀sɛn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ń lɛ́gbɛ de lán mlɛ̃̀ sɛwɛ bà,","poem":1},{"lineBreak":true},{"text":"ò de lán káre kũ à a sã tàtaa bà,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"de mlɛ̃̀ɛ pì sún a kↄ̃kↄ̃'ori úra ũ maro,","poem":1},{"lineBreak":true},{"text":"de àsun a dabukɛri gonikɛ ero.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Luda, ǹ ń saka ɛ́'ɛńnɛ ń lɛ́n,","poem":1},{"lineBreak":true},{"text":"Dikiri, ǹ músuu pìnↄ saka sↄ̃ntɛnↄ ɛ́'ɛńnɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ tó ò gɛ̃tɛ lán í bàasinaa bà.","poem":1},{"lineBreak":true},{"text":"Tó ò sá gà, ǹ ń kànↄ ɛ́'ɛńnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ tó ò kori kɛ zɛ́n lán kↄntↄ lɛ́'i bà,","poem":1},{"lineBreak":true},{"text":"ògↄ̃ de lán nↄ̀bↄtɛnɛ kũ adi ifãntɛ̃ ero bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ari yàka tɛ́ gↄ̃ oro wã,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ vãninↄ ni gɛ̃tɛ kũ ĩao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃ mananↄ ni pↄnna kɛ","poem":1},{"lineBreak":true},{"text":"zĩ kũ Luda fĩna bòńnɛ gbɛ̃ vãninↄa,","poem":1},{"lineBreak":true},{"text":"kũ ò ń gbá pìpi ń aru gũn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃nↄ ni pi: Gbɛ̃ mananↄn láada vĩ fá!","poem":1},{"lineBreak":true},{"text":"Luda kun, àdi yãkpatɛ kɛ andunia gũn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}