{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":59,"content":[{"type":"heading","content":["Ǹ ma sí ma ibɛrɛnↄa"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kũ Dauda dà gↄrↄ kũ Solu gbɛ̃nↄ zĩ̀ ò a dãdã a bɛa ò a dɛ."]},{"type":"verse","number":1,"content":[{"text":"Ma Luda, ǹ ma sí ma ibɛrɛnↄa,","poem":1},{"lineBreak":true},{"text":"ǹ ma bo gbɛ̃ kũ ò fùtɛmainↄ ↄĩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ ma sí yãvãnikɛrinↄa,","poem":1},{"lineBreak":true},{"text":"ǹ ma bo gbɛ̃dɛrinↄ ↄĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ǹ gwa, òtɛni ma kpákpa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ pãsĩnↄ tɛn fìti kɛ kũmao.","poem":1},{"lineBreak":true},{"text":"Dikiri, mádi taari ke durunna kɛńnɛro,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"mádi zãńnɛ yãkearo,","poem":1},{"lineBreak":true},{"text":"akũ ò kú kũ soruo ò nakarama.","poem":1},{"lineBreak":true},{"text":"Ǹ ma wɛ̃nda gwa ǹ futɛ ǹ mↄ́ ǹ kpámai!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mↄkↄ̃n Dikiri Luda Zĩ̀karide, Isarailanↄ Luda,","poem":1},{"lineBreak":true},{"text":"ǹ futɛ ǹ wɛ́ tã buri kũ̀nↄa ń pínki.","poem":1},{"lineBreak":true},{"text":"Ǹsun bonkpɛde vãni kũ̀nↄ wɛ̃nda gwaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Òdi ɛra ò su ↄkↄsi dↄ,","poem":1},{"lineBreak":true},{"text":"òdi likara zↄ̃ wɛ̃tɛn,","poem":1},{"lineBreak":true},{"text":"òdi hũ̀u kɛma lán gbɛ̃nↄ bà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ gwa, ń lɛ́'i tɛn tↄ,","poem":1},{"lineBreak":true},{"text":"fɛ̃nɛ kpá ń lɛ́n,","poem":1},{"lineBreak":true},{"text":"òdi pi gbɛ̃ke tɛni ń maro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mↄkↄ̃n sↄ̃ Dikiri, ndì ń yáa dↄ,","poem":1},{"lineBreak":true},{"text":"ndì buri pìnↄ lalandi kɛ ń pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Luda ma gbãna, ma wɛ́ dↄnyĩ,","poem":1},{"lineBreak":true},{"text":"mↄkↄ̃mmɛ ma aafialeki ũ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Luda ni domɛnɛ arɛ a gbɛ̃kɛ gũn,","poem":1},{"lineBreak":true},{"text":"ani tó mà yↄ̃̀gↄ̃ kɛ ma zãngurinↄa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dikiri ó sɛ̃gbako, ǹsun ń dɛdɛro,","poem":1},{"lineBreak":true},{"text":"de ń yã sún sã ma gbɛ̃nↄguro yãi.","poem":1},{"lineBreak":true},{"text":"Ǹ tó ò likara zↄ̃ ǹ ń kↄ́tɛ kũ n gbãnao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yã kũ àdi bo ń lɛ́n bi durunna yãmɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ tó ń karambaanikɛna ń kũ,","poem":1},{"lineBreak":true},{"text":"zaakũ òdi ɛ́kɛ to òdi gbɛ̃ ká.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ǹ ń kakatɛ kũ pↄfɛ̃o,","poem":1},{"lineBreak":true},{"text":"ǹ ń dúgu zↄ̃, òsungↄ̃ kun doro,","poem":1},{"lineBreak":true},{"text":"gbasa ògↄ̃ dↄ̃ ari andunia lɛ́a","poem":1},{"lineBreak":true},{"text":"kũ Luda tɛn kí ble Yakubu burinↄa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Òdi ɛra ò su ↄkↄsi dↄ,","poem":1},{"lineBreak":true},{"text":"òdi likara zↄ̃ wɛ̃tɛ gũn,","poem":1},{"lineBreak":true},{"text":"òdi hũ̀u kɛ lán gbɛ̃nↄ bà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Òdi likara ògↄ̃ pↄ́ble wɛtɛ,","poem":1},{"lineBreak":true},{"text":"tó odi kãro, òdi wiki lɛ́.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Makũ sↄ̃, mani lɛ̀ sí n gbãna yã musu,","poem":1},{"lineBreak":true},{"text":"mà ayuwii kɛ kↄnkↄ n gbɛ̃kɛ yãi,","poem":1},{"lineBreak":true},{"text":"zaakũ mↄkↄ̃mmɛ ma aafialeki ũ,","poem":1},{"lineBreak":true},{"text":"mↄkↄ̃mmɛ ma utɛki ũ warikɛgↄrↄa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Luda ma gbãna, mani n táaki lɛ́,","poem":1},{"lineBreak":true},{"text":"zaakũ mↄkↄ̃mmɛ ma aafialeki ũ,","poem":1},{"lineBreak":true},{"text":"Luda kũ àdi gbɛ̃kɛ kɛmɛnɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}