{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":6,"content":[{"type":"heading","content":["Faaba wikilɛna Ludaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀. Òdi sí kũ mↄrↄlɛnaaomɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri, ǹsun patama kũ pɛ̃tɛ̃oro,","poem":1},{"lineBreak":true},{"text":"ǹsun ma toto kũ pↄfɛ̃oro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ ma wɛ̃nda gwa, Dikiri,","poem":1},{"lineBreak":true},{"text":"zaakũ ma gↄ̃ fɛ̃fɛ̃na,","poem":1},{"lineBreak":true},{"text":"ǹ ma gba aafiaa, Dikiri,","poem":1},{"lineBreak":true},{"text":"zaakũ ma wánↄ tɛn wímɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma pↄ yàka manamana,","poem":1},{"lineBreak":true},{"text":"Dikiri, ĩni kpámai bↄrɛmɛɛ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ǹ ɛra ǹ ma mì sí, Dikiri,","poem":1},{"lineBreak":true},{"text":"ǹ ma sura ba n gbɛ̃kɛ yãi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zaakũ gɛ̀ ni le à n tↄ́ kpáro,","poem":1},{"lineBreak":true},{"text":"oni n sáabu kpá mira gũnlo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma ndana ma kpasa,","poem":1},{"lineBreak":true},{"text":"ma mìbↄkↄↄ dì yaku kũ wɛ́'io,","poem":1},{"lineBreak":true},{"text":"ma wutɛbↄ dì yĩda kũ ari gu gɛ́ dↄo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma wɛ́ kakana kũ pↄsira ↄ́ↄdↄnaao,","poem":1},{"lineBreak":true},{"text":"àtɛn ga kũ ma ibɛrɛnↄn dasi yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"À go ma kĩnaa yãvãnikɛrinↄ,","poem":1},{"lineBreak":true},{"text":"zaakũ Dikiri ma ↄ́ↄ dↄ mà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dikiri ma wikilɛnaa mà,","poem":1},{"lineBreak":true},{"text":"Dikiri ma aduakɛnaa sì.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wé'i ni ma ibɛrɛnↄ kũ ò gↄ̃ bídi gũn,","poem":1},{"lineBreak":true},{"text":"oni fua kãnto ò kpɛ li ń pínki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}