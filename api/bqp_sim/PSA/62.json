{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":62,"content":[{"type":"heading","content":["Ludamɛ utɛki ũ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Luda ado mɛ́ à tò ma laakari kpátɛna,","poem":1},{"lineBreak":true},{"text":"àkũ mɛ́ àdi ma sura ba.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Àkũmɛ ma gbɛ̀si ũ ma surabari ũ,","poem":1},{"lineBreak":true},{"text":"madì gbãna lea, mani yĩgã zikiro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gɛ̃̀n ũgban ánigↄ̃ futɛ gbɛ̃aa?","poem":1},{"lineBreak":true},{"text":"Áni a nɛ lán gbĩ̀ kũ à ɛ̀ à kpán","poem":1},{"lineBreak":true},{"text":"ke kara zĩ bàn yá?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A gona a tía lɛ́n átɛn kpákũsũ,","poem":1},{"lineBreak":true},{"text":"ɛ́kɛtona mɛ́ àdi kɛárɛ nna.","poem":1},{"lineBreak":true},{"text":"Adì sa mana o gbɛ̃nɛ kũ lɛ́omɛ,","poem":1},{"lineBreak":true},{"text":"akũ adì ń ká á swɛ̃̀ɛ gũn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Luda ado mɛ́ à tò ma laakari kpátɛna,","poem":1},{"lineBreak":true},{"text":"zaakũ àkũmɛ ma wɛ́ dↄi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Àkũmɛ ma gbɛ̀si ũ ma surabari ũ,","poem":1},{"lineBreak":true},{"text":"madì gbãna lea, mani yĩgã zikiro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma aafia kũ ma bɛ̀ɛrɛɛo dì bo a kĩnaamɛ,","poem":1},{"lineBreak":true},{"text":"àkũmɛ ma gbɛ̀si gbãna ũ, ma utɛki ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃nↄ, àgↄ̃ a náani vĩ gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"à á swɛ̃̀ wɛ̃nɛ, àkũmɛ ó utɛki ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Talakanↄn de lán lɛ́'ĩa bàmɛ,","poem":1},{"lineBreak":true},{"text":"gbãnadenↄn kú pↄ́ke lɛ́iro.","poem":1},{"lineBreak":true},{"text":"Tó ò ń yↄ̃ kilooa,","poem":1},{"lineBreak":true},{"text":"ń pínki nigↄ̃ de fáuunle.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Àsun gbɛ̃ble'ↄgↄ náani kɛro,","poem":1},{"lineBreak":true},{"text":"àsun ĩa dã kũ kpãni pↄ́oro.","poem":1},{"lineBreak":true},{"text":"Tó á aruzɛkɛ tɛn kↄ̃,","poem":1},{"lineBreak":true},{"text":"àsun tó à á swɛ̃̀ blero.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yã mɛ̀n don Luda ò,","poem":1},{"lineBreak":true},{"text":"yã mɛ̀n pla dínↄn ma mà:","poem":1},{"lineBreak":true},{"text":"Luda, mↄkↄ̃n mɛ́ ń gbãna vĩ,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dikiri, mↄkↄ̃n mɛ́ ń gbɛ̃kɛ vĩ,","poem":1},{"lineBreak":true},{"text":"akũ ndì fĩna bo baadinɛ a yãkɛnaaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}