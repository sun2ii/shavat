{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":63,"content":[{"type":"heading","content":["Luda nidɛnaa"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kũ Dauda dà gↄrↄ kũ à kú Yuda gbárannan."]},{"type":"verse","number":1,"content":[{"text":"Luda, ma Ludamɛ n ũ,","poem":1},{"lineBreak":true},{"text":"matɛni n arɛ wɛtɛ,","poem":1},{"lineBreak":true},{"text":"ma nini yenyĩ, matɛni lukanyĩ","poem":1},{"lineBreak":true},{"text":"lán zĩtɛ kori kũ à ye íi bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ma n e n kúkia,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ sì n gbãna kũ n gakuriolɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zaakũ n gbɛ̃kɛ manamɛnɛ de wɛ̃̀ndila,","poem":1},{"lineBreak":true},{"text":"n sáabukpana nigↄ̃ da ma lɛ́n.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Manigↄ̃ n tↄ́ kpá ari ma wɛ̃̀ndi lɛ́n,","poem":1},{"lineBreak":true},{"text":"mani ↄ sɛ́ musu mà n sísi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma nɛ̀sɛ ni kã lákũ òdi pↄ́ nna ble ò kã nà,","poem":1},{"lineBreak":true},{"text":"n táakilɛna nigↄ̃ da ma lɛ́n kũ ayuwiikɛnaao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N yã dì dↄmagu ma wútɛkia,","poem":1},{"lineBreak":true},{"text":"madì laasun lɛ́mma gwãani.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma sↄtↄna n orun, matɛn lɛ̀ sí,","poem":1},{"lineBreak":true},{"text":"zaakũ mↄkↄ̃mmɛ ma kpanyĩri ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma nini namma,","poem":1},{"lineBreak":true},{"text":"ń ma kũna n ↄplan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gbɛ̃ kũ òtɛni ma wɛnↄ ni kakatɛ,","poem":1},{"lineBreak":true},{"text":"ò gɛ̃ zĩtɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Luda ni tó ò ń dɛdɛ kũ fɛ̃nɛdaomɛ,","poem":1},{"lineBreak":true},{"text":"ò gↄ̃ gbɛ̃gbonnↄ pↄ́ble ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kína sↄ̃ ani pↄnna kɛ kũ Ludao.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ kũ òdi la da kũ Ludaonↄ ni a sáabu kpá,","poem":1},{"lineBreak":true},{"text":"ɛ́kɛdenↄ sↄ̃, ń lɛ́ nigↄ̃ nakↄ̃ana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}