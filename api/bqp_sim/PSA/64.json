{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":64,"content":[{"type":"heading","content":["Ǹ ma sí gbɛ̃ vãninↄ ↄĩ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Luda, ǹ ma ndana ma,","poem":1},{"lineBreak":true},{"text":"ǹ ma bo ma ibɛrɛ kũ òtɛni vĩna damainↄ ↄĩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ ma utɛ gbɛ̃ vãni kũ ò lɛ́ kpàkũsũmainↄnɛ,","poem":1},{"lineBreak":true},{"text":"yãvãnikɛri zukade pìnↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Òdi ń lɛ́ kɛkɛ lán fɛ̃nɛda bà,","poem":1},{"lineBreak":true},{"text":"yã pãsĩnↄ dì bo ń lɛ́n lán kà sɛwɛde bà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Òdi taarisaride dãdã ò a pá,","poem":1},{"lineBreak":true},{"text":"òdi a pá kãnto, vĩna dì ń kũro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Òdi tɛ́ kákↄ̃gu ń vãnikɛnaa gũn,","poem":1},{"lineBreak":true},{"text":"òdi bàkpakpannɛna gusarɛ yã gↄ̃gↄ̃","poem":1},{"lineBreak":true},{"text":"òdi pi: Gbɛ̃ke ni ó ero.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Òdi vãnikɛna yã gↄ̃gↄ̃ ò pi,","poem":1},{"lineBreak":true},{"text":"yã kũ o a lɛ́ kpàkũsũ papana.","poem":1},{"lineBreak":true},{"text":"Bisãsiri nɛ̀sɛgũnyãnↄ asiri zↄ̃kↄ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ama Luda ni ń pá kũ kàao,","poem":1},{"lineBreak":true},{"text":"ani ń kĩnna kãnto.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ani tó yã kũ ò ò wí ń musu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ à ń é pínki nigↄ̃ mì kɛ dékũdekũ","poem":1},{"lineBreak":true},{"text":"ò pi taarɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Vĩna ni gbɛ̃ sĩnda pínki kũ,","poem":1},{"lineBreak":true},{"text":"oni Luda yãkɛnanↄ baba,","poem":1},{"lineBreak":true},{"text":"onigↄ̃ yã kũ à kɛ̀nↄ laasun lɛ́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃ mananↄ, àgↄ̃ pↄnna kɛ Dikiri gũn ò nai,","poem":1},{"lineBreak":true},{"text":"nɛ̀sɛpuradenↄ, àgↄ̃ a táaki lɛ́ ń pínki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}