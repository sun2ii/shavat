{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":65,"content":[{"type":"heading","content":["Buri sĩnda pínki wɛ́ dↄ Ludai"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Luda, à kũ̀ ò n táaki lɛ́ Zaiↄ̃","poem":1},{"lineBreak":true},{"text":"ò lɛ́ kũ ò gbɛ̃̀nnɛnↄ fĩna bo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mↄkↄ̃n kũ ndì aduakɛna ma,","poem":1},{"lineBreak":true},{"text":"n kĩnaan buri sĩnda pínki ni sun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ó yã vãninↄ ó fú,","poem":1},{"lineBreak":true},{"text":"akũ n ó taarinↄ kɛ̃̀wá.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Arubarikademɛ gbɛ̃ kũ n sɛ̀","poem":1},{"lineBreak":true},{"text":"n gɛ̃ kãao n ↄnn ũ.","poem":1},{"lineBreak":true},{"text":"N kpɛ́ pↄ́ mananↄ mↄ̀wá,","poem":1},{"lineBreak":true},{"text":"n kpɛ́ kũ à kú adona pìi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndì wewá kũ yã mana naasidenↄ,","poem":1},{"lineBreak":true},{"text":"Luda ó Surabari.","poem":1},{"lineBreak":true},{"text":"Andunia lɛ́zɛkidenↄ kũ ísirabaradenↄ","poem":1},{"lineBreak":true},{"text":"wɛ́ dↄnyĩ ń pínki.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N gbãna dànla,","poem":1},{"lineBreak":true},{"text":"n kpinↄ kɛ̀ kũ n ikoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ndì ísira kũ a sↄ̃nↄ kĩni kpátɛ,","poem":1},{"lineBreak":true},{"text":"ndì burinↄ zuka lákańnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N daboyãnↄ dì swɛ̃̀ kɛ̃","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ ò kú zĩtɛlɛanↄn,","poem":1},{"lineBreak":true},{"text":"òdi ayuwii dↄmma zaa ifãboki kpa","poem":1},{"lineBreak":true},{"text":"kũ a lɛ́tɛ kpao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndì laakari dↄ anduniaa, ndì a gba í,","poem":1},{"lineBreak":true},{"text":"ndì taaki ká zĩtɛnɛ, n swanↄn pana kũ ío,","poem":1},{"lineBreak":true},{"text":"ndì tó pↄ́wɛnↄ kɛ, zaakũ lɛn n dìtɛ lɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndì í dagula ari búgbanↄ pa,","poem":1},{"lineBreak":true},{"text":"ndì gunↄ foko fↄ̃ kũ legũo,","poem":1},{"lineBreak":true},{"text":"ndì arubarika da pↄ́ kũ à bùtɛnↄgu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ndì arubarika da burazĩn wɛ̃̀ kũ wɛ̃̀ɛo,","poem":1},{"lineBreak":true},{"text":"pↄ́ble níside dì kↄ́tɛ n ágban.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pↄ́dãdãkinↄ sɛ̃̀la bↄ̀tↄↄ kù sɛ̃̀ntɛ,","poem":1},{"lineBreak":true},{"text":"sĩ̀sĩnↄ pↄnna dà uta ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Pↄ́kãdenↄ dàgula ń dãdãkinↄa,","poem":1},{"lineBreak":true},{"text":"pↄ́wɛ dàgula sĩ̀sĩgɛrɛɛi.","poem":1},{"lineBreak":true},{"text":"Òtɛn pↄnna wiki lɛ́, òtɛn lɛ̀ sí.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}