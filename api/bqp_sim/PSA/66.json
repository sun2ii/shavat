{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":66,"content":[{"type":"heading","content":["Luda sáabukpanaa"]},{"type":"verse","number":1,"content":[{"text":"Andunia gbɛ̃ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"à ayuwii kɛ Dikiria.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À lɛ̀ sí a tↄ́ gakurikɛ musu,","poem":1},{"lineBreak":true},{"text":"à a táaki lɛ́ à a tↄ́ bo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À o Ludanɛ: N yãkɛnanↄn naasi vĩ,","poem":1},{"lineBreak":true},{"text":"n gbãna zↄ̃kↄ̃ↄ dì tó n ibɛrɛnↄ kã natɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Andunia pínki dì kútɛnnɛ,","poem":1},{"lineBreak":true},{"text":"òdi n táaki lɛ́ ò n tↄ́ bo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"À mↄ́ à Luda yãkɛnanↄ gwa,","poem":1},{"lineBreak":true},{"text":"yã kũ àdi kɛ bisãsirinↄnɛ naasi vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À ísira lì gukori ũ,","poem":1},{"lineBreak":true},{"text":"ò swa bikũ̀ gɛ̀sɛ.","poem":1},{"lineBreak":true},{"text":"Ò pↄnna kɛ a yã musu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Àdigↄ̃ kí ble kũ a gbãnao gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"a wɛ́ dìgↄ̃ kú burinↄa.","poem":1},{"lineBreak":true},{"text":"Sãgbãnadenↄ sún dↄkɛ kãaoro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Burinↄ, à ó Luda sáabu kpá,","poem":1},{"lineBreak":true},{"text":"a táakilɛna gↄ̃ dↄ á lɛ́n.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À ó wɛ̃̀ndi dã̀kpãwɛrɛ,","poem":1},{"lineBreak":true},{"text":"adi tó ó gbá sàtaro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Luda, zaakũ n ó lɛ́ n ó gwá,","poem":1},{"lineBreak":true},{"text":"n ó baasa lán andurufuu bà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ó ká kpɛ́siran,","poem":1},{"lineBreak":true},{"text":"n aso tìkisii dìwɛrɛ ó kpɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N tò ò dìwá lán sↄ̃ bà,","poem":1},{"lineBreak":true},{"text":"ó wɛ́ tɛ́ mà, í dàóla,","poem":1},{"lineBreak":true},{"text":"akũ n su kũoo nnamana kĩnaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mani su n ↄnn mà sa'opↄ kũ òdi ká tɛ́n à tɛ́ kũ o,","poem":1},{"lineBreak":true},{"text":"mani lɛ́ kũ ma kɛ̀mmanↄ fĩna bo,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"yã kũ à bò ma lɛ́n ma warikɛgↄrↄa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mani sa omma kũ pↄ́ mɛ̀kpananↄ,","poem":1},{"lineBreak":true},{"text":"mani sãkaronↄ kpátannɛ,","poem":1},{"lineBreak":true},{"text":"mani n gbagba kũ zùsanↄ kũ blèkofĩninↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ákↄ̃nↄ kũ á Luda vĩna vĩnↄ,","poem":1},{"lineBreak":true},{"text":"à mↄ́ à ma á pínki,","poem":1},{"lineBreak":true},{"text":"mani yã kũ à kɛ̀mɛnɛ oárɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma wiki lɛ̀a,","poem":1},{"lineBreak":true},{"text":"a táakilɛna da ma lɛ́n.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó ma yã vãni dà ma swɛ̃̀n,","poem":1},{"lineBreak":true},{"text":"de Dikiri gì ma yã mai.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ama à ma yã mà,","poem":1},{"lineBreak":true},{"text":"akũ à ma aduakɛnaa sì.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Arubarikademɛ Dikiri ũ,","poem":1},{"lineBreak":true},{"text":"adi gí ma aduakɛna mairo,","poem":1},{"lineBreak":true},{"text":"adi gí gbɛ̃kɛ kɛmɛnɛiro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}