{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":7,"content":[{"type":"heading","content":["Ǹ yã nna kpáma, Dikiri!"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kũ Dauda sì Dikirinɛ Biliaminu buri Kusu yã musu."]},{"type":"verse","number":1,"content":[{"text":"Dikiri ma Luda, ma nanyĩ,","poem":1},{"lineBreak":true},{"text":"ǹ ma mì sí ǹ ma sura ba","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ ò pɛ̀tɛmainↄ ↄĩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tó lɛnlo, oni ma kɛ yákiyaki","poem":1},{"lineBreak":true},{"text":"lán músuu dì kɛńnɛ nàmɛ,","poem":1},{"lineBreak":true},{"text":"oni ma kɛ̃kɛ̃kↄ̃rɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ke ni ma mì síro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dikiri ma Luda, tó ma taari ke kɛ̀,","poem":1},{"lineBreak":true},{"text":"tó ma ↄ kú yã vãnin,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"tó ma a vãni kɛ̀ ma gbɛ̃dakenɛ,","poem":1},{"lineBreak":true},{"text":"ke tó ma gbãna mↄ̀ ma ibɛrɛɛnɛ pã,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ǹ tó ma ibɛrɛ pì pɛ́tɛmai à ma kũ,","poem":1},{"lineBreak":true},{"text":"à gɛ̀sɛ pɛ́tɛpɛtɛma zĩtɛ,","poem":1},{"lineBreak":true},{"text":"à ma vĩ bùsu'atɛ̃n.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ǹ futɛ ǹ zɛ kũ pↄfɛ̃o, Dikiri,","poem":1},{"lineBreak":true},{"text":"ǹ futɛ ma ibɛrɛnↄi ń nɛ̀sɛ kpã̀kpã yãi.","poem":1},{"lineBreak":true},{"text":"Ǹ vu, ma Luda,","poem":1},{"lineBreak":true},{"text":"ǹ yã gↄ̃gↄ̃ a zɛ́a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ tó gbɛ̃nↄ kakaranyĩ,","poem":1},{"lineBreak":true},{"text":"ǹ kí bleḿma zaa musu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dikiri, ndì yãkpatɛ kɛ kũ gbɛ̃nↄ.","poem":1},{"lineBreak":true},{"text":"Dikiri, ǹ tó yã bo kũmao nna ma yãzɛdekɛ lɛ́n.","poem":1},{"lineBreak":true},{"text":"Luda Musude, ǹ yã kɛmɛnɛ ma nɛ̀sɛpura lɛ́n.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Luda, mↄkↄ̃mmɛ mana,","poem":1},{"lineBreak":true},{"text":"ndì nɛ̀sɛ kũ laasunnwo kpátɛ kɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ gbɛ̃ vãninↄ pãsĩkɛnaa mì dɛ,","poem":1},{"lineBreak":true},{"text":"ǹ gbɛ̃ mananↄ gba zɛki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Luda Musudemɛ ma sɛ̃gbako ũ,","poem":1},{"lineBreak":true},{"text":"àdi gbɛ̃ kũ ń nɛ̀sɛ mananↄ sura ba.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Luda dì yãkpatɛ kɛ a zɛ́a,","poem":1},{"lineBreak":true},{"text":"àdi tó yã gↄ̃ vutɛḿma gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃ dí a nɛ̀sɛ litɛro,","poem":1},{"lineBreak":true},{"text":"Luda dì a fɛ̃nɛda lɛ́ kɛkɛ","poem":1},{"lineBreak":true},{"text":"àdi a sá kú à kã.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Àdi a gↄ̃kɛbↄ kũ àdi ga ińnɛnↄ kɛkɛ,","poem":1},{"lineBreak":true},{"text":"àdi a kà tɛ́denↄ kpá sála.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ǹ gwa, yã vãni dì nↄ̀ dↄ gbɛ̃n,","poem":1},{"lineBreak":true},{"text":"akũ àdi wari nↄ̀ sí à nɛ́ i ɛ́kɛ ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Àdi wɛ̀ɛ yↄ̃ gbɛ̃nↄnɛ zã̀zã tankutɛ ũ,","poem":1},{"lineBreak":true},{"text":"akũ àdi zu wɛ̀ɛ kũ à yↄ̃̀ↄ pìi gũn.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A àlesi pãsĩ dì doi,","poem":1},{"lineBreak":true},{"text":"a wɛ́tãna gbɛ̃nↄa dì wí a mìia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mani Dikiri sáabu kpá a manakɛ yãi,","poem":1},{"lineBreak":true},{"text":"mani Dikiri Musude tↄ́ bo kũ lɛ̀sinaao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}