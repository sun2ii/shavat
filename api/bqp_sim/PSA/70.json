type":"verse","number":5,"content":[{"text":"Takaside wɛ̃ndademɛ ma ũ,","poem":1},{"lineBreak":true},{"text":"Luda, ǹ kɛ likalika.","poem":1},{"lineBreak":true},{"text":"Mↄkↄ̃mmɛ ma kpanyĩri ũ kũ ma surabariio,","poem":1},{"lineBreak":true},{"text":"Dikiri, ǹsun gì kɛro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}