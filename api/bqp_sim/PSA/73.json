{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":73,"content":[{"type":"heading","content":["Yãvãnikɛrinↄ nnamanaa"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Luda dì yã mana kɛ Isarailanↄnɛ yãpuramɛ,","poem":1},{"lineBreak":true},{"text":"atɛ̃nsa nɛ̀sɛpuradenↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Makũ sↄ̃, ma ka kãni lɛtɛna,","poem":1},{"lineBreak":true},{"text":"ma gbá ye à satamɛ yã.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kũ ma yãvãnikɛrinↄ kunna mana è,","poem":1},{"lineBreak":true},{"text":"ma ĩadãrii pìnↄ gwena ni dɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yãke dì kpáńnɛro,","poem":1},{"lineBreak":true},{"text":"aafia mↄ̀ḿma akũsↄ̃ ò mɛ̀kpana.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Òdi wari kɛ lán dakenↄ bàro,","poem":1},{"lineBreak":true},{"text":"òdi gyã kɛ lán dakenↄ bàro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Òdi ĩadãna da ń wakan lán mↄ̀wakarɛ bà,","poem":1},{"lineBreak":true},{"text":"òdi pãsĩkɛ da pↄ́kasa ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ń swɛ̃̀ɛ kɛ̀ gbãna kũ yãvãnikɛnaao,","poem":1},{"lineBreak":true},{"text":"yã bɛ̃̀nɛ ń nɛ̀sɛɛ pà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Òdi gbɛ̃ lalandi kɛ òdi yã vãni liḿma,","poem":1},{"lineBreak":true},{"text":"òdi gbãna mↄńnɛ ń zↄ̃kↄ̃kɛ yãi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Òdi pi: Luda kipa ò ↄsi ká,","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ ń yã mɛ́ àdi ble andunia gũn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Abire yãi òdi ɛra ń kpa,","poem":1},{"lineBreak":true},{"text":"òdi yã kũ ò ò pínki sí yãpura ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Òdi pi: Luda dↄ̃ mámɛɛ?","poem":1},{"lineBreak":true},{"text":"Luda Musude dↄ̃na kà lɛ yá?","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ǹ yãvãnikɛrinↄ gwa, òdi yãke damu kɛro,","poem":1},{"lineBreak":true},{"text":"ń gwenaa dìgↄ̃ kara gↄrↄ sĩnda pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ase ma nɛ̀sɛ pura pãn yá?","poem":1},{"lineBreak":true},{"text":"Ma a ↄ bↄ̀tɛ taarin swáswa pãmɛ yá?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ndìgↄ̃ ma gbɛ̃ gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"ndìgↄ̃ ma sã gágamɛnɛ lákũ gu dìgↄ̃ dↄ nà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tó ma zɛ kũ yã dí taka onaao,","poem":1},{"lineBreak":true},{"text":"abirekũ nigↄ̃ de bona n gbɛ̃nↄ kpɛ yã ũmɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kũ ma laasunn lɛ̀ yã pìia de mà dↄ̃,","poem":1},{"lineBreak":true},{"text":"à kɛ̀mɛnɛ zĩ'ũ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sé kũ ma gɛ̃ Luda kúkia,","poem":1},{"lineBreak":true},{"text":"gbasa ma wɛ́ kɛ̃̀ lákũ oni láka nà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"N ń dá guzãrɛ kpa yãpura,","poem":1},{"lineBreak":true},{"text":"ndì ↄ sↄ̃ńyĩ ò lɛ́tɛ ò kakatɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Òdi gↄ̃ kakatɛna pↄ́ ũ kãnto,","poem":1},{"lineBreak":true},{"text":"vĩnapↄnↄ dì ń le ò láka.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Lákũ nana dì gɛ̃tɛ kũ ĩao nà tó gbɛ̃ vù,","poem":1},{"lineBreak":true},{"text":"tó n futɛ Dikiri, ǹ tó ò gɛ̃tɛ lɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kũ ma nɛ̀sɛɛ yàka,","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ ma pↄ sira kũ̀,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ma kɛ yↄ̃nkↄ, má yãke dↄ̃ro,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃nnɛ lán nↄ̀bↄsɛ̃ntɛ bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Bee kũ abireo madìgↄ̃ kú kũnwo,","poem":1},{"lineBreak":true},{"text":"ń ma kũna ma ↄplaa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ndì domɛnɛ arɛ kũ n lɛ́dammao,","poem":1},{"lineBreak":true},{"text":"ĩni láka ǹ ma sí n gakuri gũn.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dín ma wɛ́ dↄi musu n baasii?","poem":1},{"lineBreak":true},{"text":"N baasiro pↄ́ke ni tɛni ma dɛ andunia gũnlo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Bee tó ma mɛ̀ kũ ma swɛ̃̀ɛo tɛn láka,","poem":1},{"lineBreak":true},{"text":"Ludamɛ ma swɛ̃̀ gbãnaleki ũ,","poem":1},{"lineBreak":true},{"text":"àkũmɛ ma baka ũ gↄrↄ sĩnda pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Gbɛ̃ kũ ò kɛ̃̀mmanↄ ni láka,","poem":1},{"lineBreak":true},{"text":"ĩni gbɛ̃ kũ ò bò n kpɛnↄ kakatɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Luda, ma nanyĩna mɛ́ à kɛ̀mɛnɛ nna,","poem":1},{"lineBreak":true},{"text":"Dikiri Luda, ma n kɛ ma utɛki ũ,","poem":1},{"lineBreak":true},{"text":"mani n yãkɛnanↄ babańnɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}