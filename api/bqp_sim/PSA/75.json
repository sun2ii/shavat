{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":75,"content":[{"type":"heading","content":["Ludamɛ yãkpatɛkɛri ũ"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"O n sáabu kɛ̀ Luda, o n sáabu kɛ̀.","poem":1},{"lineBreak":true},{"text":"Tó ò n yãbonsarɛnↄ bàba, ndìgↄ̃ kú kãni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Luda pì: Ma gↄrↄ dìtɛ","poem":1},{"lineBreak":true},{"text":"kũ mani yãkpatɛ kɛ a zɛ́a.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tó andunia yĩ̀gã kũ gbɛ̃ kũ ò kunnↄ ń pínki,","poem":1},{"lineBreak":true},{"text":"makũ mɛ́ madì a gbɛ̀gbanↄ kũ gíngin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Madì o zĩdabirinↄnɛ òsun ĩa dãro,","poem":1},{"lineBreak":true},{"text":"madì o yãvãnikɛrinↄnɛ òsun kùa biriro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Àsun kùa biri ludambɛaro,","poem":1},{"lineBreak":true},{"text":"àsun waka nↄnↄmairo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Zaakũ gbãna dì bo ifãboki kpa ke a lɛ́tɛ kparo,","poem":1},{"lineBreak":true},{"text":"àdi bo gbárannanlo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ludamɛ yãkpatɛkɛri ũ,","poem":1},{"lineBreak":true},{"text":"àkũ mɛ́ àdi gbɛ̃ do lago à gbɛ̃ do kara.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Toko kú Dikiri ↄĩ, í gbãna kán à pà,","poem":1},{"lineBreak":true},{"text":"àtɛn sɛ́n a pↄfɛ̃ ũ fùuu.","poem":1},{"lineBreak":true},{"text":"Àdi atɛ̃ andunia yãvãnikɛrinↄa ń pínki,","poem":1},{"lineBreak":true},{"text":"òdi mi à láka lái kũ a gbↄ̃̀ↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Makũ sↄ̃, manigↄ̃ yã pì o gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"mani Yakubu Luda táaki lɛ́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mani yãvãnikɛrinↄ bɛ̃nɛ ɛ́'ɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ mananↄ bɛ̃nɛ sↄ̃, mani sɛ́ musu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}