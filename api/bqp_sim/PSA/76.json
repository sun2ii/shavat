{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":76,"content":[{"type":"heading","content":["Ludamɛ zĩ̀blena gbãna ũ"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀ɛ. Òdi sí kũ guruminↄo."]},{"type":"verse","number":1,"content":[{"text":"Ò Luda dↄ̃ Yudanↄ bùsummɛ,","poem":1},{"lineBreak":true},{"text":"a tↄ́ zↄ̃kↄ̃ Isarailanↄ tɛ́.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A bizakuta kú Salɛmu,","poem":1},{"lineBreak":true},{"text":"a kúki kú Zaiↄ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zaa gwen à kà wãnanↄ ɛ̀'ɛn","poem":1},{"lineBreak":true},{"text":"kũ sɛ̃gbakonↄ kũ fɛ̃nɛdanↄ kũ zĩ̀kabↄnↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ndì gu pu ndìgↄ̃ tɛ́ kɛ,","poem":1},{"lineBreak":true},{"text":"n zↄ̃kↄ̃kɛ de kpi kũ ò kun gↄrↄ sĩnda pínkinↄla.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N kùgbãnadenↄ gↄ̃kɛbↄnↄ sìḿma,","poem":1},{"lineBreak":true},{"text":"ò wutɛna kũ ga'io,","poem":1},{"lineBreak":true},{"text":"gↄ̃ gbãna pìnↄ doke dí fↄ̃ à a ↄ sɛ̀ro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yakubu Luda, n kpãkɛ̃ńyĩ,","poem":1},{"lineBreak":true},{"text":"akũ sↄ̃denↄ kũ ń sↄ̃nↄ gↄ̃̀ katɛna gɛ̀nↄ ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mↄkↄ̃n mɛ́ ń naasi vĩ ndo,","poem":1},{"lineBreak":true},{"text":"tó n pↄ́ bò n yĩn,","poem":1},{"lineBreak":true},{"text":"dí mɛ́ ani fↄ̃ à zɛ n arɛɛ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zaa musu n yãkpatɛ kɛ̀,","poem":1},{"lineBreak":true},{"text":"akũ vĩna andunia kũ̀, à yĩ̀tɛ kítikiti,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"zĩ kũ Luda, n futɛ ǹ yã gↄ̃gↄ̃ andunianɛ","poem":1},{"lineBreak":true},{"text":"de ǹ gbãnasaridenↄ sura ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"N pↄfɛ̃na gbɛ̃nↄi dì n tↄ́ bo,","poem":1},{"lineBreak":true},{"text":"n pↄfɛ̃ kpara dìgↄ̃ dↄ n pi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"À lɛ́ kɛ Dikiri á Ludaa à a fĩna bo.","poem":1},{"lineBreak":true},{"text":"Ákↄ̃nↄ kũ á likanawáinↄ, à mↄ́","poem":1},{"lineBreak":true},{"text":"à Luda kũ à de ògↄ̃ a vĩna vĩ gba pↄ́.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Àdi kpatablerinↄ kã kpátɛ,","poem":1},{"lineBreak":true},{"text":"àdi tó vĩna andunia kínanↄ kũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}