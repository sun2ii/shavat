{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":77,"content":[{"type":"heading","content":["Luda kpányĩ bɛgɛkɛna wari gũn"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Ma lɛ́ zù Ludai ma a sìsi,","poem":1},{"lineBreak":true},{"text":"ma wiki lɛ̀ Ludaa de à ma yã ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kũ má kú wari gũn ma Dikiri ki wɛ̀tɛ,","poem":1},{"lineBreak":true},{"text":"ma ↄ sɛ̀ musu gwãani kámmabonaa sari,","poem":1},{"lineBreak":true},{"text":"ma laakari gì kpátɛi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kũ ma laasun tà Luda kĩnaa, akũ ma ã'ã,","poem":1},{"lineBreak":true},{"text":"kũ ma dↄ a yãn, ma gↄ̃ kpam lɛɛkɛɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N tò ma wɛ́ tɛ̃̀ i'onaa,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ bídi gũn má dↄ̃ deran ma ò nàro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma dↄ yã zĩnↄn","poem":1},{"lineBreak":true},{"text":"kũ wɛ̃̀ kũ ò gɛ̃̀tɛnↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma laasunn lɛ̀ ma swɛ̃̀ɛ gũn gwãani,","poem":1},{"lineBreak":true},{"text":"ma a zĩda là mà wɛtɛ mà dↄ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma pì: Dikiri gìwai sãnsãnn yá?","poem":1},{"lineBreak":true},{"text":"A pↄ ni kɛ nna kũoo doroo?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A gbɛ̃kɛ làka mámmann yá?","poem":1},{"lineBreak":true},{"text":"A yã nigↄ̃ futɛna gↄrↄ sĩnda pínkin yá?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ó wɛ̃ndagwana yã sã̀ Ludagun yá?","poem":1},{"lineBreak":true},{"text":"A pↄ fɛ̃̀wái, ani wɛ̃nda kɛwɛrɛ doroo?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Akũ ma pì: Yã kũ à ũ̀man dí.","poem":1},{"lineBreak":true},{"text":"Luda Musude ↄ bùsawɛrɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mani laasun lɛ́ Dikiri yãbonsarɛnↄa,","poem":1},{"lineBreak":true},{"text":"mani dↄ yã kũ à kɛ̀ yãnↄn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mani n daboyãkɛnanↄ laasun lɛ́ pínki,","poem":1},{"lineBreak":true},{"text":"mani n yãzↄ̃kↄ̃kɛnanↄ da ma swɛ̃̀n.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Luda, n zɛ́ kú adona.","poem":1},{"lineBreak":true},{"text":"Dikiri kpate zↄ̃kↄ̃ mɛ́ à kà lán ó Luda bàa?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mↄkↄ̃mmɛ Luda yãbonsarɛkɛri ũ,","poem":1},{"lineBreak":true},{"text":"n n gbãna mↄ̀ burinↄnɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N n gbɛ̃nↄ sura bà kũ n gã̀sã gbãnao,","poem":1},{"lineBreak":true},{"text":"ókↄ̃nↄ Yakubu kũ Yusufu burinↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kũ ísira wɛ́ sìnlɛ Luda,","poem":1},{"lineBreak":true},{"text":"kũ ísira wɛ́ sìnlɛ, akũ à kↄ́tↄ kpà,","poem":1},{"lineBreak":true},{"text":"à yĩ̀gãyĩgã ari a lòkoton.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ludambɛ í kↄ̀tɛ,","poem":1},{"lineBreak":true},{"text":"surapatana kĩni dↄ musu,","poem":1},{"lineBreak":true},{"text":"n kànↄ tɛn fã legũpina ũ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N pũtãna kĩni dↄ zàga'ĩa gũn,","poem":1},{"lineBreak":true},{"text":"n legũpinaa andunia pù pínki,","poem":1},{"lineBreak":true},{"text":"zĩtɛ kɛ̀ gìri à yĩ̀gãyĩgã.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N zɛ́ dà ísiran,","poem":1},{"lineBreak":true},{"text":"n gɛ̃ki kɛ̀ í zↄ̃kↄ̃nↄ dagura,","poem":1},{"lineBreak":true},{"text":"odi n gɛ̀sɛgbɛ ero.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N do n gbɛ̃nↄnɛ arɛ lán sã kpàsaa bà","poem":1},{"lineBreak":true},{"text":"Musa kũ Harunao gãi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}