{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":79,"content":[{"type":"heading","content":["Ɔ́ↄdↄna Yurusalɛmu wina yã musu"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Luda, burinↄ sì n bùsun,","poem":1},{"lineBreak":true},{"text":"ò n kpɛ́ kũ à kú adona yàka,","poem":1},{"lineBreak":true},{"text":"ò Yurusalɛmu wìwi ò dàtɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ò n zↄ̀blerinↄ gɛ̀ɛ kpà bãnↄa,","poem":1},{"lineBreak":true},{"text":"ò n yãmarinↄ mɛ̀ɛ tò nↄ̀bↄ pãsĩnↄnɛ pↄ́ble ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ò ń aru kↄ̀tɛ lán í bà Yurusalɛmu bĩnikpɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ke kun à ń vĩro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O gↄ̃ sↄ̃sↄ̃na pↄ́ ũ ó sarɛdenↄnɛ,","poem":1},{"lineBreak":true},{"text":"o gↄ̃ lalandi pↄ́ ũ gbɛ̃ kũ ò likawáinↄnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dikiri, ĩnigↄ̃ pↄ fɛ̃ kũoo ari bↄrɛmɛɛ?","poem":1},{"lineBreak":true},{"text":"N pɛ̃tɛ̃ tɛ́ nigↄ̃ kũ gↄrↄ sĩnda pínkin yá?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹ pↄfɛ̃ kipa buri kũ ò n dↄ̃ronↄa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ òdi n sísironↄ bùsunↄa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zaakũ ò Yakubu burinↄ blè,","poem":1},{"lineBreak":true},{"text":"ò ń bùsuu yàka.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹsun ó denↄ durunnanↄ wí ó musuro.","poem":1},{"lineBreak":true},{"text":"Ǹ wɛ̃nda dↄ̃wɛrɛ likalika,","poem":1},{"lineBreak":true},{"text":"zaakũ o busa o gↄ̃ búgubugu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ǹ kpáwái, Luda ó surabari,","poem":1},{"lineBreak":true},{"text":"ǹ ó sura ba de ǹ tↄ́ bo,","poem":1},{"lineBreak":true},{"text":"ǹ ó durunnanↄ kɛ̃wá n tↄ́ yãi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bↄ́yãi ĩni tó burinↄ ó lá ò pi:","poem":1},{"lineBreak":true},{"text":"Ó Luda kú mámɛ sɛ́ɛ?","poem":1},{"lineBreak":true},{"text":"Ǹ tó burinↄ gↄ̃ dↄ̃ ó wára","poem":1},{"lineBreak":true},{"text":"kũ ndì n zↄ̀blerinↄ dɛdɛna fĩna boḿma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹ tó zĩ̀zↄnↄ ↄ́ↄdↄna gɛ̃ n sãn,","poem":1},{"lineBreak":true},{"text":"ǹ gbɛ̃ kũ ò kú ga lɛ́inↄ bo","poem":1},{"lineBreak":true},{"text":"kũ n gã̀sã gbãnao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ǹ lalandi kũ buri kũ ò likawáinↄ kɛ̀nnɛ","poem":1},{"lineBreak":true},{"text":"fĩna boḿma gɛ̃̀n suppla, Dikiri.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ókↄ̃nↄ n gbɛ̃nↄ, n kpàsa sãnↄ,","poem":1},{"lineBreak":true},{"text":"ónigↄ̃ n sáabu kpá gↄrↄ sĩnda pínki,","poem":1},{"lineBreak":true},{"text":"ónigↄ̃ n tↄ́ babańnɛ ari ó buria.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}