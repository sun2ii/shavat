{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":8,"content":[{"type":"heading","content":["Luda gakuri yã'onaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri ó Dikiri, n tↄ́ bò andunia gũn pínki,","poem":1},{"lineBreak":true},{"text":"n gakuri bò gupuraa musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"N dà nɛ́ fítinↄnɛ kũ nɛ́kpãntɛ̃nↄ ò n sáabu kpá","poem":1},{"lineBreak":true},{"text":"de n ibɛrɛnↄ kũ n zãnguri mↄrakarinↄ yĩtɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kũ ma n zĩ gwà musu,","poem":1},{"lineBreak":true},{"text":"mↄvura kũ susunɛ kũ n pɛ̀pɛ gwenↄ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ma pì bↄ́n bisãsiri ũ kũ a yã dìgↄ̃ dↄnguu?","poem":1},{"lineBreak":true},{"text":"Bↄ́mɛ a ũ kũ n laakari dↄaa?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N a kɛ̀ kĩana malaikanↄi fíti,","poem":1},{"lineBreak":true},{"text":"n a kà kpatan kũ gakurio kũ bɛ̀ɛrɛɛo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N tò à kí blè pↄ́ kũ n kɛ̀nↄa,","poem":1},{"lineBreak":true},{"text":"n tò pↄ́ sĩnda pínki mì nàtɛnɛ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"sãnↄ kũ zùnↄ kũ nↄ̀bↄsɛ̃ntɛnↄ pínki,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"bãnↄ kũ kpↄ̀nↄ kũ pↄ́ kũ ò kú ísira gũnnↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dikiri ó Dikiri, n tↄ́ bò andunia gũn pínki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}