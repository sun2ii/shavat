{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":80,"content":[{"type":"heading","content":["Isarailanↄ suna ń gwena zĩn aduakɛnaa"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Ǹ sã kpá, Isarailanↄ Don'arɛde,","poem":1},{"lineBreak":true},{"text":"mↄkↄ̃n kũ ndì Yusufu burinↄ dã lán sã bà.","poem":1},{"lineBreak":true},{"text":"Ǹ bo ǹ mↄ́, mↄkↄ̃n kũ ń vutɛna kɛrubunↄ dagura,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ǹ do Ɛflaimu burinↄnɛ arɛ","poem":1},{"lineBreak":true},{"text":"kũ Biliaminu burinↄ kũ Manase burinↄ.","poem":1},{"lineBreak":true},{"text":"Ǹ futɛ kũ n gbãnao, ǹ mↄ́ ǹ ó sura ba!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Luda, ǹ tó ò ɛra ò su ó gwena zĩn,","poem":1},{"lineBreak":true},{"text":"ǹ ãn werewá, ń ó sura ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dikiri Luda Zĩ̀karide,","poem":1},{"lineBreak":true},{"text":"ĩni fɛ̃ ǹ gí n gbɛ̃nↄ aduakɛna síi ari bↄrɛmɛɛ?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N wɛ́'i dↄ̀ńnɛ ń pↄ́mina ũ,","poem":1},{"lineBreak":true},{"text":"n ń wɛ́'i yↄ̃̀ńnɛ a pↄ́ pà, ò mì.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N tò o gↄ̃ fobona pↄ́ ũ ó sarɛdenↄnɛ,","poem":1},{"lineBreak":true},{"text":"ó ibɛrɛɛnↄ tɛni ó lalandi kɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Luda Zĩ̀karide, ǹ tó ò su ó gwena zĩn,","poem":1},{"lineBreak":true},{"text":"ǹ ãn werewá ń ò sura ba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"N geepi lí wò Misila,","poem":1},{"lineBreak":true},{"text":"n pɛ burinↄa, akũ n lí pìi pɛ̀ ń gbɛ̀n.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N gu kɛ̀kɛnɛ à zĩni pɛ̀tɛ,","poem":1},{"lineBreak":true},{"text":"akũ à ↄ tà à gu sì.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A uraa dà kpinↄla,","poem":1},{"lineBreak":true},{"text":"a gã̀nↄ de sida lí zↄ̃kↄ̃nↄla.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"À ↄ tà à gɛ̀ɛ ari ísira lɛ́a,","poem":1},{"lineBreak":true},{"text":"a ↄnɛnↄ kà ari Yuflati.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bↄ́yãin n a karaa gbòro","poem":1},{"lineBreak":true},{"text":"de gbɛ̃ kũ òtɛn gɛ̃tɛnↄ gↄ̃ ↄ mátɛ a nɛ́ii?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sàkpanↄ dì lɛ́ kái ò bi,","poem":1},{"lineBreak":true},{"text":"nↄ̀bↄsɛ̃ntɛnↄ dì su ò a lá ble.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N yã nna! Luda Zĩ̀karide, ǹ ɛra ǹ arɛ dↄwá!","poem":1},{"lineBreak":true},{"text":"Zaa musu ǹ wɛ́ kpátɛ ǹ gwa!","poem":1},{"lineBreak":true},{"text":"Ǹ laakari dↄ geepi lí día,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"pↄ́ kũ n pɛ̀ kũ n ↄplao,","poem":1},{"lineBreak":true},{"text":"nɛ́ kũ n tùtuu kɛ̀ n zĩdanɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ò n geepi lí pìi zↄ̃̀ ò tɛ́ sↄ̃̀a,","poem":1},{"lineBreak":true},{"text":"ǹ wɛ́ tɛ̃ra pitiḿma de ò kakatɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ǹ ↄ kú gbɛ̃ kũ à kú n ↄplaiia,","poem":1},{"lineBreak":true},{"text":"bisãsiri nɛ́ kũ n sɛ̀ n pↄ́ ũ pìi,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"óni kɛ̃mma doro.","poem":1},{"lineBreak":true},{"text":"Ǹ ó kunna kɛkɛ ǹ kɛwɛrɛ, óni n sísi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dikiri Luda Zĩ̀karide,","poem":1},{"lineBreak":true},{"text":"ǹ tó ò su ó gwena zĩn,","poem":1},{"lineBreak":true},{"text":"ǹ ãn werewá ń ó sura ba.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}