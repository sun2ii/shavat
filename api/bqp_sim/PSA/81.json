{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":81,"content":[{"type":"heading","content":["Isarailanↄ dikpɛ lɛ̀ɛ"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"À ayuwii kɛ Luda ó gbãnaa,","poem":1},{"lineBreak":true},{"text":"à pↄnna wiki lɛ́ Yakubu burinↄ Ludaa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À lɛ̀ dↄ à bata lɛ́","poem":1},{"lineBreak":true},{"text":"kũ mↄrↄ'ũ nnao kũ gidigboo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"À kuru pɛ́ mↄ dufu bonaao,","poem":1},{"lineBreak":true},{"text":"à pɛ́ tó mↄ kɛ̀ papana ó dikpɛgↄrↄ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"zaakũ à de doka ũ Isarailanↄnɛmɛ,","poem":1},{"lineBreak":true},{"text":"yã kũ Yakubu burinↄ Luda dìtɛn gwe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À yã pìi dà Yusufu burinↄnɛ","poem":1},{"lineBreak":true},{"text":"gↄrↄ kũ à vĩ̀ Misila bùsula.","poem":1},{"lineBreak":true},{"text":"Ò kòto kũ ò dↄ̃ro mà à pì:","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma aso gò á gã̀aa,","poem":1},{"lineBreak":true},{"text":"ma á ↄ bò ɛ̃bona zĩn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A ↄ́ↄ dↄ̀mɛnɛ warikɛgↄrↄa, akũ ma á bó,","poem":1},{"lineBreak":true},{"text":"ma weáwa zaa legũvĩnaa gũn,","poem":1},{"lineBreak":true},{"text":"ma á lɛ́ ma á gwá zaa Mɛriba í kĩnaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"À sã kpá ma gbɛ̃nↄ, mani lɛ́ daáwa,","poem":1},{"lineBreak":true},{"text":"ákↄ̃nↄ Isarailanↄ, tó áni ma yã ma dé!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Àsungↄ̃ buri zĩ̀tↄnↄ tãna vĩ á tɛ́ro,","poem":1},{"lineBreak":true},{"text":"àsun kútɛ dikiri pãndenɛro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Makũmɛ Dikiri á Luda ũ,","poem":1},{"lineBreak":true},{"text":"ma á bↄ́tɛ Misila.","poem":1},{"lineBreak":true},{"text":"À á lɛ́ wɛ̃, mani tó à kã.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ama Isarailanↄ gì ma yã mai,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃ pìnↄ dí mì natɛmɛnɛro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Akũ ma ń tó kũ ń sãgbãnakɛo,","poem":1},{"lineBreak":true},{"text":"ò tɛ́ ń zĩda pↄyeinaai.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó ò pi Isarailanↄ ni ma yã ma,","poem":1},{"lineBreak":true},{"text":"tó ma gbɛ̃nↄn tɛ́ ma yãi,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"de mani ń ibɛrɛnↄ sↄ̃pɛtɛ gↄ̃̀nↄgↄ̃nↄ,","poem":1},{"lineBreak":true},{"text":"mani ↄ sↄ̃ ń zãngurinↄi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma zãngurinↄ ni kã natɛ ma arɛ,","poem":1},{"lineBreak":true},{"text":"ń wɛ́tãmmana nigↄ̃ lakana vĩro.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbasa mà á gwa kũ pↄ́blewɛ manao,","poem":1},{"lineBreak":true},{"text":"mà ɛra mà gbɛ̀ zↄ́'i kpááwa à mↄ́awa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}