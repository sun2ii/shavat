ext":"ò kú gusira gũmmɛ,","poem":1},{"lineBreak":true},{"text":"akũ andunia yĩ̀gã ari a gɛ̃i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma pì Ludanↄmɛ á ũ,","poem":1},{"lineBreak":true},{"text":"Luda Musude nɛ́nↄn á ũ á pínki.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bee kũ abireo áni ga bisãsiri gana ũmɛ,","poem":1},{"lineBreak":true},{"text":"áni kpágula lán gbãnade kparanↄ bàmɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Luda, ǹ futɛ ǹ yãkpatɛ kɛ kũ anduniao,","poem":1},{"lineBreak":true},{"text":"zaakũ buri sĩnda pínki bi n pↄ́mɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}