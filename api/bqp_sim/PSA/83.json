rue},{"text":"ò lɛ́dokↄ̃nↄ kɛ̀ kũ kↄ̃o ò futɛnyĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛdↄmunↄ kũ Sumaila burinↄ","poem":1},{"lineBreak":true},{"text":"kũ Mↄabunↄ kũ Hazara burinↄ","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kũ Gebalidenↄ kũ Amↄninↄ","poem":1},{"lineBreak":true},{"text":"kũ Amalɛkinↄ kũ Filisitininↄ kũ Tayadenↄo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bee se Asirianↄ nàḿma dↄ,","poem":1},{"lineBreak":true},{"text":"de ò ↄ da Lutu burinↄa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ǹ kɛńnɛ lákũ n kɛ̀ Midiãnↄnɛ nà,","poem":1},{"lineBreak":true},{"text":"lákũ n kɛ̀ Sisera kũ Yabĩonɛ nà Kisↄ̃i.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N ń kɛ́ búgubugu Ɛndↄ,","poem":1},{"lineBreak":true},{"text":"akũ ò gↄ̃̀ katɛna zĩtɛ lán bisaa bà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹ kɛ ń wɛ̃nɛnↄnɛ","poem":1},{"lineBreak":true},{"text":"lákũ ò kɛ̀ Orɛbu kũ Zebuonɛ nà.","poem":1},{"lineBreak":true},{"text":"Ǹ kɛ ń kínanɛnↄnɛ","poem":1},{"lineBreak":true},{"text":"lákũ ò kɛ̀ Zɛba kũ Zalamunaonɛ nà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mↄ́kↄ̃nↄ mɛ́ ò pì yã,","poem":1},{"lineBreak":true},{"text":"ò Luda sãdãki sɛ́ ń pↄ́ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ma Luda, ǹ tó ò gↄ̃ lán sɛ̃̀'ĩampuruu bà,","poem":1},{"lineBreak":true},{"text":"lán ése ũkã kũ ĩa tɛn sɛ́ bà.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lákũ dàkoo dì tɛ́ kũ nà,","poem":1},{"lineBreak":true},{"text":"kesↄ̃ lákũ tɛ́ dì kpinↄ ble nà,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ǹ pɛ́tɛńyĩ kũ n zàga'ĩao,","poem":1},{"lineBreak":true},{"text":"ǹ tó n ĩa pãsĩ swɛ̃̀ kɛ̃ńgu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ǹ tó ń gasu gↄ̃ kpá ń wɛ́i,","poem":1},{"lineBreak":true},{"text":"de ò n gbãna dↄ̃ Dikiri.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Wé'i nigↄ̃ ń kũ gↄrↄ sĩnda pínki kũ bídio,","poem":1},{"lineBreak":true},{"text":"ò boru kpɛ ò mì dɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ǹ tó ògↄ̃ dↄ̃ kũ n tↄ́n Dikiri,","poem":1},{"lineBreak":true},{"text":"mↄkↄ̃mmɛ Luda Musude ũ andunia gũn pínki.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}