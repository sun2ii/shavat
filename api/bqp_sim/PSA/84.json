{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":84,"content":[{"type":"heading","content":["Luda ↄn bɛgɛkɛnaa"]},{"type":"hebrew_subtitle","content":["Kora burinↄ lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"N kúki mana fá, Dikiri Zĩ̀karide!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Matɛn Dikiri ↄn bɛgɛ kɛ ari gu tɛn lima,","poem":1},{"lineBreak":true},{"text":"ma nini kũ ma mɛ̀ɛo tɛn luka Luda Wɛ̃̀ndidei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dikiri Zĩ̀karide ma Kína ma Luda,","poem":1},{"lineBreak":true},{"text":"bee bãntoro sàa dà n gbagbaki sarɛ,","poem":1},{"lineBreak":true},{"text":"Ludakibɛbã kpɛ́ bò gwe à a nɛ́nↄ kàn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Arubarikadenↄmɛ gbɛ̃ kũ ò kú n ↄnnnↄ ũ,","poem":1},{"lineBreak":true},{"text":"òdigↄ̃ n táaki lɛ́ gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Arubarikadenↄmɛ gbɛ̃ kũ ń gbãnan n ũnↄ ũ,","poem":1},{"lineBreak":true},{"text":"n ↄn gɛna yã kú ń swɛ̃̀ɛ gũn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó òtɛn gɛ̃tɛ Baka guvutɛa,","poem":1},{"lineBreak":true},{"text":"àdi gↄ̃ lán gu kũ à ísɛ̃bokinↄ vĩ bà,","poem":1},{"lineBreak":true},{"text":"pↄ́tↄ̃gↄrↄ legũ dì tó arubarika dagula.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ń gɛnaa gũn ń gbãna dìgↄ̃ karamɛ","poem":1},{"lineBreak":true},{"text":"ari ò gɛ́ káo n kĩnaa Zaiↄ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dikiri Luda Zĩ̀karide, ǹ ma aduakɛna sí,","poem":1},{"lineBreak":true},{"text":"ǹ sã kpá ma yãi, Yakubu Luda.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Luda, ǹ kína kũ à de ó sɛ̃gbako ũ gwa,","poem":1},{"lineBreak":true},{"text":"ǹ wɛ́ pɛ́ kína kũ n kàai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kunna n ↄn gↄrↄ do manamɛnɛ","poem":1},{"lineBreak":true},{"text":"de kunna gu pãndea gↄrↄ wàa sↄↄrola.","poem":1},{"lineBreak":true},{"text":"Ma Luda ↄn zɛ́dãkpãrikɛ sì","poem":1},{"lineBreak":true},{"text":"de kunna ↄn dokↄ̃nↄ kũ yãvãnikɛrinↄola.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dikiri Luda deńnɛ ifãntɛ̃ kũ sɛ̃gbako ũ,","poem":1},{"lineBreak":true},{"text":"Dikiri dì gbɛ̃kɛ kɛńnɛ kũ bɛ̀ɛrɛɛo,","poem":1},{"lineBreak":true},{"text":"àdi gí pↄ́ mana kpá taarisaridenↄairo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dikiri Zĩ̀karide,","poem":1},{"lineBreak":true},{"text":"arubarikademɛ gbɛ̃ kũ àtɛni n náani kɛ ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}