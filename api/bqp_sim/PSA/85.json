{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":85,"content":[{"type":"heading","content":["Aafia wɛ́kɛna Ludaa"]},{"type":"hebrew_subtitle","content":["Kora burinↄ lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"N arubarikaa dà n bùsun, Dikiri,","poem":1},{"lineBreak":true},{"text":"n su kũ Yakubu burinↄ ń gwena zĩn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N n gbɛ̃nↄ taarinↄ gòḿma,","poem":1},{"lineBreak":true},{"text":"n ń durunnanↄ kɛ̃̀ḿma pínki.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N n pↄ kpã̀kpãa tò pínki,","poem":1},{"lineBreak":true},{"text":"n n pↄfɛ̃ pãsĩ tò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ǹ su kũoo ó gwena zĩn, Luda ó Surabari,","poem":1},{"lineBreak":true},{"text":"ǹ pɛ̃tɛ̃ kũ n kɛ̀ kũoo lago.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N pↄ nigↄ̃ fɛ̃nawái gↄrↄ sĩnda pínkin yá?","poem":1},{"lineBreak":true},{"text":"Ĩnigↄ̃ n pↄfɛ̃gↄrↄ gága wɛ̃̀ kũ wɛ̃̀ɛon yá?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ĩni ɛra ǹ n gbɛ̃nↄ kunna kɛkɛ ǹ kɛńnɛ dↄ,","poem":1},{"lineBreak":true},{"text":"de ń pↄ le à kɛmma nnaroo?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dikiri, ǹ n gbɛ̃kɛ mↄwɛrɛ,","poem":1},{"lineBreak":true},{"text":"ǹ ó sura ba kũ n gbãnao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ma sã dↄ Dikiri Luda yã'onaaa,","poem":1},{"lineBreak":true},{"text":"zaakũ àdi aafia lɛ́ sɛ́ a yãmarinↄnɛ,","poem":1},{"lineBreak":true},{"text":"tó odi ɛra ò sù ń yↄ̃̀nkↄyãnↄaro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A vĩnakɛrinↄ surabanaa gↄrↄ zã̀ro,","poem":1},{"lineBreak":true},{"text":"de a gakuri le àgↄ̃ kú ó bùsun yãi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gbɛ̃kɛ kũ náanio dì dakarɛ,","poem":1},{"lineBreak":true},{"text":"yãzɛde kũ aafiaao dì ↄ kpákↄ̃a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Náani dì ↄ poro musu,","poem":1},{"lineBreak":true},{"text":"yãzɛde dì ↄ nↄnↄ zĩtɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dikiri ni yã mana kɛwɛrɛ,","poem":1},{"lineBreak":true},{"text":"ó zĩtɛ ni pↄ́ble kɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yãzɛde dìgↄ̃ tɛ́ a arɛ,","poem":1},{"lineBreak":true},{"text":"àdi zɛ́ kɛkɛnɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}