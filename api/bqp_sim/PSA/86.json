{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":86,"content":[{"type":"heading","content":["Kpányĩ wɛ́kɛna Ludaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri, ǹ sã kpá ma yãi ǹ wema,","poem":1},{"lineBreak":true},{"text":"zaakũ takaside wɛ̃ndaden ma ũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ ma wɛ̃̀ndi dãkpã,","poem":1},{"lineBreak":true},{"text":"zaakũ má a zĩda kpàmma.","poem":1},{"lineBreak":true},{"text":"Ǹ makũ n zↄ̀bleri sura ba,","poem":1},{"lineBreak":true},{"text":"zaakũ matɛni n náani kɛ,","poem":1},{"lineBreak":true},{"text":"mↄkↄ̃mmɛ ma Luda ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ǹ sùru kɛ kũmao, Dikiri,","poem":1},{"lineBreak":true},{"text":"zaakũ madìgↄ̃ n sísi kↄnkↄ kũ ↄkↄsio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ǹ makũ n zↄ̀bleri pↄ kɛ nna,","poem":1},{"lineBreak":true},{"text":"zaakũ ma laakarii tà n kĩnaa, Dikiri.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ń mana akũsↄ̃ ń sùru vĩ, Dikiri,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃kɛ zↄ̃kↄ̃ n sìsirinↄnɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dikiri, ǹ sã kpá ma wɛ́kɛnaai,","poem":1},{"lineBreak":true},{"text":"ǹ laakari dↄ ma wɛ̃nda wikia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mani n sísi ma warikɛgↄrↄ zĩ,","poem":1},{"lineBreak":true},{"text":"zaakũ ndì wema.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tãna ke ni sí lɛkↄ̃a kũnworo, Dikiri,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ke dì fↄ̃ à n kɛna kɛro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Buri kũ n kɛ̀nↄ ni su ò kútɛnnɛ,","poem":1},{"lineBreak":true},{"text":"ò n tↄ́ bo ń pínki.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zaakũ ń zↄ̃kↄ̃ akũsↄ̃ ndì daboyãnↄ kɛ,","poem":1},{"lineBreak":true},{"text":"mↄkↄ̃mmɛ Luda ũ ndo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ǹ n zɛ́ mↄmɛnɛ, Dikiri, manigↄ̃ táa o n yãpura gũn,","poem":1},{"lineBreak":true},{"text":"ǹ ma laasun kɛmɛnɛ do, de màgↄ̃ n vĩna vĩ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mani n sáabu kpá kũ nɛ̀sɛdoo,","poem":1},{"lineBreak":true},{"text":"Dikiri ma Luda, manigↄ̃ n tↄ́ bo gↄrↄ sĩnda pínki.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zaakũ gbɛ̃kɛ kũ n kɛ̀mɛnɛ zↄ̃kↄ̃,","poem":1},{"lineBreak":true},{"text":"n ma wɛ̃̀ndii sì gyãwãn lↄ̀n.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Luda, karambaanidenↄ tɛn futɛmai,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ pãsĩnↄ tɛni ma wɛ, òdi n yã daro.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mↄkↄ̃n Dikiri, Luda wɛ̃ndadↄ̃nnɛrimɛ n ũ,","poem":1},{"lineBreak":true},{"text":"ń sùru vĩ akũsↄ̃ n pↄ dì fɛ̃ likalikaro,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃kɛ kũ n náanio zↄ̃kↄ̃.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ǹ arɛ dↄma ǹ ma wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"ǹ n zↄ̀bleri gba gbãna,","poem":1},{"lineBreak":true},{"text":"ǹ makũ n zↄ̀nↄkpare nɛ́ sura ba.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ǹ yãmanakɛna sèeda kɛmɛnɛ","poem":1},{"lineBreak":true},{"text":"de ma zãngurinↄ e, wé'i ń kũ,","poem":1},{"lineBreak":true},{"text":"zaakũ Dikiri, n kpamai,","poem":1},{"lineBreak":true},{"text":"n ma laakarii kpàtɛmɛnɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}