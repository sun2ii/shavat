{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":88,"content":[{"type":"heading","content":["Kunna ga lɛ́i aduakɛnaa"]},{"type":"hebrew_subtitle","content":["Ɛzɛra buri Emani lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"Dikiri Luda ma Surabari,","poem":1},{"lineBreak":true},{"text":"matɛn wiki lɛ́mma fãnantɛ̃ kũ gwãanio.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ tó ma aduakɛna kámma,","poem":1},{"lineBreak":true},{"text":"ǹ sã kpá ma ↄ́ↄdↄnaai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zaakũ yã'ũmmana ma nɛ̀sɛɛ pà,","poem":1},{"lineBreak":true},{"text":"ma wɛ̃̀ndii kú ga lɛ́i.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ò ma da gbɛ̃ kũ òtɛn si gyãwãnnnↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ gbãnasaride ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ò pã kpàmai ò ma da gɛ̀nↄ tɛ́","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃ kũ ò wutɛna miran sↄ̀rↄrↄnↄ bà,","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃ kũ ń yã dↄngu doro","poem":1},{"lineBreak":true},{"text":"ń bàka kú kũnworonↄ bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N ma zu wɛ̀ɛ lòkoton","poem":1},{"lineBreak":true},{"text":"ari zĩtɛ tú tↄ̃̀nↄwɛɛ gusiran.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N pↄfɛ̃ tↄ̃̀ma,","poem":1},{"lineBreak":true},{"text":"a ísↄ̃ dàmala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N tò ma gbɛ̃nↄ ma zukũna,","poem":1},{"lineBreak":true},{"text":"n tò ò ye ma kãiro.","poem":1},{"lineBreak":true},{"text":"Ò ma tata, boki kunlo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"warikɛna ma wɛ́ sira kũ̀.","poem":1},{"lineBreak":true},{"text":"Matɛni n sísi zaa kↄnkↄ ari ↄkↄsi,","poem":1},{"lineBreak":true},{"text":"ma ↄnↄ dↄnanyĩ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gɛ̀nↄn ndì yãbonsarɛ kɛńnɛ yá?","poem":1},{"lineBreak":true},{"text":"Gyãwãndenↄ mɛ́ òdi futɛ ò n sáabu kpá yá?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Òdi n gbɛ̃kɛ baba mira gũnn yá?","poem":1},{"lineBreak":true},{"text":"Òdi n náanikɛna yã o gyãwãnn yá?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ò n daboyãnↄ dↄ̃ gusira gũnn yá?","poem":1},{"lineBreak":true},{"text":"N yãmanakɛnanↄ dↄ̃na kú yãsãnguki gũnn yá?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dikiri, matɛn ↄ́ↄ dↄnnɛ,","poem":1},{"lineBreak":true},{"text":"ma aduakɛna kↄnkↄ dì ká n kĩnaa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bↄ́yãi ntɛn gímaii, Dikiri?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dera n mìkpɛrɛ zùmɛnɛɛ?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Má kú ga lɛ́i wɛ̃ndawɛ̃nda zaa ma kɛfɛnnakɛgↄrↄa,","poem":1},{"lineBreak":true},{"text":"n yã pãsĩnↄ tↄ̃̀ma, ma gↄ̃ sã̀ii.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N pↄfɛ̃namai dàmala,","poem":1},{"lineBreak":true},{"text":"n vĩnapↄnↄ ma kakatɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ò dàmala lán í bà zaa kↄnkↄ ari ↄkↄsi,","poem":1},{"lineBreak":true},{"text":"ò lìkamai mámmam.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N tò ma gbɛ̃nↄ kũ ma gbɛ̃nnanↄ ma zukũna,","poem":1},{"lineBreak":true},{"text":"gusira mɛ́ à gↄ̃̀ ma kpàasi ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}