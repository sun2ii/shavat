{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":90,"content":[{"type":"heading","content":["Luda kũ bisãsirio"]},{"type":"hebrew_subtitle","content":["Luda gbɛ̃ Musa aduakɛnaa."]},{"type":"verse","number":1,"content":[{"text":"Dikiri, ó utɛkimɛ n ũ wɛ̃̀ kũ wɛ̃̀ɛo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"De ń kpɛ́ ǹ kpinↄ kɛ,","poem":1},{"lineBreak":true},{"text":"de ń kpɛ́ ǹ zĩtɛ kũ anduniao kátɛ,","poem":1},{"lineBreak":true},{"text":"Ludamɛ n ũ zaa káaku ari gↄrↄ sĩnda pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"N dìtɛ kũ bisãsiri ɛra zĩtɛ,","poem":1},{"lineBreak":true},{"text":"ndì pińnɛ ò ɛra bùsun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wɛ̃̀ wàa sↄↄro dennɛ lán gↄrↄ do bà,","poem":1},{"lineBreak":true},{"text":"à dennɛ lán gĩa ke gwãani zaka bà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ndì bisãsiri sɛ́ kũ ga'io,","poem":1},{"lineBreak":true},{"text":"ò de lán sɛ̃̀ yĩda bà kↄnkↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Àdi butɛ kↄnkↄ à gbã,","poem":1},{"lineBreak":true},{"text":"àdi yitoro kũ ↄkↄsi à kori kɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N pↄfɛ̃ dì ó kakatɛ,","poem":1},{"lineBreak":true},{"text":"n patammanaa dì swɛ̃̀ kɛ̃ógu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ó yã vãninↄn katɛna n arɛ,","poem":1},{"lineBreak":true},{"text":"ó asiriyãnↄ bò gupuran n kùru.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ó gↄrↄ dì gɛ̃tɛ n pɛ̃tɛ̃ yãi,","poem":1},{"lineBreak":true},{"text":"ó wɛ̃̀ndii dì láka kũ ndanaao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ó wɛ̃̀ɛ dì ká baaakↄ̃ akuri,","poem":1},{"lineBreak":true},{"text":"tó ó gbãna sↄ̃, basiikↄ̃.","poem":1},{"lineBreak":true},{"text":"Wari kũ pↄsiraoon wɛ̃̀ɛ pìnↄ dì suowɛrɛ,","poem":1},{"lineBreak":true},{"text":"òdi gɛ̃tɛ likalika, akũ odì kpágui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dí mɛ́ à n pↄfɛ̃ gbãna lɛ́ dↄ̃ↄ?","poem":1},{"lineBreak":true},{"text":"n pɛ̃tɛ̃ zↄ̃kↄ̃ↄ kà vĩna kũ à de ò kɛnnɛ ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹ dadawɛrɛ ògↄ̃ ó wɛ̃̀ndi kutukɛ lɛ́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"de ò ↄ̃ndↄ̃ le ó swɛ̃̀ɛ gũn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dikiri, bↄrɛn ĩni n pↄfɛ̃ kpátɛɛ?","poem":1},{"lineBreak":true},{"text":"Ǹ n zↄ̀blerinↄ wɛ̃nda gwa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹ tó n gbɛ̃kɛ suwá lákũ gu dìgↄ̃ dↄ nà,","poem":1},{"lineBreak":true},{"text":"de ògↄ̃ pↄnna kɛ kũ ayuwiikɛnaao ari ó gↄrↄ lɛ́n.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ǹ ó pↄ kɛ nna ↄ kũ n tↄ̃̀wá gↄrↄ lɛ́n,","poem":1},{"lineBreak":true},{"text":"wari kũ o kɛ̀ wɛ̃̀ lɛ́n.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ǹ n yãkɛnanↄ mↄ ókↄ̃nↄ n zↄ̀blerinↄnɛ,","poem":1},{"lineBreak":true},{"text":"ǹ tó ó nɛ́nↄ n gbãna gakuri dↄ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dikiri ó Luda, ǹ tó ò n pↄnna le,","poem":1},{"lineBreak":true},{"text":"ǹ tó ó zĩ àre le,","poem":1},{"lineBreak":true},{"text":"ee, ǹ tó ó zĩ àre le.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}