{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":91,"content":[{"type":"heading","content":["Ludamɛ ó dãkpãri ũ"]},{"type":"verse","number":1,"content":[{"text":"Gbɛ̃ kũ à utɛna Luda Musude ↄĩ","poem":1},{"lineBreak":true},{"text":"nigↄ̃ kú Gbãnasĩndapinkide uraai.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ani pi Dikirimɛ a zɛki gbãna ũ,","poem":1},{"lineBreak":true},{"text":"a Ludamɛ a utɛki ũ, á a náani vĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Àkũ mɛ́ ani n sí kariia,","poem":1},{"lineBreak":true},{"text":"ani n sura ba kũ gagagyão.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ani n sↄtↄ a pↄtɛn, ĩnigↄ̃ utɛna a orun,","poem":1},{"lineBreak":true},{"text":"a náanikɛna mɛ́ ani n dãkpã lán sɛ̃gbako bà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gwãani karinↄ kũ fãnantɛ̃ kà vĩnlanↄ","poem":1},{"lineBreak":true},{"text":"ń ke vĩna ni n kũro,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ke gagagyã kũ àdigↄ̃ tɛ́ gusiran","poem":1},{"lineBreak":true},{"text":"ke gyãgɛ̃wɛ̃tɛ kũ àdi ń le fãnantɛ̃ gbãna.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bee tó gbɛ̃nↄn wàa sↄↄro tɛn lɛ́tɛ n sarɛ,","poem":1},{"lineBreak":true},{"text":"ke gbɛ̃nↄn dúbu kuri tɛn ga n ↄplai,","poem":1},{"lineBreak":true},{"text":"pↄ́ke ni n lero.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ĩni wɛ́ sɛ́ ǹ gwa,","poem":1},{"lineBreak":true},{"text":"ĩni e lákũ òdi wɛ́ tã yãvãnikɛrinↄa nà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tó n Luda Musude kɛ̀ n utɛki ũ,","poem":1},{"lineBreak":true},{"text":"tó n Dikiri kɛ̀ n kúki ũ,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"yã vãni ke ni n lero,","poem":1},{"lineBreak":true},{"text":"kisira ni gɛ̃ n ↄnnlo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zaakũ ani n yã o a malaikanↄnɛ,","poem":1},{"lineBreak":true},{"text":"de ò n dãkpã gu kũ ntɛn gɛ́n pínki.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Oni n sɛ́ ń ↄĩ","poem":1},{"lineBreak":true},{"text":"de ǹsun gɛ̃̀ sí gbɛ̀ɛaro yãi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ĩni gɛ̀sɛ zɛ músuua kũ káreo,","poem":1},{"lineBreak":true},{"text":"ĩni gɛ̀sɛ pɛ́tɛpɛtɛ sàbooa kũ pitikoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dikiri pì: Zaakũ à nàmai, mani a bo,","poem":1},{"lineBreak":true},{"text":"zaakũ à ma dↄ̃, mani ↄ kúa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ani ma sísi, mani wea,","poem":1},{"lineBreak":true},{"text":"tó yã nàkaraa, manigↄ̃ kú kãao,","poem":1},{"lineBreak":true},{"text":"mani a sura ba mà a kpe ta.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mani a pↄ kɛ nna kũ wɛ̃̀ndi gbã̀nao,","poem":1},{"lineBreak":true},{"text":"mani tó à e lákũ madì gbɛ̃ sura ba nà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}