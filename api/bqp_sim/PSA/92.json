{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":92,"content":[{"type":"heading","content":["Luda sáabukpanaa"]},{"type":"hebrew_subtitle","content":["Kámmabogↄrↄ lɛ̀ɛ."]},{"type":"verse","number":1,"content":[{"text":"À mana ò n sáabu kpá, Dikiri,","poem":1},{"lineBreak":true},{"text":"ò lɛ̀ sí ò n tↄ́ bo, Luda Musude,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ò n gbɛ̃kɛ baba kↄnkↄ,","poem":1},{"lineBreak":true},{"text":"ò n náanikɛyã o gwãani,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ò n táaki lɛ́ kũ mↄrↄↄo","poem":1},{"lineBreak":true},{"text":"kũ gidigboo kũ kontigiio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N yãkɛnanↄ dì ma pↄ kɛ nna, Dikiri,","poem":1},{"lineBreak":true},{"text":"madì ayuwii kɛ n ↄzĩkɛnanↄa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dikiri, n yãkɛnanↄn zↄ̃kↄ̃ manamana,","poem":1},{"lineBreak":true},{"text":"n laasunnↄn zã̀ à kɛ̀ zↄ̃kↄ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yↄ̃nkↄ yã pì dↄ̃ro,","poem":1},{"lineBreak":true},{"text":"mìsaride ni fↄ̃ à dↄ̀rↄ dↄ̃ro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bee tó gbɛ̃ vãninↄ fùtɛ ò gbã̀ lán sɛ̃̀ɛ bà","poem":1},{"lineBreak":true},{"text":"akũsↄ̃ yãvãnikɛrinↄ karana lè ń pínki,","poem":1},{"lineBreak":true},{"text":"ń zia bi kakatɛna lakanasarimɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mↄkↄ̃n sↄ̃ Dikiri,","poem":1},{"lineBreak":true},{"text":"ndìgↄ̃ kú musu gↄrↄ sĩnda pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ǹ gwa, n ibɛrɛnↄ tɛn láka,","poem":1},{"lineBreak":true},{"text":"vãnikɛrinↄ tɛn fãkↄ̃a ń pínki.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N ma gba gbãna lán zùsɛ̃ntɛ bà,","poem":1},{"lineBreak":true},{"text":"n nísi mana kù ma mìia.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma wɛ́ sì ma wɛtɛrinↄ lɛtɛnalɛ,","poem":1},{"lineBreak":true},{"text":"ma sã ma ibɛrɛ vãninↄ wikilɛnaa mà dↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gbɛ̃ mananↄ ni gbã lán domina línↄ bà,","poem":1},{"lineBreak":true},{"text":"oni kɛ zↄ̃kↄ̃ lán Lɛbana sida línↄ bà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ò pɛna Dikiri bɛ gũn,","poem":1},{"lineBreak":true},{"text":"oni gbã ó Luda ↄnn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bee kũ ń zĩkũkɛo onigↄ̃ nɛ́ imɛ,","poem":1},{"lineBreak":true},{"text":"ń lá nigↄ̃ tɛ́ kɛ síi plɛ̀plɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ò pi, Dikirin mana,","poem":1},{"lineBreak":true},{"text":"àkũmɛ ó gbɛ̀si ũ, vãni ke kú a gũnlo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}