{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":94,"content":[{"type":"heading","content":["Ludamɛ yãkpatɛkɛri ũ"]},{"type":"verse","number":1,"content":[{"text":"Dikiri Luda Mↄrakari,","poem":1},{"lineBreak":true},{"text":"Luda Mↄrakari, ǹ bo gupuran!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Andunia yãkpatɛkɛri, ǹ futɛ,","poem":1},{"lineBreak":true},{"text":"ǹ fĩna bo zĩdabirinↄa ń yãkɛnaaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃ vãninↄ nigↄ̃ pↄnna kɛ ari bↄrɛmɛɛ?","poem":1},{"lineBreak":true},{"text":"Ari bↄrɛmɛɛ, Dikiri?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yãvãnikɛrinↄ dì gↄ̃sa yã o,","poem":1},{"lineBreak":true},{"text":"òdi yã bↄtɛ òdi ĩa dã ń pínki.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dikiri, òdi n gbɛ̃nↄ dúgu zↄ̃,","poem":1},{"lineBreak":true},{"text":"òdi gbãna mↄ gbɛ̃ kũ n ń sɛ́nↄnɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Òdi gyaanↄnↄ kũ bòasunↄ dɛdɛ,","poem":1},{"lineBreak":true},{"text":"òdi tonɛnↄ kakatɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Òdi pi Dikiri dí ń ero,","poem":1},{"lineBreak":true},{"text":"Yakubu burinↄ Luda laakari kúḿmaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ákↄ̃nↄ yↄ̃nkↄnↄ, à laakari kɛ!","poem":1},{"lineBreak":true},{"text":"Ákↄ̃nↄ mìsaridenↄ, áni ↄ̃ndↄ̃ kũ bↄrɛmɛɛ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Luda mɛ́ à sã pɛ̀, ani gí yã mai yá?","poem":1},{"lineBreak":true},{"text":"À wɛ́ kɛ̀, ani gí gu ei yá?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Àdi burinↄ toto, ani ń sã gágaro yá?","poem":1},{"lineBreak":true},{"text":"Àdi yã dańnɛ, à dↄ̃na vĩro yá?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dikiri bisãsiri laasun dↄ̃,","poem":1},{"lineBreak":true},{"text":"kũ yã pãmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Arubarikademɛ gbɛ̃ kũ ndì toto","poem":1},{"lineBreak":true},{"text":"ǹ n doka dadanɛ ũ, Dikiri.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ndì a laakari kpátɛnɛ warikɛgↄrↄa","poem":1},{"lineBreak":true},{"text":"ari ò gɛ́ wɛ̀ɛ yↄ̃ vãnikɛriinɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dikiri ni pã kpá a gbɛ̃nↄiro,","poem":1},{"lineBreak":true},{"text":"ani gbɛ̃ kũ à ń sɛ́ a pↄ́ ũnↄ zukũnaro.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Oni ɛra ò yãkpatɛ kɛ a zɛ́a,","poem":1},{"lineBreak":true},{"text":"nɛ̀sɛpuradenↄ ni zɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dí mɛ́ ani futɛmɛnɛ gbɛ̃ vãninↄaa?","poem":1},{"lineBreak":true},{"text":"Dí mɛ́ ani zɛ kũmao yãvãnikɛrinↄ yã musuu?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tó adi kɛ Dikiri kpányĩ kɛ̀mɛnɛnlo,","poem":1},{"lineBreak":true},{"text":"de má kú miran kítikiti kↄ̀.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kũ ma pì guzãrɛ tɛni ma sɛ́tɛ,","poem":1},{"lineBreak":true},{"text":"n ma kũ n gbɛ̃kɛ gũn, Dikiri.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kũ laasun pà ma swɛ̃̀n,","poem":1},{"lineBreak":true},{"text":"n ma laakarii kpàtɛmɛnɛ n ma pↄ kɛ̀ nna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"N bàka nigↄ̃ kú kũ yãlɛkpɛrɛgↄ̃gↄ̃rinↄ kpataao yá?","poem":1},{"lineBreak":true},{"text":"Ń yãditɛnanↄ dì suńnɛ kũ wario.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Òdi lɛ́ kpákũsũ gbɛ̃ manai,","poem":1},{"lineBreak":true},{"text":"òdi yã da taarisaridela ò a dɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dikirimɛ ma zɛki gbãna ũ,","poem":1},{"lineBreak":true},{"text":"ma Ludamɛ gbɛ̀si kũ madì utɛn ũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ani ń vãnikɛna ɛraḿma,","poem":1},{"lineBreak":true},{"text":"ani ń buri bo ń taarinↄ yãi.","poem":1},{"lineBreak":true},{"text":"Dikiri ó Luda ni ń buri bo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}