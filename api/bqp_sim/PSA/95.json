{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":95,"content":[{"type":"heading","content":["Luda táakilɛnaa"]},{"type":"verse","number":1,"content":[{"text":"À mↄ́ ò pↄnna lɛ̀ sí Dikirinɛ,","poem":1},{"lineBreak":true},{"text":"ò ayuwii dↄ Gbɛ̀si kũ àdi ó sura baa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ò su a arɛ ò a sáabu kpá,","poem":1},{"lineBreak":true},{"text":"ò lɛ̀ sí ò a táaki lɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zaakũ Dikiri bi Luda kũ à zↄ̃kↄ̃mɛ.","poem":1},{"lineBreak":true},{"text":"Kína zↄ̃kↄ̃ↄmɛ, à de dikiri sĩnda pínkila.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zĩtɛ lòkoto kú a ↄĩ,","poem":1},{"lineBreak":true},{"text":"kpi mìsↄ̃ntɛnↄ bi a pↄ́mɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ísira bi a pↄ́mɛ, zaakũ à kɛ̀,","poem":1},{"lineBreak":true},{"text":"àkũ mɛ́ à zĩtɛ í kàsa kũ a ↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"À mↄ́ ò kútɛ ò donyĩ kɛ","poem":1},{"lineBreak":true},{"text":"ò wútɛ Dikiri ó Kɛ̀ri arɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zaakũ àkũmɛ ó Luda ũ,","poem":1},{"lineBreak":true},{"text":"a kpàsa gbɛ̃nↄmɛ ó ũ,","poem":1},{"lineBreak":true},{"text":"a sã kũ àtɛni ń dãnↄ ũ.","poem":1},{"lineBreak":true},{"text":"Tó a a kòtoo mà gbãra,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"àsun sãgbãna kɛ lákũ á dizinↄ kɛ̀ nà zaa Mɛribaro","poem":1},{"lineBreak":true},{"text":"ke Masa gↄrↄ kũ ò kú gbárannan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bee kũ ò ma yãkɛnanↄ è,","poem":1},{"lineBreak":true},{"text":"ò ma lɛ ò ma gwa gwe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Akũ ma pↄ fɛ̃̀ gbɛ̃ pìnↄi ari wɛ̃̀ bupla,","poem":1},{"lineBreak":true},{"text":"ma pì gbɛ̃ sãsãnanↄmɛ ń ũ,","poem":1},{"lineBreak":true},{"text":"ò ma zɛ́nↄ dↄ̃ro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Akũ ma la dà ma pↄfɛ̃ gũn ma pì,","poem":1},{"lineBreak":true},{"text":"oni gɛ̃ ma kámmabokinlo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}