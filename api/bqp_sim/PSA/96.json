{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":96,"content":[{"type":"heading","content":["Dikirimɛ Kína zↄ̃kↄ̃ ũ"]},{"type":"verse","number":1,"content":[{"text":"À lɛ̀ dufu sí Dikirinɛ,","poem":1},{"lineBreak":true},{"text":"andunia gbɛ̃ sĩnda pínki, à lɛ̀ sí Dikirinɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À lɛ̀ sí Dikirinɛ à a tↄ́ bo,","poem":1},{"lineBreak":true},{"text":"àgↄ̃ a surabana baaru kpá lákũ gu dìgↄ̃ dↄ nà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À a gakurikɛyã o burinↄnɛ,","poem":1},{"lineBreak":true},{"text":"à a yãbonsarɛnↄ baba gbɛ̃ sĩnda pínkinɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dikirin zↄ̃kↄ̃, à kà ò a táaki lɛ́,","poem":1},{"lineBreak":true},{"text":"à kũ̀ ò vĩna kɛnɛ de tãnanↄla ń pínki.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Burinↄ tãnanↄ bi pↄ́ ginanↄmɛ,","poem":1},{"lineBreak":true},{"text":"ama Dikiri mɛ́ à musu kɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zↄ̃kↄ̃kɛ kũ bɛ̀ɛrɛɛo kúa,","poem":1},{"lineBreak":true},{"text":"gbãna kũ gakurio kú a kúkiamɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À gakuri kũ gbãnao dↄ̃ Dikirinɛ,","poem":1},{"lineBreak":true},{"text":"bùsu sĩnda pínki gbɛ̃nↄ, à dↄ̃ Dikirinɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À Dikiri tↄ́ gakuri dↄ̃nɛ,","poem":1},{"lineBreak":true},{"text":"à mↄ́ kũ gbao à gɛ̃o a ↄnn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À donyĩ kɛ Dikirinɛ a kúadona manakɛn,","poem":1},{"lineBreak":true},{"text":"zĩtɛdenↄ, àgↄ̃ luka a arɛ á pínki.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À o burinↄnɛ, Dikiri tɛn kí ble.","poem":1},{"lineBreak":true},{"text":"Andunia katɛna gíngin, à yĩgãna vĩro,","poem":1},{"lineBreak":true},{"text":"ani yãkpatɛ kɛ kũ gbɛ̃ sĩnda pínkio a zɛ́a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Musudenↄ, à pↄnna kɛ,","poem":1},{"lineBreak":true},{"text":"zĩtɛdenↄ, à vĩ kũ pↄnnao,","poem":1},{"lineBreak":true},{"text":"ísira kũ pↄ́ kũ ò kunnↄ, à kĩni kɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sɛ̃̀ntɛ kũ pↄ́ kũ ò kunnↄ, à pↄnna wiki lɛ́,","poem":1},{"lineBreak":true},{"text":"lí kũ ò kú dàkoo gũnnↄ, à ayuwii kɛ á pínki.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Oni pↄnna kɛ Dikiri arɛ, zaakũ àtɛn su,","poem":1},{"lineBreak":true},{"text":"àtɛn su yãkpatɛ kɛ kũ anduniao.","poem":1},{"lineBreak":true},{"text":"Ani yãkpatɛ kɛ kũ anduniao a zɛ́a,","poem":1},{"lineBreak":true},{"text":"à yã gↄ̃gↄ̃ gbɛ̃nↄnɛ kũ yãpurao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}