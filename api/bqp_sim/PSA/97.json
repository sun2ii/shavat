{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":97,"content":[{"type":"heading","content":["Dikiri sunaa"]},{"type":"verse","number":1,"content":[{"text":"Dikiri mɛ́ àtɛn kí ble,","poem":1},{"lineBreak":true},{"text":"zĩtɛdenↄ pↄnna kɛ,","poem":1},{"lineBreak":true},{"text":"ísirabaradenↄ gↄ̃ kú pↄnna gũn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Legũ luku kũ gusira níkinikio likai,","poem":1},{"lineBreak":true},{"text":"manakɛ kũ yãzɛdeoomɛ a kpata zĩni ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɛ́ dìgↄ̃ kũ a arɛ,","poem":1},{"lineBreak":true},{"text":"àdi ibɛrɛ kũ ò likainↄ kpata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A legũpinaa dì zĩtɛ pu,","poem":1},{"lineBreak":true},{"text":"tó andunia è, àdi luka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kpinↄ dì yↄ́ lán zↄ́saa bà Dikiri arɛ,","poem":1},{"lineBreak":true},{"text":"andunia pínki Dikiri arɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Musudenↄ dì a manakɛ kpàkpa kɛ,","poem":1},{"lineBreak":true},{"text":"buri sĩnda pínki dì a gakuri e.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wé'i dì tãnagbagbarinↄ kũ ń pínki,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kũ òdi ĩa dã kũ pↄ́ ginanↄ.","poem":1},{"lineBreak":true},{"text":"Tãnanↄ ni donyĩ kɛnɛ ń pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Zaiↄ̃denↄ mà ò pↄnna kɛ̀,","poem":1},{"lineBreak":true},{"text":"Yuda wɛ̃tɛdenↄn kú pↄnna gũn","poem":1},{"lineBreak":true},{"text":"n yãkpatɛkɛnanↄ yãi, Dikiri.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Zaakũ ń kú musu de andunia pínkila,","poem":1},{"lineBreak":true},{"text":"Dikiri, ń de tãnanↄla ń pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dikiri ye gbɛ̃ kũ ò zã̀ yã vãninnↄi,","poem":1},{"lineBreak":true},{"text":"àdigↄ̃ a yãmarinↄ wɛ̃̀ndi dãkpã,","poem":1},{"lineBreak":true},{"text":"àdi ń bo yãvãnikɛrinↄ ↄĩ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gu dì dↄ gbɛ̃ mananↄa,","poem":1},{"lineBreak":true},{"text":"nɛ̀sɛpuradenↄn pↄnna vĩ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃ mananↄ, à pↄnna kɛ Dikiri gũn,","poem":1},{"lineBreak":true},{"text":"à a tↄ́ kũ à kú adona bo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}