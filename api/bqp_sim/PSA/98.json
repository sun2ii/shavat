{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":98,"content":[{"type":"heading","content":["Dikiri suna táakilɛnaa"]},{"type":"verse","number":1,"content":[{"text":"À lɛ̀ dufu sí Dikirinɛ,","poem":1},{"lineBreak":true},{"text":"zaakũ à yãbonsarɛnↄ kɛ̀,","poem":1},{"lineBreak":true},{"text":"à zĩ̀i blè kũ a ↄpla kũ à kú adona gbãnao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dikiri tò ò a surabanaa dↄ̃̀,","poem":1},{"lineBreak":true},{"text":"à a manakɛnaa mↄ̀ burinↄnɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛ kũ náani kũ à vĩ kũ Isarailanↄo dↄ̀n,","poem":1},{"lineBreak":true},{"text":"andunia lɛ́zɛkidenↄ ó Luda surabanaa è ń pínki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Andunia pínki, à pↄnna wiki lɛ́ Dikiria,","poem":1},{"lineBreak":true},{"text":"à kakũn kũ ayuwiikɛnaao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À mↄrↄlɛna ũ dↄ Dikirinɛ,","poem":1},{"lineBreak":true},{"text":"à mↄrↄ lɛ́nɛ kũ lɛ̀sinaao","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"kũ kãkãkipɛnaao kũ kuru yĩsãmpanaao.","poem":1},{"lineBreak":true},{"text":"À pↄnna wiki lɛ́ Dikiri ó Kínanɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ísira kũ pↄ́ kũ ò kunnↄ kĩni kɛ,","poem":1},{"lineBreak":true},{"text":"andunia kũ gbɛ̃ kũ ò kunnↄ ń pínki.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Swanↄ ↄkpa lɛ́ Dikiri arɛ,","poem":1},{"lineBreak":true},{"text":"kpinↄ ayuwii kɛ lɛɛlɛ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"zaakũ àtɛn su yãkpatɛ kɛ zĩtɛmɛ,","poem":1},{"lineBreak":true},{"text":"ani yãkpatɛ kɛ kũ anduniao a zɛ́a,","poem":1},{"lineBreak":true},{"text":"ani yã gↄ̃gↄ̃ gbɛ̃nↄnɛ kũ yãpurao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}