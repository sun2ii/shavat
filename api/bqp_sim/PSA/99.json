{"translation":{"id":"bqp_sim","name":"Luda yã takada kũ Bisã yão","website":"https://ebible.org/Scriptures/details.php?id=bqp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bqp","licenseNotes":null,"shortName":"SIM","englishName":"Bisa Bible","language":"bqp","textDirection":"ltr","sha256":"4f077f8abf9c91e03c088643a96bb62cca2d26190da1c5397a3a2f1c03300ecb","availableFormats":["json"],"listOfBooksApiLink":"/api/bqp_sim/books.json","numberOfBooks":65,"totalNumberOfChapters":997,"totalNumberOfVerses":25625,"languageName":"Busa","languageEnglishName":"Busa"},"book":{"id":"PSA","translationId":"bqp_sim","name":"ZABURA","commonName":"ZABURA","title":"ZABURA","order":19,"numberOfChapters":150,"sha256":"91eacd4279df584c04b4fd28a1e4d6b615bc939ff7a36cd18dcd840745a8841f","firstChapterNumber":1,"firstChapterApiLink":"/api/bqp_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bqp_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":99,"content":[{"type":"heading","content":["Luda kũ à kú adonaa"]},{"type":"verse","number":1,"content":[{"text":"Dikiri tɛn kí ble, burinↄ luka,","poem":1},{"lineBreak":true},{"text":"à vutɛna kɛrubunↄ dagura,","poem":1},{"lineBreak":true},{"text":"andunia yĩgã","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dikirin zↄ̃kↄ̃ Zaiↄ̃,","poem":1},{"lineBreak":true},{"text":"à de buri sĩnda pínkila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ò a tↄ́ zↄ̃kↄ̃ à naaside bo,","poem":1},{"lineBreak":true},{"text":"à kú adona.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kína pì gbãna vĩ, à ye yãzɛdei,","poem":1},{"lineBreak":true},{"text":"àkũ mɛ́ à yãkpatɛkɛna a zɛ́aa dà,","poem":1},{"lineBreak":true},{"text":"à yã gↄ̃̀gↄ̃ Yakubu burinↄnɛ a zɛ́a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À Dikiri ó Luda tↄ́ sɛ́ lei,","poem":1},{"lineBreak":true},{"text":"à kútɛ a tìntin arɛ,","poem":1},{"lineBreak":true},{"text":"à kú adona.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musa kũ Harunao kú a gbàgbarinↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"Samuɛlimɛ a sìsirinↄ doke ũ,","poem":1},{"lineBreak":true},{"text":"ò a sìsi, akũ à wèḿma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zaa tɛ́luku gũnn à yã òńnɛ,","poem":1},{"lineBreak":true},{"text":"ò a doka kũ a yãdannɛnanↄ kũna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dikiri ó Luda, n weḿma,","poem":1},{"lineBreak":true},{"text":"mↄkↄ̃mmɛ Luda kũ àdi ń taari kɛ̃ḿma ũ,","poem":1},{"lineBreak":true},{"text":"bee kũ abireo n ń yã vãninↄ wì ń musu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À Dikiri ó Luda tↄ́ sɛ́ lei,","poem":1},{"lineBreak":true},{"text":"à donyĩ kɛnɛ a kpi kũ à kú adona musu,","poem":1},{"lineBreak":true},{"text":"zaakũ Dikiri ó Luda kú adona.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bqp_sim/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bqp_sim/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bqp_sim/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}