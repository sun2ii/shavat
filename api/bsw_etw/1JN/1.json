 ሙጭስን ኡሱ ካአብዳመና ቁሉክያ።"]},{"type":"verse","number":10,"content":["ጩቦ ላኮፈልነኖ ጎአምኔ፥ ኡሱ ካጣራ የላና፤ ሃፉራና ኖ ኦሮ ላኮግሮ።"]}],"footnotes":[]},"thisChapterLink":"/api/bsw_etw/1JN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bsw_etw/1JN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bsw_etw/2PE/3.json","previousChapterAudioLinks":{},"numberOfVerses":10}