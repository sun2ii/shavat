{"translation":{"id":"bsw_etw","name":"አማቶ ኦኡሱብ","website":"https://ebible.org/Scriptures/details.php?id=bswe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bswe","licenseNotes":null,"shortName":"ETW","englishName":"Baiso: አማቶ ኦኡሱብ (New Testament)","language":"bsw","textDirection":"ltr","sha256":"f13affee54575ca1dd5fa4abd8407acbbc04740c648083f1963685e8468b7526","availableFormats":["json"],"listOfBooksApiLink":"/api/bsw_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7950,"languageName":"Baiso","languageEnglishName":"Baiso"},"book":{"id":"HEB","translationId":"bsw_etw","name":"እብራዊ","commonName":"እብራዊ","title":"ካኢብራዊ እባዶ ቶስ ካፋራመሮ ሀንዳ","order":58,"numberOfChapters":13,"sha256":"a55416a24a2095796817d2c178f75225fe2163ad0e4229599fe64bf973505b01","firstChapterNumber":1,"firstChapterApiLink":"/api/bsw_etw/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bsw_etw/HEB/13.json","totalNumberOfVerses":300},"chapter":{"number":1,"content":[{"type":"heading","content":["ዋ ኤረኬሳኮክ ጋራነ አዬሳኖ"]},{"type":"verse","number":1,"content":["ሆርኮስኮ ካየረ ዋ ራ ካሞጋንና ጎራታ ካሞጋኒ ጋራ ካሄገሮልነ ኦዶጆልካኑን አዬሰረ፤"]},{"type":"verse","number":2,"content":["ግዳ ጎአመን ካጋቾ ጌሲ ካመን ዱባ ጎጎኤሎን ካየለሮ ኤረኬሳኮክ ጋራነ ኖን አዬሰራ፤ አላም ዱባ ካኮመጠራ ኡሱያ።"]},{"type":"verse","number":3,"content":["ኡሱ ካባጃ ታዋ ሀንቃይሰ ካቱሳሮያ፤ ያዳሊቴሳና ዋኔ ዎታ ታኤካቶታ፥ ሃፉራኮክ ሁናይ አላም ዱባ እስክሰ አበራ፥ እባዶ ጩቦኮ ቁሎይሰ አባባተረ ዳሩሪ ካአቲ ዋኮት መርጌ ሀማጼ።"]},{"type":"heading","content":["ኤረ ካዋ ኤርግቻልኮ ካሮራሮ ላኖ"]},{"type":"verse","number":4,"content":["ኡሱን ካቤራ መገ ካኤርግቻ መገኮ ካሮራሮ ማንኮሌ ማራን፥ ኤረ ካዋ ኤርግቻኮ ኣሎ ካሮራሮያ።"]},{"type":"verse","number":5,"content":[{"text":"ዋ ዱዶ ኤርግቻል ኦሮ፥","poem":1},{"lineBreak":true},{"text":"“አት ኤረኬታ፥ አን ኩ ህታር ኡሙለራ”","poem":1},{"text":"ጎርቱን","poem":2},{"text":"“አን ኦዶ ሌሮዋ፥ ኡሱና ኤረኬ ልናራ”","poem":1},{"text":"ካኮንአመረ ማዮና ላግረ።","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ዋ ባርክ ኤረኬሳ አላም ቶስ ካኮፋራረ ጎራታ፥","poem":1},{"lineBreak":true},{"text":"“ኤርግቻ ካዋ ዱባ ኡሱን ሀሳጋደ” አመራ።","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ኤርግቻኮክ ጋራ፥","poem":1},{"lineBreak":true},{"text":"“ኤርግቻልና አምባል ኣን፥","poem":1},{"text":"ኦሀንዳራና ላጫ ካኤሌኔ ኣን የልናራ” አማራ።","poem":2}]},{"type":"verse","number":8,"content":["ኤረኬሳኮክ ጋራ አደ፤",{"text":"“ሄዶ! ኮርፍንጀካ ጅሩ ጅሮማኮ ታ ጅሩጅሮማ ጌሮን ግርናራ፤","poem":1},{"text":"ዎኖናትካና ሩሚ ባሪሳታ፤","poem":2}]},{"type":"verse","number":9,"content":[{"text":"አት ቁሉማ ጌላታ፤ ሜላነና ዲዳታ፤","poem":1},{"text":"ሂካኮት ኣላንቲ ዋ ሄዶካ ኩ አሳባተ፤","poem":2},{"lineBreak":true},{"text":"ሳትላልታኮ ሮርሰ ገጌሎ ታስሳቶ ዛይት ኩን ሽግደ” አማራ።","poem":2}]},{"type":"verse","number":10,"content":["ኡሱማለና፥",{"text":"ጎታኬ! “አት ሆራርጀ ኡል መጢተ፤","poem":2},{"text":"ዳሩርጆልና ገነታይ መጢተ፤","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"እሶ ዱባ ባይናራን፤","poem":1},{"lineBreak":true},{"text":"አት አደ ግርናታ፤","poem":1},{"text":"እሶ ዱባ ሳርስ ኣን ዶአይናራን።","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ጋሸ አንና አት ዱብናታ፤","poem":1},{"text":"እሶና ሳርስ ካዶአን ሳርስ ካኡሱቢ ጎጎኢግልሳማሮ ማለ ኢግልሳምናራን።","poem":2},{"text":"አት አርጌቶ አትታ፥","poem":1},{"text":"ጌስካዉን ጋቾ ላግቶ” አማራ።","poem":2}]},{"type":"verse","number":13,"content":["ዋ ኤርግቻል ኦሮ፤",{"text":"“ዲናካ ኦዶናትካ ሄገሊ ታ የሎይ","poem":2},{"text":"መርገቴይ ሀማጺ” ካኮንአመራ ማዮና ላግሮ።","poem":1}]},{"type":"verse","number":14,"content":["ኤርግቻል ዱባ ዋ አማን ካፋይናሮ እባዶን ሀንዳይን ኦፋራማራን ዋዉን ኦሀንዳራን አያናልያን።"]}],"footnotes":[]},"thisChapterLink":"/api/bsw_etw/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bsw_etw/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bsw_etw/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}