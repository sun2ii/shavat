{"translation":{"id":"bsw_etw","name":"አማቶ ኦኡሱብ","website":"https://ebible.org/Scriptures/details.php?id=bswe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bswe","licenseNotes":null,"shortName":"ETW","englishName":"Baiso: አማቶ ኦኡሱብ (New Testament)","language":"bsw","textDirection":"ltr","sha256":"f13affee54575ca1dd5fa4abd8407acbbc04740c648083f1963685e8468b7526","availableFormats":["json"],"listOfBooksApiLink":"/api/bsw_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7950,"languageName":"Baiso","languageEnglishName":"Baiso"},"book":{"id":"REV","translationId":"bsw_etw","name":"ራጋ","commonName":"ራጋ","title":"ራጋ ካያንሳ","order":66,"numberOfChapters":22,"sha256":"4ea0d52a941d9307bf6b7c9417d1ae3fc91fd0d12e2dc893076a886cfa7f1e04","firstChapterNumber":1,"firstChapterApiLink":"/api/bsw_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bsw_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":15,"content":[{"type":"heading","content":["ታጋቾ ኤንገ ካአበሮ ኤርግቻ"]},{"type":"verse","number":1,"content":["ካካለ ካአቲና ካሳዳምሮ ማላታ ዳሩሪ አን ዴ፤ ኤንገ ታዋ ፈሎይ ካኮሃታ ታጋቾ ታሌተቶ ኤንገ ቶዶባ ካአበሮ ኤርግቻል ቶዶባ አን ዴ።"]},{"type":"verse","number":2,"content":["ሂካኮ አባባየረ ኤለን ታኮለለዳንተቶ ማስቶቲ ኣን ኦላራን በከ ኣንክክ ማመ አን ዴ፤ ኡሱማለና ሱላለትና ሱላለትኮት ምስሊ፥ መገኬሳኮኒዕ ቶቶና ማላታ ካአዎዴሮ እባዶ ኣን ዴ፤ እሶና ዋ ካስሰሮ ክራን አቤንጉረን ማስቶቲ ኣን ኦላራን በከ ዶሌ አሌን ግረን።"]},{"type":"verse","number":3,"content":["ዋዉን ካሀንዳረ ካሙሴ ማዛሙርና ካኢዳዶ ማዛሙር ሃ አማ ዛማራ ግረን፥",{"text":"“ዱባ ካዳንዳታ ጎታ ሄዶ!","poem":1},{"text":"ፈሎኦታ ኦአቲና ኦሳዳምራንያን፤","poem":2},{"text":"ካጎሳ ዎኖ!","poem":1},{"text":"ራካና ቱኩልክና ካሩምያ፤","poem":2},{"noteId":2}]},{"type":"verse","number":4,"content":[{"text":"ጎታ! ኩ ካአብሳኖና","poem":1},{"text":"መገካ ካካባጂኖን አዮያ?","poem":2},{"lineBreak":true},{"text":"አት ካላል ቁሉክታ፤","poem":2},{"text":"ካሩም ፍርዳካ ማንኮሙተሮ ማራን","poem":1},{"text":"ጎሳ ዱባ ኤመይረ ኩ ሆረ ሳጋድናራ።”","poem":2}]},{"type":"verse","number":5,"content":["ሂካኮ አባባየረ ታአቶ ዳሰ ካኮግቶ ቁሉክ ምን ካዋ ዳሩሪ ባናመ ግራን አን ዴ፤"]},{"type":"verse","number":6,"content":["ኤንገ ቶዶባ ካአበራ ኤርግቻል ቶዶባ ቁሉክ ምን ካዋኮ ቤን፤ ሙጭ ካአመ ካሀንቃሮ ጉማራክ ሳርስ ሳርሳቴን ግረን፤ ጌግዮትሶይና ካዎርቂ ሞዋኖ ሞዋቴን ግረን።"]},{"type":"verse","number":7,"content":["ኔፎ ታአብቶ መጣ አፋርኮ ኮ ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮን ካግርናሮ ዋኮት ኤንገ ካኮአማጋንተቶ ቶዶባ ታዎርቂ ጡጋል እሶን ስሰ።"]},{"type":"verse","number":8,"content":["ቁሉክ ምን ካዋና ካባጃ ታዋኮና ሁናኮ ካከይ ኢዪ አማጋመ፤ ኤርግቻል ቶዶባ ታአበራ ኤንገ ቶዶባ ታጉዳቶ ማዮና ቁሉክ ምን ካዋ ኦሮድ ታብን ላኮዳንዴ።"]}],"footnotes":[{"noteId":2,"caller":"+","text":"ካጎሳ ዎኖ ኮኮ ማጻፋጆል “ካጌስጆል ዎኖ” አማራ።","reference":{"chapter":15,"verse":3}}]},"thisChapterLink":"/api/bsw_etw/REV/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bsw_etw/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bsw_etw/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}