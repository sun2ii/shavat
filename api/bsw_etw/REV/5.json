{"translation":{"id":"bsw_etw","name":"አማቶ ኦኡሱብ","website":"https://ebible.org/Scriptures/details.php?id=bswe","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bswe","licenseNotes":null,"shortName":"ETW","englishName":"Baiso: አማቶ ኦኡሱብ (New Testament)","language":"bsw","textDirection":"ltr","sha256":"f13affee54575ca1dd5fa4abd8407acbbc04740c648083f1963685e8468b7526","availableFormats":["json"],"listOfBooksApiLink":"/api/bsw_etw/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7950,"languageName":"Baiso","languageEnglishName":"Baiso"},"book":{"id":"REV","translationId":"bsw_etw","name":"ራጋ","commonName":"ራጋ","title":"ራጋ ካያንሳ","order":66,"numberOfChapters":22,"sha256":"4ea0d52a941d9307bf6b7c9417d1ae3fc91fd0d12e2dc893076a886cfa7f1e04","firstChapterNumber":1,"firstChapterApiLink":"/api/bsw_etw/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/bsw_etw/REV/22.json","totalNumberOfVerses":404},"chapter":{"number":5,"content":[{"type":"heading","content":["ማጻፋና ኢዳዶ"]},{"type":"verse","number":1,"content":["ኮርፍንጄ ጉት ካሀማጼራ ምና ታሳሬነና ታኦሮነ ካጻፋመሮ ማታማል ቶዶባይ ካባሳመሮ ካዱባመ ካጋልባ ማጻፋ ገነ ታመርጌይ አበ ግራን አን ዴ።"]},{"type":"verse","number":2,"content":["ካአቲ ኤርግቻት ኮ ታአቲ ያዬይ፥ “ማታማል ፉርንና ካዱባመሮ ካጋልባ ማጻፋ ባንን ካዶትሳራ አዮያ?” አመ አዬሳ ግራን አን ዴ።"]},{"type":"verse","number":3,"content":["አየሱን ጎአመን ዳሩርና ሌረ ኡሊ ጎርቱን ኡልኮ ሄገሌ ካዱባመሮ ካጋልባ ማጻፋ ኦሮ ባን ድን ካዳንዴ ማዮና ላኮግረ።"]},{"type":"verse","number":4,"content":["ካዱባመሮ ካጋልባ ማጻፋ ኦሮ ባን ድን ካኮንዶትሳረ ማንኮዋታመ ማራን አን ኣሎ ኦየ።"]},{"type":"verse","number":5,"content":["ሀሱ ጎራታ ጃርሶለኮ ኮ ኢነ፥ “አት አሮኦተ፤ ሂክማ ታይሁዳ ኣኒ ካሌራ ሉባን ታዳዉተ አላታንኮክ ህዲድኮ ካኬራ ኡሱ አዎደራ፤ ኡሱ ካዱባመሮ ካጋልባ ማጻፋና ማታማል ቶዶባ ባንን ዳንዳራ” አመ።"]},{"type":"verse","number":6,"content":["ሂካኮ አባባተረ ኔፎ ታአብቶ መጣ አፋር ጠኤ፥ ኮከ ካጎሳመሮ ኣን ካላሮ ጃርሶለ ጠኤ ካአሌሮ ኢዳዶ አን ዴ፤ ሂክ ኢዳዶትና ማሻ ቶዶባና ኢልኦ ቶዶባ አባናየ፤ እሶና ሂካ አላም ቶስ ኦፋራመራን ካዋ አያናልያን።"]},{"type":"verse","number":7,"content":["ሂክ ኢዳዶ ኤመተጉረ ኮርፍንጀ ጉት ካሀማጼሮኮት ገነ ታመርገኮ ካዱባመሮ ካጋልባ ማጻፋ ኣተ።"]},{"type":"verse","number":8,"content":["ካዱባመሮ ካጋልባ ማጻፋ ካኮአታረ ጎራታ ኔፎ ታአብታ መጣ አፋሮና ጃርሶለ ላማታንኮ አፋሮ ኡሱ ኢዳዶ ሆረ ግልቢሴን በቤዲ ኡል ኦዬን፤ እሶ መተመተይ በገና አባተን ግረን፤ ኡሱማለና ቁሎሌኮክ ኤብ ካሌራ ኢጣና ካኮአማጋመረ ካዎርቂ ሁይ ጃርሶ አባተን ግረን።"]},{"type":"verse","number":9,"content":["ካኡሱብ ማዛሙር ሃ አማ ዛማሬን፤",{"text":"“ኢግካይ ኣኒ ኣኒኮ፥ ሄኢ ህኢኮ፥","poem":1},{"text":"ኡናኡናኮ፥ ጎሳጎሳኮ","poem":2},{"text":"እባዶ ዋዉን ዎዶ ሊ ኤካስን፥","poem":1},{"text":"አት ማንኮኤናንተቶ ማራን","poem":2},{"lineBreak":true},{"text":"ካዱባመሮ ካጋልባ ማጻፋ ኣትን","poem":2},{"lineBreak":true},{"text":"ማታማልኬሳና ባንን ካዶትሳቶ ሌተታ፤","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ሄዶኬዉን ዎኖና ቱቃሞል","poem":1},{"text":"ጎጎሌራኑን አት እሶ የልተታ፤","poem":2},{"lineBreak":true},{"text":"ኡሊ ጉቲና ሬድናራን።”","poem":2}]},{"type":"verse","number":11,"content":["አን ኤሰራ ጎዴሮ ኮርፍንጄሊ፥ ኔፎ ካአባ መጣጆልና ጃርሶለይ ማራሙረ ካሞጋን ኤርግቻልኮት ያየ አን ማለ፤ ሞጋንክሶና ቶታም ካሄሌላሞንየ፤"]},{"type":"verse","number":12,"content":["ታአቲ ያዬይና፥",{"text":"“ኮከ ካጎሳመሮ ኢዳዶ ሁና፥ ዱሩማ፥","poem":1},{"text":"ቃሩማ፥ አታን፥ ጂናን፥ ካባጃና","poem":2},{"lineBreak":true},{"text":"ጋላታ አታይን ካዶትሳሮያ” አመን።","poem":2}]},{"type":"verse","number":13,"content":["ዳሩርና ኡሊ፥ ኡልኮ ሄገለና በከ፥ እሶ ኦሮ ታግታ መጣ ዱባ፥",{"text":"“ኮርፍንጀ ጉት ካሀማጼሮና ኢዳዶን","poem":1},{"text":"ጋላታ፥ ጂናን፥ ካባጃና ሁና","poem":2},{"lineBreak":true},{"text":"ጅሩ ጅሮማኮ ታ ጅሩ ጅሮማ ጌሮ ሀሌዎ!” እሶ አማ ግራን አን ማለ።","poem":2}]},{"type":"verse","number":14,"content":["ኔፎ ታአብታ መጣ አፋሮና፥ “ሀሚኒዕ!” አንተ፤ ላማታንኮ አፋሮ ጃርሶለና ግልቢሰንጉሬን በቤዲ ኡል ኦዬን ሳጋደን።"]}],"footnotes":[]},"thisChapterLink":"/api/bsw_etw/REV/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bsw_etw/REV/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bsw_etw/REV/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}