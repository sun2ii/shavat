,"poem":1},{"lineBreak":true},{"text":"«Ati erekkeetta, ani ku hittaari umulera»","poem":1},{"text":"goorttun","poem":2},{"text":"«Ani odo leerowa, usuna erekkee linnara»","poem":1},{"text":"kakkoonɂamere maayyona laagire.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Waa barkki erekkeessa alami tos kakkofarare goorata,","poem":1},{"lineBreak":true},{"text":"«Erggichcha kawaa dubba usuun hasagade» amera.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Erggichchakokki gara,","poem":1},{"lineBreak":true},{"text":"«Erggichchaalnna ambbal aani,","poem":1},{"text":"ohandaaranna lac'a kaɂeleenee aani yelinnara» amara.","poem":2}]},{"type":"verse","number":8,"content":["Erekkeessakokki gara ade;",{"text":"«Hedo! Korffinjekka jiruu jiroommakko taa jiruujiroomma geeroon girnnara;","poem":1},{"text":"wononatikkaanna rummii bariisatta;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ati k'ullumma geelatta; meellaneenna diidatta;","poem":1},{"text":"Hikkakkotti aalanttii Waa Hedokka ku assaabate;","poem":2},{"lineBreak":true},{"text":"Saatilaalttaakko roorise geggeloo tasisatto zayitii kuun shigide» amara.","poem":2}]},{"type":"verse","number":10,"content":["Usumaleenna,",{"text":"Goottakkee! «Ati horaarjje ul met't'iite;","poem":2},{"text":"Daruurjjolnna genettaayi met't'iite;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Iso dubba bayinnaraan;","poem":1},{"lineBreak":true},{"text":"Ati adde girnnatta;","poem":1},{"text":"Iso dubba sarssi aani doɂayinnaran.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gashe aaninna ati duubinnatta;","poem":1},{"text":"Isona sarssi kaddoɂan sarssi kaɂusubii goggoɂiggilssamaro malee iggilissaminaran.","poem":2},{"text":"Ati arggetto atitta,","poem":1},{"text":"Geeskkaawun gachcho laagitto» amara.","poem":2}]},{"type":"verse","number":13,"content":["Waa erggichchaal orroo;",{"text":"«Diinakkaa odonnatikkaa hegelii taa yellooyi","poem":2},{"text":"Merggetteeyi hamas's'ii» kakkoonɂamera maayyona laagiro.","poem":1}]},{"type":"verse","number":14,"content":["Erggichchaal dubba Waa ammani kafayyinnaro ibaaddon handdayin ofaramaraan Waawun ohandaaran ayyaanalyyaan."]}],"footnotes":[]},"thisChapterLink":"/api/bsw_ltw/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bsw_ltw/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bsw_ltw/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}