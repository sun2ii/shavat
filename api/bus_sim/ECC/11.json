{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"ECC","translationId":"bus_sim","name":"LAASUUDEE","commonName":"LAASUUDEE","title":"LAASUUDEE","order":21,"numberOfChapters":12,"sha256":"7aae04efe1a2a51cba2bb506881217fc87673049399d30c0d43769aa238c73d2","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bus_sim/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":["Ǹ gba da pↄ́bleeo gbɛ̃nↄnɛ,",{"text":"zĩkea nɛ́ e dↄ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ kpaatɛtɛ gↄ̃ↄn swɛɛplaaanↄnɛ ke sↄraagↄ̃,","poem":1},{"lineBreak":true},{"text":"zaakɛ ń mↄ́nzi kɛ̀ eé bùsu lee dↄ̃ro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tó ludambɛ sia kũ̀ kↄ̃n ío,","poem":1},{"lineBreak":true},{"text":"è ma tↄↄtɛa lou ũmɛ,","poem":1},{"lineBreak":true},{"text":"tó lí lɛ̀ɛ ↄfãntɛ̃bↄɛ kpa ke ↄfãntɛ̃gɛ̃kpɛn kpa,","poem":1},{"lineBreak":true},{"text":"guu kɛ̀ à lɛ̀ɛn, gwen ègↄ̃ daɛɛn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ à wɛ́ɛ dↄ ĩazi è pↄ́ tↄ̃ro,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ èe ludambɛ siaa gwaa è pↄ́ kɛ̃ro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lán ń wɛ̃̀ndibↄkii dↄ̃ro nà","poem":1},{"lineBreak":true},{"text":"ke nɛ́ kasana a da gbɛɛɛn,","poem":1},{"lineBreak":true},{"text":"nɛ́ fↄ̃ ǹ Luda Pↄ́pingikɛri zĩi dↄ̃ro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹ pↄ́ tↄ̃ kↄngↄ,","poem":1},{"lineBreak":true},{"text":"ǹton mɛa kɛ uusiɛro,","poem":1},{"lineBreak":true},{"text":"zaakɛ ń dↄ̃ tó à kparee bé eé aubarika kɛro.","poem":1},{"lineBreak":true},{"text":"Kɛ̀kiin yoo ke kɛ̀kãan yoo,","poem":1},{"lineBreak":true},{"text":"ke aↄ̃égↄ̃ maa ń píngin yoo, ń dↄ̃ro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gupura nna,","poem":1},{"lineBreak":true},{"text":"wɛ́ɛsina ↄfãntɛ̃lɛ è káńnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Baa tó gbɛ̃ wɛ̃̀ndi gbã̀a fↄ̃ àgↄ̃ dia,","poem":1},{"lineBreak":true},{"text":"à pↄnnaa kɛn píngi.","poem":1},{"lineBreak":true},{"text":"Baa kↄ̃n beeeo à laasuu lɛ́ gusia gurↄↄa,","poem":1},{"lineBreak":true},{"text":"zaakɛ aↄ̃égↄ̃ parimɛ.","poem":1},{"lineBreak":true},{"text":"Yã kɛ̀ èe mↄↄ píngi pãmɛ.","poem":1}]},{"type":"heading","content":["Lɛ́dana gↄ̃kparɛnↄa"]},{"type":"verse","number":9,"content":[{"text":"Gↄ̃kparɛ, ǹ pↄnnaa kɛ n ↄ̀wazikɛgurↄ,","poem":1},{"lineBreak":true},{"text":"ǹ tó n pↄↄ kɛ nna n gↄ̃kparɛkɛgurↄↄa.","poem":1},{"lineBreak":true},{"text":"Ǹ yã kɛ̀ n pↄↄ gbà kɛ","poem":1},{"lineBreak":true},{"text":"ǹ tɛ́ pↄ́ kɛ̀ kɛ̀nnɛɛzi,","poem":1},{"lineBreak":true},{"text":"mↄde à píngi guu ǹgↄ̃ dↄ̃","poem":1},{"lineBreak":true},{"text":"kɛ̀ Luda é yãkpaɛ kɛnyo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹton tó n pↄↄ yakaro,","poem":1},{"lineBreak":true},{"text":"ǹ n mɛ̀'ↄ̃ammanↄ gonla,","poem":1},{"lineBreak":true},{"text":"zaakɛ gↄ̃kparɛkɛ kↄ̃n mìkã siaao è gɛ̃ zɛ́lamɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}