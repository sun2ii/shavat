{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"JOB","translationId":"bus_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"297dbb778b2003586a296725595b5cc07acc167f1ed9ee2d154e31f1f1105b36","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bus_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":14,"content":[{"type":"heading","content":["Ayuba yã'ona Ludanɛ"]},{"type":"verse","number":1,"content":[{"text":"Gbɛ̃ntee è bↄ nↄgbɛ̃ kiiamɛ,","poem":1},{"lineBreak":true},{"text":"à wɛ̃̀ndi kusu, ègↄ̃ kuu yãkete sairo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"È pia lán lávu bà è kori kũ,","poem":1},{"lineBreak":true},{"text":"è gɛ̃tɛ lán ↄra bà è gì kɛro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃ beee takan nɛ́ wɛ́ɛ dↄnɛ","poem":1},{"lineBreak":true},{"text":"ǹ yãkpaɛ kɛoↄ́?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pↄ́ gbãsĩ é fↄ̃ à pↄ́ gbãsĩsai iↄ́?","poem":1},{"lineBreak":true},{"text":"Eé sí kɛro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N gbɛ̃ntee gurↄↄ dìɛnɛ,","poem":1},{"lineBreak":true},{"text":"à mↄ lɛ́ kú n ↄzĩ,","poem":1},{"lineBreak":true},{"text":"n à wɛ̃̀ lɛ́ dànɛ, eé fↄ̃ à vĩàlaro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹ wɛ́ɛ goa ǹ à tó gwe","poem":1},{"lineBreak":true},{"text":"ai à gurↄ lɛ́ papa lán ayazĩkɛri bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lí ègↄ̃ tãmaa vĩmɛ,","poem":1},{"lineBreak":true},{"text":"zaakɛ tó wà zↄ̃̀, è ɛara à pìto pá,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ à pìto dufu pì è furo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Baa tó à kãsãa zi kũ̀ tↄↄtɛ guu,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ à kusu gà bùsun,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"tó à í gũu mà, eé pìto pá,","poem":1},{"lineBreak":true},{"text":"eé gã̀ bↄ lán lí kɛ̀ wà pɛ̀ bà.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃ gà sↄ̃, ègↄ̃ daɛna sↄ̀rↄrↄ,","poem":1},{"lineBreak":true},{"text":"è tá ègↄ̃ kuu dↄro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lán sɛ̀bɛ'i è lago nà,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ swa'i è baba à yãa,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"lɛn gbɛ̃ntee è daɛ lɛ è fɛɛ dↄro,","poem":1},{"lineBreak":true},{"text":"ai ludambɛɛ gá gɛ̃tɛo, eé vuro,","poem":1},{"lineBreak":true},{"text":"eé vu kↄ̃n ii pìoro.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó nɛ́ ma utɛ gɛ̀wãan","poem":1},{"lineBreak":true},{"text":"ǹ ↄ kúma ai n pↄↄ wèrema dé!","poem":1},{"lineBreak":true},{"text":"Tó nɛ́ gurↄ lɛ́ diɛmɛ gwe","poem":1},{"lineBreak":true},{"text":"gbasa ǹ dↄ ma yãn dé!","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tó gbɛ̃ gà, eé ɛara àgↄ̃ kuuↄ́?","poem":1},{"lineBreak":true},{"text":"Tó lɛmɛ, mɛ́gↄ̃ wɛ́ɛ dↄↄ ma vunazi","poem":1},{"lineBreak":true},{"text":"ma ↄsikana guu gurↄ píngi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nɛ́ lɛ́ zumazi mɛ́ wenla,","poem":1},{"lineBreak":true},{"text":"nɛ́ mamↄma kɛ̀ má dɛ n ↄzĩi ũu bɛgɛɛ kɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gurↄↄ beeea n wɛ́ɛ égↄ̃ tɛ́ ma yãkɛnanↄzi,","poem":1},{"lineBreak":true},{"text":"mↄde nɛ́ ma durun yã da dↄro.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nɛ́ ma taarinↄ ká bↄ̀kↄn ǹ yi ǹ diɛ,","poem":1},{"lineBreak":true},{"text":"nɛ́ lá kú ma zaakɛna pìnↄla.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Lán kpiii è gboro à fãakↄ̃a nà,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ sĩ̀sĩ musu gbɛ̀ gbɛ̃̀ntɛ̃ è sↄ̃ki kpá,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"lán swa'i è gbɛ̀ lↄ́lↄ nà,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ í è bùsu sɛ́ɛ à táo,","poem":1},{"lineBreak":true},{"text":"lɛn nɛɛ̀ gbɛ̃ntee tãmaa nɛnɛ lɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ gbãaa mↄ́nɛ à tá, è su dↄro,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ tó à uu liɛ à anduna tó.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tó à nɛ́nↄ gↄ̃̀ gbɛ̃ bɛ̀ɛdeenↄ ũ, eé dↄ̃ro,","poem":1},{"lineBreak":true},{"text":"tó aↄ̃ kɛ̀ gbɛ̃ fétenↄ ũmɛ sↄ̃, eé ero.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wãwãan eégↄ̃ maa ado,","poem":1},{"lineBreak":true},{"text":"à zĩnda pↄsiaan ègↄ̃ kɛɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":22}