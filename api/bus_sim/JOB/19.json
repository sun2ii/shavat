{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"JOB","translationId":"bus_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"297dbb778b2003586a296725595b5cc07acc167f1ed9ee2d154e31f1f1105b36","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bus_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":19,"content":[{"type":"heading","content":["Ayuba wena a gbɛ̃nnanↄla"]},{"type":"verse","number":1,"content":["Ben Ayuba wè a gbɛ̃nnanↄla à bè:"]},{"type":"verse","number":2,"content":[{"text":"Ai bↄrɛn égↄ̃ ĩa daama,","poem":1},{"lineBreak":true},{"text":"àgↄ̃ ma nↄ̀sɛ yakaamɛ kↄ̃n yãzↄ̃zↄ̃ↄo?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A ma sↄ̃sↄ̃ à kɛ̀ gɛ̃̀n kuri sa,","poem":1},{"lineBreak":true},{"text":"ée ma faboo, wí è a kũro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó ma sãsãmɛ yãpura,","poem":1},{"lineBreak":true},{"text":"ma taari dɛ ma zĩnda yã ũmɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó a gi ée a zĩnda sɛɛ lezĩ dɛmala,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ ée ma taari ee yã kɛ̀ ma lee musu,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"àgↄ̃ dↄ̃ kɛ̀ Luda bé à yã kɛ̀ kɛ̀mɛ kpɛɛgãnda,","poem":1},{"lineBreak":true},{"text":"à takutɛɛ kpàkpamɛ à ma kũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mɛɛ̀ faaba wii lɛ́, gbɛ̃ke è wemalaro,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ mìsina ↄ́ↄ dↄ, yãzɛdee kuuro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Luda zɛ́ zↄ̃̀mɛ, gɛ̃kii kuuro,","poem":1},{"lineBreak":true},{"text":"à gusiaa dà ma zɛ́la.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À ma kpɛ bↄ̀,","poem":1},{"lineBreak":true},{"text":"à ma fùra gò.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"È ma wíwi kpɛ píngia ai ma yãa,","poem":1},{"lineBreak":true},{"text":"è ma tãmaa nɛ lán wè lí nɛ nà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"È a pↄfɛ̃ bↄbↄma,","poem":1},{"lineBreak":true},{"text":"è ma diɛ a ibɛɛ ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À zĩ̀kpɛɛnↄ è fɛɛmazi lɛdo,","poem":1},{"lineBreak":true},{"text":"aↄ̃è ma kagura kɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è bùra káɛ wà liga ma kpɛ́zi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"À tò ma gbɛ̃nↄ è kakↄ̃amao dↄro,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃ↄ ma dↄ̃ↄnↄ lɛ̀ zↄ̃̀ wà tàtamalɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma danɛnↄ pã kpàmazi,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃nnanↄ sã̀ ma yãn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma gↄ̃ nibↄ ũ ma bɛ zĩkɛrinↄnɛ,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ńnɛ lán bori zĩ̀tↄ bà.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó ma a bɛgwari sìsi, è wemala dↄro,","poem":1},{"lineBreak":true},{"text":"baa tó ma agbaa kpànɛ kↄ̃n ma zĩnda lɛ́o.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma lɛ́'ĩa è kɛ ma naↄ̃nɛ lɛ́fↄna ũmɛ,","poem":1},{"lineBreak":true},{"text":"ma vĩ̀inↄ kↄ̃n ma dãaronↄ yemazi dↄro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Baa nɛ́ ketenↄ è kya kámagu,","poem":1},{"lineBreak":true},{"text":"tó ma tɛna, aↄ̃ègↄ̃ ma faboomɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma kpàasinↄↄ ye ma yãziro,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃ yenzideenↄ bↄ̀ ma kpɛɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma mɛ̀ yitoo kũ̀,","poem":1},{"lineBreak":true},{"text":"à gↄ̃̀ féte kɛ̀ mɛ́ ga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"À ma wɛ̃nda gwa ma gbɛ̃nnanↄ,","poem":1},{"lineBreak":true},{"text":"à ma wɛ̃nda gwa, zaakɛ Luda ↄ tↄ̃̀mamɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"À kɛ̀ dia eè wɛ́ɛ dↄmɛ lán Luda è wɛ́ɛ dↄmɛ nà?","poem":1},{"lineBreak":true},{"text":"Ma nↄ̀bↄ sona e mↄ́awa lɛroo?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Lɛ wà ma yãnↄ kɛ̃̀","poem":1},{"lineBreak":true},{"text":"wà kà lán.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Lɛ wà kɛ̃̀ gbɛ̀a kↄ̃n gão,","poem":1},{"lineBreak":true},{"text":"wà beoma kpàɛn àgↄ̃ kuu ai gurↄ píngi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Zaakɛ má dↄ̃ kɛ̀ ma Zɛnyodee kuu,","poem":1},{"lineBreak":true},{"text":"eé fɛɛ à zɛ ma sèedadee ũ zãazãa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tó ma mɛ̀baa kɛ̀kii kàatɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ wɛ́ɛ si Ludalɛ mɛ̀ sai.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mɛ́ wɛ́ɛ siàlɛ ma zĩnda,","poem":1},{"lineBreak":true},{"text":"eé kɛmɛ gbɛ̃ zĩ̀tↄ ũro.","poem":1},{"lineBreak":true},{"text":"Yã pì ma kũna gbãa ma swɛ̃̀ guu.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"À kɛ̀ dia a wɛ́ɛ dↄ̀mɛ,","poem":1},{"lineBreak":true},{"text":"a bè mámbe ma a zĩnda lèo?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"À vĩa kɛ Luda fɛ̃ɛdaanɛ,","poem":1},{"lineBreak":true},{"text":"zaakɛ eé pↄfɛ̃ bↄbↄo zaakɛrinↄa,","poem":1},{"lineBreak":true},{"text":"lɛ àgↄ̃ dↄ̃ kɛ̀ yãkpaɛ e a dãa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":29}