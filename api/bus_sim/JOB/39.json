{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"JOB","translationId":"bus_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"297dbb778b2003586a296725595b5cc07acc167f1ed9ee2d154e31f1f1105b36","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bus_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"Ń zↄ̃ nɛ́'igurↄↄ dↄ̃ↄ́?","poem":1},{"lineBreak":true},{"text":"N gãsi è gurↄↄ kɛ̀ èe nɛ́ iiↄ́?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ ń nↄ̀ mↄↄ dↄdↄↄ́?","poem":1},{"lineBreak":true},{"text":"Nɛɛ̀ ń nɛ́'igurↄↄ dↄ̃ↄ́?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aↄ̃è kúɛ wà nɛ́ imɛ,","poem":1},{"lineBreak":true},{"text":"ben aↄ̃ nɛ́'iwãwãa è kpáɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aↄ̃ nɛ́nↄ è gbãa kũ sɛ̃̀n aↄ̃è pɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è gɛ̃ zɛ́la aↄ̃è su ń danↄa dↄro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dé bé à tò zaakisɛ̃tɛ gↄ̃̀ a zĩndanɛ?","poem":1},{"lineBreak":true},{"text":"Dé bé à à pòro à à gbàrɛɛ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma sɛ̃̀tɛ dìɛnɛ à bɛɛ ũmɛ,","poem":1},{"lineBreak":true},{"text":"ma tↄↄtɛ wisidee kɛ̀nɛ à kúkii ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"È pã kpá wɛ́tɛ kĩizi,","poem":1},{"lineBreak":true},{"text":"è a kpàkɛri zↄka maro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ègↄ̃ tɛ́ sĩ̀sĩnↄa àgↄ̃ sɛ̃̀ wɛtɛɛ,","poem":1},{"lineBreak":true},{"text":"ègↄ̃ kpáɛ kɛɛ pↄ́ ísinↄzi píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zùsɛ̃tɛ é we à zĩi kɛnnɛↄ́?","poem":1},{"lineBreak":true},{"text":"Eé we à i n zùnↄ karan yↄ́?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nɛ́ bà dↄa lɛ à bú wínnɛↄ́?","poem":1},{"lineBreak":true},{"text":"Nɛ́ gbóngo danɛ lɛ à kpasee kɛ̃nnɛↄ́?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nɛ́ náanɛ dↄa à gbãa bíta yãnzii?","poem":1},{"lineBreak":true},{"text":"Nɛ́ n zĩi tónɛↄ́?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɛ́ à náanɛ kɛ à n pↄ́wɛɛ sɛ́sɛ","poem":1},{"lineBreak":true},{"text":"à suonnɛ pↄ́wɛɛgbɛ̃kiiaↄ́?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Taataa è a dɛ̀bɛkãnↄ poro kↄ̃n pↄnnaao,","poem":1},{"lineBreak":true},{"text":"mↄde eé sí lɛ́kↄ̃zi kↄ̃n tokũ dɛ̀bɛkãoro.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"È nɛ́gbere da tↄↄtɛ,","poem":1},{"lineBreak":true},{"text":"è tó bùsu'ãatɛ̃ nɛ́gbere pìnↄ wã à pipi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À sã̀n kɛ̀ weé gà wà kɛ̀sɛ pɛ́ɛa à wíwi,","poem":1},{"lineBreak":true},{"text":"kesↄ̃ nↄ̀bↄsɛ̃tɛnↄ é táa oa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ègↄ̃ pãsĩ kↄ̃n a nɛ́nↄ,","poem":1},{"lineBreak":true},{"text":"nɛ́gↄ̃ dↄ̃ se à zĩnda nɛ́nↄnlo,","poem":1},{"lineBreak":true},{"text":"zĩ pã kɛna è kɛnɛ yãke ũro.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Zaakɛ mɛ́ɛ à gba ↄ̃ndↄ̃ↄro,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ à baka da faadeenↄ tɛ́ro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mↄde tó à fɛ̀ɛ à bↄ̀ kↄ̃n bào,","poem":1},{"lineBreak":true},{"text":"è gɛ̃ sↄ̃la à à dìri yáa dↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ḿbe nɛɛ̀ tó sↄ̃ gↄ̃ gbãaa vĩↄ́?","poem":1},{"lineBreak":true},{"text":"Ḿbe n sɛ̀sɛkã pɛ̀pɛnɛ à waaaↄ́?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ḿbe nɛɛ̀ tó àgↄ̃ vĩvĩi lán kwaa bàↄ́?","poem":1},{"lineBreak":true},{"text":"À pↄ́ bↄna à yĩn kĩi gbãaa è tó vĩa ń kũ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"È a gbá gáɛgaɛ guzurɛn,","poem":1},{"lineBreak":true},{"text":"è pↄnnaa kɛ a gbãaa yãnzi,","poem":1},{"lineBreak":true},{"text":"ben è gá da zĩ̀kpɛɛnↄlɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"È pↄ́ kɛ̀ wè vĩa kɛnɛ yáa dↄ,","poem":1},{"lineBreak":true},{"text":"swɛ̃̀ è kɛ̃nlo, è bↄru kpɛɛ fɛ̃ɛdaanɛro.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kà ègↄ̃ kĩi kɛɛ gbàran à musu,","poem":1},{"lineBreak":true},{"text":"sári lɛ̀ɛtɛgɛ kↄ̃n sári gésedeeo è pí.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tó wà zĩ̀kuu pɛ̀, ègↄ̃ a zĩnda dakii dↄ̃ro,","poem":1},{"lineBreak":true},{"text":"ègↄ̃ tↄↄtɛ lɛ́lɛɛ ègↄ̃ vĩvĩi ègↄ̃ kɛɛ kɛ̀ɛkɛɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tó wà kuu pɛ̀,","poem":1},{"lineBreak":true},{"text":"è pↄ́ bↄ a yĩn à be, ɛ̃hɛ̃!","poem":1},{"lineBreak":true},{"text":"Ègↄ̃ zĩ̀ ĩa sɛ́sɛɛ zaa zã̀azã","poem":1},{"lineBreak":true},{"text":"kↄ̃n gbɛ̃nsinↄ wii gbãaao kↄ̃n kuukɛnao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"N ↄ̃ndↄ̃ↄ bé à tò blɛa è yàa pá,","poem":1},{"lineBreak":true},{"text":"à a dɛ̀bɛ poro à gá sↄↄmɛtɛ kpaↄ́?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ḿbe ń dìɛ kúunɛ","poem":1},{"lineBreak":true},{"text":"àgae vĩa zãazãa à a sà da zaa musuↄ́?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Ègↄ̃ kú gbɛ̀ musu, gwen è in,","poem":1},{"lineBreak":true},{"text":"è zↄ̃ gbɛ̀ mìsↄ̃ntɛ̃a a aafia'ekii ũ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Zaa gwen ègↄ̃ kpáɛ kɛɛ pↄ́bleezi,","poem":1},{"lineBreak":true},{"text":"è wɛ́ɛ pá pↄ́nↄa kãaa.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Arun à nɛ́nↄ pↄ́blee ũ,","poem":1},{"lineBreak":true},{"text":"guu kɛ̀ pↄ́ gɛ̀ kún, gwen ègↄ̃ kún.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}