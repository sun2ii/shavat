{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"JOB","translationId":"bus_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"297dbb778b2003586a296725595b5cc07acc167f1ed9ee2d154e31f1f1105b36","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bus_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":4,"content":[{"type":"heading","content":["Ɛlifaza yãsina Ayubala"]},{"type":"verse","number":1,"content":["Ben Temana gbɛ̃ Ɛlifaza yã sìàla à bè:"]},{"type":"verse","number":2,"content":[{"text":"Asa tó gbɛ̃ yã ònnɛ, nɛ́ pↄ fɛ̃roo?","poem":1},{"lineBreak":true},{"text":"Zaakɛ mɛ́ fↄ̃ màgↄ̃ yĩtɛnaro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ǹ dↄn lán n lɛ́ dà gbɛ̃nↄa pari nà,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃ kɛ̀ aↄ̃ gbãaa yã̀anↄ gbà swɛ̃̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N yã gbɛ̃ kɛ̀ aↄ̃ↄe fuunↄ sɛ̀ lezĩ,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃ kɛ̀ aↄ̃ↄ busananↄ gbà gbãaa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɛ̀ yã n le sa, ben nɛ́ɛ fuu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ à sùmma, ben n bídi kɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N vĩakɛna Ludanɛ e n làakari kpáɛroo?","poem":1},{"lineBreak":true},{"text":"N kuuna taari sai è tó ǹgↄ̃ tãmaa vĩroo?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ laasuu lɛ́ ǹ gwa!","poem":1},{"lineBreak":true},{"text":"Kisia taarisaidee lè ziki ai à gàↄ́?","poem":1},{"lineBreak":true},{"text":"Mán wà gbɛ̃ maaanↄ kàatɛn zikii?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ yã zaa bú wì à yãkete tↄ̃̀a,","poem":1},{"lineBreak":true},{"text":"má è beee bé è bↄɛnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Luda lɛ́'ĩa bé è à kaatɛ,","poem":1},{"lineBreak":true},{"text":"à pↄ́ bↄna a yĩn bé è à dúgu zↄ̃.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À pũtãna kↄ̃n kòto gbãaao lán músu bà è yãa,","poem":1},{"lineBreak":true},{"text":"Luda è à swaa woronɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"È ga lán músu kɛ̀ nↄ̀bↄ wɛ̀tɛ à kòrazi bà,","poem":1},{"lineBreak":true},{"text":"à nɛ́nↄ é gbasa wà fãakↄ̃a.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ma yã kpãi mà ĩala,","poem":1},{"lineBreak":true},{"text":"yã pì asii gɛ̃̀ ma swãn.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gurↄↄ kɛ̀ mɛ́ɛ nana bɛ̃̀ɛ oo gwãavĩ,","poem":1},{"lineBreak":true},{"text":"gurↄↄ kɛ̀ gbɛ̃nↄ ii ò wà kà zã̀,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"vĩa ma kũ mɛ́ɛ lugalugaa,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀ píngi e lugaa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ĩa ke borii ma pa ma uua,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀kãsɛsɛ fɛ̀ɛ à zɛ̀.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kɛ̀ à zɛ̀, mɛ́ɛ à taka dↄ̃ro,","poem":1},{"lineBreak":true},{"text":"pↄ́ pì kú ma aɛ,","poem":1},{"lineBreak":true},{"text":"ben ma à kòto kpãi mà à bè,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"gbɛ̃ntee é fↄ̃ àgↄ̃ dɛ yãnnadee ũ Ludanɛↄ́?","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ é fↄ̃ àgↄ̃ zɛ̃na a Kɛ̀ri aɛↄ́?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Zaakɛ Luda è a malaikanↄ náanɛ kɛro,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ è a zↄ̀bleri pìnↄ taari e,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"wamↄwa kɛ̀ wa mɛ̀ dɛ lán gũ̀ kpɛ́ bà,","poem":1},{"lineBreak":true},{"text":"wa kasana dɛ bùsu kori ũ","poem":1},{"lineBreak":true},{"text":"bensↄ̃ wè wa dúgu zↄ̃ lán dã̀mboo bà,","poem":1},{"lineBreak":true},{"text":"weé wa pↄ́ o dↄↄ́?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Zaa kↄngↄ ai uusiɛ gbɛ̃nↄ è gaga,","poem":1},{"lineBreak":true},{"text":"aↄ̃è kaatɛ ai gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"wè ń tàasi kɛro.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Luda è ń kuta lí gborońnɛ,","poem":1},{"lineBreak":true},{"text":"ben aↄ̃è ga ↄ̃ndↄ̃kũsai.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}