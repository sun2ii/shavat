{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"JOB","translationId":"bus_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"297dbb778b2003586a296725595b5cc07acc167f1ed9ee2d154e31f1f1105b36","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bus_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":40,"content":[{"type":"heading","content":["Gbɛ̃ntee è fↄ̃ à Luda zaaa boro"]},{"type":"verse","number":1,"content":[{"text":"Ben Dii ɛ̀ara à bè Ayubanɛ:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mamↄma Gbãapingide,","poem":1},{"lineBreak":true},{"text":"nɛ́ ma taari e ǹ ma gba làakariↄ́?","poem":1},{"lineBreak":true},{"text":"Ludazaabori, ǹ yã wemala sa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Ben Ayuba wèàla à bè:"]},{"type":"verse","number":4,"content":[{"text":"Pↄ́ken ma ũro fá! Dian mɛ́ wenla nà?","poem":1},{"lineBreak":true},{"text":"Séde mà ↄ kú ma lɛ́a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma yã ò gɛ̃̀n do, mɛ́ ɛara mà o dↄro,","poem":1},{"lineBreak":true},{"text":"má ò gɛ̃̀n plaa se, mɛ́ yã sínla dↄro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Ben Dii ɛ̀ara à yã ò Ayubanɛ zàga'ĩa guu à bè:"]},{"type":"verse","number":7,"content":[{"text":"Ǹ fɛɛ ǹ zɛ lán nɛ́gↄ̃gbɛ̃ bà,","poem":1},{"lineBreak":true},{"text":"mɛ́ n lala yãzi, nɛ́ wemala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nɛ́ lá kú ma yãkɛna a zɛ́alan yↄ́?","poem":1},{"lineBreak":true},{"text":"Ń yezi ǹ ma taari e lɛ n yã bↄ nnan yↄ́?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N gã̀sã gbãaa kà ma pↄ́ ũↄ́?","poem":1},{"lineBreak":true},{"text":"N kòto é fↄ̃ à guu nigã lán ma pↄ́ bàↄ́?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹ bítakɛ kↄ̃n kíkɛɛo da pↄ́kãsã maaanↄ ũ,","poem":1},{"lineBreak":true},{"text":"ǹ gakui kↄ̃n bɛ̀ɛo da utadaa ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹ n pↄfɛ̃ bↄbↄḿma,","poem":1},{"lineBreak":true},{"text":"ǹ ĩadãrinↄ gwa kↄ̃n wɛ́ɛ zaaao ǹ wí daḿma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹ ĩadãrinↄ gwa kↄ̃n wɛ́ɛ zaaao ǹ ń pãɛ,","poem":1},{"lineBreak":true},{"text":"ǹ ń dúgu zↄ̃ guu kɛ̀ aↄ̃ↄ kún,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ǹ ń ká tú ń píngi,","poem":1},{"lineBreak":true},{"text":"ǹ ń yiyi ǹ ń ká gɛ̀wãan,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"mɛ́ gbasa mà n sáabu kpá,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n zĩ̀ blè kↄ̃n n gã̀sã gbãaao yãnzi.","poem":1}]},{"type":"heading","content":["Bↄrɛ yã"]},{"type":"verse","number":15,"content":[{"text":"Ǹ bↄrɛ gwa,","poem":1},{"lineBreak":true},{"text":"kɛ̀ ma à kɛ̀ lán ma n kɛ nà.","poem":1},{"lineBreak":true},{"text":"È sɛ̃̀ ble lán zù bàmɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À gbãaa kú à wógbaamɛ,","poem":1},{"lineBreak":true},{"text":"à yɛ̃̀ɛ kú à gbɛɛ báasiamɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"À vlãa porona lán sida lí bà,","poem":1},{"lineBreak":true},{"text":"à gbáda tĩi dɛ lán bàtãna bà.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"À wánↄↄ gbãa lán mↄ̀gotɛ̃ bà,","poem":1},{"lineBreak":true},{"text":"à gbánↄↄ dɛ lán mↄ̀ gò bà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"À bíta bé à dɛ pↄ́ bɛ̃ɛ kɛ̀ má kɛ̀nↄla píngi,","poem":1},{"lineBreak":true},{"text":"à Kɛ̀ri ado bé eé à fↄ̃.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Sĩ̀sĩnↄ musun è pↄ́ blen,","poem":1},{"lineBreak":true},{"text":"gwen nↄ̀bↄsɛ̃tɛnↄ è kↄ̃kↄ̃ on ń píngi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"È daɛ lɛ̀'itɛ gbáru,","poem":1},{"lineBreak":true},{"text":"ègↄ̃ sↄtↄↄ vↄ̃n dã̀dã guu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lɛ̀'itɛ ↄra è daàla,","poem":1},{"lineBreak":true},{"text":"swagbaranↄ è ligazi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Baa tó ísↄ̃ e vĩvĩi, è bídi kɛro,","poem":1},{"lineBreak":true},{"text":"tó Yoda ísↄ̃pɛɛna e à lɛ́ paa,","poem":1},{"lineBreak":true},{"text":"à làakari ègↄ̃ kpaɛnamɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Weé fↄ̃ wà à wɛ́ɛ wíwi wà à kũↄ́?","poem":1},{"lineBreak":true},{"text":"Weé fↄ̃ wà ↄ̃ndↄ̃ↄ daɛzi wà à yĩ fↄ̃ↄ́?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}