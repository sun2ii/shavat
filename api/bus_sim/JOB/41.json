{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"JOB","translationId":"bus_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"297dbb778b2003586a296725595b5cc07acc167f1ed9ee2d154e31f1f1105b36","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bus_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":41,"content":[{"type":"heading","content":["Kùkuku"]},{"type":"verse","number":1,"content":[{"text":"Nɛ́ fↄ̃ ǹ kùkuku kũ kↄ̃n daburuo","poem":1},{"lineBreak":true},{"text":"ǹ gáɛ ǹ bↄoↄ́?","poem":1},{"lineBreak":true},{"text":"Nɛ́ fↄ̃ ǹ bà dↄ à nɛ́nɛaↄ́?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nɛ́ fↄ̃ ǹ bà ká à yĩn-ↄ́?","poem":1},{"lineBreak":true},{"text":"Nɛ́ fↄ̃ ǹ à lɛ́tãnka fↄ̃ kↄ̃n kúraoↄ́?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Eé agbaa kpákpannɛ ǹ a gbarɛↄ́?","poem":1},{"lineBreak":true},{"text":"Eé bennɛ ǹ sùu kɛↄ́?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Eé wennɛ ǹ a sɛ́ n zↄ̀ ũ","poem":1},{"lineBreak":true},{"text":"ai a wɛ̃̀ndi lɛ́n yↄ́?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɛ́ à dato lán wè bãa dato nàↄ́?","poem":1},{"lineBreak":true},{"text":"Nɛ́ bà dↄa ǹ kpá n nɛ́nↄgbɛ̃nↄaↄ́?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sↄrↄkↄnↄ é kùkuku pì tↄkɛḿmaↄ́?","poem":1},{"lineBreak":true},{"text":"Aↄ̃é à líli latarinↄnɛↄ́?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɛ́ fↄ̃ ǹ à pápa kↄ̃n sakao ǹ à báa fↄ̃ↄ́?","poem":1},{"lineBreak":true},{"text":"Nɛ́ fↄ̃ ǹ à mì kɛ gyágya kↄ̃n sárioↄ́?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ wɛtɛ ǹ ↄ kɛa ǹ gwa!","poem":1},{"lineBreak":true},{"text":"Ɔsii pì yã é sãnguro,","poem":1},{"lineBreak":true},{"text":"nɛ́ si ǹ à taka kɛ dↄro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó nɛ́ɛ daa nɛ́ à fↄ̃, nɛ́ɛ n zĩnda kɛkɛɛmɛ,","poem":1},{"lineBreak":true},{"text":"tó n wɛ́ɛ sìàlɛ, n mɛ̀ è ganzimɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zaakɛ gbɛ̃ke kùgbãaa e ká à à go a gbɛ̀nlo,","poem":1},{"lineBreak":true},{"text":"dé bé eé fↄ̃ à zɛ ma aɛ sↄ̃ↄ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dé fĩa bé à dↄma, kɛ̀ mɛ́ bonɛ?","poem":1},{"lineBreak":true},{"text":"Pↄ́ kɛ̀ kú anduna guu píngi nɛ́ ma pↄ́mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mɛ́ gí kùkuku pì gbánↄ yã oziro","poem":1},{"lineBreak":true},{"text":"ke à gↄ̃sagbãakɛɛ ke à maakɛɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dé bé eé fↄ̃ à à tɛ̀ɛ gogoo?","poem":1},{"lineBreak":true},{"text":"Dé bé eé we à aizi kánɛ?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dé bé eé we à à lɛ́ wɛ̃kↄ̃a?","poem":1},{"lineBreak":true},{"text":"À swaa kà à gbɛ̃ naasi kũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À tɛ̀ɛ dɛ lán sɛngbangonↄ bà à kpɛɛa,","poem":1},{"lineBreak":true},{"text":"à didikↄ̃ana foo sai dↄ̀rↄdↄrↄ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À tɛ̀ɛ pìnↄ nana kↄ̃amɛ,","poem":1},{"lineBreak":true},{"text":"baa ĩa è gɛ̃kii ero.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aↄ̃ pɛ́pɛkↄ̃rɛna gíngin,","poem":1},{"lineBreak":true},{"text":"aↄ̃é sí gokↄ̃aro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó à yĩ sã̀, guu è pumɛ,","poem":1},{"lineBreak":true},{"text":"à wɛ́ɛ dɛ lán ↄfãntɛ̃ bↄɛna kↄngↄ bà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tɛ́nɛnɛ è bↄ à lɛ́n,","poem":1},{"lineBreak":true},{"text":"tɛ́pũtãna è bↄn dↄ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tɛ́sukpɛ ègↄ̃ bↄɛ à yĩn","poem":1},{"lineBreak":true},{"text":"lán í kɛ̀ wà dì tɛ́a èe pipii puusu bà.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"À lɛ́'ĩa è tó sĩsĩi tɛ́ sɛ́,","poem":1},{"lineBreak":true},{"text":"tɛ́nɛnɛ è bↄ à lɛ́n.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"À gbãaa kú à waaamɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ bↄ̀a mɛ̀ è kɛ kpã̀m.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"À báasi ègↄ̃ sↄ̃sↄ̃kↄ̃ana gíngin,","poem":1},{"lineBreak":true},{"text":"à naa gbãngbãn, è nigãro.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"À kù gbãa lán gbɛ̀ bà,","poem":1},{"lineBreak":true},{"text":"lán wísilↄgbɛ daa bà.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Tó à fɛ̀ɛ, swɛ̃̀ è kɛ̃ gↄ̃sagbãaanↄn,","poem":1},{"lineBreak":true},{"text":"aↄ̃è kↄ̃ kɛ̃guu wà kora gákiizi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Fɛ̃ɛdaa kɛ̀ wà à lɛ̀o píngi è bↄaro","poem":1},{"lineBreak":true},{"text":"ke sári ke kà ke saka.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"È mↄ̀si gwa lán kàba bàmɛ,","poem":1},{"lineBreak":true},{"text":"mↄ̀gotɛ̃ ègↄ̃ dɛnɛ lán lí mùna bàmɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"È bàa lɛ́ kànɛro,","poem":1},{"lineBreak":true},{"text":"gbɛ̀mba gbɛ̀ ègↄ̃ dɛnɛ lán ése ũkã bàmɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ègↄ̃ gò gwaa lán sɛ̃̀ kori bàmɛ,","poem":1},{"lineBreak":true},{"text":"sári kĩi ègↄ̃ dɛnɛ yáadↄziyã ũmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"À gbɛɛ tɛ̀ɛ dɛ lán takaso bà,","poem":1},{"lineBreak":true},{"text":"à gbɛ̀ ègↄ̃ tɛ́ bↄtↄngan","poem":1},{"lineBreak":true},{"text":"lán zùswaaro guwibↄ bà.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"È í ya a lↄ̀n lán í kɛ̀ èe pipii oroon bà,","poem":1},{"lineBreak":true},{"text":"è ísiaa dɛ lán nↄ́sidɛna bà.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Í kutuwina ègↄ̃ tɛ́ à kpɛɛ,","poem":1},{"lineBreak":true},{"text":"ísiaa pì è ya à kpɛɛ púu.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"À sáa kú anduna guuro,","poem":1},{"lineBreak":true},{"text":"ma pↄ́kɛnanↄ tɛ́ àmbe à vĩa vĩro.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"È nↄ̀bↄ kɛ̀ aↄ̃è ń zĩnda diɛ bítanↄ da pↄ́ke ũro,","poem":1},{"lineBreak":true},{"text":"àmbe nↄ̀bↄ kɛ̀ aↄ̃ dìɛ wà kànↄ kína ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}