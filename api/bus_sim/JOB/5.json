{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"JOB","translationId":"bus_sim","name":"AYUBA","commonName":"AYUBA","title":"AYUBA","order":18,"numberOfChapters":13,"sha256":"297dbb778b2003586a296725595b5cc07acc167f1ed9ee2d154e31f1f1105b36","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bus_sim/JOB/42.json","totalNumberOfVerses":345},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Ǹ lɛ́ zú sa ǹ ma, tó gbɛ̃ke é wenla.","poem":1},{"lineBreak":true},{"text":"Malaika kpareen nɛ́ aɛ dↄa?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Íbɛtɛkpana è yↄ̃nkↄↄ dɛ,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛgↄ̃aanↄ è mìsaidee kaatɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Má è yↄ̃nkↄↄ kãsãa pɛ̀ɛ,","poem":1},{"lineBreak":true},{"text":"ben kãsãa pì yↄ̀ kãndo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À nɛ́nↄↄ zã̀ kↄ̃n aafia'ekiio,","poem":1},{"lineBreak":true},{"text":"wè ń yã máɛmaɛńnɛ yãkpaɛkɛkiia,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ke è zɛ ń kpɛɛro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nↄadɛrinↄ è à bura pↄ́nↄ ble,","poem":1},{"lineBreak":true},{"text":"baa pↄ́ kɛ̀ à lɛ̀ lìgazinↄ,","poem":1},{"lineBreak":true},{"text":"ímidɛrinↄ è luga à auzikizi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kisia è fɛɛ bùsunlo,","poem":1},{"lineBreak":true},{"text":"nawɛ̃a è bↄɛ tↄↄtɛro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lán tɛ́pũtãna gana musu seka vĩro nà,","poem":1},{"lineBreak":true},{"text":"lɛn gbɛ̃ kɛ̀ wà ì píngi è nawɛ̃a e lɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tó mámbee sↄ̃, Ludan mɛ́ gbeka,","poem":1},{"lineBreak":true},{"text":"mɛ́ ma yã kpáɛ à aɛzĩ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"È yã bíta kɛ kɛ̀ weé fↄ̃ wà à gbá dↄ̃ro,","poem":1},{"lineBreak":true},{"text":"weé fↄ̃ wà à yãbↄnsaɛkɛnanↄ lɛ́ dↄ̃ro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"È tó lou ma tↄↄtɛa,","poem":1},{"lineBreak":true},{"text":"è tó à í dagula sɛ̃̀tɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"È gbɛ̃ busananↄ sɛ́ lezĩ,","poem":1},{"lineBreak":true},{"text":"è sósobikɛrinↄ gba pↄnnaa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"È yã kɛ̀ mↄnafikideenↄↄ e pɛɛa gboro,","poem":1},{"lineBreak":true},{"text":"lɛ ń ↄzĩi tóngↄ̃ aubarika vĩro yãnzi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"È ↄ̃ndↄ̃rinↄ kũ ń wɛ́ɛzɛ̃ɛ guu,","poem":1},{"lineBreak":true},{"text":"è tó yãlɛkpɛɛ'orinↄ yãgↄ̃gↄ̃na kɛ pã.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Guu è sia kũḿma fãantɛ̃,","poem":1},{"lineBreak":true},{"text":"aↄ̃è ↄ máɛmaɛ fãantɛ̃ lán gwãavĩ bà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"È takaasideenↄ bↄ gaa lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"è pↄ́saideenↄ bↄ gbãamↄnnɛrinↄ ↄzĩ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Beee yãnzi gbãasaideenↄↄ tãmaa vĩ,","poem":1},{"lineBreak":true},{"text":"yãzɛdesaideenↄ è yĩtɛ kyↄ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Aubarikadeen gbɛ̃ kɛ̀ Luda è à tòto kɛɛ ũ.","poem":1},{"lineBreak":true},{"text":"Tó Gbãapingidee e n swã gagaa, ǹton yãbuu tãro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Zaakɛ è gbɛ̃ kɛ̃nna ben è à bↄ̀ gwa,","poem":1},{"lineBreak":true},{"text":"è gbɛ̃ wíwi ben è à kɛ̃kↄ̃a.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Eé n bↄ yãn gɛ̃̀n swɛɛdo,","poem":1},{"lineBreak":true},{"text":"baa tó à kà gɛ̃̀n swɛɛplaa, kisia é n lero.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Eé n sí gaaa dekaagurↄ,","poem":1},{"lineBreak":true},{"text":"eé n bↄ fɛ̃ɛdaa lɛ́zĩ zĩ̀lan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dii é n bↄ gbɛ̃yakarinↄ ↄzĩ,","poem":1},{"lineBreak":true},{"text":"tó mↄ́nzi mↄ̀, vĩa é n kũro.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nɛ́ mↄ́nzi kↄ̃n nↄaao yáa dↄ,","poem":1},{"lineBreak":true},{"text":"nɛ́ vĩa kɛ nↄ̀bↄ pãsĩnↄnɛro.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Zaakɛ nɛ́gↄ̃ kuu aafia kↄ̃n gbɛ̀nↄ,","poem":1},{"lineBreak":true},{"text":"nɛ́gↄ̃ nna kↄ̃n nↄ̀bↄsɛ̃tɛnↄ,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"nɛ́gↄ̃ dↄ̃ kɛ̀ n ua égↄ̃ nna,","poem":1},{"lineBreak":true},{"text":"tó n gaa n kpàsan, pↄ́ke é kɛ̃sãro.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nɛ́gↄ̃ dↄ̃ kɛ̀ n nɛ́nↄ é kɛ pari,","poem":1},{"lineBreak":true},{"text":"n boriinↄ é dagula lán sɛ̃̀ bà.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nɛ́ zi kũ kótokoto ǹ gbasa ǹ ga","poem":1},{"lineBreak":true},{"text":"lán ése kɛ̀ mà wà kɛ̃̀ à gurↄↄa bà.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Kɛ̀ wa yã pì asii gbèka, lɛn à dɛ lɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ yã pì sí nɛ́gↄ̃ dↄ̃ kɛ̀ n zĩnda yãmɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}