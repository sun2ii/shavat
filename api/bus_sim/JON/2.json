{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"JON","translationId":"bus_sim","name":"YUNUSA","commonName":"YUNUSA","title":"YUNUSA","order":32,"numberOfChapters":4,"sha256":"4e2584472d813599124a93d8ce74df809fd7914b2d916c7dbb383d3f337a1b43","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/bus_sim/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Yunusa aduakɛna kpↄ̀ gbɛɛɛn"]},{"type":"verse","number":1,"content":["Zaa kpↄ̀ pì gbɛɛɛn Yunusa wɛ́ɛ kɛ̀ Dii a Ludaa à bè:"]},{"type":"verse","number":2,"content":[{"text":"Ma lɛ́ zù Diizi ma kagurakɛna guu,","poem":1},{"lineBreak":true},{"text":"ben à wèmala.","poem":1},{"lineBreak":true},{"text":"Zaa gɛ̀wãa lↄ̀n ma wii pɛ̀,","poem":1},{"lineBreak":true},{"text":"ben à ma yã mà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ma zu ísia lↄ̀n","poem":1},{"lineBreak":true},{"text":"ai zaa à guragura,","poem":1},{"lineBreak":true},{"text":"ísↄ̃ dìdima kↄ̃n à kakanao,","poem":1},{"lineBreak":true},{"text":"n ísↄ̃kana fùta táa ò ma mìla.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma bè n pɛma bↄna n kiia,","poem":1},{"lineBreak":true},{"text":"mↄde mɛ́ ɛara mà wɛ́ɛ si","poem":1},{"lineBreak":true},{"text":"n kpɛ́ kɛ̀ kú adonalɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Í ma kũ ma waalɛ,","poem":1},{"lineBreak":true},{"text":"í lↄ̀ ma mↄ,","poem":1},{"lineBreak":true},{"text":"burugu fĩ̀kã ma mìzi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma kpaɛ ai kpiiinↄ kãsãazi,","poem":1},{"lineBreak":true},{"text":"tↄↄtɛ zɛ́ kɛ̀ wɛ̃na vĩroo tàtamalɛ.","poem":1},{"lineBreak":true},{"text":"Ben n ma bↄ gɛ̀wãan,","poem":1},{"lineBreak":true},{"text":"n ma mì sì Dii ma Luda.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kɛ̀ má yezi mà anduna tó,","poem":1},{"lineBreak":true},{"text":"Dii, n yã dↄ̀magu,","poem":1},{"lineBreak":true},{"text":"ben ma wɛ́ɛ kɛ̀mma,","poem":1},{"lineBreak":true},{"text":"à n kii le ai n kpɛ́ kɛ̀ kú adonan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃ pↄ́ gina yã kũnanↄ kɛ̃̀ Luda aubarikaa,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"mapi sↄ̃, mɛ́ saa omma kↄ̃n sáabukɛnao,","poem":1},{"lineBreak":true},{"text":"mɛ́ lù kɛ̀ má sɛ̀nnɛɛ fĩa bo.","poem":1},{"lineBreak":true},{"text":"Dii bé è ń mì sí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Kɛ̀ Dii yã dà kpↄ̀ pìnɛ, ben à Yunusa pìsi ísiaa lɛ́zi."]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}