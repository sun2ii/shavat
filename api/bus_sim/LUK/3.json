{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"LUK","translationId":"bus_sim","name":"LUKU","commonName":"LUKU","title":"LUKU Baaru nnaa kɛ̀ Luku kɛ̃̀","order":42,"numberOfChapters":24,"sha256":"6d2bfbb2341f5a2d6fbe79f324ae6d836e213da8e0c8f1882adc06e4e4b89de3","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bus_sim/LUK/24.json","totalNumberOfVerses":1148},"chapter":{"number":3,"content":[{"type":"heading","content":["Yaaya Batisikɛri waazikɛna"]},{"type":"verse","number":1,"content":["Siza Tiberia kíblena wɛ̃̀ gɛ̃rodee guu Pↄntiu Pilatin Yudea bùsu gbɛ̃nsi ũ, Hɛrↄdu e kí blee Galili, à vĩ̀i Filipi e kí blee Iturea bùsun kↄ̃n Tarakↄniti bùsuo, Lisania sↄ̃ↄ e kí blee Abilɛnɛ bùsun."]},{"type":"verse","number":2,"content":["Anasa kↄ̃n Kayafaon sa'orikinↄ ũ. Gurↄↄ mↄ̀a Luda yã ò Zakari nɛ́ Yaayanɛ gbáan."]},{"type":"verse","number":3,"content":["Ben à fɛ̀ɛ èe ligaa Yoda baa kãa kpa kↄ̃n baa kɛ̀ kpaaozi píngi, èe waazi kɛɛ gbɛ̃nↄnɛ. À òńnɛ aↄ̃ ń nↄ̀sɛ liɛ aↄ̃ batisi kɛ, Luda é ń durunnↄ kɛ̃ńnɛ."]},{"type":"verse","number":4,"content":["Lán à kú annabi Isaya takada guu nà à bè:",{"text":"À baarukpari kòto ma dↄ gbáan,","poem":1},{"lineBreak":true},{"text":"èe bee à zɛ́ kɛkɛ Diinɛ,","poem":1},{"lineBreak":true},{"text":"à zɛ́ wɛ́wɛnↄ poronɛ súusu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Guzurɛ píngi é tata,","poem":1},{"lineBreak":true},{"text":"kpiiinↄ kↄ̃n sĩ̀sĩnↄ é daɛ píngi.","poem":1},{"lineBreak":true},{"text":"Zɛ́ kotinanↄ é poro súusu,","poem":1},{"lineBreak":true},{"text":"zɛ́ wokũwokũnↄ é kpakↄ̃sↄ̃,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"gbɛ̃ sãnda píngi é e lán Luda è ń mì sí nà.","poem":1}]},{"type":"verse","number":7,"content":["Gbɛ̃nↄ ègↄ̃ mↄↄ à kiia pari aↄ̃ batisi kɛ, ben è beńnɛ: Gbɛ̃ntee pitigoonↄ! Dé bé à lɛ́ dàawa à bàa sí pↄfɛ̃ kɛ̀ Luda é pitaḿmanɛ?"]},{"type":"verse","number":8,"content":["À nↄ̀sɛliɛna yã kɛ, weégↄ̃ dↄ̃ kɛ̀ a liɛ. Kɛ̀ Ibraĩ dɛ a dezi ũ, àtongↄ̃ daa kɛ̀ beee bé eé a bↄro. Mɛ́ɛ ooare, Luda é fↄ̃ à gbɛ̀ kɛ̀nↄ kɛ Ibraĩ boriinↄ ũ."]},{"type":"verse","number":9,"content":["Kpása diɛna línↄzi kↄ̀. Luda é lí kɛ̀ è nɛ́ maaa iroo zↄ̃ à zu tɛ́ guu."]},{"type":"verse","number":10,"content":["Gbɛ̃nↄ à là wà bè: Tó lɛmɛ, wé kɛ diamɛ?"]},{"type":"verse","number":11,"content":["À wèńla à bè: Gbɛ̃ kɛ̀ uta vĩ mɛ̀n plaaa à à doo kpá gbɛ̃ kɛ̀ vĩrooa. Gbɛ̃ kɛ̀ pↄ́blee vĩ à kɛ lɛ dↄ."]},{"type":"verse","number":12,"content":["Bɛ'ↄↄsirinↄ mↄ̀ batisi kɛ, ben aↄ̃ à là wà bè: Dannɛri, wé kɛ diamɛ?"]},{"type":"verse","number":13,"content":["À wèńla à bè: Àton bɛ'ↄↄ síḿma dɛ lán wà dìɛ nàlaro."]},{"type":"verse","number":14,"content":["Sozanↄ à là: Wapinↄ sↄ̃, wé kɛ diamɛ? À bèńnɛ: Àton gbãaa mↄ gbɛ̃nↄnɛ à ń blero. À zɛ kↄ̃n fĩa kɛ̀ wè boareeo."]},{"type":"verse","number":15,"content":["Gbɛ̃nↄ tãmaa e kaara. Baade píngi e laasuu lɛɛ a nↄ̀sɛ guu Yaaya yãa, tó àmbe Mɛsaya ũ."]},{"type":"verse","number":16,"content":["Yaaya bèńnɛ ń píngi: Mɛɛ̀ a batisi kɛ kↄ̃n íomɛ, mↄde gbɛ̃ke é mↄ́ à gbãaa dɛmala, mɛ́ɛ ká mà à kyatee bↄbↄnɛro. Àmbe eé a batisi kɛ kↄ̃n Luda Ninio kↄ̃n tɛ́o."]},{"type":"verse","number":17,"content":["À gbaka kũna kɛ̀ eé pↄ́ fão. Eé pↄ́wɛɛ ká a dↄ̃̀n, eé à sàko ká tɛ́ kɛ̀ è garoo guu."]},{"type":"verse","number":18,"content":["Yaaya baaru nna kpannɛna guu à nàkↄ̃rɛḿma kↄ̃n yã pãndenↄo pari."]},{"type":"verse","number":19,"content":["Ben à kpã̀kɛ̃ kí Hɛrↄduzi a vĩ̀i naↄ̃ Hɛrↄdia yã musu kↄ̃n yã zaa pãnde kɛ̀ à kɛ̀nↄ píngi,"]},{"type":"verse","number":20,"content":["ben Hɛrↄdu ɛ̀ara à yã zaaa kɛ̀ dↄ, à Yaaya dà kpɛ́siaan."]},{"type":"heading","content":["Yesu batisikɛna"]},{"type":"verse","number":21,"content":["Kɛ̀ Yaaya e gbɛ̃nↄ batisi kɛɛ ń píngi, à Yesu batisi kɛ̀ se. Gurↄↄ kɛ̀ Yesu e adua kɛɛ, ludambɛɛ wɛ̃̀kↄ̃a,"]},{"type":"verse","number":22,"content":["ben Luda Nini sùa, à dɛ lán pↄ̃tɛ̃ɛ bà. Ben à kòto mà bↄna ludambɛ à bè: Ḿbe ma Nɛ́ mɛ̀n do léle yenzidee ũ, kɛ̀ ma pↄↄ nnamma maamaa."]},{"type":"heading","content":["Yesu bori bↄzia"]},{"type":"verse","number":23,"content":["Gurↄↄ kɛ̀ Yesu nà a zĩia, à kà wɛ̃̀ baaakuri taka. Wèe daa Yusufu nɛ́'inamɛ.",{"text":"Yusufu sↄ̃ Eli nɛ́mɛ,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Eli sↄ̃ Matata nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Matata sↄ̃ Levi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Levi sↄ̃ Mɛlɛki nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Mɛlɛki sↄ̃ Yanai nɛ́mɛ,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yanai sↄ̃ Yusufu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yusufu sↄ̃ Matatia nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Matatia sↄ̃ Amↄsi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Amↄsi sↄ̃ Naumu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Naumu sↄ̃ Ɛsɛli nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛsɛli sↄ̃ Nagai nɛ́mɛ,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nagai sↄ̃ Maata nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Maata sↄ̃ Matatia nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Matatia sↄ̃ Sɛmɛi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Sɛmɛi sↄ̃ Yosɛki nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yosɛki sↄ̃ Yoda nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yoda sↄ̃ Yoanana nɛ́mɛ,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yoanana sↄ̃ Resa nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Resa sↄ̃ Zɛrubabɛli nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Zɛrubabɛli sↄ̃ Sealatiɛli nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Sealatiɛli sↄ̃ Nɛri nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Nɛri sↄ̃ Mɛlɛki nɛ́mɛ,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mɛlɛki sↄ̃ Adi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Adi sↄ̃ Kosamu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Kosamu sↄ̃ Ɛlɛmadamu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛlɛmadamu sↄ̃ Ɛɛ nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛɛ sↄ̃ Yↄsua nɛ́mɛ,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yↄsua sↄ̃ Ɛliɛza nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛliɛza sↄ̃ Yorimu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yorimu sↄ̃ Matata nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Matata sↄ̃ Levi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Levi sↄ̃ Simɛↄ nɛ́mɛ,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Simɛↄ sↄ̃ Yuda nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yuda sↄ̃ Yusufu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yusufu sↄ̃ Yonamu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yonamu sↄ̃ Ɛliakimu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛliakimu sↄ̃ Mɛlɛa nɛ́mɛ,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Mɛlɛa sↄ̃ Mɛna nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Mɛna sↄ̃ Matata nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Matata sↄ̃ Natã nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Natã sↄ̃ Dauda nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Dauda sↄ̃ Yɛsɛ nɛ́mɛ,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Yɛsɛ sↄ̃ Ɔbɛdi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɔbɛdi sↄ̃ Bↄaza nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Bↄaza sↄ̃ Salamↄ nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Salamↄ sↄ̃ Nasↄ̃ nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Nasↄ̃ sↄ̃ Aminadabu nɛ́mɛ,","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Aminadabu sↄ̃ Ramu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ramu sↄ̃ Ɛzɛrↄnu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛzɛrↄnu sↄ̃ Pɛrɛzi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Pɛrɛzi sↄ̃ Yuda nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yuda sↄ̃ Yakubu nɛ́mɛ,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Yakubu sↄ̃ Isaaku nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Isaaku sↄ̃ Ibraĩ nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ibraĩ sↄ̃ Tera nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Tera sↄ̃ Nao nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Nao sↄ̃ Serugu nɛ́mɛ,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Serugu sↄ̃ Rɛu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Rɛu sↄ̃ Pɛlɛgi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Pɛlɛgi sↄ̃ Eberu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Eberu sↄ̃ Sela nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Sela sↄ̃ Kaina nɛ́mɛ,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Kaina sↄ̃ Apasada nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Apasada sↄ̃ Sɛmu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Sɛmu sↄ̃ Nuu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Nuu sↄ̃ Lamɛki nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Lamɛki sↄ̃ Mɛtusela nɛ́mɛ,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Mɛtusela sↄ̃ Ɛnↄku nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛnↄku sↄ̃ Yarɛdi nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Yarɛdi sↄ̃ Malalɛli nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Malalɛli sↄ̃ Kenana nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Kenana sↄ̃ Ɛnↄsu nɛ́mɛ,","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Ɛnↄsu sↄ̃ Sɛti nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Sɛti sↄ̃ Adamu nɛ́mɛ,","poem":1},{"lineBreak":true},{"text":"Adamu sↄ̃ Luda nɛ́mɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/LUK/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/LUK/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/LUK/2.json","previousChapterAudioLinks":{},"numberOfVerses":38}