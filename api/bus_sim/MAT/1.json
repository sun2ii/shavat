{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"MAT","translationId":"bus_sim","name":"MATIU","commonName":"MATIU","title":"MATIU Baaru nnaa kɛ̀ Matiu kɛ̃̀","order":40,"numberOfChapters":28,"sha256":"ee42a0cd4d73855ec9c6bfe0cec27100e573efc1aa1394feb0d4c6fbc40546ca","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/bus_sim/MAT/28.json","totalNumberOfVerses":1068},"chapter":{"number":1,"content":[{"type":"heading","content":["Yesu Kirisi bori bↄzia"]},{"type":"verse","number":1,"content":["Ibraĩ kↄ̃n Daudao bori Yesu Kirisi bↄzian yɛ̀:"]},{"type":"verse","number":2,"content":[{"text":"Ibraĩ Isaaku ì,","poem":1},{"lineBreak":true},{"text":"Isaaku Yakubu ì,","poem":1},{"lineBreak":true},{"text":"Yakubu Yuda ì kↄ̃n a vĩ̀inↄ kↄ̃n a dãaronↄ,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuda Pɛrɛzi kↄ̃n Zɛrao ì kↄ̃n a nↄ Tamao,","poem":1},{"lineBreak":true},{"text":"Pɛrɛzi Ɛzɛrↄnu ì,","poem":1},{"lineBreak":true},{"text":"Ɛzɛrↄnu Ramu ì,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ramu Aminadabu ì,","poem":1},{"lineBreak":true},{"text":"Aminadabu Nasↄ̃ ì,","poem":1},{"lineBreak":true},{"text":"Nasↄ̃ Salamↄ ì,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salamↄ Bↄaza ì kↄ̃n a nↄ Rahabuo.","poem":1},{"lineBreak":true},{"text":"Bↄaza Ɔbɛdi ì kↄ̃n a nↄ Rutuo,","poem":1},{"lineBreak":true},{"text":"Ɔbɛdi Yɛsɛ ì,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ben Yɛsɛ kí Dauda ì.","poem":1},{"lineBreak":true},"Ben Dauda Sulemanu ì kↄ̃n Uria naↄ̃o,"]},{"type":"verse","number":7,"content":[{"text":"Sulemanu Reoboamu ì,","poem":1},{"lineBreak":true},{"text":"Reoboamu Abia ì,","poem":1},{"lineBreak":true},{"text":"Abia Asa ì,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa Yosafata ì,","poem":1},{"lineBreak":true},{"text":"Yosafata Yehoramu ì,","poem":1},{"lineBreak":true},{"text":"Yehoramu Uzia ì,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Uzia Yotamu ì,","poem":1},{"lineBreak":true},{"text":"Yotamu Aaza ì,","poem":1},{"lineBreak":true},{"text":"Aaza Ɛzɛkaya ì,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɛzɛkaya Manase ì,","poem":1},{"lineBreak":true},{"text":"Manase Amↄ ì,","poem":1},{"lineBreak":true},{"text":"Amↄ Yosia ì,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yosia Yoyakini ì kↄ̃n a dãaronↄ gurↄↄ kɛ̀ wà gbɛ̃nↄ kũ̀kũ wà tàńyo Babilↄnu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Tana kↄ̃n gbɛ̃nↄ Babilↄnu gbɛran Yoyakini Sealatiɛli ì,",{"text":"Sealatiɛli Zɛrubabɛli ì,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zɛrubabɛli Abiudu ì,","poem":1},{"lineBreak":true},{"text":"Abiudu Ɛliakimu ì,","poem":1},{"lineBreak":true},{"text":"Ɛliakimu Azↄ ì,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azↄ Zadↄki ì,","poem":1},{"lineBreak":true},{"text":"Zadↄki Akimu ì,","poem":1},{"lineBreak":true},{"text":"Akimu Ɛliudu ì,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ɛliudu Ɛlɛaza ì,","poem":1},{"lineBreak":true},{"text":"Ɛlɛaza Matã ì,","poem":1},{"lineBreak":true},{"text":"Matã Yakubu ì,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yakubu Mariama zã Yusufu ì,","poem":1},{"lineBreak":true},{"text":"ben Mariama Yesu kɛ̀ wè benɛ Mɛsaya ì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":["Zaa Ibraĩ gurↄↄnↄa ai à gàa pɛ́ Daudaa, de kↄ̃n a nɛ́o kuu gɛ̃ro dosaimɛ. Zaa Dauda gurↄↄnↄa ai gurↄↄ kɛ̀ wà tà kↄ̃n gbɛ̃nↄo Babilↄnu, de kↄ̃n a nɛ́o kuu gɛ̃ro dosaimɛ. Zaa tana kↄ̃n gbɛ̃nↄo Babilↄnu ai à gàa pɛ́ Mɛsayaa, de kↄ̃n a nɛ́o kuu gɛ̃ro dosaimɛ."]},{"type":"heading","content":["Yesu Kirisi ina"]},{"type":"verse","number":18,"content":["Dian wà Yesu Kirisi ì nàn yɛ̀: À da Mariama kuu Yusufu nↄkpamma ũmɛ. Ai àgↄ̃ gá zã kɛ, à nↄ̀ sì kↄ̃n Luda Nini gbãaao."]},{"type":"verse","number":19,"content":["À gↄ̃kpamma Yusufu pì nɛ́ gbɛ̃ maaamɛ, à yezi à wí daaro, ben à zɛ̀o kɛ̀ é bↄ à yãn asii guu."]},{"type":"verse","number":20,"content":["Gurↄↄ kɛ̀ èe laasuu lɛɛ yã pìa, Dii malaika bↄ̀ à mↄ̀zi nanaa guu à bènɛ: Dauda bori Yusufu, ǹton bídi kɛ n nↄkpamma Mariama sɛna yã musuro, zaakɛ nↄ̀ kɛ̀ à sina bↄ̀ Luda Nini kiiamɛ."]},{"type":"verse","number":21,"content":["Eé nɛ́ i gↄ̃gbɛ̃ ũ, nɛ́ tↄ́ kpánɛ Yesu, zaakɛ eé a gbɛ̃nↄ bↄ ń durunnↄ guu."]},{"type":"verse","number":22,"content":["Beee kɛ̀ píngi, lɛ yã kɛ̀ Dii ò annabi gãzĩ kɛ, à bè:"]},{"type":"verse","number":23,"content":[{"text":"Nↄkparɛ lɛzii bé eé nↄ̀ sí","poem":1},{"lineBreak":true},{"text":"à nɛ́ i gↄ̃gbɛ̃ ũ,","poem":1},{"lineBreak":true},{"text":"weé tↄ́ kpánɛ Imanuɛli.","poem":1},"Tↄ́ pì bè, Ludaa kúwao."]},{"type":"verse","number":24,"content":["Kɛ̀ Yusufu vù, à kɛ̀ lán Dii malaika dìɛnɛ nà, à a nↄↄ pì sɛ̀."]},{"type":"verse","number":25,"content":["Mↄde èe à dↄ̃ nↄgbɛ̃ ũro ai à gàa à nɛ́gↄ̃gbɛ̃ pì ì. Ben à tↄ́ kpànɛ Yesu."]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/MAL/4.json","previousChapterAudioLinks":{},"numberOfVerses":25}