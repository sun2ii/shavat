{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":["Gbɛ̃ kɛ̀ lɛ́damma è kɛnɛ nnaa ye dↄ̃nazi,",{"text":"gbɛ̃ kɛ̀ totona è kɛnɛ zaaa mì vĩro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaa è Dii pↄnnaa e,","poem":1},{"lineBreak":true},{"text":"mↄde Dii è yã da mↄnafikideela.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zaakɛna è gbɛ̃ke kãsãa pɛ́ɛro,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ maaa kãsãa ègↄ̃ degena vĩro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nↄ maaa dɛ a zãnɛ lán fùra bà,","poem":1},{"lineBreak":true},{"text":"nↄ wídammari dɛnɛ lán mɛ̀kɛmuna bà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaanↄ ègↄ̃ pɛɛ yãzɛdeea,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ zaaanↄ lɛ́damma mↄnafiki vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃ zaaanↄ yã nɛ́ gbɛ̃dɛna yãmɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ maaanↄ lɛ́ sↄ̃ è ń bↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wè gbɛ̃ zaaanↄ liɛ ń kpɛɛgãnda aↄ̃ mì dɛ,","poem":1},{"lineBreak":true},{"text":"mↄde gbɛ̃ maaanↄ ua ègↄ̃ kuu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wè gbɛ̃ tↄ́ bↄ a ↄ̃ndↄ̃ lɛ́mmɛ,","poem":1},{"lineBreak":true},{"text":"wè kya ká faasaideen.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃ futa kɛ̀ à zĩ̀ri vĩi sã̀ↄ dɛ","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ è a zĩnda diɛ pↄ́ke ũ bensↄ̃ à pↄ́blee vĩroola.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaa a pↄ́kãdeenↄ gwana dↄ̃,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ zaaanↄ dà pãsĩ kↄ̃n ń pↄ́nↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Búbari aĩadee ègↄ̃ kãna,","poem":1},{"lineBreak":true},{"text":"laasuu kɛ̃̀sã gbɛ̃ kɛ̀ è pɛ́ gukoriaa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃ zaaa è ↄↄ zaaa ni dɛ,","poem":1},{"lineBreak":true},{"text":"mↄde gbɛ̃ maaa kãsãa ègↄ̃ mↄdↄ vĩ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃ zaaa lɛ́ zaaa è à kũ,","poem":1},{"lineBreak":true},{"text":"mↄde gbɛ̃ maaa è bↄ yãketen.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lɛ́ maaa è ń ká pↄ́ maaaa,","poem":1},{"lineBreak":true},{"text":"zĩi kɛ̀ gbɛ̃ kɛ̀ àre è gɛ̃ a ↄzĩ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yↄ̃nkↄↄ yãkɛna è kɛnɛ maa,","poem":1},{"lineBreak":true},{"text":"ↄ̃ndↄ̃dee sↄ̃ è lɛ́damma ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yↄ̃nkↄↄ è tó wà à pↄfɛ̃ dↄ̃ gↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"làakaridee sↄ̃ è sↄ̃sↄ̃ daro.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yãpura'ori è yãzɛdee o,","poem":1},{"lineBreak":true},{"text":"sèeda'ɛgɛde yã ègↄ̃ mↄnafiki vĩmɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Laasuusaiyã è ń swɛ̃̀ zↄ̃ lán fɛ̃ɛdaa bà,","poem":1},{"lineBreak":true},{"text":"ↄ̃ndↄ̃dee lɛ́gbɛ è mↄ aafiao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yãpuraa kɛ̀ wà ò ègↄ̃ gìkɛna,","poem":1},{"lineBreak":true},{"text":"ɛgɛɛ sↄ̃ è gɛ̃ zɛ́la lán wɛ́ɛ'ibakɛna bà.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Mↄnafiki kú zaalɛkpakↄ̃sↄ̃rinↄ swɛ̃̀n,","poem":1},{"lineBreak":true},{"text":"gbɛ̃'aafiawɛtɛrinↄ bé aↄ̃ↄ pↄnnaa vĩ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Zaa ke è gbɛ̃ maaa lero,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ zaaanↄ sↄ̃, yã è dańla.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dii tɛ̃̀n ɛgɛdee ũ,","poem":1},{"lineBreak":true},{"text":"à pↄↄ ègↄ̃ nna yãpuradeea.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Làakaridee ègↄ̃ a dↄ̃na kũna a swɛ̃̀n,","poem":1},{"lineBreak":true},{"text":"yↄ̃nkↄↄ è yã faasai kpàakpa kɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Zĩkɛna ↄplaplaa è tó gbɛ̃ kí ble,","poem":1},{"lineBreak":true},{"text":"mɛa è gbɛ̃ da zↄ̀bleen.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kuuna bídi guu è gbɛ̃ sↄ̃ɛ,","poem":1},{"lineBreak":true},{"text":"yãnna'onnɛna è ń pↄↄ kɛ nna.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaa è a gbɛ̃daaa da zɛ́a,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ zaaanↄ yãkɛna è ń sãsã.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mɛadee è a nↄ̀bↄ kã wawaro,","poem":1},{"lineBreak":true},{"text":"aĩadee è làakari dↄ a pↄ́nↄa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kuuna yãzɛde zɛ́n wɛ̃̀ndi vĩ,","poem":1},{"lineBreak":true},{"text":"zɛ́ pì sɛna è ń kpá gaaziro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}