{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":["Nɛ́ ↄ̃ndↄ̃dee è a de lɛ́damma ma,",{"text":"fabori è gí kpãkɛ̃nazi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lɛ́gbɛ nnaa è gbɛ̃ ká pↄ́ maaaa,","poem":1},{"lineBreak":true},{"text":"náanɛsaidee è ble a pãsĩ guumɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ è a lɛ́ kũ è a wɛ̃̀ndi dãkpa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ à lɛ́ è kúroo è a zĩnda yaka.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɛadee è pↄ́ kɛ̀ à yezi ero,","poem":1},{"lineBreak":true},{"text":"aĩade sↄ̃ è nnaa ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaa zà mↄnafikiyãn,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ zaaa è wí daḿma è ń kpɛ bↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Maakɛna è zɛ́maasɛri mì sí,","poem":1},{"lineBreak":true},{"text":"zaakɛna è durunkɛri liɛ a kpɛɛgãnda.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃kenↄ è ń zĩnda diɛ auzikidee ũ,","poem":1},{"lineBreak":true},{"text":"mↄde aↄ̃ègↄ̃ pↄ́ke vĩro.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃kenↄ è ń zĩnda diɛ takaasidee ũ,","poem":1},{"lineBreak":true},{"text":"mↄde aↄ̃ègↄ̃ pↄ́ vĩ bíta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Auzikidee è a zĩnda bↄ kↄ̃n a auzikikɛɛo,","poem":1},{"lineBreak":true},{"text":"takaasidee sↄ̃ è vĩadaanzina ero.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaanↄ gupuraa ègↄ̃ puna,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ zaaanↄ fitia è gaḿma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zĩndasɛna lezĩ è swèe da,","poem":1},{"lineBreak":true},{"text":"lɛ́dammamana è tó wà ↄ̃ndↄ̃ kũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɔↄ zaaa è gá aɛro,","poem":1},{"lineBreak":true},{"text":"ↄↄ kɛ̀ wà è ísimma guu sↄ̃ è kↄ̃.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tãmaa gìkɛna è ń nↄ̀sɛ yaka,","poem":1},{"lineBreak":true},{"text":"pↄ́ kɛ̀ wà yezi ena è mↄ́ wɛ̃̀ndi dufuo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ è yã daroo é yã e,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ è yã ma é àre e.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ɔ̃ndↄ̃dee yãdannɛnan íbↄki wɛ̃̀ndidee ũ,","poem":1},{"lineBreak":true},{"text":"è ń bↄ ga bàn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wɛ́ɛzɛ̃ maaa è tó gbɛ̃ dakↄ̃rɛ gòmio,","poem":1},{"lineBreak":true},{"text":"mↄde náanɛsaideenↄ zɛ́ ègↄ̃ pãsĩ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Làakarideenↄ è yã kɛ kↄ̃n dↄ̃nao,","poem":1},{"lineBreak":true},{"text":"yↄ̃nkↄↄ è a faasaikɛɛ ↄdↄańnɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Zĩ̀ri zaaa è gɛ̃ yãn,","poem":1},{"lineBreak":true},{"text":"ìba náanɛdee è su aafia.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gina totonazi è mↄ́ takaasio kↄ̃n wíyão,","poem":1},{"lineBreak":true},{"text":"lɛ́dammamana è bɛ̀ɛ líńnɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pↄ́nidɛna ena è ń pↄↄ kɛ nna,","poem":1},{"lineBreak":true},{"text":"mↄde yↄ̃nkↄↄ ye kɛ̃na yã zaaaaziro.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ tɛ́ ↄ̃ndↄ̃rinↄzi è ↄ̃ndↄ̃ kũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ kakↄ̃ana kↄ̃n yↄ̃nkↄↄnↄ è yã e.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mↄ́nzi ègↄ̃ tɛ́ durunkɛrinↄzi,","poem":1},{"lineBreak":true},{"text":"nnamanan gbɛ̃ maaanↄ àre ũ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaa è túbi tó a dionↄnɛ,","poem":1},{"lineBreak":true},{"text":"durunkɛri sↄ̃ auziki é gↄ̃ gbɛ̃ maaanɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Takaaside bura è pↄ́blee kɛ maamaa,","poem":1},{"lineBreak":true},{"text":"mↄde yãkɛna lɛkpɛɛ è tó à korazi.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ è a nɛ́ gbɛ̃roo zàn,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ ye a nɛ́zi è à toto káaku.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaa è pↄ́ ble à kã,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ zaaanↄ nↄ̀sɛ ègↄ̃ da kori.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}