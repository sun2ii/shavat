{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["Yãwenlana dↄ̃ↄ è pↄfɛ̃ kpáɛ,",{"text":"yã pãsĩ è ń pↄↄ fɛ̃.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɔ̃ndↄ̃dee yã'ona è ń gba dↄ̃na,","poem":1},{"lineBreak":true},{"text":"mↄde yↄ̃nkↄↄ yã ègↄ̃ faa sai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii wɛ́ɛ kú gu píngia,","poem":1},{"lineBreak":true},{"text":"ègↄ̃ gbɛ̃ zaaanↄ kↄ̃n gbɛ̃ maaanↄ tàasi kɛɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yãbusɛ'ona è ń gba wɛ̃̀ndi dufu,","poem":1},{"lineBreak":true},{"text":"yãlɛkpɛɛ è ń kã dɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Faasaidee è kya ká a de totonan,","poem":1},{"lineBreak":true},{"text":"lɛ́dammamari sↄ̃ↄ làakari vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaa ua ègↄ̃ auziki vĩ bíta,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ zaa pↄ́nↄ ègↄ̃ yãkete vĩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ɔ̃ndↄ̃dee lɛ́ è dↄ̃na fã,","poem":1},{"lineBreak":true},{"text":"yↄ̃nkↄↄnↄ sↄ̃, aↄ̃ↄ nↄ̀sɛ vĩro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii tɛ̃̀n gbɛ̃ zaaanↄ sa'ona ũ,","poem":1},{"lineBreak":true},{"text":"mↄde gbɛ̃ maaanↄ wɛ́ɛkɛna è kánɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii zà gbɛ̃ zaaa yãkɛnan,","poem":1},{"lineBreak":true},{"text":"à ye gbɛ̃ kɛ̀ aↄ̃ↄ tɛ́ yãzɛdeezinↄzi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Totona pãsĩn gbɛ̃ kɛ̀ pã̀ zɛ́nɛ pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ ye lɛ́dammaziroo sↄ̃ é gamɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lán Dii gɛ̀wãa kↄ̃n kaatɛnao yã dↄ̃ nà,","poem":1},{"lineBreak":true},{"text":"weé gbɛ̃ntee swɛ̃̀ pↄ́ o dↄↄ́?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fabori ègↄ̃ yezi wà a gba làakariro,","poem":1},{"lineBreak":true},{"text":"è gá ↄ̃ndↄ̃rinↄ kiiaro.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nↄ̀sɛ nnaa è tó uu gↄ̃ werena,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛ yakana è gbɛ̃ kã dɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Laasuudee è dↄ̃na wɛtɛ,","poem":1},{"lineBreak":true},{"text":"yↄ̃nkↄↄ è yãfaasai mↄ́mↄ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gurↄ píngi ègↄ̃ pãsĩ wɛ̃ndadeenɛmɛ,","poem":1},{"lineBreak":true},{"text":"pↄnnadee ègↄ̃ kú zĩbaa guu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pↄ́ vĩna féte vĩakɛna Diinɛ guu","poem":1},{"lineBreak":true},{"text":"maa dɛ auziki bíta kũna wahaa guula.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dò pã blena yenzi guu","poem":1},{"lineBreak":true},{"text":"maa dɛ nↄ̀bↄ nↄ́side sona kↄ̃n zanguola.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Pↄfɛ̃ri è swèe da,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛyĩidee è zↄka mì dɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mɛadee zɛ́ ègↄ̃ dɛnɛ lɛ̀kara ũmɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ maa zɛ́ nɛ́ zɛ́daamɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nɛ́ ↄ̃ndↄ̃dee è tó a de pↄↄ kɛ nna,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ntee yↄ̃nkↄↄ è kya ká a dan.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Yãfaasai è kɛ laasuusaideenɛ nna,","poem":1},{"lineBreak":true},{"text":"laasuudee è zɛ́ sɛ́ súusu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Lɛ́kpakↄ̃sↄ̃nasai è yã gboro,","poem":1},{"lineBreak":true},{"text":"lɛ́dammari pariinↄ è tó yã kɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yãwenlana dↄ̃ↄ è a òri pↄↄ kɛ nna,","poem":1},{"lineBreak":true},{"text":"yã'ona à gurↄↄa ègↄ̃ nna fá!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wɛ̃̀ndi zɛ́ è gá kↄ̃n làakarideenↄ musu","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃ton sí gɛ̀wãanlo yãnzi.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dii è ĩadãri ua wí,","poem":1},{"lineBreak":true},{"text":"è gyaanↄↄ gulɛzɛki dãkpa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Dii zà laasuu zaaan,","poem":1},{"lineBreak":true},{"text":"yãnna'ona è kɛnɛ gbãsĩro.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ɔↄzaawɛtɛri è ĩa da a uaa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ zà ↄdↄnkpɛɛgbaan égↄ̃ kuu aafia.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaa è laasuu lɛ́ yã kɛ̀ eé weńlaa,","poem":1},{"lineBreak":true},{"text":"yã zaaa è bↄɛ gbɛ̃ zaaanↄ lɛ́n gↄ̃ↄ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Dii zã̀ kↄ̃n gbɛ̃ zaaanↄ,","poem":1},{"lineBreak":true},{"text":"è swã kpá gbɛ̃ maaanↄ aduakɛnazi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Uu werena è ń pↄↄ kɛ nna,","poem":1},{"lineBreak":true},{"text":"baaru nnaa è ń wá were.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ è swã dↄ aafia lɛ́dammazi","poem":1},{"lineBreak":true},{"text":"égↄ̃ bɛdee ũ ↄ̃ndↄ̃rinↄ tɛ́.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ gì totonazi zà a zĩndan,","poem":1},{"lineBreak":true},{"text":"lɛ́dammamari sↄ̃ è gↄ̃ làakaridee ũ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Vĩakɛna Diinɛ è ↄ̃ndↄ̃ↄ dańnɛ,","poem":1},{"lineBreak":true},{"text":"zĩndabusana è bɛ̀ɛ líńnɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}