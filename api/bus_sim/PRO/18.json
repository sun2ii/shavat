{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["Zĩnda pↄyezi è dↄ gbɛ̃ kɛ̀ è kɛ̃ḿmanɛ aɛ,",{"text":"è gí lɛ́damma píngizi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yↄ̃nkↄↄ è pↄnnaa kɛ làakari yã musuro,","poem":1},{"lineBreak":true},{"text":"yã kɛ̀ bↄ̀ à lɛ́n è o.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zaakɛna è mↄ́ kyakanguomɛ,","poem":1},{"lineBreak":true},{"text":"kpɛbↄyã è wí ińnɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃ntee lɛ́gbɛ nɛ́ í lↄ̀mɛ,","poem":1},{"lineBreak":true},{"text":"swa'i bàalɛnamɛ, íbↄki wɛ̃̀ndideemɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɛna zaakɛrinɛ kɛ̀rɛkɛrɛ","poem":1},{"lineBreak":true},{"text":"ke yãkɛna taarisaideenɛ lɛ̀kpɛɛ maaro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yↄ̃nkↄↄ lɛ́ è à da swèen,","poem":1},{"lineBreak":true},{"text":"à yã'ona è à kpá gbɛ̃nazi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yↄ̃nkↄↄ lɛ́ è à yaka,","poem":1},{"lineBreak":true},{"text":"à yã'ona è à kũ lán takutɛɛ bà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃peri yã è kɛńnɛ lán zↄ́ bà,","poem":1},{"lineBreak":true},{"text":"è gɛ̃ lɛ́n dↄ̃̀ↄ ai nↄ̀sɛ guu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ è pã kpá a zĩizi nɛ́","poem":1},{"lineBreak":true},{"text":"mↄ́nzide dãaromɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii tↄ́ nɛ́ utɛki lezĩmɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ maaa è bàa lɛ́ à gɛ̃̀n à aafia e.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ɔↄde auziki dɛnɛ lán wɛ́tɛ kɛ̀ wà lɛ̀kaa lìgazi bà,","poem":1},{"lineBreak":true},{"text":"lán bĩi kɛ̀ weé fↄ̃ wà didiaroo bà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zĩndasɛna lezĩ è mↄ́ gbɛ̃nɛ kↄ̃n lɛɛnao,","poem":1},{"lineBreak":true},{"text":"zĩndabusana è mↄ́ bɛ̀ɛo.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ è weńla swãkpana sai,","poem":1},{"lineBreak":true},{"text":"mìsaikɛɛ kↄ̃n kpɛbↄnao gↄ̃̀nɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kãgbãakɛɛ è gbɛ̃ gba gbãaa gyãpɛa,","poem":1},{"lineBreak":true},{"text":"mↄde dé bé eé pↄsiaa fↄ̃ↄ?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Làakaridee è yã dada a swɛ̃̀n,","poem":1},{"lineBreak":true},{"text":"ↄ̃ndↄ̃dee swã ègↄ̃ dↄ dↄ̃nazi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbaa kɛ̀ gbɛ̃ dà è zɛ́ kɛkɛnɛ,","poem":1},{"lineBreak":true},{"text":"è zɛ́ wɛ̃nɛ gana gbɛ̃nsinↄ kiia.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ yã ò káakun wè à gwa yãnnadee ũ,","poem":1},{"lineBreak":true},{"text":"ai à ibɛɛ gↄ̃ gá à ɛgɛ bo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kàbankpɛkɛna è swèe mì dɛ,","poem":1},{"lineBreak":true},{"text":"è gↄ̃sa gbãaanↄ yokↄ̃a.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Danɛ kɛ̀ wà taari kɛ̀nɛ yã ègↄ̃ gbãa lán bĩi bà,","poem":1},{"lineBreak":true},{"text":"aↄ̃ swèe dɛ lán zɛ́tatana kↄ̃n lɛ̀o bà.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yã'ona dↄ̃ↄ è mↄ́ gbɛ̃nɛ kↄ̃n kãnao,","poem":1},{"lineBreak":true},{"text":"à lɛ́gbɛ è tó pↄ́ mↄ́a.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gaa kↄ̃n wɛ̃̀ndio kú lɛ́mmɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ ye yã'onazi è a gbɛ̀ e.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ nↄↄ è ń sɛ́ n pↄ́ maaa è,","poem":1},{"lineBreak":true},{"text":"aubarika beee bↄ̀ Dii kiiamɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Takaasidee è yã o wɛ̃ndawɛ̃nda,","poem":1},{"lineBreak":true},{"text":"auzikidee è weńla gbãngbãn.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃nna bɛrɛkɛtɛ è à zaaa ińnɛmɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nna kenↄ kuu aↄ̃ègↄ̃ na gbɛ̃a dɛ ua gbɛ̃la.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}