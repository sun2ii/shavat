{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":["Kuuna takaaside taarisaidee ũu maa",{"text":"dɛ kuuna yↄ̃nkↄ yãzaa'ori ũula.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aĩa vĩna dↄ̃na sai maaro,","poem":1},{"lineBreak":true},{"text":"wãna bíta è ń kɛ̃ zɛ́amɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃ntee faasaikɛɛ è zɛ́ yakanɛ,","poem":1},{"lineBreak":true},{"text":"ben è Dii taari e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Auziki è tó wà gbɛ̃nna e pari,","poem":1},{"lineBreak":true},{"text":"takaaside gbɛ̃nna è kɛ̃amɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sèeda ɛgɛdee é bↄ pãro,","poem":1},{"lineBreak":true},{"text":"ɛgɛdee é gí wɛ́ɛtãmma eziro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gbɛ̃ paridee è kpatableri tↄ́ nnaa sí,","poem":1},{"lineBreak":true},{"text":"baade píngi ègↄ̃ yezi gbadari gↄ̃ dɛ a gbɛ̃ ũmɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Takaasidee danɛnↄ è pã kpázimɛ,","poem":1},{"lineBreak":true},{"text":"weé à gbɛ̃nnanↄ kɛ̃ana o dↄro.","poem":1},{"lineBreak":true},{"text":"Tó èe wɛtɛɛ à yã ońyo,","poem":1},{"lineBreak":true},{"text":"aↄ̃ègↄ̃ kú bɛro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ èe ↄ̃ndↄ̃ kũu ye a zĩndazimɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ ye làakarizi è à maaa e.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sèeda ɛgɛdee é bↄ pãro,","poem":1},{"lineBreak":true},{"text":"ɛgɛtori é kaatɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lán nnamana e kↄ̃si kↄ̃n yↄ̃nkↄↄo nàro,","poem":1},{"lineBreak":true},{"text":"lɛn zↄ̀ kíblena wɛ̃ɛnɛnↄa e kↄ̃sioro lɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Làakaridee pↄↄ è fɛ̃ kpaaro,","poem":1},{"lineBreak":true},{"text":"lákana taarilan à ĩadãbↄ ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kína pↄfɛ̃na dɛ lán músu pũtãna bà,","poem":1},{"lineBreak":true},{"text":"à maakɛnnɛna dɛ lán mↄdↄpisina sɛ̃̀a bàmɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nɛ́ yↄ̃nkↄↄn a de yakana ũ,","poem":1},{"lineBreak":true},{"text":"nↄ swèedee dɛ lán ítↄ̃tↄ̃na zɛna sai bàmɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wè bɛɛ kↄ̃n a auzikio e túbi ũmɛ,","poem":1},{"lineBreak":true},{"text":"mↄde nↄ làakaride ena è bↄ Dii kiiamɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mɛakɛna è ń da ibita'onan,","poem":1},{"lineBreak":true},{"text":"nↄaa è gbɛ̃ gina dɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ è yã'onnɛna da è a wɛ̃̀ndi dãkpa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ è a zĩnda yãkɛna daroo é ga.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ wɛ̃nda dↄ̃̀ takaasideenɛ pↄ́ sɛ̃̀kã Diinɛmɛ,","poem":1},{"lineBreak":true},{"text":"àmbe é à yãkɛnanↄ fĩa bonɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ǹ n nɛ́ toto a gurↄↄa,","poem":1},{"lineBreak":true},{"text":"mↄde ǹton tó à gɛ̃ ↄla ai à garo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Pↄfɛ̃bitadee é fĩa bomɛ,","poem":1},{"lineBreak":true},{"text":"tó n à bò, à bona égↄ̃ lɛ́ vĩro.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ǹ lɛ́damma ma ǹ totona sí,","poem":1},{"lineBreak":true},{"text":"lɛ ǹ ↄ̃ndↄ̃ kũ gurↄ aɛzĩ yãnzi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Laasuu kú gbɛ̃ntee nↄ̀sɛn pari,","poem":1},{"lineBreak":true},{"text":"mↄde yã kɛ̀ Dii zɛ̀o bé è kɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛɛn wè wɛtɛ gbɛ̃nteea,","poem":1},{"lineBreak":true},{"text":"takaasidee maa dɛ ɛgɛdeela.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Vĩakɛna Diinɛ è mↄ́ wɛ̃̀ndio,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ vĩi è ii o làakario kpaɛna,","poem":1},{"lineBreak":true},{"text":"à zaaa è à lero.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mɛadee è ↄ gɛ̃ taan","poem":1},{"lineBreak":true},{"text":"à fua à pↄ́blee lí à da a lɛ́n.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ǹ fabori gbɛ̃, yↄ̃nkↄↄ é gↄ̃ làakari vĩ,","poem":1},{"lineBreak":true},{"text":"ǹ kpãkɛ̃ làakarideezi, eé yã dada.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nɛ́ kɛ̀ è a de gbɛ̃ à pɛ́ a daa nɛ́","poem":1},{"lineBreak":true},{"text":"nɛ́ gina kɛ̀ è wí daḿmamɛ.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ma nɛ́, tó n kámma bò kↄ̃n lɛ́dammamanao,","poem":1},{"lineBreak":true},{"text":"n pã yãdↄ̃nanɛn gwe.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Sèeda zaadee è yãzɛdee fabo,","poem":1},{"lineBreak":true},{"text":"zaakɛri è à zaaa mↄ́mↄ zaa.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Gò logona faborinↄla,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nan yↄ̃nkↄↄnↄ pↄ́ ũ ń kpɛɛa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}