{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":2,"content":[{"type":"heading","content":["Tɛna ↄ̃ndↄ̃ↄzi àre"]},{"type":"verse","number":1,"content":["Ma nɛ́, tó n ma yã sì,",{"text":"tó ń ma yãdiɛnanↄ kũna n swɛ̃̀n,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"tó nɛ́ɛ swã kpaa ↄ̃ndↄ̃yãzi,","poem":1},{"lineBreak":true},{"text":"tó n swɛ̃̀ kpà asãnsia,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"tó n lɛ́ zù wɛ́ɛzɛ̃ɛzi,","poem":1},{"lineBreak":true},{"text":"tó n wii lɛ̀ yã dↄ̀rↄ dↄ̃nazi,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"tó n kpáɛ kɛ̀zi lán kondogi bà,","poem":1},{"lineBreak":true},{"text":"tó ń wɛ̀tɛ lán auziki kɛ̀ utɛna bà,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"nɛ́gↄ̃ vĩakɛna Diinɛ dↄ̃ sa,","poem":1},{"lineBreak":true},{"text":"nɛ́ bↄ Luda dↄ̃naa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Zaakɛ Dii bé è ń gba ↄ̃ndↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"dↄ̃na kↄ̃n asãnsio è bↄ à kiiamɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À zĩ̀blena kũna gbɛ̃ maaanↄnɛ,","poem":1},{"lineBreak":true},{"text":"à dɛ sɛngbango ũ taarisaideenↄnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"È ↄ liga gbɛ̃ maaanↄzi aↄ̃ zɛ́ guu,","poem":1},{"lineBreak":true},{"text":"è a yãmarinↄ dãkpa ń táa'ona guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nɛ́gↄ̃ yãzɛdee dↄ̃ sa kↄ̃n yã súusuo","poem":1},{"lineBreak":true},{"text":"kↄ̃n yã maaao kↄ̃n zɛ́ maaao píngi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zaakɛ ↄ̃ndↄ̃ↄ é gɛ̃ n swɛ̃̀n,","poem":1},{"lineBreak":true},{"text":"dↄ̃na é n pↄↄ kɛ nna.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N làakari é n dãkpa,","poem":1},{"lineBreak":true},{"text":"asãnsi é ↄ liganzi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Eé n bↄ gbɛ̃ zaaanↄ zɛ́n","poem":1},{"lineBreak":true},{"text":"eé n sí yãbɛ̃ɛ'orinↄ ↄzĩ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbɛ̃ pìnↄ pã̀ zɛ́ súusunɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ gusia zɛ́ sɛ̀.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aↄ̃è pↄnnaa kɛ zaakɛna guu,","poem":1},{"lineBreak":true},{"text":"aↄ̃è yã zaa faasai nnaa ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aↄ̃ yãkɛna súusuro,","poem":1},{"lineBreak":true},{"text":"aↄ̃ègↄ̃ yã kɛɛ mↄnafiki guumɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ɔ̃ndↄ̃ↄ pì é n bↄ zinakɛri ↄzĩ,","poem":1},{"lineBreak":true},{"text":"eé n sí kaarua yãnnanna'onnɛnaa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Nↄgbɛ̃ pì pã kpà a nɛ́nↄkparɛkɛgurↄ gↄ̃ↄzi,","poem":1},{"lineBreak":true},{"text":"à Luda bà kuunao yã gbòro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"À bɛɛ è mì pɛ́ńyo gaaamɛ,","poem":1},{"lineBreak":true},{"text":"à kpɛ́ zɛ́ è táńyo gɛ̀wãan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ gɛ̃̀zi è nↄ̀sɛ liɛro,","poem":1},{"lineBreak":true},{"text":"è wɛ̃̀ndi zɛ́ le dↄro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ɔ̃ndↄ̃ↄ pì é n da gbɛ̃ maaanↄ zɛ́a,","poem":1},{"lineBreak":true},{"text":"nɛ́gↄ̃ dↄ̀rↄdeenↄ zɛ́ kũna.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Zaakɛ nↄ̀sɛpuradeenↄ bé wé gↄ̃ bùsu vĩ,","poem":1},{"lineBreak":true},{"text":"taarisaideenↄ bé wégↄ̃ kú à guu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Zaakɛrinↄ sↄ̃, weé pɛ́ḿma wà ń bↄ bùsummɛ,","poem":1},{"lineBreak":true},{"text":"weé náanɛsaideenↄ kpakɛ à guu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}