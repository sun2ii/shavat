{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":["Tↄ́ nnaa dɛ auzikila,",{"text":"nna kↄ̃n gbɛ̃nↄo dɛ vura kↄ̃n kondogiola.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Auzikidee kↄ̃n takaasideeo kãsãa dↄ̃nkↄ̃mɛ,","poem":1},{"lineBreak":true},{"text":"Dii bé à ń kɛ́ ń píngi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Làakaridee è gĩakɛ à à zaaa e à utɛnɛ,","poem":1},{"lineBreak":true},{"text":"ↄ̃ndↄ̃saidee ègↄ̃ gaa ai à wɛ́ɛtãmma e.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zĩndabusana kↄ̃n vĩakɛna Diinɛo gbɛ̀n","poem":1},{"lineBreak":true},{"text":"auziki kↄ̃n bɛ̀ɛo kↄ̃n wɛ̃̀ndio ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lɛ̀ kↄ̃n takutɛɛo kú gbɛ̃ dↄ̀rↄsaide zɛ́n,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ ye aafiazi è kɛ̃ḿma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹ nɛ́ féte da zɛ́ kɛ̀ dɛ à sɛ́a,","poem":1},{"lineBreak":true},{"text":"tó à ìsi kũ̀, eé kɛ̃aro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Auzikidee è gbãaa mↄ takaasideenɛ,","poem":1},{"lineBreak":true},{"text":"pↄ́sɛ̃kãri è zↄ̀ ble pↄ́deenɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ à à zaaa tↄ̃̀, adee é yã e à kɛ̃gurↄ,","poem":1},{"lineBreak":true},{"text":"à pãsĩkɛgo é à gbɛ̃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Luda é aubarika da gbɛ̃ kɛ̀ gbɛ̃kɛɛ vĩin","poem":1},{"lineBreak":true},{"text":"kɛ̀ è pↄ́blee kpaatɛ takaasideenↄnɛ yãnzi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹ pɛ́ faboria, swèe é mì dɛ,","poem":1},{"lineBreak":true},{"text":"yãkete kↄ̃n wío é yãa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nↄ̀sɛpuradee kɛ̀ à lɛ́gbɛ nna","poem":1},{"lineBreak":true},{"text":"bé eégↄ̃ dɛ kína gbɛ̃nna ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dii wɛ́ɛ ègↄ̃ tɛ́ dↄ̃nazi,","poem":1},{"lineBreak":true},{"text":"è mìkpɛɛ zu náanɛsaide yãnɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mɛadee è be músu kú bàazi,","poem":1},{"lineBreak":true},{"text":"tó ma bↄ, eé ma dɛ gãalɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kaarua lɛ́ nɛ́ wɛ̀ɛ zòotomɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ Dii pↄↄ fɛ̃̀o è lɛ́ɛ à sin.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Faasaiyã ègↄ̃ kú nɛ́nↄ swɛ̃̀n,","poem":1},{"lineBreak":true},{"text":"totona kↄ̃n flã̀o é tó aↄ̃ kɛ̃a.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ è wɛ́ɛ tã takaasideea lɛ à a auziki kaara","poem":1},{"lineBreak":true},{"text":"kↄ̃n gbɛ̃ kɛ̀ è gba da ↄↄdeenɛo, aↄ̃ píngi é kɛ̃sã.","poem":1}]},{"type":"heading","content":["Ɔ̃ndↄ̃deenↄ lɛ́damma"]},{"type":"verse","number":17,"content":[{"text":"Ǹ swã kpá ǹ ↄ̃ndↄ̃rinↄ yã'onnɛna ma,","poem":1},{"lineBreak":true},{"text":"ǹ n nↄ̀sɛ wɛ̃ ma yãdannɛnanɛ,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"zaakɛ à nna ǹgↄ̃ kũna n swɛ̃̀ guu,","poem":1},{"lineBreak":true},{"text":"àgↄ̃ kú n lɛ́mmɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Baa mpi, mɛ́ɛ yã daannɛ gbã̀a,","poem":1},{"lineBreak":true},{"text":"lɛ ǹgↄ̃ Dii náanɛ vĩ yãnzimɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma yã'onnɛna kɛ̃̀nnɛ mɛ̀n baaakuri,","poem":1},{"lineBreak":true},{"text":"yã pìnↄ lɛ́damma kↄ̃n dↄ̃nao vĩ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mɛ́ɛ yãpuraa kɛ̀ náanɛ vĩi daannɛ,","poem":1},{"lineBreak":true},{"text":"lɛ ǹ e ǹ yã weńla a zɛ́amɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ǹton gbãasaidee ble à gbãasaikɛ yãnziro,","poem":1},{"lineBreak":true},{"text":"ǹton gbãaa mↄ wɛ̃ndadeenɛ yãkpaɛkɛkiiaro,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"zaakɛ Dii é yã síńyo,","poem":1},{"lineBreak":true},{"text":"eé wɛ́ɛ tã gbɛ̃ kɛ̀ aↄ̃ↄe wɛ́ɛ tãaḿmanↄa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ǹton gbɛ̃nna kpá kↄ̃n pↄfɛ̃rioro,","poem":1},{"lineBreak":true},{"text":"ǹtongↄ̃ tɛ́ kↄ̃n pɛ̃tɛ̃deeoro,","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"lɛ ǹton à dà sɛ́ɛ","poem":1},{"lineBreak":true},{"text":"ǹ n zĩnda kpá yãziro yãnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ǹton gbɛ̃ke fĩa di n musuro,","poem":1},{"lineBreak":true},{"text":"ǹton kpɛ́gaau sɛ́nɛro.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tó ń pↄ́ke vĩ ǹ fĩa booro,","poem":1},{"lineBreak":true},{"text":"weé n daɛbↄ sɛ́ n gĩzĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ǹton tↄↄtɛ lɛ́ sèeda zii wurɛro,","poem":1},{"lineBreak":true},{"text":"n dezinↄ bé aↄ̃ pɛ̀ɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"N gbɛ̃ kɛ̀ à a zĩi dↄ̃ maamaaa èↄ́?","poem":1},{"lineBreak":true},{"text":"Adee é zĩi kɛ kínanↄnɛ,","poem":1},{"lineBreak":true},{"text":"èe kɛ talakanↄn eé kɛńnɛro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}