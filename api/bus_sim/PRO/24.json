{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["Ǹtongↄ̃ lugaa gbɛ̃ zaaanↄ gwenaziro,",{"text":"ǹton kakↄ̃anyona ni dɛ sero,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"zaakɛ yã gbãaa laasuu bé ègↄ̃ kú ń swɛ̃̀n,","poem":1},{"lineBreak":true},{"text":"yãkete ègↄ̃ kú n lɛ́mmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ɔ̃ndↄ̃ↄn wè bɛ kpáɛo,","poem":1},{"lineBreak":true},{"text":"làakari è tó àgↄ̃ pɛɛna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dↄ̃nan wè pↄ́ káo kpɛ́nↄ pa","poem":1},{"lineBreak":true},{"text":"kↄ̃n auziki maa bɛ̀ɛdeeo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ɔ̃ndↄ̃dee gbãaa ègↄ̃ kaaramɛ,","poem":1},{"lineBreak":true},{"text":"dↄ̃̀ri iko ègↄ̃ gaa aɛmɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Baaru è tó wà zĩ̀ asãnsi dↄ̃,","poem":1},{"lineBreak":true},{"text":"tó yãkɛkɛrinↄↄ pari, è tó wà zĩ̀ ble.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ɔ̃ndↄ̃ↄ lezĩ dɛ faasaideela,","poem":1},{"lineBreak":true},{"text":"lakutu kↄ̃kakↄ̃aa guu à lɛ́ ègↄ̃ nakↄ̃anamɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gbɛ̃ kɛ̀ ègↄ̃ zaakɛnnɛna laasuu vĩin","poem":1},{"lineBreak":true},{"text":"wè à sísi mↄnafikide.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yãfaasai wàaripana nɛ́ durummɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ke ègↄ̃ ye faboriziro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tó n mɛ̀kpɛtɛ kɛ̀ nawɛ̃akɛgurↄ,","poem":1},{"lineBreak":true},{"text":"n gbãaa bítaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ǹ gbɛ̃ kɛ̀ aↄ̃ mì pɛ̀ gaaanↄ mì sí,","poem":1},{"lineBreak":true},{"text":"ǹ gí gbɛ̃ kɛ̀ aↄ̃ sòro wèe sii kaatɛnannↄnɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó n bè: O'o, wá dↄ̃ yãro fá,","poem":1},{"lineBreak":true},{"text":"Luda kɛ̀ nↄ̀sɛguuyã dↄ̃ é eroo?","poem":1},{"lineBreak":true},{"text":"N wɛ̃̀ndi gwàri à yã dↄ̃,","poem":1},{"lineBreak":true},{"text":"eé fĩa bo baadenɛ a yãkɛnaamɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ma nɛ́, ǹ zↄ́ ble, zaakɛ à maa,","poem":1},{"lineBreak":true},{"text":"zↄ́sa è kɛ lɛ́nɛ nna.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lɛn ↄ̃ndↄ̃ↄ è kɛ gbɛ̃nɛ nna a nↄ̀sɛn lɛ.","poem":1},{"lineBreak":true},{"text":"Tó n ↄ̃ndↄ̃ kũ̀, nɛ́gↄ̃ ziaa vĩ,","poem":1},{"lineBreak":true},{"text":"tãmaa é n nɛro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dàde, ǹton gbɛ̃ maaa ua kpákparo,","poem":1},{"lineBreak":true},{"text":"ǹton à bɛ pↄ́nↄ kpokɛro.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Baa tó gbɛ̃ maaa lɛ̀ɛ gɛ̃̀n swɛɛplaa,","poem":1},{"lineBreak":true},{"text":"è ɛara à fɛɛmɛ,","poem":1},{"lineBreak":true},{"text":"zaakɛrinↄ sↄ̃, mↄ́nzi è ń fu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tó n ibɛɛ lɛ̀ɛ, ǹton pↄnnaa kɛro,","poem":1},{"lineBreak":true},{"text":"tó à fù, ǹton à yáa dↄro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó Dii è lɛ, eé kɛnɛ nnaro,","poem":1},{"lineBreak":true},{"text":"à pↄfɛ̃ é yãa n ibɛɛ pìamɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ǹton tó gbɛ̃ zaaanↄ yã n kũ gbãaro,","poem":1},{"lineBreak":true},{"text":"ǹton zaakɛrinↄ gwena ni dɛro,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"zaakɛ gbɛ̃ zaaa égↄ̃ ziaa vĩro,","poem":1},{"lineBreak":true},{"text":"Luda é zaakɛrinↄ fitia tɛ́ dɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ma nɛ́, ǹ vĩa kɛ Diinɛ kↄ̃n kínao,","poem":1},{"lineBreak":true},{"text":"ǹton gbɛ̃nna kpá kↄ̃n gbɛ̃ kɛ̀ aↄ̃ bↄ̀ ń kpɛɛnↄoro,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"zaakɛ yã é ń le kãndomɛ.","poem":1},{"lineBreak":true},{"text":"Dé bé à dↄ̃ lán weé ń ásaru kɛ nà?","poem":1}]},{"type":"heading","content":["Ɔ̃ndↄ̃deenↄ yãn yɛ̀ dↄ"]},{"type":"verse","number":23,"content":[{"text":"Ɔ̃ndↄ̃deenↄ yãn yɛ̀ dↄ:","poem":1},{"lineBreak":true},{"text":"Gbɛ̃wɛɛgwana yãkpaɛ guu maaro.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ è yã nnaa kpá taarideea,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nↄ é sa zaaa onɛ, boriinↄ é à ká.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ è yã da taarideela égↄ̃ à maaa ee,","poem":1},{"lineBreak":true},{"text":"Luda é aubarika dan maamaa.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Yãwenlana súusu","poem":1},{"lineBreak":true},{"text":"dɛ lán lɛ́pɛna lɛ́a bàmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ǹ n bàazi zĩi kɛ ǹ n bura soru kɛ,","poem":1},{"lineBreak":true},{"text":"nɛ́ gbasa ǹ kpɛ́ bo sa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ǹton n gbɛ̃daaa bↄbↄ a dàn pãro,","poem":1},{"lineBreak":true},{"text":"ǹton tó n lɛ́ gbɛ̃nↄ sãsãro.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ǹton be: Mɛ́ kɛnɛ lán à kɛ̀mɛ nàro,","poem":1},{"lineBreak":true},{"text":"kesↄ̃ mɛ́ fĩa bonɛ a yãkɛnaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ma pã mɛade búnɛ,","poem":1},{"lineBreak":true},{"text":"ma dↄ faasaidee geepiwɛ̃ búzi,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ben má è lɛ̀ bↄ̀ɛ à dàgula píngi,","poem":1},{"lineBreak":true},{"text":"à sɛ̃̀ kù, gũ̀ kɛ̀ à bò kↄ̃n gbɛ̀o lɛ̀ɛ.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ma yã beee gwà ma laasuu lɛ̀a,","poem":1},{"lineBreak":true},{"text":"ben pↄ́ kɛ̀ má è yã dàdamɛ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Tó n bè: Mɛ́ ii o féte, mɛ́ kámma bo féte,","poem":1},{"lineBreak":true},{"text":"mɛ́ daɛ féte ↄkpana ma kùa,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"takaasi é bↄ n ã lán kpãi bà,","poem":1},{"lineBreak":true},{"text":"pↄ́kɛ̃sãmma é mↄ́nzi","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃ kɛ̀ gↄ̃kɛbↄ kũna bà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}