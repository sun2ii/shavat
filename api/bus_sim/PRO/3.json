{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":3,"content":[{"type":"heading","content":["Dii náanɛkɛna è ń gba ↄ̃ndↄ̃ↄ"]},{"type":"verse","number":1,"content":["Ma nɛ́, ǹton tó ma yãdannɛna sãnguro,",{"text":"ǹgↄ̃ yã kɛ̀ má dìɛnnɛɛnↄ kũna n swɛ̃̀n.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zaakɛ eé n ká wɛ̃̀ndi gbã̀aa,","poem":1},{"lineBreak":true},{"text":"eé aafia kaarannɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛ kↄ̃n náanɛo tón kɛ̃mmaro,","poem":1},{"lineBreak":true},{"text":"ǹgↄ̃ dana kã̀mbɛɛ ũ,","poem":1},{"lineBreak":true},{"text":"ǹ kɛ̃ n swɛ̃̀a lán wè pↄ́ kɛ̃ walaaa nà,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"n tↄ́ égↄ̃ nna,","poem":1},{"lineBreak":true},{"text":"nɛ́gↄ̃ maa Luda kiia kↄ̃n gbɛ̃nteenↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ǹ Dii náanɛ kɛ kↄ̃n nↄ̀sɛo do,","poem":1},{"lineBreak":true},{"text":"ǹton gbãaa kpá n zĩnda dↄ̃naaro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹgↄ̃ à dↄ̃ n yãpingikɛna guu,","poem":1},{"lineBreak":true},{"text":"eé zɛ́ poronnɛ súusu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹton n zĩnda gwa ↄ̃ndↄ̃dee ũro,","poem":1},{"lineBreak":true},{"text":"ǹgↄ̃ Dii vĩa vĩ ǹ kɛ̃ yã zaaaa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Beee égↄ̃ dɛ n mɛ̀ aafia ɛ̃zɛ̃ ũ,","poem":1},{"lineBreak":true},{"text":"eé n wánↄ gba gbãaa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ bɛ̀ɛ lí Diinɛ kↄ̃n n auzikio","poem":1},{"lineBreak":true},{"text":"kↄ̃n n bura pↄ́ káakunↄ píngi,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"pↄ́wɛɛ é n dↄ̃̀ pa ai àgↄ̃ kwɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"n lo ìsinↄ é pa yɛ́lɛlɛ kↄ̃n geepiwɛ̃ dufuo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma nɛ́, tó Dii e n totoo, ǹton dↄkɛ à yãoro,","poem":1},{"lineBreak":true},{"text":"tó à kpã̀kɛ̃nzi, ǹton tó à kɛnnɛ ĩiro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zaakɛ gbɛ̃ kɛ̀ Dii yezin è toto,","poem":1},{"lineBreak":true},{"text":"lán de è kɛ a nɛ́ kɛ̀ kɛ̀nɛ maaanɛ nà.","poem":1}]},{"type":"heading","content":["Ɔ̃ndↄ̃ àre"]},{"type":"verse","number":13,"content":[{"text":"Aubarikadeen gbɛ̃ kɛ̀ ↄ̃ndↄ̃ↄ lè à kũ̀","poem":1},{"lineBreak":true},{"text":"à dↄ̃na è à pàpa ũ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zaakɛ à àre vĩ dɛ kondogila,","poem":1},{"lineBreak":true},{"text":"è kaarana kɛńnɛ dɛ vurala.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À bɛ̀ɛ vĩ dɛ gbɛ̀baila,","poem":1},{"lineBreak":true},{"text":"pↄ́ kɛ̀ ń à nii vĩinↄ kee e ká à ũro.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wɛ̃̀ndi gbã̀a kú à ↄplaan,","poem":1},{"lineBreak":true},{"text":"auziki kↄ̃n gakuio kú à ↄzɛɛn.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"À yãkɛnanↄ nna,","poem":1},{"lineBreak":true},{"text":"à zɛ́ píngi aafia vĩ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"À dɛ lí wɛ̃̀ndidee ũ gbɛ̃ kɛ̀ kũnanↄnɛ,","poem":1},{"lineBreak":true},{"text":"aubarikadeenↄn gbɛ̃ kɛ̀ aↄ̃ↄ sìnↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dii gonikɛɛ guu à tↄↄtɛ kàɛ,","poem":1},{"lineBreak":true},{"text":"à ↄ̃ndↄ̃ↄ guu à musu kɛ̀.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"À ísia wɛ̀ɛ bↄ̀ a dↄ̃na guu,","poem":1},{"lineBreak":true},{"text":"à tò ludambɛ luguu mↄdↄ vĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ma nɛ́, ǹgↄ̃ wɛ́ɛzɛ̃ɛ vĩ kↄ̃n faao,","poem":1},{"lineBreak":true},{"text":"ǹton wɛ́ɛ vĩàlaro.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Eégↄ̃ dɛ n ninii wɛ̃̀ndi ũ,","poem":1},{"lineBreak":true},{"text":"eégↄ̃ dɛ kã̀mbɛɛ ũ n waalɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nɛ́gↄ̃ tɛ́ n làakaria,","poem":1},{"lineBreak":true},{"text":"pↄ́ke é kpánnɛro.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tó n daɛ, vĩa é n kũro,","poem":1},{"lineBreak":true},{"text":"nɛ́ daɛ ǹ ii o nna.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nɛ́ vĩa kɛ karinɛro,","poem":1},{"lineBreak":true},{"text":"ke mↄ́nzi kɛ̀ è zaakɛrinↄ le kãndoo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Zaakɛ Dii égↄ̃ dɛ n mìnakii ũmɛ,","poem":1},{"lineBreak":true},{"text":"eé tó n gbá vĩ takutɛɛla.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Tó n ↄↄ e n kpɛɛ lee,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ dɛ ǹ à maaa kɛnɛ, ǹton gí kɛnɛziro.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Tó ń ĩankana zɛ́ vĩ,","poem":1},{"lineBreak":true},{"text":"ǹton be n gbɛ̃daaanɛ à gá gĩa ai ziaro.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"N gbɛ̃daaa kɛ̀ kú n saɛ kɛ̀ à n náanɛkɛna,","poem":1},{"lineBreak":true},{"text":"ǹton à zaaa kpákↄ̃sↄ̃ziro.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃ e yãke kɛnnɛro,","poem":1},{"lineBreak":true},{"text":"ǹton lɛokpakↄ̃a kɛo pãro.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ǹton gbãamↄnnɛri gwena ni dɛro,","poem":1},{"lineBreak":true},{"text":"ǹton tɛ́ à yãkɛna keziro.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Zaakɛ Dii tɛ̃̀n mↄnafikideenↄ ũ,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuradeenↄn è kɛ a kpaasinↄ ũ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Dii è láari zĩ gbɛ̃ zaaanↄ uaa,","poem":1},{"lineBreak":true},{"text":"è aubarika da gbɛ̃ maaanↄ bɛɛn.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"È lalandideenↄ lalandi kɛ,","poem":1},{"lineBreak":true},{"text":"mↄde à gbɛ̃kɛɛ vĩ kↄ̃n zĩndabusarinↄ.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Ɔ̃ndↄ̃dee è bɛ̀ɛ e,","poem":1},{"lineBreak":true},{"text":"yↄ̃nkↄↄ sↄ̃ è wí da a zĩndaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}