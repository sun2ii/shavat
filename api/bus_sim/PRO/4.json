{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":4,"content":[{"type":"heading","content":["Gbɛ̃nsi lɛ́damma"]},{"type":"verse","number":1,"content":["Ma nɛ́nↄ, à gbɛ̃nsi lɛ́damma ma,",{"text":"à làakari dↄa lɛ à asãnsi e.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dↄ̃na súusun mɛ́ɛ daaare,","poem":1},{"lineBreak":true},{"text":"àton pã kpá ma yãdannɛziro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kɛ̀ má kuu nɛ́ ũ ma de ↄzĩ,","poem":1},{"lineBreak":true},{"text":"má busana ma da nɛ́ mɛ̀n do léle ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma de yã dàmɛ à bè:","poem":1},{"lineBreak":true},{"text":"Ǹgↄ̃ ma yã kũna n swɛ̃̀ guu,","poem":1},{"lineBreak":true},{"text":"ǹ ma yãdiɛnanↄ da nɛ́gↄ̃ kuu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ǹ ↄ̃ndↄ̃ kũ ǹgↄ̃ dↄ̃na vĩ,","poem":1},{"lineBreak":true},{"text":"ǹton sãn ǹ pã ma yãnɛro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹton pã kpá ↄ̃ndↄ̃ↄziro, eé n dãkpa,","poem":1},{"lineBreak":true},{"text":"ǹgↄ̃ yezi, eé ↄ kúnla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ ↄ̃ndↄ̃ kũ, àmbe yã píngi mì ũ,","poem":1},{"lineBreak":true},{"text":"ǹ dↄ̃na wɛtɛ kↄ̃n auziki kɛ̀ ń vĩio píngi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ à kũ gbãngbãn, eé n kaara,","poem":1},{"lineBreak":true},{"text":"ǹ à kũ ↄplaplaa, eé bɛ̀ɛ línnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Eégↄ̃ dɛ fùra maaa ũ n mìa,","poem":1},{"lineBreak":true},{"text":"eégↄ̃ dɛnnɛ kífura gakuidee ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ma nɛ́, ǹ swã kpá ma yãzi,","poem":1},{"lineBreak":true},{"text":"ǹ yã pì da, n wɛ̃̀ndi égↄ̃ gbã̀a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma ↄ̃ndↄ̃ zɛ́ ↄ̀dↄannɛ,","poem":1},{"lineBreak":true},{"text":"ma n da à zɛ́ súusu guu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó nɛ́ɛ táa oon, pↄ́ke é kpánnɛro,","poem":1},{"lineBreak":true},{"text":"tó nɛ́ɛ bàa lɛɛn, nɛ́ gɛ̃̀n síro.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ǹgↄ̃ ma lɛ́damma kũna, ǹton ↄ gbarɛziro,","poem":1},{"lineBreak":true},{"text":"ǹ à kũ gbãa, zaakɛ àmbe n wɛ̃̀ndi ũ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹton zaakɛrinↄ zɛ́ sɛ́ro,","poem":1},{"lineBreak":true},{"text":"ǹton tɛ́ gbɛ̃ zaaanↄ zɛ́ziro.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ǹ pãńnɛ, ǹton naḿmaro,","poem":1},{"lineBreak":true},{"text":"ǹ kɛ̃ḿma ǹ n gáao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó aↄ̃ↄe zaaa e wà kɛ̀ro, aↄ̃è ii oro,","poem":1},{"lineBreak":true},{"text":"tó aↄ̃ↄe gbɛ̃ e wà kari kɛro, ii è gɛ̃ ń wɛ́ɛnlo.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Zaakɛ zaakɛnan ń pↄ́blee ũ,","poem":1},{"lineBreak":true},{"text":"wɛ́ɛtãna gbɛ̃nↄan ń ímina ũ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaanↄ zɛ́ dɛ lán gudↄna bàmɛ,","poem":1},{"lineBreak":true},{"text":"à gupuraa ègↄ̃ bↄↄ lán ↄfãntɛ̃ bↄna bà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Zaakɛrinↄ zɛ́ dɛ lán gusia níginigi bàmɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è pↄ́ kɛ̀ tò wè gɛ̃̀n sí dↄ̃ro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ma nɛ́, ǹ làakari dↄ yã pìnↄa,","poem":1},{"lineBreak":true},{"text":"ǹ swã kpá ma yã'onnɛnazi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ǹton kpá swãkotoro,","poem":1},{"lineBreak":true},{"text":"ǹgↄ̃ kũna n swɛ̃̀ guu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Zaakɛ à dɛ wɛ̃̀ndi ũ gbɛ̃ kɛ̀ lè à kũ̀nɛ,","poem":1},{"lineBreak":true},{"text":"à dɛ mɛ̀ píngi aafia ũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kɛ̀ dɛnlaa ǹ làakari dↄ n swɛ̃̀ yãa,","poem":1},{"lineBreak":true},{"text":"zaakɛ wɛ̃̀ndi kãsãa bↄ̀ swɛ̃̀ kiiamɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ǹ bↄ yãzaa'onan,","poem":1},{"lineBreak":true},{"text":"ǹ mì kɛ̃ yãlɛkpɛɛ'onaa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ǹ wɛ́ɛ dↄ n aɛ,","poem":1},{"lineBreak":true},{"text":"ǹ guu gwa n kuu súusu.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ǹ zɛ́ sɛ́ súusu,","poem":1},{"lineBreak":true},{"text":"n yãkɛnanↄ píngi é bↄ maa.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ǹton na ↄplazi ke ↄzɛziro,","poem":1},{"lineBreak":true},{"text":"ǹton gbá pɛ́ɛ à zaa zɛ́nlo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}