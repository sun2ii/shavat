{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":5,"content":[{"type":"heading","content":["Làakarikɛna kaaruazi"]},{"type":"verse","number":1,"content":["Ma nɛ́, ǹ làakari dↄ ma dↄ̃naa,",{"text":"ǹ swã kpá ǹ ma ↄ̃ndↄ̃ yã ma,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"lɛ ǹgↄ̃ kú n làakaria,","poem":1},{"lineBreak":true},{"text":"dↄ̃na yã égↄ̃ kú n lɛ́n.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kaarua yã'ona ègↄ̃ nna lán zↄ́ bàmɛ,","poem":1},{"lineBreak":true},{"text":"è ń gáɛ kↄ̃n lɛ́nnaao,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"mↄde zãazãa è kɛńnɛ kyã̀kyã lán sɛwɛɛ bà,","poem":1},{"lineBreak":true},{"text":"à lɛ́ nna lán fɛ̃ɛda kpaplaplaaa bà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À zɛ́ è mì pɛ́ńyo gaaa,","poem":1},{"lineBreak":true},{"text":"è si kↄ̃n gbɛ̃ kɛ̀ aↄ̃ↄ tɛ́zinↄo gɛ̀wãan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"È laasuu lɛ́ wɛ̃̀ndi zɛ́aro,","poem":1},{"lineBreak":true},{"text":"à dↄ̃ a kɛ̃ zɛ́ pìaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma nɛ́, ǹ swã kpá ma yãzi sa,","poem":1},{"lineBreak":true},{"text":"ǹton kpɛɛ li ma lɛ́dammanɛro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ pã nↄgbɛ̃ beee takanɛ zã̀azã,","poem":1},{"lineBreak":true},{"text":"ǹton sↄ̃ à bɛ gãalɛziro,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"lɛ n bɛ̀ɛ tón gↄ̃ gbɛ̃ pãndenↄnɛro,","poem":1},{"lineBreak":true},{"text":"lɛ ǹton n wɛ̃̀ndi kpá gbɛ̃ pãsĩnↄaro,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"lɛ n auzikinↄ tón gↄ̃ danↄnɛro,","poem":1},{"lineBreak":true},{"text":"lɛ n zĩ àre tón gↄ̃ ua pãnde deenↄnɛro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nɛ́gↄ̃ mboo n gurↄ yãanaa,","poem":1},{"lineBreak":true},{"text":"nɛ́ yãyã n gbãaa é yãa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɛ́ be: Ma gi lɛ́dammazi fá!","poem":1},{"lineBreak":true},{"text":"Ma dↄkɛna totonao bé à tò.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mɛ́ɛ lɛ́dammarinↄ yã'onnɛna maro,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ swã kpá ma yãdannɛrinↄziro.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Féte bé à gↄ̃̀ kɛ̀ mɛ́ kpɛ bↄ","poem":1},{"lineBreak":true},{"text":"anduna píngi wáa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ǹ n zĩnda orozã í mi,","poem":1},{"lineBreak":true},{"text":"ǹ zɛ kↄ̃n n zĩnda lↄ̀gↄ'io.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N í kwɛɛna bàazi maaro.","poem":1},{"lineBreak":true},{"text":"N í fãna gãalɛ zɛ́ vĩro.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ǹ tó àgↄ̃ dɛ n naↄ̃ pↄ́ ũ ado,","poem":1},{"lineBreak":true},{"text":"àtongↄ̃ dɛ gbɛ̃ pãnde pↄ́ ũro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Luda aubarika da n íbↄkii pìn,","poem":1},{"lineBreak":true},{"text":"ǹ pↄnnaa kɛ kↄ̃n n gↄ̃kparɛkɛgurↄ nↄↄo.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N gã yenzidee! N gbikyao maaa!","poem":1},{"lineBreak":true},{"text":"Ǹ tó à bↄ̃̀ndagana gↄ̃ kɛɛnnɛ nna,","poem":1},{"lineBreak":true},{"text":"ǹ a yenzi ni dɛ lán guu e dↄↄ nà.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ma nɛ́, bↄ́yãnzin nɛ́ kaarua ni dɛzi?","poem":1},{"lineBreak":true},{"text":"Bↄ́yãnzin nɛ́ bↄ̃̀nda gá kↄ̃n gbɛ̃ pãnde nↄↄozi?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gbɛ̃ntee yãkɛna kee utɛna Diinɛro,","poem":1},{"lineBreak":true},{"text":"ègↄ̃ zɛ́ kɛ̀ à sɛ̀ dↄ̃ píngi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Zaakɛri taari è bà kpákpanɛ,","poem":1},{"lineBreak":true},{"text":"à durun è à kũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"À lɛ́dammamasai é a kpá gaazi,","poem":1},{"lineBreak":true},{"text":"à yↄ̃nkↄkɛ bíta é à sãsã.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}