{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":7,"content":[{"type":"heading","content":["Làakarikɛna kaaruazi"]},{"type":"verse","number":1,"content":["Ma nɛ́, ǹgↄ̃ ma yãnↄ kũna,",{"text":"ǹ ma yãdiɛnanↄ da n nↄ̀sɛn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹgↄ̃ ma yãdiɛnanↄ kũna nɛ́gↄ̃ kú wɛ̃̀ndio,","poem":1},{"lineBreak":true},{"text":"ǹ làakari dↄ ma yãdannɛnaa lán n wɛ́ɛnɛ bà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ǹ da n ↄnɛa tãnga ũ,","poem":1},{"lineBreak":true},{"text":"ǹ kɛ̃ n swɛ̃̀a lán wè kɛ̃ walaaa nà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ǹ o ↄ̃ndↄ̃ↄnɛ n dãren à ũ,","poem":1},{"lineBreak":true},{"text":"ǹ asãnsi sísi n gbɛ̃ ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Eé n dãkpa bↄna kaarua ↄzĩ,","poem":1},{"lineBreak":true},{"text":"eé n bↄ gbɛ̃ pãnde nↄ yãnnanna'onan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Má zɛna ma kpɛ́ windo guu,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ bàazi gwaa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ben ma ↄ̀wazi kenↄ è, ↄ̃ndↄ̃ↄ kɛ̃̀sãḿma,","poem":1},{"lineBreak":true},{"text":"gↄ̃kparɛ kee kú ń tɛ́, à laasuu vĩro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Èe likↄ̃aa zↄ̃ↄ gãalɛ,","poem":1},{"lineBreak":true},{"text":"èe waalogũ kɛkɛɛ nↄgbɛ̃ kezi,","poem":1},{"lineBreak":true},{"text":"èe gɛ̃tɛɛ à bɛ kpa gɛ̃̀n baaagↄ̃","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"zaa ↄfãntɛ̃ lɛɛnao ai gwãavĩ,","poem":1},{"lineBreak":true},{"text":"ai guu gàa à sì kũ̀o maamaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ben nↄgbɛ̃ pì bↄ̀ à mↄ̀ daàlɛ ↄ̃ndↄ̃'ↄ̃ndↄ̃,","poem":1},{"lineBreak":true},{"text":"èe ↄ maa a zĩndaa lán kaarua bà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kùgbãadeemɛ, à wísai vĩ,","poem":1},{"lineBreak":true},{"text":"à pↄ̀rↄ è pɛ́ɛ bɛro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zĩkenↄa ègↄ̃ kú zɛ́daan, zĩkenↄa gãalɛ,","poem":1},{"lineBreak":true},{"text":"ègↄ̃ kpáɛ kɛɛ zɛ́ↄ̃nkpakↄ̃a.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ben à ↄ̀wazi pì kũ̀ à lɛ́ pɛ̀a,","poem":1},{"lineBreak":true},{"text":"à wɛ́ɛkpãntɛ̃ dàɛzi à bè:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sáabukpa sa'ona kúma yã,","poem":1},{"lineBreak":true},{"text":"ben ma lù kɛ̀ má sɛ̀ pì fĩa bò gbã̀a.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wa kↄ̃'ena yãnzin ma bↄzi,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ n wɛtɛɛ ma n e kɛ̀ sↄ̃.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma kuntu kpàɛ ma gádoa","poem":1},{"lineBreak":true},{"text":"kↄ̃n Igipiti bùsu bisa wɛ́ɛ maaao.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma tuaetiti fã̀ ma daɛkiia","poem":1},{"lineBreak":true},{"text":"kɛ̀ wà kɛ̀ kↄ̃n lí'ↄ gũ nnannaao kↄ̃n lítɛɛo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ǹ mↄ́ wà yenzi kɛ ai guu gá dↄo,","poem":1},{"lineBreak":true},{"text":"wà wa pↄyezi kɛ ai à mↄ́wa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Zaakɛ ma zã kú bɛro,","poem":1},{"lineBreak":true},{"text":"wɛ́tɛ kɛ̀ à gàan zã̀.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"À ↄↄsↄ yì à gàao,","poem":1},{"lineBreak":true},{"text":"ai àgↄ̃ gá su mↄↄ é ↄsi kɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"À à swɛ̃̀ blè kↄ̃n yã pari bↄɛnao,","poem":1},{"lineBreak":true},{"text":"à gã nàa kↄ̃n yãnnanna'onao.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ben ↄ̀wazi pì bↄ̀ à tɛ̀zi gↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"lán zù kɛ̀ wèe gaa kòto kpá bà,","poem":1},{"lineBreak":true},{"text":"lán gãa kɛ̀ èe gbá pɛɛɛ bàn dↄ̃,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"lán bãa kɛ̀ èe wãa à sì taan bà.","poem":1},{"lineBreak":true},{"text":"Èe dↄ̃ kɛ̀ a a zĩnda kpà gaazinlo,","poem":1},{"lineBreak":true},{"text":"ai kà gàa à à swɛ̃̀ kũ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Tia sa, ma nɛ́nↄ, à ma yã ma,","poem":1},{"lineBreak":true},{"text":"à làakari dↄ yã kɛ̀ èe bↄↄ ma lɛ́n-a.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Àton tó a laasuu tá à kiiaro,","poem":1},{"lineBreak":true},{"text":"àton sãsã à gɛ̃ à zɛ́nlo.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ à ń nɛ́ à ń kaatɛnↄↄ pari,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ à ń dɛdɛ pìnↄ lɛ́ vĩro.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"À bɛɛ nɛ́ mira zɛ́daamɛ,","poem":1},{"lineBreak":true},{"text":"è gɛ̃ńyo gɛ̀wãa kpɛ́nɛn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}