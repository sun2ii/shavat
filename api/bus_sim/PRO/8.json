{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":8,"content":[{"type":"heading","content":["Ɔ̃ndↄ̃ e wa sisii"]},{"type":"verse","number":1,"content":["Ɔ̃ndↄ̃ↄ bé èe lɛ́ zuuwaziroo?",{"text":"Wɛ́ɛzɛ̃ɛ bé èe wa sisiiroo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À kú sĩ̀sĩ musu zɛ́ gɛɛzi,","poem":1},{"lineBreak":true},{"text":"à zɛna zɛ́ↄ̃nkpakↄ̃a.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À kú wɛ́tɛ bĩilɛ saɛ,","poem":1},{"lineBreak":true},{"text":"à kòto dↄ bĩilɛ pì gbànↄ kiia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃nↄ, ámbe mɛ́ɛ a sisii,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nteenↄ, mɛ́ɛ lɛ́ zuuazi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nigãzĩdeenↄ, à làakari wɛtɛ àgↄ̃ vĩ,","poem":1},{"lineBreak":true},{"text":"yↄ̃nkↄↄnↄ, à tó àgↄ̃ laasuu vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À swã kpá, zaakɛ yã tìisin mɛ́ oare,","poem":1},{"lineBreak":true},{"text":"yã dↄ̀rↄdee bé eé bↄ ma lɛ́n.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zaakɛ ma lɛ́ è yãpuraa o,","poem":1},{"lineBreak":true},{"text":"ma za à zaaan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yã kɛ̀ aↄ̃ↄ kú ma lɛ́nnↄↄ maa,","poem":1},{"lineBreak":true},{"text":"aↄ̃ kee mↄnafiki ke sãsãna vĩro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À súusu asãnsideenↄnɛ píngi,","poem":1},{"lineBreak":true},{"text":"à zɛ́ vĩ gbɛ̃ kɛ̀ aↄ̃ↄ dↄ̃na vĩinↄnɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À ma lɛ́damma sɛ́ dɛ kondogila,","poem":1},{"lineBreak":true},{"text":"à dↄ̃na sɛ́ dɛ vura maaala.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zaakɛ ↄ̃ndↄ̃ↄ bɛ̀ɛ vĩ dɛ gbɛ̀bainↄla,","poem":1},{"lineBreak":true},{"text":"pↄ́ke nii kúmma kɛ̀ kà à ũro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mamↄma ↄ̃ndↄ̃, má làakari vĩ,","poem":1},{"lineBreak":true},{"text":"má yãkɛna a zɛ́a dↄ̃na vĩ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Vĩakɛna Diinɛn zana à zaaan ũ.","poem":1},{"lineBreak":true},{"text":"Ma za zĩndasɛna lezĩn kↄ̃n ĩadãnao","poem":1},{"lineBreak":true},{"text":"kↄ̃n kuuna zaaao kↄ̃n yãlɛkpɛɛ'onao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lɛ́damma kↄ̃n faakɛɛo nɛ́ ma pↄ́mɛ,","poem":1},{"lineBreak":true},{"text":"ma kiian gbãaa è bↄn kↄ̃n asãnsikɛɛo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kínanↄ è kpata ble ma gãzĩmɛ,","poem":1},{"lineBreak":true},{"text":"kpatablerinↄ è yãzɛdee diɛ kↄ̃n ma gbãaaomɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbãadeenↄ è iko kɛ ma gãzĩmɛ","poem":1},{"lineBreak":true},{"text":"kↄ̃n anduna kpatadeenↄ ń píngi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Má ye gbɛ̃ kɛ̀ aↄ̃ↄ yemaziinↄzi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃è ma wɛtɛnↄ bé wè ma e.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Auziki kↄ̃n gakuio kú ma ↄzĩ","poem":1},{"lineBreak":true},{"text":"kↄ̃n ↄↄda kaaranao kↄ̃n kuuna nnaao.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Nɛ́ kɛ̀ mɛɛ̀ ińnɛ sã̀ↄ dɛ vura maaala,","poem":1},{"lineBreak":true},{"text":"kaarana kɛ̀ mɛɛ̀ kɛńnɛ dɛ kondogi wásawasala.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Má tɛ́ yãzɛde zɛ́n,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ táa o zɛ́ súusu guu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mɛɛ̀ gbɛ̃ kɛ̀ aↄ̃ↄ yemaziinↄ gba pↄ́,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ ń auzikikaɛkiinↄ pańnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Dii ma kɛ zaa a zĩ naanagurↄ,","poem":1},{"lineBreak":true},{"text":"ai àgↄ̃ gá yã kɛ̀ à kɛ̀ zaa káakunↄ kɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"À ma diɛ zaa káakumɛ,","poem":1},{"lineBreak":true},{"text":"zaa à daɛgurↄ, lɛ èe anduna kɛ kↄ̀ro.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"À ma i zaalɛ ísiaa kuuro,","poem":1},{"lineBreak":true},{"text":"íbↄki kee kuu gurↄ beeearo.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"À ma i kpiiinↄ ã,","poem":1},{"lineBreak":true},{"text":"ai àgↄ̃ gá sĩ̀sĩnↄ kãsãa pɛ́ɛ,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ai àgↄ̃ gá anduna káɛ,","poem":1},{"lineBreak":true},{"text":"ke sɛ̃̀tɛ ke bùsu wɛ́n doo.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Kɛ̀ èe pↄ́ kɛ̀ kú musunↄ kɛɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ èe bàtuma daa ísiaala,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"kɛ̀ èe lou naa musu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ èe tↄↄtɛ í zɛ́ fↄ̃ↄ,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"kɛ̀ èe ísia zɛki lɛ́ kɛɛ,","poem":1},{"lineBreak":true},{"text":"lɛ à í tón vĩ à zɛki lɛ́laro,","poem":1},{"lineBreak":true},{"text":"kɛ̀ èe anduna kaɛɛ, má kú gwe.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Má kú à saɛ ↄzĩkɛri maaa ũ,","poem":1},{"lineBreak":true},{"text":"ma pↄↄ ègↄ̃ nna à aɛzĩ lán guu e dↄↄ nà,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀gↄ̃ pↄnnaa kɛɛo gurↄ sãnda píngi.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ma pↄↄ ègↄ̃ nna Dii andunaa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nteenↄↄ dɛ ma pↄnnakɛbↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Tia sa, ma nɛ́nↄ, à ma yã ma,","poem":1},{"lineBreak":true},{"text":"aubarikadeen gbɛ̃ kɛ̀ ma zɛ́ kũna ũ.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"À ma lɛ́damma ma à ↄ̃ndↄ̃ kũ,","poem":1},{"lineBreak":true},{"text":"àton pã kpáziro.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Aubarikadeen gbɛ̃ kɛ̀ èe swã kpaa ma yãzi ũ","poem":1},{"lineBreak":true},{"text":"kɛ̀ ègↄ̃ ma wɛtɛɛ ma kpɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ ègↄ̃ ma dãa gurↄ sãnda píngia.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Zaakɛ gbɛ̃ kɛ̀ ma ee wɛ̃̀ndi è,","poem":1},{"lineBreak":true},{"text":"eégↄ̃ nna kↄ̃n Diio.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ kòramazii yã zaaa ì a zĩndanɛmɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ zàmaguunↄↄ ye gaazimɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}