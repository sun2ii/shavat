{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PRO","translationId":"bus_sim","name":"YAASINƆ","commonName":"YAASINƆ","title":"YAASINƆ","order":20,"numberOfChapters":31,"sha256":"0f4f3c3f0c88c4bb96314b8a9822b420ff1aa0becf25292b969151233199c69b","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bus_sim/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":9,"content":[{"type":"heading","content":["Ɔ̃ndↄ̃ kↄ̃n yↄ̃nkↄkɛɛo"]},{"type":"verse","number":1,"content":["Ɔ̃ndↄ̃ↄ a kpɛ́ bò,",{"text":"à a wesagbanↄ à mɛ̀n swɛɛplaa à pɛ̀ɛpɛɛ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"à nↄ̀bↄ dɛ̀ à wɛ̃ɛ bà,","poem":1},{"lineBreak":true},{"text":"à pↄ́bleenↄ soru kɛ̀ à kàɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À a nↄkparɛ zĩkɛrinↄ zĩ̀,","poem":1},{"lineBreak":true},{"text":"èe lɛ́ zuu wɛ́tɛ sĩ̀sĩ mìsↄ̃ntɛ̃a à bè:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A faasaideenↄ à ɛara à mↄ́ kɛ̀!","poem":1},{"lineBreak":true},{"text":"A laasuusaideenↄ mɛ́ɛ ooare,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"à mↄ́ à ma pↄ́blee ble,","poem":1},{"lineBreak":true},{"text":"à wɛ̃ɛ kɛ̀ má bà mi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À a yↄ̃nkↄkɛɛ tó, égↄ̃ kú wɛ̃̀ndio,","poem":1},{"lineBreak":true},{"text":"à táa o wɛ́ɛkɛ̃na zɛ́n.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gbɛ̃ kɛ̀ èe fabori daa zɛ́a e sↄ̃sↄ̃ wɛtɛɛmɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ èe kpãkɛ̃ɛ zaakɛrizi e taari wɛtɛɛ a zĩndanɛmɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹton kpãkɛ̃ faboriziro, zaakɛ eé kɛnyo ĩimɛ,","poem":1},{"lineBreak":true},{"text":"ǹ ↄ̃ndↄ̃dee da zɛ́a, eégↄ̃ yenzi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ yã da ↄ̃ndↄ̃rinɛ, à ↄ̃ndↄ̃ↄ é diàlɛ,","poem":1},{"lineBreak":true},{"text":"ǹ yã o gbɛ̃ maaanɛ, à dↄ̃na é kaara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vĩakɛna Diinɛn ↄ̃ndↄ̃ kãsãa ũ,","poem":1},{"lineBreak":true},{"text":"Luda kɛ̀ kú adona dↄ̃nan wɛ́ɛkɛ̃na zɛ́ ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zaakɛ nɛ́ gì kɛ ma gãzĩ,","poem":1},{"lineBreak":true},{"text":"n wɛ̃̀ndi gbã̀a é kaara.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó ń ↄ̃ndↄ̃, n zĩndanɛmɛ,","poem":1},{"lineBreak":true},{"text":"tó faborin n ũ, n mì musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mìsaikɛɛ dɛ lán nↄgbɛ̃ lɛ́dee bàmɛ,","poem":1},{"lineBreak":true},{"text":"à ↄ̃ndↄ̃ↄ vĩro bensↄ̃ à yãke dↄ̃ro.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"È vɛ̃ɛ kìtaa a kpɛɛlɛ,","poem":1},{"lineBreak":true},{"text":"à kpɛ́ kú wɛ́tɛ sĩ̀sĩa,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"èe lɛ́ zuu gbɛ̃ kɛ̀ aↄ̃ↄe gɛ̃tɛɛnↄzi,","poem":1},{"lineBreak":true},{"text":"èe bee gbɛ̃ kɛ̀ aↄ̃ↄ tɛ́ ń zɛ́n súusunↄnɛ:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A faasaideenↄ à ɛara à mↄ́ kɛ̀!","poem":1},{"lineBreak":true},{"text":"A laasuusaideenↄ, mɛ́ɛ ooare,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"í kpãi mina ègↄ̃ nna,","poem":1},{"lineBreak":true},{"text":"pↄ́blena asii guu nɛ́ zↄ́mɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Gbɛ̃ pìnↄↄ dↄ̃ kɛ̀ beee nɛ́ gɛ̀wãa zɛ́nlo,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ mìsaikɛɛ ń sisinↄ sì gɛ̀wãa tùtuwɛɛn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}