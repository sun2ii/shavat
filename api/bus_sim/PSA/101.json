{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":101,"content":[{"type":"heading","content":["Kína lɛ́gbɛ̃na Ludanɛ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Mɛ́ lɛ̀ da n gbɛ̃kɛ kↄ̃n yãzɛdeeo musu,","poem":1},{"lineBreak":true},{"text":"mɛ́ lɛ̀ sínnɛ, Dii.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɛ́ làakari kɛ màgↄ̃ kuu taari sai,","poem":1},{"lineBreak":true},{"text":"bↄrɛn nɛ́ mↄ́mazii?","poem":1},{"lineBreak":true},{"text":"Mɛ́gↄ̃ kú ma ua kↄ̃n nↄ̀sɛpuraao,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma wɛ́ɛ égↄ̃ kú pↄ́ ginaaro,","poem":1},{"lineBreak":true},{"text":"mɛ́ za yãdↄrↄsaikɛnan, eé namaro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma nↄ̀sɛ égↄ̃ mↄnafiki vĩro,","poem":1},{"lineBreak":true},{"text":"ma bà égↄ̃ kú kↄ̃n yã zaaaoro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mɛ́ gbɛ̃ kɛ̀ è a gbɛ̃daaa yaka à kpɛɛ kaatɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ sùu fↄ̃ kↄ̃n wadadeenↄ kↄ̃n ĩadãrinↄoro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma wɛ́ɛ égↄ̃ kú ma bùsu náanɛdeenↄa,","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃gↄ̃ kúmao,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ ègↄ̃ kú taari sai égↄ̃ dɛ ma zĩkɛri ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mɛ́ we gbɛ̃sãsãri gↄ̃ kú ma bɛro,","poem":1},{"lineBreak":true},{"text":"mɛ́ tó mↄnafikidee zɛ ma aɛro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɛ́gↄ̃ ma bùsu gbɛ̃ zaaanↄ kaatɛ lán guu e dↄↄ nà,","poem":1},{"lineBreak":true},{"text":"mɛ́gↄ̃ zaakɛrinↄ borii bↄↄ Dii wɛ́tɛ guu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}