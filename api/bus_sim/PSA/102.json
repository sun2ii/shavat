{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":102,"content":[{"type":"heading","content":["Gbãasaidee aduakɛna"]},{"type":"hebrew_subtitle","content":["Wɛ̃ndade gbãasaidee kɛ̀ èe a yã'ↄ̃ammanↄ bↄɛɛ Diinɛ aduakɛna."]},{"type":"verse","number":1,"content":[{"text":"Dii, ǹ ma aduakɛna ma,","poem":1},{"lineBreak":true},{"text":"ǹ tó ma wiii n kii le.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹton wɛ́ɛ gá ǹ zumɛ ma nawɛ̃akɛgurↄro,","poem":1},{"lineBreak":true},{"text":"ǹ swã kpámazi,","poem":1},{"lineBreak":true},{"text":"tó ma n sisi, ǹ wemala kpakpaa,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zaakɛ ma gurↄↄ e gɛ̃tɛɛ lán tɛ́sukpɛ bà,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀ e puusu bↄↄ lán tɛ́yↄ̃ bà.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma nↄ̀sɛ yàka, ma gↄ̃ lán sɛ̃̀ kori bà,","poem":1},{"lineBreak":true},{"text":"ma sã pↄ́bleyãn.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma m̀bona gbãngbãn bé à tò","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ wákabaran ũ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma gↄ̃ lán gbáa tiongoo bà,","poem":1},{"lineBreak":true},{"text":"lán bɛzĩ koroo bà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ii è gɛ̃ ma wɛ́ɛnlo,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ lán bãa kɛ̀ zↄ̃ kpɛ́ musu adoo bà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma ibɛɛnↄ ègↄ̃ ma sↄ̃sↄ̃ↄ gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"ma faborinↄ è gbɛ̃ ká kↄ̃n ma tↄ́o.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Túbun mɛɛ̀ ble pↄ́blee ũ,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ɛ'i è ká ma íminan","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"n pↄfɛ̃ kↄ̃n n pɛ̃tɛ̃o yãnzi,","poem":1},{"lineBreak":true},{"text":"zaakɛ n ma sɛ n ma zĩnna.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma gurↄↄ e gɛ̃tɛɛ lán ↄra bà,","poem":1},{"lineBreak":true},{"text":"ben mɛ́ɛ gagaa lán sɛ̃̀ bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mpi sↄ̃ Dii,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀gↄ̃ kú kpatan gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"n tↄ́ é garo ai wa boriia.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nɛ́ fɛɛ ǹ Zayↄn wɛ̃nda gwa, zaakɛ gurↄↄ kà,","poem":1},{"lineBreak":true},{"text":"gurↄↄ kɛ̀ ń dìɛ kà, kɛ̀ nɛ́ à pↄnnaa wɛtɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À gbɛ̀nↄ kɛ̀ n zↄ̀blerinↄnɛ maa,","poem":1},{"lineBreak":true},{"text":"à gborona bùsu è kɛńnɛ wɛ̃nda.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Bori píngi é vĩa kɛnnɛ, Dii,","poem":1},{"lineBreak":true},{"text":"anduna kínanↄ é n kíkɛɛ dↄ̃ ń píngi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Zaakɛ Dii é Zayↄn kɛkɛ à bo dↄ,","poem":1},{"lineBreak":true},{"text":"eé bↄ à mↄ́ḿma kↄ̃n gakuio.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Eé takaasideenↄ aduakɛna sí,","poem":1},{"lineBreak":true},{"text":"eé ń wɛ́ɛkɛna kpá swãkotoro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"À tó yã kɛ̀ gↄ̃ kɛ̃na kpɛɛdeenↄ yãnzi","poem":1},{"lineBreak":true},{"text":"lɛ gbɛ̃ kɛ̀ aↄ̃ kpɛ́nↄ Dii táaki lɛ́.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dii tↄↄtɛ gwà zaa a kúkiia,","poem":1},{"lineBreak":true},{"text":"zaa musu à wɛ́ɛ kpàɛ gĩzĩ,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"lɛ à gbɛ̃nↄ zↄ̀blena wii ma","poem":1},{"lineBreak":true},{"text":"à ń bↄ gaa lɛ́zĩ yãnzi,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Weé Dii tↄ́ bↄ Zayↄn,","poem":1},{"lineBreak":true},{"text":"weé à táaki lɛ́ Yerusalɛmu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"zĩ kɛ̀ gbɛ̃nↄ é kↄ̃ kakↄ̃a gwe,","poem":1},{"lineBreak":true},{"text":"kↄ̃n kpatablerinↄ wà dↄnzi kɛnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"À ma gbãaa bùsa zɛ́gbãn,","poem":1},{"lineBreak":true},{"text":"à ma wɛ̃̀ndi kɛ̀ kusu,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ben ma bè: Ma Luda,","poem":1},{"lineBreak":true},{"text":"ǹton ma wɛ̃̀ndi bↄ gugbãnlo,","poem":1},{"lineBreak":true},{"text":"mmↄn kɛ̀ ń kuu ai wa boriia.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"N anduna kãsãa pɛ̀ɛ zaa káaku,","poem":1},{"lineBreak":true},{"text":"musu nɛ́ n ↄzĩimɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Aↄ̃ píngi é gɛ̃tɛ, mↄde nɛ́gↄ̃ kuu,","poem":1},{"lineBreak":true},{"text":"aↄ̃é zi kũ lán pↄ́kãsãa bà,","poem":1},{"lineBreak":true},{"text":"nɛ́ ń liɛ lán uta bà ǹ ń zĩnna.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Mpi sↄ̃ n kuuna ègↄ̃ dↄ̃nkↄ̃,","poem":1},{"lineBreak":true},{"text":"n gurↄↄ yãana vĩro.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"N zↄ̀blerinↄ nɛ́nↄ égↄ̃ kuu aafia,","poem":1},{"lineBreak":true},{"text":"aↄ̃ boriinↄ é kãsãa pɛ́ɛ n kuu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}