{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":103,"content":[{"type":"heading","content":["Luda gbɛ̃kɛɛ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Ma swɛ̃̀, ǹ Dii sáabu kpá,","poem":1},{"lineBreak":true},{"text":"ma baabↄ píngi, ǹ à tↄ́ kɛ̀ kú adona bↄ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma swɛ̃̀, ǹ Dii sáabu kpá,","poem":1},{"lineBreak":true},{"text":"ǹton sã à yãmaakɛna kenlo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"È ma taarinↄ kɛ̃mɛ píngi,","poem":1},{"lineBreak":true},{"text":"è ma kɛ̃kↄ̃a kↄ̃n ma gyãanↄ píngi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"È ma wɛ̃̀ndi bↄ gɛ̀wãan,","poem":1},{"lineBreak":true},{"text":"è à nnaa dialɛmɛ a gbɛ̃kɛ kↄ̃n a wɛ̃ndao guu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"È tó pↄ́ maaa kɛ̀ má yezinↄ mↄ́ma,","poem":1},{"lineBreak":true},{"text":"lɛ ma gↄ̃kparɛkɛɛ e àgↄ̃ dufu lán kúu pↄ́ bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dii è yã kɛ a zɛ́a,","poem":1},{"lineBreak":true},{"text":"è tó yã bↄ kↄ̃n gwenawɛ̃ndadeenↄo nna.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À tò Musa a pↄyeziyã dↄ̃̀,","poem":1},{"lineBreak":true},{"text":"à a yãbↄnsaɛnↄ ↄ̀dↄa Isarailinↄnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii sùu vĩ kↄ̃n wɛ̃ndaao,","poem":1},{"lineBreak":true},{"text":"à pↄↄ è fɛ̃ kpaaro,","poem":1},{"lineBreak":true},{"text":"à gbɛ̃kɛ bíta maamaa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Eé ń taari e gɛ̃̀n baaagↄ̃ro,","poem":1},{"lineBreak":true},{"text":"eé pↄfɛ̃ da a nↄ̀sɛn gurↄ píngiro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"È yã kɛwe lán wa durunnↄↄ dɛ nàro,","poem":1},{"lineBreak":true},{"text":"è fĩa bowe lán wa zãzãanↄↄ dɛ nàro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Lán ludambɛ lezĩ kà nà kↄ̃n tↄↄtɛo,","poem":1},{"lineBreak":true},{"text":"lɛn à gbɛ̃kɛɛ bíta lɛ kↄ̃n à vĩakɛrinↄ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Lán ↄfãntɛ̃bↄɛ kpaa zã̀ kↄ̃n a gɛ̃kpɛn kpaao nà,","poem":1},{"lineBreak":true},{"text":"lɛn è wa taarinↄ kɛ̃wa lɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Lán de è wɛ̃nda dↄ̃ a nɛ́nↄnɛ nà,","poem":1},{"lineBreak":true},{"text":"lɛn Dii è a vĩakɛrinↄ wɛ̃nda gwa lɛ,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zaakɛ à dↄ̃ pↄ́ kɛ̀ à wa kɛo,","poem":1},{"lineBreak":true},{"text":"à dↄ̀n kɛ̀ bùsun wa ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gbɛ̃ntee wɛ̃̀ndi kusu lán sɛ̃̀ bà,","poem":1},{"lineBreak":true},{"text":"ègↄ̃ gakui vĩ gurↄ plaa lán lávu bà.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tó ĩa pàa, è gɛ̃tɛ,","poem":1},{"lineBreak":true},{"text":"guu kɛ̀ à kún pì è dↄ à yãn dↄro.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dii ègↄ̃ gbɛ̃kɛɛ vĩ kↄ̃n a vĩakɛrinↄ","poem":1},{"lineBreak":true},{"text":"zaa káaku ai gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"è à maaa kɛ ń nɛ́nↄnɛ kↄ̃n ń dionↄ,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ zɛ̀ kↄ̃n à bà kuunańyo yão","poem":1},{"lineBreak":true},{"text":"bensↄ̃ aↄ̃ yã kɛ̀ à dìɛnↄ kũnanↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dii a kpata dìɛ musu,","poem":1},{"lineBreak":true},{"text":"à gbãaa vĩ gbɛ̃ píngia.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"À Dii sáabu kpá, amↄa à malaikanↄ,","poem":1},{"lineBreak":true},{"text":"a gbãadee kɛ̀ eè à yã ma à zĩi kɛanↄ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"À Dii sáabu kpá, a ludambɛ zĩ̀kpɛɛnↄ a píngi,","poem":1},{"lineBreak":true},{"text":"à zĩkɛri kɛ̀ eè à pↄyeziyã kɛɛnↄ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"À Dii sáabu kpá, amↄa à pↄ́kɛnanↄ a píngi","poem":1},{"lineBreak":true},{"text":"guu kɛ̀ èe kí bleennↄ baama píngi.","poem":1},{"lineBreak":true},{"text":"Ma swɛ̃̀, ǹ Dii sáabu kpá.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}