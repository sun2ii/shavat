{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":104,"content":[{"type":"heading","content":["Dii Pↄ́pingikɛri táakilɛna"]},{"type":"verse","number":1,"content":[{"text":"Ma swɛ̃̀, ǹ Dii sáabu kpá.","poem":1},{"lineBreak":true},{"text":"Dii ma Luda, ń bíta maamaa,","poem":1},{"lineBreak":true},{"text":"ń gakui dana pↄ́kãsãa ũ, èe tɛ́ kɛɛ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"n gupuraa kùnla lán bisa bà,","poem":1},{"lineBreak":true},{"text":"n musu kpàɛ lán pɛ̀ bà,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"n bɛɛ bò ínↄla musu.","poem":1},{"lineBreak":true},{"text":"N ludambɛ luguu kɛ̀ n sↄ̃goro ũ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ di ĩa ↄↄa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ ĩa kɛ n zĩ̀rinↄ ũ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ tɛ́vura kɛ n zĩkɛrinↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N anduna kàɛ, n à kãsãa pɛ̀ɛ,","poem":1},{"lineBreak":true},{"text":"à nigãna vĩ zikiro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N ísiaa dànɛ uta gumusu ũ,","poem":1},{"lineBreak":true},{"text":"í pì dà kpiiinↄla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N kpãkɛ̃ í pìzi, ben à bàa lɛ̀,","poem":1},{"lineBreak":true},{"text":"n pataa, ben à nàguzi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kpiiinↄ bↄ̀ gupuraaa, guzurɛnↄ sↄ̃̀ɛ,","poem":1},{"lineBreak":true},{"text":"ben í tà guu kɛ̀ ń dìɛnɛn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N lɛ́zɛkii dà í pìnɛ, eé fↄ̃ à vĩàlaro,","poem":1},{"lineBreak":true},{"text":"eé ɛara à da tↄↄtɛla ziki dↄro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nɛɛ̀ tó íbↄkiinↄ í pisi swa'ↄnɛnↄn,","poem":1},{"lineBreak":true},{"text":"ben à í ègↄ̃ bàa lɛɛ kpiiinↄ dagura.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sɛ̃̀tɛ pↄ́ píngi ègↄ̃ à í mii,","poem":1},{"lineBreak":true},{"text":"à í è saginↄ í nii kɛ̃ḿma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bãanↄ è sà dↄ swaanↄ saɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ègↄ̃ kú à dàko guu, aↄ̃ wiii ègↄ̃ dↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zaa n bɛ musu nɛɛ̀ lou gbarɛ kpiiinↄa,","poem":1},{"lineBreak":true},{"text":"n zĩ gbɛ̀ è anduna kã.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ tó sɛ̃̀ bↄɛ pↄ́kãdeenↄnɛ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ tó burapↄnↄ bↄɛ gbɛ̃nteenↄnɛ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ pↄ́blee bↄɛńnɛ tↄↄtɛa,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"geepiwɛ̃ɛ kɛ̀ è ń pↄↄ kɛ nnaa","poem":1},{"lineBreak":true},{"text":"kↄ̃n nↄ́si kɛ̀ è ń uu tɛ́ kɛɛo","poem":1},{"lineBreak":true},{"text":"kↄ̃n blɛɛ kɛ̀ è ń gba gbãaao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dii línↄ è mↄdↄ e maamaa,","poem":1},{"lineBreak":true},{"text":"sida lí kɛ̀ à bà Lɛbanↄnↄ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gwen bãanↄ è sà dↄdↄn,","poem":1},{"lineBreak":true},{"text":"zùbaaninↄ è bɛɛ dↄ pini lí musu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kpii lezĩnↄↄ dɛ kpasaanↄ kúkii ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̀kotoonↄ dɛ gbɛ̀'ɛ̃ɛnↄ utɛkii ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"N mↄvura kɛ̀ gurↄ tàasikɛbↄ ũ","poem":1},{"lineBreak":true},{"text":"kↄ̃n ↄfãntɛ̃ kɛ̀ à a gɛ̃na kpɛ́n gurↄↄ dↄ̃ↄo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ tó guu si, ben gwãavĩ è kɛ,","poem":1},{"lineBreak":true},{"text":"lákpɛpↄnↄ è fɛɛ táo píngi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Músunↄ è nↄadɛna ↄ́ↄ dↄ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è pↄ́blee wɛtɛ Ludaa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tó ↄfãntɛ̃ bↄ̀ɛ, aↄ̃è lↄↄtɛ","poem":1},{"lineBreak":true},{"text":"aↄ̃ tá daɛ ń tòn.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gbɛ̃ntee è bↄ à gá zĩi kɛ,","poem":1},{"lineBreak":true},{"text":"ègↄ̃ yã ma a zĩndaa ai uusiɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Dii, n yãkɛnanↄↄ pari fá!","poem":1},{"lineBreak":true},{"text":"À píngi bↄ̀ n ↄ̃ndↄ̃ↄ guumɛ,","poem":1},{"lineBreak":true},{"text":"anduna pana kↄ̃n pↄ́ kɛ̀ ń kɛ̀nↄ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ísia kuu, à bíta bensↄ̃ à yàasa,","poem":1},{"lineBreak":true},{"text":"pↄ́ bɛ̃ɛ kɛ̀ kú à guunↄ lɛ́ vĩro,","poem":1},{"lineBreak":true},{"text":"à nɛ́ngo kↄ̃n à bítao píngi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Góro'itɛnↄ ègↄ̃ táa oon","poem":1},{"lineBreak":true},{"text":"kↄ̃n kúkukuu kɛ̀ ń kɛ̀ à kↄ̃kↄ̃ o à guuo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Pↄ́ pìnↄ è wɛ́ɛ dↄnzi ń píngi","poem":1},{"lineBreak":true},{"text":"lɛ ǹ pↄ́blee kpáḿma a gurↄↄa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ kpáḿma, aↄ̃è sɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ ↄ porońnɛ, ben pↄ́ maaanↄ è mↄ́ḿma.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tó n mìkpɛɛ zùńnɛ, aↄ̃è bídi kɛmɛ,","poem":1},{"lineBreak":true},{"text":"tó n wɛ̃̀ndi sìḿma, aↄ̃è ga wà ɛara wà tá bùsutin.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tó n n Ninii gbàrɛ, pↄ́nↄ è wɛ̃̀ndi e,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ tó tↄↄtɛ ɛara à kɛ dufu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Wà tó Dii gakui gↄ̃ kuu gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"wà tó Dii pↄↄ kɛ nna a yãkɛnanↄa.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Àmbe è tↄↄtɛ gwa, ben è dege,","poem":1},{"lineBreak":true},{"text":"è ↄ kɛ kpiiinↄa, ben tɛ́sukpɛ è bↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Mɛ́ lɛ̀ sí Diinɛ ai ma wɛ̃̀ndi lɛ́n,","poem":1},{"lineBreak":true},{"text":"mɛ́ ma Luda táaki lɛ́ ai ma gurↄ lɛ́n.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Ǹ tó ma laasuu kánnɛ, Dii,","poem":1},{"lineBreak":true},{"text":"lán mɛ́ɛ pↄnnaa kɛnyo nà.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Durunkɛrinↄ mì dɛ anduna guu,","poem":1},{"lineBreak":true},{"text":"zaakɛrinↄ tóngↄ̃ kuu dↄro.","poem":1},{"lineBreak":true},{"text":"Ma swɛ̃̀, ǹ Dii sáabu kpá.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}