{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":108,"content":[{"type":"heading","content":["Luda bé è tó wà zĩ̀ ble"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Ma làakari kpaɛna, Luda,","poem":1},{"lineBreak":true},{"text":"mɛ́ lɛ̀ sí mà n táaki lɛ́ kↄ̃n nↄ̀sɛo do.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma mↄrↄ kↄ̃n ma kuntigio kú máa?","poem":1},{"lineBreak":true},{"text":"Mɛ́ gudↄↄ pá mìo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii, mɛ́ n sáabu kpá boriinↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"mɛ́ n táaki lɛ́ gbɛ̃nↄnɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zaakɛ n gbɛ̃kɛɛ bíta kà n kiia,","poem":1},{"lineBreak":true},{"text":"n náanɛ ludambɛ luguu lè.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Luda, wà n tↄ́ sɛ́ lezĩ ai musumusu,","poem":1},{"lineBreak":true},{"text":"ǹ tó n gakui da andunala píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ǹ wewala ǹ wa mì sí kↄ̃n n gã̀sã gbãaao,","poem":1},{"lineBreak":true},{"text":"lɛ wamↄwa n gbɛ̃ yenzideenↄ e wà bↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Luda yã ò zaa a kúkiia à bè:","poem":1},{"lineBreak":true},{"text":"Mɛ́ Sɛkɛmu kpaatɛtɛ kↄ̃n zĩ̀blena wiiio,","poem":1},{"lineBreak":true},{"text":"mɛ́ gba da kↄ̃n Suko guzurɛo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Giliada bùsu nɛ́ ma pↄ́mɛ,","poem":1},{"lineBreak":true},{"text":"Manase boriinↄ bùsu nɛ́ ma pↄ́mɛ,","poem":1},{"lineBreak":true},{"text":"Ɛflaimu boriinↄ bùsu nɛ́ ma mↄ̀furamɛ,","poem":1},{"lineBreak":true},{"text":"Yudanↄ bùsu nɛ́ ma gòmɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mↄabunↄ bùsu nɛ́ ma ↄpipibↄmɛ,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ ma kyatee káɛ Ɛdↄmunↄ bùsun,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ zĩ̀blewiii dↄ Filisitininↄ bùsua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dé bé eé gɛ̃mao wɛ́tɛ bĩidee guuu?","poem":1},{"lineBreak":true},{"text":"Dé bé eé dↄmɛ aɛ ai Ɛdↄmunↄ bùsun?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Luda, à dɛ ḿbe n ↄ gbàrɛwazi,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ bↄ kↄ̃n wa zĩ̀kpɛɛnↄ dↄroo?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹ ↄ dawa wa ibɛɛnↄ yãnzi,","poem":1},{"lineBreak":true},{"text":"zaakɛ gbɛ̃ntee dↄnlɛ nɛ́ yã pãamɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wé zĩ̀ ble kↄ̃n Luda gbãaao,","poem":1},{"lineBreak":true},{"text":"àmbe eé kìti pá wa ibɛɛnↄa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}