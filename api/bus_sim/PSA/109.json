{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":109,"content":[{"type":"heading","content":["Sa zaaa ona ibɛɛnɛ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Luda, ḿbe mɛɛ̀ n táaki lɛ́,","poem":1},{"lineBreak":true},{"text":"ǹtongↄ̃ yĩtɛnaro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zaakɛ gbɛ̃ zaa bↄnkpɛɛdeenↄ è ma yaka,","poem":1},{"lineBreak":true},{"text":"aↄ̃è lɛ́ bↄ wà ɛgɛyã dima.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aↄ̃è ligamazi kↄ̃n zangu yão,","poem":1},{"lineBreak":true},{"text":"aↄ̃è swèe kɛmao pↄ́ke wíwinnɛna sai.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aↄ̃è yenzi sↄkpamɛ kↄ̃n yãdimmanao,","poem":1},{"lineBreak":true},{"text":"baa kɛ̀ mɛɛ̀ adua kɛńnɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aↄ̃è à maaa fĩa bomɛ kↄ̃n à zaaao,","poem":1},{"lineBreak":true},{"text":"yenzi sↄ̃, kↄ̃n zanguo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ǹ Setãn swi kɛa,","poem":1},{"lineBreak":true},{"text":"ǹ à kpakↄ̃zi kↄ̃n Ibilisio.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ tó yãkpaɛ à ble,","poem":1},{"lineBreak":true},{"text":"ǹ tó à aduakɛna kɛnɛ taari ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À wɛ̃̀ndi gↄ̃ kusu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ pãnde gↄ̃ à gɛ̃ɛ ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À nɛ́nↄ gↄ̃ de sai,","poem":1},{"lineBreak":true},{"text":"à naↄ̃ gↄ̃ gyaanↄↄ ũ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À nɛ́nↄ gↄ̃ likↄ̃azↄ̃rinↄ ũ wàgↄ̃ baa kɛɛ,","poem":1},{"lineBreak":true},{"text":"wàgↄ̃ ń kpakɛɛ ń bɛ zĩnↄ guu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"À fĩadee à pↄ́nↄ nakↄ̃a píngi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ zĩ̀tↄnↄ à zĩ àre ble.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃ke tón gbɛ̃kɛɛ kɛnɛro,","poem":1},{"lineBreak":true},{"text":"wàton à nɛ́ kɛ̀ à tònↄ wɛ̃nda boro.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"À boriinↄ kaatɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ tↄ́ tóngↄ̃ kú borii kɛ̀ aↄ̃é fɛɛnↄ tɛ́ro.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À dezinↄ zaakɛna yã gↄ̃ dↄ Diin,","poem":1},{"lineBreak":true},{"text":"ǹton tó à da durun kɛ̃a zikiro.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aↄ̃ durun gↄ̃ dↄn Diin,","poem":1},{"lineBreak":true},{"text":"aↄ̃ yã sã gbɛ̃nↄn anduna guu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Zaakɛ èe dↄn à gbɛ̃kɛɛ kɛ gbɛ̃kenɛro,","poem":1},{"lineBreak":true},{"text":"è wɛ́ɛ tã takaasideenↄa kↄ̃n wɛ̃ndadeenↄ","poem":1},{"lineBreak":true},{"text":"kↄ̃n pↄsiadeenↄo ai gɛ̀wãan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"À ye sa zaa onnɛnazi,","poem":1},{"lineBreak":true},{"text":"ǹ tó à wí à musu.","poem":1},{"lineBreak":true},{"text":"Sa maa onnɛna è kánɛro,","poem":1},{"lineBreak":true},{"text":"ǹ tó aubarika kɛo zã̀.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"À lɛ́kɛnnɛna dà lán uta bà,","poem":1},{"lineBreak":true},{"text":"à à mɛ̀ yàku lán í bà,","poem":1},{"lineBreak":true},{"text":"à gɛ̃̀ à wánↄn lán nↄ́si bà.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kana pì gↄ̃ daàla lán uta bà,","poem":1},{"lineBreak":true},{"text":"àgↄ̃ dↄ à pii lán asaa bà.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii fĩa bo ma yãdimmarinↄnɛ lɛ","poem":1},{"lineBreak":true},{"text":"kↄ̃n gbɛ̃ kɛ̀ aↄ̃è yã zaaa o ma musunↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dii Gbãapingide,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ̃nda gwa n tↄ́ yãnzi,","poem":1},{"lineBreak":true},{"text":"ǹ ma bↄ n maakɛ kↄ̃n n gbɛ̃kɛɛo yãnzi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Zaakɛ takaaside wɛ̃ndadeen ma ũ,","poem":1},{"lineBreak":true},{"text":"ma pↄↄ yàka búgubugu.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mɛ́ɛ gɛ̃tɛɛ lán uusiɛ ↄra bà,","poem":1},{"lineBreak":true},{"text":"má dɛ lán kwaa kɛ̀ ĩa e sɛɛ bà.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Lɛ́yina tò ma gbá è sí sɛ́ dↄro,","poem":1},{"lineBreak":true},{"text":"ma yãyã ma gↄ̃ wↄ̀ↄzↄgↄ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ma gↄ̃ yáadↄzipↄ ũ ma yãdimmarinↄnɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è ma gwa wà mì gbãkɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ǹ dↄmalɛ, Dii ma Luda,","poem":1},{"lineBreak":true},{"text":"ǹ ma mì sí n gbɛ̃kɛ yãnzi,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"lɛ aↄ̃ dↄ̃ kɛ̀ n ↄↄ bé à kɛ̀,","poem":1},{"lineBreak":true},{"text":"ḿbe Dii, n kɛnamɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Baa tó aↄ̃ ma ka, nɛ́ aubarika damagu,","poem":1},{"lineBreak":true},{"text":"tó aↄ̃ fɛ̀ɛmazi, wí é ń kũ,","poem":1},{"lineBreak":true},{"text":"mapi n zↄ̀bleri mɛ́ pↄnnaa kɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tↄ́ zaaa gↄ̃ ma yãdimmarinↄnɛ uta ũ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ wí da ń zĩndaa lán gumusu bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Mɛ́ Dii sáabu kpá kↄ̃n kòto gbãaao,","poem":1},{"lineBreak":true},{"text":"mɛ́ à táaki lɛ́ pari kakↄ̃ana guu.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Zaakɛ è zɛ kↄ̃n wɛ̃ndadeenↄ,","poem":1},{"lineBreak":true},{"text":"è ń sí gbɛ̃ kɛ̀ aↄ̃è yã vɛ̃ɛḿmanↄa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}