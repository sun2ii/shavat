{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":110,"content":[{"type":"heading","content":["Mɛsaya kíkɛɛ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii bè ma diinɛ à vɛ̃ɛ a ↄplaazi","poem":1},{"lineBreak":true},{"text":"ai àgↄ̃ à ibɛɛnↄ kɛnɛ à tinti ũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii é tó n iko dagula,","poem":1},{"lineBreak":true},{"text":"nɛ́ kí ble n ibɛɛnↄa zaa Zayↄn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N gbɛ̃nↄ é ń zĩnda kpámma zĩ̀kagurↄ","poem":1},{"lineBreak":true},{"text":"kpiii kɛ̀ kú adona musu,","poem":1},{"lineBreak":true},{"text":"n gↄ̃kparɛnↄ é mↄ́ n kiia lán gudↄnao kpíikpana bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dii la dà, eé lɛ́ sↄkparo à bè:","poem":1},{"lineBreak":true},{"text":"Nɛ́gↄ̃ dɛ sa'ori ũ ai gurↄ píngi","poem":1},{"lineBreak":true},{"text":"Mɛlɛkizɛdɛki zɛ́kpaɛa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii kú n ↄplaazi,","poem":1},{"lineBreak":true},{"text":"eé kínanↄ dúgu zↄ̃ a pↄfɛ̃gurↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Eé yãkpaɛ kɛ kↄ̃n boriinↄ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ gɛ̀nↄ égↄ̃ kpá,","poem":1},{"lineBreak":true},{"text":"eé anduna píngi kínanↄ dúgu zↄ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Eé í mi swaazi zɛ́ lɛ́a,","poem":1},{"lineBreak":true},{"text":"beee yãnzin à mì égↄ̃ dana ílazi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}