{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":111,"content":[{"type":"heading","content":["Dii tↄ́bↄna"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Mɛ́ Dii sáabu kpá kↄ̃n nↄ̀sɛo do","poem":1},{"lineBreak":true},{"text":"gbɛ̃ maaanↄ kakↄ̃ana guu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii yãkɛnanↄↄ bíta,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ à yã kɛ̀ńnɛ nnaanↄ è wɛtɛ wà dↄ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À yãkɛnanↄↄ bɛ̀ɛ vĩ kↄ̃n gakuio,","poem":1},{"lineBreak":true},{"text":"à yãmaakɛna yãana vĩro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii tò wà dↄ a yãbↄnsaɛkɛnanↄn,","poem":1},{"lineBreak":true},{"text":"à sùu vĩ kↄ̃n wɛ̃ndaao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"È pↄ́blee kpá a vĩakɛrinↄa,","poem":1},{"lineBreak":true},{"text":"ègↄ̃ dↄ a bà kuunańyo yãn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À a yãkɛnanↄ gbãaa ↄ̀dↄa a gbɛ̃nↄnɛ,","poem":1},{"lineBreak":true},{"text":"à bori pãndenↄ bùsunↄ sì à kpàḿma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À yãkɛnanↄ náanɛ vĩ bensↄ̃ à zɛ́ vĩ,","poem":1},{"lineBreak":true},{"text":"à yãdannɛnanↄ yãpuraa vĩ píngi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yã pìnↄ kãsãa pɛɛna gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"è yã kɛ a zɛ́a kↄ̃n náanɛo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À mìsiri zĩ̀ à a gbɛ̃nↄ bò,","poem":1},{"lineBreak":true},{"text":"à bà kúńyo gurↄ píngi.","poem":1},{"lineBreak":true},{"text":"À tↄ́ kú adona, à naasi vĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vĩakɛna Diinɛn ↄ̃ndↄ̃ mì ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃ↄ à vĩa vĩinↄn asãnsideenↄ ũ.","poem":1},{"lineBreak":true},{"text":"À táakilɛna égↄ̃ yãana vĩro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}