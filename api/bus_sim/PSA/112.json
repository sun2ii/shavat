{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":112,"content":[{"type":"heading","content":["Gbɛ̃ kɛ̀ Dii vĩa vĩi"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Aubarikadeen gbɛ̃ kɛ̀ Dii vĩa vĩi ũ,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ Dii yãdiɛnanↄ è kánɛ maamaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"À nɛ́nↄ égↄ̃ gbãadeenↄ ũ ń bùsun,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuradee boriinↄ égↄ̃ dɛ aubarikadeenↄ ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɔↄ kↄ̃n auzikio di à bɛ,","poem":1},{"lineBreak":true},{"text":"à yãmaakɛna yãana vĩro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Baa gusiaan guu è pu gbɛ̃ maaanɛ,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuradee kɛ̀ sùu kↄ̃n wɛ̃ndaao vĩi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ è ↄ poro, kɛ̀ è pↄ́ sɛ̃kãńnɛ,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ è yã kɛ a zɛ́a, yã è bↄo nna.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pↄ́ke é gbɛ̃ maaa lá ble zikiro,","poem":1},{"lineBreak":true},{"text":"à yã égↄ̃ dↄńgu gurↄ píngi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Baaru zaaa è à vĩa kũro,","poem":1},{"lineBreak":true},{"text":"à làakari ègↄ̃ kpaɛna, ègↄ̃ Dii náanɛ vĩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À kù è vĩro, vĩa è à kũro","poem":1},{"lineBreak":true},{"text":"ai à gá à yↄ̃̀gↄ̃ kɛ a ibɛɛnↄa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"È gba da takaasideenↄnɛ maamaa,","poem":1},{"lineBreak":true},{"text":"à yãmaakɛna yãana vĩro,","poem":1},{"lineBreak":true},{"text":"à gbãaa ègↄ̃ kaara kↄ̃n bɛ̀ɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gbɛ̃ zaaa è à e à pↄ fɛ̃,","poem":1},{"lineBreak":true},{"text":"è swaa kakũn à naguzi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ zaaa pↄyezina è kɛ pã.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}