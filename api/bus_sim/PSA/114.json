{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":114,"content":[{"type":"heading","content":["Banla zĩbaa lɛ̀"]},{"type":"verse","number":1,"content":[{"text":"Kɛ̀ Isarailinↄ bↄ̀ Igipiti,","poem":1},{"lineBreak":true},{"text":"kɛ̀ Yakubu boriinↄ bↄ̀ gbɛ̃ zĩ̀tↄnↄ tɛ́,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yudanↄ bùsu gↄ̃̀ Dii kúkii ũ,","poem":1},{"lineBreak":true},{"text":"Isarailinↄ bùsu gↄ̃̀ à kíblekii ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Isia Tɛ̃aa wɛ́ɛ sìńlɛ à bàa lɛ̀,","poem":1},{"lineBreak":true},{"text":"Yoda í kpɛɛ lì.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kpiiinↄ vĩ̀vĩ lán sãkaronↄ bà,","poem":1},{"lineBreak":true},{"text":"sĩ̀sĩnↄ kↄrↄ lɛ̀ lán sãnɛnↄ bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ísia, bↄ́ bé à n le n bàa lɛ̀?","poem":1},{"lineBreak":true},{"text":"Yoda, à kɛ̀ dia n kpɛɛ lì?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kpiiinↄ, bↄ́yãnzin a vĩvĩ lán sãkaronↄ bàzi?","poem":1},{"lineBreak":true},{"text":"Sĩ̀sĩnↄ, à kɛ̀ dia a kↄrↄ lɛ̀ lán sãnɛnↄ bà?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Anduna, ǹ lugaluga Dii aɛ,","poem":1},{"lineBreak":true},{"text":"Yakubu Luda aɛzĩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À gbɛ̀si kɛ̀ íkaɛkii ũ,","poem":1},{"lineBreak":true},{"text":"à gbɛ̀pukãa lì íbↄkii ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}