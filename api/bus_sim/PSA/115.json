{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":115,"content":[{"type":"heading","content":["Dii bé è aubarika dańgu"]},{"type":"verse","number":1,"content":[{"text":"Èe kɛ wámbeero Dii,","poem":1},{"lineBreak":true},{"text":"èe kɛ wámbeero,","poem":1},{"lineBreak":true},{"text":"ḿbe ń dɛ wà n tↄ́ bↄ","poem":1},{"lineBreak":true},{"text":"n gbɛ̃kɛ kↄ̃n n náanɛo yãnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"À kɛ̀ dia boriinↄ è wa la","poem":1},{"lineBreak":true},{"text":"wà be wa Ludaa kú mámɛ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wa Ludaa kú musu,","poem":1},{"lineBreak":true},{"text":"pↄ́ kɛ̀ à yezin è kɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aↄ̃ ń tãanↄ pì kↄ̃n kondogio kↄ̃n vurao,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ntee ↄzĩimɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aↄ̃ↄ lɛ́ vĩ, mↄde aↄ̃è yã oro,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ wɛ́ɛ vĩ, mↄde aↄ̃è guu ero.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aↄ̃ↄ swã vĩ, mↄde aↄ̃è yã maro,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ yĩ vĩ, mↄde aↄ̃è pↄ́ gũu maro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aↄ̃ↄ ↄↄ vĩ, mↄde aↄ̃è pↄ́ kũro,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ gbá vĩ, mↄde aↄ̃è táa oro,","poem":1},{"lineBreak":true},{"text":"aↄ̃è kòto kɛkɛro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aↄ̃ pìrinↄↄ sɛ̃nkpɛńyomɛ","poem":1},{"lineBreak":true},{"text":"kↄ̃n gbɛ̃ kɛ̀ aↄ̃ↄe ń náanɛ kɛɛnↄ ń píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Isarailinↄ, à Dii náanɛ kɛ!","poem":1},{"lineBreak":true},{"text":"Àmbe a dↄnlɛri ũ kↄ̃n a sɛngbangoo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aruna boriinↄ, à Dii náanɛ kɛ!","poem":1},{"lineBreak":true},{"text":"Àmbe a dↄnlɛri ũ kↄ̃n a sɛngbangoo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii vĩakɛrinↄ, à Dii náanɛ kɛ!","poem":1},{"lineBreak":true},{"text":"Àmbe a dↄnlɛri ũ kↄ̃n a sɛngbangoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dii dↄ̀ wa yãn,","poem":1},{"lineBreak":true},{"text":"eé aubarika dawagu.","poem":1},{"lineBreak":true},{"text":"Eé aubarika da Isaraili boriinↄn,","poem":1},{"lineBreak":true},{"text":"eé aubarika da Aruna boriinↄn,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"eé aubarika da a vĩakɛrinↄn,","poem":1},{"lineBreak":true},{"text":"nɛ́ féte gbɛ̃nsi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dii a bori kↄ̃are,","poem":1},{"lineBreak":true},{"text":"apinↄ kↄ̃n a nɛ́nↄ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dii aubarika daagu,","poem":1},{"lineBreak":true},{"text":"àmↄ kɛ̀ musu kↄ̃n tↄↄtɛo kɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Musu nɛ́ Dii pↄ́mɛ,","poem":1},{"lineBreak":true},{"text":"mↄde à tↄↄtɛ nà gbɛ̃nteenↄnɛ ń ↄzĩ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Èe kɛ gɛ̀nↄ bé wè Dii táaki lɛ́ro,","poem":1},{"lineBreak":true},{"text":"kesↄ̃ gbɛ̃ kɛ̀ aↄ̃ lɛ́ yĩtɛnↄ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wámbe, wégↄ̃ Dii sáabu kpaa","poem":1},{"lineBreak":true},{"text":"zaa tia ai gurↄ píngi.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}