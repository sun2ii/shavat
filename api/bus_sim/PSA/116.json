{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":116,"content":[{"type":"heading","content":["Gbɛ̃ kɛ̀ bↄ̀ gaa lɛ́zĩ Dii sáabukpana"]},{"type":"verse","number":1,"content":[{"text":"Má ye Diizi, zaakɛ à ma yã mà,","poem":1},{"lineBreak":true},{"text":"à ma wiipɛnaazii mà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɛ́gↄ̃ à sisii ai ma wɛ̃̀ndi lɛ́n,","poem":1},{"lineBreak":true},{"text":"kɛ̀ à swã kpàmazi yãnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ga bà fĩ̀kãmazi yã,","poem":1},{"lineBreak":true},{"text":"mira wãwãa tↄ̃̀ma,","poem":1},{"lineBreak":true},{"text":"wɛ́ɛtãmma kↄ̃n pↄsiaao dàmala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ben ma Dii sìsi ma bè:","poem":1},{"lineBreak":true},{"text":"Dii, n yã nna, ǹ ma mì sí.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii sùu vĩ bensↄ̃ à maa,","poem":1},{"lineBreak":true},{"text":"wa Ludaa wɛ̃nda vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii è gbãasaideenↄ dãkpa,","poem":1},{"lineBreak":true},{"text":"kɛ̀ ma busa, à ma mì sì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma swɛ̃̀, ǹ kɛkɛ ǹ kpáɛ,","poem":1},{"lineBreak":true},{"text":"zaakɛ Dii yã maaa kɛ̀nnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii, n ma bↄ gaa lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"n wɛ́ɛ'i gògomɛ, nɛ́ɛ tó ma gɛ̃̀n síro,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"lɛ màgↄ̃ tɛ́ n aɛ gbɛ̃ bɛ̃ɛnↄ kukiia kɛ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Baa kɛ̀ nawɛ̃a tↄ̃̀ma ma gↄ̃ búgubugu,","poem":1},{"lineBreak":true},{"text":"má kpɛ́ à náanɛ vĩ, ben ma yã ò.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma bídi kɛ̀ ma bè:","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ píngi nɛ́ ɛgɛdeenↄmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bↄ́n mɛ́ fĩa boo Diinɛ","poem":1},{"lineBreak":true},{"text":"à maaa kɛ̀ à kɛ̀mɛɛ musu píngii?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mɛ́ Dii mìsina togo sɛ́ musu,","poem":1},{"lineBreak":true},{"text":"mɛ́ à sísio.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mɛ́ lù kɛ̀ má sɛ̀ Diinɛnↄ papa","poem":1},{"lineBreak":true},{"text":"à gbɛ̃nↄ wáa ń píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dii yãmarinↄ gana bɛ̀ɛ vĩnɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dii, n yã nna, n zↄ̀blerin ma ũ,","poem":1},{"lineBreak":true},{"text":"nↄgbɛ̃ kɛ̀ à dↄ̀nzi nɛ́n ma ũ,","poem":1},{"lineBreak":true},{"text":"n ma bↄ bàn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mɛ́ kɛnnakↄ̃o saa omma,","poem":1},{"lineBreak":true},{"text":"mɛ́ n sísio, Dii.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mɛ́ lù kɛ̀ má sɛ̀ Diinɛnↄ papa","poem":1},{"lineBreak":true},{"text":"à gbɛ̃nↄ wáa ń píngi","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"à kpɛ́ ua Yerusalɛmu guu.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}