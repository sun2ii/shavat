{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":118,"content":[{"type":"heading","content":["Gana Dii ua kↄ̃n sáabukɛnao"]},{"type":"verse","number":1,"content":[{"text":"À Dii sáabu kɛ, zaakɛ à maa,","poem":1},{"lineBreak":true},{"text":"à gbɛ̃kɛɛ yãana vĩro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Isarailinↄ o:","poem":1},{"lineBreak":true},{"text":"À gbɛ̃kɛɛ yãana vĩro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aruna boriinↄ o:","poem":1},{"lineBreak":true},{"text":"À gbɛ̃kɛɛ yãana vĩro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À vĩakɛrinↄ o:","poem":1},{"lineBreak":true},{"text":"À gbɛ̃kɛɛ yãana vĩro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma Dii sìsi ma nawɛ̃a guu,","poem":1},{"lineBreak":true},{"text":"ben à wèmala à ma gba mɛ̀porokii.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii kúmao, vĩa é ma kũro.","poem":1},{"lineBreak":true},{"text":"Bↄ́n gbɛ̃ntee é fↄ̃ à kɛmɛɛ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii kúmao ma dↄnlɛri ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ ma ibɛɛnↄ tí dↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"À maa wà na Diizi dɛ","poem":1},{"lineBreak":true},{"text":"gbɛ̃ntee náanɛkɛnala.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À maa wà na Diizi dɛ","poem":1},{"lineBreak":true},{"text":"gbãadeenↄ náanɛkɛnala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bori píngi lìgamazi,","poem":1},{"lineBreak":true},{"text":"ben ma ń kaatɛ kↄ̃n Dii tↄ́o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aↄ̃ lìgamazi kpa píngi,","poem":1},{"lineBreak":true},{"text":"ben ma ń kaatɛ kↄ̃n Dii tↄ́o.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aↄ̃ fĩ̀ma lán zↄ́nↄ bà,","poem":1},{"lineBreak":true},{"text":"ben aↄ̃ gàga lán kãɛ tɛ́ bà,","poem":1},{"lineBreak":true},{"text":"ma ń kaatɛ kↄ̃n Dii tↄ́o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Aↄ̃ ma yĩpa kpɛɛ, má yezi mà lɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"ben Dii dↄ̀malɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii bé ma gbãaa ũ, à táakin mɛɛ̀ lɛ́,","poem":1},{"lineBreak":true},{"text":"àmbe à gↄ̃̀ ma mìsiri ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"À ma, pↄnna wiii dↄ gbɛ̃ maaanↄ bùran,","poem":1},{"lineBreak":true},{"text":"Dii ↄplaa zĩ bíta kɛ̀.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dii ↄplaa kú musu,","poem":1},{"lineBreak":true},{"text":"Dii ↄplaa zĩ bíta kɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mɛ́ garo, mɛ́gↄ̃ kuu,","poem":1},{"lineBreak":true},{"text":"mɛ́gↄ̃ Dii yãkɛnanↄ tↄ̃kɛ̃ɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dii ma toto maamaa,","poem":1},{"lineBreak":true},{"text":"mↄde èe tó gaa ma sɛro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"À zɛ́ maaa gbànↄ wɛ̃mɛ,","poem":1},{"lineBreak":true},{"text":"lɛ mà gɛ̃ mà Dii sáabu kpá.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii ua zɛ́n yɛ̀,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ maaanↄ bé wè gɛ̃n.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ma n sáabu kɛ̀ Dii, zaakɛ n wemala,","poem":1},{"lineBreak":true},{"text":"n gↄ̃ ma mìsiri ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Gbɛ̀ kɛ̀ kpɛ́borinↄ pã kpàzi","poem":1},{"lineBreak":true},{"text":"bé à gↄ̃̀ kpɛ́ gooda gbɛ̀ mìdee ũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dii bé à beee kɛ̀,","poem":1},{"lineBreak":true},{"text":"ben à kɛ̀we yãbↄnsaɛ ũ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Gurↄↄ kɛ̀ Dii dìɛn yɛ̀,","poem":1},{"lineBreak":true},{"text":"wà pↄnnaa kɛn wà nↄ̀sɛ kɛ nna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"N yã nna Dii! Ǹ wa mì sí!","poem":1},{"lineBreak":true},{"text":"Ǹ sùu kɛ Dii! Ǹ wa dakↄ̃rɛ mìnnaao!","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Aubarikadeen gbɛ̃ kɛ̀ èe mↄↄ kↄ̃n Dii tↄ́o ũ,","poem":1},{"lineBreak":true},{"text":"zaa Dii ua wée gbãakɛ kpaanzi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Diin Luda ũ, à guu pùwe.","poem":1},{"lineBreak":true},{"text":"À zà lá kpákpa àgↄ̃ tɛ́o zĩbaakɛrinↄzi","poem":1},{"lineBreak":true},{"text":"ai sa'oki kobanↄ kiia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ma Ludan n ũ, mɛ́ n sáabu kɛ,","poem":1},{"lineBreak":true},{"text":"ma Luda, mɛ́ n tↄ́ sɛ́ lezĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"À Dii sáabu kɛ, zaakɛ à maa,","poem":1},{"lineBreak":true},{"text":"à gbɛ̃kɛɛ yãana vĩro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}