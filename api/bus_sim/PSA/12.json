{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":12,"content":[{"type":"heading","content":["Gbɛ̃ntee zaakɛɛ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀. Wè sí kↄ̃n mↄrↄlɛnaomɛ."]},{"type":"verse","number":1,"content":[{"text":"Ǹ ma mì sí, Dii,","poem":1},{"lineBreak":true},{"text":"zaakɛ gbɛ̃ maa kee kuu dↄro,","poem":1},{"lineBreak":true},{"text":"náanɛdee yã̀a gbɛ̃nteenↄ tɛ́.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Baade è ɛgɛɛ to a gbɛ̃daaanɛ,","poem":1},{"lineBreak":true},{"text":"è lɛ́nnaa kásańnɛ kↄ̃n nↄ̀sɛo plaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dii, ǹ lɛ́nnade lɛ́ kↄ̀ ɛ́","poem":1},{"lineBreak":true},{"text":"kↄ̃n gbɛ̃ kɛ̀ è a zĩnda sɛ́ lezĩo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aↄ̃è be ń lɛ́ bé eé tó wà zĩ̀ ble,","poem":1},{"lineBreak":true},{"text":"wà ń lɛ́ vĩ, dé bé eé kí bleḿmaa?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wɛ́ɛtãna gbɛ̃ busɛnↄa","poem":1},{"lineBreak":true},{"text":"kↄ̃n wɛ̃ndadeenↄ m̀bonao yãnzi","poem":1},{"lineBreak":true},{"text":"Dii bè é fɛɛ sa","poem":1},{"lineBreak":true},{"text":"à ń gba zɛ́bↄkii kɛ̀ aↄ̃ↄe à ni dɛɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii yã see vĩro,","poem":1},{"lineBreak":true},{"text":"à dɛ lán kondogi kɛ̀ wà yↄ̀ tɛ́vura guu","poem":1},{"lineBreak":true},{"text":"wà bàasa gɛ̃̀n swɛɛplaaa bà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mpi Dii, nɛ́gↄ̃ wa dãkpaa gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"nɛ́ wa sí gbɛ̃ beee takanↄa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃nↄ yã bɛ̃̀ɛ kũ̀ ↄplaplaa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ zaaanↄ ègↄ̃ lili oo kↄ̃n ĩadãnao gu píngia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}