{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":120,"content":[{"type":"heading","content":["Kuuna yãketedeenↄ tɛ́"]},{"type":"hebrew_subtitle","content":["Gana Yerusalɛmu lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Ma nawɛ̃akɛna guu ma Dii sìsi,","poem":1},{"lineBreak":true},{"text":"ben à wèmala.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ ma sí yãsiadeenↄ ↄzĩ","poem":1},{"lineBreak":true},{"text":"kↄ̃n mↄnafikideenↄ lɛ́o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mↄnafikide, Luda é kɛnyo dia nà?","poem":1},{"lineBreak":true},{"text":"Ke bↄ́n eé kɛnnɛɛ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Eé wɛ́ɛ tãmma kↄ̃n gↄ̃sagbãaa kà lɛ́ nnaanↄ","poem":1},{"lineBreak":true},{"text":"kↄ̃n sɛ̃ lí sĩsĩ wãaao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wãiyoo mamↄma kɛ̀ má kú Mɛsɛkinↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"má vɛ̃ɛ Kedanↄ bisakutaan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma vɛ̃ɛ à gì kɛ̀ maamaa","poem":1},{"lineBreak":true},{"text":"kↄ̃n gbɛ̃ kɛ̀ aↄ̃ zà aafiannↄ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Vɛ̃ɛna aafian má yezi,","poem":1},{"lineBreak":true},{"text":"mↄde tó ma yã ò, swèen aↄ̃è fɛɛomazi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}