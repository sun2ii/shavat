,{"type":"verse","number":6,"content":[{"text":"À aafia wɛ́ɛ kɛ Yerusalɛmunɛ à be:","poem":1},{"lineBreak":true},{"text":"Luda tó gbɛ̃ kɛ̀ aↄ̃ↄ yenziinↄ aubarika e!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aafia gↄ̃ kú n bĩinↄ dagura,","poem":1},{"lineBreak":true},{"text":"n gudãkpakiinↄ gↄ̃ kaɛna nna.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃nↄ kↄ̃n ma gbɛ̃nnanↄ yãnzi mɛ́ be,","poem":1},{"lineBreak":true},{"text":"Luda n gba aafia.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii wa Luda kpɛ́ yãnzi","poem":1},{"lineBreak":true},{"text":"mɛ́ à maaa wɛ́ɛ kɛnnɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}