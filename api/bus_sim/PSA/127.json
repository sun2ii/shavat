{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":127,"content":[{"type":"heading","content":["Pↄ́ píngi nɛ́ ludangbaamɛ"]},{"type":"hebrew_subtitle","content":["Gana Yerusalɛmu lɛ̀ kɛ̀ Sulemanu dà."]},{"type":"verse","number":1,"content":[{"text":"Tó èe kɛ Dii bé à kpɛ́ bòro,","poem":1},{"lineBreak":true},{"text":"ɛ̃ndɛ̃ à bòrinↄↄ e zĩ pãa kɛɛmɛ.","poem":1},{"lineBreak":true},{"text":"Tó èe kɛ Dii bé à wɛ́tɛ dã̀kparo,","poem":1},{"lineBreak":true},{"text":"ɛ̃ndɛ̃ à dãkparinↄↄ e itɛ̃ kɛɛ pãmɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fɛɛna idɛ'idɛ, daɛna lezãndo,","poem":1},{"lineBreak":true},{"text":"zĩbãabãakɛna pↄ́blee yãnzi nɛ́ yã pãamɛ,","poem":1},{"lineBreak":true},{"text":"zaakɛ Dii è a gbɛ̃ yenzideenↄ gba kámmabona.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nɛ́gↄ̃gbɛ̃nↄ nɛ́ Dii gbaamɛ,","poem":1},{"lineBreak":true},{"text":"nɛ́nↄ nɛ́ à láadamɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lán kànↄↄ dɛ nà zĩ̀kari ↄzĩ,","poem":1},{"lineBreak":true},{"text":"lɛn n gↄ̃kparɛkɛgurↄ nɛ́gↄ̃gbɛ̃nↄↄ dɛ lɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aubarikadeen gbɛ̃ kɛ̀ à gbàra panańyo ũ,","poem":1},{"lineBreak":true},{"text":"tó à ibɛɛnↄ à lè gãalɛ, wí é à kũro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}