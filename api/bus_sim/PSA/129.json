","number":6,"content":[{"lineBreak":true},{"text":"Aↄ̃gↄ̃ dɛ lán sɛ̃̀ kɛ̀ bↄ̀ɛ kpɛ́ musu bà,","poem":1},{"lineBreak":true},{"text":"ai àgↄ̃ gbã à gàga.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Eé sɛ̃̀kɛ̃ri ↄkũ paro,","poem":1},{"lineBreak":true},{"text":"eé bakaa kɛ à sí yi wà da gã̀nlo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃ↄe gɛ̃tɛɛnↄ tón be,","poem":1},{"lineBreak":true},{"text":"Dii aubarika dańguro,","poem":1},{"lineBreak":true},{"text":"ke wà aubarika dańgu kↄ̃n Dii tↄ́o.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}