","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mɛ́ɛ n gbɛ̃kɛ náanɛ kɛɛ,","poem":1},{"lineBreak":true},{"text":"ma pↄↄ kɛ̀ nna kɛ̀ n ma mì sì.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɛ́ lɛ̀ sí Diinɛ,","poem":1},{"lineBreak":true},{"text":"zaakɛ à yã maaa kɛ̀mɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}