{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":130,"content":[{"type":"heading","content":["Wɛ́ɛdↄna Diizi"]},{"type":"hebrew_subtitle","content":["Gana Yerusalɛmu lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Zaa í lↄ̀n ma wii pɛ̀ Diizi ma bè,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii, ǹ ma yã ma,","poem":1},{"lineBreak":true},{"text":"ǹ swã kpá ma wiipɛnazi ǹ ma wɛ́ɛ gwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii, tó nɛɛ̀ wa durunnↄ kɛ̃ ǹ diɛmɛ,","poem":1},{"lineBreak":true},{"text":"Dii, dé bé eé bↄↄ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ḿbe ń durunkɛ̃nnɛna zɛ́ vĩ,","poem":1},{"lineBreak":true},{"text":"beee yãnzin wè vĩa kɛnnɛzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma wɛ́ɛ ègↄ̃ dↄ Diizi, mɛ́ɛ à dãa,","poem":1},{"lineBreak":true},{"text":"à yãn má sↄ̃kpazi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lán gudãkparinↄ wɛ́ɛ ègↄ̃ dↄ gudↄnazi nà,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ɛ ègↄ̃ dↄ Diizi dɛńla,","poem":1},{"lineBreak":true},{"text":"ee, à dɛ gudãkparinↄ wɛ́ɛdↄna gudↄnazila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A Isarailinↄ, à wɛ́ɛ dↄ Diizi,","poem":1},{"lineBreak":true},{"text":"zaakɛ Dii gbɛ̃kɛɛ vĩ,","poem":1},{"lineBreak":true},{"text":"à mìsina gbãaa vĩ papana.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Àmbe eé Isarailinↄ bo","poem":1},{"lineBreak":true},{"text":"aↄ̃ durunnↄ guu píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}