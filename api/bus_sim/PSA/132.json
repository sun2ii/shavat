{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":132,"content":[{"type":"heading","content":["Dauda boriinↄↄ vɛ̃ɛna kpatan Zayↄn"]},{"type":"hebrew_subtitle","content":["Gana Yerusalɛmu lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii, ǹ tó Dauda yã gↄ̃ dↄngu","poem":1},{"lineBreak":true},{"text":"kↄ̃n nawɛ̃a kɛ̀ à kɛ̀nↄ píngi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À la dà Diinɛ,","poem":1},{"lineBreak":true},{"text":"à lù sɛ̀ Yakubu Luda gbãadeenɛ à bè,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"é gɛ̃ kpɛ́nlo,","poem":1},{"lineBreak":true},{"text":"é daɛ a gádoaro,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"é we à igoba páro,","poem":1},{"lineBreak":true},{"text":"é tó ii na a wɛ́ɛnlo,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ai à gá guu eo Diinɛ","poem":1},{"lineBreak":true},{"text":"à kpɛ́ dↄ Yakubu Luda gbãadeenɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wa à baaru mà Ɛflata bùsun,","poem":1},{"lineBreak":true},{"text":"wa bↄa Yarimu bura.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Wà gá à kúkiia,","poem":1},{"lineBreak":true},{"text":"wà kúɛ à tinti aɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii, ǹ fɛɛ ǹ su n pitakiia,","poem":1},{"lineBreak":true},{"text":"mpi kↄ̃n n ikokɛ àkpatio.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N gbã̀gbãrinↄ maakɛɛ da uta ũ,","poem":1},{"lineBreak":true},{"text":"n yãmarinↄ guda gↄ̃ dↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹton mìkpɛɛ zu kína kɛ̀ ń kànɛro","poem":1},{"lineBreak":true},{"text":"n zↄ̀bleri Dauda yãnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dii sì kↄ̃n a kuunao Daudanɛ,","poem":1},{"lineBreak":true},{"text":"à náanɛ vĩ, eé lɛ́ liɛro, à bè:","poem":1},{"lineBreak":true},{"text":"Mɛ́ n boriinↄ doke ká n kpatan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó n boriinↄ ma bà kuunańyo yã dà,","poem":1},{"lineBreak":true},{"text":"tó aↄ̃ yã kɛ̀ má dàńnɛnↄ kũna,","poem":1},{"lineBreak":true},{"text":"aↄ̃ boriinↄ égↄ̃ vɛ̃ɛ n kpatan gurↄ píngi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zaakɛ Dii Zayↄn sɛ̀,","poem":1},{"lineBreak":true},{"text":"à yezi àgↄ̃ dɛ a vɛ̃ɛkii ũ, à bè:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Guu kɛ̀n mɛ́gↄ̃ kún gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"gura kɛ̀n mɛ́gↄ̃ vɛ̃ɛnan, zaakɛ à ma pↄↄ gbàmɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mɛ́ aubarika dan maamaa,","poem":1},{"lineBreak":true},{"text":"mɛ́ pↄ́blee kpá à takaasideenↄa à mↄ́ḿma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mɛ́ mìsina da à sa'orinↄnɛ uta ũ,","poem":1},{"lineBreak":true},{"text":"ma yãmarinↄ guda égↄ̃ dↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Gwen mɛ́ Dauda bori kína gbãadee bↄn,","poem":1},{"lineBreak":true},{"text":"gwen kína kɛ̀ má kà tɛ́ égↄ̃ dↄn.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mɛ́ wí da à ibɛɛnↄa,","poem":1},{"lineBreak":true},{"text":"à kífura égↄ̃ tɛ́ kɛɛ à mìa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}