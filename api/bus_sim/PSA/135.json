{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":135,"content":[{"type":"heading","content":["Dii táakilɛna"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"À Dii tↄ́ bↄ!","poem":1},{"lineBreak":true},{"text":"À Dii sáabu kpá, amↄa à zĩkɛrinↄ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amↄa kɛ̀ eè zĩi kɛ wa Dii bɛnↄ,","poem":1},{"lineBreak":true},{"text":"a gbɛ̃ kɛ̀ eègↄ̃ zɛna wa Luda uanↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"À Dii tↄ́ bↄ, zaakɛ à maa,","poem":1},{"lineBreak":true},{"text":"à à táaki lɛ́, zaakɛ beee bé à nna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii Yakubu boriinↄ sɛ̀ a pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"à Isarailinↄ dìɛ a gbɛ̃ yenzideenↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Má dↄ̃ kɛ̀ Dii bíta,","poem":1},{"lineBreak":true},{"text":"wa Luda bé à dɛ tãanↄla ń píngi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii è yã kɛ̀ à yezi kɛ","poem":1},{"lineBreak":true},{"text":"musu kↄ̃n tↄↄtɛo,","poem":1},{"lineBreak":true},{"text":"ísiaanↄ guu kↄ̃n a lↄ̀nↄo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"È tó lou sisi ai anduna lɛ́zɛkiia,","poem":1},{"lineBreak":true},{"text":"è tó lou ma kↄ̃n à pinao,","poem":1},{"lineBreak":true},{"text":"è bↄ kↄ̃n zàga'ĩao a pↄ́kaɛkiin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À Igipiti daudunↄ dɛ̀dɛ","poem":1},{"lineBreak":true},{"text":"kↄ̃n pↄ́kãde nɛ́ káakunↄ píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"À sèedanↄ kↄ̃n dabuyãnↄ kɛ̀ Igipiti,","poem":1},{"lineBreak":true},{"text":"à wɛ́ɛ tã̀ Fili'aunaa kↄ̃n a ìbanↄ ń píngi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À boriinↄ kàatɛ pari,","poem":1},{"lineBreak":true},{"text":"à kína gbãadeenↄ dɛ̀dɛ,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Amↄrinↄ kí Siↄ̃","poem":1},{"lineBreak":true},{"text":"kↄ̃n Basã kí Oguo","poem":1},{"lineBreak":true},{"text":"kↄ̃n Kanaa bùsu kínanↄ ń píngi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À ń bùsu sì à kpà","poem":1},{"lineBreak":true},{"text":"a gbɛ̃ Isarailinↄa túbi ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dii, n tↄ́ ègↄ kuu gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"Dii, n yã égↄ̃ dↄ gbɛ̃nↄn ai wa boriia.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zaakɛ Dii é tó a gbɛ̃nↄ bↄ maa,","poem":1},{"lineBreak":true},{"text":"eé a zↄ̀blerinↄ wɛ̃nda gwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Boriinↄ ń tãanↄ pì kↄ̃n kondogio kↄ̃n vurao,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ntee ↄzĩinↄmɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Aↄ̃ lɛ́ vĩ, mↄde aↄ̃è yã oro,","poem":1},{"lineBreak":true},{"text":"aↄ̃ wɛ́ɛ vĩ, mↄde aↄ̃è guu ero,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"aↄ̃ swã vĩ, mↄde aↄ̃è yã maro,","poem":1},{"lineBreak":true},{"text":"aↄ̃è wesaa boro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Aↄ̃ pìrinↄↄ sɛ̃nkpɛńyomɛ","poem":1},{"lineBreak":true},{"text":"kↄ̃n gbɛ̃ kɛ̀ aↄ̃ↄ tɛ́ńzinↄ ń píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Isarailinↄ, à Dii sáabu kpá!","poem":1},{"lineBreak":true},{"text":"Aruna boriinↄ, à Dii sáabu kpá!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Levi boriinↄ, à Dii sáabu kpá!","poem":1},{"lineBreak":true},{"text":"Dii vĩakɛrinↄ, à Dii sáabu kpá!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aubarikadeen Dii ũ zaa Zayↄn,","poem":1},{"lineBreak":true},{"text":"àmↄ kɛ̀ kú Yerusalɛmu.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}