{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":137,"content":[{"type":"heading","content":["Zĩ̀zↄnↄ wiipɛna"]},{"type":"verse","number":1,"content":[{"text":"Kɛ̀ wa vɛ̃ɛ Babilↄnu swaanↄ saɛ,","poem":1},{"lineBreak":true},{"text":"Zayↄn yã dↄ̀wagu, ben wa ↄ́ↄ dↄ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wa wa mↄrↄnↄ tò logona swagbara línↄa gwe.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gwen gbɛ̃ kɛ̀ aↄ̃ↄ wa kũnanↄ bè wà lɛ̀ síńnɛ,","poem":1},{"lineBreak":true},{"text":"wa wɛ́ɛtãmmarinↄↄ yezi wà kↄ̃kↄ̃ ońnɛ,","poem":1},{"lineBreak":true},{"text":"wà Zayↄn lɛ̀nↄ doke síńnɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dian wé Dii lɛ̀nↄ sí nà","poem":1},{"lineBreak":true},{"text":"bori pãndenↄ bùsu guuu?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó n yã sã̀magu Yerusalɛmu,","poem":1},{"lineBreak":true},{"text":"ma ↄplaa ga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó Yerusalɛmu yã e dↄmaguro,","poem":1},{"lineBreak":true},{"text":"tó mɛ́ɛ à diɛ ma pↄnnakɛna mì ũro,","poem":1},{"lineBreak":true},{"text":"ma nɛ́nɛ naɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dii, ǹ dↄ yã kɛ̀ Ɛdↄmunↄↄ kɛ̀n","poem":1},{"lineBreak":true},{"text":"zĩ kɛ̀ wà yã mↄ̀ Yerusalɛmunɛ","poem":1},{"lineBreak":true},{"text":"aↄ̃ bè: À gbɛ̃ à daɛ,","poem":1},{"lineBreak":true},{"text":"à gbɛ̃ à daɛ mámman.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Babilↄnudeenↄ nɛ́ pↄ́ kaatɛnanↄmɛ!","poem":1},{"lineBreak":true},{"text":"Aubarikadeen gbɛ̃ kɛ̀ eé yã kɛ̀ á kɛ̀wee fĩa boaree ũ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kɛ̀ eé a nɛ́nↄ kũkũ à ń pá gbɛ̀a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}