{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":138,"content":[{"type":"heading","content":["Dii sáabukpana à gbɛ̃kɛ yãnzi"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Mɛ́ n sáabu kpá kↄ̃n nↄ̀sɛo do,","poem":1},{"lineBreak":true},{"text":"mɛ́ n táaki lɛ́ gbãadeenↄ aɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɛ́ kúɛ mà aɛ dↄ","poem":1},{"lineBreak":true},{"text":"n kpɛ́ kɛ̀ kú adona kpa,","poem":1},{"lineBreak":true},{"text":"mɛ́ n tↄ́ bↄ n gbɛ̃kɛ kↄ̃n n náanɛo yãnzi,","poem":1},{"lineBreak":true},{"text":"zaakɛ n n tↄ́ kↄ̃n n yão sɛ̀ lei dɛ pↄ́ píngila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kɛ̀ ma n sisi, n wemala,","poem":1},{"lineBreak":true},{"text":"ǹ ma kù kɛ gbãaa, ǹ ma swɛ̃̀ kpáɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tó anduna kínanↄ yã kɛ̀ ń ò mà,","poem":1},{"lineBreak":true},{"text":"aↄ̃ n sáabu kpá ń píngi, Dii.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aↄ̃ lɛ̀ sí Dii yãkɛnanↄ musu,","poem":1},{"lineBreak":true},{"text":"zaakɛ Dii gakui bíta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Baa kↄ̃n Dii kuunamusukɛɛo,","poem":1},{"lineBreak":true},{"text":"è gbɛ̃ kɛ̃sãnanↄ wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"è wɛ́ɛ pã gbɛ̃ kɛ̀ aↄ̃ↄe daa wà kànↄla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Baa tó wɛ́ɛtãmma lìgamazi,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ ma wɛ̃̀ndi dãkpa,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ ma ibɛɛnↄ pↄfɛ̃ kpáɛ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ ma mì sí kↄ̃n n gã̀sã gbãaao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii é yã kɛ̀ à ò papamɛ.","poem":1},{"lineBreak":true},{"text":"Dii, n gbɛ̃kɛɛ yãana vĩro,","poem":1},{"lineBreak":true},{"text":"ǹton mamↄma kɛ̀ n ma kɛɛ tóro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}