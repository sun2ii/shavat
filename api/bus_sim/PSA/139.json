{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":139,"content":[{"type":"heading","content":["Dii yã sãnda píngi dↄ̃"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii, n ma yã gwàgwa ń dↄ̃̀,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ń ma vɛ̃ɛna kↄ̃n ma fɛɛnao dↄ̃,","poem":1},{"lineBreak":true},{"text":"zaa zã̀azã ń ma laasuunↄ dↄ̃.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ ma táa'ona kↄ̃n ma daɛnao tàasi kɛ,","poem":1},{"lineBreak":true},{"text":"n kↄ̃ dↄ̃̀ kↄ̃n ma yãnↄ píngi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lɛ yã kpɛ́ à bↄ ma lɛ́n,","poem":1},{"lineBreak":true},{"text":"Dii, ń dↄ̃ sãnsãn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ń ligamazi kpɛɛ kↄ̃n aɛo,","poem":1},{"lineBreak":true},{"text":"n ↄↄ kúmala.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dↄ̃na beee dɛmɛ dabuyã ũmɛ,","poem":1},{"lineBreak":true},{"text":"à dɛmala, ma ↄ̃ndↄ̃ↄ e káaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mán mɛ́ gán mà kɛ̃ n Niniia?","poem":1},{"lineBreak":true},{"text":"Mán mɛ́ bàa sí mà gán mà koranzii?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tó ma fɛɛ ma gaa musu, ń kú gwe!","poem":1},{"lineBreak":true},{"text":"Tó ma daɛkii kɛ̀ gɛ̀wãan, ńyɛ gwa!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tó ma fɛɛ ma gaa ↄfãntɛ̃bↄɛ kpa,","poem":1},{"lineBreak":true},{"text":"tó ma gaa vɛ̃ɛ ísia baa ↄfãntɛ̃gɛ̃kpɛn kpa,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"baa gwemɛ má na n ↄzĩ,","poem":1},{"lineBreak":true},{"text":"nɛ́gↄ̃ ma kũna n ↄplaao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tó ma bè gusiaa damala,","poem":1},{"lineBreak":true},{"text":"ke gupuraa kɛ̀ ligamazii li gwãavĩ ũ,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"guu ègↄ̃ siannɛro,","poem":1},{"lineBreak":true},{"text":"gwãavĩ ègↄ̃ dɛnnɛ lán fãantɛ̃ bàmɛ,","poem":1},{"lineBreak":true},{"text":"gupura kↄ̃n gusiaao ègↄ̃ sɛ̃nkpɛnnɛmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ḿbe n ma guu kɛ̀,","poem":1},{"lineBreak":true},{"text":"n ma í kàsa ma da gbɛɛɛn.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ma sáabu kɛ̀ kɛ̀nnɛ ma kɛna naasi vĩ","poem":1},{"lineBreak":true},{"text":"bensↄ̃ à yãbↄnsaɛ vĩ.","poem":1},{"lineBreak":true},{"text":"N yãkɛnanↄ è bↄ ń saɛ,","poem":1},{"lineBreak":true},{"text":"má dↄ̃ sãnsãn ma nↄ̀sɛn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gurↄↄ kɛ̀ n ma í kàsa nɛ́'isↄ guu,","poem":1},{"lineBreak":true},{"text":"ma wá kee utɛnannɛro.","poem":1},{"lineBreak":true},{"text":"Kɛ̀ ma mɛ̀ e lii asii guu gwe,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"n wɛ́ɛ sì ma nɛ́gberelɛ.","poem":1},{"lineBreak":true},{"text":"Lán n ma gurↄↄ dìɛ nà píngi,","poem":1},{"lineBreak":true},{"text":"à lɛ́ kú n takadan","poem":1},{"lineBreak":true},{"text":"zaalɛ à kee e naaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Luda, n laasuu bɛ̀ɛ vĩmɛ maamaa,","poem":1},{"lineBreak":true},{"text":"à lɛ́ vĩro fá!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó má yezi mà naro,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ pari dɛ bùsu'ãatɛ̃la.","poem":1},{"lineBreak":true},{"text":"tó ma vu,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀gↄ̃ kúnyo ai tia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Luda, tó nɛ́ gbɛ̃ zaaanↄ dɛdɛ dé?","poem":1},{"lineBreak":true},{"text":"À gumala a gbɛ̃dɛrinↄ!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N ibɛɛnↄ è n yã o kↄ̃n nↄ̀sɛ zaaao,","poem":1},{"lineBreak":true},{"text":"n tↄ́ bɛ̀ɛ vĩ n lɛ́nlo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Dii, mɛɛ̀ za gbɛ̃ kɛ̀ aↄ̃ zanguunↄnloo?","poem":1},{"lineBreak":true},{"text":"Mɛɛ̀ gí gbɛ̃ kɛ̀ aↄ̃ fɛ̀ɛnzinↄ kãzi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Má yãke vĩńnɛro, se zangu,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ ń diɛ ma ibɛɛnↄ ũmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Luda, ǹ ma gwagwa ǹ ma nↄ̀sɛ dↄ̃,","poem":1},{"lineBreak":true},{"text":"ǹ ma yↄ̃ ǹ ma gwa ǹ ma laasuu dↄ̃.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ǹ gwa tó má laasuu zaa ke vĩ,","poem":1},{"lineBreak":true},{"text":"ǹ ma da zɛ́ kɛ̀ ègↄ̃ kuu gurↄ píngia guu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}