{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":140,"content":[{"type":"heading","content":["Aduakɛna gbɛ̃ zaaanↄ musu"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii, ǹ ma sí gbɛ̃ zaaanↄa,","poem":1},{"lineBreak":true},{"text":"ǹ ma dãkpa gbɛ̃ pãsĩnↄ yãnzi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aↄ̃è yã zaaa laasuu lɛ́ ń swɛ̃̀ guu,","poem":1},{"lineBreak":true},{"text":"swèen aↄ̃ègↄ̃ wɛtɛɛ gurↄ píngi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aↄ̃è ń lɛ́ kɛkɛ lán mlɛ̃̀ bà,","poem":1},{"lineBreak":true},{"text":"aↄ̃ lɛ́gbɛ nɛ́ pitigoo sɛwɛɛmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dii, ǹton tó gbɛ̃ zaaanↄ ↄ namaro,","poem":1},{"lineBreak":true},{"text":"ǹ ma sí gbɛ̃ pãsĩnↄa,","poem":1},{"lineBreak":true},{"text":"aↄ̃è lɛ́ kpakↄ̃sↄ̃ lɛ wà ma pãɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wadadeenↄ wɛ̀ɛ yↄ̃̀mɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ takutɛɛ kpàkpamɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ bà kpàmɛ zɛ́n.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dii, ma bènnɛ: Ma Ludan n ũ,","poem":1},{"lineBreak":true},{"text":"ǹ swã kpá ma wɛ̃nda wiiizi, Dii.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii Luda, ma mìsiri gbãaa,","poem":1},{"lineBreak":true},{"text":"mmↄn kɛ̀ nɛɛ̀ ↄ kúmala zĩ̀lan,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ǹton tó gbɛ̃ zaaanↄ ń pↄyezi zɛ́ ero,","poem":1},{"lineBreak":true},{"text":"Dii, ǹton tó aↄ̃ lɛ́kpakↄ̃sↄ̃na kↄ̃ sɛ́ro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gbɛ̃ kɛ̀ aↄ̃ↄ ligamaziinↄ,","poem":1},{"lineBreak":true},{"text":"yã zaaa kɛ̀ aↄ̃ↄe ma kpákpaao wí ń musu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tɛ́yↄ̃ wãaa kúḿma, wà ń zu tɛ́n,","poem":1},{"lineBreak":true},{"text":"aↄ̃ si wɛ̀ɛ kɛ̀ aↄ̃é bↄnloo guu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹton tó gbɛ̃yakarinↄ zɛkii e anduna guuro,","poem":1},{"lineBreak":true},{"text":"ǹ tó kisira gↄ̃ gbɛ̃ pãsĩnↄ wɛɛ zɛna sai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Má dↄ̃ kɛ̀ Dii è yã nnaa kpá wɛ̃ndadeenↄa,","poem":1},{"lineBreak":true},{"text":"è yã kɛkɛ takaasideenↄnɛ a zɛ́a.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yãpura, gbɛ̃ maaanↄ é n tↄ́ bↄ,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuradeenↄ égↄ̃ kú n aɛzĩ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}