{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":141,"content":[{"type":"heading","content":["Mìsina aduakɛna"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii, mɛ́ɛ wii pɛɛnzi, ǹ kɛ kpakpaa,","poem":1},{"lineBreak":true},{"text":"tó ma n sisi, ǹ swã kpá ma yãzi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ tó ma aduakɛna ká n kiia","poem":1},{"lineBreak":true},{"text":"lán tuaetiti tɛ́sukpɛ bà.","poem":1},{"lineBreak":true},{"text":"Ǹ tó ma ↄ dↄna musu gↄ̃ dɛnnɛ","poem":1},{"lineBreak":true},{"text":"sa uusiɛ ona ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dii, ǹ lɛ́sↄ damɛ ma lɛ́nɛ,","poem":1},{"lineBreak":true},{"text":"ǹ tó mà a lɛ́ fↄ̃.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ǹton tó yã zaaa ma swɛ̃̀ gáɛro,","poem":1},{"lineBreak":true},{"text":"lɛ màton kakↄ̃a kↄ̃n zaakɛrinↄ","poem":1},{"lineBreak":true},{"text":"ń yãzaakɛna guuro,","poem":1},{"lineBreak":true},{"text":"lɛ màton ń pↄ́ nnaanↄ bleńyoro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃ maaa ma lɛ, à gbɛ̃kɛɛ kɛ̀mɛmɛ!","poem":1},{"lineBreak":true},{"text":"Tó à kpã̀kɛ̃mazi, mɛ́ gíziro,","poem":1},{"lineBreak":true},{"text":"nↄ́si kↄ̃n a kpɛ̃̀omɛ.","poem":1},{"lineBreak":true},{"text":"Mɛɛ̀gↄ̃ adua kɛɛ baabↄrɛ","poem":1},{"lineBreak":true},{"text":"lɛ gbɛ̃ zaaanↄ yãkɛna gboro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó wà ń gbãadeenↄ kà sĩ̀sĩgoo wɛ̀ɛn,","poem":1},{"lineBreak":true},{"text":"zaakɛrinↄ é sí kɛ̀ ma yã bé à nna.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lán wè yàka para à bùu fãakↄ̃a nà,","poem":1},{"lineBreak":true},{"text":"lɛn aↄ̃ wá égↄ̃ fãakↄ̃ana ń mirawɛɛ lɛ́a lɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii Luda, ḿbe ma wɛ́ɛ dↄnzi,","poem":1},{"lineBreak":true},{"text":"ma nanzi, ǹton ma kpá gaaziro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ ma bↄ takutɛɛ kɛ̀ wà kpàkpamɛɛnↄn,","poem":1},{"lineBreak":true},{"text":"bà kɛ̀ zaakɛrinↄↄ kpàkpamɛɛ pìnↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹ tó gbɛ̃ zaaanↄ si ń zĩnda bà guu,","poem":1},{"lineBreak":true},{"text":"mapi sↄ̃ mɛ́ gɛ̃tɛ aafia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}