{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":142,"content":[{"type":"heading","content":["Aduakɛna gbɛ̀wɛɛn"]},{"type":"hebrew_subtitle","content":["Dauda aduakɛna gurↄↄ kɛ̀ à kú gbɛ̀wɛɛn."]},{"type":"verse","number":1,"content":[{"text":"Mɛ́ɛ ↄ́ gbãaa dↄↄ Diinɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ wɛ̃nda wii pɛɛ Diizi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɛ́ɛ ma yã'ↄ̃amma bↄɛɛnɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ ma nawɛ̃akɛna tↄ̃kɛ̃ɛnɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tó ma nↄ̀sɛ yàka búgubugu,","poem":1},{"lineBreak":true},{"text":"ḿbe nɛɛ̀gↄ̃ ma tá kɛ̀sɛ dↄ̃.","poem":1},{"lineBreak":true},{"text":"Wà takutɛɛ kpàkpamɛ ma zɛ́n.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ǹ wɛ́ɛ sɛ́ ǹ ma ↄplaa gwa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ke è ma yã daro.","poem":1},{"lineBreak":true},{"text":"Má nakii vĩ dↄro,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ke è ma aafia gbekaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii, mɛ́ɛ wii pɛɛnzi ma bè:","poem":1},{"lineBreak":true},{"text":"Ḿbe ma utɛkii ũ,","poem":1},{"lineBreak":true},{"text":"ḿbe ma baka ũ andunan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹ swã kpá ma wiipɛnazi,","poem":1},{"lineBreak":true},{"text":"zaakɛ ma gↄ̃ múkumukumɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ ma sí gbɛ̃ kɛ̀ aↄ̃ↄe pɛɛɛmaziinↄa,","poem":1},{"lineBreak":true},{"text":"zaakɛ aↄ̃ gbãaa dɛmala.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ ma bↄ kagurakɛna kɛ̀kiin,","poem":1},{"lineBreak":true},{"text":"lɛ mà n tↄ́ bↄ,","poem":1},{"lineBreak":true},{"text":"gbasa gbɛ̃ maaanↄ ligamazi","poem":1},{"lineBreak":true},{"text":"kɛ̀ n yã maaa kɛ̀mɛ yãnzi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}