"text":"Yã ziziinↄ dↄ̀magu,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ laasuu lɛ́ n zĩkɛnanↄa,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ n yãkɛnanↄ wàari pá.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma a ↄↄ dↄnzi,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ n ni dɛɛ lán gukori è í ni dɛ nà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ wemala kpakpaa Dii,","poem":1},{"lineBreak":true},{"text":"ma yɛ̃̀ɛ vĩ dↄro.","poem":1},{"lineBreak":true},{"text":"Ǹton mìkpɛɛ zumɛro,","poem":1},{"lineBreak":true},{"text":"lɛ màton gↄ̃ lán gbɛ̃ kɛ̀ aↄ̃ sì gɛ̀wãannↄ bàro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ n gbɛ̃kɛɛ ↄdↄamɛ kↄngↄ,","poem":1},{"lineBreak":true},{"text":"zaakɛ ḿbe má n náanɛ vĩ.","poem":1},{"lineBreak":true},{"text":"Ǹ ma da zɛ́ kɛ̀ dɛ mà sɛ́a,","poem":1},{"lineBreak":true},{"text":"zaakɛ ḿbe ma swɛ̃̀ tà n kiia.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ ma sí ma ibɛɛnↄa, Dii,","poem":1},{"lineBreak":true},{"text":"ḿbe ma nanzi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ḿbe ma Luda ũ,","poem":1},{"lineBreak":true},{"text":"ǹ n pↄyeziyã damɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ tó n Nini maaa dↄmɛ aɛ gusararaan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹ ma wɛ̃̀ndi dãkpa n tↄ́ yãnzi, Dii,","poem":1},{"lineBreak":true},{"text":"ǹ ma bↄ yã'ↄ̃amma guu n maaa yãnzi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹ ma ibɛɛnↄ kaatɛ n gbɛ̃kɛɛ yãnzi,","poem":1},{"lineBreak":true},{"text":"ǹ ma zangurinↄ dɛdɛ ń píngi,","poem":1},{"lineBreak":true},{"text":"zaakɛ n zↄ̀blerin ma ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}