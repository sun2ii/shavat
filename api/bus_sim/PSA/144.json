bàmɛ,","poem":1},{"lineBreak":true},{"text":"à wɛ̃̀ndi è gɛ̃tɛ lán ↄra bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii, ǹ musu naɛ ǹ pita,","poem":1},{"lineBreak":true},{"text":"ǹ ↄ kɛ kpiiinↄa lɛ aↄ̃ tɛ́sukpɛ bↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹ tó lou pí ǹ gbɛ̃nↄ fãakↄ̃a,","poem":1},{"lineBreak":true},{"text":"ǹ kà fã ń tɛ́ aↄ̃ lɛkↄ̃a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ ↄ bↄ zaa musu ǹ ma kũ,","poem":1},{"lineBreak":true},{"text":"ǹ ma bↄ í bíta guu,","poem":1},{"lineBreak":true},{"text":"ǹ ma sí bori zĩ̀tↄnↄa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ɛgɛtona ń lɛ́ pà,","poem":1},{"lineBreak":true},{"text":"aↄ̃è ↄ pãɛ kↄ̃n lùsɛna pãao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Luda, mɛ́ lɛ̀ dufu sínnɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ n táaki lɛ́ kↄ̃n mↄrↄ bà mɛ̀n kurideeo,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"mmↄn kɛ̀ nɛɛ̀ tó kínanↄ zĩ̀ ble,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ n zↄ̀bleri Dauda bↄ fɛ̃ɛda pãsĩ lɛ́zĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ǹ ma sí ǹ ma bↄ bori zĩ̀tↄnↄ ↄzĩ,","poem":1},{"lineBreak":true},{"text":"ɛgɛtona ń lɛ́ pà,","poem":1},{"lineBreak":true},{"text":"aↄ̃è ↄ pãɛ kↄ̃n lùsɛna pãao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wa nɛ́gↄ̃gbɛ̃nↄ é fɛɛ ń gↄ̃kparɛkɛgurↄ","poem":1},{"lineBreak":true},{"text":"lán lí kɛ̀ nnaa mà bà,","poem":1},{"lineBreak":true},{"text":"wa nɛ́nↄgbɛ̃nↄ gↄ̃ dɛ","poem":1},{"lineBreak":true},{"text":"lán kíbɛ wesagba kɛ̀ wà zãa blèa bà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wa dↄ̃̀nↄ é pa kↄ̃n pↄ́ bori sãnda píngio.","poem":1},{"lineBreak":true},{"text":"Wa sãanↄ é kↄ̃ lɛo wàa do,","poem":1},{"lineBreak":true},{"text":"aↄ̃é ká bↄrↄ ũgbangba wa kpàsan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wa zùnↄ égↄ̃ dɛ nɛ́dandeenↄ ũ,","poem":1},{"lineBreak":true},{"text":"nↄ̀bↄɛna égↄ̃ kuuro,","poem":1},{"lineBreak":true},{"text":"lagona égↄ̃ kuuro,","poem":1},{"lineBreak":true},{"text":"wɛ̃nda'ↄ́ↄdↄna égↄ̃ kú gãalɛro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Aubarikadeenↄn gbɛ̃ kɛ̀ aↄ̃ kuuna dɛ lɛɛnↄ ũ,","poem":1},{"lineBreak":true},{"text":"aubarikadeenↄn gbɛ̃ kɛ̀ Dii dɛ ń Luda ũunↄ ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}