{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":145,"content":[{"type":"heading","content":["Dii táakilɛna a maakɛna yãnzi"]},{"type":"hebrew_subtitle","content":["Dii táaki kɛ̀ Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Mɛ́ n táaki lɛ́, ma Luda ma Kína,","poem":1},{"lineBreak":true},{"text":"mɛ́gↄ̃ n tↄ́ bↄↄ gurↄ píngi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɛ́gↄ̃ n sáabu kpaa lán guu e dↄↄ nà,","poem":1},{"lineBreak":true},{"text":"mɛ́gↄ̃ n táaki lɛɛ yãana sai.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii bíta, à kà wà à táaki lɛ́,","poem":1},{"lineBreak":true},{"text":"à bítakɛ lɛ́ vĩro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kpàɛnↄ é n yãkɛnanↄ sáabu kpá Wurenↄnɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃é n yãbitakɛnanↄ kpàakpa kɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aↄ̃é n maakɛ bíta gakuide yã o,","poem":1},{"lineBreak":true},{"text":"mɛ́ n yãbↄnsaɛkɛnanↄ laasuu lɛ́.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aↄ̃é n yãkɛna naaside gbãa yã o,","poem":1},{"lineBreak":true},{"text":"mɛ́ n bítakɛɛ tↄ̃kɛ̃ńnɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aↄ̃é n maakɛ bíta baaru kpá,","poem":1},{"lineBreak":true},{"text":"aↄ̃é guda kɛ n yãzɛdekɛnanↄ yãnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii sùu vĩ kↄ̃n wɛ̃ndaao,","poem":1},{"lineBreak":true},{"text":"è pↄ fɛ̃ kpaaro, à gbɛ̃kɛɛ vĩ bíta.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii è à maaa kɛ baade pínginɛ,","poem":1},{"lineBreak":true},{"text":"è a pↄ́ kɛ̀ à kɛ̀nↄ wɛ̃nda gwa ń píngi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pↄ́ kɛ̀ ń kɛ̀nↄ é n sáabu kpá ń píngi,","poem":1},{"lineBreak":true},{"text":"n yãmarinↄ é n tↄ́ sɛ́ lezĩ, Dii.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aↄ̃é n kpata gakui gari kɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃é n iko gbãa yã o,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"lɛ gbɛ̃ píngi n yãbitakɛnanↄ dↄ̃","poem":1},{"lineBreak":true},{"text":"kↄ̃n n kpata maa gakuide yão.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N kpata nɛ́ kpata yãanasaimɛ,","poem":1},{"lineBreak":true},{"text":"nɛ́gↄ̃ dɛ kí ũ ai wa boriia.","poem":1},{"lineBreak":true},{"text":"Dii náanɛ vĩ yã kɛ̀ à ò píngi musu,","poem":1},{"lineBreak":true},{"text":"à sùu vĩ kↄ̃n pↄ́ kɛ̀ à kɛ̀nↄ ń píngi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii è gbɛ̃ kɛ̀ aↄ̃ↄe lɛɛɛnↄ kũ,","poem":1},{"lineBreak":true},{"text":"è gbɛ̃ kɛ̀ nawɛ̃a tↄ̃̀ḿmanↄ fɛɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pↄ́ píngi wɛ́ɛ dↄnzi,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ pↄ́blee kpáḿma à gurↄↄa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ ↄ porońnɛ pↄ́ mↄ́ḿma,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ pↄ́ píngi pↄyezi bↄkↄ̃tɛnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dii yãkɛnanↄↄ maa píngi,","poem":1},{"lineBreak":true},{"text":"à gbɛ̃kɛɛ vĩ a yã píngi kɛna guu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dii kĩi kↄ̃n a sìsirinↄ ń píngi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃è à sísi kↄ̃n yãpuraaonↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"È a vĩakɛrinↄ pↄyezi bↄkↄ̃tɛńnɛ,","poem":1},{"lineBreak":true},{"text":"è ń wiipɛna ma à ń mì sí.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii è gbɛ̃ kɛ̀ aↄ̃ↄ yeaziinↄ dãkpa ń píngi,","poem":1},{"lineBreak":true},{"text":"mↄde eé zaakɛrinↄ kaatɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dii táakilɛna égↄ̃ da ma lɛ́n,","poem":1},{"lineBreak":true},{"text":"pↄ́ píngi gↄ̃ à tↄ́ kɛ̀ kú adona bↄↄ gurↄ píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}