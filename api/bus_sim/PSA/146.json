{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":146,"content":[{"type":"heading","content":["Dii làakaridↄna wɛ̃ndadeenↄa"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Ma swɛ̃̀, ǹ Dii táaki lɛ́.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɛ́gↄ̃ Dii táaki lɛɛ ai ma wɛ̃̀ndi lɛ́n,","poem":1},{"lineBreak":true},{"text":"mɛ́gↄ̃ lɛ̀ sii ma Ludanɛ ai ma kuuna lɛ́n.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Àton náanɛ dↄ gbãadeenↄaro,","poem":1},{"lineBreak":true},{"text":"mìsina kú gbɛ̃ntee kiiaro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tó aↄ̃ wɛ̃̀ndi tà, aↄ̃è ɛara wà gɛ̃ bùsun,","poem":1},{"lineBreak":true},{"text":"zĩ beeean yã kɛ̀ aↄ̃ↄe pɛɛa è yãa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aubarikadeen gbɛ̃ kɛ̀ Yakubu Luda de à dↄnlɛri ũu ũ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ à wɛ́ɛ dↄ Dii a Ludazi,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"musu kↄ̃n tↄↄtɛo Kɛ̀ri,","poem":1},{"lineBreak":true},{"text":"ísia kↄ̃n pↄ́ kɛ̀ kú à guunↄ píngi.","poem":1},{"lineBreak":true},{"text":"Dii náanɛ vĩ gurↄ píngi,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"è yã sí kↄ̃n gbɛ̃ kɛ̀ wèe gbãaa mↄↄńnɛnↄo,","poem":1},{"lineBreak":true},{"text":"è pↄ́blee kpá nↄadɛrinↄa.","poem":1},{"lineBreak":true},{"text":"Dii è bà poro gbɛ̃ kɛ̀ aↄ̃ↄ yinanↄa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii è vĩ̀anↄ wɛ́ɛ wɛ̃ńnɛ,","poem":1},{"lineBreak":true},{"text":"Dii è gbɛ̃ kɛ̀ nawɛ̃a tↄ̃̀ḿmanↄ fɛɛ,","poem":1},{"lineBreak":true},{"text":"Dii ègↄ̃ ye gbɛ̃ maaanↄzi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii è bↄ̀amↄnↄ gwa,","poem":1},{"lineBreak":true},{"text":"è ↄ da gyaanↄnↄa kↄ̃n tonɛnↄ,","poem":1},{"lineBreak":true},{"text":"mↄde è zɛ́ yãkↄ̃tɛ gbɛ̃ zaaanↄnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dii ègↄ̃ kí blee gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"Zayↄndeenↄ, a Luda ègↄ̃ kuu ai a boriia.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}