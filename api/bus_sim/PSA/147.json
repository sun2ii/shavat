{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":147,"content":[{"type":"heading","content":["Pↄ́ píngi kú Luda ↄzĩ"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"Lɛ̀sina wa Ludanɛ maa,","poem":1},{"lineBreak":true},{"text":"à nna bensↄ̃ à kↄ̃ sìo wà à táaki lɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dii e Yerusalɛmu fɛɛɛ dↄ,","poem":1},{"lineBreak":true},{"text":"èe Isaraili zĩ̀zↄnↄ kaakↄ̃a, èe ɛara à suńyo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"È gbɛ̃ kɛ̀ aↄ̃ nↄ̀sɛ yàkanↄ làakari kpáɛńnɛ,","poem":1},{"lineBreak":true},{"text":"è ń bↄ̀ pípińnɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À sↄsↄnɛnↄ lɛ́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"è ń baade sísi a tↄ́a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wa Dii bíta, à iko vĩ maamaa,","poem":1},{"lineBreak":true},{"text":"à ↄ̃ndↄ̃ↄ lɛ́ vĩro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii è zĩndabusarinↄ gba gbãaa,","poem":1},{"lineBreak":true},{"text":"mↄde è ↄ tↄ̃ zaakɛrinↄa ai tↄↄtɛa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À lɛ̀ sí Diinɛ kↄ̃n à sáabukɛnao,","poem":1},{"lineBreak":true},{"text":"à wa Luda táaki lɛ́ kↄ̃n mↄrↄo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"È tó lou sisi,","poem":1},{"lineBreak":true},{"text":"è tↄↄtɛ gba lou,","poem":1},{"lineBreak":true},{"text":"è tó sɛ̃̀ bↄɛ sĩ̀sĩnↄa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"È pↄ́blee kpá nↄ̀bↄnↄa","poem":1},{"lineBreak":true},{"text":"kↄ̃n gbáa kãnkãna nɛ́nↄ, tó aↄ̃ↄe wii pɛɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Èe kɛ sↄ̃ gbãakɛɛ bé è kánɛro,","poem":1},{"lineBreak":true},{"text":"èe kɛ gↄ̃sagbãakɛɛ bé è kɛnɛro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃ↄ à vĩa vĩinↄ bé è kánɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃ wɛ́ɛ dↄ à gbɛ̃kɛɛzinↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yerusalɛmudeenↄ, à Dii tↄ́ bↄ,","poem":1},{"lineBreak":true},{"text":"Zayↄndeenↄ, à a Luda táaki lɛ́.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zaakɛ è aubarika daagu,","poem":1},{"lineBreak":true},{"text":"è a wɛ́tɛ bĩilɛnↄ gbãaa kaaraare.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"È a gba aafia ai a bùsulɛ lɛ́n,","poem":1},{"lineBreak":true},{"text":"è pↄ́bori maaa kpáawa à mↄ́awa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"È yã o à kpãsã tↄↄtɛnɛ,","poem":1},{"lineBreak":true},{"text":"à yã è ká gↄ̃ↄgↄ̃ↄ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"È tó lougbɛ kwɛ́ púu lán buu bà,","poem":1},{"lineBreak":true},{"text":"è tó kpíi kpá lán túbu bà,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"è lougbɛ fã lán gbɛ̀kↄsↄ bà.","poem":1},{"lineBreak":true},{"text":"Dé bé eé fↄ̃ à zɛ à ĩa yĩizi?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"È yã o à kpãsã, lougbɛ è yↄ́,","poem":1},{"lineBreak":true},{"text":"è ĩa gbarɛ, à í è bàa lɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"È tó Yakubu boriinↄ gↄ̃ a yã dↄ̃,","poem":1},{"lineBreak":true},{"text":"è doka kɛ̀ a dìɛnↄ da Isarailinↄnɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Èe beee kɛ bori pãnde kenɛro,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ à yãdiɛnanↄ dↄ̃ro.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}