{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":148,"content":[{"type":"heading","content":["Dii pↄ́ kɛ̀ à kɛ̀nↄ à táakilɛna"]},{"type":"verse","number":1,"content":[{"text":"Aleluya!","poem":1},{"lineBreak":true},{"text":"À Dii táaki lɛ́, à bɛdeenↄ,","poem":1},{"lineBreak":true},{"text":"à à táaki lɛ́ zaa musu!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À à táaki lɛ́, à malaikanↄ a píngi,","poem":1},{"lineBreak":true},{"text":"à à táaki lɛ́, à ìbanↄ a píngi!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À à táaki lɛ́, ↄfãntɛ̃ kↄ̃n mↄvurao,","poem":1},{"lineBreak":true},{"text":"à à táaki lɛ́, sↄsↄnɛ ínnaanↄ píngi!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À à táaki lɛ́, bàtuma musumusu pↄ́nↄ","poem":1},{"lineBreak":true},{"text":"kↄ̃n í kɛ̀ da ludambɛɛlaanↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aↄ̃ Dii tↄ́ bↄ,","poem":1},{"lineBreak":true},{"text":"zaakɛ à yã ò, ben aↄ̃ↄ kuu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À ń pɛpɛ ń pɛ́kiia","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃gↄ̃ kú gwe gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"à doka dìɛńnɛ, aↄ̃é fↄ̃ wà vĩàlaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À Dii táaki lɛ́, pↄ́ kɛ̀ kú tↄↄtɛnↄ,","poem":1},{"lineBreak":true},{"text":"kpↄ̀ gbɛ̃̀ntɛ̃nↄ kↄ̃n ísia lↄ̀nↄ,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kↄ̃n loupinao kↄ̃n lougbɛo kↄ̃n lousisinao","poem":1},{"lineBreak":true},{"text":"kↄ̃n zàga'ĩa kɛ̀ è mì siɛ à yãnɛo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kↄ̃n kpiiinↄ kↄ̃n sĩ̀sĩnↄ píngi","poem":1},{"lineBreak":true},{"text":"kↄ̃n lí nɛ́'irinↄ kↄ̃n sida línↄ píngi,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"kↄ̃n nↄ̀bↄsɛ̃tɛnↄ kↄ̃n pↄ́kãdeenↄ píngi","poem":1},{"lineBreak":true},{"text":"kↄ̃n pↄ́taa'onkusɛanↄ kↄ̃n bãanↄ,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"kↄ̃n anduna kínanↄ kↄ̃n boriinↄ píngi","poem":1},{"lineBreak":true},{"text":"kↄ̃n kínɛnↄ kↄ̃n bùsu gbãadeenↄ ń píngi,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"kↄ̃n gↄ̃kparɛnↄ kↄ̃n nↄkparɛnↄ ń píngi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nsi nɛ́ féte.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aↄ̃ Dii tↄ́ bↄ,","poem":1},{"lineBreak":true},{"text":"zaakɛ à mɛ̀n doo tↄ́ bé à bíta,","poem":1},{"lineBreak":true},{"text":"à gakui dɛ musu kↄ̃n tↄↄtɛo pↄ́la.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À kí kà a gbɛ̃nↄnɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ à yãmarinↄ è à táaki lɛ́,","poem":1},{"lineBreak":true},{"text":"Isaraili kɛ̀ aↄ̃ↄ kĩionↄ.","poem":1},{"lineBreak":true},{"text":"Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}