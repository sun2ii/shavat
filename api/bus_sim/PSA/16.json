{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":16,"content":[{"type":"heading","content":["Nana Ludazi adua"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Ǹ ma dãkpa Luda,","poem":1},{"lineBreak":true},{"text":"ḿbe ma nanzi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma bè Diinɛ: Ḿbe ma Dii ũ,","poem":1},{"lineBreak":true},{"text":"n baasiro má pↄ́ maa ke vĩro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N gbɛ̃ kɛ̀ aↄ̃ↄ kú bùsu kɛ̀ guunↄ,","poem":1},{"lineBreak":true},{"text":"aↄ̃mbe gakuidee kɛ̀ wà kɛ̀mɛɛnↄ ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃è wã wà gá tãa kiianↄ","poem":1},{"lineBreak":true},{"text":"è yã'ↄ̃amma kpá ń zĩndazimɛ.","poem":1},{"lineBreak":true},{"text":"Mɛ́ sa'o'aru kwɛ́ɛńyoro,","poem":1},{"lineBreak":true},{"text":"weé ń tãanↄ tↄ́ ma ma lɛ́zĩro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii, ḿbe má n vĩ ndo,","poem":1},{"lineBreak":true},{"text":"n ma ka ma bakaa,","poem":1},{"lineBreak":true},{"text":"ma wɛ̃̀ndi kú n ↄzĩmɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N tↄↄtɛ lɛ́zɛkiinↄ kɛ̀mɛ gu maaa guu,","poem":1},{"lineBreak":true},{"text":"gbaa kɛ̀ ń dàmɛɛ kɛ̀mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mɛ́ Dii sáabu kpá kɛ̀ è lɛ́ dama yãnzi,","poem":1},{"lineBreak":true},{"text":"baa gwãavĩ è tó ma swɛ̃̀ ma gba làakari.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɛɛ̀gↄ̃ Dii ee ma wɛ́ɛn,","poem":1},{"lineBreak":true},{"text":"lán à kú ma ↄplaazi nà, pↄ́ke é ma degero.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Beee yãnzi ma pↄↄ ègↄ̃ nnazi,","poem":1},{"lineBreak":true},{"text":"ma nↄ̀sɛguu pù.","poem":1},{"lineBreak":true},{"text":"Má tãmaa vĩ kɛ̀ ma mɛ̀ égↄ̃ kuu,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"zaakɛ nɛ́ ma tó mira guuro,","poem":1},{"lineBreak":true},{"text":"nɛ́ we n gbɛ̃ kɛ̀ kú adona yai kũro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ma da wɛ̃̀ndi zɛ́a,","poem":1},{"lineBreak":true},{"text":"ma pↄnnaa égↄ̃ pana n kiia,","poem":1},{"lineBreak":true},{"text":"pↄ́ maaanↄ égↄ̃ kú n ↄzĩ gurↄ píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}