{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":17,"content":[{"type":"heading","content":["Taarisaidee aduakɛna"]},{"type":"hebrew_subtitle","content":["Dauda aduakɛna"]},{"type":"verse","number":1,"content":[{"text":"Dii, ǹ ma yãzɛdee ma,","poem":1},{"lineBreak":true},{"text":"ǹ swã kpá ma wiipɛnazi,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ́ɛkɛna sí,","poem":1},{"lineBreak":true},{"text":"zaakɛ mɛ́ɛ kɛɛ kↄ̃n mↄnafikioro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N kiian mɛ́ yã nnaa en,","poem":1},{"lineBreak":true},{"text":"n wɛ́ɛ e yã kɛ̀ zɛ́ vĩi ee sãnsãn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ma swɛ̃̀ gwà, n wɛ́ɛ tɛ́mazi gwãavĩ,","poem":1},{"lineBreak":true},{"text":"n ma tàasi kɛ̀, nɛ́ɛ yãke emaro,","poem":1},{"lineBreak":true},{"text":"zaakɛ ma zɛo kɛ̀ ma lɛ́ é ma kari kɛro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɛɛ̀ tɛ́ gbɛ̃ntee yãkɛnanↄziro,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ gbɛ̃ pãsĩnↄ zɛ́kpaɛ sɛ́ro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma lili ò n zɛ́n súusu,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ pã n yãnɛro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mɛ́ɛ lɛ́ zuunzi, zaakɛ nɛ́ wemala.","poem":1},{"lineBreak":true},{"text":"Luda, ǹ swã kpá ma aduakɛnazi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ n gbɛ̃kɛ bↄnsaɛ yã kɛmɛ,","poem":1},{"lineBreak":true},{"text":"ǹ gbɛ̃ kɛ̀ aↄ̃ nànziinↄ bↄ ń ibɛɛnↄ ↄzĩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ làakari dↄma lán n wɛ́ɛnɛ bà,","poem":1},{"lineBreak":true},{"text":"ǹ ma sↄtↄ n ↄru.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ ma sí gbɛ̃ zaaa kɛ̀ aↄ̃è ĩa damaanↄa,","poem":1},{"lineBreak":true},{"text":"ma ibɛɛ kɛ̀ aↄ̃ↄ liganamazii pìnↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aↄ̃è gbɛ̃ke wɛ́ɛ gwaro,","poem":1},{"lineBreak":true},{"text":"aↄ̃ lɛ́ è ĩadãyã o.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aↄ̃ pɛ̀ɛma wà lìgamazi,","poem":1},{"lineBreak":true},{"text":"aↄ̃ wɛ́ɛ bìima lɛ wà e wà ma pãɛ tↄↄtɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aↄ̃ↄ yezi wà ma kɛ gyáigyai","poem":1},{"lineBreak":true},{"text":"lán músu nↄadɛri è kɛ nà,","poem":1},{"lineBreak":true},{"text":"lán músu kɛ̀ naɛna gusaɛ bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dii, ǹ fɛɛ ǹ dańlɛ ǹ ń nɛ,","poem":1},{"lineBreak":true},{"text":"ǹ ma sí gbɛ̃ zaaanↄa kↄ̃n n fɛ̃ɛdaao.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹ ma bↄ ń ↄzĩ kↄ̃n n gbãaao.","poem":1},{"lineBreak":true},{"text":"Aↄ̃ baka kú anduna kɛ̀kii guu,","poem":1},{"lineBreak":true},{"text":"aↄ̃ auziki ègↄ̃ dińzi, aↄ̃ nɛ́nↄ è kã,","poem":1},{"lineBreak":true},{"text":"aↄ̃è pↄ́ kɛ̀ dìńzinↄ káɛ ń nɛ́nↄnɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mapi sↄ̃, mɛ́ wɛ́ɛ sinlɛ ma nↄ̀sɛ maaa yãnzi,","poem":1},{"lineBreak":true},{"text":"tó ma n e ma fɛɛgurↄ, beee é mↄ́ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}