{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":19,"content":[{"type":"heading","content":["Ludambɛ gakui kↄ̃n Luda yã gakuio"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Musu è Luda gakui bↄ gupuraaa,","poem":1},{"lineBreak":true},{"text":"bàtumapↄnↄ è à zĩi ↄdↄańnɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lɛn èegↄ̃ yã oo lɛ lán guu e dↄↄ nà,","poem":1},{"lineBreak":true},{"text":"è dↄ̃na kpáḿma gwãavĩ kↄ̃n gwãavĩo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"È yã oro, à yã'ona borii kuuro,","poem":1},{"lineBreak":true},{"text":"wè à kĩi maro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À kòto è da andunala píngi,","poem":1},{"lineBreak":true},{"text":"à yã'ona è gá ai tↄↄtɛ lɛ́zɛkiia.","poem":1},{"lineBreak":true},{"text":"Luda kpɛ́ bò ↄfãntɛ̃nɛ gwe,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"è bↄ kpɛ́n à fɛɛ lán nↄsɛri bà,","poem":1},{"lineBreak":true},{"text":"è fɛɛ táo kↄ̃n pↄnnaao lán gↄ̃sagbãaa bà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"È fɛɛ ludambɛlɛa kɛ̀,","poem":1},{"lineBreak":true},{"text":"è bikũ à gá ai à lɛ́a kãa,","poem":1},{"lineBreak":true},{"text":"pↄ́ke ègↄ̃ utɛna à puusunɛro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dii doka papana,","poem":1},{"lineBreak":true},{"text":"è ń kuuna kɛkɛ à kɛńnɛ dↄ.","poem":1},{"lineBreak":true},{"text":"Dii yã náanɛ vĩ,","poem":1},{"lineBreak":true},{"text":"è lɛ́ da ↄ̃ndↄ̃saideenↄa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii ↄdↄkii bé à súusu, è ń pↄↄ kɛ nna.","poem":1},{"lineBreak":true},{"text":"Dii yãdiɛnanↄↄ gbãsĩ vĩro, è ń uu wereńnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mìsiɛna Diinɛ zɛ́ pì wɛ́ɛbↄna,","poem":1},{"lineBreak":true},{"text":"weégↄ̃ tɛ́zi gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"Dii yãkpaɛkɛna yãpuraa vĩ,","poem":1},{"lineBreak":true},{"text":"ègↄ̃ maa wásawasa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À maaa dɛ vurala, baa vura maaa,","poem":1},{"lineBreak":true},{"text":"à nnaa dɛ zↄ́'ila, baa zↄ́ búsu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Beee musu nɛɛ̀ lɛ́ da mamↄma n zↄ̀bleria,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ n yã kũna àre ègↄ̃ bíta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dé bé eé fↄ̃ à yã kɛ̀ à zã̀anↄ dↄ̃ↄ?","poem":1},{"lineBreak":true},{"text":"Ǹ sùu kɛmao kↄ̃n ma taari kɛ̀ utɛnamɛɛnↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ǹton tó mamↄma n zↄ̀bleri taari kɛnnɛ gĩanziro,","poem":1},{"lineBreak":true},{"text":"ǹton tó durunnↄ kí blemaro,","poem":1},{"lineBreak":true},{"text":"mɛ́gↄ̃ kuu wásawasa taari bíta sai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ǹ tó yã kɛ̀ èe bↄↄ ma lɛ́n kɛnnɛ","poem":1},{"lineBreak":true},{"text":"kↄ̃n laasuu kɛ̀ kú ma swɛ̃̀ guuo,","poem":1},{"lineBreak":true},{"text":"Dii, ma gbɛ̀si, ma mìsiri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}