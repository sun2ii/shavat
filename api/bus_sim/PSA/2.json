{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":2,"content":[{"type":"heading","content":["Kí kɛ̀ Ludaa kà"]},{"type":"verse","number":1,"content":[{"text":"Bↄ́yãnzin boriinↄↄ e zↄka kaazi?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dia wèe lɛ́ pãa kpaakↄ̃sↄ̃ↄ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Anduna kínanↄↄ e zĩ̀ soru kɛɛ,","poem":1},{"lineBreak":true},{"text":"kpatablerinↄↄ e kaakↄ̃a Diizi","poem":1},{"lineBreak":true},{"text":"kↄ̃n Kí kɛ̀ à kào.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aↄ̃ↄe bee: Wà ń mↄ̀kyakoonↄ kɛ̃kɛ̃,","poem":1},{"lineBreak":true},{"text":"wà ń bà porowa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dii e ń faboo,","poem":1},{"lineBreak":true},{"text":"à vɛ̃ɛna musu, èe ń yáa dↄↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Èe pataaḿma kↄ̃n pↄfɛ̃o,","poem":1},{"lineBreak":true},{"text":"à pɛ̃tɛ̃ è tó vĩa ń kũ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À bè a a Kí kà a kpii Zayↄn musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mɛ́ yã kɛ̀ Dii dìɛmɛɛ o kɛ̀ à bè:","poem":1},{"lineBreak":true},{"text":"Ma Nɛ́n n ũ, gbã̀an ma n i.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ wɛ́ɛ kɛma, mɛ́ bori píngi kpámma n pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ n gba anduna gooda siigↄ̃ↄ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɛ́ kí bleḿma kↄ̃n mↄ̀ gòo,","poem":1},{"lineBreak":true},{"text":"nɛ́ ń wíwi lán wè oroo wí nà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kínanↄ, à lɛ́damma kɛ̀kii ma,","poem":1},{"lineBreak":true},{"text":"anduna kpatablerinↄ, à ↄ̃ndↄ̃ kũ sa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"À dↄ Diizi kↄ̃n vĩao,","poem":1},{"lineBreak":true},{"text":"à pↄnnaa kɛo kↄ̃n luganao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"À lɛ́ pɛ́ à Nɛ́a","poem":1},{"lineBreak":true},{"text":"lɛ à pↄↄ tón fɛ̃azi à gaga zɛ́nlo,","poem":1},{"lineBreak":true},{"text":"zaakɛ à pↄↄ è fɛ̃ kãndomɛ.","poem":1},{"lineBreak":true},{"text":"Aubarikadeen gbɛ̃ kɛ̀ nàzi ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}