k":true},{"text":"Dii wɛ́ɛkɛɛ kɛ̀ ń kɛ̀ sí píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Má dↄ̃ sa kɛ̀ Dii è kína kɛ̀ à à kà mì sí,","poem":1},{"lineBreak":true},{"text":"è yã sío zaa a bɛɛ kɛ̀ kú adonan,","poem":1},{"lineBreak":true},{"text":"è tó à zĩ̀ ble kↄ̃n a gã̀sã gbãaao.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃kenↄ è sↄ̃goronↄ náanɛ kɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃kenↄ è sↄ̃nↄ náanɛ kɛ,","poem":1},{"lineBreak":true},{"text":"wapinↄ sↄ̃, Dii wa Ludan weè náanɛ kɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aↄ̃é gɛ̃̀n sí wà lɛ́ɛ,","poem":1},{"lineBreak":true},{"text":"wapinↄ sↄ̃ wégↄ̃ zɛna gíngin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dii, ǹ tó kína zĩ̀ ble,","poem":1},{"lineBreak":true},{"text":"tó wa n sisi, ǹ wewala.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}