{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":21,"content":[{"type":"heading","content":["Zĩ̀blena sáabu"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii, kína e pↄnnaa kɛɛ kↄ̃n n gbãaao,","poem":1},{"lineBreak":true},{"text":"à pↄↄ nna maamaa kɛ̀ ń tò à zĩ̀ blè.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N pↄ́ kɛ̀ à pↄↄ yezi kpàa,","poem":1},{"lineBreak":true},{"text":"nɛ́ɛ gí à wɛ́ɛkɛna síziro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N daàlɛ kↄ̃n aubarika bítao,","poem":1},{"lineBreak":true},{"text":"n vura fùra kùnɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À wɛ̃̀ndi gbèkamma, ben ń kpàa,","poem":1},{"lineBreak":true},{"text":"ń tò àgↄ̃ kuu ai gurↄ píngi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À gakui bíta kɛ̀ ń tò à zĩ̀ blè,","poem":1},{"lineBreak":true},{"text":"n bɛ̀ɛ kↄ̃n bítakɛɛo kpàa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɛɛ̀gↄ̃ aubarika daan gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"n kuuna bé à tò à pↄↄ kɛ̀ nna.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zaakɛ kína náanɛ dↄ̀ Diia,","poem":1},{"lineBreak":true},{"text":"Luda Musude gbɛ̃kɛ yãnzi eé nigãro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"N ↄↄ é n ibɛɛnↄ kũ ń píngi,","poem":1},{"lineBreak":true},{"text":"nɛ́ n zangurinↄ kũ kↄ̃n n ↄplaao.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nɛ́ ń kɛ mↄ̀datɛ yàka ũ n mↄ́gurↄ,","poem":1},{"lineBreak":true},{"text":"Dii é ń kaatɛ a pↄfɛ̃gurↄ, eé tó tɛ́ ń ble.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nɛ́ ń nɛ́nↄ mì dɛ anduna guu,","poem":1},{"lineBreak":true},{"text":"nɛ́ ń boriinↄ kɛ̃ gbɛ̃nteenↄa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Baa tó aↄ̃ lɛ́ kpàkↄ̃sↄ̃nzi,","poem":1},{"lineBreak":true},{"text":"aↄ̃ pↄyeziyã é zĩi kɛro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɛ́ kà dↄdↄ ń wɛ́ɛa,","poem":1},{"lineBreak":true},{"text":"nɛ́ tó aↄ̃ kpɛɛ li.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"N gbãakɛɛ guu, Dii, ǹ n zĩnda sɛ́ lezĩ,","poem":1},{"lineBreak":true},{"text":"wé lɛ̀ sí wà n bítakɛɛ sáabu kpá.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}