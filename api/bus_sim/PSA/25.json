{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":25,"content":[{"type":"heading","content":["Luda wa dãkpari"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii, ḿbe ma a swɛ̃̀ kpàmma,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma Luda, má n náanɛkɛna,","poem":1},{"lineBreak":true},{"text":"ǹton tó wí ma kũro,","poem":1},{"lineBreak":true},{"text":"ǹton tó ma ibɛɛnↄ ma nɛro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wí é gbɛ̃ kɛ̀ aↄ̃ wɛ́ɛ dↄnziinↄ kũ zikiro,","poem":1},{"lineBreak":true},{"text":"sé gbɛ̃ kɛ̀ aↄ̃ bↄ̀ n kpɛɛ yãkↄdↄana sainↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dii, ǹ n zɛ́ ↄdↄamɛ,","poem":1},{"lineBreak":true},{"text":"ǹ n yã dadamɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ǹ ma da n yãpura zɛ́a,","poem":1},{"lineBreak":true},{"text":"ǹ à yã dadamɛ,","poem":1},{"lineBreak":true},{"text":"zaakɛ Luda ma mìsirin n ũ,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ɛ ègↄ̃ dↄnzimɛ gurↄ píngi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N wɛ̃nda kↄ̃n n yenzio gↄ̃ dↄngu,","poem":1},{"lineBreak":true},{"text":"zaakɛ beenↄↄ kúnyo zaa zi, Dii.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹton taari kɛ̀ má kɛ̀nↄ yã daro","poem":1},{"lineBreak":true},{"text":"ke durun kɛ̀ má kɛ̀ ma gↄ̃kparɛkɛgurↄↄnↄ.","poem":1},{"lineBreak":true},{"text":"Ǹ tó ma yã gↄ̃ dↄngu yenzi guu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ ń maa yãnzi, Dii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii maa, è yã kɛ a zɛ́a,","poem":1},{"lineBreak":true},{"text":"beee yãnzin è a yã dada durunkɛrinↄnɛzi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"È zĩndabusarinↄ da a zɛ́a,","poem":1},{"lineBreak":true},{"text":"è yã maaa dadańnɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii ègↄ̃ yenzi kↄ̃n náanɛo vĩ","poem":1},{"lineBreak":true},{"text":"kↄ̃n gbɛ̃ kɛ̀ aↄ̃ a bà kuunańyo yã kũnanↄ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Baa kɛ̀ ma durun bíta Dii,","poem":1},{"lineBreak":true},{"text":"ǹ kɛ̃mɛ n tↄ́bↄna yãnzi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dé bé à Dii vĩa vĩi?","poem":1},{"lineBreak":true},{"text":"Dii è adee da zɛ́ kɛ̀ dɛ à sɛ́a.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Adee égↄ̃ kú nnamana guu,","poem":1},{"lineBreak":true},{"text":"à boriinↄ bé wégↄ̃ ń bùsu vĩ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii ègↄ̃ nna kↄ̃n a vĩakɛrinↄ,","poem":1},{"lineBreak":true},{"text":"è tó aↄ̃gↄ̃ a bà kuunańyo yã dↄ̃.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma wɛ́ɛ ègↄ̃ pɛ́ Diia,","poem":1},{"lineBreak":true},{"text":"zaakɛ àmbe è ma gbá bↄ bàn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ǹ aɛ dↄma, nɛ́ ma wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"zaakɛ má kú mado wɛ́ɛtãmma guu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma yã'ↄ̃ammanↄ kàara ma nↄ̀sɛ guu,","poem":1},{"lineBreak":true},{"text":"ǹ ma bↄ ma nawɛ̃a pìn.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ǹ ma wɛ́ɛtãmma kↄ̃n ma pↄsiaao gwa,","poem":1},{"lineBreak":true},{"text":"nɛ́ ma durunnↄ kɛ̃ma píngi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ǹ gwa lán ma ibɛɛnↄ dàgula nà,","poem":1},{"lineBreak":true},{"text":"aↄ̃ zàmagu pãsĩpãsĩ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ǹ ma wɛ̃̀ndi dãkpa, nɛ́ ma mì sí,","poem":1},{"lineBreak":true},{"text":"ǹton tó wí ma kũro, zaakɛ ma nanzi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ǹ tó yãpura kↄ̃n kuuna maaao gↄ̃ ma dãkpaa,","poem":1},{"lineBreak":true},{"text":"zaakɛ ma wɛ́ɛ ègↄ̃ dↄnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Luda, ǹ Isarailinↄ bↄ ń nawɛ̃anↄn píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}