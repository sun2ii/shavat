{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":27,"content":[{"type":"heading","content":["Diin ma gupuraa ũ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Diin ma gupuraa ũ kↄ̃n ma mìsirio,","poem":1},{"lineBreak":true},{"text":"dén mɛ́ vĩa kɛnɛ?","poem":1},{"lineBreak":true},{"text":"Diin ma utɛkii ũ,","poem":1},{"lineBreak":true},{"text":"dé vĩa bé eé ma kũu?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃ zaaanↄ lɛ̀ɛma lɛ wà ma kɛ gyáigyai","poem":1},{"lineBreak":true},{"text":"ke tó ma ibɛɛnↄ kↄ̃n ma zangurinↄ fɛ̀ɛmazi,","poem":1},{"lineBreak":true},{"text":"aↄ̃é gɛ̃̀n sí wà lɛ́ɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Baa tó zĩ̀karinↄ lìgamazi,","poem":1},{"lineBreak":true},{"text":"ma kù é vĩro,","poem":1},{"lineBreak":true},{"text":"baa tó gbɛ̃nↄ fɛ̀ɛmazi kↄ̃n zĩ̀o,","poem":1},{"lineBreak":true},{"text":"ma làakari égↄ̃ kpaɛnamɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yã mɛ̀n don mɛ́ɛ gbekaa Diia,","poem":1},{"lineBreak":true},{"text":"yã pìn mɛ́ɛ wɛtɛɛ maamaa.","poem":1},{"lineBreak":true},{"text":"Má yezi màgↄ̃ kú Dii ua ai ma wɛ̃̀ndi lɛ́n,","poem":1},{"lineBreak":true},{"text":"lɛ màgↄ̃ à wɛ́ɛ wɛtɛ à kpɛ́n gwe,","poem":1},{"lineBreak":true},{"text":"mɛ́ wɛ́ɛ pɛ́ à maakɛɛa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Eé ma utɛ a kpɛ́n nawɛ̃akɛgurↄ,","poem":1},{"lineBreak":true},{"text":"eé ma gwa a bisakutaan,","poem":1},{"lineBreak":true},{"text":"eé ma zɛ gbɛ̀ musu aafia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma mì é gbã à dɛ ma ibɛɛ kɛ̀ aↄ̃ↄ ligamaziinↄ pↄ́la,","poem":1},{"lineBreak":true},{"text":"mɛ́ saa o Dii ua kↄ̃n gudakɛnao,","poem":1},{"lineBreak":true},{"text":"mɛ́ lɛ̀ sí mà à sáabu kpá.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tó ma n sisi Dii, ǹ wemala,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ̃nda gwa, nɛ́ ma yã ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma nↄ̀sɛ e lɛ́ daama mà n wɛ́ɛ wɛtɛ,","poem":1},{"lineBreak":true},{"text":"Dii, mɛ́ɛ n wɛ́ɛ wɛtɛɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹton mìkpɛɛ zu mamↄma n zↄ̀blerinɛro,","poem":1},{"lineBreak":true},{"text":"ǹton kpɛɛ limɛ kↄ̃n pↄfɛ̃oro.","poem":1},{"lineBreak":true},{"text":"Ma dↄnlɛrin n ũ, ǹton ma zĩnnaro,","poem":1},{"lineBreak":true},{"text":"Luda ma mìsiri, ǹton ma tónlo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tó ma de kↄ̃n ma dao pã kpàmazi,","poem":1},{"lineBreak":true},{"text":"Dii é ma sí.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii, ǹ n yãzɛdee damɛ,","poem":1},{"lineBreak":true},{"text":"ǹ dↄmɛ aɛ zɛ́ súusu guu ma wɛ́ɛtãmmarinↄ yãnzi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹton tó ma ibɛɛnↄ pↄyeziyã kɛ ma musuro,","poem":1},{"lineBreak":true},{"text":"zaakɛ sèeda ɛgɛdeenↄↄ e yã diima,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ pãsĩnↄↄ e pↄ́ bↄↄ ń yĩzĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Má yã kɛ̀kii náanɛkɛna,","poem":1},{"lineBreak":true},{"text":"kɛ̀ Dii é à maaa kɛmɛ anduna kɛ̀ guu.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹ wɛ́ɛ dↄ Diizi,","poem":1},{"lineBreak":true},{"text":"ǹ zɛ gbãa, nɛ́ n làakari kpáɛ,","poem":1},{"lineBreak":true},{"text":"ǹ wɛ́ɛ dↄ Diizi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}