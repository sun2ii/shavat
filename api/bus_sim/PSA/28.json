{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":28,"content":[{"type":"heading","content":["Wɛ́ɛkɛna kↄ̃n sáabukpanao"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii, ḿbe ma gbɛ̀si ũ, mɛ́ɛ n sisii,","poem":1},{"lineBreak":true},{"text":"ǹton ma yã kpá swãkotoro.","poem":1},{"lineBreak":true},{"text":"Tó n yĩtɛmala,","poem":1},{"lineBreak":true},{"text":"mɛ́ gↄ̃ lán gbɛ̃ kɛ̀ aↄ̃ sì gɛ̀wãa guunↄ bàmɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɛ́ɛ dↄnlɛ wii pɛɛmma,","poem":1},{"lineBreak":true},{"text":"ǹ swã kpámazi,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ ma ↄ sɛɛ n kúkii kpa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ǹton ma gáɛ lɛdo kↄ̃n gbɛ̃ bɛ̃̀ɛnↄ ke zaakɛrinↄoro.","poem":1},{"lineBreak":true},{"text":"Aↄ̃è yã nnaa o ń gbɛ̃daaanↄnɛ,","poem":1},{"lineBreak":true},{"text":"mↄde zangu bé à kú ń swɛ̃̀n.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ǹ kɛńnɛ aↄ̃ yãkɛnaa kↄ̃n ń zaakɛnao,","poem":1},{"lineBreak":true},{"text":"ǹ fĩa bońnɛ ń dàa","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃ yã zaaa wí ń musu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aↄ̃è Dii yãkɛna kↄ̃n à zĩkɛnao yã daro,","poem":1},{"lineBreak":true},{"text":"eé ń gboro, eé ń fɛɛ dↄro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aubarikadeen Dii ũ,","poem":1},{"lineBreak":true},{"text":"zaakɛ à swã kpà ma wɛ̃nda wiipɛnazi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Diin ma gbãaa ũ kↄ̃n ma sɛngbangoo,","poem":1},{"lineBreak":true},{"text":"má à náanɛ vĩ ma swɛ̃̀n.","poem":1},{"lineBreak":true},{"text":"È ma ĩan ká, ma pↄↄ è kɛ nna,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ à sáabu kpá kↄ̃n lɛ̀sinao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Diin a gbɛ̃nↄ gbãaa ũ,","poem":1},{"lineBreak":true},{"text":"à dɛ utɛkii ũ kí kɛ̀ à kànɛ, è à mì sí.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹ n gbɛ̃nↄ mì sí ǹ aubarika dańgu,","poem":1},{"lineBreak":true},{"text":"ǹ ń dãkpa ǹgↄ̃ ń kũna gurↄ píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}