{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":3,"content":[{"type":"heading","content":["Lɛ́zuna Ludazi ibɛɛnↄ yã musu"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kɛ̀ Dauda dà gurↄↄ kɛ̀ à bàa lɛ̀ a nɛ́ Abusalomunɛ."]},{"type":"verse","number":1,"content":[{"text":"Dii, ma wɛdɛrinↄↄ kpámɛ fá,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃ íbɛtɛ kpàmaonↄↄ pari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wèe ma yã oo pari,","poem":1},{"lineBreak":true},{"text":"wèe bee Luda é ma mì síro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mpi sↄ̃ Dii, nɛɛ̀ ↄ ligamazi sɛngbango ũ,","poem":1},{"lineBreak":true},{"text":"ma gakuin n ũ, nɛɛ̀ tó ma mì gↄ̃ da'ilana.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɛɛ̀ wii pɛ́ Diizi,","poem":1},{"lineBreak":true},{"text":"è wemala zaa a kúkiia kpiii musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mɛɛ̀ daɛ mà ii o mà vu,","poem":1},{"lineBreak":true},{"text":"zaakɛ Diin ma kũna ũ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Gↄ̃ↄn bↄrↄ baaagↄ̃ akurikurinↄↄ e ma wɛɛ kpa sãnda píngia,","poem":1},{"lineBreak":true},{"text":"mↄde mɛɛ̀ vĩa kɛńnɛro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ǹ fɛɛ, Dii,","poem":1},{"lineBreak":true},{"text":"ǹ ma mì sí, ma Luda,","poem":1},{"lineBreak":true},{"text":"ǹ ma ibɛɛnↄ swãn kɛkɛ,","poem":1},{"lineBreak":true},{"text":"ǹ gbɛ̃ zaaa pìnↄ swaa ɛ́'ɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii bé è gbɛ̃ mì sí.","poem":1},{"lineBreak":true},{"text":"Ǹ aubarika da n gbɛ̃nↄn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}