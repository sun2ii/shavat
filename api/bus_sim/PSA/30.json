{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":30,"content":[{"type":"heading","content":["Dii sáabukpana"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kɛ̀ Dauda dà Luda ua kyakɛna yã musu."]},{"type":"verse","number":1,"content":[{"text":"Mɛ́ n tↄ́ sɛ́ lezĩ Dii,","poem":1},{"lineBreak":true},{"text":"zaakɛ n ma kaara,","poem":1},{"lineBreak":true},{"text":"nɛ́ɛ tó ma ibɛɛnↄ ma nɛro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii ma Luda, ma wii pɛ̀nzi,","poem":1},{"lineBreak":true},{"text":"ben n ma gba aafia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii, n ma si miraa,","poem":1},{"lineBreak":true},{"text":"nɛ́ɛ tó ma si gɛ̀wãanlo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dii gbɛ̃nↄ, à à tↄ́ kpá,","poem":1},{"lineBreak":true},{"text":"à à tↄ́ kɛ̀ kú adona sáabu kpá.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zaakɛ à pↄfɛ̃na è gì kɛro,","poem":1},{"lineBreak":true},{"text":"à aubarika bé ègↄ̃ kuu ai gbɛ̃ wɛ̃̀ndi lɛ́n.","poem":1},{"lineBreak":true},{"text":"Ɔ́ↄdↄna ègↄ̃ kuu gwãavĩ,","poem":1},{"lineBreak":true},{"text":"ben guu è dↄ kↄ̃n pↄnnaao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɛ̀ má kú nnamana guu ma bè:","poem":1},{"lineBreak":true},{"text":"Mɛ́ kpágula zikiro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii, kɛ̀ n aubarika dàmagu,","poem":1},{"lineBreak":true},{"text":"n ma zɛ gíngin lán kpiii bà.","poem":1},{"lineBreak":true},{"text":"Mↄde kɛ̀ n mìkpɛɛ zùmɛ,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ bídi guu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N Dii, mbe ma n sisi,","poem":1},{"lineBreak":true},{"text":"ma kúɛ kɛ̀ ma diinɛ ma bè:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bↄ́ àren ma gaa vĩi ke ma sina gɛ̀wãan?","poem":1},{"lineBreak":true},{"text":"Ma mira é n tↄ́ kpán yↄ́?","poem":1},{"lineBreak":true},{"text":"Eé n náanɛ kpàakpa kɛn yↄ́?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹ ma yã ma Dii ǹ ma wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"Dii, ǹgↄ̃ dɛ ma dↄnlɛri ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"N ma ↄ́ↄdↄna lìɛ ↄ̃wãna ũ,","poem":1},{"lineBreak":true},{"text":"n ma pↄsia utanↄ pìtima,","poem":1},{"lineBreak":true},{"text":"n pↄnnaa dàmɛ pↄ́kãsãa ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mɛ́gↄ̃ yĩtɛnaro, mɛ́gↄ̃ n tↄ́ kpaamɛ,","poem":1},{"lineBreak":true},{"text":"Dii ma Luda,","poem":1},{"lineBreak":true},{"text":"mɛ́gↄ̃ n sáabu kpaa gurↄ píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}