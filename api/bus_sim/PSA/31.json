{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":31,"content":[{"type":"heading","content":["Zĩndakpana Diia"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii, ḿbe ma nanzi,","poem":1},{"lineBreak":true},{"text":"ǹton tó wí ma kũ zikiro.","poem":1},{"lineBreak":true},{"text":"Ǹ ma mì sí n maakɛna yãnzi,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ swã kpámazi, ǹ ma faaba kɛ kpakpaa,","poem":1},{"lineBreak":true},{"text":"ǹ gↄ̃ ma utɛki gbɛ̀ ũ,","poem":1},{"lineBreak":true},{"text":"zɛki gbãaa kɛ̀ eé ma faaba kɛɛ ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma gbɛ̀si kↄ̃n ma zɛki gbãaaon n ũ,","poem":1},{"lineBreak":true},{"text":"ǹ dↄmɛ aɛ ǹ ma da zɛ́a n tↄ́ yãnzi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ǹton tó mà si bà kɛ̀ wà kpàkpamɛɛnlo,","poem":1},{"lineBreak":true},{"text":"zaakɛ ma mìsirin n ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma a ninii nànnɛ n ↄzĩ,","poem":1},{"lineBreak":true},{"text":"ǹ ma mì sí Dii Luda yãpurade.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma za gbɛ̃ kɛ̀ aↄ̃è na tãanↄan,","poem":1},{"lineBreak":true},{"text":"Diin má náanɛ kɛ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mɛ́ yáa dↄ mà pↄnnaa kɛ kↄ̃n n yenzio,","poem":1},{"lineBreak":true},{"text":"zaakɛ n ma yã'ↄ̃amma è,","poem":1},{"lineBreak":true},{"text":"n ma nawɛ̃akɛna dↄ̃̀mɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nɛ́ɛ ma na ma ibɛɛnↄnɛ ń ↄzĩro,","poem":1},{"lineBreak":true},{"text":"n ma gba mɛ̀porokii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ǹ ma wɛ̃nda gwa Dii,","poem":1},{"lineBreak":true},{"text":"zaakɛ má kagurakɛnamɛ,","poem":1},{"lineBreak":true},{"text":"pↄsiaa tò ma wɛ́ɛ gↄ̃̀ súkusuku,","poem":1},{"lineBreak":true},{"text":"ma pↄↄ sia kũ̀ ma nↄ̀sɛ yàka.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pↄsiaa e ma wɛ̃̀ndi lagoo,","poem":1},{"lineBreak":true},{"text":"m̀bna e ma wɛ̃̀ yãaa,","poem":1},{"lineBreak":true},{"text":"laasuu tò má gbãaa vĩ dↄro,","poem":1},{"lineBreak":true},{"text":"ma wánↄ bùsa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃daaanↄ è kya kámagu ma ibɛɛnↄ yãnzi,","poem":1},{"lineBreak":true},{"text":"ma yã è ma gbɛ̃nↄ vĩa kũ maamaa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ weè dakↄ̃rɛ gãalɛnↄ è pãmɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ma yã e dↄ gbɛ̃ken dↄro,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ lán gɛ̀ bà,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ńnɛ lán oo kãndo bà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mɛɛ̀ ma kɛ̀ gbɛ̃nↄↄ e ma pee pari,","poem":1},{"lineBreak":true},{"text":"vĩapↄnↄↄ ligamazi.","poem":1},{"lineBreak":true},{"text":"Aↄ̃è kakↄ̃a wà lɛ́ kpákↄ̃sↄ̃mazi,","poem":1},{"lineBreak":true},{"text":"aↄ̃è lɛdolɛ kɛ ma wɛ̃̀ndibↄna yãnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mↄde ḿbe ma n náanɛ kɛ̀ Dii,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ be ma Ludan n ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma wɛ̃̀ndi ègↄ̃ kú n ↄzĩ gurↄ píngimɛ,","poem":1},{"lineBreak":true},{"text":"ǹ ma sí ma ibɛɛ kɛ̀ aↄ̃ↄe ma wɛtɛɛ","poem":1},{"lineBreak":true},{"text":"wà ma dɛɛnↄ ↄzĩ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ǹ uu were mamↄma n zↄ̀bleria,","poem":1},{"lineBreak":true},{"text":"ǹ ma mì sí n yenzi guu.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Dii, ǹton tó wí ma kũro,","poem":1},{"lineBreak":true},{"text":"zaakɛ ma wii pɛ̀nzi.","poem":1},{"lineBreak":true},{"text":"Ǹ tó wí zaakɛrinↄ kũ,","poem":1},{"lineBreak":true},{"text":"ǹ tó aↄ̃ lɛ́ gↄ̃ nakↄ̃ana gɛ̀wãan,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ǹ tó ɛgɛtori pìnↄ nɛ́nɛ naɛ.","poem":1},{"lineBreak":true},{"text":"Aↄ̃è dↄkɛ kↄ̃n gbɛ̃ maaanↄ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è kya káńgu kↄ̃n ĩadãnao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Auziki kɛ̀ ń kàkↄ̃a n vĩakɛrinↄnɛ bíta,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ aubarika da gbɛ̃ kɛ̀ aↄ̃ↄ nanziinↄn gbɛ̃ píngi wáa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃nↄ lɛ́ kpàkↄ̃sↄ̃ńzi, nɛɛ̀ ń utɛ n kuu,","poem":1},{"lineBreak":true},{"text":"tó wèe lɛokpakↄ̃a kɛɛńyo, nɛɛ̀ ń dãkpa n kukiia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Aubarikadeen Dii ũ,","poem":1},{"lineBreak":true},{"text":"zaakɛ à yenzi bíta ↄ̀dↄamɛ","poem":1},{"lineBreak":true},{"text":"wɛ́tɛ kɛ̀ wà lìgazi guu.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Swɛ̃̀ kɛ̃̀magu gwe,","poem":1},{"lineBreak":true},{"text":"ben ma bè, wà n kii zɛ́ zↄ̃̀mɛ.","poem":1},{"lineBreak":true},{"text":"Kɛ̀ ma faaba lɛ́ zùnzi,","poem":1},{"lineBreak":true},{"text":"n ma wɛ̃nda wiipɛna mà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Àgↄ̃ ye Diizi, amↄa a gbɛ̃nↄ.","poem":1},{"lineBreak":true},{"text":"Dii è a náanɛkɛrinↄ dãkpa,","poem":1},{"lineBreak":true},{"text":"è fĩa bo ĩadãrinↄnɛ pãsĩpãsĩ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Amↄa kɛ̀ a wɛ́ɛ dↄ Diizinↄ,","poem":1},{"lineBreak":true},{"text":"àgↄ̃ gbãa à a swɛ̃̀ kpáɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}