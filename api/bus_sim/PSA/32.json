{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":32,"content":[{"type":"heading","content":["Durun'ona Ludanɛ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Aubarikadeen gbɛ̃ kɛ̀ Luda pↄ́ kù à taarinↄla","poem":1},{"lineBreak":true},{"text":"à à durunnↄ kɛ̃̀nɛ ũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aubarikadeen gbɛ̃ kɛ̀ Dii è à durun yã daroo ũ,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ mↄnafiki kú à nↄ̀sɛ guuro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kɛ̀ ma yĩtɛ kↄ̃n ma durun-o, ma yãyã,","poem":1},{"lineBreak":true},{"text":"ma wiii ègↄ̃ dↄ zaa kↄngↄ ai uusiɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N ↄ tↄ̃̀ma fãantɛ̃ kↄ̃n gwãavĩo,","poem":1},{"lineBreak":true},{"text":"ma gbãaa yã̀a lán guwãagurↄ ↄfãntɛ̃ bé à ma lɛɛ bà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ben ma wennɛ ma durunzi,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ ma yã zaaa utɛnnɛ dↄro.","poem":1},{"lineBreak":true},{"text":"Ma bè, mɛ́ ma taarinↄ o Diinɛ,","poem":1},{"lineBreak":true},{"text":"ben à ma durun kɛ̃̀mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Beee yãnzi n náanɛkɛri wɛ́ɛ kɛmma a gurↄↄazi,","poem":1},{"lineBreak":true},{"text":"tó yã zĩ'ũu e mↄↄ, eé à lero.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma utɛkiin n ũ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ ma bↄ wɛ́ɛtãmma guu,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ ligamazi ǹ ma mì sí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mɛ́ yã dannɛ mà n da zɛ́ kɛ̀ dɛ ǹ sɛ́a,","poem":1},{"lineBreak":true},{"text":"mɛ́ lɛ́ damma, ma wɛ́ɛ gↄ̃ tɛ́nzi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹtongↄ̃ kuu laasuu sai","poem":1},{"lineBreak":true},{"text":"lán sↄ̃ ke bãagãsↄ̃ bàro,","poem":1},{"lineBreak":true},{"text":"tó nɛ́ɛ aizi káńnɛ kↄ̃n a bàoro,","poem":1},{"lineBreak":true},{"text":"aↄ̃è da n dↄ̀rↄaro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yã'ↄ̃amma è da gbɛ̃ zaaanↄla,","poem":1},{"lineBreak":true},{"text":"Dii yenzi è liga à náanɛkɛrinↄzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gbɛ̃ maaanↄ, à pↄnnaa kɛ Dii yãnzi,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuradeenↄ, à guda kɛ à yáa dↄ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}