{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":33,"content":[{"type":"heading","content":["Luda sáabukpana"]},{"type":"verse","number":1,"content":[{"text":"À guda dↄ Diia gbɛ̃ maaanↄ,","poem":1},{"lineBreak":true},{"text":"à kↄ̃ sìo nↄ̀sɛpuradeenↄ à sáabu kpá.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À Dii tↄ́ kpá kↄ̃n kuntigio,","poem":1},{"lineBreak":true},{"text":"à lɛ̀ sínɛ kↄ̃n mↄrↄo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À lɛ̀ dufu sínɛ,","poem":1},{"lineBreak":true},{"text":"à pↄ́'ↄnnanↄ lɛ́ kↄ̃n dↄ̃nao kↄ̃n pↄnna wiiio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Zaakɛ yã kɛ̀ Dii ò nɛ́ yãpuramɛ,","poem":1},{"lineBreak":true},{"text":"à náanɛ vĩ a yãkɛna píngi guu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À ye maakɛɛzi kↄ̃n yãzɛdeeo,","poem":1},{"lineBreak":true},{"text":"Dii yenzi anduna pà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dii yã'ona bé à musu kɛ̀,","poem":1},{"lineBreak":true},{"text":"à lɛ́'ĩa bé à musupↄnↄ pɛ̀pɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"À í kàɛ gu dↄ̃nkↄ̃, à gↄ̃̀ ísiaa ũ,","poem":1},{"lineBreak":true},{"text":"à ínↄ kàkↄ̃a, à gↄ̃̀ í lↄ̀ ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Anduna gbɛ̃ píngi, à vĩa kɛ Diinɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ bɛ̃ɛnↄ píngi, à mì siɛnɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Zaakɛ à yã ò, ben anduna gↄ̃̀ kaɛna,","poem":1},{"lineBreak":true},{"text":"à yã dìɛ, ben pↄ́ píngi gↄ̃̀ kun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii è lɛ́ kɛ̀ boriinↄↄ kpàkↄ̃sↄ̃ kɛ pã,","poem":1},{"lineBreak":true},{"text":"è kpá bùsudeenↄnɛ kↄ̃n pↄ́ kɛ̀ aↄ̃ↄe pɛɛao.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yã kɛ̀ Dii zɛ̀o ègↄ̃ diɛna gíngin,","poem":1},{"lineBreak":true},{"text":"yã kɛ̀ à à pↄↄ gbà ègↄ̃ kuu gurↄ píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Aubarikadeen borii kɛ̀ Dii dɛ à Luda ũu ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ à ń sɛ́ a pↄ́ ũunↄ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zaa musu Dii è guu gwa gĩzĩ,","poem":1},{"lineBreak":true},{"text":"è gbɛ̃nteenↄ e ń píngi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zaa à kúkiia è gbɛ̃ kɛ̀ aↄ̃ↄ kú","poem":1},{"lineBreak":true},{"text":"anduna guunↄ tàasi kɛ ń píngi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Àmbe à baade píngi swɛ̃̀ kɛ̀,","poem":1},{"lineBreak":true},{"text":"è ń yãkɛnanↄ dↄ̃ píngi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kína ke è zĩ̀ ble a zĩ̀kpɛ parikɛɛ yãnziro,","poem":1},{"lineBreak":true},{"text":"zĩ̀kari ke è bↄ a gↄ̃sagbãakɛ yãnziro.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sↄ̃ náanɛkɛna à ń bↄↄ nɛ́ ɛgɛɛmɛ,","poem":1},{"lineBreak":true},{"text":"baa kↄ̃n à gbãakɛɛo eé fↄ̃ à gbɛ̃ mì síro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dii wɛ́ɛ kú a vĩakɛrinↄa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃ wɛ́ɛ dↄ à yenzizinↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Eé ń bↄ gaa lɛ́zĩ,","poem":1},{"lineBreak":true},{"text":"eé ń gwa dekaagurↄ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wa wɛ́ɛ ègↄ̃ dↄ Diizi,","poem":1},{"lineBreak":true},{"text":"àmbe wa dↄnlɛri ũ kↄ̃n wa sɛngbangoo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Zaakɛ Diin wa pↄↄ ègↄ̃ nnaa,","poem":1},{"lineBreak":true},{"text":"wá à tↄ́ kɛ̀ kú adona náanɛ vĩ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dii, ǹ tó n yenzi gↄ̃ kúwao","poem":1},{"lineBreak":true},{"text":"lán wa wɛ́ɛ dↄnzi nà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}