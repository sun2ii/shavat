{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":34,"content":[{"type":"heading","content":["Dii maakɛna"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kɛ̀ Dauda dà gurↄↄ kɛ̀ à a zĩnda dìɛ ĩadee ũ Abimɛlɛki aɛ, ai Abimɛlɛki pɛ̀a à tà."]},{"type":"verse","number":1,"content":[{"text":"Mɛ́gↄ̃ Dii tↄ́ sɛ́ɛ lezĩ gurↄ yãana sai,","poem":1},{"lineBreak":true},{"text":"mɛ́gↄ̃ à tↄ́ kpaa lán guu e dↄↄ nà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɛ́gↄ̃ ĩa dãa Dii yã musu,","poem":1},{"lineBreak":true},{"text":"takaasideenↄ é ma aↄ̃ pↄnnaa kɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À bítakɛɛ dↄ̃ Diinɛmao,","poem":1},{"lineBreak":true},{"text":"à tó wà à tↄ́ bↄ lɛdo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ma Dii kii wɛ̀tɛ, ben à wèmala,","poem":1},{"lineBreak":true},{"text":"à ma bↄ ma vĩanↄ guu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃ wɛ́ɛ dↄzinↄ uu égↄ̃ werena,","poem":1},{"lineBreak":true},{"text":"wí é gɛ̃ ń wɛ́ɛn zikiro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Takaasidee kɛ̀ Dii sìsi, ben à wèàla,","poem":1},{"lineBreak":true},{"text":"à à bↄ̀ à nawɛ̃anↄ guu píngi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii Malaika ègↄ̃ kú à vĩakɛrinↄ saɛ,","poem":1},{"lineBreak":true},{"text":"è ń mì sí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"À dã à gwa, é e kɛ̀ Dii nna,","poem":1},{"lineBreak":true},{"text":"aubarikadeen gbɛ̃ kɛ̀ nàzi ũ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii gbɛ̃nↄ, à vĩa kɛnɛ,","poem":1},{"lineBreak":true},{"text":"pↄ́ke è kɛ̃sã à vĩakɛrinↄaro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nↄaa è músunↄ dɛ, pↄ́blee è kɛ̃sãḿma,","poem":1},{"lineBreak":true},{"text":"mↄde pↄ́ maa ke è kɛ̃sã Dii kii wɛ̀tɛrinↄaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gbɛ̃nↄ, à mↄ́ à ma yã ma,","poem":1},{"lineBreak":true},{"text":"mà vĩakɛna Diinɛ dadaare.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Amↄa kɛ̀ á yezi a wɛ̃̀ndi gↄ̃ maa","poem":1},{"lineBreak":true},{"text":"bensↄ̃ á yezi a kuuna gↄ̃ nna,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"à a lɛ́ kũ kↄ̃n yãzaa'onao,","poem":1},{"lineBreak":true},{"text":"àton tó ɛgɛɛ bↄ a lɛ́nlo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À kpɛɛ li à zaaanɛ à à maaa kɛ,","poem":1},{"lineBreak":true},{"text":"à aafia zɛ́ wɛtɛ àgↄ̃ tɛ́zi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dii ègↄ̃ gbɛ̃ maaanↄ tàasi kɛɛ,","poem":1},{"lineBreak":true},{"text":"è swã kpá ń wiipɛnazi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Dii è mìkpɛɛ zu zaakɛrinↄnɛ,","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃ yã tón dↄ gbɛ̃kenlo yãnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tó gbɛ̃ maaanↄ lɛ́ zù Diizi, è ma,","poem":1},{"lineBreak":true},{"text":"è ń bↄ ń nawɛ̃anↄ guu píngi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Dii kĩi kↄ̃n gbɛ̃ kɛ̀ aↄ̃ pↄↄ yàkanↄ,","poem":1},{"lineBreak":true},{"text":"è dↄ gbɛ̃ kɛ̀ aↄ̃ uu sisinanↄlɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wahaa ègↄ̃ gbɛ̃ maaa lee gɛ̃̀n baaagↄ̃,","poem":1},{"lineBreak":true},{"text":"mↄde Dii è à bↄ à guu píngi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"È à wánↄ dãkpa píngi,","poem":1},{"lineBreak":true},{"text":"à ke è ɛ́ro, baa mɛ̀n do.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kisia é gbɛ̃ zaaanↄ dɛdɛ,","poem":1},{"lineBreak":true},{"text":"yã é vɛ̃ɛ gbɛ̃ maaa ibɛɛnↄa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dii è a zↄ̀blerinↄ mì sí,","poem":1},{"lineBreak":true},{"text":"yã é vɛ̃ɛ gbɛ̃ kɛ̀ naziaro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}