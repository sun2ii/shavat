{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":36,"content":[{"type":"heading","content":["Gbɛ̃ntee zaaa"]},{"type":"hebrew_subtitle","content":["Dii zↄ̀bleri Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Gbɛ̃ zaaa durun yã da ma swɛ̃̀n,","poem":1},{"lineBreak":true},{"text":"à wɛ́ɛ ègↄ̃ Luda wí vĩro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zaakɛ ègↄ̃ a zĩnda ee gbɛ̃ maaa ũmɛ,","poem":1},{"lineBreak":true},{"text":"è a durun dↄ̃ gbasa à zanlo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɛgɛ kↄ̃n mↄnafikio kú à lɛ́n,","poem":1},{"lineBreak":true},{"text":"à ↄ̃ndↄ̃ kↄ̃n maakɛnao tò.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"È yã zaaa laasuu lɛ́ a daɛkiia,","poem":1},{"lineBreak":true},{"text":"è gí yã pãsĩziro,","poem":1},{"lineBreak":true},{"text":"è a zĩnda da zɛ́ faasaideea.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii, n yenzi bíta kà ludambɛ,","poem":1},{"lineBreak":true},{"text":"ń náanɛ vĩ maamaa, à zↄ̃̀ sↄsↄnɛnↄa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N maakɛna bíta lán kpiiinↄ bà,","poem":1},{"lineBreak":true},{"text":"n yãzɛdekɛ lɛ́ vĩro lán ísia lↄ̀ bà.","poem":1},{"lineBreak":true},{"text":"Dii, nɛɛ̀ gbɛ̃nteenↄ kↄ̃n nↄ̀bↄnↄ bↄ píngi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Luda, n yenzi bɛ̀ɛ vĩ fá,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nteenↄ è utɛ n ↄru.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aↄ̃è n ua pↄ́ble nↄ́sidee ble wà kã,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ n swa'i pↄnnade kpáḿma aↄ̃ mi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Zaakɛ ḿbe wɛ̃̀ndibↄkii ũ,","poem":1},{"lineBreak":true},{"text":"wa kuuna n gupuraan bé à wa wɛ́ɛ kɛ̃̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ǹgↄ̃ yenzi ↄdↄa gbɛ̃ kɛ̀ aↄ̃ↄ n dↄ̃ↄnↄnɛ ǹgↄ̃ gaa,","poem":1},{"lineBreak":true},{"text":"ǹgↄ̃ kpɛɛ ǹgↄ̃ nↄ̀sɛpuradeenↄ mì sii.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹton tó ĩadãrinↄ ma dúgu zↄ̃ro,","poem":1},{"lineBreak":true},{"text":"ǹton tó zaakɛrinↄ ↄ yĩpamaziro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹ gwa, mↄnafikidee pìnↄ lɛ̀ɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ gↄ̃̀ daɛna sↄ̀rↄrↄ, aↄ̃é fↄ̃ wà fɛɛ dↄro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}