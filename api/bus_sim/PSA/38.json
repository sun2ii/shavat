{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":38,"content":[{"type":"heading","content":["Takaasidee aduakɛna"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii, ǹton ma toto kↄ̃n pↄfɛ̃oro,","poem":1},{"lineBreak":true},{"text":"ǹton ma swã sↄ̃kãmɛ kↄ̃n pɛ̃tɛ̃oro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N kànↄ ma papa","poem":1},{"lineBreak":true},{"text":"n ↄ tↄ̃̀ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma mɛ̀ gbãaa yã̀a n pɛ̃tɛ̃ yãnzi,","poem":1},{"lineBreak":true},{"text":"ma wá aafiaro ma durun yãnzi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma taarinↄ dàmala,","poem":1},{"lineBreak":true},{"text":"aↄ̃ tↄ̃̀ma lán aso tìisi bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ma bↄ̀nↄ fↄ̀,","poem":1},{"lineBreak":true},{"text":"aↄ̃ yai kũ̀ ma yↄ̃nkↄkɛɛ yãnzi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Má kuna, ma gↄ̃ zↄ̀lↄlↄ,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀gↄ̃ tɛ́ uuo sisina gurↄ píngi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma kpɛɛwa e wii maamaa,","poem":1},{"lineBreak":true},{"text":"ma mɛ̀ gbãaa vĩro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Má gbãaa vĩro, ma mɛ̀ kɛ̀ búgubugu,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ wii lɛɛ ma pↄyakana yãnzi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dii, ń pↄ́ kɛ̀ má yezi dↄ̃ píngi,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ ma m̀bna ma sãnsãn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma kù e vĩi gbì gbì, ma gbãaa yã̀a,","poem":1},{"lineBreak":true},{"text":"ma uu e tɛ́ kɛɛ dↄro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma gbɛ̃nnanↄ kↄ̃n ma gbɛ̃nↄ è gbɛ̃ɛmɛ,","poem":1},{"lineBreak":true},{"text":"ma danɛnↄ è bàa lɛ́mɛ ma bↄ̀nↄ yãnzi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃ↄ wɛtɛ wà ma dɛnↄ è bà kpákpamɛ,","poem":1},{"lineBreak":true},{"text":"ma wɛdɛrinↄ è yã zaaa kpakↄ̃sↄ̃mazi,","poem":1},{"lineBreak":true},{"text":"aↄ̃ègↄ̃ mↄnafikiyã wàari paa kↄ̃o gurↄ píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ma gↄ̃ lán swãdoo bà, mɛɛ̀ yã maro,","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃ kɛ̀ à nɛ́nɛ nàɛ bà, mɛɛ̀ lɛ́ è wɛ̃kↄ̃aro.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Má dɛ lán gbɛ̃ kɛ̀ è yã maroo bà,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ weńlaro.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dii, ḿbe ma wɛ́ɛ dↄnzi,","poem":1},{"lineBreak":true},{"text":"nɛ́ ma yã ma, Dii ma Luda.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ma bè, ǹton tó aↄ̃ yↄ̃̀gↄ̃ kɛmaro,","poem":1},{"lineBreak":true},{"text":"ǹton tó aↄ̃ ĩa dã ma satana yãnziro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ma ka lɛɛna,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀gↄ̃ kú yã'ↄ̃amma guumɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Mɛ́ ma yã zaaanↄ onnɛ sa,","poem":1},{"lineBreak":true},{"text":"zaakɛ ma durun yãnzin ma pↄↄ yakanazi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ma ibɛɛ pãsĩnↄↄ lɛ́ vĩro,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃ zàmagu pãpãanↄↄ pari.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aↄ̃è à maaa fĩa bomɛ kↄ̃n à zaaao,","poem":1},{"lineBreak":true},{"text":"yã maaan má tɛ́zi, ben aↄ̃ íbɛtɛ kpàmao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Dii, ǹton ma zĩnnaro,","poem":1},{"lineBreak":true},{"text":"ma Luda, ǹtongↄ̃ kúmao zã̀ro.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ǹ mↄ́ ǹ dↄmalɛ kpakpaa,","poem":1},{"lineBreak":true},{"text":"ma Dii, ma mìsiri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}