{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":39,"content":[{"type":"heading","content":["Takaaside wiipɛna Ludazi"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Ma bè, mɛ́gↄ̃ ma zĩnda kũna dↄ̃,","poem":1},{"lineBreak":true},{"text":"mɛ́ tó ma lɛ́ ma da durunkɛna guuro.","poem":1},{"lineBreak":true},{"text":"Tó gbɛ̃ zaaa kúmao, mɛ́ ma lɛ́ kũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma lɛ́ nakↄ̃a, ma yĩ kítikiti,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ yãke oro, baa yã maaa se,","poem":1},{"lineBreak":true},{"text":"ben ma yã'ↄ̃amma sↄ̀kpa à kàara.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ma swɛ̃̀ puusu bↄ̀ ma guu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ ma laasuu lɛ̀, ma swɛ̃̀ tɛ́ bↄ̀,","poem":1},{"lineBreak":true},{"text":"ben ma lɛ́ bↄ̀ ma bè:","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dii, ǹ tó màgↄ̃ ma wɛ̃̀ndigurↄ lɛ́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"kↄ̃n ma gurↄ pari zaka lɛ́o.","poem":1},{"lineBreak":true},{"text":"Ǹ tó màgↄ̃ dↄ̃ lán ma wɛ̃̀ndi é gɛ̃ zɛ́la nà kãndo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N ma wɛ̃̀ndi lɛ́ yↄ̃̀ n ↄla zakan,","poem":1},{"lineBreak":true},{"text":"ma kuuna dɛ wɛ́ɛ kↄ̃n yĩola n kiiaro.","poem":1},{"lineBreak":true},{"text":"Baade píngi è gɛ̃ zɛ́la lán ĩa bàmɛ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"gbɛ̃ntee tɛna ègↄ̃ dɛ lán ↄra bàmɛ.","poem":1},{"lineBreak":true},{"text":"È bãabãa bo à auziki kakↄ̃a,","poem":1},{"lineBreak":true},{"text":"mↄde à dↄ̃ tó dén eé gↄ̃nɛro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tó lɛmɛ, bↄ́ tãmaan mɛ́gↄ̃ vĩi?","poem":1},{"lineBreak":true},{"text":"Ḿbe ma wɛ́ɛ dↄnzi, Dii.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ ma taarinↄ kɛ̃mɛ,","poem":1},{"lineBreak":true},{"text":"ǹton tó yↄ̃nkↄↄnↄ ma faboro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ma lɛ́ nakↄ̃ana, mɛ́ɛ ma lɛ́ wɛ̃kↄ̃aro,","poem":1},{"lineBreak":true},{"text":"zaakɛ ḿbe n yã beee kɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ǹton ma lɛ́ dↄro,","poem":1},{"lineBreak":true},{"text":"ma gbãsĩ lɛ̀ n ↄkũ yãnzi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ gbɛ̃ toto nɛɛ̀ wɛ́ɛ tãa à durun yãnzi,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ à auziki yaka lán blɛ́ bà.","poem":1},{"lineBreak":true},{"text":"Baade píngi è gɛ̃ zɛ́la lán ĩa bàmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ǹ ma aduakɛna sí Dii,","poem":1},{"lineBreak":true},{"text":"ǹ swã kpá ma wiipɛnazi.","poem":1},{"lineBreak":true},{"text":"Ǹton ma ↄ́ↄdↄna kpá swãkotoro,","poem":1},{"lineBreak":true},{"text":"zaakɛ n nibↄn ma ũ,","poem":1},{"lineBreak":true},{"text":"má dɛ gbɛ̃ zĩ̀tↄ ũ lán ma dezinↄ bà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ǹ uu goma lɛ ma pↄↄ e àgↄ̃ nna dↄ,","poem":1},{"lineBreak":true},{"text":"ai màgↄ̃ gá anduna tó.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}