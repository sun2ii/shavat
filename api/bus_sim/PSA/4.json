{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":4,"content":[{"type":"heading","content":["Uusiɛ aduakɛna"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀. Wè sí kↄ̃n mↄrↄlɛnaomɛ."]},{"type":"verse","number":1,"content":[{"text":"Tó ma n sisi, ǹ wemala Luda ma zɛnyode,","poem":1},{"lineBreak":true},{"text":"tó má kú nawɛ̃a guu, ǹ ma gba mɛ̀porokii,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ̃nda gwa ǹ ma aduakɛna sí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gbɛ̃nↄ, é gí àgↄ̃ wí daa ma Luda Gakuidea ai bↄrɛmɛ?","poem":1},{"lineBreak":true},{"text":"Égↄ̃ ye pↄ́ pãanↄzi àgↄ̃ tɛ́ tãanↄzin yↄ́?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Àgↄ̃ dↄ̃ kɛ̀ Dii a gbɛ̃nↄ dìɛ ńdona,","poem":1},{"lineBreak":true},{"text":"tó ma à sìsi, eé ma yã ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tó a pↄ fɛ̃̀, àton durun kɛro,","poem":1},{"lineBreak":true},{"text":"à laasuu lɛ́ a daɛbↄ musu à yĩtɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"À saa kɛ̀ dɛ à oo o,","poem":1},{"lineBreak":true},{"text":"à Dii náanɛ kɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gbɛ̃ paridee è be: Dé bé eé yã maaa kɛwee?","poem":1},{"lineBreak":true},{"text":"Ǹ uu werewa, Dii, ǹ aubarika dawagu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Baa tó pↄ́wɛɛ kↄ̃n wɛ̃ɛo dińzi,","poem":1},{"lineBreak":true},{"text":"pↄnnaa kɛ̀ ń dàmɛ ma swɛ̃̀n dɛ ń pↄ́la.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɛɛ̀ daɛ mà ii o nnanna,","poem":1},{"lineBreak":true},{"text":"zaakɛ Dii, ḿbe nɛɛ̀ tó màgↄ̃ kú ma làakaria.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}