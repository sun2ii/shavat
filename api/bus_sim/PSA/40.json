{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":40,"content":[{"type":"heading","content":["Dii sáabukpana"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Ma wɛ́ɛ dↄ̀ Diizi maamaa,","poem":1},{"lineBreak":true},{"text":"ben à aɛ dↄ̀ma à ma wiipɛna mà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À ma bↄ kokotɛ̃wɛɛn,","poem":1},{"lineBreak":true},{"text":"à ma bↄ foo guu.","poem":1},{"lineBreak":true},{"text":"À ma gbá pɛ̀ɛ gbɛ̀si musu,","poem":1},{"lineBreak":true},{"text":"à ma zɛ gwe gíngin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À lɛ̀ dufu dàmɛ ma lɛ́n,","poem":1},{"lineBreak":true},{"text":"wa Luda sáabukpana pↄ́ ũ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃nↄ é e pari, vĩa é ń kũ,","poem":1},{"lineBreak":true},{"text":"aↄ̃é Dii náanɛ kɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aubarikadeen gbɛ̃ kɛ̀ Dii náanɛ vĩi ũ,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ è aɛ dↄ ĩadãrinↄ kↄ̃n tãagbãgbãrinↄaro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii ma Luda, n yãbↄnsaɛkɛnanↄↄ pari,","poem":1},{"lineBreak":true},{"text":"weé fↄ̃ wà yã kɛ̀ nɛ́ɛ pɛɛawee dↄdↄro.","poem":1},{"lineBreak":true},{"text":"Tó mɛ́ɛ tↄ̃kɛ̃ɛnnɛ, à lɛ́ vĩro,","poem":1},{"lineBreak":true},{"text":"mɛ́ fↄ̃ mà o píngiro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ń ye sa'opↄ ke gbaaziro,","poem":1},{"lineBreak":true},{"text":"ben n ma gba swã mà yã mao.","poem":1},{"lineBreak":true},{"text":"Nɛ́ɛ sa'opↄ kɛ̀ wè ká tɛ́n à tɛ́ kũ","poem":1},{"lineBreak":true},{"text":"ke durun agbaakpabↄ gbekaro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ben ma bè: Maɛ kɛ̀,","poem":1},{"lineBreak":true},{"text":"ma mↄ lán wà kɛ̃̀ takadan ma yã musu nà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Má ye n pↄyezi kɛmɛ, ma Luda,","poem":1},{"lineBreak":true},{"text":"n doka kú ma swɛ̃̀ guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mɛ́ yãzɛdee baaru kpá pari kakↄ̃ana guu,","poem":1},{"lineBreak":true},{"text":"mɛ́ ma lɛ́ nakↄ̃aro, lán ń dↄ̃ nà Dii.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mɛ́ɛ n yãzɛdee utɛńnɛro,","poem":1},{"lineBreak":true},{"text":"ma n náanɛ kↄ̃n n mìsinao yã ò.","poem":1},{"lineBreak":true},{"text":"Mɛ́ɛ gí n yenzi kↄ̃n n yãpuraao o","poem":1},{"lineBreak":true},{"text":"pari kakↄ̃ana guuziro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dii, ǹton gí ma wɛ̃nda gwaziro,","poem":1},{"lineBreak":true},{"text":"n yenzi kↄ̃n n yãpuraao gↄ̃ ma dãkpaa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zaakɛ yã zaaa kɛ̀ liganamazi lɛ́ vĩro,","poem":1},{"lineBreak":true},{"text":"ma taarinↄ dàmala, mɛ́ɛ guu eero,","poem":1},{"lineBreak":true},{"text":"à pari dɛ ma mìkãla, swɛ̃̀ kɛ̃̀magu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dii, ǹ sùu kɛ ǹ ma mì sí,","poem":1},{"lineBreak":true},{"text":"Dii, ǹ kɛ kpakpaa ǹ mↄ́ ǹ dↄmalɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹ tó wí gbɛ̃ kɛ̀ aↄ̃ↄe ma wɛɛ wà ma dɛɛnↄ kũ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ ń mì pɛ́ɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ tó gbɛ̃ kɛ̀ aↄ̃ↄ yezi mà mↄ́nzi eenↄ kpɛɛ li,","poem":1},{"lineBreak":true},{"text":"aↄ̃ uu yãkↄ̃tɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃è bemɛ taalɛ taalɛɛnↄ,","poem":1},{"lineBreak":true},{"text":"ǹ tó wí ń kũ aↄ̃ kɛ gìri.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃ↄe n kii wɛtɛɛnↄ,","poem":1},{"lineBreak":true},{"text":"ǹ tó aↄ̃ pↄↄ kɛmma nna aↄ̃ yáa dↄ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃ↄ ye n mìsinazinↄ","poem":1},{"lineBreak":true},{"text":"gↄ̃ bee Dii bíta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Takaaside wɛ̃ndadeen ma ũ,","poem":1},{"lineBreak":true},{"text":"ǹ laasuu lɛ́ ma yãzi, Dii.","poem":1},{"lineBreak":true},{"text":"Ḿbe ma dↄnlɛri ũ kↄ̃n ma mìsirio,","poem":1},{"lineBreak":true},{"text":"ma Luda, ǹton gì kɛro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}