{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":41,"content":[{"type":"heading","content":["Gyãree aduakɛna"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Aubarikadeen gbɛ̃ kɛ̀ è gbãasaide yã daa ũ,","poem":1},{"lineBreak":true},{"text":"Dii è à bↄ nawɛ̃akɛgurↄ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii é à dãkpa à à gba wɛ̃̀ndi gbã̀a,","poem":1},{"lineBreak":true},{"text":"eé aubarika dan a bùsun,","poem":1},{"lineBreak":true},{"text":"eé à na à ibɛɛnↄ ↄzĩ aↄ̃ ń pↄyezi kɛaro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii é à dãkpa à gyãpɛa,","poem":1},{"lineBreak":true},{"text":"eé tó à a gyãa pì ble.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ma bè: Dii, ma durun kɛ̀nnɛ,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ̃nda gwa ǹ ma gba aafia.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma ibɛɛnↄ è ma kpákpa gaao wà be:","poem":1},{"lineBreak":true},{"text":"Bↄrɛn eé ga lɛ à tↄ́ kaatɛɛ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó aↄ̃ mↄ̀ ma gwa,","poem":1},{"lineBreak":true},{"text":"ɛgɛyãn aↄ̃è omɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è baaru zaaa wɛtɛ ma yã musu,","poem":1},{"lineBreak":true},{"text":"ben aↄ̃è fɛɛ wà gá wàgↄ̃ yã pì fãa bàazi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma zangurinↄ è ma kpákpa à zaaao,","poem":1},{"lineBreak":true},{"text":"aↄ̃ píngi aↄ̃è àisi zaaa kpámazi wà be:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gagyãa bé à à lè,","poem":1},{"lineBreak":true},{"text":"eé fɛɛ a daɛkiia dↄro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Baa ma gbɛ̃nna kɛ̀ ma à náanɛ kɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ weè ↄ kakↄ̃a ta dↄ̃nkↄ̃ guu bↄ̀ ma kpɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mmↄn sↄ̃ Dii, ǹ ma wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"ǹ ma gba aafia lɛ mà fĩa bońnɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tó ma ibɛɛnↄↄ e ma yↄ̃̀gↄ̃ kɛmaro,","poem":1},{"lineBreak":true},{"text":"mɛ́gↄ̃ dↄ̃ sa kɛ̀ ma yã kànnɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ń ma kũna ma nↄ̀sɛ maaa yãnzi,","poem":1},{"lineBreak":true},{"text":"ń tò màgↄ̃ kú n aɛzĩ gurↄ píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Aubarikade Dii, Isarailinↄ Luda","poem":1},{"lineBreak":true},{"text":"zaa káaku ai gurↄ píngi!","poem":1},{"lineBreak":true},{"text":"Aami! Aami!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}