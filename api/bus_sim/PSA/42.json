{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":42,"content":[{"type":"heading","content":["Zĩ̀zↄ ↄ́ↄdↄna"]},{"type":"hebrew_subtitle","content":["Kora boriinↄ lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Lán zↄ̃ ègↄ̃ swasaɛ ni dɛɛ nà,","poem":1},{"lineBreak":true},{"text":"lɛn n nii kú ma swɛ̃̀n lɛ, Luda.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma ninii e Luda ni dɛɛ, Luda Wɛ̃̀ndide pì,","poem":1},{"lineBreak":true},{"text":"bↄrɛn mɛ́ e mà gá wɛ́ɛ siàlɛɛ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wɛ́ɛ'i bé à gↄ̃̀ ma pↄ́blee ũ","poem":1},{"lineBreak":true},{"text":"fãantɛ̃ kↄ̃n gwãavĩo.","poem":1},{"lineBreak":true},{"text":"Wègↄ̃ beemɛ gurↄ píngi:","poem":1},{"lineBreak":true},{"text":"N Ludaa kú mámɛee?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ma nↄ̀sɛ wɛ̃̀nnɛ, ben yã kɛ̀kiinↄ dↄ̀magu,","poem":1},{"lineBreak":true},{"text":"lán mɛɛ̀ gá parii guu nà ai Luda ua,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nↄ ègↄ̃ tɛ́tɛ ma kpɛɛ kↄ̃n gudakɛnao,","poem":1},{"lineBreak":true},{"text":"zĩbaakɛrinↄ ègↄ̃ tɛ́ ma kpɛɛ kↄ̃n sáabukpanao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bↄ́yãnzin ma nↄ̀sɛ yàkazi?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dia ma làakari fɛ̀ɛɛ?","poem":1},{"lineBreak":true},{"text":"Séde màgↄ̃ wɛ́ɛ dↄↄ Ludazi,","poem":1},{"lineBreak":true},{"text":"zaakɛ mɛ́ ɛara màgↄ̃ à sáabu kpaa,","poem":1},{"lineBreak":true},{"text":"ma Mìsiri, ma Luda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma nↄ̀sɛ yàka, ben n yã dↄ̀magu","poem":1},{"lineBreak":true},{"text":"zaa Miza kpiigɛɛzi ai Yoda mìa,","poem":1},{"lineBreak":true},{"text":"zaa Ɛmↄni gbɛ̀nↄ musu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ tó ísↄ̃pɛɛna kĩi gↄ̃ dↄ,","poem":1},{"lineBreak":true},{"text":"í lↄ̀nↄↄ e lɛ́ zuukↄ̃zi.","poem":1},{"lineBreak":true},{"text":"Ń tò í e daamala,","poem":1},{"lineBreak":true},{"text":"à sↄ̃ e taamao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii è yenzi ↄdↄamɛ fãantɛ̃,","poem":1},{"lineBreak":true},{"text":"à lɛ̀ ègↄ̃ da ma lɛ́n gwãavĩ,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ wɛ́ɛ kɛɛ Luda kɛ̀ dɛ ma wɛ̃̀ndi ũua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mɛɛ̀ be Luda ma gbɛ̀sinɛ:","poem":1},{"lineBreak":true},{"text":"Bↄ́yãnzin ma yã sã̀nguzi?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dia ń tò màgↄ̃ tɛ́ kↄ̃n pↄsiaao","poem":1},{"lineBreak":true},{"text":"ma ibɛɛ wɛ́ɛtãmma yãnzii?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ma ĩadammarinↄ è ma sↄ̃sↄ̃,","poem":1},{"lineBreak":true},{"text":"beee yãnzi ma wánↄ ègↄ̃ wii,","poem":1},{"lineBreak":true},{"text":"aↄ̃ègↄ̃ beemɛ gurↄ píngi:","poem":1},{"lineBreak":true},{"text":"N Ludaa kú mámɛee?","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bↄ́yãnzin ma nↄ̀sɛ yàkazi?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dia ma làakari fɛ̀ɛɛ?","poem":1},{"lineBreak":true},{"text":"Séde màgↄ̃ wɛ́ɛ dↄↄ Ludazi,","poem":1},{"lineBreak":true},{"text":"zaakɛ mɛ́ ɛara màgↄ̃ à sáabu kpaa,","poem":1},{"lineBreak":true},{"text":"ma Mìsiri, ma Luda.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}