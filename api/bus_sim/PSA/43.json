lineBreak":true},{"text":"mɛ́ n tↄ́ kpá kↄ̃n mↄrↄo,","poem":1},{"lineBreak":true},{"text":"Luda ma Luda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bↄ́yãnzin ma nↄ̀sɛ yàkazi?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dia ma làakari fɛ̀ɛɛ?","poem":1},{"lineBreak":true},{"text":"Mɛ́gↄ̃ wɛ́ɛ dↄ Ludazi,","poem":1},{"lineBreak":true},{"text":"zaakɛ mɛ́ ɛara màgↄ̃ à sáabu kpaamɛ,","poem":1},{"lineBreak":true},{"text":"ma Mìsiri, ma Luda.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}