{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":44,"content":[{"type":"heading","content":["Isarailinↄ faaba wɛ́ɛkɛna"]},{"type":"hebrew_subtitle","content":["Kora boriinↄ lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Luda, yã kɛ̀ ń kɛ̀ zaa gìkɛna wa dezinↄ gurↄ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ òwe wa swã mà.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N ↄ yĩ̀pa bori pãndenↄzi n ĩa dàḿma,","poem":1},{"lineBreak":true},{"text":"n wa dezinↄ kàɛ ń gbɛ̀n,","poem":1},{"lineBreak":true},{"text":"n ń kaara aↄ̃ dàgula.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aↄ̃ fɛ̃ɛdaa bé à ń ká bùsu kɛ̀aro,","poem":1},{"lineBreak":true},{"text":"aↄ̃ gã̀sã gbãaan aↄ̃ zĩ̀ blèoro.","poem":1},{"lineBreak":true},{"text":"N zĩnda gã̀sã gbãaa bé à tò,","poem":1},{"lineBreak":true},{"text":"n aɛ dↄ̀ḿma kɛ̀ ń yeńzi yãnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ḿbe ma Kína ũ ma Luda,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ tó Yakubu boriinↄ zĩ̀ ble.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N gãzĩn weè ↄ yĩpa wa ibɛɛnↄzi,","poem":1},{"lineBreak":true},{"text":"kↄ̃n n tↄ́on weè wa zangurinↄ dúgu zↄ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Èe kɛ má sá náanɛkɛnanlo,","poem":1},{"lineBreak":true},{"text":"èe kɛ ma fɛ̃ɛdaa bé è ma bↄro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zaakɛ ḿbe nɛɛ̀ wa sí wa ibɛɛnↄa,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ wí da wa zangurinↄa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Luda, weègↄ̃ n sáabu kpaa gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"weègↄ̃ n tↄ́ kpaa yãana sai.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Baa kↄ̃n beeeo n giwazi ń tò wí wa kũ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ bↄ kↄ̃n wa zĩ̀kpɛɛnↄ dↄro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ń tò wa bↄru kpɛɛ wa ibɛɛnↄnɛ,","poem":1},{"lineBreak":true},{"text":"ń tò wa zangurinↄ wa pↄ́nↄ nàkↄ̃a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ń gbá zɛ́ aↄ̃ wa dɛdɛ lán sãanↄ bà,","poem":1},{"lineBreak":true},{"text":"n wa fãakↄ̃a boriinↄ tɛ́.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N n gbɛ̃nↄ yà aaga,","poem":1},{"lineBreak":true},{"text":"nɛ́ɛ àre e à guuro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ń tò wa gbɛ̃daaanↄ wa sↄ̃sↄ̃,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃ↄ kú wa saɛnↄ wa lalandi kɛ̀.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ń tò wa gↄ̃ pena pↄ́ ũ boriinↄnɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃nↄ è ń mì kɛ degũdegũ wa yãnzi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mɛɛ̀gↄ̃ kú kↄ̃n wíyão gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"wí ègↄ̃ kú ma wɛ́ɛn","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ma faborinↄ kↄ̃n ma sↄ̃̀sↄ̃rinↄ yãnzi","poem":1},{"lineBreak":true},{"text":"kↄ̃n ma ibɛɛ kɛ̀ aↄ̃ↄ yezi wà gɛ̃ɛ bomaanↄ yão.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Beee wa le píngi,","poem":1},{"lineBreak":true},{"text":"baa kɛ̀ n yã e sãwaguro,","poem":1},{"lineBreak":true},{"text":"wée n bà kuunawao yã gbororo.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wa laasuu e kɛ̃mmaro,","poem":1},{"lineBreak":true},{"text":"wée kɛ̃ n zɛ́aro.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N wa wiwi,","poem":1},{"lineBreak":true},{"text":"n wa bùsu kɛ̀ gbɛ̃ngboonↄ tɛ́kii ũ,","poem":1},{"lineBreak":true},{"text":"n gusia níginigi dàwala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tó wa Dii tↄ́ sã̀wagu yã,","poem":1},{"lineBreak":true},{"text":"ke tó wa wɛ́ɛ dↄ̀ bori zĩ̀tↄnↄ tãazi,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Luda é gí eziↄ́?","poem":1},{"lineBreak":true},{"text":"Zaakɛ àmbe à wa nↄ̀sɛguuyãnↄ dↄ̃ píngi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"N yãnzi wá kú gaa lɛ́zĩzi zaa kↄngↄ ai uusiɛ,","poem":1},{"lineBreak":true},{"text":"wè wa diɛ lán sãa kɛ̀ weé ń kòto kpánↄ bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ǹ vu Dii! À kɛ̀ dia nɛ́ɛ ii oo?","poem":1},{"lineBreak":true},{"text":"Ǹ fɛɛ! Ǹton gíwazi gurↄ píngiro.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"À kɛ̀ dia n mìkpɛɛ zùwee?","poem":1},{"lineBreak":true},{"text":"Wa wɛ̃ndakɛ kↄ̃n gbãaa kɛ̀ wèe mↄↄweeo sã̀ngun yↄ́?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Wa gↄ̃ yina bùsutin,","poem":1},{"lineBreak":true},{"text":"wa gↄ̃ daɛna tↄↄtɛ.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ǹ fɛɛ ǹ dↄwalɛ,","poem":1},{"lineBreak":true},{"text":"ǹ mↄ́ ǹ wa bo n yenzi yãnzi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}