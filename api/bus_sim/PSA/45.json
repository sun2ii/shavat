{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":45,"content":[{"type":"heading","content":["Kína nↄsɛna lɛ̀"]},{"type":"hebrew_subtitle","content":["Yenzi lɛ̀ kɛ̀ Kora boriinↄↄ dà."]},{"type":"verse","number":1,"content":[{"text":"Yã nnaa e pipii ma swɛ̃̀ guu,","poem":1},{"lineBreak":true},{"text":"lán mɛ́ɛ lɛ̀ kɛ̀kii daa kínanɛ nà.","poem":1},{"lineBreak":true},{"text":"Ma lɛ́ nna lán takadakɛ̃ri lákɛ̃bↄ bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"N maakɛɛ dɛ gbɛ̃ píngila,","poem":1},{"lineBreak":true},{"text":"n lɛ́gbɛ ègↄ̃ nna,","poem":1},{"lineBreak":true},{"text":"aubarika kɛ̀ Ludaa dànguu yãana vĩro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N zĩ̀kari pãsĩ, ǹ n fɛ̃ɛdaa sɛ́ ǹ logo","poem":1},{"lineBreak":true},{"text":"n kíkɛgakui sèeda ũ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ǹ di sↄ̃a ǹ gá zĩ̀ ble n gakuikɛɛ guu","poem":1},{"lineBreak":true},{"text":"yãpura kↄ̃n nↄ̀sɛdooo kↄ̃n yãzɛdeeo yãnzi,","poem":1},{"lineBreak":true},{"text":"ǹ yã naasideenↄ kɛ kↄ̃n n ↄplaa gbãaao.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kí, n kànↄ lɛ́ sↄ̃ntɛ,","poem":1},{"lineBreak":true},{"text":"è gɛ̃ à n ibɛɛnↄ swɛ̃̀ zↄ̃,","poem":1},{"lineBreak":true},{"text":"boriinↄ è lɛ́ɛ n gbá saɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Luda, nɛ́gↄ̃ vɛ̃ɛna kpatan gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"nɛ́gↄ̃ n kíkɛgo kũna yãzɛdee ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ń ye yãmaakɛnazi, n za yãzaakɛnan.","poem":1},{"lineBreak":true},{"text":"Beee yãnzi Luda, n Luda, n ka kpatan,","poem":1},{"lineBreak":true},{"text":"à pↄnnaa pìsimma dɛ n gbɛ̃nↄla.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lí'ↄ gũ nnannaa pìsi n pↄ́kãsãanↄa,","poem":1},{"lineBreak":true},{"text":"mↄrↄ'ↄ è n pↄↄ kɛ nna","poem":1},{"lineBreak":true},{"text":"n kpɛ́ kɛ̀ wà kɛ̀kɛ kↄ̃n wesaswaao guu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kí nɛ́nↄgbɛ̃nↄↄ kú n nↄ yenzideenↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"n nↄ dufu kú n ↄplaazi,","poem":1},{"lineBreak":true},{"text":"à Ofi bùsu vura zãblebↄnↄ dana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nɛ́nↄkparɛ, ǹ swã kpá ǹ ma!","poem":1},{"lineBreak":true},{"text":"N de bɛ kↄ̃n n gbɛ̃nↄ yã tón dↄnnɛ aɛro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N nↄmaakɛɛ e kí mɛ̀ lugaa,","poem":1},{"lineBreak":true},{"text":"ǹ mì siɛnɛ, zaakɛ n diin à ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tayadeenↄ é mↄ́ wà gba dannɛ,","poem":1},{"lineBreak":true},{"text":"auzikideenↄ é n wɛ́ɛ wɛtɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kí nɛ́nↄkparɛ vɛ̃ɛna kpɛ́nɛ guu kↄ̃n gakuio,","poem":1},{"lineBreak":true},{"text":"wà ↄzĩi kɛ̀ à pↄ́kãsãanↄa kↄ̃n vura bào.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wèe suuo kínɛ","poem":1},{"lineBreak":true},{"text":"kↄ̃n à pↄ́kãsã wɛ̃zãdeenↄo dana.","poem":1},{"lineBreak":true},{"text":"Nɛ́nↄkparɛ zɛnnɛrinↄↄ tɛ́zi,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄe suuo à kiia.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wèe gɛ̃ɛńyo kíbɛ,","poem":1},{"lineBreak":true},{"text":"wèe pↄnnaa kɛɛ kↄ̃n gudakɛnao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"N nɛ́gↄ̃gbɛ̃nↄ é gↄ̃ n denↄ gɛ̃ɛ ũ,","poem":1},{"lineBreak":true},{"text":"nɛ́ ń diɛdiɛ kínanↄ ũ anduna guu píngi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mɛ́ tó n tↄ́ gↄ̃ dↄ gbɛ̃nↄn yãana sai,","poem":1},{"lineBreak":true},{"text":"boriinↄ égↄ̃ n sáabu kpaa gurↄ píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}