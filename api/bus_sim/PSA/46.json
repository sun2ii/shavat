{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":46,"content":[{"type":"heading","content":["Ludaa kúwao"]},{"type":"hebrew_subtitle","content":["Kora boriinↄ lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Ludan wa utɛkii ũ kↄ̃n wa gbãaao,","poem":1},{"lineBreak":true},{"text":"ègↄ̃ dↄↄwalɛ gurↄ píngi wa nawɛ̃a guu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Beee yãnzi baa tó anduna yàka","poem":1},{"lineBreak":true},{"text":"bensↄ̃ kpiiinↄ lɛ̀ɛ wà sì ísiaan,","poem":1},{"lineBreak":true},{"text":"baa tó í pì kàka à fùta dↄ̀","poem":1},{"lineBreak":true},{"text":"bensↄ̃ kpiiinↄ dège kↄ̃n kĩio,","poem":1},{"lineBreak":true},{"text":"swɛ̃̀ é kɛ̃waguro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Swa kee kuu kɛ̀ à í è mↄ́ pↄnnaao Luda wɛ́tɛ guu,","poem":1},{"lineBreak":true},{"text":"Luda Musude kúkii kɛ̀ kú adona pì.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ludaa kú wɛ́tɛ pì guu, eé gↄ̃ bɛzĩ ũro,","poem":1},{"lineBreak":true},{"text":"Luda é dↄàlɛ gudↄnao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Boriinↄ e wii lɛɛ, kpatanↄↄ e yãaa,","poem":1},{"lineBreak":true},{"text":"Luda pũ̀tã, ben anduna yↄ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dii Zĩ̀kpɛdee kúwao,","poem":1},{"lineBreak":true},{"text":"Yakubu Ludan wa utɛkii ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À mↄ́ à Dii yãkɛnanↄ gwa,","poem":1},{"lineBreak":true},{"text":"lán à yã yà andunaa nà.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Àmbe è zĩ̀ mì dɛ ai anduna lɛ́n,","poem":1},{"lineBreak":true},{"text":"è sánↄ ɛ́'ɛ è sárinↄ dúgu zↄ̃,","poem":1},{"lineBreak":true},{"text":"è tɛ́ sↄ̃ sɛngbangonↄa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À zɛ tɛɛɛ àgↄ̃ dↄ̃ kɛ̀ mámbe Luda ũ.","poem":1},{"lineBreak":true},{"text":"Boriinↄ é ma tↄ́ sɛ́ lezĩ,","poem":1},{"lineBreak":true},{"text":"weé ma tↄ́ kpá anduna guu píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dii Zĩ̀kpɛdee kúwao,","poem":1},{"lineBreak":true},{"text":"Yakubu Ludan wa utɛkii ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":10}