{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":47,"content":[{"type":"heading","content":["Ludan anduna píngi kína ũ"]},{"type":"hebrew_subtitle","content":["Kora boriinↄ lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Bori píngi, à ↄpa lɛ́,","poem":1},{"lineBreak":true},{"text":"à pↄnna wii lɛ́ Ludanɛ kↄ̃n gudao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Zaakɛ Dii Musude naasi vĩ,","poem":1},{"lineBreak":true},{"text":"àmbe anduna píngi Kína bíta ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À tò wa zĩ̀ blè boriinↄa,","poem":1},{"lineBreak":true},{"text":"à tò wa ↄ̃ tↄ̃̀ gbɛ̃nↄa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À wa tↄↄtɛ baka kpàwá,","poem":1},{"lineBreak":true},{"text":"à yenzide Yakubu boriinↄ ĩadãbↄ ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Luda fɛ̀ɛ, wèe guda kɛɛ,","poem":1},{"lineBreak":true},{"text":"Dii zɛna, wèe kãkãki pɛɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À lɛ̀ sí Ludanɛ, à lɛ̀ sínɛ,","poem":1},{"lineBreak":true},{"text":"à lɛ̀ sí wa Kínanɛ, à lɛ̀ sínɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Zaakɛ anduna píngi Kínan à ũ,","poem":1},{"lineBreak":true},{"text":"à lɛ̀ sínɛ kↄ̃n dↄ̃nao.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ludaa e kí blee boriinↄa,","poem":1},{"lineBreak":true},{"text":"à vɛ̃ɛna a kpata kɛ̀ kú adonaa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Boriinↄ kpatablerinↄↄ e kↄ̃ kaakↄ̃a","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃ↄ dɛ Ibraĩ Luda gbɛ̃nↄ ũ,","poem":1},{"lineBreak":true},{"text":"zaakɛ anduna kínanↄ nɛ́ Luda pↄ́mɛ.","poem":1},{"lineBreak":true},{"text":"À dɛńla ń píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}