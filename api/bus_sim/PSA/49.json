{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":49,"content":[{"type":"heading","content":["Auziki náanɛkɛna nɛ́ mìsaiyãmɛ"]},{"type":"hebrew_subtitle","content":["Kora boriinↄ lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Bori píngi, à yã kɛ̀kii ma,","poem":1},{"lineBreak":true},{"text":"anduna píngi, à swã kpá,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kínanↄ kↄ̃n talakanↄ,","poem":1},{"lineBreak":true},{"text":"auzikideenↄ kↄ̃n takaasideenↄ a píngi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ɔ̃ndↄ̃yã kú ma lɛ́n,","poem":1},{"lineBreak":true},{"text":"dↄ̃na kú ma swɛ̃̀n.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɛ́ swã dↄ yáasi yãzi","poem":1},{"lineBreak":true},{"text":"mà à bↄkↄ̃tɛ kɛ kↄ̃n mↄrↄlɛnao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mɛ́ vĩa kɛ yã pãsĩ gurↄↄnɛro,","poem":1},{"lineBreak":true},{"text":"baa tó ma zangurinↄ ligamazi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aↄ̃ ń auziki náanɛ vĩ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è ń ↄↄdaa ĩa dã.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃ke é fↄ̃ à gí a gbɛ̃daaanɛ gaa kɛ̀ eé à sɛ́ziro,","poem":1},{"lineBreak":true},{"text":"eé e à pↄ́ke kpá Ludaa à à wɛ̃̀ndi booro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zaakɛ gbɛ̃ wɛ̃̀ndi bona zĩ'ũ,","poem":1},{"lineBreak":true},{"text":"auziki é fↄ̃ à bo zikiro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Eé fↄ̃ à tó àgↄ̃ kuu gurↄ píngiro,","poem":1},{"lineBreak":true},{"text":"eé fↄ̃ à gínɛ àton wɛ́ɛ si gɛ̀wãalɛro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zaakɛ wà dↄ̃ kɛ̀ baa ↄ̃ndↄ̃rinↄ è ga,","poem":1},{"lineBreak":true},{"text":"mìsaideenↄ kↄ̃n yↄ̃nkↄↄnↄ è kaatɛ lɛ se,","poem":1},{"lineBreak":true},{"text":"aↄ̃è ń auziki tó gbɛ̃ pãndenↄnɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Baa kɛ̀ wà ń tↄ́nↄ kpà bùsunↄnɛ yã,","poem":1},{"lineBreak":true},{"text":"aↄ̃ mira égↄ̃ dɛ ń bɛɛ ũmɛ gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"eégↄ̃ ń kúkii ũ ai ń boriia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gbɛ̃ntee kↄ̃n a bɛ̀ɛkɛɛo","poem":1},{"lineBreak":true},{"text":"ègↄ̃ kuu gurↄ píngiro,","poem":1},{"lineBreak":true},{"text":"eé kaatɛ lán nↄ̀bↄnↄ bàmɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mìsaideenↄ yãanan gwe,","poem":1},{"lineBreak":true},{"text":"lɛn à dɛ lɛ dↄ kↄ̃n gbɛ̃ kɛ̀ aↄ̃ↄ tɛ́ ń tuubazinↄ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Aↄ̃é si gɛ̀wãan lán sãanↄ bà,","poem":1},{"lineBreak":true},{"text":"gaa bé eégↄ̃ dɛ ń dã̀ri ũ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ maaanↄ é kí bleḿma ziaa zĩ.","poem":1},{"lineBreak":true},{"text":"Aↄ̃ mɛ̀nↄ é yai kũ miran,","poem":1},{"lineBreak":true},{"text":"gɛ̀wãa bé eégↄ̃ dɛ ń bɛɛ ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mↄde Luda é ma wɛ̃̀ndi sí gɛ̀wãaa","poem":1},{"lineBreak":true},{"text":"à gbãakɛ kpámazi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tó gbɛ̃ e kɛɛ auzikidee ũ","poem":1},{"lineBreak":true},{"text":"bensↄ̃ à bɛ tↄ́ nnaa e kaara,","poem":1},{"lineBreak":true},{"text":"ǹton tó à kɛnnɛ yãke ũro,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"zaakɛ eé e à pↄ́ke sɛ́ à táo a gagurↄro,","poem":1},{"lineBreak":true},{"text":"à auzikinↄ é pɛ́ɛziro.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Baa tó à a zĩnda dↄ̃̀ aubarikadee ũ a wɛ̃̀ndi gurↄ","poem":1},{"lineBreak":true},{"text":"bensↄ̃ wà à sáabu kpà à nnamana yãnzi,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"eé ká a dezinↄlamɛ,","poem":1},{"lineBreak":true},{"text":"eé wɛ́ɛ si gupuraalɛ ziki dↄro.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gbɛ̃ntee kↄ̃n a bɛ̀ɛkɛɛo,","poem":1},{"lineBreak":true},{"text":"tó à wɛ́ɛ e kɛ̃ro,","poem":1},{"lineBreak":true},{"text":"eé gɛ̃tɛ lán nↄ̀bↄnↄ bàmɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}