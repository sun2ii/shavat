{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":5,"content":[{"type":"heading","content":["Kↄngↄ aduakɛna"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀. Wè sí kↄ̃n kurepɛnaomɛ."]},{"type":"verse","number":1,"content":[{"text":"Ǹ swã kpá ma yãzi, Dii,","poem":1},{"lineBreak":true},{"text":"ǹ làakari dↄ ma m̀bonaa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma Kína, ǹ ma wiilɛna ma,","poem":1},{"lineBreak":true},{"text":"ma Luda, mɛ́ɛ wɛ́ɛ kɛɛmma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii, nɛɛ̀ ma yã'ona ma gudↄnao,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ ma yãnↄ dↄdↄnnɛ kↄngↄ,","poem":1},{"lineBreak":true},{"text":"ma wɛ́ɛ ègↄ̃ dↄnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N Luda n tɛ̃̀n à zaaa ũ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀gↄ̃ gbɛ̃ zaaao lɛdoro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ĩadãri è e à zɛ n aɛzĩro,","poem":1},{"lineBreak":true},{"text":"n za yãzaakɛrinↄn ń píngi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii, nɛɛ̀ ɛgɛdeenↄ mì dɛ,","poem":1},{"lineBreak":true},{"text":"ń ye gbɛ̃dɛrinↄ kↄ̃n gbɛ̃blerinↄ kãziro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mapi sↄ̃, mɛ́ gɛ̃ n ua n gbɛ̃kɛ bíta yãnzi,","poem":1},{"lineBreak":true},{"text":"mɛ́ kúɛ mà aɛ dↄ n kpɛ́a mà mì siɛnnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii, ǹ ma da zɛ́a n náanɛkɛna yãnzi,","poem":1},{"lineBreak":true},{"text":"ǹ zɛ́ poromɛ ma wɛdɛrinↄ yãnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Zaakɛ aↄ̃ yãke náanɛ vĩro,","poem":1},{"lineBreak":true},{"text":"aↄ̃ nↄ̀sɛ dɛ lán kãkã bɛɛ bàmɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ kòto dɛ lán mira wɛ̃na bàmɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è lɛ́nnaa kásańnɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ǹ tó yã vɛ̃ɛḿma Luda,","poem":1},{"lineBreak":true},{"text":"ǹ tó yã zaaa kɛ̀ aↄ̃ↄe kpákpaanↄ wí ń musu.","poem":1},{"lineBreak":true},{"text":"Ǹ pɛ́ḿma n aɛzĩ aↄ̃ taari pariinↄ yãnzi,","poem":1},{"lineBreak":true},{"text":"zaakɛ aↄ̃ gì n yã mazi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ǹ tó gbɛ̃ kɛ̀ aↄ̃ↄ utɛna n kiianↄ yáa dↄ,","poem":1},{"lineBreak":true},{"text":"aↄ̃gↄ̃ lɛ̀ sii kↄ̃n pↄnnaao gurↄ píngi.","poem":1},{"lineBreak":true},{"text":"Ǹ ↄ kú gbɛ̃ kɛ̀ aↄ̃ↄ yenziinↄla,","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃ pↄnnaa kɛ n yã musu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dii, nɛɛ̀ aubarika da gbɛ̃ maaanↄn,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ ligańzi yenzio lán sɛngbango bà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}