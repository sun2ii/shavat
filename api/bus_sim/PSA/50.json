{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":50,"content":[{"type":"heading","content":["Dↄnzikɛna yãpuraa"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii Luda Gbãapingidee e yã oo,","poem":1},{"lineBreak":true},{"text":"èe lɛ́ zuu anduna gbɛ̃nↄzi","poem":1},{"lineBreak":true},{"text":"zaa ↄfãntɛ̃bↄɛ kpa ai à gɛ̃kii kpa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Luda gakui e bii Zayↄn,","poem":1},{"lineBreak":true},{"text":"wɛ́tɛ kɛ̀ à maakɛɛ papana.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wa Ludaa e mↄↄ, eégↄ̃ yĩtɛnaro.","poem":1},{"lineBreak":true},{"text":"Tɛ́ kɛ̀ è ń blee kú à aɛ,","poem":1},{"lineBreak":true},{"text":"zàga'ĩa pãsĩ ligazi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Èe musudeenↄ kↄ̃n tↄↄtɛdeenↄ sisii","poem":1},{"lineBreak":true},{"text":"lɛ à e à yãkpaɛ kɛ kↄ̃n a gbɛ̃nↄ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À bè: À ma yãmarinↄ kakↄ̃amɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ ma bà kúńyo sa'ona gãzĩnↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ludan yãkpaɛkɛri ũ,","poem":1},{"lineBreak":true},{"text":"musudeenↄ è à yãkɛna a zɛ́a kpàakpa kɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À ma, ma gbɛ̃nↄ, má yã vĩ mà oare,","poem":1},{"lineBreak":true},{"text":"Isarailinↄ, mɛ́ a bↄbↄ a dàn,","poem":1},{"lineBreak":true},{"text":"mámbe Luda a Luda ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɛ́ɛ kpãkɛ̃ɛazi a sa'ona yãnziro,","poem":1},{"lineBreak":true},{"text":"ke sa'opↄ kɛ̀ eègↄ̃ kaa tɛ́n à tɛ́ kũ baa bↄrɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Má zùswaree kɛ̀ kú a kpàsan nii vĩro,","poem":1},{"lineBreak":true},{"text":"ke blè kɛ̀ kú a kara guu,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zaakɛ nↄ̀bↄsɛ̃tɛnↄ nɛ́ ma pↄ́nↄmɛ","poem":1},{"lineBreak":true},{"text":"kↄ̃n pↄ́kãde kpàsa kɛ̀ aↄ̃ↄ kú sĩ̀sĩ pariinↄ musuo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má kpii musu bãanↄ dↄ̃ píngi,","poem":1},{"lineBreak":true},{"text":"sɛ̃̀tɛ pↄ́ ketenↄↄ kuu ma pↄ́ ũmɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó nↄaa e ma dɛɛ, mɛ́ oarero,","poem":1},{"lineBreak":true},{"text":"zaakɛ má anduna vĩ kↄ̃n à pↄ́ kɛ̀ kunnↄ píngi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mɛɛ̀ zùsware nↄ̀bↄ són yↄ́?","poem":1},{"lineBreak":true},{"text":"Mɛɛ̀ blèkofĩi aru min yↄ́?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"À saa oma kɛ̃nnakↄ̃o pↄ́ ũ,","poem":1},{"lineBreak":true},{"text":"à lù kɛ̀ á sɛ̀ ma Luda Musudea fĩa bo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"À ma sísi nawɛ̃akɛgurↄ,","poem":1},{"lineBreak":true},{"text":"mɛ́ a bↄ, é bɛ̀ɛ límɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ben Luda bè zaakɛrinↄnɛ:","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dia ée ma yãdiɛnanↄ dↄdↄↄ,","poem":1},{"lineBreak":true},{"text":"bↄ́yãnzin ma bà kuunańyo yã da a lɛ́nzi?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Á ye ma yãdannɛziro,","poem":1},{"lineBreak":true},{"text":"a ma yãnↄ kpà kpɛɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó a kpãi è, eè à kɛ a gbɛ̃nna ũmɛ,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ eègↄ̃ kaakↄ̃a kↄ̃n zinakɛrinↄ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A lɛ́gbɛ zaa,","poem":1},{"lineBreak":true},{"text":"eè lɛ́nnaa kásańnɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Eègↄ̃ a gbɛ̃ndoo pee,","poem":1},{"lineBreak":true},{"text":"eè a da nɛ́ ɛgɛ bo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A yã beeenↄ kɛ̀, ben má yĩtɛna.","poem":1},{"lineBreak":true},{"text":"Ée daa má dɛ lán a bàmɛ,","poem":1},{"lineBreak":true},{"text":"mↄde mɛ́ kpãkɛ̃azi mà a bↄbↄ a dàn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Amↄa kɛ̀ ma yã sã̀aguunↄ, à yã pì ma.","poem":1},{"lineBreak":true},{"text":"Tó lɛn sↄ̃ro, mɛ́ a kɛ gyáigyai,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ke é fↄ̃ à a símaro.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ kɛnnakↄ̃o saa òmaa bɛ̀ɛ lìmɛ,","poem":1},{"lineBreak":true},{"text":"èe ma gba zɛ́ mà ↄdↄaare","poem":1},{"lineBreak":true},{"text":"lán mɛɛ̀ gbɛ̃nↄ mì sí nà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}