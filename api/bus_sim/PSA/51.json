{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":51,"content":[{"type":"heading","content":["Yãnza wɛ́ɛkɛna Ludaa"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kɛ̀ Dauda dà gurↄↄ kɛ̀ annabi Natã gàa à kiia à zinakɛna kↄ̃n Basɛbao gbɛra"]},{"type":"verse","number":1,"content":[{"text":"Luda, ǹ ma wɛ̃nda gwa n yenzi guu,","poem":1},{"lineBreak":true},{"text":"ǹ ma taarinↄ gogo n maa bíta yãnzi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ ma yã zaaa kɛ̃ma mà gↄ̃ wásawasa,","poem":1},{"lineBreak":true},{"text":"ǹ ma durun kɛ̃mɛ míↄmiↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Má a taarinↄ dↄ̃ sa,","poem":1},{"lineBreak":true},{"text":"ma durun ègↄ̃ sãamaguro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ḿbe ma durun kɛ̀nnɛ,","poem":1},{"lineBreak":true},{"text":"ma yã kɛ̀ ń yeziroo kɛ̀.","poem":1},{"lineBreak":true},{"text":"Tó n yã ò, n yã égↄ̃ zɛ́ vĩ,","poem":1},{"lineBreak":true},{"text":"tó n yãkpaɛ kɛ̀mao, n yã égↄ̃ nna.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Zaa ma da nↄ̀sɛn má zaa,","poem":1},{"lineBreak":true},{"text":"má durun vĩ zaa ma igurↄmɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nↄ̀sɛ maaa bé è kánnɛ,","poem":1},{"lineBreak":true},{"text":"ǹ ↄ̃ndↄ̃ↄ damɛ ma swɛ̃̀ guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ǹ ma zú o kↄ̃n saboo lɛ mà zɛ̃ wásawasa,","poem":1},{"lineBreak":true},{"text":"ǹ ma nↄ̀sɛ pípimɛ lɛ mà gↄ̃ pú fénfen.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ tó mà pↄnnaa kɛ kↄ̃n yáadↄnao,","poem":1},{"lineBreak":true},{"text":"ǹ tó ma wá kɛ̀ ń bùsanↄ were.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ǹton ma durunnↄ yã daro,","poem":1},{"lineBreak":true},{"text":"ǹ ma yã zaaanↄ bↄ ǹ zĩnna píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Luda, ǹ nↄ̀sɛpuraa damɛ,","poem":1},{"lineBreak":true},{"text":"ǹ ɛara ǹ tó ma làakari gↄ̃ kpaɛna.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹton ma zĩnnaro,","poem":1},{"lineBreak":true},{"text":"ǹton n Ninii símaro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹ ɛara ǹ tó ma pↄↄ kɛ nna","poem":1},{"lineBreak":true},{"text":"kɛ̀ n ma mì sì yãnzi.","poem":1},{"lineBreak":true},{"text":"Ǹ ma ninii gbaa màgↄ̃ n yã maa","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"mɛ́ gbasa mà n yã dada zaakɛrinↄnɛ,","poem":1},{"lineBreak":true},{"text":"durunkɛrinↄ é ɛara wà aɛ dↄmma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ǹ ma bↄ gbɛ̃dɛna yãn,","poem":1},{"lineBreak":true},{"text":"Luda, Luda ma mìsiri,","poem":1},{"lineBreak":true},{"text":"mɛ́ lɛ̀ sí n yãkɛna a zɛ́a musu.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dii, ǹ ma gba lɛ́","poem":1},{"lineBreak":true},{"text":"mà n sáabu kpá.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Sa'ona è kɛnnɛ nnaro,","poem":1},{"lineBreak":true},{"text":"tó lɛnlo lɛ má ò.","poem":1},{"lineBreak":true},{"text":"Sa'opↄ kɛ̀ wè ká tɛ́n à tɛ́ kũ è kánnɛro.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Saa kɛ̀ mɛ́ɛ oommaan ma nↄ̀sɛyĩi ũ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ kya ká wɛ̃ndade sùudeenlo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Luda, ǹ aubarika da Zayↄn","poem":1},{"lineBreak":true},{"text":"n pↄyezi maaa guu,","poem":1},{"lineBreak":true},{"text":"ǹ Yerusalɛmu bĩi gba gbãaa,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"sa'ona a zɛ́a é gbasa à kánnɛ","poem":1},{"lineBreak":true},{"text":"kↄ̃n sa'opↄ kɛ̀ wè ká tɛ́n à tɛ́ kũo,","poem":1},{"lineBreak":true},{"text":"weé saa o kↄ̃n zùswareenↄ n gbãgbãkiia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}