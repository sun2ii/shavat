{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":52,"content":[{"type":"heading","content":["Auzikide ĩadãna"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kɛ̀ Dauda dà gurↄↄ kɛ̀ à gàa Aimɛlɛki bɛ, ben Ɛdↄmu gbɛ̃ Doɛgi gàa à ò Solunɛ"]},{"type":"verse","number":1,"content":[{"text":"N gↄ̃sagbãaa, Luda gbɛ̃kɛɛ kuu gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"à kɛ̀ dia nɛ́ɛ ĩa dãa kↄ̃n yã zaaao?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nɛɛ̀gↄ̃ lɛ́fↄtↄↄ kaa gbɛ̃nↄzi gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"n lɛ́ nna lán gɛ̃ mìbobↄ bà,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ gbɛ̃nↄ gbá sɛ́ɛo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ń ye à zaaazi dɛ à maaala,","poem":1},{"lineBreak":true},{"text":"ɛgɛtona è kɛnnɛ nna dɛ yãpuraala.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ń ye gbɛ̃kaatɛna yãzi,","poem":1},{"lineBreak":true},{"text":"mↄnafikiyã bé à da n lɛ́n.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Luda é n gbãaa kↄ̀ ɛ́ ai gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"eé n kũ à bↄnyo n kpɛ́n,","poem":1},{"lineBreak":true},{"text":"eé n bↄ gbɛ̃ bɛ̃ɛnↄ tɛ́.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃ maaanↄↄ è, vĩa é ń kũ,","poem":1},{"lineBreak":true},{"text":"aↄ̃é n lalandi kɛ wà be:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ èe Luda kɛ a utɛkii ũroon yɛ̀!","poem":1},{"lineBreak":true},{"text":"À náanɛ kpà a auziki bítaa,","poem":1},{"lineBreak":true},{"text":"à gↄ̃̀ gbãadee ũ gbɛ̃kaatɛna guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Má dɛ lán kù lásiadee kɛ̀ kú Luda ua bà,","poem":1},{"lineBreak":true},{"text":"mɛ́gↄ̃ zɛ kↄ̃n Luda yenzio gurↄ píngimɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mɛ́gↄ̃ n sáabu kpaa gurↄ píngi","poem":1},{"lineBreak":true},{"text":"yã kɛ̀ ń kɛ̀ yãnzi,","poem":1},{"lineBreak":true},{"text":"mɛ́ n tↄ́ sɛ́ lezĩ n yãmarinↄ aɛzĩ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ ń maa yãnzi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}