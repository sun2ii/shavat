{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":53,"content":[{"type":"heading","content":["Mìsaidee yã'ona"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Yↄ̃nkↄↄ è be a swɛ̃̀n Ludaa kuuro.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃nↄ yàka, aↄ̃ yãkɛna zaa,","poem":1},{"lineBreak":true},{"text":"yãmaakɛri kee kú ń tɛ́ro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Zaa musu Luda è gbɛ̃nteenↄ tàasi kɛ","poem":1},{"lineBreak":true},{"text":"à gwa tó gbɛ̃ke ↄ̃ndↄ̃ↄ kà à a kii wɛtɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aↄ̃ sã̀sã ń píngi aↄ̃ gↄ̃̀ dↄ̀rↄ sai míↄmiↄ,","poem":1},{"lineBreak":true},{"text":"yãmaakɛri kee kú ń tɛ́ro, baa mɛ̀n do.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Zaakɛrinↄↄ dↄ̃na vĩroo?","poem":1},{"lineBreak":true},{"text":"Aↄ̃è ma gbɛ̃nↄ mↄ́mↄ lán ú bà,","poem":1},{"lineBreak":true},{"text":"aↄ̃è Luda sísiro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gwen vĩa ń kũn maamaa,","poem":1},{"lineBreak":true},{"text":"vĩapↄnↄↄ kú gwe sↄ̃ro.","poem":1},{"lineBreak":true},{"text":"Ludaa tò gbɛ̃ kɛ̀ aↄ̃ lɛ̀ɛawaanↄ gↄ̃̀ kaɛna gɛ̀nↄ ũ,","poem":1},{"lineBreak":true},{"text":"a wí dàḿma kɛ̀ Luda gìńzi yãnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Luda, ǹ bↄ Zayↄn ǹ mↄ́ ǹ Isarailinↄ mì sí!","poem":1},{"lineBreak":true},{"text":"Tó Luda sↄ̀kpa kↄ̃n a gbɛ̃nↄ ń gwena ziin,","poem":1},{"lineBreak":true},{"text":"Yakubu boriinↄ é pↄnnaa kɛ,","poem":1},{"lineBreak":true},{"text":"Isarailinↄ é yáa dↄ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}