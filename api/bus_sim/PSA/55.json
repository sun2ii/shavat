{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":55,"content":[{"type":"heading","content":["Aduakɛna kuuna wɛ́ɛtãmma guu"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀. Wè sí kↄ̃n mↄrↄnↄmɛ."]},{"type":"verse","number":1,"content":[{"text":"Luda, ǹ ma aduakɛna ma,","poem":1},{"lineBreak":true},{"text":"ǹton lá kú ma yãlaro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ swã kpá ma yãzi ǹ wemala,","poem":1},{"lineBreak":true},{"text":"ma laasuu ma likↄ̃a ma gↄ̃ bídi guu","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ma ibɛɛnↄ yã'ona yãnzi","poem":1},{"lineBreak":true},{"text":"kↄ̃n gbɛ̃ zaaanↄ wɛ́ɛbiimanao,","poem":1},{"lineBreak":true},{"text":"zaakɛ aↄ̃ↄe ĩa daama,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ ma kũna kↄ̃n pↄfɛ̃o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Swɛ̃̀ kɛ̃̀magu,","poem":1},{"lineBreak":true},{"text":"ga vĩa gɛ̃̀magu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Vĩa ma kũ, mɛ́ɛ lugalugaa,","poem":1},{"lineBreak":true},{"text":"ma ninii dà batan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó má dɛ̀bɛ vĩ lán pↄ̃tɛ̃ɛ bà,","poem":1},{"lineBreak":true},{"text":"lɛ mɛ́ vĩa mà gá kámma bo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"mɛ́ bàa lɛ́ mà gá zã̀azã,","poem":1},{"lineBreak":true},{"text":"mɛ́ gá mà vɛ̃ɛ gbáan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɛ́ wã mà gá mà utɛkii wɛtɛ,","poem":1},{"lineBreak":true},{"text":"lɛ zàga'ĩa gbãaa tón ma lero yãnzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ǹ ń yã gboro, Dii, ǹ ń yã yãkↄ̃tɛńnɛ,","poem":1},{"lineBreak":true},{"text":"zaakɛ má è zↄka kↄ̃n swèeo kú wɛ́tɛ guu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Aↄ̃è kpáɛ kɛ bĩi musu fãantɛ̃ kↄ̃n gwãavĩo,","poem":1},{"lineBreak":true},{"text":"yã zaa kↄ̃n yã gbãaao di wɛ́tɛ guu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃dɛdɛyã bé à wɛ́tɛ pì pà,","poem":1},{"lineBreak":true},{"text":"gbãamↄnnɛna kↄ̃n mↄnafikio è kɛ̃ à gãalɛro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tó ma ibɛɛ bé èe ma sↄ̃sↄ̃ↄ yã, mɛ́ mɛna,","poem":1},{"lineBreak":true},{"text":"tó ma zanguri bé à fɛ̀ɛmazi, mɛ́ utɛnɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mↄde ḿbeee, mmↄn kɛ̀ wá sáa,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃ndoo, ma gbɛ̃nna!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Weè fàadi bo kↄ̃o yã nnanna,","poem":1},{"lineBreak":true},{"text":"weègↄ̃ tɛ́kↄ̃zi parii tɛ́ Luda ua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Gaa é zãmba kɛ ma ibɛɛnↄnɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃é si gɛ̀wãan ń gbãagurↄ,","poem":1},{"lineBreak":true},{"text":"zaakɛ zaaa vɛ̃ɛkii è ń guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mapi sↄ̃, mɛɛ̀ Luda sísi,","poem":1},{"lineBreak":true},{"text":"Dii è ma mì sí.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kↄngↄ, fãantɛ̃ kↄ̃n uusiɛo","poem":1},{"lineBreak":true},{"text":"mɛɛ̀gↄ̃ ma yã'ↄ̃ammanↄ bↄɛɛnɛ kↄ̃n m̀bnao,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ è ma yã ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Baa kɛ̀ ma ibɛɛnↄↄ pari,","poem":1},{"lineBreak":true},{"text":"è ma sí à ma bↄ swèen aafia.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Luda ègↄ̃ vɛ̃ɛna kpatan gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"eé ma yã ma, eé wí daḿma,","poem":1},{"lineBreak":true},{"text":"zaakɛ aↄ̃è ń dà liɛro, aↄ̃ↄ Luda vĩa vĩro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ma gbɛ̃ pì swèe kɛ̀ kↄ̃n a gbɛ̃nↄo,","poem":1},{"lineBreak":true},{"text":"à bↄ̀ lɛdolɛ kɛ̀ aↄ̃ↄ kɛ̀ kↄ̃o kpɛɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"È yã nnaa o lán zↄ́ bà,","poem":1},{"lineBreak":true},{"text":"mↄde swèe laasuu kú à swɛ̃̀n.","poem":1},{"lineBreak":true},{"text":"È lɛ́nnaa kásańnɛ páipai,","poem":1},{"lineBreak":true},{"text":"mↄde yáadↄmma bà da à bↄ̀kↄmmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ǹ n yã'ↄ̃ammanↄ tó Diinɛ,","poem":1},{"lineBreak":true},{"text":"eégↄ̃ n kũna,","poem":1},{"lineBreak":true},{"text":"è tó gbɛ̃ maaa fu zikiro.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Gbɛ̃dɛri náanɛsaideenↄ é ń gurↄ dagura lero,","poem":1},{"lineBreak":true},{"text":"Luda, nɛ́ tó aↄ̃ si gɛ̀wãa tùtuwɛɛn.","poem":1},{"lineBreak":true},{"text":"Mapi sↄ̃, mɛ́gↄ̃ n náanɛ kɛɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}