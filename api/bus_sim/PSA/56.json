{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":56,"content":[{"type":"heading","content":["Zĩndakpana Ludaa"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kɛ̀ Dauda dà gurↄↄ kɛ̀ Filisitininↄ à kũ̀ zaa Gata."]},{"type":"verse","number":1,"content":[{"text":"Ǹ ma wɛ̃nda gwa Luda, wèe pɛɛɛmazi,","poem":1},{"lineBreak":true},{"text":"wègↄ̃ zĩ̀ kaamao wàgↄ̃ wɛ́ɛ tãama gurↄ píngi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ma kpàkparinↄ ègↄ̃ pɛɛɛmazi gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"aↄ̃ wada yãnzin aↄ̃ↄe zĩ̀ kaamaozi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tó vĩa e ma kũu, mɛ́ n náanɛ kɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɛ́ Luda tↄ́ kpá yã kɛ̀ à ò yãnzi,","poem":1},{"lineBreak":true},{"text":"má Luda náanɛ vĩ, mɛ́ vĩa kɛro.","poem":1},{"lineBreak":true},{"text":"Bↄ́n gbɛ̃ntee é fↄ̃ à kɛmɛɛ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aↄ̃ègↄ̃ ma yã liɛɛ kpɛɛgãnda gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"aↄ̃ègↄ̃ ma kpákpaa à zaaao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aↄ̃è kↄ̃ kakↄ̃amazi wà naɛmɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è ma kpákpa wàgↄ̃ yezi wà ma dɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Luda, ǹton tó aↄ̃ gbɛ̃ke bↄro,","poem":1},{"lineBreak":true},{"text":"ǹ boriinↄ nɛ kↄ̃n pↄfɛ̃o.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ ma nawɛ̃a yã da,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ́ɛ'ikwɛɛna ká n sɛ̀rɛ guu.","poem":1},{"lineBreak":true},{"text":"À kú n takada guuroo?","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tó ma Luda sìsi,","poem":1},{"lineBreak":true},{"text":"ma ibɛɛnↄ é bↄru kpɛɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́gↄ̃ dↄ̃ kɛ̀ à yã sìmao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mɛ́ Luda tↄ́ kpá yã kɛ̀ à ò yãnzi,","poem":1},{"lineBreak":true},{"text":"ee, mɛ́ Dii tↄ́ kpá yã pì ona yãnzi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Má Luda náanɛ vĩ, mɛ́ vĩa kɛro.","poem":1},{"lineBreak":true},{"text":"Bↄ́n gbɛ̃ntee é fↄ̃ à kɛmɛɛ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Luda, mɛ́ lù kɛ̀ má sɛ̀mmaanↄ fĩa bo,","poem":1},{"lineBreak":true},{"text":"mɛ́ kɛnnakↄ̃o saa omma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zaakɛ n ma si gaa lɛ́zĩ, nɛ́ɛ tó ma gɛ̃̀n sìro,","poem":1},{"lineBreak":true},{"text":"lɛ màgↄ̃ táa oonyo gupuraa kɛ̀ è wɛ̃̀ndi kpáḿma guu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}