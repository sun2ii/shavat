{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":57,"content":[{"type":"heading","content":["Wiipɛna Luda Musudezi"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kɛ̀ Dauda dà gurↄↄ kɛ̀ à bàa lɛ̀ Solunɛ à ùtɛ gbɛ̀wɛɛn."]},{"type":"verse","number":1,"content":[{"text":"Ǹ ma wɛ̃nda gwa Luda, ǹ ma wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"zaakɛ ḿbe ma nanzi.","poem":1},{"lineBreak":true},{"text":"Ǹ ma sↄtↄ n ↄru ai ma bↄ gaa lɛ́zĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mɛ́ɛ wii pɛɛ Luda Musudezi,","poem":1},{"lineBreak":true},{"text":"Luda kɛ̀ è yã kɛ̀ à ò papamɛɛ pì.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Eé tó dↄnlɛ bↄ zaa musu à ma mì sí,","poem":1},{"lineBreak":true},{"text":"eé wí da gbɛ̃ kɛ̀ aↄ̃ↄe pɛɛɛmaziinↄa,","poem":1},{"lineBreak":true},{"text":"eé a gbɛ̃kɛ kↄ̃n a náanɛyão kɛmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Má kú músunↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ daɛna nↄ̀bↄ pãsĩnↄ dagura.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ pìnↄ nɛ́nɛ nna lán fɛ̃ɛdaa bà,","poem":1},{"lineBreak":true},{"text":"aↄ̃ swaa nɛ́ sárimɛ kↄ̃n kào.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Luda, ǹ n zĩnda tↄ́ sɛ́ lezĩ ai musumusu,","poem":1},{"lineBreak":true},{"text":"ǹ tó n gakui da andunala píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aↄ̃ bà kpàkpamɛ ma zɛ́n, ben nawɛ̃a tↄ̃̀ma,","poem":1},{"lineBreak":true},{"text":"aↄ̃ wɛ̀ɛ yↄ̃̀ ma aɛ, ben aↄ̃ zù à guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ma làakari kpaɛna Luda, ma làakari kpaɛna,","poem":1},{"lineBreak":true},{"text":"mɛ́ lɛ̀ sí mà n táaki lɛ́.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ vu, ma swɛ̃̀!","poem":1},{"lineBreak":true},{"text":"Ma mↄrↄ kↄ̃n ma kuntigio kú máa?","poem":1},{"lineBreak":true},{"text":"Mɛ́ gudↄↄ pá mìo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dii, mɛ́ n sáabu kpá boriinↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"mɛ́ n táaki lɛ́ gbɛ̃nↄnɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zaakɛ n gbɛ̃kɛ bíta kà n kiia,","poem":1},{"lineBreak":true},{"text":"n náanɛ ludambɛ luguu lè.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Luda, wà n tↄ́ sɛ́ lezĩ ai musumusu,","poem":1},{"lineBreak":true},{"text":"ǹ tó n gakui da andunala píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}