{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":58,"content":[{"type":"heading","content":["Gbɛ̃ zaaanↄ tona kↄ̃n Ludao"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Gbãadeenↄ, eè yã o a zɛ́a sↄ̃ↄ́?","poem":1},{"lineBreak":true},{"text":"Eè yãkpaɛ kɛ kↄ̃n gbɛ̃nↄo súusuↄ́?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Eè yã zaa wàari pá a swɛ̃̀ guu,","poem":1},{"lineBreak":true},{"text":"eè gbãaa mↄ gbɛ̃nↄnɛ a bùsun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃ zaaanↄ sã̀sã zaa ń igurↄmɛ,","poem":1},{"lineBreak":true},{"text":"ɛgɛdeenↄ yàka zaa ń da gbɛɛɛmmɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aↄ̃ lɛ́gbɛ dɛ lán mlɛ̃̀ sɛwɛɛ bà,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ dɛ lán kárɛ kɛ̀ à a swã tàta bà,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"lɛ àton a kↄ̃kↄ̃'ori gaasia ↄ́ maro,","poem":1},{"lineBreak":true},{"text":"lɛ mlɛ̃̀ pì tón a dabokɛri gonikɛɛ ero.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Luda, ǹ ń swaa ɛ́'ɛńnɛ ń lɛ́n,","poem":1},{"lineBreak":true},{"text":"Dii, ǹ músu pìnↄ swaa sↄ̃ntɛnↄ ɛ́'ɛńnɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ tó aↄ̃ gɛ̃ zɛ́la lán í bàalɛna bà.","poem":1},{"lineBreak":true},{"text":"Tó aↄ̃ sá gà, ǹ ń kànↄ ɛ́'ɛńnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹ tó aↄ̃ kori kũ zɛ́n lán kↄntↄ lóu bà,","poem":1},{"lineBreak":true},{"text":"aↄ̃gↄ̃ dɛ lán nↄ̀bↄɛnɛ kɛ̀ èe ↄfãntɛ̃ eroo bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ai yàka tɛ́ gↄ̃ oroo wã,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ zaaanↄ é gɛ̃ ĩa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaanↄ é pↄnnaa kɛ,","poem":1},{"lineBreak":true},{"text":"zĩ kɛ̀ Luda gɛ̃ɛ bòńnɛ gbɛ̃ zaaanↄa,","poem":1},{"lineBreak":true},{"text":"kɛ̀ aↄ̃ ń gbá pìpi ń aru guu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gbɛ̃nↄ é be: Gbɛ̃ maaanↄ láada vĩ fá!","poem":1},{"lineBreak":true},{"text":"Ludaa kuu, è yãkpaɛ kɛ anduna guu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}