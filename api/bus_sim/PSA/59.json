{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":59,"content":[{"type":"heading","content":["Ǹ ma sí ma ibɛɛnↄa"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kɛ̀ Dauda dà gurↄↄ kɛ̀ Solu gbɛ̃nↄ zĩ̀ aↄ̃ à dãdã à bɛ wà à dɛ."]},{"type":"verse","number":1,"content":[{"text":"Ma Luda, ǹ ma sí ma ibɛɛnↄa,","poem":1},{"lineBreak":true},{"text":"ǹ ma bↄ gbɛ̃ kɛ̀ aↄ̃ fɛ̀ɛmaziinↄ ↄzĩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ ma sí zaakɛrinↄa,","poem":1},{"lineBreak":true},{"text":"ǹ ma bↄ gbɛ̃dɛrinↄ ↄzĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ǹ gwa, aↄ̃ↄe ma kpákpaa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ pãsĩnↄↄ e swèe kɛɛmao.","poem":1},{"lineBreak":true},{"text":"Dii, mɛ́ɛ taari ke durun kɛńnɛro,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"mɛ́ɛ sãsãńnɛ yãkearo,","poem":1},{"lineBreak":true},{"text":"ben aↄ̃ↄ kú soruo wà nakↄ̃rɛma.","poem":1},{"lineBreak":true},{"text":"Ǹ ma wɛ̃nda gwa ǹ fɛɛ ǹ mↄ́ ǹ dↄmalɛ!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N Dii Luda Zĩ̀kpɛde, Isarailinↄ Luda,","poem":1},{"lineBreak":true},{"text":"ǹ fɛɛ ǹ wɛ́ɛ tã borii mↄ̀nↄa ń píngi.","poem":1},{"lineBreak":true},{"text":"Ǹton bↄnkpɛɛde zaaa mↄ̀nↄ wɛ̃nda gwaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Aↄ̃è ɛara wà su uusiɛ dↄ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è likↄ̃aa zↄ̃ wɛ́tɛn,","poem":1},{"lineBreak":true},{"text":"aↄ̃è hũ̀u kɛma lán gbɛ̃ɛnↄ bà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ gwa, aↄ̃ lóu e tↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"fɛ̃ɛ kpá ń lɛ́n,","poem":1},{"lineBreak":true},{"text":"aↄ̃è be gbɛ̃kee e ń maaro.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mpi sↄ̃ Dii, nɛɛ̀ ń yáa dↄ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ borii pìnↄ lalandi kɛ ń píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Luda ma gbãa, ma wɛ́ɛ dↄnzi,","poem":1},{"lineBreak":true},{"text":"ḿbe ma aafia'ekii ũ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Luda é dↄmɛ aɛ a gbɛ̃kɛɛ guu,","poem":1},{"lineBreak":true},{"text":"eé tó mà yↄ̃̀gↄ̃ kɛ ma zangurinↄa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii wa sɛngbango, ǹton ń dɛdɛro,","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃ yã tón sã ma gbɛ̃nↄnlo yãnzi.","poem":1},{"lineBreak":true},{"text":"Ǹ tó aↄ̃ likↄ̃aa zↄ̃ ǹ ń sↄ̃ɛ kↄ̃n n gbãaao.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yã kɛ̀ è bↄ ń lɛ́n nɛ́ durun yãmɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ tó aↄ̃ wadakɛna ń kũ,","poem":1},{"lineBreak":true},{"text":"zaakɛ aↄ̃è ɛgɛɛ to, aↄ̃è gbɛ̃ ká.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ǹ ń kaatɛ kↄ̃n pↄfɛ̃o,","poem":1},{"lineBreak":true},{"text":"ǹ ń dúgu zↄ̃, aↄ̃tongↄ̃ kuu dↄro","poem":1},{"lineBreak":true},{"text":"de aↄ̃gↄ̃ dↄ̃ ai zaa anduna lɛ́a","poem":1},{"lineBreak":true},{"text":"kɛ̀ Ludaa e kí blee Yakubu boriinↄa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Aↄ̃è ɛara wà su uusiɛ dↄ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è likↄ̃aa zↄ̃ wɛ́tɛ guu,","poem":1},{"lineBreak":true},{"text":"aↄ̃è hũ̀u kɛ lán gbɛ̃ɛnↄ bà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aↄ̃è ligaliga wàgↄ̃ pↄ́blee wɛtɛɛ,","poem":1},{"lineBreak":true},{"text":"tó aↄ̃ↄe kãro, aↄ̃è wii pɛ́.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mapi sↄ̃, mɛ́ lɛ̀ sí n gbãaa yã musu,","poem":1},{"lineBreak":true},{"text":"mà guda kɛ kↄngↄ n gbɛ̃kɛ yãnzi,","poem":1},{"lineBreak":true},{"text":"zaakɛ ḿbe ma aafia'ekii ũ,","poem":1},{"lineBreak":true},{"text":"ḿbe ma utɛkii ũ nawɛ̃akɛgurↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Luda ma gbãaa, mɛ́ n táaki lɛ́,","poem":1},{"lineBreak":true},{"text":"zaakɛ ḿbe ma aafia'ekii ũ,","poem":1},{"lineBreak":true},{"text":"Luda kɛ̀ è gbɛ̃kɛɛ kɛmɛɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}