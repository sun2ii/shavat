k":true},{"text":"n n vĩakɛrinↄ baka kpàma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ǹ kína dↄ̃ aafiao,","poem":1},{"lineBreak":true},{"text":"ǹ tó à ká a gurↄↄa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Àgↄ̃ kpata blee n dↄ̃na guu gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"ǹ à dãkpa n gbɛ̃kɛ kↄ̃n n náanɛkɛnao yãnzi,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"mɛ́ gbasa màgↄ̃ n táaki lɛɛ lán guu e dↄↄ nà,","poem":1},{"lineBreak":true},{"text":"mɛ́gↄ̃ lù kɛ̀ má sɛ̀nnɛɛ fĩa boo gurↄ píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}