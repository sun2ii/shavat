{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":62,"content":[{"type":"heading","content":["Ludan utɛkii ũ"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Luda ado bé à tò ma làakari kpáɛna,","poem":1},{"lineBreak":true},{"text":"àmbe è ma mì sí.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Àmbe ma gbɛ̀si ũ kↄ̃n ma mìsirio,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ gbãa ea, mɛ́ nigã zikiro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gɛ̃̀n ũgban égↄ̃ fɛɛɛ gbɛ̃zi?","poem":1},{"lineBreak":true},{"text":"É à nɛ lán gũ̀ kɛ̀ ɛ̀ à kpán","poem":1},{"lineBreak":true},{"text":"ke kara zi wↄ̀kↄwↄkↄ bàn yↄ́?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À guna a tíla lɛ́n ée kpaakↄ̃sↄ̃,","poem":1},{"lineBreak":true},{"text":"ɛgɛtona bé è kɛare nna.","poem":1},{"lineBreak":true},{"text":"Eè sa maaa o gbɛ̃nɛ kↄ̃n lɛ́omɛ,","poem":1},{"lineBreak":true},{"text":"ben eè ń ká a swɛ̃̀ guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Luda ado bé à tò ma làakari kpáɛna,","poem":1},{"lineBreak":true},{"text":"zaakɛ àpin ma wɛ́ɛ dↄzi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Àmbe ma gbɛ̀si ũ ma mìsiri ũ,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ gbãa ea, mɛ́ nigã zikiro,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma aafia kↄ̃n ma bɛ̀ɛo è bↄ à kiiamɛ,","poem":1},{"lineBreak":true},{"text":"àmbe ma gbɛ̀si gbãaa ũ, ma utɛkii ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gbɛ̃nↄ, àgↄ̃ à náanɛ kɛɛ gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"à a swɛ̃̀ wɛ̃nɛ, àmbe wa utɛkii ũ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Talakanↄↄ dɛ lán lɛ́'ĩa bàmɛ,","poem":1},{"lineBreak":true},{"text":"gbãadeenↄ e ká pↄ́ke lɛ́zĩro.","poem":1},{"lineBreak":true},{"text":"Tó wà ń yↄ̃ kilooa,","poem":1},{"lineBreak":true},{"text":"aↄ̃ píngi égↄ̃ dɛ fákuumɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Àton gbɛ̃ble'ↄↄ náanɛ kɛro,","poem":1},{"lineBreak":true},{"text":"àton ĩa dã kↄ̃n kpãi pↄ́oro.","poem":1},{"lineBreak":true},{"text":"Tó a auziki e kↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"àton tó a swɛ̃̀ gↄ̃ kúaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yã mɛ̀n doon Ludaa ò,","poem":1},{"lineBreak":true},{"text":"yã mɛ̀n plaaa kɛ̀nↄn má mà:","poem":1},{"lineBreak":true},{"text":"Luda, ḿbe ń gbãaa vĩ,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dii, ḿbe ń gbɛ̃kɛɛ vĩ,","poem":1},{"lineBreak":true},{"text":"ben nɛɛ̀ fĩa bo baadenɛ a yãkɛnaa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}