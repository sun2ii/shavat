"lineBreak":true},{"text":"Ma nↄ̀sɛ é kã lán wè pↄ́ maaa ble wà kã nà,","poem":1},{"lineBreak":true},{"text":"n táakilɛna égↄ̃ kú ma lɛ́n kↄ̃n gudakɛnao.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N yã è dↄmagu ma daɛkiia,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ laasuu lɛ́nzi gwãavĩ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma sↄtↄna n ↄru, mɛ́ɛ lɛ̀ sii,","poem":1},{"lineBreak":true},{"text":"zaakɛ ḿbe ma dↄnlɛri ũ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ma ninii namma,","poem":1},{"lineBreak":true},{"text":"ń ma kũna n ↄplaan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gbɛ̃ kɛ̀ aↄ̃ↄe ma wɛɛnↄ é kaatɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃é gɛ̃ tↄↄtɛn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Luda é tó wà ń dɛdɛ kↄ̃n fɛ̃ɛdaao,","poem":1},{"lineBreak":true},{"text":"aↄ̃é gↄ̃ gbɛ̃ngboonↄ pↄ́blee ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kína sↄ̃ é pↄnnaa kɛ kↄ̃n Ludao.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃è be wà sì kↄ̃n Ludaonↄ é à sáabu kpá,","poem":1},{"lineBreak":true},{"text":"ɛgɛdeenↄ sↄ̃ lɛ́ égↄ̃ nakↄ̃ana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}