ext":"aↄ̃è bàkpakpannɛna gusaɛ yã gↄ̃gↄ̃","poem":1},{"lineBreak":true},{"text":"aↄ̃è be: Gbɛ̃ke é wa ero.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aↄ̃è zaakɛna yã gↄ̃gↄ̃ wà be,","poem":1},{"lineBreak":true},{"text":"yã kɛ̀ wa à lɛ́ kpàkↄ̃sↄ̃ bↄɛzina.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ntee nↄ̀sɛguuyãnↄ asii bíta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mↄde Luda é ń pá kào,","poem":1},{"lineBreak":true},{"text":"eé ń kɛ̃nna kãndo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Eé tó yã kɛ̀ aↄ̃ↄ ò wí ń musu,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ ń é píngi égↄ̃ mì kɛ degũdegũ wà be taalɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Vĩa é baade píngi kũ,","poem":1},{"lineBreak":true},{"text":"aↄ̃é Luda yãkɛnanↄ tↄ̃kɛ̃,","poem":1},{"lineBreak":true},{"text":"aↄ̃égↄ̃ yã kɛ̀ à kɛ̀nↄ laasuu lɛɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaanↄ, àgↄ̃ pↄnnaa kɛɛ Dii guu à nazi,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuradeenↄ, àgↄ̃ à táaki lɛɛ á píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}