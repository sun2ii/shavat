{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":65,"content":[{"type":"heading","content":["Bori píngi wɛ́ɛ dↄ Ludazi"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Luda, à kↄ̃ sìo wà n táaki lɛ́ Zayↄn,","poem":1},{"lineBreak":true},{"text":"wà lù kɛ̀ wà sɛ̀nnɛɛnↄ fĩa bo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mmↄn kɛ̀ nɛɛ̀ aduakɛna ma,","poem":1},{"lineBreak":true},{"text":"n kiian bori píngi é sun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wa yã zaaanↄ wa fu,","poem":1},{"lineBreak":true},{"text":"ben n wa taarinↄ kɛ̃̀we.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aubarikadeen gbɛ̃ kɛ̀ ń sɛ̀ n gɛ̃o n ua ũ.","poem":1},{"lineBreak":true},{"text":"N kpɛ́ pↄ́ maaanↄ mↄ̀wa,","poem":1},{"lineBreak":true},{"text":"n kpɛ́ kɛ̀ kú adona pì.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ wewala kↄ̃n yã maa naasideenↄ, Luda wa Mìsiri.","poem":1},{"lineBreak":true},{"text":"Andunalɛzɛkideenↄ kↄ̃n ísiabaadeenↄ wɛ́ɛ dↄnzi ń píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N gbãaa dànla,","poem":1},{"lineBreak":true},{"text":"n kpiiinↄ kɛ̀ kↄ̃n n ikoo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ ísia kↄ̃n a sↄ̃nↄ kĩi kpáɛ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ boriinↄ zↄka yãańnɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N dabuyãnↄ è swɛ̃̀ kɛ̃","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃ↄ kú zaa tↄↄtɛlɛanↄn,","poem":1},{"lineBreak":true},{"text":"wè guda dↄmma zaa ↄfãntɛ̃bↄɛ kpa","poem":1},{"lineBreak":true},{"text":"kↄ̃n a gɛ̃kpɛn kpaao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nɛɛ̀ làakari dↄ andunaa, nɛɛ̀ à gba í,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ taaki ká tↄↄtɛnɛ, n swaanↄↄ pa kↄ̃n ío,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ tó blɛwɛɛ kɛ, zaakɛ lɛn ń dìɛ lɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ í dagula ai búgbarunↄ pa,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ guunↄ foo fↄ̃ kↄ̃n louo,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ aubarika da pↄ́ kɛ̀ bↄ̀ɛnↄn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ aubarika da burazĩin wɛ̃̀ kↄ̃n wɛ̃̀o,","poem":1},{"lineBreak":true},{"text":"blɛ nↄ́sidee è kwɛ́ɛ n tuuban.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pↄ́dãdãkiinↄ sɛ̃̀ lá bↄ̀rↄ kù sɛ̃̀tɛ,","poem":1},{"lineBreak":true},{"text":"sĩ̀sĩnↄ pↄnnaa dà uta ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Pↄ́kãdeenↄ dàgula ń dãdãkiinↄa,","poem":1},{"lineBreak":true},{"text":"blɛwɛɛ dàgula sĩ̀sĩgɛɛzi.","poem":1},{"lineBreak":true},{"text":"Wèe pↄnna wii lɛɛ, wèe lɛ̀ sii.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}