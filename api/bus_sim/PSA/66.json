{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":66,"content":[{"type":"heading","content":["Luda sáabukpana"]},{"type":"verse","number":1,"content":[{"text":"Anduna gbɛ̃ píngi,","poem":1},{"lineBreak":true},{"text":"à guda dↄ Diia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À lɛ̀ sí à tↄ́ gakuikɛɛ musu,","poem":1},{"lineBreak":true},{"text":"à à táaki lɛ́ à à tↄ́ bↄ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À be Ludanɛ: N yãkɛnanↄↄ naasi vĩ,","poem":1},{"lineBreak":true},{"text":"n gbãa bíta è tó n ibɛɛnↄ na ń sàsaa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Anduna píngi è kúɛnnɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è n táaki lɛ́ wà n tↄ́ bↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"À mↄ́ à Luda yãkɛnanↄ gwa,","poem":1},{"lineBreak":true},{"text":"yã kɛ̀ à kɛ̀ gbɛ̃nteenↄnɛ naasi vĩ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"À ísiaa lì gukori ũ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ swaa bikũ̀ kɛ̀sɛ.","poem":1},{"lineBreak":true},{"text":"Wà pↄnnaa kɛ à yã musu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ègↄ̃ kí blee kↄ̃n a gbãaao gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"à wɛ́ɛ ègↄ̃ kú boriinↄa.","poem":1},{"lineBreak":true},{"text":"Swãgbãadeenↄ tón dↄkɛoro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Boriinↄ, à wa Luda sáabu kpá,","poem":1},{"lineBreak":true},{"text":"à táakilɛna gↄ̃ kú a lɛ́n.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À wa wɛ̃̀ndi dã̀kpawe,","poem":1},{"lineBreak":true},{"text":"èe tó wa gbá sàtaro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Luda, zaakɛ n wa yↄ̃ n wa gwa,","poem":1},{"lineBreak":true},{"text":"n wa baasa lán kondogi bà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N wa ka kpɛ́siaan,","poem":1},{"lineBreak":true},{"text":"n aso tìisi dìwe wa kpɛɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ń tò wà dìwa lán sↄ̃ bà,","poem":1},{"lineBreak":true},{"text":"wa wɛ́ɛ tɛ́ mà, í dàwala,","poem":1},{"lineBreak":true},{"text":"ben n mↄwao gunnamana guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mɛ́ mↄ́ n ua mà sa'opↄ kɛ̀ wè ká tɛ́n à tɛ́ kũ o,","poem":1},{"lineBreak":true},{"text":"mɛ́ lù kɛ̀ má sɛ̀nnɛɛnↄ fĩa bonnɛ,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"yã kɛ̀ bↄ̀ ma lɛ́n ma nawɛ̃akɛgurↄ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mɛ́ saa omma kↄ̃n pↄ́ mɛ̀kpananↄ,","poem":1},{"lineBreak":true},{"text":"mɛ́ sãkaronↄ kpatannɛ,","poem":1},{"lineBreak":true},{"text":"mɛ́ n gbãgbã kↄ̃n zùswareenↄ kↄ̃n blèkofĩinↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Amↄa kɛ̀ á Luda vĩa vĩinↄ,","poem":1},{"lineBreak":true},{"text":"à mↄ́ à ma a píngi,","poem":1},{"lineBreak":true},{"text":"mɛ́ yã kɛ̀ à kɛ̀mɛɛ oare.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ma wii pɛ̀zi,","poem":1},{"lineBreak":true},{"text":"à táakilɛna da ma lɛ́n.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tó ma yã zaaa dà ma swɛ̃̀n,","poem":1},{"lineBreak":true},{"text":"lɛ Dii gì ma yã mazi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mↄde à ma yã mà,","poem":1},{"lineBreak":true},{"text":"ben à ma aduakɛna sì.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aubarikadeen Luda ũ,","poem":1},{"lineBreak":true},{"text":"èe gí ma aduakɛna maziro,","poem":1},{"lineBreak":true},{"text":"èe gímɛ a gbɛ̃kɛɛoro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}