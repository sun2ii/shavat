em":1},{"lineBreak":true},{"text":"baade píngi n táaki lɛ́,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"gbasa tↄↄtɛ blɛɛ kɛ,","poem":1},{"lineBreak":true},{"text":"Luda wa Luda é aubarika dawagu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Luda é aubarika dawagu,","poem":1},{"lineBreak":true},{"text":"anduna lɛzɛkideenↄ é vĩa kɛnɛ ń pingi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}