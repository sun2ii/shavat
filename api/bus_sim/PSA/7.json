{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":7,"content":[{"type":"heading","content":["Ǹ yã nnaa kpáma, Dii!"]},{"type":"hebrew_subtitle","content":["Lɛ̀ kɛ̀ Dauda sì Diinɛ Bɛyãmi bori Kusu yã musu."]},{"type":"verse","number":1,"content":[{"text":"Dii ma Luda, ma nanzi,","poem":1},{"lineBreak":true},{"text":"ǹ ma mì sí ǹ ma faaba kɛ","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃ pɛ̀ɛmaanↄ ↄzĩ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tó lɛnlo, aↄ̃é ma kɛ gyáigyai","poem":1},{"lineBreak":true},{"text":"lán músu è kɛńnɛ nàmɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃é ma kɛ̃kɛ̃kↄ̃rɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ke é ma mì síro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dii ma Luda, tó ma taari ke kɛ̀,","poem":1},{"lineBreak":true},{"text":"tó ma ↄↄ kú yã zaaan,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"tó ma à zaaa kɛ̀ ma gbɛ̃daaanɛ,","poem":1},{"lineBreak":true},{"text":"ke tó ma gbãaa mↄ̀ ma ibɛɛnɛ pã,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ǹ tó ma ibɛɛ pì pɛ́ɛma à ma kũ,","poem":1},{"lineBreak":true},{"text":"à kɛ̀sɛ pɛ́ɛpɛɛma tↄↄtɛ,","poem":1},{"lineBreak":true},{"text":"à ma vĩi bùsu'ãatɛ̃n.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ǹ fɛɛ ǹ zɛ kↄ̃n pↄfɛ̃o, Dii,","poem":1},{"lineBreak":true},{"text":"ǹ fɛɛ ma ibɛɛnↄzi ń nↄ̀sɛ kpã̀kpã yãnzi.","poem":1},{"lineBreak":true},{"text":"Ǹ vú, ma Luda,","poem":1},{"lineBreak":true},{"text":"ǹ yã gↄ̃gↄ̃ a zɛ́a.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ǹ tó gbɛ̃nↄ kakↄ̃anzi,","poem":1},{"lineBreak":true},{"text":"ǹ kí bleńnɛ zaa musu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dii, nɛɛ̀ yãkpaɛ kɛ kↄ̃n gbɛ̃nↄ.","poem":1},{"lineBreak":true},{"text":"Dii, ǹ tó yã bↄmao nna ma yãzɛde lɛ́n,","poem":1},{"lineBreak":true},{"text":"Luda Musude, ǹ yã kɛmɛ ma nↄ̀sɛpura lɛ́n.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Luda, ḿbe ń maa,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ nↄ̀sɛ kↄ̃n laasuuo kpokɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ gbɛ̃ zaaanↄ pãsĩkɛna mì dɛ,","poem":1},{"lineBreak":true},{"text":"ǹ gbɛ̃ maaanↄ gba zɛkii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Luda Musuden ma sɛngbango ũ,","poem":1},{"lineBreak":true},{"text":"è gbɛ̃ kɛ̀ aↄ̃ nↄ̀sɛ maaanↄ mì sí.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Luda è yãkpaɛ kɛ a zɛ́a,","poem":1},{"lineBreak":true},{"text":"è tó yã gↄ̃ vɛ̃ɛḿma gurↄ píngi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tó gbɛ̃ e a nↄ̀sɛ liɛro,","poem":1},{"lineBreak":true},{"text":"Luda è a fɛ̃ɛda lɛ́ kɛ","poem":1},{"lineBreak":true},{"text":"è a sá kú à kã.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"È a gↄ̃kɛbↄ kɛ̀ è gaa ińnɛnↄ kɛkɛ,","poem":1},{"lineBreak":true},{"text":"è a kà tɛ́deenↄ kpá sála.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ǹ gwa, yã zaaa è nↄ̀ dↄ gbɛ̃n,","poem":1},{"lineBreak":true},{"text":"ben è wahaa nↄ̀ sí à nɛ́ i ɛgɛɛ ũ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"È wɛ̀ɛ yↄ̃ gbɛ̃nↄnɛ zã̀azã takutɛɛ ũ,","poem":1},{"lineBreak":true},{"text":"ben è zu wɛ̀ɛ kɛ̀ à yↄ̃̀ pì guu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"À àisi pãsĩ è wí à musu,","poem":1},{"lineBreak":true},{"text":"à wɛ́ɛtãna gbɛ̃nↄa è wí à mìa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mɛ́ Dii sáabu kpá a maakɛɛ yãnzi,","poem":1},{"lineBreak":true},{"text":"mɛ́ Dii Musude tↄ́ bↄ kↄ̃n lɛ̀sinao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}