{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":70,"content":[{"type":"heading","content":["Wiipɛna mìsirizi"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"N yã nna Luda, ǹ ma mì sí,","poem":1},{"lineBreak":true},{"text":"Dii, ǹ kɛ kpakpaa ǹ mↄ́ ǹ dↄmalɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ tó wí gbɛ̃ kɛ̀ aↄ̃ↄe ma wɛɛ wà ma dɛɛnↄ kũ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ ń mì pɛ́ɛ.","poem":1},{"lineBreak":true},{"text":"Ǹ tó gbɛ̃ kɛ̀ aↄ̃ↄ yezi mà mↄ́nzi eenↄ kpɛɛ li,","poem":1},{"lineBreak":true},{"text":"aↄ̃ uu yãkↄ̃tɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃è bemɛ taalɛ taalɛɛnↄ,","poem":1},{"lineBreak":true},{"text":"ǹ tó aↄ̃ ɛara kↄ̃n wíyão.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃ↄe n kii wɛtɛɛnↄ pↄↄ kɛmma nna aↄ̃ yáa dↄ.","poem":1},{"lineBreak":true},{"text":"Gbɛ̃ kɛ̀ aↄ̃ↄ ye n mìsinazinↄ gↄ̃ bee Luda bíta.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Takaaside wɛ̃ndadeen ma ũ,","poem":1},{"lineBreak":true},{"text":"Luda, ǹ kɛ kpaa.","poem":1},{"lineBreak":true},{"text":"Ḿbe ma dↄnlɛri ũ kↄ̃n ma mìsirio,","poem":1},{"lineBreak":true},{"text":"Dii, ǹton gì kɛro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}