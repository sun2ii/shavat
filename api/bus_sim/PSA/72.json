{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":72,"content":[{"type":"heading","content":["Aduakɛna kínanɛ"]},{"type":"hebrew_subtitle","content":["Sulemanu lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Luda, ǹ dada kínanɛ à yãkpaɛ kɛ kↄ̃n yãpuraao,","poem":1},{"lineBreak":true},{"text":"ǹ tó kínɛ yã maaa kɛ lán nɛɛ̀ kɛ nà,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"lɛ à dↄ n gbɛ̃nↄnɛ aɛ a zɛ́a,","poem":1},{"lineBreak":true},{"text":"à yã gↄ̃gↄ̃ talakanↄnɛ súusu,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"kpiiinↄ é gbasa wà mↄ́ gbɛ̃nↄnɛ kↄ̃n aafiao,","poem":1},{"lineBreak":true},{"text":"sĩ̀sĩnↄ é tó aↄ̃gↄ̃ kú nnamana guu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kína é tó yã bↄ kↄ̃n talakanↄo nna,","poem":1},{"lineBreak":true},{"text":"eé takaaside nɛ́nↄ mì sí,","poem":1},{"lineBreak":true},{"text":"eé gbãamↄnnɛrinↄ dúgu zↄ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Eégↄ̃ kuu lán ↄfãntɛ̃ ègↄ̃ kuu nà,","poem":1},{"lineBreak":true},{"text":"lán mↄvura ègↄ̃ kuu nà wɛ̃̀ kↄ̃n wɛ̃̀o.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Eégↄ̃ dɛ lán loumana buraa bà,","poem":1},{"lineBreak":true},{"text":"lán mↄdↄ kɛ̀ è kpá tↄↄtɛa bà.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaanↄ é ↄ tá a gurↄↄa,","poem":1},{"lineBreak":true},{"text":"nnamana égↄ̃ bíta ai mↄↄ tóngↄ̃ kuu dↄro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Eé kí ble zaa ísia baa kɛ̀ kpa kↄ̃n baa kãa kpaao,","poem":1},{"lineBreak":true},{"text":"sɛna zaa Yuflatia ai gana anduna lɛ́a.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Borii kɛ̀ aↄ̃ↄ kú gbáa guunↄ é mↄ́ wà kúɛnɛ,","poem":1},{"lineBreak":true},{"text":"à ibɛɛnↄ é daɛ ń puua à aɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Taasisi kína kↄ̃n ísia baa kínanↄ é tángba kpáa,","poem":1},{"lineBreak":true},{"text":"Seba kↄ̃n Sɛba kínanↄ é mↄ́ wà gba danɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kínanↄ é mↄ́ wà kúɛ à aɛ ń píngi,","poem":1},{"lineBreak":true},{"text":"bori píngi é zↄ̀ blenɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Zaakɛ eé wɛ̃ndadee kɛ̀ aↄ̃ wiii dↄↄnↄ bↄmɛ,","poem":1},{"lineBreak":true},{"text":"eé takaasidee kɛ̀ aↄ̃ↄ dↄnlɛri vĩroonↄ mì sí.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Eé gbãasaideenↄ wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"eé takaasideenↄ bↄ gaa lɛ́zĩ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Eé ń bↄ gbãamↄnnɛrinↄ ↄzĩ kↄ̃n gbɛ̃ pãsĩnↄo,","poem":1},{"lineBreak":true},{"text":"zaakɛ à ye ń arukwɛɛnaziro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Luda kína dↄ̃ kↄ̃n aafiao!","poem":1},{"lineBreak":true},{"text":"Wàgↄ̃ à gbaa Seba bùsu vura,","poem":1},{"lineBreak":true},{"text":"wàgↄ̃ adua kɛɛnɛ yãana sai,","poem":1},{"lineBreak":true},{"text":"wàgↄ̃ sa maaa oonɛ gurↄ píngi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ǹ tó burapↄnↄ kɛ à bùsun maamaa,","poem":1},{"lineBreak":true},{"text":"à lánↄ gↄ̃ da sĩ̀sĩnↄ musu sí plɛ̀plɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ nɛ́ i wà pia lán Lɛbanↄ lákpɛ bà,","poem":1},{"lineBreak":true},{"text":"aↄ̃ gbã lán kàbapu bà sɛ̃̀tɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ǹ tó à tↄ́ gↄ̃ kuu gurↄ píngi","poem":1},{"lineBreak":true},{"text":"lán ↄfãntɛ̃ bà,","poem":1},{"lineBreak":true},{"text":"bori píngi é aubarika e à gãzĩ,","poem":1},{"lineBreak":true},{"text":"wé à tↄ́ nnaa sí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Aubarikadeen Dii Luda, Isarailinↄ Luda!","poem":1},{"lineBreak":true},{"text":"Àmbe è yãbↄnsaɛnↄ kɛ ado.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wàgↄ̃ à tↄ́ gakuidee bↄↄ gurↄ píngi!","poem":1},{"lineBreak":true},{"text":"À tó à gakui da andunala píngi!","poem":1},{"lineBreak":true},{"text":"Aami! Aami!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["Yɛsɛ nɛ́ Dauda aduakɛna lɛ́n gwe."]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}