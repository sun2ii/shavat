{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":73,"content":[{"type":"heading","content":["Zaakɛrinↄ nnamana"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Luda è yã maaa kɛ Isarailinↄnɛ yãpuramɛ,","poem":1},{"lineBreak":true},{"text":"atɛ̃nsa nↄ̀sɛpuradeenↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mapi sↄ̃, ma kĩi kũ̀ lɛɛnao,","poem":1},{"lineBreak":true},{"text":"ma gbá yezi à satamɛ yã.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kɛ̀ ma zaakɛrinↄ kuuna maaa è,","poem":1},{"lineBreak":true},{"text":"ma ĩadãri pìnↄ gwena ni dɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yãke è kpáńnɛro,","poem":1},{"lineBreak":true},{"text":"aafia mↄ̀ḿma bensↄ̃ aↄ̃ↄ mɛ̀kpana.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aↄ̃è nawɛ̃a kɛ lán danↄ bàro,","poem":1},{"lineBreak":true},{"text":"aↄ̃è gyãa kɛ lán danↄ bàro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aↄ̃è ĩadãna da ń waalɛ lán kãmbɛɛ bà,","poem":1},{"lineBreak":true},{"text":"aↄ̃è pãsĩkɛɛ da pↄ́kãsãa ũ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aↄ̃ swɛ̃̀ kɛ̀ gbãa yãzaakɛnao,","poem":1},{"lineBreak":true},{"text":"yã vãi ń nↄ̀sɛ pà.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Aↄ̃è gbɛ̃ lalandi kɛ aↄ̃è yã zaaa liḿma,","poem":1},{"lineBreak":true},{"text":"aↄ̃è gbãaa mↄ́ńnɛ ń gwena bítakɛɛ yãnzi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aↄ̃è be: Luda pita wà ↄsi ká,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ aↄ̃ yã bé è ble anduna guu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bee yãnzi wè tá ń kpa,","poem":1},{"lineBreak":true},{"text":"wè yã kɛ̀ aↄ̃ↄ ò píngi sí yãpuraa ũ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Aↄ̃è be: Luda é kɛ dɛa à dↄ̃ↄ?","poem":1},{"lineBreak":true},{"text":"Luda Musude dↄ̃na kà lɛn yↄ́?","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ǹ gwa, zaakɛrinↄ è yãke kã̀hãn kɛro,","poem":1},{"lineBreak":true},{"text":"aↄ̃ gwena ègↄ̃ kaara gurↄ píngimɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ase ma nↄ̀sɛ pura pãn yↄ́?","poem":1},{"lineBreak":true},{"text":"Ma a ↄↄ bↄ̀ɛ taarin wásawasa pãmɛↄ́?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nɛɛ̀gↄ̃ ma gbɛ̃ɛ gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀gↄ̃ ma swã sukãamɛ lán guu e dↄↄ nà.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tó ma zɛ kↄ̃n yã beee taka onao,","poem":1},{"lineBreak":true},{"text":"bee égↄ̃ dɛ bↄna n gbɛ̃nↄ kpɛɛ yã ũmɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kɛ̀ ma laasuu lɛ̀ yã pìzi mà e mà dↄ̃,","poem":1},{"lineBreak":true},{"text":"à kɛ̀mɛ zĩ'ũ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sé kɛ̀ ma gɛ̃ Luda kúkiin,","poem":1},{"lineBreak":true},{"text":"ben ma wɛ́ɛ gbasa à kɛ̃̀ lán aↄ̃é yãa nà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"N ń kpá guzãɛa yãpura,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ ↄ sↄ̃ńzi aↄ̃ lɛ́ɛ wà kaatɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aↄ̃è gↄ̃ kaatɛna pↄ́ ũ kãndo,","poem":1},{"lineBreak":true},{"text":"vĩapↄnↄ è ń le aↄ̃ yãao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Lán nanaa è gɛ̃ ĩa nà tó gbɛ̃ vù,","poem":1},{"lineBreak":true},{"text":"tó n fɛɛ Dii, ǹ tó aↄ̃ gɛ̃ ĩa lɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kɛ̀ ma nↄ̀sɛ yàka,","poem":1},{"lineBreak":true},{"text":"bensↄ̃ ma pↄↄ sia kũ̀,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ma kɛ yↄ̃nkↄ, má yãke dↄ̃ro,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃nnɛ lán nↄ̀bↄsɛ̃tɛ bà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Baa kↄ̃n beeeo mɛɛ̀gↄ̃ kúnyo,","poem":1},{"lineBreak":true},{"text":"ń ma kũna ma ↄplaaa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ dↄmɛ aɛ kↄ̃n n lɛ́dammanao,","poem":1},{"lineBreak":true},{"text":"nɛ́ yãa ǹ ma sí ai n gakui guu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"N baasiro, dén ma wɛ́ɛ dↄzi musuu?","poem":1},{"lineBreak":true},{"text":"N baasiro pↄ́ke nii e ma dɛ anduna guuro.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Baa tó ma mɛ̀ kↄ̃n ma swɛ̃̀o e yãaa,","poem":1},{"lineBreak":true},{"text":"Ludan ma swɛ̃̀ gbãa'ekii ũ,","poem":1},{"lineBreak":true},{"text":"àmbe ma baka ũ gurↄ píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Gbɛ̃ kɛ̀ aↄ̃ kɛ̃̀mmaanↄ é mì dɛ,","poem":1},{"lineBreak":true},{"text":"nɛ́ gbɛ̃ kɛ̀ aↄ̃ bↄ̀ n kpɛɛnↄ kaatɛ.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Luda, ma sↄ̃nzina bé à kɛ̀mɛ nna,","poem":1},{"lineBreak":true},{"text":"Dii Luda, ma n kɛ ma utɛkii ũ,","poem":1},{"lineBreak":true},{"text":"mɛ́ n yãkɛnanↄ tↄ̃kɛ̃ńnɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}