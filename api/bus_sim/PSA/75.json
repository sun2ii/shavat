{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":75,"content":[{"type":"heading","content":["Ludan yãkpaɛkɛri ũ"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Wa sáabu kɛ̀nnɛ Luda, wa sáabu kɛ̀nnɛ.","poem":1},{"lineBreak":true},{"text":"Tó wà n yãbↄnsaɛnↄ tↄ̃kɛ̃̀, nɛɛ̀gↄ̃ kú kĩi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Luda bè: Ma gurↄↄ dìɛ","poem":1},{"lineBreak":true},{"text":"kɛ̀ mɛ́ yãkpaɛ kɛ a zɛ́a.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tó anduna nìgã kↄ̃n gbɛ̃ kɛ̀ aↄ̃ kúnnↄ ń píngi,","poem":1},{"lineBreak":true},{"text":"mámbe mɛɛ̀ à wesagbanↄ kũ gíngin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɛɛ̀ o wadadeenↄnɛ aↄ̃ton ĩa dãro,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ o zaakɛrinↄnɛ aↄ̃ton kùsɛ biiro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Àton kùsɛ bii ludambɛaro,","poem":1},{"lineBreak":true},{"text":"àton waa nↄnↄmaziro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Zaakɛ gbãaa è bↄ ↄfãntɛ̃bↄɛ kpa ke a gɛ̃kpɛn kparo,","poem":1},{"lineBreak":true},{"text":"è bↄ gbáanlo,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ludan yãkpaɛkɛri ũ,","poem":1},{"lineBreak":true},{"text":"àmbe è gbɛ̃ doo lago à gbɛ̃ doo kaara.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Togoo kú Dii ↄzĩ, í gbãaa kán à pà,","poem":1},{"lineBreak":true},{"text":"èe sɛsɛɛ à pↄfɛ̃ ũ.","poem":1},{"lineBreak":true},{"text":"È kú anduna zaakɛrinↄnɛ ń píngi,","poem":1},{"lineBreak":true},{"text":"ben aↄ̃è mi wà yãa láe kↄ̃n à gbↄ̃̀o.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mapi sↄ̃, mɛ́gↄ̃ yã pì oo gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"mɛ́ Yakubu Luda táaki lɛ́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mɛ́ zaakɛrinↄ koba ɛ́'ɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ maaanↄ koba sↄ̃, mɛ́ sɛ́ musu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}