{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":76,"content":[{"type":"heading","content":["Ludan zĩ̀blena gbãaa ũ"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀. Wè sí kↄ̃n mↄrↄnↄo."]},{"type":"verse","number":1,"content":[{"text":"Wà Luda dↄ̃ Yuda bùsummɛ,","poem":1},{"lineBreak":true},{"text":"à tↄ́ bíta Isarailinↄ tɛ́.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À bisakutaa kú Salɛmu,","poem":1},{"lineBreak":true},{"text":"à kúkii kú Zayↄn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zaa gwen à kà wãaanↄ ɛ̀'ɛn","poem":1},{"lineBreak":true},{"text":"kↄ̃n sɛngbangonↄ kↄ̃n fɛ̃ɛdaanↄ kↄ̃n zĩ̀kabↄnↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nɛɛ̀ guu pu nɛɛ̀gↄ̃ tɛ́ kɛɛ,","poem":1},{"lineBreak":true},{"text":"n bítakɛɛ dɛ kpiii kɛ̀ aↄ̃ kuu gurↄ pínginↄla.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N kùgbãadeenↄ gbãaa sìḿma,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ daɛna kↄ̃n ga'iio,","poem":1},{"lineBreak":true},{"text":"gↄ̃ gbãaa pìnↄ dokee e fↄ̃ à a ↄↄ sɛ̀ro.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yakubu Luda, n kpãkɛ̃ńzi,","poem":1},{"lineBreak":true},{"text":"ben sↄ̃nↄ kↄ̃n ń sↄ̃goronↄ gↄ̃̀ kaɛna.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ḿbe ń naasi vĩ ndo,","poem":1},{"lineBreak":true},{"text":"tó n pↄ́ bↄ̀ n yĩzĩ,","poem":1},{"lineBreak":true},{"text":"dé bé eé fↄ̃ à zɛ n aɛɛ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zaa musu n yãkpaɛ kɛ̀,","poem":1},{"lineBreak":true},{"text":"vĩa anduna kũ̀, à yĩ̀tɛ kítikiti,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"zĩ kɛ̀ Luda, n fɛɛ ǹ yã gↄ̃gↄ̃ andunanɛ","poem":1},{"lineBreak":true},{"text":"lɛ ǹ gbãasaideenↄ mì sí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"N pↄfɛ̃na gbɛ̃nↄzi è n tↄ́ bↄ,","poem":1},{"lineBreak":true},{"text":"n pↄfɛ̃ kpaaa ègↄ̃ dↄ n pii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"À lù sɛ́ Dii a Ludanɛ à à fĩa bo.","poem":1},{"lineBreak":true},{"text":"Amↄa kɛ̀ á ligawaziinↄ, à mↄ́","poem":1},{"lineBreak":true},{"text":"à Luda kɛ̀ dɛ wàgↄ̃ à vĩa vĩi gba pↄ́.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"È kpatablerinↄ kã busa,","poem":1},{"lineBreak":true},{"text":"è tó vĩa anduna kínanↄ kũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}