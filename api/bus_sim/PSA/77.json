{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":77,"content":[{"type":"heading","content":["Luda dↄnlɛ bɛgɛkɛna nawɛ̃a guu"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Ma wii pɛ̀ Ludazi ma à sìsi,","poem":1},{"lineBreak":true},{"text":"ma wii pɛ̀ Ludazi lɛ à ma yã ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kɛ̀ má kú nawɛ̃a guu ma Dii kii wɛ̀tɛ,","poem":1},{"lineBreak":true},{"text":"ma ↄ sɛ̀ musu gwãavĩ kámmabona sai,","poem":1},{"lineBreak":true},{"text":"ma làakari wè à kpáɛro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kɛ̀ ma laasuu tà Luda kiia, ben ma ã'ã,","poem":1},{"lineBreak":true},{"text":"kɛ̀ ma à yã wàari pà, ben ma suuna kɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N ma wɛ́ɛ tɛ̃̀ iii,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ bídi guu ma kora yãzi mà o.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ma dↄ yã ziinↄn","poem":1},{"lineBreak":true},{"text":"kↄ̃n wɛ̃̀ kɛ̀ gɛ̃̀tɛnↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ma laasuu lɛ̀ ma swɛ̃̀ guu gwãavĩ,","poem":1},{"lineBreak":true},{"text":"ma a zĩnda là mà wɛtɛ mà dↄ̃.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ma bè: Dii gìwazi mámmann yↄ́?","poem":1},{"lineBreak":true},{"text":"À pↄↄ é kɛwa nna dↄroo?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À gbɛ̃kɛɛ yã̀a mámmann yↄ́?","poem":1},{"lineBreak":true},{"text":"À yã égↄ̃ fɛɛna gurↄ píngin yↄ́?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wa wɛ̃ndagwana yã sã̀ Ludann yↄ́?","poem":1},{"lineBreak":true},{"text":"À pↄ fɛ̃̀wazi, eé sósobi kɛwao dↄroo?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ben ma bè: Yã kɛ̀ ↄ̃̀maan yɛ̀.","poem":1},{"lineBreak":true},{"text":"Luda Musude ↄↄ bùsawe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mɛ́ laasuu lɛ́ Dii yãbↄnsaɛnↄa,","poem":1},{"lineBreak":true},{"text":"mɛ́ dↄ yã kɛ̀ à kɛ̀ yãanↄn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mɛ́ n dabuyãkɛnanↄ wàari pá píngi,","poem":1},{"lineBreak":true},{"text":"mɛ́ n yãbitakɛnanↄ da ma swɛ̃̀n.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Luda, n zɛ́ kú adona.","poem":1},{"lineBreak":true},{"text":"Dii kpare bíta bè à kà lán wa Luda bà?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ḿbe Luda yãbↄnsaɛkɛri ũ,","poem":1},{"lineBreak":true},{"text":"n n gbãaa mↄ̀ boriinↄnɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N n gbɛ̃nↄ mì sì kↄ̃n n gã̀sã gbãaao,","poem":1},{"lineBreak":true},{"text":"wamↄwa Yakubu kↄ̃n Yusufu boriinↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kɛ̀ ísia wɛ́ɛ sìnlɛ Luda,","poem":1},{"lineBreak":true},{"text":"kɛ̀ ísia wɛ́ɛ sìnlɛ, ben à kↄ́tↄ kpà,","poem":1},{"lineBreak":true},{"text":"à dègedege ai a lↄ̀n.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ludambɛɛ í kwɛ̀ɛ,","poem":1},{"lineBreak":true},{"text":"lapatana kĩi gↄ̃ dↄ musu,","poem":1},{"lineBreak":true},{"text":"n kànↄↄ e fãa loupina ũ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N pũtãna kĩi dↄ zàga'ĩa guu,","poem":1},{"lineBreak":true},{"text":"n loupina anduna pù píngi,","poem":1},{"lineBreak":true},{"text":"tↄↄtɛ kɛ̀ gìri, à nìgãnigã.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N zɛ́ bↄ̀ ísiaan,","poem":1},{"lineBreak":true},{"text":"n gɛ̃kii kɛ̀ í bítanↄ dagura,","poem":1},{"lineBreak":true},{"text":"wèe n kɛ̀sɛgbɛ ero.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N dↄ n gbɛ̃nↄnɛ aɛ lán sã kpàsa bà","poem":1},{"lineBreak":true},{"text":"Musa kↄ̃n Arunao gãzĩ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}