{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":79,"content":[{"type":"heading","content":["Wɛ̃nda ↄ́ↄdↄna Yerusalɛmu wina yã musu"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Luda, bori pãndenↄ sì n bùsun,","poem":1},{"lineBreak":true},{"text":"aↄ̃ n kpɛ́ kɛ̀ à kú adona yàka,","poem":1},{"lineBreak":true},{"text":"aↄ̃ Yerusalɛmu wìwi wà dàɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aↄ̃ n zↄ̀blerinↄ gɛ̀ kpà bãanↄa,","poem":1},{"lineBreak":true},{"text":"aↄ̃ n yãmarinↄ mɛ̀ tò nↄ̀bↄ pãsĩnↄnɛ pↄ́blee ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wà ń aru kwɛ̀ɛ lán í bà Yerusalɛmu bĩikpɛɛ,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ke kuu à ń vĩiro.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wa gↄ̃ sↄ̃sↄ̃na pↄ́ ũ wa saɛdeenↄnɛ,","poem":1},{"lineBreak":true},{"text":"fabona pↄ́ ũ gbɛ̃ kɛ̀ aↄ̃ↄ ligawazinↄnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dii, nɛ́gↄ̃ pↄ fɛ̃ɛwazi ai bↄrɛmɛ?","poem":1},{"lineBreak":true},{"text":"N pɛ̃tɛ̃ tɛ́ égↄ̃ kũu gurↄ píngin yↄ́?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ǹ pↄfɛ̃ pita borii kɛ̀ aↄ̃ↄ n dↄ̃roonↄa,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃è n sísiroonↄ bùsunↄa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zaakɛ aↄ̃ Yakubu boriinↄ blè,","poem":1},{"lineBreak":true},{"text":"aↄ̃ ń bùsu dɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ǹton wa denↄ durunnↄ wí wa musuro.","poem":1},{"lineBreak":true},{"text":"Ǹ wɛ̃nda dↄ̃we kpakpaa,","poem":1},{"lineBreak":true},{"text":"zaakɛ wa busa wa gↄ̃ búgubugu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ǹ dↄwalɛ, Luda wa mìsiri.","poem":1},{"lineBreak":true},{"text":"Ǹ wa mì sí lɛ n tↄ́ bↄ,","poem":1},{"lineBreak":true},{"text":"ǹ wa durunnↄ kɛ̃we n tↄ́ yãnzi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bↄ́yãnzin nɛ́ tó bori pãndenↄ wa la wà be:","poem":1},{"lineBreak":true},{"text":"Wa Ludaa kú mámɛee?","poem":1},{"lineBreak":true},{"text":"Ǹ tó bori pãndenↄ gↄ̃ dↄ̃ wa wáa","poem":1},{"lineBreak":true},{"text":"kɛ̀ nɛɛ̀ n zↄ̀blerinↄ dɛdɛna gɛ̃ɛ boḿma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹ tó zĩ̀zↄnↄ ↄ́ↄdↄna gɛ̃ n swãn,","poem":1},{"lineBreak":true},{"text":"ǹ gbɛ̃ kɛ̀ aↄ̃ↄ kú ga lɛ́zĩ pìnↄ bↄ","poem":1},{"lineBreak":true},{"text":"kↄ̃n n gã̀sã gbãaao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ǹ lalandi kɛ̀ bori pãnde kɛ̀ ligawazinↄↄ kɛ̀nnɛɛ","poem":1},{"lineBreak":true},{"text":"fĩa boḿma gɛ̃̀n swɛɛplaa, Dii.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wamↄwa n gbɛ̃nↄ, n kpàsa sãanↄ,","poem":1},{"lineBreak":true},{"text":"wé gbasa wàgↄ̃ n sáabu kpaa gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"wégↄ̃ n tↄ́ tↄ̃kɛ̃ɛńnɛ ai wa boriia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}