reak":true},{"text":"n à kà kín kↄ̃n gakuio kↄ̃n bɛ̀ɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ń tò à kí blè pↄ́ kɛ̀ ń kɛ̀nↄa,","poem":1},{"lineBreak":true},{"text":"ń tò pↄ́ sãnda píngi mì sìɛnɛ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"sãanↄ kↄ̃n zùnↄ kↄ̃n nↄ̀bↄsɛ̃tɛnↄ píngi,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"bãanↄ kↄ̃n kpↄ̀nↄ kↄ̃n pↄ́ kɛ̀ kú ísiaannↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dii wa Dii, n tↄ́ bↄna anduna guu píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}