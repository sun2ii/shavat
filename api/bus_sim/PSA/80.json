{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":80,"content":[{"type":"heading","content":["Isarailinↄ suna ń gwena ziia aduakɛna"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Ǹ swã kpá, Isarailinↄ Dↄn'aɛde,","poem":1},{"lineBreak":true},{"text":"mmↄn kɛ̀ nɛɛ̀ Yusufu boriinↄ dã lán sãa bà.","poem":1},{"lineBreak":true},{"text":"Ǹ bↄ ǹ mↄ́, mmↄn kɛ̀ ń vɛ̃ɛna kɛrubunↄ dagura,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ǹ dↄ Ɛflaimu boriinↄnɛ aɛ","poem":1},{"lineBreak":true},{"text":"kↄ̃n Bɛyãmi boriinↄ kↄ̃n Manase boriinↄ.","poem":1},{"lineBreak":true},{"text":"Ǹ fɛɛ kↄ̃n n gbãaao, ǹ mↄ́ ǹ wa mì sí!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Luda, ǹ tó wà ɛara wà su wa gwena ziin,","poem":1},{"lineBreak":true},{"text":"ǹ uu werewa, ǹ wa mì sí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dii Luda Zĩ̀kpɛde,","poem":1},{"lineBreak":true},{"text":"nɛ́ fɛ̃ ǹ gí n gbɛ̃nↄ aduakɛna sízi ai bↄrɛmɛ?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N wɛ́ɛ'i dↄ̀ńnɛ ń pↄ́mina ũ,","poem":1},{"lineBreak":true},{"text":"n ń wɛ́ɛ'i yↄ̃̀ńnɛ à pↄ́ pà, aↄ̃ↄ mì.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ń tò wa gↄ̃ fabona pↄ́ ũ wa saɛdeenↄnɛ,","poem":1},{"lineBreak":true},{"text":"wa ibɛɛnↄↄ e wa lalandi kɛɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Luda Zĩ̀kpɛde, ǹ tó wà su wa gwena ziia,","poem":1},{"lineBreak":true},{"text":"ǹ uu werewa ǹ wà mì sí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"N geepi lí wùrɛ Igipiti,","poem":1},{"lineBreak":true},{"text":"n pɛ boriinↄa, ben ń lí pì pɛ̀ aↄ̃ gbɛ̀n.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N guu kɛ̀kɛnɛ à kãsãa pɛ̀ɛ,","poem":1},{"lineBreak":true},{"text":"ben à ↄ tà à guu sì.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À ↄra dà kpiiinↄla,","poem":1},{"lineBreak":true},{"text":"à gã̀nↄ dɛ sida lí bítanↄla.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"À ↄ tà à kà ai ísia lɛ́a,","poem":1},{"lineBreak":true},{"text":"à ↄnɛnↄ kà ai Yuflatizi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bↄ́yãnzin n à kara gbòrozi","poem":1},{"lineBreak":true},{"text":"lɛ gbɛ̃ kɛ̀ aↄ̃ↄe gɛ̃tɛɛnↄ gↄ̃ ↄ maɛɛ à nɛ́zi?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kyàkpanↄ è lɛ́ kázi wà bi,","poem":1},{"lineBreak":true},{"text":"nↄ̀bↄsɛ̃tɛnↄ è mↄ́ wà à lá ble.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N yã nna! Luda Zĩ̀kpɛde, ǹ ɛara ǹ aɛ dↄwa!","poem":1},{"lineBreak":true},{"text":"Zaa musu ǹ wɛ́ɛ kpáɛ ǹ gwa!","poem":1},{"lineBreak":true},{"text":"Ǹ làakari dↄ geepi lí kɛ̀a,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"borii kɛ̀ ń pɛ̀ n zĩndaa,","poem":1},{"lineBreak":true},{"text":"nɛ́ kɛ̀ ń sì n pↄ́ ũu pì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wà n geepi lí pì zↄ̃̀, wà tɛ́ sↄ̃̀a,","poem":1},{"lineBreak":true},{"text":"n wɛ́ɛ tɛ̃aa pìtiḿma, ben aↄ̃ↄe kaatɛɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ǹ ↄ kúɛ gbɛ̃ kɛ̀ kú n ↄplaazia,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ntee nɛ́ kɛ̀ ń sɛ̀ n pↄ́ ũu pì,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"wé kɛ̃mma dↄro.","poem":1},{"lineBreak":true},{"text":"Ǹ wa kuuna kɛkɛ ǹ kɛwe, wé n sísi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dii Luda Zĩ̀kpɛde,","poem":1},{"lineBreak":true},{"text":"ǹ tó wà su wa gwena ziia,","poem":1},{"lineBreak":true},{"text":"ǹ uu werewa ǹ wa mì sí.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}