{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":81,"content":[{"type":"heading","content":["Isarailinↄ zĩbaa lɛ̀"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"À guda dↄ Luda wa gbãaaa,","poem":1},{"lineBreak":true},{"text":"à pↄnna wii pɛ́ Yakubu boriinↄ Ludaa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À lɛ̀ dↄ à bata lɛ́","poem":1},{"lineBreak":true},{"text":"kↄ̃n mↄrↄ'ↄ nnaao kↄ̃n kuntigio.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À kuu pɛ́ mↄ dufu bↄnao,","poem":1},{"lineBreak":true},{"text":"à pɛ́ tó mↄↄ ↄzi kɛ̀ wa zĩbaagurↄ,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"zaakɛ à dɛ doka ũ Isarailinↄnɛmɛ.","poem":1},{"lineBreak":true},{"text":"yã kɛ̀ Yakubu boriinↄ Ludaa dìɛn gwe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À yã pì dà Yusufu boriinↄnɛ","poem":1},{"lineBreak":true},{"text":"gurↄↄ kɛ̀ à vĩ̀ Igipiti bùsula.","poem":1},{"lineBreak":true},{"text":"Aↄ̃ kòto kɛ̀ wà dↄ̃roo mà à bè:","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma asoo gò a gã̀n,","poem":1},{"lineBreak":true},{"text":"ma a ↄↄ bↄ̀ɛ ɛ̃ɛbona zĩin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A wii pɛ̀mazi nawɛ̃akɛgurↄ, ben ma a bↄ,","poem":1},{"lineBreak":true},{"text":"ma weala zaa louvĩnan,","poem":1},{"lineBreak":true},{"text":"ma a lɛ ma a gwa zaa Mɛriba í kiia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"À swã kpá ma gbɛ̃nↄ, mɛ́ lɛ́ daawa,","poem":1},{"lineBreak":true},{"text":"amↄa Isarailinↄ, tó é ma yã ma dé!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Àtongↄ̃ bori zĩ̀tↄnↄ tãa vĩ a tɛ́ro,","poem":1},{"lineBreak":true},{"text":"àton kúɛ dii pãndenɛro.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mámbe Dii a Luda ũ,","poem":1},{"lineBreak":true},{"text":"ma a bↄɛ Igipiti.","poem":1},{"lineBreak":true},{"text":"À a lɛ́ wɛ̃, mɛ́ tó àgↄ̃ kãna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mↄde Isarailinↄ gì ma yã mazi,","poem":1},{"lineBreak":true},{"text":"ma gbɛ̃ pìnↄↄ e mì siɛmɛro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ben ma ń tó kↄ̃n ń swãgbãakɛɛo,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ tɛ́ ń zĩnda pↄyezizi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tó wà be Isarailinↄ é ma yã ma,","poem":1},{"lineBreak":true},{"text":"tó ma gbɛ̃nↄↄ tɛ́ ma yãzi,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"lɛ mɛ́ ń ibɛɛnↄ sↄ̃ɛ gↄ̃ↄgↄ̃ↄ,","poem":1},{"lineBreak":true},{"text":"mɛ́ ↄ sↄ̃ ń zangurinↄzi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ma zangurinↄ é na ń sàsaa ma aɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ wɛ́ɛtãmmana égↄ̃ yãana vĩro.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mɛ́ gbasa mà a gwa kↄ̃n pↄ́wɛɛ maaao,","poem":1},{"lineBreak":true},{"text":"mɛ́ ɛara mà gbɛ̀ zↄ́'i kpáawa à mↄ́awa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}