{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":82,"content":[{"type":"heading","content":["Yãkpaɛkɛna kↄ̃n gbãadeenↄ"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Ludaa vɛ̃ɛna pari kakↄ̃ana guu,","poem":1},{"lineBreak":true},{"text":"èe yãkpaɛ kɛɛ kↄ̃n Ludanↄ à bè:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ai bↄrɛn égↄ̃ yãkpaɛ kɛɛ a kpɛɛgãnda","poem":1},{"lineBreak":true},{"text":"à yã sí kↄ̃n zaakɛrinↄo?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À yã nnaa kpá gbãasaideenↄa kↄ̃n tonɛnↄ,","poem":1},{"lineBreak":true},{"text":"à zɛ kↄ̃n takaasideenↄ","poem":1},{"lineBreak":true},{"text":"kↄ̃n gbɛ̃ kɛ̀ wèe wɛ́ɛ tãaḿmanↄo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À gbãasaideenↄ kↄ̃n wɛ̃ndadeenↄ mì sí,","poem":1},{"lineBreak":true},{"text":"à ń bↄ zaakɛrinↄ ↄzĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Aↄ̃ yãke dↄ̃ro, aↄ̃ↄ à ke gbá zɛ́ dↄ̃ro,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ kú gusiaa guumɛ,","poem":1},{"lineBreak":true},{"text":"ben anduna nìgã ai a gĩzĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ma bè Ludanↄn a ũ,","poem":1},{"lineBreak":true},{"text":"Luda Musude nɛ́nↄn a ũ a píngi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Baa kↄ̃n beeeo é ga gbɛ̃ntee gana ũmɛ,","poem":1},{"lineBreak":true},{"text":"é kpá guuzi lán gbãade kpaaanↄ bàmɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Luda, ǹ fɛɛ ǹ yãkpaɛ kɛ kↄ̃n andunao,","poem":1},{"lineBreak":true},{"text":"zaakɛ bori píngi nɛ́ n pↄ́mɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}