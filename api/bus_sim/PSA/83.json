{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":83,"content":[{"type":"heading","content":["Ibɛɛnↄ kpana Ludaa"]},{"type":"hebrew_subtitle","content":["Asafa lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Luda, ǹtongↄ̃ yĩtɛnaro,","poem":1},{"lineBreak":true},{"text":"n lɛ́ tóngↄ̃ nakↄ̃anaro,","poem":1},{"lineBreak":true},{"text":"ǹton zɛ sitiigiro, Luda.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ n ibɛɛnↄ gwa lán aↄ̃ fɛ̀ɛ wà zɛ̀ nà,","poem":1},{"lineBreak":true},{"text":"n zangurinↄↄ e ń mì zuzuu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aↄ̃ↄe ↄ̃ndↄ̃ↄ kɛɛ n gbɛ̃nↄzi,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄe lɛ́ kpaakↄ̃sↄ̃ n gbɛ̃ yenzideenↄzi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aↄ̃ↄe bee: À mↄ́ wà ń borii bↄ,","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃ tↄ́ Isaraili tóngↄ̃ dↄ gbɛ̃ken dↄro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aↄ̃ lɛ́ kpàkↄ̃sↄ̃, aↄ̃ yã kↄ̃sɛ̀,","poem":1},{"lineBreak":true},{"text":"aↄ̃ lɛdolɛ kɛ̀ kↄ̃o wà fɛɛnzi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ɛdↄmunↄ kↄ̃n Sumaila boriinↄ","poem":1},{"lineBreak":true},{"text":"kↄ̃n Mↄabunↄ kↄ̃n Agyara boriinↄ","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kↄ̃n Gebalideenↄ kↄ̃n Amↄninↄ","poem":1},{"lineBreak":true},{"text":"kↄ̃n Amalɛkinↄ kↄ̃n Filisitininↄ kↄ̃n Tayadeenↄ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Baa se Asirianↄ nàḿma dↄ,","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃ ↄ da Lutu boriinↄa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ǹ kɛńnɛ lán ń kɛ̀ Midiãnↄnɛ nà,","poem":1},{"lineBreak":true},{"text":"lán ń kɛ̀ Sisera kↄ̃n Yabĩonɛ nà Kisↄ̃zi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N ń kɛ́ dúgudugu Ɛndↄ,","poem":1},{"lineBreak":true},{"text":"ben aↄ̃ gↄ̃̀ kaɛna tↄↄtɛ lán busa bà.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ǹ kɛ ń wɛ̃ɛnɛnↄnɛ","poem":1},{"lineBreak":true},{"text":"lán wà kɛ̀ Orɛbu kↄ̃n Zeebuonɛ nà.","poem":1},{"lineBreak":true},{"text":"Ǹ kɛ ń kínɛnↄnɛ","poem":1},{"lineBreak":true},{"text":"lán wà kɛ̀ Zɛba kↄ̃n Zalamunaonɛ nà.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aↄ̃pinↄ bé wà bè yã,","poem":1},{"lineBreak":true},{"text":"wà Luda sãdãkii sɛ́ ń pↄ́ ũ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ma Luda, ǹ tó aↄ̃ gↄ̃ lán ĩampuu sɛ̃̀ bà","poem":1},{"lineBreak":true},{"text":"lán ése ũkã kɛ̀ ĩa e sɛ́ɛɛ bà.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Lán dàko è tɛ́ kũ nà,","poem":1},{"lineBreak":true},{"text":"kesↄ̃ lán tɛ́ è kpiiinↄ ble nà,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ǹ pɛ́ɛńzi kↄ̃n n zàga'ĩao,","poem":1},{"lineBreak":true},{"text":"ǹ tó n ĩa pãsĩ swɛ̃̀ kɛ̃ńgu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ǹ tó wí gɛ̃ ń wɛ́ɛn,","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃ↄ n gbãaa dↄ̃ Dii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Wí égↄ̃ ń kũu gurↄ píngi kↄ̃n bídio,","poem":1},{"lineBreak":true},{"text":"aↄ̃é bↄru kpɛɛ wà kaatɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ǹ tó aↄ̃gↄ̃ dↄ̃ kɛ̀ n tↄ́n Dii,","poem":1},{"lineBreak":true},{"text":"ḿbe Luda Musude ũ anduna guu píngi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}