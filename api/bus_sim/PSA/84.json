{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":84,"content":[{"type":"heading","content":["Luda ua bɛgɛkɛna"]},{"type":"hebrew_subtitle","content":["Kora boriinↄ lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"N kúkii maa fá, Dii Zĩ̀kpɛde!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɛ́ɛ Dii ua bɛgɛ kɛɛ ai guu e liima,","poem":1},{"lineBreak":true},{"text":"ma nini kↄ̃n ma mɛ̀o e lugaa Luda Wɛ̃̀ndidezi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dii Zĩ̀kpɛde ma Kína ma Luda,","poem":1},{"lineBreak":true},{"text":"baa sã̀tɛ̃ sà dↄ̀ n gbãgbãkii saɛ,","poem":1},{"lineBreak":true},{"text":"taakaso kpɛ́ bò gwe à a nɛ́nↄ kàn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aubarikadeenↄn gbɛ̃ kɛ̀ aↄ̃ↄ kú n ua guunↄ ũ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ègↄ̃ n táaki lɛɛ gurↄ píngi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aubarikadeenↄn gbɛ̃ kɛ̀ aↄ̃ gbãaan n ũunↄ ũ,","poem":1},{"lineBreak":true},{"text":"n ua gana yã kú ń swɛ̃̀ guu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tó aↄ̃ↄe gɛ̃tɛɛ Baka guzurɛla,","poem":1},{"lineBreak":true},{"text":"è gↄ̃ lán guu kɛ̀ ibↄkiinↄ vĩi bà,","poem":1},{"lineBreak":true},{"text":"pↄ́tↄ̃gurↄ lou è tó aubarika dagula.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aↄ̃ gana guu aↄ̃ gbãaa ègↄ̃ kaaramɛ","poem":1},{"lineBreak":true},{"text":"ai aↄ̃ gá káo n kiia Zayↄn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii Luda Zĩ̀kpɛde, ǹ ma aduakɛna sí,","poem":1},{"lineBreak":true},{"text":"ǹ swã kpá ma yãzi, Yakubu Luda.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Luda, ǹ kína kɛ̀ dɛ wa sɛngbango ũu gwa,","poem":1},{"lineBreak":true},{"text":"ǹ wɛ́ɛ gↄ̃ tɛ́ kí kɛ̀ ń kàzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kuuna n ua gurↄ doo maamɛ","poem":1},{"lineBreak":true},{"text":"dɛ kuuna gu pãndea gurↄ wàa sↄↄroola.","poem":1},{"lineBreak":true},{"text":"Ma Luda ua zɛ́dãkparikɛɛ sì","poem":1},{"lineBreak":true},{"text":"dɛ kuuna ua lɛdo kↄ̃n zaakɛrinↄola.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii Ludaa dɛńnɛ ↄfãntɛ̃ kↄ̃n sɛngbangoo ũ,","poem":1},{"lineBreak":true},{"text":"Dii è gbɛ̃kɛɛ kɛńnɛ kↄ̃n bɛ̀ɛo,","poem":1},{"lineBreak":true},{"text":"è gí pↄ́ maaa kpá taarisaideenↄaziro.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dii Zĩ̀kpɛde,","poem":1},{"lineBreak":true},{"text":"aubarikadeen gbɛ̃ kɛ̀ èe n náanɛ kɛɛ ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}