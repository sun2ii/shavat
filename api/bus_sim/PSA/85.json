{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":85,"content":[{"type":"heading","content":["Aafia wɛ́ɛkɛna Ludaa"]},{"type":"hebrew_subtitle","content":["Kora boriinↄ lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"N aubarika dà n bùsun, Dii,","poem":1},{"lineBreak":true},{"text":"n ɛara ǹ su kↄ̃n Yakubu boriinↄ ń gwena ziin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N n gbɛ̃nↄ taarinↄ gògo,","poem":1},{"lineBreak":true},{"text":"n ń durunnↄ kɛ̃̀ńnɛ píngi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N n pↄ kpã̀kpa tò píngi,","poem":1},{"lineBreak":true},{"text":"n n pↄfɛ̃ pãsĩ tò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ǹ sↄkpawao wa gwena ziin, Luda wa Mìsiri,","poem":1},{"lineBreak":true},{"text":"ǹ pɛ̃tɛ̃ kɛ̀ ń kɛ̀wao lago.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N pↄↄ égↄ̃ fɛ̃nawazi gurↄ píngin yↄ́?","poem":1},{"lineBreak":true},{"text":"Nɛ́gↄ̃ n pↄfɛ̃gurↄↄ gagaa wɛ̃̀ kↄ̃n wɛ̃̀on yↄ́?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɛ́ ɛara ǹ n gbɛ̃nↄ kuuna kɛkɛ ǹ kɛńnɛ dↄ,","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃ pↄↄ e à kɛmma nnaroo?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dii, ǹ n gbɛ̃kɛɛ ↄdↄawe,","poem":1},{"lineBreak":true},{"text":"ǹ wa mì sí kↄ̃n n gbãaao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ma swã dↄ Dii Luda yã'onazi,","poem":1},{"lineBreak":true},{"text":"zaakɛ è aafia lɛ́ gbɛ̃ a yãmarinↄnɛ,","poem":1},{"lineBreak":true},{"text":"tó aↄ̃ↄe ɛara wà sↄ̀kpa ń yↄ̃̀nkↄyãnↄziro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À vĩakɛrinↄ mìsina gurↄↄ zã̀ro,","poem":1},{"lineBreak":true},{"text":"lɛ à gakui e àgↄ̃ kú wa bùsun yãnzi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛ kↄ̃n náanɛo è dakↄ̃rɛ,","poem":1},{"lineBreak":true},{"text":"yãzɛde kↄ̃n aafiao è ↄ kpákↄ̃a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Náanɛ è ↄ poro musu,","poem":1},{"lineBreak":true},{"text":"yãzɛdee è ↄ nↄnↄ tↄↄtɛa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dii é à maaa kɛwe,","poem":1},{"lineBreak":true},{"text":"wa tↄↄtɛ é pↄ́blee kɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Yãzɛdee ègↄ̃ tɛ́ à aɛ,","poem":1},{"lineBreak":true},{"text":"è zɛ́ kɛkɛnɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}