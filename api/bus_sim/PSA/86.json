{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":86,"content":[{"type":"heading","content":["Dↄnlɛ wɛ́ɛkɛna Ludaa"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii, ǹ swã kpá ma yãzi ǹ wemala,","poem":1},{"lineBreak":true},{"text":"zaakɛ takaaside wɛ̃ndadeen ma ũ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ ma wɛ̃̀ndi dãkpa,","poem":1},{"lineBreak":true},{"text":"zaakɛ má a zĩnda kpàmma.","poem":1},{"lineBreak":true},{"text":"Ǹ mamↄma n zↄ̀bleri mì sí,","poem":1},{"lineBreak":true},{"text":"zaakɛ mɛ́ɛ n náanɛ kɛɛ.","poem":1},{"lineBreak":true},{"text":"Ḿbe ma Luda ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ǹ sùu kɛmao, Dii,","poem":1},{"lineBreak":true},{"text":"zaakɛ mɛɛ̀gↄ̃ n sisii kↄngↄ kↄ̃n uusiɛo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ǹ mamↄma n zↄ̀bleri pↄↄ kɛ nna,","poem":1},{"lineBreak":true},{"text":"zaakɛ ma làakari tà n kiia, Dii.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ń maa bensↄ̃ ń sùu vĩ, Dii,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃kɛ bíta n sìsirinↄnɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dii, ǹ swã kpá ma wɛ́ɛkɛnazi,","poem":1},{"lineBreak":true},{"text":"ǹ làakari dↄ ma wɛ̃nda wiiia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mɛ́ n sísi ma nawɛ̃akɛgurↄↄ zĩ,","poem":1},{"lineBreak":true},{"text":"zaakɛ nɛɛ̀ wemala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tãa ke é sí lɛ́kↄ̃zinyoro, Dii,","poem":1},{"lineBreak":true},{"text":"gbɛ̃kee è fↄ̃ à n kɛna kɛro.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Borii kɛ̀ ń kɛ̀nↄ é mↄ́ wà kúɛnnɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ n tↄ́ bↄ ń píngi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Zaakɛ ń bíta bensↄ̃ nɛɛ̀ dabuyãnↄ kɛ,","poem":1},{"lineBreak":true},{"text":"ḿbe Luda ũ ndo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ǹ n zɛ́ ↄdↄamɛ, Dii, mɛ́gↄ̃ táa oo n yãpuraa guu,","poem":1},{"lineBreak":true},{"text":"ǹ ma laasuu kɛmɛ do, lɛ màgↄ̃ n vĩa vĩ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mɛ́ n sáabu kpá kↄ̃n nↄ̀sɛo do,","poem":1},{"lineBreak":true},{"text":"Dii ma Luda, mɛ́gↄ̃ n tↄ́ bↄↄ gurↄ píngi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Zaakɛ gbɛ̃kɛɛ kɛ̀ ń kɛ̀mɛɛ bíta,","poem":1},{"lineBreak":true},{"text":"n ma wɛ̃̀ndi bↄ̀ gɛ̀wãa lↄ̀n.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Luda, karambaanideenↄↄ e fɛɛɛmazi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ pãsĩnↄↄ e ma wɛɛ, aↄ̃è n yã daro.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N Dii, Luda sósobideen n ũ,","poem":1},{"lineBreak":true},{"text":"ń sùu vĩ bensↄ̃ n pↄↄ è fɛ̃ kpaaro,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃kɛ kↄ̃n n náanɛo bíta.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ǹ aɛ dↄma ǹ ma wɛ̃nda gwa,","poem":1},{"lineBreak":true},{"text":"ǹ n zↄ̀bleri gba gbãaa,","poem":1},{"lineBreak":true},{"text":"ǹ mapi n zↄ̀nↄkpare nɛ́ mì sí.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ǹ yãmaakɛna gbɛ̀ ↄdↄamɛ","poem":1},{"lineBreak":true},{"text":"lɛ ma zangurinↄ e, wí ń kũ,","poem":1},{"lineBreak":true},{"text":"zaakɛ Dii, n dↄmalɛ,","poem":1},{"lineBreak":true},{"text":"n ma làakari kpàɛmɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}