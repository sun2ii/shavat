{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":88,"content":[{"type":"heading","content":["Kuuna gaa lɛ́zĩ aduakɛna"]},{"type":"hebrew_subtitle","content":["Ɛzɛra bori Emani lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii Luda ma Mìsiri,","poem":1},{"lineBreak":true},{"text":"mɛ́ɛ wii pɛɛnzi fãantɛ̃ kↄ̃n gwãavĩo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ǹ tó ma aduakɛna ká n kiia,","poem":1},{"lineBreak":true},{"text":"ǹ swã kpá ma wiipɛnazi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zaakɛ yã'ↄ̃amma ma nↄ̀sɛ pà,","poem":1},{"lineBreak":true},{"text":"ma wɛ̃̀ndi kú gaa lɛ́zĩ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wà ma da gbɛ̃ kɛ̀ aↄ̃ↄe sii gɛ̀wãannↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"ma gↄ̃ gbãasaidee ũ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wà pã kpàmazi wà ma da gɛ̀nↄ tɛ́","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃ kɛ̀ aↄ̃ↄ daɛna miran sↄ̀rↄrↄnↄ bà,","poem":1},{"lineBreak":true},{"text":"lán gbɛ̃ kɛ̀ aↄ̃ yã dↄngu dↄro","poem":1},{"lineBreak":true},{"text":"aↄ̃ bà kúnyo dↄroonↄ bà.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N ma zu wɛ̀ɛ zã̀n","poem":1},{"lineBreak":true},{"text":"ai tↄↄtɛ tú kokotɛ̃wɛɛ gusiaan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N pↄfɛ̃ tↄ̃̀ma,","poem":1},{"lineBreak":true},{"text":"à ísↄ̃ dàmala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ń tò ma gbɛ̃nↄ ma zĩnna,","poem":1},{"lineBreak":true},{"text":"ń tò aↄ̃ↄ ye ma kãziro.","poem":1},{"lineBreak":true},{"text":"Wà ma kagura kɛ̀, bↄkii kuuro,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"nawɛ̃a ma wɛ́ɛ sìsi.","poem":1},{"lineBreak":true},{"text":"Mɛ́ɛ n sisii zaa kↄngↄ ai uusiɛ,","poem":1},{"lineBreak":true},{"text":"ma ↄↄnↄↄ dↄnzi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gɛ̀nↄn nɛɛ̀ yãbↄnsaɛ kɛńnɛↄ́?","poem":1},{"lineBreak":true},{"text":"Gɛ̀wãadeenↄ bé wè fɛɛ wà n sáabu kpáↄ́?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wè n gbɛ̃kɛɛ tↄ̃kɛ̃ mira guun yↄ́?","poem":1},{"lineBreak":true},{"text":"Wè n náanɛkɛyã o gɛ̀wãann yↄ́?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wà n dabuyãnↄ dↄ̃ gusiaa guun yↄ́?","poem":1},{"lineBreak":true},{"text":"N maakɛnanↄ dↄ̃na kú yãsãngukii guun yↄ́?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dii, mɛ́ɛ wii pɛɛnzi,","poem":1},{"lineBreak":true},{"text":"ma aduakɛna kↄngↄ è ká n kiia.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bↄ́yãnzin nɛ́ɛ giimazizi, Dii?","poem":1},{"lineBreak":true},{"text":"À kɛ̀ dia n mìkpɛɛ zùmɛɛ?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Má kú gaa lɛ́zĩ wɛ̃ndawɛ̃nda zaa ma gↄ̃kparɛkɛgurↄ,","poem":1},{"lineBreak":true},{"text":"n yã pãsĩnↄ tↄ̃̀ma, ma gↄ̃ sã̀ii.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N pↄfɛ̃namazii dàmala,","poem":1},{"lineBreak":true},{"text":"n vĩapↄnↄ ma kaatɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Aↄ̃ dàmala lán í bà zaa kↄngↄ ai uusiɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ lìgamazi mámmam.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ń tò ma gbɛ̃nↄ kↄ̃n ma gbɛ̃nnanↄ ma zĩnna,","poem":1},{"lineBreak":true},{"text":"gusiaa bé à gↄ̃̀ ma kpàasi ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}