{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":9,"content":[{"type":"heading","content":["Luda sáabukpana kɛ̀ è yã kɛkɛ gbɛ̃nↄnɛ yãnzi"]},{"type":"hebrew_subtitle","content":["Dauda lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"Dii, mɛ́ n sáabu kpá kↄ̃n nↄ̀sɛo do,","poem":1},{"lineBreak":true},{"text":"mɛ́ n yãbↄnsaɛkɛnanↄ kpàakpa kɛńnɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mɛ́ pↄnnaa kɛ mà ĩa dã n yã musu,","poem":1},{"lineBreak":true},{"text":"Luda Musude, mɛ́ n tↄ́ kpá kↄ̃n lɛ̀sinao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ma ibɛɛnↄ è kpɛɛ li,","poem":1},{"lineBreak":true},{"text":"aↄ̃è lɛɛ wà gaga n aɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Zaakɛ n zɛmao n yã nnaa kpàma,","poem":1},{"lineBreak":true},{"text":"vɛ̃ɛna n tintia n yã gↄ̃̀gↄ̃ a zɛ́a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N kpãkɛ̃ boriinↄzi,","poem":1},{"lineBreak":true},{"text":"n gbɛ̃ zaaanↄ kàatɛ n ń tↄ́ dɛ̀dɛ míↄmiↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N mↄ́nzi kɛ̀ è yãaroo kpà ma zangurinↄzi,","poem":1},{"lineBreak":true},{"text":"n ń wɛ́tɛnↄ gbòro, aↄ̃ yã dↄ gbɛ̃ken dↄro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dii è kí ble gurↄ píngi,","poem":1},{"lineBreak":true},{"text":"à a kpata dìɛ yãkpaɛkɛna yãnzi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Eé yãkpaɛ kɛ kↄ̃n anduna gbɛ̃nↄ súusu,","poem":1},{"lineBreak":true},{"text":"eé kí ble boriinↄa a zɛ́a.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Diin utɛkii ũ gbɛ̃ kɛ̀ wèe gbãaa mↄↄńnɛnↄnɛ,","poem":1},{"lineBreak":true},{"text":"à dɛńnɛ aafia'ekii ũ nawɛ̃akɛgurↄ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dii, gbɛ̃ kɛ̀ aↄ̃ↄ n tↄ́ dↄ̃ↄnↄↄ n náanɛ vĩ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ n kii wɛ̀tɛrinↄ zĩnnaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"À lɛ̀ sí Diinɛ, èe kí blee zaa Zayↄn,","poem":1},{"lineBreak":true},{"text":"à à yãkɛnanↄ kpàakpa kɛ bori pínginɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zaakɛ è gɛ̃ɛ bo gbɛ̃dɛria, yã è sãnlo,","poem":1},{"lineBreak":true},{"text":"è takaasideenↄ wiilɛna yã da.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dii, ǹ gwa lán ma ibɛɛnↄↄ e ĩa daama nà,","poem":1},{"lineBreak":true},{"text":"ǹ ma wɛ̃nda gwa ǹ ma bↄ gaa lɛ́zĩ,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"lɛ mà n tↄ́ kpá Zayↄn bĩilɛa,","poem":1},{"lineBreak":true},{"text":"mà pↄnnaa kɛ kɛ̀ n ma mì sì yãnzi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Boriinↄ sì wɛ̀ɛ kɛ̀ aↄ̃ↄ yↄ̃̀n,","poem":1},{"lineBreak":true},{"text":"aↄ̃ gbá zù bà kɛ̀ aↄ̃ↄ kpàkpa guu.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wà Dii dↄ̃ kↄ̃n yãkpaɛkɛna a zɛ́ao,","poem":1},{"lineBreak":true},{"text":"è tó gbɛ̃ zaaa yãkɛna wí à musu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Gbɛ̃ zaaanↄ è tá gɛ̀wãan,","poem":1},{"lineBreak":true},{"text":"borii kɛ̀ aↄ̃è Luda yã daroo pìnↄ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wɛ̃ndadeenↄ yã é sãn zikiro,","poem":1},{"lineBreak":true},{"text":"takaasidee sↄ̃ wɛ́ɛdↄzina yãana vĩro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ǹ fɛɛ Dii, ǹton tó gbɛ̃ntee n gã̀ fĩro,","poem":1},{"lineBreak":true},{"text":"ǹ bori píngi kakↄ̃a ǹ yãkpaɛ kɛńyo.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Dii, ǹ tó vĩa boriinↄ kũ,","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃ e wà dↄ̃ kɛ̀ gbɛ̃nteenↄn ń ũ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}