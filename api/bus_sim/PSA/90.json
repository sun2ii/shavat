{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":90,"content":[{"type":"heading","content":["Luda kↄ̃n gbɛ̃nteeo"]},{"type":"hebrew_subtitle","content":["Luda gbɛ̃ Musa aduakɛna."]},{"type":"verse","number":1,"content":[{"text":"Dii, wa utɛkiin n ũ wɛ̃̀ kↄ̃n wɛ̃̀o.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lɛ ń kpɛ́ ǹ kpiiinↄ kɛ,","poem":1},{"lineBreak":true},{"text":"lɛ ń kpɛ́ ǹ tↄↄtɛ kↄ̃n andunao káɛ,","poem":1},{"lineBreak":true},{"text":"Ludan n ũ zaa káaku ai gurↄ píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ń dìɛ kɛ̀ gbɛ̃ntee é sↄkpa tↄↄtɛ,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀ beńnɛ aↄ̃ ɛara bùsutin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wɛ̃̀ wàa sↄↄroo dɛnnɛ lán gurↄ doo bà,","poem":1},{"lineBreak":true},{"text":"à dɛnnɛ lán gĩa ke gwãavĩ zaka bà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ gbɛ̃ntee sɛ́ kↄ̃n ga'iio,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ dɛ lán sɛ̃̀ yĩi bà kↄngↄ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"È bↄɛ kↄngↄ à gbã,","poem":1},{"lineBreak":true},{"text":"è yitoo kũ à gaga uusiɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N pↄfɛ̃ è wa kaatɛ,","poem":1},{"lineBreak":true},{"text":"n patammana è swɛ̃̀ kɛ̃wagu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wa yã zaaanↄ kaɛna n aɛ,","poem":1},{"lineBreak":true},{"text":"wa asiiyãnↄ bↄ̀ gupuraaa n kuu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wa gurↄↄ è gɛ̃tɛ n pɛ̃tɛ̃ yãnzi,","poem":1},{"lineBreak":true},{"text":"wa wɛ̃̀ndi è yãa kↄ̃n m̀bnao.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wa wɛ̃̀ è ká baaagↄ̃ akuri,","poem":1},{"lineBreak":true},{"text":"tó wá gbãa sↄ̃, basiigↄ̃.","poem":1},{"lineBreak":true},{"text":"Nawɛ̃a kↄ̃n pↄsiaaon wɛ̃̀ pìnↄ è mↄ́owe,","poem":1},{"lineBreak":true},{"text":"aↄ̃è gɛ̃tɛ gↄ̃ↄgↄ̃ↄ, ben weè kpá guuzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dé bé à n pↄfɛ̃ gbãa lɛ́ dↄ̃ↄ?","poem":1},{"lineBreak":true},{"text":"N pɛ̃tɛ̃ bíta kà vĩa kɛ̀ à dɛ wà kɛnnɛɛ ũ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ǹ dawe wàgↄ̃ wa wɛ̃̀ndi kusukɛ lɛ́ dↄ̃,","poem":1},{"lineBreak":true},{"text":"lɛ wà ↄ̃ndↄ̃ↄ e wa swɛ̃̀ guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dii, bↄrɛn nɛ́ n pↄfɛ̃ kpáɛɛ?","poem":1},{"lineBreak":true},{"text":"Ǹ n zↄ̀blerinↄ wɛ̃nda gwa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ǹ tó n gbɛ̃kɛɛ mↄ́wa lán guu e dↄↄ nà,","poem":1},{"lineBreak":true},{"text":"lɛ wàgↄ̃ pↄnnaa kɛɛ kↄ̃n gudakɛnao ai wa gurↄ lɛ́n.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ǹ wa pↄↄ kɛ nna ↄↄ kɛ̀ ń tↄ̃̀wa gurↄ lɛ́n,","poem":1},{"lineBreak":true},{"text":"nawɛ̃a kɛ̀ wá kɛ̀ wɛ̃̀ lɛ́n.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ǹ n yãkɛnanↄ ↄdↄa wamↄwa n zↄ̀blerinↄnɛ,","poem":1},{"lineBreak":true},{"text":"ǹ tó wa nɛ́nↄ n gbãaa gakui dↄ̃.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Dii wa Luda, ǹ tó wà n pↄnnaa e,","poem":1},{"lineBreak":true},{"text":"ǹ tó wa zĩi kaarana e,","poem":1},{"lineBreak":true},{"text":"ee, ǹ tó wa zĩi kaarana e.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}