{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":91,"content":[{"type":"heading","content":["Ludan wa dãkpari ũ"]},{"type":"verse","number":1,"content":[{"text":"Gbɛ̃ kɛ̀ utɛna Luda Musude ↄzĩ","poem":1},{"lineBreak":true},{"text":"égↄ̃ kú Gbãapingide ↄrazi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Eé be Diin a zɛki gbãaa ũ,","poem":1},{"lineBreak":true},{"text":"a Ludan a utɛkii ũ, á à náanɛ vĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Àmbe é n sí karia,","poem":1},{"lineBreak":true},{"text":"eé n mì sí gagyãaa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Eé n sↄtↄ a pↄtɛ, nɛ́gↄ̃ utɛna à ↄru,","poem":1},{"lineBreak":true},{"text":"à náanɛkɛɛ bé eé n dãkpa lán sɛngbango bà.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gwãavĩ kainↄ kↄ̃n fãantɛ̃ kà vĩananↄ","poem":1},{"lineBreak":true},{"text":"aↄ̃ ke vĩa é n kũro,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ke gagyãa kɛ̀ ègↄ̃ tɛ́ gusiaan","poem":1},{"lineBreak":true},{"text":"ke gyãgɛ̃wɛtɛ kɛ̀ è ń le fãantɛ̃ gbãaa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Baa tó gↄ̃ↄn wàa sↄↄroo e lɛɛɛ n saɛ,","poem":1},{"lineBreak":true},{"text":"ke gↄ̃ↄn bↄrↄ kuri e gaa n ↄplaazi,","poem":1},{"lineBreak":true},{"text":"pↄ́ke é n lero.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nɛ́ wɛ́ɛ sɛ́ ǹ gwa,","poem":1},{"lineBreak":true},{"text":"nɛ́ e lán wè wɛ́ɛ tã zaakɛrinↄa nà.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tó n Luda Musude kɛ̀ n utɛkii ũ,","poem":1},{"lineBreak":true},{"text":"tó n Dii kɛ̀ n kúkii ũ,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"yã zaa ke é n lero,","poem":1},{"lineBreak":true},{"text":"mↄ́nzi é gɛ̃ n uaro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zaakɛ eé n yã o a malaikanↄnɛ,","poem":1},{"lineBreak":true},{"text":"lɛ aↄ̃ n dãkpa guu kɛ̀ nɛ́ɛ gaan píngi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Aↄ̃é n sɛ́ ń ↄzĩ","poem":1},{"lineBreak":true},{"text":"lɛ ǹton gɛ̃̀n sí gbɛ̀aro yãnzi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nɛ́ kɛ̀sɛ zɛ músua kↄ̃n kárɛo,","poem":1},{"lineBreak":true},{"text":"nɛ́ kɛ̀sɛ pɛ́ɛpɛɛ gbèkaa kↄ̃n pitigooo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Dii bè: Zaakɛ à nàmazi, mɛ́ à bↄ,","poem":1},{"lineBreak":true},{"text":"zaakɛ à ma dↄ̃, mɛ́ ↄ kúa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eé ma sísi, mɛ́ weàla,","poem":1},{"lineBreak":true},{"text":"tó yã nàkↄ̃rɛa, mɛ́gↄ̃ kúo,","poem":1},{"lineBreak":true},{"text":"mɛ́ à mì sí mà à kpe da.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mɛ́ à pↄↄ kɛ nna kↄ̃n wɛ̃̀ndi gbã̀ao,","poem":1},{"lineBreak":true},{"text":"mɛ́ tó à e lán mɛɛ̀ gbɛ̃ mì sí nà.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}