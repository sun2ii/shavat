{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":92,"content":[{"type":"heading","content":["Luda sáabukpana"]},{"type":"hebrew_subtitle","content":["Kámmabogurↄ lɛ̀."]},{"type":"verse","number":1,"content":[{"text":"À maa wà n sáabu kpá, Dii,","poem":1},{"lineBreak":true},{"text":"wà lɛ̀ sí wà n tↄ́ bↄ, Luda Musude,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"wà n gbɛ̃kɛɛ tↄ̃kɛ̃ kↄngↄ,","poem":1},{"lineBreak":true},{"text":"wà n náanɛkɛyã o gwãavĩ,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"wà n táaki lɛ́ kↄ̃n mↄrↄo","poem":1},{"lineBreak":true},{"text":"kↄ̃n kuntigi ↄ́ nnaao.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N yãkɛnanↄ è ma pↄↄ kɛ nna, Dii,","poem":1},{"lineBreak":true},{"text":"mɛɛ̀ guda dↄ n ↄzĩkɛnanↄa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii, n yãkɛnanↄ bíta maamaa,","poem":1},{"lineBreak":true},{"text":"n laasuunↄↄ zã̀ à kɛ̀ bíta.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yↄ̃nkↄↄ yã pì dↄ̃ro,","poem":1},{"lineBreak":true},{"text":"mìsaidee é fↄ̃ à dↄ̀rↄ dↄ̃ro.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Baa tó gbɛ̃ zaaanↄ fɛ̀ɛ wà gbã̀ lán sɛ̃̀ bà","poem":1},{"lineBreak":true},{"text":"bensↄ̃ zaakɛrinↄ kaarana è ń píngi,","poem":1},{"lineBreak":true},{"text":"aↄ̃ ziaa nɛ́ kaatɛna yãanasaimɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mmↄn sↄ̃ Dii,","poem":1},{"lineBreak":true},{"text":"nɛɛ̀gↄ̃ kú musu gurↄ píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ǹ gwa, n ibɛɛnↄↄ e yãaa,","poem":1},{"lineBreak":true},{"text":"zaakɛrinↄↄ e fãakↄ̃a ń píngi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N ma gba gbãaa lán zùsɛ̃tɛ bà,","poem":1},{"lineBreak":true},{"text":"n nↄ́si maaa kù ma mìa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ma wɛ́ɛ sì ma wɛ̀tɛrinↄ lɛɛnalɛ,","poem":1},{"lineBreak":true},{"text":"ma swã ma ibɛɛ zaaanↄ wiii mà dↄ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gbɛ̃ maaanↄ é gbã lán damina línↄ bà,","poem":1},{"lineBreak":true},{"text":"aↄ̃é kɛ bíta lán Lɛbanↄ sida línↄ bà.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aↄ̃ pɛna Dii bɛɛ guu,","poem":1},{"lineBreak":true},{"text":"aↄ̃é gbã wa Luda ua.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Baa kↄ̃n ń zikũkɛɛo aↄ̃égↄ̃ nɛ́ iimɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ lá égↄ̃ tɛ́ kɛɛ sí plɛ̀plɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Aↄ̃é be, Dii maa,","poem":1},{"lineBreak":true},{"text":"àmbe wa gbɛ̀si ũ, zaa kee kú à guuro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}