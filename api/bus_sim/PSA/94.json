{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":94,"content":[{"type":"heading","content":["Ludan yãkpaɛkɛri ũ"]},{"type":"verse","number":1,"content":[{"text":"Dii Luda gɛ̃ɛboḿmari,","poem":1},{"lineBreak":true},{"text":"Luda gɛ̃ɛboḿmari, ǹ bↄ gupuraaa!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Anduna yãkpaɛkɛri, ǹ fɛɛ,","poem":1},{"lineBreak":true},{"text":"ǹ fĩa bo wadadeenↄnɛ ń yãkɛnaa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃ zaaanↄ égↄ̃ ń zĩnda sɛɛ lezĩ ai bↄrɛmɛ?","poem":1},{"lineBreak":true},{"text":"Ai bↄrɛmɛ, Dii?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Zaakɛrinↄ è wada yã o,","poem":1},{"lineBreak":true},{"text":"aↄ̃è yã bↄɛ aↄ̃è ĩa dã ń píngi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dii, aↄ̃è n gbɛ̃nↄ dúgu zↄ̃,","poem":1},{"lineBreak":true},{"text":"aↄ̃è gbãaa mↄ gbɛ̃ kɛ̀ n ń sɛ́nↄnɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aↄ̃è gyaanↄnↄ kↄ̃n bↄ̀amↄnↄ dɛdɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃è tonɛnↄ kaatɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aↄ̃è be Dii e ń ero,","poem":1},{"lineBreak":true},{"text":"Yakubu boriinↄ Luda làakari kúḿmaro.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"A yↄ̃nkↄↄnↄ, à làakari kɛ!","poem":1},{"lineBreak":true},{"text":"A mìsaideenↄ, é ↄ̃ndↄ̃ kũ bↄrɛn yee?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Luda bé à swã dↄ̀, eé gí yã maziↄ́?","poem":1},{"lineBreak":true},{"text":"À wɛ́ɛ kɛ̀, eé gí guu eziↄ́?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"È boriinↄ tòto kɛ, eé gí ń swã gágaziↄ́?","poem":1},{"lineBreak":true},{"text":"È yã dańnɛ, à dↄ̃na vĩnloo?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dii gbɛ̃ntee laasuu dↄ̃,","poem":1},{"lineBreak":true},{"text":"kɛ̀ yã pãamɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Aubarikadeen gbɛ̃ kɛ̀ nɛɛ̀ tòto kɛ","poem":1},{"lineBreak":true},{"text":"ǹ n doka danɛ ũ, Dii.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nɛɛ̀ à gba kámmabona nawɛ̃akɛgurↄ,","poem":1},{"lineBreak":true},{"text":"ai wàgↄ̃ wɛ̀ɛ yↄ̃ zaakɛrinɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Dii é pã kpá a gbɛ̃nↄziro,","poem":1},{"lineBreak":true},{"text":"eé gbɛ̃ kɛ̀ à ń sɛ́ a pↄ́ ũunↄ zĩnnaro.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Weé ɛara wà yãkpaɛ kɛ a zɛ́a,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuradeenↄ é zɛo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dé bé eé fɛɛmɛ gbɛ̃ zaaanↄzi?","poem":1},{"lineBreak":true},{"text":"Dé bé eé zɛmao zaakɛrinↄ yã musuu?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tó èe kɛ Dii dↄnlɛ kɛ̀mɛnlo,","poem":1},{"lineBreak":true},{"text":"lɛ má kú miran kítikiti kↄ̀.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kɛ̀ ma bè gu zãɛ e ma sɛɛɛ,","poem":1},{"lineBreak":true},{"text":"n ma kũ n gbɛ̃kɛɛ guu, Dii.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kɛ̀ laasuu ma swɛ̃̀ pà,","poem":1},{"lineBreak":true},{"text":"n ma làakari kpàɛmɛ n ma pↄↄ kɛ̀ nna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"N bà égↄ̃ kú kↄ̃n yãlɛkpɛɛgↄ̃gↄ̃rinↄ kpataoↄ́?","poem":1},{"lineBreak":true},{"text":"Aↄ̃ yãdiɛnanↄ è mↄ́ńnɛ kↄ̃n nawɛ̃ao,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Aↄ̃è lɛ́ kpakↄ̃sↄ̃ gbɛ̃ maaazi,","poem":1},{"lineBreak":true},{"text":"aↄ̃è yã da taarisaideela wà à dɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Diin ma zɛki gbãaa ũ,","poem":1},{"lineBreak":true},{"text":"ma Ludan gbɛ̀si kɛ̀ mɛɛ̀ utɛn ũ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Eé ń zaakɛna sↄkpaḿma,","poem":1},{"lineBreak":true},{"text":"eé ń borii bↄ aↄ̃ taarinↄ yãnzi.","poem":1},{"lineBreak":true},{"text":"Dii wa Luda é ń borii bↄ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}