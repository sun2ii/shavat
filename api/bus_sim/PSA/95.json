{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":95,"content":[{"type":"heading","content":["Luda táakilɛna"]},{"type":"verse","number":1,"content":[{"text":"À mↄ́ wà pↄnna lɛ̀ sí Diinɛ,","poem":1},{"lineBreak":true},{"text":"wà guda dↄ Gbɛ̀si kɛ̀ è wa mì sía.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wà mↄ́ à aɛ wà à sáabu kpá,","poem":1},{"lineBreak":true},{"text":"wà lɛ̀ sí wà à táaki lɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Zaakɛ Dii nɛ́ Luda kɛ̀ bítamɛ.","poem":1},{"lineBreak":true},{"text":"Kí bítamɛ, à dɛ dii píngila.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tↄↄtɛ zã̀ gĩzĩgĩzĩ kú à ↄzĩ,","poem":1},{"lineBreak":true},{"text":"kpii mìsↄ̃ntɛ̃nↄ nɛ́ à pↄ́mɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ísia nɛ́ à pↄ́mɛ, zaakɛ à kɛ̀,","poem":1},{"lineBreak":true},{"text":"àmbe à tↄↄtɛ í kàsa kↄ̃n a ↄↄo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"À mↄ́ wà kúɛ wà dↄnzi kɛ","poem":1},{"lineBreak":true},{"text":"wà daɛ Dii wa Kɛ̀ri aɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zaakɛ àmbe wa Luda ũ,","poem":1},{"lineBreak":true},{"text":"à kpàsa gbɛ̃nↄn wa ũ,","poem":1},{"lineBreak":true},{"text":"à sãa kɛ̀ èe ń dãanↄ ũ.","poem":1},{"lineBreak":true},{"text":"Tó a à kòto mà gbã̀a,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"àton swãgbãaa kɛ","poem":1},{"lineBreak":true},{"text":"lán a dezinↄ kɛ̀ nà zaa Mɛribaro","poem":1},{"lineBreak":true},{"text":"ke Masa gurↄↄ kɛ̀ aↄ̃ↄ kú gbáan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Baa kɛ̀ aↄ̃ ma yãkɛnanↄ è,","poem":1},{"lineBreak":true},{"text":"aↄ̃ ma lɛ wà ma gwa gwe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ben ma pↄ fɛ̃̀ gbɛ̃ pìnↄzi ai wɛ̃̀ baplaa,","poem":1},{"lineBreak":true},{"text":"ma bè gbɛ̃ sãsãnanↄn ń ũ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ ma zɛ́nↄ dↄ̃ro.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ben ma la dà ma pↄfɛ̃ guu ma bè,","poem":1},{"lineBreak":true},{"text":"aↄ̃é gɛ̃ ma kámmabokiinlo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}