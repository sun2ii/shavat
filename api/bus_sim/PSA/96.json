{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":96,"content":[{"type":"heading","content":["Diin Kí bíta ũ"]},{"type":"verse","number":1,"content":[{"text":"À lɛ̀ dufu sí Diinɛ,","poem":1},{"lineBreak":true},{"text":"anduna gbɛ̃ píngi, à lɛ̀ sí Diinɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"À lɛ̀ sí Diinɛ à à tↄ́ bↄ,","poem":1},{"lineBreak":true},{"text":"àgↄ̃ à mìsina baaru kpaa lán guu e dↄↄ nà.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"À à gakuikɛyã o boriinↄnɛ,","poem":1},{"lineBreak":true},{"text":"à à yãbↄnsaɛnↄ tↄ̃kɛ̃ baade pínginɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dii bíta, à kà wà à táaki lɛ́,","poem":1},{"lineBreak":true},{"text":"à kↄ̃ sìo wà vĩa kɛnɛ dɛ tãanↄla ń píngi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Boriinↄ tãanↄ nɛ́ pↄ́ ginanↄmɛ,","poem":1},{"lineBreak":true},{"text":"mↄde Dii bé à musu kɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bítakɛ kↄ̃n bɛ̀ɛo kúa,","poem":1},{"lineBreak":true},{"text":"gbãa kↄ̃n gakuio kú à kúkiiamɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"À gakui kↄ̃n gbãaao dↄ̃ Diinɛ,","poem":1},{"lineBreak":true},{"text":"bùsu píngi gbɛ̃nↄ, à dↄ̃ Diinɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"À Dii tↄ́ gakui dↄ̃nɛ,","poem":1},{"lineBreak":true},{"text":"à mↄ́ kↄ̃n gbaao à gɛ̃o à ua.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À dↄnzi kɛ Diinɛ à kúadona maakɛɛn,","poem":1},{"lineBreak":true},{"text":"tↄↄtɛdeenↄ, àgↄ̃ lugaa à aɛ a píngi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"À o boriinↄnɛ, Dii e kí blee.","poem":1},{"lineBreak":true},{"text":"Anduna kaɛna gíngin, à nigãna vĩro,","poem":1},{"lineBreak":true},{"text":"eé yãkpaɛ kɛ kↄ̃n baade píngio a zɛ́a.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Musudeenↄ, à pↄnnaa kɛ,","poem":1},{"lineBreak":true},{"text":"tↄↄtɛdeenↄ, à vĩ kↄ̃n pↄnnaao,","poem":1},{"lineBreak":true},{"text":"ísia kↄ̃n pↄ́ kɛ̀ kúnnↄ, à kĩi dↄ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sɛ̃̀tɛ kↄ̃n pↄ́ kɛ̀ kúnnↄ, à pↄnna wii lɛ́,","poem":1},{"lineBreak":true},{"text":"lí kɛ̀ kú dàko guunↄ, à guda kɛ a píngi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aↄ̃é pↄnnaa kɛ Dii aɛ, zaakɛ èe mↄↄ,","poem":1},{"lineBreak":true},{"text":"èe mↄↄ yãkpaɛ kɛ kↄ̃n andunao.","poem":1},{"lineBreak":true},{"text":"Eé yãkpaɛ kɛ kↄ̃n andunao a zɛ́a,","poem":1},{"lineBreak":true},{"text":"à yã gↄ̃gↄ̃ gbɛ̃nↄnɛ kↄ̃n yãpuraao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}