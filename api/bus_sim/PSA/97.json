{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":97,"content":[{"type":"heading","content":["Dii mↄna"]},{"type":"verse","number":1,"content":[{"text":"Dii bé èe kí blee!","poem":1},{"lineBreak":true},{"text":"Tↄↄtɛdeenↄ pↄnnaa kɛ,","poem":1},{"lineBreak":true},{"text":"ísiabaadeenↄ gↄ̃ kú pↄnnaa guu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ludambɛ sia kↄ̃n gusia níginigio ligazi,","poem":1},{"lineBreak":true},{"text":"maakɛ kↄ̃n yãzɛdeeon à kpata kãsãa ũ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɛ́ ègↄ̃ kũu à aɛ,","poem":1},{"lineBreak":true},{"text":"è ibɛɛ kɛ̀ aↄ̃ↄ ligazinↄ kpata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"À loupina è tↄↄtɛ pu,","poem":1},{"lineBreak":true},{"text":"tó anduna è, è luga.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kpiiinↄ è yↄ́ lán zↄ́sa bà Dii aɛ,","poem":1},{"lineBreak":true},{"text":"anduna píngi Dii aɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Musudeenↄ è à maakɛɛ kpàakpa kɛ,","poem":1},{"lineBreak":true},{"text":"bori sãnda píngi è à gakui e.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wí è tãagbãgbãrinↄ kũ ń píngi,","poem":1},{"lineBreak":true},{"text":"gbɛ̃ kɛ̀ aↄ̃è ĩa dã kↄ̃n pↄ́ ginanↄ.","poem":1},{"lineBreak":true},{"text":"Tãanↄ é dↄnzi kɛnɛ ń píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Zayↄndeenↄↄ mà wà pↄnnaa kɛ̀,","poem":1},{"lineBreak":true},{"text":"Yuda wɛ́tɛdeenↄↄ kú pↄnnaa guu","poem":1},{"lineBreak":true},{"text":"n yãkpaɛkɛnanↄ yãnzi, Dii.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Zaakɛ ń kú musu dɛ anduna píngila,","poem":1},{"lineBreak":true},{"text":"Dii, ń dɛ tãanↄla ń píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dii ye gbɛ̃ kɛ̀ aↄ̃ zà yã zaaannↄzi,","poem":1},{"lineBreak":true},{"text":"ègↄ̃ a yãmarinↄ wɛ̃̀ndi dãkpa,","poem":1},{"lineBreak":true},{"text":"è ń bↄ zaakɛrinↄ ↄzĩ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Guu è dↄ gbɛ̃ maaanↄa,","poem":1},{"lineBreak":true},{"text":"nↄ̀sɛpuradeenↄↄ pↄnnaa vĩ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Gbɛ̃ maaanↄ, à pↄnnaa kɛ Dii guu,","poem":1},{"lineBreak":true},{"text":"à à tↄ́ kɛ̀ kú adona bↄ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}