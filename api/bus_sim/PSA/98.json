{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":98,"content":[{"type":"heading","content":["Dii mↄna táakilɛna"]},{"type":"verse","number":1,"content":[{"text":"À lɛ̀ dufu sí Diinɛ,","poem":1},{"lineBreak":true},{"text":"zaakɛ à yãbↄnsaɛnↄ kɛ̀,","poem":1},{"lineBreak":true},{"text":"à zĩ̀ blè kↄ̃n a ↄplaa kɛ̀ kú adona gbãaao.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii tò wà a mìsina dↄ̃̀,","poem":1},{"lineBreak":true},{"text":"à a maakɛna ↄ̀dↄa boriinↄnɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gbɛ̃kɛ kↄ̃n náanɛ kɛ̀ à vĩ kↄ̃n Isarailinↄo dↄ̀n,","poem":1},{"lineBreak":true},{"text":"andunalɛzɛkideenↄ wa Luda mìsina è ń píngi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Anduna píngi, à pↄnna wii pɛ́ Diinɛ,","poem":1},{"lineBreak":true},{"text":"à gudakɛna kakↄ̃n.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À mↄrↄlɛna ↄ́ dↄ Diinɛ,","poem":1},{"lineBreak":true},{"text":"à mↄrↄ lɛ́nɛ kↄ̃n lɛ̀sinao","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"kↄ̃n kãkãkipɛnao kↄ̃n kuru'ↄo.","poem":1},{"lineBreak":true},{"text":"À pↄnna wii pɛ́ Dii wa Kínanɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ísia kↄ̃n pↄ́ kɛ̀ kúnnↄ kĩi kɛ,","poem":1},{"lineBreak":true},{"text":"anduna kↄ̃n gbɛ̃ kɛ̀ aↄ̃ↄ kúnnↄ ń píngi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Swaanↄ ↄpa lɛ́ Dii aɛ,","poem":1},{"lineBreak":true},{"text":"kpiiinↄ guda kɛ lɛdolɛ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"zaakɛ èe mↄↄ yãkpaɛ kɛ tↄↄtɛmɛ.","poem":1},{"lineBreak":true},{"text":"Eé yãkpaɛ kɛ kↄ̃n andunao a zɛ́a,","poem":1},{"lineBreak":true},{"text":"eé yã gↄ̃gↄ̃ gbɛ̃nↄnɛ kↄ̃n yãpuraao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}