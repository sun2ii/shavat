{"translation":{"id":"bus_sim","name":"Luda yã takada kↄ̃n Bokobaru yão","website":"https://ebible.org/Scriptures/details.php?id=bus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bus","licenseNotes":null,"shortName":"SIM","englishName":"Bokobaru Bible","language":"bus","textDirection":"ltr","sha256":"b9222cefa1f141afbec39fa097fc857d40490f1bec6578c01213ae19f5d8da9c","availableFormats":["json"],"listOfBooksApiLink":"/api/bus_sim/books.json","numberOfBooks":49,"totalNumberOfChapters":739,"totalNumberOfVerses":19389,"languageName":"Bokobaru","languageEnglishName":"Bokobaru"},"book":{"id":"PSA","translationId":"bus_sim","name":"SAAMUNƆ","commonName":"SAAMUNƆ","title":"SAAMUNƆ","order":19,"numberOfChapters":150,"sha256":"0ccf0a91e8039c9f7a4670c74757e1f0f6fae77ec5b2a86dfc9864d2516a8854","firstChapterNumber":1,"firstChapterApiLink":"/api/bus_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/bus_sim/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":99,"content":[{"type":"heading","content":["Luda kɛ̀ kú adona"]},{"type":"verse","number":1,"content":[{"text":"Dii e kí blee, boriinↄ luga,","poem":1},{"lineBreak":true},{"text":"à vɛ̃ɛna kɛrubunↄ dagura,","poem":1},{"lineBreak":true},{"text":"anduna nigã.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dii bíta Zayↄn,","poem":1},{"lineBreak":true},{"text":"à dɛ bori píngila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aↄ̃ à tↄ́ bíta naasidee bↄ,","poem":1},{"lineBreak":true},{"text":"à kú adona.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kína pì gbãaa vĩ, à ye yãzɛdeezi,","poem":1},{"lineBreak":true},{"text":"àmbe à yãkpaɛkɛna a zɛ́a dìɛ,","poem":1},{"lineBreak":true},{"text":"à yã gↄ̃̀gↄ̃ Yakubu boriinↄnɛ a zɛ́a.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"À Dii wa Luda tↄ́ sɛ́ lezĩ,","poem":1},{"lineBreak":true},{"text":"à kúɛ à tinti aɛ,","poem":1},{"lineBreak":true},{"text":"à kú adona.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musa kↄ̃n Arunao kú à gbã̀gbãrinↄ tɛ́,","poem":1},{"lineBreak":true},{"text":"Samuɛlin à sìsirinↄ doke ũ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ à sìsi, ben à wèńla.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zaa tɛ́luguu guun à yã òńnɛ,","poem":1},{"lineBreak":true},{"text":"aↄ̃ↄ à doka kↄ̃n à yãdannɛnanↄ kũna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dii wa Luda, n weńla,","poem":1},{"lineBreak":true},{"text":"ḿbe Luda kɛ̀ è ń taari kɛ̃ńnɛ ũ,","poem":1},{"lineBreak":true},{"text":"baa kↄ̃n beeeo n ń yã zaaanↄ wìńnɛ ń musu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"À Dii wa Luda tↄ́ sɛ́ lezĩ,","poem":1},{"lineBreak":true},{"text":"à dↄnzi kɛnɛ à kpiii kɛ̀ kú adona musu,","poem":1},{"lineBreak":true},{"text":"zaakɛ Dii wa Ludaa kú adona.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bus_sim/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bus_sim/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bus_sim/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}