{"translation":{"id":"bwo_twf","name":"Handr Taara","website":"https://ebible.org/Scriptures/details.php?id=bwo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bwo","licenseNotes":null,"shortName":"TWF","englishName":"Borna NT Latin Version","language":"bwo","textDirection":"ltr","sha256":"bb0444b9a0d17508910af5d6ac480c4bc7a6a78947c7fdca573b8f2835d4fe7b","availableFormats":["json"],"listOfBooksApiLink":"/api/bwo_twf/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7948,"languageName":"Boro (Ethiopia)","languageEnglishName":"Boro (Ethiopia)"},"book":{"id":"HEB","translationId":"bwo_twf","name":"Ibrawiyots","commonName":"Ibrawiyots","title":"Ibrawi Ashuwots Maants Wosheets Wosho","order":58,"numberOfChapters":13,"sha256":"074da3981b5bf565716c863c9452c4f7dc7157c7b01b86f5ef6e80037c5ee74d","firstChapterNumber":1,"firstChapterApiLink":"/api/bwo_twf/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/bwo_twf/HEB/13.json","totalNumberOfVerses":302},"chapter":{"number":1,"content":[{"type":"heading","content":["Ik'o b́naay weeron noosh b́keewtsok'o"]},{"type":"verse","number":1,"content":["Ik'o yoots dúr ay weerindon, nebiyiwots weeron nonih nih wotssh ayoto keewtni b́ teshi,"]},{"type":"verse","number":2,"content":["Andomó dúr s'uwanatse jam keewo b́ naatetwok'o b́ woshtson b́ naay weeron noosh keewre, dats jamonowere bíne bí'azi."]},{"type":"verse","number":3,"content":["Ik'i mango golr b́be'et bíyatsne, bí b́ doyon b́ s'eenon Ik'onton ike. B́ kúp' aap'on azeets jamo tep'dek't kurirwee, ash ashuwots morro b́ s'ayintsiyakon darotse Ik' kup'o k'ani aaromants beewtsere."]},{"type":"heading","content":["Naay wotts Ik'o b́melakiyotsiyere ayidek't bog b́wottsok'o"]},{"type":"verse","number":4,"content":["Eshe bísh imets shúútso melakiwotssh imets shúútsoniyere bogtso b́ wottsok'oon Ik'o naay, melakiwotsiyere ayidek't boge."]},{"type":"verse","number":5,"content":[{"text":"B́ jamon melakiwotsitse,","poem":1},{"lineBreak":true},{"text":"«Neehe t naay neene, hambets taa neen shuure,»","poem":1},{"lineBreak":true},{"text":"Wee","poem":1},{"lineBreak":true},{"text":"«Taa bísh nih wotitwe, bíwere t naayi wotituwe»","poem":1},{"text":"bí ettso konshe?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ik'o b́ naay k'aabo datsanats b́woshor","poem":1},{"lineBreak":true},{"text":"«Melaki jamwots bísh sagadone» etre.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"B́ melakiwots jangoshmó","poem":1},{"lineBreak":true},{"text":"«B́ melakiwotsi shayirwotsi","poem":1},{"noteId":0},{"text":"B́ gutswotsno taw laluwo woshitwee» bí eti.","poem":2},{"noteId":1}]},{"type":"verse","number":8,"content":[{"text":"B́ naayi jangoshmó,","poem":1},{"lineBreak":true},{"text":"«Ik'ono! n naashi jooro dúre dúroshe b́ beeti,","poem":1},{"text":"N mengsti gumbonu kááwon bín nk'eezit gumbee,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kááwu finono n shuni, morri gondo n shit'i,","poem":1},{"lineBreak":true},{"text":"Manatse tuutson Ik'o neen,","poem":1},{"text":"n tohwotsiyere bog gene'úwo neesh imet fuuto níats b́ fuuti» etfe.","poem":2}]},{"type":"verse","number":10,"content":["Andowere aani, «Doonzono! nee shin shino datsu nk'oons'i,",{"text":"Darwotswere nkishi finnee,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bo jametswere t'afitkne,","poem":1},{"lineBreak":true},{"text":"Neemó beetune,","poem":1},{"lineBreak":true},{"text":"Bo jametswere tahok'o s'uwitkne","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Shemok'o boon k'odetune,","poem":1},{"lineBreak":true},{"text":"Bowere tahok'o wonetúnee,","poem":1},{"text":"Nemó jam aawo woneratsnee,","poem":2},{"lineBreak":true},{"text":"N dúronwere s'uwo deshatse» bíeti","poem":2}]},{"type":"verse","number":13,"content":["Ik'o b́ melakiwotsitse,",{"text":"«N balangarwotsi n tufi shirots t gedfetso","poem":1},{"text":"t k'ano maantsan beewe» bí et konshe?","poem":2}]},{"type":"verse","number":14,"content":["Bere, melaki jamwots kashit ash ashuwotssh finosh wosheets Ik'i guuts wotts shayirwotsi woteratsnowa?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Shayira: Eto Griki mas'aafotse jongok'o woshefe etiru biitso detsfe.","reference":{"chapter":1,"verse":7}},{"noteId":1,"caller":"+","text":"Shayra: Eto b́melakitsi jongok'o woshitwe eta.","reference":{"chapter":1,"verse":7}}]},"thisChapterLink":"/api/bwo_twf/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bwo_twf/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bwo_twf/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}