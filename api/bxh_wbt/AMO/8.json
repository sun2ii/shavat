{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"AMO","translationId":"bxh_wbt","name":"Eimosi","commonName":"Eimosi","title":"Peloweta Eimosi ena Uliꞌuli","order":30,"numberOfChapters":1,"sha256":"35bcbc337cb6bdf2af2f28e6994294428549774b9434a2ab19c6a45aeca53b55","firstChapterNumber":8,"firstChapterApiLink":"/api/bxh_wbt/AMO/8.json","lastChapterNumber":8,"lastChapterApiLink":"/api/bxh_wbt/AMO/8.json","totalNumberOfVerses":5},"chapter":{"number":8,"content":[{"type":"heading","content":["Isalaela Haba Heyaya Laꞌilaꞌi sa Fahoina"]},{"type":"verse","number":4,"content":["Isalaela dodogamiu au ataꞌatahi, umi logemiu dodoga gogo gesagesa edi nuꞌu yai ami fahisu heyayaidi."]},{"type":"verse","number":5,"content":["Ami libaliba auwen, Sabati yo Nawalahi Falifalihu Mataꞌasidi fafatabudi te, feula ti ofi!",{"text":"Haba ema kalahe ꞌe uneꞌuneidi.","poem":2},{"lineBreak":true},{"text":"Na maisa te lau hitinidi,","poem":2},{"lineBreak":true},{"text":"yo nonoi bwalabwala te fapaisowadi,","poem":2},{"lineBreak":true},{"text":"be tau uneꞌune te bwalafahidi.","poem":2}]},{"type":"verse","number":6,"content":["Witi ma wenuna te uyaꞌuyai mate haba te uneꞌuneꞌen. Tau fagogo gesagesa ana hagahaga hige gonowana i famaisa, doha ahe sumasuma hige gonowana i famaisa mate haba te une fahi be eda fayofayo tau abina."]},{"type":"line_break"},{"type":"verse","number":7,"content":["Isalaela edi Guyau Yaubada ya angwala, iyen, Edi laulau heyaheyayadi, ibege nuwagu i fui."]},{"type":"verse","number":10,"content":[{"text":"Egu gigibwali yai haba mataꞌasi yo wana ami fatautau","poem":1},{"text":"na haba ami tan eloʼelosisi.","poem":2},{"text":"Baiki haba ami liʼodi yo kulumiu ami holidi.","poem":1},{"text":"Haba ami tan eloʼelosisi,","poem":2},{"text":"doha tawa “Natumiu taumoho esega dumaduma ya peʼi.”","poem":1},{"lineBreak":true},"Ai lahai ni haba kalapi laꞌilaꞌi ami fahoina."]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":5}