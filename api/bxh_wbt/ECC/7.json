{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"ECC","translationId":"bxh_wbt","name":"Tau Guguya","commonName":"Tau Guguya","title":"Tau Guguya (Ekelesiyasiti)","order":21,"numberOfChapters":9,"sha256":"6d20bd7d01f0e7812fdcce670dd42de96f9a63ed37ff6c579830bce99e1a2a98","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/bxh_wbt/ECC/12.json","totalNumberOfVerses":89},"chapter":{"number":7,"content":[{"type":"heading","content":["Sonoga"]},{"type":"verse","number":15,"content":[{"text":"Egu mwahuli kufakufana yai te, ginauli luwaga E itadi:","poem":1},{"text":"doga dudulaina ena miya hige i lofa, in moho ya peꞌi,","poem":2},{"text":"na doga heyaheyayana ya miya lofalofa ena heyaya yai.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tabu dudulai u diꞌoi be u dudulai wanawananaha,","poem":1},{"text":"yo sibasiba u diꞌoi be u sibasiba wanawananaha.","poem":2},{"text":"Doꞌata wa faheyaya fuyoim.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tabu hinaga heyaya u diꞌoi, be u heyaya wanawananaha,","poem":1},{"text":"yo tabu u yauyaule.","poem":2},{"text":"Hola hige em peꞌi fuyana na sidohana wa gado peꞌi feula?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ya loholoho ibe fanuwatagu libadi te ami nuwa nuwatuhuidi;","poem":1},{"text":"sai Guyau ya faꞌatitiyen","poem":2},{"lineBreak":true},{"text":"haba laulau heyaheyayadi luwaga te, ya gebaedi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tau sibasiba esega mate ya adidili wananaha,","poem":1},{"text":"habahim babaꞌisa safuhudohudoꞌi ma adiꞌadidilidi, taon yai.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tanoꞌubu yai te hige sai i dudulai.","poem":1},{"text":"Doga laulau loholohodi ya ginaginaulidi,","poem":2},{"lineBreak":true},{"text":"in moho heyaya ya ginauli hinaga.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/ECC/5.json","previousChapterAudioLinks":{},"numberOfVerses":6}