{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"GEN","translationId":"bxh_wbt","name":"Aba Fatubu","commonName":"Aba Fatubu","title":"Aba Fatubu (Genesi)","order":1,"numberOfChapters":31,"sha256":"4ec7efc6e870a7fa65da74f875f1bf28586755614af0f840c2d2e432e48abe4c","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/bxh_wbt/GEN/50.json","totalNumberOfVerses":550},"chapter":{"number":49,"content":[{"type":"heading","content":["Iyakobo ena Faloholoho Nanatuna Lisidi yai"]},{"type":"hebrew_subtitle","content":["Diuda"]},{"type":"verse","number":8,"content":["Diuda, haidam haba sa noꞌonoꞌoꞌem,",{"text":"paꞌana am waiyunu ai gadodi haba wa abi.","poem":1},{"lineBreak":true},{"text":"Haidam haba sa dulu matam yai.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Um doha laiyon gubugubufwauna.","poem":1},{"lineBreak":true},{"text":"Am mwaiha wa wunui, na wa fuyoma.","poem":1},{"lineBreak":true},{"text":"Wa eno na taum wa lolondi,","poem":1},{"lineBreak":true},{"text":"doha laiyon laꞌilaꞌi adiꞌadidilina,","poem":1},{"lineBreak":true},{"text":"haba sai gonowana ya fanohim?","poem":1}]},{"type":"verse","number":10,"content":["Tuꞌe nimam yai, ibege i beꞌu,",{"text":"e baꞌisa ena tuꞌe, ahena solasoladi yai,","poem":1},{"lineBreak":true},{"text":"ibege hinaga i beꞌu, ana sigana ee–,","poem":1},{"text":"ya laoma tanuwagana lebena","poem":2},{"text":"yo nuꞌu sa awa abi, mate in ena.","poem":1},{"noteId":35}]},{"type":"verse","number":11,"content":["Haba em donki gubugubu fwauna wa auꞌauꞌaui,",{"text":"ai wain mahinana loholohona yai.","poem":1},{"lineBreak":true},{"text":"Em leli haba wain yai wa kaisudi,","poem":1},{"text":"wain nenena doha ꞌwasina balebalelemna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Matam sa kwasina wain nomnomna yai,","poem":1},{"text":"na susu nomnomdi yai be moꞌam sa kafu.","poem":2}]},{"type":"verse","number":33,"content":["Fuyanna Iyakobo nanatuna ya faliba maꞌudaidi ahena ya toledi ena aba eno yai na ya umesi afulen. Iyakobo Idipi Nuꞌuna yai ya miya bolima 17, na ena bolima laꞌina mate 147."]}],"footnotes":[{"noteId":35,"caller":"+","text":"Diuda laulawena ai ganahewana haba kin sa tubu, ya lidima ee–, Yesu Keliso.","reference":{"chapter":49,"verse":10}}]},"thisChapterLink":"/api/bxh_wbt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":6}