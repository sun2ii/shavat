{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"ISA","translationId":"bxh_wbt","name":"Isaiya","commonName":"Isaiya","title":"Peloweta Isaiya ena Uliꞌuli","order":23,"numberOfChapters":20,"sha256":"ca2ee1d33d7b2ae37e0293698216b1e3bf98e37df011138f811a05e9ea3e179a","firstChapterNumber":2,"firstChapterApiLink":"/api/bxh_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/bxh_wbt/ISA/64.json","totalNumberOfVerses":144},"chapter":{"number":2,"content":[{"type":"heading","content":["Nuwa Esega Otaꞌota Fahina"]},{"type":"verse","number":1,"content":["Tautau yai, Yaubada ya taumahata Eimosi natuna Isaiya lebena yai be ena nuwatuhu somo Diuda yo Yelusalem lisidi yai ya faliba."]},{"type":"verse","number":2,"content":[{"text":"Iyen, “Fuya matada yai Dubu Tabuna","poem":1},{"text":"ena aba mwaito tuꞌana","poem":2},{"lineBreak":true},{"text":"haba tuꞌa hahaisa ya sai tawanidi.","poem":2},{"lineBreak":true},{"text":"Nuꞌu boludi haba sa fabaiwama ainiya”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"be dodoga boludi haba tiyen,","poem":1},{"lineBreak":true},{"text":"“U laoma, ta lau Yaubada ena tuꞌa,","poem":1},{"text":"ta lau Isalaela edi Guyau ena Dubu Tabuna.","poem":2},{"text":"Ena laulau haba ya fatalahada","poem":1},{"text":"be gonowana te lau watanidi.","poem":2},{"text":"Yaubada ena lau faꞌata mate Yelusalem yai sa tulu beꞌuma;","poem":1},{"text":"be Saiyon Tuꞌana yai","poem":2},{"noteId":0},{"text":"ena dodoga ya falibadi.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pilipili nuꞌu laꞌilaꞌidi yai haba ya tole fadudulaidi.","poem":1},{"text":"Edi kebolo haba sa bibidi be sa famala tanohi aba giyagiyali,","poem":2},{"text":"na edi baineti haba sa ginauli fuyoꞌidi","poem":1},{"text":"be sa famala umaꞌuma aba iboꞌibodi.","poem":2},{"text":"Nuꞌu hesa ibege i lau nuꞌu hesa i hiyala fuyoi,","poem":1},{"text":"hiyala sa lubulubui ibege ti lubulubui fuyo.","poem":2}]},{"type":"verse","number":5,"content":["Iyakobo laulauwewena, aho te, Yaubada mala ya feleda bena te lau watan!"]}],"footnotes":[{"noteId":0,"caller":"+","text":"Saiyon Tuꞌanamate Deiwidi ena tefa Yelusalem ganahewana yai.","reference":{"chapter":2,"verse":3}}]},"thisChapterLink":"/api/bxh_wbt/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":5}