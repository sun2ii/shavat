{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"ISA","translationId":"bxh_wbt","name":"Isaiya","commonName":"Isaiya","title":"Peloweta Isaiya ena Uliꞌuli","order":23,"numberOfChapters":20,"sha256":"ca2ee1d33d7b2ae37e0293698216b1e3bf98e37df011138f811a05e9ea3e179a","firstChapterNumber":2,"firstChapterApiLink":"/api/bxh_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/bxh_wbt/ISA/64.json","totalNumberOfVerses":144},"chapter":{"number":40,"content":[{"type":"heading","content":["Yaubada ena Dodoga Nuwadi sa Talu"]},{"type":"verse","number":1,"content":["Eda Yaubada iyen,",{"text":"“Egu dodoga nuwadi au liba fataludi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Au liba bigabiga lau Yelusalem lisina,","poem":1},{"lineBreak":true},{"text":"yo au faliba mate:","poem":1},{"text":"Ibege ti lau fayofayo fuyoimiu.","poem":2},{"lineBreak":true},{"text":"Emi kamkamna ana siga itete.","poem":2},{"text":"Yau, Guyau, emi heyaya haꞌa E famaisadi.”","poem":1}]},{"type":"verse","number":3,"content":["Doga hesa ya yogayoga iyebom,",{"text":"“Ai nuꞌu pitapitalina edaꞌeda au faꞌaꞌa!","poem":1},{"lineBreak":true},{"text":"Edaꞌeda dudulaina au ginauli,","poem":1},{"lineBreak":true},{"text":"Guyau eda Yaubada enehena.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dahadaha au famohafudi;","poem":1},{"lineBreak":true},{"text":"tuꞌa yo uduhuli au fatabatabadi.","poem":1},{"lineBreak":true},{"text":"Piupiu hitidi au fadudulaidi","poem":1},{"text":"yo mala heyaheyaya haba sa famala gon.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Habahim Yaubada ena namanamali didigana haba ya taumahata,","poem":1},{"lineBreak":true},{"text":"be dodoga mahudoꞌidi sa ita.","poem":1},{"lineBreak":true},{"text":"Libadi te, Guyau moꞌana yai sa tulu beꞌuma!”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alina hudoꞌi ya liba iyen, “Wasa au duwai!”","poem":1},{"text":"Yo fede E fatiꞌo, yawa, “Wasa somo haba E duwai?”","poem":2},{"text":"Iyen, “U liba, uwen, ‘Dodoga mahudoꞌimiu mate doha hawahawa yo mula;","poem":1},{"text":"Paꞌana ibege ti ota lofalofa.”","poem":2}]},{"type":"verse","number":7,"content":["Yena Guyau ya yahafuwa lau hawahawa yo mula hewadi yai haba sa hohoya.",{"text":"Wananaha dodoga mate doha. Hige ti ota fuya lofalofa.","poem":2}]},{"type":"verse","number":8,"content":["Mula yo hawahawa haba sa hohoya,",{"text":"in moho somo eda Yaubada ya libaen, mate ya ota esegahi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sai wasa loholohona wa leyama Saiyon,","poem":1},{"text":"u hasai tuꞌa lofalofana.","poem":2},{"text":"Ai Yelusalem wasa te, u fatala yogayogaꞌen,","poem":1},{"text":"tabu u ꞌwasabu;","poem":2},{"text":"Diuda taonidi u falibadi uwe,","poem":1},{"text":"“Ma! Emi Yaubada ite!”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Guyau, emi Yaubada ya laoma ma gigibwalina","poem":1},{"text":"ya famala emi baꞌisa,","poem":2},{"text":"Maisana, logena ena dodoga,","poem":1},{"text":"ya fofofahidi, ma afa haidana sa laoma.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Haba doha tau itaꞌita wata","poem":1},{"text":"sipi ya foyahidi be sa anban;","poem":2},{"text":"Sipi nanatudi haba ya foyahi gogonidima","poem":1},{"text":"be ya labadi","poem":2},{"text":"yo sipi fanafanatudi haba ya foyahidi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/ISA/35.json","previousChapterAudioLinks":{},"numberOfVerses":11}