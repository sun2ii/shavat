{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"ISA","translationId":"bxh_wbt","name":"Isaiya","commonName":"Isaiya","title":"Peloweta Isaiya ena Uliꞌuli","order":23,"numberOfChapters":20,"sha256":"ca2ee1d33d7b2ae37e0293698216b1e3bf98e37df011138f811a05e9ea3e179a","firstChapterNumber":2,"firstChapterApiLink":"/api/bxh_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/bxh_wbt/ISA/64.json","totalNumberOfVerses":144},"chapter":{"number":42,"content":[{"type":"heading","content":["Guyau Ena Tau Paisowa"]},{"type":"verse","number":1,"content":[{"text":"Itete egu tau paisowa, Yau E faꞌadidili,","poem":1},{"lineBreak":true},{"text":"yo E fasinabo, nuwagu ya loholoho lisina yai;","poem":1},{"lineBreak":true},{"text":"Yaluwagu haꞌa E tole lisina yai,","poem":1},{"lineBreak":true},{"text":"be dudulai haba ya leyama nuꞌu ouꞌouli.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"In ibege i fatala bwasabwasa,","poem":1},{"text":"e i ꞌwalaꞌwalaꞌuwi o i yogayoga ai edaꞌeda. (Matiu 12:19)","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Didiyali nobunobuna ibege i kampwai,","poem":1},{"noteId":4},{"lineBreak":true},{"text":"o mala ya leꞌileꞌi ibege i fapeꞌi.","poem":1},{"noteId":5},{"lineBreak":true},{"text":"In moho dudulai haba ya leyama.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ibege nuwana i belubelu yo paisowa i fatautau ana sigana ee–,","poem":1},{"lineBreak":true},{"text":"dudulai ya leyama tanoꞌubu mahudoꞌina yai,","poem":1},{"lineBreak":true},{"text":"yo dodoga bonabonaluwa yai hinaga ena lau faꞌata sa bagibagiyen.","poem":1}]},{"type":"verse","number":5,"content":["Yaubada galewa, tanoꞌubu yo ginauli mahudoꞌidi ya ginaulidi na dodoga tanoꞌubu yai mwahuli yo yahafuwa ya feledi. Logena ya liba doha ite:"]},{"type":"verse","number":6,"content":["“Yau, Guyau, E yogaim, yo gigibwali E felem",{"text":"bena E ita haba dudulai ya tubu ai tanoꞌubu.","poem":1},{"lineBreak":true},{"text":"Um ai debam haba yali E ginauli","poem":1},{"text":"dodoga mahudoꞌidi ai lebedi;","poem":2},{"text":"Yo um ai debam Yau haba mala E leyama ai nuꞌudi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dodoga mata toutoudi haba matadi wa falaladi.","poem":1},{"lineBreak":true},{"text":"Yo tau lau deli, kamumu yai sa miyamiya","poem":1},{"text":"haba wa soꞌe fahidi.”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Aniyona mate, Guyau ena nuwatohatoha yai dodoga belubeludi lisidi yai ya itaꞌita wata komakomanidi.","reference":{"chapter":42,"verse":3}},{"noteId":5,"caller":"+","text":"Te belubelu na Yesu ya faꞌadidilida","reference":{"chapter":42,"verse":3}}]},"thisChapterLink":"/api/bxh_wbt/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":7}