{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"ISA","translationId":"bxh_wbt","name":"Isaiya","commonName":"Isaiya","title":"Peloweta Isaiya ena Uliꞌuli","order":23,"numberOfChapters":20,"sha256":"ca2ee1d33d7b2ae37e0293698216b1e3bf98e37df011138f811a05e9ea3e179a","firstChapterNumber":2,"firstChapterApiLink":"/api/bxh_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/bxh_wbt/ISA/64.json","totalNumberOfVerses":144},"chapter":{"number":52,"content":[{"type":"heading","content":["Yaubada haba Yelusalem ya Fofofahidi."]},{"type":"verse","number":7,"content":[{"text":"Wasa tau leyamana tuꞌa ya diꞌoma,","poem":1},{"text":"sa ita mate nuwadi sa kwade wananaha. (Loma 10:15)","poem":2},{"text":"Yelusalem dodogadi ya falibadi iyebom,","poem":1},{"text":"“Wasa Loholohona E leyama, fanuwa esega yo mwahuli wasadi.","poem":2},{"text":"Guyau mate emi Kin!”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yelusalem tau bobodiyenna,","poem":1},{"text":"sa yogayoga ma kwadedi.","poem":2},{"text":"Saiyon yai Guyau ya fuyo,","poem":1},{"noteId":6},{"text":"sa ita wananahai.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yelusalem dodogadi, emi aba talotalopa yai au obiyo!","poem":1},{"text":"Au yogayoga ma kwademiu.","poem":2},{"text":"Paꞌana Guyau haꞌa nuwamiu ya liba fataludi,","poem":1},{"text":"na ya laoma bena ya fofofahimiu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yaubada ena gigibwali tabuna haꞌa ya famahata.","poem":1},{"text":"Haba ya fofofahimiu yo dodoga tanoꞌubu mahudoꞌina yai","poem":2},{"text":"ena gigibwali haba sa ita.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Guyau iyen, “Egu tau paisowa haba ana paisowa ya fawananaha.","poem":1},{"lineBreak":true},{"text":"Haba sa ita falaꞌi yo hesana sa lau hitin.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Salumadi haꞌa sa ita, mate sa tau hiti.","poem":1},{"text":"Nenena ya bui yo itaꞌitana ya heyaya.","poem":2},{"text":"Hige doha tau wananaha.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nuꞌu boludi dodogadi haba ya fanoꞌodi,","poem":1},{"text":"yo kin boludi haba ya faꞌoigogodi.","poem":2},{"text":"Na safaluma ma supusupudi","poem":1},{"text":"haba sa ita lobahi.”","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Yelusalem hesana hesa mate Saiyon.","reference":{"chapter":52,"verse":8}}]},"thisChapterLink":"/api/bxh_wbt/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":7}