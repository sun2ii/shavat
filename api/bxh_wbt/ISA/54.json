{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"ISA","translationId":"bxh_wbt","name":"Isaiya","commonName":"Isaiya","title":"Peloweta Isaiya ena Uliꞌuli","order":23,"numberOfChapters":20,"sha256":"ca2ee1d33d7b2ae37e0293698216b1e3bf98e37df011138f811a05e9ea3e179a","firstChapterNumber":2,"firstChapterApiLink":"/api/bxh_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/bxh_wbt/ISA/64.json","totalNumberOfVerses":144},"chapter":{"number":54,"content":[{"type":"heading","content":["Guyau ena Gadosisi Isalaela Enehedi"]},{"type":"verse","number":5,"content":["Tau Ginaulim mate doha lahum.",{"text":"Hesana mate Guyau Gigigibwalina.","poem":1},{"lineBreak":true},{"text":"In tau une fahim,","poem":1},{"text":"Yaubada fafatabuna Isalaela enehem.","poem":2},{"lineBreak":true},{"text":"Hesana mate “Tanoꞌubu mahudoꞌina edi Yaubada.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Isalaela, um doha waihin hasahasalana,","poem":1},{"lineBreak":true},{"text":"lahuna ya lau afulen be nuwana ya heyaya.","poem":1},{"lineBreak":true},{"text":"In moho Guyau em Yaubada ya yoga fafuyom na iye,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“E ꞌwaiyoꞌoꞌem maihala tupotupo.","poem":1},{"lineBreak":true},{"text":"In moho E fanuwatohatohaem,","poem":1},{"lineBreak":true},{"text":"Be haba E fafuyom.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E manabala heyaya be E sana mulimuliyem fuya tupotupo.","poem":1},{"lineBreak":true},{"text":"In moho egu gadosisi otaꞌota fahina debana yai","poem":1},{"text":"haba E fanuwatohatohaem!","poem":2},{"text":"Yau em Guyau, tau fofofahim E falibam doha ite.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“Nowa ena fuya yai E angwala mate","poem":1},{"text":"ibege tanoꞌubu ya faheyaya bodai ai utufi.","poem":2},{"text":"Be aho te E angwala mate","poem":1},{"text":"ibege ya manabala be ya faheyayam.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tuꞌa lalaꞌi sa dihodiho,","poem":1},{"text":"yo kikiꞌina sa tauyamuhi,","poem":2},{"text":"in moho egu gadosisi, enehem,","poem":1},{"text":"haba ya ota esegahi lisim yai.","poem":2},{"text":"Nuwa talu angwalana E ginauli","poem":1},{"text":"haba ya ota esegahi.","poem":2},{"text":"Yau, Guyau, tau fafanuwatohatohaem E falibam doha ite.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":6}