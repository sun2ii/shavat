{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"ISA","translationId":"bxh_wbt","name":"Isaiya","commonName":"Isaiya","title":"Peloweta Isaiya ena Uliꞌuli","order":23,"numberOfChapters":20,"sha256":"ca2ee1d33d7b2ae37e0293698216b1e3bf98e37df011138f811a05e9ea3e179a","firstChapterNumber":2,"firstChapterApiLink":"/api/bxh_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/bxh_wbt/ISA/64.json","totalNumberOfVerses":144},"chapter":{"number":56,"content":[{"type":"heading","content":["Nuꞌu hudoꞌi - hudoꞌi Hinaga haba Yaubada ena Loholoho sa Fahoina"]},{"type":"verse","number":1,"content":[{"text":"Guyau ena dodoga ya falibadi iyebom,","poem":1},{"lineBreak":true},{"text":"“Somo ya dudulai yo ya loholoho mate au ginauli,","poem":1},{"text":"yo miyamiya loholohodi bena ami miyamiyaꞌedi,","poem":2},{"lineBreak":true},{"text":"paꞌana begana haba E saguhimiu","poem":2},{"lineBreak":true},{"text":"yo egu dudulai wananahana E famahata.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taꞌowawa salumadi sa fele fuyoꞌidi Guyau lisina","poem":1},{"text":"bena ena sa paisowa,","poem":2},{"text":"bena Guyau hesana sa fanuha,","poem":1},{"lineBreak":true},{"text":"yo sa fadebasae,","poem":1},{"lineBreak":true},{"text":"salumadi mahudoꞌidi Sabati sa faꞌatitiyen yo hige ti kaiwegowegogoꞌen,","poem":1},{"text":"yo salumadi egu yali sa abi didin.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Haba E lawemiu egu Tuꞌa Fafatabuna yai","poem":1},{"text":"yo egu aba lauꞌuꞌula lumana yai,","poem":2},{"lineBreak":true},{"text":"be kwade E felemiu.","poem":2},{"text":"Ainauya gabugabudi yo antalasam haisa haba nuwagu sa abi egu aba antalasam yai.","poem":1},{"text":"Egu Dubu mate Aba Laulauꞌuꞌula, egu dodoga nuꞌu ouꞌouli yai, enehedi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":3}