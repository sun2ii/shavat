{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"ISA","translationId":"bxh_wbt","name":"Isaiya","commonName":"Isaiya","title":"Peloweta Isaiya ena Uliꞌuli","order":23,"numberOfChapters":20,"sha256":"ca2ee1d33d7b2ae37e0293698216b1e3bf98e37df011138f811a05e9ea3e179a","firstChapterNumber":2,"firstChapterApiLink":"/api/bxh_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/bxh_wbt/ISA/64.json","totalNumberOfVerses":144},"chapter":{"number":58,"content":[{"type":"heading","content":["Anhudi Wananahana"]},{"type":"verse","number":7,"content":[{"text":"Salumadi sa guliyam mate ami kalahe adi au soi;","poem":1},{"text":"tau leuleu saisai hige edi luma mate,","poem":2},{"lineBreak":true},{"text":"au yoga hitinidi emi ai luma.","poem":2},{"text":"Salumadi ma kofakofadi au falelidi;","poem":1},{"text":"afa efamiu tabu au siꞌeiyedi. (Matiu 25:35-36)","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Haba emi mala sa sina doha hwalahwalala maihalana,","poem":1},{"text":"be haba feula, na ami loholoho.","poem":2},{"text":"Emi laulau dudulaidi haba sa eda bwaꞌiyemiu,","poem":1},{"text":"na Guyau ena namanamali haba mulimiu ya bobodiyen.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yena ami anꞌetai, Guyau haba alinamiu ya bui,","poem":1},{"text":"na sagu ami anꞌetai haba iyen, “Yau ite!”","poem":2},{"text":"Dodoga haisa ami abi faheyayadi, e ami fagilu gaibuidi,","poem":1},{"text":"e ami liba fafaheyayadi, mate bena ami fatautau.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yena tau guliguliyam kalahe adi au soi,","poem":1},{"text":"yo safaluma edi mwahuli sa heyaya, au saguhidi","poem":2},{"text":"Haba kamumu ai ganahewana emi mala ya sina,","poem":1},{"text":"na maihona haba doha lahai laꞌi maihalana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":4}