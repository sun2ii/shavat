{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"ISA","translationId":"bxh_wbt","name":"Isaiya","commonName":"Isaiya","title":"Peloweta Isaiya ena Uliꞌuli","order":23,"numberOfChapters":20,"sha256":"ca2ee1d33d7b2ae37e0293698216b1e3bf98e37df011138f811a05e9ea3e179a","firstChapterNumber":2,"firstChapterApiLink":"/api/bxh_wbt/ISA/2.json","lastChapterNumber":64,"lastChapterApiLink":"/api/bxh_wbt/ISA/64.json","totalNumberOfVerses":144},"chapter":{"number":64,"content":[{"type":"heading","content":["Hige Yaubada hesa doha Um!"]},{"type":"verse","number":4,"content":[{"text":"Beyabeyana hige sai laꞌi yaubada hesa wasana i atahiyen","poem":1},{"text":"yo nenena i ita, doha Um.","poem":2},{"text":"Um ibom mate salumadi sa bagibagiyem enehedi wa paisowa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wa laoma be salumadi ma nuwa amnadi dudulai sa laulau ginauli, wa saguhida.","poem":1},{"text":"Yo em laulau sa miyamiyaꞌedi, wa yoga hitinidi.","poem":2},{"text":"In moho heyaya hola E laulau ginauli, be manam E fabala.","poem":1},{"lineBreak":true},{"text":"Haba sidohana ema mwahumwahuli?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mahudoꞌimai tau heyaya.","poem":1},{"lineBreak":true},{"text":"Ema laulau dudulaidi mahudoꞌidi doha ahe sausau bidabidadi.","poem":1},{"lineBreak":true},{"text":"Ai E hohoya doha oyagi lugudi;","poem":1},{"lineBreak":true},{"text":"Yo doha hwayahwayau ema heyaya ya uya hudoꞌiyedi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hige sai hesam yai i lauꞌuꞌula,","poem":1},{"lineBreak":true},{"text":"e, i miya esegahi lisim yai.","poem":1},{"lineBreak":true},{"text":"Be wa sana mulimuliyemai,","poem":1},{"lineBreak":true},{"text":"yo wa ita afulemai, be ema heyaya sa lawe hudoꞌiyemai.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"In moho, Guyau, um Tamamai.","poem":1},{"lineBreak":true},{"text":"Ai bwadagowa, na um tau falasa.","poem":1},{"lineBreak":true},{"text":"Nimam yai wa falasamai. (2 Kolinto 4:3)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Guyau, tabu em manabala u falofa,","poem":1},{"lineBreak":true},{"text":"yo ema heyaheyaya tabu ai nuwam ti ota.","poem":1},{"lineBreak":true},{"text":"Ema lauꞌuꞌula u atahiyedi, be u nuwatohatohaemai","poem":1},{"lineBreak":true},{"text":"paꞌana mahudoꞌimai, em dodoga.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":6}