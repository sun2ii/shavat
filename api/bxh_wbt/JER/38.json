{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"JER","translationId":"bxh_wbt","name":"Delamaiya","commonName":"Delamaiya","title":"Peloweta Delamaiya ena Uliꞌuli","order":24,"numberOfChapters":8,"sha256":"3191d8ee3608319256fb21fb4e2768ee50c34ad3dbefc478d31c3cb426d5e529","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/JER/1.json","lastChapterNumber":38,"lastChapterApiLink":"/api/bxh_wbt/JER/38.json","totalNumberOfVerses":47},"chapter":{"number":38,"content":[{"type":"heading","content":["Delamaiya Pulu Pitapitalina Ganahewana yai."]},{"type":"verse","number":4,"content":["Habahim babaꞌisa sa libalau Kin lisina, tiyen, Delamaiya hige dodoga i saguhidi. Ena libaliba yai tau hiyala yo dodoga nuꞌu balabalamumu yai ya faꞌwasabudi, be nuwadi sa belubelu. Doga te bena te wunui."]},{"type":"verse","number":5,"content":["Kin Sedekaiya alinadi ya ehe watawatan iyen, Nimamiu yai E toleyawa. Somo ami fanuha au ginauli, hige gonowana ya gudumiu."]},{"type":"verse","number":6,"content":["Yo fede Delamaiya sa lawen Kin natuna Malakiya ana hoꞌowa aba oiꞌoi felenna yai. Puluna mate Malakiya ena gati edi dobidobi yai. Delamaiya mahina yai sa fadalo lidiyen pulu ganahewana yai. In moho hige hoꞌowa, mwano moho. Yo fede Delamaiya ya lau sopu mwano yai."]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/JER/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/LAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/JER/33.json","previousChapterAudioLinks":{},"numberOfVerses":3}