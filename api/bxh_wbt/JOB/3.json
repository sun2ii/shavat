{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"JOB","translationId":"bxh_wbt","name":"Diyobi","commonName":"Diyobi","title":"Diyobi Dedena","order":18,"numberOfChapters":7,"sha256":"b56d61d4d5849c64734cbaaa348c29885db9c991d0058c45f0c3396a0a004fad","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bxh_wbt/JOB/42.json","totalNumberOfVerses":86},"chapter":{"number":3,"content":[{"type":"heading","content":["Diyobi edi Fuya Yosina Lahaina ya Kaumananaen"]},{"type":"verse","number":1,"content":["Habahim Diyobi ya fatubu ya kaumananaen."]},{"type":"verse","number":2,"content":["Iyen, Aee–, Guyau,",{"text":"ibe edi fuya yosigu, tabu ti nuwatuhui,","poem":2},{"lineBreak":true},{"text":"na maihonana tiyen, “gwama sa yosi!”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lahaina ni u bui be i kamumu;","poem":1},{"text":"Haba Yaubadana ibege i modeꞌen.","poem":2},{"text":"Tabu mala i sina, ai hewana.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lahaina i kamumu lubilubi,","poem":1},{"text":"yo yada dubadubadi, galewa yo maihala ti fakoudi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Iꞌipa, kamumu i abi didini;","poem":1},{"text":"Tabu edi fuya yosigu lahaina ti fatili esegahi,","poem":2},{"lineBreak":true},{"text":"egu fuya tubu lahaina ti saufahi!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Iꞌipana i agali, doha waihin hige i fanatu.","poem":1},{"text":"Tabu kwade laꞌilaꞌi maihona yai ni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tau kaukaumanana lahaina ni ti kaumananaen,","poem":1},{"text":"safalumadi sa nonoha bena Lewaitan sa liba faleꞌo fahi.","poem":2},{"noteId":4}]},{"type":"verse","number":9,"content":["Hwalahwalala kipwaladi tabu ti mala,",{"text":"yo tabu i ifi tatatali.","poem":2},{"lineBreak":true},{"text":"Lahai i bagi asahai.","poem":2}]},{"type":"verse","number":10,"content":["Beyabeyana tabu ti yosigu,",{"text":"be pilipili tabu ya fahoinadi.","poem":2}]},{"type":"verse","number":11,"content":["Sidohana be hige ya peꞌi,",{"text":"tinagu bogana ganahewana yai?","poem":2},{"lineBreak":true},{"text":"Ye ena fuya yosigu yai?","poem":2}]},{"type":"verse","number":12,"content":["Sidohana be tinagu ya labalabaigu,",{"text":"yo ya fafanomgu?","poem":2}]},{"type":"verse","number":13,"content":["Ibe moho E peꞌi,",{"text":"egoba E anyawasi esega.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Maidagu kin yo babada tanoꞌubu yai,","poem":1},{"text":"safalumadi edi luma loholohodi haꞌa sa lau ginauli","poem":2},{"lineBreak":true},{"text":"na aho te sa faheyayadi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yo maidagu tau foyafoya fafagoledi,","poem":1},{"text":"edi luma siluba sa famohafu.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Beyabeyana dodoga edi nuwatuhu mate ginauli laꞌilaꞌi te, ena gigibwali gonowana nuꞌu ya fakamumudi yo heyaya ya ginaulidi. Edi nuwatuhu mate, ena aba miya gabogabo yai, na nenena doha weso laꞌilaꞌina.","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/bxh_wbt/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":14}