{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"JOB","translationId":"bxh_wbt","name":"Diyobi","commonName":"Diyobi","title":"Diyobi Dedena","order":18,"numberOfChapters":7,"sha256":"b56d61d4d5849c64734cbaaa348c29885db9c991d0058c45f0c3396a0a004fad","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bxh_wbt/JOB/42.json","totalNumberOfVerses":86},"chapter":{"number":38,"content":[{"type":"heading","content":["Guyau Diyobi ena Liba ya Bui"]},{"type":"verse","number":1,"content":["Habahim bwai filifili ganahewana yai Guyau, Diyobi ena bui ya felen iyebom,"]},{"type":"verse","number":2,"content":["Um sai itete? Egu nuwatuhu wa fafadosi fuyoꞌidi. Wa libalibaidi bena haga um tau sonoga. In moho, higeꞌe."]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yena um taumoho, u obiyo adidili.","poem":1},{"text":"Haba E fatiꞌoim","poem":2},{"lineBreak":true},{"text":"na egu bui wa felegu.","poem":2}]},{"type":"verse","number":4,"content":["Fuyanna tanoꞌubu aba fatubuna E tole mate, um somo yai?",{"text":"Yena wa sibai, u falibagu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sai tanoꞌubu laꞌina ya lufa?","poem":1},{"text":"Yo sai mahina ya wewehi fadohe? Haꞌa wa sibai?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tanohi aba fatubuna umeꞌehuna somo yai sa tole?","poem":1},{"text":"E sai tanoꞌubu aba fatubuna ya abi didiꞌi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Fuyanna mate hwalahwalala kipwaladi mahudoꞌidi sa wana gogo esega.","poem":1},{"text":"Yo anelu mahudoꞌidi sa yogayoga ma nuwa kwadedi.","poem":2}]},{"type":"verse","number":8,"content":["Gabogabo sai ya gudu,",{"text":"fuyanna ena aba tubu yai ya pisalama?","poem":2},{"text":"Be gabogabo ena aba otaꞌota yai ya ota,","poem":1},{"text":"hige ana sigasiga i diꞌoi?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":8}