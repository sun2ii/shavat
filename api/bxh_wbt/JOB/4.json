{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"JOB","translationId":"bxh_wbt","name":"Diyobi","commonName":"Diyobi","title":"Diyobi Dedena","order":18,"numberOfChapters":7,"sha256":"b56d61d4d5849c64734cbaaa348c29885db9c991d0058c45f0c3396a0a004fad","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/bxh_wbt/JOB/42.json","totalNumberOfVerses":86},"chapter":{"number":4,"content":[{"type":"heading","content":["Elifasi, Diyobi ya Fafaliba"]},{"type":"verse","number":1,"content":["Habahim Elifasi Tema dogana, Diyobi alinana ya bui iyen,"]},{"type":"verse","number":2,"content":["Ibe E libaliba haba wa manabalaꞌegu e higeꞌe?",{"text":"Sai haba gonowana moꞌagu ya gudu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E siba, dodoga boludi wa fatalahadi,","poem":1},{"text":"na megomegodi wa faꞌadidilidi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dodoga edi pilipili yai sa faꞌalu betibeti,","poem":1},{"text":"yo salumadi tulidi sa mwahu,","poem":2},{"lineBreak":true},{"text":"haꞌa nuwadi wa liba faꞌadidilidi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"In moho aho pilipili wa fafahoina.","poem":1},{"text":"Lisina yai mate nuwam ya belubelu;","poem":2},{"lineBreak":true},{"text":"ya oi tawaim, yo fede, haꞌai! Em adidili ya ofi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Em kawa wananaha Yaubada lisina yai,","poem":1},{"text":"yo em laulau dudulai sa famala em sunuma.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aho haga u nuwanuwatuhu!","poem":1},{"text":"Tau laulau dudulai sai laꞌi hige i peꞌi,","poem":2},{"lineBreak":true},{"text":"yo heyaya hige i fafahoinadi!","poem":2},{"noteId":5}]},{"type":"verse","number":8,"content":[{"text":"Egu itaꞌita yai mate, safalumadi heyaheyaya sa umahidi,","poem":1},{"text":"yo pilipili sa falili,","poem":2},{"lineBreak":true},{"text":"haba heyaheyaya sa falolodi.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Doha, Elifasi ya anpate bena Diyobi ya bwalai. Te siba mate, dodoga heyaheyayadi yo loholohodi sa peꞌipeꞌi yo pilipili sa fahoinadi hinaga.","reference":{"chapter":4,"verse":7}}]},"thisChapterLink":"/api/bxh_wbt/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}