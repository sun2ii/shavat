{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"LEV","translationId":"bxh_wbt","name":"Lewitikusi","commonName":"Lewitikusi","title":"Lewitikusi Lewi Laulauwewena Adi Paisowa","order":3,"numberOfChapters":8,"sha256":"bc4b1b9a266111fbf5e409be83304613c7ce113586612c293985564ca8011cda","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/LEV/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/bxh_wbt/LEV/24.json","totalNumberOfVerses":50},"chapter":{"number":18,"content":[{"type":"heading","content":["Luma Gwaꞌu Lau Faꞌatadi"]},{"type":"verse","number":1,"content":["Guyau ya libalau Mose lisina iyen,"]},{"type":"verse","number":2,"content":["Isalaela dodogadi u falibadi uwe, “Guyau, mate emi Yaubada."]},{"type":"verse","number":3,"content":["Isalaela dodogadi, beyabeyana ma afa haidamiu ami miyamiya Idipi yai na aho E lawemiu Kanana. Tabu emi laulau doha Idipi yo Kanana dodogadi."]},{"type":"verse","number":4,"content":["“Yau Guyau, emi Yaubada",{"text":"Au ataꞌatahi na egu laugagayo","poem":2},{"text":"au lau watan komakomanidi.","poem":1}]},{"type":"verse","number":5,"content":["“Yau Guyau!",{"text":"Egu oibulu yo egu laugagayo au lau watanidi!","poem":2},{"text":"Sai hige i awa abiyedi, ibege i mwahuli.","poem":1}]},{"type":"verse","number":6,"content":["“Yau Guyau!",{"text":"Tabu sai laꞌi efana hesa","poem":2},{"text":"maꞌena ti luma gwaꞌu.”","poem":1},"Guyau iyen,"]},{"type":"verse","number":19,"content":["Yena waihin ena nawalahi asiyebona ya abi,",{"text":"tabu au luma gwaꞌui,","poem":1},{"text":"paꞌana in ya bida.","poem":2}]},{"type":"verse","number":20,"content":["Falem tau miya lahuna",{"text":"tabu u luma gwaꞌui.","poem":2},{"lineBreak":true},{"text":"Haba ya fabidahem.","poem":2},{"noteId":5}]},{"type":"line_break"},{"type":"verse","number":21,"content":["Yau Guyau emi Yaubada!",{"text":"Tabu natumiu laꞌi au antalasamen","poem":1},{"text":"Moleka lebena yai.","poem":2},{"noteId":6},{"text":"Yena ami ginauli doha","poem":1},{"text":"haba ami fataumayamayagu.","poem":2}]},{"type":"verse","number":22,"content":["Tabu tatau luwaga ti luma gwaꞌu,",{"text":"doha taumoho maꞌena waihin sa luma gwaꞌu.","poem":1},{"text":"Laulau ni Yaubada ya ꞌwaiyoꞌo.","poem":2}]},{"type":"verse","number":23,"content":["“Tabu taumoho e waihin laꞌi",{"text":"maꞌena suisui ti luma gwaꞌu be i fabida fuyoi,","poem":2},{"lineBreak":true},{"text":"mate hige i dudulai.","poem":2}]},{"type":"verse","number":24,"content":["“Logena, laulaudi te, tabu laꞌi i fabidahemiu, paꞌana laulaudi te debadi yai, Kanana dodogadi safaluma haba E weꞌaidi matamiu yai, haꞌa sa fabidahedi.”"]}],"footnotes":[{"noteId":5,"caller":"+","text":"Fabidahem e bidaaniyona mate laugagayohinaga.","reference":{"chapter":18,"verse":20}},{"noteId":6,"caller":"+","text":"Moleka mate Amon dodogadi edi yaubada bwalabwala hesa, na safaluma Moleka sa famamuli watan mate nanatudi sa antalasamedi lisina. Kin Manase hinaga ya ginauli doha (au italau 2 Kin 21 ganahewana yai.)","reference":{"chapter":18,"verse":21}}]},"thisChapterLink":"/api/bxh_wbt/LEV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/LEV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/LEV/17.json","previousChapterAudioLinks":{},"numberOfVerses":12}