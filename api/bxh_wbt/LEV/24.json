tent":["Laugagayo eseꞌesegana te bena sai nuꞌuna yai sa yosi yo taꞌowawa mate sa lau watan."]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/LEV/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/NUM/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/LEV/20.json","previousChapterAudioLinks":{},"numberOfVerses":4}