{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"PRO","translationId":"bxh_wbt","name":"Gaimumu","commonName":"Gaimumu","title":"Gaimumu Bukana","order":20,"numberOfChapters":14,"sha256":"a8e8f83f514d72693f343661c141175fb664d8aba5cb05a14b516ff411d7c97e","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bxh_wbt/PRO/31.json","totalNumberOfVerses":55},"chapter":{"number":31,"content":[{"type":"heading","content":["Waihin Loholohona"]},{"type":"verse","number":10,"content":[{"text":"Waihin paisowa mahudoꞌina gonowana ya ginauli","poem":1},{"text":"mate ya loholoho wananaha,","poem":2},{"lineBreak":true},{"text":"habahim gogo haisa doha posalu taumoho ya lobahi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Taumoho ni, lahuna ya sunumaꞌen","poem":1},{"text":"be ibege somo lisina yai i kuꞌu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Waihin fuya ouꞌouli, loholoho moho","poem":1},{"text":"ya leyama lahuna lisina","poem":2},{"lineBreak":true},{"text":"na hige heyaya. Mate ya loholoho.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mahina ya abidi,","poem":1},{"text":"be ya fapaisowadi kaleko ya lau bodi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nimana yai mahina ya loidi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tau gogo gesagesa yo salumadi sa kuꞌu ya sagusaguhidi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Waihin nene sedisedina, hasalana loholohona,","poem":1},{"text":"ana bela haba ya waꞌe","poem":2},{"text":"na waihin sai Guyau ya faꞌatitiyen mate sa noꞌonoꞌoꞌen.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Somo ya ginauli mate ena ainauya au felen,","poem":1},{"text":"ena paisowa debana yai,","poem":2},{"text":"haba sa liba hitihitiniꞌi duhu balabalamumu ai hafohafona.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":8}