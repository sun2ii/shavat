{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"PRO","translationId":"bxh_wbt","name":"Gaimumu","commonName":"Gaimumu","title":"Gaimumu Bukana","order":20,"numberOfChapters":14,"sha256":"a8e8f83f514d72693f343661c141175fb664d8aba5cb05a14b516ff411d7c97e","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bxh_wbt/PRO/31.json","totalNumberOfVerses":55},"chapter":{"number":6,"content":[{"type":"verse","number":20,"content":[{"text":"Natugu, tamam yo tinam ginauli mahudoꞌidi sa fatalaham","poem":1},{"text":"u lau watandi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Edi liba u sogohidi","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yena edaꞌeda yai wa laulau,","poem":1},{"text":"edi lau fagagayo haba sa fatalaham.","poem":2},{"lineBreak":true},{"text":"Em eno yai libadi te haba sa bobodiyem.","poem":2},{"lineBreak":true},{"text":"Yena wa eno obiyo haba sa libawa lisim.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Edi lau faꞌata yai, edaꞌeda sa faꞌitam","poem":1},{"text":"doha mala kamumu yai.","poem":2},{"text":"Sa liba suꞌuim yo sa fatalaham sidohana bena edaꞌeda dudulaina sa faꞌitam,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"be tabu sadaim yai tau miya, waihinina matamata heyaheyayana","poem":1},{"text":"ena liba amꞌamnadi yai i foya fagegewalim.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tabu hasalana yai nuwam i abi","poem":1},{"text":"e ena kinokinoi yai i nohoim.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":6}