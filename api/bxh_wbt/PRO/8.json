{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"PRO","translationId":"bxh_wbt","name":"Gaimumu","commonName":"Gaimumu","title":"Gaimumu Bukana","order":20,"numberOfChapters":14,"sha256":"a8e8f83f514d72693f343661c141175fb664d8aba5cb05a14b516ff411d7c97e","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bxh_wbt/PRO/31.json","totalNumberOfVerses":55},"chapter":{"number":8,"content":[{"type":"heading","content":["Sibasiba ya Yogayoga"]},{"type":"verse","number":22,"content":[{"text":"Sibasiba ya liba iyen,","poem":1},"Beyabeyana fuya fatufatubuna yai",{"text":"Yaubada ena paisowa ya fatubu ya ginauli mate,","poem":2},{"lineBreak":true},{"text":"bwaꞌibwaꞌina yau, ya ginauligu,","poem":2},{"lineBreak":true},{"text":"habahim tanoꞌubu ya ginauli.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Fuyanna hola hige gabogabo","poem":1},{"text":"yo hola hige hoꞌowa yomayoman yai ti kalamahano","poem":2},{"lineBreak":true},{"text":"na yau haꞌa E tubu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"E tubu bwaꞌi,","poem":1},{"text":"habahim tuꞌa yo uduhuli.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hola hige tanoꞌubu yo gabu","poem":1},{"text":"na yau haꞌa E tubu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Fuyana Yaubada galewa ya ginauli","poem":1},{"text":"yo gabogabo adi dandan ya lufadi,","poem":2},{"lineBreak":true},{"text":"mate yau amainiya.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Fuyana yada galewa yai ya toledi","poem":1},{"text":"yo gabotun ubuna yai yomayoman lisidi yai","poem":2},{"lineBreak":true},{"text":"hoꞌowa aliꞌalitana ya pisapisalama,","poem":2},{"text":"be gabogabo ya siu","poem":1},{"text":"mate yau amainiya.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Yau amainiya fuyana Yaubada gabogabo anadandan ya tole","poem":1},{"text":"yo ya lau fagagayo bena tabu i siu be anadan i hin diꞌoi.","poem":2},{"text":"Tanoꞌubu ena aba ota ya faꞌobiyo mate yau amainiya hinaga.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Fuyanna yau fadidina yai na paisowa sibasibana mate lebegu yai.","poem":1},{"text":"Fuya ouꞌouli nuwana E fafaꞌamna,","poem":2},{"text":"yo fuya ouꞌouli maꞌegu mate egu kwade.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Tanoꞌubu yo dodoga ya ginaulidi E itadi","poem":1},{"text":"mate E kwade wananaha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":9}