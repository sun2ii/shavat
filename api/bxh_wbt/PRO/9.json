{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"PRO","translationId":"bxh_wbt","name":"Gaimumu","commonName":"Gaimumu","title":"Gaimumu Bukana","order":20,"numberOfChapters":14,"sha256":"a8e8f83f514d72693f343661c141175fb664d8aba5cb05a14b516ff411d7c97e","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/bxh_wbt/PRO/31.json","totalNumberOfVerses":55},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"Sibasiba ena luma ya ginauli;","poem":1},{"text":"ana duhu faligigi luwaga uliꞌulidi ya tadidi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kalahe ya abi nonohai mataꞌasi laꞌilaꞌi ana yo ana wain ya faꞌasi;","poem":1},{"text":"ena fatafata hinaga ya abi nonohai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ena tau lau fayofayo wawahindi ya duidi sa lau","poem":1},{"text":"be tefa hewa wananahana taon lisina yai, dodoga sa yogaidi.","poem":2}]},{"type":"verse","number":4,"content":["Tiyen, “Faꞌeli toutou",{"text":"yo yauyaule ti laoma egu luma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Au laoma, agu kalahe au an","poem":1},{"text":"yo wain E faꞌasi ami au nom.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Faꞌeli toutou au fatautau,","poem":1},{"text":"haba ami miya.","poem":2},{"text":"Sibasiba au famuli watan.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":6}