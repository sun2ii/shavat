{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"PSA","translationId":"bxh_wbt","name":"Samsi","commonName":"Samsi","title":"Diusi edi Wana Bukana Samsi","order":19,"numberOfChapters":14,"sha256":"2c7dff911b887b60041c692a6c945575d30b614318cf1f984b7a4036aa35b9f4","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/bxh_wbt/PSA/139.json","totalNumberOfVerses":165},"chapter":{"number":1,"content":[{"type":"heading","content":["Guyau Famuli Watanina ya Fanuwa Kwadekwade"]},{"type":"verse","number":1,"content":[{"text":"Salumadi hige dodoga heyaheyayadi edi nuwanuwatuhu ti lau watanidi,","poem":1},{"text":"yo tau heyaya edi miyamiya hige ti miyamiyaꞌedi,","poem":2},{"lineBreak":true},{"text":"e Yaubada tau ꞌwaiyoꞌoꞌenna hige ti modeꞌedi mate,","poem":2},{"lineBreak":true},{"text":"nuwadi ti amna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lisina yai, Yaubada ena laugagayo awaꞌabina kwadena sa lobahi,","poem":1},{"text":"be sa fatili, na sa fadosi iꞌipa yo lahai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iti doha oyagi sa umahi hoꞌowa bubuna yai","poem":1},{"lineBreak":true},{"text":"be adi fuya yai sa fuwa, siuhwalo fuyana,","poem":1},{"text":"ibege ti hohoya edi maliyaho aniyona ya taumahata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dodoga heyaheyayadi edi laulau hige doha ite;","poem":1},{"text":"iti doha hawahawa wenuna hwayahwayau ya yofohi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tau heyaya mate Yaubada haba ya fakasadi.","poem":1},{"text":"Yaubada ena dodoga ibege maꞌedi ti miya esega.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dodoga dudulaidi mate Yaubada ya ita watanidi","poem":1},{"text":"yo ya bobodiyedi,","poem":2},{"text":"na tau heyaya mate Yaubada haba ya fakamkamnadi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}