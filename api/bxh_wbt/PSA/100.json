{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"PSA","translationId":"bxh_wbt","name":"Samsi","commonName":"Samsi","title":"Diusi edi Wana Bukana Samsi","order":19,"numberOfChapters":14,"sha256":"2c7dff911b887b60041c692a6c945575d30b614318cf1f984b7a4036aa35b9f4","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/bxh_wbt/PSA/139.json","totalNumberOfVerses":165},"chapter":{"number":100,"content":[{"type":"heading","content":["Lautoꞌi Wanana"]},{"type":"verse","number":1,"content":[{"text":"Tanoꞌubu mahudoꞌimiu ma kwademiu,","poem":1},{"text":"au halabo lau Guyau lisina.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Guyau au fadebasae ma nuwa loholohomiu.","poem":1},{"text":"Au laoma Guyau matana yai","poem":2},{"lineBreak":true},{"text":"ma kwademiu yo ma wanawanamiu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Guyau mate Yaubada!","poem":1},{"text":"In ya ginaulida bena, enehena.","poem":2},{"text":"Ita ena dodoga doha sipi baiwadi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Au luhulau edaꞌedana hafohafona yai, ma laulautoꞌimiu,","poem":1},{"text":"au luhulau Dubu Tabuna dobidobina yai ma fadebasaemiu!","poem":2},{"text":"Au lautoꞌiyen yo hesana au fadebasae.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Paꞌana Guyau ya loholoho wananaha.","poem":1},{"lineBreak":true},{"text":"Ena gadosisi otaꞌotafahina ya ota esegahi ya lau ee–, hige anadan,","poem":1},{"lineBreak":true},{"text":"yo hitina - hitina ena sunuma ya ota esegahi","poem":1},{"text":"ya lau ee–, hige anadan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":5}