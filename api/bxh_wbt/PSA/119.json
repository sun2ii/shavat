{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"PSA","translationId":"bxh_wbt","name":"Samsi","commonName":"Samsi","title":"Diusi edi Wana Bukana Samsi","order":19,"numberOfChapters":14,"sha256":"2c7dff911b887b60041c692a6c945575d30b614318cf1f984b7a4036aa35b9f4","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/bxh_wbt/PSA/139.json","totalNumberOfVerses":165},"chapter":{"number":119,"content":[{"type":"heading","content":["Guyau ena Laugagayo Awa Abiyenna"]},{"type":"hebrew_subtitle","content":["Beth"]},{"type":"verse","number":9,"content":[{"text":"Haba sidohana taumoho hewahewalina ena mwahuli ya bobodiyei?","poem":1},{"text":"Bena Em laugagayo ya awa abiyedi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nuwagu ma ofi fahina em laugagayo E awa abiyen.","poem":1},{"text":"U ita watanigu, be ibege em laugagayo ya lau afuledi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Em liba E nuwatuhui nuwagu yai,","poem":1},{"text":"be ibege heyaheyaya ya ginauli ai lisim.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Guyau ee–, E fadebasaem.","poem":1},{"text":"Em laugagayo u fatalahagu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Laugagayo mahudoꞌidi moꞌam yai wa libaedi.","poem":1},{"text":"E liba fuyoꞌidi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"E kwade fuyanna em laugagayo E laulau watandi,","poem":1},{"text":"habahim gogo wasawasadi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Em abiꞌabi yo em laulau","poem":1},{"text":"E nuwatuhu fadosidi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Em laugagayo E nuwa amnaedi, ibege nuwagu i fui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":8}