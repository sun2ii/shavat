{"translation":{"id":"bxh_wbt","name":"Buka Tabuna Tefadi","website":"https://ebible.org/Scriptures/details.php?id=bxh","licenseUrl":"https://ebible.org/Scriptures/details.php?id=bxh","licenseNotes":null,"shortName":"WBT","englishName":"Buhutu Bible","language":"bxh","textDirection":"ltr","sha256":"83ae4f7fd7fb813833bc8c1af79af7fe6067396bb35ff1f39e48186657f184e8","availableFormats":["json"],"listOfBooksApiLink":"/api/bxh_wbt/books.json","numberOfBooks":31,"totalNumberOfChapters":265,"totalNumberOfVerses":4199,"languageName":"Buhutu","languageEnglishName":"Buhutu"},"book":{"id":"PSA","translationId":"bxh_wbt","name":"Samsi","commonName":"Samsi","title":"Diusi edi Wana Bukana Samsi","order":19,"numberOfChapters":14,"sha256":"2c7dff911b887b60041c692a6c945575d30b614318cf1f984b7a4036aa35b9f4","firstChapterNumber":1,"firstChapterApiLink":"/api/bxh_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/bxh_wbt/PSA/139.json","totalNumberOfVerses":165},"chapter":{"number":23,"content":[{"type":"heading","content":["Guyau ya Itaꞌita Watanigu"]},{"type":"verse","number":1,"content":[{"text":"Ibege ya gogo gesagesa,","poem":1},{"text":"paꞌana fuya ouꞌouli,","poem":2},{"lineBreak":true},{"text":"Guyau ya itaꞌita watanigu, doha sipi tau ita wata.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"1 Ya faꞌanyawasigu hawahawa idaꞌidahedi yai","poem":1},{"text":"yo ya foya lauwegu hoꞌowa daudaumwalina yai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yaluwagu ya fafwaufwau fuyoi.","poem":1},{"text":"Hesana yai edaꞌeda dudulaina yai ya foyahigu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yena E lau hobohobo kamukamumuna yai","poem":1},{"text":"ibege heyaheyaya laꞌi ya ꞌwasabuwen,","poem":2},{"lineBreak":true},{"text":"paꞌana um maꞌegu.","poem":2},{"lineBreak":true},{"text":"Em pidipidili yo em tuꞌe sa bobodiyegu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Agu waiyunu matadi yai,","poem":1},{"text":"agu anꞌangogo wa abi nonohai.","poem":2},{"text":"Kulugu wa famaꞌi.","poem":1},{"text":"Agu kapu wa famohafu tabutabuliwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wananaha, egu miya mahudoꞌina yai,","poem":1},{"text":"wa faloholohogu yo wa gadogadosisiyegu.","poem":2},{"text":"Na yau haba Guyau ena ai luma E gogo ee–,","poem":1},{"text":"hige anadan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":6}