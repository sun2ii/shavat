":1},{"text":"Yaubada Eda Yaubada ya aiꞌainauyaida.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yaubada i ainauyaida,","poem":1},{"text":"be dodoga mahudoꞌidi tanoꞌubu yai","poem":2},{"lineBreak":true},{"text":"haba sa faꞌatitiyen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/bxh_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/bxh_wbt/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/bxh_wbt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":7}