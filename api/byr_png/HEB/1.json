{"translation":{"id":"byr_png","name":"Yipma Genesis and New Testament","website":"https://ebible.org/Scriptures/details.php?id=byr","licenseUrl":"https://ebible.org/Scriptures/details.php?id=byr","licenseNotes":null,"shortName":"PNG","englishName":"Baruya NT+Genesis","language":"byr","textDirection":"ltr","sha256":"a739085219fe30c85dfa8f067891fe8668038136f393398cb57bbad478bcb835","availableFormats":["json"],"listOfBooksApiLink":"/api/byr_png/books.json","numberOfBooks":28,"totalNumberOfChapters":310,"totalNumberOfVerses":8114,"languageName":"Baruya","languageEnglishName":"Baruya"},"book":{"id":"HEB","translationId":"byr_png","name":"Yɨvɨru","commonName":"Yɨvɨru","title":"Yɨvɨru Pɨkarɨyɨkwiaꞌ Yɨvɨruyaraavɨnesɨ.","order":58,"numberOfChapters":13,"sha256":"7867c388a759d5c1ad7dbf8c6dee4d33b89ab05bb23b62a36b63cf575aa4eb67","firstChapterNumber":1,"firstChapterApiLink":"/api/byr_png/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/byr_png/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Gamɨre Gawaalɨvaangei dakevɨ Gotɨyai nedakeꞌnesɨ."]},{"type":"verse","number":1,"content":["Kɨgaakuna kwala naangegaaꞌ Gotɨyai gamɨnyɨ wɨꞌnawɨjɨwaakyaraavɨ sɨmunya pɨnɨnna pɨrɨꞌ wɨdɨna, pɨnɨnna pɨrɨꞌ wɨdɨna. Yɨ sara kujaaꞌ sahwara nemɨre Ne sɨnnawɨnyaraavɨ sɨmunya nabinabinya pɨbura wɨjaasara kwalaalyare."]},{"type":"verse","number":2,"content":["Kɨrɨꞌ nabaai dahaaꞌ aayagasa Gotɨyai yagaala nedakeꞌ gamɨre Gawaalɨvaangei nedakesɨ. Sahwarɨ Ganɨmaangere yuya maaryaꞌnerɨ Gotɨyai mena dahɨlakakelyɨ. Nabaai Gawaalɨvaanga sahwarɨ Kwaaka dasɨ sɨgunya kɨrɨsɨ Gotɨyai yavɨkaryaakengɨ."]},{"type":"verse","number":3,"content":["Gawaalɨvaangei sahwai Gotɨyare byaanna dɨragɨnyaꞌ lɨvamwaja naangelyɨ. Yɨ nemɨnyɨ Baaka naanga nemwadadelyɨ. Sahwai Gotɨyarɨ avaaina nebulyaꞌnanyalyɨ. Gamɨre yagaala dɨragɨnya kɨnɨnnakeꞌ dada yuyangɨ dɨragɨnya yɨvaimwada yuya sarengɨ lɨmwagaꞌdelyɨ. Kayaaꞌnanyangɨne tɨvɨkɨsa duimwagasɨta yaꞌneꞌ sahwai wawɨnya yunebanna yɨꞌmwannaka Kingɨya Naangei munya keꞌbeva mwaalɨkere aangasɨmagɨ dɨragɨnnakeba mwaalaꞌ."]},{"type":"heading","content":["Gotɨyare Gawaalɨvaangei ejelɨyara mamaayaraavɨ wavɨlavɨkerɨnesɨ."]},{"type":"verse","number":4,"content":["Gawaalɨvaangei Ganɨmaangerɨ yaya tewaanya nawɨꞌnyaangeꞌ mena maarakeꞌ yɨ mamaayaraavɨre yayavɨ wavɨlavakabaaibɨꞌ yɨ sasare sahɨrɨvɨ gamɨ sai mamaayaraavɨna naanga nebulyaꞌna yɨmaꞌnakelyɨ. Yɨ sahwara sarɨ kwaakewɨ wɨlaꞌnakasalyɨ."]},{"type":"verse","number":5,"content":["Sareꞌ darevɨnyɨ. Sɨnnawɨ sagaaꞌ Gotɨyai mamaayarajɨya aane pwai kwarɨ dara mujaꞌ",{"text":"“Gɨmɨ nɨmɨnyɨ nyɨbwaalɨvaangeigɨnyɨra.","poem":1},{"lineBreak":true},{"text":"Dahaaꞌ gɨmaamaangeinyɨ gɨmwaaihɨweigɨnyɨ.”","poem":1},"Kɨrɨꞌ Gawaalɨvaangerɨ sara wɨdaꞌ. Yɨ sahwai mamaayarɨna ayahi mujaꞌ",{"text":"“Gamɨnyɨ ganɨmaangeinyɨ yɨmaꞌnɨdeinyɨ.","poem":1},{"lineBreak":true},{"text":"Nɨmɨnyɨ nyɨbwaalɨvaangei yɨmaꞌnadelyɨ.”","poem":1}]},{"type":"verse","number":6,"content":["Kɨrɨꞌ Kwaakevakɨ mwaalyaraayawɨnna sahwai gamɨre aaya mudɨkaimɨraayarɨ makwalaabakegaaꞌ sarei daꞌ “Mamaaya yuya Gotɨyainyɨrera sahwarɨ yɨlaaya nayaa maripɨka!”"]},{"type":"verse","number":7,"content":["Nabaai sahwai mamaayaraavɨna dara wɨdaꞌ",{"text":"“Gamɨre mamaayaraavɨ yɨhusaꞌbɨsaraavɨ wɨmwaaihadere.","poem":1},{"lineBreak":true},{"text":"Gamɨre wɨdaayadɨvɨsaraavɨ dɨtaalɨsaꞌbɨsaraavɨ wɨmwaaihadere.”","poem":1}]},{"type":"verse","number":8,"content":["Kɨrɨꞌ Gawaalɨvaangerɨna dara wɨdaꞌ",{"text":"“Gotɨyaigɨ, yuyagaaꞌ yuyagaaꞌne kingɨnamwaalyɨsavɨ dɨmaremwaaideigɨnyɨ.","poem":1},{"lineBreak":true},{"text":"Gɨmɨre aꞌmweraavɨ kingɨyɨsarɨsɨ yɨdaꞌnanyabwina yawɨbwaramaremwaaidɨnyaigɨnyɨ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gɨmɨnyɨ yɨdaꞌmaraanga sabwina tewaanya gɨvuꞌnadeigɨnyɨ.","poem":1},{"lineBreak":true},{"text":"Kɨwɨnyangɨ galazekɨvalyabwina sɨmɨlɨka gwimwaalɨkeigɨnyɨ.","poem":1},{"lineBreak":true},{"text":"Mɨdɨnagɨnyavɨdaaꞌnyɨ Gotɨyainyɨ gɨmɨre Gotɨyainyɨ yɨlewelivananyaꞌ gɨthɨngeigɨnyɨ.","poem":1},{"lineBreak":true},{"text":"Yɨ welivananya dazaꞌ gɨmɨnyɨ yɨlaaya gihalakeigɨnyɨ.","poem":1},{"lineBreak":true},{"text":"Jaꞌmwera yɨvanɨgɨnyabaaibɨꞌ yɨlaaya yɨvanɨgatara mɨꞌ.”","poem":1}]},{"type":"verse","number":10,"content":["Nabaai Gawaalɨvaangerɨna dara wɨdaꞌ",{"text":"“Naangeigɨ sɨnnawɨ Kwaaka dathaꞌ wakyeigɨnyɨ.","poem":1},{"lineBreak":true},{"text":"Nabaai sɨgunyaꞌ gɨnnya asɨraalyɨ yavɨkaryeigɨnyɨ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yuyawaai yɨnahu kayaaka yɨnyɨna yadewaalyɨ.","poem":1},{"lineBreak":true},{"text":"Kɨrɨꞌ gɨmɨ aawa. Yuyagaaꞌ mwaaidɨnyaigɨnyɨ.","poem":1},{"lineBreak":true},{"text":"Yuyawaalyɨ yuya pɨnɨjɨ aya yɨmaꞌnadengɨ.","poem":1},{"lineBreak":true},{"text":"Baazɨꞌmaꞌnya pɨrɨꞌ aya yɨmaꞌnadevaaibɨsangɨ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yɨ yɨvɨta ayaꞌ gɨꞌmwagakɨna yadevaaibɨꞌ","poem":1},{"lineBreak":true},{"text":"Gɨmɨ yuya sangɨ dɨhɨꞌmwagakɨdeigɨnyɨ.","poem":1},{"lineBreak":true},{"text":"Aꞌmwei baazɨꞌmaꞌnya yadaihamaaꞌna yadevaaibɨꞌ","poem":1},{"lineBreak":true},{"text":"Gɨmɨ yuya sangɨ yadaihamaata jɨthengɨ.","poem":1},{"lineBreak":true},{"text":"Kɨrɨꞌ gɨmɨ yuna sana dɨmwaaideigɨnyɨ.","poem":1},{"lineBreak":true},{"text":"Gɨmɨre kwaramegasa miꞌna yɨwawade mɨꞌ.”","poem":1}]},{"type":"verse","number":13,"content":["Pɨgaaꞌ kɨgaaꞌ Gotɨyai mamaaya darajɨya bewarɨ wɨdakelaka! Aawa. Gawaalɨvaangerɨna dara dɨnɨꞌ",{"text":"“Gɨmɨ nɨmɨre aangasɨrɨ dɨragɨnyaba dɨmwaala!","poem":1},{"lineBreak":true},{"text":"Gɨmɨnyɨ dalaangewɨ wɨlaꞌnaryaꞌnegaaꞌna yɨkamaangeraavɨ gwakɨdehaaꞌnanyɨ.”","poem":1}]},{"type":"verse","number":14,"content":["Aawa. Mamaayara yɨ sahwara kuryarera. Yɨ kurya sahwara Gotɨyarɨ wɨdaayadɨvɨsare. Gotɨyai aꞌmwera gamɨre yuna padaihasamaaryaꞌneraavɨna gaimwagyaꞌne mamaayaraavɨ maryaasadere."]}],"footnotes":[]},"thisChapterLink":"/api/byr_png/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/byr_png/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/byr_png/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}