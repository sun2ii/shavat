{"translation":{"id":"byr_wag","name":"Selected Scriptures in Yipma/Wagamwa","website":"https://ebible.org/Scriptures/details.php?id=byr-w","licenseUrl":"https://ebible.org/Scriptures/details.php?id=byr-w","licenseNotes":null,"shortName":"WAG","englishName":"Yipma Wagamwa NT","language":"byr","textDirection":"ltr","sha256":"c19bfd4cdb1149d85d3b9f5308a6b8792b3db96c17f9719285ebb8abcf28d269","availableFormats":["json"],"listOfBooksApiLink":"/api/byr_wag/books.json","numberOfBooks":4,"totalNumberOfChapters":11,"totalNumberOfVerses":136,"languageName":"Baruya","languageEnglishName":"Baruya"},"book":{"id":"1JN","translationId":"byr_wag","name":"1 Sonɨ","commonName":"1 Sonɨ","title":"Pɨgarɨguri Mudɨ'naya' Yɨdabagasɨ.","order":62,"numberOfChapters":4,"sha256":"e77c362f42ecb8da7925ed92babe2ee214cd22ce1912d480995cce59cf75fb3f","firstChapterNumber":1,"firstChapterApiLink":"/api/byr_wag/1JN/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/byr_wag/1JN/5.json","totalNumberOfVerses":23},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Nɨmɨre kwaimɨraabya wabelabi, yagaala taja' pɨgarɨguri yɨnggidawasɨbaiga. Semɨ kayaa'naya myɨpɨne'na “Wɨdɨbwaagɨma!” tena yɨnggidawasɨbaiga. Sare' kɨrɨ' a'mwe pwai kwai kayaa'naya' yaja' nemɨnyɨne kayaa'nayanna Nɨmwarɨ marewɨdandei mwaarɨ'. Sagwai Jisaasi Kɨraajɨtɨyai yɨnda'maraangalyɨ."]},{"type":"verse","number":2,"content":["Sarei nemɨre kayaa'nayanna Godɨyarɨ sɨnya sɨmɨrɨga widebwi mubamaarasɨ'nyɨ'nei paragalyɨ. Nemɨrenna yɨmbenna mɨ'. Aawa. Kwaaga wɨya tabagɨyara anjɨmyaraabɨne kayaa'nayannanyɨra."]}],"footnotes":[]},"thisChapterLink":"/api/byr_wag/1JN/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/byr_wag/1JN/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/byr_wag/1JN/1.json","previousChapterAudioLinks":{},"numberOfVerses":2}