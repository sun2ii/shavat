{"translation":{"id":"byr_wag","name":"Selected Scriptures in Yipma/Wagamwa","website":"https://ebible.org/Scriptures/details.php?id=byr-w","licenseUrl":"https://ebible.org/Scriptures/details.php?id=byr-w","licenseNotes":null,"shortName":"WAG","englishName":"Yipma Wagamwa NT","language":"byr","textDirection":"ltr","sha256":"c19bfd4cdb1149d85d3b9f5308a6b8792b3db96c17f9719285ebb8abcf28d269","availableFormats":["json"],"listOfBooksApiLink":"/api/byr_wag/books.json","numberOfBooks":4,"totalNumberOfChapters":11,"totalNumberOfVerses":136,"languageName":"Baruya","languageEnglishName":"Baruya"},"book":{"id":"HEB","translationId":"byr_wag","name":"Yɨbɨru","commonName":"Yɨbɨru","title":"Pɨgarɨgurya' Yɨbɨruyaraabɨnesɨ","order":58,"numberOfChapters":1,"sha256":"c4fe464d04f8788a4efb1325b0646e55554851224426ebb4867cc482f50a3445","firstChapterNumber":1,"firstChapterApiLink":"/api/byr_wag/HEB/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/byr_wag/HEB/1.json","totalNumberOfVerses":14},"chapter":{"number":1,"content":[{"type":"heading","content":["Kamɨre Kabwaalɨbaangei tagebɨ Godɨyai nedage'nesɨ."]},{"type":"verse","number":1,"content":["Kɨgaakuna kwala naangegaa' Godɨyai kamɨnyɨ wɨ'nawɨdɨbwaagyaraabɨ sɨmunya pɨnɨnna pɨrɨ' wɨdɨna, pɨnɨnna pɨrɨ' wɨdɨna. Yɨ sara kujaa' sagwara nemɨre Ne sɨnyamwɨnyaraabɨ sɨmunya nabinabinya pɨbura wɨjaasara kwaraaryare."]},{"type":"verse","number":2,"content":["Kɨrɨ' nabaai tagaa' aayagasa Godɨyai yagaala nedage' kamɨre Kabwaalɨbaangei nedagesɨ. Sagwarɨ Kanɨmaangele wɨya maaryɨ'nerɨ Godɨyai mena tagɨlakagelyɨ. Nabaai Kabwaalɨbaanga sagwarɨ Kwaaga tasɨ sugunya kɨrɨsɨ Godɨyai yabɨgaryaagengɨ."]},{"type":"verse","number":3,"content":["Kabwaalɨbaangei sagwai Godɨyale paaga tɨragɨnyabɨ lɨbamwaja naangelyɨ. Yɨ nemɨnyɨ Paaga naanga nemwadandelyɨ. Sagwai Godɨyarɨ abaaina nebulya'nayalyɨ. Kamɨre yagaala tɨragɨnya kɨnɨnnɨge' tanda wɨyangɨ tɨragɨnya yɨbaimwanda wɨya sarengɨ lɨmwagatelyɨ. Kayaa'nayangɨne tɨbɨkɨsa tuimwagasɨta yɨ'ne' sagwai wamwɨnya yunebanna yɨ'mwannaga Kingɨya Naangei munya kepeba mwaarɨgele aangajimagɨ tɨragɨnnɨgeba mwaara'."]},{"type":"heading","content":["Godɨyale Kabwaalɨbaangei enjelɨyara mamaayaraabɨ wabɨlabɨgerɨnesɨ."]},{"type":"verse","number":4,"content":["Kabwaalɨbaangei Kanɨmaangerɨ yebya tewaanya nawɨ'nyaange' mena maarage' yɨ mamaayaraabɨre yebyabɨ wabɨlabagabaaimbɨ' yɨ sasare sagɨrɨbɨ kamɨ sai mamaayaraabɨna naanga nebulya'na yɨma'nagelyɨ. Yɨ sagwara sarɨ kwaagemwɨ wɨra'nagasalyɨ."]},{"type":"verse","number":5,"content":["Sare' tarebɨnyɨ. Sɨnyamwɨ sagaa' Godɨyai mamaayarajɨya aane pwai kwarɨ tara mwɨja'",{"text":"“Kɨmɨ nɨmɨnyɨ nyɨmbwaalɨbaangeiginyɨra.","poem":1},{"lineBreak":true},{"text":"Tagaa' kɨmaamaangeinyɨ kɨmwaaigɨmweiginyɨ.”","poem":1},"Kɨrɨ' Kabwaalɨbaangerɨ sara wɨda'. Yɨ sagwai mamaayarɨna ayagi mwɨja'",{"text":"“Kamɨnyɨ kanɨmaangeinyɨ yɨma'nɨmɨdeinyɨ.","poem":1},{"lineBreak":true},{"text":"Nɨmɨnyɨ nyɨmbwaalɨbaangei yɨma'nadelyɨ.”","poem":1}]},{"type":"verse","number":6,"content":["Kɨrɨ' Kwaagebagɨ mwaaryaraabyɨmwɨnna sagwai kamɨre aaya mudɨgwaimɨraabyarɨ makwaraabagegaa' sarei ta' “Mamaaya wɨya Godɨyainyɨrera sagwarɨ yɨraaya nabyaa maripɨga!”"]},{"type":"verse","number":7,"content":["Nabaai sagwai mamaayaraabɨna tara ta'",{"text":"“Kamɨre mamaayaraabɨ yɨgwɨjapɨsaraabɨ wɨmwaaigandere.","poem":1},{"lineBreak":true},{"text":"Kamɨre wɨdaayandɨbɨsaraabɨ tɨtaarɨsapɨsaraabɨ wɨmwaaigandere.","poem":1}]},{"type":"verse","number":8,"content":["Kɨrɨ' Kabwaalɨbaangerɨna tara ta'",{"text":"“Godɨyaigi, wɨyagaa' wɨyagaa'ne kingɨnamwaaryɨsabɨ tɨmaremwaaideiginyɨ.","poem":1},{"lineBreak":true},{"text":"Kɨmɨre a'mweraabɨ kingɨyɨsarɨsɨ yɨda'nanyabwina yawɨbwaramaremwaaindɨnyaiginyɨ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kɨmɨnyɨ yɨda'maraanga sabwina tewaanya kɨbu'nandeiginyɨ.","poem":1},{"lineBreak":true},{"text":"Kɨmwɨnyangɨ kalajegɨbaryabwina sɨmɨlɨga kwimwaarɨgeiginyɨ.","poem":1},{"lineBreak":true},{"text":"Mɨdɨnɨnyabɨdaa'nyɨ Godɨyainyɨ kɨmɨre Godɨyainyɨ yɨrewelɨya' kɨdɨngeiginyɨ.","poem":1},{"lineBreak":true},{"text":"Yɨ welɨya taja' kɨmɨnyɨ yɨraaya kyɨgalageiginyɨ.","poem":1},{"lineBreak":true},{"text":"Sa'mwera yɨbaigɨnyabaaimbɨ' yɨraaya yɨbaigatara mɨ'.”","poem":1}]},{"type":"verse","number":10,"content":["Nabaai Kabwaalɨbaangerɨna tara ta'",{"text":"“Naangeigi sɨnyamwɨ Kwaaga tada' wagyaanyaiginyɨ.","poem":1},{"lineBreak":true},{"text":"Nabaai sugunya' kɨmnya ajɨraalyɨ yabɨgaryaanyaiginyɨ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wɨyabaai yɨnagu kayaaga yɨnyɨna yadebaalyɨ.","poem":1},{"lineBreak":true},{"text":"Kɨrɨ' kɨmɨ aawa. Wɨyagaa' mwaaindɨnyaiginyɨ.","poem":1},{"lineBreak":true},{"text":"Wɨyabaalyɨ wɨya pɨnɨjɨ aya yɨma'nadengɨ.","poem":1},{"lineBreak":true},{"text":"Paajɨ'ma'nya pɨrɨ' aya yɨma'nyɨna yadebaaimbɨsangɨ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yɨ yɨbɨja aya' kɨ'mwagakɨna yadebaaimbɨ'","poem":1},{"lineBreak":true},{"text":"Kɨmɨ wɨya sangɨ tɨgɨ'mwagakɨdeiginyɨ.","poem":1},{"lineBreak":true},{"text":"A'mwei paajɨ'ma'nya yadaigamaa'na yandebaaimbɨ'","poem":1},{"lineBreak":true},{"text":"Kɨmɨ wɨya sangɨ yadaigamaata sɨdengɨ.","poem":1},{"lineBreak":true},{"text":"Kɨrɨ' kɨmɨ yuna sana tɨmwaaindeiginyɨ.","poem":1},{"lineBreak":true},{"text":"Kɨmɨre kwaramegaa' wi'na yɨwawade mɨ'.”","poem":1}]},{"type":"verse","number":13,"content":["Pɨgaa' kɨgaa' Godɨyai mamaaya tarajɨya pewarɨ wɨdagelaga!. Aawa. Kabwaalɨbaangerɨna tara tɨnɨ'",{"text":"“Kɨmɨ nɨmɨre aangasɨrɨ tɨragɨnyaba tɨmwaara!","poem":1},{"lineBreak":true},{"text":"Kɨmɨnyɨ talaangemwɨ wɨra'narya'negaa'na yɨgamaangeraabɨ kwagɨmɨdegaa'nayɨ.”","poem":1}]},{"type":"verse","number":14,"content":["Aawa. Mamaayara yɨ sagwara kuryarera. Yɨ kurya sagwara Godɨyarɨ wɨdaayandɨbɨsare. Godɨyai a'mwera kamɨre yuna padaigasamaaryɨ'neraabɨna kaimwagya'ne mamaayaraabɨ maryaasandere."]}],"footnotes":[]},"thisChapterLink":"/api/byr_wag/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/byr_wag/1JN/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/byr_wag/ROM/8.json","previousChapterAudioLinks":{},"numberOfVerses":14}