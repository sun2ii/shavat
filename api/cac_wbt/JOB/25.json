{"translation":{"id":"cac_wbt","name":"A Ch'an Biblia D'a Chuj San Mateo","website":"https://ebible.org/Scriptures/details.php?id=cac","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cac","licenseNotes":null,"shortName":"WBT","englishName":"Chuj San Mateo Bible","language":"cac","textDirection":"ltr","sha256":"4beb059c9ea843d84cee211d5a4c8ae7c5277889ccc228261e970ce12a773c72","availableFormats":["json"],"listOfBooksApiLink":"/api/cac_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29990,"languageName":"Chuj","languageEnglishName":"Chuj"},"book":{"id":"JOB","translationId":"cac_wbt","name":"JOB","commonName":"JOB","title":"A Ch'an̈ Libro JOB","order":18,"numberOfChapters":42,"sha256":"0d7115048a86bce9a446434da38643ca353df53946866f16679492b31e21e8ca","firstChapterNumber":1,"firstChapterApiLink":"/api/cac_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cac_wbt/JOB/42.json","totalNumberOfVerses":1062},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"Ix yalanxi vin̈aj Bildad aj Súa icha tic:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A Dios ay spoder, xivub'tac, a tz'ac'anoch junc'olal d'a scal eb' ay d'a satchaan̈.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Man̈xo b'ischajb'enoc jantac q'uen c'anal b'ob'il yuuj, ¿tom ay junoc mach b'aj max c'och saquilq'uinal yuuj?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Tocval ay junoc anima malaj smul d'a yichan̈ Dios? ¿Tocval ay junoc mach te vach'?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A q'uen uj malaj yoc q'uen d'a yichan̈. Axo q'uen c'anal man̈ vach'oc q'uen d'a yol sat.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ocxo val on̈ anima on̈ tic, lajan on̈ icha noc' a'ay, xchi vin̈aj Bildad chi'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cac_wbt/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cac_wbt/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cac_wbt/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}