{"translation":{"id":"cac_wbt","name":"A Ch'an Biblia D'a Chuj San Mateo","website":"https://ebible.org/Scriptures/details.php?id=cac","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cac","licenseNotes":null,"shortName":"WBT","englishName":"Chuj San Mateo Bible","language":"cac","textDirection":"ltr","sha256":"4beb059c9ea843d84cee211d5a4c8ae7c5277889ccc228261e970ce12a773c72","availableFormats":["json"],"listOfBooksApiLink":"/api/cac_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29990,"languageName":"Chuj","languageEnglishName":"Chuj"},"book":{"id":"PSA","translationId":"cac_wbt","name":"SALMOS","commonName":"SALMOS","title":"A Ch'an̈ Libro SALMOS","order":19,"numberOfChapters":150,"sha256":"ef2bc423931153c85608c362d9dbfab7d5c35efd40f80548075c42a39b37fd70","firstChapterNumber":1,"firstChapterApiLink":"/api/cac_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cac_wbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":100,"content":[{"type":"heading","content":["Sb'ital ac'oj yuj diosal"]},{"type":"verse","number":1,"content":[{"text":"Co masanil cajan on̈ d'a yolyib'an̈q'uinal tic, con̈ b'itanec d'a Jehová d'a tzalajc'olal.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Caq'uequem co b'a d'ay d'a tzalajc'olal. Cotan̈ec d'a yichan̈ yed' av yic tzalajc'olal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cham val cojtacaneli to a Jehová Dios toni. A' ix on̈ b'oani, yuj chi' yicon̈. A on̈ schon̈ab' on̈ tic, icha val scalnel caji.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Con̈ ochec d'a puerta yic tzon̈ och d'a yol yamaq'uil scajnub' yic scalec vach' lolonel d'ay. Caq'uec yuj diosal d'ay, scalanec vach' lolonel d'ay.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yujto a Jehová vach' toni. A svach'c'olal ayn̈ejec' d'a juneln̈ej, malaj b'aj max yaq'uelc'och tas syala'.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cac_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cac_wbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cac_wbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}