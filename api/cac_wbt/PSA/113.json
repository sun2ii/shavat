{"translation":{"id":"cac_wbt","name":"A Ch'an Biblia D'a Chuj San Mateo","website":"https://ebible.org/Scriptures/details.php?id=cac","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cac","licenseNotes":null,"shortName":"WBT","englishName":"Chuj San Mateo Bible","language":"cac","textDirection":"ltr","sha256":"4beb059c9ea843d84cee211d5a4c8ae7c5277889ccc228261e970ce12a773c72","availableFormats":["json"],"listOfBooksApiLink":"/api/cac_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29990,"languageName":"Chuj","languageEnglishName":"Chuj"},"book":{"id":"PSA","translationId":"cac_wbt","name":"SALMOS","commonName":"SALMOS","title":"A Ch'an̈ Libro SALMOS","order":19,"numberOfChapters":150,"sha256":"ef2bc423931153c85608c362d9dbfab7d5c35efd40f80548075c42a39b37fd70","firstChapterNumber":1,"firstChapterApiLink":"/api/cac_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cac_wbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":113,"content":[{"type":"heading","content":["Calec vach' lolonel d'a Jehová‘R’yuj svach'c'olal"]},{"type":"verse","number":1,"content":[{"text":"Calec vach' lolonel d'a Jehová.","poem":1},{"lineBreak":true},{"text":"A on̈ schecab' on̈ Jehová, calec vach' lolonel d'ay.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Aljocab' vach' lolonel d'ay ticnaic yed' d'a masanil q'uinal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"B'itajocab' b'aj sjavi c'u masanto b'aj tz'em c'u.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A Jehová Yajal yaj d'a yib'an̈ juntzan̈ nivac chon̈ab'. A stziquiquial tz'ec'b'at d'a schaan̈il satchaan̈.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Malaj mach lajan yed' Jehová co Diosal. Ato d'a yib'an̈toq'ue satchaan̈ syac'cot Yajalil d'a yib'an̈ smasanil.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tz'emta q'uelan d'a yib'an̈ satchaan̈ yed' d'a sat luum tic.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A tz'ic'anelta eb' meb'a' d'a yalan̈ smeb'ail, scolvaj pax d'a eb' malaj jab'oc tas d'ay,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"yic vach' tz'em c'ojan eb' d'a scal eb' yetanimail ay yelc'och d'a yol schon̈ab' chi'.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A Jehová tz'ac'an unevi ix ix max unevitaxonlaj. Tz'och ix nunab'ilal, tzalajc'olal tz'ajec' ix d'a spat yed' yune' chi'.","poem":1},{"lineBreak":true},{"text":"Calec vach' lolonel d'a Jehová.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cac_wbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cac_wbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cac_wbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}