{"translation":{"id":"cac_wbt","name":"A Ch'an Biblia D'a Chuj San Mateo","website":"https://ebible.org/Scriptures/details.php?id=cac","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cac","licenseNotes":null,"shortName":"WBT","englishName":"Chuj San Mateo Bible","language":"cac","textDirection":"ltr","sha256":"4beb059c9ea843d84cee211d5a4c8ae7c5277889ccc228261e970ce12a773c72","availableFormats":["json"],"listOfBooksApiLink":"/api/cac_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29990,"languageName":"Chuj","languageEnglishName":"Chuj"},"book":{"id":"PSA","translationId":"cac_wbt","name":"SALMOS","commonName":"SALMOS","title":"A Ch'an̈ Libro SALMOS","order":19,"numberOfChapters":150,"sha256":"ef2bc423931153c85608c362d9dbfab7d5c35efd40f80548075c42a39b37fd70","firstChapterNumber":1,"firstChapterApiLink":"/api/cac_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cac_wbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":121,"content":[{"type":"heading","content":["A Jehová in tan̈vumal"]},{"type":"hebrew_subtitle","content":["Sb'it eb' israel ayic van sq'ue eb' d'a sb'eal Jerusalén."]},{"type":"verse","number":1,"content":[{"text":"Ayic svilanb'at lum jolomtac vitz, svalan d'a yol vico': ¿B'ajtil ol cot in colnab'il? xin chi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A d'a Jehová scot in colnab'il, aton b'oannac satchaan̈ yed' sat luum tic.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A Jehová co Diosal, man̈ ol ach schalaj telvoc. Malaj b'aj ol och numnaj svayan̈ ach stan̈vani.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A co tan̈vumal a on̈ israel on̈ tic, max vaylaj, malaj b'aq'uin̈ svayi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A Jehová tzach tan̈vani, a ayec' d'a a tz'ey yic tz'och en̈uloc.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Man̈ ol ach tz'alaj yuj yoc c'u d'a c'ualil, man̈ ol ach yixtejpaxlaj yoc q'uen uj d'ac'valil.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A Jehová ol ach colanel d'a masanil tastac ay smay. A' ol ach colanel d'a yol sc'ab' chamel.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A' ol ach tan̈vanoc ayic tzach b'ati yed' pax ayic tzach jaxi, ticnaic yed' d'a masanil tiempo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cac_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cac_wbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cac_wbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}