{"translation":{"id":"cac_wbt","name":"A Ch'an Biblia D'a Chuj San Mateo","website":"https://ebible.org/Scriptures/details.php?id=cac","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cac","licenseNotes":null,"shortName":"WBT","englishName":"Chuj San Mateo Bible","language":"cac","textDirection":"ltr","sha256":"4beb059c9ea843d84cee211d5a4c8ae7c5277889ccc228261e970ce12a773c72","availableFormats":["json"],"listOfBooksApiLink":"/api/cac_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29990,"languageName":"Chuj","languageEnglishName":"Chuj"},"book":{"id":"PSA","translationId":"cac_wbt","name":"SALMOS","commonName":"SALMOS","title":"A Ch'an̈ Libro SALMOS","order":19,"numberOfChapters":150,"sha256":"ef2bc423931153c85608c362d9dbfab7d5c35efd40f80548075c42a39b37fd70","firstChapterNumber":1,"firstChapterApiLink":"/api/cac_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cac_wbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":123,"content":[{"type":"heading","content":["Lesal yic c'anoj vach'c'olal d'a Dios"]},{"type":"hebrew_subtitle","content":["Sb'it eb' israel ayic van sq'ue eb' d'a sb'eal Jerusalén."]},{"type":"verse","number":1,"content":[{"text":"Mamin Jehová, Yajal ach d'a satchaan̈, tzin q'ue q'uelan d'ayach ayic ay tas snib'ej in c'ool.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mamin, a d'ayach tzon̈ och q'uelan, icha val yoch q'uelan vin̈ checab' d'a spatrón, ma icha val yoch q'uelan ix criada d'a ix spatrona. Ach co Diosal, van co maclan yoc' a c'ool d'ayon̈.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mamin Jehová, oc'oc val a c'ool d'ayon̈. Oc'ocab' a c'ool d'ayon̈, yujto maxtzac techajlaj cuuj b'aj tzon̈ paticajcaneli.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tzon̈ tzactzaj yuj sb'uchval eb' b'eyum yed' b'aj tzon̈ spatiquejel eb' ac'umtac syutej sb'a.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cac_wbt/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cac_wbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cac_wbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}