{"translation":{"id":"cac_wbt","name":"A Ch'an Biblia D'a Chuj San Mateo","website":"https://ebible.org/Scriptures/details.php?id=cac","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cac","licenseNotes":null,"shortName":"WBT","englishName":"Chuj San Mateo Bible","language":"cac","textDirection":"ltr","sha256":"4beb059c9ea843d84cee211d5a4c8ae7c5277889ccc228261e970ce12a773c72","availableFormats":["json"],"listOfBooksApiLink":"/api/cac_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29990,"languageName":"Chuj","languageEnglishName":"Chuj"},"book":{"id":"PSA","translationId":"cac_wbt","name":"SALMOS","commonName":"SALMOS","title":"A Ch'an̈ Libro SALMOS","order":19,"numberOfChapters":150,"sha256":"ef2bc423931153c85608c362d9dbfab7d5c35efd40f80548075c42a39b37fd70","firstChapterNumber":1,"firstChapterApiLink":"/api/cac_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cac_wbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":13,"content":[{"type":"heading","content":["Sc'anchaj colval"]},{"type":"hebrew_subtitle","content":["Sb'it jun tic vin̈aj David."]},{"type":"verse","number":1,"content":[{"text":"Mamin Jehová, ¿b'aq'uin̈ val ol in a nacoti? ¿Tocval ol in b'atcan satc'olal uuj d'a masanil tiempo? ¿B'aq'uin̈ val ol a ch'ox a vach'c'olal d'ayin?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Jantacto tiempo ol in te cus d'a junjun c'u? ¿Jantacto tiempo ay in ec' d'a yol sc'ab' eb' ajc'ool?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mamin Jehová in Diosal, cotan̈ q'uelan d'ayin, tac'van̈ d'ayin, ac' a vach'c'olal d'ayin, yic vach' man̈ ol in pet chamoc,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"yic man̈ ol yal vin̈ ayoch ajc'olal d'ayin: Toxo ix vac' ganar, xchi talaj vin̈. Malaj in gana stzalaj sc'ool vin̈, tato tzin yac' ganar vin̈.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A a vach'c'olal ayoch yipoc in c'ool, stzalajb'i in c'ool yuj a colval.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mamin Jehová, tzach in b'itej yuj a vach'il d'ayin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cac_wbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cac_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cac_wbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}