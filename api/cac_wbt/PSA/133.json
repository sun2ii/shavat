{"translation":{"id":"cac_wbt","name":"A Ch'an Biblia D'a Chuj San Mateo","website":"https://ebible.org/Scriptures/details.php?id=cac","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cac","licenseNotes":null,"shortName":"WBT","englishName":"Chuj San Mateo Bible","language":"cac","textDirection":"ltr","sha256":"4beb059c9ea843d84cee211d5a4c8ae7c5277889ccc228261e970ce12a773c72","availableFormats":["json"],"listOfBooksApiLink":"/api/cac_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29990,"languageName":"Chuj","languageEnglishName":"Chuj"},"book":{"id":"PSA","translationId":"cac_wbt","name":"SALMOS","commonName":"SALMOS","title":"A Ch'an̈ Libro SALMOS","order":19,"numberOfChapters":150,"sha256":"ef2bc423931153c85608c362d9dbfab7d5c35efd40f80548075c42a39b37fd70","firstChapterNumber":1,"firstChapterApiLink":"/api/cac_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cac_wbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":133,"content":[{"type":"heading","content":["Te vach' tato junn̈ej tz'aj co pensar"]},{"type":"hebrew_subtitle","content":["Sb'it vin̈aj David. Sb'it eb' israel ayic van sq'ue eb' d'a sb'eal Jerusalén."]},{"type":"verse","number":1,"content":[{"text":"Naecnab'i, man̈ jantacoc svach'il schaan sb'a yaj eb' sc'ab' yoc sb'a ayic junn̈ej tz'aj spensar eb'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lajan yed' jun perfume man̈ jantacoc svach'il scot jililoc d'a sjolom vin̈aj sacerdote Aarón, tz'emul d'a xil sti' vin̈, tz'emc'och d'a spayual sjaj spichul vin̈.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lajan val icha yal ac'val tz'em d'a sjolom lum vitzal Hermón, tz'empax d'a lum tzalan Sion. A b'aj ay junc'olal chi', syac'b'at svach'c'olal Jehová, aton q'uinal d'a juneln̈ej.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cac_wbt/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cac_wbt/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cac_wbt/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}