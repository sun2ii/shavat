{"translation":{"id":"cac_wbt","name":"A Ch'an Biblia D'a Chuj San Mateo","website":"https://ebible.org/Scriptures/details.php?id=cac","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cac","licenseNotes":null,"shortName":"WBT","englishName":"Chuj San Mateo Bible","language":"cac","textDirection":"ltr","sha256":"4beb059c9ea843d84cee211d5a4c8ae7c5277889ccc228261e970ce12a773c72","availableFormats":["json"],"listOfBooksApiLink":"/api/cac_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29990,"languageName":"Chuj","languageEnglishName":"Chuj"},"book":{"id":"PSA","translationId":"cac_wbt","name":"SALMOS","commonName":"SALMOS","title":"A Ch'an̈ Libro SALMOS","order":19,"numberOfChapters":150,"sha256":"ef2bc423931153c85608c362d9dbfab7d5c35efd40f80548075c42a39b37fd70","firstChapterNumber":1,"firstChapterApiLink":"/api/cac_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cac_wbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":150,"content":[{"type":"heading","content":["Aljocab' vach' lolonel d'a Jehová"]},{"type":"verse","number":1,"content":[{"text":"Aljocab' vach' lolonel d'a Jehová.","poem":1},{"lineBreak":true},{"text":"B'itanan̈ec d'a Dios d'a scajnub'. B'itanan̈ec d'ay yujto te nivan sb'inajnaquil d'a satchaan̈.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"B'itanan̈ec d'a Dios yuj tas satub'tac sb'o'o. B'itanan̈ec d'ay yuj sb'inajnaquil, malaj junoc mach lajan yed'oc.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"B'itanan̈ec d'ay yed' q'uen trompeta. B'itanan̈ec d'ay yed' te' arpa yed' pax salterio.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"B'itanan̈ec d'ay yed' pandereta, tzex q'uepax cheneljoc yuj tzalajc'olal. B'itanan̈ec d'ay yed' flauta yed' pax juntzan̈ yamc'ab' yic b'it ay sch'an̈al.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"B'itanan̈ec d'ay yed' q'uen platillo tzin̈in̈i sc'an̈i. B'itanan̈ec d'ay yed' q'uen platillo chaan̈ sc'an̈i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Masanil tastac syic' yic', b'itanocab' d'a Jehová.","poem":1},{"lineBreak":true},{"text":"Aljocab' vach' lolonel d'a Jehová.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cac_wbt/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cac_wbt/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cac_wbt/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}