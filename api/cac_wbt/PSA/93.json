{"translation":{"id":"cac_wbt","name":"A Ch'an Biblia D'a Chuj San Mateo","website":"https://ebible.org/Scriptures/details.php?id=cac","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cac","licenseNotes":null,"shortName":"WBT","englishName":"Chuj San Mateo Bible","language":"cac","textDirection":"ltr","sha256":"4beb059c9ea843d84cee211d5a4c8ae7c5277889ccc228261e970ce12a773c72","availableFormats":["json"],"listOfBooksApiLink":"/api/cac_wbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29990,"languageName":"Chuj","languageEnglishName":"Chuj"},"book":{"id":"PSA","translationId":"cac_wbt","name":"SALMOS","commonName":"SALMOS","title":"A Ch'an̈ Libro SALMOS","order":19,"numberOfChapters":150,"sha256":"ef2bc423931153c85608c362d9dbfab7d5c35efd40f80548075c42a39b37fd70","firstChapterNumber":1,"firstChapterApiLink":"/api/cac_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cac_wbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":93,"content":[{"type":"heading","content":["A Jehová Rey toni"]},{"type":"verse","number":1,"content":[{"text":"Mamin Jehová, Rey ach toni. Nivan chequel a b'inajnaquil yed' a poder. Tzatz ix utej em c'ojan yolyib'an̈q'uinal tic, yuj chi' max ib'xilaj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mamin Jehová, atax d'a yichb'anil Yajal achtaxoni. Toxonton ayach eq'ui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mamin Jehová, a a' mar tz'ib'xi a', sq'uepax chulnaj a'.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A achxo pax Mamin Jehová, Yajal ach d'a satchaan̈, ec'al ach d'a juntzan̈ a a' chi'. Ec'to a poder d'a a' mar chi'.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mamin Jehová, a a checnab'il ayn̈ej ec' d'a juneln̈ej. A a cajnub' nivan yelc'ochi yujto icn̈ej yaj d'a masanil tiempo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cac_wbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cac_wbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cac_wbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}