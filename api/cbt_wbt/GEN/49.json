{"translation":{"id":"cbt_wbt","name":"Yosë nanamën","website":"https://ebible.org/Scriptures/details.php?id=cbtNTpo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbtNTpo","licenseNotes":null,"shortName":"WBT","englishName":"Chayahuita NT","language":"cbt","textDirection":"ltr","sha256":"73df789343917326e86dd0e11b21e25afaa6e7030db896f1d84e0193466fb1b9","availableFormats":["json"],"listOfBooksApiLink":"/api/cbt_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":310,"totalNumberOfVerses":9212,"languageName":"Chayahuita","languageEnglishName":"Chayahuita"},"book":{"id":"GEN","translationId":"cbt_wbt","name":"Génesis","commonName":"Génesis","title":"Ya'ipi ma'sha caniaritërinso'","order":1,"numberOfChapters":50,"sha256":"9140b8a008761bfc48204dfbb7cdf229b5e7b06bebf36a8be180d3f277f240d1","firstChapterNumber":1,"firstChapterApiLink":"/api/cbt_wbt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cbt_wbt/GEN/50.json","totalNumberOfVerses":1400},"chapter":{"number":49,"content":[{"type":"heading","content":["Cacopo yachiminaton, hui'ninpita nontërinso'"]},{"type":"verse","number":1,"content":["Nani shinpita noya ya'huëcaiso marë' sha'huitohuachina, Cacoposo' ya'ipi hui'ninpita amatërin. Huë'pachinara itapon:",{"text":"“Amasha ya'carico conparo'sa'.","poem":1},{"lineBreak":true},{"text":"Ma'sona a'na tahuëri onpocamaso', carinquëma sha'huichinquëma natanco'.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Canpitaso hui'nahuëpitanquëma'.","poem":1},{"lineBreak":true},{"text":"Caso Cacopoco niporahuë', Israiro itërinaco anta'.","poem":1},{"lineBreak":true},{"text":"Carima sha'huitaranquëma ni'ton, natanco'.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"‘Quëmaso' Nopino, paninanquën.","poem":1},{"lineBreak":true},{"text":"Chiníquën nisoco, ya'nan hui'nahuananquënso'.","poem":1},{"lineBreak":true},{"text":"Chini chiníquën nanantaton, noya noya nicamaso' ninan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Inapocamaso nipiranhuë', co huachi inapoaranhuë'.","poem":1},{"lineBreak":true},{"text":"I' pa'pi chinii' nipachina, co onpo asanoirëhuë'.","poem":1},{"lineBreak":true},{"text":"Ina pochachin nicaton cosonanëhuë monshitëran,’ itërin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"‘Simion, Nihui, canpitaso, napopináchin cancantërama'.","poem":1},{"lineBreak":true},{"text":"A'napita ma'sha onpotamaso marë' nisha nisha ohuararama'.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Niyontonamaquë, ama onporo tëranta ya'noisohuë'.","poem":1},{"lineBreak":true},{"text":"No'huitatoma piyapi tëparama'.","poem":1},{"lineBreak":true},{"text":"Co natantonquëmahuë' nicatoma', tororo'sa nishitëtëntëntërama'.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tanan ni'niro'sa pochin no'huitërama'.","poem":1},{"lineBreak":true},{"text":"Napopiramahuë', co onporonta inachachin nisápomahuë'.","poem":1},{"lineBreak":true},{"text":"Carima ya'ipi Israiro nacionquë, ayanquëmiataranquëma',’ itërin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"‘Quëmaso' Cota, iyaparinpita pa'yataponën.","poem":1},{"lineBreak":true},{"text":"Inimiconënpita minsëra'piapon.","poem":1},{"lineBreak":true},{"text":"Iyaparinpita quëran huarë' moshaponën.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Quëmaso' conpa masho, Cota itëranquën.","poem":1},{"lineBreak":true},{"text":"Pa'pinia'hua pochin chinimiatëran.","poem":1},{"lineBreak":true},{"text":"Mapintahuaton pa'pini' pë'inihuachina,","poem":1},{"lineBreak":true},{"text":"mónsho mónsho tërarinquëran quëhuënin huachi.","poem":1},{"lineBreak":true},{"text":"Panca pa'pini' pochin ninan.","poem":1},{"lineBreak":true},{"text":"¡Pa'pini' chinotaso', co incari tëranta apisarinhuë'!","poem":1},{"lineBreak":true},{"text":"Inapochachin quëmanta inimiconënpita nitaponën.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Co inso tëranta hua'an quëran, quëmaso' Cota, ocoiarinënhuë'.","poem":1},{"lineBreak":true},{"text":"Huara së'quëranso co insonta mataponënhuë'.","poem":1},{"lineBreak":true},{"text":"Hua'anën chachin o'maquë huarë' co nanitapaponënhuë'.","poem":1},{"lineBreak":true},{"text":"Ina o'mahuachin, ya'ipi naciono'sari natëpona huachi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Cotaso notohuaro' oparohuanaton, mora'huanënta', co apiratarinhuë'.","poem":1},{"lineBreak":true},{"text":"Inaquë capacaso marë' a'sonpitërapon.","poem":1},{"lineBreak":true},{"text":"Huinoquë chachin a'morinso pë'sapon.","poem":1},{"lineBreak":true},{"text":"¡Opa huayo no'huiquënquë chachin, inapotapon!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ya'pirinpitanta', huino quëran quëhua quëhuashin ninin.","poem":1},{"lineBreak":true},{"text":"Natëquënpitanta', sho'shoi' quëran huiri huiríchin ninin,’ itërin.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"‘Quëmaso' Saporono, marë yonsan parti ya'huapon.","poem":1},{"lineBreak":true},{"text":"Panca nancharo'sa nonshinanëna ya'huërinquë, ya'huëapon.","poem":1},{"lineBreak":true},{"text":"No'panënso', Sitonquë huarë' naniarin,’ itërin.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"‘Quëmaso' Isacaro, chiníquën mora pochin nisaran.","poem":1},{"lineBreak":true},{"text":"Pë'tahua pëiro'saquë pë'pëtëranquëranchin chinotaran.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"“¡Noyachi iso no'pa' paya! Yashi yashin chinochachináchin,” tëcapon.","poem":1},{"lineBreak":true},{"text":"Co pahuërëpirinënhuë', noya cancantaton patron marë' sacataran,’ itërin.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"‘Quëmaso Tano, quëmaora huëntonënquë ya'huëpisopita catahuaran.","poem":1},{"lineBreak":true},{"text":"Nanan ya'huëtohuachina', anoyatacaiso catahuaran.","poem":1},{"lineBreak":true},{"text":"A'napita Israiro huëntono'sa pochachin nisaran.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ya'huan yaquëtëtërinso pochin nisaran.","poem":1},{"lineBreak":true},{"text":"Inaso', ira pirayan yamorin quëtëtacaso marë'.","poem":1},{"lineBreak":true},{"text":"Cahuario tocanën quëtëhuachina, piyapi ya'mitërinso', anotapon.","poem":1},{"lineBreak":true},{"text":"Inapochachin quëmanta', inimicoro'sa nitaran,’ ” itërin Cacopori hui'ninpita nontaton.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ina quëran Cacoposo' Yosë nontaton tapon:","poem":1},{"lineBreak":true},{"text":"“¡Sinioro, quëmaso' nicha'ësaranco tënahuë!” itërin.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A'napita hui'ninpitanta yonquiaton taantarin:","poem":1},{"lineBreak":true},{"text":"“ ‘Quëmaso Caro, matararoro'sa huënton ya'contarinquën.","poem":1},{"lineBreak":true},{"text":"Quëmariso napoaponahuë', nita'atahuaton imasaran,’ itërin.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"‘Quëmaso' Asiri, noya noya cosharo ya'huëtarinquën capacaso'.","poem":1},{"lineBreak":true},{"text":"Copirnoro'sa ca'ninso pochin ca'sápon.","poem":1},{"lineBreak":true},{"text":"Napoaton quëmari quëtohuatan inapitanta ca'sapi,’ itërin.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"‘Quëmaso' Nipitari, co camainënquënso costaponhuë'.","poem":1},{"lineBreak":true},{"text":"Tanan yo, noyanpia'huaráchin hua'huinpitarë' pa'ninso pochin nisaran.","poem":1},{"lineBreak":true},{"text":"Inapochachin quëmá quëran pipipisopitanta',","poem":1},{"lineBreak":true},{"text":"na'a nisahuatona', noyanpia'huaráchin nicapona',’ itërin.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"‘Quëmaso Cosi, i'sha yonsanquë huayo huanirinso pochin ninan.","poem":1},{"lineBreak":true},{"text":"Inaso' huayo pa'pi notohuaro' nitërin. Së'paquënpitanta', paira pa'tërin.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Pë'chinan camayoro'sa', no'huirinquën.","poem":1},{"lineBreak":true},{"text":"No'huitënën pë'chinan shinërëquë yaohuaninën.","poem":1},{"lineBreak":true},{"text":"Napotatënën, co noya quëran ya'huëchináchinhuë nitarinën.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Quëmaso nipirinhuë', chini chiníquën tanpatëran.","poem":1},{"lineBreak":true},{"text":"Pë'chinanënquë inimicoro'sa të'yanantohuatan, co pacoitaranhuë'.","poem":1},{"lineBreak":true},{"text":"Yosë imarahuëso', chini chiníquën nanantërin.","poem":1},{"lineBreak":true},{"text":"¡Ina catahuarinquën inimicoro'sa minsëaran!","poem":1},{"lineBreak":true},{"text":"Sinioroso' ohuica hua'anën pochin ni'ton, a'pairinco.","poem":1},{"lineBreak":true},{"text":"¡Ina chachin quëmanta a'paiatënquën catahuarinquën!","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yosënëhuë chachin, catahuapënquën.","poem":1},{"lineBreak":true},{"text":"Inaso', ya'ipi nanitapaton catahuapënquën.","poem":1},{"lineBreak":true},{"text":"Ina nohuanton, o'nanpachina catahuainquën.","poem":1},{"lineBreak":true},{"text":"Acoporonta i' ya'huërinso', ina nohuanton pipiton catahuainquën.","poem":1},{"lineBreak":true},{"text":"Pë'tahuanëmapita, sanapinëmapita, inapitanta huaihuachina catahuain.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tata mashocoro'sa iráca, noya ya'huëca'huaso marë' sha'huitërinaco.","poem":1},{"lineBreak":true},{"text":"Carinquënso', ipora noya noya sha'huitaranquën.","poem":1},{"lineBreak":true},{"text":"Motopiro'sa ya'huërárinso ta'huantaquë huarë', Yosë catahuaráponquën.","poem":1},{"lineBreak":true},{"text":"A'napita iyanpita quëran, noya noya nicatënquën huayonanquën.","poem":1},{"lineBreak":true},{"text":"Napoaton së'huamotorahuatënquën quëma marë' Yosë nontërahuë,’ itërin.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"‘Quëmaso' Mincamin, pa'pi mapinton tanan ni'nira pochin nicapon.","poem":1},{"lineBreak":true},{"text":"Tashiramiachin inaso mapintahuaton, ca'miatërin.","poem":1},{"lineBreak":true},{"text":"Naporo' i'huanahuanquë chachin pë'sotërinsonta', a'napitari ca'papi.","poem":1},{"lineBreak":true},{"text":"Inapochachin quëmanta', yaata'huantëransopita nitaran.","poem":1},{"lineBreak":true},{"text":"Inapotahuaton ma'shanënanta', nipatomatapoma',’ ” itërin.","poem":1}]},{"type":"verse","number":28,"content":["Ina pochin Cacopo shonca cato hui'ninpita noya ya'huëcaiso marë' sha'huitërin. Inapita quëran shonca cato Israiro huëntono'sa pipipi."]},{"type":"heading","content":["Cacopo chimininso'"]},{"type":"verse","number":29,"content":["A'na tahuëri Cacoposo', hui'nipita camairin: “Co hua'quiya quëranhuë' chiminarahuë huachi. Chiminpato, shimashonëhuëpita pa'pitopiso pirayan po'moontaco. Iti huënton piyapi, Ipron itopisori, ina no'paso' hua'anëntopirinhuë'."]},{"type":"verse","number":30,"content":["Maquipiraquë nanin ya'huërinso yonquiato napotarahuë. Inaso', Canaan parti ya'huërin. Mamiri notënanquë ya'huërin. Ina no'pa' mini iráca tata mashoco Apraan nipa'pitacaiso marë' pa'anin. Ina pirayan no'pa' ya'huërinsorë chachin naporo Ipron pa'antërin."]},{"type":"verse","number":31,"content":["Inaquë Sara, Apraan, inapita chiminpachinara ya'conpi. Tata Isaco, mama Nipica inapitanta inaquë chachin ya'conpi. Inaquë canta', sa'ahuë Nia itërahuëso ya'conin."]},{"type":"verse","number":32,"content":["Ina no'paso' naninë chachin, Iti huënton piyapi'sa pa'antopi,” itërin."]},{"type":"verse","number":33,"content":["Cacoposo' hui'ninpita camairinso tonitohuachina, pë'saranënquë quëhuëantarin. Quëhuënaso chachin, chiminin huachi."]}],"footnotes":[]},"thisChapterLink":"/api/cbt_wbt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbt_wbt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbt_wbt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}