{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"2SA","translationId":"cbu_wbt","name":"2 Samuela","commonName":"2 Samuela","title":"2 Samuela Samuelarini kuzizimun yandarangu anu","order":10,"numberOfChapters":16,"sha256":"c70421f26c4edc051f807b7ec9756486b468b717eba2d6ebd89e6368f1c67cdd","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/2SA/1.json","lastChapterNumber":23,"lastChapterApiLink":"/api/cbu_wbt/2SA/23.json","totalNumberOfVerses":402},"chapter":{"number":22,"content":[{"type":"heading","content":["Ashiriya, na kamanchintspa yuwaa Dapiyarini yaseeku tárangu anootsi"]},{"type":"verse","number":1,"content":["Dapiyarini Apanllee yaseeku, Apanll nuwaa tapachindarangu, Saularini nda pacharanganda, mishat kundartamti nda nuwaa pacharangiya, átu yaseeku tárangiya."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Apaa, shiyamari kizpureerush, nuwaa tapachindarangush,","poem":1},{"lineBreak":true},{"text":"nuw patumbchishpaz wach pshturanguri, ashiru shiyash kamungarangi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Shiyash patumbich wach tamapari ashiru anush nuw kamungkina; nuwaa tapachindaksha.","poem":1},{"lineBreak":true},{"text":"Mishat, xanxapishpapaz kámanaku ashiru nuwaa wizpurirpatish kámanakush, nuwshat kamungkina.","poem":1},{"lineBreak":true},{"text":"Mishat, arang yuwarpaz kámanaru ashiru anush nuwaa pishuksha.","poem":1},{"lineBreak":true},{"text":"Ashkush, shiyamari wizpurirpatish nuwaa ksutkush taaraasheetsi tapachindaksha.","poem":1},{"lineBreak":true},{"text":"Nuwaa tputs kiyung yachamaam zandarangtaatssin, itaru shiyshat nuwaa tapachindarangsha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apaa, shiyaatsimaritcha wanasireem ínamaam waritaksha.","poem":1},{"lineBreak":true},{"text":"¿Nuw shiyaa wanipaja masharangi?","poem":1},{"lineBreak":true},{"text":"Nuwaam istanda táranguri, shiyshat nuwaa kundarari tapachindarangsha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nuw tsipamaam waritarangina.","poem":1},{"lineBreak":true},{"text":"Waraspaz ashiru nuwaa mangeetsi yambutarangu, nuwshat kapung punirustarangina.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mishat, wanumbpapaz maachtaam tutsangtarich,","poem":1},{"lineBreak":true},{"text":"ashimashtaa nuwaam tsipamaam waritarangitaati,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"nuwaa taxararangusin,","poem":1},{"lineBreak":true},{"text":"¿Tamayareezi kamungchi? táranguri,","poem":1},{"lineBreak":true},{"text":"Apaa, shiyaatsshat pangishish mashiranguri, kapung tanuranguri,","poem":1},{"lineBreak":true},{"text":"shiyshat k'keetsi mazinarangush,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"shiyshat yuwamand tsipats kinarangi anumand kapung tsiyantarangush,","poem":1},{"lineBreak":true},{"text":"tsap kapung mundaztarangu, kanindpitam mundaztarangiya.","poem":1},{"lineBreak":true},{"text":"Shaana Apaa, wizpurirpatish ashirangsha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mishat, kizpur tsiyantarangush, shipishish msas ashiru kizpur shitungarangiya.","poem":1},{"lineBreak":true},{"text":"K'kishitish sumas ashiru shitungarangu, watsam ashiru kurakurtaru, ningeem zanganirangsha.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kanindaa wach tawatakpaz ashirangush, msaseetsshat kizpur tuwap tsapush zanganirangsha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ashirangush, kambusur machimun pantsatarangu,","poem":1},{"lineBreak":true},{"text":"maacheetsi wazitpungach wanindawa tpurangarangu, kambusurush naatarangiya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kambusurshat kizpur tap ashirangu,","poem":1},{"lineBreak":true},{"text":"sinshat sinamaam zandarangu, anushshat shiy tapishurangsha.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Anushshat, kapung kariytarangu,","poem":1},{"lineBreak":true},{"text":"watsamshat sumas sin ashiru tsapush pantsatarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ashirucha, Apanllimari kizpureeru, kariyaa zanganku,","poem":1},{"lineBreak":true},{"text":"kapung kariytakachu, kanindap kimakiya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ashirangu, kundarareetstamti mangoo tamamarpamaam wásaparinpa tiyanurangu,","poem":1},{"lineBreak":true},{"text":"mamaroo kayungarangu, kizpur mamartarangiya.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tputsee wanimaam zandarangu,","poem":1},{"lineBreak":true},{"text":"kizpur maraa kung tapusirangu, tsapoo wanshuchee puzarangiya.","poem":1},{"lineBreak":true},{"text":"Tputsshitisin ichingarusin tsapoo wanshuchee paranganaya.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apanllshat waana íwarimand uw paxayarangu, uwish nuwaa wayarangu,","poem":1},{"lineBreak":true},{"text":"nuwshat mar kapungootstaa kitarangina.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Amb ashiranguri, kundarari kizpureewtaatssin nda nuwaa pacharangusin,","poem":1},{"lineBreak":true},{"text":"nuwamaritam kamungarangina, nuwaa kapungtaa natsarangusina.","poem":1},{"lineBreak":true},{"text":"Uwshtisin tputs nuwamand kizpureew taaranganaya.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yuwash nuw wizpuriri ndunareerangu anush, nuwaa pachamaam zandarangsin,","poem":1},{"lineBreak":true},{"text":"itaru Apanllsha nuwaa istarangu,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"nuwaa tashitungarangiya.","poem":1},{"lineBreak":true},{"text":"Ashirangu, nuwshat kamungarangina.","poem":1},{"lineBreak":true},{"text":"Apanll nuwaa kapung chinaku ashirangiya.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Watam nuwshat wanasir taaranginawa.","poem":1},{"lineBreak":true},{"text":"Ashirucha, Apanllshat nuwaam wanasiritam istarangiya.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Watam nuw Apanllish kis tachitaranginawa.","poem":1},{"lineBreak":true},{"text":"Ashiranguri, ayamamtiyam nuw Apanllee nda kasachina.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ichingaru yuwaa tsiyatarangu anootstam nuw payuranguri,","poem":1},{"lineBreak":true},{"text":"nda minumtiyam kukoo kapeetarangina.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Amb ashiranguri, wanasir taarangina;","poem":1},{"lineBreak":true},{"text":"nda yutaritshishush pshturangina;","poem":1},{"lineBreak":true},{"text":"yutaritshisheetsshat izuuru kasarangina.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ashirucha yuwamand nuw kizpur wanasir tárangi anumandtam,","poem":1},{"lineBreak":true},{"text":"Apanllsha nuwaam wanasiritam istarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Apaa, shiyaa tputs k'keetsish payukana,","poem":1},{"lineBreak":true},{"text":"anoo shiyshat wanasiritam napaksha.","poem":1},{"lineBreak":true},{"text":"Mishat, nda yutaritshishush pshtukana, anootstam shiyshat chinaksha.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Zurampatari shiyaa chinakana, anoo shiyshat zurampatartatam chinaksha.","poem":1},{"lineBreak":true},{"text":"Itaru, tputs tamapingampaneetsshat, shiyshat zurampatari waneeksha.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mishat, yuwaatsimari shiyaa kukish payukana anootsimari tapachindaksha.","poem":1},{"lineBreak":true},{"text":"Itaru, yuwaatsshat shiyaa kukish nda payuksin, waanaatstamari chinakana,","poem":1},{"lineBreak":true},{"text":"anootsshat shiyshat waneeksha.","poem":1},{"noteId":3}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Apaa, shiyamari nuwaa tuwasineeksha.","poem":1},{"lineBreak":true},{"text":"Apaa, shiyaa nuwcha Apanlliri.","poem":1},{"lineBreak":true},{"text":"Ashirucha, nuw tapish taamaam waritaktaati,","poem":1},{"lineBreak":true},{"text":"itaru shiyshat nuwaa mangeetsi tuwasineeksha.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Shiy nuwaam istarangush, nuwamari kundarareetsi kasirangina.","poem":1},{"lineBreak":true},{"text":"Mishat, yakat tandapunumaatsta nuwamaritam pshturangina.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ashirucha, Apanllimari wamachtash kizpur wanasiriya.","poem":1},{"lineBreak":true},{"text":"Mishat, Apanllimunari kuk chiy mangich tatukchi.","poem":1},{"lineBreak":true},{"text":"Tputs Apanllimunamari mang' tatku anoo uwshat ksutkiya.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"¿Tamamshat Apanllee kasiru min taaraa?","poem":1},{"lineBreak":true},{"text":"Mishat, ¿taamaam Apanll iyaa taarasheetsini kizpur wanasir ksutka?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Apanllimari kizpureeru, iyaa taarasheetsini tapachindakiya.","poem":1},{"lineBreak":true},{"text":"Mishat, yutaritshishireetsini tachingkiya.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Nuwaam istarangu, k'tseetsi murish wayarangu,","poem":1},{"lineBreak":true},{"text":"nuwshat manllanus ashiruri machpitaa káriranguri, nda pantsarangina.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Apanll tapazeemtam waratamaam nuwaa tuxapshingarangiya.","poem":1},{"lineBreak":true},{"text":"Ashirangu, nuwshat wizpuriri kapung taaranguri,","poem":1},{"lineBreak":true},{"text":"tsaktsakaa ngusambaatstaa tinamaa yáyaruri,","poem":1},{"lineBreak":true},{"text":"mbamaatstaa tsak ashirangina tputseem pachamaama.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Apaa, shiyamari nuwaa tapachindarangush, nuwshat kamungarangina.","poem":1},{"lineBreak":true},{"text":"Amb ashirangush, nuwamari kizpur taakina.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Nuwaa wanasirip ngoots tuyamandarangush,","poem":1},{"lineBreak":true},{"text":"nuwshat amb naataranguri, nda pakchiyam pantsarangina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Ashirucha, kundarareetsi pacharanguri, nuwamari ashparitaa kachingaranguri,","poem":1},{"lineBreak":true},{"text":"yusur nuwamaritam kanapurangina.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Nuwamari kundarareetsi izuuru kachingeeri, zurampatari tpachingarangina.","poem":1},{"lineBreak":true},{"text":"Pantsarangusin, ayamtaati yusur chiyzachazinllinaja.","poem":1},{"lineBreak":true},{"text":"Nuwanungiri tum tum ashiranganaya.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Apanllsha nuwaa kapung wizpurireemi panarangiya tapazeem waratamaama.","poem":1},{"lineBreak":true},{"text":"Ashirangu, yuw tputs nuwaa natsamaam zandarangana,","poem":1},{"lineBreak":true},{"text":"anoo nuwamari kasiranguri, nuwanungeem timuchta ashiranganaya.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Itaru, nuwshat kundarari kizpur puniksin suwaranganaya.","poem":1},{"lineBreak":true},{"text":"Amb sheeruri, kundarareetsi nuwamari kasirangina.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Ashirangsin, tputseewaatstam istanda tárangitaatssin,","poem":1},{"lineBreak":true},{"text":"itaru tputsshitisin nda istaranganaya.","poem":1},{"lineBreak":true},{"text":"Apanllingaztam kuruzurangsin, Apanllshat nduntam mazinarangiya.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Izuuru kachingaranguri, tsapoo tachuwchayaruch, wasipureem ínatarich ashirangina.","poem":1},{"lineBreak":true},{"text":"Ashiranguri, tsiparimun kapcharanguri, sharamungash kapchatarich ashirangina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Apaa, tputs iyaa natsarangana anoo shiyshat tpachingarush, nuwaa kurakaam ínarangsha.","poem":1},{"lineBreak":true},{"text":"Ashirangush, na tputs ichingarusin nduntaa nuwaa natstaksin, k'keetsi payukanaya.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Arapcheewtamsin nuwash kuseersin, nuwaa kis ungirtakanaya.","poem":1},{"lineBreak":true},{"text":"Yuwaatstam kamachtaki anootstam kis mazinayarusin, payukanaya.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Tputs arapcheew kuseersin, nuwaa nungtaksin,","poem":1},{"lineBreak":true},{"text":"tapishutusin, púnirpatari kuskanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Ashiri Apaa, shiyamari urutamari taatsha. Shiyashumari nuw kamungkina.","poem":1},{"lineBreak":true},{"text":"Shiyaatsimari nuw wanasir tsiyatchima. Shiy nuwaa taaraasheetsi tapachindaksha.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Shiyshat Apanlleerush kurandarareetsini kisatarangish.","poem":1},{"lineBreak":true},{"text":"Tputsshitisin ichingaru na nuwaa ksutkanaya.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Apaa, nuwaa kundarari natsamaam zandarangtaatssin,","poem":1},{"lineBreak":true},{"text":"itaru shiyshat Apanlleerush, nuwaa kundarari kizpureewaatstaa,","poem":1},{"lineBreak":true},{"text":"ashtaa nuwaa tapachindarangsha.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Ashirucha, yuwamand ashirangish anumand","poem":1},{"lineBreak":true},{"text":"nuwshat ichingarupa tsapurunas shiyaa surish shambatkiniya.","poem":1},{"noteId":4}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Shiyamari kasirangush, nuwaatssha kurakaam ínarangsha.","poem":1},{"lineBreak":true},{"text":"Shiy kurakish kizpureerush, shaana nuwaa kurakaam ipusarangsha.","poem":1},{"lineBreak":true},{"text":"Shiy urutamari nuwaa, mishat chinllineetstamti kis napaksha,","poem":1},"Dapiy tárangiya.",{"lineBreak":true},"Ashiriya, na kamaneena yuwaa Dapiyarini yaseeku tárangu anootsi."]}],"footnotes":[{"noteId":3,"caller":"*","text":"Lukasa 1.51-53 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":22,"verse":28}},{"noteId":4,"caller":"*","text":"Yuwaa nish átu anootstam Romshucheema 15.9 tayusima kamankiya.","reference":{"chapter":22,"verse":50}}]},"thisChapterLink":"/api/cbu_wbt/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/2SA/19.json","previousChapterAudioLinks":{},"numberOfVerses":51}