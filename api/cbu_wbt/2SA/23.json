{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"2SA","translationId":"cbu_wbt","name":"2 Samuela","commonName":"2 Samuela","title":"2 Samuela Samuelarini kuzizimun yandarangu anu","order":10,"numberOfChapters":16,"sha256":"c70421f26c4edc051f807b7ec9756486b468b717eba2d6ebd89e6368f1c67cdd","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/2SA/1.json","lastChapterNumber":23,"lastChapterApiLink":"/api/cbu_wbt/2SA/23.json","totalNumberOfVerses":402},"chapter":{"number":23,"content":[{"type":"heading","content":["Ashiriya, na kamanchintspa yuwaa Dapiy tuwatspamamari tsiyatarangu anootsi"]},{"type":"verse","number":1,"content":["Dapiyarini kuk tuwatspamaam tsiyatku tárangiya. Dapiya Jeseyarini wipa. Apanll waana Dapiyaa kizpureem kurak ínarangiya. Yuwamand Akoparini Apanllee kapung chinarangu, anumandtam Apanllsha Dapiyarineetsi kurakaam ipusarangiya. Dapiyshat Israelchich kis yasimpan taarangiya. Dapiy tárangiya."]},{"type":"verse","number":2,"content":[{"text":"Apanll waana wanee zanganirangu, nuwaa tutsiyatstarangiya.","poem":1},{"noteId":5},{"lineBreak":true},{"text":"Ashirucha, nuwsha kis tsiyatchina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Israelchich Apanllirini tárangiya;","poem":1},{"lineBreak":true},{"text":"Nuw Israelchicheem tapachindampaneem taachima,","poem":1},{"lineBreak":true},{"text":"Apanll waana nuwaa tárangiya.","poem":1},{"lineBreak":true},{"text":"Kurak tiptsiree taárash itsinsaru yasakchu, nuwaa kuki tatsamooru payukchu,","poem":1},{"lineBreak":true},{"text":"nuwsha kis chinachina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Urutamari kis taachiya.","poem":1},{"lineBreak":true},{"text":"Kanindap 'sinitaraa ashikpaz ashtachiya.","poem":1},{"lineBreak":true},{"text":"Zartam tarasitaranllu, puturi msas ndunariri kizpur 'sineekchu,","poem":1},{"lineBreak":true},{"text":"mzatsish maachi kis kxunkachu, anumunshapaz sin sinakchu,","poem":1},{"lineBreak":true},{"text":"kuraksha ashikpaz ashiru kis taachiya, Apanll tárangiya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ashirucha, nuw nlluranuri urutamari Apanllchicheem taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Watam Apanll waana urutamari shiyachchee kasacheezi, táranguwa.","poem":1},{"lineBreak":true},{"text":"Ashirucha, nuwamari kundarareetsi kasikina.","poem":1},{"lineBreak":true},{"text":"Apanllsha nuwaa istakchu, yuwari nuw chinaki anoo","poem":1},{"lineBreak":true},{"text":"zurampatari tatsameerinand kasachiya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Itaru, tputs yutaritshishpanshitisin kap tamapari ashirusin taakanaya.","poem":1},{"lineBreak":true},{"text":"¿Chakaja kpaa tputs uwpat putayach?","poem":1},{"lineBreak":true},{"text":"Ashiri arap kpaa kapeetamaam waritakcha.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Itaru, chiyshat kpaa patatamaam zandkuch,","poem":1},{"lineBreak":true},{"text":"ngusamb pazuyaruch, patatamaam waritakiya.","poem":1},{"lineBreak":true},{"text":"Anootsshat sumasish pshtamaam waritakiya, izuuru ashpari muchimaama,","poem":1},"Dapiy tárangiya.",{"lineBreak":true},"Ashiriya, na kamaneena yuwaa Dapiyarini kuk iwatsparangu anootsi. [Wapparee. Watamcha Samuelarini kuku kuzizimon yandama.]"]}],"footnotes":[{"noteId":5,"caller":"*","text":"Tayaspatampani 2.30 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":23,"verse":2}}]},"thisChapterLink":"/api/cbu_wbt/2SA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/1KI/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/2SA/22.json","previousChapterAudioLinks":{},"numberOfVerses":7}