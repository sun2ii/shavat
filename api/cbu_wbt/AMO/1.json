{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"AMO","translationId":"cbu_wbt","name":"Amosa","commonName":"Amosa","title":"Amosarini kuku Nuw Amosi Apanllee kuk kamanchintspa","order":30,"numberOfChapters":9,"sha256":"19eac5dbd8b20d9f12e73cd736f1d0c949fff8bc050c2432534619a787374f3c","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cbu_wbt/AMO/9.json","totalNumberOfVerses":144},"chapter":{"number":1,"content":[{"type":"heading","content":["Ashiriya, yuwaa Apanll Israelchichee kapung tsiyatarangu anoo kamanchintspa"]},{"type":"verse","number":1,"content":["Ashiriya, nuw Amosi Tekuwash opeejaa ksutamapan taaruri, anushsha Apanll Israelchichimun tsiyatssee kamanirangiya. Yuw mundaz mundaztachu, an tsimbun masach pshataru, anush nuwaa kamanirangiya. Anpur Osiyas Utaásh kurakamuna, Jerobowamsha Jowasarini wip Israelchicheem kurakamuntamta."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Apanll nuwaa tsiyatarangu, Siyonamand kuk kimarangu,","poem":1},{"lineBreak":true},{"text":"kariy tamapari ashiru zungan zungan ashirangiya.","poem":1},{"lineBreak":true},{"text":"Irusarinamand kizpur zunganeerangu,","poem":1},{"lineBreak":true},{"text":"tsapsha kizpur zpuzarangu, ichingaru maachi mawiruyaru, mchiroorangiya.","poem":1},{"lineBreak":true},{"text":"Machpitaa íwar Karmelu sur kizpur mawiruyaru, mchiroorangitamta.","poem":1},{"lineBreak":true},"Apanll tsiyatku amb ashirangiya."]},{"type":"heading","content":["Kamanchintspa yuwaa, Israelanung tsap tputs yutarit taarangana anoo nuw wanichima, Apanll tárangu, anootsi"]},{"type":"verse","number":3,"content":["Ashiri siyaa Damáskushcheetsis Apanll tárangiya.",{"lineBreak":true},{"text":"Siy Damáskushchis kapung yutaritshishi chinarangus,","poem":1},{"lineBreak":true},{"text":"Galaadshuchee tputs tirikoo ngusambpat tokuch tamatarpachi ashiru chuwiyarus, kasarangis,","poem":1},{"lineBreak":true},{"text":"anumand nuwsha siyaa zurampatari wanichintspa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Anumandtam nuwsha sumasee zanganchima.","poem":1},{"lineBreak":true},{"text":"Kurakaa Asayela nlluranur ichingaru kachingchima.","poem":1},{"lineBreak":true},{"text":"Mishat, Ben-jadadtam pang' pangurangana anootstam ichingaru muchchitamma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Siy Damáskushchis pshtumaam wachoo kámanartaateesa,","poem":1},{"lineBreak":true},{"text":"anoo nuwsha wizpurirpati tawateeruri, Bikat-avenshucheetstam kurak,","poem":1},{"lineBreak":true},{"text":"misha Bet-edenshucheetstam kurak ashparitaatsis siyaa Síriyashcheetsis tputsis putayarusin,","poem":1},{"lineBreak":true},{"text":"arap Kirip tsap machinllinaya Asirshuch tputsiya,","poem":1},{"lineBreak":true},"Apanll siyaa tárangiya."]},{"type":"verse","number":6,"content":["Filistewshucheetssha Apanll tárangitamta.",{"lineBreak":true},{"text":"Gasshuch yutaritshisheetsimaritam chinarangusin,","poem":1},{"lineBreak":true},{"text":"tputsee ichingaru machtayarusin,","poem":1},{"lineBreak":true},{"text":"muchchureetspaz ashiru Edomshucheemsha tupaxanxarangana,","poem":1},{"lineBreak":true},{"text":"anamand nuwsha zurampatari wanichima.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ashirucha, anumandtam sumasee Gasshuch tandapunurangana anoo mucheeruri,","poem":1},{"lineBreak":true},{"text":"kurakpatari pangu izuuru muchimaam zanganchima, atina.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wizpurirpati Asdodshuchee urkar,","poem":1},{"lineBreak":true},{"text":"Askalonshucheetstam urkar izuuru tpachingayaruri kasachima.","poem":1},{"lineBreak":true},{"text":"Ekronshucheetstam urkar nduntam pakchiyam nayanikuri, izuuru tpachingachima.","poem":1},{"lineBreak":true},{"text":"Amb ashkachuri, Filistewshuch ashpari tsipachinllinaya,","poem":1},{"lineBreak":true},"Apanll tárangiya."]},{"type":"verse","number":9,"content":["Tirshucheetssha tárangitamta.",{"lineBreak":true},{"text":"Tirshuch kapung yutarit chinarangana.","poem":1},{"lineBreak":true},{"text":"Zoonlleetspaz ashiru tputsee amikurtayarusin,","poem":1},{"lineBreak":true},{"text":"anootssha tamapingayarusin,","poem":1},{"lineBreak":true},{"text":"muchchureem ínayarusin,","poem":1},{"lineBreak":true},{"text":"Edomshucheemsha tupaxanxaranganaya.","poem":1},{"lineBreak":true},{"text":"Anumand nuwsha zurampatari wanichima.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Anumandtam Tirshuch tandapunurana anoo muchkachu,","poem":1},{"lineBreak":true},{"text":"kurakpatari pang' wanasireew pangurana anpatari muchimaam sumasee zanganchima,","poem":1},{"lineBreak":true},"Apanll tárangiya."]},{"type":"verse","number":11,"content":["Edomshucheetssha Apanll tárangitamta.",{"lineBreak":true},{"text":"Edomshuch kapungtam yutarit chinarangusin,","poem":1},{"lineBreak":true},{"text":"waanaatstaata zoonll Israelchichee nda nayanimaam zandkusin, pacharanganaya.","poem":1},{"lineBreak":true},{"text":"Yuwari zandkana anuri watsiyun sitarangsin, zoonlleetstaa kachingaranganaya.","poem":1},{"lineBreak":true},{"text":"Anumand nuwsha zurampatari wanichima.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ashirucha, Temanshuchee, misha Bosráshcheetstam kurakaam pangurangana","poem":1},{"lineBreak":true},{"text":"anoo ichingaru muchimaam sumasee zanganimaam zandkina,","poem":1},{"lineBreak":true},"Apanll tárangiya."]},{"type":"verse","number":13,"content":["Amónshucheetssha tárangitamta.",{"lineBreak":true},{"text":"Amónshuch kapungtam yutarit chinarangusin,","poem":1},{"lineBreak":true},{"text":"Tsapunni kapungup, atusin,","poem":1},{"lineBreak":true},{"text":"Galaadshuchee tpachingayarusin, kiz mireeru, anoo pachayarusin,","poem":1},{"lineBreak":true},{"text":"chikaa taarayarusin, kasaranganaya.","poem":1},{"lineBreak":true},{"text":"Anumand nuwsha zurampatari wanichima.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Anumandtam Rabaa yakat tandapunurana,","poem":1},{"lineBreak":true},{"text":"anoo muchkachu, kurakaam pangurangana,","poem":1},{"lineBreak":true},{"text":"anpatari muchkachu, tapazish pachaksin,","poem":1},{"lineBreak":true},{"text":"kizpur zunganitaru ashiru, muchimaam sumasee zanganimaam zandkina.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Amb ashkachuri, urkarshitisin, misha yuwatamsin nuw kizpurtana átana,","poem":1},{"lineBreak":true},{"text":"antamsin arap naakchusin, imarchachinllinaya,","poem":1},{"lineBreak":true},"Apanll tárangiya."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/DAN/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}