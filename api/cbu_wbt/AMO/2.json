{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"AMO","translationId":"cbu_wbt","name":"Amosa","commonName":"Amosa","title":"Amosarini kuku Nuw Amosi Apanllee kuk kamanchintspa","order":30,"numberOfChapters":9,"sha256":"19eac5dbd8b20d9f12e73cd736f1d0c949fff8bc050c2432534619a787374f3c","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cbu_wbt/AMO/9.json","totalNumberOfVerses":144},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Mowabshuchee tárangitamta.",{"lineBreak":true},{"text":"Mowabshuch kizpur yutarit chinarangusin,","poem":1},{"lineBreak":true},{"text":"Edomshuchee kurak wanapoo yáyarusin,","poem":1},{"lineBreak":true},{"text":"sumasish mucheersin, puzacheemsha kinarangu,","poem":1},{"lineBreak":true},{"text":"anumand nuw zurampatari wanichima.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Anumandtam nuwsha Mowabshucheem sumasee zangankachuri,","poem":1},{"lineBreak":true},{"text":"Kiriyutshucheem kurak pang' pangurangana, anootstam muchkachuri,","poem":1},{"lineBreak":true},{"text":"izuuru puzacheem kinachiya.","poem":1},{"lineBreak":true},{"text":"Amb ashkachuri, tapazish pachaksin,","poem":1},{"lineBreak":true},{"text":"kizpur zunganitaru ashiru, wakar wits puu puu tákchusin,","poem":1},{"lineBreak":true},{"text":"siysa Mowabshuchis tsipatartatssa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kurakaris ichingaru ksutku anoo,","poem":1},{"lineBreak":true},{"text":"misha kurak tsipasawaatstam ichingaroo nuwamari kasiruri,","poem":1},{"lineBreak":true},{"text":"sumaspa tpachingachima,","poem":1},{"lineBreak":true},"Apanll Mowabshuchee tárangiya."]},{"type":"heading","content":["Utaáchcheetssha Apanll tárangu anoo kamanchintspa"]},{"type":"verse","number":4,"content":["Apanll Utaáchchee tárangitamta.",{"lineBreak":true},{"text":"Utaáchich yutaritshishingazimari zandkusin,","poem":1},{"lineBreak":true},{"text":"nuwaa tayutaritkusin,","poem":1},{"lineBreak":true},{"text":"nda k'keetsi payukana.","poem":1},{"lineBreak":true},{"text":"Waana zitaminarini tamarangparee ashirusin,","poem":1},{"lineBreak":true},{"text":"maacheetsisha tínayarusin,","poem":1},{"lineBreak":true},{"text":"anootssha ungirtaksin taakana,","poem":1},{"lineBreak":true},{"text":"anumand zurampatari nuw Utaáchchee wanichima.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ashirucha, Utaáchich Irusarinush kurakaam pang' pangurangana anoo muchimaam sumasee zanganchima,","poem":1},{"lineBreak":true},"Apanll Utaáchchee tárangiya."]},{"type":"heading","content":["Apanll Israelchicheetssha wanichima, tárangitamta anoo kamanchintspa"]},{"type":"verse","number":6,"content":["Apanll Israelchichee tárangitamta.",{"lineBreak":true},{"text":"Israelchich kapung yutaritshishee chinarangana,","poem":1},{"lineBreak":true},{"text":"anumand urutari waneerinandti kasachima.","poem":1},{"lineBreak":true},{"text":"Watam tputs wanasirimsheetstaa, kurik putapani atusin, tupaxanxakanawa.","poem":1},{"lineBreak":true},{"text":"Mishat, pukireetstam minumpatamari spat tupaxanxakitamsinaya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pukiree wamari kasirsin, kiyung yachakanaya.","poem":1},{"lineBreak":true},{"text":"Tsiyatssee yaramaam waritaktaa,","poem":1},{"lineBreak":true},{"text":"itaru pukireetssha yutaritam ínakana;","poem":1},{"lineBreak":true},{"text":"yaramaam ngatkanaya.","poem":1},{"lineBreak":true},{"text":"Wapar, misha wipatam kizaa minumtaatsimari yangakanaya.","poem":1},{"lineBreak":true},{"text":"Ashkusin, nuwaa Apanlleetsi kizpur yutaritaam ínakanaya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pukireem kurikee istayarusin, suwatpa atusin, punlluree itutskana.","poem":1},{"lineBreak":true},{"text":"Anootssha yáyarusin, anumunsha maamaw ashkusin,","poem":1},{"lineBreak":true},{"text":"apanllputseem ungirtaksin katungkanaya.","poem":1},{"lineBreak":true},{"text":"Tputsee nuwaa nda mikeeru tuwaparangu, atusin,","poem":1},{"lineBreak":true},{"text":"kurikee arang yáyarusin, anpatatam vinoo paxanxeersin,","poem":1},{"lineBreak":true},{"text":"kis apanllputsish waakana.","poem":1},{"lineBreak":true},{"text":"Anushsha karusastangat ashkanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Síru nuw siyaa Israelchicheetsis chinaranguri,","poem":1},{"lineBreak":true},{"text":"apusap machimaam Amorrewshuch tputs kizpureewaatstaa,","poem":1},{"lineBreak":true},{"text":"karipan tamapari ashirusin wazuraneewtaa taarangsin,","poem":1},{"lineBreak":true},{"text":"ashiritaa anoo tpachingarangina.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sheeruri, siyaatssha Ijiptoo tsap tashitungayaruri,","poem":1},{"lineBreak":true},{"text":"apusap machiranguri, amb cuarenta masach maarangis,","poem":1},{"lineBreak":true},{"text":"anush nuw siyaa ksutarangina.","poem":1},{"lineBreak":true},{"text":"Amorrewshuchee tputs watsapun itutseeruri,","poem":1},{"lineBreak":true},{"text":"siyaamsha panarangina.","poem":1},{"lineBreak":true},{"text":"Ashirangtaati, siysa nuwaa ngataksa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mishat, saana yasaksa, yuwaa nuw siyashchee nuwaa kuki kamanimaam ínarangina.","poem":1},{"lineBreak":true},{"text":"Ínarangitaati, ashiritaa, kamanimapanee kuk nda mazinamaam zandkus,","poem":1},{"lineBreak":true},{"text":"tayaspatamaam pachindarangsa.","poem":1},{"lineBreak":true},{"text":"Tputseetssha Nasareyupani yuw vinoo waamaam pinasakana,","poem":1},{"lineBreak":true},{"text":"anootstam zanganirangtaati,","poem":1},{"lineBreak":true},{"text":"itaru siysa ashiritaa, Nasareyupaneetssha tumisingayarus, yarsarangsa.","poem":1},{"lineBreak":true},"Nuw anoo zurampatari atina."]},{"type":"verse","number":13,"content":[{"text":"Ashirucha, anumand tsapootssha ishipukchuri, kutsis táchatssa.","poem":1},{"lineBreak":true},{"text":"Ashkachu, mantsir yusachiya.","poem":1},{"lineBreak":true},{"text":"Wakar pshiyrshishush tirikoo kayak pshtaru, naakchu,","poem":1},{"lineBreak":true},{"text":"iship iship ashku mantsir yusataru","poem":1},{"lineBreak":true},{"text":"ashiritam mantsir tsap yusachiya.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tputs kizpuritaati iripumaam yasaru, nda anoo kapachina.","poem":1},{"lineBreak":true},{"text":"Wizpureew taakana antaatiya anush wizpur pshatakchu,","poem":1},{"lineBreak":true},{"text":"nda waanaatsi tapachindachiya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tputs tapazpantaati, itaru waanaatsi tapachindacheeja, ndambari.","poem":1},{"lineBreak":true},{"text":"Tputs wamaritaati ichingaru iripumpa kasiru,","poem":1},{"lineBreak":true},{"text":"misha kapaachimuntaatiya suwayaranllu, kamungcheeja, ndambari.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yuwash nuwaana siyaa wanimaam ashkachi,","poem":1},{"lineBreak":true},{"text":"anush tputs kizpur pachamaam yasarangitaa,","poem":1},{"lineBreak":true},{"text":"punikchusin, uru k'chirpungurinee kapeetanganllu,","poem":1},{"lineBreak":true},{"text":"zapeeru suwakchu iripunganchiya,","poem":1},{"lineBreak":true},"Apanll Israelchichee tárangiya."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}