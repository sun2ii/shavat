{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Nuw Isáysi Apanllee kuk kamanchintspa. Nuw apari Amoscha. Apanll nuwaa yámandarangiya yuwaa Utaáchchee wanichu anootsi. Yuwapur Osiyas, Jotantam, Ajastam, Esikiyastam kurak taarangana anpur Apanll nuwaa tsiyatarangu, anoo kamanchintspa."]},{"type":"heading","content":["Utaáchchis, siy uru yutaritshishee kis chinaksa, nuw siyaa waneekuri atina"]},{"type":"verse","number":2,"content":[{"text":"Tsapurunasshuchis, kanindshuchtamtis ichingurus,","poem":1},{"lineBreak":true},{"text":"Apanllee kuk mazinangtsa. Apanll ateeja:","poem":1},{"lineBreak":true},{"text":"Nuw tputsireetsi ipareepzi ashiru yanungakuri,","poem":1},{"text":"siy kis kanungarangsa.","poem":2},{"text":"Ashiritaa, tputsirshti nuwaa natsarangusin, nuwaa kasaranganaya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Antaati wakar wamkuree kuk nda mazinak?","poem":1},{"lineBreak":true},{"text":"¿Antaati burr minush tputs pang' watungasheem nachungak? Nda.","poem":1},{"lineBreak":true},{"text":"Chinuz mang' ndunaritaa, mangoonkiya.","poem":1},{"lineBreak":true},{"text":"Itaru, nuw tputsiri mangsharitssincha.","poem":1},{"lineBreak":true},{"text":"Nuwaa nda pakchiyam chinakana; nda mangoonkana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¿Nuw siyaa yutaritshishpaneetsis tamaycheezi?","poem":1},{"lineBreak":true},{"text":"Siy yutaritshisheetsimari uru chinaksa.","poem":1},{"lineBreak":true},{"text":"¡Siy shuchitampazis wipis ashirus yutaritshisheetsim kis chinaksa!","poem":1},{"lineBreak":true},{"text":"Nuwaatssha Taarashipaneetsi arap kasarangsa.","poem":1},{"lineBreak":true},{"text":"Nuw Apanlli siyaam Israelaamis taaritaati,","poem":1},{"lineBreak":true},{"text":"ashiritaa siy nuwaa wanllitarangsa.","poem":1},{"lineBreak":true},{"text":"Nuw siyaa kizpur chinarangitaati,","poem":1},{"lineBreak":true},{"text":"ashiritaa siysa nuwaa natsaksa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Mangishis nuwaa kapeetamaam chinachintar ashiksa!","poem":1},{"lineBreak":true},{"text":"Nuw siyaa kapungtaa pzkookpaz ashiruri,","poem":1},{"lineBreak":true},{"text":"siyaa waniwantar ashkitaati,","poem":1},{"lineBreak":true},{"text":"ashiritaa, nda siy kitsis mazinaksa.","poem":1},{"lineBreak":true},{"text":"Muchis chuwimpaz ashiksa.","poem":1},{"lineBreak":true},{"text":"Kapung tanukus, wizpuris ndunnaar taaksa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nutsis kpumawpaz ashirus ashchiri shuneekiya.","poem":1},{"lineBreak":true},{"text":"Nda pakchiyam matambish taaksa.","poem":1},{"lineBreak":true},{"text":"K'tsimandis káyaru, muchipis wásur shuneekiya.","poem":1},{"lineBreak":true},{"text":"Kpumaris, kuchakpaz ashiru kpuneekiya.","poem":1},{"lineBreak":true},{"text":"Minamtiyam tputs siyaa nda istaku,","poem":1},{"lineBreak":true},{"text":"irimiyapat taparat, taparat nda ashkiya,","poem":1},{"lineBreak":true},{"text":"wásuree mayungamaama.","poem":1},{"lineBreak":true},{"text":"Ashikpaz ashkitaatis, nda kitsis mazinakus, yutaritshishee kis chinaksa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nuw siyaa waneektaati, itaru siysa nuwaa kuki nda payukus,","poem":1},{"lineBreak":true},{"text":"kundararis siyaa kachingeersin, tsapuneetsis itutskachu,","poem":1},{"lineBreak":true},{"text":"Mzarshitis mangutarisha taakiya.","poem":1},{"lineBreak":true},{"text":"Ashkus, tatsumaris mangutarit itsankiya.","poem":1},{"lineBreak":true},{"text":"Siyaa pangis tirooksin, yaktaris mzeeztar ashkiya.","poem":1},{"lineBreak":true},{"text":"Saanasha anoo ngutis napataranll ashiksa.","poem":1},{"lineBreak":true},{"text":"Kundararis tatsumareetsis kis shamangayarusin,","poem":1},{"lineBreak":true},{"text":"katungkusin, kaching, kaching ashkanaya.","poem":1},{"lineBreak":true},{"text":"Sodomshuch tamarangpari ashiritam tsapunis mangu kuree ashkiya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kundararis siyaa pacharangusin,","poem":1},{"lineBreak":true},{"text":"Siyonshuchis minamaritis katuchim taaksa.","poem":1},{"lineBreak":true},{"text":"Na kundararis siyaam tsangakanaya.","poem":1},{"lineBreak":true},{"text":"Siyonshuchis yakat tambpaz ashiru mzatsip upusanand xiyaa ashkiya.","poem":1},{"lineBreak":true},{"text":"Sundarshat kachingamamari iturpipitaraa, iturpipitaraa ashishtangat ashkanaya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kundararis ashirangtaa, nuw wizpurirpati,","poem":1},{"lineBreak":true},{"text":"nuwamari kasiyeeruri,","poem":1},{"lineBreak":true},{"text":"siyaa Utaáchcheetsis nayaniranguri,","poem":1},{"lineBreak":true},{"text":"nda siy musá tsiparangsa.","poem":1},{"lineBreak":true},{"text":"Ndunnaari siyaa istaranguri,","poem":1},{"lineBreak":true},{"text":"Sodomaa, Gomorshuchee tamarangpari sheernapsinaya siyaa izuuru kachingaranganaya.","poem":1},{"noteId":0},{"lineBreak":true},"Apanll áttanda tángcha, tárangiya nuwaatsi. Ashiriya, yutaritshishirimandis Apanllsha siyaa kapung waneekiya, nuw siyaa atina."]},{"type":"heading","content":["Anoomcha, Apanllee zurumpatari chinangtsa, nuw siyaa atashina"]},{"type":"verse","number":10,"content":[{"text":"Siy kurakis Sodomshuch tamapari ashirus mantsir taakis anis,","poem":1},{"text":"Apanllee kuk kaapaniri mazinangtsa.","poem":2},{"text":"Siy tputsis Gomorshuch tamapari ashirus yutarit taakis anis,","poem":1},{"text":"kitsis zurampatari mazinangtsa.","poem":2},{"text":"Apanll siyaa tayaspataku, anoo ngatintspa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Apanll Taarashipan ateeja:",{"text":"¿Mayaamsa nuwaam maachee zapan wayaksa?","poem":1},{"lineBreak":true},{"text":"Opeejaa, wakaraatstam karupana, nuwaam wayayarus, muchkis,","poem":1},{"lineBreak":true},{"text":"anoo nuw kapung tsachiktana.","poem":1},{"lineBreak":true},{"text":"¿Antaati wayungunoo muchkis, anoo nuw ksaja ishingchee?","poem":1},{"lineBreak":true},{"text":"¿Maacheetsi ursir ksatamtaja napkee?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Siy nuwash pangi kuseerus,","poem":1},{"lineBreak":true},{"text":"maacheetsi nuwaam yushindaktaateesa,","poem":1},{"lineBreak":true},{"text":"itaru, ¿chak siyaa, ngutis Apanllish pang' xitangtsa, táranlla?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nuwaam maachee ngutis wayarintspa.","poem":1},{"lineBreak":true},{"text":"Watam an msas nuwaam nda wanasiriwa.","poem":1},{"lineBreak":true},{"text":"Tputsee tushaneeyarus,","poem":1},{"lineBreak":true},{"text":"Tsup kaneeschish shambateeni, atitaateesa,","poem":1},{"lineBreak":true},{"text":"Zar kanusishush tushiyani, atitaateesa,","poem":1},{"lineBreak":true},{"text":"itaru wand yutaritshishee kis payuksa.","poem":1},{"lineBreak":true},{"text":"¿Antaati nuw piy shingtsa, tárangee?","poem":1},{"lineBreak":true},{"text":"Anoo pamaam zandkeezi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tsup kaneeschish yakchu anush shaniykis,","poem":1},{"lineBreak":true},{"text":"anoo nuw ksaja napkee.","poem":1},{"lineBreak":true},{"text":"¿Wanip ngutis ashiksa?","poem":1},{"lineBreak":true},{"text":"¡Wappa! Anoo zandkeezi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Siy nuwaa mashamaam kuweetsis íwar itsirkachis,","poem":1},{"noteId":1},{"lineBreak":true},{"text":"anoo nuw pamaam zandkeezi.","poem":1},{"lineBreak":true},{"text":"Zapantaa nuwaa mashkus,","poem":1},{"lineBreak":true},{"text":"ashiritaa siyaa nda mazinakina.","poem":1},{"lineBreak":true},{"text":"Watam kuwis tputs ursir paxatasawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"¡Watsta! Yutaritshishireetsis ksangtsa.","poem":1},{"lineBreak":true},{"text":"¿Antaati siyaa yutaritshishireetsis nuw kis napkee?","poem":1},{"lineBreak":true},{"text":"¡Yutaritshishireetsis zurampatari ksangtsa!","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Wanasiriri taangtsa. Anoori chinangtsa.","poem":1},{"lineBreak":true},{"text":"Itsinsaru taangtsa. Tputsee chinangtsa.","poem":1},{"lineBreak":true},{"text":"Saanpatatis istangtsa.","poem":1},{"lineBreak":true},{"text":"Mxaxzeewaa nayaningtsa.","poem":1},{"lineBreak":true},{"text":"Mashindoo tayutaritarinllpa,","poem":1},{"lineBreak":true},"Apanlli siyaa Utaáchcheetsis tárangiya."]},{"type":"verse","number":18,"content":[{"text":"Apanll átcha:","poem":1},{"lineBreak":true},{"text":"Mazinangandama. Na tsiyatssee wanasir yareeni.","poem":1},{"lineBreak":true},{"text":"Wandaya siy yutaritshishiris kuraspaz ashiru kizpur chumbeep paxataru,","poem":1},{"lineBreak":true},{"text":"ashiritaa nuw tachingkachuri, kizpur mburash taatssa.","poem":1},{"lineBreak":true},{"text":"Kachizamash tamapari ashiru mburash taatssa.","poem":1},{"lineBreak":true},{"text":"Mishat, kamis kizpur kawambanataa, itaru opeej pur tamapari ashirisha mburash taachiya.","poem":1},{"lineBreak":true},{"text":"Nuw siyaa yutaritshishireetsis tachingkachuri, amb ashikpaz ashtatssa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wandaya siy nuwaa kuki payukchus,","poem":1},{"lineBreak":true},{"text":"yusur mzarshis yuwariz kisshaparee kanungchiya.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wandaya kitsis nda mazinakus,","poem":1},{"lineBreak":true},{"text":"kundararis waani shamangayarusin, siyaa kiyung yachachintsa.","poem":1},{"lineBreak":true},{"text":"Nuw Apanlli siyaa atina,","poem":1},{"lineBreak":true},"Apanll waana nuwaa tárangiya. Ashirucha, Apanllee zurumpatari chinangtsa, nuw Isáysi siyaa atashina."]},{"type":"heading","content":["Waana Apanll Taarashipan Irusarinshucheetsis izuuru yarchiya"]},{"type":"verse","number":21,"content":[{"text":"Siy Irusarinshuchis, sirú Apanllee chinarangitaatis,","poem":1},{"lineBreak":true},{"text":"itaru natsha ¿tamaysha kiz mshipan tamaparee ashirus nuwaa kasarangus, kis apanllputsush tachitaksa?","poem":1},{"lineBreak":true},{"text":"Sirútari siy tputsis ashparitis itsinsaru taarangus,","poem":1},{"lineBreak":true},{"text":"tputsee zurampatari tatsamooru istarangsa.","poem":1},{"lineBreak":true},{"text":"Ashirangtaatis, itaru natsha pachampaniri taaksa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Sirú siy ur tamapari ashirus wanasir taarangsa.","poem":1},{"lineBreak":true},{"text":"Itaru, natsha chkaz tamapari ashirus kinarangsa.","poem":1},{"lineBreak":true},{"text":"Kapusis kam ashirus taarangtaatis,","poem":1},{"lineBreak":true},{"text":"itaru na kizpur misingapishpaz ashirus kinarangsa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Siy kurakaris na wits nda mazinaksin,","poem":1},{"lineBreak":true},{"text":"washchirpat tputsi kis amikurtakanaya.","poem":1},{"lineBreak":true},{"text":"Kurikingazim chinaksin, tputsee nda itsinsaru chinakanaya.","poem":1},{"lineBreak":true},{"text":"Maachtangazimari támaraksin, mantsir chinakanaya.","poem":1},{"lineBreak":true},{"text":"Mxaxzee nda nayaniksin,","poem":1},{"lineBreak":true},{"text":"Mashindootstam nduntam pakchiyam istakanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":["Yuwamand siy Utaáchchis yutarit taakis anumand, Apanll Taarashipan, yuw wamari kasiru an atiya.",{"lineBreak":true},{"text":"¡Wapparita! Na siyaa kundartaranguri, wanichintspa,","poem":1},{"lineBreak":true},{"text":"Yuwaa tumashtakis anoo tuwapamaama.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nuw kuwipti wizpurirpati, siyaa wanichima.","poem":1},{"lineBreak":true},{"text":"Chkazeetspaz ashiru izuuru kapeetchintspa.","poem":1},{"lineBreak":true},{"text":"Yutaritshishireetsis ashparit kachingchima.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ashkachuri, yusur shiyashuchsha yasampan tputsee tatsamooru chinachinllinaya.","poem":1},{"lineBreak":true},{"text":"Kuraksha wipunash yusur wanasir kamanchinllinaya.","poem":1},{"lineBreak":true},{"text":"Amb ashkachuri, tputssha siyaa wanasir ínachinllinaya.","poem":1},{"lineBreak":true},{"text":"Siyaa Irusarinshucheetsis, Yakat itsinsampancha;","poem":1},{"lineBreak":true},{"text":"apanllpancha, siyaa táchinllinaya.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nuw siyaa itsinsari yasayaruri, tapachindakchuri,","poem":1},{"lineBreak":true},{"text":"siysa yusur kis taatssa.","poem":1},{"lineBreak":true},{"text":"Siy Siyonshuchis, yusur nuwash kis tachitatssa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Itaru, yutaritshishpan tputs nuwaa nda chinaku,","poem":1},{"lineBreak":true},{"text":"nuwsha anoo tputs toro, toro sheeruri kapeetchima.","poem":1},{"lineBreak":true},{"text":"Nuwaa kuki kapeetkusin, zurampatari tsipachinllinaya.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ashirucha, nuw siyaa atashina:","poem":1},{"lineBreak":true},{"text":"Siy apanllputseem zapan kis nashamangamaam chapoom yanungarangsa.","poem":1},{"lineBreak":true},{"text":"Anush kis apanllputsee ungirtarangsa.","poem":1},{"lineBreak":true},{"text":"Itaru, anumand kapung pazichpasa.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Pazikchus, tatsumimpaz ashirus mawirutssa.","poem":1},{"lineBreak":true},{"text":"Kung ndunpaz ashirus puzataraa ashitssa.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Tputs kizpurimuntaa taarangu,","poem":1},{"lineBreak":true},{"text":"itaru mashar puz ashiru kurachiya.","poem":1},{"lineBreak":true},{"text":"An tputs wanasirimshingaz nazandku,","poem":1},{"lineBreak":true},{"text":"yuw tarawztarangu an, mikeeru kurakchu machingchiya.","poem":1},{"lineBreak":true},{"text":"¿Tamareeja anoo ztazchich?","poem":1},{"lineBreak":true},{"text":"¿Chakaja anoo tputs istach?","poem":1},{"lineBreak":true},"Apanll átcha tángcha, nuwaa tárangiya. Ashirucha, waana Apanll Taarashipan Irusarinshucheetsis izuuru yarachshapari, nuw Isáysi siyaa atashina."]}],"footnotes":[{"noteId":0,"caller":"*","text":"Yuwaa nish átu anootstam Romshucheema 9.29 tayusima kamankiya.","reference":{"chapter":1,"verse":9}},{"noteId":1,"caller":"*","text":"Matiwa 6.5 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/cbu_wbt/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":31}