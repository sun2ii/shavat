{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":14,"content":[{"type":"heading","content":["Israelchich tputs Babiloniyshuchee urkari kizpur stachinllinaya"]},{"type":"verse","number":3,"content":["Siy Israelchichis, mazinangtsa. Apanll iyaa kizpur tapachindachiya. Ashkachu, ndusha kiyung kachiychiniya. Tputssha nduntam iyaa tumuchchurtachinlliniya."]},{"type":"verse","number":4,"content":["Anpursha iy Babiloniyshuchee urkari stachiniya. Stakurini, yaseesshee kis yasichiniya."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apanll Babiloniyshuchee urkar kapeetarangiya.","poem":1},{"lineBreak":true},{"text":"Nimun arapcheewaa tputs yusur nda kiyung yachachiya.","poem":1},{"lineBreak":true},{"text":"Yuw tputsee pakchiyam nda nayanirangu, an kurak na pastarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Na tsapurunasshuch tputs ichingarusin mapiyrshapsinaya taachinllinaya.","poem":1},"Mang' kis yasiyastar ashchinllinaya."]},{"type":"verse","number":8,"content":[{"text":"Shiy Babiloniyshuchish kurakish na tsiparangush, Libanshuchee wárpanari nda","poem":1},{"lineBreak":true},{"text":"tuwakush, karipansha","poem":1},{"lineBreak":true},{"text":"ksatam taachiya. Apanll shiyaa","poem":1},{"lineBreak":true},{"text":"Babiloniyshucheetsish kurakish na waneerangiya.","poem":1},{"lineBreak":true},{"text":"¿Antaati shiy karipanaa na yusur tuwakush kiyung yachacheezish? Ndambari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kanizpitam naatarangush, amb kaniz shiyaa paksin, zamangachinllinaya.","poem":1},{"lineBreak":true},{"text":"Maamaartaatssin, támeersin,","poem":1},{"lineBreak":true},{"text":"shiyaa paksin, shitungartakanaya.","poem":1},{"lineBreak":true},{"text":"Kaniz urkareew ashparit uxinashee kasayarusin,","poem":1},{"lineBreak":true},{"text":"shiyaa chamayangakanaya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Shiyaa chamayangayarusin, atanaya:","poem":1},{"lineBreak":true},{"text":"Na shiy wizpurirish nduneerangu,","poem":1},{"lineBreak":true},{"text":"ningeem kanizshutam kusarangsha.","poem":1},{"lineBreak":true},{"text":"Iy tsiparangini, shiy ashiritamtish tsiparangsha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ngutish ungareem taarangush, itaru natunaa mantsirishtam taakamatsha.","poem":1},{"lineBreak":true},{"text":"Mangish kis kitarpa michitarangush,","poem":1},{"lineBreak":true},{"text":"natsha mbich shiyaa nutseetsish katungkana.","poem":1},{"lineBreak":true},{"text":"¿Tamaysha shiy kizpuritaatish ashirangsha?","poem":1},{"lineBreak":true},"kaniz staksin atanaya shiyaatsi."]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Babiloniyshucheetsish kurakish, nuw shiyaa atashina.","poem":1},{"lineBreak":true},{"text":"Kizpuritaa taarangush, shiyamari tsapurunasshchee kasirangsha.","poem":1},{"lineBreak":true},{"text":"¿Tamaysha shiy kanindash kizpuritaa taarangush,","poem":1},{"lineBreak":true},{"text":"natsha tsapush pantsarangsha?","poem":1},{"noteId":12},{"lineBreak":true},{"text":"Shiy, Nuw Apanll tamaparee ashiruri kizpur taakina, tárangitaatish,","poem":1},{"lineBreak":true},{"text":"itaru natsha pantsatataraa ashirangsha.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Itaru, shiy tárangimandish:","poem":1},{"lineBreak":true},{"text":"Nuwamari kanindap káreeruri,","poem":1},{"lineBreak":true},{"text":"anush tsirari mbam wayayaruri, anumun nuw kuxinxinaw ashtachima.","poem":1},{"lineBreak":true},{"text":"Amb ashkachuri, Apanll tínamarini, tsangachtam ichingaru tsapush taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Machimun apanlleeruri, Apanllpa ipuneeruri, taachina.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Msasee arang káreeruri,","poem":1},{"lineBreak":true},{"text":"Apanllpaz ashiruri kizpur kurakaam kinachima,","poem":1},"tárangsha."]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Itaru, na ¿tamasha ashirangsha?","poem":1},{"lineBreak":true},{"text":"Waj, Apanll shiyaa tsapush kapeetarangu,","poem":1},{"lineBreak":true},{"text":"marush wantsushpaz ashiru yangakataraa ashirangush,","poem":1},{"lineBreak":true},{"text":"kanizshutam taaksha.","poem":1},{"noteId":13}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tputs shiyaa atusin,","poem":1},{"lineBreak":true},{"text":"mangu napataranll ashkanaya.","poem":1},{"lineBreak":true},{"text":"Pakchusin, shiyaa atanaya:","poem":1},{"lineBreak":true},{"text":"¿Chak in ashtar?","poem":1},{"lineBreak":true},{"text":"¿Ndusha yuw tputs tsapurunasee tpuxtarangu an?","poem":1},{"lineBreak":true},{"text":"¿Ndusha tapazpan taarangu,","poem":1},{"lineBreak":true},{"text":"wamarisha kasirangu, nda an?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sirú yaktaa kapeetarangush,","poem":1},{"lineBreak":true},{"text":"tsapunandari taarangu,","poem":1},{"lineBreak":true},{"text":"Tputsee tumanarangush, tashitungamaam nda zandarangish.","poem":1},{"lineBreak":true},{"text":"¿Antaati shiy wattish? Ndambaree.","poem":1},{"lineBreak":true},{"text":"Itaru na ¿tamaru taaka?","poem":1},"Tputs shiyaa atanaya.",{"lineBreak":true},"Nuw shiyaa Israelshucheetsis Babiloniyshuchee urkari kizpur stakus tángtsa tina."]}],"footnotes":[{"noteId":12,"caller":"*","text":"Apanll wanichu anu 9.1 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":14,"verse":12}},{"noteId":13,"caller":"*","text":"Matiwa 11.23; Lukasa 10.15 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":14,"verse":15}}]},"thisChapterLink":"/api/cbu_wbt/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":14}