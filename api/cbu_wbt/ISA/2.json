{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":2,"content":[{"type":"heading","content":["Apanll Taarashipansha istakchu, tsapurunasush ztaru tputs mapiyrsin taachinllinaya"]},{"type":"verse","number":1,"content":["Nuw Isáysi Apanllee kuk kamanchintspa. Nuw apari Amoscha. Apanll waana nuwaa yámandarangiya. Yuwaa Utaáchchee, Irusarinshucheetstam tputs ashtachu anoo kamanchintspa. Apanll waana tárangiya:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yap tsapurunas tspakattu amb,","poem":1},{"lineBreak":true},{"text":"nuwsha Irusarinaa yakat mbamari wayachima.","poem":1},{"lineBreak":true},{"text":"Anush nuw pangi kizpur taachiya.","poem":1},{"lineBreak":true},{"text":"Anu mach íwar pshkurutar ashku taachiya.","poem":1},{"lineBreak":true},{"text":"Minup mach ningich taachiya.","poem":1},{"lineBreak":true},{"text":"Amb ashkachuri, tsapurunasshuchsha tputs ichingarusin anush kuschinllinaya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tputs amb naakchusin, shurungakataraa sheersin,","poem":1},{"lineBreak":true},{"text":"waanpatatin táchinllinaya:","poem":1},{"lineBreak":true},{"text":"Pzaya. Apanllip machip káreeruni,","poem":1},{"lineBreak":true},{"text":"Akoparinshini Apanllirini pang' pshtuyani.","poem":1},{"lineBreak":true},{"text":"Amb ashkachuni, waana Apanll iyaa tayaspatachiya.","poem":1},{"lineBreak":true},{"text":"Waa kuk mazinaruni,","poem":1},{"lineBreak":true},{"text":"Apanllish kissha tachiteeni, táchinllinaya.","poem":1},{"lineBreak":true},{"text":"Anushsha Siyonamand Apanllee Taarashipanee kuk tayaspatachinllinaya.","poem":1},{"lineBreak":true},{"text":"Irusarinamand Apanllee kuk mazinachtamanaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apanllsha Taarashipan tsapurunasee tputs itsinsar yasachiya.","poem":1},{"lineBreak":true},{"text":"Tputs waanpatatin tsiyatssee mantsir payukinaareesinaya,","poem":1},{"lineBreak":true},{"text":"Taarashipansha waana tsiyatssee yarchiya.","poem":1},{"lineBreak":true},{"text":"Anpur, ayamtaatiya tputs waanpatatin waratchazinllinaja.","poem":1},{"lineBreak":true},{"text":"Tapazeetstam waanpatatin nda tayaspatachinllinaya.","poem":1},{"lineBreak":true},{"text":"K'chirpungoo mangutarisha payuchinllinaya.","poem":1},{"lineBreak":true},{"text":"M'chitaatssha waratamapani mázareemsha tatsummapaneem ínachinllinaya.","poem":1},{"lineBreak":true},{"text":"Turuwaatssha wareemsha ínachinllinaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Akoparinchichis, ¿mayaamsha kiyung kachiyatssa?","poem":1},{"lineBreak":true},{"text":"¡Wanasir itsinsar taayani! Waana Apanll Taarashipan iyaa 'sineekpaz ashkachu, kis taapani, atina.","poem":1},{"lineBreak":true},"Ashiriya, Apanll Taarashipansha ayam iyaa istakachu, tsapurunasush ztaru tputs mapiyrshtisin taachinllinaya, nuw siyaa atina."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":5}