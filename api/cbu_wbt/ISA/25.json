{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":25,"content":[{"type":"heading","content":["Apanll tsapurunasshuchee tputs ztaru shambatamaama yambichiya"]},{"type":"verse","number":6,"content":[{"text":"Apanll wamari kasiru,","poem":1},{"lineBreak":true},{"text":"nish Irusarinush shambatshisheem wayachiya.","poem":1},{"lineBreak":true},{"text":"Ztaru tputsee tsapurunasshuchi katungamaam yambichiya.","poem":1},{"lineBreak":true},{"text":"Anush katungats kizpur wanasir wayachiya.","poem":1},{"lineBreak":true},{"text":"Tputs kisshapari katungchinllinaya.","poem":1},{"lineBreak":true},{"text":"Katungkusin, ksatam vinoo waachinllinaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Anush Apanll kizpur istakachu,","poem":1},{"lineBreak":true},{"text":"ksushish ndunshapari taachchi.","poem":1},{"lineBreak":true},{"text":"Ayamtaati tputs mang' nda mantsachinllinaya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tputssha ndusha tsipachinllinaya.","poem":1},{"noteId":14},{"lineBreak":true},{"text":"Suris nduntam taachiya.","poem":1},{"noteId":15},{"lineBreak":true},{"text":"Apanllee tiptsir nduntam pazichinllinaya.","poem":1},{"lineBreak":true},{"text":"¿Chakaja mantsiri tsiyatach?","poem":1},{"lineBreak":true},{"text":"Anush tputs mang' kis taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Tputs anoo tsiyatkusin,","poem":1},{"lineBreak":true},{"text":"In watacha iy Aparini.","poem":1},{"lineBreak":true},{"text":"Waamun mangini taturanguni,","poem":1},{"lineBreak":true},{"text":"iyaa kizpur tapachindarangiya.","poem":1},{"lineBreak":true},{"text":"Ashirucha, mangini kis, ¡Jay, jay táyani! atashina.","poem":1},{"lineBreak":true},{"text":"Watam Apanll iyaa tapachindaranguwa,","poem":1},{"lineBreak":true},"tputs táchpasinaya.",{"lineBreak":true},"Apanll zurampatari ashtachiya, watam waana ashtachima táranguwa, nuw Isáysi siyaa atina."]}],"footnotes":[{"noteId":14,"caller":"*","text":"-9 1 Koríndshucheema 15.26, 54 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":25,"verse":8}},{"noteId":15,"caller":"*","text":"-9 Apanll wanichu anu 7.17; 21.4 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":25,"verse":8}}]},"thisChapterLink":"/api/cbu_wbt/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":3}