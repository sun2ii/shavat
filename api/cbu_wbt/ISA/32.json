{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":32,"content":[{"type":"heading","content":["Kurak wanasirimish Apanllee tiptsiri ksutchiya"]},{"type":"verse","number":1,"content":["Nuw Isáysi arangeem Apanllee kuk kamankina.",{"lineBreak":true},{"text":"Yuwash waritakchu anush, kurak wanasirimash nuwaa tputsiri ksutchiya.","poem":1},{"lineBreak":true},{"text":"Kuraka wipunashpatari wanasirinandari ksutchiya.","poem":1},{"lineBreak":true},{"text":"Tputsee ichingaru tatsamooru napchiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tputs kiyung kachiykana, anoo tapachindachiya.","poem":1},{"lineBreak":true},{"text":"Undararsha, Pachapani atitaatssin,","poem":1},{"lineBreak":true},{"text":"kuraksha tiptsiree tapachindachiya.","poem":1},{"lineBreak":true},{"text":"Mantsirimish tushiykchu, uwsha istachiya.","poem":1},{"lineBreak":true},{"text":"Waanpatatin shuchimaam ndunshaparee chinachinllinaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kuraksha uru wanasir napchiya.","poem":1},{"lineBreak":true},{"text":"Tiptsirsha, Papcha. Tputs nuwaa kiyung yachakachpa, tákchusin,","poem":1},{"lineBreak":true},{"text":"kuraksha mazinakchu, wanasir istachiya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mang' putitiri, itsinsaru chinachiya.","poem":1},{"lineBreak":true},{"text":"Zurampatari tsiyatchiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yuw tputs yutaritshishpan taakana, misha tputsee kiyung yachakana anoo,","poem":1},{"lineBreak":true},{"text":"ndusha kurak kis napchiya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"An tputs yutaritcha.","poem":1},{"lineBreak":true},{"text":"Watam tsiyatkusin, mantsir tsiyatkanawa.","poem":1},{"lineBreak":true},{"text":"Tputsee kiyung yachamaam chinakanaya.","poem":1},{"lineBreak":true},{"text":"Tputsee pachamaam zandkanaya.","poem":1},{"lineBreak":true},{"text":"Tputs mariz kayatkana, anoo","poem":1},{"lineBreak":true},{"text":"¿nitaati pakchiyam nayanikazinllinaja?","poem":1},{"lineBreak":true},{"text":"Katungtsee nda panakanaya: waamaamtam nda yáskanaya.","poem":1},{"lineBreak":true},{"text":"Mishat, ¿Antaati yuwaa nuw ngichki anoo Apanll yasakeeja? atanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"An tputs kizpur ngichimapancha.","poem":1},{"lineBreak":true},{"text":"Mangush chinachintar ashkusin,","poem":1},{"lineBreak":true},{"text":"tputsee kiyung yachamaam chinakanaya.","poem":1},{"lineBreak":true},{"text":"Pukiree tputs nduntam pakchiyam istakanaya.","poem":1},{"lineBreak":true},{"text":"Kiyung kachiykana anoo nda nayanikanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Itaru, wanasirimashsha tputs nda ashkanaya.","poem":1},{"lineBreak":true},{"text":"Wanasirimsheetsimari chinakanaya.","poem":1},{"lineBreak":true},{"text":"Tputsee itsinsaru napkanaya.","poem":1},{"lineBreak":true},{"text":"Anumun mangich tatkuch, ndusha chiyaa tamapingachiya.","poem":1},{"lineBreak":true},"Mishat, nuw kizaatstamtis arangeem waneekina."]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nuw siyaa kizaatsis waneekuri, atashina, Mazinangandama.","poem":1},{"lineBreak":true},{"text":"¿Mayaamsa kizis siy piyari chinaksa?","poem":1},{"lineBreak":true},{"text":"Siy naturi mapiyrus taaksa.","poem":1},{"lineBreak":true},{"text":"Kaapa nuwaa kuki mazinangtsa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iyaam ichingaru wanasircha, átpasa.","poem":1},"Itaru, nuw siyaa atashina:",{"lineBreak":true},{"text":"Nduma in masach tushiyru,","poem":1},{"lineBreak":true},{"text":"kizpur punikus, nutsis ta ta ashitssa.","poem":1},{"lineBreak":true},{"text":"Watam marizimun tsipatssawa.","poem":1},{"lineBreak":true},{"text":"Waamaamtam ndunarichuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Mangoonpana aturi, siyaa tsiyatssee tayuschima.",{"lineBreak":true},{"text":"¿Mayaamsa piyari chinaksa?","poem":1},{"lineBreak":true},{"text":"Siy naturi mapiyrus taaksa.","poem":1},{"lineBreak":true},{"text":"Itaru, zapish kizpur punikus, nutsis ta ta ashitssa.","poem":1},{"lineBreak":true},{"text":"Punikus, kamareetsis wanasirimshee kasayarus,","poem":1},{"lineBreak":true},{"text":"chirik' kamartatssa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kchishis suris xuwat xuwat ashkachus,","poem":1},{"lineBreak":true},{"text":"yuwaa áti anoo pangatssa.","poem":1},{"lineBreak":true},{"text":"Mzareetsis, tirikootstam, kizarunaatstam,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"pangeetstamtis, anoo ichingaru kapeetamaw pangatssa.","poem":1},{"lineBreak":true},{"text":"¿Waninll anumun mangis kis taarangsawa?","poem":1},{"lineBreak":true},{"text":"Itaru, nimun an ichingaru karutamunaam kinachiya.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yaktash Irusarinush yuwash nuw taarangi anush tputs tatsitaritaa taarangu,","poem":1},{"lineBreak":true},{"text":"itaru, nimun uru kurimunazshapari taachiya.","poem":1},{"lineBreak":true},{"text":"Kurak pang' kurimunaztam taachiya.","poem":1},{"lineBreak":true},{"text":"Sundar ksutamapan kuree ashchiya.","poem":1},{"lineBreak":true},{"text":"Irusarin izuuru kurimunazkachu, burr kayustan anush kis taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Mangu pastoomarisha kinachiya,","poem":1},{"lineBreak":true},"nuw siyaa kizaatsis atina."]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Itaru, Apanllsha iyaa istakchu, waana wani wizpuriri zangankachu, iyaa istachiya.","poem":1},{"lineBreak":true},{"text":"Waana wizpuripa tsapoo puz mzareemani kizpur wanasireemashat panachiya.","poem":1},{"lineBreak":true},{"text":"Sin ndusha pishtaku, yuwariz kisshapa kanungchiya.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tputssha waanpatatin kis taaksin, waanpatatin ndusha kiyung yachachinllinaya.","poem":1},{"lineBreak":true},{"text":"Israelshuch tputs ashpari kis taachinllinaya.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kurak tputsee tatsamooru napkusin,","poem":1},{"lineBreak":true},{"text":"uru mapiyrsin taachinllinaya.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nuw tputsiri waanpatatin, Zuraktishcha tákchusin,","poem":1},{"lineBreak":true},{"text":"anumun mangich tatuchpachi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sis kizpur pantsatkachu, mangin yurangakchu,","poem":1},{"lineBreak":true},{"text":"Irusarin yusur yurangakchitaa,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ashiritaa, kis taatssa.","poem":1},{"lineBreak":true},{"text":"Mzareemis sin ndusha pishtachiya.","poem":1},{"lineBreak":true},{"text":"Chineemis pasut izapaneekchu,","poem":1},{"lineBreak":true},{"text":"chinshitish kis taachinllinaya,","poem":1},{"lineBreak":true},"Apanll nuwaa tárangiya. Ashirucha, mangis mantsarintspa. Kurak wanasirimish kuskachu, Apanllee tiptsiri uru ksutchiya, nuw siyaa atashina."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":20}