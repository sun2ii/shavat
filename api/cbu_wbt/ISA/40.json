{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":40,"content":[{"type":"heading","content":["Apanll Irusarinshuchee mangoo tusichimaam k'kuz wanasirimash tsiyatarangiya"]},{"type":"verse","number":1,"content":["Apanll waana ateeja:",{"lineBreak":true},{"text":"Israelchichee mangoo tusichimaam wanasir tsiyatangtsa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nayanimpatari Irusarinshuchee tsiyatangtsa.","poem":1},{"lineBreak":true},{"text":"Sirú m'chachumuntaa taarangsin, na tushiyanlliya.","poem":1},{"lineBreak":true},{"text":"Yuwamand yutarit taarangana anumand túmshir tuwaparanganaya.","poem":1},{"lineBreak":true},{"text":"Nuw Apanlli Israelchichee waneekuri,","poem":1},{"lineBreak":true},{"text":"kuwipti pzkoorangina.","poem":1},{"lineBreak":true},{"text":"Yutaritshishimand wappari kiyung yacharangina.","poem":1},{"noteId":16}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wanimaam na iwaparanguri,","poem":1},{"lineBreak":true},{"text":"natunaa tputs tayaspatakchu anoo kisshapari mazinachinllinaya.","poem":1},{"lineBreak":true},{"text":"Mazinangtsa. Na kurak kizpur naanllpa.","poem":1},{"lineBreak":true},{"text":"Tsap puzaa ngootseem wanasir yarangtsa.","poem":1},{"lineBreak":true},{"text":"Ngootsee itsinsaru tuwitangtsa.","poem":1},{"lineBreak":true},{"text":"Apanlleem yarangtsa, watam kuschuwa.","poem":1},{"noteId":17}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wazawaa tupareerus,","poem":1},{"lineBreak":true},{"text":"machee kapeeteerus, itsinsaru tuwitangtsa.","poem":1},{"lineBreak":true},{"text":"Yuwaa machtaru anoo watandsaam ínayarus ksangtsa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apanlleem ashikpaz shingtsa mangeetsis yaramaama.","poem":1},{"lineBreak":true},{"text":"Yutaritshishireetsis kapeeteerus mangeetsis Apanlleem yarangtsa.","poem":1},{"lineBreak":true},{"text":"Ashkachus, Apanllsha Taarashipan kizpur wanasir napchintsa.","poem":1},{"lineBreak":true},{"text":"Ztaru tputs tsapurunasush Apanllee pangchinllinaya.","poem":1},{"noteId":18},{"lineBreak":true},{"text":"¿Antaati ngichkeezi áti? nda.","poem":1},"Watam waana Apanll nuwaa kamanku táranguwa."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"K'kuz íwarimand kímarangu, nuwaa, Kizpur tsiyatangi, tárangiya.","poem":1},{"lineBreak":true},{"text":"Nuwsha, Kizpur tsiyatkuri, ¿ameecheezi? tárangina.","poem":1},{"lineBreak":true},{"text":"Uwsha, Tputs ichingarusin chirichir tamapari ashiru taakanaya.","poem":1},{"lineBreak":true},{"text":"Wanuts chap ashiru musásimashcha.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waana Apanll chirichirimun tapus ashkachu,","poem":1},{"lineBreak":true},{"text":"chirichirsha mawirutaraa sheeru,","poem":1},{"lineBreak":true},{"text":"chap kurustariya.","poem":1},{"lineBreak":true},{"text":"Tputs ashiritamcha; chirichir tamaparee ashiru nda kizpur taakanaya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tputs chappaz ashiru mawiruyaru kuruschiya.","poem":1},{"lineBreak":true},{"text":"Itaru, Apanll kuk urutamari taachiya.","poem":1},{"lineBreak":true},{"text":"Uw kuk ayamtaatiya pastacheeja, ndambaree.","poem":1},{"noteId":19},{"lineBreak":true},"Apanll waana nuwaa tárangiya."]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Siy Siyonshuchis, mazinangtsa.","poem":1},{"lineBreak":true},{"text":"Machimun íwar káreerus,","poem":1},{"lineBreak":true},{"text":"anush kizpur tsiyateerus,","poem":1},{"lineBreak":true},{"text":"Utaáchich tputs ichingaru mazinaksin, anoo kamaningtsa.","poem":1},{"lineBreak":true},{"text":"Tsiyatsis kizpur wanasir kamaningtsa.","poem":1},{"lineBreak":true},{"text":"Siy Irusarinshuchis, ¿mayaamaja punirpatis tsiyatchis?","poem":1},{"lineBreak":true},{"text":"Wanasiriri nuwaa kuki kamaningtsa.","poem":1},{"lineBreak":true},{"text":"Napangtsa. Neewa. Apanll kuseenlltanda, tángtsa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Apanll kizpureeru, tapachindamaam kusarangiya.","poem":1},{"lineBreak":true},{"text":"Undararee wamari kasiyaru,","poem":1},{"lineBreak":true},{"text":"waanaatsisha tiptsir itutseeru, ksutkiya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Chinuzpan ashiru tiptsiree wanasir ksutkiya.","poem":1},{"lineBreak":true},{"text":"Tputs opeejaa wip chipayaru, mangumunari chipaypaytar ashku wanasir ksutkiya.","poem":1},{"lineBreak":true},{"text":"Opeej wipaa kaneeschiri tatsipkachu,","poem":1},{"lineBreak":true},{"text":"wanasir ksutaru,","poem":1},{"lineBreak":true},{"text":"ashiru Apanll iyaa Israelchicheetsini ksutchiya,","poem":1},"waana Apanll siyaa tárangiya."]},{"type":"heading","content":["Nuw siyaa, ¡Apanll tamara! átana"]},{"type":"verse","number":12,"content":[{"text":"¿Chakaja musá kapungumashi, maree uwpatari táchich?","poem":1},{"lineBreak":true},{"text":"¿Chakaja kanindaatstam táchich?","poem":1},{"lineBreak":true},{"text":"¿Antaati kuwiptich tách tách ashkuch yasacheezich?","poem":1},{"lineBreak":true},{"text":"¿Chak mazachee tsaparunasush ichingaru táchka?","poem":1},{"lineBreak":true},{"text":"¿Chakaja machee íwar itsireeru kayxuyach?","poem":1}]},{"type":"verse","number":13,"content":["¿Chakaja Apanllee, Shiy ngichiktishcha, tách?",{"text":"¿Chakaja Apanllee, Mangish pishtakcha; piy shingcha, táyach?","poem":1},{"noteId":20}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¿Antaati Apanll chiyaa, Istanda. Mangeetsi p'tseengandama, tácheeja?","poem":1},{"lineBreak":true},{"text":"¿Nitaati chiy Apanllee, Nuw shiyaa kamankachuri, shiysha tputsee mangu itsinsarush yasangcha, tácheezich?","poem":1},{"lineBreak":true},{"text":"¿Chakaja Apanllee, Piy shingcha maachee tinakush, tárang?","poem":1},{"lineBreak":true},{"text":"¿Yapeeja Apanll pshtuyaru, yasasshee kizpur yasarang?","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Apanll kandoozeewaa kung pakich xuwat xuwat ashishtar ashtaru,","poem":1},{"lineBreak":true},{"text":"ashiru pakiya.","poem":1},{"lineBreak":true},{"text":"Mazach tamapari ashiru pakich pakiya.","poem":1},{"lineBreak":true},{"text":"Kurakaw shaniykana,","poem":1},{"lineBreak":true},{"text":"anoo mazacheetspaz ashiru kata kata ashkiya.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Apanlleem muchimaam ¿ndusha maachee pishtachiya?","poem":1},{"lineBreak":true},{"text":"Manginush ichingaru nachungayarush,","poem":1},{"lineBreak":true},{"text":"maachee zapantaa muchta muchta ashkuch,","poem":1},{"lineBreak":true},{"text":"Apanlleem wand pishtachiya.","poem":1},{"lineBreak":true},{"text":"Sumas zapantaa yarayaruch, Apanlleem muchkuch, nda waritachiya. Ashiritaa wand pishtachiya.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tputs tsapurunasush ztaru waritarazinllinaja.","poem":1},{"lineBreak":true},{"text":"Apanlleem nda pakchiyam waritakiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Na kamaningandama.","poem":1},{"lineBreak":true},{"text":"¿Chakpataja Apanll tatsamooch?","poem":1},{"lineBreak":true},{"text":"¿Yapeeja maachee yasin tinam yáyaruch, In watacha iy Aparini, táchich?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Yasampan tputs ngusamb yáyaru,","poem":1},{"lineBreak":true},{"text":"maachee tinayaru,","poem":1},{"lineBreak":true},{"text":"orpa taparayaru,","poem":1},{"lineBreak":true},{"text":"yarangasheem wayat wayat sheeru,","poem":1},{"lineBreak":true},{"text":"kurikpat kateen tinayaru,","poem":1},{"noteId":21},{"lineBreak":true},{"text":"In watacha iy Aparini, mangu ngichkusin atanaya.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nduntaati ashiru, yasinaa nachungayaru,","poem":1},{"lineBreak":true},{"text":"karipanaa pakeeru, tputsee kamachtakiya.","poem":1},{"lineBreak":true},{"text":"Neewa. Nuwaam Apanlliri tinanda, tákchu,","poem":1},{"lineBreak":true},{"text":"tputssha tinampan tinayaru, watseem mbam pashuchchiya, nda mangu pantsamaama.","poem":1},{"lineBreak":true},{"text":"¿Antaati an chiyaa istaku istacheeja? Nduni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mangeetsis p'tsichintspa.","poem":1},{"lineBreak":true},{"text":"¿Antaati siy nda yasarangis?","poem":1},{"lineBreak":true},{"text":"¿Antaati kitsis nda mazinarangis?","poem":1},{"lineBreak":true},{"text":"¿Ndusha zitaminaris siyaa kamanirang?","poem":1},{"lineBreak":true},{"text":"¿Tsapurunasee pakus, ndusha chinakis yuwaa Apanll waana tinarangu anootsee?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"¿Apanll nishooja tsapush taak?","poem":1},{"lineBreak":true},{"text":"Apanll watsirar kanindaa kánucha.","poem":1},{"lineBreak":true},{"text":"Tsapush napku, chiyaa pchichpaz ashiru pakiya.","poem":1},{"lineBreak":true},{"text":"Waana zandku, kanindaa kamis ashishisha wayakataraa ashchiya.","poem":1},{"lineBreak":true},{"text":"Watambureempaz ashisha kamiran wayakuwa.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kurak kizpuritaa taaru, anoo kamiran kachingamaam taariya.","poem":1},{"lineBreak":true},{"text":"Tpachingakchu, ¿yapeeja yusur pangchich?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yuwat kaneeschiri kxuneeru,","poem":1},{"lineBreak":true},{"text":"Apanllsha tapuskachu, izuuru mawirukchiya.","poem":1},{"lineBreak":true},{"text":"Kambusur ashiru kambustakachu, yasin yurangat, yurangat ashikpaz sheeru kurak tsípachinllinanaya.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Apanll siyaa mashkiya.","poem":1},{"lineBreak":true},{"text":"¿Chakpataja nuw waritachi?","poem":1},{"lineBreak":true},{"text":"¿Chakaja nuwapa tatsamooch?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Kaapa kanindap napangtsa.","poem":1},{"lineBreak":true},{"text":"Amb napeerush, ¿Chakaja kanindaa tinarang? tángtsa.","poem":1},{"lineBreak":true},{"text":"Tsangacheetstam minu piyam wayat, piyam wayat sheeru,","poem":1},{"lineBreak":true},{"text":"ichingaru an surunarangiya.","poem":1},{"lineBreak":true},{"text":"¿Antaati tsangach pantsacheeja? Nda.","poem":1},{"lineBreak":true},{"text":"Apanll waanpatari wizpur mbammari wayarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ashirucha, nuw siyaa Israelchichis atashina.","poem":1},{"lineBreak":true},{"text":"¿Mayaamshtaja mangis mantsachis?","poem":1},{"lineBreak":true},{"text":"¿Mayaamsa ngutis átssa?","poem":1},{"lineBreak":true},{"text":"Apanll nuwaa mbizarangparee.","poem":1},{"lineBreak":true},{"text":"Apanll ndunpari nuwaa chinakiya.","poem":1},{"lineBreak":true},{"text":"Apanll nuwaam kapung pachindkuwa, átssa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Itaru, nuw siyaa atashina.","poem":1},{"lineBreak":true},{"text":"¿Ndusha tputs siyaa tayaspatarang?","poem":1},{"lineBreak":true},{"text":"Sirútari mazinarangpasa.","poem":1},{"lineBreak":true},{"text":"Apanll Taarashipan urutamari taarangiya.","poem":1},{"lineBreak":true},{"text":"Tsapurunasee ichingaru tinarangiya.","poem":1},{"lineBreak":true},{"text":"Maacheewaatstam ichingaru wayarangiya.","poem":1},{"lineBreak":true},{"text":"¿Antaati Apanll, Kanuschimasima, tárang?","poem":1},{"lineBreak":true},{"text":"Apanll wayasash iyapat nda waritariya.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tputs wizpur pishtakinaariya, anoo tuwizpurtakiya.","poem":1},{"lineBreak":true},{"text":"Wanguytakinaariya, anoo yarkachu, támkiya.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Tputs kanungastaa nizkanaya.","poem":1},{"lineBreak":true},{"text":"Wanuts kapungtaa taaku, itaru wand pishtakiya.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Itaru, tputs Taarashipanimun mang' tatkinaariya,","poem":1},{"lineBreak":true},{"text":"wizpur ayamtaatiyam pishtacheeja.","poem":1},{"lineBreak":true},{"text":"Yunganpaz ashirusin kis naachinllinaya.","poem":1},{"lineBreak":true},{"text":"Kapungtaa iripkusin, ndusha kanusamaam zandchinllinya.","poem":1},{"lineBreak":true},{"text":"Araptaa naakchusin, uru kis naachinllinaya,","poem":1},{"lineBreak":true},"Apanll átcha, tángcha, nuwaa tárangiya. Ashiriya, Mangoonangtsa, nuw Isáysi siyaa atina."]}],"footnotes":[{"noteId":16,"caller":"*","text":"Apanll wanichu anu 18.6 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":40,"verse":2}},{"noteId":17,"caller":"*","text":"Yuwaa nish átu anootstam Matiwa 3.3, misha Márkosa 1.3, misha Lukasa 3.4-5, misha Wanga 1.23 kamankiya.","reference":{"chapter":40,"verse":3}},{"noteId":18,"caller":"*","text":"Wanga 1.14 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":40,"verse":5}},{"noteId":19,"caller":"*","text":"Sandeeku 1.10-11 tsiyatsis nipta tatsamooru taaritamta; Yuwaa nish átu anootstam 1 Pitoru 1.24-25 tayusima kamankiya.","reference":{"chapter":40,"verse":8}},{"noteId":20,"caller":"*","text":"Yuwaa nish átu anootstam Romshucheema 11.34, misha 1 Koríndshucheema 2.16 tayusima kamankiya.","reference":{"chapter":40,"verse":13}},{"noteId":21,"caller":"*","text":"Tayaspatampani 17.29 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":40,"verse":19}}]},"thisChapterLink":"/api/cbu_wbt/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":31}