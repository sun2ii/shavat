{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":42,"content":[{"type":"heading","content":["Mishat, nuw Apanllee wipunashee kamanchintspa"]},{"type":"verse","number":1,"content":["Apanll ateeja:",{"text":"Napangtsa. In watacha nuw ipunshi kizpuri.","poem":1},{"noteId":22},{"lineBreak":true},{"text":"Nuw ipusaranguri, ksutkuri, kizpur wamun mangi kischa.","poem":1},{"noteId":23},{"lineBreak":true},{"text":"Nuwaatsi kani ipunshishi tapshtuchima.","poem":1},{"lineBreak":true},{"text":"Ashkuri, uwsha tputsee mangoo ichingarootsin itsinsaru natstachiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kizpur, Jay tácheeja.","poem":1},{"lineBreak":true},{"text":"Tsiyatku, ndusha zunganeechiya.","poem":1},{"lineBreak":true},{"text":"Yaktash nduntam tamundachiya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Watsiyunpa nda taachiya.","poem":1},{"lineBreak":true},{"text":"Tputsee iwatootspaz ipusamaatsi ashiru ndusha tzayaru kapeetchiya wanimaamaya.","poem":1},{"lineBreak":true},{"text":"Nambarin achitamari tirooyaruch, kurakurtar ashtaru nuw tputsiri ndunsha ashtachiya.","poem":1},{"lineBreak":true},{"text":"Tputs kiyung kachiykana an ashikpaz ashiru, ndusha arangeem kiyung kachiychinllinaya.","poem":1},{"lineBreak":true},{"text":"Ashkachu, tatsamooru tputsee napchiya.","poem":1},{"noteId":24}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tputsee mangoo itsinsar yasachima, átu,","poem":1},{"lineBreak":true},{"text":"nduntam kanusku,","poem":1},{"lineBreak":true},{"text":"nduntam sambaytachiya.","poem":1},{"lineBreak":true},{"text":"Ashkachu, tputssha ichingarusin mapiyrsin taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Arapich tputs marush kung arachich taakana,","poem":1},{"lineBreak":true},{"text":"Antamsin mang' kis ipunshireetsi kuk mazinachinllinaya,","poem":1},"Apanll wipunashee tárangiya."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nuw Apanlli Taarashipani kanindaa tinaranguri, íwar kasarangina.","poem":1},{"lineBreak":true},{"text":"Tsapurunaseetstam tinaranguri, maacheetssha kanungkakaru wayarangitamti.","poem":1},{"lineBreak":true},{"text":"Tputseetstam kchitamaam shipush kanusarangina.","poem":1},{"noteId":25},{"lineBreak":true},{"text":"Nuwaana ichingaru tinarangina.","poem":1},{"lineBreak":true},"Nuw Apanlli ipunsheetsi tárangina."]},{"type":"verse","number":6,"content":[{"text":"Nuw Taarshipantana siyaa, ipunshee, ipusarangina.","poem":1},{"lineBreak":true},{"text":"Shiyaa kuwish putaranguri,","poem":1},{"lineBreak":true},{"text":"tputsee ichingaru tapachindampaneem ínarangina.","poem":1},{"lineBreak":true},{"text":"Nuw shiyaa wayarangina.","poem":1},{"lineBreak":true},{"text":"Nuw Israelchichee yasapana aturi, tárangina.","poem":1},{"lineBreak":true},{"text":"Ashkachuri, tsapurunasshuch tputs nuwaa chinachinllinaya.","poem":1},{"noteId":26}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tputsee wach mchusaa yarangcha, shiyaa atina.","poem":1},{"lineBreak":true},{"text":"Putamawaa tputsee tashitungangcha.","poem":1},{"lineBreak":true},{"text":"¿Mayaamaja tapish tumanam mangu taachinllina?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nuw watatana Taarashipani. Watacha nuw surina.","poem":1},{"lineBreak":true},{"text":"Nuw kizpur tputsireetsi pachindkina.","poem":1},{"lineBreak":true},{"text":"¿Antaati maacheetsi nllitaritaa, Watacha iy Aparini, támaam waritak? Nda.","poem":1},{"lineBreak":true},{"text":"¿Nitaati apanllputsee chinangtsa nuw tárangee?","poem":1},{"lineBreak":true},{"text":"Tputsee anumasheem, Watsta. Shirintspa, atinawa.","poem":1},{"lineBreak":true},{"text":"Nuwaatsimari chinangtsa, atina.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nuw sirú tárangi anoo ichingaru tuminarangina.","poem":1},{"lineBreak":true},{"text":"Nat in tsiyatsis kaneesich kamankina,","poem":1},{"lineBreak":true},{"text":"anoo zurampatari tuminchima.","poem":1},{"lineBreak":true},{"text":"Ndatuma parus, wasina nuw siyaa kamankuri atashina,","poem":1},{"lineBreak":true},"Apanll tárangiya wipunasheetsi. Ashirucha, nuw Isáysi siyaa, Apanllee mangoonangtsa, atashina."]}],"footnotes":[{"noteId":22,"caller":"*","text":"Romshucheema 1.1 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":42,"verse":1}},{"noteId":23,"caller":"*","text":"Matiwa 3.17; 17.5; Márkosa 1.11; Lukasa 3.22; 9.35 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":42,"verse":1}},{"noteId":24,"caller":"*","text":"Yuwaa nish átu anootstam Matiwa 12.18-20 kamankiya.","reference":{"chapter":42,"verse":3}},{"noteId":25,"caller":"*","text":"Tayaspatampani 17.24-25 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":42,"verse":5}},{"noteId":26,"caller":"*","text":"Lukasa 2.32; Tayaspatampani 13.47 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":42,"verse":6}}]},"thisChapterLink":"/api/cbu_wbt/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":9}