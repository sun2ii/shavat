{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":44,"content":[{"type":"heading","content":["Apanll Taarashipan chiyaa nda kasakiya"]},{"type":"verse","number":1,"content":["Apanll ateeja:",{"text":"Siy Israelshuchis, nuwaa kuki mazinangtsa.","poem":1},{"lineBreak":true},{"text":"Siy Akoparinchichtischa.","poem":1},{"lineBreak":true},{"text":"Nuw siyaa tputsireemi ipusarangina.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuw Taarashipantana. Nuw siyaa tinarangina.","poem":1},{"lineBreak":true},{"text":"Ndatuma nllurtachus,","poem":1},{"lineBreak":true},{"text":"nuw siyaa kayatakpaz ashirangina.","poem":1},{"lineBreak":true},{"text":"Uru nuwtanda siyaa istaki.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Napa, nuw kungoo apusap tsap siyaam zaw ashirangina.","poem":1},{"lineBreak":true},{"text":"Amb nduntaa kung pakchiyam taarangu,","poem":1},{"lineBreak":true},{"text":"ashiritaa wayarangina.","poem":1},{"lineBreak":true},{"text":"Na siyaam iparis kapung yusur istachima.","poem":1},{"lineBreak":true},{"text":"Taárasheemis kaneesich panakuri, kisshaparee taatssa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chirichir kungumun wing kis kanungku,","poem":1},{"lineBreak":true},{"text":"misha karipan washitan wazanganamun kis kanungku,","poem":1},{"lineBreak":true},{"text":"ashikpaz ipareemis ashtachima.","poem":1},{"noteId":27}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Anpursha tputs, Nuw Taarashipaneetsim chinakina, táchinllinaya.","poem":1},{"lineBreak":true},{"text":"Nllitaritsha tputs, Akoparin tamaparee Apanllimun mang' taturangu, nuw ashkitamana, táchiya.","poem":1},{"lineBreak":true},{"text":"Nllitaritsha uwimun yandashish yandachiya.","poem":1},{"lineBreak":true},{"text":"Apanll nuwaa kasicha, yandakchu táchiya.","poem":1},{"lineBreak":true},{"text":"An tputs uru Israelaa surunchiya,","poem":1},"Apanll siyaa átcha."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Apanlli Taarashipan siyaam kurakcha.","poem":1},{"lineBreak":true},{"text":"Uru siyaa Israelchicheetsis tapachindakiya.","poem":1},{"lineBreak":true},{"text":"Wamari kasikiya.","poem":1},"Waana Apanll siyaa átcha.",{"lineBreak":true},{"text":"Nuw ichtakachuri taarangina.","poem":1},{"lineBreak":true},{"text":"Nuw urutamari taaki antana.","poem":1},{"noteId":28},{"lineBreak":true},{"text":"Nuw minamari Apanlltana.","poem":1},{"lineBreak":true},{"text":"Arang minamtiyam nuwapa waritarazinllinaja.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¿Chakaja nuwapa tatsamooch?","poem":1},{"lineBreak":true},{"text":"¿Antaati tsiyatssee kaneesich yuw nuw nda yasari anoo kamancheeja?","poem":1},{"lineBreak":true},{"text":"¿Chak sirútamastaa nuwaa tuwacheeru,","poem":1},{"lineBreak":true},{"text":"Piyparee ashtachiya, nuwaa tách?","poem":1},{"lineBreak":true},{"text":"Tputs támaam wanindaja.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nduntaa tputs ashim taaru,","poem":1},{"lineBreak":true},{"text":"anoo punirintspa.","poem":1},{"lineBreak":true},{"text":"Sambaytarintspa, nuw siyaa atashina.","poem":1},{"lineBreak":true},{"text":"Sirútari, Nuw piy ashtachima, táranginawa.","poem":1},{"lineBreak":true},{"text":"Zitaminaris nuwaa kuki mazinaranganaya.","poem":1},{"lineBreak":true},{"text":"Siy ichingarus mazinarangitamsa.","poem":1},{"lineBreak":true},{"text":"Nuwamari Apanlltana.","poem":1},{"lineBreak":true},{"text":"Nllitarit Aparis wanindaja.","poem":1},{"lineBreak":true},{"text":"Siyaa tapachindampaneem min nduncha.","poem":1},{"lineBreak":true},{"text":"Nuw minamtiyam patareezi,","poem":1},{"lineBreak":true},"Apanll waana siyaa Israelchichis áttanda. Ashirucha, nuw Isáysi siyaa atashina."]},{"type":"verse","number":9,"content":["Tputs apanllputsee tinakchu, anoo chinakchu, waritachazinllinaja. Apanllputseem wanasireewtaa tinayarusin, chiyaa pakchiyam nda istakanaya. Anoo ungirtakuch, mangshar ashkiya. Mirusinlltakana. Anoo stamaam waritakiya."]},{"type":"verse","number":10,"content":["Tputs apanllputseem ngusambaa tinakchu, mangu ashkiya. ¿Antaati istamanaa istacheeja? nuw siyaa atashina. Ashirucha, Apanlleetsimari Taarashipani chinangtsa, nuw siyaa atashina."]}],"footnotes":[{"noteId":27,"caller":"*","text":"Wanga 7.37-39; Apanll wanichu anu 22.1-2 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":44,"verse":4}},{"noteId":28,"caller":"*","text":"Apanll wanichu anu 1.17; 22.13 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":44,"verse":6}}]},"thisChapterLink":"/api/cbu_wbt/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":10}