{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":45,"content":[{"type":"heading","content":["Apanll Taarashipan apanllputsee stakiya"]},{"type":"verse","number":20,"content":["Apanll ateeja:",{"text":"Natu, shaniyeeni.","poem":1},{"lineBreak":true},{"text":"Israelchichis katuchimis tputsis, naani tsiyatsteeni.","poem":1},{"lineBreak":true},{"text":"Mazinangtsa. Tputs yasinaa yáyarusin,","poem":1},{"lineBreak":true},{"text":"apanllputseem tinakchusin,","poem":1},{"lineBreak":true},{"text":"shurangakataraa, kuktaraa ashkusin,","poem":1},{"lineBreak":true},{"text":"mangsharit ashirusin chinakanaya.","poem":1},{"lineBreak":true},{"text":"Apanllputsee mashimashtar ashkusin,","poem":1},{"lineBreak":true},{"text":"¿mayaamaja ashkana?","poem":1},{"lineBreak":true},{"text":"Watam nda pakchiyam istaku tapachindachuwa,","poem":1},"nuw siyaa atina."]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Natu, siysat tsiyatangtsa. Kamaningandama.","poem":1},{"lineBreak":true},{"text":"Saanpatatis tsiyateerus, yasayarus, ¿amcheezis?","poem":1},{"lineBreak":true},{"text":"¿Chak yuw nuwaa tushiyru anoo wasina kamaniranga?","poem":1},{"lineBreak":true},{"text":"¿Chak sirútamasa siyaa, Piy sheenlliya, átu kamaniranga?","poem":1},{"lineBreak":true},{"text":"¿Ndusha nuw, Taarashipani, siyaa sirútari kamanirangee?","poem":1},{"lineBreak":true},{"text":"¿Antaati apanllputs, kaniz ashiru, ashimaam waritak?","poem":1},{"lineBreak":true},{"text":"Nuw minamariti siyaam Aparis taarina.","poem":1},{"lineBreak":true},{"text":"Nuwamari kasikuri, siyaa tapachindampani.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ashirucha, nuwaa mashangandama.","poem":1},{"lineBreak":true},{"text":"Nuw siyaa kamiran tapachindachintspa; istachintspa.","poem":1},{"lineBreak":true},{"text":"Araptaati taakus, yambtaa tsapurunas katuktakatu ambitaa taakus,","poem":1},{"lineBreak":true},{"text":"ashiritaa nuw siyaa istachintspa.","poem":1},{"lineBreak":true},{"text":"Nuw Apanlltana. Arang min Apanll wanindaja.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Yuwaa nuw tárangi anoo zurampatari tuminchima.","poem":1},{"lineBreak":true},{"text":"Nuw kuraki táranguri, ¿tamareeja pinaschee?","poem":1},{"lineBreak":true},{"text":"Nuwamari kasichuri, kundarareetsis kachingchima, táranginawa.","poem":1},{"lineBreak":true},{"text":"Kasikchuri, tputs ichingurusin nuwash kuseersin,","poem":1},{"lineBreak":true},{"text":"tutunlltayarusin, nuwaa ungirtachinllinaya.","poem":1},{"lineBreak":true},{"text":"Nuwaa yasakchusin, zurampatari táchinllinaya.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Taarashipaniri kizpur taakiya.","poem":1},{"lineBreak":true},{"text":"Wamari ichingaru tputsee kasikiya, táchinllinaya.","poem":1},{"lineBreak":true},{"text":"Tputs nuwaa niyrkana, anoo nuwsha stachparina.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Israelchich tputs nuwamun kasichinllinaya.","poem":1},{"lineBreak":true},{"text":"Nuwaatsimari kis chinachinllinaya.","poem":1},{"lineBreak":true},{"text":"Watam kizpur tapachindachinawa Israelchicheetsi,","poem":1},{"lineBreak":true},"Apanll waana tárangiya. Ashirucha, Apanllimunarisha mangis tatungsha, nuw Isáysi siyaa atashina."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":6}