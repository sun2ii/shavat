{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":49,"content":[{"type":"heading","content":["Apanll wipunash ztaru tputsee tuwasinichiya"]},{"type":"verse","number":1,"content":["Nuw Apanll wipunashi atina:",{"text":"Siy tputsis, yuwis arap arachich mar taakis anis,","poem":1},{"lineBreak":true},{"text":"yuwis tsapurunas yap katukatu amb taakis anis,","poem":1},{"lineBreak":true},{"text":"kaapa nuwaa kuki mazinangtsa.","poem":1},{"lineBreak":true},{"text":"Nduma nuw nllurtachuri,","poem":1},{"lineBreak":true},{"text":"Apanll Taarashipan nuwaa ipusarangiya.","poem":1},{"lineBreak":true},{"text":"Ataatash waxankan wand taaranguri,","poem":1},{"lineBreak":true},{"text":"Apanll nuwaa yásamarangiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuwaa sundaroom ínarangiya.","poem":1},{"lineBreak":true},{"text":"Nuwaa kuki m'chit wawits ashiru wayarangiya.","poem":1},{"noteId":29},{"lineBreak":true},{"text":"Nuwaa turuwpaz ashiru wayarangitamta.","poem":1},{"lineBreak":true},{"text":"Sheeru, uwpat nuwaa ksutarangu,","poem":1},{"lineBreak":true},{"text":"nuwaa purishpaz ashiru pshtarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["Apanll waana nuwaa tárangiya:",{"text":"Shiy nuwcha ipunshish.","poem":1},{"lineBreak":true},{"text":"Shiy uru nuwaa izuuru chinakush,","poem":1},{"lineBreak":true},{"text":"tputsirshitish nuwaa kis napchinllinaya,","poem":1},"tárangiya."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nuwsha nllitarit chinarangitaati,","poem":1},{"lineBreak":true},{"text":"ashiritaa, Apanll nuwaa anoo tárangiya.","poem":1},{"lineBreak":true},{"text":"Nuw ngutariti kiyung kachiyarangina.","poem":1},{"lineBreak":true},{"text":"Kizpur apanllpan taarangitaati,","poem":1},{"lineBreak":true},{"text":"itaru, ngutariti Apanllee chinarangina,","poem":1},{"lineBreak":true},{"text":"nuwaanitari tárangina.","poem":1},{"lineBreak":true},{"text":"Itaru, Taarashipansha waana nuwaa yasariya.","poem":1},{"lineBreak":true},{"text":"Yuwash waritaku anush Apanll nuwaa tuwapchiya,","poem":1},"atina."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Waanasha Taarashipani nuwaa kis napchiya.","poem":1},{"lineBreak":true},{"text":"Watam nuwaa tuwizpurtakuwa. Waana","poem":1},{"lineBreak":true},{"text":"nuwaa wipunasheem ínaranguwa.","poem":1},{"lineBreak":true},{"text":"Nuw aneershi waxankan taaruri,","poem":1},{"lineBreak":true},{"text":"nuwaa ipusarangiya.","poem":1},{"lineBreak":true},{"text":"Shiysha ipunshee, Nuwaa tputsiri, Israelchichee mangoo p'tseengcha.","poem":1},{"lineBreak":true},{"text":"Ashkachush, Akoparinchichsha yusur nuwaa chinachinllinaya,","poem":1},"tárangiya. Arang tárangitamta."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nuw shiyaa kizpur chinaktana.","poem":1},{"lineBreak":true},{"text":"Arangeem nuwaa istangcha.","poem":1},{"lineBreak":true},{"text":"Nuwaa tputsireetsi, Akoparineetsini mangoo p'tseekchush,","poem":1},{"lineBreak":true},{"text":"Israelchichee katuchimarini nuwaa yusur mangoonkatssin,","poem":1},{"lineBreak":true},{"text":"anush arangeem tsapurunasshuch ztaru tputs nuwaa mangoonchinllinaya.","poem":1},{"lineBreak":true},{"text":"Nuwaa kuki tuwasineekchush,","poem":1},{"lineBreak":true},{"text":"nuwsha tputsee arapcheetstaa tapachindachima.","poem":1},{"noteId":30},{"lineBreak":true},{"text":"Tsapurunas katuktakachu amb ichingarusin mazinachinllinaya,","poem":1},{"noteId":31},"Apanll nuwaa tárangiya."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Apanll Taarashipan siyaa Israelchichee itutseeru, tapachindachiya.","poem":1},{"lineBreak":true},{"text":"Siy Israelchichis tsíparangitaatis,","poem":1},{"lineBreak":true},{"text":"m'chachurtarangunts, kiyungtaa kachiyarangus,","poem":1},{"lineBreak":true},{"text":"arapich tputs siyaa natsarangitaatssin,","poem":1},{"lineBreak":true},{"text":"ashiritaa, Apanll siyaa chinaku, ateeja.","poem":1},{"lineBreak":true},{"text":"Tsapurunashuch kurak shiyaa pakchusin,","poem":1},{"lineBreak":true},{"text":"punirustakchusin, shiyaa tutunlltachinllinaya.","poem":1},{"lineBreak":true},{"text":"Nuw Apanlli Taarashipani shiyaa sirútari ipusaranguri,","poem":1},{"lineBreak":true},{"text":"natsha in yuwaa tárangi anoo shiyaam tuminkina,","poem":1},{"lineBreak":true},"Apanll nuwaa wipunashi átcha. Waana wipunashee ashkachu, ztaru tputsee tuwasineekchiya, nuw Isáysi siyaa atina."]},{"type":"heading","content":["Yakat Irusarinaa yusur wanasiritam panguchinllinaya"]},{"type":"verse","number":8,"content":["Apanll Taarashipan ateeja:",{"text":"Nat in nuw Irusarinshuchee nayanimpatari istachima.","poem":1},{"lineBreak":true},{"text":"Nuw siyaa atashina:","poem":1},{"lineBreak":true},{"text":"Nat in nuw siyaa tapachindachintspa.","poem":1},{"lineBreak":true},{"text":"Nuw siyaa kapung istachintspa.","poem":1},{"noteId":32},{"lineBreak":true},{"text":"Nuw siyaa tputsireemi ínarangunts,","poem":1},{"lineBreak":true},{"text":"siyaa ksutaranguri,","poem":1},{"lineBreak":true},{"text":"na siysa yusur kisshaparee taatssa.","poem":1},{"lineBreak":true},{"text":"Watam nuw siyaa itsinsar tsiyataranguri, amikurtaranginawa.","poem":1},{"lineBreak":true},{"text":"Nimunari yuwaa tsapoo mantsarangana, anoo","poem":1},{"lineBreak":true},{"text":"siysa yusur kis tarawaztatssa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nuw ipunshi tputsee putamawaa tashitungachiya.","poem":1},{"lineBreak":true},{"text":"Tputsee yuw tapish taakana anoo, Yusur kis napangtsa, táchiya.","poem":1},{"lineBreak":true},{"text":"Ipunshi tputsireetsi wanasir ksutchiya.","poem":1},{"lineBreak":true},{"text":"Katungtsee ngootsinung zapan pangchinllinaya.","poem":1},{"lineBreak":true},{"text":"Kung nduntaa sirú taarangu, ambiritaa opeejarineetsini kis martatssin, kungootstam yaschinllinaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ipunshi tputsireetsi ksutkachu,","poem":1},{"lineBreak":true},{"text":"marizimun ndusha kiyung kachiychinllinaya;","poem":1},{"lineBreak":true},{"text":"kungoo waamaam nduntam pishtachiya.","poem":1},{"lineBreak":true},{"text":"Zar kizpurtaa zatku,","poem":1},{"lineBreak":true},{"text":"kizpurtaa ksaneeku,","poem":1},{"lineBreak":true},{"text":"ndusha kiyung kachiychinllinaya.","poem":1},{"lineBreak":true},{"text":"Amb kung zapan shitungataraa ashkachu,","poem":1},{"lineBreak":true},{"text":"anoo ipunshi tputsireetsi yámandachiya.","poem":1},{"noteId":33}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mach kizpur íwartaa taaru,","poem":1},{"lineBreak":true},{"text":"anoo ngootsee wanasirsha tuwitchiya.","poem":1},{"lineBreak":true},{"text":"Wazawap tupareeyaru, tándsaam ínachiya. Anush kamiran tputs naachinllinaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Napangcha. Tputsiri arapiritaa taaksin,","poem":1},{"lineBreak":true},{"text":"yap zar yaku amb, yap zar puwachingaru ambtam, kizpur arap taakchusin,","poem":1},{"lineBreak":true},{"text":"nuwsha amb yamayaruri, yusur Irusarinap wayachima,","poem":1},"Taarashipan átcha."]},{"type":"line_break"},{"type":"verse","number":13,"content":["Nuwsha, Isáysi siyaa atina:",{"text":"Taarashipan waanaa tiptsiree tuwizpurtachiya.","poem":1},{"lineBreak":true},{"text":"Nayanichu, yusur kiyung kachiymaam, Watsta, táchiya.","poem":1},{"lineBreak":true},{"text":"Ashkachu, íwarpichis, mangis kis, Jay, jay tátssa.","poem":1},{"lineBreak":true},{"text":"Tsapurunasshuchtis, shambatchitamsa.","poem":1},{"lineBreak":true},{"text":"Yuwis machis taakis anis, shambatkus, Jay, jay, táchtamsa,","poem":1},"nuw Isáysi siyaa atashina.",{"lineBreak":true},"Apanll ateeja;"]},{"type":"verse","number":14,"content":[{"text":"Siy Siyonshuchis tárangsa.","poem":1},{"lineBreak":true},{"text":"Taarashipani iyaa kapeetarangiya.","poem":1},{"lineBreak":true},{"text":"Apanll iyaa mbizarangiya, tárangsa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Itaru, ¿antaati ashirang?","poem":1},{"lineBreak":true},{"text":"¿Antaati kiz wipaa mbizatar?","poem":1},{"lineBreak":true},{"text":"¿Ashinooja kiz wipaa chinamaam mbiztar?","poem":1},{"lineBreak":true},{"text":"Kizataa wipaa mbizakitaatiya,","poem":1},{"lineBreak":true},{"text":"itaru, nuwsha Taarashipani, siyaa ayamtaatiya mbizacheezi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Siyaa Israelshucheetsis suris kuwimuni yandarangina.","poem":1},{"lineBreak":true},{"text":"Siyaa taarashis uru chinakina.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ashirucha, sirú pangusee pátangampani kusarangtaatssin,","poem":1},{"lineBreak":true},{"text":"natsha pangoompan tputs yusur pangoomaam zapan mikeeru kuschinllinaya.","poem":1},{"lineBreak":true},{"text":"Pátangamapan tputs sirútari suwaranganaya.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ashiriya, napangtsa. Nashamangantsa.","poem":1},{"lineBreak":true},{"text":"Tputs ¿wanipamasaja Irusarinap naakchusin,","poem":1},{"lineBreak":true},{"text":"siyash musá shaniychinllina?","poem":1},{"lineBreak":true},{"text":"Nuwsha Taarashipani zurampatari atashina.","poem":1},{"lineBreak":true},{"text":"Ndunnaa k'keetsi tuminkuri, tsipachshaparina nuwaya.","poem":1},{"lineBreak":true},{"text":"Ashiriya, mazinangtsa.","poem":1},{"lineBreak":true},{"text":"Yusur kis taatssa.","poem":1},{"lineBreak":true},{"text":"Yarangasheetsis yusur yarareerus, kis yupzingambeerus, taatssa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsapuneetsis kapeetarangitaatssin,","poem":1},{"lineBreak":true},{"text":"pangeetsis tunuparangtaatssin,","poem":1},{"lineBreak":true},{"text":"maachiritaatsis shuchirangitaatssin,","poem":1},{"lineBreak":true},{"text":"ashiritaa, siysa yusur izapaneekchus,","poem":1},{"lineBreak":true},{"text":"tsapunis tatsitkachus, tsapuneemis pishtachshaparee.","poem":1},{"lineBreak":true},{"text":"Watam kundararis arap suwasuwaranganawa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Siyachich nlluranuris arap suwarangitaatssin,","poem":1},{"lineBreak":true},{"text":"yusur kitsishis tsiyatchinllina.","poem":1},{"lineBreak":true},{"text":"Iyaam tsapoonni pishtakiya.","poem":1},{"lineBreak":true},{"text":"Tsapuneemani arang wayangasindama, táchinllinaya.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Itaru, siysa mangishis tátssa,","poem":1},{"lineBreak":true},{"text":"¿Chak nee ipareemi panaranga?","poem":1},{"lineBreak":true},{"text":"Watam ipari ndunarimunawa.","poem":1},{"lineBreak":true},{"text":"¿Antaati nuw iparinarangee?","poem":1},{"lineBreak":true},{"text":"Nuw arapari taaranguri,","poem":1},{"lineBreak":true},{"text":"zaranlli nduntam taarangiya.","poem":1},{"lineBreak":true},{"text":"Ashiriya, ¿chak, Neewa ipareemish, nuwaa táranga?","poem":1},{"lineBreak":true},{"text":"Nuw minamariti apusap suwaruri taaranguri,","poem":1},{"lineBreak":true},{"text":"¿yapamasaja ipareemi shitungarang?","poem":1},{"lineBreak":true},{"text":"siysa Irusarinshuchis tátssa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":["Itaru, Apanll Taarashipansha siyaa ateeja;",{"text":"Nuwsha tsapurunasshuchee tputs kamachtachima.","poem":1},{"lineBreak":true},{"text":"Tputssha ichingarusin nuwaa wizpuriri pakchusin, punirustachinllinaya.","poem":1},{"lineBreak":true},{"text":"Anoo pakchusin, Israelchichee pachipeersin,","poem":1},{"lineBreak":true},{"text":"yusur watsapunish wayachinllinaya.","poem":1},{"lineBreak":true},{"text":"Kizaa nllura kuyarusin, yusur wayachinllinaya.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tsapurunasshuch urkar siyaa wapareepaz ashiru ínachinllinaya.","poem":1},{"lineBreak":true},{"text":"Kurak wizanllin siyaam ksutamapaneem taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Uwshtisin siyaa kapung chinaksin,","poem":1},{"lineBreak":true},{"text":"tsapush siyanung tutunlltayarusin,","poem":1},{"lineBreak":true},{"text":"tsapoo iput iput ashchinllinaya.","poem":1},{"lineBreak":true},{"text":"Ashkatssin, siysa nuwaa, Taarashipaneetsi mangoonatssa.","poem":1},{"lineBreak":true},{"text":"Tputssha nuwamun mang' tatkusin,","poem":1},{"lineBreak":true},{"text":"Ayamtaati nuw siyaa ngichcheezi,","poem":1},"Apanll siyaa Irusarinshucheetsis átcha."]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kaapa mangishis itsinsar chinangtsa.","poem":1},{"lineBreak":true},{"text":"Kizpur kurak taaru,","poem":1},{"lineBreak":true},{"text":"¿antaati anoo maacheetsi itutsimaam waritak?","poem":1},{"lineBreak":true},{"text":"Tputspa waratkachu, kasichu, ¿tamareeja chiy watsta táchich?","poem":1},{"lineBreak":true},{"text":"Mishat, ¿antaati putamaw tputs tumaneersin shitungeecheeja?","poem":1},{"lineBreak":true},{"text":"mangeetsis p'tseekuri atashina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":["Itaru, Apanll Taarashipansha siyaa ateeja;",{"text":"Nuwsha kizpureeruri, piy ashtachintspa.","poem":1},{"lineBreak":true},{"text":"Kurak tputspa waratkachu, maachee itutskachitaatiya,","poem":1},{"lineBreak":true},{"text":"ashiritaa nuwamarisha kasikastachima.","poem":1},{"lineBreak":true},{"text":"Tputs siyaa natsakchusin, mantsiritaa tsiyatkusin,","poem":1},{"lineBreak":true},{"text":"ashiritaa, nuwsha ipareetsis tapachindachima.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ashkachuri, yuw siyaa kiyung yacharangana,","poem":1},{"lineBreak":true},{"text":"ansha tputs paziksin, nuw waneekchuri, waanaatsee wanuts kamu kamu ashchinllinaya.","poem":1},{"lineBreak":true},{"text":"Waanaatstaatam ursir waakchusin, vinumunpaz ashiru karuschinllinaya.","poem":1},{"lineBreak":true},{"text":"Sheeruri, tsapurunashuch ztaru tputs nuwaa yasachinllinaya.","poem":1},{"lineBreak":true},{"text":"Paja. Apanll Taarashipan wamari Israelchichee tapachindakuwa.","poem":1},{"lineBreak":true},{"text":"Wamari Apanll Akoparinchichee itutskuwa,","poem":1},{"lineBreak":true},"táchinllinaya, tsapurunashuch tputsi, nuw Isáysi siyaa atina."]}],"footnotes":[{"noteId":29,"caller":"*","text":"Utaáshucheema 4.12 tsiyatsis nipta tatsamooru taaritamta; yuwaa nish átu anootstam Apanll wanichu anu 1.16 tayusima kamankiya.","reference":{"chapter":49,"verse":2}},{"noteId":30,"caller":"*","text":"Lukasa 2.32; Wanga 8.12; Tayaspatampani 26.23 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":49,"verse":6}},{"noteId":31,"caller":"*","text":"Tayaspatampani 13.47 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":49,"verse":6}},{"noteId":32,"caller":"*","text":"Yuwaa nish átu anootstam 2 Koríndshucheema 6.2 tayusima kamankiya.","reference":{"chapter":49,"verse":8}},{"noteId":33,"caller":"*","text":"Apanll wanichu anu 7.16-17 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":49,"verse":10}}]},"thisChapterLink":"/api/cbu_wbt/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":26}