{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":5,"content":[{"type":"heading","content":["Utaáchich kizarun tatsumim tamapari ashirusin taakanaya"]},{"type":"verse","number":1,"content":[{"text":"Nuw Isáysi kizarunaa tatsumma yasichima.","poem":1},{"lineBreak":true},{"text":"Nuw amikuri yuw kizpur taaku an wamin yasichima.","poem":1},{"lineBreak":true},{"text":"Nuw amikuri kizarunaa tatsumma ksutarangiya.","poem":1},{"lineBreak":true},{"text":"Mázarush kizarun kizpur wanasir tatsumarangiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wanasir puyayaru,","poem":1},{"lineBreak":true},{"text":"Maachtaa patumbchee ichingaru kapeetarangiya.","poem":1},{"lineBreak":true},{"text":"Kizarunaa ipus ipus sheeru, wanasirimsheetsimari tatsumarangiya.","poem":1},{"lineBreak":true},{"text":"Mázarish apusanand torre napamaam kayatarangiya.","poem":1},{"lineBreak":true},{"text":"Sheeru, Vinoo wayar waapi átu, kamiyamaam wayarangitamta.","poem":1},{"lineBreak":true},{"text":"Iwaparangu, wanuseemsha kutarangiya.","poem":1},{"text":"Kam waapi, tárangitaa,","poem":2},{"text":"waaj, kizarunsha kizpur kapiz yusirangiya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Anumandsha amikuri Apanll, Yutaritischa, siy Irusarinshuchis.","poem":1},{"lineBreak":true},{"text":"Na pindanaru k'kuz mangeetsis p'tsimaam kamanchintspa, tárangiya.","poem":1},{"lineBreak":true},{"text":"Utaáchchis, na nuwaa mangiptis kamaningandama.","poem":1},{"lineBreak":true},{"text":"¿Chakamandaja chayarini mzats mantsir yusirang?","poem":1},{"lineBreak":true},{"text":"¿Antaati nuwamand ashirang?","poem":1},{"lineBreak":true},{"text":"¿Ndush mzats waanamandari ashirang?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¿Mayaaja mzatseem pishtarang wanasir yanungamaama?","poem":1},{"lineBreak":true},{"text":"Nuw siyaa, Kam yusichpa aturi,","poem":1},{"lineBreak":true},{"text":"itaru, siysa nuwaa tamapingarangus, kapizsha yusirangsa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ashiriya, nuwaa kuki mazinangtsa.","poem":1},{"lineBreak":true},{"text":"Yuw nuw mangishi chinaki anoo kamanchintspa.","poem":1},{"lineBreak":true},{"text":"Mzareetsi watandpun kapeetkachuri,","poem":1},{"lineBreak":true},{"text":"waani arapich tputs, Mzatsee kachingpana, atina.","poem":1},{"lineBreak":true},{"text":"Ashkachuri, watspat kat, kat ashchinllinaya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nuw mzareetsi ndusha pakchiyam ktsutchima.","poem":1},{"lineBreak":true},{"text":"¿Chakaja karutaa púyach?","poem":1},{"lineBreak":true},{"text":"Kpanandarishaparee kxuneeru, karutamunaam kinachiya.","poem":1},{"lineBreak":true},{"text":"Msaseetssha, Amb sinatpa, táchima.","poem":1},{"lineBreak":true},{"text":"Pakchiyam mzarimuni sinacheeja.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuwamari kasiruri, siyaa Utaáchcheetsis atashina.","poem":1},{"lineBreak":true},{"text":"Nuw mzari watacha siyaya.","poem":1},{"lineBreak":true},{"text":"Nuw tatsumareetspazi ashiruri kizpur siyaa chinarangina.","poem":1},{"lineBreak":true},{"text":"Siy Israelchichis nuwpaz mzari ashirus taaksa.","poem":1},{"lineBreak":true},{"text":"Itaru, nuw siyaa, Nuwaa kuki payuchinllinpa, tárangitaati,","poem":1},{"lineBreak":true},{"text":"Siysa pachampaneemarisha kinarangsa.","poem":1},{"lineBreak":true},{"text":"Waanpatatin wanasir napchinllinpa; itsinsaru chinachinllinpa, tárangitaati,","poem":1},{"lineBreak":true},{"text":"itaru, siysa tputsee kiyung yachakus,","poem":1},{"lineBreak":true},{"text":"siyamun tputs kiyung kachiykusin,","poem":1},{"lineBreak":true},{"text":"wasureemun, Ay átangat ashkanaya.","poem":1},{"noteId":2},{"lineBreak":true},{"text":"Amb ashirangus, kizarun wanus kapiz tamaparee ashirangsa.","poem":1},{"lineBreak":true},{"text":"Ashirucha, anumand siyaa zurampatari kasachintspa,","poem":1},{"lineBreak":true},"nuw atashina, Apanll siyaa Utaáchcheetsis tárangiya. Utaáchich kizarun tatsumim tamapari ashirusin taakanaya, atiya."]}],"footnotes":[{"noteId":2,"caller":"*","text":"Lukasa 13.6-9 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":5,"verse":7}}]},"thisChapterLink":"/api/cbu_wbt/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":7}