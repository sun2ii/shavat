{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":52,"content":[{"type":"heading","content":["Waana Apanll Irusarinshuchee itutschiya"]},{"type":"verse","number":1,"content":[{"text":"Siyonshuchis, támangints. Kizpurtangints.","poem":1},{"lineBreak":true},{"text":"Irusarinshuchis, kamaris kizpur wanasir kamartangints.","poem":1},{"lineBreak":true},{"text":"Siy apanllpantischa. Ashiriya, shambatangints.","poem":1},{"lineBreak":true},{"text":"Arapich tputs ayamtaati siyash yusur tamundachazinllinaya.","poem":1},{"lineBreak":true},{"text":"Uwshtisin Apanllee ngatamapaniri taakanaya. Kizpur yutaritshishee chinakanaya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Irusarinshuchis, chiyzangints. Tsarunaa kpitangints.","poem":1},{"lineBreak":true},{"text":"Kurakamun watsirar k'xinartangints.","poem":1},{"lineBreak":true},{"text":"Siyonshuchis kizis kamasinis siyaa tumanirangitaatssin,","poem":1},{"lineBreak":true},{"text":"ashiritaa yuwaa kayak chiparis anoo kpitangints,","poem":1},"Apanll siyaa Irusarinshuchis tárangiya."]},{"type":"line_break"},{"type":"verse","number":3,"content":["Apanll ateeja:",{"text":"Arapich tputs siyaa muchchureem putarangusin,","poem":1},{"lineBreak":true},{"text":"nuwaa itutsirangsin, nuwaamsha nda pakchiyam tuwaparanganaya.","poem":1},{"lineBreak":true},{"text":"Anumun na siyaa yanpukchuri, siyaa itutskachuri,","poem":1},{"lineBreak":true},{"text":"uwaam nduntam pakchiyam tuwapchina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Napa: sirútamasa siy Ijiptop naatarangus,","poem":1},{"lineBreak":true},{"text":"anush arapich tputs tamatarparee ashiru taarangsa.","poem":1},{"lineBreak":true},{"text":"Anumunsha, Asiriyshuch tputs siyaa mangutari kiyung yacharanganaya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naachsha, ¿kamaparee arapich tputs siyaa kiyung yachachiya?","poem":1},{"lineBreak":true},{"text":"Mangutaritam yaktap Babiloniyap siyaa putayarusin, machiranganaya.","poem":1},{"lineBreak":true},{"text":"Amb kusarangus, siyaa kiyung yachakanaya.","poem":1},{"lineBreak":true},{"text":"Kurakaam ínaksin, kizpur, ¡Jay! ¡Jay! atanaya.","poem":1},{"lineBreak":true},{"text":"Ashkusin, nuwaa tutsiyuntaranganaya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yuwash zar waritakchu anush, nuwsha siyamand kisatakchuri,","poem":1},{"lineBreak":true},{"text":"siy nuw tputsiris nuwaa, Apanll Taarashipancha.","poem":1},{"lineBreak":true},{"text":"Apanll waanaatsi kuk uru payukiya, nuwaa táchpasa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tputs tsiyatssee wanasirimshee machip wayakchusin,","poem":1},{"lineBreak":true},{"text":"machshuchsha tputs anoo mazinakchusin,","poem":1},{"lineBreak":true},{"text":"mang' shambatchinllinaya.","poem":1},{"lineBreak":true},{"text":"Watam, Apanll siyaa tapachindaranguwa.","poem":1},{"lineBreak":true},{"text":"Na ndusha siyaa m'chachurtachintsa, átcha.","poem":1},{"lineBreak":true},{"text":"Na mapiyrus taangtsa, atiya.","poem":1},{"noteId":36},{"lineBreak":true},{"text":"Siyonshucheetsis, Apanll siyaa kurakcha, táchshaparee.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡Mazinangantsa! Sundarshat tsangampani kizpur, ¡Napangtsa!","poem":1},{"lineBreak":true},{"text":"¿Kamaparee Apanll Taarashipan waana Siyonash kuschiya? táchpasinaya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kizpur shambatangtsa. ¡Jay! ¡Jay! tángtsa.","poem":1},{"lineBreak":true},{"text":"Watam siyamari kasitssawa.","poem":1},{"lineBreak":true},{"text":"Apanll Taarashipan siyaa, waanaatsi tiptsiree nayinirangu,","poem":1},{"lineBreak":true},{"text":"kundarareetsis itutsirangiya.","poem":1},{"lineBreak":true},{"text":"Irusarinshuchis kisshapari taatssa.","poem":1},{"lineBreak":true},{"text":"Na ndushaparee siyaa m'chachurtachintsa.","poem":1},{"lineBreak":true},{"text":"Irusarinshuch pang' ichingaru yurangarangitaa,","poem":1},{"lineBreak":true},{"text":"ashiritaa shambatangtsa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Apanll Taarashipan kizpureeru,","poem":1},{"lineBreak":true},{"text":"tsapurunasshuch tputs ichingarusin wach parsin,","poem":1},{"lineBreak":true},{"text":"ichingarusin yasachpasinaya.","poem":1},{"lineBreak":true},{"text":"Waana Apanll iyaa Utaáchcheetsini tapachindachiya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ashirucha, nuw siyaa, ¡Shtungangints! Yaktash Babiloniyaa ksangtsa.","poem":1},{"lineBreak":true},{"text":"Maachee yutaritshish ptatintspa.","poem":1},{"lineBreak":true},{"text":"¡Mikintsa! Babiloniyaa izuuru ksangtsa.","poem":1},{"lineBreak":true},{"text":"¡Yutaritshishee pakchiyam chinarintspa; ptatintspa!","poem":1},{"noteId":37},{"lineBreak":true},{"text":"Apanllee maachirit yáyarush,","poem":1},{"lineBreak":true},{"text":"waptam Apanllip pang' chipayarus, wayangtsa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Shitungachus, suwamari suwacheezis;","poem":1},{"lineBreak":true},{"text":"apinll mapiyrus naatssa.","poem":1},{"lineBreak":true},{"text":"Watam Taarashipansha, siy Apanlliris, kizpur siyaa napchuwa,","poem":1},"Apanll Irusarinshuchee tárangiya. Ashiriya, Waana Apanll Irusarinshuchee itutschiya, nuw siyaa atina. Apanllsha wipunash kizpur kiyung kachiyeeru, anumun wamari kasichiya Apanll ateeja:"]},{"type":"verse","number":13,"content":[{"text":"Ayam nuw ipunshi ichingaru wanasir shitungchiya.","poem":1},{"lineBreak":true},{"text":"Apanll kizpur kurakaam ínachiya.","poem":1},{"lineBreak":true},{"text":"Tputs ichingarusin waa chinachinllinaya.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ichtaru, nuw ipunshi kizpur kiyung kachiyarangu,","poem":1},{"lineBreak":true},{"text":"wanutsee pzkooksin, tpit tpit ashirangsin,","poem":1},{"lineBreak":true},{"text":"wachsha nda tputs ashiru parangusin,","poem":1},{"lineBreak":true},{"text":"tsapurunasshuch tputs ichingarusin kapung punirustaranganaya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Itaru, natsha ashiritam, ichingarusin yusur punirustachinllinaya.","poem":1},{"lineBreak":true},{"text":"¿Tamara Apanll wipunash? táchpasinaya.","poem":1},{"lineBreak":true},{"text":"Kuraksha Apanllee wipunashi pakchusin,","poem":1},{"lineBreak":true},{"text":"mangu nda tsiyatkusin, zaputaraa ashchinllinaya.","poem":1},{"lineBreak":true},{"text":"Pakchusin, mangoonachpasinaya.","poem":1},{"lineBreak":true},{"text":"Nduntaa sirú anoo mazinamaam zandarangusin,","poem":1},{"lineBreak":true},{"text":"natsha kizpur wanasirimshee mazinachinllinaya,","poem":1},{"noteId":38},"Apanll tárangiya wipunasheetsiya."]}],"footnotes":[{"noteId":36,"caller":"*","text":"Yuwaa nish átu anootstam Romshucheema 10.15 tayusima kamankiya, misha Ipísshucheema 6.15 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":52,"verse":7}},{"noteId":37,"caller":"*","text":"2 Koríndshucheema 6.17 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":52,"verse":11}},{"noteId":38,"caller":"*","text":"Yuwaa nish átu anootstam Romshucheema 15.21 tayusima kamankiya.","reference":{"chapter":52,"verse":15}}]},"thisChapterLink":"/api/cbu_wbt/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":15}