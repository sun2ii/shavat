{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"Kitsiptini mazinarangini, anoo kamankuri,","poem":1},{"lineBreak":true},{"text":"tputssha anoo k'kuz mangoonamaam nda zandkanaya.","poem":1},{"noteId":39},{"lineBreak":true},{"text":"Apanllsha Taarashipan wizpuree yámandarangu,","poem":1},{"lineBreak":true},{"text":"¿chakaja anoo mangoonach?","poem":1},{"noteId":40}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apanllsha wipunash Apanllee kukoo payumpanimuncha.","poem":1},{"lineBreak":true},{"text":"Tsap puzamunpaz ashiru kxoonarangiya.","poem":1},{"lineBreak":true},{"text":"Wachsha mantsireem ínarangusin,","poem":1},{"lineBreak":true},{"text":"¿chakaja waa kis napach?","poem":1},{"lineBreak":true},{"text":"¿Antaati waa kurakaam ínacheezich? Nda.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Atusin, tputsshitisin Apanllee wipunash nda kis naparusin,","poem":1},{"lineBreak":true},{"text":"zurampatari ngataranganaya.","poem":1},{"lineBreak":true},{"text":"Apanllsha wipunash kizpur kiyung kachiyarangiya.","poem":1},{"lineBreak":true},{"text":"Urutari kiyung kachiyku taarangiya.","poem":1},{"lineBreak":true},{"text":"¿Antaati kis pamaam waritak? Nda.","poem":1},{"lineBreak":true},{"text":"Iy tputsini niyraranguni,","poem":1},{"lineBreak":true},{"text":"¿Antaati in waritak? táranginiya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Itaru, iyamand wásuree, Ay, tárangiya.","poem":1},{"noteId":41},{"lineBreak":true},{"text":"Iysha, Apanll waana nee tputsee waneekiya.","poem":1},{"lineBreak":true},{"text":"Waana zandarangu, kiyung yachakiya, tárangtanicha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tárangitaatini, itaru iyamand yutaritshishini kiyung kachiyarangiya.","poem":1},{"lineBreak":true},{"text":"Yuwamand iy Apanllee kuku nda payurangini anumand mangoo kayungaranganaya.","poem":1},{"lineBreak":true},{"text":"Anumunsha, Apanll iyaa yutaritshishee mapiykiya.","poem":1},{"lineBreak":true},{"text":"Yuwamand kiyung kachiyarangu, anumand iyaa wanasirimsheem wayarangiya.","poem":1},{"noteId":42}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Itaru, iysha opeej tamaparee ashiruni mantsirish masaru taaranguni,","poem":1},{"noteId":43},{"lineBreak":true},{"text":"yuwari yaana zandkini anuri mapiyruni yutarit taarangini.","poem":1},{"lineBreak":true},{"text":"Itaru, Taarashipansha iyamand yutaritshishirini wipunashee yutaritaam ínarangiya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kizpuritaa kiyung yacharangsin,","poem":1},{"lineBreak":true},{"text":"ashiritaa muxarpaz ashiru kamiyarangiya.","poem":1},{"lineBreak":true},{"text":"Zaputaraa ashirangiya.","poem":1},{"lineBreak":true},{"text":"Opeejaatspaz ashirusin pachamaam machtarangusin,","poem":1},{"noteId":44},{"lineBreak":true},{"text":"nda pakchiyam yámarangiya.","poem":1},{"lineBreak":true},{"text":"Mishat, opeejaa pur kumaksin, nda pakchiyam yamtaru ashirangiya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nda tsiyatssee yaramaam zandarangsin,","poem":1},{"lineBreak":true},{"text":"yutaritap machtaranganaya.","poem":1},{"lineBreak":true},{"text":"Minamtiyam tputs, In wanasircha.","poem":1},{"lineBreak":true},{"text":"¿Mayaamaja kiyung yachamaam zandchich? nda tárangiya.","poem":1},{"lineBreak":true},{"text":"¿Chakaja, Nee tputs yutaritaam ínarintspa, tách?","poem":1},{"lineBreak":true},{"text":"taárashee izuuru kanatsipamamari machtarangana.","poem":1},{"lineBreak":true},{"text":"Apanllimand tiptsiri yutaritshishirini pacharanganaya.","poem":1},{"noteId":45}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sheersin, wanutsee mapurangusin,","poem":1},{"lineBreak":true},{"text":"yutaritshishpanpa tputs washunand wayaranganaya.","poem":1},{"lineBreak":true},{"text":"Uw yutaritshishirinee ndunarimuntaa,","poem":1},{"lineBreak":true},{"text":"kuk nduntam minamtiyam tsiyatarangu,","poem":1},{"noteId":46},{"lineBreak":true},{"text":"ashiritaa mangu pacharanganaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Taarashipansha waana wipunashee kiyung yachamaam zandarangiya.","poem":1},{"lineBreak":true},{"text":"Wipunashsha tputsimand yutaritshishirinee tuwapamaam waana zandarangu, ashirangiya.","poem":1},{"lineBreak":true},{"text":"Itaru, zapshinaa urutamari taachiya.","poem":1},{"lineBreak":true},{"text":"Waanaa tiptsiri yusur kis pangchiya.","poem":1},{"lineBreak":true},{"text":"Yuwamand ashirangu anumand Apanllsha tiptsir kukoo kis payuchinllinaya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Apanllsha wipunash kapung kiyung kachiyaru,","poem":1},{"lineBreak":true},{"text":"anumunsha yusur támeeru, kis 'sinish taachiya.","poem":1},{"lineBreak":true},{"text":"Ashkachu, mang' kis taachiya.","poem":1},{"lineBreak":true},{"text":"Taarashipan wipunash wanasirimshipan tputsee zapan tapachindachiya.","poem":1},{"lineBreak":true},{"text":"Watam tputsimand yutaritshish waana tuwaparanguwa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Anumunsha, Apanll wipunashee kizpur kurakaam ínachiya.","poem":1},{"lineBreak":true},{"text":"Wamari kasiru, taachiya. Itaru, kurak nllitaritsha ningach taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Kizpur shambatchiya.","poem":1},{"lineBreak":true},{"text":"Watam waanaatsi watsipun nda pachindaranguwa.","poem":1},{"lineBreak":true},{"text":"Yutaritshishpaneempaz ashirusin, wayaranganawa.","poem":1},{"noteId":47},{"lineBreak":true},{"text":"Itaru, ¿mangutaja ashirang?","poem":1},{"lineBreak":true},{"text":"Watam ichingaru tputseem yutaritshishirineem tuwaparanguwa.","poem":1},{"lineBreak":true},{"text":"Apanll tputseemani ashirangiya,","poem":1},"Anoo nuw Isáysi Apanllee wipunashee kamankina."]}],"footnotes":[{"noteId":39,"caller":"*","text":"Yuwaa nish átu anootstam Romshucheema 10.16 tayusima kamankiya.","reference":{"chapter":53,"verse":1}},{"noteId":40,"caller":"*","text":"Yuwaa nish átu anootstam Wanga 12.38 tayusima kamankiya.","reference":{"chapter":53,"verse":1}},{"noteId":41,"caller":"*","text":"Matiwa 8.17 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":53,"verse":4}},{"noteId":42,"caller":"*","text":"1 Pitoru 2.24 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":53,"verse":5}},{"noteId":43,"caller":"*","text":"1 Pitoru 2.25 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":53,"verse":6}},{"noteId":44,"caller":"*","text":"Apanll wanichu anu 5.6 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":53,"verse":7}},{"noteId":45,"caller":"*","text":"Yuwaa nish átu anootstam Tayaspatampani 8.32-33 tayusima kamankiya.","reference":{"chapter":53,"verse":8}},{"noteId":46,"caller":"*","text":"1 Pitoru 2.22 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":53,"verse":9}},{"noteId":47,"caller":"*","text":"Lukasa 22.37 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":53,"verse":12}}]},"thisChapterLink":"/api/cbu_wbt/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}