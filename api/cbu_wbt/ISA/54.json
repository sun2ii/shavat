{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":54,"content":[{"type":"heading","content":["Apanll urutari tiptsiree chinakiya"]},{"type":"verse","number":1,"content":[{"text":"Siy Irusarinshuchis, kiz mipish tamaparee ashirus taarangsa.","poem":1},{"lineBreak":true},{"text":"Tputsiris ndunari; iparis ndunarpaz ashiru taarangsa.","poem":1},{"lineBreak":true},{"text":"Natunaa, kizpur shambatangtsa.","poem":1},{"lineBreak":true},{"text":"Mangis kis, Jay, jay, tángtsa.","poem":1},"Watam Apanll Taarashipan atuwa.",{"text":"Kasamawtaa kiz wip zapan taachiya.","poem":1},{"lineBreak":true},{"text":"Wamari kasichiya yuw wazaranll taaru anootsi,","poem":1},{"noteId":48},"atiya."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pangeetsis aranginasha yápungangtsa.","poem":1},{"lineBreak":true},{"text":"Mapiyrus pangeemis tambtatssa.","poem":1},{"lineBreak":true},{"text":"Mbamari pashuchutssa.","poem":1},{"lineBreak":true},{"text":"Maachiritish zapan anush taachiya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Watam siy tputsiris zapan taachuwa.","poem":1},{"lineBreak":true},{"text":"Ningich watandaram taaksin, arangeemsha watandaram taachtamanaya.","poem":1},{"lineBreak":true},{"text":"Siyachich shitungeersin, wamari arapchee tputs kasichinllinaya.","poem":1},{"lineBreak":true},{"text":"Tputsee watsapun itutseersin, anushsha taachinllinaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pzirintspa, watam mapiyrus taatssawa.","poem":1},{"lineBreak":true},{"text":"Minamtiyam tputs siyaa mantsir tsiyatchazinllinaja.","poem":1},{"lineBreak":true},{"text":"Siyaa tpazamaam ndunshaparee.","poem":1},{"lineBreak":true},{"text":"Sirú kiz mashind ashirus taarangus, pazirpatis taarangus,","poem":1},{"lineBreak":true},{"text":"itaru natunaa, anoo chinacheezis.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tsapurunassee tinampansha siyaa chinaku,","poem":1},{"lineBreak":true},{"text":"siyaa wizanlleempaz ashiru yamayaru,","poem":1},{"lineBreak":true},{"text":"siysa anush kisa taatssa.","poem":1},{"lineBreak":true},{"text":"Uw kizpurcha. Apanll Taarashipancha.","poem":1},{"lineBreak":true},{"text":"Siyaa tapachindampancha.","poem":1},{"lineBreak":true},{"text":"Tsapurunassee zurampatari ksutkiya.","poem":1},{"lineBreak":true},{"text":"Apanlliritcha. Yuwartatam zitaminaris Israelarini chinarangu anuritamcha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Siysa kiz kamasin kasam ashirus","poem":1},{"lineBreak":true},{"text":"kapung kiyung kachiyarangsa.","poem":1},{"lineBreak":true},{"text":"Itaru, Apanllsha siyaa yusur kuruzeeru,","poem":1},"siyaa átcha."]},{"type":"verse","number":7,"content":[{"text":"Nuw siyaa natumasaam kasarangina.","poem":1},{"lineBreak":true},{"text":"Itaru natsha, nuw siyaa kapung nayanikuri,","poem":1},{"lineBreak":true},{"text":"yusur nuwapat kis taatssa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nuw kapung tsiyantaranguri,","poem":1},{"lineBreak":true},{"text":"natumasam siyaa suwayaruri, tapishurangina.","poem":1},{"lineBreak":true},{"text":"Ashirangtaati, itaru nuw siyaa uru chinarangina.","poem":1},{"lineBreak":true},{"text":"Nuw siyaa kizpur nayanikina,","poem":1},"Apanll Taarashipan siyaa átcha,",{"text":"watam siyaa tapachindampanawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":["Apanll ateeja:",{"text":"Sirútama yuwapur nuw tsapurunasee kungupat waneerangi,","poem":1},{"lineBreak":true},{"text":"anpursha nuw zurampatari Nowerineetsi tárangina. Ayamtaatiya yusur kungupat nuw wanicheezi, tárangina.","poem":1},{"lineBreak":true},{"text":"Natsha nuw siyaa zurampatartatam atashina.","poem":1},{"lineBreak":true},{"text":"Ayamtaatiya yusur nuw siyaa kiyung yachacheezi.","poem":1},{"lineBreak":true},{"text":"Mishat, siyaa mantsir tsiyatcheezi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mach íwar nllitaritap naanataraa ashkachtaatiya,","poem":1},{"lineBreak":true},{"text":"tsapush pantsaktaatiya,","poem":1},{"lineBreak":true},{"text":"ashiritaa nuw siyaa uru chinachina.","poem":1},{"lineBreak":true},{"text":"Nuw siyapa amikurtaranguri,","poem":1},{"lineBreak":true},{"text":"siyaam mapiyshish uru panachintspa, táranguri,","poem":1},{"lineBreak":true},{"text":"nuwaanaatsi kuki uru tuminchima.","poem":1},{"lineBreak":true},{"text":"Nuw siyaa uru nayanikina,","poem":1},"Apanll Taarashipan siyaa Irusarinshuchis áttanda. Yaktaa Irusarina yusur kaneesich panguchima, Apanll átcha Apanll ateeja:"]},{"type":"verse","number":11,"content":[{"text":"Siyaa yaktaris pangis yurangamaa.","poem":1},{"lineBreak":true},{"text":"Sin sinaku, kambusur kizpur kambustaku, pangeetsis kapeetataraa ashirangu,","poem":1},{"lineBreak":true},{"text":"siy yuwapur kiyung kachiyarangis,","poem":1},{"lineBreak":true},{"text":"anpur minamtiyam tputs siyaa istarangeeja.","poem":1},{"lineBreak":true},{"text":"Wayanut siy ashirangtaateesa, natsha nuw siyaa uru istachintspa.","poem":1},{"lineBreak":true},{"text":"Patumbichpa kawambanamashpa pangeemis panguchima.","poem":1},{"lineBreak":true},{"text":"Patumbich mbammashish chumbeepamashish pangis taatssa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Torre tsangampaneemsha chumbeepamashtam pashuchchima.","poem":1},{"lineBreak":true},{"text":"Patumbichpat kurakurtaru anpat yaktareetsis tandapunuyaruri, íwar iturpichima.","poem":1},{"lineBreak":true},{"text":"Washtangashsha zar tamapari ashiru tuwasiniru taachiya.","poem":1},{"noteId":49}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Anush taakchus, nuwaana ipareetsis tayaspatachima.","poem":1},{"noteId":50},{"lineBreak":true},{"text":"Ashkachuri, anush iparshitis uru kis taachinllinaya.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Siysa tsiyatsis mantsirimshee itsinsaru yasakus,","poem":1},{"lineBreak":true},{"text":"kizpursha taatssa.","poem":1},{"lineBreak":true},{"text":"Ayamtaati tputs siyaa kiyung yachachazichinllinaja.","poem":1},{"lineBreak":true},{"text":"Siy ndusha punitssa.","poem":1},{"lineBreak":true},{"text":"Yutaritshishsha siyash ayamamtiyam yusur nda tushiychiya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tputs siyapa waratamaam zandkitaatiya,","poem":1},{"lineBreak":true},{"text":"nda nuwamand xarashish siyaa waratchinllinaya.","poem":1},{"lineBreak":true},{"text":"Ashiritaa, siyamari kasitssa,","poem":1},"Apanll siyaa átcha."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Napangcha. Nuwaana tputsireetsi ngusambamsheem ínarangina.","poem":1},{"lineBreak":true},{"text":"Tputs ngusambaa sumasish kizpur ksaneeyaru,","poem":1},{"lineBreak":true},{"text":"maachee ichingaru waratamaam tinakiya.","poem":1},{"lineBreak":true},{"text":"Nuwaantatam tputsee pachampaneem ínarangina.","poem":1},{"lineBreak":true},{"text":"¿Chakaja uwapat waritaku waritach?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kizpuritaa taaksin,","poem":1},{"lineBreak":true},{"text":"siyaatssha kasimaam wanindaja.","poem":1},{"lineBreak":true},{"text":"Tputs siyaa yutaritaam ínaktaatssin,","poem":1},{"lineBreak":true},{"text":"ashiritaa siysa yámkus, zamaru taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Tputs uru nuwaa chinakchusin,","poem":1},{"lineBreak":true},{"text":"nuwaa kuki payukchusin,","poem":1},{"lineBreak":true},{"text":"nuwsha anoo tputsee istakchuri,","poem":1},{"lineBreak":true},{"text":"urutamari wamari kasichinllinaya,","poem":1},"Apanll Taarashipan zurampatari siyaa átcha."]}],"footnotes":[{"noteId":48,"caller":"*","text":"Yuwaa nish átu anootstam Gálatasshcheema 4.27 tayusima kamankiya.","reference":{"chapter":54,"verse":1}},{"noteId":49,"caller":"*","text":"Apanll wanichu anu 21.18-21 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":54,"verse":12}},{"noteId":50,"caller":"*","text":"Wanga 6.45 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":54,"verse":13}}]},"thisChapterLink":"/api/cbu_wbt/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}