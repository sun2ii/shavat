{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":55,"content":[{"type":"heading","content":["Apanll uru shiyaa zandkiya"]},{"type":"verse","number":1,"content":[{"text":"Neewa. Shiy sachitkush, nuwash waangcha.","poem":1},{"noteId":51},{"lineBreak":true},{"text":"Kurikirish nduntaa payurush, ashiritaa, Neewa, atina.","poem":1},{"lineBreak":true},{"text":"Nuwaa mashkush, nuwsha ngutiriti istachinllpa.","poem":1},{"lineBreak":true},{"text":"Kis waangcha. Ksatam ktungangcha.","poem":1},{"lineBreak":true},{"text":"¿Antaati anumand nuw, Tuwapanda tácheezi? Ndambari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Mayaamaja shiy ngutish kurikee katungtsimand kucharimand kpunimand itsanchish?","poem":1},{"lineBreak":true},{"text":"¿Mayaamaja kurikingaz zapan zaree tarawuztakush,","poem":1},{"lineBreak":true},{"text":"kiyung kachiykush,","poem":1},{"lineBreak":true},{"text":"katungtseem kapungtaa kapeetkush,","poem":1},{"lineBreak":true},{"text":"ashiritaa nda tazazarush taachsha?","poem":1},"Nuwaa kuki kaapaniri mazinangcha.",{"text":"Nuwaa mashkush, nuw shiyaa wanasir istachinllpa.","poem":1},{"lineBreak":true},{"text":"Tazazapaz ashirush, kis taatsha.","poem":1},{"lineBreak":true},{"text":"Katungtseempaz ashiru kis katungatsha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuwaa mashkinaareesha, nuwaa kuki mazinakinaareesha,","poem":1},{"lineBreak":true},{"text":"kisshaparee taatsha,","poem":1},"zurampatari nuw shiyaa atashina.",{"text":"Nuw shiyapa tsiyatssee yarkachuri,","poem":1},{"lineBreak":true},{"text":"shiyapa amikurtakchuri,","poem":1},{"lineBreak":true},{"text":"zurampatari nuwaanaatsi kuki tuminchima.","poem":1},{"lineBreak":true},{"text":"Amb ashkachuri, Dapiyarinimand chinakuri,","poem":1},{"lineBreak":true},{"text":"nuw kuki Dapiyarinpat tatsamchima.","poem":1},{"noteId":52}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sirú nuw arapchee tputs, Dapiyaa napangtsa.","poem":1},{"lineBreak":true},{"text":"¿Waninll chinakinawa? tárangina.","poem":1},{"lineBreak":true},{"text":"Dapiyamand tputs ichingarusin nuwaa chinachinllinaya.","poem":1},{"lineBreak":true},{"text":"Dapiy ztaroo tputsee wamari kasiriya, táranginawa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dapiychich arapchee tputs kuruzkiya.","poem":1},{"lineBreak":true},{"text":"Nduntaa wach parangu,","poem":1},{"lineBreak":true},{"text":"nduntaa Dapiyarinichichee yasarangusin,","poem":1},{"lineBreak":true},{"text":"ashiritaa Dapiyap iripuptaraa ashchinllinaya.","poem":1},{"lineBreak":true},{"text":"Nuw Taarashipaneeruri, Israelchichee Apanllirini taakuri,","poem":1},{"lineBreak":true},{"text":"Dapiyarinchichee kizpur kurakaam ínachima,","poem":1},"Apanll Dapiyarinchichee átcha.",{"lineBreak":true},"Nuwsha Isáysi siyaa atashina."]},{"type":"verse","number":6,"content":[{"text":"Mikeerus Taarashipanee nachungangtsa.","poem":1},{"lineBreak":true},{"text":"Ndatuma tsípachu, chinangtsa.","poem":1},{"lineBreak":true},{"text":"Nduma arap naachu, kuruzeerus, Apaa, tángtsa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yutaritshishpanis, yutaritshishireetsis izuuru kasayarus, Apanllee mangoonangtsa.","poem":1},{"lineBreak":true},{"text":"Kitsis mitsshartawis mantsir chinarintspa.","poem":1},{"lineBreak":true},{"text":"Apanllee yusur chinangtsa.","poem":1},{"lineBreak":true},{"text":"Ashkachinaareesa, siyaa nayinichintsa.","poem":1},{"lineBreak":true},{"text":"Siyaa mangeetsis yarchiya.","poem":1},{"lineBreak":true},{"text":"Yutaritshireetsis ichingaru mbizachiya,","poem":1},{"lineBreak":true},{"text":"watam siyaa kizpur chinakuwa,","poem":1},"nuw siyaa atashina.",{"lineBreak":true},"Apanll waana ateeja:"]},{"type":"verse","number":8,"content":[{"text":"Siy nuwapa chinashi nda waritaksa.","poem":1},{"lineBreak":true},{"text":"Yuwari nuw zandki, nuwsha anuri ashtachima.","poem":1},{"lineBreak":true},{"text":"Pzitamaam nuw yasareezi. ¿Antaati nuw tputseezi?","poem":1},{"lineBreak":true},{"text":"Napa: kanind kizpur tsapoo kánuruwa.","poem":1},{"lineBreak":true},{"text":"Nuwsha ashiritamti shiyaa kánuritamti.","poem":1},{"lineBreak":true},{"text":"Apanlleeruri siyaa kasirina,","poem":1},"Apanll siyaa átcha."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sin kamaparee,","poem":1},{"lineBreak":true},{"text":"kanindap pantsakchu,","poem":1},{"lineBreak":true},{"text":"tsapush zaw shitaranllu, kachachtakchu,","poem":1},{"lineBreak":true},{"text":"maacheetsi ichingaru yanungakchu,","poem":1},{"lineBreak":true},{"text":"anootssha siysa kis katungkachpasa.","poem":1},{"noteId":53},{"lineBreak":true},{"text":"¿Antaati sin waptam kanindpitam kanapcheeja? Nda.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nuw tsiyatkuri, sin ashiru kuki tsiyatkina.","poem":1},{"lineBreak":true},{"text":"Kuki tsiyatkuri, tputsee istakiya.","poem":1},{"lineBreak":true},{"text":"Kamachtakuri, tputssha anuritam payukanaya.","poem":1},{"lineBreak":true},{"text":"Nuw ngutariti nda tsiyatkina.","poem":1},{"lineBreak":true},{"text":"Nuwaanaatsi kuki zurampatari payukina.","poem":1},{"lineBreak":true},"Nuw Apanlli siyaa atashina."]},{"type":"verse","number":12,"content":[{"text":"Siynaa na araptaa taakus,","poem":1},{"lineBreak":true},{"text":"nuwsha siyaa tashitungakchuri,","poem":1},{"lineBreak":true},{"text":"shamangarush naatssa.","poem":1},{"lineBreak":true},{"text":"Mapiyrus pangipis kanaputssa.","poem":1},{"lineBreak":true},{"text":"Siyamari mangis kis taatssa.","poem":1},{"lineBreak":true},{"text":"Mishat, machsha íwar shambatchinllinaya;","poem":1},{"lineBreak":true},{"text":"yaseekpaz ashchinllinaya.","poem":1},{"lineBreak":true},{"text":"Uw tuwat tuwat ashikpaz ashchinllinaya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kapsha ndusha mzatsish karutachiya.","poem":1},{"lineBreak":true},{"text":"Karipan kisshapari kxunchiya.","poem":1},{"lineBreak":true},{"text":"Karipan taakchu,","poem":1},{"lineBreak":true},{"text":"simbunsha ksatam kanungchiya.","poem":1},{"lineBreak":true},{"text":"Ashkachuri, tputs ichingarusin nuwaa, Taarashipaneetsi, yasachinllinaya.","poem":1},{"lineBreak":true},{"text":"Nuwaa chinachinllinaya.","poem":1},{"lineBreak":true},{"text":"Urutamari nuwaa mangoonachshapsinaya,","poem":1},"Apanll Taarashipan, Zurampatari nuw siyaa zandkina, tárangiya."]}],"footnotes":[{"noteId":51,"caller":"*","text":"Wanga 7.37-38; Apanll wanichu anu 21.6; 22.17 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":55,"verse":1}},{"noteId":52,"caller":"*","text":"Tayaspatampani 13.34 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":55,"verse":3}},{"noteId":53,"caller":"*","text":"2 Koríndshucheema 9.10 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":55,"verse":10}}]},"thisChapterLink":"/api/cbu_wbt/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":12}