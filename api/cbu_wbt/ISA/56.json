{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":56,"content":[{"type":"heading","content":["Siy Apanlleetsimari kuk payukus, Apanllsha siyaa kis napchintsa"]},{"type":"verse","number":6,"content":[{"text":"Arapich tputs, kandoozeew nuwaatsimari kuki payukchusin,","poem":1},{"lineBreak":true},{"text":"nuwaatsimari chinakchusin,","poem":1},{"lineBreak":true},{"text":"nuwsha tputsireemi ínachima.","poem":1},{"lineBreak":true},{"text":"Zar kanusishshee ndunnaa yankusin,","poem":1},{"lineBreak":true},{"text":"kis anush kanuskusin,","poem":1},{"lineBreak":true},{"text":"yuwaa tárangi anoo ndunnaa kapeetkusin,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"nuwsha kis napkuri,","poem":1},{"lineBreak":true},{"text":"machip Irusarinap machchima.","poem":1},{"lineBreak":true},{"text":"Anush, nuwash pangi kis nuwapa tsiyatchinllinaya.","poem":1},{"lineBreak":true},{"text":"Mashkusin, nuwsha kis mazinachina.","poem":1},{"lineBreak":true},{"text":"Maacheetsi sumasimun muchkusin,","poem":1},{"lineBreak":true},{"text":"anoo kisshaparee nuw napchima.","poem":1},{"lineBreak":true},{"text":"Watam ztaru tputseem shaniymaam nuw pangi taaruwa.","poem":1},{"lineBreak":true},{"text":"Anush kandoozeew ichingarusin nuwaa tsiyatchinllinaya.","poem":1},{"noteId":54}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tputs arap pseertarangitaatssin,","poem":1},{"lineBreak":true},{"text":"nuwsha pangipi anoo tputs machchina.","poem":1},{"lineBreak":true},{"text":"Nllitaritap tputs watsapun taarangtaatssin,","poem":1},{"lineBreak":true},{"text":"nuwashsha shaniychinllinaya.","poem":1},{"lineBreak":true},{"text":"Nuw tputsireetsi Israelchichee ashchitamana.","poem":1},{"lineBreak":true},{"text":"Araptaa pseertarangusin,","poem":1},{"lineBreak":true},{"text":"nuwsha yamayaruri,","poem":1},{"lineBreak":true},{"text":"nuwashsha kis napchinllinaya,","poem":1},"Apanll Taarashipan siyaa tárangiya. Ashirucha, nuw Isáysi siyaa, Apanlleetsimari kuk payukus, Apanllsha siyaa kis napchintsa, atina."]}],"footnotes":[{"noteId":54,"caller":"*","text":"Matiwa 21.13; Márkosa 11.17; Lukasa 19.46 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":56,"verse":7}}]},"thisChapterLink":"/api/cbu_wbt/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":3}