{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":58,"content":[{"type":"heading","content":["Zurampatari nuwaa mangoomaam piy shingcha, Apanll átcha58:0 Matiwa 6.16-18 tsiyatsis nipta tatsamooru taaritamta."]},{"type":"verse","number":1,"content":["Apanll Taarashipan nuwaa tárangiya.",{"text":"Kizpur tsiyatangcha. Pzirinllpa.","poem":1},{"lineBreak":true},{"text":"Wakar wits tamaparee ashiru kapung zunganeengcha.","poem":1},{"lineBreak":true},{"text":"Nuwaa tputsiri waneengcha, watam yutarit taakanawa.","poem":1},{"lineBreak":true},{"text":"Akoparinchich tputs yutaritshishee kis chinakanaya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Uru nuwaa mangutari chinamanaa chinakanaya.","poem":1},{"lineBreak":true},{"text":"Mishat, nuwaa yandamari mangutaritam uwish kis payukanaya.","poem":1},{"lineBreak":true},{"text":"Kamachmareetsi kizpur payupani mangu atanaya.","poem":1},{"lineBreak":true},{"text":"Nuwaa, Itsinsar iyaa Apanll yasachpa, mangu atanaya.","poem":1},{"lineBreak":true},{"text":"Nuwash pangi kis pshtukanaya, nuwapa tsiyatamaama. Itaru, mangu ashkanaya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuwaa atanaya:","poem":1},{"lineBreak":true},{"text":"¿Mayaamaja katungtsee ngutich manguchich? ¿Watam Apanll nda chiyaa pakuwa?","poem":1},{"lineBreak":true},{"text":"¿Mayaamaja Apanlleem mangukuch, ngutich kiyung kachiychich?","poem":1},{"lineBreak":true},{"text":"¿Antaati Apanll yuwaa chiy manguchich anoo pakeeru, chiyaa chinacheeja? átssa siya.","poem":1},"Itaru, nuw Apanlli siyaa atina.",{"text":"Zaree mangumaam nuw siyaam wayarangitaati,","poem":1},{"lineBreak":true},{"text":"itaru siysa anush zar nda wanasir taaksa.","poem":1},{"lineBreak":true},{"text":"Anush zar ngutis paxanxatangat ashiksa.","poem":1},{"lineBreak":true},{"text":"Tputsee tupatangakus, nduntam tatsamooru tuwapaksa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Saanpatatis natsatangat ashkus,","poem":1},{"lineBreak":true},{"text":"waratatangat ashiksa.","poem":1},{"lineBreak":true},{"text":"Muchoo putayarus, tiyá tiyá ashkus,","poem":1},{"lineBreak":true},{"text":"mangushishsha zar nuwaa mashkus,","poem":1},{"lineBreak":true},{"text":"¿antaati siyaa kukis nuw ksaja mazinachi?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mishat, Iy Apanllimand wamin kiyung kachiykini, anumand","poem":1},{"lineBreak":true},{"text":"Apanll iyaa kisparee napchiya, ngutis átus,","poem":1},{"lineBreak":true},{"text":"muchis timuchkus,","poem":1},{"lineBreak":true},{"text":"kóstaramun kxumaw tamutamur ashkus,","poem":1},{"lineBreak":true},{"text":"Piy ashkuni, zurampatari mangukaniya.","poem":1},{"lineBreak":true},{"text":"Apanll anoo pakeeru, chiyaa wanasir napchiya, átssa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Antaati Apanll anoo ksaja napach? Nda.","poem":1},{"lineBreak":true},{"text":"Na wanasiri anoo zurampatari kamanchintspa,","poem":1},"Apanll ateeja.",{"text":"Tputs nduntaa yutarit taarangana, anumand siysa natsakus, tumanshishush kiyung yachatssa.","poem":1},{"lineBreak":true},{"text":"Anoo tputsi tashitungangtsa.","poem":1},{"lineBreak":true},{"text":"Tputs watumshirimand tuwapamaam pinasakana,","poem":1},{"lineBreak":true},{"text":"anoo siysa istayarus ksangtsa.","poem":1},{"lineBreak":true},{"text":"Tputs m'chachurtaku anoo itutsingtsa.","poem":1},{"lineBreak":true},{"text":"Ashkachus, siy tputsee kiyung yachamaam zurampatari kasatssa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tputs mariz kayatku anoom watungasheem panangtsa.","poem":1},{"lineBreak":true},{"text":"Pukiree tputs istakus, pangishis ishinangtsa.","poem":1},{"lineBreak":true},{"text":"Pukir watunir ndunareewa pakchus, istangtsa.","poem":1},{"lineBreak":true},{"text":"Kandoozpatatis, tunareetstaa wanasiri ishinangtsa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ashkinaareesa, zar shitungachu kizpur 'sinitaru ashiritam kizpur 'sineekus,","poem":1},{"lineBreak":true},{"text":"nuwsha siyaa kis napchintspa.","poem":1},{"lineBreak":true},{"text":"Itsinsaru taakus, tputs siyaa wanasirishaparee napachinllinaya.","poem":1},{"lineBreak":true},{"text":"Yuwaa kiyung kachiyarangis anoo izuuru pastachshaparee.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nuwaatssha, Istanda tákchus, nuwsha zurampatari mazinachina.","poem":1},{"lineBreak":true},{"text":"Nuwaa kizpur kuruzkachus, nuwsha, ¿Maya? Ashiriya, istachinllpa, táchshaparina.","poem":1},{"lineBreak":true},{"text":"Siysa, Izuuru ayamtaatiya tputsee kiyung yachacheezi, tákchus,","poem":1},{"lineBreak":true},{"text":"tputsee ndunnaa mantsir tsiyatkus,","poem":1},{"lineBreak":true},{"text":"nduntam yutarit ínakus,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"yuw tputs marizimun tsipakana anoo shaantari watungasheem mbaseerus panakchus,","poem":1},{"lineBreak":true},{"text":"yuw kiyung kachiyku anoom ngutiritis istakus,","poem":1},{"lineBreak":true},{"text":"ashkus, siysa 'sineekpaz ashirus taaksa.","poem":1},{"lineBreak":true},{"text":"Yuw saana kiyung kachiykis an ndunichshaparee.","poem":1},{"lineBreak":true},{"text":"Wazareetsiri taatssa, zar wachamuree tamaparee ashiru.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nuwaana siyaa imachchintsa.","poem":1},{"lineBreak":true},{"text":"Tsap puzap taaktaateesa,","poem":1},{"lineBreak":true},{"text":"anush nuwsha siyaam katungsheemis zapan panachintsa.","poem":1},{"lineBreak":true},{"text":"Nutseetsis tuwizpurtachina.","poem":1},{"lineBreak":true},{"text":"Tatsumim tamapari ashirus wanasirshapari kis taatssa.","poem":1},{"lineBreak":true},{"text":"Kung uru zaw ashtaru, ashku siyaam pishtats ndunshaparee.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Siysa pangeetsis yurangamaw yusur wanasir pangutssa.","poem":1},{"lineBreak":true},{"text":"Yuwashtam zitaminaris kis taarangana anshutam taatssa.","poem":1},{"lineBreak":true},{"text":"Tputs siyaa, Tandapunumpansincha, táchinllinaya.","poem":1},{"lineBreak":true},{"text":"Mishat, In tputs pangumpansincha, siyaa táchtamanaya.","poem":1},"Apanll siyaa átcha. Uru zar kanusish chinangtsa Aparini siyaa ateeja."]},{"type":"verse","number":13,"content":[{"text":"Zar kanusissheem nuw wayaranguri,","poem":1},{"lineBreak":true},{"text":"Anush zar kanusangtsa, siyaa táranginawa.","poem":1},{"lineBreak":true},{"text":"Ashiriya, nuwaa kuki kpitintspa, atashina.","poem":1},{"lineBreak":true},{"text":"¿Mayaamaja anush zar paxanxtangat ashiksa?","poem":1},{"lineBreak":true},{"text":"Kanusisish mangis kis shambatangtsa.","poem":1},{"lineBreak":true},{"text":"Anush zar uru nuwaa chinangtsa, watam nuwaana wayaranginawa.","poem":1},{"lineBreak":true},{"text":"¿Mayaamaja anush zar tarawazureemis chinachis?","poem":1},{"lineBreak":true},{"text":"Yuwari zandkich anoo ¿mayaamaja ashtachich?","poem":1},{"lineBreak":true},{"text":"¿Antaati piy ashkus wanasireeja?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Zar kanusish nuwaam kanuskachinaareesa,","poem":1},{"lineBreak":true},{"text":"nuwamun kisshaparee taatssa.","poem":1},{"lineBreak":true},{"text":"Nuwsha siyaa istakachuri,","poem":1},{"lineBreak":true},{"text":"uru siyamari kasirus taatssa.","poem":1},{"lineBreak":true},{"text":"Zitaminaris Akoparini siyaam wanasir tsiyatarangu,","poem":1},{"lineBreak":true},{"text":"anoo kis pangatssa,","poem":1},"waana iy Aparini Taarashipan siyaa tárangiya."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":14}