{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":6,"content":[{"type":"heading","content":["Waana Apanll nuwaa, Isáysaatsi kamachtarangiya"]},{"type":"verse","number":1,"content":["Yuwapur kurak Usiyas tsiparangu, anpur nuw Apanllee parangina. Taarashipan kizpur 'sineerangu, wamari kasiru, waanamun watsirar kuxinarangiya. Watunir wazuraneeru, waanaatsi pang' purangiya."]},{"type":"verse","number":2,"content":["Waana tiptsir sumas ashiru Apanllimun iwaz itureeranganaya. Ichingaru wazitpungach 6 taarangiya. Wazitpungachpa tsimbun waanaatsi wach kámanarangiya. Tsimbunatam wanutsee watspatari kámanarangitamta. Itaru, tsimbunatam mangaktangat ashiranganaya. Waanpatatin tsiyatkusin, táranganaya:"]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Apanll Taarashipan wamari kasiriya.","poem":1},{"noteId":3},{"lineBreak":true},{"text":"Wanasiriri chinakiya. Wanasiriri taakiya.","poem":1},{"lineBreak":true},{"text":"Kizpur wanasir 'sineekiya.","poem":1},{"lineBreak":true},{"text":"Tsapurunas shuneeriya wanasirimshirini,","poem":1},{"lineBreak":true},"ántar ashiranganaya."]},{"type":"verse","number":4,"content":["Kizpur zunganeerangusin, Apanll pang' washitungash zpuzarangiya. Pangush wantsush msas tuwap mzeezarangiya.",{"noteId":4}]},{"type":"verse","number":5,"content":["Anoo paranguri, nuwsha, Sitatstee. Nishuripa tsipachina, watam kchipti Apanllee nuw pakeenawa. Kurakari wamari kasiru anoo pakeenawa. ¿Tamari nuw mantsirimshee tsiyatkuri taaki? Nuw tputspa yutaritamashpa taakina. Sitatstee, tárangina."]},{"type":"verse","number":6,"content":["Amb táranguri, Apanllsha tiptsir sumas ashiru nuwanung mangarangiya. Kucharash masunll Apanllish wasum yáyaru,"]},{"type":"verse","number":7,"content":["nuwash kuki chka' ashirangiya. Nuwaatssha,",{"lineBreak":true},{"text":"Masunll k'keetsish kandanirangu,","poem":1},{"lineBreak":true},{"text":"na yutaritshishireetsish ichingaru tachingarangiya.","poem":1},{"lineBreak":true},{"text":"Apanll shiyaa yutaritshishireetsish zurampatari mbizayanlliya,","poem":1},{"lineBreak":true},"nuwaa tárangiya."]},{"type":"verse","number":8,"content":["Tárangu, Apanllsha waana tsiyatku kímarangu, nuwaa tárangiya.",{"lineBreak":true},{"text":"¿Chakaatseeja nuw zangankachee?","poem":1},{"lineBreak":true},{"text":"¿Chakaatseeja nuwaa kuki kamanipaneem ínachee?","poem":1},{"lineBreak":true},"tárangu, nuwsha,",{"lineBreak":true},{"text":"Apaa, nuwaa kamanipaneem ínayarush, zanganingandama,","poem":1},{"lineBreak":true},"tárangina."]},{"type":"verse","number":9,"content":["Apanllsha,",{"lineBreak":true},{"text":"Nuw shiyaa zanganchinllpa.","poem":1},{"lineBreak":true},{"text":"Naayarush, tputsi yutaritaa Israelchichee kamanishini. Apanll ateeja, tángcha.","poem":1},{"lineBreak":true},{"text":"Nuwaa kuki zapantaa mazinakus,","poem":1},{"lineBreak":true},{"text":"ashiritaa nda mangoonaksa.","poem":1},{"lineBreak":true},{"text":"Nuw kizpur istaktaati, anoo pakitaateesa,","poem":1},{"lineBreak":true},{"text":"nduntam mangeetsis p'tsichima.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Siyaa mangeetsis tamiroosinlltakchuri,","poem":1},{"lineBreak":true},{"text":"kitseetstamtis tamirkachuri,","poem":1},{"lineBreak":true},{"text":"kcheetstamtis kámanakchuri,","poem":1},{"lineBreak":true},{"text":"siysa ¿tamareeja mangoonchis?","poem":1},{"lineBreak":true},{"text":"¿Antaati mazinacheezis?","poem":1},{"lineBreak":true},{"text":"¿Nitaati pangcheezis? Ndambaree.","poem":1},{"lineBreak":true},{"text":"Mangoontapa, siyaa aturi,","poem":1},{"lineBreak":true},{"text":"nda siyaa yaramaam zurampatari zandkina.","poem":1},{"noteId":5},{"lineBreak":true},"Apanll átcha tángcha, tárangiya nuwaatsi."]},{"type":"verse","number":11,"content":["Nuwsha, Apaa, ¿ashinooja amb ashchinllina? táranguri, Apanllsha,",{"lineBreak":true},{"text":"Anoo tputs izuuru kachiykachuri,","poem":1},{"lineBreak":true},{"text":"pakchimarisha katuchkachu,","poem":1},{"lineBreak":true},{"text":"anootsimsha ayam zapish yusur tputsireetsi chinachima.","poem":1},{"lineBreak":true},{"text":"Israelchichee yaktarini izuuru pátangachinllinaya.","poem":1},{"lineBreak":true},{"text":"Ashkatssin, tputs ndunichparee.","poem":1},{"lineBreak":true},{"text":"Pangush minamtiyam tputs nda taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Mázarish mangu kuree ashtachinllinaya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nuw anoo tputs arap minup tsap tuzanganeekchuri,","poem":1},{"lineBreak":true},{"text":"Utaáchchish watsapun tputs izuuru ndunichiya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wandaya chungaa arangeem tputs minam taarinaariya,","poem":1},{"lineBreak":true},{"text":"anootstam kapeetchima.","poem":1},{"lineBreak":true},{"text":"Yasinaa washitanee tuwayaruch,","poem":1},{"lineBreak":true},{"text":"izuuru kapeetkachuch,","poem":1},{"lineBreak":true},{"text":"Puchimsha pshkoorutar ashtaru ashtachiya.","poem":1},{"lineBreak":true},{"text":"Itaru, xixpurootspaz ashiru tputsireemi yusur katuchimaa wayachima.","poem":1},{"lineBreak":true},{"text":"Annaa tputs nuwaa kuki mazinachinllinaya.","poem":1},{"lineBreak":true},{"text":"Anush tputsireetsi yusur chinachima,","poem":1},{"lineBreak":true},"tárangiya Apanlli nuwaatsi. Ashirucha, Apanll nuwaa Israelchichee tputsee kamanimaam nuwaa zanganirangiya."]}],"footnotes":[{"noteId":3,"caller":"*","text":"Apanll wanichu anu 4.8 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":6,"verse":3}},{"noteId":4,"caller":"*","text":"Apanll wanichu anu 15.8 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":6,"verse":4}},{"noteId":5,"caller":"*","text":"Yuwaa nish átu anootstam Matiwa 13.14-15; Márkosa 4.12; Lukasa 8.10; Wanga 12.40; Tayaspatampani 28.26-27 tayusima kamankiya.","reference":{"chapter":6,"verse":10}}]},"thisChapterLink":"/api/cbu_wbt/ISA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}