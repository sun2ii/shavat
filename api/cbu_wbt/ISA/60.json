{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":60,"content":[{"type":"heading","content":["Yakat Irusarina kizpur wanasir taachiya"]},{"type":"verse","number":1,"content":[{"text":"Irusarinshuchis, chiyzangints.","poem":1},{"lineBreak":true},{"text":"Wanasirimish na taartanda.","poem":1},{"lineBreak":true},{"text":"Watam Apanll siyash kuseenlluwa.","poem":1},{"lineBreak":true},{"text":"Siyaa wanasir paku, kis napchiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tsapurunasish ichingaru tunee ashikcha.","poem":1},{"lineBreak":true},{"text":"Piyartach tputs tapishpaz ashiru pátangtangat ashkanaya.","poem":1},{"lineBreak":true},{"text":"Itaru, Apanllsha Taarashipani siyaam tuwasineekpaz ashkiya.","poem":1},{"lineBreak":true},{"text":"Apanll wanasirimish siyash kis taachiya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Arapich tputs siyaa wanasirimshee pakchusin,","poem":1},{"lineBreak":true},{"text":"siyangaz kizpur zandchinllinaya.","poem":1},{"lineBreak":true},{"text":"Urkartam ichingarusin siyap naachinllinaya.","poem":1},{"lineBreak":true},{"text":"Siy zarpaz ashiru taakchus, siyangaz zandachpasinaya.","poem":1},{"noteId":55}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Siy ichingaroo napangtsa.","poem":1},{"lineBreak":true},{"text":"¿Kamaparee arapich tputs siyap kus kus ashchinllinaya?","poem":1},{"lineBreak":true},{"text":"Siyash Irusarinush shaniypani atanaya.","poem":1},{"lineBreak":true},{"text":"Siyachich tputs tsapurunasush arap taaktaatssin,","poem":1},{"lineBreak":true},{"text":"siyash kuschinllinaya.","poem":1},{"lineBreak":true},{"text":"Siyachchee kizanur pachipeersin, yusur siyash wayachinllinaya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Anoo pakeerus, kachis munitssa.","poem":1},{"lineBreak":true},{"text":"Ashkachus, mangis kis shamangarus taatssa.","poem":1},{"lineBreak":true},{"text":"Kuskusin, musash marush arachich kurikee zapan yachinllinaya.","poem":1},{"lineBreak":true},{"text":"Arapich tputs siyaa chinakchusin,","poem":1},{"lineBreak":true},{"text":"kurikee ¿wanipaja siyaam panachinllina?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kameech zapan shurangaru, anush","poem":1},{"lineBreak":true},{"text":"siyaam kurikee, mishat yasin kzammasheetstam wayawaytangat ashtachinllinaya.","poem":1},{"lineBreak":true},{"text":"Madiyanamand, Efamandtam, Sambamandtam káyarusin, siyaam wayachinllinaya.","poem":1},{"lineBreak":true},{"text":"Siyaa pakchusin,","poem":1},{"lineBreak":true},{"text":"¿Apanll tamara? ¿Waninll Irusarinshuchee istaka? táchinllinaya siyaatsiya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Siyaam Kedarshuch opeejarini panachinllinaya.","poem":1},{"lineBreak":true},{"text":"Siysa Nebayotshuchee opeejarini karupan Apanlleem muchitssa.","poem":1},{"lineBreak":true},{"text":"Anoo pachayarus, Apanllimun wasuma wayatssa.","poem":1},{"lineBreak":true},{"text":"Kisshaparee Apanll anoo ishingku,","poem":1},{"lineBreak":true},{"text":"waanaatsi pangu kis chinachiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¡Napangtsa! ¿Chak an tputs msaspaz ashirusin kanindap naanataraa ashkana?","poem":1},{"lineBreak":true},{"text":"¿Chak an mukukpaz ashirusin waanpee purangataraa ashkana?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pa. Mundariy zapan washunand kambusurush naakana.","poem":1},{"lineBreak":true},{"text":"Társisshuch múndariy imazakanaya.","poem":1},{"lineBreak":true},{"text":"Irusarinchich nlluranur araptaa taarangsin,","poem":1},{"lineBreak":true},{"text":"zaruyarusin kuskanaya.","poem":1},{"lineBreak":true},{"text":"Oroo xanatkana. Kurikee mbammash zapantam wayakanaya.","poem":1},{"lineBreak":true},{"text":"Israelchichee Apanllirini kizpur chinaksin,","poem":1},{"lineBreak":true},{"text":"Taarashipanee kis shambateeni, atusin, kuskanaya.","poem":1},{"lineBreak":true},{"text":"Watam Apanll yaktaa Irusarina wanasireem ínaranguwa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Arapchitaa tputs siyaa istaksin,","poem":1},{"lineBreak":true},{"text":"yaktaa watandpunu yusur wanasir wayachinllina.","poem":1},{"lineBreak":true},{"text":"Urkarsha m'chachoom kinachinllinaya.","poem":1},{"lineBreak":true},{"text":"Watam sirú Apanll siyaa tsiyanuspa waneerangu, na siyaa chinakuwa.","poem":1},{"lineBreak":true},{"text":"Apanll siyaa natunaa nayaniku,","poem":1},{"lineBreak":true},{"text":"siyaa kis chinakiya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siy kisa na mapiyrus taatssa.","poem":1},{"lineBreak":true},{"text":"Irusarin watandpun wapshtushi uru tawatam taachiya.","poem":1},{"lineBreak":true},{"text":"Psaantam, kaschiritam ¿mayaamaja shtandachich?","poem":1},{"lineBreak":true},{"text":"Arapich tputs maachee yuw arap waritaku anoo siyaam wayat wayat ashchinllinaya.","poem":1},{"noteId":56},{"lineBreak":true},{"text":"Urkarsha wipunashpatari kusatataraa ashchinllinaya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tputssha siyaa niyrkusin,","poem":1},{"lineBreak":true},{"text":"uwshtisin tsipachinllinaya.","poem":1},{"lineBreak":true},{"text":"Urkarpatarit washunandari kachingchinllinaya,","poem":1},"Apanll siyaa Irusarinshucheetsis tárangiya."]},{"type":"line_break"},{"type":"verse","number":13,"content":["Apanll Taarashipan ateeja.",{"text":"Libanush káyandsin,","poem":1},{"lineBreak":true},{"text":"siyaam maachee kizpur wanasir yushindachinllinaya.","poem":1},{"lineBreak":true},{"text":"Apanllee pang' wanasireem ínayani, atusin,","poem":1},{"lineBreak":true},{"text":"karipanaa washitan zapan siyaam panachinllinaya.","poem":1},{"lineBreak":true},{"text":"Ashkatssin, nuwsha kis anush yusur pshtuyaruri, naanat ashchina.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sirú tputs siyaa kiyung yacharangusin,","poem":1},{"lineBreak":true},{"text":"siyaa yutaritaam ínarangusin,","poem":1},{"lineBreak":true},{"text":"natsha uw nlluranur siyaa kis napchintsa.","poem":1},{"lineBreak":true},{"text":"Nlluranursha siyash kuseersin,","poem":1},{"lineBreak":true},{"text":"siyaa ungirtachinllinaya.","poem":1},{"lineBreak":true},{"text":"Siyash tutunlltayarusin,","poem":1},{"noteId":57},{"lineBreak":true},{"text":"Nuw shiyaa kurakartana, táchinllinaya.","poem":1},{"lineBreak":true},{"text":"Yaktareetsis, Apanll Taarashipancha yaktarini.","poem":1},{"lineBreak":true},{"text":"Israelchich Apanllirini Siyonamandari kis napkiya, siyaa táchinllinaya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Natsha ndusha kasampaz ashirus taatssa.","poem":1},{"lineBreak":true},{"text":"¿Chakaja siyaa natsach? Wanindaja.","poem":1},{"lineBreak":true},{"text":"Itaru, urutamari arapich tputs siyaa kis chinachinllinaya.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Watungashee kizpur wanasir siyaam panachapantsa.","poem":1},{"lineBreak":true},{"text":"Urkarsha waanaatsi maachiri wanasirimshee yushindayarusin, panachintsa.","poem":1},{"lineBreak":true},{"text":"Anushsha, Apanll waana iyaa Irusarinshuchee tapachindachiya.","poem":1},{"lineBreak":true},{"text":"Apanll iyaam kundarareetsini itutsirangiya.","poem":1},{"lineBreak":true},{"text":"Watam Apanll iyaa Akoparinchicheetsini kizpur istaranguwa, táchpasa,","poem":1},"Apanll átcha siyaa Irusarinshucheetsis.",{"lineBreak":true},"Mishat, Apanll siyaa atitamcha."]},{"type":"verse","number":17,"content":[{"text":"Nuw siyaa kapung istakchuri,","poem":1},{"lineBreak":true},{"text":"ngusambaa bronsi ndusha panakuri,","poem":1},{"lineBreak":true},{"text":"orootsimsha panachintspa.","poem":1},{"lineBreak":true},{"text":"Ngusambaa mbammashee ndusha panakuri,","poem":1},{"lineBreak":true},{"text":"oroo mburshimasheetsimsha yátssa.","poem":1},{"lineBreak":true},{"text":"Karipanaa ndusha panakchuri,","poem":1},{"lineBreak":true},{"text":"ngusambanandarisha bronsi xanatatssa.","poem":1},{"lineBreak":true},{"text":"Patumbichpa kapungumashpa ndusha pangukus,","poem":1},{"lineBreak":true},{"text":"ngusambpasha pangeemis pangutssa.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Siyash tsapunis tputs waanpatatin kiyung yachaksin,","poem":1},{"lineBreak":true},{"text":"zamangakana anoo ndusha mazinatssa.","poem":1},{"lineBreak":true},{"text":"Kundararis ndunsha siyash kuseeru, pachachintsa.","poem":1},{"lineBreak":true},{"text":"Ashkachuri, yaktaa watandpun, Tapachindampanee, átus, ísamatssa.","poem":1},{"lineBreak":true},{"text":"Mishat, yaktaa pshtushee, Apanlli yaseesshee, átus ísamachtampasa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"¿Mayaamaja kaschir zar zatach?","poem":1},{"lineBreak":true},{"text":"¿Mayaamaja tsup psaan 'sineech?","poem":1},{"lineBreak":true},{"text":"Watam nuwsha, Taarashipani siyaam urutamari 'sineekpaz ashiru taachinawa.","poem":1},{"lineBreak":true},{"text":"Nuw siyaa Apanlleeruri,","poem":1},{"lineBreak":true},{"text":"siyaam 'sininitaraa ashtachima.","poem":1},{"noteId":58}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nuw siyaam zarpaz ashiruri uru 'sineekchuri,","poem":1},{"lineBreak":true},{"text":"ayamtaati tsípcheeja.","poem":1},{"lineBreak":true},{"text":"Nuw siyaam tsuppaz ashiruri uru taachima.","poem":1},{"lineBreak":true},{"text":"Ashkachuri, ayamtaatiya suris ndunichshaparee.","poem":1},{"lineBreak":true},{"text":"Watam nuw siyaam urutamari tuwasineeru taachinawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Siyashuch ichingarusin kurak taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Urutamari tsapuneetsis ksutatssa.","poem":1},{"lineBreak":true},{"text":"Nuwaana zandaranguri,","poem":1},{"lineBreak":true},{"text":"nuw siyaa yusur wayachintspa.","poem":1},{"lineBreak":true},{"text":"Yasin wanasirimash ashirus yusur kxunakpaz sheerus taatssa.","poem":1},{"lineBreak":true},{"text":"Ashkachuri, ztaru tputs nuwaa chinachinllinaya.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Siy anuri pakchitaa kuwiz m'cheeru taarangus,","poem":1},{"lineBreak":true},{"text":"nimun yusur milshaparee tputsis taatssa.","poem":1},{"lineBreak":true},{"text":"Ashkachus, tsapunshish siy tatsitatssa.","poem":1},{"lineBreak":true},{"text":"Nuw siyaam taarashee panampantana.","poem":1},{"lineBreak":true},{"text":"Yuwash zar waritakchu, anush nuwaanaatsi kuki uru tuminchima,","poem":1},"Apanll tárangiya siyaatsi Irusarinshucheetsis."]}],"footnotes":[{"noteId":55,"caller":"*","text":"Apanll wanichu anu 21.24 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":60,"verse":3}},{"noteId":56,"caller":"*","text":"Apanll wanichu anu 21.25-26 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":60,"verse":11}},{"noteId":57,"caller":"*","text":"Apanll wanichu anu 3.9 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":60,"verse":14}},{"noteId":58,"caller":"*","text":"Apanll wanichu anu 21.23; 22.5 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":60,"verse":19}}]},"thisChapterLink":"/api/cbu_wbt/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":22}