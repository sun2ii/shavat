{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":61,"content":[{"type":"heading","content":["Apanll Israelchichee tputs tapachindachiya"]},{"type":"verse","number":1,"content":[{"text":"Apanll Taarashipan wani nuwash wizpur taachiya.","poem":1},{"lineBreak":true},{"text":"Apap nuwaa ipuseeru, wipunasheemsha ínarangiya.","poem":1},{"lineBreak":true},{"text":"Nuwaa kamachtaku, Yuw kiyung kachiykana anoo istashini, tárangiya.","poem":1},{"lineBreak":true},{"text":"Pukireem nuwaa kuki kamanishini.","poem":1},{"lineBreak":true},{"text":"Putamawaa tputs yanpushini.","poem":1},{"lineBreak":true},{"text":"Tumanshishush wantsush taakana, anoo tashitungangcha.","poem":1},{"noteId":59}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yuw kiyung kachiykana an nimun kiyung kachiyachtazinllinaja, Apanll átanda, tángcha.","poem":1},{"lineBreak":true},{"text":"Na musápa Apap iyaa istamaam kuschiya.","poem":1},{"lineBreak":true},{"text":"Apap iyamand kundarareetsini kisatachiya.","poem":1},{"lineBreak":true},{"text":"Apap nuwaa, Yuw tputs mang' mantsakana, anoo mangoo tuwizpurtangcha.","poem":1},{"noteId":60}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Shiysha ipunshee, Siyonshuchee tputs mangoo yarangcha.","poem":1},{"lineBreak":true},{"text":"Sirú mang' mantsaksin, masunllpa muchimun tapararangana,","poem":1},{"lineBreak":true},{"text":"anoo shiyshat kapeeteerush, wanasirsha tútiyachtayarush ksangcha.","poem":1},{"lineBreak":true},{"text":"Ndusha mang' mantsaksin taamaama.","poem":1},{"noteId":61},{"lineBreak":true},{"text":"Kzammashee mang' ksamaam tparangcha, tárangiya.","poem":1},{"noteId":62},{"lineBreak":true},{"text":"¿Tamaycheezich? ndusha tputs táchiya.","poem":1},{"lineBreak":true},{"text":"Apaa, shiy kizpurtishcha.","poem":1},{"lineBreak":true},{"text":"Shiy iyaa kapung istaksha, tputs táchinllinaya.","poem":1},{"lineBreak":true},{"text":"Tputssha siyaa Irusarinshucheetsis, Apanll tatsumarinee wanasirimishcha, táchinllinaya.","poem":1},{"lineBreak":true},{"text":"Simbunpaz ashirus kizpur wanasir taatssa, tángcha,","poem":1},{"lineBreak":true},"Apap nuwaa tárangiya.",{"text":"Apap ashkachu, tputssha ichingarusin Apanllee wanasirimshirini pakchinllinaya,","poem":1},"Apap nuwaa kamachtaku tárangiya."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Pang' yurangamawaa yusur panguchinllinaya.","poem":1},{"lineBreak":true},{"text":"Undarar sirútari pangoo kapeetarangtaa,","poem":1},{"lineBreak":true},{"text":"itaru, natsha nimun yusur wanasir taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Yaktareetsis kapeetamawmuntaa, anush yusur siy kis taatssa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Arapich tputs chineetsis ksutkusin taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Tatsumareetsis puyachtamsinaya.","poem":1},{"lineBreak":true},{"text":"Kizarunaa tatsumma napchinllinaya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Siyaatssha apanllpaneem ínachinllinaya.","poem":1},{"lineBreak":true},{"text":"Taarashipanee iyaam mashangandama, táchinllinaya.","poem":1},{"lineBreak":true},{"text":"Arapich tputs shiyaa chinakchusin,","poem":1},{"lineBreak":true},{"text":"siyaa kurikpaneem ínachapantsa.","poem":1},{"lineBreak":true},{"text":"Tputsee wanasirimshee saanshu pangis ishinanaw ashitssa.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sirú siy kiyung kachiyarangus,","poem":1},{"lineBreak":true},{"text":"itaru, natsha nimun mangis kis kizpur taatssa.","poem":1},{"lineBreak":true},{"text":"Sirú tputs siyaa yutaritaam ínarangunts,","poem":1},{"lineBreak":true},{"text":"itaru natsha tputs siyaam mangutari urkiree panapantar ashchintsa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Waana Apanll tatsamooru yasayaru istakiya.","poem":1},{"lineBreak":true},{"text":"Washchiree tputsi natsakiya.","poem":1},{"lineBreak":true},{"text":"Wapchaatssha tputs tsiyantakitamta.","poem":1},{"lineBreak":true},{"text":"Itaru, siyaatsinaa tatsamooru istachiya.","poem":1},{"lineBreak":true},{"text":"Siyapat urutamari amikurtachiya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Siy iparis tsapurunasush kizpur taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Arapich tputs, ¿Tamaru Irusarinshuch taakanaya? táchinllinaya.","poem":1},{"lineBreak":true},{"text":"¿Tamaru Apanll Taarashipan istaka?","poem":1},{"lineBreak":true},{"text":"Watam Apanll waana tiptsiriwa, siyaa iparis táchinllinaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¡Nuw Apapamand, Taarashipanimand ksumish mangi kischa!","poem":1},{"noteId":63},{"lineBreak":true},{"text":"Waana Apap nuwaa mangi kis taamaam wayarangiya.","poem":1},{"lineBreak":true},{"text":"Apap nuwaa kapung tapachindarangiya.","poem":1},{"lineBreak":true},{"text":"Nuwaam kurakaam ínayaru, nuwamari kasikina.","poem":1},{"lineBreak":true},{"text":"Kizaatspaz mashkuri ashiruri mangi kis shambatkina.","poem":1},{"lineBreak":true},{"text":"Kiz zaranllpi átu, wayarangashee mang' kis yártaru ashiruri mangi ksakina.","poem":1},{"noteId":64}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Napa: Yuwatoo tatsumeeruch,","poem":1},{"lineBreak":true},{"text":"wanasir kxuntaru ashikpaz ashiritam,","poem":1},{"lineBreak":true},{"text":"Apap iyaa kizpur wanasir istakachu, kissha taachiniya.","poem":1},{"lineBreak":true},{"text":"Ashkachu, arapich tputs ichingarusin,","poem":1},{"lineBreak":true},{"text":"Apapaa yaseeksin, shambatchinllinaya,","poem":1},"tárangiya Apanll wipunashi."]}],"footnotes":[{"noteId":59,"caller":"*","text":"Matiwa 11.5; Lukasa 7.22 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":61,"verse":1}},{"noteId":60,"caller":"*","text":"Yuwaa nish átu anootstam Lukasa 4.18-19 tayusima kamankiya. Mishat, Matiwa 5.4 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":61,"verse":2}},{"noteId":61,"caller":"*","text":"Matiwa 5.4 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":61,"verse":3}},{"noteId":62,"caller":"*","text":"Wanga 19.40; 12.7 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":61,"verse":3}},{"noteId":63,"caller":"*","text":"Lukasa 1.46-47 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":61,"verse":10}},{"noteId":64,"caller":"*","text":"Apanll wanichu anu 21.2 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":61,"verse":10}}]},"thisChapterLink":"/api/cbu_wbt/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}