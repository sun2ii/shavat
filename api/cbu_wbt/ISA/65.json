{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":65,"content":[{"type":"heading","content":["Apanll tputsee yutaritshishpani waneekiya"]},{"type":"verse","number":1,"content":["Apanll Taarashipan átcha.",{"text":"Tputs sirú nduntaa nuwaa masharangsin,","poem":1},{"lineBreak":true},{"text":"natsha nuwaa, Istangasinda, atanaya.","poem":1},{"lineBreak":true},{"text":"Tputs nuwangaz nduntaa nachungarangusin,","poem":1},{"lineBreak":true},{"text":"natsha nuwaa parangusin, nuwash kusaranganaya.","poem":1},{"lineBreak":true},{"text":"Tputs nduntaa nuwaa, Apaa, tapachindanda, tárangusin,","poem":1},{"lineBreak":true},{"text":"itaru natsha nuwsha, ¿Maya? Natu tsiyatangandama, atina.","poem":1},{"noteId":65}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ichingaru zar nuw Israelchichee kuruzaranguri,","poem":1},{"lineBreak":true},{"text":"Nuw siyaa istapi, atina, táranguri,","poem":1},{"lineBreak":true},{"text":"kuwi nguti paxa ashirangina.","poem":1},{"lineBreak":true},{"text":"Ashkitaati, siysa nuwaa niyrarangus,","poem":1},{"lineBreak":true},{"text":"zurampatari nuwaa ngatarangsa.","poem":1},{"noteId":66},{"lineBreak":true},{"text":"Yuwari saana zandarangis,","poem":1},{"lineBreak":true},{"text":"anuri kis chinarangsa.","poem":1},{"lineBreak":true},{"text":"Siy yutaritaringaziri zandarangus, anootsim payurangsa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Siy putam putam nuwaa kachi parangitaatis,","poem":1},{"lineBreak":true},{"text":"nuwaa yutaritam ínarangsa.","poem":1},{"lineBreak":true},{"text":"Siy kis apanllputsee chinarangus,","poem":1},{"lineBreak":true},{"text":"tatsumshishee wanasirimshi ungirtarangus,","poem":1},{"lineBreak":true},{"text":"ladrichumun maachee wayayarus, mbutarangsa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Siy kis tsiparip mapshiship kuxinxinaw ashkus,","poem":1},{"lineBreak":true},{"text":"kanizpat kis tsiyatarangsa.","poem":1},{"lineBreak":true},{"text":"Psaan upusap naayarus,","poem":1},{"lineBreak":true},{"text":"arutamangaz nachungarangsa.","poem":1},{"lineBreak":true},{"text":"Mishat, mantsamoo k'chee wanuts","poem":1},{"lineBreak":true},{"text":"chirimbuchirishis masamurtayarus,","poem":1},{"lineBreak":true},{"text":"kis katungarangsa,","poem":1},"Apanll tárangiya yutaritshishpaneetsi."]}],"footnotes":[{"noteId":65,"caller":"*","text":"Yuwaa nish átu anootstam Romshucheema 10.20 tayusima kamankiya.","reference":{"chapter":65,"verse":1}},{"noteId":66,"caller":"*","text":"Yuwaa nish átu anootstam Romshucheema 10.21 tayusima kamankiya.","reference":{"chapter":65,"verse":2}}]},"thisChapterLink":"/api/cbu_wbt/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":4}