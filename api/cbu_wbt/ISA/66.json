{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":66,"content":[{"type":"heading","content":["Nuwamaritana kizpur taaki, Apanll nuwaa Isáysaatsi tárangiya"]},{"type":"verse","number":1,"content":[{"text":"Nuw tsirari kaninda kánuru taariya.","poem":1},{"noteId":67},{"lineBreak":true},{"text":"Anumand kuxinkuri, kutsi tsapurunasimun katkina.","poem":1},{"noteId":68},{"lineBreak":true},{"text":"Ashirucha, amb ashkuri, nuw kizpur taakina.","poem":1},{"lineBreak":true},{"text":"¿Tamareeja siy tputsis nuwaam pangi panguchis?","poem":1},{"lineBreak":true},{"text":"¿Yapeeja nuwaam kanusamaam panguchis?","poem":1},{"lineBreak":true},{"text":"Izuuru pinasaksa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Watam nuwaana maacheetsi ichingaroo tinaranginawa.","poem":1},{"lineBreak":true},{"text":"Nuw ndunnaar tinaranguri, ¿ashireeja maachi taar?","poem":1},{"noteId":69},"Apanll waana tárangiya.",{"lineBreak":true},"[Watamari nuw Isáysi kuki.]"]}],"footnote