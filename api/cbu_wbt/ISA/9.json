{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"ISA","translationId":"cbu_wbt","name":"Isáysa","commonName":"Isáysa","title":"Isáysarini kuku Nuw Isáysi yuwaa Apanll kamanirangu anoo kamanchintspa","order":23,"numberOfChapters":26,"sha256":"2326e12148c8733e4606ef31ac1234b97a93f4cc3363ec755a6dd9cf5322e023","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cbu_wbt/ISA/66.json","totalNumberOfVerses":350},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"An tputs kiyung kachiykitaa taaksin,","poem":1},{"lineBreak":true},{"text":"kamungumaam wanindaja,","poem":1},"nuw siyaa waneekuri, ipunsheetsis atina. Ashirucha, nuwaa kuki mazinangtsa; mbizarintspa, atashina."]},{"type":"heading","content":["Ayam zapish Apanll ipusamarini kuskachu, mapiyshapsinaya tputs taachinllinaya"]},{"type":"verse","number":1,"content":["Ichtaru Apanll Galileyshuchee tputs kiyung yacharangiya. Uwshtisin arapich tputs Sabulónush, misha Neftaliyash watsapun taaranganaya. Ortagamand wing káyaruch, zar puku amb naayaruch, maramun wing kusachchi. Sirútamasa Apanll anoo tputsee kiyung yacharangitaa, itaru zapshinaa kizpur wanasireemsha ínachiya. Anoo nuwsha Isáysi kamankuri atashina."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Siyaa Galileyshuchee tputsis tina:","poem":1},{"lineBreak":true},{"text":"Tapshutaa taakus, kiyungtaa kachiykus,","poem":1},{"lineBreak":true},{"text":"itaru zapshinaa 'sinee kizpur pangatssa.","poem":1},{"lineBreak":true},{"text":"'Sinsha siyash kuskachu,","poem":1},{"lineBreak":true},{"text":"siyaa tuwasinichiya.","poem":1},{"lineBreak":true},{"text":"Ndusha yutaritshishush tunimushpaz ashirus taatssa.","poem":1},{"noteId":9}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Apaa, shiy iyaa mangeetsini ksashishsha wayarangsha!","poem":1},{"lineBreak":true},{"text":"Natunaa shiyapa taakurini,","poem":1},{"lineBreak":true},{"text":"shiyaa tasaseeruni, kisshapa taachiniya.","poem":1},{"lineBreak":true},{"text":"Tputs katungtsee zapan pusaksin,","poem":1},{"lineBreak":true},{"text":"tputs maachee zapan mangu pana, pana ashkana,","poem":1},{"lineBreak":true},{"text":"ashikpaz ashkuni, mangini ksachshapariniya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Watam tputs iyaa tamuchchurtarangusin, itaru","poem":1},{"lineBreak":true},{"text":"shiysha, Watsta táyarush, iyaa itutsirangshawa.","poem":1},{"lineBreak":true},{"text":"Shiyamari izuuru tputsee kasirangush,","poem":1},{"lineBreak":true},{"text":"Madiyanshuchee kasirangish ashirangtamsha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wasundaruree wasapturi itutseerush,","poem":1},{"lineBreak":true},{"text":"misha wamaree kuras ixataru,","poem":1},{"lineBreak":true},{"text":"anoo ichingaru sumasish kapeetachpasha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Waana Apanll iyaam nlluraa wayarangiya.","poem":1},{"lineBreak":true},{"text":"Nllursha nllurtakachu, kanungeeru,","poem":1},{"lineBreak":true},{"text":"kizpur kurakaam kinachshaparee.","poem":1},{"lineBreak":true},{"text":"Kurakaa ichingaru wamari kasichiya.","poem":1},{"noteId":10},{"lineBreak":true},{"text":"Nlluraa Apanllee ipusamarini ísamachinllinaya.","poem":1},{"lineBreak":true},{"text":"An nllur kizpur mangoozee p'tsimpancha.","poem":1},{"lineBreak":true},{"text":"Apanlliritcha wamari kasiriya.","poem":1},{"lineBreak":true},{"text":"Apanll Taarashipancha. Apanll urutamarit mapiymash","poem":1},{"lineBreak":true},{"text":"mangoozee panakiya, nlluraa táchinllinaya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Uwsha nllur kurakaam kinayaru, Dapiyarinish zamuchiya.","poem":1},{"lineBreak":true},{"text":"Tsapurunashuchee tputsi ztaru ksutchiya.","poem":1},{"lineBreak":true},{"text":"Urutamari tputsee tatsamooru napchiya.","poem":1},{"lineBreak":true},{"text":"Yutaritshishpanee waneeyaru, wanasirimshee tputsi zurampatari istachiya.","poem":1},{"lineBreak":true},{"text":"Ayamtaatiyam mapiyshish nda pastachiya.","poem":1},{"noteId":11},{"lineBreak":true},"Apanll waana iyaam nlluraa wayachiya, nuw Isáysi siyaa Galileyshucheetsis atina."]}],"footnotes":[{"noteId":9,"caller":"*","text":"Yuwaa nish átu anootstam Matiwa 4.16; misha Lukasa 1.79 kamankiya.","reference":{"chapter":9,"verse":2}},{"noteId":10,"caller":"*","text":"Matiwa 27.28-29; Wanga 19.2-3 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":9,"verse":6}},{"noteId":11,"caller":"*","text":"Lukasa 1.32-33 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":9,"verse":7}}]},"thisChapterLink":"/api/cbu_wbt/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":8}