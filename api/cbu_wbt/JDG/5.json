{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"JDG","translationId":"cbu_wbt","name":"Kurak Tsipasa","commonName":"Kurak Tsipasa","title":"Kurakaam tsipas kinatarangana Kurakaam tsipas kinatarangana Israelchichi","order":7,"numberOfChapters":10,"sha256":"a5311ab822be3a9c77705da58dc509f0bc42632bc4606f3b7f61ee1d53951234","firstChapterNumber":2,"firstChapterApiLink":"/api/cbu_wbt/JDG/2.json","lastChapterNumber":16,"lastChapterApiLink":"/api/cbu_wbt/JDG/16.json","totalNumberOfVerses":259},"chapter":{"number":5,"content":[{"type":"heading","content":["Ashiriya, na yuwaatssha Debora misha Balakaa Apanllee yaseerangana anootssha kamanchintspa"]},{"type":"verse","number":1,"content":["Debora, misha Balakaa anpur Apanllee yaseeksin, ántar ashiranganaya."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Apaa, wapparee, tángtsa.","poem":2},{"lineBreak":true},{"text":"Nish Israelchich tputs zapan tapazeem taariya.","poem":2},{"lineBreak":true},{"text":"Pza, kundararpatini warateeni, táranguri,","poem":2},{"lineBreak":true},{"text":"waanaatsi watsipun nda pachindarangsin, Ayu, tárangana.","poem":2},{"lineBreak":true},{"text":"Ashirucha Apaa, wapparee, ashparitini atiniya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kurakis mazinantsa.","poem":2},{"lineBreak":true},{"text":"Mishat, ksutamapanitamtis mazinangtamtsa.","poem":2},{"lineBreak":true},{"text":"Nuw yaseekina Apanllee zurmapaneetsi;","poem":2},{"lineBreak":true},{"text":"nuw yaseekina Apanlleetsi,","poem":2},{"lineBreak":true},{"text":"yuwaa Israelchichee tapachindarangu anootsi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ashirucha, shiy Apaa, iyaa imachirangush,","poem":2},{"lineBreak":true},{"text":"machip tsap Edomap wizpurireetsish tuyamandarangush,","poem":2},{"lineBreak":true},{"text":"tsap kizpur mundaztarangiya.","poem":2},{"lineBreak":true},{"text":"Mishat, machtatam kanindtam kizpur ishipurangitamta.","poem":2},{"lineBreak":true},{"text":"Ashkachu anush, msassha, misha sinatam tsapush kizpur pantsatarangiya.","poem":2},{"lineBreak":true},{"text":"Ashirangush, machsha sur Sinayi mundaztarangitamta.","poem":2},{"lineBreak":true},{"text":"Apaa, shiyamun wizpurirish ashiranganaya.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sirútama tputs sur Samagar taarangiya.","poem":2},{"lineBreak":true},{"text":"Anatarini wipa yuwapur Jaelarini taarangu anpur zar","poem":2},{"lineBreak":true},{"text":"ichingarusin ngootsish naamaam pinasamuna.","poem":2},{"lineBreak":true},{"text":"Chapungsha ngoots shunllip naataranaya.","poem":2},{"lineBreak":true},{"text":"Mishat, tarawzupantam tarawaztamaam pinasaranganaya.","poem":2},{"lineBreak":true},{"text":"Ashirucha, nuwsha Debori Israelaa tapachindamaam kizpur chinarangina.","poem":2},{"lineBreak":true},{"text":"Kiz wipaa ksutku tamatarpari ashtapi tárangina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Apaa, shiy iyaa pachamaam kamachtarangush,","poem":2},{"lineBreak":true},{"text":"yuwamand iy apanllputsee ungirtarangini anumand","poem":2},{"lineBreak":true},{"text":"Iyaatssha zapan pacharanganaya.","poem":2},{"lineBreak":true},{"text":"Sundar 40 mil taarangtaa,","poem":2},{"lineBreak":true},{"text":"itaru waratamaam pinasaranginiya.","poem":2},{"lineBreak":true},{"text":"Watam k'chirpungurini nduniwa.","poem":2},{"lineBreak":true},{"text":"Kizpur kiyung kachiyaranganiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Itaru, na in shiyaa Apaa, wapparee atiniya.","poem":2},{"lineBreak":true},{"text":"Kurakamuntam Israelchichimun mangini ksakaniya.","poem":2},{"lineBreak":true},{"text":"Yuwamand watsipunoo nda pachindarangsin,","poem":2},{"lineBreak":true},{"text":"tapazip kuruzaranguri, kis naatarangana anumanda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ashiri yuwamand ashirangani anumand ichingarus Israelchichis taakis anis,","poem":2},{"lineBreak":true},{"text":"pukiritamtis, misha kurikpantamtis Apanllee ungirtayani,","poem":2},{"lineBreak":true},{"text":"yuwamand iyaa Israelchicheetsini tapachindarangu anumanda.","poem":2},{"lineBreak":true},{"text":"Ngusambpa tsireej tsireej tángtsa.","poem":2},{"lineBreak":true},{"text":"Apanll iyamari kasimaam istarangiya, tángtsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Israelchichsha tputs táranganaya.",{"text":"Natu Deboraa, támangi, chiyzangi.","poem":2},{"lineBreak":true},{"text":"Yaseengi minum yaseesshshi Apanlleetsi,","poem":2},{"lineBreak":true},{"text":"Balakaa Abinowamarinee wipaa, shiysha natu chiyzangi.","poem":2},{"lineBreak":true},{"text":"Sheerush, tputsirish putamaw machingi,","poem":2},"táranganaya."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Israelchich tputs ichingarusin karuwaranganaya waratamaama.","poem":2},{"lineBreak":true},{"text":"Yuwapa iy kizpurtanicha tárangana anpata.","poem":2},{"lineBreak":true},{"text":"Ashiritam, Israelchichsha tputs shaniyaranganaya,","poem":2},{"lineBreak":true},{"text":"yuwanandari Apanll ipusarangu annandari chiyzartaranganaya","poem":2},{"lineBreak":true},{"text":"waratamaama undararpata.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Efrayinchich tputs ashpatam wazawash karuwaranganaya.","poem":2},{"lineBreak":true},{"text":"Anumunsha Benjaminchichsha wasundurur zapantamsin tachitaranganaya.","poem":2},{"lineBreak":true},{"text":"Makirchichsha kurakaw karuwarangtamsinaya.","poem":2},{"lineBreak":true},{"text":"Mishat, Sabulónchich kupeernuw Deboraam ksutarangana, ántamsina.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mishat, Isaakarsha urkar Deborpa ipunaranganaya.","poem":2},{"lineBreak":true},{"text":"Isaakarsha Balakaam istarangiya.","poem":2},{"lineBreak":true},{"text":"Uwsha Balakamun ush tachitarangitamta wazawap karuwamaama.","poem":2},{"lineBreak":true},{"text":"Itaru, Rubenchichsha opeejaatsimari ksutamaam chinaranganaya;","poem":2},{"lineBreak":true},{"text":"nda tapazip naamaam zandaranganaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Minchichshitisin tputs Ortagumun wing arachich Galaadash tsap taarangtamsinaya.","poem":2},{"lineBreak":true},{"text":"Danarini, misha Aserarini ashpisin patusish ksutaranganaya ichingaroo boti.","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Itaru, Sabulónchichsha, misha Neftaliychichi anshasin","poem":2},{"lineBreak":true},{"text":"nda watsipunu pachindaranganaya.","poem":2},{"lineBreak":true},{"text":"Mapiyrsin pachamap naataranganaya pachakaatssina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ashiriya, kurakshitisin Tanakshuch káyashinusin,","poem":2},{"lineBreak":true},{"text":"kung Meguidush sur naattusin, anumunsha Kanaanshuchsha","poem":2},{"lineBreak":true},{"text":"kurakaw kusarangtamsinaya.","poem":2},{"lineBreak":true},{"text":"Pachani táyarandsina.","poem":2},{"lineBreak":true},{"text":"Itaru, yuwaa amb ashchinipa tárangana anoo","poem":2},{"lineBreak":true},{"text":"nda minumtiyam tatsamooranganaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yuwapur waratarangani anpur","poem":2},{"lineBreak":true},{"text":"íwarpichtam kanindpich tsangach","poem":2},{"lineBreak":true},{"text":"Aparich wizpur kapung an tuwasineerangiya,","poem":2},{"lineBreak":true},{"text":"waratkachuni Sisaraa iyamari kasimaama.","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sirútama, yuwapur Sisarpat warataranguni,","poem":2},{"lineBreak":true},{"text":"iyamari tachiteeranlluni, pachakatanuni,","poem":2},{"lineBreak":true},{"text":"Kisunapsha tsap kusatan ashiranguni,","poem":2},{"lineBreak":true},{"text":"Ichingaru ashpartaa kundarareetsini kachingaranganiya.","poem":2},{"lineBreak":true},{"text":"Uru arangitamanasha nuw Debori sundaruripti marchakuri, Apanllpa wizpur kasichima, nuw tárangee.","poem":2}]},{"type":"verse","number":22,"content":["Sisarsha kapaachurini zapan shitungeeshinusin,",{"text":"shurangakatunusin, waxizup kapung kimarangiya.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ashiritaa, Meroshuchsha tputs Sisaraa nda tuxararanganaya.","poem":1},{"lineBreak":true},{"text":"Ashirucha, Apanll wasundurur,","poem":1},{"lineBreak":true},{"text":"Nuw Merosshuchee tputs wanichima,","poem":1},{"text":"yuwamand nda pakchiyam Israelchichpatatin istamaam zandarangana anumanda, tárangiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Jaela Eberaa wizanll,","poem":1},{"lineBreak":true},{"text":"¿tamaru shiyaam Apanll istaranga?","poem":1},{"lineBreak":true},{"text":"Shiyamari kasiksha.","poem":1},{"text":"Ichingaroo kizaptatis yuwaptatis washunand taakis anpatatis ichingaroo shiyamari kasiksha.","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Sisar shiyash kusarangu,","poem":2},{"lineBreak":true},{"text":"Kungurish pananda waapi, tárangu,","poem":2},{"lineBreak":true},{"text":"shiysha wakar mimir ksaneeyarush panarangsha.","poem":2},{"lineBreak":true},{"text":"Sisarsha anoo kis waarangiya.","poem":2},{"lineBreak":true},{"text":"Sheeru, kanuskamchu, maashipsha naayaru, kis maarangiya.","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Maaramchu, anush shiysha, izari Jael, yasin taxumtam kuwish mbazinungach yáyarush,","poem":2},{"lineBreak":true},{"text":"martichootssha mbutsanungach yáyarush,","poem":2},{"lineBreak":true},{"text":"anpa apinll naateerush, maachkiree taa ashirangush,","poem":2},{"lineBreak":true},{"text":"yasinsha taxumtam tsapuptari tshutaru tstsarangiya.","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ashirangush, Sisarsha tsipakchu, tum tum tum ashishtaramach ashirangiya.","poem":2},{"lineBreak":true},{"text":"Shaanshu kutsish tamuramchu kasarangsha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Sisarsha wanir pangusinung washitungash kizpur mangu mantsaku,","poem":2},{"lineBreak":true},{"text":"napanapaw ngootsip ashirangu,","poem":2},{"lineBreak":true},{"text":"Ipari ¿tamanlleeja? Mishat, ¿kapaachutam tapazpan tamanlleeja? átu,","poem":2},{"lineBreak":true},{"text":"mangu kizpur mantsarangu,","poem":2},{"lineBreak":true},{"text":"anoo muchchursha parangu,","poem":2}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Mangish mantsarinllpa.","poem":2},{"lineBreak":true},{"text":"¿Ndusha waamaritin,","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"kasirangusin,","poem":2},{"lineBreak":true},{"text":"sundaroom kizaa panakana?","poem":2},{"lineBreak":true},{"text":"Mishat, ¿ndusha kamisaatstam wanasirimshee Sisaraam panakana?","poem":2},{"lineBreak":true},{"text":"Mishat, ¿paneerootstam wayarpunish kapchamaam panakana?","poem":2},{"lineBreak":true},{"text":"Ashkupsinaya, kureeranaya, Sisar wanir muchchur tárangiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":["Ashiriya, Debora misha Balakaa ashpisin Apanllee yaseeksin,",{"lineBreak":true},{"text":"Apaa, shiy ¿tamaru iyaam istarangsha?","poem":2},{"text":"Shiyapat wizpurirish kundarareetsini ashpari kachingaranganiya.","poem":1},{"lineBreak":true},{"text":"Kundarareetsish Apaa, ashparit kchingangcha.","poem":1},{"text":"Itaru, na Apaa, yuwamarisha shiyamun mang' tatkana anumarishtisin","poem":2},{"lineBreak":true},{"text":"waani taachinllinaya, zar wachamuree tamarupa tuwasinitariya.","poem":2},{"lineBreak":true},{"text":"Ashirusin tuwasineersin taachinllinaya,","poem":2},{"lineBreak":true},"Debora misha Balakaa ashirusin Apanllee yaseeksin ántar ashiranganaya. Anumunsha yuwamun waratarangana anumun iwaz, ipunpunar chungarani (40) masach ashchiri tsap wanasirsha taaranganaya. Ashiriya, na yuwaa Israelchich Apanllpa wizpur undararee kachingarangana anoo kamaneena."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}