{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"JON","translationId":"cbu_wbt","name":"Jonasa","commonName":"Jonasa","title":"Jonasarini kuku Jonasarini kuku","order":32,"numberOfChapters":4,"sha256":"eb090e8c1f507f313185e461b485ee8cdb1d423972f8d09d5891cfe3adff1164","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/cbu_wbt/JON/4.json","totalNumberOfVerses":46},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Ashiri Jonas kayupchish chik taaru, Apanllpa tsiyatarangiya."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Apaa, nuwaanamand yutaritshishiri shiyaa mashkina.","poem":1},{"lineBreak":true},{"text":"Itaru, shiysha Apaa, yuwaa nuw shiyaa mashki anoo mazinangcha.","poem":1},{"lineBreak":true},{"text":"Izuuru tsipamaam waritakuri, shiyaa mashkina.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Shiy imurish marush nuwaa kasarangsha.","poem":1},{"lineBreak":true},{"text":"Kungsha nuwaa waras purangiya. Nuwamunsha kung warastatar ashirangiya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Itaru, nuwsha shiyaa wanasirimshirish tácharangina.","poem":1},{"lineBreak":true},{"text":"Ashiri nuwsha mangishi chinakuri, Apanllee pang' ndunpari pangchina, táranguri,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"kungsha izuuru nuwaa purangiya. Imurish wantsush nuwaa tapshturangiya.","poem":1},{"lineBreak":true},{"text":"Mishat, tundunarputssha muchimunutamti izuuru kpatarangiya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nuw izuuru kungush wantsush yangarangina. Tsapumun tamoo ashirangina.","poem":1},{"lineBreak":true},{"text":"Yuwaa ashtachish anoo nuw urutari wasina waneeshee yasarangina.","poem":1},{"lineBreak":true},{"text":"Ashiritaa Apaa, shiy nuwaa tsipani tapachindarangsha.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nuw, Tsipachparina, táranguri, anush shiyaa yusur chinarangina.","poem":1},{"lineBreak":true},{"text":"Apaa, pangimandish nuwaa kuki yuwaa mashki anoo mazinarangsha.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Itaru Apaa, yuw tputs apanllputsee chinakana,","poem":1},{"lineBreak":true},{"text":"anshitisin nda shiyaa wanasireem ínakanaya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Itaru, ayamsha nuw zurampatari maachi wayayruri, shiyaam muchchima.","poem":1},{"lineBreak":true},{"text":"Watam shiy nuwaa tapachindakshawa,","poem":1},{"lineBreak":true},"Jonas kayupish tápun taaru, tárangiya."]},{"type":"verse","number":10,"content":["Ashiri Apanll kayupchee kamachtarangu, kayupichsha Jonasaa tsapumun wanasirimun katarangiya."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}