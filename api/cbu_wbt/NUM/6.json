{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"NUM","translationId":"cbu_wbt","name":"Masatarangana","commonName":"Masatarangana","title":"Israelchich tputs masatarangana Israelchich apusash masaru taarangana anoo kamankiya","order":4,"numberOfChapters":12,"sha256":"8535a7d0c4d5a7def0c45cc41542a4682a79aa9603491a366f854063d9747965","firstChapterNumber":6,"firstChapterApiLink":"/api/cbu_wbt/NUM/6.json","lastChapterNumber":24,"lastChapterApiLink":"/api/cbu_wbt/NUM/24.json","totalNumberOfVerses":242},"chapter":{"number":6,"content":[{"type":"heading","content":["Ashiriya, na kamanchintspa yuwaa apanllpanee urkar Apanll kapung chinarangu anootsi"]},{"type":"verse","number":22,"content":["Ashiriya, Apanll Móysisaa kamachtarangiya."]},{"type":"verse","number":23,"content":["Kamachtaku: Shiyshat Móysisaa, Aaronaa wipaptar ashpari kamaningcha; Israelchicheem tputsee nuwaam mashkus, wanasiriri tsiyatangtsa."]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Apanll siyaa kapung chinaku, wizpurireemani panaku, ksutkiya.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Apanll siyaa ksapa napkiya.","poem":1},{"lineBreak":true},{"text":"Mishat, waanaatsi wanasirimshirini siyaam tuyamandaktamta.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Apanll siyaa chinampatari napku, tapachindakiya.","poem":1},{"lineBreak":true},{"text":"Siyaam mapiymash panachiya.","poem":1},"tángtsa, tárangiya."]},{"type":"line_break"},{"type":"verse","number":27,"content":["Amb nuwamun suri Israelchicheem tsiyatkusin, ántangat ashchinllinpa. Amb tákchusin, nuwsha anshucheem tputs kapung istachima, tárangiya. Ashiriya, na kamaneena yuwaa Apanll Móysisash tsiyatssee kamachtarangu anootsi."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/NUM/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/NUM/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/LEV/23.json","previousChapterAudioLinks":{},"numberOfVerses":6}