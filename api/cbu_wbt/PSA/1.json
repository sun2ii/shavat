{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":1,"content":[{"type":"heading","content":["Tputs Apanllee kisa tachitamaama anoo kamankiya"]},{"type":"verse","number":1,"content":[{"text":"Tputs Apanllimun mang' tatku,","poem":1},{"lineBreak":true},{"text":"mapiyru kis taakiya.","poem":1},{"text":"Yutaritshiship nda tachitkiya;","poem":2},{"lineBreak":true},{"text":"Tputs Apanllee kuk tayutaritku,","poem":2},{"lineBreak":true},{"text":"anpat nda kis ipunkiya.","poem":2},{"lineBreak":true},{"text":"Apanllee zarungchaku anoo nda mazinakiya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Apanlleetsimari kuk payumaam chinakiya.","poem":1},{"text":"Kaschiritam, psaantam uru Apanllee chinachintar ashkiya.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yasin wanasirimash tamapari ashiru taamaam waritariya.","poem":2},{"text":"Napa yasinaam kung nda pishtaku, kchitaru taaku,","poem":1},{"lineBreak":true},{"text":"yuwash zar tatsamkachu, anush kis yusikiya.","poem":1},{"text":"Warsha nda mawirukiya.","poem":2},{"lineBreak":true},{"text":"Tputsshat Apanllimun wizpur ambitam ashkachu,","poem":2},{"lineBreak":true},{"text":"kchitaru kis taakitamanaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Itaru, yashingchichsha tputs nda ashirusin taakanaya.","poem":1},{"lineBreak":true},{"text":"Wayapureetspaz ashiru kambusur arap tpurangangpaz ashkiya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apanllshat anoo izuuru waneeship kapeetchiya.","poem":1},{"lineBreak":true},{"text":"Amb ashkachu Apanllchichpat tputs ayamtaati nda washunand yapandchinlliniya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Watam Apanll waanaatstamari tiptsir uru ksutkuwa.","poem":1},{"text":"Itaru, tputs yashingup tachitkachu,","poem":2},{"text":"waneeship naachiya.","poem":1},{"noteId":0}]}],"footnotes":[{"noteId":0,"caller":"*","text":"Matiwa 7.13-14 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/cbu_wbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}