{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":10,"content":[{"type":"heading","content":["Tputs yutaritshishpan Apanllee staktaa, itaru Apanll izuuru waneekchu tsipachinllina, anu kamankiya."]},{"type":"verse","number":1,"content":[{"text":"Apaa, ¿mayaamsha shiy iyaa arap kasaksha?","poem":1},{"lineBreak":true},{"text":"watam kiyung kachiykiniwa. ¿Mayaamsha tapishuksha?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yutaritshishpan tputs pukiree urutamari kiyung yachaksin taakanaya.","poem":1},{"lineBreak":true},{"text":"Tputseem zapan nazanllish tupantsakpaz ashkanaya,","poem":1},{"lineBreak":true},{"text":"Itaru zapish waantatamsin anush pantsayarusin tsipachinlliniya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yutaritshishpan tputs waanaatstamari ungirtaku tsiyatstar ashkiya.","poem":1},{"lineBreak":true},{"text":"Yuwaa waana zandku, anootsimari tsiyatkiya.","poem":1},{"lineBreak":true},{"text":"Itaru, shiyaatsshat, Apaa, mantsir tsiyatkanaya.","poem":1},{"lineBreak":true},{"text":"Nda pakchiyam shiyaa chinamaam zandkanaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Waanaatstamari kapung ungirtaku,","poem":1},{"lineBreak":true},{"text":"¿Chakaja nuwaa wanichinda? Apanll wanindaja,","poem":1},{"lineBreak":true},{"text":"ambimari átu mangush chinaku taakiya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waamatamari waana mangush chinaku wanasiri shitungkiya.","poem":1},{"lineBreak":true},{"text":"Itaru shiyaatsshat, Apaa, waneeshish nda pakchiyam punikiya.","poem":1},{"lineBreak":true},{"text":"Tputs waneektaa, anoo nda pakchiyam paziksin, stakanaya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Chaka nuwaa kasichinda? Urutari nuw kis taachina,","poem":1},{"text":"Nuwaam xarashish ayamtaatiya taacheeja, ndambaree, atanaya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uru tputsee mantsir tsiyatkanaya. Ngichzeetsimari tsiyatkusin taakanaya.","poem":1},{"noteId":6},{"lineBreak":true},{"text":"Tputsee mangutamari tamapingaku wanasir tsiyatkanaya.","poem":1},{"lineBreak":true},{"text":"Itaru mangush kiyung yachamaam chinakanaya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tamapingampan washchir tamatarparee ashkanaya.","poem":1},{"lineBreak":true},{"text":"Napa washchir yaktashtaa tapisheeru, tsangayaru,","poem":1},{"lineBreak":true},{"text":"tputsee pachayaru, maachiritaatssha ichingkanaya.","poem":1},{"lineBreak":true},{"text":"Tamapingampani ashkitamanaya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mishat, tamapingampan tumuz tamapari ashkitamsina. Tputsee tachitakpaz ashku tsangayaru, tamapingayaru, zata ashkiya.","poem":1},{"lineBreak":true},{"text":"Amb ashkusin, tputsee kasiksin, kiyung yachakanaya.","poem":1},{"lineBreak":true},{"text":"Tputs waanaatsi tapachindamaam pinasakanaya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yutaritshishpan tputsee kawashishpapaz ashiru kawakanaya.","poem":1},{"lineBreak":true},{"text":"Tputssha shitungamaam pinasakanaya.","poem":1},{"lineBreak":true},{"text":"Kiyung kachiykanaya. Wamarisha yashingchich kasikanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mangush chinaku,","poem":1},{"lineBreak":true},{"text":"Yuwaa ashki anoo Apanll mbizachparee,","poem":1},{"lineBreak":true},{"text":"watam wachoo kámanakuri, nuwaa nda pakuwa,","poem":1},{"lineBreak":true},{"text":"atusin, mapiyrsin taakanaya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ashiriya, Apaa shiysha, kuwish paxayarush,","poem":1},{"lineBreak":true},{"text":"wizpurirpatish yutaritshishpanee waneengcha.","poem":1},{"lineBreak":true},{"text":"Watam tputsee kiyung yachakanawa.","poem":1},{"lineBreak":true},{"text":"Ashiri shiysha tputsireetsish nayaniyarush istangcha.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Apaa ¿mayaamshta yashingchich shiyaa stakana?","poem":1},{"lineBreak":true},{"text":"Staksin, ¿Mayamandaja nuwaa wanichinda, atanaya?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Itaru, shiysha Apaa, ichingaru paksha.","poem":1},{"lineBreak":true},{"text":"Yuwaa yutarit ashkana anoo napanapaw ashkush, izuuru shiy wanichsha.","poem":1},{"lineBreak":true},{"text":"¿Chakaja, Apaa, tputs pukiree istach? Wanindaja.","poem":1},{"lineBreak":true},{"text":"Shiyamaricha istampan taaksha.","poem":1},{"lineBreak":true},{"text":"Ashirucha shiyamun mang' tatkanaya.","poem":1},{"lineBreak":true},{"text":"Watam shiy mxaxzeetsta uru nayaniyarush istatarshawa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Apaa, yashingchichee pachtama chpakpaz sheerush wizpuree tasámbaytangi.","poem":1},{"lineBreak":true},{"text":"Ndusha tputsee kiyung yachamaam izuuru pastamamari waneengcha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Apaa, shiyamaricha kurakish urutamari kasirush taaktasha.","poem":1},{"lineBreak":true},{"text":"Yashingchich tputs nda minamtiyam shiyash pshtuchinlliniya.","poem":1},{"lineBreak":true},{"text":"Ichingarootssin kapeeteerush kasachsha.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apaa, shaana tputsirish, shiyaa; Istanda tákchusin,","poem":1},{"lineBreak":true},{"text":"shiysha uru mazinakchush istaksha.","poem":1},{"lineBreak":true},{"text":"Tputsireetsish kapung chinakush, uru tuwizpurtaksha.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Shiy mxaxzeetstam, misha pukireetstam tputs istangcha.","poem":1},{"lineBreak":true},{"text":"Yutaritshishpan nda urutamari taachinllina,","poem":1},{"lineBreak":true},{"text":"watam tsapurunasshuchiwa.","poem":1},{"lineBreak":true},{"text":"Shiysha anoo tpachingangcha,","poem":1},{"lineBreak":true},{"text":"nimun ayamtaati ndusha tputsee kiyung yachamaama.","poem":1},{"lineBreak":true},"Ashiri Apaa, wapparee."]}],"footnotes":[{"noteId":6,"caller":"*","text":"Yuwaa nish átu anootstam Romshucheema 3.14 tayusima kamankiya.","reference":{"chapter":10,"verse":7}}]},"thisChapterLink":"/api/cbu_wbt/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}