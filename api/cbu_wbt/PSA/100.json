{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":100,"content":[{"type":"heading","content":["Apanllimun shambateeni, watam Apanll urutamari tiptsiree chinaku taakuwa, anoo kamankiya"]},{"type":"verse","number":1,"content":[{"text":"Kayanu, ichingaruni ztaru Apanllee mangini kis yaseeyani.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ichinguruni Apanllee ungirtayani.","poem":1},{"text":"Mangini kis Apanllish pang' pshtuyaruni yaseeyani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Apanll taarashipancha anoo yasangtsa.","poem":1},{"text":"Iyaa tinarangu, ichingurootsini wipaam ínarangiya.","poem":2},{"text":"Ashiri iy na Apanllshatanicha tiptsiri taakiniya.","poem":1},{"lineBreak":true},{"text":"Apanll iyaam opeejapaz ashiru ksutamapan taakiya.","poem":1},{"lineBreak":true},{"text":"Iyaa uru ksutku taakiya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ashiri Apanllush pang' pshtuyaruni,","poem":1},{"text":"mangini kis, Wapparee, Apaa, táyani.","poem":2},{"lineBreak":true},{"text":"Apanllee yaseeyani, ungirtayani.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Watam shiysha Apaa kizpurshawa.","poem":1},{"lineBreak":true},{"text":"Shiy kchinamishtishcha.","poem":1},{"lineBreak":true},{"text":"Urutamari tputsee chinakush taaksha.","poem":1},{"lineBreak":true},{"text":"Nlluranureetstam kasachtamtazish, ndambaree.","poem":1},{"lineBreak":true},"Ashirucha, shiyaa, Apaa, Wapparee atiniya."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":5}