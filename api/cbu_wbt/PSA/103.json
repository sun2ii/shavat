{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":103,"content":[{"type":"heading","content":["Apanllee uru kis yasichima"]},{"type":"hebrew_subtitle","content":["Dapiyarini wayassi"]},{"type":"verse","number":1,"content":[{"text":"Nuw shiyaatsimari Apaa,","poem":1},{"lineBreak":true},{"text":"izuuru mangiptarti ungirtachima.","poem":1},{"lineBreak":true},{"text":"Shiy wanasirimshiri chinaksha.","poem":1},{"lineBreak":true},{"text":"Ashiriya, mangi kis urutamari shiyaa","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apaa, ungirtakuri taachima.","poem":1},{"lineBreak":true},{"text":"Wanip nuwaa istarangsha. Kapung istarangsha.","poem":1},{"lineBreak":true},{"text":"Nuw anoo ayamamtiyam nda mbizachina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Apanll nuwaa yutaritshishireetsi ichinguru tachingarangiya.","poem":1},{"lineBreak":true},{"text":"Kas yutaki anootstam yararangu,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"tsipaneetsi tapachindarangiya.","poem":1},{"lineBreak":true},{"text":"Urutari nuwaa chinaku, ksutku taakiya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ashirucha nuwaam pishtats ndunari.","poem":1},{"lineBreak":true},{"text":"Mangi kis taakina.","poem":1},{"lineBreak":true},{"text":"Nuwaa tuwizpurtaku, nuwsha","poem":1},{"lineBreak":true},{"text":"kanungas tamapari ashiruri taakina.","poem":1},{"lineBreak":true},{"text":"Yungan tamapari ashiruri kizpur taakina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Natsampan tputs tputsee kiyung yachaku,","poem":1},{"lineBreak":true},{"text":"Apanllsha anoo yasakiya.","poem":1},{"lineBreak":true},{"text":"Natsampanee izuuru waneekchu,","poem":1},{"lineBreak":true},{"text":"yuw tputs kiyung kachiykana anoo mapiyrsin taamaam wayakiya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Iyaa zitaminarini Israelchichee waanpata wizpur tapachindarangiya.","poem":1},{"lineBreak":true},{"text":"Sheeru, Móysisarinee waanaatsi kuk kamanirangu,","poem":1},{"lineBreak":true},{"text":"Móysissha tputsee tayaspatarangiya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apanll chinampancha. Nayanimpancha.","poem":1},{"lineBreak":true},{"text":"Tputseetsi chinaku nda mikeeru tsiyantamaam yasariya.","poem":1},{"noteId":61}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nda iyaa yutaritshishirini chinaru taakiya.","poem":1},{"lineBreak":true},{"text":"Nda urutari tsiyantataw nda ashku taakiya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iy zapantaa mantsir taakuni,","poem":1},{"lineBreak":true},{"text":"nda anumand iyaa tatsamooru waneekiya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Apanll iyaa chinaku, kanindaa arangpaz kánaru ashiru kapung iyaa chinakiya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yutaritshishirineetsini arap yap tsapurunas tspakatu amb kapeetarangiya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tputs wipaa kizpur chinaku tamatarparee ashiru,","poem":1},{"lineBreak":true},{"text":"Apanll waanaatsi tiptsir chinakiya.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Iyaa tsapupa tinarangu anoo nda mbizakiya.","poem":1},{"lineBreak":true},{"text":"Yuwaa sambaytakani anoo yasariya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Chiy tputsich taarashich karut tamapari ashicha.","poem":1},{"lineBreak":true},{"text":"Karut natuma kizpur wanasir chaptayaru,","poem":1},{"lineBreak":true},{"text":"kis napamaam waritakiya.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Itaru, kambusursha kizpur kambustakchu,","poem":1},{"lineBreak":true},{"text":"chapoo izuuru turambatkachu, ndunarshat ashtariya.","poem":1},{"lineBreak":true},{"text":"Mbizamamari tsípakiya.","poem":1},{"lineBreak":true},{"text":"Ashiritamcha, iy tputsini taarashini.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Itaru, Apanllsha Taarashipan waanaatsee tiptsir nda ayamamtiyam mbizachiya.","poem":1},{"lineBreak":true},{"text":"Tputs Apanllimun mang' tatku, wamachtashee payuku,","poem":1},{"lineBreak":true},{"text":"Apanllsha anoo tputs urutari kapung chinakiya.","poem":1},{"lineBreak":true},{"text":"Wipaatstamta, misha ichingaru nlluranureewaatstam kasacheeja ndambaree.","poem":1},{"lineBreak":true},{"text":"Izuuru ksutchiya.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Apanll waanaa uxinashimun kanindash wayarangu,","poem":1},{"lineBreak":true},{"text":"anumandari tsapurunasee ashchiri ksutkiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ashiriya, siysa Apanllis wasundururis,","poem":1},{"lineBreak":true},{"text":"Apanllee ungirtangints.","poem":1},{"lineBreak":true},{"text":"Watam siy kizpur taaksawa.","poem":1},{"lineBreak":true},{"text":"Uru Apanlleetsimari wamachtash izuuru tuminuksa.","poem":1},{"lineBreak":true},{"text":"Mangiptis uru waanaatsee kuk zurampatari payuksa.","poem":1},{"lineBreak":true},{"text":"Ashiri siysa, ichingarus Apanllee ungirtakus taangtsa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mishat siysa, yuwis Apanll tinarangants anis,","poem":1},{"lineBreak":true},{"text":"maachtawtamtis, kanindshuchtamtis,","poem":1},{"lineBreak":true},{"text":"tsapurunashutamtis taakis","poem":1},{"lineBreak":true},{"text":"anis ichingarus Apanlleetsimari Taarashipani ungirtakus taangtsa.","poem":1},{"lineBreak":true},"Nuwsha ashiritam zurampatari mangiptarti Apanllee ungirtakuri taachima."]}],"footnotes":[{"noteId":61,"caller":"*","text":"Sandeeku 5.11 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":103,"verse":8}}]},"thisChapterLink":"/api/cbu_wbt/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":20}