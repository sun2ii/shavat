{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":105,"content":[{"type":"heading","content":["Apanll Israelchichee kapung istarangu anoo kamankiya"]},{"type":"verse","number":1,"content":[{"text":"Israelchichis, Apanllee, Wapparee tángints, atina.","poem":1},{"lineBreak":true},{"text":"Apanllee ungirtakus, kukootstam tsapurunas ztaru tputsee kamaningtsa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apanllee ungirtakus seengtsa.","poem":1},{"lineBreak":true},{"text":"Iyashchee istamaam ¿waninll Apanll wizpuree yámandaranguwa?","poem":1},{"lineBreak":true},{"text":"Ashiriya, siysa tputsee kaman kaman shingints.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tputsee kamankus, Iy Apanllirini Apanlliritcha kiki. Min Apanll wanindaja.","poem":1},{"lineBreak":true},{"text":"Ashiri yuwis Apanllee chinakis anis,","poem":1},{"lineBreak":true},{"text":"Apanllimunari mangini kis taayani, nuw siyaa atina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iy Apanllirini kizpurcha. Ashiriya, Apanllee masheeni.","poem":1},{"lineBreak":true},{"text":"Ashkachuni, iyaa wanasiri napchiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Wanip iyashchee istaranga?","poem":1},{"lineBreak":true},{"text":"¿Tamaru iyashchee tapachindaranga?","poem":1},{"lineBreak":true},{"text":"Mishat, waanaatsi kuk iyaam zanganirangu,","poem":1},{"lineBreak":true},{"text":"ichinguru anoo mbizamaam wanindaja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iy Aprahamarinchichtanicha.","poem":1},{"lineBreak":true},{"text":"Akoparinchichtamanicha.","poem":1},{"lineBreak":true},{"text":"Apanll iyaa waama tiptsireem ipusarangu,","poem":1},{"lineBreak":true},{"text":"iysha Apanllinandarishtini tiptsir taakaniya.","poem":1},{"lineBreak":true},{"text":"Ashiriya, siysa nuwaa kuki mazinangtsa:","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Apanll Taarashipani iyaana Aparini waanpatatari wizpur tsapurunasee ksutkiya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zitaminarineetsini tsiyatarangu;","poem":1},{"lineBreak":true},{"text":"Nuwaa kuki payukinaareesa, nuwsha izuuru istachintspa.","poem":1},{"lineBreak":true},{"text":"Siyaa ayamtaatiya kasacheezee, tárangu,","poem":1},{"lineBreak":true},{"text":"anoo mbizcheeja, ndambaree.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aprahamarinpa tsiyatarangu,","poem":1},{"lineBreak":true},{"text":"kuk nda pastamaam zurampatari tsiyatarangiya.","poem":1},{"lineBreak":true},{"text":"Anumunsha Isaakarineetstam tsiyatarangiya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sheeru, Israelarineetstam tsiyatarangu,","poem":1},{"lineBreak":true},{"text":"Nuw shiyaam Kanaanaa tsap panachintspa,","poem":1},{"lineBreak":true},{"text":"shiyachich tputs anush urutari taamaama, Apanll tárangiya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Zitaminarini Israelchich tputs machin anush taaranganaya.","poem":1},{"lineBreak":true},{"text":"Kanaanaa tsap nda amuytaranganaya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Uru xitangat ashkuni, minup tputs watsapun taarangsin,","poem":1},{"lineBreak":true},{"text":"minupsha tputs watsapun taaratarshin ashtaranaya.","poem":1},{"lineBreak":true},{"text":"Min kurak iyashchee istaku, minshat kurak istaku, ashtaranaya.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Itaru, xitangat ashirangtaatani, Apanll iyachchee tputs kapung ksutarangiya,","poem":1},{"lineBreak":true},{"text":"tputs nda natsamaama. Watam Apanll waana kurakaa,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nuwaa tputsiri mantsir tsiyatintspa.","poem":1},{"lineBreak":true},{"text":"Nuwaa kuki kamanimapanee kiyung yacharintspa, táranguwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Apanll anpur Kanaanush tsap maringamaam wayarangiya.","poem":1},{"lineBreak":true},{"text":"Izuurumamari iwariz maringarangiya.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Itaru, Apanllsha wasina Osiyarinee iyashchee tapachindamaam ipusarangiya.","poem":1},{"lineBreak":true},{"text":"Israelarini wip zoonllee Osiyaa natsayarusin,","poem":1},{"lineBreak":true},{"text":"tputseem muchchur kurikpa tupaxanxarangana.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Osiyarini Ijiptosh tsap taarangu, anpur tputs Osiyarinee kiyung yacharanganaya.","poem":1},{"lineBreak":true},{"text":"Tumanshishush wantsush tumanaranganaya.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Itaru, Apanll Osiyarinee ambtaa ashirangu,","poem":1},{"lineBreak":true},{"text":"yuwartatam Osiyarini nllurtama pamazurangu, zoonllee kamanirangu,","poem":1},{"lineBreak":true},{"text":"anuritam tatsamoorangiya.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Osiy wand tumanshishush taarangu,","poem":1},{"lineBreak":true},{"text":"Ijiptshuch tputs kurak, yuw zapan tputsee ksutarangu,","poem":1},{"lineBreak":true},{"text":"an wasundururee Osiyaa tashitungamaam kamachtarangiya.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ashiri kuraksha Osiyaa waama istamaam ínarangiya. Shiysha nuwaa tputsiri ksutangcha.","poem":1},{"lineBreak":true},{"text":"Mishat, maacheewaatstatam ksutangcha, tárangiya.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ashiri Osiysha kurakaa wipunashee,","poem":1},{"lineBreak":true},{"text":"istampaneetstam ichingaroo yasashee zapan yapstarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Anumunsha iwaz zitaminarini, Israel wipapat Ijiptop tsap naataranganaya.","poem":1},{"lineBreak":true},{"text":"Anush tunarish Ijiptosh watsapun kuseersin taaranganaya.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ambtaa ashirangu, itaru Apanllsha iyashchee istarangu,","poem":1},{"lineBreak":true},{"text":"wip izapaneeranganaya.","poem":1},{"lineBreak":true},{"text":"Kizpureew taaranganaya.","poem":1},{"lineBreak":true},{"text":"Ijiptoshchee tputs kasiru taaranganaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ashirucha, Ijiptoshuchsha tputs; Iyaa kasiruneepa, atusin,","poem":1},{"lineBreak":true},{"text":"iyashchee natsaksin, kiyung yacharanganaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ashiriya, Apanllsha Móysisarinee, Aaronarineetstam tapachindampaneem ipusarangu,","poem":1},{"lineBreak":true},{"text":"tiptsiree tapachindamaam zanganirangiya.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Móysissha, zoonllpa Aaronpa, Ijiptosh tsap Apanllee wizpur tuyamandarangusin,","poem":1},{"lineBreak":true},{"text":"tputsee tpuxtaranganaya.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Apanllsha Ijiptosh tsap zaree kzatarangu,","poem":1},{"lineBreak":true},{"text":"tuneeramach ashirangtaa,","poem":1},{"lineBreak":true},{"text":"itaru Ijiptoshuchsha tputs Apanllee kuk payumaam ngataranganaya.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Apanll kungoo zángana kuraseem ínarangu,","poem":1},{"lineBreak":true},{"text":"anumun kayupichsha pchingarangiya.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Ashiri Apanllsha yusur purumburoo zanganirangu,","poem":1},{"lineBreak":true},{"text":"ashchiri yaktash tatsitarangiya. Kurakshutam pang' tatsitarangiya.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Anumunsha, Apanll yusur yáyanlleetssha, mishat manxootstam zanganirangu,","poem":1},{"lineBreak":true},{"text":"ashchiri Ijiptosh tsap shuneeranganaya.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Anumunsha, sinaatssha pachindarangu,","poem":1},{"lineBreak":true},{"text":"itaru siseetssha ashcheew patumbich kapungumash zanganirangiya.","poem":1},{"lineBreak":true},{"text":"Sheeru, mamarootstam zanganirangu,","poem":1},{"lineBreak":true},{"text":"mamarshat kizpur mamartarangu, puuj ashirangu, tsapoo muchirangiya.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Amb ashirangu, Ijiptoshuch mazar tatsumma tpachingarangiya.","poem":1},{"lineBreak":true},{"text":"Mishat, yasinaatssha ichipeeru muchirangtamta.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Anumunsha, yusur putindaree zanganirangu,","poem":1},{"lineBreak":true},{"text":"putindarsha zapan parat ashirangu,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"wanusee tatsumma, manginawaatstam war,","poem":1},{"lineBreak":true},{"text":"chirichireewaatstam war kapzingta, kapzingta ashirangu, waroo kachingaranganaya.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Anumunsha, yusur tsipatsimasheetssha Ijiptoshchee wip iwachiztamaw tsipamaam wayarangiya.","poem":1},{"lineBreak":true},{"text":"Ashchiri tsap shuneerangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Aship ashirangu, Ijiptoshchee zapan yachayaranllu,","poem":1},{"lineBreak":true},{"text":"sheeru wizpurpa tiptsireetssha Ijiptoo tsap tashitungayaranllu, machtarangiya.","poem":1},{"lineBreak":true},{"text":"Ijiptoshchee urkir, oroo mburshimasheetstam,","poem":1},{"lineBreak":true},{"text":"oroo chumbeepimasheetstam zapan yáyarusin, naataranganaya.","poem":1},{"lineBreak":true},{"text":"Nda pakchiyam xararanganaya.","poem":1},{"lineBreak":true},{"text":"Mapiyrsin ksanandari naataranganaya.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Naatarangsin, Ijiptoshuch tputs mang' ksarangusin,","poem":1},{"lineBreak":true},{"text":"napataranll ashirangana,","poem":1},{"lineBreak":true},{"text":"watam iyashchee puniranganawa.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Zitaminarinsha tsap puzap naatarangsin,","poem":1},{"lineBreak":true},{"text":"kaschir naamaam Apanll psaspa zaree kámanarangiya.","poem":1},{"lineBreak":true},{"text":"Psaansha naamaam sumas kizpur tuwasineemaam wayarangitamta.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Katungtseemsha Apanllee masharangsin,","poem":1},{"lineBreak":true},{"text":"katamsheetssha zamzee panarangitamta.","poem":1},{"lineBreak":true},{"text":"Katungats íwarpichee kis katungkusin, tazaz taaranganaya.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Kungsha pishtarangu, Móysisarinsha tushuwshishpa patumbchee tuw ashirangu,","poem":1},{"lineBreak":true},{"text":"Apanllsha kungoo patumbchish tashitungarangu, zaw wir ashirangu,","poem":1},{"lineBreak":true},{"text":"kungsha tsap puzawpitaa naantangatamach ashirangiya.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Mishat, Apanll yuwaa tiptsirpa Aprahamarinpa piy ashtachima,","poem":1},{"lineBreak":true},{"text":"tárangu anoo nda pakchiyam mbizarangiya.","poem":1},{"lineBreak":true},{"text":"Izuuru tuminurangiya.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Waana tiptsiree Ijiptosh tsap tapachindarangu, tashitungarangu,","poem":1},{"lineBreak":true},{"text":"tputssha shitungeerandsin, zamangakatarat, ashiranganaya.","poem":1},{"lineBreak":true},{"text":"Mang' ksaksin shambataranganaya.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Apanll waana tiptsireem nllitaritaa tputs watsapun panarangu,","poem":1},{"lineBreak":true},{"text":"uwshtisin anoo itutseersin, mazareewaatstam, tatsumawaatstam,","poem":1},{"lineBreak":true},{"text":"wanuseewaa ichinguru zitaminarineem panarangiya.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Itaru, Apanll ashkachu; Papcha, Waneeyantspa.","poem":1},{"lineBreak":true},{"text":"Nuwaa kuki izuuru payungtsa.","poem":1},{"lineBreak":true},{"text":"Mishat, nuwaa tayaspatamaree tuminungtsa, tárangu, watsapuneem panarangiya.","poem":1},{"lineBreak":true},{"text":"Apaa, ¿shiy wizpurish tamara?","poem":1},{"lineBreak":true},"Apaa, ¡Yungpaktishcha! shiyaa atiniya."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":44}