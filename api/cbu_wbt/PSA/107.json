{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":107,"content":[{"type":"heading","content":["Apanll kchinamishcha"]},{"type":"verse","number":1,"content":[{"text":"Apanllee, wapparee, tángints, watam minamari wanasiriwa.","poem":1},{"lineBreak":true},{"text":"Urutamari iyaa chinaku taakiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apanllpa tsiyatkuni, amb táyani.","poem":1},{"lineBreak":true},{"text":"Watam kundararini iyaa kasirangitaateesinaya,","poem":1},{"lineBreak":true},{"text":"pseertartaatini taaranguni, Apanll iyaa yanpuyaru, iyaamshutam tsapunni wayarangiya.","poem":1},{"text":"Yap zar yaku ambtam,","poem":2},{"lineBreak":true},{"text":"yap zar puku ambtam,","poem":2},{"lineBreak":true},{"text":"yap zar puwachingarattu ambtam taaranguni,","poem":2},{"lineBreak":true},{"text":"Waana Apanll yanpuyaru, tsapunishtam wayarangiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Iyashuch tputs ashpatam masarsin,","poem":1},{"lineBreak":true},{"text":"Tsap puzap tputs ndunarip xixtarashin, ashiranganaya.","poem":1},{"text":"Yap ngoots ndunarip, yaktatam ndunari ambtam naataranganaya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mariz kayatarangsin,","poem":1},{"lineBreak":true},{"text":"sachitarangtamsin,","poem":1},{"lineBreak":true},{"text":"Marizimun pakchim tsipamaam pshataranganaya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kapung puniksin, tsipatureema, atusin,","poem":1},{"text":"Apanllee kuruzuranganaya. Apaa, Istanda, táranganaya.","poem":2},{"text":"Apanllsha mazinarangu, kapung istarangiya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yapsha ngoots wanasiri ambsha machtarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ashiriya Apanllee, Wapparee, táyani,","poem":2},{"lineBreak":true},{"text":"yuwamand iyaa kapung istarangu anumanda.","poem":2},{"lineBreak":true},{"text":"Watam iyaa uru istaranguwa.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tputs sachitkusin, wasachee imayungakiya.","poem":2},{"lineBreak":true},{"text":"Katungtsee kapung panarangitamta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mishat, iyashchi tputs tunimushpaz taaksina,","poem":1},{"lineBreak":true},{"text":"ashirusin kiyung kachiyaranganaya.","poem":1},{"lineBreak":true},{"text":"Putám kateenpa kamurim tamaparee ashirusin, mang' kapung kiyung kachiyaranganaya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Apanllee kuk kapung ngatkusin, nda mazinarangana.","poem":1},{"text":"Taarashipan wamaritaa kasiku, anootstaa kuk ngatarangsin,","poem":2},{"lineBreak":true},{"text":"Watsta. ¿Chak ashishtapa? tárangana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ashiri Apanllsha tsiyantarangu, Israelshuchee tputs tumuchchurtamaam wayarangiya.","poem":1},{"lineBreak":true},{"text":"Taárashee yutari wayarangiya.","poem":1},{"lineBreak":true},{"text":"Ashirangu, zarnasimun pakchim tsipamaam pishtarangana,","poem":1},{"lineBreak":true},{"text":"¿Watam tputs istampan ndunarimunawa?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Itamsamaam pinasaksin, ¿Chakaja iyaa istach? atusin,","poem":1},{"lineBreak":true},{"text":"Apanllee kuruzuranganaya. Apaa, Istanda, táranganaya. Apanllsha mazinarangu,","poem":1},{"lineBreak":true},{"text":"iyaa nayaniku, tapachindarangiya.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sheeru, iyaanpee tsapunni kanapumaam ngoots wanasiripsha yámandarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ashiriya Apanllee, Wapparee, táyani,","poem":2},{"lineBreak":true},{"text":"yuwamand iyaa kapung istarangu anumanda.","poem":2},{"lineBreak":true},{"text":"Watam iyaa uru istaranguwa.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Iy tumanampaz ashiruni taarangtaatini, tumanshish wach ngusambpapaz tinama ashiru,","poem":2},{"lineBreak":true},{"text":"anoo Apanll ichipambayaru, iyaa tashitungarangiya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mishat, iy zitaminarini ashpatam Apanllee kuk kapeetarangsin,","poem":1},{"lineBreak":true},{"text":"waanamandari yutaritshishirini, mang' ndunpaz ashiranganaya.","poem":1},{"lineBreak":true},{"text":"Kizpur wanguytarangusin, kiyung kachiyarangsin,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"tsipamaam zandakusin,","poem":1},{"lineBreak":true},{"text":"katungtsee tsachiyaksin, kataranganaya.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Waanaatsee tapachindamaam pinasarangana.","poem":1},{"text":"Tsipataruneepa atusin, Apanlleetssha, Apaa, shiyamari istamaam waritaksha.","poem":2},{"lineBreak":true},{"text":"Istangcha iyaatsi, táranganaya.","poem":2},{"text":"Apanllsha nayanirangu,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"tsiyatarangu, Yarchintspa, tárangiya.","poem":1},{"lineBreak":true},{"text":"Tárangu, wánguyar tsipatsimasheetstaa arap kapeetarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ashiriya Apanllee, Wapparee, táyani,","poem":2},{"lineBreak":true},{"text":"yuwamand iyaa kapung istarangu anumanda.","poem":2},{"lineBreak":true},{"text":"Watam iyaa uru istaranguwa.","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ashiri chineetsis putayarus, Apanllip pang' machtayarus, muchingints.","poem":2},{"lineBreak":true},{"text":"Sheerus, Apanllee Wapparee, tángints.","poem":2},{"lineBreak":true},{"text":"Mangis ksanandari tputsee, ¿Apanll wanip iyaa istaka? Uru kapung istakiya, tángtsa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mishat, iy zitaminarini ashpatam marip mus kapungumaship xiyranganaya.","poem":1},{"lineBreak":true},{"text":"Maachiritaa tupaxanxangatu, minup tsap naatarangsin,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Mus apusanand Apanllee tínamarini parangusin, kapung puniranganaya.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Apanll kambusuroo kamachtaku, tárangiya.","poem":1},{"lineBreak":true},{"text":"Kizpur kambustangcha.","poem":1},{"text":"Ashkachush, kungsha kizpur warastachpa, tárangiya.","poem":2},{"text":"Tárangu, mussha kapung kizpur warastarangu,","poem":1},{"lineBreak":true},{"text":"íwar manginaa káchingkaru, zaw zaw ántaru,","poem":1},{"lineBreak":true},{"text":"pzachtataru, íwar kárirataraa,","poem":1},{"text":"yusursha wantsush imurip karuwataraa, yusursha kárirataraa ashtar ashirangiya.","poem":2},{"text":"Anoo tputs parangusin, kapung napuxtaranganaya.","poem":1},{"lineBreak":true},{"text":"Tsipachpachee, tárangana.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Watam mus kizpur warastarangu, bot tawinintara, tawinintara ashirangu,","poem":1},{"text":"naamam wanasir pinasaranganawa.","poem":2},{"text":"Tputs karusam naaku tamartarpari ashirusin naataranganaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Itaru, amb ashku anoo parangusin, kapung puniksin,","poem":1},{"lineBreak":true},{"text":"Apanllee tsiyatkusin, táranganaya. Apaa, iyaa istangcha. Tapachindangcha, tárangusin,","poem":1},{"lineBreak":true},{"text":"Apanllsha istarangiya.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Kapungtaa warastarangu, kambusursha zanayataramach ashirangu,","poem":1},{"lineBreak":true},{"text":"warassha achtamarisha maras, maras, ashishtaramach ashirangiya.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Waras zanaramchu, anoo parangusin, mang' ksaranganaya.","poem":1},{"lineBreak":true},{"text":"Apanll ashirangu, waana tputsee machtarangu,","poem":1},{"lineBreak":true},{"text":"yap patusis wanasiri paramashtaru annung matayaranganaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ashiriya Apanllee, Wapparee, táyani,","poem":2},{"lineBreak":true},{"text":"yuwamand iyaa kapung istarangu anumanda.","poem":2},{"lineBreak":true},{"text":"Watam iyaa uru istaranguwa.","poem":2}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Shaniyeeruni, Apanllee kurakareetsini ungirtayani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Yuwamand tputs yutarit taarangana, anumand Apanll waana kamachtaku,","poem":1},{"lineBreak":true},{"text":"yuwaatstaa kung shungshungtaru anootstaa puzarangiya.","poem":1},{"lineBreak":true},{"text":"Tsapootstam tayutariteeyaru,","poem":1},{"text":"tatsumirangsin, nda pakchiyam wanasir kxoonarangiya.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Itaru, yuwshat tputs Apanllee kuk payurangana,","poem":1},{"lineBreak":true},{"text":"anshitisin tsap puzamunaatstaa, wanasireemsha wayarangiya.","poem":1},{"lineBreak":true},{"text":"Anumunsha, kungoots wanasir shungshungtaru wayarangitamta.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Tputs ichtaru marizimun kiyung kachiyarangana,","poem":1},{"lineBreak":true},{"text":"anshitisin pangoo kapung pangupangu ashirangsin, yaktaamsha kinarangiya.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Sheeru, mazareemsha kizarunaa wanusi tatsumeersin,","poem":1},{"lineBreak":true},{"text":"pzapaneerangusin, zapan wanusee pusaranganaya.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Waana Apanll istaku, ashirangiya.","poem":1},{"lineBreak":true},{"text":"Wipaatstamsin pzapaneeranganaya.","poem":1},{"lineBreak":true},{"text":"Anumunsha, chinuzee wakaraatstam pzapaneeranganaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Wandtaatiya tputs chawap tsipakchusin,","poem":1},{"lineBreak":true},{"text":"misha wakararinitam tsipakchu, pakchimsha katuchkachu,","poem":1},{"lineBreak":true},{"text":"anootssha tputs natsampansha kiyung yachakchu,","poem":1},{"lineBreak":true},{"text":"yuwamand tputs mang' mantsaksin, tanukana,","poem":1},{"lineBreak":true},{"text":"anumand","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Apanllsha natsampanee wanichiya.","poem":1},{"lineBreak":true},{"text":"Tsap puzap, ngoots ndunarip, apusap zanganchiya.","poem":1},{"lineBreak":true},{"text":"Ambiri yutaritshishpan masataru izuuru pastachiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"Tputs pukir kiyung kachiyku, anoo Apanll pakchu, kapung istachiya.","poem":1},{"lineBreak":true},{"text":"Yap nda chinaru amb Apanll wipaamsha pzapanimaam,","poem":1},{"lineBreak":true},{"text":"misha maachiritam pzapanimaam istachiya.","poem":1},{"lineBreak":true},{"text":"Opeej ashiru wip zapan turutut, turutut ashtachiya.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Anootssha pakchusin, yuw tputs Apanllee kuk payuku, tuminku,","poem":1},{"lineBreak":true},{"text":"anshtisin mang' ksachinllinaya.","poem":1},{"lineBreak":true},{"text":"Yutaritshishpansha tputs anoo pakchusin,","poem":1},{"lineBreak":true},{"text":"paziksin, kuk mbamatakpaz ashtachpasinaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Manguriri tputs anoo pakchusin,","poem":1},{"lineBreak":true},{"text":"mangush chinaku, uru yuwaa Apanll tputsee chinaku anoo yasachpasinaya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":40}