{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":110,"content":[{"type":"heading","content":["Dapiy yuwaa Apanll ipusamarini wamari kasichu anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Dapiyarini wayassi."]},{"type":"verse","number":1,"content":[{"text":"Apanll Taarashipan nuwaa kurakari, waanaatsi ipusamarini, tárangiya;","poem":1},{"lineBreak":true},{"text":"Shiy ningich mbutsunungich k'xinangcha.","poem":1},{"lineBreak":true},{"text":"Nuwsha kundarareetsish kasiyeeruri, tpachingachima,","poem":1},{"noteId":64},{"text":"tárangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ashiriya kurakaa, Apanll shiyaam waanaatsi wizpur kundarareetsish kasimaam panachu,","poem":1},{"lineBreak":true},{"text":"shiysha mach Siyonamand kizpur kurak shiyamari kasiru taangcha.","poem":1},{"lineBreak":true},{"text":"Ashiriya, kundarareetsish ksingcha, atina.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tapazeemsha waritakchu, Siyonash mach shiysha,","poem":1},{"lineBreak":true},{"text":"Kasiyeeni, tákchush, tputsirishtish, Ayu, táchinllinaya;","poem":1},{"lineBreak":true},{"text":"Anush kanungas wizpur ashirush nizcheezish, ndambaree.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Apanll waana zurampatari shiyaa kasimaam wayarangu,","poem":1},{"lineBreak":true},{"text":"nllitari ndusha chinachiya.","poem":1},{"lineBreak":true},{"text":"Shiy Melkisarin tamapari ashirush urutamari apanllpan urkar taachsha,","poem":1},{"lineBreak":true},{"text":"ayamamtiyam nda pastamaama,","poem":1},{"noteId":65},{"text":"Apanll shiyaa tárangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apanll shiyaam tuwizpurtamaam washunand mbutsinungich naachiya.","poem":1},{"lineBreak":true},{"text":"Ashkachu, kundarareetsish waneeyarush,","poem":1},{"lineBreak":true},{"text":"kurakaatstam ichingaru kasiyarush tpachingachsha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tsapurunasee kurak ztaru, tpachingayarush,","poem":1},{"lineBreak":true},{"text":"tputseetssha, minchichee tputs, minchichee tputs ashiru ichinguroo waneeyarush","poem":1},{"lineBreak":true},{"text":"tsiparee washunand xanatatsha.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sheerush, arangeem tapazeem naakchush, ngootsush kungoo waakchush,","poem":1},{"lineBreak":true},{"text":"yusur wizpurireetsish tuwizpurtachiya,","poem":1},{"lineBreak":true},"Dapiyarini yaseeku, Apanllee ipusamarini tárangiya."]}],"footnotes":[{"noteId":64,"caller":"*","text":"Yuwaa nish átu anootstam Matiwa 22.44; Márkosa 12.36; Lukasa 20.42-43; Tayaspatampani 2.34-35; 1 Koríndshucheema 15.25; Ipísshucheema 1.20-22; Kólosénshucheema 3.1; Utaáshucheema 1.13; 8.1; 10.12-13 tayusima kamankiya.","reference":{"chapter":110,"verse":1}},{"noteId":65,"caller":"*","text":"Yuwaa nish átu anootstam Utaáshucheema 7.17 tayusima kamankiya. Mishat, Utaáshucheema 5.6; 6.20—7.28 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":110,"verse":4}}]},"thisChapterLink":"/api/cbu_wbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":7}