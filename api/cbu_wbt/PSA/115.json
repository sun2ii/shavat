{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":115,"content":[{"type":"heading","content":["Apanll kanindshuri taaru anoo kamankiya"]},{"type":"verse","number":1,"content":[{"text":"Apaa, tputs nda iyaa ungirtachinllinpa;","poem":1},{"lineBreak":true},{"text":"shiyaatsimari ungirtachinllinpa.","poem":1},{"lineBreak":true},{"text":"Watam shiyamari tputsee izuuru chinakshawa.","poem":1},{"lineBreak":true},{"text":"Shiyamari shaanaatsi kukish tatsamooksha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Min tputs iyaa staksin, ¿Siy Apanlliris yapeeja?","poem":1},{"lineBreak":true},{"text":"Iy pakeezini, atanaya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Itaru, shiysha Apaa, kanindush shiyamari kasiru taaksha.","poem":1},{"lineBreak":true},{"text":"Shiy yuwaa shaana zandkish anoo tinaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Minshuch tputs waama apanllirini tinakanaya.","poem":1},{"lineBreak":true},{"text":"Ur chumbeepimashpa, misha ur mburshimashpatatam tinakanaya.","poem":1},{"lineBreak":true},{"text":"Uwpatari tinakanaya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuk taaritaa, itaru nda tsiyatkanaya.","poem":1},{"lineBreak":true},{"text":"Wach taaritaa, itaru nda pakanaya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wits taaritaa, itaru nda mazinakanaya.","poem":1},{"lineBreak":true},{"text":"Ship taaritaa, itaru nda ishingkanaya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Uw taaritaa, itaru nda patatkanaya.","poem":1},{"lineBreak":true},{"text":"Wats taaritaa, itaru nda naakanaya.","poem":1},{"lineBreak":true},{"text":"Wayarpunush nda pakchiyam zunganeekiya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tputs waama apanllirini tinayarusin, anumun mang' tatkanaya.","poem":1},{"lineBreak":true},{"text":"Itaru, tinam tamapari ashirusin, mangsharitssincha,","poem":1},{"noteId":66},{"text":"nuw shiyaa Apaa, atina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ashiri siynaa Israelchichis, Apanllimunari mangis tatungtsa.","poem":1},{"lineBreak":true},{"text":"Apanlltanda iyaa istaku, ksutku.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Siy apanllpanis, Apanllimunari mangis tatungtsa.","poem":1},{"lineBreak":true},{"text":"Apanllcha iyaa istaku, ksutkiya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Siysa ichingurus yuwis Apanllee chinakis anis,","poem":1},{"lineBreak":true},{"text":"Apanllimunari mangis tatungtsa.","poem":1},{"lineBreak":true},{"text":"Apanllcha siyaa istaku, ksutkasha, atina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Apanll iyaa chinakiya. Iyaa mbizamaam wanindaja.","poem":1},{"lineBreak":true},{"text":"Uru istachiya. Iyaa Israelchichineetsini ichingaru ksutkiya.","poem":1},{"lineBreak":true},{"text":"Apanllpaneetstam ksutkiya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wachinawaatstam, nllurawaatstam ichingaru tputs yuwaa Apanllee chinakana anoo,","poem":1},{"lineBreak":true},{"text":"Apanll uru istachiya.","poem":1},{"noteId":67}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ipartamtis, mishat chinllinitamtis uru izapanichiya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Apanll Taarashipan yuw waana kaninda,","poem":1},{"lineBreak":true},{"text":"misha tsapootstam tinarangu an siyaam uru istachintsa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Apanll kanindap taakiya.","poem":1},{"lineBreak":true},{"text":"Itaru, iyaamsha tputseemani tsapoo ksutamaam wayarangiya.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yuw tputs tsiparangana an nda Apanllee ungirtakanaya.","poem":1},{"lineBreak":true},{"text":"Izuuru zaputar ashkanaya.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Itaru, yuwshtini nda tsiparini, anshtini","poem":1},{"lineBreak":true},{"text":"Uru Apanllee kis ungirtakuni taakaniya.","poem":1},{"lineBreak":true},"Apaa, ¡Yungpaktishcha! shiyaa atiniya."]}],"footnotes":[{"noteId":66,"caller":"*","text":"Apanll wanichu anu 9.20 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":115,"verse":8}},{"noteId":67,"caller":"*","text":"Apanll wanichu anu 11.18; 19.5 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":115,"verse":13}}]},"thisChapterLink":"/api/cbu_wbt/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":18}