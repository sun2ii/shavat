{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":116,"content":[{"type":"heading","content":["Apanllee, Wapparee, watam nuwaa istarangshawa, atiya"]},{"type":"verse","number":1,"content":[{"text":"Apanllee nuw chinakina, watam, Apaa, istanda aturi,","poem":1},{"lineBreak":true},{"text":"nuwaa mazinakchu istakuwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuw urutari Apanllee mashkuri taachina.","poem":1},{"lineBreak":true},{"text":"Watam nuwaa mazinakuwa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tsipats nuwaa izuuru kasimaam waritarangu,","poem":1},{"lineBreak":true},{"text":"kapung puniranguri; Tsipatureema, táranguri,","poem":1},{"lineBreak":true},{"text":"itamsamaam pinasarangina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ashiranguri, nuwsha, Apaa, shiy taarashipantishcha.","poem":1},{"lineBreak":true},{"text":"Nuwaa taarashi tapachindandama, táranguri,","poem":1},{"lineBreak":true},{"text":"Apanllsha nuwaa tapachindarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apanll iyaa taarasheetsini itsinsartaa yasaku,","poem":1},{"lineBreak":true},{"text":"itaru iyaa nayanikiya.","poem":1},{"lineBreak":true},{"text":"Apanll Taarashipan chinampancha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tputs waanaatsi tapachindamaam pinasakitaa,","poem":1},{"lineBreak":true},{"text":"itaru Apanllsha uru ksutkiya.","poem":1},{"lineBreak":true},{"text":"Nuw wizpuriri ndunnaar taarangi Apanllsha nuwaa tapachindarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Apanll nuwaa kapung istarangu,","poem":1},{"lineBreak":true},{"text":"ashirucha, nuwsha yusur nda punikuri, mapiyruri taakina.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nuwaa tsipani tapachindarangiya.","poem":1},{"lineBreak":true},{"text":"Tsipamaam punikuri, kapung tanuranguri,","poem":1},{"lineBreak":true},{"text":"itaru Apanllsha nuwaa istarangu yararangiya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ashiriya, nuwsha urutari nish tsapurunasush taakuri,","poem":1},{"lineBreak":true},{"text":"Apanllee kuk tuminchima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nuwaam xarashish kapung taarangtaa,","poem":1},{"lineBreak":true},{"text":"itaru Apanllimun mangi taturangina.","poem":1},{"noteId":68}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tputsimun mangich tatumaam wanindaja.","poem":1},{"lineBreak":true},{"text":"Ichingurusin tputs wayangichirirsincha.","poem":1},{"noteId":69}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Itaru, Apanll ¿wanip nuwaa istaranga?","poem":1},{"lineBreak":true},{"text":"¿Maypata nuw Apanllee tuwapachi? Tuwapamaam pinasakina.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Itaru, itsinsaru Apanllee tachitkuri,","poem":1},{"lineBreak":true},{"text":"misha, Wappari Apaa, aturi, tuwapakpaz ashkina.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mishat, yuwaa, Apanllee; Shiyaam ashtachparina, tárangi, anoo","poem":1},{"lineBreak":true},{"text":"tiptsirpata shaniykuni, itsinsaru k'keetsi tatsamchima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Apanll waana tiptsir tsipakchu, kiyung kachiyku,","poem":1},{"lineBreak":true},{"text":"anungaz kapung mangu mantsakiya.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Shiyaa chinakina, Apaa. Nuw shiycha kamachtashish.","poem":1},{"lineBreak":true},{"text":"Aneeri shiyaa kapung chinaku,","poem":1},{"lineBreak":true},{"text":"ashiritam nuw shiyaa chinakina.","poem":1},{"lineBreak":true},{"text":"Nuw tsipamaam pakich pishtaranguri,","poem":1},{"lineBreak":true},{"text":"shiysha nuwaa tapachindarangsha.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ashiri shiyaam, Apaa, chinuzee pachayaruri,","poem":1},{"lineBreak":true},{"text":"shiyash sumish muchima.","poem":1},{"lineBreak":true},{"text":"Sheeruri, shiyaatsimari ungirtachima.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Shiyashchi tputs shiyash pangish tipuranllizush shaniykatssin,","poem":1},{"lineBreak":true},{"text":"anush nuw izuuru k'keetsi, yuw shiyaa tsiyatarangi, anoo tuminchima.","poem":1},{"lineBreak":true},{"text":"Uru Irusarinush shiyaa ungirtakuri taachima.","poem":1},{"lineBreak":true},"Apaa, ¡Yungpaktishcha! atiniya shiyaatsi."]}],"footnotes":[{"noteId":68,"caller":"*","text":"Yuwaa nish átu anootstam 2 Koríndshucheema 4.13 tayusima kamankiya.","reference":{"chapter":116,"verse":10}},{"noteId":69,"caller":"*","text":"Romshucheema 3.4 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":116,"verse":11}}]},"thisChapterLink":"/api/cbu_wbt/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/118.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":18}