{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":118,"content":[{"type":"heading","content":["Apanll wizpuririni ¡waninllee! átu, anoo kamankiya"]},{"type":"verse","number":1,"content":[{"text":"Apanllee, Apaa, Wapparee, táyani,","poem":1},{"lineBreak":true},{"text":"watam Apanll wanasirimshiwa.","poem":1},{"lineBreak":true},{"text":"Urutamari iyaa chinakiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Siy Israelchichis,","poem":1},{"lineBreak":true},{"text":"Apanll iyaa urutamari chinakiya, tángtsa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mishat, siy apanllpanis,","poem":1},{"lineBreak":true},{"text":"Apanll iyaa urutamari chinakiya, tángtamtsa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mishat, siy tputsis yuwis Apanllee chinakis anis,","poem":1},{"lineBreak":true},{"text":"Apanll iyaa urutamari chinakiya, tángtamtsa.","poem":1},{"lineBreak":true},{"text":"Ichingarus Apanllimun shambatangtsa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nuwaam xarashish kapung taarangu,","poem":1},{"lineBreak":true},{"text":"Apanllee, Apaa, istanda, táranguri,","poem":1},{"lineBreak":true},{"text":"Apanllsha nuwaa mazinarangu, tapachindarangiya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Apanll uru nuwash taakiya.","poem":1},{"lineBreak":true},{"text":"Ashirucha, nuwsha tputsee nda puniki.","poem":1},{"lineBreak":true},{"text":"¿Chakaja nuwaa kasiku kasich? Pinasakanaya.","poem":1},{"noteId":70}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apanll nuwapa ipunkiya.","poem":1},{"lineBreak":true},{"text":"Uru nuwaa istakiya,","poem":1},{"lineBreak":true},{"text":"Tputs nuwaa natsaktaa, Pachayani, atitaatssin,","poem":1},{"lineBreak":true},{"text":"Apanllsha nuwamari kasimaam wayachiya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apanllimunari mangich tatumaam waritariya.","poem":1},{"lineBreak":true},{"text":"¿Mayaamaja tputsimun mangich tatchich?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apanllimunari mangich tatumaam waritariya, atina.","poem":1},{"lineBreak":true},{"text":"Tputs kizpuritaa taaksin,","poem":1},{"lineBreak":true},{"text":"¿mayaamaja uwamun mangich tatchich?","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Minchich tputs nuwaa pachamaam turipungarangusin,","poem":1},{"lineBreak":true},{"text":"Pachapani tárangitaatssin,","poem":1},{"lineBreak":true},{"text":"Itaru, nuwsha Apanllimun wizpur nuwamarisha kasirangina.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Izuuru zapan nuwaa turipungarangusin,","poem":1},{"lineBreak":true},{"text":"itaru Apanllimun wizpur nuwamari","poem":1},{"lineBreak":true},{"text":"ichingaroo kasirangina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Zan ashirusin, zapan nuwaa turipingarangana.","poem":1},{"lineBreak":true},{"text":"Itaru, sumas kpaa muchtaru ashiruri,","poem":1},{"lineBreak":true},{"text":"Apanllimun wizpur nuwamari ichingaroo kasirangina.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wizpurpa nuwaa kasimaam,","poem":1},{"lineBreak":true},{"text":"izuuru tupantsamaam zandarangtaatssin,","poem":1},{"lineBreak":true},{"text":"itaru Apanllsha waanpata wizpur nuwaa tapachindarangiya.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Apanll nuwaa kasimaam tuwizpurtarangiya.","poem":1},{"lineBreak":true},{"text":"Ashirucha, nuwsha na Apanllee yaseekuri, ungirtakuri taakina.","poem":1},{"lineBreak":true},{"text":"Apanll watacha tapachindampani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Apanll tiptsir waanshu pang' Apanllimun shamangaksin,","poem":1},{"lineBreak":true},{"text":"Apaa, shaanpata wizpurirish iyaa tapachindarangush, iyamari kasiranginiya.","poem":1},{"lineBreak":true},{"text":"Shiy, Apaa, kizpurtishcha, atanaya.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Apanll waanpata wizpur wamari kasikiya.","poem":1},{"lineBreak":true},{"text":"Minamtiyam tputs ashimaam wanindaja.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ashiriya, nuw nda tsipachina. Izuuri taachina. Tputsee, ¿Wanip Apanll nuwaa istaranga? tákchuri,","poem":1},{"lineBreak":true},{"text":"tputsee ichinguru kamanchina.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Apanll nuwaa kapung waneerangitaa,","poem":1},{"lineBreak":true},{"text":"itaru nda tsipamaam wayarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ashiri nuwaam Apanll pang' wach tawatangcha.","poem":1},{"lineBreak":true},{"text":"Nuwsha pshtuyaruri Apanllee, Wappari tápi, atina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Iy Apanllchichini Apanllish pang' pshtuyaruni,","poem":1},{"lineBreak":true},{"text":"anush Apanllpat ipunchiniya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ashirucha, nuwsha shiyaa, Apaa, wappari, atina,","poem":1},{"lineBreak":true},{"text":"watam shiy nuwaa kuki mazinarangush,","poem":1},{"lineBreak":true},{"text":"nuwaa tapachindarangshawa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Siyaa Apanllchicheetsis k'kuzee napuxtamashee kamanchintspa.","poem":1},{"lineBreak":true},{"text":"Panguspan tputs panguksin, patumbchee wanasiriwaatstaa yaksin,","poem":1},{"lineBreak":true},{"text":"itaru; Annaa wanasireeja, tárangusin, kapeetaranganaya.","poem":1},{"lineBreak":true},{"text":"Ashiritaa, Apanllsha patumbchee ipuseeru, zurampatari wanasir wayarangiya.","poem":1},{"lineBreak":true},{"text":"Natunaa kizpur wanasiri pashuchima, Apanll tárangiya.","poem":1},{"noteId":71}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Apanlltanda ashirangu atuni,","poem":1},{"lineBreak":true},{"text":"¿Tamaru Apanll kizpur wanasir ashiranga? táchiniya.","poem":1},{"noteId":72}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Apanllsha ashirangu, na in zar iyaa tapachindayanlliya.","poem":1},{"lineBreak":true},{"text":"Ashiri iysha shiyamun Apaa, mangini kis shambatkiniya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Apaa, iyaa izuuru tapachindangcha.","poem":1},{"lineBreak":true},{"text":"Iyaam wanasiri taamaam istangcha, atiniya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Shaana ipusamarineetsish iyaam zangankush","poem":1},{"lineBreak":true},{"text":"wanasiri napangcha.","poem":1},{"noteId":73},{"lineBreak":true},{"text":"Sheerush, iysha shiyash pangish shaniyeeruni,","poem":1},{"lineBreak":true},{"text":"iyaatstam wanasiri napangcha, atina.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Apanll Taarashipan wamari kasiru taakiya.","poem":1},{"lineBreak":true},{"text":"Iyaa mangeetsini tuwasinichiya.","poem":1},{"lineBreak":true},{"text":"Ashiri Apanllimun shambateeni. Masharoo war kuyaruni,","poem":1},{"lineBreak":true},{"text":"Apanllish pangu pshtuyaruni,","poem":1},{"lineBreak":true},{"text":"Apanllip suma wakara witsip xanatchinipa, atina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Apaa, shiyaa, Wappari, atina. Shiyamari kasiksha,","poem":1},{"lineBreak":true},{"text":"Shiyaa nuw Apareetseeruri, ungirtakina.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Shiy Apaa, kizpur wanasirtishcha.","poem":1},{"lineBreak":true},{"text":"Shiy urutamari iyaa chinaksha.","poem":1},{"lineBreak":true},{"text":"Ashiri ichinguruni, shiyaa Apaa, Wappari, atiniya.","poem":1}]}],"footnotes":[{"noteId":70,"caller":"*","text":"Yuwaa nish átu anootstam Utaáshucheema 13.6 tayusima kamankiya.","reference":{"chapter":118,"verse":6}},{"noteId":71,"caller":"*","text":"Yuwaa nish átu anootstam Lukasa 20.17; Tayaspatampani 4.11, misha 1 Pitoru 2.7 atitamta.","reference":{"chapter":118,"verse":22}},{"noteId":72,"caller":"*","text":"Yuwaa nish átu anootstam Matiwa 21.42, misha Márkosa 12.10-11 tayusima kamankiya.","reference":{"chapter":118,"verse":23}},{"noteId":73,"caller":"*","text":"Yuwaa nish átu anootstam Matiwa 21.9; 23.39; Márkosa 11.9; Lukasa 13.35; 19.38; Wanga 12.13 tayusima kamankiya.","reference":{"chapter":118,"verse":26}}]},"thisChapterLink":"/api/cbu_wbt/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/116.json","previousChapterAudioLinks":{},"numberOfVerses":29}