{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":119,"content":[{"type":"heading","content":["Apanllee kuk kizpur chinakina atiya"]},{"type":"verse","number":97,"content":[{"text":"Tamaru nuw shiyaa kukish chinakina, Apaa.","poem":1},{"lineBreak":true},{"text":"Ichinguru zar shiyaa kukish chinakuri taakina.","poem":1}]},{"type":"verse","number":98,"content":[{"lineBreak":true},{"text":"Uru shiyaa kamachtamarish kis payukina.","poem":1},{"lineBreak":true},{"text":"Kamachtamareetsish kapung yasakuri, mangiptarti itsinsaru chinakina.","poem":1},{"lineBreak":true},{"text":"Kundarari nda ashkanaya.","poem":1},{"lineBreak":true},{"text":"Ashiriya, kundarareetsi kasiru mangoonkina.","poem":1}]},{"type":"verse","number":99,"content":[{"lineBreak":true},{"text":"Kamachtamareetish uru chinachintar ashkuri,","poem":1},{"lineBreak":true},{"text":"mayistorootstaa kasiru mangoonkitamana.","poem":1}]},{"type":"verse","number":100,"content":[{"lineBreak":true},{"text":"Tputsee wachinawaatstaa, kasiru mangoonkitamana,","poem":1},{"lineBreak":true},{"text":"watam shiyaa kukish tuminkinawa.","poem":1}]},{"type":"verse","number":101,"content":[{"lineBreak":true},{"text":"Shiyaa kukish izuuru mangipti payupi aturi,","poem":1},{"lineBreak":true},{"text":"yutaritshishireetsi izuuru kasarangina.","poem":1}]},{"type":"verse","number":102,"content":[{"lineBreak":true},{"text":"Shiy shaana Apaa nuwaa tayaspataksha.","poem":1},{"lineBreak":true},{"text":"Ashiriya, shiyaa kukish kasacheezi, ndambaree.","poem":1}]},{"type":"verse","number":103,"content":[{"lineBreak":true},{"text":"Watam shiy chinashish kizpur wanasircha.","poem":1},{"lineBreak":true},{"text":"Mishat, kama kinduraa wayar waakuch, kizpur kisa an","poem":1},{"lineBreak":true},{"text":"tamapari ashiriya nuwaama shiy kukish.","poem":1},{"lineBreak":true},{"text":"Shiyamun kukish mangi kisa.","poem":1}]},{"type":"verse","number":104,"content":[{"lineBreak":true},{"text":"Shiy kukish nuwaa itsinsaru chinamaam tayapstakiya.","poem":1},{"lineBreak":true},{"text":"Ashiri tputs yutarit taaku an nuwaam kizpur yutarita.","poem":1}]},{"type":"line_break"},{"type":"verse","number":105,"content":[{"text":"Shiy kukish mbarinpaz ashiru shiyaa itsinsaru tachitamaam","poem":1},{"lineBreak":true},{"text":"ktsishtamti naamaam tuwasineekiya.","poem":1}]},{"type":"verse","number":106,"content":[{"lineBreak":true},{"text":"Shiyaa Apaa, sirú tárangina:","poem":1},{"lineBreak":true},{"text":"Shiy kukish wanasirimishcha.","poem":1},{"lineBreak":true},{"text":"Ashiri izuuru payuchima, táranguri, anoomari chinakina.","poem":1}]},{"type":"verse","number":107,"content":[{"lineBreak":true},{"text":"Apaa, kapung kiyung kachiykina. Itaru shiysha,","poem":1},{"lineBreak":true},{"text":"Nuw uru ksutchinllpa, tárangsha.","poem":1},{"lineBreak":true},{"text":"Ashiri taarasheetsi ksutanda, Apaa.","poem":1}]},{"type":"verse","number":108,"content":[{"lineBreak":true},{"text":"Shiyaa ungirtakuri, shiysha nuwaa kuki kis mazinangcha.","poem":1},{"lineBreak":true},{"text":"Shiy uru nuwaa itsinsaru tayaspataksha.","poem":1},{"lineBreak":true},{"text":"Ashiri mangeetsi p'tseengcha, mangipti taamaama.","poem":1}]},{"type":"verse","number":109,"content":[{"lineBreak":true},{"text":"Yutaritshishpan tputs nuwaa pachamaam zandkusin,","poem":1},{"lineBreak":true},{"text":"uru nuwash xarashish wayakanaya.","poem":1},{"lineBreak":true},{"text":"Itaru, nuwsha shiyamun kukish mangi tatkina.","poem":1},{"lineBreak":true},{"text":"Kasacheezi, ndambaree.","poem":1}]},{"type":"line_break"},{"type":"verse","number":111,"content":[{"text":"Shiy shaanaatsi kukish uru nuwaam istamaam panarangsha.","poem":1},{"lineBreak":true},{"text":"Ashiri mangishi payukuri, mangi ksakina.","poem":1}]},{"type":"verse","number":112,"content":[{"lineBreak":true},{"text":"Ashiriya, urutamari izuuru tsipatspatari shiyaa kukish chinapi atina.","poem":1},{"lineBreak":true},{"text":"Kasacheezi, ndambaree.","poem":1}]},{"type":"line_break"},{"type":"verse","number":129,"content":[{"text":"Shiy kukish Apaa, kizpur wanasircha.","poem":1},{"lineBreak":true},{"text":"Ashirucha, nuw shiyaa kukish izuuru payukina.","poem":1}]},{"type":"verse","number":130,"content":[{"lineBreak":true},{"text":"Shiyaa kukish tputs tayaspataku, wazareetsiri tputsee mang' p'tseekiya.","poem":1},{"lineBreak":true},{"text":"Tputs sirú nduntaa mazinarangu, mangoonamaam kamiranshita.","poem":1}]},{"type":"verse","number":131,"content":[{"lineBreak":true},{"text":"Nuwsha anungazimari mazinamaam zandkina.","poem":1},{"lineBreak":true},{"text":"Uru kis mazinakina.","poem":1}]},{"type":"verse","number":132,"content":[{"lineBreak":true},{"text":"Shiysha Apaa, uru tputsireetsish chinaksha.","poem":1},{"lineBreak":true},{"text":"Ashiri nuwaa nayanikush istanda.","poem":1}]},{"type":"verse","number":133,"content":[{"lineBreak":true},{"text":"Shiyaa kukish uru payumaam nda kapeetamaam istanda.","poem":1},{"lineBreak":true},{"text":"Yutaritshish nuwaa kasirundama, átana.","poem":1}]},{"type":"verse","number":134,"content":[{"lineBreak":true},{"text":"Tputs nuwaa, Pachayani, atusin, ashiri shiysha Apaa tapachindanda.","poem":1},{"lineBreak":true},{"text":"Nuw shiyaa kukish izuuru tuminpi atina.","poem":1}]},{"type":"verse","number":135,"content":[{"lineBreak":true},{"text":"Nuwaa chinampa wanasiri napangandama.","poem":1},{"lineBreak":true},{"text":"Shaanaatsi kukish aranginasha nuwaa tayaspatangandama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":22}