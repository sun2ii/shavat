{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":121,"content":[{"type":"heading","content":["Apap uru iyaa ksutku anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Tputs Apanllip pang' Siyonap machip kárkatssin yaseeranganaya."]},{"type":"verse","number":1,"content":[{"text":"Apaa, íwar machip napkuri,","poem":1},{"lineBreak":true},{"text":"¿chakaja nuwaa istachinda? atina.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Itaru, shiysha Apaa, nuwaa istaksha,","poem":1},{"text":"watam shiy kanindaa mishat","poem":2},{"lineBreak":true},{"text":"tsapootstam tinarangshawa, atina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ashiri siysa Apanllchichis, mazinangantsa nuwaa kuki;","poem":1},{"lineBreak":true},{"text":"Yuwash naakish anush Apap siyaa pantsatpa átu, patsisakiya.","poem":1},{"lineBreak":true},{"text":"Siyaa uru ksutkiya. Psaantam, kaschiritam uru ksutkiya.","poem":1},{"text":"Watam Apanll maamaam nda yasaruwa.","poem":2},{"text":"Uru iyaa Israelchicheetsini ksutataw ashku taakiya.","poem":1},{"lineBreak":true},{"text":"Kaschir kizpuritaa zar zatku, ksaneeku nda siyaa kasikiya.","poem":1},{"lineBreak":true},{"text":"Psaansha tsup tuwasineektaa, nda siyaa tayutaritkiya.","poem":1},{"noteId":74}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Apanll Taarasheetsis uru ksutkiya.",{"text":"Yutaritshish tushiyku anootstam tapachindakiya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Shitungachus, Apap uru napkitamta.","poem":1},{"text":"Kanapkachus uru napkitamta.","poem":2},{"lineBreak":true},{"text":"Ashku, siyaa urutamari ksutkiya.","poem":2},{"text":"Ayamtaati kasacheeja, ndambaree, átana nuwaya.","poem":1}]}],"footnotes":[{"noteId":74,"caller":"*","text":"-6 Apanll wanichu anu 7.16 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":121,"verse":3}}]},"thisChapterLink":"/api/cbu_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":5}