{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["Tputs Apanllip pang' Siyonap machip kárkatssin yaseeranganaya. Dapiyarini wayassi."]},{"type":"verse","number":1,"content":[{"text":"Tputs nuwaa, Natu, pzaya. Apanllip pang' naayani, atusin,","poem":1},{"lineBreak":true},{"text":"nuw mangi kis, Ayu, pzaya, tárangina.","poem":1}]},{"type":"verse","number":2,"content":["Yakat Irusarinush pshtukamchuni;",{"text":"Na kuseenicha, mangini kis atiniya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Iyaam Israelchicheemani shaniymaam Irusarinaa panguranganaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sirútama Apanll iyashchee kamachtarangu,","poem":1},{"lineBreak":true},{"text":"Uru shaniykus, nuwaa ungirtangtsa, tárangu,","poem":1},{"lineBreak":true},{"text":"anush iysha Israelchichini ichingaruni shaniyeeruni, Apanllee ungirtakaniya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kurak Dapiyash pang' k'kuzee yaramaam shaniykanaya,","poem":1},{"lineBreak":true},{"text":"tputsee itsinsaru istamaama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ashiri siysa, yuwis nish shaniykis anis,","poem":1},{"lineBreak":true},{"text":"zurampatari mangiptis Apanllee tsiyatkus,","poem":1},{"lineBreak":true},{"text":"Irusarinush uru mapiyshish taachpa.","poem":1},{"lineBreak":true},{"text":"Apaa, shiy tputsirish uru nish kis taachinllinpa, tángcha.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nimun tputs kisshapari tandapunuzish taachiya.","poem":1},{"lineBreak":true},{"text":"Tputs izuurasha mapiyrsin kurakush pang' taachinllinpa.","poem":1},{"lineBreak":true},{"text":"Undarar kasitpa, Apanllee tsiyatkus tángtsa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nuw nimun zuwanlleetsi, misha amikureetsi táchima;","poem":1},{"lineBreak":true},{"text":"Na nimun mangis kisshapari mapiyrus taatssa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pangusimun yaanamuni Apanllirini pang' anumunari mapiyrus taangtsa, atina.","poem":1},{"lineBreak":true},"Anuri chinangtsa, átana."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}