{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["Tputs Apanllip pang' Siyonap machip kárkatssin yaseeranganaya. Dapiyarini wayasi."]},{"type":"verse","number":1,"content":[{"text":"Iyaa Israelchicheetsini Apanll ndunnaari istarangu,","poem":1},{"lineBreak":true},{"text":"iy ndunnaarpariniya. Anoo siy ichingarus yasaksa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apanll iyashchee ndunnaari istarangu,","poem":1},{"lineBreak":true},{"text":"kundararini iyaa tpachingayarinaapsinaya, kasaranganaya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iyaa kapung natsarangusin,","poem":1},{"lineBreak":true},{"text":"izuurinaapari watstamari iyaa ashpaatsiritini kachingaranganaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kung ashirinaapsinaya iyamun kushini zaw sheersin,","poem":1},{"lineBreak":true},{"text":"izuuru iyaa arap kapeetaranganaya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kungushpaz imurish ashiruni iy yangaranginiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ashiri, Apaa, Wappari, atiniya.","poem":1},{"lineBreak":true},{"text":"Watam iyaa ndunnaari istarangush,","poem":1},{"lineBreak":true},{"text":"kundararini izuurinaapari iyaa nutsini tachuwiyarusin,","poem":1},{"lineBreak":true},{"text":"watsiyunpa kasaranganaya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Itaru, shiy iyaa istarangush, xarashee kamungaranganiya.","poem":1},{"lineBreak":true},{"text":"Maachi zamiz mirpanzee izicheeru, kamungtaru ashiruni,","poem":1},{"lineBreak":true},{"text":"iy xarashee kamungaranganiya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apanll Taarashipani, yuw kanindaa tinarangu,","poem":1},{"lineBreak":true},{"text":"mishat tsapootstam tinarangu, an iyaa tapachindarangiya.","poem":1},{"lineBreak":true},{"text":"Ashiri Apanllimunari mangini tatkiniya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":8}