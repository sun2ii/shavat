{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":126,"content":[{"type":"heading","content":["Yuwapur Utaáchich tputs Babiloniyamand káyarusin, mang' ksaksin, Irusarinap kanapurangana, anoo nda mbizamaam apanllpan nee yaseesshee yandarangiya"]},{"type":"hebrew_subtitle","content":["Tputs Apanllip pang' naaksin, machip kárkatssin yaseeranganaya"]},{"type":"verse","number":1,"content":[{"text":"Apanll iyaa; Waptam Irusarinap kanapungints, tárangu,","poem":1},{"lineBreak":true},{"text":"iysha, Pamazookpariniya, táranguni, mangini ksaranginiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mangini kizpur ksaranguni, siriptini kis yasiyastar ashiranganiya.","poem":1},{"lineBreak":true},{"text":"Minshuchtisin tputs iyaa naparangsin;","poem":1},{"lineBreak":true},{"text":"Apanllpari kapung istarangiya, táranganaya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Zurkusin táranganaya.","poem":1},{"lineBreak":true},{"text":"Apanll iyaa kizpur wanasiri istarangu,","poem":1},{"lineBreak":true},{"text":"waana iyaam mangooz ksashish panarangiya.","poem":1},{"lineBreak":true},{"text":"Ashirucha, mangini ksaranginiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Apaa, iyaa tsapuni kizpur wanasir yusur yánischingi,","poem":1},{"lineBreak":true},{"text":"tsapunshi wanasir kxunamaama.","poem":1},{"lineBreak":true},{"text":"Yusur sin sinakchu, ichinguru wanasir kxunchiya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tputs kiyung kachiykusin, tanuktaatssin,","poem":1},{"lineBreak":true},{"text":"mazarish tatsumirangana,","poem":1},{"lineBreak":true},{"text":"anootssha mang' kissha pusachinlliniya.","poem":1},{"lineBreak":true},{"text":"Mang' kis pusayarusin,","poem":1},{"lineBreak":true},{"text":"yasimpatari pangup kanapchinllinaya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}