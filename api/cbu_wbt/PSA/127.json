{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":127,"content":[{"type":"heading","content":["Apanll iyaa ksutku, mapiym panaku anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Tputs Apanllip pang' naatarangsin yaseeranganaya. Salomonarini wayasi."]},{"type":"verse","number":1,"content":[{"text":"Apanll tputsee tarawzupani ndunnaar tuwizpurtaku,","poem":1},{"lineBreak":true},{"text":"tputssha waanpata wizpurini nda pangumaam waritakiya.","poem":1},{"lineBreak":true},{"text":"Apanll yaktaa nda ksutamaam istaku,","poem":1},{"lineBreak":true},{"text":"tsangampansha tputs mangutari ksutkanaya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mishat, Apanll ndunnaar tputsee mzatspani istaku, mangutari kiyung kachiykiya.","poem":1},{"lineBreak":true},{"text":"¿Mayaamsa punirustayarus, Marizpa, átus,","poem":1},{"lineBreak":true},{"text":"zar wazuran tarawaztakus, tapitaranllu kasaksa?","poem":1},{"lineBreak":true},{"text":"Ngutaritis saanaatsee kiyung yachakus ashiksa.","poem":1},{"lineBreak":true},{"text":"Watam Apanll tiptsiree chinaku, ksutku,","poem":1},{"lineBreak":true},{"text":"kanusshisheem wayaranguwa.","poem":1},{"noteId":75}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Apanll tputseem wipaa zapan panaku, an kizpur wanasiricha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kanungas wipaa iparinaku, wipsha kanungaseeyarusin,","poem":1},{"lineBreak":true},{"text":"wásap tamapari ashiru waparee tapazeem tapachindachinllinaya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"An tputs wip zapan taaru, mang' kis mapiyru taachiya.","poem":1},{"lineBreak":true},{"text":"Undararsha yutarit tsiyatku,","poem":1},{"lineBreak":true},{"text":"tputssha wipapat tasaskachu, punicheeja, ndambaree.","poem":1},{"lineBreak":true},{"text":"Kurakaa nda paziku, itsinsaru tsiyatchiya.","poem":1}]}],"footnotes":[{"noteId":75,"caller":"*","text":"Matiwa 6.25-34; Wanga 15.3-5 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":127,"verse":2}}]},"thisChapterLink":"/api/cbu_wbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}