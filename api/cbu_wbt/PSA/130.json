{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":130,"content":[{"type":"heading","content":["Apanllimun mangich tatkuch, piy ashtarchi"]},{"type":"hebrew_subtitle","content":["Tputs Irusarinap naakchusin yaseeranganaya."]},{"type":"verse","number":1,"content":[{"text":"Zurampatari mangipti Apaa, shiyaa kuruzkina.","poem":1},{"lineBreak":true},{"text":"Mangi kapung mantsakina.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apaa, nuwaa kuki mazinangandama.","poem":1},{"lineBreak":true},{"text":"Nayaningandama. Yutaritshishireetsi tchingangandama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Apaa, shiy iyaa yutaritshishirineetsini kirakarishish yandaranginaareesha, nda mbizakush,","poem":1},{"lineBreak":true},{"text":"¿chakaja shiyash pshtuch?","poem":1},{"noteId":76}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Itaru, shiyamaricha yutaritshishirineetsini yaramaam waritaksha.","poem":1},{"lineBreak":true},{"text":"Shiyaatsimari chinakaniya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ashiri Apaa, shiyangzimari mangiptarti kutakina.","poem":1},{"lineBreak":true},{"text":"Apaa, yaranganda, watam shiy, Mangeetsish tachingchinllpa, tárangshawa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ashirucha, nuwsha shiyaam kutakina.","poem":1},{"lineBreak":true},{"text":"Yaktashuch ksutamapan psaan kutaksin, uru tarasitan ashkana,","poem":1},{"lineBreak":true},{"text":"nuwsha ashiritamti shiyaam kutakina, nuw atina.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ashiri siysa Israelchichis, Apanllimun mangis tatkus k'tangtamtsa, nuw tamakparina shingtamtsa.","poem":1},{"lineBreak":true},{"text":"Watam Apanllimari iyaa chinaku, izuuru tapachindakuwa.","poem":1},{"lineBreak":true},{"text":"Ashkachu, izuuru Apanllpatarisha kis taatssa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Iyaa Israelchicheetsini yutaritshishirinee ichinguru yarchiya,",{"noteId":77},"nuw siyaa atina."]}],"footnotes":[{"noteId":76,"caller":"*","text":"Romshucheema 3.23 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":130,"verse":3}},{"noteId":77,"caller":"*","text":"Matiwa 1.21; Titooma 2.14 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":130,"verse":8}}]},"thisChapterLink":"/api/cbu_wbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":8}