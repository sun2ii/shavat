{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":137,"content":[{"type":"heading","content":["Yuwash Israelchich tputs Babiloniyash tsap taarangsin, mang' kapung mantsarangana anoo kamankiya"]},{"type":"verse","number":1,"content":[{"text":"Babiloniyash tsap kungumun wing washunand kuxineeruni,","poem":1},{"lineBreak":true},{"text":"Apanllingaz pang' mach Siyonangaz chinayaruni, tanuranginiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yasinamunsha wapzar kitararineetsini kayxuranguni, kasaranginiya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Babiloniyashuchsha wasundurur,","poem":1},{"lineBreak":true},{"text":"yuw iyaa putayarusin machirangsin, muchchureem ínarangana","poem":1},{"lineBreak":true},{"text":"an iyaatssha: Natu, siy Siyonshuchis, Apanllireetsis yaseengints.","poem":1},{"lineBreak":true},{"text":"Mangis kis yaseengints,","poem":1},"iyaa táranganaya."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Itaru, iysha ¿nitaati nish tputsish watsapun Apanllee kis yasicheezini? Pinasakaniya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Tamaree Irusarinaa mbizachini?","poem":1},{"lineBreak":true},{"text":"Mbizakinaareeniya, shiysha Apaa, iyaa waneengcha.","poem":1},{"lineBreak":true},{"text":"Kuweetsini mbutsunungich mayapshingcha,","poem":1},{"lineBreak":true},{"text":"ayamtaati nda kitartamaama,","poem":1},{"lineBreak":true},{"text":"misha neepureetsini tpatstangtamcha,","poem":1},{"lineBreak":true},{"text":"ayamtaati nda mangini kis yasimaama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Babiloniyashuch wasundurur Irusarinush pshturangusin,","poem":1},{"lineBreak":true},{"text":"misha Edomshuchsha tputs pshturangitamsina.","poem":1},{"lineBreak":true},{"text":"Iyaa natsaksin, Babiloniyashchee;","poem":1},{"lineBreak":true},{"text":"Natu, pangoo ichingaru pátang pátang sheerus, ksangtsa, táranganaya.","poem":1},{"lineBreak":true},{"text":"Ashiri shiysha Apaa, anoo mbizarinllpa.","poem":1},{"lineBreak":true},{"text":"Izuuru Edomshuchee waneengcha, átana.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mishat, siyaa Babiloniyashcheetsis, Apanll izuuru wanichiya.","poem":1},{"lineBreak":true},{"text":"Kundararis siyash kuskatssin, siyaa watstamari kasichinllinaya.","poem":1},{"lineBreak":true},{"text":"¿Siy waninll iyaa kiyung yacharangsawa?","poem":1},{"lineBreak":true},{"text":"Ashiri kundararis siyash kuskachusin,","poem":1},{"lineBreak":true},{"text":"tatsamooru siyaatstam kiyung yachachtamsinaya.","poem":1},{"noteId":78}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ipareetstamtis putayarusin, patumbchimun tpuw tpuw shimbayarusin,","poem":1},{"lineBreak":true},{"text":"pachambeersin kasachinllinaya.","poem":1},{"lineBreak":true},{"text":"Yungpari ashchinllinaya.","poem":1}]}],"footnotes":[{"noteId":78,"caller":"*","text":"Apanll wanichu anu 18.6 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":137,"verse":8}}]},"thisChapterLink":"/api/cbu_wbt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":8}