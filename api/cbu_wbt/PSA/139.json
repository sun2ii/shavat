{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":139,"content":[{"type":"heading","content":["Apap waana tputsee taarash ichinguru yasaku anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Dapiyarini yandarangu anoo."]},{"type":"verse","number":1,"content":[{"text":"Apaa, shiy nuwaa mangi yasaksha.","poem":1},{"lineBreak":true},{"text":"Shiy nuwaa taarashi yasaktamsha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ichinguru ashki anoo yasaktamsha;","poem":1},{"lineBreak":true},{"text":"Ichinguru chinaki anoo yasaktamsha.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuwaa naaki anoo yasaktamsha,","poem":1},{"lineBreak":true},{"text":"Aship ashki anoo paksha, Apaa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ndatumastaa tsiyataruri, nuwaa kuki uru wasina yasaksha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Shiy Apaa, nuwaa ichingaru zar ksutaksha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Tamaru shiy ashiksha, Apaa?","poem":1},{"lineBreak":true},{"text":"Nuw anoo mangoonamaam pinasakina.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Shiyaa kasamaam zandkitaati,","poem":1},{"lineBreak":true},{"text":"itaru ¿yapeeja suwaychi?","poem":1},{"lineBreak":true},{"text":"Yaptaa naaki amb shiy kanish urutari nuwash tachitkiya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Íwar kanindap kárkitaateena, itaru shiysha anshutamtishcha.","poem":1},{"lineBreak":true},{"text":"Tsapush waantsush pshtukitaateena, shiy anshutamtishcha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kambusurush arap naakitaateena,","poem":1},{"lineBreak":true},{"text":"yap zari shitungku amb naakuri, shiy anshutamtishcha.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mus kapungumashee kitkitaateena,","poem":1},{"lineBreak":true},{"text":"yap zar pshtuku amb naakuri,","poem":1},{"lineBreak":true},{"text":"shiysha Apaa, anshutamtishcha.","poem":1},{"lineBreak":true},{"text":"Shiy uru nuwash taaksha.","poem":1},{"lineBreak":true},{"text":"Nuwaa patsisakush, nda kasaksha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tapish ipishungachima, aturi,","poem":1},{"lineBreak":true},{"text":"shiysha, Apaa, nuwaa pakshawa.","poem":1},{"lineBreak":true},{"text":"'Sinee kzateetaateena taakuri,","poem":1},{"lineBreak":true},{"text":"Apaa, shiysha nuwaa paktamsha;","poem":1},{"lineBreak":true},{"text":"Watam shiy nuwaa tuwasineekshawa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Shiy tapshutaa nuwaa pamaam waritaksha.","poem":1},{"lineBreak":true},{"text":"Nuwaa kaschiritam paksha.","poem":1},{"lineBreak":true},{"text":"Shiyaam ichinguru kaschir tamapari ashiriya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Shiy, Apaa, aneershi waxangan nutseemi tínarangsha.","poem":1},{"lineBreak":true},{"text":"Nutseetsi wanasiri tínarangsha.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ashiri, Apaa, nuw wappari atina shiyaatsi.","poem":1},{"lineBreak":true},{"text":"Nuw mangishi chinakuri, ¿Tamaru Apanll ashiranga? aturi, napuxtakina,","poem":1},{"lineBreak":true},{"text":"watam nda mangoonkinawa.","poem":1},{"lineBreak":true},{"text":"Iyaa tputseetsini nutseemani kizpur wanasiri tínaksha.","poem":1},{"lineBreak":true},{"text":"Nuw aneershimasi waxangan taaruri,","poem":1},{"lineBreak":true},{"text":"shiysha Apaa, uru nuwaa yasarangsha.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nuw ndatuma nllurtachuri, waantsshu tapish taaruri,","poem":1},{"lineBreak":true},{"text":"shiysha Apaa, nuwaa taarashi wasina kirakarimunish yandarangsha.","poem":1},{"lineBreak":true},{"text":"Ndatuma minamtiyam zari 'sinee paruri,","poem":1},{"lineBreak":true},{"text":"shiysha nuwaa taarashi ichingaru yasarangsha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"¿Tamaru Apaa, nuwaa chinakush ashiksha?","poem":1},{"lineBreak":true},{"text":"Urutari nuwaa chinachintar ashkush taaksha.","poem":1},{"lineBreak":true},{"text":"Nuw maakuri, taraseekchuri, uru anshutam nuwapat taaksha.","poem":1},{"lineBreak":true},{"text":"Nuwaa ksutaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ashiriya, shiy Apaa, pachampanee tputs nuwaa kasimaam zandkusin,","poem":1},{"lineBreak":true},{"text":"anoo arap zanganingcha. Tpachingangcha.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Shiyaa mantsir tsiyatkitaa,","poem":1},{"lineBreak":true},{"text":"itaru shiyaa kasimaam pinasakanaya,","poem":1},{"lineBreak":true},{"text":"watam shiyamari kasikshawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Shiyaa undararsincha.","poem":1},{"lineBreak":true},{"text":"Shiyaa natsakana anumand nuwsha uwaa natsakuri, niyrkina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ashiri Apaa, nuwaa mangeetsi yasangandama.","poem":1},{"lineBreak":true},{"text":"Yachangandama.","poem":1},{"lineBreak":true},{"text":"Mantsir naakinaareena,","poem":1},{"lineBreak":true},{"text":"shiysha Apaa, nuwaa mangeetsi p'tseengandama.","poem":1},{"lineBreak":true},{"text":"Shiyap izuuru kusamaam nungipiritish machingandama, urutamari taamaama.","poem":1},{"lineBreak":true},"Ashiri Apaa, wapparee, Dapiyarini tárangiya."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":20}