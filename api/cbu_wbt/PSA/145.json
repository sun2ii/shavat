{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":145,"content":[{"type":"heading","content":["Ztaru tputs Apanllee ungirtamaama"]},{"type":"hebrew_subtitle","content":["Dapiyarini wayassi."]},{"type":"verse","number":1,"content":[{"text":"Shiyaa kurakareetseeruri urutamari ungirtakina.","poem":1},{"lineBreak":true},{"text":"Shiyaa chinakina.","poem":1},{"lineBreak":true},{"text":"Ayamtaati shiyaa mbizcheezi.","poem":1},{"lineBreak":true},{"text":"Apaa Taarashipanee, shiyaatsimari ungirtakina.","poem":1},{"lineBreak":true},{"text":"Putam putam shiyaa kis yaseekina.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Taarashipanee, shiyaatsimari tputs ztaru ungirtamaam waritariya.","poem":1},{"lineBreak":true},{"text":"Shiyapat min tatsamooru wanindaja.","poem":1},{"lineBreak":true},{"text":"Shiyaa izuuru yasamaam wanindtamtaja.","poem":1},{"lineBreak":true},{"text":"Shiyamari kasiksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¿Wanipa Apaa, shiy wizpurirpatish iyaa Israelchicheetsini istarangsha?","poem":1},{"lineBreak":true},{"text":"Iyaa tapachindarangsha.","poem":1},{"lineBreak":true},{"text":"Ashiri ipartamani, chinllinitamani uru shiyaa tputsee kamanimantar ashchinllinaya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nuwsha urutamari shiyaa chinachintar ashkuri taachina.","poem":1},{"lineBreak":true},{"text":"Shiy kizpur wanasir 'sinish taaksha.","poem":1},{"lineBreak":true},{"text":"Mishat, iyaa uru ksutkush kizpur taaksha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tputs ztaru shiyaa uru ungirtaksin,","poem":1},{"lineBreak":true},{"text":"waanpataatssin kamanimantar ashchinllinaya.","poem":1},{"lineBreak":true},{"text":"Nuwsha ashchitamana.","poem":1},{"lineBreak":true},{"text":"Apanll ¿wanip wizpurpa iyashchee istaranga? nuwsha uru táchtamana.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mishat, tputssha, Apanll iyaa ksumish chinakiya.","poem":1},{"lineBreak":true},{"text":"Iyaa ichingurootsini tatsamooru ksutkiya,","poem":1},{"lineBreak":true},"yaseeksin táchinllinaya."]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Watam Taarashipanee, shiy kchinamishshawa.","poem":1},{"lineBreak":true},{"text":"Nayanimpantishcha.","poem":1},{"lineBreak":true},{"text":"Nda musá tsiyantakush, uru iyaa nayaniksha.","poem":1},{"noteId":79}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tputsee ichinguru tatsamooru chinaksha.","poem":1},{"lineBreak":true},{"text":"Ichinguroo istaksha.","poem":1},{"lineBreak":true},{"text":"Tínamareetsish ichinguru ksutkush taaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yuw shiy tínarangish an ichinguru shiyamun kis taakanaya.","poem":1},{"text":"Mishat, tputsiritamtish, shiyamun shambatchinllinaya.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Iy kurakarini kizpur wanasircha.","poem":1},{"lineBreak":true},{"text":"Waamari kasiru taakiya, táchinllinaya","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tsapurunasshuchee tputs yasashpatish mangoo p'tseekush, mang' ksachinllinaya.","poem":1},{"text":"¡Apanll wizpurpa wanasir tuwasineerangu, atusin mang' ksachpasinaya!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Shiyamari Apaa, kizpur kurak kasirush,","poem":1},{"lineBreak":true},{"text":"tsapurunasish urutamari taaratartachsha.","poem":1},{"lineBreak":true},{"text":"Shiyachich ayamamtiyam pastacheeja, ndambaree.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tputsirish kiyung kachiykitaatssin,","poem":1},{"lineBreak":true},{"text":"waanaatsee tapachindamaam pinasaku,","poem":1},{"lineBreak":true},{"text":"shiysha Apaa, nayanikush istaksha.","poem":1},{"lineBreak":true},{"text":"Undarar kiyung yachaksin, shiysha Apaa, tapachindaksha.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tsapurunasshuch ichingarusin, katungpani atusin,","poem":1},{"lineBreak":true},{"text":"watungasheem shiyaam kutakanaya.","poem":1},{"lineBreak":true},{"text":"Watam shiy uru panakshawa.","poem":1},{"lineBreak":true},{"text":"Yuwash zari waritakchu, maachi kayanakchu, pusayarusin, katungkanaya.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Watam shiy Apaa, kuwiptish tputseem kchitamaam panakshawa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apaa, uru itsinsaru tputsee natstayarush, ksutaksha.","poem":1},{"lineBreak":true},{"text":"Nayanimpatari tputsee istaksha.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tputs shiyaa itsinsaru mashku, Istanda, tákchu,","poem":1},{"lineBreak":true},{"text":"shiysha uru mazinaksha.","poem":1},{"lineBreak":true},{"text":"Watam nda arap taakshawa.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Shiyamun Apaa, mang' tatkusin,","poem":1},{"lineBreak":true},{"text":"shiysha uru istakush, mapiyrsin taakanaya.","poem":1},{"lineBreak":true},{"text":"Apaa, istangandama; sitatstee.","poem":1},{"lineBreak":true},{"text":"Maachee yutamash kasikchindama, tákchusin,","poem":1},{"lineBreak":true},{"text":"shiysha mazinakchush, tapachindaksha.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Apaa Taarashipanee, yuw tputs mangpatari shiyaa itsinsaru chinakana","poem":1},{"lineBreak":true},{"text":"anoo tputs uru ksutaksha.","poem":1},{"lineBreak":true},{"text":"Itaru, tputs shiyaa chinamaam ngatkusin, natsampan taaksin,","poem":1},{"lineBreak":true},{"text":"anumashee tputs shiysha izuuru tpachingayarush kasaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Apaa Taarashipanee, nuw urutari shiyaa yaseekuri ungirtachima.","poem":1},{"lineBreak":true},{"text":"Tputs ztaru urutamari shiyaa wanasireem ínaksin, ungirtaksin taachinllinpa.","poem":1}]}],"footnotes":[{"noteId":79,"caller":"*","text":"Sandeeku 5.11 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":145,"verse":8}}]},"thisChapterLink":"/api/cbu_wbt/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":20}