{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":148,"content":[{"type":"heading","content":["Maachtawatamtis, tputstamtis, ichingarus yuwis Apanll tinarangu anis, Apanllee yaseengints"]},{"type":"verse","number":1,"content":[{"text":"¡Apanllee yaseengints!","poem":1},{"lineBreak":true},{"text":"¡Ichingarus yuwis íwar taakis anis, kanindamand zunganeengints! Ungirtangints.","poem":2},{"noteId":80}]},{"type":"verse","number":2,"content":[{"text":"¡Siysa Apanllis wasundururis kurakareetsis seengints; ungirtangints!","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Zartamtis, tsupitamtis, Apanllee seengints, ungirtangints!","poem":1},{"lineBreak":true},{"text":"Siy ichingarus yuwis íwar sunlleerutarus kurakurtangatis, tsangachis, irunlltamtis anis,","poem":1},{"lineBreak":true},{"text":"Apanllee ungirtangints. Seengints.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kanindawtamtis kawambanaris kungutamtis","poem":1},{"lineBreak":true},{"text":"yuwis kanindap iwaz taakis anis,","poem":1},{"lineBreak":true},{"text":"¡Apanllee ungirtangints; seengints!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apanllee Taarashipanee ¡Seengints; ungirtangints!","poem":1},{"text":"Watam siyaa amb ashichpa átu,","poem":2},{"text":"kamachtambeeru, íwar waana tinambayaru, mbam wayambaranguwa.","poem":1}]},{"type":"verse","number":6,"content":["Urutamari taachpa, tárangu,",{"text":"¿Waa kuk chakaja michitach tayutaritach?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mishat, ichingarus yuwis tsapurunasis taakis anis","poem":1},{"lineBreak":true},{"text":"¡Apanlleetsi seengints; ungirtangints!","poem":1},{"text":"Marshuchis kapungumashis, yuwis kungush watareewis imurishuw taakis anis,","poem":2},{"text":"Apanllee ungirtangints.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siysa mamartamtis, sin kachizamashtamtis,","poem":1},{"lineBreak":true},{"text":"Sírinuwtamtis,","poem":1},{"lineBreak":true},{"text":"Apanllee ungirtangints.","poem":1},{"lineBreak":true},{"text":"Kambusurutam, yuw Apanll kamachtaku, kukoo tuminkis anuwis,","poem":1},{"lineBreak":true},{"text":"Apanllee ungirtangtsa.","poem":1}]},{"type":"verse","number":9,"content":["Macheew íwaritamtis, manginawtamtis,",{"text":"yasinawis,","poem":2},{"text":"Ichingarus karipanawis,","poem":1},{"text":"yasinawtamtis wanuseewtamtis.","poem":2},{"text":"Apanllee ungirtangints.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wakarawtam, chinuzeewtamtis, manginshuchitamtis, kpurangamasheewis, pshiyrataru anuwtamtis,","poem":1},{"lineBreak":true},{"text":"Apanllee ungirtangints.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mishat, siysa tsapurunastamtis urkaris tiptsirpatatis anis,","poem":1},{"text":"yaktashtam urkaris, misha yaktashucheewis tputsis,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kamuzini, kizawtamtis, kanungaseewtamtis, kamasinawtamtis, wachinawtamtis,","poem":1},{"text":"ichingaru ztaru tsapurunasshuchis,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¡Apanllee Taarashipanee yaseengints; shambatangtsa!","poem":1},{"lineBreak":true},{"text":"¡Uwamari kasiru kanindaatstam, mishat tsapurunaseetstam ksutkiya!","poem":1},{"lineBreak":true},{"text":"Taarashipan nllitarita arang wanindaja.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Iyaa Israelchichini waana tiptsireem ipusarangu,","poem":1},{"lineBreak":true},{"text":"iyaatssha uru tuwizpurtakiya.","poem":1},{"lineBreak":true},{"text":"Ashiri iysha uru Apanllee chinakuni ungirtakuri taachiniya.","poem":1},{"lineBreak":true},"¡Apaa Taarashipani shiy kizpurtishcha!"]}],"footnotes":[{"noteId":80,"caller":"*","text":"Lukasa 2.14 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":148,"verse":1}}]},"thisChapterLink":"/api/cbu_wbt/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":14}