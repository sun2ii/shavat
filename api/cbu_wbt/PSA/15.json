{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":15,"content":[{"type":"heading","content":["Dapiyarini, ¿Chakaja Apanllish pshtumaam waritak? tárangu, anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Dapiyarini wayasi."]},{"type":"verse","number":1,"content":[{"text":"Apaa, ¿chaka shiyash pangish pshtumaam waritak?","poem":1},{"lineBreak":true},{"text":"¿Chak shiyapat Siyonash mach ipunamaam waritak?","poem":1},{"lineBreak":true},{"text":"Yuwamari tputs itsinsaru taaku,","poem":1},{"lineBreak":true},{"text":"minamari tsiyatssee payuku,","poem":1},{"lineBreak":true},{"text":"anumari shiyash pshtumaam waritariya.","poem":1},{"lineBreak":true},{"text":"Tputs ashku anu uru mangpatari itsinsaru tsiyatkiya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tputsee nda yutaritam ínakiya.","poem":1},{"lineBreak":true},{"text":"Wamkuree nda kiyung yachakiya.","poem":1},{"lineBreak":true},{"text":"Waanpatatin nda waratku taakiya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yutaritshishpanee nda kis napku","poem":1},{"lineBreak":true},{"text":"itaru Apanllchicheetssha chinakiya.","poem":1},{"lineBreak":true},{"text":"Uru waanaatsee kuk payukiya,","poem":1},{"lineBreak":true},{"text":"uwaana kiyungutaa kachiyku, itaru ashtaa payukiya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Urkiree tputseem panaku, nda yanusha tuwapanda, atiya.","poem":1},{"lineBreak":true},{"text":"Anuritam tatsamooru tuwapanda, atiya.","poem":1},{"lineBreak":true},{"text":"Tputsee ngichimaam izuuru ngatkiya.","poem":1},{"lineBreak":true},{"text":"Wanasirimshee tputs, Tayutaritamaam kurik panachintspa, atitaatssin anoo ngatkiya.","poem":1},{"lineBreak":true},{"text":"Apaa, tputs shiyaa ashirinaari chinaku, shiyaa kasacheeja, ndambaree.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":4}