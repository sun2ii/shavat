{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":150,"content":[{"type":"heading","content":["Ztaru tsapurunas yasimaam Apanlleetsi shambatangtsa, átcha"]},{"type":"hebrew_subtitle","content":["Dapiyarini wayasi."]},{"type":"verse","number":1,"content":[{"text":"¡Apanllee waanshu pang' shambatkus, seengtsa!","poem":1},{"lineBreak":true},{"text":"¡Yuwash kizpur wanasir kanindush taaku, anush shambatkus seengtsa!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wanip iyaa istaranga, ashiri shambatkus seengtsa.","poem":1},{"text":"Wizpur ayamtaati nda kachingtaru,","poem":2},{"text":"Ashiri ungirtayarus, shambatkus seengtsa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Uru trumpetaa tiruchkus, Apanllee shambatkus seengtsa.","poem":1},{"text":"Uru kis kitarpa kitartakus shambatkus seengtsa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mangis ksakus tamburpat michitkus, shambatkus, seengtsa.","poem":1},{"text":"Tiruchzipta tiruchingtsa, shambatkus seengtsa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ngusambpa tsireen, tsireen átus, zungan zungan shambatkus seengtsa.","poem":1},{"text":"Ngusambpa tushurangayarus arap zunganeerus shambatkus seengtsa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¡Yuwamun kanusis itsiparu, wizpuris anumun xipungayarus,","poem":1},{"lineBreak":true},{"text":"Kizpur yaseengtsa!","poem":1},{"lineBreak":true},"¡Shambatangtsa Apanlleetsi! [Watamcha yuw Israelchich Apanlleem yaseerangana anu.]"]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":6}