{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":16,"content":[{"type":"heading","content":["Dapiyarini waanaatsi tsiyatarangu, itaru Apanlleetssha ipusamarini wasina tsiyatarangitamta, anoo kamankiya."]},{"type":"hebrew_subtitle","content":["Dapiyarini yandamarini."]},{"type":"verse","number":1,"content":[{"text":"Apaa, nuwaa ksutangandama, watam nuw shiyash kamungkina.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apaa, nuw shiyaa kurakartana. Shiy nuwaa uru istaksha.","poem":1},{"lineBreak":true},{"text":"Shiyapa wizpurirish tatsamoorazinllinaja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nishuch tputs zapan apanllputsee ungirtakanaya.","poem":1},{"lineBreak":true},{"text":"Kizpurtanicha, atanaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aranginasha, aranginasha ashkusin, apanllputsee izapaneekchinlliniya.","poem":1},{"lineBreak":true},{"text":"Itaru, nuwsha minamtiyam wakaraa pachayaruri, apanllputsee ungirtacheezee.","poem":1},{"lineBreak":true},{"text":"Apanllputsee sur minamtiyam tsiyatcheezee.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nuw shiyamunari mangi ksakina.","poem":1},{"lineBreak":true},{"text":"Shiy nuwaa uru istaksha.","poem":1},{"lineBreak":true},{"text":"Nuwaa tapachindaksha.","poem":1},{"lineBreak":true},{"text":"Ichinguru zaree nuwaa ksutaksha","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Shiy nuwaam taarashee kizpur wanasiri ipusarangsha.","poem":1},{"lineBreak":true},{"text":"Kapung mangi kisa.","poem":1},{"lineBreak":true},{"text":"Arang taarashish min nuwaam wanindaja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Apaa, nuw shiyaa kapung chinakina.","poem":1},{"lineBreak":true},{"text":"Shiy uru nuwaa machiksha.","poem":1},{"lineBreak":true},{"text":"Psaantam nuwaa mangi p'tseeksha shiyaa itsinsaru tachitamaama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Shiy urutari nuwapa ipunarush taaksha.","poem":1},{"lineBreak":true},{"text":"Uru nuwaa napaksha.","poem":1},{"lineBreak":true},{"text":"Shaana nuwaa mbutsinungich wayaksha.","poem":1},{"lineBreak":true},{"text":"Ashiri ¿Chaka nuwaa kasichinda?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ashirucha, nuw mangi ksakina.","poem":1},{"lineBreak":true},{"text":"Nuw kuki murcha.","poem":1},{"lineBreak":true},{"text":"Nuw mangi punirustacheezi,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"watam nuwaa mapumashta nda pakchiyam kasachshawa.","poem":1},{"lineBreak":true},{"text":"Kani kanizeem kinacheeja.","poem":1},{"lineBreak":true},{"text":"Nuw nutsi kuchacheeja, watam shaana nuwaa ipusamarshawa.","poem":1},{"noteId":7}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Urutamari Apaa, shiyapa kis taachina.","poem":1},{"lineBreak":true},{"text":"Shiyashumari kis shamangkashish taariya.","poem":1},{"lineBreak":true},{"text":"Shiyash taarashish urutamari kizpur wanasir taariya.","poem":1},{"noteId":8}]}],"footnotes":[{"noteId":7,"caller":"*","text":"Yuwaa nish átu anootstam Tayaspatampani 2.27, 13.35 tayusima atitamta.","reference":{"chapter":16,"verse":10}},{"noteId":8,"caller":"*","text":"Yuwaa nish átu anootstam Tayaspatampani 2.25-28 tayusima kamankiya.","reference":{"chapter":16,"verse":11}}]},"thisChapterLink":"/api/cbu_wbt/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}