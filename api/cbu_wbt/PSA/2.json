{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":2,"content":[{"type":"heading","content":["Apanll wipaa tsapurunasshucheem waamari kasimaam wayarangiya, anoo wasina kamankiya."]},{"type":"verse","number":1,"content":[{"text":"¿Mayaamshitaja tputs yashingchich kapung tsiyantaksin zamangakana?","poem":1},{"lineBreak":true},{"text":"Shaniyeeshtisin yuwari zandakana anuri tsiyatkanaya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kurakawtamsin, wipunashpat shaniyeersin, Apanllee mishat Apanlleetstam ipusamarini tayutaritkanaya.","poem":1},{"noteId":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kapung tsiyatkusin, Apanll kuweetsini kateenpapaz ashiru kamurikpaz ashkiya. Na watsta.","poem":1},{"lineBreak":true},{"text":"Iyaanaatsi kateenaa ichipeeruni kapeeteeni, atanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Itaru, Apanllsha waamari kasiru kanindash taaku an,","poem":1},{"lineBreak":true},{"text":"mazinakchu kurakaa kuk stakiya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sheeru, kizpur tsiyantakachu, ¿Mayaamsa nuwaa átssa? átu, kurakshitisin punikanaya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Watam Apanll tsiyatarangu,","poem":1},{"lineBreak":true},{"text":"Nuwaana ipari kurakaa uwamari kasiru taamaam ipuseena.","poem":1},{"lineBreak":true},{"text":"Machi Siyonamand tputsee ztaru ksutku taachiya,","poem":1},{"lineBreak":true},{"text":"Apanll táranguwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Apanlltam ipusamarini Apanlleetstam kuk kamanku, tárangiya:","poem":1},"Apari nuwapat tsiyatku tárangu;",{"text":"Nuw shiyaa ipartana.","poem":1},{"lineBreak":true},{"text":"Nat in shiyaam taarashish kaneesich panayana.","poem":1},{"noteId":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Shiyshat nuwaa mashangandama.","poem":1},{"lineBreak":true},{"text":"Tsapurunasshuchee nuwamari kasiruri taamaam wayangandama, tángcha.","poem":1},{"lineBreak":true},{"text":"Tákchush, nuwshat shiyamari tsapurunasshuchee ichinguru kasimaam wayachinllpa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Shiysha tsapurunasshuchee kurak wizpurirpatish izuuru tpachingachsha.","poem":1},{"noteId":3},{"lineBreak":true},{"text":"Tputs muritsaa yasinpat pátangtaru","poem":1},{"lineBreak":true},{"text":"shiysha, kundarareetsish ambtam ashtachsha.","poem":1},{"lineBreak":true},{"text":"Apari nuwaa tárangiya: Apanll ipusamarini waparee kuk kamanku, tárangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ashiri siysa tsapurunasshuchis kurakis,","poem":1},{"lineBreak":true},{"text":"mangiptis taangtsa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Apanllee chinayarus, mangis kis ungirtangtsa.","poem":1},{"lineBreak":true},{"text":"Apanllee waneesh puniyarus,","poem":1},{"lineBreak":true},{"text":"Nuw shiyaa kurakartana, tángtsa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ashiriya paptsa. Nduniya siy Apanllish tachitkus,","poem":1},{"lineBreak":true},{"text":"Apanll siyaa tsiyantakachu tpachingayantspa.","poem":1},{"lineBreak":true},{"text":"Watam Apanll musásiri tsiyantamaam yasaruwa.","poem":1},{"lineBreak":true},"Itaru, tputs Apanllimun mang' tatkusin, mang' kis taachinllinaya."]}],"footnotes":[{"noteId":1,"caller":"*","text":"Yuwaa nish átu anootstam Tayaspatampani 4.25-26 tayusima kamankiya.","reference":{"chapter":2,"verse":2}},{"noteId":2,"caller":"*","text":"Yuwaa nish átu anootstam Tayaspatampani 13.33; Utaáshucheema 1.5; 5.5 tayusima kamankiya.","reference":{"chapter":2,"verse":7}},{"noteId":3,"caller":"*","text":"Apanll wanichu anu 2.27; 12.5; 19.15 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":2,"verse":9}}]},"thisChapterLink":"/api/cbu_wbt/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}