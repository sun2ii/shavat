{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":22,"content":[{"type":"heading","content":["Dapiyarini wasina Apanll ipusamarini tsipachu anoo kamanirangu, anoo kamankiya."]},{"type":"hebrew_subtitle","content":["Dapiyarini yandarangu, yasimpaneem yaseessheem panarangiya."]},{"type":"verse","number":1,"content":[{"text":"Apaa, Apaa, ¿mayaamsha nuwaa kasaksha?","poem":1},{"noteId":11},{"lineBreak":true},{"text":"¿Mayaamsha shiy nda nuwaa tapachindaksha?","poem":1},{"lineBreak":true},{"text":"Nuw mangi kapung mantsakuri, shiyaa kuruzkina.","poem":1},{"lineBreak":true},{"text":"¿Tamasha shiy nda mazinaksha?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apaa, kaschiritam, Psaantam shiyaa kuruzkina.","poem":1},{"lineBreak":true},{"text":"Itaru, shiysha nda nuwaa mazinaksha.","poem":1},{"lineBreak":true},{"text":"Mapiymaam nuw pinasakina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Itaru Apaa, shiyamari wanasirtishcha.","poem":1},{"lineBreak":true},{"text":"Iy Israelchichini shiyaatsimari ungirtakaniya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iy pachirini shiyaatsimaritam chinaranganiya.","poem":1},{"lineBreak":true},{"text":"Shiyaa kapung chinarangusin, shiysha tapachindarangsha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Shiyaa, Istanda, tárangusin,","poem":1},{"lineBreak":true},{"text":"shiyshat tapachindarangsha.","poem":1},{"lineBreak":true},{"text":"Shiyamun mang' taturangsin, shiysha uwaatsee istamaam nda ngatarangsha.","poem":1},{"lineBreak":true},{"text":"Nda tamapingarangsha. Itsinsaru istarangsha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Itaru, nuwaatssha tputs, ¿Antaati in tputseeja? Nda.","poem":1},{"lineBreak":true},{"text":"Mbich tamatarpachi ashiru kátimaam waritachcha,","poem":1},{"noteId":12},{"text":"nuwaa atusin stakanaya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mantsir tsiyateersin, stakanaya.","poem":1},{"noteId":13},{"lineBreak":true},{"text":"Nuwap napeersin,","poem":1}]},{"type":"verse","number":8,"content":["¿Tamasha in Apanllimuntaa mang' tatku,",{"text":"Apanll uwaa nda tapachindaka?","poem":1},{"lineBreak":true},{"text":"Apanll uwaa chinakinaariya,","poem":1},{"lineBreak":true},{"text":"taarashee tapachindachinaparee,","poem":1},{"noteId":14},{"text":"atanaya nuwaatsi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Itaru, shiysha Apaa, nuwaa aneershi nllurtamaam wayarangsha.","poem":1},{"lineBreak":true},{"text":"Nllurtaranguri, aneereemi ksutamaam wayarangsha.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ndatumastaa nllurtachuri, shiy uru nuwaa ksutarangsha.","poem":1},{"lineBreak":true},{"text":"Urutari nuw shiyaa aparimuna.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ashiri Apaa, shiy nuwaa ksarishpa.","poem":1},{"lineBreak":true},{"text":"Kapung kiyung kachiykuri tsipamaam waritakina.","poem":1},{"lineBreak":true},{"text":"¿Chakaja nuwaa tapachindachinda? aturi,","poem":1},{"lineBreak":true},{"text":"min tputs nuwaa tapachindampan wanindaja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kundarari nuwaa turipingaranaya.","poem":1},{"lineBreak":true},{"text":"Basanshuch wakar upapchir watseenur tamapari ashirusin,","poem":1},{"lineBreak":true},{"text":"nuwaa pachamaam zandkanaya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tumuz manginshuch kázamish tamaparee ashirusin,","poem":1},{"lineBreak":true},{"text":"kuksha kapung xipungayarusin,","poem":1},{"lineBreak":true},{"text":"nuwangaz tsipusamamari zandkanaya.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nuw kung tamapari ashiruri zaw ashkachuri, wizpuriri ndunariritara ashkina.","poem":1},{"lineBreak":true},{"text":"Ichinguru napuri itaximbarangiya.","poem":1},{"lineBreak":true},{"text":"Mangi kungusakpaz ashiru zaw ashkiya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sachisimun kuki mazach ashiru puzaku","poem":1},{"lineBreak":true},{"text":"neepuritamti ptsutkiya.","poem":1},{"lineBreak":true},{"text":"Shiy nuwaa wazawash tsipamaama wayarangsha.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kundarari shaniyeersin,","poem":1},{"lineBreak":true},{"text":"tumuz chinuz watseenur tamapari ashirusin nuwaa turipingaranaya.","poem":1},{"lineBreak":true},{"text":"Nuwaa kuweetsi, k'tseetstamti tshutaranganaya.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ichingaru napuritaati wasuree táchakiya.","poem":1},{"lineBreak":true},{"text":"Kundarari nuwaa natsaksin, napatara, napatara ashkanaya.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nuwaatssha ktuniri, ¿Chakaja yach? atusin,","poem":1},{"lineBreak":true},{"text":"waanpata michitaranganaya.","poem":1},{"lineBreak":true},{"text":"Sheersin, waanpatachtisin ashpatam ashpatam sheersin yaranganiya.","poem":1},{"noteId":15}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Itaru Apaa, shiy nuwaa tuwizpurtaksha.","poem":1},{"lineBreak":true},{"text":"Ashiri nuwaa ksarishpa.","poem":1},{"lineBreak":true},{"text":"Nuwaa mikeerush istanda, Apaa.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tputs pcharundama.","poem":1},{"lineBreak":true},{"text":"Shiyshat nuwaa tsipani tapachindangandama.","poem":1},{"lineBreak":true},{"text":"Nuwaa ksarishpa","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kundarari nuwaa nda pachamaam tapachindangandama.","poem":1},{"lineBreak":true},{"text":"Kundarari tumuz tamapari ashirusin, nuwaa zamaam zandkana.","poem":1},{"lineBreak":true},{"text":"Wakar upapchir tamapari ashirusin, nuwaa witspa pachamaam zandkana.","poem":1},{"lineBreak":true},{"text":"¡Istanda Apaa!","poem":1},{"lineBreak":true},"Shiysha Apaa, nuwaa kuki mazinarangsha."]},{"type":"verse","number":22,"content":[{"text":"Ashiri shiyachich tputs shaniykatssin anush, nuwsha,","poem":1},{"lineBreak":true},{"text":"Zuwanllchee, wanip Apanll nuwaa istaranga, Apanll kizpurcha,","poem":1},{"noteId":16},{"text":"táchima.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ashiri siysa Apanllchichis; Apaa, shiy kizpurtishcha, tángtsa.","poem":1},{"lineBreak":true},{"text":"Ichingarus Israelchichis, Apanlleetsimari ungirtangtsa.","poem":1},{"lineBreak":true},{"text":"Shiyaa ksumish chinakaniya.","poem":1},{"lineBreak":true},{"text":"Shiy kizpurtishcha, tángtsa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tputs kiyung kachiykana anoo Apanll nda niyrkiya.","poem":1},{"lineBreak":true},{"text":"Nda wchumari napkiya, nda waanaatsi pishukiya.","poem":1},{"lineBreak":true},{"text":"Tputs Apanllee; Istanda, tákchu, Apanllshat uru mazinakiya.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ashiri, Apaa, shiy tputsirish shaniykana, anush","poem":1},{"lineBreak":true},{"text":"nuwsha, Apanll nuwaa kasarangeeja.","poem":1},{"lineBreak":true},{"text":"Kiyung kachiyrangtaati, nuwaa tuwizpurtarangiya,","poem":1},{"lineBreak":true},{"text":"táyaruri, ichingaru kamanchima.","poem":1},{"lineBreak":true},{"text":"Sheeruri, k'keetsi tuminamaam wakaraa shiyaam pachayaruri,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"tputs kiyung kachiykana anoo, yambiyaruri,","poem":1},{"lineBreak":true},{"text":"Katungeerus tazazangtsa, táchima.","poem":1},{"lineBreak":true},{"text":"Sheerus Apanllingaz chinakis anis, Apanllee ungirtakus, yaseengtsa.","poem":1},{"lineBreak":true},{"text":"Amb ashkachus, zapan masach siy kis taatssa, táchima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ichingaru minshucheewis tsapurunasis, arapcheewtamtis,","poem":1},{"lineBreak":true},{"text":"Apanllee kuk mazinakchus,","poem":1},{"lineBreak":true},{"text":"mangoonkachus, tutunlltayarus, Apanlleetsimarisha ungirtangtsa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Apanll waatatcha kizpur kuraka.","poem":1},{"lineBreak":true},{"text":"Wamari ichingaru tsapurunasee ksutku taakiya.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Yuwis maacheetsi zapan payukis anis,","poem":1},{"lineBreak":true},{"text":"Apanlleetsimarishat chinayarus ungirtangtsa.","poem":1},{"lineBreak":true},{"text":"Watam siysa uru tsipachtamsawa.","poem":1},{"lineBreak":true},{"text":"Siy saanamuntari wizpuriris urutamari taamaam pinasaksawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Nuwashuch nlluranuri uru Apanlleetsimaritam chinaksin taachinlliniya.","poem":1},{"lineBreak":true},{"text":"Ichingaru zari Apanllee tsiyatkusin taachinlliniya.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Nllursha kaneesich nllurtakachu, anootstam kamaningtsa.","poem":1},{"lineBreak":true},{"text":"Apanll iyashchee tputs kapung tapachindarangu,","poem":1},{"lineBreak":true},{"text":"kamankus tángtsa,","poem":1},{"lineBreak":true},"tárangiya."]}],"footnotes":[{"noteId":11,"caller":"*","text":"Yuwaa nish átu anootstam Matiwa 27.46; misha Márkosa 15.34 tayusima kamankiya.","reference":{"chapter":22,"verse":1}},{"noteId":12,"caller":"*","text":"Wanga 19.5 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":22,"verse":6}},{"noteId":13,"caller":"*","text":"Matiwa 27.39; Márkosa 15.29; Lukasa 23.35 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":22,"verse":7}},{"noteId":14,"caller":"*","text":"Yuwaa nish átu anootstam Matiwa 27.43 tayusima kamankiya.","reference":{"chapter":22,"verse":8}},{"noteId":15,"caller":"*","text":"Matiwa 27.35; Márkosa 15.24; Lukasa 23.34 tsiyatsis nipta tatsamooru taaritamta; yuwaa nish átu anootstam Wanga 19.24 tayusima kamankiya.","reference":{"chapter":22,"verse":18}},{"noteId":16,"caller":"*","text":"Yuwaa nish átu anootstam Utaáshucheema 2.12 tayusima kamankiya.","reference":{"chapter":22,"verse":22}}]},"thisChapterLink":"/api/cbu_wbt/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":31}