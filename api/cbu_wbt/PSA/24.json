{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":24,"content":[{"type":"heading","content":["Tputs Apanllee itsinsaru chinamaam kamankiya. Mishat, Apanll waamari kasiru kuschu anootstam kamankitamta"]},{"type":"hebrew_subtitle","content":["Dapiyarini wayasi."]},{"type":"verse","number":1,"content":["Apanll ichingaru tsapurunasee ztaru kasiru taakiya.",{"text":"Tputseetstam, maacheetstam kasiru taakiya.","poem":1},{"noteId":20}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Watam Apanll waana tsapurunasee tinarangu,","poem":1},{"lineBreak":true},{"text":"kungumun iwaz tsapoo mbamari wayarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¿Chakaja Apanllip machirini kárimaam waritak?","poem":1},{"lineBreak":true},{"text":"¿Chakaja Apanllish pang' pshtumaam waritach?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yuw tputs yutaritshishirini tachingama,","poem":1},{"lineBreak":true},{"text":"nda yutaritshishee chinaku,","poem":1},{"noteId":21},{"lineBreak":true},{"text":"nda apanllputsee ungirtaku,","poem":1},{"lineBreak":true},{"text":"nda ngicheeru tputsee tayutaritku, anumari pshtumaam waritakiya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tputs zurampatari Apanllingaz chinaku anoo","poem":1},{"lineBreak":true},{"text":"Apanllshat tapachindachiya.","poem":1},{"lineBreak":true},{"text":"Kistam napku, Shiy yutaritshishish nduncha, táchiya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tputs Akoparini Apanllingaz tamarangparee chinaku","poem":1},{"lineBreak":true},{"text":"Apanllingaz wizpur támaraku izuuru Apanllish pang' pshtumaam waritariya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Irusarin pstushini wach urutamash izuuru tawatangcha.","poem":2},{"lineBreak":true},{"text":"Urutamari tawatam taachpa.","poem":2},{"lineBreak":true},{"text":"Kurak yuw wamari kasiru anu, wasundururpat pshtumaam naanllpa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¿Chakshita kurak wamari kasiru anu?","poem":1},{"lineBreak":true},{"text":"An Apanll Taarashipancha. Uw kizpurcha.","poem":1},{"lineBreak":true},{"text":"Nda sambaytaku waamari kasiyanlliya.","poem":1},{"lineBreak":true},{"text":"Apanlliritcha, yuw undararee waamari kasirangu ancha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ashiri Irusarinaa pshtushini wach tawatangcha.","poem":2},{"lineBreak":true},{"text":"Urutari tawatam taachpa,","poem":2},{"lineBreak":true},{"text":"Watam Kurak wamari kasirangu anu pshtumaam naanllpa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¿Tamamshita kurak kizpur kasirangu anu?","poem":1},{"lineBreak":true},{"text":"watacha Apanll Taarashipani, waamari ichingaru kasiru anu.","poem":1},{"lineBreak":true},{"text":"Ichingaru tsapurunasee kanindaatstam waamari kasiru taakiya.","poem":1}]}],"footnotes":[{"noteId":20,"caller":"*","text":"Yuwaa nish átu anootstam 1 Koríndshucheema 10.26 tayusima kamankiya.","reference":{"chapter":24,"verse":1}},{"noteId":21,"caller":"*","text":"Matiwa 5.8 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":24,"verse":4}}]},"thisChapterLink":"/api/cbu_wbt/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}