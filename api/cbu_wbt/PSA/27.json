{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":27,"content":[{"type":"heading","content":["Apanll mangeetsi tuwasineeku mishat taarasheetsi tapachindakiya"]},{"type":"hebrew_subtitle","content":["Dapiyarini wayasi."]},{"type":"verse","number":1,"content":[{"text":"Apanll nuwaa mangeetsi tuwasineeku,","poem":1},{"lineBreak":true},{"text":"nuwaa taarashi tapachindakiya.","poem":1},{"lineBreak":true},{"text":"¿Ashiri nuw mayaatsee punichi?","poem":1},{"lineBreak":true},{"text":"Watam Apanll urutamari nuwaa ksutkuwa.","poem":1},{"lineBreak":true},{"text":"¿Ashirucha nda puniki?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kundarari, yutaritshishpan, nuwaa pachamaam zandkitaateesinaya,","poem":1},{"lineBreak":true},{"text":"Itaru xapoochinlliniya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuwaa sundartaa kayangayarusin,","poem":1},{"lineBreak":true},{"text":"Nuwsha punicheezi.","poem":1},{"lineBreak":true},{"text":"Nuwaa, Pachayani, atitaatssin,","poem":1},{"lineBreak":true},{"text":"Nuw Apanllimunari mangi tatkuri taachina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Apaa, yuw kizpur chinaki anootsimari mashchinllpa,","poem":1},{"lineBreak":true},{"text":"Ichingaru zar pangishish pshtukuri,","poem":1},{"lineBreak":true},{"text":"shiyaatsimari uru ungirtakuri taapi atina.","poem":1},{"lineBreak":true},{"text":"Watam shiy kizpur wanasirshawa,","poem":1},{"lineBreak":true},{"text":"anungazimari zandkina.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ashiri, Apaa, yutaritshish nuwash kuskachu,","poem":1},{"lineBreak":true},{"text":"shiysha nuwaa shaanshu pangish wayakchush,","poem":1},{"lineBreak":true},{"text":"nuwsha anush kamungchina.","poem":1},{"lineBreak":true},{"text":"Ashkachush nuwaa tapachindachsha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Shiyamun wizpurirish kundarareetsi kasichina.","poem":1},{"lineBreak":true},{"text":"Ashiri shiyaatssha, Wapparee, aturi,","poem":1},{"lineBreak":true},{"text":"chinuzee pachayaruri muchchina.","poem":1},{"lineBreak":true},{"text":"Mucheeruri, kapung mangi ksakuri, yaseessheetssha yasichina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Apaa, shiyaa kuruzki anoo mazinangandama.","poem":1},{"lineBreak":true},{"text":"Shiysha nuwaa nayanikush, kamaninganda.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nuw Apanlli mashkuri mangishi; Apaa, nuwaa istanda, atina.","poem":1},{"lineBreak":true},{"text":"Ashirucha nuwsha Apaa, shiyaa, Istanda, áti.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apaa, shiysha nuwaa tpishishpa.","poem":1},{"lineBreak":true},{"text":"Tsiyantayarush, nuwaa niyrishpa.","poem":1},{"lineBreak":true},{"text":"Watam shiyamari nuwaa istakush taakshawa.","poem":1},{"lineBreak":true},{"text":"Ashiri nuwaa ksarishpa. Istangandama.","poem":1},{"lineBreak":true},{"text":"Tputs nllitari nuwaa istamaam wanindaja.","poem":1},{"lineBreak":true},{"text":"Shiyamari nuwaa tapachindakush taaksha, Apaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wandtaati apari, aneertamti nda nuwaa ksutkusin,","poem":1},{"lineBreak":true},{"text":"itaru shiysha Apaa, urutari nuwaam ksutamapaniri taaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mishat, Apaa, nda kundarari nuwaa tayutaritamaam,","poem":1},{"lineBreak":true},{"text":"shiysha nungipish machinda.","poem":1},{"lineBreak":true},{"text":"Itsinsaru shiyashumari tachitpi túri, atina.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yutaritshishpan tputs nuwaa ksirundama.","poem":1},{"lineBreak":true},{"text":"Ksarishpa.","poem":1},{"lineBreak":true},{"text":"Watam nuwaa kapung natsakanawa.","poem":1},{"lineBreak":true},{"text":"Nuwaa mangu ngicheersin, mantsir tsiyatkanaya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Itaru, Apaa, nuw shiyaa yasaktana.","poem":1},{"lineBreak":true},{"text":"shiy nuwaa chinakush, urutamari istakush taaksha;","poem":1},{"lineBreak":true},{"text":"Ayamtaati kasacheezish, ndambaree.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ashiri siysa Apanllchichis, Apanllimun mangis tatungtsa.","poem":1},{"lineBreak":true},{"text":"Kizpur taangtsa. Sambaytarintspa,","poem":1},"Izuuru Apanllimun mangis tatungtsa, atina."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":14}