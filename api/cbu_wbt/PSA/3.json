{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Dapiyarini, Ipari Absalon pcharundama, átu, suwayaru, Apanlleetssha; Istanda, tárangu anoo kamankiya"]},{"type":"verse","number":1,"content":[{"text":"Apaa, Nuw kundarari zapancha.","poem":1},{"text":"Tputs zapan nuwaa kasimaam zandkanaya.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waanpatatin tsiyatkusin, ¿Apanll Dapiyaa tamaree","poem":1},{"lineBreak":true},{"text":"istach? Istacheeja ndambaree, atanaya nuwaatsi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Itaru shiysha Apaa, nuwaa kámanakush ksutakshawa.","poem":1},{"text":"Nuwaa kasimaam istaksha,","poem":2},{"lineBreak":true},{"text":"Uru mangeetsi tuwizpurtaksha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nuw shiyaa kuruzkuri, Apaa, istanda, tákchuri,","poem":1},{"text":"Shiyshat Apaa, pangishish, Siyonash mach,","poem":2},{"text":"nuwaa kuki mazinaksha.","poem":1},{"lineBreak":true},{"text":"Nuwaa istaksha.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ashirucha nuwshat nda punikuri, mapiyruri maaranguri,","poem":1},{"lineBreak":true},{"text":"yusur chiyzayanll ashkina.","poem":1},{"text":"Watam shiysha, Apaa, nuwaa ksutakshawa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kundarari zapantaa nuwaam pachamaam kuseersin,","poem":1},{"text":"turipingaktaatsin, nuwsha nda punikina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Apaa, istanda! ¡Nuwaa tapachindangandama!","poem":1},{"lineBreak":true},{"text":"watam shiyamun mangi tatkinawa.","poem":1},{"text":"Kundarareesti tpazangcha.","poem":2},{"lineBreak":true},{"text":"Tputsee nda arang pachamaam waneeyarush ksangcha.","poem":2},{"text":"Tumuzee wanas kurumbatarich sheerush ksangcha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Apaa, shiyamari tapachindampanish taaksha.","poem":1},{"text":"Ashiri, tputsireetsish istangcha. Ksutangcha, Apaa.","poem":2},{"lineBreak":true},"Dapiyarini Apanllee, Istangandama, átu, tárangiya"]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}