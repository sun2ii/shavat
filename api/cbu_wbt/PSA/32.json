{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":32,"content":[{"type":"heading","content":["Tputs Apanllpat mang' yaramaw taaku, itsinsaru Apanllee tachitku anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Dapiyarini yandamarini."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Apanll tputsee yutaritshishirini tachingeeru, izuuru mbizakchu,","poem":1},{"lineBreak":true},{"text":"tputssha mapiyshaparee taachiya.","poem":1},{"lineBreak":true},{"text":"Tputs yutaritshishirineetsi Apanllee kamanku, nda kamapshiku,","poem":1},{"lineBreak":true},{"text":"Apanllsha izuuru tachingeeru, ndusha yusur anoo chinachiya.","poem":1},{"noteId":22}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nuw ndatuma mangeetsi yarchuri, kis taamaam pinasarangina.","poem":1},{"lineBreak":true},{"text":"Putam putam ashiranguri mangi mantsaranguri,","poem":1},{"lineBreak":true},{"text":"nuw wizpuriri ndunareerangiya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Watam shiysha Apaa, nuwaa waneerangshawa.","poem":1},{"lineBreak":true},{"text":"Psaantam, kaschiritam kis taamaam pinasarangina.","poem":1},{"lineBreak":true},{"text":"Chap zarish mawirtaru ashiru, taarashi taarangina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sheeruri, shiyaa Apaa, yutaritshishireetsi ichinguru kamanirangina.","poem":1},{"lineBreak":true},{"text":"Nda minamtiyam kamapshirangina.","poem":1},{"lineBreak":true},{"text":"Ashiranguri, shiysha Apaa, nuwaa mangeetsi tachingarangsha.","poem":1},{"lineBreak":true},{"text":"Izuuru mbizamamari yutaritshishireetsi kapeetarangsha.","poem":1},{"noteId":23}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ashiri na, Apaa, shiyshacha iyaa tputsirish","poem":1},{"lineBreak":true},{"text":"yutari tushiykchitaa, iyshat uru shiyaa mashkiniya.","poem":1},{"lineBreak":true},{"text":"Ashkachuni yutaritshish taaktaa, itaru iyaa nda kasichiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Apaa, shiyashumari kamungamaam waritakina.","poem":1},{"lineBreak":true},{"text":"Taarasheetstamti shiy nuwaa kámanaksha.","poem":1},{"lineBreak":true},{"text":"Ashirucha Apaa, mangi kis shambatkuri kapung yaseekina.","poem":1},{"lineBreak":true},{"text":"Watam shiy yutaritshishireetsi tachingarangshawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mishat, Apaa, shiysha nuwaa ateezish.","poem":1},{"lineBreak":true},{"text":"Nuw shiyaa uru napkina. Mangeetsish p'tseekina,","poem":1},{"text":"nuwash itsinsaru tachitamaama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nuwash tachitkush, kapaach, mishat burr","poem":1},{"text":"mang' tamapari ashirush nuwash tchitinllpa.","poem":2},{"text":"Watam kapaach, mishat burrutam tputsush tachitamaam uru ngatkanawa.","poem":1},{"lineBreak":true},{"text":"Tputssha putayarusin, sukpat tusiseersin,","poem":1},{"text":"pshiyrkatssin, annaa naaksin tachitkanaya.","poem":2},{"text":"Itaru, shiysha an tamaparee ashirush shirinllpa.","poem":1},{"lineBreak":true},{"text":"Nuwash itsinsarush tchitangcha, átsha Apaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tputs yutaritshishpan uru kiyung kachiykanaya.","poem":1},{"lineBreak":true},{"text":"Itaru, tputs shiyamun mang' tatkana anootssha","poem":1},{"lineBreak":true},{"text":"shiy ksumish chinakush, uru ksutaksha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ashiri siy Apanllchichis, Apanllimun mangis kis taangtsa, átana.","poem":1},{"lineBreak":true},{"text":"Uru mangis kis Apanllimun shambatangtsa, nuw siyaa atashina.","poem":1},{"lineBreak":true},"Ashiri na wapparee nuw kuki tawatspayana."]}],"footnotes":[{"noteId":22,"caller":"*","text":"-2 Yuwaa nish átu anootstam Romshucheema 4.6-8 tayusima kamankiya.","reference":{"chapter":32,"verse":1}},{"noteId":23,"caller":"*","text":"1 Wanga 1.9 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":32,"verse":5}}]},"thisChapterLink":"/api/cbu_wbt/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":10}