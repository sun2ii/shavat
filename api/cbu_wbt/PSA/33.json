{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":33,"content":[{"type":"heading","content":["Yuwaa Apanll waana zandku anoo izuuru tatsamkiya. Ashiri mangis kis Apanllee ungirtakus seengtsa"]},{"type":"verse","number":1,"content":["Siy Apanllis tiptsiris Apanlleetsimari ungirtangtsa. Ancha Apanlleem kizpur wanasiriya."]},{"type":"verse","number":2,"content":[{"text":"Ashiri yaseeyarus, Wappari Apaa, tángtsa.","poem":1},{"lineBreak":true},{"text":"Arpapat, misha kitarpat ashirus,","poem":1},{"lineBreak":true},{"text":"mangis kis yaseengtsa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yaseeshish kaneeschee seengtsa.","poem":1},{"noteId":24},{"lineBreak":true},{"text":"Tputs kitartamaam yasaru, anpat ipuneerus, mangis kis seengtsa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Apanll yuw ichingaru tsiyatarangu an zurampatari tárangiya.","poem":1},{"lineBreak":true},{"text":"Iyaa chinaku, ¿wanip iyaa istaranga?","poem":1},{"lineBreak":true},{"text":"Uru wamunari mangich tatumaam taariya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apanll ngitzipanee natsakiya. Wanasirimsheetsimari tputs chinakiya.","poem":1},{"lineBreak":true},{"text":"Tputsee ztaru chinakiya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ichtakachuri Apanll tsiyateeru, kanindaa tinarangiya.","poem":1},{"lineBreak":true},{"text":"Sheeru, Kanindush zar, tsup, tsangach ashiru taachpa, tárangu, ichingaru tinarangiya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ichinguru kungunandari taarangu,","poem":1},{"lineBreak":true},{"text":"anoo Apanll, Kungoo waanitam wayachima, tárangu,","poem":1},{"lineBreak":true},{"text":"maree kapungumashee wayarangiya.","poem":1},{"noteId":25}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ashirucha, nuw siyaa tsapurunasshucheetsis, Apanlleetsimari chinangtsa, atina.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Watam waana tsiyateeru, maacheetsi ichingaru tinaranguwa.","poem":1},{"lineBreak":true},{"text":"Mishat, ichingaru urutamari taamaam wayarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tsapurunasshuch kurak uru yutarit chinaksin, waana zandkana anumari ashimaam chinakanaya.","poem":1},{"lineBreak":true},{"text":"Zandkitaatssin itaru Apanllsha xarashish wayat, wayat ashku, xapookanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Itaru, Apanllinaa waana yuwaa, Ashchima, tákchu anoo,","poem":1},{"lineBreak":true},{"text":"zurampatari tatsamkiya.","poem":1},{"lineBreak":true},{"text":"Tputs ayamtaatiya Apanllee tuxaramaam pinasachinlliniya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Itaru, Apanll waana iyashchee, Israelchicheetsini tiptsireem ipusarangiya.","poem":1},{"lineBreak":true},{"text":"Iysha Apanll Taarashipani kapung chinakaniya.","poem":1},{"lineBreak":true},{"text":"Ashirucha, kis mapiyruni taakaniya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Apanll kanindash taaku, anumandari napku,","poem":1},{"lineBreak":true},{"text":"ashpaatsiri tputs ztaru tsapurunasush pakiya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Yuwaa tputs mangush chinakana anoo yasakiya.","poem":1},{"lineBreak":true},{"text":"Watam waana mangeetsich tinaranguwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kurak wasundurur zapantaa taaru,","poem":1},{"lineBreak":true},{"text":"itaru, undarar, Kurakaa pachapani, atusin,","poem":1},"Apanll nda istaku wasundurur urkareetsi tapachindamaam pinasakanaya.",{"text":"Kizpuritaa kurak waanaatsi tapachindamaam pinasakiya.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mishat, kapaach tapazpan kizpuritaati, sundaroo tapachindamaam wanindaja;","poem":1},"Apanllimari tputsee tapachindamaam taariya."]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Itaru, Apanllchich tputs, Apanllimun mang' tatkusin,","poem":1},{"lineBreak":true},{"text":"Apanll iyaa ksumish chinakiya, atusin,","poem":1},{"lineBreak":true},{"text":"Apanllsha urutari waatssin napku ksutkiya.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tsipamaam waritaktaa, Apanll tapachindakiya.","poem":1},{"lineBreak":true},{"text":"Katungats maringaktaa, Apanll istaku, nda tsipachinlliniya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ashiriya, iysha Apanllimun mangini tatkuni,","poem":1},{"lineBreak":true},{"text":"Apanllsha iyaa izuuru ksutkiya; nda kasakiya.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Apanllimunari mangini ksakaniya, watam zurampatari Apanllee mangiptini chinakaniwa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Apanll, urutamari iyaa chinaku,","poem":1},{"lineBreak":true},{"text":"iyapat ipunakcha.","poem":1},{"lineBreak":true},{"text":"Watam Apanllimunari mangini tatkiniwa, atiniya.","poem":1}]}],"footnotes":[{"noteId":24,"caller":"*","text":"Apanll wanichu anu 5.9; 14.3 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":33,"verse":3}},{"noteId":25,"caller":"*","text":"Wanga 1.3 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":33,"verse":7}}]},"thisChapterLink":"/api/cbu_wbt/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":21}