{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":37,"content":[{"type":"heading","content":["Apanllimun mangis tatungtsa"]},{"type":"hebrew_subtitle","content":["Dapiyarini wayasi."]},{"type":"verse","number":1,"content":[{"text":"Tputsimand yutaritshishirini musá tsiyantarinllpa.","poem":1},{"lineBreak":true},{"text":"Tputs yutarit taakana anoo, siysa pakus, Ambtam ashpi átus, támararintspa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Watam yutaritshishpan mikeeru pchirukpaz ashkuwa.","poem":1},{"lineBreak":true},{"text":"Karut tamatarparee ashiru mikeeru mawirukiya.","poem":1},{"noteId":30}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ashiriya, tsapurunasush taakus,","poem":1},{"lineBreak":true},{"text":"Apanllimunari mangis tatungtsa; izuururu yutaritshishee mapiyngtsa.","poem":1},{"lineBreak":true},{"text":"Saanaatsi taarashis wanasir ksutangtsa; wanasir taangtsa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apanllimunari mangis tatkus,","poem":1},{"lineBreak":true},{"text":"Yuwaa saana chinakus ashchima, átis anoo Apanllsha uru istachiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ashiriya, Apanll waana uwpa putayaru,","poem":1},{"lineBreak":true},{"text":"wanasiripimari siyaa machchiya.","poem":1},{"lineBreak":true},{"text":"Ashiri Apanllimunamari mangis tatungtsa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ashkachus, izuuru wanasiriri taakus,","poem":1},{"lineBreak":true},{"text":"zar wachamureetskachu, tuwasintaru ashikpaz ashitssa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ashiri mangiptartis wanasir taakus,","poem":1},{"lineBreak":true},{"text":"izuurus Apanlleem k'tangtsa.","poem":1},{"lineBreak":true},{"text":"Watam Apanll siyaa istachuwa.","poem":1},{"lineBreak":true},{"text":"Ashkus, tputs siyaa tayutaritkitaa, anoo ksatarintspa. Waani taachpa. Watam yutarit chinaksin, atanawa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ashiri tsiyanis zambazangtsa. Arangeem tsiyantarintspa.","poem":1},{"lineBreak":true},{"text":"Mishat, tsiyanpatis taarintspa.","poem":1},{"lineBreak":true},{"text":"Watam ashkachus, aranginasha saanaatsi tayutaritatssawa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apanll yutaritshishpanee tputs kapeetchiya.","poem":1},{"lineBreak":true},{"text":"Itaru, yuwsha tputs Apanllimunari mang' tatku, an urutamari taachiya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nimun ayamtaatiya yutaritshishpanee pangcheezich.","poem":1},{"lineBreak":true},{"text":"Kapungtaa nachungakuch, nda pangachchee. Izuuru pastachiya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Itaru, yuw tputs Apanllee chinakana, an tsapurunasish wipapat, wachinllinuptatam,","poem":1},{"lineBreak":true},{"text":"wanasirimshinandari taachinlliniya.","poem":1},{"noteId":31}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yutaritshishpan tputs Apanllchichee kiyung yachamaam chinakanaya.","poem":1},{"lineBreak":true},{"text":"Natsaksin, kiyung yachamaam zandkanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Itaru, Apanllsha yutaritshishpanee; Waani ashtap, atiya,","poem":1},{"lineBreak":true},{"text":"watam yuwash zari waritakchu, izuuru wanichuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ashiriya, yutaritshishpan tputs wáchiruree yáyarusin,","poem":1},{"lineBreak":true},{"text":"Apanllchichee tputs tupantsakanaya.","poem":1},{"lineBreak":true},{"text":"Timbanllizeetssha itintangayarusin, tsak ashchinlliniya.","poem":1},{"lineBreak":true},{"text":"Ashkusin, Apanllchichee tputs pachamaam zandchinllinaya.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Itaru, Apanllsha waanpatatam wáchirur waanaatstatam pachachiya.","poem":1},{"lineBreak":true},{"text":"Timbanllzirineetsi izuuru ichipambayaru kasachiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Apanllchich maacheetsi pakchitaa payuksin, itaru Apanllimunsha kis taakanaya.","poem":1},{"lineBreak":true},{"text":"Yashingchichsha maacheetsi zapan payuktaa, kis taamaam wanindaja.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apanllsha yutaritshishpanee izuuru kapeetchiya.","poem":1},{"lineBreak":true},{"text":"Itaru, wanasirimsheetsinaa tputs zurampatari tapachindachiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Apanll tputsee wanasirimshi ksutkiya.","poem":1},{"lineBreak":true},{"text":"Taársheetstam tachingkiya.","poem":1},{"lineBreak":true},{"text":"An tputs Apanllush urutari taachinlliniya.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ashiri yuwash yuwariz maringakchu anush","poem":1},{"lineBreak":true},{"text":"Apanllchichinaa tputs marizimun nda kiyung kachiychinlliniya.","poem":1},{"lineBreak":true},{"text":"Watungasheem nda pshatachiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yashingchich tputs izuuru kurayaru, muchinlliniya.","poem":1},{"lineBreak":true},{"text":"Karutaa puza tirookuch, kurataru ashiru kurachiya.","poem":1},{"lineBreak":true},{"text":"Amb ashkachu, Apanll undarar izuuru pastachiya.","poem":1},{"lineBreak":true},{"text":"Msas ashiru mzeetaru tsípatara ashchinllinaya.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tputs yashingchich maacheetsi yáyaritaatssin, itaru nda tuwanpukanaya.","poem":1},{"lineBreak":true},{"text":"Itaru, Apanllchichsha maacheetsi yaksin, aranginasha tuwanpukanaya.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yuwaa Apanll tputsee kis napku, anoo tputs watsapun wanasir ksutkiya.","poem":1},{"lineBreak":true},{"text":"Itaru, yuwaatssha nda kis napku, anoo watstamari kapeetchiya. Nda istachiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ashiri tputs Apanllee chinaku, Apanllee kuk payuku, anoo Apanll machkiya.","poem":1},{"lineBreak":true},{"text":"Wanungish wanasirimshish machkiya.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yashing xarashshee wayaktaa, nda izuuru pantsakiya.","poem":1},{"lineBreak":true},{"text":"Watam Apanllsha uwpat putayaru, tuxiyzakuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Nuw kanungasimasi taaranguri, itaru natsha wachinayanllina.","poem":1},{"lineBreak":true},{"text":"Apanllee tiptsir uru yasakuri,","poem":1},{"lineBreak":true},{"text":"Apanllsha waanaatsi tiptsir nda minamtiyam kasarangiya.","poem":1},{"lineBreak":true},{"text":"Tiptsireemsha pishtats ndunimuna; tputsish pangaa nda mashtaranaya.","poem":1},{"lineBreak":true},{"text":"Wipaamtamsha katungats nduntam pishtarangiya.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ashiriya, tputs Apanllee chinaksin, nayanimpatari taaksin,","poem":1},{"lineBreak":true},{"text":"tputseem mangutari maachiritaa istakiya.","poem":1},{"lineBreak":true},{"text":"Ashirucha, wipshtisin ashiritam tputseem mangutaritam istakitamanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Ashiri yutaritshishee mapiyngtsa.","poem":1},{"lineBreak":true},{"text":"Saanaatsi wanasir ksutangtsa.","poem":1},{"lineBreak":true},{"text":"Ashkus, waanasirimshee pangatssa.","poem":1},{"lineBreak":true},{"text":"Yap tsap taakamchis anush uru kis taatssa.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Apanll tputsee tsiyatssee yaramapani chinakiya.","poem":1},{"lineBreak":true},{"text":"Waanaatsee tiptsir nda ayamtaati kasachiya.","poem":1},{"lineBreak":true},{"text":"Itaru, yutaritshishpanee izureeru waneeyaru, kasachiya.","poem":1},{"lineBreak":true},{"text":"Nlluranur izuuru pastachiya.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Itaru, Apanllinaa tiptsir urutamari tsapurunasush kis taachinllinaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ashiri tputs wanasirimish uru mangpatari wanasiri tputsee tsiyatkanaya.","poem":1},{"lineBreak":true},{"text":"Tsiyatssee wanasirimsheetsimari yarkanaya.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Apanllee kuk izuuru chinaksin, nda pantsakanaya. Uru tachitkanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Tputs yutaritshishpan Apanllee tiptsir natsaku, pachapi, átu pachamaam tsangakiya.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Itaru, Apanllsha tiptsiree nda kasakiya.","poem":1},{"lineBreak":true},{"text":"Tputs kurakap tputsee wanasirimshee tupantsamaam tsiyatkitaateesinaya,","poem":1},{"lineBreak":true},{"text":"Apanll waana tapachindachiya. Kurak tputsireetsi tayutarittapa, átu ashkiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ashiri siysa Apanllee chinangtsa. Kukoo tuminungtsa.","poem":1},{"lineBreak":true},{"text":"Ashkachus, tputssha siyamun mang' tatchinlliniya,","poem":1},{"lineBreak":true},{"text":"Ashiri Apanll siyaamanaa tsapuneemis ksutamaam panachiya.","poem":1},{"lineBreak":true},{"text":"Itaru, yutaritshishpani waneekchu, anoo siysa kchiptartis pangatssa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Nuw tputsee yutaritshishpanee parangina.","poem":1},{"lineBreak":true},{"text":"Nuw kizpurtana. Nuwamari kasirina, tárangiya.","poem":1},{"lineBreak":true},{"text":"Yasin tamatarpari ashiru natumasamaam pzeena, pzeena sheeru, támungayaru,","poem":1},{"lineBreak":true},{"text":"wanasir wayanaptaru ashiru taarangiya.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Amb ashirangtaa, itaru musásiri izuuru tsiparangu,","poem":1},{"lineBreak":true},{"text":"nuwsha nachungaranguri, nda ayamtiyam parangina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Mazinangtsa. Tputs wanasirimish Apanllee kuk payuksin,","poem":1},{"lineBreak":true},{"text":"urutari Apanllish pang' mang' ksaw wanasir taachinlliniya.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Itaru, Apanllsha yutaritshishpaneetssha tputs ashpaatsiri tpachingachiya.","poem":1},{"lineBreak":true},{"text":"Ayamtaati tputsee mantsirimshee pangcheezich, ndambaree.","poem":1},{"lineBreak":true},{"text":"Ichingaru Apanll wanichiya.","poem":1},{"lineBreak":true},{"text":"Izuuru kachingeeru kasachiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Yuwash yutarit tushiychu anush Apanll waanaatstanaa tiptsir tapachindachiya.","poem":1},{"lineBreak":true},{"text":"Apanll watacha tapachindampani.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Apanll waana tiptsiree tapachindakiya.","poem":1},{"lineBreak":true},{"text":"Yutaritshishpan tuxarakchu, anoo suwamaam istakiya.","poem":1},{"lineBreak":true},{"text":"Waana wizpurpa ksutku istakiya.","poem":1},{"lineBreak":true},{"text":"Watam iy Apanllimun mangini tatkiniwa.","poem":1}]}],"footnotes":[{"noteId":30,"caller":"*","text":"Sandeeku 1.10-11; 1 Pitoru 1.24 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":37,"verse":2}},{"noteId":31,"caller":"*","text":"Matiwa 5.5 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":37,"verse":11}}]},"thisChapterLink":"/api/cbu_wbt/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":40}