{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":40,"content":[{"type":"heading","content":["Apaa, nuw shiyaa kukish kis payukina, átu, anoo kamankiya."]},{"type":"hebrew_subtitle","content":["Dapiyarini wayassi. Yandarangu, yasimpaneem urkar panarangiya."]},{"type":"verse","number":1,"content":[{"text":"Nuw Apanlleetsimari mangishi chinakuri taakina.","poem":1},{"lineBreak":true},{"text":"Yuwaa nuw kuruzki anoo Apanll mazinarangiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuw wizpuriri nduneerangu, tsipamaam waritarangitaati,","poem":1},{"lineBreak":true},{"text":"Apanll nuwaa tapachindarangiya.","poem":1},{"lineBreak":true},{"text":"Nuwaa itsipungayaru, yuwash tsap kis taachi anush ndatuma tsiparuri wayarangiya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wizpurpa nuwaa kuki murimash wayarangu,","poem":1},{"lineBreak":true},{"text":"nuwsha kaneeschee yaseesshish yaseekuri,","poem":1},{"lineBreak":true},{"text":"Apanllee, Wappari, tárangina.","poem":1},{"lineBreak":true},{"text":"Tputssha nuwaa parangusin, punirustarangusin,","poem":1},{"lineBreak":true},{"text":"Apanllimunarisha mang' taturangtamanaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yuw tputs Apanllee chinaku an mang' kis taachiya.","poem":1},{"lineBreak":true},{"text":"Tputsee yutaritshishpani izuuru mapiykiya.","poem":1},{"lineBreak":true},{"text":"Yuwaa apanllputsee ungirtakana anungaz nda chinachiya,","poem":1},{"lineBreak":true},{"text":"watam Apanllee kapung chinakuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apaa, nuw shiyaa apartana.","poem":1},{"lineBreak":true},{"text":"Iyashchee istamaam kapung chinarangush, wizpurpatatish istarangsha.","poem":1},{"lineBreak":true},{"text":"Wanip iyaa istarangsha. Tputsee kamanpi, atitaati, pinasakani, watam ichingaru kamanimaam wanindaja.","poem":1},"Shiyapat tatsamaam wanindaja."]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tputs chinuzee pachayarusin, muchkusin,","poem":1},{"lineBreak":true},{"text":"anumun shiy nda mangish ksaksha.","poem":1},{"lineBreak":true},{"text":"Shiy anumun yutaritshishee yaramaam nda kapung chinaksha.","poem":1},{"noteId":32},{"lineBreak":true},{"text":"Mishat, tirikoo pangishish yushindakuni,","poem":1},{"lineBreak":true},{"text":"anumuntam nda mangish ksaksha.","poem":1},{"lineBreak":true},{"text":"Itaru, Apaa, shiy nuwaa tsiyatkush,","poem":1},{"lineBreak":true},{"text":"K'keetsi zurampatari tuminungcha,","poem":1},{"noteId":33},{"text":"tárangsha.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ashirucha, nuwsha shiyaa, Tputsip nuwaa zanganingandama,","poem":1},{"lineBreak":true},{"text":"Shiy nuwaa kirakarishish kamanirangsha. Ashiri nuwsha,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"shiyaa kukish tuminumaam mangi kizpur ksakina.","poem":1},{"noteId":34}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ashiri shiyashchi tputs shaniykusin, anush","poem":1},{"lineBreak":true},{"text":"shiyaa kamachtamareetsish tatsamooru tayaspatakina.","poem":1},{"lineBreak":true},{"text":"Nda minumtiyam niyrkina. Shiysha anoo yasaksha, Apaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nuw nda zamaruri taakina.","poem":1},{"lineBreak":true},{"text":"Shiyaa kukish tsinsampaneetsish uru tputsee kamankuri taakina, atina.","poem":1},{"lineBreak":true},{"text":"Apanll uru iyaa ksutku taakiya. Iyaa tapachindachiya.","poem":1},{"lineBreak":true},{"text":"Tsipakchuni iyaa waanpee machchiya,","poem":1},{"text":"nuw tputsee tayaspatakuri atina.","poem":2},{"text":"Shiysha Apaa, uru iyaa chinakush, istaksha.","poem":1},{"lineBreak":true},{"text":"Ayamtaatiyam shiy chinashish pastacheeja.","poem":1},{"lineBreak":true},{"text":"Shiy kukish urutamari tputsirishish taachiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Apaa, shiy nuwaa ksarishpa. Urutamari nuwaa chinakush taangcha.","poem":1},{"lineBreak":true},{"text":"Shiy tsinsampantishcha.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nuwaanamandari chayari zapan xarashish nuwash tushiykiya.","poem":1},{"lineBreak":true},{"text":"Nuw yutarit zapan ashirangi anoo ichingaru kamanimaam pinasakina.","poem":1},{"lineBreak":true},{"text":"Na nuwaa xarashish kámanakcha.","poem":1},{"lineBreak":true},{"text":"¿Tamayareezi nuwaana yutarit ashirangi anoo tushiychee?","poem":1},{"lineBreak":true},{"text":"Zapan taaru anoo nuw táchimaam pinasakina.","poem":1},{"lineBreak":true},{"text":"Muchishi zapan kasiru taariya.","poem":1},{"lineBreak":true},{"text":"Ashirucha, mangi tsíparangu, izuuru sambaytarangina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Apaa, nuwaa nayaningandama.","poem":1},{"lineBreak":true},{"text":"Yutaritshishireetsi tchingangandama.","poem":1},{"lineBreak":true},{"text":"Mikeerush nuwaa istanda.","poem":1},{"lineBreak":true},{"text":"Zapshtarinllpa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mishat tputs nuwaa pachamaam zandkitamsinaya.","poem":1},{"lineBreak":true},{"text":"Ashiri shiysha yuwaa tputs nuwaa tayutaritkana anoo ipazangcha.","poem":1},{"lineBreak":true},{"text":"Waani paziksin suwasuwachinllinpa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Waani kapung pazichinllinpa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Itaru, yuw tputs shiyaa kukish payukana, anin mang' ksaksin shambatchinlliniya.","poem":1},{"lineBreak":true},{"text":"Mishat, yuw tputs shiyamun mang' tatkana anoomsha, Apaa,","poem":1},{"lineBreak":true},{"text":"shiy wizpurirish urutamari shiyash tachitamaam panangcha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Apaa, nuw kapung mangi mantsakina,","poem":1},{"lineBreak":true},{"text":"watam kiyung kachiykinawa.","poem":1},{"lineBreak":true},{"text":"Ashiri Apaa, nuwaa mbizarishpa,","poem":1},{"lineBreak":true},{"text":"watam shiy nuwaa istakshawa.","poem":1},{"lineBreak":true},{"text":"Shiy nuwaa tapachindaksha.","poem":1},{"lineBreak":true},{"text":"Itaru Apaa, zapshtarinllpa.","poem":1},{"lineBreak":true},{"text":"Mikeerush istangandama,","poem":1},{"lineBreak":true},{"text":"Apaa, nuw shiyaa apartana,","poem":1},{"lineBreak":true},"Dapiyarini tárangiya."]}],"footnotes":[{"noteId":32,"caller":"*","text":"Matiwa 9.13 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":40,"verse":6}},{"noteId":33,"caller":"*","text":"Utaáshucheema 10.5 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":40,"verse":6}},{"noteId":34,"caller":"*","text":"Yuwaa nish átu anootstam Utaáshucheema 10.5-7 tayusima kamankiya.","reference":{"chapter":40,"verse":8}}]},"thisChapterLink":"/api/cbu_wbt/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":17}