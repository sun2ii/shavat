{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":42,"content":[{"type":"heading","content":["Apanllpanee tputs undarar arap machtarangu, Apanllish pang' pshtupi átu, támararangu, tsiyatstar ashirangu, anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Koréchich yasimpan tputs yandamarini."]},{"type":"verse","number":1,"content":[{"text":"Manllanus tsap puzash taaku, sachitku, kungungaz waapi átu,","poem":1},{"lineBreak":true},{"text":"nuwsha ashiritamti shiyangaz Apaa, támarakuri nachungakina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nuw shiyangaz sachitakpaz ashkina, Apaa.","poem":1},{"lineBreak":true},{"text":"Watam shiysha taarashipanshawa.","poem":1},{"lineBreak":true},{"text":"¿Ashinooja nuw shiyash pangish yusur pshtuchee? aturi,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"shiyangaz kaschiritam psaantam tanukuri taakina.","poem":1},{"lineBreak":true},{"text":"Amb ashkuri sureemariti taakina.","poem":1},{"lineBreak":true},{"text":"Kundararshiti nuwaa, ¿Apanllirish yuwshta?","poem":1},{"lineBreak":true},{"text":"átangat ashkanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Síru shiyash pangish tputspata kis pshtutarini,","poem":1},{"lineBreak":true},{"text":"anoo chinachintar ashkuri, kapung mangi mantsakina.","poem":1},{"lineBreak":true},{"text":"Watam na ndusha ashkinawa.","poem":1},{"lineBreak":true},{"text":"Yuwataati nuwma tputsee yamazayaruri, shiyash pangish kuseeruri, shambatkuni,","poem":1},{"lineBreak":true},{"text":"washunand mangini kis ungirtakuni, yasiyastar ashtariniya.","poem":1},{"lineBreak":true},{"text":"Yusur tamayareezi ashchi aturi, kapung mangi mantsakuri, tanutantar ashkina. Ashiritaati,","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Mayaama nuw sambaytachi?","poem":2},{"lineBreak":true},{"text":"¿Mayaama nuw mangi mantsachee?","poem":2},{"lineBreak":true},{"text":"Nuw Apanllimunari mangi tatkina.","poem":2},{"lineBreak":true},{"text":"Anootsimari ungirtakuri taachima.","poem":2},{"lineBreak":true},{"text":"An watacha nuw Apanlliri, tapachindampani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nuw kapungcha sambaytamaam zandki.","poem":1},{"lineBreak":true},{"text":"Ashirucha, shiyaatsimari kapung chinakuri taakina.","poem":1},{"lineBreak":true},{"text":"Araptaa kung Ortagamanda, mach Hermonamanda, Mispamandtamta uru mangishi shiyaatsimari chinakuri taakina.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Íwar machimand kung wazawash pantsaku, zaw shitaru, arap zunganeetar ashtariya.","poem":1},{"lineBreak":true},{"text":"Nuwamun kungpaz ashiru zaw, zaw shitarpaz ashku mangi mantsakuri taakina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ashtaa Apaa, shiysha nuwaa nda kasaksha.","poem":1},{"lineBreak":true},{"text":"Kaschiritam nuwaa chinakush istaksha.","poem":1},{"lineBreak":true},{"text":"Psaantam nuw yasiyastar ashkina.","poem":1},{"lineBreak":true},{"text":"Uru shiyapa Apaa, tsiyatkina, watam shiysha uru nuwapat taakshawa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apaa, Shiy tapachindampantishcha, atina.","poem":1},{"lineBreak":true},{"text":"¿Mayaamsha shiy nuwaa mapiyksha?","poem":1},{"lineBreak":true},{"text":"¿Mayaamaja mangi mantsakuri taachi?","poem":1},{"lineBreak":true},{"text":"¿Mayaama kundarari nuwaa kiyung yachaku taak?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nuwaa kiyung yachaksin, napuritamti ichingaru ksukiya.","poem":1},{"lineBreak":true},{"text":"Urutari nuwaa tamundaksin, ¿Yapshata shiy Apanllirish? átangat ashkanaya.","poem":1},{"lineBreak":true},{"text":"Atitaateesinaya,","poem":1}]},{"type":"verse","number":11,"content":[{"text":"¿Mayaama nuw sambaytachi?","poem":2},{"lineBreak":true},{"text":"¿Mayaama nuw mangi mantsachee?","poem":2},{"lineBreak":true},{"text":"Nuw Apanllimunari mangi tatkina.","poem":2},{"lineBreak":true},{"text":"Anootsimari ungirtakuri taachima.","poem":2},{"lineBreak":true},{"text":"An watacha nuw Apanlliri, tapachindampani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":11}