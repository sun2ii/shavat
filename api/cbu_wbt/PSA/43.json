{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":43,"content":[{"type":"heading","content":["(Salmo 42 nish tspakiya)"]},{"type":"verse","number":1,"content":[{"text":"Apaa, nuwaa tapachindangandama.","poem":1},{"lineBreak":true},{"text":"Nishuch tputs shiyaa chinakazinllinaja.","poem":1},{"lineBreak":true},{"text":"Yutaritshishpansincha.","poem":1},{"lineBreak":true},{"text":"Wayangichirirsincha.","poem":1},{"lineBreak":true},{"text":"Ashiri nuwaa tapachindangandama.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Watam nuw shiyaa Aparinawa.","poem":1},{"lineBreak":true},{"text":"Shiy tapachindampantishcha.","poem":1},{"lineBreak":true},{"text":"Nuwaa kundarari kiyungutaa yachaku,","poem":1},{"lineBreak":true},{"text":"¿Mayaamaja shiy nuwaa kasachish?","poem":1},{"lineBreak":true},{"text":"¿Mayaamaja nuw mangi mantsakuri taachee?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ashiriya, Apaa, shaana wizpurirish zanganingi,","poem":1},{"lineBreak":true},{"text":"Nuwaa mangi tuwizpurtamaama.","poem":1},{"lineBreak":true},{"text":"Sheerush, shaanpee pangish machinda yap shiy taarish ambi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Shiyash pangish yusur kuskachuri, sumeetsish pakchuri,","poem":1},{"lineBreak":true},{"text":"shiyaa kapung ungirtachima.","poem":1},{"lineBreak":true},{"text":"Tamburpa, kitarpa yasichima.","poem":1},{"lineBreak":true},{"text":"Shaana, Apaa, nuwaam mangooz ksashish pshtangandama shiyaa kis yasimaama.","poem":1},{"lineBreak":true},{"text":"Shiyamunari Apaa, mangi kis taakina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Mayaama nuw sambaytachi?","poem":2},{"lineBreak":true},{"text":"¿Mayaama nuw mangi mantsachee?","poem":2},{"lineBreak":true},{"text":"Nuw shiyamunari mangi tatkina.","poem":2},{"lineBreak":true},{"text":"Shiyaatsimari ungirtakuri taachima.","poem":2},{"lineBreak":true},{"text":"Watam shiy tapachindampancha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}