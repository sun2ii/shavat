{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":46,"content":[{"type":"heading","content":["Apanll uru iyaa Israelchicheetsini ksutkiya"]},{"type":"hebrew_subtitle","content":["Koréchich tputs yandarangiya, tiruchizpa yasimaama."]},{"type":"verse","number":1,"content":[{"text":"Apanll iyaa ksutkiya. Iyaam wizpuree panakiya.","poem":1},{"lineBreak":true},{"text":"Apanllish kamungamaam uru taariya.","poem":1},{"lineBreak":true},{"text":"Yuwash xarashish taakchu anush istakiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ashiriya, ¿mayaamaja punichich?","poem":1},{"lineBreak":true},{"text":"Mundaz mundaztakchitaa, misha tsap kizpuritaa zpoozakchu,","poem":1},{"lineBreak":true},{"text":"machsha pátangambachtaa,","poem":1},{"lineBreak":true},{"text":"marush imurish pantsambachtaa,","poem":1},{"lineBreak":true},{"text":"ashiritaa ¿mayaamaja nuw punichee?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mar kapungtaati warastakchu,","poem":1},{"lineBreak":true},{"text":"mach kizpuritaa zpoozakchu, itaru nda nuw punichina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kungsha wanasirimish Apanllish yaktarini taariya.","poem":1},{"noteId":35},{"lineBreak":true},{"text":"Anush tputs kungumun wip mang' ksachinlliniya.","poem":1},{"lineBreak":true},{"text":"Watam waana Apanll wamari kasiru an anush taakuwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Waanaatsi yaktarini uru ksutku, tapachindachiya.","poem":1},{"lineBreak":true},{"text":"Zar taraseetaranllu anush kundararini kuskatssin,","poem":1},{"lineBreak":true},{"text":"Undarsha; Taraseekchu pshtuyani, atitaatssin,","poem":1},{"lineBreak":true},{"text":"ayamamtiyam nda kasachiya.","poem":1},{"lineBreak":true},{"text":"Watam Apanll waana naparu iyaa tapachindakiya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kizpuri kuk kimaku, tputs ztaru puniksin zamangachinlliniya.","poem":1},{"lineBreak":true},{"text":"Tsapurunasshuch kurak nungtachinllinaya.","poem":1},{"lineBreak":true},{"text":"Apanll izuuru wizpurpa tsapoo kapeetku pastachiya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apanll kizpurcha. Iyachchee Akoparinchicheetsini nlluranurini uru ksutkiya.","poem":1},{"lineBreak":true},{"text":"Apanllimun mangini tatkuni, urutamari iyaa izuuru tapachindaku taachiya.","poem":1},{"lineBreak":true},{"text":"Apanllishumarisha kamungchiniya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Naapangints.","poem":1},{"lineBreak":true},{"text":"Apanll iyaa tsapurunasshucheetsini ichingarootsini tpuxtayanlliya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tapazpaneetsi tsapurunas ztaru;","poem":1},{"lineBreak":true},{"text":"Na Waapa. Zanayangints, tákchu,","poem":1},{"lineBreak":true},{"text":"Tapazpan ztaru zanayanllinaya.","poem":1},{"lineBreak":true},{"text":"K'chirpungoo ichingaru ichip ichip sheersin,","poem":1},{"lineBreak":true},{"text":"Turuwaatstam pátangambeeru kasayanllinaya.","poem":1},{"lineBreak":true},{"text":"Tapazpanee pshiyrshini sumasush mucheenlliya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Apanll tputsee kamachtaku;","poem":1},{"lineBreak":true},{"text":"Na waapa. Zanayangints, tákchu; Nuw Apanlli Taarashipantana.","poem":1},{"lineBreak":true},{"text":"Tputsee urkar ztaru tiptsirpatatam nuwaatssha;","poem":1},{"lineBreak":true},{"text":"Shiy Apanlltishcha. Shiyamari kasirush taaksha, nuwaa táchinllinaya,","poem":1},"átcha Apanlli."]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Apanll kizpuri iyash taakiya. Iyachchee Akoparinchicheetsini nlluranurini uru ksutkiya.","poem":2},{"lineBreak":true},{"text":"Uwamun kamungchiniya.","poem":2}]}],"footnotes":[{"noteId":35,"caller":"*","text":"Apanll wanichu anu 22.1-2 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":46,"verse":4}}]},"thisChapterLink":"/api/cbu_wbt/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":11}