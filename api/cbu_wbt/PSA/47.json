{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":47,"content":[{"type":"heading","content":["Apanllimari kurak kasiru taakchu, tsapurunasshuch ztaru kis shambatkusin taachinllina, anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Tputs Koréchich nlluranuri yandamarini."]},{"type":"verse","number":1,"content":[{"text":"Apanllee shambatkuni ichingaruni zamangayani.","poem":1},{"lineBreak":true},{"text":"Mangis ksaptari shambatkus zamangakus, Jai, jai, tángtsa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Watam Apanll kizpureeru waamari kasiru tpuxtakiya.","poem":1},{"lineBreak":true},{"text":"Ichingaroom tsapurunas Apanllimari kurak taakiya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apanll Kanaanshuchee tputs tpachingarangu","poem":1},{"lineBreak":true},{"text":"watsapunee iyaamshat panarangiya.","poem":1},{"lineBreak":true},{"text":"Tputseetstam m'chachureemani wayarangitamta.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apanll iyaa kapung chinarangu, iyaam waana tsapoo ipuseeru panarangiya.","poem":1},{"lineBreak":true},{"text":"Anush na iyshat Akoparinchichini kis taakaniya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Na Apanll ichingaru kurakaam wayarangu, na mapiyshat uxinashimun kuxinkiya.","poem":1},{"lineBreak":true},{"text":"Ashiriya na iyshat mangini kis shambatkuni tamburtakuni, tirucheeni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Apanllee shambatkuni yaseeyani.","poem":1},{"lineBreak":true},{"text":"Kurakareetsini ungirtakuni yaseeyani.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apanlleem yaseesshish yandayaruni yaseeyani.","poem":1},{"lineBreak":true},{"text":"Watam wamari tsapurunasshucheetsini kasiru kurak taakuwa.","poem":1},{"lineBreak":true},{"text":"Mangiptis yaseengints.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apanll uxinashimand kuxinaru tputseetsini ztaru ksutariya.","poem":1},{"lineBreak":true},{"text":"Ichingaroo tsapurunasee napkiya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tsapurunasshuch kurak Apanllpat tiptsir,","poem":1},{"lineBreak":true},{"text":"Apramarinchichpa, washunand shaniyeersin,","poem":1},{"noteId":36},{"text":"Apanllee ungirtakanaya.","poem":1},{"lineBreak":true},{"text":"Watam Apanllimari tsapurunasshuchee kurak kasiru taakuwa.","poem":1},{"lineBreak":true},{"text":"Ashiriya, ichingaruni Apanllimunari shambateeni.","poem":1}]}],"footnotes":[{"noteId":36,"caller":"*","text":"Matiwa 8.11 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":47,"verse":9}}]},"thisChapterLink":"/api/cbu_wbt/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}