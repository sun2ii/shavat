{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":48,"content":[{"type":"heading","content":["Apanll waana tiptsiree ksutku, anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Koréchich nlluranur yandamarini."]},{"type":"verse","number":1,"content":[{"text":"Apanll taarashipani waamari kasiriya.","poem":1},{"lineBreak":true},{"text":"Waana yaktarinshini, Irusarinush Apanllee ungirtamaam","poem":1},{"lineBreak":true},{"text":"wanasircha, waanpee pangu, machip Siyonshu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Apanll machirini Siyon kizpurcha wanasiri.","poem":1},{"lineBreak":true},{"text":"Minumari mach ichingaru kasiriya.","poem":1},{"lineBreak":true},{"text":"Tputs ztaru machip Siyonamand mang kis shambtkanaya.","poem":1},{"lineBreak":true},{"text":"Watam anush Apanll, iy kurakarini, wamari kasiru an taakuwa.","poem":1},{"noteId":37}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Irusarinaa mbamari tandapunurangusin,","poem":1},{"lineBreak":true},{"text":"Undarar pshtumaam pinasakanaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kurak shaneerangusin, Irusarinshuchee kasiyani, tárangitaatssin,","poem":1},{"lineBreak":true},{"text":"Itaru, kuskatssin,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kizpurcha, táyarusin, napuxtayarusin, suwaranganaya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kapung puniksin, nungtaranganaya.","poem":1},{"lineBreak":true},{"text":"Kiz nlluraa tatsipku, wasurimun nungtataru ashiranganaya. Sheeru Apanll undararee kachingarangiya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Boti marush kung kizpur kambusurush naanatan ashku, mikeeru ichip ichip ashku kachingkachu, ambpaz ashirangu Apanllsha undarareetsi kachingarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tputs iyaa: Apanll yaktarini kizpurcha, táranganaya.","poem":1},{"lineBreak":true},{"text":"Natsha iysha anootstam, Apanll yaktarini kizpurcha, atitamaniya.","poem":1},{"lineBreak":true},{"text":"Apanll wamari kasiru waanaatsi yaktarini urutari ksutchiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Apaa, shiyash pangish pshtuyaruni,","poem":1},{"lineBreak":true},{"text":"mangini kis shiyaa chinakuni, Apanll urutamari iyaa chinakiya, atiniya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tsapurunas ztaru shiyaa ungirtachinlliniya.","poem":1},{"lineBreak":true},{"text":"watam shiy taarashipanshawa.","poem":1},{"lineBreak":true},{"text":"Shiyamari kasiru taakush, tputsee ichingarusin tatsamooru ksutaksha.","poem":1}]},{"type":"verse","number":11,"content":["Iysha, Irusarinshuchini ichingaruni shiyamun mangini ksakuni, shambatchinlliniya.",{"text":"Zuwanlltamani yuw minush Utaáshuch yaktash taakana","poem":1},{"lineBreak":true},{"text":"antamsin, shiyamuntam Apaa, shambatchinlliniya.","poem":1},{"lineBreak":true},{"text":"Watam iyaa chinarangush, tputsireetsish itsinsaru kamachtarangsha.","poem":1}]},{"type":"verse","number":12,"content":["Yakat Irusarinap iturpirus, ichinguru napangints.",{"text":"¿wanipaja tandapunuzush torre pshkurutara?","poem":1},{"lineBreak":true},{"text":"¡Tandapunuzi wamaneewa!","poem":1},{"lineBreak":true},{"text":"Sundar ksutamapan pang' zapanitamta.","poem":1},{"lineBreak":true},{"text":"Yakat Irusarin kizpurcha.","poem":1},{"lineBreak":true},{"text":"Ashiri napeerus, yasayarus ipareetsis ichingaroo kamaningtsa.","poem":1},{"lineBreak":true},{"text":"Yuwaa kaneesich nllurtachinllina anootstamta kamaningtsa.","poem":1},{"lineBreak":true},{"text":"Apanll yaktarini kizpurcha, tángcha.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Iy Aparini urutamari wamari kasiru taarashipan taakiya.","poem":1},{"lineBreak":true},{"text":"¡An watacha iyaa itsinsaru urutamari machkiya!","poem":1}]}],"footnotes":[{"noteId":37,"caller":"*","text":"Matiwa 5.35 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":48,"verse":2}}]},"thisChapterLink":"/api/cbu_wbt/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":13}