{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":63,"content":[{"type":"heading","content":["Dapiyarini Apanllingaz támararangu, Undararee kasimaam istanda, tárangu, anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Dapiyarini wayandamari. Dapiyarini Absalon pacharundama átu, apusap suwatat ashirangiya."]},{"type":"verse","number":1,"content":[{"text":"Apaa, shiyaa nuwcha Apari.","poem":1},{"lineBreak":true},{"text":"Nuw Shiyangaz támarakina.","poem":1},{"lineBreak":true},{"text":"Tputs tsap mazachinandari taaru, amb naayaru,","poem":1},{"lineBreak":true},{"text":"sachittaru, ashiritamti nuw shiyangaz kizpur sachitakpaz ashkuri támarakina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Shiyash pangish pshtupi tina.","poem":1},{"lineBreak":true},{"text":"Shiyaa pangasi, atitamana.","poem":1},{"lineBreak":true},{"text":"Anush shiyaatsimari chinamaam zandkina.","poem":1},{"lineBreak":true},{"text":"Shiy kizpurtishcha, wanasirish.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Shiyamari kasiru nuwaa chinakush,","poem":1},{"lineBreak":true},{"text":"tsipaneetstaati nda pachindkina.","poem":1},{"lineBreak":true},{"text":"Ashirucha shiyaa mangi kis ungirtakina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Urutari nish tsapurunasush taakuri,","poem":1},{"lineBreak":true},{"text":"shiyaa ungirtakuri taachina.","poem":1},{"lineBreak":true},{"text":"Kuwee íwar paxayeeruri shiyapat tsiyatchina","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Shiyamun mangi kisa.","poem":1},{"lineBreak":true},{"text":"Tputs kapung katungeeru, tazazayaru, mang kis taaku,","poem":1},{"lineBreak":true},{"text":"nuwsha shiyaa ungirtakuri ambtam ashchina.","poem":1},{"lineBreak":true},{"text":"shiyaa kis yasichina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Psaantam Apaa, maamaw ashkuri,","poem":1},{"lineBreak":true},{"text":"shiyaatsimari mangishi chinachintar ashkina.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Waninll nuwaa istakush ksutakshawa.","poem":1},{"lineBreak":true},{"text":"Ashirucha, mangi kis nda punikuri taakina.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Shiyash izuuru tachitpi tina.","poem":1},{"lineBreak":true},{"text":"Shiyaa kasamaam zandkeezi.","poem":1},{"lineBreak":true},{"text":"Kuwish mbutsanungich nuwaa mbam patsisakush,","poem":1},{"lineBreak":true},{"text":"nda kasaksha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tputs nuwaa pachamaam zandkitaatssin,","poem":1},{"lineBreak":true},{"text":"waantatamsin k'chirpungamun tsipachinlliniya","poem":1},{"lineBreak":true},{"text":"Wazawash waantsush tputs","poem":1},{"lineBreak":true},{"text":"tsiparpat wan washunand taachinlliniya.","poem":1},{"lineBreak":true},{"text":"Wanutseetsina tumuz manginshuch katungchinlliniya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Itaru, nuwsha shiyamun Apaa, mangi kis taachina","poem":1},{"lineBreak":true},{"text":"Shiy nuwaa tputsireetseerush kurakaam ínarangsha.","poem":1},{"lineBreak":true},{"text":"Ashiri siysa Apanllis tiptsiris, Apanllee mangis kis yaseekus ungirtangtsa.","poem":1},{"lineBreak":true},{"text":"Itaru, wayangichirirsha tputs izuuru zamayarusin taachinlliniya.","poem":1},{"lineBreak":true},"Ashiriya, Apaa, wapparee."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":10}