{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":67,"content":[{"type":"heading","content":["Tputs ztaru Apanllee ungirtachinllinaya, anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Yasimpan tputs kitarpanpat yaseeyarusin anoo yandarangiya."]},{"type":"verse","number":1,"content":[{"text":"Shiy Apaa, uru iyaa nayaniyarush, istangcha.","poem":1},{"lineBreak":true},{"text":"Iyaa wanasiri napangcha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ashkachush, tputs ztaru, Apanllee mangooneeni.","poem":1},{"lineBreak":true},{"text":"Iyaa tapachindachtamparee, táchinlliniya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Apaa, tsapurunas ztaru shiyaa ungirtachinllinpa.","poem":2},{"lineBreak":true},{"text":"Shiyamun mang' kis shambatchinllinpa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tputs ztaru ichingurusin shiyamun mang' kis yaseeksin, zamangachinllinpa.","poem":1},{"lineBreak":true},{"text":"Shiysha, Apaa, kurakish tputsee ichingarootssin ksutkush k'kuzee yaramapan taaksha.","poem":1},{"lineBreak":true},{"text":"Tatsamooru tputsireetsish chinaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ashiri Apaa, tsapurunas ztaru shiyaa ungirtachinllinpa.","poem":2},{"lineBreak":true},{"text":"Shiyamun mang' kis shambatchinllinpa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Apanllirini iyaam kapung istarangu,","poem":1},{"lineBreak":true},{"text":"na tsapurunasish waanaatsee kuk wanus pzapaneerangiya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apanll uru iyaa chinachiya.","poem":1},{"lineBreak":true},{"text":"Tputs ztaru Apanllee chinachinllinpa.","poem":1},{"lineBreak":true},{"text":"Mang' kis Apanllimun shambatchinllinpa.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":7}