{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":69,"content":[{"type":"heading","content":["Tputs Dapiyarinee kiyung yacharangusin, Dapiyarinsha, Apaa, istanda, tárangu anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Dapiyarini wayandamari."]},{"type":"verse","number":1,"content":[{"text":"Apaa, nuwaa tapachindanda.","poem":1},{"lineBreak":true},{"text":"Papcha, nuwaa pachamaam kapung zandeenllinpa.","poem":1},{"lineBreak":true},{"text":"Tputs kungush imurish yangakchu,","poem":1},{"lineBreak":true},{"text":"tamatarpari ashiru itamsamaam pinasakina.","poem":1},{"lineBreak":true},{"text":"Kung wizpur nuwaa kapeetamaam zandkiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Apaa, shiyaa, Istanda, aturi,","poem":1},{"lineBreak":true},{"text":"kapung kuruztat ashkuri, yarpuni ksukshita.","poem":1},{"lineBreak":true},{"text":"Shiyaam kutakuri, kapung tanukuri, kachi manamawshita.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tputs zapan msangarusin, nuwaa natsakanaya.","poem":1},{"noteId":42},{"lineBreak":true},{"text":"Mucheetsich kasiru tputs nuwaa zapan natsakanaya.","poem":1},{"lineBreak":true},{"text":"Mangutari nuwaa tayutaritkanaya.","poem":1},{"lineBreak":true},{"text":"Maacheetsi shuchitarpazi ashiru,","poem":1},{"lineBreak":true},{"text":"nuwaa taxiyrsin; Tuwanpunda, átangat ashkanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Itaru Apaa, shiy nuwaa yasaktishcha.","poem":1},{"lineBreak":true},{"text":"Nuw yutarit ashiranginaareena, anoo shiy izuuru yasaksha.","poem":1},{"lineBreak":true},{"text":"¿Tamayareezi yutaritshishireetsi pishuchi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Apaa, shiyamaricha kizpurish.","poem":1},{"lineBreak":true},{"text":"Iy shiyaa Israelchichini Apanllirtanicha.","poem":1},{"lineBreak":true},{"text":"Iyashuch zapan shiyamun mang' tatkanaya.","poem":1},{"lineBreak":true},{"text":"Ashiriya, tputsirish nuwamand yutaritshishiri pazirusinapa.","poem":1},{"lineBreak":true},{"text":"Kundarari nuwamand tputsireetsish tpazarusinapa, átana.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Shiyaa kapung chinaki, anumand tputs nuwaa yutari tsiyatkanaya.","poem":1},{"lineBreak":true},{"text":"Nuwaa tpazakanaya.","poem":1},{"lineBreak":true},{"text":"Kizpur pazirsa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zuwanlli tunar tamapari ashirusin nuwaa niyrkanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Itaru nuwsha, pangimandaritish wamin tsiyanis nuwaa kasichiya.","poem":1},{"noteId":43},{"lineBreak":true},{"text":"Tputs shiyaa tpazamaam zandkusin,","poem":1},{"lineBreak":true},{"text":"nuwaatssha tpazaktamsinaya.","poem":1},{"noteId":44}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nuw mangi kapung mantsakuri, tanukuri, mishat mangukuri,","poem":1},{"lineBreak":true},{"text":"nuwaa yutarit tsiyatkanaya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mangi mantsakuri, kamari kuchar kamartakuri,","poem":1},{"lineBreak":true},{"text":"nuwaa paksin, ichingarusin stakanaya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tputs yaktaa washitungash shaniyeersin,","poem":1},{"lineBreak":true},{"text":"nuwaa tsiyatstangat ashkusin taakanaya.","poem":1},{"lineBreak":true},{"text":"Karusamapantaatssin nuwaa tayutaritkusin yaseekanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Itaru Apaa, nuw shiyaa kapung tsiyatkina.","poem":1},{"lineBreak":true},{"text":"Ashiri yuwash shaana zandkachish, anush istangandama.","poem":1},{"lineBreak":true},{"text":"Shiy kapung chinampantishcha.","poem":1},{"lineBreak":true},{"text":"Nuwaa kapung chinaksha. Ashiri tapachindangandama.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nuwaa imurish yangamaam ksarishpa.","poem":1},{"lineBreak":true},{"text":"Tputs zapan nuwaa natsakanaya.","poem":1},{"lineBreak":true},{"text":"Itaru, shiysha nuwaa tapachindangandama.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mureenush nuwaa ksarinllpa.","poem":1},{"lineBreak":true},{"text":"Nda nuwaa mureen pumaam izuuru istanda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Apaa, shiy nuwaa istangandama.","poem":1},{"lineBreak":true},{"text":"Shiy wanasiri chinaksha. Shiy kchinamishtishcha.","poem":1},{"lineBreak":true},{"text":"Ashiri nuwaa nayanikush, wanasiri napangandama.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apaa, shiy watam nuwaa tputsirshawa.","poem":1},{"lineBreak":true},{"text":"Ashiri Apaa, nuwaa mapiyrinllpa.","poem":1},{"lineBreak":true},{"text":"Tputs pacharundama, átana.","poem":1},{"lineBreak":true},{"text":"Ashiri mikeerush nuwaa istanganda.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nuwanung kayumayarush, nuwaa tapachindanda.","poem":1},{"lineBreak":true},{"text":"Kundarareetsi arap zanganingcha.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"¿Waninll nuwaa natsakanawa?","poem":1},{"lineBreak":true},{"text":"Nuwaa tpazakanaya.","poem":1},{"lineBreak":true},{"text":"Mangutari nuwaa mantsir tsiyatkanaya.","poem":1},{"lineBreak":true},{"text":"Shiy anoo ichinguru yasaksha.","poem":1},{"lineBreak":true},{"text":"Nuwaa kundarari paksha.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nuwaa uru yutarit tsiyatkusin, kapung natsaksin,","poem":1},{"lineBreak":true},{"text":"mangi kapung mantsakina.","poem":1},{"lineBreak":true},{"text":"Mangi mantsakuri wizpuriri ndunareekina.","poem":1},{"lineBreak":true},{"text":"Nuwaa mangeetsi tuwizpurtapanda, atitaati,","poem":1},{"lineBreak":true},{"text":"itaru tputs nda minumtiyam nuwaa istamaam zandaranganaya.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Nuwaamsha katungtsee tspaspa íseersin panakanaya.","poem":1},{"lineBreak":true},{"text":"Kapung sachitaranguri, kapizsha nuwaam panakanaya.","poem":1},{"noteId":45}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ashiri, Apaa, uwsha shiyaam katungamaam shaniykusin, shiysha waneengcha.","poem":1},{"noteId":46}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Wach mchus tamapari ashiru mangu masaru taachinllinpa.","poem":1},{"lineBreak":true},{"text":"Uru kiyung kachiychinllpa.","poem":1},{"lineBreak":true},{"text":"Urutamari puniksin, wanumb nungtachinllinpa.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Shiy kapung tsiyantayarush, waneengcha.","poem":1},{"lineBreak":true},{"text":"Tsiyanish zambazarinllpa.","poem":1},{"lineBreak":true},{"text":"Izuuru waneengcha. Pakchiyam nayanirinllpa.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mishat, kundarareetsi pang' kapeeteerush ksangcha.","poem":1},{"lineBreak":true},{"text":"Anush minumtiyam taarusinapa.","poem":1},{"noteId":47}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Shiy nuwaa kiyung yacharangish,","poem":1},{"lineBreak":true},{"text":"anoo kasiranasha uwshtisin nuwaa kiyung yachakanaya.","poem":1},{"lineBreak":true},{"text":"Nuwaa stakanaya.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ashiri shiysha Apaa, aranginasha waneengcha.","poem":1},{"lineBreak":true},{"text":"Nayanirinllpa. Izuuru waneeyarush ksangcha.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kirakarishish yuwash shaanaa tputsirish sur yandam taaru,","poem":1},{"lineBreak":true},{"text":"anush kundarareetsi sur izuuru tchingangcha.","poem":1},{"lineBreak":true},{"text":"Watam nda urutamari shiyapat taachinllinawa.","poem":1},{"lineBreak":true},{"text":"Ashiri tputsiriptish sur washunand kundarareetsi sur yandarinllpa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Apaa, Nuw kapung kiyung kachiykina. Istanda.","poem":1},{"lineBreak":true},{"text":"Nuwaa tuwizpurtanda. Tapachindanda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ashkachush, nuwsha shiyaa ungirtakuri, yaseesshish yasichima.","poem":1},{"lineBreak":true},{"text":"Mangipti itsinsaru shiyaa ungirtachima, atina.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ashiriya, chiy tputsich chinuzee toro pachayaruch,","poem":1},{"lineBreak":true},{"text":"nduntaati ashiru karupanaa witspatari, wachizuppatari muchkachuch,","poem":1},{"lineBreak":true},{"text":"anoo Apanll kispari napchiya.","poem":1},{"lineBreak":true},{"text":"Itaru, chiy tputsich mangiptartich itsinsaru Apanllee ungirtakuch,","poem":1},{"lineBreak":true},{"text":"Apanllsha aranginasha chiyaa kis napkiya.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Anoo Apanll pakchu, mang' ksaku,","poem":1},{"lineBreak":true},{"text":"chiyaatssha mangeemich ksashish wayachiya.","poem":1},{"lineBreak":true},{"text":"Apanllingaz támarakuch, tuwizpurtachiya.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Watam tputs kiyung kachiyku, Apanllee istapanda átu,","poem":1},{"lineBreak":true},{"text":"mashku, Apanllsha uru mazinakuwa.","poem":1},{"lineBreak":true},{"text":"Tputs tumanamaw taakana, anootstam nda niyrkiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ashiri kanindshuchis, mishat tsapurunasshuchis, mishat marshuchis,","poem":1},{"lineBreak":true},{"text":"ichingarus, Apanllee ungirtangtsa, nuw siyaa atina.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Apanll waana Siyonshuchee tapachindachiya.","poem":1},{"lineBreak":true},{"text":"Yusursha Utaáchchee yaktarin yapungachiya.","poem":1},{"lineBreak":true},{"text":"Sheeru, Apanll tiptsir anush taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Amuytachinllinaya.","poem":1},{"lineBreak":true},{"text":"Wipshitisin izapaneeyarusin, kapungushsha yakat taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Apanllchichinandarishtisin anush taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Ashiri na kamaneena Dapiy kiyung kachiyku, Sitatsti, tárangu anootsi.","poem":1}]}],"footnotes":[{"noteId":42,"caller":"*","text":"Yuwaa nish átu anootstam Wanga 15.25, atitamta","reference":{"chapter":69,"verse":4}},{"noteId":43,"caller":"*","text":"Yuwaa nish átu anootstam Wanga 2.17 tayusima kamankiya.","reference":{"chapter":69,"verse":9}},{"noteId":44,"caller":"*","text":"Yuwaa nish átu anootstam Romshucheema 15.3 tayusima kamankiya.","reference":{"chapter":69,"verse":9}},{"noteId":45,"caller":"*","text":"Matiwa 27.34, 48; Márkosa 15.23, 36; Lukasa 23.36; Wanga 19.28-29 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":69,"verse":21}},{"noteId":46,"caller":"*","text":"Yuwaa nish átu anootstam Romshucheema 11.9-10 tayusima kamankiya.","reference":{"chapter":69,"verse":22}},{"noteId":47,"caller":"*","text":"Yuwaa nish átu anootstam Tayaspatampani 1.20 tayusima kamankiya.","reference":{"chapter":69,"verse":25}}]},"thisChapterLink":"/api/cbu_wbt/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":34}