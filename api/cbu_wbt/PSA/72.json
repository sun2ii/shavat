{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":72,"content":[{"type":"heading","content":["Apanll ipusamarini tsapurunaseem kurak taachu anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Salomonarini wayasi."]},{"type":"verse","number":1,"content":[{"text":"Apaa, shiy ipusamareetsish kurakaam ínakchush,","poem":1},{"lineBreak":true},{"text":"wizpureetsish tputsee itsinsaru ksutamaam, panangcha,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ashkachush, kuraksha chinampa tputsireetsish","poem":1},{"lineBreak":true},{"text":"ksutku, tsiyatssee wanasir yarku,","poem":1},{"lineBreak":true},{"text":"pukireetstam wanasiri istachiya.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuw tputs machip taakana, antamsin wanasirsha mapiyrsin taachinllinaya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kurak pukiree tputs istakchu, wanasirsha tsiyatssee yarku taachiya.","poem":1},{"lineBreak":true},{"text":"Wipawaatstam istakchu mapiyrtamsin taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Watam tamundampanee tputs tununumbayaru kasachuwa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Urutamari an kurak taachpa.","poem":1},{"lineBreak":true},{"text":"Zar, misha tsup tamaparee ashiru urutamari taachpa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kurak ashkachu, tputsee kapung istachiya.","poem":1},{"lineBreak":true},{"text":"Sin sinakchu, mzats tatsumim kis kxuntaru,","poem":1},{"lineBreak":true},{"text":"kuraksha ambtam ashiru tiptsiree istakchu, kis","poem":1},{"lineBreak":true},{"text":"taachinllinaya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nduma tsup pastachu,","poem":1},{"lineBreak":true},{"text":"kurak tiptsir waanpatatin wanasir tsiyatkusin,","poem":1},{"lineBreak":true},{"text":"mapiyrsin kis taachinllinaya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kurak tputsee ztaru ksutku, wamari kasiru taachiya.","poem":1},{"lineBreak":true},{"text":"Kung Eufratismand yaru, ichingaru tputsee wamari kasiru taachiya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Undararshitisin, tsap puzap taaksin, waantatamsin,","poem":1},{"lineBreak":true},{"text":"tutunlltayarusin, Kurakaa, Shiyaa kukish payuchinipa, puniksin táchinllinaya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tarisshuch tputs urkar, Sambashuchtam urkar,","poem":1},{"lineBreak":true},{"text":"Sibashuchtam urkar, arapcheewtamsin minpich tputs urkari,","poem":1},{"lineBreak":true},{"text":"ichingarusin kurakaam maacheetsi wanasirimshee yushindayarusin,","poem":1},{"lineBreak":true},{"text":"mangutari kurakaamsha panachinllinaya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ashiri tsapurunasshuchsha kurak ichingarusin waatsimarisha tutunlltaksin taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Tputsee ztaru kurakaa wamachtasheetssha payuksin taachinllinaya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pukirsha tputs, Kurakaa istanda. Tpachindanda, tákchu, kuraksha tputsee taárash tapachindachiya,","poem":1},{"lineBreak":true},{"text":"Watam wamin istamaama ndunariwa.","poem":1},{"lineBreak":true},{"text":"¿Chakaja pukiree istach?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kuraksha waanaatsi tiptsir chinampatari tuwizpurtachiya.","poem":1},{"lineBreak":true},{"text":"Pukireetstam tputs taárasheetstam tapachindachiya.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tputs Kurakaa tiptsiri kiyung yachamaam zandkitaatssin,","poem":1},{"lineBreak":true},{"text":"uwsha tiptsiree tapachindachiya,","poem":1},{"lineBreak":true},{"text":"watam kapung chinakuwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Urutari kurak kasiru taachiya.","poem":1},{"lineBreak":true},{"text":"Sambashuch tputs orootsee kurakaam panachinllinaya.","poem":1},{"lineBreak":true},{"text":"Kurakaam Apanllee urutamari mashkusin taachinllinpa.","poem":1},{"lineBreak":true},{"text":"Sheeru, Apanll urutamari istaku taachiya.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ashkachu, wanus zapan iyash tsapuni taachiya.","poem":1},{"lineBreak":true},{"text":"Machpitam wanus zapantam tatsumim paratungachiya.","poem":1},{"lineBreak":true},{"text":"Libanush tsap tamapari ashiru wanusi tsapurunasush izuuru tatsitchiya.","poem":1},{"lineBreak":true},{"text":"Chirichir tamaparee ashiru izapanichiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tputs urutamari kurakaa sur yasachinllinpa.","poem":1},{"lineBreak":true},{"text":"Urutamari zar tamapari ashiru kurakaa taachpa.","poem":1},{"lineBreak":true},{"text":"Ashkachu, ztaru tputs kissha taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Wamachtashee wanasirimshi uru payuchinllinaya.","poem":1},{"lineBreak":true},{"text":"Tsapurunasshuch tputs ichingurusin kurakaa ungirtaksin,","poem":1},{"lineBreak":true},{"text":"Shiyamari kasirush taaksha, táchinllinaya.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Apanll Taarashipani iyamari Israelchichini Apanllirini","poem":1},{"lineBreak":true},{"text":"taakiya.","poem":1},{"lineBreak":true},{"text":"Wamari kasiru wanasircha.","poem":1},{"lineBreak":true},{"text":"Waamari iyaa kizpur istakiya.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Shiysha Apaa, urutamari Taarashipanish taaksha.","poem":1},{"lineBreak":true},{"text":"Shiyamari wanasirtishcha.","poem":1},{"lineBreak":true},{"text":"Shiyamari tapachindampantishcha.","poem":1},{"lineBreak":true},{"text":"Apaa, tputs ztaru shiyaa wanasirimshireetsish yasachinllinpa, atina.","poem":1},{"lineBreak":true},{"text":"Ashiri Apaa, Wappari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":["Anumari apap Dapiyarini mangush chinarangu, shiyapat tsiyatku tárangitamta."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":20}