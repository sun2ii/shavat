{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":73,"content":[{"type":"heading","content":["Yashingchich tputs sambarchimunpaz ashiru naakana, anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Asafarini yandarangu anu."]},{"type":"verse","number":1,"content":[{"text":"Apanll iyashchee Israelchicheetsini kis istakiya.","poem":1},{"lineBreak":true},{"text":"Tputs mang' yaramaw taaku anoo Apanll kis istakiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Itaru, nuwsha Apanllee chinaktaati,","poem":1},{"lineBreak":true},{"text":"sambarchishpaz ashiru pakchim pantsamaam pishtarangina.","poem":1},{"lineBreak":true},{"text":"Apanllee kasamaam pakchim pishtarangina","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Watam mangishi yutarit chinaranguri,","poem":1},{"lineBreak":true},{"text":"¿Tamashta tputs yashingchich yutarittaa taaksin, shamangarsin kis taakana?","poem":1},{"lineBreak":true},{"text":"Nuwsha ashingasi, mangishi tárangina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Uwshtisin tsipatsee nda punikanaya, watam","poem":1},{"lineBreak":true},{"text":"nda kas yutakanawa.","poem":1},{"lineBreak":true},{"text":"Nda kiyung kachiykanawa.","poem":1},{"lineBreak":true},{"text":"Itaru, pukir tputs urkir ndunar,","poem":1},{"lineBreak":true},{"text":"¿Maypataja maacheetsi paxanxchi? atusin, kiyung kachiykanaya.","poem":1},{"lineBreak":true},{"text":"Yashingchichshat, kurikpan, mapiyrsin kis taakanaya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Waanaatsi kis tuwaraksin, wayarangashirini xanumba ashkanaya.","poem":1},{"lineBreak":true},{"text":"Pukireetssha natsaksin, kiyung yachakanaya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kapung katungkusin, wanuts kapungu, tash kapukpuru wach shunlleew ashkanaya.","poem":1},{"lineBreak":true},{"text":"Mantsir chinaksin, tputsee tamapingaksin,","poem":1},{"lineBreak":true},{"text":"waamaritssin kasimaam zandkanaya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sheersin, tputsee kasiyarusin stakanaya.","poem":1},{"lineBreak":true},{"text":"In tputs mang' ndunparee, atusin,","poem":1},{"lineBreak":true},{"text":"aranginasha kiyung yachakanaya.","poem":1},{"lineBreak":true},{"text":"Pukireewaa wintsareem wayakanaya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apanllee natsaksin yutarit tsiyatkanaya.","poem":1},{"lineBreak":true},{"text":"Ichinguroom tputs ngitzee wayakanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ashkusin, tputssha, ¿Ndusha zurku át? atusin,","poem":1},{"lineBreak":true},{"text":"yutaritshishpanip tachitamaam zandkanaya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Waanpatatin tsiyatkusin, ¿Kaapaneeja Apanll kurikpanee kuk mazinak?","poem":1},{"lineBreak":true},{"text":"¿Apanll kaapaneeja pak? Ndunparee, atanaya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¡Pa, in urkirpan tamara!","poem":1},{"lineBreak":true},{"text":"nduntaa tarawaztaksin, aranginasha kurikee putakanaya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nuwsha, ngutparina wanasir taakina.","poem":1},{"lineBreak":true},{"text":"Mangi yaram taaktaati, itaru ichinguru zari Apanll nuwaa waneekpaz ashku,","poem":1},{"lineBreak":true},{"text":"kiyung kachiykuri taakinawa, átssincha tputsi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Itaru, nuwsha anumashee chinarangeezi.","poem":1},{"lineBreak":true},{"text":"Anumashee tsiyataranginaareena ashiru,","poem":1},{"lineBreak":true},{"text":"Apanllee tiptsir tayutaritaranginaaparina.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Nuw nda tsiyatarangtaati, itaru mangishi chinaranguri,","poem":1},{"lineBreak":true},{"text":"¿Tamari yashingchich kis taakana? táranguri, yasamaam zandaranguri, xapoorangina.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Minush zari shiyash pangish, Apaa, pshturanguri, shiysha mangeetsi mangoonamaam p'tseerangsha.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yashingchich kurikpaneew sambarchimunpaz ashirusin naakanaya.","poem":1},{"lineBreak":true},{"text":"Yuwash nda chinarana anush,","poem":1},{"lineBreak":true},{"text":"shiysha Apaa, tununukpaz ashkachush wazawush pantsachinllinaya.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ayamtaati nda kis taachinllinaya.","poem":1},{"lineBreak":true},{"text":"Napuxtayarusin, sitatstee táchapsinaya.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Taárashee tputs pamazukpaz ashku musásiri pastachinllinaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Apaa, nuw nduma mangoonchuri, mangishi kapung tsiyantarangina.","poem":1},{"lineBreak":true},{"text":"Nuw wanipa yutarit chinarangi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mangshari ashirangina. Nda mangoonarangina.","poem":1},{"lineBreak":true},{"text":"Manginshuch ashiruri, nda mangoonkuri tárangina.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Itaru Apaa, yutarit chinarangitaati,","poem":1},{"lineBreak":true},{"text":"shiysha kuwiptish nuwaa mbam patsisakush, nda kasaksha.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Shiyash itsinsaru tachitamaam nuwaa mangi p'tseeksha,","poem":1},{"lineBreak":true},{"text":"Shiyash kuskachuri, shiysha nuwaa mangish ksaptari, Naani, táchsha.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kanindap shiyangzimari nuw kusamaam zandkina.","poem":1},{"lineBreak":true},{"text":"Nuw shiyapa ipuneeruri taakuri,","poem":1},{"lineBreak":true},{"text":"¿mayangazeeja nuw nish tsapurunasush tamarachee?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nuw nutsi mizpurishtaati,","poem":1},{"lineBreak":true},{"text":"itaru shiysha Apaa, nuwaa nda kasakush arang tuwizpurtaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Itaru, yuwaatssha tputs shiyaa tuwanlltakana, anoo","poem":1},{"lineBreak":true},{"text":"shiysha tpachingayarush kasachsha.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Itaru, nuwsha shiyaa nda kasakina.","poem":1},{"lineBreak":true},{"text":"Nuw shiyangzimari ipunamaam chinakina.","poem":1},{"lineBreak":true},{"text":"Shiyamunari Apaa, kamungkina.","poem":1},{"lineBreak":true},{"text":"Tputsee kamankuri ¿Wanip nuwaa Apari istaka? táchina.","poem":1},{"lineBreak":true},"Ashiri, Apaa, wapparee."]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":26}