{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":8,"content":[{"type":"heading","content":["Apanll tputsee tsapurunasee ksutamapaneem wayarangu, anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Dapiyarini wayasee. Yandayaru, yasimpaneem panarangiya, kitarpata yasimaama."]},{"type":"verse","number":1,"content":[{"text":"Apaa, shiyamari ichingarootsini kasirush taaksha.","poem":1},{"lineBreak":true},{"text":"Shiyaa taarashipaneetsish, tputs ztaru wizpurireetsish pakanaya.","poem":1},{"lineBreak":true},{"text":"Kanindaatstaa arang kasiru taaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tputs tsapurunasshuch shiyaa natsaktaatssin,","poem":1},{"lineBreak":true},{"text":"itaru nllursha, kanxutaa shiyaa kis yaseeksin, zamangakchusin,","poem":1},{"lineBreak":true},{"text":"kundararshitish anoo mazinakchusin, paziksin","poem":1},{"lineBreak":true},{"text":"zamakanaya.","poem":1},{"noteId":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Apaa, yuwaa shaana tinarangish, anoo psaan kanindap napkuri,","poem":1},{"lineBreak":true},{"text":"tsupeetstam, tsangacheetstam pakuri, napuxtakina.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ichingaroo pakuri, mangishi Apaa chinakina,","poem":1},{"lineBreak":true},{"text":"¿Mayaama iy tputsini taakanee? atina.","poem":1},{"lineBreak":true},{"text":"¿Mayaamsha shiy iyaa tputseetsini chinaksha?","poem":1},{"lineBreak":true},{"text":"¿Mayaamsha iyapa mapeerush taaksha?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Shiy iyaa tputseetsini tinarangush, shaana tamapari ashtamartam iyaa tinarangsha.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tínamareetsish ichingaru kasiru iyaatsimari wayarangsha.","poem":1},{"lineBreak":true},{"text":"Ksutamapaneemtam iyaatssha wayarangsha.","poem":1},{"noteId":5},{"lineBreak":true},{"text":"Sheerush iyaatssha tputseetsini kamachtakush tárangsha:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Siysa opeejaa, wakaraatstam, mishat manginshucheetstam,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"íwar mangataru anootstam,","poem":1},{"lineBreak":true},{"text":"mishat kayupcheetstam, maachi ichinguru kungush taataru anootstam siyamari kasirus taatssa, tárangsha Apaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Itaru Apaa, shiyamarisha ichingarootsini kasirush taaksha.","poem":1},{"lineBreak":true},{"text":"Shiyaa taarashipaneetsish wizpurireetsish tputs ztaru pakanaya.","poem":1},{"lineBreak":true},"Dapiyarini wayas átu yandarangiya."]}],"footnotes":[{"noteId":4,"caller":"*","text":"Yuwaa nish átu anootstam Matiwa 21.16 tayusima kamankiya.","reference":{"chapter":8,"verse":2}},{"noteId":5,"caller":"*","text":"Yuwaa nish átu anootstam Utaáshucheema 2.6-8 tayusima kamankiya.","reference":{"chapter":8,"verse":6}}]},"thisChapterLink":"/api/cbu_wbt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}