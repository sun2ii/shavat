{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":80,"content":[{"type":"heading","content":["Yuwapur Asiriyashchi tputs Israelchichee kasiyarusin, zapan waanpee watsapun muchchureem machtarangana, anpur Asafarinchich tputs kapung mang' mantsarangu, nee yaseesshee yandarangiya"]},{"type":"hebrew_subtitle","content":["Asafarinchich tputs yandamarini; yuw Apanllish pang' Irusarinush yasimpan taarangu, anoo."]},{"type":"verse","number":1,"content":[{"text":"Apaa, shiyamari Osiyarinchichee ksutarangsha.","poem":1},{"lineBreak":true},{"text":"Opeejaa ksutamapan tamapari ashirush machtarangsha.","poem":1},{"lineBreak":true},{"text":"Shiy kanindush kurakish kuxinshishimunish kuxineerush,","poem":1},{"lineBreak":true},{"text":"sundarurish shiyaa ksutkanaya.","poem":1},{"lineBreak":true},{"text":"Ashiri Apaa, iyaa k'kini mazinangcha.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iyashchee tputs, Osiyarin nlluranuri Efrayinchichee, Manaseschicheetstam wanasiri napangcha, Apaa.","poem":1},{"lineBreak":true},{"text":"Mishat Benjaminchicheetstam wanasiritam napangcha.","poem":1},{"lineBreak":true},{"text":"¡Támangi, Apaa! Wizpurpatatish tputsee tapachindangcha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Apaa, yusur iyaa ichingarootsini wanasir taamaam wayangcha.","poem":2},{"lineBreak":true},{"text":"Iyaa wanasiri napkush, tapachindangcha, atiniya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Apaa, shiy kizpurtishcha.","poem":1},{"lineBreak":true},{"text":"Shiyamari kasirush taaksha.","poem":1},{"lineBreak":true},{"text":"¿Ashiri mayaamsha tputsireetsish nda istaksha?","poem":1},{"lineBreak":true},{"text":"Iy shiyaa, Istapanda atuni, mashkuni,","poem":1},{"lineBreak":true},{"text":"itaru shiysha tsiyantakush nda iyaa istaksha.","poem":1},{"lineBreak":true},{"text":"¿Ashinooja tsiyanis zambazachish?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Iyaa kapung kiyung yacharangush,","poem":1},{"lineBreak":true},{"text":"nda katungkuni, nduntam waakuni,","poem":1},{"lineBreak":true},{"text":"ichingaru zar tanukuni taakiniya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Minshuch tputs iyanung watsiri taakana,","poem":1},{"lineBreak":true},{"text":"anin iyaa tsapunee itutsimaam zandkanaya.","poem":1},{"lineBreak":true},{"text":"Kundararini iyaa kasirangusin, iyaa stakanaya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Apaa, shiyamari kasirush taaksha.","poem":1},{"lineBreak":true},{"text":"Yusur iyaa wanasir taamaam wayangcha.","poem":1},{"lineBreak":true},{"text":"Iyaa chinakush tapachindangcha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Iyaa zitaminarineetsini Ijiptomand tsap kizarunaatspaz ashirush,","poem":1},{"noteId":48},{"text":"xpuyarush, nish Kanaanushsha tsap yushindarangsha.","poem":1},{"lineBreak":true},{"text":"Kanaanshuchee tputsee kasirangush, tpachingarangsha.","poem":1},{"lineBreak":true},{"text":"Sheerush iyashcheetssha kizarunaatspaz ashirush anush tsap tatsumirangsha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Karutaatssha wanasir puyakpaz,","poem":1},{"lineBreak":true},{"text":"sheerush, kizarunsha zapan kxunarangiya.","poem":1},{"lineBreak":true},{"text":"Izuuru ashchiri tsapoo tatsitarangiya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Macheetstam íwar izuuru ashchiri yambutarangu,","poem":1},{"lineBreak":true},{"text":"wapzar zapan pzeeneeru, wanasinarsha wazurantam kanungarangiya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Zapan izapaneerangu, marshutam kusaranganaya.","poem":1},{"lineBreak":true},{"text":"Mishat, kung Eufratisshutam kusaranganaya.","poem":1},{"lineBreak":true},{"text":"Iyashcheetssha tputs ashikpaz ashirush iyaa izapaneerangsha.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"¿Ashiri natsha mayaamsha tandapunuzeetspaz ashiru tunuparangush, iyaa nda wanasir ksutaksha?","poem":1},{"lineBreak":true},{"text":"Tputs iyaa kiyung yachakanaya.","poem":1},{"lineBreak":true},{"text":"Na tputs ngootsip naakchusin,","poem":1},{"lineBreak":true},{"text":"kizarunaa wanus pusayarusin, kapeeta kapeeta ashkanaya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mishat, manginshuch kazum, kázamzitam","poem":1},{"text":"kizarunapaz wanus ashirusin katungkusin, iyaa kiyung yachaksin taakanaya.","poem":2},{"text":"Wapzareetspaz ashirusin iyashchee ichip ichip ashkusin pamuxakaniya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Apaa, shiy kizpurtishcha.","poem":1},{"lineBreak":true},{"text":"¿Mayaamsha nda iyaa nayaniksha?","poem":1},{"lineBreak":true},{"text":"Apaa, tputsireetsish kanindamandari napangcha.","poem":1},{"lineBreak":true},{"text":"Iyaatssha kizarunareetspazish ashiru yusur ksutangcha.","poem":1},{"lineBreak":true},{"text":"Izuuru wanasir iyaa napangcha.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Watam shaana tatsumarangshawa.","poem":1},{"lineBreak":true},{"text":"Shiy iyaa nish yushindarangush, tatsumikpaz ashirangush kis ksutarangsha.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Itaru, kundararini tzayarusin, tirooranganaya.","poem":1},{"lineBreak":true},{"text":"Ashiri, Apaa, shiysha kundarareetsini tpachingayarush ksangcha.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Itaru, tputsireetsinaarish, yuwaa kapung chinakish ipusirangish,","poem":1},{"lineBreak":true},{"text":"anootsinaa tuwizpurtangcha.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ashkachush, iysha ayamtaatiyam shiyaa kasacheezini.","poem":1},{"lineBreak":true},{"text":"Taarasheemani kaneesich iyaam panangcha.","poem":1},{"lineBreak":true},{"text":"Ashkachush, iysha Apaa, yusur shiyaatsimari tsiyatkuni taachinipa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Apaa, yusur iyaa wanasir taamaam wayangcha.","poem":2},{"lineBreak":true},{"text":"Iyaa chinakush tapachindangcha.","poem":2}]}],"footnotes":[{"noteId":48,"caller":"*","text":"Matiwa 21.33-43; Wanga 15.1-6 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":80,"verse":8}}]},"thisChapterLink":"/api/cbu_wbt/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":19}