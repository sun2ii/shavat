{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":84,"content":[{"type":"heading","content":["Apanllpan tputs, Apanllip pang' naamaam pinasarangu kapung naamaam támaraku, anoo kamankiya."]},{"type":"hebrew_subtitle","content":["Koréchich tputs wayasi. Yasinpaneem Apanllish pang' yasimaam yandarangiya."]},{"type":"verse","number":1,"content":[{"text":"Apaa, shiy kizpurtishcha.","poem":1},{"lineBreak":true},{"text":"¿Tamara shiy pangish wanasiree?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuw shiyash pangish tipuranllizshumari napamaam kapung támarakina.","poem":1},{"lineBreak":true},{"text":"Pshtuyaruri, mangi ksakuri shiyaa ungirtakuri yaseekina, Apaa Taarashipani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tsiripchitaa shiyash pangish mapiyru kis taakanaya.","poem":1},{"lineBreak":true},{"text":"Suminungish mapiyrsin ngichtakanaya.","poem":1},{"lineBreak":true},{"text":"Zangatatam ixateersin, anushsha iparinayarusin, kis taakanaya.","poem":1},{"lineBreak":true},{"text":"Ashiri nuwsha tsiripich ashiritam ashingasinda aturi, támarakina.","poem":1},{"lineBreak":true},{"text":"Apaa, nuwcha shiyaa kurakari.","poem":1},{"lineBreak":true},{"text":"Shiy tsapurunasee kanindaatstam shiyamari kasiru taaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tputs shiyash pangish taaksin, mang' kis taakanaya.","poem":1},{"lineBreak":true},{"text":"Shiyaa uru yasiyastar ashkusin, ungirtakanaya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tputsirish shiyamun mang' kis taakanaya.","poem":1},{"lineBreak":true},{"text":"Ashiri shiysha tuwizpurtangcha.","poem":1},{"lineBreak":true},{"text":"Uru mang' kis, Apanllip pang' naapani, atusin,","poem":1},{"lineBreak":true},{"text":"shiyap pangish, machip Siyonap naakanaya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Naakchusin, tsap sur Tanushinung tushiykchusin,","poem":1},{"lineBreak":true},{"text":"shiysha istakush, nda sambaytakanaya.","poem":1},{"lineBreak":true},{"text":"Sin sinakchu, tsapoo kachachtakchu,","poem":1},{"lineBreak":true},{"text":"kissha aranginasha naakanaya.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ashiri mang' ksaptari nda sambaytakusin,","poem":1},{"lineBreak":true},{"text":"shiyap pangish machip kárkanaya.","poem":1},{"lineBreak":true},{"text":"Siyonash kuseersin, shiyash pshtukanaya.","poem":1},{"lineBreak":true},{"text":"Shiy kizpurtishcha Apaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Apaa Taarashipani, shiyamari kasiru taaksha.","poem":1},{"lineBreak":true},{"text":"Iy Israelchichini shiyaa Apanllirtanicha.","poem":1},{"lineBreak":true},{"text":"Ashiriya, nuw shiyaa mashki anoo mazinangcha.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apaa, shiy iyaa kurakarini ipusarangush,","poem":1},{"lineBreak":true},{"text":"wanasiri napangcha. Ksutangcha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Shiyash pangish pshtumaam kizpurcha wanasiri.","poem":1},{"lineBreak":true},{"text":"Zapantaa zari arap taakuri nda mapiykina.","poem":1},{"lineBreak":true},{"text":"Itaru, shiyash pangish minamaritaatiya zar taakuri, mapiyruri kis taakina.","poem":1},{"lineBreak":true},{"text":"Mangi kis mapiyruri taachina.","poem":1},{"lineBreak":true},{"text":"M'chachtaati, shiyash pangish tuchinamapan taakuri,","poem":1},{"lineBreak":true},{"text":"kisshapari taachina.","poem":1},{"lineBreak":true},{"text":"Itaru, tputs yutaritshishpanpa taakuri,","poem":1},{"lineBreak":true},{"text":"¿antaati ksaja taachi?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Shiy Apaa Taarashipani,","poem":1},{"lineBreak":true},{"text":"zar tamapari ashiru iyaa tuwasineekush, iyaa ksutaksha.","poem":1},{"lineBreak":true},{"text":"Yuw tputs itsinsaru taaku, anoo kapung chinakush,","poem":1},{"lineBreak":true},{"text":"shaanshu pangish tapshtukush,","poem":1},{"lineBreak":true},{"text":"Uru wanasiri ksutaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Apaa, shiyamari kasiksha.","poem":1},{"lineBreak":true},{"text":"Tsapurunaseetstam, kanindaatstam ichinguru kasiru taaksha.","poem":1},{"lineBreak":true},{"text":"Shiy tputsirish shiyamun mang' tatkusin, mang' kis taakanaya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":12}