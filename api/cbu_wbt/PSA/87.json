"lineBreak":true},{"text":"Apanllsha tsapurunasshuchee napkachu;","poem":1},{"lineBreak":true},{"text":"Ijiptshuch tputs, Mishat Babiloniyashuchtam, Filistewshuchtam, Tírshuchtam, Etiyopshuchtam","poem":1},{"lineBreak":true},{"text":"anshuch tputs zapan nuwamun nllurtarangana.","poem":1},{"lineBreak":true},{"text":"Ashiri nuwsha, Irusarinshuchtam tputsee, táchima.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tputs ztaru nuwaa mangoonkusin,","poem":1},{"lineBreak":true},{"text":"nuwsha, Irusarinshuch tputsi, táchima, tárangiya Apanlli.","poem":1},{"lineBreak":true},{"text":"Apanll waana yaktarinish tiptsirpata urutamari kizpur taachiya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tiptsiree sur kirakamun yandakchu;","poem":1},{"lineBreak":true},{"text":"Nee nuwamun nllurtarangu,","poem":1},{"lineBreak":true},{"text":"ashiri Irusarinshuch tputsi, yandayaru táchiya.","poem":1},{"noteId":49}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sheeru Irusarinush ichingarusin, mang kis yaseeksin, michitkusin,","poem":1},{"lineBreak":true},{"text":"Apanllimun nllurtaranguni Irusarinshuchtanicha tputsini, yaseeksin táchinllinaya.","poem":1}]}],"footnotes":[{"noteId":49,"caller":"*","text":"Lukasa 2.1-3 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":87,"verse":6}}]},"thisChapterLink":"/api/cbu_wbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":7}