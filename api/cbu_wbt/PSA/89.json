{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":89,"content":[{"type":"heading","content":["Apanll Dapiyarinpa amikurtarangu, Urutamari shiyaa nlluranureetsish kizpur kuraktam wayachima, tárangu, itaru nlluranursha kapung yutarit taarangsin, Apanllsha istamaam ngatarangu, anoo kamankiya"]},{"type":"hebrew_subtitle","content":["Apanllpan, Etána, Esrachich tputs, yandamarini."]},{"type":"verse","number":1,"content":[{"text":"Apanllee nuw uru yaseekuri, Shiy Apaa, nayanimpantishcha.","poem":1},{"lineBreak":true},{"text":"Shiy k'keetsish minamari payuksha;","poem":1},{"lineBreak":true},{"text":"nda ayamamtiyam kapeetaksha.","poem":1},{"lineBreak":true},{"text":"Ashirucha, nuwsha uru yaseekuri tputsee anoo kamanimantar ashkina.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apaa, nuw tputsee kamankuri, Apanll chínash ayamtaatiya pastacheeja, atina.","poem":1},{"lineBreak":true},{"text":"Apanll waanaatsi kuk urutamari payukiya.","poem":1},{"lineBreak":true},{"text":"Apanlli kuk kanind tamaparee ashiru urutamari taachiya, atina.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Apaa, sirútama shiy minam mangooz chinayarush, Dapiyarineetsi wanasir tsiyatarangsha.","poem":1},{"lineBreak":true},{"text":"Tsiyatarangush amikurtarangsha.","poem":1},{"lineBreak":true},{"text":"Shiy Dapiyarineetsi tsiyatarangush;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Shiyachich nlluranur uru kushimunish kurakaam kinataranllu taachinlliniya,","poem":1},{"noteId":50},{"text":"tárangsha Apaa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apaa, shiy sundarurish shiyaa ungirtaksin; Apanll uru waanaatsee kuk payukiya. Apanlleem xapoomaam wanindaja, atanaya shiyaatsee.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Apaa, ¿Antaati apanllputs minamtiyam shiyapa waritarazinllinaja?","poem":1},{"lineBreak":true},{"text":"Arutamatam ¿antaati shiyapa tatsamooreeja?","poem":1},{"lineBreak":true},{"text":"Nduni, wanindaja.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Shiyamari kapung kasirush kizpur taaksha Kanindpich sundarurish ztaru anu shiyaa taturpiranaya.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Shiy kizpurtishcha kurakish.","poem":1},{"lineBreak":true},{"text":"Wizpurireetsish shaana payuksha.","poem":1},{"lineBreak":true},{"text":"Shiyamari itsinsaru tsiyataksha.","poem":1},{"lineBreak":true},{"text":"Nish tsapurunasish ¿yapeeja ashima pangchich?","poem":1},{"lineBreak":true},{"text":"Shiyapa tatsamooru wanindaja.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Shiyamari kasiksha.","poem":1},{"lineBreak":true},{"text":"Mus kapungumash mar warastakachu, anoo shiysha wizpurirpatish tuzanaksha.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Shiyamari kungushchee watarimashee kapunguwaa kamiran kasiksha.","poem":1},{"lineBreak":true},{"text":"Maachee tsipama ashiru kamiran kachingaksha.","poem":1},{"lineBreak":true},{"text":"Wizpurirpatish kundarareetstamtish kasiksha.","poem":1},{"lineBreak":true},{"text":"Tusuwambeerush, arap kapeetambayarush, kasaksha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kanindaatstam, misha tsapurunaseetstam shaana urutamari taamaam tinarangsha.","poem":1},{"noteId":51},{"lineBreak":true},{"text":"Tsapurunasee tinarangush ichingaru maacheetsi tinayarush wayarangsha.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Shiyamari ichingaru ashpiri tsapurunasee tinarangsha.","poem":1},{"lineBreak":true},{"text":"Macheetstam íwar tinarangush, mach Taborshuchtam, mach Hebronshuchtam tinarangush,","poem":1},{"lineBreak":true},{"text":"mang' kis shiyamun shambatkusin; Apanll kizpurcha wanasir, atanaya.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Apaa, pachtamishish wizpurish kapung taariya.","poem":1},{"lineBreak":true},{"text":"Kuwish mbutsinungich wizpurirpatish shiyamari kasiksha.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Shiy kurakarush, shaana tputsee mangoo yasayarush, wanasiri wayaksha.","poem":1},{"lineBreak":true},{"text":"Misha, urutamari kurak wanasirimash watsinas taaksha.","poem":1},{"lineBreak":true},{"text":"Uru iyaa tputseetsini chinaksha, iyaa nda kasaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ashiri Apaa,","poem":1},{"lineBreak":true},{"text":"Tputs shiyaa kis shambatkusin, ungirtaksin, uru mang' kis taakanaya.","poem":1},{"lineBreak":true},{"text":"Shiyash nungish tachitkusin, 'sinish kis taakanaya.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Shiyamunatam mang' ksakanaya.","poem":1},{"lineBreak":true},{"text":"Watam shiyamari itsinsaru tputsee yasakush itsinsaru tsiyatakshawa.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Apaa, Iy tputsini shiyamun wizpurirish kchitaruni wanasir taakaniya.","poem":1},{"lineBreak":true},{"text":"Shaana zandkush, iyaam wizpureetsish aranginasha panaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Shiy wizpurirpatish xanxapishpapaz ashiru iyaa kámanaksha.","poem":2},{"lineBreak":true},{"text":"Iysha Israelchichini Apanllee iycha kurakarini. Kizpur wanasircha, atiniya.","poem":2},{"lineBreak":true},{"text":"Ashiri, Apaa, mazinangcha:","poem":1}]},{"type":"verse","number":19,"content":[{"text":"Apaa, sirútama shiysha miranish tputsireetsish tsiyatarangush,","poem":1},{"lineBreak":true},{"text":"Nuwsha tputsee, yuw nda puniku anu, kurakaam ipusarangina.","poem":1},{"lineBreak":true},{"text":"Kizpur putit nda puniku, anoo ipusaranguri istarangina.","poem":1},{"lineBreak":true},{"text":"Tputs sur Dapiyaa. Nuwtanda tputsiri. Ashiri nuwsha Israelchichee ksutamaam wayarangina,","poem":1},{"lineBreak":true},{"text":"Wamari kasiru tsapurunasshuchee kánuru taachiya,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nuw Dapiyaa wayungunpa wanasirimashpa tapararanguri,","poem":1},{"lineBreak":true},{"text":"Israelchicheem ksutamaam kurakaam ínarangina.","poem":1},{"noteId":52}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ayamtaati Dapiyaa istamaam mbizcheezi.","poem":1},{"lineBreak":true},{"text":"Nuwaanpata wizpuriri tuwizpurtataw ashkuri kizpur taachiya,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Undararshitisin, Kasiyani, tusin, pinasachinllinaya.","poem":1},{"lineBreak":true},{"text":"Natsampansha tputs kasichazinllinaja.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Nuwsha Dapiyaa undararee wizpurirpati kátimbayaruri kasachima.","poem":1},{"lineBreak":true},{"text":"Ayamtaati Dapiya undarareetsi yusur pangcheeja.","poem":1},{"lineBreak":true},{"text":"Undararee zurampatari kachingeeruri, kasachima.","poem":1},{"lineBreak":true},{"text":"shiy shaana Dapiyaatsee tárangsha Apaa. Mishat Apaa, shiy Dapiyarineetsi tárangitamtish","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Nuw urutari Dapiyaa chinakuri, uwsha nuwamun mang' tatchiya.","poem":1},{"lineBreak":true},{"text":"Nuwamunatam wizpuriri aranginasha wizpur kapung taachiya.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Dapiy wamari tputsee kasikchu,","poem":1},{"lineBreak":true},{"text":"ashchiri Mediterranewshucheetstam, misha Eufratisshucheetstam shuneerusin kasichiya.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Dapiya nuwapat tsiyatku. Apaa, shiyaa nuwcha Apari.","poem":1},{"lineBreak":true},{"text":"Mishat, shiyaa nuwcha Apanlliri.","poem":1},{"lineBreak":true},{"text":"Watam nuwaa tapachindakush, ksutakshawa, Dapiya nuwaa táchiya.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nuwaa tákchu, nuwsha Dapiyaa, ipareetspazi iwachiztamaa ashiruri aranginasha istachima.","poem":1},{"lineBreak":true},{"text":"Tsapurunasshuchee kurak wamari kasichiya.","poem":1},{"noteId":53}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Nuw nuwaana Dapiyaa kapung kasiru chinakuri,","poem":1},{"lineBreak":true},{"text":"yuwaa nuw Dapiyaa tárangi anu urutamari taachiya.","poem":1},{"lineBreak":true},{"text":"Nllitaritaa chinacheezi, shiysha Apaa Dapiyaa tárangsha, Mishat Apaa, shiy Dapiyaa wachinllinootsi tárangitamtish,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Dapiyaa wachinllinur tputs pzapaneekchusin,","poem":1},{"lineBreak":true},{"text":"kanind nduma pastachu, uru kurakaamtam kinachinlliniya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Itaru, uwshtisin nuwaa kuki kapeetkinaareesinaya,","poem":1},{"lineBreak":true},{"text":"yuw nuw kamachtarangi, anoo nda ambi ashirusin taaksin, nuwsha wanichima.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Wandaya nuwaa kuki nda payuksin,","poem":1},{"lineBreak":true},{"text":"kamachtamareetsi kapeetkusin,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"waneeshshipasha wanichima.","poem":1},{"lineBreak":true},{"text":"Anumandtam pzkooshishpa pzkookpaz ashtachima.","poem":1},{"noteId":54}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Ashiritaati, ayamtaati Dapiychichee tputs kasacheezi.","poem":1},{"lineBreak":true},{"text":"Chinakuri, urutamari uwapa taarataraw ashtachina.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Nuwaanaatsi kuki kapeetcheezi.","poem":1},{"lineBreak":true},{"text":"Urutamari payuchima.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Nuw kuki ayamamtiyam pastacheeja, tárangi, an zurampataricha tárangi.","poem":1},{"lineBreak":true},{"text":"Nuwaanamuntari suri tárangina. Nuwaanaatsi ngichcheezi.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Ndatuma sitarunas pastachu,","poem":1},{"lineBreak":true},{"text":"Dapiychichtisin tputs kurakawtam taachinlliniya.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ndatuma kanind íwari pastachu,","poem":1},{"lineBreak":true},{"text":"tsup tamatarparee ashiru urutamari taachinllinaya, shiy Apaa, shaana tárangshawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Itaru Apaa, shiy ambtaa tárangush,","poem":1},{"lineBreak":true},{"text":"ashiritaa Dapiyarinchichee nlluranur kasarangsha. Kushtarangsha.","poem":1},{"lineBreak":true},{"text":"Tayutaritarangsha. Shaantataa kurakaam ipusarangush,","poem":1},{"lineBreak":true},{"text":"ashiritaa shiy tsiyantarangush, na kapeetarangsha.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Yuwaa sirú Dapiyaa tárangish anoo kapeetarangsha.","poem":1},{"lineBreak":true},{"text":"Dapiyarinchichee nlluranur ngatarangush, na zurampatari kasarangsha.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Shiysha Undarareetsi zanganirangush Utaáchchee yaktarini ichingaroo kapeetaranganaya.","poem":1},{"lineBreak":true},{"text":"Watandpunoo pátang, pátang, tawata, tawata ashimbaranganaya.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Watam shaana tputsireetsish kanasarangshawa.","poem":1},{"lineBreak":true},{"text":"Minshuchtisin tputs anoo parangusin,","poem":1},{"lineBreak":true},{"text":"yaktash pshtuyarusin, maacheetsi shuchiranganaya.","poem":1},{"lineBreak":true},{"text":"Sheeru iyashcheetsi napeersin staranganaya.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Shiy iyaa kasarangush, kundararshitini iyaa kasirangusin, mang' ksaksin; Iyamari kasiyani, atusin,","poem":1},{"lineBreak":true},{"text":"uw paxayarusin shambatkanaya.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Shiy Dapiyarinee machtari itutsirangush, tamuramach ashirangu,","poem":1},{"lineBreak":true},{"text":"ndusha tapazish iyaa tapachindarangiya.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Dapiyarini pangusee, maacheetstam zapan wanasiri wayarangu,","poem":1},{"lineBreak":true},{"text":"itaru ichingaroo shiysha Apaa, tayutaritarangsha.","poem":1},{"lineBreak":true},{"text":"Dapiyarineetsi wizpuririni, izuuru tsapush kapeetarangsha.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Mishat, shiy iyaa musásiri tsipatsiptamaam wayarangitamsha.","poem":1},{"lineBreak":true},{"text":"Iyachchee kapungsha ipazarangsha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Apaa, nuwaa mazinangandama.","poem":1},{"lineBreak":true},{"text":"¿Ashinooja Apaa, yusur iyaa kis napchish?","poem":1},{"lineBreak":true},{"text":"Tsiyanish musákchush, kapung tashish ksaneekpaz ashichsha.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Apaa, nuw taarashi pakichcha; tsipasa.","poem":1},{"lineBreak":true},{"text":"Nuw tputstana.","poem":1},{"lineBreak":true},{"text":"Shaana iyaa tputseetsini tinarangush, nish tsapurunasish ningat masach taachini.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"¿Chakaja nda tsipach?","poem":1},{"lineBreak":true},{"text":"Ichingarupariniya tsipachiniya.","poem":1},{"lineBreak":true},{"text":"Tputs waanaatsi watsipun tapachindamaam wanindaja.","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"¡Apaa! chtakchuri shiy Dapiyarinee chinarangush, tsiyatarangush: Ayamtaati shiyashchee kasacheezi, tárangsha. Ashiri ¿tamasha natsha Dapiyarinchichee nlluranur istamaam ngataksha?","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Apaa, napangasindaniya. Tputs wanip shiyaa tputsirish natsakanaya.","poem":1},{"lineBreak":true},{"text":"Nda achim kamaskanaya; stakanaya iyaatsi.","poem":1},{"lineBreak":true},{"text":"Nuwsha tsiyani tanukuri, zansimun tsipamaam waritakina.","poem":1},{"lineBreak":true},{"text":"¡Apaa, iyaa nayaningcha!","poem":1}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"Apaa, nuwaa mazinangandama. ¡Iyaa kundararini mundakanaya!","poem":1},{"lineBreak":true},{"text":"¡Kukush mantsir tsiyatkusin, shiyaa ipusamarinish ichinguru zar natsakanaya!","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Ashtaa Apaa, shiyamari kurakish kasirush, na wandari kizpur kurak taaksha.","poem":2},{"lineBreak":true},"Apaa, wapparee."]}],"footnotes":[{"noteId":50,"caller":"*","text":"Yuwaa nish átu anootstam Tayaspatampani 2.30 tayusima kamankiya.","reference":{"chapter":89,"verse":4}},{"noteId":51,"caller":"*","text":"1 Koríndshucheema 10.26 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":89,"verse":11}},{"noteId":52,"caller":"*","text":"Tayaspatampani 13.22 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":89,"verse":20}},{"noteId":53,"caller":"*","text":"Apanll wanichu anu 1.5 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":89,"verse":27}},{"noteId":54,"caller":"*","text":"Utaáshucheema 12.5-11 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":89,"verse":32}}]},"thisChapterLink":"/api/cbu_wbt/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":52}