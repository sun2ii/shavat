{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":91,"content":[{"type":"heading","content":["Iy kurakarini kchinamishcha; misha nayanimpancha"]},{"type":"verse","number":1,"content":[{"text":"Iy Apanllirini waamari kasiru kizpur taariya.","poem":1},{"lineBreak":true},{"text":"Ashiri yuw tputs Apanllimun mang' tatku,","poem":1},{"lineBreak":true},{"text":"anoo Apanllsha uru kámanaku ksutkiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ashiri uwsha Apanllee tsiyatku;","poem":1},{"lineBreak":true},{"text":"Apaa, shiyamari nuwaa ksutaksha.","poem":1},{"lineBreak":true},{"text":"Nuwaa tapachindaksha.","poem":1},{"lineBreak":true},{"text":"Ashiri Apaa, nuwsha shiyashumari kamunguri taakina.","poem":1},{"lineBreak":true},{"text":"Watam shiyamunari mangi tatkuri taakinawa, táchiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ashiri siy, Apanllis tiptsiris nuwaa kuki mazinangtsa.","poem":1},{"lineBreak":true},{"text":"Yashing siyash tsutashish tsipatsimash wayaktaatiya,","poem":1},{"lineBreak":true},{"text":"Itaru, Apanllimari siyaa tapachindamaam waritariya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wazitpungachpapaz ashiru siyaa kámananaw ashku, siysa punicheezis, ndambari.","poem":1},{"lineBreak":true},{"text":"Siyaa uru istachintspa, tárangu, waanaatsee kuk kapeetcheeja, ndambaree.","poem":1},{"lineBreak":true},{"text":"Xanxapishpapaz ashiru siyaa imanta imanta ashku, kámanaku tapachindakiya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Psaantaatiya naakchus, tunimshutaatiya, ¿antaati siy kanizee punicheezis? ndambaree.","poem":1},{"lineBreak":true},{"text":"Kaschiritam kundarareetsish punichtamtazis.","poem":1},{"lineBreak":true},{"text":"Xarasheetstam punichtamtazis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Zapantaa tputs siyanung tsipatsiptar ashkusin,","poem":1},{"lineBreak":true},{"text":"itaru siysa matambshis taatssa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Apanll tputsee mantsirimshee waanamandari chayarini waneekchu,","poem":1},{"lineBreak":true},{"text":"anoo siysa kchiptis pangatssa.","poem":1},{"lineBreak":true},{"text":"Itaru, siyaa nda wanichiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Yuwamand siy Apanllimunari mangis taturangis,","poem":1},{"lineBreak":true},{"text":"anumand Apanll siyaa ksutchiya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Maachi yutamash siyash kusamaam pinasachiya.","poem":1},{"lineBreak":true},{"text":"Wanguytam tsutashish siyash pangis tsutacheeja, ndambari.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Watam Apanllsha waana wasundururee siyaa ksutamaam zangankuwa.","poem":1},{"lineBreak":true},{"text":"Yaptaa naakis ambtaa wasundurursha uru siyaa ksutchiya.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Uwpat siyaa pazurangpaz ashtachiya,","poem":1},{"lineBreak":true},{"text":"nda siy patumbchimun pazis tpuu ashimaama.","poem":1},{"noteId":57}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kázamshiptaati, isariyap, mkaptam naakinaareesa,","poem":1},{"lineBreak":true},{"text":"Apanllsha siyaa wanasir naamaam istachiya.","poem":1},{"noteId":58}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Apanll átcha; Siy nuwaa mangoonkus, nuwaa chinakus,","poem":1},{"lineBreak":true},{"text":"nuwsha siyaa tapachindachintspa.","poem":1},{"lineBreak":true},{"text":"Ashiri yutamashi siyaa kasicheeja.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nuwaa mashkus, nuwsha uru yámchintspa.","poem":1},{"lineBreak":true},{"text":"Nuwaana siyapa washunand taachima.","poem":1},{"lineBreak":true},{"text":"Mangis kapung mantsakus, mangeetsis tuwizpurtachintspa.","poem":1},{"lineBreak":true},{"text":"Tputssha siyaa yasaksin, Apanll waa kapung chinaku istakiya, táchinllinaya.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Zapantam masach taamaam wayachintspa.","poem":1},{"lineBreak":true},{"text":"Sheeruri, izuuru nuwaanpee machchintspa, Apanll tárangcha, nuw siyaa atina.","poem":1}]}],"footnotes":[{"noteId":57,"caller":"*","text":"Yuwaa nish átu anootstam Matiwa 4.6, misha Lukasa 4.10-11 kamankiya.","reference":{"chapter":91,"verse":12}},{"noteId":58,"caller":"*","text":"Lukasa 10.19 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":91,"verse":13}}]},"thisChapterLink":"/api/cbu_wbt/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":15}