{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":93,"content":[{"type":"heading","content":["Apanll wamari kasiru taakiya"]},{"type":"verse","number":1,"content":[{"text":"Apanll Taarashipan waamari kasiru taakiya.","poem":1},{"lineBreak":true},{"text":"Kizpur wamar kurakurtaru, 'sinish taakiya.","poem":1},{"lineBreak":true},{"text":"Wizpur wamari kasiriya.","poem":1},{"lineBreak":true},{"text":"Tsapurunasee tinarangu,","poem":1},{"lineBreak":true},{"text":"nda zpuzamaam mbam wayayaru kasarangiya.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ashirucha, atashiniya;","poem":1},{"lineBreak":true},{"text":"Apaa, shiy tsapurunasee wayarangush, urutamari ksutaksha.","poem":1},{"lineBreak":true},{"text":"Shiy urutamari kizpur kurak taaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Apaa, mar kung kapungumash warastakchu,","poem":1},{"lineBreak":true},{"text":"zaw, zaw, zaw, ántaru, kizpur zungantaru,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"anoo shiy wizpurish kasirinashta. Watam shiy kanindush íwar taakshawa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apaa, shiy kamachtamarish urutamari taaratartachiya.","poem":1},{"lineBreak":true},{"text":"Shiy nllitarit chinacheezish, ndambaree.","poem":1},{"lineBreak":true},{"text":"Ashiriya, tputsirish uru shiyash pangish pshtukchusin,","poem":1},{"lineBreak":true},{"text":"Shiyaa Apaa, Kizpur wanasirtishcha.","poem":1},{"lineBreak":true},{"text":"Nda pakchiyam yutarit chinaksha, atusin, shiyaa ungirtachinllinaya, nuw shiyaa Apaa, atina.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":5}