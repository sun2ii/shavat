{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":95,"content":[{"type":"heading","content":["Apanlleem mangooz ksaptari yaseeyani"]},{"type":"verse","number":1,"content":[{"text":"Naanints. Mangooz ksaptari Apareetsich yaseeyani;","poem":1},{"lineBreak":true},{"text":"watam iyaa ksutataw ashku, tapachindakuwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ashiri Apanllish pang' pshtuyaruni,","poem":1},{"lineBreak":true},{"text":"Apanlleem yaseeyani. Ungirtayani.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Watam Apanll Taarashipan minamaritawa.","poem":1},{"lineBreak":true},{"text":"Uwamari kapung kasiriya.","poem":1},{"lineBreak":true},{"text":"Apanllputsee ichingaru kasiru, kizpur kurak taakiya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tsapurunasee ichingaru ksutkiya.","poem":1},{"lineBreak":true},{"text":"Tsapoo wantsshuchee ksutku,","poem":1},{"lineBreak":true},{"text":"Íwaree machee ksutkitamta.","poem":1},{"lineBreak":true},{"text":"Tsapurunasee ztaru waana amuytakiya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kung mar kapungumashee Apanll waana tinarangiya.","poem":1},{"lineBreak":true},{"text":"Tsapoomtam uwpatari patateeru tinarangiya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ashirucha, naanints. Ungirtayani Apareetsich.","poem":1},{"lineBreak":true},{"text":"Tuchimtayaruni, wánungeetari ungirtayani Apareetsich.","poem":1},{"lineBreak":true},{"text":"Watam iyaamtam tinaranguwa, atina.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Apanll watacha kaapaniritana yaana Aparini.","poem":1},{"lineBreak":true},{"text":"Iysha Apanlltanicha tiptsirini.","poem":1},{"lineBreak":true},{"text":"Apanll opeej ksutamapan ashiru iyaa wanasiri ksutkiya.","poem":1},{"lineBreak":true},"Ashiri siysa waanaatsee kuk kitsis mazinangtsa. Watam Apanll siyaa atuwa:"]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sirútama zitaminaris tsap apusash","poem":1},{"lineBreak":true},{"text":"Meribash taarangsin,","poem":1},{"lineBreak":true},{"text":"nuwamun mang' tatumaam ngataranganaya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nuwaatssha michitaranganaya.","poem":1},{"lineBreak":true},{"text":"Nuw wizpurirpati tapachindarangitaati,","poem":1},{"lineBreak":true},{"text":"nuwaa wizpurireetsi parangitaatssin,","poem":1},{"lineBreak":true},{"text":"itaru nuwamun mang' tatumaam ngataranganaya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ashiri nuwsha kapung tsiyantaranguri,","poem":1},{"lineBreak":true},{"text":"40 masach apusap masatarusin naamaam wayarangina.","poem":1},{"lineBreak":true},{"text":"In tputs nda mangpa chinakanaya; kizpur yutarit ashkanaya.","poem":1},{"lineBreak":true},{"text":"Nuwaa kamachtamari wits nda mazinakana.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ashirucha, nee zurampatari wanichima.","poem":1},{"lineBreak":true},{"text":"Yuwash tsap taamaam wayarangi anush pshtuchazinllinaja, ndambaree.","poem":1},{"lineBreak":true},{"text":"Anush kanuschazinllinaja, ndambaree,","poem":1},{"noteId":59},{"text":"atina,","poem":1},{"lineBreak":true},"Apanll tárangiya.",{"noteId":60}]}],"footnotes":[{"noteId":59,"caller":"*","text":"Yuwaa nish átu anootstam Utaáshucheema 4.3 tayusima kamankiya.","reference":{"chapter":95,"verse":11}},{"noteId":60,"caller":"*","text":"Utaáshucheema 3.7-11 tsiyatsis nipta tatsamooru taaritamta.","reference":{"chapter":95,"verse":11}}]},"thisChapterLink":"/api/cbu_wbt/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":11}