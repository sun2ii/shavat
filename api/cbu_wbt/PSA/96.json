{"translation":{"id":"cbu_wbt","name":"Candoshi-Shapra","website":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cbuNT","licenseNotes":null,"shortName":"WBT","englishName":"Candoshi-Shapra NT","language":"cbu","textDirection":"ltr","sha256":"68f6b0b7b3636292319a12ca82441de7446e0a994b4833c5c1df7f374440ac79","availableFormats":["json"],"listOfBooksApiLink":"/api/cbu_wbt/books.json","numberOfBooks":52,"totalNumberOfChapters":627,"totalNumberOfVerses":15634,"languageName":"Candoshi-Shapra","languageEnglishName":"Candoshi-Shapra"},"book":{"id":"PSA","translationId":"cbu_wbt","name":"Salmos","commonName":"Salmos","title":"Israelchich Apanlleem yaseerangana anu Israelchich Apanlleem yaseerangana anu","order":19,"numberOfChapters":59,"sha256":"9f41a69f67bf7d0417251e352ed3c0c89deb5a4b053338a2a9efc70a41d7c9c7","firstChapterNumber":1,"firstChapterApiLink":"/api/cbu_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cbu_wbt/PSA/150.json","totalNumberOfVerses":920},"chapter":{"number":96,"content":[{"type":"heading","content":["Yaseeshish kaneeschi yaseeyarus, Apanllee ungirtangints"]},{"type":"verse","number":1,"content":[{"text":"Apareetsich yaseengints.","poem":1},{"lineBreak":true},{"text":"Tputs ztaru yaseesshish kaneeschee Apanllee yaseengints.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Apareetsich yaseeyani.","poem":1},{"lineBreak":true},{"text":"Taarashipanee, shiy kizpurtishcha, táyani.","poem":1},{"lineBreak":true},{"text":"Putam, putam, tputsee kamankus,","poem":1},{"lineBreak":true},{"text":"Apanll iyaam tapachndampaneem taakiya, tángtsa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tputsee ztaru Apanllee kamaningtsa;","poem":1},{"lineBreak":true},{"text":"Apanll tsinsampancha.","poem":1},{"lineBreak":true},{"text":"Wamari kasiru, ¿waninll wizpurpat iyaa istakuwa? tángints.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Watam Apanll uwamari kizpur kurakawa.","poem":1},{"lineBreak":true},{"text":"Ashiriya, uru ungirtakuch yasimaam kizpurcha wanasiri.","poem":1},{"lineBreak":true},{"text":"Apanllputsee ichinguru uwamari kasiriya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Minshuch tputs apanllputsirini wizpur nda pakchiyam taariya.","poem":1},{"lineBreak":true},{"text":"Itaru, Apanllsha kizpureeru kanindaa tinarangiya.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Shiy Apaa, kizpur wanasirtishcha.","poem":1},{"lineBreak":true},{"text":"Pangish kurakurtaru anush, 'sinish kizpur taaksha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ashiri siysa ichingarus tputsis, maachiritpatawis Apanllee ungirtangints.","poem":1},{"lineBreak":true},{"text":"Apaa, wappari wizpuririmandish.","poem":1},{"lineBreak":true},{"text":"Shiyamari urutamari kasiksha, tángints.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sheerus, pangup naakchus, maacheetsi, yuwaa waana kamachtarangu","poem":1},{"lineBreak":true},{"text":"anoo yáyarus, ungirtangints.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Apanll pang' kizpurcha wanasiri.","poem":1},{"lineBreak":true},{"text":"Ashiri anushsha ungirtangints.","poem":1},{"lineBreak":true},{"text":"Tputsis ichingarus, Nuw shiyaa kurakartana, Apanllee tángtsa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Apanll uwamari kizpur kurakcha, kamankus tángtsa.","poem":1},{"lineBreak":true},{"text":"Tsapurunasee tinayaru, wayarangu, na anootsiri taakiya. Nda shpukiya.","poem":1},{"lineBreak":true},{"text":"Amb ashirangu, tputsee ichingaru tatsamooru chinaku taakiya.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ashiriya, siysa Apanll tínarangu anis,","poem":1},{"text":"misha yuwis kanindush taakis antamtis,","poem":2},{"lineBreak":true},{"text":"misha yuwis tsapurunasush taakis antamtis,","poem":2},{"lineBreak":true},{"text":"misha yuwis marush taakis antamtis,","poem":2},{"text":"ichingarus Aparimuni mangis kis shambatangtsa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yuwis mzatsish tatsumis taakis,","poem":1},{"lineBreak":true},{"text":"mishat manginshuchtamtis, yasinawtamtis,","poem":1},{"lineBreak":true},{"text":"Apanllimun kis shambatangtsa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Watam waana tsapurunasshuchee ichingaru ksutamaam kuschima, táranguwa.","poem":1},{"lineBreak":true},{"text":"Tputsee natstayaru, wanasiri zurampatari tsiyatku, anoo ksutchiya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cbu_wbt/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cbu_wbt/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cbu_wbt/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}