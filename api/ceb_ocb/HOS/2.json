{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"HOS","translationId":"ceb_ocb","name":"Oseas","commonName":"Oseas","title":"Ang Libro ni Oseas","order":28,"numberOfChapters":14,"sha256":"2bacebf6fc809d5ccbf29d0e99544429867245a365c2e61287efbd811e1bb5d4","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ceb_ocb/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["“Busa tawga ninyo ang inyong isigka-Israelinhon nga ‘Akong katawhan’",{"noteId":4},"ug ‘Gikaloy-an.’",{"noteId":5}]},{"type":"heading","content":["Si Gomer Hulagway sa Pagluib sa Israel"]},{"type":"verse","number":2,"content":[{"text":"“Mga anak, badlonga ninyo ang inyong inahan","poem":1},{"text":"kay dili ko na siya asawa,","poem":2},{"lineBreak":true},{"text":"ug dili na niya ako bana.","poem":2},{"text":"Ingna ninyo siya nga undangon na","poem":1},{"text":"ang iyang pagpamiga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kay kon dili siya moundang, huboan ko siya","poem":1},{"text":"ug madayag ang iyang kahubo","poem":2},{"lineBreak":true},{"text":"sama sa dihang gihimugso siya.","poem":2},{"text":"Himuon ko siyang sama sa kamingawan","poem":1},{"text":"o disyerto, ug mamatay siya sa kauhaw.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ug kamo nga iyang mga anak dili ko kaloy-an,","poem":1},{"text":"kay mga anak kamo sa babayeng maluibon.","poem":2},{"text":"Makauulaw ang ginahimo","poem":1},{"text":"sa inyong inahan nga mianak kaninyo.","poem":2},{"text":"Miingon siya, ‘Apason ko ang akong mga laki","poem":1},{"text":"nga mao ang naghatag kanako","poem":2},{"lineBreak":true},{"text":"sa akong pagkaon ug tubig,","poem":2},{"text":"mga panapton nga delana","poem":1},{"noteId":6},{"text":"ug lino,","poem":1},{"text":"lana, ug mga ilimnon.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Busa koralon ko siyag tunokon nga tanom aron","poem":1},{"text":"dili siya makagawas.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gukdon niya ang iyang mga laki","poem":1},{"text":"apan dili niya sila maabtan.","poem":2},{"text":"Pangitaon niya sila","poem":1},{"text":"apan dili niya sila makit-an.","poem":2},{"text":"Unya moingon siya,","poem":1},{"text":"‘Mobalik na lang ako sa akong bana,","poem":2},{"text":"kay mas maayo pa ang akong kahimtang kaniadto","poem":1},{"text":"kay sa karon.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wala niya huna-hunaa nga ako ang naghatag kaniya","poem":1},{"text":"sa mga lugas, duga sa ubas, lana,","poem":2},{"text":"ug sa daghang mga plata ug mga bulawan","poem":1},{"text":"nga gigamit nila nga imahen ni Baal.","poem":2},{"noteId":7}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Busa sa panahon sa ting-ani bawion ko","poem":1},{"text":"ang mga lugas","poem":2},{"lineBreak":true},{"text":"ug duga sa ubas nga akong gihatag.","poem":2},{"text":"Ug kuhaon ko usab ang mga panapton nga delana","poem":1},{"text":"ug lino nga gihatag ko aron","poem":2},{"lineBreak":true},{"text":"itabon sa iyang pagkahubo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ug karon huboan ko siya atubangan","poem":1},{"text":"sa iyang mga laki,","poem":2},{"text":"ug walay makaluwas kaniya gikan","poem":1},{"text":"sa akong mga kamot.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Undangon ko ang iyang paglipay","poem":1},{"text":"ug ang tanan niyang mga kasaulogan:","poem":2},{"text":"ang Pista sa Pagsugod sa Bulan,","poem":1},{"text":"mga Adlaw nga Igpapahulay,","poem":2},{"lineBreak":true},{"text":"ug ang tanang gitakda nga mga kasaulogan sa tuig.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Daoton ko ang iyang mga tanom nga ubas","poem":1},{"text":"ug mga kahoy nga igos","poem":2},{"text":"nga matod pa niya gibayad kaniya","poem":1},{"text":"sa iyang mga laki.","poem":2},{"text":"Himuon ko ang mga tamnanan niini nga kalasangan,","poem":1},{"text":"ug ang ihalas nga mga mananap na lang","poem":2},{"lineBreak":true},{"text":"ang mokaon niini.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Silotan ko siya tungod","poem":1},{"text":"sa mga higayon nga nagsunog","poem":2},{"text":"siyag insenso isip halad ngadto","poem":1},{"text":"sa mga imahen ni Baal.","poem":2},{"text":"Nagsul-ob siya ug mga alahas ug migukod","poem":1},{"text":"sa iyang mga laki,","poem":2},{"lineBreak":true},{"text":"apan ako gikalimtan niya,”","poem":2},{"text":"miingon ang Ginoo niini.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Karon, danihon ko siya ug dad-on sa kamingawan","poem":1},{"text":"ug pangulitawhan pag-usab.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ug didto ihatag ko kaniya pagbalik","poem":1},{"text":"ang iyang mga tamnanan sa ubas,","poem":2},{"text":"ug ang Walog sa Acor","poem":1},{"noteId":8},{"text":"mahimong","poem":1},{"text":"pultahan sa paglaom.","poem":2},{"text":"Unya, sugton niya ako sama","poem":1},{"text":"sa iyang gihimo kaniadtong batan-on pa siya,","poem":2},{"lineBreak":true},{"text":"sa dihang migawas siya gikan sa Ehipto.”","poem":2}]},{"type":"verse","number":16,"content":["Miingon ang Ginoo sa mga Israelinhon,",{"text":"“Nianang adlawa nga mobalik kamo kanako,","poem":1},{"text":"pagatawgon ninyo ako nga inyong bana,","poem":2},{"lineBreak":true},{"text":"ug dili na ninyo ako tawgon nga inyong Baal","poem":2},{"noteId":9},{"text":".","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dili ko na gayod kamo pasangpiton","poem":1},{"text":"sa mga ngalan ni Baal.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nianang adlawa maghimo ako ug kasabotan","poem":1},{"text":"uban sa tanang matang sa mga mananap","poem":2},{"lineBreak":true},{"text":"ug dili na nila kamo unsaon.","poem":2},{"text":"Wagtangon ko sa yuta sa Israel ang pana ug espada","poem":1},{"text":"aron makatulog kamo nga malinawon","poem":2},{"lineBreak":true},{"text":"ug walay gikahadlokan nga katalagman.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ilhon ko kamong akong asawa hangtod sa kahangtoran.","poem":1},{"text":"Buhaton ko diha kaninyo ang matarong ug husto.","poem":2},{"lineBreak":true},{"text":"Higugmaon ko kamo ug kaloy-an.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Magmatinud-anon ako kaninyo,","poem":1},{"text":"ug ilhon ninyo ako nga Ginoo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Miingon ang Ginoo,","poem":1},{"text":"“Nianang adlawa tubagon ko","poem":2},{"lineBreak":true},{"text":"ang inyong pag-ampo.","poem":2},{"text":"Paulanon ko aron","poem":1},{"text":"motubo diha sa yuta","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ang mga lugas, ubas, ug olibo alang kaninyo","poem":1},{"text":"nga gitawag nga Jezreel","poem":2},{"noteId":10},{"text":".","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Papuy-on ko kamo","poem":1},{"text":"sa inyong yuta isip akong katawhan.","poem":2},{"text":"Ipakita ko ang akong kaluoy kaninyo,","poem":1},{"text":"kamo nga gitawag ug Lo Ruhama","poem":2},{"noteId":11},{"text":".","poem":2},{"text":"Ug kamong gitawag nga Lo Ami","poem":1},{"noteId":12},{"text":"tawgon ko","poem":1},{"text":"nga akong katawhan.","poem":2},{"text":"Ug moingon kamo kanako,","poem":1},{"text":"‘Ikaw ang among Dios.’ ”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Akong katawhan: sa Hebreo, Ami.","reference":{"chapter":2,"verse":1}},{"noteId":5,"caller":"+","text":"Gikaloy-an: sa Hebreo, Ruhama.","reference":{"chapter":2,"verse":1}},{"noteId":6,"caller":"+","text":"-5 delana: sa English, “wool”.","reference":{"chapter":2,"verse":4}},{"noteId":7,"caller":"+","text":"gigamit…Baal: o gigamit nila sa pagsimba kang Baal.","reference":{"chapter":2,"verse":8}},{"noteId":8,"caller":"+","text":"Acor: ang buot ipasabot, kasamok.","reference":{"chapter":2,"verse":15}},{"noteId":9,"caller":"+","text":"Baal: ngalan kini sa usa ka dios-dios sa Canaan. Ang Baal nagkahulogan usab ug “agalon.”","reference":{"chapter":2,"verse":16}},{"noteId":10,"caller":"+","text":"Jezreel: si Jezreel, si Lo Ruhama ug si Lo Ami (bersikulo 23) mga anak ni Oseas ug ni Gomer (Ose. 1:3-9), ug ang ilang mga ngalan gipangalan sa Israel.","reference":{"chapter":2,"verse":22}},{"noteId":11,"caller":"+","text":"Lo Ruhama: ang buot ipasabot, wala gikaloy-an.","reference":{"chapter":2,"verse":23}},{"noteId":12,"caller":"+","text":"Lo Ami: ang buot ipasabot, dili akong katawhan.","reference":{"chapter":2,"verse":23}}]},"thisChapterLink":"/api/ceb_ocb/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}