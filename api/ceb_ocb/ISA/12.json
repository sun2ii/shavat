{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"ISA","translationId":"ceb_ocb","name":"Isaias","commonName":"Isaias","title":"Ang Libro ni Isaias","order":23,"numberOfChapters":66,"sha256":"7426102f6598e7e8288b88fed4c09bb692cea5dc9143046f1ba6d463e69c8176","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ceb_ocb/ISA/66.json","totalNumberOfVerses":1279},"chapter":{"number":12,"content":[{"type":"heading","content":["Ang Awit sa Pagpasalamat"]},{"type":"verse","number":1,"content":["Niana unyang adlawa mag-awit kamo:",{"text":"“Ginoo, dayegon","poem":1},{"noteId":41},{"text":"ka nako.","poem":1},{"text":"Nasuko nako kanako,","poem":2},{"text":"apan karon nahupay na ang imong kasuko,","poem":1},{"text":"ug ginalipay mo ako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ikaw, O Dios, mao ang akong manluluwas.","poem":1},{"text":"Mosalig ako kanimo ug dili mahadlok.","poem":2},{"text":"Ikaw, Ginoo, mao ang naghatag kanakog kusog,","poem":1},{"text":"ug ikaw ang akong ginaawit.","poem":2},{"lineBreak":true},{"text":"Ikaw ang nagluwas kanako.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maingon nga ang bugnawng tubig naghatag ug kalipay sa giuhaw,","poem":1},{"text":"malipay kamo kon luwason kamo sa Ginoo.","poem":2}]},{"type":"verse","number":4,"content":["Pag-abot nianang adlawa, mag-awit kamo:",{"text":"“Dayega","poem":1},{"noteId":42},{"text":"ninyo ang Ginoo! Simbaha ninyo siya!","poem":1},{"text":"Isugilon ngadto sa mga katawhan ang iyang mga binuhatan.","poem":2},{"lineBreak":true},{"text":"Isugilon ninyo nga dalaygon siya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Awiti ninyo ang Ginoo tungod kay","poem":1},{"text":"katingalahan ang iyang gipanghimo.","poem":2},{"lineBreak":true},{"text":"Ipahibalo ninyo kini sa tibuok kalibotan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Panghugyaw kamo ug pag-awit sa kalipay,","poem":1},{"text":"kamo nga katawhan sa Jerusalem.","poem":2},{"noteId":43},{"text":"Kay gamhanan ang Balaang Dios","poem":1},{"text":"sa Israel nga anaa uban kaninyo.”","poem":2}]}],"footnotes":[{"noteId":41,"caller":"+","text":"dayegon: o pasalamatan.","reference":{"chapter":12,"verse":1}},{"noteId":42,"caller":"+","text":"Dayega: o Pasalamati.","reference":{"chapter":12,"verse":4}},{"noteId":43,"caller":"+","text":"Jerusalem: sa Hebreo, Zion.","reference":{"chapter":12,"verse":6}}]},"thisChapterLink":"/api/ceb_ocb/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}