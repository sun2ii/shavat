{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"ISA","translationId":"ceb_ocb","name":"Isaias","commonName":"Isaias","title":"Ang Libro ni Isaias","order":23,"numberOfChapters":66,"sha256":"7426102f6598e7e8288b88fed4c09bb692cea5dc9143046f1ba6d463e69c8176","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ceb_ocb/ISA/66.json","totalNumberOfVerses":1279},"chapter":{"number":21,"content":[{"type":"heading","content":["Ang Mensahe bahin sa Babilonia"]},{"type":"verse","number":1,"content":["Mao kini ang mensahe bahin sa Babilonia:",{"noteId":64},{"text":"Mosulong ang mga kaaway nga daw alimpulos nga mohaguros sa Negev.","poem":1},{"text":"Gikan kini sa kamingawan, sa makalilisang nga yuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nakita ko ang usa ka makalilisang nga panan-awon","poem":1},{"text":"mahitungod sa pagluib ug pagpanglaglag.","poem":2},{"text":"Kamong mga taga-Elam ug taga-Media,","poem":1},{"text":"liboti ninyo ang Babilonia ug sulonga.","poem":2},{"text":"Tapuson sa Dios ang pagpaantos niya","poem":1},{"text":"sa ubang mga nasod.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kining nakita ug nadunggan ko sa panan-awon,","poem":1},{"text":"nakapakurog gayod kanako ug naghatag ug sakit sa akong kalawasan,","poem":2},{"lineBreak":true},{"text":"sama sa sakit nga gibati sa babaye nga nagbati.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nagkuba-kuba ang akong dughan,","poem":1},{"text":"ug nagkurog ako sa kahadlok.","poem":2},{"text":"Dili ako makatulog panahon sa kagabhion,","poem":1},{"text":"kay gikulbaan gihapon ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nangandam alang sa kombira ang mga opisyal.","poem":1},{"text":"Nagbutang sila ug mga hapin nga ilang kalingkoran.","poem":2},{"text":"Nangaon sila ug nanginom,","poem":1},{"text":"ug sa kalit lang adunay misinggit,","poem":2},{"lineBreak":true},{"text":"“Dali, pangandam kamo alang sa gira!”","poem":2}]},{"type":"verse","number":6,"content":["Miingon ang Ginoo kanako,",{"text":"“Pagbutang ug tigbalantay","poem":1},{"text":"sa siyudad nga mosulti sa iyang makita.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kinahanglan nga magbantay","poem":1},{"text":"gayod siya pag-ayo ug magpahibalo dayon","poem":2},{"lineBreak":true},{"text":"kon makakita siyag mga sundalo nga nagsakay sa mga karwahi","poem":2},{"text":"nga ginaguyod sa duha ka kabayo","poem":1},{"text":"o ug mga sundalo","poem":2},{"lineBreak":true},{"text":"nga nagsakay sa mga asno ug mga kamelyo.”","poem":2}]},{"type":"verse","number":8,"content":["Misinggit ang tigbalantay,",{"text":"“Sir, adlaw ug gabii akong nagbantay dinhi sa tore.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ug karon, tan-awa!","poem":1},{"text":"Adunay nagpadulong dinhi nga mga karwahi","poem":2},{"lineBreak":true},{"text":"ug mga tigkabayo nga nagparis-paris.”","poem":2},{"text":"Unya mipadayon ang tigbalantay,","poem":1},{"text":"“Napukan na gayod ang Babilonia.","poem":2},{"text":"Ang tanang imahen sa iyang mga dios nangadugmok","poem":1},{"text":"ug nagkatag sa yuta.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Akong mga katagilungsod nga Israelinhon,","poem":1},{"text":"nga daw mga trigo nga gigiok,","poem":2},{"noteId":65},{"text":"sultihan ko kamo sa mga butang","poem":1},{"text":"nga akong nadunggan gikan sa Ginoo nga Makagagahom,","poem":2},{"lineBreak":true},{"text":"ang Dios sa Israel.","poem":2}]},{"type":"heading","content":["Ang Mensahe bahin sa Edom"]},{"type":"verse","number":11,"content":["Mao kini ang mensahe bahin sa Edom:",{"noteId":66},{"text":"Adunay tawo gikan sa Seir","poem":1},{"noteId":67},{"text":"nga nagpunay","poem":1},{"text":"ug pangutana kanako,","poem":2},{"lineBreak":true},{"text":"“Guwardya, dugay pa ba mabuntag?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mitubag ako,","poem":1},{"text":"“Sa dili madugay moabot na ang kabuntagon,","poem":2},{"lineBreak":true},{"text":"apan moabot pag-usab ang kagabhion.","poem":2},{"text":"Kon buot kang mangutana pag-usab,","poem":1},{"text":"balik lang ug pangutana pag-usab.”","poem":2}]},{"type":"heading","content":["Ang Mensahe bahin sa Arabia"]},{"type":"verse","number":13,"content":["Mao kini ang mensahe bahin sa Arabia:",{"text":"Kamong mga panon sa magpapanaw","poem":1},{"text":"gikan sa Dedan,","poem":2},{"lineBreak":true},{"text":"nga nagkampo sa kamingawan sa Arabia,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"hatagi ninyog tubig ang mga giuhaw.","poem":1},{"text":"Kamong nagpuyo sa Tema,","poem":2},{"lineBreak":true},{"text":"hatagi ninyog pagkaon","poem":2},{"text":"ang mga tawo nga nangikyas","poem":1},{"text":"gikan sa ilang dapit.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nangagiw sila tungod sa labihan nga gira;","poem":1},{"text":"gigukod silag espada ug pana sa ilang mga kaaway.","poem":2}]},{"type":"verse","number":16,"content":["Miingon ang Ginoo kanako, “Sulod sa usa ka tuig, matapos ang pagkagamhanan sa Kedar."]},{"type":"verse","number":17,"content":["Gamay lang ang mahibilin sa iyang maisog nga mga tigpana. Mahitabo gayod kini, kay ako, ang Ginoo nga Dios sa Israel, ang nag-ingon niini.”"]}],"footnotes":[{"noteId":64,"caller":"+","text":"Babilonia: sa literal, kamingawan nga duol sa baybay.","reference":{"chapter":21,"verse":1}},{"noteId":65,"caller":"+","text":"daw mga trigo nga gigiok: ang buot ipasabot, nag-antos sa labihan gayod.","reference":{"chapter":21,"verse":10}},{"noteId":66,"caller":"+","text":"Edom: sa Hebreo, Duma.","reference":{"chapter":21,"verse":11}},{"noteId":67,"caller":"+","text":"Edom: sa Hebreo, Seir, nga laing tawag sa Edom.","reference":{"chapter":21,"verse":11}}]},"thisChapterLink":"/api/ceb_ocb/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}