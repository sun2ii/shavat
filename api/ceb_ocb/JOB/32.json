{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"JOB","translationId":"ceb_ocb","name":"Job","commonName":"Job","title":"Ang Libro ni Job","order":18,"numberOfChapters":42,"sha256":"80750177fc9a5001fdf7daf6c9fb10991009cdf10cd1055ab0822f10ca02f05c","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ceb_ocb/JOB/42.json","totalNumberOfVerses":1063},"chapter":{"number":32,"content":[{"type":"heading","content":["Si Elihu"]},{"type":"verse","number":1,"content":["Miundang na sa pagtubag kang Job ang tulo niya ka higala, tungod kay miinsister gayod si Job nga wala siyay sala."]},{"type":"verse","number":2,"content":["Unya adunay usa ka tawo didto nga ginganlag Elihu. Anak siya ni Barakel nga taga-Buz nga naggikan sa pamilya ni Ram. Nasuko siya pag-ayo kang Job kay ang Dios maoy gibasol ni Job ug dili ang iyang kaugalingon."]},{"type":"verse","number":3,"content":["Nasuko usab siya sa tulo ka higala ni Job kay wala nila mapamatud-i nga nakasala si Job ug migawas nga ang Dios maoy sad-an."]},{"type":"verse","number":4,"content":["Gihulat ni Elihu nga makahuman ug sulti ang uban ayha siya mosulti kang Job, tungod kay mas magulang sila kay kaniya."]},{"type":"verse","number":5,"content":["Apan sa dihang nakita niya nga wala nay ikasulti ang tulo, nasuko siya pag-ayo."]},{"type":"verse","number":6,"content":["Busa miingon si Elihu nga anak ni Barakel nga Busihanon,",{"text":"“Bata pa ako ug kamo tigulang na,","poem":1},{"text":"busa nanagana ako nga mosulti.","poem":2},{"text":"Nahadlok ako nga mangahas","poem":1},{"text":"sa pagpadayag kaninyo sa akong huna-huna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Giisip ko nga kamo ang angayng motudlo","poem":1},{"text":"kay mga tigulang na kamo","poem":2},{"lineBreak":true},{"text":"ug daghan kamog nahibaloan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Apan ang tinuod, ang espiritu sa Makagagahom nga Dios","poem":1},{"text":"nga anaa sa tawo mao ang naghatag kaniya sa panabot.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ang pagkatigulang dili garantiya","poem":1},{"text":"nga ang usa ka tawo maalamon","poem":2},{"lineBreak":true},{"text":"ug nahibalo kon unsay husto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Busa pamatia ninyo ako.","poem":1},{"text":"Mosulti usab ako sa akong nahibaloan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nagpaabot lang ako samtang naghuna-huna","poem":1},{"text":"pa kamo sa angay ninyong isulti.","poem":2},{"lineBreak":true},{"text":"Namati ako sa inyong mga rason.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Namati gayod ako pag-ayo kaninyo,","poem":1},{"text":"apan wala gayoy usa kaninyo","poem":2},{"text":"nga nakapamatuod nga nakasala si Job;","poem":1},{"text":"wala gayod kaninyoy mitubag","poem":2},{"lineBreak":true},{"text":"sa iyang pagpangatarungan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ayaw kamo pag-ingon,","poem":1},{"text":"‘Nahibaloan namo","poem":2},{"lineBreak":true},{"text":"kon unsa ang husto.","poem":2},{"text":"Pasagdi nga ang Dios ang motubag kaniya","poem":1},{"text":"ug dili ang tawo.’","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kon ako ang gilalis ni Job,","poem":1},{"text":"dili ko siya tubagon","poem":2},{"lineBreak":true},{"text":"ug sama sa inyong panubag.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Karon nakahinuktok kamo","poem":1},{"text":"ug wala nay ikatubag.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Maghulat lang ba ako samtang nagpakahilom kamo","poem":1},{"text":"ug wala nay ikatubag?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Aduna usab akoy isulti sumala sa akong nahibaloan.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kay daghan akog ikasulti,","poem":1},{"text":"ug dili ko na gayod kini kapugngan.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kabutohon na ako sama sa bag-ong sudlanan","poem":1},{"text":"sa bino nga hinimo sa panit.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kinahanglan gayod nga mosulti ako","poem":1},{"text":"aron mahuwasan ako.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wala akoy labanan o pasidunggan.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dili ako kahibalong moulog-ulog.","poem":1},{"text":"Ug kon buhaton ko kini, silotan ako diha-diha","poem":2},{"lineBreak":true},{"text":"sa Dios nga naghimo kanako.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ceb_ocb/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}