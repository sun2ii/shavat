{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"LAM","translationId":"ceb_ocb","name":"Pagbangotan","commonName":"Pagbangotan","title":"Ang Libro sa Pagbangotan","order":25,"numberOfChapters":5,"sha256":"8aa827e8b051bdc58d3cd93810fdfe0c8fa54b325ab6aad209df5d9e6916ff30","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/ceb_ocb/LAM/5.json","totalNumberOfVerses":152},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Nakasinati ako sa pagsilot sa Ginoo","poem":1},{"text":"tungod sa iyang kasuko.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Giabog niya ako ug gipalakaw","poem":1},{"text":"sa kangitngit imbis sa kahayag.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tibuok adlaw gayod niya akong gisigihag silot.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gipaluya niya ang tibuok kong lawas,","poem":1},{"text":"ug gibali niya ang akong mga bukog.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gisulong niya ako ug gipalibotan sa labihan","poem":1},{"text":"nga kalisod ug kasakit.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gipapuyo niya ako sa kangitngit","poem":1},{"text":"sama niadtong mga tawong","poem":2},{"lineBreak":true},{"text":"dugay nang nangamatay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gipakadenahan niya ako ug gipalibotan","poem":1},{"text":"ug paril aron dili ako makaikyas.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bisag nagpakitabang ako,","poem":1},{"text":"wala niya ako paminawa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gibabagan niya sa tinapok nga bato ang akong agianan,","poem":1},{"text":"ug gipaliko-liko ang akong ginaagian.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sama siya sa oso o liyon","poem":1},{"text":"nga naghulat sa pag-ataki kanako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Giguyod niya ako pahilayo sa dalan,","poem":1},{"text":"unya gikunis-kunis ug gibiyaan.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Gibinat niya ang iyang pana ug gipunting kanako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gipataop niya ang pana sa akong kasing-kasing.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Nahimo akong kataw-anan ngadto sa akong mga katawhan.","poem":1},{"text":"Gibugal-bugalan nila ako tibuok adlaw pinaagi sa awit.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pulos kapaitan ang gihatag niya kanako.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nangapungil ang akong mga ngipon","poem":1},{"text":"kay gipausap niya ako ug graba,","poem":2},{"lineBreak":true},{"text":"ug gitamak-tamakan niya ako sa yuta.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gihikawan niya ako sa kalinaw,","poem":1},{"noteId":7},{"text":"ug wala na ako makasinati sa kalamboan.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nahanaw ang akong kadungganan","poem":1},{"text":"ug ang tanang gilaoman ko sa Ginoo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Pait kaayong pamalandongon","poem":1},{"text":"ang akong pag-antos ug paglatagaw.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kon huna-hunaon ko kini kanunay,","poem":1},{"text":"mawad-an ako ug kadasig.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Apan mobalik ang akong paglaom","poem":1},{"text":"kon mahinumdoman ko","poem":2}]},{"type":"verse","number":22,"content":[{"text":"nga ang gugma ug kaluoy sa Ginoo walay kataposan.","poem":1},{"text":"Mao kana nga wala kita malaglag sa hingpit.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Matinumanon gayod ang Ginoo.","poem":1},{"text":"Gipakita niya ang iyang kaluoy matag adlaw.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Miingon ako sa akong kaugalingon,","poem":1},{"text":"“Ang Ginoo mao ang tanan alang kanako,","poem":2},{"lineBreak":true},{"text":"busa molaom ako kaniya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ang Ginoo maayo sa mga naglaom","poem":1},{"text":"ug nagdangop kaniya.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Maayo nga maghulat kita","poem":1},{"text":"nga mapailubon sa kaluwasan","poem":2},{"lineBreak":true},{"text":"nga ihatag sa Ginoo kanato.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Maayo alang sa usa ka tawo ang madisiplina","poem":1},{"noteId":8},{"text":"samtang batan-on pa siya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Kon gidisiplina kita sa Ginoo,","poem":1},{"text":"manglingkod kita nga mag-inusara","poem":2},{"lineBreak":true},{"text":"ug mamalandong.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Magpaubos kita sa atong kaugalingon","poem":1},{"text":"atubangan sa Ginoo,","poem":2},{"lineBreak":true},{"text":"ug dili magpakawala sa paglaom.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Dawata ang mga pagsagpa","poem":1},{"text":"ug pagpanginsulto sa imong mga kaaway.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Kay ang Ginoo dili mosalikway kanato","poem":1},{"text":"hangtod sa kahangtoran.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Bisan tuod hatagan niya kitag mga kalisod,","poem":1},{"text":"kaloy-an gihapon niya kita tungod sa iyang dako","poem":2},{"lineBreak":true},{"text":"ug matinud-anong gugma.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kay dili niya tuyo ang pagpaantos ug pagsakit kanato.","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Dili buot sa Labing Halangdong Dios","poem":1},{"text":"nga daog-daogon ang mga binilanggo","poem":2},{"lineBreak":true},{"text":"o hikawan ang usa ka tawo sa iyang katungod.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Dili usab gusto ang Ginoo nga tuison","poem":1},{"text":"ang hustisya diha sa mga hukmanan.","poem":2},{"lineBreak":true},{"text":"Nakita niya kining tanan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Walay bisan unsa nga mahitabo","poem":1},{"text":"nga walay pagtugot sa Ginoo.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Dili ba nga ang Labing Halangdong Dios","poem":1},{"text":"ang nagbuot kon mahitabo ang usa ka butang,","poem":2},{"lineBreak":true},{"text":"daotan man o maayo kini?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Nganong moreklamo man kita","poem":1},{"text":"kon silotan kita tungod sa atong mga sala?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Kinahanglang susihon nato","poem":1},{"text":"ang atong mga binuhatan","poem":2},{"lineBreak":true},{"text":"ug mobalik kita sa Ginoo.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Ablihan nato ang atong mga kasing-kasing","poem":1},{"text":"ug ibayaw ang atong mga kamot ngadto","poem":2},{"lineBreak":true},{"text":"sa Dios sa langit ug moingon,","poem":2}]},{"type":"verse","number":42,"content":[{"text":"“Nakasala kami ug mirebelde, Ginoo,","poem":1},{"text":"ug wala mo kami pasayloa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“Nasuko ka pag-ayo ug gigukod mo kami,","poem":1},{"text":"ug gipamatay sa walay kaluoy.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Gitabonan mo ang imong kaugalingon sa panganod,","poem":1},{"text":"aron dili mo madungog ang among pag-ampo.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Gihimo mo kaming daw basura","poem":1},{"text":"sa panan-aw sa ubang mga nasod.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“Gibiay-biay kami sa tanan namong mga kaaway.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Nag-antos kami sa kahadlok,","poem":1},{"text":"katalagman, kapildihan, ug kalaglagan.”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Daw nagbaha ang luha sa akong mga mata","poem":1},{"text":"tungod kay nalaglag ang akong katawhan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Dili moundang pag-agas","poem":1},{"text":"ang mga luha sa akong mga mata","poem":2}]},{"type":"verse","number":50,"content":[{"text":"hangtod nga modungaw","poem":1},{"text":"ang Ginoo gikan sa langit","poem":2},{"lineBreak":true},{"text":"ug makita ang nahitabo kanato.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Gikaguol ko ang nakita ko nga gidangatan","poem":1},{"text":"sa mga kababayen-an sa akong siyudad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Daw langgam ako nga gigukod","poem":1},{"text":"sa akong mga kaaway bisan","poem":2},{"lineBreak":true},{"text":"ug wala akoy nahimong sala kanila.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Nagtinguha sila sa pagpatay kanako","poem":1},{"text":"pinaagi sa paghulog kanako","poem":2},{"lineBreak":true},{"text":"sa bangag ug pagbato kanako.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Nalapawan ako sa tubig,","poem":1},{"text":"ug abi kog mamatay na ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Nanawag ako kanimo, O Ginoo,","poem":1},{"text":"gikan sa kinahiladman sa bangag.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Gidungog mo ang akong pagpakiluoy","poem":1},{"text":"ug pagpakitabang.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Miduol ka sa dihang nanawag ako kanimo,","poem":1},{"text":"ug miingon ka nga dili ako mahadlok.","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Gitabangan mo ako, Ginoo,","poem":1},{"text":"sa akong kaso ug giluwas mo","poem":2},{"lineBreak":true},{"text":"ang akong kinabuhi.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Nakita mo, Ginoo, ang daotang gibuhat","poem":1},{"text":"sa akong mga kaaway kanako,","poem":2},{"lineBreak":true},{"text":"busa hatagi akog hustisya.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Nahibalo ka sa ilang tinguha","poem":1},{"text":"sa pagpanimalos kanako","poem":2},{"lineBreak":true},{"text":"ug sa tanan nilang daotang plano batok kanako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"O Ginoo, nadungog mo ang pagpanginsulto nila kanako","poem":1},{"text":"ug ang tanan nilang daotang mga plano batok kanako.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Naghisgot sila ug nagplano","poem":1},{"text":"ug daotan batok kanako tibuok adlaw.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Tan-awa sila! Bisan ug unsay ilang buhaton tibuok adlaw,","poem":1},{"text":"kanunay nila akong gibiay-biay pinaagi sa awit.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Balosi sila, Ginoo, sumala sa ilang binuhatan.","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"Pagahi-a ang ilang kasing-kasing, ug tungloha sila.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"Gukda sila ug laglaga sa imong kasuko","poem":1},{"text":"aron mahanaw sila sa kalibotan.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":7,"caller":"+","text":"kalinaw: o maayo nga kahimtang.","reference":{"chapter":3,"verse":17}},{"noteId":8,"caller":"+","text":"madisiplina: o makasinati sa kalisod.","reference":{"chapter":3,"verse":27}}]},"thisChapterLink":"/api/ceb_ocb/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":65}