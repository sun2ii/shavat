{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PRO","translationId":"ceb_ocb","name":"Mga Panultihon","commonName":"Mga Panultihon","title":"Ang Libro sa Mga Panultihon","order":20,"numberOfChapters":31,"sha256":"e05019477769e8c2f9f61b1cdec8f29ce25ec3f798491f5640c1a9088d00e9ba","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ceb_ocb/PRO/31.json","totalNumberOfVerses":900},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Mga anak, pamatia ninyo pag-ayo","poem":1},{"text":"ang pagtul-id sa inyong amahan sa inyong pamatasan,","poem":2},{"lineBreak":true},{"text":"aron makakat-on kamo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Maayo ang akong ginatudlo,","poem":1},{"text":"busa ayaw ninyo kini ipakawalay-bili.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sa bata pa ako ug anaa pa sa poder sa akong amahan,","poem":1},{"text":"paborito","poem":2},{"noteId":7},{"text":"ako sa akong inahan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ginatudloan ako sa akong amahan. Miingon siya kanako,","poem":1},{"text":"“Tipigi sa imong kasing-kasing ang gipanudlo ko kanimo.","poem":2},{"lineBreak":true},{"text":"Tumana ang mga sugo ko aron padayon kang magkinabuhi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Paninguhaa nga makaangkon kag kaalam ug pagsabot.","poem":1},{"text":"Ayawg kalimti ang akong mga gipang-istorya kanimo,","poem":2},{"lineBreak":true},{"text":"ug ayawg biya niini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ayaw isalikway ang kaalam,","poem":1},{"text":"hatagi hinuon kinig importansya,","poem":2},{"lineBreak":true},{"text":"kay mao kini ang motipig kanimo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ang kaalam ug pagsabot maoy labing mahinungdanon sa tanan,","poem":1},{"text":"busa paninguhaa gayod nga maangkon mo kini","poem":2},{"lineBreak":true},{"text":"bisan pag mahurot ang tanan mong kabtangan.","poem":2},{"noteId":8}]},{"type":"verse","number":8,"content":[{"text":"Higugmaa ug tipigi ang kaalam,","poem":1},{"text":"kay makahatag kini kanimog kadungganan.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sama kini sa korona nga bulak","poem":1},{"text":"nga makahatag ug katahom kanimo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Anak, pamatia ug tumana ang gipanulti ko kanimo","poem":1},{"text":"aron motaas ang imong kinabuhi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nagtudlo na ako kanimog kaalam,","poem":1},{"text":"kon unsaon pagkinabuhig ensakto.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Busa kon sundon mo kini,","poem":1},{"text":"walay kahasol sa imong pagkinabuhi, ug dili ka matarog.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ayaw gayod kalimti ang gihimo kong pagtul-id","poem":1},{"text":"sa imong pamatasan;","poem":2},{"lineBreak":true},{"text":"tipigi kini sa imong kasing-kasing kay imo kanang ikinabuhi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ayaw sunda ang binuhatan","poem":1},{"text":"sa mga daotan.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Likayi gayod kini ug padayon","poem":1},{"text":"sa imong pagkinabuhing matarong.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kay dili sila makatulog kon","poem":1},{"text":"dili sila makahimog daotan o wala silay malaglag.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ang kadaotan ug ang kabangis daw","poem":1},{"text":"maoy ilang kinaon ug ilimnon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ang pagkinabuhi sa mga matarong daw","poem":1},{"text":"sama sa nagsubang nga adlaw","poem":2},{"lineBreak":true},{"text":"nga mosamot kasidlak sa kaudtohon.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Apan ang pagkinabuhi sa mga daotan daw","poem":1},{"text":"sama sa kangitngit,","poem":2},{"text":"ug wala sila masayod kon unsa ang hinungdan","poem":1},{"text":"sa ilang pagkalaglag.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Anak, pamatia pag-ayo","poem":1},{"text":"ang gipangtudlo ko kanimo;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ayaw gayod kini kalimti,","poem":1},{"text":"hinuon tipigi kini sa imong kasing-kasing.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kay maghatag kinig maayong panglawas","poem":1},{"text":"ug taas nga kinabuhi","poem":2},{"lineBreak":true},{"text":"sa nagbaton niini.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bantayi pag-ayo ang imong huna-huna,","poem":1},{"text":"kay kon unsay anaa sa imong huna-huna","poem":2},{"lineBreak":true},{"text":"mao usab ang imong ikinabuhi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ayaw gayod pagsultig bakak","poem":1},{"text":"ug walay hinungdan.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Isentro ang imong panghuna-huna","poem":1},{"text":"sa mga butang nga maayo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Balansiha pag-ayo ang tanan mong pagahimuon","poem":1},{"text":"aron maayo ang mahimong resulta niini.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Pagtinarong;","poem":1},{"text":"likayi ang paghimo ug daotan.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"paborito: o bugtong anak.","reference":{"chapter":4,"verse":3}},{"noteId":8,"caller":"+","text":"busa paninguhaa…kabtangan: o busa bisan unsa pay imong naangkon, paninguhaa gayod nga maangkon ang kaalam ug ang pagsabot.","reference":{"chapter":4,"verse":7}}]},"thisChapterLink":"/api/ceb_ocb/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}