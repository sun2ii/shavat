{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PRO","translationId":"ceb_ocb","name":"Mga Panultihon","commonName":"Mga Panultihon","title":"Ang Libro sa Mga Panultihon","order":20,"numberOfChapters":31,"sha256":"e05019477769e8c2f9f61b1cdec8f29ce25ec3f798491f5640c1a9088d00e9ba","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ceb_ocb/PRO/31.json","totalNumberOfVerses":900},"chapter":{"number":6,"content":[{"type":"heading","content":["Dugang mga Pahimangno"]},{"type":"verse","number":1,"content":[{"text":"Anak, kon moako ka","poem":1},{"text":"nga mobayad sa utang sa ubang tawo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"masulod ka sa kompromiso,","poem":1},{"text":"ug manubag ka ngadto sa imong gisaaran.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Apan mao kini ang himoa aron makalingkawas ka","poem":1},{"text":"sa imong obligasyon:","poem":2},{"text":"Adtoa ang imong gisaaran","poem":1},{"text":"ug pagpakiluoy nga ipalingkawas ka niya","poem":2},{"lineBreak":true},{"text":"sa maong obligasyon.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ayaw gayod tulog-tulogi","poem":1},{"text":"o unya-unyaa","poem":2}]},{"type":"verse","number":5,"content":[{"text":"hangtod nga makalingkawas ka niini,","poem":1},{"text":"nga daw sa usa o sa langgam","poem":2},{"lineBreak":true},{"text":"nga nakaikyas gikan sa mangangayam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kamong mga tapolan,","poem":1},{"text":"obserbahi ug kat-oni ang pagkinabuhi sa mga lamigas,","poem":2},{"lineBreak":true},{"text":"aron magmaalamon kamo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bisan walay pangulo o tigdumala nga nagsugo kanila,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"nagtigom silag pagkaon","poem":1},{"text":"sa panahon sa ting-init ug ting-ani,","poem":2},{"lineBreak":true},{"text":"aron aduna silay pagkaon sa ting-ulan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kamong mga tapolan, magsige ra ba gayod mo ug katulog?","poem":1},{"text":"Kanus-a man mo magmata?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sige ramog tulog-tulog,","poem":1},{"text":"hayang-hayang, ug panguyogpos,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"unya sa kalit lang moabot kaninyo ang kawad-on","poem":1},{"text":"nga daw sa armadong tulisan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ang mga walay pulos ug daotang","poem":1},{"text":"mga tawo manugilon ug bakak.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Pinaagi sa ilang kidhat-kidhat ug sinyas-sinyas","poem":1},{"text":"sa ilang mga kamot ug tiil manglimbong sila sa uban.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sa ilang pagka-mangingilad, kanunay silang nagplano","poem":1},{"text":"sa paghimo ug daotan, ug tigpasiugda silag kagubot.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Busa sa kalit lang laglagon sila,","poem":1},{"text":"ug wala gayoy makatabang kanila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":["Adunay pito",{"noteId":11},"ka matang sa tawo nga gikapungtan ug gikangil-aran sa Ginoo:"]},{"type":"verse","number":17,"content":["ang mga hambogiro, ang mga bakakon, ang mga gapatay ug tawo,"]},{"type":"verse","number":18,"content":["ang mga nagplanog daotan, ang mga abtik mohimog daotan,"]},{"type":"verse","number":19,"content":["ang mga nagsaksi ug bakak, ug ang mga nagpaaway sa iyang isigka-tawo."]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Anak, sunda ang mga sugo","poem":1},{"text":"ug gipanudlo sa imong ginikanan.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Itanom kini sa imong huna-huna","poem":1},{"text":"aron dili mo gayod malimtan.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Maggiya kini, magtipig, ug magpahinumdom kanimo","poem":1},{"text":"sa bisan unsay imong buhaton.","poem":2},{"noteId":12}]},{"type":"verse","number":23,"content":[{"text":"Kay ang ilang mga sugo","poem":1},{"text":"sama sa suga nga mohatag kanimog kahayag.","poem":2},{"text":"Ug ang pagbadlong ug pagtul-id nila sa imong pamatasan","poem":1},{"text":"makaayo ug makapataas sa imong kinabuhi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ilikay ka usab niini gikan sa babayeng daotan","poem":1},{"text":"nga makadaning manulti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ayaw pagpatintal sa iyang katahom.","poem":1},{"text":"Ayaw pagpadala sa iyang mga kidhat.","poem":2},{"noteId":13}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ang pagpakighilawas sa babayeng nagbaligya","poem":1},{"text":"sa iyang dungog mabayran rag pilak,","poem":2},{"text":"apan ang pagpakighilawas sa asawa sa uban bayran mo","poem":1},{"text":"sa imong kinabuhi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kon ipaduol mo ang kalayo sa imong dughan","poem":1},{"text":"masunog ang imong bisti.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kon maglakaw ka sa baga","poem":1},{"text":"mapaso ang imong tiil.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mao kana nga kon makighilawas ka","poem":1},{"text":"sa asawa sa uban, silotan ka!","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Mahimong palabyon ang gihimo sa kawatan nga nangawat","poem":1},{"text":"tungod kay gigutom siya,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"apan kon madakpan siya,","poem":1},{"text":"pabayron siyag pito ka pilo sa kantidad nga iyang gikawat,","poem":2},{"lineBreak":true},{"text":"bisan pag mahurot ang tanan niyang butang.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ang tawong nakigrelasyon sa","poem":1},{"text":"asawa sa uban walay hustong panabot.","poem":2},{"lineBreak":true},{"text":"Gidaot lang niya ang iyang kaugalingon.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Sakiton siya","poem":1},{"text":"ug maulawan hangtod sa kahangtoran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Ang bana nga nangabugho masuko pag-ayo,","poem":1},{"text":"ug mobalos siya nga walay kaluoy.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Dili siya modawat ug bayad,","poem":1},{"text":"bisan pag unsa kini kadako.","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"pito: sa literal, unom o pito.","reference":{"chapter":6,"verse":16}},{"noteId":12,"caller":"+","text":"bisan unsay imong buhaton: sa literal, sa imong paglakaw, pagtulog, ug pagbangon.","reference":{"chapter":6,"verse":22}},{"noteId":13,"caller":"+","text":"kidhat: o matahom nga mata.","reference":{"chapter":6,"verse":25}}]},"thisChapterLink":"/api/ceb_ocb/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}