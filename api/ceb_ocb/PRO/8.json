{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PRO","translationId":"ceb_ocb","name":"Mga Panultihon","commonName":"Mga Panultihon","title":"Ang Libro sa Mga Panultihon","order":20,"numberOfChapters":31,"sha256":"e05019477769e8c2f9f61b1cdec8f29ce25ec3f798491f5640c1a9088d00e9ba","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ceb_ocb/PRO/31.json","totalNumberOfVerses":900},"chapter":{"number":8,"content":[{"type":"heading","content":["Ginadayeg ang Kaalam"]},{"type":"verse","number":1,"content":[{"text":"Ang kaalam ug pagsabot sama sa","poem":1},{"text":"tawong nagwali.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nagbarog siya diha sa habog nga mga lugar","poem":1},{"text":"sa daplin sa kadalanan, sa gisang-an sa dalan,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"duol sa mga pultahan sa lungsod, ug sa mga agianan.","poem":1},{"text":"Ug nagwali siyag kusog:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Kamong tanan nga katawhan,","poem":1},{"text":"nakigsulti ako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kamong mga walay kahibalo, pagmaalamon kamo.","poem":1},{"text":"Kamong mga buang-buang, sabta kini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pamati kamo, kay mapuslanon","poem":1},{"text":"ug husto kining akong isulti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tinuod gayod ang akong gisulti","poem":1},{"text":"ug ngil-aran ako sa nagsultig daotan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Matarong ang tanan kong gisulti","poem":1},{"text":"ug wala gayod kini sagol nga bakak o limbong.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Masabtan kining tanan ug walay sayop","poem":1},{"text":"alang sa mga tawong adunay pagsabot.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Palabiha ang kaalam ug ang akong pagtul-id","poem":1},{"text":"sa imong pamatasan kaysa pilak ug bulawan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kay ang kaalam mas bililhon pa kaysa mahalong mga bato","poem":1},{"text":"ug wala gayoy butang nga imong pangandoyon","poem":2},{"lineBreak":true},{"text":"nga makatupong niini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ako, nga mao ang kaalam,","poem":1},{"text":"kahibalo motimbang-timbang kon unsay husto o dili,","poem":2},{"lineBreak":true},{"text":"ug kahibalo ako modesisyon sa ensakto.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ang nagtahod sa Ginoo nasilag sa daotan.","poem":1},{"text":"Gikasilagan ko ang pagpanghambog,","poem":2},{"lineBreak":true},{"text":"ang pagkamapahitas-on,","poem":2},{"text":"ang daotang batasan,","poem":1},{"text":"ug ang pagpamakak.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Maayo akong motambag ug aduna akoy husto nga kaalam.","poem":1},{"text":"Adunay pagsabot ako ug gahom.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pinaagi kanako makadumala ang mga hari,","poem":1},{"text":"ug makahimo ang mga pangulo","poem":2},{"lineBreak":true},{"text":"ug matarong nga mga kasugoan.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pinaagi kanako makadumala ang mga tigdumala","poem":1},{"text":"ug ang mga opisyal,","poem":2},{"lineBreak":true},{"text":"ang tanan nga nagdumala nga matarong.","poem":2},{"noteId":15}]},{"type":"verse","number":17,"content":[{"text":"Gihigugma ko ang naghigugma kanako;","poem":1},{"text":"ang mangita kanako makakaplag kanako.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Makahatag akog bahandi, dungog, kauswagan,","poem":1},{"text":"ug kadaogan nga molungtad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ang akong mahatag mas bililhon pa","poem":1},{"text":"kaysa purong bulawan o pilak.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ginasunod ko","poem":1},{"text":"kon unsay matarong ug husto.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ang naghigugma kanako hatagan kog bahandi;","poem":1},{"text":"pun-on ko ang ilang tipiganan sa bahandi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Daan na akong kauban","poem":1},{"noteId":16},{"text":"sa Ginoo","poem":1},{"text":"sa wala pa niya mugnaa ang tanan.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gitugotan niya nga anaa na ako sukad pa sa una.","poem":1},{"text":"Diha na ako sa wala pa ang kalibotan:","poem":2},{"text":"ang dagat, ang mga tuboran, ang mga bukid,","poem":1},{"text":"ang mga bungtod, ang mga kaumahan,","poem":2},{"lineBreak":true},{"text":"ug bisan ang mga abog.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Diha na ako sa pagmugna niya sa langit,","poem":1},{"text":"sa pagbutang niya sa utlanan sa langit","poem":2},{"lineBreak":true},{"text":"ug sa yuta,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"sa pagmugna niya sa mga panganod,","poem":1},{"text":"sa pagpatubod niya sa mga tuboran sa kahiladman,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"sa pagbutang niya sa utlanan sa dagat","poem":1},{"text":"aron dili kini molapaw,","poem":2},{"text":"ug sa pagbutang niya","poem":1},{"text":"sa mga pundasyon sa kalibotan.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Sama ako sa usa ka arkitekto","poem":1},{"noteId":17},{"text":"diha sa tapad sa Ginoo.","poem":2},{"text":"Ako ang iyang kalipay adlaw-adlaw,","poem":1},{"text":"ug malipayon ako kanunay sa iyang presensya.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nalipay ako sa kalibotan nga iyang gimugna","poem":1},{"text":"ug sa mga katawhan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Busa karon mga anak, pamatia ninyo ako,","poem":1},{"text":"kay bulahan ang nagsunod","poem":2},{"lineBreak":true},{"text":"sa akong mga pamaagi.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Pamatia ninyo ang akong pagtul-id","poem":1},{"text":"sa inyong pamatasan","poem":2},{"text":"aron mahimo kamong maalamon,","poem":1},{"text":"ug ayaw gayod ninyo kini kalimti.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Bulahan ang tawo nga kanunayng nangandam","poem":1},{"text":"ug naghulat sa pagpamati kanako.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kay ang tawo nga nangita kanako makaangkon","poem":1},{"text":"sa maayo ug taas nga kinabuhi,","poem":2},{"lineBreak":true},{"text":"ug pakamaayohon siya sa Ginoo.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Apan ang tawo nga wala mangita kanako,","poem":1},{"text":"nagsakit lang sa iyang kaugalingon.","poem":2},{"lineBreak":true},{"text":"Ang tanang mga nasuko kanako gusto ug kamatayon.”","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"mga opisyal…matarong: sa Septuagint ug sa ubang mga manuskrito sa Hebreo, mga opisyal nga nagdumala sa kalibotan.","reference":{"chapter":8,"verse":16}},{"noteId":16,"caller":"+","text":"kauban: o gimugna.","reference":{"chapter":8,"verse":22}},{"noteId":17,"caller":"+","text":"arkitekto: dili klaro sa Hebreo. Posible usab, gamay nga bata o masaligan nga higala.","reference":{"chapter":8,"verse":30}}]},"thisChapterLink":"/api/ceb_ocb/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":33}