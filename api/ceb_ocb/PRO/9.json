{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PRO","translationId":"ceb_ocb","name":"Mga Panultihon","commonName":"Mga Panultihon","title":"Ang Libro sa Mga Panultihon","order":20,"numberOfChapters":31,"sha256":"e05019477769e8c2f9f61b1cdec8f29ce25ec3f798491f5640c1a9088d00e9ba","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ceb_ocb/PRO/31.json","totalNumberOfVerses":900},"chapter":{"number":9,"content":[{"type":"heading","content":["Ang Kaalam ug ang Kabuang"]},{"type":"verse","number":1,"content":[{"text":"Ang kaalam sama sa usa ka tawo nga nagpatukod","poem":1},{"text":"ug dako ug matahom nga balay.","poem":2},{"noteId":18}]},{"type":"verse","number":2,"content":[{"text":"Nagpakombira siya;","poem":1},{"text":"gaandam ug mga pagkaon ug ilimnon.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unya gisugo niya","poem":1},{"text":"ang iyang mga sulugoong babaye nga moadtog","poem":2},{"lineBreak":true},{"text":"habog nga mga dapit sa lungsod aron imantala kini:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Kamong mga walay alamag ug pagsabot,","poem":1},{"text":"giimbitar kamo sa kombira.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Panganhi kamo aron mokaon","poem":1},{"text":"ug moinom sa akong giandam.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Undanga na ang inyong pagkawalay-alamag","poem":1},{"text":"aron padayon kamong mabuhi.","poem":2},{"lineBreak":true},{"text":"Pagkinabuhi kamo nga adunay pagsabot.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kon badlongon mo ang tawong mabiay-biayon,","poem":1},{"text":"insultohon ka niya.","poem":2},{"text":"Kon badlongon mo ang tawong daotan,","poem":1},{"text":"pasipad-an ka niya.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ayaw badlonga ang tawong mabiay-biayon","poem":1},{"text":"kay kapungtan ka niya.","poem":2},{"text":"Badlonga ang tawong maalamon","poem":1},{"text":"ug higugmaon ka niya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tudloi ang maalamon, ug mahimo siyang mas maalamon.","poem":1},{"text":"Tudloi ang tawong matarong ug madugangan","poem":2},{"lineBreak":true},{"text":"pa gayod ang iyang kahibalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kon gusto ka magmaalamon, tahora ang Ginoo.","poem":1},{"text":"Kon ilhon mo ang Balaan nga Dios,","poem":2},{"lineBreak":true},{"text":"makaangkon kag maayong panabot.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pinaagi sa kaalam,","poem":1},{"text":"motaas ang imong kinabuhi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kon maalamon ka, makahatag kini kanimog kaayohan,","poem":1},{"text":"apan kon isalikway mo ang kaalam, ikaw ray mag-antos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ang kabuang sama sa usa ka babayeng sabaan,","poem":1},{"text":"walay alamag, ug walay kahibalo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Maglingkod siya sa pultahan","poem":1},{"text":"sa iyang balay o sa habog nga mga dapit sa lungsod,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ug manawag sa mga molabay","poem":1},{"text":"nga nagpadulong sa ilang mga trabaho.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Moingon siya, “Kamong mga walay alamag, dali kamo dinhi.”","poem":1},{"text":"Ug ingon pa niya sa mga walay panabot,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“Mas lami ang tubig nga kinawat","poem":1},{"text":"ug mas lami ang pagkaon nga kan-on sa tago.”","poem":2},{"noteId":19}]},{"type":"verse","number":18,"content":[{"text":"Apan wala masayod ang mga tawo","poem":1},{"text":"nga ang moadto kaniya mamatay.","poem":2},{"lineBreak":true},{"text":"Ang nakaadto na kaniya anaa na karon sa dapit sa mga patay.","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"dako ug matahom nga balay: sa literal, balay nga adunay pito ka haligi.","reference":{"chapter":9,"verse":1}},{"noteId":19,"caller":"+","text":"Tingali ang buot ipasabot nga ang gidili mao hinuoy lami.","reference":{"chapter":9,"verse":17}}]},"thisChapterLink":"/api/ceb_ocb/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}