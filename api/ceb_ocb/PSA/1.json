{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Bulahan ang tawo nga wala nagkinabuhi","poem":1},{"text":"sumala sa tambag sa mga daotang tawo,","poem":2},{"text":"wala nagsunod sa ginabuhat sa mga makasasala,","poem":1},{"text":"ug wala nakig-uban sa mga bugal-bugalon.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kondili, nalipay siya sa pagsunod","poem":1},{"text":"sa mga katudloanan nga gikan sa Ginoo,","poem":2},{"lineBreak":true},{"text":"ug nagpamalandong siya niini adlaw ug gabii.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sama siya sa kahoy nga gitanom sa daplin sa sapa,","poem":1},{"text":"nga mamunga sa panahon sa tingbunga,","poem":2},{"text":"ug dili malaya ang mga dahon.","poem":1},{"text":"Ug ang tanan niyang buhaton magmalampuson.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Apan dili ingon niana ang mga tawong daotan;","poem":1},{"text":"sama sila sa tahop nga paliron lang sa hangin.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Busa sa adlaw sa paghukom, silotan sila sa Dios,","poem":1},{"text":"ug dili sila iipon sa mga matarong.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kay ginagiyahan sa Ginoo ang pagkinabuhi","poem":1},{"text":"sa mga matarong,","poem":2},{"text":"apan ang pagkinabuhi sa mga daotan maghatod kanila","poem":1},{"text":"ngadto sa kalaglagan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ceb_ocb/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}