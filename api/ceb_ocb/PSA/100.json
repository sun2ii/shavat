{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":100,"content":[{"type":"hebrew_subtitle","content":["Awit sa Pagpasalamat."]},{"type":"verse","number":1,"content":[{"text":"Kamong mga katawhan sa tibuok kalibotan,","poem":1},{"text":"panghugyaw kamo sa kalipay ngadto sa Ginoo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Alagari ninyo ang Ginoo uban ang kalipay.","poem":1},{"text":"Duol kamo kaniya nga naghugyaw sa pagmaya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ilha ninyo nga ang Ginoo, Dios!","poem":1},{"text":"Siya ang naghimo kanato ug iya kita","poem":2},{"noteId":153},{"text":".","poem":2},{"lineBreak":true},{"text":"Iya kitang katawhan nga giatiman niya sama sa mga karnero.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sulod kamo sa iyang Templo uban ang pagdayeg ug pagpasalamat.","poem":1},{"text":"Dayega ninyo siya ug pasalamati.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kay maayo ang Ginoo;","poem":1},{"text":"ang iyang gugma walay kataposan,","poem":2},{"lineBreak":true},{"text":"ug ang iyang pagkamatinumanon nagpadayon hangtod sa kahangtoran.","poem":2}]}],"footnotes":[{"noteId":153,"caller":"+","text":"ug iya kita: o ug dili ang atong kaugalingon.","reference":{"chapter":100,"verse":3}}]},"thisChapterLink":"/api/ceb_ocb/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}