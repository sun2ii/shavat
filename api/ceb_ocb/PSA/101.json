{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["Awit ni David."]},{"type":"verse","number":1,"content":[{"text":"Ginoo, mag-awit ako mahitungod sa imong gugma ug hustisya.","poem":1},{"text":"Mag-awit ako ug mga pagdayeg kanimo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Magkinabuhi ako nga walay ikasaway.","poem":1},{"text":"Kanus-a ka man moanhi kanako?","poem":2},{"lineBreak":true},{"text":"Magkinabuhi ako nga walay ikasaway sa akong palasyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dili ko tugotan ang kadaotan.","poem":1},{"text":"Gikasilagan ko pag-ayo ang binuhatan sa mga tawo nga mibiya sa Dios;","poem":2},{"lineBreak":true},{"text":"dili ko gayod buhaton kanang mga butanga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Molikay ako sa mga tawong daotan ug huna-huna;","poem":1},{"text":"dili ako moapil sa ilang kadaotan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Laglagon ko si bisan kinsa nga magbutang-butang sa iyang isigka-tawo.","poem":1},{"text":"Tapuson ko ang kadaotan sa mga garboso ug mapahitas-on.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Apan pakitaan ko ug kaayo ang mga tawo dinhi sa atong dapit nga matinumanon sa Dios","poem":1},{"text":"ug nagkinabuhi nga walay ikasaway.","poem":2},{"lineBreak":true},{"text":"Papuy-on ko sila uban kanako ug tugotan nga moalagad kanako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ang mga tawo nga limbongan ug bakakon dili makapuyo sa akong palasyo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Matag adlaw laglagon ko ang tanang mga tawong daotan dinhi sa atong dapit,","poem":1},{"text":"aron mahanaw sila sa siyudad sa Ginoo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ceb_ocb/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}