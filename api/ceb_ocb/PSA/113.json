{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Dayega ang Ginoo!","poem":1},{"lineBreak":true},{"text":"Kamong mga katawhan sa Ginoo nga iyang mga alagad, dayega ninyo siya!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hinaut nga dayegon siya karon ug hangtod sa kahangtoran.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Gikan sa sidlakan hangtod sa kasadpan","poem":1},{"noteId":175},{"text":"ang tanang mga tawo angayng modayeg sa Ginoo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Naghari ang Ginoo sa tanang nasod,","poem":1},{"text":"ang iyang pagkagamhanan dili matupngan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wala gayoy sama sa Ginoo nga atong Dios","poem":1},{"text":"nga naglingkod sa iyang trono didto sa kahitas-an.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Moduko siya sa pagtan-aw","poem":1},{"noteId":176},{"text":"sa kalangitan ug sa kalibotan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gihaw-as niya ang mga kabos ug timawa sa ilang kalisod.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gipasidunggan niya sila uban sa dungganong mga tawo sa iyang katawhan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gilipay niya ang panimalay sa baog nga babaye","poem":1},{"text":"pinaagi sa paghatag kaniya ug mga anak.","poem":2},{"lineBreak":true},{"text":"Dayega ang Ginoo!","poem":1}]}],"footnotes":[{"noteId":175,"caller":"+","text":"Gikan sa sidlakan hangtod sa kasadpan: o Gikan sa pagsubang sa adlaw hangtod sa pagsalop niini.","reference":{"chapter":113,"verse":3}},{"noteId":176,"caller":"+","text":"Tingali mas taas pa ang iyang nahimutangan kay sa kalangitan, ug kay nabalaka siya sa iyang mga binuhat.","reference":{"chapter":113,"verse":6}}]},"thisChapterLink":"/api/ceb_ocb/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}