{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Ang mga Israelinhon nga kaliwat ni Jacob","poem":1},{"text":"nagpuyo kaniadto didto sa Ehipto diin lahi","poem":2},{"lineBreak":true},{"text":"ang pinulongan sa mga tawo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sa dihang mibiya na sila sa Ehipto,","poem":1},{"text":"gihimo sa Dios ang Juda nga iyang balaang dapit,","poem":2},{"lineBreak":true},{"text":"ug gidumalahan niya ang Israel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sa pag-abot sa mga Israelinhon didto sa Pulang Dagat,","poem":1},{"text":"daw tawo kini nga mitan-aw kanila ug midagan.","poem":2},{"text":"Ang tubig sa Suba sa Jordan daw tawo usab nga miatras.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ang mga bukid ug mga bungtod daw mga kanding","poem":1},{"text":"ug mga karnero nga naglukso-lukso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nganong midagan man ang Pulang Dagat","poem":1},{"text":"ug miatras ang tubig sa Suba sa Jordan?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nganong naglukso-lukso ang mga bukid","poem":1},{"text":"ug mga bungtod nga daw mga kanding ug mga karnero?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mokurog ang kalibotan sa presensya sa Ginoo nga Dios ni Jacob,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"nga naghimo ug linaw gikan sa gahing bato","poem":1},{"text":"ug mipadagayday sa mga tuboran.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ceb_ocb/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}