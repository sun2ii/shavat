{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Ang awit samtang gatungas."]},{"type":"verse","number":1,"content":[{"text":"Sa akong kalisod, nanawag ako sa Ginoo","poem":1},{"text":"ug gitubag niya ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ginoo, luwasa ako sa mga bakakon ug mga limbongan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kamong mga limbongan, unsa kahay isilot sa Dios kaninyo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Silotan niya kamo pinaagi sa talinis nga pana sa sundalo","poem":1},{"text":"ug sa nagdilaab nga baga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alaot ako kay nagpuyo ako uban kaninyo nga sama kadaotan","poem":1},{"text":"sa mga lumulupyo sa Meshec ug sa Kedar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dugay na akong nagpuyo uban sa mga tawo nga dili gustog kalinaw.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gusto kog kalinaw","poem":1},{"text":"apan kon maghisgot na gani ako mahitungod niini,","poem":2},{"lineBreak":true},{"text":"ang ilang gusto kagubot.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ceb_ocb/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}