{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["Ang awit samtang gatungas."]},{"type":"verse","number":1,"content":[{"text":"Nagtan-aw ako sa mga bukid;","poem":1},{"text":"asa man maggikan ang akong gipaabot nga tabang?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ang maong tabang maggikan sa Ginoo,","poem":1},{"text":"nga nagbuhat sa langit ug sa yuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dili niya itugot nga mapandol ka.","poem":1},{"text":"Siya nga nagtipig kanimo, dili matulog.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pamati! Ang nagtipig sa Israel wala magduka o matulog.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ang Ginoo mao ang imong tigpanalipod;","poem":1},{"text":"anaa siya sa imong tapad aron sa pagpanalipod kanimo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ang kainit sa adlaw dili makaunsa kanimo,","poem":1},{"text":"ni ang siga sa bulan sa panahon sa kagabhion.","poem":2},{"noteId":192}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tipigan ka sa Ginoo gikan sa tanang katalagman;","poem":1},{"text":"ampingan niya ang imong kinabuhi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ang Ginoo motipig kanimo","poem":1},{"text":"karon ug hangtod sa kahangtoran, bisan asa ka moadto.","poem":2},{"noteId":193}]}],"footnotes":[{"noteId":192,"caller":"+","text":"Ang labihan nga kainit sa adlaw makadaot ug ang pag-usab-usab sa bulan gituohan nga makahatag ug sakit.","reference":{"chapter":121,"verse":6}},{"noteId":193,"caller":"+","text":"bisan…moadto: o sa imong paglakaw ug pagbalik.","reference":{"chapter":121,"verse":8}}]},"thisChapterLink":"/api/ceb_ocb/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}