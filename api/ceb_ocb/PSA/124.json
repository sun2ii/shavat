{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["Ang awit samtang gatungas ni David."]},{"type":"verse","number":1,"content":[{"text":"Kon wala pa modapig ang Ginoo kanato, unsa kaha ang mahitabo?","poem":1},{"text":"Tubag kamo mga taga-Israel!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Kon wala pa modapig ang Ginoo kanato","poem":1},{"text":"sa dihang gisulong kita sa mga kaaway,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"gipatay na unta nila kita tungod sa ilang labihang kasuko kanato.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Daw gilapawan na unta kita sa tubig;","poem":1},{"text":"gianod sa makusog nga baha ug nalumos.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Dalaygon ang Ginoo, kay wala siya motugot nga kunis-kunison kita","poem":1},{"text":"sa atong mga kaaway nga sama sa mabangis nga mga mananap.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nakaikyas kita nga daw langgam nga nakabuhi gikan sa lit-ag.","poem":1},{"text":"Naguba ang lit-ag ug naluwas kita.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ang panabang nga atong nadawat naggikan sa Ginoo,","poem":1},{"text":"nga naghimo sa kalangitan ug sa kalibotan.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ceb_ocb/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":7}