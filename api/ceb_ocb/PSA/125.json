{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["Ang awit samtang gatungas."]},{"type":"verse","number":1,"content":[{"text":"Ang mga tawo nga nagsalig sa Ginoo sama sa Bukid sa Zion nga dili matarog,","poem":1},{"text":"kondili magpabilin sa walay kataposan.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Maingon nga ang mga bukid sa palibot sa Jerusalem","poem":1},{"text":"nagpanalipod sa maong siyudad,","poem":2},{"text":"ang Ginoo nagpanalipod usab","poem":1},{"text":"sa iyang katawhan karon ug hangtod sa kahangtoran.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ang daotan dili gayod magpadayon","poem":1},{"text":"sa pagdumala sa yuta nga alang sa mga matarong,","poem":2},{"lineBreak":true},{"text":"kay tingalig mohimo usab ug daotan ang mga matarong.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ginoo, himoa ang maayo ngadto sa mga tawo nga maayo, ug sa nagkinabuhi nga matarong.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Apan siloti uban sa mga daotan ang imong mga katawhan nga nagsunod sa daotan.","poem":1},{"lineBreak":true},{"text":"Hinaut nga magmalinawon ang Israel!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ceb_ocb/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}