{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["Ang awit samtang gatungas."]},{"type":"verse","number":1,"content":[{"text":"Sa dihang gipauswag pag-usab sa Ginoo ang Zion,","poem":1},{"noteId":196},{"text":"daw nagdamgo lang kita.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nangatawa kita ug nag-awit sa kalipay.","poem":1},{"text":"Unya miingon ang ubang mga nasod,","poem":2},{"lineBreak":true},{"text":"“Naghimo ang Ginoo ug katingalahang mga butang alang kanila.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tinuod nga naghimo ang Ginoo ug katingalahang mga butang alang kanato,","poem":1},{"text":"ug labihan gayod ang atong kalipay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ginoo, pauswaga kami pag-usab,","poem":1},{"noteId":197},{"text":"maingon nga pabahaan ug tubig ang nauga nga mga sapa sa Negev.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ang nagpugas inubanan sa mga luha moani nga malipayon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sila nga naghilak samtang naglakaw dala ang binhi nga igpupugas","poem":1},{"text":"mag-awit nga malipayon sa kaulahian dala ang ilang mga abot.","poem":2}]}],"footnotes":[{"noteId":196,"caller":"+","text":"Sa dihang gipauswag…Zion: o Sa dihang gipabalik kita sa Ginoo sa Zion gikan sa pagkabihag.","reference":{"chapter":126,"verse":1}},{"noteId":197,"caller":"+","text":"pauswaga kami pag-usab: o ibalik kami sa among dapit.","reference":{"chapter":126,"verse":4}}]},"thisChapterLink":"/api/ceb_ocb/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}