{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["Ang awit samtang gatungas."]},{"type":"verse","number":1,"content":[{"text":"Bulahan kamong tanan nga nagtahod sa Ginoo,","poem":1},{"text":"ug nagkinabuhi subay sa iyang mga pamaagi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mapahimuslan ninyo ang inyong hinagoan;","poem":1},{"text":"magmalipayon kamo ug magmauswagon.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ang inyong asawa","poem":1},{"text":"mahisama sa usa ka mabungahong ubas","poem":2},{"lineBreak":true},{"text":"diha sa inyong panimalay,","poem":2},{"text":"ug ang inyong mga anak magtigom libot sa inyong mga lamisa","poem":1},{"text":"nga daw mga saha sa kahoyng olibo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ingon niini ang panalangin nga madawat sa mga tawo nga nagtahod sa Ginoo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hinaut pa nga panalanginan kamo sa Ginoo","poem":1},{"text":"gikan sa Zion.","poem":2},{"noteId":200},{"text":"Hinaut pa nga makita ninyo","poem":1},{"text":"ang pag-uswag sa Jerusalem sa tibuok ninyong kinabuhi,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ug hinaut nga makita pa ninyo ang inyong mga apo.","poem":1},{"lineBreak":true},{"text":"Hinaut pa nga makasinati sa maayo nga kahimtang ang Israel.","poem":2}]}],"footnotes":[{"noteId":200,"caller":"+","text":"Zion: sa Hebreo mao ang laing ngalan sa Jerusalem.","reference":{"chapter":128,"verse":5}}]},"thisChapterLink":"/api/ceb_ocb/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}