{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["Ang awit samtang gatungas."]},{"type":"verse","number":1,"content":[{"text":"Mga taga-Israel, isulti ninyo kini:","poem":1},{"text":"Gipaantos gayod kami sa hilabihan","poem":2},{"lineBreak":true},{"text":"sa among mga kaaway sukad pa sa pagkatukod sa among nasod.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Gipaantos gayod nila kami sa hilabihan sukad pa sa pagkatukod sa among nasod.","poem":1},{"text":"Apan wala gayod nila kami mapildi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gisamaran nilag lawom ang among likod;","poem":1},{"text":"mura kinig uma nga gidaro.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Apan matarong ang Ginoo, kay giluwas niya kami gikan sa pagpangulipon sa mga daotan.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hinaut nga magpahilayo ang tanang nagdumot sa Zion","poem":1},{"noteId":201},{"text":"tungod sa kaulaw.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hinaut nga mahisama sila sa mga sagbot nga nanubo sa atop sa balay,","poem":1},{"text":"nga sa pagturok pa lang nalaya na dayon.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Walay magpakabana sa pagtigom niini nga sagbot o modala niini nga binugkos.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Hinaut pa nga ang mga tawong moagi dili moingon kanila,","poem":1},{"text":"“Hinaut pa nga panalanginan kamo sa Ginoo!","poem":2},{"lineBreak":true},{"text":"Gipanalanginan namo kamo sa ngalan sa Ginoo.”","poem":2}]}],"footnotes":[{"noteId":201,"caller":"+","text":"Zion: mao usab ang Jerusalem.","reference":{"chapter":129,"verse":5}}]},"thisChapterLink":"/api/ceb_ocb/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}