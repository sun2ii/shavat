{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Ang awit alang sa maestro sa mga mag-aawit. Awit ni David."]},{"type":"verse","number":1,"content":[{"text":"Ginoo, hangtod kanus-a ka nga dili manumbaling kanako?","poem":1},{"text":"Hangtod ba sa kahangtoran?","poem":2},{"lineBreak":true},{"text":"Hangtod kanus-a ka magtago gikan kanako?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hangtod kanus-a ako mag-antos sa kaguol?","poem":1},{"text":"Hangtod kanus-a pa ako mag-antos sa tumang kasubo adlaw ug gabii?","poem":2},{"lineBreak":true},{"text":"Ug hangtod kanus-a ang pagdaog-daog kanako sa akong mga kaaway?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hatagi akog pagtagad, Ginoo nga akong Dios; tubaga ang akong pag-ampo.","poem":1},{"text":"Ibalik ang akong kusog,","poem":2},{"noteId":14},{"lineBreak":true},{"text":"kay kon dili, mamatay ako,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ug makaingon ang akong mga kaaway nga napildi na nila ako.","poem":1},{"text":"Kay malipay gayod sila kon malaglag ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nagsalig ako, Ginoo, sa imong gugma.","poem":1},{"text":"Ug nalipay gayod ako tungod kay imo akong luwason.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Awitan ka nako, Ginoo,","poem":1},{"text":"tungod kay sukad pa kaniadto maayo ka kanako.","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Ibalik ang akong kusog: sa literal, Hatagig kahayag ang akong mga mata.","reference":{"chapter":13,"verse":3}}]},"thisChapterLink":"/api/ceb_ocb/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}