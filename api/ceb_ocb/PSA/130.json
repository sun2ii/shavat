{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Ang awit samtang gatungas."]},{"type":"verse","number":1,"content":[{"text":"Tungod sa tumang kalisod nanawag ako kanimo, Ginoo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pamatia ang akong pagpakiluoy kanimo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ginoo, kon gilista mo pa ang among mga sala,","poem":1},{"text":"kinsa pa kahay mahibilin sa imong presensya?","poem":2},{"noteId":202}]},{"type":"verse","number":4,"content":[{"text":"Apan gipasaylo mo kami, busa amo kang ginatahod.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Naghulat gayod ako kanimo, Ginoo,","poem":1},{"text":"ug nagsalig ako sa imong pulong.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naghulat ako kanimo, Ginoo,","poem":1},{"text":"labaw pa sa paghulat sa mga tigbalantay sa kabuntagon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mga taga-Israel, salig kamo sa Ginoo,","poem":1},{"text":"kay mahigugmaon siya ug andam kanunay nga moluwas.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Siya mismo ang moluwas kaninyo","poem":1},{"text":"gikan sa tanan ninyong mga sala.","poem":2}]}],"footnotes":[{"noteId":202,"caller":"+","text":"mahibilin sa imong presensya: o makaikyas sa imong silot.","reference":{"chapter":130,"verse":3}}]},"thisChapterLink":"/api/ceb_ocb/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}