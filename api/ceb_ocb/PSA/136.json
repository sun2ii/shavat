{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"Pasalamati ang Ginoo kay maayo siya.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":2,"content":[{"text":"Pasalamati ang Dios nga labaw sa tanang mga dios.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":3,"content":[{"text":"Pasalamati ang Ginoo nga labaw sa tanang mga ginoo.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Siya lang gayod ang naghimo ug katingalahang mga butang.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":5,"content":[{"text":"Pinaagi sa iyang kaalam, gihimo niya ang kalangitan.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":6,"content":[{"text":"Gipahimutang niya ang yuta ibabaw sa katubigan.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":7,"content":[{"text":"Gihimo niya ang adlaw ug ang bulan.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":8,"content":[{"text":"Gihimo niya ang adlaw sa paghatag ug kahayag kon adlaw.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":9,"content":[{"text":"Gihimo niya ang bulan ug ang mga bitoon sa paghatag ug kahayag sa kagabhion.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gipamatay niya ang mga kamagulangang anak nga lalaki sa mga Ehiptohanon.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":11,"content":[{"text":"Gipagawas niya ang mga Israelinhon gikan sa Ehipto.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":12,"content":[{"text":"Gipagawas niya sila pinaagi sa iyang dakong gahom.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Gibahin niya ang Pulang Dagat.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":14,"content":[{"text":"Ug gipatabok niya ang iyang mga katawhan sa taliwala niini.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":15,"content":[{"text":"Apan gilumsan niya ang hari sa Ehipto","poem":1},{"noteId":212},{"text":"ug ang mga sundalo niini didto sa Pulang Dagat.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Gigiyahan niya ang iyang katawhan sa kamingawan.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Gipanglaglag niya ang gamhanang mga hari.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":18,"content":[{"text":"Gipamatay niya ang bantogang mga hari.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":19,"content":[{"text":"Gipatay niya si Sihon, nga hari sa mga Amorihanon.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":20,"content":[{"text":"Gipatay usab niya si Og, nga hari sa Basan.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":21,"content":[{"text":"Gihatag niya ang ilang yuta ngadto sa iyang katawhan aron ilang panag-iyahan.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":22,"content":[{"text":"Kining yutaa gipanag-iyahan sa katawhan sa Israel nga iyang mga alagad.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Gihinumdoman niya kita sa dihang gipildi kita sa atong mga kaaway.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":24,"content":[{"text":"Giluwas niya kita gikan sa atong mga kaaway.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"verse","number":25,"content":[{"text":"Gihatagan niya ug pagkaon ang tanan niyang mga binuhat.","poem":1},"Ang iyang gugma walay kataposan."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Pasalamati ang Dios sa langit.","poem":1},{"noteId":213},"Ang iyang gugma walay kataposan."]}],"footnotes":[{"noteId":212,"caller":"+","text":"hari sa Ehipto: sa Hebreo, Paraon.","reference":{"chapter":136,"verse":15}},{"noteId":213,"caller":"+","text":"Dios sa langit: o Dios nga anaa sa langit; o Dios nga naghimo sa langit; o Dios nga labaw sa tanan.","reference":{"chapter":136,"verse":26}}]},"thisChapterLink":"/api/ceb_ocb/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}