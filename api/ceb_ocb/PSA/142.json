{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Ang “Maskil” ni David sa dihang didto siya sa langub. Usa kini ka pag-ampo."]},{"type":"verse","number":1,"content":[{"text":"Nagpakitabang ako kanimo, Ginoo.","poem":1},{"text":"Nag-ampo ako nga kaloy-an mo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gisulti ko kanimo ang akong mga reklamo ug mga kalisdanan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kon mawad-an ako ug paglaom,","poem":1},{"text":"anaa ikaw nga mogiya kanako.","poem":2},{"text":"Sa akong agianan adunay lit-ag nga gibutang","poem":1},{"text":"ang akong mga kaaway.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tan-awa ang akong palibot, wala gayoy nagtabang kanako.","poem":1},{"text":"Walay gapanalipod ug nabalaka kanako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nagpakitabang ako kanimo, Ginoo;","poem":1},{"text":"ikaw ang akong tigpanalipod,","poem":2},{"lineBreak":true},{"text":"ikaw lang gayod ang akong kinahanglan dinhi sa kalibotan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Pamatia ang akong pagpangayo ug tabang,","poem":1},{"text":"kay wala na gayod akoy mahimo.","poem":2},{"text":"Luwasa ako sa mga tawong naglutos kanako,","poem":1},{"text":"kay mas kusgan sila kay kanako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pagawasa ako gikan sa pagkabilanggo","poem":1},{"text":"aron madayeg ka nako.","poem":2},{"text":"Unya mag-alirong kanako ang mga matarong","poem":1},{"text":"tungod kay maayo ka kanako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ceb_ocb/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}