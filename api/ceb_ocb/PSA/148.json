{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Dayega ang Ginoo!","poem":1},{"text":"Dayega ninyo ang Ginoo,","poem":2},{"lineBreak":true},{"text":"kamong anaa sa kalangitan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dayega ninyo siya,","poem":1},{"text":"tanan kamong iyang mga anghel,","poem":2},{"lineBreak":true},{"text":"nga iyang mga sundalo sa langit.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dayega ninyo siya, adlaw, bulan,","poem":1},{"text":"ug mga bitoon.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dayega ninyo siya, kinahabogang langit","poem":1},{"text":"ug katubigan sa kalangitan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Modayeg silang tanan sa Ginoo!","poem":1},{"text":"Kay sa iyang pagmando, nabuhat silang tanan.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gipahimutang niya sila sa ilang mga dapit","poem":1},{"text":"sa walay kataposan,","poem":2},{"text":"ug naghatag siya ug tulomanon","poem":1},{"text":"ug dili nila kini malapas.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dayega ninyo ang Ginoo,","poem":1},{"text":"kamong anaa sa kalibotan,","poem":2},{"text":"dagkong mga mananap sa kadagatan,","poem":1},{"text":"tanan nga anaa sa kinahiladman sa dagat,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"mga kilat, ulan nga ice, snow, mga panganod,","poem":1},{"text":"makusog nga hangin nga nagtuman sa iyang sugo,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"mga bukid, mga bungtod,","poem":1},{"text":"mga kahoy nga namunga o wala","poem":2},{"noteId":229},{"text":".","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dayega ninyo ang Ginoo,","poem":1},{"text":"tanang mga mananap, ihalas o dili,","poem":2},{"lineBreak":true},{"text":"mga mananap nga nagkamang, ug naglupad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dayega ninyo ang Ginoo,","poem":1},{"text":"kamong mga hari, mga opisyal, mga tigdumala,","poem":2},{"lineBreak":true},{"text":"ug tanang katawhan sa kalibotan,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"mga pamatan-on, mga tigulang,","poem":1},{"text":"ug mga kabataan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Modayeg silang tanan sa Ginoo,","poem":1},{"text":"kay labaw siya sa tanan.","poem":2},{"text":"Mas gamhanan siya kay sa tanang anaa","poem":1},{"text":"sa kalibotan ug kalangitan.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gilig-on niya ug gipasidunggan","poem":1},{"text":"ang iyang matinumanong katawhan,","poem":2},{"lineBreak":true},{"text":"ang Israel nga palangga niya kaayo.","poem":2},{"lineBreak":true},{"text":"Dayega ang Ginoo!","poem":1}]}],"footnotes":[{"noteId":229,"caller":"+","text":"wala: sa Hebreo, mga kahoyng sedro.","reference":{"chapter":148,"verse":9}}]},"thisChapterLink":"/api/ceb_ocb/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}