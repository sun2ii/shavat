as ug sa mga plawta.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dayega ninyo siya uban sa lanog sa mga simbal,","poem":1},{"text":"ug dayega siya uban ang makusog nga mga simbal.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ang tanan nga adunay kinabuhi padayega sa Ginoo.","poem":1},{"lineBreak":true},{"text":"Dayega ang Ginoo!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ceb_ocb/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}