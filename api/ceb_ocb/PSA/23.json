{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["Awit ni David."]},{"type":"verse","number":1,"content":[{"text":"Ikaw, Ginoo, mao ang akong magbalantay,","poem":1},{"text":"ug dili ako makabsan sa tanan kong gikinahanglan.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Daw karnero ako nga gipapahulay mo diha sa sabsabanan","poem":1},{"text":"nga abunda sa lunhawng mga sagbot,","poem":2},{"lineBreak":true},{"text":"ug gigiyahan ngadto sa tin-aw nga tubig.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gilig-on mo ako.","poem":1},{"text":"Gitultolan mo ako sa hustong dalan aron ikaw mapasidunggan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bisan pa ug maglakaw ako","poem":1},{"text":"sa walog nga labihan kangitngit,","poem":2},{"text":"dili ako mahadlok","poem":1},{"text":"tungod kay kauban ka nako.","poem":2},{"text":"Ang imong pagpanalipod ug paggiya","poem":1},{"noteId":28},{"text":"nagpalig-on kanako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Giandaman mo ako ug kombira samtang nagtan-aw","poem":1},{"text":"ang akong mga kaaway.","poem":2},{"text":"Gidihogan mo ug lana ang akong ulo ingon","poem":1},{"text":"nga imong pinasidunggang bisita.","poem":2},{"lineBreak":true},{"text":"Ug gipatuyangan mo ako sa ilimnon.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nakasiguro gayod ako nga ang imong kaayo ug gugma kanako magpadayon","poem":1},{"text":"sa tibuok kong kinabuhi.","poem":2},{"text":"Ug mopuyo","poem":1},{"noteId":29},{"text":"ako sa imong balay","poem":1},{"noteId":30},{"text":", Ginoo,","poem":1},{"text":"hangtod sa kahangtoran.","poem":2},{"noteId":31}]}],"footnotes":[{"noteId":28,"caller":"+","text":"Sa literal, gipanalipdan mo ako pinaagi sa imong bunal ug sungkod.","reference":{"chapter":23,"verse":4}},{"noteId":29,"caller":"+","text":"mopuyo: mao kini sa Septuagint; apan sa Hebreo, magbalik.","reference":{"chapter":23,"verse":6}},{"noteId":30,"caller":"+","text":"balay: tingali ang buot ipasabot, ang templo; o ang puloy-anan sa Dios sa langit.","reference":{"chapter":23,"verse":6}},{"noteId":31,"caller":"+","text":"hangtod sa kahangtoran: o sa walay kataposan.","reference":{"chapter":23,"verse":6}}]},"thisChapterLink":"/api/ceb_ocb/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}