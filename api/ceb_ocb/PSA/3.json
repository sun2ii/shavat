{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Ang awit ni David sa dihang nagpahilayo siya gikan sa iyang anak nga si Absalom."]},{"type":"verse","number":1,"content":[{"text":"Ginoo, kadaghan sa akong kaaway;","poem":1},{"text":"kadaghan sa nakigbatok kanako!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nag-ingon pa sila","poem":1},{"text":"nga dili kuno nimo ako luwason.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Apan ang tinuod,","poem":1},{"text":"ikaw ang taming nga nagpanalipod kanako.","poem":2},{"text":"Gihatagan mo ako","poem":1},{"text":"ug kadaogan batok sa akong mga kaaway,","poem":2},{"lineBreak":true},{"text":"ug gilig-on mo ako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sa dihang nagpakitabang ako kanimo, Ginoo,","poem":1},{"text":"imo akong gitubag didto sa imong balaang","poem":2},{"noteId":2},{"text":"bungtod.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tungod kay gibantayan mo ako,","poem":1},{"text":"makatulog ako ug makamata nga malinawon.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bisan pag linibong mga kaaway ang maglibot kanako,","poem":1},{"text":"dili ako mahadlok.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sige na Ginoo nga akong Dios,","poem":1},{"text":"luwasa ako!","poem":2},{"text":"Kaniadto imong gipakaulawan","poem":1},{"text":"ang tanan kong mga kaaway;","poem":2},{"lineBreak":true},{"text":"imong gikuha ang ilang katakos sa paghulga kanako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ikaw, Ginoo, ang nagluwas","poem":1},{"text":"ug nagpanalangin sa imong mga katawhan.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"balaang: o piniling.","reference":{"chapter":3,"verse":4}}]},"thisChapterLink":"/api/ceb_ocb/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}