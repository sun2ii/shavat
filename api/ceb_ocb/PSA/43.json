{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Pamatud-i, O Dios, nga wala akoy sala,","poem":1},{"text":"ug labani ako batok sa dili diosnong mga nasod.","poem":2},{"lineBreak":true},{"text":"Luwasa ako gikan sa limbongan ug daotang mga tawo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ikaw ang Dios nga nagpanalipod kanako.","poem":1},{"text":"Nganong gisalikway mo man ako?","poem":2},{"text":"Nganong kinahanglan pa man nga magsubo ako","poem":1},{"text":"tungod sa pagpangdaog-daog kanako sa mga kaaway?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lamdagi ako ug tudloi sa imong kamatuoran,","poem":1},{"text":"ug dad-a ako pagbalik sa imong Templo","poem":2},{"noteId":61},{"text":"didto sa balaang bungtod.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unya moadto ako sa imong halaran, O Dios,","poem":1},{"text":"ikaw nga naghatag kanako ug kalipay.","poem":2},{"text":"Magdayeg ako kanimo pinaagi sa pagtukar sa harpa,","poem":1},{"text":"O Dios ko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nganong maguol man ako ug mabalaka pag-ayo?","poem":1},{"text":"Mosalig ako kanimo, ug dayegon ka nako pag-usab,","poem":2},{"lineBreak":true},{"text":"ikaw nga akong Manluluwas ug Dios.","poem":2}]}],"footnotes":[{"noteId":61,"caller":"+","text":"Templo: sa literal, puloy-anan.","reference":{"chapter":43,"verse":3}}]},"thisChapterLink":"/api/ceb_ocb/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}