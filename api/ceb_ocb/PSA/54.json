{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Ang awit alang sa maestro sa mga mag-aawit. Gamita ang mga instrumento nga adunay mga kuwerdas. Ang “maskil” ni David human nga ang mga Zifonhon miadto kang Saulo ug misugilon nga si David nagtago sa ilang dapit."]},{"type":"verse","number":1,"content":[{"text":"O Dios, luwasa ako,","poem":1},{"text":"ug pamatud-i nga wala akoy sala pinaagi sa imong gahom.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pamatia ang akong mga pag-ampo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kay ang mga taga-laing dapit misulong","poem":1},{"text":"aron sa pagpatay kanako.","poem":2},{"lineBreak":true},{"text":"Mga bangis sila ug wala moila kanimo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Apan sigurado ako nga ikaw, O Dios,","poem":1},{"text":"mao ang akong magtatabang.","poem":2},{"lineBreak":true},{"text":"Ikaw Ginoo, ang akong tigpanalipod.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hinaut pa nga ang kadaotan nga gihimo sa akong mga kaaway mobalik kanila.","poem":1},{"text":"Sa imong pagkamatinumanon, O Dios, laglaga sila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ginoo, kinabubut-on ko nga maghalad kanimo.","poem":1},{"text":"Dayegon ka nako kay maayo ka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kay giluwas mo ako sa tanan kong kalisod,","poem":1},{"text":"ug nakita ko ang pagkapildi sa akong mga kaaway.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ceb_ocb/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}