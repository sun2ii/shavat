{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["Ang awit alang sa maestro sa mga mag-aawit. Gamita ang mga instrumento nga adunay mga kuwerdas."]},{"type":"verse","number":1,"content":[{"text":"O Dios, kaloy-i ug panalangini kami.","poem":1},{"text":"Ipakita kanamo ang imong kaayo,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"aron mahibaloan sa tanang mga kanasoran sa kalibotan","poem":1},{"text":"ang imong pamaagi ug kaluwasan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hinaut nga dayegon ka sa tanang mga katawhan, O Dios.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hinaut nga magmaya ug mag-awit sa kalipay","poem":1},{"text":"ang tanang katawhan sa kalibotan","poem":2},{"lineBreak":true},{"text":"tungod kay matarong ang imong paghukom kanila ug gigiyahan mo sila.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hinaut nga dayegon ka sa tanang mga katawhan, O Dios.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hinaut nga mohatag ug abot ang yuta.","poem":1},{"text":"Hinaut nga panalanginan kita sa atong Dios.","poem":2},{"text":"Ug hinaut nga ang tanang mga tawo","poem":1},{"text":"sa tibuok kalibotan","poem":2},{"noteId":93},{"text":"motahod kaniya.","poem":2}]}],"footnotes":[{"noteId":93,"caller":"+","text":"-7 tibuok kalibotan: sa literal, kinatumyan sa kalibotan.","reference":{"chapter":67,"verse":6}}]},"thisChapterLink":"/api/ceb_ocb/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":6}