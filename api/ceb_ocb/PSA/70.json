{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["Ang awit alang sa maestro sa mga mag-aawit. Ang awit ni David nga giawit panahon sa paghalad sa halad sa paghinumdom sa Ginoo."]},{"type":"verse","number":1,"content":[{"text":"Ginoong Dios, luwasa ako!","poem":1},{"text":"Tabangi dayon ako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hinaut unta nga ang mga nagtinguha sa pagpatay","poem":1},{"text":"kanako maulawan ug mataranta.","poem":2},{"text":"Hinaut unta nga ang mga gahandom sa akong","poem":1},{"text":"kalaglagan mangikyas ug maulawan.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hinaut unta nga ang mga nagbiay-biay kanako","poem":1},{"text":"matingala pag-ayo kay naulawan sila.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Apan hinaut nga ang tanang nagdangop kanimo","poem":1},{"text":"maglipay gayod tungod kanimo.","poem":2},{"text":"Hinaut nga ang mga nangandoy sa kaluwasan nga gikan kanimo","poem":1},{"text":"moingon kanunay, “Dalaygon ang Dios!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Apan ako kabos ug timawa.","poem":1},{"text":"Duol dayon kanako, O Dios!","poem":2},{"text":"Ikaw ang akong magtatabang ug manluluwas.","poem":1},{"text":"Ginoo, tabangi dayon ako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ceb_ocb/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}