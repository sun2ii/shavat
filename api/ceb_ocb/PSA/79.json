{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":79,"content":[{"type":"hebrew_subtitle","content":["Ang “Maskil” ni Asaf."]},{"type":"verse","number":1,"content":[{"text":"O Dios, gisulong sa mga taga-laing nasod","poem":1},{"text":"ang yuta nga imong gipanag-iyahan.","poem":2},{"text":"Gipasipad-an nila ang imong balaan nga Templo","poem":1},{"text":"ug giguba ang Jerusalem.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gipakaon nila sa mga langgam ug sa mabangis","poem":1},{"text":"nga mga mananap ang mga patayng lawas","poem":2},{"lineBreak":true},{"text":"sa imong matinumanon nga mga alagad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gipaagas nila nga daw tubig","poem":1},{"text":"sa tibuok Jerusalem","poem":2},{"lineBreak":true},{"text":"ang dugo sa imong katawhan,","poem":2},{"text":"ug walay bisan usa nga nahibilin","poem":1},{"text":"aron sa paglubong sa mga patay.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gipakaulawan kami ug gibiay-biay","poem":1},{"text":"sa mga nasod sa among palibot.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hangtod kanus-a, Ginoo,","poem":1},{"text":"ang imong kasuko kanamo?","poem":2},{"lineBreak":true},{"text":"Hangtod ba sa kahangtoran?","poem":2},{"text":"Hangtod kanus-a mosilaob nga daw kalayo","poem":1},{"text":"ang imong pagpangabugho?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ipakita ang imong kasuko","poem":1},{"text":"sa mga nasod ug mga gingharian","poem":2},{"lineBreak":true},{"text":"nga wala moila ug mosimba kanimo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kay gipamatay nila ang imong katawhan","poem":1},{"noteId":121},{"text":"ug gilaglag ang ilang nasod.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ayaw kami siloti tungod sa mga sala","poem":1},{"text":"sa among mga katigulangan.","poem":2},{"text":"Kaloy-i hinuon kami kay","poem":1},{"text":"wala na gayod kamiy mahimo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tabangi kami, O Dios nga among manluluwas,","poem":1},{"text":"aron madayeg ang imong ngalan.","poem":2},{"text":"Luwasa kami ug pasayloa sa among mga sala","poem":1},{"text":"aron ikaw mapasidunggan.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nganong moingon man kanamo","poem":1},{"text":"ang ubang mga nasod,","poem":2},{"lineBreak":true},{"text":"“Hain na man ang inyong Dios?”","poem":2},{"text":"Samtang gatan-aw kami,","poem":1},{"text":"ipakita sa mga nasod nga ipanimalos mo","poem":2},{"lineBreak":true},{"text":"ang ilang pagpamatay sa imong mga alagad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Pamatia ang mga pag-agulo","poem":1},{"text":"sa imong mga katawhan nga binilanggo.","poem":2},{"text":"Gihukman sila nga patyon,","poem":1},{"text":"busa luwasa sila pinaagi sa imong gahom.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ginoo, balosi ug pito ka pilo","poem":1},{"text":"ang mga nasod sa ilang pagpakaulaw kanimo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ug kaming imong katawhan,","poem":1},{"text":"nga gibantayan mo nga daw mga karnero,","poem":2},{"lineBreak":true},{"text":"magpasalamat kanimo sa walay kataposan.","poem":2},{"text":"Dayegon ka namo kanunay hangtod sa kahangtoran.","poem":1}]}],"footnotes":[{"noteId":121,"caller":"+","text":"ang imong katawhan: sa literal, si Jacob.","reference":{"chapter":79,"verse":7}}]},"thisChapterLink":"/api/ceb_ocb/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}