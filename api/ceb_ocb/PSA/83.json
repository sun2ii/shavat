{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["Ang awit ni Asaf."]},{"type":"verse","number":1,"content":[{"text":"O Dios, ayaw pagpakahilom. Lihok!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tan-awa ang imong mga kaaway,","poem":1},{"text":"gakaguliyang sila ug nagpasigarbo nga modaog sila.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nagplano sila sa tago batok sa katawhan nga imong gipanalipdan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Miingon sila, “Dali kamo! Laglagon ta ang nasod sa Israel","poem":1},{"text":"aron dili na kini mahinumdoman hangtod sa kahangtoran.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nagkauyon sila sa ilang daotang plano.","poem":1},{"text":"Naghimo silag kasabotan batok kanimo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sila mao ang mga Edomihanon,","poem":1},{"text":"Ishmaelinhon, Moabihanon, Hagarnon,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gebalihanon, Amonihanon, Amalekanhon,","poem":1},{"text":"Filistihanon, ug ang katawhan sa Tiro.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Miapil usab kanila ang Asiria","poem":1},{"text":"nga usa ka lig-ong kaabin","poem":2},{"lineBreak":true},{"text":"sa mga kaliwat ni Lot","poem":2},{"noteId":125},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Pildiha sila, Ginoo, sama sa imong gihimo sa mga Midianhon,","poem":1},{"text":"ug kang Sisera ug kang Jabin didto sa Yuta sa Kishon.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nangamatay sila sa Endor","poem":1},{"text":"ug ang ilang mga patayng lawas nangadunot sa yuta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Laglaga ang ilang mga pangulo sama sa imong gihimo","poem":1},{"text":"kang Oreb, kang Zeeb, kang Zeba,","poem":2},{"lineBreak":true},{"text":"ug kang Zalmuna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Miingon sila, “Angkonon nato","poem":1},{"text":"ang yuta sa Dios.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"O Dios ko, kataga sila sama sa abog","poem":1},{"text":"o sa tahop nga gipalid sa hangin.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sama sa kalayo nga molamoy","poem":1},{"text":"sa mga kakahoyan sa bukid,","poem":2},{"lineBreak":true},{"text":"gukda sila ug hadloka sa imong hangin ug bagyo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pakaulawi sila, Ginoo,","poem":1},{"text":"hangtod nga modangop sila kanimo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Hinaut pa nga maulawan sila","poem":1},{"text":"ug malisang sa walay kataposan.","poem":2},{"lineBreak":true},{"text":"Hinaut pa nga mamatay sila sa tumang kaulaw!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hinaut pa nga makaamgo sila nga ikaw, Ginoo,","poem":1},{"text":"mao lang ang Labing Halangdong Dios sa tibuok kalibotan.","poem":2}]}],"footnotes":[{"noteId":125,"caller":"+","text":"mga kaliwat ni Lot: tingali mao ang mga Moabihanon ug mga Amonihanon.","reference":{"chapter":83,"verse":8}}]},"thisChapterLink":"/api/ceb_ocb/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":17}