{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Ang awit sa mga anak ni Kora."]},{"type":"verse","number":1,"content":[{"text":"Gitukod sa Ginoo ang siyudad sa Zion","poem":1},{"noteId":131},{"text":"didto sa balaang mga bungtod.","poem":1},{"lineBreak":true},{"text":"Gihigugma niya kining siyudara","poem":1},{"text":"labaw sa tanang mga dapit sa Israel","poem":2},{"noteId":132},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Maayong mga butang ang gipanulti niya mahitungod","poem":1},{"text":"niining iyang siyudad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Miingon siya, “Kon ilista ko ang mga nasod nga nag-ila kanako,","poem":1},{"text":"i-apil ko ang Ehipto","poem":2},{"noteId":133},{"text":"ug ang Babilonia,","poem":2},{"lineBreak":true},{"text":"apil usab ang Filistia, Tiro, ug Etiopia","poem":2},{"noteId":134},{"text":".","poem":2},{"lineBreak":true},{"text":"Isipon ko ang ilang katawhan nga mga lumad sa Zion.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sa pagkatinuod isulti kini mahitungod sa Zion:","poem":1},{"text":"“Daghang mga katawhan ang isipon nga gipanganak dinhi.","poem":2},{"lineBreak":true},{"text":"Ug ang Labing Halangdong Dios gayod mao ang molig-on niining siyudara.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ilista unya sa Ginoo ang iyang mga katawhan","poem":1},{"text":"ug i-apil niya ang mga katawhan gikan sa ubang nasod","poem":2},{"lineBreak":true},{"text":"nga giisip niyang mga lumad sa Zion.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Silang tanan mosayaw ug moawit,","poem":1},{"text":"“Gikan sa Zion ang tanan natong panalangin!”","poem":2}]}],"footnotes":[{"noteId":131,"caller":"+","text":"-2 Zion: mao usab ang Jerusalem.","reference":{"chapter":87,"verse":1}},{"noteId":132,"caller":"+","text":"-2 Israel: sa Hebreo, Jacob.","reference":{"chapter":87,"verse":1}},{"noteId":133,"caller":"+","text":"Ehipto: sa Hebreo, Rahab. Mao kini ang tawag sa dragon nga nagrepresentar sa Ehipto.","reference":{"chapter":87,"verse":4}},{"noteId":134,"caller":"+","text":"Etiopia: sa Hebreo, Cush.","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/ceb_ocb/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":6}