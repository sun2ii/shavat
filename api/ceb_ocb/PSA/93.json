{"translation":{"id":"ceb_ocb","name":"Biblica® Open Ang Pulong sa Dios","website":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cebocb","licenseNotes":null,"shortName":"OCB","englishName":"Cebuano: Biblica® Open Ang Pulong sa Dios (Bible)","language":"ceb","textDirection":"ltr","sha256":"c2ba1672c587aa9a9977a6e528dcbc0957b0ff580348dd9bb9b7a413cd9070e1","availableFormats":["json"],"listOfBooksApiLink":"/api/ceb_ocb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30552,"languageName":"Cebuano","languageEnglishName":"Cebuano"},"book":{"id":"PSA","translationId":"ceb_ocb","name":"Mga Salmo","commonName":"Mga Salmo","title":"Ang Libro sa Mga Salmo","order":19,"numberOfChapters":150,"sha256":"cbaa709b9a39120b966983a08bfd237339a4ee32d4c62852a160b99e5609d5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/ceb_ocb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ceb_ocb/PSA/150.json","totalNumberOfVerses":2435},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Hari ka, Ginoo! Ang imong harianong bisti","poem":1},{"text":"mao ang imong pagkagamhanan ug pagkahalangdon.","poem":2},{"text":"Gipahimutang mo nga lig-on ang kalibotan","poem":1},{"text":"ug dili kini matarog.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hari ka na sukad pa sa sinugdan,","poem":1},{"text":"kay anaa ka na sukad pa kaniadto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nagdaguok ang suba, Ginoo,","poem":1},{"text":"ug nagdahunog ang bul-og niini.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Apan mas gamhanan ka, Ginoo nga anaa sa langit,","poem":1},{"text":"kaysa dinahunog sa dagat;","poem":2},{"lineBreak":true},{"text":"mas gamhanan ka kaysa mga balod niini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ginoo, ang imong mga sugo kasaligan gayod.","poem":1},{"text":"Ug ang imong Templo balaan sa walay kataposan.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ceb_ocb/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ocb/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ocb/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}