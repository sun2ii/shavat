 kahangtoran."]}],"footnotes":[]},"thisChapterLink":"/api/ceb_ulb/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ulb/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ulb/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}