130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ceb_ulb/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ceb_ulb/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}