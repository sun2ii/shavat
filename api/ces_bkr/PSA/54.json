{"translation":{"id":"ces_bkr","name":"Bible Kralická 1613","website":"https://ebible.org/Scriptures/details.php?id=ces1613","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ces1613","licenseNotes":null,"shortName":"BKR","englishName":"Czech Kralická Bible 1613","language":"ces","textDirection":"ltr","sha256":"a52ae07a90daab5b53d32dc82281f9d3ef18f37b82f79c71844e747be720a15d","availableFormats":["json"],"listOfBooksApiLink":"/api/ces_bkr/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31172,"languageName":"čeština","languageEnglishName":"Czech"},"book":{"id":"PSA","translationId":"ces_bkr","name":"Žalmy","commonName":"Žalmy","title":"Žalmy","order":19,"numberOfChapters":150,"sha256":"2a3497d0cba49439e9f06d3a4d9406cead346d8c06c892eba045393529c3ef8c","firstChapterNumber":1,"firstChapterApiLink":"/api/ces_bkr/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ces_bkr/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":["Přednímu z kantorů na neginot, vyučující žalm Davidův,"]},{"type":"verse","number":2,"content":["Když přišli Zifejští, a řekli Saulovi: Nevíš-liž, že se David pokrývá u nás?"]},{"type":"verse","number":3,"content":["Bože, spasena mne učiň pro jméno své, a v moci své veď při mou."]},{"type":"verse","number":4,"content":["Bože, slyš modlitbu mou, pozoruj řeči úst mých."]},{"type":"verse","number":5,"content":["Neboť jsou cizí povstali proti mně, a ukrutníci hledají duše mé, nepředstavujíce sobě Boha před oblíčej svůj. Sélah."]},{"type":"verse","number":6,"content":["Aj, Bůhť jest spomocník můj; Pán s těmi jest, kteříž jsou podpůrcové života mého."]},{"type":"verse","number":7,"content":["Odplať zlým nepřátelům mým, v pravdě své vypleň je, ó Pane."]},{"type":"verse","number":8,"content":["I buduť dobrovolně oběti obětovati, slaviti budu jméno tvé, Hospodine, proto že jest dobré."]},{"type":"verse","number":9,"content":["Nebo z ssoužení všelikého vytrhl mne Bůh, nýbrž i pomstu nad nepřátely mými vidělo oko mé."]}],"footnotes":[]},"thisChapterLink":"/api/ces_bkr/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ces_bkr/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ces_bkr/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}