{"translation":{"id":"ces_bkr","name":"Bible Kralická 1613","website":"https://ebible.org/Scriptures/details.php?id=ces1613","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ces1613","licenseNotes":null,"shortName":"BKR","englishName":"Czech Kralická Bible 1613","language":"ces","textDirection":"ltr","sha256":"a52ae07a90daab5b53d32dc82281f9d3ef18f37b82f79c71844e747be720a15d","availableFormats":["json"],"listOfBooksApiLink":"/api/ces_bkr/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31172,"languageName":"čeština","languageEnglishName":"Czech"},"book":{"id":"PSA","translationId":"ces_bkr","name":"Žalmy","commonName":"Žalmy","title":"Žalmy","order":19,"numberOfChapters":150,"sha256":"2a3497d0cba49439e9f06d3a4d9406cead346d8c06c892eba045393529c3ef8c","firstChapterNumber":1,"firstChapterApiLink":"/api/ces_bkr/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ces_bkr/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":61,"content":[{"type":"verse","number":1,"content":["Přednímu z kantorů na neginot, Davidův."]},{"type":"verse","number":2,"content":["Slyš, ó Bože, volání mé, pozoruj modlitby mé."]},{"type":"verse","number":3,"content":["Od konce země v sevření srdce svého k tobě volám, na skálu nade mne vyšší uvediž mne."]},{"type":"verse","number":4,"content":["Nebo jsi býval mé útočiště, a pevná věže před tváří nepřítele."]},{"type":"verse","number":5,"content":["Buduť bydliti v stánku tvém na věky, schráním se v skrýši křídel tvých. Sélah."]},{"type":"verse","number":6,"content":["Ty jsi zajisté, Bože, vyslyšel žádosti mé, dal jsi dědictví bojícím se jména tvého."]},{"type":"verse","number":7,"content":["Ke dnům krále více dnů přidej, ať jsou léta jeho od národu do pronárodu,"]},{"type":"verse","number":8,"content":["Ať bydlí na věky před tváří Boží; milosrdenství a pravdu nastroj, ať ho ostříhají."]},{"type":"verse","number":9,"content":["A tak žalmy zpívati budu jménu tvému na věky, a sliby své plniti budu den po dni."]}],"footnotes":[]},"thisChapterLink":"/api/ces_bkr/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ces_bkr/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ces_bkr/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}