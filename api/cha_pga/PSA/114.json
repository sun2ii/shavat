{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"ANAE si Israel jumanao juyong Egipto, y guima Jacob guinin y taotao y finijo na ti matungo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Juda jumuyong y santos na sagaña, yan Israel y gobietnoña.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Y tase jalie ayo, yan malago; Jordan masugon tate.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Y beca sija manayog taegüije y quinilo laje yan y mandiquique ogso sija taegüije y manpatgon na quinilo sija.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Jafa guaja guiya jago, O tase, na malagojao? Jago Jordan ni y masugon tate?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jamyo ni y beca sija ni y manayog taegüije y quinilo laje; yan jamyo di quique na ogso sija taegüije y manpatgon na quinilo sija?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mayeyengyong, jago tano, gui menan Jeova, gui menan y Yuus Jacob;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ni y jafaacho y jagoe janom, ya jafagagot y tutujon janom sija.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}