{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"verse","number":1,"content":[{"text":"Y Cantan Quinajulo. JUJATSA julo y atadogco gui sabana: guinin mamano mague y umayuyudayo?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Y umayuyudayo guinin as Jeova, ni y fumatinas y langet yan y tano.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ti upolo y adengmo na umanacalamten: ayo y umadadajejao ti umatujog.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Estagüe, y umadadaje Israel ti umatujog ni ti umaego.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Si Jeova y umadadajejao: si Jeova nujongmo gui agapa na canaemo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Y atdao ti unninasague gui jaane, ni y pilan gui puenge.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Si Jeova uninadaje gui todo tinaelaye: güiya uadaje y antimo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Si Jeova uninadaje yan jumujuyongjao yan jumajalomjao, desde pago na tiempo yan para taejinecog.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}