{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"verse","number":1,"content":[{"text":"Y Cantan Quinajulo; iyon Salomon. YANGUIN ti si Jeova y jumatsa y guima, taebale y finatinasñija y manmachocho: yanguin ti si Jeova y umadaje y siuda, y guatdia magmamataja lao taebale.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Taebale y uncajulo taftaf, ya undescansa atrasao, ya uncano y pan pinite: sa jananaeja ni y güinaeyaña y mamaego.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Estagüe, y famaguon erensian Jeova: ya yi tinegcha y tiyan, apasiña.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Jaftaemanoja y flecha gui canae y matatnga na taotao; taegüijeja locue y famaguon y manpatgon.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Magof y taotao yanguin bula y questat y flechaña nu sija: ti ufanmamajlao, lao ufanguentos yan y enemigo sija gui trangca.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}