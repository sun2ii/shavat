y famaguonmo. Pas ugaegue guiya Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}