{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"verse","number":1,"content":[{"text":"Y Cantan Quinajulo. MEGAE na tiempo nae manapiniteyo desde y pinatgonjo: polo ya ualog Israel pago:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Megae na tiempo nae manapiniteyo desde y pinatgonjo: lao trabia ti mangana ni y ninasiñañija contra guajo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Y manmanalado jaalado gui jilo y tatalojo: janafananaco y sutcoñija.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Si Jeova tunaegüe: güiya umutut y cuetdas y manaelaye.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Polo ya ufanmamajlao todo ayo y bumira sija tate, todo sija y chumatlie Sion.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Polo ya ufantaegüije y chaguan gui jilo guma, ni y anglo antes di udoco:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ya chaña y manuutut chaguan munabubula y canaeña, ni y pechonña y manmanonojo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ni ujaalog ayo sija y manmalolofan, Y bendision Jeova usaga gui jilomo; jame bumendise jao pot y naan Jeova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}