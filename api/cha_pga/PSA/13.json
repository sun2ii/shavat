{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"ASTA ngaean, O Jeova, nae, umalefa jao guajo para taejinecog? asta ngaean nae unnaatog y matamo guiya guajo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Asta ngaean nae jujaso y pinagat gui antijo, anae guaja pinite gui corasonjo todo y jaane? Asta ngaean nae ufangajulo y enimigujo guiya guajo?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jaso ya jungogyo, O Jeova, Yuusso: ina y atadogjo sija para mungayo maego gui maego finatae.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sa chaña umaalog y enimigujo: Jugana güe: sa chaña y enimigujo fanmamagof yaguin calamtenyo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lao guajo, y minaasemo nae juangocoyo: ya umagof y corasonjo gui satbasionmo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bae cantaye si Jeova: sa jafatinas y mauleg guiya guajo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}