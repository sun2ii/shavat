{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"verse","number":1,"content":[{"text":"Y Cantan Quinajulo. Y sumanjiyong y tinadong nae juagang jao, O Jeova.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jeova, ecungog y inagangjo: polo ya talangamo sija uegueng gui inagang y guinagaojo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yanguin mojon unmatca y tinaelaye sija; Jeova, jaye utojgüe?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lao guaja inasie guiya jago, para unmamaañagüe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Junanangga si Jeova, y antijo mannanangga, ya y sinanganña junanangga.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Y antijo jananangga si Jeova, mas qui y guatdia sija ni manmannanangga y egaan: magajet na mas qui y guatdia sija manmannananangga y egaan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"O Israel nangga si Jeova; sa gui as Jeova guaja minaase, ya iya guiya nae megae na inalibre.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ya güiya unalibre Israel todo gui tinaelayeña.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}