{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":133,"content":[{"type":"verse","number":1,"content":[{"text":"Y Cantan Quinajulo; iyon David. ESTAGÜE, jafa munamauleg, yan jafa munamagof y mañelo ufañaga mañisija gui unoja.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Este parejo yan y mauleg na laña gui ilo, ni y mimilalag gui batbas, asta y batbas Aaron; ya jumajnanao papa asta y cueyon magaguña;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Taegüije serenon Hermon, ni y mamopodong gui jilo ogso guiya Sion; sa ayo nae mañago si Jeova y bendision, güiya taejinecog na linâlâ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/133.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/134.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/132.json","previousChapterAudioLinks":{},"numberOfVerses":3}