{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":150,"content":[{"type":"verse","number":1,"content":[{"text":"FANMANALABA jamyo as Jeova. Alaba si Yuus gui sinantos na sagaña: alaba gue gui feneda y ninasiñaña.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alaba güe ni y matatnga na finatinasña sija: alaba güe jaftaemanoja y minagas dinangculoña.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alaba güe ni y sonidon y trompeta: alaba güe ni y guitala yan y atpa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alaba güe ni y pandireta, yan y dansa: alaba güe ni y gaecuetdas na dandan yan y flauta.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alaba güe ni y agang na batingting: alaba güe ni gosagang na sonidon batingting.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Polo todo y güinaja ni y mangaejinagong ya ujaalaba si Jeova. Fanmanalaba jamyo as Jeova.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}