{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"SI Jeova güiya y pastotjo: tayayo unafatta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Y manbetde na chaguan nae janaason yo: ya y quieto na janom nae jaosgaejon yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jananalo y antijo: jaosgaejon yo gui chalan tininas pot y naanña.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yaguin jufamocat gui chalan y anineng y finatae, ti maañao yo ni jafa na taelaye, sa jago gaegue guiya guajo: y baramo yan y bastonmo unnae yo minagof.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Unfamauleg y lamasa gui menajo yan y menan y enimigujo sija: naye laña y ilujo, ya y copajo esta machúchuda.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sen magajet y minauleg yan y minaase madalalagyo todo nu sija gui jaanen linâlâjo: ya y guima Jeova jusaga para taejinecog na jaane.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}