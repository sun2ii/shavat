{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"JEOVA, jafa muna manlajyan y enimigujo! Megae mangajulo contra guajo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Megae umaalog ni y antijo: Taya inayuda para güiya, gui as Yuus. Sila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lao jago, O Jeova, jago y patang gui oriyajo; y minalagjo yan ayo ni y janacajulo y ilujo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ya y inagangjo juagang si Jeova, ya güiyaja umopeyo gui santos na ogsoña. Sila.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bae juason ya maegoyo; ya magmatayo; sa si Jeova gumuguutyo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ti maañaoyo nu y dies mit na taotao, ni y mapolo sija gui oriyajo contra guajo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Cajulo, O Jeova; nalibre yo, O Yuusso: sa jago manalamen todo y enimigujo ni y guijadas; y nifen y manaelaye unyamag.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gui as Jeova nae gaegue y satbasion: ya y taotaomo nae gaegue y bendisonmo. Sila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}