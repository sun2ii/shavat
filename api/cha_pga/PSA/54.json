{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"SATBAYO, O Yuus, pot y naanmo, ya unjusgayo pot y minetgotmo.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jungog y tinaetaejo, O Yuus; ecungog y sinangan y pachotto.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sa y taotao juyong sija mangajulo contra guajo, yan y taotao ni y fijon y minatatgañija maaliligao y antijo; sija jagasja ti japopolo si Yuus gui menanñija. Sila.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Estagüe na si Yuus umayuyudayo; si Jeova mañisija yan ayo y mumantietene y antijo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Güiya uapase taelaye y enemigujo sija; yulang sija gui minagajetmo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sa inefresijo ni y minalagojo bae junaejao; bae jualaba y naanmo, O Jeova, sa mauleg.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sa güiya munalibreyo todo gui chinatsaga: sa y atadogjo jagasja jalie y minalagojo contra y enemigujo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}