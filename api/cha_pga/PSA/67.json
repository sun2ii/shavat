{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"verse","number":1,"content":[{"text":"O Yuus, gaease ni jame ya unbendisejam: yan janafanmalag y mataña gui jilomame. Sila.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Para usiña matungo y chalanmo gui jilo y tano yan y satbasionmo gui nasion todos:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Polo y taotao ya umatuna jao, O Yuus: polo y taotao todo ya umatuna.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"O, polo y nasion sija ya ufanmagof yan ufanganta ni y minagof: sa jago siempre jumusga y taotao gui tininas yan ungobietna y nasion sija gui jilo y tano. Sila.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Polo y taotao ya umatuna jao, O Yuus: polo y taotao todo ya umatuna.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ya y tano jagasja unajuyong megae tinegchaña: ya si Yuus ni y Yuusta ubendisejit.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Si Yuus ubendisejit: yan todo y uttimon y tano umaañao nu güiya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}