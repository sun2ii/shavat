{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"verse","number":1,"content":[{"text":"NACHADIG, O Yuus, para unalibreyo: nachadig umayudayo, O Yuus.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Polo sija ya ufanmamajlao yan ufaninistotba ni y umaliligao y antijo: polo sija ya ufanalo tate yan ufanmamajlao ni y manmagof nii desonraco.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Polo sija ya ufanalo tate para apas y minamajlaoñija ja ni y ilegñija: Aha, Aha.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Polo ayo todo y umaliligaojao ya unfanmagof yan ufansenmagof ni jago: ya polo ya ayo y gumaeya y satbasionmo ya ilelegñija siésiempreja: Umanasendangculo si Yuus.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lao guajo pobleyo yan nesesitaoyo: nachadig jao guiya guajo, O Yuus: sa jago umayuyudayo, yan y munalibreyo; O Jeova, chamo umatrasasao.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}