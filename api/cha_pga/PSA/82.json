{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"verse","number":1,"content":[{"text":"SI Yuus tumotojgue gui inetnon Yuus; ya jajusga gui entalo yuus sija.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Asta ngaean nae unjusga ti tunas, yan unresibe y taotao sija ni y manaelaye? Sila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jusga y mamoble yan y manaesaena: ya nafanunas y manpinite yan y mannesesitao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rescata mamoble yan y mannesesitao: nafanlibre sija gui canae y manaelaye.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sa ti jatungo ni ujaquetungo: manmamomocatja gui jalom jomjom: ya todo y plinantan tano manalamten.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Guajo ileco: Jamyo yuus; yan todo jamyo y famaguon y Gueftaquilo.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lao infanmataeja taegüije y taotao sija, yan infanbasnag taegüije y uno gui prinsipe sija.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Cajulo, O Yuus, jusga y tano: sa jago umerensia todo y nasion.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}