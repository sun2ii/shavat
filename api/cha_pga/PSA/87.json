{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"verse","number":1,"content":[{"text":"YPLINANTAÑA gaegue gui santos na ogso.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jaguaeyaña si Jeova y trangca Sion mas que todo y saga sija gui as Jacob.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Manmalag na güinaja y manmasasangan guiya jago, O siuda Yuus. Sila.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Guajo bae jusangan ni y Rahab yan Babilonia gui entalo ayo sija ni y tumunogyo: Sa, estagüe, Palestina yan Tiro yan Etiopia: este na taotao mafañagon güije.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yan iya Sion ualog: Este yan ayo na taotao mafañagon iya güiya: yan y Gueftaquilo namaesa unafitmegüe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Si Jeovaja tumufong anae jatugue sija y taotao, na esta na taotao mafañagon güije. Sila.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Parejo y mangacanta yan y madadandan ufangaegue güije: ya todo y bebôco gaegue guiya jago. Sila.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}