{"translation":{"id":"cha_pga","name":"Y CUATRO EBANGELIO SIJA YAN Y CHECHO Y APOSTOLES  YAN Y SALMO SIJA","website":"https://ebible.org/Scriptures/details.php?id=cha","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cha","licenseNotes":null,"shortName":"PGA","englishName":"Chamorro Gospels, Acts, and Psalms","language":"cha","textDirection":"ltr","sha256":"ffd97ba1f03e2b075d7bee9267dbe21fee0ee256e7c22149a4ebd0946a75d49d","availableFormats":["json"],"listOfBooksApiLink":"/api/cha_pga/books.json","numberOfBooks":6,"totalNumberOfChapters":267,"totalNumberOfVerses":7245,"languageName":"Chamorro","languageEnglishName":"Chamorro"},"book":{"id":"PSA","translationId":"cha_pga","name":"Y Salmo Sija","commonName":"Y Salmo Sija","title":"Y Salmo Sija","order":19,"numberOfChapters":150,"sha256":"2f5c2df3bf81de0d0db7e9f6ec1a8e21db29f7f25c1e2f531873ab54a2c13f8d","firstChapterNumber":1,"firstChapterApiLink":"/api/cha_pga/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cha_pga/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"SI Jeova jagobiebietna mabeste güe ni y ninasifia; si Jeova numabeste güe, ni y minetgot dinidog güe: y tano locue ninafitme ya ti siña manacalamten.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Y tronumo mafatinas desde di ampmam na tiempo: jago guinin y taejinecog.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mangajulo y minalag sija, O Jeova, ya y minalag sija mangajulo y inangangñija; y minalag sija mangajulo y napoñija.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mastaquilo y inagang sija y minegae y janom sija, yan y fijom na napo gui tase, si Jeova gui sanjilo gaesisiña.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Y testimoniomo sija mansenmagajet: sinantosja conbiene gui jalom guimamo, O Jeova, para taejinecog.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cha_pga/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cha_pga/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cha_pga/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}