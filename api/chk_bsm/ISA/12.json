{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"ISA","translationId":"chk_bsm","name":"AISEA","commonName":"AISEA","title":"Aisea","order":23,"numberOfChapters":66,"sha256":"2b2f3fa8b0a70f92ed54b63314e479fbbc4cbb72470c38b2e10ee384c5b111a3","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/chk_bsm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Echö kölün kilisou"]},{"type":"verse","number":1,"content":["Lon ena rän eman me eman epwe apasa,",{"text":"“Üa kilisou ngonuk, ai Samol mi Lapalap.","poem":1},{"lineBreak":true},{"text":"Ewer, ka song ngeniei, nge om song a kul seniei,","poem":1},{"lineBreak":true},{"text":"ka pwal achipaei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ellet, Kot ai Chon Amanau.","poem":1},{"lineBreak":true},{"text":"Üa lükü, nge üsap niuokus.","poem":1},{"lineBreak":true},{"text":"Kot ewe Samol mi Lapalap a ngeniei pöchökül me manaman.","poem":1},{"lineBreak":true},{"text":"Ewer, i ai Chon Amanau.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iwe, oupwe üfi koluk fän pwapwa","poem":1},{"lineBreak":true},{"text":"seni ewe chönüttun kolukun manau.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lon ena rän oupwe apasa,","poem":1},{"lineBreak":true},{"text":"“Ousipwe kilisou ngeni ewe Samol mi Lapalap o köri pwe epwe alisikich.","poem":1},{"lineBreak":true},{"text":"Ousipwe asilefeili lein chon ekewe mwü meinisin mine a föri","poem":1},{"lineBreak":true},{"text":"o aronga ngeniir pwe itan a tekia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ousipwe kölün mwareiti ewe Samol mi Lapalap, pun a föri föför mi amwarar,","poem":1},{"lineBreak":true},{"text":"nge chon fanüfan meinisin repwe silei usun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oupwe akapwas o köl fän pwapwa, ämi chon Sion,","poem":1},{"lineBreak":true},{"text":"pun Ewe mi Pin lon Israel a tekia me lefilemi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}