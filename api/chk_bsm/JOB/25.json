{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"JOB","translationId":"chk_bsm","name":"HIOP","commonName":"HIOP","title":"Hiop","order":18,"numberOfChapters":42,"sha256":"7518d60f467436b9e1de040e1ccb174f436f4729bb2bbf0bd5f5767658f0afcd","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/chk_bsm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["Piltat a amam pwe aramas resap tongeni pwüng fän mesen Kot"]},{"type":"verse","number":1,"content":[{"text":"Mürin, Piltat ewe re Shu a apasa,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Nemenem me niuokus ra nom ren Kot,","poem":1},{"lineBreak":true},{"text":"i a awora kinamwe lon an we läng mi tekia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ifa usun, eman a tongeni aleani iteiten nöün kewe chon läng?","poem":1},{"lineBreak":true},{"text":"Ifa usun, iön aramas än Kot saram esap tin won?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ifa usun än eman aramas epwe tongeni küna pwüng fän mesen Kot?","poem":1},{"lineBreak":true},{"text":"Ifa usun, eman mi uputiu seni eman fefin a tongeni limöch?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nengeni, pwal ewe maram esap saram,","poem":1},{"lineBreak":true},{"text":"nge ekewe fü resap limöch me fän mesan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nge eman aramas a kon kis seni, pun i eman möttö, nöün aramas a eman moso chök.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}