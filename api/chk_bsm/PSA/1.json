{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"heading","content":["Eman aramas mi pwüng me eman aramasangau"]},{"type":"verse","number":1,"content":[{"text":"Ra feiöch ekewe aramas resap fetal fän öüröüräen aramasangau,","poem":1},{"lineBreak":true},{"text":"resap apirü föförün ekewe chon tipis,","poem":1},{"lineBreak":true},{"text":"resap pwal nom ren ekewe chon turunufas,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"nge ra pwapwaiti än ewe Samol mi Lapalap allük","poem":1},{"lineBreak":true},{"text":"o ekieki usun lerän me lepwin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ätekewe ra wewe ngeni irä mi mär ünükün ekewe chanpupu,","poem":1},{"lineBreak":true},{"text":"ra ua lon fansoun räs,","poem":1},{"lineBreak":true},{"text":"nge chör resap aiolol.","poem":1},{"lineBreak":true},{"text":"Meinisin mine ra föri a fisiöch.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nge ekewe aramasangau resap iei usun.","poem":1},{"lineBreak":true},{"text":"Pun ra wewe ngeni pipi asepwäl a ässala.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Iei mine ekewe aramasangau resap üöch lon ewe ränin kapwüng,","poem":1},{"lineBreak":true},{"text":"nge ekewe chon tipis resap nom lon mwichen chon pwüng.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pun ewe Samol mi Lapalap a emweni o tümwünü ekewe chon pwüng,","poem":1},{"lineBreak":true},{"text":"nge ekewe aramasangau repwe fetal ngeni ewe lenien feiengau.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}