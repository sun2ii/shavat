{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"heading","content":["Eu pwon usun manau fän pwüng"]},{"type":"hebrew_subtitle","content":["Echö än Tafit Köl."]},{"type":"verse","number":1,"content":[{"text":"Üpwe köl usun allükülük me pwüng.","poem":1},{"lineBreak":true},{"text":"Üpwe köl ngonuk, ai Samol mi Lapalap.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Üpwe afäliei pwe üsap föri tipis.","poem":1},{"lineBreak":true},{"text":"Inet kopwe feito rei?","poem":1},{"lineBreak":true},{"text":"Üpwe manaueni eu manau mi limöch me lein chon leimwei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Üsap anomu ai ekiek won mettoch mi ngau.","poem":1},{"lineBreak":true},{"text":"Üa oput föförün ekewe chon tipis.","poem":1},{"lineBreak":true},{"text":"Ar föför esap fokun fitipacheitiei.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Eman mi ulöförea lelukan epwe toau seniei.","poem":1},{"lineBreak":true},{"text":"Üsap fokun efich föför mi ngau.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Eman mi aitengaua chon arun lemonomon","poem":1},{"lineBreak":true},{"text":"üpwe niela.","poem":1},{"lineBreak":true},{"text":"Eman aramas mi wolamalamtekia o sikesik","poem":1},{"lineBreak":true},{"text":"üsap etiwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Üpwe filätä chokewe mi allükülük lon ewe fanü","poem":1},{"lineBreak":true},{"text":"pwe repwe nom rei.","poem":1},{"lineBreak":true},{"text":"Chokewe mi fokun wenechar","poem":1},{"lineBreak":true},{"text":"repwe angang ngeniei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Esap wor eman mi föri föförün atuputup epwe nom lon imwei,","poem":1},{"lineBreak":true},{"text":"nge eman mi kapas chofana esap tongeni nonom fän mesei.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Iteiten lesosor üpwe niela","poem":1},{"lineBreak":true},{"text":"ekewe aramasangau lon ewe fanü,","poem":1},{"lineBreak":true},{"text":"üpwe ärala meinisin mi föri mine a ngau","poem":1},{"lineBreak":true},{"text":"me lon telinimwen ewe Samol mi Lapalap.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}