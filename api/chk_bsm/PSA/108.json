{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"heading","content":["Eu iotekin tüngor alilis pokiten chon oput"]},{"type":"hebrew_subtitle","content":["Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Üa apilüköch, ai Kot,","poem":1},{"lineBreak":true},{"text":"üa apilüköch.","poem":1},{"lineBreak":true},{"text":"Üpwe köl o mwareituk.","poem":1},{"lineBreak":true},{"text":"Ngüni, kopwe pwök.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ekewe kitar me ükülele repwe pwök.","poem":1},{"lineBreak":true},{"text":"Üpwe apwökü mallen rän.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ai Samol mi Lapalap, üpwe kilisou ngonuk me lein ekewe mwichen aramas,","poem":1},{"lineBreak":true},{"text":"üpwe kölün mwareituk me lein chon ekewe mwü.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pun om tong ellet a tekia seni ekewe läng,","poem":1},{"lineBreak":true},{"text":"om allükülük a tori ekewe kuchu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ai Kot, kopwe pwäri om tekia asen ekewe läng.","poem":1},{"lineBreak":true},{"text":"Om ling epwe pwäla won unusen fanüfan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kopwe amanauakem ren om manaman o pälüeni ai iotek.","poem":1},{"lineBreak":true},{"text":"pwe chokewe ka tongeer repwe ngasala.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kot a kapas me lon imwan mi pin,","poem":1},{"lineBreak":true},{"text":"“Lon ai meseik üpwe ineti Sikem","poem":1},{"lineBreak":true},{"text":"o aineti ewe lemolun Sukot ngeni nei aramas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kiliat fanüei, Manasa pwal fanüei,","poem":1},{"lineBreak":true},{"text":"Efraim imwei akkau,","poem":1},{"lineBreak":true},{"text":"Juta woki wokun king.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moap sepiei sepien töttöl,","poem":1},{"lineBreak":true},{"text":"üpwe moneela ipwei sus won Etom asisilan pwe fanüei,","poem":1},{"lineBreak":true},{"text":"nge won ewe fanü Filistia üpwe arükak fän ai win.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Iö epwe emwenieilong lon ewe telinimw mi pöchökül tittin?","poem":1},{"lineBreak":true},{"text":"Iö epwe emweniei ngeni Etom?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ai Kot, ifa usun, ka wesewesen pöütikeemila?","poem":1},{"lineBreak":true},{"text":"Ifa usun, kosap chüen eti äm mwichen sounfiu le feila maun?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kopwe alisikem, pwe aipwe tongeni maun ngeni ekewe chon oputakem,","poem":1},{"lineBreak":true},{"text":"pun än aramas alilis a lomotongau.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Are Kot a etikich, kich sipwe win,","poem":1},{"lineBreak":true},{"text":"i echök epwe akufu chon oputakich.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}