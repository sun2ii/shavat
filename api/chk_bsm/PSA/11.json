{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["Än chon wenechar lenien op"]},{"type":"hebrew_subtitle","content":["Ngeni ewe mi emweni chon köl: Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Üa anomu ai apilükülük won ewe Samol mi Lapalap pwe epwe tümwünüei.","poem":1},{"lineBreak":true},{"text":"Pwota oua üreniei,","poem":1},{"lineBreak":true},{"text":"“Kopwe sü ngeni ekewe chuk usun eman machang?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pun nengeni, ekewe aramasangau ra emeia ar likapich","poem":1},{"lineBreak":true},{"text":"o pachetä wokur föün esefich ngeni selin,","poem":1},{"lineBreak":true},{"text":"pwe repwe likapichi ekewe mi wenechar leluker seni ewe leni mi kiroch.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Are ekewe longolongun pwüng ra tala,","poem":1},{"lineBreak":true},{"text":"met eman chon pwüng a chüen tongeni föri?”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ewe Samol mi Lapalap a nom lon imwan mi pin,","poem":1},{"lineBreak":true},{"text":"än ewe Samol mi Lapalap lenien motun king a nom lon läng.","poem":1},{"lineBreak":true},{"text":"A netiu won fanüfan o ouwasacha aramas meinisin,","poem":1},{"lineBreak":true},{"text":"a pwal silei mine ra föri.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap a sotuni ekewe aramas mi pwüng me ekewe aramasangau,","poem":1},{"lineBreak":true},{"text":"a oput ätewe mi föri föförün mwäneson.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A apüngätiu molien ekkei me primston won ekewe aramasangau.","poem":1},{"lineBreak":true},{"text":"A apwüngüür ren asepwäl mi pwichikar.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pun ewe Samol mi Lapalap a pwüng,","poem":1},{"lineBreak":true},{"text":"a pwapwaäsini föför mi pwüng.","poem":1},{"lineBreak":true},{"text":"Ekewe aramas mi wenechar repwe küna i.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}