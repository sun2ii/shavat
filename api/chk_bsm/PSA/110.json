{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"heading","content":["Kot a ngeni ewe king an nemenem"]},{"type":"hebrew_subtitle","content":["Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Ewe Samol mi Lapalap a kapas ngeni ai samol ewe king,","poem":1},{"lineBreak":true},{"text":"“Kopwe mot lepelifichi","poem":1},{"lineBreak":true},{"text":"tori üpwe anomu chon oputom pwe repwe lenien puun pecheöm.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap epwe alapala manen om nemenem lon wisom wisen king seni Sion.","poem":1},{"lineBreak":true},{"text":"A apasa, “Kopwe nemenem won chon oputom.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lon ränin om kopwe maun ngeni chon oputom","poem":1},{"lineBreak":true},{"text":"noum aramas repwe etuk fän püsin letiper","poem":1},{"lineBreak":true},{"text":"o üföüf ekewe üf mi pin.","poem":1},{"lineBreak":true},{"text":"Usun amurenipwin mi nom lesosorusich,","poem":1},{"lineBreak":true},{"text":"iei usun noum kewe alüal repwe feito reöm.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap a pwon fän akapel, nge esap siwili an ekiek,","poem":1},{"lineBreak":true},{"text":"“En eman souasor tori feilfeilachök","poem":1},{"lineBreak":true},{"text":"lon kotun Melkisetek.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ewe Samol a nom lepelifichum.","poem":1},{"lineBreak":true},{"text":"I epwe akufu ekewe king lon ewe rän a lingeringer.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Epwe eäni kapwüng won chon ekewe mwü.","poem":1},{"lineBreak":true},{"text":"Epwe aura ewe lenien maun ren somä","poem":1},{"lineBreak":true},{"text":"o akufu ekewe king won unusen fanüfan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ewe king epwe ün seni ewe öüwö mi nom ünükün ewe al,","poem":1},{"lineBreak":true},{"text":"epwe pöchökülela ren o sopwela le win.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}