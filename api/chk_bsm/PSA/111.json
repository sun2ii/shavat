{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"heading","content":["Aramas repwe mwareiti Kot"]},{"type":"verse","number":1,"content":[{"text":"Ousipwe mwareiti ewe Samol mi Lapalap.","poem":1},{"lineBreak":true},{"text":"Üpwe kilisou ngeni ewe Samol mi Lapalap ren unusen lelukei","poem":1},{"lineBreak":true},{"text":"lon ewe mwichen chon wenechar, pwal lein ewe mwichen aramas.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Än ewe Samol mi Lapalap föför ra fokun amwarar,","poem":1},{"lineBreak":true},{"text":"chokewe meinisin mi pwapwaitiir ra ekinloneer.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"An kewe föför ra fokun ling me manaman,","poem":1},{"lineBreak":true},{"text":"an pwüng a nonom tori feilfeilachök.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ewe Samol mi Lapalap a föri pwe aramas repwe chechemeni an kewe föför mi amwarar.","poem":1},{"lineBreak":true},{"text":"A eäni kirikiröch o ümöümöch.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A ngeni chokewe mi niuokusiti i ener mongö.","poem":1},{"lineBreak":true},{"text":"A chechemeni an we pwon fansoun meinisin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A pwäri ngeni nöün kewe aramas manamanen an kewe föför,","poem":1},{"lineBreak":true},{"text":"lupwen a ngeniir fanüen chon ekewe mwü.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A allükülük o pwüng lon mettoch meinisin a föri.","poem":1},{"lineBreak":true},{"text":"An kewe allük meinisin ra nükünük.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ra nonomopos tori feilfeilachök,","poem":1},{"lineBreak":true},{"text":"Kot a föriir fän allükülük me wenechar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A angasala nöün aramas","poem":1},{"lineBreak":true},{"text":"o föri eu pwon esemüch.","poem":1},{"lineBreak":true},{"text":"Itan a pin o eniweniu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Niuokusiti ewe Samol mi Lapalap, iei poputän tipachem.","poem":1},{"lineBreak":true},{"text":"Chokewe meinisin mi föri iei usun ra fefeitä lon ar silelap.","poem":1},{"lineBreak":true},{"text":"Sipwe mwareiti Kot tori feilfeilachök.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}