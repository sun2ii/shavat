{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"heading","content":["A feiöch eman mi niuokusiti Kot"]},{"type":"verse","number":1,"content":[{"text":"Ousipwe mwareiti ewe Samol mi Lapalap.","poem":1},{"lineBreak":true},{"text":"A feiöch ewe aramas mi niuokusiti ewe Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"mi pwapwaiti an epwe aleasochisi an kewe allük.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nöün kana repwe nemenem lon ewe fanü.","poem":1},{"lineBreak":true},{"text":"Mwirimwirin kana mi wenechar repwe feiöch.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wöü me chomong pisek ra nom lon imwan,","poem":1},{"lineBreak":true},{"text":"nge an pwüng a nonom tori feilfeilachök.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Saram a tin lon rochopwak fän iten ewe mi wenechar.","poem":1},{"lineBreak":true},{"text":"Pun ewe Samol mi Lapalap a kirikiröch, a pwal ümöümöch o pwüng.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A feiöch eman mwän mi kichiöch o mwütätä mettoch,","poem":1},{"lineBreak":true},{"text":"eman mi föri an angang fän pwüng.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pun ewe chon pwüng epwe fokun tipepos.","poem":1},{"lineBreak":true},{"text":"Aramas repwe chechemeni i tori feilfeilachök.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Esap niuokusiti pworaus mi ngau,","poem":1},{"lineBreak":true},{"text":"lelukan a pos, a apilükülükü ewe Samol mi Lapalap.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lelukan a kinamwe, esap niuokus.","poem":1},{"lineBreak":true},{"text":"Lesopolan epwe pwapwa le küna än chon oputan kuf.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A fangafangöch ngeni ekewe chon wöüngau,","poem":1},{"lineBreak":true},{"text":"an pwüng epwe nonom tori feilfeilachök.","poem":1},{"lineBreak":true},{"text":"Epwe wor manan me meninin me ren aramas.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ekewe aramasangau ra küna ei o song ren,","poem":1},{"lineBreak":true},{"text":"ra attina meser, nge mürin resap chüen nom.","poem":1},{"lineBreak":true},{"text":"Än ekewe aramasangau mochen esap pwönüetä.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}