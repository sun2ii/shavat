{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"heading","content":["Ekewe manaman mi fis, lupwen chon Israel ra towu seni Isip"]},{"type":"verse","number":1,"content":[{"text":"Lupwen ekewe chon Israel ra towu seni Isip,","poem":1},{"lineBreak":true},{"text":"ir ekewe mwirimwirin Jakop mi towu seni eu mwichen aramas mi sokola ar fos,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Juta a wiliti an leni mi pin,","poem":1},{"lineBreak":true},{"text":"Israel a wiliti an lenien nemenem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ewe matau a küna mine a fis o süla,","poem":1},{"lineBreak":true},{"text":"ewe chanpupu Jortan a üla.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ekewe chukutekia ra mwetemwet usun ekewe ätemwänin sip,","poem":1},{"lineBreak":true},{"text":"ekewe chukutekison ra mwetemwet usun ekewe nienifön sip.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Met o sät, pwota ka sü?","poem":1},{"lineBreak":true},{"text":"Met o chanpupu Jortan, pwota ka üla?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Met o ämi kewe chukutekia, pwota oua mwetemwet usun ekewe ätemwänin sip?","poem":1},{"lineBreak":true},{"text":"Nge ämi chukutekison, pwota oua mwetemwet usun ekewe nienifön sip?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"En fanüfan, kopwe chechech me fän mesen ewe Samol,","poem":1},{"lineBreak":true},{"text":"me fän mesen än Jakop we Kot,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"i ewe mi awili ewe achau ngeni eu nomun koluk,","poem":1},{"lineBreak":true},{"text":"nge ewe achau mi fokun pöchökül ngeni eu puächen koluk.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}