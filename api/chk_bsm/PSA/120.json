{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["Eu iotekin tüngor ngasala seni chon atuputup"]},{"type":"hebrew_subtitle","content":["Echö kölün feitä",{"noteId":4},"."]},{"type":"verse","number":1,"content":[{"text":"Üa siö ngeni ewe Samol mi Lapalap lon ai riaföü,","poem":1},{"lineBreak":true},{"text":"nge i a pälüeniei,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Ai Samol mi Lapalap, kopwe angasaei","poem":1},{"lineBreak":true},{"text":"seni ekewe chon chofana me chon atuputup.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ämi chon atuputup, met Kot epwe liwini ngenikemi?","poem":1},{"lineBreak":true},{"text":"Met epwe pwal föri ngenikemi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Epwe apwüngükemi ren än eman sounfiu föün esefich mi ken,","poem":1},{"lineBreak":true},{"text":"ren moochen chia mi sarara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Feiengauei pwe üa siamüfetal lon Mesek","poem":1},{"lineBreak":true},{"text":"o nonom lon imwen ekewe chon Ketar.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A fansoun langatam ai imweimw","poem":1},{"lineBreak":true},{"text":"lein chokewe mi oput kinamwe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Üa tipeni kinamwe. Nge lupwen üa kapas usun,","poem":1},{"lineBreak":true},{"text":"ir ra tipeni maun.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"120.0 Ekei kölfel seni sopun 120 tori sopun 134 chon Israel ra sou eäniir lupwen ar feitä Jerusalem fansoun ar kewe chulap.","reference":{"chapter":120,"verse":0}}]},"thisChapterLink":"/api/chk_bsm/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}