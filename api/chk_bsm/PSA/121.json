{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"heading","content":["Kot om chon tümwün"]},{"type":"hebrew_subtitle","content":["Echö kölün feitä."]},{"type":"verse","number":1,"content":[{"text":"Üa anetai mesei ngeni ekewe chuk.","poem":1},{"lineBreak":true},{"text":"Ia alilisi epwe feito me ie?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alilisi epwe war me ren ewe Samol mi Lapalap","poem":1},{"lineBreak":true},{"text":"mi förätä läng me fanüfan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"I epwe amwöchuk pwe kosap mit,","poem":1},{"lineBreak":true},{"text":"ewe mi tümwünuk esap aiesum.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nengeni, ewe mi tümwünü Israel","poem":1},{"lineBreak":true},{"text":"esap aiesum, esap pwal möür.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap epwe tümwünuk,","poem":1},{"lineBreak":true},{"text":"i epwe annüruk o nom pelifichum.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Akkar esap afeiengauok lerän,","poem":1},{"lineBreak":true},{"text":"nge maram esap afeiengauok lepwin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ewe Samol mi Lapalap epwe tümwünuk seni feiengau meinisin,","poem":1},{"lineBreak":true},{"text":"i epwe tümwünü manauom.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap epwe tümwünü om towu me om tolong","poem":1},{"lineBreak":true},{"text":"seni ikenai tori feilfeilachök.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}