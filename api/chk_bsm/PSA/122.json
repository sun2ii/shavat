{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["Eu iotekin kinamwe fän iten chon Jerusalem"]},{"type":"hebrew_subtitle","content":["Echö kölün feitä än Tafit."]},{"type":"verse","number":1,"content":[{"text":"Üa pwapwa, lupwen ra üreniei,","poem":1},{"lineBreak":true},{"text":"“Ousipwe feila ren imwen ewe Samol mi Lapalap.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Iei äm aia tolong lon asamalapom kewe","poem":1},{"lineBreak":true},{"text":"o ütä lon, en Jerusalem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jerusalem a kaüsefälitä","poem":1},{"lineBreak":true},{"text":"usun eu telinimw mi nükünüköch.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chon ekewe ainang ra feitä ie,","poem":1},{"lineBreak":true},{"text":"ekewe ainangen Israel,","poem":1},{"lineBreak":true},{"text":"pwe repwe kilisou ngeni ewe Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"usun a fen allük ngeniir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ikenan mi wor lenien mot fän iten chokewe mi eäni kapwüng,","poem":1},{"lineBreak":true},{"text":"ekewe lenien motun king fän iten chon leimwen Tafit.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Oupwe tüngor pwe epwe wor kinamwe lon Jerusalem,","poem":1},{"lineBreak":true},{"text":"“Amwo chokewe mi echenuk repwe feiöch.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Epwe wor kinamwe lon tittum, Jerusalem,","poem":1},{"lineBreak":true},{"text":"o imwom kewe imwen king repwe nükünük.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pokiten pwi me chienei kewe üpwe apasa ngeni Jerusalem,","poem":1},{"lineBreak":true},{"text":"“Kinamwe epwe nonom lomw.”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pokiten imwen ewe Samol mi Lapalap ach we Kot","poem":1},{"lineBreak":true},{"text":"üpwe kütta om feiöch.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}