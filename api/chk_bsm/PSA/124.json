{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"heading","content":["Kilisou ren ngasala seni chon oput"]},{"type":"hebrew_subtitle","content":["Echö kölün feitä än Tafit."]},{"type":"verse","number":1,"content":[{"text":"Chon Israel repwe apasa, “Are ewe Samol mi Lapalap esap nom rech,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"are ewe Samol mi Lapalap esap nom rech,","poem":1},{"lineBreak":true},{"text":"lupwen aramas ra maun ngenikich,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"repwe oromanauekichela","poem":1},{"lineBreak":true},{"text":"lon ar song mi watte ngenikich.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iwe, ewe lölö epwe pwölükichela,","poem":1},{"lineBreak":true},{"text":"ewe öütöüt epwe purikichela,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"nge nonoon ekewe koluk repwe pwölükichela.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sipwe mwareiti ewe Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"pun esap mwüt ngeni chon oputakich pwe repwe arosakichela.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sa tiwela usun eman machang a tiwela seni ewe sär, ewe chon sär a soni.","poem":1},{"lineBreak":true},{"text":"Ewe sär a mwü, nge kich sa tiwela.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alilisich a feito seni ewe Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"ewe mi föri läng me fanüfan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}