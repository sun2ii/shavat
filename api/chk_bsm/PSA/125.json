eBreak":true},{"text":"Ai Samol mi Lapalap, kopwe föri mine a mürina ngeni chokewe mi föri mine a mürina,","poem":1},{"lineBreak":true},{"text":"pwal ngeni chokewe mi wenechar lon leluker.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nge chokewe mi rikila ngeni ekewe al mi pwor","poem":1},{"lineBreak":true},{"text":"kopwe asechirela fiti ekewe chon föföringau.","poem":1},{"lineBreak":true},{"text":"Kinamwe epwe nom lon Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}