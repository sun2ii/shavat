{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["Kilisou fän iten än ekewe aramas liwinsefäl seni ar oola"]},{"type":"hebrew_subtitle","content":["Echö kölün feitä."]},{"type":"verse","number":1,"content":[{"text":"Lupwen ewe Samol mi Lapalap a aliwinisefälikich ngeni Sion seni ach oola,","poem":1},{"lineBreak":true},{"text":"sa usun chök chon tan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lon ena fansoun kich sa takirikir. Sa mweireir fän pwapwa.","poem":1},{"lineBreak":true},{"text":"Mürin, chon ekewe mwü ra apasa lefiler,","poem":1},{"lineBreak":true},{"text":"“Ewe Samol mi Lapalap a föri föför mi amwarar fän iter.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ellet, ewe Samol mi Lapalap a föri föför mi amwarar fän itach,","poem":1},{"lineBreak":true},{"text":"iei popun sa pwapwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ai Samol mi Lapalap, kopwe aliwinisefälieto ekewe chon oola meinisin,","poem":1},{"lineBreak":true},{"text":"usun chök ekewe chanpupu lon Nekep ra lölösefäl ren üt.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chokewe mi fofot fän kechü","poem":1},{"lineBreak":true},{"text":"repwe kinikin fän mweireiren pwapwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Eman mi feila fän kechü o uwei föün irä pwe epwe fotuki,","poem":1},{"lineBreak":true},{"text":"epwe liwinto fän mweireiren pwapwa o uwato kinian ua.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}