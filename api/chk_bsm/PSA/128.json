pwe afeiöchuk seni Sion.","poem":1},{"lineBreak":true},{"text":"Amwo kopwe küna feiöchün Jerusalem","poem":1},{"lineBreak":true},{"text":"lon ränin manauom meinisin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amwo kopwe küna nöün noum kana.","poem":1},{"lineBreak":true},{"text":"Kinamwe epwe nom won Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}