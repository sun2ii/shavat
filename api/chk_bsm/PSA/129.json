säw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Amwo repwe wewe ngeni fetil won osun ekewe imw","poem":1},{"lineBreak":true},{"text":"mi pwasala me mwen an märitä,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ewe chon kinikin esap tongeni amasoua pöün ren,","poem":1},{"lineBreak":true},{"text":"nge ewe chon föri pilük esap tongeni pilükü o efiti.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nge chokewe mi pwerela resap apasa ngeniir,","poem":1},{"lineBreak":true},{"text":"“Än ewe Samol mi Lapalap feiöch epwe nom womi.","poem":1},{"lineBreak":true},{"text":"Äm aia afeiöchükemi fän iten ewe Samol mi Lapalap.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}