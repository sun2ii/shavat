{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"heading","content":["Iotekin tüngor alilis lon riaföü"]},{"type":"hebrew_subtitle","content":["Ngeni ewe mi emweni chon köl: Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Ai Samol mi Lapalap, ifa ükükün fansoun om kopwe manlükieila?","poem":1},{"lineBreak":true},{"text":"Ifa usun, kopwe manlükieila tori feilfeilachök?","poem":1},{"lineBreak":true},{"text":"Ifa ükükün fansoun om kopwe aopala mesom seniei?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ifa ükükün fansoun ai üpwe engila fän ai weires?","poem":1},{"lineBreak":true},{"text":"Ifa ükükün fansoun lelukei epwe riaföü lerän me lepwin?","poem":1},{"lineBreak":true},{"text":"Ifa ükükün fansoun än chon oputaei repwe nemenieila?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ai Samol mi Lapalap, kopwe nenengeniei o pälüeniei.","poem":1},{"lineBreak":true},{"text":"Kopwe apöchökülaei, kosap mwütätä ai üpwe mäla.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kosap mwüt ngeni ekewe chon oputaei pwe repwe apasa, “Aia akufu ätewe.”","poem":1},{"lineBreak":true},{"text":"Kosap mwüt ngeni ekewe chon pälüeniei repwe takiriei ren ai tumwula.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nge üa anomu ai apilükülük won om tong ellet,","poem":1},{"lineBreak":true},{"text":"üpwe pwapwa ren om amanauaei.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ngang üpwe köl ngonuk, ai Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"pun ka fokun eäni kirikiröch ngeniei.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}