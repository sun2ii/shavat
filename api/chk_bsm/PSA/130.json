{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["Ach apilükülüküni än Kot amanauakich"]},{"type":"hebrew_subtitle","content":["Echö kölün feitä."]},{"type":"verse","number":1,"content":[{"text":"Ai Samol mi Lapalap, üa siö ngonuk seni lon ekewe leni mi alolol.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ai Samol, kopwe rongorong mweliei.","poem":1},{"lineBreak":true},{"text":"Kopwe aü selingom ngeni ai kewe tüngor pwe kopwe ümöümöch ngeniei.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Are en, äm Samol mi Lapalap, kopwe maketiu äm kewe tipis,","poem":1},{"lineBreak":true},{"text":"iö epwe tongeni manau?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nge en ka amusala äm tipis,","poem":1},{"lineBreak":true},{"text":"pwe aipwe niuokusituk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Üa fokun witiwiti ewe Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"üa apilükülükü an kapas.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Üa witiwiti ewe Samol,","poem":1},{"lineBreak":true},{"text":"lap seni än ekewe chon mas witiwiti an epwe ränila,","poem":1},{"lineBreak":true},{"text":"lap seni än ekewe chon mas witiwiti an epwe ränila.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ämi chon Israel, oupwe apilükülükü ewe Samol mi Lapalap.","poem":1},{"lineBreak":true},{"text":"Pun tong ellet a nom ren ewe Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"a pwal watte an angangen amanaua aramas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I epwe amanaua chon Israel seni ar tipis meinisin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}