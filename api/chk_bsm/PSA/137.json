{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"heading","content":["Än ekewe chon oola Papilon kechü"]},{"type":"verse","number":1,"content":[{"text":"Iwe, ünükün ekewe chanpupun Papilon aia mottiu o kechü,","poem":1},{"lineBreak":true},{"text":"lupwen aia chechemeni Sion.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ikenan aia asapätä nöüm kewe ükülele","poem":1},{"lineBreak":true},{"text":"won ekewe silifö.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ikenan ekewe chon liapenikem ra ürenikem pwe aipwe köl,","poem":1},{"lineBreak":true},{"text":"ekewe chon ariaföüükem ra ariänikem pwe aipwe pwapwa,","poem":1},{"lineBreak":true},{"text":"ra apasa, “Oupwe eäni ngenikem echö ekewe kölün Sion.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Epwe ifa usun, äm aipwe tongeni eäni kölün ewe Samol mi Lapalap","poem":1},{"lineBreak":true},{"text":"lon fanüen ekis?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Are üpwe manlükala en, Jerusalem,","poem":1},{"lineBreak":true},{"text":"pöüifichi epwe pwasala.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Chönawei epwe pachätä fän fongochi,","poem":1},{"lineBreak":true},{"text":"are üsap chechemenuk,","poem":1},{"lineBreak":true},{"text":"are üsap ekieki pwe en, Jerusalem,","poem":1},{"lineBreak":true},{"text":"kopwe ai pwapwa lap seni mettoch meinisin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ai Samol mi Lapalap, kopwe chechemeni mine ekewe chon Etom ra föri","poem":1},{"lineBreak":true},{"text":"lon ewe ränin Jerusalem a tala.","poem":1},{"lineBreak":true},{"text":"Kopwe chechemeni usun ar apasa, “Ataela, ataela, aturätiu tori longolongun fan.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"En Papilon kopwe tala.","poem":1},{"lineBreak":true},{"text":"Epwe pwapwa ätewe mi ngonuk","poem":1},{"lineBreak":true},{"text":"chappen om föför ngenikem.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Epwe pwapwa ätewe mi angei noum kewe semirit","poem":1},{"lineBreak":true},{"text":"o monerela ngeni eu achau.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}