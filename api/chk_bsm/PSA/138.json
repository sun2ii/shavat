{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"heading","content":["Kilisou ren än Kot feiöch"]},{"type":"hebrew_subtitle","content":["Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Ai Samol mi Lapalap, üa kilisou ngonuk ren unusen lelukei.","poem":1},{"lineBreak":true},{"text":"Üa kölün mwareituk me fän mesen ekewe kot.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Üa chapetiu ngeni imwom mi pin","poem":1},{"lineBreak":true},{"text":"o kilisou ngeni itom,","poem":1},{"lineBreak":true},{"text":"pokiten om tong ellet me om allükülük.","poem":1},{"lineBreak":true},{"text":"Pun en ka atekiatä itom me om kapas asen ekewe mettoch meinisin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lupwen üa kökkö, ka pälüeniei,","poem":1},{"lineBreak":true},{"text":"ka apworaei o apöchöküla lelukei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ai Samol mi Lapalap, ekewe king won fanüfan meinisin repwe mwareituk,","poem":1},{"lineBreak":true},{"text":"pun ra rongorong om kapas.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Iwe, repwe kölü om kewe föför,","poem":1},{"lineBreak":true},{"text":"pun a tekia lingom.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Inamwo ika ka fokun tekia,","poem":1},{"lineBreak":true},{"text":"ka afäli ekewe chon tekison.","poem":1},{"lineBreak":true},{"text":"Nge ka silleni ekewe chon lamalamtekia me toau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nge are üa nom lon riaföü,","poem":1},{"lineBreak":true},{"text":"en ka tümwünü manauei.","poem":1},{"lineBreak":true},{"text":"Ka ü ngeni ekewe chon oputaei mi song ngeniei","poem":1},{"lineBreak":true},{"text":"o amanauaei ren om manaman.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ai Samol mi Lapalap, kopwe apwönüetä ekiekin letipom ngeniei.","poem":1},{"lineBreak":true},{"text":"Ai Samol mi Lapalap, om tong ellet a nonom tori feilfeilachök.","poem":1},{"lineBreak":true},{"text":"Kosap likitala ewe angang ka popuetä.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}