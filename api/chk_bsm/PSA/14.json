{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"heading","content":["Än ekewe aramas umwes me föföringau"]},{"type":"hebrew_subtitle","content":["Ngeni ewe mi emweni chon köl: Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Ekewe mi umwes ra ekieki lon leluker, “Esap wor Kot.” Ir ra fokun ngau,","poem":1},{"lineBreak":true},{"text":"ra föri sokun föför mi anioput,","poem":1},{"lineBreak":true},{"text":"esap wor eman a föri mine a pwüng.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ewe Samol mi Lapalap a nenetiu seni läng won aramas meinisin,","poem":1},{"lineBreak":true},{"text":"pwe epwe küna ika a wor eman mi mirit,","poem":1},{"lineBreak":true},{"text":"ika eman mi kütta Kot.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nge ir meinisin ra tokola, ir ra ingaueppök.","poem":1},{"lineBreak":true},{"text":"Esap wor eman a föri mine a pwüng,","poem":1},{"lineBreak":true},{"text":"esap fokun wor eman.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap a ais, “Ifa usun, esap wor än ekewe chon föföringau mirit?","poem":1},{"lineBreak":true},{"text":"Ir chokewe mi manau seni mine ra soläni seni nei aramas,","poem":1},{"lineBreak":true},{"text":"nge resap iotek ngeniei.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nge mürin repwe nom lon niuokus watte,","poem":1},{"lineBreak":true},{"text":"pun Kot a nom ren ekewe aramas mi pwüng.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ekewe chon föföringau ra pinei än ewe chon wöüngau akot,","poem":1},{"lineBreak":true},{"text":"nge ewe Samol mi Lapalap an lenien op.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Amwo eman epwe feito seni Sion o amanaua chon Israel.","poem":1},{"lineBreak":true},{"text":"Ekewe chon Israel repwe fokun pwapwa,","poem":1},{"lineBreak":true},{"text":"lupwen ewe Samol mi Lapalap epwe aliwini ngeniir wöür.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}