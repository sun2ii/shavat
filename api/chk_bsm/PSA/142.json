{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"heading","content":["Eu iotekin tüngor alilis lon riaföü"]},{"type":"hebrew_subtitle","content":["Echö än Tafit kölün kait, lupwen a nom lon ewe föimw. Eu iotek."]},{"type":"verse","number":1,"content":[{"text":"Üa siö ngeni ewe Samol mi Lapalap fän leüömong,","poem":1},{"lineBreak":true},{"text":"üa alapätä mweliei o tüngor ngeni pwe epwe ümöümöch ngeniei.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Üa uwato ren ai letipengau meinisin","poem":1},{"lineBreak":true},{"text":"o asile ngeni ai kewe riaföü.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lupwen üa apilükingau,","poem":1},{"lineBreak":true},{"text":"i a fen silei mine üpwe föri.","poem":1},"Ekewe chon oputaei ra aopala eu sär fän itei",{"text":"lon ewe al ia üa fetal ie.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Lupwen üa nennela lepelifichi,","poem":1},{"lineBreak":true},{"text":"üa küna pwe esap wor eman a alisiei,","poem":1},{"lineBreak":true},{"text":"esap wor ai lenien op,","poem":1},{"lineBreak":true},{"text":"esap wor eman a tümwünüei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ai Samol mi Lapalap, üa siö ngonuk.","poem":1},{"lineBreak":true},{"text":"Üa üra: En ai lenien op","poem":1},{"lineBreak":true},{"text":"me ineti me lon fanüen chon manau.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kopwe afäli ai siö,","poem":1},{"lineBreak":true},{"text":"pun üa fokun apilükingau.","poem":1},{"lineBreak":true},{"text":"Kopwe angasaei seni ekewe chon ariaföüüei,","poem":1},{"lineBreak":true},{"text":"pun ra kon pöchökül ngeniei.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kopwe angasaeila seni lon ewe lenien fötek,","poem":1},{"lineBreak":true},{"text":"pwe üpwe tongeni mwareiti itom.","poem":1},{"lineBreak":true},{"text":"Mürin, ekewe chon pwüng repwe mwicheto rei, pokiten ka afeiöchüei.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}