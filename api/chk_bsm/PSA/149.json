{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"heading","content":["Chon Israel ra angei föneer pwe repwe mwareiti Kot"]},{"type":"verse","number":1,"content":[{"text":"Ousipwe mwareiti ewe Samol mi Lapalap.","poem":1},{"lineBreak":true},{"text":"Oupwe eäni ngeni ewe Samol mi Lapalap echö köl mi fö,","poem":1},{"lineBreak":true},{"text":"oupwe kölün mwareiti i me lon ewe mwichen chon allükülük.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chon Israel repwe pwapwa ren ewe chon föriir.","poem":1},{"lineBreak":true},{"text":"Ekewe aramasen Sion repwe mwänek ren ar king.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Repwe mwareiti itan fän pworuk","poem":1},{"lineBreak":true},{"text":"o köl ngeni fän pisekin kaktai me ükülele.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pun ewe Samol mi Lapalap a pwapwaäsini nöün aramas,","poem":1},{"lineBreak":true},{"text":"a alinga ekewe chon tipetekison ren win.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ekewe chon pin repwe meseik lon ling,","poem":1},{"lineBreak":true},{"text":"repwe köl fän pwapwa lon kier kewe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kapasen mwareiti Kot fän leüömong epwe nom lon awer,","poem":1},{"lineBreak":true},{"text":"nge ekewe ketilas mi seisei me rüepek repwe nom lon pöür,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"pwe repwe ngeni chon ekewe mwü chappen ar föför","poem":1},{"lineBreak":true},{"text":"o apwüngü ekewe aramas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Repwe föti ar kewe king ren sein,","poem":1},{"lineBreak":true},{"text":"nge ar kewe aramas tekia ren selimächä,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"pun repwe eäni apwüng wor usun Kot a fen allük.","poem":1},{"lineBreak":true},{"text":"Ren ei nöün kewe mi pin meinisin ra ling ren.","poem":1},{"lineBreak":true},{"text":"Ousipwe mwareiti ewe Samol mi Lapalap.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}