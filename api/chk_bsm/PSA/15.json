{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"heading","content":["Ekewe chon nonom won ewe chukun Kot"]},{"type":"hebrew_subtitle","content":["Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Ai Samol mi Lapalap, iö epwe tongeni tolong lon imwom mi pin?","poem":1},{"lineBreak":true},{"text":"Iö epwe tongeni nonom won chukum mi pin?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ätewe mi aleasochisi Kot","poem":1},{"lineBreak":true},{"text":"o föri mine a pwüng fansoun meinisin,","poem":1},{"lineBreak":true},{"text":"a eäni kapas wenechar seni lon lelukan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Esap aitengaua eman,","poem":1},{"lineBreak":true},{"text":"esap föri mine a ngau ngeni chienan,","poem":1},{"lineBreak":true},{"text":"esap pwal ngününgünüfetalei chon arun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A oput eman mi manauangau,","poem":1},{"lineBreak":true},{"text":"nge a asamolu chokewe mi meniniti ewe Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"a apwönüetä an pwon a eäni fän akapel, inamwo are a weires ren.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A mwütawu nöün moni, nge esap angei winnan,","poem":1},{"lineBreak":true},{"text":"esap pwal angei lifangen amichimich pwe epwe aturu eman esap wor an tipis.","poem":1},{"lineBreak":true},{"text":"Ätewe mi föri ekei mettoch epwe nomopos won chukum mi pin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}