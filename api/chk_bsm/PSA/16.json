{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"heading","content":["Iotekin apilükülük"]},{"type":"hebrew_subtitle","content":["Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Ai Kot, kopwe tümwünüei,","poem":1},{"lineBreak":true},{"text":"pun üa anomu ai apilükülük womw pwe kopwe ti seniei feiengau.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Üa kapas ngeni ewe Samol mi Lapalap, “En chök ai Samol.","poem":1},{"lineBreak":true},{"text":"Esap wor ai feiöch lükün en.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ekewe chon pin mi nom won fanüfan ra iteföüla.","poem":1},{"lineBreak":true},{"text":"Üa fokun pwapwaäsini ai üpwe nom rer.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ekewe aramas mi filätä pwal ekoch kot ra achomonga ar riaföü.","poem":1},{"lineBreak":true},{"text":"Üsap fokun etiir, lupwen ra asor,","poem":1},{"lineBreak":true},{"text":"üsap pwal fel ngeni ar kewe kot.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ai Samol mi Lapalap, en ai, ka fokun aüchea ngeniei.","poem":1},{"lineBreak":true},{"text":"En ewe mi fang ngeniei meinisin mine üpwe eäni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ineti we a nom lon eu fanü mi fokun öch.","poem":1},{"lineBreak":true},{"text":"Ewer, ineti we a mürina.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Üa mwareiti ewe Samol mi Lapalap, pun a öüröüraei,","poem":1},{"lineBreak":true},{"text":"nge lepwin lelukei a pwal fönöüei.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Iteiten fansoun üa mefi pwe ewe Samol mi Lapalap a nom rei.","poem":1},{"lineBreak":true},{"text":"Pokiten i a arap ngeniei, üsap tongeni mwökütüküt.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Iei mine lelukei a pwapwa o mwänek,","poem":1},{"lineBreak":true},{"text":"inisi a mefi kinamwe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pun en ka tümwünüei seni manamanen mäla,","poem":1},{"lineBreak":true},{"text":"kosap pwal mwüt ngeni noum we mi pin pwe epwe mwöch lon peias.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"En ka aiti ngeniei ewe alen manau.","poem":1},{"lineBreak":true},{"text":"Om nom rei a afisätä ai pwapwa mi somwosom","poem":1},{"lineBreak":true},{"text":"o awarato ai mwänek tori feilfeilachök.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}