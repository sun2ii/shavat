{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"heading","content":["Eu iotekin tüngor win"]},{"type":"hebrew_subtitle","content":["Ngeni ewe mi emweni chon köl: Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Amwo ewe Samol mi Lapalap epwe pälüeni om tüngor lon ränin om riaföü.","poem":1},{"lineBreak":true},{"text":"Amwo än Jakop we Kot epwe tümwünuk.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amwo epwe tinato reöm alilisum seni lon ewe leni mi pin","poem":1},{"lineBreak":true},{"text":"o apöchökülok seni Sion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amwo epwe etiwa om kewe asor meinisin","poem":1},{"lineBreak":true},{"text":"o pwapwaäsini om kewe asoren kek.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Amwo Kot epwe ngonuk mochenin letipom","poem":1},{"lineBreak":true},{"text":"o apwönüetä om kewe ekiek meinisin.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mürin sipwe mweir fän pwapwa ren om win,","poem":1},{"lineBreak":true},{"text":"sipwe pwal aürätä ach filaik fän iten ach Kot.","poem":1},{"lineBreak":true},{"text":"Amwo ewe Samol mi Lapalap epwe apwönüetä om kewe tüngor meinisin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iei üa silei pwe ewe Samol mi Lapalap a alisi nöün we king mi kepit,","poem":1},{"lineBreak":true},{"text":"a pälüeni an tüngor seni an we läng mi pin","poem":1},{"lineBreak":true},{"text":"o awinna ren win mi lapalap ren an manaman.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ekoch aramas ra anomu ar apilükülük won war wokenin maun,","poem":1},{"lineBreak":true},{"text":"ekoch ra anomu won nöür oris,","poem":1},{"lineBreak":true},{"text":"nge kich sia anomu ach apilükülük won manamanen ewe Samol mi Lapalap ach we Kot.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ir repwe mwaroro o turula,","poem":1},{"lineBreak":true},{"text":"nge kich sipwe ütä o üwenewenetä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Äm Samol mi Lapalap, kopwe awinna ewe king,","poem":1},{"lineBreak":true},{"text":"kopwe pälüenikem, lupwen aia kökköruk.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}