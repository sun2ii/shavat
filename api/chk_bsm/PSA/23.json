,{"type":"verse","number":5,"content":[{"text":"Ka amolätä eu chepelin mongö fän itei","poem":1},{"lineBreak":true},{"text":"me fän mesen ekewe chon oputaei,","poem":1},{"lineBreak":true},{"text":"ka epiti ngeni mökürei lö,","poem":1},{"lineBreak":true},{"text":"ka alölöü ai kap tori a urela.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ewer, kirikiröch chök me tong repwe nom rei lon ränin manauei meinisin,","poem":1},{"lineBreak":true},{"text":"nge üpwe nonom lon imwen ewe Samol mi Lapalap tori feilfeilachök.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}