{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"heading","content":["Ewe king mi ling"]},{"type":"hebrew_subtitle","content":["Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Fanüfan me masouan meinisin än ewe Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"pwal meinisin mi nonom won ir nöün.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pun i a anomu fanüfan won ekewe matau","poem":1},{"lineBreak":true},{"text":"o anükücharätiu won ekewe koluk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Iö epwe tongeni feitä won chukun ewe Samol mi Lapalap?","poem":1},{"lineBreak":true},{"text":"Nge iö epwe tongeni nom lon lenian mi pin?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Chokewe mi limöch ar föför me ar ekiek,","poem":1},{"lineBreak":true},{"text":"resap fel ngeni uluulun anümwäl, resap pwal chofana le akapel.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap epwe afeiöchüür.","poem":1},{"lineBreak":true},{"text":"Kot epwe pwärätä pwe ra pwüng o amanaueer.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Iei usun ekewe aramas mi kütta Kot,","poem":1},{"lineBreak":true},{"text":"chokewe mi feito fän mesen än Jakop we Kot.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Oupwe sukala ekewe asam,","poem":1},{"lineBreak":true},{"text":"oupwe sukchöchöla ekewe asamen lom,","poem":1},{"lineBreak":true},{"text":"pwe ewe king mi ling epwe tolong lon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Iö ewe king mi ling?","poem":1},{"lineBreak":true},{"text":"Ewe Samol mi Lapalap mi pöchökül o pwora,","poem":1},{"lineBreak":true},{"text":"ewe Samol mi Lapalap mi win lon maun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Oupwe sukala ekewe asam,","poem":1},{"lineBreak":true},{"text":"oupwe sukchöchöla ekewe asamen lom,","poem":1},{"lineBreak":true},{"text":"pwe ewe king mi ling epwe tolong lon.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Iö ei king mi ling?","poem":1},{"lineBreak":true},{"text":"Ewe Samol mi Unusen Manaman, i ewe king mi ling.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}