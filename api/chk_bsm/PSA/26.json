{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"heading","content":["Än eman aramas mi pwüng iotek"]},{"type":"hebrew_subtitle","content":["Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Ai Samol mi Lapalap, kopwe aletätä ai pwüng,","poem":1},{"lineBreak":true},{"text":"pun üa föri mine a pwüng,","poem":1},{"lineBreak":true},{"text":"üa apilükülükuk, nge üsap mwökütüküt.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kopwe atitinaei, ai Samol mi Lapalap, o sotuniei,","poem":1},{"lineBreak":true},{"text":"kopwe sotuni mochenin lelukei me ai ekiek.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pun om tong ellet a nom mwei,","poem":1},{"lineBreak":true},{"text":"om allükülük a emweniei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Üsap nom ren aramas mi chofana,","poem":1},{"lineBreak":true},{"text":"üsap pwal chiechi ngeni chon likatuputup.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Üa oput ewe mwichen chon föföringau,","poem":1},{"lineBreak":true},{"text":"nge üsap nom ren ekewe aramasangau.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ai Samol mi Lapalap, üa talü pei pwe asisilen ai limelimöch","poem":1},{"lineBreak":true},{"text":"o pwelifeili om rongen asor,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Üa eäni echö kölün kilisou fän leüömong","poem":1},{"lineBreak":true},{"text":"o apworausa om kewe föför meinisin mi amwarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ai Samol mi Lapalap, üa echeni imwom ewe ia ka nonom ie,","poem":1},{"lineBreak":true},{"text":"ewe leni ia lingom a nonom ie.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kosap nieila fitifengen me ekewe chon tipis,","poem":1},{"lineBreak":true},{"text":"kosap angei manauei fitifengen me chon nimanauei aramas,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ätekewe mi föri föför mi ngau fansoun meinisin,","poem":1},{"lineBreak":true},{"text":"ra pwal pwapwa le angei lifangen amichimich.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nge ngang won inisi üa föri mine a pwüng,","poem":1},{"lineBreak":true},{"text":"kopwe ümöümöch ngeniei o amanauaei.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Üa nom won sonomaw.","poem":1},{"lineBreak":true},{"text":"Üpwe mwareiti ewe Samol mi Lapalap","poem":1},{"lineBreak":true},{"text":"lon ewe mwich mi lap.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}