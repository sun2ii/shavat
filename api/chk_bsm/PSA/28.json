{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"heading","content":["Eu iotekin tüngor alilis me iotekin kilisou"]},{"type":"hebrew_subtitle","content":["Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Ai Samol mi Lapalap, en ai achau, üa kökköruk.","poem":1},{"lineBreak":true},{"text":"Kopwe aüselinga ai siö ngonuk.","poem":1},{"lineBreak":true},{"text":"Pun are kosap pälüeniei,","poem":1},{"lineBreak":true},{"text":"üpwe wewe ngeni chokewe mi tolong lon peias.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kopwe rongorong kapasen ai tüngor, lupwen üa siö ngonuk.","poem":1},{"lineBreak":true},{"text":"Kopwe alisiei, lupwen üa aitietä pei ngeni imwom mi unusen pin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kosap apwüngüei fitifengen me ekewe aramasangau,","poem":1},{"lineBreak":true},{"text":"pwal fiti chokewe mi föri föför mi ngau,","poem":1},{"lineBreak":true},{"text":"ir mi eäni kapas pwetete ngeni chon arur,","poem":1},{"lineBreak":true},{"text":"nge ra ekiekingau lon leluker.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kopwe ngeniir chappen ar föför","poem":1},{"lineBreak":true},{"text":"me ükükün liwinin ar föföringau.","poem":1},{"lineBreak":true},{"text":"Kopwe ngeniir chappen angangen pöür","poem":1},{"lineBreak":true},{"text":"o liwini ngeniir mine a fichitiir.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pokiten ir resap afäli än ewe Samol mi Lapalap föför","poem":1},{"lineBreak":true},{"text":"ika angangen pöün, iei mine i epwe apwüngüür","poem":1},{"lineBreak":true},{"text":"o aroserela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Üpwe mwareiti ewe Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"pun a rongorong ai tüngorun alilis.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap a tümwünüei o epeti seniei feiengau,","poem":1},{"lineBreak":true},{"text":"üa apilükülükü i, nge i a alisiei.","poem":1},{"lineBreak":true},{"text":"Iei mine üa fokun pwapwa.","poem":1},{"lineBreak":true},{"text":"Üpwe kilisou ngeni o kölün mwareiti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ewe Samol mi Lapalap i än nöün aramas pöchökül.","poem":1},{"lineBreak":true},{"text":"I ewe lenien op mi allükülük fän iten nöün we mi kepit ewe king.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kopwe amanaua noum kewe aramas","poem":1},{"lineBreak":true},{"text":"o afeiöchü noum kana.","poem":1},{"lineBreak":true},{"text":"Kopwe ar chon mas","poem":1},{"lineBreak":true},{"text":"o tümwünüür tori feilfeilachök.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}