{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"heading","content":["Möngüngün Kot me lon mölümöl"]},{"type":"hebrew_subtitle","content":["Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Ämi chon läng kana, oupwe mwareiti ewe Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"oupwe mwareiti an ling me manaman.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oupwe mwareiti lingen iten ewe Samol mi Lapalap.","poem":1},{"lineBreak":true},{"text":"Oupwe fel ngeni i fän üf mi pin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aramas ra rongorong möngüngün ewe Samol mi Lapalap won ekewe matau.","poem":1},{"lineBreak":true},{"text":"Ewe Kot mi ling a apüngü chopulap.","poem":1},{"lineBreak":true},{"text":"Möngüngün ewe Samol mi Lapalap a tittiriis me won ekewe matau.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Möngüngün ewe Samol mi Lapalap a manaman.","poem":1},{"lineBreak":true},{"text":"Möngüngün ewe Samol mi Lapalap a fokun amwarar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Möngüngün ewe Samol mi Lapalap a kupi ekewe irä setar,","poem":1},{"lineBreak":true},{"text":"a kupi ekewe irä setar mi nom won Lepanon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A föri pwe ewe chuk Lepanon a mwetemwet usun eman nienifön kow,","poem":1},{"lineBreak":true},{"text":"nge ewe chuk Hermon a mwetemwet usun eman nienifön ätemwänin kow.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Möngüngün ewe Samol mi Lapalap a afifi inefi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Möngüngün ewe Samol mi Lapalap a achechecha ewe fanüapö,","poem":1},{"lineBreak":true},{"text":"a achechecha ewe fanüapön Kates.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Möngüngün ewe Samol mi Lapalap a amäräkulu ekewe irä ook","poem":1},{"lineBreak":true},{"text":"o wichikätiu chön irän ewe wöllap.","poem":1},{"lineBreak":true},{"text":"Nge lon imwan imwenfel meinisin ra kökkö, “Kot a ling.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ewe Samol mi Lapalap a nemenem won ekewe lölö.","poem":1},{"lineBreak":true},{"text":"A nemenem, pun i a king tori feilfeilachök.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap a ngeni nöün kewe aramas pöchökül,","poem":1},{"lineBreak":true},{"text":"a afeiöchü nöün kewe aramas ren kinamwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}