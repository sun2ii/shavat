{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["Iotekin lesosor pwe Kot epwe alilis"]},{"type":"hebrew_subtitle","content":["Echö än Tafit köl lupwen an sü seni Apsalom nöün we."]},{"type":"verse","number":1,"content":[{"text":"Ai Samol mi Lapalap, ekewe mi oputaei ra kon chomong!","poem":1},{"lineBreak":true},{"text":"Chomong ra ü ngeniei.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chomong ra kapas usi,","poem":1},{"lineBreak":true},{"text":"“Esap wor an alilis me ren Kot.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nge en, ai Samol mi Lapalap, ka epeti seniei feiengau,","poem":1},{"lineBreak":true},{"text":"en ai ling,","poem":1},{"lineBreak":true},{"text":"ka achimwäeitä.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Üa leüömong le siö ngeni ewe Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"nge i a pälüeniei seni chukun mi pin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Üa konola o möür. Üa pwal nenela,","poem":1},{"lineBreak":true},{"text":"pun ewe Samol mi Lapalap a tümwünüei.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Üsap niuokusiti engol ngeröün aramas","poem":1},{"lineBreak":true},{"text":"mi pwelifeiliei o ü ngeniei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kopwe feito, ai Samol mi Lapalap. Kopwe angasaei, ai Kot.","poem":1},{"lineBreak":true},{"text":"Pun ka apwüngü ekewe chon oputaei meinisin,","poem":1},{"lineBreak":true},{"text":"ka angei seniir ar pöchökül pwe resap tongeni afeiengauaei.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap a angasala aramas mi nom lon weires.","poem":1},{"lineBreak":true},{"text":"Om feiöch epwe nom won noum aramas.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}