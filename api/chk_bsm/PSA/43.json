{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["Iotekin tüngor ngas"]},{"type":"verse","number":1,"content":[{"text":"Ai Kot, kopwe aletätä ai pwüng","poem":1},{"lineBreak":true},{"text":"o peniei seni ekewe aramas resap aleasochis ngonuk.","poem":1},{"lineBreak":true},{"text":"Kopwe angasaei seni ekewe aramas mi atuputup o pwüngingau.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pun en ewe Kot üa eänuk lenien op.","poem":1},{"lineBreak":true},{"text":"Pwota ka pöütieila?","poem":1},{"lineBreak":true},{"text":"Pwota üa chök ngüngüres","poem":1},{"lineBreak":true},{"text":"pokiten ai riaföü ren chon oputaei?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kopwe tinato om saram me om let","poem":1},{"lineBreak":true},{"text":"pwe repwe emweniei,","poem":1},{"lineBreak":true},{"text":"repwe emwenieila ngeni chukum mi pin,","poem":1},{"lineBreak":true},{"text":"pwal ngeni imwom ia ka nom ie.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mürin üpwe feila ren om rongen asor,","poem":1},{"lineBreak":true},{"text":"ai Kot en popun ai pwapwa mi fokun lapalap.","poem":1},{"lineBreak":true},{"text":"üpwe kölün mwareituk won ükülele,","poem":1},{"lineBreak":true},{"text":"en ai Kot.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngüni, pwota ka letipengau,","poem":1},{"lineBreak":true},{"text":"pwota ka ngüngü me loi?","poem":1},{"lineBreak":true},{"text":"Üpwe apilükülükü Kot,","poem":1},{"lineBreak":true},{"text":"pun üpwe mwareitisefäli","poem":1},{"lineBreak":true},{"text":"ai Chon Amanau me ai Kot.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}