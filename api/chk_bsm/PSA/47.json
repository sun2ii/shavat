{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"heading","content":["Kot i king won unusen fanüfan"]},{"type":"hebrew_subtitle","content":["Ngeni ewe mi emweni chon köl: Echö köl än nöün Kora kewe mwän."]},{"type":"verse","number":1,"content":[{"text":"Oupwe alopolop ämi chon ekewe mwü meinisin.","poem":1},{"lineBreak":true},{"text":"Oupwe mweireir fän leüömong ren kölün pwapwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sipwe niuokusiti ewe Samol mi Lapalap, Ewe mi Unusen Tekia,","poem":1},{"lineBreak":true},{"text":"i eman king mi lap a nemeni unusen fanüfan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A asapwilätiu chon ekewe mwü fach","poem":1},{"lineBreak":true},{"text":"o atolonga ekewe mwü fän nemeniach.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A filätä fän itach ewe fanü sa fanüeni,","poem":1},{"lineBreak":true},{"text":"ewe fanü nöün aramas ra aücheani, ir chokewe Kot a tongeer.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kot a feitä ren an lenien motun king fän mweireiren pwapwa,","poem":1},{"lineBreak":true},{"text":"ewe Samol mi Lapalap a feitä","poem":1},{"lineBreak":true},{"text":"fän tikin rappwa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Oupwe kölün mwareiti Kot, oupwe kölün mwareiti.","poem":1},{"lineBreak":true},{"text":"Oupwe kölün mwareiti ach king, oupwe kölün mwareiti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pun Kot i kingen unusen fanüfan,","poem":1},{"lineBreak":true},{"text":"oupwe mwareiti i ren echö köl mi pin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kot a nemeni ekewe mwü,","poem":1},{"lineBreak":true},{"text":"Kot a mot won an lenien motun king mi pin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ekewe samolun ekewe mwü ra mwichefengen,","poem":1},{"lineBreak":true},{"text":"ir ewe mwichen aramas nöün än Apraham we Kot.","poem":1},{"lineBreak":true},{"text":"Pun ekewe kingen fanüfan nöün Kot,","poem":1},{"lineBreak":true},{"text":"i a fokun tekia mwer meinisin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}