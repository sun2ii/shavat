{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["Eu iotekin tüngor pwe Kot epwe tümwünü nöün aramas seni ekewe chon oputer"]},{"type":"hebrew_subtitle","content":["Ngeni ewe mi emweni chon köl: Won pisekin ettik mi wor saitenin. Echö än Tafit kölün kait, lupwen ekewe chon Sif ra feila ren Saul o üreni pwe Tafit a op lefiler."]},{"type":"verse","number":1,"content":[{"text":"Ai Kot, kopwe amanauaei ren manamanen itom,","poem":1},{"lineBreak":true},{"text":"kopwe aletätä ai pwüng ren om pöchökül.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ai Kot, kopwe aüselinga ai iotek,","poem":1},{"lineBreak":true},{"text":"kopwe aü selingom ngeni ai kewe kapas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pun chon lamalamtekia ra ü ngeniei,","poem":1},{"lineBreak":true},{"text":"ekewe chon mwäneson ra mochen nieila.","poem":1},{"lineBreak":true},{"text":"Ir chokewe resap ekieki Kot.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nge Kot ai chon alilis,","poem":1},{"lineBreak":true},{"text":"ewe Samol i chon amwöchü manauei.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kot epwe ukun ngeni chon oputaei ar föför mi ngau.","poem":1},{"lineBreak":true},{"text":"Epwe aroserela fän an allükülük.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ngang üpwe eäni eu asor ngonuk seni mochenin letipei.","poem":1},{"lineBreak":true},{"text":"Üpwe kilisou ngonuk, ai Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"pun en ka kirikiröch.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"En ka angasaei seni ai riaföü meinisin,","poem":1},{"lineBreak":true},{"text":"nge üa pwapwa, lupwen üa küna pwe chon oputaei ra kuf.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}