{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["Apilükülük ren än Kot tümwün"]},{"type":"hebrew_subtitle","content":["Ngeni ewe mi emweni chon köl: Won pisekin ettik mi wor saitenin. Echö än Tafit köl."]},{"type":"verse","number":1,"content":[{"text":"Ai Kot, kopwe rongorong ai siö,","poem":1},{"lineBreak":true},{"text":"kopwe aüselinga ai iotek.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Üa kökköruk seni lesopun fanüfan,","poem":1},{"lineBreak":true},{"text":"lupwen üa apilükingau.","poem":1},{"lineBreak":true},{"text":"Kopwe emweniei ngeni ewe achau mi tekia seniei.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pun en ai lenien op,","poem":1},{"lineBreak":true},{"text":"ka tümwünüöchüei seni ekewe chon oputaei.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kopwe mwüt ngeniei pwe üpwe nom lon imwom mi pin lon unusen manauei,","poem":1},{"lineBreak":true},{"text":"pwe üpwe kinamwe le op fän poum.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pun en ai Kot, ka rongorong ai kewe pwon,","poem":1},{"lineBreak":true},{"text":"ka ngeniei wisen chokewe mi meninituk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kopwe alangatamala ränin manauen ewe king.","poem":1},{"lineBreak":true},{"text":"Amwo ierin manauan repwe tori ekewe täppin aramas meinisin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Amwo epwe nemenem fän mesom tori feilfeilachök.","poem":1},{"lineBreak":true},{"text":"Ai Kot, kopwe tümwünü ewe king ren om tong ellet me om allükülük.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mürin üpwe kölün mwareiti itom fansoun meinisin,","poem":1},{"lineBreak":true},{"text":"lupwen üa apwönüetä ai kewe pwon iteiten rän.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}