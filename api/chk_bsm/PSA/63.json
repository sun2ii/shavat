{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"heading","content":["Kot a amenemenöchü manauen aramas"]},{"type":"hebrew_subtitle","content":["Echö än Tafit köl, lupwen a nom lon ewe fanüapön Juta."]},{"type":"verse","number":1,"content":[{"text":"Ai Kot, en ai Kot üa tiliken le küttok.","poem":1},{"lineBreak":true},{"text":"Inisi a apwangapwangala ren ai posituk,","poem":1},{"lineBreak":true},{"text":"nge ngüni a kakaituk usun eu fanü mi pwasapwas o pön,","poem":1},{"lineBreak":true},{"text":"esap wor koluk lon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Üa mochen künok lon imwom mi pin","poem":1},{"lineBreak":true},{"text":"pwe üpwe nengeni om manaman me om ling.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pun om tong ellet a mürina seni manau,","poem":1},{"lineBreak":true},{"text":"ngang üpwe mwareituk.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iwe, üpwe kilisou ngonuk lon ränin manauei meinisin.","poem":1},{"lineBreak":true},{"text":"Üpwe aitietä pei lon ai iotek ngonuk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ngüni a mötüla usun üa mötüla ren mongö mi annö.","poem":1},{"lineBreak":true},{"text":"Üpwe mwareituk fän pwapwa,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"üa chechemenuk, lupwen üa kon won ai peet","poem":1},{"lineBreak":true},{"text":"o ekieki usum lepwin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pun en ai soualilis,","poem":1},{"lineBreak":true},{"text":"üa köl fän pwapwa me fän nürün poum.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Üa fitipacheituk,","poem":1},{"lineBreak":true},{"text":"pöüifichum a amwöchüeitä.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nge chokewe mi mochen nieila","poem":1},{"lineBreak":true},{"text":"repwe feitiu epin fanüfan,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"repwe mäla lon maun,","poem":1},{"lineBreak":true},{"text":"nge kolak mi mwacho repwe ochei fituker.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nge ewe king epwe meseik ren Kot.","poem":1},{"lineBreak":true},{"text":"Meinisin mi eäni iten Kot le pwon fän akapel repwe mwänek,","poem":1},{"lineBreak":true},{"text":"nge awen ekewe chon chofana repwe pinela.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}