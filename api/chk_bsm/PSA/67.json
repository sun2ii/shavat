{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["Echö kölün mwareiti Kot"]},{"type":"hebrew_subtitle","content":["Ngeni ewe mi emweni chon köl: Ren pisekin ettik mi wor saitenin. Echö köl."]},{"type":"verse","number":1,"content":[{"text":"Ai Kot, kopwe ümöümöch ngenikem o afeiöchükem,","poem":1},{"lineBreak":true},{"text":"kopwe netiu wom fän om kirikiröch,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"pwe aramas won fanüfan repwe silei letipom,","poem":1},{"lineBreak":true},{"text":"nge chon ekewe mwü meinisin repwe silei om we angangen amanaua aramas.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Chon ekewe mwü repwe mwareituk, ai Kot,","poem":1},{"lineBreak":true},{"text":"chon ekewe mwü meinisin repwe mwareituk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Chon ekewe mwü repwe pwapwa o köl fän ar pwapwa,","poem":1},{"lineBreak":true},{"text":"pun en ka apwüngü chon fanüfan fän pwüng,","poem":1},{"lineBreak":true},{"text":"ka pwal emweni chon ekewe mwü won fanüfan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Chon ekewe mwü repwe mwareituk, ai Kot,","poem":1},{"lineBreak":true},{"text":"chon ekewe mwü repwe mwareituk.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Fanüfan a awora räs,","poem":1},{"lineBreak":true},{"text":"Kot ach Kot a afeiöchükich.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kot a afeiöchükich.","poem":1},{"lineBreak":true},{"text":"Chon fanüfan meinisin repwe asamolu i.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}