{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["Eu iotek pwe Kot epwe angasakich"]},{"type":"hebrew_subtitle","content":["Ngeni ewe mi emweni chon köl: Echö än Tafit köl fän iten ewe asoren achechem."]},{"type":"verse","number":1,"content":[{"text":"Ai Kot, kose mochen kopwe angasaeila.","poem":1},{"lineBreak":true},{"text":"Ai Samol mi Lapalap, kopwe kaito pwe kopwe alisiei.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Amwo meinisin mi mochen nieila","poem":1},{"lineBreak":true},{"text":"repwe säw o tolong lon fitikoko.","poem":1},{"lineBreak":true},{"text":"Amwo chokewe meinisin mi tipeni ai üpwe feiengau","poem":1},{"lineBreak":true},{"text":"repwe kulsefäl o itengau.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amwo chokewe mi ämängauaei","poem":1},{"lineBreak":true},{"text":"repwe fokun rükö ren ar kuf.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nge meinisin mi feito reöm repwe meseik o pwapwa.","poem":1},{"lineBreak":true},{"text":"Chokewe mi aücheani om amanaueer","poem":1},{"lineBreak":true},{"text":"repwe apasafochei, “Kot a tekia.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nge ngang üa wöüngau o osupwang.","poem":1},{"lineBreak":true},{"text":"Ai Kot, kopwe kaito rei.","poem":1},{"lineBreak":true},{"text":"En ai chon alilis me Chon Amanau.","poem":1},{"lineBreak":true},{"text":"Ai Samol mi Lapalap, kosap mang le alisiei.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}