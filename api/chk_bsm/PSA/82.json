{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["Kot a apwüngü ekewe soukapwüng mi pwüngingau"]},{"type":"hebrew_subtitle","content":["Echö än Asaf köl."]},{"type":"verse","number":1,"content":[{"text":"Kot ewe meilapen ewe mwichen lon läng,","poem":1},{"lineBreak":true},{"text":"a eäni kapwüng me lein ekewe kot:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“Ifa ükükün fansoun ämi oupwe eäni kapwüng fän pwüngingau","poem":1},{"lineBreak":true},{"text":"o peni ekewe aramasangau?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Oupwe eäni kapwüng fän pwüng ngeni ekewe mi mwelele me ekewe mi mäsen.","poem":1},{"lineBreak":true},{"text":"Oupwe eäni pwüng ngeni ekewe mi riaföü me wöüngau.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Oupwe amanaua ekewe mi mwelele me ekewe mi osupwang o angaserela seni lepöün ekewe aramasangau.”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Iwe, esap wor ar sile ika mirit,","poem":1},{"lineBreak":true},{"text":"ra chök fetal lon rochopwak.","poem":1},{"lineBreak":true},{"text":"Ra ataela ekewe pwüüng ekewe mwün fanüfan ra longolong won.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Üa apasa, “Ämi oua kot,","poem":1},{"lineBreak":true},{"text":"ämi meinisin nöün Ewe mi Unusen Tekia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nge ämi oupwe chök mäla usun aramas,","poem":1},{"lineBreak":true},{"text":"oupwe mäfeiengau usun chök ekewe samol.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ai Kot, kopwe feito o apwüngü fanüfan,","poem":1},{"lineBreak":true},{"text":"pun noum chök chon ekewe mwü meinisin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}