{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"heading","content":["Feiöchün chokewe mi nonom lon Sion"]},{"type":"hebrew_subtitle","content":["Echö köl än nöün Kora kewe mwän."]},{"type":"verse","number":1,"content":[{"text":"Kot a aüetä an we telinimw won ewe chuk mi pin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap a aücheani Sion","poem":1},{"lineBreak":true},{"text":"lap seni ekewe leni meinisin lon Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A eäni pworaus mi amwarar usum,","poem":1},{"lineBreak":true},{"text":"en telinimwen Kot.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Üpwe makei iten Isip me Papilon","poem":1},{"lineBreak":true},{"text":"lon tettelin ekewe mwü mi aleasochisiei,","poem":1},{"lineBreak":true},{"text":"pwal ekewe chon Filistia me Tirus me Itiopia","poem":1},{"lineBreak":true},{"text":"üpwe alearelong lein chokewe mi imweimw lon Jerusalem.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nge usun Sion aramas repwe apasa","poem":1},{"lineBreak":true},{"text":"pwe chon ekewe mwü meinisin repwe nonom lon.","poem":1},{"lineBreak":true},{"text":"Iwe, Ewe mi Unusen Tekia epwe püsin anüküchara ewe telinimw.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap epwe angei iteiten ekewe aramas,","poem":1},{"lineBreak":true},{"text":"epwe alearelong meinisin lon iteiten chon ewe telinimw Jerusalem.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Iwe, ekewe chon köl me chon pworuk ra apasa,","poem":1},{"lineBreak":true},{"text":"“Äm kewe puächen kolukun manau ra nonom lomw.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}