{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"heading","content":["Echö kölün mwareiti Kot o fel ngeni"]},{"type":"verse","number":1,"content":[{"text":"Ou etto, ousipwe köl ngeni ewe Samol mi Lapalap.","poem":1},{"lineBreak":true},{"text":"Ousipwe mweireir fän pwapwa ngeni Kot ewe mi tümwünükich.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ousipwe feito fän mesan fän kilisou,","poem":1},{"lineBreak":true},{"text":"ousipwe mweireir fän pwapwa ngeni Kot ren kölün mwareiti i.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pun ewe Samol mi Lapalap eman Kot mi tekia,","poem":1},{"lineBreak":true},{"text":"eman king mi tekia seni ekewe kot meinisin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ekewe leni mi alolol won fanüfan ra nom lepöün,","poem":1},{"lineBreak":true},{"text":"pwal ungen ekewe chuk an.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"An ewe matau, pun förian,","poem":1},{"lineBreak":true},{"text":"pwal an ewe fanüpwas, pun afisian.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ou etto, ousipwe chapetiu o fel ngeni,","poem":1},{"lineBreak":true},{"text":"ousipwe fotopwäsuk fän mesen ewe Samol mi Lapalap ewe chon förikich.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pun i ach Kot,","poem":1},{"lineBreak":true},{"text":"nge kich nöün aramas i a tümwünü,","poem":1},{"lineBreak":true},{"text":"kich nöün mwichen sip i a foleni.","poem":1},"Ikenai, are oupwe aüselinga alon,"]},{"type":"verse","number":8,"content":[{"text":"ousap apöchöküla lelukemi usun a fis me lon Meripa,","poem":1},{"lineBreak":true},{"text":"usun a fis lon ewe rän me lon ewe fanüapö lon Masa,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"lupwen ämi kewe lewo ra sotuniei, ra aleletaei,","poem":1},{"lineBreak":true},{"text":"nge ra fen küna ai kewe föför üa föri fän iter.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Lon ükükün faik ier üa song ngeni ei täppin aramas o üra,","poem":1},{"lineBreak":true},{"text":"“Ir eu mwichen aramas mi tokola leluker.","poem":1},{"lineBreak":true},{"text":"Resap fokun mochen aleasochisi ai kewe allük.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Iei mine üa pwon fän akapel lon ai song","poem":1},{"lineBreak":true},{"text":"pwe resap tongeni tolong lon ewe fanü","poem":1},{"lineBreak":true},{"text":"ia üpwe asösöör ie.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}