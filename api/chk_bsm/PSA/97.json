{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"heading","content":["Än Kot nemenem me manaman"]},{"type":"verse","number":1,"content":[{"text":"Ewe Samol mi Lapalap a nemenem, fanüfan epwe meseik,","poem":1},{"lineBreak":true},{"text":"ekewe fanüen lematau meinisin repwe pwapwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kuchu me rochokich ra pweli ünükün Kot,","poem":1},{"lineBreak":true},{"text":"pwüng me apwüng longolongun an nemenem.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ekkei a akomwola mwan","poem":1},{"lineBreak":true},{"text":"o kenala chon oputan mi nom ünükün.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"An kewe fifi ra asarama fanüfan,","poem":1},{"lineBreak":true},{"text":"chon fanüfan ra küna o chechech.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ekewe chuk ra telila usun kiris me fän mesen ewe Samol mi Lapalap,","poem":1},{"lineBreak":true},{"text":"me fän mesen ewe Samol mi nemeni unusen fanüfan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ekewe läng ra asilefeili an pwüng,","poem":1},{"lineBreak":true},{"text":"nge chon ekewe mwü meinisin ra küna an ling.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Aramas meinisin mi fel ngeni ekewe uluulun anümwäl repwe küna säw,","poem":1},{"lineBreak":true},{"text":"pwal chokewe mi aingaing won ekewe anümwäl esap wor aüchear.","poem":1},{"lineBreak":true},{"text":"Ekewe kot meinisin ra chapetiu me mwen ewe Samol mi Lapalap.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sion a rongorong ei o pwapwa.","poem":1},{"lineBreak":true},{"text":"Ekewe telinimwen Juta ra meseik","poem":1},{"lineBreak":true},{"text":"pokiten om kewe apwüng, ai Kot.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pun en, ai Samol mi Lapalap, ka fokun tekia won unusen fanüfan,","poem":1},{"lineBreak":true},{"text":"ka fokun tekia lap seni ekewe kot meinisin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ewe Samol mi Lapalap a echeni chokewe mi oput mine a ngau.","poem":1},{"lineBreak":true},{"text":"A tümwünü manauen nöün kewe chon pin","poem":1},{"lineBreak":true},{"text":"o angaseer seni ekewe aramasangau.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Saram a tinetiu won ekewe chon pwüng,","poem":1},{"lineBreak":true},{"text":"nge pwapwa a tori chokewe mi wenechar leluker.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Oupwe kilisou ngeni o mwareiti itan mi pin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}