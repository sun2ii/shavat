{"translation":{"id":"chk_bsm","name":"Paipel","website":"https://ebible.org/Scriptures/details.php?id=chk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=chk","licenseNotes":null,"shortName":"BSM","englishName":"Chuukese Bible","language":"chk","textDirection":"ltr","sha256":"17f24d351e28db3ff6db89c6f8827034551cce574e1bc22c9f016b1f9f2f1f94","availableFormats":["json"],"listOfBooksApiLink":"/api/chk_bsm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31098,"languageName":"Chuukese","languageEnglishName":"Chuukese"},"book":{"id":"PSA","translationId":"chk_bsm","name":"KÖLFEL","commonName":"KÖLFEL","title":"Kölfel","order":19,"numberOfChapters":150,"sha256":"aa0e8440ef3865cba65b9cc612732e66da6c923385f4050901231a29ac00a2e2","firstChapterNumber":1,"firstChapterApiLink":"/api/chk_bsm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/chk_bsm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"heading","content":["Än Kot allükülük ngeni chon Israel"]},{"type":"verse","number":1,"content":[{"text":"Ewe Samol mi Lapalap a nemenem. Chon ekewe mwü ra chechech.","poem":1},{"lineBreak":true},{"text":"A mot won an lenien motun king asen ekewe kerop.","poem":1},{"lineBreak":true},{"text":"Fanüfan a chechech.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ewe Samol mi Lapalap a tekia me lon Sion,","poem":1},{"lineBreak":true},{"text":"a fokun tekia seni chon ekewe mwü meinisin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aramas meinisin repwe mwareiti itan mi tekia o eniwokus.","poem":1},{"lineBreak":true},{"text":"Kot a pin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"En king mi manaman, ka efich pwüng.","poem":1},{"lineBreak":true},{"text":"Ka anüküchara mine a wenechar,","poem":1},{"lineBreak":true},{"text":"ka föri mine a pwüng me wenechar lon Israel.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oupwe ingeiti ewe Samol mi Lapalap ach Kot,","poem":1},{"lineBreak":true},{"text":"oupwe fel ngeni me mwen alongolongun pechen.","poem":1},{"lineBreak":true},{"text":"I a pin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Iwe, Moses me Aaron ra nom lein nöün kewe souasor,","poem":1},{"lineBreak":true},{"text":"pwal Samuel a nom lein chokewe mi köri itan.","poem":1},{"lineBreak":true},{"text":"Ra iotek ngeni ewe Samol mi Lapalap, nge i a pälüeniir.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A kapas ngeniir seni lon ewe ürekuchu.","poem":1},{"lineBreak":true},{"text":"Ra aleasochisi an kewe kapasen pwärätä me ekewe allük i a ngeniir.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ai Samol mi Lapalap äm we Kot, en ka pälüeni än noum aramas iotek.","poem":1},{"lineBreak":true},{"text":"En eman Kot mi amusala ar tipis,","poem":1},{"lineBreak":true},{"text":"inamwo ika ka apwüngüür ren ar föför mi mwäl.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Oupwe ingeiti ewe Samol mi Lapalap ach we Kot","poem":1},{"lineBreak":true},{"text":"o fel ngeni me arun chukun we mi pin,","poem":1},{"lineBreak":true},{"text":"pun ewe Samol mi Lapalap ach Kot a pin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/chk_bsm/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/chk_bsm/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/chk_bsm/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}