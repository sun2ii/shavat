{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"2SA","translationId":"ckb_bib","name":"دووەم ساموئێل","commonName":"دووەم ساموئێل","title":"دووەم ساموئێل","order":10,"numberOfChapters":24,"sha256":"885c99dc52794a1e50ff1d6b28a69bcbe704d503ac824ce971c09eb6cee132bc","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/ckb_bib/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["سروودی داود بۆ ستایشی خودا"]},{"type":"verse","number":1,"content":["داود ئەم سروودەی بۆ یەزدان گوت، دوای ئەوەی یەزدان لە دەستی هەموو دوژمنەکانی و لە دەستی شاول ڕزگاری کرد."]},{"type":"verse","number":2,"content":["گوتی:",{"text":"«یەزدان تاشەبەردی منە، قەڵا و دەربازکەرمە،","poem":1}]},{"type":"verse","number":3,"content":[{"text":"خودام ئەو تاشەبەردەیە کە پەنای بۆ دەبەم،","poem":2},{"lineBreak":true},{"text":"قەڵغان و هێزی ڕزگاریمە،","poem":2},{"text":"پەناگا و حەشارگەمە، ڕزگارکەری منە،","poem":1},{"text":"لە ستەم ڕزگارم دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«لە یەزدان دەپاڕێمەوە، ئەوەی کە شایانی ستایشە،","poem":1},{"text":"لە دوژمنەکانم ڕزگار دەبم،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"چونکە شەپۆلی مەرگ منی پێچایەوە،","poem":1},{"text":"لێشاوی لەناوچوون زەندەقی بردم،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"پەتی جیهانی مردووان بە دەورمدا تەنراوە،","poem":1},{"text":"داوی مردن لەبەردەمم دانراوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«لە تەنگانەمدا لە یەزدان پاڕامەوە،","poem":1},{"text":"هاوارم بردە بەر خودام،","poem":2},{"text":"لە پەرستگاکەیەوە گوێی لە دەنگی من بوو،","poem":1},{"text":"گوێی لە هاوارم بوو.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئینجا زەوی لەرزی و هەژا،","poem":1},{"text":"بناغەکانی ئاسمان ڕاژەنین،","poem":2},{"lineBreak":true},{"text":"لە تووڕەیی ئەو لەرزین.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"دووکەڵ لە لووتی بەرزبووەوە،","poem":1},{"text":"ئاگرێکی لووشدەر لە دەمی هاتە دەرەوە،","poem":2},{"lineBreak":true},{"text":"وەک ژیلەمۆی پشکۆی داگیرساو بوو.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئاسمانی شەقکرد و دابەزییە خوارەوە،","poem":1},{"text":"هەوری تاریک لەژێر پێی بوو.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"سواری کەڕوب","poem":1},{"noteId":43},{"text":"بوو و فڕی،","poem":1},{"text":"بەسەر باڵی بادا بەرزبووەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"تاریکی کردە ڕەشماڵ لە دەوری خۆی،","poem":1},{"text":"هەوری تاریکی پڕ بارانی ئاسمان.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لە ڕۆشنایی ئامادەبوونی ئەو","poem":1},{"text":"پشکۆ ئاگرەکان داگیرسان.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"یەزدان لە ئاسمانەوە گرماندی،","poem":1},{"text":"ئەو خودایەی هەرەبەرزە دەنگی خۆی لەرزاندەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"تیرەکانی هاویشت و بڵاوەی بە دوژمنەکانی کرد،","poem":1},{"text":"بە بروسکەی گەورە پەرێشانی کردن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بنی دەریا دەرکەوت،","poem":1},{"text":"بناغەکانی زەوی ئاشکرا بوون،","poem":2},{"text":"لە سەرزەنشتی یەزدان،","poem":1},{"text":"لە گەرمی هەناسەی لووتی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«لە بەرزاییەوە دەستی درێژکرد و منی گرت،","poem":1},{"text":"لەناو ئاوە قووڵەکانەوە دەریهێنام.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"لە دوژمنە بە تواناکەم ڕزگاری کردم،","poem":1},{"text":"لە ناحەزەکانم کە زۆر لە من بەهێزتر بوون.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"لە ڕۆژی لێقەومانم هاتنە سەرم،","poem":1},{"text":"بەڵام یەزدان پشت و پەنام بوو.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"منی هێنایە دەرەوە بۆ جێگایەکی پان و بەرین،","poem":1},{"text":"ڕزگاری کردم، چونکە دڵخۆشە پێم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«یەزدان بەگوێرەی ڕاستودروستیم پاداشتی داومەتەوە،","poem":1},{"text":"بەگوێرەی دەستپاکیم ڕێزداری کردووم،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"چونکە من ڕێچکەی یەزدانم گرتووەتەبەر،","poem":1},{"text":"لە خودای خۆم یاخی نەبووم.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"هەموو حوکمەکانی لەبەرچاومدان،","poem":1},{"text":"لە فەرزەکانی لام نەداوە.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"لەبەردەمی ئەو بێ کەموکوڕی بووم و","poem":1},{"text":"خۆم لە گوناه پاراستووە.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"یەزدان بەگوێرەی ڕاستودروستیم پاداشتی داومەتەوە،","poem":1},{"text":"بەگوێرەی دەستپاکیم لەبەردەمی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«لەگەڵ دڵسۆزەکان دڵسۆزی دەنوێنیت،","poem":1},{"text":"لەگەڵ ئەوانەی بێ کەموکوڕین چاکی دەنوێنیت،","poem":2}]},{"type":"verse","number":27,"content":[{"text":"لەگەڵ پاکەکان پاکی دەنوێنیت،","poem":1},{"text":"بەڵام لەگەڵ خوارەکان زیرەکی دەنوێنیت.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"تۆ خەڵکی بێفیز ڕزگار دەکەیت،","poem":1},{"text":"بەڵام چاوەکانت لەسەر لووتبەرزانە، دەیانشکێنیت.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ئەی یەزدان، تۆ چرای منیت،","poem":1},{"text":"یەزدان تاریکیم ڕووناک دەکاتەوە.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"بە یارمەتی تۆ دەتوانم لەشکرێک تێکبشکێنم،","poem":1},{"text":"لەگەڵ خودای خۆم دەتوانم بەسەر شووراکاندا سەربکەوم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«ڕێبازی خودا تەواوە،","poem":1},{"text":"بەڵێنی یەزدان بێگەردە،","poem":2},{"lineBreak":true},{"text":"ئەو قەڵغانە بۆ هەموو ئەوانەی پەنای بۆ دەبەن.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"لە یەزدان بەولاوە کێ خودایە؟","poem":1},{"text":"لە خودامان بەولاوە کێ تاشەبەردەکەیە؟","poem":2}]},{"type":"verse","number":33,"content":[{"text":"خودایە ئەوەی بە هێز پاڵپشتیم دەکات،","poem":1},{"text":"بە تەواوی ڕێگام لەبەردەمدا دەکاتەوە.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"پێیەکانم وەک پێی ئاسک لێ دەکات،","poem":1},{"text":"لەسەر بەرزایی ڕامدەگرێت.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"مەشق بە دەستەکانم دەکات بۆ جەنگ،","poem":1},{"text":"تاکو بتوانم بە بازووم کەوانی بڕۆنز بچەمێنمەوە.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"تۆ قەڵغانی ڕزگاریی خۆتت پێ بەخشیوم،","poem":1},{"text":"هاوکاریت گەورەم دەکات.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"جێی هەنگاوەکانم تەخت و فراوان دەکەیت،","poem":1},{"text":"تاکو پێم نەخلیسکێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"«دوژمنەکانم ڕاونا و وردوخاشم کردن،","poem":1},{"text":"هەتا لەناوم نەبردن نەگەڕامەوە.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"لەناوم بردن و وردوخاشم کردن، ئیتر نەیانتوانی هەستنەوە،","poem":1},{"text":"لەژێر پێم کەوتن.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"کەمەری منت توند کرد بۆ جەنگ،","poem":1},{"text":"وات لە بەرهەڵستکارانی من کرد لەبەر پێم کڕنۆش ببەن.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"دوژمنەکانم پشتیان تێ کردم و ڕایانکرد،","poem":1},{"text":"من ناحەزەکانی خۆمم لەناوبرد.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"هاواریان هێنا، بەڵام ڕزگارکەر نەبوو،","poem":1},{"text":"هاواریان بۆ یەزدان برد، بەڵام بە دەنگیانەوە نەچوو.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"وەک تۆزی زەوی ئەوانم هاڕی،","poem":1},{"text":"وەک قوڕی سەر ڕێگا پێم خستە سەریان و پێشێلم کردن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"«لە هێرشی گەلان ڕزگارت کردم،","poem":1},{"text":"تۆ منت بە سەرۆکی نەتەوەکان هێشتەوە.","poem":2},{"text":"گەلێک کە نەمدەناسین خزمەتم دەکەن،","poem":1}]},{"type":"verse","number":45,"content":[{"text":"بێگانەکان ملکەچیم بۆ دەنوێنن،","poem":2},{"lineBreak":true},{"text":"هەرکە دەنگم دەبیستن گوێڕایەڵم دەبن.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"بێگانەکان ورە بەر دەدەن و","poem":1},{"text":"بە لەرزەوە لە قەڵاکانیان دێنە دەرەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"«یەزدان زیندووە، ستایش بۆ تاشەبەردەکەم!","poem":1},{"text":"خودای ڕزگارکەرم تاشەبەردەکەیە، پایەبەرزە!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"خودایە کە تۆڵەم بۆ دەکاتەوە،","poem":1},{"text":"گەلان ملکەچی من دەکات،","poem":2}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"لە چنگی دوژمنەکانم دەرمدەهێنێت.","poem":2},{"text":"پایەبەرزی کردم بەسەر ناحەزانم،","poem":1},{"text":"لە دەست پیاوێکی توندوتیژ ڕزگارت کردم.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"لەبەر ئەوە ئەی یەزدان، لەنێو نەتەوەکاندا ستایشت دەکەم،","poem":1},{"text":"گۆرانی ستایش بۆ ناوت دەڵێم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"«سەرکەوتنی گەورە بە پاشای خۆی دەبەخشێت،","poem":1},{"text":"خۆشەویستی نەگۆڕ بەسەر دەستنیشانکراوەکەیدا دەبارێنێت،","poem":2},{"lineBreak":true},{"text":"بۆ سەر داود و نەوەکانی بۆ هەتاهەتایە.»","poem":2}]}],"footnotes":[{"noteId":43,"caller":"+","text":"کەڕوب: بوونەوەرێکی ئاسمانی باڵدارە. بڕوانە حزقیێل 10‏:5‏‏.‏","reference":{"chapter":22,"verse":11}}]},"thisChapterLink":"/api/ckb_bib/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/2SA/21.json