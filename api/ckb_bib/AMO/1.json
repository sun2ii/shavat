{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"AMO","translationId":"ckb_bib","name":"ئامۆس","commonName":"ئامۆس","title":"ئامۆس","order":30,"numberOfChapters":9,"sha256":"8062ae3f9324ffc2e080b89aba02e3222ff76237776891c4d165edeb2e744d75","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/ckb_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ئەمە پەیامی ئامۆسە کە یەکێک بوو لە شوانەکانی شارۆچکەی تەقۆعە، دوو ساڵ پێش بوومەلەرزەکە لە سەردەمی عوزیای پاشای یەهودا و لە سەردەمی یارۆڤعامی کوڕی یەهۆئاشی پاشای ئیسرائیل، ئەم بینینەی دەربارەی ئیسرائیل بۆ ئاشکرا کرا."]},{"type":"line_break"},{"type":"verse","number":2,"content":["گوتی:",{"text":"«یەزدان لە سییۆنەوە دەنەڕێنێت،","poem":1},{"text":"لە ئۆرشەلیمەوە دەنگی دێت،","poem":2},{"text":"لەوەڕگای شوانەکان شیوەن دەگێڕن و","poem":1},{"text":"لووتکەی کارمەل وشک دەبێت.»","poem":2}]},{"type":"heading","content":["حوکم بەسەردادانی وڵاتانی دەوروبەر"]},{"type":"verse","number":3,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«دیمەشق یاخی بوو، لە یاخیبوونەکەی بەردەوامە،","poem":1},{"text":"سزاکەیان بەسەردا تێناپەڕێنم،","poem":2},{"lineBreak":true},{"text":"لەبەر ئەوەی بە جەنجەڕی ئاسن گلعادیان شێلا،","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئاگر دەنێرمە سەر ماڵی حەزائێل،","poem":1},{"text":"قەڵاکانی بەن‌هەدەد دەخوات.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"شەوبەندی دەروازەکانی دیمەشق دەشکێنم،","poem":1},{"text":"فەرمانڕەواکە لە دۆڵی ئاڤەن ڕیشەکێش دەکەم،","poem":2},{"text":"هەروەها گۆچان بەدەست لە بێت‌عەدەن.","poem":1},{"text":"گەلی ئارام بۆ قییر ڕاپێچ دەکرێن.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":6,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«غەزە یاخی بوو، لە یاخیبوونەکەی بەردەوامە،","poem":1},{"text":"سزاکەیان بەسەردا تێناپەڕێنم،","poem":2},{"text":"لەبەر ئەوەی چەند کۆمەڵگایەکی بە تەواوەتی بە دیل گرت و","poem":1},{"text":"بە ئەدۆمی فرۆشت،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئاگر دەنێرمە سەر شووراکانی غەزە،","poem":1},{"text":"قەڵاکانی دەخوات.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"فەرمانڕەواکە لە ئەشدۆد ڕیشەکێش دەکەم و","poem":1},{"text":"گۆچان بەدەست لە ئەسقەلان.","poem":2},{"text":"دەستم دەگەڕێنمەوە سەر عەقرۆن،","poem":1},{"text":"پاشماوەی فەلەستییەکان لەناودەچن.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانی باڵادەستە.","poem":4}]},{"type":"verse","number":9,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«سور یاخی بوو، لە یاخیبوونەکەی بەردەوامە،","poem":1},{"text":"سزاکەیان بەسەردا تێناپەڕێنم،","poem":2},{"text":"لەبەر ئەوەی تەواوی چەند کۆمەڵگایەکی بە دیلگیراوی فرۆشتە ئەدۆم و","poem":1},{"text":"پەیمانی برایەتییان نەهێنایەوە یادیان،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئاگر دەنێرمە سەر شووراکانی سور،","poem":1},{"text":"قەڵاکانی دەخوات.»","poem":2}]},{"type":"verse","number":11,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«لەبەر ئەوەی ئەدۆم یاخی بوو، لە یاخیبوونەکەی بەردەوامە،","poem":1},{"text":"سزاکەیان بەسەردا تێناپەڕێنم،","poem":2},{"text":"لەبەر ئەوەی بە شمشێرەوە دوای براکەی کەوت،","poem":1},{"text":"بەبێ دەربڕینی بەزەیی.","poem":2},{"text":"هەروەها لەبەر ئەوەی تووڕەییەکەی بەردەوام لە جۆش بوو،","poem":1},{"text":"قینیشی بۆ هەتاهەتایە هەڵدەگرت،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"هەر لەبەر ئەوە ئاگر دەنێرمە سەر تێمان،","poem":1},{"text":"قەڵاکانی بۆزرا دەخوات.»","poem":2}]},{"type":"verse","number":13,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«عەمۆن یاخی بوو، لە یاخیبوونەکەی بەردەوامە،","poem":1},{"text":"سزاکەیان بەسەردا تێناپەڕێنم،","poem":2},{"text":"لەبەر ئەوەی سکپڕەکانی گلعادیان هەڵدڕی،","poem":1},{"text":"بۆ ئەوەی سنوورەکانیان بەرفراوان بکەن،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئاگر لە شووراکانی ڕەبە بەردەدەم","poem":1},{"text":"قەڵاکانی دەخوات،","poem":2},{"text":"بە هاتوهاوارەوە لە ڕۆژی جەنگدا،","poem":1},{"text":"بە زریانەوە لە ڕۆژی باوباراندا.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"پاشاکەیان ڕاپێچ دەکرێت،","poem":1},{"text":"ئەو و هەموو کاربەدەستەکانی بە یەک جار.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}