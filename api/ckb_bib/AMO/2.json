{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"AMO","translationId":"ckb_bib","name":"ئامۆس","commonName":"ئامۆس","title":"ئامۆس","order":30,"numberOfChapters":9,"sha256":"8062ae3f9324ffc2e080b89aba02e3222ff76237776891c4d165edeb2e744d75","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/ckb_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«مۆئاب یاخی بوو، لە یاخیبوونەکەی بەردەوامە،","poem":1},{"text":"سزاکەیان بەسەردا تێناپەڕێنم،","poem":2},{"text":"لەبەر ئەوەی ئێسکەکانی پاشای ئەدۆمی سووتاند","poem":1},{"text":"هەتا ئەوەی بووە گەچ،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"هەر لەبەر ئەوە ئاگر دەنێرمە سەر مۆئاب،","poem":1},{"text":"قەڵاکانی قەریۆت دەخوات.","poem":2},{"text":"مۆئاب لەناو هاژەهاژ دەمرێت،","poem":1},{"text":"لەنێو هاتوهاوار و دەنگی کەڕەنا.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"فەرمانڕەوا لە ناوەڕاستیدا ڕیشەکێش دەکەم و","poem":1},{"text":"هەموو کاربەدەستەکانی لەگەڵیدا دەکوژم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":4,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«یەهودا یاخی بوو، لە یاخیبوونەکەی بەردەوامە،","poem":1},{"text":"سزاکەیان بەسەردا تێناپەڕێنم،","poem":2},{"text":"لەبەر ئەوەی فێرکردنی یەزدانیان ڕەتکردەوە و","poem":1},{"text":"فەرزەکانی ئەویان بەجێنەهێنا،","poem":2},{"text":"چونکە درۆکانیان فریوی دان","poem":1},{"text":"ئەوەی باوکانیان دوایان کەوتن،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"هەر لەبەر ئەوە ئاگر دەنێرمە سەر یەهودا،","poem":1},{"text":"قەڵاکانی ئۆرشەلیم دەخوات.»","poem":2}]},{"type":"heading","content":["حوکم بەسەردادانی ئیسرائیل"]},{"type":"verse","number":6,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«ئیسرائیل یاخی بوو، لە یاخیبوونەکەی بەردەوامە،","poem":1},{"text":"سزاکەیان بەسەردا تێناپەڕێنم،","poem":2},{"text":"کەسانی ڕاستودروست بە زیو دەفرۆشن،","poem":1},{"text":"نەداریش بۆ جووتێک پێڵاو.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"سەری هەژاران لەسەر خۆڵی زەوی پێشێل دەکەن،","poem":1},{"text":"ڕێگای کڵۆڵان خوار دەکەنەوە.","poem":2},{"text":"پیاوێک و باوکی بۆ لای یەک کچ دەچن،","poem":1},{"text":"تاکو ناوی پیرۆزم بزڕێنن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"لەسەر جلوبەرگێک ڕادەکشێن کە بە بارمتە وەریانگرتووە","poem":1},{"text":"لە پاڵ هەموو قوربانگایەک،","poem":2},{"text":"شەرابی بە سەرانە وەرگیراو دەخۆنەوە","poem":1},{"text":"لەناو ماڵی خوداوەندیان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«من بووم کە ئەمۆرییەکانم لەپێشیان لەناوبرد،","poem":1},{"text":"ئەوانەی باڵایان وەک باڵای دار ئورز بوو،","poem":2},{"lineBreak":true},{"text":"وەک دار بەڕوو بەهێز بوون.","poem":2},{"text":"بەروبوومی ئەوانم لە سەرەوە لەناوبرد و","poem":1},{"text":"ڕەگوڕیشاڵیان لە ژێرەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"من بووم کە لە خاکی میسرەوە دەرمهێنان،","poem":1},{"text":"چل ساڵ لە چۆڵەوانیدا بەڕێم خستن،","poem":2},{"lineBreak":true},{"text":"بۆ ئەوەی دەست بەسەر خاکی ئەمۆرییەکاندا بگرن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«لەنێو کوڕەکانتان پێغەمبەرانم بۆ دانان و","poem":1},{"text":"لەنێو لاوەکانتان ئەوانەی نەزریان لە خۆیان گرتبوو","poem":2},{"noteId":0},{"text":".","poem":2},{"lineBreak":true},{"text":"ئەی نەوەی ئیسرائیل، ئایا وا نەبوو؟»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"«بەڵام ئێوە شەرابتان دەرخواردی ئەوانە دا کە نەزریان لە خۆیان گرتبوو،","poem":1},{"text":"فەرمانتان بە پێغەمبەران کرد پێشبینی نەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«ئەوەتا من لە شوێنی خۆتان دەتانچەقێنم","poem":1},{"text":"وەک چۆن جەنجەڕ دەچەقێت","poem":2},{"lineBreak":true},{"text":"لەبەر پڕی گوڵەگەنمەکان.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەوەی خێرایە هەڵنایەت،","poem":1},{"text":"بەهێز هێزی خۆی توندوتۆڵ ناکات و","poem":2},{"lineBreak":true},{"text":"پاڵەوان گیانی خۆی دەرباز ناکات.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"تیرهاوێژ خۆی ڕاناگرێت،","poem":1},{"text":"ئەوەی پێیەکانی سووک بێت هەڵنایەت و","poem":2},{"lineBreak":true},{"text":"ئەسپ سواریش گیانی خۆی دەرباز ناکات.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئەوەی بەجەرگە لەنێو پاڵەوانان","poem":1},{"text":"لەو ڕۆژەدا بە ڕووتی هەڵدێت.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]}],"footnotes":[{"noteId":0,"caller":"+","text":"بڕوانە سەرژمێری 6‏:1‏-21.‏‏","reference":{"chapter":2,"verse":11}}]},"thisChapterLink":"/api/ckb_bib/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}