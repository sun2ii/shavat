{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"AMO","translationId":"ckb_bib","name":"ئامۆس","commonName":"ئامۆس","title":"ئامۆس","order":30,"numberOfChapters":9,"sha256":"8062ae3f9324ffc2e080b89aba02e3222ff76237776891c4d165edeb2e744d75","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/ckb_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["بانگکردنی شایەتەکان لە دژی ئیسرائیل"]},{"type":"verse","number":1,"content":["ئەی نەوەی ئیسرائیل، گوێتان لەم فەرمایشتە بێت کە یەزدان فەرموویەتی، لە دژی ئێوە و هەموو ئەو خێڵەی لە خاکی میسرەوە دەریهێنان، کە فەرمووی:"]},{"type":"verse","number":2,"content":[{"text":"«تەنها ئێوەم ناسی","poem":1},{"text":"لە هەموو خێڵەکانی زەوی،","poem":2},{"text":"لەبەر ئەوە سزاتان دەدەم،","poem":1},{"text":"لەسەر هەموو تاوانەکانتان.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ئایا دووان پێکەوە هاتوچۆ دەکەن،","poem":1},{"text":"بێ ئەوەی ڕێک بکەون؟","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئایا شێر لە دارستان دەنەڕێنێت،","poem":1},{"text":"ئەگەر نێچیری نەبێت؟","poem":2},{"text":"ئایا بەچکە شێر لە لانەکەیەوە دەنگی دێت،","poem":1},{"text":"بێ ئەوەی هیچی ڕفاندبێت؟","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئایا باڵندە دەکەوێتە ناو داوی زەوییەوە،","poem":1},{"text":"لە کاتێکدا تەڵەی بۆ نەنرابێتەوە؟","poem":2},{"text":"ئایا تەڵە لەسەر زەوی هەڵدەگیرێتەوە،","poem":1},{"text":"ئەگەر هیچی نەگرتبێت؟","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەگەر کەڕەنا لە شاردا لێبدرێت،","poem":1},{"text":"ئایا گەل ناترسێت؟","poem":2},{"text":"ئەگەر بەڵایەک لە شاردا ڕوو بدات،","poem":1},{"text":"ئایا یەزدان نەیکردووە؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"بێگومان یەزدانی باڵادەست هیچ کارێک ناکات","poem":1},{"text":"بێ ئەوەی نهێنییەکەی بۆ بەندە پێغەمبەرەکانی ئاشکرا بکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"شێر نەڕاندی،","poem":1},{"text":"کێ ناترسێت؟","poem":2},{"text":"یەزدانی باڵادەست دەفەرموێت،","poem":1},{"text":"کێ هەیە بتوانێت پەیامی خودا ڕانەگەیەنێت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"بە قەڵاکانی ئەشدۆد و خاکی میسر ڕایبگەیەنن و","poem":1},{"text":"پێیان بڵێن:","poem":2},{"text":"«لەسەر چیاکانی سامیرە کۆببنەوە،","poem":1},{"text":"ئەو هاتوهاوارە زۆرەی ناوەڕاستی ببینن،","poem":2},{"lineBreak":true},{"text":"ئەو زۆردارییەی لەناویدا هەیە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"یەزدان دەفەرموێت: «نازانن کاری باش بکەن،","poem":1},{"text":"ئەوانەی بەرهەمی تاڵان و ستەمکاری لە قەڵاکانیان ئەمبار دەکەن.»","poem":2}]},{"type":"verse","number":11,"content":["لەبەر ئەوە یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«دوژمن دێنە چواردەوری خاکەکە و","poem":1},{"text":"هێزتان لێ کەم دەکاتەوە و","poem":2},{"lineBreak":true},{"text":"قەڵاکانتان تاڵان دەکرێن.»","poem":2}]},{"type":"verse","number":12,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«وەک چۆن شوان دوو قاچ یان پارچە گوێیەک","poem":1},{"text":"لە دەمی شێر دەردەهێنێت،","poem":2},{"text":"ئاواش ئیسرائیلییەکانی دانیشتووی سامیرە","poem":1},{"text":"بە گۆشەی قەرەوێڵەیەک و","poem":2},{"lineBreak":true},{"text":"بە پارچە پێخەفێک دەردەکرێن.»","poem":2}]},{"type":"verse","number":13,"content":["«گوێ بگرن و شایەتی لەسەر بنەماڵەی یاقوب بدەن،» ئەوە فەرمایشتی یەزدانی پەروەردگار، خودای سوپاسالارە."]},{"type":"verse","number":14,"content":[{"text":"«لەو ڕۆژەی کە سزای ئیسرائیل دەدەم لەسەر یاخیبوونەکانی،","poem":1},{"text":"سزای قوربانگاکانی بێت‌ئێلیش دەدەم،","poem":2},{"text":"جا قۆچی قوربانگاکان دەبڕێنەوە و","poem":1},{"text":"دەکەونە سەر زەوی.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"کۆشکی زستانە دادەڕمێنم،","poem":1},{"text":"هەروەها کۆشکی هاوینەش،","poem":2},{"lineBreak":true},{"text":"کۆشکە عاجەکانیش لەناودەچن و","poem":2},{"lineBreak":true},{"text":"هەموو کۆشکەکان کۆتاییان پێدێت.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}