{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"AMO","translationId":"ckb_bib","name":"ئامۆس","commonName":"ئامۆس","title":"ئامۆس","order":30,"numberOfChapters":9,"sha256":"8062ae3f9324ffc2e080b89aba02e3222ff76237776891c4d165edeb2e744d75","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/ckb_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["نەگەڕانەوەی ئیسرائیل بۆ لای خودا"]},{"type":"verse","number":1,"content":[{"text":"ئەی مانگاکانی باشان، ئەوانەی لە کێوی سامیرەن،","poem":1},{"text":"ئەی خاتوونەکان، ئەی ئەو ژنانەی ستەم لە هەژاران دەکەن،","poem":2},{"lineBreak":true},{"text":"نەداران وردوخاش دەکەن و","poem":2},{"text":"بە مێردەکانیان دەڵێن، «خواردنەوەمان بۆ بهێنن!»","poem":1},{"text":"گوێتان لەم پەیامە بێت:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"یەزدانی باڵادەست سوێندی بە پیرۆزی خۆی خوارد:","poem":1},{"text":"«بێگومان ڕۆژێک دێت،","poem":2},{"text":"خۆتان بە قولاپ دەگیرێن و","poem":1},{"text":"دوا کەسیشتان بە قولاپی ماسی.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"هەریەکە و لەپێش خۆیەوە","poem":1},{"text":"بەناو کەلێنی دیوارێکدا دەبردرێن و","poem":2},{"lineBreak":true},{"text":"فڕێدەدرێنە هەرمۆن.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"«وەرن بۆ بێت‌ئێل و یاخی ببن،","poem":1},{"text":"لە گلگال یاخیبوون زۆر بکەن.","poem":2},{"text":"هەموو بەیانییەک قوربانییەکانتان بهێنن،","poem":1},{"text":"هەر سێ ساڵ جارێک دەیەکەکانتان.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەی نەوەی ئیسرائیل، لە هەویرترشەوە","poem":1},{"noteId":1},{"text":"قوربانی سوپاسگوزاری بسووتێنن،","poem":1},{"text":"بانگەواز بۆ بەخشینی ئازاد بکەن و ڕایبگەیەنن،","poem":2},{"lineBreak":true},{"text":"چونکە واتان پێ خۆش بوو.»","poem":2},{"text":"ئەوە فەرموودەی یەزدانی باڵادەستە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«هەروەها منیش لە هەموو شارۆچکەکانتان سک بەتاڵی و","poem":1},{"text":"لە هەموو شوێنەکانتان کەمی نانم پێدان،","poem":2},{"lineBreak":true},{"text":"بەڵام ئێوە بۆ لای من نەگەڕانەوە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«هەروەها بارانم لێ گرتنەوە","poem":1},{"text":"هێشتا سێ مانگی مابوو بۆ دروێنە.","poem":2},{"text":"بارانم بەسەر شارۆچکەیەکدا باراند و","poem":1},{"text":"بەسەر شارۆچکەیەکی دیکەدا نەمباراند.","poem":2},{"text":"بەسەر کێڵگەیەکدا باری و","poem":1},{"text":"ئەو کێڵگەش کە بەسەریدا نەباری وشک بوو.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"خەڵکی دوو سێ شارۆچکە بۆ ئاو خواردنەوە چوونە شارۆچکەیەکی دیکە،","poem":1},{"text":"تینووێتییان نەشکا،","poem":2},{"lineBreak":true},{"text":"بەڵام ئێوە بۆ لای من نەگەڕانەوە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«زۆر جار باخ و ڕەزەمێوی ئێوەم هەڵپڕووکاندووە،","poem":1},{"text":"بە بای گەرمەسێر و کەڕوو.","poem":2},{"text":"کوللە دار هەنجیر و دار زەیتوونیان خواردووە،","poem":1},{"text":"بەڵام ئێوە بۆ لای من نەگەڕاونەتەوە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«دەردم ناردە سەر ئێوە،","poem":1},{"text":"وەک ئەوەی ناردبوومە سەر میسر.","poem":2},{"lineBreak":true},{"text":"بە شمشێر لاوەکانی ئێوەم کوشت،","poem":2},{"lineBreak":true},{"text":"لەگەڵ ئەسپە ڕاپێچکراوەکان،","poem":2},{"text":"وام کرد بۆنی بۆگەنی تەرمەکانی ناو ئۆردوگاکەتان بکەن،","poem":1},{"text":"بەڵام ئێوە بۆ لای من نەگەڕانەوە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«هەندێکتانم هەڵگەڕاندەوە،","poem":1},{"text":"وەک چۆن سەدۆم و عەمۆرام هەڵگەڕاندەوە،","poem":2},{"text":"وەک پارچە دارێکی گڕگرتووتان لێهات کە لەناو ئاگرەوە دەرهێنرابێت،","poem":1},{"text":"بەڵام ئێوە بۆ لای من نەگەڕانەوە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«ئەی ئیسرائیل، ئاوات پێ دەکەم،","poem":1},{"text":"ئەی ئیسرائیل، لەبەر ئەوەی ئەمەت پێ دەکەم،","poem":2},{"text":"ئامادەبە بۆ ڕووبەڕووبوونەوەی خوداکەت.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"شێوەداڕێژی چیاکان و","poem":1},{"text":"بەدیهێنەری با،","poem":2},{"lineBreak":true},{"text":"ئەوەی بیرکردنەوەی خۆی بە مرۆڤ ڕادەگەیەنێت،","poem":2},{"text":"ئەوەی بەرەبەیان دەکاتە تاریکی،","poem":1},{"text":"بەسەر بەرزاییەکانی زەویدا دەڕوات،","poem":2},{"lineBreak":true},{"text":"ناوی یەزدانی پەروەردگاری سوپاسالارە.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"هەویرترش: لە جیاتی خومرە بۆ هەوێن بەکارهاتووە.‏","reference":{"chapter":4,"verse":5}}]},"thisChapterLink":"/api/ckb_bib/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}