{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"AMO","translationId":"ckb_bib","name":"ئامۆس","commonName":"ئامۆس","title":"ئامۆس","order":30,"numberOfChapters":9,"sha256":"8062ae3f9324ffc2e080b89aba02e3222ff76237776891c4d165edeb2e744d75","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/ckb_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["لاوانەوە و بانگەوازی تۆبەکردن"]},{"type":"verse","number":1,"content":["ئەی بنەماڵەی ئیسرائیل، گوێ لەم پەیامە بگرن، ئەم لاوانەوەیە کە من بەسەر ئێوەیدا هەڵدەدەم:"]},{"type":"verse","number":2,"content":[{"text":"«ئیسرائیلی پاکیزە کەوت،","poem":1},{"text":"جارێکی دیکە هەڵناستێتەوە،","poem":2},{"text":"فڕێدرایە سەر خاکەکەی،","poem":1},{"text":"کوا ئەوەی هەڵیدەستێنێتەوە؟»","poem":2}]},{"type":"verse","number":3,"content":["سەبارەت بەمەش یەزدانی باڵادەست بەم جۆرە دەفەرموێت:",{"text":"«ئەو شارەی لە ماڵی ئیسرائیل هەزار سەرباز دەنێرێت،","poem":1},{"text":"سەد سەربازی بۆ دەمێنێتەوە،","poem":2},{"text":"ئەو شارۆچکەیەی سەد سەرباز دەنێرێت،","poem":1},{"text":"دە سەربازی بۆ دەمێنێتەوە.»","poem":2}]},{"type":"verse","number":4,"content":["لەبەر ئەوە یەزدان ئاوا بە بنەماڵەی ئیسرائیل دەفەرموێت:",{"text":"«ڕوو لە من بکەن و بژین،","poem":1}]},{"type":"verse","number":5,"content":[{"text":"ڕوو لە بێت‌ئێل مەکەن و","poem":2},{"text":"مەچن بۆ گلگال و","poem":1},{"text":"بۆ بیری شابەع مەپەڕنەوە،","poem":2},{"text":"چونکە گلگال بە دیل گیراوی ڕاپێچ دەکرێت و","poem":1},{"text":"بێت‌ئێل دەبێتە نەبوو","poem":2},{"noteId":2},{"text":".»","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ڕوو لە یەزدان بکەن و بژین،","poem":1},{"text":"ئەگینا وەک ئاگر پڕدەداتە بنەماڵەی یوسف،","poem":2},{"text":"ئاگرەکەش دانیشتووانی بێت‌ئێل دەخوات و","poem":1},{"text":"کەس ناتوانێت بیکوژێنێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئەی ئەوانەی دادپەروەریتان کردە زەقنەبووت،","poem":1},{"text":"ڕاستودروستیش بە زەویدا دەدەن!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ئەوەی کەلووەکانی حەوتەوانە و ڕاوچی دروستکردووە،","poem":1},{"text":"سێبەری مەرگ بۆ بەیان دەگۆڕێت و","poem":2},{"lineBreak":true},{"text":"ڕۆژ وەک شەو تاریک دەکات،","poem":2},{"text":"ئاوی دەریا بانگ دەکات و","poem":1},{"text":"بەسەر ڕووی زەویدا دەیڕێژێت،","poem":2},{"lineBreak":true},{"text":"ناوی یەزدانە،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەوەی وێرانی بەسەر قەڵادا دەبارێنێت و","poem":1},{"text":"وێرانی بەسەر شاری قەڵابەنددا دێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ئەوان لە دادگا ڕقیان لە سەرزەنشتکار دەبێتەوە و","poem":1},{"text":"قێزیان لە کەسی ڕاستگۆ دەبێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"لەبەر ئەوەی ئێوە هەژار پێشێل دەکەن و","poem":1},{"text":"بەشە گەنمی لێ دەستێنن،","poem":2},{"text":"ئەوا ئەو کۆشکەی کە لە بەردی داتاشراو بنیاد نراوە،","poem":1},{"text":"تێیاندا دانانیشن،","poem":2},{"text":"ئەو ڕەزەمێوە بەردارەی چاندووتانە،","poem":1},{"text":"لە شەرابەکەی ناخۆنەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"دەزانم یاخیبوونەکانتان زۆرن،","poem":1},{"text":"گوناهەکانتان گەورەن.","poem":2},{"lineBreak":true},{"text":"ستەمکارانی ڕاستودروست و بەرتیلخۆران،","poem":1},{"text":"مافی هەژاران لە دادگادا دادەماڵن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لەبەر ئەوە لەو کاتەدا کەسی وریا بێدەنگ دەبێت،","poem":1},{"text":"چونکە کاتێکی خراپە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"دوای چاکە بکەون نەک خراپە،","poem":1},{"text":"بۆ ئەوەی بژین،","poem":2},{"text":"جا وا دەبێت، یەزدانی پەروەردگاری سوپاسالار لەگەڵتاندا دەبێت،","poem":1},{"text":"وەک خۆتان گوتتان.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ڕقتان لە خراپە بێتەوە و حەزتان لە چاکە بێت،","poem":1},{"text":"دادپەروەری لە دادگادا بچەسپێنن،","poem":2},{"text":"ڕەنگە یەزدانی پەروەردگاری سوپاسالار","poem":1},{"text":"لەگەڵ پاشماوەی یوسف میهرەبان بێت.","poem":2}]},{"type":"verse","number":16,"content":["لەبەر ئەوە یەزدانی پەروەردگاری سوپاسالار، پەروەردگار ئەمە دەفەرموێت:",{"text":"«لە هەموو گۆڕەپانەکاندا شیوەن دەگێڕن و","poem":1},{"text":"لە هەموو شەقامەکاندا دەڵێن: ”ئای! ئای!“","poem":2},{"text":"جوتیارەکان بۆ گریان بانگ دەکەن و","poem":1},{"text":"ئەوانەی وەستای لاوانەوەشن بۆ شیوەن گێڕان.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لە هەموو ڕەزەمێوەکاندا شیوەن دەبێت،","poem":1},{"text":"چونکە بە ناوەڕاستتدا تێدەپەڕم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"heading","content":["ڕۆژی یەزدان"]},{"type":"verse","number":18,"content":[{"text":"قوڕبەسەر ئەوانەی تامەزرۆی","poem":1},{"text":"ڕۆژی یەزدانن!","poem":2},{"noteId":3},{"text":"بۆچی تامەزرۆی ڕۆژی یەزدانن؟","poem":1},{"text":"ئەو ڕۆژە تاریکییە نەک ڕووناکی.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"وەک پیاوێک لەبەردەم شێر هەڵبێت و","poem":1},{"text":"تووشی ورچێک بێت،","poem":2},{"text":"یان بێتە ماڵەوە و دەستی لەسەر دیوارەکە دابنێت و","poem":1},{"text":"مار پێوەی بدات.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئایا ڕۆژی یەزدان تاریک و بێ ڕووناکی نابێت؟","poem":1},{"text":"ئایا ئەنگوستەچاو و بێ تروسکایی نابێت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«ڕقم لە جەژنەکانتان دەبێتەوە و ڕەتیان دەکەمەوە،","poem":1},{"text":"چێژ لە کۆڕەکانتان نابینم.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"تەنانەت ئەگەر قوربانی سووتاندنەکان و","poem":1},{"text":"پێشکەشکراوەکانی دانەوێڵەتان پێشکەش بکەن ڕازی نابم،","poem":2},{"lineBreak":true},{"text":"ئاوڕ لە قوربانی هاوبەشی","poem":2},{"noteId":4},{"text":"نادەمەوە، لە دابەستەکانتان.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ژاوەژاوی گۆرانییەکانتانم لێ دووربخەنەوە!","poem":1},{"text":"گوێ لە ئاوازی سازەکانتان ناگرم.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"لەبری ئەوە با دادپەروەری وەک زێ بڕوات و","poem":1},{"text":"ڕاستودروستیش وەک ڕووبارێکی هەمیشەیی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«ئەی بنەماڵەی ئیسرائیل، ئایا بۆ ماوەی چل ساڵ لە چۆڵەوانی","poem":1},{"text":"قوربانی سەربڕاو و پێشکەشکراوتان بۆ هێنام؟","poem":2}]},{"type":"verse","number":26,"content":[{"text":"بەڵکو نزرگەی پاشای خۆتان،","poem":1},{"text":"بنکەی بتەکانتان هەڵگرت،","poem":2},{"lineBreak":true},{"text":"پەیکەرەکانتان بۆ کەیوان","poem":2},{"noteId":5},{"text":"، ئەستێرەی خوداوەندەکەتان،","poem":2},{"lineBreak":true},{"text":"کە بۆ خۆتان دروستتان کرد.»","poem":2}]},{"type":"verse","number":27,"content":[{"text":"لەبەر ئەوە یەزدان کە ناوی خودای سوپاسالارە، دەفەرموێت:","poem":1},{"text":"«من بۆ شوێنێک ڕاپێچتان دەکەم کە لە دیمەشق دوورترە.»","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"نەبوو: عیبری ئاڤن‏، واتا بێت‌ئاڤن، کە ناوێکی سووکە بۆ بێت‌ئێل.‏","reference":{"chapter":5,"verse":5}},{"noteId":3,"caller":"+","text":"ڕۆژی سزادانی گوناهباران و ڕزگارکردنی گەلی خودا.‏","reference":{"chapter":5,"verse":18}},{"noteId":4,"caller":"+","text":"قوربانی هاوبەشی: ئەم قوربانییە هاودەمی قوربانی سووتاندن بوو. تەنها یەک کەس هەڵدەستا بە دابینکردنی ئەم قوربانییە، بەڵام لەگەڵ خەڵکی دیکە بەشی زۆری ئەم قوربانییەیان لەبەردەم خودا دەخوارد وەک هێمایەک بۆ پێکەوە ژیان. بڕوانە لێڤییەکان 7‏:11‏-15.‏‏","reference":{"chapter":5,"verse":22}},{"noteId":5,"caller":"+","text":"کەیوان ناوی هەسارەیەکە و خوداوەندی ئاشورییەکان بووە.‏","reference":{"chapter":5,"verse":26}}]},"thisChapterLink":"/api/ckb_bib/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}