t":"تاکو گەنم بخەینە بازاڕەوە؟»","poem":2},{"text":"بۆ ئەوەی پێوانە کەم بکەنەوە و","poem":1},{"text":"نرخ زیاد بکەن و","poem":2},{"lineBreak":true},{"text":"فێڵ لە تەرازوو بکەن،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بۆ ئەوەی هەژاران بە زیو بکڕن و","poem":1},{"text":"نەداران بە جووتێک پێڵاو و","poem":2},{"lineBreak":true},{"text":"بن بێژنگی گەنم بفرۆشن.","poem":2}]},{"type":"verse","number":7,"content":["یەزدان سوێندی بە شانازی یاقوب خوارد: «هەتاهەتایە کردەوەکانیان لەیاد ناکەم."]},{"type":"verse","number":8,"content":[{"text":"«ئایا لەبەر ئەمە زەوی نالەرزێت و","poem":1},{"text":"هەموو دانیشتووانەکەی شیوەن ناگێڕن؟","poem":2},{"text":"هەموو خاکەکە وەک ڕووباری نیل هەڵدەکشێت،","poem":1},{"text":"وەک ڕووباری میسر هەڵدەکشێت و دادەکشێتەوە.»","poem":2}]},{"type":"verse","number":9,"content":["یەزدانی باڵادەست دەفەرموێت:",{"text":"«جا لە نیوەڕۆی ئەو ڕۆژەدا خۆر ئاوا دەکەم و","poem":1},{"text":"لە ڕۆژی ڕووناکدا زەوی تاریک دەکەم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"جەژنەکانتان دەگۆڕم بە شیوەن و","poem":1},{"text":"هەموو گۆرانییەکانتان بە لاوانەوە.","poem":2},{"text":"جلوبەرگی گوش","poem":1},{"noteId":7},{"text":"دەکەمە بەر هەمووتان و","poem":1},{"text":"قژ بەسەرتانەوە ناهێڵم.","poem":2},{"text":"دەیکەم بە شیوەنی تاقانە و","poem":1},{"text":"کۆتاییەکەشی وەک ڕۆژێکی تاڵ.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"یەزدانی باڵادەست دەفەرموێت: «سەردەمێک دێت،","poem":1},{"text":"قاتوقڕی دەنێرمە سەر خاکەکە،","poem":2},{"text":"نەک قاتوقڕی بۆ نان و تینووێتی بۆ ئاو،","poem":1},{"text":"بەڵکو بۆ گوێگرتن لە وشەکانی یەزدان.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"جا لە دەریایەکەوە بۆ دەریایەک و","poem":1},{"text":"لە باکوورەوە بۆ ڕۆژهەڵات وێڵ دەبن،","poem":2},{"text":"بەدوای پەیامی یەزداندا دەگەڕێن،","poem":1},{"text":"بەڵام نایدۆزنەوە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لەو ڕۆژەدا پاکیزە جوانەکان و کوڕە لاوەکان","poem":1},{"text":"لە تینووێتیدا دەبوورێنەوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەوانەی سوێند بە تاوانی سامیرە دەخۆن و","poem":1},{"text":"دەڵێن: ”ئەی دان، سوێند بە خوداوەندەکەت کە زیندووە…“ و","poem":2},{"lineBreak":true},{"text":"”سوێند بە خوداوەندی بیری شابەع کە زیندووە…“","poem":2},{"text":"جا دەکەون و","poem":1},{"text":"ئیتر هەڵناستنەوە.»","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"لە کاتی ماتەمگێڕان و تۆبەکردندا جلوبەرگی لە گوش دروستکراویان لەبەرکردووە کە ئەزیەتی پێستیانی داوە.‏","reference":{"chapter":8,"verse":10}}]},"thisChapterLink":"/api/ckb_bib/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}