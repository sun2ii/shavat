{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"AMO","translationId":"ckb_bib","name":"ئامۆس","commonName":"ئامۆس","title":"ئامۆس","order":30,"numberOfChapters":9,"sha256":"8062ae3f9324ffc2e080b89aba02e3222ff76237776891c4d165edeb2e744d75","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/ckb_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["ڕووخاندنی ئیسرائیل"]},{"type":"verse","number":1,"content":["پەروەردگارم بینی لەلای قوربانگاکەوە ڕاوەستابوو و فەرمووی:",{"text":"«لە سەری کۆڵەکەکان بدە","poem":1},{"text":"هەتا بەردەرگاکان بلەرنەوە،","poem":2},{"text":"بیانشکێنە بەسەر سەری هەموویاندا و","poem":1},{"text":"ئەوانەی لێیان ماونەتەوە بە شمشێر دەیانکوژم.","poem":2},{"text":"کەسیان لێ هەڵنایەت و","poem":1},{"text":"کەسیشیان لێ دەرباز نابێت.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەگەر بەرەو جیهانی مردووان هەڵبکۆڵن،","poem":1},{"text":"لەوێوە دەستم دەیانگرێت؛","poem":2},{"text":"ئەگەر بۆ ئاسمانیش سەربکەون،","poem":1},{"text":"لەوێوە دایاندەگرمە خوارەوە؛","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئەگەر لە لووتکەی کارمەل خۆیان بشارنەوە،","poem":1},{"text":"لەوێ بە شوێنیاندا دەگەڕێم و دەیانگرم؛","poem":2},{"text":"ئەگەر لە بنی دەریا خۆیان لەبەرچاوم بشارنەوە،","poem":1},{"text":"لەوێ فەرمان بە مار دەدەم و پێیانەوە دەدات.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەگەر لەپێش دوژمنەکانیانەوە ڕاپێچ کران،","poem":1},{"text":"لەوێ فەرمان بە شمشێر دەدەم و دەیانکوژێت.","poem":2},{"lineBreak":true},{"text":"«چاوەکانم دەبڕمە سەریان","poem":1},{"text":"بۆ خراپە نەک بۆ چاکە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"یەزدانیش، پەروەردگاری سوپاسالار،","poem":1},{"text":"ئەوەی دەست لە زەوی دەدات، زەوی دەتوێتەوە و","poem":2},{"lineBreak":true},{"text":"هەموو دانیشتووانەکەی شیوەن دەگێڕن،","poem":2},{"text":"هەموو خاکەکە وەک ڕووباری نیل هەڵدەکشێت،","poem":1},{"text":"وەک ڕووباری میسر دادەکشێت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەوەی لە ئاسمان کۆشکی خۆی بنیاد دەنێت و","poem":1},{"text":"لە زەویش بناغەی خۆی دادەمەزرێنێت،","poem":2},{"text":"ئەوەی بانگی ئاوی دەریا دەکات و","poem":1},{"text":"بەسەر ڕووی زەویدا دەیڕژێنێت،","poem":2},{"lineBreak":true},{"text":"ناوی یەزدانە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ئەی نەوەی ئیسرائیل،","poem":1},{"text":"ئایا ئێوە بۆ من وەک نەوەی کوشییەکان","poem":2},{"noteId":8},{"text":"نین؟»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4},{"text":"«ئایا ئیسرائیلم لە خاکی میسرەوە نەهێنایە دەرەوە و","poem":1},{"text":"فەلەستییەکان لە کریتەوە و","poem":2},{"lineBreak":true},{"text":"ئارامییەکان لە قییرەوە؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«بە دڵنیاییەوە چاوەکانی یەزدانی باڵادەست","poem":1},{"text":"لەسەر پاشایەتییە گوناهبارەکەن.","poem":2},{"text":"لەناوی دەبەم لەسەر ڕووی زەوی،","poem":1},{"text":"بەڵام بنەماڵەی یاقوب بە تەواوی لەناو نابەم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"«من فەرمان دەدەم و","poem":1},{"text":"لەنێو هەموو نەتەوەکان بنەماڵەی ئیسرائیل لە بێژنگ دەدەم،","poem":2},{"text":"وەک چۆن بە بێژنگ لە بێژنگ دەدرێت","poem":1},{"text":"بێ ئەوەی دەنکێک بکەوێتە سەر زەوی.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"هەموو گوناهبارانی گەلەکەم","poem":1},{"text":"بە شمشێر دەکوژرێن،","poem":2},{"text":"هەموو ئەوانەی دەڵێن:","poem":1},{"text":"”بەڵا نزیک نابێتەوە و نایەتە ناومان.“","poem":2}]},{"type":"heading","content":["بنیادنانەوەی ئیسرائیل"]},{"type":"verse","number":11,"content":[{"text":"«لەو ڕۆژەدا چادرە ڕووخاوەکەی داود","poem":1},{"text":"هەڵدەدەمەوە.","poem":2},{"text":"شوورابەندە شکێنراوەکانی بنیاد دەنێمەوە،","poem":1},{"text":"ڕووخاوییەکانی دروستدەکەمەوە،","poem":2},{"lineBreak":true},{"text":"وەک ڕۆژانی ڕابردوو بنیادی دەنێمەوە،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"تاکو ئەوەی دەبنە خاوەنی پاشماوەی نەتەوەی ئەدۆم و","poem":1},{"text":"هەموو ئەو نەتەوانەی ناوی منیان هەڵگرتووە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە، ئەوەی ئەم کردارانە ئەنجام دەدات.","poem":4}]},{"type":"verse","number":13,"content":["یەزدان دەفەرموێت:",{"text":"«سەردەمێک دێت جوتیار بە سەپان دەگاتەوە و","poem":1},{"text":"شێلەری ترێش بە چێنەری تۆو.","poem":2},{"text":"چیاکان خۆشاوی ترێیان لێ دەتکێت و","poem":1},{"text":"هەموو گردەکانیش لێیان دەچۆڕێتەوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ڕاپێچکراوانی ئیسرائیلی گەلەکەم دەگەڕێنمەوە.","poem":1},{"lineBreak":true},{"text":"«شارە کاولکراوەکان بنیاد دەنێنەوە و تێیدا نیشتەجێ دەبن.","poem":1},{"text":"ڕەزەمێو دەچێنن و شەرابەکەی دەخۆنەوە،","poem":2},{"lineBreak":true},{"text":"باخ دەچێنن و لە بەرەکەی دەخۆن.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"لە خاکەکەیاندا دەیانچێنم،","poem":1},{"text":"هەرگیز لەو خاکەی کە پێم داون هەڵناکەنرێن.»","poem":2},{"text":"یەزدانی پەروەردگارت دەفەرموێت.","poem":4}]}],"footnotes":[{"noteId":8,"caller":"+","text":"کووش وڵاتێک بووە لە سەرووی ڕووباری نیل.‏","reference":{"chapter":9,"verse":7}}]},"thisChapterLink":"/api/ckb_bib/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}