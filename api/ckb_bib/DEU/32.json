"noteId":71},{"text":"و شیری مەڕوماڵات،","poem":1},{"text":"لەگەڵ دوگی","poem":2},{"noteId":72},{"text":"بەرخ و","poem":2},{"text":"بەرانی باشان و تەگە","poem":1},{"noteId":73},{"text":"،","poem":1},{"text":"لەگەڵ چەوری ناوکی گەنم.","poem":2},{"text":"تۆ لە خوێنی ترێ شەرابت خواردەوە.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"یەشوروون","poem":1},{"noteId":74},{"text":"قەڵەو بوون و جووتەیان وەشاند،","poem":1},{"text":"قەڵەو بوون و پڕ بوون و بە پیو","poem":2},{"noteId":75},{"text":"داپۆشران.","poem":2},{"text":"ئیتر پشتیان کردە ئەو خودایەی کە دروستی کردبوون،","poem":1},{"text":"تاشەبەردی ڕزگارییەکەیان ڕەتکردەوە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئیرەییان","poem":1},{"noteId":76},{"text":"وروژاند بە پەرستنی خودا بێگانەکانیان و","poem":1},{"text":"بە بتە قێزەونەکان پەستیان کرد.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"بۆ بتەکان","poem":1},{"noteId":77},{"text":"کە خودا نین قوربانییان سەربڕی،","poem":1},{"text":"چەند خودایەک نەیانناسیون،","poem":2},{"lineBreak":true},{"text":"تازەن و بەم زووانە دەرکەوتوون،","poem":2},{"lineBreak":true},{"text":"کە باوکانتان لێیان نەترساون.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئەو تاشەبەردەی ئێوەی بوو وازتان لێ هێنا،","poem":1},{"text":"ئەو خودایەی لەدایکبوونی پێداین لەبیرتان کرد.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"جا یەزدان بینی و ڕەتی کردنەوە،","poem":1},{"text":"لەبەر ئەوە تووڕە بوو بەهۆی کچەکانی و کوڕەکانی.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"فەرمووی، «ڕووی خۆم لێیان دەشارمەوە،","poem":1},{"text":"سەیر دەکەم کۆتاییان چی دەبێت،","poem":2},{"text":"ئەوانە نەوەیەکی هەڵگەڕاوەن،","poem":1},{"text":"ئەو کوڕانە دەستپاکیان تێدا نییە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئەوان بەوانەی خودا نین ئیرەییان وروژاندم،","poem":1},{"text":"بە بتە پووچەکانیان پەستیان کردم،","poem":2},{"text":"منیش وایان لێدەکەم ئیرەیی بەوانە ببەن کە گەل نین،","poem":1},{"text":"بە نەتەوەیەکی گێل پەستیان دەکەم.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بە تووڕەییم ئاگرێک داگیرساوە،","poem":1},{"text":"گڕ دەگرێت هەتا جیهانی مردووانی ژێرەوە،","poem":2},{"text":"زەوی و خەرمانەکەی دەخوات،","poem":1},{"text":"بناغەکانی چیاکان دەسووتێنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«کارەساتیان بەسەردا کۆدەکەمەوە،","poem":1},{"text":"تیرەکانم لەواندا دەچەقێنم.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"کاتێک لە برسان کەوتوون،","poem":1},{"text":"پەکیان کەوتووە لەبەر تا و پەتای فەوتێنەر،","poem":2},{"text":"ددانی دڕندە دەنێرمە سەریان،","poem":1},{"text":"لەگەڵ ژەهری مارە خشۆکەکان.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"لە دەرەوە شمشێر جەرگیان دەسووتێنێت و","poem":1},{"text":"لەناو ماڵەوەشیان تۆقین،","poem":2},{"text":"کوڕی گەنج و پاکیزە لەناودەچن،","poem":1},{"text":"منداڵی شیرەخۆر لەگەڵ پیاوی پیر.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"فەرمووم: ”پەرتەوازەیان دەکەم،","poem":1},{"text":"یادیان لەنێو خەڵکی دەسڕمەوە.“","poem":2}]},{"type":"verse","number":27,"content":[{"text":"بەڵام لەوە ترسام کە دوژمن پەستم بکات،","poem":1},{"text":"کە لەوانەیە دوژمنانیان تێنەگەن،","poem":2},{"text":"نەوەک بڵێن: ”خۆمان باڵادەست بووین،","poem":1},{"text":"یەزدان هەموو ئەمانەی نەکردووە.“»","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ئەوان نەتەوەیەکن ڕاوێژ لێ بڕاون،","poem":1},{"text":"کوا تێگەیشتنیش لەناویان؟","poem":2}]},{"type":"verse","number":29,"content":[{"text":"خۆزگە دانا دەبوون و لەمە تێدەگەیشتن و","poem":1},{"text":"کۆتاییەکەیان لەبەرچاو دەگرت.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"چۆن یەکێک هەزار ڕاو دەنێت و","poem":1},{"text":"دووان دە هەزار تێکدەشکێنن،","poem":2},{"text":"ئەگەر تاشەبەردەکەیان","poem":1},{"noteId":78},{"text":"ئەوانی نەفرۆشتبێت","poem":1},{"noteId":79},{"text":"،","poem":1},{"text":"یەزدان بەدەستەوەی نەدابن.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"لەبەر ئەوەی تاشەبەردیان وەک تاشەبەردی ئێمە","poem":1},{"noteId":80},{"text":"نییە،","poem":1},{"text":"تەنانەت دوژمنانیشمان دانی پێدا دەنێن.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"مێویان لە مێوی سەدۆمە و","poem":1},{"lineBreak":true},{"text":"ترێیان هی باخەکانی عەمۆرایە،","poem":1},{"text":"ترێیەکەیان ژەهرە و هێشووەکانیان تاڵن.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"شەرابەکەیان ژەهری مارەکان و","poem":1},{"text":"تاڵاوی ماری کۆبرا کوشندەکانە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«ئایا ئەمە لەلای من هەڵنەگیراوە،","poem":1},{"text":"لەناو گەنجینەکانم مۆری لێ نەدراوە؟","poem":2}]},{"type":"verse","number":35,"content":[{"text":"تۆڵەسەندنەوە هی منە، منم سزا دەدەم،","poem":1},{"text":"لە کاتێکدا پێیان دەخلیسکێت،","poem":2},{"text":"چونکە ڕۆژی بەڵایان نزیک بووەتەوە و","poem":1},{"text":"چارەنووسیان بۆیان خێرایە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"یەزدان ئەستۆپاکی گەلەکەی دەسەلمێنێت و","poem":1},{"text":"لەگەڵ خزمەتکارەکانی میهرەبان دەبێت،","poem":2},{"text":"کە دەبینێت هێزیان بەسەرچووە و","poem":1},{"text":"نە کۆیلە و نە ئازاد کەس نەماوە.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"خودا دەفەرموێت: «کوا خوداوەندەکانیان،","poem":1},{"text":"ئەو تاشەبەردەی پەنایان بۆ برد،","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ئەو خوداوەندانەی کە پیوی قوربانییەکانیان دەخواردن،","poem":1},{"text":"شەرابی خواردنەوە پێشکەشکراوەکانیان دەخواردنەوە؟","poem":2},{"text":"با بێن و یارمەتیتان بدەن،","poem":1},{"text":"با پارێزگاریتان لێ بکەن!","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"«ئێستا ببینن، من، من ئەوم،","poem":1},{"text":"هیچ خودایەکی دیکە نییە لە پاڵم.","poem":2},{"text":"من دەمرێنم و دەژیێنم،","poem":1},{"text":"بریندار دەکەم و من چاک دەکەمەوە،","poem":2},{"lineBreak":true},{"text":"کەس نییە کەسێک لە دەستی من دەرباز بکات.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"من دەستم بۆ ئاسمان بەرز دەکەمەوە و سوێند دەخۆم:","poem":1},{"text":"بە دڵنیاییەوە هەتاهەتایە من زیندووم،","poem":2}]},{"type":"verse","number":41,"content":[{"text":"کاتێک شمشێرە درەوشاوەکەم تیژ بکەمەوە و","poem":1},{"text":"بۆ دادوەریکردن بە دەستەوەی بگرم،","poem":2},{"text":"تۆڵە لە دوژمنانم دەکەمەوە و","poem":1},{"text":"ناحەزانم سزا دەدەم.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"تیرەکانم بە خوێن مەست دەکەم و","poem":1},{"text":"شمشێرەکەم گۆشت دەخوات،","poem":2},{"text":"لە خوێنی کوژراوان و بەدیلگیراوان،","poem":1},{"text":"لە کەللەسەری ڕابەرانی دوژمن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"ئەی نەتەوەکان، لەگەڵ گەلی خودا دڵخۆش بن،","poem":1},{"text":"چونکە تۆڵەی خوێنی خزمەتکارانی دەکاتەوە،","poem":2},{"text":"لە دوژمنانی تۆڵە دەکاتەوە،","poem":1},{"text":"کەفارەتی خاک و گەلەکەی خۆی دەکات.","poem":2}]},{"type":"verse","number":44,"content":["جا موسا خۆی و یەشوعی کوڕی نون هاتن و هەموو وشەکانی ئەم سروودەیان بۆ گەل خوێندەوە."]},{"type":"verse","number":45,"content":["کاتێک موسا لە وتارەکە تەواو بوو، بە هەموو ئەم وشانە بۆ هەموو ئیسرائیل،"]},{"type":"verse","number":46,"content":["پێی گوتن: «لە دڵەوە لە هەموو ئەو وشانە وردببنەوە کە من ئەمڕۆ شایەتی پێدەدەم لەسەرتان، هەتا فەرمان بە منداڵەکانتان بکەن کە ئاگاداربن کار بە هەموو وشەکانی ئەم فێرکردنە بکەن."]},{"type":"verse","number":47,"content":["تەنها وشەی بێ نرخ نییە بۆتان، بەڵکو ژیانتانە، بەهۆی ئەمانەوە تەمەن درێژ دەبن لەسەر ئەو خاکەی لە ڕووباری ئوردون بۆی دەپەڕنەوە هەتا دەستی بەسەردا بگرن.»"]},{"type":"heading","content":["موسا لەسەر چیای نیبۆ دەمرێت"]},{"type":"verse","number":48,"content":["یەزدانیش لە هەمان ڕۆژدا بە موسای فەرموو:"]},{"type":"verse","number":49,"content":["«سەربکەوە بۆ سەر زنجیرە چیای عەڤاریم، بۆ چیای نیبۆ کە لە خاکی مۆئابە و بەرامبەر بە ئەریحایە و لەوێوە تەماشای خاکی کەنعان بکە کە من وەک موڵک بە نەوەی ئیسرائیلی دەدەم."]},{"type":"verse","number":50,"content":["لەو کێوەدا کە بۆی سەردەکەویت دەمریت و دەچیتە پاڵ گەلەکەتەوە، وەک چۆن هارونی برات لە کێوی هۆردا مرد و چووە پاڵ گەلەکەی،"]},{"type":"verse","number":51,"content":["لەبەر ئەوەی ئێوە ناپاک بوون لەگەڵم لەنێو نەوەی ئیسرائیلدا لەلای مێرگی مەریبای قادێش لە چۆڵەوانی چن، چونکە پیرۆزی منتان لەنێو نەوەی ئیسرائیلدا ڕانەگرت."]},{"type":"verse","number":52,"content":["لەبەر ئەوە تۆ ناچیتە ناو ئەو خاکەی کە بە گەلی ئیسرائیلی دەدەم، بەڵکو تەنها لە دوورەوە دەیبینیت.»"]}],"footnotes":[{"noteId":71,"caller":"+","text":"یان دەرەمە، قۆناغی پێش دروستبوونی پەنیر.‏","reference":{"chapter":32,"verse":14}},{"noteId":72,"caller":"+","text":"دوگ یان دونگ.‏","reference":{"chapter":32,"verse":14}},{"noteId":73,"caller":"+","text":"نێری، سابرێن.‏","reference":{"chapter":32,"verse":14}},{"noteId":74,"caller":"+","text":"یەشوروون بە واتای سەرڕاست یان دادپەروەر دێت، وەکو نازناوێک بۆ گەلی ئیسرائیل بەکارهاتووە.‏","reference":{"chapter":32,"verse":15}},{"noteId":75,"caller":"+","text":"پیو: واتا بەز، لێرە و لە ئایەتی 38.‏","reference":{"chapter":32,"verse":15}},{"noteId":76,"caller":"+","text":"ئیرەیی: واتای هەڵوێستی توندی خودا بەرامبەر بە بتپەرستی، چونکە خودا دەیەوێت تەنها ئەو بپەرسترێت.‏","reference":{"chapter":32,"verse":16}},{"noteId":77,"caller":"+","text":"بتەکان: بە واتای ڕۆحە پیسەکان.‏","reference":{"chapter":32,"verse":17}},{"noteId":78,"caller":"+","text":"تاشەبەردەکەیان: ڕەوانبێژی لێکچواندنە، مەبەستی یەزدانە. بڕوانە ئایەتی 4.‏","reference":{"chapter":32,"verse":30}},{"noteId":79,"caller":"+","text":"نەفرۆشتبێت: مەبەستی سزادانیانە لەبەر شکاندنی پەیمانەکەیان. بڕوانە ئایەتەکانی 18 و 19.‏","reference":{"chapter":32,"verse":30}},{"noteId":80,"caller":"+","text":"تاشەبەردی ئێمە: مەبەستی لە یەزدانە.‏","reference":{"chapter":32,"verse":31}}]},"thisChapterLink":"/api/ckb_bib/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}