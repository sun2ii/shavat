{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"DEU","translationId":"ckb_bib","name":"دواوتاری موسا","commonName":"دواوتاری موسا","title":"دواوتار پێنجەم پەڕتووکی موسا","order":5,"numberOfChapters":34,"sha256":"c2be4653e448c1a0e17152b6bbd8b2bebe957b9a73cc9638005b11f2bc6cfd19","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/ckb_bib/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["موسا داوای بەرەکەت دەکات بۆ هۆزەکان"]},{"type":"verse","number":1,"content":["ئەوەش ئەو بەرەکەتەیە کە موسای پیاوی خودا بۆ نەوەی ئیسرائیل",{"noteId":81},"داوای کرد، بەر لە مردنی،"]},{"type":"verse","number":2,"content":["گوتی:",{"text":"«یەزدان لە سیناوە هات و","poem":1},{"text":"لە سێعیرەوە بەسەریاندا هەڵهات،","poem":2},{"lineBreak":true},{"text":"لە کێوی پارانەوە درەوشایەوە و","poem":2},{"text":"هەزاران هەزار فریشتەی پیرۆزی لەگەڵ بوو،","poem":1},{"text":"لە بنارەکانی باشوورەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بێگومان ئەوە تۆی کە هەموو گەلانت خۆشدەوێت،","poem":1},{"text":"هەموو پیرۆزەکان لەنێو دەستی تۆدان،","poem":2},{"text":"ئەوان لەلای پێت کڕنۆش دەبەن،","poem":1},{"text":"ڕێنمایی لە تۆ وەردەگرن.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"موسا فەرمانی فێرکردنی پێداین،","poem":1},{"text":"میراتە بۆ کۆمەڵی یاقوب.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لەنێو یەشوروون","poem":1},{"noteId":82},{"text":"بوو بە پاشا،","poem":1},{"text":"بە کۆبوونەوەی ڕابەرەکانی گەل،","poem":2},{"lineBreak":true},{"text":"هۆزەکانی ئیسرائیل پێکەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«با نەوەی ڕەئوبێن بژیێت و نەمرێت،","poem":1},{"text":"با پیاوەکانی کەم نەبن.»","poem":2}]},{"type":"verse","number":7,"content":["سەبارەت بە نەوەی یەهودا ئەمەی گوت:",{"text":"«ئەی یەزدان، گوێ لە دەنگی یەهودا بگرە و","poem":1},{"text":"بۆ لای گەلەکەی بیهێنە،","poem":2},{"text":"دەستەکانی بەسە بۆی،","poem":1},{"text":"ببە بە یارمەتیدەر لە دژی دوژمنانی!»","poem":2}]},{"type":"verse","number":8,"content":["سەبارەت بە نەوەی لێڤی گوتی:",{"text":"«تومیم و ئوریمی","poem":1},{"noteId":83},{"text":"تۆ","poem":1},{"text":"بۆ پیاوە خۆشەویستەکەتە،","poem":2},{"text":"ئەوەی لە مەسا تاقیت کردەوە و","poem":1},{"text":"لە مێرگی مەریبا خەباتت لەگەڵدا کرد.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەوەی","poem":1},{"noteId":84},{"text":"سەبارەت بە دایک و باوکی گوتی،","poem":1},{"text":"”ڕەچاوم نەکردوون،“","poem":2},{"text":"دانی بە براکانیشیدا نەنا و","poem":1},{"text":"منداڵەکانیشی نەناسی،","poem":2},{"text":"بەڵام چاودێری فەرمایشتەکانی تۆی کرد و","poem":1},{"text":"پەیمانەکەی تۆی پاراست.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"نەوەی یاقوب، فێری ڕاسپاردەکانت و","poem":1},{"text":"نەوەی ئیسرائیلیش فێری تەوراتی تۆ دەکات،","poem":2},{"text":"بۆنی بخوور دەخاتە بەردەمت و","poem":1},{"text":"قوربانی سووتاندنی تەواو دەخاتە سەر قوربانگاکەت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەی یەزدان، توانای شارەزایی بەرەکەتدار بکە و","poem":1},{"text":"بە کرداری دەستی ڕازی بە،","poem":2},{"text":"لە کەمەری بەرهەڵستکاران و ناحەزانی بدە،","poem":1},{"text":"هەتا هەڵنەستنەوە.»","poem":2}]},{"type":"verse","number":12,"content":["سەبارەت بە نەوەی بنیامین گوتی:",{"text":"«ئەو خۆشەویستی یەزدانە، بە ئاسوودەیی لەلای نیشتەجێ دەبێت،","poem":1},{"text":"بە درێژایی ڕۆژ داڵدەی دەدات و","poem":2},{"lineBreak":true},{"text":"یەزدان لەنێو هەردوو شانیدا نیشتەجێی دەکات.»","poem":2}]},{"type":"verse","number":13,"content":["سەبارەت بە نەوەی یوسف گوتی:",{"text":"«با خاکەکەی لەلایەن یەزدانەوە بەرەکەتدار بێت","poem":1},{"text":"بە شەونمی گرانبەهای ئاسمان،","poem":2},{"lineBreak":true},{"text":"بە ئاوە قەتیسکراوەکانی خوارەوە،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"بە بەهادارترین دیارییەکانی خۆر و","poem":1},{"text":"بەهادارترین دیارییەکانی بەروبوومی مانگ،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بە بەهادارترین دیارییەکانی چیا دێرینەکان،","poem":1},{"text":"بە بەسوودترین گردە هەتاهەتاییەکان،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بە بەهادارترین دیارییەکانی زەوی و پڕییەکەی،","poem":1},{"text":"لەگەڵ ڕەزامەندی نیشتەجێی ناو دەوەنەکە","poem":2},{"noteId":85},{"text":"،","poem":2},{"text":"با بەسەر سەری یوسفەوە بن،","poem":1},{"text":"بەسەر تەپڵی سەری لە براکانی جیا کرایەوە.","poem":2},{"noteId":86}]},{"type":"verse","number":17,"content":[{"text":"نۆبەرەی گایەکەی شکۆمەندییە بۆی،","poem":1},{"text":"قۆچەکانی قۆچی گای کێوین،","poem":2},{"text":"بەوان قۆچ لە گەلان دەدات،","poem":1},{"text":"پێکەوە هەتا ئەوپەڕی زەوی،","poem":2},{"text":"ئەوان هەزاران هەزاری ئەفرایم و","poem":1},{"text":"هەزارانی مەنەشەن.»","poem":2}]},{"type":"verse","number":18,"content":["سەبارەت بە نەوەی زەبولون گوتی:",{"text":"«ئەی زەبولون بە کۆچکردنت دڵخۆش بە و","poem":1},{"text":"تۆش ئەی یەساخار بە چادرەکانت،","poem":2}]},{"type":"verse","number":19,"content":[{"text":"گەلان بۆ چیا بانگ دەکەن،","poem":1},{"text":"لەوێ قوربانی ڕاستودروستی سەردەبڕن،","poem":2},{"text":"هەتا لە پڕی دەریا بمژن و","poem":1},{"text":"لەو گەنجینەیەی لەژێر لم شاردراوەتەوە.»","poem":2}]},{"type":"verse","number":20,"content":["سەبارەت بە نەوەی گاد گوتی:",{"text":"«بەرەکەتدارە ئەوەی سنووری خاکی گادی فراوان کرد!","poem":1},{"text":"وەک شێرە مێ نیشتەجێ بوو،","poem":2},{"lineBreak":true},{"text":"قۆڵی پارچەپارچە کرد لەگەڵ تەپڵی سەر،","poem":2}]},{"type":"verse","number":21,"content":[{"text":"باشترین خاکی بۆ خۆی دانا،","poem":1},{"text":"بەشی فەرماندەی بۆ خۆی هەڵگرت،","poem":2},{"text":"کاتێک سەرکردەکانی گەل کۆبوونەوە،","poem":1},{"text":"دادوەری یەزدانی جێبەجێ کرد و","poem":2},{"lineBreak":true},{"text":"حوکمەکانیشی سەبارەت بە ئیسرائیل.»","poem":2}]},{"type":"verse","number":22,"content":["سەبارەت بە نەوەی دان گوتی:",{"text":"«دان بەچکە شێرە،","poem":1},{"text":"لە باشان قەڵەمباز بەرەو پێش دەدات.»","poem":2}]},{"type":"verse","number":23,"content":["سەبارەت بە نەوەی نەفتالی گوتی:",{"text":"«ئەی نەفتالی، تێر بە لە ڕەزامەندی و","poem":1},{"text":"پڕ بە لە بەرەکەتی یەزدان،","poem":2},{"lineBreak":true},{"text":"دەست بەسەر ڕۆژئاوا و باشووری خاکەکەتدا بگرە.»","poem":2}]},{"type":"verse","number":24,"content":["سەبارەت بە نەوەی ئاشێر گوتی:",{"text":"«با ئاشێر لەنێو کوڕان بەرەکەتدار بێت،","poem":1},{"text":"با لەلای براکانی پەسەند بێت،","poem":2},{"lineBreak":true},{"text":"با پێی بکاتە ناو زەیت،","poem":2}]},{"type":"verse","number":25,"content":[{"text":"دەروازەکانت لە ئاسن و بڕۆنزن،","poem":1},{"text":"بەگوێرەی درێژی تەمەنت هێزت پێ دەبەخشێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«خودای یەشوروون هاوتای نییە،","poem":1},{"text":"سواری ئاسمان دەبێت بۆ یارمەتیدانت،","poem":2},{"lineBreak":true},{"text":"هەروەها هەورەکان لە شکۆی خۆیدا.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"خودای هەتاهەتایی پەناگاتە و","poem":1},{"text":"باڵە هەمیشەییەکانیشی لە ژێرەوە.","poem":2},{"text":"دوژمنی لەبەردەمت دەرکرد و","poem":1},{"text":"فەرمووی: ”لەناو ببە!“","poem":2}]},{"type":"verse","number":28,"content":[{"text":"جا ئیسرائیل بە تەنها و بە ئاسوودەیی نیشتەجێ دەبێت،","poem":1},{"text":"جێنشینی یاقوب گیروگرفتی نابێت،","poem":2},{"text":"لە خاکی دانەوێڵە و شەرابی نوێ دەبێت،","poem":1},{"text":"ئاسمانەکەشی شەونم دەتکێنێت.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ئەی ئیسرائیل، خۆزگەت پێ دەخوازرێت،","poem":1},{"text":"کێ وەک تۆیە،","poem":2},{"lineBreak":true},{"text":"گەلێکی ڕزگار بوو لەلایەن یەزدانەوە؟","poem":2},{"text":"قەڵغانی یارمەتی و","poem":1},{"text":"شمشێری شکۆمەندیتە،","poem":2},{"text":"جا دوژمنانت ملکەچیت بۆ دەنوێنن،","poem":1},{"text":"تۆش نزرگەکانی سەر بەرزاییان","poem":2},{"noteId":87},{"text":"پێشێل دەکەیت.»","poem":2}]}],"footnotes":[{"noteId":81,"caller":"+","text":"نەوەی ئیسرائیلی: لێرەدا موسا بە ناوی وەچەکانی یاقوبەوە داوای بەرەکەت بۆ نەوەکانی ئەم هۆزانە دەکات، کە ئەم وەچانە نزیکەی 400 ساڵ لەمەوپێش لە خاکی میسردا مردبوون. بڕوانە پەیدابوون 15‏:13 و دەرچوون 1‏:1‏-7 و کردار 7‏:6.‏‏","reference":{"chapter":33,"verse":1}},{"noteId":82,"caller":"+","text":"ناوی (یەشوروون) واتا (ئەو کەسەی کە سەرڕاستە)، لێرە مەبەست لە نەوەی ئیسرائیلە.‏","reference":{"chapter":33,"verse":5}},{"noteId":83,"caller":"+","text":"تومیم و ئوریم: دوو بەردی گرانبەها بوون، لە کاتی بڕیاردان بۆ زانینی خواستی خودا بەکارهێنراون، بڕوانە دەرچوون 28‏:30 و یەکەم ساموئێل 23‏:9‏-12.‏‏","reference":{"chapter":33,"verse":8}},{"noteId":84,"caller":"+","text":"مەبەست لە هۆزی لێڤییە.‏","reference":{"chapter":33,"verse":9}},{"noteId":85,"caller":"+","text":"مەبەستی لە دەرکەوتنی خودایە بۆ موسا لەناو دەوەنەکە، بڕوانە دەرچوون 3‏:1‏-6.‏‏","reference":{"chapter":33,"verse":16}},{"noteId":86,"caller":"+","text":"بڕوانە پەیدابوون 37‏:11‏-15؛ 44‏:14.‏‏","reference":{"chapter":33,"verse":16}},{"noteId":87,"caller":"+","text":"مەبەست لەو شوێنە بەرزانەیە کە بۆ قوربانیکردن و ڕێوڕەسمی پەرستنی بتەکان بووە، بڕوانە سەرژمێری 33‏:52‏‏.‏","reference":{"chapter":33,"verse":29}}]},"thisChapterLink":"/api/ckb_bib/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}