{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ECC","translationId":"ckb_bib","name":"ژیرمەندی","commonName":"ژیرمەندی","title":"ژیرمەندی","order":21,"numberOfChapters":12,"sha256":"82194ab098ed39d235fba5df347cc921052ee105cfa5a4759f6536515ac74a45","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/ckb_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["هەرچی هەیە بێ واتایە"]},{"type":"verse","number":1,"content":["وتەکانی وتاربێژی ژیرمەند، کوڕی داود، پاشا لە ئۆرشەلیم:"]},{"type":"verse","number":2,"content":[{"text":"وتاربێژی ژیرمەند دەڵێت:","poem":1},{"text":"«بێ واتایە! بێ واتایە!","poem":2},{"text":"بێ واتا، هەر بێ واتایە!","poem":1},{"text":"هەرچی هەیە بێ واتایە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"مرۆڤ لە هەموو ماندووبوونەکەی چی بۆ دەمێنێتەوە،","poem":1},{"text":"کە لەسەر زەوی","poem":2},{"noteId":0},{"text":"پێوەی ماندوو دەبێت؟","poem":2}]},{"type":"verse","number":4,"content":[{"text":"نەوەیەک دێت و نەوەیەک دەڕوات،","poem":1},{"text":"بەڵام زەوی هەتاهەتایە هەر هەیە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"خۆر هەڵدێت و خۆرئاوا دەبێت،","poem":1},{"text":"بە پەلەیە بۆ شوێنەکەی لەوێوە هەڵدێت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"با هەڵدەکات بەرەو باشوور و","poem":1},{"text":"دەسووڕێتەوە بەرەو باکوور،","poem":2},{"text":"دەسووڕێتەوە و دەسووڕێتەوە،","poem":1},{"text":"هەمیشە بۆ خولگەکەی خۆی دەگەڕێتەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"هەرچەندە هەموو ڕووبارەکان بەرەو دەریا دەچن،","poem":1},{"text":"بەڵام دەریا هەر پڕ نابێت.","poem":2},{"text":"ڕووبارەکان بۆ شوێنەکەی خۆیان دەچنەوە،","poem":1},{"text":"بۆ ئەوێ دەڕۆن و دەگەڕێنەوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"هەموو شتەکان ماندووکەرن،","poem":1},{"text":"مرۆڤ ناتوانێت دەریانببڕێت.","poem":2},{"text":"چاو لە سەیرکردن تێر نابێت و","poem":1},{"text":"گوێ لە بیستن پڕ نابێت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەوەی بووە هەر ئەو دەبێت،","poem":1},{"text":"ئەوەی کراوە هەر ئەو دەکرێت،","poem":2},{"lineBreak":true},{"text":"هیچی نوێ لەسەر زەوی نییە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"هیچ شتێک نییە کە بگوترێت:","poem":1},{"text":"«سەیر بکە، ئەمە نوێیە!»","poem":2},{"text":"لە دێرزەمانەوە هەر بووە،","poem":1},{"text":"لە سەردەمانی پێش ئێمەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"کەس یادی نەوەکانی پێشوو ناکاتەوە،","poem":1},{"text":"تەنانەت نەوەکانی داهاتووش","poem":2},{"text":"نایەنەوە یادی","poem":1},{"text":"ئەوانەی کە لەپاش ئەوان دێن.","poem":2}]},{"type":"heading","content":["دانایی بێ واتایە"]},{"type":"verse","number":12,"content":["من کە وتاربێژی ژیرمەندم، پاشای ئیسرائیل بووم لە ئۆرشەلیم."]},{"type":"verse","number":13,"content":["لە ڕێگای داناییەوە خۆمم تەرخان کرد بۆ فێربوون و لێکۆڵینەوە سەبارەت بە هەموو ئەو کارانەی کە لەسەر زەوی کراون. بارێکی گرانە کە خودا لەسەر شانی مرۆڤی داناوە!"]},{"type":"verse","number":14,"content":["ڕوانیمە هەموو کردارەکان کە لەسەر زەویدا کراون و ئەوەتا هەمووی بێ واتایە و گڤەی بایە."]},{"type":"verse","number":15,"content":[{"text":"خوار ناتوانرێت ڕاست بکرێتەوە و","poem":1},{"text":"ونبوو ناتوانرێت بژمێردرێت.","poem":2}]},{"type":"verse","number":16,"content":["لە دڵی خۆمدا گوتم: «ئەوەتا من مەزن بووم، داناییم زۆرتر بوو لە هەموو ئەوانەی پێش من لەسەر تەختی ئۆرشەلیم بوون و دڵم دانایی و زانینی زۆری بینی.»"]},{"type":"verse","number":17,"content":["ئینجا خۆمم تەرخان کرد بۆ تێگەیشتن لە دانایی، هەروەها شێتی و گێلی، ئەو کاتە بۆم دەرکەوت ئەمەش بە هەمان شێوە گڤەی بایە،"]},{"type":"verse","number":18,"content":[{"text":"چونکە لە زۆری دانایی، پەستی زۆر دەبێت و","poem":1},{"text":"ئەوەی زانینی زیاتر بێت خەمی زیاد دەبێت.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"لە عیبری نووسراوە لەژێر خۆردا، بەڵام مەبەست لەسەر زەوییە نەک لەبەر گەرمای هەتاو.‏","reference":{"chapter":1,"verse":3}}]},"thisChapterLink":"/api/ckb_bib/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}