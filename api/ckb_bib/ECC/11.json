{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ECC","translationId":"ckb_bib","name":"ژیرمەندی","commonName":"ژیرمەندی","title":"ژیرمەندی","order":21,"numberOfChapters":12,"sha256":"82194ab098ed39d235fba5df347cc921052ee105cfa5a4759f6536515ac74a45","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/ckb_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["نانی سەر ئاوەکان"]},{"type":"verse","number":1,"content":[{"text":"نان بدە بە دەم ئاوەوە،","poem":1},{"text":"چونکە لە پاشەڕۆژدا دێتەوە ڕێگای خۆت.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بەش بدە بە حەوت کەس، بەڵێ، بە هەشتیش،","poem":1},{"text":"چونکە نازانیت چ کارەساتێک لەسەر زەوی ڕوودەدات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ئەگەر هەور پڕبێت،","poem":1},{"text":"باران بەسەر زەویدا دەبارێنێت.","poem":2},{"text":"ئەگەر دارێک بەرەو باشوور بکەوێت یان بەرەو باکوور،","poem":1},{"text":"ئەو شوێنەی دارەکەی لێ دەکەوێت، لەوێ دەبێت.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەوەی چاوی لە با بێت ناچێنێت،","poem":1},{"text":"ئەوەی سەیری هەور بکات دروێنە ناکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"هەروەک نازانیت کامە ڕێگای بایە،","poem":1},{"text":"یان چۆن کۆرپەلە لەناو سکی دایکیدا شێوەی دەکێشرێت،","poem":2},{"text":"بە هەمان شێوە ناتوانیت لە کارەکانی خودا تێبگەیت،","poem":1},{"text":"کە هەمووان دروستدەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"سەر لە بەیانی تۆوی خۆت بچێنە،","poem":1},{"text":"سەر لە ئێوارەش دەستت شل مەکە،","poem":2},{"text":"چونکە نازانیت کامیان سەوز دەبێت،","poem":1},{"text":"ئەم یان ئەو،","poem":2},{"lineBreak":true},{"text":"یان بەرهەمی هەردووکیان وەک یەک باش دەبێت.","poem":2}]},{"type":"heading","content":["بەدیهێنەرت لە لاویێتیت لەبیر بێت"]},{"type":"verse","number":7,"content":[{"text":"ڕووناکی شیرینە و","poem":1},{"text":"باشە بۆ چاوان کە خۆر ببینێت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەگەر مرۆڤ تەمەنێکی درێژ ژیا،","poem":1},{"text":"با بە هەمووی دڵخۆش بێت.","poem":2},{"text":"بەڵام با ڕۆژانی تاریکی لەبیربێت،","poem":1},{"text":"چونکە زۆر دەبێت.","poem":2},{"lineBreak":true},{"text":"هەموو ئەوەی دێت بێ واتایە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەی لاو، لە سەردەمی گەنجیێتیت شادمان بە،","poem":1},{"text":"با لە ڕۆژانی لاویێتیت دڵت خۆش بێت.","poem":2},{"text":"بە ڕێگای دڵی خۆت و","poem":1},{"text":"بە بینینی چاوەکانتدا بڕۆ،","poem":2},{"text":"بەڵام بزانە کە لەسەر هەموو ئەمانە","poem":1},{"text":"خودا دەتهێنێت بۆ حوکم بەسەردادان.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"پەستی لە دڵت داماڵە و","poem":1},{"text":"خراپە لە لەشت دووربخەوە،","poem":2},{"lineBreak":true},{"text":"چونکە نەوجەوانی و گەنجیێتی بێ واتان.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}