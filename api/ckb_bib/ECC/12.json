{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ECC","translationId":"ckb_bib","name":"ژیرمەندی","commonName":"ژیرمەندی","title":"ژیرمەندی","order":21,"numberOfChapters":12,"sha256":"82194ab098ed39d235fba5df347cc921052ee105cfa5a4759f6536515ac74a45","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/ckb_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"بەدیهێنەری خۆت لەبیر بێت","poem":1},{"text":"لە سەردەمی گەنجیێتیت،","poem":2},{"text":"پێش ئەوەی ڕۆژگاری خراپە بێت","poem":1},{"text":"یان ئەو ساڵانە نزیک بێتەوە کە بڵێی:","poem":2},{"lineBreak":true},{"text":"«خۆشییان تێدا نابینم،»","poem":2}]},{"type":"verse","number":2,"content":[{"text":"پێش ئەوەی درەوشانەوەی خۆر و","poem":1},{"text":"ڕووناکی و مانگ و ئەستێرە تەواو بێت،","poem":2},{"lineBreak":true},{"text":"پێش ئەوەی گەڕانەوەی هەوری باران ئاسمان تاریک بکات؛","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئەو ڕۆژەی پارێزەرانی ماڵ دەلەرزن،","poem":1},{"text":"پیاوانی بەهێز دەچەمێنەوە،","poem":2},{"text":"ئەو ئافرەتانەی کە ئیشی دەستاڕیان دەکرد لەبەر کەمی لە کار دەکەون،","poem":1},{"text":"تاریک دادێن ئەو ژنانەش کە لە پەنجەرەکانەوە تەماشا دەکەن؛","poem":2}]},{"type":"verse","number":4,"content":[{"text":"کاتێک دەرگاکانی بازاڕ دادەخرێن و","poem":1},{"text":"دەنگی هاڕین نزم دەبێتەوە؛","poem":2},{"text":"ئەو ڕۆژەی کە پیرەمێرد لە دەنگی چۆلەکە هەڵدەستێت،","poem":1},{"text":"هەرچەندە بەلایەوە گۆرانی کچەکان کز دەبن؛","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەو ڕۆژەش کە خەڵک لە بەرزایی دەترسن و","poem":1},{"text":"لە ڕێگا تۆقیون،","poem":2},{"text":"کە بادەم چرۆ دەکات و","poem":1},{"text":"کوللەحاجی خۆی ڕادەکێشێت و","poem":2},{"lineBreak":true},{"text":"هیچ ئارەزوو نامێنێت.","poem":2},{"text":"ئیتر مرۆڤ بەرەو ماڵی هەتاهەتایی خۆی دەچێت و","poem":1},{"text":"شینگێڕەکان بە شەقامەکاندا دەسووڕێنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"لەبیرت بێت، پێش ئەوەی زنجیری زیو بپچڕێت و","poem":1},{"text":"قاپی زێڕین بشکێت؛","poem":2},{"text":"پێش ئەوەی گۆزە لەسەر کانی وردوخاش بکرێت،","poem":1},{"text":"یان چەرخە لەسەر بیر بشکێنرێت و","poem":2}]},{"type":"verse","number":7,"content":[{"text":"خۆڵ دەگەڕێتەوە سەر زەوی وەک پێشوو،","poem":1},{"text":"ڕۆحیش دەگەڕێتەوە لای ئەو خودایەی کە بەخشیویەتی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"وتاربێژی ژیرمەند دەڵێت: «بێ واتایە! بێ واتایان!","poem":1},{"text":"هەموو شتێک بێ واتایە!»","poem":2}]},{"type":"heading","content":["دەرئەنجامی بابەتەکە"]},{"type":"verse","number":9,"content":["سەرباری ئەوەی کە وتاربێژی ژیرمەند دانا بوو، گەلیشی فێری زانین کرد، شارەزای هەڵسەنگاندن و پشکنین و ڕێکخستنی پەندی زۆر بوو."]},{"type":"verse","number":10,"content":["وتاربێژی ژیرمەند هەوڵی دا وشە شادی بەخشەکان بدۆزێتەوە کە بە سەرڕاستی نووسراون و وشەکانی ڕاستین."]},{"type":"verse","number":11,"content":["وشەکانی پیاوی دانا وەک نەقیزە وایە، وەک بزمارە چەقیوەکانن لە پیاوانی کۆمەڵ، لەلایەن یەک شوانەوە",{"noteId":3},"دراون."]},{"type":"verse","number":12,"content":["ئەی ڕۆڵە، سەرەڕای ئەمانە، ئاگاداری شتەکانی دیکەش بە. دانانی پەڕتووکی زۆر کۆتایی بۆ نییە، لێکۆڵینەوەی زۆریش لەش ماندوو دەکات."]},{"type":"verse","number":13,"content":[{"text":"هەموو شت ئێستا بیستراوە و","poem":1},{"text":"دەرئەنجامەکەی ئەوەیە:","poem":2},{"text":"لە خودا بترسە و ڕاسپاردەکانی بەجێبگەیەنە،","poem":1},{"text":"چونکە ئەمە ئەرکی سەر شانی هەموو مرۆڤە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"خودا حوکم بەسەر هەموو کارێکدا دەدات،","poem":1},{"text":"بە هەموو کارێکی نهێنیشەوە،","poem":2},{"lineBreak":true},{"text":"جا چاک بێت یان خراپ.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"مەبەستی لە خودایە.‏","reference":{"chapter":12,"verse":11}}]},"thisChapterLink":"/api/ckb_bib/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}