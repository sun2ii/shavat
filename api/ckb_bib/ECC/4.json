{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ECC","translationId":"ckb_bib","name":"ژیرمەندی","commonName":"ژیرمەندی","title":"ژیرمەندی","order":21,"numberOfChapters":12,"sha256":"82194ab098ed39d235fba5df347cc921052ee105cfa5a4759f6536515ac74a45","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/ckb_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":4,"content":[{"type":"heading","content":["ستەمکاری، ماندووبوون، تەنهایی"]},{"type":"verse","number":1,"content":["پاشان ئاوڕم دایەوە و بینیم هەموو ئەو ستەمەی کە لەسەر زەویدا دەکرێت و ئەوەتا:",{"text":"فرمێسکی ستەملێکراوانم بینی،","poem":1},{"text":"کەس نەبوو دڵنەواییان بکات،","poem":2},{"text":"ستەمکارانیشیان زەبریان بەدەست بوو،","poem":1},{"text":"کەس نەبوو دڵنەواییان بکات.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"خۆزگە بە مردووان دەخوازرێت","poem":1},{"text":"کە دەمێکە مردوون،","poem":2},{"text":"ئەوان خۆشحاڵترن لەوانەی","poem":1},{"text":"کە لە ژیاندا ماون.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بەڵام لە هەردووکیان باشتر ئەوەیە","poem":1},{"text":"کە هێشتا لەدایک نەبووە،","poem":2},{"text":"ئەوەی ئەو خراپەکارییەی نەدیوە","poem":1},{"text":"کە لەسەر زەوی ئەنجام دەدرێت.","poem":2}]},{"type":"verse","number":4,"content":["من بینیم کە هەموو ماندووبوون و هەموو ئەوەی مرۆڤ بەرهەمی دەهێنێت لە ئەنجامی ئەو کێشمەکێشەی کە مرۆڤ بەرامبەر بە نزیکەکەی دەیکات، ئەمەش بێ واتایە و گڤەی بایە."]},{"type":"verse","number":5,"content":[{"text":"کەسی گێل دەست دەخاتە سەر دەست و","poem":1},{"text":"گۆشتی خۆی دەخوات.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"مشتێک حەسانەوە باشترە","poem":1},{"text":"لە دوو مشتی پڕ ماندووبوون و گڤەی با.","poem":2}]},{"type":"verse","number":7,"content":["دیسان شتێکی بێ واتام لەسەر زەوی بینی:"]},{"type":"verse","number":8,"content":[{"text":"یەکێکی تاک و تەنها،","poem":1},{"text":"نە کوڕی هەبوو، نە برا،","poem":2},{"text":"هەموو ماندووبوونەکەی بێ کۆتایی بوو،","poem":1},{"text":"هەروەها چاوی لە دەوڵەمەندی تێر نەدەبوو.","poem":2},{"text":"گوتی: «ئیتر بۆ کێ خۆم ماندوو بکەم و","poem":1},{"text":"گیانی خۆم بۆچی لە خۆشی بێبەش بکەم؟»","poem":2},{"text":"ئەمەش بێ واتایە و بارێکی قورسە.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"دوو کەس لە یەک کەس باشترە،","poem":1},{"text":"چونکە لە ماندووبوونەکەیان قازانجێکی باشتریان دەبێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەگەر یەکێکیان بکەوێت،","poem":1},{"text":"هاوڕێکەی هەڵیدەستێنێتەوە.","poem":2},{"text":"بەڵام قوڕبەسەر ئەوەی کە تەنهایە،","poem":1},{"text":"دەکەوێت و کەس نییە هەڵیبستێنێتەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"هەروەها ئەگەر دوو کەس پێکەوە ڕابکشێن، گەرم دەبنەوە،","poem":1},{"text":"بەڵام یەکێک تەنها بێت، چۆن گەرم دەبێتەوە؟","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەگەر یەکێک یەک کەس ببەزێنێت،","poem":1},{"text":"دووان دەتوانن بەرامبەری بوەستن،","poem":2},{"text":"گوریسی سێ تاڵیش زوو ناپسێت.","poem":1}]},{"type":"heading","content":["پلە بەرزبوونەوە بێ واتایە"]},{"type":"verse","number":13,"content":["گەنجێکی هەژار و دانا باشترە لە پاشایەکی پیر و گێل، کە ئیتر ناتوانێت گوێ لە هۆشداری بگرێت."]},{"type":"verse","number":14,"content":["دەشێت گەنجەکە لە بەندیخانەوە هاتبێتە دەرەوە هەتا ببێت بە پاشا، یاخود بە هەژاری لەو شانشینەدا لەدایک بووبێت."]},{"type":"verse","number":15,"content":["ڕوانیمە هەموو ئەو مرۆڤانەی کە بەسەر زەویدا هاتوچۆیان دەکرد پشتگیری گەنجەکەیان دەکرد کە جێگەی پاشاکەی گرتەوە."]},{"type":"verse","number":16,"content":["ئەو مرۆڤانەی کە هاتنە بەردەمی پاشا بێشومار بوون، بەڵام گەل دڵیان بەو پاشایە خۆش نەبوو. ئەمەش بێ واتایە و گڤەی بایە."]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}