ت تێکدەدەیت؟","poem":2}]},{"type":"verse","number":17,"content":[{"text":"زۆر بەدکار مەبە و","poem":1},{"text":"مەبە بە گێل.","poem":2},{"lineBreak":true},{"text":"بۆچی بمریت لە کاتی خۆت نەبێت؟","poem":2}]},{"type":"verse","number":18,"content":[{"text":"باشترە دەست بە یەکێکیانەوە بگریت و","poem":1},{"text":"دەست لەوەی دیکەش شل نەکەیت،","poem":2},{"lineBreak":true},{"text":"چونکە لەخواترس بە هیچ شێوەیەک زیادەڕۆیی ناکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"دانایی دانا بەهێزتر دەکات","poem":1},{"text":"لە دە فەرمانڕەوا کە لە شاردا بن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"بێگومان هیچ مرۆڤێکی ڕاستودروست لەسەر زەویدا نییە،","poem":1},{"text":"کە چاکە دەکات و هەرگیز گوناه ناکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"هەروەها هەموو قسەیەک کە دەیکەن دڵی خۆتی مەدەرێ،","poem":1},{"text":"نەوەک گوێت لە خزمەتکارەکەت بێت نەفرەتت لێ بکات،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"چونکە دڵت دەزانێت","poem":1},{"text":"کە تۆش زۆر جار نەفرەتت لەوانی دیکە کردووە.","poem":2}]},{"type":"verse","number":23,"content":["هەموو ئەمانەم بە دانایی تاقی کردەوە و گوتم:",{"text":"«دانا دەبم،»","poem":1},{"text":"کەچی لێم دوور بوو.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ئەو داناییە کە هەیە دوورە و زۆر قووڵە؛","poem":1},{"text":"کێ دەیدۆزێتەوە؟","poem":2}]},{"type":"verse","number":25,"content":[{"text":"هاتم سەرنجم دا لە دانایی و لێم کۆڵییەوە و","poem":1},{"text":"گەڕام بەدوای ڕاستیەکاندا بۆ ئەوەی لێی تێبگەم،","poem":2},{"text":"لە ئەنجامدا بۆم دەرکەوت کە خراپەکاری نەزانینە و","poem":1},{"text":"گێلایەتیش شێتییە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"من دۆزیمەوە کە لە مردن تاڵترە","poem":1},{"text":"ئەو ژنەی کە تۆڕە و دڵی تەڵەیە،","poem":2},{"text":"دەستەکانیشی کۆتن.","poem":1},{"text":"ئەوەی لەبەردەم خودا چاک بێت، لێی دەرباز دەبێت،","poem":2},{"lineBreak":true},{"text":"بەڵام گوناهبار بە تەڵەکەیەوە دەبێت.","poem":2}]},{"type":"verse","number":27,"content":["وتاربێژی ژیرمەند دەڵێت: «سەیر بکە، ئەمەم دۆزییەوە:",{"text":"«بۆ ئەوەی بگەمە ئەنجامی ڕاستییەکان زانیارییەکانم یەک بە یەک کۆکردەوە،","poem":1}]},{"type":"verse","number":28,"content":[{"text":"لە کاتێکدا کە هێشتا دەگەڕام و","poem":2},{"lineBreak":true},{"text":"جارێ نەگەیەشتبوومە ئەنجام،","poem":2},{"text":"پەندێکم بیستووە کە دەڵێت:","poem":1},{"text":"”لەنێو هەزار پیاودا تەنها یەکێکم دۆزییەوە،","poem":2},{"text":"بەڵام لەنێو هەموویان یەک ئافرەتم نەبینی.“","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"تەنها شتێکم دۆزیوەتەوە، ئەمەش ئەوەیە:","poem":1},{"text":"خودا مرۆڤی لەسەر بنچینەیەکی ڕاست دروستکردووە،","poem":2},{"lineBreak":true},{"text":"بەڵام ئەوان دوای داهێنانی زۆر کەوتوون.»","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}