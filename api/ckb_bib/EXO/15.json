{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"EXO","translationId":"ckb_bib","name":"دەرچوون","commonName":"دەرچوون","title":"دەرچوون دووەم پەڕتووکی موسا","order":2,"numberOfChapters":40,"sha256":"015a50a6236aded3d90bab99081cccfac0144bb9a4fe1c3e1e409f62641fc235","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/ckb_bib/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["سروودی موسا و مریەم"]},{"type":"verse","number":1,"content":["ئینجا موسا و نەوەی ئیسرائیل ئەم سروودەیان بۆ یەزدان گوت:",{"text":"«سروود بۆ یەزدان دەڵێم،","poem":1},{"text":"چونکە شکۆمەندانە سەرکەوت،","poem":2},{"text":"ئەسپ و سوارەکەی","poem":1},{"text":"فڕێدایە ناو دەریا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«هێز و سروودم یەزدانە،","poem":1},{"text":"بووە بە ڕزگاری بۆم.","poem":2},{"text":"ئەمە خودامە و شکۆداری دەکەم،","poem":1},{"text":"خودای باوکمە و بە گەورەی دەزانم.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"یەزدان پاڵەوانە،","poem":1},{"text":"ناوی یەزدانە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"گالیسکەکانی فیرعەون و سوپاکەی","poem":1},{"text":"فڕێدایە ناو دەریا،","poem":2},{"text":"هەڵبژاردەی ئەفسەرەکانی","poem":1},{"text":"لە دەریای سوور نوقوم بوون،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"قووڵایی دایپۆشین،","poem":1},{"text":"کەوتنە بنەوە وەک بەرد.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"دەستی ڕاستت، ئەی یەزدان،","poem":1},{"text":"بەتوانایە بۆ شکۆمەندیت.","poem":2},{"text":"دەستی ڕاستت، ئەی یەزدان،","poem":1},{"text":"دوژمن تێکدەشکێنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«بە مەزنی و پایەبەرزیت","poem":1},{"text":"بەرهەڵستەکانت پێشێل دەکەیت،","poem":2},{"text":"جۆشی تووڕەییت دەبارێنیت","poem":1},{"text":"وەک پووش دەیانخوات.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بە بای لووتت","poem":1},{"text":"ئاوەکان گرد بوونەوە،","poem":2},{"text":"ئاوەڕۆکان وەک گرد وەستان،","poem":1},{"text":"قووڵاییەکان لەناو دەریا بەستیان.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"دوژمن گوتی:","poem":1},{"text":"”دوایان دەکەوم، پێیان دەگەم،","poem":2},{"text":"تاڵان دابەش دەکەم،","poem":1},{"text":"گیانم لێیان تێر دەبێت،","poem":2},{"text":"شمشێرەکەم ڕادەکێشم،","poem":1},{"text":"دەستم لەناویان دەبات.“","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بەڵام بە بای خۆت فووت کرد،","poem":1},{"text":"دەریا دایپۆشین،","poem":2},{"text":"ڕۆچوون وەک قورقوشم،","poem":1},{"text":"لە ئاوێکی مەزن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەی یەزدان، کێ لەنێو خوداوەندەکان وەک تۆیە؟","poem":1},{"text":"کێ وەک تۆ","poem":2},{"lineBreak":true},{"text":"پایەبەرزە لە پیرۆزی،","poem":2},{"text":"سامناک لە شکۆمەندی،","poem":1},{"text":"دروستکەری کاری سەرسوڕهێنەر؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«دەستی ڕاستت درێژکرد،","poem":1},{"text":"زەوی قووتی دان.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەو گەلەی کڕیتەوە،","poem":1},{"text":"بە خۆشەویستییە نەگۆڕەکەت ڕابەرایەتی دەکەیت،","poem":2},{"text":"بە هێزی خۆت ڕێنمایی دەکەیت،","poem":1},{"text":"بۆ نشینگەی پیرۆزت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"گەلان گوێیان لێ دەبێت و دەلەرزن،","poem":1},{"text":"دانیشتووانی فەلەستیە ژان دەیانگرێت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"سەرکردەکانی ئەدۆم سەرسام دەبن،","poem":1},{"text":"ڕابەرەکانی مۆئاب لەرز دەیانگرێت،","poem":2},{"text":"هەموو دانیشتووانی کەنعان دەتوێنەوە.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"سامناکی و تۆقین دێتە سەریان.","poem":2},{"text":"ئەی یەزدان، بە هێزی بازووت","poem":1},{"text":"وەک بەرد لە شوێنی خۆیان دەچەقن،","poem":2},{"text":"هەتا ئەوەی گەلەکەت دەپەڕێتەوە،","poem":1},{"text":"هەتا ئەو گەلەی کڕیوتە دەپەڕێتەوە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئەی یەزدان، دەیانهێنیت و","poem":1},{"text":"دەیانچێنیت لە کێوی میراتت،","poem":2},{"text":"ئەو شوێنەی بۆ نیشتەجێی خۆت دروستت کرد،","poem":1},{"text":"ئەی پەروەردگار، ئەو پیرۆزگایەی کە دەستەکانت دایمەزراند.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«یەزدان پاشایەتی دەکات","poem":1},{"text":"بۆ هەتاهەتایە.»","poem":2}]},{"type":"verse","number":19,"content":["کاتێک ئەسپی فیرعەون بە گالیسکە و سوارەکانیەوە بۆ ناو دەریا هات، یەزدانیش ئاوی دەریای هێنایەوە سەریان، بەڵام نەوەی ئیسرائیل بەسەر وشکانیدا بە ناوەندی دەریادا ڕۆیشتن."]},{"type":"verse","number":20,"content":["ئینجا مریەمی پێغەمبەر کە خوشکی هارون بوو، دەستی دایە دەف و هەموو ئافرەتەکانیش بە دەف و سەماوە بەدوایەوە ڕۆیشتن."]},{"type":"verse","number":21,"content":["مریەمیش سروودی بۆ گوتن:",{"text":"«سروود بۆ یەزدان بڵێ،","poem":1},{"text":"چونکە شکۆمەندانە سەرکەوت،","poem":2},{"text":"ئەسپ و سوارەکانی","poem":1},{"text":"فڕێدایە ناو دەریا.»","poem":2}]},{"type":"heading","content":["مێرگەکانی مارا و ئێلیم"]},{"type":"verse","number":22,"content":["ئینجا موسا کۆچی بە نەوەی ئیسرائیل کرد و لە دەریای سوورەوە پەڕینەوە بۆ چۆڵەوانی شوور، سێ ڕۆژ بە چۆڵەوانیدا ڕۆیشتن و ئاویان نەدۆزییەوە."]},{"type":"verse","number":23,"content":["کاتێک هاتنە مارا، نەیانتوانی ئاوەکەی ئەوێ بخۆنەوە، چونکە تاڵ بوو، هەر لەبەر ئەم هۆیەشە ناونراوە مارا.",{"noteId":24}]},{"type":"verse","number":24,"content":["جا گەل بۆڵەبۆڵیان لەسەر موسا کرد و گوتیان: «چی بخۆینەوە؟»"]},{"type":"verse","number":25,"content":["موساش هاواری بۆ یەزدان کرد، یەزدانیش دارێکی پیشان دا و ئەویش فڕێیدایە ناو ئاوەکە، ئیتر ئاوەکە سازگار بوو. لەوێ یەزدان فەرز و یاسای بۆ دانان و لەوێش تاقی کردنەوە."]},{"type":"verse","number":26,"content":["فەرمووی: «ئەگەر بە باشی گوێ لە دەنگی یەزدانی پەروەردگارت بگریت و ئەوەی ڕاستە لەبەرچاوی بیکەیت و گوێ بۆ فەرمانەکانی شل بکەیت و هەموو فەرزەکانی بەجێبهێنیت، هیچ نەخۆشییەک لەوانەی خستمە سەر میسرییەکان نایخەمە سەر تۆ، چونکە من یەزدانم، ئەوەی چاکت دەکاتەوە.»"]},{"type":"verse","number":27,"content":["ئینجا هاتنە ئێلیم، لەوێ دوازدە کانیاو و حەفتا دار خورمای لێبوو، ئیتر لەوێ لەلای ئاوەکان لایاندا."]}],"footnotes":[{"noteId":24,"caller":"+","text":"مارا: مەبەستی تاڵە.‏","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/ckb_bib/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}