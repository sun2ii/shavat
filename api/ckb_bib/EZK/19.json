{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"EZK","translationId":"ckb_bib","name":"حزقیێل","commonName":"حزقیێل","title":"حزقیێل","order":26,"numberOfChapters":48,"sha256":"4edfbb004958e027750c9fc55b2db19d25f445c79517c01761accb88d8ccc623","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/ckb_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["لاوانەوەیەک بۆ میرانی ئیسرائیل"]},{"type":"verse","number":1,"content":["«تۆش بۆ میرانی ئیسرائیل بلاوێنەوە و"]},{"type":"verse","number":2,"content":["بڵێ:",{"text":"«”دایکت چ شێرێک بوو","poem":1},{"text":"لەناو شێران!","poem":2},{"text":"لەنێو جوانە شێران پاڵی دایەوە و","poem":1},{"text":"بەچکەکانی خۆی بەخێو کرد.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"یەکێک لە بەچکەکانی خۆی پێگەیاند،","poem":1},{"text":"بوو بە شێرێکی بە توانا.","poem":2},{"text":"فێری ڕاوکردنی نێچیر بوو،","poem":1},{"text":"مرۆڤیشی خوارد.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"کە نەتەوەکان هەواڵیان بیست،","poem":1},{"text":"چاڵیان بۆ هەڵکەند و گرتیان،","poem":2},{"text":"بۆ خاکی میسر","poem":1},{"text":"بە تەوق هێنایان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«”کاتێک دایکەکە بینی کە ئاواتەکەی نەهاتە دی،","poem":1},{"text":"ئیتر ئومێد بڕ بوو،","poem":2},{"text":"هات و یەکێکی دیکەی لە بەچکەکانی گرت و","poem":1},{"text":"کردی بە شێرێکی بە توانا.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لەنێو شێران کەوتە هاتوچۆ،","poem":1},{"text":"چونکە بووە شێرێکی بە توانا.","poem":2},{"text":"فێری ڕاوکردنی نێچیر بوو،","poem":1},{"text":"مرۆڤیشی خوارد.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"قەڵاکانی ئەوانی تێکشکاندن و","poem":1},{"text":"شارۆچکەکانی کاول کردن،","poem":2},{"text":"خاکەکە و هەرچی تێیدایە","poem":1},{"text":"لەبەر دەنگی نەڕەی تۆقین.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"نەتەوەکان لە هەرێمەکانی دەوروبەری","poem":1},{"text":"لە دژی کۆبوونەوە.","poem":2},{"text":"تۆڕیان هەڵدایە سەری،","poem":1},{"text":"ئەویش کەوتە چاڵەکەیانەوە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بە تەوقەوە خستیانە ناو قەفەزەوە،","poem":1},{"text":"هێنایانە لای پاشای بابل.","poem":2},{"text":"بردیانە ناو زیندان،","poem":1},{"text":"تاکو ئیتر لەسەر چیاکانی ئیسرائیل","poem":2},{"text":"نەڕەی نەبیسترێت.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«”دایکت وەک دار مێوێک بوو لە ڕەزەکەی تۆدا،","poem":1},{"text":"کە لەدەم ئاو چێنرا.","poem":2},{"text":"لەبەر زۆری ئاو،","poem":1},{"text":"چڕ و بەردار بوو.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لقی بەهێزی هەبوو،","poem":1},{"text":"کە گونجاوە بۆ داردەستی فەرمانڕەوایان.","poem":2},{"text":"باڵای کرد و هەڵکشا","poem":1},{"text":"بەناو لقە پڕگەڵاکاندا،","poem":2},{"text":"لە بەرزی و زۆری چڵەکانی","poem":1},{"text":"دەرکەوت و بینرا.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بەڵام بە ڕق و قینەوە هەڵکێشرا و","poem":1},{"text":"فڕێدرایە سەر زەوی.","poem":2},{"text":"بای ڕۆژهەڵات لێیدا و وشکی کرد،","poem":1},{"text":"بەرەکەی هەڵوەراند،","poem":2},{"text":"لقە بەهێزەکانی وشک بوون و","poem":1},{"text":"ئاگر هەڵیانیلووشی.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئێستا وا لە چۆڵەوانیدا چێنراوە،","poem":1},{"text":"لە خاکێکی وشک و تینوودا.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"لە یەکێک لە لقە گەورەکانییەوە","poem":1},{"text":"ئاگری گرت و بەرەکەی هەڵلووشی.","poem":2},{"text":"ئێستا هیچ لقێکی بەهێزی نەماوە","poem":1},{"text":"کە بۆ داردەستی فەرمانڕەوایان گونجاو بێت.“","poem":2},"ئەمە لاوانەوەیە و لە کاتی شینگێڕان دەگوترێتەوە.»"]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}