{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"EZK","translationId":"ckb_bib","name":"حزقیێل","commonName":"حزقیێل","title":"حزقیێل","order":26,"numberOfChapters":48,"sha256":"4edfbb004958e027750c9fc55b2db19d25f445c79517c01761accb88d8ccc623","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/ckb_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":27,"content":[{"type":"heading","content":["شیوەنێک بۆ سور"]},{"type":"verse","number":1,"content":["فەرمایشتی یەزدانم بۆ هات، پێی فەرمووم:"]},{"type":"verse","number":2,"content":["«ئەی کوڕی مرۆڤ، شیوەنێک بۆ سور بگێڕە."]},{"type":"verse","number":3,"content":["بە سور بڵێ: ئەی نیشتەجێ لەلای گەرووی دەریا، ئەوەی لە زۆربەی کەنارەکان بازرگانی لەگەڵ گەلان دەکات، یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«”ئەی سور، تۆ گوتت","poem":1},{"text":"’من تەواو جوانم.‘","poem":2}]},{"type":"verse","number":4,"content":[{"text":"سنوورەکانت لەناو جەرگەی دەریاکان،","poem":1},{"text":"بنیادنەرانت جوانی تۆیان تەواو کرد.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"هەموو تەختە دارەکانیان","poem":1},{"text":"لە دار سنەوبەری سنیر","poem":2},{"noteId":36},{"text":"بۆت دروستکرد.","poem":2},{"text":"لە لوبنانەوە دارێکی ئورزیان هێنا","poem":1},{"text":"تاکو داری ئاڵات بۆ دروستبکەن.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لە دار بەڕووەکانی باشان","poem":1},{"text":"سەوڵەکانی تۆیان دروستکرد.","poem":2},{"text":"تەختەداری درێژی کەشتییەکەت لە داری سەروون لە کەنارەکانی قوبرسەوە هێنراون،","poem":1},{"text":"بە عاج ڕازاوەن.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"کەتانی نەخشێنراوی میسر","poem":1},{"text":"چارۆکەکەتە هەتا بۆت ببێتە ئاڵا.","poem":2},{"text":"قوماشی مۆر و ئەرخەوانی لە کەنارەکانی ئەلیشایەوە","poem":1},{"text":"چەترت بوون.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"خەڵکی سەیدا و ئەرڤاد","poem":1},{"text":"سەوڵیان بۆ لێدەدایت.","poem":2},{"text":"ئەی سور، پیاوە داناکانت کە لەناوتدا بوون،","poem":1},{"text":"ئەوان کەشتیوانت بوون.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"پیرانی جوبەیل","poem":1},{"noteId":37},{"text":"و داناکانی لەسەر پشتی تۆ بوون،","poem":1},{"text":"کون و کەلێنەکانیان بۆت پڕ دەکردەوە.","poem":2},{"text":"هەموو کەشتییەکانی دەریا و کەشتیوانەکانیان هاتنە تەنیشتت،","poem":1},{"text":"بۆ بازرگانیکردن بە کەلوپەلەکانت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«”پیاوانی فارس و لوود و پووت","poem":1},{"text":"لە ڕیزی سوپاکەت جەنگاوەرت بوون،","poem":2},{"text":"قەڵغان و کڵاوی ئاسنینیان لەسەر شووراکانت هەڵواسی،","poem":1},{"text":"ئەوانە شکۆیان بە تۆ بەخشی.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"نەوەی ئەرڤاد لەگەڵ سوپاکەت","poem":1},{"text":"بە چواردەورتدا لەسەر شووراکانت بوون،","poem":2},{"text":"گەمادییەکان لەناو قوللەکانت بوون،","poem":1},{"text":"قەڵغانەکانیان بە چواردەورتدا لەسەر شووراکانت هەڵواسی،","poem":2},{"text":"ئەوانە جوانی تۆیان تەواو کرد.","poem":1}]},{"type":"verse","number":12,"content":["«”تەرشیش بەهۆی دەوڵەمەندی و زۆری کاڵاکانت بازرگانی لەگەڵ دەکردیت، زیو و ئاسن و تەنەکە و قورقوشمی بە کاڵاکانت ئاڵوگۆڕ دەکرد."]},{"type":"verse","number":13,"content":["«”یۆنان و توبال و مەشەک بازرگانییان لەگەڵ دەکردیت، کۆیلە و کەلوپەلی بڕۆنزیان بە کاڵاکانت ئاڵوگۆڕ دەکرد."]},{"type":"verse","number":14,"content":["«”دانیشتووانی بێت‌تۆگەرما ئەسپ و ئەسپی سواری و هێستریان بە کاڵاکانت ئاڵوگۆڕ دەکرد."]},{"type":"verse","number":15,"content":["«”خەڵکی ڕودس",{"noteId":38},"بازرگانییان لەگەڵ دەکردیت، زۆر لە کەنارەکان بازاڕی فرۆشتنی کاڵاکانی تۆ بوون، لە جیاتی نرخەکەی عاج و داری ئەبەنوسیان پێدەدایت."]},{"type":"verse","number":16,"content":["«”ئارامییەکان لەبەر زۆری کارە دەستکردەکانت بازرگانییان لەگەڵ دەکردیت، بەردە پیرۆزە،",{"noteId":39},"قوماشی ئەرخەوانی، کاری ئەتەمین",{"noteId":40},"، کەتانی ناسک، مەرجان و یاقووتیان",{"noteId":41},"بە کاڵاکانت ئاڵوگۆڕ دەکرد."]},{"type":"verse","number":17,"content":["«”یەهودا و خاکی ئیسرائیل بازرگانییان لەگەڵ دەکردیت، گەنمی مینیت و شیرینەمەنی و هەنگوین و زەیت و مەرهەمی هەتووانیان",{"noteId":42},"بە کاڵاکانت ئاڵوگۆڕ دەکرد."]},{"type":"verse","number":18,"content":["«”دیمەشق بازرگانی لەگەڵ دەکردیت بەهۆی زۆری کارە دەستکردەکانت و فرەیی سامانەکەت، شەرابی حەلبۆن و خوری چاحەریان لەگەڵت ئاڵوگۆڕ دەکرد."]},{"type":"verse","number":19,"content":["«”دانییەکان و یۆنانییەکان لە ئوزال ئاڵوگۆڕیان بە کاڵاکانت دەکرد، ئاسنی کوتراو و کاسیا",{"noteId":43},"و قامیشی بۆنخۆشیان لەگەڵ کەلوپەلەکانت ئاڵوگۆڕ دەکرد."]},{"type":"verse","number":20,"content":["«”دیدان بازرگانی لەگەڵ دەکردیت بۆ زینی لباد، بۆ سواربوون."]},{"type":"verse","number":21,"content":["«”عەرەبستان و هەموو میرەکانی قێدار بازرگانییان لەگەڵ دەکردیت، لە بەرخ و بەران و نێری، بەمە بازرگانییان لەگەڵ کردیت."]},{"type":"verse","number":22,"content":["«”بازرگانەکانی شەبا و ڕەعما بازرگانییان لەگەڵ دەکردیت، زێڕ و هەموو جۆرە بۆنێکی خۆش و بەردە گرانبەهاکانیان لە باشترین جۆر لەگەڵ کاڵاکانت ئاڵوگۆڕ دەکرد."]},{"type":"verse","number":23,"content":["«”حەڕان و کەنێ و عەدەن و بازرگانەکانی شەبا و ئەشوور و کیلمەد بازرگانییان لەگەڵ دەکردیت."]},{"type":"verse","number":24,"content":["ئەوانە لە بازاڕەکانت بە جل و بەرگی جوان، قوماشی مۆر، کاری ئەتەمین، بەڕەی چنراو و ڕەنگین بە دەزووی ڕستراو و پتەو بازرگانییان لەگەڵ کردیت."]},{"type":"verse","number":25,"content":[{"text":"«”کەشتییەکانی تەرشیش کاڵاکانت بار دەکەن.","poem":1},{"text":"لە باری گران لەناو جەرگەی دەریاکان پڕیت.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ئەوانەی سەوڵت بۆ لێدەدەن","poem":1},{"text":"بۆ ناو ئاوە زۆرەکان دەتبەن،","poem":2},{"text":"بەڵام بای ڕۆژهەڵات لەناو","poem":1},{"text":"جەرگەی دەریاکان تێکتدەشکێنێت.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"سامان و کاڵا و کەلوپەلەکانت،","poem":1},{"text":"کەشتیوان و دەریاوان و وەستاکانت،","poem":2},{"text":"ئاڵوگۆڕکەران بە کەلوپەلەکەت، هەموو جەنگاوەرەکانت کە لەناو تۆدان،","poem":1},{"text":"هەموو سەرنشینەکانت کە لە ناوەڕاستی تۆن،","poem":2},{"text":"لە ڕۆژی ژێر ئاو کەوتنت","poem":1},{"text":"دەکەونە ناو جەرگەی دەریاوە.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"لە دەنگی هاواری کەشتیوانەکانت","poem":1},{"text":"کەنارەکان دەلەرزن.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"هەموو سەوڵلێدەر و کەشتیوانە بە ئەزموونەکان و","poem":1},{"text":"کەشتیوانە ئاساییەکانی دەریا،","poem":2},{"text":"لە کەشتییەکانیان دادەبەزن و","poem":1},{"text":"لەسەر کەنار ڕادەوەستن،","poem":2}]},{"type":"verse","number":30,"content":[{"text":"دەنگیان بۆت بەرز دەکەنەوە و","poem":1},{"text":"بە تاڵییەوە دەقیژێنن،","poem":2},{"text":"خۆڵ دەکەن بەسەر سەری خۆیاندا و","poem":1},{"text":"لەناو خۆڵەمێش خۆیان دەگەوزێنن.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"بۆ تۆ پرچی سەریان دەتاشن و","poem":1},{"text":"جلوبەرگی گوش دەپۆشن.","poem":2},{"text":"بە تاڵی گیانەوە گریانێکی تاڵ","poem":1},{"text":"بۆت دەگریێن.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"لە کاتی گریانیان لاوانەوەیەک بەرز دەکەنەوە،","poem":1},{"text":"بۆت دەلاوێننەوە:","poem":2},{"text":"’کێ وەک سور لەناو جەرگەی دەریا","poem":1},{"text":"بێدەنگی نواند؟‘","poem":2}]},{"type":"verse","number":33,"content":[{"text":"کاتێک کاڵاکانت بە دەریاکاندا ناردە دەرەوە،","poem":1},{"text":"گەلانێکی زۆرت تێر کرد.","poem":2},{"text":"بە زۆری سامان و کەلوپەلەکانت","poem":1},{"text":"پاشایانی زەویت دەوڵەمەند کرد.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"کاتێک لە دەریاکان تێکشکایت","poem":1},{"text":"لەناو قووڵایی ئاوەکان،","poem":2},{"text":"کەرەستە و هەموو سەرنشینەکەت","poem":1},{"text":"لەگەڵت نوقوم بوون.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"هەموو دانیشتووانی کەنارەکان","poem":1},{"text":"واقیان لێت وڕدەمێنێت،","poem":2},{"text":"پاشاکانیان موچڕکەیان پێدا دێت،","poem":1},{"text":"ڕوخساریان دەشێوێت.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"بازرگانانی نێو گەلان فیکەت بۆ لێ دەدەن،","poem":1},{"text":"کۆتاییەکەت ترسناک دەبێت و","poem":2},{"lineBreak":true},{"text":"ئیتر بۆ هەتاهەتایە نامێنیت.“»","poem":2}]}],"footnotes":[{"noteId":36,"caller":"+","text":"سنیر: دەگەڕێتەوە بۆ چیای حەرمۆن. بڕوانە دواوتار 3‏:9‏.‏","reference":{"chapter":27,"verse":5}},{"noteId":37,"caller":"+","text":"شاری جوبەیل شارێکی کۆنە کە مێژووەکەی دەگەڕێتەوە بۆ 7000 لەمەوپێش، ئەمرۆ بە دووری 38 کیلۆمەتر دەکەوێتە باکووری بەیروت.‏","reference":{"chapter":27,"verse":9}},{"noteId":38,"caller":"+","text":"دوورگەیەکە لە دەریای سپی ناوەڕاست.‏","reference":{"chapter":27,"verse":15}},{"noteId":39,"caller":"+","text":"بەردە پیرۆزە: بەردێکی شینی سەوزباوە.‏","reference":{"chapter":27,"verse":16}},{"noteId":40,"caller":"+","text":"نەخشاندنی قوماش بە دەست.‏","reference":{"chapter":27,"verse":16}},{"noteId":41,"caller":"+","text":"یاقووت: گەوهەری سووری تێر.‏","reference":{"chapter":27,"verse":16}},{"noteId":42,"caller":"+","text":"ئازارشکێن.‏","reference":{"chapter":27,"verse":17}},{"noteId":43,"caller":"+","text":"دارێکە بۆ بۆنخۆشی بەکاردێت.‏","reference":{"chapter":27,"verse":19}}]},"thisChapterLink":"/api/ckb_bib/EZK/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/EZK/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/EZK/26.json","previousChapterAudioLinks":{},"numberOfVerses":36}