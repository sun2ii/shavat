{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"EZK","translationId":"ckb_bib","name":"حزقیێل","commonName":"حزقیێل","title":"حزقیێل","order":26,"numberOfChapters":48,"sha256":"4edfbb004958e027750c9fc55b2db19d25f445c79517c01761accb88d8ccc623","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/ckb_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["فەرمایشتێک سەبارەت بە پاشای سور"]},{"type":"verse","number":1,"content":["فەرمایشتی یەزدانم بۆ هات، پێی فەرمووم:"]},{"type":"verse","number":2,"content":["«ئەی کوڕی مرۆڤ، بە سەرۆکی سور بڵێ: ”یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«”لەبەر لەخۆباییبوونەکەت گوتت:","poem":1},{"text":"’من خوداوەندێکم،","poem":2},{"text":"لەسەر تەختی خوداوەندیێتی دادەنیشم","poem":1},{"text":"لەناو جەرگەی دەریاکان.‘","poem":2},{"text":"بەڵام تۆ مرۆڤیت نەک خوداوەند،","poem":1},{"text":"هەرچەندە وا بزانیت وەک خوداوەندێک دانایت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئایا تۆ لە دانیال داناتری؟","poem":1},{"text":"هیچ نهێنییەک لێت ناشاردرێتەوە؟","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بە دانایی و تێگەیشتنت سامانت بۆ خۆت دەست کەوت،","poem":1},{"text":"زێڕ و زیوت لە گەنجینەکانت کۆکردەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بەهۆی شارەزایی زۆرت لە بازرگانی","poem":1},{"text":"سامانەکەتت زیاد کرد،","poem":2},{"text":"جا لەبەر دەوڵەمەندییەکەت","poem":1},{"text":"لەخۆبایی بوویت.","poem":2}]},{"type":"verse","number":6,"content":["«”لەبەر ئەوە یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«”وا دەزانیت کە دانایت،","poem":1},{"text":"کە دانایی خوداوەندت هەیە،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"هەر لەبەر ئەوەش من بێگانە دەهێنمە سەرت،","poem":1},{"text":"دڕندەترینی نەتەوەکان،","poem":2},{"text":"شمشێرەکانیان هەڵدەکێشنە سەر جوانی و داناییەکەت،","poem":1},{"text":"شکۆ درەوشاوەکەت دەبڕن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"لەناو جەرگەی دەریاکان","poem":1},{"text":"بە مردنی خوێناوی دەمریت،","poem":2},{"lineBreak":true},{"text":"شۆڕت دەکەنەوە ناو جیهانی مردووان.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئایا لەبەردەم بکوژەکانت","poem":1},{"text":"دەڵێیت: ’من خوداوەندم‘؟","poem":2},{"text":"نەخێر، بەڵکو تۆ لەناو دەستی ئەوانە دایت کە دەتدەنە بەر شمشێر،","poem":1},{"text":"تەنها مرۆڤیت، نەک خوداوەند.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بە مردنی خەتەنەنەکراوان دەمریت،","poem":1},{"text":"بە دەستی بێگانان.","poem":2},"من بەڵێنم دا، ئەوە فەرمایشتی یەزدانی باڵادەستە.“»"]},{"type":"line_break"},{"type":"verse","number":11,"content":["فەرمایشتی یەزدانم بۆ هات، پێی فەرمووم:"]},{"type":"verse","number":12,"content":["«ئەی کوڕی مرۆڤ، بۆ پاشای سور بلاوێنەوە و پێی بڵێ: ”یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«”تۆ نموونەی تەواوەتی بوویت،","poem":1},{"text":"پڕ لە دانایی و جوانی تەواو بوویت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لە عەدەنی بەهەشتی خودا بوویت،","poem":1},{"text":"هەموو بەردێکی گرانبەها تۆی دەڕازاندەوە:","poem":2},{"lineBreak":true},{"text":"یاقووت","poem":2},{"noteId":44},{"text":"، یاقووتی زەرد، زمروود،","poem":2},{"lineBreak":true},{"text":"زەبەرجەد، بەردی عاشقبەند، یەشب،","poem":2},{"lineBreak":true},{"text":"یاقووتی شین، بەردە پیرۆزە","poem":2},{"noteId":45},{"text":"و زمروودی سەوز.","poem":2},{"text":"چواردەوری بەردە گرانبەهاکەت بە زێڕ نەخشێنرا بوو،","poem":1},{"text":"لە ڕۆژی بەدیهێنانت ئامادە کران.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"تۆ کەڕوبی دەستنیشانکراو بوویت بۆ پاسەوانی،","poem":1},{"text":"ئەم ئەرکەم بە تۆ سپاردبوو.","poem":2},{"text":"تۆ لەسەر کێوی پیرۆزی خودا بوویت،","poem":1},{"text":"بەناو بەردە ئاگرینەکاندا هاتوچۆت دەکرد.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"تۆ لە کردەوەکانت تەواو بوویت،","poem":1},{"text":"لە ڕۆژی بەدیهێنانتەوە","poem":2},{"lineBreak":true},{"text":"هەتا ئەو ڕۆژەی خراپەت تێدا بەدیکرا.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بەهۆی فراوانبوونی بازرگانییەکەت،","poem":1},{"text":"پڕ بوویت لە ستەم و","poem":2},{"lineBreak":true},{"text":"گوناهت کرد.","poem":2},{"text":"لەبەر ئەوە ئەی کەڕوبی پاسەوان،","poem":1},{"text":"وەک گڵاوییەک لە کێوی خوداوە فڕێمدایت،","poem":2},{"lineBreak":true},{"text":"لەناو بەردە ئاگرینەکاندا دەرمکردیت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لەبەر جوانییەکەت لەخۆبایی بوویت،","poem":1},{"text":"لە پێناوی شکۆی خۆت داناییەکەتت بە گەندەڵی بەکارهێنا.","poem":2},{"text":"لەبەر ئەوە فڕێمدایتە سەر زەوی،","poem":1},{"text":"تۆم کرد بە دیمەنێک بۆ ئەوەی پاشایان تەماشات بکەن.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"لەبەر زۆری تاوانەکانت و ناپاکیت لە بازرگانییەکەت","poem":1},{"text":"پیرۆزگاکانی خۆتت گڵاوکرد.","poem":2},{"text":"لەبەر ئەوە ئاگرێکم داگیرساند لە تۆوە دەرچوو،","poem":1},{"text":"تۆی هەڵلووشی،","poem":2},{"text":"دەتکەمە خۆڵەمێش لەسەر زەوی،","poem":1},{"text":"لەبەرچاوی هەموو ئەوانەی سەیریان دەکردیت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"هەموو ئەوانەی لەنێو گەلان تۆیان ناسی","poem":1},{"text":"واقیان لێت وڕدەمێنێت،","poem":2},{"text":"چونکە بوویتە پەند و","poem":1},{"text":"ئیتر بۆ هەتاهەتایە نامێنیت.“»","poem":2}]},{"type":"heading","content":["فەرمایشتێک سەبارەت بە سەیدا"]},{"type":"verse","number":20,"content":["فەرمایشتی یەزدانم بۆ هات، پێی فەرمووم:"]},{"type":"verse","number":21,"content":["«ئەی کوڕی مرۆڤ، ڕووی خۆت لە سەیدا بکە و پێشبینی لەسەر بکە،"]},{"type":"verse","number":22,"content":["بڵێ: ”یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«”ئەی سەیدا، من لە دژی تۆم و","poem":1},{"text":"لە ناوەڕاستی تۆدا شکۆمەندی خۆم دەردەخەم.","poem":2},{"text":"کاتێک سزای ئەو دەدەم و","poem":1},{"text":"پیرۆزی خۆم دەردەخەم،","poem":2},{"lineBreak":true},{"text":"ئەو کاتە دەزانن کە من یەزدانم.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"دەرد دەنێرمە سەری و","poem":1},{"text":"خوێن بەناو کۆڵانەکانیدا دەڕوات.","poem":2},{"text":"لە هەموو لایەکەوە شمشێر دێتە سەری و لە ناوەڕاستیدا کوژراوەکان دەکەون،","poem":1},{"text":"کە لە هەموو لایەکەوە دێتە سەری،","poem":2},{"text":"ئیتر ئەوان دەزانن کە من یەزدانم.","poem":1}]},{"type":"verse","number":24,"content":["«”لەمەودوا ئەو گەلانەی کە لە دەوروبەری بنەماڵەی ئیسرائیلن، ئەوانەی سووکایەتییان پێ دەکەن بۆیان نابنە چقڵی چەقیو و دڕکی بە ئازار. ئیتر ئەوان دەزانن کە من یەزدانی باڵادەستم."]},{"type":"verse","number":25,"content":["«”یەزدانی باڵادەست ئەمە دەفەرموێت: کاتێک بنەماڵەی ئیسرائیل کۆدەکەمەوە، لەنێو ئەو گەلانەی کە بۆ ناویان پەرتەوازە بوون، لەبەرچاوی نەتەوەکان پیرۆزی خۆم لەنێویاندا دەردەخەم. ئیتر لە خاکەکەی خۆیاندا نیشتەجێ دەبن، ئەوەی دام بە یاقوبی بەندەی خۆم."]},{"type":"verse","number":26,"content":["ئینجا بە ئاسوودەیی تێیدا نیشتەجێ دەبن و خانوو بنیاد دەنێن و ڕەز دەچێنن. کاتێک سزای هەموو ئەوانە دەدەم کە لە دەوروبەریان سووکایەتییان پێ کردن، بە ئاسوودەیی نیشتەجێ دەبن. ئیتر ئەوان دەزانن کە من یەزدانم، خودای ئەوانم.“»"]}],"footnotes":[{"noteId":44,"caller":"+","text":"یاقووت: گەوهەری سووری تێر.‏","reference":{"chapter":28,"verse":13}},{"noteId":45,"caller":"+","text":"بەردە پیرۆزە: بەردێکی شینی سەوزباو.‏","reference":{"chapter":28,"verse":13}}]},"thisChapterLink":"/api/ckb_bib/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}