{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"EZK","translationId":"ckb_bib","name":"حزقیێل","commonName":"حزقیێل","title":"حزقیێل","order":26,"numberOfChapters":48,"sha256":"4edfbb004958e027750c9fc55b2db19d25f445c79517c01761accb88d8ccc623","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/ckb_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"heading","content":["شیوەنێک بۆ میسر"]},{"type":"verse","number":1,"content":["فەرمایشتی یەزدانم بۆ هات، پێی فەرمووم:"]},{"type":"verse","number":2,"content":["«ئەی کوڕی مرۆڤ، پێشبینی بکە و بڵێ: ”یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«”واوەیلا بکەن،","poem":1},{"text":"’ئای بۆ ئەو ڕۆژە!‘","poem":2}]},{"type":"verse","number":3,"content":[{"text":"چونکە ڕۆژەکە نزیکە،","poem":1},{"text":"ڕۆژەکەی یەزدان نزیکە،","poem":2},{"text":"ڕۆژێکی بە هەورە،","poem":1},{"text":"کاتی وێرانبوونی نەتەوەکان دەبێت.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"شمشێرێک دێتە سەر میسر،","poem":1},{"text":"ترس دێتە سەر کوش.","poem":2},{"text":"کاتێک کوژراوان لە میسر دەکەون،","poem":1},{"text":"سامانەکەی دەبردرێت و","poem":2},{"lineBreak":true},{"text":"بناغەکانی دەڕووخێنرێت.","poem":2}]},{"type":"verse","number":5,"content":["کوش و لیبیا، لوود و هەموو عەرەبستان، کووب و نەوەکانی خاکی پەیمان، لەگەڵ میسر بە شمشێرەکە دەکەون."]},{"type":"verse","number":6,"content":["«”یەزدان ئەمە دەفەرموێت:",{"text":"«”هاوپەیمانانی میسر دەشکێن و","poem":1},{"text":"هێزەکەی لەدەست دەدات کە مایەی شانازییەتی،","poem":2},{"text":"خەڵکەکەشی لە مگدۆلەوە هەتا ئەسوان","poem":1},{"text":"بە شمشێرەکە دەکوژرێن.“»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانی باڵادەستە.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"«”وەک خاکەکانی دەوروبەریان چۆڵ دەبن،","poem":1},{"text":"شارەکانیان لە ڕیزی شارە کاولەکان دەبن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بەوە دەزانن کە من یەزدانم،","poem":1},{"text":"کاتێک ئاگر لە میسر بەردەدەم و","poem":2},{"lineBreak":true},{"text":"هەموو یارمەتیدەرانی تێکدەشکێنرێن.","poem":2}]},{"type":"verse","number":9,"content":["«”لەو ڕۆژەدا، نێردراوان بە سواری کەشتی لەلای منەوە دێن بۆ تۆقاندنی کوشی لەخۆڕازی، ئینجا لە ڕۆژی سزادانی میسر ترس دێتە سەریان، چونکە ئەوەتا دێت."]},{"type":"line_break"},{"type":"verse","number":10,"content":["«”یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«”من ئاپۆرەی سوپای میسر لەناودەبەم،","poem":1},{"text":"بە دەستی نەبوخودنەسری پاشای بابل.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەو بە خۆی و بە لەشکرەکەیەوە دڕندەترینی نەتەوەکانن،","poem":1},{"text":"بۆ کاولکردنی خاکەکە دەهێنرێن،","poem":2},{"text":"جا شمشێرەکانیان بۆ سەر میسر هەڵدەکێشن،","poem":1},{"text":"خاکەکە پڕ دەکەن لە کوژراو.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"چەمەکانی نیل وشک دەکەم و","poem":1},{"text":"خاکەکە دەفرۆشم بە خراپەکاران،","poem":2},{"text":"بە دەستی بێگانان","poem":1},{"text":"خاکەکە و هەرچی تێیدایە کاولی دەکەم.","poem":2},"من یەزدانم، ئەوەم فەرموو."]},{"type":"line_break"},{"type":"verse","number":13,"content":["«”یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«”بتەکان لەناودەبەم و","poem":1},{"text":"کۆتایی بە پەیکەرەکانی نێو مەمفیس دەهێنم،","poem":2},{"text":"لەمەودوا هیچ میرێک لە خاکی میسر هەڵناکەوێت،","poem":1},{"text":"ترس دەخەمە سەر خاکی میسر.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"پاشایەتی باشووری میسر تێکدەدەم و","poem":1},{"text":"ئاگر لە چۆعەن بەردەدەم و","poem":2},{"lineBreak":true},{"text":"لە شاری تیب سزا دەسەپێنم.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"تووڕەیی خۆم بەسەر شاری پەلوزیوم دەبارێنم،","poem":1},{"text":"قەڵاکەی میسر،","poem":2},{"lineBreak":true},{"text":"ئاپۆرەی سوپای تیب ڕیشەکێش دەکەم.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئاگر لە میسر بەردەدەم،","poem":1},{"text":"پەلوزیوم ئێشی پێ دەگات.","poem":2},{"text":"تیب تەفروتونا دەبێت،","poem":1},{"text":"مەمفیسیش هەموو ڕۆژێک لە تەنگانەدا دەبێت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"گەنجەکانی ئۆن و پیڤەسەت","poem":1},{"text":"بە شمشێر دەکوژرێن،","poem":2},{"lineBreak":true},{"text":"ئەو دوو شارەش ڕاپێچ دەکرێن.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"لە تەحپەنحێس ڕۆژ تاریک دادێت","poem":1},{"text":"کاتێک نیرەکانی","poem":2},{"noteId":49},{"text":"میسر دەشکێنم،","poem":2},{"lineBreak":true},{"text":"شانازی هێزی نامێنێت.","poem":2},{"text":"هەورێک میسر دادەپۆشێت،","poem":1},{"text":"شارۆچکەکانی ڕاپێچ دەکرێن.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"لە میسر سزا دەسەپێنم،","poem":1},{"text":"ئیتر ئەوان دەزانن کە من یەزدانم.“»","poem":2}]},{"type":"heading","content":["شکاندنی هێزەکانی فیرعەون"]},{"type":"verse","number":20,"content":["لە حەوتی مانگی یەکی ساڵی یازدەیەمین،",{"noteId":50},"فەرمایشتی یەزدانم بۆ هات، پێی فەرمووم:"]},{"type":"verse","number":21,"content":["«ئەی کوڕی مرۆڤ، من بازووی فیرعەونی پاشای میسرم شکاند. یەکناگرێتەوە، نە بە پەلیکە دار و نە بە پێچانەوەی، بۆ ئەوەی بەهێز بێت و شمشێر بەدەستەوە بگرێتەوە."]},{"type":"verse","number":22,"content":["لەبەر ئەوە یەزدانی باڵادەست ئەمە دەفەرموێت: من لە دژی فیرعەونی پاشای میسرم. هەردوو بازووی دەشکێنم، ساغەکە و شکاوەکە، شمشێر لە دەستی بەردەدەمەوە."]},{"type":"verse","number":23,"content":["میسرییەکان بەناو نەتەوەکاندا پەرت دەکەم و بەناو خاکەکاندا بڵاویان دەکەمەوە."]},{"type":"verse","number":24,"content":["هەردوو بازووی پاشای بابل توند دەکەم و شمشێری خۆم دەدەمە دەستییەوە. هەردوو بازووی فیرعەونیش دەشکێنم و لەبەردەمی وەک نوزانەوەی بریندار دەنوزێتەوە."]},{"type":"verse","number":25,"content":["بازووەکانی پاشای بابل توند دەکەم، بەڵام بازووەکانی فیرعەون دەکەون. ئیتر ئەوان دەزانن کە من یەزدانم، کاتێک شمشێری خۆم دەدەمە دەست پاشای بابل و بەسەر خاکی میسردا هەڵیدەکێشێت."]},{"type":"verse","number":26,"content":["میسرییەکان بەناو نەتەوەکاندا پەرتەوازە دەکەم و بەناو خاکەکاندا بڵاویان دەکەمەوە. ئیتر ئەوان دەزانن کە من یەزدانم.»"]}],"footnotes":[{"noteId":49,"caller":"+","text":"مەبەستی لە بارگرانییە.‏","reference":{"chapter":30,"verse":18}},{"noteId":50,"caller":"+","text":"مەبەست لەو ماوەیە لەدوای ڕاپێچکردنی یەهۆیاکینی پاشای یەهودا بۆ بابل، کە بەرامبەر بە ساڵنامەی ئێستا دەکاتە بیست و نۆی مانگی چواری ساڵی 587ی پێش زایین.‏","reference":{"chapter":30,"verse":20}}]},"thisChapterLink":"/api/ckb_bib/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}