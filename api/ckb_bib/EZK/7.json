poem":2},{"noteId":8},{"text":"چونکە ئەو پەیامەی خودا","poem":1},{"text":"بۆ هەموو خەڵکەکەیە ناگەڕێتەوە،","poem":2},{"text":"مرۆڤیش لەبەر تاوانەکەی","poem":1},{"text":"ناتوانێت دەست بە ژیانییەوە بگرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«”هەرچەندە فوو لە کەڕەنا بکەن و","poem":1},{"text":"هەموو چەک و ئازووقەیەک ئامادە بکەن،","poem":2},{"text":"بەڵام کەس ناچێتە جەنگ،","poem":1},{"text":"چونکە تووڕەییم لەسەر هەموو خەڵکەکەیە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"شمشێر لە دەرەوە و","poem":1},{"text":"دەرد و قاتوقڕیش لەناوەوە.","poem":2},{"text":"ئەوەی لە دەشتودەرە بە شمشێر دەمرێت،","poem":1},{"text":"ئەوەش لە شارە قاتوقڕی و دەرد دەیخوات.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئەوانەی دەرباز دەبن","poem":1},{"text":"هەڵدێن بۆ چیاکان و","poem":2},{"text":"وەک کۆتری دۆڵەکان هەموویان دەگمێنن،","poem":1},{"text":"هەریەکە و لەبەر تاوانەکەی خۆی.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"هەموو دەستەکان شل دەبن و","poem":1},{"text":"هەموو ئەژنۆکان دەبن بە ئاو.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"جلوبەرگی گوش","poem":1},{"noteId":9},{"text":"دەپۆشن و","poem":1},{"text":"ترس دایاندەگرێت.","poem":2},{"text":"ڕیسوایی لەسەر ڕوخساریان دەبێت و","poem":1},{"text":"سەریان دەڕووتێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«”زیوەکانیان فڕێدەدەنە سەر شەقامەکان و","poem":1},{"text":"زێڕیان دەبێتە گڵاوی.","poem":2},{"text":"زێڕ و زیویان ناتوانێت","poem":1},{"text":"لە ڕۆژی تووڕەیی یەزدان فریایان بکەوێت.","poem":2},{"text":"بەوانە تێر نابن و هەر برسی دەبن،","poem":1},{"text":"چونکە ئەو شتانە بۆیان بوون بە کۆسپی تاوان.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"بە خشڵە جوانەکانیشیان کە مایەی شانازی بوون","poem":1},{"text":"لە دروستکردنی بتە گڵاوەکانیان بەکاریانهێنا،","poem":2},{"text":"وێنەی قێزەونیان دروستکرد.","poem":1},{"text":"لەبەر ئەوە بۆیان دەکەم بە مایەی گڵاوی.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"دەیدەمە دەست بێگانەکان بۆ تاڵانی،","poem":1},{"text":"هەروەها دەیدەمە بەدکارانی زەوی بۆ دزی،","poem":2},{"lineBreak":true},{"text":"جا گڵاوی دەکەن.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ڕووی خۆم لێیان وەردەگێڕم و","poem":1},{"text":"شوێنی بەنرخم گڵاو دەکەن،","poem":2},{"text":"توندوتیژەکان دێنە ناویەوە،","poem":1},{"text":"ئەوێ گڵاو دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«”زنجیر دروستبکە بۆ بەدیلگرتن!","poem":1},{"text":"چونکە خاکەکە پڕ بووە لە تاوانی خوێنڕشتن،","poem":2},{"lineBreak":true},{"text":"شارەکەش پڕ بووە لە ستەم.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"جا دڕندەترینی نەتەوەکان دەهێنم و","poem":1},{"text":"دەست بەسەر ماڵەکانیاندا دەگرن،","poem":2},{"text":"شانازیکردنی بەهێزەکان لەناودەبەم،","poem":1},{"text":"پیرۆزگاکانیان گڵاو دەبێت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"لە کاتی تۆقینیان","poem":1},{"text":"داوای ئاشتی دەکەن و نییە.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"بەڵا لەسەر بەڵا و","poem":1},{"text":"هەواڵ لەسەر هەواڵ دێت،","poem":2},{"text":"داوای بینین لە پێغەمبەر دەکەن،","poem":1},{"text":"فێرکردن لەلای کاهین نامێنێت،","poem":2},{"lineBreak":true},{"text":"ڕاوێژکردنیش لەلای پیران.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"پاشا دەگریێت و","poem":1},{"text":"میر نائومێد دەبێت،","poem":2},{"lineBreak":true},{"text":"دەستی گەلی خاکەکەش دەلەرزێت.","poem":2},{"text":"بەگوێرەی ڕەفتاری خۆیان بەسەریاندا دەهێنمەوە و","poem":1},{"text":"بەگوێرەی حوکمەکانی خۆیان حوکمیان بەسەردا دەدەم.","poem":2},"ئیتر ئەوان دەزانن کە من یەزدانم.“»"]}],"footnotes":[{"noteId":8,"caller":"+","text":"مەبەستی لەوەیە کە ساڵی یۆبیل نابینێت، بڕوانە لێڤییەکان 25‏:25‏-28.‏‏","reference":{"chapter":7,"verse":13}},{"noteId":9,"caller":"+","text":"لە کاتی ماتەمگێڕان و تۆبەکردندا جلوبەرگی لە گوش دروستکراویان لەبەرکردووە کە ئەزیەتی پێستیانی داوە.‏","reference":{"chapter":7,"verse":18}}]},"thisChapter