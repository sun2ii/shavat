{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"GEN","translationId":"ckb_bib","name":"پەیدابوون","commonName":"پەیدابوون","title":"پەیدابوون یەکەم پەڕتووکی موسا","order":1,"numberOfChapters":50,"sha256":"7cd6c68e91354c72cd5bb68191a1a8104696abd7b5d0ceab8435b8257a833bca","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/ckb_bib/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["یاقوب داوای بەرەکەت بۆ کوڕەکانی دەکات"]},{"type":"verse","number":1,"content":["ئینجا یاقوب کوڕەکانی خۆی بانگکرد و گوتی: «کۆببنەوە تاکو پێتان بڵێم کە لە ڕۆژانی داهاتوودا چیتان بەسەردێت."]},{"type":"verse","number":2,"content":[{"text":"«ئەی کوڕانی یاقوب، کۆببنەوە و گوێ بگرن،","poem":1},{"text":"گوێ لە ئیسرائیلی باوکتان بگرن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«ڕەئوبێن، تۆ نۆبەرەکەی منیت،","poem":1},{"text":"هێزی منیت و یەکەم توانامیت،","poem":2},{"lineBreak":true},{"text":"سەری شانازی و سەری هێزی.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"هەڵچوو وەک ئاو، باڵادەست نابیت،","poem":1},{"text":"چونکە چوویتە سەر پێخەفەکەی باوکت،","poem":2},{"lineBreak":true},{"text":"گڵاوت کرد، سەرکەوتیتە سەر نوێنەکەم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«شیمۆن و لێڤی بران،","poem":1},{"text":"بە چەکی توندوتیژی چەکدارن.","poem":2},{"noteId":120}]},{"type":"verse","number":6,"content":[{"text":"من ناچمە ناو کۆڕی ڕاوێژیان،","poem":1},{"text":"سەنگینی من یەک ناگرێتەوە لەگەڵ کۆمەڵەکەیان،","poem":2},{"text":"چونکە لە کاتی تووڕەبوونیاندا مرۆڤیان کوشت و","poem":1},{"text":"لە خۆشیشیاندا گایان لە پێ خست.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"نەفرەت لە تووڕەییان کەوا توندە،","poem":1},{"text":"لە هەڵچوونیان کەوا سەختە.","poem":2},{"text":"لەناو یاقوب بەشیان دەکەم و","poem":1},{"text":"لەناو ئیسرائیل بڵاوەیان پێ دەکەم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«یەهودا","poem":1},{"noteId":121},{"text":"، براکانت ستایشی تۆ دەکەن،","poem":1},{"text":"دەستت لەسەر پشتەملی دوژمنانت دەبێت،","poem":2},{"lineBreak":true},{"text":"کوڕانی باوکیشت کڕنۆشت بۆ دەبەن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بەچکە شێرە یەهودا،","poem":1},{"text":"لەسەر نێچیر گەڕایتەوە، کوڕی خۆم.","poem":2},{"text":"خۆی نوشتاندەوە، خۆی مات دا، وەک شێر،","poem":1},{"text":"وەک شێرە مێ، کێ هەڵیدەستێنێت؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"داردەستەکە لە یەهودا دانابڕێت،","poem":1},{"text":"گۆچانی فەرمانکردنیش لەنێوان قاچەکانی،","poem":2},{"text":"هەتا ئەو کەسە دێت کە خاوەنیەتی،","poem":1},{"noteId":122},{"text":"گەلان هەر بۆ ئەو ملکەچ دەبن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"نێرەکەرەکەی بە دار مێو دەبەستێتەوە و","poem":1},{"text":"ماکەرەکەی بە باشترین لقە مێوەوە.","poem":2},{"text":"جلەکانی لەناو شەراب دەشوات و","poem":1},{"text":"پۆشاکەکەی لەناو خوێنی ترێ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"چاوەکانی لە شەراب تۆخترن و","poem":1},{"text":"ددانەکانی لە شیر سپیترن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«زەبولون لە کەناری دەریا نیشتەجێ دەبێت،","poem":1},{"text":"دەبێتە بەندەری کەشتییەکان،","poem":2},{"lineBreak":true},{"text":"سنووریشی هەتا سەیدا دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«یەساخار نێرەکەرێکی زەبەلاحە و","poem":1},{"text":"لەنێوان دوو هەگبە مات بووە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بینی شوێنێکی باشە بۆ پشوودان و","poem":1},{"text":"زەوییەکەی دڵگیرە،","poem":2},{"text":"شانی دەچەمێتەوە بۆ بار و","poem":1},{"text":"دەبێتە کۆیلەی کاری زۆرەملێ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«دان دادوەری گەلەکەی خۆی دەکات،","poem":1},{"text":"وەک یەکێک لە هۆزەکانی ئیسرائیل.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"دان مارێک دەبێت لەسەر ڕێگا،","poem":1},{"text":"مارێکی ژەهراوی لەسەر ڕێڕەو،","poem":2},{"text":"بە پاژنەی ئەسپەوە دەدات و","poem":1},{"text":"سوارەکەی بەرەو دواوە بەردەبێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«ئەی یەزدان، چاوەڕێی ڕزگاریی تۆم.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«چەتە پەلاماری گاد دەدەن،","poem":1},{"text":"بەڵام ئەو دەگاتە پاژنەی پێیان و پەلاماریان دەدات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«لە ئاشێر نانی چەور دەبێت،","poem":1},{"text":"ئەو خواردنی چەور و بەتام دەداتە پاشایان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«نەفتالی ئاسکێکی دەرپەڕیوە و","poem":1},{"text":"بەچکەی جوانی دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«یوسف مێوێکی بەردارە،","poem":1},{"text":"مێوێکی بەردارە لەسەر کانیاو،","poem":2},{"lineBreak":true},{"text":"چڵەکانی بەسەر دیوارێکدا هەڵگەڕاون.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"تیرئەندازان دڕندانە پەلاماریان دا و","poem":1},{"text":"ڕمیان تێگرت و هەراسانیان کرد.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"بەڵام کەوانەکەی بە توندوتۆڵی مایەوە،","poem":1},{"text":"بازووەکانی دەستی لێزان بوون،","poem":2},{"text":"بە دەستی توانادارەکەی یاقوب،","poem":1},{"text":"بە ناوی شوانەکە، تاشەبەردەکەی ئیسرائیل","poem":2},{"noteId":123},{"text":"،","poem":2}]},{"type":"verse","number":25,"content":[{"text":"بەهۆی خوداکەی باوکتەوە کە یارمەتیت دەدات،","poem":1},{"text":"بەهۆی هەرە بەتواناوە کە بەرەکەتدارت دەکات،","poem":2},{"text":"بە بەرەکەتەکانی ئاسمان لە سەرەوە و","poem":1},{"text":"بەرەکەتەکانی ئەو قووڵاییەی ماتە لە ژێرەوە،","poem":2},{"lineBreak":true},{"text":"بەرەکەتەکانی هەردوو مەمک و منداڵدان.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"بەرەکەتەکانی باوکت مەزنترن","poem":1},{"text":"لە بەرەکەتەکانی چیای هەتاهەتایی،","poem":2},{"lineBreak":true},{"text":"لە بەخشندەیی گردە دێرینەکان.","poem":2},{"text":"با بەسەر سەری یوسفەوە بن،","poem":1},{"text":"بەسەر ناوچەوانی جیاکراوە لە براکانی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«بنیامین گورگێکی دڕندەیە،","poem":1},{"text":"بەیانییان نێچیر دەخوات و","poem":2},{"lineBreak":true},{"text":"ئێوارانیش دەستکەوت دابەش دەکات.»","poem":2}]},{"type":"verse","number":28,"content":["هەموو ئەمانە دوازدە هۆزەکەی ئیسرائیلن. ئەمەش ئەوە بوو کە باوکیان پێی گوتن و داوای بەرەکەتی بۆ کردن، هەریەکەیان بەپێی بەرەکەتەکەی خۆی داوای بەرەکەتی بۆ کردن."]},{"type":"heading","content":["مردنی یاقوب"]},{"type":"verse","number":29,"content":["ئینجا فەرمانی پێدان و پێی گوتن: «من دەچمە پاڵ گەلەکەی خۆم. لەلای باوباپیرانم بمنێژن، لەو ئەشکەوتەی لەناو کێڵگەکەی عەفرۆنی حیتییە،"]},{"type":"verse","number":30,"content":["کە لە کێڵگەکەی مەخپێلەیە و ڕووەو مەمرێیە لە خاکی کەنعان، ئەوەی ئیبراهیم لەگەڵ کێڵگەکەدا لە عەفرۆنی حیتی کڕی تاکو بیکات بە گۆڕستان."]},{"type":"verse","number":31,"content":["ئیبراهیم و سارای ژنی لەوێ نێژراون، ئیسحاق و ڕڤقەی ژنیشی لەوێ نێژراون، هەر لەوێش لێئەم ناشت."]},{"type":"verse","number":32,"content":["کێڵگەکە و ئەشکەوتەکەی ناوی لە حیتییەکان کڕدرابوون.»"]},{"type":"verse","number":33,"content":["کاتێک یاقوب لە ڕاسپاردنی کوڕەکانی تەواو بوو، هەردوو پێی خۆی خستەوە سەر قەرەوێڵەکە و دواهەناسەی دا و چووەوە پاڵ گەلەکەی خۆی."]}],"footnotes":[{"noteId":120,"caller":"+","text":"‏مەبەست لە توندوتیژی شیمۆن و لێڤییە بەرامبەر بە خەڵکی شەخەم. بڕوانە 34‏:25‏.‏","reference":{"chapter":49,"verse":5}},{"noteId":121,"caller":"+","text":"وشەی (یەهودا) لە ڕووی دەنگەوە لە وشەی (ستایش)ی عیبری نزیکە.‏","reference":{"chapter":49,"verse":8}},{"noteId":122,"caller":"+","text":"پێشبینییەکە بۆ هاتنی مەسیح.‏","reference":{"chapter":49,"verse":10}},{"noteId":123,"caller":"+","text":"ڕەوانبێژی لێکچواندنە، مەبەستی یەزدانە.‏","reference":{"chapter":49,"verse":24}}]},"thisChapterLink":"/api/ckb_bib/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}