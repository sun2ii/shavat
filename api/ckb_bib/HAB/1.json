{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HAB","translationId":"ckb_bib","name":"حەبەقوق","commonName":"حەبەقوق","title":"حەبەقوق","order":35,"numberOfChapters":3,"sha256":"020b6efff34245c5b1e88965d3070a69aa18fb0d68997807fe9736845d099c9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ckb_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ئەو سروشەی",{"noteId":0},"کە بۆ حەبەقوقی پێغەمبەر هات."]},{"type":"line_break"},{"type":"heading","content":["سکاڵای حەبەقوق"]},{"type":"verse","number":2,"content":[{"text":"ئەی یەزدان، هەتا کەی هانات بۆ بهێنم و","poem":1},{"text":"تۆش گوێ ناگریت؟","poem":2},{"text":"هەتا کەی لە دەست ستەم هاوارت بۆ دەهێنم و","poem":1},{"text":"تۆش ڕزگار ناکەیت؟","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بۆ چی ناڕەواییم پیشان دەدەیت؟","poem":1},{"text":"بۆ چی بەرگەی خراپە دەگریت؟","poem":2},{"text":"وێرانکردن و ستەم لەبەردەممە،","poem":1},{"text":"ناکۆکی و ڕکابەری سەرهەڵدەدات.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لەبەر ئەوە تەورات لەکارخراوە و","poem":1},{"text":"دادپەروەری قەد سەرکەوتوو نابێت.","poem":2},{"text":"خراپەکار گەمارۆی کەسی ڕاستودروستی دا،","poem":1},{"text":"لەبەر ئەوە دادپەروەری دەشێوێنرێت.","poem":2}]},{"type":"heading","content":["وەڵامی یەزدان"]},{"type":"verse","number":5,"content":[{"text":"«تەماشای نەتەوەکان بکەن و سەرنج بدەن،","poem":1},{"text":"بە تەواوی سەرسام بن،","poem":2},{"text":"چونکە لە سەردەمی ئێوەدا کارێکی وا دەکەم،","poem":1},{"text":"ئەگەر باس بکرێت باوەڕ ناکەن.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"من بابلییەکان","poem":1},{"noteId":1},{"text":"هەڵدەستێنمەوە،","poem":1},{"text":"گەلێکی دڵڕەق و بە پەلە،","poem":2},{"text":"بە فراوانی زەوی ڕێگای گرتووەتەبەر،","poem":1},{"text":"بۆ داگیرکردنی ئەو نشینگانەی کە هی خۆی نییە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"تۆقێنەر و ترسێنەرە،","poem":1},{"text":"خۆیان حوکم دادەنێن و","poem":2},{"lineBreak":true},{"text":"شکۆی خۆیان دەسەپێنن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەسپەکانیان لە پڵنگ بەتاوترن و","poem":1},{"text":"لە گورگی ئێواران توندوتیژترن،","poem":2},{"text":"سوارەکانی بە پڕتاوی","poem":1},{"text":"لە دوورەوە دێن،","poem":2},{"text":"وەک هەڵۆیەکی بە پەلە بۆ خواردن دەفڕن.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"هەموو بۆ ستەمکاری دێن،","poem":2},{"text":"ئاپۆرەکەیان وەک بای ڕۆژهەڵات بەرەو پێش دەچێت،","poem":1},{"text":"وەک لم دیل کۆدەکەنەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"گاڵتە بە پاشایان دەکەن و","poem":1},{"text":"میران دەکەنە گاڵتەجاڕ،","poem":2},{"text":"بە هەموو شارێکی قەڵابەند پێدەکەنن،","poem":1},{"text":"خۆڵ دەکەنە گرد و دەیگرن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئینجا وەک با هەڵدەکەن و دەڕۆن،","poem":1},{"text":"تاوانبارن، هێزی خۆیان دەپەرستن.»","poem":2}]},{"type":"heading","content":["دووەم سکاڵای حەبەقوق"]},{"type":"verse","number":12,"content":[{"text":"ئەی یەزدان، ئایا تۆ لە ئەزەلەوە نیت؟","poem":1},{"text":"خودای من، پیرۆزەکەم، تۆ هەرگیز نامریت.","poem":2},{"text":"ئەی یەزدان، بابلییەکانت بۆ جێبەجێکردنی حوکمەکانت دانا،","poem":1},{"text":"ئەی تاشەبەرد، ئەرکی سزادانت بەوان سپاردووە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"چاوەکانت لەوە پاکترن تەماشای خراپە بکەن،","poem":1},{"text":"ناتوانیت بەرگەی خراپەکاری بگریت.","poem":2},{"text":"کەواتە بۆچی بەرگەی ناپاکەکان دەگریت؟","poem":1},{"text":"بۆچی بێدەنگ دەبیت کاتێک بەدکار کەسێکی لە خۆی ڕاستودروستتر قووت دەدات؟","poem":2}]},{"type":"verse","number":14,"content":[{"text":"مرۆڤ وەک ماسی دەریا لێدەکەیت،","poem":1},{"text":"وەک بوونەوەری ئاوی کە فەرمانڕەوای نییە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"دوژمنی خراپەکار بە قولاپەکەی هەمووان سەردەخات،","poem":1},{"text":"بە تۆڕەکەی ڕاویان دەکات،","poem":2},{"text":"لەناو تۆڕەکەی کۆیان دەکاتەوە،","poem":1},{"text":"لەبەر ئەوە شاد و دڵخۆشە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"هەر لەبەر ئەوەش قوربانی بۆ تۆڕەکەی سەردەبڕێت و","poem":1},{"text":"بخووری بۆ دەسووتێنێت،","poem":2},{"text":"چونکە بەهۆی تۆڕەکەیەوە خۆش ڕادەبوێرێت و","poem":1},{"text":"خواردنەکەی چەورە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"هەتا کەی بەردەوام دەبێ لەوەی بە تۆڕەکەی ڕاو بکات،","poem":1},{"text":"بە بێ بەزەیی نەتەوەکان لەناوببات؟","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"فەرموودەیەکی خودایە کە لە ڕێگای ڕۆحی پیرۆزەوە بۆ مرۆڤ هاتبێت.‏","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"عیبری: کلدانییەکان؛ لەژێر سەرکردایەتی نەبوخودنەسری دووەم بوون.‏","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/ckb_bib/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}