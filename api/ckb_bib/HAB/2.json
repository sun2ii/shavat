{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HAB","translationId":"ckb_bib","name":"حەبەقوق","commonName":"حەبەقوق","title":"حەبەقوق","order":35,"numberOfChapters":3,"sha256":"020b6efff34245c5b1e88965d3070a69aa18fb0d68997807fe9736845d099c9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ckb_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"لە خاڵی چاودێریکردنەکەم دەوەستم و","poem":1},{"text":"سەردەکەومە سەر قوللەی چاودێری،","poem":2},{"text":"چاوەڕێ دەکەم تاکو بزانم یەزدان چیم پێ دەڵێت و","poem":1},{"text":"بۆ وەڵامی ئەو سکاڵایە چی بڵێم.","poem":2}]},{"type":"heading","content":["وەڵامی یەزدان"]},{"type":"verse","number":2,"content":["ئینجا یەزدان وەڵامی دامەوە و فەرمووی:",{"text":"«سروشەکە","poem":1},{"noteId":2},{"text":"بنووسەوە و","poem":1},{"text":"لەسەر تابلۆ هەڵیبکۆڵە،","poem":2},{"lineBreak":true},{"text":"تاکو پەیامنێر بە دروستی پەیامەکە بگەیەنێت،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"چونکە سروشەکە بۆ کاتی دیاریکراوە،","poem":1},{"text":"باسی کۆتایی دەکات و","poem":2},{"lineBreak":true},{"text":"درۆ ناکات.","poem":2},{"text":"ئەگەر درێژەی کێشا چاوەڕێی بکە،","poem":1},{"text":"چونکە بێگومان دێت و دواناکەوێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«تەماشا، دوژمن","poem":1},{"noteId":3},{"text":"خۆی گف کردووەتەوە،","poem":1},{"text":"ئارەزووەکانی ڕەوا نییە،","poem":2},{"lineBreak":true},{"text":"بەڵام کەسی ڕاستودروست بە باوەڕی خۆی دەژیێت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لە ڕاستیدا شەراب فریوی دەدات،","poem":1},{"text":"لەخۆباییە و هەرگیز هێور نابێتەوە،","poem":2},{"text":"چونکە وەک گۆڕ ئارەزووی بەرفراوانە،","poem":1},{"text":"وەک مردنە، هەرگیز تێر نابێت،","poem":2},{"text":"هەموو نەتەوەکان بۆ خۆی کۆدەکاتەوە و","poem":1},{"text":"هەموو گەلان بە دیل دەگرێت.","poem":2}]},{"type":"verse","number":6,"content":["«ئایا گەلەکان پەند و توانج لەو ناگرن، دەڵێن:",{"text":"«”قوڕبەسەر ئەوەی شتی دزراو کەڵەکە دەکات و","poem":1},{"text":"بە ستەمکاری خۆی دەوڵەمەند دەکات!","poem":2},{"lineBreak":true},{"text":"ئەو دۆخە هەتا کەی بەردەوام دەبێت؟“","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئایا قەرزدەرەکانت کتوپڕ لێت ڕاستنابنەوە؟","poem":1},{"text":"ئایا بەئاگا نایێن و ناتلەقێنن؟","poem":2},{"lineBreak":true},{"text":"ئینجا دەبیتە دەستکەوت بۆیان.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"لەبەر ئەوەی تۆ چەندین نەتەوەت تاڵان کرد،","poem":1},{"text":"ئەو گەلانەی کە ماونەتەوە تۆ تاڵان دەکەن،","poem":2},{"text":"لەبەر ئەوەی تۆ خوێنی مرۆڤت ڕشت،","poem":1},{"text":"تۆ خاک و شار و هەموو دانیشتووانەکەیت وێران کرد.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«قوڕبەسەر ئەوەی دەستکەوتی ناڕەوا بۆ ماڵەکەی بەدەستدەهێنێت و","poem":1},{"text":"هێلانەکەی لە بەرزایی دادەنێت،","poem":2},{"lineBreak":true},{"text":"تاکو لە چنگی خراپە دەرباز بێت!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"پیلانی ڕیشەکێشکردنی گەلانێکی زۆرت گێڕا،","poem":1},{"text":"شەرمەزاریت هێنایە سەر ماڵەکەت و خۆتت دۆڕاند.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لەبەر ئەوە بەرد لەناو دیوارەوە هاوار دەکات و","poem":1},{"text":"کاریتەش لە دارەوە دەنگ دەداتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«قوڕبەسەر ئەوەی بە خوێنڕشتن شار بنیاد دەنێت و","poem":1},{"text":"بە ستەمکاری شارۆچکە دادەمەزرێنێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئایا ئەوە لەلایەن یەزدانی سوپاسالارەوە نییە","poem":1},{"text":"کە ماندووبوونی گەلان تەنها بۆ ئاگر بێت،","poem":2},{"lineBreak":true},{"text":"شەکەتبوونی نەتەوەکان بێ سوود بێت؟","poem":2}]},{"type":"verse","number":14,"content":[{"text":"چونکە زەوی پڕ دەبێت لە ناسینی شکۆمەندی یەزدان،","poem":1},{"text":"هەروەک ئاو دەریا دادەپۆشێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«قوڕبەسەر ئەوەی شەراب دەرخواردی نزیکەکەی دەدات،","poem":1},{"text":"هەتا سەرخۆش دەبێت لە مەشکەکەوە بۆی تێدەکات،","poem":2},{"lineBreak":true},{"text":"تاکو جەستەیان بە ڕووتی ببینێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"تێردەبیت لە شەرمەزاری لە جیاتی شکۆمەندی.","poem":1},{"text":"ئێستا نۆرەی تۆیە! بینۆشە و ڕووت ببەوە،","poem":2},{"text":"جامی دەستی ڕاستی یەزدان دێتە سەر تۆ،","poem":1},{"text":"شەرمەزاریش شکۆی تۆ دادەپۆشێت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئەو ستەمەی لە لوبنانت کرد بەسەرت دێتەوە،","poem":1},{"text":"لەناوبردنی ئاژەڵەکانی دەتترسێنێت.","poem":2},{"text":"لەبەر ئەوەی تۆ خوێنی مرۆڤت ڕشت،","poem":1},{"text":"تۆ خاک و شار و هەموو دانیشتووانەکەیت وێران کرد.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«ئەو بتەی کە دەتاشرێت چ کەڵکێکی هەیە؟","poem":1},{"text":"یان ئەو پەیکەرە لەقاڵبدراوەی خەڵکی فێری درۆ دەکات؟","poem":2},{"text":"چونکە دروستکەرەکەی پشتی پێ دەبەستێت،","poem":1},{"text":"بتێکی دروستکردووە ناتوانێت قسە بکات.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"قوڕبەسەر ئەوەی بە تەختەدار دەڵێت: ”هەستە!“","poem":1},{"text":"بە بەردی بێ هەست و نەست: ”بە ئاگابە!“","poem":2},{"text":"ئایا دەتوانێت ڕێنمایی بکات؟","poem":1},{"text":"بە زێڕ و زیو ڕووکەش کراوە،","poem":2},{"lineBreak":true},{"text":"ڕۆحی تێدا نییە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"بەڵام یەزدان لەناو پەرستگای پیرۆزیدایە،","poem":1},{"text":"با هەموو دانیشتووانی زەوی لەبەردەمیدا بێدەنگ بن.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"فەرموودەیەکی خودایە کە لە ڕێگای ڕۆحی پیرۆزەوە بۆ مرۆڤ هاتبێت.‏","reference":{"chapter":2,"verse":2}},{"noteId":3,"caller":"+","text":"مەبەستی لە بابلییەکانە بڕوانە 1‏:13‏،15.‏","reference":{"chapter":2,"verse":4}}]},"thisChapterLink":"/api/ckb_bib/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}