{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HAB","translationId":"ckb_bib","name":"حەبەقوق","commonName":"حەبەقوق","title":"حەبەقوق","order":35,"numberOfChapters":3,"sha256":"020b6efff34245c5b1e88965d3070a69aa18fb0d68997807fe9736845d099c9d","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ckb_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["نوێژێکی حەبەقوق"]},{"type":"verse","number":1,"content":[{"text":"نوێژێکی حەبەقوقی پێغەمبەر. لەسەر ئاوازی «شگیانۆت»:","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"ئەی یەزدان، هەواڵی تۆم بیست،","poem":1},{"text":"ئەی یەزدان، لە کارەکانت ترسام،","poem":2},{"text":"لە سەردەمی ئێمە دووبارەیان بکەوە،","poem":1},{"text":"با لە سەردەمی ئێمە بزانرێن،","poem":2},{"lineBreak":true},{"text":"لە تووڕەییدا بەزەیی بهێنەرەوە یادت!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"خودا لە تێمانەوە هات،","poem":1},{"text":"پیرۆزەکە لە کێوی پارانەوە هات.","poem":2},{"noteId":4},{"text":"شکۆی ئەو ئاسمانی داپۆشیوە و","poem":1},{"text":"ستایشی ئەو زەوی پڕکردووە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"پڕشنگی ئەو وەک تیشکی بەرەبەیانە،","poem":1},{"text":"لە دەستیەوە ڕووناکی دەبارێت،","poem":2},{"lineBreak":true},{"text":"لەوێدا توانای شاردرابووەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"پەتا لەپێشیەوە ڕۆیشت،","poem":1},{"text":"گرانەتاش لەدوای هەنگاوەکانی ئەو بوو.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ڕاوەستا و زەوی هەژاند،","poem":1},{"text":"تەماشای کرد و هەموو گەلەکانی لەرزاند.","poem":2},{"text":"چیا دێرینەکان کوتران،","poem":1},{"text":"گردە لەمێژینەکان هاتنە خوارەوە،","poem":2},{"lineBreak":true},{"text":"بەڵام یەزدان جاویدانییە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"چادرەکانی کوشانم لە تەنگوچەڵەمەدا بینی،","poem":1},{"text":"ڕەشماڵەکانی میدیان دەلەرزین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ئەی یەزدان، ئایا جۆشی تووڕەیی تۆ لە ڕووبارەکان بوو؟","poem":1},{"text":"ئایا لە ڕووبارەکان تووڕە بوویت؟","poem":2},{"text":"ئایا هەڵچوونی تۆ لە دەریا بوو،","poem":1},{"text":"تاکو سواری ئەسپ بیت و","poem":2},{"lineBreak":true},{"text":"گالیسکەکانت بەرەو سەرکەوتن بچن؟","poem":2}]},{"type":"verse","number":9,"content":[{"text":"کەوانەکەی خۆتت ئامادە کرد و","poem":1},{"text":"داوای تیرێکی زۆرت کرد.","poem":2},{"text":"بە ڕووبارەکان زەویت شەقکردووە،","poem":1}]},{"type":"verse","number":10,"content":[{"text":"چیاکان تۆیان بینی و لەرزین،","poem":2},{"text":"لافاوی ئاوەکان تێپەڕین،","poem":1},{"text":"قووڵاییەکان دەنگیان هات،","poem":2},{"lineBreak":true},{"text":"شەپۆلەکانی بەرزبوونەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"خۆر و مانگ لە ئاسمان وەستان","poem":1},{"noteId":5},{"text":"،","poem":1},{"text":"بە بریسکانەوەی تیرە هاوێژراوەکانت،","poem":2},{"lineBreak":true},{"text":"بە درەوشانەوەی ڕمە پڕشنگدارەکەت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بە تووڕەییەوە لەسەر زەوی گەڕایت،","poem":1},{"text":"بە تووڕەییەوە نەتەوەکانت وردوخاش کرد.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بۆ ڕزگارکردنی گەلەکەت هاتییە دەرەوە،","poem":1},{"text":"بۆ ڕزگارکردنی دەستنیشانکراوەکەت.","poem":2},{"text":"سەرۆکی وڵاتی بەدکارت وردوخاش کرد،","poem":1},{"text":"لە سە