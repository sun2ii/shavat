{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HEB","translationId":"ckb_bib","name":"عیبرانییەکان","commonName":"عیبرانییەکان","title":"نامە بۆ عیبرانییەکان","order":58,"numberOfChapters":13,"sha256":"28283af8e13aff0b4242e0de51dd9cc13c0958d8b047564c44514d10f64bec40","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/ckb_bib/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["پایەبەرزی عیسای مەسیح"]},{"type":"verse","number":1,"content":["لە سەردەمانی کۆنەوە خودا زۆر جار و بە ڕێگای جۆراوجۆر بەهۆی پێغەمبەرانەوە لەگەڵ باوباپیراندا دواوە،"]},{"type":"verse","number":2,"content":["بەڵام لەم ڕۆژانەی کۆتاییدا بەهۆی کوڕەکەیەوە لەگەڵمان دوا، ئەوەی دەستنیشانی کردووە وەک میراتگری هەموو شتێک و لە ڕێگەی ئەویشەوە گەردوونی دروستکردووە."]},{"type":"verse","number":3,"content":["کوڕەکە تیشکی شکۆی خودایە و بە تەواوی وێنەی کڕۆکیەتی",{"noteId":0},"، هەڵگری هەموو شتێکە بە هێزی فەرمایشتی خۆی، لەدوای ئەوەی هەموو گوناهەکانی پاک کردەوە، لە دەستەڕاستی خودای مەزن لە ئاسمان دانیشت."]},{"type":"verse","number":4,"content":["بەم شێوەیە کوڕەکە لە فریشتەکان پایەبەرزتر بوو، بەو ئەندازەیەی ناوێکی بە میرات بۆ مایەوە زۆر لەوان شکۆدارتر."]},{"type":"verse","number":5,"content":["ئیتر چ جارێک خودا بە کام لە فریشتەکانی فەرمووە:",{"text":"﴿تۆ کوڕی منی،","poem":1},{"text":"من ئەمڕۆ بوومە باوکت﴾","poem":2},{"noteId":1},{"text":"؟","poem":2},"هەروەها:",{"text":"﴿من دەبمە باوکی ئەو و","poem":1},{"text":"ئەویش دەبێتە کوڕی من﴾","poem":2},{"noteId":2},{"text":"؟","poem":2}]},{"type":"verse","number":6,"content":["دیسان کاتێک خودا نۆبەرەکەی دەهێنێتە جیهانەوە، دەفەرموێت:",{"text":"﴿با هەموو فریشتەی خودا کڕنۆشی بۆ ببەن.﴾","poem":1},{"noteId":3}]},{"type":"verse","number":7,"content":["لەبارەی فریشتەش دەفەرموێ:",{"text":"﴿خودا وا لە فریشتەکانی دەکات وەک با بن،","poem":1},{"text":"خزمەتکارەکانیشی وەک بڵێسەی ئاگر.﴾","poem":2},{"noteId":4}]},{"type":"verse","number":8,"content":["بەڵام لەبارەی کوڕەکەوە دەفەرموێت:",{"text":"﴿ئەی خودایە، تەختی تۆ بۆ هەتاهەتاییە،","poem":1},{"text":"داردەستی شانشینیت داردەستی دادپەروەرییە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"تۆ حەزت لە ڕاستودروستی کردووە و ڕقت لە خراپە بووەوە،","poem":1},{"text":"بۆیە خودا، خودای خۆت لە سەرووی هاوەڵەکانتەوە داینای،","poem":2},{"lineBreak":true},{"text":"بە ڕۆنی شادی دەستنیشانی","poem":2},{"noteId":5},{"text":"کردیت.﴾","poem":2},{"noteId":6}]},{"type":"verse","number":10,"content":["هەروەها:",{"text":"﴿تۆ یەزدان، لە سەرەتاوە بناغەی زەویت دانا،","poem":1},{"text":"ئاسمانیش دەستکردی تۆیە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەوان لەناودەچن، بەڵام تۆ دەمێنیت،","poem":1},{"text":"هەموو وەک کراس کۆن دەبن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"وەک کەوا دەیپێچیتەوە،","poem":1},{"text":"وەک بەرگی کۆن دەگۆڕدرێن،","poem":2},{"text":"بەڵام تۆ هەروەک خۆتی،","poem":1},{"text":"ساڵانی تۆ کۆتایی نایەت.﴾","poem":2},{"noteId":7}]},{"type":"verse","number":13,"content":["ئایا خودا چ جارێک بە کام لە فریشتەکانی فەرمووە:",{"text":"﴿لە دەستەڕاستم دابنیشە","poem":1},{"text":"هەتا دوژمنانت دەکەمە تەختەپێ","poem":2},{"noteId":8},{"text":"بۆ پێیەکانت﴾","poem":2},{"noteId":9},{"text":"؟","poem":2}]},{"type":"verse","number":14,"content":["ئایا هەموویان ڕۆحی خزمەتکارانە نین کە نێردراون بۆ خزمەتی ئەوانەی لە داهاتوو ڕزگاری بە میرات دەگرن؟"]}],"footnotes":[{"noteId":0,"caller":"+","text":"وێنەی کڕۆکیەتی: مەبەستی لەوەیە کە مەسیح دەربڕینێکی ڕاستەقینەی ناخی خودایە.‏","reference":{"chapter":1,"verse":3}},{"noteId":1,"caller":"+","text":"زەبوورەکان 2‏:7.‏‏","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"دووەم ساموئێل 7‏:14 و یەکەم پوختەی مێژوو 17‏:13.‏‏","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"+","text":"لە وەرگێڕانی یۆنانی بۆ پەیمانی کۆن، دواوتار 32‏:43‏.‏","reference":{"chapter":1,"verse":6}},{"noteId":4,"caller":"+","text":"زەبوورەکان 104‏:4.‏‏","reference":{"chapter":1,"verse":7}},{"noteId":5,"caller":"+","text":"لە پەیمانی کۆن داود لەلایەن ساموئێلەوە چەورکرا کە هەڵبژاردەی خودایە، ئەم چەورکردنەش وەک نەریتێک بەردەوام بوو بۆ ڕزگاریی خودا.‏","reference":{"chapter":1,"verse":9}},{"noteId":6,"caller":"+","text":"زەبوورەکان 45‏:6‏،7‏‏.‏","reference":{"chapter":1,"verse":9}},{"noteId":7,"caller":"+","text":"زەبوورەکان 102‏:25‏-27.‏‏","reference":{"chapter":1,"verse":12}},{"noteId":8,"caller":"+","text":"بەهۆی ئەوەی پاشا کورسییەکەی بەرز بووە، تەختەیەک لەژێر پێی دانراوە کە وێنەی دوژمنەکانی لەسەر کێشراوە، وەک هێمایەک بۆ خستنە ژێر پێیان.‏","reference":{"chapter":1,"verse":13}},{"noteId":9,"caller":"+","text":"زەبوورەکان 110‏:1.‏‏","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/ckb_bib/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}