ەکی ژەهراوی نێو زەوییەکی کێڵدراو دەڕوێت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"خەڵکی سامیرە ترسیان هەیە","poem":1},{"text":"لەو بتە گوێرەکەیەی کە لە شاری بێت‌ئاڤنە","poem":2},{"noteId":17},{"text":".","poem":2},{"text":"گەلەکەی و کاهینە بتپەرستەکانیشی","poem":1},{"text":"لەبەر شکۆمەندییەکەی ئاهەنگیان دەگێڕا،","poem":2},{"text":"بەڵام لە داهاتوودا شینی بۆ دەگێڕن،","poem":1},{"text":"چونکە بۆ ڕاپێچ لێیان وەرگیراوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەویش بۆ ئاشور دەبردرێت،","poem":1},{"text":"وەک سەرانە بۆ پاشای شەڕانگێز.","poem":2},{"text":"ئەفرایم سەرشۆڕی وەردەگرێت و","poem":1},{"text":"ئیسرائیلیش لەسەر بتە دارینەکانی شەرمەزار دەبێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"سامیرە و پاشاکەی لەناودەچن،","poem":1},{"text":"وەک چیلکە دار بەسەر ڕووی ئاوەوە دوور دەکەونەوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"نزرگەکانی سەر بەرزاییەکانی بەدکاری","poem":1},{"noteId":18},{"text":"وێران دەبن،","poem":1},{"text":"کە گوناهی ئیسرائیلن،","poem":2},{"text":"دڕکوداڵ لەسەر قوربانگاکانیان دەڕوێن.","poem":1},{"text":"ئەو کاتە بە چیاکان دەڵێن، «دامانپۆشن!» و","poem":2},{"lineBreak":true},{"text":"بە گردەکانیش دەڵێن، «بەسەرماندا بڕووخێن!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«ئەی ئیسرائیل، لە سەردەمی گیڤعاوە گوناهت کرد،","poem":1},{"text":"لەوێدا وەستان،","poem":2},{"lineBreak":true},{"text":"لە گیڤعادا شەڕ نەوەی بەدکارانی نەگرتەوە؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"کەی بمەوێت تەمبێیان دەکەم،","poem":1},{"text":"گەلان گەلەکۆمەیان لێ دەکەن،","poem":2},{"lineBreak":true},{"text":"کاتێک بە دوو تاوانەکەیانەوە بەندن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەفرایم گوێرەکەیەکی","poem":1},{"noteId":19},{"text":"ڕاهێنراوە","poem":1},{"text":"حەز لە گێرەکردن دەکات.","poem":2},{"text":"لەبەر ئەوە من نیر دەخەمە سەر ملە جوانەکەی،","poem":1},{"text":"سوار دەخەمە سەر ئەفرایم،","poem":2},{"text":"یەهودا دەیکێڵێت،","poem":1},{"text":"یاقوبیش خەرتەی دەکات.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ڕاستودروستی بۆ خۆتان بچێنن و","poem":1},{"text":"بەروبوومی خۆشەویستی نەگۆڕ بدوورنەوە.","poem":2},{"text":"بۆ خۆتان بەیارێک بکێڵن،","poem":1},{"text":"چونکە کاتی ئەوەیە ڕوو لە یەزدان بکەن،","poem":2},{"lineBreak":true},{"text":"هەتا بێت و ڕاستودروستیتان بەسەردا ببارێنێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بەڵام ئێوە خراپەتان چاند و","poem":1},{"text":"بەدڕەفتاریتان دوورییەوە،","poem":2},{"lineBreak":true},{"text":"بەروبوومی درۆتان خوارد،","poem":2},{"text":"چونکە پشتت بە هێزی خۆت و","poem":1},{"text":"بە زۆری پاڵەوانەکانت بەست،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"چەخماخەی جەنگ لە دژی گەلەکەت بەرز دەبێتەوە.","poem":1},{"text":"هەموو قەڵاکانت تێکدەدرێن،","poem":2},{"text":"وەک چۆن شەلمەن لە ڕۆژی جەنگدا بێت‌ئەربێلی","poem":1},{"noteId":20},{"text":"تێکدا،","poem":1},{"text":"دایک لەگەڵ منداڵەکانیدا بەزەویدا کێشران.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەی بێت‌ئێل، ئاواتان پێ دەکرێت،","poem":1},{"text":"لەبەر ئەوەی خراپەکەتان گەورەیە.","poem":2},{"text":"لە بەرەبەیاندا،","poem":1},{"text":"پاشای ئیسرائیل بە تەواوی لەناودەچێت.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"واتا (ماڵی بەدکاری)، هەروەها بێت‌ئێل واتا (ماڵی خودا).‏","reference":{"chapter":10,"verse":5}},{"noteId":18,"caller":"+","text":"بەدکاری: عیبری ئاڤن‏، مەبەست لە بێت‌ئاڤنە، کە ناوێکی سووکە بۆ بێت‌ئێل.‏","reference":{"chapter":10,"verse":8}},{"noteId":19,"caller":"+","text":"گوێرەکەیەک: واتا عیبرییەکەی گوێرەکەیەکی مێینەی سێ ساڵە.‏","reference":{"chapter":10,"verse":11}},{"noteId":20,"caller":"+","text":"هەولێر.‏","reference":{"chapter":10,"verse":14}}]},"thisChapterLink":"/api/ckb_bib/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}