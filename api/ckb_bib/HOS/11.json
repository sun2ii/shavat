{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HOS","translationId":"ckb_bib","name":"هۆشەع","commonName":"هۆشەع","title":"هۆشەع","order":28,"numberOfChapters":14,"sha256":"9449abd5eac42d8e8ba79b9cebb098fdb1fb4a3c5cb5c307418ad215c7a3f70b","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ckb_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["خۆشەویستی خودا بۆ ئیسرائیل"]},{"type":"verse","number":1,"content":[{"text":"«کە ئیسرائیل منداڵ بوو، خۆشم ویست و","poem":1},{"text":"من کوڕی خۆمم لە میسر بانگ کرد.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بەڵام هەرچەندەی بانگم دەکردن،","poem":1},{"text":"ئەوەندە منیان لە خۆیان دوورخستەوە،","poem":2},{"text":"قوربانییان بۆ بەعلەکان سەردەبڕی و","poem":1},{"text":"بخووریان بۆ وێنەی خوداوەندەکان دەسووتاند.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"من بووم ئەفرایمم فێری ڕۆیشتن کرد،","poem":1},{"text":"دەستم بە باڵیانەوە گرت،","poem":2},{"lineBreak":true},{"text":"بەڵام نەیانزانی من چاکم کردنەوە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بە گوریسی نەرمونیانی مرۆڤانە ڕایاندەکێشم،","poem":1},{"text":"بە بەستنی خۆشەویستی،","poem":2},{"text":"من بۆیان بووم بەوەی کە نیر لەسەر ملیان هەڵدەگرێت،","poem":1},{"text":"چەمامەوە بۆ ئەوەی نانیان بدەمێ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ئایا ناگەڕێنەوە بۆ خاکی میسر و","poem":1},{"text":"ئاشور نابێتە پاشایان،","poem":2},{"lineBreak":true},{"text":"چونکە ڕەتیان کردەوە بگەڕێنەوە لام؟","poem":2}]},{"type":"verse","number":6,"content":[{"text":"شمشێر دەکەوێتە شارەکانیان و","poem":1},{"text":"شەوبەندی دەروازەکانیان تێکدەشکێنێت،","poem":2},{"lineBreak":true},{"text":"کۆتایی بە تەگبیرەکانیان دەهێنێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"گەلەکەم مکوڕن لەسەر هەڵگەڕانەوە لە من.","poem":1},{"text":"تەنانەت ئەگەر هاوار بۆ خودای هەرەبەرزەکەش بکەن،","poem":2},{"lineBreak":true},{"text":"ئەو پایەبەرزیان ناکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ئەی ئەفرایم، چۆن وازت لێ بهێنم؟","poem":1},{"text":"ئەی ئیسرائیل، چۆن بە دەستتەوە بدەم؟","poem":2},{"text":"چۆن وەک ئەدما هەڵسوکەوتت لەگەڵدا بکەم؟","poem":1},{"text":"چۆن وەک چەبۆئیمت لێبکەم؟","poem":2},{"text":"دڵم لێم هەڵگەڕاوەتەوە و","poem":1},{"text":"هەموو میهرەبانیم گڕی گرتووە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"گڕی تووڕەییم ناخەمەگەڕ و","poem":1},{"text":"ناگەڕێمەوە ئەفرایم وێران بکەم،","poem":2},{"text":"چونکە من خودام نەک مرۆڤ،","poem":1},{"text":"من خودا پیرۆزەکەم، لە ناوەڕاستی ئێوەدام،","poem":2},{"lineBreak":true},{"text":"بە قینەوە نایەم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لەدوای یەزدانەوە دەڕۆن،","poem":1},{"text":"وەک شێرێک دەنەڕێنێت.","poem":2},{"text":"کاتێک دەنەڕێنێت،","poem":1},{"text":"منداڵەکان لە ڕۆژئاواوە بە لەرزەوە دێن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"وەک چۆلەکە لە میسرەوە بە لەرزەوە دێن،","poem":1},{"text":"وەک کۆتر لە خاکی ئاشورەوە.","poem":2},{"text":"ئینجا لە ماڵەکانیاندا نیشتەجێیان دەکەم.»","poem":1},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":3}]},{"type":"heading","content":["گوناهی ئیسرائیل"]},{"type":"verse","number":12,"content":[{"text":"ئەفرایم بە درۆ دەوری لێدام و","poem":1},{"text":"بنەماڵەی ئیسرائیلیش بە فێڵەوە،","poem":2},{"text":"یەهوداش هێشتا سەرسەختە بەرامبەر بە خودا،","poem":1},{"text":"لە پیرۆزە دڵسۆزەکە.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}