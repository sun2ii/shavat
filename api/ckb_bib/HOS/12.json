{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HOS","translationId":"ckb_bib","name":"هۆشەع","commonName":"هۆشەع","title":"هۆشەع","order":28,"numberOfChapters":14,"sha256":"9449abd5eac42d8e8ba79b9cebb098fdb1fb4a3c5cb5c307418ad215c7a3f70b","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ckb_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"ئەفرایم لەسەر با دەلەوەڕێت،","poem":1},{"text":"دوای بای ڕۆژهەڵات کەوتووە،","poem":2},{"lineBreak":true},{"text":"هەموو ڕۆژێک درۆ و توندوتیژی زیاد دەکات.","poem":2},{"text":"لەگەڵ ئاشوردا پەیمان دەبەستن و","poem":1},{"text":"زەیتی زەیتوون بۆ میسر دەنێرێت.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"یەزدان لە دژی یەهودا سکاڵای هەیە،","poem":1},{"text":"سزای یاقوب بەپێی ڕەفتارەکەی دەدات،","poem":2},{"lineBreak":true},{"text":"کردەوەکانی بەسەر خۆیدا دەداتەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لەناو سکدا پاژنەی براکەی گرت و","poem":1},{"text":"بە هێزی خۆی لەگەڵ خودا کەوتە زۆرانێ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لەگەڵ فریشتەکە زۆرانێی کرد و سەرکەوت،","poem":1},{"text":"گریا و پاڕایەوە، بۆ ئەوەی لەگەڵی میهرەبان بێت.","poem":2},{"text":"لە بێت‌ئێل تووشی بوو،","poem":1},{"text":"لەوێ قسەی لەگەڵی کرد","poem":2},{"noteId":21},{"text":".","poem":2}]},{"type":"verse","number":5,"content":[{"text":"یەزدانی پەروەردگاری سوپاسالار،","poem":1},{"text":"ناوبانگی یەزدانە!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"تۆش بۆ لای خودات بگەڕێوە،","poem":1},{"text":"خۆشەویستی نەگۆڕ و دادپەروەری پەیڕەو بکە و","poem":2},{"lineBreak":true},{"text":"هەمیشە چاوەڕوانی خودای خۆت بە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"بازرگان تەرازووی ساختەی لە دەستدایە،","poem":1},{"text":"حەز دەکات ستەم بکات.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەفرایم گوتی:","poem":1},{"text":"«من دەوڵەمەند بووم و سامانم بۆ خۆم پێکەوەنا،","poem":2},{"text":"لە هەموو سامانەکەم خراپەیەکم تێدا نابیننەوە","poem":1},{"text":"کە گوناه بێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«من یەزدانی پەروەردگاری ئێوەم،","poem":1},{"text":"ئەوەی لە خاکی میسرەوە تۆی دەرهێنا،","poem":2},{"text":"دووبارە لەناو چادرەکان نیشتەجێت دەکەم،","poem":1},{"text":"وەک ڕۆژانی جەژن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"قسەم لەگەڵ پێغەمبەرەکاندا کرد و","poem":1},{"text":"بینینی زۆرم بۆ ئاشکرا کردن،","poem":2},{"lineBreak":true},{"text":"هەروەها لە ڕێگەی پێغەمبەرانەوە نموونەم هێنایەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ئایا خراپەکاری لە گلعاد هەیە؟","poem":1},{"text":"بێگومان دانیشتووانەکەی پووچن!","poem":2},{"text":"لە گلگال گا دەکەن بە قوربانی،","poem":1},{"text":"بەڵێ، بەڵام قوربانگاکانیان وەک کۆمەڵە بەرد دەبن","poem":2},{"lineBreak":true},{"text":"لەسەر هێڵەکانی جووتی کێڵگەدا.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"یاقوب بۆ دەشتودەری ئارام","poem":1},{"noteId":22},{"text":"هەڵات و","poem":1},{"text":"ئیسرائیل لە پێناوی ژنێکدا خزمەتی کرد،","poem":2},{"lineBreak":true},{"text":"لە پێناوی ژنێکدا شوانایەتی کرد.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"یەزدان لە ڕێگەی پێغەمبەرێکەوە ئیسرائیلی لە میسر دەرهێنا و","poem":1},{"text":"لە ڕێگەی پێغەمبەرێکیشەوە چاودێری کرد.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"بەڵام ئەفرایم زۆر بە خراپی یەزدانی پەست کرد،","poem":1},{"text":"پەروەردگارەکەشی تاوانی ئەو خوێنەی لەسەریەتی دەیهێڵێتەوە و","poem":2},{"lineBreak":true},{"text":"سووکایەتییەکەی بەسەر خۆیدا دەداتەوە.","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"قسەی لەگەڵیدا کرد: بڕوانە، بۆ نموونە، پەیدابوون 32‏:30‏‏.‏","reference":{"chapter":12,"verse":4}},{"noteId":22,"caller":"+","text":"میسۆپۆتامیا، وڵاتی نێوان دجلە و فورات. بڕوانە پەیدابوون 28‏:2‏‏.‏","reference":{"chapter":12,"verse":12}}]},"thisChapterLink":"/api/ckb_bib/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}