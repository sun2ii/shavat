{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HOS","translationId":"ckb_bib","name":"هۆشەع","commonName":"هۆشەع","title":"هۆشەع","order":28,"numberOfChapters":14,"sha256":"9449abd5eac42d8e8ba79b9cebb098fdb1fb4a3c5cb5c307418ad215c7a3f70b","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ckb_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["تووڕەیی یەزدان لەسەر ئیسرائیل"]},{"type":"verse","number":1,"content":[{"text":"کاتێک ئەفرایم قسەی کرد، لەرزین پەیدابوو،","poem":1},{"text":"ئەویش لە ئیسرائیلدا پایەدار بوو،","poem":2},{"lineBreak":true},{"text":"بەڵام خۆی تاوانبار کرد بە پەرستنی بەعل و مرد.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئێستا گوناهیان زیاتر و زیاتر دەکەن،","poem":1},{"text":"لە زیوەکانیان بتی لەقاڵبدراو بۆ خۆیان دروستدەکەن،","poem":2},{"text":"بتی دروستکراو بەپێی تێگەیشتنی خۆیان،","poem":1},{"text":"هەمووی دەستکردی وەستایە.","poem":2},{"text":"دەربارەیان دەڵێن:","poem":1},{"text":"«ئەوانە مرۆڤ دەکەنە قوربانی،","poem":2},{"lineBreak":true},{"text":"بتە گوێرەکەکان ماچ دەکەن!»","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لەبەر ئەوە وەک هەوری بەیانییان دەبن و","poem":1},{"text":"وەک ئەو شەونمەی بە زوویی دەڕوات،","poem":2},{"text":"وەک پووشی جۆخین کە دەدرێت بەدەم باوە،","poem":1},{"text":"وەک دووکەڵ لە کڵاوڕۆژنەوە","poem":2},{"noteId":23},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«بەڵام من یەزدانی پەروەردگارتم،","poem":1},{"text":"ئەوەی لە خاکی میسر دەریهێنایت.","poem":2},{"text":"جگە لە من دان بە هیچ خودایەکی دیکەدا نانێیت،","poem":1},{"text":"جگە لە منیش هیچ خودایەک ڕزگارکەر نییە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"من لە چۆڵەوانیدا چاودێری تۆم کرد،","poem":1},{"text":"لە زەوی تینووێتی.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"کاتێک لە لەوەڕ تێربوون،","poem":1},{"text":"کە تێربوون دڵیان بەفیز بوو،","poem":2},{"lineBreak":true},{"text":"لەبەر ئەوە منیان لەیاد کرد.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"جا وەک شێر دەبم بۆیان،","poem":1},{"text":"وەک پڵنگ لەسەر ڕێگا خۆم مات دەکەم.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"وەک ورچێکی جەرگسووتاو پەلاماریان دەدەم و","poem":1},{"text":"پەردەی دڵیان دەدڕێنم.","poem":2},{"text":"وەک شێرە مێ لەوێ دەیانخۆم،","poem":1},{"text":"ئاژەڵی کێوی پارچەپارچەیان دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«ئەی ئیسرائیل، تۆ لەناوچوویت،","poem":1},{"text":"چونکە تۆ لە دژی منیت، لە دژی یارمەتیدەری خۆتیت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئێستا کوا پاشاکەت؟","poem":1},{"text":"تاکو لە هەموو شارۆچکەکانت ڕزگارت بکات،","poem":2},{"text":"کوا ئەو فەرمانڕەوایانەی کە سەبارەت بەوان گوتت:","poem":1},{"text":"”پاشا و میرم بدەرێ“؟","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لە تووڕەییمدا پاشایەکم پێت دا و","poem":1},{"text":"لە هەڵچوونمدا بردمەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"تاوانەکانی ئەفرایم ئەمبار کراون،","poem":1},{"text":"گوناهەکانیشی تۆمارکراون.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ژانی منداڵبوون بەسەریدا دێت،","poem":1},{"text":"بەڵام منداڵێکی نەفامە،","poem":2},{"text":"چونکە لە کاتی خۆیدا نایەت و","poem":1},{"text":"لە منداڵدان ناترازێتە خوارەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«لە دەست جیهانی مردووان خۆمیان بۆ بەخت دەکەم،","poem":1},{"text":"لە مردن دەیانکڕمەوە.","poem":2},{"text":"ئەی مردن، کوا دەردەکانت؟","poem":1},{"text":"ئەی جیهانی مردووان، کوا وێرانکاریت؟","poem":2},{"lineBreak":true},{"text":"«میهرەبانی لە چاوەکانم شاردراونەتەوە،","poem":1}]},{"type":"verse","number":15,"content":[{"text":"هەرچەندە لەناو براکانیدا بە بەروبووم بوو.","poem":2},{"text":"بایەکی ڕۆژهەڵات دێت،","poem":1},{"text":"بای یەزدان لە چۆڵەوانی هەڵدەکات،","poem":2},{"text":"ئینجا کانییەکەی کوێردەبێتەوە و","poem":1},{"text":"سەرچاوەکەی بێ ئاو دەبێت.","poem":2},{"text":"گەنجینەی هەموو کەلوپەلە بەنرخەکانی","poem":1},{"text":"تاڵان دەکرێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"خەڵکی سامیرە تاوانبار دەکرێن،","poem":1},{"text":"چونکە لە خودای خۆیان یاخی بوون،","poem":2},{"text":"بە شمشێر دەکوژرێن و","poem":1},{"text":"منداڵەکانیان تێکدەشکێنرێن،","poem":2},{"lineBreak":true},{"text":"سکی سکپڕان هەڵدەدڕێت.»","poem":2}]}],"footnotes":[{"noteId":23,"caller":"+","text":"وەک پەنجەرەیە، دەلاقەیەکە بۆ هاتوچۆی هەوا و گێڕانەوەی تیشکی خۆر.‏","reference":{"chapter":13,"verse":3}}]},"thisChapterLink":"/api/ckb_bib/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}