{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HOS","translationId":"ckb_bib","name":"هۆشەع","commonName":"هۆشەع","title":"هۆشەع","order":28,"numberOfChapters":14,"sha256":"9449abd5eac42d8e8ba79b9cebb098fdb1fb4a3c5cb5c307418ad215c7a3f70b","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ckb_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["تۆبەکردن بۆ وەرگرتنی بەرەکەت"]},{"type":"verse","number":1,"content":[{"text":"ئەی ئیسرائیل، بۆ لای یەزدانی پەروەردگاری خۆتان بگەڕێنەوە،","poem":1},{"text":"چونکە بە تاوانی خۆتان تێکشکان!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەم قسانە لەگەڵ خۆتان ببەن و","poem":1},{"text":"بگەڕێنەوە لای یەزدان،","poem":2},{"text":"پێی بڵێن:","poem":1},{"text":"«لە هەموو تاوانێک خۆشبە و","poem":2},{"text":"بە چاکەی خۆت وەرمانبگرە،","poem":1},{"text":"بەروبوومی لێوەکانمان سوپاسکردنی تۆ دەبێت.","poem":2},{"noteId":24}]},{"type":"verse","number":3,"content":[{"text":"ئاشور ڕزگارمان ناکات.","poem":1},{"text":"سواری ئەسپ نابین،","poem":2},{"text":"جارێکی دیکە بە دەستکردەکانمان ناڵێین،","poem":1},{"text":"”خوداوەندەکانمان،“","poem":2},{"lineBreak":true},{"text":"چونکە لەلایەن تۆ هەتیو بەر بەزەیی دەکەوێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«من هەڵگەڕانەوەیان چاک دەکەمەوە،","poem":1},{"text":"بە دڵفراوانییەوە ئەوانم خۆشدەوێت،","poem":2},{"lineBreak":true},{"text":"چونکە تووڕەییم لەوان دامرکایەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بۆ ئیسرائیل وەک شەونم دەبم،","poem":1},{"text":"ئەویش وەک سەوسەن گوڵ دەکات و","poem":2},{"lineBreak":true},{"text":"وەک دار ئورزی لوبنان ڕەگ دادەکوتێت،","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"چڵەکانی درێژ دەبنەوە،","poem":2},{"text":"جوانییەکەی وەک دار زەیتوون دەبێت و","poem":1},{"text":"وەکو دار ئورزی لوبنان بۆندار دەبێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"نیشتەجێبووان لە سایەی سێبەرەکەی دەگەڕێنەوە.","poem":1},{"text":"وەک دانەوێڵە دەژیێتەوە و","poem":2},{"text":"وەک مێو دەگەشێتەوە.","poem":1},{"text":"ناوبانگی وەک شەرابی لوبنان دەبێت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەی ئەفرایم، لەمەولا چ پەیوەندییەکم بە بتەوە هەیە؟","poem":1},{"text":"من وەڵام دەدەمەوە و چاودێریت دەکەم،","poem":2},{"text":"من وەک دار سنەوبەرێکی سەوزم،","poem":1},{"text":"بەروبوومەکەت لەلایەن منەوەیە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"کێ دانایە و لە ئەمانە تێدەگات؟","poem":1},{"text":"کێ تێگەیشتووە و دەیانزانێت؟","poem":2},{"text":"چونکە ڕێگاکانی یەزدان ڕاستن و","poem":1},{"text":"ڕاستودروستان پێیدا دەڕۆن،","poem":2},{"lineBreak":true},{"text":"بەڵام یاخیبووەکان ساتمەی تێدا دەکەن و دەکەون.","poem":2}]}],"footnotes":[{"noteId":24,"caller":"+","text":"لێوەکانمان ستایشی تۆ دەکەن، بڕوانە عیبرانییەکان 13‏:15‏‏.‏","reference":{"chapter":14,"verse":2}}]},"thisChapterLink":"/api/ckb_bib/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}