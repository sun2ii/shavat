{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HOS","translationId":"ckb_bib","name":"هۆشەع","commonName":"هۆشەع","title":"هۆشەع","order":28,"numberOfChapters":14,"sha256":"9449abd5eac42d8e8ba79b9cebb098fdb1fb4a3c5cb5c307418ad215c7a3f70b","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ckb_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["«بە براکانتان بڵێن: ”گەلی من،“ و بە خوشکەکانتان: ”بەر بەزەیی کەوتوو.“"]},{"type":"heading","content":["سزادان و چاککردنەوەی ئیسرائیل"]},{"type":"verse","number":2,"content":["«سەرزەنشتی دایکتان بکەن، سەرزەنشتی بکەن،",{"text":"چونکە ئەو ژنی من نییە و","poem":2},{"lineBreak":true},{"text":"منیش مێردی ئەو نیم.","poem":2},{"text":"بەدڕەوشتی لە ڕوخساری و","poem":1},{"text":"ناپاکی لەنێوان مەمکەکانی داماڵێت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئەگینا ڕووتوقووتی دەکەمەوە،","poem":1},{"text":"وەک ئەو ڕۆژە ڕایدەگرم کە تێیدا لەدایک بووە؛","poem":2},{"text":"وەک چۆڵەوانی لێ دەکەم،","poem":1},{"text":"وەک خاکی وشکی لێ دەکەم،","poem":2},{"lineBreak":true},{"text":"بە تینووێتی دەیمرێنم.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بەزەییم بە منداڵەکانیدا نایەتەوە،","poem":1},{"text":"چونکە زۆڵن.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بێگومان دایکیان داوێنپیسی کردووە و","poem":1},{"text":"بە بێ ئابڕوویی سکی پێیان پڕ بووە.","poem":2},{"text":"ئەو گوتی: ”دوای دۆستەکانم دەکەوم،","poem":1},{"text":"ئەوانەی نان و ئاو،","poem":2},{"lineBreak":true},{"text":"خوری و کەتان، زەیت و خواردنەوەم پێدەدەن.“","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لەبەر ئەوە ڕێگاکەی بە دڕک پەرژین دەکەم،","poem":1},{"text":"دیوارێک بە دەوریدا دروستدەکەم بۆ ئەوەی ڕێڕەوەکانی نەدۆزێتەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"دوای دۆستەکانی دەکەوێت و پێیان ناگات،","poem":1},{"text":"بەدوایاندا دەگەڕێت و نایاندۆزێتەوە.","poem":2},{"text":"ئینجا دەڵێت:","poem":1},{"text":"”دەچم و وەک جاران دەگەڕێمەوە بۆ لای مێردەکەم،","poem":2},{"lineBreak":true},{"text":"چونکە ئەو کاتم لە ئێستام باشتر بوو.“","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەو دانی پێدا نەناوە ئەوە من بووم کە","poem":1},{"text":"دانەوێڵە و شەرابی نوێ و زەیتم پێیداوە،","poem":2},{"text":"زێڕ و زیوم بۆی زیاد کردووە،","poem":1},{"text":"بەڵام ئەوان بۆ بەعل بەکاریانهێنا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«لەبەر ئەوە دەگەڕێمەوە و دانەوێڵەکەم لە کاتی خۆیدا دەبەمەوە،","poem":1},{"text":"شەرابە تازەکەشم لە کاتی خۆیدا.","poem":2},{"text":"خوری و کەتانەکەم کە ڕووتییەکەی دادەپۆشن","poem":1},{"text":"لەبەری دادەکەنم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئێستا شوێنی شەرمی","poem":1},{"text":"لەبەرچاوی خۆشەویستەکانیدا دەردەخەم،","poem":2},{"lineBreak":true},{"text":"کەسیش لە دەستم فریای ناکەوێت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"هەموو خۆشییەکانی ڕادەگرم:","poem":1},{"text":"جەژن و سەرەمانگەکانی،","poem":2},{"lineBreak":true},{"text":"شەممە و جەژنە دیاریکراوەکانی.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ڕەزەمێو و هەنجیرەکانی تێکدەدەم،","poem":1},{"text":"کە گوتی: ”ئەوانە کرێیەکەی منن، خۆشەویستانم پێیان داوم.“","poem":2},{"text":"دەیانکەم بە دارستان و","poem":1},{"text":"ئاژەڵی کێوی دەیانخوات.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لەسەر ئەو ڕۆژانەی سزای دەدەم","poem":1},{"text":"کە بخووری بۆ بەعلەکان دەسووتاند،","poem":2},{"text":"بە خەزێم و خشڵەکانی خۆی دەڕازاندەوە،","poem":1},{"text":"دوای خۆشەویستانی کەوت،","poem":2},{"lineBreak":true},{"text":"بەڵام منی لەیاد کرد.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«لەبەر ئەوە بە زمانی شیرین","poem":1},{"text":"دەیبەمە چۆڵەوانی و","poem":2},{"lineBreak":true},{"text":"بە نەرمی قسەی لەگەڵدا دەکەم.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"لەوێ ڕەزەمێوەکانی دەدەمەوە،","poem":1},{"text":"دۆڵی عاخۆر","poem":2},{"noteId":3},{"text":"دەکەم بە دەرگای هیوا.","poem":2},{"text":"لەوێ وەک ڕۆژانی هەرزەکاری گۆرانی دەڵێت،","poem":1},{"text":"وەک ڕۆژی سەرکەوتنی لە خاکی میسرەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"یەزدان دەفەرموێت: «لەو ڕۆژەدا دەبێت،","poem":1},{"text":"پێم دەڵێیت: ”مێردەکەم“ و","poem":2},{"lineBreak":true},{"text":"چیتر پێم ناڵێیت: ”گەورەم.“","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ناوی بەعلەکان لە دەمی دادەماڵم و","poem":1},{"text":"ئیتر ناویان ناهێنێت.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"لەو ڕۆژەدا پەیمانێکیان بۆ دەبەستم","poem":1},{"text":"لەگەڵ ئاژەڵی کێوی و باڵندەکانی ئاسمان و","poem":2},{"lineBreak":true},{"text":"خشۆکەکانی زەوی.","poem":2},{"text":"کەوان و شمشێر و جەنگ","poem":1},{"text":"لە خاکەکەدا بنبڕ دەکەم و","poem":2},{"lineBreak":true},{"text":"وایان لێ دەکەم بە ئاسوودەیی پاڵ بکەون.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بۆ هەتاهەتایە بۆ خۆم نیشانت دەکەم و","poem":1},{"text":"بە ڕاستودروستی و دادوەری،","poem":2},{"lineBreak":true},{"text":"بە خۆشەویستی نەگۆڕ و بەزەیی بۆ خۆمت نیشان دەکەم.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"بە دڵسۆزییەوە بۆ خۆم نیشانت دەکەم و","poem":1},{"text":"دان بە یەزداندا دەنێیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«یەزدان دەفەرموێت:","poem":1},{"text":"لەو ڕۆژەدا من کاردانەوەم دەبێت،","poem":2},{"text":"من کاردانەوەم بەرامبەر بە ئاسمان دەبێت و","poem":1},{"text":"ئەوانیش کاردانەوەیان بەرامبەر بە زەوی دەبێت،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"زەویش کاردانەوەی بەرامبەر بە دانەوێڵە و","poem":1},{"text":"شەرابی نوێ و زەیت دەبێت،","poem":2},{"lineBreak":true},{"text":"ئەوانیش کاردانەوەیان بەرامبەر بە یەزرەعیل","poem":2},{"noteId":4},{"text":"دەبێت.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"لە خاکەکەدا بۆ خۆم دەیچێنم،","poem":1},{"text":"بەزەییم دێتەوە بەوانەی کە فەرمووم ”بەزەییم پێیاندا نایەتەوە.“","poem":2},{"text":"ئەوانەی کە پێیان دەگوترا ”گەلی من نین“ پێیان دەڵێم: ”ئێوە گەلی منن.“","poem":1},{"text":"ئەوانیش دەڵێن: ”تۆ خودای ئێمەیت.“»","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"(عاخۆر) وشەیەکی عیبرییە بە واتای تێکدان. بڕوانە یەشوع بەشی 7.‏","reference":{"chapter":2,"verse":15}},{"noteId":4,"caller":"+","text":"یەزرەعیل: ناوێکی عیبری واتا (خودا دەیچێنێت).‏","reference":{"chapter":2,"verse":22}}]},"thisChapterLink":"/api/ckb_bib/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}