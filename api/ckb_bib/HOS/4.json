{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HOS","translationId":"ckb_bib","name":"هۆشەع","commonName":"هۆشەع","title":"هۆشەع","order":28,"numberOfChapters":14,"sha256":"9449abd5eac42d8e8ba79b9cebb098fdb1fb4a3c5cb5c307418ad215c7a3f70b","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ckb_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["سکاڵا لە دژی ئیسرائیل"]},{"type":"verse","number":1,"content":[{"text":"ئەی نەوەی ئیسرائیل، گوێ لە فەرمایشتی یەزدان بگرن،","poem":1},{"text":"چونکە یەزدان سکاڵای هەیە","poem":2},{"lineBreak":true},{"text":"لە دانیشتووانی خاکەکە:","poem":2},{"text":"«نە وەفاداری، نە خۆشەویستی نەگۆڕ،","poem":1},{"text":"نە خواناسی لە خاکەکەدا هەیە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"نەفرەتکردن و درۆ و کوشتن،","poem":1},{"text":"دزی و داوێنپیسی،","poem":2},{"text":"پەرەی سەندووە و","poem":1},{"text":"خوێنڕشتن، خوێنڕشتنی بەدوادا دێت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لەبەر ئەوە خاکەکە شین دەگێڕێت و","poem":1},{"text":"ئەوەی تێیدا نیشتەجێیە بەرەو نەمان دەچێت،","poem":2},{"text":"بە ئاژەڵی کێوی و باڵندەی ئاسمانیشەوە،","poem":1},{"text":"تەنانەت ماسی دەریاش لەناودەچێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«بەڵام با کەس سکاڵا نەکات و","poem":1},{"text":"کەسیش تاوانبار نەکرێت،","poem":2},{"text":"چونکە گەلەکەی تۆ وەک ئەوانەن کە","poem":1},{"text":"سکاڵا لە کاهین دەکەن.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"تۆش بە ڕۆژ تێکدەشکێیت و","poem":1},{"text":"بە شەویش پێغەمبەر لەگەڵت تێکدەشکێت،","poem":2},{"text":"منیش دایکت لەناودەبەم.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"گەلەکەم بەهۆی نەزانینەوە لەناوچووە.","poem":2},{"lineBreak":true},{"text":"«لەبەر ئەوەی تۆ زانینت ڕەتکردەوە،","poem":1},{"text":"منیش ڕەتت دەکەمەوە لەوەی کاهینیێتیم بۆ بکەیت.","poem":2},{"text":"لەبەر ئەوەی فێرکردنەکانی خودای خۆتت لەیاد کرد،","poem":1},{"text":"منیش نەوەکانت لەیاد دەکەم.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئەوەندەی کاهینەکان زیاد بوون،","poem":1},{"text":"ئەوەندەش گوناهیان لە دژی من کرد،","poem":2},{"lineBreak":true},{"text":"منیش شکۆیان دەگۆڕم بۆ شەرمەزاری.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"قوربانی گوناهی گەلەکەم دەخۆن و","poem":1},{"text":"ئاواتەخوازن کە تاوان بکات.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"جا کاهین وەک گەل دەبێت،","poem":1},{"text":"بەپێی ڕەفتارەکەی سزای دەدەم،","poem":2},{"lineBreak":true},{"text":"کردەوەکانی بەسەر خۆیدا دەدەمەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«دەخۆن و تێر نابن،","poem":1},{"text":"لەشفرۆشی دەکەن و زیاد نابن،","poem":2},{"text":"چونکە وازیان لە یەزدان هێنا","poem":1},{"text":"بۆ ئەوەی خۆیان تەرخان بکەن","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بۆ لەشفرۆشی و","poem":2},{"text":"بۆ شەرابی کۆن و شەرابی نوێ","poem":1},{"text":"کە هزر و هۆشی گەلەکەی منی بردووە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"گەلەکەم پرس بە بتە دارینەکەیان دەکەن،","poem":1},{"text":"وەڵام لە گۆچانەکەی دەستی وەردەگرن،","poem":2},{"text":"چونکە ڕۆحی لەشفرۆشی گومڕای کردوون و","poem":1},{"text":"دڵسۆزی خودای خۆیان نین.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لەسەر لووتکەی چیاکان قوربانی سەردەبڕن و","poem":1},{"text":"لەسەر گردەکان بخوور دەسووتێنن،","poem":2},{"text":"لەژێر دار بەڕوو و ئەسپیندار و دارەبەن،","poem":1},{"text":"چونکە سێبەری باشە!","poem":2},{"text":"لەبەر ئەوە کچەکانتان لەشفرۆشی دەکەن و","poem":1},{"text":"بووکەکانیشتان داوێنپیسی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«کچەکانتان سزا نادەم","poem":1},{"text":"کە لەشفرۆشی دەکەن و","poem":2},{"text":"بووکەکانیشتان","poem":1},{"text":"کە داوێنپیسی دەکەن،","poem":2},{"text":"چونکە پیاوەکان خۆیان دەچنە پاڵ لەشفرۆشەکان و","poem":1},{"text":"لەگەڵ لەشفرۆشەکان دەچنە نزرگەکان و قوربانی سەردەبڕن.","poem":2},{"lineBreak":true},{"text":"گەلێک تێگەیشتنی نەبێت لەناودەچێت!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«ئەی ئیسرائیل، ئەگەر تۆش داوێنپیسیت،","poem":1},{"text":"بەڵام با یەهودا تاوان نەکات.","poem":2},{"lineBreak":true},{"text":"«مەچن بۆ گلگال و","poem":1},{"text":"سەرمەکەون بۆ بێت‌ئاڤن","poem":2},{"noteId":9},{"text":"و","poem":2},{"lineBreak":true},{"text":"سوێند مەخۆن: ”بە یەزدانی زیندوو!“","poem":2}]},{"type":"verse","number":16,"content":[{"text":"وەک نوێنگینێکی","poem":1},{"noteId":10},{"text":"کەللەڕەق","poem":1},{"text":"ئیسرائیلیش کەللەڕەق بووە،","poem":2},{"text":"ئیتر یەزدان چۆن بیانلەوەڕێنێت","poem":1},{"text":"وەک بەرخ لە شوێنێکی پانوبەریندا؟","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئەفرایم بە بتەکانەوە بەستراوەتەوە،","poem":1},{"text":"وازی لێ بهێنن!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"تەنانەت خواردنەوەشیان تەواوبێت،","poem":1},{"text":"هەر نوقومی لەشفرۆشییەکەیان دەبن،","poem":2},{"lineBreak":true},{"text":"گەورەکانیان بە تەواوی حەزیان لە شەرمەزارییە نەک لە ڕێز.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"با لەژێر باڵەکانی خۆیدا دەیپێچێتەوە،","poem":1},{"text":"بە قوربانییەکانیان شەرمەزار دەبن.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"بێت‌ئاڤن: واتا (ماڵی بەدکاری) کە ناوێکی خراپە و ئەوان لەسەر بێت‌ئێلیان دانابوو. بێت‌ئێلیش واتا (ماڵی خودا).‏","reference":{"chapter":4,"verse":15}},{"noteId":10,"caller":"+","text":"بە گوێرەکە مێینەیەک دەگوترێت کاتێک کە لە شیر دەبڕدرێتەوە، کە تەمەنی لە یەک ساڵ تێبپەڕێت.‏","reference":{"chapter":4,"verse":16}}]},"thisChapterLink":"/api/ckb_bib/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}