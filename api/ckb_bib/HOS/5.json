{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HOS","translationId":"ckb_bib","name":"هۆشەع","commonName":"هۆشەع","title":"هۆشەع","order":28,"numberOfChapters":14,"sha256":"9449abd5eac42d8e8ba79b9cebb098fdb1fb4a3c5cb5c307418ad215c7a3f70b","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ckb_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["حوکمی سەر ئیسرائیل"]},{"type":"verse","number":1,"content":[{"text":"«ئەی کاهینەکان، گوێتان لەمە بێت!","poem":1},{"text":"ئەی بنەماڵەی ئیسرائیل، سەرنج بدەن!","poem":2},{"text":"ئەی ماڵی پاشا گوێ بگرن!","poem":1},{"text":"حوکمەکە لە دژی ئێوەیە،","poem":2},{"text":"چونکە ئێوە لە میچپا بوونە تەڵە،","poem":1},{"text":"هەروەها تۆڕێکی ڕاخراویش بوون بەسەر تاڤۆر.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"یاخیبووان لە کوشتن قووڵبوونەوە،","poem":1},{"text":"منیش هەموویان تەمبێ دەکەم.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"من ئەفرایم دەناسم و","poem":1},{"text":"ئیسرائیلیش لە من شاردراوە نییە.","poem":2},{"text":"ئەی ئەفرایم، ئێستا ڕێگای لەشفرۆشیت گرتووەتەبەر،","poem":1},{"text":"ئیسرائیل گڵاو بووە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«کارەکانیان ڕێیان نادات","poem":1},{"text":"بۆ لای خودای خۆیان بگەڕێنەوە،","poem":2},{"text":"چونکە ڕۆحی لەشفرۆشی لە ناخیاندایە و","poem":1},{"text":"ئەوان دان بە یەزداندا نانێن.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لووتبەرزی ئیسرائیل بەرەوڕوو شایەتی لەسەر دەدات و","poem":1},{"text":"ئیسرائیل و ئەفرایم بە تاوانەکانیان تێکدەشکێن،","poem":2},{"lineBreak":true},{"text":"یەهوداش لەگەڵیاندا تێکدەشکێت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بە مەڕ و مانگاکانیانەوە دەڕۆن","poem":1},{"text":"بۆ ئەوەی ڕوو لە یەزدان بکەن،","poem":2},{"text":"بەڵام بۆیان دەرناکەوێت،","poem":1},{"text":"چونکە لێیان دوور کەوتووەتەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ناپاکییان لە یەزدان کرد،","poem":1},{"text":"چونکە منداڵی زۆڵیان","poem":2},{"noteId":11},{"text":"بوو.","poem":2},{"text":"ئێستا جەژنی سەرەمانگەکانیان","poem":1},{"text":"خۆیان و کێڵگەکانیشیان دەخوات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«لە گیڤعادا کەڕەنا لێ بدەن و","poem":1},{"text":"لە ڕامەش زوڕنا.","poem":2},{"text":"لە بێت‌ئاڤن","poem":1},{"noteId":12},{"text":"نەعرەتەی جەنگ بکێشن؛","poem":1},{"text":"”ئەی بنیامین، ئێمە لەدوای تۆین.“","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەفرایم وێران دەبێت","poem":1},{"text":"لە ڕۆژی تەمبێکردندا.","poem":2},{"text":"لەنێو هۆزەکانی ئیسرائیلدا","poem":1},{"text":"ڕاستی ڕادەگەیەنم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"میرانی یەهودا وەک ئەوانەن","poem":1},{"text":"کە سنوور دەگوازنەوە،","poem":2},{"text":"منیش تووڕەیی خۆم وەک باران","poem":1},{"text":"بەسەریاندا هەڵدەڕێژم.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەفرایم زۆرلێکراوە،","poem":1},{"text":"بە حوکم تێکشکێنراوە،","poem":2},{"lineBreak":true},{"text":"چونکە بڕیاری دا دوای بت بکەوێت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"من بۆ ئەفرایم وەک مۆرانەم و","poem":1},{"text":"وەک کلۆربوونیش بۆ بنەماڵەی یەهودا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«کاتێک ئەفرایم نەخۆشییەکەی خۆی بینی و","poem":1},{"text":"یەهوداش ناسۆرەکەی خۆی،","poem":2},{"text":"ئینجا ئەفرایم چووە لای ئاشور و","poem":1},{"text":"بەدوای پاشا گەورەکەدا","poem":2},{"noteId":13},{"text":"ناردی.","poem":2},{"text":"بەڵام ناتوانێت چارەسەرتان بکات و","poem":1},{"text":"برینەکەتان لەسەر لاببات.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"من بۆ ئەفرایم وەک شێرم و","poem":1},{"text":"بۆ بنەماڵەی یەهوداش وەک بەچکە شێر،","poem":2},{"text":"چونکە من پارچەپارچەیان دەکەم و دەڕۆم،","poem":1},{"text":"دەبەم و فریادڕەسیش نییە،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"دەڕۆم و دەگەڕێمەوە بۆ شوێنەکەی خۆم","poem":1},{"text":"هەتا دان بە تاوانەکەیان دەنێن و","poem":2},{"text":"ڕوویان لە من دەکەن،","poem":1},{"text":"لە تەنگانەیاندا بە پەرۆشەوە ڕوویان لە من دەکەن.»","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"زۆڵ: بیژی‏","reference":{"chapter":5,"verse":7}},{"noteId":12,"caller":"+","text":"بێت‌ئاڤن: واتا ماڵی بەدکاری.‏","reference":{"chapter":5,"verse":8}},{"noteId":13,"caller":"+","text":"مەبەستی لە پاشای ئاشورە.‏","reference":{"chapter":5,"verse":13}}]},"thisChapterLink":"/api/ckb_bib/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}