{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HOS","translationId":"ckb_bib","name":"هۆشەع","commonName":"هۆشەع","title":"هۆشەع","order":28,"numberOfChapters":14,"sha256":"9449abd5eac42d8e8ba79b9cebb098fdb1fb4a3c5cb5c307418ad215c7a3f70b","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ckb_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["تۆبەنەکردنی ئیسرائیل"]},{"type":"verse","number":1,"content":[{"text":"«وەرن، با بگەڕێینەوە لای یەزدان،","poem":1},{"text":"چونکە ئەو پارچەپارچەی کردووین و","poem":2},{"lineBreak":true},{"text":"هەر ئەویش چارەسەرمان دەکات.","poem":2},{"text":"ئەو برینداری کردووین و","poem":1},{"text":"هەر ئەویش برینەکانمان ساڕێژ دەکات.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"دوای دوو ڕۆژ دەمانژیێنێتەوە،","poem":1},{"text":"لە ڕۆژی سێیەمدا هەڵماندەستێنێتەوە","poem":2},{"lineBreak":true},{"text":"بۆ ئەوەی ئێمە لەبەردەمیدا بژین.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"با دان بە یەزداندا بنێین،","poem":1},{"text":"با تێبکۆشین بۆ ئەوەی دانی پێدا بنێین.","poem":2},{"text":"بێگومان وەک چۆن ڕۆژ هەڵدێت","poem":1},{"text":"ئاواش یەزدان دەردەکەوێت،","poem":2},{"text":"وەک بارانی زستان دێتە لامان،","poem":1},{"text":"وەک بەهارە باران کە زەوی ئاو دەدات.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«ئەی ئەفرایم، چیت لێ بکەم؟","poem":1},{"text":"ئەی یەهودا، چیت لێ بکەم؟","poem":2},{"text":"خۆشویستنی ئێوە وەک هەوری بەیانییان وایە،","poem":1},{"text":"وەک ئەو شەونمەی بە زوویی دەڕوات.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لەبەر ئەوە بە پێغەمبەران پارچەپارچەم کردن،","poem":1},{"text":"بە وشەکانی دەمم ئێوەم کوشت،","poem":2},{"lineBreak":true},{"text":"حوکمەکەشم وەک ڕووناکی دەرکەوت،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"چونکە میهرەبانیم دەوێ نەک قوربانی،","poem":1},{"text":"لەلای من خواناسی لە قوربانی سووتاندن گرنگترە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بەڵام ئەوان وەک ئادەم سەرپێچی پەیمانیان کرد،","poem":1},{"text":"لەوێدا ناپاکییان لە من کرد.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"گلعاد شاری خراپەکارانە و","poem":1},{"text":"بە خوێن پێپەستە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"وەک چۆن جەردە بۆسە بۆ کەسێک دەنێنەوە،","poem":1},{"text":"ئاواش دەستەی کاهینەکان،","poem":2},{"text":"لە ڕێگادا ڕووەو شەخەم خەڵک دەکوژن،","poem":1},{"text":"بەدڕەوشتی ئەنجام دەدەن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لە بنەماڵەی ئیسرائیلدا کارێکی تۆقێنەر دەبینم،","poem":1},{"text":"لەوێدا ئەفرایم لەشفرۆشی دەکات،","poem":2},{"lineBreak":true},{"text":"ئیسرائیل گڵاوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«تۆش ئەی یەهودا،","poem":1},{"text":"ڕۆژی لێپێچینەوەت بۆ دیاریکراوە.","poem":2},{"lineBreak":true},{"text":"«هەر کاتێک بمەوێت ڕاپێچکراوانی گەلەکەم دەگەڕێنمەوە","poem":1},{"noteId":14},{"text":"،","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"گەڕاندنەوە لە ڕاپێچکراوی هێمایەک بووە بۆ نوێکردنەوەی بەختەوەری.‏","reference":{"chapter":6,"verse":11}}]},"thisChapterLink":"/api/ckb_bib/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}