{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HOS","translationId":"ckb_bib","name":"هۆشەع","commonName":"هۆشەع","title":"هۆشەع","order":28,"numberOfChapters":14,"sha256":"9449abd5eac42d8e8ba79b9cebb098fdb1fb4a3c5cb5c307418ad215c7a3f70b","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ckb_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"کاتێک ئیسرائیلم چارەسەر دەکرد،","poem":1},{"lineBreak":true},{"text":"تاوانی ئەفرایم ئاشکرا بوون،","poem":1},{"text":"هەروەها خراپەی سامیرە.","poem":2},{"text":"فێڵیان کرد،","poem":1},{"text":"دز چووە ژوورەوە و","poem":2},{"lineBreak":true},{"text":"جەردەکانیش لە دەرەوە تاڵانیان کرد،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بەڵام لە دڵی خۆیاندا بیر لەوە ناکەنەوە","poem":1},{"text":"کە من هەموو خراپەکەی ئەوانم لەبیرە.","poem":2},{"text":"ئێستا کردەوەکانیان دەوریان دەدات،","poem":1},{"text":"لە بەرچاومدان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«بە خراپەکەیان پاشا دڵخۆش دەکەن و","poem":1},{"text":"بە درۆکانیشیان میر.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"هەموو داوێنپیسن","poem":1},{"text":"وەک تەنوورێکی گەرمکراون","poem":2},{"text":"کە نانەواکە ئاگرەکەی گڕ نادات،","poem":1},{"text":"لە کاتی هەویر شێلانەوە هەتا کاتی هەڵهاتنی.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لە ڕۆژی جەژنی پاشاماندا،","poem":1},{"text":"میر نەخۆش دەکەون، لەبەر شەراب تایان لێ دێت،","poem":2},{"lineBreak":true},{"text":"پاشا لەگەڵ گاڵتەجاڕان دەست تێکەڵ دەکات.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"دڵیان وەک ناخی تەنوورە،","poem":1},{"text":"بە فرتوفێڵ لە پاشا نزیک دەبنەوە.","poem":2},{"text":"قینیان بە درێژایی شەو کپ دەبێت و","poem":1},{"text":"بۆ بەیانی وەک ئاگرێکی گڕ گرتوو گەرمە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"هەموویان وەک تەنوور گەرمن،","poem":1},{"text":"دادوەرەکانی خۆیان دەخۆن،","poem":2},{"text":"هەموو پاشاکانیان دەکەون،","poem":1},{"text":"کەسیان تێدا نییە نزا بۆ من بکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ئەفرایم تێکەڵ بە گەلان دەبێت.","poem":1},{"text":"ئەفرایم بووە بە کولێرەیەکی هەڵنەگەڕاوە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بێگانەکان هێزەکەی دەخۆن و","poem":1},{"text":"ئەویش پێی نازانێت.","poem":2},{"text":"قژی ماشوبرنج بووە و","poem":1},{"text":"ئەویش پێی نازانێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لووتبەرزی ئیسرائیل بەرەوڕوو شایەتی لەسەر دەدات،","poem":1},{"text":"لەگەڵ هەموو ئەوەشدا","poem":2},{"text":"ناگەڕێنەوە بۆ لای یەزدانی پەروەردگاری خۆیان و","poem":1},{"text":"بەدوایدا ناگەڕێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ئەفرایم وەک کۆترێکی لێهاتووە،","poem":1},{"text":"گێل و بێ مێشک،","poem":2},{"text":"بانگی میسر دەکەن و","poem":1},{"text":"بۆ لای ئاشور دەچن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"کاتێک دەڕۆن، تۆڕەکەم بەسەریاندا هەڵدەدەم،","poem":1},{"text":"وەک باڵندەی ئاسمان دایاندەگرم.","poem":2},{"text":"کاتێک کۆدەبنەوە تەمبێیان دەکەم","poem":1},{"text":"بەگوێرەی ئەوەی دەیبیستم.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"قوڕبەسەریان، چونکە لە من هەڵاتن!","poem":1},{"text":"ماڵوێرانی بۆیان، چونکە لێم یاخی بوون!","poem":2},{"text":"من دەیانکڕمەوە،","poem":1},{"text":"بەڵام ئەوان درۆم بۆ هەڵدەبەستن.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"کاتێک لەسەر جێگاکانیان دەناڵێنن","poem":1},{"text":"لە دڵەوە هاوارم بۆ ناکەن.","poem":2},{"text":"بۆ دانەوێڵە و شەراب کۆدەبنەوە،","poem":1},{"text":"لە من هەڵدەگەڕێنەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"من فێرم کردن و بازووی ئەوانم بەهێز کرد،","poem":1},{"text":"بەڵام ئەوان لە دژی من بیر لە خراپە دەکەنەوە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"دەگەڕێنەوە، بەڵام نەک بۆ لای خودای هەرەبەرز،","poem":1},{"text":"وەک کەوانێکی ناڕێکیان لێدێت.","poem":2},{"text":"لەبەر قینی زمانیان ڕابەرانیان بە شمشێر دەکوژرێن.","poem":1},{"text":"لەبەر ئەمە لە میسر دەبنە گاڵتەجاڕ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}