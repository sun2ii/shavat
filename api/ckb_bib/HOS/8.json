{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HOS","translationId":"ckb_bib","name":"هۆشەع","commonName":"هۆشەع","title":"هۆشەع","order":28,"numberOfChapters":14,"sha256":"9449abd5eac42d8e8ba79b9cebb098fdb1fb4a3c5cb5c307418ad215c7a3f70b","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ckb_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["دورینەوەی گەردەلوول"]},{"type":"verse","number":1,"content":[{"text":"«کەڕەنا ببە بۆ دەمت!","poem":1},{"text":"هەڵۆیەک هاتە سەر ماڵی یەزدان،","poem":2},{"text":"لەبەر ئەوەی پەیمانەکەی منیان شکاند و","poem":1},{"text":"لە فێرکردنەکانم یاخی بوون.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"هاوار بۆ من دەکەن:","poem":1},{"lineBreak":true},{"text":"”ئەی خودای ئێمە، ئێمەی ئیسرائیل دانت پێدا دەنێین!“","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"بەڵام ئیسرائیل بێزی لە چاکە بووەوە،","poem":1},{"text":"لەبەر ئەوە دوژمن ڕاوی دەنێت.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەوان پاشایان دانا، بەڵام لە منەوە نەبوو،","poem":1},{"text":"میریان دانا، کە من نایانناسم.","poem":2},{"text":"لە زێڕ و زیوەکانیان بتیان بۆ خۆیان دروستکرد،","poem":1},{"text":"بۆ لەناوچوونیان.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەی سامیرە، بتە گوێرەکەکەت بەلاوە بنێ!","poem":1},{"text":"تووڕەییم بەسەریاندا دەجۆشێت.","poem":2},{"text":"هەتا کەی ناتوانن خۆیان بێگەرد ڕابگرن؟","poem":1}]},{"type":"verse","number":6,"content":[{"text":"هەروەها ئەوانیش هەر لە ئیسرائیلن!","poem":2},{"text":"وەستایەک ئەم بتەی دروستکردووە، نابێتە خودا.","poem":1},{"text":"گوێرەکەکەی سامیرە پارچەپارچە دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ئەوان با دەچێنن و","poem":1},{"text":"گەردەلوول دەدورنەوە.","poem":2},{"text":"چێنراوێک کە بەروبوومی نییە و","poem":1},{"text":"ئاردی لێ دروستناکرێت و","poem":2},{"text":"ئەگەر دروستیش کرا","poem":1},{"text":"بێگانەکان هەڵیدەلووشن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئیسرائیل هەڵلووشرا!","poem":1},{"text":"ئێستا لەنێو نەتەوەکاندا","poem":2},{"lineBreak":true},{"text":"وەک قاپێکیان لێ هاتووە کە هیچ سوودی نییە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"وەک کەرەکێوییەکی تاک و تەنها","poem":1},{"text":"چوونە ئاشور.","poem":2},{"lineBreak":true},{"text":"ئەفرایم خۆی بە چەند دۆستێک فرۆشتووە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"هەرچەندە ئەوان لەنێو نەتەوەکان خۆیان فرۆشتووە،","poem":1},{"text":"بەڵام ئێستا من کۆیان دەکەمەوە،","poem":2},{"lineBreak":true},{"text":"ئینجا ئەوان لەژێر باری پاشای توانادار","poem":2},{"noteId":15},{"text":"دەفەوتێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«هەرچەندە ئەفرایم قوربانگاکانی قوربانی گوناهی زۆر کرد،","poem":1},{"text":"بۆی بوونە قوربانگای گوناهکردن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"شتی زۆری بۆ دەنووسم کە پەیوەستە بە فێرکردنەکانم،","poem":1},{"text":"بەڵام ئەو بە نامۆیان دادەنێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"قوربانیم پێشکەش دەکەن و","poem":1},{"text":"خۆیان گۆشتەکەی دەخۆن،","poem":2},{"lineBreak":true},{"text":"بەڵام یەزدان پێیان ڕازی نییە.","poem":2},{"text":"ئێستا تاوانەکەیان دەهێنێتەوە یاد و","poem":1},{"text":"سزای گوناهەکانیان دەدات:","poem":2},{"lineBreak":true},{"text":"ئەوان دەگەڕێنەوە میسر.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئیسرائیل دروستکەری خۆی لە یاد کرد و","poem":1},{"text":"چەندین کۆشکی بنیاد نا،","poem":2},{"lineBreak":true},{"text":"یەهوداش شارە قەڵابەندەکان.","poem":2},{"text":"بەڵام من ئاگر دەنێرمە سەر شارەکانی","poem":1},{"text":"ئینجا قەڵاکانی دەخوات.»","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"مەبەست لە پاشای ئاشورە.‏","reference":{"chapter":8,"verse":10}}]},"thisChapterLink":"/api/ckb_bib/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}