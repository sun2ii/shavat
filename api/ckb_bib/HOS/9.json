{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"HOS","translationId":"ckb_bib","name":"هۆشەع","commonName":"هۆشەع","title":"هۆشەع","order":28,"numberOfChapters":14,"sha256":"9449abd5eac42d8e8ba79b9cebb098fdb1fb4a3c5cb5c307418ad215c7a3f70b","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ckb_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["سزای ئیسرائیل"]},{"type":"verse","number":1,"content":[{"text":"ئەی ئیسرائیل، وەک گەلان","poem":1},{"text":"دڵخۆش و شاد مەبە،","poem":2},{"text":"چونکە ناپاکیت لە خودای خۆت کرد،","poem":1},{"text":"حەزت لە کرێی لەشفرۆشی کرد","poem":2},{"lineBreak":true},{"text":"لەسەر هەموو جۆخینەکان","poem":2},{"noteId":16},{"text":".","poem":2}]},{"type":"verse","number":2,"content":[{"text":"جۆخین و گوشەرەکانیان بەشیان ناکات،","poem":1},{"text":"شەرابی نوێش بەشیان ناکات.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لە خاکی یەزدان نیشتەجێ نابن،","poem":1},{"text":"بەڵکو ئەفرایم بۆ میسر دەگەڕێتەوە و","poem":2},{"lineBreak":true},{"text":"لە ئاشوردا خواردنی گڵاو دەخۆن.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"شەرابی پێشکەشکراو بۆ یەزدان ناڕژێنن و","poem":1},{"text":"قوربانییەکانیان دڵی خۆش ناکەن.","poem":2},{"text":"ئەو قوربانییانە بۆ ئەوان وەک نانی ماتەمە و","poem":1},{"text":"هەرکەسێک لێی بخوات گڵاو دەبێت.","poem":2},{"text":"نانەکەیان بۆ خۆیانە و","poem":1},{"text":"ناچێتە ناو ماڵی یەزدانەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"لە ڕۆژی دیاریکراودا چی دەکەن،","poem":1},{"text":"لە ڕۆژی جەژنی یەزدان؟","poem":2}]},{"type":"verse","number":6,"content":[{"text":"تەنانەت ئەوەی لە وێرانی هەڵدێت،","poem":1},{"text":"میسر کۆیان دەکاتەوە و","poem":2},{"lineBreak":true},{"text":"مەمفیس لە گۆڕیان دەنێت.","poem":2},{"text":"دڕکوداڵ گەنجینە زیوەکانیان بە میرات دەگرێت و","poem":1},{"text":"وشترالووک لە ماڵەکەیاندا دەبێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ڕۆژانی لێپرسینەوە بەڕێوەن،","poem":1},{"text":"ڕۆژانی سزا بەڕێوەن.","poem":2},{"lineBreak":true},{"text":"با ئیسرائیل ئەمە بزانێت.","poem":2},{"text":"لەبەر زۆری تاوانەکەت و","poem":1},{"text":"زۆری کێشمەکێشت،","poem":2},{"text":"پێغەمبەر بە گێل سەیر دەکەیت و","poem":1},{"text":"مرۆڤی ڕۆحیش بە شێت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"پێغەمبەرەکە لەگەڵ خوداکەم چاودێری ئەفرایمە،","poem":1},{"text":"بەڵام لە هەموو ڕێڕەوەکانی تەڵەیان نایەوە،","poem":2},{"lineBreak":true},{"text":"کێشمەکێشیش لە ماڵی خوداکەیەتی.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەوان نوقوم بوون،","poem":1},{"text":"وەک ڕۆژانی گیڤعا گەندەڵ بوون،","poem":2},{"text":"خودا تاوانەکەیان دەهێنێتەوە بیری خۆی و","poem":1},{"text":"لەسەر گوناهەکانیان سزایان دەدات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«ئیسرائیلم دۆزییەوە","poem":1},{"text":"وەک ترێ لە چۆڵەوانی،","poem":2},{"text":"لە سەرەتادا باوباپیرانتانم بینی","poem":1},{"text":"وەک نۆبەرەی بەری دار هەنجیرێک.","poem":2},{"text":"بەڵام ئەوان هاتن بۆ بەعل‌پەعۆر و","poem":1},{"text":"خۆیان بۆ خوداوەندی شەرمەزاری تەرخان کرد،","poem":2},{"lineBreak":true},{"text":"ئەوان وەک ئەو خوداوەندەی کە خۆشیان دەویست قێزەون بوون.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەفرایمیش شکۆمەندییەکەی وەک باڵندە دەفڕێت،","poem":1},{"text":"نە لەدایکبوون و نە سکپڕی و نە دروستبوونی کۆرپەلە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"تەنانەت ئەگەر منداڵەکانیشیان پەروەردە بکەن،","poem":1},{"text":"جەرگسووتاویان دەکەم بۆ ئەوەی هیچ مرۆڤێک نەبێت.","poem":2},{"text":"قوڕبەسەریان","poem":1},{"text":"کاتێک پشتیان تێدەکەم.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەفرایم دەبینم، وەک شاری سورە","poem":1},{"lineBreak":true},{"text":"لە لەوەڕگا ڕواوە،","poem":1},{"lineBreak":true},{"text":"بەڵام ئەفرایم منداڵەکانی","poem":1},{"text":"بۆ بکوژ دەهێنێتە دەرەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ئەی یەزدان، بیاندەرێ،","poem":1},{"text":"چییان پێدەدەیت؟","poem":2},{"text":"منداڵدانێکی لەباربردە و","poem":1},{"text":"دوو مەمکی وشک.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«لەبەر هەموو خراپەکانیان لە گلگال","poem":1},{"text":"من لەوێدا قێزم لێیان بووەوە.","poem":2},{"text":"لەبەر کردەوە خراپەکانیان","poem":1},{"text":"لە ماڵی خۆم دەریاندەکەم.","poem":2},{"text":"ئیتر خۆشم ناوێن،","poem":1},{"lineBreak":true},{"text":"هەموو میرەکانیان یاخین.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ئەفرایم هەڵپڕووکاوە،","poem":1},{"text":"ڕەگیان وشک بوو،","poem":2},{"lineBreak":true},{"text":"بەر ناگرن.","poem":2},{"text":"ئەگەر منداڵیشیان ببێت،","poem":1},{"text":"منداڵە خۆشەویستەکانی سکیان دەمرێنم.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"خوداکەم ڕەتیان دەکاتەوە،","poem":1},{"text":"چونکە گوێیان لێی نەگرت،","poem":2},{"lineBreak":true},{"text":"لەبەر ئەوە لەنێو نەتەوەکاندا وێڵ دەبن.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":16,"caller":"+","text":"جۆخین یان سەرخەرمان ئەو زەوییە تەرخانکراوەیە کە لەلایەن وەرزێر و جوتیارەوە بەکارهێنراوە بۆ کوتانی دانەوێڵە لەسەری لەدوای کۆکردنەوەی لە کێڵگە.‏","reference":{"chapter":9,"verse":1}}]},"thisChapterLink":"/api/ckb_bib/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HO