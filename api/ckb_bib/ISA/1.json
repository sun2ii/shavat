{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["خودا لە ماوەی پاشایەتی عوزیا و یۆتام و ئاحاز و حەزقیای پاشایانی یەهودا، دەربارەی یەهودا و ئۆرشەلیم ئەم بینینانەی بۆ ئیشایای کوڕی ئامۆچ ئاشکرا کرد."]},{"type":"heading","content":["نەتەوەیەکی یاخی"]},{"type":"verse","number":2,"content":[{"text":"ئەی ئاسمان گوێ بگرە و ئەی زەوی گوێ شل بکە،","poem":1},{"text":"چونکە یەزدان دەفەرموێت:","poem":2},{"text":"«چەند کوڕێکم گەورە کرد و پێم گەیاندن،","poem":1},{"text":"بەڵام ئەوان لێم یاخی بوون.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"گا خاوەنەکەی خۆی دەناسێت و","poem":1},{"text":"گوێدرێژیش ئاخوڕی خاوەنی خۆی،","poem":2},{"text":"بەڵام ئیسرائیل من ناناسێت،","poem":1},{"text":"گەلی من تێناگات.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"قوڕبەسەر نەتەوەی گوناهبار،","poem":1},{"text":"بەسەر ئەو گەلەی تاوانی قورسە،","poem":2},{"text":"توخمی بەدکاران،","poem":1},{"text":"کوڕانی گەندەڵین!","poem":2},{"text":"وازیان لە یەزدان هێنا،","poem":1},{"text":"بە سووکییەوە تەماشای خودا پیرۆزەکەی ئیسرائیلیان کرد،","poem":2},{"lineBreak":true},{"text":"پشتیان لێی کرد.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"بۆچی دووبارە لێتان بدرێتەوە؟","poem":1},{"text":"بۆچی بەردەوامن لە یاخیبوونتان؟","poem":2},{"text":"تەواوی سەر نەخۆشە و","poem":1},{"text":"هەموو دڵ بیمارە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لە بنی پێ هەتا تەوقی سەر","poem":1},{"text":"کوا تەندروستی تێیدا؟","poem":2},{"text":"بەڵکو برین و شین و مۆر بوونەوەیە،","poem":1},{"text":"لێدانی تەڕ و تازە","poem":2},{"text":"کە نەگوشراوە و نەبەستراوە و","poem":1},{"text":"بە ڕۆن نەرم نەکراوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"خاکەکەتان وێرانە،","poem":1},{"text":"شارەکانتان سووتاوە،","poem":2},{"text":"لەبەرچاوتان زەوییەکەتان","poem":1},{"text":"بێگانەکان دەیخۆن،","poem":2},{"lineBreak":true},{"text":"وێرانە وەک ئەوەی بێگانە هەڵاوگێڕی کردبێت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"سییۆنی کچ","poem":1},{"noteId":0},{"text":"ماوەتەوە،","poem":1},{"text":"وەک کۆخ لەناو ڕەزەمێودا،","poem":2},{"text":"وەک کەپر لەناو بێستانی خەیاردا،","poem":1},{"text":"وەک شارێکی ئابڵوقەدراو.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەگەر یەزدانی سوپاسالار","poem":1},{"text":"کەمێک دەربازبووی بۆ نەهێشتباینایەوە،","poem":2},{"text":"وەک سەدۆممان لێ دەهات،","poem":1},{"text":"لە عەمۆرا دەچووین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"گوێ لە فەرمایشتی یەزدان بگرن،","poem":1},{"text":"ئەی فەرمانڕەوایانی سەدۆم!","poem":2},{"text":"گوێ شل بکەن بۆ فێرکردنەکانی خودامان،","poem":1},{"text":"ئەی گەلی عەمۆرا!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"یەزدان دەفەرموێت:","poem":1},{"text":"«بۆچیمە، زۆری قوربانییە سەربڕدراوەکانتان؟","poem":2},{"text":"تێربووم لە قوربانی سووتاندنی بەرانەکان و","poem":1},{"text":"لە چەوری دابەستەکان،","poem":2},{"lineBreak":true},{"text":"دڵخۆش نیم بە خوێنی جوانەگا","poem":2},{"noteId":1},{"text":"و بەرخ و تەگەکان","poem":2},{"noteId":2},{"text":".","poem":2}]},{"type":"verse","number":12,"content":[{"text":"کە دێن بۆ بینینی ڕووم،","poem":1},{"text":"کێ داوای ئەمەی لێکردوون،","poem":2},{"lineBreak":true},{"text":"کە پێ بنێنە ناو حەوشەکانم؟","poem":2}]},{"type":"verse","number":13,"content":[{"text":"چیتر پێشکەشکراوی دانەوێڵەی بێ کەڵک مەهێنن!","poem":1},{"text":"بخوور قێزەونە بۆ من.","poem":2},{"text":"سەرەمانگ و شەممە و بانگەوازی کۆبوونەوە،","poem":1},{"text":"بەرگەی بۆنە ئایینییە خراپەکانتان ناگرم.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"سەرەمانگ و جەژنەکانتان","poem":1},{"text":"گیانم ڕقی لێیانە.","poem":2},{"text":"بوون بە بارگرانی بۆم،","poem":1},{"text":"لێیان بێزار بووم.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"کە لە کاتی نزاکردندا دەستتان پان دەکەنەوە،","poem":1},{"text":"چاوم لادەدەم لەسەرتان،","poem":2},{"text":"تەنانەت ئەگەر نوێژیش زۆر بکەن،","poem":1},{"text":"من گوێ ناگرم.","poem":2},{"lineBreak":true},{"text":"«دەستتان بە خوێن سوور بووە!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«خۆتان بشۆن، پاک ببنەوە.","poem":1},{"text":"خراپەی کردەوەکانتان","poem":2},{"lineBreak":true},{"text":"لەبەرچاوم لاببەن!","poem":2},{"text":"وازبهێنن لە خراپەکاری،","poem":1}]},{"type":"verse","number":17,"content":[{"text":"فێری چاکە بن!","poem":2},{"text":"بەدوای دادپەروەریدا بگەڕێن،","poem":1},{"text":"ستەملێکراوان هانبدەن.","poem":2},{"text":"دادوەری هەتیو بکەن،","poem":1},{"text":"پارێزەری بۆ بێوەژن بکەن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"یەزدان دەفەرموێت:","poem":1},{"text":"«ئێستا وەرن یەکلایی بکەینەوە.","poem":2},{"text":"ئەگەر گوناهەکانتان سووری ئاڵ بێت،","poem":1},{"text":"وەک بەفر سپی دەبێتەوە؛","poem":2},{"text":"ئەگەر وەک قرمز سوور بێت،","poem":1},{"text":"وەک خوری لێدێت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەگەر قایل بن و گوێ بگرن،","poem":1},{"text":"خێروبێری خاکەکە دەخۆن.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"بەڵام ئەگەر قایل نەبن و یاخی بن،","poem":1},{"text":"بە شمشێر دەخورێن،»","poem":2},{"text":"چونکە دەمی یەزدان فەرمووی.","poem":4}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«چۆن شارە دڵسۆزەکە","poem":1},{"text":"بوو بە لەشفرۆش!","poem":2},{"text":"پڕ دادوەری بوو،","poem":1},{"text":"ڕاستودروستی تێیدا دەمایەوە،","poem":2},{"lineBreak":true},{"text":"بەڵام ئێستا پیاوکوژان!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"زیوت بوو بە خڵت و","poem":1},{"text":"شەرابت ئاوی تێکراوە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"میرەکانت یاخین و","poem":1},{"text":"دۆستی دزانن،","poem":2},{"text":"هەموو حەزیان لە بەرتیلە و","poem":1},{"text":"دوای پاداشت کەوتوون.","poem":2},{"text":"دادوەری بۆ هەتیو ناکەن،","poem":1},{"text":"سکاڵای بێوەژن ناگاتە لایان.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"لەبەر ئەوە یەزدان، پەروەردگاری سوپاسالار،","poem":1},{"text":"توانادارەکەی ئیسرائیل، دەفەرموێت:","poem":2},{"text":"«ئای، من تووڕەییم بەسەر ناحەزانمدا دەڕێژم و","poem":1},{"text":"تۆڵە لە دوژمنانم دەکەمەوە.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"دژ بە تۆ دەستم درێژ دەکەم،","poem":1},{"text":"بە تەواوەتی خڵتەکەت پاک دەکەمەوە،","poem":2},{"lineBreak":true},{"text":"هەموو خڵت و پیسییەکەت لێ دەکەمەوە.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ڕابەرانت دەگەڕێنمەوە وەک یەکەم جار و","poem":1},{"text":"ڕاوێژکارانت وەک لە سەرەتا.","poem":2},{"text":"پاش ئەمە پێت دەگوترێت","poem":1},{"text":"”شاری ڕاستودروستی“،","poem":2},{"lineBreak":true},{"text":"”شاری دڵسۆز“.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"بە دادپەروەری سییۆن دەکڕدرێتەوە،","poem":1},{"text":"تۆبەکارەکانیشی بە ڕاستودروستی.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"بەڵام تێکشکانی یاخیبووان و گوناهباران پێکەوە دەبێت،","poem":1},{"text":"وازهێنەران لە یەزدانیش دەفەوتێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«شەرمەزار دەبن بەو دار بەڕووانەی","poem":1},{"text":"ئارەزووتان کرد،","poem":2},{"text":"تەریق دەبنەوە بەو باخچانەی","poem":1},{"text":"هەڵتانبژارد.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"وەک دار بەڕووێکتان لێدێت کە گەڵاکانی وەریبێت و","poem":1},{"text":"وەک باخچەیەک ئاوی نەبێت.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"مرۆڤی بەهێز دەبێت بە پەڕۆ و","poem":1},{"text":"ئیشوکارەکەشی بە پریشکی ئاگر،","poem":2},{"text":"جا هەردووکیان پێکەوە دەسووتێن و","poem":1},{"text":"کەس نابێت بیانکوژێنێتەوە.»","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"مەبەست لە وڵاتی یەهودایە.‏","reference":{"chapter":1,"verse":8}},{"noteId":1,"caller":"+","text":"لەو کاتەوەی کە گوێرەکەی نێر لە شیر دەبڕدرێتەوە پێی دەگوترێت نۆبەن یان جوانەگا.‏","reference":{"chapter":1,"verse":11}},{"noteId":2,"caller":"+","text":"نێری، سابرێن.‏","reference":{"chapter":1,"verse":11}}]},"thisChapterLink":"/api/ckb_bib/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}