{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"قوڕبەسەر فەرزدانەرانی فەرزی بەدکاری و","poem":1},{"text":"ئەوانەی فەرمانی ستەمکارانە دەردەکەن،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بۆ ئەوەی دەست بنێن بە ڕووی هەژارانەوە لە دادوەری و","poem":1},{"text":"مافی نەدارانی گەلەکەم بخۆن،","poem":2},{"text":"بۆ ئەوەی بێوەژنان ببن بە دەستکەوتیان و","poem":1},{"text":"هەتیوانیش تاڵان بکەن.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لە ڕۆژی سزا چی دەکەن،","poem":1},{"text":"کاتێک ماڵوێرانی لە دوورەوە دێت؟","poem":2},{"text":"بۆ لای کێ هەڵدێن بۆ یارمەتی و","poem":1},{"text":"گەنجینەتان لەکوێ بەجێدەهێڵن؟","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بێجگە لە چۆکدادان لەژێر دیل و","poem":1},{"text":"کەوتن لەژێر کوژراوەکان.","poem":2},{"lineBreak":true},{"text":"لەگەڵ هەموو ئەوەشدا تووڕەییەکەی دانەمرکایەوە،","poem":1},{"text":"هێشتا دەستی درێژکردووە.","poem":2}]},{"type":"heading","content":["حوکمی خودا بەسەر ئاشور"]},{"type":"verse","number":5,"content":[{"text":"«قوڕبەسەر ئاشور، داردەستی تووڕەییم،","poem":1},{"text":"هەڵچوونم گۆچانە بە دەستیەوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بۆ سەر نەتەوەیەکی خوانەناس دەینێرم،","poem":1},{"text":"فەرمانی پێدەدەم بۆ سەر ئەو گەلەی تووڕەییم لێی دەجۆشێت،","poem":2},{"text":"تاکو دەستکەوتی دەست بکەوێت و تاڵان بکات،","poem":1},{"text":"هەتا بیکات بە پێشێلکراو وەک قوڕی کۆڵانان.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بەڵام ئەو وا بیر ناکاتەوە،","poem":1},{"text":"ئەو ئەمەی لە دڵدا نییە،","poem":2},{"text":"چونکە ئامانجی ئەو وێرانکردنە،","poem":1},{"text":"لەناوبردنی گەلانێکی زۆرە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"دەڵێت: ”ئایا هەموو میرەکانم پاشا نین؟","poem":1}]},{"type":"verse","number":9,"content":[{"text":"ئایا کەلنۆ وەک کەرکەمیش نییە؟","poem":2},{"text":"یان حەمات وەک ئەرپاد؟","poem":1},{"text":"یان سامیرە وەک دیمەشق؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"وەک چۆن دەستم بە شانشینی بتەکان گەیشت و","poem":1},{"text":"وێنەی بتەکانیان زۆرترن لەوانەی ئۆرشەلیم و لەوانەی سامیرە،","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئایا وەک ئەوەی بە سامیرە و بە بتەکانی ئەوم کرد،","poem":1},{"text":"وا بە ئۆرشەلیم و بە وێنەی بتەکانی ناکەم؟“»","poem":2}]},{"type":"verse","number":12,"content":["دوای ئەوەی پەروەردگار هەموو ئیش و کارەکەی لە کێوی سییۆن و لە ئۆرشەلیم تەواو دەکات، دەڵێت: «سزای بەروبوومی بەفیزی دڵی پاشای ئاشور و شانازی لووتبەرزییەکەی دەدەم،"]},{"type":"verse","number":13,"content":["چونکە دەڵێت:",{"text":"«”بە توانای دەستی خۆم کردم و","poem":1},{"text":"بە داناییەکەم، چونکە تێگەیشتووم،","poem":2},{"text":"سنووری گەلانم گواستەوە و","poem":1},{"text":"گەنجینەکانی ئەوانم تاڵان کرد،","poem":2},{"lineBreak":true},{"text":"وەک دلێرێک پاشاکانی ئەوانم ملکەچ کرد،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"دەستم گەیشتە سامانی گەلان،","poem":1},{"text":"وەک چۆن دەست دەگاتە هێلانە؛","poem":2},{"text":"وەک کۆکردنەوەی هێلکەی بەجێماو،","poem":1},{"text":"هەموو زەویم کۆکردەوە،","poem":2},{"text":"کەسیش نەبوو باڵی لێک بدات","poem":1},{"text":"یان دەمی بکاتەوە و ورتەیەکی لێ بێت.“»","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"تەور شانازی دەکات بەسەر ئەو کەسەی پێی دەبڕێتەوە،","poem":1},{"text":"یان مشار خۆی بە زل دەزانێت بەسەر ئەو کەسەی دەیبات و دەیهێنێت؟","poem":2},{"text":"وەک ئەوەی داردەست هەڵگرەکەی ڕاوەشێنێت","poem":1},{"text":"وەک ئەوەی گۆچان ئەو کەسە بەرز بکاتەوە کە دار نییە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"لەبەر ئەوە یەزدان، پەروەردگاری سوپاسالار","poem":1},{"text":"لەڕی دەنێرێتە ناو پاڵەوانە بەهێزەکان،","poem":2},{"text":"لەژێر شکۆمەندییەکەشی پشکۆیەک دادەگیرسێنێت","poem":1},{"text":"وەک داگیرسانی ئاگر.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ڕووناکی ئیسرائیل","poem":1},{"noteId":21},{"text":"دەبێت بە ئاگر و","poem":1},{"text":"پیرۆزەکەشی بە گڕ،","poem":2},{"text":"دەیسووتێنێت و دەیخوات چقڵ و دڕکەکەی","poem":1},{"text":"لە یەک ڕۆژدا.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"چڕی دارستان و باخەکانی بە تەواوی لەناودەبات،","poem":1},{"text":"گیان و لەش پێکەوە","poem":2},{"lineBreak":true},{"text":"وەک توانەوەی نەخۆش دەبێت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"پاشماوەی داری دارستانەکانی ئەوەندە کەم دەبن","poem":1},{"text":"منداڵێک دەتوانێت بیانژمێرێت.","poem":2}]},{"type":"heading","content":["پاشماوەی ئیسرائیل"]},{"type":"verse","number":20,"content":[{"text":"لەو ڕۆژەدا، پاشماوەی ئیسرائیل و","poem":1},{"text":"دەربازبووەکانی بنەماڵەی یاقوب،","poem":2},{"text":"چیتر پشت نابەستن","poem":1},{"text":"بەوانەی لێیان دەدەن،","poem":2},{"text":"بەڵکو بەڕاستی بە یەزدان و","poem":1},{"text":"بە خودا پیرۆزەکەی ئیسرائیل پشت دەبەستن.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"پاشماوە دەگەڕێتەوە، پاشماوەی یاقوب","poem":1},{"text":"بۆ لای خودای توانادار.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ئەی ئیسرائیل، ئەگەر گەلت بەقەد لمی دەریا بێت،","poem":1},{"text":"تەنها پاشماوەی لێ دەگەڕێتەوە.","poem":2},{"text":"بڕیاری قڕبوون دراوە،","poem":1},{"text":"لافاوی ڕاستودروستییە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"یەزدانی پەروەردگاری سوپاسالار","poem":1},{"text":"بڕیاری وێرانکردنی هەموو خاکەکە جێبەجێ دەکات.","poem":2}]},{"type":"verse","number":24,"content":["بەڵام یەزدان، پەروەردگاری سوپاسالار ئەمە دەفەرموێت:",{"text":"«ئەی گەلی من کە لە سییۆن دانیشتووی،","poem":1},{"text":"لە ئاشور مەترسە","poem":2},{"text":"کە بە داردەست لێت دەدات و","poem":1},{"text":"گۆچانەکەی لێت بەرز دەکاتەوە لەسەر شێوازی میسرییەکان.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"بەم زووانە هەڵچوونم لەسەر ئێوە نامێنێت و","poem":1},{"text":"تووڕەییم بۆ لەناوچوونی ئەوان دەبێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"یەزدانی سوپاسالار بە قامچی لێی دەدات","poem":1},{"text":"وەک لێدانەکەی میدیان لەلای تاشەبەردی عۆرێڤ و","poem":2},{"text":"گۆچانەکەی بەسەر دەریاوەیە","poem":1},{"text":"لەسەر شێوازی میسرییەکان بەرزی دەکاتەوە.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"جا لەو ڕۆژەدا،","poem":1},{"text":"باری لەسەر شانت لادەچێت و","poem":2},{"text":"نیری","poem":1},{"noteId":22},{"text":"لەسەر ملت،","poem":1},{"text":"لەبەر قەڵەوبوونت نیر دەتەقێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"گەیشتە","poem":1},{"noteId":23},{"text":"عەییات،","poem":1},{"text":"لە میگرۆن پەڕییەوە،","poem":2},{"lineBreak":true},{"text":"لە میخماس کەلوپەلەکانی خۆی دانا.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ئەوان لە دەربەندەکە دەپەڕنەوە و دەڵێن:","poem":1},{"text":"«گەڤەع شوێنی شەو مانەوەیە.»","poem":2},{"text":"ڕامە داچڵەکی،","poem":1},{"text":"گیڤعای شاول هەڵات.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ئەی دانیشتووانی شاری گەلیم، بە دەنگی خۆتان بحیلێنن!","poem":1},{"text":"ئەی لەیشا، گوێ بگرە!","poem":2},{"lineBreak":true},{"text":"داماوە عەناتۆت.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"مەدمێنا ڕایکردووە،","poem":1},{"text":"خەڵکی گێڤیم پەناگیر بوون.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ئەمڕۆ لە نۆڤ دەوەستن،","poem":1},{"text":"بە ڕاوەشاندنی دەست هەڕەشە دەکەن","poem":2},{"text":"لە کێوەکەی شاری سییۆن،","poem":1},{"text":"لە گردەکەی ئۆرشەلیم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"ئەوەتا یەزدان، پەروەردگاری سوپاسالار","poem":1},{"text":"بە هێزێکی تۆقێنەر لق دەبڕێتەوە.","poem":2},{"text":"باڵا بەرزەکان دەبڕدرێنەوە،","poem":1},{"text":"لووتبەرزەکان نزم دەکرێن.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"چڕی دارستانەکان بە تەور دەبڕێتەوە،","poem":1},{"text":"لوبنانیش بەرامبەر بە خودای توانادار دەکەوێت.","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"نازناوە بۆ خودای ئیسرائیل.‏","reference":{"chapter":10,"verse":17}},{"noteId":22,"caller":"+","text":"مەبەستی لە بارگرانییە.‏","reference":{"chapter":10,"verse":27}},{"noteId":23,"caller":"+","text":"مەبەستی لە هاتنی سوپای ئاشورە بۆ شارۆچکەکانی باکووری یەهودا.‏","reference":{"chapter":10,"verse":28}}]},"thisChapterLink":"/api/ckb_bib/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}