{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["لقەکە لە بنەماڵەی یەسا"]},{"type":"verse","number":1,"content":[{"text":"چڵێک لە بنەداری یەسا دەردەچێت،","poem":1},{"text":"لقێکی نوێ لە ڕەگەکەیەوە دەڕوێت.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ڕۆحی یەزدان لەسەری دەنیشێتەوە،","poem":1},{"text":"ڕۆحی دانایی و تێگەیشتن،","poem":2},{"text":"ڕۆحی ڕاوێژ و ئازایەتی،","poem":1},{"text":"ڕۆحی زانین و لەخواترسی،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بە لەخواترسی شادمان دەبێت.","poem":1},{"lineBreak":true},{"text":"بەگوێرەی بینینی چاوی خۆی دادوەری ناکات،","poem":1},{"text":"بەگوێرەی بیستنی گوێی خۆی بڕیار نادات،","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بەڵکو بە ڕاستودروستی دادوەری بۆ هەژاران دەکات و","poem":1},{"text":"بە ڕاستی بڕیار بۆ نەدارانی جیهان دەدات.","poem":2},{"text":"بە داردەستی دەمی لە زەوی دەدات،","poem":1},{"text":"بە بای لێوەکانی بەدکاران دەکوژێت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ڕاستودروستی دەبێتە پشتێن و","poem":1},{"text":"دڵسۆزیش دەبێتە کەمەربەند بە ناوقەدیەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"گورگ لەگەڵ بەرخ نیشتەجێ دەبێت،","poem":1},{"text":"پڵنگ لەگەڵ کارەبزن پاڵ دەداتەوە،","poem":2},{"text":"گوێرەکە و بەچکە شێر و دابەستە پێکەوەن و","poem":1},{"text":"منداڵێکی بچووک بەڕێوەیان دەبات.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"مانگا و ورچ پێکەوە دەلەوەڕێن،","poem":1},{"text":"بێچووەکانیان پێکەوە پاڵ دەدەنەوە،","poem":2},{"lineBreak":true},{"text":"شێر وەکو گا کا دەخوات.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"کۆرپەی شیرەخۆرە لەسەر کونی ماری کۆبرا یاری دەکات،","poem":1},{"text":"لەشیربڕاوە دەست دەباتە ناو کونی مارەوە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"خراپە و گەندەڵی ناکەن لە هەموو کێوی پیرۆزم،","poem":1},{"text":"چونکە زەوی پڕ دەبێت لە ناسینی یەزدان","poem":2},{"lineBreak":true},{"text":"هەروەک ئاو دەریا دادەپۆشێت.","poem":2}]},{"type":"verse","number":10,"content":["لەو ڕۆژەدا ڕەگەکەی یەسا کە چەقاوە وەک ئاڵای گەلان، نەتەوەکان داوای ئەو دەکەن و شوێنی حەوانەوەی شکۆدار دەبێت."]},{"type":"verse","number":11,"content":["لەو ڕۆژەدا پەروەردگار دووبارە دەستی درێژ دەکاتەوە بۆ کڕینەوەی پاشماوەی گەلەکەی خۆی، ئەوەی ماوەتەوە لە ئاشور، لە پاشایەتی باکووری میسر و پاشایەتی باشووری میسر، لە کوش",{"noteId":24},"، ئیلام، بابل، حەمات و لە دوورگەکانی دەریا."]},{"type":"verse","number":12,"content":[{"text":"ئاڵایەک بۆ نەتەوەکان بەرز دەکاتەوە و","poem":1},{"text":"دوورخراوەکانی ئیسرائیل کۆدەکاتەوە،","poem":2},{"text":"پەرتەوازەکانی یەهودا خڕدەکاتەوە","poem":1},{"text":"لە هەر چوار لای زەوییەوە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بەغیلی ئەفرایم نامێنێت و","poem":1},{"text":"هەراسانی یەهوداش دەبڕدرێتەوە،","poem":2},{"text":"ئەفرایم بەغیلی بە یەهودا نابات و","poem":1},{"text":"یەهوداش ئەفرایم هەراسان ناکات.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"پێکەوە ڕووەو دەریا بەلای زوورگەکان پەلاماری فەلەستییەکان دەدەن و","poem":1},{"text":"خەڵکی ڕۆژهەڵات تاڵان دەکەن.","poem":2},{"text":"ئەدۆم و مۆئاب ژێردەستەیان دەبن،","poem":1},{"text":"عەمۆنییەکانیش گوێڕایەڵیان دەبن.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"یەزدان کەنداوی دەریای میسر","poem":1},{"text":"تێکوپێک دەدات،","poem":2},{"text":"بە بایە سووتێنەرەکەی","poem":1},{"text":"دەستی ڕادەوەشێنێت بەسەر فوراتدا،","poem":2},{"text":"لێی دەدات و دەیکاتە حەوت جۆگە","poem":1},{"text":"بە پێڵاوەوە بەناویدا دەڕۆن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"دەبێت بە ڕێگا بۆ پاشماوەی گەلەکەی","poem":1},{"text":"ئەوانەی لە ئاشور دەمێننەوە","poem":2},{"text":"وەک ئەوەی بۆ ئیسرائیل بوو","poem":1},{"text":"لەو ڕۆژەی لە خاکی میسرەوە هاتنە دەرەوە.","poem":2}]}],"footnotes":[{"noteId":24,"caller":"+","text":"واتا ئەو ناوچەیە کە نزیکی سەرچاوەی ڕووباری نیل.‏","reference":{"chapter":11,"verse":11}}]},"thisChapterLink":"/api/ckb_bib/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}