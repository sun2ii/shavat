{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["گۆرانی ستایش"]},{"type":"verse","number":1,"content":[{"text":"لەو ڕۆژەدا دەڵێیت:","poem":1},{"text":"«ئەی یەزدان، ستایشت دەکەم،","poem":2},{"text":"هەرچەندە لێم تووڕە بوویت،","poem":1},{"text":"بەڵام تووڕەییەکەت لە من دامرکایەوە و دڵت دامەوە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەوەتا خودای ڕزگاریی من،","poem":1},{"text":"دڵنیا دەبم و ناترسم،","poem":2},{"text":"چونکە یەزدانی پەروەردگار هێز و سروودی منە و","poem":1},{"text":"ئەو بوو بە ڕزگاریم.»","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بە شادییەوە ئاو دەکێشنەوە","poem":1},{"text":"لە کانییەکانی ڕزگاری.","poem":2}]},{"type":"verse","number":4,"content":["لەو ڕۆژەدا دەڵێن:",{"text":"«ستایشی یەزدان بکەن، ناوی ڕابگەیەنن،","poem":1},{"text":"وا بکەن کردارەکانی لەنێو گەلاندا زانراو بێت،","poem":2},{"lineBreak":true},{"text":"باسی ئەوە بکەن کە ناوی بەرز بووەتەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"گۆرانی بۆ یەزدان بڵێن،","poem":1},{"text":"چونکە کاری شکۆمەندانەی کردووە،","poem":2},{"lineBreak":true},{"text":"با ئەمە لە هەموو جیهاندا زانراو بێت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەی نیشتەجێی سییۆن دەنگ بەرز بکەرەوە و هاوار بکە!","poem":1},{"text":"چونکە خودا پیرۆزەکەی ئیسرائیل لەنێوتاندا مەزنە.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}