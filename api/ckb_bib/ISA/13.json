{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["سروشێک سەبارەت بە بابل"]},{"type":"verse","number":1,"content":["سروشێک",{"noteId":25},"سەبارەت بە بابل ئەوەی ئیشایای کوڕی ئامۆچ بینی:"]},{"type":"verse","number":2,"content":[{"text":"لەسەر کێوێکی ڕووت ئاڵایەک هەڵبکەن،","poem":1},{"text":"دەنگیان لێ بەرز بکەنەوە،","poem":2},{"text":"دەست ڕابشەکێنن با بێنە ژوورەوە","poem":1},{"text":"بۆ ناو دەرگای میران.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"من فەرمانم بە تەرخانکراوەکانم کرد،","poem":1},{"text":"هەروەها بانگی پاڵەوانەکانی خۆمم کرد لەبەر تووڕەییم،","poem":2},{"lineBreak":true},{"text":"ئەو پاڵەوانانەی دڵخۆشن بە سەرکەوتنم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"گوێ بگرن، دەنگی هەراوهۆریا لە چیاکان دێت،","poem":1},{"text":"وەک دەنگی خەڵکێکی ئێجگار زۆر!","poem":2},{"text":"گوێ بگرن، دەنگی هاتوهەرای شانشینەکان دێت،","poem":1},{"text":"وەک دەنگی نەتەوەکان کۆبوونەتەوە!","poem":2},{"text":"یەزدانی سوپاسالار","poem":1},{"text":"سوپایان لێ پێکدەهێنێت بۆ جەنگ!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لە خاکێکی دوورەوە دێن،","poem":1},{"text":"لەوپەڕی ئاسمانەوە دێن،","poem":2},{"text":"یەزدان و چەکەکانی تووڕەیی،","poem":1},{"text":"بۆ تێکوپێکدانی سەراپای زەوی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"واوەیلا بکەن، چونکە ڕۆژی یەزدان","poem":1},{"noteId":26},{"text":"نزیک بووەتەوە،","poem":1},{"text":"وەک وێرانبوون لەلایەن خودای هەرە بەتواناوە دێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لەبەر ئەوە هەموو دەستەکان شل دەبن،","poem":1},{"text":"هەموو دڵێکی مرۆڤ دەتوێتەوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ڕادەچڵەکێن،","poem":1},{"text":"ئازار و ژان دەیانگرێت،","poem":2},{"lineBreak":true},{"text":"وەک منداڵبوو دەتلێنەوە.","poem":2},{"text":"پیاو واقی وڕدەمێنێت لە هاوڕێکەی،","poem":1},{"text":"ڕوویان وەک ڕووی گڕی ئاگرە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەوەتا ڕۆژی یەزدان دێت،","poem":1},{"text":"سەختە، توندوتیژ و تووڕەیی بە جۆشە،","poem":2},{"text":"بۆ ئەوەی زەوی وێران بکات و","poem":1},{"text":"گوناهبارانی لێ ببڕێتەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەستێرەکانی ئاسمان و کەلووەکانی","poem":1},{"text":"ڕووناکییان دەرناخەن،","poem":2},{"text":"خۆر لە کاتی هەڵاتنی تاریک دادێت،","poem":1},{"text":"مانگیش ڕووناکییەکەی نادرەوشێتەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"سزای جیهان دەدەم لەسەر خراپەکەی،","poem":1},{"text":"بەدکارانیش لەسەر تاوانەکانیان،","poem":2},{"text":"کۆتایی دەهێنم بە فیزی لووتبەرزان و","poem":1},{"text":"سەری بێ ویژدانەکان شۆڕ دەکەم.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"مرۆڤ لە زێڕی بێگەرد دەگمەنتر دەکەم و","poem":1},{"text":"ئادەمیزادیش لە زێڕی ئۆفیر.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لەبەر ئەوە ئاسمان دەهەژێنم و","poem":1},{"text":"زەویش لە شوێنی خۆی دەلەرزێت،","poem":2},{"text":"لەبەر تووڕەیی یەزدانی سوپاسالار و","poem":1},{"text":"لە ڕۆژی هەڵچوونی تووڕەییەکەی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"وەک مامزی ڕاونراو دەبێت و","poem":1},{"text":"وەک ڕانە مەڕ کەس نەبێت کۆی بکاتەوە،","poem":2},{"text":"هەرکەسە ڕوو لە گەلەکەی خۆی دەکات و","poem":1},{"text":"هەرکەسە بەرەو خاکەکەی خۆی هەڵدێت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەوەی بدۆزرێتەوە دەدرێتە بەر خەنجەر و","poem":1},{"text":"ئەوەی بگیرێت بە شمشێر دەکوژرێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"منداڵەکانیان لەبەرچاویان پارچەپارچە دەکرێن و","poem":1},{"text":"ماڵیان تاڵان دەکرێت و ژنەکانیان زەوت دەکرێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ئەوەتا من مادەکان لە دژیان هەڵدەستێنم،","poem":1},{"text":"ئەوانەی گوێ بە زیو نادەن و","poem":2},{"lineBreak":true},{"text":"کەیفیان بە زێڕ نایەت.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"کەوانەکانیان لاوان تێکدەشکێنن،","poem":1},{"text":"بەزەییان بە کۆرپەکاندا نایەتەوە،","poem":2},{"lineBreak":true},{"text":"دڵیان بە منداڵان ناسووتێت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بابلی شکۆمەندی شانشینەکان و","poem":1},{"text":"جوانی شانازی بابلییەکان","poem":2},{"text":"وەک سەدۆم و عەمۆرا دەبێت،","poem":1},{"text":"کە لەلایەن خوداوە سەرەوژێر کرابێت.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"هەتاهەتایە ئاوەدان ناکرێتەوە و","poem":1},{"text":"نەوە دوای نەوە کەس تێیدا نیشتەجێ نابێت،","poem":2},{"text":"عەرەب لەوێ دەوار هەڵنادات،","poem":1},{"text":"شوانەکان لەوێ مێگەل مۆڵ نادەن.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"بەڵام لەوێ دڕندە بیابانییەکان ڕادەکشێن،","poem":1},{"text":"چەقەڵ خانووەکانی پڕ دەکەن؛","poem":2},{"text":"کوندەپەپوو لەوێ نیشتەجێ دەبێت،","poem":1},{"text":"تەگە لەوێ سەما دەکەن.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"کەمتیار لەناو قەڵاکانی بابل دەلوورێنێت،","poem":1},{"text":"چەقەڵیش لەناو کۆشکەکانی.","poem":2},{"text":"کاتەکەی نزیکە بۆ هاتن،","poem":1},{"text":"ڕۆژگاری درێژە ناکێشێت.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":25,"caller":"+","text":"‏فەرموودەیەکی خودایە کە لە ڕێگای ڕۆحی پیرۆزەوە بۆ مرۆڤ هاتبێت.‏","reference":{"chapter":13,"verse":1}},{"noteId":26,"caller":"+","text":"ڕۆژی سزادانی گوناهباران و ڕزگارکردنی گەلی خودا.‏","reference":{"chapter":13,"verse":6}}]},"thisChapterLink":"/api/ckb_bib/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}