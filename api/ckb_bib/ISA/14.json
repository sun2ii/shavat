{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"یەزدان بەزەیی بە یاقوبدا دێتەوە و","poem":1},{"text":"دیسان ئیسرائیل هەڵدەبژێرێتەوە،","poem":2},{"lineBreak":true},{"text":"لە خاکەکەی خۆیان دەیانحەسێنێتەوە،","poem":2},{"text":"نامۆکان خۆیانی پێوە دەلکێنن و","poem":1},{"text":"دێنە پاڵ بنەماڵەی یاقوب.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"گەلان دەیانگرن و","poem":1},{"text":"دەیانبەن بۆ شوێنی خۆیان،","poem":2},{"text":"بەڵام بنەماڵەی ئیسرائیل دەستیان بەسەردا دەگرن و","poem":1},{"text":"دەیانکەن بە کۆیلە و کەنیزە لە خاکی یەزدان،","poem":2},{"text":"دەبنە ڕاپێچکەری ڕاپێچکەرانیان و","poem":1},{"text":"دەسەڵاتدار دەبن بەسەر ستەمکارانیاندا.","poem":2}]},{"type":"verse","number":3,"content":["ئەو ڕۆژەی یەزدان لە ناخۆشی و هەراسانی و ئەو کۆیلایەتییە سەختەی چێژتت دەتحەسێنێتەوە،"]},{"type":"verse","number":4,"content":["ئەم پەندە بەسەر پاشای بابلدا هەڵدەدەیت و دەڵێیت:",{"text":"زۆردار چۆن کۆتایی پێ هات!","poem":1},{"text":"خۆبەزلزانەکە چۆن کۆتایی هات!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"یەزدان گۆچانی بەدکارانی شکاند،","poem":1},{"text":"داردەستی فەرمانڕەواکان،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەوانەی بە قینەوە لە گەلەکانیان دەدا،","poem":1},{"text":"لێدانێکی بێ بڕانەوە،","poem":2},{"text":"بە تووڕەییەوە دەسەڵاتیان لەسەر نەتەوەکان پەیڕەو دەکرد،","poem":1},{"text":"بێ بەزەیی دەیانچەوساندنەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"هەموو زەوی حەسایەوە و دڵنیابوو","poem":1},{"text":"بە هوتاف لێدان دەنگیان هەڵبڕی.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"هەروەها دار سنەوبەر و ئورزی لوبنانیش","poem":1},{"text":"شادن بەوەی بەسەرت هاتووە و دەڵێن:","poem":2},{"text":"«لەو کاتەوەی تۆ ڕاکشایت","poem":1},{"text":"داربڕ نەهاتووەتە سەرمان.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"جیهانی مردووان لە ژێرەوە دەوروژێنێت","poem":1},{"text":"بۆ پێشوازی لە هاتنت،","poem":2},{"text":"ڕۆحی مردووەکان بۆ تۆ هەڵدەستێنێت،","poem":1},{"text":"هەموو سەرکردەکانی جیهان،","poem":2},{"text":"لەسەر تەختەکانیان هەڵیاندەستێنێت،","poem":1},{"text":"هەموو پاشایانی نەتەوەکان.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"هەموو وەڵام دەدەنەوە و پێت دەڵێن:","poem":1},{"text":"«هەروەها تۆش وەک ئێمە لاواز بوویت،","poem":2},{"lineBreak":true},{"text":"وەک ئێمەت لێ هات.»","poem":2}]},{"type":"verse","number":11,"content":[{"text":"مەزنیت شۆڕکرایەوە ناو جیهانی مردووان","poem":1},{"text":"بەدەم ئاوازی سازەکانت،","poem":2},{"text":"لە ژێرت مۆرانە ڕادەخرێت و","poem":1},{"text":"کرمیش دەبێتە لێفەت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"چۆن لە ئاسمانەوە بەربوویتەوە،","poem":1},{"text":"ئەی ئەستێرەی پڕشنگدار،","poem":2},{"noteId":27},{"text":"کوڕی بەرەبەیان!","poem":2},{"text":"بەرەو زەوی بڕایتەوە،","poem":1},{"text":"ئەی بەزێنەری نەتەوەکان!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"تۆ کە لە دڵی خۆتدا گوتت:","poem":1},{"text":"«سەردەکەوم بۆ ئاسمان،","poem":2},{"text":"لە سەرووی ئەستێرەکانی خوداوە","poem":1},{"text":"تەختی خۆم بەرز دەکەمەوە،","poem":2},{"text":"لەسەر کێوی ژووان دادەنیشم،","poem":1},{"text":"لەسەر لووتکەی چافۆن.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"سەردەکەومە سەر بەرزاییەکانی هەور،","poem":1},{"text":"خۆم وەک خودای هەرەبەرز لێدەکەم.»","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بەڵام بەرەو جیهانی مردووان شۆڕ بوویتەوە،","poem":1},{"text":"بەرەو قووڵایی بیری بێ بن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ئەوانەی دەتبینن تەماشات دەکەن،","poem":1},{"text":"لێت ورد دەبنەوە:","poem":2},{"text":"«ئایا ئەمە ئەو پیاوەیە کە زەوی لەرزاند،","poem":1},{"text":"شانشینەکانی هەژاند،","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئەوەی جیهانی کردە چۆڵەوانی،","poem":1},{"text":"شارەکانی جیهانی تەفروتونا کرد،","poem":2},{"lineBreak":true},{"text":"ئەوەی دیلەکانی بەرەو ماڵی خۆیان بەڕەڵا نەکرد؟»","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"هەموو پاشایانی نەتەوەکان بە ڕێزەوە ڕاکشان،","poem":1},{"text":"هەریەکە و لە ئارامگای خۆی.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بەڵام تۆ لە گۆڕەکەتەوە تووڕ هەڵدەدرێیت","poem":1},{"text":"وەک چڵەدارێکی ڕەتکراوە.","poem":2},{"text":"دادەپۆشرێیت بە تەرمی کوژراوان","poem":1},{"text":"کە بە شمشێر لێیان دراوە،","poem":2},{"lineBreak":true},{"text":"شۆڕبووەوەکان بەرەو بەردەکانی بیری بێ بن.","poem":2},{"text":"وەک لاشەی پێشێلکراو،","poem":1}]},{"type":"verse","number":20,"content":[{"text":"لە ناشتن لەگەڵیاندا یەک ناگریت،","poem":2},{"text":"چونکە خاکەکەی خۆتت کاول کرد،","poem":1},{"text":"گەلەکەی خۆتت کوشت.","poem":2},{"lineBreak":true},{"text":"با توخمی خراپەکاران","poem":1},{"text":"هەتاهەتایە ناویان نەیەت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"سەربڕین بۆ کوڕەکانیان ئامادە بکەن","poem":1},{"text":"لەسەر تاوانی باوکانیان،","poem":2},{"text":"با هەڵنەستن بۆ ئەوەی زەوی داگیر بکەن و","poem":1},{"text":"ڕووی جیهان بە شار پڕ بکەنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«هەڵدەستمە سەریان،»","poem":1},{"text":"یەزدانی سوپاسالار دەفەرموێت.","poem":2},{"text":"«لە بابل ناو و پاشماوە و","poem":1},{"text":"نەوە و وەچە ڕیشەکێش دەکەم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":23,"content":[{"text":"«دەیکەم بە میراتی کوندەپەپوو و","poem":1},{"text":"گۆمی ئاو،","poem":2},{"text":"بە گسکی نەمان گسکی دەدەم،»","poem":1},{"text":"یەزدانی سوپاسالار دەفەرموێت.","poem":2}]},{"type":"heading","content":["پلان لە دژی ئاشور"]},{"type":"verse","number":24,"content":[{"text":"یەزدانی سوپاسالار سوێندی خوارد و فەرمووی:","poem":1},{"lineBreak":true},{"text":"«بێگومان هەروەک ئەوەی دامڕشتووە ئاوا دەبێت،","poem":1},{"text":"وەک ئەوەی پلانم بۆ داناوە دێتە دی.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ئاشور لە خاکەکەی خۆم دەشکێنم،","poem":1},{"text":"لەسەر چیاکانم پێشێلی دەکەم،","poem":2},{"text":"جا نیرەکەی لەسەریان لادەچێت و","poem":1},{"text":"بارگرانییەکەی لە کۆڵیان دەبێتەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ئەمە ئەو پلانەیە کە بۆ هەموو جیهان داڕێژراوە و","poem":1},{"text":"ئەمە ئەو دەستەیە کە بۆ سەر هەموو نەتەوەکان درێژکراوە.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"یەزدانی سوپاسالار پلانی داناوە، کێ پووچی دەکاتەوە؟","poem":1},{"text":"دەستی ئەوە درێژکراوە، کێ دەیگێڕێتەوە؟","poem":2}]},{"type":"heading","content":["سروشێک سەبارەت بە فەلەستییەکان"]},{"type":"verse","number":28,"content":[{"text":"لە ساڵی مردنی ئاحازی پاشادا ئەم سروشە هات:","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ئەی هەموو فەلەستییەکان شاد مەبن،","poem":1},{"text":"کە گۆچانی لێدەرەکەت شکا،","poem":2},{"text":"چونکە توولە مار لە ڕەگی مارەوە دەردەچێت و","poem":1},{"text":"بەرەکەی مارێکی سووتێنەری باڵدارە.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"هەژارترینی هەژاران بەخێو دەکرێن و","poem":1},{"text":"نەداران بە ئاسوودەیی پاڵ دەدەنەوە،","poem":2},{"text":"ڕەگی تۆش بە قاتوقڕی دەکوژم و","poem":1},{"text":"پاشماوەکەشت دەکوژرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ئەی دەروازە واوەیلا بکە! ئەی شار هاوار بکە!","poem":1},{"text":"ئەی فەلەستی سەراپات توایەوە!","poem":2},{"text":"چونکە دووکەڵ لە باکوورەوە دێت و","poem":1},{"text":"ناڕێکی لە ڕیزەکانی نابینرێت.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"چی وەڵامی نێردراوی نەتەوەکان دەدرێتەوە؟","poem":1},{"text":"«یەزدان سییۆنی دامەزراند و","poem":2},{"lineBreak":true},{"text":"لە ئەودا گەلە چەوسێنراوەکەی پەناگیر دەبن.»","poem":2}]}],"footnotes":[{"noteId":27,"caller":"+","text":"دەربڕینێکە نووسەر بە گاڵتەجاڕییەوە بە پاشای بابلی دەڵێت.‏","reference":{"chapter":14,"verse":12}}]},"thisChapterLink":"/api/ckb_bib/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}