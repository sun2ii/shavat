{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"بەرخ وەک سەرانە بنێرن","poem":1},{"text":"بۆ فەرمانڕەوای خاکەکە،","poem":2},{"text":"لە سەلەعەوە بە چۆڵەوانیدا","poem":1},{"text":"بەرەو چیاکەی شاری سییۆن.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"وەک باڵندەی هەڵاتوون","poem":1},{"text":"وەک لە هێلانە دەرپەڕێنراویان لێدێت،","poem":2},{"text":"کچانی مۆئاب","poem":1},{"text":"لە تەنکاییەکانی ڕووباری ئەرنۆن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«ڕاوێژ بکە،","poem":1},{"text":"دادوەری ئەنجام بدە،","poem":2},{"text":"لە قرچەی نیوەڕۆدا","poem":1},{"text":"سێبەرت وەک شەوی لێ بکە.","poem":2},{"text":"دەرکراوەکان بشارەوە،","poem":1},{"text":"هەڵاتووەکان ئاشکرا مەکە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"با ئاوارەکانی مۆئاب لەلات بمێننەوە،","poem":1},{"text":"لە ڕووی کاولکەر بۆیان ببە پەناگا.»","poem":2},{"lineBreak":true},{"text":"کاتێک چەوسێنەر کۆتایی پێ دێت،","poem":1},{"text":"کاولبوون نامێنێت،","poem":2},{"lineBreak":true},{"text":"پێشێلکاران لە خاکەکەدا لەناودەچن.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بە خۆشەویستی نەگۆڕ تەخت جێگیر دەبێت،","poem":1},{"text":"یەکێک لە بنەماڵەی داود","poem":2},{"lineBreak":true},{"text":"دادپەروەر و داواکاری دادپەروەری،","poem":2},{"text":"دەستپێشخەر بۆ ڕاستودروستی،","poem":1},{"text":"بە دڵسۆزییەوە لەسەری دادەنیشێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"لووتبەرزی مۆئابمان بیست،","poem":1},{"text":"لووتبەرزییەکی زۆر،","poem":2},{"text":"خۆبەزلزانی و لووتبەرزی و بەفیزی،","poem":1},{"text":"بەڵام قسە پووچەکانی ناچەسپێن.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لەبەر ئەوە با خەڵکی مۆئاب واوەیلا بکەن،","poem":1},{"text":"سەراپا بۆ مۆئاب واوەیلا بکەن.","poem":2},{"text":"ئەی مۆئابییە بەزێنراوەکان،","poem":1},{"text":"بۆ نانی کشمیشی","poem":2},{"noteId":30},{"text":"قییر حەراسەت شیوەن بگێڕن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"کێڵگەکانی حەشبۆن سیس بوون،","poem":1},{"text":"هەروەها ڕەزەکەی سیڤما.","poem":2},{"text":"گەورەکانی نەتەوەکان","poem":1},{"text":"شا مێوەکانییان شکاند،","poem":2},{"text":"کە گەیشتبووە یەعزێر و","poem":1},{"text":"پەلی هاویشت هەتا چۆڵەوانی.","poem":2},{"text":"لقەکانی درێژ ببوونەوە و","poem":1},{"text":"لە دەریا پەڕیبوونەوە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"لەبەر ئەوە گریانی یەعزێر دەگریێم","poem":1},{"text":"بۆ ڕەزەکەی سیڤما،","poem":2},{"text":"بە فرمێسکەکانم ئاوتان دەدەم","poem":1},{"text":"ئەی حەشبۆن و ئەلعالێ!","poem":2},{"text":"لە کاتی میوە گەییوەکانت و دروێنەکانت","poem":1},{"text":"هەراوزەنای جەنگ هات.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"خۆشی و شادی لە باخ بڕایەوە،","poem":1},{"text":"لەناو ڕەزان گۆرانی ناگوترێت و هاوار ناکرێت،","poem":2},{"text":"شەراب لەناو گوشەر ناگوشرێت،","poem":1},{"text":"هوتاف کپ بوو.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لەبەر ئەوە هەناوم وەک قیسارە بۆ مۆئاب دەناڵێنێت،","poem":1},{"text":"ناخیشم بۆ قییر حەراسەت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"جا کە مۆئاب لە نزرگەی سەر بەرزاییەکە دەردەکەوێت،","poem":1},{"text":"ماندوو دەبێت.","poem":2},{"text":"کە دەچێتە ناو نزرگەکەوە نوێژ بکات،","poem":1},{"text":"قبوڵ نابێت.","poem":2}]},{"type":"verse","number":13,"content":["ئەمە ئەو فەرمایشتەیە کە یەزدان پێشتر بە مۆئابی فەرموو."]},{"type":"verse","number":14,"content":["ئێستاش یەزدان دەدوێت و دەفەرموێت: «لە ماوەی سێ ساڵدا وەک ساڵەکانی کرێگرتە، سەنگینی مۆئاب سووک دەبێت، بەو هەموو خەڵکە زۆرەوە، پاشماوەکەی زۆر کەم و لاواز دەبێت.»"]}],"footnotes":[{"noteId":30,"caller":"+","text":"نانی کشمیش بۆ بەعل پێشکەش دەکرا وەک سوپاسگوزاری بۆ دروێنە و خەرمان.‏","reference":{"chapter":16,"verse":7}}]},"thisChapterLink":"/api/ckb_bib/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}