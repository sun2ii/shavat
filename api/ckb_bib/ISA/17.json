{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":17,"content":[{"type":"heading","content":["سروشێک سەبارەت بە دیمەشق"]},{"type":"verse","number":1,"content":["سروشێک سەبارەت بە دیمەشق:",{"text":"«بڕوانە، دیمەشق لەنێو شاران دەسڕێتەوە و","poem":1},{"text":"دەبێتە تەپەیەکی ڕووخاو.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"شارەکانی عەرۆعێر بەجێماون و","poem":1},{"text":"بۆ مێگەلەکان دەبن،","poem":2},{"text":"تێیدا ڕادەکشێن،","poem":1},{"text":"کەس نییە بیانترسێنێت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"قەڵا لە ئەفرایم نامێنێت و","poem":1},{"text":"پاشایەتیش لە دیمەشق.","poem":2},{"text":"پاشماوەی ئارام وەک","poem":1},{"text":"شکۆمەندی نەوەی ئیسرائیلی لێ دێت،»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانی سوپاسالارە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«لەو ڕۆژەدا شکۆمەندی یاقوب نزم دەبێتەوە،","poem":1},{"text":"قەڵەوی گۆشتەکەی لاواز دەبێت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"وەک کۆکردنەوەی دەغڵی بەپێوە ڕاوەستاو دەبێت لەلایەن دروێنەکەرانەوە،","poem":1},{"text":"بازووشی گوڵەگەنم دەدروێتەوە.","poem":2},{"text":"وەک هەڵگرتنەوەی گوڵەگەنم دەبێت","poem":1},{"text":"لە دۆڵی ڕفایم.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"وەک تەکاندنی دار زەیتوون","poem":1},{"text":"کە پاشماوەی تێدا دەمێنێتەوە،","poem":2},{"text":"دوو یان سێ دەنک لەسەر چڵەکان،","poem":1},{"text":"چوار یان پێنج لە لقە بەردارەکان.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە، خودای ئیسرائیل.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"لەو ڕۆژەدا مرۆڤ ئاوڕ لە دروستکەرەکەی دەداتەوە و","poem":1},{"text":"چاوەکانیش بەرەو خودا پیرۆزەکەی ئیسرائیلە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئاوڕ لە قوربانگاکان ناداتەوە","poem":1},{"text":"کە دروستکراوی دەستی خۆین،","poem":2},{"text":"ئەوەی پەنجەکانی دروستی کردوون سەیریان ناکات،","poem":1},{"text":"ستوونە ئەشێراکان","poem":2},{"noteId":31},{"text":"و قوربانگاکانی بخوور.","poem":2}]},{"type":"verse","number":9,"content":["لەو ڕۆژەدا شارە قەڵابەندەکانی وەک کەلاوەی چۆڵکراوی ناو دارستانەکان و چڵەدارەکانی لێدێت کە لە ڕووی نەوەی ئیسرائیل چۆڵیان کردن، جا وێران دەبێت."]},{"type":"verse","number":10,"content":[{"text":"خودای ڕزگارکەری خۆتت لەبیر چوو،","poem":1},{"text":"تاشەبەردەکەت، قەڵاکەت بەبیر نەهاتەوە.","poem":2},{"text":"لەبەر ئەوە ڕووەکی چاک دەچێنن","poem":1},{"text":"بەڵام نەمامی نامۆ سەرهەڵدەدات.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەو ڕۆژەی دەیچێنیت، وای لێ دەکەیت نەمام بکات","poem":1},{"text":"بۆ بەیانی وای لێ دەکەیت گوڵ بکات،","poem":2},{"text":"بەڵام دروێنە لە ڕۆژی نەخۆشی و ئازاری","poem":1},{"text":"بێ چارەسەردا لەدەست دەچێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ئای لە هاژەهاژی خەڵکانێکی زۆر،","poem":1},{"text":"وەک هاژەی دەریا کە دەهەژێت!","poem":2},{"text":"خوڕەی نەتەوەکان","poem":1},{"text":"وەک خوڕەی ئاوی زۆر کە خوڕەی دێت!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"نەتەوەکان کە خوڕەیان دێت وەک خوڕەی ئاوی زۆر،","poem":1},{"text":"بەڵام تێیان ڕادەخوڕێت و بۆ دوور هەڵدێن،","poem":2},{"text":"وەک پووشی چیاکان لەبەردەم با ڕاو دەنرێت و","poem":1},{"text":"وەک تەپوتۆز لەبەردەم ڕەشەبا.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"دەمەو ئێوارە تۆقینێکی لەناکاوە!","poem":1},{"text":"بەرەبەیانێکی زوو نامێنن!","poem":2},{"text":"ئەمە بەشی تاڵانکارانمانە،","poem":1},{"text":"بەختی ڕاوڕووتکارانمانە.","poem":2}]}],"footnotes":[{"noteId":31,"caller":"+","text":"ستوونە ئەشێرا: هێمای خواژنە. بڕوانە یەکەم پاشایان 11‏:5‏‏.‏","reference":{"chapter":17,"verse":8}}]},"thisChapterLink":"/api/ckb_bib/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}