"type":"verse","number":4,"content":[{"text":"یەزدان ئەمەم پێ دەفەرموێت:","poem":1},{"text":"«هێمن دەبم و لە نشینگەی خۆمەوە تەماشا دەکەم","poem":2},{"text":"وەک گەرمایەکی ڕوون لە بەر هەتاودا،","poem":1},{"text":"وەک هەوری خوناو لە گەرمای دروێنەدا.»","poem":2}]},{"type":"verse","number":5,"content":[{"text":"پێش ترێ ڕنین لە کاتی تەواو چرۆکردن و","poem":1},{"text":"کاتێک گوڵەکان دەبن بە پەسیرەی گەییو،","poem":2},{"text":"چڵەکان بە داس دەبڕێتەوە و","poem":1},{"text":"لقەکان لێ دەکاتەوە و فڕێیان دەدات.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"پێکەوە بەجێدەهێڵدرێن بۆ بازەکانی چیا و","poem":1},{"text":"بۆ گیانلەبەرە کێوییەکانی زەوی،","poem":2},{"text":"بازەکان هاوینیان پێ بەسەردەبەن و","poem":1},{"text":"هەموو گیانلەبەرە کێوییەکانی زەویش زستانیان پێ بەسەردەبەن.","poem":2}]},{"type":"verse","number":7,"content":["لەو ڕۆژەدا دیاری پێشکەش بە یەزدانی سوپاسالار دەکرێت،",{"text":"لە گەلێکی باڵا بەرز و کۆسە،","poem":1},{"text":"گەلێکی ترسناک، دوور و نزیک،","poem":2},{"text":"نەتەوەیەکی بێگانە و پێشێلکار،","poem":1},{"text":"ئەوەی ڕووبارەکان زەوییەکەیانی دابەش کردووە،","poem":2},"بۆ شوێنی ناوی یەزدانی سوپاسالار لە کێوی سییۆن."]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}