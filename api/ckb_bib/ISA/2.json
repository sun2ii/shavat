{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["کێوی یەزدان"]},{"type":"verse","number":1,"content":["ئەو شتەی ئیشایای کوڕی ئامۆچ بینی سەبارەت بە یەهودا و ئۆرشەلیم:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["لە ڕۆژانی کۆتاییدا،",{"text":"کێوی پەرستگای یەزدان","poem":1},{"text":"لەسەر لووتکەی چیاکان جێگیر دەبێت،","poem":2},{"text":"بەسەر گردەکانەوە بەرز دەبێتەوە و","poem":1},{"text":"هەموو نەتەوەکان بە لێشاو بەرەو لای ئەو دەچن.","poem":2}]},{"type":"verse","number":3,"content":["زۆرێک لە گەلان بەڕێ دەکەون و دەڵێن:",{"text":"«وەرن با بەرەو کێوی یەزدان سەربکەوین،","poem":1},{"text":"بۆ ماڵەکەی خودای یاقوب.","poem":2},{"text":"فێری ڕێگاکانی خۆیمان دەکات،","poem":1},{"text":"بۆ ئەوەی بە ڕێچکەی ئەودا بڕۆین.»","poem":2},{"text":"فێرکردن لە سییۆنەوە دەردەچێت،","poem":1},{"text":"پەیامی یەزدانیش لە ئۆرشەلیمەوە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لەنێو نەتەوەکان دادوەری دەکات،","poem":1},{"text":"ناوبژی بۆ چەندین گەل دەکات.","poem":2},{"text":"شمشێرەکانیان دەکوتنەوە و دەیکەنە گاسن،","poem":1},{"text":"ڕمەکانیشیان دەکەنە داس.","poem":2},{"text":"هیچ نەتەوەیەک شمشێر لە نەتەوەیەکی دیکە هەڵناکێشێت،","poem":1},{"text":"چیتر فێری جەنگ نابن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ئەی بنەماڵەی یاقوب، وەرن،","poem":1},{"text":"با بە ڕووناکیی یەزداندا بڕۆین.","poem":2}]},{"type":"heading","content":["ڕۆژی یەزدان"]},{"type":"verse","number":6,"content":[{"text":"وازت لە گەلەکەی خۆت هێنا،","poem":1},{"text":"لە بنەماڵەی یاقوب،","poem":2},{"text":"پڕ بوون لە بیروبۆچوونەکانی ڕۆژهەڵات و","poem":1},{"text":"وەک فەلەستییەکان بەخت دەخوێننەوە،","poem":2},{"lineBreak":true},{"text":"پابەند بوون بە نەریتی بتپەرستەکان.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"خاکیان پڕبوو لە زێڕ و زیو،","poem":1},{"text":"گەنجینەکانی سنووریان نییە.","poem":2},{"text":"خاکیان پڕبوو لە ئەسپ و","poem":1},{"text":"گالیسکەکانی سنووریان نییە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"خاکیان پڕبوو لە بت،","poem":1},{"text":"کڕنۆشیان بۆ دەستکردی خۆیان برد،","poem":2},{"lineBreak":true},{"text":"کە بە پەنجەکانی خۆیان دروستیان کرد.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"جا مرۆڤ دەچەمێتەوە و","poem":1},{"text":"ئادەمیزاد نزم دەبێتەوە،","poem":2},{"lineBreak":true},{"text":"لێیان خۆش مەبە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"لە ڕووی سامی یەزدان و","poem":1},{"text":"شکۆی مەزنییەکەی،","poem":2},{"text":"بڕۆ ناو کەلەبەرد و","poem":1},{"text":"لەناو خۆڵ خۆت بشارەوە!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"چاوە بەفیزەکانی مرۆڤ نزم دەبێتەوە و","poem":1},{"text":"لووتبەرزیی ئادەمیزاد دەچەمێتەوە،","poem":2},{"text":"لەو ڕۆژەدا تەنها یەزدان بە گەورە دەزانرێت.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"یەزدانی سوپاسالار ڕۆژێکی هەیە","poem":1},{"text":"لە دژی هەموو خۆبەزلزان و لووتبەرزێک،","poem":2},{"lineBreak":true},{"text":"لە دژی هەموو خۆهەڵکێشێک کە","poem":2},{"lineBreak":true},{"text":"نزم دەبنەوە،","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لە دژی هەموو دار ئورزە بەرز و بڵندەکانی لوبنان،","poem":1},{"text":"لە دژی هەموو دار بەڕووەکانی باشان،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"لە دژی هەموو چیا بەرزەکان و","poem":1},{"text":"لە دژی هەموو کێوە بڵندەکان،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"لە دژی هەموو قوللەیەکی بەرز،","poem":1},{"text":"لە دژی هەموو شوورایەکی سەخت،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"لە دژی هەموو کەشتییەکانی تەرشیش،","poem":1},{"text":"لە دژی هەموو دەستکردێکی دڵگیر.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"جا فیزی مرۆڤ دەچەمێتەوە و","poem":1},{"text":"لووتبەرزی ئادەمیزاد نزم دەبێت،","poem":2},{"text":"لەو ڕۆژەدا تەنها یەزدان بە گەورە دەزانرێت و","poem":1}]},{"type":"verse","number":18,"content":[{"text":"هەموو بتەکان لەناودەچن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"کاتێک یەزدان بۆ هەژاندنی زەوی هەڵدەستێت،","poem":1},{"text":"مرۆڤ لە ڕووی سامی شکۆی مەزنییەکەی","poem":2},{"text":"دەچێتە ناو کەلێنی تاشەبەردەکان و","poem":1},{"text":"ناو چاڵەکانی خۆڵ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"لەو ڕۆژەدا مرۆڤ","poem":1},{"text":"ئەو بتە زیو و زێڕانەی","poem":2},{"text":"کە بۆ پەرستن دروستی کردوون،","poem":1},{"text":"بۆ مشکەکوێرە و شەمشەمەکوێرەیان فڕێدەدات.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"کاتێک یەزدان بۆ هەژاندنی زەوی هەڵدەستێت،","poem":1},{"text":"مرۆڤ لە ڕووی سامی شکۆی مەزنییەکەی","poem":2},{"text":"دەچێتە ناو کەلێنی تاشەبەردەکانەوە و","poem":1},{"text":"بۆ کەلەبەرەکانی ناو تاوێرەکان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"پشت بە مرۆڤ مەبەستە،","poem":1},{"text":"ئەوەی تەنها هەناسەیەکی لە لووتدایە.","poem":2},{"text":"بۆچی حیسابی بۆ دەکرێت؟","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/2.json","thisChapterAudioLinks":{},