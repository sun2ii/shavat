{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["سروشێک سەبارەت بە بابل"]},{"type":"verse","number":1,"content":["سروشێک سەبارەت بە چۆڵەوانی نزیکی دەریا",{"noteId":37},":",{"text":"وەک گەردەلوول لە باشوور هەڵدەکات،","poem":1},{"text":"لە چۆڵەوانییەوە دێت،","poem":2},{"lineBreak":true},{"text":"لە خاکێکی ترسناک.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ئەم بینینە ترسناکەم بۆ ئاشکرا کراوە:","poem":1},{"text":"ناپاک ناپاکی دەکات و تاڵانکەر تاڵان دەکات.","poem":2},{"text":"سەربکەوە ئەی ئیلام! گەمارۆ بدە ئەی میدیا!","poem":1},{"text":"کۆتاییم هێنا بە هەموو ئاخ هەڵکێشانەکەی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"لەبەر ئەوە کەلەکەم پڕ بووە لە ئازار،","poem":1},{"text":"ژانێک منی گرت، وەک ژانی منداڵبوون،","poem":2},{"text":"سەرسام بووم لە گوێگرتن،","poem":1},{"text":"واقم وڕما لە بینین.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"سەرم لێ شێوا،","poem":1},{"text":"ترس منی لەرزاند،","poem":2},{"text":"زەردەپەڕی خۆشیی منی","poem":1},{"text":"کردە تۆقین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"خوان ئامادە دەکەن،","poem":1},{"text":"ڕایەخ ڕادەخەن،","poem":2},{"lineBreak":true},{"text":"دەخۆن و دەخۆنەوە!","poem":2},{"text":"هەستن ئەی میران!","poem":1},{"text":"قەڵغان چەور بکەن!","poem":2}]},{"type":"verse","number":6,"content":["پاشان پەروەردگار ئەمەم پێ دەفەرموێت:",{"text":"«بڕۆ ئێشکگر بە پێوە ڕابگرە،","poem":1},{"text":"ئەوەی دەیبینێت با ڕایبگەیەنێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"کاتێک چەند گالیسکەیەک دەبینێت،","poem":1},{"text":"لەگەڵ ئەسپ سوار جووت جووت،","poem":2},{"lineBreak":true},{"text":"سواری گوێدرێژ یان سواری وشتر،","poem":2},{"text":"با بە تەواوی گوێی شل بکات،","poem":1},{"text":"زۆر شلی بکات.»","poem":2}]},{"type":"verse","number":8,"content":["ئینجا ئێشکگرەکە هاواری کرد:",{"text":"«گەورەم، من ڕۆژانە لەسەر قوللەی چاودێرییەکە ڕاوەستاوم،","poem":1},{"text":"هەموو شەوانیش لە بنکەی پاسەوانێتییەکەم دەمێنمەوە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەوەتا پیاوێک بە سواری گالیسکە هاتووە،","poem":1},{"text":"لەگەڵ ئەسپ سوار جووت جووت.","poem":2},{"text":"وەڵامی دەداتەوە و دەڵێت:","poem":1},{"text":"”کەوتووە، بابل کەوتووە!","poem":2},{"text":"هەموو وێنەی خوداوەندەکانی","poem":1},{"text":"بەرەو زەوی شکان!“»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ئەی خەڵکینە، کە لەسەر جۆخین جەنجەرکراون،","poem":1},{"text":"ئەوەی لە یەزدانی سوپاسالارەوە بیستوومە","poem":2},{"lineBreak":true},{"text":"لە خودای ئیسرائیلەوە پێتان ڕادەگەیەنم.","poem":2}]},{"type":"heading","content":["سروشێک سەبارەت بە ئەدۆم"]},{"type":"verse","number":11,"content":["سروشێک سەبارەت بە دوما:",{"text":"لە سێعیرەوە هاوارم بۆ دەکرێت،","poem":1},{"text":"«ئێشکگر، شەو چەندی ماوە؟","poem":2},{"lineBreak":true},{"text":"ئێشکگر، شەو چەندی ماوە؟»","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئێشکگرەکەش","poem":1},{"noteId":38},{"text":"وەڵام دەداتەوە:","poem":1},{"text":"«بەیانی دێت، هەروەها شەویش.","poem":2},{"text":"ئەگەر داواکارن، داوا بکەن،","poem":1},{"text":"بگەڕێنەوە، وەرن.»","poem":2}]},{"type":"heading","content":["سروشێک سەبارەت بە عەرەبستان"]},{"type":"verse","number":13,"content":["سروشێک سەبارەت بە عەرەبستان:",{"text":"ئەی کاروانی دیدانییەکان،","poem":1},{"text":"ئەوانەی لەنێو دەوەنەکانی عەرەبستان شەو بەسەردەبەن،","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"بەرەوپیری تینوو، ئاو بهێنن.","poem":2},{"text":"ئەی دانیشتووانی خاکی تێما،","poem":1},{"text":"بە نانەوە بەرەو ڕووی هەڵاتوو بچن،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"چونکە لە ڕووی شمشێر هەڵاتوون،","poem":1},{"text":"لە ڕووی شمشێری هەڵکێشراو،","poem":2},{"text":"لە ڕووی کەوانی توندکراو،","poem":1},{"text":"لە ڕووی سەختی جەنگ.","poem":2}]},{"type":"verse","number":16,"content":["پەروەردگار ئەمەم پێ دەفەرموێت: «دوای یەک ساڵی ڕەبەق، هەموو شکۆمەندی قێدار بەسەردەچێت و"]},{"type":"verse","number":17,"content":["پاشماوەی پاڵەوانە کەوان بەدەستەکانی نەوەی قێدار ژمارەیان کەم دەبن، چونکە یەزدانی پەروەردگاری ئیسرائیل فەرمووی.»"]}],"footnotes":[{"noteId":37,"caller":"+","text":"دەکرێت مەبەست لە ناوچەی خوارووی خاکی بابل بێت کە نزیکی کەنداوی فارس.‏","reference":{"chapter":21,"verse":1}},{"noteId":38,"caller":"+","text":"مەبەست لە پێغەمبەر ئیشایایە.‏","reference":{"chapter":21,"verse":12}}]},"thisChapterLink":"/api/ckb_bib/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}