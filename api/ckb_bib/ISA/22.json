break"},{"type":"verse","number":5,"content":[{"text":"یەزدان، پەروەردگاری سوپاسالار","poem":1},{"text":"ڕۆژێکی هەیە لە دۆڵی بینین","poem":2},{"lineBreak":true},{"text":"بۆ هاتوهەرا و سەرکوتکردن و سەرلێشێوان","poem":2},{"text":"بۆ دیوار بڕین و","poem":1},{"text":"هاوارکردن بۆ چیا.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئیلام تیردانی هەڵگرتووە","poem":1},{"text":"بە گالیسکە و پیادە و سوارەوە،","poem":2},{"lineBreak":true},{"text":"قییریش قەڵغانی دەرخست.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"جا هەڵبژاردەی دۆڵەکانت پڕ دەبێت لە گالیسکە و لە سوارەکان،","poem":1},{"text":"ڕیزیان بەستووە ڕووەو دەروازەکە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"داپۆشینی یەهودا نامێنێت.","poem":2},{"text":"جا لەو ڕۆژەدا دەڕوانیتە","poem":1},{"text":"چەکەکانی کۆشکی دارستان،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"کەلێنەکانی شاری داود دەبینن کە زۆر بوون و","poem":1},{"text":"ئاوی گۆمی خوارێ کۆدەکەنەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ماڵەکانی ئۆرشەلیم دەژمێرن و","poem":1},{"text":"ماڵەکان دەڕووخێنن بۆ پتەوکردنی شووراکە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەستێلێک دروستدەکەن لەنێوان دوو شووراکە،","poem":1},{"text":"بۆ ئاوی گۆمە کۆنەکە.","poem":2},{"text":"بەڵام نەتانڕوانییە یەزدانی دروستکەری،","poem":1},{"text":"ئەوەی لەمێژەوە شێوەی کێشابوو نەتانبینی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"یەزدان، پەروەردگاری سوپاسالار،","poem":1},{"text":"لەو ڕۆژەدا بانگەوازی کرد","poem":2},{"text":"بۆ گریان و شیوەن و","poem":1},{"text":"سەرتاشین و پۆشینی جلوبەرگی گوش.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بەڵام ئەوەتا خۆشی و شادی،","poem":1},{"text":"مانگا کوشتنەوە و مەڕ سەربڕین،","poem":2},{"lineBreak":true},{"text":"گۆشت خواردن و شەراب خواردنەوە!","poem":2},{"text":"«با بخۆین و بخۆینەوە،","poem":1},{"text":"چونکە سبەی دەمرین.»","poem":2}]},{"type":"verse","number":14,"content":["گوێم لێگرت یەزدانی سوپاسالار بۆی ئاشکرا کردم: «کەفارەت بۆ ئەم تاوانەتان ناکرێت تاکو دەمرن،» یەزدان، پەروەردگاری سوپاسالار دەفەرموێت."]},{"type":"verse","number":15,"content":["یەزدان، پەروەردگاری سوپاسالار ئەمە دەفەرموێت:",{"text":"«بڕۆ بۆ لای ئەو کارگێڕە،","poem":1},{"text":"شەڤنا ئەوەی سەرپەرشتیاری کۆشکەکەیە:","poem":2}]},{"type":"verse","number":16,"content":[{"text":"چیت هەیە لێرە و کێ ڕوخسەتی پێداویت،","poem":1},{"text":"هەتا گۆڕێک بۆ خۆت هەڵبکەنیت،","poem":2},{"text":"ئەی ئەوەی لە بەرزایی گۆڕی خۆتت هەڵکەندووە و","poem":1},{"text":"بۆ خۆت لەناو تاشەبەرد ماڵت تاشیوە؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«ئەی پاڵەوان، ئەوەتا یەزدان خەریکە بە توندی تووڕت دەدات و","poem":1},{"text":"بە هێزەوە لوولت دەکات،","poem":2}]},{"type":"verse","number":18,"content":[{"text":"وەک تۆپ بە توندی دەتپێچێتەوە و","poem":1},{"text":"بەرەو خاکێکی بەرفراوان تووڕت دەدات.","poem":2},{"text":"لەوێ دەمریت و","poem":1},{"text":"گالیسکەکانی شکۆمەندیت لەوێ دەبێت،","poem":2},{"lineBreak":true},{"text":"ئەی مایەی سووکایەتی ماڵی گەورەکەت!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"لە پلەکەت دەرتدەکەم و","poem":1},{"text":"لە پایەکەت فڕێدەدرێیتە خوارەوە.","poem":2}]},{"type":"verse","number":20,"content":["«لەو ڕۆژەدا بانگی بەندەکەی خۆم، بانگی ئەلیاقیمی کوڕی حیلقیا دەکەم و"]},{"type":"verse","number":21,"content":["جلەکەی تۆی لەبەر دەکەم و بە کەمەربەندەکەی تۆ کەمەری توند دەکەم و دەسەڵاتی تۆ دەدەمە دەست ئەو و دەبێت بە باوک بۆ ئۆرشەلیم و بۆ بنەماڵەی یەهودا."]},{"type":"verse","number":22,"content":["کلیلی ماڵی داود دەدەمە دەستی و ئەوەی ئەو دەیکاتەوە کەس ناتوانێت دایبخات و ئەوەی دایدەخات کەس ناتوانێت بیکاتەوە."]},{"type":"verse","number":23,"content":["وەک سنگ دەیچەقێنم لە شوێنێکی چەسپاو و دەبێت بە تەختی شکۆمەندی بۆ بنەماڵەکەی."]},{"type":"verse","number":24,"content":["هەموو شکۆمەندی بنەماڵەکەی بەوەوە هەڵدەواسن، چڵەکان و لقەکان، هەموو دەفرە بچووکەکان، لە دەفرە پەلەکانەوە هەتا دەفرە قووڵەکان.»"]},{"type":"verse","number":25,"content":["یەزدانی سوپاسالار دەفەرموێت: «بەڵام سەردەمێک دێت سنگە چەقاوەکە لە شوێنە چەسپاوەکە نامێنێت و دەشکێت و دەکەوێت، ئەو بارگرانییەی لەسەری بوو دەبڕدرێتەوە.» ئەوە فەرمایشتی یەزدانە."]}],"footnotes":[{"noteId":39,"caller":"+","text":"دۆڵی بینین: ناوێکی مەجازییە بۆ ئۆرشەلیم.‏","reference":{"chapter":22,"verse":1}}]},"thisChapterLink":"/api/ckb_bib/ISA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/21.json","previousChapterAudioLinks":{},"numberOfVerses":25}