{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["سروشێک سەبارەت بە شاری سور"]},{"type":"verse","number":1,"content":["سروشێک سەبارەت بە سور:",{"text":"واوەیلا بکەن ئەی کەشتییەکانی تەرشیش!","poem":1},{"text":"چونکە سور کاول کراوە،","poem":2},{"lineBreak":true},{"text":"نە خانوو نە بەندەری بە پێوە نەماوە،","poem":2},{"text":"لە خاکی قوبرسەوە پێیان ڕاگەیەنرا.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"بحەپەسێن دانیشتووانی دوورگەکە و","poem":1},{"text":"بازرگانانی سەیدا،","poem":2},{"lineBreak":true},{"text":"ئەوانەی دەریا دەبڕن، پڕیان کردوویت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"دانەوێڵەی شیحۆر","poem":1},{"text":"لەسەر ئاوە زۆرەکان دەهات،","poem":2},{"text":"داهاتی ئەو دروێنەی ڕووباری نیلە،","poem":1},{"text":"جا سور بوو بە بازاڕی نەتەوەکان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"شەرمەزار بە ئەی سەیدا، ئەی قەڵای دەریا!","poem":1},{"text":"چونکە دەریا گوتی:","poem":2},{"text":"«نە ژانم گرت و نە منداڵم بوو،","poem":1},{"text":"نە گەنجم گەورە کرد و نە کچی عازەبم پێگەیاند.»","poem":2}]},{"type":"verse","number":5,"content":[{"text":"کاتێک هەواڵ بە میسر دەگات،","poem":1},{"text":"بە هەواڵی سور ژان دەیانگرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"بپەڕنەوە بۆ تەرشیش،","poem":1},{"text":"واوەیلا بکەن، ئەی دانیشتووانی دوورگەکە!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئایا ئەمە شاری خۆشییە بۆتان،","poem":1},{"text":"ئەوەی دێرینی لە دێرزەمانەوەیە،","poem":2},{"text":"ئەوەی پێیەکانی بەرەو دووری دەبەن","poem":1},{"text":"بۆ ئاوارە بوون؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"کێ ئەم پلانەی لە دژی سوری تاج لەسەر داڕشت،","poem":1},{"text":"ئەوەی میران بازرگانەکانی ئەون،","poem":2},{"lineBreak":true},{"text":"فرۆشیارەکانی بەناوبانگەکانی زەوین؟","poem":2}]},{"type":"verse","number":9,"content":[{"text":"یەزدانی سوپاسالار پلانی داڕشتووە","poem":1},{"text":"بۆ گڵاوکردنی شانازی هەموو شکۆمەندییەک،","poem":2},{"lineBreak":true},{"text":"بۆ نزمکرنەوەی هەموو بەناوبانگەکانی زەوی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ئەی دانیشتووانی تەرشیش،","poem":1},{"text":"زەوییەکەتان وەک کەناری نیل بکێڵن،","poem":2},{"lineBreak":true},{"text":"ئیتر بەندەر نەما.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"یەزدان دەستی بەسەر دەریادا درێژکرد و","poem":1},{"text":"شانشینەکان تۆقین.","poem":2},{"text":"لە دژی فینیکیا فەرمانی دا","poem":1},{"text":"بۆ کاولبوونی قەڵاکانی.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"فەرمووی: «جارێکی دی شانازی ناکەیت،","poem":1},{"text":"ئەی سەیدای کچە پاکیزە","poem":2},{"noteId":40},{"text":"، ئێستا پێشێل کراویت!","poem":2},{"lineBreak":true},{"text":"«هەستە بەرەو قوبرس بپەڕەوە،","poem":1},{"text":"لەوێش حەوانەوەت نابێت.»","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەوەتا خاکی بابلییەکان،","poem":1},{"text":"گەلێکی لێیە کە بە هیچ دانانرێت!","poem":2},{"text":"ئاشور کردییە شوێنی دڕندە بیابانییەکان","poem":1},{"noteId":41},{"text":".","poem":1},{"text":"قوللەکانیان","poem":2},{"noteId":42},{"text":"دروستکرد،","poem":2},{"lineBreak":true},{"text":"قەڵاکانیان ڕووخاند،","poem":2},{"lineBreak":true},{"text":"کردیان بە کاولگە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ئەی کەشتییەکانی تەرشیش واوەیلا بکەن،","poem":1},{"text":"چونکە قەڵاکانتان کاول بوون.","poem":2}]},{"type":"verse","number":15,"content":["لەو ڕۆژەدا ئەوە دەبێت، سور حەفتا ساڵ لەبیر دەکرێت، بەقەد ڕۆژگاری پاشایەک. پاش حەفتا ساڵەکە وەک گۆرانی ژنە لەشفرۆشێک بۆ سور دەبێت:"]},{"type":"verse","number":16,"content":[{"text":"«دەست بدە قیسارە و بەناو شاردا بسووڕێوە","poem":1},{"text":"ئەی ژنە لەشفرۆشی لەبیرکراو!","poem":2},{"text":"باش مۆسیقا بژەنە و زۆر گۆرانی بڵێ","poem":1},{"text":"بۆ ئەوەی لەیاد نەکرێیت.»","poem":2}]},{"type":"verse","number":17,"content":["جا پاش حەفتا ساڵەکە، یەزدان سور بەسەردەکاتەوە و سور دەگەڕێتەوە سەر کرێ وەرگرتنی و لەگەڵ هەموو شانشینەکانی جیهان لەسەر ڕووی زەوی لەشفرۆشی دەکات."]},{"type":"verse","number":18,"content":["بەڵام بازرگانییەکەی و کرێ وەرگرتنەکەی تەرخانکراو دەبێت بۆ یەزدان. هەڵناگیرێت و لە گەنجینە ناکرێت، بەڵکو بازرگانییەکەی بۆ ئەوانە دەبێت کە لەبەردەم یەزدانن، بۆ ئەوەی بخۆن و تێر بن و جلی گرانبەها بپۆشن."]}],"footnotes":[{"noteId":40,"caller":"+","text":"پاکیزە: مەبەست لەپێش داگیرکردنیەتی، کە بەراوردی دەکات بە کچی پاکیزە.‏","reference":{"chapter":23,"verse":12}},{"noteId":41,"caller":"+","text":"بڕوانە ئیشایا 13‏:21 و یەرمیا 50‏:39‏‏.‏","reference":{"chapter":23,"verse":13}},{"noteId":42,"caller":"+","text":"قوللە لێرە مەبەست لە بورجێکە کە بە دار دروستکراوە لە کاتی شەڕدا بەکارهاتووە بۆ هێرشکردنە سەر شارێکی شوورابەند.‏","reference":{"chapter":23,"verse":13}}]},"thisChapterLink":"/api/ckb_bib/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}