وو،","poem":2},{"lineBreak":true},{"text":"گەورەترین خەڵکانی زەوی لەشیان داهێزرا.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"زەوی لەژێر دانیشتووانەکەی گڵاو بوو،","poem":1},{"text":"چونکە سەرپێچی فێرکردنەکانیان کرد،","poem":2},{"text":"فەرزەکانیان پێشێل کرد و","poem":1},{"text":"پەیمانی هەتاهەتاییان شکاند.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لەبەر ئەوە زەوی نەفرەتی خوارد و","poem":1},{"text":"دانیشتووانەکەی سزادران.","poem":2},{"text":"لەبەر ئەوە دانیشتووانی زەوی سووتان و","poem":1},{"text":"خەڵکێکی کەم مایەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"شەرابی نوێ شیوەن دەکات و ڕەزەمێو سیس بوو،","poem":1},{"text":"هەموو دڵخۆشەکان ئاخ هەڵدەکێشن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"دەفی دەنگ خۆش کپ بوو،","poem":1},{"text":"هاتوهەرای شادمانەکان بڕایەوە،","poem":2},{"lineBreak":true},{"text":"قیسارەی دەنگ خۆش کپ بوو.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بە دەم گۆرانییەوە شەراب ناخۆنەوە،","poem":1},{"text":"مەی بۆ نۆشەرەکەی تاڵ دەبێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"شاری وێران تێکشکاوە،","poem":1},{"text":"هەموو ماڵێک دادەخرێت، چوونە ژوورەوە نییە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لە شەقامەکان هاوارە بۆ شەراب","poem":1},{"text":"خۆرئاوا بوو بەسەر هەموو خۆشییەک،","poem":2},{"lineBreak":true},{"text":"دوورخرایەوە شادی زەوی.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەوەی لە شار دەمێنێتەوە وێرانەیە و","poem":1},{"text":"لێدانی دەروازەش کاولییە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئاوا دەبێت لەناوەندی زەوی","poem":1},{"text":"لەنێو گەلان،","poem":2},{"text":"وەک داتەکاندنی دار زەیتوون،","poem":1},{"text":"وەک کۆکردنەوەی هێشوو کە ڕنین تەواو دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ئەوان دەنگ هەڵدەبڕن، هوتافی خۆشی دەکێشن،","poem":1},{"text":"بۆ شکۆی یەزدان لە ڕۆژئاواوە هاوار دەکەن.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"لەبەر ئەوە لە ڕۆژهەڵات یەزدان شکۆدار بکەن،","poem":1},{"text":"لە دوورگەکانی دەریاشەوە","poem":2},{"lineBreak":true},{"text":"ناوی یەزدان، پەروەردگاری ئیسرائیل بەرز بکەنەوە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"لەوپەڕی زەوییەوە گوێمان لە گۆرانییەک بوو:","poem":1},{"text":"«شکۆمەندی بۆ خودای ڕاستودروست!»","poem":2},{"lineBreak":true},{"text":"جا گوتم: «فەوتام! فەوتام!","poem":1},{"text":"قوڕبەسەرم!","poem":2},{"text":"ناپاکان ناپاکییان کرد!","poem":1},{"text":"ناپاکان ناپاکییان لە ناپاکی کرد!»","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ترس و چاڵ و تەڵە","poem":1},{"text":"بەسەرتەوەیە ئەی دانیشتووی زەوی.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئەوەی لە دەنگی ترسەکە هەڵدێت","poem":1},{"text":"دەکەوێتە چاڵەکەوە و","poem":2},{"text":"ئەوەی لەناو چاڵەکە بێتە دەرەوە","poem":1},{"text":"بە تەڵەکەوە دەبێت.","poem":2},{"lineBreak":true},{"text":"بەربەستی جۆگەکان لە ئاسمانەوە کرانەوە و","poem":1},{"text":"بناغەکانی زەوی هەژان.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"زەوی بە شکان دەشکێت،","poem":1},{"text":"زەوی بە وردوخاشبوون وردوخاش دەبێت،","poem":2},{"lineBreak":true},{"text":"زەوی بە لەقین دەلەقێت.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"زەوی وەک سەرخۆش بە لادا دێت،","poem":1},{"text":"جۆلانە دەکات وەک کەپر لەبەردەم با.","poem":2},{"text":"یاخیبوونەکەی لەسەری قورسە،","poem":1},{"text":"دەکەوێت و جارێکی دیکە هەڵناستێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"لەو ڕۆژەدا یەزدان","poem":1},{"text":"سزای هێزەکان دەدات لە ئاسمان و","poem":2},{"lineBreak":true},{"text":"لەسەر زەوی سزای پاشایانی دەدات.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بە کۆمەڵ کۆیان دەکەنەوە","poem":1},{"text":"وەک دیل لە بەندیخانە و","poem":2},{"text":"لە گرتووخانە توند دەکرێن و","poem":1},{"text":"دوای ماوەیەکی درێژ سزا دەدرێن.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"مانگ ڕیسوا دەبێت و خۆر شەرمەزار دەبێت،","poem":1},{"text":"چونکە یەزدانی سوپاسالار حوکمڕانی دەکات","poem":2},{"text":"لە کێوی سییۆن و لە ئۆرشەلیم،","poem":1},{"text":"شکۆمەندیش لەبەردەم پیرانی ئەوە.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}