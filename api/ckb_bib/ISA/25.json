{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["ستایش بۆ یەزدان"]},{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، تۆ خودای منیت!","poem":1},{"text":"بە گەورەت دەزانم، ستایشی ناوت دەکەم،","poem":2},{"text":"چونکە تۆ کاری سەرسوڕهێنەرت کردووە،","poem":1},{"text":"پلانەکانت لە دێرزەمانەوەن،","poem":2},{"lineBreak":true},{"text":"بە دڵسۆزی چەسپاون.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"شارت کاول کرد و","poem":1},{"text":"شارۆچکەی قەڵابەندت وێران کرد،","poem":2},{"text":"قەڵای بێگانەکان وەک شار نامێنێتەوە،","poem":1},{"text":"بۆ هەتاهەتایە بنیاد نانرێتەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لەبەر ئەوە گەلی بەهێز ڕێزت لێ دەگرن،","poem":1},{"text":"شارۆچکەی نەتەوە بێ ویژدانەکان لێت دەترسن.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بوویت بە پەناگای هەژار،","poem":1},{"text":"پەناگای نەدار لە کاتی تەنگانە،","poem":2},{"text":"چەتر لە لێزمەی باران و","poem":1},{"text":"سێبەر لە گەرما،","poem":2},{"text":"چونکە هەڵچوونی بێ ویژدانەکان","poem":1},{"text":"لێزمەی بارانە بەسەر دیوارەوە،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"وەک گەرمایە لە خاکی وشکدا.","poem":1},{"text":"هاتوهەرای بێگانەکان کپ دەکرێت","poem":2},{"text":"وەک گەرما بە سێبەری هەور","poem":1},{"text":"گۆرانی بێ ویژدانەکان زەلیل دەکرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"یەزدانی سوپاسالار بۆ هەموو گەلان","poem":1},{"text":"لەم کێوە خوانی دابەستەکان ساز دەکات،","poem":2},{"text":"خوانی شەرابی سادە و دابەستە پڕ لە مۆخەکان","poem":1},{"text":"مەی سادەی پاڵاوتە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لەم کێوەدا لووشی دەدات","poem":1},{"text":"پەچەی سەر مردوو،","poem":2},{"text":"پەچە بەسەر هەموو گەلانەوە،","poem":1},{"lineBreak":true},{"text":"هەروەها ئەو سەرپۆشەی بەسەر هەموو نەتەوەکاندا پۆشراوە،","poem":1}]},{"type":"verse","number":8,"content":[{"text":"مردن لووشدەدات بۆ هەتاهەتایە.","poem":2},{"text":"یەزدانی باڵادەست فرمێسک","poem":1},{"text":"لەسەر هەموو ڕووەکان دەسڕێتەوە،","poem":2},{"text":"ڕیسوایی گەلەکەی دادەماڵێت","poem":1},{"text":"لە هەموو زەویدا،","poem":2},{"text":"چونکە یەزدان فەرمووی.","poem":4}]},{"type":"verse","number":9,"content":["لەو ڕۆژەدا دەگوترێت:",{"text":"«ئەوەتا ئەمە خودامانە،","poem":1},{"text":"چاوەڕێمان دەکرد، ڕزگاری کردین.","poem":2},{"text":"ئەمە یەزدانە، چاوەڕێمان دەکرد،","poem":1},{"text":"شاد دەبین و دڵشاد دەبین بە ڕزگارییەکەی.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"دەستی یەزدان ئەم کێوە دەپارێزێت،","poem":1},{"text":"بەڵام مۆئاب لە جێی خۆی پێپەست دەکرێت","poem":2},{"lineBreak":true},{"text":"وەک پێپەستکردنی کا بە ئاوی تەپاڵە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"جا مۆئاب لە ناوەڕاستیدا دەستی بڵاو دەکاتەوە","poem":1},{"text":"وەک چۆن مەلەوان بۆ مەلەکردن بڵاوی دەکاتەوە.","poem":2},{"text":"خودا لووتبەرزییەکەی دادەگرێت","poem":1},{"text":"لەگەڵ فرتوفێڵەکانی دەستی.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"قەڵابەندی بەرزی شووراکانت دەچەمێنێتەوە،","poem":1},{"text":"دایدەگرێت دەینووسێنێت بە زەوییەوە، هەتا خۆڵ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}