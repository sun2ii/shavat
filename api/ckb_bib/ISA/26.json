,"poem":2},{"text":"دەیدات بە زەویدا،","poem":1},{"text":"تەختی دەکات لەگەڵ خۆڵ.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"پێی هەژار و هەنگاوی نەدار","poem":1},{"text":"پێشێلی دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ڕێڕەوی کەسی ڕاستودروست ڕێکە،","poem":1},{"text":"ئەی خودای ڕاست، ڕێگای ڕاستودروست خۆش دەکەیت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەی یەزدان، لە ڕێی حوکمەکانت","poem":1},{"text":"چاوەڕێی تۆ دەکەین؛","poem":2},{"text":"ناوەکەت و یادکردنەوەت","poem":1},{"text":"ئارەزووی گیانمانە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"گیانم بە شەو ئارەزووت دەکات،","poem":1},{"text":"هەروەها لە بەیانیدا ڕۆحم لە ناخمدا پەرۆشە بۆت،","poem":2},{"text":"چونکە کاتێک حوکمەکانت لە زەوین،","poem":1},{"text":"دانیشتووانی جیهان فێری ڕاستودروستی دەبن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بەدکار بەر میهرەبانی بکەوێت،","poem":1},{"text":"فێری ڕاستودروستی نابێت،","poem":2},{"text":"لە خاکی ڕاستییەکاندا ناڕەوایی دەکات،","poem":1},{"text":"شکۆی یەزدان نابینێت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەی یەزدان تۆ باڵا دەستیت،","poem":1},{"text":"بەڵام ئەوان نایبینن.","poem":2},{"text":"با دڵگەرمیت بۆ گەلەکەت ببینن و شەرمەزار بن،","poem":1},{"text":"با ئەو ئاگرەی کە ئامادەت کردووە دوژمنەکانت بخوات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ئەی یەزدان ئاشتیمان دەدەیتێ،","poem":1},{"text":"چونکە لە ڕاستیدا هەموو کارەکانمان تۆ کردووتە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەی یەزدانی پەروەردگارمان،","poem":1},{"text":"گەورەکانی دیکە جگە لە تۆ، بوون بە گەورەمان،","poem":2},{"lineBreak":true},{"text":"بەڵام تەنها تۆ، یادی ناوی تۆ دەکەین.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەوان مردوون، زیندوو نابنەوە!","poem":1},{"text":"تارمایین، هەڵناستنەوە،","poem":2},{"text":"لەبەر ئەوە سزات دان و تێکت شکاندن،","poem":1},{"text":"هەموو یادگاریێکی ئەوانت لەناوبرد.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەی یەزدان، نەتەوەت زیاد کرد،","poem":1},{"text":"نەتەوەت زیاد کرد و","poem":2},{"text":"شکۆمەند بوویت،","poem":1},{"text":"هەموو سنوورەکانی خاکەکەت فراوان کرد.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ئەی یەزدان، لە تەنگانەدا هانایان بۆ هێنایت،","poem":1},{"text":"کاتێک تەمبێت کردن،","poem":2},{"lineBreak":true},{"text":"بە چرپەوە نوێژیان هەڵڕشت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"وەک ژنی سکپڕ کە لە منداڵبوون نزیک دەبێتەوە","poem":1},{"text":"لە ژاندا دەتلێتەوە و دەقیژێنێت،","poem":2},{"lineBreak":true},{"text":"ئاوامان لێ هات لەبەردەمت، ئەی یەزدان.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"سکپڕ بووین تلاینەوە","poem":1},{"text":"وەک ئەوەی بامان بووبێت.","poem":2},{"text":"لە زەویدا ڕزگاریمان بەرپا نەکرد و","poem":1},{"text":"کەسێکی جیهانمان لێ نەبوو.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"مردووەکانت زیندوو دەبنەوە،","poem":1},{"text":"لاشەکان هەڵدەستنەوە.","poem":2},{"text":"هەستن و گۆرانی بڵێن","poem":1},{"text":"ئەی دانیشتووانی خۆڵ،","poem":2},{"text":"چونکە شەونمت شەونمی بەیانییە،","poem":1},{"text":"زەوی تارماییەکانی لێ لەدایک دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"گەلەکەم بڕۆ، بڕۆ ناو ژوورەکانت و","poem":1},{"text":"دەرگاکەت لەدوای خۆت کلیل بدە،","poem":2},{"text":"بۆ ساتێک خۆت بشارەوە","poem":1},{"text":"هەتا تووڕەیی تێدەپەڕێت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئەوەتا یەزدان لە شوێنی خۆیەوە دێتە دەرەوە","poem":1},{"text":"هەتا سزای تاوانی دانیشتووانی زەوی بدات لەسەری.","poem":2},{"text":"زەوی خوێنەکانی ناو خۆی دەردەخات،","poem":1},{"text":"لەمەودوا کوژراوەکانی ناشارێتەوە.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/25.jso