{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["ڕزگاریی ئیسرائیل"]},{"type":"verse","number":1,"content":["لەو ڕۆژەدا،",{"text":"یەزدان بە شمشێرە","poem":1},{"text":"ڕەق و گەورە و بەهێزەکەی،","poem":2},{"text":"سزای لیڤیاتان دەدات کە مارە هەڵاتووەکەیە،","poem":1},{"text":"لیڤیاتان کە مارە پێچ خواردووەکەیە،","poem":2},{"text":"ئەژدیهاکەی ناو دەریاش دەکوژێت.","poem":1}]},{"type":"verse","number":2,"content":["لەو ڕۆژەدا",{"text":"«گۆرانی بۆ ڕەزەمێوی بەردار بڵێن:","poem":1}]},{"type":"verse","number":3,"content":[{"text":"من یەزدانم، چاودێری ئەوم،","poem":2},{"lineBreak":true},{"text":"هەموو ساتێک ئاوی دەدەم.","poem":2},{"text":"بە شەو و بە ڕۆژ چاودێری دەکەم","poem":1},{"text":"نەوەک ئازار بدرێت.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"هەڵچوونم نییە.","poem":2},{"text":"وای ئەگەر لە جەنگدا دڕکوداڵیان دەخستە بەرپێم!","poem":1},{"text":"من پێشێلم دەکردن و دەمسووتاندن،","poem":2},{"lineBreak":true},{"text":"گڕم لە هەموویان بەردەدا.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بەڵام ئەگەر پەنا بداتە پاڵ من","poem":1},{"text":"لەگەڵ من ئاشتی دەبەستێت،","poem":2},{"lineBreak":true},{"text":"ئاشتی لەگەڵ من دەبەستێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"لە داهاتوودا، یاقوب ڕەگ دادەکوتێت،","poem":1},{"text":"ئیسرائیل گوڵ دەکات و لق دەردەکات،","poem":2},{"lineBreak":true},{"text":"ڕووی جیهان پڕ بەروبووم دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئایا یەزدان لێیدان","poem":1},{"text":"بەو شێوەیەی لەوانەی دا کە لێیان دەدان؟","poem":2},{"text":"یان ئەوەندەی لێ کوشتن","poem":1},{"text":"وەک لە بکوژانی ئەوانی کوشت؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بە دوورخستنەوە و بە ڕاپێچکردن دژایەتی ئەوت کرد،","poem":1},{"text":"ڕایماڵی بە بای بەهێزی خۆی","poem":2},{"lineBreak":true},{"text":"لە ڕۆژێکی بای ڕۆژهەڵاتیدا.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"لەبەر ئەوە بەمە کەفارەت بۆ تاوانی یاقوب دەکرێت،","poem":1},{"text":"ئەمەش هەموو بەروبوومی داماڵینی گوناهەکەیەتی","poem":2},{"text":"بەوەی هەموو بەردەکانی قوربانگاکە","poem":1},{"text":"وەک بەردی گەچی وردوخاشکراو لێ بکات،","poem":2},{"text":"نە ستوونە ئەشێراکان و نە قوربانگاکانی خۆر","poem":1},{"text":"بە پێوە نەمێنێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"شاری قەڵابەند تەنهایە،","poem":1},{"text":"ماڵ چۆڵ و بەجێماوە وەک چۆڵەوانی،","poem":2},{"text":"لەوێ گوێرەکە دەلەوەڕێت و","poem":1},{"text":"لەوێ پاڵ دەداتەوە و","poem":2},{"lineBreak":true},{"text":"لقەکانی تێکدەدات.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"کە وشک دەبێت پۆپکەکانی دەشکێن و","poem":1},{"text":"ژنان دێن ئاگریان تێبەر دەدەن،","poem":2},{"text":"چونکە گەلێکی تێگەیشتوو نییە،","poem":1},{"text":"لەبەر ئەوە دروستکەرەکەی بەزەیی پێیاندا نایەتەوە و","poem":2},{"lineBreak":true},{"text":"شێوەکێشەکەی لەگەڵیدا میهرەبان نابێت.","poem":2}]},{"type":"verse","number":12,"content":["لەو ڕۆژەدا یەزدان دەیکوتێت لە ئاوەڕۆی فوراتەوە هەتا دۆڵی میسر، ئێوەش یەک بە یەک هەڵدەگیرێنەوە، ئەی نەوەی ئیسرائیل."]},{"type":"verse","number":13,"content":["لەو ڕۆژەدا فوو بە کەڕەنایەکی گەورەدا دەکرێت، جا ونبووەکان لە خاکی ئاشور و دوورخراوەکان بۆ خاکی میسر دێن و کڕنۆش بۆ یەزدان دەبەن لە کێوی پیرۆز لە ئۆرشەلیم."]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}