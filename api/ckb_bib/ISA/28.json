{"text":"ئەوەی دەیبینێت","poem":1},{"text":"هێشتا لە مستیەتی قووتی دەدات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"لەو ڕۆژەدا یەزدانی سوپاسالار","poem":1},{"text":"دەبێتە تاجەگوڵینەی جوانی و","poem":2},{"text":"تاجی شکۆمەندی","poem":1},{"text":"بۆ پاشماوەی گەلەکەی.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"دەبێتە ڕۆحی دادپەروەری","poem":1},{"text":"بۆ دانیشتوو لەسەر تەختی حوکمدان و","poem":2},{"text":"پاڵەوانیێتی","poem":1},{"text":"بۆ بەرەنگاربووانی جەنگ لەبەر دەروازەکان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئەمانیش بە شەراب گێژن و","poem":1},{"text":"بە مەی گومڕان:","poem":2},{"text":"کاهین و پێغەمبەر بە مەی گێژن،","poem":1},{"text":"بە شەراب قووتدەدرێن،","poem":2},{"text":"بە مەی گومڕان،","poem":1},{"text":"کە بینینیان بۆ ئاشکرا دەکرێت گێژن،","poem":2},{"lineBreak":true},{"text":"کوێرانە حوکم دەدەن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"هەموو مێزەکان پڕ بوون لە ڕشانەوە و","poem":1},{"text":"هیچ جێگایەک بێ پیسایی نەماوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"دەڵێن: «زانیاری فێری کێ دەکات؟","poem":1},{"text":"پەیام بۆ کێ ڕوون دەکاتەوە؟","poem":2},{"text":"بۆ لەشیربڕاوەکان،","poem":1},{"text":"یان بۆ لە مەمک بڕاوەکان؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"وەک گغە گغ بۆ گغە گغ،","poem":1},{"text":"بڤە بڤ بۆ بڤە بڤ،","poem":2},{"noteId":43},{"lineBreak":true},{"text":"کەمێک لێرە و کەمێک لەوێ.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"کەواتە خوداش بە لێوی بێگانە و زمانێکی نامۆ","poem":1},{"text":"قسە بۆ ئەم گەلە دەکات.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بۆ ئەوانەی پێی گوتن:","poem":1},{"text":"«ئەمە حەسانەوەیە،","poem":2},{"text":"با ماندوو بحەسێتەوە، ئەمە ئارامگایە.»","poem":1},{"text":"بەڵام نەیانویست گوێ بگرن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"جا فەرمایشتی یەزدان بۆیان دەبێت بە:","poem":1},{"text":"گغە گغ بۆ گغە گغ،","poem":2},{"lineBreak":true},{"text":"بڤە بڤ بۆ بڤە بڤ،","poem":2},{"lineBreak":true},{"text":"کەمێک لێرە و کەمێک لەوێ.","poem":2},{"text":"بۆ ئەوەی بڕۆن و بەرەو دواوە بکەون و","poem":1},{"text":"بشکێنەوە و ڕاو بکرێن و بگیرێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ئەی پیاوانی گاڵتەجاڕ، لەبەر ئەوە گوێ لە فەرمایشتی یەزدان بگرن،","poem":1},{"text":"ئەی فەرمانڕەوایانی ئەم گەلە کە لە ئۆرشەلیمن!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"گوتتان: «پەیمانمان لەگەڵ مردن بەستووە و","poem":1},{"text":"پەیماننامەمان لەگەڵ جیهانی مردووان مۆر کردووە،","poem":2},{"text":"کە قامچی لافاو تێدەپەڕێت","poem":1},{"text":"لە ئێمە نزیک ناکەوێتەوە،","poem":2},{"text":"چونکە درۆمان کردووە بە داڵدەمان و","poem":1},{"text":"لەناو ساختە پەناگیر دەبین.»","poem":2}]},{"type":"verse","number":16,"content":["لەبەر ئەوە یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«ئەوەتا بەردێک لە سییۆن دادەنێم،","poem":1},{"text":"کە دەبێتە سەنگی مەحەک،","poem":2},{"text":"گرنگترین و گرانبەهاترین بەردی بناغە","poem":1},{"noteId":44},{"text":"بۆ بناغەیەکی پتەو،","poem":1},{"text":"ئەوەی پشتی پێ ببەستێت ناشڵەژێت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"دادوەری دەکەمە گوریسی پێوانە و","poem":1},{"text":"بە شاووڵ ڕاستودروستی دەکەم،","poem":2},{"text":"جا تەرزە داڵدەی درۆ ڕادەماڵێت و","poem":1},{"text":"پەناگاش ئاو دایدەپۆشێت.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"پەیمانەکەتان لەگەڵ مردن دەسڕێتەوە و","poem":1},{"text":"پەیماننامەکەتان لەگەڵ جیهانی مردووان سەر ناگرێت.","poem":2},{"text":"کاتێک قامچی لافاو تێدەپەڕێت،","poem":1},{"text":"ئێوە بۆی دەبن بە پێشێل.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"هەر کاتێک تێبپەڕێت دەتانبات،","poem":1},{"text":"چونکە هەموو بەیانییەک تێدەپەڕێت","poem":2},{"lineBreak":true},{"text":"بە شەو و بە ڕۆژ.»","poem":2},{"lineBreak":true},{"text":"بە تەنها تێگەیشتنی پەیامەکە","poem":1},{"text":"دەبێتە مایەی تۆقاندن.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"دۆشەک کورت بووە بۆ ڕاکشان و","poem":1},{"text":"لێفەش تەنک بووە بۆ لەخۆپێچانەوە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"یەزدان هەڵدەستێت، وەک لە کێوی پەراچیم هەستا،","poem":1},{"text":"هەروەک لە دۆڵی گبعۆن، تووڕەیی دێتە جۆش","poem":2},{"text":"بۆ ئەوەی کارەکەی بکات، کارەکەی نامۆیە!","poem":1},{"text":"بۆ ئەوەی ئیشەکەی بکات، ئیشەکەی نامۆیە!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ئێستا گالتەجاڕ مەبن،","poem":1},{"text":"نەوەک کۆتتان توندتر بکرێت،","poem":2},{"text":"چونکە لەلایەن یەزدان، پەروەردگاری سوپاسالار،","poem":1},{"text":"گوێم لە کۆتایی پێهێنان و بڕانەوە بووە بەسەر هەموو خاکەکەدا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"گوێ شل بکەن و دەنگم ببیستن،","poem":1},{"text":"گوێ بگرن و قسەم ببیستن.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ئایا جوتیار هەموو ڕۆژێک زەوییەکەی دەکێڵێت،","poem":1},{"text":"هەڵیدەکۆڵێت و خەرتەی دەکات بۆ چاندن؟","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ئەی کە ڕووەکەی تەخت کرد،","poem":1},{"text":"تۆوی دەکات بە کونجی و زیرەی تێدا دەوەشێنێت و","poem":2},{"text":"گەنم لە هێڵی جووتەکانی دادەنێت و","poem":1},{"text":"جۆ لە شوێنی نیشانکراو،","poem":2},{"lineBreak":true},{"text":"گوڵەبەڕۆژەش لە سنوورەکانی؟","poem":2}]},{"type":"verse","number":26,"content":[{"text":"جا خودای خۆی فێری دەکات،","poem":1},{"text":"بە دادوەری ڕێنمایی دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"کونجی بە جەنجەڕ ناکوترێت،","poem":1},{"text":"چەرخەی عەرەبانەش بەسەر زیرەدا نایەت،","poem":2},{"text":"بەڵکو کونجی بە دار تێکدەدرێت و","poem":1},{"text":"زیرەش بە گۆچان.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"دانەوێڵە بۆ نان دەکوترێت،","poem":1},{"text":"هەتاهەتایە جەنجەڕی بەسەردا ناهێنێت،","poem":2},{"text":"چەرخەی عەرەبانەکەی و","poem":1},{"text":"ئەسپەکەی وردوخاشی ناکەن.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"هەموو ئەمانەش لەلایەن یەزدانی سوپاسالارەوە هاتوون،","poem":1},{"text":"ڕاوێژی سەیرە و دانایی مەزنە.","poem":2}]}],"footnotes":[{"noteId":43,"caller":"+","text":"عیبری: چاڤ لاچاڤ، قاڤ لاقاڤ‏، کە تەنها دەنگە لە زمانی عیبری بەبێ واتا، وەک گوێگرتن لە زمانێکی بیانی.‏","reference":{"chapter":28,"verse":10}},{"noteId":44,"caller":"+","text":"گرنگترین بەردی بناغە: بەردی قولینچک، بەردێکی گەورەیە لە گۆشەی دیوار دادەنرێت لەو بەردانە بەهێزترە کە لە دیوارەکە بەکاردێت و دەبێتە هۆی بەهێزکردنی دیوارەکە.‏","reference":{"chapter":28,"verse":16}}]},"thisChapterLink":"/api/ckb_bib/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}