{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":29,"content":[{"type":"heading","content":["قوڕبەسەر شارەکەی داود"]},{"type":"verse","number":1,"content":[{"text":"قوڕبەسەر ئەریێل، ئەریێل","poem":1},{"noteId":45},{"text":"ئەو شارەی داود تێیدا مایەوە!","poem":2},{"text":"ساڵ لەدوای ساڵ زیاد بکەن،","poem":1},{"text":"با جەژنەکان بسوڕێنەوە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"منیش تەنگ بە ئەریێل هەڵدەچنم،","poem":1},{"text":"جا دەبێت بە گریان و شیوەن و","poem":2},{"lineBreak":true},{"text":"بۆ من وەک ئاگردانی قوربانگای","poem":2},{"noteId":46},{"text":"لێدێت،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"وەک بازنە دەورت دەدەم،","poem":1},{"text":"بە قەڵا تەنگت پێهەڵدەچنم و","poem":2},{"lineBreak":true},{"text":"سەنگەر بە چواردەورتدا لێ دەدەم.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"جا نزم دەبیتەوە و لە زەوییەوە دەدوێیت،","poem":1},{"text":"قسەکەت لەناو خۆڵ دەچەمێتەوە،","poem":2},{"text":"دەنگت وەک تارمایی دەبێت لە زەوییەوە،","poem":1},{"text":"قسەکەت لەناو خۆڵ چرپەی دێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ئاپۆرەی دوژمنانت وەک تۆزی کوتراو دەبن و","poem":1},{"text":"ئاپۆرەی زۆرداران وەک پووشی با بردوو دەبێت.","poem":2},{"text":"لە ساتێکدا لەپڕ ئەوە دەبێت،","poem":1}]},{"type":"verse","number":6,"content":[{"text":"لەلایەن یەزدانی سوپاسالارەوە سزا دەدرێت","poem":2},{"text":"بە هەورەتریشقە و بوومەلەرزە و دەنگێکی بەرزەوە،","poem":1},{"text":"بە زریان و ڕەشەبا و گڕی ئاگری سووتێنەرەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"وەک خەون و زیندەخەوی شەوانی لێدێت،","poem":1},{"text":"ئاپۆرەی هەموو نەتەوە لەشکرکێشەکانی سەر ئەریێل،","poem":2},{"text":"هەموو لەشکرکێشەکانی سەری و سەر قەڵاکانی","poem":1},{"text":"لەگەڵ تەنگ پێ هەڵچنانی،","poem":2}]},{"type":"verse","number":8,"content":[{"text":"وەک ئەوەی برسی خەون ببینێت و ئەوەتا دەخوات،","poem":1},{"text":"بەڵام کە هەڵدەستێت ورگی بەتاڵە،","poem":2},{"text":"وەک ئەوەی تینوو خەون ببینێت و ئەوەتا دەخواتەوە،","poem":1},{"text":"بەڵام کە هەڵدەستێت شەکەتە و گیانی ئارەزوو دەکات،","poem":2},{"text":"ئاوایان لێدێت ئاپۆرەی هەموو ئەو نەتەوانەی","poem":1},{"text":"لەشکرکێشییان کردووە بۆ سەر کێوی سییۆن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"بحەپەسێن و سەرسام بن!","poem":1},{"text":"خۆتان کوێر بکەن و کوێربن!","poem":2},{"text":"بەبێ شەراب ئێوە مەستن،","poem":1},{"text":"بەبێ مەی ئێوە بە لارەلار دەڕۆن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"یەزدان ڕۆحی خەوی قووڵی بەسەر ئێوەدا ڕشتووە،","poem":1},{"text":"بەم شێوەیە یەزدان چاوەکانی ئێوەی نوقاندووە کە پێغەمبەرەکانن،","poem":2},{"lineBreak":true},{"text":"هەروەها یەزدان سەری ئێوەی پێشبینیکەری داپۆشیوە.","poem":2}]},{"type":"verse","number":11,"content":["جا تەواوی ئەم پەیامەی کە بە بینینێک ئاشکرا کراوە تەنها بۆ ئێوە وەک وشەکانی تۆمارێکی مۆرکراوی لێهاتووە، ئەوەی دەیدەنە کەسێکی خوێندەوار و دەڵێن: «تکایە ئەمە بخوێنەوە.» ئەویش دەڵێت: «ناتوانم، چونکە مۆر کراوە.»"]},{"type":"verse","number":12,"content":["یان ئەگەر تۆمارەکە دەدەنە کەسێکی نەخوێندەوار و دەڵێن: «تکایە ئەمە بخوێنەوە.» ئەویش دەڵێت: «خوێندەواریم نییە.»"]},{"type":"verse","number":13,"content":["جا پەروەردگار دەفەرموێت:",{"text":"«لەبەر ئەوەی ئەم گەلە هەر بە دەم نزیک دەبنەوە و","poem":1},{"text":"بە لێوەکانیان ڕێزم لێ دەگرن،","poem":2},{"lineBreak":true},{"text":"بەڵام دڵیان لێم دوورە،","poem":2},{"text":"پەرستنیان بۆ من","poem":1},{"text":"تەنها فێرکردن و ڕاسپاردەی خەڵکە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"لەبەر ئەوە ئەوەتا من جارێکی دیکە","poem":1},{"text":"کاری سەیر و سەمەرە بەم گەلە دەکەم،","poem":2},{"text":"دانایی داناکانی لەناودەبەم و","poem":1},{"text":"تێگەیشتنی تێگەیشتووانی ون دەبێت.»","poem":2}]},{"type":"verse","number":15,"content":[{"text":"قوڕبەسەر ئەوانەی دەچنە قووڵاییەوە","poem":1},{"text":"بۆ ئەوەی پیلانەکانیان لە یەزدان بشارنەوە،","poem":2},{"text":"کارەکانیان لە تاریکی دەبێت و","poem":1},{"text":"دەڵێن: «کێ دەمانبینێ؟ کێ دەمانناسێت؟»","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئای لە هاڵاوگێڕیتان،","poem":1},{"text":"ئایا گۆزەکەر و قوڕ دەکرێن بە یەک","poem":2},{"text":"تاکو دروستکراو بە دروستکەرەکەی بڵێت:","poem":1},{"text":"«تۆ دروستت نەکردم»؟","poem":2},{"text":"یان گۆزەکە بە گۆزەکەر بڵێت:","poem":1},{"text":"«تێناگەیت»؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ئایا لە ساتێکی کەمدا لوبنان ناگۆڕێت بۆ باخ و","poem":1},{"text":"باخیش بە دارستان دانانرێت؟","poem":2}]},{"type":"verse","number":18,"content":[{"text":"جا لەو ڕۆژەدا کەڕەکان گوێیان لە وشەکانی تۆمارەکە دەبێت و","poem":1},{"text":"لە ئەنگوستەچاو و لە تاریکیدا","poem":2},{"lineBreak":true},{"text":"چاوی نابیناکان دەبینن.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"زەلیلەکان دڵخۆشییان بە یەزدان زیاتر دەبێت،","poem":1},{"text":"نەدارانیش بە خودا پیرۆزەکەی ئیسرائیل دڵشاد دەبن.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"زۆردار لەناودەچێت و","poem":1},{"text":"گاڵتەجاڕ نەمێنێت و","poem":2},{"lineBreak":true},{"text":"هەموو ئێشکگرانی خراپەکاری دەبڕێنەوە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئەوانەی بە وشەیەک مرۆڤ گوناهبار دەکەن و","poem":1},{"text":"لە دادگا داو بۆ دادوەر دەنێنەوە و","poem":2},{"lineBreak":true},{"text":"بە شتی پووچ دادپەروەری خوار دەکەن.","poem":2}]},{"type":"verse","number":22,"content":["لەبەر ئەوە یەزدان ئەوەی ئیبراهیمی کڕییەوە، ئەمە بە بنەماڵەی یاقوب دەفەرموێت:",{"text":"«ئێستا یاقوب شەرمەزار نابێت و","poem":1},{"text":"ئێستا ڕوو زەرد نابێت.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"کاتێک منداڵەکانی دەستکردەکانی دەستم","poem":1},{"text":"لەنێویاندا دەبینن،","poem":2},{"text":"وەک ناوێکی پیرۆز ڕێز لە ناوەکەم دەگرن،","poem":1},{"text":"دان بە پیرۆزی پیرۆزەکەی یاقوبدا","poem":2},{"noteId":47},{"text":"دەنێن،","poem":2},{"lineBreak":true},{"text":"لە خودای ئیسرائیل دەترسن.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ئەوانەی لە ناوەڕۆکەوە گومڕا بوون تێگەیشتن بەدەستدەهێنن و","poem":1},{"text":"بۆڵەبۆڵکەران فێربوون وەردەگرن.»","poem":2}]}],"footnotes":[{"noteId":45,"caller":"+","text":"ئەریێل ئەو ناوە شیعرییەیە کە بۆ ئۆرشەلیم بەکاردەهێنرا، واتای ناوەکە: شێری خودا.‏","reference":{"chapter":29,"verse":1}},{"noteId":46,"caller":"+","text":"‏لە زمانی عیبری هەمان وشەی ئەریێل بەکارهاتووە بە واتایەکی دیکە. بڕوانە ئایەتی 1.‏","reference":{"chapter":29,"verse":2}},{"noteId":47,"caller":"+","text":"پیرۆزەکەی یاقوب: مەبەست لە خودای پیرۆزی یاقوبە.‏","reference":{"chapter":29,"verse":23}}]},"thisChapterLink":"/api/ckb_bib/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}