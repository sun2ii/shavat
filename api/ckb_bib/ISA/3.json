{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["دادوەری لەگەڵ ئۆرشەلیم و یەهودا"]},{"type":"verse","number":1,"content":[{"text":"ئێستا سەیر بکەن، پەروەردگار،","poem":1},{"text":"یەزدانی سوپاسالار،","poem":2},{"text":"بەتەمایە لە ئۆرشەلیم و لە یەهودا دابماڵێت","poem":1},{"text":"پاڵپشتی و پشتگیری،","poem":2},{"text":"هەموو پاڵپشتییەکی نان و ئاو،","poem":1}]},{"type":"verse","number":2,"content":[{"text":"پاڵەوان و جەنگاوەر،","poem":2},{"text":"دادوەر و پێغەمبەر،","poem":1},{"text":"فاڵگرەوە و پیر،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"سەرۆکی پەنجاکان و پیاوماقوڵان،","poem":1},{"text":"ڕاوێژکار و پیشەوەری دانا و نوشتەکەری تێگەیشتوو.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"مێردمنداڵان دەکەم بە میریان،","poem":1},{"text":"منداڵان فەرمانڕواییان دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"گەل لەنێو خۆیان ستەم لە یەکتری دەکەن،","poem":1},{"text":"هەرکەسە و لە هاوڕێکەی.","poem":2},{"text":"مێردمنداڵ لە پیر ڕاست دەبێتەوە،","poem":1},{"text":"چروکیش لە سەنگین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"پیاو یەخەی برای خۆی دەگرێت","poem":1},{"text":"لە ماڵی باوکی و دەڵێت:","poem":2},{"text":"«تۆ کەوات هەیە، ببە بە سەرۆکمان و","poem":1},{"text":"ئەم کاولگەیەش لەژێر دەستتە!»","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بەڵام لەو ڕۆژەدا براکەی دەنگی بەرز دەکاتەوە و وەڵامی دەداتەوە:","poem":1},{"text":"«نابم بە چارەساز،","poem":2},{"text":"نان و جلوبەرگ لە ماڵەکەم نییە.","poem":1},{"text":"مەمکەن بە سەرۆکی گەل.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ئۆرشەلیم شکست دەخوات و","poem":1},{"text":"یەهوداش دەکەوێت،","poem":2},{"text":"چونکە زمان و کردەوەکانیان لە دژی یەزدانە،","poem":1},{"text":"بۆ یاخیبوون لەبەرچاوی شکۆمەندییەکەی.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"دیمەنی ڕوخساریان شایەتییان لەسەر دەدات،","poem":1},{"text":"وەک سەدۆم گوناهەکەیان ڕادەگەیەنن،","poem":2},{"lineBreak":true},{"text":"نایشارنەوە.","poem":2},{"text":"قوڕبەسەریان،","poem":1},{"text":"چونکە خراپە دەهێننە سەر خۆیان!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"بڵێن، ڕاستودروستان خۆشحاڵن","poem":1},{"text":"چونکە بەری کردەوەکانی خۆیان دەخۆن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"قوڕبەسەر بەدکار! خراپەی بۆ دەبێت،","poem":1},{"text":"چونکە پاداشتی کردەوەکانی دەستی خۆی وەردەگرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"منداڵان ستەم لە گەلی من دەکەن و","poem":1},{"text":"ژنان فەرمانڕەوایەتی دەکەن.","poem":2},{"text":"گەلی من، ڕاستەڕێکارانت چەواشەکارن و","poem":1},{"text":"لە ڕێگای ڕاست لاتان دەدەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"یەزدان لە شوێنی دادوەر دانیشت،","poem":1},{"text":"هەستا بۆ حوکمدان بەسەر گەلان.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"یەزدان دەست بە دادوەری دەکات،","poem":1},{"text":"لەگەڵ پیرانی گەلەکەی و میرەکانیان:","poem":2},{"text":"«ئێوە بوون ڕەزەمێوەکەتان لووشدا،","poem":1},{"text":"تاڵانیی هەژاران لە ماڵەکانتاندایە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەوە چیتانە، گەلەکەم وردوخاش دەکەن و","poem":1},{"text":"ڕووی هەژاران دەهاڕن؟»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە، پەروەردگاری سوپاسالار.","poem":4}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"یەزدان دەفەرموێت:","poem":1},{"text":"«کچانی سییۆن لەخۆبایی بوون،","poem":2},{"text":"گەردنیان دەرخستووە و","poem":1},{"text":"بە چاوبازییەوە دەڕۆن،","poem":2},{"text":"بە لارولەنجەوە دەڕۆن","poem":1},{"text":"بە زرنگەی لەرزانەی گۆزینگیان.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لەبەر ئەوە پەروەردگار سەری کچانی سییۆن کەچەڵ دەکات،","poem":1},{"lineBreak":true},{"text":"یەزدان ڕووتییان دەردەخات.»","poem":1}]},{"type":"verse","number":18,"content":["لەو ڕۆژەدا پەروەردگار جوانکاری دادەماڵێت: لەرزانە و لاسەرە و ملوانکە،"]},{"type":"verse","number":19,"content":["گوارە و بازن و پەچە،"]},{"type":"verse","number":20,"content":["سەرپێچ و قۆڵبەست و پشتێن و تەلیسم و چەناخە،"]},{"type":"verse","number":21,"content":["ئەنگوستیلە و خەزێم،"]},{"type":"verse","number":22,"content":["جلوبەرگی جەژن و پاڵتۆ و چارۆکە و جزدان و"]},{"type":"verse","number":23,"content":["ئاوێنە، کراسی کەتان و سەرپۆش و کۆڵوانەکان."]},{"type":"verse","number":24,"content":[{"text":"جا لە جێی بۆنوبەرام، بۆگەن و","poem":1},{"text":"لە جێی کەمەربەند، گوریس و","poem":2},{"text":"لە جێی پرچی بە ئەگریجە، سەری ڕووتاوە و","poem":1},{"text":"لە جێی بەرگی گرانبەها گوش","poem":2},{"noteId":3},{"text":"لەبەر دەکەن،","poem":2},{"lineBreak":true},{"text":"نیشانەی داغیش لە جێی جوانی دەبێت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"پیاوەکانتان بە شمشێر و","poem":1},{"text":"پاڵەوانەکانتان لە جەنگدا دەکەون.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"جا دەروازەکانی سییۆن شین دەگێڕن و دەگریێن،","poem":1},{"text":"بێکەس لەسەر زەوی دادەنیشن.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"ڕیشاڵێکی ڕووەکییە کە لەو سەردەمە بەرگی ماتەمی لێ دروستدەکرا.‏","reference":{"chapter":3,"verse":24}}]},"thisChapterLink":"/api/ckb_bib/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}