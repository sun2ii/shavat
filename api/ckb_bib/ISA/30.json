{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":30,"content":[{"type":"heading","content":["قوڕبەسەر نەتەوەی کەللەڕەق"]},{"type":"verse","number":1,"content":[{"text":"یەزدان دەفەرموێت:","poem":1},{"text":"«قوڕبەسەر کوڕانی کەللەڕەق،","poem":2},{"text":"پلانێک جێبەجێ دەکەن کە هی من نییە،","poem":1},{"text":"داڕێژراوێک دادەڕێژن کە لە ڕۆحی منەوە نییە","poem":2},{"lineBreak":true},{"text":"بۆ ئەوەی گوناه لەسەر گوناه زیاد بکەن.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"دەڕۆن هەتا بەرەو میسر شۆڕ بنەوە","poem":1},{"text":"بێ ئەوەی پرس بە من بکەن،","poem":2},{"text":"هەتا پەنا بدەنە پاڵ قەڵای فیرعەون،","poem":1},{"text":"لە سایەی میسر پەناگیر بن.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بەڵام قەڵای فیرعەون بۆتان دەبێت بە ڕیسوایی و","poem":1},{"text":"پەناگیریشتان لە سایەی میسر بە شەرمەزاری.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"هەرچەندە میرەکانی وا لە چۆعەنن،","poem":1},{"text":"نێردراوەکانی گەیشتنە شاری حانێس،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بەڵام هەموو شەرمەزار دەبن","poem":1},{"text":"لە گەلێک کە بێ سوودە بۆیان،","poem":2},{"text":"بۆ یارمەتیدان نییە و بۆ سوود بەخشین نییە،","poem":1},{"text":"چونکە بۆ ڕیسوایی و بۆ شورەییە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":["سروشێک سەبارەت بە ئاژەڵەکانی نەقەب:",{"text":"لە خاکی تەنگانە و ناخۆشیدا،","poem":1},{"text":"ئەوەی شێرە مێ و شێری لێوە دێت،","poem":2},{"lineBreak":true},{"text":"مار و ماری ژەهراوی باڵدار،","poem":2},{"text":"سامانەکانیان لەسەر شانی گوێدرێژ بار دەکەن،","poem":1},{"text":"لەسەر پشتی وشتریش گەنجینەکانیان","poem":2},{"text":"بۆ لای گەلێک کە سوود نابەخشن،","poem":1}]},{"type":"verse","number":7,"content":[{"text":"چونکە پووچ و بەفیڕۆدانە یارمەتییەکەی میسر.","poem":2},{"text":"لەبەر ئەوە ناوم لەمە نا:","poem":1},{"text":"«ڕەهەڤ ئەوەی هیچ ناکات».","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ئێستا وەرە لەلایان لەسەر تەختەیەک بینووسە و","poem":1},{"text":"لە تۆمارێک نەخشی بکە،","poem":2},{"text":"هەتا بۆ ڕۆژگاری داهاتوو ببێت بە","poem":1},{"text":"شایەتێک بۆ هەتاهەتایە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەوان گەلێکی یاخین، کوڕانی درۆزنن،","poem":1},{"text":"ئەو کوڕانەی نەیانویست گوێ لە فێرکردنی یەزدان بگرن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بە پێشبینیکەر دەڵێن:","poem":1},{"text":"«پێشبینی مەکە!»","poem":2},{"text":"بەوەی پەیامی خودا ڕادەگەیەنێت دەڵێن:","poem":1},{"text":"«پەیامی ڕاستمان پێ ڕامەگەیەنە!","poem":2},{"text":"قسەی لووسمان بۆ بکە،","poem":1},{"text":"خەونی تەفرەدەر ببینە!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لە ڕێگا لابدەن،","poem":1},{"text":"ڕێچکە بەر بدەن،","poem":2},{"text":"چیتر ڕووبەڕوومان مەکەنەوە","poem":1},{"text":"لەگەڵ داواکارییەکانی خودا پیرۆزەکەی ئیسرائیل!»","poem":2}]},{"type":"verse","number":12,"content":["لەبەر ئەوە خودا پیرۆزەکەی ئیسرائیل وا دەفەرموێت:",{"text":"«ئەم پەیامەتان ڕەتکردەوە و","poem":1},{"text":"متمانەتان بە زۆرداری و خواروخێچی کرد و","poem":2},{"lineBreak":true},{"text":"پشتتان پێیان بەست،","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لەبەر ئەوە ئەم تاوانەتان وەک","poem":1},{"text":"دیوارێکی ناڕێک و بەرز درزی تێکەوتبێت،","poem":2},{"lineBreak":true},{"text":"ئەوەی لەناکاو و دەستبەجێ دادەڕووخێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"وەک شکانی گۆزەی گۆزەکەران دەشکێت","poem":1},{"text":"بێ بەزەییانە وردوخاش دەکرێت،","poem":2},{"text":"لەناو پارچە وردوخاشکراوەکانی","poem":1},{"text":"پارچەیەک نابێت بۆ هەڵگرتنی ئاگر لە ئاگردانەوە","poem":2},{"lineBreak":true},{"text":"یان بۆ ئاو دەرهێنان لە ئەمباراوەوە.»","poem":2}]},{"type":"verse","number":15,"content":["یەزدانی باڵادەست، پیرۆزەکەی ئیسرائیل وا دەفەرموێت:",{"text":"«بە تۆبەکردن و ئارامگرتن ڕزگارتان دەبێت،","poem":1},{"text":"پاڵەوانیتان لە هێمنی و لە دڵنیاییتان دەبێت،","poem":2},{"lineBreak":true},{"text":"بەڵام نەتانویست،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"گوتتان: ”وا نا، بەڵکو بە ئەسپ هەڵدێین،“","poem":1},{"text":"لەبەر ئەوە هەڵدێن!","poem":2},{"text":"گوتتان: ”سواری ئەسپی خێرا دەبین،“","poem":1},{"text":"لەبەر ئەوە ڕاونەرانتان خێرا دەکەن!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لە ڕووی نەڕەی یەک کەس","poem":1},{"text":"هەزار کەس هەڵدێت،","poem":2},{"text":"لە ڕووی نەڕەی پێنج کەس","poem":1},{"text":"هەمووتان هەڵدێن،","poem":2},{"text":"هەتا وەک دار ئاڵا لەسەر لووتکەی چیا و","poem":1},{"text":"وەک بەیداخ بەسەر گردەوە دەمێننەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"بەڵام یەزدان چاوەڕێی ئەوە دەکات هەتا لەگەڵتان میهرەبان بێت،","poem":1},{"text":"لەبەر ئەوە هەڵدەستێت بۆ ئەوەی بەزەیی پێتاندا بێتەوە،","poem":2},{"text":"چونکە یەزدان خودای دادپەروەرییە.","poem":1},{"text":"خۆزگە بەوانەی چاوەڕێی دەکەن!","poem":2}]},{"type":"verse","number":19,"content":["ئەی گەلی سییۆن کە لە ئۆرشەلیم نیشتەجێن، ئێوە ئیتر ناگریێن. بە تەواوی میهرەبان دەبێت لەگەڵتان، لەگەڵ دەنگی هاوارتان کە گوێی لێ دەبێت، بە دەنگتانەوە دێت."]},{"type":"verse","number":20,"content":["هەرچەندە پەروەردگار نانی تەنگانە و ئاوی ناخۆشیتان دەداتێ، بەڵام ئیتر مامۆستاکانتان ناخرێنە پەنای چاوەکانتان، مامۆستاکانتان دەبینن."]},{"type":"verse","number":21,"content":["کاتێک بەلای ڕاست یان چەپدا لادەدەن، گوێیەکانتان دەنگێک دەبیستێت لە دواتانەوە دەڵێت: «ئەمە ڕێگاکەیە، پێیدا بڕۆن.»"]},{"type":"verse","number":22,"content":["پەیکەرە داتاشراوە بە زیو ڕووکەشکراوەکانتان و بتە لەقاڵبدراوە بە زێڕ ڕووکەشکراوەکانتان بە گڵاو دادەنێن. وەک پەڕۆی پیسی ئافرەت فڕێیدەدەن، پێی دەڵێن: «بڕۆ دەرەوە!»"]},{"type":"verse","number":23,"content":["ئینجا بارانی تۆوەکەت دەداتێ کە زەوییەکەی پێ تۆو دەکەیت، نانی بەروبوومی زەوییەکە چەور و قەڵەو دەبێت. لەو ڕۆژەدا مەڕوماڵاتەکەت لە لەوەڕگایەکی پانوبەریندا دەلەوەڕێن."]},{"type":"verse","number":24,"content":["گاجووت و نێرەکەرەکانت کە لە زەوییەکەت کار دەکەن ئالیکی پاککراو دەخۆن کە بە شەن و بێڵ شەن کرابێت."]},{"type":"verse","number":25,"content":["جا لەسەر هەموو کێوێکی بڵند و لەسەر هەموو تەپۆڵکەیەکی بەرز ڕووبار و جۆگەی ئاو دەبێت لە ڕۆژی کوشتارە مەزنەکە، کاتێک قوللەکان دەکەون."]},{"type":"verse","number":26,"content":["جا ڕووناکی مانگ وەک ڕووناکی خۆر دەبێت، ڕووناکی خۆریش حەوت ئەوەندە دەبێت وەک ڕووناکی حەوت ڕۆژ لەو ڕۆژەی یەزدان شکاوی گەلەکەی دەگرێتەوە و جێی لێدانەکانی تیمار دەکات."]},{"type":"verse","number":27,"content":[{"text":"ئەوەتا ناوی یەزدان لە دوورەوە هات،","poem":1},{"text":"تووڕەییەکەی گڕی گرتووە و بارەکەی قورسە.","poem":2},{"text":"لێوەکانی پڕن لە هەڵچوون و","poem":1},{"text":"زمانی وەک ئاگرێکی لووشدەرە.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"هەناسەی وەک ڕووبارێکی هەستاوە","poem":1},{"text":"دەگات بە گەردن،","poem":2},{"text":"بۆ لەبێژنگدانی نەتەوەکان","poem":1},{"text":"بە بێژنگی لەناوچوون و","poem":2},{"lineBreak":true},{"text":"لغاوی گومڕابوونیش لەدەم گەلانە.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"گۆرانییەکتان بۆ دەبێت","poem":1},{"text":"وەک شەوی تەرخانکردنی جەژن،","poem":2},{"text":"خۆشی دڵیش","poem":1},{"text":"وەک ئەوەی بەدەم بلوێرەوە بڕوات","poem":2},{"text":"هەتا بێت بۆ کێوی یەزدان،","poem":1},{"text":"بۆ تاشەبەردەکەی ئیسرائیل.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"یەزدان وا دەکات دەنگی مەزنی ببیسترێت و","poem":1},{"text":"دابەزینی بازووی ببینرێت","poem":2},{"text":"بە هەڵچوونی تووڕەیی و گڕی ئاگری لووشدەر،","poem":1},{"text":"بە ڕەشەبا و لێزمەی باران و تەرزەوە.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ئاشور لە دەنگی یەزدان لەرز دەیگرێت،","poem":1},{"text":"بە داردەست لێدەدات.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"جا هەموو لێدانێکی گۆچانی دادوەری،","poem":1},{"text":"ئەوەی یەزدان بەسەریدا دەهێنێت،","poem":2},{"text":"بە دەف و قیسارەوە دەبێت و","poem":1},{"text":"بە ڕاوەشاندنی دەستی کە دەجەنگێت.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"چاڵی تۆفەت","poem":1},{"noteId":48},{"text":"لەمێژە ڕێکخراوە،","poem":1},{"text":"بۆ پاشا ئامادە کراوە،","poem":2},{"text":"قووڵە، بەرینە،","poem":1},{"text":"کەڵەکە کراوەکەی ئاگرە و داری زۆرە.","poem":2},{"text":"هەناسەی یەزدان","poem":1},{"text":"وەک ڕووباری گۆگردە","poem":2},{"lineBreak":true},{"text":"گڕی تێبەردەدات.","poem":2}]}],"footnotes":[{"noteId":48,"caller":"+","text":"‏شوێنێک بووە بۆ سووتاندنی قوربانی بتپەرستەکان کە زۆر جار مرۆڤی تێدا کراوەتە قوربانی. بڕوانە دووەم پاشایان 23‏:10‏‏.‏","reference":{"chapter":30,"verse":33}}]},"thisChapterLink":"/api/ckb_bib/ISA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}