{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["قوڕبەسەر ئەوانەی پشت بە میسر دەبەستن"]},{"type":"verse","number":1,"content":[{"text":"قوڕبەسەر ئەوانەی دادەبەزن بۆ میسر بۆ یارمەتی،","poem":1},{"text":"پشت بە ئەسپ دەبەستن،","poem":2},{"text":"متمانە بە زۆری گالیسکە و","poem":1},{"text":"هێزی لە ڕادەبەدەری سوارەکانیان دەکەن،","poem":2},{"text":"بەڵام پشتیان بە خودا پیرۆزەکەی ئیسرائیل نەبەست و","poem":1},{"text":"داوای یارمەتییان لە یەزدان نەکرد.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەویش هەروەها دانایە و کارەسات دەهێنێت،","poem":1},{"text":"لە وشەی خۆی با ناداتەوە.","poem":2},{"text":"هەڵدەستێتە سەر ماڵی خراپەکاران و","poem":1},{"text":"بۆ سەر یارمەتیدەری ستەمکاران.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بەڵام میسرییەکان مرۆڤن نەک خودا،","poem":1},{"text":"ئەسپەکانیان جەستەیین نەک ڕۆح.","poem":2},{"text":"کاتێک یەزدان دەستی درێژ دەکات،","poem":1},{"text":"یارمەتیدەر ساتمە دەکات و","poem":2},{"lineBreak":true},{"text":"یارمەتیدراو دەکەوێت،","poem":2},{"lineBreak":true},{"text":"هەموو پێکەوە لەناودەچن.","poem":2}]},{"type":"verse","number":4,"content":["ئێستا یەزدان ئەمەم پێ دەفەرموێت:",{"text":"«وەک شێر و بەچکە شێر دەنەڕێنێت","poem":1},{"text":"بەسەر نێچیرەکەیەوە،","poem":2},{"text":"ئەوەی کۆمەڵە شوان","poem":1},{"text":"هاواری لێ دەکەن،","poem":2},{"text":"لە دەنگیان ناترسێت و","poem":1},{"text":"لە هاتوهەرایان ناشڵەژێت،","poem":2},{"text":"ئاواش یەزدانی سوپاسالار دادەبەزێت","poem":1},{"text":"بۆ شەڕکردن لەسەر کێوی سییۆن و لەسەر گردەکانی.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"وەک باڵندە فڕیوەکان،","poem":1},{"text":"ئاوا یەزدانی سوپاسالار پارێزگاری لە ئۆرشەلیم دەکات،","poem":2},{"text":"پارێزگاری دەکات و فریادەکەوێت،","poem":1},{"text":"بەسەریدا تێدەپەڕێت","poem":2},{"noteId":49},{"text":"و دەربازی دەکات.»","poem":2}]},{"type":"verse","number":6,"content":["ئەی نەوەی ئیسرائیل، بگەڕێنەوە بۆ لای ئەوەی کە بە توندی لێی هەڵگەڕانەوە،"]},{"type":"verse","number":7,"content":["چونکە لەو ڕۆژەدا هەرکەسە و بتە زێڕ و زیوەکانتان ڕەت دەکەنەوە، ئەوەی دەستە گوناهبارەکانتان دروستی کردن."]},{"type":"verse","number":8,"content":[{"text":"«ئاشور دەکەوێت، بەڵام بە شمشێری مرۆڤ نا،","poem":1},{"text":"شمشێری ئادەمیزاد نییە کە دەیخوات.","poem":2},{"text":"جا لە ڕووی شمشێر هەڵدێت و","poem":1},{"text":"گەنجەکانی بۆ بێگاری دەبن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"قەڵاکەیان لە ترسان دەکەوێت،","poem":1},{"text":"میرەکانیشی لە ئاڵا دەترسن،»","poem":2},{"text":"یەزدان دەفەرموێت،","poem":1},{"text":"ئەوەی ئاگری هەیە لە سییۆن و","poem":2},{"lineBreak":true},{"text":"تەنووری هەیە لە ئۆرشەلیم.","poem":2}]}],"footnotes":[{"noteId":49,"caller":"+","text":"بڕوانە دەرچوون 12‏:12‏-13.‏‏","reference":{"chapter":31,"verse":5}}]},"thisChapterLink":"/api/ckb_bib/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}