{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["شانشینی ڕاستودروستی"]},{"type":"verse","number":1,"content":[{"text":"ئەوەتا پاشایەک بە ڕاستودروستی پاشایەتی دەکات و","poem":1},{"text":"میرانیش بە دادوەری سەرۆکایەتی دەکەن،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"مرۆڤ وەک حەشارگەیەک دەبێت لە ڕووی با و","poem":1},{"text":"وەک چەتر لە ڕووی لێزمەی باران،","poem":2},{"text":"وەک جۆگەی ئاو لە شوێنێکی وشکدا و","poem":1},{"text":"وەک سێبەری تاشەبەردێکی گەورە لە خاکی ماندووبووندا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"چاوی بینەران کز نابێت و","poem":1},{"text":"گوێی گوێگرەکان دەبیستێت.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"دڵی هەڵەشەکان دەزانن و تێدەگەن و","poem":1},{"text":"زمانی زمانگرانەکان بە ڕوونی و ڕەوانی دەدوێن.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئیتر گێل بە «ڕێزدار» بانگ ناکرێت،","poem":1},{"text":"بە فێڵبازیش ناگوترێت «خانەدان»،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"چونکە گێل بە گێلی دەدوێت و","poem":1},{"text":"دڵیشی خراپە دەکات،","poem":2},{"text":"بۆ ئەوەی گڵاوی ئەنجام بدات،","poem":1},{"text":"لە دژی یەزدان بوختان هەڵدەبەستێت،","poem":2},{"text":"بۆ ئەوەی برسی تێر نەبێت و","poem":1},{"text":"تینوو لە خواردنەوە بێبەش بێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ڕێبازی فێڵبازیش خراپە و","poem":1},{"text":"پیلانی بەدکاری دەگێڕێت،","poem":2},{"text":"هەتا بە قسەی درۆ کڵۆڵان تەفروتونا بکات","poem":1},{"text":"ئەگەر قسەی نەدارانیش ڕاست بێت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بەڵام ڕێزدار بە ڕێزداری پلان دادەنێت و","poem":1},{"text":"لەسەر ڕێزیش جێگیر دەبێت.","poem":2}]},{"type":"heading","content":["ئافرەتانی ئۆرشەلیم"]},{"type":"verse","number":9,"content":[{"text":"ئەی ئافرەتە لەخۆڕازییەکان،","poem":1},{"text":"هەستن گوێ لە دەنگی من بگرن!","poem":2},{"text":"ئەی کیژە دڵنیاکان،","poem":1},{"text":"گوێ شل بکەن بۆ قسەی من!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەی دڵنیاکان، ڕۆژانێک پتر لە یەک ساڵ","poem":1},{"text":"لەرز دەتانگرێت،","poem":2},{"text":"چونکە ڕەزچنین بەسەرچوو و","poem":1},{"text":"کۆکردنەوە نایەت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەی ئافرەتە لەخۆڕازییەکان، بلەرزن!","poem":1},{"text":"ئەی کیژە دڵنیاکان لەرز بتانگرێت!","poem":2},{"text":"جلتان دابکەنن و خۆتان ڕووت بکەنەوە،","poem":1},{"text":"گوش لە کەمەرتان ببەستن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لە سنگی خۆتان بدەن بۆ کێڵگە بەردارەکان،","poem":1},{"text":"بۆ ڕەزی بەردار،","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بۆ خاکی گەلەکەم","poem":1},{"text":"دڕکوداڵ دەڕوێت،","poem":2},{"text":"بەڵێ، بۆ هەموو ماڵە شادەکان،","poem":1},{"text":"بۆ شارە گەشاوەکە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"بێگومان کۆشک چۆڵ دەکرێت،","poem":1},{"text":"شاری قەرەباڵغ چۆڵ دەبێت،","poem":2},{"text":"قەڵا و قوللەی چاودێری لەگەڵ زەوی تەخت دەبن بۆ هەتاهەتایە،","poem":1},{"text":"دەبن بە سەیرانگای گوێدرێژەکان، لەوەڕگا بۆ مێگەلەکان،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"هەتا ئەو کاتەی لە بەرزاییەوە ڕۆحی خودا بەسەرماندا دەڕژێت،","poem":1},{"text":"جا چۆڵەوانی دەبێت بە باخ و","poem":2},{"lineBreak":true},{"text":"باخیش بە دارستان دادەنرێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"جا دادپەروەری یەزدان لە چۆڵەوانی نیشتەجێ دەبێت و","poem":1},{"text":"ڕاستودروستییەکەشی لەناو باخ دادەنیشێت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"جا ئەنجامدانی ڕاستودروستی ئاشتی دەبێت و","poem":1},{"text":"کاری ڕاستودروستیش ئارامی و ئاسوودەیی هەتاهەتایی.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئینجا گەلی من لە ئاشتی و ئاوەدانی نیشتەجێ دەبێت و","poem":1},{"text":"لە نشینگەی ئاسوودەیی و","poem":2},{"lineBreak":true},{"text":"شوێنی پشوودانەکانیان بە ئارامی.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"تەرزە دەبارێت و دارستانەکان دەکوتێت،","poem":1},{"text":"شارەکە بە تەواوی دەکەوێنێت،","poem":2}]},{"type":"verse","number":20,"content":[{"text":"بەڵام خۆزگە بە خۆتان","poem":1},{"text":"کاتێک تۆو لەدەم هەموو ئاوەکان دەچێنن و","poem":2},{"lineBreak":true},{"text":"گا و گوێدرێژەکانتان دەلەوەڕن.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}