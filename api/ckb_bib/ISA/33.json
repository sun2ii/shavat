,"poem":1},{"text":"وەک ڕەوە کوللە خەڵک ڕووتتان دەکەنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"یەزدان پایەبەرزە، چونکە نیشتەجێی بەرزاییە،","poem":1},{"text":"سییۆن لە ڕاستودروستی و دادپەروەری پڕ دەکات.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"یەزدان دەبێتە مایەی دڵنیایی کاتەکانت.","poem":1},{"text":"گەنجینەی ڕزگاری و دانایی و زانینە،","poem":2},{"lineBreak":true},{"text":"لەخواترسی کلیلی ئەو گەنجینەیە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئەوەتا دلێرەکانیان لە دەرەوە دەقیژێنن،","poem":1},{"text":"نێردراوانی ئاشتی بە تاڵی دەگرین.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ڕێگاکان چۆڵ بوون،","poem":1},{"text":"بڕانەوە ڕێبواران.","poem":2},{"text":"پەیمان شکا و","poem":1},{"text":"شایەتەکانی ڕەتکرانەوە و","poem":2},{"lineBreak":true},{"text":"کەس بە هیچ دانانرێت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"زەوی شیوەن دەکات و سیس بوو،","poem":1},{"text":"لوبنان ڕیسوا بوو، داڕزا،","poem":2},{"text":"شارۆن وەک بیابانی عەراڤای","poem":1},{"noteId":50},{"text":"لێهات،","poem":1},{"text":"باشان و کارمەل ڕووتانەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"یەزدان دەفەرموێت: «ئێستا هەڵدەستم،","poem":1},{"text":"ئێستا بە گەورە دەزانرێم،","poem":2},{"lineBreak":true},{"text":"ئێستا بڵند دەکرێمەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بە گیا دووگیان دەبن و","poem":1},{"text":"کاتان دەبێت،","poem":2},{"lineBreak":true},{"text":"هەناسەتان ئاگرە و خۆتان دەخوات.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"گەلان دەبن بە گەچ،","poem":1},{"text":"وەک چقڵی بڕاوە بە ئاگر دەسووتێنرێن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ئەی دوورەکان گوێتان لێ بێت چیم کردووە،","poem":1},{"text":"ئەی نزیکەکان هێزم بزانن!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"گوناهباران لە سییۆن تۆقین،","poem":1},{"text":"گڵاوەکان لەرز دایگرتن:","poem":2},{"text":"«کێ لە ئێمە لەناو ئاگری لووشدەر دەمێنێتەوە؟","poem":1},{"text":"کێ لە ئێمە لەناو سووتانی هەمیشەیی دەمێنێتەوە؟»","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەوەی بە ڕاستودروستی هەڵسوکەوت دەکات و","poem":1},{"text":"ڕاستی دەڵێت،","poem":2},{"text":"ئەوەی قازانجی زۆرداری ڕەت دەکاتەوە و","poem":1},{"text":"ڕێگری دەکات لە دەستەکانی بۆ وەرگرتنی بەرتیل،","poem":2},{"text":"ئەوەی لە بیستنی خوێنڕشتن گوێی خۆی کەڕ دەکات و","poem":1},{"text":"لە بینینی خراپە چاوی خۆی دەنوقێنێت،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئەو لە بەرزایی نیشتەجێ دەبێت،","poem":1},{"text":"قەڵای چیاکان پەناگایەتی،","poem":2},{"text":"نانی دەدرێت و","poem":1},{"text":"ئاوی مسۆگەرە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"چاوت پاشا لە جوانی خۆیدا دەبینێت،","poem":1},{"text":"سنوورێکی فراوان دەبینن.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"دڵت لە تۆقین ڕادەمێنێت:","poem":1},{"text":"«کوا خامەی نهێنی","poem":2},{"noteId":51},{"text":"و کوا باجگر؟","poem":2},{"lineBreak":true},{"text":"کوا بەرپرسی قوللەکان؟»","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئیتر گەلی دڕندە نابینن،","poem":1},{"text":"گەلێک قسەیان ئاڵۆزە بۆ بیستن،","poem":2},{"lineBreak":true},{"text":"زمانیان گرانە تێیان ناگەیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"بڕوانە سییۆن شاری جەژنمان،","poem":1},{"text":"چاوەکانت ئۆرشەلیم دەبینن،","poem":2},{"lineBreak":true},{"text":"ماڵێکی ئاسوودە، چادرێک ناگوازرێتەوە.","poem":2},{"text":"سنگەکانی هەرگیز هەڵناکەنرێن،","poem":1},{"text":"هیچ کام لە گوریسەکانی ناپسێن.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"بێگومان لەوێ یەزدانی توانادار پشتگیرمان دەبێت.","poem":1},{"text":"شوێنی ڕووبارەکان و کەناری جۆگە فراوانەکان دەبێت.","poem":2},{"text":"کەشتی سەوڵدار پێیدا ناڕوات و","poem":1},{"text":"کەشتی مەزن پێیدا تێناپەڕێت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"یەزدان دادوەرمانە،","poem":1},{"text":"یەزدان فەرزدانەرمانە،","poem":2},{"text":"یەزدان پاشامانە،","poem":1},{"text":"ئەو ڕزگارمان دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"گوریسەکانت شل بوون،","poem":1},{"text":"بنکەی دار ئاڵای کەشتییەکەیان توند ناکەن،","poem":2},{"lineBreak":true},{"text":"چارۆکە بڵاو ناکەنەوە.","poem":2},{"text":"ئینجا دەستکەوتی زۆر دابەش کرا،","poem":1},{"text":"شەلەکانیش تاڵانییان تاڵان کرد.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"دانیشتووی سییۆن ناڵێت، «نەخۆش کەوتم،»","poem":1},{"lineBreak":true},{"text":"ئەو گەلەی تێیدا نیشتەجێیە تاوانەکانی بەخشراو دەبێت.","poem":1}]}],"footnotes":[{"noteId":50,"caller":"+","text":"شیوێک بوو لە دەریاچەی جەلیلەوە هەتا دەریای مردوو.‏","reference":{"chapter":33,"verse":9}},{"noteId":51,"caller":"+","text":"‏ڕازپۆش.‏","reference":{"chapter":33,"verse":18}}]},"thisChapterLink":"/api/ckb_bib/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}