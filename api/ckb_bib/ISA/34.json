:"هەموو ئەستێرەکان هەڵدەوەرن،","poem":1},{"text":"وەک هەڵوەرینی گەڵای مێو،","poem":2},{"lineBreak":true},{"text":"وەک وەرینی هەنجیر لە دارەکەی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"شمشێری من لە ئاسمان کاری تەواو بووە،","poem":1},{"text":"وا دادەبەزێتە سەر ئەدۆم و","poem":2},{"lineBreak":true},{"text":"بەسەر گەلێک بە نەفرەتم کردووە بۆ حوکم بەسەردادان.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"شمشێری یەزدان خوێنی لێ دەتکێت،","poem":1},{"text":"قەڵەو بووە بە پیو","poem":2},{"noteId":53},{"text":"،","poem":2},{"text":"بە خوێنی بەرخ و تەگە،","poem":1},{"text":"بە پیوی گورچیلەی بەرانەکان،","poem":2},{"text":"چونکە یەزدان قوربانی سەربڕاوی هەیە لە بۆزرا و","poem":1},{"text":"سەربڕینێکی گەورەی هەیە لە خاکی ئەدۆم.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"گای کێوی لەگەڵیان دەکەون،","poem":1},{"text":"گوێرەکەکان لەگەڵ کەڵەگاکان،","poem":2},{"text":"زەوییان بە خوێن ئاو دەدرێت،","poem":1},{"text":"خۆڵیان بە پیو قەڵەو دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"یەزدان ڕۆژی تۆڵەسەندنەوەی هەیە،","poem":1},{"text":"ساڵی سزادان لەبەر کێشەکەی سییۆن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"جا ڕووبارەکانی ئەدۆم دەبن بە قیر و","poem":1},{"text":"خۆڵەکەی بە گۆگرد،","poem":2},{"lineBreak":true},{"text":"زەوییەکەی دەبێت بە قیری داگیرساو!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"شەو و ڕۆژ ناکوژێتەوە،","poem":1},{"text":"دووکەڵی بۆ هەتاهەتایە بەرز دەبێتەوە.","poem":2},{"text":"نەوە دوای نەوە کاول دەبێت،","poem":1},{"text":"بۆ هەتاهەتایە کەس پێیدا تێناپەڕێت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"کوندەپەپووی بیابان و بایەقووش داگیری دەکەن،","poem":1},{"text":"کوندەپەپووی گەورە و قەلەڕەش تێیدا نیشتەجێ دەبن.","poem":2},{"text":"بەسەر ئەدۆمدا خودا گوریسی پێوانە بۆ خاپوور بوون و","poem":1},{"text":"شاووڵی چۆڵبوون درێژ دەکات.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"خانەدانەکانی هیچیان لەوێ نابێت کە بە شانشینێک دادەنرێن،","poem":1},{"text":"هەموو میرەکانی لەناودەچن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"دڕک لە کۆشکەکانی شین دەبێت،","poem":1},{"text":"چقڵ و وشترالووک لە قەڵاکانی.","poem":2},{"text":"دەبێت بە مۆڵگای چەقەڵ و","poem":1},{"text":"لانەی کوندەپەپوو.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"دڕندە بیابانییەکان و کەمتیار پێکدەگەن،","poem":1},{"text":"تەگە","poem":2},{"noteId":54},{"text":"بانگی هاوەڵەکانیان دەکەن،","poem":2},{"text":"دڕندەکان شەو لەوێدا ئارام دەگرن و","poem":1},{"text":"جێی حەوانەوە بۆ خۆیان دەدۆزنەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"لەوێ کوندەپەپوو هێلانە دەکات و هێلکە دەکات،","poem":1},{"text":"کڕ دەکەوێت و لەژێر سێبەری باڵەکانی هەڵیدەهێنێت.","poem":2},{"text":"لەوێ شاهین و شمقاڕ کۆدەبنەوە،","poem":1},{"text":"هەریەکە و لەگەڵ تاکەکەی.","poem":2}]},{"type":"verse","number":16,"content":["تۆمارەکەی یەزدان بپشکنن و بخوێننەوە:",{"text":"یەکێک لەمانە کەم نابێتەوە،","poem":1},{"text":"هیچ مێینەیەک نێرەکەی خۆی ون ناکات،","poem":2},{"text":"چونکە دەمی یەزدان فەرمانی داوە،","poem":1},{"text":"ڕۆحی ئەو کۆیان دەکاتەوە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئەو زەوییەکە لەنێوانیان دابەش دەکات،","poem":1},{"text":"دەستی ئەو بە پەت بۆی بەش دەکات.","poem":2},{"text":"بۆ هەتاهەتایە داگیری دەکەن،","poem":1},{"text":"نەوە دوای نەوە تێیدا نیشتەجێ دەبن.","poem":2}]}],"footnotes":[{"noteId":52,"caller":"+","text":"قڕی کردوون: لە زمانی عیبری ئەم زاراوەیە دەگەڕێتەوە بۆ شتێک یان کەسێک کە دەبەخشرێت بە یەزدان، زۆر جار بەخشینەکە بە تەواوی لە ناودەبردرێت.‏","reference":{"chapter":34,"verse":2}},{"noteId":53,"caller":"+","text":"پیو: واتا بەز، لێرە و لە ئایەتی 7.‏","reference":{"chapter":34,"verse":6}},{"noteId":54,"caller":"+","text":"نێری، سابرێن.‏","reference":{"chapter":34,"verse":14}}]},"thisChapterLink":"/api/ckb_bib/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/ap