},{"text":"ئەو دێت و ڕزگارتان دەکات.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ئەوسا چاوی کوێر دەبینێت و","poem":1},{"text":"گوێی کەڕ دەکرێتەوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەوسا شەل وەک ئاسک باز دەدات و","poem":1},{"text":"زمانی لاڵ هاواری خۆشی دەکات،","poem":2},{"text":"چونکە لە چۆڵەوانی ئاو تەقییەوە و","poem":1},{"text":"ڕووباریش لە بیابان.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"سەراب دەبێتە گۆم و","poem":1},{"text":"خاکی تینوو بە کانیاو.","poem":2},{"text":"لە لانەی چەقەڵەکان، لە مۆڵگەکەیان،","poem":1},{"text":"قامیش و زەلی لێ سەوز دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"لەوێ ڕێڕەوێک و ڕێگایەک دەبێت،","poem":1},{"text":"ڕێگای پیرۆزی پێ دەگوترێت.","poem":2},{"text":"گڵاو پێیدا تێناپەڕێت،","poem":1},{"text":"بەڵکو بۆ ئەوانەیە","poem":2},{"text":"کە بە چاکە پێیدا دەڕۆن،","poem":1},{"text":"گێلەکان پێدا ناڕۆن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"شێر لەوێ نابێت،","poem":1},{"text":"جانەوەری دڕندە بۆ ئەوێ سەرناکەوێت،","poem":2},{"lineBreak":true},{"text":"لەوێ بەرچاو ناکەون.","poem":2},{"text":"بەڵکو ئەوانەی کڕاونەتەوە پێیدا دەڕۆن،","poem":1}]},{"type":"verse","number":10,"content":[{"text":"ئەوانەی یەزدان کڕیونیەتیەوە دەگەڕێنەوە،","poem":2},{"text":"بە هاواری خۆشییەوە بۆ سییۆن دێن،","poem":1},{"text":"شادییەکی هەتاهەتایی بەسەر سەریانەوە.","poem":2},{"text":"خۆشی و شادی پێیان دەگەن و","poem":1},{"text":"ناخۆشی و ئاخ هەڵکێشان هەڵدێن.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}