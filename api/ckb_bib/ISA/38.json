{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["نەخۆشی حەزقیا"]},{"type":"verse","number":1,"content":["لەو ڕۆژانەی",{"noteId":60},"حەزقیا نەخۆش کەوت، لە سەرە مەرگ بوو، ئیشایا پێغەمبەر کوڕی ئامۆچ هات بۆ لای و پێی گوت: «یەزدان ئەمە دەفەرموێت: وەسیەت بۆ ماڵەکەت بکە، چونکە دەمریت و ناژیت.»"]},{"type":"verse","number":2,"content":["حەزقیا ڕووی لە دیوارەکە کرد و نوێژی بۆ یەزدان کرد،"]},{"type":"verse","number":3,"content":["گوتی: «ئای یەزدان، ئەوەت لەیاد بێت کە چۆن بە دڵسۆزی و پڕ بە دڵ دۆستایەتیم کردیت، ئەوەی پێت باش بوو کردم.» ئینجا حەزقیا بەکوڵ گریا."]},{"type":"verse","number":4,"content":["جا ئیشایا فەرمایشتی یەزدانی بۆ هات، فەرمووی:"]},{"type":"verse","number":5,"content":["«بڕۆ و بە حەزقیا بڵێ: ”یەزدان، پەروەردگاری داودی باپیرە گەورەت ئەمە دەفەرموێت: گوێم لە پاڕانەوەکەت بوو و فرمێسکەکانتم بینی، پازدە ساڵ لە تەمەنت زیاد دەکەم و"]},{"type":"verse","number":6,"content":["فریای خۆت و ئەم شارەش دەکەوم، بەرگری لەم شارە دەکەم لە دەستی پاشای ئاشور."]},{"type":"verse","number":7,"content":["«”ئەمەش نیشانە بێت بۆت لەلایەن یەزدانەوە، کە یەزدان ئەم کارە دەکات کە بەڵێنی دا:"]},{"type":"verse","number":8,"content":["ئەوەتا سێبەر دەگەڕێنمەوە بەو پلانەی پێی هاتووەتە خوارەوە، بە پلەکانی ئاحاز بە خۆر، دە پلە بەرەو دواوە.“» جا خۆر دە پلە گەڕایەوە بەو پلانەی پێی هاتبووە خوار."]},{"type":"line_break"},{"type":"verse","number":9,"content":["نووسراوی حەزقیای پاشای یەهودا، دوای ئەوەی نەخۆش کەوت و لە نەخۆشییەکەی چاک بووەوە:"]},{"type":"verse","number":10,"content":[{"text":"گوتم: «ئایا لە هەڕەتی گەنجیمدا","poem":1},{"text":"من دەچم بۆ جیهانی مردووان،","poem":2},{"lineBreak":true},{"text":"چونکە یەزدان لە پاشماوەی ژیانم بێبەشی کردووم؟»","poem":2}]},{"type":"verse","number":11,"content":[{"text":"گوتم: «یەزدان نابینم","poem":1},{"text":"لە خاکی زیندوواندا،","poem":2},{"text":"لەمەودوا چیتر سەیری ئادەمیزاد ناکەم","poem":1},{"text":"لەسەر ڕووی زەوی.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"خانووم هەڵتەکا و لەلام ڕۆیشت","poem":1},{"text":"وەک خێوەتی شوانان،","poem":2},{"text":"وەکو جۆڵا ژیانی خۆمم پێچایەوە و","poem":1},{"text":"لە تەونەکەمدا بڕیمەوە،","poem":2},{"lineBreak":true},{"text":"شەو و ڕۆژ تۆ لەناوم دەبەیت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بە ئارامییەوە هەتا بەرەبەیان چاوەڕێ دەکەم،","poem":1},{"text":"بەڵام وەک شێر ئێسکم ورد دەکات،","poem":2},{"lineBreak":true},{"text":"شەو و ڕۆژ تۆ لەناوم دەبەیت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"وەک پەڕەسێلکە و ڕیشۆڵە جیکە جیک دەکەم،","poem":1},{"text":"وەکو کۆتر دەگمێنم،","poem":2},{"text":"چاوم شل بوو هێندە لە ئاسمان بڕوانم.","poem":1},{"text":"وەڕس بووم، ئەی پەروەردگار، بە هانام وەرە!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ئیتر چی بڵێم؟","poem":1},{"text":"ئەو پێی فەرمووم و ئەو خۆی کردی.","poem":2},{"text":"بە بێفیزی بە هەموو ساڵانمدا دەڕۆم","poem":1},{"text":"لەبەر تاڵاوی گیانم.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئەی پەروەردگار، مرۆڤ لەسەر ئەمانە دەژین،","poem":1},{"text":"ژیانی ڕۆحیم لە هەموو ئەمانەدایە.","poem":2},{"text":"تۆ منت چاککردەوە و","poem":1},{"text":"ژیانت پێ بەخشیم.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"بێگومان سوودی بۆ من هەبوو کە","poem":1},{"text":"تاڵی لەسەر تاڵیم چێشت.","poem":2},{"text":"لە خۆشەویستیدا تۆ گیانی منت","poem":1},{"text":"لە تەڵەی لەناوچوون ڕزگار کرد،","poem":2},{"text":"چونکە هەموو گوناهەکانی منت","poem":1},{"text":"فڕێدایە پشت خۆتەوە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"جیهانی مردووان سوپاست ناکات و","poem":1},{"text":"مردووانیش ستایشت ناکەن،","poem":2},{"text":"هەروەها ئەوانەی لە گۆڕ دەنرێن","poem":1},{"text":"هیوایان بە دڵسۆزی تۆ نییە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"زیندووان، تەنها زیندووان سوپاست دەکەن،","poem":1},{"text":"باوکان دڵسۆزی تۆ","poem":2},{"lineBreak":true},{"text":"بە منداڵەکانیان دەناسێنن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"یەزدان ڕزگارم دەکات،","poem":1},{"text":"هەموو ڕۆژانی ژیانمان","poem":2},{"text":"مۆسیقا دەژەنین","poem":1},{"text":"لە پەرستگای یەزدان.","poem":2}]},{"type":"verse","number":21,"content":["ئینجا ئیشایا گوتی: «با هەویری هەنجیر هەڵبگرن و بیخەنە سەر دوومەڵەکە، چاک دەبێتەوە.»"]},{"type":"verse","number":22,"content":["حەزقیاش گوتبووی: «نیشانە چییە، کە دەچمە پەرستگای یەزدان؟»"]}],"footnotes":[{"noteId":60,"caller":"+","text":"مەبەست لەو ڕۆژانەیە پێش ڕووداوەکانی بەشی 36.‏","reference":{"chapter":38,"verse":1}}]},"thisChapterLink":"/api/ckb_bib/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}