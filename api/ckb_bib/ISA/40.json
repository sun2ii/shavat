{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["حەسانەوە بۆ گەلی خودا"]},{"type":"verse","number":1,"content":[{"text":"دڵنەوایی گەلەکەم بکەن، دڵنەواییان بکەن،","poem":1},{"text":"خوداتان دەفەرموێت،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بە دڵنەرمی لەگەڵ ئۆرشەلیم بدوێن،","poem":1},{"text":"پێی ڕابگەیەنن","poem":2},{"text":"کە ڕەنجکێشانەکەی تەواو بووە،","poem":1},{"text":"کە تاوانەکەی بەخشراوە،","poem":2},{"text":"چونکە بە دەستی یەزدان","poem":1},{"text":"لەسەر گوناهەکانی دووقاتی وەرگرتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"کەسێک هاوار دەکات و دەڵێت:","poem":1},{"lineBreak":true},{"text":"«لە چۆڵەوانی ڕێگا بۆ هاتنی یەزدان ئامادە بکەن،","poem":1},{"text":"لە بیابان شاڕێگا بۆ خودامان ڕێکبخەن.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"هەموو دۆڵێک هەڵدەچێت و","poem":1},{"text":"هەموو چیا و گردێک ڕۆدەچێت.","poem":2},{"text":"خوار ڕاست دەبێتەوە،","poem":1},{"text":"هەورازیش دەبێت بە دەشت،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"شکۆمەندی یەزدان دەردەکەوێت و","poem":1},{"text":"هەموو مرۆڤایەتی پێکەوە دەیبینن،","poem":2},{"text":"چونکە دەمی یەزدان فەرمووی.»","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"دەنگێک دەڵێت: «بانگەواز بکە!»","poem":1},{"text":"منیش گوتم: «بانگەوازی چی بکەم؟»","poem":2},{"lineBreak":true},{"text":"«هەموو مرۆڤێک وەک گژوگیا وایە و","poem":1},{"text":"هەموو دڵسۆزییەکەی وەک گوڵی کێوی وایە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"گژوگیا وشک دەبێت و گوڵ هەڵدەوەرێ،","poem":1},{"text":"چونکە هەناسەی یەزدان هەڵیکردە سەری،","poem":2},{"lineBreak":true},{"text":"بێگومان گەل وەکو گژوگیان.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"گژوگیا وشک دەبێت و گوڵ هەڵدەوەرێ،","poem":1},{"text":"بەڵام پەیامی خودامان بۆ هەتاهەتایە چەسپاو دەبێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەی مزگێنیدەر بۆ سییۆن،","poem":1},{"text":"بڕۆ سەر کێوێکی بەرز،","poem":2},{"text":"بە هێزەوە دەنگت بەرز بکەرەوە،","poem":1},{"text":"بەرزی بکەرەوە، مەترسە.","poem":2},{"text":"ئەی مزگێنیدەر بۆ ئۆرشەلیم،","poem":1},{"text":"بە شارۆچکەکانی یەهودا بڵێ:","poem":2},{"lineBreak":true},{"text":"«ئەوەتا خوداتان!»","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەوەتا یەزدانی باڵادەست بە هێزەوە دێت،","poem":1},{"text":"بە بازووی فەرمانڕەوایەتی بۆ دەکات.","poem":2},{"text":"ئەوەتا پاداشتەکەی لەگەڵیدایە و","poem":1},{"text":"خەڵاتەکەی لەبەردەمی.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"وەک شوان مێگەلەکەی دەلەوەڕێنێت:","poem":1},{"text":"بە بازووی خۆی بەرخەکان کۆدەکاتەوە و","poem":2},{"text":"بە باوەش هەڵیاندەگرێت،","poem":1},{"text":"بە نەرمی شیردەرەکان بە پێش خۆی دەدات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"کێ بە چنگ ئاوی پێواوە و","poem":1},{"text":"بە بست ئاسمان؟","poem":2},{"text":"کێ خۆڵی زەوی بە قزناغ پێواوە؟","poem":1},{"text":"کێ چیاکانی بە قەپان کێشاوە و","poem":2},{"lineBreak":true},{"text":"گردەکانیش بە تەرازوو؟","poem":2}]},{"type":"verse","number":13,"content":[{"text":"کێ لەبیری یەزدان تێگەیشتووە","poem":1},{"text":"یاخود وەک ڕاوێژکار فێری کردووە؟","poem":2}]},{"type":"verse","number":14,"content":[{"text":"یەزدان ڕاوێژی بە کێ کرد و تێیگەیاند،","poem":1},{"text":"ڕێگای دادپەروەری فێرکرد؟","poem":2},{"text":"کێ زانینی فێرکرد و","poem":1},{"text":"ڕێگای تێگەیشتنی پێ ناساند؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ئەوەتا نەتەوەکان وەک دڵۆپێک ئاوی ناو سەتڵ و","poem":1},{"text":"بە تۆزی تەرازوو دادەنرێن.","poem":2},{"lineBreak":true},{"text":"ئەوەتا دوورگەکان وەک پووش هەڵدەگرێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"داری لوبنان بەس نییە بۆ سووتەمەنی قوربانگا و","poem":1},{"text":"ئاژەڵەکانی بەس نین بۆ قوربانی سووتاندن.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"هەموو نەتەوەکان وەک هیچن لەبەردەمی،","poem":1},{"text":"لەلای ئەو بە نەبوو و پووچ دادەنرێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"جا خودا بە چی هاوشێوە دەکەن،","poem":1},{"text":"چ وێنەیەک بەو یەکسان دەکەن؟","poem":2}]},{"type":"verse","number":19,"content":[{"text":"پەیکەرێک کە وەستا دایدەڕێژێت،","poem":1},{"text":"زێڕنگەریش بە زێڕ ڕووکەشی دەکات،","poem":2},{"lineBreak":true},{"text":"زنجیری زیویش زیوگەر.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"دەستکورتیش بۆ پێشکەشکردنی پیتاک","poem":1},{"text":"دارێکی ساغ هەڵدەبژێرێت کە نەڕزیبێت.","poem":2},{"text":"داوای وەستایەکی شارەزا دەکات","poem":1},{"text":"بۆ ئەوەی پەیکەرێکی نەلەقیوی بۆ دابنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ئایا نازانن؟","poem":1},{"text":"ئایا نابیستن؟","poem":2},{"text":"ئەی لە سەرەتاوە پێتان ڕانەگەیەنراوە؟","poem":1},{"text":"ئایا لەو کاتەوەی زەوی بەدیهێنراوە تێنەگەیشتوون کە","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ئەو لەسەر ئاسۆی زەوی دادەنیشێت و","poem":1},{"text":"دانیشتووانەکەی وەک پێکوڕە وان؟","poem":2},{"text":"ئەو ئاسمان وەک پڵاس بڵاو دەکاتەوە،","poem":1},{"text":"وەک ڕەشماڵ هەڵیدەدات بۆ نیشتەجێبوون.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ئەو مەزنەکان وەک نەبوو لێدەکات و","poem":1},{"text":"حوکمڕانانی جیهان دەکات بە هیچ.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"هەر ئەوەندەی نێژران، چێنران و","poem":1},{"text":"قەدیان لە زەوی ڕەگی داکوتا،","poem":2},{"text":"فووی لێکردن و وشک هەڵگەڕان،","poem":1},{"text":"ڕەشەبا وەک پووش هەڵیاندەگرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"خودای پیرۆز دەفەرموێت: «لەگەڵ کێ هاوشێوەم دەکەن؟","poem":1},{"text":"من هاوتای کێم؟","poem":2}]},{"type":"verse","number":26,"content":[{"text":"چاوتان بۆ بەرزی هەڵبڕن و","poem":1},{"text":"ببینن کێ ئەمەی بەدی هێناوە،","poem":2},{"text":"کێ ئەستێرەکانی بە ژمارە دەردەهێنێت و","poem":1},{"text":"ناو لە هەموویان دەنێت؟","poem":2},{"text":"لەبەر زۆری هێز و توندی توانای","poem":1},{"text":"هیچ کامیان ون نابێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«ئەی یاقوب، بۆ دەڵێیت،","poem":1},{"text":"ئەی ئیسرائیل، بۆ سکاڵا دەکەیت:","poem":2},{"text":"”ڕێگای من لە یەزدان شاردرایەوە،","poem":1},{"text":"دادی من لە خودام تێپەڕی“؟","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ئایا نەتزانی،","poem":1},{"text":"یان نەتبیست؟","poem":2},{"text":"یەزدان خودای هەتاهەتاییە،","poem":1},{"text":"بەدیهێنەری ئەمسەر و ئەوسەری زەوی.","poem":2},{"text":"نە ماندوو و نە شەکەت دەبێت،","poem":1},{"text":"کەس پەی بە تێگەیشتنی ئەو نابات.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"توانا بە ماندوو دەدات و","poem":1},{"text":"بۆ داهێزراویش هێز زۆر دەکات.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"گەنجەکان ماندوو و شەکەت دەبن،","poem":1},{"text":"لاوەکان پێیان هەڵدەکەوێت و دەکەون،","poem":2}]},{"type":"verse","number":31,"content":[{"text":"بەڵام ئەوانەی چاوەڕوانی یەزدانن،","poem":1},{"text":"هێزیان نوێ دەبێتەوە،","poem":2},{"text":"وەک هەڵۆ لە شەقەی باڵ دەدەن،","poem":1},{"text":"ڕادەکەن و شەکەت نابن،","poem":2},{"lineBreak":true},{"text":"دەڕۆن و ماندوو نابن.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}