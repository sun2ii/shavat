{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["یارمەتیدەری ئیسرائیل"]},{"type":"verse","number":1,"content":[{"text":"«ئەی خەڵکی دوورگەکان لەبەردەمم بێدەنگ بن!","poem":1},{"text":"با نەتەوەکان هێزیان نوێ بکەنەوە!","poem":2},{"text":"با نزیک بنەوە ئینجا قسە بکەن،","poem":1},{"text":"با پێکەوە بچینە دادگاییکردن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«کێ لە ڕۆژهەڵاتەوە کەسە سەرکەوتووەکەی هەستاندووە،","poem":1},{"text":"ئەوەی بە ڕاستودروستی بانگی کرد بۆ خزمەتەکەی؟","poem":2},{"text":"نەتەوەکانی دەداتە پێشی،","poem":1},{"text":"پاشایان ژێردەستەی دەکات.","poem":2},{"text":"بە شمشێرەکەی وەک خۆڵیان لێ دەکات،","poem":1},{"text":"بە کەوانەکەی وەک سەرکۆزەری بەباکراو.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ڕاویان دەنێت، بە سەلامەتی تێدەپەڕێت،","poem":1},{"text":"بە ڕێگایەکدا کە پێیەکانی پێیدا نەڕۆیشتوون.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"کێ کردوویەتی و کێ ئەنجامی داوە،","poem":1},{"text":"لە سەرەتاوە بانگی نەوەکانی کردووە؟","poem":2},{"text":"من یەزدانم،","poem":1},{"text":"لە سەرەتاوە هەتا کۆتایی، من هەر ئەوم.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"دوورگەکان تەماشایان کردووە و دەترسن،","poem":1},{"text":"هەر چوار لای زەوی دەلەرزن،","poem":2},{"text":"نزیک بوونەوە و دێن،","poem":1}]},{"type":"verse","number":6,"content":[{"text":"هەریەکە و هاوکاری برادەرەکەی دەکات،","poem":2},{"lineBreak":true},{"text":"بە براکەی دەڵێت: «ورەت بەرز بێت!»","poem":2}]},{"type":"verse","number":7,"content":[{"text":"دارتاش زێڕنگەر هاندەدات،","poem":1},{"text":"ئەوەی بە چەکوش لووس دەکات","poem":2},{"lineBreak":true},{"text":"ئاسنگەر هاندەدات لە دەستگاکەی بکوتێت،","poem":2},{"text":"بە جۆشکردن دەڵێت: «باشە.»","poem":1},{"text":"بە بزمارەکان توندی دەکات هەتا نەلەقێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«بەڵام تۆ ئەی ئیسرائیلی بەندەم،","poem":1},{"text":"ئەی یاقوب کە هەڵمبژاردووە،","poem":2},{"lineBreak":true},{"text":"توخمی ئیبراهیمی خۆشەویستم،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەوەی لەوپەڕی زەوییەوە تۆم گرت،","poem":1},{"text":"لە دوورترین گۆشەیەوە بانگم کردیت و","poem":2},{"text":"بە تۆم گوت: ”تۆ بەندەی منیت،“","poem":1},{"text":"تۆم هەڵبژاردووە و ڕەتم نەکردوویتەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"مەترسە، چونکە لەگەڵتدام،","poem":1},{"text":"مەپەشۆکێ، چونکە من خودای تۆم.","poem":2},{"text":"بەهێزت دەکەم و یارمەتیت دەدەم،","poem":1},{"text":"بە دەستی ڕاستی دادپەروەریم پشتیوانیت دەکەم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ئەوەتا شەرمەزار و ڕیسوا دەبن","poem":1},{"text":"هەموو ئەوانەی لە تۆ تووڕەن،","poem":2},{"text":"وەک هیچیان لێدێت و لەناودەچن","poem":1},{"text":"ئەوانەی دژایەتیت دەکەن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بەدوایدا دەگەڕێیت و نایانبینیتەوە","poem":1},{"text":"ئەوانەی ناکۆکن لەگەڵت.","poem":2},{"text":"ئەوانەی لە دژت دەجەنگن","poem":1},{"text":"وەک هیچ و وەک نەبوو دەبن،","poem":2}]},{"type":"verse","number":13,"content":[{"text":"چونکە من یەزدانم، خودای تۆ،","poem":1},{"text":"ئەوەی دەستی ڕاستی گرتوویت،","poem":2},{"text":"ئەوەی پێت دەڵێت،","poem":1},{"text":"مەترسە، من یارمەتیت دەدەم.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"مەترسە ئەی یاقوبی کرم،","poem":1},{"text":"ئەی ئیسرائیلی بچووک،","poem":2},{"text":"من یارمەتیت دەدەم.» ئەوە فەرمایشتی یەزدانە،","poem":1},{"text":"ئەوەی دەتکڕێتەوە، پیرۆزەکەی ئیسرائیل.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"«ئەوەتا دەتکەمە جەنجەڕێکی","poem":1},{"text":"تیژی نوێی دداندار.","poem":2},{"text":"چیاکان دەکوتییەوە و وردوخاشیان دەکەیت،","poem":1},{"text":"گردەکان وەک کا لێ دەکەیت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"شەنیان دەکەیت و با هەڵیاندەگرێت،","poem":1},{"text":"ڕەشەبا پەرتوبڵاویان دەکات،","poem":2},{"text":"بەڵام تۆ بە یەزدان دڵخۆش دەبیت،","poem":1},{"text":"شانازی بە خودا پیرۆزەکەی ئیسرائیل دەکەیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«کڵۆڵ و هەژاران بەدوای ئاودا دەگەڕێن و نییە،","poem":1},{"text":"لە تینووێتییان زمانیان وشک بوو.","poem":2},{"text":"بەڵام من یەزدانم بە دەنگیانەوە دەچم،","poem":1},{"text":"خودای ئیسرائیلم بەجێیان ناهێڵم.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ڕووباری ڕۆیشتوو لە گردۆڵکەکان دەردەهێنم،","poem":1},{"text":"کانیاو لەناوەندی دۆڵەکانیش هەڵدەقوڵێنم.","poem":2},{"text":"چۆڵەوانی دەکەم بە گۆلاو،","poem":1},{"text":"زەوی وشک دەکەمە سەرچاوەی ئاو.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"داری ئورز و ئەکاسیا","poem":1},{"noteId":62},{"text":"و مۆرد","poem":1},{"noteId":63},{"text":"و زەیتوون","poem":1},{"text":"لە چۆڵەوانی دەڕوێنم،","poem":2},{"text":"داری سنەوبەر و کاژ و سەروو پێکەوە","poem":1},{"text":"لە بیابان دادەنێم،","poem":2}]},{"type":"verse","number":20,"content":[{"text":"بۆ ئەوەی پێکەوە ببینن و بزانن و","poem":1},{"text":"سەرنج بدەن و تێبگەن","poem":2},{"text":"کە دەستی یەزدان ئەمەی کردووە و","poem":1},{"text":"خودا پیرۆزەکەی ئیسرائیل بەدییهێناوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"یەزدان دەفەرموێت: «بەرگری لە خۆتان بکەن.»","poem":1},{"text":"پاشای یاقوب دەفەرموێت: «بەڵگەکانتان بخەنە بەردەستم.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بتەکانتان بهێنن و با پێمان ڕابگەیەنن","poem":1},{"text":"ئەوەی ڕوودەدات.","poem":2},{"text":"ئەوانەی ڕابردوو چین، پێمان ڕابگەیەنن،","poem":1},{"text":"با مێشکمان بخەینە سەری و","poem":2},{"lineBreak":true},{"text":"بزانین کۆتاییەکەیان چییە.","poem":2},{"text":"یان داهاتوومان پێ بڵێن،","poem":1}]},{"type":"verse","number":23,"content":[{"text":"ئەوانەی لە داهاتوودا دێن، ڕایبگەیەنن","poem":2},{"lineBreak":true},{"text":"بۆ ئەوەی بزانین ئێوە خوداوەندەکانن،","poem":2},{"text":"هەرچی بێت بیکەن، چاکە یان خراپە،","poem":1},{"text":"هەتا پێکەوە سەرسام بین و ببینین.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"بەڵام ئێوە هیچن و","poem":1},{"text":"کارەکانتان لە هیچ کەمترن،","poem":2},{"lineBreak":true},{"text":"قێزەونە ئەوەی ئێوە هەڵدەبژێرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«لە باکوورەوە هەڵمستاند و هات.","poem":1},{"text":"لە ڕۆژهەڵاتەوە بە ناوی منەوە نزا دەکات،","poem":2},{"text":"بەسەر پارێزگارەکاندا دێت وەک بەسەر قوڕدا،","poem":1},{"text":"وەک گۆزەکەر قوڕ بشێلێت.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"کێ لە سەرەتاوە ڕایگەیاند، بۆ ئەوەی بزانین،","poem":1},{"text":"پێشوەخت، هەتا بڵێین: ”ڕاستودروستە؟“","poem":2},{"text":"بێگومان ڕاگەیەنەر نییە،","poem":1},{"text":"بێگومان بەگوێدادەر نییە،","poem":2},{"lineBreak":true},{"text":"بێگومان گوێگری وشەکانتان نییە.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"سەرەتا بە سییۆن: ”ئەوەتا ئەوان!“","poem":1},{"text":"بە ئۆرشەلیمیش مزگێنیدەرم دا.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"بینیم کەس نییە،","poem":1},{"text":"ئەمانە ڕاوێژکاریان تێدا نییە","poem":2},{"lineBreak":true},{"text":"هەتا پرسیاریان لێ بکەم و بە وشەیەک وەڵام بدەنەوە.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"تەماشا بکە، هەموو هەڵخەڵەتێنەرن!","poem":1},{"text":"کارەکانیان هیچ نین،","poem":2},{"lineBreak":true},{"text":"بتە داتاشراوەکانیان بە وێنەی بایە و پووچن.","poem":2}]}],"footnotes":[{"noteId":62,"caller":"+","text":"داری شەتیم.‏","reference":{"chapter":41,"verse":19}},{"noteId":63,"caller":"+","text":"مۆرد: دارێکە گەڵاکانی بەبریقە و سەوزێکی تۆخە، گوڵی سپی دەگرێت و بۆنی خۆشە، لە بێت‌لەحم و حەبرۆن هەیە. ئەو ناوەی ئێستا لە ڕۆژهەڵات بەکاریدەهێنن بۆی (ئاس)ـە.‏","reference":{"chapter":41,"verse":19}}]},"thisChapterLink":"/api/ckb_bib/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}