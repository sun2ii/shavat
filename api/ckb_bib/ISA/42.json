{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["بەندەی یەزدان"]},{"type":"verse","number":1,"content":[{"text":"«ئەوەتا خزمەتکارەکەم، ئەوەی پشتیوانی دەکەم،","poem":1},{"text":"هەڵبژاردەکەم کە پێی دڵشادم،","poem":2},{"text":"ڕۆحی خۆمی دەخەمە سەر،","poem":1},{"text":"دادپەروەری بۆ نەتەوەکان بەرپا دەکات.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"هاوار ناکات و بانگ ناکات و","poem":1},{"text":"دەنگی لە شەقامەکان نابیسترێت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"قامیشێکی کوتراو ناشکێنێت،","poem":1},{"text":"پڵیتەیەکی پرتەپرتکەر ناکوژێنێتەوە.","poem":2},{"text":"بە ڕاستییەوە دادپەروەری دەردەخات.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"نە ماندوو دەبێت و نە وردوخاش دەبێت","poem":2},{"text":"هەتا ئەوەی لەسەر زەوی دادپەروەری بەرقەرار دەکات.","poem":1},{"text":"دوورگەکان هیوایان بە فێرکردنەکانی ئەو دەبێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"خودای پەروەردگار، بەدیهێنەری ئاسمان و لێککەرەوەی،","poem":1},{"text":"ڕاخەری زەوی و ئەوەی لێی بەرهەم دێت،","poem":2},{"text":"هەناسەی داوە بەو گەلەی لەسەریەتی،","poem":1},{"text":"ڕۆحیش بەوانەی هاتوچۆی تێدا دەکەن،","poem":2},{"text":"ئەمە دەفەرموێت:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"«من یەزدانم، بە ڕاستودروستی بانگم کردیت،","poem":1},{"text":"جا دەستت دەگرم و دەتپارێزم،","poem":2},{"lineBreak":true},{"text":"دەتکەمە پەیمان بۆ گەل و ڕووناکی بۆ نەتەوەکان.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بۆ ئەوەی چاوی نابیناکان بکەیتەوە،","poem":1},{"text":"بۆ ئەوەی دیلەکان لە زیندان دەربهێنیت،","poem":2},{"lineBreak":true},{"text":"لە بەندیخانەش دانیشتووان لە تاریکی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«من یەزدانم، ئەمەیە ناوم و","poem":1},{"text":"شکۆمەندی خۆم نادەمە کەسی دیکە و","poem":2},{"lineBreak":true},{"text":"ستایشم نادەمە بتە تاشراوەکان.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ببینن، ئەوەی لە ڕابردوو گوترا هاتە دی،","poem":1},{"text":"ئێستاش شتی نوێتان پێ ڕادەگەیەنم،","poem":2},{"text":"پێش ئەوەی سەر دەربێنێت","poem":1},{"text":"من پێتانی دەڵێم.»","poem":2}]},{"type":"heading","content":["گۆرانی ستایش بۆ یەزدان"]},{"type":"verse","number":10,"content":[{"text":"ئەی ئەوانەی دادەبەزنە ناو دەریا و هەموو ئەوانەی تێیدان،","poem":1},{"text":"دوورگەکان و دانیشتووانەکانیان،","poem":2},{"text":"گۆرانییەکی نوێ بۆ یەزدان بڵێن،","poem":1},{"text":"ستایشیشی لەوپەڕی زەوییەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"با چۆڵەوانی و شارۆچکەکانی دەنگ بەرز بکەنەوە،","poem":1},{"text":"گوندەکانی نشینگەی قێدار.","poem":2},{"text":"با دانیشتووانی سەلەع هاواری خۆشی بکەن،","poem":1},{"text":"لە ترۆپکی چیاکانەوە هاوار بکەن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"با شکۆمەندی بە یەزدان بدەن،","poem":1},{"text":"لە دوورگەکان ستایشی ڕابگەیەنن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"یەزدان وەک پاڵەوان دێتە دەرەوە،","poem":1},{"text":"وەک جەنگاوەر دڵگەرمی دەهەژێت،","poem":2},{"text":"هاوار دەکات و نەعرەتەی جەنگ دەکێشێت،","poem":1},{"text":"بەسەر دوژمنانیدا سەردەکەوێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«زۆر دەمێکە کپ بووم،","poem":1},{"text":"بێدەنگ بووم و دانم بە خۆمدا گرت.","poem":2},{"text":"بەڵام ئێستا وەک ژنێک کە منداڵی ببێت دەقیژێنم،","poem":1},{"text":"هەناسە دەدەم و هەناسە هەڵدەکێشم پێکەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"چیا و گردەکان تێکدەدەم،","poem":1},{"text":"هەموو گیاوگوڵیان وشک دەکەم.","poem":2},{"text":"ڕووبار دەکەمە دوورگە و","poem":1},{"text":"گۆلاوەکان وشک دەکەم.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"نابیناکان بە ڕێگایەکدا دەبەم شارەزای نەبن،","poem":1},{"text":"بە ڕێچکەیەکدا هاتوچۆیان پێ دەکەم کە نایزانن،","poem":2},{"text":"تاریکی لەبەردەمیاندا دەکەم بە ڕووناکی،","poem":1},{"text":"ڕێگا خوارەکانیش بە ڕاستە ڕێ.","poem":2},{"text":"ئەم شتانە دەکەم و","poem":1},{"text":"بەجێیان ناهێڵم.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"بەڵام ئەوانەی پشت بە بتی داڕێژراو دەبەستن،","poem":1},{"text":"ئەوانەی بە پەیکەری داتاشراو دەڵێن، ”ئێوە خوداوەندی ئێمەن،“","poem":2},{"lineBreak":true},{"text":"بەرەو دواوە دەگەڕێنەوە و بە تەواوی شەرمەزار دەبن.","poem":2}]},{"type":"heading","content":["ئیسرائیلی کوێر و کەڕ"]},{"type":"verse","number":18,"content":[{"text":"«ئەی کەڕەکان گوێ بگرن!","poem":1},{"text":"ئەی کوێرەکان سەیر بکەن بۆ ئەوەی ببینن!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"کێ کوێرە تەنها بەندەکەم","poem":1},{"noteId":64},{"text":"نەبێت،","poem":1},{"text":"یان کەڕە وەک نێردراوەکەم کە دەینێرم؟","poem":2},{"text":"کێ کوێرە وەک ئەوەی تەواوە و","poem":1},{"text":"کوێرە وەک بەندەی یەزدان؟","poem":2}]},{"type":"verse","number":20,"content":[{"text":"زۆرت بینیوە و سەرنجت نەداوە،","poem":1},{"text":"گوێیەکانت کراونەتەوە و نەتبیستووە.»","poem":2}]},{"type":"verse","number":21,"content":[{"text":"یەزدان دڵخۆشە لە پێناوی ڕاستودروستی خۆی،","poem":1},{"text":"فێرکردنەکانی خۆی بە گەورە دادەنێت و ڕێزی لێ دەگرێت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بەڵام ئەو گەلێکی تاڵانکراو و ڕووتکراوەیە","poem":1},{"text":"هەموو کەوتوونەتە چاڵەوە،","poem":2},{"lineBreak":true},{"text":"لە بەندیخانەکان خۆیان شاردووەتەوە،","poem":2},{"text":"بوون بە تاڵانی و کەس فریایان نەکەوت،","poem":1},{"text":"ڕووتکرانەوە و کەس نەبوو بڵێت، «دەست بگێڕەوە!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"کێ لە ئێوە گوێ لەمە دەگرێت،","poem":1},{"text":"گوێ شل دەکات و هەتا کۆتایی دەبیستێت؟","poem":2}]},{"type":"verse","number":24,"content":[{"text":"کێ یاقوبی دایە دەست ڕووتکردنەوە و","poem":1},{"text":"ئیسرائیلیش بۆ تاڵانکاران؟","poem":2},{"text":"ئایا یەزدان نییە","poem":1},{"text":"کە گوناهمان دەرهەقی کرد و","poem":2},{"text":"نەیانویست ڕێگاکانی بگرنەبەر و","poem":1},{"text":"گوێیان لە فێرکردنەکانی نەگرت؟","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ئیتر گڕی تووڕەیی خۆی بەسەردا ڕشتن،","poem":1},{"text":"بە جەنگێکی سەخت،","poem":2},{"text":"لە هەموو لایەکەوە گڕی تێبەردان، بەڵام پێیان نەزانی،","poem":1},{"text":"سووتاندنی، بەڵام نەچووە مێشکیانەوە.","poem":2}]}],"footnotes":[{"noteId":64,"caller":"+","text":"مەبەست لە گەلی ئیسرائیل و پێغەمبەرەکانە.‏","reference":{"chapter":42,"verse":19}}]},"thisChapterLink":"/api/ckb_bib/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}