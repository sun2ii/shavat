{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["تاکە ڕزگارکەری ئیسرائیل"]},{"type":"verse","number":1,"content":[{"text":"ئێستاش یەزدان ئەمە دەفەرموێت،","poem":1},{"text":"بەدیهێنەرت، ئەی یاقوب،","poem":2},{"lineBreak":true},{"text":"شێوەکێشت، ئەی ئیسرائیل:","poem":2},{"text":"«مەترسە، چونکە تۆم کڕیوەتەوە،","poem":1},{"text":"بە ناوی خۆتەوە بانگم کردوویت، تۆ هی منیت.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"کە بەناو ئاودا بپەڕیتەوە، من لەگەڵتدام،","poem":1},{"text":"بەناو ڕووبارەکانیشدا، نوقومت ناکەن.","poem":2},{"text":"بەناو ئاگردا بڕۆیت، داغ نابیت،","poem":1},{"text":"بڵێسەش ناتسووتێنێت،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"چونکە من یەزدانم، خودای تۆم،","poem":1},{"text":"پیرۆزەکەی ئیسرائیل، ڕزگارکەری تۆ.","poem":2},{"text":"میسرم کردووە بە کەفارەتی تۆ،","poem":1},{"text":"کوش و سەبا لە جێی تۆ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لەبەر ئەوەی تۆ بەنرخ بوویت لەلام،","poem":1},{"text":"سەنگین بوویت و من خۆشم ویستیت،","poem":2},{"text":"لە جێی تۆ خەڵکی دەدەم،","poem":1},{"text":"لە جیاتی گیانت نەتەوەکان.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"مەترسە، چونکە من لەگەڵتدام.","poem":1},{"text":"لە ڕۆژهەڵاتەوە نەوەکانت دەهێنم و","poem":2},{"lineBreak":true},{"text":"لە ڕۆژئاواوە کۆت دەکەمەوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بە باکوور دەڵێم: ”بیاندەرێ!“ و","poem":1},{"text":"بە باشووریش: ”مەیانگرە!“","poem":2},{"text":"کوڕانم لە دوورەوە بهێنە و","poem":1},{"text":"کچانم لەوپەڕی زەوییەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"هەموو ئەوانەی بە ناوی منەوە بانگ دەکرێن،","poem":1},{"text":"بۆ شکۆمەندیی خۆم بەدیم هێناون،","poem":2},{"lineBreak":true},{"text":"شێوەم کێشاون و دروستم کردوون.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"دەریبخە ئەو گەلەی کوێرە، بەڵام چاوی هەیە،","poem":1},{"text":"کەڕە، بەڵام گوێی هەیە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"با هەموو نەتەوەکان پێکەوە کۆببنەوە،","poem":1},{"text":"با نەتەوەکان خڕ ببنەوە.","poem":2},{"text":"کێ لەوان ئەمە ڕادەگەیەنێت و","poem":1},{"text":"سەرەتاکانمان پێ دەڵێت؟","poem":2},{"text":"با شایەتەکانیان بهێننە پێش و ڕاستی پێشبینییەکانیان دەربخەن،","poem":1},{"text":"یان گوێیان لێ بێت و بڵێن: «ڕاستە.»","poem":2}]},{"type":"verse","number":10,"content":[{"text":"یەزدان دەفەرموێت: «ئێوە شایەتی منن،","poem":1},{"text":"بەندەی هەڵبژاردەم،","poem":2},{"text":"بۆ ئەوەی بزانن و باوەڕم پێ بهێنن و","poem":1},{"text":"تێبگەن کە من ئەوم،","poem":2},{"text":"پێش من شێوەی هیچ خودایەک نەکێشراوە و","poem":1},{"text":"پاش منیش نابێت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"منم، منم یەزدان،","poem":1},{"text":"لە من بەولاوە ڕزگارکەر نییە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"من ئاشکرام کرد و ڕزگارم کرد و ڕامگەیاند،","poem":1},{"text":"منم، نەک خوداوەندێکی بێگانە لەنێوتاندا بێت.","poem":2},{"text":"ئێوە شایەتی منن کە من خودام.» ئەوە فەرمایشتی یەزدانە.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"«لەو ڕۆژەوە من ئەوم،","poem":2},{"text":"کەس لە دەستم دەرباز نابێت.","poem":1},{"text":"هەرچی بکەم، کێ ڕەتی دەکاتەوە؟»","poem":2}]},{"type":"heading","content":["بەزەیی خودا و بێوەفایی ئیسرائیل"]},{"type":"verse","number":14,"content":[{"text":"یەزدان ئەوەی دەتانکڕێتەوە،","poem":1},{"text":"پیرۆزەکەی ئیسرائیل، ئەمە دەفەرموێت:","poem":2},{"text":"«لە پێناوی ئێوە دەنێرم بۆ بابل و","poem":1},{"text":"هەموو هەڵاتووەکانی بەدەردەنێم،","poem":2},{"lineBreak":true},{"text":"بابلییەکانیش بەو کەشتییانەی کە هاواری شادییان تێدا کردبوون.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"منم یەزدان، پیرۆزەکەتان،","poem":1},{"text":"بەدیهێنەری ئیسرائیل، پاشاکەتان.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"یەزدان، ئەوەی لەناو دەریا ڕێگای داناوە،","poem":1},{"text":"لەناو ئاوە بەهێزەکان ڕێچکە،","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئەوەی گالیسکە و ئەسپی دەرکرد،","poem":1},{"text":"سوپا و هێزی پێکەوە ڕاکێشا و هەڵنەستانەوە،","poem":2},{"text":"کپ بوون، وەک پڵیتەیەک کوژانەوە،","poem":1},{"text":"ئەو ئەمە دەفەرموێت:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"«باسی سەرەتاکان مەکەن،","poem":1},{"text":"لە دێرینەکان ڕامەمێنن.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەوەتا من شتێکی نوێ دەکەم!","poem":1},{"text":"ئێستا سەرهەڵدەدات، ئایا نایزانن؟","poem":2},{"text":"لە چۆڵەوانی ڕێگا دادەنێم و","poem":1},{"text":"لە بیابان ڕووبارەکان.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئاژەڵە کێوییەکان شکۆمەندم دەکەن،","poem":1},{"text":"چەقەڵ و کوندەپەپوو،","poem":2},{"text":"چونکە ئاوم خستە چۆڵەوانییەوە،","poem":1},{"text":"ڕووبارەکان لە بیاباندا","poem":2},{"text":"بۆ ئاودانی گەلەکەم، هەڵبژاردەکەم،","poem":1}]},{"type":"verse","number":21,"content":[{"text":"ئەم گەلە بۆ خۆم شێوەم کێشاوە","poem":2},{"lineBreak":true},{"text":"باسی ستایشم دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«بەڵام نزاتان بۆ نەکردم، ئەی یاقوب،","poem":1},{"text":"لە پێناوی من کۆششتان نەکرد، ئەی ئیسرائیل.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"بەرخی قوربانی سووتاندنەکەی خۆتت بۆ من نەهێنا،","poem":1},{"text":"بە قوربانییە سەربڕدراوەکانت ڕێزت لێ نەگرتم.","poem":2},{"text":"بە پێشکەشکراوی دانەوێڵە بارگرانم نەکردیت،","poem":1},{"text":"بە قوربانی بخوور ماندووم نەکردیت.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"بە زیوەکەت قامیشی بۆنخۆشت بۆ نەکڕیم،","poem":1},{"text":"بە پیوی قوربانییە سەربڕدراوەکانت تێرت نەکردم،","poem":2},{"text":"بەڵکو بە گوناهەکانت بارگرانت کردم،","poem":1},{"text":"بە تاوانەکانت ماندووت کردم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«منم، منم کە یاخیبوونەکانت دەسڕمەوە،","poem":1},{"text":"لە پێناو خۆم،","poem":2},{"lineBreak":true},{"text":"گوناهەکانیشت بەبیری خۆم ناهێنمەوە.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"بەبیرم بخەرەوە،","poem":1},{"text":"با پێکەوە بکەوینە دادگاییکردن،","poem":2},{"lineBreak":true},{"text":"بە بەڵگە بێتاوانییەکەت بسەلمێنە.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"باوکی یەکەمت گوناهی کرد و","poem":1},{"text":"پەیوەندی ڕێکخەرانت لێم یاخی بوون.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"لەبەر ئەوە میرانی پیرۆزگا گڵاو دەکەم و","poem":1},{"text":"یاقوب دەدەمە قڕکردن","poem":2},{"noteId":65},{"text":"و","poem":2},{"lineBreak":true},{"text":"ئیسرائیلیش بۆ جنێوپێدان.","poem":2}]}],"footnotes":[{"noteId":65,"caller":"+","text":"قڕکردن: لە زمانی عیبری ئەم زاراوەیە دەگەڕێتەوە بۆ شتێک یان کەسێک کە دەبەخشرێت بە یەزدان، زۆر جار بەخشینەکە بە تەواوی لە ناودەبردرێت.‏","reference":{"chapter":43,"verse":28}}]},"thisChapterLink":"/api/ckb_bib/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}