{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["ئیسرائیلی هەڵبژێردراو"]},{"type":"verse","number":1,"content":[{"text":"«ئێستا یاقوبی بەندەم،","poem":1},{"text":"ئیسرائیلی هەڵبژاردەم، گوێ بگرە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"دروستکەر، یارمەتیدەرت،","poem":1},{"text":"شێوەکێشت لە سکی دایکەوە،","poem":2},{"lineBreak":true},{"text":"یەزدان ئەمە دەفەرموێت:","poem":2},{"text":"مەترسە یاقوبی بەندەم،","poem":1},{"text":"یەشوروونی","poem":2},{"noteId":66},{"text":"هەڵبژاردەم،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"چونکە ئاو بەسەر خاکە تینووەکەدا دەڕێژم و","poem":1},{"text":"لافاو بەسەر زەوییە وشکەکەدا،","poem":2},{"text":"ڕۆحی خۆم بەسەر نەوەکانتدا دەڕێژم و","poem":1},{"text":"بەرەکەتم بەسەر توخمت.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"جا لەنێو سەوزەگیا سەرهەڵدەدەن","poem":1},{"text":"وەک شۆڕەبی ڕۆخ جۆگەکان.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەمەیان دەڵێت: ”من سەر بە یەزدانم،“","poem":1},{"text":"ئەویان بە ناوی یاقوب بانگ دەکرێت،","poem":2},{"text":"ئەمیان لەسەر دەستی دەنووسێت: ”بۆ یەزدانە“ و","poem":1},{"text":"بە ناوی ئیسرائیلەوە نازناوی لێ دەنرێت.","poem":2}]},{"type":"heading","content":["یەزدان، نەک بت"]},{"type":"verse","number":6,"content":[{"text":"«یەزدان، پاشای ئیسرائیل و ئەوەی دەیکڕێتەوە،","poem":1},{"text":"یەزدانی سوپاسالار، ئەمە دەفەرموێت:","poem":2},{"text":"من سەرەتا و من کۆتاییم،","poem":1},{"text":"لە من بەولاوە هیچ خودایەک نییە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"کێ وەک منە؟ با بانگەواز بکات،","poem":1},{"text":"با ڕایبگەیەنێت و بیخاتە بەردەمم","poem":2},{"text":"لەو کاتەوەی گەلی دێرینم داناوە و","poem":1},{"text":"داهاتووەکان و ئەوەی لەگەڵ خۆی دەیهێنێت،","poem":2},{"lineBreak":true},{"text":"با پێیان ڕابگەیەنن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"مەتۆقن و مەترسن.","poem":1},{"text":"ئەی لە کۆنەوە پێم نەگوتوویت و پێم ڕانەگەیاندوویت؟","poem":2},{"text":"ئێوە شایەتی منن، ئایا لە من بەولاوە خودای دیکە هەیە؟","poem":1},{"text":"نەخێر، هیچ تاشەبەردێکی دیکە نییە؛ هیچی دیکە ناناسم.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"شێوەکێشەکانی بت هەموو پووچن،","poem":1},{"text":"شتە ئارەزوو بەخشەکانیان بێ سوودن.","poem":2},{"text":"شایەتیدەری خۆیانن کە نابینن و","poem":1},{"text":"نازانن، لەبەر ئەوە شەرمەزار دەبن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"کێ شێوەی خودایەکی کێشاوە","poem":1},{"text":"یان بتێکی داڕشتووە بەبێ سوود؟","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەوەتا هەموو هاوڕێیەکانی شەرمەزار دەبن.","poem":1},{"text":"وەستاکانی لە مرۆڤن،","poem":2},{"text":"هەموو کۆدەبنەوە و ڕادەوەستن،","poem":1},{"text":"پێکەوە دەتۆقن و شەرمەزار دەبن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ئاسنگەر بە ئامێرەکانی","poem":1},{"text":"پارچە ئاسن لەناو خەڵووز سوور دەکاتەوە.","poem":2},{"text":"بە چەکوش شێوەی دەکات،","poem":1},{"text":"بە هێزی بازووی دروستی دەکات.","poem":2},{"text":"برسی دەبێت هێزی نییە،","poem":1},{"text":"ئاوی نەخواردووەتەوە و ماندوو بوو.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"دارتاش گوریسی پێوانەی ڕاکێشا،","poem":1},{"text":"نیشانی کرد بە نیشانکەر،","poem":2},{"text":"بە ئەسکەنە دروستی دەکات.","poem":1},{"text":"بە پرگال وێنەی دەکێشێت،","poem":2},{"text":"جا وەک شێوەی پیاو دروستی دەکات،","poem":1},{"text":"وەک جوانی مرۆڤ","poem":2},{"lineBreak":true},{"text":"بۆ ئەوەی لە نزرگە جێگیر بێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"دار ئورزی بۆ خۆی بڕییەوە،","poem":1},{"text":"یان داری سەروو یاخود داری بەڕووی برد،","poem":2},{"text":"بەجێی هێشت کە لەنێو دارەکانی دارستان گەشە بکات،","poem":1},{"text":"یاخود دار سنەوبەرێکی ڕواند و باران گەورەی کرد.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"جا بۆ مرۆڤ دەبێت بۆ سووتاندن،","poem":1},{"text":"لێی دەبات و گەرم دەبێتەوە،","poem":2},{"lineBreak":true},{"text":"دایدەگیرسێنێت و نانی پێ دەبرژێنێت.","poem":2},{"text":"بەڵام خوداوەندێکیش دروستدەکات و کڕنۆشی بۆ دەبات،","poem":1},{"text":"دەیکات بە پەیکەر و ڕوو لە زەوی دەکات بۆی.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"نیوەی بە ئاگر دەسووتێنێت،","poem":1},{"text":"لەسەر نیوەی خواردن ئامادە دەکات،","poem":2},{"lineBreak":true},{"text":"گۆشت دەبرژێنێت و تێردەبێت.","poem":2},{"text":"هەروەها گەرم دەبێتەوە و دەڵێت: «ئەها!","poem":1},{"text":"گەرم بوومەوە، ئاگرم بینی.»","poem":2}]},{"type":"verse","number":17,"content":[{"text":"پاشماوەکەشی خوداوەندێکی لێ دروستکرد، بتە داتاشراوەکەی،","poem":1},{"text":"ڕوو لە زەوی دەکات بۆی و کڕنۆشی بۆ دەبات.","poem":2},{"text":"نوێژی بۆ دەکات و دەڵێت:","poem":1},{"text":"«ڕزگارم بکە، چونکە تۆ خودای منی.»","poem":2}]},{"type":"verse","number":18,"content":[{"text":"نازانن و تێناگەن،","poem":1},{"text":"چونکە چاوەکانیان داخراوە لە بینین و","poem":2},{"lineBreak":true},{"text":"مێشکیان لە تێگەیشتن.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"لە دڵی خۆیدا بیری لێ ناکاتەوە و","poem":1},{"text":"زانین و تێگەیشتنی نییە","poem":2},{"text":"هەتا بڵێت: «بە نیوەی ئاگرم خۆشکرد،","poem":1},{"text":"بە پشکۆیەکەشی نان و گۆشتم برژاند و خواردم.","poem":2},{"text":"ئەو کاتە پاشماوەکەی بکەم بە قێزەون،","poem":1},{"text":"بۆ قەدی دارێک ڕوو لە زەوی بکەم؟»","poem":2}]},{"type":"verse","number":20,"content":[{"text":"لەسەر خۆڵەمێش دەلەوەڕێت، دڵی هەڵخەڵەتا و چەواشەی کرد.","poem":1},{"text":"گیانی خۆی ڕزگار ناکات،","poem":2},{"lineBreak":true},{"text":"ناڵێت: «ئایا ئەمە درۆ نییە لەنێو دەستی ڕاستم؟»","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«ئەمەت لەبیر بێت، ئەی یاقوب،","poem":1},{"text":"ئەی ئیسرائیل، چونکە تۆ بەندەی منیت،","poem":2},{"text":"شێوەی تۆم کێشا، تۆ بەندەی منیت.","poem":1},{"text":"ئەی ئیسرائیل، لەبیرم ناچیت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"یاخیبوونەکانی تۆم وەک هەوری تار سڕییەوە،","poem":1},{"text":"گوناهەکانیشت وەک تەمی بەیانییان.","poem":2},{"text":"بگەڕێوە بۆ لام،","poem":1},{"text":"چونکە تۆم کڕییەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ئەی ئاسمان، هاواری خۆشی بکە، چونکە یەزدان ئەمەی کرد؛","poem":1},{"text":"ئەی ناخی زەوی، هاوار بکەن!","poem":2},{"text":"هاواری خۆشی بکەن، ئەی چیاکان،","poem":1},{"text":"ئەی دارستان و هەموو دارێک کە تێیدایە،","poem":2},{"text":"چونکە یەزدان یاقوبی کڕییەوە و","poem":1},{"text":"لە ئیسرائیل شکۆدارە.","poem":2}]},{"type":"heading","content":["ئاوەدانی ئۆرشەلیم"]},{"type":"verse","number":24,"content":[{"text":"«یەزدان، ئەوەی دەتکڕێتەوە، شێوەکێشت لە سکی دایکەوە،","poem":1},{"text":"ئەمە دەفەرموێت:","poem":2},{"lineBreak":true},{"text":"«من یەزدانم،","poem":1},{"lineBreak":true},{"text":"دروستکەری هەموو،","poem":1},{"lineBreak":true},{"text":"بە تەنها ئاسمانم لێککردەوە،","poem":1},{"lineBreak":true},{"text":"زەویم ڕاخست، کەسم لەگەڵ نەبوو،","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"نیشانەی پێغەمبەرانی درۆزنم پوکاندەوە،","poem":1},{"text":"فاڵگرەوەم گێل کرد.","poem":2},{"text":"دانام گەڕاندەوە دواوە،","poem":1},{"text":"زانینەکەی ئەوانم کردە نەزانی.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"وشەی خزمەتکارەکەی بەجێدەهێنێت،","poem":1},{"text":"پلانی نێردراوەکانی تەواو دەکات،","poem":2},{"text":"سەبارەت بە ئۆرشەلیم دەڵێت: ”ئاوەدان دەبێتەوە،“","poem":1},{"text":"بە شارۆچکەکانی یەهوداش: ”بنیاد دەنرێنەوە،“","poem":2},{"lineBreak":true},{"text":"سەبارەت بە کەلاوەکانیش: ”نۆژەنیان دەکەمەوە،“","poem":2}]},{"type":"verse","number":27,"content":[{"text":"بە دەریا دەڵێت: ”وشک بە،","poem":1},{"text":"منیش ڕووبارەکانت وشک دەکەم،“","poem":2}]},{"type":"verse","number":28,"content":[{"text":"سەبارەت بە کۆرش","poem":1},{"noteId":67},{"text":"دەڵێت: ”ئەو شوانی منە،","poem":1},{"text":"هەموو ئەوەی دڵم پێی خۆشە دەیهێنێتە دی.","poem":2},{"text":"سەبارەت بە ئۆرشەلیمیش دەڵێت: ’با بنیاد بنرێتەوە،‘","poem":1},{"text":"بە پەرستگاش دەڵێت: ’با دابمەزرێتەوە.‘ “»","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":66,"caller":"+","text":"یەشوروون: وشەیەکی عیبرییە بە واتای سەرڕاست یان دادپەروەر، لێرە مەبەست لە گەلی ئیسرائیلە.‏","reference":{"chapter":44,"verse":2}},{"noteId":67,"caller":"+","text":"بڕوانە دووەم پوختەی مێژوو 36‏:22‏‏ و 23.‏","reference":{"chapter":44,"verse":28}}]},"thisChapterLink":"/api/ckb_bib/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}