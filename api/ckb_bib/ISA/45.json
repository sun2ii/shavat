text":"بە ناوی خۆت بانگت دەکەم و","poem":1},{"text":"نازناوی چاکم بە تۆ بەخشی","poem":2},{"lineBreak":true},{"text":"هەرچەندە تۆ دان بە مندا نانێیت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"من یەزدانم و یەکێکی دیکە نییە،","poem":1},{"text":"بێجگە لە من خودای دیکە نییە.","poem":2},{"lineBreak":true},{"text":"هەرچەندە دانت بە مندا نەناوە،","poem":2},{"lineBreak":true},{"text":"بەڵام من کەمەربەندی تۆ توند دەکەم،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بۆ ئەوەی لە ڕۆژهەڵاتەوە هەتا ڕۆژئاوا بزانن","poem":1},{"text":"بێجگە لە من خودای دیکە نییە.","poem":2},{"text":"من یەزدانم و یەکێکی دیکە نییە.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"شێوەکێشی ڕووناکی و بەدیهێنەری تاریکیم،","poem":1},{"text":"دروستکەری ئاشتی و بەدیهێنەری خراپەم،","poem":2},{"noteId":68},{"lineBreak":true},{"text":"من یەزدانم دروستکەری هەموو ئەمانە.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ئەی ئاسمان لە سەرەوە، ڕاستودروستییەکەم ببارێنە،","poem":1},{"text":"با هەورەکان بیپرژێنێت.","poem":2},{"text":"با زەوی بکرێتەوە و پێکەوە","poem":1},{"text":"ڕزگاری بەر بگرێت و","poem":2},{"text":"ڕاستودروستی سەرهەڵبدات؛","poem":1},{"text":"من یەزدانم بەدیم هێنا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«قوڕبەسەر ئەوەی کێشە لەگەڵ شێوەکارەکەی دروستدەکات،","poem":1},{"text":"پارچەی گۆزەیەکە لەنێو گۆزەکانی سەر زەوی.","poem":2},{"text":"ئایا قوڕ بە گۆزەکەرەکەی دەڵێت:","poem":1},{"text":"”چی دروستدەکەیت؟“","poem":2},{"text":"یان دەڵێت:","poem":1},{"text":"”ئەوەی دروستت کردووە دوو دەسکی نییە“؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"قوڕبەسەر ئەوەی بە باوکی دەڵێت:","poem":1},{"text":"”چ منداڵێکت خستەوە؟“","poem":2},{"lineBreak":true},{"text":"بە دایکەکەشی: ”چیت لێ دەبێت؟“","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«یەزدان، پیرۆزەکەی ئیسرائیل و شێوەکێشەکەی،","poem":1},{"text":"ئەمە دەفەرموێت:","poem":2},{"text":"دەربارەی ئەوانەی دێت،","poem":1},{"text":"ئایا سەبارەت بە منداڵەکانم لێم دەپرسن،","poem":2},{"lineBreak":true},{"text":"سەبارەت بە کاری دەستم، ڕامدەسپێرن؟","poem":2}]},{"type":"verse","number":12,"content":[{"text":"من زەویم دروستکرد و","poem":1},{"text":"مرۆڤی سەریم بەدیهێنا.","poem":2},{"text":"دەستەکانی من ئاسمانی لێککردەوە و","poem":1},{"text":"هەموو هێزەکانی ئاسمانم پێکهێنا.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"من کۆرش بە ڕاستودروستی هەڵدەستێنم و","poem":1},{"text":"هەموو ڕێگاکانی ڕێک و ڕاست دەکەم.","poem":2},{"text":"ئەو شارەکەم بنیاد دەنێتەوە و","poem":1},{"text":"ڕاپێچکراوەکانم ئازاد دەکات","poem":2},{"text":"بەبێ پارە و بەبێ بەرتیل.","poem":1},{"text":"ئەمە فەرمایشتی یەزدانی سوپاسالارە.»","poem":2}]},{"type":"verse","number":14,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«بەرهەمی میسر و بازرگانی کوش و","poem":1},{"text":"سەبئییە باڵا بەرزەکان","poem":2},{"text":"بۆ لای ئێوە","poem":1},{"noteId":69},{"text":"دەپەڕنەوە و","poem":1},{"text":"بۆ ئێوە دەبن.","poem":2},{"text":"لەدوای ئێوەوە بە کۆت و زنجیرەوە دەڕۆن و","poem":1},{"text":"دەپەڕنەوە بۆ لاتان.","poem":2},{"text":"کڕنۆش بۆ ئێوە دەبەن و","poem":1},{"text":"لە ئێوە دەپاڕێنەوە و دەڵێن:","poem":2},{"text":"”بێگومان خودا لەنێو ئێوەدایە و یەکێکی دیکە نییە،","poem":1},{"text":"خودای دیکە نییە.“»","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"بەڕاستی تۆ خودایەکی خۆت دەشاریتەوە،","poem":1},{"text":"خودای ئیسرائیل، ئەی ڕزگارکەر.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"هەروەها هەموو وەستای پەیکەرەکان شەرمەزار و ڕیسوا دەبن،","poem":1},{"text":"پێکەوە بە سەرشۆڕییەوە دەڕۆن،","poem":2}]},{"type":"verse","number":17,"content":[{"text":"بەڵام ئیسرائیل بە یەزدان ڕزگاری دەبێت،","poem":1},{"text":"بە ڕزگارییەکی هەتاهەتایی.","poem":2},{"text":"شەرمەزار و ڕیسوا نابن","poem":1},{"text":"هەتاهەتایە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"یەزدان ئەمە دەفەرموێت،","poem":1},{"lineBreak":true},{"text":"ب