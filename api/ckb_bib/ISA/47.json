{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["کەوتنی بابل"]},{"type":"verse","number":1,"content":[{"text":"«دابەزە و لەسەر خۆڵ دابنیشە،","poem":1},{"text":"ئەی بابلی کچە پاکیزە","poem":2},{"noteId":71},{"text":".","poem":2},{"text":"بەبێ تەخت لەسەر زەوی دابنیشە،","poem":1},{"text":"کچی بابلییەکان،","poem":2},{"text":"چونکە چیتر پێت ناگوترێت","poem":1},{"text":"ناسک و نازدار.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"دەستاڕ ببە و باراش بهاڕە،","poem":1},{"text":"عەبات فڕێبدە،","poem":2},{"text":"دامێن هەڵبکە و قاچ بەدەرخە،","poem":1},{"text":"لە ڕووبارەکان بپەڕەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ڕووتیت دەردەکەوێت،","poem":1},{"text":"هەروەها ڕیسواییت دەبینرێت.","poem":2},{"text":"تۆڵەی خۆم دەکەمەوە و","poem":1},{"text":"لە کەس نابوورم.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ئەوەی دەمانکڕێتەوە ناوی یەزدانی سوپاسالارە،","poem":1},{"text":"پیرۆزەکەی ئیسرائیلە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«بێدەنگ دابنیشە و وەرە ناو تاریکییەوە،","poem":1},{"text":"شاری شاهانەی بابلییەکان،","poem":2},{"text":"چونکە چیتر پێت ناگوترێت","poem":1},{"text":"شاژنی شانشینەکان.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"تووڕە بووم لە گەلی خۆم و","poem":1},{"text":"میراتی خۆمم گڵاوکرد.","poem":2},{"text":"ئەوانم دا بە دەست تۆوە،","poem":1},{"text":"تۆش لەگەڵیاندا بە بەزەیی نەبوویت.","poem":2},{"text":"تەنانەت لەسەر پیرەکانیش","poem":1},{"text":"نیری","poem":2},{"noteId":72},{"text":"خۆتت زۆر قورس کرد.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"گوتت: ”بۆ هەتاهەتایە","poem":1},{"text":"دەبمە شاژن!“","poem":2},{"text":"بەڵام لەم ڕووداوانە وردنەبوویتەوە،","poem":1},{"text":"بیرت لە کۆتاییەکەی نەکردەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ئێستا گوێ لەمە بگرە، ئەی سۆزانی،","poem":1},{"text":"ئەی دانیشتوو بە ئاسوودەیی،","poem":2},{"text":"ئەی ئەوەی لە دڵی خۆیدا دەڵێت:","poem":1},{"text":"”هەر خۆم و بەس!","poem":2},{"text":"نە بێوەژن دەبم و","poem":1},{"text":"نە سک سووتاوی دەزانم.“","poem":2}]},{"type":"verse","number":9,"content":[{"text":"لەپڕ لە یەک ڕۆژدا","poem":1},{"text":"ئەم دووانەت بەسەردێت،","poem":2},{"lineBreak":true},{"text":"سک سووتان و بێوەژنیێتی.","poem":2},{"text":"بە تەواوی بەسەرت دێت،","poem":1},{"text":"سەرەڕای زۆری جادووگەری و","poem":2},{"lineBreak":true},{"text":"سەرەڕای لە ڕادەبەدەر نوشتەکردنت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"پشتت بە خراپەکارییەکانت بەست و","poem":1},{"text":"گوتت: ”کەس نامبینێت.“","poem":2},{"text":"داناییەکەت و زانینەکەت تۆیان لەڕێ لادا،","poem":1},{"text":"لە دڵی خۆتدا گوتت:","poem":2},{"lineBreak":true},{"text":"”هەر خۆم و بەس.“","poem":2}]},{"type":"verse","number":11,"content":[{"text":"خراپەیەکت بەسەردێت،","poem":1},{"text":"سەرهەڵدانەکەی نازانیت،","poem":2},{"text":"بەڵایەکت بەسەردێت.","poem":1},{"text":"ناتوانیت ڕەتی بکەیتەوە،","poem":2},{"text":"لەپڕ کاولبوونێکت بەسەردێت","poem":1},{"text":"پێی نازانیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«جا بەردەوام بە، بە نوشتەکانت و","poem":1},{"text":"بە زۆری جادووگەریت،","poem":2},{"lineBreak":true},{"text":"ئەوەی لە مێردمنداڵیتەوە تێیدا ماندوو بوویت،","poem":2},{"text":"بەڵکو سوودی هەبێ بۆت،","poem":1},{"text":"بۆ ئەوەی بیانترسێنیت!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"هێزت لەبەر بڕا لە زۆری ڕاوێژەکانت!","poem":1},{"text":"با ئەستێرەناسەکانت بێنە پێشەوە،","poem":2},{"text":"ئەوانەی ئاسمان دابەش دەکەن و","poem":1},{"text":"چاو لە ئەستێرەکان دەبڕن و","poem":2},{"text":"مانگ لەدوای مانگ پێشبینی دەکەن،","poem":1},{"lineBreak":true},{"text":"با ئەوانە ڕزگارت بکەن","poem":1},{"text":"لەوەی بەسەرت دێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەوەتا وەک پووشیان لێدێت،","poem":1},{"text":"ئاگر دەیانسووتێنێت.","poem":2},{"text":"لە دەست بڵێسە","poem":1},{"text":"فریای گیانی خۆیان ناکەون.","poem":2},{"text":"ئەو پشکۆ خەڵووزە بۆ خۆگەرمکردنەوە نییە،","poem":1},{"text":"ئەو ئاگرەش بۆ دانیشتن لەبەردەمی نییە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەو جادووگەرانەی لە مێردمنداڵیتەوە هەڵسوکەوتت لەگەڵدا دەکردن و","poem":1},{"text":"پێیانەوە ماندوو بوویت،","poem":2},{"lineBreak":true},{"text":"بەو دەردە دەچن.","poem":2},{"text":"هەرکەسە و ملی ڕێی خۆی دەگرێت،","poem":1},{"text":"کەس نییە ڕزگارت بکات.","poem":2}]}],"footnotes":[{"noteId":71,"caller":"+","text":"پاکیزە: مەبەست لەپێش داگیرکردنیەتی، کە بەراوردی دەکات بە کچی پاکیزە.‏","reference":{"chapter":47,"verse":1}},{"noteId":72,"caller":"+","text":"مەبەستی لە بارگرانییە.‏","reference":{"chapter":47,"verse":6}}]},"thisChapterLink":"/api/ckb_bib/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}