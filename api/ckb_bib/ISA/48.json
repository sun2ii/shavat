{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["کەللەڕەقیی ئیسرائیل"]},{"type":"verse","number":1,"content":[{"text":"«گوێ لەمە بگرن، ئەی بنەماڵەی یاقوب،","poem":1},{"text":"ئێوە پێتان دەگوترێت ئیسرائیل،","poem":2},{"lineBreak":true},{"text":"ئێوە لە پشتی یەهوداوە دەرچوون،","poem":2},{"text":"ئێوە بە ناوی یەزدانەوە سوێند دەخۆن،","poem":1},{"text":"ناوی خودای ئیسرائیل دەهێنن،","poem":2},{"lineBreak":true},{"text":"بەڵام نەک بە دڵسۆزی و نەک بە ڕاستودروستی،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بە خۆتان دەڵێن، خەڵکی شاری پیرۆز و","poem":1},{"text":"خۆتان دەدەنە پاڵ خودای ئیسرائیل","poem":2},{"lineBreak":true},{"text":"کە ناوی یەزدانی سوپاسالارە:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"سەرەتاکانم لە کۆنەوە ڕاگەیاندووە،","poem":1},{"text":"لە دەمی منەوە هاتوونەتە دەرەوە و وام کرد ببیسترێن،","poem":2},{"lineBreak":true},{"text":"لەپڕ کردم و ڕوویان دا.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"دەمزانی ئێوە کەللەڕەقن و","poem":1},{"text":"ملتان دەماری ئاسنینە و","poem":2},{"lineBreak":true},{"text":"ناوچەوانتان بڕۆنزە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لەبەر ئەوە لە کۆنەوە ئەمانەم پێ ڕاگەیاندن،","poem":1},{"text":"وام کرد پێش ئەوەی ڕووبدەن ئێوە گوێتان لێی بێت،","poem":2},{"text":"نەوەک بڵێن: ”بتەکەم کردی،","poem":1},{"text":"خوداوەندە دەستکردەکەم فەرمانی دا.“","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئێوە گوێتان لێ بوو، جا بڕواننە هەمووی.","poem":1},{"text":"ئەی ئێوە دانی پێدا نانێن؟","poem":2},{"lineBreak":true},{"text":"«وا دەکەم لە ئێستاوە گوێتان لە شتە نوێیەکان بێت،","poem":1},{"text":"ئەو نهێنییانەی کە نایانزانن.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئێستا بەدیهێنران، لە کۆنەوە نەبوون،","poem":1},{"text":"بەر لە ئەمڕۆ نەتانبیستبوون","poem":2},{"text":"نەوەک بڵێن،","poem":1},{"text":"”ئەوەتا دەمانزانی.“","poem":2}]},{"type":"verse","number":8,"content":[{"text":"هەروەها نە گوێتان لێ بوو نە زانیشتان،","poem":1},{"text":"لە کۆنەوەش گوێت نەکردەوە.","poem":2},{"text":"باش دەزانم چۆن بە تەواوی ناپاکی دەکەن،","poem":1},{"text":"لەناو سکی دایکتانەوە پێتان گوترا: ”یاخی.“","poem":2}]},{"type":"verse","number":9,"content":[{"text":"لە پێناوی ناوی خۆم تووڕەییەکەم دوا دەخەم،","poem":1},{"text":"لە پێناوی ستایشم دانبەخۆمدا دەگرم،","poem":2},{"lineBreak":true},{"text":"نەوەک بتانبڕمەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەوەتا ئێوەم پاڵاوت، بەڵام نەک وەکو زیو،","poem":1},{"text":"لەناو کوورەی ئازارچێژتن تاقیم کردنەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لە پێناوی خۆم، لە پێناوی خۆم دەیکەم،","poem":1},{"text":"چۆن ڕێگا دەدەم ناوی من گڵاو بکرێت؟","poem":2},{"lineBreak":true},{"text":"شکۆمەندیم بە یەکێکی دیکە نادەم.","poem":2}]},{"type":"heading","content":["دەربازکردنی ئیسرائیل"]},{"type":"verse","number":12,"content":[{"text":"«ئەی یاقوب، گوێم لێ بگرن،","poem":1},{"text":"ئەی ئیسرائیل، ئەوانەی کە بانگم کردن.","poem":2},{"text":"ئەوە منم،","poem":1},{"text":"من سەرەتا و من کۆتاییم.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"دەستی من زەوی دامەزراند،","poem":1},{"text":"دەستی ڕاستم ئاسمانی لێککردەوە.","poem":2},{"text":"کاتێک من بانگیان دەکەم،","poem":1},{"text":"پێکەوە دەوەستن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«هەمووتان کۆبنەوە و گوێ بگرن!","poem":1},{"text":"کام لە بتەکان ئەمەی ڕاگەیاندووە؟","poem":2},{"text":"هاوپەیمانی خۆشەویستی یەزدان،","poem":1},{"noteId":73},{"text":"هەرچی پێ خۆش بێت بە بابلی دەکات،","poem":2},{"lineBreak":true},{"text":"بازووشی لە دژی بابلییەکان دەبێت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"من، من قسەم کرد و بانگم کرد،","poem":1},{"text":"هێنام و ڕێگاکەشی سەرکەوتوو دەبێت.","poem":2}]},{"type":"verse","number":16,"content":["«وەرنە پێش بۆ لام، گوێ لەمە بگرن:",{"text":"«لە سەرەتاوە بە نهێنی قسەم نەکرد،","poem":1},{"text":"کاتێک ڕوودەدات، من لەوێم.»","poem":2},{"lineBreak":true},{"text":"ئێستاش یەزدانی باڵادەست منی نارد","poem":1},{"text":"لەگەڵ ڕۆحی خۆی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"یەزدان، ئەوەی دەتانکڕێتەوە، پیرۆزەکەی ئیسرائیل،","poem":1},{"text":"ئەمە دەفەرموێت:","poem":2},{"text":"«من یەزدانی پەروەردگارتانم،","poem":1},{"text":"فێرتان دەکەم بۆ ئەوەی سوود وەربگرن،","poem":2},{"lineBreak":true},{"text":"بەو ڕێگایەدا دەتانبەم کە دەبێت بیگرنەبەر.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"خۆزگە گوێتان لە فەرمانەکانم دەگرت،","poem":1},{"text":"جا ئاشتیتان وەک ڕووبار دەبوو،","poem":2},{"lineBreak":true},{"text":"ڕاستودروستیشتان وەک شەپۆلی دەریا.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"نەوەکانتان وەک لم دەبوو،","poem":1},{"text":"وەچەتان وەک دەنکی لم،","poem":2},{"text":"ناویان لەبەردەمم نە دەبڕایەوە و","poem":1},{"text":"نە لەناودەچوو.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"لە بابل بچنە دەرەوە،","poem":1},{"text":"لە بابلییەکان هەڵبێن!","poem":2},{"text":"بە هاواری خۆشییەوە ڕایبگەیەنن،","poem":1},{"text":"جاڕی ئەمە بدەن.","poem":2},{"text":"سەرتاسەری زەوی لێ ئاگادار بکەنەوە،","poem":1},{"text":"بڵێن: «یەزدان یاقوبی بەندەی کڕییەوە.»","poem":2}]},{"type":"verse","number":21,"content":[{"text":"تینوو نەبوون کە بە چۆڵەوانیدا بردنی،","poem":1},{"text":"لە تاشەبەردەوە ئاوی بۆ هەڵقوڵاندن،","poem":2},{"text":"تاشەبەردی شەقکرد و","poem":1},{"text":"ئاو تەقییەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"یەزدان دەفەرموێت: «ئاشتی بۆ بەدکاران نییە.»","poem":1}]}],"footnotes":[{"noteId":73,"caller":"+","text":"مەبەست لە کۆرشی پاشایە.‏","reference":{"chapter":48,"verse":14}}]},"thisChapterLink":"/api/ckb_bib/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}