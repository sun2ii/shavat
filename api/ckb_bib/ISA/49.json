{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["بەندەی یەزدان"]},{"type":"verse","number":1,"content":[{"text":"ئەی دوورگەکان، گوێم لێ بگرن،","poem":1},{"text":"ئەی نەتەوە دوورەکان، گوێ شل بکەن:","poem":2},{"text":"یەزدان پێش لەدایکبوونم بانگی کردم،","poem":1},{"text":"لەناو سکی دایکمەوە دیاری کردم.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"دەمی منی کرد بە شمشێرێکی تیژ،","poem":1},{"text":"لە سێبەری دەستی خۆیدا منی شاردەوە،","poem":2},{"text":"منی کردە تیرێکی تیژکراو،","poem":1},{"text":"لەناو تیردانەکەی منی شاردەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بە منی فەرموو: «تۆ بەندەی منیت،","poem":1},{"text":"ئیسرائیل، ئەوەی بەهۆیەوە شکۆی خۆم دەردەخەم.»","poem":2}]},{"type":"verse","number":4,"content":[{"text":"منیش گوتم: «بەخۆڕایی ماندوو بووم،","poem":1},{"text":"لە شتی هیچوپووچدا توانای خۆمم نەهێشت،","poem":2},{"text":"بەڵام دادم لەلای یەزدانە و","poem":1},{"text":"پاداشتم لای خودامە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ئێستاش یەزدان ئەمە دەفەرموێت،","poem":1},{"text":"یەزدان کە لە سکی دایکمەوە شێوەی منی کێشا،","poem":2},{"text":"بۆ ئەوەی ببم بە بەندەی خۆی،","poem":1},{"text":"تاوەکو یاقوب بۆ لای ئەو بگەڕێنمەوە و","poem":2},{"lineBreak":true},{"text":"ئیسرائیلیش بخەمەوە پاڵ ئەو،","poem":2},{"text":"جا لەبەرچاوی یەزدان شکۆمەند دەبم و","poem":1},{"text":"خوداشم دەبێتە هێزم،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەو دەفەرموێت:","poem":1},{"lineBreak":true},{"text":"«ئەمە شتێکی کەمە بۆ تۆ کە بەندەی من بیت","poem":1},{"text":"بۆ هەستانەوەی هۆزەکانی یاقوب و","poem":2},{"lineBreak":true},{"text":"بۆ گەڕانەوەی ئەوانەی کە لە ئیسرائیل ئەوانم پاراست،","poem":2},{"text":"بەڵکو دەتکەمە ڕووناکی بۆ نەتەوەکان","poem":1},{"text":"تاکو ڕزگاریم بەوپەڕی زەوی بگەیەنیت","poem":2},{"noteId":74},{"text":".»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"یەزدان، پیرۆزەکەی ئیسرائیل، ئەوەی دەیکڕێتەوە، دەفەرموێت:","poem":1},{"text":"بە گیان ڕیسواکراو، بەوەی مایەی ڕقی نەتەوەیە،","poem":2},{"text":"بە خزمەتکاری فەرمانڕەواکان:","poem":1},{"text":"«پاشایان دەبینن و هەڵدەستن،","poem":2},{"text":"میرانیش کڕنۆش دەبەن،","poem":1},{"text":"لەبەر یەزدان کە دڵسۆزە و","poem":2},{"lineBreak":true},{"text":"لەبەر پیرۆزەکەی ئیسرائیل کە تۆی هەڵبژارد.»","poem":2}]},{"type":"heading","content":["گەڕانەوەی ئیسرائیل"]},{"type":"verse","number":8,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«لە کاتی پەسەندیم وەڵامت دەدەمەوە،","poem":1},{"text":"لە ڕۆژی ڕزگاریدا یارمەتیت دەدەم،","poem":2},{"text":"جا دەتپارێزم و دەتکەمە پەیمان بۆ گەل،","poem":1},{"text":"بۆ بوژاندنەوەی زەوی،","poem":2},{"lineBreak":true},{"text":"بۆ بەمیراتکردنی میراتی چیاوچۆڵەکان،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بە دیلەکان دەڵێت: ”وەرنە دەرەوە،“","poem":1},{"text":"بەوانەی لە تاریکیدان: ”ئازاد بن!“","poem":2},{"lineBreak":true},{"text":"«لەسەر ڕێگاکان دەلەوەڕێن،","poem":1},{"text":"لەوەڕگاکانیان لەسەر هەموو گردۆڵکەیەکی ڕووتەنن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"نە برسی دەبن و نە تینوو،","poem":1},{"text":"نە گەرما لێیان دەدات و نە خۆر،","poem":2},{"text":"چونکە ئەوەی بەزەیی پێیاندا دێتەوە، ڕێنماییان دەکات و","poem":1},{"text":"بۆ سەر کانیاوەکانیان دەبات.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"هەموو چیاکانم دەکەم بە ڕێگا و","poem":1},{"text":"ڕێڕەوەکانم بەرز دەبنەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەوەتا ئەمانە لە دوورەوە دێن و","poem":1},{"text":"ئەوەتا ئەمانە لە باکوور و ڕۆژئاواوە و","poem":2},{"lineBreak":true},{"text":"ئەمانەش لە ناوچەی ئەسوانەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ئەی ئاسمان، هاواری خۆشی بکە،","poem":1},{"text":"ئەی زەوی، شادمان بە!","poem":2},{"lineBreak":true},{"text":"چیاکان دەکەونە ناو هاواری خۆشییەوە،","poem":2},{"text":"چونکە یەزدان دڵنەوایی گەلی خۆی دەکات و","poem":1},{"text":"بەزەیی بە زەلیلەکانیدا دێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"بەڵام سییۆن گوتی: «یەزدان بەجێی هێشتم!","poem":1},{"text":"پەروەردگار لەبیری کردم.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«چۆن دایک کۆرپەی شیرەخۆرەی خۆی لەبیر دەکات،","poem":1},{"text":"یان بەزەیی بە بەری سکی خۆی نایەتەوە؟","poem":2},{"text":"تەنانەت ئەویش لەبیر دەکات،","poem":1},{"text":"بەڵام من تۆ لەبیر ناکەم.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئەوەتا لەناو لەپم تۆم هەڵکۆڵیوە،","poem":1},{"text":"هەمیشە شووراکانت لەبەرچاومن.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"کوڕەکانت خێرا دەگەڕێنەوە،","poem":1},{"text":"ڕووخێنەران و تێکدەرانت لێت دەچنە دەرەوە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"چاوهەڵبڕە بۆ دەوروبەرت و ببینە!","poem":1},{"text":"هەموو کۆبوونەوە، هاتن بۆ لات.»","poem":2},{"text":"یەزدان دەفەرموێت: «بە گیانی خۆم،","poem":1},{"text":"تۆ هەموویان وەک خشڵ لەبەر دەکەیت،","poem":2},{"lineBreak":true},{"text":"وەک بووک خۆت بەوان دەڕازێنیتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«هەرچەندە بوویت بە شوێنێکی کەلاوە و وێران و","poem":1},{"text":"خاکەکەشت ڕووخێنرا،","poem":2},{"text":"بەڵام ئێستا تەنگ دەبیت بۆ دانیشتووان،","poem":1},{"text":"لووشدەرانت دوور دەکەونەوە.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ڕۆژێک لە ڕۆژان گوێت لێ دەبێت","poem":1},{"text":"کە کوڕانی سەردەمی سک سووتاویت دەڵێن:","poem":2},{"text":"”ئەم جێیە تەنگە بۆمان،","poem":1},{"text":"جێمان بکەرەوە با نیشتەجێ بین.“","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لە دڵی خۆتدا دەڵێیت:","poem":1},{"text":"”کێ ئەمانەی بۆ من بوو","poem":2},{"text":"کە من سک سووتاو و نەزۆکم،","poem":1},{"text":"دوورخراوە و دەربەدەرم؟","poem":2},{"lineBreak":true},{"text":"ئەی کێ بەخێوی کردن؟","poem":2},{"text":"ئەوەتا من بە تەنها مابوومەوە،","poem":1},{"text":"ئەمانە لەکوێ بوون؟“»","poem":2}]},{"type":"verse","number":22,"content":["یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«ئەوەتا من دەست بۆ نەتەوەکان بەرز دەکەمەوە،","poem":1},{"text":"بۆ گەلانیش ئاڵای خۆم بەرز دەکەمەوە،","poem":2},{"text":"جا کوڕەکانت بە باوەش دەهێنن و","poem":1},{"text":"کچەکانیشت لەسەر شانیان هەڵدەگرن.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"پاشاکان تۆ پەروەردە دەکەن،","poem":1},{"text":"شاژنەکانیان دەبنە دایەنی تۆ،","poem":2},{"text":"ڕوویان لە زەوی دەبێت،","poem":1},{"text":"کڕنۆشت بۆ دەبەن و تۆزی پێیەکانت دەلێسنەوە،","poem":2},{"text":"ئیتر تۆ دەزانیت کە من یەزدانم.","poem":1},{"text":"ئەوانەی شەرمەزار نابن ئەوانەن چاوەڕوانی منن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ئایا دەستکەوت لە پاڵەوان دەبردرێت؟","poem":1},{"text":"ئایا ڕاپێچکراو لە دەستی ستەمکار دەربازی دەبێت؟","poem":2}]},{"type":"verse","number":25,"content":["بەڵام یەزدان ئەمە دەفەرموێت:",{"text":"«تەنانەت ڕاپێچ لە چنگی پاڵەوانیش دەبردرێت،","poem":1},{"text":"دەستکەوت لە چنگی زۆرداریش دەرباز دەبێت.","poem":2},{"text":"من دژایەتی دژەکانت دەکەم و","poem":1},{"text":"من منداڵەکانت ڕزگار دەکەم.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"وا دەکەم ستەمکارانت گۆشتی خۆیان بخۆن و","poem":1},{"text":"وەک شەرابی شیرین، بە خوێنی خۆیان سەرخۆش بن.","poem":2},{"text":"جا هەموو مرۆڤ دەزانێت","poem":1},{"text":"من کە یەزدانم ڕزگارکەری تۆم،","poem":2},{"lineBreak":true},{"text":"ئەوەش کە دەتکڕێتەوە توانادارەکەی یاقوبە.»","poem":2}]}],"footnotes":[{"noteId":74,"caller":"+","text":"بڕوانە لۆقا 2‏:29‏-32.‏‏","reference":{"chapter":49,"verse":6}}]},"thisChapterLink":"/api/ckb_bib/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}