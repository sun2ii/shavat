{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["گۆرانی ڕەزەمێوەکە"]},{"type":"verse","number":1,"content":[{"text":"با گۆرانی بڵێم بۆ خۆشەویستەکەم،","poem":1},{"text":"گۆرانی خۆشەویستەکەم بۆ ڕەزەمێوەکەی:","poem":2},{"text":"خۆشەویستەکەم ڕەزەمێوێکی هەبوو","poem":1},{"text":"لەسەر گردێکی بەپیت.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بنکۆڵی کرد و بەردی لێ بژار کرد،","poem":1},{"text":"شامێویشی لێ چاند.","poem":2},{"text":"قوللەیەکی چاودێری لە ناوەڕاست بنیاد نا،","poem":1},{"text":"هەروەها گوشەرێکی تێدا هەڵکۆڵی.","poem":2},{"text":"بە هیوا بوو ترێی باش بگرێت،","poem":1},{"text":"بەڵام ترێی خراپی گرت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«ئێستا ئەی دانیشتووانی ئۆرشەلیم و ئەی پیاوانی یەهودا،","poem":1},{"text":"تکایە لەنێوان من و ڕەزەمێوەکەم دادوەری بکەن.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"چی دی هەیە بۆ ڕەزەمێوەکەم بکرێت کە","poem":1},{"text":"من نەمکردبێت؟","poem":2},{"text":"کاتێک من هیوادار بووم ترێی باش بگرێت،","poem":1},{"text":"بۆچی ترێی خراپی گرت؟","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئێستا پێتان دەڵێم","poem":1},{"text":"چی لە ڕەزەمێوەکەم دەکەم:","poem":2},{"text":"پەرژینەکەی لێ دەکەمەوە و","poem":1},{"text":"وێران دەبێت،","poem":2},{"text":"دیوارەکەی دەڕووخێنم،","poem":1},{"text":"دەبێتە پێپەست.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"دەیکەمە کەلاوە،","poem":1},{"text":"نە پەرچ دەکرێت و نە ژێری هەڵدەدرێتەوە،","poem":2},{"text":"دڕکوداڵ سەرهەڵدەدات.","poem":1},{"text":"فەرمان بە هەورەکان دەکەم","poem":2},{"text":"باران بەسەریدا نەبارێنن.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ڕەزەمێوی یەزدانی سوپاسالار","poem":1},{"text":"بنەماڵەی ئیسرائیلە و","poem":2},{"text":"پیاوانی یەهوداش","poem":1},{"text":"نەمامی شادی ئەون.","poem":2},{"text":"بە هیوای دادوەری بوو، بەڵام ئەوەتا خوێنڕژانە؛","poem":1},{"text":"بە هیوای ڕاستودروستی بوو، بەڵام ئەوەتا داد و بێدادە.","poem":2}]},{"type":"heading","content":["دادوەری یەزدانی سوپاسالار"]},{"type":"verse","number":8,"content":[{"text":"قوڕبەسەر ئەوانەی خانوو بە خانووەوە دەلکێنن و","poem":1},{"text":"کێڵگە لە کێڵگە نزیک دەکەنەوە","poem":2},{"text":"هەتا هیچ جێیەک نەما و","poem":1},{"text":"بە تەنها خۆتان لە خاکەکە نیشتەجێ بوون.","poem":2}]},{"type":"verse","number":9,"content":["بە ڕاستی گوێم لێ بوو کە یەزدانی سوپاسالار فەرمووی:",{"text":"«بێگومان کۆشکی مەزن دەبێتە کەلاوە،","poem":1},{"text":"خانووی گەورە و خۆشیش چوڵەوانی.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"جێی دە دۆنم ڕەزەمێو، یەک بەت","poem":1},{"noteId":5},{"text":"شەراب بەرهەم دەهێنێت و","poem":1},{"text":"حۆمەرێک","poem":2},{"noteId":6},{"text":"تۆویش ئێفەیەک","poem":2},{"noteId":7},{"text":"بەرهەم دەهێنێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"قوڕبەسەر ئەوانەی بەیانییان زوو هەڵدەستن","poem":1},{"text":"بەدوای شەراب دەکەون،","poem":2},{"text":"لە زەردەپەڕی ئێواران دوا دەکەون","poem":1},{"text":"مەی گڕی تێبەرداون.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"قیسارە و ساز، دەف و شمشاڵ و","poem":1},{"text":"شەراب بووە بە خەو و خۆراکیان،","poem":2},{"text":"بەڵام ئاوڕ لە کاری یەزدان نادەنەوە،","poem":1},{"text":"دەستکردەکانی نابینن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لەبەر ئەوە گەلەکەم لەبەر نەزانی ڕاپێچ دەکرێن،","poem":1},{"text":"سەنگینەکانی لە برسان دەمرن،","poem":2},{"lineBreak":true},{"text":"سادە و ساکارەکانی لە تینووان وشک دەبن.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"لەبەر ئەوە جیهانی مردووان خۆی پانوپۆڕ کرد و","poem":1},{"text":"بێ ئەندازە دەمی خۆی کردەوە،","poem":2},{"text":"تاکو بەگزادە و ڕەشۆکی و شەڕانگێزان،","poem":1},{"text":"لەگەڵ هەموو ئەوانەش کە شانازی بە ئۆرشەلیم دەکەن، شۆڕ ببنەوە ناوی.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"مرۆڤ دەچەمێتەوە و","poem":1},{"text":"پیاو نزم دەبێت،","poem":2},{"lineBreak":true},{"text":"چاوی بەفیزان نزم دەبێت،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بەڵام یەزدانی سوپاسالار بە دادوەری بە گەورە دەزانرێت،","poem":1},{"text":"خودای پیرۆز بە ڕاستودروستییەکەی دەردەکەوێت کە پیرۆزە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"مەڕەکان دەلەوەڕێن وەک لە لەوەڕگای خۆیان،","poem":1},{"text":"بەرخەکانیش لە کەلاوەی دەوڵەمەندەکان دەلەوەڕێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"قوڕبەسەر ئەوانەی بە گوریسی فێڵ تاوان کێش دەکەن،","poem":1},{"text":"گوناهیش وەک گوریسی عەرەبانە،","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەوانەی دەڵێن: «با خودا پەلە بکات،","poem":1},{"text":"با خێرا بێت لە کارەکەی","poem":2},{"lineBreak":true},{"text":"بۆ ئەوەی ببینین.","poem":2},{"text":"با نزیک بێتەوە و بێتە دی،","poem":1},{"text":"هەتا بزانین پلانی خودا پیرۆزەکەی ئیسرائیل.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"قوڕبەسەر ئەوانەی بە خراپ دەڵێن چاک و","poem":1},{"text":"بە چاکیش دەڵێن خراپ،","poem":2},{"text":"ئەوانەی تاریکی دەکەن بە ڕووناکی و","poem":1},{"text":"ڕووناکیش دەکەن بە تاریکی،","poem":2},{"text":"ئەوانەی تاڵ دەکەن بە شیرین و","poem":1},{"text":"شیرین دەکەن بە تاڵ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"قوڕبەسەر ئەوانەی لەبەرچاوی خۆیان دانان،","poem":1},{"text":"لەلای خۆیان تێگەیشتوون.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"قوڕبەسەر ئەوانەی لە شەراب خواردنەوە پاڵەوانن،","poem":1},{"text":"پیاوی ئازان بۆ تێکەڵکردنی مەی،","poem":2}]},{"type":"verse","number":23,"content":[{"text":"بۆ بەرتیل خراپەکار بێتاوان دەکەن،","poem":1},{"text":"ڕاستودروستانیش لە مافی خۆیان بێبەش دەکەن.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"لەبەر ئەوە وەک کا بە زمانی ئاگر قووت بدرێت،","poem":1},{"text":"وەک گژوگیای گڕگرتوو داکەوێت،","poem":2},{"text":"ڕەگیان وەک کەڕووی لێدێت،","poem":1},{"text":"خونچەیان وەک تۆز بەرز دەبێتەوە،","poem":2},{"text":"چونکە فێرکردنی یەزدانی سوپاسالاریان ڕەتکردەوە،","poem":1},{"text":"سووکایەتییان بە وشەی خودا پیرۆزەکەی ئیسرائیل کرد.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"لەبەر ئەوە تووڕەیی یەزدان لەسەر گەلەکەی جۆشا،","poem":1},{"text":"دەستی بۆ درێژکرد و لێیدا.","poem":2},{"text":"چیاکان هەژان و","poem":1},{"text":"جەستەکانیان وەک زبڵی سەر شەقامەکانی لێهات.","poem":2},{"lineBreak":true},{"text":"لەگەڵ هەموو ئەوەشدا تووڕەییەکەی دانەمرکایەوە،","poem":1},{"text":"هێشتا دەستی درێژکردووە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ئاڵا بۆ نەتەوە دوورەکان بەرز دەکاتەوە،","poem":1},{"text":"فیکە بۆ ئەوانە لێدەدات کە لەوپەڕی زەوین.","poem":2},{"lineBreak":true},{"text":"ئەوەتا خێرا بە پەلە دێن!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"نە ماندوو لەنێویاندایە و نە شەکەت،","poem":1},{"text":"نە دەخەوێت و نە خەواڵو دەبێت،","poem":2},{"text":"نە پشتێنی ناوقەدی دەکرێتەوە و","poem":1},{"text":"نە ئاوزەنگی","poem":2},{"noteId":8},{"text":"پێڵاوەکانی دەپچڕێت.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ئەوانەی تیرەکانیان تیژ و","poem":1},{"text":"کەوانەکانیان توند کراوە،","poem":2},{"text":"سمی ئەسپەکانیان وەک بەردەئەستێن،","poem":1},{"text":"چەرخەی گالیسکەکانیان وەک گەردەلوولە.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"نەڕەیان وەک نەڕەی شێرە مێیە و","poem":1},{"text":"وەک بەچکە شێر دەنەڕێنن،","poem":2},{"text":"دەمڕێنن و نێچیر دەگرن،","poem":1},{"text":"دەیبەن و کەس ڕزگاریان ناکات.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"لەو ڕۆژە بەسەریدا دەنەڕێنن،","poem":1},{"text":"وەک هاژەی دەریا.","poem":2},{"text":"دەڕواننە خاکەکە و دەبینن","poem":1},{"text":"وا تاریکییەکی تەنگە،","poem":2},{"lineBreak":true},{"text":"ڕووناکیش بە هەورەکانی تاریک بووە.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"یەک بەت دەکاتە 22 لیتر.‏","reference":{"chapter":5,"verse":10}},{"noteId":6,"caller":"+","text":"نزیکەی 160 کیلۆگرامی تۆو.‏","reference":{"chapter":5,"verse":10}},{"noteId":7,"caller":"+","text":"نزیکەی 16 کیلۆگرام.‏","reference":{"chapter":5,"verse":10}},{"noteId":8,"caller":"+","text":"ئاوەزێنە.‏","reference":{"chapter":5,"verse":27}}]},"thisChapterLink":"/api/ckb_bib/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}