{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["گوناهی ئیسرائیل و ملکەچی بەندە"]},{"type":"verse","number":1,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«کوا تەڵاقنامەی دایکتان","poem":1},{"text":"ئەوەی کە من بەڕەڵام کرد پێی؟","poem":2},{"text":"یان خاوەن قەرزەکانم کێن،","poem":1},{"text":"ئەوانەی ئێوەم پێی فرۆشتووە؟","poem":2},{"text":"ئەوەتا لەبەر تاوانەکانتان فرۆشران،","poem":1},{"text":"لەبەر یاخیبوونەکانتان دایکتان بەڕەڵا کرا.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بۆچی هاتم و کەس نەبوو؟","poem":1},{"text":"بانگم کرد و کەس وەڵامی نەدایەوە؟","poem":2},{"text":"ئایا دەستکورت بووم لە کڕینەوە؟","poem":1},{"text":"ئایا توانای فریاکەوتنم نییە؟","poem":2},{"text":"ئەوەتا بە ڕاخوڕینم دەریا وشک دەکەم،","poem":1},{"text":"ڕووبارەکان دەکەم بە چۆڵەوانی،","poem":2},{"text":"لەبەر بێ ئاوی ماسییەکانی بۆگەن دەبن،","poem":1},{"text":"لە تینووان دەمرن.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"تاریکی دەکەمە بەر ئاسمان،","poem":1},{"text":"گوش دەکەم بە پۆشاکی.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"یەزدانی باڵادەست زمانی فێربووانی پێم بەخشی","poem":1},{"text":"بۆ ئەوەی بزانم کە چۆن بە قسە یارمەتی ماندوو بدەم.","poem":2},{"text":"هەموو بەیانییەک بەخەبەرم دەهێنێتەوە،","poem":1},{"text":"گوێی من بەئاگا دەهێنێت","poem":2},{"lineBreak":true},{"text":"بۆ سەرنجدان وەک قوتابی.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"یەزدانی باڵادەست گوێیەکانی منی کردەوە،","poem":1},{"text":"منیش یاخی نەبووم،","poem":2},{"lineBreak":true},{"text":"بەرەو دوا هەڵنەگەڕامەوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"پشتم ڕاگرت بۆ ئەوەی لێی بدەن،","poem":1},{"text":"ڕوومەتیشم بۆ ئەوەی ڕیشم بڕننەوە.","poem":2},{"text":"ڕووی خۆمم دانەپۆشی لە","poem":1},{"text":"گاڵتەپێکردن و تفلێکردن.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لەبەر ئەوەی یەزدانی باڵادەست یارمەتیم دەدات،","poem":1},{"text":"ڕیسوا نابم،","poem":2},{"text":"لەبەر ئەوە ڕووی خۆمم وەک بەردەئەستێ لێکرد،","poem":1},{"text":"دەزانم شەرمەزار نابم.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەوەی بێتاوانم دەکات نزیکە،","poem":1},{"text":"کێ سکاڵا لە من دەکات؟","poem":2},{"lineBreak":true},{"text":"با پێکەوە ڕابوەستین،","poem":2},{"text":"کێ خاوەنی سکاڵایە لە دژی من؟","poem":1},{"text":"با لێم بێتە پێش!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەوەتا یەزدانی باڵادەست یارمەتیم دەدات،","poem":1},{"text":"ئیتر کێ تاوانبارم دەکات؟","poem":2},{"text":"ئەوەتا هەموویان وەک کراس دادەڕزێن،","poem":1},{"text":"مۆرانە دەیانخوات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"کێ لە ئێوە لە یەزدان دەترسێت و","poem":1},{"text":"گوێڕایەڵی بەندەکەی دەبێت؟","poem":2},{"text":"ئەوەی بە تاریکیدا دەڕوات و","poem":1},{"text":"ڕووناکی نابینێت،","poem":2},{"text":"با پشت بە ناوی یەزدان ببەستێت و","poem":1},{"text":"پاڵ بداتە پاڵ خودای خۆی.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بەڵام ئەی هەموو ئەوانەی ئاگر دەکەنەوە،","poem":1},{"text":"مەشخەڵ داگیرسێنن،","poem":2},{"text":"بڕۆن بە ڕووناکی ئاگرەکەی خۆتان و","poem":1},{"text":"بەو مەشخەڵانەی داتانگیرساند.","poem":2},{"text":"لە دەستی منەوە ئەمەتان بۆ دەبێت","poem":1},{"text":"لەناو ئازاردا ڕادەکشێن.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}