{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["ڕزگاریی هەتاهەتایی بۆ ئیسرائیل"]},{"type":"verse","number":1,"content":[{"text":"«ئەی ئەوانەی دوای ڕاستودروستی کەوتوون، گوێم لێ بگرن،","poem":1},{"text":"ئەی ئەوانەی ڕوو لە یەزدان دەکەن:","poem":2},{"text":"تەماشای ئەو تاشەبەردە بکەن کە لێوەی بڕاون و","poem":1},{"text":"کونی ئەو چاڵەی لێوەی هەڵکەنراون،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"تەماشای ئیبراهیمی باوکتان بکەن،","poem":1},{"text":"بڕواننە سارا، ئەوەی ئێوەی بووە،","poem":2},{"text":"چونکە کە بانگم کرد تەنها یەک کەس بوو،","poem":1},{"text":"بەرەکەتدارم کرد و زۆرم کرد.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بێگومان یەزدان دڵنەوایی سییۆن دەکات،","poem":1},{"text":"دڵنەوایی هەموو کاولبووەکانی دەکات.","poem":2},{"text":"چۆڵەوانییەکانی وەک عەدەن لێ دەکات و","poem":1},{"text":"شیوە وشکەکانی وەک باخچەی یەزدان.","poem":2},{"text":"شادی و خۆشی تێدا دەبینرێتەوە،","poem":1},{"text":"سوپاس و دەنگی مۆسیقا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«ئەی گەلی من، گوێم لێ بگرن،","poem":1},{"text":"ئەی نەتەوەکەم، گوێم بۆ شل بکەن،","poem":2},{"text":"چونکە فێرکردن لەلای منەوە دەردەچێت و","poem":1},{"text":"دادپەروەریم بۆ ڕووناکی گەلان دەچەسپێنم.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ڕاستودروستیم نزیکە،","poem":1},{"text":"ڕزگاریم بەڕێوەیە،","poem":2},{"lineBreak":true},{"text":"بازووی من دادوەری بۆ گەلان دەکات.","poem":2},{"text":"دوورگەکان چاوەڕێی منن،","poem":1},{"text":"هیوایان بە بازووی منە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"چاوتان بۆ ئاسمان هەڵبڕن و","poem":1},{"text":"لە ژێرەوە سەیری زەوی بکەن،","poem":2},{"text":"چونکە ئاسمان وەک دووکەڵ دەڕەوێتەوە و","poem":1},{"text":"زەوی وەک جل دادەڕزێت و","poem":2},{"lineBreak":true},{"text":"دانیشتووانەکەی وەک مێشوولە دەمرن.","poem":2},{"text":"بەڵام ڕزگاریی من بۆ هەتاهەتایە دەبێت،","poem":1},{"text":"ڕاستودروستیشم هەرگیز ناڕووخێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ئەی ئەوانەی ڕاستودروستی دەزانن، گوێم لێ بگرن،","poem":1},{"text":"ئەی ئەو گەلەی فێرکردنەکەم لەناو دڵیانە:","poem":2},{"text":"مەترسن لەوەی خەڵکی گاڵتەتان پێ بکەن،","poem":1},{"text":"لە جنێوەکانیان مەتۆقن،","poem":2}]},{"type":"verse","number":8,"content":[{"text":"چونکە وەک کراس مۆرانە دەیانخوات و","poem":1},{"text":"وەک خوری کرم لێیان دەدات،","poem":2},{"text":"بەڵام ڕاستودروستی من بۆ هەتاهەتایە دەبێت و","poem":1},{"text":"ڕزگاریشم بۆ نەوەی نەوەکان.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"بەئاگا بە، بەئاگا بە! هێز لەبەر بکە،","poem":1},{"text":"ئەی بازووی یەزدان،","poem":2},{"text":"بەئاگا بە وەک لە ڕۆژگارە دێرینەکان،","poem":1},{"text":"وەک لە سەردەمانی پێشوو!","poem":2},{"text":"ئایا تۆ نەبوویت کە ڕەهەڤت لەتکرد،","poem":1},{"text":"کە ئەو ئەژدیهایەت بە سەختی پێکا؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئایا تۆ نەبوویت دەریات وشک کرد،","poem":1},{"text":"ئاوی دەریا گەورەکەی ژێر زەوی","poem":2},{"noteId":75},{"text":"،","poem":2},{"text":"ئەوەی قووڵایی دەریای کردە ڕێگا","poem":1},{"text":"بۆ پەڕینەوەی ئەوانەی کڕاونەتەوە؟","poem":2}]},{"type":"verse","number":11,"content":[{"text":"جا ئەوانەی یەزدان کڕیونیەتیەوە دەگەڕێنەوە،","poem":1},{"text":"بە هاواری خۆشییەوە بۆ سییۆن دێن،","poem":2},{"lineBreak":true},{"text":"شادییەکی هەتاهەتایی لەسەر سەریانە.","poem":2},{"text":"خۆشی و شادی پێیان دەگەن و","poem":1},{"text":"ناخۆشی و ئاخ هەڵکێشان هەڵدێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«منم، منم کە دڵنەواییتان دەکەم.","poem":1},{"text":"تۆ کێیت لە مرۆڤ دەترسیت کە دەمرێت،","poem":2},{"lineBreak":true},{"text":"یاخود لە ئادەمیزاد کە وەک گیای لێدێت؟","poem":2}]},{"type":"verse","number":13,"content":[{"text":"تۆ کێیت تاوەکو یەزدان لەیاد بکەیت کە دروستی کردوویت،","poem":1},{"text":"کە ئاسمانی لێککردووەتەوە و","poem":2},{"lineBreak":true},{"text":"زەوی دامەزراندووە،","poem":2},{"text":"کە بەردەوام هەموو ڕۆژێک زەندەقت چووە","poem":1},{"text":"لە تووڕەیی ستەمکار،","poem":2},{"lineBreak":true},{"text":"کە ئامادەی کردووە بۆ لەناوبردن؟","poem":2},{"text":"بەڵام کوا تووڕەیی ستەمکار؟","poem":1}]},{"type":"verse","number":14,"content":[{"text":"بەم نزیکانە گەلە دیلەکە ئازاد دەکرێن،","poem":2},{"text":"لەناو زیندان نامرن،","poem":1},{"text":"نانیان کەم نابێت،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"چونکە من یەزدانی پەروەردگارتانم،","poem":1},{"text":"ئەوەی دەریا دەهەژێنێت و شەپۆلەکانی دەوروژێنێت،","poem":2},{"lineBreak":true},{"text":"ناوم یەزدانی سوپاسالارە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"من وتەکانم خستووەتە دەمی تۆوە و","poem":1},{"text":"بە سێبەری دەستم تۆم شاردووەتەوە،","poem":2},{"text":"من کە ئاسمانم لە شوێنی خۆی دانا و","poem":1},{"text":"زەویم دامەزراند،","poem":2},{"lineBreak":true},{"text":"کە بە سییۆن دەڵێم: ”تۆ گەلی منیت.“»","poem":2}]},{"type":"heading","content":["جامی تووڕەیی یەزدان"]},{"type":"verse","number":17,"content":[{"text":"بەئاگا بە! بەئاگا بە!","poem":1},{"text":"ئۆرشەلیم هەستە!","poem":2},{"text":"ئەوەی جامی تووڕەییت","poem":1},{"text":"بە دەستی یەزدان خواردەوە،","poem":2},{"text":"خڵتی جامی بەلاداهاتنت","poem":1},{"text":"خواردەوە و چۆڕاندتەوە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"کەس نییە ڕێنمایی بکات","poem":1},{"text":"لە هەموو ئەو کوڕانەی بۆی لەدایک بوون،","poem":2},{"text":"کەس نییە دەستی بگرێت","poem":1},{"text":"لە هەموو ئەو کوڕانەی بەخێوی کردن.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"کارەساتەکان بە جووت بە پیرتەوە هاتوون،","poem":1},{"text":"کاولبوون و وردوخاشبوون، قاتوقڕی و شمشێر.","poem":2},{"text":"کێ دەتوانێت بۆت بلاوێنێتەوە؟","poem":1},{"text":"کێ دەتوانێت دڵنەواییت بکات؟","poem":2}]},{"type":"verse","number":20,"content":[{"text":"کوڕەکانت گرمۆڵە بوون و ڕاکشان","poem":1},{"text":"لەسەر سووچی هەموو شەقامێک","poem":2},{"lineBreak":true},{"text":"وەک ئاسک لەناو تۆڕدا.","poem":2},{"text":"پڕن لە تووڕەیی یەزدان و","poem":1},{"text":"لە سەرزەنشتی خودات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"لەبەر ئەوە ئێستا گوێ لەمە بگرە ئەی زەلیلەکە،","poem":1},{"text":"ئەی سەرخۆش، بەبێ شەراب سەرخۆش بوویت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"یەزدانی باڵادەستت ئەمە دەفەرموێت،","poem":1},{"text":"خوداکەت کە پشتگیری گەلەکەی خۆی دەکات:","poem":2},{"text":"«ئێستا ئەو جامە لە دەستت دەبەم کە وا دەکات بەلادابێیت،","poem":1},{"text":"لەمەودوا لەو جامەی کە جامی تووڕەیی منە ناخۆیتەوە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"دامە دەست ئەشکەنجەدەرانت،","poem":1},{"text":"ئەوانەی بە گیانی تۆیان گوت:","poem":2},{"lineBreak":true},{"text":"”بچەمێوە بۆ ئەوەی بپەڕینەوە.“","poem":2},{"text":"جا پشتت وەک زەوی دانا،","poem":1},{"text":"وەک شەقام بۆ ئەوانەی دەپەڕنەوە.»","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":75,"caller":"+","text":"بەپێی بیروباوەڕی خەڵکی ڕۆژهەڵاتی کۆن (دەریای ژێر زەوی) هەبوو کە لەژێر زەوی بوو و سەرچاوەی کانیاو و ڕووبارەکان بوو.‏","reference":{"chapter":51,"verse":10}}]},"thisChapterLink":"/api/ckb_bib/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}