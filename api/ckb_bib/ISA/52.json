{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"ئەی سییۆن، بەئاگا بە! بەئاگا بە!","poem":1},{"text":"بەرگی هێزت لەبەر بکە،","poem":2},{"text":"ئەی ئۆرشەلیم، شاری پیرۆز،","poem":1},{"text":"بەرگی جوانیت بپۆشە،","poem":2},{"text":"چونکە ئیتر لەمەودوا نایەتە ناوت","poem":1},{"text":"خەتەنەنەکراو و گڵاو.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەی ئۆرشەلیم، لەناو خۆڵ هەستە و","poem":1},{"text":"خۆت بتەکێنە، لەسەر تەخت دابنیشە.","poem":2},{"text":"ئەی ڕاپێچکراوەکە، شاری سییۆن،","poem":1},{"text":"کۆتەکانی ملت بکەرەوە.","poem":2}]},{"type":"verse","number":3,"content":["ئێستا یەزدان ئەمە دەفەرموێت:",{"text":"«بەخۆڕایی فرۆشران،","poem":1},{"text":"بەبێ پارە دەکڕدرێنەوە.»","poem":2}]},{"type":"verse","number":4,"content":["هەروەها یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«سەرەتا گەلەکەم دابەزین بۆ میسر و ئاوارەبوون لەوێ،","poem":1},{"text":"لەم دواییانەشدا ئاشور ستەمی لێدەکرد.»","poem":2}]},{"type":"verse","number":5,"content":["یەزدان دەفەرموێت: «ئێستا لێرە چیم هەیە؟",{"text":"«گەلەکەم بەخۆڕایی بردرا و","poem":1},{"text":"فەرمانڕەواکانی دەلوورێنن،","poem":2},{"text":"بەردەوام بە درێژایی ڕۆژیش","poem":1},{"text":"کفر بە ناوی من دەکرێت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لەبەر ئەوە گەلەکەم بە ناوی من ئاشنا دەبن،","poem":1},{"text":"لەو ڕۆژەدا دەزانن","poem":2},{"text":"ئەوەتام، ئەوە منم کە ئەم بەڵێنە دەدەم.»","poem":1},{"text":"یەزدان دەفەرموێت.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"چەند جوانە لەسەر چیاکان","poem":1},{"text":"پێیەکانی مزگێنیدەران،","poem":2},{"text":"ڕاگەیەنەری ئاشتی،","poem":1},{"text":"مزگێنیدەری خۆشی،","poem":2},{"lineBreak":true},{"text":"ڕاگەیەنەری ڕزگاری،","poem":2},{"text":"ئەوانەی بە سییۆن دەڵێن:","poem":1},{"text":"«خودات پاشایەتی دەکات!»","poem":2}]},{"type":"verse","number":8,"content":[{"text":"گوێ بگرە! ئێشکگرەکانت دەنگیان هەڵدەبڕن،","poem":1},{"text":"پێکەوە هاواری خۆشی دەکەن،","poem":2},{"text":"بە چاوی خۆیان دەبینن","poem":1},{"text":"کاتێک یەزدان دەگەڕێتەوە بۆ سییۆن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەی کەلاوەکانی ئۆرشەلیم،","poem":1},{"text":"پێکەوە بە خۆشی گۆرانی بڵێن،","poem":2},{"text":"چونکە یەزدان دڵنەوایی گەلەکەی خۆی دەکات،","poem":1},{"text":"بێگومان ئۆرشەلیم دەکڕێتەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"یەزدان بازووی پیرۆزی خۆی هەڵدەکات","poem":1},{"text":"لەبەرچاوی هەموو نەتەوەکان،","poem":2},{"text":"هەر چوار لای زەویش","poem":1},{"text":"ڕزگاریی خودای ئێمە دەبینن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ئەی هەڵگرانی کەلوپەلی پەرستگای یەزدان،","poem":1},{"text":"جیا بنەوە، جیا بنەوە، لە بابل بچنە دەرەوە!","poem":2},{"text":"دەست لە هیچ شتێکی گڵاو مەدەن!","poem":1},{"text":"لەناوی وەرنە دەرەوە، خۆتان پاک بکەنەوە!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بەڵام بە پەلە دەرناچن،","poem":1},{"text":"بە هەڵاتن ناڕۆن،","poem":2},{"text":"چونکە یەزدان لەبەردەمتانەوە دەڕوات،","poem":1},{"text":"خودای ئیسرائیل پاشڕەو و پارێزەرتانە.","poem":2}]},{"type":"heading","content":["ئازارچێژتنی بەندەی یەزدان"]},{"type":"verse","number":13,"content":[{"text":"ببینە، بەندەکەم وا بە وریاییەوە هەڵسوکەوت دەکات،","poem":1},{"text":"بەرز و بڵند و زۆر پایەبەرز دەبێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"وەک ئەوەی زۆر کەس واقیان لێی وڕما،","poem":1},{"text":"دیمەنی وەک مرۆڤ نەبوو،","poem":2},{"lineBreak":true},{"text":"وێنەی لە ئادەمیزاد نەدەچوو،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئاوا زۆر لە نەتەوەکان لێی سەرسام دەبن،","poem":1},{"text":"لەبەر ئەو پاشایان دەمی خۆیان دەگرن،","poem":2},{"text":"چونکە ئەوەی بۆیان باس نەکرابوو دەیبینن،","poem":1},{"text":"ئەوەی نەیانبیستبوو تێی دەگەن.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}