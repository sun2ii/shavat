{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"کێ باوەڕی بە پەیامەکەمان کرد و","poem":1},{"text":"هێزی یەزدان بۆ کێ دەرکەوت؟","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بەندەکە وەک چەکەرە لەبەردەمی باڵای کرد،","poem":1},{"text":"وەک ڕەگ لە خاکێکی تینوو گەشەی کرد.","poem":2},{"text":"نە جوانی هەبوو و نە پایەبەرزی تاوەکو سەرنجمان بۆی بچێت،","poem":1},{"text":"نە دیمەن تاوەکو ئارەزووی بکەین.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ڕیسوا و سووک لەلایەن خەڵکەوە،","poem":1},{"text":"پیاوی ئازار و شارەزای ناخۆشی.","poem":2},{"text":"وەک یەکێک خەڵک ڕووی خۆیانی لێ بشارنەوە،","poem":1},{"text":"ڕیسوا بوو و بە هیچمان نەزانی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"بە دڵنیاییەوە دەردەکانی ئێمەی هەڵگرت،","poem":1},{"text":"ئازارەکانی ئێمەی برد،","poem":2},{"text":"ئێمەش وامانزانی لەلایەن خوداوە گورزی بەرکەوتووە،","poem":1},{"text":"لێی دراوە و زەلیلە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بەڵام ئەو لەبەر یاخیبوونەکانمان بریندار بوو،","poem":1},{"text":"لەبەر تاوانەکانمان وردوخاشکرا.","poem":2},{"text":"ئەو لە پێناوی ئاشتبوونەوەی ئێمە سزای چێژت،","poem":1},{"text":"بە برینەکانی ئەو چاک بووینەوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"هەموومان وەک مەڕ وێڵ و سەرگەردان بووین،","poem":1},{"text":"هەریەکەمان ملی ڕێگای خۆی گرتووە،","poem":2},{"text":"بەڵام یەزدان هەموو تاوانەکانی ئێمەی","poem":1},{"text":"خستە سەر ئەو.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"زەلیل کرا و ستەمیان لێکرد،","poem":1},{"text":"بەڵام دەمی نەکردەوە.","poem":2},{"text":"ئەو وەک بەرخ بۆ سەربڕین بردرا،","poem":1},{"text":"وەک چۆن مەڕێک لەبەردەستی ئەوانەی خورییەکەی دەبڕنەوە بێدەنگە،","poem":2},{"lineBreak":true},{"text":"ئەو دەمی نەکردەوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بە ستەم و حوکم بەسەردادان بردرا.","poem":1},{"text":"بەڵام کێ لە نەوەی سەردەمی خۆی لە دژی وەستایەوە؟","poem":2},{"text":"چونکە لە جیهانی زیندووان هەڵگیرا،","poem":1},{"text":"لەبەر یاخیبوونی گەلەکەم ئەو لێی درا.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"گۆڕی لەگەڵ بەدکاران دانرا،","poem":1},{"text":"دوای مردنی لە گۆڕی دەوڵەمەندێک نێژرا،","poem":2},{"text":"هەرچەندە ستەمکاری نەکرد و","poem":1},{"text":"فڕوفێڵی لەسەر زار نەبوو.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"بەڵام خواستی یەزدان بوو وردوخاشی بکات و ئازار بکێشێت،","poem":1},{"text":"لەگەڵ ئەوەشدا یەزدان ژیانی کرد بە قوربانیی تاوان،","poem":2},{"text":"نەوە و ڕۆژگاری درێژ دەبینێت،","poem":1},{"text":"خواستی یەزدان بە دەستی ئەو سەردەکەوێت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لەدوای ئەو ئازارەی بەرگەی گرت،","poem":1},{"text":"ڕووناکی ژیان دەبینێت و تێر دەبێت،","poem":2},{"text":"بەندە ڕاستودروستەکەم بە ئەزموونی خۆی زۆر کەس بێتاوان دەکات و","poem":1},{"text":"ئەو تاوانەکانیان هەڵدەگرێت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لەبەر ئەوە لەگەڵ مەزنەکان بەشی دەدەم،","poem":1},{"text":"لەگەڵ بەهێزەکان دەستکەوت بەش دەکات،","poem":2},{"text":"چونکە ژیانی خۆی بەخت کرد و","poem":1},{"text":"لەگەڵ یاخیبووان ژمێردرا،","poem":2},{"text":"لەبەر ئەوەی گوناهی زۆر کەسی هەڵگرت و","poem":1},{"text":"داکۆکی لە یاخیبووان کرد.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}