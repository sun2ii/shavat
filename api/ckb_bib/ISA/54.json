{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["شکۆی داهاتوو بۆ سییۆن"]},{"type":"verse","number":1,"content":[{"text":"«ئەی نەزۆک، گۆرانی بڵێ،","poem":1},{"text":"ئەی ئەوەی منداڵت نەبووە،","poem":2},{"text":"ئەی ئەوەی ژانت نەگرتووە،","poem":1},{"text":"لە خۆشیدا هاوار بکە و گۆرانی بڵێ،","poem":2},{"text":"چونکە منداڵی ژنی بەجێهێڵراو","poem":1},{"text":"زیاترن لەوەی مێردی لەگەڵیەتی،»","poem":2},{"text":"یەزدان دەفەرموێت.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"«شوێنی ڕەشماڵەکانت فراوان بکە،","poem":1},{"text":"پەردەی نشینگەکانت لێک بکەرەوە،","poem":2},{"lineBreak":true},{"text":"دەست مەگێڕەوە،","poem":2},{"text":"گوریسەکانت درێژ بکە و","poem":1},{"text":"سنگەکانت توند بچەقێنە،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"چونکە بەلای ڕاست و چەپدا پەل دەهاوێیت،","poem":1},{"text":"نەوەی تۆ نەتەوەکان دەردەکەن و","poem":2},{"lineBreak":true},{"text":"شارە وێرانەکان ئاوەدان دەکەنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«مەترسە، چونکە ڕیسوا نابیت.","poem":1},{"text":"گاڵتەت پێ ناکرێت، چونکە شەرمەزار نابیت.","poem":2},{"text":"ڕیسوایی سەردەمی گەنجیێتیت لەبیر دەکەیت،","poem":1},{"text":"ئیتر شورەیی بێوەژنیێتیت بەبیر نایەتەوە،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"چونکە مێردی","poem":1},{"noteId":76},{"text":"تۆ دروستکەرەکەی تۆیە،","poem":1},{"text":"ناوی یەزدانی سوپاسالارە.","poem":2},{"text":"ئەوەی دەتکڕێتەوە پیرۆزەکەی ئیسرائیلە،","poem":1},{"text":"پێی دەگوترێت خودای هەموو زەوی.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"وەک ژنێکی بەجێماو و ڕۆح پڕ لە ژان","poem":1},{"text":"یەزدان بانگت دەکاتەوە،","poem":2},{"text":"وەک ژنێک کە لە گەنجیدا شووی کردبێت و ڕەتکرابێتەوە،»","poem":1},{"text":"خودات دەفەرموێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«بۆ ساتێکی کەم بەجێم هێشتیت،","poem":1},{"text":"بەڵام بە بەزەییەکی زۆرەوە کۆت دەکەمەوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بە زریانی تووڕەییەوە","poem":1},{"text":"بۆ ساتێک ڕووی خۆمم لێت داپۆشی،","poem":2},{"text":"بەڵام بە خۆشەویستی نەگۆڕی هەتاهەتایی","poem":1},{"text":"بەزەییم پێتدا هاتەوە،»","poem":2},{"lineBreak":true},{"text":"ئەوە فەرمایشتی یەزدانە، ئەوەی دەتکڕێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«ئەمە وەک لافاوی نوحە بۆ من","poem":1},{"text":"ئەوەی سوێندم خوارد، کە لافاوەکەی نوح جارێکی دیکە بەسەر زەویدا تێنەپەڕێت.","poem":2},{"text":"ئاوا سوێندم خوارد، کە لێت تووڕە نەبم و","poem":1},{"text":"لێت ڕانەخوڕم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"هەرچەندە چیاکان نامێنن و","poem":1},{"text":"گردەکان دەهەژێن،","poem":2},{"text":"بەڵام خۆشەویستی نەگۆڕی من بۆ تۆ دەمێنێت و","poem":1},{"text":"پەیمانی ئاشتیم ناهەژێت،»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە، ئەوەی بەزەیی پێتدا دێتەوە.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ئەی شارە زەلیلەکە، زریان لێدراوەکە، دڵنەوایی نەکراوەکە،","poem":1},{"text":"ئەوەتا من بەردەکانت بە بەردە پیرۆزە","poem":2},{"noteId":77},{"text":"لەسەر ڕیز دەکەم،","poem":2},{"lineBreak":true},{"text":"بە یاقووتی شین","poem":2},{"noteId":78},{"text":"داتدەمەزرێنم.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"قوللەکانت دەکەم بە یاقووت","poem":1},{"noteId":79},{"text":"و","poem":1},{"text":"دەروازەکانیشت بە بەردی پڕشنگدار،","poem":2},{"lineBreak":true},{"text":"هەموو سنوورەکانیشت بە بەردی گرانبەها.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"هەموو منداڵەکانت لە یەزدانەوە فێر دەبن و","poem":1},{"text":"ئاشتی منداڵەکانت زۆر دەبێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"بە ڕاستودروستی دەچەسپێیت","poem":1},{"lineBreak":true},{"text":"دوور لە جەوروستەم،","poem":1},{"text":"چونکە هیچ هۆیەک نییە بۆ ئەوەی بترسیت،","poem":2},{"text":"هەروەها دووریت لە تۆقینیش،","poem":1},{"text":"چونکە لێت نزیک ناکەوێتەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەگەر پەلامار درایت، ئەوە لەلایەن منەوە نابێت،","poem":1},{"text":"ئەوەی هێرش دەکاتە سەرت، دەبێتە ژێر دەستت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«ئەوەتا من ئاسنگەرم بەدیهێنا","poem":1},{"text":"کە کوورەی ئاگری خەڵووز دەم دەدات،","poem":2},{"lineBreak":true},{"text":"چەکی گونجاو دروستدەکات،","poem":2},{"text":"هەروەها من لەناوبەرم بەدیهێنا بۆ ئەوەی بفەوتێنێت.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"هەر چەکێک لە دژی تۆ شێوەی بکێشرێت سەرناکەوێت و","poem":2},{"lineBreak":true},{"text":"هەر زمانێک لە دادگا لە دژی تۆ ڕادەوەستێت بەرپەرچی دەدەیتەوە.","poem":2},{"text":"ئەمە میراتی خزمەتکارانی یەزدانە،","poem":1},{"text":"بێتاوانیتان لەلایەن منەوەیە،»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]}],"footnotes":[{"noteId":76,"caller":"+","text":"پەیوەندی نێوان خودا و گەلەکەی بە پەیوەندی نێوان ژن و مێرد دەچووێنرێت، لە ڕووی ئەرک و وەفا و گوێڕایەڵییەوە.‏","reference":{"chapter":54,"verse":5}},{"noteId":77,"caller":"+","text":"بەردە پیرۆزە: بەردێکی شینی سەوزباو.‏","reference":{"chapter":54,"verse":11}},{"noteId":78,"caller":"+","text":"یاقووتی شین: دەشێت لاجیوەرد بێت.‏","reference":{"chapter":54,"verse":11}},{"noteId":79,"caller":"+","text":"یاقووت: گەوهەری سووری تێر.‏","reference":{"chapter":54,"verse":12}}]},"thisChapterLink":"/api/ckb_bib/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}