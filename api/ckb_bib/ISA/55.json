{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["بانگهێشتکردنی تینووەکان"]},{"type":"verse","number":1,"content":[{"text":"«هۆ ئەی هەموو تینووەکان، وەرن،","poem":1},{"text":"وەرن بۆ ئاو","poem":2},{"noteId":80},{"text":"،","poem":2},{"text":"ئەوانەش کە پارەیان نییە،","poem":1},{"text":"وەرن، بکڕن و بخۆن!","poem":2},{"text":"وەرن ئێوە پارە مەدەن، بەبێ نرخ","poem":1},{"text":"شەراب و شیر بکڕن.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بۆچی پارە بە شتێک بەهەدەر دەدەن کە نان نییە؟","poem":1},{"text":"بۆچی کارێک دەکەن لە پێناوی شتێک کە تێرتان ناکات؟","poem":2},{"text":"بە تەواوی گوێم لێ بگرن و ئەوە بخۆن کە باشە،","poem":1},{"text":"با گیانتان تام لە چەوری وەربگرێت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"گوێتان شل بکەن و وەرنە لام،","poem":1},{"text":"گوێ بگرن بۆ ئەوەی گیانتان بژیێت.","poem":2},{"text":"پەیمانی هەتاهەتاییتان لەگەڵدا دەبەستم،","poem":1},{"text":"خۆشەویستی نەگۆڕ و چەسپاوم بۆ داود.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەوەتا کردم بە شایەت بەسەر نەتەوەکانەوە،","poem":1},{"text":"ڕابەر و فەرماندە بۆ نەتەوەکان.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەوەتا ئەو نەتەوانەی نایانناسیت بانگیان دەکەیت و","poem":1},{"text":"ئەو نەتەوانەی ناتناسن بۆ لات ڕادەکەن،","poem":2},{"text":"لەبەر یەزدانی پەروەردگارت،","poem":1},{"text":"لەبەر پیرۆزەکەی ئیسرائیل،","poem":2},{"lineBreak":true},{"text":"چونکە شکۆمەندی کردیت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ڕووتان لە یەزدان بکەن هەتا کاتی ماوە،","poem":1},{"text":"لێی بپاڕێنەوە کە هێشتا نزیکە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"با بەدکار واز لە ڕێگای خۆی بهێنێت و","poem":1},{"text":"خراپەکاریش لە بیرکردنەوەکانی،","poem":2},{"text":"با بگەڕێتەوە لای یەزدان، ئەویش بەزەیی پێدا بێتەوە،","poem":1},{"text":"بۆ لای خودامان، چونکە زۆر لێبوردەیە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«بێگومان بیرکردنەوەی من بیرکردنەوەی ئێوە نییە و","poem":1},{"text":"ڕێگاکانی ئێوەش ڕێگاکانی من نین،»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"«هەروەک بەرزیی ئاسمان لە زەوییەوە،","poem":1},{"text":"ئاوا بەرزە ڕێگاکانم بەسەر ڕێگاکانتاندا و","poem":2},{"lineBreak":true},{"text":"بیرکردنەوەم بەسەر بیرکردنەوەتان.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"هەروەک چۆن باران و بەفر","poem":1},{"text":"لە ئاسمانەوە دێنە خوارەوە و","poem":2},{"text":"ناگەڕێنەوە ئەوێ،","poem":1},{"text":"بەڵکو زەوی ئاو دەدەن و","poem":2},{"text":"وای لێ دەکەن بەرهەم بدات و ڕووەکی لێ بڕووێت و","poem":1},{"text":"تۆو بدات بۆ تۆوکردن و نان بۆ خواردن،","poem":2}]},{"type":"verse","number":11,"content":[{"text":"فەرمایشتەکەم ئاوا دەبێت کە لە دەممەوە دێتە دەرەوە:","poem":1},{"text":"بە بەتاڵی ناگەڕێتەوە بۆم،","poem":2},{"text":"بەڵکو ئەوەی من پێم خۆشە دەیکات و","poem":1},{"text":"سەرکەوتوو دەبێت لەوەی بۆی دەنێرم.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەو کاتە بە خۆشییەوە دەچنە دەرەوە و","poem":1},{"text":"بە ئاشتییەوە ڕابەرایەتیتان دەکرێت،","poem":2},{"text":"چیاکان و گردەکان","poem":1},{"text":"لەبەردەمتان دەکەونە هاواری خۆشییەوە،","poem":2},{"text":"هەموو دارەکانی دەشتودەریش","poem":1},{"text":"بە دەست چەپڵە لێ دەدەن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لە جێی دڕک سنەوبەر دەڕوێت و","poem":1},{"text":"لە جێی چقڵیش مۆرد دەڕوێت،","poem":2},{"text":"بۆ یەزدان دەبێت بە ناوێک،","poem":1},{"text":"نیشانەیەکی هەتاهەتایی","poem":2},{"lineBreak":true},{"text":"کە لەناو ناچێت.»","poem":2}]}],"footnotes":[{"noteId":80,"caller":"+","text":"ئاو: هێمایە بۆ ژیان و بەزەیی خودا.‏","reference":{"chapter":55,"verse":1}}]},"thisChapterLink":"/api/ckb_bib/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}