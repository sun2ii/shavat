{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["ڕزگاری بۆ ئەوانەی دوورن"]},{"type":"verse","number":1,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«دادپەروەری بپارێزن و","poem":1},{"text":"ڕاستودروستی ئەنجام بدەن،","poem":2},{"text":"چونکە بەم نزیکانە ڕزگاریم دێت و","poem":1},{"text":"ڕاستودروستیم ئاشکرا دەبێت.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"خۆزگە بەو مرۆڤەی ئەمە دەکات و","poem":1},{"text":"بەو ئادەمیزادەی توند دەستی پێوە دەگرێت،","poem":2},{"text":"ئەوەی ڕۆژی شەممە لە گڵاوبوون دەپارێزێت و","poem":1},{"text":"دەستی دەپارێزێت لە کردنی هەموو خراپەیەک.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"با ئەو بیانییەی خۆی داوەتە پاڵ یەزدان نەڵێت:","poem":1},{"text":"«یەزدان بە تەواوی جیام دەکاتەوە لە گەلەکەی.»","poem":2},{"text":"با خەساویش نەڵێت:","poem":1},{"text":"«ئەوەتا من تەنها دارێکی وشکم.»","poem":2}]},{"type":"verse","number":4,"content":["لەبەر ئەوەی یەزدان ئەمە دەفەرموێت:",{"text":"«ئەو خەساوانەی ڕۆژەکانی شەممەم دەپارێزن،","poem":1},{"text":"ئەوە هەڵدەبژێرن کە دڵم پێی خۆشە و","poem":2},{"lineBreak":true},{"text":"دەستیان بە پەیمانەکەمەوە گرتووە،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لەناو پەرستگای خۆم و دیوارەکانی","poem":1},{"text":"یادەوەری و ناویان پێدەدەم،","poem":2},{"lineBreak":true},{"text":"لە کوڕان و لە کچان باشترن بۆیان.","poem":2},{"text":"ناوێکی هەتاهەتاییان پێدەدەم","poem":1},{"text":"کە نابڕدرێتەوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەو بیانییانەش کە خۆیان داوەتە پاڵ یەزدان","poem":1},{"text":"بۆ پەرستنی و","poem":2},{"text":"بۆ خۆشویستنی ناوی یەزدان","poem":1},{"text":"هەتا بۆی ببن بە بەندە،","poem":2},{"text":"هەموو ئەوانەی ڕۆژی شەممە لە گڵاوبوون دەپارێزن و","poem":1},{"text":"دەستیان بە پەیمانەکەمەوە گرتووە","poem":2}]},{"type":"verse","number":7,"content":[{"text":"دەیانهێنمە کێوی پیرۆزم،","poem":1},{"text":"لە ماڵی نوێژم دڵخۆشیان دەکەم.","poem":2},{"text":"قوربانی سووتاندن و سەربڕاویان","poem":1},{"text":"مایەی ڕەزامەندین لەسەر قوربانگاکەم،","poem":2},{"text":"چونکە ماڵەکەم بە ماڵی نوێژ ناودەبردرێت","poem":1},{"text":"بۆ هەموو گەلان.»","poem":2}]},{"type":"verse","number":8,"content":[{"text":"یەزدانی باڵادەست،","poem":1},{"text":"ئەوەی دوورخراوەکانی ئیسرائیل کۆدەکاتەوە، دەفەرموێت:","poem":2},{"text":"«زیاتر کۆدەکەمەوە","poem":1},{"text":"لەگەڵ ئەوانەی کە کۆمکردوونەتەوە.»","poem":2}]},{"type":"heading","content":["خودا بەدکاران تاوانبار دەکات"]},{"type":"verse","number":9,"content":[{"text":"ئەی هەموو گیانلەبەرانی دەشتودەر،","poem":1},{"text":"ئەی هەموو گیانلەبەرانی دارستان، وەرن، بخۆن!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئێشکگرەکانی گەل هەموو کوێرن،","poem":1},{"text":"نەزانن.","poem":2},{"text":"هەموو سەگی لاڵن،","poem":1},{"text":"ناتوانن بوەڕن.","poem":2},{"text":"خەونبین و پاڵکەوتوون،","poem":1},{"text":"حەزیان لە خەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"سەگەکان چاو برسین،","poem":1},{"text":"تێربوون نازانن.","poem":2},{"text":"ئەوان شوانن و تێناگەن،","poem":1},{"text":"هەموو ملی ڕێی خۆیان گرت،","poem":2},{"lineBreak":true},{"text":"هەریەکە و بۆ قازانج لەلای خۆیەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"دەڵێن: «وەرن شەراب بهێنین!","poem":1},{"text":"با مەی بنۆشین!","poem":2},{"text":"بەیانیش وەک ئەمڕۆ دەبێت،","poem":1},{"text":"بەڵکو زۆر باشتریش.»","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}