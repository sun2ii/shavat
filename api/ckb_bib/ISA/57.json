{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"ڕاستودروستان لەناودەچن،","poem":1},{"text":"کەسیش لە دڵی خۆیدا بیر لەمە ناکاتەوە.","poem":2},{"text":"خودا خۆشەویستانی بۆ لای خۆی دەگەڕێنێتەوە،","poem":1},{"text":"بەڵام کەس تێناگات","poem":2},{"text":"کە ڕاستودروست بۆ لای خۆی دەگەڕێنێتەوە","poem":1},{"text":"بۆ ئەوەی لە خراپە ڕزگاریان بکات.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەوەی ڕێگای ڕاستی گرتووەتەبەر","poem":1},{"text":"دێتە ناو ئاشتییەوە،","poem":2},{"lineBreak":true},{"text":"لەناو تابووتەکانیان دەحەسێنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«بەڵام ئێوە، ئەی کوڕانی ژنە بەخت خوێنەرەکە،","poem":1},{"text":"توخمی داوێنپیسە لەشفرۆشەکان، وەرنە پێشەوە!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"گاڵتە بە کێ دەکەن؟","poem":1},{"text":"لە کێ دەم دەکەنەوە و","poem":2},{"lineBreak":true},{"text":"زمان درێژ دەکەن؟","poem":2},{"text":"ئەی ئێوە کوڕانی یاخیبوون و","poem":1},{"text":"توخمی درۆ نین؟","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئێوە لەنێو دار بەڕووەکان،","poem":1},{"text":"لەژێر هەموو دارێکی سەوزدا جۆش دەستێنن،","poem":2},{"text":"ئەوانەی منداڵان لە شیوەکان و","poem":1},{"text":"لەژێر کەلەبەرەکانی تاوێرەکاندا دەکەنە قوربانی.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بەشت ئەو بتانەیە کە لەنێو بەردە لووسەکانی شیوەکانن،","poem":1},{"text":"بێگومان ئەوان پشکی تۆن.","poem":2},{"text":"هەروەها بۆ ئەوان شەرابی پێشکەشکراو و","poem":1},{"text":"پێشکەشکراوی دانەوێڵەت پێشکەش کرد.","poem":2},{"lineBreak":true},{"text":"ئایا لەبەر ئەمە پاشگەز ببمەوە؟","poem":2}]},{"type":"verse","number":7,"content":[{"text":"جێگای نوستنت لەسەر کێوێکی بەرز و بڵند داناوە،","poem":1},{"text":"بۆ ئەوێ سەرکەوتیت تاوەکو قوربانی سەرببڕیت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"لە پشت دەرگا و چوارچێوەکەی","poem":1},{"text":"هێمای بتەکەتت داناوە.","poem":2},{"text":"پشتت لە من کرد و خۆتت ڕووت کردەوە،","poem":1},{"text":"سەرکەوتیتە سەر جێگای خەوی خۆت و فراوانت کرد.","poem":2},{"text":"پەیمانت لەگەڵ بتەکاندا بەست،","poem":1},{"text":"حەزت کرد داوێنپیسییان لەگەڵ بکەیت،","poem":2},{"lineBreak":true},{"text":"ناموسی ئەوانت بینی.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بە زەیتەوە چوویتە لای مۆلەخ","poem":1},{"noteId":81},{"text":"و","poem":1},{"text":"بۆنوبەرامی خۆتت زیاد کرد.","poem":2},{"text":"نێردراوەکانت بۆ دوور نارد،","poem":1},{"text":"شۆڕ بوویتەوە هەتا جیهانی مردووان!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"درێژی گەشتەکانت ماندووی کردیت،","poem":1},{"text":"کەچی نەتگوت: ”ئەمە بێ ئومێدییە.“","poem":2},{"text":"هێزێکی نوێت دۆزییەوە","poem":1},{"text":"لەبەر ئەوە شەکەت نەبوویت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«لە کێ ترسایت و تۆقیت","poem":1},{"text":"وا ناپاکیت لەگەڵ کردم،","poem":2},{"text":"منت لە دڵت نەهێشتەوە و","poem":1},{"text":"لەبیرت کردم؟","poem":2},{"text":"ئایا لەبەر ئەوەی من ماوەیەکی زۆرە بێدەنگم","poem":1},{"text":"لە من نەترسایت؟","poem":2}]},{"type":"verse","number":12,"content":[{"text":"من ڕاستودروستی و کردەوەکانت دەخەمە ڕوو،","poem":1},{"text":"کە هیچ سوودیان بۆت نییە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"کاتێک هاوار دەکەیت،","poem":1},{"text":"با بتە کۆکراوەکانت فریات بکەون!","poem":2},{"text":"بای گێژەڵوکە هەموویان هەڵدەگرێت،","poem":1},{"text":"تەنانەت شنەبا دەیانبات.","poem":2},{"text":"بەڵام ئەوەی پەنای داوەتە پاڵ من","poem":1},{"text":"دەبێت بە میراتگری خاکەکە،","poem":2},{"lineBreak":true},{"text":"کێوی پیرۆزم دەبێت بە موڵکی.»","poem":2}]},{"type":"heading","content":["ژیاندنەوەی دڵشکێنراوەکان"]},{"type":"verse","number":14,"content":["یەزدان دەفەرموێت:",{"text":"«ڕێگاکە بنیاد بنێنەوە، بنیادی بنێنەوە و ئامادەی بکەن!","poem":1},{"text":"کۆسپ لە ڕێگای گەلەکەم هەڵبگرن.»","poem":2}]},{"type":"verse","number":15,"content":[{"text":"خودای بەرز و بڵند کە بە نەمری نیشتەجێیە،","poem":1},{"text":"ناوی پیرۆزە، ئەمە دەفەرموێت:","poem":2},{"text":"«لە جێی بەرز و پیرۆز نیشتەجێم،","poem":1},{"text":"هەروەها لەگەڵ ئەوانەدام","poem":2},{"text":"کە دڵشکێنراون و بێفیزن،","poem":1},{"text":"بۆ ئەوەی بێفیز و دڵشکێنراوەکان بژیێنمەوە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"هەتاسەر کێشمەکێش ناکەم و","poem":1},{"text":"هەتا کۆتایی تووڕە نابم،","poem":2},{"text":"چونکە ڕۆح لەبەردەمم گرژ دەبێت،","poem":1},{"text":"هەناسەی مرۆڤ کە من دروستم کردووە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لەبەر تاوانی چاوچنۆکییەکەی تووڕە بووم،","poem":1},{"text":"لێم دا، لە تووڕەییدا ڕوخساری خۆمم شاردەوە،","poem":2},{"lineBreak":true},{"text":"بەڵام هەر بە ڕێگای دڵی خۆی بەردەوام بوو لە یاخیبوون.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ڕێگاکانی ئەوم بینی بەڵام چاکی دەکەمەوە،","poem":1},{"text":"ڕێنمایی دەکەم و دڵی خۆی و شیوەنگێڕەکانیشی دەدەمەوە،","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"وا دەکەم بەرهەمی لێوەکانیان سوپاسگوزاری بێت.","poem":2},{"text":"ئاشتی! ئاشتی بۆ دوور و بۆ نزیک،","poem":1},{"text":"چاکیشی دەکەمەوە،»","poem":2},{"text":"یەزدان دەفەرموێت.","poem":4}]},{"type":"verse","number":20,"content":[{"text":"بەڵام بەدکاران وەک دەریای هەڵچوون","poem":1},{"text":"کە ناتوانێت ئارام بێتەوە،","poem":2},{"lineBreak":true},{"text":"ئاوەکانی لیتە و قوڕاو فڕێدەدات.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"خودام دەفەرموێت: «ئاشتی بۆ بەدکاران نییە.»","poem":1}]}],"footnotes":[{"noteId":81,"caller":"+","text":"خوداوەندێکی کەنعانییە بتپەرستەکان بووە، بۆ پەرستنی هەستاون بە تێپەڕاندنی منداڵەکانیان بەناو ئاگردا. بڕوانە دووەم پوختەی مێژوو 28‏:3‏.‏","reference":{"chapter":57,"verse":9}}]},"thisChapterLink":"/api/ckb_bib/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}