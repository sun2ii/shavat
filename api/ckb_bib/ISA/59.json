{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["گوناه، دانپێدانان و کڕینەوە"]},{"type":"verse","number":1,"content":[{"text":"بێگومان یەزدان بێ دەسەڵات نییە بۆ ڕزگارکردن،","poem":1},{"text":"گوێشی گران نییە بۆ بیستن،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بەڵکو تاوانەکانتان بوون بە بەربەست","poem":1},{"text":"لەنێوان ئێوە و خوداتان،","poem":2},{"text":"گوناهەکانتان بەم جۆرەی کرد ڕووی خودای لێ شاردنەوە","poem":1},{"text":"تاکو گوێتان لێ نەگرێت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لەبەر ئەوەی لەپی دەستتان بە خوێن گڵاو بوو و","poem":1},{"text":"پەنجەکانیشتان بە تاوان،","poem":2},{"text":"لێوەکانتان بە درۆ دوان و","poem":1},{"text":"زمانیشتان ناڕەوایی دەگوتەوە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"کەس نییە بە ڕاستودروستی بچێتە دادگا و","poem":1},{"text":"کەس نییە بە ڕاستگۆیی سکاڵا بکات.","poem":2},{"text":"پشت بە شتی پووچ دەبەستن و بە درۆ دەدوێن.","poem":1},{"text":"بە ئاژاوە دووگیان دەبن و خراپەیان لێ دەبێت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"هێلکەی ماریان هەڵهێنا،","poem":1},{"text":"تۆڕی جاڵجاڵۆکە دەچنن.","poem":2},{"text":"ئەوەی هێلکەیان دەخوات دەمرێت،","poem":1},{"text":"ئەوانەش کە دەشکێن مار هەڵدێنن.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"تەونەکانیان نابێتە بەرگ و","poem":1},{"text":"خۆیان بە کردارەکانیان ناپۆشن،","poem":2},{"text":"کردارەکانیان کرداری خراپەن و","poem":1},{"text":"کردەوەی دەستیان ستەمە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"پێیەکانیان بەرەو خراپە ڕادەکەن،","poem":1},{"text":"پەلە دەکەن بۆ ڕشتنی خوێنی بێتاوان.","poem":2},{"text":"بیرکردنەوەیان بیرکردنەوەی خراپەیە،","poem":1},{"text":"وێرانی و تێکشکاندن لە ڕێگاکانیان هەیە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ڕێگای ئاشتی پێنازانن،","poem":1},{"text":"دادپەروەری نییە لە ڕێچکەکانیان.","poem":2},{"text":"ڕێڕەوەکانی خۆیان خوار کرد،","poem":1},{"text":"هەموو ئەو کەسانەی پێیدا دەڕۆن ئاشتی نازانن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"لەبەر ئەمە دادپەروەری لێمان دوور کەوتەوە و","poem":1},{"text":"ڕاستودروستی پێمان ناگات.","poem":2},{"text":"چاوەڕێی ڕووناکی دەکەین و ئەوەتا تاریکی دێت،","poem":1},{"text":"بە هیواین ڕۆشنایی بێت،","poem":2},{"lineBreak":true},{"text":"بەڵام بە تاریکی ئەنگوستەچاودا دەڕۆین.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"وەک کوێر دەست لە دیوار دەدەین،","poem":1},{"text":"وەک یەکێک دوو چاوی نەبێت دەست دەکوتین.","poem":2},{"text":"لە نیوەڕۆدا هەروەک کاتی تاریک و ڕوونی پەل دەکوتین،","poem":1},{"text":"لەنێو چالاکەکان وەک مردوو واین.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"هەموومان وەک ورچ دەبۆڕێنین،","poem":1},{"text":"وەک کۆتر دەگمێنین،","poem":2},{"text":"چاوەڕێی دادپەروەری دەکەین و نییە،","poem":1},{"text":"بە هیوای ڕزگارین،","poem":2},{"lineBreak":true},{"text":"بەڵام لێمان دوور دەکەوێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"بێگومان یاخیبوونەکانمان لە بەرامبەر تۆدا زۆر بوون،","poem":1},{"text":"گوناهەکانمان شایەتیمان لەسەر دەدەن.","poem":2},{"text":"یاخیبوونەکانمان پێمانەوە لکاون،","poem":1},{"text":"دان بە تاوانەکانی خۆماندا دەنێین:","poem":2}]},{"type":"verse","number":13,"content":[{"text":"یاخیبوون و ناپاکی لە دژی یەزدان،","poem":1},{"text":"لادان لە ڕێگای خودای خۆمان،","poem":2},{"text":"هاندان بۆ ستەم و هەڵگەڕانەوە،","poem":1},{"text":"دروستکردنی درۆ لە دڵەوە و بە ساختە قسەکردن.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"دادپەروەری هەڵدەدرێتە دواوە و","poem":1},{"text":"ڕاستودروستی پشتگوێ دەخرێت.","poem":2},{"text":"ڕاستی لە گۆڕەپانی شاردا کەوتووە و","poem":1},{"text":"ڕێگا نادرێت ڕاستگۆیی بێتە ژوورەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ڕاستی ون بووە و","poem":1},{"text":"ئەوەی لە خراپە لادەدات دەبێت بە نێچیر.","poem":2},{"lineBreak":true},{"text":"یەزدان بینی و لەبەرچاوی خراپ بوو","poem":1},{"text":"کە دادپەروەری نەبوو.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بینی کەس نەبوو،","poem":1},{"text":"سەرسام بوو کە ناوبژیوان نەبوو.","poem":2},{"text":"بە هێزی بازووی خۆی ڕزگاری کردین،","poem":1},{"text":"ڕاستودروستی خۆی پاڵپشتی کرد.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ڕاستودروستی وەک زرێ","poem":1},{"noteId":82},{"text":"لەبەرکرد و","poem":1},{"text":"کڵاوی ئاسنینی ڕزگاریش لەسەری،","poem":2},{"text":"بەرگی تۆڵەسەندنەوەی لەبەرکرد،","poem":1},{"text":"دڵگەرمیشی وەک کەوا لە خۆی پێچا.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بەگوێرەی کردەوەکان لە ناحەزانی تووڕە دەبێت،","poem":1},{"text":"سزای ڕەوای دوژمنانی دەدات،","poem":2},{"lineBreak":true},{"text":"بە تەواوی سزای دوورگەکانیش دەدات.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"خەڵکی ڕۆژئاوا لە ناوی یەزدان دەترسن،","poem":1},{"text":"خەڵکی ڕۆژهەڵات لە شکۆمەندییەکەی،","poem":2},{"text":"چونکە یەزدان وەک لافاو دێت،","poem":1},{"text":"بە هەناسەی خۆی پاڵی پێوە دەنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«ئەوەی دەمانکڕێتەوە دێت بۆ سییۆن،","poem":1},{"text":"بۆ لای ئەوانە لە نەوەی یاقوب کە لە گوناهەکانیان تۆبەیان کرد.»","poem":2},{"text":"ئەمە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":21,"content":["یەزدان دەفەرموێت: «ئەمەش پەیمانی منە لەگەڵ ئەوان: ڕۆحم لەگەڵتدایە و وتەکانی خۆمم خستووەتە دەمی تۆوە، نە لە دەمی خۆت و نە لە دەمی نەوەت و نە لە دەمی نەوەی دوای نەوەت نابڕێنەوە، لە ئێستاوە و هەتاهەتایە،»",{"text":"یەزدان دەفەرموێت.","poem":4}]}],"footnotes":[{"noteId":82,"caller":"+","text":"جلێکی ئاسنینە بۆ پاراستنی سنگی سەرباز لە کاتی جەنگدا. بڕوانە ئەفەسۆس 6‏:14‏‏.‏","reference":{"chapter":59,"verse":17}}]},"thisChapterLink":"/api/ckb_bib/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}