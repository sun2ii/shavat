{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["شکۆمەندی سییۆن"]},{"type":"verse","number":1,"content":[{"text":"«ئەی ئۆرشەلیم هەستە! پڕشنگ بدەوە، چونکە ڕووناکییت هات،","poem":1},{"text":"شکۆمەندی یەزدانیش بەسەرتدا گزنگی داوە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەوەتا تاریکی زەوی داپۆشیوە و","poem":1},{"text":"هەوری تاریش نەتەوەکان.","poem":2},{"text":"بەڵام یەزدان بەسەر تۆدا گزنگ دەدات،","poem":1},{"text":"شکۆمەندییەکەشی بەسەرتەوە دەبینرێت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"نەتەوەکان بەرەو ڕووناکی تۆ دێن،","poem":1},{"text":"پاشاکانیش بەرەو گزنگی ڕووناکییت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«چاو هەڵبڕە بۆ دەوروبەری خۆت و تەماشا بکە!","poem":1},{"text":"هەموو کۆبوونەوە و بۆ لای تۆ هاتن،","poem":2},{"text":"کوڕەکانت لە دوورەوە دێن و","poem":1},{"text":"کچەکانیشت لە ئامێز دەگرن.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئینجا تەماشا دەکەیت و ڕووناکییت لێ دەبارێت،","poem":1},{"text":"لە خۆشیدا دڵت دادەخورپێت،","poem":2},{"text":"چونکە سامانی دەریا بۆ تۆ دەگوازرێتەوە،","poem":1},{"text":"دەوڵەمەندی نەتەوەکان بۆ لای تۆ دێت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ڕەوە وشتر زەویت دادەپۆشێت،","poem":1},{"text":"وشترەکانی میدیان و عێفا.","poem":2},{"text":"هەموو لە شەباوە دێن،","poem":1},{"text":"زێڕ و بخووریان بارکردووە،","poem":2},{"lineBreak":true},{"text":"ستایشی یەزدان ڕادەگەیەنن.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"هەموو مەڕی قێدار بۆ تۆ کۆدەکرێتەوە،","poem":1},{"text":"بەرانەکانی نەبایۆت لەژێر دەستتدان،","poem":2},{"text":"بە پەسەندییەوە سەردەخرێنە سەر قوربانگاکەم و","poem":1},{"text":"پەرستگای شکۆمەندیم شکۆمەند دەکەم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ئەوانە کێن وەک هەور دەفڕن و","poem":1},{"text":"وەک کۆتر بەرەو ماڵەکانیان؟","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بێگومان دوورگەکان چاوەڕوانی منن،","poem":1},{"text":"هەروەها کەشتییەکانی تەرشیش لەپێشەوەن","poem":2},{"text":"بۆ هێنانی کوڕەکانت لە دوورەوە،","poem":1},{"text":"زێڕ و زیوەکانیشیان لەگەڵیاندایە","poem":2},{"text":"بۆ ناوی یەزدانی پەروەردگارت،","poem":1},{"text":"خودا پیرۆزەکەی ئیسرائیل","poem":2},{"lineBreak":true},{"text":"کە شکۆداری کردیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«نەوەی بێگانە شووراکانت بنیاد دەنێنەوە،","poem":1},{"text":"پاشاکانیان خزمەتت دەکەن.","poem":2},{"text":"هەرچەندە لە کاتی تووڕەییمدا لێم دایت،","poem":1},{"text":"بەڵام لە کاتی ڕەزامەندیمدا بەزەییم پێتدا دێتەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"دەروازەکانت هەمیشە واڵا دەبن،","poem":1},{"text":"شەو و ڕۆژ داناخرێن","poem":2},{"text":"بۆ هێنانی سامانی نەتەوەکان بۆت و","poem":1},{"text":"پاشاکانیشیان بە پێش دەدرێن،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"چونکە ئەو نەتەوە و شانشینەی خزمەتت نەکات لەناودەچێت و","poem":1},{"lineBreak":true},{"text":"بە تەواوی وێران دەبێت.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«شانازی لوبنان بۆ تۆ دێت،","poem":1},{"text":"داری سنەوبەر، کاژ و سەروو پێکەوە،","poem":2},{"text":"بۆ ڕازاندنەوەی جێی پیرۆزگاکەم و","poem":1},{"text":"شوێنی پێیەکانم شکۆدار دەکەم.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"کوڕی ئەوانەی تۆیان زەلیل کرد بە کڕنۆشەوە دێن بۆ لات،","poem":1},{"text":"هەموو ئەوانەی سووکایەتییان پێ دەکردیت کڕنۆش بۆ بنی پێت دەبەن و","poem":2},{"text":"پێت دەڵێن: شاری یەزدان،","poem":1},{"text":"سییۆنی خودا پیرۆزەکەی ئیسرائیل.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«لە جێی ئەوەی بەجێماو و ڕق لێبوو و","poem":1},{"text":"بێ ڕێبوار بیت،","poem":2},{"text":"دەتکەمە شانازی هەتاهەتایی،","poem":1},{"text":"شادی نەوە دوای نەوە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"لە شیری نەتەوەکان دەخۆیت،","poem":1},{"text":"لە مەمکی شاهانە شیر دەخۆیت.","poem":2},{"text":"جا دەزانیت کە منی یەزدان، ڕزگارکەری تۆم،","poem":1},{"text":"ئەوەی تۆ دەکڕێتەوە توانادارەکەی یاقوبە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لە جیاتی بڕۆنز زێڕ و","poem":1},{"text":"لە جیاتی ئاسنیش زیو دەهێنم،","poem":2},{"text":"لە جیاتی داریش بڕۆنز و","poem":1},{"text":"لە جیاتی بەردیش ئاسن دەهێنم.","poem":2},{"text":"سەلامەتی دەکەمە سەرپەرشتیارت و","poem":1},{"text":"ڕاستودروستی دەکەمە سەرکارت.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئیتر نە ستەم لە خاکەکەتدا دەبیسترێت","poem":1},{"text":"نە وێرانی و شکانیش لە سنوورەکانت،","poem":2},{"text":"بەڵکو شووراکانت ناو لێ دەنێیت: ”ڕزگاری“ و","poem":1},{"text":"دەروازەکانیشت ”ستایش“.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئیتر خۆر بۆت نابێتە ڕووناکی ڕۆژ،","poem":1},{"text":"درەوشانەوەی مانگیش نابێتە سەرچاوەی ڕووناکی تۆ،","poem":2},{"text":"بەڵکو یەزدان بۆت دەبێت بە ڕووناکی هەتاهەتایی،","poem":1},{"text":"خوداشت دەبێتە شکۆمەندیت.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"لەمەودوا خۆری تۆ ئاوا نابێت،","poem":1},{"text":"مانگی تۆ کەم ناکات،","poem":2},{"text":"چونکە یەزدان بۆت دەبێت بە ڕووناکی هەتاهەتایی،","poem":1},{"text":"ڕۆژانی ماتەمینیت تەواو دەبێت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لەو کاتەدا گەلەکەت هەمووی ڕاستودروست دەبن،","poem":1},{"text":"زەویش بۆ هەتاهەتایە موڵکی خۆیان دەبێت.","poem":2},{"text":"ئەوەی من ناشتوومن نەمامن،","poem":1},{"text":"دەستکردی منن بۆ شکۆمەندبوونم.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بچووک دەبێت بە هەزار و","poem":1},{"text":"بچووکترین بە نەتەوەیەکی مەزن.","poem":2},{"text":"من یەزدانم،","poem":1},{"text":"لە کاتی خۆیدا پەلەی لێ دەکەم.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}