{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["ساڵی ڕەزامەندی یەزدان"]},{"type":"verse","number":1,"content":[{"text":"ڕۆحی یەزدانی باڵادەست بەهێزم دەکات،","poem":1},{"text":"چونکە یەزدان دەستنیشانی کردووم","poem":2},{"lineBreak":true},{"text":"بۆ مژدەدان بە هەژاران.","poem":2},{"text":"منی ناردووە بۆ تیمارکردنی دڵشکاوەکان،","poem":1},{"text":"بۆ جاڕدانی ئازادی بۆ ڕاپێچکراوەکان و","poem":2},{"lineBreak":true},{"text":"ئازادکردنی کۆیلەکان،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بۆ ڕاگەیاندنی ساڵی ڕەزامەندیی یەزدان و","poem":1},{"text":"ڕۆژی تۆڵەسەندنەوەی خودامان،","poem":2},{"text":"بۆ دڵنەواییکردنی هەموو ماتەمدارەکان.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"ناردوومی بۆ ئەوەی بە پرسەدارەکانی سییۆن ببەخشم،","poem":2},{"text":"تاجێکی جوانیان لەسەر بنێم لە جێی قوڕ","poem":1},{"noteId":83},{"text":"،","poem":1},{"text":"زەیتی دڵخۆشی لە جێی پرسە،","poem":2},{"text":"هەروەها بەرگی ستایش لە جێی ڕۆحی ورەبەردان.","poem":1},{"text":"جا پێیان دەگوترێت دار بەڕووی ڕاستودروستی،","poem":2},{"lineBreak":true},{"text":"نەمامی یەزدان بۆ دەرخستنی شکۆمەندییەکەی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"کەلاوە کۆنەکان بنیاد دەنێنەوە و","poem":1},{"text":"وێرانکراوەکانی پێشتر هەڵدەستێننەوە.","poem":2},{"text":"شارە خاپوورەکان نۆژەن دەکەنەوە","poem":1},{"text":"کە لە چەرخەکانی پێشووەوە وێران کرابوون.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بێگانە دێنە خزمەتتان و شوانایەتی مێگەلەکانتان دەکەن و","poem":1},{"text":"کوڕانی نامۆکان دەبنە جوتیار و ڕەزەوانتان.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئێوەش ناوتان لێ دەنرێت، کاهینەکانی یەزدان،","poem":1},{"text":"پێتان دەگوترێت، خزمەتکارەکانی خودامان.","poem":2},{"text":"سامانی نەتەوەکان دەخۆن و","poem":1},{"text":"شانازی بەسەر شکۆمەندی ئەوانەوە دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"گەلەکەم لە جێی ڕیسوایی، دوو ئەوەندە میراتی وەردەگرن،","poem":1},{"text":"لە جێی شەرمەزاربوون، بە بەشی خۆیان دڵخۆش دەبن.","poem":2},{"text":"ئیتر لە خاکەکەیان دوو هێندە میرات وەردەگرن،","poem":1},{"text":"خۆشی هەتاهەتاییان بۆ دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«من کە یەزدانم، دادپەروەریم خۆشدەوێت،","poem":1},{"text":"ڕقم لە دزی و بەدکارییە پێکەوە.","poem":2},{"text":"بە دڵسۆزییەوە پاداشتی گەلەکەم دەدەمەوە و","poem":1},{"text":"پەیمانێکی هەتاهەتاییان لەگەڵدا دەبەستم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"توخمیان لەنێو نەتەوەکان دەناسرێن و","poem":1},{"text":"وەچەشیان لەنێو گەلاندا.","poem":2},{"text":"هەموو ئەوانەی دەیانبینن دانی پێدا دەنێن","poem":1},{"text":"کە ئەوان گەلێکن یەزدان بەرەکەتداری کردوون.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"بە شادی دڵشاد دەبم بە یەزدان،","poem":1},{"text":"گیانم بە خودای خۆم شادمان دەبێت،","poem":2},{"text":"چونکە بەرگی ڕزگاری لەبەرکردم،","poem":1},{"text":"کەوای ڕاستودروستی بەسەر شانمدا دا،","poem":2},{"text":"وەک زاوایەک کە سەری خۆی لەسەر شێوەی کاهین بڕازێنێتەوە","poem":1},{"text":"یان بووکێک بە خشڵ خۆی جوان بکات.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"وەک زەوی کە چەکەرەی ڕووەکی خۆی دەردەخات و","poem":1},{"text":"وەک باخچە کە چێنراوەکانی دەڕوێنێت،","poem":2},{"text":"ئاواش یەزدانی باڵادەست ڕاستودروستی و ستایش","poem":1},{"text":"لەبەردەم هەموو نەتەوەکان دەڕوێنێت.","poem":2}]}],"footnotes":[{"noteId":83,"caller":"+","text":"عیبری: خۆڵەمێش.‏","reference":{"chapter":61,"verse":3}}]},"thisChapterLink":"/api/ckb_bib/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}