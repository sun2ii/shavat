{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["سییۆن ناوێکی نوێی هەیە"]},{"type":"verse","number":1,"content":[{"text":"لە پێناوی سییۆن بێدەنگ نابم و","poem":1},{"text":"لە پێناوی ئۆرشەلیم هێمن نابم","poem":2},{"text":"هەتا بێتاوانییەکەی وەک گزنگی خۆر دەدرەوشێتەوە و","poem":1},{"text":"ڕزگاریشی وەک مەشخەڵ داگیرسێت.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەو کاتە هەموو نەتەوەکان بێتاوانییەکەت دەبینن،","poem":1},{"text":"هەموو پاشاکانیش شکۆمەندییەکەت.","poem":2},{"text":"ناوێکی نوێت لێ دەنرێت","poem":1},{"text":"کە دەمی یەزدان دیاری دەکات.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"دەبیت بە تاجی جوانی لە دەست یەزدان و","poem":1},{"text":"تاجەگوڵینە لەناو لەپی خودات.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"چیتر ناوت نانرێت «بەجێماو» و","poem":1},{"text":"چیتر بە خاکەکەت ناگوترێت «وێرانە»،","poem":2},{"text":"بەڵکو پێت دەگوترێت «حەفچیڤا","poem":1},{"noteId":84},{"text":"»،","poem":1},{"text":"خاکەکەشت، «بەعولە","poem":2},{"noteId":85},{"text":"»،","poem":2},{"text":"چونکە یەزدان بە تۆ دڵخۆش دەبێت،","poem":1},{"text":"خاکەکەشت مێردی دەبێت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"وەک چۆن گەنج دەبێت بە مێردی کچێکی پاکیزە،","poem":1},{"text":"ئاواش کوڕەکانت دەبن بە مێردت.","poem":2},{"text":"وەک دڵخۆشی زاوا بە بووک،","poem":1},{"text":"ئاواش خودات بە تۆ دڵخۆش دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ئەی ئۆرشەلیم، ئێشکگرم لەسەر شووراکانت داناوە،","poem":1},{"text":"بەردەوام شەو و ڕۆژ بێدەنگ نابن.","poem":2},{"text":"ئەی ئەوانەی یەزدانتان لە یادە،","poem":1},{"text":"ئۆقرە مەگرن،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لێ مەگەڕێن یەزدان ئۆقرە بگرێت هەتا ئۆرشەلیم دەچەسپێنێت و","poem":1},{"text":"ناوداری دەکات لە زەویدا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"یەزدان بە دەستی ڕاستی خۆی و","poem":1},{"text":"بە هێزی بازووی سوێندی خوارد:","poem":2},{"text":"«چیتر دانەوێڵەکەت","poem":1},{"text":"ناکەم بە خۆراک بۆ دوژمنەکانت و","poem":2},{"text":"شەرابە نوێیەکەشت کە پێوەی ماندوو بوویت،","poem":1},{"text":"نامۆکان نایخۆنەوە،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بەڵکو ئەوانە دەیخۆن کە گەنمیان بەرهەم هێناوە و","poem":1},{"text":"ستایشی یەزدان دەکەن،","poem":2},{"text":"ئەوانەی ترێیان ڕنیوەتەوە","poem":1},{"text":"لە حەوشەی پیرۆزگاکەم دەیخۆنەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"تێپەڕ بن! تێپەڕ بن لە دەروازەکانەوە!","poem":1},{"text":"ڕێگای گەل خۆش بکەن.","poem":2},{"text":"ئامادەی بکەن! ڕێڕەو ئامادە بکەن!","poem":1},{"text":"لە بەرد پاکی بکەنەوە.","poem":2},{"text":"ئاڵا بۆ گەل بەرز بکەنەوە.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ئەوەتا یەزدان","poem":1},{"text":"بە هەر چوار لای زەویدا ڕایگەیاندووە:","poem":2},{"text":"«بە شاری سییۆن بڵێن،","poem":1},{"text":"”وا ڕزگارکەرەکەت دێت!","poem":2},{"text":"وا پاداشتەکەی لەگەڵیەتی و","poem":1},{"text":"خەڵاتەکەی لەبەردەمییەتی.“»","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ناویان لێ دەنێن، «گەلە پیرۆزەکە»،","poem":1},{"text":"«ئەوانەی یەزدان کڕیونیەتیەوە»،","poem":2},{"text":"تۆش ناوت لێ دەنرێت، «داواکراوەکە»،","poem":1},{"text":"«شارە بەجێنەماوەکە».","poem":2}]}],"footnotes":[{"noteId":84,"caller":"+","text":"واتا (شادیم لە ئەودایە).‏","reference":{"chapter":62,"verse":4}},{"noteId":85,"caller":"+","text":"واتا بە مێرد.‏","reference":{"chapter":62,"verse":4}}]},"thisChapterLink":"/api/ckb_bib/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}