{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"heading","content":["ڕۆژی خودا بۆ تۆڵەسەندن و ڕزگاری"]},{"type":"verse","number":1,"content":[{"text":"ئەوە کێیە لە ئەدۆمەوە دێت","poem":1},{"text":"بە بەرگی سوور لە بۆزراوە،","poem":2},{"text":"ئەو شکۆمەندەی بە جلوبەرگەکەیەوە","poem":1},{"text":"بە زۆری هێزەکەیەوە نمایش دەکات؟","poem":2},{"lineBreak":true},{"text":"«منم، بە ڕاستودروستی دەدوێم","poem":1},{"text":"مەزنم بۆ ڕزگاری.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"بۆچی بەرگت سوورە و","poem":1},{"text":"بەرگت وەک پەستێنەری گوشەری ترێیە؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«کەس لە گەلان لەگەڵمدا نەبوو","poem":1},{"text":"بە تەنها گوشەرم پەستەوە.","poem":2},{"text":"لە تووڕەییدا ئەوانم پڵیشاندەوە،","poem":1},{"text":"بە هەڵچوونی خۆم پێم لێنان.","poem":2},{"text":"جا خوێنیان بەسەر بەرگمدا پرژا و","poem":1},{"text":"هەموو جلەکەم لەکەدار بوو.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ڕۆژی تۆڵەسەندنەوە لە دڵمدا بوو و","poem":1},{"text":"ساڵی کڕینەوەی گەلم هات.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"تەماشام کرد بەڵام یارمەتیدەر نەبوو،","poem":1},{"text":"سەرسام بووم کە پشتگیری نەبوو،","poem":2},{"text":"بەڵام بە هێزی بازووی خۆم ڕزگاریم دەستەبەر کرد،","poem":1},{"text":"هەڵچوونم پشتگیری کردم.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بە تووڕەیی خۆم گەلانم پەستەوە،","poem":1},{"text":"بە هەڵچوونی خۆم سەرخۆشم کردن،","poem":2},{"lineBreak":true},{"text":"خوێنی ئەوانم بەسەر زەویدا ڕشت.»","poem":2}]},{"type":"heading","content":["نوێژ و ستایش"]},{"type":"verse","number":7,"content":[{"text":"باسی خۆشەویستی نەگۆڕی یەزدان دەکەم،","poem":1},{"text":"کارەکانی کە شایستەی ستایشن،","poem":2},{"lineBreak":true},{"text":"بۆ هەموو ئەوەی کە لە پێناوی ئێمەدا کردی.","poem":2},{"lineBreak":true},{"text":"باسی چاکە مەزنەکەی دەکەم بۆ بنەماڵەی ئیسرائیل،","poem":2},{"text":"ئەوەی پاداشتی پێدانەوە بەپێی بەزەییەکەی و","poem":1},{"text":"بەپێی زۆری خۆشەویستییە بێ سنوورەکەی.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"فەرمووی: «بە ڕاستی گەلی منن،","poem":1},{"text":"کوڕن، ناپاکیم لەگەڵ ناکەن،»","poem":2},{"lineBreak":true},{"text":"جا بۆیان بوو بە ڕزگارکەر.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"لە هەموو تەنگانەکانیان ئەویش تەنگاو بوو و","poem":1},{"text":"فریشتەی ئامادەبوونەکەی","poem":2},{"noteId":86},{"text":"ڕزگاری کردن.","poem":2},{"text":"ئەو بە خۆشەویستییەکەی و بە میهرەبانی ئەوانی کڕییەوە،","poem":1},{"text":"بەرزی کردنەوە و هەڵیگرتن","poem":2},{"lineBreak":true},{"text":"هەموو ڕۆژانی کۆن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بەڵام ئەوان یاخی بوون و","poem":1},{"text":"ڕۆحی پیرۆزی ئەویان خەمبار کرد،","poem":2},{"text":"جا لێیان بوو بە دوژمن و","poem":1},{"text":"لەگەڵیان کەوتە جەنگەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ئینجا گەل ڕۆژانی کۆنیان بەبیر هاتەوە،","poem":1},{"text":"ڕۆژانی موسا و گەلەکەی.","poem":2},{"text":"کوا ئەوەی لە دەریاوە سەری خستن","poem":1},{"text":"لەگەڵ شوانی مێگەلەکەی؟","poem":2},{"text":"کوا ئەوەی ڕۆحی پیرۆزی خۆی","poem":1},{"text":"لەنێویان دانا؟","poem":2}]},{"type":"verse","number":12,"content":[{"text":"کوا ئەوەی لەلای دەستی ڕاستی موسا","poem":1},{"text":"هێزە شکۆدارەکەی بازووی خۆی نارد،","poem":2},{"text":"ئەوەی ئاوی لەبەردەمیان دوو لەت کرد،","poem":1},{"text":"بۆ ئەوەی ناوێکی هەتاهەتایی بۆ خۆی دروستبکات،","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەوەی بەناو دەریا قووڵەکاندا بردنی؟","poem":1},{"text":"وەک ئەسپ بە چۆڵەوانیدا سەرسمیان نەدا،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"وەک دابەزینی ڕەشەوڵاخ بەرەو دەشتایی،","poem":1},{"text":"ڕۆحی یەزدان پشووی پێدان.","poem":2},{"text":"ئاوا ڕێنمایی گەلەکەتت کرد","poem":1},{"text":"بۆ ئەوەی ناوێکی شکۆمەند بۆ خۆت دروستبکەیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"لە ئاسمانەوە تەماشا بکە،","poem":1},{"text":"لە نشینگەی پیرۆز و شکۆمەندیتەوە ببینە،","poem":2},{"text":"کوا دڵگەرمی و پاڵەوانیێتییەکەت؟","poem":1},{"text":"ئاخ هەڵکێشانی هەناوت و بەزەییت لە ئێمە بڕی.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بەڵام تۆ باوکی ئێمەی،","poem":1},{"text":"ئەگەر ئیبراهیم نەمانناسێت و","poem":2},{"lineBreak":true},{"text":"ئیسرائیلیش دانمان پێدا نەنێت.","poem":2},{"text":"ئەی یەزدان تۆ باوکی ئێمەیت،","poem":1},{"text":"لە ئەزەلەوە ناوت دەمانکڕێتەوە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئەی یەزدان، بۆچی لە ڕێگاکانی خۆت وێڵت کردین،","poem":1},{"text":"بۆچی دڵت ڕەق کردین هەتا لێت نەترسین؟","poem":2},{"text":"بگەڕێوە لە پێناو خزمەتکارەکانت،","poem":1},{"text":"هۆزەکانی میراتەکەت.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بۆ ماوەیەکی کەم گەلی پیرۆزت خاوەنی پیرۆزگای تۆ بوون،","poem":1},{"text":"بەڵام ئێستا دوژمنانمان پێشێلیان کرد.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئێمە لە کۆنەوە گەلی تۆین،","poem":1},{"text":"ئێستا وامان لێ هاتووە کە تۆ فەرمانڕەوایی ئێمەت نەکردووە،","poem":2},{"lineBreak":true},{"text":"وەک چۆن هەرگیز بە ناوی تۆوە ناو نەنرابین.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":86,"caller":"+","text":"مەبەستی لە ئەو فریشتەیە کە هەمیشە ئامادەیە لەبەردەمی یەزدان بۆ ڕاپەڕاندنی کارەکانی.‏","reference":{"chapter":63,"verse":9}}]},"thisChapterLink":"/api/ckb_bib/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}