{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["دادوەری و ڕزگاری"]},{"type":"verse","number":1,"content":[{"text":"«من دەرکەوتم بۆ ئەوانەی کە داوای منیان نەکرد،","poem":1},{"text":"دۆزرامەوە لەلایەن ئەوانەی بەدوامدا نەگەڕان.","poem":2},{"text":"بە نەتەوەیەک کە بە ناوی منەوە نزا ناکەن،","poem":1},{"text":"فەرمووم: ”ئەوەتام! ئەوەتام!“","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بە درێژایی ڕۆژ دەستم","poem":1},{"text":"بۆ گەلێکی کەللەڕەق ڕاگرت،","poem":2},{"text":"بە ڕێگایەکدا دەڕۆن باش نییە،","poem":1},{"text":"بەدوای بیرکردنەوەی خۆیان دەکەون.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"گەلێک بەردەوام","poem":1},{"text":"بەرەو ڕووم پەستم دەکەن،","poem":2},{"text":"گەلێک لەناو باخچەکان قوربانی سەردەبڕێت،","poem":1},{"text":"لەسەر قوربانگا خشتەکان بخوور دەسووتێنێت،","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەوەی لەنێو گۆڕەکان دادەنیشێت،","poem":1},{"text":"لە گۆڕستانەکان شەو بەسەردەبات،","poem":2},{"text":"گۆشتی بەراز دەخوات و","poem":1},{"text":"لەناو قاپوقاچاغەکەی گۆشتاوی گڵاو هەیە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"دەڵێت: ”لە شوێنی خۆت ڕابوەستە، لێم نزیک مەکەوە،","poem":1},{"text":"چونکە من لە تۆ پیرۆزترم!“","poem":2},{"text":"ئەوانە دووکەڵن لە لووتی مندا،","poem":1},{"text":"ئاگرێکن کە بە درێژایی ڕۆژ داگیرساوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«ئەوەتا لەبەردەمم نووسراوە:","poem":1},{"text":"بێدەنگ نابم، بەڵکو بە تەواوی پاداشت دەدەمەوە،","poem":2},{"lineBreak":true},{"text":"سزای خۆیان دەخەمە بەردەستیان،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لەبەر تاوانەکانتان و تاوانی باوباپیرانتان پێکەوە،»","poem":1},{"text":"یەزدان دەفەرموێت.","poem":2},{"text":"«لەبەر ئەوەی ئەوانە لەسەر چیاکان قوربانییان سووتاند و","poem":1},{"text":"لەسەر گردەکان سووکایەتییان بە من کرد،","poem":2},{"text":"کردەوەکانی پێشوویان دەپێومەوە و","poem":1},{"text":"سزای خۆیان بەسەردا دەسەپێنم.»","poem":2}]},{"type":"verse","number":8,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«وەک ئەوەی لە هێشوودا شەرابی نوێ هەیە،","poem":1},{"text":"جا دەگوترێت: ”مەیفەوتێنە،","poem":2},{"lineBreak":true},{"text":"چونکە خێروبێری تێدایە،“","poem":2},{"text":"ئاوا دەکەم لە پێناوی بەندەکانم","poem":1},{"text":"بۆ ئەوەی هەمووان نەفەوتێنم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بەڵکو لە یاقوبەوە نەوەیەک دەردەکەم،","poem":1},{"text":"لە یەهوداشەوە ئەوانەی دەبنە میراتگری چیاکانم.","poem":2},{"text":"جا چیاکان دەبن بە میراتی هەڵبژێردراوانم و","poem":1},{"text":"بەندەکانم لەوێ نیشتەجێ دەبن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"جا شارۆن دەبێت بە لەوەڕگای مێگەل و","poem":1},{"text":"دۆڵی عاخۆریش","poem":2},{"noteId":87},{"text":"بە مۆڵگای مانگا،","poem":2},{"lineBreak":true},{"text":"بۆ گەلەکەم کە داوای منیان کردووە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«بەڵام ئێوە کە وازتان لە یەزدان هێناوە و","poem":1},{"text":"کێوی پیرۆزی منتان لەیاد کردووە،","poem":2},{"text":"خوانتان بۆ بتێک بە ناوی ”گەد“ خوداوەندی بەخت ئامادە کردووە و","poem":1},{"text":"بۆ ”مەنی“ خوداوەندی چارەنووس شەرابی تێکەڵاوتان پڕکردووە،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"چارەنووستان دەخەمە بەر شمشێر و","poem":1},{"text":"هەمووتان بۆ سەربڕین بە چۆکدا دێن،","poem":2},{"text":"لەبەر ئەوەی بانگم کرد و وەڵامتان نەدایەوە،","poem":1},{"text":"قسەم کرد و گوێتان نەگرت","poem":2},{"text":"بەڵکو لەبەرچاوم خراپەکاریتان کرد،","poem":1},{"text":"ئەوەی من پێم ناخۆش بوو هەڵتانبژارد.»","poem":2}]},{"type":"verse","number":13,"content":["لەبەر ئەوە یەزدانی باڵادەست ئەمە دەفەرموێت:",{"text":"«ئەوەتا بەندەکانم دەخۆن،","poem":1},{"text":"بەڵام ئێوە برسی دەبن،","poem":2},{"text":"ئەوەتا بەندەکانم دەخۆنەوە،","poem":1},{"text":"بەڵام ئێوە تینوو دەبن،","poem":2},{"text":"ئەوەتا بەندەکانم دڵخۆش دەبن،","poem":1},{"text":"بەڵام ئێوە شەرمەزار دەبن.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەوەتا لە دڵخۆشیدا","poem":1},{"text":"بەندەکانم گۆرانی دەڵێن،","poem":2},{"text":"بەڵام ئێوە لە دڵتەنگیدا دەقیژێنن و","poem":1},{"text":"لەبەر دڵشکاندن شین دەگێڕن.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"لە داهاتوودا هەڵبژێردراوانم ناوتان","poem":1},{"text":"وەک نەفرەت بەکاردەهێنن و","poem":2},{"text":"یەزدانی باڵادەست دەتانکوژێت،","poem":1},{"text":"بەڵام ناوێکی دیکە لە خزمەتکارەکانی خۆی دەنێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئەوەی لە خاکەکەدا بۆ خۆی داوای بەرەکەت بکات،","poem":1},{"text":"بە خودای ڕاستەقینەوە داوای بەرەکەت دەکات و","poem":2},{"text":"ئەوەی لە خاکەکەدا سوێند بخوات","poem":1},{"text":"بە خودای ڕاستەقینە سوێند دەخوات،","poem":2},{"text":"چونکە تەنگانەکانی پێشوو لەبیر چوون و","poem":1},{"text":"لەبەرچاوم شاردرانەوە.","poem":2}]},{"type":"heading","content":["ئاسمانی نوێ و زەوی نوێ"]},{"type":"verse","number":17,"content":[{"text":"«بڕوانن، من لە داهاتوودا ئاسمانی نوێ و","poem":1},{"text":"زەوی نوێ بەدی دەهێنم و","poem":2},{"text":"ئەوانەی پێشوو نە باس دەکرێن و","poem":1},{"text":"نە بە مێشکدا دێنەوە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بەڵکو ئێوە بۆ هەتاهەتایە دڵخۆش و شاد بن","poem":1},{"text":"لەوەی من بەدی دەهێنم،","poem":2},{"text":"چونکە ئەوەتا من ئۆرشەلیمی شاد بەدی دەهێنم و","poem":1},{"text":"دانیشتووانەکەی دڵخۆش دەبن.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بە ئۆرشەلیم دڵخۆش دەبم و","poem":1},{"text":"بە گەلی خۆم شاد دەبم،","poem":2},{"text":"چیتر لەناویدا دەنگی گریان و هاوار نابیسترێت.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«چیتر لەوێ نە کۆرپەی تازە لەدایکبوو دەمرێت و","poem":1},{"text":"نە پیری لە تەمەن تێر نەخواردوو،","poem":2},{"text":"چونکە ئەوەی لە تەمەنی سەد ساڵی بمرێت","poem":1},{"text":"بە گەنج دادەنرێت و","poem":2},{"text":"ئەوەی نەگات بە تەمەنی سەد ساڵی","poem":1},{"text":"وەک نەفرەت لێکراو دەبینرێت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"خانوو بنیاد دەنێن و نیشتەجێ دەبن،","poem":1},{"text":"ڕەز دەڕوێنن و لە بەرەکەی دەخۆن.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"خانوو بنیاد نانێن و یەکێکی دیکە تێیدا دانیشێت،","poem":1},{"text":"ڕەز ناڕوێنن و یەکێکی دیکە بیخوات،","poem":2},{"text":"چونکە ڕۆژانی گەلەکەم","poem":1},{"text":"وەک ڕۆژانی دار","poem":2},{"noteId":88},{"text":"دەبێت و","poem":2},{"text":"هەڵبژێردراوانم خۆشی دەبینن","poem":1},{"text":"لە کردارەکانی دەستیان.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"بەخۆڕایی ماندوو نابن و","poem":1},{"text":"بۆ تۆقاندن منداڵیان نابێت،","poem":2},{"text":"چونکە ئەوان نەوەی بەرەکەتپێدراوی یەزدانن و","poem":1},{"text":"وەچەکانیان لەگەڵیاندان.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"جا بەر لەوەی نزا بکەن من وەڵام دەدەمەوە و","poem":1},{"text":"هێشتا ئەوان قسە دەکەن من گوێم لێیان دەبێت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"گورگ و بەرخ پێکەوە دەلەوەڕێن،","poem":1},{"text":"شێریش وەک مانگا گیا دەخوات،","poem":2},{"lineBreak":true},{"text":"بەڵام نانی مار خۆڵە.","poem":2},{"text":"لە هەموو کێوی پیرۆزم","poem":1},{"text":"نە زیان دەبەخشن و نە دەفەوتێنن،»","poem":2},{"text":"یەزدان دەفەرموێت.","poem":4}]}],"footnotes":[{"noteId":87,"caller":"+","text":"عاخۆر‏ وشەیەکی عیبرییە بە واتای تێکدان. بڕوانە یەشوع 7‏:24‏‏.‏","reference":{"chapter":65,"verse":10}},{"noteId":88,"caller":"+","text":"مەبەست لەو دارانەیە کە تەمەنیان زۆر درێژە.‏","reference":{"chapter":65,"verse":22}}]},"thisChapterLink":"/api/ckb_bib/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}