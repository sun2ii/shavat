{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ISA","translationId":"ckb_bib","name":"ئیشایا","commonName":"ئیشایا","title":"ئیشایا","order":23,"numberOfChapters":66,"sha256":"4e1f2e62ce9c51edc9c49a9d60afc75ccb14b28bc8df3beb7b0dc612ec6322c6","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/ckb_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["بەڵام ئەوانەی لەژێر گوشار بوون لە تاریکی تەنگانەدا نامێنن، وەک سەردەمی پێشوو خاکی زەبولون و خاکی نەفتالی زەلیل کردەوە، سەردەمی کۆتایی ڕێز لە جەلیلی ناجولەکەکان دەگرێت، ئەوەی لە ڕێگای دەریایە، ئەوبەری ڕووباری ئوردون."]},{"type":"verse","number":2,"content":[{"text":"ئەو گەلەی لە تاریکیدا دەڕۆیشت،","poem":1},{"text":"ڕووناکییەکی گەورەی بینی،","poem":2},{"text":"دانیشتووان لە خاکی سێبەری مەرگ","poem":1},{"text":"ڕووناکی بەسەریاندا هەڵهات.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئەو نەتەوەیەت زۆر کرد و","poem":1},{"text":"خۆشییەکی گەورەت پێی بەخشی،","poem":2},{"text":"لەبەردەمت دڵخۆش بوو","poem":1},{"text":"وەک خۆشی کاتی دروێنە،","poem":2},{"text":"وەک ئەوانەی شاد دەبن","poem":1},{"text":"بە دابەشکردنی دەستکەوت.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لەبەر ئەوەی نیری بارگرانی ئەو و","poem":1},{"text":"داری پشتی ئەو و","poem":2},{"text":"کوتەکی بێگاری پێکردنی ئەوت","poem":1},{"text":"وەک ڕۆژی میدیان شکاند.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"هەموو پۆستاڵی جەنگاوەران لە گەرمەی شەڕدا و","poem":1},{"text":"بەرگی لەناو خوێن گەوزاو","poem":2},{"text":"بۆ سووتان دەبێت،","poem":1},{"text":"سووتەمەنییە بۆ ئاگر،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"چونکە کوڕێکمان دەبێت،","poem":1},{"text":"کوڕێکمان پێدەدرێت و","poem":2},{"lineBreak":true},{"text":"سەرکردایەتی دەکەوێتە سەرشانی.","poem":2},{"text":"ناوی لێ دەنرێت","poem":1},{"text":"سەرسوڕهێنەر و ڕاوێژکار، خودای بەتوانا،","poem":2},{"lineBreak":true},{"text":"باوکی هەتاهەتایی، میری ئاشتی.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"گەشەسەندنی سەرۆکایەتی و ئاشتییەکەی","poem":1},{"text":"بێ کۆتایی دەبێت.","poem":2},{"text":"لەسەر تەختی داود و بەسەر شانشینەکەی","poem":1},{"text":"پاشایەتی دەکات","poem":2},{"text":"بۆ چەسپاندنی و بەهێزکردنی،","poem":1},{"text":"بە دادپەروەری و بە ڕاستودروستی","poem":2},{"lineBreak":true},{"text":"لە ئێستاوە و هەتاهەتایە.","poem":2},{"text":"دڵگەرمی یەزدانی سوپاسالار ئەمە دەکات.","poem":1}]},{"type":"heading","content":["تووڕەیی یەزدان لە دژی ئیسرائیل"]},{"type":"verse","number":8,"content":[{"text":"پەروەردگار وشەیەکی لە دژی یاقوب نارد و","poem":1},{"text":"بەسەر ئیسرائیلدا کەوت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"گەل هەموو دەزانن،","poem":1},{"text":"ئەفرایم و دانیشتووانی سامیرە،","poem":2},{"text":"بە لووتبەرزی و","poem":1},{"text":"فیزی دڵەوە دەڵێن:","poem":2}]},{"type":"verse","number":10,"content":[{"text":"«خشت ڕووخا،","poem":1},{"text":"بەڵام بە بەردی تاشراو بنیاد دەنێینەوە؛","poem":2},{"text":"هەنجیرە کێوی بڕایەوە،","poem":1},{"text":"بەڵام داری ئورز لە شوێنی دادەنێین.»","poem":2}]},{"type":"verse","number":11,"content":[{"text":"یەزدان دوژمنانی ڕەچینی پاشای لێ هەڵدەستێنێت،","poem":1},{"text":"ناحەزانی جۆش دەدات.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئارامییەکان لە ڕۆژهەڵاتەوە و فەلەستییەکان لە ڕۆژئاواوە","poem":1},{"text":"پڕ بە دەم ئیسرائیل هەڵدەلووشن.","poem":2},{"lineBreak":true},{"text":"لەگەڵ هەموو ئەوەشدا تووڕەییەکەی دانەمرکایەوە،","poem":1},{"text":"هێشتا دەستی درێژکردووە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"گەل هێشتا نەگەڕایەوە لای لێدەرەکەی،","poem":1},{"text":"ڕوویان لە یەزدانی سوپاسالار نەکرد.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"یەزدان لە ئیسرائیل سەر و کلک دەبڕێت،","poem":1},{"text":"دار خورما و قامیش لە یەک ڕۆژدا،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"پیر و پیاوماقوڵ سەرەکەن،","poem":1},{"text":"ئەو پێغەمبەرانەی کە فێرکردنی درۆیین فێر دەکەن کلکەکەن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ڕابەرانی ئەم گەلە بوون بە چەواشەکار،","poem":1},{"text":"ئەوانەی ڕابەرایەتی دەکرێن سەریان لێ شێواوە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لەبەر ئەوە پەروەردگار دڵخۆش نابێت بە گەنجەکانیان،","poem":1},{"text":"بەزەیی نایەتەوە بە هەتیو و بێوەژنەکانیان،","poem":2},{"text":"چونکە هەموو خوانەناس و خراپەکارن،","poem":1},{"text":"هەموو دەمەکان بە گێلی دەدوێن.","poem":2},{"lineBreak":true},{"text":"لەگەڵ هەموو ئەوەشدا تووڕەییەکەی دانەمرکایەوە،","poem":1},{"text":"هێشتا دەستی درێژکردووە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"بێگومان بەدکاری وەک ئاگر دەسووتێت،","poem":1},{"text":"دڕکوداڵ دەخوات،","poem":2},{"text":"گڕ لە دەوەنی دارستان بەردەدات،","poem":1},{"text":"ستوونی دووکەڵ لوول دەخوات.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بە جۆشی تووڕەیی یەزدانی سوپاسالار","poem":1},{"text":"خاکەکە دەسووتێت،","poem":2},{"text":"گەلیش دەبێت بە سووتەمەنی ئاگر،","poem":1},{"text":"پیاو دڵی بە برای خۆی ناسووتێ.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"لای ڕاست لێ دەکاتەوە و","poem":1},{"text":"هەر برسییە،","poem":2},{"text":"لای چەپ دەخوات و","poem":1},{"text":"تێر نابێت.","poem":2},{"text":"پیاو گۆشتی قۆڵی خۆی دەخوات:","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"مەنەشە ئەفرایم دەخوات و ئەفرایمیش مەنەشە،","poem":1},{"text":"هەردووکیان پێکەوە لە دژی یەهودا هەڵدەگەڕێنەوە.","poem":2},{"lineBreak":true},{"text":"لەگەڵ هەموو ئەوەشدا تووڕەییەکەی دانەمرکایەوە،","poem":1},{"text":"هێشتا دەستی درێژکردووە.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}