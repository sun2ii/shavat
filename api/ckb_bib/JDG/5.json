{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JDG","translationId":"ckb_bib","name":"ڕابەران","commonName":"ڕابەران","title":"ڕابەران","order":7,"numberOfChapters":21,"sha256":"4557ca086be4c97c55268e865e29c353d6fb2763a1febba00c33af260fd9848e","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/ckb_bib/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["سروودی دەڤۆرا"]},{"type":"verse","number":1,"content":["ئینجا دەڤۆرا و باراکی کوڕی ئەبینۆعەم لەو ڕۆژەدا دەستیان بە گوتنی سروود کرد:"]},{"type":"verse","number":2,"content":[{"text":"«کاتێک پێشەواکان لە ئیسرائیل ڕابەرایەتی دەکەن،","poem":1},{"text":"کاتێک گەل خۆیان بەخت دەکەن،","poem":2},{"lineBreak":true},{"text":"ستایشی یەزدان بکەن!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«ئەی پاشایان، ببیستن! ئەی فەرمانڕەوایان، گوێ بگرن!","poem":1},{"text":"من بۆ یەزدان سروود دەڵێم،","poem":2},{"lineBreak":true},{"text":"مۆسیقا بۆ یەزدانی پەروەردگاری ئیسرائیل دەژەنم.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«ئەی یەزدان، بە هاتنەدەرەوەت لە سێعیر،","poem":1},{"text":"بە بەرەوپێشچوونت لە خاکی ئەدۆم،","poem":2},{"text":"زەوی لەرزی، ئاسمانیش دڵۆپەی کرد،","poem":1},{"text":"هەروەها هەورەکانیش ئاویان لێ باری.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"چیاکان هەرەسیان هێنا لە ڕووی یەزدانی پەروەردگاری شاخی سینا،","poem":1},{"text":"لە ڕووی یەزدانی پەروەردگاری ئیسرائیل.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«لە ماوەی ڕابەرایەتی شەمگەری کوڕی عەنات،","poem":1},{"text":"لە سەردەمی یاعێل ڕێگا سەرەکییەکان وازلێهێنران و","poem":2},{"lineBreak":true},{"text":"ڕێبوارەکان بە ڕێڕەوی خواروخێچدا ڕۆیشتن.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"گوندەکانی ئیسرائیل چۆڵ بوون،","poem":1},{"text":"چۆڵ بوون، هەتا من کە دەڤۆرام هەستام،","poem":2},{"lineBreak":true},{"text":"هەتا وەک دایکێک لە ئیسرائیل هەستام.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"کاتێک شەڕ گەیشتە دەروازەکان،","poem":1},{"text":"خودا ڕابەرە نوێیەکانی هەڵبژارد،","poem":2},{"text":"بەڵام هیچ قەڵغانێک یان ڕمێک","poem":1},{"text":"لەنێو چل هەزار کەس لە ئیسرائیل نەبینرا.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"دڵم لەگەڵ سەرکردەکانی ئیسرائیلە،","poem":1},{"text":"لەگەڵ خۆبەختکەرانی نێو گەل،","poem":2},{"lineBreak":true},{"text":"ستایشی یەزدان بکەن!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«ئەی ئەوانەی سواری ماکەری سپی بوون،","poem":1},{"text":"دانیشتوو لەسەر زینی لباد و","poem":2},{"lineBreak":true},{"text":"ئەوانەی ڕێتان گرتووەتەبەر،","poem":2},{"text":"گوێ بگرن","poem":1}]},{"type":"verse","number":11,"content":[{"text":"لە دەنگی گۆرانیبێژان لەلای بیرە ئاوەکان،","poem":1},{"text":"لەوێ بە کردارە ڕاستودروستەکانی یەزدانیان هەڵدا،","poem":2},{"lineBreak":true},{"text":"کردەوە ڕاستودروستەکانی جەنگاوەرانی ئەو لە ئیسرائیل.","poem":2},{"lineBreak":true},{"text":"«ئینجا گەلی یەزدان","poem":1},{"text":"بەرەو دەروازەکان ڕۆیشتن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"”هەستە، هەستە، ئەی دەڤۆرا!","poem":1},{"text":"هەستە، هەستە، سروود بڵێ!","poem":2},{"text":"هەستە، ئەی باراک!","poem":1},{"text":"ئەی کوڕی ئەبینۆعەم دیلەکانت بگرە.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«ئینجا پاشماوەی گەل","poem":1},{"text":"هاتنە خوارەوە بۆ لای بەگزادەکان،","poem":2},{"text":"گەلی یەزدان بۆ لام هاتنە خوارەوە،","poem":1},{"text":"لەگەڵ پاڵەوانەکان.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"هەندێکیان لە ئەفرایمەوە هاتن، ئەوانەی بارەگایان لەنێو عەمالێقە،","poem":1},{"text":"لە دواتەوەن، نەوەی بنیامین لەگەڵ گەلەکەت.","poem":2},{"text":"لە ماکیرەوە سەرکردەکان دابەزین و","poem":1},{"text":"لە زەبولونەوە ئەوانەی داردەستی پێشەوایان بەدەستەوەیە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"سەرۆکەکانی یەساخار لەگەڵ دەڤۆرا هاتن و","poem":1},{"text":"نەوەی یەساخار لەگەڵ باراک،","poem":2},{"lineBreak":true},{"text":"بەرەو دۆڵەکە بە پەلە بەدوایدا دەڕۆیشتن.","poem":2},{"text":"لەنێو خێڵەکانی ڕەئوبێن","poem":1},{"text":"دڵەڕاوکێیەکی زۆر هەبوو.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بۆچی لەنێو پەرژینەکان دانیشتبوون،","poem":1},{"text":"بۆ گوێگرتن لە دەنگی بلوێرلێدان بۆ مێگەلەکان؟","poem":2},{"text":"لەنێو خێڵەکانی ڕەئوبێن","poem":1},{"text":"دڵەڕاوکێیەکی زۆر هەبوو.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"گلعاد لەوبەری ڕووباری ئوردون مایەوە،","poem":1},{"text":"بۆچی دان لەلای کەشتییەکان چاوەڕێی دەکرد؟","poem":2},{"text":"ئاشێریش لەلای کەناری دەریا دانیشت و","poem":1},{"text":"لە بەندەرەکانی مایەوە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"زەبولون گەلێکە گیان لەسەر دەست","poem":1},{"text":"لەگەڵ نەفتالی لە بەرزاییەکانی گۆڕەپانی جەنگ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«پاشایان هاتن و جەنگان،","poem":1},{"text":"ئینجا پاشایانی کەنعان جەنگان","poem":2},{"text":"لە تەعنەک لەلای ئاوی مەگیدۆ،","poem":1},{"text":"هەندێک زیویشیان دەست نەکەوت.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئەستێرەکان لە ئاسمانەوە جەنگان،","poem":1},{"text":"لە خولگەکانی خۆیانەوە لە دژی سیسرا جەنگان.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ڕووباری قیشۆن ڕایماڵین،","poem":1},{"text":"ڕووباری قیشۆن، ڕووبارێکی دێرینە.","poem":2},{"lineBreak":true},{"text":"ئەی گیانی من بە ئازایەتییەوە بەرەو پێشەوە بڕۆ!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ئینجا سمی ئەسپەکان دەنگەدەنگەیان دەدا،","poem":1},{"text":"لە غارەغاری ئەسپە بەتاوەکانی.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"فریشتەی یەزدان فەرمووی: ”نەفرەت لە مێرۆز بکەن،","poem":1},{"text":"بە توندی نەفرەت لە دانیشتووانی بکەن،","poem":2},{"text":"چونکە نەهاتن بۆ یارمەتیدانی یەزدان،","poem":1},{"text":"یارمەتیدانی یەزدان لە دژی پاڵەوانان.“","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«بەرەکەتدار بێت لەنێو ئافرەتان،","poem":1},{"text":"یاعێلی ژنی حەڤەری قێنی،","poem":2},{"lineBreak":true},{"text":"بەرەکەتدار بێت لەناو هەموو ئەو ئافرەتانەی چادرنشینن.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"داوای ئاوی کرد شیری پێدا،","poem":1},{"text":"لەناو کاسەی شازادان، دەڵەمەی","poem":2},{"noteId":22},{"text":"بۆ هێنا.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"دەستی درێژکرد بۆ مێخی چادرەکە و","poem":1},{"text":"دەستی ڕاستی بۆ چەکوشی کرێکار.","poem":2},{"text":"لە سیسرای دا و سەری شکاند،","poem":1},{"text":"کاسە سەری وردوخاش کرد و لاجانی کون کرد.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"لەبەر پێیەکانی ڕۆچوو،","poem":1},{"text":"کەوت، ڕاکشا،","poem":2},{"text":"لەبەر پێیەکانی ڕۆچوو، کەوت،","poem":1},{"text":"لەکوێ ڕۆچوو، لەوێ کەوت و مرد.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«دایکی سیسرا لە پەنجەرەوە تەماشای کرد و","poem":1},{"text":"لە کڵاوڕۆژنەوە","poem":2},{"noteId":23},{"text":"دەستی بە شیوەن کرد.","poem":2},{"text":"”بۆچی گالیسکەکانی لە هاتن دواکەوتن؟","poem":1},{"text":"بۆچی دەنگی ناڵی وڵاخی گالیسکەکانی دواکەوتن؟“","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ئینجا داناترین شازادەی وەڵامی دایەوە،","poem":1},{"text":"بەڵکو خۆی بوو وەڵامی خۆی دایەوە:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"”ئایا دەستکەوتێکیان دەست نەکەوتووە و بەشی ناکەن،","poem":1},{"text":"کیژێک یان دووان بۆ هەر پیاوێک،","poem":2},{"lineBreak":true},{"text":"تاڵانکردنی جلی ڕەنگکراو بۆ سیسرا،","poem":2},{"lineBreak":true},{"text":"جلی ڕەنگکراو و نەخشێنراو،","poem":2},{"lineBreak":true},{"text":"جلی نەخشێنراو لە هەردوو ڕوو بۆ گەردنم،","poem":2},{"text":"هەمووی وەک تاڵانی؟“","poem":1}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«ئاوا هەموو دوژمنانت لەناودەچن، ئەی یەزدان!","poem":1},{"text":"بەڵام با ئەوانەی کە تۆیان خۆشدەوێت وەک خۆر بن","poem":2},{"lineBreak":true},{"text":"کاتێک لە بەهێزیدا هەڵدێت.»","poem":2},"ئینجا خاکەکە چل ساڵ لە ئاشتیدا بوو."]}],"footnotes":[{"noteId":22,"caller":"+","text":"یان دەرەمە، قۆناغی پێش دروستبوونی پەنیر.‏","reference":{"chapter":5,"verse":25}},{"noteId":23,"caller":"+","text":"وەک پەنجەرەیە، دەلاقەیەکە بۆ هاتوچۆی هەوا و گێڕانەوەی تیشکی خۆر.‏","reference":{"chapter":5,"verse":28}}]},"thisChapterLink":"/api/ckb_bib/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}