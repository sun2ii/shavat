{"text":"بە هەڵگرتن هەڵدەگیرێن،","poem":1},{"text":"چونکە هەنگاو نانێن،","poem":2},{"text":"لێیان مەترسن، چونکە زیانبەخش نین،","poem":1},{"text":"هەروەها ناتوانن هیچ سوودێک بگەیەنن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ئەی یەزدان، کەس وەک تۆ نییە،","poem":1},{"text":"تۆ مەزنیت،","poem":2},{"lineBreak":true},{"text":"لە پاڵەوانیێتی ناوت گەورەیە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"کێ لێت ناترسێت،","poem":1},{"text":"ئەی پاشای نەتەوەکان؟","poem":2},{"lineBreak":true},{"text":"چونکە لە تۆ دەوەشێتەوە.","poem":2},{"text":"لەناو هەموو دانایانی نەتەوەکان و","poem":1},{"text":"لە هەموو شانشینەکانیان،","poem":2},{"lineBreak":true},{"text":"کەس هاوتای تۆ نییە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"تێکڕا دەبەنگ و گێل بوون،","poem":1},{"text":"شتی پووچ لە بتی دارین فێر دەبن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"زیوی کوتراوە لە تەرشیشەوە دەهێنن و","poem":1},{"text":"زێڕ لە ئوفازەوە.","poem":2},{"text":"دەستکردی پیشەوەرە و دەستی زێڕنگەرە،","poem":1},{"text":"بەرگیان مۆر و ئەرخەوانییە،","poem":2},{"lineBreak":true},{"text":"هەمووی دەستکردی وەستایانن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بەڵام تەنها یەزدان پەروەردگاری ڕاستییە،","poem":1},{"text":"ئەو خودای زیندوو و پاشای هەتاهەتاییە،","poem":2},{"text":"زەوی لەبەر تووڕەیی ئەو دەلەرزێت و","poem":1},{"text":"نەتەوەکان بەرگەی هەڵچوونی ئەو ناگرن.","poem":2}]},{"type":"verse","number":11,"content":["«ئاوایان پێ دەڵێن: ”ئەو خوداوەندانەی ئاسمان و زەوییان دروستنەکردووە، لەسەر زەوی و لەژێر ئەم ئاسمانە لەناودەچن.“»"]},{"type":"verse","number":12,"content":[{"text":"بەڵام یەزدان بە هێزی خۆی زەوی دروستکردووە،","poem":1},{"text":"بە دانایی خۆی جیهانی دامەزراندووە،","poem":2},{"lineBreak":true},{"text":"بە تێگەیشتنی خۆی ئاسمانی ڕاخستووە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"کاتێک دەنگ هەڵدەبڕێت، ئاوەکانی ئاسمان هاژەیان دێت،","poem":1},{"text":"هەڵمەکان لەوپەڕی زەوییەوە بەرز دەکاتەوە،","poem":2},{"text":"بروسکە بۆ باران دروستدەکات،","poem":1},{"text":"با لە ئەمباری خۆی دەردەهێنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"هەموو کەسێک بێ زانیارییە و دەبەنگە،","poem":1},{"text":"هەموو زێڕنگەرێک بە پەیکەرەکەی","poem":2},{"noteId":23},{"text":"شەرمەزارە،","poem":2},{"text":"چونکە داڕێژراوی درۆن و","poem":1},{"text":"ڕۆحیان تێدا نییە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەوان پووچن، مایەی گاڵتەجاڕین،","poem":1},{"text":"لە کاتی سزادانیان لەناودەچن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بەڵام خودا، ئەوەی بەشی یاقوبە وەک ئەمانە نییە،","poem":1},{"text":"چونکە ئەو دروستکەری هەموو شتێکە،","poem":2},{"text":"ئیسرائیل هۆزی میراتی ئەویشی داناوە،","poem":1},{"text":"یەزدانی سوپاسالار، ئەمە ناوی ئەوە.","poem":2}]},{"type":"heading","content":["هاتنی وێرانی"]},{"type":"verse","number":17,"content":[{"text":"لەم خاکە بوخچەکەت بپێچەوە،","poem":1},{"text":"ئەی دانیشتووی ژێر ئابڵوقە!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"لەبەر ئەوەی یەزدان ئەمە دەفەرموێت:","poem":1},{"text":"«ئەم جارە دانیشتووانی ئەم خاکە","poem":2},{"text":"دەردەکەمە دەرەوە،","poem":1},{"text":"تەنگیان پێ هەڵدەچنم هەتا ئەوەی هەستی پێدەکەن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"وەی لە حاڵم لەبەر وردوخاشبوونم!","poem":1},{"text":"برینەکەم بێ چارەیە!","poem":2},{"text":"بەڵام بە خۆمم گوت: «بێگومان ئەمە دەردی منە و","poem":1},{"text":"دەبێ بەرگەی بگرم.»","poem":2}]},{"type":"verse","number":20,"content":[{"text":"چادرەکەم تێکدراوە،","poem":1},{"text":"هەموو گوریسەکانی پساون.","poem":2},{"text":"کوڕەکانم بەجێیان هێشتووم و نەماون،","poem":1},{"text":"ئیتر کەس نییە بۆ ئەوەی چادرەکەم هەڵبدات و","poem":2},{"lineBreak":true},{"text":"پڵاسەکانی چادرەکەم ڕابگرێت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"شوانەکان دەبەنگ بوون و","poem":1},{"text":"داوای یەزدانیان نەکرد،","poem":2},{"text":"لەبەر ئەوە سەرنەکەوتن و","poem":1},{"text":"هەموو مێگەلەکەیان پەرتەوازە بوو.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"گوێ بگرن! دەنگی هەواڵ دێت،","poem":1},{"text":"هەراوهۆریای گەورە لە خاکی باکوورەوە،","poem":2},{"text":"تاوەکو شارۆچکەکانی یەهودا وێران بکرێن،","poem":1},{"text":"بکرێنە داڵدەی چەقەڵ.","poem":2}]},{"type":"heading","content":["نزاکردنی یەرمیا"]},{"type":"verse","number":23,"content":[{"text":"ئەی یەزدان، زانیم کە مرۆڤ خاوەنی ڕێگای خۆی نییە،","poem":1},{"text":"کەس ناتوانێت ڕێڕەوەکانی خۆی ئاراستە بکات.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ئەی یەزدان، تەمبێم بکە،","poem":1},{"text":"بەڵام بە دادپەروەری، نەک بە تووڕەییت،","poem":2},{"lineBreak":true},{"text":"نەوەک لەناوم ببەیت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"تووڕەییت بەسەر ئەو نەتەوانەدا ببارێنە","poem":1},{"text":"کە دانت پێدا نانێن و","poem":2},{"lineBreak":true},{"text":"بەسەر ئەو گەلانەی کە بە ناوی تۆوە نزا ناکەن،","poem":2},{"text":"چونکە یاقوبیان خوارد،","poem":1},{"text":"بە تەواوی خواردیان و","poem":2},{"lineBreak":true},{"text":"نشینگەکەیان وێران کرد.","poem":2}]}],"footnotes":[{"noteId":22,"caller":"+","text":"لە دار و پەڕۆ لە شێوەی مرۆڤ دروستدەکرێت بۆ ڕەوینەوەی پەلەوەر، بۆ ئەوەی زیان بە کێڵگە نەگەیەنن.‏","reference":{"chapter":10,"verse":5}},{"noteId":23,"caller":"+","text":"تاشینی پەیکەر، بە مەبەستی پەرستن وەک بت.‏","reference":{"chapter":10,"verse":14}}]},"thisChapterLink":"/api/ckb_bib/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}