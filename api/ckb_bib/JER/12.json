{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["سکاڵانامەی یەرمیا"]},{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، تۆ ڕاستودروستیت","poem":1},{"text":"کاتێک سکاڵای خۆم بۆ تۆ دەهێنم.","poem":2},{"text":"لەگەڵ ئەوەشدا سەبارەت بە حوکمەکانی تۆ دەدوێم:","poem":1},{"text":"بۆچی ڕێگای بەدکاران سەرکەوتووە؟","poem":2},{"lineBreak":true},{"text":"بۆچی هەموو ناپاکەکان ئاسوودەن؟","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەوانت چاند و ڕەگیان داکوتا،","poem":1},{"text":"گەشەیان کرد و بەریان دا.","poem":2},{"text":"تۆ هەردەم لەسەر زاری ئەوانیت","poem":1},{"text":"بەڵام لە دڵیان دووریت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بەڵام ئەی یەزدان، تۆ دەمناسیت،","poem":1},{"text":"دەمبینیت و لەلای خۆت دڵی من تاقی دەکەیتەوە.","poem":2},{"text":"وەک مەڕ بۆ سەربڕین جیایان بکەوە!","poem":1},{"text":"بۆ ڕۆژی کوشتن تەرخانیان بکە!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"هەتا کەی زەوی بگریێ و","poem":1},{"text":"گیای هەموو کێڵگەکان وشک بێت؟","poem":2},{"text":"لەبەر خراپەی دانیشتووانەکەی","poem":1},{"text":"ئاژەڵ و باڵندە لەناوچوون،","poem":2},{"lineBreak":true},{"text":"چونکە گوتیان: «خودا کۆتایی ئێمە نابینێت.»","poem":2}]},{"type":"heading","content":["وەڵامی خودا"]},{"type":"verse","number":5,"content":[{"text":"«ئەگەر لە ڕاکردن لەگەڵ پیادەکان ماندوو بیت،","poem":1},{"text":"ئەی چۆن پێشبڕکێ لەگەڵ ئەسپەکان دەکەیت؟","poem":2},{"text":"ئەگەر لەسەر خاکێکی سەلامەت ساتمە دەکەیت و دەکەویت،","poem":1},{"text":"ئەی لە دەوەنەکانی ڕووباری ئوردون چی دەکەیت؟","poem":2}]},{"type":"verse","number":6,"content":[{"text":"براکانت و بنەماڵەکەشت،","poem":1},{"text":"ئەوانیش ناپاکییان لەگەڵ کردیت،","poem":2},{"text":"ئەوانیش پڕ بەدەم بەدواتدا هاواریان کرد.","poem":1},{"text":"لێیان دڵنیا مەبە، هەرچەندە باسی چاکەشیان بۆ کردیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«واز لە ماڵی خۆم دەهێنم،","poem":1},{"text":"میراتی خۆم ڕەت دەکەمەوە،","poem":2},{"text":"ئەویندارەکەی خۆم","poem":1},{"text":"دەخەمە چنگی دوژمەنەکانیەوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"میراتەکەم لێم دەبێتە","poem":1},{"text":"شێرێک لە دارستان،","poem":2},{"text":"بەسەرمدا دەنەڕێنێت،","poem":1},{"text":"لەبەر ئەوە دژایەتی دەکەم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئایا میراتەکەم مەلی گۆشتخۆری خاڵدارە،","poem":1},{"text":"کە مەلە گۆشتخۆرەکانی دیکە چواردەوریان داوە و هێرشیان کردووەتە سەری؟","poem":2},{"text":"بڕۆن هەموو ئاژەڵە کێوییەکان کۆبکەنەوە،","poem":1},{"text":"بیانهێنن بۆ خواردن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"زۆر شوان ڕەزەمێوەکەی من تێکدەدەن،","poem":1},{"text":"کێڵگەکەی من پێپەست دەکەن.","poem":2},{"text":"کێڵگە ئارەزووبەخشەکەی من","poem":1},{"text":"دەکەنە چۆڵەوانییەکی کاول.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"دەیکەنە کاولگە،","poem":1},{"text":"کاولگە شیوەن بۆ من دەگێڕێت.","poem":2},{"text":"هەموو زەوی کاول دەبێت،","poem":1},{"text":"چونکە کەس نییە گرنگی پێبدات.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لەسەر هەموو گردۆڵکەکانی چۆڵەوانی","poem":1},{"text":"تاڵانکەران دێن،","poem":2},{"text":"چونکە شمشێری یەزدان","poem":1},{"text":"لەوپەڕی زەوییەوە هەتا ئەم پەڕی دەخوات،","poem":2},{"lineBreak":true},{"text":"ئاشتی بۆ هیچ کەسێک نابێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"گەنم دەچێنن و دڕک دەدورنەوە،","poem":1},{"text":"ماندوو دەبن و قازانج ناکەن.","poem":2},{"text":"ئیتر شەرمەزار دەبن لە بەروبوومەکەتان،","poem":1},{"text":"لە گڕی تووڕەیی یەزدان.»","poem":2}]},{"type":"verse","number":14,"content":["یەزدان ئەمە دەفەرموێت: «ئەو نەتەوە بەدکارانەی دراوسێم کە دەستیان لە میراتەکەم دا کە دامە ئیسرائیلی گەلەکەم، ئەوەتا لە خاکەکەدا ڕیشەکێشیان دەکەم و بنەماڵەی یەهوداش لە ناوەڕاستیان ڕیشەکێش دەکەم."]},{"type":"verse","number":15,"content":["لەدوای ئەوەی ڕیشەکێشیان دەکەم، دەگەڕێمەوە بەزەییم پێیاندا دێتەوە، هەریەکە بۆ میراتەکەی خۆی و بۆ خاکەکەی خۆی دەگەڕێنمەوە."]},{"type":"verse","number":16,"content":["لە ڕابردوو گەلەکەی منیان فێرکرد سوێند بە ناوی بەعل بخۆن، بەڵام ئەگەر ئێستا بە تەواوی فێری نەریتی گەلەکەی من ببن، ئەگەر سوێندیان بە ناوی من خوارد و گوتیان: ”بە یەزدانی زیندوو،“ ئەوا لەنێو گەلەکەم بنیاد دەنرێن."]},{"type":"verse","number":17,"content":["بەڵام هەر نەتەوەیەک ئەگەر گوێ نەگرێت، من لە ڕەگەوە ڕیشەکێشی دەکەم و لەناوی دەبەم.» ئەوە فەرمایشتی یەزدانە."]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}