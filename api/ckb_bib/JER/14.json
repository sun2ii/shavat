{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":14,"content":[{"type":"heading","content":["وشکەساڵی و برسیێتی و شمشێر"]},{"type":"verse","number":1,"content":["ئەمە فەرمایشتی یەزدانە بۆ یەرمیا سەبارەت بە وشکەساڵییەکە:"]},{"type":"verse","number":2,"content":[{"text":"«یەهودا شیوەن دەگێڕێت و","poem":1},{"text":"شارەکانی دادەڕزێن،","poem":2},{"text":"بۆ خاکەکە ماتەم دەگێڕن،","poem":1},{"text":"هاواری ئۆرشەلیمیش بەرزبووەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"گەورەکان خزمەتکارەکانی خۆیان بۆ ئاو نارد،","poem":1},{"text":"هاتنە سەر ئەمباراوەکان،","poem":2},{"lineBreak":true},{"text":"بەڵام ئاویان نەدۆزییەوە.","poem":2},{"text":"بە گۆزەی بەتاڵەوە گەڕانەوە،","poem":1},{"text":"شەرمەزار و ڕیسوا بوون،","poem":2},{"lineBreak":true},{"text":"سەری خۆیان شۆڕکرد.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لەبەر ئەوەی خاکەکە شەقار شەقار بووە،","poem":1},{"text":"چونکە باران لە زەوییەکە نەباری،","poem":2},{"text":"جوتیاران شەرمەزاربوون،","poem":1},{"text":"سەری خۆیان شۆڕکرد.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"تەنانەت مامزیش لە کێڵگەدا","poem":1},{"text":"بەچکەی بوو و وازی لێی هێنا،","poem":2},{"lineBreak":true},{"text":"چونکە گیا نەبوو.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"کەرەکێوییەکان لەسەر گردۆڵکەکان ڕاوەستان،","poem":1},{"text":"وەک چەقەڵ بایان هەڵمژی،","poem":2},{"text":"چاویان شل بوو،","poem":1},{"text":"چونکە گیاوگۆڵ نییە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"لەگەڵ ئەوەی تاوانەکانمان شایەتیمان لەسەر دەدەن،","poem":1},{"text":"ئەی یەزدان، لەبەر خاتری ناوی خۆت شتێک بکە،","poem":2},{"text":"چونکە هەڵگەڕانەوەکانمان زۆر بوون،","poem":1},{"text":"دەرهەق بە تۆ گوناهمان کرد.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەی هیوای ئیسرائیل،","poem":1},{"text":"ئەی ڕزگارکەرەکەی کاتی تەنگانە،","poem":2},{"text":"بۆچی لە خاکەکە وەک نامۆ دەبیت،","poem":1},{"text":"وەک ڕێبوارێک بۆ تەنها شەوێک بمێنێتەوە؟","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بۆچی وەک پیاوێکی حەپەساو دەبیت،","poem":1},{"text":"وەک پاڵەوانێک توانای ڕزگارکردنی نەبێت؟","poem":2},{"text":"ئەی یەزدان، تۆ لە ناوەڕاستمانی و","poem":1},{"text":"ئێمە ناوی تۆ هەڵدەگرین،","poem":2},{"lineBreak":true},{"text":"بەجێمان مەهێڵە!","poem":2}]},{"type":"verse","number":10,"content":["یەزدان ئاوا بەم گەلە دەفەرموێت:",{"text":"«بەڕاستی حەزیان لە گەڕان کرد،","poem":1},{"text":"خۆیان لێ نەپاراست.","poem":2},{"text":"جا یەزدانیش پەسەندی نەکردن،","poem":1},{"text":"ئێستا تاوانەکانیان بەبیر خۆی دەهێنێتەوە و","poem":2},{"lineBreak":true},{"text":"لەسەر گوناهەکانیان سزایان دەدات.»","poem":2}]},{"type":"verse","number":11,"content":["هەروەها یەزدان پێی فەرمووم: «نوێژ بۆ چاکەی ئەم گەلە مەکە."]},{"type":"verse","number":12,"content":["هەرچەندە بەڕۆژووش بن گوێ لە هاواریان ناگرم، کاتێک قوربانی سووتاندن و پێشکەشکراوی دانەوێڵە پێشکەش بکەن قبوڵی ناکەم، بەڵکو من بە شمشێر و قاتوقڕی و دەرد کۆتاییان پێ دەهێنم.»"]},{"type":"verse","number":13,"content":["منیش گوتم: «ئای، ئەی یەزدانی باڵادەست، ئەوەتا پێغەمبەرەکان پێیان دەڵێن: ”تووشی شمشێر و قاتوقڕی نابن، بەڵکو لەم شوێنەدا ئاشتی چەسپاوتان دەدەمێ.“»"]},{"type":"verse","number":14,"content":["یەزدانیش پێی فەرمووم: «ئەو پێغەمبەرانە بە درۆ بە ناوی منەوە پێشبینی دەکەن. من نەمناردوون و دەستنیشانم نەکردوون و قسەم لەگەڵ نەکردوون. ئەوان بە بینینی درۆ و فاڵگرتنەوە و پڕوپووچی و خەیاڵی بیری خۆیان پێشبینیتان بۆ دەکەن.»"]},{"type":"verse","number":15,"content":["لەبەر ئەوە یەزدان لەبارەی ئەو پێغەمبەرانەوە دەفەرموێت: «بە ناوی منەوە پێشبینی دەکەن و منیش نەمناردوون، ئەوان دەڵێن: ”شمشێر و قاتوقڕی لەم خاکە نابێت.“ ئەو پێغەمبەرانە خۆیان بە شمشێر و قاتوقڕی لەناودەچن."]},{"type":"verse","number":16,"content":["ئەو گەلەش کە ئەوان پێشبینی بۆ دەکەن، لەبەر قاتوقڕی و شمشێر لە شەقامەکانی ئۆرشەلیم فڕێدەدرێن. کەسیش نییە بیاننێژێت، خۆیان و ژن و کوڕ و کچیان. خراپەی شایستەی خۆیان بەسەر سەریاندا دەڕێژم."]},{"type":"verse","number":17,"content":["«ئەم قسەیەیان پێ دەڵێیت:",{"text":"«”با چاوەکانم فرمێسک بڕێژن","poem":1},{"text":"بە شەو و بە ڕۆژ بەبێ وەستان،","poem":2},{"text":"چونکە گەلەکەم، کچە پاکیزەکەم،","poem":1},{"text":"برینێکی ترسناکی هەیە،","poem":2},{"lineBreak":true},{"text":"لێدانێکی جەرگبڕ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئەگەر بچمە دەرەوە بۆ کێڵگە،","poem":1},{"text":"بە شمشێر کوژراوان دەبینم.","poem":2},{"text":"ئەگەر بێمە ناو شار،","poem":1},{"text":"نەخۆشەکانی قاتوقڕی دەبینم،","poem":2},{"text":"چونکە پێغەمبەر و کاهینیش","poem":1},{"text":"بەناو زەوییەکدا دەگەڕێن و نازانن چی دەکەن.“»","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«ئایا بە تەواوی یەهودات ڕەتکردووەتەوە؟","poem":1},{"text":"ئایا بێزت لە سییۆن دەبێتەوە؟","poem":2},{"text":"بۆچی وا تووشی بەڵات کردین","poem":1},{"text":"کە چاکبوونەوەمان نەبێت؟","poem":2},{"text":"چاوەڕێی ئاشتی بووین،","poem":1},{"text":"بەڵام چاکە نەهات،","poem":2},{"text":"هەروەها کاتی چاکبوونەوە،","poem":1},{"text":"بەڵام ئەوەتا ترس.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئەی یەزدان، دان دەنێین بە یاخیبوونی خۆمان و","poem":1},{"text":"تاوانی باوباپیرانمان،","poem":2},{"lineBreak":true},{"text":"گوناهمان دەرهەق بە تۆ کرد.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لە پێناوی ناوی خۆت، ڕەتمان مەکەوە،","poem":1},{"text":"تەختی شکۆی خۆت ڕیسوا مەکە،","poem":2},{"text":"پەیمانەکەی خۆت لەگەڵ ئێمە بەبیر بێتەوە،","poem":1},{"text":"مەیشکێنە.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ئایا لەناو بتە پووچەکانی نەتەوەکان هەیە باران ببارێنێت؟","poem":1},{"text":"یان ئایا ئاسمان خۆی ڕەهێڵ دەبارێنێت؟","poem":2},{"text":"ئەی تۆ یەزدانی پەروەردگارمان نیت؟","poem":1},{"text":"جا هیوامان بە تۆیە،","poem":2},{"lineBreak":true},{"text":"چونکە تۆ ئەوەی کە هەموو ئەمانەت کردووە.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}