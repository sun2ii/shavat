{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":["ئینجا یەزدان پێی فەرمووم: «تەنانەت ئەگەر موسا و ساموئێلیش لەبەردەمم ڕاوەستن داکۆکیتان لێ بکەن، دڵم ناچێتە سەر ئەم گەلە. لەبەرچاوی من دەریانبکە! با بڕۆن!"]},{"type":"verse","number":2,"content":["جا کاتێک پێت دەڵێن: ”بۆ کوێ بچین؟“ تۆش پێیان دەڵێیت: ”یەزدان ئەمە دەفەرموێت:",{"text":"«”ئەوانەی بۆ مردنن، بۆ مردن،","poem":1},{"lineBreak":true},{"text":"ئەوانەی بۆ شمشێرن، بۆ شمشێر،","poem":1},{"lineBreak":true},{"text":"ئەوانەی بۆ برسیێتین، بۆ برسیێتی،","poem":1},{"lineBreak":true},{"text":"ئەوانەی بۆ ڕاپێچن، بۆ ڕاپێچ.“»","poem":1}]},{"type":"verse","number":3,"content":["یەزدان دەفەرموێت: «چوار جۆریان بەسەرەوە دادەنێم، شمشێر بۆ کوشتن، سەگەکان بۆ ڕاکێشان، باڵندە و ئاژەڵە کێوییەکانیش بۆ خواردن و لەناوبردن."]},{"type":"verse","number":4,"content":["هەموو شانشینەکانی زەوی لێتان دەتۆقن، لەسەر ئەوەی مەنەشەی کوڕی حەزقیای پاشای یەهودا لە ئۆرشەلیم کردی."]},{"type":"verse","number":5,"content":[{"text":"«ئەی ئۆرشەلیم، کێ دڵی پێت دەسووتێت؟","poem":1},{"text":"کێ بۆت خەمبار دەبێت؟","poem":2},{"lineBreak":true},{"text":"کێ ئاوڕ دەداتەوە بۆ ئەوەی لە سەلامەتیت بپرسێت؟","poem":2}]},{"type":"verse","number":6,"content":[{"text":"تۆ وازت لە من هێنا،","poem":1},{"text":"لێم یاخی دەبی،","poem":2},{"text":"لەبەر ئەوە دەست درێژدەکەمە سەرت و لەناوت دەبەم،","poem":1},{"text":"لە لێبوردنت بێزار بووم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"«بە شەن شەنیان دەکەم،","poem":1},{"text":"لە دەروازەی شارەکانی خاکەکە.","poem":2},{"text":"جەرگسووتاوم کرد، گەلی خۆمم لەناوبرد،","poem":1},{"text":"ڕەفتاری خۆیان نەگۆڕی.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بێوەژنەکانیان زۆر زیاتر دەکەم،","poem":1},{"text":"زیاتر لە لمی دەریا.","poem":2},{"text":"لە نیوەڕۆدا وێرانکەری بۆ دەهێنم","poem":1},{"text":"بۆ سەر دایکی گەنجان.","poem":2},{"text":"لەناکاو","poem":1},{"text":"ترس و تۆقاندنی بەسەردا دەدەم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"دایکی حەوت منداڵ سیس بوو،","poem":1},{"text":"گیانی سپارد.","poem":2},{"text":"هێشتا ڕۆژ بوو خۆری ئاوابوو،","poem":1},{"text":"شەرمەزار و ڕیسوا بوو.","poem":2},{"text":"پاشماوەکەشیان دەدەمە بەر شمشێر","poem":1},{"text":"لە بەرچاوی دوژمنانیان.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"قوڕبەسەرم دایکە، چونکە منت بوو،","poem":1},{"text":"پیاوێک کە دەمەقاڵێ و ململانێی لەگەڵ سەراپای خاکەکە هەیە!","poem":2},{"text":"نە قەرزم کردووە و نە قەرزیان داومەتێ،","poem":1},{"text":"کەچی هەمووان نەفرەتم لێ دەکەن.","poem":2}]},{"type":"verse","number":11,"content":["یەزدان فەرمووی:",{"text":"«بێگومان بۆ مەبەستی چاک دەربازت دەکەم،","poem":1},{"text":"بێگومان وا دەکەم دوژمن","poem":2},{"lineBreak":true},{"text":"لە کاتی بەڵا و لە کاتی تەنگانەدا لێت بپاڕێنەوە!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«کەس دەتوانێت ئاسن بشکێنێت،","poem":1},{"text":"ئاسنی باکوور و بڕۆنز؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«سامان و گەنجینەکانت","poem":1},{"text":"دەکەم بە تاڵانی، بەبێ نرخ،","poem":2},{"text":"لەبەر هەموو گوناهەکانت،","poem":1},{"text":"لە سەراپای خاکەکەت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"دەتکەمە کۆیلەی دوژمنەکانت،","poem":1},{"text":"لە خاکێک نەتناسیبێت،","poem":2},{"text":"چونکە تووڕەییم گڕی گرتووە","poem":1},{"text":"وەک ئاگرێک دەتانسووتێنێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«ئەی یەزدان، تۆ دەزانیت،","poem":1},{"text":"بەبیری خۆتم بهێنەرەوە و گرنگیم پێبدە،","poem":2},{"lineBreak":true},{"text":"تۆڵەم بستێنەوە لە چەوسێنەرانم.","poem":2},{"text":"وا مەکە بەهۆی پشوودرێژی تۆ لەناوبچم،","poem":1},{"text":"بزانە کە لەبەر تۆ بەرگەی ڕیسواییم گرت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"کاتێک فەرموودەکانی تۆ هات، خواردم","poem":1},{"text":"بۆم بووە مایەی شادی و خۆشحاڵی دڵم،","poem":2},{"text":"چونکە من ناوی تۆم هەڵگرتووە،","poem":1},{"text":"ئەی یەزدان، خودای سوپاسالار.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"قەت لە کۆڕی گاڵتەجاڕان دانەنیشتووم،","poem":1},{"text":"لەگەڵیشیان دڵخۆش نەبووم.","poem":2},{"text":"بە تەنها دانیشتم، چونکە دەستی تۆم لەسەر بوو،","poem":1},{"text":"پڕت کردم لە تووڕەیی.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بۆچی ژانم کۆتایی نایەت،","poem":1},{"text":"برینەکەم بێ چارەیە و نایەوێت چاک بێتەوە؟","poem":2},{"text":"ئایا وەک کەندێکی فریودەر دەبیت بۆم،","poem":1},{"text":"وەک کانییەک جێی متمانە نەبێت؟»","poem":2}]},{"type":"verse","number":19,"content":["لەبەر ئەوە یەزدان ئەمە دەفەرموێت:",{"text":"«ئەگەر تۆبە بکەیت، دەتگەڕێنمەوە لای خۆم","poem":1},{"text":"تاکو وەک بەندەی خۆم لەبەردەستم ڕاوەستیت.","poem":2},{"text":"ئەگەر قسەی بە نرخ بکەیت، نەک بێبەها،","poem":1},{"text":"دەتکەمە وتەبێژی خۆم.","poem":2},{"text":"با ئەو گەلە بگەڕێتەوە لای تۆ،","poem":1},{"text":"بەڵام تۆ نەگەڕێیتەوە لای ئەوان.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"دەتکەمە شوورا بۆ ئەو گەلە،","poem":1},{"text":"شوورایەکی بڕۆنزی پتەو،","poem":2},{"text":"لەگەڵت دەجەنگن","poem":1},{"text":"بەڵام دەرەقەتت نایەن،","poem":2},{"text":"چونکە من لەگەڵتدام،","poem":1},{"text":"بۆ ڕزگارکردن و بۆ فریاکەوتنت.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":21,"content":[{"text":"«لە دەستی خراپەکاران فریات دەکەوم و","poem":1},{"text":"لە چنگی زۆرداران دەتکڕمەوە.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}