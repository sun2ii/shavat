{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["وازهێنانی ئیسرائیل لە خودا"]},{"type":"verse","number":1,"content":["فەرمایشتی یەزدانم بۆ هات، پێی فەرمووم:"]},{"type":"verse","number":2,"content":["«بڕۆ و بە ئۆرشەلیمی ڕابگەیەنە با خەڵکەکە بیبیستن، بڵێ:",{"lineBreak":true},"«یەزدان ئەمە دەفەرموێت:",{"text":"«”بە یادی خۆمم هێنایەوە، دڵسۆزی کاتی مێردمنداڵیت و","poem":1},{"text":"خۆشەویستی کاتی بووکێنیت،","poem":2},{"text":"بەدوای مندا ڕۆیشتیت لە چۆڵەوانی،","poem":1},{"text":"بە خاکێکدا کە کشتوکاڵی تێدا نەبوو.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئیسرائیل بۆ یەزدان پیرۆز بوو،","poem":1},{"text":"یەکەمین بەرهەمی بەروبوومەکەیەتی.","poem":2},{"text":"هەموو ئەوانەی خواردیان تاوانیان کرد،","poem":1},{"text":"بەڵایان بەسەردا هات.“»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"گوێ لە فەرمایشتی یەزدان بگرن، ئەی بنەماڵەی یاقوب،","poem":1},{"text":"ئەی هەموو خێڵەکانی بنەماڵەی ئیسرائیل،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"یەزدان ئەمە دەفەرموێت:","poem":1},{"lineBreak":true},{"text":"«باوباپیرانتان چ کەموکوڕییەکیان لە مندا بینی","poem":1},{"text":"کە لێم دوور کەوتنەوە؟","poem":2},{"text":"چوون دوای بتی پووچ کەوتن و","poem":1},{"text":"خۆیان پووچ کرد.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"پرسیاریان نەکرد: ”کوا یەزدان،","poem":1},{"text":"ئەوەی لە خاکی میسرەوە دەریهێناین،","poem":2},{"text":"ئەوەی ئێمەی بەناو چۆڵەوانیدا برد،","poem":1},{"text":"بە خاکێکی ڕووتەن و چاڵوچۆڵدا،","poem":2},{"text":"بە خاکێکی وشک و سێبەری مەرگ،","poem":1},{"text":"بە خاکێکدا کە کەسی پێدا تێنەپەڕیبوو،","poem":2},{"lineBreak":true},{"text":"کەس لەوێ نیشتەجێ نەببوو؟“","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئێوەم هێنایە ناو خاکێکی بەپیت","poem":1},{"text":"بۆ ئەوەی بەروبووم و بەرهەمە چاکەکانی بخۆن.","poem":2},{"text":"بەڵام هاتن و زەوییەکەی منتان گڵاو کرد،","poem":1},{"text":"میراتەکەی منتان قێزەون کرد.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"کاهینەکان پرسیاریان نەکرد:","poem":1},{"text":"”کوا یەزدان؟“","poem":2},{"text":"ئەوانەی مامۆستای تەوراتن نەیانناسیم،","poem":1},{"text":"ڕابەرەکان لێم یاخی بوون،","poem":2},{"text":"پێغەمبەرەکان بەهۆی بەعلەوە پێشبینییان کرد،","poem":1},{"text":"دوای بتی پووچ کەوتن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"یەزدان دەفەرموێت: «لەبەر ئەوە دیسان دادگاییتان دەکەم،","poem":1},{"text":"منداڵی منداڵیشتان پەلکێشی دادگا دەکەم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لە کەنارەکانی کیتیم","poem":1},{"noteId":1},{"text":"بپەڕنەوە و ببینن،","poem":1},{"text":"بنێرن بۆ قێدار","poem":2},{"noteId":2},{"text":"و بە وردی سەرنج بدەن،","poem":2},{"lineBreak":true},{"text":"ببینن ئاخۆ شتی وەک ئەمە بووە؟","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئایا هیچ نەتەوەیەک خوداوەندەکانی خۆی گۆڕیوە؟","poem":1},{"text":"هەرچەندە خودا نین.","poem":2},{"text":"بەڵام گەلەکەی من خودای شکۆمەندیان گۆڕییەوە","poem":1},{"text":"بە بتی پووچ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەی ئاسمان، لەبەر ئەمە واقت وڕبمێنێت،","poem":1},{"text":"موچڕکەت پێدابێت و زۆر سەرسام بە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"«گەلەکەم دوو خراپەی کردووە:","poem":1},{"lineBreak":true},{"text":"وازیان لە من هێنا،","poem":1},{"text":"من کە کانی ئاوی ژیانم،","poem":2},{"text":"هەروەها ئەمباراویان بۆ خۆیان هەڵکەند،","poem":1},{"text":"ئەمباراوی شکاو کە ئاو ڕاناگرێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئایا ئیسرائیل کۆیلەیە؟ یان کوڕی کۆیلەی لەدایک بووی ماڵە؟","poem":1},{"text":"بۆچی بوو بە تاڵانی؟","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بەچکە شێران بەسەریدا نەڕاندیان،","poem":1},{"text":"دەنگیان هات،","poem":2},{"text":"خاکەکەیان وێران کردووە،","poem":1},{"text":"شارۆچکەکانی سووتاون، بێ دانیشتووانن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"هەروەها نەوەی مەمفیس و تەحپەنحێس","poem":1},{"text":"تەپڵی سەری تۆیان تراشیووە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئایا تۆ ئەمەت بە خۆت نەکرد،","poem":1},{"text":"کە وازت لە یەزدانی پەروەردگارت هێنا","poem":2},{"lineBreak":true},{"text":"کاتێک بە ڕێگادا دەیبردیت؟","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئێستا بۆچی دەچیتە میسر","poem":1},{"text":"بۆ خواردنەوەی ئاوی نیل؟","poem":2},{"text":"ئێستا بۆچی دەچیتە ئاشور","poem":1},{"text":"بۆ خواردنەوەی ئاوی ڕووباری فورات؟","poem":2}]},{"type":"verse","number":19,"content":[{"text":"خراپەی خۆت تەمبێت دەکات و","poem":1},{"text":"هەڵگەڕانەوەت سەرزەنشتت دەکات.","poem":2},{"text":"جا بزانە و ببینە کە بۆتان خراپ و تاڵە،","poem":1},{"text":"کاتێک واز لە یەزدانی پەروەردگارت دەهێنیت و","poem":2},{"lineBreak":true},{"text":"ترسی منت لە دڵدا نییە،»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە، پەروەردگاری سوپاسالار.","poem":4}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«تۆ لە کۆنەوە نیری","poem":1},{"noteId":3},{"text":"خۆتت شکاندووە،","poem":1},{"text":"کۆتەکانت پساندووە،","poem":2},{"lineBreak":true},{"text":"گوتت: ”تۆ ناپەرستم!“","poem":2},{"text":"تۆ بە ڕاستی لەسەر هەموو گردێکی بەرز و","poem":1},{"text":"لەژێر هەموو دارێکی سەوزدا","poem":2},{"lineBreak":true},{"text":"وەک لەشفرۆشێک ڕاکشایت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"من وەک شامێوێک","poem":1},{"text":"لە نایابترین جۆر تۆم چاند،","poem":2},{"text":"ئیتر چۆن لێم گۆڕایت،","poem":1},{"text":"گۆڕایت بۆ زڕمێو؟","poem":2}]},{"type":"verse","number":22,"content":[{"text":"هەرچەندە بە سۆدەش خۆت بشۆیت،","poem":1},{"text":"زیاد سابوونیش لە خۆت بدەیت،","poem":2},{"lineBreak":true},{"text":"هێشتا لەکەی تاوانەکەت لەبەردەممە.»","poem":2},{"text":"ئەمە فەرمایشتی یەزدانی باڵادەستە.","poem":4}]},{"type":"verse","number":23,"content":[{"text":"«ئیتر چۆن دەڵێیت: ”گڵاو نەبووم،","poem":1},{"text":"دوای بەعلەکان نەکەوتووم؟“","poem":2},{"text":"تەماشای ڕێگاکەی خۆت بکە لە دۆڵەکە،","poem":1},{"text":"بزانە چیت کردووە.","poem":2},{"lineBreak":true},{"text":"تۆ وەک وشترە سووکەکەی کە لە ڕۆیشتندا بەلادادێی،","poem":2}]},{"type":"verse","number":24,"content":[{"text":"وەک کەرەکێوییەکەی کە فێری چۆڵەوانیت،","poem":1},{"text":"لەتاو هەوەسی با هەڵدەمژێت،","poem":2},{"lineBreak":true},{"text":"لە کاتی بەتەڵەب هاتنی کێ دەیگێڕێتەوە؟","poem":2},{"text":"هەموو ئەوانەی داوای دەکەن","poem":1},{"text":"بەبێ ماندووبوون لە کاتی زاوزێ دەیدۆزنەوە.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ئەوەندە مەگەڕێ تاوەکو ئەوەی پێیەکانت ڕووت بێتەوە و","poem":1},{"text":"گەرووت وشک بێت.","poem":2},{"text":"بەڵام گوتت: ”بێهوودەیە!","poem":1},{"text":"نا! چونکە خوداوەندە بێگانەکانم خۆشویستووە،","poem":2},{"lineBreak":true},{"text":"دوای ئەوان دەکەوم.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«وەک شەرمەزاری دز کە دەگیرێت،","poem":1},{"text":"ئاوا بنەماڵەی ئیسرائیل شەرمەزاربوون،","poem":2},{"text":"خۆیان و پاشا و میر و","poem":1},{"text":"کاهین و پێغەمبەرەکانیان.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"هەریەکەیان بە دار دەڵێت: ”تۆ باوکی منیت“ و","poem":1},{"text":"بە بەرد: ”تۆ منت بووە.“","poem":2},{"text":"پشتیان تێ کردم","poem":1},{"text":"نەک ڕوو،","poem":2},{"text":"بەڵام لە کاتی بەڵایاندا دەڵێن:","poem":1},{"text":"”هەستە و ڕزگارمان بکە!“","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ئیتر کوا خوداوەندەکانت کە بۆ خۆت دروستت کردن؟","poem":1},{"text":"با هەستن، ئەگەر لە کاتی بەڵادا دەتوانن ڕزگارت بکەن!","poem":2},{"text":"ئەی یەهودا،","poem":1},{"text":"خوداوەندەکانت بەقەد ژمارەی شارۆچکەکانتن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"یەزدان دەفەرموێت: «بۆچی سکاڵام لێ دەکەن؟","poem":1},{"text":"هەمووتان لێم یاخی بوون،","poem":2}]},{"type":"verse","number":30,"content":[{"text":"بەخۆڕایی سزای منداڵەکانتانم دا،","poem":1},{"text":"تەمبێکردنیان وەرنەگرت،","poem":2},{"text":"شمشێرەکانتان پێغەمبەرەکانتانی خوارد،","poem":1},{"text":"وەک شێرێکی لەناوبەر.","poem":2}]},{"type":"verse","number":31,"content":["«ئەی نەوە، ئێوە ئاگاداری فەرمایشتی یەزدان بن:",{"text":"«ئایا بۆ ئیسرائیل بووم بە چۆڵەوانی،","poem":1},{"text":"یان خاکی تاریک و تنۆک؟","poem":2},{"text":"بۆچی گەلەکەم دەڵێن: ”بەڕەڵا بووین،","poem":1},{"text":"ئیتر بۆ لات نایەینەوە؟“","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ئایا کچ خشڵی خۆی لەبیر دەکات،","poem":1},{"text":"یان بووک جلی بووکێنی؟","poem":2},{"text":"بەڵام گەلەکەی خۆم ڕۆژانێکی بێشومار","poem":1},{"text":"منیان لەبیر کرد.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"تۆ چەند لێزانیت لە گەڕان بەدوای خۆشەویستیدا!","poem":1},{"lineBreak":true},{"text":"تەنانەت سۆزانییەکانیشت فێری ڕێگای خۆت کرد.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"هەروەها بە جلەکانتەوە دەبینرێت،","poem":1},{"text":"خوێنی گیانی نەدارە بێتاوانەکان،","poem":2},{"text":"هەرچەندە ئەوانت لە کاتی دیواربڕیندا نەگرت.","poem":1},{"text":"بەڵام لە سەرووی هەموو ئەمانەشەوە","poem":2}]},{"type":"verse","number":35,"content":[{"text":"دەڵێیت: ”من بێتاوانم،","poem":1},{"text":"خودا لە من تووڕە نییە.“","poem":2},{"text":"بەڵام دادگاییت دەکەم،","poem":1},{"text":"چونکە گوتت: ”گوناهم نەکرد.“","poem":2}]},{"type":"verse","number":36,"content":[{"text":"بۆچی زۆر دەگەڕێیت","poem":1},{"text":"بۆ گۆڕینی ڕێگاکانت؟","poem":2},{"text":"هەروەها لە میسریش شەرمەزار دەبیت،","poem":1},{"text":"وەک چۆن لە ئاشور شەرمەزار بوویت.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"هەروەها میسر بەجێدەهێڵیت و","poem":1},{"text":"وەک دیل دەستەکانت بەسەر سەرتەوە","poem":2},{"noteId":4},{"text":"دەبن،","poem":2},{"text":"چونکە ئەوانەی تۆ پشتیان پێ دەبەستیت یەزدان ڕەتیکردنەوە،","poem":1},{"text":"بەوان سەرکەوتوو نابیت.»","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":1,"caller":"+","text":"قوبرس و کەنارەکانی ڕۆژئاوای.‏","reference":{"chapter":2,"verse":10}},{"noteId":2,"caller":"+","text":"ناوچەی هۆزەکانی بەدوو لە بیابانی عەرەبستان و سوریا.‏","reference":{"chapter":2,"verse":10}},{"noteId":3,"caller":"+","text":"مەبەستی لە ڕەتکردنەوەی ڕێنمایی و دەسەڵاتی خودایە.‏","reference":{"chapter":2,"verse":20}},{"noteId":4,"caller":"+","text":"نیشانەی شەرمەزاری.‏","reference":{"chapter":2,"verse":37}}]},"thisChapterLink":"/api/ckb_bib/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}