{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["گەڕاندنەوەی ئیسرائیل"]},{"type":"verse","number":1,"content":["ئەمە ئەو پەیامەیە کە لەلایەن یەزدانەوە بۆ یەرمیا هات:"]},{"type":"verse","number":2,"content":["«یەزدانی پەروەردگاری ئیسرائیل ئەمە دەفەرموێت: ”هەموو ئەو وشانەی کە پێم فەرموویت، لە پەڕتووکێکدا بیاننووسە.“"]},{"type":"verse","number":3,"content":["یەزدان دەفەرموێت: ”سەردەمێک دێت، ئیسرائیل و یەهودای گەلەکەم لە ڕاپێچکراوی دەگەڕێنمەوە، دەیانهێنمەوە ئەو خاکەی بە باوباپیرانی ئەوانم دابوو، بۆ ئەوەی خاوەنداریێتی بکەن.“» ئەوە فەرمایشتی یەزدانە."]},{"type":"verse","number":4,"content":["ئەمانەش ئەو وشانەن کە یەزدان سەبارەت بە ئیسرائیل و یەهودا فەرمووی:"]},{"type":"verse","number":5,"content":["«یەزدان ئەمە دەفەرموێت:",{"text":"«”هاواری ترسمان بیست،","poem":1},{"text":"تۆقین نەک ئاشتی.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بپرسن و ببینن:","poem":1},{"text":"ئایا نێر سکی دەبێت؟","poem":2},{"text":"ئەی بۆچی هەر پیاوێک دەبینم","poem":1},{"text":"وەک ژنی ژانگرتوو دەستی بە کەمەرییەوەیە و","poem":2},{"lineBreak":true},{"text":"هەموو ڕووشی زەرد هەڵگەڕاوە؟","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئای! لەو ڕۆژە سامناکە!","poem":1},{"text":"ڕۆژی ئاوا نابێت.","poem":2},{"text":"ئەمە کاتی تەنگانەیە بۆ یاقوب،","poem":1},{"text":"بەڵام لێی ڕزگار دەبێت.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«یەزدانی سوپاسالار دەفەرموێت،","poem":1},{"text":"”لەو ڕۆژەدا، ئەو نیرە دەشکێنم کە لە ملیانە،","poem":2},{"text":"پێبەندیان دەپسێنم و","poem":1},{"text":"چیتر بێگانە نایانکەن بە کۆیلە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بەڵکو یەزدانی پەروەردگاریان دەپەرستن و","poem":1},{"text":"خزمەتی داودی پاشایان دەکەن،","poem":2},{"noteId":44},{"lineBreak":true},{"text":"ئەوەی کە بۆیان دایدەنێم.“»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"یەزدان دەفەرموێت: «”ئەی یاقوبی بەندەم، مەترسە،","poem":1},{"text":"ئەی ئیسرائیل، مەتۆقە.","poem":2},{"text":"بە دڵنیاییەوە من لەم شوێنە دوورە ڕزگارت دەکەم،","poem":1},{"text":"نەوەکەشت لەو خاکەوەی بۆی ڕاپێچ کراوە.","poem":2},{"text":"یاقوب دەگەڕێتەوە و ئاسوودە دەبێت،","poem":1},{"text":"دڵنیا دەبێت و کەس نایتۆقێنێت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"من لەگەڵتدام و ڕزگارت دەکەم.“","poem":1},{"text":"یەزدان دەفەرموێت:","poem":2},{"text":"”ئەگەر کۆتایی بە هەموو ئەو نەتەوانە بهێنم","poem":1},{"text":"کە لەنێویاندا پەرتەوازەم کردیت،","poem":2},{"lineBreak":true},{"text":"کۆتایی بە تۆ ناهێنم.","poem":2},{"text":"تەمبێت دەکەم، بەڵام بە دادپەروەری،","poem":1},{"text":"بێ سزا بەڕەڵات ناکەم.“","poem":2}]},{"type":"verse","number":12,"content":["«یەزدان ئەمە دەفەرموێت:",{"text":"«”شکاوییەکەت بێ چارەیە،","poem":1},{"text":"برینەکەت سەختە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"کەس نییە داکۆکی لە کێشەی تۆ بکات،","poem":1},{"text":"دەرمان نییە بۆ برینەکەی تۆ،","poem":2},{"lineBreak":true},{"text":"تۆ چاک نابیتەوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"هەموو هاوپەیمانەکانت لەبیریان کردوویت،","poem":1},{"text":"هیچ گرنگی بە تۆ نادەن.","poem":2},{"text":"وەک لێدان لە دوژمن لە تۆم دا،","poem":1},{"text":"بە سەختی تەمبێم کردی","poem":2},{"text":"لەسەر زۆری تاوانەکانت،","poem":1},{"text":"لەسەر گەورەیی گوناهەکانت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بۆچی لەبەر شکانەکەت هاوار دەکەیت،","poem":1},{"text":"لەبەر ئازارەکەت کە چارەسەر ناکرێت؟","poem":2},{"text":"بەهۆی زۆری تاوانەکانت و گەورەیی گوناهەکانت،","poem":1},{"text":"منیش ئەمەم پێکردیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«”بەڵام هەموو ئەوانەی تۆیان خوارد دەخورێن،","poem":1},{"text":"هەموو دوژمنەکانت ڕاپێچ دەکرێن.","poem":2},{"text":"ڕاووڕووتکەرانت ڕاووڕووت دەکرێن و","poem":1},{"text":"هەموو تاڵانکەرانت دەکەم بە تاڵانی.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"بەڵام تەندروستیت دەگەڕێنمەوە،","poem":1},{"text":"برینەکانت چاک دەکەمەوە،","poem":2},{"text":"چونکە ناویان لێنایت دوورخراوەکە،","poem":1},{"text":"سییۆن، ئەوەی کەس گرنگی پێ نادات.“","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":18,"content":["«یەزدان ئەمە دەفەرموێت:",{"text":"«”من ڕاپێچکراوانی چادرەکانی یاقوب دەگەڕێنمەوە،","poem":1},{"text":"بەزەییم بە نشینگەکانی دێتەوە.","poem":2},{"text":"شار لەسەر گردەکەی خۆی بنیاد دەنرێتەوە،","poem":1},{"text":"کۆشک لە شوێنی خۆی بنیاد دەنرێتەوە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"دەنگی گۆرانی سوپاسگوزاری و","poem":1},{"text":"بەزمیان لێ بەرز دەبێتەوە.","poem":2},{"text":"ژمارەیان زۆر دەکەم و","poem":1},{"text":"کەم نابن،","poem":2},{"text":"ڕێزیان لێ دەنێم و","poem":1},{"text":"بچووک نابن.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"کوڕەکانی وەک جاری جاران دەبن،","poem":1},{"text":"کۆمەڵەکەی لەبەردەمم دەچەسپێت،","poem":2},{"lineBreak":true},{"text":"سزای هەموو ئەوانە دەدەم کە ستەمی لێ دەکەن.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"میرەکەیان یەکێک دەبێت لەنێو خۆیان،","poem":1},{"text":"فەرمانڕەواکەیان لە خۆیان هەڵدەکەوێت.","poem":2},{"text":"لە خۆمی نزیک دەکەمەوە و لێم نزیک دەبێتەوە،","poem":1},{"text":"چونکە کەس ناوێرێت بەبێ ویستی من لێم نزیک بێتەوە.“»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":22,"content":[{"text":"«”ئێوە دەبن بە گەلی من و","poem":1},{"text":"منیش دەبم بە خودای ئێوە.“»","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ئەوەتا گەردەلوولی یەزدان","poem":1},{"text":"تووڕەییە هەڵدەچێت،","poem":2},{"text":"گەردەلوولێکی ڕاماڵە،","poem":1},{"text":"لەسەر سەری بەدکاران هەڵدەکات.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"گڕی تووڕەیی یەزدان دانامرکێتەوە","poem":1},{"text":"هەتا نیازەکانی دڵی خۆی","poem":2},{"lineBreak":true},{"text":"بە تەواوی بەجێنەگەیەنێت.","poem":2},{"text":"لە ڕۆژانی داهاتوودا","poem":1},{"text":"لەمە تێ دەگەن.","poem":2}]}],"footnotes":[{"noteId":44,"caller":"+","text":"مەبەستی لە یەکێکە لە نەوەکانی داود.‏","reference":{"chapter":30,"verse":9}}]},"thisChapterLink":"/api/ckb_bib/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}