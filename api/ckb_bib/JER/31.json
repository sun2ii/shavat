{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["یەزدان دەفەرموێت: «لەو کاتەدا، دەبم بە خودای هەموو خێڵەکانی ئیسرائیل، ئەوانیش دەبن بە گەلی من.»"]},{"type":"verse","number":2,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«ئەو گەلەی لە دەمی شمشێر دەربازبوون","poem":1},{"text":"لە چۆڵەوانی میهرەبانییان دەستکەوت،","poem":2},{"lineBreak":true},{"text":"کاتێک هاتم ئیسرائیل بحەوێنمەوە.»","poem":2}]},{"type":"verse","number":3,"content":["لە دێرزەمانەوە یەزدانمان بۆ دەرکەوتووە و دەفەرموێت:",{"text":"«بە خۆشویستنێکی هەتاهەتایی ئێوەم خۆشدەوێت،","poem":1},{"text":"لەبەر ئەوە بەردەوامیم دا بە خۆشەویستی نەگۆڕم بۆ ئێوە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەی ئیسرائیلی پاکیزە، بنیادت دەنێمەوە،","poem":1},{"text":"بنیاد دەنرێیتەوە.","poem":2},{"text":"دووبارە دەفەکانت هەڵدەگریتەوە","poem":1},{"text":"بۆ ناو سەمای بەزمگێڕان دەچیت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"دووبارە ڕەزەمێو دەچێنیت","poem":1},{"text":"لە چیاکانی سامیرە،","poem":2},{"text":"ڕەزەوانەکان دەچێنن و","poem":1},{"text":"بەرەکەی دەخۆن","poem":2},{"noteId":45},{"text":".","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ڕۆژێک دێت","poem":1},{"text":"چاودێران لە شاخەکانی ئەفرایم بانگەواز دەکەن:","poem":2},{"text":"”وەرن، با بۆ سییۆن سەربکەوین،","poem":1},{"text":"بۆ لای یەزدانی پەروەردگارمان.“»","poem":2}]},{"type":"verse","number":7,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«بە شادییەوە گۆرانی بۆ یاقوب بڵێن،","poem":1},{"text":"هاواری خۆشی بکەن بۆ سەر باشترین نەتەوە.","poem":2},{"text":"با ستایشتان ببیسترێت و بڵێن:","poem":1},{"text":"”ئەی یەزدان، گەلی خۆت ڕزگار بکە،","poem":2},{"lineBreak":true},{"text":"پاشماوەکەی ئیسرائیل!“","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەوەتا من لە خاکی باکوورەوە دەیانهێنمەوە،","poem":1},{"text":"لە هەموو لایەکی زەوی کۆیان دەکەمەوە،","poem":2},{"text":"لەنێویان شەل و نابینا دەبێت","poem":1},{"text":"ژنی سکپڕ و ژانگرتوو پێکەوە،","poem":2},{"lineBreak":true},{"text":"کۆمەڵێکی گەورە دەگەڕێنەوە بۆ ئێرە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بە گریانەوە دێن،","poem":1},{"text":"لەو کاتەی دەیانگەڕێنمەوە دەپاڕێنەوە،","poem":2},{"text":"بەلای ڕووبارە ئاوەکاندا دەیانبەم،","poem":1},{"text":"بە ڕێگایەکی ڕاست، تێیدا ساتمە ناکەن و ناکەون،","poem":2},{"text":"چونکە من باوکی ئیسرائیلم،","poem":1},{"text":"ئەفرایم نۆبەرەمە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«ئەی نەتەوەکان، گوێ لە فەرمایشتی یەزدان بگرن،","poem":1},{"text":"لە کەنارە دوورەکان ڕابگەیەنن:","poem":2},{"text":"”ئەوەی ئیسرائیلی پەرتەوازە کرد، کۆیان دەکاتەوە،","poem":1},{"text":"وەک شوان مێگەلی خۆی دەپارێزێت،“","poem":2}]},{"type":"verse","number":11,"content":[{"text":"چونکە یەزدان نرخی ئازادبوونی یاقوبی دا،","poem":1},{"text":"لە دەست ئەوەی لەو","poem":2},{"noteId":46},{"text":"بەهێزتر بوو کڕییەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"جا دێن و لە بەرزاییەکانی سییۆن هاواری خۆشی دەکەن.","poem":1},{"text":"لەبەر خێروبێری یەزدان دەگەشێنەوە،","poem":2},{"text":"بەسەر دانەوێڵە و شەرابی نوێ و زەیتەوە،","poem":1},{"text":"بەسەر بەرخ و گوێرەکەوە.","poem":2},{"text":"وەک باخچەیەکی تێر ئاو دەبن،","poem":1},{"text":"جارێکی دیکە سیس نابن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەوسا پاکیزەکان سەما دەکەن و دڵشاد دەبن،","poem":1},{"text":"گەنجان و پیران پێکەوە.","poem":2},{"text":"شینیان دەگۆڕم بە شادی،","poem":1},{"text":"دڵنەواییان دەکەم و لەدوای پەژارەییان دڵخۆشیان دەکەم.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"کاهینەکان تێر دەکەم لە چەوری،","poem":1},{"text":"گەلەکەم لە خێروبێرم تێر دەبن.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":15,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«دەنگێک لە ڕامەوە بیسترا،","poem":1},{"text":"گریان و شیوەنێکی گەورە،","poem":2},{"text":"ڕاحێل بۆ منداڵەکانی دەگریێت،","poem":1},{"text":"ڕازی نییە دڵنەوایی بکرێت،","poem":2},{"lineBreak":true},{"text":"چونکە نەماون.»","poem":2}]},{"type":"verse","number":16,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«واز لە گریان بهێنە و","poem":1},{"text":"چاوت فرمێسک هەڵنەڕێژێ،","poem":2},{"text":"چونکە کردەوەکەت پاداشتی هەیە.»","poem":1},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4},{"text":"«لە خاکی دوژمن دەگەڕێنەوە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"کەواتە هیوا بە دواڕۆژت هەیە.","poem":1},{"text":"منداڵەکانت دەگەڕێنەوە خاکی خۆیان.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«بە دڵنیاییەوە گوێم لێ بوو ئەفرایم ئاخی هەڵدەکێشا:","poem":1},{"text":"”وەک گوێرەکەیەکی دەستەمۆنەکراو تەمبێت کردم،","poem":2},{"lineBreak":true},{"text":"من تەمبێ بووم.","poem":2},{"text":"بمگەڕێنەوە لای خۆت، دەگەڕێمەوە،","poem":1},{"text":"چونکە تۆ یەزدانی پەروەردگاری منی.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"لەدوای گومڕابوونم،","poem":1},{"text":"پەشیمان بوومەوە،","poem":2},{"text":"لەدوای تێگەیشتنم،","poem":1},{"text":"لە سنگی خۆمم دا.","poem":2},{"text":"شەرمەزار بووم و گاڵتەم پێ کرا،","poem":1},{"text":"چونکە ڕیسوایی کاتی مێردمنداڵیم بە کۆڵمەوە بوو.“","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئایا ئەفرایم کوڕی ئازیزم نییە،","poem":1},{"text":"ئەو منداڵەی دڵم پێی خۆشە؟","poem":2},{"text":"لەبەر ئەوەی هەر کاتێک لە دژی ئەو دەدوێم،","poem":1},{"text":"دووبارە دێتەوە یادم.","poem":2},{"text":"لەبەر ئەوە هەناوم بۆی دەسووتێت،","poem":1},{"text":"بە تەواوی بەزەییم پێیدا دێتەوە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«نیشانە بۆ خۆت بچەقێنە و","poem":1},{"text":"ڕێوشوێن دابنێ.","poem":2},{"text":"بە وردی بڕوانە ڕێگاکە،","poem":1},{"text":"ئەو ڕێگایەی پێیدا دەڕۆن.","poem":2},{"text":"ئەی ئیسرائیلی پاکیزە، بگەڕێوە،","poem":1},{"text":"بگەڕێوە بۆ شارۆچکەکانت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"هەتا کەی بەم لاو بەو لادا دەڕۆیت،","poem":1},{"text":"ئەی کچی هەڵگەڕاوە؟","poem":2},{"text":"چونکە یەزدان شتێکی نوێی لەسەر زەوی بەدیهێناوە:","poem":1},{"text":"ژن پیاو دەپارێزێت.»","poem":2}]},{"type":"verse","number":23,"content":["یەزدانی سوپاسالار، خودای ئیسرائیل ئەمە دەفەرموێت: «کاتێک ڕاپێچکراوەکانیان دەگەڕێنمەوە، جارێکی دیکە ئەم وشانە لە خاکی یەهودا و لە شارۆچکەکانی دەڵێنەوە: ”ئەی نشینگەی ڕاستودروستی، ئەی کێوی پیرۆز! یەزدان بەرەکەتدارت بکات.“"]},{"type":"verse","number":24,"content":["جا خەڵکەکە لە یەهودا و هەموو شارۆچکەکانی نیشتەجێ دەبن، جوتیار و ڕەوەندەکان لەگەڵیان دەبن."]},{"type":"verse","number":25,"content":["ماندوو دەبووژێنمەوە، هەموو سیسێک تێر دەکەم.»"]},{"type":"verse","number":26,"content":["لێرەدا بەئاگاهاتم و تەماشای دەوروبەرم کرد. خەوەکەم خۆش بوو."]},{"type":"verse","number":27,"content":["یەزدان دەفەرموێت: «ئەوەتا سەردەمێک دێت، ژمارەی خەڵک و ژمارەی ئاژەڵ لە ئیسرائیل و یەهودا زۆر زیاد دەکەم."]},{"type":"verse","number":28,"content":["جا چۆن چاودێر بووم بۆ ڕیشەکێشکردن و ڕووخاندن، بۆ کاولکاری، بۆ لەناوبردن و بەڵا بەسەرهێنان، ئاواش چاودێر دەبم بۆ بنیادنانەوە و چاندن.» ئەوە فەرمایشتی یەزدانە."]},{"type":"verse","number":29,"content":["«لەو ڕۆژانەدا ئیتر ناڵێن:",{"text":"«”باوکان بەرسیلەیان خوارد،","poem":1},{"text":"ددانی منداڵەکان ئاڵ دەبێت.“","poem":2}]},{"type":"verse","number":30,"content":["بەڵکو هەرکەسە و بە تاوانی خۆیەوە دەمرێت، هەرکەسێک بەرسیلە بخوات ددانی خۆی ئاڵ دەبێت.»"]},{"type":"verse","number":31,"content":[{"text":"یەزدان دەفەرموێت: «ئەوەتا سەردەمێک دێت،","poem":1},{"text":"پەیمانێکی نوێ","poem":2},{"noteId":47},{"text":"لەگەڵ بنەماڵەی ئیسرائیل و","poem":2},{"lineBreak":true},{"text":"بنەماڵەی یەهودا دەبەستم.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"وەک ئەو پەیمانە نابێت","poem":1},{"text":"کە لەگەڵ باوباپیرانیاندا بەستم،","poem":2},{"text":"ئەو ڕۆژەی دەستی ئەوانم گرت","poem":1},{"text":"بۆ ئەوەی لە خاکی میسر دەریانبهێنم،","poem":2},{"text":"چونکە ئەوان پەیمانەکەی منیان شکاند،","poem":1},{"text":"هەرچەندە من مێردی","poem":2},{"noteId":48},{"text":"ئەوان بووم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":33,"content":[{"text":"یەزدان دەفەرموێت: «ئەمە ئەو پەیمانەیە کە لەدوای ئەو ڕۆژانە","poem":1},{"text":"لەگەڵ بنەماڵەی ئیسرائیلدا دەیبەستم،","poem":2},{"text":"فێرکردنەکانم دەخەمە ناو مێشکیان و","poem":1},{"text":"لەسەر دڵیان دەینووسم.","poem":2},{"text":"من دەبم بە خودای ئەوان و","poem":1},{"text":"ئەوانیش دەبن بە گەلی من.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"لەمەودوا کەس هاوڕێکەی خۆی","poem":1},{"text":"یان براکەی خۆی فێرناکات و بڵێت: ”یەزدان بناسە،“","poem":2},{"text":"چونکە هەموویان دەمناسن،","poem":1},{"text":"لە بچووکیانەوە هەتا گەورەیان،","poem":2},{"text":"چونکە لە تاوانەکانیان خۆشدەبم،","poem":1},{"text":"چیتر گوناهەکانیان بەبیری خۆم ناهێنمەوە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":35,"content":["یەزدان ئەمە دەفەرموێت،",{"text":"ئەوەی خۆری داناوە","poem":1},{"text":"بۆ درەوشانەوە لە ڕۆژ،","poem":2},{"text":"فەرزی مانگ و ئەستێرەکانیش","poem":1},{"text":"بۆ درەوشانەوە لە شەو،","poem":2},{"text":"ئەوەی دەریا دەوروژێنێت،","poem":1},{"text":"شەپۆلەکانی هاژەیان دێت،","poem":2},{"lineBreak":true},{"text":"ناوی یەزدانی سوپاسالارە،","poem":2}]},{"type":"verse","number":36,"content":[{"text":"یەزدان دەفەرموێت:","poem":1},{"text":"«ئەگەر ئەم فەرزانە لەبەرچاوم نەمێنن،","poem":2},{"text":"ئەوسا ڕەچەڵەکی ئیسرائیلیش کپ دەبن","poem":1},{"text":"لەوەی بە درێژایی ڕۆژگار لەبەردەمم ببن بە نەتەوە.»","poem":2}]},{"type":"verse","number":37,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«ئەگەر ئاسمان لە سەرەوە بپێورێت،","poem":1},{"text":"ئەگەر بناغەکانی زەوی لە ژێرەوە بپشکنرێن،","poem":2},{"text":"ئەوسا منیش هەموو ڕەچەڵەکی ئیسرائیل ڕەت دەکەمەوە،","poem":1},{"text":"لەبەر هەموو ئەوەی کردیان.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":38,"content":["یەزدان دەفەرموێت: «سەردەمێک دێت، شارەکە بۆ یەزدان بنیاد دەنرێت، لە قوللەی حەنەنێلەوە هەتا دەروازەی گۆشەکە."]},{"type":"verse","number":39,"content":["لەوێوە گوریسی پێوانە بەسەر گردی گارێڤ درێژ دەکرێت و دەسووڕێتەوە بۆ گۆعە."]},{"type":"verse","number":40,"content":["تەواوی ئەو دۆڵەی لاشە و خۆڵەمێشی تێدا فڕێدەدرێت، هەروەها هەموو کێڵگەکان بۆ دۆڵی قدرۆن لە ڕۆژهەڵات تاوەکو دەروازەی ئەسپ پیرۆز دەبێت بۆ یەزدان، هەتاهەتایە ڕیشەکێش ناکرێت و جارێکی دیکە کاول ناکرێتەوە.»"]}],"footnotes":[{"noteId":45,"caller":"+","text":"واتا یەزدان نیشتەجێیان دەکاتەوە بۆ ماوەیەکی دوورودرێژ کە بتوانن بەری دارەکانیان بخۆن، چونکە دروست نەبوو بەری هیچ دارێک بخۆن هەتا ساڵی پێنجەم.‏","reference":{"chapter":31,"verse":5}},{"noteId":46,"caller":"+","text":"مەبەست لە فیرعەونی میسرە کە لە گەلی ئیسرائیل بەهێزتر بوو.‏","reference":{"chapter":31,"verse":11}},{"noteId":47,"caller":"+","text":"بڕوانە مەتا 26‏:28 و عیبرانییەکان 8‏:13‏‏.‏","reference":{"chapter":31,"verse":31}},{"noteId":48,"caller":"+","text":"پەیوەندی نێوان خودا و گەلەکەی بە پەیوەندی نێوان ژن و مێرد دەچووێنرێت، لە ڕووی ئەرک و وەفا و گوێڕایەڵییەوە.‏","reference":{"chapter":31,"verse":32}}]},"thisChapterLink":"/api/ckb_bib/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}