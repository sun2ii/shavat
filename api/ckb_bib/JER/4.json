{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"یەزدان دەفەرموێت: «ئەی ئیسرائیل، ئەگەر گەڕایتەوە،","poem":1},{"text":"بگەڕێوە لای من.","poem":2},{"text":"ئەگەر بتە قێزەونەکانت لەبەردەمم لابدەی،","poem":1},{"text":"گومڕا نابیت،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەگەر بە ڕاستی و دادپەروەری و ڕاستودروستییەوە","poem":1},{"text":"سوێند بخۆیت: ”بە یەزدانی زیندوو،“","poem":2},{"text":"ئەوسا نەتەوەکان بەو بەرەکەتدار دەبن و","poem":1},{"text":"شانازی بەوەوە دەکەن.»","poem":2}]},{"type":"verse","number":3,"content":["یەزدان ئەمە بە پیاوەکانی یەهودا و ئۆرشەلیم دەفەرموێت:",{"text":"«زەوی بەیارتان بکێڵن و","poem":1},{"text":"لەناو دڕکوداڵدا مەچێنن.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەی پیاوانی یەهودا و دانیشتووانی ئۆرشەلیم،","poem":1},{"text":"خۆتان بۆ یەزدان خەتەنە","poem":2},{"noteId":7},{"text":"بکەن،","poem":2},{"lineBreak":true},{"text":"دڵتان خەتەنە بکەن،","poem":2},{"text":"نەوەک تووڕەییم بجۆشێت و وەک ئاگر بسووتێنێت،","poem":1},{"text":"لەبەر خراپی کردەوەکانتان،","poem":2},{"lineBreak":true},{"text":"بسووتێنێت و کەس ناتوانێت بیکوژێنێتەوە.»","poem":2}]},{"type":"heading","content":["بەڵایەک لە باکوورەوە"]},{"type":"verse","number":5,"content":[{"text":"«لە یەهودا ڕایبگەیەنن، لە ئۆرشەلیم دەنگتان ببیسترێت، بڵێن:","poem":1},{"text":"”لە خاکەکە فوو بە کەڕەنادا بکەن!“","poem":2},{"text":"بە دەنگی بەرز بانگەواز بکەن و بڵێن: ”کۆببنەوە!","poem":1},{"text":"با هەڵبێین بۆ شارە قەڵابەندەکان!“","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئاڵا بەرز بکەنەوە بۆ چوونە سییۆن!","poem":1},{"text":"خۆتان بدەنە پەنا! ڕامەوەستن!","poem":2},{"text":"چونکە من لە باکوورەوە بەڵا دەهێنم،","poem":1},{"text":"تێکشکانێکی گەورە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"شێر لە لانەکەیەوە هاتە دەرەوە،","poem":1},{"text":"تێکشکێنەری نەتەوەکان بەڕێکەوت.","poem":2},{"text":"لە شوێنەکەی خۆی هاتە دەرەوە","poem":1},{"text":"بۆ ئەوەی خاکەکەت وێران بکات.","poem":2},{"text":"شارۆچکەکانت کاول دەبن","poem":1},{"text":"بێ ئاوەدانی دەبن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"لەبەر ئەمە جلوبەرگی گوش","poem":1},{"noteId":8},{"text":"لەبەر بکەن،","poem":1},{"text":"لە خۆتان بدەن و واوەیلا بکەن،","poem":2},{"text":"چونکە گڕی تووڕەیی یەزدان","poem":1},{"text":"هێشتا دانەمرکاوەتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"یەزدان دەفەرموێت: «جا ئەوە دەبێت لەو ڕۆژەدا،","poem":1},{"text":"پاشا و پیاوە گەورەکان جەرگبڕاو دەبن،","poem":2},{"text":"کاهینەکان دەحەپەسێن و","poem":1},{"text":"پێغەمبەرەکان واقیان وڕدەمێنێت.»","poem":2}]},{"type":"verse","number":10,"content":["جا گوتم: «ئای، ئەی یەزدانی باڵادەست، بێگومان ئەم گەلە و ئۆرشەلیمت بە تەواوی فریودا، فەرمووت: ”ئاشتیتان بۆ دەبێت،“ کەچی شمشێر گەیشتە گیانمان.»"]},{"type":"verse","number":11,"content":["لەو کاتەدا بەم گەلە و بە ئۆرشەلیم دەگوترێت: «بای سووتێنەر لە گردۆڵکەکانی چۆڵەوانییەوە بەرەو گەلەکەم هەڵدەکات، نە بۆ شەن و نە بۆ جیاکردنەوە،"]},{"type":"verse","number":12,"content":["بایەکی لەوە بەگوڕترە، لە منەوە دێت. ئێستاش من حوکمی خۆم بەسەریاندا ڕادەگەیەنم.»"]},{"type":"verse","number":13,"content":[{"text":"تەماشا بکەن! وەک هەورەکان سەردەکەوێت،","poem":1},{"text":"گالیسکەکانی وەک گەردەلوولە،","poem":2},{"text":"ئەسپەکانی لە هەڵۆ تیژڕەوترن.","poem":1},{"text":"قوڕبەسەرمان، وێران کراین!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەی ئۆرشەلیم، دڵت لە خراپە بشۆوە بۆ ئەوەی ڕزگارت بێت.","poem":1},{"text":"هەتا کەی بیروڕا خراپەکانت لە ناوەڕاستت دەمێنێتەوە؟","poem":2}]},{"type":"verse","number":15,"content":[{"text":"دەنگێک لە دانەوە ڕادەگەیەنێت،","poem":1},{"text":"کارەسات لە شاخەکانی ئەفرایمەوە دەبیسترێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"«نەتەوەکان ئاگادار بکەنەوە،","poem":1},{"text":"با خەڵکی ئۆرشەلیم بیبیستن:","poem":2},{"text":"”ئابڵوقەدەران لە خاکێکی دوورەوە دێن،","poem":1},{"text":"بەسەر شارەکانی یەهودا دەنگیان بەرز دەکەنەوە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لە چواردەوری وەک پاسەوانانی کێڵگەیان لێهاتووە،","poem":1},{"text":"چونکە لە من یاخی بوون.“»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"«ڕەفتار و کردەوەکانت","poem":1},{"text":"ئەمەیان پێکردیت،","poem":2},{"text":"ئەمە سزاکەتە،","poem":1},{"text":"چەند تاڵە!","poem":2},{"lineBreak":true},{"text":"چونکە گەیشتە دڵت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ئەی ئازارم، ئەی ئازارم!","poem":1},{"text":"من لەتاو ئێشم دەتوێمەوە.","poem":2},{"text":"دڵم ژان دەکات!","poem":1},{"text":"دڵەکوتێمە، بێدەنگ نابم،","poem":2},{"lineBreak":true},{"text":"چونکە گوێم لە دەنگی کەڕەنا و نەعرەتەی جەنگ بوو.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"کارەسات لەدوای کارەسات دێت،","poem":1},{"text":"هەموو خاکەکە وێران بوو.","poem":2},{"text":"لەپڕ خێوەتەکانم وێران بوون،","poem":1},{"text":"لە چرکەیەکدا پەناگاکانم.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"هەتا کەی ئاڵای جەنگ دەبینم و","poem":1},{"text":"گوێم لە دەنگی کەڕەنا دەبێت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«گەلەکەم گێلە و","poem":1},{"text":"من ناناسێت.","poem":2},{"text":"ئەوان کوڕی دەبەنگن،","poem":1},{"text":"ئەوان تێنەگەیشتوون،","poem":2},{"text":"ئەوان دانان بۆ کاری خراپە،","poem":1},{"text":"بەڵام نازانن چۆن چاکە بکەن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"تەماشای زەویم کرد،","poem":1},{"text":"بێ شێوە و بەتاڵ بوو،","poem":2},{"text":"بەرەو ئاسمانیش،","poem":1},{"text":"ڕووناکییەکەی نەمابوو.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"تەماشای چیاکانم کرد دەهەژان،","poem":1},{"text":"هەموو گردەکانیش لەق بوون.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"تەماشام کرد، هیچ کەسێک دیار نەبوو،","poem":1},{"text":"باڵندەکانی ئاسمانیش هەموو هەڵاتبوون،","poem":2}]},{"type":"verse","number":26,"content":[{"text":"تەماشام کرد، باخەکان چۆڵەوانین و","poem":1},{"text":"هەموو شارۆچکەکانی کاول بوون","poem":2},{"lineBreak":true},{"text":"لەبەردەم یەزدان، لە ڕووی گڕی تووڕەییەکەی.","poem":2}]},{"type":"verse","number":27,"content":["سەبارەت بەمەش یەزدان بەم جۆرە دەفەرموێت:",{"text":"«هەموو زەوی وێران دەبێت،","poem":1},{"text":"بەڵام بە تەواوی کۆتایی پێ ناهێنم.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"لەبەر ئەمە زەوی شیوەن دەگێڕێت،","poem":1},{"text":"ئاسمانیش لە سەرەوە تاریک دادێت،","poem":2},{"text":"لەبەر ئەوەی من قسەم کرد و پاشگەز نەبوومەوە،","poem":1},{"text":"بڕیارم دا و بڕیارەکەم ناگۆڕم.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"لە دەنگی سوار و تیرهاوێژ","poem":1},{"text":"هەموو شارۆچکەکان ڕایانکرد.","poem":2},{"text":"هەندێک چوونە ناو دارستانەکان،","poem":1},{"text":"هەندێک سەرکەوتنە سەر بەردەکان.","poem":2},{"text":"هەموو شارۆچکەکان بەجێهێڵراون،","poem":1},{"text":"هیچ کەسێک تێیاندا نیشتەجێ نییە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"تۆش ئەی نەتەوە وێرانەکە، چی دەکەیت؟","poem":1},{"text":"بۆچی بەرگی ئاڵ لەبەر دەکەیت و","poem":2},{"lineBreak":true},{"text":"خشڵی زێڕ بە خۆتەوە دەکەیت؟","poem":2},{"text":"بۆچی بە کل چاوەکانت ڕەش دەکەیت؟","poem":1},{"text":"بێهوودە خۆت جوان دەکەیت،","poem":2},{"text":"لەبەرچاوی ئەوینداران کەوتووی،","poem":1},{"text":"ئەوان داوای گیانت دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"هاوارێکم بیست وەک هاواری ژنێکی ژانگرتوو بوو،","poem":1},{"text":"لە ناخۆشیدا وەک یەکەم منداڵی بێت.","poem":2},{"text":"دەنگی سییۆنی کچ","poem":1},{"noteId":9},{"text":"هەنسک دەدات،","poem":1},{"text":"دەست پان دەکاتەوە، دەڵێت:","poem":2},{"text":"«وەی لە من! دەبوورێمەوە،","poem":1},{"text":"گیانم لەبەر بکوژان دەردەچێت!»","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"‏مەبەستی لە تەرخانکردنی دڵە بۆ دڵسۆزی بەرامبەر بە یەزدان.‏","reference":{"chapter":4,"verse":4}},{"noteId":8,"caller":"+","text":"لە کاتی ماتەمگێڕان و تۆبەکردندا جلوبەرگی لە گوش دروستکراویان لەبەرکردووە کە ئەزیەتی پێستیانی داوە.‏","reference":{"chapter":4,"verse":8}},{"noteId":9,"caller":"+","text":"دەربڕینێکی خوازەیە بۆ پایتەخت، مەبەست لە هەموو دانیشتووانی شارەکەیە.‏","reference":{"chapter":4,"verse":31}}]},"thisChapterLink":"/api/ckb_bib/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}