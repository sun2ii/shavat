{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["پەیامێک سەبارەت بە میسر"]},{"type":"verse","number":1,"content":["ئەمە فەرمایشتی یەزدانە بۆ یەرمیای پێغەمبەر سەبارەت بە نەتەوەکان:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["بۆ میسر:",{"lineBreak":true},"سەبارەت بە سوپاکەی نێخۆ فیرعەون، پاشای میسر، ئەوەی لەسەر ڕووباری فورات بوو لە کەرکەمیش، کە نەبوخودنەسری پاشای بابل لە ساڵی چوارەمی یەهۆیاقیمی کوڕی یۆشیای پاشای یەهودا لێیدا:"]},{"type":"verse","number":3,"content":[{"text":"«سپەر و قەڵغان ئامادە بکەن،","poem":1},{"text":"پێشکەون بۆ جەنگ!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەسپ زین بکەن،","poem":1},{"text":"ئەی سوارەکان، سەربکەون!","poem":2},{"text":"بە کڵاوی ئاسنینەوە لە ئامادەباشیدا بن!","poem":1},{"text":"ڕمەکان تیژ بکەن،","poem":2},{"lineBreak":true},{"text":"زرێیەکان","poem":2},{"noteId":60},{"text":"بپۆشن!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"چی دەبینم؟","poem":1},{"text":"ئەوان تۆقیون،","poem":2},{"text":"بەرەو پاش دەکشێنەوە،","poem":1},{"text":"پاڵەوانەکانیان بەزین.","poem":2},{"text":"بە پەلە هەڵاتن و","poem":1},{"text":"ئاوڕیشیان نەدایەوە،","poem":2},{"lineBreak":true},{"text":"لە هەموو لایەکەوە ترس و تۆقین هەیە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"«ئەوەی تیژڕەوە هەڵنایەت و","poem":1},{"text":"پاڵەوان دەرباز نابێت.","poem":2},{"text":"لە باکوور لەلای ڕووباری فورات","poem":1},{"text":"ساتمەیان کرد و کەوتن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ئەمە کێیە وەک ڕووباری نیل هەڵدەستێتەوە،","poem":1},{"text":"وەک ئەو ڕووبارانەی ئاوەکەیان شەپۆل دەدات؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"میسرە وەک ڕووباری نیل هەڵدەستێتەوە،","poem":1},{"text":"وەک ئەو ڕووبارانەی ئاوەکەیان شەپۆل دەدات.","poem":2},{"text":"دەڵێت: ”هەڵدەستم و زەوی دادەپۆشم،","poem":1},{"text":"شار و دانیشتووانەکەی لەناو دەبم.“","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەی ئەسپەکان، سەربکەون!","poem":1},{"text":"ئەی گالیسکەکان، سەرەڕۆ بن!","poem":2},{"text":"با پاڵەوانان بەرەو پێش بچن،","poem":1},{"text":"کوش و پووت قەڵغان بەدەستن،","poem":2},{"lineBreak":true},{"text":"لوودییەکان تیرەکانیان لە کەوانەکانیان ڕادەکێشن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بەڵام ئەمڕۆ ڕۆژی یەزدانە","poem":1},{"noteId":61},{"text":"، پەروەردگاری سوپاسالار،","poem":1},{"text":"ڕۆژی تۆڵەیە، تۆڵەسەندنەوە لە دوژمنانی.","poem":2},{"text":"جا شمشێر دەخوات و تێر دەبێت،","poem":1},{"text":"لە خوێنیان تێر دەخواتەوە،","poem":2},{"text":"چونکە یەزدان، پەروەردگاری سوپاسالار، قوربانی سەربڕاو پێشکەش دەکات","poem":1},{"text":"لە خاکی باکوور لەلای ڕووباری فورات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«سەربکەوە بۆ گلعاد و هەتووان بهێنە،","poem":1},{"text":"ئەی میسری کچە پاکیزە.","poem":2},{"text":"بەڵام بێهوودە داوودەرمان زۆر دەکەیت،","poem":1},{"text":"چاکبوونەوەت نییە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"نەتەوەکان سووکایەتی تۆیان بیستووە،","poem":1},{"text":"قیژەت دنیای پڕکردووە،","poem":2},{"text":"چونکە پاڵەوانێک ساتمە لە پاڵەوانێک دەکات،","poem":1},{"text":"هەردووکیان پێکەوە دەکەون.»","poem":2}]},{"type":"verse","number":13,"content":["ئەمە ئەو پەیامەیە کە یەزدان بە یەرمیای پێغەمبەری ڕاگەیاند، لەبارەی هێرشکردنی نەبوخودنەسری پاشای بابل بۆ سەر خاکی میسر:"]},{"type":"verse","number":14,"content":[{"text":"«ئەمە لە میسر ڕابگەیەنن، لە شاری مگدۆل جاڕبدەن،","poem":1},{"text":"هەروەها لە مەمفیس و تەحپەنحێس، بڵێن:","poem":2},{"text":"”وریابە و لە ئامادەباشیدا بە،","poem":1},{"text":"چونکە شمشێر دەوروبەرت دەخوات.“","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بۆچی توانادارەکانت بە زەویدا دران؟","poem":1},{"text":"نەوەستان، چونکە یەزدان ئەوانی خست.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بەردەوام ساتمە دەکەن،","poem":1},{"text":"بەسەر یەکتریدا دەکەون.","poem":2},{"text":"دەڵێن: ”هەستن با بگەڕێینەوە،","poem":1},{"text":"بۆ ناو گەلەکەمان و خاکی لەدایکبوونمان،","poem":2},{"lineBreak":true},{"text":"دوور لە شمشێری ستەمکاری.“","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لەوێ هاواریان دەکرد:","poem":1},{"text":"”فیرعەونی پاشای میسر تەنها هاتوهەرای هەیە،","poem":2},{"lineBreak":true},{"text":"دەرفەتی ئەو بەسەرچوو!“»","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"پاشا کە ناوی یەزدانی سوپاسالارە","poem":1},{"text":"دەفەرموێت: «بە گیانی خۆم،","poem":2},{"text":"کەسێک دێت وەک تاڤۆرە لەنێو چیاکان،","poem":1},{"text":"وەک کارمەلە لەلای دەریاوە دێت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەی دانیشتووانی میسر،","poem":1},{"text":"کەلوپەلەکانتان بۆ ڕاپێچ کۆبکەنەوە،","poem":2},{"text":"چونکە مەمفیس وێران دەبێت،","poem":1},{"text":"دەبێتە چۆڵەوانییەکی بێ ئاوەدانی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«میسر مانگایەکی زێدە جوانە،","poem":1},{"text":"بەڵام مێشومەگەز لە باکوورە بۆی دێت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"هەروەها سەربازە بەکرێگیراوەکانت لە ڕیزەکانی جەنگ،","poem":1},{"text":"وەک جوانەگای قەڵەون،","poem":2},{"text":"چونکە ئەوانیش ڕوو وەردەگێڕن،","poem":1},{"text":"تێکڕا هەڵدێن و ناوەستن،","poem":2},{"text":"چونکە ڕۆژی کارەسات گەیشتە سەریان،","poem":1},{"text":"کاتی سزادانیان.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"میسر وەک ماری هەڵاتوو فیشک دەدات،","poem":1},{"text":"چونکە دوژمنەکانی بە سوپاوە دێنە پێش،","poem":2},{"text":"هەروەک داربڕەکان","poem":1},{"text":"بە تەورەوە بۆی هاتن.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"دارستانەکەی دەبڕنەوە،","poem":1},{"text":"هەرچەندە زۆر چڕە،","poem":2},{"text":"چونکە لە کوللە زۆرترن،","poem":1},{"text":"لە ژمارە نایەن.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":24,"content":[{"text":"«دانیشتووانی میسر شەرمەزار دەبن،","poem":1},{"text":"درانە دەست گەلی باکوور.»","poem":2}]},{"type":"verse","number":25,"content":["یەزدانی سوپاسالار، خودای ئیسرائیل فەرمووی: «من خەریکم سزا دەسەپێنم، لەسەر ئامۆنی خودای شاری تیب و فیرعەون، لەسەر میسر و خوداوەندەکان و پاشاکانی، هەروەها لەسەر ئەوانەش کە پشتیان بە فیرعەون بەستووە."]},{"type":"verse","number":26,"content":["دەیاندەمە دەست ئەوانەی دەیانەوێت بیانکوژن، دەست نەبوخودنەسری پاشای بابل و دەست خزمەتکارەکانی. پاش ئەمە میسر وەک ڕۆژانی پێشتری ئاوەدان دەبێتەوە.» ئەمە فەرمایشتی یەزدانە."]},{"type":"verse","number":27,"content":[{"text":"«ئەی یاقوبی بەندەم، مەترسە،","poem":1},{"text":"ئەی ئیسرائیل، مەتۆقە.","poem":2},{"text":"بە دڵنیاییەوە من لەم شوێنە دوورە ڕزگارت دەکەم،","poem":1},{"text":"نەوەکەشت لەو خاکەوەی بۆی ڕاپێچ کراوە.","poem":2},{"text":"یاقوب دەگەڕێتەوە و ئاسوودە دەبێت،","poem":1},{"text":"دڵنیا دەبێت و کەس نایتۆقێنێت.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ئەی یاقوبی بەندەم، مەترسە،","poem":1},{"text":"چونکە من لەگەڵتدام.","poem":2},{"text":"هەرچەندە کۆتایی دەهێنم بە هەموو ئەو نەتەوانەی","poem":1},{"text":"کە بۆ ناویان پەرتەوازەم کردیت،","poem":2},{"lineBreak":true},{"text":"بەڵام تۆ بە تەواوی لەناو نابەم.","poem":2},{"text":"لە سزا ناتبوورم،","poem":1},{"text":"بە دادپەروەری تەمبێت دەکەم.» ئەمە فەرمایشتی یەزدانە.","poem":2}]}],"footnotes":[{"noteId":60,"caller":"+","text":"زرێ: بەڕگێکی کانزاییە کە لە کاتی شەڕ دەپۆشرێت.‏","reference":{"chapter":46,"verse":4}},{"noteId":61,"caller":"+","text":"ڕۆژی سزادانی گوناهباران و ڕزگارکردنی گەلی خودا.‏","reference":{"chapter":46,"verse":10}}]},"thisChapterLink":"/api/ckb_bib/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}