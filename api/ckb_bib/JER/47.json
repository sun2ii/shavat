{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["پەیامێک سەبارەت بە فەلەستییەکان"]},{"type":"verse","number":1,"content":["ئەمە فەرمایشتی یەزدانە بۆ یەرمیای پێغەمبەر سەبارەت بە فەلەستییەکان، بەر لەوەی فیرعەون پەلاماری غەزە بدات:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«ئەوەتا ئاو لە باکوورەوە هەڵدەستێت و","poem":1},{"text":"دەبێتە لافاوێکی ڕاماڵ،","poem":2},{"text":"زەوی و هەرچی لەسەریەتی ڕایدەماڵێت،","poem":1},{"text":"شار و دانیشتووانەکەی.","poem":2},{"text":"خەڵکی هاوار دەکەن،","poem":1},{"text":"هەموو دانیشتووانی خاکەکە واوەیلا دەکەن","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لە دەنگی تەقەی سمی ئەسپە بە تواناکانی،","poem":1},{"text":"لە خڕەی گالیسکەکانی و","poem":2},{"lineBreak":true},{"text":"جیڕەی چەرخەکانی.","poem":2},{"text":"باوک ئاوڕ لە کوڕ ناداتەوە","poem":1},{"text":"لەبەر شلبوونی دەستەکانی.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لەبەر ئەوەی ئەو ڕۆژە هاتووە","poem":1},{"text":"بۆ تەفروتوناکردنی فەلەستییەکان و","poem":2},{"text":"بۆ بڕینەوەی هەموو پاشماوەیەک","poem":1},{"text":"کە بتوانن پشتگیری پاشایەتی سور و سەیدا بکەن.","poem":2},{"text":"یەزدان خەریکە فەلەستییەکان تەفروتونا دەکات،","poem":1},{"text":"پاشماوەی کەناری کەفتۆر.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"خەڵکی غەزە لەبەر ماتەم سەریان دەتاشن،","poem":1},{"text":"ئەسقەلان کپ دەبێت.","poem":2},{"text":"ئەی پاشماوەی خەڵکی دۆڵەکان،","poem":1},{"text":"هەتا کەی لەشی خۆتان بریندار دەکەن؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«”ئای ئەی شمشێری یەزدان،","poem":1},{"text":"هەتا کەی پشوو نادەیت؟","poem":2},{"text":"بڕۆ ناو کێلانەکەتەوە","poem":1},{"noteId":62},{"text":"و","poem":1},{"text":"هێدی بە و کپ بە.“","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بەڵام چۆن پشوو دەدات","poem":1},{"text":"کە یەزدان فەرمانی پێکردبێت،","poem":2},{"text":"لە دژی ئەسقەلان و لە دژی کەناری دەریا،","poem":1},{"text":"لەوێ ئەرکی پێ سپارد؟»","poem":2}]}],"footnotes":[{"noteId":62,"caller":"+","text":"کالانەکەتەوە.‏","reference":{"chapter":47,"verse":6}}]},"thisChapterLink":"/api/ckb_bib/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}