{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["پەیامێک سەبارەت بە عەمۆن"]},{"type":"verse","number":1,"content":["بۆ عەمۆنییەکان:",{"lineBreak":true},"یەزدان ئەمە دەفەرموێت:",{"text":"«ئایا ئیسرائیل کوڕی نییە،","poem":1},{"text":"یان میراتگری نییە؟","poem":2},{"text":"بۆچی مۆلەخ گاد داگیر بکات و","poem":1},{"text":"گەلەکەشی لەناو شارۆچکەکانی ئەودا نیشتەجێ بن؟»","poem":2}]},{"type":"verse","number":2,"content":[{"text":"یەزدان دەفەرموێت: «لەبەر ئەوە ئەوەتا ڕۆژێک دێت،","poem":1},{"lineBreak":true},{"text":"وا دەکەم لە شاری ڕەبەی عەمۆنییەکان،","poem":1},{"text":"نەعرەتەی جەنگ ببیسترێت،","poem":2},{"text":"جا دەبێتە گردێکی وێران و","poem":1},{"text":"شارۆچکەکانیشی بە ئاگر دەسووتێن،","poem":2},{"text":"ئیسرائیلیش داگیرکەرانی خۆی داگیر دەکات.»","poem":1},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"«ئەی حەشبۆن واوەیلا بکە، چونکە عای تەفروتونا بوو!","poem":1},{"text":"ئەی دانیشتووانی ڕەبە هاوار بکەن!","poem":2},{"text":"بەرگی لە گوش دروستکراو لەبەر بکەن و شین بگێڕن،","poem":1},{"text":"بەناو شووراکانیدا بسووڕێنەوە،","poem":2},{"text":"چونکە مۆلەخ ڕاپێچ دەکرێت،","poem":1},{"text":"خۆی و کاهین و پیاوە گەورەکانی.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بۆ شانازی بە دۆڵەکانتەوە دەکەیت؟","poem":1},{"text":"بۆ شانازی بە دۆڵە پڕ بەروبوومەکانتەوە دەکەیت؟","poem":2},{"text":"ئەی کچی هەڵگەڕاوە،","poem":1},{"text":"ئەوەی پشت بە گەنجینەکانت دەبەستیت و دەڵێیت،","poem":2},{"lineBreak":true},{"text":"”کێ پەلامارم دەدات؟“»","poem":2}]},{"type":"verse","number":5,"content":[{"text":"یەزدان، پەروەردگاری سوپاسالار، دەفەرموێت:","poem":1},{"text":"«ئەوەتا من ترست دەهێنمە سەر","poem":2},{"lineBreak":true},{"text":"لە هەموو ئەوانەی دەوروبەرت.","poem":2},{"text":"جا هەریەکە لە ئێوە دەردەکرێت و","poem":1},{"text":"کەس نابێت ونبووان کۆبکاتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«پاش ئەمە ڕاپێچکراوانی عەمۆنییەکان دەگەڕێنمەوە.»","poem":1},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"heading","content":["پەیامێک سەبارەت بە ئەدۆم"]},{"type":"verse","number":7,"content":["بۆ ئەدۆم:",{"lineBreak":true},"یەزدانی سوپاسالار ئەمە دەفەرموێت:",{"text":"«ئایا ئیتر دانایی لە تێمان نییە؟","poem":1},{"text":"ئایا ڕاوێژ لەلای تێگەیشتووان نەماوە؟","poem":2},{"lineBreak":true},{"text":"ئایا داناییەکەیان پووچەڵ بووەتەوە؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەی دانیشتووانی دیدان، بکشێنەوە و هەڵێن،","poem":1},{"text":"بڕۆن لە ئەشکەوتە قووڵەکان خۆتان بشارنەوە،","poem":2},{"text":"چونکە بەڵاکەی عیسۆی بەسەردەهێنم","poem":1},{"text":"لەو کاتەی سزای دەدەم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەگەر ڕەزبڕت","poem":1},{"noteId":66},{"text":"بۆ بێت،","poem":1},{"text":"ئایا هەندێک ترێ بەجێناهێڵن؟","poem":2},{"text":"ئەگەر بە شەو دزت بۆ بێت،","poem":1},{"text":"ئایا تەنها ئەوەی پێویستیان بێت نایدزن؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بەڵام من عیسۆ ڕووت دەکەمەوە،","poem":1},{"text":"شوێنە نهێنییەکانی دەردەخەم،","poem":2},{"lineBreak":true},{"text":"ناتوانێت خۆی بشارێتەوە،","poem":2},{"text":"منداڵ و برا و دراوسێکانی تەفروتونا دەکرێت،","poem":1},{"text":"ئیتر کەس بە زیندوویی نامێنێتەوە بۆ ئەوی بڵێت:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"”هەتیوەکانت جێبهێڵە، من دەیانپارێزم،","poem":1},{"text":"با بێوەژنەکانت پشت بە من ببەستن.“»","poem":2}]},{"type":"verse","number":12,"content":["سەبارەت بەمە یەزدان دەفەرموێت: «ئەگەر ئەوانەی شایانی ئەوە نین لە جامەکە بخۆنەوە، بەڵام بە تەواوی خواردیانەوە، ئایا تۆ بە تەواوی بێ سزا دەبیت؟ بێ سزا نابیت، بەڵکو دەبێت بیخۆیتەوە."]},{"type":"verse","number":13,"content":["یەزدان دەفەرموێت: سوێندم بە خۆم خواردووە، کە بۆزرا وێران بێت، ڕیسوا بێت، بڕووخێت و نەفرەتبار بێت و هەموو شارۆچکەکانیشی هەتاهەتایە بە ڕووخاوی بمێنێتەوە.»"]},{"type":"verse","number":14,"content":[{"text":"هەواڵێکم لەلایەن یەزدانەوە بیست،","poem":1},{"text":"نێردراوێک بۆ نەتەوەکان نێردراوە تاکو پێیان بڵێت:","poem":2},{"text":"«کۆببنەوە و پەلاماری بدەن،","poem":1},{"text":"هەستن بۆ جەنگ.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«ئێستا لەنێو گەلاندا بچووکت دەکەمەوە،","poem":1},{"text":"لەنێو مرۆڤدا ڕیسوا دەبیت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"تۆ سامت لەسەر خەڵک هەبوو،","poem":1},{"text":"فیزی دڵت هەڵیخەڵەتاندی،","poem":2},{"text":"ئەی نیشتەجێی نێو کەلێنی تاشەبەرد،","poem":1},{"text":"ئەوەی لەسەر بەرزایی گردیت،","poem":2},{"text":"تەنانەت ئەگەر وەک هەڵۆ هێلانەکەت لە بەرزایی دانێیت،","poem":1},{"text":"لەوێوە دەتهێنمە خوارەوە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"«ئەدۆم دەبێتە وێرانە،","poem":1},{"text":"هەرکەسێک پێیدا تێبپەڕێت سەرسام دەبێت،","poem":2},{"lineBreak":true},{"text":"گاڵتەی پێ دەکات لەسەر هەموو ئەوەی بەسەری هاتووە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"وەک سەرەوژێربوونی سەدۆم و عەمۆرا","poem":1},{"text":"و شارۆچکەکانی دەوروبەری،","poem":2},{"text":"هیچ مرۆڤێک لەوێدا نیشتەجێ نابێت،","poem":1},{"text":"هیچ ئادەمیزادێک بۆ ئەوێ ئاوارە نابێت.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«ئەوەتا وەک شێرێک لە دەوەنەکانی ڕووباری ئوردونەوە سەردەکەوێت،","poem":1},{"text":"بەرەو لەوەڕگا دەوڵەمەندەکان،","poem":2},{"text":"ئاوا لە چاوتروکانێکدا لەوێ ئەدۆمییەکان ڕاودەنێم.","poem":1},{"text":"کێ هەڵبژێردراوە کە بیکەم بە سەرپەرشتیاری؟","poem":2},{"text":"چونکە کێ وەک منە و کێ کێشمەکێشم لەگەڵ دەکات؟","poem":1},{"text":"ئەو شوانە کێیە کە دەتوانێ لە ڕووی من بوەستێتەوە؟»","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"لەبەر ئەوە ببیستن خودا چ پلانێکی لە دژی ئەدۆم داڕشتووە،","poem":1},{"text":"مەبەستی چی بووە لە دژی دانیشتووانی تێمان بیکات:","poem":2},{"text":"بچووکەکانی مێگەلەکە ڕادەکێشرێن،","poem":1},{"text":"بەهۆی ئەوان بە تەواوی لەوەڕگاکانیان وێران دەکات.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لە دەنگی کەوتنیان زەوی دەلەرزێت،","poem":1},{"text":"قیژەیان دەگاتە دەریای سوور","poem":2},{"noteId":67},{"text":".","poem":2}]},{"type":"verse","number":22,"content":[{"text":"تەماشا بکەن! دوژمن وەک هەڵۆ بەرز دەبێتەوە و دەفڕێت،","poem":1},{"text":"بەسەر بۆزرادا باڵەکانی لێک دەکاتەوە.","poem":2},{"text":"لەو ڕۆژەدا دڵی پاڵەوانانی ئەدۆم","poem":1},{"text":"وەک دڵی ژنی ژانگرتووی لێدێت.","poem":2}]},{"type":"heading","content":["پەیامێک سەبارەت بە دیمەشق"]},{"type":"verse","number":23,"content":["بۆ دیمەشق:",{"text":"«حەمات و ئەرپاد شەرمەزار بوون،","poem":1},{"text":"چونکە هەواڵێکی خراپیان بیست،","poem":2},{"text":"لە ترسان توانەوە،","poem":1},{"text":"وەک دەریا شڵەژاون و ئارام نابنەوە.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"دیمەشق هێزی لەبەر بڕا،","poem":1},{"text":"ڕووی وەرگێڕا بۆ هەڵاتن،","poem":2},{"lineBreak":true},{"text":"شڵەژا و تانگەتاو بوو","poem":2},{"text":"وەک ژنی ژانگرتوو.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"چۆن واز لە شارە بەناوبانگەکە نەهێنرا،","poem":1},{"text":"ئەو شارۆچکەیەی کە شوێنی شادی من بوو!","poem":2}]},{"type":"verse","number":26,"content":[{"text":"بێگومان لەو ڕۆژەدا، لاوەکانی لەناو شەقامەکان دەکوژرێن،","poem":1},{"text":"هەموو جەنگاوەرەکانی لەناودەچن.»","poem":2},{"text":"ئەمە فەرمایشتی یەزدانی سوپاسالارە.","poem":4}]},{"type":"verse","number":27,"content":[{"text":"«ئاگرێک لە دیواری دیمەشق بەردەدەم،","poem":1},{"text":"قەڵاکانی بەن‌هەدەد دەخوات.»","poem":2}]},{"type":"heading","content":["پەیامێک سەبارەت بە قێدار و حاچۆر"]},{"type":"verse","number":28,"content":["بۆ قێدار و شانشینەکانی حاچۆر، ئەوەی نەبوخودنەسری پاشای بابل لێیدا:",{"lineBreak":true},"یەزدان ئەمە دەفەرموێت:",{"text":"«ئەی بابلییەکان، هەستن هێرش ببەن بۆ قێدار،","poem":1},{"text":"خەڵکی ڕۆژهەڵات تەفروتونا بکەن.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ڕەشماڵ و مەڕەکانیان دەبردرێن،","poem":1},{"text":"خێوەت و هەموو قاپوقاچاغەکانیان و","poem":2},{"lineBreak":true},{"text":"وشترەکانیان دەهێنرێن.","poem":2},{"text":"بانگیان بکەن:","poem":1},{"text":"”لە هەموو لایەکەوە ترس و تۆقین هەیە!“»","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"یەزدان دەفەرموێت: «ڕابکەن و دوور هەڵێن!","poem":1},{"text":"ئەی دانیشتووانی حاچۆر، لە ئەشکەوتە قووڵەکان نیشتەجێ بن.","poem":2},{"text":"نەبوخودنەسری پاشای بابل لە دژی ئێوە ڕاوێژی کردووە،","poem":1},{"text":"لە دژی ئێوە پیلانی داناوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«هەستن هێرش ببەنە سەر نەتەوەیەکی ئاسوودە،","poem":1},{"text":"بە پشت ئەستوورییەوە نیشتەجێیە.","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4},{"text":"نە دەرگا و نە شمشیرەی","poem":1},{"noteId":68},{"text":"هەیە،","poem":1},{"text":"بە تەنهایی نیشتەجێیە.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"وشترەکانیان بە تاڵان دەبردرێن و","poem":1},{"text":"ماڵاتی زۆریان دەبێتە دەستکەوت.","poem":2},{"text":"بە هەموو بایەک","poem":1},{"text":"قژبڕاوەکان","poem":2},{"noteId":69},{"text":"شەن دەکەم،","poem":2},{"text":"لە هەموو لایەکەوە کارەساتیان بەسەردەهێنم.»","poem":1},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":33,"content":[{"text":"«حاچۆر بۆ هەتاهەتایە","poem":1},{"text":"دەبێتە داڵدەی چەقەڵ و چۆڵەوانی.","poem":2},{"text":"هیچ مرۆڤێک لەوێ نیشتەجێ نابێت،","poem":1},{"text":"هیچ ئادەمیزادێک ئاوارەی ئەوێ نابێت.»","poem":2}]},{"type":"heading","content":["پەیامێک سەبارەت بە ئیلام"]},{"type":"verse","number":34,"content":["ئەو فەرمایشتەی یەزدان کە لە سەرەتای پاشایەتییەکەی سدقیای پاشای یەهودا بۆ یەرمیای پێغەمبەر هات، سەبارەت بە ئیلام، پێی فەرموو:"]},{"type":"line_break"},{"type":"verse","number":35,"content":["یەزدانی سوپاسالار ئەمە دەفەرموێت:",{"text":"«ئەوەتا من کەوانی ئیلام دەشکێنم،","poem":1},{"text":"کە سەرچاوەی هێزیانە.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"چوار با لە هەر چوار لای ئاسمانەوە،","poem":1},{"text":"بەسەر ئیلامدا دەهێنم،","poem":2},{"text":"بەم چوار بایە شەنیان دەکەم،","poem":1},{"text":"هەتا نەتەوە نەبێت","poem":2},{"lineBreak":true},{"text":"کە دوورخراوەکانی ئیلامی بۆ نەچوو بێت.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ئیلامییەکان لەبەردەم دوژمنانیان دەتۆقێنم،","poem":1},{"text":"لەبەردەم ئەوانەی دەیانەوێ بیانکوژن،","poem":2},{"text":"بەڵایان بەسەردەهێنم،","poem":1},{"text":"گڕی تووڕەییم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4},{"text":"«بە شمشێر ڕاویان دەنێم","poem":1},{"text":"هەتا کۆتاییان دەهێنم.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"تەختی خۆم لە ئیلام دادەنێم و","poem":1},{"text":"لەوێ پاشا و پیاوە گەورەکانی لەناودەبەم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"«بەڵام لە ئاییندەدا،","poem":1},{"text":"ڕاپێچکراوەکانی ئیلام دەگەڕێنمەوە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]}],"footnotes":[{"noteId":66,"caller":"+","text":"ڕەزبڕ: ئەوەی بەرهەمی ڕەزی دەبڕێتەوە.‏","reference":{"chapter":49,"verse":9}},{"noteId":67,"caller":"+","text":"عیبری سوف‏ واتا (زەل). دەشێت مەبەست لە دەریای سوف بێت، ئەو دەریایە بێت کە دەکەوێتە سەرووی باکووری کەنداوی سوێسی ئەمڕۆ، بەڵام لە دەقی یۆنانی پەیمانی نوێ هەر بە دەریای سوور نووسراوە. بڕوانە عیبرانییەکان 11‏:29‏‏.‏","reference":{"chapter":49,"verse":21}},{"noteId":68,"caller":"+","text":"شمشیر، پارچە دارێک بووە لە جیاتی قوفڵ لە دواوەی دەرگا بە شێوەی ئاسۆیی دانراوە بۆ داخستنی دەرگا.‏","reference":{"chapter":49,"verse":31}},{"noteId":69,"caller":"+","text":"بڕوانە یەرمیا 9‏:26‏‏","reference":{"chapter":49,"verse":32}}]},"thisChapterLink":"/api/ckb_bib/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}