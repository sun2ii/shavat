{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["کەس ڕاستودروست نییە"]},{"type":"verse","number":1,"content":[{"text":"«بەناو شەقامەکانی ئۆرشەلیمدا هاتوچۆ بکەن،","poem":1},{"text":"ئێستا تەماشا بکەن و بزانن،","poem":2},{"lineBreak":true},{"text":"لەناو گۆڕەپانەکانی بگەڕێن.","poem":2},{"text":"ئەگەر یەکێکتان بینییەوە","poem":1},{"text":"دادپەروەر بێت و بەدوای ڕاستیدا بگەڕێت،","poem":2},{"lineBreak":true},{"text":"ئەوا من لەم شارە خۆشدەبم.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"هەرچەندە دەڵێن: ”بە یەزدانی زیندوو،“","poem":1},{"text":"هێشتا بە درۆ سوێند دەخۆن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ئەی یەزدان، ئایا چاوت بەدوای ڕاستیدا ناگەڕێت؟","poem":1},{"text":"لێت دان بەڵام ئازاریان پێ نەگەیشت،","poem":2},{"lineBreak":true},{"text":"تێکت شکاندن بەڵام ڕەتیانکردەوە تەمبێ بکرێن.","poem":2},{"text":"ڕووی خۆیان لە بەرد ڕەقتر کرد،","poem":1},{"text":"تۆبەکردنیان ڕەتکردەوە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بەڵام من گوتم: «ئەوانە هەژارن،","poem":1},{"text":"نەزان بوون،","poem":2},{"text":"چونکە ڕێگای یەزدان ناناسن و","poem":1},{"text":"نازانن خودا داوای چییان لێ دەکات.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"کەواتە دەچمە لای گەورە پیاوان و","poem":1},{"text":"قسەیان لەگەڵ دەکەم،","poem":2},{"text":"بێگومان ئەوان ڕێگای یەزدان دەناسن و","poem":1},{"text":"دەزانن خودا داوای چییان لێ دەکات.»","poem":2},{"text":"بەڵام ئەوان پێکەوە نیریان شکاند،","poem":1},{"text":"بەندیان پساند.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لەبەر ئەوە لە دارستان شێر هێرشیان دەکاتە سەر،","poem":1},{"text":"گورگی بیابان دەیانفەوتێنێت،","poem":2},{"text":"پڵنگ لە دەوری شارۆچکەکانیان خۆی مات دەدات،","poem":1},{"text":"تاکو ئەوەی لێی بێتە دەرەوە پارچەپارچەی بکات،","poem":2},{"text":"چونکە یاخیبوونەکانیان زۆربوون،","poem":1},{"text":"هەڵگەڕانەوەکانیان گەورە بوون.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«بۆچی دەبێت لێت خۆشبم؟","poem":1},{"text":"کوڕەکانت وازیان لێ هێنام و","poem":2},{"lineBreak":true},{"text":"سوێند بەوە دەخۆن کە خودا نییە.","poem":2},{"text":"کە تێرم کردن، داوێنپیسییان کرد،","poem":1},{"text":"پاڵەپەستۆیانە بۆ ماڵی لەشفرۆش.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بوون بە ئەسپی خورت و بە عیتە،","poem":1},{"text":"هەریەکە بەسەر ژنی برادەرەکەیدا دەحیلێنێت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئایا لەسەر ئەمە سزایان نەدەم؟","poem":1},{"text":"ئایا من تۆڵە لە نەتەوەیەکی وەک ئەمە نەستێنمەوە؟»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«سەربکەونە سەر پەرژینی ڕەزەمێوەکان و تێکیان بدەن،","poem":1},{"text":"بەڵام بە تەواوی مەیفەوتێنن.","poem":2},{"text":"لقەکانی لێ بکەنەوە،","poem":1},{"text":"چونکە هی یەزدان نین.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بنەماڵەی ئیسرائیل و بنەماڵەی یەهودا","poem":1},{"text":"بە تەواوی ناپاکییان لێکردم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"درۆیان بە دەمی یەزدانەوە کرد،","poem":1},{"text":"گوتیان، «ئەو هیچ ناکات!","poem":2},{"text":"بەڵامان بەسەرنایەت،","poem":1},{"text":"شمشێر و قاتوقڕی نابینین.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"پێغەمبەرەکان بوون بە هاژەی با،","poem":1},{"text":"وشەکە لەواندا نییە،","poem":2},{"lineBreak":true},{"text":"ئەوەی گوتیان بەسەریان دەهێنرێت.»","poem":2}]},{"type":"verse","number":14,"content":["لەبەر ئەوە یەزدانی پەروەردگاری سوپاسالار، ئەمە دەفەرموێت:",{"text":"«لەبەر ئەوەی ئەم گەلە ئەو قسانەیان کرد،","poem":1},{"text":"ئەوەتا من وتەکانم لە دەمی تۆدا دەکەمە ئاگر،","poem":2},{"lineBreak":true},{"text":"ئەم گەلەش دەکەم بە دار و دەیانخوات.»","poem":2}]},{"type":"verse","number":15,"content":[{"text":"یەزدان دەفەرموێت: «ئەی بنەماڵەی ئیسرائیل،","poem":1},{"text":"ئەوەتا من نەتەوەیەک لە دوورەوە دەهێنمە سەرتان،","poem":2},{"lineBreak":true},{"text":"نەتەوەیەکی پتەو و دێرینە،","poem":2},{"text":"نەتەوەیەکە زمانەکەیان نازانن،","poem":1},{"text":"لە قسەکردنیان تێناگەن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"تیردانەکەی وەک گۆڕی دەم کراوەیە،","poem":1},{"text":"هەموو پاڵەوانن.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"دروێنە و نانت دەخوات،","poem":1},{"text":"کوڕ و کچت دەخوات،","poem":2},{"text":"مەڕ و مانگات دەخوات،","poem":1},{"text":"مێو و هەنجیرت دەخوات.","poem":2},{"text":"شارە قەڵابەندەکانت کە تۆ پشتت پێ بەستوون،","poem":1},{"text":"بە شمشێر دەفەوتێنێت.»","poem":2}]},{"type":"verse","number":18,"content":["یەزدان دەفەرموێت: «هەروەها لەو ڕۆژانەدا، کۆتاییتان پێ ناهێنم."]},{"type":"verse","number":19,"content":["جا کە دەڵێن: ”لەبەر چی یەزدانی پەروەردگارمان هەموو ئەمەی پێکردین؟“ پێیان دەڵێیت: ”لەبەر ئەوەی وازتان لێ هێنام و لە خاکەکەتان خوداوەندە بێگانەکانتان پەرست، ئاوا دەبێت بێگانە پەرستی بکەن لە خاکێک کە هی ئێوە نییە.",{"noteId":10},"“"]},{"type":"verse","number":20,"content":[{"text":"«ئەمە بە بنەماڵەی یاقوب ڕابگەیەنن و","poem":1},{"text":"با لەناو یەهودا ببیسترێت، بڵێن:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئەی گەلی گێل و بێ مێشک، ئێستا گوێ لەمە بگرن،","poem":1},{"text":"ئەی ئەوانەی چاوتان هەیە و نابینن،","poem":2},{"lineBreak":true},{"text":"گوێتان هەیە و نابیستن:","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ئایا لە من ناترسن؟»","poem":2},{"text":"هەروەها یەزدان دەفەرموێت:","poem":1},{"text":"«ئایا لەبەردەمی من نالەرزن؟","poem":2},{"text":"من کە لمم بۆ دەریا کرد بە سنوور،","poem":1},{"text":"بەربەستێکی هەتاهەتاییە و لێی تێناپەڕێت.","poem":2},{"text":"شەپۆل خۆی پێدا دەدات و سەرکەوتوو نابێت،","poem":1},{"text":"هاژەی دێت و تێناپەڕێت.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"بەڵام ئەم گەلە دڵێکی منجڕ و یاخی هەیە،","poem":1},{"text":"لەڕێ لایاندا و ڕۆیشتن.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"لە دڵی خۆیاندا ناڵێن،","poem":1},{"text":"”ئێستا با لە یەزدانی پەروەردگارمان بترسین،","poem":2},{"text":"ئەوەی باران دەبارێنێت، یەکەم باران و دوا باران لە وەرزی خۆی،","poem":1},{"text":"لە هەفتە دیاریکراوەکانی دروێنە دڵنیامان دەکاتەوە.“","poem":2}]},{"type":"verse","number":25,"content":[{"text":"تاوانەکانتان ڕێگرییان لەم بەرەکەتانە کرد،","poem":1},{"text":"گوناهەکانتان لە چاکە بێبەشی کردن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«بەدکاران لەنێو گەلەکەمدا دەبینرێنەوە،","poem":1},{"text":"وەک ڕاوچی خۆیان ماتداوە و چاو دەگێڕن،","poem":2},{"lineBreak":true},{"text":"تەڵە دەنێنەوە و مرۆڤ دەگرن.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"وەک قەفەزی پڕ لە باڵدار،","poem":1},{"text":"ماڵەکانیان پڕە لە فێڵ،","poem":2},{"text":"لەبەر ئەمە گەورە و دەوڵەمەند بوون،","poem":1}]},{"type":"verse","number":28,"content":[{"text":"قەڵەو و تێر بوون.","poem":2},{"text":"هەروەها لە خراپەکاریدا بێ سنوورن،","poem":1},{"text":"پارێزەرایەتییان بۆ سکاڵای هەتیو نەکرد هەتا سەرکەوتوو بن،","poem":2},{"lineBreak":true},{"text":"بەرگرییان لە مافی هەژاران نەکرد.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ئایا لەسەر ئەمە سزایان نەدەم؟","poem":1},{"text":"ئایا من تۆڵە لە نەتەوەیەکی وەک ئەمە نەستێنمەوە؟»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"«تۆقین و سەرسوڕماویێک","poem":1},{"text":"لە خاکەکەدا ڕوویدا:","poem":2}]},{"type":"verse","number":31,"content":[{"text":"پێغەمبەرەکان بە درۆ پێشبینی دەکەن،","poem":1},{"text":"کاهینەکانیش بە ویستی خۆیان فەرمانڕەوایەتی دەکەن،","poem":2},{"text":"گەلەکەشم حەزیان لەم دۆخەیە.","poem":1},{"text":"بەڵام لە کۆتاییەکەیدا ئێوە چی دەکەن؟","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"وەک سزایەک خزمەتی بێگانەکان دەکەن و خوداوەندەکانی ئەوان دەپەرستن.‏","reference":{"chapter":5,"verse":19}}]},"thisChapterLink":"/api/ckb_bib/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}