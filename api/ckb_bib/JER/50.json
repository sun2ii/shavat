ن.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"لەوپەڕەوە وەرنە سەری!","poem":1},{"text":"ئەمبارەکانی بکەنەوە،","poem":2},{"lineBreak":true},{"text":"وەک کۆمەی دەغڵودان کەڵەکەی بکەن.","poem":2},{"text":"بە تەواوی قڕی بکەن،","poem":1},{"text":"پاشماوەی نەمێنێتەوە!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"هەموو جوانەگاکانی","poem":1},{"noteId":75},{"text":"بکوژن،","poem":1},{"text":"با بۆ سەربڕین ببردرێن!","poem":2},{"text":"قوڕبەسەریان! چونکە ڕۆژیان هات،","poem":1},{"text":"کاتی سزادانیان.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"لە خاکی بابلەوە گوێ لە دەنگی هەڵاتووان و دەربازبووان بگرن","poem":1},{"text":"لە سییۆن ڕایبگەیەنن","poem":2},{"text":"چۆن یەزدانی پەروەردگارمان تۆڵەی سەندەوە،","poem":1},{"text":"تۆڵەی پەرستگاکەی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«تیرهاوێژەکان بانگ بکەن لە دژی بابل،","poem":1},{"text":"هەموو کەوان بەدەستەکان.","poem":2},{"text":"لە هەموو لایەکەوە دابەزنە سەری،","poem":1},{"text":"با کەس دەرباز نەبێت.","poem":2},{"text":"بەگوێرەی کردەوەکەی سزای بدەن،","poem":1},{"text":"هەموو ئەوەی کردی پێی بکەنەوە،","poem":2},{"text":"چونکە لە ڕووی یەزدان وەستایەوە،","poem":1},{"text":"لە ڕووی خودا پیرۆزەکەی ئیسرائیل.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"لەبەر ئەوە لاوەکانی لە گۆڕەپانەکاندا دەکوژرێن و","poem":1},{"text":"لەو ڕۆژەدا هەموو جەنگاوەرەکانی لەناودەچن.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":31,"content":[{"text":"«ئەی بێ چاوەڕوو، ئەوەتا من لە دژی تۆم،","poem":1},{"lineBreak":true},{"text":"چونکە ڕۆژت هات،","poem":1},{"text":"کاتی سزادانت.»","poem":2},{"lineBreak":true},{"text":"ئەوە فەرمایشتی یەزدانە، پەروەردگاری سوپاسالار.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"«جا بێ چاوەڕووەکە ساتمە دەکات و دەکەوێت،","poem":1},{"text":"کەس هەڵیناستێنێتەوە،","poem":2},{"text":"منیش ئاگر بەردەدەمە شارۆچکەکانی و","poem":1},{"text":"هەموو دەوروبەرەکەی دەخوات.»","poem":2}]},{"type":"verse","number":33,"content":["یەزدانی سوپاسالار ئەمە دەفەرموێت:",{"text":"«نەوەی ئیسرائیل چەوسێنراوەن،","poem":1},{"text":"هەروەها نەوەی یەهوداش.","poem":2},{"text":"هەموو ئەوانەی ڕاپێچیان کردن ئەوانیان گرت،","poem":1},{"text":"ڕازی نەبوون بەڕەڵایان بکەن.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"بەڵام ئەوەی دەیانکڕێتەوە بەهێزە،","poem":1},{"text":"ناوی یەزدانی سوپاسالارە.","poem":2},{"text":"بە چالاکی داکۆکی لە کێشەکەیان دەکات،","poem":1},{"text":"هەتا خاکەکە دەحەسێنێتەوە،","poem":2},{"lineBreak":true},{"text":"بەڵام دانیشتووانی بابل هەراسان دەکات.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"یەزدان دەفەرموێت: «شمشێر لە دژی بابلییەکانە!","poem":1},{"lineBreak":true},{"text":"لە دژی دانیشتووانی بابلە و","poem":1},{"text":"لە دژی میر و پیاوە داناکانییەتی!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"شمشێر لە دژی قسە پووچەکانە!","poem":1},{"noteId":76},{"text":"جا گێل دەبن.","poem":2},{"text":"شمشێر لە دژی پاڵەوانەکانییەتی!","poem":1},{"text":"جا دەتۆقن.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"شمشێر لە دژی ئەسپ و گالیسکەکانییەتی،","poem":1},{"text":"لە دژی هەموو سەربازە بێگانەکان لە ڕیزەکانی ئەو!","poem":2},{"lineBreak":true},{"text":"جا دەبن بە ژن.","poem":2},{"text":"شمشێر لە دژی گەنجینەکانییەتی!","poem":1},{"text":"جا تاڵان دەکرێن.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"وشکەساڵی لە دژی ئاوەکانییەتی!","poem":1},{"text":"جا وشک دەبن،","poem":2},{"text":"چونکە خاکی بتەکانە،","poem":1},{"text":"ئەو بتانەی شێتی و تۆقین دەهێنن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"«لەبەر ئەوە دڕندە بیابانییەکان و کەمتیار تێیدا دەژین،","poem":1},{"text":"کوندەپەپووی تێدا دەژیێت.","poem":2},{"text":"ئیتر هەرگیز کەسی تێدا نیشتەجێ نابێت،","poem":1},{"text":"نەوە دوای نەوە ئاوەدان نابێتەوە.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"وەک چۆن خودا سەدۆم و عەمۆرای سەرەوژێر کرد","poem":1},{"text":"لەگەڵ شارۆچکەکانی دەوروبەری،","poem":2},{"text":"هیچ مرۆڤێک لەوێدا نیشتەجێ نابێت،","poem":1},{"text":"هیچ ئادەمیزادێک بۆ ئەوێ ئاوارە نابێت.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"«ئەوەتا! سوپایەک لە باکوورەوە دێت،","poem":1},{"text":"نەتەوەیەکی مەزن و چەندین پاشا،","poem":2},{"lineBreak":true},{"text":"لەوپەڕی زەوییەوە هەڵدەستێنرێن.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"کەوان و ڕمیان بە دەستەوەیە،","poem":1},{"text":"دڵڕەقن و بەزەییان نییە.","poem":2},{"text":"دەنگیان وەک دەریا هاژەی دێت و","poem":1},{"text":"سواری ئەسپ دەبن،","poem":2},{"text":"وەک یەک پیاو ڕیز دەبەستن","poem":1},{"text":"بۆ هێرشکردنە سەر تۆ، ئەی شاری بابل.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"پاشای بابل هەواڵی ئەوانی بیست،","poem":1},{"text":"ورەی ڕووخا،","poem":2},{"text":"تووشی تەنگانە بوو،","poem":1},{"text":"تووشی ئازار بوو وەک ئازاری ژنی ژانگرتوو.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ئەوەتا وەک شێرێک لە دەوەنەکانی ڕووباری ئوردونەوە سەردەکەوێت،","poem":1},{"text":"بەرەو لەوەڕگا دەوڵەمەندەکان،","poem":2},{"text":"ئاوا لە چاوتروکانێکدا لەوێ بابلییەکان ڕاودەنێم.","poem":1},{"text":"کێ هەڵبژێردراوە کە بیکەم بە سەرپەرشتیاری؟","poem":2},{"text":"کێ وەک منە و کێ کێشمەکێشم لەگەڵ دەکات؟","poem":1},{"text":"ئەو شوانە کێیە کە دەتوانێ لە ڕووی من بوەستێتەوە؟»","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"لەبەر ئەوە ببیستن خودا چ پلانێکی لە دژی بابل داڕشتووە،","poem":1},{"text":"مەبەستی چی بووە لە دژی خاکی بابلییەکان بیکات:","poem":2},{"text":"بچووکەکانی مێگەلەکە ڕادەکێشرێن،","poem":1},{"text":"بەهۆی ئەوان بە تەواوی لەوەڕگاکانیان وێران دەکات.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"لە دەنگی گرتنی بابل زەوی دەلەرزێت،","poem":1},{"text":"قیژەیان دەگاتە ناو نەتەوەکان.","poem":2}]}],"footnotes":[{"noteId":70,"caller":"+","text":"بێل یەکێکە لە خوداوەند و بتە ناودارەکانی سەردەمی شانشینی بابل.‏ بڕوانە ئیشایا 46‏:1.","reference":{"chapter":50,"verse":2}},{"noteId":71,"caller":"+","text":"بێل یان مەرۆداخ یان مەردوخ، هەمان سەرۆکی خوداوەندەکانی بابلییەکان بوو.‏ بڕوانە ئیشایا 46‏:1.","reference":{"chapter":50,"verse":2}},{"noteId":72,"caller":"+","text":"بە واتای دوو هێندە یاخیبوون.‏","reference":{"chapter":50,"verse":21}},{"noteId":73,"caller":"+","text":"بە واتای سزادان.‏","reference":{"chapter":50,"verse":21}},{"noteId":74,"caller":"+","text":"وشەی لە زمانی عیبری ئەم زاراوەیە دەگەڕێتەوە بۆ شتێک یان کەسێک کە دەبەخشرێت بە یەزدان، زۆر جار بەخشینەکە بە تەواوی لە ناودەبردرێت.‏","reference":{"chapter":50,"verse":21}},{"noteId":75,"caller":"+","text":"لەو کاتەوە گوێرەکەی نێر لە شیر دەبڕدرێتەوە پێ دەڵێن (نۆبەن) یان (جوانەگا).‏","reference":{"chapter":50,"verse":27}},{"noteId":76,"caller":"+","text":"مەبەستی لەوانە کە بە درۆ بانگەشەی پێغەمبەرایەتییان دەکرد.‏","reference":{"chapter":50,"verse":36}}]},"thisChapterLink":"/api/ckb_bib/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}