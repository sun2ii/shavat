},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"یەزدان دەفەرموێت: «لەبەر ئەوە ڕۆژێک دێت،","poem":1},{"text":"بتەکانی سزا دەدەم،","poem":2},{"text":"لە هەموو خاکەکەیدا","poem":1},{"text":"بریندارەکان دەناڵێنن.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"تەنانەت ئەگەر بابل بگاتە ئاسمانیش،","poem":1},{"text":"ئەگەر قەڵای خۆشی قاییم بکات،","poem":2},{"lineBreak":true},{"text":"تەفروتوناکەر لە دژی ئەو دەنێرم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"«دەنگی هاوار دێت لە بابل،","poem":1},{"text":"دەنگی شکستێکی گەورە","poem":2},{"lineBreak":true},{"text":"لە خاکی بابلییەکان.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"یەزدان بابل تەفروتونا دەکات،","poem":1},{"text":"کۆتایی بە دەنگە مەزنەکەی دەهێنێت.","poem":2},{"text":"شەپۆلی دوژمنەکانیان وەک ئاوێکی زۆر هەڵدەچێت،","poem":1},{"text":"دەنگیان هاژەی دێت.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"تەفروتوناکەر دێتە سەر بابل،","poem":1},{"text":"پاڵەوانەکانی دەگیرێن،","poem":2},{"lineBreak":true},{"text":"کەوانەکانیان دەشکێنرێت،","poem":2},{"text":"چونکە یەزدان خودای سزادانە،","poem":1},{"text":"بە تەواوی سزا دەدات.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"میر و دانا و پارێزگار و","poem":1},{"text":"فەرمانڕەوا و پاڵەوانەکانی سەرخۆش دەکەم،","poem":2},{"text":"هەتاهەتایە خەویان لێ دەکەوێت و بەئاگا نایەن.»","poem":1},{"text":"ئەوە فەرمایشتی ئەو پاشایەیە کە ناوی یەزدانی سوپاسالارە.","poem":2}]},{"type":"verse","number":58,"content":["یەزدانی سوپاسالار ئەمە دەفەرموێت:",{"text":"«شوورا پانەکانی بابل بە تەواوی دەڕووخێنرێن،","poem":1},{"text":"دەروازە بەرزەکانیشی بە ئاگر دەسووتێنرێن.","poem":2},{"text":"گەلان بەخۆڕایی خۆیان ماندوو دەکەن و","poem":1},{"text":"ڕەنجی نەتەوەکانیش تەنها بۆ ئاگر دەبێت.»","poem":2}]},{"type":"verse","number":59,"content":["ئەمە ئەو پەیامەیە کە یەرمیای پێغەمبەر دایە سەرایای کوڕی نێرییا کوڕی مەحسێیا، سەرۆکی ئۆردوگا، کاتێک لە ساڵی چوارەمی پاشایەتییەکەی لەگەڵ سدقیای پاشای یەهودا چوو بۆ بابل."]},{"type":"verse","number":60,"content":["هەموو ئەوەی لەسەر بابل تۆمار کرابوو، لەگەڵ هەموو ئەو بەڵایەی بەسەری دێت یەرمیا نووسیبووی و کردبووی بە تۆمارێک،"]},{"type":"verse","number":61,"content":["بە سەرایای گوت: «کاتێک گەیشتییە بابل، دڵنیابە لە خوێندنەوەی تەواوی ئەم پەیامە بۆ خەڵکەکە،"]},{"type":"verse","number":62,"content":["ئینجا بڵێ: ”ئەی یەزدان، تۆ فەرمووت ئەم شوێنە لەناودەبەیت، تاکو ئەوەی مرۆڤ و ئاژەڵی تێدا نامێنێت، هەتاهەتایە دەبێتە چۆڵەوانی.“"]},{"type":"verse","number":63,"content":["کاتێک لە خوێندنەوەی ئەم تۆمارە بوویتەوە، بەردێکی پێوە ببەستە و فڕێیبدە ناو فورات."]},{"type":"verse","number":64,"content":["ئینجا بڵێ: ”بابل ئاوا نوقوم دەبێت و لەژێر ئەو بەڵایە ڕاست نابێتەوە کە من بەسەری دەهێنم، خەڵکەکەی شەکەت دەبن.“» هەتا ئێرە وشەکانی یەرمیایە."]}],"footnotes":[{"noteId":77,"caller":"+","text":"با یان ئامرازێک بۆ لەناوبردنیان.‏","reference":{"chapter":51,"verse":1}},{"noteId":78,"caller":"+","text":"واتا خاکی کلدانییەکان، مەبەستی لە بابلە.‏","reference":{"chapter":51,"verse":1}},{"noteId":79,"caller":"+","text":"لەناو دەبن: لە زمانی عیبری ئەم زاراوەیە دەگەڕێتەوە بۆ شتێک یان کەسێک کە دەبەخشرێت بە یەزدان، زۆر جار بەخشینەکە بە تەواوی لە ناودەبردرێت.‏","reference":{"chapter":51,"verse":3}},{"noteId":80,"caller":"+","text":"بڕوانە 10‏:12‏-16.‏","reference":{"chapter":51,"verse":19}},{"noteId":81,"caller":"+","text":"بەردی قولینچک: بەردێکی گەورە لە گۆشەی دیوار دادەنرێت لەو بەردانە بەهێزترە کە لە دیوارەکە بەکاردێت و دەبێتە هۆی بەهێزکردنی دیوارەکە.‏","reference":{"chapter":51,"verse":26}},{"noteId":82,"caller":"+","text":"مەبەستی لە پرد و شوێنی پەڕینەوەیە لە ڕووبارەکان.‏","reference":{"chapter":51,"verse":32}},{"noteId":83,"caller":"+","text":"خەڵک لەو باوەڕەدا بوون کە لەبن زەوی دەریایەک هەبوو وەکو سەرچاوەی ئاو.‏","reference":{"chapter":51,"verse":36}},{"noteId":84,"caller":"+","text":"ناوی نهێنی بابل بووە.‏","reference":{"chapter":51,"verse":41}}]},"thisChapterLink":"/api/ckb_bib/JER/51.json","thisChapterAu