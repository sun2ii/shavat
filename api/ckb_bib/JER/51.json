{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«ئەوەتا من ڕۆحی لەناوبەر","poem":1},{"noteId":77},{"text":"دەوروژێنم","poem":1},{"text":"لە دژی بابل و دانیشتووانی لێڤ قامای","poem":2},{"noteId":78},{"text":".","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بێگانەکان دەنێرمە بابل","poem":1},{"text":"بۆ شەنکردنیان و ڕووتکردنەوەی خاکەکەی،","poem":2},{"text":"لە هەموو لایەکەوە دەوری دەدەن","poem":1},{"text":"لە ڕۆژی بەڵای ئەودا.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ڕێ مەدە تیرهاوێژ ژێی کەوانەکەی ڕابکێشێت،","poem":1},{"text":"ڕێ مەدە سەرباز زرێیەکەی بپۆشێت.","poem":2},{"text":"دەستتان لە گەنجەکانی مەپارێزن،","poem":1},{"text":"بەڵکو سوپاکەی بە تەواوی لەناوببەن","poem":2},{"noteId":79},{"text":".","poem":2}]},{"type":"verse","number":4,"content":[{"text":"کوژراوان لە بابل دەکەون،","poem":1},{"text":"بریندارەکان بە سەختی لە شەقامەکانی،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"چونکە ئیسرائیل و یەهودا بەجێنەهێڵدراون","poem":1},{"text":"لەلایەن خودایانەوە، لەلایەن یەزدانی سوپاسالارەوە،","poem":2},{"text":"هەرچەندە خاکی بابلییەکان پڕ لە تاوانە","poem":1},{"text":"لە دژی خودا پیرۆزەکەی ئیسرائیل.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«لە بابلەوە هەڵێن!","poem":1},{"text":"هەرکەسێک با خۆی دەرباز بکات!","poem":2},{"lineBreak":true},{"text":"بە تاوانی ئەو لەناونەچن،","poem":2},{"text":"چونکە کاتی تۆڵەسەندنەوەیە بۆ یەزدان،","poem":1},{"text":"ئەو سزای شایستەی دەدات.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بابل جامێکی زێڕ بوو بە دەستی یەزدانەوە،","poem":1},{"text":"هەموو زەوی سەرخۆش کرد.","poem":2},{"text":"نەتەوەکان لە شەرابی ئەویان خواردەوە،","poem":1},{"text":"لەبەر ئەوە نەتەوەکان شێت بوون.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"لەپڕ بابل دەکەوێت و وردوخاش دەبێت.","poem":1},{"text":"واوەیلای بۆ بکەن!","poem":2},{"text":"هەتووانێک بۆ برینەکەی بهێنن،","poem":1},{"text":"بەڵکو چاک بێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«”بابلمان تیمار کرد،","poem":1},{"text":"بەڵام ناتوانێت چاک بێتەوە.","poem":2},{"text":"وازی لێ بهێنن و با هەریەکەمان بچینەوە خاکەکەی خۆمان،","poem":1},{"text":"چونکە کاتێک حوکمی بەسەردا درا هاواری گەیشتە ئاسمان،","poem":2},{"lineBreak":true},{"text":"هەتا هەورەکان بەرز بووەتەوە.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«”یەزدان ئەستۆپاکی ئێمەی دەرخست،","poem":1},{"text":"وەرن با لە سییۆن","poem":2},{"lineBreak":true},{"text":"باسی کردەوەکەی یەزدانی پەروەردگارمان بکەین.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«تیرەکان تیژ بکەن،","poem":1},{"text":"قەڵغانەکان هەڵبگرن!","poem":2},{"text":"یەزدان ڕۆحی پاشایانی مادی وروژاندووە،","poem":1},{"text":"چونکە پلانی وێرانکردنی بابل دادەنێت.","poem":2},{"text":"یەزدان تۆڵە دەستێنێتەوە،","poem":1},{"text":"تۆڵەی پەرستگاکەی.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لە دژی شووراکانی بابل ئاڵا هەڵبکەن!","poem":1},{"text":"پاسەوانیێتی توند بکەن،","poem":2},{"text":"چاودێر دابنێن،","poem":1},{"text":"بۆسە بنێنەوە!","poem":2},{"text":"خودا مەبەستی خۆی دەهێنێتە دی،","poem":1},{"text":"بڕیارەکەی لە دژی خەڵکی بابل.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەی نیشتەجێی دەم ئاوە زۆرەکان،","poem":1},{"text":"خاوەن گەنجینەی زۆر،","poem":2},{"text":"کۆتاییت هات،","poem":1},{"text":"کاتی لەناوچوونت.»","poem":2}]},{"type":"verse","number":14,"content":[{"text":"یەزدانی سوپاسالار بە گیانی خۆی سوێندی خوارد:","poem":1},{"text":"«بە دڵنیاییەوە پڕت دەکەم لە سەرباز، وەک ڕەوە کوللە،","poem":2},{"lineBreak":true},{"text":"هاواری سەرکەوتنت بەسەردا دەکێشن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«خودا بە هێزی خۆی زەوی دروستکردووە،","poem":1},{"text":"بە دانایی خۆی جیهانی دامەزراندووە،","poem":2},{"lineBreak":true},{"text":"بە تێگەیشتنی خۆی ئاسمانی ڕاخستووە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"کاتێک دەنگ هەڵدەبڕێت، ئاوەکانی ئاسمان هاژەیان دێت،","poem":1},{"text":"هەڵمەکان لەوپەڕی زەوییەوە بەرز دەکاتەوە،","poem":2},{"text":"بروسکە بۆ باران دروستدەکات،","poem":1},{"text":"با لە ئەمباری خۆی دەردەهێنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«هەموو کەسێک بێ زانیارییە و دەبەنگە،","poem":1},{"text":"هەموو زێڕنگەرێک بە پەیکەرەکەی شەرمەزارە،","poem":2},{"text":"چونکە داڕێژراوی درۆن و","poem":1},{"text":"ڕۆحیان تێدا نییە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئەوان پووچن، مایەی گاڵتەجاڕین،","poem":1},{"text":"لە کاتی سزادانیان لەناودەچن.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بەڵام خودا، ئەوەی بەشی یاقوبە وەک ئەمانە نییە،","poem":1},{"text":"چونکە ئەو دروستکەری هەموو شتێکە،","poem":2},{"text":"هۆزی","poem":1},{"noteId":80},{"text":"میراتی ئەویشی داناوە،","poem":1},{"text":"یەزدانی سوپاسالار، ئەمە ناوی ئەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«تۆ گورزی منی،","poem":1},{"text":"چەکەکانی جەنگی منی،","poem":2},{"text":"بە تۆ نەتەوەکان تێکدەشکێنم،","poem":1},{"text":"بە تۆ شانشینەکان لەناودەبەم،","poem":2}]},{"type":"verse","number":21,"content":[{"text":"بە تۆ ئەسپ و سوارەکەی تێکدەشکێنم،","poem":1},{"text":"بە تۆ گالیسکە و سوارەکەی تێکدەشکێنم،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بە تۆ ژن و پیاو تێکدەشکێنم،","poem":1},{"text":"بە تۆ پیر و گەنج تێکدەشکێنم،","poem":2},{"lineBreak":true},{"text":"بە تۆ گەنج و لاو تێکدەشکێنم،","poem":2}]},{"type":"verse","number":23,"content":[{"text":"بە تۆ شوان و مێگەلەکەی تێکدەشکێنم،","poem":1},{"text":"بە تۆ جوتیار و گاجووتەکەی تێکدەشکێنم،","poem":2},{"lineBreak":true},{"text":"بە تۆ پارێزگار و فەرمانڕەواکان تێکدەشکێنم.","poem":2}]},{"type":"verse","number":24,"content":["«لەبەرچاوی خۆتان سزای بابل و هەموو دانیشتووانی خاکی بابل دەدەم بەرامبەر بە هەموو ئەو خراپانەی لە سییۆن کردیان.» ئەوە فەرمایشتی یەزدانە."]},{"type":"verse","number":25,"content":[{"text":"«ئەی کێوی لەناوبەر، ئەوەتا من لە دژی تۆم،","poem":1},{"text":"تۆ ئەی لەناوبەری هەموو زەوی.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4},{"text":"«دەست درێژ دەکەمە سەرت،","poem":1},{"text":"لەسەر بەردەکان گلۆرت دەکەمەوە،","poem":2},{"lineBreak":true},{"text":"دەتکەمە کێوێکی سووتاو.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ئیتر نە بەردت لێ دەبەن بۆ بەردی قولینچک","poem":1},{"noteId":81},{"text":"،","poem":1},{"text":"نە هیچ بەردێک بۆ بناغەکان،","poem":2},{"lineBreak":true},{"text":"چونکە بۆ هەتاهەتایە دەبیتە چۆڵەوانی.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«ئاڵا لەسەر خاکەکە بەرز بکەنەوە،","poem":1},{"text":"لەنێو نەتەوەکان فوو بە کەڕەنادا بکەن.","poem":2},{"text":"نەتەوەکان لە دژی بابل ئامادە بکەن،","poem":1},{"text":"ئەم شانشینانە لە دژی ئەو بانگ بکەن:","poem":2},{"lineBreak":true},{"text":"ئارارات و مینی و ئەشکەنەز،","poem":2},{"text":"ڕابەرێک لە دژی دابنێن،","poem":1},{"text":"وەک ڕەوە کوللە ئەسپ بنێرن.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"نەتەوەکان لە دژی ئەو ئامادە بکەن،","poem":1},{"text":"پاشاکانی ماد،","poem":2},{"text":"پارێزگار و هەموو فەرمانڕەواکان و","poem":1},{"text":"هەموو خاکی ژێر دەسەڵاتیان.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ئینجا زەوی دەلەرزێت و ژان دەیگرێت،","poem":1},{"text":"چونکە مەبەستی یەزدان لە بابل دێتە دی،","poem":2},{"text":"بۆ ئەوەی خاکی بابل وێران بکات،","poem":1},{"text":"ئیتر ئاوەدانی تێدا نابێت.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"پاڵەوانەکانی بابل وازیان لە جەنگ هێنا،","poem":1},{"text":"لە قەڵاکان دانیشتن.","poem":2},{"text":"هێزیان لەبەر بڕا،","poem":1},{"text":"وەک ژنیان لێهات.","poem":2},{"text":"نشینگەکانیان سووتێنرا،","poem":1},{"text":"شمشیرەی دەرگاکانیان شکێنرا.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"نێردراوێک بەدوای یەکێکی دیکە دەکەوێت و","poem":1},{"text":"پەیامنێرێک بەدوای پەیامنێرێکی دیکە،","poem":2},{"text":"بۆ ئەوەی بە پاشای بابل ڕابگەیەنن","poem":1},{"text":"کە سەرتاسەری شارەکانی گیراون،","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ڕووبارەکان","poem":1},{"noteId":82},{"text":"دەستیان بەسەردا گیرا،","poem":1},{"text":"زۆنگاوەکان بە ئاگر سووتێنران،","poem":2},{"lineBreak":true},{"text":"جەنگاوەرەکان تۆقین.»","poem":2}]},{"type":"verse","number":33,"content":["یەزدانی سوپاسالار، خودای ئیسرائیل، ئەمە دەفەرموێت:",{"text":"«شاری بابل وەک جۆخینێکە","poem":1},{"text":"کاتی گێرەیەتی،","poem":2},{"lineBreak":true},{"text":"پاش کەمێک کاتی بەرهەم دێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«نەبوخودنەسری پاشای بابل ئێمەی خوارد،","poem":1},{"text":"ئومێدبڕی کردین،","poem":2},{"lineBreak":true},{"text":"ئێمەی کردە گۆزەیەکی بەتاڵ.","poem":2},{"text":"وەک ئەژدیها هەڵیلووشین،","poem":1},{"text":"سکی خۆی پڕکرد لە چێژی ئێمە،","poem":2},{"lineBreak":true},{"text":"ئینجا ئێمەی ڕشاندەوە.»","poem":2}]},{"type":"verse","number":35,"content":[{"text":"دانیشتووانەکەی سییۆن دەڵێن:","poem":1},{"text":"«ئەو ستەمەی لە ئێمە کرا بەسەر بابل بێت.»","poem":2},{"text":"ئۆرشەلیم دەڵێت:","poem":1},{"text":"«خوێنم لە ملی دانیشتووانی خاکی بابلە.»","poem":2}]},{"type":"verse","number":36,"content":["لەبەر ئەوە یەزدان ئەمە دەفەرموێت:",{"text":"«ئەوەتا من داکۆکی لە کێشەکەت دەکەم،","poem":1},{"text":"تۆڵەی تۆ دەکەمەوە،","poem":2},{"text":"دەریاکەی","poem":1},{"noteId":83},{"text":"وشک دەکەم،","poem":1},{"text":"کانییەکانی کوێر دەکەمەوە.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"بابل دەبێتە تەپۆڵکە و","poem":1},{"text":"داڵدەی چەقەڵ،","poem":2},{"text":"پەند و مایەی تانە و تەشەر،","poem":1},{"text":"شوێنێک ئاوەدانی تێدا نییە.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"پێکەوە وەک جوانە شێر دەنەڕێنن،","poem":1},{"text":"وەک بەچکە شێرەکان دەمڕێنن.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"کاتێک گەرم دەبن،","poem":1},{"text":"داوەتیان دەکەم و","poem":2},{"lineBreak":true},{"text":"سەرخۆشیان دەکەم،","poem":2},{"text":"بۆ ئەوەی دڵخۆش بن،","poem":1},{"text":"ئینجا هەتاهەتایە خەویان لێ دەکەوێت و بەئاگا نایەن.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":40,"content":[{"text":"«وەک بەرخ دەیانبەم بۆ سەربڕین","poem":1},{"text":"وەک بەران و نێری.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"«شێشەخ","poem":1},{"noteId":84},{"text":"چۆن دەگیرێت،","poem":1},{"text":"شانازی هەموو زەوی چۆن دەستبەسەر دەکرێت!","poem":2},{"text":"چۆن وێران بوو،","poem":1},{"text":"بابل لەنێو نەتەوەکان!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"دەریا بەسەر بابلدا هەڵدەچێت،","poem":1},{"text":"بە هەڵچوونی شەپۆلەکانی دایدەپۆشێت.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"شارۆچکەکانی وێران بوون،","poem":1},{"text":"بوونە بیابان و دەشتی ڕووت،","poem":2},{"text":"خاکێک کە نە کەس تێیدا نیشتەجێ دەبێت و","poem":1},{"text":"نە ئادەمیزاد پێیدا تێدەپەڕێت.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"