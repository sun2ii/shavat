{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["گەمارۆی ئۆرشەلیم"]},{"type":"verse","number":1,"content":[{"text":"«ئەی نەوەی بنیامین،","poem":1},{"text":"لە ئۆرشەلیم هەڵبێن!","poem":2},{"text":"لە تەقۆعە فوو بە کەڕەنادا بکەن!","poem":1},{"text":"لەسەر بێت‌هاکارەم ئاگر وەک نیشانە هەڵبکەن!","poem":2},{"text":"چونکە بەڵا و شکستێکی گەورە","poem":1},{"text":"لە باکوورەوە دەرکەوتووە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"من سییۆنی کچ","poem":1},{"noteId":11},{"text":"لەناو دەبەم،","poem":1},{"text":"کچە جوان و نازدارەکە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"شوانەکان بە مێگەلەکانیانەوە","poem":1},{"noteId":12},{"text":"بۆ لای ئەو دێن،","poem":1},{"text":"ڕەشماڵەکان لە دەوری هەڵدەدەن و","poem":2},{"lineBreak":true},{"text":"هەرکەسە لە بەشی خۆی دەلەوەڕێنێ.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«جەنگێک لە دژی سییۆن ئامادە بکەن!","poem":1},{"text":"هەستن بە نیوەڕۆ هێرش ببەین!","poem":2},{"text":"بەڵام بە داخەوە، ڕۆژ ئاوا بوو،","poem":1},{"text":"سێبەرەکانی ئێوارە درێژبوونەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"کەواتە هەستن بە شەو هێرش ببەین،","poem":1},{"text":"قەڵاکانی وێران بکەین!»","poem":2}]},{"type":"verse","number":6,"content":["یەزدانی سوپاسالار ئەمە دەفەرموێت:",{"text":"«دار ببڕنەوە و","poem":1},{"text":"مەتەرێز لە دەوری ئۆرشەلیمەوە دابڕێژن.","poem":2},{"text":"دەبێت ئەو شارە سزا بدرێت،","poem":1},{"text":"چونکە سەراپای پڕ ستەمە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"وەک کانییەک ئاوەکەی هەڵبقوڵێت،","poem":1},{"text":"ئاوا خراپییەکەی هەڵدەقوڵێت.","poem":2},{"text":"توندوتیژی و ڕفاندنی تێدا دەبیسترێت،","poem":1},{"text":"هەمیشە لەبەردەمم نەخۆشی و برینداری هەیە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەی ئۆرشەلیم، ئاگاداربە،","poem":1},{"text":"نەوەک پشتم لە تۆ بکەم،","poem":2},{"text":"نەوەک بتکەمە خاکێکی وێران،","poem":1},{"text":"ئیتر کەسی تێدا نیشتەجێ نەبێ.»","poem":2}]},{"type":"verse","number":9,"content":["یەزدانی سوپاسالار ئەمە دەفەرموێت:",{"text":"«با پاشماوەی ئیسرائیل بە تەواوی بچنرێنەوە،","poem":1},{"text":"بە تەواوی وەک ڕەزەمێو،","poem":2},{"text":"با دەستت بەسەر لقەکاندا بگێڕیت،","poem":1},{"text":"وەک کەسێک ترێ دەچنێتەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"بۆ کێ قسە بکەم؟ کێ ئاگادار بکەمەوە؟","poem":1},{"text":"کێ گوێم لێ دەگرێت؟","poem":2},{"text":"ئەوەتا گوێیان داخراوە","poem":1},{"text":"بۆ ئەوەی نەتوانن گوێ شل بکەن.","poem":2},{"text":"فەرمایشتی یەزدان بۆیان بووە بە ڕیسوایی،","poem":1},{"text":"دڵیان پێی خۆش نییە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لەبەر ئەوە پڕبووم لە تووڕەیی یەزدان،","poem":1},{"text":"بێزاربووم لە دەستپێوەگرتنی.","poem":2},{"lineBreak":true},{"text":"ئینجا یەزدان پێی فەرمووم:","poem":1},{"lineBreak":true},{"text":"«تووڕەییەکەم بەسەر منداڵانی کۆڵاندا هەڵبڕێژە","poem":1},{"text":"بەسەر تێکڕای کۆڕی گەنجان،","poem":2},{"text":"ژن لەگەڵ مێرد دەبردرێت،","poem":1},{"text":"پیر لەگەڵ بەساڵاچووان.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ماڵەکانیان بۆ خەڵکی دیکە دەبن،","poem":1},{"text":"کێڵگە و ژنەکانیان پێکەوە،","poem":2},{"text":"چونکە دەستم بۆ سەر دانیشتووانی خاکەکە","poem":1},{"text":"درێژ دەکەم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"«لە بچووکیان هەتا گەورەیان،","poem":1},{"text":"هەموویان پەرۆشی قازانجن،","poem":2},{"text":"لە پێغەمبەرەوە هەتا کاهین،","poem":1},{"text":"هەموو ساختە دەکەن.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"برینی گەلەکەم بە سووکیەوە چاک دەکەنەوە و","poem":1},{"text":"دەڵێن: ”ئاشتی، ئاشتی!“","poem":2},{"lineBreak":true},{"text":"بەڵام ئاشتی نییە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئایا شەرمەزار بوون کاتێک کاری قێزەونیان کرد؟","poem":1},{"text":"نەخێر! شەرمەزار نەبوون،","poem":2},{"lineBreak":true},{"text":"هەروەها نەیانزانی شەرمەزاری چییە.","poem":2},{"text":"لەبەر ئەوە دەکەونە ناو کوژراوان،","poem":1},{"text":"لە کاتی سزادانیان تێکدەشکێن.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":16,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«لەسەر ڕێگاکان بوەستن و تەماشا بکەن،","poem":1},{"text":"پرسیاری ڕێچکە کۆنەکان بکەن،","poem":2},{"text":"ڕێگا چاکەکە لەکوێیە، پێیدا بڕۆن،","poem":1},{"text":"حەسانەوە بۆ دەروونتان دەدۆزنەوە.","poem":2},{"lineBreak":true},{"text":"بەڵام گوتتان: ”پێیدا ناڕۆین.“","poem":2}]},{"type":"verse","number":17,"content":[{"text":"چاودێرم بەسەرتانەوە دانا، گوتم:","poem":1},{"text":"”گوێ بۆ دەنگی کەڕەنا شل بکەن!“","poem":2},{"lineBreak":true},{"text":"بەڵام گوتتان: ”گوێ شل ناکەین.“","poem":2}]},{"type":"verse","number":18,"content":[{"text":"لەبەر ئەوە ئەی نەتەوەکان، گوێ بگرن،","poem":1},{"text":"ئەی شایەتەکان، بزانن چییان بەسەردێت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەی زەوی، گوێ بگرە:","poem":1},{"lineBreak":true},{"text":"ئەوەتا من بەڵا بەسەر ئەم گەلەدا دەهێنم،","poem":1},{"text":"بەروبوومی بیرکردنەوەکانیانە،","poem":2},{"text":"چونکە گوێیان بۆ وشەکانم شل نەکرد و","poem":1},{"lineBreak":true},{"text":"فێرکردنی منیان ڕەتکردەوە.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"بەلامەوە گرنگ نییە، بخوور لە شەباوە بێت و","poem":1},{"text":"قامیشی بۆنخۆش لە خاکێکی دوورەوە؟","poem":2},{"text":"قوربانی سووتاندنەکانتان قبوڵ نین و","poem":1},{"text":"قوربانییە سەربڕدراوەکانتان لەلای من خۆش نین.»","poem":2}]},{"type":"verse","number":21,"content":["لەبەر ئەوە یەزدان ئەمە دەفەرموێت:",{"text":"«من کۆسپ بۆ ئەم گەلە دادەنێم،","poem":1},{"text":"باوکان و کوڕان پێکەوە ساتمەی لێ دەکەن،","poem":2},{"lineBreak":true},{"text":"دراوسێ و هاوڕێ لەناودەچن.»","poem":2}]},{"type":"verse","number":22,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«ئەوەتا! سوپایەک لە خاکی باکوورەوە دێت،","poem":1},{"text":"نەتەوەیەکی مەزن لەوپەڕی زەوییەوە هەڵدەستێنرێت.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"کەوان و ڕمیان بە دەستەوەیە،","poem":1},{"text":"دڵڕەقن و بەزەییان نییە،","poem":2},{"text":"دەنگیان وەک دەریا هاژەی دێت و","poem":1},{"text":"سواری ئەسپ دەبن،","poem":2},{"text":"وەک یەک پیاو ڕیز دەبەستن","poem":1},{"text":"بۆ هێرشکردنە سەر تۆ، ئەی سییۆنی کچ.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"هەواڵی ئەوانمان بیست،","poem":1},{"text":"ورەمان ڕووخا،","poem":2},{"text":"تووشی تەنگانە بووین،","poem":1},{"text":"تووشی ئازار بووین وەک ئازاری ژنی ژانگرتوو.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"دەرمەچن بۆ کێڵگە!","poem":1},{"text":"بە ڕێگادا مەڕۆن!","poem":2},{"text":"چونکە دوژمن شمشێری پێیە،","poem":1},{"text":"لە هەموو لایەکەوە ترس و تۆقین هەیە.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ئەی گەلەکەم، جلوبەرگی گوش بپۆشە،","poem":1},{"text":"خۆت لە خۆڵەمێش بگەوزێنە،","poem":2},{"text":"شینی تاقانەیەک بۆ خۆت بگێڕە، بە لاوانەوەیەکی تاڵ،","poem":1},{"text":"چونکە لەناکاو تێکدەر بەسەرماندا دەدات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«ئەی یەرمیا، تۆم لەنێو گەلەکەم دانا،","poem":1},{"text":"وەک تاقیکەرەوە و سەنگی مەحەک،","poem":2},{"text":"بۆ ئەوەی ڕەفتاریان بزانیت و","poem":1},{"text":"تاقییان بکەیتەوە.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"هەموو یاخی و کەللەڕەقن،","poem":1},{"text":"بە پەلەن بۆ بوختانکردن،","poem":2},{"text":"ئەوان بڕۆنز و ئاسنن،","poem":1},{"text":"هەموو تێکدەرن.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"مووشەی دێت مووشەدەمە","poem":1},{"noteId":13},{"text":"بۆ ئەوەی بە ئاگر قورقوشم بفەوتێنێت،","poem":2},{"text":"بەڵام بێهوودە زێڕنگەر بێگەردی دەکات،","poem":1},{"text":"بەدکاران بێگەرد نابن.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"پێیان دەگوترێت زیوی ناپەسەند،","poem":1},{"text":"چونکە یەزدان پەسەندی نەکردوون.»","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"ئۆرشەلیم.‏","reference":{"chapter":6,"verse":2}},{"noteId":12,"caller":"+","text":"مەبەستی لە پاشا و لەشکرەکانیانە.‏","reference":{"chapter":6,"verse":3}},{"noteId":13,"caller":"+","text":"ئامرازێکە بۆ فووکردنی هەوا بۆ گەرمکردنی ئاگر بەکاردێت.‏","reference":{"chapter":6,"verse":29}}]},"thisChapterLink":"/api/ckb_bib/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}