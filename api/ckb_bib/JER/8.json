{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":["«یەزدان دەفەرموێت: ”لەو کاتەدا، ئێسکی پاشا و پیاوە گەورەکانی یەهودا، ئێسکی کاهین و پێغەمبەران، ئێسکی دانیشتووانی ئۆرشەلیم لە گۆڕەکانیان دەردەهێنن."]},{"type":"verse","number":2,"content":["بۆ خۆر و مانگ و هەموو ئەستێرەکانی ئاسمان دەریدەخەن، ئەوانەی خۆشیان ویستن و ئەوانەی پەرستنیان و دوایان کەوتن و ڕاوێژیان پێ کردن و کڕنۆشیان بۆ بردن. کۆناکرێنەوە و نانێژرێن، بەڵکو دەبنە زبڵ بەسەر ڕووی خاکەکەوە."]},{"type":"verse","number":3,"content":["هەموو ئەوانەی لەم نەتەوە بەدکارە ماونەتەوە، لە هەر شوێنێک کە دەرمکردن بۆی، مردنیان پێ لە ژیان چاکتر دەبێت. ئەمە فەرمایشتی یەزدانی سوپاسالارە.“"]},{"type":"heading","content":["گوناه و سزا"]},{"type":"verse","number":4,"content":["«پێیان بڵێ: ”یەزدان ئەمە دەفەرموێت:",{"text":"«”ئایا کەسێک بکەوێت هەڵناستێتەوە؟","poem":1},{"text":"یان کەسێک هەڵبگەڕێتەوە، ناگەڕێتەوە؟","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بۆچی ئەم گەلە هەڵگەڕایەوە؟","poem":1},{"text":"بۆچی خەڵکی ئۆرشەلیم بە بەردەوامی هەڵدەگەڕێنەوە؟","poem":2},{"text":"دەستیان بە فرتوفێڵ گرتووە،","poem":1},{"text":"ڕەتیانکردەوە بگەڕێنەوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بە ئاگاییەوە گوێم شل کرد،","poem":1},{"text":"بەڵام ڕاستی ناڵێن.","poem":2},{"text":"کەس نییە لە خراپەی خۆی پەشیمان بێتەوە و","poem":1},{"text":"بڵێت: ’چیم کرد؟‘","poem":2},{"text":"هەریەکە و گەڕاوەتەوە سەر ڕێڕەوەکەی خۆی،","poem":1},{"text":"وەک ئەسپێکی بە تاو بۆ ناو جەنگ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"تەنانەت لەقلەق لە ئاسمان","poem":1},{"text":"کاتی خۆی دەزانێت،","poem":2},{"text":"کۆتر و پەڕەسێلکە و ڕیشۆڵەش","poem":1},{"text":"کاتی هاتنی خۆیان ڕەچاو دەکەن،","poem":2},{"text":"بەڵام گەلەکەی من نازانن","poem":1},{"text":"یەزدان داوای چییان لێ دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«”ئێوە چۆن دەڵێن: ’ئێمە داناین،","poem":1},{"text":"چونکە فێرکردنی یەزدانمان لەلایە،‘","poem":2},{"text":"لە کاتێکدا پێنووسی درۆی مامۆستایانی تەورات","poem":1},{"text":"بۆ درۆ دەستبەکار بوو؟","poem":2}]},{"type":"verse","number":9,"content":[{"text":"داناکان ڕیسوا دەبن،","poem":1},{"text":"دەتۆقن و پێوە دەبن.","poem":2},{"text":"ئەوەتا فەرمایشتی یەزدانیان ڕەتکردەوە،","poem":1},{"text":"ئیتر چ داناییەکیان هەیە؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لەبەر ئەوە ژنەکانیان دەدەمە خەڵکی دیکە،","poem":1},{"text":"کێڵگەکانیان بەوانەی میراتگریانن،","poem":2},{"text":"چونکە لە بچووکەوە هەتا گەورە","poem":1},{"text":"هەموو پەرۆشی قازانجن،","poem":2},{"text":"لە پێغەمبەرەوە هەتا کاهین","poem":1},{"text":"هەموو ساختە دەکەن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"برینی گەلەکەم بە سووکیەوە چاک دەکەنەوە و","poem":1},{"text":"دەڵێن، ’ئاشتی، ئاشتی!‘","poem":2},{"lineBreak":true},{"text":"بەڵام ئاشتی نییە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئایا شەرمەزار بوون کاتێک کاری قێزەونیان کرد؟","poem":1},{"text":"نەخێر! شەرمەزار نەبوون،","poem":2},{"lineBreak":true},{"text":"هەروەها نەیانزانی شەرمەزاری چییە.","poem":2},{"text":"لەبەر ئەوە دەکەونە ناو کوژراوان،","poem":1},{"text":"لە کاتی سزادانیان تێکدەشکێن.“»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"یەزدان دەفەرموێت: «”دروێنەکەیان لێ دەبەم،","poem":1},{"text":"نە ترێ بە مێوەوە دەمێنێت،","poem":2},{"lineBreak":true},{"text":"نە هەنجیر بە دار هەنجیرەوە،","poem":2},{"text":"گەڵاکانیش سیس دەبن.","poem":1},{"text":"ئەوەی دەیاندەمێ لەلایان نامێنێت.“»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«ئێمە بۆچی دانیشتووین؟","poem":1},{"text":"با کۆببینەوە!","poem":2},{"text":"با هەڵبێین بۆ شارە قەڵابەندەکان و","poem":1},{"text":"لەوێ لەناوبچین!","poem":2},{"text":"یەزدانی پەروەردگارمان بڕیاری لەناوچوونی ئێمەی داوە،","poem":1},{"text":"ئاوی ژەهراویمان دەرخوارد دەدات،","poem":2},{"lineBreak":true},{"text":"لەبەر ئەوەی لە دژی یەزدان گوناهمان کرد.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"چاوەڕێی ئاشتی بووین،","poem":1},{"text":"بەڵام چاکە نەبوو.","poem":2},{"text":"چاوەڕێی کاتی چاکبوونەوە بووین،","poem":1},{"text":"بەڵام ئەوەتا تۆقین.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"پڕمەی ئەسپەکانی ئەو","poem":1},{"text":"لە دانەوە دەبیسترێت،","poem":2},{"text":"لە دەنگی حیلەی ئەسپە بەهێزەکانی","poem":1},{"text":"هەموو زەوی دەلەرزێت،","poem":2},{"text":"جا هاتن بۆ ئەوەی بخۆن،","poem":1},{"text":"زەوی و هەرچی تێیدایە،","poem":2},{"lineBreak":true},{"text":"شار و دانیشتووانەکەی.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«ئاگاداربن، ماری ژەهراوی دەنێرمە سەرتان،","poem":1},{"text":"کە نوشتەیان لێ ناکرێت،","poem":2},{"lineBreak":true},{"text":"ئینجا پێتانەوە دەدەن.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ئەی خودایە، تۆ دڵنەوایی خەمی منیت،","poem":1},{"text":"دڵم دەردەدارە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەوەتا دەنگی هانای گەلەکەم","poem":1},{"text":"لە خاکێکی دوورەوە دێت:","poem":2},{"text":"«ئایا یەزدان لە سییۆن نییە؟","poem":1},{"text":"یان پاشاکەی تێیدا نییە؟»","poem":2},{"lineBreak":true},{"text":"«بۆچی بە پەیکەرە داتاشراوەکانیان پەستیان کردم،","poem":1},{"text":"بە بتە هیچوپووچە بێگانەکان؟»","poem":2},{"noteId":16}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«دروێنە تێپەڕی،","poem":1},{"text":"هاوین تەواو بوو،","poem":2},{"lineBreak":true},{"text":"ئێمەش ڕزگارمان نەبوو.»","poem":2},{"noteId":17}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"لەبەر وردوخاشبوونی گەلەکەم وردوخاش بووم،","poem":1},{"text":"خەمبارم، تۆقین دەستی بەسەردا گرتووم.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ئایا لە گلعاد هەتووان","poem":1},{"noteId":18},{"text":"نییە؟","poem":1},{"text":"ئایا پزیشک لەوێ نییە؟","poem":2},{"text":"ئیتر بۆچی برینی گەلەکەم","poem":1},{"text":"ساڕێژ نابێت؟","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"ئەمە بەشێکە لە فەرمایشتی خودا.‏","reference":{"chapter":8,"verse":19}},{"noteId":17,"caller":"+","text":"ئەمە قسەی گەلی خودایە.‏","reference":{"chapter":8,"verse":20}},{"noteId":18,"caller":"+","text":"مەرهەم بۆ ساڕێژبوونی برین.‏","reference":{"chapter":8,"verse":22}}]},"thisChapterLink":"/api/ckb_bib/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}