{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JER","translationId":"ckb_bib","name":"یەرمیا","commonName":"یەرمیا","title":"یەرمیا","order":24,"numberOfChapters":52,"sha256":"782364ff02a1167d742c87ee277a8fdd5f7cc85e2698372a6cd23d41173c3436","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/ckb_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"خۆزگە سەرم گۆمی ئاو بووایە و","poem":1},{"text":"چاوەکانم جۆگەی فرمێسک،","poem":2},{"text":"جا شەو و ڕۆژ دەگریام","poem":1},{"text":"بۆ کوژراوەکانی گەلەکەم.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"خۆزگە دیوەخانێکم لە چۆڵەوانی هەبووایە،","poem":1},{"text":"جا وازم لە گەلەکەم دەهێنا و لەلای دەڕۆیشتم،","poem":2},{"text":"چونکە ئەوان هەموو داوێنپیسن و","poem":1},{"text":"کۆمەڵی ناپاکانن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«زمانیان ئامادە دەکەن","poem":1},{"text":"وەک کەوانێک بۆ هاویشتنی درۆ،","poem":2},{"text":"بەسەر خاکەکەدا زاڵ بوون،","poem":1},{"text":"بەڵام بە ڕێگای ڕاستی نەبوو،","poem":2},{"text":"چونکە لە خراپەیەکەوە دەچنە خراپەیەکی دیکە،","poem":1},{"text":"بەڵام دان بە مندا نانێن.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"«با هەریەکە وریای خۆی بێت لە برادەرەکەی،","poem":1},{"text":"پشت بە هیچ برایەک مەبەستن،","poem":2},{"text":"چونکە هەموو برایەک وەک یاقوب هەڵخەڵەتێنەرە","poem":1},{"noteId":19},{"text":"و","poem":1},{"text":"هەموو برادەرێک بوختانکەرە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"هەرکەسە و برادەری خۆی فریودەدات،","poem":1},{"text":"کەس بە ڕاستی نادوێت.","poem":2},{"text":"زمانی خۆیان بە درۆ ڕاهێناوە،","poem":1},{"text":"خۆیان لە خراپە ماندوو بوون.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"تۆ لەناو فرتوفێڵ دادەنیشیت،","poem":1},{"text":"بە فرتوفێڵ ڕەتیان کردەوە دان بە مندا بنێن.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":7,"content":["لەبەر ئەوە یەزدانی سوپاسالار ئەمە دەفەرموێت:",{"text":"«ئەوەتا من دەیانپاڵێوم و تاقییان دەکەمەوە،","poem":1},{"text":"لەبەر گوناهەکانیان چارەسەرێکی دیکە نییە بۆ گەلەکەی من.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"زمانیان تیری کوشندەیە و","poem":1},{"text":"بە دەمیان فێڵ دەکەن.","poem":2},{"text":"هەرکەسە بە هاوڕێکەی دەڵێت، ”ئاشتی“،","poem":1},{"text":"بەڵام لە ناخییەوە بۆسەی بۆ دەنێتەوە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئایا لەسەر ئەمە سزایان نەدەم؟","poem":1},{"text":"ئایا من تۆڵە لە نەتەوەیەکی وەک ئەمە نەستێنمەوە؟»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"بۆ چیاکان گریان و شیوەن دەگێڕم،","poem":1},{"text":"بەسەر لەوەڕگاکانی چۆڵەوانیدا دەلاوێنمەوە،","poem":2},{"text":"چونکە ئەوان وێران بوون و کەس پێیدا تێناپەڕێت،","poem":1},{"text":"دەنگی مێگەل نابیسترێت،","poem":2},{"text":"باڵندەکانی ئاسمان ڕایانکرد،","poem":1},{"text":"ئاژەڵەکان ڕۆیشتن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ئۆرشەلیم وێران دەکەم،","poem":1},{"text":"دەیکەمە داڵدەی چەقەڵ،","poem":2},{"text":"شارۆچکەکانی یەهودا دەکەمە کاولگە","poem":1},{"text":"بەبێ دانیشتووان.»","poem":2}]},{"type":"verse","number":12,"content":["کێ کەسێکی دانایە و ئەمە تێدەگات؟ کێ ئەوەی یەزدان فێری کرد دەتوانێت ڕوونی بکاتەوە؟ بۆچی زەوی لەناوچوو، چۆڵەوانی وێران بوو، کەس ناتوانێت لێی بپەڕێتەوە؟"]},{"type":"verse","number":13,"content":["یەزدان فەرمووی: «لەبەر ئەوەی وازیان لە فێرکردنەکەم هێنا، ئەوەی خستمە پێشیان پەیڕەویان نەکرد، گوێڕایەڵی من نەبوون."]},{"type":"verse","number":14,"content":["لەبری ئەوە، بەدوای کەللەڕەقی خۆیان کەوتن، بەدوای بەعلەکان کەوتن، کە باوباپیرانیان فێریان کردن.»"]},{"type":"verse","number":15,"content":["لەبەر ئەوە یەزدانی سوپاسالار، خودای ئیسرائیل، ئاوا دەفەرموێت: «ئەوەتا من زەقنەبووت دەرخواردی ئەم گەلە دەدەم و ئاوی ژەهراوییان پێ دەنۆشم."]},{"type":"verse","number":16,"content":["بەناو چەندین نەتەوەدا پەرتیان دەکەم کە نە خۆیان و نە باوباپیرانیان نەیانناسیون، بە شمشێریش ڕاویان دەنێم هەتا لەناویان دەبەم.»"]},{"type":"verse","number":17,"content":["یەزدانی سوپاسالار ئەمە دەفەرموێت:",{"text":"«سەرنج بدەن! بانگی ژنە ماتەمگێڕەکان بکەن هەتا بێن،","poem":1},{"text":"بنێرن بەدوای ژنە شارەزاکان.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"با خێرا بێن و دەنگی شیوەن بەسەرماندا هەڵبڕن،","poem":1},{"text":"چاوەکانمان فرمێسک بڕێژێت و","poem":2},{"lineBreak":true},{"text":"پێڵووەکانمان ئاویان لێ هەڵبقوڵێت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"دەنگی شیوەن لە سییۆنەوە بیسترا،","poem":1},{"text":"”چۆن تێکدراین!","poem":2},{"lineBreak":true},{"text":"چەند شەرمەزار بووین!","poem":2},{"text":"چونکە زەوییەکەمان بەجێهێشت،","poem":1},{"text":"چونکە ماڵەکانمان کاول کران.“»","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ئەی ژنان، گوێ لە فەرمایشتی یەزدان بگرن،","poem":1},{"text":"گوێ لە فەرمایشتی دەمی ئەو بگرن.","poem":2},{"text":"کچەکانتان فێری شیوەن بکەن،","poem":1},{"text":"هەر ژنێکیش دەستەخوشکەکەی فێری ماتەم گێڕان بکات.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"مردن بە پەنجەرەکانمان هەڵگەڕا،","poem":1},{"text":"هاتە ناو قەڵاکانمانەوە،","poem":2},{"text":"بۆ قڕکردنی منداڵان لە کۆڵان و","poem":1},{"text":"لاوان لە گۆڕەپانەکان.","poem":2}]},{"type":"verse","number":22,"content":["بڵێ: «یەزدان ئەمە دەفەرموێت:",{"text":"«”تەرمی مرۆڤ دەکەوێت،","poem":1},{"text":"وەک زبڵ بەسەر ڕووی کێڵگەوە،","poem":2},{"text":"وەک چەپکی دوای دروێنەکەر،","poem":1},{"text":"کەس نییە کۆی بکاتەوە.“»","poem":2}]},{"type":"verse","number":23,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«با دانا شانازی بە دانایی خۆی نەکات،","poem":1},{"text":"با پاڵەوان شانازی بە پاڵەوانیێتی خۆی نەکات،","poem":2},{"lineBreak":true},{"text":"با دەوڵەمەند شانازی بە دەوڵەمەندیێتی خۆی نەکات،","poem":2}]},{"type":"verse","number":24,"content":[{"text":"بەڵکو ئەوەی شانازی دەکات، با شانازی بەمە بکات:","poem":1},{"text":"کە لە من تێدەگات و دەمناسێت،","poem":2},{"text":"کە من یەزدانم، ئەوەی خۆشەویستی نەگۆڕ و","poem":1},{"text":"دادوەری و ڕاستودروستی لەسەر زەوی دەهێنمە دی،","poem":2},{"lineBreak":true},{"text":"چونکە خۆشی لەمانە دەبینم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":25,"content":["یەزدان دەفەرموێت: «سەردەمێک دێت، سزای هەموو ئەوانە دەدەم کە تەنها بە لەش خەتەنە کراون،"]},{"type":"verse","number":26,"content":["خەڵکی میسر و یەهودا و ئەدۆم و عەمۆن و مۆئاب و قژبڕاوەکانی",{"noteId":20},"دانیشتووی چۆڵەوانی. هەموو نەتەوەکان خەتەنە نەکراون و هەموو بنەماڵەی ئیسرائیلیش دڵیان خەتەنە نەکراوە",{"noteId":21},".»"]}],"footnotes":[{"noteId":19,"caller":"+","text":"بڕوانە چیرۆکی یاقوب لە پەیدابوون 27‏:36‏‏.‏","reference":{"chapter":9,"verse":4}},{"noteId":20,"caller":"+","text":"خەڵکێک بوون وەک نەریتێکی بتپەرستی پرچیان بڕیوە.‏","reference":{"chapter":9,"verse":26}},{"noteId":21,"caller":"+","text":"هەرچەندە بنەماڵەی ئیسرائیل جەستەیان خەتەنەکراوە، بەڵام ڕۆحیان تەرخان نەکراوە بۆ یەزدان.‏","reference":{"chapter":9,"verse":26}}]},"thisChapterLink":"/api/ckb_bib/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}