{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"heading","content":["قسەی چوارەمی ئەیوب"]},{"type":"verse","number":1,"content":["ئەیوبیش وەڵامی دایەوە:"]},{"type":"verse","number":2,"content":[{"text":"«ڕاستە ئێوە گەلێکن،","poem":1},{"text":"بە مردنتان داناییش دەمرێت،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بەڵام منیش وەک ئێوە تێگەیشتنم هەیە،","poem":1},{"text":"من لە ئێوە کەمتر نیم.","poem":2},{"lineBreak":true},{"text":"ئایا ئەوەی تۆ دەیڵێیت لای هەموو کەسێک نەزانراوە؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«لە خودا پاڕامەوە و ئەویش وەڵامی دایەوە،","poem":1},{"text":"بەڵام بووم بە گاڵتەجاڕی هاوڕێیەکانم،","poem":2},{"lineBreak":true},{"text":"هەرچەندە پیاوێکی ڕاستودروست و بێ کەموکوڕیم، بوومە مایەی گاڵتەجاڕی!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"کەسێکی دڵنیا","poem":1},{"text":"گاڵتە بە شکستی پێ هەڵخلیسکاو دەکات.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"چادری تێکدەران ئارامە و","poem":1},{"text":"ئاسوودەییش بۆ ئەوانەی خودا تووڕە دەکەن،","poem":2},{"lineBreak":true},{"text":"بۆ ئەوانەی بە دەستی خۆیان بتەکانیان دەهێنن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«بەڵام پرسیار لە ئاژەڵان بکە، ئەوان فێرت دەکەن،","poem":1},{"text":"هەروەها پرسیار لە باڵندەی ئاسمانیش بکە، ئەوان پێت ڕادەگەیەنن؛","poem":2}]},{"type":"verse","number":8,"content":[{"text":"یان لەگەڵ زەوی بدوێ، فێرت دەکات،","poem":1},{"text":"ماسی دەریاش بۆت باس دەکەن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"کام لەمانە نازانێت کە","poem":1},{"text":"دەستی خودا ئەمەی ئەنجام داوە؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەوەی ژیانی هەموو زیندووێک و","poem":1},{"text":"ڕۆحی هەموو مرۆڤێکی لەناو دەستدایە؟","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئایا گوێ قسەکان تاقی ناکاتەوە و","poem":1},{"text":"مەڵاشوو تامی خواردن ناکات؟","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لە ڕیش سپیێتی دانایی و","poem":1},{"text":"لە تەمەن درێژیش تێگەیشتن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«دانایی و تواناداری لەلای خوداوەیە،","poem":1},{"text":"ڕاوێژ و تێگەیشتن هی ئەون.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەوەی دەڕووخێنێت بنیاد نانرێتەوە،","poem":1},{"text":"ئەگەر دەرگای لەسەر کەسێک داخست لێی ناکرێتەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ڕێ لە ئاو دەگرێت، وشکەساڵی دێت،","poem":1},{"text":"بەڕەڵای دەکات زەوی سەرەوژێر دەکات.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"هێز و دانایی لەلای ئەوە،","poem":1},{"text":"چەواشەکار و چەواشەکراو هی ئەون.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ڕاوێژکاران بە پێ خاوسی دەبات،","poem":1},{"text":"دادوەران تووشی شێتی دەکات.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"کۆتی پاشاکان دەکاتەوە و","poem":1},{"text":"ناوقەدیان بە پشتێن دەبەستێتەوە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"کاهینەکان بە پێ خاوسی دەبات و","poem":1},{"text":"پتەوەکان سەرەوژێر دەکات.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ڕێگری گفتوگۆ لە شارەزایان دەکات،","poem":1},{"text":"ژیری لە پیران دەستێنێتەوە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"سووکایەتی بەسەر پایەداراندا دەبارێنێت و","poem":1},{"text":"پشتێنی بەهێزان شل دەکاتەوە.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"قووڵاییەکان لە تاریکی ئاشکرا دەکات و","poem":1},{"text":"سێبەری مەرگ بۆ ڕووناکی دەردەخات.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"نەتەوەکان مەزن دەکات و لەناویان دەبات،","poem":1},{"text":"نەتەوەکان بەرفراوان دەکات و پەرتەوازەیان دەکات.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"مێشک لە سەرکردەکانی گەلی زەوی دەستێنێتەوە و","poem":1},{"text":"لە چۆڵەوانییەکی بێ ڕێگا وێڵیان دەکات.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"لە تاریکیدا بە پەلەکوتێ دەڕۆن و ڕووناکی نییە،","poem":1},{"text":"وەک سەرخۆش بە ئەملا و ئەولادا دەکەون.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}