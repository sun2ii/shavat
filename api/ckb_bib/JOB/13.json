","number":21,"content":[{"text":"دەستت لێم دووربخەوە و","poem":1},{"text":"با سامی تۆ نەمترسێنێت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ئینجا بانگم بکە و من وەڵام دەدەمەوە،","poem":1},{"text":"یان من قسە دەکەم و تۆ وەڵامم بدەوە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"چەند تاوان و گوناهم هەیە؟","poem":1},{"text":"یاخیبوون و گوناهەکەی خۆمم پێ بناسێنە.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"بۆچی ڕووی خۆت دەشاریتەوە و","poem":1},{"text":"بە دوژمنی خۆت دامدەنێیت؟","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ئایا گەڵایەکی هەڵوەریو پان دەکەیتەوە؟","poem":1},{"text":"ئایا بەدوای پووشی وشکدا ڕادەکەیت؟","poem":2}]},{"type":"verse","number":26,"content":[{"text":"تۆ بە تاڵی لە دژم دەنووسیت و","poem":1},{"text":"لەسەر تاوانەکانی لاویێتیم سزام دەدەیت.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"جا پێیەکانی منت خستووەتە ناو کۆتەوە و","poem":1},{"text":"چاوت بڕیوەتە هەموو ڕێڕەوەکانم و","poem":2},{"lineBreak":true},{"text":"شوێن پێیەکانم دەپشکنیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«وەک دارێکی کلۆر لەناو دەچم،","poem":1},{"text":"وەک جلێک کە مۆرانە لێی دابێت.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}