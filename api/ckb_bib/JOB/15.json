{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"heading","content":["وەڵامی دووەمی ئەلیفاز"]},{"type":"verse","number":1,"content":["ئەلیفازی تێمانیش وەڵامی دایەوە:"]},{"type":"verse","number":2,"content":[{"text":"«ئایا کەسی دانا بە نەزانی وەڵام دەداتەوە و","poem":1},{"text":"مێشکی بە شتی هیچوپووچ پڕ دەکات؟","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئایا بە قسەی بێ سوود بەڵگە دێنێتەوە و","poem":1},{"text":"بەو لێدوانانەی قازانجی لێ ناکات؟","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بەڵام تۆ لەخواترسی پێشێل دەکەیت و","poem":1},{"text":"خەڵک لە خواپەرستی دوور دەخەیتەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بێگومان گوناهەکانت دەمت فێر دەکەن و","poem":1},{"text":"زمانی تەڵەکەبازی هەڵدەبژێریت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"زمانی خۆت تاوانبارت دەکات، نەک من،","poem":1},{"text":"لێوەکانت لە دژت شایەتی دەدەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ئایا تۆ یەکەم مرۆڤ بوویت لەدایک بوویت؟","poem":1},{"text":"یان لەپێش گردەکانەوە دروستبوویت؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئایا لە ئەنجومەنی خودا","poem":1},{"noteId":6},{"text":"گوێت گرتبوو؟","poem":1},{"text":"ئایا داناییت بە باڵای خۆتدا بڕیوە؟","poem":2}]},{"type":"verse","number":9,"content":[{"text":"چی دەزانیت کە ئێمە نایزانین،","poem":1},{"text":"چی تێدەگەیت کە لەلای ئێمە نەبێت؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"پیر و ڕیش سپی وامان لەناودایە،","poem":1},{"text":"تەمەنی لە باوکت زیاترە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئایا دڵنەواییەکانی خودا و","poem":1},{"text":"بە نەرمی قسەکردن لەگەڵت کەمە؟","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بۆچی دڵت دەتبات و","poem":1},{"text":"بۆچی چاوەکانت دەبریسکێنەوە،","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بۆ ئەوەی ڕۆحت لە دژی خودا وەربگێڕیت و","poem":1},{"text":"قسەی وا لە دەمت بهێنیتە دەرەوە؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«مرۆڤ کێیە هەتا بێگەرد بێت و","poem":1},{"text":"لەدایکبوو لە ژن کێیە هەتا ڕاستودروست بێت؟","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەگەر خودا متمانە بە پیرۆزەکانی خۆی ناکات،","poem":1},{"text":"کەواتە ئاسمان لەبەرچاوی بێگەرد نییە،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئیتر مرۆڤ کە ناڕەوایی وەک ئاو دەخواتەوە","poem":1},{"text":"دەبێت چەند قێزەون و گەندەڵ بێت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«من پێت دەڵێم گوێم لێ بگرە،","poem":1},{"text":"باسی ئەوە دەکەم کە بینیم،","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئەوەی دانایان لە باوباپیرانیانەوە پێیان ڕاگەیەنراوە و","poem":1},{"text":"ئەوانیش نەیانشاردووەتەوە،","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەوانەی خاکەکە تەنها بەوان دراوە و","poem":1},{"text":"هیچ نامۆیەک بەناویاندا تێنەپەڕیوە.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"بەدکار ڕۆژانە دەتلێتەوە،","poem":1},{"text":"ژمارەی ساڵانی ستەمکاریش دیاریکراوە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"دەنگێکی ترسناک لە گوێیەکانیەتی و","poem":1},{"text":"لە ساتی ئاشتیدا تێکدەر بۆی دێت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"لەو باوەڕەدا نییە لە تاریکی دەگەڕێتەوە؛","poem":1},{"text":"چاوەڕوانی شمشێرە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ئەو وێڵە و دەبێتە نێچیری سیسارکە کەچەڵ،","poem":1},{"text":"دەزانێت کە ڕۆژی تاریکی نزیکە.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"تەنگانە و ئازار دەیتۆقێنن و","poem":1},{"text":"بەسەریدا زاڵن وەک پاشایەکی ئامادە بۆ پەلاماردان،","poem":2}]},{"type":"verse","number":25,"content":[{"text":"چونکە بە تووڕەییەوە دەستی لە خودا ڕادەوەشێنێت،","poem":1},{"text":"لە دژی خودای هەرە بەتوانا پاڵەوانیێتی نواند،","poem":2}]},{"type":"verse","number":26,"content":[{"text":"بە کەللەڕەقییەوە بەرەو ئەو ڕایکرد","poem":1},{"text":"بە قەڵغانە ئەستوور و بەهێزەکەیەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«هەرچەندە دەموچاوی بە چەوری داپۆشی و","poem":1},{"text":"ناوقەدی خۆی بە پیو","poem":2},{"noteId":7},{"text":"ئەستوور کرد،","poem":2}]},{"type":"verse","number":28,"content":[{"text":"بەڵام لە شارۆچکەی کاولبوو نیشتەجێ دەبێت،","poem":1},{"text":"لەو ماڵانەی کەسی تێدا ناژیێت و","poem":2},{"lineBreak":true},{"text":"خەریکن دەبنە کەلاوە.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"لەمەودوا دەوڵەمەند نابێت و سامانەکەی جێگیر نابێت،","poem":1},{"text":"دەستکەوتی لەناو زەویدا بەرفراوان نابێت.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"لە تاریکی دەرباز نابێت،","poem":1},{"text":"کڵپەی گڕێک پۆپکەکانی وشک دەکات و","poem":2},{"lineBreak":true},{"text":"بە فووێکی دەمی نامێنێت.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"جێی باوەڕ نابێت","poem":1},{"text":"بە شتی پووچ وێڵ دەبێت،","poem":2},{"lineBreak":true},{"text":"چونکە شتی پووچ دەبێت بە کرێیەکەی.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"پێش ئەوەی ڕۆژی خۆی تەواو بێت،","poem":1},{"text":"دەفەوتێت و گەڵاکەی سەوز نابێت.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"وەک ترێ پەسیرەکانی","poem":1},{"noteId":8},{"text":"دەکەوێت و","poem":1},{"text":"وەک زەیتوون گوڵەکەی هەڵدەوەرێت.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"کۆمەڵی خوانەناسان چۆڵوهۆڵ دەبێت،","poem":1},{"text":"ئاگریش ڕەشماڵی بەرتیلخۆران دەسووتێنێت.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"بە ئاژاوە دووگیان بوون و خراپەیان بۆ لەدایک دەبێت،","poem":1},{"text":"سکیان پیلانی فێڵ و درۆ پێکدەهێنێت.»","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"هەندێک لە فریشتەکان لەبەردەم خودا ئامادە دەبن، خودا لە فەرمایشت و فەرمانەکانی دەکرێ ڕاوێژیان پێ بکات و گفتوگۆیان لەگەڵ بکات.‏","reference":{"chapter":15,"verse":8}},{"noteId":7,"caller":"+","text":"پیو: واتا بەز.‏","reference":{"chapter":15,"verse":27}},{"noteId":8,"caller":"+","text":"بەرسیلەکانی.‏","reference":{"chapter":15,"verse":33}}]},"thisChapterLink":"/api/ckb_bib/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}