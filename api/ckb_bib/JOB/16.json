{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["قسەی پێنجەمی ئەیوب"]},{"type":"verse","number":1,"content":["ئەیوبیش وەڵامی دایەوە:"]},{"type":"verse","number":2,"content":[{"text":"«زۆرم لەمانە گوێ لێ بووە،","poem":1},{"text":"هەموو دڵنەواییەکەتان بریندارکەرن!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئایا قسەی پووچ کۆتایی هەیە؟","poem":1},{"text":"یان چی دەتوروژێنێت هەتا وەڵام بدەیتەوە؟","poem":2}]},{"type":"verse","number":4,"content":[{"text":"منیش وەک ئێوە قسەم دەکرد،","poem":1},{"text":"ئەگەر ئێوە لە جێی من بوونایە؛","poem":2},{"text":"قسەم بۆ دەگێڕانەوە و","poem":1},{"text":"سەرم لە ئاستتان دەلەقاند.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بەڵام بە دەم هانم دەدان و","poem":1},{"text":"جوڵەی لێوەکانم ڕایدەگرتن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«ئەگەر قسە بکەم لە خەمۆکیەکەم کەم نابێتەوە،","poem":1},{"text":"ئەگەر بێدەنگیش بم لێم دوور ناکەوێتەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئەی خودایە، بێگومان تۆ بێزارت کردووم،","poem":1},{"text":"هەموو کەسوکارەکەی منت لەناوبردووە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"سستت کردم، سستییەکەم بووە شایەت،","poem":1},{"text":"لاوازییەکەم لێم هەستاوە، بەرەوڕوو شایەتیم لەسەر دەدات.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"تووڕەییەکەی پەلاماری دام و منی چەوساندەوە،","poem":1},{"text":"ددانەکانی لێم جیڕکردەوە،","poem":2},{"lineBreak":true},{"text":"دوژمنەکەم چاوی تێبڕیوم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"خەڵک دەمیان لێ داچەقاندووم،","poem":1},{"text":"بە گاڵتەپێکردنەوە زللەیان لێدەدام،","poem":2},{"lineBreak":true},{"text":"پێکەوە گەلەکۆمەیان لێکردم.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"خودا منی دایە دەست زۆردار و","poem":1},{"text":"فڕێیدامە نێو دەستی خراپەکارەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"من ئاسوودە بووم و ئەو جێی لەق کردم،","poem":1},{"text":"پشتەملی گرتم و وردوخاشی کردم.","poem":2},{"text":"منی کرد بە نیشانی خۆی؛","poem":1}]},{"type":"verse","number":13,"content":[{"text":"تیرهاوێژەکانی دەوریان دام.","poem":2},{"text":"جەرگی بڕیم و دڵی نەسووتا،","poem":1},{"text":"زراوی منی بەسەر زەویدا ڕشت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"جار لەدوای جار شەقم دەکات،","poem":1},{"text":"وەک جەنگاوەرێک هێرش دەکاتە سەرم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«جلوبەرگی گوشم","poem":1},{"noteId":9},{"text":"بە پێستمەوە دووری و","poem":1},{"text":"خۆڵەمێشم بە سەری خۆمدا کرد.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"دەموچاوم لەبەر گریان سوور هەڵگەڕا و","poem":1},{"text":"ڕەشی بەسەر پێڵوی چاومدا هات.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لەگەڵ ئەوەی زۆرداری لە دەستی مندا نییە و","poem":1},{"text":"نوێژەکەم بێگەردە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«ئەی زەوی، خوێنەکەم دامەپۆشە،","poem":1},{"text":"با جێیەک نەبێت بۆ هاوارم!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەوەتا لە ئێستاوە شایەتەکەم لە ئاسمانە،","poem":1},{"text":"پارێزگارەکەم لە بەرزاییەکانە،","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئەو هاوڕێمە و داکۆکیم لێ دەکات.","poem":1},{"text":"کاتێک لەبەردەم خودا چاوەکانم فرمێسک دەڕێژن،","poem":2},{"noteId":10}]},{"type":"verse","number":21,"content":[{"text":"ئەو لە پێناوی پیاوێک لە خودا دەپاڕێتەوە،","poem":1},{"text":"وەک پاڕانەوەی کەسێک بۆ هاوڕێکەی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«تەمەنم کورتە و بەسەردەچێت،","poem":1},{"text":"لە ڕێگایەکدا دیلم کە لێی ناگەڕێمەوە.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"لە کاتی ماتەمگێڕان و تۆبەکردندا جلوبەرگی لە گوش دروستکراویان لەبەرکردووە کە ئەزیەتی پێستیانی داوە.‏","reference":{"chapter":16,"verse":15}},{"noteId":10,"caller":"+","text":"لە هەندێک وەرگێڕانەکان دەگوترێت: هاوڕێیەکانم گاڵتە پێم دەکەن.‏","reference":{"chapter":16,"verse":20}}]},"thisChapterLink":"/api/ckb_bib/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}