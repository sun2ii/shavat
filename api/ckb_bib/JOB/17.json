{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"ڕۆحم شکا،","poem":1},{"text":"ڕۆژگارم کوژایەوە،","poem":2},{"lineBreak":true},{"text":"گۆڕ چاوەڕێی منە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بێگومان گاڵتەجاڕان لە دەورمدان و","poem":1},{"text":"ناچار تەماشای کێشمەکێشیان بکەم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«تکایە لەلای خۆت ببە پشتگیرم،","poem":1},{"text":"بێجگە لە تۆ کێ هەیە ببێتە کەفیلم؟","poem":2}]},{"type":"verse","number":4,"content":[{"text":"تێگەیشتنت لە مێشکیان شاردووەتەوە،","poem":1},{"text":"لەبەر ئەوە بەرزیان ناکەیتەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەوەی لە پێناوی پارە پەنجەی تاوان بۆ هاوڕێیەکانی ڕادەکێشێت،","poem":1},{"text":"نەبوونی چاوی منداڵەکانی دەپوکێنێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«منی کردە پەندی گەلان و","poem":1},{"text":"بووم بەوەی تف لە ڕووم بکرێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"چاوەکانم لەبەر خەم کز بوون،","poem":1},{"text":"هەموو ئەندامەکانم زۆر لاواز بوون.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەوانەی ڕاستن بەمە سەرسام دەبن و","poem":1},{"text":"بێتاوان بەسەر خوانەناسدا ڕادەپەڕێت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"کەسی ڕاستودروست ڕێگای خۆی دەگرێت و","poem":1},{"text":"ئەوەی دەست پاکە هێزی بۆ زیاد دەکرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«ئێستا وەرنەوە، دووبارە هەوڵ بدەن،","poem":1},{"text":"بەڵام من هیچ دانایەکتان تێدا نادۆزمەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ڕۆژگارم بەسەرچوو، مەبەستەکانم هەڵکەنران.","poem":1},{"text":"لەگەڵ ئەوەشدا ئارەزووەکانی دڵم","poem":2}]},{"type":"verse","number":12,"content":[{"text":"شەو دەکەن بە ڕۆژ،","poem":1},{"text":"لە تاریکیدا ڕووناکی بە نزیک دەبینن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەگەر هیوا بخوازم جیهانی مردووان ببێت بە ماڵم و","poem":1},{"text":"لە تاریکیدا نوێنەکەم ڕابخەم،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەگەر بە گۆڕم گوت: ”تۆ باوکی منیت،“","poem":1},{"text":"بە کرمیش: ”تۆ دایکی منیت“ یان ”خوشکی منیت،“","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئیتر ئومێدم کوا؟","poem":1},{"text":"کێ تەماشای ئومێدم دەکات؟","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئایا بەرەو قووڵایی جیهانی مردووان دەچێتە خوارەوە؟","poem":1},{"text":"ئایا پێکەوە لەناو خۆڵ شۆڕدەبینەوە؟»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}