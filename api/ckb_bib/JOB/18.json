{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["وەڵامی دووەمی بیلدەد"]},{"type":"verse","number":1,"content":["بیلدەدی شوحیش وەڵامی دایەوە:"]},{"type":"verse","number":2,"content":[{"text":"«هەتا کەی تەڵە بۆ قسە دەنێنەوە؟","poem":1},{"text":"تێبگەن ئینجا ئێمە دەتوانین قسە بکەین.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بۆچی بە ئاژەڵ دانراین و","poem":1},{"text":"لەبەرچاوتان گێل بووین؟","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەی ئەوەی لە ڕقی خۆی، خۆی دەخواتەوە،","poem":1},{"text":"ئایا لەبەر تۆ زەوی چۆڵ بکرێت و","poem":2},{"lineBreak":true},{"text":"تاشەبەرد لە جێی خۆی بجوڵێت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«بەڵێ چرای بەدکاران دەکوژێتەوە و","poem":1},{"text":"گڕی ئاگرەکەی ڕووناکی نابەخشێت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لەناو چادرەکەی ڕووناکی تاریک دەبێت و","poem":1},{"text":"چراکەی تەنیشتی دەکوژێتەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"هێزی هەنگاوەکانی کورت دەبن و","poem":1},{"text":"ڕاوێژەکەی خۆی دەیخات.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بە پێیەکانی خۆی بۆ ناو داو هەنگاو دەنێت،","poem":1},{"text":"جا لەناو تۆڕدا گیر دەخوات.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"تەڵە پاژنەی پێی دەگرێت و","poem":1},{"text":"فاقە توند دەیگرێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"داوەکانی لە زەوی شاردراونەتەوە و","poem":1},{"text":"تەڵەکەی لەسەر ڕێگایە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بەڵاکان لە هەموو لایەکەوە دەیتۆقێنن و","poem":1},{"text":"هەنگاوبەهەنگاو دوای کەوتوون.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"برسیێتی بڕستی لێ بڕی و","poem":1},{"text":"کارەسات چاوەڕێی کەوتنی دەکات.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"نەخۆشی پارچەکانی پێستەکەی دەخوات،","poem":1},{"text":"یەکەم بەری مەرگ ئەندامەکانی لەشی دەخوات.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"لە ئارامی ناو چادرەکەی خۆی دەڕفێنرێت،","poem":1},{"text":"بەرەو لای پاشای بەڵاکان پەلکێش دەکرێت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەوەی هی ئەو نییە لەناو چادرەکەی نیشتەجێ دەبێت،","poem":1},{"text":"گۆگرد بەسەر جێی مانەوەی پەخش دەکرێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"لە ژێرەوە ڕەگوڕیشەی وشک دەبێت و","poem":1},{"text":"لە سەرەوەش لقەکانی سیس دەبن.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"یادەوەری لە زەوی نامێنێت و","poem":1},{"text":"لەسەر ڕووی وشکانیش هیچ ناوێکی نییە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"لە ڕووناکییەوە پاڵ دەدرێت بۆ تاریکی و","poem":1},{"text":"لە جیهان دەردەکرێت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"نە نەوە و نە وەچەی لەنێو گەلەکەی دەبێت،","poem":1},{"text":"نە دەربازبوو لەنێو چادرەکانی.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"خەڵکی ڕۆژئاوا لە ڕۆژی حوکمدان لەسەر ئەودا دەحەپەسێن،","poem":1},{"text":"گەلانی ڕۆژهەڵات مووچڕکەیان پێدا دێت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئەوە نشینگەی بەدکارانە و","poem":1},{"text":"ئەمە شوێنی ئەوانەیە کە خودا ناناسن.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}