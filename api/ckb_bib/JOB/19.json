{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["قسەی شەشەمی ئەیوب"]},{"type":"verse","number":1,"content":["ئەیوبیش وەڵامی دایەوە:"]},{"type":"verse","number":2,"content":[{"text":"«هەتا کەی گیانم ئازار دەدەن و","poem":1},{"text":"بە قسە وردم دەکەن؟","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئەمە دەیەم جارە ڕیسوام دەکەن،","poem":1},{"text":"بەبێ شەرمی هێرشتان کردە سەرم.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"گریمان بە ڕاستی گومڕا بووم،","poem":1},{"text":"گومڕاییەکەم بەسەر خۆم دەشکێتەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەگەر بەڕاستی ئێوە خۆتان لە من بە گەورەتر دادەنێن و","poem":1},{"text":"شەرمەزارییەکەی من لە دژی خۆم بەکاردەهێنن،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەوا با لەلاتان زانراو بێت، خودا خۆی منی خوار کردووەتەوە و","poem":1},{"text":"تۆڕەکەی بەدەورمدا ڕاکێشا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«هەرچەندە لەبەر ستەم هاوار دەکەم، بەڵام وەڵامم نادرێتەوە،","poem":1},{"text":"هاوار دەهێنم، بەڵام دادپەروەری نییە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ڕێی لێ گرتم و ناپەڕمەوە،","poem":1},{"text":"تاریکی خستووەتە سەر ڕێڕەوم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"شکۆمەندییەکەمی لێم داماڵی و","poem":1},{"text":"تاجەکەی سەرمی لێکردەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لە هەموو لایەکەوە منی ڕووخاند تاوەکو نەمێنم و","poem":1},{"text":"هیوای منی وەک دار هەڵکەند.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"تووڕەیی خۆی بەسەرمدا داگیرساند و","poem":1},{"text":"بە دوژمنی خۆی دانام.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"پەلاماردەرەکانی پێکەوە هاتن و","poem":1},{"text":"سەنگەریان لە دژی من لێدا و","poem":2},{"lineBreak":true},{"text":"لە دەوری چادرەکەم خۆیان دامەزراند.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«کەسوکاری منی لێم دوورخستەوە و","poem":1},{"text":"ناسیاوەکانم لێم بوون بە بێگانە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"خزمەکانم وازیان لێ هێنام و","poem":1},{"text":"ئەوانەی منیان ناسی لەبیریان کردم.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"میوان و کارەکەرەکانم وەک بیانی دایاننام،","poem":1},{"text":"وەک نامۆیەک مامەڵەم لەگەڵ دەکەن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بانگی خزمەتکارەکەی خۆمم کرد بەڵام وەڵامی نەدایەوە،","poem":1},{"text":"هەرچەندە بە دەمی خۆم لێی پاڕامەوە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"بۆنم ناخۆش بووە لەلای ژنەکەم و","poem":1},{"text":"قێزەونم لەلای جگەرگۆشەکانم.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"تەنانەت منداڵانیش سووکایەتییان پێکردم،","poem":1},{"text":"کە هەستم، باسی من دەکەن.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"هەموو دۆستەکانم ڕقیان لێم بووەوە و","poem":1},{"text":"ئەوانەی خۆشم دەویستن لە دژم هەڵگەڕانەوە.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئێسکم بە پێست و گۆشتمەوە نووساوە و","poem":1},{"text":"بە خۆم و پووکمەوە دەرباز بووم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«بەزەییتان پێم بێتەوە، بەزەییتان پێم بێتەوە ئەی هاوڕێیان،","poem":1},{"text":"چونکە دەستی خودا لێی داوم.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بۆچی ئێوەش وەک خودا ڕاوم دەنێن؟","poem":1},{"text":"لە گۆشتم تێر نابن؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"«خۆزگە وشەکانم دەنووسرانەوە،","poem":1},{"text":"خۆزگە لەناو تۆمارێکدا وێنەیان دەکێشرا،","poem":2}]},{"type":"verse","number":24,"content":[{"text":"خۆزگە بە پێنووسی ئاسن لەسەر قورقوشم دەنووسران یان","poem":1},{"text":"بۆ هەتاهەتایە لەسەر بەرد هەڵدەکۆڵران.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"بەڵام من زانیم ئەوەی کە دەمکڕێتەوە","poem":1},{"noteId":11},{"text":"زیندووە و","poem":1},{"text":"لە کۆتاییدا لەسەر زەوی ڕاست دەبێتەوە.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"پاش ئەوەی ئەم پێستەم لەناودەچێت،","poem":1},{"text":"هەر لە جەستەی خۆم خودا دەبینم.","poem":2},{"noteId":12}]},{"type":"verse","number":27,"content":[{"text":"ئەوەی من بۆ خۆم دەیبینم و","poem":1},{"text":"چاوەکانم تەماشا دەکەن، نەک یەکێکی دیکە،","poem":2},{"lineBreak":true},{"text":"لە ناخمەوە تامەزرۆی ئەوەم!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«ئەگەر ئێوە دەڵێن: ”چەند ڕاوی دەنێین،","poem":1},{"text":"چونکە ڕەگی کێشەکە لەلای ئەوە،“","poem":2}]},{"type":"verse","number":29,"content":[{"text":"لە خۆتان بترسن لە ڕووی شمشێر،","poem":1},{"text":"چونکە تووڕەیی سزای شمشێر دەهێنێت،","poem":2},{"lineBreak":true},{"text":"ئیتر دەزانن کە دادوەری هەیە.»","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"وەک کڕینەوەی کۆیلەیەک بۆ ئازادبوون.‏","reference":{"chapter":19,"verse":25}},{"noteId":12,"caller":"+","text":"لە عیبری دەگوترێت (لە جەستەکەمەوە)، هەروەها هەندێک لە وەرگێڕانەکان بە (جەستەم هەیە کە خودا دەبینم) وەریانگێڕاوە.‏","reference":{"chapter":19,"verse":26}}]},"thisChapterLink":"/api/ckb_bib/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}