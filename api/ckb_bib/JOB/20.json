{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["وەڵامی دووەمی چۆفەر"]},{"type":"verse","number":1,"content":["چۆفەری نەعماتیش وەڵامی دایەوە:"]},{"type":"verse","number":2,"content":[{"text":"«لەبەر جۆشانی ناخم،","poem":1},{"text":"بیرکردنەوەکانم هانم دەدەن وەڵام بدەمەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"گوێم لە سەرزەنشتەکانی تۆ دەبێت کە سووکایەتیم پێ دەکەیت،","poem":1},{"text":"ڕۆحی تێگەیشتنم وام لێ دەکات وەڵام بدەمەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«ئایا لە کۆنەوە ئەمەت نەزانیوە،","poem":1},{"text":"لەو کاتەوەی مرۆڤ لەسەر زەوی دانراوە؟","poem":2}]},{"type":"verse","number":5,"content":[{"text":"هاواری خۆشی خراپەکاران کورتە و","poem":1},{"text":"خۆشی خوانەناس بۆ ساتێکە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"هەرچەندە لووتبەرزی خوانەناس بگاتە ئاسمان و","poem":1},{"text":"سەریشی لە هەور بدات،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بەڵام وەک تەپاڵە خۆی بۆ هەتاهەتایە لەناودەچێت و","poem":1},{"text":"ئەوانەی بینیویانە دەڵێن: ”کوا؟“","poem":2}]},{"type":"verse","number":8,"content":[{"text":"وەک خەون دەفڕێت و ئیتر نامێنێت،","poem":1},{"text":"وەک مۆتەکەیەک دەردەکرێت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"چاوێک کە بینیویەتی دیسان نایبینێتەوە،","poem":1},{"text":"جارێکی دیکە شوێنەکەشی نابینرێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"کوڕەکانی هەوڵ دەدەن هەژاران ڕازی بکەن؛","poem":1},{"text":"دەستەکانی سامانەکەی دەدەنەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئێسکەکانی پڕ لە گەنجیێتین،","poem":1},{"text":"بەڵام ئەو گەنجیێتییە لەگەڵیدا لەناو خاک ڕادەکشێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«کە خراپە لەناو دەمی شیرین بێت و","poem":1},{"text":"لەژێر زمانی بیشارێتەوە،","poem":2}]},{"type":"verse","number":13,"content":[{"text":"دڵی پێی سووتاو و بەجێی نەهێشت،","poem":1},{"text":"بەڵکو لەناو گەرویدا بەندی کرد،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"بەڵام نانەکەی لەناو ڕیخۆڵەکانی دەگۆڕێت،","poem":1},{"text":"دەبێتە تاڵی ژەهری مار لەناو سکی.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"سامانێکی قووت دا و دەیڕشێنێتەوە؛","poem":1},{"text":"خودا لەناو سکی وەدەری دەنێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ژەهری مار دەمژێت؛","poem":1},{"text":"زمانی مار دەیکوژێت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"جۆگەکان نابینێت،","poem":1},{"text":"ڕووبارە ڕۆیشتووەکانی هەنگوین و قەیماغ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بەری ماندووبوونەکەی دێنێتەوە و قووتی نادات،","poem":1},{"text":"لە قازانجی بازرگانییەکەی خۆشی نابینێت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"لەبەر ئەوەی هەژارانی وردوخاش کرد و بەجێی هێشتن؛","poem":1},{"text":"دەستی بەسەر ماڵێکدا گرت کە بنیادی نەنابوو.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«بێگومان لە ناخیدا نەیزانی بەس چییە؛","poem":1},{"text":"ئەوەی ئارەزووی دەکات دەربازی ناکات.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"خواردنەکەی پاشماوەی نییە؛","poem":1},{"text":"ئیتر خێروخۆشییەکەی بەردەوام نابێت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"لەوپەڕی سەڵتەنەتیدا تووشی تەنگانە دەبێت،","poem":1},{"text":"دەستی هەموو ڕەنجدەرێکی دێتە سەر.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"لە کاتێکدا سکی خۆی پڕ دەکات،","poem":1},{"text":"خودا گڕی تووڕەیی خۆی بۆ دەنێرێت و","poem":2},{"lineBreak":true},{"text":"وەکو باران بەسەریدا دەیبارێنێت.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"لە چەکی ئاسنەوە ڕادەکات و","poem":1},{"text":"تیری بڕۆنز دەیبڕێت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"تیرەکەی ڕاکێشا و لە پشتییەوە هاتە دەرەوە،","poem":1},{"text":"نووکی بریسکەدار زراوی بڕی.","poem":2},{"text":"ترسی بەسەرەوەیە؛","poem":1}]},{"type":"verse","number":26,"content":[{"text":"هەموو تاریکییەک بۆ گەنجینەکانی شاردراوەتەوە.","poem":2},{"text":"ئاگرێک دەیخوات فووی لێ نەکراوە،","poem":1},{"text":"ئەوەی لە چادرەکەی مابێتەوە لووشی دەدات.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ئاسمان تاوانەکەی ئاشکرا دەکات،","poem":1},{"text":"زەوی لێی ڕادەپەڕێت.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"لەو ڕۆژەی کە خودا تووڕەییەکەی دەبارێنێت،","poem":1},{"text":"لافاوێک ماڵەکەی دەبات.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ئەمە بەشی کەسی خراپە لە خوداوە،","poem":1},{"text":"میراتی دیاریکراوە لە خوداوە.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}