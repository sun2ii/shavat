e","number":8,"content":[{"text":"نەوەیان لەبەردەمیان لەگەڵیان ڕاوەستاوە،","poem":1},{"text":"وەچەیان لەبەرچاویانە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ماڵەکانیان لە ترس دڵنیایە؛","poem":1},{"text":"کوتەکی خودا بەسەریانەوە نییە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"گایەکەیان دەپەڕێت و هەڵە ناکات؛","poem":1},{"text":"مانگاکەیان ئاوس دەبێت و لە باری ناچێت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"منداڵەکانیان وەک مەڕ بەڕەڵا دەکرێن؛","poem":1},{"text":"شیرەخۆرەکانیان سەما دەکەن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"دەف و قیسارە بەدەستەوە دەگرن؛","poem":1},{"text":"بە دەنگی دووزەلە دڵخۆش دەبن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ڕۆژگاریان بە خێروخۆشی بەسەردەبەن و","poem":1},{"text":"بە ئارامییەوە بۆ ناو جیهانی مردووان شۆڕ دەبنەوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"لەگەڵ ئەوەشدا بە خودا دەڵێن: ”لێمان دوور بکەوە!","poem":1},{"text":"دڵخۆش نابین بە ناسینی ڕێگاکانت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"توانادارەکە کێیە هەتا خزمەتی بکەین؟","poem":1},{"text":"سوودی چی دەبینین کە لێی بپاڕێینەوە؟“","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بەڵام خێروخۆشییان لە دەستی خۆیان نییە،","poem":1},{"text":"با ڕاوێژی بەدکاران لێم دوور بێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«چەند کەم چرای بەدکاران دەکوژێتەوە و","poem":1},{"text":"کارەساتیان بەسەردێت،","poem":2},{"lineBreak":true},{"text":"یان خودا لە تووڕەیی خۆیدا ئازاری کردووە بە بەشیان؟","poem":2}]},{"type":"verse","number":18,"content":[{"text":"یان وەک کا بن لەبەردەم با و","poem":1},{"text":"وەک ئەو سەرکۆزەرەی ڕەشەبا بردوویەتی؟","poem":2}]},{"type":"verse","number":19,"content":[{"text":"دەگوترێت: ”خودا تاوانی بەدکاران بۆ کوڕەکانیان هەڵدەگرێت.“","poem":1},{"text":"با سزای گیانی خۆیان بدات تاوەکو بزانن!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"با چاوەکانیان لەناوچوونەکەیان ببینن،","poem":1},{"text":"لە جامی تووڕەیی خودای هەرە بەتوانا بخۆنەوە،","poem":2}]},{"type":"verse","number":21,"content":[{"text":"چونکە لەدوای ئەوان، کە ژمارەی مانگەکانیان تەواو دەبێت،","poem":1},{"text":"ئایا گوێ بە کەسوکاریان دەدەن؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«ئایا خودا فێری زانین دەکرێت،","poem":1},{"text":"ئەو کە دادوەری پایەدارەکان دەکات؟","poem":2}]},{"type":"verse","number":23,"content":[{"text":"کەسانێک هەن لەوپەڕی تەندروستیدا دەمرن،","poem":1},{"text":"کاتێک بە تەواوی دڵنیا و ئارامن،","poem":2}]},{"type":"verse","number":24,"content":[{"text":"لەشیان ساغن و","poem":1},{"text":"مۆخی ناو ئێسکەکانیان هێشتا تەڕە.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"کەسانێکی دیکەش بە پەژارەوە دەمرن و","poem":1},{"text":"تامی خێروخۆشییان نەکردووە.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"هەردووکیان پێکەوە لەناو گڵ ڕادەکشێن و","poem":1},{"text":"کرم دایاندەپۆشێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"«بیرکردنەوەی ئێوە باش دەزانم و","poem":1},{"text":"ئەو پیلانانەی بۆ ستەملێکردنم داتانناوە،","poem":2}]},{"type":"verse","number":28,"content":[{"text":"چونکە دەڵێن: ”کوا ماڵی گەورە پیاوەکە؟","poem":1},{"text":"کوا چادری نشینگەی خراپەکاران؟“","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ئایا پرسیارتان لە ڕێبواران نەکردووە و","poem":1},{"text":"سەرنجتان نەداوەتە هەواڵەکانیان؟","poem":2}]},{"type":"verse","number":30,"content":[{"text":"بەدکار لە ڕۆژی کارەسات هەڵدێت،","poem":1},{"text":"ئایا لە ڕۆژی تووڕەیی دەرباز دەبێت؟","poem":2}]},{"type":"verse","number":31,"content":[{"text":"کێ بەرەو ڕوو لەسەر ڕەفتارەکەی سەرزەنشتی دەکات؟","poem":1},{"text":"کێ سزای دەدات لەسەر ئەوەی کردوویەتی؟","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ئەو بەرەو گۆڕەکان دەبردرێت و","poem":1},{"text":"لەسەر گۆڕستان شەوارە دەگرێت.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"قوڕی دۆڵەکە شیرینە بۆ ئەو؛","poem":1},{"text":"هەموو مرۆڤ بەدوایەوە دەڕۆن و","poem":2},{"lineBreak":true},{"text":"لەپێشیشیەوە بەبێ ژمارە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«ئیتر چۆن بە قسەی پڕوپووچ دڵنەواییم دەدەنەوە؟","poem":1},{"text":"لە وەڵامەکانتان تەنها بێوەفایی دەبینم!»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}