{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["وەڵامی سێیەمی ئەلیفاز"]},{"type":"verse","number":1,"content":["ئەلیفازی تێمانیش وەڵامی دایەوە:"]},{"type":"verse","number":2,"content":[{"text":"«ئایا مرۆڤ سوودی بۆ خودا هەیە؟","poem":1},{"text":"تەنانەت کەسێکی دانا، ئایا سوودی بۆ خودا هەیە؟","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئایا خۆشی تێدایە بۆ توانادارەکە کە تۆ ڕاستودروست بیت؟","poem":1},{"text":"ئەگەر ڕەفتارەکەشت بێ کەموکوڕی بێت، ئایا قازانجی بۆ خودا تێدایە؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«ئایا لەسەر لەخواترسییەکەت سەرزەنشتت دەکات و","poem":1},{"text":"تۆ دەداتە دادگا؟","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئایا خراپەکانت زۆر نین و","poem":1},{"lineBreak":true},{"text":"تاوانەکانیشت بێ کۆتایی نین؟","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"بەبێ هۆ بارمتەت لە برای خۆت وەرگرت و","poem":1},{"text":"جلت لەبەر داکەند ڕووتت کردەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئاوت نەدا بە تینوو و","poem":1},{"text":"ئامادە نەبووی نان بدەیتە برسی،","poem":2}]},{"type":"verse","number":8,"content":[{"text":"هەرچەندە تۆ خاوەن زەوی و پیاوێکی بە توانا بووی،","poem":1},{"text":"کە وەک کەسێکی ناودار تێدا نیشتەجێ بوو.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بێوەژنانت بە دەستبەتاڵی بەڕێکرد و","poem":1},{"text":"دەستی هەتیوانت شکاند.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لەبەر ئەوە چواردەورت تەڵەیە و","poem":1},{"text":"ترسی لەناکاو دەتتۆقێنێت،","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لەبەر ئەوەش ئەوەندە تاریک بووە کە نابینیت و","poem":1},{"text":"لافاوێک داتدەپۆشێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«ئایا خودا لە بەرزی ئاسمان نییە؟","poem":1},{"text":"سەیری لووتکەی ئەستێرەکان بکە چەند خۆیان بڵند گرتووە!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بەڵام تۆ دەڵێیت: ”خودا چی دەزانێت؟","poem":1},{"text":"ئایا لە پشت هەوری ڕەشەوە دادوەری دەکات؟","poem":2}]},{"type":"verse","number":14,"content":[{"text":"هەورەکان پەردەن بۆ ئەو ئیتر نامانبینێت","poem":1},{"text":"کە بەسەر بازنەی ئاسمان هاتوچۆ دەکات.“","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئایا تۆش بەو ڕێگا کۆنەدا دەڕۆیت","poem":1},{"text":"کە خراپەکاران پێیدا ڕۆیشتوون؟","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئەوانەی پێشوەخت دەستیان بەسەردا گیرا،","poem":1},{"text":"ڕووبار بەسەر بناغەکەیاندا ڕژا.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئەوانەی بە خودایان گوت: ”لێمان دوور بکەوە!","poem":1},{"text":"خودای هەرە بەتوانا چیمان لەگەڵ دەکات؟“","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بەڵام ئەو بوو کە ماڵەکانی ئەوانی پڕکردووە لە خێروخۆشی،","poem":1},{"text":"با ڕاوێژی خراپەکاران لێم دوور بێت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ڕاستودروستان کە وێرانییان دەبینن، دڵخۆش دەبن،","poem":1},{"text":"بێگەردیش گاڵتەیان پێ دەکات:","poem":2}]},{"type":"verse","number":20,"content":[{"text":"”بێگومان بەرهەڵستکارانمان لەناودەچن و","poem":1},{"text":"سامانەکەشیان ئاگر دەیخوات.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«تکایە لەگەڵ خودا ڕێک بکەوە و لە ئاشتی بە،","poem":1},{"text":"بەمە خێرۆخۆشیت بۆ دێت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"تکایە فێرکردنەکان لە دەمیەوە وەربگرە و","poem":1},{"text":"قسەکانی بخە دڵتەوە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ئەگەر بگەڕێیتەوە بۆ لای خودای هەرە بەتوانا بنیاد دەنرێیتەوە،","poem":1},{"text":"ئەگەر ستەم لە چادرەکەت دووربخەیتەوە،","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ئەگەر زێڕ فڕێبدەیتە سەر خۆڵ و","poem":1},{"text":"زێڕی ئۆفیر بۆ ناو بەردی شیوەکان،","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ئەو کاتە توانادارەکە دەبێت بە زێڕەکەت و","poem":1},{"text":"بە زیوی گرانبەها بۆ تۆ.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"بێگومان ئیتر خۆشی لە توانادارەکە دەبینیت،","poem":1},{"text":"ڕووت لە خودا دەکەیت.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"نوێژی بۆ دەکەیت و گوێت لێ دەگرێت،","poem":1},{"text":"نەزرەکانت","poem":2},{"noteId":13},{"text":"بەجێدەهێنیت.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"بڕیار دەدەیت و بۆت جێبەجێ دەبێت،","poem":1},{"text":"بەسەر ڕێگاکانت ڕووناکی دەدرەوشێتەوە.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"کاتێک خەڵک دەکەون تۆ دەڵێیت: ”هەڵیانبستێنەوە!“","poem":1},{"text":"ئەوا خودا ماتومەلوولەکان ڕزگار دەکات.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"تەنانەت ئەو کەسەی کە بێگەرد نییە دەربازی دەکات،","poem":1},{"text":"بەهۆی دەستپاکییەکەت دەرباز دەبێت.»","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"نەزر: داوا لە خودا دەکرێت بۆ ئەنجامدانی کارێک و پابەند دەکرێت بە مەرجێکەوە. ئەگەر خودا ئەو کارە بکات، ئەوا دەرئەنجام ئەمیش ئەو کارە ئەنجام دەدات کە پێیەوە پابەندی کردووە. بڕوانە سەرژمێری 21‏:2‏‏.‏","reference":{"chapter":22,"verse":27}}]},"thisChapterLink":"/api/ckb_bib/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}