{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["قسەی هەشتەمی ئەیوب"]},{"type":"verse","number":1,"content":["ئەیوبیش وەڵامی دایەوە:"]},{"type":"verse","number":2,"content":[{"text":"«هەروەها ئەمڕۆش سکاڵاکەم جەرگبڕە؛","poem":1},{"text":"لەگەڵ ناڵینم دەستی خودا لەسەرم هەر قورسە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"خۆزگە دەمزانی چۆن پێی بگەم؛","poem":1},{"text":"دەهاتمە لای نشینگەکەی!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بە ڕێکوپێکی کێشە دەخەمە بەردەمی،","poem":1},{"text":"دەمم پڕ دەکەم لە بەهانە،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"هەتا بزانم چۆن وەڵامم دەداتەوە و","poem":1},{"text":"لەوە تێبگەم کە پێم دەڵێت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئایا بە زۆری هێز مشتومڕم لەگەڵ دەکات؟","poem":1},{"text":"نەخێر، بەڵکو پەلکێشی دادگام ناکات.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لەوێ کەسی ڕاست بەهانەی بۆ دەهێنایەوە و","poem":1},{"text":"بۆ هەتاهەتایە لە دەست دادەورەکەم دەرباز دەبووم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«بەڵام ئەگەر بەرەو ڕۆژهەڵات بچم لەوێ نییە،","poem":1},{"text":"بەرەو ڕۆژئاواش هەستی پێ ناکەم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"کاتێک لە باکوور کار دەکات، بەرچاوم ناکەوێت؛","poem":1},{"text":"کاتێک بەرەو باشوور دەسووڕێتەوە، نایبینم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بەڵام ڕێگام دەزانێت،","poem":1},{"text":"دوای ئەوەی تاقیم دەکاتەوە وەک زێڕ دەردەچم.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"پێیەکانم بە هەمان هەنگاوی ئەو ڕۆیشتوون،","poem":1},{"text":"ڕێگای ئەوم گرتەبەر و لام نەدا.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لە فەرمانەکانی زمانی ئەو لام نەداوە؛","poem":1},{"text":"لە نانی پێویستی خۆم زیاتر قسەکانی دەمی ئەوم لە گەنجینەی دڵم هەڵگرتووە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«بەڵام ئەو تاک و تەنهایە و کێ ڕێی لێ دەگرێت؟","poem":1},{"text":"ئەوەی ئارەزووی لێ بێت، دەیکات.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"فەرزی خۆی لە دژی من جێبەجێ دەکات،","poem":1},{"text":"پلانی وەک ئەمانەش زۆرە لەلای.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"لەبەر ئەوە لەبەردەمی دەتۆقم؛","poem":1},{"text":"سەرنج دەدەم و لێی دەترسم.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"خودا دڵی بێهێز کردم؛","poem":1},{"text":"توانادارەکە منی تۆقاند.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لەگەڵ ئەوەشدا تاریکی و تەمە چڕەکەش","poem":1},{"text":"کە ڕوخساری داپۆشیم بێدەنگم ناکات.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}