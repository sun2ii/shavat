{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"«بۆچی خودای هەرە بەتوانا کاتەکانی دادگاییکردنی خراپەکاران دیاری ناکات؟","poem":1},{"text":"بۆچی خواناسەکان ئەو ڕۆژانە نابینن؟","poem":2}]},{"type":"verse","number":2,"content":[{"text":"خراپەکاران سنوور دەگوازنەوە،","poem":1},{"text":"دەست بەسەر مێگەلێکدا دەگرن و دەیلەوەڕێنن.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"گوێدرێژی هەتیوان دەدەنە پێش خۆیان و","poem":1},{"text":"گای بێوەژن وەک بارمتە دەبەن.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"نەداران لەسەر ڕێگا دەردەکەن،","poem":1},{"text":"هەژارانی خاکەکە ناچار دەکەن خۆیان بشارنەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"هەژاران وەک کەرەکێوی لە چۆڵەوانی،","poem":1},{"text":"بۆ گەڕان بەدوای خواردندا دەچن،","poem":2},{"lineBreak":true},{"text":"دەشتودەریش نان بۆ منداڵەکانیان دابین دەکات.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لە کێڵگە ئالیکی خۆیان دروێنە دەکەن،","poem":1},{"text":"لە ڕەزی خراپەکار هەڵدەگرنەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بە ڕووتی بەبێ جل سەر دەنێنەوە،","poem":1},{"text":"هیچ بەرگێکیان نییە لە سەرمادا.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"لەبەر نەبوونی پەناگا بە بارانی چیاکان تەڕ دەبن و","poem":1},{"text":"خۆیان بە تاشەبەردەوە دەگرن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بەدکار هەتیو لە مەمکان دەڕفێنن،","poem":1},{"text":"منداڵی ساوای هەژار وەک بارمتە دەگرن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"نەدار بە ڕووتی دەڕۆن، بەبێ جل،","poem":1},{"text":"بە برسیێتی کۆڵەکان هەڵدەگرن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لەنێو کەڵەکی زەوییەکان زەیت دەگوشن،","poem":1},{"text":"بە پێیان گوشەرەکان دەپەستن و تینوو دەبن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەوانەی لەناو شار لەناودەچن دەناڵێنن،","poem":1},{"text":"گیانی برینداران بۆ فریاکەوتن هاوار دەکەن،","poem":2},{"lineBreak":true},{"text":"بەڵام خودا هیچ کەس بە خراپەکاری تاوانبار ناکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«ئەوانە کە لە ڕووناکی یاخین،","poem":1},{"text":"نە ڕێگاکانی دەزانن و","poem":2},{"lineBreak":true},{"text":"نە لە ڕێڕەوەکانی دەمێننەوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"بکوژ لەگەڵ ڕووناکی هەڵدەستێت و","poem":1},{"text":"هەژار و نەدار دەکوژێت؛","poem":2},{"lineBreak":true},{"text":"بە شەویش بۆ دزی دەچێت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"چاوی داوێنپیسیش تێبینی تاریکوڕوونی دەکات؛","poem":1},{"text":"دەڵێت: ”هیچ چاوێک چاودێریم ناکات،“","poem":2},{"lineBreak":true},{"text":"ڕووپۆشێک لەسەر ڕووی دادەنێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"لە تاریکیدا ماڵ دەبڕن،","poem":1},{"text":"لە ڕۆژیشدا دەرگا لەسەر خۆیان دادەخەن؛","poem":2},{"lineBreak":true},{"text":"ڕووناکی ناناسن.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"تاریکی شەو بەیانییە لەلای ئەوان،","poem":1},{"text":"هاوڕێی تۆقێنەرەکانی تاریکین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«لەگەڵ ئەوەشدا ئەوانە کەفن لەسەر ڕووی ئاوەکان؛","poem":1},{"text":"بەشیان لە زەوی نەفرەت لێکراوە،","poem":2},{"lineBreak":true},{"text":"لەبەر ئەوە کەس ناچێتە ڕەزەکان.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"وەک چۆن وشکەساڵی و گەرما ئاوی بەفر دەبات،","poem":1},{"text":"جیهانی مردووانیش گوناهباران دەڕفێنێت.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"سکی دایک لەبیریان دەکات و","poem":1},{"text":"کرم تامی دەمی پێیان خۆش دەکات؛","poem":2},{"text":"ئیتر یادی خراپەکار ناکرێتەوە و","poem":1},{"text":"وەک دار دەشکێت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لەگەڵ نەزۆک کە منداڵی نەبووە بە خراپی هەڵسوکەوت دەکەن،","poem":1},{"text":"هیچ چاکەیەک لەگەڵ بێوەژن ناکەن.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بەڵام خودا بە هێزی خۆی پاڵەوانان دەگرێت؛","poem":1},{"text":"هەرچەندە هەڵدەستن بەڵام کەسیان لە ژیانی خۆی دڵنیا نابێت.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"دەشێت بیانهێڵێت بە ئاسوودەیی بژین،","poem":1},{"text":"بەڵام چاوی لەسەر ڕێگاکانیانە.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"کەمێک پایەدار دەبن و ئیتر نامێنن؛","poem":1},{"text":"نزم دەبن و وەک هەمووان کۆدەکرێنەوە،","poem":2},{"lineBreak":true},{"text":"وەک سەری گوڵەگەنم دەبڕێنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"«ئەگەر وا نییە، کێ بە درۆم دەخاتەوە و","poem":1},{"text":"قسەکانم وەک هیچ لێ دەکات؟»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}