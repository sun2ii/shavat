{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["ئەیوب دیسان بە هەمان شێوە قسەی کردەوە و گوتی:"]},{"type":"verse","number":2,"content":[{"text":"«بە گیانی خودا کە مافی خۆمی لێم داماڵیوە،","poem":1},{"text":"سوێند بە توانادارەکە کە ناخی منی تاڵکردووە،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"هەتا ئەو کاتەی کە ژیانم لەبەر بێت،","poem":1},{"text":"هەناسەی خودا لە لووتمدا بێت،","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لێوەکانم بە خراپە نادوێن و","poem":1},{"text":"زمانم بە فێڵ ناگەڕێت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لە من بەدوور بێت بڵێم کە ڕاستییەکەی لای ئێوەیە،","poem":1},{"text":"هەتا ئەو کاتەی ژیان بەدەستەوە دەدەم دروستی لە خۆم دانابڕم.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"دەستم بە ڕاستودروستی خۆمەوە گرتووە و شلی ناکەم،","poem":1},{"text":"بە درێژایی ژیانم ویژدانم سەرزەنشتم ناکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«با دوژمنم وەک بەدکار بێت و","poem":1},{"text":"بەرهەڵستکارم وەک زۆردار بێت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"خوانەناس کە دەبڕدرێتەوە چ هیوایەکی هەیە،","poem":1},{"text":"کاتێک خودا ژیانی دەڕفێنێت؟","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئایا خودا گوێی لە هاواری دەبێت","poem":1},{"text":"کە تەنگانەی بەسەردا دێت؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"یان ئایا بە توانادارەکە دڵخۆش دەبێت؟","poem":1},{"text":"ئایا هەموو کاتێک داوا لە خودا دەکات؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«من توانای خوداتان پێ دەناسێنم؛","poem":1},{"text":"کارەکانی توانادارەکە لە ئێوە ناشارمەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەوەتا ئێوە هەمووتان بینیتان،","poem":1},{"text":"ئیتر بۆچی بە پووچی دەدوێن؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«ئەمە بەشی کەسی بەدکارە لەلایەن خوداوە،","poem":1},{"text":"میراتی ستەمکارە کە لە توانادارەکەوە وەریدەگرن.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەگەر کوڕانی زۆر بوون ئەوا بۆ شمشێرن و","poem":1},{"text":"نەوەکەشی تێر نان نابن.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"دەرد پاشماوەکەی دەخاتە ناو گۆڕ و","poem":1},{"text":"بێوەژنەکانیان ناگرین.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئەگەر زیو وەک خۆڵ و","poem":1},{"text":"جلوبەرگ وەک قوڕ کەڵەکە بکات،","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئەوەی ئامادەی دەکات ڕاستودروست لەبەری دەکات،","poem":1},{"text":"بێتاوان زیوەکەی دابەش دەکات.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"وەک قۆزاخەی مۆرانە ماڵەکەی خۆی بنیاد دەنێت و","poem":1},{"text":"وەک کەپرێک چاودێر دروستی بکات.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بە دەوڵەمەندی ڕادەکشێت، بەڵام جارێکی دیکە نایکات؛","poem":1},{"text":"کە چاوی دەکاتەوە هیچی نەماوە.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"کارەساتەکان وەک لافاو پێی دەگەن،","poem":1},{"text":"ڕەشەبایەک بە شەو دەیڕفێنێت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"بای ڕۆژهەڵات هەڵیدەگرێت و دەڕوات،","poem":1},{"text":"لە شوێنی خۆی ڕایدەماڵێت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"لەبەردەم با بەهێزەکە هەڵدێت،","poem":1},{"text":"بایەکەش بەبێ بەزەیی لێی دەدات.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"بە گاڵتەپێکردنەوە چەپڵەی بۆ لێدەدات،","poem":1},{"text":"بە فیکەلێدان لە جێی خۆیەوە دەریدەکات.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}