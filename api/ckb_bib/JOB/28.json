xt":"یاقووتی زەردی کوش هاوتای نابێت و","poem":1},{"text":"بە زێڕی بێگەرد ناکێشرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ئیتر دانایی لەکوێ دەدۆزرێتەوە و","poem":1},{"text":"تێگەیشتن لەکوێ نیشتەجێیە؟","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لەبەرچاوی هەموو زیندووێک شاراوەیە و","poem":1},{"text":"لەبەرچاوی باڵندەکانی ئاسمان داپۆشراوە.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"لەناوچوون و مردن دەڵێن:","poem":1},{"text":"«بە گوێی خۆمان هەواڵی ئەومان بیست.»","poem":2}]},{"type":"verse","number":23,"content":[{"text":"خودا ڕێگاکەی تێدەگات و","poem":1},{"text":"ئەو شوێنەکەی پێ دەزانێت.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"لەبەر ئەوەی ئەو تەماشای ئەوپەڕی زەوی دەکات و","poem":1},{"text":"هەموو ژێر ئاسمان دەبینێت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"کاتێک کێشی بۆ با دروستکرد و","poem":1},{"text":"ئاوەکانی بە پێوانە پێوا،","poem":2}]},{"type":"verse","number":26,"content":[{"text":"کاتێک بۆ باران یاسای دانا و","poem":1},{"text":"بۆ دەنگی هەورەتریشقەش ڕێگا،","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ئەو کاتە دانایی بینی و باسی کرد،","poem":1},{"text":"ئامادەی کرد و هەروەها تاقی کردەوە.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"بە مرۆڤی فەرموو:","poem":1},{"text":"«بێگومان دانایی لە لەخواترسییەوەیە و","poem":2},{"lineBreak":true},{"text":"لە خراپە لادانیش لە تێگەیشتنەوەیە.»","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"یاقووتی شین: دەشێت لاجیوەرد بێت.‏","reference":{"chapter":28,"verse":6}},{"noteId":17,"caller":"+","text":"بەپێی بیروباوەڕی خەڵکی ڕۆژهەڵاتی کۆن (قووڵایی ژێر زەوی) هەبوو کە سەرچاوەی کانیاو و ڕووبارەکان بوو. بڕوانە پەیدابوون 7‏:11‏‏.‏","reference":{"chapter":28,"verse":14}}]},"thisChapterLink":"/api/ckb_bib/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/27.json","previousChap