{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["ئەیوب قسە دەکات"]},{"type":"verse","number":1,"content":["دوای ئەمە ئەیوب دەمی کردەوە و نەفرەتی لەو ڕۆژە کرد کە تێیدا لەدایک بووە."]},{"type":"verse","number":2,"content":["ئەیوب دەستی بە قسە کرد و گوتی:"]},{"type":"verse","number":3,"content":[{"text":"«با لەناوبچێت ئەو ڕۆژەی تێیدا لەدایک بووم،","poem":1},{"text":"ئەو شەوەش کە گوترا: ”کوڕێک لەدایک بوو!“","poem":2}]},{"type":"verse","number":4,"content":[{"text":"با ئەو ڕۆژە تاریک بێت،","poem":1},{"text":"نە خودا لە سەرەوە بایەخی پێ بدات و","poem":2},{"lineBreak":true},{"text":"نە ڕۆژی بەسەردا هەڵبێت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"با تاریکی و سێبەری مەرگ لەسەری بێت،","poem":1},{"text":"با هەور دایبگرێت،","poem":2},{"lineBreak":true},{"text":"با ڕۆژ تاریک دابێت و بیتۆقێنێت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەو شەوە، با شەوەزەنگ بیگرێت،","poem":1},{"text":"لەناو ڕۆژانی ساڵ دڵخۆش نەبێت","poem":2},{"lineBreak":true},{"text":"نەیەتە ناو ژمارەی مانگەکان.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"با ئەو شەوە نەزۆک بێت،","poem":1},{"text":"هاواری خۆشی تێدا نەبێت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بەر نەفرەتی ئەوانە بکەوێت کە نەفرەت لە ڕۆژگار دەکەن،","poem":1},{"text":"ئەوانەی ئامادەن لیڤیاتان بەئاگا بهێنن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"با ئەستێرەکانی بەرەبەیان تاریک دابێن،","poem":1},{"text":"چاوەڕوانی ڕووناکی بێت و نەیەت،","poem":2},{"lineBreak":true},{"text":"با گزنگی بەیان نەبینێت،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"چونکە دەرگاکانی سکی لەسەر من دانەخست و","poem":1},{"text":"چەرمەسەری لە چاوەکانم نەشاردەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«بۆ لە بار دایکم نەچووم،","poem":1},{"text":"کە لەدایک بووم، بۆ ڕۆحم بەدەستەوە نەدا؟","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بۆچی ئەژنۆکان هەڵیانگرتم،","poem":1},{"text":"بۆ مەمک هەبوو تاکو شیر بدرێم؟","poem":2}]},{"type":"verse","number":13,"content":[{"text":"چونکە ئێستا ڕاکشابووم و بێدەنگ ببووم،","poem":1},{"text":"ئەو کاتە بە ئاسوودەیی دەخەوتم،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"لەگەڵ پاشایان و ڕاوێژکارانی زەوی،","poem":1},{"text":"ئەوانەی ئەو کۆشکانەیان بۆ خۆیان بنیاد نا کە ئێستا بوونەتە کەلاوە،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"یان لەگەڵ میران کە زێڕیان هەیە،","poem":1},{"text":"ئەوانەی ماڵەکانیان لە زیو پڕکردووە،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"یان وەک لەبارچووێکی لەخاکنراو، ئینجا نەدەبووم،","poem":1},{"text":"وەک کۆرپەیەک ڕووناکی نەبینیوە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لەوێ خراپەکاران لە ئاژاوەنانەوە دەوەستن","poem":1},{"text":"لەوێ ماندووان پشوو دەدەن،","poem":2}]},{"type":"verse","number":18,"content":[{"text":"دیلەکان تێکڕا ئاسوودە دەبن،","poem":1},{"text":"گوێیان لە دەنگی سەرکار نابێت،","poem":2}]},{"type":"verse","number":19,"content":[{"text":"لەوێ بچووک وەک گەورە وایە،","poem":1},{"text":"کۆیلەش ئازادە لە دەستی گەورەکەی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«بۆ ڕووناکی دەدرێتە ڕەنجدەران و","poem":1},{"text":"ژیانیش بۆ ئەوەی تاڵاوی تێدایە،","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئەوانەی چاوەڕوانی مردن دەکەن و نییە،","poem":1},{"text":"لە گەنجینە زیاتر بەدوایدا دەگەڕێن،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"هەتا ئەوپەڕی شادمانی دڵخۆشن،","poem":1},{"text":"دڵشادن کە گۆڕێک دەبیننەوە؟","poem":2}]},{"type":"verse","number":23,"content":[{"text":"بۆ ژیان دەدرێتە پیاوێک","poem":1},{"text":"کە ڕێگای شاردراوەتەوە،","poem":2},{"lineBreak":true},{"text":"خوداش بە چواردەوریدا پەرژینی لێ داوە؟","poem":2}]},{"type":"verse","number":24,"content":[{"text":"لەبەر ئەوەی ئاخ هەڵکێشانم بووەتە نانی ڕۆژانەم،","poem":1},{"text":"هەنسکیشم وەک ئاو دەڕژێت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ئەوەی دەمتۆقێنێت هاتە سەر ڕێگام،","poem":1},{"text":"ئەوەی لێی دەترسام بەسەرم هات.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ئاسوودە نەبووم و بێدەنگ نەبووم،","poem":1},{"text":"پشووم نەدا و ئاژاوە هات.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}