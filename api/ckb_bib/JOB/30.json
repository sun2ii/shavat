{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"«بەڵام ئێستا ئەوانەی لە من منداڵترن","poem":1},{"text":"گاڵتەم پێ دەکەن،","poem":2},{"text":"ئەوانەی بێزم نەدەهات باوکیان","poem":1},{"text":"لەگەڵ سەگەکانی ناو ڕانەکەم دابنێم.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"دەبێت هێزی دەستیان چ سوودێکی بۆ من هەبێت؟","poem":1},{"text":"لەبەر ئەوەی سست بوون و لە کەڵک کەوتوون.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لە دەستکورتی و لە برسیێتیدا لەڕ بوون؛","poem":1},{"text":"بە شەو بەناو زەوی وشکدا دەگەڕان،","poem":2},{"lineBreak":true},{"text":"کە وێران و کاول بوون.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەوانەی وشترالووک و گەڵایان لە دەوەنەکانەوە دەهێنا،","poem":1},{"text":"ڕەگی دار گەز","poem":2},{"noteId":18},{"text":"خۆراکیان بوو.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لەنێو کۆمەڵەی خەڵک دەردەکران،","poem":1},{"text":"هاواریان بەسەردا دەکردن وەک بەسەر دزدا هاوار بکەن.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لەناو دۆڵە وشکەکان نیشتەجێ بوون،","poem":1},{"text":"لە ئەشکەوت و لەناو تاشەبەردەکان.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لەنێو دەوەنەکان زەڕین و","poem":1},{"text":"لەژێر گەزگەزەکان خۆیان مات کرد.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"نەوەی گێلی، هەروەها نەوەی ئەوانەی بێ ناو بوون،","poem":1},{"text":"لە خاکەکە تێهەڵدراون.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«بەڵام ئێستا ئەو گەنجانە بە گۆرانی گاڵتەم پێ دەکەن؛","poem":1},{"text":"پەندم بەسەردا دەڵێن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"قێزم لێ دەکەنەوە، دوورەپەرێزیم لێ دەگرن؛","poem":1},{"text":"لە تفەکانیان ڕووی من ناپارێزن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"خودا پەتی کەوانەکەی منی بەرداوە و منی چەماندووەتەوە،","poem":1},{"text":"جڵەوی لغاوەکەم بەدەستیانەوەیە،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لەلای ڕاستم گەنجە لاسارەکان هێرش دەکەنە سەرم،","poem":1},{"text":"پاشقولم لێ دەگرن و سەنگەر لە دژی من لێ دەدەن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ڕێگاکانم لێ تێکدەدەن،","poem":1},{"text":"بۆ ژێرکەوتنم هاوکاری یەکتر دەکەن،","poem":2},{"lineBreak":true},{"text":"کەس نییە پشتگیری من بکات.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەوان دێن هەروەک لە کەلێنێکی فراوانەوە بێن،","poem":1},{"text":"لەژێر وێرانیەوە خلۆر دەبنەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"نەهامەتی بەسەرمدا وەرگەڕا،","poem":1},{"text":"هەروەکو با ڕێزی منی برد،","poem":2},{"lineBreak":true},{"text":"ئاسوودەییم وەک هەور تێپەڕی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«بە هێواشی ژیانم بەرە و کۆتایی دەچێت،","poem":1},{"text":"کەوتمە ڕۆژانی زەلیلییەوە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"شەوگار ئێسکەکانم لەناومدا کلۆر دەکات،","poem":1},{"text":"ئازارەکانم پشوو نادەن.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"خودا بە زۆری هێزەکەی منی بە جلەکانم گرت و شێوەی گۆڕیم،","poem":1},{"text":"وەک یەخەی کراسەکەم، منی پێچایەوە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"فڕێیدامە ناو قوڕەوە،","poem":1},{"text":"ڕەنگی خۆڵ و خۆڵەمێشم لێ نیشت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«ئەی خودا هاوارت بۆ دەهێنم و وەڵامم نادەیتەوە؛","poem":1},{"text":"ڕادەوەستم و ئاوڕم لێ نادەیتەوە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لەگەڵ مندا توند دەجوڵێیتەوە،","poem":1},{"text":"بە توانای دەستەکانت دژایەتیم دەکەیت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"دەمڕفێنیت و دەمدەیتە دەست ڕەشەبا؛","poem":1},{"text":"فڕێمدەدەیتە ناو زریانەوە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"دەزانم بۆ مردن دەمگەڕێنیتەوە،","poem":1},{"text":"بۆ ماڵی چاوەڕوانکراوی هەموو زیندووێک.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«بێگومان کەس دەستدرێژی ناکاتە سەر مرۆڤێکی تێکشکاو،","poem":1},{"text":"کاتێک لە تەنگانەیدا هاوار دەکات.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ئایا بۆ لێقەوماوان نەگریام؟","poem":1},{"text":"ئایا بۆ نەدار گیانم خەمبار نەبوو؟","poem":2}]},{"type":"verse","number":26,"content":[{"text":"لەگەڵ ئەوەشدا، کە ئاواتەخوازی چاکە بووم، خراپە هات؛","poem":1},{"text":"چاوەڕوانی ڕووناکی بووم، تاریکی هات.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"هەناوم گڕی گرتووە و ناوەستێت،","poem":1},{"text":"ڕۆژانی زەلیلی بەرەوپیرم دێن.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ڕەش هەڵگەڕام بەڵام بەبێ خۆر؛","poem":1},{"text":"لەناو کۆمەڵ هەستام هاوارم کرد.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"بووم بە برای چەقەڵەکان و","poem":1},{"text":"هاوڕێی کوندەپەپووەکان.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"پێستم ڕەش و هەڵوەری لەبەرم،","poem":1},{"text":"لەشم لەبەر تایەکی توند دەسووتێت.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"قیسارەکەم بۆ لاوانەوەیە و","poem":1},{"text":"شمشاڵەکەم بۆ دەنگی گریاوەکانە.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":18,"caller":"+","text":"دارێکی گەڵا وردی لق باریکە، لقەکانی بۆ گسک بەکاردێت.‏","reference":{"chapter":30,"verse":4}}]},"thisChapterLink":"/api/ckb_bib/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}