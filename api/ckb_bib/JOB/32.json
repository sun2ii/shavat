{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"heading","content":["ئەلیهو"]},{"type":"verse","number":1,"content":["ئیتر ئەو سێ پیاوە وازیان لە وەڵامدانەوەی ئەیوب هێنا، چونکە ئەو خۆی بە ڕاست دەزانی."]},{"type":"verse","number":2,"content":["بەڵام ئەلیهوی کوڕی بەرەخێلی بووزی لە هۆزی ڕام لە ئەیوب تووڕە بوو. تووڕەیی جۆشا، چونکە ئەیوب خۆی بە بێتاوان دادەنا و گلەیی لە خودا دەکرد."]},{"type":"verse","number":3,"content":["لە سێ هاوڕێکەشی تووڕە بوو، چونکە لەگەڵ ئەوەی نەیاندەتوانی بە هیچ شێوەیەک بەرپەرچی ئەیوب بدەنەوە، ئەیوبیان تاوانبار کرد."]},{"type":"verse","number":4,"content":["ئەلیهوش لەسەر ئەیوب ئارامی گرت، چونکە ئەوان لەو بە تەمەنتر بوون."]},{"type":"verse","number":5,"content":["کاتێک ئەلیهو بینی هیچ وەڵامێک لە دەمی ئەو سێ پیاوەدا نییە، تووڕە بوو."]},{"type":"verse","number":6,"content":["ئیتر ئەلیهوی کوڕی بەرەخێلی بووزی وەڵامی دایەوە:",{"text":"«من تەمەنم کەمە و","poem":1},{"text":"ئێوەش پیرن؛","poem":2},{"text":"لەبەر ئەوە نەوێرام و ترسام","poem":1},{"text":"بیروڕای خۆمتان پێ بڵێم.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"گوتم: ”با تەمەن قسە بکات و","poem":1},{"text":"با زۆری ساڵان دانایی ڕابگەیەنن.“","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بەڵام ڕۆحی مرۆڤ هەناسەی خودای هەرە بەتوانایە،","poem":1},{"text":"ئەوە کە تێگەیشتن بە مرۆڤ دەبەخشێت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"تەنها ئەوانەی تەمەن درێژن دانا نین و","poem":1},{"text":"تەنها پیران نین کە لە دادوەری تێدەگەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"«لەبەر ئەوە دەڵێم: گوێم لێ بگرن؛","poem":1},{"text":"منیش بیروڕای خۆم ڕادەگەیەنم.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەوەتا من ئارامم گرت لەسەر قسەکانتان،","poem":1},{"text":"گوێم شل کرد بۆ بەهانەکانتان؛","poem":2},{"text":"هەتا قسەکانتان تاقی کردەوە","poem":1}]},{"type":"verse","number":12,"content":[{"text":"لێتان وردبوومەوە.","poem":2},{"text":"بەڵام کەستان بەڵگەتان لە دژی بەهانەی ئەیوب نەهێنایەوە و","poem":1},{"text":"وەڵامی بەهانەکانی ئەوتان نەدایەوە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لەبەر ئەوە مەڵێن: ”داناییمان دۆزییەوە؛","poem":1},{"text":"با خودا بەرپەرچی ئەیوب بداتەوە، نەک مرۆڤ.“","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەیوب قسەکانی ئاراستەی من نەکردووە و","poem":1},{"text":"منیش بە قسەکانی ئێوە وەڵامی نادەمەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«واقیان وڕماوە و هیچ وەڵامیش نادەنەوە؛","poem":1},{"text":"قسەیان لێ داماڵرا.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئێستا کە بێدەنگن، ئایا دەبێت چاوەڕێ بکەم،","poem":1},{"text":"کە لەوێ ڕادەوەستن بەبێ وەڵام؟","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئێستا منیش بەشی خۆم وەڵام دەدەمەوە؛","poem":1},{"text":"منیش بیروڕای خۆم ڕادەگەیەنم،","poem":2}]},{"type":"verse","number":18,"content":[{"text":"چونکە پڕم لە قسەکردن و","poem":1},{"text":"ڕۆحی ناخم تەنگاوم دەکات؛","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەوەتا ناخم وەک شەرابێکە سەرەکەی نەکرابێتەوە،","poem":1},{"text":"وەک مەشکەیەکی نوێیە خەریکە بدڕێت.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"قسە دەکەم با ئاهێکم بەبەردا بێتەوە؛","poem":1},{"text":"لێوەکانم دەکەمەوە و وەڵام دەدەمەوە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لایەنگری کەس ناکەم و","poem":1},{"text":"مەرایی هیچ کەسێکیش ناکەم؛","poem":2}]},{"type":"verse","number":22,"content":[{"text":"چونکە زمانلووسی نازانم","poem":1},{"text":"جارێ دروستکەرەکەم نامبات.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}