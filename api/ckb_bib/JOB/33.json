{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"«بەڵام ئەی ئەیوب، ئێستا گوێ لە قسەکانم بگرە!","poem":1},{"text":"گوێ شل بکە بۆ هەموو وشەکانم.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەوەتا من دەمم کردەوە؛","poem":1},{"text":"قسەکانم لەسەر زمانی منن.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"قسەکانم لە دڵی پاکمەوەن؛","poem":1},{"text":"زمانیشم بە دڵسۆزییەوە ئەوە دەردەبڕێت کە دەیزانم.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ڕۆحی خودا دروستی کردم،","poem":1},{"text":"هەناسەی توانادارەکە ژیانی پێ بەخشیم.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەگەر دەتوانیت، وەڵامم بدەوە و","poem":1},{"text":"هەستە سەرپێ و کێشەکەت بخەرە بەردەمم.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لەبەرچاوی خودا منیش هەروەکو تۆم،","poem":1},{"text":"لە قوڕ دروستکراوم.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ناشێت شەوکەتم بتترسێنێت و","poem":1},{"text":"زۆرکردنم لێت بارت گران بکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«تۆ لەبەردەمم گوتت،","poem":1},{"text":"من بە وردی گوێم لێت بوو،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"گوتت: ”من بێتاوانم بەبێ یاخیبوون،","poem":1},{"text":"بێگەردم و تاوانم نییە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لەگەڵ ئەوەشدا خودا دەگەڕێت هەڵەم لێ بدۆزێتەوە و","poem":1},{"text":"بە دوژمنی خۆی دامدەنێت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"پێیەکانمی لەناو کۆت داناوە؛","poem":1},{"text":"چاودێری هەموو ڕێگاکانم دەکات.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«بەڵام پێتان دەڵێم، لەمەدا ڕاست ناکەیت،","poem":1},{"text":"چونکە خودا لە مرۆڤ مەزنترە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بۆچی سکاڵای لێ دەکەیت:","poem":1},{"text":"”وەڵامی هیچ کام لە وشەکانی مرۆڤ ناداتەوە؟“","poem":2}]},{"type":"verse","number":14,"content":[{"text":"بە ڕاستی خودا هەرجارەو بە ڕێگایەک دەدوێت،","poem":1},{"text":"کەس ڕامانی ئەوە ناکات.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"لە خەون، لە بینینی شەودا،","poem":1},{"text":"کاتێک هەموو خەڵک خەوی قورسیان لێدەکەوێت","poem":2},{"lineBreak":true},{"text":"لە کاتی خەواڵووبوون لەناو جێگا،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئەو کاتە گوێی خەڵک دەکاتەوە و","poem":1},{"text":"بە ئاگادارکردنەوەکانی دەیانتۆقێنێت،","poem":2}]},{"type":"verse","number":17,"content":[{"text":"تاکو لە خراپەکردن بیانگەڕێنێتەوە و","poem":1},{"text":"لە لووتبەرزیش بیانپارێزێت،","poem":2}]},{"type":"verse","number":18,"content":[{"text":"هەتا لە کەوتنە ناو گۆڕ ڕزگاریان بکات،","poem":1},{"text":"ژیانیشیان لە لەناوچوون بە شمشێر.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«یان ئەگەر کەسێکی هەبێت لەناو جێگاکەی بە ئازار تەمبێ بکرێت و","poem":1},{"text":"ململانێی ئێسکەکانیشی بەردەوامە،","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئەو کاتە گیانی ڕقی لە نان دەبێتەوە و","poem":1},{"text":"نەوسیشی لە خواردنی خۆش.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"گۆشتیان وا دەفەوتێت کە ئیتر نەبینرێت،","poem":1},{"text":"ئێسکەکانیشیان کە شاردرابوونەوە ئێستا دیارن.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"گیانیان لە گۆڕ نزیک دەبنەوە،","poem":1},{"text":"ژیانیشیان لە فریشتەی مەرگ.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"لەگەڵ ئەوەشدا ئەگەر لەلایان نێردراوێک هەبێت،","poem":1},{"text":"پەیوەندی ڕێکخەرێک، یەک لە هەزار","poem":2},{"lineBreak":true},{"text":"تاکو ڕاستودروستی بە مرۆڤ بناسێنێت،","poem":2}]},{"type":"verse","number":24,"content":[{"text":"لەگەڵ ئەو کەسە میهرەبان دەبێت و بە خودا دەڵێت:","poem":1},{"text":"”بیانگەڕێنەوە با نەکەونە گۆڕ؛","poem":2},{"lineBreak":true},{"text":"کڕینەوەی ژیانی ئەوانم بۆ دۆزینەوە.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"با گۆشتیان لە گۆشتی منداڵ ناسکتر بێت؛","poem":1},{"text":"با ڕۆژانی گەنجیێتییان بگەڕێتەوە.“","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ئەو کاتە ئەوانە داوا لە خودا دەکەن و لێیان ڕازی دەبێت،","poem":1},{"text":"بە هاواری خۆشییەوە ڕووی خودا دەبینن،","poem":2},{"lineBreak":true},{"text":"ئەویش پاداشتی ڕاستودروستی مرۆڤ دەداتەوە.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"دەچن بۆ لای کەسانی دیکە و دەڵێن:","poem":1},{"text":"”گوناهم کرد و ڕاستیم خواروخێچ کرد،","poem":2},{"lineBreak":true},{"text":"بەڵام سزا نەدرام لەسەری.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"خودا منی کڕییەوە لە جیهانی مردووان،","poem":1},{"text":"ئیتر ژیانم ڕووناکی دەبینێت.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«خودا هەموو ئەمانە دەکات،","poem":1},{"text":"دوو جار و سێ جار لەگەڵ مرۆڤ،","poem":2}]},{"type":"verse","number":30,"content":[{"text":"بۆ ئەوەی بیانگەڕێنێتەوە لە کەوتنی ناو گۆڕ و","poem":1},{"text":"تاوەکو بە ڕووناکی زیندووان ڕووناک بێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«جا گوێ شل بکە و گوێم لێ بگرە ئەیوب!","poem":1},{"text":"بێدەنگ بە من قسە دەکەم.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ئەگەر قسەت لەلایە وەڵامم بدەوە،","poem":1},{"text":"قسە بکە! چونکە دەمەوێت ئەستۆپاکت بکەم.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ئەگەر نا، تۆ گوێم لێ بگرە؛","poem":1},{"text":"بێدەنگ بە فێری داناییت دەکەم.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}