ineBreak":true},{"text":"چونکە هەمووان کاری دەستی ئەون؟","poem":2}]},{"type":"verse","number":20,"content":[{"text":"لەناکاو دەمرن، لە نیوەشەودا؛","poem":1},{"text":"گەل دەهەژێن و بەسەردەچن؛","poem":2},{"lineBreak":true},{"text":"بەهێزەکان دادەماڵرێن، بەڵام نەک بە دەستی مرۆڤ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«چاوەکانی لەسەر ڕێگاکانی مرۆڤە؛","poem":1},{"text":"ئەو هەموو هەنگاوەکانی دەبینێت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"نە تاریکی هەیە و نە سێبەری مەرگ،","poem":1},{"text":"کە بەدکاران بتوانن خۆیانی تێدا بشارنەوە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"پێویست ناکات خودا زیاتر لێکۆڵینەوە لەگەڵ مرۆڤ بکات،","poem":1},{"text":"هەتا بێتە بەردەمی بۆ دادگاییکردن.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"دلێران بەبێ پشکنین تێکدەشکێنێت و","poem":1},{"text":"خەڵکی دیکە لە جێیان دادەنێت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"لەبەر ئەوەی تێبینی کردەوەکانیان دەکات،","poem":1},{"text":"بە شەو سەرەوژێریان دەکات و وردوخاش دەبن.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"لەبەر ئەوەی خراپەکارن","poem":1},{"text":"لەبەرچاوی بینەران سزایان دەدات،","poem":2}]},{"type":"verse","number":27,"content":[{"text":"چونکە لەدوای ئەو لایاندا و","poem":1},{"text":"لە هیچ یەکێک لە ڕێگاکانی ئەو وردنەبوونەوە،","poem":2}]},{"type":"verse","number":28,"content":[{"text":"بەم جۆرەیان کرد هاواری هەژار پێی بگات،","poem":1},{"text":"بەم شێوەیە گوێی لە قیژەی زەلیلان بوو.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"بەڵام ئەگەر بێدەنگ بێت،","poem":1},{"text":"کێ هەیە تاوانباری بکات؟","poem":2},{"lineBreak":true},{"text":"ئەگەر ڕووی خۆی بشارێتەوە، کێ دەیبینێت؟","poem":2},{"text":"لەگەڵ ئەوەشدا فەرمانڕەوایەتی نەتەوە و تاکە کەسیش دەکات","poem":1}]},{"type":"verse","number":30,"content":[{"text":"بۆ ئەوەی خوانەناس پاشایەتی نەکات و","poem":2},{"lineBreak":true},{"text":"نەبێت بە تەڵە بۆ گەل.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«ئەگەر بە خودا بگوترێت:","poem":1},{"text":"”من تاوانبارم بەڵام ئیتر گەندەڵی ناکەم،","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ئەوەی نەمبینیوە تۆ پیشانی منی بدە،","poem":1},{"text":"ئەگەر خراپەم کردووە، چیتر نایکەمەوە؟“","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ئایا دەبێت خودا بەگوێرەی ئەوەی تۆ پێت باشە پاداشتت","poem":1},{"noteId":21},{"text":"بداتەوە،","poem":1},{"text":"لە کاتێکدا کە تۆ ئامادە نیت تۆبە بکەیت؟","poem":2},{"text":"تۆ هەڵدەبژێریت نەک من،","poem":1},{"text":"ئەوەی دەیزانیت دەیڵێیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«تێگەیشتووان پێم دەڵێن،","poem":1},{"text":"ئەو پیاوە دانایانەی گوێیان لێمە دەڵێن:","poem":2}]},{"type":"verse","number":35,"content":[{"text":"”ئەیوب بەبێ زانین قسە دەکات و","poem":1},{"text":"قسەکانی بەبێ وریاین.“","poem":2}]},{"type":"verse","number":36,"content":[{"text":"خۆزگە ئەیوب هەتاسەر تاقی دەکرایەوە","poem":1},{"text":"لەبەر وەڵامەکانی وەک بەدکاران!","poem":2}]},{"type":"verse","number":37,"content":[{"text":"یاخیبوونی بۆ سەر گوناهەکەی زیاد کرد؛","poem":1},{"text":"بە گاڵتەپێکردنەوە چەپڵە لێدەدات و","poem":2},{"lineBreak":true},{"text":"زیادەڕۆیی لەسەر خودا دەکات.»","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"ئەم وشەیە لە زمانی عیبری بە هەردوو واتای پاداشت و سزا دێت.‏","reference":{"chapter":34,"verse":33}}]},"thisChapterLink":"/api/ckb_bib/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}