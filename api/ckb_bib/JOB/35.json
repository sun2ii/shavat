{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["ئەلیهوش بەردەوام بوو و گوتی:"]},{"type":"verse","number":2,"content":[{"text":"«ئایا ئەمە بە ڕاست دادەنێیت؟","poem":1},{"text":"گوتت: ”ڕاستییەکەی لای منە، نەک لای خودا.“","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لەگەڵ ئەوەشدا لێی دەپرسیت: ”چ سوودێکی بۆم هەیە،","poem":1},{"text":"قازانجی چیم کرد لە نەکردنی گوناه؟“","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«من حەز دەکەم وەڵامی تۆ بدەمەوە،","poem":1},{"text":"وەڵامی تۆ و هاوڕێیەکانیشت دەدەمەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"تەماشای ئاسمان بکە و ببینە،","poem":1},{"text":"تێبینی هەورەکان بکە لە تۆ بەرزترن.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەگەر گوناهە بکەیت چیت لێکردووە و","poem":1},{"text":"ئەگەر یاخیبوونەکانت زۆر بکەیت چیت پێکردووە؟","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئەگەر ڕاستودروست بیت چیت پێیداوە،","poem":1},{"text":"یان چی لە دەستت وەردەگرێت؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"خراپەکەت بۆ مرۆڤێک دەبێت کە وەک خۆتە و","poem":1},{"text":"ڕاستودروستیشت بۆ ئادەمیزادە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«خەڵک لەتاوی زۆرداری هاوار دەکەن،","poem":1},{"text":"لەبەر ستەمکاران هاواری فریاکەوتن دەکەن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ناڵێن: ”کوا خودای بەدیهێنەرم،","poem":1},{"text":"ئەوەی لە شەودا زەبوور دەدات،","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەوەی فێرمان دەکات زیاتر لە ئاژەڵەکانی زەوی و","poem":1},{"text":"لە باڵندەکانی ئاسمان داناترمان دەکات؟“","poem":2}]},{"type":"verse","number":12,"content":[{"text":"کاتێک خەڵک لە دەست لووتبەرزی خراپەکاران هاوار دەکەن،","poem":1},{"text":"وەڵام ناداتەوە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"خودا گوێ لە داواکاری پووچیان ناگرێت،","poem":1},{"text":"توانادارەکە تەماشای ناکات.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئیتر چۆن گوێ لە تۆ بگرێت","poem":1},{"text":"ئەگەر بڵێیت کە نایبینیت،","poem":2},{"text":"داواکارییەکەت لەبەردەمیەتی و","poem":1},{"text":"دەبێت چاوەڕێی ئەو بکەیت،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"هەروەها تووڕەییەکەی هەرگیز سزا نادات و","poem":1},{"text":"گوێ نادات بە زۆری خراپەکاری.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بەم جۆرە ئەیوب لە هیچ دەمی کردووەتەوە و","poem":1},{"text":"بەبێ زانین قسەی زل دەکات.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}