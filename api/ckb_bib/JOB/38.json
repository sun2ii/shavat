r":7,"content":[{"text":"کاتێک ئەستێرەکانی بەرەبەیان پێکەوە هاواری خۆشییان دەکرد و","poem":1},{"text":"هەموو فریشتەکان","poem":2},{"noteId":22},{"text":"هوتافیان دەکێشا؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«کێ بە دەروازەکان دەریای بەندکرد،","poem":1},{"text":"کاتێک بە پاڵەپەستۆ لە منداڵدان هاتە دەرەوە،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"کە هەورم کردە بەرگی و","poem":1},{"text":"هەوری تاریکم کرد بە قۆنداغی،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"کە فەرزی خۆم بەسەریدا سەپاند و","poem":1},{"text":"دەروازە و شمشیرەم","poem":2},{"noteId":23},{"text":"بۆ دانا،","poem":2}]},{"type":"verse","number":11,"content":[{"text":"فەرمووم: ”هەتا ئێرە دێیت و تێناپەڕیت؛","poem":1},{"text":"لێرە شەپۆلەکانی لووتبەرزیت دەشکێن“؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«ئایا لە هیچ ڕۆژێک لە ڕۆژانی ژیانتدا فەرمانت بە بەرەبەیان کردووە،","poem":1},{"text":"هەتا زەردەی خۆر هەڵنەیێت،","poem":2}]},{"type":"verse","number":13,"content":[{"text":"هەتا ڕۆخەکانی زەوی بگرێت و","poem":1},{"text":"بەدکارانی لێ بتەکێنێت؟","poem":2}]},{"type":"verse","number":14,"content":[{"text":"وەکو مۆرێک کە لە قوڕی دەدەیت،","poem":1},{"text":"دەوەستێت هەروەکو بەرگی پۆشیبێت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ڕووناکی لە بەدکاران قەدەغە دەکرێت و","poem":1},{"text":"دەستی بەرزکراوەیان دەشکێنرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«ئایا گەیشتیتە سەرچاوەکانی دەریا و","poem":1},{"text":"بەناو کون و کەلەبەرەکانی قووڵاییدا هاتوچۆت کرد؟","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئایا دەروازەکانی مردنت بۆ ئاشکرا بوون","poem":1},{"text":"یان دەروازەکانی سێبەری مەرگت بینی؟","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئایا پانوبەرینی زەوی دەزانیت؟","poem":1},{"text":"ئەگەر هەموو ئەم شتانە دەزانیت، پێم بڵێ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«کام ڕێگایە دەچێتە نشینگەی ڕووناکی؟","poem":1},{"text":"ئەی شوێنی نیشتەجێبوونی تاریکی لەکوێیە؟","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئایا دەتوانیت هەریەکەیان بۆ سنووری خۆی ببەیت و","poem":1},{"text":"ڕێگای ماڵەکانیان شارەزابیت؟","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لەبەر ئەوەی تۆ لەپێش ئەمانەوە لەدایک ببوویت!","poem":1},{"text":"بە دڵنیاییەوە تۆ زۆر تەمەن درێژیت!","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«ئایا چووی بۆ ناو ئەمبارەکانی بەفر","poem":1},{"text":"یان کۆگاکانی تەرزەت بینیوە،","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ئەوەی هەڵمگرتووە بۆ کاتی تەنگانە،","poem":1},{"text":"بۆ ڕۆژانی نەهامەتی و جەنگ؟","poem":2}]},{"type":"verse","number":24,"content":[{"text":"لە چ ڕێگایەکەوە بروسکە دابەش دەبێت و","poem":1},{"text":"بای ڕۆژهەڵات لەسەر زەوی بڵاو دەبێتەوە؟","poem":2}]},{"type":"verse","number":25,"content":[{"text":"کێ لێکی جیا کردەوە جۆگەکان بۆ بارانی بە لێشاو و","poem":1},{"text":"ڕێچکە بۆ باوبۆران؟","poem":2}]},{"type":"verse","number":26,"content":[{"text":"بۆ ئاودانی خاکێک کە مرۆڤی تێدا نییە،","poem":1},{"text":"بەسەر چۆڵەوانییەک کە ئادەمیزادی تێدا نییە،","poem":2}]},{"type":"verse","number":27,"content":[{"text":"بۆ ئەوەی خاکی کاول و وێران تێر بکات،","poem":1},{"text":"وا بکات گیای لێ بڕووێت.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ئایا باران باوکی هەیە؟","poem":1},{"text":"ئەی کێ دڵۆپەکانی شەونم دەخاتەوە؟","poem":2}]},{"type":"verse","number":29,"content":[{"text":"بەستەڵەک لە سکی کێ دێتە دەرەوە؟","poem":1},{"text":"شەختەی ئاسمان بۆ کێ لەدایک دەبێت،","poem":2}]},{"type":"verse","number":30,"content":[{"text":"کاتێک ئاوەکان وەک بەردیان لێ دێت و","poem":1},{"text":"ڕووی قووڵاییەکان دەیبەستێت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"«ئایا تۆ دەتوانیت گرێیەکانی حەوتەوانە","poem":1},{"noteId":24},{"text":"ببەستیت","poem":1},{"text":"یان گرێ بەستراوەکانی ڕاوچی بکەیتەوە؟","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ئایا تۆ دەتوانیت کەلووەکان","poem":1},{"noteId":25},{"text":"لە کاتی خۆی دەربخەیت،","poem":1},{"text":"یان ڕێنمایی کەلووی ورچ بکەیت لەگەڵ بەچکەکانی؟","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ئایا یاساکانی ئاسمان دەزانیت،","poem":1},{"text":"یاخود تۆ بڕیاری دەسەڵاتی ئەو بەسەر زەویدا دەچەسپێنیت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"«ئایا دەتوانیت دەنگت بۆ هەورەکان بەرز بکەیتەوە","poem":1},{"text":"هەتا بە لێشاوی ئاو داتبپۆشێت؟","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ئایا توانای ئەوەت هەیە بروسکەکان بنێریت،","poem":1},{"text":"جا بڕۆن و بڵێن: ”ئەوەتاین ئێمە“؟","poem":2}]},{"type":"verse","number":36,"content":[{"text":"کێ دانایی دەبەخشێت","poem":1},{"text":"یان تێگەیشتن بە مێشک دەدات؟","poem":2}]},{"type":"verse","number":37,"content":[{"text":"کێ بە داناییەوە هەورەکان دەژمێرێت","poem":1},{"text":"یان مەشکەکانی ئاسمان دەڕژێنێت،","poem":2}]},{"type":"verse","number":38,"content":[{"text":"کاتێک تێکەڵ بە خۆڵ دەبێت","poem":1},{"text":"یەکدەگرن و دەبنە قوڕ؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"«ئایا تۆ نێچیر بۆ شێرە مێ ڕاو دەکەیت","poem":1},{"text":"یان هەڵپەی بەچکە شێرەکان ئارام دەکەیتەوە،","poem":2}]},{"type":"verse","number":40,"content":[{"text":"کاتێک لەناو بێشەکەیان خۆیان دەکێشنەوە و","poem":1},{"text":"خۆیان مەڵاس دەدەن بۆ بۆسە؟","poem":2}]},{"type":"verse","number":41,"content":[{"text":"کێ ڕاو بۆ قەلەڕەش ئامادە دەکات","poem":1},{"text":"کە بەچکەکانی دەقیڕێنن بۆ خودا و","poem":2},{"lineBreak":true},{"text":"لەبەر نەبوونی خواردن پەرتەوازە بوون؟","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":22,"caller":"+","text":"عیبری: کوڕانی خودا. بڕوانە پەیدابوون 6‏:2‏‏.‏","reference":{"chapter":38,"verse":7}},{"noteId":23,"caller":"+","text":"شمشیر، پارچە دارێک بووە لە جیاتی قوفڵ لە دواوەی دەرگا بە شێوەی ئاسۆیی دانراوە بۆ داخستنی دەرگا.‏","reference":{"chapter":38,"verse":10}},{"noteId":24,"caller":"+