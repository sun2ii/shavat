{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"«ئایا دەزانیت کەی بزنە کێوییەکان دەزێن؟","poem":1},{"text":"یان تێبینیت کردووە ئەو کاتەی کە ئاسک ژان دەیگرێت؟","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئایا مانگەکانی ئاوسبوونی دەژمێریت","poem":1},{"text":"یان کاتی زاوزێکردنیان دەزانیت؟","poem":2}]},{"type":"verse","number":3,"content":[{"text":"چۆک دادەدەن و پاڵ بە ئازارەکانیانەوە دەنێن و","poem":1},{"text":"بەچکەکانیان دەبێت.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بەچکەکانیان لە چۆڵەوانی بەهێز و گەورە دەبن؛","poem":1},{"text":"دەڕۆن و ئیتر ناگەڕێنەوە لایان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«کێ کەرەکێوی بەڕەڵا کرد و","poem":1},{"text":"مێخ زنجیری ئەو کێوییەی کردەوە؟","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەوەی چۆڵەوانیم کرد بە ماڵی و","poem":1},{"text":"خوێڵێنم","poem":2},{"noteId":26},{"text":"کردە ژینگەی.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بە دەنگەدەنگی شار پێدەکەنێت،","poem":1},{"text":"گوێی لە هاواری لێخوڕ نابێت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"لە چیاکاندا بەدوای لەوەڕگادا دەگەڕێت،","poem":1},{"text":"بۆ دۆزینەوەی هەموو سەوزاییەک.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«ئایا گای کێوی ڕازی دەبێت خزمەتت بکات","poem":1},{"text":"یان بە شەو لەلای ئاخوڕەکەت بمێنێتەوە؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئایا دەتوانیت گای کێوی بە گاسنەوە ببەستیتەوە و جووتی پێ بکەیت؟","poem":1},{"text":"ئایا بەدواتدا دێت دۆڵەکان خەرتە بکات؟","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئایا پشتی پێ دەبەستیت، چونکە هێزەکەی مەزنە","poem":1},{"text":"یان کارەکەی خۆتی بۆ بەجێدەهێڵیت؟","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئایا متمانەی پێ دەکەیت کە دەغڵودانەکەت بهێنێت و","poem":1},{"text":"بۆ سەر جۆخینەکەت","poem":2},{"noteId":27},{"text":"کۆی بکاتەوە؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«بە خۆشییەوە وشترمرغ باڵەفڕکێ دەکات،","poem":1},{"text":"ئایا پەڕوباڵەکەی وەک لەقلەق پیرۆزە؟","poem":2}]},{"type":"verse","number":14,"content":[{"text":"وشترمرغ هێلکەکەی لەسەر زەوی بەجێدەهێڵێت و","poem":1},{"text":"خۆڵ گەرمیان دادەهێنێت،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"لەبیری دەچێت کە پێ وردوخاشی دەکات و","poem":1},{"text":"ئاژەڵی کێوی پێی پێدا دەنێن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"لەگەڵ بەچکەکانی دڵڕەقە وەک ئەوەی بەچکەی ئەو نەبن؛","poem":1},{"text":"گوێی ناداتێ کە ماندووبوونەکەی بێهوودە دەڕوات،","poem":2}]},{"type":"verse","number":17,"content":[{"text":"چونکە خودا دانایی لەبیر بردووەتەوە،","poem":1},{"text":"لە تێگەیشتن بەشی نەداوە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"کاتێک پەڕەکانی فش دەکاتەوە بۆ ڕاکردن،","poem":1},{"text":"بە ئەسپ و بە سوارەکەی پێدەکەنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«ئایا تۆ هێز بە ئەسپ دەدەیت","poem":1},{"text":"یان ملی بە یاڵ","poem":2},{"noteId":28},{"text":"دادەپۆشیت؟","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئایا وای لێ دەکەیت کە وەک کوللە قەڵەمباز بدات و","poem":1},{"text":"دەنگی حیلەکەی تۆقێنەر بێت؟","poem":2}]},{"type":"verse","number":21,"content":[{"text":"بە توندی سم بە زەویدا بکوتێت، بە هێزەوە دەربپەڕێت،","poem":1},{"text":"بەرەو مەیدانی جەنگ مل بنێت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بە ترس پێبکەنێت و نەتۆقێت؛","poem":1},{"text":"لە ڕووی شمشێر نەگەڕێتەوە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"تیردان شەقەشەقی بێت و","poem":1},{"text":"خەنجەر و نووکی ڕم ببریسکێنەوە.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"بەوپەڕی جۆشوخرۆشەوە غار دەدات،","poem":1},{"text":"هەتا کاتی لێدانی کەڕەنا خۆی پێ ڕاناگیرێت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"لە کاتی فووکردن بە کەڕەنادا دەڵێت: ”ئەها!“","poem":1},{"text":"لە دوورەوە بۆنی شەڕ دەکات،","poem":2},{"lineBreak":true},{"text":"هاواری سەرکردەکان و نەعرەتەی جەنگ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«ئایا لە تێگەیشتنی تۆدایە هەڵۆ بفڕێت و","poem":1},{"text":"ڕووەو باشوور باڵەکانی بکاتەوە؟","poem":2}]},{"type":"verse","number":27,"content":[{"text":"یان بە فەرمانی تۆیە هەڵۆ بەرز بفڕێت و","poem":1},{"text":"هێلانەکەی لە بەرزی دابنێت؟","poem":2}]},{"type":"verse","number":28,"content":[{"text":"لەسەر لووتکەی چیا نیشتەجێ دەبێت و بە شەو دەمێنێتەوە،","poem":1},{"text":"هەڵدێری بەردەڵان قەڵاکەیەتی.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"لەوێوە نێچیری خۆی دەدۆزێتەوە و","poem":1},{"text":"چاوەکانی لە دوورەوە دەبینن.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"بەچکەکانی خوێن هەڵدەمژن،","poem":1},{"text":"لە هەرکوێ کوژراوی لێ بێت، ئەو لەوێیە.»","poem":2}]}],"footnotes":[{"noteId":26,"caller":"+","text":"خاکێک کە خوێی زۆر بێت، سەرچاوەی بەدەستهێنانی خوێ بێت.‏","reference":{"chapter":39,"verse":6}},{"noteId":27,"caller":"+","text":"جۆخین یان سەرخەرمان ئەو زەوییە تەرخانکراوەیە کە لەلایەن وەرزێر و جوتیارەوە بەکارهێنراوە بۆ کوتانی دانەوێڵە لەسەری لەدوای کۆکردنەوەی لە کێڵگە.‏","reference":{"chapter":39,"verse":12}},{"noteId":28,"caller":"+","text":"مووی درێژ لەسەر ملی ئەسپ.‏","reference":{"chapter":39,"verse":19}}]},"thisChapterLink":"/api/ckb_bib/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}