{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["وەڵامی یەکەمی ئەلیفاز"]},{"type":"verse","number":1,"content":["ئینجا ئەلیفازی تێمانی وەڵامی دایەوە:"]},{"type":"verse","number":2,"content":[{"text":"«ئەگەر یەکێک قسەیەک بکات دڵگران دەبیت؟","poem":1},{"text":"بەڵام کێ دەتوانێت لە قسەکردن ڕابوەستێت؟","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لە یادت بێ تۆ ڕێنمایی زۆر کەست کردووە و","poem":1},{"text":"دەستە شلبووەکانت توند کردووە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"قسەکانت ئەوانەی هەستاندەوە کە کەوتوون و","poem":1},{"text":"ئەژنۆ لەرزۆکەکانت چەسپاند.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بەڵام ئێستا کە خۆت تووشی تەنگانە بوویت، ورەت بەرداوە،","poem":1},{"text":"لەوەی کە بەسەر خۆت هاتووە، پەرێشان بوویت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئایا پشت بە لەخواترسییەکەت نابەستیت؟","poem":1},{"text":"ئایا بێ کەموکوڕییەکەت هیوابەخش نییە؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«بەبیر خۆتی بهێنەرەوە، بێتاوانێکت بینیوە فەوتابێت،","poem":1},{"text":"یاخود کەسە سەرڕاستەکان لەناوچووبن؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"وەک بینیوتە، ئەوانەی خراپە دەکێڵن و","poem":1},{"text":"چەرمەسەری دەچێنن، خۆیان دروێنەی دەکەن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بە هەناسەی خودا لەناودەچن و","poem":1},{"text":"بە بای تووڕەییەکەی نامێنن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"مڕەمڕی شێر و دەنگی نەڕەی و","poem":1},{"text":"کەڵبەی شێرەکان شکێنران.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"شێر دەفەوتێت لەبەر نەبوونی نێچیر و","poem":1},{"text":"بەچکەی شێرەکە پەرتەوازە دەبن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«وشەیەک بۆ لای من دزەی کرد،","poem":1},{"text":"گوێم چرپەیەکی بیست.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لە مۆتەکەی","poem":1},{"noteId":1},{"text":"شەومدا","poem":1},{"text":"کاتێک مرۆڤ خەوێکی قووڵ دەیباتەوە،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ترس و تۆقینێک منی داگرت و","poem":1},{"text":"هەموو ئێسکەکانم لەرزین.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ڕۆحێک بە بەردەممدا تێپەڕی و","poem":1},{"text":"مووەکانی لەشم مووچڕکەیان پێدا هات.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ڕاوەستا،","poem":1},{"text":"بەڵام نەمزانی چی بوو،","poem":2},{"text":"شێوەیەک لەبەرچاوم بوو،","poem":1},{"text":"چرپەیەک و دەنگێکم بیست:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"”ئایا مرۆڤ لە خودا ڕاستودروستترە،","poem":1},{"text":"یان پیاو لە بەدیهێنەرەکەی بێگەردتر دەبێت؟","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئەگەر خودا متمانە بە خزمەتکارەکانی نەکات و","poem":1},{"text":"گومڕایی بخاتە پاڵ فریشتەکانی،","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەی چەند زیاتر متمانە بە دانیشتووانی ناو خانووی قوڕ ناکات،","poem":1},{"text":"ئەوانەی بنەچەیان لە خۆڵەوەیە و","poem":2},{"lineBreak":true},{"text":"وەک مۆرانە پان دەکرێنەوە.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"لەنێوان بەیانی و ئێوارەدا تێکدەشکێنرێن،","poem":1},{"text":"بێ ئەوەی کەس ئاگای لێیان بێت بۆ هەتاهەتایە لەناودەچن.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئایا گوریسی ڕەشماڵەکانیان هەڵنەکێشراوە،","poem":1},{"text":"تاکو بەبێ دانایی بمرن؟“","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":1,"caller":"+","text":"خەونێکی ناخۆش.‏","reference":{"chapter":4,"verse":13}}]},"thisChapterLink":"/api/ckb_bib/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}