{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["یەزدان بە ئەیوبی فەرموو:"]},{"type":"verse","number":2,"content":[{"text":"«ئایا ئەوەی ڕکابەری لەگەڵ توانادارەکە دەکات مافی ئەوەی هەیە سەرزەنشتی بکات؟","poem":1},{"text":"ئەوەی خودا تاوانبار دەکات با وەڵام بداتەوە!»","poem":2}]},{"type":"verse","number":3,"content":["ئەیوبیش وەڵامی یەزدانی دایەوە:"]},{"type":"verse","number":4,"content":[{"text":"«من وا سووکوچروکم، چۆن وەڵامت بدەمەوە؟","poem":1},{"text":"من دەست دەخەمە سەر دەمی خۆم.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"جارێک قسەم کرد و بێ وەڵام بووم،","poem":1},{"text":"دوو جار و ئیتر دووبارەی ناکەمەوە.»","poem":2}]},{"type":"verse","number":6,"content":["یەزدانیش لە گەردەلوولەکەوە وەڵامی ئەیوبی دایەوە و فەرمووی:"]},{"type":"verse","number":7,"content":[{"text":"«ئێستا وەک پیاو پشتێنەکەی خۆت توند بکە؛","poem":1},{"text":"من پرسیارت لێ دەکەم و","poem":2},{"lineBreak":true},{"text":"تۆش وەڵامم بدەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ئایا دادپەروەریم دەخەیتە گومانەوە،","poem":1},{"text":"تاوانبارم دەکەیت بۆ ئەوەی خۆت بە ڕاستودروست دەربخەیت؟","poem":2}]},{"type":"verse","number":9,"content":[{"text":"یان بازووێکت وەک خودا هەیە و","poem":1},{"text":"بە دەنگێکی وەک دەنگی ئەو دەگرمێنیت؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئێستا بە پایەبەرزی و سەرفرازی خۆت بڕازێنەوە،","poem":1},{"text":"ڕێز و شکۆمەندی بپۆشە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لافاوی تووڕەییەکەت بڕێژە و","poem":1},{"text":"تەماشای هەموو لووتبەرزێک بکە و نزمی بکەرەوە،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"سەیری هەموو خۆبەزلزانێک بکە و زەلیلی بکە،","poem":1},{"text":"لە جێی خۆیان پێ بە خراپەکاراندا بنێ.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"تێکڕا لەناو خۆڵ نوقومیان بکە،","poem":1},{"text":"لە تاریکیدا ڕوویان بەند بکە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"منیش دان بەوەدا دەنێم،","poem":1},{"text":"کە دەستی ڕاستی خۆت دەتوانێت ڕزگارت بکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«سەیری بەهێمۆت","poem":1},{"noteId":29},{"text":"بکە،","poem":1},{"text":"کە لەگەڵ تۆ دروستم کرد","poem":2},{"lineBreak":true},{"text":"وەک مانگا گیا دەخوات.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئەوەتا هێزەکەی لە کەمەریەتی و","poem":1},{"text":"تواناکەی لە ماسوولکەکانی سکیەتی.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"کلکی وەک داری ئورز شۆڕ دەکاتەوە؛","poem":1},{"text":"ماسوولکەکانی ڕانی یەکیان تەنیوە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئێسکەکانی لوولەی بڕۆنزن،","poem":1},{"text":"چوارپەلی وەکو لوولەی ئاسنن.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەو سەرەتای کارەکانی خودایە،","poem":1},{"text":"بەڵام دروستکەرەکەی دەتوانێت بە شمشێر لێی نزیک بێتەوە.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"چیاکان سەوزایی بۆ دەردەخەن و","poem":1},{"text":"هەموو ئاژەڵی کێوی لەتەنیشتی یاری دەکەن.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لەژێر درەختەکانی لۆتس","poem":1},{"noteId":30},{"text":"ڕادەکشێت،","poem":1},{"text":"خۆی دەشارێتەوە لەنێو قامیشی زۆنگەکاندا.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"درەختەکانی لۆتس بە سێبەرەکانیان دایدەپۆشن؛","poem":1},{"text":"شۆڕەبی کەنار جۆگەکان دەوری دەدەن.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ئەگەر ئاوی ڕووبار هەستێت یان ڕووباری ئوردونیش تەووژم بۆ دەمی بهێنێت،","poem":1},{"text":"ئەو دڵنیایە و ترسی لێ نانیشێت.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ئایا کەس دەتوانێت ڕوو بە ڕوو ڕاوی بکات،","poem":1},{"text":"یان بە تەڵە بیگرێت و لووتی کون بکات؟","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":29,"caller":"+","text":"گیانلەبەرێکی زۆر گەورە بووە.‏","reference":{"chapter":40,"verse":15}},{"noteId":30,"caller":"+","text":"درەختێکی دڕکاوییە لە ڕۆژهەڵاتی دەریا ناوەڕاست و باکووری ئەفریقیا هەیە، لە ناوچەی گەرم شێدار دەڕوێت و بە پڕی لە دەوروبەری دەریاچەی جەلیل هەیە.‏","reference":{"chapter":40,"verse":21}}]},"thisChapterLink":"/api/ckb_bib/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}