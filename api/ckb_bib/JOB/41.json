tent":[{"text":"ئایا پێستی پڕ دەکەیت لە ڕم و","poem":1},{"text":"سەریشی پڕ لە تیر؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"دەستت لەسەری دابنێ و بیر لە جەنگ بکەرەوە،","poem":1},{"text":"جارێکی دیکە دووبارەی ناکەیتەوە!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"هیواخواستن بۆ گرتنی پووچە،","poem":1},{"text":"هەر بە بینینی دەتۆقێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"کەسێک نییە ئەوەندە ئازا بێت بەخەبەری بهێنێت،","poem":1},{"text":"ئیتر کێ هەیە لە ڕووی مندا بوەستێت؟","poem":2}]},{"type":"verse","number":11,"content":[{"text":"کێ شتێکی پێم بەخشیوە تاکو من بیدەمەوە؟","poem":1},{"text":"ئەوەی لەژێر هەموو ئاسمانە هی منە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«بێدەنگ نابم لە باسکردنی ئەندامەکانی جەستەی لیڤیاتان و","poem":1},{"text":"لە ڕاگەیاندنی هێزی و لە جوانی ئاکاری جەستەی.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"کێ دەتوانێت پێستەکەی دابماڵێت؟","poem":1},{"text":"کێ دەتوانێت هەردوو لای زرێیەکەی ببڕێت؟","poem":2}]},{"type":"verse","number":14,"content":[{"text":"کێ دوو شەویلاکی دەمی دەکاتەوە؟","poem":1},{"text":"ڕیزی ددانەکانی ترسێنەرە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"پشتی بە ڕیزێک قەڵغان داپۆشراوە،","poem":1},{"text":"بە پتەوی بەیەکەوە بەستراوە؛","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بە شێوەیەک پێکەوە نووساون کە","poem":1},{"text":"تەنانەت با بە نێوانیاندا ناڕوات.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"هەریەکەیان بەوی تەنیشتیەوە نووساوە؛","poem":1},{"text":"پێکەوە بەستراون لێک نابنەوە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"کە دەحیلێنێت بروسکەی ڕووناکی دەدات؛","poem":1},{"text":"چاوەکانی وەک گزنگی بەیانن.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"لە دەمیەوە بڵێسەی ئاگر دێتە دەرەوە،","poem":1},{"text":"پریشکی ئاگری لێ دەبێتەوە.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"لە کونە لووتییەوە دووکەڵ هەڵدەستێت،","poem":1},{"text":"هەروەک سووتانی قامیش لەبن مەنجەڵێکی لە کوڵ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"هەناسەی خەڵووز دادەگیرسێنێت،","poem":1},{"text":"گڕیش لە دەمیەوە دەڕژێت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"هێزەکەی لە ملیدایە،","poem":1},{"text":"لەبەردەمی هەڵوەستەی لێ دەکەن.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"گۆشتەکەی قەدقەد پێکەوە نووساوە،","poem":1},{"text":"بەسەر لەشیدا داڕێژراوە و ناجوڵێتەوە.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"سەرسەختە،","poem":1},{"text":"بە جەرگ و چاونەوترسە.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"کە هەڵدەستێت بەهێزان دەتۆقن،","poem":1},{"text":"لە ترسی خۆڕاتەکاندنەکەی پەنا دەگرن.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"شمشێری بەر دەکەوێت بەڵام نایپێکێت،","poem":1},{"text":"نە ڕم و نە تیر.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ئاسن لەلای وەک کا وایە،","poem":1},{"text":"بڕۆنزیش وەک داری کلۆر.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"تیری کەوانەکان نایبەزێنن؛","poem":1},{"text":"بەردی بەردەقانییەکان بەلایەوە وەک پووشن.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"گورز لەلای وەک کایە؛","poem":1},{"text":"بە ڕاوەشاندنی ڕم پێدەکەنێت.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ژێری پارچە گۆزەی تیژە،","poem":1},{"text":"جەنجەڕ بەسەر قوڕدا ڕادەکێشێت.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"وا دەکات قووڵایی وەک مەنجەڵ بکوڵێت،","poem":1},{"text":"دەریا وەک هیزەی زەیت لێ دەکات.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"لەدوای خۆی هێڵێکی سپی درەوشاوە بەجێدەهێڵێت،","poem":1},{"text":"شەپۆلەکان وەک پرچی سپی لێ دەکات.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"لەسەر زەوی هاوشێوەی نییە،","poem":1},{"text":"بۆ نەترسان دروستکراوە.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"بە سووکییەوە تەماشای لووتبەرزەکان دەکات؛","poem":1},{"text":"پاشای هەموو لەخۆباییەکانە.»","poem":2}]}],"fo