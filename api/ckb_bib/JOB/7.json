{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOB","translationId":"ckb_bib","name":"ئەیوب","commonName":"ئەیوب","title":"ئەیوب","order":18,"numberOfChapters":42,"sha256":"de88473061801b83342635c14db3692a32b76c7f7aca9fbafd86f0f32f7be52c","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/ckb_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"«ئایا ژیانی مرۆڤ لەسەر زەوی خزمەتکردن و ڕەنجکێشان نییە،","poem":1},{"text":"ڕۆژانیشی وەک ڕۆژانی ڕەنجدەرێک نییە؟","poem":2}]},{"type":"verse","number":2,"content":[{"text":"وەک چۆن کۆیلە تامەزرۆی سێبەرە و","poem":1},{"text":"کرێکاریش چاوەڕێی کرێیەکەیەتی،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئاواش مانگەکانی بێ ئومێدی بۆم بوون بە میرات و","poem":1},{"text":"شەوانی چەرمەسەری بوون بە بەشم.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"کە دەچمە سەر جێگاکەم دەڵێم: ”کەی بێت هەستم،“","poem":1},{"text":"شەو درێژە دەکێشێت و هەتا بەرەبەیان ئەم دیو و ئەو دیو دەکەم.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"گۆشتم کرم و قەتماغە پۆشیویەتی،","poem":1},{"text":"پێستم شەقار بووە و کێمی کردووە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«ڕۆژگارم لە تەون خێراترە و","poem":1},{"text":"بێ هیوا کۆتایی دێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئەی خودا، لە یادت نەچێت کە ژیانم هەناسەیەکە و","poem":1},{"text":"ئیتر چاوەکانم خۆشی نابینن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەو چاوەی کە ئێستا دەمبینێت لەمەودوا نامبینێت،","poem":1},{"text":"چاوت بڕیوەتە من، بەڵام من بوونم نابێت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"هەور پەرت دەبێت و نامێنێت،","poem":1},{"text":"بە هەمان شێوە ئەوەی دادەبەزێتە ناو جیهانی مردووان سەرناکەوێتەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئیتر ناگەڕێتەوە ماڵەکەی خۆی و","poem":1},{"text":"دەوروپشتی لە یادی دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«لەبەر ئەوە منیش دەمم ناگرم،","poem":1},{"text":"لە تەنگی ڕۆحمەوە قسە دەکەم،","poem":2},{"lineBreak":true},{"text":"لە دڵشکاویمەوە سکاڵا دەکەم.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بۆچی پاسەوانت لەسەر داناوم؟","poem":1},{"text":"ئایا من دەریام یان ئەژدیهام؟","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەگەر بڵێم نوێنەکەم دڵنەواییم دەداتەوە،","poem":1},{"text":"جێگاکەم دڵتەنگییەکەم دەڕەوێنێتەوە،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"بە خەون دەمترسێنیت و","poem":1},{"text":"بە مۆتەکە دەمتۆقێنیت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"لەبەر ئەوە گیانم خنکان هەڵدەبژێرێت،","poem":1},{"text":"مردنم پێ باشترە لەم پەیکەرە ئێسکە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"توامەوە، بۆ هەتاهەتایە ناژیم،","poem":1},{"text":"وازم لێ بهێنە، چونکە ڕۆژگارم هیچ واتایەکی نییە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«مرۆڤ چییە هەتا بایەخی پێبدەیت و","poem":1},{"text":"هەتا بیری خۆتی پێوە خەریک بکەی،","poem":2}]},{"type":"verse","number":18,"content":[{"text":"هەموو بەیانییەک بەسەری بکەیتەوە و","poem":1},{"text":"هەموو ساتێک تاقی بکەیتەوە؟","poem":2}]},{"type":"verse","number":19,"content":[{"text":"هەتا کەی ڕووت لێم وەرناگێڕیت و","poem":1},{"text":"مۆڵەتم نادەیتێ هەتا تفەکەم قووت بدەم؟","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئەگەر گوناهیشم کردبێت،","poem":1},{"text":"کە تۆ چاودێری مرۆڤیت،","poem":2},{"lineBreak":true},{"text":"ئایا هیچ کاردانەوەیەکی لەسەر تۆ هەبووە؟","poem":2},{"text":"بۆچی منت کردووە بە نیشانەی تیری خۆت؟","poem":1},{"text":"ئایا بووم بە بار بەسەر تۆوە؟","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئەی بۆ لە یاخیبوونم خۆش نابیت و","poem":1},{"text":"تاوانم ناسڕیتەوە؟","poem":2},{"text":"چونکە بەم نزیکانە لەناو خاکدا ڕادەکشێم و","poem":1},{"text":"بەدوامدا دەگەڕێیت، بەڵام من بوونم نابێت.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}