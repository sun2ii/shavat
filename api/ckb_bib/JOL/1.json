ype":"verse","number":5,"content":[{"text":"ئەی سەرخۆشەکان، بەئاگا بێن و بگریێن!","poem":1},{"text":"ئەی هەموو ئەوانەی شەراب دەخۆنەوە،","poem":2},{"text":"واوەیلا بۆ شەرابی شیرین بکەن،","poem":1},{"text":"چونکە لە دەمتان بڕاوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"نەتەوەیەک پەلاماری خاکەکەمی دا،","poem":1},{"text":"بەهێز و بێشومارە،","poem":2},{"text":"ددانەکانی ددانی نەڕە شێرە و","poem":1},{"text":"کەڵبەی شێرە مێی هەیە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"دار مێوەکەمی وێران کردووە و","poem":1},{"text":"دار هەنجیرەکەمی تێکشکاندووە،","poem":2},{"text":"توێکڵەکەی داتاشیوە و فڕێیداوە،","poem":1},{"text":"لقەکانی سپی بوونەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"شین بگێڕە وەک پاکیزەیەکی جلوبەرگی گوش","poem":1},{"noteId":0},{"text":"پۆشیو،","poem":1},{"text":"بۆ مێردی گەنجییەتی کە نەماوە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"پێشکەشکراوی دانەوێڵە و شەراب","poem":1},{"text":"لە ماڵی یەزدان بڕایەوە،","poem":2},{"text":"کاهینەکان دەلاوێننەوە،","poem":1},{"text":"ئەوانەی خزمەتکاری یەزدانن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"کێڵگەکان وێران بوون،","poem":1},{"text":"خاک شیوەنی گێڕا،","poem":2},{"text":"چونکە دانەوێڵە فەوتا،","poem":1},{"text":"شەرابی نوێ نەما،","poem":2},{"lineBreak":true},{"text":"ڕۆن لە هیزە بڕا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ئەی جوتیارەکان، نائومێد بن،","poem":1},{"text":"ڕەزەوانەکان، واوەیلا بکەن،","poem":2},{"text":"بۆ گەنم و جۆ،","poem":1},{"text":"چونکە دروێنەی کێڵگە لەناوچوو.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"دار مێو وشک هەڵگەڕا و","poem":1},{"text":"دار هەنجیر سیس بوو،","poem":2},{"text":"دار هەنار و خورما و سێو،","poem":1},{"text":"هەموو درەختەکانی کێڵگە وشک هەڵگەڕان.","poem":2},{"lineBreak":true},{"text":"بە دڵنیاییەوە شادی و خۆشی بۆ گەل نەما.","poem":2}]},{"type":"heading","content":["بانگەوازی تۆبەکردن"]},{"type":"verse","number":13,"content":[{"text":"ئەی کاهینەکان، گوش بپۆشن و بلاوێننەوە،","poem":1},{"text":"ئەی خزمەتکارانی قوربانگا، واوەیلا بکەن.","poem":2},{"text":"ئەی خزمەتکارانی خوداکەم،","poem":1},{"text":"وەرن و شەو بە بەرگی ماتەمەوە بمێننەوە،","poem":2},{"text":"چونکە پێشکەشکراوی دانەوێڵە و شەراب","poem":1},{"text":"لە ماڵی خوداتان ڕاگیراوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ڕۆژووگرتنێک ڕابگەیەنن،","poem":1},{"text":"بۆ کۆبوونەوەیەکی پیرۆز بانگیان بکەن،","poem":2},{"text":"پیران کۆبکەنەوە،","poem":1},{"text":"هەموو دانیشتووانی خاکەکەش","poem":2},{"text":"بێنە ماڵی یەزدانی پەروەردگارتان،","poem":1},{"text":"هاوار بکەن بۆ یەزدان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ئای بۆ ئەو ڕۆژە!","poem":1},{"text":"چونکە ڕۆژی یەزدان","poem":2},{"noteId":1},{"text":"نزیک بووەتەوە،","poem":2},{"lineBreak":true},{"text":"وەک وێرانبوون لەلایەن خودای هەرە بەتواناوە دێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ئایا لەبەرچاومان خواردن نەبڕاوە؟","poem":1},{"text":"ئایا لە ماڵی خودامان خۆشی و شادی ماوە؟","poem":2}]},{"type":"verse","number":17,"content":[{"text":"تۆوی دانەوێڵەکان","poem":1},{"text":"لەژێر باڕستی خاکدا ڕزین،","poem":2},{"text":"کۆگاکان چۆڵ کران،","poem":1},{"text":"ئەمبارەکان وێران کران،","poem":2},{"lineBreak":true},{"text":"چونکە دانەوێڵە وشک بوو.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ماڵاتەکان چۆن دەناڵێنن!","poem":1},{"text":"مێگەلەکان بەڕەڵا بوون،","poem":2},{"text":"چونکە لەوەڕگایان نییە،","poem":1},{"text":"تەنانەت ڕانە مەڕەکانیش ماندوون.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ئەی یەزدان، هاوار بۆ تۆ دەکەم،","poem":1},{"text":"چونکە ئاگر لەوەڕگاکانی دەشتودەری خوارد،","poem":2},{"lineBreak":true},{"text":"گڕێک هەموو درەختەکانی کێڵگەی سووتاند.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"تەنانەت ئاژەڵە کێوییەکانیش چاویان لە دەستی تۆیە،","poem":1},{"text":"چونکە جۆگەلە ئاوەکان وشکیان کردووە و","poem":2},{"lineBreak":true},{"text":"ئاگر لەوەڕگاکانی دەشتودەری خواردووە.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"لە کاتی ماتەمگێڕان و تۆبەکردندا جلوبەرگی لە گوش دروستکراویان لەبەرکردووە کە ئەزیەتی پێستیانی داوە.‏","reference":{"chapter":1,"verse":8}},{"noteId":1,"caller":"+","text":"لێرەدا مەبەست لە ڕووداوێکە کە دەبێتە سزای ئیسرائیل لەلایەن خوداوە لەسەر ستەمکاری و خراپەکارییان.‏","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/ckb_bib/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}