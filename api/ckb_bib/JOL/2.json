xt":"یەزدان دەفەرموێت: «بەڵام ئێستا،","poem":1},{"text":"بە هەموو دڵتانەوە بگەڕێنەوە لام،","poem":2},{"lineBreak":true},{"text":"بە ڕۆژووگرتن و گریان و شیوەن گێڕانەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"دڵتان دابدڕن نەک جلەکانتان،","poem":1},{"text":"بگەڕێنەوە لای یەزدانی پەروەردگارتان،","poem":2},{"text":"چونکە میهرەبان و بە بەزەییە،","poem":1},{"text":"پشوودرێژە،","poem":2},{"text":"خۆشەویستییە نەگۆڕەکەی زۆرە،","poem":1},{"text":"لە خراپە پاشگەز دەبێتەوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"کێ دەزانێت؟ ڕەنگە بگەڕێتەوە و پاشگەز بێتەوە،","poem":1},{"text":"لەپاش خۆیەوە بەرەکەت بەجێبهێڵێت،","poem":2},{"text":"بۆ پێشکەشکراوی دانەوێڵە و شەراب","poem":1},{"text":"بۆ یەزدانی پەروەردگارتان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"لە سییۆن فوو بە کەڕەنادا بکەن،","poem":1},{"text":"ڕۆژووگرتنێک ڕابگەیەنن،","poem":2},{"lineBreak":true},{"text":"بۆ کۆبوونەوەیەکی پیرۆز بانگیان بکەن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"گەل کۆبکەنەوە و","poem":1},{"text":"کۆمەڵ تەرخان بکەن،","poem":2},{"text":"پیران خڕبکەنەوە و","poem":1},{"text":"منداڵان کۆبکەنەوە","poem":2},{"lineBreak":true},{"text":"لەگەڵ شیرەخۆرەکان.","poem":2},{"text":"با زاوا لە ژوورەکەیەوە بێتە دەرەوە،","poem":1},{"text":"بووکیش لە کوللەکەی.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"با کاهینەکان، خزمەتکارانی یەزدان،","poem":1},{"text":"لەنێوان هەیوانەکە و قوربانگاکەدا بگریێن.","poem":2},{"text":"با بڵێن: «ئەی یەزدان، دڵت بە گەلەکەت بسووتێت،","poem":1},{"text":"میراتەکەت مەکە جێگای تانە و تەشەر،","poem":2},{"text":"هەتا گەلان بیانکەنە پەند.","poem":1},{"text":"بۆچی لەنێو گەلاندا بڵێن: ”کوا خوداکەیان؟“»","poem":2}]},{"type":"heading","content":["وەڵامی یەزدان"]},{"type":"verse","number":18,"content":[{"text":"ئینجا یەزدان خۆشەویستی بۆ خاکەکەی دەردەبڕێت و","poem":1},{"text":"بەزەیی بە گەلەکەیدا دێتەوە.","poem":2}]},{"type":"verse","number":19,"content":["یەزدان وەڵام