دمە سەرتان.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ئینجا زۆر دەخۆن و تێر دەبن،","poem":1},{"text":"ستایشی ناوی یەزدانی پەروەردگاری خۆتان دەکەن،","poem":2},{"text":"ئەوەی کاری سەرسوڕهێنەری لەگەڵدا کردن،","poem":1},{"text":"بۆ هەتاهەتایە گەلەکەم سەرشۆڕ نابێت.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ئیتر دەزانن کە من لە ناوەڕاستی ئیسرائیلم،","poem":1},{"text":"کە من یەزدانی پەروەردگارتانم و","poem":2},{"lineBreak":true},{"text":"بێجگە لە من یەکێکی دیکە نییە.","poem":2},{"text":"بۆ هەتاهەتایە گەلەکەم سەرشۆڕ نابێت.","poem":1}]},{"type":"heading","content":["ڕۆژی یەزدان"]},{"type":"verse","number":28,"content":[{"text":"«پاش ئەمانە،","poem":1},{"text":"ڕۆحم بەسەر هەموو خەڵکدا دەڕێژم.","poem":2},{"text":"کوڕان و کچانتان پەیامی خودا ڕادەگەیەنن،","poem":1},{"text":"پیرەمێردەکانتان خەون دەبینن،","poem":2},{"lineBreak":true},{"text":"گەنجانتان بینینیان بۆ ئاشکرا دەکرێت.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"تەنانەت بەسەر بەندە و کەنیزەکانیشم،","poem":1},{"text":"لەو ڕۆژانەدا ڕۆحی خۆم دەبارێنم.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"پەرجوو","poem":1},{"noteId":5},{"text":"لە ئاسمان و","poem":1},{"text":"زەویدا نیشان دەدەم،","poem":2},{"lineBreak":true},{"text":"خوێن و ئاگر و ستوونی دووکەڵ.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"خۆر دەبێتە تاریکی و","poem":1},{"text":"مانگیش دەبێتە خوێن،","poem":2},{"lineBreak":true},{"text":"بەر لەوەی ڕۆژی گەورە و ترسناکی یەزدان بێت.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"بەڵام هەرکەسێک بە ناوی یەزدانەوە بپاڕێتەوە","poem":1},{"text":"ڕزگاری دەبێت،","poem":2},{"text":"چونکە هەروەک یەزدان فەرمووی،","poem":1},{"text":"ڕزگاربوون لە کێوی سییۆن و","poem":2},{"lineBreak":true},{"text":"لە ئۆرشەلیم دەبێت،","poem":2},{"text":"بۆ ئەوانەیە کە ماونەتەوە،","poem":1},{"text":"ئەوانەی یەزدان بانگهێشتی کردوون.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"دەریای مردوو.‏","reference":{"chapter":2,"v