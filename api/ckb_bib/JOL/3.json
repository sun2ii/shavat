{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JOL","translationId":"ckb_bib","name":"یۆئێل","commonName":"یۆئێل","title":"یۆئێل","order":29,"numberOfChapters":3,"sha256":"b9ef9dc2a63fc987f9252f35fda968b41cce4fddc15b4f5798c37deed47109b0","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ckb_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["حوکمی نەتەوەکان"]},{"type":"verse","number":1,"content":[{"text":"«لەو ڕۆژانەدا و لەو کاتەدا،","poem":1},{"text":"کاتێک ڕاپێچکراوەکانی یەهودا و ئۆرشەلیم دەگەڕێنمەوە،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"هەموو نەتەوەکان خڕدەکەمەوە و","poem":1},{"text":"دەیانبەمە خوارەوە بۆ دۆڵی یەهۆشافات","poem":2},{"noteId":6},{"text":".","poem":2},{"text":"لەوێدا دادگاییان دەکەم،","poem":1},{"text":"لەسەر گەلەکەم و میراتەکەم، ئیسرائیل،","poem":2},{"text":"کە لەنێو نەتەوەکاندا پەرتوبڵاویان کردنەوە و","poem":1},{"text":"زەوییەکەی منیان دابەش کرد.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لەسەر گەلەکەم تیروپشکیان کرد،","poem":1},{"text":"منداڵیان بۆ لەشفرۆش فرۆشت،","poem":2},{"text":"کچیان بۆ شەراب فرۆشت","poem":1},{"text":"بۆ ئەوەی بیخۆنەوە.","poem":2}]},{"type":"verse","number":4,"content":["«ئەی سور و سەیدا و هەموو ناوچەکانی فەلەستیە، ئیتر ئێوە چیتان لە دژی من هەیە؟ ئایا تۆڵەم لێ دەستێننەوە؟ جا ئەگەر تۆڵەم لێ بستێننەوە، بە پەلە و خێرا بەسەر خۆتانیدا دەهێنمەوە،"]},{"type":"verse","number":5,"content":["چونکە ئێوە زێڕ و زیوەکەی منتان برد و گەنجینە باشەکانی منتان بردە ناو پەرستگاکانی خۆتان."]},{"type":"verse","number":6,"content":["نەوەی یەهودا و نەوەی ئۆرشەلیمتان بە نەوەی یۆنانییەکان فرۆشت، تاکو لە نیشتیمانی خۆیان دووریان بخەنەوە."]},{"type":"verse","number":7,"content":["«ببینن، من لەو شوێنەوە کە ئەوانتان پێی فرۆشتبوو هەڵیاندەستێنم، ئەوەی کردبووتان بەسەر خۆتانیدا دەهێنمەوە."]},{"type":"verse","number":8,"content":["کوڕ و کچەکانتان دەفرۆشمە نەوەی یەهودا، ئەوانیش دەیانفرۆشنە سەبئییەکان، نەتەوەیەکی دوور.» ئەوە فەرمایشتی یەزدانە."]},{"type":"verse","number":9,"content":[{"text":"ئەمە لەنێو نەتەوەکاندا ڕابگەیەنن:","poem":1},{"text":"خۆتان بۆ جەنگێک ئامادە بکەن!","poem":2},{"text":"پاڵەوانەکان هەڵتسێنن!","poem":1},{"text":"با هەموو جەنگاوەران پێشبکەون و هێرش بکەن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"گاسنەکانتان بکوتن و بیکەنە شمشێر،","poem":1},{"text":"داسەکانیشتان بکەنە ڕم.","poem":2},{"text":"با لاواز بڵێت،","poem":1},{"text":"«من پاڵەوانم!»","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەی هەموو نەتەوەکانی دەوروبەر، بە پەلە وەرن،","poem":1},{"text":"لەوێدا کۆببنەوە.","poem":2},{"lineBreak":true},{"text":"ئەی یەزدان، پاڵەوانەکانت دابەزێنە!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«نەتەوەکان هەڵدەستن و دێن،","poem":1},{"text":"بۆ دۆڵی یەهۆشافات،","poem":2},{"text":"چونکە لەوێدا دادەنیشم بۆ دادگاییکردنی","poem":1},{"text":"هەموو نەتەوەکانی دەوروبەر.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"داسەکە ڕاوەشێنن،","poem":1},{"text":"چونکە دروێنەکە پێگەیشتووە.","poem":2},{"text":"وەرن ترێ بپڵیشێننەوە،","poem":1},{"text":"چونکە گوشەرەکە پڕ بووە،","poem":2},{"lineBreak":true},{"text":"قەڕابەکە سەرڕێژ دەبێت،","poem":2},{"text":"چونکە خراپەیان زۆرە!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«لە دۆڵی بڕیار","poem":1},{"text":"کۆمەڵ، کۆمەڵ!","poem":2},{"lineBreak":true},{"text":"چونکە ڕۆژی یەزدان نزیکە","poem":2},{"lineBreak":true},{"text":"لە دۆڵی بڕیار.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"خۆر و مانگ تاریک دەبن و","poem":1},{"text":"ئەستێرەکان تروسکایی خۆیان ڕادەگرن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"یەزدانیش لە سییۆنەوە دەنەڕێنێت،","poem":1},{"text":"لە ئۆرشەلیمەوە دەنگی بەرز دەکاتەوە،","poem":2},{"lineBreak":true},{"text":"ئاسمان و زەوی دەهەژێن.","poem":2},{"text":"بەڵام یەزدان پەناگایە بۆ گەلەکەی خۆی،","poem":1},{"text":"قەڵایە بۆ نەوەی ئیسرائیل.","poem":2}]},{"type":"heading","content":["بەرەکەتی سەر گەلی خودا"]},{"type":"verse","number":17,"content":[{"text":"«ئیتر دەزانن کە من یەزدانی پەروەردگارتانم،","poem":1},{"text":"لە سییۆن نیشتەجێم، کێوی پیرۆزم.","poem":2},{"text":"ئۆرشەلیمیش پیرۆز دەبێت؛","poem":1},{"text":"لەمەودوا بێگانە بەناویدا تێناپەڕێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«لەو ڕۆژەدا چیاکان خۆشاوی ترێیان لێ دەتکێت،","poem":1},{"text":"گردەکان شیریان لێ دەڕژێت؛","poem":2},{"lineBreak":true},{"text":"هەموو کەندەکانی یەهودا ئاویان لەسەر دەڕژێت،","poem":2},{"text":"کانییەک لە ماڵی یەزدانەوە هەڵدەقوڵێت،","poem":1},{"text":"دۆڵی شەتیم","poem":2},{"noteId":7},{"text":"ئاو دەدات.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بەڵام میسر وێران دەبێت،","poem":1},{"text":"ئەدۆمیش دەبێتە چۆڵەوانییەکی وێران،","poem":2},{"text":"لەبەر ئەوەی ستەمیان لە نەوەی یەهودا کرد،","poem":1},{"text":"خوێنی بێتاوانیان لە خاکەکەیاندا ڕشت.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"یەهوداش هەتاهەتایە ئاوەدان دەبێت،","poem":1},{"text":"ئۆرشەلیمیش نەوە دوای نەوە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لەو خوێنڕشتنەیان خۆشدەبم","poem":1},{"text":"کە پێشتر لێی خۆش نەببووم.»","poem":2},{"lineBreak":true},"یەزدانیش لە سییۆن نیشتەجێ دەبێت!"]}],"footnotes":[{"noteId":6,"caller":"+","text":"لە عیبری بە واتای خودا دادگایی دەکات.‏","reference":{"chapter":3,"verse":2}},{"noteId":7,"caller":"+","text":"یان: دۆڵی داری ئەکاسیا، شوێنێکی وشک و بێ ئاو بووە.‏","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/ckb_bib/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}