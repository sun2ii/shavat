{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"JON","translationId":"ckb_bib","name":"یونس","commonName":"یونس","title":"یونس","order":32,"numberOfChapters":4,"sha256":"710369fe505fe40e0a323595b35e721059c6221b93061b99bfe2c3c99681eabd","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/ckb_bib/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["نزای یونس"]},{"type":"verse","number":1,"content":["یونس لەناو سکی ماسییەکەوە نزای بۆ یەزدانی پەروەردگاری خۆی کرد،"]},{"type":"verse","number":2,"content":["گوتی:",{"text":"«لە تەنگانەمدا هاوارم بۆ یەزدان کرد،","poem":1},{"text":"وەڵامی دامەوە.","poem":2},{"text":"لەناو سکی جیهانی مردووانەوە هاوارم کرد،","poem":1},{"text":"گوێت لە دەنگم بوو.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"فڕێتدامە قووڵایی،","poem":1},{"text":"لەناو جەرگەی دەریاکان،","poem":2},{"lineBreak":true},{"text":"لافاو دەوری دام،","poem":2},{"text":"شەپۆلەکانت بە لێشاو","poem":1},{"text":"دایانپۆشیم.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"گوتم: ”لەبەرچاوت دەرکرام،","poem":1},{"text":"بەڵام دەگەڕێمەوە","poem":2},{"lineBreak":true},{"text":"بۆ تەماشاکردنی پەرستگای پیرۆزت.“","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئاو دەوری دام، تاکو ئەوەی ترس گەیشتە گیانم،","poem":1},{"text":"قووڵایی دەوری گرتم،","poem":2},{"lineBreak":true},{"text":"گیای دەریا لەسەرم ئاڵا.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"هەتا بنی چیاکان شۆڕ بوومەوە،","poem":1},{"text":"بۆ هەتاهەتایە لە زەوی بەندی کردم.","poem":2},{"text":"ئەی یەزدانی پەروەردگارم،","poem":1},{"text":"بەڵام تۆ ژیانی منت لە جیهانی مردووان هێنایە دەرەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ئەی یەزدان، کاتێک گیانم شەکەت بوو،","poem":1},{"text":"تۆم بیرکەوتەوە،","poem":2},{"text":"نزاکەم گەیشتە لات،","poem":1},{"text":"بۆ پەرستگای پیرۆزت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«ئەوانەی بتی پووچ دەپەرستن","poem":1},{"text":"لە خۆشەویستی خودا بۆ خۆیان هەڵدەگەڕێنەوە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بەڵام من بە دەنگی ستایشەوە","poem":1},{"text":"قوربانیت بۆ سەردەبڕم،","poem":2},{"text":"ئەوەی نەزرم کردووە بەجێی دەهێنم.","poem":1},{"text":"ڕزگاری لە یەزدانەوەیە.»","poem":2}]},{"type":"verse","number":10,"content":["ئینجا یەزدان فەرمانی بە ماسییەکە دا، ئەویش ڕشایەوە و یونسی فڕێدایە سەر وشکانی."]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}