]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«پەروەردگار هەموو پاڵەوانەکانی ڕەتکردەوە","poem":1},{"text":"کە لەناو مندا بوون.","poem":2},{"text":"لەشکرێکی لە دژی من بانگکرد","poem":1},{"text":"بۆ تێکشکاندنی گەنجەکانم.","poem":2},{"text":"پەروەردگار یەهودای کچە پاکیزەی","poem":1},{"text":"لەناو گوشەر پڵیشاندەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"«لەسەر ئەمەیە من دەگریێم،","poem":1},{"text":"چاوەکانم فرمێسک دەڕێژن،","poem":2},{"text":"ئەوەی دڵنەواییم دەکات لێم دوور کەوتووەتەوە،","poem":1},{"text":"کەس نییە گیان ببوژێنێتەوە.","poem":2},{"text":"کوڕەکانم وێران بوون،","poem":1},{"text":"لەبەر ئەوەی دوژمن زاڵ بوو.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"سییۆن دەستەکانی پان دەکاتەوە،","poem":1},{"text":"بەڵام کەس نییە دڵنەوایی بکات.","poem":2},{"text":"یەزدان فەرمانی دا لە دژی یاقوب","poem":1},{"text":"کە دراوسێکانی دوژمنی ئەو بن.","poem":2},{"text":"ئۆرشەلیم لەناویاندا","poem":1},{"text":"گڵاو بوو.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«یەزدان ڕاستودروستە،","poem":1},{"text":"بەڵام من لە دژی فەرمانی ئەو یاخی بووم.","poem":2},{"text":"ئەی هەموو گەلان، گوێ بگرن،","poem":1},{"text":"تەماشای ئازارەکانم بکەن.","poem":2},{"text":"پاکیزە و لاوەکانم","poem":1},{"text":"ڕاپێچ کران.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«هاوارم بردە لای هاوپەیمانەکانم،","poem":1},{"text":"بەڵام هەڵیانخەڵەتاندم.","poem":2},{"text":"کاهین و پیرەکانم","poem":1},{"text":"لە شاردا لەناوچوون","poem":2},{"text":"لەو کاتەی بەدوای خۆراکدا دەگەڕان","poem":1},{"text":"بۆ ئەوەی لە ژیانیان بەردەوام بن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«ئەی یەزدان، ببینە، من لە تەنگانەدام!","poem":1},{"text":"دڵم توندە،","poem":2},{"text":"من لە ناخەوە پەستم،","poem":1},{"text":"چونکە زۆر یاخی بووم.","poem":2},{"text":"لە دەرەوە شمشێر دەستبەکارە،","poem":1},{"text":"لە ماڵ