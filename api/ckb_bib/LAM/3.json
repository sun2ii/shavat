t":"بەڵام ئەوە دەهێنمەوە یادم و","poem":1},{"text":"لەبەر ئەوە هیوام هەیە:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"بەهۆی خۆشەویستی نەگۆڕی یەزدانە کە لەناونەچووین،","poem":1},{"text":"چونکە بەزەییەکەی تەواو نابێت.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ئەوانەت هەموو بەیانییەک نوێن؛","poem":1},{"text":"دڵسۆزییەکەت چەند گەورەیە.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"بە خۆم دەڵێم: «یەزدان بەشی منە،","poem":1},{"text":"لەبەر ئەوە هیوام بەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"یەزدان چاکە بۆ ئەوانەی هیوایان بەو هەیە،","poem":1},{"text":"بۆ ئەو کەسەی داوای ئەو دەکات.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"باشە بۆ کەسێک بە بێدەنگی چاوەڕێ بکات","poem":1},{"text":"بۆ هاتنی ڕزگاریی یەزدان.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"باشە پیاو نیر هەڵبگرێت","poem":1},{"text":"هەر لە تەمەنی منداڵییەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"با بە تەنها دانیشێت و بێدەنگ بێت،","poem":1},{"text":"چونکە یەزدان ئەمەی بەسەرهێناوە.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"با سەری بخاتە ناو خاکوخۆڵ،","poem":1},{"text":"لەوانەیە هێشتا هیوای مابێت.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"با ڕوومەتی بۆ ئەوە ڕابگرێت کە لێی دەدات،","poem":1},{"text":"با تێربێت لە ڕیسوایی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"چونکە کەس بۆ هەتاهەتایە","poem":1},{"text":"لەلایەن پەروەردگارەوە ڕەت ناکرێتەوە.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"لەگەڵ ئەوەی دڵتەنگی دەهێنێت، میهرەبانیش نیشان دەدات،","poem":1},{"text":"بەپێی گەورەیی خۆشەویستییە نەگۆڕەکەی.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ئەو کەس لە دڵەوە زەلیل ناکات و","poem":1},{"text":"دڵتەنگی ناکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"تێکشکاندنی دیلەکانی هەموو زەوی","poem":1},{"text":"لەژێر پێ،","poem":2}]},{"type":"verse","number":35,"content":[{"text":"یان بێبەشکردنی کەسێک لە مافی خۆی","poem":1},{"text":"لەبەردەم خودای هەرەبەرز،","poem":2}]},{"type":"verse","number":36,"content":[{"text":"یان بەدوورگرتنی مرۆڤ لە دادپەروەری،","poem":1},{"text":"ئایا پەروەردگار هەموو ئەمانە نابینێت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"کێ دەتوانێت قسە بکات قسەکەی بێتەجێ،","poem":1},{"text":"ئەگەر پەروەردگار فەرمانی نەدابێت؟","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ئایا ڕوودانی چاکە و خراپە","poem":1},{"text":"بە فەرمایشتی خودای هەرەبەرز نییە؟","poem":2}]},{"type":"verse","number":39,"content":[{"text":"بۆچی مرۆڤی زیندوو گلەیی بکات","poem":1},{"text":"کاتێک لەسەر گوناهەکانی سزا دەدرێت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"با هەڵسوکەوتمان بپشکنین و تاقی بکەینەوە و","poem":1},{"text":"بگەڕێینەوە بۆ لای یەزدان.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"با دڵ و دەستمان بەرزبکەینەوە","poem":1},{"text":"بۆ خودا لە ئاسمان، بڵێین:","poem":2}]},{"type":"verse","number":42,"content":[{"text":"«ئێمە گوناهمان کرد و یاخی بووین،","poem":1},{"text":"تۆش لێمان خۆش نەبوویت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"«خۆت بە تووڕەیی داپۆشی و ڕاوتناین،","poem":1},{"text":"بەبێ بەزەیی ئێمەت کوشت.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"بە هەور خۆت داپۆشی","poem":1},{"text":"بۆ ئەوەی نوێژەکانمان نەگاتە لات.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"ئێمەت کرد بە پاشەڕۆ و نەویستراو","poem":1},{"text":"لەنێو گەلان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"«هەموو دوژمنانمان","poem":1},{"text":"دەمیان لێمان کردەوە.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ترس و تەڵە باڵی بەسەرماندا کێشا،","poem":1},{"text":"لەناوچوون و وێرانی.»","poem":2}]},{"type":"verse","number":48,"content":[{"text":"چاوەکانم کان