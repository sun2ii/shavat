number":62,"content":[{"text":"ئەوەی دوژمنەکانم بە درێژایی ڕۆژ لە دژی من","poem":1},{"text":"باسی دەکەن و دەیچرپێنن.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"تەماشایان بکە! هەستان و دانیشتنیان،","poem":1},{"text":"بە گۆرانییەکانیان گاڵتەم پێ دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"ئەی یەزدان، سزایان بدە،","poem":1},{"text":"بەپێی کردەوەکانی دەستیان.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"پێچە لەسەر دڵیان دابنێ،","poem":1},{"text":"با نەفرەتت لەسەریان بێت!","poem":2}]},{"type":"verse","number":66,"content":[{"text":"بە تووڕەییەوە ڕاویان بنێ و لەناویان ببە","poem":1},{"text":"لەژێر ئاسمانی یەزداندا.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}