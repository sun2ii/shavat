","poem":1},{"text":"بەڵام کەس نییە بۆیان بشکێنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ئەوانەی خواردنی خۆشیان دەخوارد","poem":1},{"text":"لە شەقامەکاندا وێران بوون،","poem":2},{"text":"ئەوانەی لەناو جلوبەرگی ئەرخەوانی بەخێو دەکران","poem":1},{"text":"لەسەر زبڵدانەکان پاڵ دەدەنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"سزای تاوانی گەلەکەم گەورەتر بوو","poem":1},{"text":"لە سزای گوناهەکەی سەدۆم،","poem":2},{"text":"ئەوەی لە چرکەیەکدا سەرەوژێر بوو","poem":1},{"text":"بێ ئەوەی دەستی یارمەتی بۆ درێژ بکرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"میرەکانیان لە بەفر بێگەردتر بوون،","poem":1},{"text":"لە شیر سپیتر بوون،","poem":2},{"text":"جەستەیان لە یاقووت","poem":1},{"noteId":6},{"text":"سوورتر بوو،","poem":1},{"text":"وەک یاقووتی شین","poem":2},{"noteId":7},{"text":"بوون.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"بەڵام ئێستا ڕەنگیان لە ڕەژوو ڕەشترە،","poem":1},{"text":"لە شەقامەکاندا ناناسرێنەوە.","poem":2},{"text":"پێستیان بە ئێسکیانەوە نووساوە","poem":1},{"text":"وەک تەختەدار وشک هەڵگەڕاوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەوانەی بە شمشێر کوژران باشتر بوون","poem":1},{"text":"لەوانەی بە قاتوقڕی مردن.","poem":2},{"text":"ئەوانە بە برسیێتی ئازاریان چێشت،","poem":1},{"text":"چونکە خواردن لە کێڵگە نەبوو.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"دایکە میهرەبانەکان","poem":1},{"text":"بە دەستی خۆیان منداڵەکانیان لێنا،","poem":2},{"text":"کردیان بە خۆراک","poem":1},{"text":"کاتێک گەلەکەم لەناوچوو.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"یەزدان تووڕەیی خۆی دەردەبڕێت،","poem":1},{"text":"هەڵچوونی بە جۆشی خۆی هەڵدەڕێژێت.","poem":2},{"text":"ئاگرێکی لە سییۆن بەرپا کرد","poem":1},{"text":"بناغەکانی سووتاند.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"پاشاکانی زەوی و هەموو دانیشتووانی جیهان","poem":1},{"text":"باوەڕیان نەکرد","poem":2},{"text":"کە دوژمن و ناحەز","poem":1},{"text":"دێنە ناو دەروازەکانی ئۆرشەلیمەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"بەڵام لەبەر گوناهی پێغەمبەرەکانی","poem":1},{"noteId":8},{"text":"و","poem":1},{"text":"تاوانی کاهینەکانی ڕوویدا،","poem":2},{"text":"ئەوانەی لە ناوەڕاستیدا","poem":1},{"text":"خوێنی ڕاستودروستانیان دەڕشت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"بە شەقامەکاندا وێڵ بوون","poem":1},{"text":"وەک کوێر.","poem":2},{"text":"خۆیان بە خوێن گڵاوکرد،","poem":1},{"text":"کەس ناتوانێت دەست لە جلەکانیان بدات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"خەڵک هاواریان لێ دەکەن: «ئەی گڵاوەکان، دووربکەونەوە!","poem":1},{"text":"دووربکەونەوە! دووربکەونەوە، دەستمان لێ مەدەن!»","poem":2},{"text":"کاتێک ڕایانکرد و وێڵ بوون،","poem":1},{"text":"لەناو گەلاندا گوتیان،","poem":2},{"lineBreak":true},{"text":"«جارێکی دیکە ناتوانن لێرە نیشتەجێ بن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"یەزدان خۆی پەرتەوازەی کردن،","poem":1},{"text":"ئیتر چاودێرییان ناکات.","poem":2},{"text":"خەڵک ڕێزیان لە کاهینەکان نەگرت،","poem":1},{"text":"لەگەڵ پیرەکان میهرەبان نەبوون.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"سەرباری ئەمەش، ئێمە چاومان کزبوو","poem":1},{"text":"بێهوودە لە چاوەڕوانی یارمەتی،","poem":2},{"text":"لە قوللەکانمان چاوەڕێ بووین","poem":1},{"text":"بۆ گەلێک کە ناتوانێت ڕزگارمان بکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"تەڵەیان بۆ هەنگاوەکانمان ناوەتەوە","poem":1},{"text":"بۆ ئەوەی لە گۆڕەپانەکانماندا هاتوچۆ نەکەین.","poem":2},{"text":"کۆتاییمان نزیک بووەوە، چەند ڕۆژێکمان ماوە،","poem":1},{"text":"چونکە کۆتاییمان هات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ئەوانەی ڕاویان دەناین سووکتر بوون","poem":1},{"text":"لە هەڵۆکانی ئاسمان،","poem":2},{"text":"بەسەر چیاکاندا شوێنمان کەوتن،","poem":1},{"text":"لە چۆڵەوانیدا بۆسەیان بۆمان نایەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"پاشای دەستنیشانکراوی یەزدان، ئەوەی هەناسەی ژیانمانە،","poem":1},{"text":"لە بۆسەکانیان گیرا،","poem":2},{"text":"ئەوەی گوتمان، لە سێبەری ئەودا","poem":1},{"text":"لەنێو گەلان دەژین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ئەی کچی ئەدۆم، دڵخۆش و دڵشادبە،","poem":1},{"text":"ئەی دانیشتووانی خاکی عوچ.","poem":2},{"text":"بەڵام جامەکە بەسەر تۆشدا تێدەپەڕێت،","poem":1},{"text":"سەرخۆش دەبیت و ڕووت دەبیتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ئەی سییۆنی کچ، سزای تاوانەکەت تەواو دەبێت،","poem":1},{"text":"ڕاپێچکراوییەکەت درێژ ناکاتەوە.","poem":2},{"text":"بەڵام ئەی ئەدۆمی کچ، سزای تاوانەکەی تۆ دەدات،","poem":1},{"text":"گوناهەکەت ئاشکرا دەکات.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":6,"caller":"+","text":"یاقووت: گەوهەری سووری تێر.‏","reference":{"chapter":4,"verse":7}},{"noteId":7,"caller":"+","text":"یاقووتی شین: دەشێت وەک لاجیوەرد بێت.‏","reference":{"chapter":4,"verse":7}},{"noteId":8,"caller":"+","text":"مەبەستی لەوانەیە کە خۆیان وەک پێغەمبەر دەناساند و لە ڕاستیشدا پێغەمبەر نەبوون. بڕوانە یەرمیا 5‏:31؛ 6‏:13.‏","reference":{"chapter":4,"verse":13}}]},"thisChapterLink":"/api/ckb_bib/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}