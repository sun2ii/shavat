em":1},{"text":"ئێمەش سزاکەیان وەردەگرین.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"کۆیلەکان فەرمانڕەوایەتیمان دەکەن،","poem":1},{"text":"کەس نییە لە دەستیان ڕزگارمان بکات.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بەهۆی شمشێر لە چۆڵەوانی ژیانمان لە مەترسیدایە","poem":1},{"text":"هەتا بژێوی پەیدا دەکەین.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"پێستمان وەک تەنوور سووتاوە،","poem":1},{"text":"لەبەر برسیێتی برژاوین.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لە سییۆن دەستدرێژییان کردە سەر ژنان،","poem":1},{"text":"پاکیزەکانیش لە شارۆچکەکانی یەهودا.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"میران بە دەستیانەوە هەڵدەواسرێن،","poem":1},{"text":"ڕێز لە پیران ناگیرێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لاوانیان دەهاڕدرێن،","poem":1},{"text":"منداڵان لەژێر بارەداردا بەلادادێن.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"پیران دەستیان لە دەروازە هەڵدەگرن،","poem":1},{"text":"لاوانیش وازیان لە گۆرانی هێنا.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"خۆشی دڵمان نەما،","poem":1},{"text":"شاییمان بوو بە شیوەن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"تاجی سەرمان کەوت.","poem":1},{"text":"قوڕبەسەرمان، چونکە گوناهمان کرد!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لەبەر ئەم شتانە دڵمان داهێزرا،","poem":1},{"text":"لەبەر ئەم ڕووداوانە بەرچاومان تاریک بوو،","poem":2}]},{"type":"verse","number":18,"content":[{"text":"لەبەر کێوی سییۆن، وێران بوو،","poem":1},{"text":"چەقەڵ هاتوچۆی تێدا دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ئەی یەزدان، تۆ بۆ هەتاهەتایە حوکم دەکەیت،","poem":1},{"text":"تەختی تۆ نەوە دوای نەوە بەردەوام دەبێت.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"بۆچی بەردەوام لەبیرمان دەکەیت؟","poem":1},{"text":"بۆچی کاتێکی درێژ بەجێمان دەهێڵیت؟","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئەی یەزدان، بمانگەڕێنەوە بۆ لای خۆت، هەتا بگەڕێینەوە،","poem":1},{"text":"وەک جاران ڕۆژانمان نوێ بکەرەوە،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"یان تۆ زۆر لێمان تووڕە بوویت و","poem":1},{"text":"بە تەواوی ئێمەت ڕەتکردووەتەوە؟","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}