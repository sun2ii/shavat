{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"MIC","translationId":"ckb_bib","name":"میخا","commonName":"میخا","title":"میخا","order":33,"numberOfChapters":7,"sha256":"27fc1aa8eb630bc0664b4753bd64cf731cc4d3e889e74f735ccfc62cfaaafa5d","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/ckb_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["پەیامی یەزدان کە لە سەردەمی یۆتام و ئاحاز و حەزقیای پاشایانی یەهودا بۆ میخای مۆرەشەتی هات، ئەو بینینەی سەبارەت بە سامیرە و ئۆرشەلیم بوو:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ئەی هەموو گەلان، گوێ بگرن،","poem":1},{"text":"زەوی و هەموو ئەوانەی تێیدان، سەرنج بدەن:","poem":2},{"text":"پەروەردگار لە پەرستگای پیرۆزیەوە،","poem":1},{"text":"یەزدانی باڵادەست ببێتە شایەت بەسەرتانەوە.","poem":2}]},{"type":"heading","content":["حوکمدان بەسەر سامیرە و ئۆرشەلیم"]},{"type":"verse","number":3,"content":[{"text":"ئەوەتا، یەزدان لە شوێنی نیشتەجێبوونی خۆیەوە دێتە دەرەوە،","poem":1},{"text":"دادەبەزێت و بەسەر بەرزاییەکانی زەویدا دەڕوات.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"چیاکان لە ژێری دەتوێنەوە و","poem":1},{"text":"دۆڵەکان شەق دەبەن،","poem":2},{"text":"وەک مۆم لەبەردەم ئاگردا،","poem":1},{"text":"وەک ئاوی ڕۆیشتوو بە لێژاییدا.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"هەموو ئەمە لەبەر یاخیبوونی یاقوب،","poem":1},{"text":"لەبەر گوناهی بنەماڵەی ئیسرائیل.","poem":2},{"text":"چی هۆکاری یاخیبوونی یاقوبە؟","poem":1},{"text":"ئایا سامیرە نییە؟","poem":2},{"text":"ئەی هۆکاری بتپەرستی بەرزاییەکانی یەهودا چییە؟","poem":1},{"text":"ئایا ئۆرشەلیم نییە؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«لەبەر ئەوە سامیرە کاول و وێران دەکەم،","poem":1},{"text":"دەیکەمە کێڵگەی مێو چاندن.","poem":2},{"text":"بەردەکانی فڕێدەدەمە ناو دۆڵەکەوە و","poem":1},{"text":"بناغەکانی دەردەخەم.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"هەموو بتەکانی تێکدەشکێنرێن و","poem":1},{"text":"هەموو کرێی داوێنپیسییەکەی بە ئاگر دەسووتێنرێت،","poem":2},{"lineBreak":true},{"text":"هەموو بتەکانی وێران دەکەم.","poem":2},{"text":"لەبەر ئەوەی بە کرێی لەشفرۆشی کۆی کردووەتەوە،","poem":1},{"text":"دەدرێتەوە لەشفرۆش.»","poem":2}]},{"type":"heading","content":["گریان و شیوەن گێڕان"]},{"type":"verse","number":8,"content":[{"text":"لەبەر ئەوە دەلورێنم و دەلاوێنمەوە،","poem":1},{"text":"بەپێی پەتی و بە ڕووتی هاتوچۆ دەکەم.","poem":2},{"text":"وەک چەقەڵ دەلورێنم و","poem":1},{"text":"وەک کوندەپەپوو شیوەن دەگێڕم،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"چونکە برینەکەی ساڕێژ نابێت،","poem":1},{"text":"بەڵکو یەهوداش تووش بوو،","poem":2},{"text":"گەیشتە دەروازەی گەلەکەم،","poem":1},{"text":"هەتا ئۆرشەلیم هات.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەوە لە گەت ڕامەگەیەنن،","poem":1},{"text":"بە هیچ شێوەیەک مەگریێن،","poem":2},{"text":"لە بێت‌عۆفرادا","poem":1},{"noteId":0},{"text":"خۆت لە خۆڵ بگەوزێنە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەی دانیشتووانی شافیر","poem":1},{"text":"بە ڕووتی و شەرمەزاری بپەڕنەوە،","poem":2},{"text":"دانیشتووانی چەئەنان دەرنەچن.","poem":1},{"text":"بێت‌ئێچەل دەگریێت","poem":2},{"lineBreak":true},{"text":"بەڵام ناتانپارێزێت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"دانیشتووانی مارۆت بە ئازارەوە دەتلێنەوە،","poem":1},{"text":"بە دڵەڕاوکێوە چاوەڕێی چارەسەر دەکەن،","poem":2},{"text":"چونکە لەلایەن یەزدانەوە","poem":1},{"text":"بەڵا بۆ دەروازەی ئۆرشەلیم دابەزی.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەی دانیشتووانی لاخیش،","poem":1},{"text":"گالیسکە بە ئەسپەوە ببەستن،","poem":2},{"text":"ئێوە یەکەمین شار بوون دوای یاخیبوونەکانی ئیسرائیل کەوتن،","poem":1},{"text":"هەروەها سییۆنی کچتان","poem":2},{"noteId":1},{"text":"تووشی گوناه کرد.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"لەبەر ئەوە دیاری ماڵئاوایی دەدەن","poem":1},{"text":"بە مۆرەشەت گەت.","poem":2},{"text":"یارمەتی لە شارۆچکەکانی ئەکزیڤەوە","poem":1},{"noteId":2},{"text":"جێی متمانە نییە","poem":1},{"text":"بۆ پاشاکانی ئیسرائیل.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"داگیرکەرتان دەهێنمە سەر،","poem":1},{"text":"ئەی دانیشتووانی مارێشا","poem":2},{"noteId":3},{"text":"،","poem":2},{"text":"ئەوەی شکۆی ئیسرائیلە","poem":1},{"text":"دێتە عەدولام.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"سەرتان بتاشن بۆ شیوەنگێڕان","poem":1},{"text":"لەسەر منداڵە نازدارەکانتان،","poem":2},{"text":"وەک سیسارکە کەچەڵ بن و مووتان بە سەرەوە نەبێ،","poem":1},{"text":"چونکە منداڵی ئێوە بە دیل گیراوی ڕاپێچ دەکەن.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"(بێت‌عۆفرا) واتا (ماڵی خۆڵ).‏","reference":{"chapter":1,"verse":10}},{"noteId":1,"caller":"+","text":"دەربڕینێکی خوازەیە بۆ پایتەخت، مەبەست لە هەموو دانیشتووانی شارەکەیە.‏","reference":{"chapter":1,"verse":13}},{"noteId":2,"caller":"+","text":"ئەکزیڤ واتا هەڵخەڵەتاندنە.‏","reference":{"chapter":1,"verse":14}},{"noteId":3,"caller":"+","text":"لە زمانی عیبریدا دەنگی (مارێشا) نزیکەی وشەیەکی دیکە کە واتا (داگیرکەر).‏","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/ckb_bib/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}