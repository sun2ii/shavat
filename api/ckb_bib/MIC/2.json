{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"MIC","translationId":"ckb_bib","name":"میخا","commonName":"میخا","title":"میخا","order":33,"numberOfChapters":7,"sha256":"27fc1aa8eb630bc0664b4753bd64cf731cc4d3e889e74f735ccfc62cfaaafa5d","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/ckb_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["پیلانی مرۆڤ و پلانی خودا"]},{"type":"verse","number":1,"content":[{"text":"قوڕبەسەر ئەوانەی بیر لە بەدکاری دەکەنەوە و","poem":1},{"text":"لەناو نوێنەکانیان پیلان بۆ خراپە دادەڕێژن!","poem":2},{"text":"کاتێک ڕووناکی بەیان دێت جێبەجێی دەکەن","poem":1},{"text":"چونکە لە دەستیان دێ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"چاویان لە کێڵگەکانە و داگیری دەکەن،","poem":1},{"text":"هەروەها لە ماڵەکانە و دەستی بەسەردا دەگرن.","poem":2},{"text":"دەست بەسەر ماڵی خەڵکدا دەگرن،","poem":1},{"text":"تاکو لە میراتەکەی بێبەشی بکەن.","poem":2}]},{"type":"verse","number":3,"content":["لەبەر ئەوە یەزدان ئەمە دەفەرموێت:",{"text":"«ئەوەتا من سەبارەت بەم گەلە بیر لە بەڵا دەکەمەوە،","poem":1},{"text":"ئەوەی ناتوانن ملتانی لەبەر لابدەن.","poem":2},{"text":"بە لووتبەرزییەوە هاتوچۆ ناکەن،","poem":1},{"text":"چونکە کاتی خراپە دەبێت.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لەو ڕۆژەدا پەندتان بەسەردا هەڵدەدرێت و","poem":1},{"text":"شیوەن دەگێڕن و دەگوترێ:","poem":2},{"text":"”بە تەواوی وێران بووین،","poem":1},{"text":"بەشی گەلەکەی منی گۆڕیوە.","poem":2},{"text":"چۆن لێی داماڵین!","poem":1},{"text":"کێڵگەکانی ئێمەی بەسەر ناپاکەکاندا دابەش کرد؟“»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"لەبەر ئەوە لەنێو کۆمەڵی یەزداندا کەست نابێت","poem":1},{"text":"بە گوریسی پێوانە خاکەکە بە تیروپشک دابەش بکات.","poem":2}]},{"type":"heading","content":["پێغەمبەرانی درۆزن"]},{"type":"verse","number":6,"content":[{"text":"پێغەمبەرەکانیان دەڵێن: «پێشبینی مەکەن!","poem":1},{"text":"دەربارەی ئەم شتانە پێشبینی مەکەن،","poem":2},{"lineBreak":true},{"text":"ڕیسواییمان بەسەردا نایەت.»","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئەی بنەماڵەی یاقوب، ئایا دروستە خەڵک بپرسێت:","poem":1},{"text":"«ئایا یەزدان ئارامی لەبەر دەبڕێت؟","poem":2},{"lineBreak":true},{"text":"یان ئەمە کارەکانی ئەوە؟»","poem":2},{"lineBreak":true},{"text":"«ئایا وشەکانم باش نین","poem":1},{"text":"بۆ ئەوانەی بە ڕێکی هاتوچۆ دەکەن؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بەڵام لەم دواییەدا گەلەکەم","poem":1},{"text":"بۆ دوژمنایەتی ڕاپەڕین.","poem":2},{"text":"ئێوە کراس و کەوا پێکەوە دادەماڵن","poem":1},{"text":"لەوانەی بە دڵنیاییەوە تێدەپەڕن،","poem":2},{"lineBreak":true},{"text":"وەک ئەوانەی لە جەنگ دەگەڕێنەوە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ژنانی گەلەکەم دەردەکەن","poem":1},{"text":"لەو ماڵانەیان کە دڵیان پێی خۆشە.","poem":2},{"text":"بەرەکەتەکەم لە منداڵەکانیان","poem":1},{"text":"بۆ هەتاهەتایە دەبەیت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"هەستن و بڕۆن!","poem":1},{"text":"چونکە ئەمە شوێنی حەسانەوە نییە،","poem":2},{"text":"لەبەر ئەوەی گڵاو بوو،","poem":1},{"text":"وێران بوو، وێرانبوونێکی خراپ.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەگەر درۆزن و چەواشەکار بێت و بڵێت:","poem":1},{"text":"”پێشبینیت بۆ دەکەم، سەبارەت بە شەراب و مەی زۆر دەبێت،“","poem":2},{"lineBreak":true},{"text":"ئەوا ئەو دەبێتە پێغەمبەری ئەم گەلە!","poem":2}]},{"type":"heading","content":["بەڵێنی ڕزگاری"]},{"type":"verse","number":12,"content":[{"text":"«ئەی یاقوب، بە دڵنیایی بە تەواوی کۆتدەکەمەوە،","poem":1},{"text":"بە دڵنیایی پاشماوەی ئیسرائیل خڕدەکەمەوە.","poem":2},{"text":"یەکیاندەخەم وەک ڕانە مەڕی ناو پشتیر","poem":1},{"noteId":4},{"text":"،","poem":1},{"text":"وەک ڕانێک لەناو لەوەڕگاکەی،","poem":2},{"lineBreak":true},{"text":"ئەم شوێنە پڕ لە خەڵک دەبێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"کەلێندڕ پێشیان دەکەوێت،","poem":1},{"text":"دەروازەکە دەشکێنن و لێی تێدەپەڕن و دێنە دەرەوە.","poem":2},{"text":"پاشاکەشیان لەپێشیانەوە تێدەپەڕێت،","poem":1},{"text":"یەزدانیش پێشەنگیانە.»","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"پشتیر: گەوڕ، شوێنێکی تایبەت بووە بە پەروەردەکردنی ئاژەڵ.‏","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/ckb_bib/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}