{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"MIC","translationId":"ckb_bib","name":"میخا","commonName":"میخا","title":"میخا","order":33,"numberOfChapters":7,"sha256":"27fc1aa8eb630bc0664b4753bd64cf731cc4d3e889e74f735ccfc62cfaaafa5d","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/ckb_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["سەرزەنشتی ڕابەران و پێغەمبەران"]},{"type":"verse","number":1,"content":["گوتم:",{"text":"«ئەی سەرکردەکانی یاقوب،","poem":1},{"text":"ئەی ڕابەرانی بنەماڵەی ئیسرائیل، گوێ بگرن.","poem":2},{"text":"ئایا بۆ ئێوە نییە زانینی دادپەروەری؟","poem":1}]},{"type":"verse","number":2,"content":[{"text":"ئێوە کە ڕقتان لە چاکەیە و حەز لە خراپە دەکەن،","poem":2},{"text":"پێستی گەلەکەم دادەماڵن و","poem":1},{"text":"گۆشتیان لە ئێسکەکانیان جیا دەکەنەوە؛","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئێوە کە گۆشتی گەلەکەم دەخۆن،","poem":1},{"text":"کەوڵیان دەکەن،","poem":2},{"lineBreak":true},{"text":"ئێسکیان دەشکێنن،","poem":2},{"text":"پارچەپارچەیان دەکەن وەک بۆ ناو مەنجەڵ،","poem":1},{"text":"وەک گۆشتی ناو تاوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ئینجا هاوار بۆ یەزدان دەکەن،","poem":1},{"text":"بەڵام وەڵامیان ناداتەوە.","poem":2},{"text":"لەو کاتەدا ڕووی خۆی لێیان دەشارێتەوە،","poem":1},{"text":"لەبەر ئەو خراپانەی کردیان.","poem":2}]},{"type":"verse","number":5,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«سەبارەت بە پێغەمبەرەکان،","poem":1},{"text":"ئەوانەی گەلەکەم گومڕا دەکەن،","poem":2},{"text":"بانگەوازی ئاشتی دەکەن","poem":1},{"text":"بۆ ئەوانەی تێریان دەکەن،","poem":2},{"text":"بەڵام جەنگ لە دژی ئەوانە بەرپا دەکەن","poem":1},{"text":"کە تێریان ناکەن.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لەبەر ئەوە شەوێکتان بەسەردا دێت کە هیچ بینینێکتان بۆ ئاشکرا ناکرێت،","poem":1},{"text":"تاریکییەکی بێ فاڵگرتنەوە.","poem":2},{"text":"خۆر لە پێغەمبەرەکان ئاوا دەبێت،","poem":1},{"text":"ڕۆژیان لێ تاریک دادێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"پێشبینیکەران شەرمەزار دەبن،","poem":1},{"text":"فاڵگرەوەکان ڕیسوا دەبن،","poem":2},{"text":"هەموویان چاوەڕوویان نەماوە،","poem":1},{"text":"چونکە خودا وەڵامیان ناداتەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"بەڵام سەبارەت بە من، پڕم لە هێز،","poem":1},{"text":"پڕ لە ڕۆحی یەزدان،","poem":2},{"lineBreak":true},{"text":"لە دادپەروەری و پاڵەوانیێتی،","poem":2},{"text":"تاکو یاخیبوونەکەی یاقوب بە خۆی ڕابگەیەنم،","poem":1},{"text":"بە ئیسرائیلیش گوناهەکەی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەی سەرکردەکانی بنەماڵەی یاقوب،","poem":1},{"text":"ڕابەرانی بنەماڵەی ئیسرائیل، گوێ لەمە بگرن،","poem":2},{"text":"ئێوە کە قێزتان لە دادپەروەری دەبێتەوە و","poem":1},{"text":"هەموو ڕاستییەک خواروخێچ دەکەن،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئێوە سییۆن بە خوێن بنیاد دەنێن و","poem":1},{"text":"ئۆرشەلیم بە ستەم.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ڕابەرەکانی بە بەرتیل دادوەری دەکەن،","poem":1},{"text":"کاهینەکانی بە کرێ خەڵکی فێردەکەن،","poem":2},{"lineBreak":true},{"text":"پێغەمبەرەکانی بە پارە فاڵ دەگرنەوە.","poem":2},{"text":"لەگەڵ ئەوەشدا پشت بە یەزدان دەبەستن و دەڵێن:","poem":1},{"text":"«ئایا یەزدان لەنێوانماندا نییە؟","poem":2},{"lineBreak":true},{"text":"هیچ بەڵایەکمان بەسەردا نایەت.»","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لەبەر ئەوە بەهۆی ئێوەوە","poem":1},{"text":"سییۆن وەک کێڵگە دەکێڵدرێت،","poem":2},{"text":"ئۆرشەلیم کاول دەبێت،","poem":1},{"text":"گردەکەی پەرستگاش دەبێتە دارستانێکی بێ کەڵک.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}