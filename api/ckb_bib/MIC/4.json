{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"MIC","translationId":"ckb_bib","name":"میخا","commonName":"میخا","title":"میخا","order":33,"numberOfChapters":7,"sha256":"27fc1aa8eb630bc0664b4753bd64cf731cc4d3e889e74f735ccfc62cfaaafa5d","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/ckb_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["کێوی یەزدان"]},{"type":"verse","number":1,"content":["لە ڕۆژانی کۆتاییدا،",{"text":"کێوی پەرستگای یەزدان","poem":1},{"text":"لەسەر لووتکەی چیاکان جێگیر دەبێت،","poem":2},{"text":"بەسەر گردەکانەوە بەرز دەبێتەوە و","poem":1},{"text":"گەلان بە لێشاو بەرەو لای ئەو دەچن.","poem":2}]},{"type":"verse","number":2,"content":["زۆرێک لە نەتەوەکان بەڕێ دەکەون و دەڵێن:",{"text":"«وەرن با بەرەو کێوی یەزدان سەربکەوین،","poem":1},{"text":"بۆ ماڵەکەی خودای یاقوب.","poem":2},{"text":"فێری ڕێگاکانی خۆیمان دەکات،","poem":1},{"text":"بۆ ئەوەی بە ڕێچکەی ئەودا بڕۆین.»","poem":2},{"text":"فێرکردن لە سییۆنەوە دەردەچێت،","poem":1},{"text":"پەیامی یەزدانیش لە ئۆرشەلیمەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لەنێو چەندین گەل دادوەری دەکات،","poem":1},{"text":"ناوبژی بۆ نەتەوە بەهێز و دوورەکان دەکات،","poem":2},{"text":"شمشێرەکانیان دەکوتنەوە و دەیکەنە گاسن،","poem":1},{"text":"ڕمەکانیشیان دەکەنە داس.","poem":2},{"text":"هیچ نەتەوەیەک شمشێر لە نەتەوەیەکی دیکە هەڵناکێشێت،","poem":1},{"text":"چیتر فێری جەنگ نابن.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"هەریەکە و لەژێر ڕەزەمێوەکەی و","poem":1},{"text":"لەژێر دار هەنجیرەکەی دادەنیشێت،","poem":2},{"text":"کەس نایترسێنێت،","poem":1},{"text":"چونکە یەزدانی سوپاسالار فەرموویەتی.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"هەر گەلێک ڕێگای خۆی دەگرێتەبەر،","poem":1},{"text":"هەریەکە و بە ناوی خوداوەندەکانی خۆیەوە؛","poem":2},{"text":"ئێمەش بە ناوی یەزدانی پەروەردگارمانەوە","poem":1},{"text":"بۆ هەتاهەتایە و هەتاسەر ڕێگا دەگرینەبەر.","poem":2}]},{"type":"heading","content":["پلانی یەزدان"]},{"type":"verse","number":6,"content":["یەزدان دەفەرموێت:",{"text":"«لەو ڕۆژەدا شەلەکان کۆدەکەمەوە و","poem":1},{"text":"ڕاپێچکراوەکان خڕدەکەمەوە،","poem":2},{"lineBreak":true},{"text":"هەروەها ئەوانەی سزام داون.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"شەلەکان دەکەمە پاشماوە،","poem":1},{"text":"دوورخراوەکانیش دەکەمە نەتەوەیەکی بەهێز.","poem":2},{"text":"یەزدانیش لە کێوی سییۆن پاشایەتییان دەکات","poem":1},{"text":"لەو کاتەوە و بۆ هەتاهەتایە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"تۆش ئەی تاوەری پاسەوانی مێگەل،","poem":1},{"text":"ئەی قەڵای سییۆنی کچ،","poem":2},{"text":"هەروەک پێشتر دەسەڵاتت بۆ دەگەڕێتەوە،","poem":1},{"text":"پاشایەتی ئۆرشەلیمی کچ.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئێستا بۆچی بە هاوارەوە دەگریت؟","poem":1},{"text":"بۆچی وەک ژانی منداڵبوون ژانت گرتووە؟","poem":2},{"text":"ئایا پاشات نییە،","poem":1},{"text":"یان ڕاوێژکارت مردووە؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەی سییۆنی کچ، لەبەر ژان بگەوزێ","poem":1},{"text":"وەک ژنی ژانگرتوو،","poem":2},{"text":"چونکە ئێستا لە شار دێیتە دەرەوە و","poem":1},{"text":"لە دەشتودەر چادر هەڵدەدەیت.","poem":2},{"text":"دەچیتە بابل،","poem":1},{"text":"لەوێ دەرباز دەکرێیت.","poem":2},{"text":"لەوێ یەزدان دەتکڕێتەوە","poem":1},{"text":"لە دەستی دوژمنەکانت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"بەڵام ئێستا، چەندین نەتەوە","poem":1},{"text":"لە دژی تۆ کۆدەبنەوە.","poem":2},{"text":"دەڵێن: «با گڵاو بێت،","poem":1},{"text":"با بە دیمەنی سییۆن دڵخۆش بین.»","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بەڵام ئەوان نازانن","poem":1},{"text":"بیرکردنەوەی یەزدان چییە،","poem":2},{"text":"هەروەها لە پلانی ئەو تێناگەن،","poem":1},{"text":"چونکە وەک مەڵۆی گەنم بۆ سەر جۆخین کۆی کردنەوە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"«ئەی سییۆنی کچ، هەستە و پێشێلی بکە،","poem":1},{"text":"چونکە قۆچی ئاسنینت پێ دەبەخشم.","poem":2},{"text":"سمی بڕۆنزت پێ دەبەخشم و","poem":1},{"text":"چەندین گەل تەفروتونا دەکەیت.»","poem":2},{"text":"دەستکەوتی ناڕەوایی ئەوان بۆ یەزدان تەرخان دەکەیت،","poem":1},{"text":"سامانیان بۆ پەروەردگاری هەموو جیهان.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}