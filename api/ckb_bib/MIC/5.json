{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"MIC","translationId":"ckb_bib","name":"میخا","commonName":"میخا","title":"میخا","order":33,"numberOfChapters":7,"sha256":"27fc1aa8eb630bc0664b4753bd64cf731cc4d3e889e74f735ccfc62cfaaafa5d","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/ckb_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["بەڵێنی دەرکەوتنی فەرمانڕەوایەک لە بێت‌لەحمەوە"]},{"type":"verse","number":1,"content":[{"text":"ئەی شاری سوپاکان، سوپاکانی خۆت کۆبکەرەوە،","poem":1},{"text":"چونکە گەمارۆ دراوین.","poem":2},{"text":"بە گۆچان لە ڕوومەتی","poem":1},{"text":"ڕابەری ئیسرائیل دەدەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«بەڵام تۆ ئەی بێت‌لەحمی ئەفراتە،","poem":1},{"text":"هەرچەندە لەنێو شارۆچکەکانی","poem":2},{"noteId":5},{"text":"یەهودا بچووکیت،","poem":2},{"text":"بەڵام یەکێک لە تۆوە بۆ من دەردەکەوێت","poem":1},{"text":"ئەوەی دەبێتە فەرمانڕەوای ئیسرائیل،","poem":2},{"text":"ڕەچەڵەکی لە دێرزەمانەوەیە،","poem":1},{"text":"لە ئەزەلەوەیە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"لەبەر ئەوە یەزدان گەلەکەی خۆی ڕادەستی دوژمن دەکات","poem":1},{"text":"هەتا ئەو کاتەی ئەوەی ژانی گرتووە منداڵی دەبێت،","poem":2},{"text":"پاشماوەی براکانیشی دەگەڕێنەوە","poem":1},{"text":"بۆ لای نەوەی ئیسرائیل.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"جا دەوەستێت و شوانایەتی گەلەکەی دەکات","poem":1},{"text":"بە هێزی یەزدان،","poem":2},{"lineBreak":true},{"text":"بە باڵادەستیی ناوی یەزدانی پەروەردگاری خۆی.","poem":2},{"text":"جا بە ئاسوودەیی دەژین،","poem":1},{"text":"چونکە لەو کاتە مەزنایەتی دەگاتە ئەوپەڕی زەوی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ئەو دەبێتە ئاشتی ئێمە،","poem":1},{"text":"کاتێک ئاشور هێرش بکاتە سەر خاکەکەمان و","poem":2},{"lineBreak":true},{"text":"پێ بنێتە ناو قەڵاکانمان.","poem":2},{"text":"حەوت شوانی لەسەر دادەنێین،","poem":1},{"text":"لەگەڵ هەشت میر.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بە شمشێر شوانایەتی خاکی ئاشور دەکەن و","poem":1},{"text":"خاکی نەمرودیش بە شمشێری هەڵکێشراو.","poem":2},{"text":"بەڵام لە ئاشور دەربازمان دەکات،","poem":1},{"text":"کاتێک هێرش دەکاتە سەر خاکەکەمان و","poem":2},{"lineBreak":true},{"text":"کاتێک پێ دەنێتە سنوورەکانمان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"پاشماوەی یاقوب لەنێو چەندین گەل دەبێت،","poem":1},{"text":"وەک شەونم لەلایەن یەزدانەوە،","poem":2},{"text":"وەک بارانی بە لێزمەی سەر گژوگیا،","poem":1},{"text":"ئەوەی چاوەڕوانی مرۆڤ ناکات و","poem":2},{"lineBreak":true},{"text":"بۆ ئادەمیزاد ناوەستێت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"پاشماوەی یاقوب لەنێو نەتەوەکان،","poem":1},{"text":"لەنێو چەندین گەل،","poem":2},{"text":"وەک شێر لەنێو دڕندەکانی دارستاندا،","poem":1},{"text":"وەک جوانە شێر لەنێو ڕانە مەڕدا،","poem":2},{"text":"ئەوەی بپەڕێتەوە دەیشێلێت و پەلاماری دەدات،","poem":1},{"text":"کەس نییە لە دەستی دەربازی بکات.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"دەستت بەسەر ناحەزانت زاڵ دەبێت و","poem":1},{"text":"هەموو دوژمنەکانت لەناودەچن.","poem":2}]},{"type":"verse","number":10,"content":["یەزدان دەفەرموێت:",{"text":"«لەو ڕۆژەدا ئەسپەکانت لەنێو خۆت لەناودەبەم و","poem":1},{"text":"گالیسکەکانت تێک دەشکێنم.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"شارەکانی خاکەکەت لەناودەبەم و","poem":1},{"text":"هەموو قەڵاکانت تێکدەدەم.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەو جادووگەرییەی کە دەیکەیت لەناوی دەبەم و","poem":1},{"text":"لەمەودوا ناتوانیت نوشتە بکەیت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بتە داتاشراوەکانت لەناودەبەم و","poem":1},{"text":"لەگەڵ هەموو بەردە تەرخانکراوەکانت","poem":2},{"noteId":6},{"text":"لە ناوەڕاستت،","poem":2},{"text":"ئیتر کڕنۆش نابەیت","poem":1},{"text":"بۆ دەستکردی دەستەکانت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ستوونە ئەشێراکانت","poem":1},{"noteId":7},{"text":"لەنێوتدا هەڵدەکێشم و","poem":1},{"text":"شارەکانت وێران دەکەم.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بە تووڕەیی و هەڵچوونەوە تۆڵە دەکەمەوە","poem":1},{"text":"لەو گەلانەی گوێڕایەڵی من نەبوون.»","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"یان: هۆزەکانی یەهودا.‏","reference":{"chapter":5,"verse":2}},{"noteId":6,"caller":"+","text":"بەردی بە ستوونی دانراو بۆ پەرستن. بڕوانە دواوتار 16‏:21‏-22.‏","reference":{"chapter":5,"verse":13}},{"noteId":7,"caller":"+","text":"ستوونە ئەشێرا: هێمای خواژنە. بڕوانە یەکەم پاشایان 11‏:5‏‏.‏","reference":{"chapter":5,"verse":14}}]},"thisChapterLink":"/api/ckb_bib/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}