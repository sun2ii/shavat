{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"MIC","translationId":"ckb_bib","name":"میخا","commonName":"میخا","title":"میخا","order":33,"numberOfChapters":7,"sha256":"27fc1aa8eb630bc0664b4753bd64cf731cc4d3e889e74f735ccfc62cfaaafa5d","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/ckb_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"heading","content":["سکاڵای یەزدان لە دژی ئیسرائیل"]},{"type":"verse","number":1,"content":["گوێ بگرن لەوەی یەزدان دەفەرموێت:",{"text":"«هەستە، بڕۆ لەلای چیاکانەوە سکاڵا بکە،","poem":1},{"text":"با گردەکان گوێیان لێبێت کە چی دەڵێیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«ئەی چیاکان، گوێ لە سکاڵای یەزدان بگرن،","poem":1},{"text":"ئەی بناغە هەمیشەییەکانی زەوی، ئێوەش گوێ بگرن!","poem":2},{"text":"چونکە سکاڵای یەزدان لە گەلەکەیەتی،","poem":1},{"text":"داواکەی لە دژی ئیسرائیلە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«ئەی گەلەکەم، چیم لێت کردووە؟","poem":1},{"text":"بە چی نیگەرانم کردوویت؟ وەڵامم بدەوە!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"من لە خاکی میسرەوە دەرمهێنایت،","poem":1},{"text":"لە خاکی کۆیلایەتی تۆم کڕییەوە.","poem":2},{"text":"من موسام بۆ ناردی ڕابەرایەتیت بکات،","poem":1},{"text":"هەروەها هارون و مریەمیش.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەی گەلەکەم، بیهێنەرەوە یادت","poem":1},{"text":"بالاقی پاشای مۆئاب پیلانی چی گێڕا و","poem":2},{"lineBreak":true},{"text":"بەلعامی کوڕی بەعۆر چی وەڵام دایەوە.","poem":2},{"text":"گەشتەکەت لە شەتیمەوە هەتا گلگال بهێنەرەوە یادت،","poem":1},{"text":"تاکو کارە ڕاستودروستەکانی یەزدان بزانیت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"بە چی بچمە بەردەمی یەزدان و","poem":1},{"text":"بۆ خودای پایەبەرز بچەمێمەوە؟","poem":2},{"text":"ئایا بە قوربانی سووتاندن بچمە بەردەمی،","poem":1},{"text":"بە گوێرەکەی تەمەن یەک ساڵە؟","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئایا یەزدان بە هەزاران بەران و","poem":1},{"text":"بە دەیان هەزار ڕووبار لە ڕۆن ڕازی دەبێت؟","poem":2},{"text":"ئایا نۆبەرەکەم لە جیاتی یاخیبوونەکەم بدەم،","poem":1},{"text":"بەری لەشم لە جیاتی گوناهی خۆم؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەی مرۆڤ، یەزدان پێی ڕاگەیاندیت کە چی چاکە و","poem":1},{"text":"داوای چیت لێدەکات:","poem":2},{"text":"دادوەری بەجێبهێنە و حەزت لە خۆشەویستی نەگۆڕ بێت و","poem":1},{"text":"بە بێفیزی لەگەڵ خوداکەت هاتوچۆ بکەیت.","poem":2}]},{"type":"heading","content":["تاوان و سزای ئیسرائیل"]},{"type":"verse","number":9,"content":[{"text":"ئەگەر ئێوە دانان لە ناوی خودا بترسن!","poem":1},{"text":"دەنگی یەزدان بانگەواز بۆ شارەکە دەکات:","poem":2},{"lineBreak":true},{"text":"«ئەی گەل و ئەوانەی لە شار کۆدەبنەوە، گوێ بگرن!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەی ماڵی خراپەکار، ئایا هێشتا گەنجینەی داهاتی ناڕەواییتان لەبیر دەکەم؟","poem":1},{"text":"ئایا ئێفەی","poem":2},{"noteId":8},{"text":"ناتەواو کە نەفرەت لێکراوە لەیادی دەکەم؟","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئایا ئەوانەی تەرازوویان درۆیە بێتاوانیان دەکەم،","poem":1},{"text":"ئەوانەی فێڵ لە توورەکەی کێش دەکەن؟","poem":2}]},{"type":"verse","number":12,"content":[{"text":"دەوڵەمەندەکانی ستەمکارن،","poem":1},{"text":"دانیشتووانەکەشی قسەی درۆ دەکەن و","poem":2},{"lineBreak":true},{"text":"بە زمانیان فێڵ دەکەن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لەبەر ئەوە خەریکم سزاتان دەدەم،","poem":1},{"text":"لەبەر گوناهەکانتان وێرانتان دەکەم.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئێوە دەخۆن و تێر نابن،","poem":1},{"text":"گەدەتان هەردەم بەتاڵ دەبێت.","poem":2},{"text":"ئەمبار دەکەن، بەڵام هیچ نامێنێتەوە،","poem":1},{"text":"چونکە ئەوەی مایەوە دەیدەمە شمشێر.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئێوە دەچێنن و نادورنەوە،","poem":1},{"text":"زەیتوون دەگوشن و بە ڕۆنەکەی خۆتان چەور ناکەن،","poem":2},{"lineBreak":true},{"text":"ترێ دەگوشن و لە شەرابەکەی ناخۆنەوە،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"چونکە فەرزەکانی عۆمری","poem":1},{"noteId":9},{"text":"و","poem":1},{"text":"هەموو نەریتەکانی بنەماڵەی ئەحاڤتان بەجێهێناوە و","poem":2},{"lineBreak":true},{"text":"ڕێگای ڕاوێژەکانی ئەوانتان گرتووەتەبەر.","poem":2},{"text":"لەبەر ئەوە وێرانتان دەکەم و","poem":1},{"text":"دانیشتووانەکەت دەکەمە مایەی گاڵتەجاڕی و","poem":2},{"lineBreak":true},{"text":"تانە و تەشەری نەتەوەکان.»","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"ئێفە یەکەیەکی کێشە، بیست و دوو لیتر بوو.‏","reference":{"chapter":6,"verse":10}},{"noteId":9,"caller":"+","text":"عۆمری باوکی ئەحاڤ بوو، هەردووکیان گەلی خودایان بۆ بتپەرستی هاندا. بڕوانە 1 پاشایان 16‏:23‏-26.‏","reference":{"chapter":6,"verse":16}}]},"thisChapterLink":"/api/ckb_bib/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}