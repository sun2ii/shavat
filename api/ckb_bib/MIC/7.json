کە و","poem":1},{"text":"ڕاستترینیان وەک پەرژینی دڕکە.","poem":2},{"text":"ڕۆژی سزادانی خودا بۆ تۆ هات،","poem":1},{"text":"ئەو ڕۆژەی کە چاودێرەکانت","poem":2},{"noteId":10},{"text":"هاوار دەکەن بۆ ئاگادارکردنەوە.","poem":2},{"lineBreak":true},{"text":"ئێستا کاتی سەرلێشێواندنی ئێوەیە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"متمانە بە برادەر مەکە و","poem":1},{"text":"پشت بە دۆست مەبەستە.","poem":2},{"text":"نهێنیت بپارێزە","poem":1},{"text":"تەنانەت لە ژنەکەشت کە لە باوەشت پاڵکەوتووە،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"چونکە کوڕ سووکایەتی بە باوکی دەکات،","poem":1},{"text":"کچ لە دایکی ڕاستدەبێتەوە،","poem":2},{"text":"بووک لە خەسووی؛","poem":1},{"text":"دوژمنی مرۆڤ لە خانەوادەکەی خۆی دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"بەڵام من چاوم لەسەر یەزدان دەبێت،","poem":1},{"text":"چاوەڕوانی خودای ڕزگاریم دەکەم،","poem":2},{"lineBreak":true},{"text":"خودام گوێم لێ دەگرێت.","poem":2}]},{"type":"heading","content":["ئیسرائیل هەڵدەستێتەوە"]},{"type":"verse","number":8,"content":[{"text":"ئەی دوژمنەکەم، بە نسکۆی من دڵخۆش نەبیت!","poem":1},{"text":"چونکە ئەگەر بکەوم، هەڵدەستمەوە،","poem":2},{"text":"ئەگەر لە تاریکیدا دانیشم،","poem":1},{"text":"یەزدان ڕووناکییە بۆم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"لەبەر ئەوەی لە دژی ئەو گوناهم کرد،","poem":1},{"text":"بەرگەی تووڕەیی یەزدان دەگرم،","poem":2},{"text":"هەتا بەرگری لە داواکەم دەکات و","poem":1},{"text":"مافی من دێتە دی.","poem":2},{"text":"دەمهێنێتە دەرەوە بۆ ناو ڕووناکی،","poem":1},{"text":"ڕاستودروستی ئەو دەبینم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئینجا دوژمنەکەم تەماشا دەکات و","poem":1},{"text":"شەرمەزاری دایدەپۆشێت،","poem":2},{"text":"ئەوەی پێی دەگوتم:","poem":1},{"text":"«کوا یەزدانی پەروەردگارت؟»","poem":2},{"text":"چاوەکانم تەماشای کەوتنی دەکەن،","poem":1},{"text":"تەنانەت ئێستاش دەشێلرێت","poem":2},{"lineBreak":true},{"text":"وەک قوڕی شەقامەکان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ڕۆژی بنیادنانی دیوارەکانت دێت،","poem":1},{"text":"ڕۆژی فراوانکردنی سنوورەکانت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لەو ڕۆژەدا خەڵک دێنە لات،","poem":1},{"text":"لەلای ئاشور و لە شارەکانی میسرەوە،","poem":2},{"text":"تەنانەت لە میسرەوە هەتا فورات","poem":1},{"text":"لە دەریاوە بۆ دەریا و","poem":2},{"lineBreak":true},{"text":"لە چیاوە بۆ چیا.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"زەوی لەبەر دانیشتووانەکەی وێران دەبێت،","poem":1},{"text":"بەهۆی کردەوەکانیان.","poem":2}]},{"type":"heading","content":["نوێژ و ستایشکردن"]},{"type":"verse","number":14,"content":[{"text":"بە گۆچانەکەت شوانایەتی گەلەکەت بکە،","poem":1},{"text":"مێگەلی میراتەکەت،","poem":2},{"text":"ئەوەی بە تەنها لە دارستان نیشتەجێیە","poem":1},{"text":"لە ناوەڕاستی ڕەزەکان.","poem":2},{"text":"با لە باشان و گلعاد بلەوەڕێن","poem":1},{"text":"وەک ڕۆژگاری کۆن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«وەک ڕۆژانی هاتنەدەرەوەت لە خاکی میسر،","poem":1},{"text":"کاری سەرسوڕهێنەریان نیشان دەدەم.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"نەتەوەکان تەماشا دەکەن و شەرمەزار دەبن،","poem":1},{"text":"سەرباری هەموو پاڵەوانییەتییەکەیان.","poem":2},{"text":"دەست دەخەنە سەر دەمیان","poem":1},{"text":"گوێیان کەڕ دەبێت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"وەک مار خۆڵ دەلێسنەوە،","poem":1},{"text":"وەک خشۆکەکانی زەوی.","poem":2},{"text":"بە لەرزەوە لە قەڵاکانیان دێنە دەرەوە،","poem":1},{"text":"بۆ لای یەزدانی پەروەردگارمان دێن و دەتۆقن،","poem":2},{"lineBreak":true},{"text":"لە تۆ دەترسن.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"کێ خودایەکی وەک تۆیە،","poem":1},{"text":"کە لە تاوان دەبوورێت و","poem":2},{"lineBreak":true},{"text":"لە یاخیبوونی پاشماوەی گەلەکەت خۆشدەبێت؟","poem":2},{"text":"هەتاسەر تووڕەیی خۆت هەڵناگریت،","poem":1},{"text":"چونکە بە خۆشەویستییە نەگۆڕەکەت دڵخۆشیت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"دەگەڕێیتەوە و بەزەییت پێماندا دێتەوە،","poem":1},{"text":"تاوانەکانمان دەخەیتە ژێر پێتەوە و","poem":2},{"lineBreak":true},{"text":"هەموو گوناهەکانمان فڕێدەدەیتە ناو قووڵایی دەریا.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"دڵسۆزی بۆ یاقوب پیشان دەدەیت،","poem":1},{"text":"خۆشەویستی نەگۆڕ بۆ ئیبراهیم،","poem":2},{"text":"ئەوەی سوێندت بۆ باوباپیرانمان خوارد","poem":1},{"text":"هەروەک ڕۆژگاری کۆن.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"مەبەست لە پێغەمبەرەکان.‏","reference":{"chapter":7,"verse":4}}]},"thisChapterLink":"/api/ckb_bib/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}