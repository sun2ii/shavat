{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"NAM","translationId":"ckb_bib","name":"ناحوم","commonName":"ناحوم","title":"ناحوم","order":34,"numberOfChapters":3,"sha256":"ed0daeb6aa35b0574c293349b30ebd34d2f10eeec903e0abab4ae3afefb4c8a4","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ckb_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["سروشێک",{"noteId":0},"سەبارەت بە نەینەوا، پەڕتووکی بینینەکەی ناحومی ئەلقۆشی:"]},{"type":"heading","content":["تووڕەیی خودا لە دژی نەینەوا"]},{"type":"verse","number":2,"content":[{"text":"یەزدان خودایەکی ئیرەدار","poem":1},{"noteId":1},{"text":"و تۆڵەسێنەرە،","poem":1},{"text":"یەزدان تۆڵەسێنەر و زۆر تووڕەیە.","poem":2},{"text":"یەزدان تۆڵەسێنەرە لە ناحەزانی و","poem":1},{"text":"هەڵچوونی لە دژی دوژمنانی بەردەوامە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"یەزدان پشوودرێژە و توانای مەزنە،","poem":1},{"text":"بەڵام چاو لە گوناه ناپۆشێت.","poem":2},{"text":"ڕێگای یەزدان لەناو گەردەلوول و ڕەشەبادایە،","poem":1},{"text":"هەور تۆزی پێیەکانیەتی.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"دەریا سەرزەنشت دەکات و وشکی دەکات،","poem":1},{"text":"هەموو ڕووبارەکان بێ ئاو دەکات.","poem":2},{"text":"باشان و کارمەل سیس دەکات،","poem":1},{"text":"خونچەی لوبنان سیس دەبێت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"چیاکان لەبەر ئەو دەلەرزن و","poem":1},{"text":"گردەکان دەتوێنەوە.","poem":2},{"text":"زەوی لە ئامادەبوونی ئەو دەهەژێت،","poem":1},{"text":"جیهان و هەموو دانیشتووانەکەی.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"کێ لەبەردەم تووڕەیی ئەو خۆی ڕادەگرێت؟","poem":1},{"text":"کێ بەرگەی جۆشی تووڕەیی ئەو دەگرێت؟","poem":2},{"text":"هەڵچوونی وەک ئاگر دەڕژێت و","poem":1},{"text":"تاشەبەردەکان لەبەردەمی دەشکێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"یەزدان چاکە،","poem":1},{"text":"لە ڕۆژی تەنگانە قەڵایە.","poem":2},{"text":"بایەخ بەوانە دەدات کە پشتی پێ دەبەستن،","poem":1}]},{"type":"verse","number":8,"content":[{"text":"بەڵام بە تۆفانێکی گەورە","poem":2},{"text":"بە تەواوی کۆتایی بە نەینەوا دەهێنێت،","poem":1},{"text":"دوژمنەکانی بەرەو تاریکی ڕاودەنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"بیر لە چی دەکەنەوە لە دژی یەزدان؟","poem":1},{"text":"ئەو کۆتایی پێدەهێنێت،","poem":2},{"lineBreak":true},{"text":"کارەسات دوو جار بەرپا نابێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەوان وەک دڕک لێک دەئاڵێن،","poem":1},{"text":"بە شەرابەکەیان سەرخۆش دەبن،","poem":2},{"lineBreak":true},{"text":"هەموویان وەک کای وشک دەسووتێن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەی نەینەوا، یەکێک لە تۆوە دەردەکەوێت،","poem":1},{"text":"ئەوەی بیر لە خراپە دەکاتەوە لە دژی یەزدان،","poem":2},{"lineBreak":true},{"text":"ڕاوێژکاری بەدکارییە.","poem":2}]},{"type":"verse","number":12,"content":["یەزدان ئەمە دەفەرموێت:",{"text":"«هەرچەندە بەهێز و زۆریشن،","poem":1},{"text":"بەڵام دەبڕێنەوە و بەسەردەچن.","poem":2},{"text":"ئەی یەهودا، هەرچەندە زەلیلم کردیت","poem":1},{"text":"بەڵام ئیتر زەلیلت ناکەم.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئێستاش ئەو نیرەی","poem":1},{"noteId":2},{"text":"کە لەسەر تۆی دایانناوە دەیشکێنم،","poem":1},{"text":"کۆتەکانت لێ دەکەمەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ئەی نەینەوا، یەزدان سەبارەت بە تۆ فەرمانی داوە:","poem":1},{"text":"«هیچ نەوەیەک نامێنێت ناوی تۆی هەڵگرتبێت.","poem":2},{"text":"بتە داتاشراو و لەقاڵبدراوەکان","poem":1},{"text":"لە پەرستگای خوداوەندەکانت ڕیشەکێش دەکەم.","poem":2},{"lineBreak":true},{"text":"گۆڕت بۆ هەڵدەکەنم، چونکە تۆ شایانی ژیان نیت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ئەوەتا لەسەر چیاکانە","poem":1},{"text":"پێیەکانی مزگێنیدەر،","poem":2},{"lineBreak":true},{"text":"ئاشتی ڕادەگەیەنێت!","poem":2},{"text":"ئەی یەهودا، جەژنەکانت بگێڕە،","poem":1},{"text":"نەزرەکانت","poem":2},{"noteId":3},{"text":"بەجێبهێنە،","poem":2},{"text":"ئیتر بەدکاران داگیرت ناکەن،","poem":1},{"text":"بەڵکو بە تەواوی بنبڕ دەبن.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"فەرموودەیەکی خودایە کە لە ڕێگای ڕۆحی پیرۆزەوە بۆ مرۆڤ هاتبێت.‏","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"+","text":"ئیرەدار: لێرەدا واتایەکی ئەرێنی لەخۆ دەگرێت، چونکە خودا مرۆڤی خۆشدەوێت و نایەوێت کەسێک پەیوەندی نێوانیان تێک بدات.","reference":{"chapter":1,"verse":2}},{"noteId":2,"caller":"+","text":"مەبەستی لە بارگرانییە.‏","reference":{"chapter":1,"verse":13}},{"noteId":3,"caller":"+","text":"نەزر: داوا لە خودا دەکرێت بۆ ئەنجامدانی کارێک و پابەند دەکرێت بە مەرجێکەوە. ئەگەر خودا ئەو کارە بکات، ئەوا دەرئەنجام ئەمیش ئەو کارە ئەنجام دەدات کە پێیەوە پابەندی کردووە. بڕوانە سەرژمێری 21‏:2‏‏.‏","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/ckb_bib/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}