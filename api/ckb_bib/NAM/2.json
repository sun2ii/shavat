{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"NAM","translationId":"ckb_bib","name":"ناحوم","commonName":"ناحوم","title":"ناحوم","order":34,"numberOfChapters":3,"sha256":"ed0daeb6aa35b0574c293349b30ebd34d2f10eeec903e0abab4ae3afefb4c8a4","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ckb_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["پاشایەتی نەینەوا دەڕووخێنرێت"]},{"type":"verse","number":1,"content":[{"text":"ئەی نەینەوا، پەلاماردەر لە دژی تۆ هات.","poem":1},{"text":"قەڵاکە بپارێزە،","poem":2},{"lineBreak":true},{"text":"چاودێری ڕێگاکە بکە،","poem":2},{"lineBreak":true},{"text":"بازووی لێ هەڵبکە،","poem":2},{"lineBreak":true},{"text":"توانای زۆر بخەرە گەڕ!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"یەزدان سەروەری یاقوب دەگەڕێنێتەوە","poem":1},{"text":"وەک سەروەری ئیسرائیل،","poem":2},{"text":"هەرچەندە تاڵانکەران تاڵانیان کردن و","poem":1},{"text":"ڕەزەمێوەکانیان تێکدان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"قەڵغانی پاڵەوانەکانی ئاڵ هەڵگەڕاون،","poem":1},{"text":"قارەمانەکانی لە بەرگی سووردان،","poem":2},{"text":"لە ڕۆژی خۆ ئامادەکردنیاندا","poem":1},{"text":"پۆڵای گالیسکەکان بریسکە دەداتەوە،","poem":2},{"lineBreak":true},{"text":"ئەو ڕمانەی لە دار سنەوبەر دروستکراون دەلەرنەوە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"گالیسکەکان لە شەقامەکان تیژڕەون،","poem":1},{"text":"لە گۆڕەپانەکان سەرەڕۆن.","poem":2},{"text":"دیمەنیان وەک مەشخەڵە،","poem":1},{"text":"وەک بروسک غار دەدەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"نەینەوا پاڵەوانەکانی بانگ دەکات،","poem":1},{"text":"بەڵام ساتمە دەکەن و لە ڕۆیشتنیاندا دەکەون.","poem":2},{"text":"پەلە دەکەن بۆ لای شووراکانی و","poem":1},{"text":"قەڵغانەکان ئامادە کراون.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"دەروازەکانی ڕووبار دەکرێنەوە و","poem":1},{"text":"کۆشکەکە دەڕمێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بە فەرمانی خودا بە دیل دەگیرێت و","poem":1},{"text":"ڕاپێچ دەکرێت.","poem":2},{"text":"کەنیزەکانی هەروەک کۆتر دەگمێنن،","poem":1},{"text":"سنگیان دەکوتن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"نەینەوا وەک حەوزێکی وشکبووە.","poem":1},{"text":"هاوار دەکەن، «ڕاوەستن! ڕاوەستن!»","poem":2},{"lineBreak":true},{"text":"بەڵام کەس ئاوڕ ناداتەوە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"«زیو تاڵان بکەن!","poem":1},{"text":"زێڕ تاڵان بکەن!","poem":2},{"text":"گەنجینەکانی لەبن نایەن،","poem":1},{"text":"پڕە لە گەوهەری بەهادار.»","poem":2}]},{"type":"verse","number":10,"content":[{"text":"چۆڵ و تاڵانکراو و داماڵراوە،","poem":1},{"text":"دڵ دەتوێتەوە و ئەژنۆکان شلن،","poem":2},{"lineBreak":true},{"text":"هەموویان دەلەرزن، ڕەنگیان دەپەڕێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"کوا لانەی شێرەکان،","poem":1},{"text":"لەوەڕگای بەچکە شێران؟","poem":2},{"text":"لەوێدا شێر و شێرە مێ دەگەڕان","poem":1},{"text":"لەگەڵ بەچکە شێر، هیچ شتێک نەیدەترساندن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"شێر بۆ پێویستی بەچکەکانی پەلاماری دەدا و","poem":1},{"text":"نێچیرەکەی بۆ شێرە مێیەکەی دەخنکاند،","poem":2},{"text":"ئەشکەوتەکەی پڕ دەکرد لە نێچیر،","poem":1},{"text":"لانەکانیشی لەوانەی پەلاماری داون.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"یەزدانی سوپاسالار دەفەرموێت:","poem":1},{"text":"«من لە دژی تۆم.","poem":2},{"text":"گالیسکەکانت دەسووتێنم و دەبنە دووکەڵ،","poem":1},{"text":"بەچکە شێرەکانیشت شمشێر دەیانخوات و","poem":2},{"text":"نێچیرت لەسەر زەوی لێ دەبڕم.","poem":1},{"text":"ئیتر دەنگی نێردراوەکانت نابیسترێن.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}