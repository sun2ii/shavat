{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"NUM","translationId":"ckb_bib","name":"سەرژمێری","commonName":"سەرژمێری","title":"سەرژمێری چوارەم پەڕتووکی موسا","order":4,"numberOfChapters":36,"sha256":"44a074e8650717e101d967184d6b36eb001320054b1d87bd2f906c9cf59ded77","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/ckb_bib/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["کاتێک بەلعام بینی لەبەرچاوی یەزدان پەسەندە کە ئیسرائیل بەرەکەتدار بکات، وەک جاری یەکەم و دووەم بەڕێ نەکەوت بۆ جادووگەری، بەڵکو ڕووی لە چۆڵەوانی کرد."]},{"type":"verse","number":2,"content":["کاتێک بەلعام چاوی هەڵبڕی نەوەی ئیسرائیلی بینی هۆز لەتەنیشت هۆز چادریان هەڵداوە، ڕۆحی خوداش هاتە سەری،"]},{"type":"verse","number":3,"content":["ئیتر پەیامەکەی ڕاگەیاند و گوتی:",{"text":"«پەیامەکەی بەلعامی کوڕی بەعۆر،","poem":1},{"text":"پەیامەکەی ئەو پیاوەی چاوی کراوەیە،","poem":2}]},{"type":"verse","number":4,"content":[{"text":"پەیامی ئەوەی گوێی لە وشەکانی خودایە،","poem":1},{"text":"ئەوەی خودای هەرە بەتوانا بینینی بۆ ئاشکرا دەکات،","poem":2},{"lineBreak":true},{"text":"ئەوەی بەسەر ڕوودا دەکەوێت، بەڵام چاو کراوەیە:","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«ئەی یاقوب، چادرەکانت چەند جوانن،","poem":1},{"text":"ئەی ئیسرائیل، نشینگەکانت چەند خۆشن!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«وەک ئەو دۆڵانەی درێژ بوونەتەوە،","poem":1},{"text":"وەک باخچەی کەناری ڕووبار،","poem":2},{"text":"وەک ئەو درەختە ئەلوایانەی","poem":1},{"noteId":58},{"text":"کە یەزدان چاندبێتی،","poem":1},{"text":"وەک ئورزی قەراغی ئاو،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"گۆزەکانی ئاویان لێ دەڕژێت و","poem":1},{"text":"تۆوی ئەوان لەسەر ئاوی زۆر دەبێت.","poem":2},{"lineBreak":true},{"text":"«پاشای لە ئەگاگ باڵاتر دەبێت و","poem":1},{"text":"شانشینەکەی پایەدار دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«خودا لە میسر دەریهێنان،","poem":1},{"text":"وەک شاخی گای کێوییە بۆیان،","poem":2},{"text":"ئەو نەتەوانەی ناحەزی دەکەن دەیانخۆن و","poem":1},{"text":"ئێسکیان تێکدەشکێنن و","poem":2},{"lineBreak":true},{"text":"بە تیرەکانیان دەیانبڕن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"خۆیان وەک شێر ماتداوە و ڕاکشاون،","poem":1},{"text":"وەک شێرە مێ، کێ هەڵیاندەستێنێت؟","poem":2},{"lineBreak":true},{"text":"«بەرەکەتدار بن ئەوانەی بەرەکەتدارتان دەکەن،","poem":1},{"text":"نەفرەت لێکراو بن ئەوانەی نەفرەتتان لێ دەکەن.»","poem":2}]},{"type":"verse","number":10,"content":["ئینجا تووڕەیی بالاق بەسەر بەلعامەوە گڕی گرت، چەپڵەی لێدا و بە بەلعامی گوت: «بۆ نەفرەتکردن لە دوژمنەکانم بانگم کردوویت، کەچی تۆ سێ جار داوای بەرەکەتت بۆ کردن،"]},{"type":"verse","number":11,"content":["ئێستاش بگەڕێوە شوێنی خۆت، گوتم پاداشتێکی گەورەت دەکەم، بەڵام یەزدان ڕێگری لێ کردیت کە پاداشتەکەت وەربگریت.»"]},{"type":"verse","number":12,"content":["بەلعامیش بە بالاقی گوت: «ئەی من بە نێردراوەکانتم نەگوت کە بۆ لای منت ناردبوون،"]},{"type":"verse","number":13,"content":["”ئەگەر بالاق بە پڕی خانووەکەی زێڕ و زیوم پێبدات ناتوانم لە فەرمانی یەزدان دەربچم، بۆ ئەوەی لە خۆمەوە چاکەیەک یان خراپەیەک بکەم، ئەوەی یەزدان بیڵێت ئەوە دەڵێم؟“"]},{"type":"verse","number":14,"content":["ئێستاش وا من بۆ لای گەلەکەم بەڕێ دەکەوم، بەڵام وەرە با پێت بڵێم کە ئەم گەلە لە دوارۆژدا چی لە گەلەکەت دەکات.»"]},{"type":"heading","content":["چوارەم پەیامی بەلعام"]},{"type":"verse","number":15,"content":["ئیتر پەیامەکەی ڕاگەیاند و گوتی:",{"text":"«پەیامی بەلعامی کوڕی بەعۆر،","poem":1},{"text":"پەیامی ئەو پیاوەی چاوی کراوەیە،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"پەیامی ئەوەی گوێی لە وشەکانی خودایە،","poem":1},{"text":"کە زانینی هەیە لە هەرەبەرزەوە،","poem":2},{"text":"ئەوەی خودای هەرە بەتوانا بینینی بۆ ئاشکرا دەکات،","poem":1},{"text":"ئەوەی بەسەر ڕوودا دەکەوێت، بەڵام چاوی کراوەیە:","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«دەیبینم، بەڵام ئێستا نا،","poem":1},{"text":"چاوم پێی دەکەوێت، بەڵام بەم نزیکانە نا.","poem":2},{"text":"ئەستێرەیەک لە یاقوب دەردەکەوێت و","poem":1},{"text":"داردەستێک لە ئیسرائیل هەڵدەستێت.","poem":2},{"text":"ناوچەوانی مۆئاب دەشکێنێت،","poem":1},{"text":"کاسەسەری هەموو نەوەی شیت","poem":2},{"noteId":59},{"text":"تێکدەشکێنێت.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئەدۆم داگیر دەکرێت،","poem":1},{"text":"سێعیری دوژمنیشی دەبێتە خاوەندار،","poem":2},{"lineBreak":true},{"text":"بەڵام ئیسرائیل قارەمانیێتی دەنوێنێت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەوەی لە یاقوبەوەیە دەسەڵاتدار دەبێت،","poem":1},{"text":"بەجێماوەکان لە شار لەناودەبات.»","poem":2}]},{"type":"heading","content":["پێنجەم پەیامی بەلعام"]},{"type":"verse","number":20,"content":["ئینجا بەلعام عەمالێقی بینی و پەیامەکەی ڕاگەیاند و گوتی:",{"text":"«عەمالێق یەکەمی نەتەوەکان بوو،","poem":1},{"text":"بەڵام کۆتاییەکەی لەناوچوونە.»","poem":2}]},{"type":"verse","number":21,"content":["ئینجا قێنییەکانی بینی و پەیامەکەی پێ ڕاگەیاندن و گوتی:",{"text":"«نشینگەکەتان پتەوە و","poem":1},{"text":"هێلانەکەتان لەناو تاشەبەردە،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بەڵام ئەی قێنییەکان، ئێوە وێران دەبن،","poem":1},{"text":"کاتێک ئەشوورییەکان بە دیلتان دەگرن.»","poem":2}]},{"type":"verse","number":23,"content":["ئیتر پەیامەکەی ڕاگەیاند و گوتی:",{"text":"«ئای کێ دەژیێت کاتێک خودا ئاوا دەکات،","poem":1}]},{"type":"verse","number":24,"content":[{"text":"لەلای کەنارەکانی کیتیمەوە","poem":2},{"noteId":60},{"text":"کەشتییەکان دێن و","poem":2},{"text":"ئەشوور و عێبەر ژێردەستە دەکات،","poem":1},{"text":"بەڵام ئەوانیش بۆ لەناوچوونن.»","poem":2}]},{"type":"verse","number":25,"content":["ئینجا بەلعام هەستا و بەڕێکەوت و گەڕایەوە شوێنی خۆی، بالاقیش بە ڕێگای خۆیدا ڕۆیشت."]}],"footnotes":[{"noteId":58,"caller":"+","text":"ڕووەکێکی دڕکاوییە وەک (سەباڕ)، شلەیەکی تێدایە بۆ پێست باشە.‏","reference":{"chapter":24,"verse":6}},{"noteId":59,"caller":"+","text":"نەوەی شیت کوڕی ئادام، واتا گەلی مۆئاب.‏","reference":{"chapter":24,"verse":17}},{"noteId":60,"caller":"+","text":"قوبرس و کەنارەکانی ڕۆژئاوای.‏","reference":{"chapter":24,"verse":24}}]},"thisChapterLink":"/api/ckb_bib/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}