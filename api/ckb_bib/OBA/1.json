{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"OBA","translationId":"ckb_bib","name":"عۆبەدیا","commonName":"عۆبەدیا","title":"عۆبەدیا","order":31,"numberOfChapters":1,"sha256":"a5dd1dbc9cc29f209ad450dfd96aef32b373365e359fa55b11409076a27206cb","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/ckb_bib/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"heading","content":["بینینەکەی عۆبەدیا"]},{"type":"verse","number":1,"content":["بینینەکەی عۆبەدیا.",{"lineBreak":true},"یەزدانی باڵادەست سەبارەت بە ئەدۆم ئەمە دەفەرموێت،",{"text":"هەواڵێکمان لەلایەن یەزدانەوە بیست،","poem":1},{"text":"نێردراوێک بۆ نەتەوەکان نێردراوە تاکو پێیان بڵێت:","poem":2},{"text":"«هەستن! هەستن بۆ جەنگ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«ئێستا لەنێو گەلاندا بچووکت دەکەمەوە،","poem":1},{"text":"تۆ زۆر ڕیسوا دەبیت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"فیزی دڵت هەڵیخەڵەتاندی،","poem":1},{"text":"ئەی نیشتەجێی نێو کەلێنی تاشەبەرد","poem":2},{"noteId":0},{"text":"،","poem":2},{"lineBreak":true},{"text":"ئەوەی نشینگەکەت لە بەرزاییدایە،","poem":2},{"text":"ئەوەی لە دڵی خۆتدا دەڵێیت:","poem":1},{"text":"”کێ دامدەگرێتە سەر زەوی؟“","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەگەر وەک هەڵۆ بەرز بیتەوە و","poem":1},{"text":"ئەگەر هێلانەت لەناو ئەستێرەکان دابنێیت،","poem":2},{"lineBreak":true},{"text":"لەوێوە دەتهێنمە خوارەوە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"«ئەگەر دز یان چەتەی شەوانت بۆ بێت،","poem":1},{"lineBreak":true},{"text":"ئایا تەنها ئەوەی پێویستیان بێت نایدزن؟","poem":1},{"text":"ئەگەر ڕەزبڕت","poem":2},{"noteId":1},{"text":"بۆ بێت","poem":2},{"text":"ئایا هەندێک ترێ بەجێناهێڵن؟","poem":1},{"text":"ئای چۆن بە تەواوی بڕایتەوە!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئای عیسۆ چۆن دەپشکێنرێت!","poem":1},{"text":"گەنجینە شاردراوەکانی تاڵان دەکرێن!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"هەموو هاوپەیمانەکانت هەتا سنوور ڕاویان نای،","poem":1},{"text":"هەڵیانخەڵەتاندی و بەسەرتدا زاڵبوون،","poem":2},{"text":"ئەوانەی نمەکی تۆیان کردبوو داوت بۆ دەنێنەوە،","poem":1},{"text":"بەڵام تۆ تێناگەیت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"یەزدان دەفەرموێت:","poem":1},{"text":"«ئایا لەو ڕۆژەدا،","poem":2},{"text":"دانایان لە ئەدۆم لەناو نابەم،","poem":1},{"text":"تێگەیشتووانیش لە چیای عیسۆ؟","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەی تێمان، پاڵەوانەکانت دەتۆقن،","poem":1},{"text":"هەموو ئەوانەی لە چیای عیسۆن","poem":2},{"lineBreak":true},{"text":"بە کوشتن لەناودەچن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لەبەر ستەمی تۆ لە یاقوبی برات،","poem":1},{"text":"ڕیسوایی داتدەپۆشێت،","poem":2},{"lineBreak":true},{"text":"بۆ هەتاهەتایە لەناودەچیت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەو ڕۆژەی تەماشات دەکرد","poem":1},{"text":"کاتێک بیانییەکان سامانەکەیان داگیر کرد و","poem":2},{"text":"نامۆکان هاتنە ناو دەروازەکانی و","poem":1},{"text":"لەسەر ئۆرشەلیم تیروپشکیان کرد،","poem":2},{"lineBreak":true},{"text":"هەروەها تۆش وەک یەکێک بووی لەوان.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بەڵام نابێت بە ڕۆژی کارەساتی براکەت دڵخۆش بیت،","poem":1},{"text":"یان لە ڕۆژی لەناوچوونی نەوەی یەهودا شادمان بیت،","poem":2},{"text":"یان لە ڕۆژی تەنگانەیاندا شانازی بکەیت.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"نابێت بچیتە ناو دەروازەی گەلەکەم","poem":1},{"text":"لە ڕۆژی کارەساتیان،","poem":2},{"text":"یان بە ناخۆشییەکەیان دڵخۆش بیت","poem":1},{"text":"لە ڕۆژی کارەساتیان،","poem":2},{"text":"یان دەستت بۆ سامانەکەیان درێژ بکەیت","poem":1},{"text":"لە ڕۆژی کارەساتیان.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"نابێت لەسەر دووڕیانەکان بوەستیت","poem":1},{"text":"بۆ کوشتنی دەربازبووەکانیان،","poem":2},{"text":"نابێت هەڵاتووەکانیان ڕادەست بکەیت","poem":1},{"text":"لە ڕۆژی تەنگانەیاندا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"«ڕۆژی یەزدان","poem":1},{"noteId":2},{"text":"بۆ هەموو گەلان نزیکە.","poem":1},{"text":"هەروەک ئەوەی کردت ئاوات پێ دەکرێتەوە،","poem":2},{"lineBreak":true},{"text":"کردەوەکانت بەسەر خۆت دێتەوە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"هەروەک لەسەر کێوی پیرۆزم خواردتانەوە،","poem":1},{"lineBreak":true},{"text":"هەموو گەلان بەردەوام جامی سزا دەخۆنەوە؛","poem":1},{"lineBreak":true},{"text":"دەخۆنەوە و دەخۆنەوە و","poem":1},{"lineBreak":true},{"text":"وەک ئەوەیان لێدێت کە هەرگیز نەبووبن.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"بەڵام دەربازبوون لەسەر کێوی سییۆن دەبێت،","poem":1},{"text":"پیرۆز دەبێت،","poem":2},{"lineBreak":true},{"text":"بنەماڵەی یاقوبیش بەشە میراتی خۆیان وەردەگرن.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بنەماڵەی یاقوب دەبێتە ئاگر و","poem":1},{"text":"بنەماڵەی یوسف دەبێتە گڕ؛","poem":2},{"text":"بنەماڵەی عیسۆش دەبێتە پووش،","poem":1},{"text":"جا گڕیان تێبەردەدەن و دەیانخۆن.","poem":2},{"lineBreak":true},{"text":"بنەماڵەی عیسۆ کەسیان لێ دەرباز نابێت.»","poem":2},{"text":"ئەمە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"خەڵکی نەقەب","poem":1},{"text":"چیای عیسۆ داگیر دەکەن،","poem":2},{"text":"خەڵکی زوورگەکانیش","poem":1},{"text":"خاکی فەلەستییەکان.","poem":2},{"text":"دەبنە خاوەنی کێڵگەکانی ئەفرایم و سامیرە،","poem":1},{"text":"بنیامینیش دەبێتە خاوەنی گلعاد.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئەو کۆمەڵەی ڕاپێچکراوانی ئیسرائیل کە لە کەنعانن","poem":1},{"text":"هەتا سەرەفەند دەست بەسەر خاکەکەدا دەگرن؛","poem":2},{"text":"ڕاپێچکراوانی ئۆرشەلیمیش کە لە سفارەدن","poem":1},{"text":"دەست بەسەر شارۆچکەکانی نەقەبدا دەگرن.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ڕزگارکەرانی خاکەکەش سەردەکەونە سەر کێوی سییۆن","poem":1},{"text":"بۆ فەرمانڕەوایەتی لەسەر چیای عیسۆ.","poem":2},{"lineBreak":true},{"text":"پاشایەتیش بۆ یەزدان دەبێت.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"پایتەختی ئەدۆم ناوی سەلەع بوو، کە هەمان وشەی عیبرییە بۆ تاشەبەرد.‏","reference":{"chapter":1,"verse":3}},{"noteId":1,"caller":"+","text":"ڕەزبڕ: ئەوەی بەرهەمی ڕەزی دەبڕێتەوە.‏","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"ڕۆژی سزادانی گوناهباران و ڕزگارکردنی گەلی خودا.‏","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/ckb_bib/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}