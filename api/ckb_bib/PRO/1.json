{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PRO","translationId":"ckb_bib","name":"پەندەکانی سلێمان","commonName":"پەندەکانی سلێمان","title":"پەندەکانی سلێمان","order":20,"numberOfChapters":31,"sha256":"416b935a4d807fe1bccabcaa1c43659660fdf6e1d0a1ccbd1460d52126cab4ac","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ckb_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"heading","content":["پێشەکی: ئامانج و بابەت"]},{"type":"verse","number":1,"content":["پەندەکانی سلێمانی کوڕی داود، پاشای ئیسرائیل،"]},{"type":"verse","number":2,"content":[{"text":"بۆ زانینی دانایی و تەمبێکردن،","poem":1},{"text":"بۆ پەیبردن بە وشەکانی تێگەیشتن،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بۆ وەرگرتنی تەمبێکردن و وریایی،","poem":1},{"text":"ڕاستودروستی و دادپەروەری و ڕاستەڕێیی،","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بۆ بەخشینی ژیری بە ساویلکە،","poem":1},{"text":"بە لاویش زانیاری و سەلیقە","poem":2},{"noteId":0},{"text":"،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"(دانا گوێی لێ دەگرێت و فێربوونی زیاد دەبێت،","poem":1},{"text":"تێگەیشتووش ڕاوێژی باشی دەست دەکەوێت،)","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بۆ تێگەیشتنی پەند و نموونە،","poem":1},{"text":"قسەی دانایان و مەتەڵەکانیان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"لەخواترسی سەرەتای زانیارییە،","poem":1},{"text":"بەڵام گێلەکان سووکایەتی بە دانایی و تەمبێکردن دەکەن.","poem":2}]},{"type":"heading","content":["هاندان بۆ دەستگرتن بە دانایی"]},{"type":"heading","content":["ئاگادارکردنەوە لە دژی فریودان"]},{"type":"verse","number":8,"content":[{"text":"ڕۆڵە، گوێ لە تەمبێکردنی باوکت بگرە و","poem":1},{"text":"فێرکردنی دایکت پشتگوێ مەخە،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"چونکە تاجەگوڵینەی نیعمەتن بۆ سەرت،","poem":1},{"text":"گەردانەن بۆ ملت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ڕۆڵە، ئەگەر گوناهباران فریویان دایت،","poem":1},{"text":"ڕازی مەبە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەگەر گوتیان: «لەگەڵمان وەرە،","poem":1},{"text":"بۆسە بۆ خوێنڕشتن بنێینەوە،","poem":2},{"lineBreak":true},{"text":"بەبێ هۆ بۆ بێتاوانێک خۆمان مات بکەین،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"وەک جیهانی مردووان بە زیندووێتی هەڵیانلووشین و","poem":1},{"text":"بە ساغی وەک ئەوانەی لە گۆڕ دەنرێن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"هەموو گەنجینەیەکی بەهادار دەدۆزینەوە و","poem":1},{"text":"ماڵمان پڕ دەکەین لە دەستکەوت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"پشکی خۆت هەڵبدە ناومان،","poem":1},{"text":"بە هەموومان یەک کیسەمان دەبێت.»","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ڕۆڵە، لەگەڵیان بە ڕێگادا مەڕۆ،","poem":1},{"text":"پێیەکانت قەدەغە بکە لە ڕێڕەوەکانیان،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"چونکە پێیەکانیان بەرەو خراپە ڕادەکەن،","poem":1},{"text":"بۆ خوێنڕشتن پەلە دەکەن.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"بێ سوودە دانانەوەی تۆڕ","poem":1},{"text":"لەبەرچاوی هەموو باڵدارێک.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بۆ خوێنی خۆیان بۆسەیان ناوەتەوە،","poem":1},{"text":"خۆیان تەنها بۆ گیانی خۆیان ماتداوە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئاوایە ڕێچکەی هەموو ئەوانەی بەدوای دەستکەوتی ناڕەواوەن،","poem":1},{"text":"سەری خاوەنی دەخوات.","poem":2}]},{"type":"heading","content":["ئاگادارکردنەوە لە ڕەتکردنەوەی دانایی"]},{"type":"verse","number":20,"content":[{"text":"دانایی لە کۆڵان هاوار دەکات،","poem":1},{"text":"لە گۆڕەپانەکان دەنگ بەرز دەکاتەوە،","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لە شەقامە قەرەباڵغەکاندا بانگ دەکات،","poem":1},{"text":"لە دەروازەی شارەکاندا قسەی خۆی دەکات:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«هەتا کەی ئەی ساویلکەکان حەز لە ساویلکەیی دەکەن؟","poem":1},{"text":"هەتا کەی گاڵتەجاڕان بە گاڵتەکردن دڵخۆش دەبن،","poem":2},{"lineBreak":true},{"text":"گێلەکانیش ڕقیان لە زانیاری دەبێتەوە؟","poem":2}]},{"type":"verse","number":23,"content":[{"text":"بگەڕێنەوە کاتێک سەرزەنشتتان دەکەم!","poem":1},{"text":"ئینجا ڕۆحی خۆمتان بەسەردا دەڕێژم،","poem":2},{"lineBreak":true},{"text":"وشەکانی خۆمتان پێ دەناسێنم.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"بەڵام بانگهێشتم کردن، ڕەتتان کردەوە،","poem":1},{"text":"دەستم درێژکرد، کەس گوێی پێنەدا،","poem":2}]},{"type":"verse","number":25,"content":[{"text":"هەموو ڕاوێژێکی منتان پشتگوێ خست،","poem":1},{"text":"سەرزەنشتی منتان وەرنەگرت،","poem":2}]},{"type":"verse","number":26,"content":[{"text":"جا منیش لە کارەساتتان پێدەکەنم.","poem":1},{"text":"گاڵتە دەکەم کە ترستان لێ نیشت،","poem":2}]},{"type":"verse","number":27,"content":[{"text":"کە ترستان وەک گەردەلوول لێ نیشت و","poem":1},{"text":"وێرانیتان وەک ڕەشەبا هاتە سەر و","poem":2},{"lineBreak":true},{"text":"تەنگانە و ناخۆشی بەسەرتانی دادا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"«ئینجا بانگم دەکەن، بەڵام من وەڵام نادەمەوە،","poem":1},{"text":"بە پەرۆشییەوە بەدوامدا دەگەڕێن بەڵام نامدۆزنەوە.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"لەبەر ئەوەی ڕقیان لە زانیاری بووەوە،","poem":1},{"text":"لەخواترسییان هەڵنەبژارد،","poem":2}]},{"type":"verse","number":30,"content":[{"text":"لەبەر ئەوەی ڕاوێژی منیان وەرنەگرت،","poem":1},{"text":"بە سووکییەوە تەماشای هەموو سەرزەنشتەکانی منیان کرد،","poem":2}]},{"type":"verse","number":31,"content":[{"text":"بۆیە لە بەرهەمی ڕێگای خۆیان دەخۆن،","poem":1},{"text":"لە بەری پیلانەکانیان تێر دەبن،","poem":2}]},{"type":"verse","number":32,"content":[{"text":"چونکە هەڵگەڕانەوەی ساویلکەکان دەیانکوژێت،","poem":1},{"text":"بێباکی گێلەکان لەناویان دەبات.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"بەڵام ئەوەی گوێ لە من بگرێت بە ئاسوودەیی نیشتەجێ دەبێت،","poem":1},{"text":"لە ترسی خراپە دەحەسێتەوە.»","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"سەلیقە: کارکردن بە لێکدانەوە و ئارامی. هەروەها ڕازگری و پاراستنی نهێنی.‏","reference":{"chapter":1,"verse":4}}]},"thisChapterLink":"/api/ckb_bib/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}