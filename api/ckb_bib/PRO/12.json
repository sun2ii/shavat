ە،","poem":1},{"text":"ڕێگای ڕێڕەوەکانی بەرەو نەمرییە.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":14,"caller":"+","text":"چاکبوونەوەیە لە برین و ئازار.‏","reference":{"chapter":12,"verse":18}}]},"thisChapterLink":"/api/ckb_bib/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}