{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PRO","translationId":"ckb_bib","name":"پەندەکانی سلێمان","commonName":"پەندەکانی سلێمان","title":"پەندەکانی سلێمان","order":20,"numberOfChapters":31,"sha256":"416b935a4d807fe1bccabcaa1c43659660fdf6e1d0a1ccbd1460d52126cab4ac","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ckb_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"کوڕی دانا تەمبێکردنی باوکی وەردەگرێت،","poem":1},{"text":"بەڵام گاڵتەجاڕ گوێ لە سەرزەنشت ناگرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"مرۆڤ لە بەروبوومی دەمی چاکە دەخوات،","poem":1},{"text":"ناپاکانیش ئارەزوویان توندوتیژییە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ئەوەی ئاگای لە دەمی بێت گیانی خۆی دەپارێزێت،","poem":1},{"text":"بەڵام ئەوەی زمان درێژی دەکات لەناودەچێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"گیانی تەمبەڵ ئارەزوو دەکات و هیچی دەست ناکەوێت،","poem":1},{"text":"بەڵام گیانی تێکۆشەر سەرکەوتوو دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"کەسی ڕاستودروست ڕقی لە قسەی درۆیە،","poem":1},{"text":"بەدکاریش ڕیسوایی و شەرمەزاری دەهێنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ڕاستودروستی ئەو کەسە دەپارێزیت کە ڕێگای ڕاستە،","poem":1},{"text":"خراپەش گوناهبار سەرەوژێر دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"هەیە خۆی بە دەوڵەمەند دەردەخات و هیچی نییە،","poem":1},{"text":"هەشە خۆی بە هەژار دەردەخات و سامانی زۆری هەیە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"لەوانەیە مرۆڤ بە سامانەکەی گیانی خۆی بکڕێتەوە،","poem":1},{"text":"بەڵام هەژار گوێی لە هەڕەشە نابێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ڕووناکی ڕاستودروستان دەگەشێتەوە،","poem":1},{"text":"بەڵام چرای بەدکاران دەکوژێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"لە لووتبەرزییەوە تەنها ناکۆکی پەیدادەبێت،","poem":1},{"text":"بەڵام لەگەڵ ڕاوێژکاران دانایی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ماڵێک بە ناپاکی پەیداکرابێت، کەم دەکات،","poem":1},{"text":"بەڵام ئەوەی بە کاری دەست کۆدەبێتەوە، زیاد دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ئومێدی درێژکراوە دڵ نەخۆش دەکات،","poem":1},{"text":"ئارەزووی بەدیهاتووش درەختی ژیانە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ئەوەی سووکایەتی بە فێرکردنەکە","poem":1},{"noteId":15},{"text":"بکات خۆی لەناودەبات،","poem":1},{"text":"بەڵام ئەوەی ڕێزی بۆ ڕاسپاردەکە هەبێت پاداشتی دەدرێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"فێرکردنەکانی دانا کانی ژیانە،","poem":1},{"text":"بۆ دوورکەوتنەوە لە داوی مردن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"تێگەیشتنی باش پەسەندی بەدەستدەهێنێت،","poem":1},{"text":"بەڵام ڕێگای ناپاکان سەختە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"هەموو کەسێکی ژیر بە زانیارییەوە کار دەکات،","poem":1},{"text":"بەڵام نەزان گێلایەتی بڵاو دەکاتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"نێردراوی بەدکار دەکەوێتە خراپەوە،","poem":1},{"text":"پەیامبەری دەستپاکیش چاکبوونەوە دەهێنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"هەژاری و ڕیسوایی بۆ ئەوانەیە تەمبێکردن بەلاوە دەنێن،","poem":1},{"text":"بەڵام ئەوەی سەرزەنشت لەگوێدەگرێت ڕێزدار دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ئارەزووی بەدیهاتوو خۆشییە بۆ گیان،","poem":1},{"text":"بەڵام گێل وا دەزانێت کە لادان لە خراپە شتێکی قێزەونە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ئەوەی لەگەڵ دانایان دەڕوات دەبێتە دانا،","poem":1},{"text":"هاوڕێی گێلەکانیش زیانی پێدەگات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"خراپە دوای گوناهباران دەکەوێت،","poem":1},{"text":"بەڵام ڕاستودروستان بە چاکە پاداشت دەدرێنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"پیاوچاک میرات بۆ نەوەکانی","poem":1},{"noteId":16},{"text":"بەجێدەهێڵێت،","poem":1},{"text":"سامانی گوناهبارانیش بۆ ڕاستودروست هەڵدەگیردرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"لەوانەیە زەویی بەیاری","poem":1},{"noteId":17},{"text":"هەژاران خواردنی زۆری تێدابێت،","poem":1},{"text":"بەڵام لەبەر نادادپەروەری دەبردرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ئەوەی ڕێگا لە کوتەک بگرێت ڕقی لە کوڕەکەیەتی،","poem":1},{"text":"بەڵام ئەوەی خۆشیبوێت گرنگی بە تەمبێکردنی دەدات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"کەسی ڕاستودروست دەخوات و تێر دەبێت،","poem":1},{"text":"بەڵام سکی بەدکاران هەر برسی دەبێت.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":15,"caller":"+","text":"مەبەستی لە فێرکردنی تەوراتی موسایە.‏","reference":{"chapter":13,"verse":13}},{"noteId":16,"caller":"+","text":"عیبری، کوڕی کوڕ.‏","reference":{"chapter":13,"verse":22}},{"noteId":17,"caller":"+","text":"زەوی نەکێڵدراو و ئامادە بۆ کێڵان.‏","reference":{"chapter":13,"verse":23}}]},"thisChapterLink":"/api/ckb_bib/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}