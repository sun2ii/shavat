ارەت","poem":1},{"noteId":19},{"text":"بۆ تاوان دەکرێت،","poem":1},{"text":"بە لەخواترسیش دوورکەوتنەوە لە خراپە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئەگەر ڕەفتاری مرۆڤ مایەی ڕەزامەندی یەزدان بێت،","poem":1},{"text":"وا دەکات تەنانەت دوژمنەکانیشی لەگەڵیدا ئاشت ببنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"باشترە کەمت هەبێت بە ڕاستودروستییەوە","poem":1},{"text":"لەوەی داهاتێکی زۆری بە ناڕەوا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"دڵی مرۆڤ پلان بۆ ڕێگای خۆی دادەنێت،","poem":1},{"text":"بەڵام یەزدان هەنگاوەکانی ئاراستە دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"قسەی پاشا وەک سروشە","poem":1},{"noteId":20},{"text":"،","poem":1},{"text":"دەبێ لە دادوەریدا دەمی ناپاکی نەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"قەپان و تەرازووی دادپەروەر لە یەزدانەوەیە،","poem":1},{"text":"هەموو کێشێکی ناو کیسە کاری ئەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"قێزی پاشایان لە خراپەکردنە،","poem":1},{"text":"چونکە بە ڕاستودروستی تەخت دەچەسپێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ڕەزامەندی پاشایان لێوی ڕاستودروستە،","poem":1},{"text":"کەسی ڕاستگۆیان خۆشدەوێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"تووڕەیی پاشا وەک فریشتەی مەرگە،","poem":1},{"text":"بەڵام کەسی دانا هێمنی دەکاتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ڕووناکی ڕووی پاشا ژیانی تێدایە،","poem":1},{"text":"ڕەزامەندیشی وەک هەورە بارانی بەهارە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"دەستکەوتنی دانایی چەند لە زێڕ باشترە،","poem":1},{"text":"دەستکەوتنی تێگەیشتنیش لە زیو پەسەندترە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ڕێگای سەرڕاستان دوورکەوتنەوەی