er":18,"content":[{"text":"تیروپشک ناکۆکی دەبڕێنێتەوە و","poem":1},{"text":"بەهێزەکان لە یەکتر جیا دەکاتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"خراپە دەرهەق بە برا، ئاشتکردنەوەی لە شاری قەڵابەند سەختترە،","poem":1},{"text":"ناکۆکیش وەک شمشیرەی","poem":2},{"noteId":24},{"text":"دەروازەی قەڵایە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"لە بەروبوومی دەمی مرۆڤ سکی تێردەبێت،","poem":1},{"text":"لە دروێنەی لێوەکانی خۆی تێر دەخوات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"مردن و ژیان بە دەست زمانە،","poem":1},{"text":"ئەوەی حەزی لێی بێت بەروبوومەکەی دەخوات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ئەوەی ژنێکی دەست بکەوێت خێرێکی دەست دەکەوێت،","poem":1},{"text":"ڕەزامەندی یەزدانیش بەدەستدەهێنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"هەژار بۆ بەزەیی دەپاڕێتەوە،","poem":1},{"text":"بەڵام دەوڵەمەند بە ڕەقی وەڵام دەداتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"پیاو برادەری زۆر بێت خۆی گرفتار دەکات،","poem":1},{"text":"بەڵام دۆستێک هەیە لە برا نزیکترە.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":24,"caller":"+","text":"شمشیر، پارچە دارێک بووە لە جیاتی قوفڵ لە دواوەی دەرگا بە شێوەی ئاسۆیی دانراوە بۆ داخستنی دەرگا.‏","reference":{"chapter":18,"verse":19}}]},"thisChapterLink":"/api/ckb_bib/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}