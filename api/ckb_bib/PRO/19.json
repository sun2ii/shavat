{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PRO","translationId":"ckb_bib","name":"پەندەکانی سلێمان","commonName":"پەندەکانی سلێمان","title":"پەندەکانی سلێمان","order":20,"numberOfChapters":31,"sha256":"416b935a4d807fe1bccabcaa1c43659660fdf6e1d0a1ccbd1460d52126cab4ac","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ckb_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"هەژارێک ڕێگای تەواوەتی گرتبێت","poem":1},{"text":"باشترە لەوەی زمان خوار و گێلە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"دڵگەرمی بەبێ زانیاری باش نییە و","poem":1},{"text":"ئەوەی پەلە بە پێیەکانی بکات بە هەڵەدا دەچێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"مرۆڤ بە گێلایەتییەکەی ڕێگای خۆی وێران دەکات،","poem":1},{"text":"کەچی دڵی لە دژی یەزدان هەڵدەچێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"دەوڵەمەندیێتی برادەری زۆر پەیدا دەکات،","poem":1},{"text":"بەڵام هەژار برادەرەکەشی لێی جیا بووەتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"شایەتی درۆزن بێ سزا نابێت،","poem":1},{"text":"ئەوەی درۆ پەخش دەکات دەرباز نابێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"زۆر کەس هەوڵی بەدەستهێنانی ڕەزامەندی میر دەدەن،","poem":1},{"text":"هەمووش دۆستی پیاوی بەخشندەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"پیاو هەژار بێت براکانی خۆشی ڕقیان لێی دەبێتەوە،","poem":1},{"text":"لەوەش زیاتر هاوڕێیەکانی لێی دوور دەکەونەوە!","poem":2},{"text":"بە پاڕانەوەکانی دوایان دەکەوێت،","poem":1},{"text":"بەڵام بێ سوودە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ئەوەی دانایی دەست بکەوێت خۆی خۆشدەوێت،","poem":1},{"text":"ئەوەی بایەخ بە تێگەیشتن بدات چاکە دەدۆزێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"شایەتی درۆزن بێ سزا نابێت،","poem":1},{"text":"ئەوەی درۆ پەخش بکات لەناودەچێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"گێل خۆشگوزەرانیی لێ ناوەشێتەوە،","poem":1},{"text":"لەوەش زیاتر دەسەڵاتداربوونی کۆیلە بەسەر میرانەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"وریایی مرۆڤ تووڕەبوونی خاودەکاتەوە،","poem":1},{"text":"شانازیشی لێبوردنە لە یاخیبوون.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"هەڵچوونی پاشا وەک نەڕەی شێرە،","poem":1},{"text":"بەڵام ڕەزامەندییەکەی وەک شەونمە بەسەر گیاوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"کوڕی گێل ماڵوێرانی باوکیەتی،","poem":1},{"text":"ناکۆکی ژنیش دڵۆپەکردنی بەردەوامە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ماڵ و سامان میراتی باوکانە،","poem":1},{"text":"بەڵام ژنی وریا لەلایەن یەزدانەوەیە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"تەمبەڵی خەوی قووڵ دەهێنێت،","poem":1},{"text":"کەسی سست برسی دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ئەوەی ڕاسپاردە","poem":1},{"noteId":25},{"text":"بپارێزێت گیانی خۆی دەپارێزێت،","poem":1},{"text":"بەڵام ئەوەی بە سووکی بڕوانێتە ڕێگای خۆی لەناودەچێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ئەوەی بەزەیی بە هەژاردا بێتەوە قەرز بە یەزدان دەدات،","poem":1},{"text":"ئەویش پاداشتی چاکەکەی دەداتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"کوڕەکەت تەمبێ بکە ئەوەندەی ئومێدی تێدایە،","poem":1},{"text":"مەبە هۆکاری مردنی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ئەوەی زۆر تووڕە بێت بەرگەی ئەنجامەکەی دەگرێت،","poem":1},{"text":"چونکە ئەگەر جارێک فریای بکەویت دەبێت دووبارەی بکەیتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"گوێ لە ڕاوێژ بگرە و تەمبێکردن وەربگرە،","poem":1},{"text":"بۆ ئەوەی دانا بیت لە دواڕۆژت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"مرۆڤ پلانی زۆری لە دڵدایە،","poem":1},{"text":"بەڵام تەنها ڕاوێژی یەزدان دەچەسپێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ئارەزووی مرۆڤ لە خۆشەویستی نەگۆڕە،","poem":1},{"text":"هەژار لە پیاوی درۆزن باشترە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"لەخواترسی بۆ ژیانە،","poem":1},{"text":"بە تێری دەنوێت و خراپە بەسەری ناکاتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"تەمبەڵ دەست دەخاتە ناو قاپ،","poem":1},{"text":"تەنانەت بۆ دەمیشی نابات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"لە گاڵتەجاڕ بدە و ساویلکە ژیر دەبێت،","poem":1},{"text":"تێگەیشتوو سەرزەنشت بکە زانیاری تێدەگات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ئەوەی باوکی تاڵان بکات و دایکی دەربکات،","poem":1},{"text":"کوڕێکە مایەی شەرمەزاری و ڕیسوایی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ڕۆڵە، ئەگەر وازت لە گوێگرتن لە ڕاوێژ هێنا،","poem":1},{"text":"لە وتەکانی زانیاری گومڕا دەبیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"شایەتی دڵڕەش گاڵتە بە دادپەروەری دەکات،","poem":1},{"text":"دەمی بەدکارانیش تاوان قووت دەدات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"سزا بۆ گاڵتەجاڕەکان ئامادەکراوە،","poem":1},{"text":"لێدانیش بۆ پشتی گێلەکان.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":25,"caller":"+","text":"تەوراتی موسا.‏","reference":{"chapter":19,"verse":16}}]},"thisChapterLink":"/api/ckb_bib/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}