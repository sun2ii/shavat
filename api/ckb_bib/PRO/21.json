,"poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"بەدکار دەبێتە قوربانی بۆ کەسی ڕاستودروست،","poem":1},{"text":"ناپاکانیش بۆ سەرڕاستان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"باشترە لە چۆڵەوانی نیشتەجێ بیت،","poem":1},{"text":"نەک لەگەڵ ئافرەتێکی شەڕانی و تووڕە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"گەنجینەی خۆراکی باش و ڕۆن لە ماڵی کەسی دانا هەیە،","poem":1},{"text":"بەڵام کەسی گێل هەڵدەلووشێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ئەوەی دوای ڕاستودروستی و خۆشەویستی نەگۆڕ بکەوێت،","poem":1},{"text":"ژیان و ڕاستودروستی و ڕێزداری دەدۆزێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"پیاوی دانا بە شاری پاڵەوانەکاندا هەڵدەگەڕێت و","poem":1},{"text":"قەڵا پشتبەستەکەیان وێران دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ئەوەی دەم و زمانی خۆی بپارێزێت،","poem":1},{"text":"خۆی لە تەنگانە دەپارێزێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"لووتبەرز و لەخۆبایی بە گاڵتەجاڕ ناودەبردرێت،","poem":1},{"text":"بە لێشاوی لووتبەرزییەوە ڕەفتار دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ئارەزووی کەسی تەمبەڵ دەیکوژێت،","poem":1},{"text":"چونکە دەستەکانی ئیش ڕەت دەکەنەوە،","poem":2}]},{"type":"verse","number":26,"content":[{"text":"بە درێژایی ڕۆژ تامەزرۆی ئارەزووە،","poem":1},{"text":"بەڵام کەسی ڕاستودروست دەبەخشێت و دەستی پێوە ناگرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"قوربانی بەدکاران قێزەونە،","poem":1},{"text":"لەوەش زیاتر ئەگەر بە نیازێکی خراپەوە بیکات!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"شایەتی درۆزن لەناودەچێت،","poem":1},{"text":"بەڵام شایەتیی گوێگری وریا دەچەسپێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"پیاوی بەدکار ناوچەوانی خۆی گرژ دەکات،","poem":1},{"text":"بەڵام سەرڕاست ئاگای لە ڕێگای خۆیەتی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"دانایی و تێگەیشتن و ڕاوێژ نییە","poem":1},{"text":"لە دژی یەزدان سەربکەوێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ئەسپ ئامادەیە بۆ ڕۆژی جەنگ،","poem":1},{"text":"بەڵام ڕزگاری لە یەزدانەوەیە.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}