ارەزووی خواردنە خۆشەکانی مەکە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لەبەر ئەوەی جۆرە کەسێکە","poem":1},{"text":"هەردەم بیری لەلای تێچوونەکانە،","poem":2},{"text":"پێت دەڵێت: «بخۆ و بنۆشە.»","poem":1},{"text":"بەڵام دڵی لەگەڵت نییە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەو پارووەی خواردووتە دەیڕشێنیتەوە و","poem":1},{"text":"قسە شیرینەکانت بە با دەدەیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"قسە بۆ گێل مەکە،","poem":1},{"text":"چونکە گاڵتەی بە دانایی قسەکانت دێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"سنوورە کۆنەکان مەگوازەوە،","poem":1},{"text":"هەروەها مەچووە ناو کێڵگەی هەتیوان،","poem":2}]},{"type":"verse","number":11,"content":[{"text":"چونکە ئەوەی دەیانپارێزێت بە توانایە،","poem":1},{"text":"ئەو بەرگری لە کێشەکەیان دەکات لە دژی تۆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"دڵت ئاراستەی فێربوون بکە و","poem":1},{"text":"گوێشت بەرەو قسەی زانیاری.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ڕێگری لە تەمبێکردنی منداڵ مەکە،","poem":1},{"text":"ئەگەر بە گۆچان لێی بدەیت نامرێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"تۆ بە گۆچان لێی بدەیت،","poem":1},{"text":"گیانی لە مردن دەرباز دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ڕۆڵە، ئەگەر دڵت دانایە،","poem":1},{"text":"منیش دڵم خۆش دەبێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ناخم شادمان دەبێت،","poem":1},{"text":"کە لێوەکانت ڕاستییەکان دەڵێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"دڵت ئیرەیی بە گوناهباران نەبات،","poem":1},{"text":"بەڵکو بە درێژایی ڕۆژ بە پەرۆش بە بۆ لەخواترسی.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بێگومان دواڕۆژت دەبێت،","poem":1},{"text":"ئومێدی تۆ نابڕێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ڕۆڵە، تۆ گوێ بگرە و دانا بە،","poem":1},{"text":"دڵت بەرەو ڕێگای ڕاستی ئاراستە بکە.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"لەوانە مەبە کە شەراب زۆر دەخۆنەوە،","poem":1},{"text":"یان ئەوانەی گۆشت زۆر دەخۆن،","poem":2}]},{"type":"verse","number":21,"content":[{"text":"چونکە مەیخۆر و زۆر خۆر هەژار دەبن،","poem":1},{"text":"ئەوەی زۆر بخەوێت پینەوپەڕۆ لەبەر دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"گوێ لە باوکت بگرە کە تۆی خستووەتەوە،","poem":1},{"text":"دایکت کە پیر بوو گاڵتەی پێ مەکە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ڕاستی بکڕە و مەیفرۆشە،","poem":1},{"text":"هەروەها دانایی و تەمبێکردن و تێگەیشتن.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"باوکی کەسی ڕاستودروست زۆر دڵخۆش دەبێت،","poem":1},{"text":"ئەوەی کوڕێکی دانای ببێت پێی شادمان دەبێت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"با دایک و باوکت شادمان بن،","poem":1},{"text":"ئەوەی تۆی بووە دڵخۆش بێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ڕۆڵە، دڵی خۆتم بدەرێ،","poem":1},{"text":"با چاوەکانت لەسەر ڕێگاکانم بێت،","poem":2}]},{"type":"verse","number":27,"content":[{"text":"چونکە لەشفرۆش چاڵێکی قووڵە و","poem":1},{"text":"ژنی داوێنپیس بیرێکی تەنگە.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"تەنانەت ئەویش وەک چەتە لە بۆسەدا دەبێت،","poem":1},{"text":"ناپاک","poem":2},{"noteId":30},{"text":"لەنێو خەڵک زۆر دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"واوەیلا بۆ کێیە؟ پەژارەیی بۆ کێیە؟","poem":1},{"text":"ناکۆکی بۆ کێیە؟ سکاڵاکردن بۆ کێیە؟","poem":2},{"lineBreak":true},{"text":"برینی بەخۆڕایی بۆ کێیە؟ چاو سووربوونەوە بۆ کێیە؟","poem":2}]},{"type":"verse","number":30,"content":[{"text":"بۆ ئەوانەی بە دیار شەرابەوە لەنگەر دەگرن،","poem":1},{"text":"ئەوانەی شەرابی تێکەڵاو تاقی دەکەنەوە.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"تەماشای شەراب مەکە بە ڕەنگی سووری،","poem":1},{"text":"کە لەناو جام پڕشنگی داوە،","poem":2},{"lineBreak":true},{"text":"بە سووکی دەچێتە خوارەوە!","poem":2}]},{"type":"verse","number":32,"content":[{"text":"لە کۆتاییەکەی وەک مار دەتگەزێت و","poem":1},{"text":"وەک توولەمار پێتەوەدەدات.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"چاوەکانت شتی نامۆ دەبینن و","poem":1},{"text":"وڕێنەی سەیر و سەمەرە دەکەیت.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"وەک یەکێک دەبیت لەناو دڵی دەریا پاڵکەوتبێت،","poem":1},{"text":"یان وەک یەکێک بەسەر دارئاڵای کەشتییەوە پاڵکەوتبێت.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"دەڵێی: «لێیان دام، ئازارم نەبوو!","poem":1},{"text":"کوتامیان، نەمزانی!","poem":2},{"text":"کەی بە هۆش خۆم دێمەوە،","poem":1},{"text":"هەتا بەردەوام بم و بخۆمەوە؟»","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":30,"caller":"+","text":"ناپاکی هاوسەریێتی.‏","reference":{"chapter":23,"verse":28}}]},"thisChapterLink":"/api/ckb_bib/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}