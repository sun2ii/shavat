{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PRO","translationId":"ckb_bib","name":"پەندەکانی سلێمان","commonName":"پەندەکانی سلێمان","title":"پەندەکانی سلێمان","order":20,"numberOfChapters":31,"sha256":"416b935a4d807fe1bccabcaa1c43659660fdf6e1d0a1ccbd1460d52126cab4ac","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ckb_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"heading","content":["پەندەکانی دیکەی سلێمان"]},{"type":"verse","number":1,"content":["ئەمانەش هەر پەندی سلێمانن کە پیاوەکانی حەزقیای پاشای یەهودا نووسیویانەتەوە:"]},{"type":"verse","number":2,"content":[{"text":"شکۆمەندیی خودا لە شاردنەوەی بابەتدایە،","poem":1},{"text":"شکۆمەندیی پاشایانیش لە لێکۆڵینەوەی بابەتدایە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"هەروەک ئاسمان بۆ بەرزییە و زەوی بۆ قووڵییە،","poem":1},{"text":"دڵی پاشایانیش ناپشکنرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"خڵت لە زیو داماڵە،","poem":1},{"text":"ئەو کاتە دەتوانرێت کەرەستەی لێ دروستبکرێت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بەدکار لەبەردەم پاشا داماڵە،","poem":1},{"text":"بە ڕاستودروستی تەختەکەی دەچەسپێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"لەبەردەم پاشا خۆت بەرز مەکەرەوە،","poem":1},{"text":"لە شوێنی گەورە پیاوان ڕامەوەستە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"وا چاکترە پێت بگوترێت: «سەربکەوە بۆ ئێرە،»","poem":1},{"text":"نەک لەلای میر تەریق بیتەوە.","poem":2},{"lineBreak":true},{"text":"ئەوەی بە چاوی خۆت بینیت،","poem":1}]},{"type":"verse","number":8,"content":[{"text":"خێرا مەیبە بۆ دادگا،","poem":2},{"text":"چونکە لە کۆتاییەکەی چی دەکەیت","poem":1},{"text":"ئەگەر دراوسێکەت شەرمەزاری کردیت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"کە باسی کێشەکەت دەکەیت لەگەڵ دراوسێکەت،","poem":1},{"text":"نهێنی خەڵکی دیکە مەدرکێنە،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"نەوەک گوێگرێک شەرمەزارت بکات،","poem":1},{"text":"جا ناوە زڕاوەکەت لێ نابێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"سێوێکی زێڕە و لە زیو گیراوە،","poem":1},{"text":"ئەو قسەیەی لە کاتی خۆیدا دەکرێت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"وەک گوارەی زێڕە و خشڵی زێڕی بێگەردە،","poem":1},{"text":"سەرزەنشتی دانا بۆ گوێی بیسەر.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"وەک ساردی بەفرە لە ڕۆژی دروێنەدا،","poem":1},{"text":"نوێنەری دەستپاک بۆ ئەوانەی دەینێرن،","poem":2},{"lineBreak":true},{"text":"دڵی گەورەکانی فێنک دەکاتەوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"هەور و بای بێ بارانە،","poem":1},{"text":"ئەوەی شانازی بە دیاری بکات و نەیبەخشێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"بە نەسرەوتن فەرمانڕەوا قایل دەکرێت،","poem":1},{"text":"زمانی نەرمیش ئێسک دەشکێنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ئەگەر هەنگوینت دۆزییەوە بەگوێرەی پێویست بیخۆ،","poem":1},{"text":"ئەگینا پڕ دەبیت و دەیڕشێنیتەوە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"بە کەمی پێت لە ماڵی دراوسێکەت دابنێ،","poem":1},{"text":"ئەگینا لێت تێر دەبێت و ڕقی لێت دەبێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"وەک کوتەک و شمشێر و تیری تیژە،","poem":1},{"text":"ئەوەی شایەتی درۆ لەسەر دراوسێکەی بدات.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"وەک ددانی کلۆر و قاچی لەجێ چووە،","poem":1},{"text":"پشتبەستن بە ناپاک لە ڕۆژی تەنگانەدا.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"وەک داکەندنی بەرگ لە ڕۆژی سەرمادا،","poem":1},{"text":"یان سرکەیە بەسەر سۆدەدا،","poem":2},{"noteId":32},{"lineBreak":true},{"text":"چڕینی گۆرانی بۆ دڵتەنگ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ئەگەر دوژمنەکەت برسی بوو نانی دەرخوارد بدە،","poem":1},{"text":"ئەگەر تینووی بوو ئاوی بدەرێ.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بەمە پشکۆ لەسەر سەری کەڵەکە دەکەیت،","poem":1},{"noteId":33},{"text":"یەزدانیش پاداشتت دەداتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"بای باکوور باران دەهێنێت،","poem":1},{"text":"زمانی پاشملەش ڕووی گرژ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"باشترە لە گۆشەی سەربانێک نیشتەجێ بیت،","poem":1},{"text":"نەک ماڵێکی هاوبەش لەگەڵ ژنێکی شەڕانی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"وەک ئاوی ساردە بۆ گیانێکی شەکەت،","poem":1},{"text":"هەواڵی خۆش لە وڵاتێکی دوور.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"وەک کانییەکی لێڵ و بیرێکی بۆگەنە،","poem":1},{"text":"ئەو کەسە ڕاستودروستەی لەبەردەم بەدکار کۆڵ دەدات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"زۆر خواردنی هەنگوین باش نییە،","poem":1},{"text":"ڕێزدار نابێت ئەوەی داوای ڕێزلێنان بۆ خۆی دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"وەک شارێکی ڕووخاوی بێ شوورایە،","poem":1},{"text":"ئەو پیاوەی بەسەر خۆیدا زاڵ نەبێت.","poem":2}]}],"footnotes":[{"noteId":32,"caller":"+","text":"لە تێکەڵکردنی سرکە و سۆدەدا کارلێکی کیمیایی ڕوودەدات، هەڵدەچێت و ئۆکسجینی لێ دەردەچێت.‏","reference":{"chapter":25,"verse":20}},{"noteId":33,"caller":"+","text":"بەم کارە شەرمەزار دەبێت و پەشیمانی دەکەیتەوە.‏","reference":{"chapter":25,"verse":22}}]},"thisChapterLink":"/api/ckb_bib/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}