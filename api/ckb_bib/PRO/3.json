,"poem":1},{"text":"بە تێگەیشتنیش ئاسمانی چەسپاند.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"بە زانیاری ئەو قووڵاییەکان شەق بوون،","poem":1},{"text":"هەورەکان شەونمیان دڵۆپاند.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ڕۆڵە، دەست بە دانایی تەواو و سەلیقەوە بگرە،","poem":1},{"text":"ئەمانە لەبەرچاوت دوورنەکەونەوە،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"دەبنە ژیان بۆ تۆ،","poem":1},{"text":"ملوانکە بۆ جوانی گەردنت.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ئەوسا بە ئاسوودەیی بە ڕێگای خۆتدا دەڕۆیت و","poem":1},{"text":"ساتمە ناکەیت و ناکەویت.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"کاتێک ڕادەکشێیت بێ ترسیت،","poem":1},{"text":"ڕادەکشێیت و خەوت خۆش دەبێت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"نە لە بەڵای کتوپڕ دەترسیت و","poem":1},{"text":"نە لە ماڵی بەدکاران کە وێران دەبێت،","poem":2}]},{"type":"verse","number":26,"content":[{"text":"چونکە یەزدان دەبێتە پشتیوانت و","poem":1},{"text":"پێت لە پێوەبوون دەپارێزێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"دەستی چاکە مەگرەوە لەوانەی شایستەی چاکەن،","poem":1},{"text":"کاتێک لە تواناتدایە بیکەیت.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"بە کەس","poem":1},{"noteId":2},{"text":"مەڵێ:","poem":1},{"text":"«بڕۆ، دواتر وەرەوە، بەیانی دەتدەمێ،»","poem":2},{"lineBreak":true},{"text":"لە کاتێکدا ئەو شتەت پێیە.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"پیلانی خراپ لە دژی دراوسێکەت مەگێڕە،","poem":1},{"text":"لە کاتێکدا ئەو بە دڵنیاییەوە لەلات جێنشین بووە.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"لەخۆڕایی دژایەتی کەسێک مەکە،","poem":1},{"text":"ئەگەر خراپەی لەگەڵتدا نەکرد.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"بەغیلی بە پیاوی ستەمکار مەبە،","poem":1},{"text":"هیچ ڕێگایەکی ئەو هەڵمەبژێرە،","poem":2}]},{"type":"verse","number":32,"content":[{"text":"چونکە لەلای یەزدان مرۆڤی قەڵپ قێزەونە،","poem":1},{"text":"بەڵام نهێنی خۆی لەلای سەرڕاستانە.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"نەفرەتی یەزدان لەسەر ماڵی بەدکارە،","poem":1},{"text":"بەڵام ماڵی ڕاستودروستان بەرەکەتدار دەکات.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"هەرچەندە گاڵتە بە گاڵتەجاڕان دەکات،","poem":1},{"text":"بەڵام نیعمەت دەداتە بێفیزەکان.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"داناکان ڕێزداری بە میرات دەگرن،","poem":1},{"text":"بەڵام گێلەکان شەرمەزاری هەڵدەگرن.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"کەس: لە زمانی عیبری ئەم وشەیە بەم واتایانە دێت: (نزیکەکەت، برادەر، دراوسێ، هاوکار، هاوڕێ، هاوڵاتی). بڕوانە دواوتار 15‏:2 و لۆقا 10‏:29‏‏.‏","reference":{"chapter":3,"verse":28}}]},"thisChapterLink":"/api/ckb_bib/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}