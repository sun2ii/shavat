ە!“","poem":2},{"lineBreak":true},{"text":"«سێ شت هەن تێر نابن،","poem":1},{"text":"چوارەمیش ناڵێت، ”بەسە!“:","poem":2}]},{"type":"verse","number":16,"content":[{"text":"جیهانی مردووان و منداڵدانی نەزۆک و","poem":1},{"text":"زەوییەک تێر ئاو نەبێت و","poem":2},{"lineBreak":true},{"text":"ئاگرێک هەرگیز نەڵێت: ”بەسە!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«ئەو چاوەی گاڵتە بە باوکی بکات و","poem":1},{"text":"سووکایەتی بە گوێڕایەڵی بکات بۆ دایک،","poem":2},{"text":"قەلەڕەشەکانی دۆڵ هەڵیدەکۆڵن و","poem":1},{"text":"بێچووە سیسارکە کەچەڵ دەیخۆن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«سێ شت هەن زۆر سەیرن بۆ من،","poem":1},{"text":"چوارەمیش تێناگەم:","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ڕێگای هەڵۆ لە ئاسمان،","poem":1},{"text":"ڕێگای مار لەسەر بەرد،","poem":2},{"text":"ڕێگای کەشتی لەناو جەرگەی دەریا و","poem":1},{"text":"ڕێگای پیاویش لەگەڵ کچ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«ئەمە هەڵسوکەوتی ژنی داوێنپیسە:","poem":1},{"text":"دەخوات","poem":2},{"noteId":40},{"text":"و دەمی دەسڕێتەوە و","poem":2},{"lineBreak":true},{"text":"دەڵێت: ”خراپەم نەکردووە!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«زەوی لەژێر سێ شتدا دەلەرزێت و","poem":1},{"text":"لەژێر چوارەمیش ناتوانێت بەرگە بگرێت،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"خزمەتکارێک کە بووبێتە پاشا،","poem":1},{"text":"گێلێک کە تێر نان بێت،","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ئافرەتێک بێ ناز بێت و مێرد بکات،","poem":1},{"text":"کەنیزەیەک ببێت بە میراتگری خاتوونەکەی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"«چوار شت هەن لەسەر زەوی بچووکن","poem":1},{"text":"بەڵام لە دانایان داناترن:","poem":2}]},{"type":"verse","number":25,"content":[{"text":"مێروولەکان بوونەوەرێکی بێهێزن،","poem":1},{"text":"بەڵام لە هاویندا خواردنی خۆیان ئەمبار دەکەن.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"گۆڕهەڵکەنەکان گیانلەبەرێکی بێ توانان،","poem":1},{"text":"بەڵام لەناو بەرد لانەکانیان دروستدەکەن.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"کوللەکان پاشایان نییە،","poem":1},{"text":"بەڵام هەموویان پۆل پۆل دەجوڵێن.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"مارمێلکە بەدەست دەگیردرێت،","poem":1},{"text":"بەڵام لە کۆشکی پاشادا دەبینرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"«سێ شت هەن هەنگاویان سەنگینە و","poem":1},{"text":"چوارەمیش ڕۆیشتنی سەنگینە:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"شێر کە پاڵەوانی هەموو گیاندارەکانە،","poem":1},{"text":"لە ڕووی هیچ شتێک ناگەڕێتەوە،","poem":2}]},{"type":"verse","number":31,"content":[{"text":"کەڵەشێری بە فیز، تەگە،","poem":1},{"text":"پاشایەکیش لە سەرکردایەتی لەشکرەکەی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"«ئەگەر گێلایەتیت کرد بە خۆهەڵکێشانت،","poem":1},{"text":"یان پیلانی خراپت نایەوە،","poem":2},{"lineBreak":true},{"text":"دەستت بخەرە سەر دەمت!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"چونکە وەک چۆن شیر بهەژێنیت کەرەی لێ دەردەچێت و","poem":1},{"text":"لووت بهەژێنیت خوێنی لێ دێت،","poem":2},{"lineBreak":true},{"text":"تووڕەییش بهەژێنیت ناکۆکی لێ پێدا دەبێت.»","poem":2}]}],"footnotes":[{"noteId":38,"caller":"+","text":"ئیتیێل: بڕوانە نەحەمیا 11‏:7‏‏.‏","reference":{"chapter":30,"verse":1}},{"noteId":39,"caller":"+","text":"زەروو یان زێروو، جۆرە کرمێکی مشەخۆرە، هەروەها لە چارەسەرکردنی نەخۆشی بۆ مژینی خوێن بەکاردێت.‏","reference":{"chapter":30,"verse":15}},{"noteId":40,"caller":"+","text":"مەبەست لێی جووت دەبێت.‏","reference":{"chapter":30,"verse":20}}]},"thisChapterLink":"/api/ckb_bib/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}