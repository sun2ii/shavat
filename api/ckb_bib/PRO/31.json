یان تاڵە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"با بخواتەوە و هەژارییەکەی لەبیر بکات،","poem":1},{"text":"ئیتر ماندووبوونەکەی نایەتەوە یاد.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"بەرگری لە مافی ئەو کەسانە بکە کە ناتوانن داوای مافەکانیان بکەن،","poem":1},{"text":"بۆ مافی هەموو دەربەدەران.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"دەمت بکەرەوە و بە ڕاستودروستی دادوەری بکە،","poem":1},{"text":"پارێزگاری لە مافی کڵۆڵان و نەداران بکە.","poem":2}]},{"type":"heading","content":["بەشی کۆتایی31:9 هەر دێڕە هەڵبەستێک لە بەشی کۆتاییدا بە پیتێک دەستپێدەکات، بەپێی ڕیزبەندی ئەلفبێی عیبری.‏: ژنی خانەدان"]},{"type":"verse","number":10,"content":[{"text":"کێ ژنی خانەدانی دەست دەکەوێت؟","poem":1},{"text":"نرخی لە یاقووت","poem":2},{"noteId":41},{"text":"گرانترە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"مێردەکەی بە تەواوی پشتی پێ دەبەستێت و","poem":1},{"text":"لە هیچی کەم نابێت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ژنەکە بە درێژایی ژیانی","poem":1},{"text":"چاکە دێنێتە سەر ڕێی نەک خراپە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"خوری و کەتان هەڵدەبژێرێت،","poem":1},{"text":"بە دوو دەستی پەرۆشەوە ئیش دەکات.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"وەک کەشتی بازرگان وایە،","poem":1},{"text":"خۆراکی خۆی لە دوورەوە دەهێنێت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"هێشتا شەوە لە خەو هەڵدەستێت،","poem":1},{"text":"خواردن بۆ ماڵەوە ئامادە دەکات و","poem":2},{"lineBreak":true},{"text":"ئەرک بۆ کارەکەرەکان دیاری دەکات.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"لە کێڵگەیەک ورد دەبێتەوە و دەیکڕێت،","poem":1},{"text":"بە قازانجی دەستی ڕەزەمێوێک دەچێنێت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ناوقەدی توند دەبەستێت و","poem":1},{"text":"بازووی لێ هەڵدەکات.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"دەبینێت بازرگانییەکەی چاکە،","poem":1},{"text":"بە شەو چرای ناکوژێتەوە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"خوری بە بازوویەوە دەئاڵێنێت و","poem":1},{"text":"تەشی لەناو لەپیدایە.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"دەستەکانی بۆ کڵۆڵ دەکاتەوە و","poem":1},{"text":"دەست درێژ دەکات بۆ نەداران.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ترسی ماڵەکەی نییە لە بەفر،","poem":1},{"text":"چونکە هەموو ماڵەکەی بەرگی ئاڵیان","poem":2},{"noteId":42},{"text":"لەبەردایە.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"چەرچەف بۆ نوێنەکەی دروستدەکات،","poem":1},{"text":"کەتانی ناسک و ڕیسی ئەرخەوانی لەبەر دەکات.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"مێردی لە دەروازەکانی شاردا ناسراوە،","poem":1},{"text":"لەوێ لەگەڵ پیرانی شارەکە دادەنیشێت.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ژنەکە کراسی کەتان دروستدەکات و دەیفرۆشێت،","poem":1},{"text":"پشتێن بۆ بازرگانان","poem":2},{"noteId":43},{"text":"دابین دەکات.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"هێز و ڕێز بەرگی ئەون،","poem":1},{"text":"پێدەکەنێت بۆ ڕۆژانی ئاییندە.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"دەمی بە دانایی دەکاتەوە و","poem":1},{"text":"فێرکردنەکانی میهرەبانی لەسەر زمانییەتی.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"چاودێری هاتوچۆی ماڵومنداڵەکەی دەکات،","poem":1},{"text":"نانی تەمبەڵی ناخوات.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"منداڵەکانی هەڵدەستن و خۆزگەی پێ دەخوازن،","poem":1},{"text":"مێردەکەشی ستایشی دەکات:","poem":2}]},{"type":"verse","number":29,"content":[{"text":"«زۆر ژن خانەدان بوونە،","poem":1},{"text":"بەڵام تۆ لە سەرووی هەموویانی.»","poem":2}]},{"type":"verse","number":30,"content":[{"text":"شۆخ و شەنگی فریودەرە و جوانی پووچە،","poem":1},{"text":"بەڵام ئەو ئافرەتەی لە یەزدان بترسێت، ستایش دەکرێت.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ڕەنجی شانی خۆی پێ بدەن و","poem":1},{"text":"با کردەوەکانی لەبەر دەروازەکانی شاردا ستایشی بکەن.","poem":2}]}]