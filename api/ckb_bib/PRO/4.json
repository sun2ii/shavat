1},{"text":"خۆشتبوێت، چاودێریت دەکات.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئەمە دەستپێکی داناییە: دانایی بەدەستبهێنە،","poem":1},{"text":"بە هەموو دەستکەوتەکانت، تێگەیشتن بەدەستبهێنە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ڕێزی بگرە، بەرزت دەکاتەوە،","poem":1},{"text":"لە ئامێزی بگرە، شکۆدارت دەکات.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"تاجەگوڵینەی نیعمەت دەخاتە سەرت،","poem":1},{"text":"تاجی شکۆمەندیت پێ دەبەخشێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ڕۆڵە، گوێ بگرە و قسەکانم وەربگرە،","poem":1},{"text":"جا تەمەنت درێژ دەبێت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ڕێگای داناییم پیشاندایت،","poem":1},{"text":"بۆ ڕێڕەوە ڕاستەکان ڕێنماییم کردیت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لە ڕۆیشتندا هەنگاوت کورت نابێت،","poem":1},{"text":"لە ڕاکردنیشدا پێت هەڵناکەوێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"دەست بە تەمبێکردنەوە بگرە","poem":1},{"noteId":3},{"text":"و دەست شل مەکە،","poem":1},{"text":"بیپارێزە، چونکە ژیانتە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"مەچووە سەر ڕێگەی بەدکاران،","poem":1},{"text":"بە ڕێگای خراپەکاراندا مەڕۆ.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"خۆتی لێ لابدە و پێیدا مەڕۆ،","poem":1},{"text":"لێی دووربکەوە و تێپەڕە،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"چونکە خەویان لێ ناکەوێت ئەگەر خراپە نەکەن،","poem":1},{"text":"خەویان دەزڕێت ئەگەر یەکێک نەخەن.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"نانی خراپە دەخۆن و","poem":1},{"text":"شەرابی ستەمکاری دەخۆنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ڕێچکەی ڕاستودروستان وەک ڕووناکی بەرەبەیانە،","poem":1},{"text":"ڕووناکتر و ڕووناکتر دەبێت هەتا دەبێتە ڕۆژی تەواو.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بەڵام ڕێگای بەدکاران وەک تاریکستانە،","poem":1},{"text":"نازانن پێیان لە چی هەڵدەکەوێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ڕۆڵە، سەرنج بدە وشەکانم،","poem":1},{"text":"گوێ بۆ قسەکانم شل بکە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لەبەرچاوت دوورنەکەونەوە،","poem":1},{"text":"لە ناخی دڵت بیانپارێزە،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"چونکە ژیانن بۆ ئەو کەسەی دەیاندۆزێتەوە،","poem":1},{"text":"دەرمانە بۆ هەموو لەشی.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"لە سەرووی هەموو چاودێرییەکەوە دڵت بپارێزە،","poem":1},{"text":"چونکە دڵ سەرچاوەی ژیانە.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"خواری لە دەمت داماڵە و","poem":1},{"text":"چەوتی لە لێوانت دووربخەوە.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"با چاوەکانت تەماشای پێشت بکەن و","poem":1},{"text":"پێڵووەکانت ڕێک بۆ بەردەمت بێت.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ڕێڕەوی بەرپێت خۆش بکە،","poem":1},{"text":"هەموو ڕێگاکانت دەچەسپێن.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"بەلای ڕاست یان چەپدا لامەدە،","poem":1},{"text":"پێت لە خراپە دووربخەوە.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"بە تەمبێکردن ڕازی بە.‏","reference":{"chapter":4,"verse":13}}]},"thisChapterLink":"/api/ckb_bib/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}