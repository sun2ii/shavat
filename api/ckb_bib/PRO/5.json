{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PRO","translationId":"ckb_bib","name":"پەندەکانی سلێمان","commonName":"پەندەکانی سلێمان","title":"پەندەکانی سلێمان","order":20,"numberOfChapters":31,"sha256":"416b935a4d807fe1bccabcaa1c43659660fdf6e1d0a1ccbd1460d52126cab4ac","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ckb_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["ئاگادارکردنەوە لە داوێنپیسی"]},{"type":"verse","number":1,"content":[{"text":"ڕۆڵە، سەرنج بدە داناییم،","poem":1},{"text":"گوێ بۆ تێگەیشتنم شل بکە،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"تاکو سەلیقەت بپارێزیت و","poem":1},{"text":"لێوەکانت ئاگایان لە زانیاری بێت،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"چونکە لێوەکانی ژنی داوێنپیس هەنگوینیان لێ دەتکێت،","poem":1},{"text":"قسەی لە ڕۆن لووسترە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بەڵام کۆتاییەکەی وەک زەقنەبووت تاڵە،","poem":1},{"text":"وەک شمشێری دوو دەم تیژە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"پێیەکانی بەرەو خوار دەبنەوە بۆ مردن،","poem":1},{"text":"هەنگاوەکانی پەیوەستن بە جیهانی مردووانەوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"سەرنج ناداتە ڕێچکەی ژیان،","poem":1},{"text":"هەنگاوەکانی خوارە بەڵام ئەو نازانێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئەی کوڕینە، ئێستاش گوێم لێ بگرن،","poem":1},{"text":"لە قسەی دەمم خۆتان لامەدەن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ڕێگای خۆتی لێ دووربخەوە،","poem":1},{"text":"لە دەرگای ماڵەکەی نزیک مەبەوە،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"نەوەک شکۆمەندیت بە خەڵکی دیکە بدەیت و","poem":1},{"text":"ساڵانی تەمەنت بە کەسی دڵڕەق،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"نەوەک بێگانەکان لە توانات تێر بن و","poem":1},{"text":"بەری ماندووبوونت بۆ ماڵی نامۆیەک بڕوات.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لە کۆتایی ژیانتدا دەناڵێنیت،","poem":1},{"text":"کاتێک گۆشت و جەستەت لەناودەچێت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"دەڵێیت: «چۆن ڕقم لە تەمبێکردن دەبووەوە،","poem":1},{"text":"دڵم گاڵتەی بە سەرزەنشت دەهات.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"گوێڕایەڵی ئەوانە نەبووم کە ڕێنماییان دەکردم و","poem":1},{"text":"گوێم بۆ مامۆستاکانم شل نەکرد.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"کەمێکی مابوو بکەومە ناو هەموو خراپەیەکەوە،","poem":1},{"text":"لەناو کۆڕ و کۆمەڵدا.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"لە ئەمباراوی خۆت ئاو بخۆوە،","poem":1},{"text":"لە ئاوی هەڵقوڵاوی بیرەکەت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئایا کانییەکانت بڕژێتە سەر شەقامەکان،","poem":1},{"text":"جۆگەی ئاو بێت لە گۆڕەپانەکان؟","poem":2}]},{"type":"verse","number":17,"content":[{"text":"با تەنها بۆ تۆ بێت،","poem":1},{"text":"بێگانەت لەگەڵدا نەبێت.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"با کانیاوەکەت بەرەکەتدار بێت،","poem":1},{"text":"بە هاوسەری گەنجییەتیت دڵخۆش بە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئاسکێکی خۆشەویست و مامزێکی شۆخ و شەنگ،","poem":1},{"text":"با هەموو کاتێک مەمکەکانی تێرت بکەن،","poem":2},{"lineBreak":true},{"text":"بە خۆشەویستی ئەو هەمیشە وێڵ بیت.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"کوڕی خۆم، ئیتر بۆچی وێڵی ژنی بەدڕەوشت دەبیت؟","poem":1},{"text":"بۆچی ژنی داوێنپیس لە باوەش دەگریت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ڕێگاکانی مرۆڤ لەبەرچاوی یەزدانە،","poem":1},{"text":"هەموو ڕێڕەوەکانی هەڵدەسەنگێنێت.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بەدکار بە تاوانەکانی خۆیەوە پێوەبوو،","poem":1},{"text":"بە داوی گوناهەکانی خۆیەوە دەبێت.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"لەبەر نەبوونی تەمبێکردن دەمرێت،","poem":1},{"text":"لەبەر زۆری دەبەنگییەکەی سەرگەردان دەبێت.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}