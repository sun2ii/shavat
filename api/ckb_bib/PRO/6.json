er":30,"content":[{"text":"سووکایەتی بە دز ناکرێت کە دزی دەکات","poem":1},{"text":"بۆ خۆتێرکردن کاتێک کە برسییە.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"هەرچەندە کە لێی ئاشکرا بوو دەبێت حەوت قات بداتەوە،","poem":1},{"text":"ئەگەر هەموو ماڵی خۆشی لەسەر دانابێت.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"بەڵام ئەوەی داوێنپیسی لەگەڵ ژنێک بکات تێنەگەیشتووە،","poem":1},{"text":"هەرکەسێک وا بکات خۆی دەفەوتێنێت.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"تووشی لێدان و سەرشۆڕی دەبێت و","poem":1},{"text":"شەرمەزارییەکەی ناسڕێتەوە،","poem":2}]},{"type":"verse","number":34,"content":[{"text":"چونکە ئیرەیی پیاو دەوروژێنێت،","poem":1},{"text":"لە ڕۆژی تۆڵەدا دەست ناگێڕێتەوە،","poem":2}]},{"type":"verse","number":35,"content":[{"text":"چاوی لە هیچ قەرەبووێک نییە،","poem":1},{"text":"بە دیاری ڕازی نابێت، ئەگەر بۆشی زیاد بکەیت.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"تەوقەکردن بە مەبەستی ڕێککەوتن بەبێ هیچ بەڵگەنامەیەک.‏","reference":{"chapter":6,"verse":1}},{"noteId":5,"caller":"+","text":"دەربڕینێکی عیبرییە بۆ دووپاتکردنەوە بۆ ژمارە حەوت.‏","reference":{"chapter":6,"verse":16}}]},"thisChapterLink":"/api/ckb_bib/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}