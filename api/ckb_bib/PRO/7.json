"noteId":6},{"text":"ڕوانیم،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لەناو ساویلکەکاندا بینیم،","poem":1},{"text":"لەناو کوڕاندا سەرنجم دا گەنجێکی تێنەگەیشتوو.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"لە شەقامەکە پەڕییەوە و لایدا لای ژنە بەدڕەوشتەکە،","poem":1},{"text":"ڕێگای ماڵی ئەوی دەگرتەبەر،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"لە زەردەپەڕی ئێواران کاتی ئاوابوونی خۆر،","poem":1},{"text":"لەژێر تاریکایی شەو.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ئەوەتا ژنێک بەرەوپیری چوو،","poem":1},{"text":"لە بەرگی لەشفرۆشێکی فێڵبازدا بوو.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"(ئەم ژنە بە دەنگەدەنگ و سەرکێشە،","poem":1},{"text":"پێیەکانی لە ماڵی خۆی گیرنابێت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"پێیەکی لە شەقام و پێیەکی لە گۆڕەپانەکانە،","poem":1},{"text":"لە هەموو پەنایەک بۆسە دەنێتەوە.)","poem":2}]},{"type":"verse","number":13,"content":[{"text":"گەنجەکەی گرت و ماچی کرد،","poem":1},{"text":"بێ ئابڕووانە پێی گوت:","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«قوربانی هاوبەشیم","poem":1},{"noteId":7},{"text":"لەسەرە،","poem":1},{"text":"ئەمڕۆ نەزرەکانی","poem":2},{"noteId":8},{"text":"خۆمم بەجێهێنا،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بۆیە بۆ دیدەنیت هاتمە دەرەوە،","poem":1},{"text":"بۆ دیداری ڕووی تۆ و بۆ دۆزینەوەت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"نوێنم لەسەر قەرەوێڵەکەم ڕاخستووە،","poem":1},{"text":"کەتانی ڕەنگاوڕەنگی میسری،","poem":2}]},{"type":"verse","number":17,"content":[{"text":"نوێنەکەم بۆنخۆش کردووە","poem":1},{"text":"بە موڕ و ئەلوا","poem":2},{"noteId":9},{"text":"و دارچین","poem":2},{"noteId":10},{"text":".","poem":2}]},{"type":"verse","number":18,"content":[{"text":"وەرە هەتا بەیانی ئەوین بنۆشین،","poem":1},{"text":"بە خۆشەویستی چێژ وەربگرین،","poem":2}]},{"type":"verse","number":19,"content":[{"text":"چونکە مێردەکەم لە ماڵەوە نییە،","poem":1},{"text":"چووەتە ڕێگایەکی دوور.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"کیسە زیوی لەگەڵ خۆی بردووە،","poem":1},{"text":"هەتا مانگ نەبێت بە چواردە ناگەڕێتەوە ماڵ.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"بە زۆری مەکرەکانی لەخشتەی برد،","poem":1},{"text":"بە قسە لووسەکانی زەوقی هەستاند.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"لەناکاو بەدوایدا ڕۆیشت،","poem":1},{"text":"وەک گایەک بۆ سەربڕین ببردرێت،","poem":2},{"lineBreak":true},{"text":"وەک مامز دەکەوێتە ناو تەڵە،","poem":2}]},{"type":"verse","number":23,"content":[{"text":"هەتا تیرێک جەرگی ببڕێت،","poem":1},{"text":"وەک پەلەکردنی باڵدار بۆ داو،","poem":2},{"lineBreak":true},{"text":"کە نازانێ بۆ گیانی خۆیەتی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ئەی کوڕینە، ئێستاش گوێم لێ بگرن،","poem":1},{"text":"سەرنج بدەنە قسەکانی دەمم.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"با دڵت بەرەو ڕێگاکانی ئەو ژنە لانەدات،","poem":1},{"text":"لە ڕێبازەکانی گومڕا مەبە،","poem":2}]},{"type":"verse","number":26,"content":[{"text":"چونکە زۆرن ئەوانەی بە برینداری بەریداونەتەوە،","poem":1},{"text":"هەموو ئەوانەی بە دەستی کوژراون کۆمەڵی گەورەن.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ماڵەکەی ڕێگای جیهانی مردووانە،","poem":1},{"text":"شۆڕبوونەوەیە بۆ ژوورەکانی مەرگ.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"وەک پەنجەرەیە، دەلاقەیەکە بۆ هاتوچۆی هەوا و گێڕانەوەی تیشکی خۆر.‏","reference":{"chapter":7,"verse":6}},{"noteId":7,"caller":"+","text":"قوربانی هاوبەشی: ئەم قوربانییە هاودەمی قوربانی سووتاندن بوو. تەنها یەک کەس هەڵدەستا بە دابینکردنی ئەم قوربانییە، بەڵام لەگەڵ خەڵکی دیکە بەشی زۆری ئەم قوربانییەیان لەبەردەم خودا دەخوارد وەک هێمایەک بۆ پێکەوە ژیان. بڕوانە لێڤییەکان 7‏:11‏-15.‏‏","reference":{"chapter":7,"verse":14}},{"noteId":8,"caller":"+","text":"نەزر: کارەکە پابەند دەکەیت بە مەرجێکەوە. داوا دەکەیت ئەگەر خودا کارێکت بۆ ئەنجام بدات، ئەوا تۆش ئەو کارەی بۆ ئەنجام دەدەی کە پابەندت کردووە بە مەرجەکەوە. بڕوانە سەرژمێری 21‏:2‏‏.‏","reference":{"chapter":7,"verse":14}},{"noteId":9,"caller":"+","text":"ڕووەکێکی دڕکاوییە وەک سەباڕ، شلەیەکی تێدایە بۆ پێست باشە.‏","reference":{"chapter":7,"verse":17}},{"noteId":10,"caller":"+","text":"لەو جۆرە بۆنوبەرامانە بوونە کە بۆ بۆنخۆشکردن بەکارهێنراون.‏","reference":{"chapter":7,"verse":17}}]},"thisChapterLink":"/api/ckb_bib/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}