{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PRO","translationId":"ckb_bib","name":"پەندەکانی سلێمان","commonName":"پەندەکانی سلێمان","title":"پەندەکانی سلێمان","order":20,"numberOfChapters":31,"sha256":"416b935a4d807fe1bccabcaa1c43659660fdf6e1d0a1ccbd1460d52126cab4ac","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/ckb_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["بانگەوازی دانایی"]},{"type":"verse","number":1,"content":[{"text":"ئایا دانایی بانگەواز ناکات؟","poem":1},{"text":"ئەی تێگەیشتن دەنگی خۆی هەڵنابڕێت؟","poem":2}]},{"type":"verse","number":2,"content":[{"text":"لەسەر لووتکەی بەرزاییەکان،","poem":1},{"text":"لەسەر ڕێگاکان، لە چواڕیانەکان ڕادەوەستێت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لەلای دەروازەی شارەکان،","poem":1},{"text":"لەبەردەم دەرگاکان، هاوار دەکات:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"«ئەی خەڵکینە، بۆ ئێوە بانگ دەکەم،","poem":1},{"text":"دەنگم بۆ ئادەمیزادە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ساویلکەکان، فێری ژیری بن،","poem":1},{"text":"گێلەکان، فێری تێگەیشتن بن.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"گوێ بگرن، چونکە باسی شتی بەرزتان بۆ دەکەم،","poem":1},{"text":"کردنەوەی لێوەکانم بۆ ڕاستەڕێییە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ڕاستگۆیی وێردی دەممە،","poem":1},{"text":"خراپەش قێزەونە بۆ لێوەکانم.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"قسەکانی دەمم هەموو ڕاستودروستن،","poem":1},{"text":"هیچ فێڵ یان خواروخێچی تێدا نییە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"هەموو ڕێکن لای کەسی تێگەیشتوو،","poem":1},{"text":"ڕاستەڕێیە لای ئەوانەی زانیاری دەدۆزنەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"تەمبێکردن لە من وەربگرن نەک زیو،","poem":1},{"text":"زانیاریش زیاتر لە زێڕی پوختەکراو،","poem":2}]},{"type":"verse","number":11,"content":[{"text":"چونکە دانایی لە یاقووت","poem":1},{"noteId":11},{"text":"باشترە،","poem":1},{"text":"هەرچی ئارەزووی دەکەیت نابێتە هاوتای.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«من داناییم، لەگەڵ ژیریدا نیشتەجێم،","poem":1},{"text":"زانیاری و سەلیقەم هەیە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەوەی لەخواترس بێت، ڕقی لە خراپە دەبێت،","poem":1},{"text":"من ڕقم لە لووتبەرزی و خۆبەزلزانییە،","poem":2},{"lineBreak":true},{"text":"لە ڕێگای خراپ و لە قسەی بە فێڵە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ڕاوێژ و دانایی تەواو هی منن،","poem":1},{"text":"تێگەیشتن هی منە، هێز هی منە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بە منەوە پاشاکان پاشایەتی دەکەن و","poem":1},{"text":"فەرمانڕەوایان بە ڕاستودروستی یاسا دەردەکەن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بە منەوە میرەکان میرایەتی دەکەن،","poem":1},{"text":"بەگەکان و هەموو ئەوانەی بە ڕاستودروستی دادوەری دەکەن.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"من ئەوانەم خۆشدەوێت کە منیان خۆشدەوێ،","poem":1},{"text":"ئەوانەش کە بە پەرۆشەوە بەدوامدا دەگەڕێن، دەمدۆزنەوە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"دەوڵەمەندی و ڕێزداری لەلای منە،","poem":1},{"text":"ڕاستودروستی","poem":2},{"noteId":12},{"text":"و ئەو سامانەی کە دەمێنێتەوە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بەرهەمی من لە زێڕ باشترە، لە زێڕی بێگەردیش،","poem":1},{"text":"دەغڵیشم لە زیوی پوختەکراو باشترە.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"بە ڕێچکەی ڕاستودروستیدا دەڕۆم،","poem":1},{"text":"لەسەر ڕێبازی دادپەروەری،","poem":2}]},{"type":"verse","number":21,"content":[{"text":"تاکو سامان بکەمە میرات بۆ ئەوانەی منیان خۆشدەوێت و","poem":1},{"text":"ئەمبارەکانیان پڕ بکەم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«یەزدان لە سەرەتای بەدیهێنانەکەی منی دروستکرد،","poem":1},{"text":"هەر لە کۆنەوە لەپێش کارەکانی.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"لە ئەزەلەوە من دامەزراوم،","poem":1},{"text":"لە سەرەتاوە، لەپێش زەوی.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"هێشتا زەریاکان نەببوون من بەدیهێنراوم،","poem":1},{"text":"هێشتا کانییە پڕ ئاوەکان نەبوون.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"پێش ئەوەی چیاکان بچەسپێن،","poem":1},{"text":"پێش گردەکان، من بەدیهێنراوم،","poem":2}]},{"type":"verse","number":26,"content":[{"text":"هێشتا نە زەوی و نە پانتاییەکانی دروستکردبوو،","poem":1},{"text":"نە سەرەتای خۆڵی زەوی.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"کاتێک کە ئاسمانی جێگیر کرد من لەوێ بووم،","poem":1},{"text":"کاتێک کە هێڵی ئاسۆی بەسەر قووڵاییدا کێشا،","poem":2}]},{"type":"verse","number":28,"content":[{"text":"کاتێک کە هەوری لە ئاسمان ڕاگرت و","poem":1},{"text":"سەرچاوەی قووڵاییەکانی چەسپاند،","poem":2}]},{"type":"verse","number":29,"content":[{"text":"کاتێک کە سنووری بۆ دەریا کێشا","poem":1},{"text":"بۆ ئەوەی ئاوەکان فەرمانی ئەو نەشکێنن،","poem":2},{"lineBreak":true},{"text":"کاتێک کە بناغەی زەوی داڕشت.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"لەگەڵ ئەو وەستایەکی لێزان بووم،","poem":1},{"text":"ڕۆژبەڕۆژ شادمانی ئەو بووم،","poem":2},{"lineBreak":true},{"text":"هەمیشە لەبەردەمیدا دڵخۆش بووم،","poem":2}]},{"type":"verse","number":31,"content":[{"text":"لە زەوییە ئاوەدانەکەی دڵخۆش دەبووم،","poem":1},{"text":"لەگەڵ ئادەمیزاد شادمان بووم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"«ئەی کوڕینە، ئێستاش گوێم لێ بگرن،","poem":1},{"text":"خۆزگە دەخوازرێ بەوانەی ڕێگای من دەپارێزن.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"گوێ لە تەمبێکردن بگرن و دانا بن،","poem":1},{"text":"پشت گوێی مەخەن.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"خۆزگە دەخوازرێ بەو کەسەی گوێم لێ دەگرێت،","poem":1},{"text":"ڕۆژبەڕۆژ لەلای دەرگاکەم ئاگادارە،","poem":2},{"lineBreak":true},{"text":"لەلای دەروازەی دەرگاکەم ئێشک دەگرێت،","poem":2}]},{"type":"verse","number":35,"content":[{"text":"چونکە ئەوەی من بدۆزێتەوە، ژیان دەدۆزێتەوە،","poem":1},{"text":"ڕەزامەندی یەزدانیش بەدەستدەهێنێت.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"بەڵام ئەوەی من نەدۆزێتەوە زیان بە خۆی دەگەیەنێت،","poem":1},{"text":"هەموو ئەوانەی ڕقیان لە منە، مردنیان خۆشدەوێت.»","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"یاقووت: گەوهەری سووری تۆخ.‏","reference":{"chapter":8,"verse":11}},{"noteId":12,"caller":"+","text":"مەبەستی لە بەرهەمی ڕاستودروستە.‏","reference":{"chapter":8,"verse":18}}]},"thisChapterLink":"/api/ckb_bib/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}