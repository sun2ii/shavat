{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"hebrew_subtitle","content":["نوێژی هەژارێکی ورەڕووخاو، کە هاواری دەباتە بەردەم یەزدان."]},{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، گوێ لە نوێژم بگرە،","poem":1},{"text":"با هاوارم بگاتە لات.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"لە ڕۆژی تەنگانەدا ڕووی خۆتم لێ مەشارەوە،","poem":1},{"text":"لەو ڕۆژەی کە هاوارت بۆ دەکەم گوێم بۆ شل بکە،","poem":2},{"lineBreak":true},{"text":"زوو وەڵامم بدەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ڕۆژگارم وەک دووکەڵ ڕەوییەوە،","poem":1},{"text":"ئێسکم وەک پشکۆ گڕی گرتووە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"هەڵپڕووکاوە، دڵم وشک بووەتەوە،","poem":1},{"text":"نانخواردنم لەبیر نەماوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لە دەنگی ناڵەم","poem":1},{"text":"ئێسکم بە پێستمەوە نووساوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"وەک کوندەپەپووی بیابانم لێهاتووە لە چۆڵەوانیدا،","poem":1},{"text":"وەک کوندەپەپووی کەلاوەم لێهاتووە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ڕادەکشێم و","poem":1},{"text":"وەک چۆلەکەیەکی تەنهای سەربانم لێهاتووە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بە درێژایی ڕۆژ دوژمنەکانم سووکایەتیم پێ دەکەن،","poem":1},{"text":"ئەوانەی لە دژی منن وەک شێتیان لێ هاتووە، نەفرەتم لێدەکەن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بۆیە خۆڵەمێش دەخۆم وەک نان،","poem":1},{"text":"فرمێسکم تێکەڵ بە خواردنەوەم بووە،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لەبەر تووڕەیی زۆری تۆ،","poem":1},{"text":"چونکە هەڵتگرتم و فڕێتدام.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ڕۆژگارم وەک سێبەری خوارە،","poem":1},{"text":"خۆشم وەک گیا وشک دەبمەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"تۆش ئەی یەزدان، هەتاهەتایە لەسەر تەختی،","poem":1},{"text":"نەوە دوای نەوە یادت دەکەنەوە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"تۆ هەڵدەستیت و بەزەییت بە سییۆن دێتەوە،","poem":1},{"text":"چونکە ماوەی میهرەبانییە، کاتی هاتووە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"خزمەتکارەکانت بە تاسەوەن بۆ بەردەکانی،","poem":1},{"text":"دڵیان دەسووتێ بۆ خۆڵەکەی.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"هەموو نەتەوەکان لە ناوی یەزدان دەترسن،","poem":1},{"text":"هەموو پاشاکانی زەویش لە شکۆمەندیت،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"چونکە کە یەزدان سییۆن بنیاد دەنێتەوە،","poem":1},{"text":"بە شکۆمەندی خۆی دەبینرێت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئاوڕ لە نوێژی ڕووتوڕەجاڵەکان دەداتەوە،","poem":1},{"text":"نوێژەکانیان بە کەم نازانێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ئەمە بۆ نەوەی داهاتوو دەنووسرێت،","poem":1},{"text":"تاکو ئەو نەوەیە ستایشی یەزدان بکەن، کە هێشتا لەدایک نەبوونە:","poem":2}]},{"type":"verse","number":19,"content":[{"text":"«یەزدان لە بەرزایی پیرۆزگای خۆیەوە دەڕوانێتە خوارێ،","poem":1},{"text":"لە ئاسمانەوە سەیری زەوی دەکات،","poem":2}]},{"type":"verse","number":20,"content":[{"text":"بۆ ئەوەی گوێی لە ناڵەی دیلەکان بێت،","poem":1},{"text":"ئەوانە ئازاد بکات کە دراونەتە دەست مردن.»","poem":2}]},{"type":"verse","number":21,"content":[{"text":"جا لە سییۆن ناوی یەزدان ڕادەگەیەنرێت،","poem":1},{"text":"لە ئۆرشەلیم ستایشی،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"کاتێک گەلان و پاشایەتییەکان","poem":1},{"text":"پێکەوە بۆ پەرستنی یەزدان کۆدەبنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"لە ناوەڕاستی تەمەنم هێزی کزکردم،","poem":1},{"text":"ڕۆژگاری کورتکردم.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"گوتی: «ئەی خودای من، لە ناوەڕاستی ڕۆژگارم لام مەدە،","poem":1},{"text":"ساڵانی تۆ بۆ نەوە دوای نەوەیە.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"لە سەرەتاوە بناغەی زەویت دانا،","poem":1},{"text":"ئاسمانیش دەستکردی تۆیە.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ئەوان لەناودەچن، بەڵام تۆ دەمێنیت،","poem":1},{"text":"هەموو وەک کراس کۆن دەبن،","poem":2},{"lineBreak":true},{"text":"وەک جلوبەرگ دەیانگۆڕیت و فڕێدەدرێن.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"بەڵام تۆ هەروەک خۆتی،","poem":1},{"text":"ساڵانی تۆ کۆتایی نایەت.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"کوڕی خزمەتکارەکانت نیشتەجێ دەبن و","poem":1},{"text":"نەوەکانیان لەبەردەمت دەچەسپێن.»","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}