{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":103,"content":[{"type":"hebrew_subtitle","content":["گۆرانییەکی داود."]},{"type":"verse","number":1,"content":[{"text":"ئەی گیانی من، ستایشی یەزدان بکە،","poem":1},{"text":"هەموو ناخیشم ستایشی ناوی پیرۆزی بکە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەی گیانی من، ستایشی یەزدان بکە،","poem":1},{"text":"هیچ چاکەیەکی لەبیر مەکە:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئەوەی لە هەموو گوناهێکت خۆشدەبێت،","poem":1},{"text":"لە هەموو نەخۆشییەک چاکت دەکاتەوە،","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەوەی ژیانت لە گۆڕ دەکڕێتەوە،","poem":1},{"text":"خۆشەویستی نەگۆڕ و بەزەیی دەکاتە تاجی سەرت،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەوەی تەمەنت تێر دەکات بە چاکە،","poem":1},{"text":"تاکو گەنجییەتیت وەک هەڵۆ نوێ ببێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"یەزدان ڕاستودروستی ئەنجام دەدات،","poem":1},{"text":"دادپەروەری بۆ هەموو چەوساوەکان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ڕێگای خۆی بە موسا ناساند،","poem":1},{"text":"کردارەکانی بە نەوەکانی ئیسرائیل:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"یەزدان میهرەبان و بە بەزەییە،","poem":1},{"text":"پشوودرێژە و خۆشەویستی نەگۆڕی زۆرە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"تاوانبارکردنی هەتاسەر نییە،","poem":1},{"text":"تووڕەیی هەتاهەتایە نییە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بە گوناهی خۆمان لەگەڵ ناکات و","poem":1},{"text":"بەگوێرەی تاوانەکانمان سزامان ناداتەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"وەک بەرزی ئاسمان لەسەر زەوییەوە،","poem":1},{"text":"خۆشەویستییە نەگۆڕەکەی زۆرکردووە بۆ ئەوانەی کە لێی دەترسن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"وەک دووری ڕۆژهەڵات لە ڕۆژئاواوە،","poem":1},{"text":"یاخیبوونەکانمانی لێ دوورخستووینەتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"وەک باوک چۆن بەزەیی بە منداڵەکانیدا دێتەوە،","poem":1},{"text":"یەزدانیش ئاوا بەزەیی بەوانەدا دێتەوە کە لێی دەترسن،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"چونکە دەزانێت ئێمە چۆن پێکهێنراوین،","poem":1},{"text":"لەبیریەتی کە ئێمە خۆڵین.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"مرۆڤ ڕۆژگاری ژیانی وەک گیا وایە،","poem":1},{"text":"وەک گوڵی ناو کێڵگە گوڵ دەکات،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بایەک بەسەریدا هەڵبکات، ئیتر نامێنێت،","poem":1},{"text":"ئاسەواریشی دیار نابێت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"بەڵام خۆشەویستی نەگۆڕی یەزدان لە ئەزەلەوە و","poem":1},{"text":"هەتاهەتایە بۆ ئەوانەیە کە ترسی ئەویان لە دڵدایە،","poem":2},{"lineBreak":true},{"text":"ڕاستودروستییەکەشی بۆ نەوەکانە،","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بۆ ئەوانەی پەیمانی بەجێدەگەیەنن،","poem":1},{"text":"ئەوانەی ڕێنماییەکانی ئەویان لەبیرە بۆ ئەوەی پەیڕەوی بکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"یەزدان تەختی خۆی لە ئاسمان چەسپاندووە و","poem":1},{"text":"پاشایەتییەکەشی بەسەر هەمووانەوە فەرمانڕەوایەتی دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ئەی فریشتەکانی یەزدان، ستایشی بکەن،","poem":1},{"text":"ئەی ئەو بەهێزانەی وتەکانی بەجێدەهێنن،","poem":2},{"lineBreak":true},{"text":"ئەی ئەوانەی گوێڕایەڵی وتەی ئەو دەبن.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئەی هەموو سوپاکانی، ستایشی یەزدان بکەن،","poem":1},{"text":"ئەی خزمەتکارانی کە بە ڕەزامەندی ئەو کار دەکەن.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ئەی هەموو کارەکانی، ستایشی یەزدان بکەن","poem":1},{"text":"لە هەموو شوێنێکی ژێر دەسەڵاتی.","poem":2},{"lineBreak":true},{"text":"ئەی گیانی من، ستایشی یەزدان بکە.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}