ۆ وەک کراس زەویت بە دەریای قووڵ داپۆشی،","poem":1},{"text":"لەسەر چیاکان ئاوەکان ڕادەوەستن.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بەڵام لە سەرزەنشتی تۆ ئاوەکان هەڵاتن،","poem":1},{"text":"لە گرمەی دەنگی تۆ بە ترسەوە ڕایانکرد،","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بەسەر چیاکان کەوتن و","poem":1},{"text":"شۆڕ بوونەوە ناو دۆڵەکان،","poem":2},{"lineBreak":true},{"text":"بۆ ئەو شوێنەی تۆ بۆت دامەزراندبوون.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"سنوورێکت دانا لێی تێنەپەڕن،","poem":1},{"text":"نەگەڕێنەوە هەتا زەوی دابپۆشن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"کانیاو لە شیوەکان دەتەقێنیتەوە،","poem":1},{"text":"بۆ ئەوەی لەنێوان چیاکاندا بڕۆن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"هەموو زیندەوەرێکی دەشتودەر ئاودەدەن،","poem":1},{"text":"کەرەکێوییەکان تینووێتی خۆیانی پێ دەشکێنن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"باڵندەی ئاسمان هێلانەی تێدا دەکات،","poem":1},{"text":"لەناو چڵەکان دەخوێنێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لە بەیتوونەکەی خۆتەوە چیاکان ئاو دەدەیت،","poem":1},{"text":"زەوی لە بەروبوومی کردەوەکانت تێر دەبێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"گیا بۆ ئاژەڵی ماڵی دەڕوێنیت،","poem":1},{"text":"سەوزە بۆ خزمەتی مرۆڤ،","poem":2},{"lineBreak":true},{"text":"بۆ دەرهێنانی نان لە زەوییەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"مەی پێ دەبەخشی بۆ ئەوەی دڵی مرۆڤ خۆش بکەی،","poem":1},{"text":"ڕۆن بۆ درەوشانەوەی زیاتری ڕووی،","poem":2},{"lineBreak":true},{"text":"نان بۆ پتەوکردنی دڵی مرۆڤ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"درەختەکانی یەزدان تێر دەبن،","poem":1},{"text":"ئەو داری ئورزەی لوبنان کە چاندی،","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئەوەی چۆلەکە هێلانەی تێدا دەکات،","poem":1},{"text":"لەقلەقیش داری سنەوبەر ماڵیەتی،","poem":2}]},{"type":"verse","number":18,"content":[{"text":"چیای بەرزیش بۆ بزنە کێوی،","poem":1},{"text":"تاشەبەردەکانیش پەناگای گۆڕهەڵکەنە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"مانگت دروستکرد بۆ دیاریکردنی وەرزەکان،","poem":1},{"text":"خۆریش ئاوابوونی خۆی دەزانێت.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"تاریکی دادێنێت دەبێت بە شەو،","poem":1},{"text":"هەموو زیندەوەری دارستان تێیدا دەکەونە جموجۆڵ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"بەچکە شێر بۆ نێچیر دەنەڕێنن،","poem":1},{"text":"بۆ داواکردنی خواردنیان لە خودا.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"کە ڕۆژ هەڵدێت دەکشێنەوە،","poem":1},{"text":"لەناو لانەکانیان خۆیان مات دەکەن.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"مرۆڤ دەچێت بۆ ئیشوکاری،","poem":1},{"text":"بۆ ڕەنجکێشییەکەی هەتا ئێوارە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ئەی یەزدان، کردەوەکانت چەندە زۆرن!","poem":1},{"text":"هەموویت بە دانایی دروستکردووە،","poem":2},{"lineBreak":true},{"text":"زەوی پڕە لە دەستکردی تۆ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ئەم دەریا گەورە و فراوانە،","poem":1},{"text":"کە بێشومار گیانداری گەورە و بچووکی تێدا جمەی دێت.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"لەوێ کەشتییەکان دەڕۆن،","poem":1},{"text":"لیڤیاتان","poem":2},{"noteId":173},{"text":"، ئەمەی خۆت بەدیت هێناوە بۆ ئەوەی یاری تێدا بکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ئەمانە هەمووی چاویان لە تۆیە،","poem":1},{"text":"بۆ ئەوەی لە کاتی خۆی خواردنیان بدەیتێ،","poem":2}]},{"type":"verse","number":28,"content":[{"text":"پێیان دەدەیت و وەریدەگرن،","poem":1},{"text":"دەستت دەکەیتەوە تێر چاکە دەبن.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ڕوو وەردەگێڕیت، دەتۆقن،","poem":1},{"text":"هەناسەیان لێ دەبڕیت، دەمرن،","poem":2},{"lineBreak":true},{"text":"دەگەڕێنەوە بۆ خۆڵی خۆیان.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"کاتێک ڕۆحی خۆت دەنێریت،","poem":1},{"text":"ئەوان بەدیدەهێنرێن،","poem":2},{"lineBreak":true},{"text":"ڕووی زەوی نوێ دەکەیتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"با شکۆی یەزدان هەتاهەتایە بەردەوام بێت،","poem":1},{"text":"با یەزدان بە کارەکانی خۆی دڵخۆش بێت.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ئەوەی سەیری زەوی دەکات، لەرز دەیگرێت،","poem":1},{"text":"دەست دەداتە چیاکان، دووکەڵ دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"بە درێژایی ژیانم گۆرانی بۆ یەزدان دەڵێم،","poem":1},{"text":"تاکو ماوم سروود بۆ خودای خۆم دەڵێم.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"با بیرکردنەوەم شیرین بێت لەلای،","poem":1},{"text":"منیش بە یەزدان دڵخۆش دەبم.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"بەڵام با گوناهباران لەسەر زەوی دواییان ببڕێتەوە،","poem":1},{"text":"با بەدکاران ئیتر نەمێنن.","poem":2},{"lineBreak":true},{"text":"ئەی گیانی من، ستایشی یەزدان بکە.","poem":1},{"lineBreak":true},{"text":"هەلیلویا!","poem":1},{"noteId":174}]}],"footnotes":[{"noteId":173,"caller":"+","text":"جۆرە ئەژدیهایەکە، بڕوانە ئەیوب 41‏:1‏‏.‏","reference":{"chapter":104,"verse":26}},{"noteId":174,"caller":"+","text":"وشەیەکی عیبرییە بە واتای (ستایشی یەزدان بکەن).‏","reference":{"chapter":104,"verse":35}}]},"thisChapterLink":"/api/ckb_bib/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}