:7,"content":[{"text":"ئەو یەزدانی پەروەردگارمانە،","poem":1},{"text":"حوکمەکانیشی لە سەراپای زەوییە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"بۆ هەتاهەتایە پەیمانەکەی لە یادە،","poem":1},{"text":"ئەو بەڵێنەی دەیدات بۆ هەزار پشتە،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەو پەیمانەی لەگەڵ ئیبراهیم بەستی،","poem":1},{"text":"ئەو سوێندەی بۆ ئیسحاقی خوارد.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"وەک فەرز بۆ یاقوب چەسپاندی،","poem":1},{"text":"وەک پەیمانێکی هەمیشەیی بۆ ئیسرائیل.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"فەرموویەتی: «خاکی کەنعان","poem":1},{"noteId":175},{"text":"دەدەمە تۆ،","poem":1},{"text":"بەشە میراتی خۆتانە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ئەو کاتەی ژمارەیان کەم بوو،","poem":1},{"text":"کەم و نامۆ بوون لەو خاکە،","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لە نەتەوەیەکەوە دەچوونە نەتەوەیەکی دیکە،","poem":1},{"text":"لە پاشایەتییەکەوە بۆ گەلێکی دیکە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"لێ نەگەڕا کەس ستەمیان لێ بکات،","poem":1},{"text":"بەڵکو لەبەر ئەوان پاشایانی سەرزەنشت کرد:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"«دەست لە دەستنیشانکراوەکانم","poem":1},{"noteId":176},{"text":"مەدەن،","poem":1},{"text":"خراپە لەگەڵ پێغەمبەرەکانم مەکەن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"قاتوقڕی ناردە سەر زەوی،","poem":1},{"text":"هەموو نانێکی لە زەوی بڕی.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"کەسێکی لەپێشیانەوە نارد،","poem":1},{"text":"یوسف بە کۆیلایەتی فرۆشرا،","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بە کۆت ئازاری پێیان دا،","poem":1},{"text":"زنجیری ئاسنیان لە ملی کرد،","poem":2}]},{"type":"verse","number":19,"content":[{"text":"هەتا کاتی هاتنەدی قسەکەی،","poem":1},{"text":"پەیامی یەزدان ڕاستگۆیی ئەوی چەسپاند.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"پاشا ناردی کۆتەکەیان کردەوە،","poem":1},{"text":"فەرمانڕەوای گەلان ئازادی کرد.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"کردی بە گەورەی ماڵی خۆی،","poem":1},{"text":"کردی بە دەسەڵاتدار لەسەر هەموو موڵکی خۆی،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بۆ ئەوەی بە دڵی خۆی میرەکانی ڕێنمایی بکات،","poem":1},{"text":"پیرەکانی فێری دانایی بکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"جا ئیسرائیل هاتە میسر،","poem":1},{"text":"یاقوب لە خاکی حام بوو بە لانەواز.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"بەم جۆرەی کرد گەلەکەی زۆر بە بەروبووم بن،","poem":1},{"text":"لە هەموو دوژمنەکانی بەهێزتری کردن،","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ئەو دڵی گۆڕین بۆ ئەوەی ڕقیان لە گەلەکەی بێتەوە،","poem":1},{"text":"هەتا فێڵ لە خزمەتکارەکانی بکەن.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"موسای بەندەی خۆی نارد و","poem":1},{"text":"هارون ئەوەی هەڵیبژارد.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"لەنێو خۆیان ئەو پەرجوو و نیشانانەی فەرمانی پێکرابوو،","poem":1},{"text":"لە خاکی حام هێنایانە دی.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"تاریکی نارد و تاریک داهات،","poem":1},{"text":"میسرییەکان لە دژی فەرمانەکانی یاخی بوون.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ئاوەکانی گۆڕین بۆ خوێن،","poem":1},{"text":"ماسییەکانیانی کوشت.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"زەوی پڕبوو لە بۆق،","poem":1},{"text":"کە چوونە نێو نوێنی پاشاکانیشیان.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"بە فەرمانی ئەو مێشومەگەز هات،","poem":1},{"text":"مێشوولە بۆ هەموو سنوورەکانیان.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"بارانی کردن بە تەرزە،","poem":1},{"text":"ئاگری بە گڕ لە زەوییەکانیان.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"لە هەنجیر و دار مێوەکانی دان،","poem":1},{"text":"درەختی سنوورەکانیانی شکاند.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"بە فەرمانی ئەو کوللە هات،","poem":1},{"text":"کوللەحاجی بێشومار،","poem":2}]},{"type":"verse","number":35,"content":[{"text":"هەموو سەوزایی زەوییەکەیانی خوارد،","poem":1},{"text":"بەروبوومی خاکەکەیانی خوارد.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"لە هەموو نۆبەرەیەکی دا لە خاکەکەیان،","poem":1},{"text":"یەکەمین بەرهەمی پیاوەتییان.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"بە زێڕ و زیوەوە دەریهێنان،","poem":1},{"text":"لەنێو هۆزەکانیان کەس پەکی نەکەوت.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"میسر بە چوونەدەرەوەیان دڵخۆش بوو،","poem":1},{"text":"چونکە ترسی ئەوان چووبووە دڵیانەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"هەورێکی هێنا بۆ داپۆشین،","poem":1},{"text":"ئاگرێک بۆ ڕووناککردنەوەی شەو.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"داوایان کرد، سوێسکەی","poem":1},{"noteId":177},{"text":"هێنا،","poem":1},{"text":"نانی ئاسمانی تێری کردن.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"بەردی شەقکرد و ئاوی لێ هەڵقوڵا،","poem":1},{"text":"وەک ڕووبار بەناو بیاباندا ڕۆیی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":42,"content":[{"text":"لەبەر ئەوەی بەڵێنی پیرۆزی خۆی یادکردەوە،","poem":1},{"text":"بۆ ئیبراهیمی بەندەی.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"گەلەکەی بە شادییەوە هێنایە دەرەوە،","poem":1},{"text":"هەڵبژاردەکانی بە هەلهەلەوە.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"خاکی نەتەوەکانی پێ بەخشین،","poem":1},{"text":"بەری ماندووبوونی گەلانیان بە میرات بۆ مایەوە،","poem":2}]},{"type":"verse","number":45,"content":[{"text":"بۆ ئەوەی فەرزەکانی بەجێبهێنن،","poem":1},{"text":"فێرکردنی جێبەجێ بکەن.","poem":2},{"lineBreak":true},{"text":"هەلیلویا.","poem":1}]}],"footnotes":[{"noteId":175,"caller":"+","text":"مەبەست لەو خاکەیە کە کەنعانییەکان تێیدا نیشتەجێ بوون، ئێستاش پێی دەگوترێت فەلەستین.‏","reference":{"chapter":105,"verse":11}},{"noteId":176,"cal