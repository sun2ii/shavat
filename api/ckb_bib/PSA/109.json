{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":109,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، زەبوورێکی داود."]},{"type":"verse","number":1,"content":[{"text":"ئەی خودایە، ئەوەی ستایشت دەکەم،","poem":1},{"text":"بێدەنگ مەبە،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"چونکە دەمی بەدکار و دەمی فریودەر لێم کراونەتەوە،","poem":1},{"text":"بە زمانی درۆ قسەم لەسەر دەکەن.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بە قسەی ڕقەوە دەوریان گرتووم،","poem":1},{"text":"بەبێ هۆ لە دژم دەجەنگن.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لە جیاتی خۆشەویستییەکەم دژایەتیم دەکەن،","poem":1},{"text":"بەڵام من نوێژم کردووە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لە پاداشتی چاکە خراپەم لەگەڵ دەکەن،","poem":1},{"text":"ڕقیش لە پاداشتی خۆشەویستیم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"بەدکارێکی لەسەر دابنێ،","poem":1},{"text":"با سکاڵاکار لەلای ڕاستیەوە ڕاوەستێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"با لە دادگایی تاوانبار بکرێت،","poem":1},{"text":"با نوێژی بۆی بە گوناه دابنرێت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"با ڕۆژگاری کورت بێت،","poem":1},{"text":"یەکێکی دیکە ئەرکەکەی ئەو وەربگرێت!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"با کوڕەکانی هەتیو بن،","poem":1},{"text":"ژنی بێوەژن بێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"با کوڕەکانی سەرگەردان بن و سواڵ بکەن،","poem":1},{"text":"لە ماڵە کاولەکانیان دەربکرێن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"با هەرچی هەیەتی خاوەن قەرز بیبات،","poem":1},{"text":"بێگانەش بەری ڕەنجی تاڵان بکەن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"با کەس نەبێت دەستی خۆشەویستی بۆ درێژ بکات،","poem":1},{"text":"کەس نەبێت دڵی بە هەتیوەکانی بسووتێت!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"با نەوەکانی ببڕێتەوە،","poem":1},{"text":"ناوی لە نەوەی داهاتوو بسڕێتەوە!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"با تاوانەکانی باوباپیرانی بخرێنە بەردەم یەزدان،","poem":1},{"text":"با گوناهەکانی دایکی نەسڕێنەوە!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"با هەمیشە لەبەردەم یەزدان بن","poem":1},{"text":"هەتا یادیان لەسەر زەوی ببڕێتەوە!","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"لەبەر ئەوەی بیری نەکردەوە کە خۆشەویستی نەگۆڕ بنوێنێت،","poem":1},{"text":"بەڵکو کەسی هەژار و نەدار و دڵشکاوی ڕاوناوە و کوشتووە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"حەزی لە نەفرەت لێکردن بوو،","poem":1},{"text":"با بۆی بێت!","poem":2},{"lineBreak":true},{"text":"دڵشاد نەبوو بە داوای بەرەکەت بۆ کردن،","poem":2},{"lineBreak":true},{"text":"با لێی دووربکەوێتەوە!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"نەفرەتی وەک کراس لەبەرکردبوو،","poem":1},{"text":"وەک ئاو چووە ناو لەشی،","poem":2},{"lineBreak":true},{"text":"وەک ڕۆن چووە ناو ئێسقانەکانی.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"با وەک بەرگێک بێ لە خۆی بیپێچێتەوە،","poem":1},{"text":"هەمیشە وەک پشتێنێک بێ لە خۆی بیبەستێت!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"با ئەمە کرێی یەزدان بێت بۆ سکاڵاکارانم،","poem":1},{"text":"ئەوانەی بە خراپە لە دژی من دەدوێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"بەڵام تۆ ئەی یەزدانی پەروەردگار،","poem":1},{"text":"لە پێناوی ناوی خۆت چاکەم لەگەڵ بکە،","poem":2},{"lineBreak":true},{"text":"دەربازم بکە، چونکە خۆشەویستییە نەگۆڕەکەت چاکە.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"لەبەر ئەوەی من هەژار و نەدارم،","poem":1},{"text":"دڵم لە ناخمدا بریندارە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"وەک سێبەری ئێوارە دەڕۆم،","poem":1},{"text":"وەک کوللە هەڵدەوەرێم.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ئەژنۆم شل بووە لەبەر ڕۆژووگرتن،","poem":1},{"text":"لەشم لاواز بووە لە کەمی چەوری.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"بووم بە سووکایەتی بۆیان،","poem":1},{"text":"دەمبینن سەر بادەدەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ئەی یەزدان، خودای من، یارمەتیم بدە،","poem":1},{"text":"بەگوێرەی خۆشەویستییە نەگۆڕەکەت ڕزگارم بکە.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"با بزانن کە ئەمە دەستی تۆیە،","poem":1},{"text":"ئەی یەزدان، کە تۆ ئەمەت کردووە.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ئەوان نەفرەت دەکەن، بەڵام تۆ بەرەکەت دەدەیت،","poem":1},{"text":"هەستان و شەرمەزار بوون،","poem":2},{"lineBreak":true},{"text":"بەڵام خزمەتکاری تۆ دڵخۆش بوو.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"با سکاڵاکارانم بەرگی نامەردی بکەنە بەر،","poem":1},{"text":"با شەرمەزاری وەک کەوا لە خۆیان بئاڵێنن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"بە دەمی خۆم زۆر سوپاسی یەزدان دەکەم،","poem":1},{"text":"لەنێو خەڵکێکی زۆر ستایشی دەکەم،","poem":2}]},{"type":"verse","number":31,"content":[{"text":"چونکە ئەو لە دەستەڕاستی نەدار ڕادەوەستێت،","poem":1},{"text":"بۆ ڕزگارکردنی لەوانەی حوکمی بەسەردا دەدەن.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}