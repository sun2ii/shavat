اوچاک هەتاهەتایە نالەقێت،","poem":1},{"text":"هەتاهەتایە یادی دەکرێتەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لە بیستنی هەواڵی خراپ ناترسێت،","poem":1},{"text":"دڵی پتەوە، پشتی بە یەزدان بەستووە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"دڵی چەسپاوە و ناترسێت،","poem":1},{"text":"لە کۆتاییدا سەرکەوتوو دەبێت و شکستی دوژمنانی دەبینێت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بە دڵفراوانییەوە بە هەژارانی بەخشیوە،","poem":1},{"text":"ڕاستودروستییەکەی هەتاهەتایە چەسپاوە،","poem":2},{"lineBreak":true},{"text":"بە ڕێزەوە شکۆمەندییەکەی بەرز دەبێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"بەدکار ئەمە دەبینێت و بێزار دەبێت،","poem":1},{"text":"ددانەکانی جیڕدەکاتەوە و دەتوێتەوە،","poem":2},{"lineBreak":true},{"text":"ئارەزووی بەدکاران لەناودەچێت.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}