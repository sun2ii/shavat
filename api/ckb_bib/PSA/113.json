7,"content":[{"text":"ئەو هەژار لەناو خۆڵ ڕاست دەکاتەوە،","poem":1},{"text":"کڵۆڵ لەناو زبڵخانە بەرز دەکاتەوە،","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بۆ ئەوەی لەگەڵ میران داینیشێنێت،","poem":1},{"text":"لەگەڵ میرانی گەلی خۆی.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئافرەتی نەزۆک دەکاتە خاوەن ماڵ،","poem":1},{"text":"دەیکاتە دایکێکی شادمان لەنێو منداڵانی.","poem":2},{"lineBreak":true},{"text":"هەلیلویا!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}