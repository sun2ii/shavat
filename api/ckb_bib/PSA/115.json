{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"بۆ ئێمە نا، ئەی یەزدان، بۆ ئێمە نا،","poem":1},{"text":"بەڵکو بۆ ناوی خۆت شکۆ ببەخشە،","poem":2},{"lineBreak":true},{"text":"لەبەر خۆشەویستییە نەگۆڕەکەت و دڵسۆزییەکەت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"بۆچی نەتەوەکان بڵێن:","poem":1},{"text":"«کوا، خودایان لەکوێیە؟»","poem":2}]},{"type":"verse","number":3,"content":[{"text":"خودامان لە ئاسمانە،","poem":1},{"text":"هەرچی حەز بکات، دەیکات.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بتەکانیان زێڕ و زیون،","poem":1},{"text":"دەستکردی مرۆڤن.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"دەمیان هەیە، بەڵام قسە ناکەن،","poem":1},{"text":"چاویان هەیە، بەڵام نابینن،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"گوێیان هەیە، بەڵام نابیستن،","poem":1},{"text":"لووتیان هەیە، بەڵام بۆن ناکەن،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"دەستیان هەیە، بەڵام دەست لە هیچ نادەن،","poem":1},{"text":"پێیان هەیە، بەڵام ناڕۆن،","poem":2},{"lineBreak":true},{"text":"دەنگ لە گەروویان نایەتە دەرەوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"دروستکەرەکانیان وەک ئەوان دەبن،","poem":1},{"text":"هەروەها هەموو ئەوانەش کە پشتیان پێ دەبەستن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەی بنەماڵەی ئیسرائیل، پشت بە یەزدان ببەستن.","poem":1},{"text":"ئەو یارمەتیدەر و قەڵغانیانە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەی بنەماڵەی هارون، پشت بە یەزدان ببەستن.","poem":1},{"text":"ئەو یارمەتیدەر و قەڵغانیانە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەی ئەوانەی لەخواترسیتان لە دڵدایە، پشت بە یەزدان ببەستن.","poem":1},{"text":"ئەو یارمەتیدەر و قەڵغانیانە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"یەزدان ئێمەی لەبیرە و بەرەکەتدارمان دەکات،","poem":1},{"text":"بەرەکەت بە بنەماڵەی ئیسرائیل دەبەخشێت،","poem":2},{"lineBreak":true},{"text":"بەرەکەت بە بنەماڵەی هارون دەبەخشێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بەرەکەت بەوانە دەبەخشێت کە لەخواترسییان لە دڵدایە،","poem":1},{"text":"گەورە و بچووکیش.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"با یەزدان هەر زیادتان بکات،","poem":1},{"text":"ئێوە و منداڵەکانتان.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"با ئێوە بە یەزدان بەرەکەتدار بن،","poem":1},{"text":"دروستکەری ئاسمان و زەوی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ئاسمان ئاسمانی یەزدانە،","poem":1},{"text":"زەویشی بە ئادەمیزاد بەخشیوە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"نە مردووان ستایشی یەزدان دەکەن،","poem":1},{"text":"نە هەموو ئەوانەی شۆڕ دەبنەوە ناو بێدەنگی،","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بەڵام ئێمە ستایشی یەزدان دەکەین،","poem":1},{"text":"لە ئێستاوە و هەتاهەتایە.","poem":2},{"lineBreak":true},{"text":"هەلیلویا!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}