{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"یەزدانم خۆشدەوێت،","poem":1},{"text":"چونکە گوێ لە دەنگ و لە پاڕانەوەم دەگرێت،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"چونکە گوێی خۆی بۆم شل کرد،","poem":1},{"text":"هەتا ماوم هەر لێی دەپاڕێمەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"تۆڕی مەرگ دەوری دام،","poem":1},{"text":"ناخۆشی جیهانی مردووان کەوتە سەرم،","poem":2},{"lineBreak":true},{"text":"دەرد و تەنگانەم چێژت.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بە ناوی یەزدانەوە دەپاڕێمەوە:","poem":1},{"text":"«ئەی یەزدان، تکات لێ دەکەم، گیانم دەرباز بکە!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"یەزدان میهرەبان و ڕاستودروستە،","poem":1},{"text":"خودامان بە بەزەییە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"یەزدان چاودێری خەڵکی ساکار دەکات،","poem":1},{"text":"کاتێک زەلیل بووم، ئەو ڕزگاری کردم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئەی گیانی من، بگەڕێوە بۆ ئارامی خۆت،","poem":1},{"text":"چونکە یەزدان چاکەی بەسەرتدا باراند.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"تۆ گیانی منت لە مردن ڕزگار کرد،","poem":1},{"text":"چاوەکانم لە فرمێسک،","poem":2},{"lineBreak":true},{"text":"پێیەکانم لە خزان،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"تاکو دۆستایەتی یەزدان بکەم","poem":1},{"text":"لە خاکی زیندووان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"باوەڕم هەبوو، بۆیە گوتم:","poem":1},{"text":"«من زۆر دەردەدارم!»","poem":2}]},{"type":"verse","number":11,"content":[{"text":"من لە کاتی تۆقینەکەمدا گوتم:","poem":1},{"text":"«مرۆڤ هەموو درۆزنن!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"چی بدەمەوە یەزدان،","poem":1},{"text":"بەرامبەر هەموو چاکەکانی بۆ من.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"جامی ڕزگاری بەرز دەکەمەوە و","poem":1},{"text":"بە ناوی یەزدانەوە دەپاڕێمەوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"نەزرەکانم بۆ یەزدان بەجێدەهێنم،","poem":1},{"text":"بەرامبەر بە هەموو گەلەکەی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"یەزدان مردنی خۆشەویستانی","poem":1},{"text":"لەلا سەنگینە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئەی یەزدان، من بە ڕاستی خزمەتکاری تۆم،","poem":1},{"text":"من خزمەتکاری تۆم، کوڕی کەنیزەکەت،","poem":2},{"lineBreak":true},{"text":"تۆ کۆتەکانی منت کردەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"قوربانی سوپاسگوزاری بۆ تۆ سەردەبڕم،","poem":1},{"text":"بە ناوی یەزدانەوە دەپاڕێمەوە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"نەزرەکانم بۆ یەزدان بەجێدەهێنم،","poem":1},{"text":"بەرامبەر بە هەموو گەلەکەی،","poem":2}]},{"type":"verse","number":19,"content":[{"text":"لە حەوشەی ماڵی یەزداندا،","poem":1},{"text":"لە ناوەندی تۆدا، ئەی ئۆرشەلیم.","poem":2},{"lineBreak":true},{"text":"هەلیلویا!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}