":[{"text":"یەزدان لەلای منە، ئەو یارمەتیدەری منە،","poem":1},{"text":"سەرکەوتووانە تەماشای ئەوانە دەکەم کە ڕقیان لێمە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"پەنابردنە بەر یەزدان باشترە","poem":1},{"text":"لە پشتبەستن بە مرۆڤ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"پەنابردنە بەر یەزدان باشترە","poem":1},{"text":"لە پشتبەستن بە میران.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"هەموو نەتەوەکان ئابڵوقەیان دام،","poem":1},{"text":"بە ناوی یەزدان ڕیشەکێشم کردن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئابڵوقەیان دام و دەوریان گرتم،","poem":1},{"text":"بە ناوی یەزدان ڕیشەکێشم کردن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"وەک کوورە هەنگ تێم ئاڵان،","poem":1},{"text":"وەک ئاگری دڕکوداڵ کوژانەوە،","poem":2},{"lineBreak":true},{"text":"بە ناوی یەزدان ڕیشەکێشم کردن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"توند پاڵیان پێوەنام بۆ ئەوەی بکەوم،","poem":1},{"text":"بەڵام یەزدان یارمەتی داوم.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"یەزدان هێز و گۆرانی منە،","poem":1},{"text":"یەزدان بووەتە ڕزگاریی من.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"دەنگی هەلهەلە و ڕزگاری دێت لە خێوەتی ڕاستودروستان:","poem":1},{"text":"«دەستی ڕاستی یەزدان کاری ئازایانە دەکات،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"دەستی ڕاستی یەزدان بەرز بووەتەوە،","poem":1},{"text":"دەستی ڕاستی یەزدان کاری ئازایانە دەکات.»","poem":2}]},{"type":"verse","number":17,"content":[{"text":"من نامرم، بەڵکو دەژیم و","poem":1},{"text":"باسی کردارەکانی یەزدان دەکەم.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"یەزدان بە توندی تەمبێی کردم،","poem":1},{"text":"بەڵام نەیدامە دەست مەرگ.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"دەرگاکانی ڕاستودروستیم لێ بکەنەوە،","poem":1},{"text":"پێیدا دەچمە ژوورەوە و ستایشی یەزدان دەکەم.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئەم دەرگایە هی یەزدانە،","poem":1},{"text":"ڕاستودروستان پێیدا دەچنە ژوورەوە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ستایشت دەکەم کە فریام کەوتی،","poem":1},{"text":"بۆم بووی بە ڕزگاری.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ئەو بەردەی وەستاکان ڕەتیان کردەوە","poem":1},{"text":"بوو بە گرنگترین بەردی بناغە","poem":2},{"noteId":191},{"text":".","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ئەمە لەلایەن یەزدانەوە بوو،","poem":1},{"text":"لەبەرچاومان سەیرە.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ئەمە ئەو ڕۆژەیە کە یەزدان دروستی کردووە،","poem":1},{"text":"با تێیدا شاد و دڵخۆش بین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ئەی یەزدان، تکایە، ڕزگارمان بکە،","poem":1},{"text":"ئەی یەزدان، تکایە، سەرکەوتوومان بکە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"پیرۆزە ئەوەی بە ناوی یەزدانەوە دێت،","poem":1},{"text":"لە ماڵی یەزدانەوە داوای بەرەکەتتان بۆ دەکەین.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"یەزدان خودامانە و","poem":1},{"text":"ئەو ڕووناکی خۆی بەسەرماندا درەوشاندەوە.","poem":2},{"text":"قوربانی جەژن بە گوریس ببەستنەوە","poem":1},{"text":"بە قۆچەکانی قوربانگا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"تۆ خودای منیت و منیش ستایشت دەکەم،","poem":1},{"text":"تۆ خودای منیت، بە گەورەت دەزانم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ستایشی یەزدان بکەن، لەبەر ئەوەی چاکە،","poem":1},{"text":"خۆشەویستییە نەگۆڕەکەی هەتاهەتاییە.","poem":2}]}],"footnotes":[{"noteId":191,"caller":"+","text":"گرنگترین بەردی بناغە: بەردی قولینچک، بەردێکی گەورەیە لە گۆشەی دیوار دادەنرێت لەو بەردانە بەهێزترە کە لە دیوارەکە بەکاردێت و دەبێتە هۆی بەهێزکردنی دیوارەکە.‏","reference":{"chapter":118,"verse":22}}]},"thisChapterLink":"/api/ckb_bib/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib