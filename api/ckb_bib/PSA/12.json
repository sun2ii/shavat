ەژاران و","poem":1},{"text":"ناڵەی کڵۆڵان، ئێستا ڕادەپەڕم،","poem":2},{"lineBreak":true},{"text":"ئەو ئاسوودەییەیان دەدەمێ، لەوانەی پەستیان دەکەن.»","poem":2}]},{"type":"verse","number":6,"content":[{"text":"وتەکانی یەزدان وتەی پاکن،","poem":1},{"text":"وەک ئەو زیوەیە لە بۆتەی گڵین پاڵێورابێت،","poem":2},{"lineBreak":true},{"text":"حەوت جار پاڵێوراوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئەی یەزدان، دەمانپارێزیت و","poem":1},{"text":"هەتاهەتایە لەم جۆرە کەسانە پاسمان دەکەیت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بەدکارەکان بە هەموو لایەکدا بە ئازادی دەگەڕێن،","poem":1},{"text":"کاتێک خەڵکی بە شان و باڵی خراپەدا هەڵدەدەن.","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"دەستەواژەیەکی بواری مۆسیقایە.‏","reference":{"chapter":12,"verse":0}}]},"thisChapterLink":"/api/ckb_bib/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}