{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"هەلیلویا!","poem":1},{"lineBreak":true},{"text":"ستایشی ناوی یەزدان بکەن،","poem":1},{"text":"ئەی بەندەکانی یەزدان، ستایشی بکەن،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەی ئەوانەی لە ماڵی یەزدان ڕاوەستاون،","poem":1},{"text":"لە حەوشەی ماڵی خودامان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ستایشی یەزدان بکەن، چونکە یەزدان چاکە،","poem":1},{"text":"مۆسیقا بۆ ناوی بژەنن، چونکە ئاوا جوانە،","poem":2}]},{"type":"verse","number":4,"content":[{"text":"چونکە یەزدان یاقوبی بۆ خۆی هەڵبژاردووە و","poem":1},{"text":"ئیسرائیل بۆ گەنجینەیەکی تایبەتی خۆی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"من دەزانم یەزدان مەزنە،","poem":1},{"text":"پەروەردگارمان لە هەموو خوداوەندەکان مەزنترە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"یەزدان هەرچی پێ خۆشبێت دەیکات،","poem":1},{"text":"لە