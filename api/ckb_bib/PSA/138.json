em":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"هەرچەندە یەزدان پایەبەرزە، دەڕوانێتە کەسی بێفیز و","poem":1},{"text":"لووتبەرزان لە دوورەوە دەناسێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئەگەر بەناو تەنگانەشدا بڕۆم ژیانم دەپارێزیت،","poem":1},{"text":"دەست درێژ دەکەیت بەسەر تووڕەیی دوژمنانم،","poem":2},{"lineBreak":true},{"text":"بە دەستی ڕاستت ڕزگارم دەکەیت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"یەزدان ئەستۆپاکیم دەسەلمێنێت؛","poem":1},{"text":"ئەی یەزدان، خۆشەویستییە نەگۆڕەکەت هەتاهەتاییە،","poem":2},{"lineBreak":true},{"text":"واز لە کارەکانی دەستت مەهێنە.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}