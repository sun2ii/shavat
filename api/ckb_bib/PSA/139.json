{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"hebrew_subtitle","content":["بۆ گەورەی گۆرانیبێژان، زەبوورێکی داود."]},{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، تۆ منت پشکنی و","poem":1},{"text":"منت ناسی.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"هەستان و دانیشتنی منت زانیوە،","poem":1},{"text":"لە دوورەوە لە بیرکردنەوەم گەیشتووی.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ڕێڕەو و جێی ڕاکشانی منت پێواوە،","poem":1},{"text":"شارەزای هەموو ڕێگاکانی منیت.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەی یەزدان، بەر لەوەی وشەیەک لەسەر زمانم هەبێت،","poem":1},{"text":"تۆ بە تەواوی دەیزانی.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لەپێش و لە پشتەوە دەورت داوم،","poem":1},{"text":"دەستت دەخەیتە سەرم.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەم زانینەی تۆم بەلاوە زۆر سەیرە،","poem":1},{"text":"لە سەرووی منەوەیە، ناتوانم بەدەستی بهێنم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"بۆ کوێ بچم لە ڕۆحی تۆ؟","poem":1},{"text":"بۆ کوێ هەڵبێم لە ڕوخسارت؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەگەر سەربکەوم بۆ ئاسمان، ئەوەتا تۆ لەوێی،","poem":1},{"text":"ئەگەر لەناو جیهانی مردووان ڕاکشێم، ئەوەتا تۆ لەوێی.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەگەر دەست بە باڵی بەرەبەیانەوە بگرم،","poem":1},{"text":"ئەگەر لەوپەڕی دەریا","poem":2},{"noteId":210},{"text":"نیشتەجێ بم،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لەوێش دەستی تۆ ڕێنماییم دەکات،","poem":1},{"text":"دەستی ڕاستت بە خۆیەوە دەمگرێت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەگەر گوتم: «بێگومان تاریکی دامدەپۆشێت،","poem":1},{"text":"ڕووناکیش دەبێتە شەوی دەورم،»","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەوا لە تاریکیشدا لەلای تۆ تاریک دانایەت،","poem":1},{"text":"شەو وەک ڕۆژ ڕووناکی دەبەخشێت،","poem":2},{"lineBreak":true},{"text":"تاریکیش وەک ڕووناکی وایە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"تۆ ناخی منت دروستکردووە،","poem":1},{"text":"لەناو سکی دایکم منت چنیوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ستایشت دەکەم، چونکە بە سامناکی و سەرسوڕهێنەری دروستکراوم،","poem":1},{"text":"کارەکانت سەرسوڕهێنەرن،","poem":2},{"lineBreak":true},{"text":"لە ناخمەوە باش ئەمە دەزانم.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئێسقانم لە تۆ شاراوە نەبوو،","poem":1},{"text":"کاتێک لە پەنهانی دروستکرام،","poem":2},{"lineBreak":true},{"text":"لەناو سکی زەوی نەخشێنرام.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"هێشتا لە سکی دایکم بووم، ئەندامەکانی لەشمت بینی.","poem":1},{"text":"هەموو ئەو ڕۆژانە کە بۆ من شێوەیان کێشرا،","poem":2},{"text":"لە پەڕتووکەکەتدا نووسراون،","poem":1},{"text":"پێش ئەوەی هیچ کامێکیان هەبن.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئەی خودایە، بیرۆکەکانت بەلای منەوە چەند گرانبەهایە!","poem":1},{"text":"کۆی ژمارەیان چەندە مەزنە!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئەگەر بیانژمێرم، لە لم زیاترن.","poem":1},{"text":"کە بەئاگادێمەوە هێشتا لەگەڵ تۆم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"خودایە، خۆزگە بەدکارەکانت دەکوشت!","poem":1},{"text":"ئەی خوێنڕێژەکان، لێم دووربکەونەوە!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئەوانەی بە خراپە باست دەکەن،","poem":1},{"text":"سکاڵاکاران بەبێ هۆ لێت هەستاون!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئەی یەزدان، ئایا ڕقم لەوانە نەبێت کە ڕقیان لە تۆیە؟","poem":1},{"text":"ئایا قێزم لەوانە نەبێتەوە کە لە دژی تۆ دەوەستن؟","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بە تەواوی ڕقم لێیانە،","poem":1},{"text":"بوون بە دوژمنم.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"خودایە، بمپشکنە و بزانە دڵم چی تێدایە!","poem":1},{"text":"تاقیم بکەوە و بزانە خولیای چیم.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"سەیر بکە ئاخۆ هیچ ڕێگایەکی خراپەم تێدایە،","poem":1},{"text":"ڕێنماییم بکە لە ڕێگای هەتاهەتایی.","poem":2}]}],"footnotes":[{"noteId":210,"caller":"+","text":"مەبەستی لە ڕۆژئاوای دوورە.‏","reference":{"chapter":139,"verse":9}}]},"thisChapterLink":"/api/ckb_bib/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}