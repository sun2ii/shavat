{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["زەبوورێکی داود."]},{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، هاوارم بۆ تۆ کرد، خێرابە بۆ لام!","poem":1},{"text":"گوێ لە دەنگم بگرە کە هاوارت بۆ دەکەم.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"با نوێژم وەک بخوور لەبەردەمت پەسەند بێت،","poem":1},{"text":"دەست بەرزکردنەوەم وەک قوربانی ئێوارە بێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ئەی یەزدان، پاسەوانێک دابنێ بۆ دەمم،","poem":1},{"text":"دەرگای لێوەکانم بپارێزە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"وا مەکە دڵم بەلای خراپەدا بچێت،","poem":1},{"text":"نەوەک خۆم بە کردەوەی بەد خەریک بکەم،","poem":2},{"text":"لەگەڵ ئەوانەی بەدکاری دەکەن؛","poem":1},{"text":"با لە شتە خۆشەکانی ئەوان نەخۆم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"با پیاوچاک لێم بدات، ئەمە خۆشەویستییە،","poem":1},{"text":"با سەرزەنشتم بکات، ئەمە وەک ڕۆنی بۆنخۆشی سەرە،","poem":2},{"lineBreak":true},{"text":"سەرم لاری نییە،","poem":2},{"text":"چونکە بەردەوام نوێژەکانم لە دژی خراپەکانیانە.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ڕابەرانیان لە خەرەند فڕێدەدرێنە خوارێ،","poem":2},{"lineBreak":true},{"text":"ئەوسا گوێ لە قسەم دەگرن چونکە ڕاستە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"وەک کێڵان و شەقکردنی زەوی،","poem":1},{"text":"ئاوا ئێسقانەکانیان لە دەمی گۆڕ پەرت دەکرێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"بەڵام چاوەکانم سەرنجیان لەسەر تۆیە، ئەی یەزدانی پەروەردگار،","poem":1},{"text":"پەنا دێنمە بەر تۆ، با گیانم نەفەوتێت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بمپارێزە لەو داوەی بۆیان ناومەتەوە،","poem":1},{"text":"لە تەڵەی بەدکاران.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"با بەدکاران پێکەوە بکەونە تۆڕی خۆیانەوە،","poem":1},{"text":"لەو کاتەدا من بە ئاسوودەیی بپەڕمەوە.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}