سەرنج دەدەمە کردارەکانی دەستت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"دەستم بۆ تۆ پاندەکەمەوە،","poem":1},{"text":"گیانم بۆ تۆ وەک خاکێکی وشکە.","poem":2},{"noteId":212}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئەی یەزدان، زوو وەڵامم بدەوە،","poem":1},{"text":"ڕۆحم لەناودەچێت،","poem":2},{"text":"ڕووی خۆتم لێ مەشارەوە،","poem":1},{"text":"ئەگینا لەوانە دەچم کە دەچنە نێو جیهانی مردووان.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"با بەیانییان گوێم لە خۆشەویستییە نەگۆڕەکەت بێت،","poem":1},{"text":"چونکە من پشت بە تۆ دەبەستم.","poem":2},{"text":"ئەو ڕێگایەم پێ بناسێنە کە دەیگرمەبەر،","poem":1},{"text":"چونکە گیانی خۆم بە تۆ دەسپێرم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەی یەزدان، لە دوژمنەکانم دەربازم بکە،","poem":1},{"text":"هانا بۆ تۆ دەهێنم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"فێرم بکە بە ڕەزامەندیی تۆ کار بکەم،","poem":1},{"text":"چونکە تۆ خودای منی.","poem":2},{"text":"با ڕۆحە چاکەکەت ڕێنماییم بکات","poem":1},{"text":"لە زەوییەکی ڕاست.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ئەی یەزدان، لەبەر ناوی خۆت بمژیێنەوە،","poem":1},{"text":"بە ڕاستودروستی خۆت گیانم لە تەنگانە دەربهێنە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بە خۆشەویستییە نەگۆڕەکەت دوژمنانم دەمکوت بکە،","poem":1},{"text":"هەموو ئەوانە لەناوببە کە تەنگم پێ هەڵدەچنن،","poem":2},{"lineBreak":true},{"text":"چونکە من خزمەتکاری تۆم.","poem":2}]}],"footnotes":[{"noteId":212,"caller":"+","text":"لە دەقی عیبری لێرە وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":143,"verse":6}}]},"thisChapterLink":"/api/ckb_bib/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}