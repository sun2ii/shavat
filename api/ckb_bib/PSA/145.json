text":"منیش مەزنیت ڕادەگەیەنم.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"یادی زۆری چاکەی تۆ هەڵدەڕێژن،","poem":1},{"text":"گۆرانی بەسەر ڕاستودروستیتدا دەڵێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"یەزدان میهرەبان و بە بەزەییە،","poem":1},{"text":"پشوودرێژە و پڕە لە خۆشەویستی نەگۆڕ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"یەزدان بۆ هەمووان چاکە،","poem":1},{"text":"بەزەییەکەی بۆ هەموو ئەوانەیە کە دروستی کردوون.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەی یەزدان، هەموو ئەوانەی دروستت کردوون ستایشت دەکەن،","poem":1},{"text":"خۆشەویستانت ستایشت دەکەن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"دەربارەی شکۆمەندی شانشینەکەت دەدوێن،","poem":1},{"text":"باسی پاڵەوانیێتی تۆ دەکەن،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"تاکو پاڵەوانیێتیت لەلای هەموو ئادەمیزادێک زانراو بێت،","poem":1},{"text":"هەروەها پایەبەرزی شکۆی شانشینەکەت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"شانشینەکەت شانشینی هەموو سەردەمێکە،","poem":1},{"text":"فەرمانڕەوایەتیشت بەسەر هەموو نەوەکانەوەیە.","poem":2},{"lineBreak":true},{"text":"یەزدان لە هەموو بەڵێنەکانی دڵسۆزە،","poem":1},{"text":"خۆشەویستییەکەی بۆ هەموو ئەوانەیە کە دروستی کردوون.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"یەزدان پشتگیرە بۆ هەموو کەوتووەکان،","poem":1},{"text":"ڕاستکەرەوەیە بۆ هەموو ئەوانەی چەماونەتەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"چاوی هەمووان هیوای بە تۆیە،","poem":1},{"text":"تۆش لە کاتی خۆیدا خواردنیان دەدەیتێ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"دەستت دەکەیتەوە و","poem":1},{"text":"ئارەزووی هەموو زیندووێک تێر دەکەیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"یەزدان لە هەموو ڕێگاکانی ڕاستودروستە،","poem":1},{"text":"خۆشەویستییەکەی بۆ هەموو ئەوانەیە کە دروستی کردوون.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"یەزدان ن