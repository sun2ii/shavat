eBreak":true},{"text":"ئەوەی هەتاهەتایە دڵسۆز دەمێنێتەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"دادپەروەری بۆ زۆرلێکراوان بەڕێوە دەبات،","poem":1},{"text":"نان دەداتە برسییەکان.","poem":2},{"text":"یەزدان گیراوەکان ئازاد دەکات،","poem":1}]},{"type":"verse","number":8,"content":[{"text":"یەزدان چاوی کوێرەکان دەکاتەوە،","poem":2},{"text":"یەزدان کەسە چەماوەکان ڕاست دەکاتەوە،","poem":1},{"text":"یەزدان ڕاستودروستانی خۆشدەوێت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"یەزدان نامۆکان دەپارێزێت،","poem":1},{"lineBreak":true},{"text":"یارمەتی هەتیو و بێوەژنان دەدات،","poem":1},{"text":"بەڵام ڕێگای بەدکاران خوار دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"یەزدان هەتاهەتایە پاشایەتی دەکات،","poem":1},{"text":"ئەی سییۆن، ئەو خودای تۆیە بۆ هەموو نەوەکانت.","poem":2},{"lineBreak":true},{"text":"هەلیلویا.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}