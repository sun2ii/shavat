type":"line_break"},{"type":"verse","number":7,"content":[{"text":"لە زەوییەوە ستایشی یەزدان بکەن،","poem":1},{"text":"ئەی ئەژدیهاکان و قووڵایی دەریاکان،","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بروسکە و تەرزە، بەفر و تەم،","poem":1},{"text":"ڕەشەبا، کە فەرمانی ئەو بەجێدەهێنن،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"چیاکان و هەموو گردەکان،","poem":1},{"text":"داری بەردار و هەموو ئورزەکان،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"گیانلەبەر و هەموو ئاژەڵ،","poem":1},{"text":"خشۆک و باڵدار،","poem":2}]},{"type":"verse","number":11,"content":[{"text":"پاشاکانی زەوی و هەموو نەتەوەکان،","poem":1},{"text":"میرەکان و هەموو ڕابەرانی زەوی،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"گەنجان و کچان،","poem":1},{"text":"پیران و منداڵان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"با هەموو ستایشی ناوی یەزدان بکەن،","poem":1},{"text":"چونکە تەنها ناوی ئەو بەرزە،","poem":2},{"lineBreak":true},{"text":"شکۆمەندی ئەو لە سەرووی زەوی و ئاسمانە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"پیاوی بەهێزی بە گەلی خۆی بەخشیوە،","poem":1},{"text":"تاکو هەموو خۆشەویستانی ستایشی بکەن،","poem":2},{"lineBreak":true},{"text":"نەوەی ئیسرائیل، ئەو گەلەی کە لێیەوە نزیکن.","poem":2},{"lineBreak":true},{"text":"هەلیلویا.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}