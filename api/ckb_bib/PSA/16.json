:6,"content":[{"text":"گوریس","poem":1},{"noteId":21},{"text":"کەوتە سەر چاکترین خاک بۆ بەشی من،","poem":1},{"text":"بە ڕاستی میراتێکی دڵخۆشکەرم هەیە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ستایشی یەزدان دەکەم کە ئامۆژگاریم دەکات،","poem":1},{"text":"تەنانەت بە شەویش دڵم ڕێنماییم دەکات.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"هەمیشە چاوم لەسەر یەزدانە،","poem":1},{"text":"لەبەر ئەوەی لەلای دەستی ڕاستمەوەیە، ناهەژێم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"بۆیە دڵشادم و گیانم خۆشحاڵە،","poem":1},{"text":"تەنانەت جەستەم بە ئاسوودەیی نیشتەجێیە،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"چونکە تۆ گیانم لە جیهانی مردوواندا بەجێناهێڵیت،","poem":1},{"text":"هەروەها ڕێگا نادەیت دڵسۆزەکەی تۆ","poem":2},{"noteId":22},{"text":"لەناو گۆڕ بۆگەن بێت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ڕێگای ژیانت پێ ناساندم،","poem":1},{"text":"تێربوون لە شادی لە ئامادەبوونتدایە،","poem":2},{"lineBreak":true},{"text":"خۆشحاڵی هەتاهەتایی لەلای دەستەڕاستی تۆدایە.","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"دیاریکردنی سنووری زەوی بە گوریس بووە.‏","reference":{"chapter":16,"verse":6}},{"noteId":22,"caller":"+","text":"مەبەستی ئەوەی بۆ خودا تەرخان کراوە، وەک مەسیح.‏","reference":{"chapter":16,"verse":10}}]},"thisChapterLink":"/api/ckb_bib/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}