ntent":[{"text":"پەتی جیهانی مردووان بە دەورمدا تەنراوە،","poem":1},{"text":"داوی مردن لەبەردەمم دانراوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"لە تەنگانەمدا لە یەزدان پاڕامەوە،","poem":1},{"text":"هاوارم بردە بەر خودام،","poem":2},{"text":"لە پەرستگاکەیەوە گوێی لە دەنگی من بوو،","poem":1},{"text":"هاوارم گەیشتە بەرگوێی.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئینجا زەوی لەرزی و هەژا،","poem":1},{"text":"بناغەی چیاکانیش ڕاژەنین،","poem":2},{"lineBreak":true},{"text":"لە تووڕەیی ئەو لەرزین.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"دووکەڵ لە لووتی بەرزبووەوە،","poem":1},{"text":"ئاگرێکی لووشدەر لە دەمی هاتە دەرەوە،","poem":2},{"lineBreak":true},{"text":"وەک ژیلەمۆی پشکۆی داگیرساو بوو.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئاسمانی شەقکرد و دابەزییە خوارەوە،","poem":1},{"text":"هەوری تاریک لەژێر پێی بوو.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"سواری کەڕوب","poem":1},{"noteId":24},{"text":"بوو و فڕی،","poem":1},{"text":"بەسەر باڵی بادا بەرزبووەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بە تاریکی خۆی داپۆشی و کردییە خێوەت لە دەوری خۆی،","poem":1},{"text":"هەوری تاریکی پڕ بارانی ئاسمانی کردە چەتری خۆی.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لە ڕۆشنایی ئامادەبوونی ئەو هەورەکان بەرەو پێش چوون،","poem":1},{"text":"تەرزە و پشکۆی ئاگریان لێ هاتە دەرەوە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"یەزدان لە ئاسمانەوە گرماندی،","poem":1},{"text":"ئەو خودایەی هەرەبەرزە دەنگی خۆی لەرزاندەوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"تیرەکانی هاویشت و بڵاوەی بە دوژمنەکانی کرد،","poem":1},{"text":"بە بروسکەی گەورە پەرێشانی کردن.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەی یەزدان، بنی دەریا دەرکەوت،","poem":1},{"text":"بناغەکانی زەوی ئاشکرا بوون،","poem":2},{"text":"لە سەرزەنشتی تۆ،","poem":1},{"text":"لە گەرمی هەناسەی لووتی تۆ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"لە بەرزاییەوە دەستی درێژکرد و منی گرت،","poem":1},{"text":"لەناو ئاوە قووڵەکانەوە دەریهێنام.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"لە دوژمنە بە تواناکەم ڕزگاری کردم،","poem":1},{"text":"لە ناحەزەکانم کە زۆر لە من بەهێزتر بوون.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"لە ڕۆژی لێقەومانم هاتنە سەرم،","poem":1},{"text":"بەڵام یەزدان پشت و پەنام بوو.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"منی هێنایە دەرەوە بۆ جێگایەکی پان و بەرین،","poem":1},{"text":"ڕزگاری کردم، چونکە دڵخۆشە پێم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"یەزدان بەگوێرەی ڕاستودروستیم پاداشتی داومەتەوە،","poem":1},{"text":"بەگوێرەی دەستپاکیم ڕێزداری کردووم،","poem":2}]},{"type":"verse","number":21,"content":[{"text":"چونکە من ڕێچکەی یەزدانم گرتووەتەبەر،","poem":1},{"text":"لە خودای خۆم یاخی نەبووم.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"هەموو حوکمەکانی لەبەرچاومدان،","poem":1},{"text":"لە فەرزەکانی لام نەداوە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"لەبەردەمی ئەو بێ کەموکوڕی بووم و","poem":1},{"text":"خۆم لە گوناه پاراستووە.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"یەزدان بەگوێرەی ڕاستودروستیم پاداشتی داومەتەوە،","poem":1},{"text":"بەگوێرەی دەستپاکیم لەبەردەمی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"لەگەڵ دڵسۆزەکان دڵسۆزی دەنوێنیت،","poem":1},{"text":"لەگەڵ ئەوانەی بێ کەموکوڕین چاکی دەنوێنیت،","poem":2}]},{"type":"verse","number":26,"content":[{"text":"لەگەڵ پاکەکان پاکی دەنوێنیت،","poem":1},{"text":"بەڵام لەگەڵ خوارەکان زیرەکی دەنوێنیت.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"تۆ خەڵکی بێفیز ڕزگار دەکەیت،","poem":1},{"text":"بەڵام لووتی لووتبەرزان دەشکێنیت.","poem":2},{"noteId":25}]},{"type":"verse","number":28,"content":[{"text":"ئەی یەزدان، تۆ چراکەم دادەگیرسێنیت،","poem":1},{"text":"خودام تاریکیم ڕووناک دەکاتەوە.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"بە یارمەتی تۆ دەتوانم لەشکرێک تێکبشکێنم،","poem":1},{"text":"لەگەڵ خودای خۆم دەتوانم بەسەر شووراکاندا سەربکەوم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ڕێبازی خودا تەواوە،","poem":1},{"text":"بەڵێنی یەزدان بێگەردە،","poem":2},{"lineBreak":true},{"text":"ئەو قەڵغانە بۆ هەموو ئەوانەی پەنای بۆ دەبەن.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"لە یەزدان بەولاوە کێ خودایە؟","poem":1},{"text":"لە خودامان بەولاوە کێ تاشەبەردەکەیە؟","poem":2}]},{"type":"verse","number":32,"content":[{"text":"خودایە ئەوەی کەمەری منی توند بەستووە،","poem":1},{"text":"بە تەواوی ڕێگام لەبەردەمدا دەکاتەوە.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"پێیەکانم وەک پێی ئاسک لێ دەکات،","poem":1},{"text":"لەسەر بەرزایی ڕامدەگرێت.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"مەشق بە دەستەکانم دەکات بۆ جەنگ،","poem":1},{"text":"تاکو بتوانم بە بازووم کەوانی بڕۆنز بچەمێنمەوە.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"قەڵغانی ڕزگاریی خۆتت پێ بەخشیوم،","poem":1},{"text":"بە دەستی ڕاستت پشتم دەگریت،","poem":2},{"lineBreak":true},{"text":"هاوکاریت گەورەم دەکات.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"جێی هەنگاوەکانم تەخت و فراوان دەکەیت،","poem":1},{"text":"تاکو پێم نەخلیسکێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"دوژمنەکانم ڕاونا و پێشم لێ گرتن،","poem":1},{"text":"هەتا لەناوم نەبردن نەگەڕامەوە.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"وردوخاشم کردن، ئیتر نەیانتوانی هەستنەوە،","poem":1},{"text":"لەژێر پێم کەوتن.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"کەمەری منت توند کرد بۆ جەنگ،","poem":1},{"text":"وات لە بەرهەڵستکارانی من کرد لەبەر پێم کڕنۆش ببەن.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"دوژمنەکانم پشتیان تێ کردم و ڕایانکرد،","poem":1},{"text":"من ناحەزەکانی خۆمم لەناوبرد.","poem":2}]},{"type":"verse","number":41,"conte