{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، بەگوێرەی ئاسکی بەرەبەیان. زەبوورێکی داود."]},{"type":"verse","number":1,"content":[{"text":"خودای من، خودای من، بۆ وازت لێ هێنام؟","poem":1},{"text":"بۆ وا دووری لە ڕزگارکردنم، لە بیستنی ناڵەم؟","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەی خودای من، بە ڕۆژ لێت دەپاڕێمەوە، وەڵامم نادەیتەوە،","poem":1},{"text":"بە شەویش ئارامیم نییە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"لەگەڵ ئەوەشدا، تۆ خودای پیرۆزیت،","poem":1},{"text":"لەنێو ستایشی ئیسرائیل دانیشتوویت.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"باوباپیرانمان پشتیان بە تۆ بەست،","poem":1},{"text":"پشتیان بە تۆ بەست و تۆش ڕزگارت کردن.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"هاواریان بۆ تۆ هێنا و تۆش دەربازت کردن،","poem":1},{"text":"پشتیان بە تۆ بەست و شەرمەزار نەبوون.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"بەڵام من سەگم","poem":1},{"noteId":31},{"text":"نەک مرۆڤ،","poem":1},{"text":"مایەی ڕیسوایی ئادەمیزاد و سووکایەتی خەڵک.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"هەموو ئەوانەی دەمبینن گاڵتەم پێ دەکەن،","poem":1},{"text":"توانجم لێ دەگرن و بە بزەوە سەر بادەدەن و دەڵێن:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"«پشتی بە یەزدان بەست، با یەزدان ڕزگاری بکات.","poem":1},{"text":"با فریای بکەوێت، ئەگەر یەزدان پێی دڵخۆشە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"بەڵام تۆ لەناو سکی دایکم دەرتهێنام،","poem":1},{"text":"کاتێک لەبەر مەمکی دایکم بووم، دڵنیات کردم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"من لە کاتی لەدایکبوونمەوە بە تۆ سپێردراوم،","poem":1},{"text":"لە سکی دایکمەوە تۆ خودای منی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"لێم دوور مەبە، چونکە تەنگانە نزیک بووەتەوە و","poem":1},{"text":"کەس نییە یارمەتیم بدات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"گای زۆر دەوریان داوم،","poem":1},{"text":"گایە بەهێزەکانی باشان","poem":2},{"noteId":32},{"text":"ئابڵوقەیان داوم.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"وەک شێری دڕندەی بە نەڕەنەڕ،","poem":1},{"text":"ددانیان لێ تیژکردوومەتەوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"وەک ئاو ڕژام،","poem":1},{"text":"هەموو ئێسقانەکانم لێک جیا بوونەتەوە.","poem":2},{"text":"دڵم بووە بە مۆم،","poem":1},{"text":"لە ناخمدا تواوەتەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"هێزم وەک پارچە گۆزە وشک بووە،","poem":1},{"text":"زمانم بە مەڵاشوومەوە نووساوە،","poem":2},{"lineBreak":true},{"text":"منت خستە ناو خاکی مەرگ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"سەگ دەوریان داوم،","poem":1},{"text":"تاقمێک بەدکار ئابڵوقەیان داوم،","poem":2},{"lineBreak":true},{"text":"دەست و پێیان کون کردووم.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"هەموو ئێسقانەکانم دەژمێرم،","poem":1},{"text":"ئەمانە تەماشام دەکەن و سەرنجیان لەسەرمە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"جلوبەرگەکەم لەنێو خۆیان بەش دەکەن،","poem":1},{"text":"تیروپشک لەسەر کراسەکەم دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"بەڵام تۆ ئەی یەزدان، لێم دوور مەبە،","poem":1},{"text":"ئەی هێزی من، زوو بگە فریام.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ژیانم لە شمشێر دەرباز بکە،","poem":1},{"text":"ژیانی بەهادارم لە چنگی سەگ.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لە دەمی شێر ڕزگارم بکە،","poem":1},{"text":"لە قۆچی گای کێوی، دەربازم بکە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ناوی تۆ بە براکانم ڕادەگەیەنم،","poem":1},{"text":"لەناو کۆمەڵدا ستایشت دەکەم.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ئەی لەخواترسەکان، ستایشی بکەن!","poem":1},{"text":"ئەی هەموو نەوەکانی یاقوب، شکۆداری بکەن!","poem":2},{"lineBreak":true},{"text":"ئەی هەموو نەوەکانی ئیسرائیل، لێی بترسن!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"لەبەر ئەوەی بە سووکییەوە نەیڕوانییە ستەمی ستەملێکراوەکە و پشتی لێ ناکات،","poem":1},{"text":"ڕووی لێ وەرناگێڕێت،","poem":2},{"lineBreak":true},{"text":"بەڵکو گوێ لە هاواری دەگرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"لە کۆڕ و کۆمەڵی گەورەدا تۆ بابەتی ستایشکردنی منی،","poem":1},{"text":"نەزرەکانم","poem":2},{"noteId":33},{"text":"بەجێدەهێنم لەپێش ئەوانەی ترسی تۆیان هەیە.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"هەژارەکان دەخۆن","poem":1},{"noteId":34},{"text":"و تێر دەبن،","poem":1},{"text":"ئەوانەی ڕوو لە یەزدان دەکەن ستایشی دەکەن،","poem":2},{"lineBreak":true},{"text":"دڵتان بۆ هەتاهەتایە بژیێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"سەرانسەری زەوی یەزدانیان بەبیر دێتەوە و دەگەڕێنەوە لای ئەو،","poem":1},{"text":"هەروەها هەموو هۆزەکانی نەتەوەکان لەبەردەمی کڕنۆش دەبەن،","poem":2}]},{"type":"verse","number":28,"content":[{"text":"چونکە پاشایەتی بۆ یەزدانە و","poem":1},{"text":"ئەو فەرمانڕەوایەتی نەتەوەکان دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"هەموو دەوڵەمەندەکانی سەر زەوی دەخۆن و کڕنۆشی بۆ دەبەن،","poem":1},{"text":"هەروەها هەموو ئەوانەی دەچنە ناو خۆڵ لەبەردەمی ئەو چۆک دادەدەن،","poem":2},{"lineBreak":true},{"text":"ئەوانەی ناتوانن خۆیان بە زیندوویی بهێڵنەوە.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"نەوەکان دەیپەرستن،","poem":1},{"text":"باسی پەروەردگار بۆ نەوەکانی داهاتوو دەکرێت.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ڕاستودروستییەکەی بەو خەڵکانە ڕادەگەیەنن کە هێشتا لەدایک نەبوونە،","poem":1},{"text":"چونکە ئەم کارەی","poem":2},{"noteId":35},{"text":"کردووە.","poem":2}]}],"footnotes":[{"noteId":31,"caller":"+","text":"عیبری: کرمێک.‏","reference":{"chapter":22,"verse":6}},{"noteId":32,"caller":"+","text":"شوێنێک بووە لە ڕۆژهەڵاتی ڕووباری ئوردون و لەوەڕگایەکی بەناوبانگ بووە بۆ گا.‏","reference":{"chapter":22,"verse":12}},{"noteId":33,"caller":"+","text":"نەزر: داوا لە خودا دەکرێت بۆ ئەنجامدانی کارێک، کارەکە پابەند دەکرێت بە مەرجێکەوە. ئەگەر خودا ئەوە بکات، ئەوا دەرئەنجام ئەو کارەی بۆ ئەنجام دەدرێت کە پێیەوە پابەند کراوە. بڕوانە سەرژمێری 2‏:21‏‏.‏","reference":{"chapter":22,"verse":25}},{"noteId":34,"caller":"+","text":"لەدوای بەجێهێنانی نەزر قوربانی هاوبەشی دەکرێت و هەژاران لەو قوربانییە دەخۆن.‏","reference":{"chapter":22,"verse":26}},{"noteId":35,"caller":"+","text":"مەبەستی لە کارەکانی خودایە لەناو ئەم دەقە.‏","reference":{"chapter":22,"verse":31}}]},"thisChapterLink":"/api/ckb_bib/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}