و نەوەیەی دوای یەزدان دەکەوێت،","poem":1},{"text":"ئەوەی ڕوویان لە تۆ دەکەن، ئەی خودای یاقوب.","poem":2},{"noteId":36}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئەی دەروازەکان، سەر هەڵبڕن!","poem":1},{"text":"ئەی دەرگا دێرینەکان، بەرزبنەوە،","poem":2},{"lineBreak":true},{"text":"هەتا پاشای شکۆمەندی بێتە ژوورەوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەم پاشایەی شکۆمەندی کێیە؟","poem":1},{"text":"یەزدانی بەهێز و دەسەڵاتدارە،","poem":2},{"lineBreak":true},{"text":"یەزدانی پاڵەوان لە جەنگ.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەی دەروازەکان، سەر هەڵبڕن!","poem":1},{"text":"ئەی دەرگا دێرینەکان، بەرزبنەوە!","poem":2},{"lineBreak":true},{"text":"هەتا پاشای شکۆمەندی بێتە ژوورەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەم پاشایەی شکۆمەندی کێیە؟","poem":1},{"text":"یەزدانی سوپاسالار پاشای شکۆمەندییە.","poem":2}]}],"footnotes":[{"noteId":36,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتی 10، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":24,"verse":6}}]},"thisChapterLink":"/api/ckb_bib/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}