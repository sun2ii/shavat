text":"لە تەنگانەکانم ڕزگارم بکە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"تەماشای داماوی و ڕەنجکێشانم بکە و","poem":1},{"text":"لە هەموو گوناهەکانم خۆشبە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"تەماشای دوژمنەکانم بکە چەند زۆر بوونە و","poem":1},{"text":"چەند بە قینەوە ڕقیان لێمە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ژیانم بپارێزە و ڕزگارم بکە،","poem":1},{"text":"شەرمەزارم مەکە،","poem":2},{"lineBreak":true},{"text":"چونکە پەنا وەبەر تۆ دەهێنم.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"با دروستی و سەرڕاستی پارێزەرم بن،","poem":1},{"text":"چونکە ئومێدم بە تۆیە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ئەی خودایە، ئیسرائیل بکڕەوە","poem":1},{"text":"لە هەموو تەنگانەکانی!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}