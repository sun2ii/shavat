{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["زەبوورێکی داود."]},{"type":"verse","number":1,"content":[{"text":"یەزدان ڕووناکی و ڕزگاریی منە،","poem":1},{"text":"لە کێ بترسم؟","poem":2},{"text":"یەزدان قەڵای ژیانی منە،","poem":1},{"text":"لە کێ بتۆقم؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"کاتێک بەدکاران لێم نزیک بنەوە","poem":1},{"text":"بۆ ئەوەی گۆشتم بخۆن،","poem":2},{"text":"کاتێک دوژمنان و ناحەزانم پەلامارم بدەن،","poem":1},{"text":"ساتمە دەکەن و دەکەون.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئەگەر لەشکرێکیش دەورم بدات،","poem":1},{"text":"دڵم ناترسێت.","poem":2},{"text":"ئەگەر جەنگ بەرپا بکەن دژم،","poem":1},{"text":"ئەو کاتەش هەر دڵنیا دەبم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"داوای یەک شت لە یەزدان دەکەم،","poem":1},{"text":"ئەوەی بەدوایدا دەگەڕێم:","poem":2},{"text":"کە هەموو ڕۆژانی ژیانم","poem":1},{"text":"لە ماڵی یەزدان نیشتەجێ بم،","poem":2},{"text":"تاکو تەماشای جوانی یەزدان بکەم و","poem":1},{"text":"لە پەرستگاکەی ورد ببمەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لەبەر ئەوەی لە ڕۆژی بەڵا،","poem":1},{"text":"لەژێر سێبەری خۆی دەمشارێتەوە،","poem":2},{"text":"بە پڵاسی نشینگەکەی دامدەپۆشێت.","poem":1},{"text":"بۆ سەر تاشەبەردێک بڵندم دەکاتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ئێستاش سەرفرازم بەسەر دوژمنانی دەوروبەرم،","poem":1},{"text":"لەناو نشینگەکەیدا بە هاوار و خۆشییەوە قوربانی پێشکەش دەکەم،","poem":2},{"lineBreak":true},{"text":"سروود بۆ یەزدان دەڵێم و مۆسیقا دەژەنم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئەی یەزدان، گوێت لە دەنگم بێ کاتێک لێت دەپاڕێمەوە،","poem":1},{"text":"لەگەڵم میهرەبان بە و وەڵامم بدەوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"سەبارەت بە تۆ دڵم دەڵێت: «ڕووت لەو بکە!»","poem":1},{"text":"ئەی یەزدان، ڕووم لە تۆ دەکەم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ڕووی خۆتم لێ مەشارەوە،","poem":1},{"text":"خزمەتکاری خۆت لە کاتی تووڕەییت مەگەڕێنەوە،","poem":2},{"lineBreak":true},{"text":"تۆ یارمەتیدەری من بوویت.","poem":2},{"text":"ئەی خودای ڕزگارکەرم،","poem":1},{"text":"ڕەتم مەکەرەوە و جێم مەهێڵە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"تەنانەت دایک و باوکیشم وازم لێ بهێنن،","poem":1},{"text":"یەزدان دەمگرێتە خۆی.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەی یەزدان، ڕێگای خۆتم فێر بکە،","poem":1},{"text":"بۆ ڕێگای ڕاست ڕێنماییم بکە،","poem":2},{"lineBreak":true},{"text":"لەبەر دوژمنەکانم.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بە ویستی ناحەزەکانم مەمسپێرە،","poem":1},{"text":"چونکە شایەتی درۆ لێم ڕاست بوونەتەوە،","poem":2},{"lineBreak":true},{"text":"هەناسەی زۆردارییان لێ دێتە دەرەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"من هێشتا باوەڕم بەوە هەیە،","poem":1},{"text":"کە لە خاکی زیندووان","poem":2},{"lineBreak":true},{"text":"چاکەی یەزدان دەبینم.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"چاوەڕێی یەزدان بە،","poem":1},{"text":"خۆت ئازا بکە و دڵت بەهێز بکە،","poem":2},{"lineBreak":true},{"text":"چاوەڕێی یەزدان بە.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}