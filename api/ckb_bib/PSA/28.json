 کردەوەکانی دەستیان سزایان بدە و","poem":2},{"lineBreak":true},{"text":"ڕەفتارەکانی خۆیان بگەڕێنەوە سەر خۆیان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"لەبەر ئەوەی گوێ نادەن بە کردارەکانی یەزدان و","poem":1},{"text":"بە کارەکانی دەستی،","poem":2},{"text":"تێکیان دەشکێنێت و","poem":1},{"text":"جارێکی دیکە بنیادیان نانێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ستایش بۆ یەزدان،","poem":1},{"text":"چونکە گوێی لە دەنگی پاڕانەوەم بوو.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"یەزدان هێز و قەڵغانی منە،","poem":1},{"text":"دڵم متمانەی بەو کرد و یارمەتیم وەرگرت،","poem":2},{"text":"دڵم شاد دەبێت و","poem":1},{"text":"بە گۆرانی خۆم ستایشی دەکەم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"یەزدان هێزی گەلەکەیەتی،","poem":1},{"text":"قەڵای ڕزگاریی دەستنیشانکراوەکەی","poem":2},{"noteId":37},{"text":".","poem":2}]},{"type":"verse","number":9,"content":[{"text":"گەلەکەت ڕزگار بکە و میراتەکەت بەرەکەتدار بکە،","poem":1},{"text":"ببە بە شوانیان و هەتاهەتایە هەڵیانبگرە.","poem":2}]}],"footnotes":[{"noteId":37,"caller":"+","text":"بە زمانی عیبری پێی دەگوترێ مەشیخ‏ یان مەشیح‏.‏","reference":{"chapter":28,"verse":8}}]},"thisChapterLink":"/api/ckb_bib/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}