{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["زەبوورێکی داود.گۆرانییەک بۆ تەرخانکردنی پەرستگا.",{"noteId":41}]},{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، بە گەورەت دەزانم،","poem":1},{"text":"چونکە هەڵتکێشام و","poem":2},{"lineBreak":true},{"text":"نەتهێشت دوژمنەکانم شانازیم بەسەردا بکەن.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەی یەزدان، خودای من، هاوارم بۆ تۆ هێنا،","poem":1},{"text":"تۆش چاکت کردمەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئەی یەزدان، تۆ گیانی منت لەناو جیهانی مردووان هێنایە دەرەوە،","poem":1},{"text":"منت دەرباز کرد لەوەی شۆڕببمەوە ناو گۆڕ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ئەی خۆشەویستانی یەزدان، گۆرانی بۆ بڵێن،","poem":1},{"text":"ستایشی ناوە پیرۆزەکەی بکەن،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"چونکە تووڕەبوونی تەنها چرکەیەکە،","poem":1},{"text":"بەڵام ڕەزامەندی بە درێژایی ژیانە.","poem":2},{"text":"ڕەنگە گریان بۆ شەوێ بمێنێت،","poem":1},{"text":"بەڵام بۆ بەیانییەکەی هەلهەلە دێنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"کاتێک هەستم بە دڵنیایی کرد گوتم:","poem":1},{"text":"«هەرگیز نالەقێم.»","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئەی یەزدان، بە ڕەزامەندی خۆت،","poem":1},{"text":"منت وەک چیایەکی بەهێز چەسپاند،","poem":2},{"text":"بەڵام کە ڕووی خۆتت لە من شاردەوە،","poem":1},{"text":"پەرێشان بووم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ئەی یەزدان، من هاوارم بۆ تۆ هێنا،","poem":1},{"text":"من لە پەروەردگار پاڕامەوە:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"«مەرگی من سوودی چی تێدایە،","poem":1},{"text":"ئەگەر من شۆڕ ببمەوە ناو گۆڕ؟","poem":2},{"text":"ئایا خۆڵ ستایشت دەکات؟","poem":1},{"text":"ئایا دڵسۆزیت ڕادەگەیەنێت؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەی یەزدان، گوێ بگرە و لەگەڵم میهرەبان بە!","poem":1},{"text":"ئەی یەزدان، ببە بە یارمەتیدەرم!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"تۆ شینی منت گۆڕی بۆ شایی،","poem":1},{"text":"جلوبەرگی گوشت","poem":2},{"noteId":42},{"text":"لەبەر داماڵیم و بەرگی شادیت لەبەرکردم،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بۆ ئەوەی دڵم گۆرانیت بۆ بڵێت و بێدەنگ نەبێت.","poem":1},{"text":"ئەی یەزدان، خودای من، هەتاهەتایە هەر ستایشت دەکەم.","poem":2}]}],"footnotes":[{"noteId":41,"caller":"+","text":"بڕوانە یەکەم پاشایان 8‏:61 و دووەم پوختەی مێژوو 7‏‏.‏","reference":{"chapter":30,"verse":0}},{"noteId":42,"caller":"+","text":"لە کاتی ماتەمگێڕان و تۆبەکردندا جلوبەرگی لە گوش دروستکراویان لەبەرکردووە کە ئەزیەتی پێستیانی داوە.‏","reference":{"chapter":30,"verse":11}}]},"thisChapterLink":"/api/ckb_bib/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}