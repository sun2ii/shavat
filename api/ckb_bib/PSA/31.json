{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، زەبوورێکی داود."]},{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، من پەنا دەبەمە بەر تۆ،","poem":1},{"text":"با هەرگیز شەرمەزار نەبم،","poem":2},{"lineBreak":true},{"text":"بە ڕاستودروستی خۆت دەربازم بکە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"گوێت بۆم شل بکە،","poem":1},{"text":"بە زوویی فریام بکەوە،","poem":2},{"text":"ببە بەو تاشەبەردەی پەنای بۆ دەبەم،","poem":1},{"text":"بەو قەڵا سەختە بۆ ڕزگارکردنم.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لەبەر ئەوەی تاشەبەرد و قەڵای منی،","poem":1},{"text":"لە پێناوی ناوی خۆت ڕابەرایەتی و ڕێنماییم بکە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لەو تەڵەیەی بۆم نراوەتەوە ئازادم بکە،","poem":1},{"text":"چونکە تۆ پەناگای منی.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ڕۆحی خۆم بە دەستی تۆ دەسپێرم،","poem":1},{"text":"ئەی یەزدان، خودای ڕاستی، بمکڕەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"من ڕقم لەوانە دەبێتەوە کە دەست بە بتی پووچەوە دەگرن،","poem":1},{"text":"من متمانەم بە یەزدان هەیە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"من بە خۆشەویستی نەگۆڕی تۆ شاد و دڵخۆش دەبم،","poem":1},{"text":"چونکە تۆ دەردی منت بینیوە و","poem":2},{"lineBreak":true},{"text":"لە تەنگانەدا گیانی منت ناسیوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"نەتخستوومەتە بەردەستی دوژمنان،","poem":1},{"text":"بەڵکو لەسەر شوێنێکی فراوان ڕاتگرتووم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەی یەزدان، لەگەڵم میهرەبان بە، چونکە لە تەنگانەدام.","poem":1},{"text":"چاوەکانم کزبوون لە خەفەتان،","poem":2},{"lineBreak":true},{"text":"ڕۆح و لەشم لە خەمان.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ژیانم بە خەم و خەفەت فەوتاوە،","poem":1},{"text":"ساڵانی تەمەنم بە ئاخ هەڵکێشان،","poem":2},{"text":"لەبەر دەرد و بەڵا هێزم لێ بڕاوە،","poem":1},{"text":"ئێسقانەکانم پووکاونەتەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بەهۆی دوژمنەکانمەوە،","poem":1},{"text":"بە تەواوی بوومەتە مایەی شەرمەزاری لای دراوسێکانم،","poem":2},{"text":"بوومەتە مایەی ترس بۆ ئاشناکانم،","poem":1},{"text":"ئەوانەی لە شەقامدا دەمبینن، لێم دوور دەکەونەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لەبیرکراوم وەک ئەوەی مردبم،","poem":1},{"text":"وەک قاپێکی شکاوم بەسەرهاتووە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"گوێم لە چپەچپی زۆر کەس بووە،","poem":1},{"text":"«لە هەموو لایەکەوە ترس و تۆقین هەیە!»","poem":2},{"text":"هەموو پێکەوە پیلان لە دژم دەگێڕن،","poem":1},{"text":"بیر لەوە دەکەنەوە ژیانم لەناو ببەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"بەڵام ئەی یەزدان، من پشتم بە تۆ بەستووە،","poem":1},{"text":"دەڵێم: «تۆ خودای منیت.»","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ڕۆژگارم لەناو دەستی تۆدایە،","poem":1},{"text":"لە دەستی دوژمنان و","poem":2},{"lineBreak":true},{"text":"ئەوانەی ڕاوم دەنێن دەربازم بکە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"با ڕوخسارت بەسەر خزمەتکاری خۆتدا بدرەوشێتەوە،","poem":1},{"text":"بە خۆشەویستی نەگۆڕی خۆت ڕزگارم بکە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"با شەرمەزار نەبم ئەی یەزدان،","poem":1},{"text":"چونکە هاوار بۆ تۆ دەهێنم،","poem":2},{"text":"با بەدکاران شەرمەزار بن،","poem":1},{"text":"لەناو جیهانی مردووان خامۆش بن.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"با زمانە درۆزنەکانیان لاڵ بێت،","poem":1},{"text":"چونکە بە فیز و وشەی ناشیرینەوە","poem":2},{"lineBreak":true},{"text":"سووکایەتی بە سەرڕاستان دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"چاکەت چەند مەزنە،","poem":1},{"text":"کە هەڵتگرتووە بۆ ئەوانەی ترسی تۆیان لە دڵدایە،","poem":2},{"text":"ئەوەی بە بەرچاوی خەڵکەوە،","poem":1},{"text":"بەوانەی دەبەخشیت کە پەنات بۆ دەهێنن.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"لە پەنای خۆت دەیانشاریتەوە،","poem":1},{"text":"لە پیلانەکانی خەڵکی،","poem":2},{"text":"لەژێر سێبەری خۆت دەیانپارێزیت،","poem":1},{"text":"لە زمانی سکاڵاکەران.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ستایش بۆ یەزدان،","poem":1},{"text":"چونکە خۆشەویستییە نەگۆڕە سەرسوڕهێنەرەکەی خۆی نیشاندام،","poem":2},{"lineBreak":true},{"text":"کاتێک لە شارێکی ئابڵوقەدراو بووم.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"لە کاتی سەرلێشێوانم گوتم:","poem":1},{"text":"«لەبەرچاوت نەماوم!»","poem":2},{"text":"بەڵام تۆ گوێت لە دەنگی پاڕانەوەم گرت،","poem":1},{"text":"کە هاوارم بۆت هێنا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ئەی هەموو خۆشەویستانی، یەزدانتان خۆشبوێت!","poem":1},{"text":"یەزدان دڵسۆزەکان دەپارێزێت،","poem":2},{"lineBreak":true},{"text":"بەڵام بە تەواوی سزای لووتبەرزەکان دەدات.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ئازابن و دڵتان بەهێز بکەن،","poem":1},{"text":"ئەی هەموو ئەوانەی هیواتان بە یەزدان هەیە.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}