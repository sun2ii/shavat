{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["هۆنراوەیەکی داود."]},{"type":"verse","number":1,"content":[{"text":"خۆزگە دەخوازرێ بەوەی لە یاخیبوونەکانی بەخشراوە،","poem":1},{"text":"گوناهەکانی داپۆشراوە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"خۆزگە دەخوازرێ بەو کەسەی","poem":1},{"text":"کە یەزدان تاوانی لەسەر ناژمێرێت و","poem":2},{"lineBreak":true},{"text":"لە ڕۆحەکەی بێ فێڵە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"کاتێک دانم بە گوناهەکانمدا نەنا،","poem":1},{"text":"ئێسقانەکانم پووکانەوە،","poem":2},{"lineBreak":true},{"text":"لە ناڵینم بە درێژایی ڕۆژ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لەبەر ئەوەی بە شەو و بە ڕۆژ،","poem":1},{"text":"دەستت بەسەر سەرمەوە قورس بوو،","poem":2},{"lineBreak":true},{"text":"تەڕێتیم گۆڕا بۆ وشکی هاوین.","poem":2},{"noteId":43}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ئینجا لەلای تۆدا داندەنێم بە گوناهم و","poem":1},{"text":"تاوانم ناشارمەوە.","poem":2},{"text":"گوتم: «لەلای یەزدان داندەنێم بە یاخیبوونم.»","poem":1},{"text":"تۆش لە تاوانی گوناهم خۆشبوویت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"بۆیە با هەموو خواناسێک لێت بپاڕێتەوە","poem":1},{"text":"لە کاتی خۆی بتدۆزێتەوە،","poem":2},{"lineBreak":true},{"text":"بێگومان کە لافاو هەستا، نایگاتێ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"تۆ پەناگای منیت،","poem":1},{"text":"لە تەنگانە دەمپارێزی و","poem":2},{"lineBreak":true},{"text":"بە سروودی دەربازبوون دەورم دەدەیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"خودا دەفەرموێت: «من فێرت دەکەم و ڕێنماییت دەکەم بۆ ئەو ڕێگایەی کە دەبێت پێیدا بڕۆیت،","poem":1},{"text":"ئامۆژگاریت دەکەم و چاودێریت دەکەم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"وەک ئەسپ و هێستر مەبە کە هیچ تێناگەن،","poem":1},{"text":"بەڵکو دەبێت لغاوی لە دەم بکرێت و جڵەوی ڕابکێشرێت،","poem":2},{"lineBreak":true},{"text":"بۆ ئەوەی لێت نزیک ببێتەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بەدکارەکان ئازاریان زۆرە،","poem":1},{"text":"بەڵام ئەوەی پشت بە یەزدان ببەستێت،","poem":2},{"lineBreak":true},{"text":"خۆشەویستی نەگۆڕ دەوری دەدات.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ئەی سەرڕاستەکان، شاد بن بە یەزدان و دڵخۆش بن،","poem":1},{"text":"ئەی هەموو دڵڕاستەکان، گۆرانی بڵێن!","poem":2}]}],"footnotes":[{"noteId":43,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتەکانی 5 و 7، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":32,"verse":4}}]},"thisChapterLink":"/api/ckb_bib/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}