{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"ئەی سەرڕاستان گۆرانی شادی بۆ یەزدان بڵێن،","poem":1},{"text":"ستایشکردن لە دڵڕاستان دەوەشێتەوە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بە ساز ستایشی یەزدان بکەن،","poem":1},{"text":"بە قیسارەی دە ژێیی مۆسیقای بۆ بژەنن.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"سروودێکی نوێی بۆ بڵێن،","poem":1},{"text":"بە کارامەیی مۆسیقا بژەنن، بە هەلهەلەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"لەبەر ئەوەی فەرمایشتی یەزدان ڕاستە،","poem":1},{"text":"لە هەموو کردارەکانی دڵسۆزە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"یەزدان ڕاستودروستی و دادپەروەری خۆشدەوێت،","poem":1},{"text":"زەوی پڕ بووە لە خۆشەویستییە نەگۆڕەکەی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"بە فەرمانی یەزدان ئاسمان دروستکرا،","poem":1},{"text":"بە هەناسەی دەمی هەموو ئەستێرەکانی ئاسمان.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئاوی دەریا وەک بەنداو کۆدەکاتەوە و","poem":1},{"text":"زەریاکان دەخاتە ناو ئەمبارەوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"با هەموو زەوی لە یەزدان بترسێت،","poem":1},{"text":"با هەموو خەڵکی دنیا سام دایانگرێت!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"لەبەر ئەوەی کە فەرمووی، پەیدا بوو،","poem":1},{"text":"فەرمانی دا، بوو.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"یەزدان پیلانی نەتەوەکانی پووچ کردەوە،","poem":1},{"text":"تەگبیری گەلانی هەڵوەشاندەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بەڵام پلانی یەزدان هەتاهەتایە دەمێنێت،","poem":1},{"text":"تەگبیری دڵی بۆ هەموو نەوەکانە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"خۆزگە دەخوازرێ بەو نەتەوەیەی کە یەزدان خودایانە،","poem":1},{"text":"بەو گەلەی هەڵیبژاردووە بۆ میراتی خۆی.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"یەزدان لە ئاسمانەوە دەڕوانێتە خوارێ،","poem":1},{"text":"هەموو ئادەمیزاد دەبینێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"لە نشینگەکەی خۆیەوە","poem":1},{"text":"چاودێری هەموو دانیشتووانی زەوی دەکات.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەو کە شێوەی دڵی هەمووانی دروستکردووە،","poem":1},{"text":"ئاگاداری هەموو کردەوەکانیانە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"هیچ پاشایەک بە گەورەیی سوپاکەی ڕزگاری نابێت،","poem":1},{"text":"هیچ پاڵەوانێک بە هێزی بازووی دەرباز نابێت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئەسپ ئومێدێکی دۆڕاوە بۆ ڕزگار بوون،","poem":1},{"text":"بە توندی هێزی ناتوانێت کەس دەرباز بکات.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بەڵام یەزدان چاوی لەوانەیە کە ترسی ئەویان لە دڵدایە،","poem":1},{"text":"ئەوانەی هیوایان بە خۆشەویستی نەگۆڕی ئەوە،","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بۆ ئەوەی لە مردندا فریایان بکەوێت و","poem":1},{"text":"لە قاتوقڕیدا ژیانیان دابین بکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ئێمە بە ئومێدی چاوەڕوانی یەزدانین،","poem":1},{"text":"یەزدان یارمەتیدەر و قەڵغانمانە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"دڵمان بەو خۆشە،","poem":1},{"text":"چونکە ئێمە پشت بە ناوی پیرۆزی ئەو دەبەستین.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ئەی یەزدان، با خۆشەویستی نەگۆڕت بەسەرمانەوە بێت،","poem":1},{"text":"بەگوێرەی هیوامان بە تۆ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}