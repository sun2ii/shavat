{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["زەبوورێکی داود."]},{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، ململانێی ئەوانە بکە کە ململانێم لەگەڵ دەکەن،","poem":1},{"text":"لە دژی ئەوانە بجەنگە کە لە دژی من دەجەنگن.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"سپەر بپۆشە و قەڵغان هەڵبگرە،","poem":1},{"text":"ڕاپەڕە و بگە فریام.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ڕم ئاراستە بکە و تەور هەڵبگرە","poem":1},{"text":"لە دژی ئەوانەی ڕاوم دەنێن.","poem":2},{"lineBreak":true},{"text":"بە گیانم بڵێ: «من ڕزگاریی تۆم.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"با ڕیسوا و شەرمەزار بن","poem":1},{"text":"ئەوانەی هەوڵی کوشتنم دەدەن،","poem":2},{"text":"با بەرەو پاش ببنەوە و ڕیسوا بن","poem":1},{"text":"ئەوانەی پیلان دادەنێن بۆ ڕاوکردنم.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"با وەک کای بەر بایان لێ بێت،","poem":1},{"text":"فریشتەی یەزدان ڕایانبماڵێت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"با ڕێگایان تاریک و خلیسک بێت،","poem":1},{"text":"فریشتەی یەزدان ڕاویان بنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"لەبەر ئەوەی بەبێ هۆ داویان بۆ نامەوە،","poem":1},{"text":"بەبێ هۆ چاڵیان بۆ هەڵکەندم،","poem":2}]},{"type":"verse","number":8,"content":[{"text":"با ماڵوێرانی لەناکاو بەسەریاندا بدات،","poem":1},{"text":"با بەو داوەوە بن کە خۆیان ناویانەتەوە،","poem":2},{"lineBreak":true},{"text":"با بکەونە ئەو ماڵوێرانییە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەوسا گیانم بە یەزدان شاد دەبێت،","poem":1},{"text":"بە ڕزگارییەکەی دڵخۆش دەبێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"هەموو ئێسقانەکانم هاوار دەکەن:","poem":1},{"text":"«ئەی یەزدان، کێ وەک تۆیە؟","poem":2},{"text":"تۆ داماو دەرباز دەکەیت لە دەست ئەوانەی کە لەو بەهێزترن،","poem":1},{"text":"هەژار و نەبوون لە دەست ئەوانەی دەیانڕووتێننەوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"شایەتە دڵڕەقەکان ڕاست دەبنەوە،","poem":1},{"text":"پرسیاری شتی وا دەکەن کە ئاگام لێی نییە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بەرامبەر بە چاکە خراپەم دەدەنەوە،","poem":1},{"text":"گیانم بە بێکەسی جێدەهێڵن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بەڵام کاتێک ئەوان نەخۆش دەکەوتن، جلوبەرگی گوشم دەپۆشی،","poem":1},{"text":"بە ڕۆژووگرتن خۆمم نزم دەکردەوە.","poem":2},{"text":"کاتێک نوێژەکانم بەبێ وەڵام دەگەڕانەوە،","poem":1}]},{"type":"verse","number":14,"content":[{"text":"وەک ئەوەی دۆست و برام بێت،","poem":2},{"lineBreak":true},{"text":"پرسەدار بووم بۆی،","poem":2},{"text":"وەک ئەوەی بۆ دایکم بلاوێنمەوە،","poem":1},{"text":"لە خەفەتان سەرم دانەواند بوو.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بەڵام کە کەوتم، ئەوان بە خۆشییەوە لە دژی من کۆبوونەوە،","poem":1},{"text":"کەسانێک بێ ئەوەی بیانناسم هێرشیان هێنایە سەرم و","poem":2},{"lineBreak":true},{"text":"بەبێ وەستان ئابڕوویان بردم.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"وەک خوانەناسان بە خراپی گاڵتەجاڕی دەکەن،","poem":1},{"text":"ددانیان لێ جیڕدەکردمەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ئەی پەروەردگار، هەتا کەی تەماشا دەکەیت؟","poem":1},{"text":"گیانم دەرباز بکە لە دەست تێکدەرییان،","poem":2},{"lineBreak":true},{"text":"ژیانم لەو بەچکە شێرانە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"لەنێو کۆڕی گەورە سوپاست دەکەم،","poem":1},{"text":"لەنێو خەڵکێکی زۆر ستایشت دەکەم.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"مەهێڵە ئەوانە پێم شاد بن،","poem":1},{"text":"کە بەبێ هۆ بوونەتە دوژمنم.","poem":2},{"text":"مەهێڵە ئەوانەی بەبێ هۆ ڕقیان لێمە،","poem":1},{"text":"بە مەکرەوە چاو لە یەک دابگرن.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئەوانە قسە بۆ ئاشتی ناکەن،","poem":1},{"text":"بەڵکو درۆ دادەڕێژن","poem":2},{"lineBreak":true},{"text":"لە دژی ئەوانەی بە ئارامی دەژین لەسەر زەوی.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"دەمیان لێم دەکەنەوە و دەڵێن:","poem":1},{"text":"«ئەها! بە چاوی خۆمان بینیمان.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ئەی یەزدان، تۆ ئەمەت بینی، بێدەنگ مەبە.","poem":1},{"text":"ئەی پەروەردگار، لێم دوور مەبە.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"هەستە و ڕاپەڕە بۆ دادم،","poem":1},{"text":"ئەی خودا و گەورەی من، بۆ مافم.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ئەی یەزدان، خودای من، بەپێی ڕاستودروستی خۆت ئەستۆپاکیم بسەلمێنە،","poem":1},{"text":"مەهێڵە ئەوانە پێم شاد بن.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"مەهێڵە لە دڵی خۆیان بڵێن: «ئەمە مرازی ئێمەیە!»","poem":1},{"text":"یان بڵێن: «هەڵمانلووشی.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"با هەموو ئەوانەی بە گرفتی من شاد دەبن،","poem":1},{"text":"تووشی شەرمەزاری و گومڕایی بن.","poem":2},{"text":"با هەموو ئەوانەی پۆز بەسەر مندا لێدەدەن،","poem":1},{"text":"بەرگی شەرمەزاری و ڕیسوایی بپۆشن.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"با ئەوانەی بە بێتاوانکردنی من دڵخۆشن،","poem":1},{"text":"گۆرانی خۆشی و شادی بڵێن.","poem":2},{"text":"با هەمیشە بڵێن: «یەزدان پایەبەرز بێت،","poem":1},{"text":"کە دڵخۆش دەبێت بە ئاشتی خزمەتکارەکەی.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"زمانم باسی ڕاستودروستی تۆ دەکات و","poem":1},{"text":"بە درێژایی ڕۆژ ستایشت دەکات.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}