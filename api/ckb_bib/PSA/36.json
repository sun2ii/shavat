{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، زەبوورێکی داودی بەندەی یەزدانە."]},{"type":"verse","number":1,"content":[{"text":"جاڕنامەیەک لە ناخی دڵمە","poem":1},{"text":"دەربارەی یاخیبوونی بەدکار:","poem":2},{"lineBreak":true},{"text":"ترسی خودای لەبەرچاو نییە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"بە ڕادەیەک خۆی دەڕازێنێتەوە","poem":1},{"text":"کە خۆی هەست بە گوناهی خۆی ناکات و ڕقی لێ نابێتەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"قسەی دەمی خراپە و تەفرەدانە،","poem":1},{"text":"دەستبەرداری وریایی و چاکی بووە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"تەنانەت لەناو نوێنیش بیر لە پیلانی خراپە دەکاتەوە،","poem":1},{"text":"خۆی دەخاتە سەر ڕێگایەک کە باش نییە،","poem":2},{"lineBreak":true},{"text":"هەڵە ڕەت ناکاتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ئەی یەزدان، خۆشەویستییە نەگۆڕەکەت دەگاتە ئاسمان،","poem":1},{"text":"دڵسۆزیت دەگاتە هەورەکان.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ڕاستودروستییەکەت وەک چیا سەرکەشەکانە،","poem":1},{"text":"دادپەروەرییەکەت وەک دەریا گەورەکەی ژێر زەوییە","poem":2},{"noteId":45},{"text":".","poem":2},{"text":"ئەی یەزدان، تۆ مرۆڤ و ئاژەڵەکانیش ڕزگار دەکەیت.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"ئەی خودایە، خۆشەویستییە نەگۆڕەکەت چەند بەنرخە!","poem":2},{"text":"ئادەمیزاد لەژێر سێبەری باڵەکانت پەنا دەگرن.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"بە چەوری ماڵەکەت تێر دەبن،","poem":1},{"text":"تۆش پێیان دەدەیت لە ڕووباری خۆشییەکانت بنۆشن،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"چونکە کانی ژیان لەلای تۆیە،","poem":1},{"text":"بە ڕووناکی تۆ ئێمە ڕووناکی دەبینین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"با خۆشەویستییە نەگۆڕەکەت بەردەوام بێت بۆ ئەوانەی دەتناسن،","poem":1},{"text":"ڕاستودروستییەکەشت بۆ ئەوانەی دڵڕاستن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"با نەکەومە ژێر پێی پیاوی لووتبەرز،","poem":1},{"text":"دەستی بەدکاران وێڵم نەکات.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ببینە بەدکاران چۆن دەڕووخێن،","poem":1},{"text":"دەکەون و ناتوانن هەستنەوە!","poem":2}]}],"footnotes":[{"noteId":45,"caller":"+","text":"بەپێی بیروباوەڕی خەڵکی ڕۆژهەڵاتی کۆن (دەریای ژێر زەوی) هەبوو کە سەرچاوەی کانیاو و ڕووبارەکان بوو.‏","reference":{"chapter":36,"verse":6}}]},"thisChapterLink":"/api/ckb_bib/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}