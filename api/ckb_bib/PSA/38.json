{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":38,"content":[{"type":"hebrew_subtitle","content":["زەبوورێکی داود، بۆ یادکردنەوە."]},{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، بە تووڕەیی خۆت سەرزەنشتم مەکە،","poem":1},{"text":"بە ڕقی خۆت تەمبێم مەکە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"تیرەکانت منیان پێکا،","poem":1},{"text":"دەستت منی خستە خوارەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بەهۆی تووڕەیی تۆوە تەندروستی لە لەشمدا نەماوە،","poem":1},{"text":"بەهۆی گوناهمەوە ساغی لە ئێسقانەکانمدا نەماوە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"تاوانەکانم بەسەر سەرم کەوتوون،","poem":1},{"text":"وەک بارێکی گران کە توانام نییە هەڵیبگرم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"برینەکانم بۆگەن بوون و چڵکیان کردووە،","poem":1},{"text":"بەهۆی گێلایەتی خۆم.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"پشتم چەماوەتەوە و کووڕ بوومەتەوە،","poem":1},{"text":"بە درێژایی ڕۆژ ماتەم دەگێڕم.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"کەلەکەم","poem":1},{"noteId":47},{"text":"پڕ بووە لە ژانێکی سووتێنەر،","poem":1},{"text":"تەندروستی لە لەشمدا نەماوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بە تەواوی تێکشکاوم و بێهێز بووم،","poem":1},{"text":"لەبەر نەهامەتی دڵم هەر دەناڵێنم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەی پەروەردگار، هەموو ئارەزووەکانم لەپێش چاوتە،","poem":1},{"text":"ئاخ هەڵکێشانم لە تۆ شاردراوە نییە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"دڵەکوتێمە و هێزم لەبەر بڕاوە،","poem":1},{"text":"تەنانەت ڕووناکیش لە چاوانم بڕاوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لەبەر برینەکانم دۆست و برادەرەکانم خۆیان لێم دەپارێزن،","poem":1},{"text":"خزمانم لێم دوور دەکەونەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەوانەی بەدوای ژیانی منەوەن تەڵە دەنێنەوە،","poem":1},{"text":"ئەوانەی دەیانەوێت ئازارم بدەن باسی تێکشکانم دەکەن،","poem":2},{"lineBreak":true},{"text":"بە درێژایی ڕۆژ بیر لە فرتوفێڵ دەکەنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"بەڵام من وەک کەڕ وام، گوێم لێ نابێت،","poem":1},{"text":"وەک لاڵ وام، ناتوانم دەمم بکەمەوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"وەک کەسێکم لێ هاتووە کە نابیستێت،","poem":1},{"text":"هیچ بەهانەیەکیشی لە دەمی نەبێت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەی یەزدان، چاوەڕێی تۆ دەکەم،","poem":1},{"text":"ئەی خودای پەروەردگارم، تۆ وەڵام دەدەیتەوە،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"چونکە گوتم: «مەهێڵە پێم دڵخۆش بن،","poem":1},{"text":"یان کاتێک پێم دەخلیسکێت خۆیان بە گەورە بزانن لە سەرم.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"خەریکە دەکەوم،","poem":1},{"text":"هەمیشە ئازارەکانم لەگەڵمە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"دان بە تاوانی خۆمدا دەنێم،","poem":1},{"text":"بە گوناهی خۆم خەمبار دەبم.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"دوژمن چالاک و بەهێزن،","poem":1},{"text":"ئەوانەی بەبێ هۆ ڕقیان لێمە زۆرن.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئەوانەی بەرامبەری چاکە خراپەم دەدەنەوە،","poem":1},{"text":"دژایەتیم دەکەن، چونکە دوای چاکە کەوتووم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ئەی یەزدان، پشتگوێم مەخە،","poem":1},{"text":"ئەی خودای من، لێم دوور مەکەوە.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ئەی پەروەردگاری ڕزگارکەرم،","poem":1},{"text":"خێرا بگە فریام.","poem":2}]}],"footnotes":[{"noteId":47,"caller":"+","text":"قەبرغەم.‏","reference":{"chapter":38,"verse":7}}]},"thisChapterLink":"/api/ckb_bib/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}