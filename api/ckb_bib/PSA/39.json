{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، بۆ یەدوتون",{"noteId":48},"زەبوورێکی داود."]},{"type":"verse","number":1,"content":[{"text":"گوتم: «چاودێری ڕێگای خۆم دەکەم و","poem":1},{"text":"زمانی خۆم لە گوناه دەپارێزم.","poem":2},{"text":"ئەوەندەی بەدکار لەبەردەممە،","poem":1},{"text":"دەمم بە لغاو دەبەستم.»","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بەڵام کاتێک کپ و بێدەنگ بووم،","poem":1},{"text":"تەنانەت شتی چاکیشم نەدەگوت،","poem":2},{"lineBreak":true},{"text":"ئازارم زیاد بوو.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"دڵم لە ناخمەوە قوڵپی دەدا،","poem":1},{"text":"هەروەها کە نوقومی بیرکردنەوە دەبووم، گڕم دەگرت،","poem":2},{"lineBreak":true},{"text":"ئەوسا بە زمانم هاتمە قسەکردن:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"«ئەی یەزدان، کۆتایی ژیانی خۆم پیشان بدە،","poem":1},{"text":"هەروەها ڕۆژەکانی ژیانم چەندە،","poem":2},{"lineBreak":true},{"text":"بۆ ئەوەی بزانم من چ فەوتاوێکم.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بەڕاستی ڕۆژگاری منت کردووە بە بستێک،","poem":1},{"text":"تەمەنم لەبەرچاوت وەک هیچە.","poem":2},{"lineBreak":true},{"text":"ژیانی هەر مرۆڤێک تەنها هەناسەیەکە.","poem":2},{"noteId":49}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«بەڕاستی مرۆڤ وەک سێبەر دێت و دەچێت،","poem":1},{"text":"ڕەنج دەدات، بەڵام بێگومان بێهوودەیە،","poem":2},{"lineBreak":true},{"text":"سامان کۆدەکاتەوە، نازانێت دوای خۆی بۆ کێ دەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ئێستاش ئەی پەروەردگار، من چاوەڕێی چی بکەم؟","poem":1},{"text":"هیوای من بە تۆیە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"لە هەموو سەرپێچییەکانم ڕزگارم بکە،","poem":1},{"text":"مەمکە بە گاڵتەجاڕی گێلەکان.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بێدەنگ بووم، دەمم ناکەمەوە،","poem":1},{"text":"چونکە تۆ ئەوەی کە ئەمەت کردووە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بەڵای خۆت لەسەر من لابدە،","poem":1},{"text":"بە زەبرەکانی دەستی تۆ فەوتام.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"مرۆڤ بە سەرزەنشتکردنی لەبەر گوناهەکانی تەمبێ دەکەیت،","poem":1},{"text":"وەک مۆرانە سامانی ئەو لەناودەبەیت،","poem":2},{"lineBreak":true},{"text":"هەر مرۆڤێک تەنها هەناسەیەکە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«ئەی یەزدان، گوێ لە نوێژم بگرە،","poem":1},{"text":"گوێ لە هاوارم بگرە،","poem":2},{"lineBreak":true},{"text":"لە ئاست گریانم گوێت دامەخە،","poem":2},{"text":"چونکە لەلای تۆ وەک نامۆیەکم،","poem":1},{"text":"میوانم وەک هەموو باوباپیرانم.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ڕووی گرژت لە من وەرگێڕە، هەتا شادمان ببمەوە،","poem":1},{"text":"پێش ئەوەی بڕۆم و نەمێنم.»","poem":2}]}],"footnotes":[{"noteId":48,"caller":"+","text":"یەکێک بووە لە ڕابەرانی ستایش لە پەرستگا. بڕوانە یەکەم پوختەی مێژوو 16‏:41‏-42.‏‏","reference":{"chapter":39,"verse":0}},{"noteId":49,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتی 11، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":39,"verse":5}}]},"thisChapterLink":"/api/ckb_bib/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}