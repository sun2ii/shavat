{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، بە ئامێرە ژێدارەکان. زەبوورێکی داود."]},{"type":"verse","number":1,"content":[{"text":"ئەی خودای ڕاستودروستم،","poem":1},{"text":"کە لێت دەپاڕێمەوە وەڵامم بدەوە.","poem":2},{"text":"لە تەنگانەدا بە هانامەوە وەرە،","poem":1},{"text":"لەگەڵم میهرەبان بە و گوێ لە نوێژەکەم بگرە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ئەی خەڵکینە، هەتا کەی شکۆی من دەگۆڕن بە شورەیی؟","poem":1},{"text":"هەتا کەی حەز لە قسەی پووچ دەکەن و بەدوای درۆدا دەگەڕێن؟","poem":2},{"noteId":6}]},{"type":"verse","number":3,"content":[{"text":"بەڵام بزانن کە یەزدان دڵسۆزەکانی بۆ خۆی تەرخان کردووە.","poem":1},{"text":"یەزدان گوێم لێ دەگرێت کاتێک لێی دەپاڕێمەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"کاتێک تووڕە دەبن، گوناه مەکەن،","poem":1},{"text":"بەڵام کە لەسەر نوێنەکانتانن","poem":2},{"lineBreak":true},{"text":"لە دڵی خۆتاندا لێکی بدەنەوە و بێدەنگ بن.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"قوربانیی ڕاستودروست بکەن و","poem":1},{"text":"پشت بە یەزدان ببەستن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"زۆر کەس دەڵێن: «کێ چاکەمان نیشان دەدات؟»","poem":1},{"text":"ئەی یەزدان، با ڕووناکی ڕووی تۆ بەسەرماندا هەڵبێت","poem":2},{"noteId":7},{"text":".","poem":2}]},{"type":"verse","number":7,"content":[{"text":"تۆ خۆشییەکی وات خستووەتە دڵی منەوە","poem":1},{"text":"زۆر لەوانە زیاترە کە دانەوێڵە و شەرابیان زۆرە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ئەی یەزدان، بە ئاشتی پاڵ دەدەمەوە و دەخەوم،","poem":1},{"text":"چونکە تەنها تۆ بە ئاسوودەیی نیشتەجێم دەکەیت.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتی 4، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":4,"verse":2}},{"noteId":7,"caller":"+","text":"خودا بە چاکەکانی بەسەرمان بکاتەوە، بڕوانە سەرژمێری 6‏:24‏-26.‏‏","reference":{"chapter":4,"verse":6}}]},"thisChapterLink":"/api/ckb_bib/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}