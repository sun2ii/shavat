{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان زەبوورێکی داود."]},{"type":"verse","number":1,"content":[{"text":"بە پشوودرێژییەوە چاوەڕێی یەزدانم کرد،","poem":1},{"text":"ئاوڕی لێ دامەوە و گوێی لە هاوارم بوو.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"لەناو چاڵی لەناوچوون هەڵیکێشامە دەرەوە،","poem":1},{"text":"لەناو قوڕ و زەلکاو دەریهێنام.","poem":2},{"text":"پێیەکانمی لەسەر تاشەبەرد دانا و","poem":1},{"text":"هەنگاوەکانی منی توندوتۆڵ کرد.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"گۆرانییەکی نوێی خستە ناو دەمم،","poem":1},{"text":"سروودێکی ستایش بۆ خودامان.","poem":2},{"text":"زۆر کەس ئەمە دەبینن و دەترسن و","poem":1},{"text":"پشت بە یەزدان دەبەستن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"خۆزگە دەخوازرێ بەو کەسەی","poem":1},{"text":"پشت بە یەزدان دەبەستێت،","poem":2},{"text":"ڕوو لە لووتبەرزان ناکات،","poem":1},{"text":"لەوانەی ڕوویان وەرگێڕاوە بەرەو درۆ.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەی یەزدان، خودای من،","poem":1},{"text":"زۆرن ئەو کارە سەرسوڕهێنەرانەی کە کردووتە.","poem":2},{"text":"ئەو شتانەی بۆ ئێمە نەخشەت کێشاوە","poem":1},{"text":"کەس ناتوانێت بیانژمێرێت بۆت،","poem":2},{"text":"ئەگەر باسیان بکەم و بیانگێڕمەوە،","poem":1},{"text":"ئەوەندە زۆرن نایەنە ژماردن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"بە قوربانی و پێشکەشکراو ڕازی نەبوویت،","poem":1},{"text":"بەڵکو گوێی منت کردەوە،","poem":2},{"lineBreak":true},{"text":"داوای قوربانی سووتاندن و قوربانی گوناهت نەکرد.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئینجا گوتم: «ئەوەتا هاتم،","poem":1},{"text":"هەروەک لە تۆمارەکەدا لەسەرم نووسراوە.","poem":2},{"noteId":50}]},{"type":"verse","number":8,"content":[{"text":"ئەی خودای من، شادمانیم لەوەدایە کە خواستی تۆ بەجێبهێنم،","poem":1},{"text":"فێرکردنی تۆ لە ناخی دڵمدایە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"لەناو کۆمەڵی گەورە ڕاستودروستی ڕادەگەیەنم،","poem":1},{"text":"ئەی یەزدان، تۆ خۆت دەزانیت،","poem":2},{"lineBreak":true},{"text":"دەمی خۆم ناگرم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ڕاستودروستیت لەناو دڵم کپ ناکەمەوە،","poem":1},{"text":"باسی دڵسۆزیت و ڕزگاریت دەکەم.","poem":2},{"text":"خۆشەویستییە نەگۆڕەکەت و ڕاستییەکەت لەناو کۆمەڵی گەورە ناشارمەوە.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ئەی یەزدان، بەزەیی خۆتم لەسەر لامەبە،","poem":1},{"text":"با خۆشەویستییە نەگۆڕ و ڕاستییەکەت هەمیشە بمپارێزێت،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"چونکە بەڵای بێشومار دەوری داوم،","poem":1},{"text":"گوناهەکانم بە شێوەیەک گرفتاریان کردووم ناتوانم ببینم.","poem":2},{"text":"لە مووی سەرم زیاترن،","poem":1},{"text":"ورەم بەرداوە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"یەزدان، ڕازیبە بۆ دەربازکردنم،","poem":1},{"text":"یەزدان، خێرابە بۆ یارمەتیدانم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"با هەموو شەرمەزار و سووک بن،","poem":1},{"text":"ئەوانەی گیانی منیان دەوێت بۆ لەناوبردنی.","poem":2},{"text":"ببەزن و ڕیسوا بن","poem":1},{"text":"ئەوانەی خراپەی منیان دەوێت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"با لە شەرمەزارییان بپەشۆکێن،","poem":1},{"text":"ئەوانەی بە من دەڵێن: «هۆی ها! هۆی ها!»","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بەڵام با هەموو ئەوانەی ڕوو لە تۆ دەکەن","poem":1},{"text":"شاد و دڵخۆش بن.","poem":2},{"text":"با هەمیشە بڵێن: «مەزن بێت یەزدان!»","poem":1},{"text":"ئەوانەی حەز لە ڕزگاریی تۆ دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"بەڵام سەبارەت بە من، هەژار و نەدارم،","poem":1},{"text":"با پەروەردگار بایەخم پێبدات.","poem":2},{"text":"یارمەتی و دەربازکەرم تۆی،","poem":1},{"text":"ئەی خودای من، دوا مەکەوە.","poem":2}]}],"footnotes":[{"noteId":50,"caller":"+","text":"بڕوانە دواوتار 18‏:17‏-20‏","reference":{"chapter":40,"verse":7}}]},"thisChapterLink":"/api/ckb_bib/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}