{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، زەبوورێکی داود."]},{"type":"verse","number":1,"content":[{"text":"خۆزگە دەخوازرێ بەوەی ئاوڕ لە هەژار دەداتەوە،","poem":1},{"text":"یەزدان لە ڕۆژی تەنگانەدا ڕزگاری دەکات.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"یەزدان دەیپارێزێت و ژیانی دەبووژێنێتەوە،","poem":1},{"text":"لەسەر زەوی خۆشحاڵی دەکات و","poem":2},{"lineBreak":true},{"text":"نایداتە دەست حەزی دوژمنەکانی.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"یەزدان لە کاتی لاوازی پاڵپشتی دەکات و","poem":1},{"text":"لە کاتی نەخۆشی دەیبووژێنێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"گوتم: «ئەی یەزدان، لەگەڵم میهرەبان بە،","poem":1},{"text":"چارەسەرم بکە، چونکە گوناهم دەرهەق بە تۆ کردووە.»","poem":2}]},{"type":"verse","number":5,"content":[{"text":"دوژمنەکانم دەربارەی من قسەی خراپ دەکەن:","poem":1},{"text":"«کەی دەمرێت و ناوی دەسڕێتەوە؟»","poem":2}]},{"type":"verse","number":6,"content":[{"text":"کاتێک یەکێکیان بۆ دیدەنیم بێت،","poem":1},{"text":"بە درۆ قسە دەکات، بوختان لە دڵی کۆدەکاتەوە،","poem":2},{"lineBreak":true},{"text":"کە دەچێتە دەرەوەش بڵاوی دەکاتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"هەموو دوژمنەکانم چرپەچرپ دەکەن،","poem":1},{"text":"پیلان دژم دەگێڕن، دەڵێن:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"«دەردێکی کوشندە تەنگی پێ هەڵچنیوە،","poem":1},{"text":"لەکوێ بکەوێ هەستانەوەی نابێت.»","poem":2}]},{"type":"verse","number":9,"content":[{"text":"تەنانەت ئەو برادەرە نزیکەشم کە متمانەم پێی هەبوو،","poem":1},{"text":"ئەوەی نمەکی کردووم، ناپاکی لەگەڵم کرد.","poem":2},{"noteId":51}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"بەڵام تۆ ئەی یەزدان، لەگەڵم میهرەبان بە،","poem":1},{"text":"هەڵمستێنەوە بۆ ئەوەی تۆڵەیان لێ بکەمەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بەمە دەزانم تۆ لێم ڕازیت،","poem":1},{"text":"چونکە دوژمنەکەم هاواری سەرکەوتن ناکات بەسەرمدا.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بەهۆی ئەوەی من دروستم، تۆ پاڵپشتیم دەکەیت و","poem":1},{"text":"لەپێش خۆت ڕامدەگریت، هەتاهەتایە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ستایش بۆ یەزدانی پەروەردگاری ئیسرائیل،","poem":1},{"text":"لە ئەزەلەوە هەتا هەتاهەتایە.","poem":2},{"text":"ئامین و ئامین.","poem":4}]}],"footnotes":[{"noteId":51,"caller":"+","text":"ناپاکی لەگەڵم کرد: لە زمانی عیبری نووسراوە: (پاژنەپێی لێ بەرز کردمەوە)، کە دەربڕینێکی عیبرییە بە واتای ناپاکی.‏","reference":{"chapter":41,"verse":9}}]},"thisChapterLink":"/api/ckb_bib/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}