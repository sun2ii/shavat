ntent":[{"text":"ئەی گیانی من بۆچی خەمباریت؟","poem":1},{"text":"بۆ لە ناخمدا پەرێشانیت؟","poem":2},{"text":"ئومێدت بە خودا هەبێت،","poem":1},{"text":"چونکە هەر ستایشی ئەو دەکەم،","poem":2},{"lineBreak":true},{"text":"ئەو ڕزگارکەر و خودامە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"گیانم خەمبارە لە ناخم،","poem":1},{"text":"بۆیە یادت دەکەمەوە","poem":2},{"text":"لە لای ڕووباری ئوردون،","poem":1},{"text":"لە بەرزاییەکانی حەرمۆنەوە","poem":2},{"noteId":53},{"text":"، لە کێوی میچعارەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"قووڵایی بانگی قووڵایی دەکات،","poem":1},{"text":"بە دەم خوڕەی تاڤگەکانتەوە،","poem":2},{"lineBreak":true},{"text":"هەموو شەپۆلەکانت و تەوژمەکانت بەسەرمدا کەوتوون.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"بە ڕۆژ یەزدان خۆشەویستییە نەگۆڕەکەی ئاراستە دەکات،","poem":1},{"text":"بە شەویش سروودی ئەو لەسەر لێومە،","poem":2},{"lineBreak":true},{"text":"نوێژێکە بۆ خودای ژیانم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"خودا، کە تاشەبەردی منە، پێی دەڵێم:","poem":1},{"text":"«بۆچی لە یادت کردووم؟","poem":2},{"text":"بۆچی دەبێت بناڵێنم،","poem":1},{"text":"بچەوسێمەوە بە دەست دوژمنانم؟»","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بە تێکشکانی ئێسقانەکانم","poem":1},{"text":"ناحەزانم توانجم تێدەگرن،","poem":2},{"lineBreak":true},{"text":"بە درێژایی ڕۆژ پێم دەڵێن: «کوا خوداکەت؟»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ئەی گیانی من بۆچی خەمباریت؟","poem":1},{"text":"بۆ لە ناخمەوە پەرێشانیت؟","poem":2},{"text":"ئومێدت بە خودا هەبێت،","poem":1},{"text":"چونکە من هەر ستایشی ئەو دەکەم،","poem":2},{"lineBreak":true},{"text":"ئەو ڕزگارکەر و خودامە.","poem":2}]}],"footnotes":[{"noteId":52,"caller":"+","text":"لە ئەمادەگی خودا لە پەرستگا دەبم.‏","reference":{"chapter":42,"verse":2}},{"noteId":53,"caller":"+","text":"بەرزترین شاخە لە سوریا، نزیکە 75 کم لە باکووری دەریاچەی جەلی