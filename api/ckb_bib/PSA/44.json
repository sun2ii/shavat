{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، هۆنراوەیەکی کوڕانی قۆرەح."]},{"type":"verse","number":1,"content":[{"text":"خودایە، بە گوێی خۆمان بیستمان،","poem":1},{"text":"باوباپیرانمان پێیان ڕاگەیاندین،","poem":2},{"text":"تۆ لە ڕۆژگاری ئەوان،","poem":1},{"text":"لە ڕۆژگاری کۆن چیت کردووە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بە دەستی خۆت نەتەوەکانت ڕیشەکێش کرد و","poem":1},{"text":"باوباپیرانی ئێمەت چاند،","poem":2},{"text":"گەلانت وردوخاش کرد و","poem":1},{"text":"گەشەت بە باوباپیرانمان دا.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئەوان بە شمشێری خۆیان دەستیان بەسەر خاکەکەدا نەگرت،","poem":1},{"text":"بە بازووی خۆیان سەرکەوتنیان بەدەست نەهێنا،","poem":2},{"text":"بەڵکو دەستی ڕاستی تۆ بوو، بازووی تۆ بوو،","poem":1},{"text":"هەروەها ڕووناکی ڕوخساری تۆ بوو، چونکە ئەوانت خۆشویست.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"تۆ پاشا و خودای منی،","poem":1},{"text":"تۆی فەرمانی ڕزگاری دەدەیت بۆ یاقوب.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لە ڕێگەی تۆوە دوژمنەکانمان دەبەزێنین،","poem":1},{"text":"بە ناوی تۆوە ناحەزەکانمان پێشێل دەکەین.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"من پشت بە کەوانەکەم نابەستم،","poem":1},{"text":"شمشێرەکەم ڕزگارم ناکات.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بەڵام تۆ لە دوژمنەکانمان ڕزگارت کردین،","poem":1},{"text":"تۆ ناحەزەکانی ئێمەت ڕیسوا کرد.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بە درێژایی ڕۆژ شانازی بە خوداوە دەکەین،","poem":1},{"text":"هەتاهەتایە ستایشی ناوت دەکەین.","poem":2},{"noteId":54}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"بەڵام ئێستا وازت لێ هێناوین و ڕیسوات کردین،","poem":1},{"text":"لەگەڵ سوپاکانمان دەرناچیت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"وات لێکردین لەبەر دوژمنەکانمان ڕابکەین،","poem":1},{"text":"ناحەزەکانمان تاڵانیان کردین.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"وەک مەڕ بۆ سەربڕین بەدەستەوەت داین،","poem":1},{"text":"لەنێو نەتەوەکان پەرشوبڵاوت کردینەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"گەلی خۆتت هەرزان فرۆش کردووە،","poem":1},{"text":"قازانجت لە فرۆشتنەکەیان نەکردووە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"لەلای نەتەوەکانی دراوسێمان ئێمەت کردووە بە مایەی ڕیسوایی،","poem":1},{"text":"بە مایەی گاڵتەجاڕی و سووکایەتی پێکردن لەلای ئەوانەی دەوروبەرمان.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئێمەت کردووە بە پەندی نەتەوەکان،","poem":1},{"text":"خەڵکی سەریان بادەدەن لە ئاستمان.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ڕیسواییم بە درێژایی ڕۆژ لەپێشمە،","poem":1},{"text":"شەرمەزاریم ڕووی داپۆشیوم،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"لەبەر دەنگی توانج لێدەر و جنێو پێدەرم،","poem":1},{"text":"لە ڕووی دوژمن و تۆڵەسێنەر.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ئەمانەمان هەمووی بەسەرهاتووە،","poem":1},{"text":"لەگەڵ ئەوەشدا تۆمان لەبیر نەکردووە،","poem":2},{"lineBreak":true},{"text":"پەیمانی تۆمان نەشکاندووە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"دڵمان پاشگەز نەبووەتەوە،","poem":1},{"text":"پێیەکانمان ڕێگای تۆیان بەرنەداوە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بەڵام تۆ وردوخاشت کردین و ئێمەت کردە جێگای چەقەڵ،","poem":1},{"text":"بە سێبەری مەرگ داتپۆشین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ئەگەر ناوی خودای خۆمان لەبیر بکردایە،","poem":1},{"text":"یان دەستمان لەبەر خوداوەندێکی بیانی پان بکردایەوە،","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئایا لەلای خودا ئاشکرا نەدەبوو،","poem":1},{"text":"چونکە هەموو نهێنییەکانی دڵ دەزانێت؟","poem":2}]},{"type":"verse","number":22,"content":[{"text":"لەگەڵ ئەمەشدا لە پێناوی تۆ بە درێژایی ڕۆژ ڕووبەڕووی مردن دەبینەوە،","poem":1},{"text":"وەک مەڕ بۆ سەربڕین دادەنرێین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ئەی پەروەردگار، بەئاگا بە! بۆ خەواڵوو بوویت؟","poem":1},{"text":"هەستە! هەتاهەتایە وازمان لێمەهێنە!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"بۆچی ڕووی خۆتمان لێ دەشاریتەوە؟","poem":1},{"text":"بۆچی تەنگانە و چەوسانەوەمان لەبیردەکەیت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"گیانمان بەرەو خاک شۆڕ بووەتەوە،","poem":1},{"text":"سکمان بە زەوییەوە نووساوە.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ڕاپەڕە! بگە فریامان!","poem":1},{"text":"لەبەر خۆشەویستییە نەگۆڕەکەت بمانکڕەوە.","poem":2}]}],"footnotes":[{"noteId":54,"caller":"+","text":"لە دەقی عیبری لێرە وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":44,"verse":8}}]},"thisChapterLink":"/api/ckb_bib/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}