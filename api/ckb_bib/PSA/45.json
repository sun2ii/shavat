eak":true},{"text":"با دەستی ڕاستت شتی سامناک بخاتە پێش چاو.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"با تیرە تیژەکانت دڵی دوژمنانی پاشا کون بکەن،","poem":1},{"text":"با گەلان لەبەر پێت بکەون.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەی خودایە، تەختی تۆ بۆ هەتاهەتاییە،","poem":1},{"text":"داردەستی شانشینیت داردەستی دادپەروەرییە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"تۆ حەزت لە ڕاستودروستییە و ڕقت لە خراپەیە،","poem":1},{"text":"بۆیە خودا، خودای خۆت، لە سەرووی هاوەڵەکانتەوە داینای،","poem":2},{"lineBreak":true},{"text":"بە ڕۆنی شادی دەستنیشانی کردیت","poem":2},{"noteId":55},{"text":".","poem":2}]},{"type":"verse","number":8,"content":[{"text":"جلوبەرگت هەمووی بە بۆنی موڕ و ئەلوا","poem":1},{"noteId":56},{"text":"و کاسیا","poem":1},{"noteId":57},{"text":"بۆندار بووە،","poem":1},{"text":"لە کۆشکی بە عاج","poem":2},{"noteId":58},{"text":"ڕازاوەوە دەنگی مۆسیقا دڵخۆشت دەکات.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"لەناو ژنە خانەدانەکانت شازادە هەن،","poem":1},{"text":"شاژنیش بە بەرگی زێڕی ئۆفیرەوە","poem":2},{"noteId":59},{"text":"لەلای دەستی ڕاستتە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ئەی کچ، گوێ بگرە، لەبەرچاوتی بگرە و گوێ شل بکە،","poem":1},{"text":"گەلەکەت و بنەماڵەکەت لەبیر بکە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"پاشا تامەزرۆی جوانی تۆیە،","poem":1},{"text":"کڕنۆشی بۆ ببە، چونکە گەورەی تۆیە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"دانیشتووانی شاری سور","poem":1},{"noteId":60},{"text":"بە دیارییەوە دێن،","poem":1},{"text":"خاوەن سامانەکان ڕەزامەندی تۆیان دەوێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"کچی پاشا لە ماڵی خۆی بە تەواوی شکۆدارە،","poem":1},{"text":"جلوبەرگەکەی بە زێڕ چنراوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"بە کراسێکی نەخشێنراوەوە بۆ لای پاشا دەیبەن،","poem":1},{"text":"یاوەرە پاکیزەکانی بەدوایەوە بۆ لای تۆ","poem":2},{"noteId":61},{"text":"دێنن.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بە شادی و خۆشییەوە دەیانهێنن،","poem":1},{"text":"دێنە ناو کۆشکی پاشا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"کوڕەکانت جێی باوکانیان دەگرنەوە،","poem":1},{"text":"دەیانکەیتە میری سەرانسەری زەوی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"یادی ناوت دەکەمەوە نەوە دوای نەوە،","poem":1},{"text":"بۆیە نەتەوەکان هەتاهەتایە ستایشت دەکەن.","poem":2}]}],"footnotes":[{"noteId":55,"caller":"+","text":"دەستنیشانکردنی کەسێک بۆ ئەرکێکی ئایینی یان پاشایەتی ئەو کاتە بە چەورکردنی بووە بە ڕۆن.‏","reference":{"chapter":45,"verse":7}},{"noteId":56,"caller":"+","text":"ڕووەکێکی دڕکاوییە وەک سەباڕ، شلەیەکی تێدایە بۆ پێست باشە.‏","reference":{"chapter":45,"verse":8}},{"noteId":57,"caller":"+","text":"دارێکە بۆ بۆنخۆشی بەکاردێت.‏","reference":{"chapter":45,"verse":8}},{"noteId":58,"caller":"+","text":"عاج، دوو قۆچە گەورەکەی فیل، دەتاشرێن بۆ دروستکردنی پەیکەر و شتی دیکە بۆ ڕازاندنەوەی ناو ماڵ.‏","reference":{"chapter":45,"verse":8}},{"noteId":59,"caller":"+","text":"ڕەنگە وڵاتی یەمەن بێت، بە چاکی جۆری زێڕەکەی بەناوبانگ بووە.‏","reference":{"chapter":45,"verse":9}},{"noteId":60,"caller":"+","text":"مەبەست لە دانیشتووانی شاری سورە، کە شارێکی فینیقی زۆر بەناوبانگ و زۆر کۆنە.‏","reference":{"chapter":45,"verse":12}},{"noteId":61,"caller":"+","text":"تۆی پاشا.‏","reference":{"chapter":45,"verse":14}}]},"thisChapterLink":"/api/ckb_bib/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}