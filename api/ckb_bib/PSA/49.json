.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"کەس ناتوانێت ژیانی براکەی بکڕێتەوە،","poem":1},{"text":"یان کەفارەتی ئەو بداتە خودا.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"کڕینەوەی ژیان زۆر گران دەکەوێت،","poem":1},{"text":"هەرگیز ناتوانرێت نرخی تەواوی بدرێت،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"تاکو بۆ هەتاهەتایە بە زیندووێتی بمێنێتەوە و","poem":1},{"text":"گۆڕ نەبینێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بێگومان هەموو دەبینن کە تەنانەت کەسە داناکانیش دەمرن،","poem":1},{"text":"نەزانەکان و گێلەکان وەک یەک لەناودەچن و","poem":2},{"lineBreak":true},{"text":"سامانیان بۆ ئەوانی دیکە جێدەهێڵن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"گۆڕیان ماڵی هەتاهەتاییانە،","poem":1},{"text":"شوێنی نیشتەجێبوونیانە نەوە دوای نەوە،","poem":2},{"lineBreak":true},{"text":"لەگەڵ ئەوەشدا زەویشیان بە ناوی خۆیانەوە ناودەنا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"مرۆڤ هەرچەندە دەوڵەمەند بێت نامێنێت،","poem":1},{"text":"وەک ئەو ئاژەڵانە وایە کە لەناودەچن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ئەمە ڕێگای ئەوانەیە کە پشت بە خۆیان دەبەستن،","poem":1},{"text":"ئەوانەش کە دوایان دەکەون بە قسەکانیان پەسەندی دەکەن.","poem":2},{"noteId":74}]},{"type":"verse","number":14,"content":[{"text":"ئەوانە وەک مەڕن و چارەنووسیان مەرگە،","poem":1},{"text":"مەرگ دەبێتە شوانیان.","poem":2},{"text":"لە بەیانیدا سەرڕاستەکان فەرمانڕەوایەتییان دەکەن،","poem":1},{"text":"شێوەیان دادەڕزێت،","poem":2},{"lineBreak":true},{"text":"جیهانی مردووان دەبێتە ماڵیان.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بەڵام خودا گیانم لە چنگی جیهانی مردووان دەکڕێتەوە،","poem":1},{"text":"چونکە بۆ لای خۆی دەمبات.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ترست لێ نەنیشێت ئەگەر یەکێک دەوڵەمەند بوو،","poem":1},{"text":"شکۆمەندی ماڵەکەی زیاد بوو،","poem":2}]},{"type":"verse","number":17,"content":[{"text":"چونکە کە مرد هیچ لەگەڵ خۆی نابات،","poem":1},{"text":"شکۆیەکەی بەدوایەوە نابێت.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"لەگەڵ ئەوەی کاتێک زیندووە خۆی بە بەختەوەر دەزانێت،","poem":1},{"text":"ستایش دەکرێیت کاتێک سەرکەوتوو بیت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بەڵام ئەویش بۆ نەوەی باوباپیرانی دەڕوات،","poem":1},{"text":"ئەوانەی هەتاهەتایە چاویان بە ڕووناکی ناکەوێتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"مرۆڤ دەوڵەمەندیش بێت ئەگەر تێنەگات،","poem":1},{"text":"وەک ئەو ئاژەڵانە وایە کە لەناودەچن.","poem":2}]}],"footnotes":[{"noteId":74,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتی 15، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":49,"verse":13}}]},"thisChapterLink":"/api/ckb_bib/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}