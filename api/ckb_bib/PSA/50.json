{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"hebrew_subtitle","content":["زەبوورێکی ئاساف."]},{"type":"verse","number":1,"content":[{"text":"خودای توانادار، یەزدان، دەفەرموێت،","poem":1},{"text":"لە ڕۆژهەڵاتەوە هەتا ڕۆژئاوای زەوی بانگ دەکات.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"لە سییۆنەوە کە لە جوانیدا تەواوە،","poem":1},{"text":"خودا پڕشنگ دەدات.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"خودامان دێت و بێدەنگ نابێت،","poem":1},{"text":"ئاگر لەپێشیەوە هەڵدەلووشێت،","poem":2},{"lineBreak":true},{"text":"گەردەلوولێکی بەهێز لە دەوریەتی.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بانگی ئاسمان دەکات لە بەرزایی،","poem":1},{"text":"هەروەها زەوی، بۆ دادگایی گەلەکەی:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"«بۆم کۆبکەنەوە خۆشەویستانم","poem":1},{"noteId":75},{"text":"،","poem":1},{"text":"کە بە قوربانی پەیمانیان لەگەڵ بەستووم.»","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئاسمان ڕاستودروستییەکەی ڕادەگەیەنێت،","poem":1},{"text":"چونکە خودا خۆی دادوەرە.","poem":2},{"noteId":76}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ئەی گەلی من، گوێ بگرن هەتا قسە بکەم،","poem":1},{"text":"ئەی ئیسرائیل، هەتا شایەتیت لەسەر بدەم:","poem":2},{"lineBreak":true},{"text":"من خودام، خودای تۆم.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"سەرزەنشتت ناکەم لەسەر قوربانییەکانت،","poem":1},{"text":"قوربانی سووتاندنەکانت هەمیشە لەبەردەممە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"من پێویستیم بە گای ماڵەکەت نییە،","poem":1},{"text":"پێویستیم بە گیسکی ناو پشتیرەکەت","poem":2},{"noteId":77},{"text":"نییە،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"چونکە هەموو گیانلەبەرانی دارستان هی منن،","poem":1},{"text":"هەروەها مێگەلەکانی سەر هەزارەها گرد.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"هەموو باڵندەی چیاکان دەزانم،","poem":1},{"text":"هەموو زیندەوەرانی دەشتودەر هی منن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەگەر برسی بم، بە تۆ ناڵێم،","poem":1},{"text":"چونکە جیهان و هەرچی تێیدایە هی منە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئایا من گۆشتی گا دەخۆم،","poem":1},{"text":"یان خوێنی گیسک دەخۆمەوە؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«قوربانی سوپاسگوزاری بۆ خودا بکە،","poem":1},{"text":"نەزرەکانت بەرامبەر هەرەبەرز بهێنە دی،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"لە ڕۆژی تەنگانەدا نزام بۆ بکە،","poem":1},{"text":"دەربازت دەکەم و شکۆدارم دەکەیت.»","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بەڵام خودا بە بەدکار دەڵێ:","poem":1},{"lineBreak":true},{"text":"«تۆ کێیت باسی فەرزەکانم دەکەیت،","poem":1},{"text":"یان پەیمانی منت بەسەر زماندا دێت؟","poem":2}]},{"type":"verse","number":17,"content":[{"text":"تۆ کە ڕقت لە تەمبێکردنە و","poem":1},{"text":"فەرمایشتی منت پشتگوێ خستووە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"کاتێک دزێک ببینیت، بە کردارەکەی ڕازی دەبیت،","poem":1},{"text":"بەشت لەگەڵ داوێنپیسانە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"دەمت بە خراپە دەکەیتەوە،","poem":1},{"text":"زمانت فێڵبازی دادەهێنێت.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"دادەنیشیت و لە دژی براکەت قسە دەکەیت،","poem":1},{"text":"بوختان بۆ کوڕی دایکت هەڵدەبەستیت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئەمانەت کردووە و من بێدەنگ بووم،","poem":1},{"text":"وات زانی منیش وەک تۆم.","poem":2},{"text":"بەڵام من سەرزەنشتت دەکەم و","poem":1},{"text":"ڕووبەڕوو تاوانبارت دەکەم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"«ئەی ئەوانەی خوداتان لەبیر کردووە، ئەمە لەبەرچاو بگرن،","poem":1},{"text":"دەنا پارچەپارچەتان دەکەم، کەسیش نایەتە فریاتان.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ئەوەی قوربانی سوپاسگوزاری پێشکەش بکات، شکۆدارم دەکات،","poem":1},{"text":"ئەوەی ڕێگای خۆی ڕێک بکات، ڕزگاریی خودای نیشان دەدەم.»","poem":2}]}],"footnotes":[{"noteId":75,"caller":"+","text":"بۆ ئەوانەی کە پابەندن بە پەیمانی خۆشەویستی نەگۆڕی پەروەردگار.‏","reference":{"chapter":50,"verse":5}},{"noteId":76,"caller":"+","text":"لە دەقی عیبری لێرە وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":50,"verse":6}},{"noteId":77,"caller":"+","text":"پشتیر: گەوڕ، شوێنێکی تایبەت بووە بە پەروەردەکردنی ئاژەڵ.‏","reference":{"chapter":50,"verse":9}}]},"thisChapterLink":"/api/ckb_bib/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}