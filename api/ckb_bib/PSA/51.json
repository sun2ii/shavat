{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":51,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان. زەبوورێکی داودە. کاتێک ناتانی پێغەمبەر هاتە لای دوای ئەوەی داود لەگەڵ بەتشەبەع",{"noteId":78},"جووتبوو."]},{"type":"verse","number":1,"content":[{"text":"ئەی خودایە، بەگوێرەی خۆشەویستییە نەگۆڕەکەت لەگەڵم میهرەبان بە،","poem":1},{"text":"بەگوێرەی زۆری بەزەیی خۆت یاخیبوونم بسڕەوە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بە تەواوی لە تاوانم بمشۆرەوە و","poem":1},{"text":"لە گوناهم پاکم بکەرەوە،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"چونکە من یاخیبوونم دەزانم،","poem":1},{"text":"هەمیشە گوناهم لەبەردەممە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لە دژی تۆ، تەنها تۆ، گوناهم کرد،","poem":1},{"text":"لەبەرچاوی تۆ خراپەم کرد،","poem":2},{"text":"تاکو لە بڕیارەکانت ڕاست بیت،","poem":1},{"text":"دادپەروەر بیت لە حوکمەکانت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەوەتا من بە زگماکی تاوانبارم،","poem":1},{"text":"گوناهبارم لەو کاتەوە کە دایکم سکی بە من پڕ بووە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ئەوەتا لە ناوەڕۆکەوە بە ڕاستی دڵشاد دەبیت،","poem":1},{"text":"لە ویژدانەوە فێری داناییم دەکەیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"بە زوفا","poem":1},{"noteId":79},{"text":"پاکم بکەرەوە پاک دەبم،","poem":1},{"text":"بمشۆرەوە لە بەفر سپیتر دەبم.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"با گوێم لە شادی و خۆشی بێت،","poem":1},{"text":"با ئەو ئێسقانانەی وردوخاشت کردووە شاد بن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"چاو لە گوناهەکانم بپۆشە و","poem":1},{"text":"هەموو خراپەکانم بسڕەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ئەی خودایە، دڵێکی پاکم تێدا دروستبکە و","poem":1},{"text":"ڕۆحێکی چەسپاو لە ناخم نوێ بکەرەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لە بەرچاوی خۆت دەرم مەکە،","poem":1},{"text":"ڕۆحی پیرۆزی خۆتم لێ مەستێنەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"شادی ڕزگاریی خۆتم پێ بدەوە،","poem":1},{"text":"بە ڕۆحێکی خۆویستانە پشتگیریم بکە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ئینجا یاخیبووان فێری ڕێگای تۆ دەکەم،","poem":1},{"text":"گوناهباران دەگەڕێنەوە لات.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەی خودایە، خودای ڕزگاریم، لە سزای خوێنڕشتن دەربازم بکە،","poem":1},{"text":"هەتا زمانم گۆرانی بەسەر ڕاستودروستیتدا بڵێت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەی پەروەردگار، لێوەکانم لێک بکەرەوە و","poem":1},{"text":"دەمم ستایشت ڕابگەیەنێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"تۆ بە قوربانی دڵشاد نابیت، ئەگینا پێشکەشی دەکەم،","poem":1},{"text":"بە قوربانی سووتاندن ڕازی نابیت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"قوربانی بۆ خودا ڕۆحێکی شکاوە،","poem":1},{"text":"ئەی خودایە، تۆ بە سووکییەوە تەماشای دڵی شکاو و وردوخاشکراو ناکەیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"بە ڕەزامەندی خۆت چاکە لەگەڵ سییۆن بکە،","poem":1},{"text":"شووراکانی ئۆرشەلیم بنیاد بنێوە.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ئەوسا بە قوربانی ڕاستودروستی و","poem":1},{"text":"بە قوربانی سووتاندنی تەواو دڵشاد دەبیت،","poem":2},{"lineBreak":true},{"text":"ئەوسا گا لەسەر قوربانگاکەت پێشکەش دەکرێت.","poem":2}]}],"footnotes":[{"noteId":78,"caller":"+","text":"ژنی ئوریای حیتی بوو، داود لەگەڵی جووتبوو، بەم جۆرە داود داوێنپیسی لەگەڵی کرد. بۆ داپۆشینی گوناهەکەی، پلانێکی دانا بۆ بەکوشتدانی ئوریا. پاشان داود هێنای و کردییە ژنی خۆی. دایکی سلێمان بوو.‏","reference":{"chapter":51,"verse":0}},{"noteId":79,"caller":"+","text":"جۆرە ڕووەکێکە، جولەکەکان بە پێ ڕێوەرەسم بۆ پاککردنەوە بەکاریاندەهێنا.‏","reference":{"chapter":51,"verse":7}}]},"thisChapterLink":"/api/ckb_bib/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}