{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، هۆنراوەیەکی داودە. کاتێک دۆئێگی",{"noteId":80},"ئەدۆمی چوو بۆ لای شاول و پێی گوت کە داود چووە بۆ ماڵی ئەحیمەلەخ."]},{"type":"verse","number":1,"content":[{"text":"ئەی پاڵەوان، بۆچی شانازی بە خراپەوە دەکەیت؟","poem":1},{"text":"ئەی شەرمەزار لەبەرچاوی خودا،","poem":2},{"lineBreak":true},{"text":"بۆچی بە درێژایی ڕۆژ شانازی دەکەیت؟","poem":2}]},{"type":"verse","number":2,"content":[{"text":"زمانت پیلانی کاولکاری دادەڕێژێت،","poem":1},{"text":"وەک گوێزانێکی تیژ وایە،","poem":2},{"lineBreak":true},{"text":"خەریکی فێڵبازییە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"زیاتر حەزت لە خراپەیە نەک لە چاکە،","poem":1},{"text":"لە درۆ نەک لە ڕاستگۆیی.","poem":2},{"noteId":81}]},{"type":"verse","number":4,"content":[{"text":"حەزت لە هەموو وشەیەکی زیانبەخشە،","poem":1},{"text":"ئەی زمانی فێڵباز!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"بێگومان خودا هەتاهەتایە وێرانت دەکات،","poem":1},{"text":"دەتڕفێنێت و لە ماڵەکەت دەرتدەهێنێت،","poem":2},{"lineBreak":true},{"text":"ڕیشەکێشت دەکات لە خاکی زیندووان.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ڕاستودروستان ئەمە دەبینن و دەترسن،","poem":1},{"text":"پێی پێدەکەنن و دەڵێن:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"«ئا ئەوەتا ئەو کەسەی کە خودا ناکاتە پەناگای خۆی،","poem":1},{"text":"بەڵکو پشتی بە زۆریی سامانەکەی بەستبوو،","poem":2},{"lineBreak":true},{"text":"بە تێکشکاندنی کەسانی دیکە بەهێز بوو!»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"بەڵام من لە ماڵی خودا وەک دار زەیتوونێکی سەوزم،","poem":1},{"text":"هەتاهەتایە پشت بە خۆشەویستی نەگۆڕی خودا دەبەستم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"هەتاهەتایە لەبەردەم خۆشەویستانت ستایشت دەکەم بۆ کردەوەکانت،","poem":1},{"text":"ئومێدم بە ناوی تۆیە، چونکە چاکە.","poem":2}]}],"footnotes":[{"noteId":80,"caller":"+","text":"سەرۆک شوانەکانی شاول بوو، کاتێک داود لە ڕووی شاول هەڵات بۆ نوب بۆ لای ئەحیمەلەخ کە سەرۆک کاهین بوو، جا ئەحیمەلەخ نانی قوربانی دا بە داود و ئەوانەی لەگەڵی بوون. لەو کاتەدا دۆئێگ لە نوب بوو و هەواڵی برد بۆ شاول. ئینجا شاول ئەحیمەلەخ و کاهینەکانی گرت و فەرمانی دا بە پاسەوانەکان بیانکوژن، بەڵام ئەوان ڕەتیانکردەوە. جا فەرمانی دا بە دۆئێگ، ئەویش هەشتا و پێنج کاهینی کوشت.‏","reference":{"chapter":52,"verse":0}},{"noteId":81,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتی 5، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":52,"verse":3}}]},"thisChapterLink":"/api/ckb_bib/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}