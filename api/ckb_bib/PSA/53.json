":1},{"text":"ئەوانەی لە خودا ناپاڕێنەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لەوێ ترسێکی گەورەیان لێ نیشت،","poem":1},{"text":"کە هیچ ترسی لێ نەبوو.","poem":2},{"text":"خودا ئێسقانی ئەوانە پەرشوبڵاو دەکاتەوە کە گەمارۆیان داویت،","poem":1},{"text":"ڕیسوایان دەکەیت، چونکە خودا ڕەتی کردنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"با ڕزگاریی ئیسرائیل لە سییۆنەوە دەربکەوێت!","poem":1},{"text":"کاتێک خودا گەلەکەی خۆی لە ڕاپێچکراوی دەگەڕێنێتەوە،","poem":2},{"lineBreak":true},{"text":"با یاقوب شاد و ئیسرائیل دڵخۆش بێت!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}