:2}]},{"type":"verse","number":6,"content":[{"text":"گوتم: «خۆزگە وەک کۆتر باڵم دەبوو،","poem":1},{"text":"دوور دەفڕیم و دەحەسامەوە،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بە ڕاستی دووردەکەوتمەوە و","poem":1},{"text":"لە چۆڵەوانی دەمامەوە.","poem":2},{"noteId":85}]},{"type":"verse","number":8,"content":[{"text":"پەلەم دەکرد بۆ شوێنی پەناگای خۆم،","poem":1},{"text":"دوور لە ڕەشەبا و لە گەردەلوول.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەی پەروەردگار، سەریان لێ بشێوێنە، زمانیان تێک بئاڵێنە،","poem":1},{"text":"چونکە زۆرداری و دووبەرەکی لە شاردا دەبینم.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"شەو و ڕۆژ بەسەر شووراکانیدا دەسووڕێنەوە و","poem":1},{"text":"خراپە و ناڕەوایی لە ناوەڕاستیدایە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"وێرانکاری لە ناوەڕاستیدایە،","poem":1},{"text":"دەستدرێژی و ساختەکاری هەرگیز شەقامەکانی بەرنادەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ئەگەر دوژمن سووکایەتی پێم بکردایە،","poem":1},{"text":"بەرگەم دەگرت،","poem":2},{"text":"ئەگەر ناحەز بەسەرمدا زاڵ بووایە،","poem":1},{"text":"دەمتوانی خۆمی لێ بشارمەوە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بەڵام ئەوە تۆی! هاوشێوەی من مرۆڤی،","poem":1},{"text":"هاوڕێمی، نزیکترین برادەری منی،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"کە بەیەکەوە پەیوەندییەکی شیرینمان هەبوو،","poem":1},{"text":"بەیەکەوە لەگەڵ کۆمەڵانی خەڵکدا بەرەو ماڵی خودا دەچووین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"با مەرگ چەواشەیان بکات،","poem":1},{"text":"با بە زیندوویی دابەزنە ناو جیهانی مردووان،","poem":2},{"lineBreak":true},{"text":"چونکە خراپە شوێنی خۆی کردووەتەوە لەنێویان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"بەڵام هاواری من بۆ خودایە،","poem":1},{"text":"یەزدانیش ڕزگارم دەکات.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ئێواران و بەیانییان و نیوەڕۆیان","poem":1},{"text":"گلەیی دەکەم و دەناڵێنم،","poem":2},{"lineBreak":true},{"text":"ئەویش گوێم لێ دەگرێت.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"گیانمی بە تەواوی کڕییەوە","poem":1},{"text":"لەو جەنگەی دژم هەڵگیرساوە،","poem":2},{"lineBreak":true},{"text":"چونکە زۆرن بەرهەڵستکارانم.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"خودا، ئەوەی لە ئەزەلەوە لەسەر تەخت دانیشتووە،","poem":1},{"text":"گوێی لێ دەبێت و ڕیسوایان دەکات؛","poem":2},{"text":"ئەوانەی ناگۆڕێن و","poem":1},{"text":"ترسی خودایان لە دڵدا نییە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"هاوڕێکەم دەستدرێژی دەکاتە سەر دۆستەکانی،","poem":1},{"text":"پەیمانی خۆی دەشکێنێت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"زمانی وەک کەرە لووسە،","poem":1},{"text":"بەڵام دڵی پڕ لە شەڕە.","poem":2},{"text":"قسەی لە ڕۆن نەرمترە،","poem":1},{"text":"بەڵام شمشێری هەڵکێشراوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"خەمەکانت بە یەزدان بسپێرە،","poem":1},{"text":"ئەو پشتگیریت دەکات،","poem":2},{"lineBreak":true},{"text":"هەرگیز ناهێڵێت ڕاستودروستان بهەژێن.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"بەڵام تۆ ئەی خودایە، فڕێیان بدە ناو قووڵترین بیر،","poem":1},{"text":"خوێنڕێژ و فێڵبازەکان،","poem":2},{"lineBreak":true},{"text":"ڕۆژگاریان ناگاتە نیوە.","poem":2},{"lineBreak":true},{"text":"بەڵام من پشت بە تۆ دەبەستم.","poem":1}]}],"footnotes":[{"noteId":85,"caller":"+","text":"لە دەقی عیبری لێرە و لە ناوەڕاستی ئایەتی 19، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":55,"verse":7}}]},"thisChapterLink":"/api/ckb_bib/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}