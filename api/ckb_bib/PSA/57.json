{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، لەسەر ئاوازی «مەفەوتێنە.» پاڕانەوەیەکی داودە کاتێک لەبەردەم شاول هەڵات لە ئەشکەوتەکە."]},{"type":"verse","number":1,"content":[{"text":"لەگەڵم میهرەبان بە، ئەی خودایە، لەگەڵم میهرەبان بە،","poem":1},{"text":"چونکە گیانم پەنا دەهێنێتە بەر تۆ،","poem":2},{"text":"من پەنا دەهێنمە بەر سێبەری باڵەکانی تۆ،","poem":1},{"text":"هەتا ئەم بەڵایە بەسەردەچێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"بۆ خودای هەرەبەرز هاوار دەکەم،","poem":1},{"text":"بۆ ئەو خودایەی ئەستۆپاکیم دەسەلمێنێت.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لە ئاسمانەوە دەنێرێت و ڕزگارم دەکات،","poem":1},{"text":"ئەوانە ڕیسوا دەکات کە ڕاوم دەنێن.","poem":2},{"noteId":87},{"lineBreak":true},{"text":"خودا خۆشەویستییە نەگۆڕەکەی و دڵسۆزییەکەی دەنێرێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"گیانم لەناو شێرانە،","poem":1},{"text":"لەنێو ئاژەڵی دڕندە ڕادەکشێم،","poem":2},{"text":"ئەو مرۆڤانەی کە ددانەکانیان ڕم و تیرن،","poem":1},{"text":"زمانیشیان شمشێری تیژە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ئەی خودایە، بەسەر ئاسماندا بەرزببەوە،","poem":1},{"text":"با شکۆی تۆ بەسەر هەموو زەوییەوە بێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"تۆڕیان ناوەتەوە بۆ پێیەکانم،","poem":1},{"text":"گیانم پەرێشانە.","poem":2},{"text":"چاڵێکیان لەپێشم هەڵکەند،","poem":1},{"text":"بەڵام خۆیان تێی کەوتن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"دڵم چەسپاوە، ئەی خودایە،","poem":1},{"text":"دڵم چەسپاوە،","poem":2},{"lineBreak":true},{"text":"سروود دەڵێم و مۆسیقا دەژەنم.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەی گیانی من، هەستە!","poem":1},{"text":"ئەی ساز و قیسارە، هەستن!","poem":2},{"lineBreak":true},{"text":"من بەرەبەیانان هەڵدەستم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەی پەروەردگار، من لەنێو گەلان ستایشت دەکەم،","poem":1},{"text":"لەنێو نەتەوەکان گۆرانیت بۆ دەڵێم،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"چونکە خۆشەویستییە نەگۆڕەکەت مەزنە، دەگاتە ئاسمان،","poem":1},{"text":"دڵسۆزیشت دەگاتە هەورەکان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ئەی خودایە، بەسەر ئاسماندا بەرزببەوە،","poem":1},{"text":"با شکۆی تۆ بەسەر هەموو زەوییەوە بێت.","poem":2}]}],"footnotes":[{"noteId":87,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتی 6، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":57,"verse":3}}]},"thisChapterLink":"/api/ckb_bib/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}