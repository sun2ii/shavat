{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، لەسەر ئاوازی «مەفەوتێنە.» پاڕانەوەیەکی داودە، کاتێک شاول پیاوی نارد بۆ ئەوەی چاودێری ماڵی داود بکەن و بیکوژن."]},{"type":"verse","number":1,"content":[{"text":"ئەی خودای من، فریام بکەوە لە دەست دوژمنەکانم،","poem":1},{"text":"بمپارێزە لە بەرهەڵستکارانم.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"فریام بکەوە لە دەست خراپەکاران،","poem":1},{"text":"ڕزگارم بکە لە دەست خوێنڕێژان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ببینە چۆن خۆیان بۆم مات داوە!","poem":1},{"text":"ئەی یەزدان، زۆرداران گەمارۆیان داوم،","poem":2},{"lineBreak":true},{"text":"بەبێ ئەوەی تاوان و گوناهم کردبێ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"هەرچەندە هەڵەم نەکردووە، ئامادەن بۆ پەلاماردانم.","poem":1},{"text":"ڕاپەڕە بۆ فریاکەوتنم، بڕوانە گرفتەکەم!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"تۆ ئەی یەزدان، خودای سوپاسالار، خودای ئیسرائیل،","poem":1},{"text":"هەستە بۆ سزادانی هەموو نەتەوەکان،","poem":2},{"lineBreak":true},{"text":"لەگەڵ خیانەتکارە بەدکارەکان میهرەبان مەبە.","poem":2},{"noteId":88}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"دەمەو ئێواران دەگەڕێنەوە،","poem":1},{"text":"وەک سەگ دەمڕێنن و","poem":2},{"lineBreak":true},{"text":"بەناو شاردا دەسووڕێنەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئەوەتا تاڵاو لە دەمیانە و","poem":1},{"text":"شمشێر لە لێویانە،","poem":2},{"lineBreak":true},{"text":"دەڵێن: «کێ گوێی لێمان دەبێت؟»","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بەڵام تۆ ئەی یەزدان، پێیان پێدەکەنیت،","poem":1},{"text":"گاڵتە بە هەموو نەتەوەکان دەکەیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەی هێزی من، چاوەڕێی تۆ دەکەم،","poem":1},{"text":"ئەی خودایە، تۆ پەناگای منیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"خودا بە خۆشەویستییە نەگۆڕەکەی دێتە لام،","poem":1},{"text":"سەرکەوتنم نیشان دەدات بەسەر دوژمنەکانم.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەی پەروەردگار، قەڵغانی ئێمە، مەیانکوژە،","poem":1},{"text":"ئەگینا گەلی من لەبیریان دەچێت.","poem":2},{"text":"بە هێزی خۆت دەربەدەریان بکە و","poem":1},{"text":"بەریان بدەوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لەبەر گوناهەکانی دەمیان،","poem":1},{"text":"لەبەر وتەکانی لێویان،","poem":2},{"lineBreak":true},{"text":"با گرفتاری لووتبەرزی خۆیان بن.","poem":2},{"text":"لەبەر ئەو درۆ و نەفرەتانەی کردوویانە،","poem":1}]},{"type":"verse","number":13,"content":[{"text":"لە تووڕەییدا بیانفەوتێنە،","poem":2},{"lineBreak":true},{"text":"بیانفەوتێنە هەتا نەمێنن.","poem":2},{"text":"ئەوسا دەزانن کە خودا فەرمانڕەوایەتی یاقوب دەکات،","poem":1},{"text":"هەتا ئەوپەڕی زەوی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"دەمەو ئێواران دەگەڕێنەوە،","poem":1},{"text":"وەک سەگ دەمڕێنن و","poem":2},{"lineBreak":true},{"text":"بەناو شاردا دەسووڕێنەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بەدوای خواردندا وێڵ دەبن،","poem":1},{"text":"دەوەڕن ئەگەر تێر نەبن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بەڵام من سروود بەسەر هێزی تۆدا دەڵێم،","poem":1},{"text":"بەیانییان گۆرانی بەسەر خۆشەویستییە نەگۆڕەکەتدا دەڵێم،","poem":2},{"text":"چونکە تۆ قەڵای منیت،","poem":1},{"text":"لە ڕۆژی تەنگانەدا پەناگای منیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ئەی هێزی من، گۆرانی ستایشت بۆ دەڵێم،","poem":1},{"text":"ئەی خودایە، تۆ پەناگای منیت، خۆشەویستییە نەگۆڕەکەی خۆتم بۆ دەردەخەی.","poem":2}]}],"footnotes":[{"noteId":88,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتی 13، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":59,"verse":5}}]},"thisChapterLink":"/api/ckb_bib/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}