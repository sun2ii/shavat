noteId":92}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"بە دەستی ڕاستت دەربازمان بکە و یارمەتیمان بدە،","poem":1},{"text":"بۆ ئەوەی خۆشەویستانت ڕزگاریان بێت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"خودا لە پیرۆزگاکەی خۆیەوە فەرموویەتی:","poem":1},{"text":"«بە هاواری خۆشییەوە شەخەم دابەش دەکەم و","poem":2},{"lineBreak":true},{"text":"دۆڵی سوکۆت","poem":2},{"noteId":93},{"text":"دەپێوم.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"گلعاد هی منە، مەنەشەش هی منە،","poem":1},{"text":"ئەفرایم کڵاوی منە،","poem":2},{"lineBreak":true},{"text":"یەهودا","poem":2},{"noteId":94},{"text":"داری دەسەڵاتی منە،","poem":2}]},{"type":"verse","number":8,"content":[{"text":"مۆئاب","poem":1},{"noteId":95},{"text":"دەستشۆرمە،","poem":1},{"text":"پێڵاوەکەم فڕێدەدەمە سەر ئەدۆم،","poem":2},{"lineBreak":true},{"text":"لەسەر فەلەستیە هاواری سەرکەوتن دەکەم.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"کێیە دەمباتە شاری قەڵابەند؟","poem":1},{"text":"کێیە پێشڕەویم دەکات بۆ ئەدۆم؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەی خودایە، مەگەر تۆ نیت کە ئێمەت ڕەت کردووەتەوە و","poem":1},{"text":"ئیتر لەگەڵ لەشکرەکانمان دەرناچیت؟","poem":2}]},{"type":"verse","number":11,"content":[{"text":"یارمەتیمان بدە بەرامبەر بە دوژمنەکە،","poem":1},{"text":"چونکە ڕزگاری لە مرۆڤەوە پووچە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لەگەڵ خودا سەرکەوتن بەدەستدەهێنین،","poem":1},{"text":"هەروەها ئەوە دوژمنەکانمان دەخاتە ژێر پێ.","poem":2}]}],"footnotes":[{"noteId":89,"caller":"+","text":"یەکێک بوو لە پاشایەتییەکانی ئارامییەکان، دەکەوتە ڕۆژئاوای فوراتەوە.‏","reference":{"chapter":60,"verse":0}},{"noteId":90,"caller":"+","text":"سەرکردەی سوپاکەی داود بوو.‏","reference":{"chapter":60,"verse":0}},{"noteId":91,"caller":"+","text":"دەکەوێتە باشووری دەریای مردوو.‏","reference":{"chapter":60,"verse":0}},{"noteId":92,"caller":"+","text":"لە دەقی عیبری لێرە وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیە