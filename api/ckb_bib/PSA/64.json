"verse","number":6,"content":[{"text":"تەگبیر بۆ تاوان دەکەن،","poem":1},{"text":"دەڵێن: «پیلانێکی تەواومان داڕشت!»","poem":2},{"lineBreak":true},{"text":"بێگومان دڵ و دەروونی مرۆڤ قووڵە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"بەڵام خودا تیریان تێدەگرێت،","poem":1},{"text":"لەناکاو برینداریان دەکات.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"زمان درێژییان دەبێتە هۆی کەوتنیان،","poem":1},{"text":"هەرکەسێک کە دەیانبینێت سەری بادەدات.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"هەموو ئادەمیزاد دەترسن،","poem":1},{"text":"کاری خودا ڕادەگەیەنن و","poem":2},{"lineBreak":true},{"text":"بیردەکەنەوە لەوەی کە کردی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"با ڕاستودروستان بە یەزدان دڵخۆش بن و","poem":1},{"text":"پەنا ببەنە بەر ئەو،","poem":2},{"lineBreak":true},{"text":"با هەموو دڵڕاستان ستایشی بکەن!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}