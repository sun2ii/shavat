ڕزگارکەرمان،","poem":2},{"text":"ئەی ئەوەی دانیشتووانی سەراپای زەوی و","poem":1},{"text":"دەریا دوورەکان پشتت پێ دەبەستن،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"کە بە هێزی خۆت چیاکانت دامەزراندووە،","poem":1},{"text":"بە توانا خۆتت چەکدار کردووە،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"کە هەڵچوونی دەریاکان هێمن دەکەیتەوە،","poem":1},{"text":"هەڵچوونی شەپۆلەکانیان،","poem":2},{"lineBreak":true},{"text":"هەروەها ئاژاوەی گەلان.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەوانەی لەوپەڕی جیهان دەژین، لە کارە سەرسوڕهێنەرەکانت دەترسن.","poem":1},{"text":"لە شوێنی دەرکەوتنی بەرەبەیان و ئاوابوونی ئێواران،","poem":2},{"lineBreak":true},{"text":"گۆرانی شادمانییان پێ دەڵێیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"بایەخ بە زەوی دەدەیت و ئاوی دەدەیت،","poem":1},{"text":"زۆر بەپیت و فەڕی دەکەیت،","poem":2},{"text":"جۆگەکانی خودا پڕ ئاون،","poem":1},{"text":"دەغڵودانیان ئامادە دەکەیت،","poem":2},{"lineBreak":true},{"text":"چونکە بەم شێوەیە ڕێکت خستووە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"هێڵی جووتەکانی تێر ئاو دەکەیت و","poem":1},{"text":"تەخت و ڕێکیان دەکەیت،","poem":2},{"text":"بە لێزمەی باران پاراوی دەکەیت و","poem":1},{"text":"بەروبوومیان بەرەکەتدار دەکەیت.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بە چاکەی خۆت تاج دەخەیتە سەر ساڵ و","poem":1},{"text":"ڕێڕەوەکانت چەوری لێ دەچۆڕێت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لەوەڕگاکانی دەشتودەر پڕ دەبن،","poem":1},{"text":"ناوقەدی گردەکان بە شادی دەبەستییەوە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"مێرگەکان بە ڕانە مەڕ و مێگەل دادەپۆشرێن،","poem":1},{"text":"دەغڵودان دەبن بە کەوای دۆڵەکان،","poem":2},{"lineBreak":true},{"text":"لە شادمانیدا هاوار دەکەن و گۆرانی دەڵێن.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/66.json","nextChapterAudioLinks":{},"previ