{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، گۆرانییەک، زەبوورێک."]},{"type":"verse","number":1,"content":[{"text":"ئەی سەراپای زەوی، بە شادمانییەوە هاوار بۆ خودا بکەن!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"بە شکۆمەندی ناوی ئەو گۆرانی بڵێن،","poem":2},{"lineBreak":true},{"text":"ستایشی شکۆدار بکەن!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بە خودا بڵێن: «کردەوەکانت چەند سامناکن!","poem":1},{"text":"هێزت ئەوەندە گەورەیە،","poem":2},{"lineBreak":true},{"text":"دوژمنانت ملکەچیت بۆ دەنوێنن.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"سەراپای زەوی کڕنۆشت بۆ دەبەن،","poem":1},{"text":"گۆرانی ستایشت بۆ دەڵێن،","poem":2},{"lineBreak":true},{"text":"گۆرانی ستایش بۆ ناوی تۆ دەڵێن.»","poem":2},{"noteId":100}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"وەرن کردارەکانی خودا ببینن،","poem":1},{"text":"کارە سامناکەکەی لە پێناوی ئادەمیزاد!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"دەریای گۆڕی بۆ وشکانی،","poem":1},{"text":"ئەوان بە پێیان لە ڕووبار پەڕینەوە.","poem":2},{"lineBreak":true},{"text":"با بە ئەو شادمان بین.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بە توانای خۆی هەتاهەتایە فەرمانڕەوایەتی دەکات،","poem":1},{"text":"چاوەکانی چاودێری نەتەوەکان دەکەن،","poem":2},{"lineBreak":true},{"text":"با یاخییەکان خۆیان بەرامبەری هەڵنەکێشن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ئەی خەڵکینە، ستایشی خودامان بکەن،","poem":1},{"text":"با دەنگی ستایشکردنی ببیسترێت،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"کە گیانی ئێمەی بە زیندوویی پاراستووە و","poem":1},{"text":"نەیهێشتووە پێمان بخلیسکێت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەی خودایە، چونکە تۆ ئێمەت تاقی کردووەتەوە،","poem":1},{"text":"وەک زیو ئێمەت پاڵاوتووە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئێمەت خستووەتە داوەوە و","poem":1},{"text":"باری گرانت خستووەتە سەر شانمان.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"تۆ هێشتت خەڵکی سواری سەرمان بن،","poem":1},{"text":"بە ناو ئاو و ئاگردا ڕۆیشتین،","poem":2},{"lineBreak":true},{"text":"بەڵام دواتر بۆ شوێنێکی بەپیتت هێناین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"بە قوربانی سووتاندنەوە دێمە پەرستگاکەت،","poem":1},{"text":"نەزرەکانم بەجێدەهێنم،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەو نەزرانەی کە لە کاتی تەنگانەدا،","poem":1},{"text":"لێوەکانم بەڵێنی پێدابوون و بە دەممدا هاتبوون.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئاژەڵی قەڵەو دەکەمە قوربانی،","poem":1},{"text":"لەگەڵ بۆنی دووکەڵی قۆچی قوربانی،","poem":2},{"lineBreak":true},{"text":"تەگە","poem":2},{"noteId":101},{"text":"و گات بۆ دەکەمە قوربانی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ئەی هەموو لەخواترسەکان، وەرن و گوێ بگرن،","poem":1},{"text":"با پێتان بڵێم چی بۆ من کردووە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"بە دەمی خۆم هاوارم بۆی کرد،","poem":1},{"text":"ستایشکردنی لەسەر زمانم بوو.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئەگەر دڵم حەزی لە خراپە بووایە،","poem":1},{"text":"پەروەردگار گوێی لێ نەدەگرتم،","poem":2}]},{"type":"verse","number":19,"content":[{"text":"بەڵام بێگومان خودا گوێی لێ گرتم،","poem":1},{"text":"گوێی لە دەنگم بوو لە کاتی نوێژکردنم.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ستایش بۆ خودا،","poem":1},{"text":"کە نە نوێژەکەی منی لە خۆی دوورخستەوە و","poem":2},{"lineBreak":true},{"text":"نە خۆشەویستییە نەگۆڕەکەی خۆی لە من.","poem":2}]}],"footnotes":[{"noteId":100,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتەکانی 7 و 15، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":66,"verse":4}},{"noteId":101,"caller":"+","text":"نێری، سابرێن.‏","reference":{"chapter":66,"verse":15}}]},"thisChapterLink":"/api/ckb_bib/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}