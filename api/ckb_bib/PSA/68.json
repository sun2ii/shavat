{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":68,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، بۆ داود، زەبوورێک، گۆرانییەک."]},{"type":"verse","number":1,"content":[{"text":"با خودا هەستێت، با دوژمنانی پەرشوبڵاو ببنەوە!","poem":1},{"text":"با ناحەزانی لە ڕووی هەڵبێن!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"وەک بەباکردنی دووکەڵ بەبایان بکەیت،","poem":1},{"text":"وەک توانەوەی مۆم لەبەردەم ئاگر،","poem":2},{"lineBreak":true},{"text":"با بەدکارانیش لەبەردەم خودا لەناوبچن.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بەڵام با ڕاستودروستان لەبەردەم خودا شاد و دڵخۆش بن،","poem":1},{"text":"لە خۆشییان شاگەشکە بن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"گۆرانی بۆ خودا بڵێن، مۆسیقا بۆ ناوی بژەنن،","poem":1},{"text":"ئەوەی سواری گالیسکەیە بەسەر هەورەکان بەرزی بکەنەوە،","poem":2},{"text":"ناوی یەزدانە،","poem":1},{"text":"لەبەردەمی دڵشاد بن.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"باوکی هەتیوان و پارێزەری بێوەژنان،","poem":1},{"text":"خودایە لە چادری پەرستنی پیرۆزی خۆی.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"خودا ماڵ بۆ لانەوازان دابین دەکات،","poem":1},{"text":"بەندکراوەکان ئازاد دەکات،","poem":2},{"text":"بەڵام یاخییەکان لە خاکێکی سووتاو نیشتەجێ دەبن.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئەی خودایە، کاتێک تۆ پێشڕەویی گەلەکەتت کرد،","poem":1},{"text":"کاتێک بە چۆڵەوانیدا ڕۆیشتیت،","poem":2},{"noteId":103}]},{"type":"verse","number":8,"content":[{"text":"زەوی لەرزی و ئاسمان دڵۆپەی کرد","poem":1},{"text":"لەبەردەم خودا، خودای سینا،","poem":2},{"lineBreak":true},{"text":"لەبەردەم خودا، خودای ئیسرائیل.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەی خودایە، بارانێکی چاکت باراند،","poem":1},{"text":"میراتەکەت ماندوو بوو، تۆ بەهێزت کرد.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"کۆمەڵەکەت تێیدا نیشتەجێ دەبن،","poem":1},{"text":"خودایە، بە چاکەی خۆت، بۆ هەژارانت دابین کرد.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"پەروەردگار فەرمانی دا","poem":1},{"noteId":104},{"text":"و","poem":1},{"text":"کۆمەڵی ژنانی مزگێنیدەر زۆرن:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"«پاشایان و لەشکرەکانیان بە خێرایی هەڵدێن!","poem":1},{"text":"ژنەکان کە لە ماڵ ماونەتەوە تاڵان دابەش دەکەن،","poem":2}]},{"type":"verse","number":13,"content":[{"text":"تەنانەت ئەوانەشی کە لەناو تەویلەشن،","poem":1},{"text":"باڵی کۆترە لە زیو هەڵکێشراوەکەم و","poem":2},{"lineBreak":true},{"text":"پەڕەمووچەی زێڕی بێگەردیان بەردەکەوێ.»","poem":2}]},{"type":"verse","number":14,"content":[{"text":"کە خودای هەرە بەتوانا پاشاکانی پەرتەوازە کرد،","poem":1},{"text":"وەک بارینی بەفر بوو لەسەر کێوی چەلمۆن","poem":2},{"noteId":105},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"چیای باشان چیای خودایە،","poem":1},{"text":"چیای باشان چیای فرە لووتکەیە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئەی چیا فرە لووتکەکان، بۆچی چاو دەبڕنە ئەو چیایە","poem":1},{"text":"کە خودا ئارەزووی دەکات تێیدا نیشتەجێ بێت،","poem":2},{"lineBreak":true},{"text":"بەڵێ، ئەوەی یەزدان هەتاهەتایە تێیدا نیشتەجێیە؟","poem":2}]},{"type":"verse","number":17,"content":[{"text":"گالیسکەکانی خودا هەزاران هەزارانە،","poem":1},{"text":"پەروەردگار لە سیناوە هاتە پیرۆزگا.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ئەی یەزدان، کاتێک بەرزبوویتەوە بۆ بەرزایی،","poem":1},{"text":"دیلێکی زۆرت لەگەڵ خۆت برد،","poem":2},{"lineBreak":true},{"text":"دیاریت لە خەڵک وەرگرت،","poem":2},{"text":"تەنانەت لە یاخییەکانیش،","poem":1},{"text":"ئەی خودایە، بۆ ئەوەی تۆ لەوێ نیشتەجێ بیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ستایش بۆ پەروەردگار، بۆ خودای ڕزگاریمان،","poem":1},{"text":"ڕۆژ بە ڕۆژ بارمان هەڵدەگرێت.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"خودا بۆ ئێمە خودای ڕزگارییە،","poem":1},{"text":"لە مردن دەربازبوونیش لە یەزدانی پەروەردگارەوەیە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"بێگومان خودا سەری ناحەزانی پان دەکاتەوە،","poem":1},{"text":"تەوقی سەری ئەوانەی بە ڕێگای گوناهدا دەڕۆن.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"پەروەردگار دەفەرموێ: «لە باشانەوە دوژمنانت دەهێنمەوە،","poem":1},{"text":"لە قووڵایی دەریاکانەوە دەیانهێنمەوە،","poem":2}]},{"type":"verse","number":23,"content":[{"text":"بۆ ئەوەی پێت بە خوێنیان سوور بێت،","poem":1},{"text":"زمانی سەگەکانت بەشیان هەبێت لێیان.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ئەی خودایە، کەژاوەی تۆیان بینی،","poem":1},{"text":"کەژاوەی خودا و پاشای من بەرەو پیرۆزگا.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"گۆرانیبێژەکان لەپێشەوەن و ساز لێدەرەکان لە دواوە،","poem":1},{"text":"کچۆڵە دەف لێدەرەکان لە ناوەڕاستیان.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"لە کۆڕ و کۆمەڵی گەورەدا ستایشی خودا بکەن،","poem":1},{"text":"ئەی ڕەچەڵەکی ئیسرائیل، ستایشی یەزدان بکەن.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ئەوەتا هۆزی بنیامینی بچکۆڵە پێشەوایانە،","poem":1},{"text":"کۆمەڵێک سەرکردەی یەهودا،","poem":2},{"lineBreak":true},{"text":"سەرکردەکانی زەبولون و نەفتالی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"ئەی خودایە، تواناکەتمان بۆ دەربخە،","poem":1},{"text":"ئەی خودایە، پاڵپشتیت دەربخە، هەروەک بۆ ئێمەت کرد.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"لە پەرستگاکەتەوە، لە ئۆرشەلیم،","poem":1},{"text":"پاشاکان دیاریت پێشکەش دەکەن.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"سەرزەنشتی گیانداری ناو قامیشەڵان بکە،","poem":1},{"text":"ڕەوە گا و گوێرەکەی گەلان،","poem":2},{"noteId":106},{"text":"تاکو بە ملکەچییەوە پارچە زیو پێشکەش بکات.","poem":1},{"text":"ئەو گەلانەی حەزیان لە شەڕە، پەرتیان بکە.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"باڵوێز لە میسرەوە دێن،","poem":1},{"text":"کوش","poem":2},{"noteId":107},{"text":"دەستی خۆی بۆ خودا درێژ دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ئەی شانشینەکانی زەوی، گۆرانی بۆ خودا بڵێن،","poem":1},{"text":"مۆسیقا بۆ پەروەردگار بژەنن،","poem":2}]},{"type":"verse","number":33,"content":[{"text":"بۆ سواری ئاسمان، ئاسمانی دێرین،","poem":1},{"text":"ئەوەتا دەنگی بەرز دەکاتەوە، بە دەنگێکی بەهێزەوە.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"با هێزی خودا ڕابگەیەنرێت،","poem":1},{"text":"ئەوەی شکۆمەندییەکەی بەسەر ئیسرائیلەوەیە،","poem":2},{"lineBreak":true},{"text":"ئەوەی هێزی لەناو هەورەکانە.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"خودایە، لە پیرۆزگاکەت سامدارتریت،","poem":1},{"text":"خودای ئیسرائیل هێز و توانا دەدات بە گەلەکەی.","poem":2},{"lineBreak":true},{"text":"ستایش بۆ خودا!","poem":1}]}],"footnotes":[{"noteId":103,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتەکانی 19 و 32، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":68,"verse":7}},