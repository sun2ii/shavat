{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، بە ئاوازی گوڵی سەوسەن، بۆ داود."]},{"type":"verse","number":1,"content":[{"text":"ئەی خودایە، ڕزگارم بکە،","poem":1},{"text":"چونکە ئاو هەتا لووتم هاتووە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"لە زەلکاوێکی قووڵ نوقوم دەبم،","poem":1},{"text":"جێی پێی تێدا نییە.","poem":2},{"text":"چوومەتە ناو قووڵایی ئاو،","poem":1},{"text":"لافاو ڕایماڵیوم.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ماندوو بووم لە هاوارکردن،","poem":1},{"text":"گەرووم ژان دەکات،","poem":2},{"text":"چاوەکانم کز بوون","poem":1},{"text":"هێندە چاوەڕوانی خودام بکەن.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەوانەی بەبێ هۆ ڕقیان لێمە","poem":1},{"text":"لە مووی سەرم زۆرترن،","poem":2},{"text":"زیاد بوون ئەوانەی دەیانەوێت تێکم بشکێنن،","poem":1},{"text":"ئەوانەی بە ناڕەوا لە دژی منن.","poem":2},{"text":"ئەوەی نەمدزیوە","poem":1},{"text":"ئێستا دەبێت بیدەمەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ئەی خودایە، تۆ دەبەنگی من دەزانیت،","poem":1},{"text":"تاوانەکانم لە تۆ شاراوە نین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ئەی یەزدان، پەروەردگاری سوپاسالار،","poem":1},{"text":"با ئەوانەی هیوایان بە تۆیە،","poem":2},{"lineBreak":true},{"text":"بەهۆی منەوە ڕیسوا نەبن.","poem":2},{"text":"ئەی خودای ئیسرائیل،","poem":1},{"text":"با ئەوانەی ڕوو لە تۆ دەکەن،","poem":2},{"lineBreak":true},{"text":"بەهۆی منەوە شەرمەزار نەبن.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لە پێناوی تۆ بەرگەی ڕیسواییم گرت،","poem":1},{"text":"شەرمەزاری ڕووی داگرتم.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"لەلای براکانم بووم بە بیانی،","poem":1},{"text":"لەلای کوڕانی دایکم بووم بە بێگانە.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"دڵگەرمی بۆ ماڵەکەت دەمسووتێنێت،","poem":1},{"text":"جنێوی ئەوانەی جنێوت پێدەدەن کەوتە سەر من.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"کاتێک گریام و بە ڕۆژووگرتن گیانم نزم کردەوە،","poem":1},{"text":"بوو بە سووکایەتی بۆم.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"جلوبەرگی گوشم پۆشی،","poem":1},{"text":"بووم بە پەند لەلایان،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بووم بە جێی سەرنجی ئەوانەی لەبەر دەروازە دادەنیشن","poem":1},{"noteId":108},{"text":"،","poem":1},{"text":"مەستەکانیش دەربارەی من گۆرانی گاڵتەئامێز هەڵدەبەستن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ئەی یەزدان، من نوێژم بۆ تۆیە،","poem":1},{"text":"لە کاتی ڕەزامەندیت،","poem":2},{"text":"ئەی خودایە، بە گەورەیی خۆشەویستییە نەگۆڕەکەت،","poem":1},{"text":"بە ڕزگارییە دڵسۆزانەکەت وەڵامم بدەرەوە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"دەربازم بکە لە زەلکاو، با نوقوم نەبم،","poem":1},{"text":"لە دوژمنەکانم و لە قووڵایی ئاو دەرباز دەبم.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"با لافاو ڕام نەماڵێت،","poem":1},{"text":"قووڵایی ئاو هەڵمنەلووشێت،","poem":2},{"lineBreak":true},{"text":"زەوی قووتم نەدات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ئەی یەزدان، بەدەنگمەوە وەرە، چونکە خۆشەویستییە نەگۆڕەکەت چاکە،","poem":1},{"text":"بەگوێرەی زۆری بەزەییەکەت ئاوڕم لێ بدەوە،","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ڕووت لە خزمەتکاری خۆت مەپۆشە،","poem":1},{"text":"چونکە لە تەنگانەدام، زوو وەڵامم بدەوە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"لێم نزیک بەرەوە و گیانم دەرباز بکە،","poem":1},{"text":"لەبەر دوژمنانم بمکڕەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"تۆ بە سووکایەتی و شەرمەزاری و ڕیسوایی من دەزانیت،","poem":1},{"text":"هەموو دوژمنەکانم لەبەردەمتن.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ڕیسوایی دڵی شکاندووم،","poem":1},{"text":"نەخۆش کەوتووم،","poem":2},{"text":"چاوەڕێی سۆز بووم، نەبوو،","poem":1},{"text":"چاوم لە دڵنەوایی گێڕا، دەستم نەکەوت.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ژەهری تاڵیان دەرخواردم دا،","poem":1},{"text":"لە تینوویەتیم سرکەیان دەرخوارد دام.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"با خوانەکەی بەردەمیان ببێتە داویان،","poem":1},{"text":"ببێتە سزا و تەڵەیان.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"با بەرچاویان تاریک بێت تاکو نەبینن،","poem":1},{"text":"هەمیشە پشتیان چەماوە بێت.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"هەڵچوونی خۆتیان پێدا هەڵبڕێژە،","poem":1},{"text":"با ئاگری تووڕەییت بیانگاتێ.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"با خێوەتگاکانیان چۆڵ بێت،","poem":1},{"text":"کەس نەبێت لە ڕەشماڵیان نیشتەجێ بێت!","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ئەوەی تۆ لێت داوە، ئەوان دەیچەوسێننەوە و","poem":1},{"text":"ئەوەی تۆ بریندارت کردووە، باسی ئازارەکانی دەکەن.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"تاوان بخەرە سەر تاوانەکانیان،","poem":1},{"text":"بێبەشیان بکە لە ڕاستودروستیت.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"لە پەڕتووکی ژیاندا بیانسڕەوە،","poem":1},{"text":"لەگەڵ ڕاستودروستان ناویان مەنووسە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ئەی خودایە، من لە ئازار و تەنگانەدام،","poem":1},{"text":"با ڕزگاریت بمپارێزێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"بە گۆرانی ستایشی ناوی خودا دەکەم،","poem":1},{"text":"بە سوپاسگوزارییەوە گەورەیی ڕادەگەیەنم.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ئەمە لەلای یەزدان لە گا چاکترە،","poem":1},{"text":"لە گوێرەکەی بە قۆچ و سم.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"هەژاران دەبینن و شاد دەبن،","poem":1},{"text":"ئەی ئەوانەی ڕوو لە خودا دەکەن، با دڵتان ببووژێتەوە!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"یەزدان بە دەنگ ستەملێکراوانەوە دەچێت،","poem":1},{"text":"بە سووکییەوە تەماشای دیلەکانی ناکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"با ئاسمان و زەوی ستایشی بکەن،","poem":1},{"text":"دەریاکانیش و هەرچی تێیاندا دەجوڵێت،","poem":2}]},{"type":"verse","number":35,"content":[{"text":"چونکە خودا سییۆن ڕزگار دەکات و","poem":1},{"text":"شارەکانی یەهودا بنیاد دەنێتەوە،","poem":2},{"text":"لەوێ نیشتەجێ دەبن و دەبێتە موڵکیان،","poem":1}]},{"type":"verse","number":36,"content":[{"text":"دەبێتە میرات بۆ منداڵی خزمەتکارەکانی،","poem":2},{"lineBreak":true},{"text":"ئەوانەی ناوی ئەویان خۆشدەوێت تێیدا دەژین.","poem":2}]}],"footnotes":[{"noteId":108,"caller":"+","text":"پیران و ماقوڵانی شار لەبەردەم دەروازەی شارەکە کۆبوونەتەوە.‏","reference":{"chapter":69,"verse":12}}]},"thisChapterLink":"/api/ckb_bib/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}