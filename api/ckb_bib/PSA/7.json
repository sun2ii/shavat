{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["لاواندنەوەی داود سەبارەت بە وتەکانی کوشی بنیامینی کە بە گۆرانی بۆ یەزدانی گوتووە."]},{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، خودای من، پەنا دەهێنمە بەر تۆ،","poem":1},{"text":"لەوانەی ڕاوم دەنێن ڕزگارم بکە و دەربازم بکە،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەگینا وەک شێر پەلامارم دەدەن،","poem":1},{"text":"پارچەپارچەم دەکەن و کەسیش نییە دەربازم بکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ئەی یەزدان، خودای من، ئەگەر من وام کردووە،","poem":1},{"text":"ئەگەر دەستەکانم ناڕەوایەتییان کردووە،","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەگەر خراپەم کردووە دەرهەق بەوەی بە ئاشتی لەگەڵمدا دەژیێت،","poem":1},{"text":"یان بەبێ هۆ دوژمنەکەمم تاڵان کردووە،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"با دوژمن ڕاوم بنێت و پێشم لێ بگرێت،","poem":1},{"text":"با ژیانم پێشێل بکات لەسەر زەوی و","poem":2},{"lineBreak":true},{"text":"شکۆمەندیم بکەوێتە سەر خاک.","poem":2},{"noteId":10}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ئەی یەزدان، لە تووڕەیی خۆت ڕاپەڕە،","poem":1},{"text":"لە دژی قینی دوژمنەکانم ڕاستبەرەوە.","poem":2},{"lineBreak":true},{"text":"ئەی خودای من هەستە، فەرمان بکە بۆ دادپەروەری.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"کۆڕی گەلان لە دەوری خۆت ببەستە و","poem":1},{"text":"لە بەرزاییەوە فەرمانڕەوایەتییان لەسەر بکە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"با یەزدان دادوەری گەلان بکات.","poem":1},{"text":"ئەی یەزدان، بەگوێرەی ڕاستودروستییەکەم بێتاوانیم دەربخە،","poem":2},{"lineBreak":true},{"text":"بەگوێرەی دروستییەکەم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەی خودای ڕاستودروست،","poem":1},{"text":"کە مێشک و دڵەکان دەپشکنی،","poem":2},{"text":"خراپەی بەدکاران مەهێڵە،","poem":1},{"text":"بەڵام ڕاستودروستان بچەسپێنە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"خودای هەرەبەرز قەڵغانی منە،","poem":1},{"text":"ئەوەی دڵڕاستەکان ڕزگار دەکات،","poem":2}]},{"type":"verse","number":11,"content":[{"text":"خودا دادوەرێکی ڕاستودروستە،","poem":1},{"text":"هەموو ڕۆژێکیش تووڕە دەبێت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەگەر کەسێک نەگەڕێتەوە،","poem":1},{"text":"خودا شمشێرەکەی خۆی تیژ دەکات،","poem":2},{"lineBreak":true},{"text":"کەوانەکەی دەچەمێنێتەوە و ژێیەکەی توند دەکات.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"چەکی کوشندەی خۆی ئامادە کردووە،","poem":1},{"text":"تیرەکانی کردووەتە تیری ئاگرین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ببینە کەسی بەدکار بە خراپەوە ژانی گرتووە،","poem":1},{"text":"بە ئاژاوە سکی پڕ بووە و درۆی دەبێت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"چاڵێک هەڵدەکەنێت و قووڵی دەکات،","poem":1},{"text":"بەڵام خۆی دەکەوێتە ئەو چاڵەی هەڵیکەندووە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ئاژاوەکەی دەگەڕێتەوە سەر خۆی و","poem":1},{"text":"توندوتیژییەکەشی بەسەر سەری خۆیدا دەبارێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ستایشی یەزدان دەکەم بۆ ڕاستودروستییەکەی،","poem":1},{"text":"گۆرانی ستایش دەڵێم بۆ ناوی یەزدانی هەرەبەرز.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"لە دەقی عیبری وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":7,"verse":5}}]},"thisChapterLink":"/api/ckb_bib/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}