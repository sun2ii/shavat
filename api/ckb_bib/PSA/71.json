m":1},{"text":"تۆ بووی لە هەناوی دایکمەوە دەرتهێنام،","poem":2},{"lineBreak":true},{"text":"ستایشم هەمیشە بۆ تۆیە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"بووم بە پەند لەلای زۆر کەس،","poem":1},{"text":"بەڵام تۆ پەناگای بەهێزی منیت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"دەمم پڕە لە ستایشی تۆ،","poem":1},{"text":"لە شکۆدارکردنت بە درێژایی ڕۆژ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"لە کاتی پیری فڕێممەدە،","poem":1},{"text":"کە هێزم لەبەر نەما وازم لێ مەهێنە،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"چونکە دوژمنەکانم قسەم لەسەر دەکەن،","poem":1},{"text":"ئەوانەی چاوەڕێی کوشتنم دەکەن، پێکەوە تەگبیر دەکەن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"دەڵێن: «خودا وازی لێ هێناوە،","poem":1},{"text":"ڕاوی بنێن و بیگرن،","poem":2},{"lineBreak":true},{"text":"چونکە دەربازکەری نییە.»","poem":2}]},{"type":"verse","number":12,"content":[{"text":"خودایە، لێم دوور مەکەوە،","poem":1},{"text":"ئەی خودای من، زوو بگە فریام.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"با شەرمەزار بن و لەناوبچن، ئەوانەی سکاڵام لێ دەکەن،","poem":1},{"text":"با بە ڕیسوایی و سووکایەتی بپۆشرێن،","poem":2},{"lineBreak":true},{"text":"ئەوانەی خراپەی منیان دەوێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"بەڵام من هەمیشە هیوادارم،","poem":1},{"text":"هەتا دێت زیاتر ستایشت دەکەم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"دەمم باسی ڕاستودروستیت دەکات،","poem":1},{"text":"بە درێژایی ڕۆژ باسی ڕزگاریت دەکات،","poem":2},{"lineBreak":true},{"text":"هەرچەندە پێوانەکەی نازانم.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"دان بە پاڵەوانیێتی یەزدانی باڵادەستم دەنێم،","poem":1},{"text":"تەنها ڕاستودروستی تۆ دەهێنمەوە یاد.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"خودایە، لە سەردەمی گەنجییەوە فێرت کردووم،","poem":1},{"text":"هەتا ئێستا کارە سەرسوڕهێنەرەکانت ڕادەگەیەنم.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"خودایە، تەنانەت لە پیری و ڕیش سپیێتیشم،","poem":1},{"text":"وازم لێ مەهێنە،","poem":2},{"text":"هەتا توانات بۆ نەوەی داهاتوو ڕابگەیەنم،","poem":1},{"text":"هێزت بۆ هەموو ئەوانەی دێن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"خودایە، ڕاستودروستیت هەتا بەرزاییە،","poem":1},{"text":"کردارەکانت زۆر مەزنن.","poem":2},{"lineBreak":true},{"text":"ئەی خودایە، کێ وەک تۆیە؟","poem":2}]},{"type":"verse","number":20,"content":[{"text":"تۆ تەنگانەی زۆر و تاڵت پیشاندام،","poem":1},{"text":"بەڵام دەگەڕێیتەوە و زیندووم دەکەیتەوە،","poem":2},{"lineBreak":true},{"text":"لە ناخی زەوییەوە دووبارە بەرزم دەکەیتەوە.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"مەزنێتیم زیاتر دەکەیت،","poem":1},{"text":"دەگەڕێیتەوە و دڵنەواییم دەکەیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ئەی خودای من،","poem":1},{"text":"لە پێناوی دڵسۆزیت بە ساز ستایشت دەکەم،","poem":2},{"text":"ئەی پیرۆزەکەی ئیسرائیل،","poem":1},{"text":"بە قیسارەوە مۆسیقات بۆ دەژەنم.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"لێوەکانم هەلهەلە لێدەدەن،","poem":1},{"text":"کە گۆرانیت بۆ دەڵێم،","poem":2},{"lineBreak":true},{"text":"هەروەها گیانم، ئەوەی کە کڕیتەوە.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"زمانیشم بە درێژایی ڕۆژ باسی ڕاستودروستیت دەکات،","poem":1},{"text":"چونکە شەرمەزار و سووک بوون،","poem":2},{"lineBreak":true},{"text":"ئەوانەی خراپەی منیان دەوێت.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}