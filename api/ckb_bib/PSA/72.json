دات،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ڕاستودروستان لە سەردەمی ئەو شکۆفە دەکەن،","poem":1},{"text":"ئاشتییەکی زۆر دەبێت هەتا فەوتانی مانگ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"لە دەریاوە هەتا دەریا حوکم دەکات،","poem":1},{"text":"لە ڕووباری فوراتەوە هەتا ئەوپەڕی زەوی.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بیاباننشینەکان کڕنۆشی بۆ دەبەن و","poem":1},{"text":"ناحەزانی تۆز دەلێسنەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"پاشاکانی تەرشیش","poem":1},{"noteId":109},{"text":"و دوورگە دوورەکان سەرانە دەنێرن،","poem":1},{"text":"پاشاکانی شەبا و سەبا","poem":2},{"noteId":110},{"text":"دیاری بۆ دێنن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"هەموو پاشاکان کڕنۆشی بۆ دەبەن و","poem":1},{"text":"هەموو نەتەوەکان خزمەتی دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"لەبەر ئەوەی نەدار کە هاواری بۆ دەبات، دەربازی دەکات،","poem":1},{"text":"چەوسێنراویش کە یارمەتیدەری نییە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بەزەیی بە لاواز و نەداردا دێتەوە،","poem":1},{"text":"گیانی نەدارەکان ڕزگار دەکات،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"گیانیان لە ستەم و توندوتیژی دەکڕێتەوە،","poem":1},{"text":"خوێنی ئەوان لەلای بەنرخە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"تەمەن درێژ بێت!","poem":1},{"text":"با لە زێڕی شەبای پێبدرێت،","poem":2},{"text":"با هەمیشە خەڵک نزای بۆ بکەن،","poem":1},{"text":"با بە درێژایی ڕۆژ داوای بەرەکەتی بۆ بکەن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"با دانەوێڵەیەکی زۆر لەسەر زەوی بێت،","poem":1},{"text":"لەسەر لووتکەی گردەکان،","poem":2},{"text":"بەرهەمی وەک لوبنان بشەکێتەوە،","poem":1},{"text":"با ئەوانەی لە شارەکانن وەک گیای کێڵگە چرۆ بکەن.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"با هەتاهەتایە ناوی بمێنێت،","poem":1},{"text":"هەتا خۆر مابێت ناوی بەردەوام بێت.","poem":2},{"lineBreak":true},{"text":"هەموو نەتەوەکان لەوەوە بەرەکەتدار بن،","poem":1},{"text":"هەمووان خۆزگەی پێ بخوازن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"ستایش بۆ یەزدانی پەروەردگار، خودای ئیسرائیل،","poem":1},{"text":"بە تەنها ئەوە کاری سەرسوڕهێنەر دەکات.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"هەتاهەتایە ستایش بۆ ناوی شکۆداری،","poem":1},{"text":"با شکۆمەندییەکەی هەموو جیهان پڕ بکات.","poem":2},{"text":"ئامین و ئامین.","poem":4}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"لێرەدا نوێژەکانی داودی کوڕی یەسا تەواو بوون.","poem":1}]}],"footnotes":[{"noteId":109,"caller":"+","text":"تەرشیش: دوایین سنووری ڕۆژئاوای جیهان بووە کە ئەو سەردەمە مرۆڤ پێی زانیبێت.‏","reference":{"chapter":72,"verse":10}},{"noteId":110,"caller":"+","text":"ناوی هۆز و شوێنە، دەکەونە یەمەن و هەندێکیان کۆچیان کردووە بۆ ئەسیوپیا. خەڵکەکەی بە بازرگانی بەناوبانگ بوون.‏","reference":{"chapter":72,"verse":10}}]},"thisChapterLink":"/api/ckb_bib/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}