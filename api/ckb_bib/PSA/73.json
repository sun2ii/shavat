{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":73,"content":[{"type":"hebrew_subtitle","content":["زەبوورێکی ئاساف."]},{"type":"verse","number":1,"content":[{"text":"بێگومان خودا چاکە بۆ ئیسرائیل،","poem":1},{"text":"بۆ دڵپاکەکان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"بەڵام من خەریک بوو پێم بخزێت و","poem":1},{"text":"زۆری نەمابوو هەنگاوم بخلیسکێت،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"چونکە بەغیلیم بە لووتبەرزەکان برد،","poem":1},{"text":"کە ئاسوودەیی بەدکارانم دی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ترسیان لە مردن نییە،","poem":1},{"text":"جەستەیان تەندروست و قەڵەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لە ڕەنجکێشانی مرۆڤ بەدەرن،","poem":1},{"text":"وەک خەڵکی تێناکەون.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بۆیە لووتبەرزییان وەک ملوانکە لە مل کردووە و","poem":1},{"text":"بەرگی توندوتیژییان پۆشیوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"خراپە لە دڵی بێ بەزەییانەوە دێت،","poem":1},{"text":"لێکدانەوەی دڵیان بێ سنوورە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"گاڵتەجاڕی دەکەن و بە خراپە دەدوێن،","poem":1},{"text":"بە لووتبەرزییەوە باسی ستەم دەکەن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ڕووی دەمیان لە ئاسمان کردووە،","poem":1},{"text":"زمانیشیان بەسەر زەویدا دەگێڕن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بۆیە خەڵکی خۆیان دێنە لایان و","poem":1},{"text":"باوەڕ بە قسەکانیان دەکەن","poem":2},{"noteId":111},{"text":".","poem":2}]},{"type":"verse","number":11,"content":[{"text":"دەڵێن: «چۆن خودا دەزانێت؟","poem":1},{"text":"ئایا لەلای هەرەبەرز زانیاری هەیە؟»","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ئەوەتا ئەمانە بەدکارن،","poem":1},{"text":"هەمیشە لە خۆشیدان و سامانیان لە زیادبووندایە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"بێگومان بە بێهوودە دڵی خۆمم بە پاکی ڕاگرتووە،","poem":1},{"text":"دەستیشم بە بێگەردی شوشتووە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"بە درێژایی ڕۆژ لێم قەومابوو،","poem":1},{"text":"هەتا بەرەبەیان تەمبێ کرابووم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ئەگەر بە ڕاشکاوی قسەم دەکرد،","poem":1},{"text":"ئەوا لەگەڵ منداڵەکانت ناپاک دەبووم.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"کاتێک ویستم لەمە تێبگەم،","poem":1},{"text":"بە ئەرکێکی سەختم بینی،","poem":2}]},{"type":"verse","number":17,"content":[{"text":"هەتا چوومە ناو پیرۆزگای خودا،","poem":1},{"text":"ئەوسا لە چارەنووسیان تێگەیشتم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"بە ڕاستی لە جێگایەکی خلیسک داتناون،","poem":1},{"text":"تووشی وێرانیت کردوون.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"چۆن بە چاوتروکانێک وێران بوون،","poem":1},{"text":"لە ترسان بە تەواوی لەناوچوون!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئەی پەروەردگار، وەک خەون کاتی بەئاگا هاتنەوە،","poem":1},{"text":"لە کاتی بەئاگایی وەک خەون ڕیسوایان دەکەیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"کاتێک دڵم تەنگ بوو،","poem":1},{"text":"وەک شمشێر هەناومی بڕی،","poem":2}]},{"type":"verse","number":22,"content":[{"text":"گێل و نەزان بووم،","poem":1},{"text":"لەلای تۆ وەک ئاژەڵم لێهات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"لەگەڵ ئەوەشدا، من هەمیشە لەلای تۆم،","poem":1},{"text":"دەستی ڕاستی منت گرت.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"بە ئامۆژگاریت ڕێنماییم دەکەیت،","poem":1},{"text":"پاشان بۆ شکۆمەندیم دەبەیت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"بێجگە لە تۆ لە ئاسمان کێم هەیە؟","poem":1},{"text":"ئەگەر لەگەڵ تۆ بم، لەسەر زەویش هیچ نییە ئارەزووی بکەم.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"جەسته و دڵم کۆتاییان پێدێت،","poem":1},{"text":"بەڵام هەتاهەتایە هێزی دڵ و بەشی من خودایە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ئەوەتا ئەوانەی لە تۆ دوورن وێڵ دەبن،","poem":1},{"text":"ئەوانەی ناپاکیت لەگەڵ بکەن دوایان دەبڕیتەوە.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"بەڵام نزیکبوونەوە لە خودا بۆ من باشە،","poem":1},{"text":"یەزدانی باڵادەستم کرد بە پەناگام،","poem":2},{"lineBreak":true},{"text":"هەتا باسی هەموو کردەوەکانت بکەم.","poem":2}]}],"footnotes":[{"noteId":111,"caller":"+","text":"عیبری: ئاو بە زۆری دەخۆنەوە.‏","reference":{"chapter":73,"verse":10}}]},"thisChapterLink":"/api/ckb_bib/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}