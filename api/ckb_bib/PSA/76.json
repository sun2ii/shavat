tent":[{"text":"ئەی خودای یاقوب، بە سەرزەنشتی تۆ،","poem":1},{"text":"ئەسپ و سوار پێکەوە کەوتنە خەوێکی قووڵەوە!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"تۆ خۆت بەسامیت!","poem":1},{"text":"لە کاتی تووڕەییت، کێ لەبەردەمت ڕادەوەستێت؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"لە ئاسمان حوکمت بیسترا،","poem":1},{"text":"زەوی ترسا و کپ بوو،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"بە هەستانی خودا بۆ دادوەری،","poem":1},{"text":"بۆ ڕزگارکردنی هەموو ستەملێکراوانی زەوی.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بێگومان تووڕەیی مرۆڤ ستایشت دەکات،","poem":1},{"text":"خۆتت بە پاشماوەی تووڕەیی چەکدار کردووە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"نەزر بۆ یەزدانی پەروەردگارتان بکەن و بەجێی بهێنن.","poem":1},{"text":"ئەی هەموو ئەوانەی لە دەوریدان،","poem":2},{"lineBreak":true},{"text":"دیاری پێشکەش بە سامناک بکەن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەوەی ڕۆحی میرەکان دەشکێنێت،","poem":1},{"text":"سامناکە بۆ پاشاکانی سەر زەوی.","poem":2}]}],"footnotes":[{"noteId":116,"caller":"+","text":"واتا (ئاشتی)، مەبەست لە شاری ئۆرشەلیمە (قودس).‏","reference":{"chapter":76,"verse":2}},{"noteId":117,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتی 9، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":76,"verse":3}}]},"thisChapterLink":"/api/ckb_bib/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}