{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"hebrew_subtitle","content":["بۆ گەورەی گۆرانیبێژان. ئاوازی یەدوتون، زەبوورێکی ئاساف."]},{"type":"verse","number":1,"content":[{"text":"دەنگم بۆ خودا بەرز دەکەمەوە، هاوار دەکەم،","poem":1},{"text":"دەنگم بۆ خودا بەرز دەکەمەوە بۆ ئەوەی گوێی لێم بێت.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"لە ڕۆژی تەنگانەم ڕوو لە پەروەردگار دەکەم،","poem":1},{"text":"بە درێژایی شەو دەست پان دەکەمەوە، بێ ئەوەی سڕبێت.","poem":2},{"lineBreak":true},{"text":"گیانم نەوازش ڕەت دەکاتەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"بیر لە خودا دەکەمەوە و دەناڵێنم،","poem":1},{"text":"ورد دەبمەوە و ڕۆحم دەبوورێتەوە.","poem":2},{"noteId":118}]},{"type":"verse","number":4,"content":[{"text":"پێڵووی چاوەکانمت گرت،","poem":1},{"text":"شپرزە بووم، قسەم پێ نەکرا.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بیر لە ڕۆژگاری دێرین دەکەمەوە،","poem":1},{"text":"ساڵانی ڕابردوو.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"شەوانە لە دڵی خۆم بیر لە ئاوازەکانم دەکەمەوە،","poem":1},{"text":"ورد دەبمەوە و ڕۆحم دەگەڕێت:","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«ئایا هەتاهەتایە پەروەردگار ڕەتمان دەکاتەوە؟","poem":1},{"text":"چیتر لێمان ڕازی نابێتەوە؟","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئایا خۆشەویستییە نەگۆڕەکەی هەتاهەتایە نەماوە؟","poem":1},{"text":"ئایا بەڵێنەکانی بۆ نەوە دوای نەوە دواییان هاتووە؟","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئایا خودا میهرەبانی لەبیر کردووە؟","poem":1},{"text":"یان لە تووڕەیی بەزەیی خۆی داخستووە؟»","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئینجا دەڵێم: «ئەمە دەردی منە:","poem":1},{"text":"دەستە ڕاستەی خودای هەرەبەرز گۆڕاوە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"کردارەکانی یەزدان دێنمەوە یادم،","poem":1},{"text":"بێگومان پەرجووەکانی تۆم لەبیرە کە لە کۆنەوەیە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لە هەموو کارەکانت ورد دەبمەوە و","poem":1},{"text":"بیر لە کردەوە مەزنەکانت دەکەمەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ئەی خودایە، ڕێگات پیرۆزە.","poem":1},{"text":"چ خودایەک وەک خودا مەزنە؟","poem":2}]},{"type":"verse","number":14,"content":[{"text":"تۆ ئەو خودایەی کە پەرجووت کردووە و","poem":1},{"text":"هێزی خۆتت لەنێو خەڵک دەرخستووە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بە بازووی خۆت گەلی خۆتت کڕییەوە،","poem":1},{"text":"نەوەی یاقوب و یوسف.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ئەی خودایە، کە ئاوەکان تۆیان بینی،","poem":1},{"text":"کە ئاوەکان تۆیان بینی ترسان،","poem":2},{"lineBreak":true},{"text":"بگرە قووڵاییەکان هەژان.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"هەورەکان ئاویان ڕشت،","poem":1},{"text":"هەورەتریشقەکان دەنگیان دایەوە،","poem":2},{"lineBreak":true},{"text":"هەروەها تیرەکانت بریسکانەوە.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"گرمەی هەورەتریشقەی تۆ لە گەردەلوول،","poem":1},{"text":"بروسکەکان دنیایان ڕووناک کردەوە،","poem":2},{"lineBreak":true},{"text":"زەوی لەرزی و هەژا.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ڕێگات بە ناو دەریادایە،","poem":1},{"text":"ڕێچکەکانت بە ناو ئاوە زۆرەکانە،","poem":2},{"lineBreak":true},{"text":"شوێن پێیەکانت نەزانران.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"لەسەر دەستی موسا و هارون،","poem":1},{"text":"وەک مێگەلە مەڕ ڕێنمایی گەلی خۆتت کرد.","poem":2}]}],"footnotes":[{"noteId":118,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتەکانی 9 و 15، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":77,"verse":3}}]},"thisChapterLink":"/api/ckb_bib/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}