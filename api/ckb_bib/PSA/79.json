{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"heading","content":["زەبوورێکی ئاساف."]},{"type":"verse","number":1,"content":[{"text":"ئەی خودایە، نەتەوەکان هاتوونەتە ناو میراتی تۆ،","poem":1},{"text":"پەرستگای پیرۆزی تۆیان گڵاو کردووە،","poem":2},{"lineBreak":true},{"text":"ئۆرشەلیمیان کردووە بە کەلاوە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"تەرمی خزمەتکارەکانی تۆیان","poem":1},{"text":"کردووە بە خۆراکی باڵندەی ئاسمان و","poem":2},{"lineBreak":true},{"text":"گۆشتی خۆشەویستانت بۆ دڕندەی زەوی.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"لە دەوروبەری ئۆرشەلیم وەک ئاو خوێنیان ڕشتن،","poem":1},{"text":"کەس نەبوو بیاننێژێت.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بووین بە پەندی دراوسێکانمان،","poem":1},{"text":"بووین بە سووکایەتی و گاڵتەجاڕی دەوروبەرمان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ئەی یەزدان هەتا کەی؟ ئایا هەتاسەر هەر تووڕە دەبیت؟","poem":1},{"text":"هەتا کەی ئیرەییت وەک ئاگر دەسووتێت؟","poem":2}]},{"type":"verse","number":6,"content":[{"text":"تووڕەیی خۆت بەسەر ئەو نەتەوانەدا ببارێنە کە پشت گوێت دەخەن،","poem":1},{"text":"بەسەر ئەو شانشینانەدا بیڕێژە کە بە ناوی تۆ ناپاڕێنەوە،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"چونکە ئەوانە یاقوبیان هەڵلووشیوە،","poem":1},{"text":"نیشتیمانیان خاپوور کردووە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"گوناهی باپیرانی پێش خۆمان لەسەر مەژمێرە،","poem":1},{"text":"با بەزەییت زوو پێشمان بکەوێت،","poem":2},{"lineBreak":true},{"text":"چونکە ئێمە زۆر زەلیل بووین.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەی خودای ڕزگارکەرمان، یارمەتیمان بدە،","poem":1},{"text":"لەبەر شکۆی ناوی خۆت.","poem":2},{"text":"دەربازمان بکە و لە گوناهمان خۆشبە،","poem":1},{"text":"لە پێناوی ناوی خۆت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بۆچی نەتەوەکان بڵێن:","poem":1},{"text":"«کوا خوداکەیان؟»","poem":2},{"lineBreak":true},{"text":"با هەموو نەتەوەکان بزانن کە تۆ لەبەرچاوی هەموومان","poem":1},{"text":"تۆڵەی خوێنی ڕژاوی خزمەتکارەکانی خۆت دەکەیتەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"با ناڵە و هاواری دیلەکانت پێ بگات،","poem":1},{"text":"بە گەورەیی بازووی خۆت بیانهێڵەوە","poem":2},{"lineBreak":true},{"text":"ئەوانەی سزای مردنیان بەسەردا دراوە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەی پەروەردگار، حەوت ئەوەندەی ئەو سووکایەتییەی","poem":1},{"text":"دراوسێکانمان پێیان کردی،","poem":2},{"lineBreak":true},{"text":"لە باوەشیان سووکایەتییان پێ بکە.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئینجا ئێمەی گەلی تۆ، مەڕی لەوەڕگای تۆ،","poem":1},{"text":"هەتاهەتایە ستایشت دەکەین،","poem":2},{"lineBreak":true},{"text":"نەوە بە نەوە باسی ستایشی تۆ دەکەین.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}