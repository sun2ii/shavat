em":2}]},{"type":"verse","number":5,"content":[{"text":"تۆ نانی فرمێسکت دەرخوارد داون،","poem":1},{"text":"فرمێسکت پڕ بە پێوانە پێ نۆشیون.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"دەمانکەیتە مایەی ناکۆکی لەلای دراوسێکانمان،","poem":1},{"text":"ناحەزانمان لەناو خۆیان پێمان پێدەکەنن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ئەی خودای سوپاسالار، بمانگەڕێنەوە،","poem":1},{"text":"ڕووی خۆتمان بۆ بدرەوشێنەوە","poem":2},{"lineBreak":true},{"text":"بۆ ئەوەی ڕزگارمان بێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"دار مێوێکت لە میسرەوە گواستەوە،","poem":1},{"text":"نەتەوەکانت وەدەرنا و چاندت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"خاکت بۆ ئامادە کرد،","poem":1},{"text":"ڕەگ و ڕیشەیت داکوتا، زەوی پڕکرد.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"سێبەرەکەی چیاکانی داپۆشی،","poem":1},{"text":"چڵەکانی ئورزە گەورەکان.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لقی هەتا دەریا","poem":1},{"noteId":126},{"text":"هاویشت،","poem":1},{"text":"پۆپکەکانی بۆ دەم ڕووبار","poem":2},{"noteId":127},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"بۆچی شووراکانیت ڕووخاند","poem":1},{"text":"تاکو هەر ڕێبوارێک لێی بکاتەوە؟","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بەرازی دارستان وێرانی دەکات،","poem":1},{"text":"زیندەوەرەکانی کێڵگە لەسەری دەلەوەڕێن.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەی خودای سوپاسالار بمانگەڕێنەوە!","poem":1},{"text":"لە ئاسمانەوە سەیر بکە و ببینە!","poem":2},{"lineBreak":true},{"text":"ئەم دار مێوە بەسەربکەوە،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەو قەدەی دەستی ڕاستت چاندوویەتی،","poem":1},{"text":"ئەو کوڕەی بۆ خۆت بەهێزت کردووە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"سووتاوە و بە ئاگر بڕاوەتەوە،","poem":1},{"text":"بە سەرزەنشتی ڕووی تۆ گەلەکەت لەناودەچێت.","poem":2}