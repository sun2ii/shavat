{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، لەسەر ئاوازی گتیت",{"noteId":128},". بۆ ئاساف."]},{"type":"verse","number":1,"content":[{"text":"هەلهەلە لێدەن بۆ خودا ئەوەی هێزمانە،","poem":1},{"text":"بە خۆشییەوە هاوار بکەن بۆ خودای یاقوب.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئاوازێک بەرز بکەنەوە و دەف بهێنن،","poem":1},{"text":"سازێکی ناسک لەگەڵ قیسارە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"لە جەژنی سەرەمانگ کەڕەنا لێدەن و","poem":1},{"text":"لە مانگی تابان، بۆ ڕۆژی جەژنەکانمان،","poem":2}]},{"type":"verse","number":4,"content":[{"text":"چونکە ئەمە فەرزە لەسەر ئیسرائیل،","poem":1},{"text":"حوکمی خودای یاقوبە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لە بنەماڵەی یوسفدا کردی بە یاسا،","poem":1},{"text":"کە لە خاکی میسر دەریهێنا.","poem":2},{"lineBreak":true},{"text":"گوێمان لە دەنگێک بوو بە زمانێک کە لێی تێنەگەیشتین:","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«بارم لەسەر شانەکانی لادا،","poem":1},{"text":"دەستەکانی لە سەبەتە بەربوون.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"لە تەنگانەدا هاوارت کرد، دەربازم کردیت،","poem":1},{"text":"لەژێر سێبەری هەورەتریشقە وەڵامم دایتەوە،","poem":2},{"lineBreak":true},{"text":"لە مێرگی مەریبا","poem":2},{"noteId":129},{"text":"تاقیم کردیتەوە.","poem":2},{"noteId":130}]},{"type":"verse","number":8,"content":[{"text":"ئەی گەلی من، گوێ بگرە، ئاگادارت دەکەمەوە.","poem":1},{"text":"ئەی ئیسرائیل، خۆزگە گوێت لە من دەگرت!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"لەنێو ئێوەدا خوداوەندێکی بێگانە نابێت،","poem":1},{"text":"کڕنۆش بۆ خوداوەندێکی بیانی نابەیت.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"من یەزدانی پەروەردگاری تۆم،","poem":1},{"text":"کە لە خاکی میسر دەرمهێنای،","poem":2},{"lineBreak":true},{"text":"دەمت بکەوە و پڕی دەکەم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«بەڵام گەلەکەم گوێی لە قسەم نەگرت،","poem":1},{"text":"ئیسرائیل منی نەویست.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"منیش ئەوانم دایە دەست کەللەڕەقییەکەی خۆیان،","poem":1},{"text":"بە ڕاوێژی خۆیان هەڵسوکەوت بکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«خۆزگە گەلەکەم بە قسەی منیان دەکرد،","poem":1},{"text":"ئەگەر ئیسرائیل ڕێگای منیان دەگرتەبەر،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"هەر زوو دوژمنەکانم بۆ زەلیل دەکردن،","poem":1},{"text":"دەستم درێژ دەکردە سەر ناحەزانیان!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەوانەی ڕقیان لە یەزدانە، ملکەچی دەبن،","poem":1},{"text":"هەتاهەتایە کاتی سزایان دەبێت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"باشترین گەنمم دەرخوارد دەدایت،","poem":1},{"text":"لە تاشەبەردەوە تێر هەنگوینم دەکردیت.»","poem":2}]}],"footnotes":[{"noteId":128,"caller":"+","text":"دەستەواژەیەکی بواری مۆسیقایە.‏","reference":{"chapter":81,"verse":0}},{"noteId":129,"caller":"+","text":"کانییەکە نزیک ڕفیدیم لە بەردێکەوە هەڵقوڵا، کاتێک موسا بە فەرمانی خودا لە بەردەکەی دا.‏","reference":{"chapter":81,"verse":7}},{"noteId":130,"caller":"+","text":"لە دەقی عیبری لێرە وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":81,"verse":7}}]},"thisChapterLink":"/api/ckb_bib/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}