{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"hebrew_subtitle","content":["گۆرانییەک. زەبوورێکی کوڕانی قۆرەح. بۆ گەورەی گۆرانیبێژان. بەگوێرەی «ماحەلەت لعەنۆت»",{"noteId":155},". هۆنراوەیەکی هێیمانی ئەزراحی."]},{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، خودای ڕزگاریم،","poem":1},{"text":"شەو و ڕۆژ بەرامبەر بە تۆ هاوارم کرد.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"با نوێژەکانم بگاتە بەردەمت،","poem":1},{"text":"گوێ بۆ هاوارم شل بکە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"گیانم پڕ خراپە بووە و","poem":1},{"text":"ژیانم لە جیهانی مردووان نزیک بووەتەوە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"وەک ئەوانە دانراوم کە دەچنە نێو جیهانی مردووان،","poem":1},{"text":"وەک پیاوێکم لێهاتووە هێزی لەبەربڕابێت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"لەناو مردووان وازلێهێنراو،","poem":1},{"text":"وەک کوژراوەکانی ناو گۆڕ ڕاکشاو،","poem":2},{"text":"ئەوانەی ئیتر یادیان ناکەیتەوە،","poem":1},{"text":"ئەوانەی دەستت لێیان شوشتووە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"لەناو قووڵترین گۆڕ داتناوم،","poem":1},{"text":"لەناو جەرگەی تاریکی، لە قووڵایی.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"تووڕەییت قورسە بەسەرمەوە،","poem":1},{"text":"شەپۆلەکانت ڕامدەماڵن.","poem":2},{"noteId":156}]},{"type":"verse","number":8,"content":[{"text":"ناسیاوەکانمت لێ دوورخستمەوە،","poem":1},{"text":"قێزم لێ دەکەنەوە.","poem":2},{"text":"گیراوم و دەربازبوونم بۆ نییە،","poem":1}]},{"type":"verse","number":9,"content":[{"text":"بەهۆی ژێردەستەیی چاوم لە کزبوونە.","poem":2},{"lineBreak":true},{"text":"ئەی یەزدان، بە درێژایی ڕۆژ هاوار بۆ تۆ دەکەم،","poem":1},{"text":"دەستم لە تۆ پان دەکەمەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئایا کاری سەرسوڕهێنەر بۆ مردووان دەکەیت؟","poem":1},{"text":"یان ڕۆحەکان هەڵدەستنەوە ستایشت بکەن؟","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئایا لەناو گۆڕ باسی خۆشەویستییە نەگۆڕەکەت دەکرێت،","poem":1},{"text":"یان لە لەناوچوون","poem":2},{"noteId":157},{"text":"باسی دڵسۆزییەکەت؟","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئایا لە تاریکایی کارە سەرسوڕهێنەرەکانت دەناسرێت،","poem":1},{"text":"یان لە خاکی لەبیرچوون","poem":2},{"noteId":158},{"text":"ڕاستودروستیت؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ئەی یەزدان، هاوار بۆ تۆ دەهێنم،","poem":1},{"text":"بەیانییان نوێژم بەرەو ڕووت دێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەی یەزدان، بۆچی گیانم ڕەت دەکەیتەوە،","poem":1},{"text":"ڕووی خۆتم لێ دەشاریتەوە؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"من لە منداڵییەوە کڵۆڵم و نزیکە مەرگم،","poem":1},{"text":"بەرگەی ترسەکانی تۆم گرت و سەرم لێ شێوا.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"تووڕەیی تۆ بەسەر مندا تێپەڕی،","poem":1},{"text":"ترسی بەڵاکانی تۆ وێرانی کردم.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"وەک لافاو بە درێژایی ڕۆژ دەوری داوم،","poem":1},{"text":"لە هەموو لایەکەوە دەوری گرتووم.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"دۆست و خۆشەویستەکانت لێ دوورخستمەوە،","poem":1},{"text":"تاریکی بووە بە نزیکترین هاوڕێم.","poem":2}]}],"footnotes":[{"noteId":155,"caller":"+","text":"ماحەلەت لعەنۆت: دەستەواژەیەکی مۆسیقییە، لەوانەیە بە واتای ئازاری ناخۆشی بێت.‏","reference":{"chapter":88,"verse":0}},{"noteId":156,"caller":"+","text":"لە دەقی عیبری لێرە و لە ئایەتی 10، وشەی سەلاە‏ هەیە کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":88,"verse":7}},{"noteId":157,"caller":"+","text":"لەناوچوون: عیبری: ئەبەدۆن‏. لە پەیمانی نوێ ئەم وشەیە بە واتای (لەناوبەر) هاتووە، بڕوانە ئاشکراکردن 11‏:9‏‏.‏","reference":{"chapter":88,"verse":11}},{"noteId":158,"caller":"+","text":"شوێنی مردووان، کە چیتر خودا گرنگییان پێ نادات.‏","reference":{"chapter":88,"verse":12}}]},"thisChapterLink":"/api/ckb_bib/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}