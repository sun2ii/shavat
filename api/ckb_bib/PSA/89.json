Id":161},{"text":"دڵسۆزیت.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لەناو هەورەکان کێ هاوتای یەزدانە؟","poem":1},{"text":"لەنێو فریشتەکانی ئاسمان کامەیان لە یەزدان دەچێت؟","poem":2}]},{"type":"verse","number":7,"content":[{"text":"خودا لەنێو ئەنجومەنی پیرۆزان زۆر سامناکە،","poem":1},{"text":"لە هەموو ئەوانەی دەوروبەری ترسناکترە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەی یەزدان، خودای سوپاسالار، کێ وەک تۆ وایە؟","poem":1},{"text":"تۆ بەهێزیت، ئەی یەزدان، دڵسۆزیشت دەوری داویت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"دەسەڵاتت بەسەر هەڵچوونی دەریادا هەیە،","poem":1},{"text":"کە شەپۆلەکانی بەرز دەبنەوە، هێمنیان دەکەیتەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"وەک بریندارێکی سەخت ڕاهەبت","poem":1},{"noteId":162},{"text":"پان کردەوە،","poem":1},{"text":"بە هێزی بازووت دوژمنەکانت پەرتەوازە کرد.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئاسمان هی تۆیە، هەروەها زەویش،","poem":1},{"text":"گەردوون و هەرچی تێیدایە تۆ داتمەزراندووە.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"باکوور و باشوور تۆ بەدیت هێناون،","poem":1},{"text":"تابۆر","poem":2},{"noteId":163},{"text":"و حەرمۆن بۆ ناوی تۆ هەلهەلە لێدەدەن.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"بازووت هەیە لەگەڵ توانا،","poem":1},{"text":"دەستت بەهێزە، دەستی ڕاستت بەرزە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ڕاستودروستی و دادپەروەری بناغەی تەختی تۆن،","poem":1},{"text":"خۆشەویستی نەگۆڕ و ڕاستی","poem":2},{"noteId":164},{"text":"لەبەردەمی تۆ دەڕۆن.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"خۆزگە بەو گەلە دەخوازرێ کە دەزانن چۆن پڕ بە دەنگیان هاواری شادی بکەن،","poem":1},{"text":"ئەی یەزدان، بە ڕووناکی ڕوخساری تۆ ڕێ دەکەن.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بەهۆی ناوی تۆوە بە درێژایی ڕۆژ شادمان دەبن،","poem":1},{"text":"بە ڕاستودروستی تۆ بەرز دەبنەوە،","poem":2}]},{"type":"verse","number":17,"content":[{"text":"چونکە تۆ شکۆمەندی و هێزی ئەوانیت،","poem":1},{"text":"ئێمە بە ڕەزامەندی تۆ بەهێز دەبین.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بێگومان قەڵغانمان هی یەزدانە،","poem":1},{"text":"پاشامان هی خودا پیرۆزەکەی ئیسرائیلە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"جارێکیان لە بینینێکدا","poem":1},{"noteId":165},{"text":"قسەت کرد،","poem":1},{"text":"بە خۆشەویستانی خۆتت فەرموو:","poem":2},{"text":"«هێزم بە پاڵەوانێک بەخشی،","poem":1},{"text":"لەنێو گەل گەنجێکم بەرزکردەوە.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"داودی بەندەی خۆمم دۆزییەوە،","poem":1},{"text":"بە ڕۆنی پیرۆزم دەستنیشانم کرد","poem":2},{"noteId":166},{"text":".","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ئەوەی دەستم پێوەی دەچەسپێت،","poem":1},{"text":"هەروەها بازووم بەهێزی دەکات.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"دوژمن بەسەریدا زاڵ نابێت،","poem":1},{"text":"نابێتە ژێر دەستەی کوڕی زۆردار.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"لەبەردەمی خۆی دوژمنانی تێکدەشکێنم،","poem":1},{"text":"ناحەزانی تووشی بەڵا دەکەم.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"دڵسۆزی و خۆشەویستی نەگۆڕی منی لەگەڵدایە،","poem":1},{"text":"بە ناوی منەوە بەهێز دەبێت.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"وا دەکەم دەستی بەسەر دەریاوە بێت،","poem":1},{"text":"دەستی ڕاستی بەسەر ڕووبارەکان.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"هاوارم بۆ دەکات: ”تۆ باوکمی،","poem":1},{"text":"خودای منی، تاشەبەردی ڕزگاریی منیت.“","poem":2}]},{"type":"verse","number":27,"content":[{"text":"منیش دەیکەمە نۆبەرەی خۆم،","poem":1},{"text":"بەرزترین لە پاشایانی زەوی.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"هەتاهەتایە خۆشەویستی نەگۆڕی خۆمی بۆ دەپارێزم،","poem":1},{"text":"پەیمانی من بۆ ئەو دەچەسپێت.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"هەتاهەتایە وەچەکەی دەچەسپێنم،","poem":1},{"text":"تەختیشی 