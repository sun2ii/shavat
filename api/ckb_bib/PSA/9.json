{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":9,"content":[{"type":"hebrew_subtitle","content":["بۆ سەرۆکی کۆمەڵی مۆسیقاژەنان، لەسەر ئاوازی «مردنی کوڕەکە». زەبوورێکی داود."]},{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، بە هەموو دڵەوە ستایشت دەکەم،","poem":1},{"text":"هەموو کارە سەرسوڕهێنەرەکانت ڕادەگەیەنم.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بە تۆوە شاد و دڵخۆش دەبم،","poem":1},{"text":"ئەی هەرەبەرز، گۆرانی ستایش بۆ ناوی تۆ دەڵێم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"کاتێک دوژمنەکانم بەرەو پاش هەڵدێن،","poem":1},{"text":"لەبەردەمی تۆدا دەکەون و لەناودەچن،","poem":2}]},{"type":"verse","number":4,"content":[{"text":"چونکە دادپەروەرانە دادوەریت بۆ کردووم،","poem":1},{"text":"دادوەرێکی ڕاستودروستی لەسەر تەختی خۆت دانیشتووی.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"تۆ نەتەوەکانت سەرزەنشت کردووە و بەدکارانت لەناوبردووە،","poem":1},{"text":"هەتاهەتایە ناویانت سڕیوەتەوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"دوژمنانت تووشی لەناوچوونی بێ کۆتایی کردووە،","poem":1},{"text":"شارەکانیانت وێران کردووە،","poem":2},{"lineBreak":true},{"text":"تەنانەت بیرەوەریشیان نامێنێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"بەڵام یەزدان هەتاهەتایە دادەنیشێت،","poem":1},{"text":"تەختی خۆی بۆ دادوەری دامەزراندووە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بە ڕاستودروستی دادوەری جیهان دەکات،","poem":1},{"text":"بە دادپەروەری گەلان حوکم دەدات.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"یەزدان پەناگای زۆرلێکراوانە،","poem":1},{"text":"قەڵایە لە کاتی تەنگانەدا.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئەوانەی بە ناوی تۆ ئاشنان","poem":1},{"noteId":13},{"text":"پشتت پێ دەبەستن،","poem":1},{"text":"چونکە ئەی یەزدان، قەت تۆ وازت لەوانە نەهێناوە کە حەز دەکەن لە تۆ نزیک ببنەوە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"گۆرانی ستایش بڵێن بۆ یەزدان کە لە سییۆن","poem":1},{"noteId":14},{"text":"نیشتەجێیە،","poem":1},{"text":"لەنێو نەتەوەکان کردارەکانی ڕابگەیەنن،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"چونکە ئەوەی تۆڵەی خوێن دەکاتەوە یادی دەکرێتەوە،","poem":1},{"text":"هاواری ستەملێکراوان لەبیرناکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ئەی یەزدان، ببینە چ ئازارێک بەدەست دوژمنەکانمەوە دەکێشم!","poem":1},{"text":"لەگەڵم میهرەبان بە و لە دەروازەکانی مردن ڕزگارم بکە","poem":2},{"noteId":15},{"text":"،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"تاکو لەبەردەم دەروازەکانی سییۆنی کچ","poem":1},{"noteId":16},{"text":"بە ستایشی تۆوە بدوێم،","poem":1},{"text":"هەروەها بە ڕزگاریی تۆوە دڵخۆش بم.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"نەتەوەکان کەوتوونەتە ئەو چاڵەی کە خۆیان هەڵیانکەندبوو،","poem":1},{"text":"پێیان بەو تۆڕەوە بووە کە نابوویانەوە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"یەزدان بە دادپەروەری ناسراوە،","poem":1},{"text":"بەدکاران دەکەونە داوی کردەوەی دەستی خۆیان.","poem":2},{"noteId":17}]},{"type":"verse","number":17,"content":[{"text":"بەدکاران بەرەو جیهانی مردووان دەڕۆن،","poem":1},{"text":"هەروەها هەموو ئەو نەتەوانەی کە خودا لەبیر دەکەن.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"بەڵام نەداران هەتاسەر لەبیر ناکرێن،","poem":1},{"text":"ئومێدی ستەملێکراو هەتاهەتایە لەناو ناچێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ئەی یەزدان ڕاپەڕە، مەهێڵە مرۆڤ سەربکەوێت،","poem":1},{"text":"با نەتەوەکان لەبەردەم تۆ دادگایی بکرێن.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ئەی یەزدان، ترس بخەرە دڵیانەوە،","poem":1},{"text":"با نەتەوەکان بزانن کە تەنها مرۆڤن.","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"بە واتای ناسینی خودا و کەسایەتییەکەی.‏","reference":{"chapter":9,"verse":10}},{"noteId":14,"caller":"+","text":"ناوێکی ئەدەبییە بۆ شاری ئۆرشەلیم.‏","reference":{"chapter":9,"verse":11}},{"noteId":15,"caller":"+","text":"عیبری: بەرزم بکەرەوە، بە واتای پارێزگار و فریاکەوتن.‏","reference":{"chapter":9,"verse":13}},{"noteId":16,"caller":"+","text":"مەبەست لە شاری سییۆنە، ئۆرشەلیم.‏","reference":{"chapter":9,"verse":14}},{"noteId":17,"caller":"+","text":"لە دەقی عیبری لێرە وشەی هیگایۆن‏ و سەلاه‏ هەیە و لە کۆتایی ئایەتی 20 وشەی سەلاه‏ هەیە، کە لەوانەیە ئاماژەیەکە بۆ وەستانی مۆسیقا و خوێندنەوە.‏","reference":{"chapter":9,"verse":16}}]},"thisChapterLink":"/api/ckb_bib/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}