{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"hebrew_subtitle","content":["نوێژێکی موسای پیاوی خودا."]},{"type":"verse","number":1,"content":[{"text":"ئەی پەروەردگار، نەوە دوای نەوە","poem":1},{"text":"تۆ پەناگامان بوویت.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بەر لەوەی چیاکان پەیدا ببن،","poem":1},{"text":"یان زەوی و جیهان دروستببن،","poem":2},{"lineBreak":true},{"text":"لە ئەزەلەوە و بۆ هەتاهەتایە، تۆ خودایت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"تۆ مرۆڤ دەکەیتەوە بە تۆز،","poem":1},{"text":"دەفەرموویت: «ئادەمیزادینە، بگەڕێنەوە بۆ تۆز.»","poem":2}]},{"type":"verse","number":4,"content":[{"text":"لەلای تۆ، هەزار ساڵ","poem":1},{"text":"وەک دوێنێ وایە کە تێپەڕیوە،","poem":2},{"lineBreak":true},{"text":"وەک بەشێکی شەو وایە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"مرۆڤ وەک خەون ڕادەماڵیت،","poem":1},{"text":"وەک ئەو گیایەی سەر لە بەیانی نوێ دەبێتەوە،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"سەر لە بەیانی دەبووژێتەوە و نوێ دەبێتەوە،","poem":1},{"text":"بۆ ئێوارە سیس دەبێت و دەفەوتێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"بە هەڵچوونی تۆ لەناوچووین،","poem":1},{"text":"بە تووڕەیی تۆ تۆقین.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"گوناهەکانی ئێمەت لەبەردەمی خۆت داناوە،","poem":1},{"text":"شتە شاراوەکانمان لەبەر ڕووناکی ڕوخسارت.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"هەموو ڕۆژگارمان بە تووڕەیی تۆ بەسەرچوو،","poem":1},{"text":"ساڵانی تەمەنمان وەک هەناسەیەک بەسەربرد.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ساڵانی تەمەنمان حەفتا ساڵە،","poem":1},{"text":"یان هەشتا ساڵ ئەگەر بە هێزەوە بێت،","poem":2},{"text":"ئەوەی مایەی شانازیش بێت ڕەنج و ناخۆشییە،","poem":1},{"text":"چونکە بە پەلە دەڕەوێتەوە و ئێمە باڵدەگرین.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"کێ هێزی تووڕەیی تۆ دەزانێت؟","poem":1},{"text":"لەبەر ئەوەی تووڕەیی تۆ ترسێکی زۆر دەهێنێ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئیتر فێرمان بکە ڕۆژانمان بژمێرین،","poem":1},{"text":"بۆ ئەوەی دڵێکی پڕ داناییمان هەبێت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ئەی یەزدان، تووڕەییەکەت دابمرکێنەوە! هەتا کەی؟","poem":1},{"text":"لەگەڵ خزمەتکارەکانت میهرەبان بە.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"سەر لە بەیانی لە خۆشەویستییە نەگۆڕەکەت تێرمان بکە،","poem":1},{"text":"تاکو هەموو ڕۆژانی ژیانمان هەلهەلە لێبدەین و دڵشاد ببین.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"دڵشادمان بکە ئەوەندەی بۆ ئەو ڕۆژانەی تووشی ناخۆشیت کردین،","poem":1},{"text":"ئەو ساڵانەی کە خراپەمان بینی.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"کردەوە مەزنەکانت بۆ خزمەتکارەکانت دەربخە،","poem":1},{"text":"شکۆمەندیت بەسەر منداڵەکانیان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"با نیعمەتی خودای پەروەردگارمان بەسەرمانەوە بێت،","poem":1},{"text":"کردەوەکانی دەستمان بۆ بچەسپێنە،","poem":2},{"lineBreak":true},{"text":"بەڵێ، کردەوەکانی دەستمان بچەسپێنە.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}