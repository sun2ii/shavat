{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"ئەوەی لە پەناگای هەرەبەرز دادەنیشێت،","poem":1},{"text":"ئەوەی لە سێبەری خودای هەرە بەتوانا دەمێنێتەوە،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بە یەزدان دەڵێ: «تۆ پەناگامی، قەڵامی،","poem":1},{"text":"خودای منی، پشتت پێ دەبەستم.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"بێگومان لە تۆڕی ڕاوچی دەربازت دەکات،","poem":1},{"text":"لە دەرد و بەڵای کوشندە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بە باڵی خۆی داتدەپۆشێت،","poem":1},{"text":"لەژێر باڵەکانی پەنا دەگریت و","poem":2},{"lineBreak":true},{"text":"دڵسۆزییەکەی قەڵغان و شوورایە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"نە لە تۆقینی شەو دەترسیت و","poem":1},{"text":"نە لەو تیرەی بە ڕۆژ دەهاوێژرێت،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"نە لەو دەردەی کە لە تاریکی دێت،","poem":1},{"text":"نە لەو ئافاتەی بە ڕۆژی نیوەڕۆ زیان دەبەخشێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"هەزار کەس لەتەنیشتت بەردەبنەوە،","poem":1},{"text":"دە هەزار لەلای دەستی ڕاستت،","poem":2},{"lineBreak":true},{"text":"بەڵام لە تۆ نزیک ناکەوێتەوە.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"بەڵکو تەنها بە چاوی خۆت سەیر دەکەیت و","poem":1},{"text":"سزای بەدکاران دەبینیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەگەر یەزدانت کرد بە پەناگات،","poem":1},{"text":"هەرەبەرزت کرد بە لانەی خۆت،","poem":2}]},{"type":"verse","number":10,"content":[{"text":"هیچ خراپەت بەسەرنایەت و","poem":1},{"text":"هیچ بەڵایەک لە ماڵت نزیک ناکەوێتەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لەبەر ئەوەی سەبارەت بە تۆ فەرمان بە فریشتەکانی دەدات،","poem":1},{"text":"بۆ ئەوەی لە هەموو هەنگاوێکت بتپارێزن،","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لەسەر دەستیان هەڵتدەگرن،","poem":1},{"text":"تاکو پێت بەر بەردێک نەکەوێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"پێ بە شێر و ماری کۆبرادا دەنێیت،","poem":1},{"text":"بەچکە شێر و ئەژدیها پێشێل دەکەیت.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"یەزدان دەفەرموێت: «لەبەر ئەوەی دڵی بە منەوە بەندە، ڕزگاری دەکەم،","poem":1},{"text":"دەیپارێزم، چونکە من دەناسێت","poem":2},{"noteId":170},{"text":".","poem":2}]},{"type":"verse","number":15,"content":[{"text":"نزام بۆ دەکات، وەڵامی دەدەمەوە،","poem":1},{"text":"لە تەنگانە لەگەڵیدام،","poem":2},{"lineBreak":true},{"text":"دەربازی دەکەم و ڕێزداری دەکەم.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"بە ڕۆژگاری درێژ تێری دەکەم،","poem":1},{"text":"ڕزگاریی خۆمی نیشان دەدەم.»","poem":2}]}],"footnotes":[{"noteId":170,"caller":"+","text":"عیبری: (ناوی من دەناسێت) بە واتای ناسینی خودا و کەسایەتییەکەی.‏","reference":{"chapter":91,"verse":14}}]},"thisChapterLink":"/api/ckb_bib/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}