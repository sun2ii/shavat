{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["زەبوورێک، گۆرانییەک بۆ ڕۆژی شەممە."]},{"type":"verse","number":1,"content":[{"text":"چاکە ستایشی یەزدان بکرێت،","poem":1},{"text":"گۆرانی گوتن بۆ ناوت، ئەی هەرەبەرز،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بەیانییان خۆشەویستی نەگۆڕت ڕابگەیەنرێت و","poem":1},{"text":"دڵسۆزیت بە شەوان،","poem":2}]},{"type":"verse","number":3,"content":[{"text":"بە قیسارەی دە ژێیی،","poem":1},{"text":"بە ئاوازی ساز.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ئەی یەزدان، بە کردارەکانت دڵخۆشت کردووم،","poem":1},{"text":"هەلهەلە لێدەدەم بۆ کارەکانی دەستت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەی یەزدان، کردارەکانت چەندە مەزنە!","poem":1},{"text":"بیرکردنەوەی تۆ چەندە قووڵە!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"مرۆڤی گێل ئەمە نازانێت،","poem":1},{"text":"نەزانیش ئەمە تێناگات:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"هەرچەندە خراپەکاران وەک گیا بگەشێنەوە و","poem":1},{"text":"هەموو بەدکاران چرۆ بکەن،","poem":2},{"text":"بۆ هەتاهەتایە لەناودەچن.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"بەڵام ئەی یەزدان، تۆ هەمیشە بەرزیت.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ئەی یەزدان، دوژمنانت،","poem":1},{"text":"بێگومان دوژمنانت دەفەوتێن و","poem":2},{"lineBreak":true},{"text":"هەموو بەدکاران پەرتەوازە دەبن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"بەڵام وەک گای کێوی بەهێز بووم،","poem":1},{"text":"بە ڕۆنی گرانبەها چەور کرام.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بە چاوی خۆم بەزینی دوژمنانم دەبینم،","poem":1},{"text":"گوێم لە بەزینی ئەوانە دەبێت کە بە خراپە دژم هەستاون.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ڕاستودروستان وەک دار خورما گەشە دەکەن،","poem":1},{"text":"وەک ئورزی لوبنان گەشە دەکەن،","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لە ماڵی یەزدان ڕواون،","poem":1},{"text":"لە حەوشەی ماڵەکەی خودامان گەشە دەکەن.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"بە پیریش هەر بەریان دەبێت،","poem":1},{"text":"هەمیشە تەڕ و سەوزن،","poem":2}]},{"type":"verse","number":15,"content":[{"text":"بۆ ئەوەی ڕابگەیەنن کە یەزدان ڕاستودروستە،","poem":1},{"text":"تاشەبەردمە و خراپە لە ئەودا نییە.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}