{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"ئەی یەزدان، خودای تۆڵە،","poem":1},{"text":"ئەی خودای تۆڵە، بدرەوشێوە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئەی دادوەری زەوی، ڕاپەرە،","poem":1},{"text":"سزای لووتبەرزەکان بدەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئەی یەزدان، هەتا کەی بەدکاران،","poem":1},{"text":"هەتا کەی بەدکاران دڵشاد دەبن؟","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"بەدکاران لووتبەرزی لە قسەکانیانەوە هەڵدەقوڵێت،","poem":1},{"text":"شانازی بە خۆیانەوە دەکەن.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەی یەزدان، گەلەکەت وردوخاش دەکەن،","poem":1},{"text":"میراتی تۆ دەچەوسێننەوە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بێوەژن و نامۆ دەکوژن،","poem":1},{"text":"هەتیو سەردەبڕن.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"دەڵێن: «یەزدان نابینێت،","poem":1},{"text":"خودای یاقوب ئاگای لێ نییە.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ئەی دەبەنگەکان لەنێو گەل، وریابن!","poem":1},{"text":"ئەی گێلەکان، کەی تێدەگەن؟","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئایا ئەوەی گوێی چاندووە، نابیستێت؟","poem":1},{"text":"ئایا ئەوەی چاوی دروستکردووە، نابینێت؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ئایا ئەوەی نەتەوەکان تەمبێ دەکات، سەرزەنشت ناکات؟","poem":1},{"text":"ئایا ئەوەی فێری مرۆڤ دەکات، زانیاری نییە؟","poem":2}]},{"type":"verse","number":11,"content":[{"text":"یەزدان بیرکردنەوەی مرۆڤ دەزانێت،","poem":1},{"text":"کە پووچە.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ئەی یەزدان، خۆزگە دەخوازرێ بەو کەسەی تۆ تەمبێی دەکەیت،","poem":1},{"text":"لە تەوراتی خۆت فێری دەکەیت،","poem":2}]},{"type":"verse","number":13,"content":[{"text":"لە ڕۆژی سەختدا ئارامی بکەیتەوە،","poem":1},{"text":"هەتا گۆڕ بۆ بەدکار هەڵبکەنرێت،","poem":2}]},{"type":"verse","number":14,"content":[{"text":"چونکە یەزدان واز لە گەلی خۆی ناهێنێ،","poem":1},{"text":"میراتی خۆی ڕەت ناکاتەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"دادوەری بۆ ڕاستودروستی دەگێڕێتەوە،","poem":1},{"text":"هەموو دڵڕاستەکان شوێنی دەکەون.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"کێ بۆم لە دژی بەدکاران هەڵدەستێتەوە؟","poem":1},{"text":"کێ بۆم لە دژی خراپەکاران بوەستێتەوە؟","poem":2}]},{"type":"verse","number":17,"content":[{"text":"یەزدان هاریکارم بوو، ئەگینا هێندەی نەمابوو","poem":1},{"text":"گیانم لەنێو بێدەنگی مردووان نیشتەجێ بێت.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"کاتێک گوتم: «پێم دەخلیسکێت،»","poem":1},{"text":"ئەی یەزدان، خۆشەویستییە نەگۆڕەکەت پشتی گرتم.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"کە خەم لە ناخم زۆر بوو،","poem":1},{"text":"دڵنەوایی تۆ گیانی منی شاد کرد.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ئایا تەختی گەندەڵی هاوڕێیەتی لەگەڵ تۆ دەبەستێت،","poem":1},{"text":"ئەوانەی بەگوێرەی زۆرداری خۆیان، شێوەی یاسا دادەڕێژن؟","poem":2}]},{"type":"verse","number":21,"content":[{"text":"لە دژی گیانی ڕاستودروست کۆدەبنەوە،","poem":1},{"text":"خوێنێکی بێگەرد تاوانبار دەکەن.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"بەڵام یەزدان بۆم دەبێتە قەڵا،","poem":1},{"text":"خودا بۆم بووە بە تاشەبەردی پەناگام.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ئەو خراپەیەی دەیکەن بەسەر خۆیانیدا دەداتەوە و","poem":1},{"text":"لە سزای بەدکاری خۆیان کڕیان دەکات،","poem":2},{"lineBreak":true},{"text":"یەزدانی پەروەردگارمان کڕیان دەکات.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}