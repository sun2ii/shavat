{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"وەرن، هەلهەلە بۆ یەزدان لێبدەین،","poem":1},{"text":"هاواری شادی بکەین بۆ تاشەبەردی ڕزگاریمان.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بە ستایشەوە بچینە بەردەمی،","poem":1},{"text":"بە مۆسیقاوە هاواری شادی بۆ بکەین.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"لەبەر ئەوەی یەزدان خودایەکی گەورەیە،","poem":1},{"text":"پاشایەکی گەورەیە بەسەر هەموو خوداوەندەکانەوە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"قووڵاییەکانی زەوی بە دەستە و","poem":1},{"text":"لووتکەی شاخەکان هی ئەون.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"دەریا هی ئەوە و ئەو دروستی کردووە،","poem":1},{"text":"بە دەستی خۆی شێوەی وشکانیی پێکهێنا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"وەرن، کڕنۆشی بۆ ببەین و بیپەرستین،","poem":1},{"text":"لەبەردەم یەزدانی دروستکەرمان چۆک دابدەین،","poem":2}]},{"type":"verse","number":7,"content":[{"text":"چونکە ئەو خودامانە و","poem":1},{"text":"ئێمە گەلی لەوەڕگاکەی ئەوین،","poem":2},{"lineBreak":true},{"text":"مەڕی دەستی ئەوین.","poem":2},{"lineBreak":true},{"text":"ئەگەر ئەمڕۆ گوێتان لە فەرمایشتی یەزدان بێت کە دەفەرموێت:","poem":1}]},{"type":"verse","number":8,"content":[{"text":"«دڵی خۆتان ڕەق مەکەن وەک لە مەریبا ڕوویدا،","poem":2},{"lineBreak":true},{"text":"وەک ئەو ڕۆژە لە مەسا","poem":2},{"noteId":171},{"text":"لە بیابان،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"لەوێ باوباپیرانتان تاقییان کردمەوە،","poem":1},{"text":"هەرچەندە کردارەکانی منیان بینی،","poem":2},{"lineBreak":true},{"text":"بەڵام هەر تاقییان کردمەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"چل ساڵ لەو نەوەیە تووڕە بووم،","poem":1},{"text":"فەرمووم: ”ئەمانە گەلێکن دڵیان گومڕا بووە و","poem":2},{"lineBreak":true},{"text":"ڕێگای منیان نەناسی.“","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بۆیە لە تووڕەییمدا سوێندم خوارد:","poem":1},{"text":"”نایەنە ناو حەسانەوەی من.“»","poem":2}]}],"footnotes":[{"noteId":171,"caller":"+","text":"ناوێکی عیبرییە بە واتای تاقیکردنەوە، شوێنێکە لە چۆڵەوانی سینا، هەروەها پێی دەگوترێت مەریبا. بڕوانە ڕوونکردنەوە دەربارەی مێرگی مەریبا لە زەبوورەکان 81‏:7.‏‏ هەروەها بڕوانە دەرچوون 17‏:1‏-7.‏‏","reference":{"chapter":95,"verse":8}}]},"thisChapterLink":"/api/ckb_bib/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}