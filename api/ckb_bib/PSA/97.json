t":"ئەوانەی پەیکەر دەپەرستن شەرمەزار دەبن،","poem":1},{"text":"ئەوانەی شانازی بە بت دەکەن.","poem":2},{"lineBreak":true},{"text":"ئەی هەموو خوداوەندەکان، کڕنۆشی بۆ ببەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"سییۆن بیستی و شادمان بوو،","poem":1},{"text":"کچانی یەهودا دڵخۆش بوون،","poem":2},{"lineBreak":true},{"text":"بە حوکمەکانت، ئەی یەزدان،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"چونکە لەسەر هەموو زەوی تۆ هەرەبەرزی،","poem":1},{"text":"تۆ لە هەموو خوداوەندەکان پایەبەرزتری.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"با دۆستانی یەزدان ڕقیان لە بەدکاری ببێتەوە،","poem":1},{"text":"لەبەر ئەوەی گیانی خۆشەویستانی دەپارێزێت و","poem":2},{"lineBreak":true},{"text":"لە دەست خراپەکاران دەربازیان دەکات.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ڕووناکی لەسەر ڕاستودروستان دەدرەوشێتەوە و","poem":1},{"text":"شادییش بۆ دڵڕاستەکان.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ئەی ڕاستودروستان، بە یەزدان شاد بن،","poem":1},{"text":"ستایشی ناوە پیرۆزەکەی بکەن.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}