{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"PSA","translationId":"ckb_bib","name":"زەبوورەکان","commonName":"زەبوورەکان","title":"زەبوورەکان","order":19,"numberOfChapters":150,"sha256":"d75ce691dbb1a99dee3ca13ca78b9d45a15ff6072b288b8cd8c1c78b7514fb97","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ckb_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["زەبوورێک"]},{"type":"verse","number":1,"content":[{"text":"گۆرانی بۆ یەزدان بڵێن، گۆرانییەکی نوێ،","poem":1},{"text":"چونکە کاری سەرسوڕهێنەری کردووە.","poem":2},{"text":"دەستی ڕاست و بازووی پیرۆزی،","poem":1},{"text":"سەرکەوتنیان بۆ بەدەستهێناوە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"یەزدان ڕزگاریی خۆی ڕاگەیاند،","poem":1},{"text":"ڕاستودروستییەکەی بۆ گەلان دەرخست.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"خۆشەویستییە نەگۆڕەکەی و دڵسۆزییەکەی،","poem":1},{"text":"بەیادهێنایەوە بۆ بنەماڵەی ئیسرائیل.","poem":2},{"text":"هەموو زەوی هەتا ئەوپەڕی دنیا،","poem":1},{"text":"ڕزگاریی خودای ئێمەیان بینی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ئەی سەراپای زەوی هاواری شادی بکەن بۆ یەزدان،","poem":1},{"text":"بە دەنگی بەرز گۆرانی بڵێن و هەلهەلە لێ بدەن.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بە قیسارە مۆسیقا بۆ یەزدان بژەنن،","poem":1},{"text":"بە قیسارە و دەنگی گۆرانی.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بە زوڕنا و دەنگی کەڕەنا،","poem":1},{"text":"هاواری شادی بکەن بەرامبەر بە یەزدانی پاشا.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"با دەریا و هەرچی تێیدایە،","poem":1},{"text":"با جیهان و دانیشتووانی بخرۆشێن.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"با ڕووبارەکان چەپڵە لێبدەن و","poem":1},{"text":"هەموو چیاکان هەلهەلە لێبدەن،","poem":2}]},{"type":"verse","number":9,"content":[{"text":"لەبەردەم یەزدان،","poem":2},{"text":"چونکە دێت بۆ ئەوەی دادوەری زەوی بکات،","poem":1},{"text":"بە ڕاستودروستی دادوەری جیهان دەکات،","poem":2},{"lineBreak":true},{"text":"گەلانیش بە دادپەروەری.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}