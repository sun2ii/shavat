{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"SNG","translationId":"ckb_bib","name":"گۆرانی گۆرانییەکان","commonName":"گۆرانی گۆرانییەکان","title":"گۆرانی گۆرانییەکان","order":22,"numberOfChapters":8,"sha256":"3c919af16a16e2617949ba88ccb90b85043103d12a23e0e0152ec49038460966","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/ckb_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"من گوڵاڵە سوورەی شارۆن و","poem":1},{"text":"سەوسەنی دۆڵانم.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"وەک گوڵی سەوسەن لەناو دڕکوداڵ","poem":1},{"text":"یارەکەم ئاوایە لەناو کچان.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"وەک دار سێو لەنێو دارەکانی دارستان","poem":1},{"text":"دڵدارەکەم ئاوایە لەناو کوڕان.","poem":2},{"text":"حەزم لە دانیشتنە لە سێبەرەکەی","poem":1},{"text":"مێوەکەشی بۆ دەمم شیرینە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"با بمباتە هۆڵی خوانەکە،","poem":1},{"text":"خۆشەویستییەکەی وەک ئاڵا لەسەر سەرم بشەکێتەوە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"بە کشمیش گڕوتینم پێ ببەخشن،","poem":1},{"text":"بە سێو بمگەشێننەوە،","poem":2},{"lineBreak":true},{"text":"چونکە من بە شەیدای خۆشەویستی ئەوم.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"دەستی چەپی لەژێر سەرمە و","poem":1},{"text":"دەستی ڕاستی لە ئامێزم دەگرێت.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئەی کچانی ئۆرشەلیم، سوێندتان دەدەم،","poem":1},{"text":"بە مامز یان مێینەی ئاسکی دەشتودەر،","poem":2},{"text":"کە خۆشەویستی هەڵنەستێنن و بە ئاگای نەهێنن","poem":1},{"text":"هەتا خۆی حەز دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"گوێ بگرە! ئەوە دەنگی دڵدارەکەمە!","poem":1},{"text":"تەماشا بکە! وا دێت،","poem":2},{"text":"لەسەر چیاکان هەڵدەبەزێتەوە،","poem":1},{"text":"بەسەر گردەکاندا باز دەدات.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"دڵدارەکەم وەک ئاسک یان وەک کارمامزە،","poem":1},{"text":"وا لە پشت دیوارەکەمان ڕاوەستاوە،","poem":2},{"text":"لە دەلاقەوە سەیر دەکات،","poem":1},{"text":"لە کڵاوڕۆژنەوە","poem":2},{"noteId":0},{"text":"تەماشا دەکات.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"دڵدارەکەم قسەی کرد، پێی گوتم:","poem":1},{"text":"«یارەکەم، هەستە،","poem":2},{"lineBreak":true},{"text":"شیرینەکەم، وەرە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"تەماشا بکە، زستان تێپەڕی،","poem":1},{"text":"باران بەسەرچوو و نەما.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"گوڵ لەسەر زەوی دەرکەوت،","poem":1},{"text":"ئێستا کاتی گۆرانییە؛","poem":2},{"text":"خوێندنی کوکوختی","poem":1},{"text":"لە خاکی ئێمە دەبیسترێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"هەنجیر بەری گرتووە،","poem":1},{"text":"بۆنی بەرسیلەی مێو بڵاو بووەتەوە.","poem":2},{"text":"یارەکەم، هەستە،","poem":1},{"text":"شیرینەکەم، وەرە.»","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئەی کۆترەکەم لەناو کەلەبەری هەڵدێرەکان،","poem":1},{"text":"لە پەناگای بنارەکان،","poem":2},{"text":"با ڕوخسارت ببینم،","poem":1},{"text":"با دەنگت ببیستم،","poem":2},{"text":"چونکە دەنگت ناسکە و","poem":1},{"text":"ڕوخسارت شیرینە!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ڕێوییەکانمان بۆ ڕاو بکەن،","poem":1},{"text":"ئەو توولە ڕێوییانەی","poem":2},{"text":"ڕەزەکانمان تێکدەدەن،","poem":1},{"text":"چونکە ڕەزەکانمان پەسیرەیان گرتووە.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"دڵدارەکەم بۆ منە و منیش بۆ ئەوم،","poem":1},{"text":"لەناو گوڵە سەوسەنەکان دەلەوەڕێت.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"بەر لەوەی ڕۆژ هەڵبێت و","poem":1},{"text":"تاریکی بڕەوێتەوە،","poem":2},{"text":"ئەی دڵدارەکەم، بگەڕێوە،","poem":1},{"text":"وەک ئاسک بە،","poem":2},{"text":"یان کارمامز","poem":1},{"text":"لەسەر چیا فرە لووتکەکان.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"وەک پەنجەرەیە، دەلاقەیەکە بۆ هاتوچۆی هەوا و گەڕانەوەی تیشکی خۆر.‏","reference":{"chapter":2,"verse":9}}]},"thisChapterLink":"/api/ckb_bib/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}