{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"SNG","translationId":"ckb_bib","name":"گۆرانی گۆرانییەکان","commonName":"گۆرانی گۆرانییەکان","title":"گۆرانی گۆرانییەکان","order":22,"numberOfChapters":8,"sha256":"3c919af16a16e2617949ba88ccb90b85043103d12a23e0e0152ec49038460966","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/ckb_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"بە درێژایی شەو لەسەر نوێنەکەم","poem":1},{"text":"بەدوای ئەو کەسەدا گەڕام کە گیانم خۆشی دەوێت؛","poem":2},{"lineBreak":true},{"text":"بەدوایدا گەڕام، بەڵام نەمدۆزییەوە.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ئێستا هەڵدەستم و بەناو شاردا دەسووڕێمەوە،","poem":1},{"text":"بەناو شەقام و گۆڕەپانەکاندا","poem":2},{"text":"بەدوای ئەو کەسەدا دەگەڕێم کە گیانم خۆشی دەوێت.","poem":1},{"text":"ئیتر بەدوایدا گەڕام، بەڵام نەمدۆزییەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"تووشی ئێشکگرەکان بووم،","poem":1},{"text":"کاتێک بەناو شاردا دەگەڕان.","poem":2},{"lineBreak":true},{"text":"«ئایا ئەوەی گیانم خۆشی دەوێت ئێوە نەتانبینیوە؟»","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ئەوەندەی نەمابوو لێیان تێپەڕم","poem":1},{"text":"کاتێک ئەوەم بینییەوە کە گیانم خۆشی دەوێت.","poem":2},{"text":"گرتم و بەرمنەدا،","poem":1},{"text":"هەتا بردمە ماڵی دایکم،","poem":2},{"lineBreak":true},{"text":"بۆ ژووری ئەو کەسەی کە بە من سکپڕ ببوو.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەی کچانی ئۆرشەلیم، سوێندتان دەدەم","poem":1},{"text":"بە مامز یان مێینەی ئاسکی دەشتودەر،","poem":2},{"text":"کە خۆشەویستی هەڵنەستێنن و بە ئاگای نەهێنن","poem":1},{"text":"هەتا خۆی حەز دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ئەوە کێیە لە چۆڵەوانییەوە بەدەرکەوت،","poem":1},{"text":"وەک ستوونی دووکەڵ،","poem":2},{"text":"بە موڕ و بخوور بۆنخۆش کراوە،","poem":1},{"text":"بە هەموو بۆنوبەرامێکی بازرگانان؟","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ببینن! گالیسکەکەی سلێمانە،","poem":1},{"text":"شەست پاڵەوان دەوریان داوە","poem":2},{"lineBreak":true},{"text":"لە پاڵەوانەکانی ئیسرائیل،","poem":2}]},{"type":"verse","number":8,"content":[{"text":"هەموو شمشێر بەدەستن،","poem":1},{"text":"شارەزای جەنگن،","poem":2},{"text":"هەریەکە و شمشێرەکەی بە لاڕانیەوەیە،","poem":1},{"text":"لەبەر مەترسییەکانی شەو.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"سلێمانی پاشا گالیسکەیەکی بۆ خۆی دروستکرد","poem":1},{"text":"لە داری لوبنان.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ستوونەکانی لە زیو دروستکرد،","poem":1},{"text":"کاریتەکانی لە زێڕ.","poem":2},{"text":"بەرگی دۆشەکەکان ئەرخەوانییە،","poem":1},{"text":"ناوەوەی بە ئەوین ڕازێنراوەتەوە.","poem":2},{"text":"ئەی کچانی ئۆرشەلیم،","poem":1}]},{"type":"verse","number":11,"content":[{"text":"وەرنە دەرەوە،","poem":1},{"text":"ئەی کچانی سییۆن، ببینن.","poem":2},{"text":"سلێمانی پاشا بەو تاجەوە ببینن کە لەسەریەتی،","poem":1},{"text":"کە دایکی لەسەری نا","poem":2},{"text":"لە ڕۆژی زەماوەندی ژنهێنانی،","poem":1},{"text":"لە ڕۆژی شادی دڵی.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}