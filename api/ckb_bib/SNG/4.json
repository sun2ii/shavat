1},{"text":"،","poem":2},{"lineBreak":true},{"text":"قامیشی بۆنخۆش و دارچین،","poem":2},{"lineBreak":true},{"text":"لەگەڵ هەموو جۆرە دار بخوورێک،","poem":2},{"lineBreak":true},{"text":"موڕ و ئەلوا","poem":2},{"noteId":2},{"lineBreak":true},{"text":"لەگەڵ هەموو بۆنوبەرامەکان.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"تۆ سەرچاوەی باخچەکانیت،","poem":1},{"text":"بیری ئاوی لەبەر ڕۆیشتووی،","poem":2},{"lineBreak":true},{"text":"لێشاوە لە لوبنان دێتە خوارێ.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"هەستە، ئەی بای باکوور،","poem":1},{"text":"وەرە، ئەی بای باشوور!","poem":2},{"text":"بەسەر باخچەکەم هەڵبکەن،","poem":1},{"text":"با بۆنوبەرامی بڵاوبێتەوە،","poem":2},{"text":"بۆ ئەوەی دڵدارەکەم بێتە ناو باخچەکەی خۆی،","poem":1},{"text":"با بەروبوومە هەڵبژاردەکەی تام بکات.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"ئەو گوڵەیە کە ڕەگەکەی زەردەچەوەی لێ دروستدەکرێت.‏","reference":{"chapter":4,"verse":14}},{"noteId":2,"caller":"+","text":"ڕووەکێکی دڕکاوییە وەک سەباڕ، شلەیەکی تێدایە بۆ پێست باشە.‏","reference":{"chapter":4,"verse":14}}]},"thisChapterLink":"/api/ckb_bib/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}