{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"SNG","translationId":"ckb_bib","name":"گۆرانی گۆرانییەکان","commonName":"گۆرانی گۆرانییەکان","title":"گۆرانی گۆرانییەکان","order":22,"numberOfChapters":8,"sha256":"3c919af16a16e2617949ba88ccb90b85043103d12a23e0e0152ec49038460966","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/ckb_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"هاتمە ناو باخچەکەم، ئازیزم، بووکێ،","poem":1},{"text":"موڕ و بۆنوبەرامی خۆمم کۆکردەوە،","poem":2},{"text":"شانەی هەنگوین و هەنگوینی خۆمم خوارد،","poem":1},{"text":"شەراب و شیری خۆمم خواردەوە.","poem":2},"هاوڕێیەکان",{"text":"ئەی هاوڕێیان، بخۆن و بخۆنەوە؛","poem":1},{"text":"یاران، بە ئەوین مەست بن.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"من خەوتووم، بەڵام دڵم بێدارە!","poem":1},{"text":"دەنگی دڵدارەکەمە لە دەرگا دەدات:","poem":2},{"text":"«دەرگام بۆ بکەرەوە، دڵداری ئازیزم،","poem":1},{"text":"ئەی کۆترەکەم، ئەی بێ کەموکوڕییەکەم،","poem":2},{"text":"سەرم پڕ ئاونگ بووە،","poem":1},{"text":"ئەگریجەم پڕ شەونم.»","poem":2}]},{"type":"verse","number":3,"content":[{"text":"جلەکانم داکەندووە،","poem":1},{"text":"ئایا دەبێ دیسان لەبەری بکەمەوە؟","poem":2},{"text":"پێیەکانم شوشتووە،","poem":1},{"text":"ئایا دەبێ دیسان پیسیان بکەمەوە؟","poem":2}]},{"type":"verse","number":4,"content":[{"text":"دڵدارەکەم لە کونی دەرگاوە دەستی درێژکرد،","poem":1},{"text":"هەناوم بۆی ڕاچەنی.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"هەستام هەتا دەرگا لە دڵدارەکەم بکەمەوە،","poem":1},{"text":"دەستەکانم موڕیان لێ دەچۆڕا،","poem":2},{"text":"پەنجەکانم موڕی شل","poem":1},{"text":"لەسەر دەسکی سورگییەکە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"دەرگام بۆ دڵدارەکەم کردەوە،","poem":1},{"text":"بەڵام دڵدارەکەم بایدابووەوە و ڕۆیشتبوو.","poem":2},{"lineBreak":true},{"text":"گیانم بەدوای ئەودا دەرچوو،","poem":2},{"text":"بەدوایدا گەڕام، بەڵام نەمدۆزییەوە.","poem":1},{"text":"بانگم کرد، وەڵامی نەدامەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"تووشی ئێشکگرەکان بووم","poem":1},{"text":"کاتێک بەناو شاردا دەسووڕانەوە.","poem":2},{"text":"لێیان دام و برینداریان کردم،","poem":1},{"text":"چارۆکەکەیان لەبەر داکەندم،","poem":2},{"lineBreak":true},{"text":"ئێشکگری شووراکان","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئەی کچانی ئۆرشەلیم، سوێندتان دەدەم،","poem":1},{"text":"ئەگەر تووشی دڵدارەکەم بوون،","poem":2},{"text":"ئەمەی پێ بڵێن،","poem":1},{"text":"من بە شەیدای خۆشەویستی ئەوم.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"دڵدارەکەی تۆ چی زیاترە لە دڵداران،","poem":1},{"text":"ئەی جوانی نێو ئافرەتان؟","poem":2},{"text":"دڵدارەکەی تۆ چی زیاترە لە دڵداران،","poem":1},{"text":"کە ئاوا سوێندت داین؟","poem":2}]},{"type":"verse","number":10,"content":[{"text":"دڵدارەکەم سوور و گەشاوەیە،","poem":1},{"text":"لەناو دە هەزار کەسدا دیارە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"سەری زێڕی بێگەردە،","poem":1},{"text":"زولفی بەرداوەتەوە،","poem":2},{"lineBreak":true},{"text":"ڕەشە وەک قەلەڕەش.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"چاوەکانی وەک کۆترن","poem":1},{"text":"چاوەکانی وەک کۆترن لەسەر کانییەک،","poem":2},{"text":"کۆترەکان هێندە سپین وەکو شیر،","poem":1},{"text":"لە کەناری حەوزێک هەڵنیشتوون.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"گۆناکانی وەک باخچەی بۆندارن،","poem":1},{"text":"بۆنیان خۆشە.","poem":2},{"text":"لێوەکانی سەوسەنن،","poem":1},{"text":"موڕی شلیان لێ دەتکێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"دەستەکانی لوولەی زێڕن،","poem":1},{"text":"بە زەبەرجەد ڕازاونەتەوە،","poem":2},{"text":"لەشی عاجی تاشراوە","poem":1},{"text":"بە بەردی یاقووتی شین","poem":2},{"noteId":3},{"text":"پێچراوەتەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"قاچەکانی ستوونی مەڕمەڕن،","poem":1},{"text":"لەسەر دوو بنکەی زێڕی بێگەرد دامەزراون.","poem":2},{"text":"ڕوخساری وەک لوبنانە،","poem":1},{"text":"هەڵبژاردە وەک ئورز.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"دەمی شیرینە،","poem":1},{"text":"سەراپای خۆشەویستە.","poem":2},{"text":"ئەمە دڵدارەکەمە، ئەو ئازیزی منە،","poem":1},{"text":"ئەی کچانی ئۆرشەلیم!","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"یاقووتی شین: دەشێت لاجیوەرد بێت.‏","reference":{"chapter":5,"verse":14}}]},"thisChapterLink":"/api/ckb_bib/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}