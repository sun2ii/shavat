ەوە و","poem":1},{"text":"پرچی سەرت ئەرخەوانییە،","poem":2},{"lineBreak":true},{"text":"پاشا بەندی ئەگریجەکانە.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"چەند جوان و چەند شیرینیت،","poem":1},{"text":"ئەی ئەویندارەکەم، من بە تۆ دڵشادم!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئەم بەژنەت لە دار خورما دەچێت،","poem":1},{"text":"مەمکەکانت لە هێشوو.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"گوتم: «بەسەر دار خورما دەکەوم،","poem":1},{"text":"خۆم بە بەرهەمەکەی دەگرم.»","poem":2},{"text":"با مەمکەکانت وەک هێشووە ترێ بن،","poem":1},{"text":"بۆنی هەناسەت وەک سێو بێت،","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"دەمت وەک باشترین جۆری شەراب بێت.","poem":2},"ئەویندار",{"text":"با شەرابەکە بە ئاسانی بۆ دڵدارەکەم بڕژێت،","poem":1},{"text":"بە نەرمی بەسەر لێو و دداندا بڕوات.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"من بۆ دڵدارەکەمم و","poem":1},{"text":"ئەو پەرۆشی منە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"دڵدارەکەم، وەرە با بچینە کێڵگە،","poem":1},{"text":"لە گوندەکان شەو بەسەرببەین.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"با بەیانی زوو بگەینە سەر ڕەزەمێوەکان،","poem":1},{"text":"ببینین ئاخۆ دار مێو چەکەرەی کردووە،","poem":2},{"text":"پەسیرەکان کراونەتەوە،","poem":1},{"text":"هەناریش پشکوتووە؟","poem":2},{"lineBreak":true},{"text":"لەوێ ئەوینەکەمت پێ دەبەخشم.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"گیائادەمە","poem":1},{"noteId":6},{"text":"بۆن بڵاو دەکاتەوە،","poem":1},{"text":"لە بەردەرگاکەشمان هەموو میوەیەکی بەتام هەیە،","poem":2},{"text":"کۆن و نوێ","poem":1},{"text":"کە بۆ تۆم هەڵگرتووە، ئەی دڵدارەکەم.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":6,"caller":"+","text":"بڕوانە پەیدابوون 30‏:14‏-16.‏‏","reference":{"chapter":7,"verse":13}}]},"thisChapterLink":"/api/ckb_bib/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/SNG/8.json","nextChapterAudioLinks":{},"previous