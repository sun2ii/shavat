ێت و","poem":1},{"text":"پاڵی بە دڵدارەکەیەوە داوە؟","poem":2},"ئەویندار",{"text":"لەژێر دار سێوەکە بەئاگام هێنای،","poem":1},{"text":"لەوێ دایکت بە تۆ سک پڕ بوو،","poem":2},{"lineBreak":true},{"text":"لەوێ ئەوەی تۆی بوو سکی پێت پڕ بوو.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"بمکە مۆر لەسەر دڵت،","poem":1},{"text":"مۆر لەسەر بازووت،","poem":2},{"text":"چونکە خۆشەویستی وەک مردن بەهێزە،","poem":1},{"text":"ئیرەیی وەک گۆڕ سەختە،","poem":2},{"text":"خۆشەویستی سووتێنەرە، گڕی ئاگرە،","poem":1},{"text":"وەک ئاگرێکی بەهێزە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئاوە زۆرەکان ناتوانن خۆشەویستی بکوژێننەوە،","poem":1},{"text":"ڕووبارەکان نوقومی ناکەن.","poem":2},{"text":"ئەگەر مرۆڤ هەموو سامانی ماڵەکەی","poem":1},{"text":"لە پێناوی خۆشەویستی ببەخشێت،","poem":2},{"lineBreak":true},{"text":"بە بێبەها دادەنرێت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"خوشکێکی بچووکمان هەیە،","poem":1},{"text":"هێشتا مەمکی نەهاتووە.","poem":2},{"text":"چی بکەین بۆ خوشکمان،","poem":1},{"text":"ئەو ڕۆژەی داخوازیکەری بێت؟","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ئەگەر شوورا بێت،","poem":1},{"text":"قوللەی زیوین لەسەری بنیاد دەنێین.","poem":2},{"text":"ئەگەر دەرگا بێت،","poem":1},{"text":"بە تەختەداری ئورز دەوری دەدەین.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"من شوورام و","poem":1},{"text":"مەمکەکانم وەک قوللەن،","poem":2},{"text":"بەم جۆرە لە چاوەکانی","poem":1},{"text":"پەسەندی بەدی دەکەم.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"سلێمان ڕەزەمێوێکی هەبوو لە بەعل‌هامۆن،","poem":1},{"text":"ئەم ڕەزەمێوی دایە ڕەزەوانان،","poem":2},{"text":"هەریەکە و لەبری بەرهەمەکەی","poem":1},{"text":"هەزار شاقل","poem":2},{"noteId":7},{"text":"زیوی دەدا.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بەڵام ڕەزەمێوەکەی خۆم بە ویستی خۆمە بیبەخشم؛","poem":1},{"text":"ئەی سلێمان، هەزار شاقل بۆ تۆ بێت،","poem":2},{"lineBreak":true},{"text":"دوو سەد شاقلیش","poem":2},{"noteId":8},{"text":"بۆ ڕەزەوانەکان.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەی دانیشتووی ناو باخچەکان!","poem":1},{"text":"هاوڕێیان گوێیان لە دەنگت گرتووە،","poem":2},{"lineBreak":true},{"text":"با گوێم لێت بێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ڕابکە، دڵدارەکەم،","poem":1},{"text":"وەک ئاسک بە","poem":2},{"text":"یان وەک کارمامز","poem":1},{"text":"لەسەر ئەو چیایانەی پڕ بۆنوبەرامن.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"نزیکەی 11,5 کیلۆگرام.‏","reference":{"chapter":8,"verse":11}},{"noteId":8,"caller":"+","text":"دوو سەد شاقل نزیکەی 2,3 کیلۆگرام.‏","reference":{"chapter":8,"verse":12}}]},"thisChapterLink":"/api/ckb_bib/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}