{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ZEC","translationId":"ckb_bib","name":"زەکەریا","commonName":"زەکەریا","title":"زەکەریا","order":38,"numberOfChapters":14,"sha256":"bb576bd58e748a4c960a3b79d741b5cb105f3bb96c734d6735f456a4b373c3d5","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/ckb_bib/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["بەسەرکردنەوەی بنەماڵەی یەهودا"]},{"type":"verse","number":1,"content":[{"text":"لە بەهاردا داوای باران لە یەزدان بکەن،","poem":1},{"text":"یەزدانە کە هەورەتریشقە دروستدەکات.","poem":2},{"text":"ئەو شەستە باران دەبارێنێت،","poem":1},{"text":"کێڵگەی سەوز دەداتە هەمووان.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بتەکان قسەی هەڵخەڵەتێنەر دەکەن،","poem":1},{"text":"فاڵگرەوەکان بە درۆ باسی بینین دەکەن،","poem":2},{"text":"خەونی درۆ دەگێڕنەوە،","poem":1},{"text":"بەبێ سوود دڵنەوایی دەکەن،","poem":2},{"text":"بۆیە گەل وەک مەڕ پەرتەوازە بوون،","poem":1},{"text":"سەرگەردان بوون لەبەر بێ شوانی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"«تووڕەییم لەسەر شوانەکان گڕی گرت،","poem":1},{"text":"ڕابەرەکان سزا دەدەم،","poem":2},{"text":"چونکە یەزدانی سوپاسالار مێگەلەکەی خۆی،","poem":1},{"text":"بنەماڵەی یەهودا بەسەردەکاتەوە،","poem":2},{"lineBreak":true},{"text":"دەیانکاتە ئەسپی شکۆی خۆی لەنێو جەنگ.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"بەردی بناغە لە یەهوداوە دێت،","poem":1},{"text":"مێخی ڕەشماڵ لەوێوە دێت،","poem":2},{"lineBreak":true},{"text":"کەوانی جەنگ لەوێوە دێت،","poem":2},{"lineBreak":true},{"text":"هەموو سەرۆکێک لەوێوەیە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"پێکەوە وەک پاڵەوان دەبن،","poem":1},{"text":"ئەوانەی دوژمنەکانیان لەنێو قوڕی کۆڵانەکان دەشێلن،","poem":2},{"text":"دەجەنگن، چونکە یەزدان لەگەڵیانە،","poem":1},{"text":"ئەسپ سوارەکانی دوژمن شەرمەزار دەکەن.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«بنەماڵەی یەهودا بەهێز دەکەم،","poem":1},{"text":"بنەماڵەی یوسف ڕزگار دەکەم.","poem":2},{"text":"دەیانگەڕێنمەوە، چونکە بەزەییم پێیاندا هاتەوە،","poem":1},{"text":"وایان لێدێت وەک ئەوەی کە ڕەتم نەکردبنەوە،","poem":2},{"text":"چونکە من یەزدانی پەروەردگاری ئەوانم،","poem":1},{"text":"وەڵامیان دەدەمەوە.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئەفرایم وەک پاڵەوانەکانیان لێدێت،","poem":1},{"text":"دڵیان خۆش دەبێت هەروەک بە شەراب،","poem":2},{"text":"منداڵەکانیان ئەمە دەبینن و دڵخۆش دەبن،","poem":1},{"text":"دڵیان بە یەزدان شاد دەبێت.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ئاماژەیان بۆ دەکەم،","poem":1},{"text":"پێکەوە کۆیان دەکەمەوە.","poem":2},{"text":"بە دڵنیاییەوە دەیانکڕمەوە،","poem":1},{"text":"هەروەکو پێشتر زۆر دەبن.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"هەرچەندە لەنێو گەلاندا پەرتەوازەیان دەکەم،","poem":1},{"text":"بەڵام لە خاکە دوورەکانەوە یادم دەکەنەوە.","poem":2},{"text":"ئەوان لەگەڵ کوڕەکانیان لە ژیان دەمێننەوە و","poem":1},{"text":"دەگەڕێنەوە.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لە خاکی میسرەوە دەیانگەڕێنمەوە و","poem":1},{"text":"لە ئاشورەوە کۆیان دەکەمەوە.","poem":2},{"text":"دەیانهێنمە خاکی گلعاد و لوبنان،","poem":1},{"text":"جێیان نابێتەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"بەناو دەریای تەنگدا تێدەپەڕن،","poem":1},{"text":"شەپۆلەکانی دەریا کپ دەبن و","poem":2},{"lineBreak":true},{"text":"هەموو قووڵاییەکانی ڕووباری نیل وشک دەبن.","poem":2},{"text":"لووتبەرزی ئاشور تێکدەشکێنرێت و","poem":1},{"text":"داردەستی میسر نامێنێت.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بە یەزدان بەهێزیان دەکەم و","poem":1},{"text":"بە ناوی خۆیەوە دەیپەرستن و گوێڕایەڵی دەبن.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}