{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ZEP","translationId":"ckb_bib","name":"سەفەنیا","commonName":"سەفەنیا","title":"سەفەنیا","order":36,"numberOfChapters":3,"sha256":"1eeb3976b9c8f6a128a92e2dcec7c51de755101625fb9f06008f5a5c012f53a3","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ckb_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["پەیامی یەزدان بۆ سەفەنیای کوڕی کووشی کوڕی گەدەلیاهوی کوڕی ئەمەریای کوڕی حەزقیا، لە سەردەمی یۆشیای کوڕی ئامۆنی پاشای یەهودا:"]},{"type":"line_break"},{"type":"heading","content":["ئاگادارکردنەوە بۆ هاتنی وێرانکاری"]},{"type":"verse","number":2,"content":[{"text":"«هەموو شتێک لەسەر ڕووی زەوی","poem":1},{"text":"بە تەواوەتی دادەماڵم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"«مرۆڤ و ئاژەڵ دادەماڵم،","poem":1},{"text":"باڵندەکانی ئاسمان و","poem":2},{"lineBreak":true},{"text":"ماسییەکانی دەریا دادەماڵم.","poem":2},{"text":"بەدکاران تووشی کۆسپ دەکەم و","poem":1},{"text":"مرۆڤ لەسەر ڕووی زەوی بنبڕ دەکەم.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]},{"type":"heading","content":["پێشبینییەک سەبارەت بە یەهودا"]},{"type":"verse","number":4,"content":[{"text":"«دەستم بۆ سەر یەهودا و","poem":1},{"text":"بۆ سەر هەموو دانیشتووانی ئۆرشەلیم درێژ دەکەم.","poem":2},{"text":"ئەو بەعل پەرستانەی ماونەتەوە لەم شوێنە بنبڕیان دەکەم،","poem":1},{"text":"ناوی کاهینە بتپەرستەکان و کاهینە هەڵگەڕاوەکان،","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ئەوانەی لە سەربانەکان کڕنۆش دەبەن","poem":1},{"text":"بۆ ئەستێرەکانی ئاسمان،","poem":2},{"text":"ئەوانەی کڕنۆش دەبەن و سوێند بە یەزدان دەخۆن،","poem":1},{"text":"هەروەها سوێند بە مۆلەخیش","poem":2},{"noteId":0},{"text":"دەخۆن،","poem":2}]},{"type":"verse","number":6,"content":[{"text":"لەگەڵ ئەوانەی لە یەزدان هەڵگەڕاونەتەوە و","poem":1},{"text":"ئەوانەی ڕوو لە یەزدان ناکەن و پرسیاری لێ ناکەن.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"لەبەردەم یەزدانی باڵادەست بێدەنگ بە،","poem":1},{"text":"چونکە ڕۆژی یەزدان","poem":2},{"noteId":1},{"text":"نزیکە.","poem":2},{"text":"یەزدان قوربانی ئامادە کردووە،","poem":1},{"text":"بانگکراوانی خۆی تەرخان دەکات.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"لە ڕۆژی قوربانی یەزدان","poem":1},{"text":"میران سزا دەدەم","poem":2},{"lineBreak":true},{"text":"هەروەها کوڕانی پاشا و","poem":2},{"text":"هەموو ئەوانەی جلوبەرگی نامۆیان لەبەرە.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"لەو ڕۆژەدا هەموو ئەوانە سزا دەدەم","poem":1},{"text":"کە خۆیان لەوە دەپارێزن پێ لە سەکۆی دەروازەکە بنێن،","poem":2},{"noteId":2},{"text":"ئەوانەی پەرستگای خوداوەندەکانیان پڕ دەکەن","poem":1},{"text":"لە ستەم و فێڵبازی.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"یەزدان دەفەرموێت: «لەو ڕۆژەدا،","poem":1},{"text":"دەنگی هاوار لە دەروازەی ماسی بەرزدەبێتەوە،","poem":2},{"lineBreak":true},{"text":"ناڵەناڵ لە ”گەڕەکی نوێ“ دێت،","poem":2},{"lineBreak":true},{"text":"دەنگی تێکشکانێکی گەورەش لە گردەکانەوە.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ئەی دانیشتووانی ناوچەی مەکتیش","poem":1},{"noteId":3},{"text":"بناڵێنن،","poem":1},{"text":"هەموو بازرگانەکانتان لەناودەچن،","poem":2},{"lineBreak":true},{"text":"هەموو بازرگانەکانی زیو بنبڕ دەکرێن.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"لەو سەردەمەدا، بە چرا ئۆرشەلیم دەپشکنم و","poem":1},{"text":"ئەو کەسانە سزا دەدەم کە لەخۆڕازین،","poem":2},{"lineBreak":true},{"text":"ئەوانە وەک شەرابن بەسەر خڵتەکەیەوە،","poem":2},{"text":"لە دڵی خۆیاندا دەڵێن:","poem":1},{"text":"”یەزدان نە چاکە دەکات و نە خراپە.“","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ئەوانە سامانیان تاڵان دەکرێت،","poem":1},{"text":"ماڵیان وێران دەبێت.","poem":2},{"text":"ماڵ بنیاد دەنێن و","poem":1},{"text":"تێیدا دانانیشن؛","poem":2},{"text":"ڕەز دەچێنن و","poem":1},{"text":"لە شەرابەکەی ناخۆنەوە.","poem":2}]},{"type":"heading","content":["ڕۆژی گەورەی یەزدان"]},{"type":"verse","number":14,"content":[{"text":"«ڕۆژی گەورەی یەزدان نزیکە،","poem":1},{"text":"نزیکە و زۆر بە پەلەیە.","poem":2},{"text":"هاواری ڕۆژی یەزدان تاڵ دەبێت،","poem":1},{"text":"پاڵەوانە مەزنەکە نەعرەتەی جەنگ دەکێشێت.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەو ڕۆژە ڕۆژی تووڕەییە،","poem":1},{"text":"ڕۆژی تەنگانە و ئازارە،","poem":2},{"text":"ڕۆژی کاولبوون و وێرانییە،","poem":1},{"text":"ڕۆژی تاریکی و ئەنگوستەچاوە،","poem":2},{"lineBreak":true},{"text":"ڕۆژی هەور و تەمی چڕە،","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ڕۆژی کەڕەنا لێدان و نەعرەتەی جەنگە","poem":1},{"text":"لە دژی شارە قەڵابەندەکان و","poem":2},{"lineBreak":true},{"text":"لە دژی قوللە بەرزەکان.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«تەنگ بە مرۆڤ هەڵدەچنم،","poem":1},{"text":"وەک کوێر بە پەلکوتان دەڕۆن،","poem":2},{"lineBreak":true},{"text":"چونکە دەرهەق بە یەزدان گوناهیان کرد.","poem":2},{"text":"ئینجا خوێنیان وەک خۆڵ دەڕژێت و","poem":1},{"text":"هەناویشیان وەک زبڵ.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"نە زیو و نە زێڕەکەیان","poem":1},{"text":"ناتوانن دەربازیان بکەن،","poem":2},{"lineBreak":true},{"text":"لە ڕۆژی تووڕەیی یەزدان.","poem":2},{"lineBreak":true},{"text":"«بە ئاگری ئیرەییەکەی","poem":1},{"noteId":4},{"text":"هەموو زەوی هەڵدەلووشێت،","poem":2},{"text":"چونکە لەناوچوونێکی کتوپڕ دروستدەکات","poem":1},{"text":"بۆ هەموو دانیشتووانی زەوی.»","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"خوداوەندێکی کەنعانییە بتپەرستەکان بووە، بۆ پەرستنی هەستاون بە تێپەڕاندنی منداڵەکانیان بەناو ئاگردا. بڕوانە دووەم هەواڵی ڕۆژان 28‏:3.‏","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"ڕۆژی سزادانی گوناهباران و ڕزگارکردنی گەلی خودا.‏","reference":{"chapter":1,"verse":7}},{"noteId":2,"caller":"+","text":"باز دەدەن: نەریتێکی بتپەرستانە، بڕوانە یەکەم ساموئێل 5‏:5‏‏.‏","reference":{"chapter":1,"verse":9}},{"noteId":3,"caller":"+","text":"گەڕەکێک بووە لەناو بازاڕی گەورەی ئۆرشەلیم.‏","reference":{"chapter":1,"verse":11}},{"noteId":4,"caller":"+","text":"ئیرەیی: واتای هەڵوێستی توندی خودا بەرامبەر بە بتپەرستی، چونکە خودا دەیەوێت تەنها ئەو بپەرسترێت.‏","reference":{"chapter":1,"verse":18}}]},"thisChapterLink":"/api/ckb_bib/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}