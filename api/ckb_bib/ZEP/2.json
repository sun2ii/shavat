{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ZEP","translationId":"ckb_bib","name":"سەفەنیا","commonName":"سەفەنیا","title":"سەفەنیا","order":36,"numberOfChapters":3,"sha256":"1eeb3976b9c8f6a128a92e2dcec7c51de755101625fb9f06008f5a5c012f53a3","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ckb_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"ئەی نەتەوە بێ شەرمەکە،","poem":1},{"text":"خۆت کۆبکەرەوە، خۆت کۆبکەرەوە،","poem":2}]},{"type":"verse","number":2,"content":[{"text":"بەر لەوەی کاتی دیاریکراوتان لەدەست بچێت،","poem":1},{"text":"بەر لەوەی ئێوە وەک پوشوپەڵاشی بەردەم باتان بەسەربێت،","poem":2},{"text":"پێش ئەوەی گڕی تووڕەیی یەزدان بێتە سەرتان،","poem":1},{"text":"پێش ئەوەی ڕۆژی تووڕەیی یەزدان بێتە سەرتان.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ئەی هەموو بێفیزەکانی سەر زەوی، ڕوو لە یەزدان بکەن،","poem":1},{"text":"ئێوە ئەوانەی حوکمەکانی ئەو جێبەجێ دەکەن.","poem":2},{"text":"داوای ڕاستودروستی بکەن، داوای بێفیزی بکەن،","poem":1},{"text":"بەڵکو لە ڕۆژی تووڕەیی یەزدان دابپۆشرێن.","poem":2}]},{"type":"heading","content":["سەبارەت بە فەلەستیە"]},{"type":"verse","number":4,"content":[{"text":"غەزە چۆڵ دەکرێت و","poem":1},{"text":"ئەسقەلان وێران دەبێت،","poem":2},{"text":"ئەشدۆد لە نیوەڕۆدا کاول دەکرێت و","poem":1},{"text":"عەقرۆنیش ڕیشەکێش دەکرێت.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"قوڕبەسەر دانیشتووانی کەناری دەریا،","poem":1},{"text":"نەتەوەی کریتییەکان!","poem":2},{"text":"فەرمایشتی یەزدان لە دژی ئێوەیە،","poem":1},{"text":"ئەی کەنعان، خاکی فەلەستییەکان،","poem":2},{"text":"یەزدان دەفەرموێت: «لەناوت دەبەم،","poem":1},{"text":"کەست ناهێڵمەوە.»","poem":2}]},{"type":"verse","number":6,"content":[{"text":"کەناری دەریاش دەبێتە لەوەڕگا،","poem":1},{"text":"دەبێتە شوێنی شوانەکان، بۆ پشتیری","poem":2},{"noteId":5},{"text":"مەڕ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"دەبێتە موڵکی پاشماوەی بنەماڵەی یەهودا،","poem":1},{"text":"لەسەری دەلەوەڕێنن،","poem":2},{"lineBreak":true},{"text":"ئێواران لە ماڵەکانی ئەسقەلان لادەدەن،","poem":2},{"text":"چونکە یەزدانی پەروەردگاریان بەسەریان دەکاتەوە،","poem":1},{"text":"ڕاپێچکراوەکانیان دەگەڕێنێتەوە.","poem":2}]},{"type":"heading","content":["سەبارەت بە مۆئاب و عەمۆن"]},{"type":"verse","number":8,"content":[{"text":"«گوێم لە جنێوەکانی مۆئاب و","poem":1},{"text":"قەشمەرییەکانی عەمۆنییەکان بوو،","poem":2},{"text":"ئەوانەی جنێویان بە گەلەکەم دا و","poem":1},{"text":"هەڕەشەیان لە خاکەکەیان کرد.»","poem":2}]},{"type":"verse","number":9,"content":[{"text":"یەزدانی سوپاسالار، خودای ئیسرائیل دەفەرموێت:","poem":1},{"text":"«بە گیانی خۆم، لەبەر ئەوە","poem":2},{"text":"بێگومان مۆئاب وەک سەدۆمی لێدێت،","poem":1},{"text":"عەمۆنییەکانیش وەک عەمۆرا،","poem":2},{"text":"هەتاهەتایە دەبێتە شوێنی گەزگەزکە و","poem":1},{"text":"چاڵی خوێ و وێرانییە.","poem":2},{"text":"پاشماوەی گەلەکەم تاڵانیان دەکەن و","poem":1},{"text":"پاشماوەی نەتەوەکەم دەبنە میراتگری خاکەکەیان.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"لە بەرامبەر لووتبەرزییان ئەمەیان بەسەردێت،","poem":1},{"text":"لەبەر جنێودان و سووکایەتییان بە گەلی یەزدانی سوپاسالار.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"یەزدان ترسناک دەبێت بۆیان،","poem":1},{"text":"چونکە هەموو خوداوەندەکانی سەر زەوی تێکدەشکێنێت.","poem":2},{"text":"هەموو خەڵک هەریەکە و لە شوێنی خۆیەوە کڕنۆشی بۆ دەبەن،","poem":1},{"text":"هەریەکە و لە خاکەکەی خۆی.","poem":2}]},{"type":"heading","content":["سەبارەت بە کوش"]},{"type":"verse","number":12,"content":[{"text":"«ئێوەش ئەی کوشییەکان","poem":1},{"noteId":6},{"text":"،","poem":1},{"text":"بە شمشێری من دەکوژرێن.»","poem":2}]},{"type":"heading","content":["سەبارەت بە ئاشور"]},{"type":"verse","number":13,"content":[{"text":"دەستی بۆ باکوور درێژ دەکات و","poem":1},{"text":"ئاشوریش لەناودەبات،","poem":2},{"text":"نەینەوا وێران دەکات","poem":1},{"text":"وەک بیابان وشک دەبێت.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ئینجا لەوێدا مێگەلەکان خۆیان دەکێشنەوە،","poem":1},{"text":"هەموو جۆرە ئاژەڵێک.","poem":2},{"text":"هەم کوندەپەپووی بیابان و هەم بایەقووش،","poem":1},{"text":"لەسەر ستوونەکانی شەو بەسەردەبەن،","poem":2},{"text":"لە پەنجەرەکانیەوە دەنگیان دێت،","poem":1},{"text":"کاول بوون لە بەردەرگایە،","poem":2},{"lineBreak":true},{"text":"چونکە دار ئورزەکانی ڕووت کراونەتەوە.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ئەمە شارە دڵخۆشەکەیە","poem":1},{"text":"کە لە ئاسوودەییدا دەژیا.","poem":2},{"text":"ئەوەی لە دڵی خۆیدا دەیگوت:","poem":1},{"text":"«تەنها من، کەسی دیکە هاوتای من نییە.»","poem":2},{"text":"ئاخ، چۆن وێران بوو،","poem":1},{"text":"لانەی گیانلەبەران!","poem":2},{"text":"هەموو ئەوانەی بەلایدا تێدەپەڕن گاڵتەی پێ دەکەن و","poem":1},{"text":"فیکە لێدەدەن.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"پشتیر: گەوڕ، شوێنێکی تایبەت بووە بە پەروەردەکردنی ئاژەڵ.‏","reference":{"chapter":2,"verse":6}},{"noteId":6,"caller":"+","text":"کوش وڵاتێک بووە لە سەرووی ڕووباری نیل.‏","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/ckb_bib/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}