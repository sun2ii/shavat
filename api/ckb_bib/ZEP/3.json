{"translation":{"id":"ckb_bib","name":"Biblica® وەشانی بێبەرامبەری کوردیی سۆرانیی ستاندەر","website":"https://ebible.org/Scriptures/details.php?id=ckb","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ckb","licenseNotes":null,"shortName":"BIB","englishName":"Kurdish Sorani Bible","language":"ckb","textDirection":"rtl","sha256":"ba6ffaaa0c902e04bd819f40785907e21cd22887f24cd79f23aec41292ae41e9","availableFormats":["json"],"listOfBooksApiLink":"/api/ckb_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"کوردیی ناوەندی","languageEnglishName":"Central Kurdish"},"book":{"id":"ZEP","translationId":"ckb_bib","name":"سەفەنیا","commonName":"سەفەنیا","title":"سەفەنیا","order":36,"numberOfChapters":3,"sha256":"1eeb3976b9c8f6a128a92e2dcec7c51de755101625fb9f06008f5a5c012f53a3","firstChapterNumber":1,"firstChapterApiLink":"/api/ckb_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/ckb_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["داهاتووی ئۆرشەلیم"]},{"type":"verse","number":1,"content":[{"text":"قوڕبەسەر شاری ستەمکارەکان","poem":1},{"text":"ئەوەی یاخی بووە و گڵاوە!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"گوێی لە کەس نەگرت،","poem":1},{"text":"تەمبێ نەبوو،","poem":2},{"text":"پشتی بە یەزدان نەبەست،","poem":1},{"text":"لە خودای خۆی نزیک نەبووەوە.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"میرەکانی ناوەڕاستی شێرن دەنەڕێنن،","poem":1},{"text":"دادوەرەکانی گورگی ئێوارانن،","poem":2},{"lineBreak":true},{"text":"هیچ بۆ بەیانی ناهێڵنەوە.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"پێغەمبەرەکانی لەخۆبایین،","poem":1},{"text":"خەڵکانێکی ناپاکن،","poem":2},{"text":"کاهینەکانی پیرۆزگایان گڵاو کردووە،","poem":1},{"text":"تەوراتیان پێشێل کردووە.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"یەزدان لەو شارەدا ڕاستودروستە،","poem":1},{"text":"ناڕەوایی ئەنجام نادات.","poem":2},{"text":"بەیانییان دادپەروەرییەکەی پەیڕەو دەکات،","poem":1},{"text":"کەموکوڕی تێدا نییە،","poem":2},{"lineBreak":true},{"text":"بەڵام ستەمکار واتای سەرشۆڕی نازانێت.","poem":2}]},{"type":"heading","content":["تۆبەنەکردنی ئۆرشەلیم"]},{"type":"verse","number":6,"content":[{"text":"«نەتەوەکانم ڕیشەکێش کرد،","poem":1},{"text":"قەڵاکانیان وێران بوون،","poem":2},{"text":"شەقامەکانی ئەوانم چۆڵ کرد،","poem":1},{"text":"بەبێ ڕێبوارن،","poem":2},{"text":"شارەکانیان وێران کران،","poem":1},{"text":"بەبێ مرۆڤن، بێ دانیشتووان.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ئینجا سەبارەت بە ئۆرشەلیم گوتم:","poem":1},{"text":"”بێگومان ئیتر لێم دەترسیت و","poem":2},{"lineBreak":true},{"text":"تەمبێ دەبیت!“","poem":2},{"text":"هەتا نشینگەکەی ڕیشەکێش نەکرێت،","poem":1},{"text":"هەموو سزای خۆم بەسەریدا ناسەپێنم.","poem":2},{"text":"بەڵام چالاک بوون","poem":1},{"text":"لە گەندەڵکردنی هەموو کردەوەکانیان.»","poem":2}]},{"type":"verse","number":8,"content":[{"text":"یەزدان دەفەرموێت: «لەبەر ئەوە چاوەڕێم بکەن،","poem":1},{"text":"هەتا ئەو ڕۆژەی هەڵدەستم بۆ شایەتیدان،","poem":2},{"text":"چونکە بڕیارم دا نەتەوەکان کۆبکەمەوە،","poem":1},{"text":"پاشایەتییەکان خڕبکەمەوە،","poem":2},{"text":"بۆ ئەوەی هەڵچوونم بەسەریاندا هەڵبڕێژم،","poem":1},{"text":"هەموو گڕی تووڕەییم،","poem":2},{"text":"بە ئاگری ئیرەییم","poem":1},{"text":"هەموو زەوی هەڵدەلووشێت.","poem":2}]},{"type":"heading","content":["چاکسازی پاشماوەی ئیسرائیل"]},{"type":"verse","number":9,"content":[{"text":"«ئینجا لێوی هەموو گەلان پاک دەکەمەوە،","poem":1},{"text":"هەتا هەموویان بە ناوی یەزدانەوە نزا بکەن،","poem":2},{"lineBreak":true},{"text":"تاکو هاوشانی یەکتر خزمەتی بکەن.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"لەوبەری ڕووبارەکانی کوشەوە","poem":1},{"text":"ئەوانەی دەمپەرستن، گەلە پەرتوبڵاوکراوەکەم،","poem":2},{"lineBreak":true},{"text":"دیارییەکانم پێشکەش دەکەن.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"لەو ڕۆژەدا بەهۆی کردەوەکانت سەرشۆڕ نابیت","poem":1},{"text":"کە پێیان لە من یاخی بوویت،","poem":2},{"text":"چونکە من لەم شارە دایاندەماڵم،","poem":1},{"text":"ئەوانەی بە لووتبەرزییان دڵخۆشن.","poem":2},{"text":"ئیتر ناگەڕێیتەوە بۆ سەر لووت بەرزی","poem":1},{"text":"لە کێوی پیرۆزم.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"بەڵام گەلێکت تێدا دەهێڵمەوە","poem":1},{"text":"سادە و ساکار،","poem":2},{"lineBreak":true},{"text":"پشت بە ناوی یەزدان دەبەستێت.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"پاشماوەی ئیسرائیلیش چیدی خراپە ناکەن،","poem":1},{"text":"درۆ ناکەن،","poem":2},{"lineBreak":true},{"text":"لە دەمیاندا زمانی هەڵخەڵەتێنەر نامێنێت،","poem":2},{"text":"چونکە بە ئاسوودەیی دەخۆن و ڕادەکشێن،","poem":1},{"text":"کەسیش نییە بیانترسێنێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ئەی سییۆنی کچ، گۆرانی بڵێ،","poem":1},{"text":"ئەی ئیسرائیل، هاواری خۆشی بکە!","poem":2},{"text":"بە هەموو دڵتەوە شادمان و دڵخۆشبە،","poem":1},{"text":"ئەی ئۆرشەلیمی کچ!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"یەزدان سزاکەی تۆی داماڵی،","poem":1},{"text":"دوژمنەکەت کشایەوە.","poem":2},{"text":"یەزدان، پاشای ئیسرائیل، لەگەڵ تۆیە،","poem":1},{"text":"جارێکی دیکە لە خراپە ناترسیت.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"لەو ڕۆژەدا بە ئۆرشەلیم دەگوترێت:","poem":1},{"text":"«ئەی سییۆن مەترسە،","poem":2},{"lineBreak":true},{"text":"دەستت شل مەکە.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"یەزدانی پەروەردگارت لەگەڵتدایە،","poem":1},{"text":"لە ڕزگارکردن قارەمانە.","poem":2},{"text":"بە شادییەوە پێت دڵخۆش دەبێت،","poem":1},{"text":"لەناو خۆشەویستییەکەی دەتبووژێنێتەوە،","poem":2},{"lineBreak":true},{"text":"بە گۆرانییەوە پێت شاد دەبێت.»","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«ئەوانەی بۆ نەمانی جەژن دەگریێن","poem":1},{"text":"لە تۆ دایاندەماڵم،","poem":2},{"lineBreak":true},{"text":"لەمەودوا شەرمەزاری هەڵناگریت.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"لەو کاتەدا من سزایان دەدەم","poem":1},{"text":"هەموو ئەوانەی زەلیلیان کردیت؛","poem":2},{"text":"شەلەکە ڕزگار دەکەم و","poem":1},{"text":"ئەوانەی دوورخراوبوونەوە کۆیان دەکەمەوە.","poem":2},{"text":"ستایش و ناوبانگیان پێ دەبەخشم","poem":1},{"text":"لە هەموو خاکێک کە شەرمەزار بوون.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"لەو کاتەدا کۆتان دەکەمەوە،","poem":1},{"text":"لەو کاتەدا دەتانگەڕێنمەوە خاکی خۆتان.","poem":2},{"text":"ستایش و ناوبانگتان پێ دەبەخشم","poem":1},{"text":"لەنێو هەموو گەلانی زەوی،","poem":2},{"text":"کاتێک ڕاپێچکراوەکانتان و بەختیاریتان","poem":1},{"text":"لەبەرچاوتان دەگەڕێنمەوە.»","poem":2},{"text":"ئەوە فەرمایشتی یەزدانە.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/ckb_bib/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ckb_bib/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ckb_bib/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}