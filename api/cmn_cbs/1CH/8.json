{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"1CH","translationId":"cmn_cbs","name":"历代志上","commonName":"历代志上","title":"历代志上","order":13,"numberOfChapters":29,"sha256":"fc4564236e3ad71076ed44b678c67d6581a3c5d084477a871eeffdf3670ae182","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cmn_cbs/1CH/29.json","totalNumberOfVerses":938},"chapter":{"number":8,"content":[{"type":"heading","content":["便雅悯的后裔"]},{"type":"verse","number":1,"content":["便雅悯的长子是比拉，次子是亚实别，三子是亚哈拉，"]},{"type":"verse","number":2,"content":["四子是挪哈，五子是拉法。"]},{"type":"verse","number":3,"content":["比拉的儿子是亚大、基拉、亚比忽、"]},{"type":"verse","number":4,"content":["亚比书、乃幔、亚何亚、"]},{"type":"verse","number":5,"content":["基拉、示孚汛、户兰。"]},{"type":"verse","number":6,"content":["以忽的儿子是乃幔、亚希亚和基拉，他们是迦巴居民的族长，后来被掳到了玛拿辖。基拉是乌撒和亚希忽的父亲。"]},{"type":"verse","number":8,"content":["沙哈连休了妻子户伸和巴拉，后来在摩押与妻子贺得生了约巴、洗比雅、米沙、玛拉干、"]},{"type":"verse","number":10,"content":["耶乌斯、沙迦、米玛。这些儿子都是族长。"]},{"type":"verse","number":11,"content":["户伸给沙哈连生的儿子是亚比突和以利巴力。"]},{"type":"verse","number":12,"content":["以利巴力的儿子是希伯、米珊和沙麦。沙麦建立了阿挪和罗德两座城及其周围的村庄。"]},{"type":"verse","number":13,"content":["以利巴力另外的两个儿子比利亚和示玛是亚雅仑居民的族长，他们赶走了迦特人。"]},{"type":"verse","number":14,"content":["亚希约、沙煞、耶利末、"]},{"type":"verse","number":15,"content":["西巴第雅、亚拉得、亚得、"]},{"type":"verse","number":16,"content":["米迦勒、伊施巴和约哈都是比利亚的儿子。"]},{"type":"verse","number":17,"content":["西巴第雅、米书兰、希西基、希伯、"]},{"type":"verse","number":18,"content":["伊施米莱、伊斯利亚和约巴都是以利巴力的儿子。"]},{"type":"verse","number":19,"content":["雅金、细基利、撒底、"]},{"type":"verse","number":20,"content":["以利乃、洗勒太、以利业、"]},{"type":"verse","number":21,"content":["亚大雅、比拉雅和申拉都是示每的儿子。"]},{"type":"verse","number":22,"content":["伊施班、希伯、以利业、"]},{"type":"verse","number":23,"content":["亚伯顿、细基利、哈难、"]},{"type":"verse","number":24,"content":["哈拿尼雅、以拦、安陀提雅、"]},{"type":"verse","number":25,"content":["伊弗底雅和毗努伊勒都是沙煞的儿子。"]},{"type":"verse","number":26,"content":["珊示莱、示哈利、亚他利雅、"]},{"type":"verse","number":27,"content":["雅利西、以利亚和细基利都是耶罗罕的儿子。"]},{"type":"verse","number":28,"content":["按照家谱记载，以上这些人都是族长，住在耶路撒冷。"]},{"type":"verse","number":29,"content":["耶利建立了基遍城",{"noteId":6},"，定居在那里，他妻子名叫玛迦。"]},{"type":"verse","number":30,"content":["他的长子是亚伯顿，其他儿子还有苏珥、基士、巴力、拿答、"]},{"type":"verse","number":31,"content":["基多、亚希约、撒迦和米基罗。"]},{"type":"verse","number":32,"content":["米基罗是示米暗的父亲。这些人也住在耶路撒冷，与他们的亲族为邻。"]},{"type":"verse","number":33,"content":["尼珥生基士，基士生扫罗，扫罗生约拿单、麦基舒亚、亚比拿达和伊施·巴力。"]},{"type":"verse","number":34,"content":["约拿单生米力·巴力，米力·巴力生米迦，"]},{"type":"verse","number":35,"content":["米迦生毗敦、米勒、他利亚、亚哈斯，"]},{"type":"verse","number":36,"content":["亚哈斯生耶何阿达，耶何阿达生亚拉篾、亚斯玛威和心利，心利生摩撒，"]},{"type":"verse","number":37,"content":["摩撒生比尼亚，比尼亚生拉法，拉法生以利亚萨，以利亚萨生亚悉。"]},{"type":"verse","number":38,"content":["亚悉有六个儿子，他们是亚斯利干、波基路、以实玛利、示亚利雅、俄巴底雅和哈难。这些都是亚悉的儿子。"]},{"type":"verse","number":39,"content":["亚悉的兄弟以设的儿子有长子乌兰，次子耶乌施，三子以利法列。"]},{"type":"verse","number":40,"content":["乌兰的儿子都是善射的英勇战士。他们子孙昌盛，共有一百五十人。以上都是便雅悯支派的人。"]}],"footnotes":[{"noteId":6,"caller":"+","text":"“耶利建立了基遍城”或译“基遍之父耶利”。","reference":{"chapter":8,"verse":29}}]},"thisChapterLink":"/api/cmn_cbs/1CH/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/1CH/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/1CH/7.json","previousChapterAudioLinks":{},"numberOfVerses":38}