{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"2SA","translationId":"cmn_cbs","name":"撒母耳记下","commonName":"撒母耳记下","title":"撒母耳记下","order":10,"numberOfChapters":24,"sha256":"6793e57d78aab8e763fdcd7b823538ed0ee7354b0cb1861e13c9e55350dc46e4","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/cmn_cbs/2SA/24.json","totalNumberOfVerses":689},"chapter":{"number":22,"content":[{"type":"heading","content":["大卫的颂歌"]},{"type":"verse","number":1,"content":["耶和华从扫罗及所有仇敌手中拯救大卫那天，他向耶和华吟唱此诗："]},{"type":"verse","number":2,"content":[{"text":"“耶和华是我的磐石，","poem":1},{"lineBreak":true},{"text":"我的堡垒，我的拯救者；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的上帝是庇护我的磐石，","poem":1},{"lineBreak":true},{"text":"是我的盾牌，是拯救我的力量，","poem":1},{"lineBreak":true},{"text":"是我的坚垒，我的避难所，","poem":1},{"lineBreak":true},{"text":"我的救主。","poem":1},{"lineBreak":true},{"text":"你救我脱离残暴之徒。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我求告当受颂赞的耶和华，","poem":1},{"lineBreak":true},{"text":"祂便救我脱离仇敌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“死亡的波涛环绕我，","poem":1},{"lineBreak":true},{"text":"毁灭的狂流淹没我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"阴间的绳索捆绑我，","poem":1},{"lineBreak":true},{"text":"死亡的网罗笼罩我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“我在苦难中呼求耶和华，","poem":1},{"lineBreak":true},{"text":"向我的上帝求助，","poem":1},{"lineBreak":true},{"text":"祂从殿中垂听我的呼求，","poem":1},{"lineBreak":true},{"text":"我的声音达到祂耳中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“祂一发怒，大地震动颤抖，","poem":1},{"lineBreak":true},{"text":"穹苍的根基摇晃。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂的鼻孔冒烟，","poem":1},{"lineBreak":true},{"text":"口喷烈焰和火炭。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂使穹苍低垂，亲自降临，","poem":1},{"lineBreak":true},{"text":"脚下踩着密云。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂乘着基路伯天使飞翔，","poem":1},{"lineBreak":true},{"text":"在风的翅膀上显现。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂藏身于黑暗中，","poem":1},{"lineBreak":true},{"text":"四围以密云作幔幕。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂面前的荣光中发出道道闪电。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华在天上打雷，","poem":1},{"lineBreak":true},{"text":"至高者发出声音。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂射出利箭驱散仇敌，","poem":1},{"lineBreak":true},{"text":"发出闪电击溃他们。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华斥责一声，","poem":1},{"lineBreak":true},{"text":"祂的鼻孔一吹气，","poem":1},{"lineBreak":true},{"text":"海底就显现，","poem":1},{"lineBreak":true},{"text":"大地也露出根基。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“祂从高天伸手抓住我，","poem":1},{"lineBreak":true},{"text":"从大水中把我拉上来。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂救我脱离强敌，","poem":1},{"lineBreak":true},{"text":"脱离我无法战胜的仇敌。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他们在我危难之时攻击我，","poem":1},{"lineBreak":true},{"text":"但耶和华扶持我。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"祂领我到宽阔之地；","poem":1},{"lineBreak":true},{"text":"祂搭救我，因为祂喜悦我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“耶和华因我公义而善待我，","poem":1},{"lineBreak":true},{"text":"因我清白而赏赐我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为我遵行祂的道，","poem":1},{"lineBreak":true},{"text":"没有作恶背弃我的上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“我遵守祂的一切法令，","poem":1},{"lineBreak":true},{"text":"没有把祂的律例弃置一旁。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我在祂面前纯全无过，","poem":1},{"lineBreak":true},{"text":"没有沾染罪恶。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"耶和华按我的公义，","poem":1},{"lineBreak":true},{"text":"照我在祂面前的清白奖赏我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“仁慈的人，你以仁慈待他；","poem":1},{"lineBreak":true},{"text":"纯全的人，你以纯全待他。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"纯洁的人，你以纯洁待他；","poem":1},{"lineBreak":true},{"text":"乖谬的人，你以计谋待他。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你拯救谦卑的人，","poem":1},{"lineBreak":true},{"text":"鉴察、贬抑高傲的人。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"耶和华啊！你是我的明灯，","poem":1},{"lineBreak":true},{"text":"你使我的黑暗变为光明。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我靠着你迎战敌军，","poem":1},{"lineBreak":true},{"text":"靠着我的上帝跃过墙垣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“上帝的道完美，","poem":1},{"lineBreak":true},{"text":"耶和华的话纯全，","poem":1},{"lineBreak":true},{"text":"祂是一切投靠祂之人的盾牌。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"除了耶和华，谁是上帝呢？","poem":1},{"lineBreak":true},{"text":"除了我们的上帝，谁是磐石呢？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"上帝是我的坚固堡垒，","poem":1},{"lineBreak":true},{"text":"祂使我行为纯全。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"祂使我的脚如母鹿的蹄，","poem":1},{"lineBreak":true},{"text":"稳踏在高处。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"祂训练我的手如何争战，","poem":1},{"lineBreak":true},{"text":"使我的臂膀能拉开铜弓。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"你是拯救我的盾牌，","poem":1},{"lineBreak":true},{"text":"你的垂顾使我强大。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"你使我脚下的道路宽阔，","poem":1},{"lineBreak":true},{"text":"不致滑倒。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"我追赶仇敌，击溃他们，","poem":1},{"lineBreak":true},{"text":"不消灭他们决不回头。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"我打垮他们，","poem":1},{"lineBreak":true},{"text":"使他们倒在我的脚下，","poem":1},{"lineBreak":true},{"text":"再也站不起来。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"你赐我征战的能力，","poem":1},{"lineBreak":true},{"text":"使我的仇敌降服在我脚下。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"你使我的仇敌败逃，","poem":1},{"lineBreak":true},{"text":"我歼灭了恨我的人。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"他们呼救，却无人拯救。","poem":1},{"lineBreak":true},{"text":"他们呼求耶和华，祂也不应允。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"我把他们打得粉碎，如同地上的灰尘，","poem":1},{"lineBreak":true},{"text":"压碎并践踏他们，如同街上的泥土。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"你救我脱离我百姓的攻击，","poem":1},{"lineBreak":true},{"text":"立我做列国的元首，","poem":1},{"lineBreak":true},{"text":"素不相识的民族也服侍我。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"外族人望风而降，对我俯首称臣。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"他们闻风丧胆，","poem":1},{"lineBreak":true},{"text":"战战兢兢地走出他们的城池。","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“耶和华永远活着，","poem":1},{"lineBreak":true},{"text":"我的磐石当受颂赞，","poem":1},{"lineBreak":true},{"text":"拯救我的磐石，我的上帝当受尊崇。","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"祂是为我申冤的上帝，","poem":1},{"lineBreak":true},{"text":"祂使列邦臣服于我。","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"祂救我脱离仇敌，","poem":1},{"lineBreak":true},{"text":"使我胜过强敌，","poem":1},{"lineBreak":true},{"text":"救我脱离残暴之徒。","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"因此，耶和华啊，","poem":1},{"lineBreak":true},{"text":"我要在列邦中赞美你，","poem":1},{"lineBreak":true},{"text":"歌颂你的名。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"你使你立的王大获全胜，","poem":1},{"lineBreak":true},{"text":"向你膏立的大卫及其后代广施慈爱，","poem":1},{"lineBreak":true},{"text":"直到永远。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}