{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"AMO","translationId":"cmn_cbs","name":"阿摩司书","commonName":"阿摩司书","title":"阿摩司书","order":30,"numberOfChapters":9,"sha256":"aea65afe0e5862ee36486d1d8f71c20a1bc4c3aa5415828aa0c58b4c80057d03","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cmn_cbs/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"heading","content":["对摩押的审判"]},{"type":"verse","number":1,"content":[{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"“摩押人三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不收回对他们的惩罚，","poem":1},{"lineBreak":true},{"text":"因为他们把以东王的骸骨焚烧成灰。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"所以，我要降火在摩押，","poem":1},{"lineBreak":true},{"text":"烧毁加略的城堡。","poem":1},{"lineBreak":true},{"text":"摩押要在战争的喧嚣、呐喊和号角声中灭亡。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我要铲除摩押的首领，","poem":1},{"lineBreak":true},{"text":"杀死那里所有的官长。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。”","poem":1}]},{"type":"heading","content":["对犹大的审判"]},{"type":"verse","number":4,"content":[{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"“犹大人三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不收回对他们的惩罚，","poem":1},{"lineBreak":true},{"text":"因为他们厌弃耶和华的训诲，","poem":1},{"lineBreak":true},{"text":"不遵守我的律例。","poem":1},{"lineBreak":true},{"text":"他们祖先祭拜的偶像使他们走入歧途。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"所以，我要降火在犹大，","poem":1},{"lineBreak":true},{"text":"烧毁耶路撒冷的城堡。”","poem":1}]},{"type":"heading","content":["对以色列的审判"]},{"type":"verse","number":6,"content":[{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"“以色列人三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不收回对他们的惩罚，","poem":1},{"lineBreak":true},{"text":"因为他们为了银子卖掉义人，","poem":1},{"lineBreak":true},{"text":"为了一双鞋卖掉穷人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们践踏穷人如同践踏地上的尘土，","poem":1},{"lineBreak":true},{"text":"使卑微的人无处申冤；","poem":1},{"lineBreak":true},{"text":"父子同淫一女，亵渎我的圣名。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"在每座祭坛旁边，","poem":1},{"lineBreak":true},{"text":"他们把穷人抵押的衣服铺开，躺在上面，","poem":1},{"lineBreak":true},{"text":"又在上帝的殿里喝剥削来的酒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“以色列人啊，","poem":1},{"lineBreak":true},{"text":"我在你们面前消灭了亚摩利人。","poem":1},{"lineBreak":true},{"text":"虽然他们像香柏树那样高大，","poem":1},{"lineBreak":true},{"text":"如橡树那样强壮，","poem":1},{"lineBreak":true},{"text":"但我灭尽了他们上面的果子，","poem":1},{"lineBreak":true},{"text":"砍断了他们下面的根。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我曾带你们出埃及，","poem":1},{"lineBreak":true},{"text":"在旷野引导你们四十年，","poem":1},{"lineBreak":true},{"text":"使你们得到亚摩利人的土地。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我从你们的子孙中兴起先知，","poem":1},{"lineBreak":true},{"text":"从你们的青年中兴起拿细耳人","poem":1},{"noteId":2},{"text":"。","poem":1},{"lineBreak":true},{"text":"以色列人啊，难道不是这样吗？","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"可是，你们迫使拿细耳人喝酒，","poem":1},{"lineBreak":true},{"text":"禁止先知说预言。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"看啊，我要压碎你们，","poem":1},{"lineBreak":true},{"text":"如满载谷物的车轧过一样。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"快捷的无法逃遁，","poem":1},{"lineBreak":true},{"text":"强壮的无力可使，","poem":1},{"lineBreak":true},{"text":"勇猛的救不了自己，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"拉弓的站立不住，","poem":1},{"lineBreak":true},{"text":"腿快的无法逃脱，","poem":1},{"lineBreak":true},{"text":"骑马的不能自救。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"到那日，最勇猛的战士也要赤身逃命。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"拿细耳人的详情参见民数记6:1‑8。","reference":{"chapter":2,"verse":11}}]},"thisChapterLink":"/api/cmn_cbs/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}