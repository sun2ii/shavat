{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cbs","name":"传道书","commonName":"传道书","title":"传道书","order":21,"numberOfChapters":12,"sha256":"3f5b39eb02d7a1d6766cabadd5a21eb777a96ecc4aafa2082814665aaa8ba329","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cbs/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":1,"content":[{"type":"heading","content":["万事虚空"]},{"type":"verse","number":1,"content":["以下是在耶路撒冷做王的大卫之子传道者的话。"]},{"type":"verse","number":2,"content":[{"text":"传道者说：虚空的虚空，","poem":1},{"lineBreak":true},{"text":"虚空的虚空，一切都是虚空。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人在日光之下的一切劳碌有什么益处呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"一代过去，一代又来，","poem":1},{"lineBreak":true},{"text":"大地却永远长存。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"太阳升起，太阳落下，","poem":1},{"lineBreak":true},{"text":"匆忙回到升起之地。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"风吹向南，又转向北，","poem":1},{"lineBreak":true},{"text":"循环不息，周而复始。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"江河涌流入海，海却不会满溢；","poem":1},{"lineBreak":true},{"text":"江河从何处流出，又返回何处。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"万事令人厌烦，人述说不尽。","poem":1},{"lineBreak":true},{"text":"眼看，看不饱；","poem":1},{"lineBreak":true},{"text":"耳听，听不够。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"以往发生的事，将来还会发生；","poem":1},{"lineBreak":true},{"text":"先前做过的事，将来也必再做。","poem":1},{"lineBreak":true},{"text":"日光之下，根本没有新事。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"人可以指着哪件事说","poem":1},{"lineBreak":true},{"text":"“看啊，这是新事”？","poem":1},{"lineBreak":true},{"text":"所谓的新事在我们以前早就有了。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"过去的事无人记得，","poem":1},{"lineBreak":true},{"text":"将来的事后人也不记得。","poem":1}]},{"type":"heading","content":["智慧之虚空"]},{"type":"verse","number":12,"content":["我传道者曾在耶路撒冷做以色列的王。"]},{"type":"verse","number":13,"content":["我专心用智慧去研究、探索天下万事，发现上帝给世人的是极重的苦工。"]},{"type":"verse","number":14,"content":["我观察一切日光之下所做的事，看啊，都是虚空，好像捕风。"]},{"type":"verse","number":15,"content":["弯曲的不能变直，缺少的无法补足",{"noteId":0},"。"]},{"type":"verse","number":16,"content":["我心里想：“我获得极大的智慧，远超过以前统治耶路撒冷的人。我拥有丰富的智慧和知识。”"]},{"type":"verse","number":17,"content":["我又专心察明智慧和知识、狂妄和愚昧，却发现这也是捕风。"]},{"type":"verse","number":18,"content":["因为智慧越高，愁烦越多；知识越多，痛苦越深。"]}],"footnotes":[{"noteId":0,"caller":"+","text":"“补足”希伯来文是“数算”。","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/cmn_cbs/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}