{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cbs","name":"传道书","commonName":"传道书","title":"传道书","order":21,"numberOfChapters":12,"sha256":"3f5b39eb02d7a1d6766cabadd5a21eb777a96ecc4aafa2082814665aaa8ba329","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cbs/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"死苍蝇会使芬芳的膏油发臭，","poem":1},{"lineBreak":true},{"text":"同样，一点点愚昧足以毁掉智慧和尊荣。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"智者的心引导他走正路，","poem":1},{"lineBreak":true},{"text":"愚人的心带领他入歧途。","poem":1},{"noteId":5}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愚人走路时也无知，","poem":1},{"lineBreak":true},{"text":"向众人显出他的愚昧。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"如果当权的人向你大发雷霆，","poem":1},{"lineBreak":true},{"text":"不要因此就离开岗位，","poem":1},{"lineBreak":true},{"text":"因为平心静气能避免大错。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我发现日光之下有一件可悲的事，","poem":1},{"lineBreak":true},{"text":"似乎是掌权者所犯的错误：","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愚人身居许多高位，","poem":1},{"lineBreak":true},{"text":"富人却屈居在下。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我曾看见奴仆骑在马上，","poem":1},{"lineBreak":true},{"text":"王子却像奴仆一样步行。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"挖掘陷阱的，自己必掉在其中；","poem":1},{"lineBreak":true},{"text":"拆围墙的，必被蛇咬；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"开凿石头的，必被石头砸伤；","poem":1},{"lineBreak":true},{"text":"劈木头的，必遭木头的威胁。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"斧头钝了若不磨利，","poem":1},{"lineBreak":true},{"text":"用起来必多费力气，","poem":1},{"lineBreak":true},{"text":"但智慧能助人成功。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"弄蛇人行法术之前，","poem":1},{"lineBreak":true},{"text":"若先被蛇咬，","poem":1},{"lineBreak":true},{"text":"行法术还有什么用呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"智者口出恩言，","poem":1},{"lineBreak":true},{"text":"愚人的话毁灭自己。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"愚人开口是愚昧，","poem":1},{"lineBreak":true},{"text":"闭口是邪恶狂妄。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"愚人高谈阔论，","poem":1},{"lineBreak":true},{"text":"其实无人知道将来的事，","poem":1},{"lineBreak":true},{"text":"人死后，谁能告诉他世间的事呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愚人因劳碌而筋疲力尽，","poem":1},{"lineBreak":true},{"text":"连进城的路也认不出来。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"一国之君若年幼无知，","poem":1},{"lineBreak":true},{"text":"他的臣宰清早便宴乐，","poem":1},{"lineBreak":true},{"text":"那国就有祸了！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"一国之君若英明尊贵，","poem":1},{"lineBreak":true},{"text":"他的臣宰为了强身而饮食有律，","poem":1},{"lineBreak":true},{"text":"不酗酒宴乐，那国就有福了！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"屋顶因人懒惰而坍塌，","poem":1},{"lineBreak":true},{"text":"房间因人游手好闲而漏雨。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"宴席带来欢笑，","poem":1},{"lineBreak":true},{"text":"酒使人开怀，","poem":1},{"lineBreak":true},{"text":"钱使人万事亨通。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"不可咒诅君王，","poem":1},{"lineBreak":true},{"text":"连这样的意念都不可有，","poem":1},{"lineBreak":true},{"text":"也不可在卧室里咒诅富豪，","poem":1},{"lineBreak":true},{"text":"因为天空的飞鸟会通风报信，","poem":1},{"lineBreak":true},{"text":"有翅膀的会把事情四处传开。","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"这一节希伯来文是“智者的心在右，愚人的心在左。”","reference":{"chapter":10,"verse":2}}]},"thisChapterLink":"/api/cmn_cbs/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}