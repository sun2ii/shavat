{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cbs","name":"传道书","commonName":"传道书","title":"传道书","order":21,"numberOfChapters":12,"sha256":"3f5b39eb02d7a1d6766cabadd5a21eb777a96ecc4aafa2082814665aaa8ba329","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cbs/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":3,"content":[{"type":"heading","content":["万物有时"]},{"type":"verse","number":1,"content":[{"text":"天下万物都有定期，","poem":1},{"lineBreak":true},{"text":"凡事都有定时。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"出生有时，死亡有时；","poem":1},{"lineBreak":true},{"text":"耕种有时，拔出有时；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"杀戮有时，医治有时；","poem":1},{"lineBreak":true},{"text":"拆毁有时，建造有时；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"哭泣有时，欢笑有时；","poem":1},{"lineBreak":true},{"text":"哀伤有时，雀跃有时；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"抛石有时，堆石有时","poem":1},{"noteId":1},{"text":"；","poem":1},{"lineBreak":true},{"text":"拥抱有时，避开有时；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"寻找有时，遗失有时；","poem":1},{"lineBreak":true},{"text":"保存有时，丢弃有时；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"撕裂有时，缝合有时；","poem":1},{"lineBreak":true},{"text":"沉默有时，发言有时；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"爱慕有时，憎恶有时；","poem":1},{"lineBreak":true},{"text":"争战有时，和好有时。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":["那么，人劳碌做工有什么益处呢？"]},{"type":"verse","number":10,"content":["我察觉上帝给世人重担，使他们忙碌不休。"]},{"type":"verse","number":11,"content":["祂使万事各按其时变得美好，又把永恒的意识放在人心里，人却不能测透上帝从始至终的作为。"]},{"type":"verse","number":12,"content":["我认识到，人生在世没有什么比欢乐、享受更好。"]},{"type":"verse","number":13,"content":["人人都该吃喝、享受自己劳苦的成果，这是上帝的恩赐。"]},{"type":"verse","number":14,"content":["我知道，上帝所做的都会存到永远，谁也不能增减。祂这样安排是叫人敬畏祂。"]},{"type":"verse","number":15,"content":["现在的事并不是新事，未来的事也早已发生过。上帝使过去的事再次出现。"]},{"type":"heading","content":["世间的不公"]},{"type":"verse","number":16,"content":["我又看到日光之下，即使在公道和正义之地也有邪恶。"]},{"type":"verse","number":17,"content":["我心里想：“不论义人或恶人，上帝必审判，因为万事万务都有定时。”"]},{"type":"verse","number":18,"content":["我又想：“至于世人，上帝试验他们，是要他们知道自己与兽类无异。"]},{"type":"verse","number":19,"content":["因为人和兽的际遇并无分别，两者都难逃一死，活着都靠一口气。人并不比兽强，一切都是虚空。"]},{"type":"verse","number":20,"content":["两者都同归一处，出于尘土，也归于尘土。"]},{"type":"verse","number":21,"content":["谁知道人的气息",{"noteId":2},"会向上升，兽的气息会降到地下呢？”"]},{"type":"verse","number":22,"content":["因此，我觉得没有什么比人享受工作之乐更好，因为这是人当得的。人死后，谁能使他看到世间的事呢？"]}],"footnotes":[{"noteId":1,"caller":"+","text":"“抛石有时，堆石有时”意义不明，有犹太拉比说是“同房有时，分房有时”。","reference":{"chapter":3,"verse":5}},{"noteId":2,"caller":"+","text":"“气息”或译“灵”，本节同。","reference":{"chapter":3,"verse":21}}]},"thisChapterLink":"/api/cmn_cbs/ECC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ECC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ECC/2.json","previousChapterAudioLinks":{},"numberOfVerses":22}