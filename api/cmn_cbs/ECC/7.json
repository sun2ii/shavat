{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cbs","name":"传道书","commonName":"传道书","title":"传道书","order":21,"numberOfChapters":12,"sha256":"3f5b39eb02d7a1d6766cabadd5a21eb777a96ecc4aafa2082814665aaa8ba329","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cbs/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"美好的名声胜过珍贵的膏油，","poem":1},{"lineBreak":true},{"text":"人死之日胜过出生之时。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"探望丧家胜过参加宴席，","poem":1},{"lineBreak":true},{"text":"因为死亡是每个人的结局，","poem":1},{"lineBreak":true},{"text":"活着的人要把这事铭记在心。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"哀伤胜过欢笑，","poem":1},{"lineBreak":true},{"text":"因为哀伤磨炼心灵。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"智者的心思考死亡，","poem":1},{"lineBreak":true},{"text":"愚人的心只顾作乐。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"听智者的责备，","poem":1},{"lineBreak":true},{"text":"胜过听愚人的颂歌。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愚人的笑声像锅底下烧荆棘的噼啪声。","poem":1},{"lineBreak":true},{"text":"这也是虚空。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"欺压使智者变愚昧，","poem":1},{"lineBreak":true},{"text":"贿赂败坏人心。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"事情的结局胜过事情的开端；","poem":1},{"lineBreak":true},{"text":"恒久忍耐胜过心骄气傲。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"不要轻易发怒，","poem":1},{"lineBreak":true},{"text":"因为愚人心怀怒气。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"不要问为什么过去比现在好，","poem":1},{"lineBreak":true},{"text":"因为这样问不明智。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"智慧如同产业一样美好，","poem":1},{"lineBreak":true},{"text":"有益于得见日光的世人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"智慧提供保障，","poem":1},{"lineBreak":true},{"text":"如同金钱一样。","poem":1},{"lineBreak":true},{"text":"智慧能保全智者的生命。","poem":1},{"lineBreak":true},{"text":"这就是知识的好处。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你要思想上帝的作为，","poem":1},{"lineBreak":true},{"text":"因为上帝弄弯的，","poem":1},{"lineBreak":true},{"text":"谁能使它变直呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"顺境时要快乐，","poem":1},{"lineBreak":true},{"text":"逆境时要思想：","poem":1},{"lineBreak":true},{"text":"两者都是上帝的安排，","poem":1},{"lineBreak":true},{"text":"好叫人不能预知将来。","poem":1}]},{"type":"verse","number":15,"content":["在我虚空的一生中，我见过义人行义，反而灭亡；恶人行恶，却享长寿。"]},{"type":"verse","number":16,"content":["为人不要过分正直，也不要过于聪明，何必自取毁灭呢？"]},{"type":"verse","number":17,"content":["不要过分邪恶，也不要做愚人，何必时候未到就死呢？"]},{"type":"verse","number":18,"content":["最好是持守这个教训也不放松那个教训，因为敬畏上帝的人必避免两个极端。"]},{"type":"verse","number":19,"content":["智慧使一个智者比城里十个官长更有能力。"]},{"type":"verse","number":20,"content":["诚然，在地上无法找到一个一生行善、从未犯罪的义人。"]},{"type":"verse","number":21,"content":["你不要斤斤计较别人所说的每一句话，免得听见你的仆人咒诅你，"]},{"type":"verse","number":22,"content":["因为你心里知道自己也曾多次咒诅别人。"]},{"type":"verse","number":23,"content":["我用智慧试验过这一切。我说：“我要做智者”，谁知智慧却离我甚远。"]},{"type":"verse","number":24,"content":["智慧如此遥不可及、深不可测，谁能找得到呢？"]},{"type":"verse","number":25,"content":["我用心去认识、探究、追寻智慧和事物的原委，并去认识邪恶带来的愚昧和无知带来的狂妄。"]},{"type":"verse","number":26,"content":["我发现有的妇人比死亡更苦毒，她是个陷阱，心如网罗，手像锁链。讨上帝喜悦的人避开她，罪人却被她俘虏。"]},{"type":"verse","number":27,"content":["传道者说：“看啊，我事事反复探索，要查明万事之理，却没有寻获。但我发现在一千个男子中还可以找到一位正直人，在众女子中却未找到一位。"]},{"type":"verse","number":29,"content":["我只发现一件事，上帝造的人本来正直，人却找出各种诡计。”"]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":28}