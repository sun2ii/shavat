{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"EZK","translationId":"cmn_cbs","name":"以西结书","commonName":"以西结书","title":"以西结书","order":26,"numberOfChapters":48,"sha256":"b300d2a00ef4238c256f8a9d29bc0a1d295803bb4dc8e9a92c0dd26615335564","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/cmn_cbs/EZK/48.json","totalNumberOfVerses":1271},"chapter":{"number":19,"content":[{"type":"heading","content":["以色列的哀歌"]},{"type":"verse","number":1,"content":["“你要为以色列的首领唱哀歌，"]},{"type":"verse","number":2,"content":["说，",{"text":"“‘你的母亲像什么？","poem":1},{"lineBreak":true},{"text":"她就像狮群中的母狮，","poem":1},{"lineBreak":true},{"text":"卧在雄壮的狮子中养育幼狮。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"母狮养大一头幼狮，","poem":1},{"lineBreak":true},{"text":"使它成为一头猛狮。","poem":1},{"lineBreak":true},{"text":"它学会了捕猎和吃人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"列国的人知道后，","poem":1},{"lineBreak":true},{"text":"便设陷阱捉住它，","poem":1},{"lineBreak":true},{"text":"用钩子拉到埃及。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"母狮盼着它回来，","poem":1},{"lineBreak":true},{"text":"眼见指望落空，","poem":1},{"lineBreak":true},{"text":"便又养育一头幼狮，","poem":1},{"lineBreak":true},{"text":"使它成为一头猛狮。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"它出入狮群，","poem":1},{"lineBreak":true},{"text":"长成一头猛狮，","poem":1},{"lineBreak":true},{"text":"学会了捕食和吃人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"它夷平列国的堡垒，","poem":1},{"lineBreak":true},{"text":"使他们的城邑沦为废墟，","poem":1},{"lineBreak":true},{"text":"遍地都因它的咆哮而震惊。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"于是，列国便从四面围攻它，","poem":1},{"lineBreak":true},{"text":"设网罗捕捉它。","poem":1},{"lineBreak":true},{"text":"它落入他们的陷阱。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们用钩子钩住它，把它关进笼里，","poem":1},{"lineBreak":true},{"text":"解送到巴比伦王那里囚禁起来。","poem":1},{"lineBreak":true},{"text":"于是，在以色列的山岭上再也听不见它的吼声。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“‘你母亲像葡萄园中的一棵葡萄树，","poem":1},{"lineBreak":true},{"text":"栽在溪水旁，","poem":1},{"lineBreak":true},{"text":"枝繁叶茂，硕果累累，","poem":1},{"lineBreak":true},{"text":"因为水源充沛。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"它的枝子粗壮，可作王的杖。","poem":1},{"lineBreak":true},{"text":"它的树干高大，直插云霄，","poem":1},{"lineBreak":true},{"text":"枝叶茂密，远远可见。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"但它被愤怒地连根拔起，","poem":1},{"lineBreak":true},{"text":"抛在地上。","poem":1},{"lineBreak":true},{"text":"东风吹干了它的果实，","poem":1},{"lineBreak":true},{"text":"粗壮的枝干折断枯干，","poem":1},{"lineBreak":true},{"text":"被火焚烧。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"现在，它被栽种在干旱的旷野。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"火从枝干蔓延，","poem":1},{"lineBreak":true},{"text":"烧毁了它的果实，","poem":1},{"lineBreak":true},{"text":"没有留下一根粗壮的枝干可作王的杖。’","poem":1},{"lineBreak":true},{"text":"“这是一首哀歌，可作哀悼之用。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}