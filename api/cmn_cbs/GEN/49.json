{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"GEN","translationId":"cmn_cbs","name":"创世记","commonName":"创世记","title":"创世记","order":1,"numberOfChapters":50,"sha256":"10a45bcf2ede9deb41605171c53170d502fcae5c3b35e4565dec7e08e91d0387","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cmn_cbs/GEN/50.json","totalNumberOfVerses":1531},"chapter":{"number":49,"content":[{"type":"heading","content":["雅各的预言"]},{"type":"verse","number":1,"content":["雅各把他的儿子们都叫来，对他们说：“你们到我身边来，我要把你们将来的遭遇告诉你们。"]},{"type":"verse","number":2,"content":[{"text":"“雅各的儿子们啊，","poem":1},{"lineBreak":true},{"text":"你们要聚在一起听，","poem":1},{"lineBreak":true},{"text":"听你们父亲以色列的话。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"吕便啊，你是我的长子，","poem":1},{"lineBreak":true},{"text":"是我年轻力壮时生的，","poem":1},{"lineBreak":true},{"text":"卓有尊荣和力量。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"可是，你必不再居首位，","poem":1},{"lineBreak":true},{"text":"因为你放纵情欲，","poem":1},{"lineBreak":true},{"text":"如沸腾不止的水，","poem":1},{"lineBreak":true},{"text":"你上了你父亲的床，","poem":1},{"lineBreak":true},{"text":"玷污了我的榻。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“西缅和利未是兄弟，","poem":1},{"lineBreak":true},{"text":"他们依仗刀剑，残暴不仁。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的灵不可与他们同谋。","poem":1},{"lineBreak":true},{"text":"我的心不可与他们联合。","poem":1},{"lineBreak":true},{"text":"他们泄愤杀人，","poem":1},{"lineBreak":true},{"text":"随意砍断牛腿的筋。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们狂怒凶残，该受咒诅！","poem":1},{"lineBreak":true},{"text":"我要使他们分散在雅各的子孙中，","poem":1},{"lineBreak":true},{"text":"散居在以色列各地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“犹大啊，你的兄弟们必赞美你，","poem":1},{"lineBreak":true},{"text":"你的手必掐住仇敌的颈项，","poem":1},{"lineBreak":true},{"text":"你父亲的儿子必向你下拜。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我儿犹大是头小狮子，","poem":1},{"lineBreak":true},{"text":"他猎食回来，躺卧如雄狮，","poem":1},{"lineBreak":true},{"text":"蹲伏如母狮，谁敢惊扰他？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"权杖必不离犹大，","poem":1},{"lineBreak":true},{"text":"御杖必伴他左右，","poem":1},{"lineBreak":true},{"text":"直到执掌王权的那位来到，","poem":1},{"lineBreak":true},{"text":"万民都必归顺他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“他把小驴拴在葡萄树旁，","poem":1},{"lineBreak":true},{"text":"把驴驹拴在上好的葡萄树旁；","poem":1},{"lineBreak":true},{"text":"他在葡萄酒中洗衣服，","poem":1},{"lineBreak":true},{"text":"在葡萄汁中洗外袍。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他的眼睛比酒乌润，","poem":1},{"lineBreak":true},{"text":"他的牙齿比奶洁白。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“西布伦必安居在海滨，","poem":1},{"lineBreak":true},{"text":"成为泊船的港口，","poem":1},{"lineBreak":true},{"text":"他的疆界必伸展到西顿。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“以萨迦是头壮驴，","poem":1},{"lineBreak":true},{"text":"卧在羊圈中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他见那地方好作安身之处，","poem":1},{"lineBreak":true},{"text":"地土肥美，就垂下肩头，","poem":1},{"lineBreak":true},{"text":"做了苦役。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“但必治理他的人民，","poem":1},{"lineBreak":true},{"text":"作以色列的一个支派。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他必成为路边的蛇，","poem":1},{"lineBreak":true},{"text":"道旁的毒蛇，","poem":1},{"lineBreak":true},{"text":"咬伤马蹄，使骑马的人坠落。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“耶和华啊，","poem":1},{"lineBreak":true},{"text":"我切切等候你的拯救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“迦得必被强盗劫掠，","poem":1},{"lineBreak":true},{"text":"他却要反败为胜追赶他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“亚设必有丰美的出产和供君王享用的美味。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“拿弗他利是头自由的母鹿，","poem":1},{"lineBreak":true},{"text":"养育美丽的小鹿","poem":1},{"noteId":55},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“约瑟是多结果子的枝条，","poem":1},{"lineBreak":true},{"text":"长在水泉旁，","poem":1},{"lineBreak":true},{"text":"他的枝条探出墙外。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"弓箭手凶猛地攻击他，","poem":1},{"lineBreak":true},{"text":"恶狠狠地射他。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"但他手持强弓，","poem":1},{"lineBreak":true},{"text":"双臂稳健有力，","poem":1},{"lineBreak":true},{"text":"因为雅各的大能者出手相助，","poem":1},{"lineBreak":true},{"text":"祂是以色列的牧者和磐石。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你父亲的上帝必帮助你，","poem":1},{"lineBreak":true},{"text":"全能者必赐你天上的福气、","poem":1},{"lineBreak":true},{"text":"地下深渊蕴藏的福气，","poem":1},{"lineBreak":true},{"text":"使你子孙兴旺、牛羊满圈。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你父亲的祝福高过亘古的峰峦，","poem":1},{"lineBreak":true},{"text":"多如永存的群山，","poem":1},{"lineBreak":true},{"text":"愿这一切祝福都临到约瑟头上，","poem":1},{"lineBreak":true},{"text":"临到这超越众弟兄的人身上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“便雅悯是匹贪婪的狼，","poem":1},{"lineBreak":true},{"text":"早晨吞吃猎物，","poem":1},{"lineBreak":true},{"text":"晚上瓜分战利品。”","poem":1}]},{"type":"verse","number":28,"content":["以上是以色列的十二支派，他们的父亲按着他们不同的福分给他们祝福。"]},{"type":"verse","number":29,"content":["雅各又嘱咐他们说：“我要离世了，你们要把我葬在赫人以弗仑田间的洞里，让我与祖先在一起。"]},{"type":"verse","number":30,"content":["那洞穴在迦南的幔利附近的麦比拉田间，是亚伯拉罕向赫人以弗仑买来作坟地的。"]},{"type":"verse","number":31,"content":["亚伯拉罕和他的妻子撒拉，以撒和他的妻子利百加都葬在那里，我把利亚也葬在了那里。"]},{"type":"verse","number":32,"content":["那块田和田间的洞穴是向赫人买的。”"]},{"type":"verse","number":33,"content":["雅各嘱咐完众子，把脚收到床上，咽了气，归到他祖先那里。"]}],"footnotes":[{"noteId":55,"caller":"+","text":"“养育美丽的小鹿”或译“口出佳美之言”。","reference":{"chapter":49,"verse":21}}]},"thisChapterLink":"/api/cmn_cbs/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}