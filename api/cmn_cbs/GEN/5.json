{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"GEN","translationId":"cmn_cbs","name":"创世记","commonName":"创世记","title":"创世记","order":1,"numberOfChapters":50,"sha256":"10a45bcf2ede9deb41605171c53170d502fcae5c3b35e4565dec7e08e91d0387","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cmn_cbs/GEN/50.json","totalNumberOfVerses":1531},"chapter":{"number":5,"content":[{"type":"heading","content":["亚当的后代"]},{"type":"verse","number":1,"content":["以下是关于亚当后代的记载。 上帝造人的时候，是照祂自己的样式造的。"]},{"type":"verse","number":2,"content":["祂造了男人和女人，又赐福给他们，并在造他们的那日称他们为“人”。"]},{"type":"verse","number":3,"content":["亚当一百三十岁时生了一子，样式和形象与自己相似，就给他取名叫塞特。"]},{"type":"verse","number":4,"content":["亚当生了塞特以后，又活了八百年，生儿育女，"]},{"type":"verse","number":5,"content":["共活了九百三十岁才去世。"]},{"type":"verse","number":6,"content":["塞特一百零五岁时生以挪士，"]},{"type":"verse","number":7,"content":["之后又活了八百零七年，生儿育女，"]},{"type":"verse","number":8,"content":["共活了九百一十二岁才去世。"]},{"type":"verse","number":9,"content":["以挪士九十岁时生该南，"]},{"type":"verse","number":10,"content":["之后又活了八百一十五年，生儿育女，"]},{"type":"verse","number":11,"content":["共活了九百零五岁才去世。"]},{"type":"verse","number":12,"content":["该南七十岁时生玛勒列，"]},{"type":"verse","number":13,"content":["之后又活了八百四十年，生儿育女，"]},{"type":"verse","number":14,"content":["共活了九百一十岁才去世。"]},{"type":"verse","number":15,"content":["玛勒列六十五岁时生雅列，"]},{"type":"verse","number":16,"content":["之后又活了八百三十年，生儿育女，"]},{"type":"verse","number":17,"content":["共活了八百九十五岁才去世。"]},{"type":"verse","number":18,"content":["雅列一百六十二岁时生以诺，"]},{"type":"verse","number":19,"content":["之后又活了八百年，生儿育女，"]},{"type":"verse","number":20,"content":["共活了九百六十二岁才去世。"]},{"type":"verse","number":21,"content":["以诺六十五岁时生玛土撒拉，"]},{"type":"verse","number":22,"content":["之后与上帝亲密同行三百年，生儿育女，"]},{"type":"verse","number":23,"content":["共活了三百六十五岁。"]},{"type":"verse","number":24,"content":["以诺与上帝亲密同行，后来被上帝接去，不在世上了。"]},{"type":"verse","number":25,"content":["玛土撒拉一百八十七岁时生拉麦，"]},{"type":"verse","number":26,"content":["之后又活了七百八十二年，生儿育女，"]},{"type":"verse","number":27,"content":["共活了九百六十九岁才去世。"]},{"type":"verse","number":28,"content":["拉麦一百八十二岁时生了一个儿子，"]},{"type":"verse","number":29,"content":["取名叫挪亚",{"noteId":4},"，他说：“耶和华咒诅了大地，这孩子必使我们从艰辛劳苦中得安慰。”"]},{"type":"verse","number":30,"content":["拉麦生挪亚之后，又活了五百九十五年，生儿育女，"]},{"type":"verse","number":31,"content":["共活了七百七十七岁才去世。"]},{"type":"verse","number":32,"content":["挪亚五百岁后生闪、含和雅弗。"]}],"footnotes":[{"noteId":4,"caller":"+","text":"希伯来文中“挪亚”与“安慰”谐音。","reference":{"chapter":5,"verse":29}}]},"thisChapterLink":"/api/cmn_cbs/GEN/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/GEN/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/GEN/4.json","previousChapterAudioLinks":{},"numberOfVerses":32}