{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HAB","translationId":"cmn_cbs","name":"哈巴谷书","commonName":"哈巴谷书","title":"哈巴谷书","order":35,"numberOfChapters":3,"sha256":"79e455564c8db5af84e1090faf367e2f580c93a71dbc68109fd4b0c698e35a0b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cbs/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["哈巴谷的祷告"]},{"type":"verse","number":1,"content":["以下是哈巴谷先知的祷告，采用流离调",{"noteId":3},"。"]},{"type":"verse","number":2,"content":[{"text":"耶和华啊，我听过你的威名；","poem":1},{"lineBreak":true},{"text":"耶和华啊，我对你的作为充满敬畏。","poem":1},{"lineBreak":true},{"text":"求你如今再次彰显你的作为，","poem":1},{"lineBreak":true},{"text":"求你此时再次显明你的作为，","poem":1},{"lineBreak":true},{"text":"求你发怒的时候仍以怜悯为念。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"上帝从提幔来，","poem":1},{"lineBreak":true},{"text":"圣者从巴兰山来。（细拉）","poem":1},{"lineBreak":true},{"text":"祂的荣耀遮蔽诸天，","poem":1},{"lineBreak":true},{"text":"颂赞之声响彻大地。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂明亮如晨光，","poem":1},{"lineBreak":true},{"text":"祂的手射出光芒，","poem":1},{"lineBreak":true},{"text":"其中蕴藏着大能。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"瘟疫行在祂前面，","poem":1},{"lineBreak":true},{"text":"灾病跟在祂脚后。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂停下，大地就震动；","poem":1},{"lineBreak":true},{"text":"祂观看，万民就战栗。","poem":1},{"lineBreak":true},{"text":"古老的山岳崩裂，","poem":1},{"lineBreak":true},{"text":"远古的丘陵塌陷，","poem":1},{"lineBreak":true},{"text":"但祂的作为永远不变。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我看见古珊的帐篷遭难，","poem":1},{"lineBreak":true},{"text":"米甸的幔子颤抖。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华啊，你是向江河发怒吗？","poem":1},{"lineBreak":true},{"text":"你骑着马、乘着得胜的战车而来，","poem":1},{"lineBreak":true},{"text":"是向江河生气吗？","poem":1},{"lineBreak":true},{"text":"是向海洋发怒吗？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你张弓搭箭，要射出许多箭羽。（细拉）","poem":1},{"lineBreak":true},{"text":"你以江河分开大地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"群山看见你就战栗，","poem":1},{"lineBreak":true},{"text":"大水奔腾而过，","poem":1},{"lineBreak":true},{"text":"深渊鸣响，波浪滔天。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你射出的箭闪闪发光，","poem":1},{"lineBreak":true},{"text":"你的枪熠熠生辉，","poem":1},{"lineBreak":true},{"text":"以致日月都停在原处。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你怀着烈怒走遍大地，","poem":1},{"lineBreak":true},{"text":"带着怒火践踏列国。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你出来是为了拯救你的子民，","poem":1},{"lineBreak":true},{"text":"拯救你膏立的王。","poem":1},{"lineBreak":true},{"text":"你打垮邪恶之人的首领，","poem":1},{"lineBreak":true},{"text":"从头到脚彻底毁灭他。（细拉）","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你用他的矛刺透其勇士的头颅。","poem":1},{"lineBreak":true},{"text":"他们如旋风而至，要驱散我们，","poem":1},{"lineBreak":true},{"text":"他们喜好暗中吞噬贫民。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你骑马踩踏汹涌的大海。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我听到这些，","poem":1},{"lineBreak":true},{"text":"就胆战心惊，嘴唇哆嗦，","poem":1},{"lineBreak":true},{"text":"四肢无力，双腿发抖。","poem":1},{"lineBreak":true},{"text":"但我仍要静候灾难临到入侵者的日子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"即使无花果树不发芽，","poem":1},{"lineBreak":true},{"text":"葡萄树不结果，","poem":1},{"lineBreak":true},{"text":"橄榄树无收成，","poem":1},{"lineBreak":true},{"text":"田地不产粮，","poem":1},{"lineBreak":true},{"text":"圈里没有羊，","poem":1},{"lineBreak":true},{"text":"棚里没有牛，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我仍要因耶和华而欢欣，","poem":1},{"lineBreak":true},{"text":"因拯救我的上帝而喜乐。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"主耶和华是我的力量，","poem":1},{"lineBreak":true},{"text":"祂使我的脚如母鹿的蹄，","poem":1},{"lineBreak":true},{"text":"稳行在高处。","poem":1},{"lineBreak":true},{"text":"这首歌交给乐长，用弦乐器伴奏。","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"流离调是希伯来诗歌的一种曲调。","reference":{"chapter":3,"verse":1}}]},"thisChapterLink":"/api/cmn_cbs/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}