{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cbs","name":"何西阿书","commonName":"何西阿书","title":"何西阿书","order":28,"numberOfChapters":14,"sha256":"0fd01139d1173aab3c4eae9aadc1f8604860ccbde5e4b3d2c68eec56323410c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cbs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"“以法莲以风为食，","poem":1},{"lineBreak":true},{"text":"整天追逐东风，","poem":1},{"lineBreak":true},{"text":"虚谎和暴力日益增多；","poem":1},{"lineBreak":true},{"text":"他跟亚述结盟，","poem":1},{"lineBreak":true},{"text":"向埃及进贡橄榄油。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"耶和华指控犹大；","poem":1},{"lineBreak":true},{"text":"祂要按雅各所行的惩罚他，","poem":1},{"lineBreak":true},{"text":"照雅各所做的报应他。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"雅各在母胎之中曾抓住哥哥的脚跟，","poem":1},{"lineBreak":true},{"text":"壮年之时曾跟上帝角力。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他跟天使角力得胜，","poem":1},{"lineBreak":true},{"text":"向天使哭求福分。","poem":1},{"lineBreak":true},{"text":"他在伯特利遇见祂，","poem":1},{"lineBreak":true},{"text":"在那里与祂说话，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂就是万军之上帝耶和华，","poem":1},{"lineBreak":true},{"text":"耶和华是祂的名。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"所以，你们要归向你们的上帝，","poem":1},{"lineBreak":true},{"text":"持守仁爱和公义，常常等候祂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"以法莲是个奸商，","poem":1},{"lineBreak":true},{"text":"手里拿着骗人的秤，喜欢压榨人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"以法莲说：“我发财了，","poem":1},{"lineBreak":true},{"text":"我依靠自己致富。","poem":1},{"lineBreak":true},{"text":"没有人能从我的劳碌中找出过错和罪恶。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"“从你们出埃及以来，","poem":1},{"lineBreak":true},{"text":"我就是你们的上帝耶和华。","poem":1},{"lineBreak":true},{"text":"我要使你们再次住在帐篷里，","poem":1},{"lineBreak":true},{"text":"就像从前守节期时一样。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我曾对先知讲话，赐给他们许多异象，","poem":1},{"lineBreak":true},{"text":"借他们用比喻警告你们。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"基列人充满罪恶，终必灭亡。","poem":1},{"lineBreak":true},{"text":"他们在吉甲用公牛献祭，","poem":1},{"lineBreak":true},{"text":"他们的祭坛像田间犁沟里的石堆。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"雅各曾逃往亚兰，","poem":1},{"lineBreak":true},{"text":"以色列在那里为娶妻而服侍人，","poem":1},{"lineBreak":true},{"text":"为得到妻子而替人牧羊。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华借着先知带领以色列离开埃及，","poem":1},{"lineBreak":true},{"text":"也借着先知保护他。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"但以法莲却极大地触怒耶和华，","poem":1},{"lineBreak":true},{"text":"所以他的主要让他血债血还，","poem":1},{"lineBreak":true},{"text":"以羞辱还羞辱。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}