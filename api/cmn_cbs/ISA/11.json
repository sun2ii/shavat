{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbs","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"632dd4147026fa600518a3f00c24b6fa8a338b17185b54576ae9104ec0242142","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbs/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":11,"content":[{"type":"heading","content":["大卫的后裔做王"]},{"type":"verse","number":1,"content":[{"text":"耶西的树桩上必生发新枝，","poem":1},{"lineBreak":true},{"text":"他根茎长出的枝子必结果子。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华的灵必住在祂身上，","poem":1},{"lineBreak":true},{"text":"使祂有聪明和智慧、谋略和能力，","poem":1},{"lineBreak":true},{"text":"能认识并敬畏耶和华。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂必以敬畏耶和华为乐。","poem":1},{"lineBreak":true},{"text":"祂不凭眼见施行审判，","poem":1},{"lineBreak":true},{"text":"不凭耳闻断定是非，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"而是按公义审判贫穷人，","poem":1},{"lineBreak":true},{"text":"以公正为受苦者断案。","poem":1},{"lineBreak":true},{"text":"祂必用口中的杖击打世界，","poem":1},{"lineBreak":true},{"text":"以嘴里的气杀戮恶人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"公义必作祂的腰带，","poem":1},{"lineBreak":true},{"text":"信实必作祂肋下的带子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"那时，豺狼和绵羊羔同住，","poem":1},{"lineBreak":true},{"text":"豹子和山羊羔同卧，","poem":1},{"lineBreak":true},{"text":"牛犊和狮子同群，","poem":1},{"lineBreak":true},{"text":"小孩子必引领它们。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"牛与熊一起进食，","poem":1},{"lineBreak":true},{"text":"小牛和小熊一起躺卧，","poem":1},{"lineBreak":true},{"text":"狮子像牛一样吃草。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"吃奶的婴孩必在毒蛇的洞口玩耍，","poem":1},{"lineBreak":true},{"text":"断奶的孩子必把手伸进蛇洞。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"在我的整个圣山上，","poem":1},{"lineBreak":true},{"text":"它们都不伤人、不害物。","poem":1},{"lineBreak":true},{"text":"因为大地必充满对耶和华的认识，","poem":1},{"lineBreak":true},{"text":"如同海洋被水充满。","poem":1}]},{"type":"verse","number":10,"content":["到那日，耶西的根必成为引导万民的旗帜，列邦都来寻求祂，祂的安歇之处充满荣耀。"]},{"type":"verse","number":11,"content":["到那日，主必再次伸手从亚述、埃及、巴特罗、古实、以拦、示拿、哈马和众海岛救回祂剩余的子民。"]},{"type":"verse","number":12,"content":[{"text":"祂必向各国竖立旗帜，","poem":1},{"lineBreak":true},{"text":"召集被掳的以色列人，","poem":1},{"lineBreak":true},{"text":"把分散在世界各地的犹大人聚集起来。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"以法莲必不再嫉妒，","poem":1},{"lineBreak":true},{"text":"犹大的仇敌必被铲除，","poem":1},{"lineBreak":true},{"text":"以法莲必不嫉妒犹大，","poem":1},{"lineBreak":true},{"text":"犹大必不与以法莲为敌。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们必向西突袭非利士。","poem":1},{"lineBreak":true},{"text":"他们必一起掳掠东方人，","poem":1},{"lineBreak":true},{"text":"征服以东和摩押，","poem":1},{"lineBreak":true},{"text":"亚扪人必顺从他们。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和华必使埃及的海湾干涸，","poem":1},{"lineBreak":true},{"text":"祂必挥手使焦热的风吹在幼发拉底河上，","poem":1},{"lineBreak":true},{"text":"把河分成七条溪流，使人可以涉水而过。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"必有一条大道让祂剩余的子民从亚述归回，","poem":1},{"lineBreak":true},{"text":"就像昔日以色列人离开埃及一样。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}