{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbs","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"632dd4147026fa600518a3f00c24b6fa8a338b17185b54576ae9104ec0242142","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbs/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":13,"content":[{"type":"heading","content":["预言审判巴比伦"]},{"type":"verse","number":1,"content":["以下是亚摩斯的儿子以赛亚有关巴比伦的预言："]},{"type":"verse","number":2,"content":[{"text":"你们要在光秃的山上竖立旗帜，","poem":1},{"lineBreak":true},{"text":"向战士高呼，","poem":1},{"lineBreak":true},{"text":"挥手示意他们进入贵族的城门。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我已向我拣选的士兵发出命令，","poem":1},{"lineBreak":true},{"text":"我已号召我的勇士去倾倒我的烈怒，","poem":1},{"lineBreak":true},{"text":"他们因我的胜利而欢喜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"听啊，山上人声鼎沸，","poem":1},{"lineBreak":true},{"text":"像是大军的声音。","poem":1},{"lineBreak":true},{"text":"那是列邦列国聚集呐喊的声音。","poem":1},{"lineBreak":true},{"text":"万军之耶和华正在召集军队，","poem":1},{"lineBreak":true},{"text":"准备作战。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们从远方，从天边而来。","poem":1},{"lineBreak":true},{"text":"那是耶和华及倾倒祂烈怒的兵器，","poem":1},{"lineBreak":true},{"text":"要来毁灭大地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"你们哀号吧！","poem":1},{"lineBreak":true},{"text":"因为耶和华的日子近了，","poem":1},{"lineBreak":true},{"text":"全能者施行毁灭的时候到了。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"人们都必双手发软，人人胆战心惊，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"惊恐万状，","poem":1},{"lineBreak":true},{"text":"痛苦不堪，如同剧痛中分娩的妇人。","poem":1},{"lineBreak":true},{"text":"他们必吓得面面相觑，脸如火烧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"看啊，耶和华的日子来临了，","poem":1},{"lineBreak":true},{"text":"是充满愤恨和烈怒的残酷之日，","poem":1},{"lineBreak":true},{"text":"要使大地荒凉，","poem":1},{"lineBreak":true},{"text":"毁灭地上的罪人。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"天上的星辰不再发光，","poem":1},{"lineBreak":true},{"text":"太阳刚出来就变黑，","poem":1},{"lineBreak":true},{"text":"月亮也暗淡无光。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我必惩罚这邪恶的世界，","poem":1},{"lineBreak":true},{"text":"惩治罪恶的世人，","poem":1},{"lineBreak":true},{"text":"终结骄横之人的狂妄，","poem":1},{"lineBreak":true},{"text":"贬抑残暴之徒的骄傲。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我必使人比精炼的金子还稀少，","poem":1},{"lineBreak":true},{"text":"比俄斐的纯金更罕见。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我万军之耶和华发烈怒和义愤的日子，","poem":1},{"lineBreak":true},{"text":"必使诸天震动，","poem":1},{"lineBreak":true},{"text":"使大地摇撼，脱离原位。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人们都投奔亲族，","poem":1},{"lineBreak":true},{"text":"逃回故乡，","poem":1},{"lineBreak":true},{"text":"好像被追赶的羚羊，","poem":1},{"lineBreak":true},{"text":"又如没有牧人的羊群。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"被捉的人都会被刺死，","poem":1},{"lineBreak":true},{"text":"被逮的人都会丧身刀下。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他们的婴孩必被摔死在他们眼前，","poem":1},{"lineBreak":true},{"text":"家园遭劫掠，","poem":1},{"lineBreak":true},{"text":"妻子被蹂躏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"看啊，我要驱使玛代人来攻击他们。","poem":1},{"lineBreak":true},{"text":"玛代人不在乎金子，","poem":1},{"lineBreak":true},{"text":"也不看重银子，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们必用弓箭射死青年，","poem":1},{"lineBreak":true},{"text":"他们不怜悯婴儿，","poem":1},{"lineBreak":true},{"text":"也不顾惜孩童。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"巴比伦在列国中辉煌无比，","poem":1},{"lineBreak":true},{"text":"是迦勒底人的骄傲和荣耀，","poem":1},{"lineBreak":true},{"text":"但上帝必毁灭它，","poem":1},{"lineBreak":true},{"text":"好像毁灭所多玛和蛾摩拉一样。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"那里必人烟绝迹，","poem":1},{"lineBreak":true},{"text":"世世代代无人居住，","poem":1},{"lineBreak":true},{"text":"没有阿拉伯人在那里支搭帐篷，","poem":1},{"lineBreak":true},{"text":"也无人在那里牧放羊群。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"旷野的走兽在那里躺卧，","poem":1},{"lineBreak":true},{"text":"咆哮的猛兽占满房屋；","poem":1},{"lineBreak":true},{"text":"鸵鸟住在那里，","poem":1},{"lineBreak":true},{"text":"野山羊在那里跳跃嬉戏。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"豺狼在城楼上嚎叫，","poem":1},{"lineBreak":true},{"text":"野狗在华美的宫殿里狂吠。","poem":1},{"lineBreak":true},{"text":"巴比伦的结局近了，","poem":1},{"lineBreak":true},{"text":"它的时候不多了！","poem":1}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}