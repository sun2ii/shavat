{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbs","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"632dd4147026fa600518a3f00c24b6fa8a338b17185b54576ae9104ec0242142","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbs/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":19,"content":[{"type":"heading","content":["关于埃及的预言"]},{"type":"verse","number":1,"content":["以下是关于埃及的预言：",{"text":"看啊，耶和华驾着疾驰的云来到埃及。","poem":1},{"lineBreak":true},{"text":"埃及的偶像在祂面前颤抖，","poem":1},{"lineBreak":true},{"text":"埃及人胆战心惊。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“我必使埃及人彼此为敌——手足相残，","poem":1},{"lineBreak":true},{"text":"邻居互斗，城邑相争，","poem":1},{"lineBreak":true},{"text":"邦国互攻。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"埃及人必灰心丧志，","poem":1},{"lineBreak":true},{"text":"我必破坏他们的计谋。","poem":1},{"lineBreak":true},{"text":"他们必求问偶像、巫师、灵媒和术士。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我必将埃及人交给一位残忍的主人，","poem":1},{"lineBreak":true},{"text":"一位暴君必统治他们。”","poem":1},{"lineBreak":true},{"text":"这是主——万军之耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"海水必枯竭，","poem":1},{"lineBreak":true},{"text":"河床必干涸。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"沟渠必发臭，","poem":1},{"lineBreak":true},{"text":"埃及的河流逐渐枯竭。","poem":1},{"lineBreak":true},{"text":"芦苇和灯心草必枯死，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"尼罗河两岸青草枯黄，","poem":1},{"lineBreak":true},{"text":"田地龟裂，庄稼被风吹去，","poem":1},{"lineBreak":true},{"text":"荡然无存。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"所有在尼罗河下钩的渔夫都哀哭悲伤，","poem":1},{"lineBreak":true},{"text":"在河上撒网的人都伤痛。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"纺麻织布的人一筹莫展，","poem":1},{"lineBreak":true},{"text":"陷入绝望。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"埃及的显贵萎靡不振","poem":1},{"noteId":8},{"text":"，","poem":1},{"lineBreak":true},{"text":"雇工们都忧心忡忡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"琐安的官长愚不可及，","poem":1},{"lineBreak":true},{"text":"法老聪明的谋士尽出下策。","poem":1},{"lineBreak":true},{"text":"他们怎敢在法老面前自称是智者之子，古代君王之后？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"法老啊，你的智者在哪里呢？","poem":1},{"lineBreak":true},{"text":"让他们把万军之耶和华对付埃及的计划告诉你吧！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"琐安的首领愚昧，","poem":1},{"lineBreak":true},{"text":"挪弗的首领糊涂。","poem":1},{"lineBreak":true},{"text":"他们是埃及各支派的房角石，","poem":1},{"lineBreak":true},{"text":"却把埃及人引入歧途。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华使错谬的灵进入他们当中，","poem":1},{"lineBreak":true},{"text":"使他们像又呕又吐、东倒西歪的醉汉，","poem":1},{"lineBreak":true},{"text":"做什么都错误百出。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"埃及从头到尾，","poem":1},{"lineBreak":true},{"text":"从权贵到草根必一筹莫展。","poem":1}]},{"type":"verse","number":16,"content":["到那日，当万军之耶和华挥手惩罚的时候，埃及人必恐惧颤抖，如柔弱的女子。"]},{"type":"verse","number":17,"content":["他们必对犹大充满恐惧，一听见犹大的名字就害怕，因为万军之耶和华定下计划要对付他们。"]},{"type":"verse","number":18,"content":["到那日，埃及必有五座城的人讲迦南的语言，并起誓效忠万军之耶和华，其中有一座必叫灭亡城",{"noteId":9},"。"]},{"type":"verse","number":19,"content":["到那日，埃及境内必有一座为耶和华筑的祭坛，边境必有一根为耶和华立的石柱。"]},{"type":"verse","number":20,"content":["这是万军之耶和华在埃及的记号和凭据。埃及人因受到欺压就呼求耶和华，祂必差遣一位救主保护、拯救他们。"]},{"type":"verse","number":21,"content":["耶和华必向埃及人彰显自己。到那日，埃及人必认识祂，带着祭物和供物来敬拜祂，向祂许愿还愿。"]},{"type":"verse","number":22,"content":["耶和华必击打他们，也必医治他们。他们必归向耶和华，祂必应允他们的祷告，医治他们。"]},{"type":"verse","number":23,"content":["到那日，必有一条大道连接埃及和亚述，两国人民互相往来，一同敬拜耶和华。"]},{"type":"verse","number":24,"content":["到那日，以色列必与埃及和亚述一同成为世人的祝福。"]},{"type":"verse","number":25,"content":["万军之耶和华必赐福给他们，说：“我的子民埃及、我的创作亚述、我的产业以色列都有福了！”"]}],"footnotes":[{"noteId":8,"caller":"+","text":"死海古卷为“埃及的织布者都崩溃”。","reference":{"chapter":19,"verse":10}},{"noteId":9,"caller":"+","text":"“灭亡城”有些抄本作“太阳城”。","reference":{"chapter":19,"verse":18}}]},"thisChapterLink":"/api/cmn_cbs/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}