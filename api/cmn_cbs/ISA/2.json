{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbs","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"632dd4147026fa600518a3f00c24b6fa8a338b17185b54576ae9104ec0242142","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbs/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":2,"content":[{"type":"heading","content":["主必统治万邦"]},{"type":"verse","number":1,"content":["亚摩斯的儿子以赛亚看到以下有关犹大和耶路撒冷的异象。"]},{"type":"verse","number":2,"content":[{"text":"在末后的日子，","poem":1},{"lineBreak":true},{"text":"耶和华殿所在的山必耸立，","poem":1},{"lineBreak":true},{"text":"高过群山，超过万岭，","poem":1},{"lineBreak":true},{"text":"万国都要涌向它。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"列邦都必来，说：","poem":1},{"lineBreak":true},{"text":"“来吧！让我们登耶和华的山，","poem":1},{"lineBreak":true},{"text":"去雅各之上帝的殿。","poem":1},{"lineBreak":true},{"text":"祂必教导我们行祂的道，","poem":1},{"lineBreak":true},{"text":"让我们走祂的路。”","poem":1},{"lineBreak":true},{"text":"因为训诲必出于锡安，","poem":1},{"lineBreak":true},{"text":"耶和华的话语必来自耶路撒冷。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂必在列国施行审判，","poem":1},{"lineBreak":true},{"text":"为列邦平息纷争。","poem":1},{"lineBreak":true},{"text":"他们必把刀剑打成犁头，","poem":1},{"lineBreak":true},{"text":"将矛枪打成镰刀。","poem":1},{"lineBreak":true},{"text":"国与国不再刀兵相见，","poem":1},{"lineBreak":true},{"text":"人们也不再学习战事。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"雅各家啊，来吧！","poem":1},{"lineBreak":true},{"text":"让我们走在耶和华的光中。","poem":1}]},{"type":"heading","content":["耶和华审判的日子"]},{"type":"verse","number":6,"content":[{"text":"耶和华啊，你离弃了你的子民雅各的后代，","poem":1},{"lineBreak":true},{"text":"因为他们当中充满了东方的恶俗，","poem":1},{"lineBreak":true},{"text":"像非利士人一样占卜，","poem":1},{"lineBreak":true},{"text":"跟外族人同流合污。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们境内金银充裕，","poem":1},{"lineBreak":true},{"text":"财宝无穷；","poem":1},{"lineBreak":true},{"text":"他们境内马匹遍地，","poem":1},{"lineBreak":true},{"text":"战车无数。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们境内偶像林立，","poem":1},{"lineBreak":true},{"text":"他们跪拜自己的手工作品，","poem":1},{"lineBreak":true},{"text":"跪拜自己用指头所造之物。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们必受羞辱，遭贬抑。","poem":1},{"lineBreak":true},{"text":"求你不要赦免他们。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"要躲进岩洞，藏入地穴，","poem":1},{"lineBreak":true},{"text":"逃避耶和华的可畏和威荣！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"到那日，狂妄之徒必受羞辱，","poem":1},{"lineBreak":true},{"text":"骄傲的人必遭贬抑；","poem":1},{"lineBreak":true},{"text":"唯独耶和华将受尊崇。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因为万军之耶和华已定了日子，","poem":1},{"lineBreak":true},{"text":"要惩罚一切狂妄自大的人，","poem":1},{"lineBreak":true},{"text":"要惩罚一切高傲的人，","poem":1},{"lineBreak":true},{"text":"他们必受羞辱；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂必毁灭黎巴嫩高大的香柏树，","poem":1},{"lineBreak":true},{"text":"毁灭巴珊的橡树，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"毁灭一切崇山峻岭，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"毁灭所有高耸的城楼，","poem":1},{"lineBreak":true},{"text":"毁灭所有坚固的城墙，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"毁灭他施的一切商船，","poem":1},{"lineBreak":true},{"text":"毁灭一切华美的船只。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"到那日，狂妄的人必受羞辱，","poem":1},{"lineBreak":true},{"text":"骄傲的人必遭贬抑，","poem":1},{"lineBreak":true},{"text":"唯独耶和华受尊崇。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"偶像必被彻底铲除。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和华使大地震动的时候，","poem":1},{"lineBreak":true},{"text":"众人必躲进岩穴，藏入地洞，","poem":1},{"lineBreak":true},{"text":"逃避祂的可畏和威荣。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"到那日，众人必把造来敬拜的金银偶像丢给田鼠和蝙蝠。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和华使大地震动的时候，","poem":1},{"lineBreak":true},{"text":"众人必躲进山洞和岩穴，","poem":1},{"lineBreak":true},{"text":"逃避祂的可畏和威荣。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"不要再倚靠世人，","poem":1},{"lineBreak":true},{"text":"他们的生命不过是一口气，","poem":1},{"lineBreak":true},{"text":"他们有什么值得称道的呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}