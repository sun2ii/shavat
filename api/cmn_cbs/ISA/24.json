{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbs","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"632dd4147026fa600518a3f00c24b6fa8a338b17185b54576ae9104ec0242142","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbs/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":24,"content":[{"type":"heading","content":["主必审判世界"]},{"type":"verse","number":1,"content":["看啊，耶和华必摧毁大地，",{"text":"使大地荒凉。","poem":1},{"lineBreak":true},{"text":"祂毁坏地面，驱散万民。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"那时，祭司和百姓，","poem":1},{"lineBreak":true},{"text":"主人和仆人，","poem":1},{"lineBreak":true},{"text":"主母和婢女，","poem":1},{"lineBreak":true},{"text":"买的和卖的，","poem":1},{"lineBreak":true},{"text":"贷的和借的，","poem":1},{"lineBreak":true},{"text":"债主和债户都必遭难。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"大地必被完全毁坏，洗劫一空。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"大地枯竭凋零，","poem":1},{"lineBreak":true},{"text":"世界衰败没落，","poem":1},{"lineBreak":true},{"text":"世上的权贵也败落。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"大地被世人玷污，","poem":1},{"lineBreak":true},{"text":"他们干犯律法，","poem":1},{"lineBreak":true},{"text":"不守律例，背弃永远的约。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"所以咒诅必吞噬大地，","poem":1},{"lineBreak":true},{"text":"世人必因罪而受惩罚。","poem":1},{"lineBreak":true},{"text":"他们必被焚烧，","poem":1},{"lineBreak":true},{"text":"所剩无几。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"葡萄树枯萎，新酒枯竭，","poem":1},{"lineBreak":true},{"text":"欢乐的人都发出悲叹。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愉快的鼓声止息，","poem":1},{"lineBreak":true},{"text":"悦耳的琴音消失，","poem":1},{"lineBreak":true},{"text":"宴乐的喧闹不复听闻。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"再没有人对酒高歌，","poem":1},{"lineBreak":true},{"text":"浓酒变得苦涩。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"毁坏的城一片荒凉，","poem":1},{"lineBreak":true},{"text":"家家房门紧闭，无人能进。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"人们因无酒而在街上喊叫；","poem":1},{"lineBreak":true},{"text":"一切欢乐变作哀愁，","poem":1},{"lineBreak":true},{"text":"地上喜乐不复存在。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"城里一片荒凉，","poem":1},{"lineBreak":true},{"text":"城门被撞成碎片。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"世上万民必所剩无几，","poem":1},{"lineBreak":true},{"text":"像打过的橄榄树，","poem":1},{"lineBreak":true},{"text":"又如摘过的葡萄树。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"劫后余生的人必高声欢呼，","poem":1},{"lineBreak":true},{"text":"在西方赞美耶和华的威严。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因此，要在东方尊崇耶和华，","poem":1},{"lineBreak":true},{"text":"要在众海岛赞美以色列的上帝耶和华的名。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我们听见从地极传来歌唱声：","poem":1},{"lineBreak":true},{"text":"“荣耀归给公义者。”","poem":1},{"lineBreak":true},{"text":"我说：“我完了！","poem":1},{"lineBreak":true},{"text":"我完了！我有祸了！","poem":1},{"lineBreak":true},{"text":"因为诡诈的行事诡诈，","poem":1},{"lineBreak":true},{"text":"诡诈的行事极其诡诈。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"世人啊！","poem":1},{"lineBreak":true},{"text":"恐怖、陷阱和网罗要临到你们。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"逃避恐怖的必掉进陷阱，","poem":1},{"lineBreak":true},{"text":"爬出陷阱的必被网罗缠住。","poem":1},{"lineBreak":true},{"text":"天上的水闸开启，","poem":1},{"lineBreak":true},{"text":"大地的根基摇动。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"大地崩溃、撕裂，剧烈震动。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"大地像醉汉东摇西晃，","poem":1},{"lineBreak":true},{"text":"又像暴风中的茅屋摇来摆去。","poem":1},{"lineBreak":true},{"text":"它被沉重的罪恶压垮，","poem":1},{"lineBreak":true},{"text":"再也无法起来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"到那日，耶和华必在天上惩罚天上的众权能者，","poem":1},{"lineBreak":true},{"text":"在地上惩罚地上的君王。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他们必像囚犯一样被聚在一起，","poem":1},{"lineBreak":true},{"text":"关在牢里，囚在狱中，","poem":1},{"lineBreak":true},{"text":"多日之后必受惩罚。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"那时，月亮必大惊失色，","poem":1},{"lineBreak":true},{"text":"太阳必羞愧无光，","poem":1},{"lineBreak":true},{"text":"因为万军之耶和华必在锡安山，","poem":1},{"lineBreak":true},{"text":"在耶路撒冷掌权，","poem":1},{"lineBreak":true},{"text":"在祂子民的长老面前彰显荣耀。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}