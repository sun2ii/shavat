{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbs","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"632dd4147026fa600518a3f00c24b6fa8a338b17185b54576ae9104ec0242142","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbs/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":32,"content":[{"type":"heading","content":["公义的君王"]},{"type":"verse","number":1,"content":["看啊，必有一位君王以公义治国，",{"text":"官长必秉公施政。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"每人都像避风处和躲避暴风雨的庇护所，","poem":1},{"lineBreak":true},{"text":"如荒漠中的溪流，","poem":1},{"lineBreak":true},{"text":"又似干旱之地遮荫的巨石。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人们的眼睛必不再迷蒙，","poem":1},{"lineBreak":true},{"text":"耳朵必留心听。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"急躁的人必慎思明辨，","poem":1},{"lineBreak":true},{"text":"口吃的人必口齿伶俐。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愚人不再被称为君子，","poem":1},{"lineBreak":true},{"text":"恶徒不再受到尊重。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因为愚昧人说愚昧话，","poem":1},{"lineBreak":true},{"text":"心里邪恶，行事不义，","poem":1},{"lineBreak":true},{"text":"亵渎耶和华，","poem":1},{"lineBreak":true},{"text":"使饥饿的人没饭吃，","poem":1},{"lineBreak":true},{"text":"使口渴的人没水喝。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"恶棍们手段邪恶，","poem":1},{"lineBreak":true},{"text":"用奸计和谎言毁灭困苦的人，","poem":1},{"lineBreak":true},{"text":"罔顾穷人的正当诉求。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"高尚的人计划高尚的事，","poem":1},{"lineBreak":true},{"text":"在高尚的事上持之以恒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"生活安逸的妇女啊，","poem":1},{"lineBreak":true},{"text":"来听我的声音！","poem":1},{"lineBreak":true},{"text":"无忧无虑的女子啊，","poem":1},{"lineBreak":true},{"text":"要侧耳听我的言语！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"无忧无虑的女子啊，","poem":1},{"lineBreak":true},{"text":"再过一年多，","poem":1},{"lineBreak":true},{"text":"你们必因恐惧而颤抖。","poem":1},{"lineBreak":true},{"text":"那时，必没有葡萄可摘，","poem":1},{"lineBreak":true},{"text":"没有果子可收。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"生活安逸的妇女啊，颤抖吧！","poem":1},{"lineBreak":true},{"text":"无忧无虑的女子啊，战栗吧！","poem":1},{"lineBreak":true},{"text":"你们要脱下衣服，","poem":1},{"lineBreak":true},{"text":"腰束麻布，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"为美好的田地和硕果累累的葡萄树捶胸痛哭吧！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"为我百姓那长满荆棘和蒺藜的土地，","poem":1},{"lineBreak":true},{"text":"为那曾经充满欢乐的城邑和所有家庭哀哭吧！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"王宫必被遗弃，","poem":1},{"lineBreak":true},{"text":"繁荣的城邑必荒芜，","poem":1},{"lineBreak":true},{"text":"山冈和瞭望塔必永远荒废，","poem":1},{"lineBreak":true},{"text":"成为野驴的乐园、羊群的草场。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"等到圣灵从上面浇灌我们的时候，","poem":1},{"lineBreak":true},{"text":"旷野要变为沃野，","poem":1},{"lineBreak":true},{"text":"沃野上庄稼茂密如林。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"那时，公平必住在旷野，","poem":1},{"lineBreak":true},{"text":"公义必居于沃野。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"公义必带来平安，","poem":1},{"lineBreak":true},{"text":"公义结的果子是永远的和平与安宁。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我的子民必住在平安之地、","poem":1},{"lineBreak":true},{"text":"安稳之处、宁静之所。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"但冰雹必扫平森林，","poem":1},{"lineBreak":true},{"text":"城邑也被夷为平地。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你们这些在河边撒种、自由地牧放牛驴的人有福了！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}