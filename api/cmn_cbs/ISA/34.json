{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbs","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"632dd4147026fa600518a3f00c24b6fa8a338b17185b54576ae9104ec0242142","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbs/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":34,"content":[{"type":"heading","content":["审判列国"]},{"type":"verse","number":1,"content":["列国啊，近前来听吧！",{"text":"列邦啊，留心听吧！","poem":1},{"lineBreak":true},{"text":"大地和地上的万物、世界和世上的一切都要听。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为耶和华向列国发怒，","poem":1},{"lineBreak":true},{"text":"向他们的军队发烈怒。","poem":1},{"lineBreak":true},{"text":"祂要毁灭他们，杀尽他们。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们必暴尸在外，","poem":1},{"lineBreak":true},{"text":"臭气熏天，","poem":1},{"lineBreak":true},{"text":"血浸山岭。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"天上的万象必融化，","poem":1},{"lineBreak":true},{"text":"穹苍像书卷卷起；","poem":1},{"lineBreak":true},{"text":"星辰陨落，","poem":1},{"lineBreak":true},{"text":"像凋零的葡萄叶，","poem":1},{"lineBreak":true},{"text":"又像枯落的无花果。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华的刀剑在天上饱饮了血后，","poem":1},{"lineBreak":true},{"text":"必降下来惩罚祂决意要毁灭的以东人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂的刀沾满了血和脂肪，","poem":1},{"lineBreak":true},{"text":"是羊羔、公山羊的血和公绵羊肾脏上的脂肪。","poem":1},{"lineBreak":true},{"text":"因为耶和华在波斯拉有祭物，","poem":1},{"lineBreak":true},{"text":"在以东有大杀戮。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"野牛和他们一同倒下，","poem":1},{"lineBreak":true},{"text":"牛犊与公牛一同被杀。","poem":1},{"lineBreak":true},{"text":"他们的土地被血浸透，","poem":1},{"lineBreak":true},{"text":"土壤被脂肪覆盖。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因为这是耶和华报应的日子，","poem":1},{"lineBreak":true},{"text":"是祂为锡安报仇之年。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"以东的河流要变为沥青，","poem":1},{"lineBreak":true},{"text":"土壤要变成硫磺，","poem":1},{"lineBreak":true},{"text":"土地要成为燃烧的沥青，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"昼夜燃烧，浓烟滚滚，","poem":1},{"lineBreak":true},{"text":"永不止息。","poem":1},{"lineBreak":true},{"text":"以东必世世代代荒废，","poem":1},{"lineBreak":true},{"text":"永远人踪绝迹。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"老鹰和刺猬必占据那里，","poem":1},{"lineBreak":true},{"text":"猫头鹰和乌鸦必在那里做窝。","poem":1},{"lineBreak":true},{"text":"耶和华要用空虚的准绳丈量以东，","poem":1},{"lineBreak":true},{"text":"用混沌的线锤丈量它。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"以东没有一个显贵可以称王，","poem":1},{"lineBreak":true},{"text":"那里所有的首领全都消失。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"那里的宫殿荆棘丛生，","poem":1},{"lineBreak":true},{"text":"蒺藜、刺草遍布坚城，","poem":1},{"lineBreak":true},{"text":"成了野狗的巢穴和鸵鸟的住处。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"在那里，豺狼和旷野的其他走兽出没，","poem":1},{"lineBreak":true},{"text":"野山羊对叫，","poem":1},{"lineBreak":true},{"text":"夜间的怪物在那里栖息，","poem":1},{"lineBreak":true},{"text":"找到安歇之处。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"猫头鹰在那里做窝，","poem":1},{"lineBreak":true},{"text":"下蛋，孵化，","poem":1},{"lineBreak":true},{"text":"把幼鸟保护在翅膀底下，","poem":1},{"lineBreak":true},{"text":"鸷鸟也成双成对地聚集在那里。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"你们要去查考并阅读耶和华的书卷：","poem":1},{"lineBreak":true},{"text":"以上的动物必一个不少，","poem":1},{"lineBreak":true},{"text":"无一缺少配偶。","poem":1},{"lineBreak":true},{"text":"因为这是耶和华亲口说的，","poem":1},{"lineBreak":true},{"text":"祂的灵必把它们聚在一起。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂亲手为它们抽签，","poem":1},{"lineBreak":true},{"text":"用准绳为它们分地。","poem":1},{"lineBreak":true},{"text":"它们必永远占据那里，","poem":1},{"lineBreak":true},{"text":"世世代代住在那里。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}