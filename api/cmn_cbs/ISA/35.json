{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbs","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"632dd4147026fa600518a3f00c24b6fa8a338b17185b54576ae9104ec0242142","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbs/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":35,"content":[{"type":"heading","content":["圣洁之路"]},{"type":"verse","number":1,"content":["沙漠和干旱之地必欢喜；",{"text":"旷野必快乐，开满鲜花，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"无比繁盛，充满欢声笑语，","poem":1},{"lineBreak":true},{"text":"享有黎巴嫩的荣耀、","poem":1},{"lineBreak":true},{"text":"迦密和沙仑的荣美。","poem":1},{"lineBreak":true},{"text":"人们必看见耶和华的荣耀，","poem":1},{"lineBreak":true},{"text":"我们上帝的荣美。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你们要使软弱的人强壮，","poem":1},{"lineBreak":true},{"text":"使双膝无力的人站稳。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"要对胆怯的人说：","poem":1},{"lineBreak":true},{"text":"“你们要刚强，不要害怕。","poem":1},{"lineBreak":true},{"text":"看啊，你们的上帝必来为你们复仇，施行报应，","poem":1},{"lineBreak":true},{"text":"祂必来拯救你们。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"那时，瞎眼的必看见，","poem":1},{"lineBreak":true},{"text":"耳聋的必听见，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"瘸腿的必跳跃如鹿，","poem":1},{"lineBreak":true},{"text":"哑巴必欢呼歌唱；","poem":1},{"lineBreak":true},{"text":"旷野有泉水涌流，","poem":1},{"lineBreak":true},{"text":"沙漠里河川奔腾；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"炙热的沙漠变成池塘，","poem":1},{"lineBreak":true},{"text":"旱地涌出甘泉；","poem":1},{"lineBreak":true},{"text":"豺狼的巢穴长出青草、","poem":1},{"lineBreak":true},{"text":"芦苇和蒲草。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"那里必有一条大路，","poem":1},{"lineBreak":true},{"text":"被称为“圣洁之路”，","poem":1},{"lineBreak":true},{"text":"专供蒙救赎的人行走。","poem":1},{"lineBreak":true},{"text":"污秽的人都不能走这条路，","poem":1},{"lineBreak":true},{"text":"愚昧的人也不能信步其上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"那里必没有狮子，","poem":1},{"lineBreak":true},{"text":"也没有恶兽，","poem":1},{"lineBreak":true},{"text":"没有它们的踪影，","poem":1},{"lineBreak":true},{"text":"只有蒙救赎的人行走。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华救赎的子民必归回，","poem":1},{"lineBreak":true},{"text":"欢唱着回到锡安，","poem":1},{"lineBreak":true},{"text":"永远的福乐必临到他们头上。","poem":1},{"lineBreak":true},{"text":"他们必欢喜快乐，","poem":1},{"lineBreak":true},{"text":"再没有忧愁和叹息。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}