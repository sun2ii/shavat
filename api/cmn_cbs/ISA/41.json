{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbs","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"632dd4147026fa600518a3f00c24b6fa8a338b17185b54576ae9104ec0242142","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbs/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":41,"content":[{"type":"heading","content":["上帝是以色列的帮助"]},{"type":"verse","number":1,"content":[{"text":"上帝说：“众海岛啊，","poem":1},{"lineBreak":true},{"text":"要在我面前安静！","poem":1},{"lineBreak":true},{"text":"让众民重新得力，","poem":1},{"lineBreak":true},{"text":"让他们前来说话，","poem":1},{"lineBreak":true},{"text":"让我们一起来理论。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“谁使一人从东方兴起？","poem":1},{"lineBreak":true},{"text":"谁凭公义把他召到跟前？","poem":1},{"lineBreak":true},{"text":"谁把列国交给他，","poem":1},{"lineBreak":true},{"text":"使他征服列国的君王，","poem":1},{"lineBreak":true},{"text":"用刀将他们化为尘土，","poem":1},{"lineBreak":true},{"text":"用弓驱散他们如风吹的碎秸？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他追赶他们，","poem":1},{"lineBreak":true},{"text":"安然走过从未踏足之路。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"谁成就了这事？","poem":1},{"lineBreak":true},{"text":"谁从太初就决定各个世代？","poem":1},{"lineBreak":true},{"text":"是我耶和华，","poem":1},{"lineBreak":true},{"text":"我太初就在那里，","poem":1},{"lineBreak":true},{"text":"末了也在那里。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“众海岛看见就害怕，","poem":1},{"lineBreak":true},{"text":"地极也颤抖，","poem":1},{"lineBreak":true},{"text":"他们都上前来，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"彼此帮助，","poem":1},{"lineBreak":true},{"text":"互相勉励说，‘要刚强！’","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"工匠鼓励金匠，","poem":1},{"lineBreak":true},{"text":"打磨的勉励打砧的，","poem":1},{"lineBreak":true},{"text":"谈到焊接的说，‘焊得好！’","poem":1},{"lineBreak":true},{"text":"他们用钉子把偶像钉牢，免得摇晃。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“然而，以色列啊，你是我的仆人；","poem":1},{"lineBreak":true},{"text":"雅各啊，你是我拣选的，","poem":1},{"lineBreak":true},{"text":"是我朋友亚伯拉罕的后裔。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我把你从地极带来，","poem":1},{"lineBreak":true},{"text":"从遥远的角落召来。","poem":1},{"lineBreak":true},{"text":"我对你说，‘你是我的仆人，","poem":1},{"lineBreak":true},{"text":"我拣选了你，没有丢弃你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你不要害怕，因为我与你同在，","poem":1},{"lineBreak":true},{"text":"你不要惊慌，因为我是你的上帝。","poem":1},{"lineBreak":true},{"text":"我必赐你力量，帮助你，","poem":1},{"lineBreak":true},{"text":"用我公义的右手扶持你。’","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“看啊，凡向你发怒的人必抱愧蒙羞；","poem":1},{"lineBreak":true},{"text":"与你为敌的人都要灭亡，","poem":1},{"lineBreak":true},{"text":"归于无有。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你寻找与你相争的人，","poem":1},{"lineBreak":true},{"text":"却找不到；","poem":1},{"lineBreak":true},{"text":"与你争战的人必归于无有。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因为我是你的上帝耶和华，","poem":1},{"lineBreak":true},{"text":"我拉着你的右手对你说，","poem":1},{"lineBreak":true},{"text":"‘不要怕，我必帮助你。’","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“蠕虫雅各啊，以色列人啊，不要怕！","poem":1},{"lineBreak":true},{"text":"你的救赎主——以色列的圣者耶和华说，","poem":1},{"lineBreak":true},{"text":"‘我必帮助你。’","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"看啊，我要使你成为一具簇新、","poem":1},{"lineBreak":true},{"text":"带许多利齿的打谷器。","poem":1},{"lineBreak":true},{"text":"你要打碎高山，","poem":1},{"lineBreak":true},{"text":"使丘陵碎如糠秕。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你要簸它们，让风吹散它们，","poem":1},{"lineBreak":true},{"text":"让狂风卷走它们。","poem":1},{"lineBreak":true},{"text":"但你要以耶和华为喜乐，","poem":1},{"lineBreak":true},{"text":"以以色列的圣者为荣耀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“贫穷困苦的人找不到水喝，","poem":1},{"lineBreak":true},{"text":"他们口干舌燥。","poem":1},{"lineBreak":true},{"text":"但我耶和华必应允他们的呼求，","poem":1},{"lineBreak":true},{"text":"我，以色列的上帝不会撇弃他们。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要使光秃的山岭上江河奔流，","poem":1},{"lineBreak":true},{"text":"山谷中泉水涌流；","poem":1},{"lineBreak":true},{"text":"我要使沙漠变成水塘，","poem":1},{"lineBreak":true},{"text":"使干地冒出泉水。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我要在旷野栽种香柏树、","poem":1},{"lineBreak":true},{"text":"皂荚树、番石榴树和橄榄树。","poem":1},{"lineBreak":true},{"text":"我要在沙漠种松树、杉树和黄杨树，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"好让人一看就知道，","poem":1},{"lineBreak":true},{"text":"一想就明白，","poem":1},{"lineBreak":true},{"text":"这是耶和华亲手所为，","poem":1},{"lineBreak":true},{"text":"是以色列的圣者创造的。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"耶和华对偶像说：","poem":1},{"lineBreak":true},{"text":"“陈明你们的主张吧。”","poem":1},{"lineBreak":true},{"text":"雅各的王说：","poem":1},{"lineBreak":true},{"text":"“摆出你们的证据吧。”","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"告诉我们将要发生的事，","poem":1},{"lineBreak":true},{"text":"告诉我们以前发生的事，","poem":1},{"lineBreak":true},{"text":"我们好思想并明白事情的结局。","poem":1},{"lineBreak":true},{"text":"向我们宣告将来的事，","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"告诉我们以后会发生什么，","poem":1},{"lineBreak":true},{"text":"好叫我们知道你们是神明。","poem":1},{"lineBreak":true},{"text":"不论降福降祸，","poem":1},{"lineBreak":true},{"text":"好叫我们一同惊惧！","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"看啊，你们实在算不得什么，","poem":1},{"lineBreak":true},{"text":"你们所做的毫无意义，","poem":1},{"lineBreak":true},{"text":"选择你们的人真是可憎！","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“我使一人从北方兴起，","poem":1},{"lineBreak":true},{"text":"他来了，","poem":1},{"lineBreak":true},{"text":"他在东方求告我的名。","poem":1},{"lineBreak":true},{"text":"他必把掌权者像灰泥一样踏在脚下，","poem":1},{"lineBreak":true},{"text":"像窑匠踩泥一样。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"谁从太初就宣告这事，让我们知道呢？","poem":1},{"lineBreak":true},{"text":"谁预先讲明这事，让我们说他是对的呢？","poem":1},{"lineBreak":true},{"text":"谁也没有宣告过，","poem":1},{"lineBreak":true},{"text":"谁也没有预言过，","poem":1},{"lineBreak":true},{"text":"谁也没有听见你们说什么。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"是我首先告诉锡安的，","poem":1},{"lineBreak":true},{"text":"我给耶路撒冷一个报好消息的使者。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我看了看，没有一个出谋划策的。","poem":1},{"lineBreak":true},{"text":"我问话，没有一个回答。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"看啊，偶像全是假的，","poem":1},{"lineBreak":true},{"text":"毫无作为，铸像虚空如风。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}