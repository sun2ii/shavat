{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbs","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"632dd4147026fa600518a3f00c24b6fa8a338b17185b54576ae9104ec0242142","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbs/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":["愿你裂天而降，",{"text":"愿群山在你面前颤抖，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"使敌人认识你的威名，","poem":1},{"lineBreak":true},{"text":"使列国在你面前颤抖，","poem":1},{"lineBreak":true},{"text":"如火烧干柴使水沸腾。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你曾降临，行超乎我们预料的可畏之事，","poem":1},{"lineBreak":true},{"text":"那时群山在你面前颤抖。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"自古以来，人耳未曾听闻，","poem":1},{"lineBreak":true},{"text":"人眼也未曾见过除你之外的任何神明为信奉者行奇事。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你眷顾乐于行义、遵行你旨意的人。","poem":1},{"lineBreak":true},{"text":"我们不断地犯罪惹你发怒，","poem":1},{"lineBreak":true},{"text":"我们怎能得救呢？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我们都像污秽的人，","poem":1},{"lineBreak":true},{"text":"我们的义行不过像染了经血的衣服，","poem":1},{"lineBreak":true},{"text":"我们如叶子渐渐枯干，","poem":1},{"lineBreak":true},{"text":"我们的罪恶如风一样把我们吹去。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"无人呼求你，","poem":1},{"lineBreak":true},{"text":"无人紧紧依靠你，","poem":1},{"lineBreak":true},{"text":"因为你掩面不理我们，","poem":1},{"lineBreak":true},{"text":"让我们在自己的罪中灭亡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"但耶和华啊，你是我们的父亲。","poem":1},{"lineBreak":true},{"text":"我们是陶泥，你是窑匠，","poem":1},{"lineBreak":true},{"text":"我们都是你亲手所造的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华啊，求你不要大发烈怒，","poem":1},{"lineBreak":true},{"text":"不要永远记着我们的罪恶。","poem":1},{"lineBreak":true},{"text":"我们都是你的子民，","poem":1},{"lineBreak":true},{"text":"求你垂顾我们。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你的众圣城已沦为荒场，","poem":1},{"lineBreak":true},{"text":"锡安已沦为荒场，","poem":1},{"lineBreak":true},{"text":"耶路撒冷已沦为废墟。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我们那圣洁、华美的殿，就是我们祖先颂赞你的地方已被焚毁，","poem":1},{"lineBreak":true},{"text":"我们珍爱的一切都被摧毁。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华啊，你对这些事怎能坐视不理呢？","poem":1},{"lineBreak":true},{"text":"你仍然保持缄默，并重重地惩罚我们吗？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}