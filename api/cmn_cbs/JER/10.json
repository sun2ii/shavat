{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JER","translationId":"cmn_cbs","name":"耶利米书","commonName":"耶利米书","title":"耶利米书","order":24,"numberOfChapters":52,"sha256":"7cfd0f7ede9e6a98b1932bc84ae1a61e5449ad0039f95ebeb439ffee3b4ebab4","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cmn_cbs/JER/52.json","totalNumberOfVerses":1352},"chapter":{"number":10,"content":[{"type":"heading","content":["上帝与偶像"]},{"type":"verse","number":1,"content":["以色列家啊，听听耶和华对你们说的话吧！"]},{"type":"verse","number":2,"content":["耶和华说：",{"text":"“不要效法列国的行为。","poem":1},{"lineBreak":true},{"text":"他们被天象吓倒，","poem":1},{"lineBreak":true},{"text":"你们却不要因天象而害怕。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们信奉的毫无价值，","poem":1},{"lineBreak":true},{"text":"他们从林中砍一棵树，","poem":1},{"lineBreak":true},{"text":"工匠用凿子雕刻偶像，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"以金银作装饰，","poem":1},{"lineBreak":true},{"text":"用钉子和锤子钉牢，","poem":1},{"lineBreak":true},{"text":"以免晃动。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"它们像瓜园中的稻草人，","poem":1},{"lineBreak":true},{"text":"不能说话，不能行走，","poem":1},{"lineBreak":true},{"text":"需要人搬运。","poem":1},{"lineBreak":true},{"text":"你们不要怕它们，","poem":1},{"lineBreak":true},{"text":"它们既不能害人，","poem":1},{"lineBreak":true},{"text":"也不能助人。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和华啊，你无与伦比，","poem":1},{"lineBreak":true},{"text":"你真伟大，你的名充满力量！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"万国的王啊，谁不敬畏你？","poem":1},{"lineBreak":true},{"text":"敬畏你是理所当然的。","poem":1},{"lineBreak":true},{"text":"因为万国的智者和君王中无人能与你相比。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们都愚昧无知，","poem":1},{"lineBreak":true},{"text":"竟从无用的木头偶像受教！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"偶像上的银片来自他施，","poem":1},{"lineBreak":true},{"text":"金片来自乌法，","poem":1},{"lineBreak":true},{"text":"都是木匠和金匠的作品，","poem":1},{"lineBreak":true},{"text":"这些偶像穿的蓝色和紫色衣服都是巧匠制作的。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"唯有耶和华是真神，","poem":1},{"lineBreak":true},{"text":"是永活的上帝，","poem":1},{"lineBreak":true},{"text":"是永恒的君王。","poem":1},{"lineBreak":true},{"text":"祂一发怒，大地便震动，","poem":1},{"lineBreak":true},{"text":"列国都无法承受祂的烈怒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":["你们要这样对他们说：“那些神明没有创造天地，它们将从天地间消亡。”"]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和华以大能创造大地，","poem":1},{"lineBreak":true},{"text":"以智慧建立世界，","poem":1},{"lineBreak":true},{"text":"以聪明铺展诸天。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂一声令下，天上便大水澎湃；","poem":1},{"lineBreak":true},{"text":"祂使云从地极升起，","poem":1},{"lineBreak":true},{"text":"使闪电在雨中划过，","poem":1},{"lineBreak":true},{"text":"使风从祂的仓库吹出。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"世人都愚昧无知，","poem":1},{"lineBreak":true},{"text":"金匠都因所造的偶像而羞愧，","poem":1},{"lineBreak":true},{"text":"因为神像是骗人的，","poem":1},{"lineBreak":true},{"text":"它们没有生命气息。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"它们毫无价值，","poem":1},{"lineBreak":true},{"text":"荒唐可笑，","poem":1},{"lineBreak":true},{"text":"刑罚一到，必被毁灭。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"但雅各的上帝截然不同，","poem":1},{"lineBreak":true},{"text":"因为祂是万物的创造者，","poem":1},{"lineBreak":true},{"text":"以色列子民是祂的产业，","poem":1},{"lineBreak":true},{"text":"万军之耶和华是祂的名字。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"被围困的居民啊，","poem":1},{"lineBreak":true},{"text":"收拾行装离开吧！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因为耶和华说：","poem":1},{"lineBreak":true},{"text":"“看啊，这次我要把这地方的居民抛出去，","poem":1},{"lineBreak":true},{"text":"使他们苦不堪言方肯觉悟。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"我有祸了！因我的创伤难愈。","poem":1},{"lineBreak":true},{"text":"但我说：“这是疾病，我必须忍受。”","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的帐篷已毁，","poem":1},{"lineBreak":true},{"text":"绳索已断；","poem":1},{"lineBreak":true},{"text":"我的儿女都离我而去，踪影全无，","poem":1},{"lineBreak":true},{"text":"再没有人为我支搭帐篷，","poem":1},{"lineBreak":true},{"text":"挂上幔子。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"首领愚昧，","poem":1},{"lineBreak":true},{"text":"没有求问耶和华，","poem":1},{"lineBreak":true},{"text":"因此一败涂地，","poem":1},{"lineBreak":true},{"text":"百姓如羊群四散。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"听啊，有消息传来，","poem":1},{"lineBreak":true},{"text":"喧嚣的敌军从北方冲来，","poem":1},{"lineBreak":true},{"text":"要使犹大的城邑荒凉，","poem":1},{"lineBreak":true},{"text":"沦为豺狼的巢穴。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"耶和华啊，我知道人不能驾驭自己的命运，","poem":1},{"lineBreak":true},{"text":"不能左右自己的前程。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"耶和华啊，求你公正地惩罚我，","poem":1},{"lineBreak":true},{"text":"不要带着怒气惩罚我，","poem":1},{"lineBreak":true},{"text":"免得你使我不复存在。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"求你向不认识你的列国和不求告你名的民族发烈怒，","poem":1},{"lineBreak":true},{"text":"因为他们吞噬、毁灭雅各，","poem":1},{"lineBreak":true},{"text":"使他的家园一片荒凉。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}