{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"“我厌恶自己的生命，","poem":1},{"lineBreak":true},{"text":"我要倾诉我的哀怨，","poem":1},{"lineBreak":true},{"text":"吐露心中的苦水。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我对上帝说，‘不要定我的罪。","poem":1},{"lineBreak":true},{"text":"请告诉我，你为何指控我？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"难道你喜悦压迫、鄙视你造的人，","poem":1},{"lineBreak":true},{"text":"却青睐恶人的计谋？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"难道你的眼是肉眼，","poem":1},{"lineBreak":true},{"text":"目光如凡人一般？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"难道你的年日像人一样有限，","poem":1},{"lineBreak":true},{"text":"岁月如世人般短暂？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"以致你探查我的过犯，","poem":1},{"lineBreak":true},{"text":"追究我的罪愆？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"其实你知道我没有犯罪，","poem":1},{"lineBreak":true},{"text":"无人能从你手中解救我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“‘你亲手造我塑我，","poem":1},{"lineBreak":true},{"text":"现在却要毁灭我。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"别忘了你用泥土造我","poem":1},{"noteId":6},{"text":"，","poem":1},{"lineBreak":true},{"text":"难道要使我复归尘土？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你不是将我像奶一样倒出，","poem":1},{"lineBreak":true},{"text":"使我像奶酪一样凝固吗？","poem":1},{"noteId":7}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你给我穿上皮肉，","poem":1},{"lineBreak":true},{"text":"用筋骨把我编织。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你赐我生命给我慈爱，","poem":1},{"lineBreak":true},{"text":"你的眷顾使我保全性命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“‘但你心中藏着计划，","poem":1},{"lineBreak":true},{"text":"我知道你早有此意，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我若犯罪，你就鉴察，","poem":1},{"lineBreak":true},{"text":"不肯赦免我的罪。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我若有罪，便遭祸患；","poem":1},{"lineBreak":true},{"text":"即使清白，也不敢抬头，","poem":1},{"lineBreak":true},{"text":"因为我饱尝羞辱，吃尽苦头。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我若昂首挺立，","poem":1},{"lineBreak":true},{"text":"你会像狮子般追捕我，","poem":1},{"lineBreak":true},{"text":"再次施展大能攻击我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你重新派证人指控我，","poem":1},{"lineBreak":true},{"text":"你对我越来越愤怒，","poem":1},{"lineBreak":true},{"text":"使军队轮流攻击我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你为何让我出母腹？","poem":1},{"lineBreak":true},{"text":"我不如当时就死去，","poem":1},{"lineBreak":true},{"text":"不被世人看见，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"好像我从未出生，","poem":1},{"lineBreak":true},{"text":"一出母腹就被送进坟墓。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的年日不是所剩无几吗？","poem":1},{"lineBreak":true},{"text":"求你放过我，","poem":1},{"lineBreak":true},{"text":"让我欢乐片刻。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我很快就一去不返，","poem":1},{"lineBreak":true},{"text":"进入幽冥黑暗之地。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"那里一片漆黑，幽暗混乱；","poem":1},{"lineBreak":true},{"text":"那里的光犹如黑暗。’”","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"“用泥土造我”或译“把我造的像泥土”。","reference":{"chapter":10,"verse":9}},{"noteId":7,"caller":"+","text":"此句描述胚胎在母腹中如何成形。","reference":{"chapter":10,"verse":10}}]},"thisChapterLink":"/api/cmn_cbs/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}