{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":11,"content":[{"type":"heading","content":["琐法的回答"]},{"type":"verse","number":1,"content":[{"text":"拿玛人琐法回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“难道滔滔不绝就无人反驳？","poem":1},{"lineBreak":true},{"text":"难道唠唠叨叨就证明有理？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你喋喋不休，岂能使人缄默不言？","poem":1},{"lineBreak":true},{"text":"你嘲笑讥讽，岂不该有人使你羞愧？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你自以为信仰纯全，","poem":1},{"lineBreak":true},{"text":"在上帝眼中清白。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"唯愿上帝发言，","poem":1},{"lineBreak":true},{"text":"开口驳斥你，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"告诉你智慧的奥秘，","poem":1},{"lineBreak":true},{"text":"因为真智慧深奥难懂。","poem":1},{"lineBreak":true},{"text":"要知道，上帝没有追究你全部的罪愆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“你能测度上帝的深奥，","poem":1},{"lineBreak":true},{"text":"查明全能者的极限吗？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"那可比诸天还高，你能做什么？","poem":1},{"lineBreak":true},{"text":"那可比阴间还深，你能知道什么？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"那可比大地还宽广，","poem":1},{"lineBreak":true},{"text":"比海洋还辽阔。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂若来囚禁你，","poem":1},{"lineBreak":true},{"text":"开庭审判，","poem":1},{"lineBreak":true},{"text":"谁能阻拦？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂洞悉诡诈之人，","poem":1},{"lineBreak":true},{"text":"看见罪恶，","poem":1},{"lineBreak":true},{"text":"岂会不理？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"愚蠢人若能变得聪明，","poem":1},{"lineBreak":true},{"text":"野驴驹也可生成人样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“你若把心安正，","poem":1},{"lineBreak":true},{"text":"向祂伸出双手；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你若除去手中的罪恶，","poem":1},{"lineBreak":true},{"text":"不容帐篷里有任何不义，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"就必能无愧地仰起脸，","poem":1},{"lineBreak":true},{"text":"站立得稳，无所畏惧。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你必忘记自己的苦楚，","poem":1},{"lineBreak":true},{"text":"它从你记忆中如流水逝去。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你的人生将比正午还光明，","poem":1},{"lineBreak":true},{"text":"生命中的黑暗也必像黎明。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你必安稳，因有盼望，","poem":1},{"lineBreak":true},{"text":"你必得到保护，安然歇息。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你睡觉时必无人惊扰，","poem":1},{"lineBreak":true},{"text":"许多人必求你施恩。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"但恶人必眼目失明，无路可逃，","poem":1},{"lineBreak":true},{"text":"他们的指望只有死亡。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}