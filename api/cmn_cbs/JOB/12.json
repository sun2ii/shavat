{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":12,"content":[{"type":"heading","content":["约伯的回答"]},{"type":"verse","number":1,"content":["约伯回答说："]},{"type":"verse","number":2,"content":[{"text":"“你们真是重要人物，","poem":1},{"lineBreak":true},{"text":"你们死了，智慧也会消逝！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"但我也有心智，不比你们逊色。","poem":1},{"lineBreak":true},{"text":"你们说的，谁不知道？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我这求告上帝并蒙祂应允的人竟成了朋友的笑柄，","poem":1},{"lineBreak":true},{"text":"我这公义纯全的人竟成了笑柄。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"安逸的人心中藐视灾祸，","poem":1},{"lineBreak":true},{"text":"灾祸随时临到滑倒的人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"强盗的帐篷太平，","poem":1},{"lineBreak":true},{"text":"冒犯上帝、手捧神像的人安稳。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“你去问走兽，它们会指教你；","poem":1},{"lineBreak":true},{"text":"问天上的飞禽，它们会告诉你；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"向大地讨教，大地会指教你，","poem":1},{"lineBreak":true},{"text":"或让海中的鱼为你阐明。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"它们当中哪个不知这是耶和华亲手所为？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"所有生命都在祂手中，","poem":1},{"lineBreak":true},{"text":"世人的气息也不例外。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耳朵岂不辨别话语，","poem":1},{"lineBreak":true},{"text":"舌头岂不品尝食物？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"智慧与老人相伴，","poem":1},{"lineBreak":true},{"text":"知识与长者为伍。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“上帝有智慧和权能，","poem":1},{"lineBreak":true},{"text":"谋略和知识属于祂。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂拆毁的，无法重建；","poem":1},{"lineBreak":true},{"text":"祂囚禁的，无法获释。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂拦住水源，便有干旱；","poem":1},{"lineBreak":true},{"text":"祂放开水源，大地被淹没。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"祂充满力量和智慧。","poem":1},{"lineBreak":true},{"text":"骗子和受骗者都在祂权下。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂使谋士赤身被掳，","poem":1},{"lineBreak":true},{"text":"使审判官愚拙不堪。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂除去君王的腰带，","poem":1},{"lineBreak":true},{"text":"在他们腰间绑上囚索。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂使祭司赤身被掳，","poem":1},{"lineBreak":true},{"text":"祂推翻久握大权者。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"祂夺去谋士的口才，","poem":1},{"lineBreak":true},{"text":"祂拿走长者的洞见。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"祂使权贵倍受羞辱，","poem":1},{"lineBreak":true},{"text":"祂除掉强者的权势。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"祂揭露黑暗中的奥秘，","poem":1},{"lineBreak":true},{"text":"祂把幽暗带入光明中。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"祂使列国兴起又灭亡，","poem":1},{"lineBreak":true},{"text":"祂使列国扩张又崩溃。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"祂夺去世人首领的心智，","poem":1},{"lineBreak":true},{"text":"使他们在无路的荒野流浪。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他们在无光的黑暗中摸索，","poem":1},{"lineBreak":true},{"text":"像醉汉般踉踉跄跄。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}