{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"“这一切，我亲眼见过，","poem":1},{"lineBreak":true},{"text":"亲耳听过，且已明白。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们知道的我也知道，","poem":1},{"lineBreak":true},{"text":"我不比你们逊色。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"但我想和全能者对话，","poem":1},{"lineBreak":true},{"text":"我渴望跟上帝理论。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你们却编造谎言，","poem":1},{"lineBreak":true},{"text":"都是无用的医生。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但愿你们闭口不言，","poem":1},{"lineBreak":true},{"text":"那样还算你们明智。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"请听我的申辩，","poem":1},{"lineBreak":true},{"text":"留心听我口中的争讼。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你们要为上帝说谎，","poem":1},{"lineBreak":true},{"text":"为祂说诡诈的话吗？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你们要偏袒上帝吗？","poem":1},{"lineBreak":true},{"text":"你们要替祂辩护吗？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂查问你们时岂会有好结果？","poem":1},{"lineBreak":true},{"text":"你们岂能像欺骗人一样欺骗祂？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你们若暗中偏袒，","poem":1},{"lineBreak":true},{"text":"祂必责备你们。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"难道祂的威严不令你们恐惧吗？","poem":1},{"lineBreak":true},{"text":"难道你们不对祂充满敬畏吗？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你们的名言是无用的灰烬，","poem":1},{"lineBreak":true},{"text":"你们的雄辩是土筑的营垒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“你们住口，让我发言；","poem":1},{"lineBreak":true},{"text":"我愿承担一切后果。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我已经豁出性命，","poem":1},{"lineBreak":true},{"text":"不惜冒生命危险。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂必杀我，我毫无指望，","poem":1},{"noteId":8},{"lineBreak":true},{"text":"但我仍要在祂面前为自己申辩。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"这样我才能得救，","poem":1},{"lineBreak":true},{"text":"因为不信上帝的人不可到祂面前。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"请留心听我说话，","poem":1},{"lineBreak":true},{"text":"侧耳听我发言。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"看啊，我已准备好辩词，","poem":1},{"lineBreak":true},{"text":"我知道自己有理。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"若有人能指控我，","poem":1},{"lineBreak":true},{"text":"我就缄默，情愿死去。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"上帝啊，只求你应允我两件事，","poem":1},{"lineBreak":true},{"text":"我就不躲避你的面，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"求你把手从我身上挪开，","poem":1},{"lineBreak":true},{"text":"不要用你的威严惊吓我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"这样，你传唤我，我必回应；","poem":1},{"lineBreak":true},{"text":"或者让我陈述，你来回答。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我究竟有什么过错和罪恶？","poem":1},{"lineBreak":true},{"text":"求你指出我的过犯和罪愆。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你为何掩面不看我？","poem":1},{"lineBreak":true},{"text":"为何把我当作仇敌？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你要恐吓一片风中的落叶吗？","poem":1},{"lineBreak":true},{"text":"你要追赶枯干的草芥吗？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你记下指控我的罪状，","poem":1},{"lineBreak":true},{"text":"让我承担幼年的罪恶。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你给我上了脚镣，","poem":1},{"lineBreak":true},{"text":"监视我的一举一动，","poem":1},{"lineBreak":true},{"text":"为我的脚掌设界限。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我消逝如朽烂之物，","poem":1},{"lineBreak":true},{"text":"又如虫蛀的衣服。","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":8,"caller":"+","text":"“祂必杀我，我毫无指望”或译“即使祂杀我，我也信靠祂”。","reference":{"chapter":13,"verse":15}}]},"thisChapterLink":"/api/cmn_cbs/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}