{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"“人为妇人所生，","poem":1},{"lineBreak":true},{"text":"一生短暂，充满患难。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他如花盛开，转眼凋谢；","poem":1},{"lineBreak":true},{"text":"如影消逝，无法久留。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你还察看这样的世人吗？","poem":1},{"lineBreak":true},{"text":"还要把我带来受审吗？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"谁能使污秽产生洁净呢？","poem":1},{"lineBreak":true},{"text":"没有人能。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"人的年日已被限定，","poem":1},{"lineBreak":true},{"text":"你掌管他的岁月，","poem":1},{"lineBreak":true},{"text":"设定他无法逾越的界限。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你转身，别去管他，","poem":1},{"lineBreak":true},{"text":"好让他如雇工度完他的日子。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"树木若被砍下，还有希望，","poem":1},{"lineBreak":true},{"text":"它仍可重新萌芽，","poem":1},{"lineBreak":true},{"text":"嫩枝生长不息。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"虽然树根在土里衰老，","poem":1},{"lineBreak":true},{"text":"树桩在地里死去，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"但一有水气，","poem":1},{"lineBreak":true},{"text":"它就会像新栽的树一样发芽长枝。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"但人一死，就失去力量；","poem":1},{"lineBreak":true},{"text":"人一咽气，就不知去向。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"湖水会枯竭，","poem":1},{"lineBreak":true},{"text":"江河会干涸，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"人躺下便不再起来，","poem":1},{"lineBreak":true},{"text":"到诸天不复存在，","poem":1},{"lineBreak":true},{"text":"他仍不会醒来，","poem":1},{"lineBreak":true},{"text":"不会从长眠中被唤醒。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"但愿你把我藏在阴间，","poem":1},{"lineBreak":true},{"text":"把我藏起来直到你息怒，","poem":1},{"lineBreak":true},{"text":"定下眷顾我的日期。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人若死了，还能复生吗？","poem":1},{"lineBreak":true},{"text":"我要在劳苦的岁月中等待，","poem":1},{"lineBreak":true},{"text":"直到我得释放的日子来临。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"那时你呼唤，我便回应，","poem":1},{"lineBreak":true},{"text":"你必惦念你亲手所造之物。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"那时你必数算我的脚步，","poem":1},{"lineBreak":true},{"text":"但不会追究我的罪恶。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的过犯会被封在袋中，","poem":1},{"lineBreak":true},{"text":"你会遮盖我的罪愆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“高山崩塌，","poem":1},{"lineBreak":true},{"text":"磐石挪移；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"流水磨损石头，","poem":1},{"lineBreak":true},{"text":"急流冲走泥土；","poem":1},{"lineBreak":true},{"text":"你也这样粉碎人的希望。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你永远击败他，使他消逝；","poem":1},{"lineBreak":true},{"text":"你改变他的容颜，让他离世。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他的后人得尊荣，他无从知晓；","poem":1},{"lineBreak":true},{"text":"他们遭贬抑，他也无法察觉。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他只感受到自身的痛苦，","poem":1},{"lineBreak":true},{"text":"只为自己哀哭。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}