{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":15,"content":[{"type":"heading","content":["以利法再次发言"]},{"type":"verse","number":1,"content":["提幔人以利法回答说："]},{"type":"verse","number":2,"content":[{"text":"“智者岂会用空谈作答，","poem":1},{"lineBreak":true},{"text":"满腹东风？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"申辩时岂会讲无用的话，","poem":1},{"lineBreak":true},{"text":"说无益之言？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你摒弃对上帝的敬畏，","poem":1},{"lineBreak":true},{"text":"拒绝向祂默祷。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的罪指示你开口，","poem":1},{"lineBreak":true},{"text":"使你说出诡诈之言。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"并非我定你的罪，","poem":1},{"lineBreak":true},{"text":"定你罪的是你的口，","poem":1},{"lineBreak":true},{"text":"指控你的是你的嘴唇。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你岂是第一个出生的人？","poem":1},{"lineBreak":true},{"text":"你岂在群山之前被造？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你岂听过上帝的密旨？","poem":1},{"lineBreak":true},{"text":"你岂独揽智慧？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"有何事你知而我们不知，","poem":1},{"lineBreak":true},{"text":"你懂而我们不懂？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我们这里有白发老人，","poem":1},{"lineBreak":true},{"text":"比你父亲还年长。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝用温柔的话安慰你，","poem":1},{"lineBreak":true},{"text":"难道你还嫌不够吗？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你为何失去理智，","poem":1},{"lineBreak":true},{"text":"为何双眼冒火，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"以致你向上帝发怒，","poem":1},{"lineBreak":true},{"text":"口出恶言？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人算什么，怎能纯洁？","poem":1},{"lineBreak":true},{"text":"妇人所生的算什么，怎能公义？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"连上帝的圣者都无法令祂信任，","poem":1},{"lineBreak":true},{"text":"连诸天在祂的眼中都不洁净，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"更何况可憎败坏、","poem":1},{"lineBreak":true},{"text":"嗜恶如喝水的世人？","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“让我告诉你，你好好听着。","poem":1},{"lineBreak":true},{"text":"我要把所见的陈明，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"那是智者的教导，","poem":1},{"lineBreak":true},{"text":"是他们未曾隐瞒的祖训。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"这片土地只赐给了他们，","poem":1},{"lineBreak":true},{"text":"没有外人在他们中间出入。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"恶人一生受折磨，","poem":1},{"lineBreak":true},{"text":"残暴之徒终身受苦。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他耳边响着恐怖的声音，","poem":1},{"lineBreak":true},{"text":"他安逸时遭强盗袭击。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他不指望能逃脱黑暗，","poem":1},{"lineBreak":true},{"text":"他注定要丧身刀下。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他到处流浪，寻找食物，","poem":1},{"lineBreak":true},{"text":"他知道黑暗之日快要来临。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"患难和痛苦使他害怕，","poem":1},{"lineBreak":true},{"text":"像预备上阵的君王一样压制他。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"因为他挥拳对抗上帝，","poem":1},{"lineBreak":true},{"text":"藐视全能者，","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"手拿坚盾狂妄地冲撞祂。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他满脸肥肉，","poem":1},{"lineBreak":true},{"text":"腰间堆满脂肪。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他活在毁灭的城邑，","poem":1},{"lineBreak":true},{"text":"住在被人废弃、","poem":1},{"lineBreak":true},{"text":"行将坍塌的房屋。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他不再富足，","poem":1},{"lineBreak":true},{"text":"家财不能久留，","poem":1},{"lineBreak":true},{"text":"地产无法加增。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他无法逃脱黑暗，","poem":1},{"lineBreak":true},{"text":"火焰要烧焦他的嫩枝，","poem":1},{"lineBreak":true},{"text":"上帝口中的气要毁灭他。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他不可自欺，信靠虚空，","poem":1},{"lineBreak":true},{"text":"因为虚空必成为他的回报。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"在他离世以前，虚空必临到他，","poem":1},{"lineBreak":true},{"text":"他的枝子再不会青绿。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他必像一棵葡萄树，","poem":1},{"lineBreak":true},{"text":"葡萄未熟已掉落；","poem":1},{"lineBreak":true},{"text":"又像一棵橄榄树，","poem":1},{"lineBreak":true},{"text":"花刚开便凋零。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"不信上帝之辈必不生育，","poem":1},{"lineBreak":true},{"text":"受贿者的帐篷必被火烧。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"他们心怀不轨，生出罪恶，","poem":1},{"lineBreak":true},{"text":"他们满腹诡诈。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}