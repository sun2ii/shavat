{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":16,"content":[{"type":"heading","content":["约伯的回答"]},{"type":"verse","number":1,"content":["约伯回答说："]},{"type":"verse","number":2,"content":[{"text":"“这些话，我听过很多，","poem":1},{"lineBreak":true},{"text":"你们的安慰无不让人愁烦。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们的空谈无休无止吗？","poem":1},{"lineBreak":true},{"text":"是什么惹你们说个不停？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"倘若你我易地而处，","poem":1},{"lineBreak":true},{"text":"我也能说你们那样的话，","poem":1},{"lineBreak":true},{"text":"滔滔不绝地攻击你们，","poem":1},{"lineBreak":true},{"text":"向你们摇头。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但我会对你们讲鼓励的话，","poem":1},{"lineBreak":true},{"text":"用劝慰之言减轻你们的痛苦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“我若申辩，痛苦不减；","poem":1},{"lineBreak":true},{"text":"我若缄默，痛苦犹在。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝啊，你无疑使我精疲力竭，","poem":1},{"lineBreak":true},{"text":"家破人亡，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你榨干了我，","poem":1},{"lineBreak":true},{"text":"使我骨瘦如柴，","poem":1},{"lineBreak":true},{"text":"这成了当面指控我的罪证。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"上帝在愤怒中撕裂我，迫害我，","poem":1},{"lineBreak":true},{"text":"向我咬牙切齿；","poem":1},{"lineBreak":true},{"text":"仇敌恶狠狠地盯着我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们嘲笑我，","poem":1},{"lineBreak":true},{"text":"轻蔑地掴我的脸，","poem":1},{"lineBreak":true},{"text":"联合起来攻击我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝把我交给罪人，","poem":1},{"lineBreak":true},{"text":"把我扔到恶人手中。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我本来平顺，祂击垮了我，","poem":1},{"lineBreak":true},{"text":"祂抓住我的颈项将我摔碎，","poem":1},{"lineBreak":true},{"text":"把我当祂的箭靶。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂的弓箭手四面围住我，","poem":1},{"lineBreak":true},{"text":"祂毫不留情地刺透我的肾脏，","poem":1},{"lineBreak":true},{"text":"使我肝胆涂地。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂一次次地击伤我，","poem":1},{"lineBreak":true},{"text":"像勇士一样扑向我。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我将麻衣缝在皮肤上，","poem":1},{"lineBreak":true},{"text":"把我的荣耀埋在尘土中。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我哭得脸颊红肿，","poem":1},{"lineBreak":true},{"text":"眼皮发黑。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"但我未行残暴之事，","poem":1},{"lineBreak":true},{"text":"我的祷告纯真。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“大地啊！不要掩盖我的血，","poem":1},{"lineBreak":true},{"text":"不要让我的呼求销声匿迹。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"此时，我的见证人在天上，","poem":1},{"lineBreak":true},{"text":"我的辩护者在高天上。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的朋友讥笑我，","poem":1},{"lineBreak":true},{"text":"我在上帝面前泪水涌流。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"但愿人与上帝之间有仲裁者，","poem":1},{"lineBreak":true},{"text":"如同人与人之间。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为我的年日不多，","poem":1},{"lineBreak":true},{"text":"我快要踏上不归路。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}