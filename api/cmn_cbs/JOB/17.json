{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"“我的心灵破碎，我的年日将尽，","poem":1},{"lineBreak":true},{"text":"坟墓等候着我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"无疑，嘲笑的人围着我，","poem":1},{"lineBreak":true},{"text":"我眼睁睁地看着他们挑衅。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝啊，求你为我作保。","poem":1},{"lineBreak":true},{"text":"除你以外，谁肯做我的保人？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你蒙蔽了他们的心智，","poem":1},{"lineBreak":true},{"text":"因此你必不让他们得胜。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"人为了分产业而控告朋友，","poem":1},{"lineBreak":true},{"text":"其子孙的眼睛要失明。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"上帝使我成了人们的笑柄，","poem":1},{"lineBreak":true},{"text":"他们在我脸上吐唾沫。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"哀伤使我眼目昏花，","poem":1},{"lineBreak":true},{"text":"我整个人骨瘦如柴。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"这使正直的人震惊，","poem":1},{"lineBreak":true},{"text":"使无辜的人起来讨伐不敬虔的人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"义人坚守自己的道，","poem":1},{"lineBreak":true},{"text":"手洁的人更有力量。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"来吧，你们众人再来，","poem":1},{"lineBreak":true},{"text":"我在你们中间不会找到一个智者。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的年日已尽，","poem":1},{"lineBreak":true},{"text":"我的计划破灭，","poem":1},{"lineBreak":true},{"text":"我的心愿落空。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们以黑夜为白昼，","poem":1},{"lineBreak":true},{"text":"说光明与黑暗相似。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我若期望阴间作我的家园，","poem":1},{"lineBreak":true},{"text":"在黑暗之地铺设我的床榻，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"称坟墓为父亲，","poem":1},{"lineBreak":true},{"text":"称蛆虫为母亲、姊妹，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"那么，我的希望在哪里？","poem":1},{"lineBreak":true},{"text":"谁能看到我的希望？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我的希望会跟我下到阴间，","poem":1},{"lineBreak":true},{"text":"与我同归尘土吗？”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}