{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":18,"content":[{"type":"heading","content":["比勒达发言"]},{"type":"verse","number":1,"content":["书亚人比勒达回答说："]},{"type":"verse","number":2,"content":[{"text":"“你要狡辩到何时呢？","poem":1},{"lineBreak":true},{"text":"你先想清楚，然后我们再谈。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"为何你把我们当作牲畜，","poem":1},{"lineBreak":true},{"text":"把我们视为蠢货？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你这气得要撕碎自己的人，","poem":1},{"lineBreak":true},{"text":"大地会因你而荒凉吗？","poem":1},{"lineBreak":true},{"text":"磐石会因你而挪移吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“恶人的光必熄灭。","poem":1},{"lineBreak":true},{"text":"他的火焰不再闪耀。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他帐篷中灯光暗淡，","poem":1},{"lineBreak":true},{"text":"他上面的灯熄灭了。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"恶人强劲的步伐变得蹒跚，","poem":1},{"lineBreak":true},{"text":"他必被自己的阴谋所害。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他自陷网罗，","poem":1},{"lineBreak":true},{"text":"步入圈套。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"套索缠住他的脚跟，","poem":1},{"lineBreak":true},{"text":"网罗紧紧地罩住他。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"土里埋着绊他的绳索，","poem":1},{"lineBreak":true},{"text":"路上有陷阱等待着他。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"恐惧四面笼罩着他，","poem":1},{"lineBreak":true},{"text":"步步紧追着他。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他饿得气力衰竭，","poem":1},{"lineBreak":true},{"text":"灾祸随时临到他。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"疾病侵蚀他的皮肉，","poem":1},{"lineBreak":true},{"text":"可怕的死亡吞噬他的肢体。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他被拖出安稳的帐篷，","poem":1},{"lineBreak":true},{"text":"被押到冥王","poem":1},{"noteId":9},{"text":"那里。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他的帐篷燃烧着烈焰，","poem":1},{"lineBreak":true},{"text":"他的居所撒满了硫磺。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他下面的根茎枯干，","poem":1},{"lineBreak":true},{"text":"上面的枝子枯萎。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他从世上销声匿迹，","poem":1},{"lineBreak":true},{"text":"无人记得他的名字。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他从光明中被赶入黑暗，","poem":1},{"lineBreak":true},{"text":"他被逐出这个世界。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他在本族中无子无孙，","poem":1},{"lineBreak":true},{"text":"他所居之地无人生还。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他的下场令西方的人震惊，","poem":1},{"lineBreak":true},{"text":"令东方的人战栗。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"这就是不义之人的归宿，","poem":1},{"lineBreak":true},{"text":"不认识上帝之人的下场。”","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"“冥王”希伯来文是“恐怖之王”。","reference":{"chapter":18,"verse":14}}]},"thisChapterLink":"/api/cmn_cbs/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}