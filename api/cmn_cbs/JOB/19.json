{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":19,"content":[{"type":"heading","content":["约伯的回答"]},{"type":"verse","number":1,"content":["约伯回答说："]},{"type":"verse","number":2,"content":[{"text":"“你们要折磨我多久？","poem":1},{"lineBreak":true},{"text":"用言语压碎我到何时？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们侮辱我已有十次之多，","poem":1},{"lineBreak":true},{"text":"苦待我也不以为耻。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"即使我真有过错，","poem":1},{"lineBreak":true},{"text":"也由我独自承担。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你们若真要妄自尊大，","poem":1},{"lineBreak":true},{"text":"利用我的耻辱来指责我，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"也该知道是上帝冤枉了我，","poem":1},{"lineBreak":true},{"text":"用网罗套住我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我喊冤，却无人回应；","poem":1},{"lineBreak":true},{"text":"我呼救，却不见公道。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"上帝筑起墙垒，阻断我的路，","poem":1},{"lineBreak":true},{"text":"祂使黑暗笼罩我的路途。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂剥去我的荣耀，","poem":1},{"lineBreak":true},{"text":"摘走我头上的冠冕。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂从四面攻击我，直到我消逝；","poem":1},{"lineBreak":true},{"text":"祂把我的希望像树一样连根拔除。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂向我发烈怒，","poem":1},{"lineBreak":true},{"text":"视我为仇敌。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂的大军蜂拥而来，","poem":1},{"lineBreak":true},{"text":"筑起围城坡道攻击我，","poem":1},{"lineBreak":true},{"text":"在我帐篷四周扎营。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“祂使我的弟兄远离我，","poem":1},{"lineBreak":true},{"text":"我的熟人完全背弃我。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我的亲属离开我，","poem":1},{"lineBreak":true},{"text":"我的挚友忘记我。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的客人和婢女都视我如陌路，","poem":1},{"lineBreak":true},{"text":"把我当作外族人。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我呼唤仆人，他却不回应；","poem":1},{"lineBreak":true},{"text":"我开口哀求，他也不理睬。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我妻子厌恶我的气息，","poem":1},{"lineBreak":true},{"text":"我的手足都嫌弃我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"连小孩子都鄙视我；","poem":1},{"lineBreak":true},{"text":"我一出现，他们就嘲笑我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的密友都憎恶我，","poem":1},{"lineBreak":true},{"text":"我爱的人也反对我。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我瘦得只剩下皮包骨，","poem":1},{"lineBreak":true},{"text":"我离死亡仅一线之隔","poem":1},{"noteId":10},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“我的朋友啊，可怜我吧！可怜我吧！","poem":1},{"lineBreak":true},{"text":"因为上帝的手击打我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你们为何像上帝一样逼我？","poem":1},{"lineBreak":true},{"text":"为何吃了我的肉还不满足？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"但愿把我的话写下来，","poem":1},{"lineBreak":true},{"text":"记录在书卷上，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"用铁笔和铅镌刻在磐石上，","poem":1},{"lineBreak":true},{"text":"直存到永远。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我知道我的救赎主活着，","poem":1},{"lineBreak":true},{"text":"最后祂必站在地上。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我的皮肉虽然要朽烂，","poem":1},{"lineBreak":true},{"text":"但我必活着","poem":1},{"noteId":11},{"text":"见上帝。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我要亲自见祂，","poem":1},{"lineBreak":true},{"text":"我要亲眼见祂。","poem":1},{"lineBreak":true},{"text":"我心中充满渴望！","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你们说祸根在我身上，","poem":1},{"lineBreak":true},{"text":"还想继续迫害我。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你们自己应当畏惧刀剑，","poem":1},{"lineBreak":true},{"text":"因为烈怒会带来刀剑的惩罚，","poem":1},{"lineBreak":true},{"text":"那时你们将知道有审判。”","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"“我离死亡仅一线之隔”希伯来文是“我只剩牙皮逃脱”。","reference":{"chapter":19,"verse":20}},{"noteId":11,"caller":"+","text":"“活着”或译“在肉体之外”。","reference":{"chapter":19,"verse":26}}]},"thisChapterLink":"/api/cmn_cbs/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}