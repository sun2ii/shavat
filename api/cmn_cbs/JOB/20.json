{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":20,"content":[{"type":"heading","content":["琐法再度发言"]},{"type":"verse","number":1,"content":["拿玛人琐法回答说："]},{"type":"verse","number":2,"content":[{"text":"“我感到烦躁不安，","poem":1},{"lineBreak":true},{"text":"心中有话不吐不快。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我听见侮辱我的斥责，","poem":1},{"lineBreak":true},{"text":"我的理智催促我回答。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"难道你不知道吗？从古至今，","poem":1},{"lineBreak":true},{"text":"自从世上有人以来，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"恶人得势不会长久，","poem":1},{"lineBreak":true},{"text":"不信上帝者的快乐转瞬即逝。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"虽然他傲气冲天，","poem":1},{"lineBreak":true},{"text":"把头挺到云端，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"终必如自己的粪便永远消亡，","poem":1},{"lineBreak":true},{"text":"见过他的人都不知他在何处。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他如梦消逝，踪影杳然；","poem":1},{"lineBreak":true},{"text":"如夜间的异象，飞逝而去。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"见过他的人不会再见到他，","poem":1},{"lineBreak":true},{"text":"他将从家乡消失无踪。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他的儿女要向穷人乞怜，","poem":1},{"lineBreak":true},{"text":"他要亲手偿还不义之财。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他的筋骨依然强健，","poem":1},{"lineBreak":true},{"text":"却要随他葬入尘土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“他以邪恶为甘饴，","poem":1},{"lineBreak":true},{"text":"将其藏在舌下，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"含在口中，","poem":1},{"lineBreak":true},{"text":"慢慢品味。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"这食物在腹中变质，","poem":1},{"lineBreak":true},{"text":"变成了蛇的毒液。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他要吐出所吞下的财富，","poem":1},{"lineBreak":true},{"text":"上帝要倒空他腹中之物。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他吸吮蛇的毒液，","poem":1},{"lineBreak":true},{"text":"被蛇的舌头害死。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他无法享用流淌不尽的奶与蜜。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他留不住劳碌的成果，","poem":1},{"lineBreak":true},{"text":"无法享用所赚的财富。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他欺压、抛弃穷人，","poem":1},{"lineBreak":true},{"text":"强占他人的房屋。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他贪欲无度，","poem":1},{"lineBreak":true},{"text":"不放过任何喜爱之物。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他吞掉一切所有，","poem":1},{"lineBreak":true},{"text":"他的福乐不能长久。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他在富足时将陷入困境，","poem":1},{"lineBreak":true},{"text":"各种灾祸将接踵而至。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"上帝的怒火如雨降在他身上，","poem":1},{"lineBreak":true},{"text":"填满他的肚腹。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他躲过了铁刃，","poem":1},{"lineBreak":true},{"text":"却被铜箭射穿。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"利箭穿透他的后背，","poem":1},{"lineBreak":true},{"text":"闪亮的箭头刺破他的胆囊，","poem":1},{"lineBreak":true},{"text":"恐怖笼罩着他。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他的财宝消失在幽冥中，","poem":1},{"lineBreak":true},{"text":"天火","poem":1},{"noteId":12},{"text":"要吞噬他，","poem":1},{"lineBreak":true},{"text":"焚毁他帐篷中残留的一切。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"天要揭露他的罪恶，","poem":1},{"lineBreak":true},{"text":"地要站出来指控他。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"在上帝发烈怒的日子，","poem":1},{"lineBreak":true},{"text":"洪流将席卷他的家产。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"这便是上帝给恶人的归宿，","poem":1},{"lineBreak":true},{"text":"是上帝让他们承受的结局。”","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"“天火”希伯来文是“非人手点燃的火”。","reference":{"chapter":20,"verse":26}}]},"thisChapterLink":"/api/cmn_cbs/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}