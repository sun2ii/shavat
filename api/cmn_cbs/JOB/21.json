{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":21,"content":[{"type":"heading","content":["约伯的回答"]},{"type":"verse","number":1,"content":[{"text":"约伯回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“你们仔细听我说，","poem":1},{"lineBreak":true},{"text":"便是给我的慰藉。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"请容忍我把话说完，","poem":1},{"lineBreak":true},{"text":"之后任凭你们嘲笑。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我岂是向人抱怨？","poem":1},{"lineBreak":true},{"text":"我有理由不耐烦。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你们看到我会大吃一惊，","poem":1},{"lineBreak":true},{"text":"吓得用手掩口。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我一想到自己，就心惊胆战，","poem":1},{"lineBreak":true},{"text":"浑身发抖。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"为何恶人活着，得享长寿，","poem":1},{"lineBreak":true},{"text":"势力强大？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们的儿孙围绕膝前，","poem":1},{"lineBreak":true},{"text":"他们得见后代茁壮成长。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们家中平安无惧，","poem":1},{"lineBreak":true},{"text":"他们不被上帝杖打。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们的公牛繁殖力强，","poem":1},{"lineBreak":true},{"text":"他们的母牛从不掉胎。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们让孩童像羊群一样走到户外，","poem":1},{"lineBreak":true},{"text":"尽情地欢跳。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们伴着铃鼓和竖琴歌唱，","poem":1},{"lineBreak":true},{"text":"在笛声中欢喜不已。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他们一生幸福，","poem":1},{"lineBreak":true},{"text":"安然下到阴间。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们对上帝说，‘离开我们，","poem":1},{"lineBreak":true},{"text":"我们不想学习你的道。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"全能者是谁，竟要我们事奉祂？","poem":1},{"lineBreak":true},{"text":"向祂祷告有何益处？’","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"看啊，他们的幸福不在他们手中；","poem":1},{"lineBreak":true},{"text":"因此，我决不苟同他们的谋划。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“恶人的灯何曾熄灭？","poem":1},{"lineBreak":true},{"text":"灾难何曾临到他们？","poem":1},{"lineBreak":true},{"text":"上帝何曾发怒使他们受苦？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们何曾像风中的碎秸，","poem":1},{"lineBreak":true},{"text":"像被暴风卷去的糠秕？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你们说上帝会把惩罚留给他们的儿女，","poem":1},{"lineBreak":true},{"text":"我认为不如报应在他们本人身上，","poem":1},{"lineBreak":true},{"text":"让他们亲自领教。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"愿他们亲眼看见自己灭亡。","poem":1},{"lineBreak":true},{"text":"愿他们喝下全能者的烈怒。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"因为他们的岁月一旦度尽，","poem":1},{"lineBreak":true},{"text":"又怎会关心身后的家人？","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“上帝既审判身居高位者，","poem":1},{"lineBreak":true},{"text":"谁还能传授知识给祂？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"有人至死仍充满活力，","poem":1},{"lineBreak":true},{"text":"尽享平靖安逸。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他营养充足，","poem":1},{"lineBreak":true},{"text":"骨骼健壮。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"有人至死心中苦痛，","poem":1},{"lineBreak":true},{"text":"从未尝过幸福的滋味。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"二者都埋入尘土，","poem":1},{"lineBreak":true},{"text":"被蛆虫覆盖。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我知道你们的想法，","poem":1},{"lineBreak":true},{"text":"并那些冤枉我的诡计。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你们问，‘权贵的房子如今何在？","poem":1},{"lineBreak":true},{"text":"恶人住的帐篷今在何方？’","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"难道你们没有问过旅客，","poem":1},{"lineBreak":true},{"text":"不接受他们的说法？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"就是恶人在灾难之日幸存，","poem":1},{"lineBreak":true},{"text":"在上帝发怒之日得以逃脱。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"谁会当面斥责他们的恶行，","poem":1},{"lineBreak":true},{"text":"因其所作所为而报应他们？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他们被抬入坟墓后，","poem":1},{"lineBreak":true},{"text":"还有人看守墓地。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他们在谷中的沃土安息，","poem":1},{"lineBreak":true},{"text":"送葬的人前拥后随，不计其数。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你们的空谈怎能安慰我？","poem":1},{"lineBreak":true},{"text":"你们的回答纯属荒谬。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}