{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":22,"content":[{"type":"heading","content":["以利法再次回答"]},{"type":"verse","number":1,"content":[{"text":"提幔人以利法回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“人对上帝能有何益处？","poem":1},{"lineBreak":true},{"text":"即使智者对祂又有何益？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"全能者岂会因你为人公义而喜悦，","poem":1},{"lineBreak":true},{"text":"因你行为纯全而获利？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂岂会因你敬虔而责备你、审判你？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你岂不是罪恶深重，","poem":1},{"lineBreak":true},{"text":"过犯无数？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你无故强取弟兄的物品作抵押，","poem":1},{"lineBreak":true},{"text":"剥去贫寒者的衣服，任其赤身露体。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你不给疲乏的人水喝，","poem":1},{"lineBreak":true},{"text":"不给饥饿的人食物。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"土地归了权贵，","poem":1},{"lineBreak":true},{"text":"只让显要占有。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你让寡妇空手而去，","poem":1},{"lineBreak":true},{"text":"你打断孤儿的臂膀。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因此你周围布满网罗，","poem":1},{"lineBreak":true},{"text":"恐惧突然笼罩你。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"黑暗遮掩你的视线，","poem":1},{"lineBreak":true},{"text":"洪水淹没你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“上帝岂不在高天之上吗？","poem":1},{"lineBreak":true},{"text":"看，天上的星宿何其高远！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你却说，‘上帝知道什么？","poem":1},{"lineBreak":true},{"text":"祂怎能穿透幽暗施行审判？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"当祂在穹苍巡弋时，","poem":1},{"lineBreak":true},{"text":"密云挡住祂的视线。’","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"难道你要走恶人的古道，","poem":1},{"lineBreak":true},{"text":"步他们的后尘？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他们死期未到便已夭逝，","poem":1},{"lineBreak":true},{"text":"他们的根基被洪涛卷走。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他们对上帝说，‘离开我们吧！","poem":1},{"lineBreak":true},{"text":"全能者能把我们怎么样？’","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"然而，是上帝把美物充满他们的家；","poem":1},{"lineBreak":true},{"text":"因此，我决不苟同他们的谋划。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"义人看见他们的结局便欢喜，","poem":1},{"lineBreak":true},{"text":"无辜者见了便嘲笑，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"说，‘我们的仇敌果然被铲除，","poem":1},{"lineBreak":true},{"text":"他们的财产已被火吞噬。’","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“你要顺从上帝，与祂和好，","poem":1},{"lineBreak":true},{"text":"福乐就会临到你。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你要接受祂的教诲，","poem":1},{"lineBreak":true},{"text":"把祂的话谨记在心。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你若归向全能者，就必得到恢复。","poem":1},{"lineBreak":true},{"text":"你若将罪恶从帐篷中远远赶走，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"将金子扔进尘土，","poem":1},{"lineBreak":true},{"text":"将俄斐的金子丢在布满石头的溪谷，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"全能者必成为你的金子，","poem":1},{"lineBreak":true},{"text":"成为你珍贵的银子。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"那时，你必以全能者为乐，","poem":1},{"lineBreak":true},{"text":"你必抬头仰望上帝。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你向祂祷告，祂必垂听，","poem":1},{"lineBreak":true},{"text":"你必向祂还所许的愿。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你想做的事都会成功，","poem":1},{"lineBreak":true},{"text":"必有光照亮你的道路。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"人遭贬抑时，你说，‘他们太高傲了。’","poem":1},{"lineBreak":true},{"text":"上帝拯救眼目低垂的人。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"祂甚至会解救有罪之人，","poem":1},{"lineBreak":true},{"text":"他们必因你的手清洁而获救。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}