{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":23,"content":[{"type":"heading","content":["约伯的回答"]},{"type":"verse","number":1,"content":[{"text":"约伯回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“我的哀诉至今充满苦楚，","poem":1},{"lineBreak":true},{"text":"祂的责罚使我呻吟不止。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"但愿我知道何处能寻见上帝，","poem":1},{"lineBreak":true},{"text":"知道怎样去祂的居所。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我好在祂面前陈明案情，","poem":1},{"lineBreak":true},{"text":"滔滔不绝地为自己申辩；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我好知道祂的答复，","poem":1},{"lineBreak":true},{"text":"明白祂对我说的话。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂会用大能与我争辩吗？","poem":1},{"lineBreak":true},{"text":"不会的，祂会垂听我的申诉，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"允许正直的人与祂理论，","poem":1},{"lineBreak":true},{"text":"审判者会让我永远脱罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“然而，我去东边，祂不在那里；","poem":1},{"lineBreak":true},{"text":"我到西边，也找不到祂。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂在北边工作，我看不见祂；","poem":1},{"lineBreak":true},{"text":"祂转到南边，我也看不见祂。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"但祂知道我的一举一动，","poem":1},{"lineBreak":true},{"text":"我被祂试炼后必如纯金。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我紧随祂的脚步，","poem":1},{"lineBreak":true},{"text":"持守祂的道，没有偏离。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我没有违背祂口中的诫命，","poem":1},{"lineBreak":true},{"text":"我珍视祂的话语胜过我日用的饮食。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂独行其事，谁能阻挡祂？","poem":1},{"lineBreak":true},{"text":"祂按自己的意愿行事。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂在我身上的计划必然实现，","poem":1},{"lineBreak":true},{"text":"祂还有许多这样的计划。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"所以，我在祂面前惊恐不安。","poem":1},{"lineBreak":true},{"text":"我想起这一切，便对祂充满恐惧。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"上帝使我心惊胆战，","poem":1},{"lineBreak":true},{"text":"全能者使我惊恐不安。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"然而，我不会因为置身黑暗，","poem":1},{"lineBreak":true},{"text":"被幽暗笼罩而缄默不言。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}