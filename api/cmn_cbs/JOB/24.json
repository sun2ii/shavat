{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"“全能者为何不定下审判的日期？","poem":1},{"lineBreak":true},{"text":"为何认识祂的人要空等一场？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"恶人挪移界石，","poem":1},{"lineBreak":true},{"text":"抢夺羊群去牧养。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们牵走孤儿的驴，","poem":1},{"lineBreak":true},{"text":"强取寡妇的牛作抵押。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们把贫民赶离正路，","poem":1},{"lineBreak":true},{"text":"地上的穷人被迫东躲西藏。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"穷人如荒漠中的野驴，","poem":1},{"lineBreak":true},{"text":"在荒地殷勤觅食，给儿女糊口。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们割田间的草料，","poem":1},{"lineBreak":true},{"text":"摘恶人剩余的葡萄。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们整夜赤身露体，","poem":1},{"lineBreak":true},{"text":"没有被子可以御寒。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们被山雨浇透，","poem":1},{"lineBreak":true},{"text":"只能在岩石下栖身。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"恶人夺去寡母怀中的孤儿，","poem":1},{"lineBreak":true},{"text":"强取穷人的孩子作抵押，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"使他们赤身露体地流浪，","poem":1},{"lineBreak":true},{"text":"饿着肚子扛禾捆。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们在恶人的橄榄林中榨油，","poem":1},{"lineBreak":true},{"text":"在酒池踩踏，却受干渴之苦。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"城中传来垂死之人的呻吟，","poem":1},{"lineBreak":true},{"text":"受伤者不断呼救，","poem":1},{"lineBreak":true},{"text":"上帝却置之不理。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“有人与光明为敌，","poem":1},{"lineBreak":true},{"text":"不认识光明之道，","poem":1},{"lineBreak":true},{"text":"也不走光明之路。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"凶手黎明起来，","poem":1},{"lineBreak":true},{"text":"杀害贫苦的人，","poem":1},{"lineBreak":true},{"text":"夜晚又去做贼。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"奸夫的眼睛盼着黄昏，","poem":1},{"lineBreak":true},{"text":"心想，‘没人会看见我’，","poem":1},{"lineBreak":true},{"text":"并把脸蒙起来。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"盗贼夜间挖墙行窃，","poem":1},{"lineBreak":true},{"text":"日间躲藏起来，","poem":1},{"lineBreak":true},{"text":"不想认识光明。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因为他们把暗夜当白昼，","poem":1},{"lineBreak":true},{"text":"他们熟知暗夜的恐怖。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“恶人如水上的泡沫。","poem":1},{"lineBreak":true},{"text":"他们的产业被咒诅，","poem":1},{"lineBreak":true},{"text":"无人踏足其葡萄园。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"阴间吞噬犯罪之人，","poem":1},{"lineBreak":true},{"text":"如同干热吞噬融雪。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他们的生母忘记他们，","poem":1},{"lineBreak":true},{"text":"虫子在他们身上饱餐。","poem":1},{"lineBreak":true},{"text":"没有人再记得他们，","poem":1},{"lineBreak":true},{"text":"恶人像树木一样折断。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们恶待不育的妇人，","poem":1},{"lineBreak":true},{"text":"毫不善待寡妇。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"但上帝用大能掳走权贵，","poem":1},{"lineBreak":true},{"text":"他们再强大也难保性命。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"上帝让他们暂享安逸，","poem":1},{"lineBreak":true},{"text":"但他们逃不过祂的眼睛。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他们一时得势，转瞬消逝；","poem":1},{"lineBreak":true},{"text":"他们沦为卑贱，像其他人一样灭亡，","poem":1},{"lineBreak":true},{"text":"像麦穗一样被割掉。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我说的都是实情，谁能否认？","poem":1},{"lineBreak":true},{"text":"谁能证明我的话是空谈？”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}