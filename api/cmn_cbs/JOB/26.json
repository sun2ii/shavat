{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":26,"content":[{"type":"heading","content":["约伯的回答"]},{"type":"verse","number":1,"content":[{"text":"约伯回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“你真是帮了软弱者的大忙！","poem":1},{"lineBreak":true},{"text":"救了臂膀无力的人！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"无智慧的人真多亏你的指教！","poem":1},{"lineBreak":true},{"text":"承蒙你的真知灼见！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"谁帮你说出这些话？","poem":1},{"lineBreak":true},{"text":"谁的灵在借着你发言？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“阴魂和水族在水底颤抖，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"阴间裸露在祂面前，","poem":1},{"lineBreak":true},{"text":"灭亡之地毫无遮掩。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂将北极铺在空中，","poem":1},{"lineBreak":true},{"text":"将地悬在虚无中；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂将水卷在密云中，","poem":1},{"lineBreak":true},{"text":"云负重却不裂开。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂遮盖自己的宝座","poem":1},{"noteId":13},{"text":"，","poem":1},{"lineBreak":true},{"text":"把云彩铺在上面。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂在海面上画出地平线，","poem":1},{"lineBreak":true},{"text":"作为光明与黑暗的交界。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂的斥责使天柱震动惊骇，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂的能力使大海平静，","poem":1},{"lineBreak":true},{"text":"祂运用智慧击碎海怪。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂吹的气使天空晴朗，","poem":1},{"lineBreak":true},{"text":"祂挥手刺穿逃跑的蛇。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"看啊，这不过是祂作为的一斑，","poem":1},{"lineBreak":true},{"text":"是我们听到的点滴微音！","poem":1},{"lineBreak":true},{"text":"谁能领悟祂的雷霆万钧？”","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":13,"caller":"+","text":"“宝座”或译“满月”。","reference":{"chapter":26,"verse":9}}]},"thisChapterLink":"/api/cmn_cbs/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}