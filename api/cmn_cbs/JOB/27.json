{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"约伯接着说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“我凭不给我公道的永恒上帝，","poem":1},{"lineBreak":true},{"text":"凭使我灵魂陷入痛苦的全能者起誓，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"只要我一息尚存，","poem":1},{"lineBreak":true},{"text":"鼻中还有上帝之气，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的嘴唇决不说恶语，","poem":1},{"lineBreak":true},{"text":"舌头决不讲谎话。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我决不承认你们有理，","poem":1},{"lineBreak":true},{"text":"我至死坚信自己无辜。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我坚守自己的公义，决不放弃，","poem":1},{"lineBreak":true},{"text":"我有生之年都问心无愧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“愿我仇敌的下场和恶人一样，","poem":1},{"lineBreak":true},{"text":"愿我对头的结局和罪人相同。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因为不敬虔的人将被铲除，上帝将夺去他的性命。","poem":1},{"lineBreak":true},{"text":"那时，他还有何指望？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"患难临到他时，","poem":1},{"lineBreak":true},{"text":"上帝岂会垂听他的呼求？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他岂会以全能者为乐，","poem":1},{"lineBreak":true},{"text":"时时求告上帝？","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“我要教导你们有关上帝的能力，","poem":1},{"lineBreak":true},{"text":"我不会隐瞒全能者的作为。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"其实你们也曾亲眼目睹，","poem":1},{"lineBreak":true},{"text":"为何还讲这些虚妄之言？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“以下是上帝给恶人的归宿，","poem":1},{"lineBreak":true},{"text":"全能者让凶徒承受的结局。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他的儿女再多也难逃杀戮，","poem":1},{"lineBreak":true},{"text":"他的子孙永远无法果腹。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他幸存的后人被瘟疫吞噬，","poem":1},{"lineBreak":true},{"text":"家中的寡妇也不哀哭。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"尽管他堆积的银子多如尘沙，","poem":1},{"lineBreak":true},{"text":"储存的衣服高若土堆，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"但义人将穿他储存的衣服，","poem":1},{"lineBreak":true},{"text":"清白的人将分他的银子。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他建的房子像蛾茧，","poem":1},{"lineBreak":true},{"text":"像守望者搭的草棚。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他睡前还是富翁，","poem":1},{"lineBreak":true},{"text":"醒来后财富已空。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"恐惧如洪水般淹没他，","poem":1},{"lineBreak":true},{"text":"暴风在夜间把他卷去。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"东风把他刮走，","poem":1},{"lineBreak":true},{"text":"吹得无影无踪。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"狂风","poem":1},{"noteId":14},{"text":"毫不留情地击打他，","poem":1},{"lineBreak":true},{"text":"他拼命地逃离风的威力。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"狂风向他拍掌，","poem":1},{"lineBreak":true},{"text":"呼啸着吹走他。","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"“狂风”希伯来文指代不清，也可译作“祂”，指上帝，23节同。","reference":{"chapter":27,"verse":22}}]},"thisChapterLink":"/api/cmn_cbs/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}