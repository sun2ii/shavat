{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":28,"content":[{"type":"heading","content":["智慧颂"]},{"type":"verse","number":1,"content":[{"text":"“银从矿中采取，","poem":1},{"lineBreak":true},{"text":"金有冶炼之地，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"铁从地下挖掘，","poem":1},{"lineBreak":true},{"text":"铜从石中提炼。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"世人探寻黑暗的尽头，","poem":1},{"lineBreak":true},{"text":"搜索幽暗的深处，","poem":1},{"lineBreak":true},{"text":"要得隐藏的矿石。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们在杳无人烟、人踪绝迹之地开矿，","poem":1},{"lineBreak":true},{"text":"他们远离人群，悬在半空摇来摇去。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"大地出产粮食，","poem":1},{"lineBreak":true},{"text":"地下烈火翻腾。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"地下的石头出蓝宝石，","poem":1},{"lineBreak":true},{"text":"还蕴藏着金沙。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"矿中的路径，猛禽不知道，","poem":1},{"lineBreak":true},{"text":"鹰眼也未曾见过，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"猛兽未曾踏足，","poem":1},{"lineBreak":true},{"text":"狮子未曾经过。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"世人开凿坚石，","poem":1},{"lineBreak":true},{"text":"翻动山的根基，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"在岩石中凿通道，","poem":1},{"lineBreak":true},{"text":"一览各样的宝藏。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们把水流截断，","poem":1},{"lineBreak":true},{"text":"使隐藏之物显露。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“然而，智慧何处寻？","poem":1},{"lineBreak":true},{"text":"聪明之道在哪里？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"无人知道智慧的价值，","poem":1},{"lineBreak":true},{"text":"人世间找不到她。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"深渊说，‘她不在我里面。’","poem":1},{"lineBreak":true},{"text":"海洋说，‘她不在我这里。’","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"金子买不到她，","poem":1},{"lineBreak":true},{"text":"银子换不来她；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"俄斐的金子无法与她相比，","poem":1},{"lineBreak":true},{"text":"红玛瑙和蓝宝石不能与她媲美；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"黄金和水晶无法与她相比，","poem":1},{"lineBreak":true},{"text":"纯金的器皿不能与她兑换；","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"珊瑚和碧玉不能与她相提并论，","poem":1},{"lineBreak":true},{"text":"红宝石的价值远不如她；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"古实的黄玉无法与她相比，","poem":1},{"lineBreak":true},{"text":"纯金不能与她等量齐观。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“然而，智慧何处寻？","poem":1},{"lineBreak":true},{"text":"聪明之道在哪里？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"众生的眼睛看不见她，","poem":1},{"lineBreak":true},{"text":"空中的飞鸟找不到她。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"毁灭和死亡说，","poem":1},{"lineBreak":true},{"text":"‘我们只风闻其名。’","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"上帝认识通往智慧的路，","poem":1},{"lineBreak":true},{"text":"祂知道智慧在哪里，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"因祂纵览地极，","poem":1},{"lineBreak":true},{"text":"遍察天下万物。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"祂定下风的重量，","poem":1},{"lineBreak":true},{"text":"量出水的规模；","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"祂颁布雨露的规律，","poem":1},{"lineBreak":true},{"text":"划定雷电的路线。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"那时祂已看见智慧，并评估她，","poem":1},{"lineBreak":true},{"text":"坚立她，探察她。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"祂对世人说，‘敬畏主就是智慧，","poem":1},{"lineBreak":true},{"text":"远离恶便是聪明。’”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}