{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":29,"content":[{"type":"heading","content":["回忆昔日的幸福"]},{"type":"verse","number":1,"content":[{"text":"约伯接着说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“但愿我回到从前的岁月，","poem":1},{"lineBreak":true},{"text":"回到上帝看顾我的日子。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"那时，祂的灯在我头上照耀，","poem":1},{"lineBreak":true},{"text":"祂的光伴我走过黑暗。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"那时，我身强力壮，","poem":1},{"lineBreak":true},{"text":"上帝是我家的密友；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"全能者尚与我同在，","poem":1},{"lineBreak":true},{"text":"儿女围绕在我身旁；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我用奶油洗脚，","poem":1},{"lineBreak":true},{"text":"磐石为我涌出油河。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“那时，我去城门口，","poem":1},{"lineBreak":true},{"text":"到广场就坐，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"青年看见我便回避，","poem":1},{"lineBreak":true},{"text":"老人也起身肃立；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"王侯都停止讲话，","poem":1},{"lineBreak":true},{"text":"用手掩口；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"权贵都静默无声，","poem":1},{"lineBreak":true},{"text":"舌头紧贴上膛。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"听见我的都祝福我，","poem":1},{"lineBreak":true},{"text":"看见我的都称赞我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因为我拯救求助的穷人，","poem":1},{"lineBreak":true},{"text":"解救无人援助的孤儿。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"临终的人为我祝福，","poem":1},{"lineBreak":true},{"text":"我使寡妇心里欢唱。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我以公义为衣穿在身上，","poem":1},{"lineBreak":true},{"text":"公正是我的外袍和头巾。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我做盲人的眼、","poem":1},{"lineBreak":true},{"text":"瘸腿之人的脚；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我做穷人的父，","poem":1},{"lineBreak":true},{"text":"为陌生人申冤。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我打落恶人的毒牙，","poem":1},{"lineBreak":true},{"text":"从他们口中救出受害者。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“我想，‘我必在家中安然离世，","poem":1},{"lineBreak":true},{"text":"我的年日必多如尘沙。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的根伸展到水边，","poem":1},{"lineBreak":true},{"text":"枝子整夜沐浴甘露。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的尊荣永不褪色。","poem":1},{"lineBreak":true},{"text":"手中的弓常新不败。’","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“人们期待聆听我的话，","poem":1},{"lineBreak":true},{"text":"默然等候我的指教。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我讲完后，无人再发言；","poem":1},{"lineBreak":true},{"text":"我的话滋润他们的心田。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他们盼我如盼甘霖，","poem":1},{"lineBreak":true},{"text":"张着口如慕春雨。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我的微笑令他们受宠若惊，","poem":1},{"lineBreak":true},{"text":"他们从不使我脸色不悦。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我为他们选择道路，并且做首领，","poem":1},{"lineBreak":true},{"text":"我就像住在军中的君王，","poem":1},{"lineBreak":true},{"text":"又如伤心之人的安慰者。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}