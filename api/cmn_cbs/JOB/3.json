{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":3,"content":[{"type":"heading","content":["约伯咒诅自己"]},{"type":"verse","number":1,"content":["后来，约伯开口咒诅自己的生日，"]},{"type":"verse","number":2,"content":["说："]},{"type":"verse","number":3,"content":[{"text":"“愿我出生的那日和怀我的那夜都灭没。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"愿那日一片黑暗，","poem":1},{"lineBreak":true},{"text":"被天上的上帝遗忘，","poem":1},{"lineBreak":true},{"text":"没有阳光照耀。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愿那日被幽暗和浓浓的黑影笼罩，","poem":1},{"lineBreak":true},{"text":"被密云覆盖，","poem":1},{"lineBreak":true},{"text":"被阴暗淹没。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愿那夜被幽暗吞噬，","poem":1},{"lineBreak":true},{"text":"不列在年日中，","poem":1},{"lineBreak":true},{"text":"不算在岁月里。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愿那夜无人生育，","poem":1},{"lineBreak":true},{"text":"毫无快乐之声。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愿那些咒诅白日、","poem":1},{"lineBreak":true},{"text":"能惹动海怪的人，","poem":1},{"lineBreak":true},{"text":"咒诅那夜。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愿那夜的晨星昏暗，","poem":1},{"lineBreak":true},{"text":"等不到晨光的出现，","poem":1},{"lineBreak":true},{"text":"看不见黎明的眼帘。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因为那夜没有关闭我母胎的门，","poem":1},{"lineBreak":true},{"text":"也没有遮住我眼前的患难。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“为何我不出生时就夭折，","poem":1},{"lineBreak":true},{"text":"出母胎时就断气？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"为何要把我抱在膝上，","poem":1},{"lineBreak":true},{"text":"用乳汁哺育我？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"不然我早已安然躺卧、长眠安息，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"与世上的君王和谋臣作伴——他们为自己建造的宫殿已荒废，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"与房屋堆满金银的王侯同眠。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"为何我没有像未见天日就流产的婴儿一样消逝？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"那里，恶人不再搅扰，","poem":1},{"lineBreak":true},{"text":"疲惫者得到安息，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"被囚者得到安宁，","poem":1},{"lineBreak":true},{"text":"听不见监工的斥责。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"尊贵与卑贱的人都在那里，","poem":1},{"lineBreak":true},{"text":"奴仆不再受主人的辖制。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“为何赐光给受苦的人，","poem":1},{"lineBreak":true},{"text":"赐生命给心灵痛苦的人？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们等候死亡却等不到，","poem":1},{"lineBreak":true},{"text":"他们求死胜于求宝藏。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他们归入坟墓时非常快乐，","poem":1},{"lineBreak":true},{"text":"欣喜若狂。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"为何赐生命给前路渺茫、","poem":1},{"lineBreak":true},{"text":"被上帝围困的人？","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我以叹息为食，","poem":1},{"lineBreak":true},{"text":"呻吟如水涌流。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我害怕的事发生了，","poem":1},{"lineBreak":true},{"text":"我恐惧的事来临了。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我不得安宁，","poem":1},{"lineBreak":true},{"text":"不得平静，","poem":1},{"lineBreak":true},{"text":"不得安息，","poem":1},{"lineBreak":true},{"text":"只有患难。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}