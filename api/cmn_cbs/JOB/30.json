{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":30,"content":[{"type":"heading","content":["哀叹今日的痛苦"]},{"type":"verse","number":1,"content":[{"text":"“但如今，比我年少的人竟嘲笑我，","poem":1},{"lineBreak":true},{"text":"他们的父亲曾被我鄙视，","poem":1},{"lineBreak":true},{"text":"连我的牧羊犬都不如。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他们精力衰竭，","poem":1},{"lineBreak":true},{"text":"无力的手于我何益？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们贫穷饥饿，瘦弱不堪，","poem":1},{"lineBreak":true},{"text":"夜间在干旱荒凉之地啃食。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们在草丛中拔咸草充饥，","poem":1},{"lineBreak":true},{"text":"以罗腾树根为食。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们被赶离人群，","poem":1},{"lineBreak":true},{"text":"像贼一样被喝斥。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们只好住在荒谷，","poem":1},{"lineBreak":true},{"text":"在地洞和岩穴栖身；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"在杂草间嚎叫如兽，","poem":1},{"lineBreak":true},{"text":"在树丛中蜷缩一团。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们是愚昧无名之辈，","poem":1},{"lineBreak":true},{"text":"被人用鞭子赶出境外。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“如今，他们竟唱歌讽刺我，","poem":1},{"lineBreak":true},{"text":"我成了他们的笑柄。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们厌恶我，不愿靠近我，","poem":1},{"lineBreak":true},{"text":"任意朝我脸上吐唾沫。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因为上帝苦待我，使我毫无力量，","poem":1},{"lineBreak":true},{"text":"他们才在我面前肆无忌惮。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"这些无赖从右边攻击我，","poem":1},{"lineBreak":true},{"text":"迫使我逃亡，","poem":1},{"lineBreak":true},{"text":"他们展开攻势要毁灭我。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他们截断我的路，","poem":1},{"lineBreak":true},{"text":"想方设法害我，无人相助。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们冲破防线，","poem":1},{"lineBreak":true},{"text":"从废墟中向我袭来。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"恐惧笼罩着我，","poem":1},{"lineBreak":true},{"text":"我的尊荣随风而去，","poem":1},{"lineBreak":true},{"text":"我的荣华如云消散。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“如今我的生命将尽，","poem":1},{"lineBreak":true},{"text":"痛苦的日子抓住我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"夜间我的骨头刺痛，","poem":1},{"lineBreak":true},{"text":"啃噬之痛无休无止。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"上帝猛力抓住我的衣服，","poem":1},{"lineBreak":true},{"text":"紧紧地揪住我的衣领。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂把我扔进淤泥，","poem":1},{"lineBreak":true},{"text":"使我如尘埃灰烬。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“上帝啊！我向你呼求，你不回应；","poem":1},{"lineBreak":true},{"text":"我站起来，你也不理睬。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你变得对我残酷无情，","poem":1},{"lineBreak":true},{"text":"用你大能的手迫害我，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"把我提到风中，让我被风吹走，","poem":1},{"lineBreak":true},{"text":"被暴风抛来抛去。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我知道你要带我去死亡之地，","poem":1},{"lineBreak":true},{"text":"那是你为众生所定的归宿。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“诚然，不幸的人在困境中呼救，","poem":1},{"lineBreak":true},{"text":"无人会伸手加害他。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"难道我不曾为受苦的人哭泣，","poem":1},{"lineBreak":true},{"text":"我的心不曾为穷困者悲伤吗？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我盼望幸福，来的却是灾祸；","poem":1},{"lineBreak":true},{"text":"我期待光明，来的却是黑暗。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我心里一直烦乱不安，","poem":1},{"lineBreak":true},{"text":"苦难的日子迎面袭来。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我皮肤发黑，不是因为日晒，","poem":1},{"lineBreak":true},{"text":"我在会众中站起来呼救。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我成了豺狼的兄弟，","poem":1},{"lineBreak":true},{"text":"鸵鸟的伙伴。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我的皮肤发黑、脱落，","poem":1},{"lineBreak":true},{"text":"我的骨头发热，如被火烧。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"我的琴唱出哀乐，","poem":1},{"lineBreak":true},{"text":"我的箫奏出悲鸣。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}