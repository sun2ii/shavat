{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":31,"content":[{"type":"heading","content":["约伯最后的申辩"]},{"type":"verse","number":1,"content":[{"text":"“我跟自己的眼睛立了约，","poem":1},{"lineBreak":true},{"text":"决不贪看女色。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"天上的上帝所定的是什么？","poem":1},{"lineBreak":true},{"text":"高处的全能者赐下什么产业？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"岂不是降灾难给不义之人，","poem":1},{"lineBreak":true},{"text":"降祸患给作恶的人？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"上帝岂不鉴察我走的路，","poem":1},{"lineBreak":true},{"text":"数算我的脚步？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我何曾与虚假同行，","poem":1},{"lineBreak":true},{"text":"疾步追随诡诈？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愿上帝把我放在公义的天平上称量，","poem":1},{"lineBreak":true},{"text":"让祂知道我的清白。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"倘若我的脚偏离正路，","poem":1},{"lineBreak":true},{"text":"贪图眼目之欲，","poem":1},{"lineBreak":true},{"text":"或手上粘着罪污，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愿我种的庄稼被别人享用，","poem":1},{"lineBreak":true},{"text":"我田中的出产被连根拔起。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的心若迷恋女人，","poem":1},{"lineBreak":true},{"text":"在邻居的门口窥探，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"愿我妻子为别人推磨，","poem":1},{"lineBreak":true},{"text":"愿别人与她同房。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因为这是大恶，","poem":1},{"lineBreak":true},{"text":"是当受审判的罪，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"是烧向灭亡的火焰，","poem":1},{"lineBreak":true},{"text":"会吞噬我所有家业。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我的仆婢告我，","poem":1},{"lineBreak":true},{"text":"我也会讲公道，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"否则上帝追究，我怎么办？","poem":1},{"lineBreak":true},{"text":"祂审问我，我如何回答？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"在母腹创造我的，岂不也创造了他们？","poem":1},{"lineBreak":true},{"text":"岂不是同一位使我们在母腹中成胎？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我何曾拒绝穷人的请求，","poem":1},{"lineBreak":true},{"text":"或使寡妇眼露失望之情，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"或独吞我的食物，","poem":1},{"lineBreak":true},{"text":"不与孤儿同享？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我自幼就如父亲般抚养孤儿，","poem":1},{"lineBreak":true},{"text":"我自出母胎就照顾寡妇。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"倘若我见有人冻得要死，","poem":1},{"lineBreak":true},{"text":"或有穷人衣不蔽体，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"却没有把我的羊毛给他们御寒，","poem":1},{"lineBreak":true},{"text":"以致他们向我道谢；","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"倘若我仗着在城门口有势力，","poem":1},{"lineBreak":true},{"text":"就动手欺负孤儿，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"情愿我的肩膀从肩胛脱落，","poem":1},{"lineBreak":true},{"text":"我的手臂从手肘折断。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"因为我惧怕上帝降灾祸，","poem":1},{"lineBreak":true},{"text":"我无法承担祂的威严。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“我若仰仗金子，","poem":1},{"lineBreak":true},{"text":"依靠纯金，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"因财富充裕、","poem":1},{"lineBreak":true},{"text":"或家产丰足而欢喜；","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我若见太阳发光，","poem":1},{"lineBreak":true},{"text":"明月在天上移动，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"就暗自心生迷恋，","poem":1},{"lineBreak":true},{"text":"向它们吻手示敬，","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"就是犯了当受审判的罪恶，","poem":1},{"lineBreak":true},{"text":"因为这是背弃天上的上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“我何曾因敌人遭殃而欢喜，","poem":1},{"lineBreak":true},{"text":"因他们遇祸而快乐？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我从未咒诅他们丧命，","poem":1},{"lineBreak":true},{"text":"以致我的口犯罪。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"住在我帐篷中的人，","poem":1},{"lineBreak":true},{"text":"谁没饱餐我的肉食呢？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我的家门向路人敞开，","poem":1},{"lineBreak":true},{"text":"从未有旅客露宿街头。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"我何曾像亚当一样遮掩我的过犯，","poem":1},{"lineBreak":true},{"text":"将罪恶藏在怀中，","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"因害怕群众，","poem":1},{"lineBreak":true},{"text":"畏惧族人的藐视，","poem":1},{"lineBreak":true},{"text":"就默不作声、闭门不出？","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“但愿有人听我申诉！","poem":1},{"lineBreak":true},{"text":"看啊，我在这里画押，愿全能者回答我！","poem":1},{"lineBreak":true},{"text":"愿我的控诉者写好状词！","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"我会把状词披在肩上，","poem":1},{"lineBreak":true},{"text":"如冠冕一般戴在头上。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"我会像王者一样到祂面前，","poem":1},{"lineBreak":true},{"text":"向祂交代我的一切所为。","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"“若我的田地向我喊冤，","poem":1},{"lineBreak":true},{"text":"条条犁沟一同哭诉；","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"若我白吃地的出产，","poem":1},{"lineBreak":true},{"text":"或使地的主人丧命，","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"愿地长出蒺藜而非麦子，","poem":1},{"lineBreak":true},{"text":"长出杂草而非大麦。”","poem":1},{"lineBreak":true},{"text":"约伯的话说完了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}