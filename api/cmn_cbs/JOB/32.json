{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":32,"content":[{"type":"heading","content":["以利户的回答"]},{"type":"verse","number":1,"content":["三人见约伯自以为义，便不再回答他。"]},{"type":"verse","number":2,"content":["那时，兰族的布西人巴拉迦的儿子以利户对约伯很恼火，因为约伯自以为义，不承认上帝的公义。"]},{"type":"verse","number":3,"content":["他对约伯的三个朋友也很恼火，因为他们说约伯有罪，却无法回答约伯的质问",{"noteId":15},"。"]},{"type":"verse","number":4,"content":["由于不及他们年长，以利户便等他们说完才向约伯发言。"]},{"type":"verse","number":5,"content":["他见三人无法回答约伯，很恼火。"]},{"type":"verse","number":6,"content":["于是，布西人巴拉迦的儿子以利户说：",{"text":"“我年纪轻，你们是长辈，","poem":1},{"lineBreak":true},{"text":"所以我畏惧，不敢向你们陈明观点。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我想，前辈当先发言，","poem":1},{"lineBreak":true},{"text":"长者当传授智慧。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"但只有人里面的灵——","poem":1},{"lineBreak":true},{"text":"全能者的气息赐人悟性。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"长者不一定有智慧，","poem":1},{"lineBreak":true},{"text":"年老不一定明白是非。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因此，请听我说，","poem":1},{"lineBreak":true},{"text":"我也要陈明观点。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"看啊，我一直等候你们发言，","poem":1},{"lineBreak":true},{"text":"倾听你们的高见，","poem":1},{"lineBreak":true},{"text":"等你们斟词酌句。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我仔细聆听，","poem":1},{"lineBreak":true},{"text":"发现你们无人能驳倒约伯，","poem":1},{"lineBreak":true},{"text":"无人能答复他。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你们不要说，‘我们找到了智慧，","poem":1},{"lineBreak":true},{"text":"使他折服的是上帝而非人。’","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"约伯没有与我辩论，","poem":1},{"lineBreak":true},{"text":"我也不会用你们的理论答复他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“他们惊慌失措，无言以对，","poem":1},{"lineBreak":true},{"text":"再也说不出话来。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"难道他们不说话，站在那里无言以对，","poem":1},{"lineBreak":true},{"text":"我就要等下去吗？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我也要作出答复，","poem":1},{"lineBreak":true},{"text":"陈明我的观点。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因为我心里积满了话，","poem":1},{"lineBreak":true},{"text":"我里面的灵催促我说出来。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我里面像盛满了酒，却没有出口，","poem":1},{"lineBreak":true},{"text":"又如将要破裂的新酒袋。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我要一吐为快，","poem":1},{"lineBreak":true},{"text":"我要开口答复。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我不看人的情面，","poem":1},{"lineBreak":true},{"text":"也不奉承人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我不懂奉承，","poem":1},{"lineBreak":true},{"text":"否则，造物主会很快把我除掉。","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":15,"caller":"+","text":"“因为他们说约伯有罪，却无法回答约伯的质问”有古卷作“因为他们无法回答约伯的质问，因而置上帝于不公”。","reference":{"chapter":32,"verse":3}}]},"thisChapterLink":"/api/cmn_cbs/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}