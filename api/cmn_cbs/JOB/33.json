{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"“约伯啊，请听我言，","poem":1},{"lineBreak":true},{"text":"请留心听我每一句话。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要开口发言，","poem":1},{"lineBreak":true},{"text":"我话已在舌尖。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的话发自正直的心，","poem":1},{"lineBreak":true},{"text":"我的口如实陈明道理。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"上帝的灵创造了我，","poem":1},{"lineBreak":true},{"text":"全能者的气赋予我生命。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"如果你能，就反驳我，","poem":1},{"lineBreak":true},{"text":"站出来与我辩论。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"在上帝面前，我与你无异，","poem":1},{"lineBreak":true},{"text":"也是泥土造的。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"所以你不用惧怕我，","poem":1},{"lineBreak":true},{"text":"我不会对你施加压力。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“你的话已进到我耳中，","poem":1},{"lineBreak":true},{"text":"我听见你说，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"‘我纯全无过，","poem":1},{"lineBreak":true},{"text":"我清白无罪，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝却挑我的错，","poem":1},{"lineBreak":true},{"text":"与我为敌；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂给我戴上脚镣，","poem":1},{"lineBreak":true},{"text":"鉴察我的一举一动。’","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“我来答复你，你这话没有道理，","poem":1},{"lineBreak":true},{"text":"因为上帝比世人大。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你为何向祂抱怨，","poem":1},{"lineBreak":true},{"text":"说祂不理会世人的话？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"上帝一再用各种方式说话，","poem":1},{"lineBreak":true},{"text":"然而世人却不明白。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"人躺在床上沉睡时，","poem":1},{"lineBreak":true},{"text":"在梦境和夜间的异象中，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"上帝开启他们的耳朵，","poem":1},{"lineBreak":true},{"text":"用警告惊吓他们，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"使他们离开罪恶，","poem":1},{"lineBreak":true},{"text":"不再骄傲，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"以免他们的灵魂坠入深坑，","poem":1},{"lineBreak":true},{"text":"他们的性命被刀剑夺去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“人因受罚而卧病在床，","poem":1},{"lineBreak":true},{"text":"骨头疼痛不止，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"以致毫无食欲，","poem":1},{"lineBreak":true},{"text":"对佳肴心生厌恶。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他日渐消瘦，","poem":1},{"lineBreak":true},{"text":"只剩下骨头。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他的灵魂临近深坑，","poem":1},{"lineBreak":true},{"text":"他的生命濒临死亡。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"如果一千天使中有一位能做他的中保，","poem":1},{"lineBreak":true},{"text":"指示他当行的事，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"上帝","poem":1},{"noteId":16},{"text":"就会怜悯他，说，‘别让他下坟墓，","poem":1},{"lineBreak":true},{"text":"我已得到他的赎金。’","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"那时，他的皮肉比孩童还嫩，","poem":1},{"lineBreak":true},{"text":"他将恢复青春的活力。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他向上帝祷告时必蒙悦纳，","poem":1},{"lineBreak":true},{"text":"他欢呼着朝见上帝，","poem":1},{"lineBreak":true},{"text":"再度被祂视为义人。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他会当众歌唱说，","poem":1},{"lineBreak":true},{"text":"‘我犯了罪，颠倒是非，","poem":1},{"lineBreak":true},{"text":"祂却没有按我的罪报应我。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"祂救赎我的灵魂，使之免下深坑，","poem":1},{"lineBreak":true},{"text":"使我的生命得见光明。’","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“看啊，这都是上帝的作为，","poem":1},{"lineBreak":true},{"text":"祂一次次地恩待世人，","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"从深坑救回人的灵魂，","poem":1},{"lineBreak":true},{"text":"使他沐浴生命之光。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"约伯啊，留心听我说，","poem":1},{"lineBreak":true},{"text":"不要作声，我要发言。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"你若有话，就答复我；","poem":1},{"lineBreak":true},{"text":"你只管说，我愿看到你的清白。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"否则，请听我言；","poem":1},{"lineBreak":true},{"text":"不要作声，我要传授你智慧。”","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":16,"caller":"+","text":"“上帝”希伯来文是“他”，也可能指天使。","reference":{"chapter":33,"verse":24}}]},"thisChapterLink":"/api/cmn_cbs/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}