{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":[{"text":"以利户又说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“各位智者，请听我言；","poem":1},{"lineBreak":true},{"text":"明达之士，要侧耳听我的话。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为耳朵辨别话语，","poem":1},{"lineBreak":true},{"text":"正如舌头品尝食物。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们来鉴别何为正，","poem":1},{"lineBreak":true},{"text":"一起来认识何为善。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"约伯曾说，‘我是清白的，","poem":1},{"lineBreak":true},{"text":"上帝却夺去我的公道。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我虽然有理，却被认为是撒谎者；","poem":1},{"lineBreak":true},{"text":"我虽然无过，却受到致命的创伤。’","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"有谁像约伯？","poem":1},{"lineBreak":true},{"text":"他肆意嘲讽，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"与恶者为伍，","poem":1},{"lineBreak":true},{"text":"同坏人作伴。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为他说，‘人取悦上帝毫无益处。’","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“所以明智的人啊，请听我言，","poem":1},{"lineBreak":true},{"text":"上帝绝不会作恶，","poem":1},{"lineBreak":true},{"text":"全能者绝无不义。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂按人所行的对待人，","poem":1},{"lineBreak":true},{"text":"照人所做的报应人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"上帝绝不会作恶，","poem":1},{"lineBreak":true},{"text":"全能者不会颠倒是非。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"谁曾派祂治理大地，","poem":1},{"lineBreak":true},{"text":"让祂掌管整个世界呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"上帝若决定收回自己的灵和气，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"所有生命将一同灭亡，","poem":1},{"lineBreak":true},{"text":"世人也将归回尘土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“你若明理，请听我言，","poem":1},{"lineBreak":true},{"text":"侧耳听我说。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"憎恶正义的岂可掌权？","poem":1},{"lineBreak":true},{"text":"你要谴责公义的大能者吗？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂可以称君王为废物，","poem":1},{"lineBreak":true},{"text":"称权贵为恶徒。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂不偏袒王侯，","poem":1},{"lineBreak":true},{"text":"也不轻贫重富，","poem":1},{"lineBreak":true},{"text":"因为他们都是祂亲手造的。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他们夜半猝然死去，","poem":1},{"lineBreak":true},{"text":"百姓震颤，继而消逝，","poem":1},{"lineBreak":true},{"text":"权贵也被铲除，非借人手。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"祂注目世人所行之道，","poem":1},{"lineBreak":true},{"text":"察看他们走的每一步。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"没有黑暗和阴影可供作恶者藏身。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"祂不必再三察验，","poem":1},{"lineBreak":true},{"text":"把人召到面前审判。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"祂击垮权贵无需审查，","poem":1},{"lineBreak":true},{"text":"另立他人取而代之。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"祂知道他们的行为，","poem":1},{"lineBreak":true},{"text":"祂使他们在夜间倾覆、灭亡。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"祂当众击打他们，","poem":1},{"lineBreak":true},{"text":"正如击打恶人。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"因为他们离弃祂，","poem":1},{"lineBreak":true},{"text":"无视祂的正道，","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"以致穷人的呼求传到祂那里，","poem":1},{"lineBreak":true},{"text":"祂也听见了困苦者的呼求。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"但祂若保持缄默，谁能定祂有罪？","poem":1},{"lineBreak":true},{"text":"祂若掩起脸来，谁能看得见祂？","poem":1},{"lineBreak":true},{"text":"个人和国家都靠祂垂顾，","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"以免不敬虔者做王，","poem":1},{"lineBreak":true},{"text":"祸国殃民。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“有谁对上帝说，","poem":1},{"lineBreak":true},{"text":"‘我受了管教，不会再犯罪；","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我不明白的事，求你指教我；","poem":1},{"lineBreak":true},{"text":"我若行了恶事，必不再行’？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"难道因为你拒绝接受，","poem":1},{"lineBreak":true},{"text":"上帝就要迎合你的要求吗？","poem":1},{"lineBreak":true},{"text":"要做抉择的是你，而非我，","poem":1},{"lineBreak":true},{"text":"请说说你的高见。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"明达的人和听我发言的智者都会说，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"‘约伯所言毫无知识，","poem":1},{"lineBreak":true},{"text":"他的话没有智慧。’","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"愿约伯被试炼到底，","poem":1},{"lineBreak":true},{"text":"因为他的回答如恶人之言。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"他的叛逆使他罪上加罪，","poem":1},{"lineBreak":true},{"text":"他在我们中间拍手讥笑，","poem":1},{"lineBreak":true},{"text":"用许多话亵渎上帝。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}