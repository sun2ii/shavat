{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["以利户又说："]},{"type":"verse","number":2,"content":[{"text":"“你在上帝面前自以为义，","poem":1},{"lineBreak":true},{"text":"你认为这合理吗？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你还说，‘这与我何干？","poem":1},{"lineBreak":true},{"text":"我不犯罪又有何益处？’","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要答复你和你的朋友。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要抬头观看诸天，","poem":1},{"lineBreak":true},{"text":"瞻望头顶的穹苍。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你若犯罪，与上帝何妨？","poem":1},{"lineBreak":true},{"text":"你若罪恶累累，对祂有何影响？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你若为人公义，与祂何益？","poem":1},{"lineBreak":true},{"text":"祂从你手上能得什么好处？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你的罪恶只能伤害你的同类，","poem":1},{"lineBreak":true},{"text":"你的公义只能令世人受益。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“人们因饱受压迫而呼求，","poem":1},{"lineBreak":true},{"text":"因强权者的压制而求救。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"但无人问，‘创造我的上帝在哪里？","poem":1},{"lineBreak":true},{"text":"祂使人夜间欢唱，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"使我们比地上的走兽聪明，","poem":1},{"lineBreak":true},{"text":"比天上的飞鸟有智慧。’","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们因恶人的嚣张而呼求，","poem":1},{"lineBreak":true},{"text":"上帝却不回答。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"上帝必不垂听虚妄的呼求，","poem":1},{"lineBreak":true},{"text":"全能者必不理会。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"更何况你说你看不见祂，","poem":1},{"lineBreak":true},{"text":"你的案子已呈上，在等祂裁决。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你还说祂没有发怒降罚，","poem":1},{"lineBreak":true},{"text":"也毫不理会罪恶。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"约伯啊，你说的尽是虚言，","poem":1},{"lineBreak":true},{"text":"讲了一堆无知的话。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}