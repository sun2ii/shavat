{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["以利户又说："]},{"type":"verse","number":2,"content":[{"text":"“再给我片刻，容我讲明，","poem":1},{"lineBreak":true},{"text":"我还有话替上帝说。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我要旁征博引，","poem":1},{"lineBreak":true},{"text":"证明我的创造主公义。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的话绝非虚言，","poem":1},{"lineBreak":true},{"text":"知识全备者在你身旁。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“上帝有大能，但不藐视人，","poem":1},{"lineBreak":true},{"text":"祂无所不知。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂不容恶人活命，","poem":1},{"lineBreak":true},{"text":"祂为穷苦人申冤。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂时时看顾义人，","poem":1},{"lineBreak":true},{"text":"使他们与君王同坐宝座，","poem":1},{"lineBreak":true},{"text":"永远受尊崇。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们若被锁链捆绑，","poem":1},{"lineBreak":true},{"text":"被苦难的绳索缠住，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂就会指明他们的所作所为，","poem":1},{"lineBreak":true},{"text":"让他们知道自己狂妄的罪愆。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂开启他们的耳朵，使之受教，","poem":1},{"lineBreak":true},{"text":"督促他们离开罪恶。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们若听从、事奉祂，","poem":1},{"lineBreak":true},{"text":"就可一生幸福，安享天年。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"否则，他们必死于刀下，","poem":1},{"lineBreak":true},{"text":"在无知中灭亡。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"不信上帝的人心存愤怒，","poem":1},{"lineBreak":true},{"text":"被上帝捆绑也不求救。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们早年丧命，","poem":1},{"lineBreak":true},{"text":"与庙中的男妓一同夭亡。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"上帝借苦难拯救受苦的人，","poem":1},{"lineBreak":true},{"text":"借患难开通他们的耳朵。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"祂也要引领你脱离困境，","poem":1},{"lineBreak":true},{"text":"进入广阔自由之地，","poem":1},{"lineBreak":true},{"text":"使你享受满桌佳肴。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“但你饱受恶人当得的审判，","poem":1},{"lineBreak":true},{"text":"审判和惩罚临到了你。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"当心，不可因愤怒而嘲骂，","poem":1},{"lineBreak":true},{"text":"不可因赎金大就偏离正道。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"难道你呼求、使出浑身力气，","poem":1},{"lineBreak":true},{"text":"就能脱离困境吗？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"不要渴望黑夜来临，","poem":1},{"lineBreak":true},{"text":"那时众民在家中消亡。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"当心，不可转向罪恶，","poem":1},{"lineBreak":true},{"text":"因你喜欢罪恶胜于苦难。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"看啊，上帝的能力无以伦比。","poem":1},{"lineBreak":true},{"text":"谁能像祂那样赐人教诲？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"谁能为祂指定道路？","poem":1},{"lineBreak":true},{"text":"谁能说祂行事不义？","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"人们都歌唱祂的作为，","poem":1},{"lineBreak":true},{"text":"你也要记得颂扬。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"祂的作为，天下人都已看见，","poem":1},{"lineBreak":true},{"text":"世人从远处目睹。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我们无法明白上帝的伟大，","poem":1},{"lineBreak":true},{"text":"祂的年岁无法数算。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"祂吸取水滴，","poem":1},{"lineBreak":true},{"text":"使之在云雾中化为雨，","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"从云端沛然降下，","poem":1},{"lineBreak":true},{"text":"滋润人间。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"谁能明白云层的铺展，","poem":1},{"lineBreak":true},{"text":"及祂幔幕发出的雷声？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"祂在四围铺展闪电，","poem":1},{"lineBreak":true},{"text":"覆盖大海的深处。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"祂借此治理万民，","poem":1},{"lineBreak":true},{"text":"赐下丰富的食物。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"祂手握闪电，","poem":1},{"lineBreak":true},{"text":"令它射向目标。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"雷声显明祂的作为，","poem":1},{"lineBreak":true},{"text":"就连牲畜也能察觉。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}