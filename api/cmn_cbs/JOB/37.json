{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"“因此我心战栗，","poem":1},{"lineBreak":true},{"text":"在胸膛跳动。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"请仔细听祂发出的雷声，","poem":1},{"lineBreak":true},{"text":"听祂口中发出的轰鸣。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂使闪电划过整个天空，","poem":1},{"lineBreak":true},{"text":"亮光直照到地极。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"随后雷声隆隆，","poem":1},{"lineBreak":true},{"text":"祂发出威严之声。","poem":1},{"lineBreak":true},{"text":"祂一发声，雷电交加。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝发出奇妙的雷声，","poem":1},{"lineBreak":true},{"text":"我们无法测度祂伟大的作为。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂命雪降在大地，","poem":1},{"lineBreak":true},{"text":"令雨倾盆倒下，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"使人们停下工作，","poem":1},{"lineBreak":true},{"text":"以便世人都知道祂的作为。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"野兽躲进窝里，","poem":1},{"lineBreak":true},{"text":"留在洞中。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"暴风从南天而来，","poem":1},{"lineBreak":true},{"text":"寒流由北方而至。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝嘘气成冰，","poem":1},{"lineBreak":true},{"text":"使宽阔的水面凝结。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂使密云布满水气，","poem":1},{"lineBreak":true},{"text":"从云端发出闪电。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"云随祂的指令旋转，","poem":1},{"lineBreak":true},{"text":"在地面遵行祂的吩咐，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"或为惩罚大地，","poem":1},{"lineBreak":true},{"text":"或为彰显慈爱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“约伯啊，请留心听，","poem":1},{"lineBreak":true},{"text":"要驻足沉思上帝的奇妙作为。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你知道上帝如何发出命令，","poem":1},{"lineBreak":true},{"text":"使云中电光闪烁吗？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你知道全知者的奇妙作为——","poem":1},{"lineBreak":true},{"text":"祂如何使云彩飘浮吗？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"南风吹来，大地沉寂时，","poem":1},{"lineBreak":true},{"text":"你就汗湿衣襟，你知道为何吗？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你能像祂那样铺展坚如铜镜的穹苍吗？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我们因愚昧而无法陈诉，","poem":1},{"lineBreak":true},{"text":"请指教我们如何与祂对话。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我怎敢与祂对话？","poem":1},{"lineBreak":true},{"text":"岂有人自取灭亡？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"风吹散天空的云后，","poem":1},{"lineBreak":true},{"text":"无人能仰视太阳的强光。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"北方出现金色的光芒，","poem":1},{"lineBreak":true},{"text":"上帝充满可怕的威严。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我们无法测度全能者，","poem":1},{"lineBreak":true},{"text":"祂充满能力，无比正直公义，","poem":1},{"lineBreak":true},{"text":"不恃强凌弱。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"所以，人们都敬畏祂，","poem":1},{"lineBreak":true},{"text":"祂不看顾自以为有智慧的人。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}