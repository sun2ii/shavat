{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":38,"content":[{"type":"heading","content":["耶和华回答约伯"]},{"type":"verse","number":1,"content":[{"text":"那时，耶和华从旋风中对约伯说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"“是谁用无知的话蒙蔽我的旨意？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你要像勇士一样束腰备战，","poem":1},{"lineBreak":true},{"text":"我来提问，你来回答。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“我立大地根基的时候，你在哪里？","poem":1},{"lineBreak":true},{"text":"你若那么聪明，请告诉我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你可知道谁为大地定的尺寸？","poem":1},{"lineBreak":true},{"text":"谁用准绳把它丈量？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"是什么支撑大地的根基？","poem":1},{"lineBreak":true},{"text":"谁为它安放的基石？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"当时晨星齐声歌唱，","poem":1},{"lineBreak":true},{"text":"众天使都发出欢呼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“大海从母胎奔腾而出时，","poem":1},{"lineBreak":true},{"text":"谁为它划定界限？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"是我为大海披上云彩，","poem":1},{"lineBreak":true},{"text":"为它裹上厚厚的幽暗。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"是我为它划定界限，","poem":1},{"lineBreak":true},{"text":"并安上门和闩，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"说，‘你到此为止，不可越界；","poem":1},{"lineBreak":true},{"text":"你狂傲的波涛要停在这里。’","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“你生平可曾向晨曦发号施令，","poem":1},{"lineBreak":true},{"text":"为黎明的曙光指定岗位，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"使阳光普照大地，","poem":1},{"lineBreak":true},{"text":"抖出藏匿的恶人？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"日光使大地改观，如泥上盖印，","poem":1},{"lineBreak":true},{"text":"万物如衣服般显出颜色。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"恶人得不到光明，","poem":1},{"lineBreak":true},{"text":"强横的臂膀必折断。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你可曾到过大海的源头，","poem":1},{"lineBreak":true},{"text":"走过深渊的底部？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"死亡之门可曾向你显露？","poem":1},{"lineBreak":true},{"text":"你可曾见过幽冥之门？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你知道大地有多广阔吗？","poem":1},{"lineBreak":true},{"text":"你若全知道，就告诉我吧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“哪条路通往光明的居所？","poem":1},{"lineBreak":true},{"text":"哪里是黑暗的住处？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你能把它们带回原处吗？","poem":1},{"lineBreak":true},{"text":"你认识通往其居所的路吗？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你肯定知道，","poem":1},{"lineBreak":true},{"text":"因为那时你已出生，","poem":1},{"lineBreak":true},{"text":"你的寿数又很长久！","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“你曾到过雪库，","poem":1},{"lineBreak":true},{"text":"或见过雹仓吗？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"那是我为降灾之时，","poem":1},{"lineBreak":true},{"text":"为争战之日而预备的。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"光从哪条路散开？","poem":1},{"lineBreak":true},{"text":"东风从哪条路吹遍大地？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"谁为豪雨开水道，","poem":1},{"lineBreak":true},{"text":"为雷电辟路径，","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"使雨水降在杳无人烟之地，","poem":1},{"lineBreak":true},{"text":"降在无人居住的旷野，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"以滋润荒凉不毛之地，","poem":1},{"lineBreak":true},{"text":"使土地长出青草？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"雨水有父亲吗？","poem":1},{"lineBreak":true},{"text":"谁生的露珠？","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"冰出自谁的胎？","poem":1},{"lineBreak":true},{"text":"谁生的天上的霜？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"水变得坚硬如石，","poem":1},{"lineBreak":true},{"text":"深渊表面凝结成冰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“你能系住昴星的结，","poem":1},{"lineBreak":true},{"text":"解开参星的带吗？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"你能按季节领出星座，","poem":1},{"lineBreak":true},{"text":"引导北斗及其众星吗？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"你知道天的定律吗？","poem":1},{"lineBreak":true},{"text":"你能使地服从天律吗？","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你能号令云彩，","poem":1},{"lineBreak":true},{"text":"使倾盆大雨覆盖你吗？","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"你能命闪电发出，","poem":1},{"lineBreak":true},{"text":"让它听候调遣吗？","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"谁将智慧放在人胸中？","poem":1},{"lineBreak":true},{"text":"谁使人内心有聪明？","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"尘土结成硬团，","poem":1},{"lineBreak":true},{"text":"土块黏在一起时，","poem":1},{"lineBreak":true},{"text":"谁能凭智慧数算云彩？","poem":1},{"lineBreak":true},{"text":"谁能倾倒天上的水囊？","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“狮子卧在洞中，","poem":1},{"lineBreak":true},{"text":"猛狮埋伏在隐秘处，","poem":1},{"lineBreak":true},{"text":"你能为它们猎取食物，","poem":1},{"lineBreak":true},{"text":"使它们饱餐吗？","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"乌鸦的幼雏饿得飞来飞去，","poem":1},{"lineBreak":true},{"text":"向上帝哀鸣时，","poem":1},{"lineBreak":true},{"text":"谁供应乌鸦食物？","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":39}