{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"“你知道野山羊何时生产吗？","poem":1},{"lineBreak":true},{"text":"你看过母鹿产仔吗？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你能算出它们怀胎的月数吗？","poem":1},{"lineBreak":true},{"text":"你知道它们分娩的日期吗？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"它们屈身产仔，","poem":1},{"lineBreak":true},{"text":"结束分娩之痛。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"幼仔健壮，在荒野长大，","poem":1},{"lineBreak":true},{"text":"离群而去，不再回来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“谁让野驴逍遥自在？","poem":1},{"lineBreak":true},{"text":"谁解开了它的缰绳？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我使它以旷野为家，","poem":1},{"lineBreak":true},{"text":"以盐地作居所。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"它嗤笑城邑的喧闹，","poem":1},{"lineBreak":true},{"text":"不听赶牲口的吆喝。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"它以群山作牧场，","poem":1},{"lineBreak":true},{"text":"寻找各种青草。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“野牛岂肯为你效劳，","poem":1},{"lineBreak":true},{"text":"在你的槽旁过夜？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你岂能用缰绳把野牛牵到犁沟？","poem":1},{"lineBreak":true},{"text":"它岂肯跟着你在山谷耕地？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你岂能倚靠它的大力，","poem":1},{"lineBreak":true},{"text":"把你的重活交给它？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"岂能靠它运回粮食，","poem":1},{"lineBreak":true},{"text":"替你堆聚到麦场？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“鸵鸟欢然拍动翅膀，","poem":1},{"lineBreak":true},{"text":"它岂有白鹳的翎羽？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"它将蛋产在地上，","poem":1},{"lineBreak":true},{"text":"使蛋得到沙土的温暖，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"却不知蛋会被踩碎，","poem":1},{"lineBreak":true},{"text":"或遭野兽践踏。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"它苛待雏鸟，好像它们并非己出，","poem":1},{"lineBreak":true},{"text":"就算徒劳一场，它也不怕。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因为上帝未赐它智慧，","poem":1},{"lineBreak":true},{"text":"没有给它悟性。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"然而，一旦它展翅奔跑，","poem":1},{"lineBreak":true},{"text":"必嗤笑马儿和骑士。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“马的力量岂是你赐的？","poem":1},{"lineBreak":true},{"text":"它颈上的鬃毛岂是你披的？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"岂是你使它跳跃如蝗虫，","poem":1},{"lineBreak":true},{"text":"发出令人胆寒的长嘶？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"它在谷中刨地，","poem":1},{"lineBreak":true},{"text":"炫耀力量，奋力冲向敌军。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"它嘲笑恐惧，毫不害怕，","poem":1},{"lineBreak":true},{"text":"不因刀剑而退缩。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"它背上的箭袋铮铮作响，","poem":1},{"lineBreak":true},{"text":"长矛和标枪闪闪发光。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"角声一响，它便无法静立，","poem":1},{"lineBreak":true},{"text":"异常亢奋，急于驰骋大地。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"听到角声，它就发出长嘶，","poem":1},{"lineBreak":true},{"text":"它老远便嗅到战争的气味，","poem":1},{"lineBreak":true},{"text":"并听见呐喊和将领的号令。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“鹰隼展翅翱翔，飞往南方，","poem":1},{"lineBreak":true},{"text":"岂是靠你的智慧？","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"秃鹰腾飞，在高处搭窝，","poem":1},{"lineBreak":true},{"text":"岂是奉你的命令？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"它居住在悬崖上，","poem":1},{"lineBreak":true},{"text":"盘踞在山岩峭壁，","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"它从那里搜寻猎物，","poem":1},{"lineBreak":true},{"text":"它的目光直达远方。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"它的幼雏噬血，","poem":1},{"lineBreak":true},{"text":"哪里有尸体，它就在哪里。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}