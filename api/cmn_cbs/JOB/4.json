{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":4,"content":[{"type":"heading","content":["以利法的责难"]},{"type":"verse","number":1,"content":["提幔人以利法回答说："]},{"type":"verse","number":2,"content":[{"text":"“若有人向你进言，","poem":1},{"lineBreak":true},{"text":"你会厌烦吗？","poem":1},{"lineBreak":true},{"text":"可是，谁能忍住不说呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你曾教导许多人，","poem":1},{"lineBreak":true},{"text":"使无力的手强壮。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的话使人免于跌倒，","poem":1},{"lineBreak":true},{"text":"你使颤抖的膝硬朗。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但现在苦难一来，","poem":1},{"lineBreak":true},{"text":"你便灰心丧胆；","poem":1},{"lineBreak":true},{"text":"灾祸来临，","poem":1},{"lineBreak":true},{"text":"你便惊慌失措。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你敬畏上帝还没有信心吗？","poem":1},{"lineBreak":true},{"text":"你行为纯全还没有盼望吗？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你想一想，","poem":1},{"lineBreak":true},{"text":"哪有无辜的人灭亡？","poem":1},{"lineBreak":true},{"text":"哪有正直的人遭殃？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"据我所见，","poem":1},{"lineBreak":true},{"text":"播恶收恶，","poem":1},{"lineBreak":true},{"text":"种祸得祸。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们被上帝的气息所毁，","poem":1},{"lineBreak":true},{"text":"被上帝的怒气所灭。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"狮子咆哮，猛狮吼叫，","poem":1},{"lineBreak":true},{"text":"雄狮的牙齿被敲掉。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"雄狮因无食而死，","poem":1},{"lineBreak":true},{"text":"母狮的幼崽离散。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“有信息暗暗地传给我，","poem":1},{"lineBreak":true},{"text":"一声低语传入我耳中。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"夜间人们沉睡的时候，","poem":1},{"lineBreak":true},{"text":"在搅扰思绪的异象中，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"恐惧袭来，","poem":1},{"lineBreak":true},{"text":"令我战栗不已，","poem":1},{"lineBreak":true},{"text":"全身发抖。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"有灵从我脸上拂过，","poem":1},{"lineBreak":true},{"text":"使我毛骨悚然。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"那灵停住，","poem":1},{"lineBreak":true},{"text":"我无法辨认其模样。","poem":1},{"lineBreak":true},{"text":"眼前出现一个形状，","poem":1},{"lineBreak":true},{"text":"寂静中听见有声音说，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"‘在上帝面前，世人岂算得上公义？","poem":1},{"lineBreak":true},{"text":"在创造主面前，凡人岂算得上纯洁？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"连上帝的仆人都无法令祂信任，","poem":1},{"lineBreak":true},{"text":"连祂的天使都被祂找出过错，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"更何况那源自尘土、","poem":1},{"lineBreak":true},{"text":"住在土造的躯壳里、","poem":1},{"lineBreak":true},{"text":"脆弱如蛾虫的世人呢？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"早晚之间，他们便被毁灭，","poem":1},{"lineBreak":true},{"text":"永远消逝，无人察觉。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们帐篷的绳索拔掉了，","poem":1},{"lineBreak":true},{"text":"他们昏昏聩聩地死去。’","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}