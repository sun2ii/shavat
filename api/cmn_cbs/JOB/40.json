{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["耶和华又对约伯说："]},{"type":"verse","number":2,"content":[{"text":"“强辩者岂可与全能者争论？","poem":1},{"lineBreak":true},{"text":"与上帝辩驳的人请作出答复。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"约伯回答耶和华说：","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“我这样卑微，怎能答复你？","poem":1},{"lineBreak":true},{"text":"我只有用手掩口。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我说了一次，不能答复；","poem":1},{"lineBreak":true},{"text":"说了两次，不敢再说。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"那时，耶和华从旋风中对约伯说：","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“你要像勇士一样束腰备战，","poem":1},{"lineBreak":true},{"text":"我来提问，你来回答。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你要推翻我的公义，","poem":1},{"lineBreak":true},{"text":"归罪于我而自以为义吗？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你有上帝那样的臂膀吗？","poem":1},{"lineBreak":true},{"text":"你能像祂那样发出雷鸣吗？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"请展示你的荣耀和光辉，","poem":1},{"lineBreak":true},{"text":"披上你的尊荣和威严；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"发泄你满腔的怒火，","poem":1},{"lineBreak":true},{"text":"鉴察一切骄傲的人，贬抑他们；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"鉴察一切骄傲的人，贬低他们，","poem":1},{"lineBreak":true},{"text":"将恶人原地践踏；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"将他们一起埋进尘土，","poem":1},{"lineBreak":true},{"text":"藏入幽冥。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"这样，我就承认你的右手能拯救自己。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“你看河马，","poem":1},{"lineBreak":true},{"text":"它和你都是我造的，","poem":1},{"lineBreak":true},{"text":"它像牛一样吃草。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你看它腰间的气力，","poem":1},{"lineBreak":true},{"text":"它腹部肌肉的力量。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"它尾巴挺直如香柏树，","poem":1},{"lineBreak":true},{"text":"大腿的筋紧密相连，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"骨头如铜管，","poem":1},{"lineBreak":true},{"text":"四肢像铁棍。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"它是上帝创造的杰作，","poem":1},{"lineBreak":true},{"text":"创造主赐给它利刃","poem":1},{"noteId":17},{"text":"。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"群山供应它食物，","poem":1},{"lineBreak":true},{"text":"百兽在那里玩耍。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"它躺在莲叶之下，","poem":1},{"lineBreak":true},{"text":"藏在泥沼的芦苇间，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"莲叶为它遮荫，","poem":1},{"lineBreak":true},{"text":"溪畔的柳树环绕它。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"河水泛滥，它不惊惧；","poem":1},{"lineBreak":true},{"text":"约旦河涨到它口边，它也无忧。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"谁能在它警觉时捕捉它，","poem":1},{"lineBreak":true},{"text":"或用钩子穿透它的鼻子？","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":17,"caller":"+","text":"“创造主赐给它利刃”或译“只有创造主能持利刃接近它”。","reference":{"chapter":40,"verse":19}}]},"thisChapterLink":"/api/cmn_cbs/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}