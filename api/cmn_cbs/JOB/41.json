{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"“你岂能用鱼钩钓海怪，","poem":1},{"lineBreak":true},{"text":"用绳索绑住它的舌头？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你岂能用绳子穿它的鼻子，","poem":1},{"lineBreak":true},{"text":"用钩子穿它的腮骨？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"它岂会向你连连求饶，","poem":1},{"lineBreak":true},{"text":"对你说柔和的话？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"它岂肯与你立约，","poem":1},{"lineBreak":true},{"text":"一生做你的奴隶？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你岂能拿它当小鸟玩耍，","poem":1},{"lineBreak":true},{"text":"或拴起来给幼女取乐？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"渔夫们岂能把它当货物出售，","poem":1},{"lineBreak":true},{"text":"卖给商人？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你岂能在它皮上戳满长矛，","poem":1},{"lineBreak":true},{"text":"头上插满鱼叉？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你动手碰碰它，","poem":1},{"lineBreak":true},{"text":"就知道是场恶战，绝不会再碰。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"企图捕捉它的都会失望，","poem":1},{"lineBreak":true},{"text":"人看到它就会心惊胆战。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"再凶猛的人也不敢惹它。","poem":1},{"lineBreak":true},{"text":"这样，谁能在我面前站立得住？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"谁给过我什么，要我偿还呢？","poem":1},{"lineBreak":true},{"text":"天下万物都是我的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“关于它的四肢、大力和健美的身体，","poem":1},{"lineBreak":true},{"text":"我不能缄默不言。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"谁能剥去它的外皮？","poem":1},{"lineBreak":true},{"text":"谁能给它戴上辔头？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"谁能打开它的嘴巴？","poem":1},{"lineBreak":true},{"text":"它的牙齿令人恐惧。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"它的脊背覆着行行鳞甲，","poem":1},{"lineBreak":true},{"text":"牢牢地密封在一起，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"紧密无间，","poem":1},{"lineBreak":true},{"text":"连气也透不进去。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"鳞甲彼此相连相扣，","poem":1},{"lineBreak":true},{"text":"无法分开。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"它打喷嚏时，水光四射；","poem":1},{"lineBreak":true},{"text":"它的眼睛亮如晨光；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"口中喷出火炬，","poem":1},{"lineBreak":true},{"text":"迸出火星；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"鼻孔冒烟，","poem":1},{"lineBreak":true},{"text":"如沸腾的锅和燃烧的芦苇；","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"呼气可点燃煤炭，","poem":1},{"lineBreak":true},{"text":"口中喷出火焰；","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"颈项强而有力，","poem":1},{"lineBreak":true},{"text":"恐惧在它前面开路；","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"身上的皱褶紧密相连，","poem":1},{"lineBreak":true},{"text":"牢牢地密封在一起；","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"心坚如石，","poem":1},{"lineBreak":true},{"text":"硬如磨石。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"它一站起来，勇士都害怕，","poem":1},{"lineBreak":true},{"text":"见它冲来，他们慌忙退缩。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"刀剑挡不住它，","poem":1},{"lineBreak":true},{"text":"长矛、标枪、尖戟也无能为力。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"它视铁如干草，","poem":1},{"lineBreak":true},{"text":"视铜如朽木。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"利箭吓不跑它，","poem":1},{"lineBreak":true},{"text":"弹石在它看来只是碎秸；","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"棍棒无异于秸秆，","poem":1},{"lineBreak":true},{"text":"它嗤笑投来的标枪。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"它腹部有锋利的瓦片，","poem":1},{"lineBreak":true},{"text":"在淤泥上留下道道耙痕。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"它使深渊如锅翻腾，","poem":1},{"lineBreak":true},{"text":"使大海如油锅滚动。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"它游过后留下一道波光，","poem":1},{"lineBreak":true},{"text":"使深渊仿佛披上银发。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"地上没有动物能与它相比，","poem":1},{"lineBreak":true},{"text":"像它那样无所畏惧。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"它藐视群雄，","poem":1},{"lineBreak":true},{"text":"在高傲的百兽中称王。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}