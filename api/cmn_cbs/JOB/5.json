{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“你只管呼救吧，","poem":1},{"lineBreak":true},{"text":"谁会回应你呢？","poem":1},{"lineBreak":true},{"text":"你向哪位圣者求助呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愤恨害死愚昧人，","poem":1},{"lineBreak":true},{"text":"嫉妒杀死无知者。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我见愚昧人扎了根，","poem":1},{"lineBreak":true},{"text":"突然咒诅临到他家。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他的儿女毫无安宁，","poem":1},{"lineBreak":true},{"text":"在城门口受欺压也无人搭救。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"饥饿的人吞掉他的庄稼，","poem":1},{"lineBreak":true},{"text":"连荆棘里的也不放过；","poem":1},{"lineBreak":true},{"text":"干渴的人吞尽他的财富。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"苦难并非从土里长出，","poem":1},{"lineBreak":true},{"text":"患难并非从地里生出。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"人生来必遇患难，","poem":1},{"lineBreak":true},{"text":"正如火花必向上飞。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“若是我，","poem":1},{"lineBreak":true},{"text":"就向上帝求助，","poem":1},{"lineBreak":true},{"text":"向祂陈明苦衷。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂行的奇事不可测度，","poem":1},{"lineBreak":true},{"text":"祂行的神迹不可胜数。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂降下雨水浇灌大地，","poem":1},{"lineBreak":true},{"text":"赐下甘霖滋润田园。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂提拔卑微的人，","poem":1},{"lineBreak":true},{"text":"庇护哀痛的人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂挫败狡猾人的阴谋，","poem":1},{"lineBreak":true},{"text":"使他们无法得逞。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂使智者中了自己的诡计，","poem":1},{"lineBreak":true},{"text":"使奸徒的计谋迅速落空。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们白天遇到黑暗，","poem":1},{"lineBreak":true},{"text":"午间摸索如在夜晚。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"上帝拯救穷苦人脱离恶人的中伤，","poem":1},{"lineBreak":true},{"text":"脱离残暴之徒的辖制，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"好使贫寒之人有盼望，","poem":1},{"lineBreak":true},{"text":"使不义之徒哑口无言。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“被上帝责备的人有福了，","poem":1},{"lineBreak":true},{"text":"不可轻视全能者的管教。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因为祂打伤，祂也包扎；","poem":1},{"lineBreak":true},{"text":"祂击伤，祂也伸手医治。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"六次遭难，祂都救你；","poem":1},{"lineBreak":true},{"text":"第七次，灾祸也伤不到你。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"饥荒时，祂必救你脱离死亡；","poem":1},{"lineBreak":true},{"text":"战争中，祂必救你脱离刀剑。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你必免受恶毒的毁谤，","poem":1},{"lineBreak":true},{"text":"灾难来临也不惧怕。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你必笑对灾殃和饥荒，","poem":1},{"lineBreak":true},{"text":"毫不惧怕地上的野兽。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你必与田间的石头立约，","poem":1},{"lineBreak":true},{"text":"野兽必与你和平相处。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你必知道家里安然无恙，","poem":1},{"lineBreak":true},{"text":"察看羊圈，一只不少。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你必知道子孙昌盛，","poem":1},{"lineBreak":true},{"text":"后代如遍地的青草。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你必寿终正寝才归坟墓，","poem":1},{"lineBreak":true},{"text":"如同庄稼熟后才被收割。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"看啊，我们已经查验了，","poem":1},{"lineBreak":true},{"text":"这一切真实可靠，","poem":1},{"lineBreak":true},{"text":"你当聆听并学以致用。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}