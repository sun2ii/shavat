{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":6,"content":[{"type":"heading","content":["约伯自述无辜"]},{"type":"verse","number":1,"content":["约伯回答说："]},{"type":"verse","number":2,"content":[{"text":"“要是能称量我的苦难，","poem":1},{"lineBreak":true},{"text":"把我的灾殃放在秤上，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"那将比海沙还重；","poem":1},{"lineBreak":true},{"text":"所以我言语鲁莽。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因为全能者的箭射中我，","poem":1},{"lineBreak":true},{"text":"箭毒侵蚀我的灵，","poem":1},{"lineBreak":true},{"text":"祂使恐惧列队袭来。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"野驴有草岂会叫唤？","poem":1},{"lineBreak":true},{"text":"牛有饲料岂会哞叫？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"淡食无盐岂可下咽？","poem":1},{"lineBreak":true},{"text":"蛋清有什么滋味呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我碰都不想碰，","poem":1},{"lineBreak":true},{"text":"它们令我恶心。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"唯愿我的祈求蒙应允，","poem":1},{"lineBreak":true},{"text":"愿上帝成全我的冀望，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愿祂压碎我，","poem":1},{"lineBreak":true},{"text":"伸手毁灭我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"这样，我还能感到欣慰，","poem":1},{"lineBreak":true},{"text":"在残酷的痛苦中雀跃，","poem":1},{"lineBreak":true},{"text":"因我没有违背圣者之言。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我有何力量可以支撑下去？","poem":1},{"lineBreak":true},{"text":"有何前景让我忍耐下去？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我的力量岂能坚如石？","poem":1},{"lineBreak":true},{"text":"我岂是铜造之躯？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我毫无自救之力，","poem":1},{"lineBreak":true},{"text":"已到穷途末路。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“即使绝望者抛弃对上帝的敬畏，","poem":1},{"lineBreak":true},{"text":"也应该得到朋友的恩待。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的弟兄难以信赖，","poem":1},{"lineBreak":true},{"text":"如同季节河，","poem":1},{"lineBreak":true},{"text":"又像干涸的河床——","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"结冰后颜色发黑，","poem":1},{"lineBreak":true},{"text":"融雪后水流涨溢；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"水流在干季时消失，","poem":1},{"lineBreak":true},{"text":"河床在烈日下干涸。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"商队偏离路线来找水喝，","poem":1},{"lineBreak":true},{"text":"结果在荒漠中死去。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"提玛的商队来找水喝，","poem":1},{"lineBreak":true},{"text":"示巴的旅客指望解渴，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"结果希望化为泡影，","poem":1},{"lineBreak":true},{"text":"到了那里大失所望。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你们同样也帮不了我，","poem":1},{"lineBreak":true},{"text":"你们看见灾祸便害怕。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我何尝对你们说过，","poem":1},{"lineBreak":true},{"text":"‘请你们供应我，","poem":1},{"lineBreak":true},{"text":"把你们的财产给我一份，","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"从仇敌手中拯救我，","poem":1},{"lineBreak":true},{"text":"从残暴之徒手中救赎我’？","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“请多赐教，我会闭口不言；","poem":1},{"lineBreak":true},{"text":"请指出我错在何处。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"忠言何等逆耳！","poem":1},{"lineBreak":true},{"text":"但你们的指责有何根据？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你们既视绝望者的话如风，","poem":1},{"lineBreak":true},{"text":"还要来纠正吗？","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你们甚至抽签得孤儿，","poem":1},{"lineBreak":true},{"text":"把朋友当货物卖掉。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"恳请你们看着我，","poem":1},{"lineBreak":true},{"text":"我在你们面前撒过谎吗？","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"请三思而行，不可不公正；","poem":1},{"lineBreak":true},{"text":"请重新考虑，因我诚实无过。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我岂会说诡诈之言？","poem":1},{"lineBreak":true},{"text":"我岂会是非不辨？","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}