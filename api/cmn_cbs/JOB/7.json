{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"“人生在世岂不像服劳役吗？","poem":1},{"lineBreak":true},{"text":"他有生之年岂不像个雇工吗？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他像切望阴凉的奴隶，","poem":1},{"lineBreak":true},{"text":"又如期盼报酬的雇工。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"同样，我注定要度过虚空的岁月，","poem":1},{"lineBreak":true},{"text":"熬过悲惨的黑夜。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我躺在床上，盘算何时起来。","poem":1},{"lineBreak":true},{"text":"长夜漫漫，我辗转难眠，直到拂晓。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我身上布满蛆虫、伤疤，","poem":1},{"lineBreak":true},{"text":"皮肤破裂，流脓不止。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的年日飞逝，比梭还快，","poem":1},{"lineBreak":true},{"text":"转眼结束，毫无盼望。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“上帝啊，别忘了我的生命不过是一口气，","poem":1},{"lineBreak":true},{"text":"我再也看不见幸福。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"注视我的眼睛将再也看不见我，","poem":1},{"lineBreak":true},{"text":"你将寻找我，而我已不复存在。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"人下到阴间不再上来，","poem":1},{"lineBreak":true},{"text":"如同烟消云散；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他永不再返回家园，","poem":1},{"lineBreak":true},{"text":"故土也不再认识他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“因此我不再缄默不语，","poem":1},{"lineBreak":true},{"text":"我要吐露胸中的悲痛，","poem":1},{"lineBreak":true},{"text":"倾诉心里的苦楚。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"上帝啊，我岂是大海，岂是海怪，","poem":1},{"lineBreak":true},{"text":"值得你这样防范我？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我说床铺是我的安慰，","poem":1},{"lineBreak":true},{"text":"卧榻可解除我的哀愁，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"这时你却用噩梦惊我，","poem":1},{"lineBreak":true},{"text":"用异象吓我，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"以致我宁愿窒息而死，","poem":1},{"lineBreak":true},{"text":"也不愿留着这身骨头。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我厌恶生命，不想永活。","poem":1},{"lineBreak":true},{"text":"不要管我，因为我的日子都是虚空。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“人算什么，你竟这样看重他，","poem":1},{"lineBreak":true},{"text":"这样关注他？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你天天早上察看他，","poem":1},{"lineBreak":true},{"text":"时时刻刻考验他。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你的视线何时离开我，","poem":1},{"lineBreak":true},{"text":"给我咽口唾沫的时间？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"鉴察世人的主啊，","poem":1},{"lineBreak":true},{"text":"我若犯了罪，又于你何妨？","poem":1},{"lineBreak":true},{"text":"为何把我当成你的箭靶？","poem":1},{"lineBreak":true},{"text":"难道我成了你的重担？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"为何不赦免我的过犯，","poem":1},{"lineBreak":true},{"text":"饶恕我的罪恶？","poem":1},{"lineBreak":true},{"text":"我很快将归于尘土，","poem":1},{"lineBreak":true},{"text":"你将寻找我，","poem":1},{"lineBreak":true},{"text":"而我已不复存在。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}