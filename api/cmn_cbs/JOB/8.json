{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":8,"content":[{"type":"heading","content":["比勒达发言"]},{"type":"verse","number":1,"content":["书亚人比勒达回答说："]},{"type":"verse","number":2,"content":[{"text":"“你要这样絮叨到何时？","poem":1},{"lineBreak":true},{"text":"你的话犹如阵阵狂风。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝岂会歪曲正义？","poem":1},{"lineBreak":true},{"text":"全能者岂会颠倒是非？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"如果你的儿女得罪了祂，","poem":1},{"lineBreak":true},{"text":"祂会给他们应有的惩罚。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但你若寻求上帝，","poem":1},{"lineBreak":true},{"text":"向全能者恳求；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你若纯洁、正直，","poem":1},{"lineBreak":true},{"text":"祂必起身相助，","poem":1},{"lineBreak":true},{"text":"恢复你公义的家园。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你起初虽然卑微，","poem":1},{"lineBreak":true},{"text":"日后必兴旺发达。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“你要请教先辈，","poem":1},{"lineBreak":true},{"text":"探究祖先的经验。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为我们昨天才出生，一无所知，","poem":1},{"lineBreak":true},{"text":"我们在世的日子如同掠影。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"先辈必给你教诲和指点，","poem":1},{"lineBreak":true},{"text":"向你道出明智之言。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“蒲草无泥岂可长高？","poem":1},{"lineBreak":true},{"text":"芦苇无水岂可茂盛？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"它们还在生长、尚未割下，","poem":1},{"lineBreak":true},{"text":"已比百草先枯萎。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"忘记上帝的人，结局也是如此；","poem":1},{"lineBreak":true},{"text":"不信上帝的人，盼望终必破灭。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他所仰仗的虚若游丝，","poem":1},{"lineBreak":true},{"text":"他所倚靠的诚如蛛网。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他倚靠它，它却支撑不住；","poem":1},{"lineBreak":true},{"text":"他抓紧它，它却脆弱不稳。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他像阳光下生机勃勃的植物，","poem":1},{"lineBreak":true},{"text":"枝条爬满了园囿，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"根茎盘绕石堆，","poem":1},{"lineBreak":true},{"text":"深深扎入石缝。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"一旦他被连根拔起，","poem":1},{"lineBreak":true},{"text":"原处必否认见过他。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他的生命就这样消逝","poem":1},{"noteId":1},{"text":"，","poem":1},{"lineBreak":true},{"text":"地上会兴起其他人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“上帝绝不会抛弃纯全的人，","poem":1},{"lineBreak":true},{"text":"也不会扶持邪恶的人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"祂要使你笑口常开，","poem":1},{"lineBreak":true},{"text":"欢声不断。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"憎恨你的人必抱愧蒙羞，","poem":1},{"lineBreak":true},{"text":"恶人的帐篷必不复存在。”","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"“他的生命就这样消逝”或译“这就是他一生的乐趣”。","reference":{"chapter":8,"verse":19}}]},"thisChapterLink":"/api/cmn_cbs/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}