{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbs","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"1a81bb70cf0a6a7c1a1cb5467ce5d2ed020992a97cf8ea0fae07c18b9e6c434a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbs/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":9,"content":[{"type":"heading","content":["约伯的回应"]},{"type":"verse","number":1,"content":["约伯回答说："]},{"type":"verse","number":2,"content":[{"text":"“不错，我知道你所言不虚，","poem":1},{"lineBreak":true},{"text":"但人怎能在上帝面前算为义人？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人若想与祂辩驳，","poem":1},{"lineBreak":true},{"text":"千次也不能胜一次。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂充满智慧，能力无比，","poem":1},{"lineBreak":true},{"text":"谁能抗拒祂还能平安无恙？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂可猝然挪动群山，","poem":1},{"lineBreak":true},{"text":"在怒气中把山翻倒。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂震动大地，使其挪位，","poem":1},{"lineBreak":true},{"text":"以致地的支柱摇撼。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂一声令下，","poem":1},{"lineBreak":true},{"text":"太阳便不再升起，","poem":1},{"lineBreak":true},{"text":"众星也不再发光。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂独自铺展穹苍，","poem":1},{"lineBreak":true},{"text":"步行在海浪之上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂创造了北斗星、参星、昴星及南天的星座。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂行的奇事不可测度，","poem":1},{"lineBreak":true},{"text":"奇迹不可胜数。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂经过我身旁，我却看不见；","poem":1},{"lineBreak":true},{"text":"祂从旁边掠过，我也无法察觉。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂若夺取，谁能阻挡？","poem":1},{"lineBreak":true},{"text":"谁敢问祂，‘你做什么？’","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"上帝不会忍怒不发，","poem":1},{"lineBreak":true},{"text":"海怪","poem":1},{"noteId":2},{"text":"的帮手必屈膝在祂脚前。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“因此，我怎敢与祂辩驳？","poem":1},{"lineBreak":true},{"text":"怎敢措辞与祂理论？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我纵然无辜，也无法申诉，","poem":1},{"lineBreak":true},{"text":"只能乞求我的审判者施恩。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"即使我呼唤祂的时候，祂回应我，","poem":1},{"lineBreak":true},{"text":"我仍不相信祂会垂听我的声音。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂用暴风摧毁我，","poem":1},{"lineBreak":true},{"text":"无故地使我饱受创伤。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂不肯让我喘息，","poem":1},{"lineBreak":true},{"text":"祂使我尝尽苦头。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"若论力量，祂甚强大；","poem":1},{"lineBreak":true},{"text":"若上公堂，谁敢传祂？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"即使我清白无辜，我的口也会认罪；","poem":1},{"lineBreak":true},{"text":"即使我纯全无过，祂也会判我有罪。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我虽纯全无过，也已毫不在乎自己，","poem":1},{"lineBreak":true},{"text":"我厌恶我的生命。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为，我认为都是一样，","poem":1},{"lineBreak":true},{"text":"纯全无过的人和恶人都会被祂毁灭。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"灾祸突然夺走人命时，","poem":1},{"lineBreak":true},{"text":"祂嘲笑无辜者的遭遇。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"大地落入恶人手中，","poem":1},{"lineBreak":true},{"text":"蒙蔽审判官眼睛的不是祂是谁？","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“我的年日比信差还快，","poem":1},{"lineBreak":true},{"text":"匆匆而过，不见幸福。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我的岁月疾驰如蒲草船，","poem":1},{"lineBreak":true},{"text":"快如急降抓食的老鹰。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"即使我说要忘掉怨恨，","poem":1},{"lineBreak":true},{"text":"抛开愁容，强颜欢笑，","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"诸多的患难仍使我惧怕，","poem":1},{"lineBreak":true},{"text":"我知道祂","poem":1},{"noteId":3},{"text":"不承认我无辜。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"既然我被定为有罪，","poem":1},{"lineBreak":true},{"text":"又何必徒然挣扎？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"即使我用雪水净身，","poem":1},{"lineBreak":true},{"text":"用碱水洗手，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"祂仍会把我扔进污坑，","poem":1},{"lineBreak":true},{"text":"连我的衣服也嫌弃我。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"祂并非世人，与我迥异，","poem":1},{"lineBreak":true},{"text":"我无法与祂辩驳，一起对簿公堂。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"我俩中间没有仲裁者，","poem":1},{"lineBreak":true},{"text":"无人为我们断定是非","poem":1},{"noteId":4},{"text":"。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"若能拿开祂责打我的刑杖，","poem":1},{"lineBreak":true},{"text":"使我不再受祂的惊吓，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"我就会放胆发言，不必对祂心存恐惧，","poem":1},{"lineBreak":true},{"text":"但现在我却不能这样","poem":1},{"noteId":5},{"text":"。","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"“海怪”希伯来文是“拉哈伯”，下同26:12。","reference":{"chapter":9,"verse":13}},{"noteId":3,"caller":"+","text":"“祂”希伯来文是“你”，下同31节。","reference":{"chapter":9,"verse":28}},{"noteId":4,"caller":"+","text":"“为我们断定是非”希伯来文是“把手按在我们身上”。","reference":{"chapter":9,"verse":33}},{"noteId":5,"caller":"+","text":"“但现在我却不能这样”或译“因为我知道自己的清白”。","reference":{"chapter":9,"verse":35}}]},"thisChapterLink":"/api/cmn_cbs/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}