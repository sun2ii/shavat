{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cbs","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"c30d434a9c11b69e4a3c4fcca3e1c906b7bbbc2857206d2d433c76b2dc06b1f1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cbs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["凄惨的耶路撒冷"]},{"type":"verse","number":1,"content":[{"text":"从前人烟稠密的城，","poem":1},{"lineBreak":true},{"text":"现在何其荒凉！","poem":1},{"lineBreak":true},{"text":"从前扬威列邦的强国，","poem":1},{"lineBreak":true},{"text":"现在竟像寡妇！","poem":1},{"lineBreak":true},{"text":"从前在诸省贵为公主，","poem":1},{"lineBreak":true},{"text":"现在却沦为奴婢！","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"她在夜间痛哭，泪流满面。","poem":1},{"lineBreak":true},{"text":"情人中没有一个前来安慰。","poem":1},{"lineBreak":true},{"text":"朋友都出卖她，与她为敌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"犹大饱受苦难和奴役，","poem":1},{"lineBreak":true},{"text":"被掳往远方，流落异邦，","poem":1},{"lineBreak":true},{"text":"找不到安居之所。","poem":1},{"lineBreak":true},{"text":"她在走投无路之际被追敌擒获。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"通往锡安的道路满目凄凉，","poem":1},{"lineBreak":true},{"text":"因为无人前去过节。","poem":1},{"lineBreak":true},{"text":"她的城门冷落，","poem":1},{"lineBreak":true},{"text":"她的祭司悲叹，","poem":1},{"lineBreak":true},{"text":"她的少女哀伤，她痛苦不已。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"仇敌做了她的主人，","poem":1},{"lineBreak":true},{"text":"她的敌人安逸发达。","poem":1},{"lineBreak":true},{"text":"因为她作恶多端，","poem":1},{"lineBreak":true},{"text":"耶和华叫她饱受困苦，","poem":1},{"lineBreak":true},{"text":"她的孩子被敌人掳去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"少女锡安的尊荣消逝，","poem":1},{"lineBreak":true},{"text":"她的首领像找不到草吃的鹿，","poem":1},{"lineBreak":true},{"text":"无力逃脱敌人的追赶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"在困苦流离中，","poem":1},{"lineBreak":true},{"text":"耶路撒冷想起昔日的荣华。","poem":1},{"lineBreak":true},{"text":"如今，她的人民落在敌人手中，","poem":1},{"lineBreak":true},{"text":"无人援救。","poem":1},{"lineBreak":true},{"text":"她的仇敌幸灾乐祸，嘲笑她的灭亡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶路撒冷罪大恶极，","poem":1},{"lineBreak":true},{"text":"沦为污秽之物。","poem":1},{"lineBreak":true},{"text":"从前尊重她的人看见她赤身裸体，就蔑视她。","poem":1},{"lineBreak":true},{"text":"她只能哀叹、退避。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"她的裙子沾满污秽，","poem":1},{"lineBreak":true},{"text":"她未曾想过自己的结局。","poem":1},{"lineBreak":true},{"text":"她的败落令人震惊，","poem":1},{"lineBreak":true},{"text":"无人安慰。","poem":1},{"lineBreak":true},{"text":"她哭喊道：“耶和华啊，","poem":1},{"lineBreak":true},{"text":"仇敌已经获胜，","poem":1},{"lineBreak":true},{"text":"求你垂顾我的苦难！”","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"敌人伸手夺去她的一切珍宝。","poem":1},{"lineBreak":true},{"text":"她目睹外族人闯入圣殿，","poem":1},{"lineBreak":true},{"text":"耶和华禁止他们进入祂的会众。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"她的人民呻吟着四处觅食，","poem":1},{"lineBreak":true},{"text":"用珍宝换取粮食维生。","poem":1},"耶路撒冷的哀叹",{"text":"她说：“耶和华啊，求你垂顾我，","poem":1},{"lineBreak":true},{"text":"因为我被人蔑视。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“路人啊，你们都无动于衷吗？","poem":1},{"lineBreak":true},{"text":"你们看看，","poem":1},{"lineBreak":true},{"text":"耶和华向我发烈怒，降祸于我，","poem":1},{"lineBreak":true},{"text":"还有谁比我更痛苦呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“祂从高天降下火来，","poem":1},{"lineBreak":true},{"text":"使火在我骨中燃烧；","poem":1},{"lineBreak":true},{"text":"祂在我脚前设下网罗，","poem":1},{"lineBreak":true},{"text":"使我返回；","poem":1},{"lineBreak":true},{"text":"祂使我凄凉孤寂，终日痛苦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“我的罪恶连接成轭，","poem":1},{"lineBreak":true},{"text":"祂亲手把它们绑在一起，","poem":1},{"lineBreak":true},{"text":"系在我的颈项上，","poem":1},{"lineBreak":true},{"text":"使我精疲力尽。","poem":1},{"lineBreak":true},{"text":"主把我交给我无力抵挡的敌人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“主弃绝我所有的勇士，","poem":1},{"lineBreak":true},{"text":"召集军队攻击我，","poem":1},{"lineBreak":true},{"text":"打垮我的青年。","poem":1},{"lineBreak":true},{"text":"主践踏处女犹大，","poem":1},{"lineBreak":true},{"text":"如同在榨酒池中踩踏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“我为此哭泣，","poem":1},{"lineBreak":true},{"text":"泪流满面，","poem":1},{"lineBreak":true},{"text":"却无人安慰、鼓励我。","poem":1},{"lineBreak":true},{"text":"我的儿女凄凉孤苦，","poem":1},{"lineBreak":true},{"text":"因为仇敌已经得胜。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"锡安伸手求助，却无人安慰她。","poem":1},{"lineBreak":true},{"text":"耶和华已命四周邻国与雅各为敌。","poem":1},{"lineBreak":true},{"text":"耶路撒冷在他们当中成了污秽之物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“但耶和华是公义的，","poem":1},{"lineBreak":true},{"text":"因为我违背了祂的命令。","poem":1},{"lineBreak":true},{"text":"万国啊，请听我的话，","poem":1},{"lineBreak":true},{"text":"看看我的痛苦！","poem":1},{"lineBreak":true},{"text":"我的少男少女都被掳去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“我向情人们求助，","poem":1},{"lineBreak":true},{"text":"他们却欺骗我。","poem":1},{"lineBreak":true},{"text":"我的祭司和长老在觅食求生时，","poem":1},{"lineBreak":true},{"text":"倒毙在城中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“耶和华啊，","poem":1},{"lineBreak":true},{"text":"看看我是多么痛苦！","poem":1},{"lineBreak":true},{"text":"我愁肠百结，","poem":1},{"lineBreak":true},{"text":"我的心灵翻腾，","poem":1},{"lineBreak":true},{"text":"因为我极其悖逆。","poem":1},{"lineBreak":true},{"text":"街上有刀剑夺命，","poem":1},{"lineBreak":true},{"text":"家中有死亡笼罩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“人们听见我的哀叹，","poem":1},{"lineBreak":true},{"text":"却无人安慰我。","poem":1},{"lineBreak":true},{"text":"敌人听说你降给我的灾难，","poem":1},{"lineBreak":true},{"text":"都幸灾乐祸。","poem":1},{"lineBreak":true},{"text":"愿你宣告的审判之日来临，","poem":1},{"lineBreak":true},{"text":"叫他们像我一样受苦！","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“愿他们的恶行都摆在你眼前！","poem":1},{"lineBreak":true},{"text":"你怎样因我一切的罪恶而惩罚我，","poem":1},{"lineBreak":true},{"text":"愿你也照样惩罚他们！","poem":1},{"lineBreak":true},{"text":"我叹息不绝，心中哀伤。”","poem":1}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}