{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cbs","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"c30d434a9c11b69e4a3c4fcca3e1c906b7bbbc2857206d2d433c76b2dc06b1f1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cbs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["耶和华惩罚耶路撒冷"]},{"type":"verse","number":1,"content":[{"text":"主的怒气像乌云一样遮盖少女锡安，","poem":1},{"lineBreak":true},{"text":"祂将以色列的荣美从天上扔到地上。","poem":1},{"lineBreak":true},{"text":"祂发怒的时候并不顾念自己的脚凳。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"主毫不留情地毁灭雅各一切的住处，","poem":1},{"lineBreak":true},{"text":"祂在烈怒中夷平犹大的堡垒，","poem":1},{"lineBreak":true},{"text":"让以色列及其首领蒙羞。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"祂发烈怒毁灭以色列全军。","poem":1},{"lineBreak":true},{"text":"敌人袭来时，祂收回援手。","poem":1},{"lineBreak":true},{"text":"祂像烈焰一样吞噬雅各。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"祂张弓搭箭，宛若仇敌，","poem":1},{"lineBreak":true},{"text":"祂的右手蓄势待发，","poem":1},{"lineBreak":true},{"text":"祂杀了一切悦人眼目的人，","poem":1},{"lineBreak":true},{"text":"将祂的怒火撒向少女锡安的帐篷。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"主像敌人一样毁灭以色列，","poem":1},{"lineBreak":true},{"text":"吞噬她的宫殿，夷平她的堡垒，","poem":1},{"lineBreak":true},{"text":"使犹大人悲伤哀哭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"祂摧毁自己的居所，","poem":1},{"lineBreak":true},{"text":"如同摧毁花园；","poem":1},{"lineBreak":true},{"text":"祂摧毁祂所定的聚会之处，","poem":1},{"lineBreak":true},{"text":"使锡安的人民忘记安息日和节期。","poem":1},{"lineBreak":true},{"text":"祂在烈怒中弃绝所有的君王和祭司。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"主撇弃自己的祭坛，","poem":1},{"lineBreak":true},{"text":"憎恶自己的圣所，","poem":1},{"lineBreak":true},{"text":"把耶路撒冷的殿墙交给敌人。","poem":1},{"lineBreak":true},{"text":"他们像过节一样，","poem":1},{"lineBreak":true},{"text":"在耶和华的殿中喧嚷吵闹。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华决意拆毁少女锡安的城墙，","poem":1},{"lineBreak":true},{"text":"祂拉了准线，","poem":1},{"lineBreak":true},{"text":"定意毁灭，绝不收手。","poem":1},{"lineBreak":true},{"text":"祂使城墙和壁垒一同悲哀哭泣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"锡安的城门陷入地中，","poem":1},{"lineBreak":true},{"text":"主已摧毁、砍断她的门闩。","poem":1},{"lineBreak":true},{"text":"她的君王和首领流落异邦，","poem":1},{"lineBreak":true},{"text":"律法不复存在，","poem":1},{"lineBreak":true},{"text":"她的先知得不到从耶和华而来的异象。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"少女锡安的长老腰束麻布，","poem":1},{"lineBreak":true},{"text":"头蒙灰尘，坐在地上，","poem":1},{"lineBreak":true},{"text":"默然不语；","poem":1},{"lineBreak":true},{"text":"耶路撒冷的少女垂头至地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我哭得眼睛失明，","poem":1},{"lineBreak":true},{"text":"愁肠百结，肝胆欲碎，","poem":1},{"lineBreak":true},{"text":"因为人民惨遭毁灭，","poem":1},{"lineBreak":true},{"text":"儿童和婴孩昏倒在城中的街头。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"孩子们问母亲：","poem":1},{"lineBreak":true},{"text":"“哪里有饼和酒呢？”","poem":1},{"lineBreak":true},{"text":"他们像受伤的勇士，","poem":1},{"lineBreak":true},{"text":"昏倒在城中的街头，","poem":1},{"lineBreak":true},{"text":"在母亲怀中奄奄一息。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"少女耶路撒冷啊，我该说什么呢？","poem":1},{"lineBreak":true},{"text":"我把你比作什么呢？","poem":1},{"lineBreak":true},{"text":"处女锡安啊，我用什么比作你，好安慰你呢？","poem":1},{"lineBreak":true},{"text":"你的伤口深如海洋，","poem":1},{"lineBreak":true},{"text":"谁能医治你呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"你的先知所见的异象虚假无用。","poem":1},{"lineBreak":true},{"text":"他们没有揭露你的罪恶，","poem":1},{"lineBreak":true},{"text":"以致你被掳。","poem":1},{"lineBreak":true},{"text":"他们给你的预言虚假谬误。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"路人都拍掌嘲笑你。","poem":1},{"lineBreak":true},{"text":"他们向少女耶路撒冷摇头，","poem":1},{"lineBreak":true},{"text":"嗤笑道：","poem":1},{"lineBreak":true},{"text":"“这就是那被誉为完美无瑕、","poem":1},{"lineBreak":true},{"text":"普世喜悦的城吗？”","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"敌人都幸灾乐祸地讥讽你，","poem":1},{"lineBreak":true},{"text":"他们咬牙切齿地嗤笑说：","poem":1},{"lineBreak":true},{"text":"“我们吞灭了她！","poem":1},{"lineBreak":true},{"text":"这是我们期待已久的日子！","poem":1},{"lineBreak":true},{"text":"我们终于见到这一天了！”","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"耶和华实现了祂的计划，","poem":1},{"lineBreak":true},{"text":"成就了祂很久以前的应许。","poem":1},{"lineBreak":true},{"text":"祂毫不留情地毁灭了你，","poem":1},{"lineBreak":true},{"text":"使你的仇敌幸灾乐祸，","poem":1},{"lineBreak":true},{"text":"使你的敌人耀武扬威。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"少女锡安的城墙啊，","poem":1},{"lineBreak":true},{"text":"你要从心里向主呼求！","poem":1},{"lineBreak":true},{"text":"你的眼泪要像江河一样昼夜涌流，","poem":1},{"lineBreak":true},{"text":"你要不歇不眠。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"你要在夜间打更时起来呼求，","poem":1},{"lineBreak":true},{"text":"在主面前倾心吐意，如水倒出。","poem":1},{"lineBreak":true},{"text":"你要为饿昏街头的孩童向主举手祷告。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“耶和华啊，求你看看，","poem":1},{"lineBreak":true},{"text":"你曾这样对付过谁呢？","poem":1},{"lineBreak":true},{"text":"母亲岂能吃自己生养的孩子？","poem":1},{"lineBreak":true},{"text":"祭司和先知岂能在主的圣所中被杀？","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“老人和少年陈尸街头，","poem":1},{"lineBreak":true},{"text":"少男少女都丧身刀下。","poem":1},{"lineBreak":true},{"text":"你在发怒的日子杀了他们，","poem":1},{"lineBreak":true},{"text":"毫不留情。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“你从四面八方召仇敌攻击我，","poem":1},{"lineBreak":true},{"text":"如同召集人过节。","poem":1},{"lineBreak":true},{"text":"耶和华发怒的日子，","poem":1},{"lineBreak":true},{"text":"无人能逃脱，无人能幸免。","poem":1},{"lineBreak":true},{"text":"敌人杀光了我养育的孩子。”","poem":1}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}