{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cbs","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"c30d434a9c11b69e4a3c4fcca3e1c906b7bbbc2857206d2d433c76b2dc06b1f1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cbs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["刑罚、悔改和盼望"]},{"type":"verse","number":1,"content":[{"text":"我在耶和华烈怒的杖下受尽痛苦。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"祂把我赶进黑暗，","poem":1},{"lineBreak":true},{"text":"使我行路不见光明，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"又屡屡攻击我，终日不断。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"祂使我皮肉枯槁，","poem":1},{"lineBreak":true},{"text":"祂折断我的骨头。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂使我四面受困，","poem":1},{"lineBreak":true},{"text":"尝尽痛苦艰辛。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂使我住在幽暗中，","poem":1},{"lineBreak":true},{"text":"像久已死去的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"祂围困我，使我无法逃脱，","poem":1},{"lineBreak":true},{"text":"祂给我戴上沉重的锁链。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"即使我哀哭呼求，","poem":1},{"lineBreak":true},{"text":"祂也掩耳不听。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂用凿好的石头阻挡我的去路，","poem":1},{"lineBreak":true},{"text":"使我的道路曲折难行。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"祂像埋伏的巨熊，","poem":1},{"lineBreak":true},{"text":"又像伺机突袭的猛狮，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"把我拖离大路，","poem":1},{"lineBreak":true},{"text":"撕成碎片，使我一片凄凉。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂弯弓搭箭，把我当箭靶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"祂用箭袋中的箭射穿我的心脏。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我成了万民的笑柄，","poem":1},{"lineBreak":true},{"text":"他们终日唱歌讽刺我。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂使我饱受苦楚，尝尽苦涩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"祂用石子硌断我的牙齿，","poem":1},{"lineBreak":true},{"text":"把我践踏在尘土中。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你使我失去平安，","poem":1},{"lineBreak":true},{"text":"忘记了什么是福乐。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我说：“我精疲力竭，","poem":1},{"lineBreak":true},{"text":"对耶和华失去盼望。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"想起我的痛苦和漂泊流离，","poem":1},{"lineBreak":true},{"text":"就如苦艾和胆汁一样苦涩。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"那情景萦绕心头，","poem":1},{"lineBreak":true},{"text":"使我心情沉重。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"然而，我想起这事，","poem":1},{"lineBreak":true},{"text":"便有了盼望，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为耶和华的慈爱永不终止，","poem":1},{"lineBreak":true},{"text":"祂的怜悯永无穷尽。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"祂的慈爱和怜悯每天早晨都是新的，","poem":1},{"lineBreak":true},{"text":"祂的信实无比伟大！","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我心里知道，","poem":1},{"lineBreak":true},{"text":"耶和华是我的福分，","poem":1},{"lineBreak":true},{"text":"我要仰望祂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"耶和华必恩待那些等候和寻求祂的人，","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因此，默然等候耶和华的拯救是美好的。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"年轻时负轭受苦是有益的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"受耶和华管教时，","poem":1},{"lineBreak":true},{"text":"要默然独坐。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"要谦卑地脸伏于地，","poem":1},{"lineBreak":true},{"text":"或许还有希望。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"要任人打脸，甘受凌辱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"因为主不会永远撇弃人。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"主尽管使人忧伤，","poem":1},{"lineBreak":true},{"text":"祂依然怜悯人，","poem":1},{"lineBreak":true},{"text":"因为祂有丰盛的慈爱。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"祂不愿使人忧伤、痛苦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"将囚犯踩在脚下，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"在至高者面前冤枉他人，","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"审理案件时颠倒是非，","poem":1},{"lineBreak":true},{"text":"都是主所不容许的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"若非主发命令，","poem":1},{"lineBreak":true},{"text":"谁能说成就成呢？","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"祸福岂不都出自至高者的口吗？","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"世人因自己的罪受罚，","poem":1},{"lineBreak":true},{"text":"又何必怨天尤人呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"让我们省察自己的行为，","poem":1},{"lineBreak":true},{"text":"重新归向耶和华吧！","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"让我们举起双手，","poem":1},{"lineBreak":true},{"text":"诚心向天上的上帝祷告说：","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"“我们犯罪、背叛，","poem":1},{"lineBreak":true},{"text":"你没有赦免我们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“你满怀愤怒地追赶我们，","poem":1},{"lineBreak":true},{"text":"毫不留情地杀戮我们。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"你以密云遮盖自己，","poem":1},{"lineBreak":true},{"text":"以致祷告达不到你那里。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"你使我们在列国中沦为废物、渣滓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“我们的仇敌都幸灾乐祸。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"我们充满恐惧，","poem":1},{"lineBreak":true},{"text":"面临陷阱、残害和毁灭。”","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"因同胞被毁灭，我泪流成河。","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"我的眼泪涌流不息，","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"直到耶和华从天上垂顾。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"目睹城中妇女的遭遇，","poem":1},{"lineBreak":true},{"text":"我痛苦不已。","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"敌人无故地追捕我，","poem":1},{"lineBreak":true},{"text":"如同捕猎飞鸟。","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"他们把我推进坑里，","poem":1},{"lineBreak":true},{"text":"又用石头砸我。","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"水已经漫过我的头，","poem":1},{"lineBreak":true},{"text":"我想我要灭亡了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"我在深坑呼求你的名。","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"你曾垂听我的呼求，","poem":1},{"lineBreak":true},{"text":"求你现在不要掩耳不听我的求救声。","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"我向你呼求的时候，","poem":1},{"lineBreak":true},{"text":"你曾走近我身旁，","poem":1},{"lineBreak":true},{"text":"安慰我说：“不要害怕！”","poem":1}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"主啊，你为我申了冤，","poem":1},{"lineBreak":true},{"text":"救赎了我的性命。","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"耶和华啊，你已明察我的冤情，","poem":1},{"lineBreak":true},{"text":"求你为我主持公道。","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"你看见了他们怎样仇恨我、","poem":1},{"lineBreak":true},{"text":"谋害我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"你听见了他们怎样辱骂我、","poem":1},{"lineBreak":true},{"text":"谋害我。","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"他们整天诽谤我，图谋害我。","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"你看！他们或坐下或起来，","poem":1},{"lineBreak":true},{"text":"都唱歌讽刺我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你按照他们的所作所为报应他们！","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"求你使他们心里刚硬，","poem":1},{"lineBreak":true},{"text":"让你的咒诅落在他们身上！","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"求你发怒追赶他们，","poem":1},{"lineBreak":true},{"text":"从你诸天之下铲除他们！","poem":1}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}