{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cbs","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"c30d434a9c11b69e4a3c4fcca3e1c906b7bbbc2857206d2d433c76b2dc06b1f1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cbs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["沦陷的耶路撒冷"]},{"type":"verse","number":1,"content":[{"text":"黄金竟失去光泽，","poem":1},{"lineBreak":true},{"text":"纯金竟变色，","poem":1},{"lineBreak":true},{"text":"宝石竟被弃之街头。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"锡安的宝贝儿女本来贵如纯金，","poem":1},{"lineBreak":true},{"text":"现在竟被视为陶匠制作的瓦器！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"豺狼尚且哺养自己的幼儿，","poem":1},{"lineBreak":true},{"text":"我的百姓却像荒野的鸵鸟般残忍。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"婴儿干渴难忍，舌头紧贴上膛；","poem":1},{"lineBreak":true},{"text":"孩童乞求食物，却无人给予。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"昔日吃美味佳肴的，","poem":1},{"lineBreak":true},{"text":"如今在街头穷困潦倒；","poem":1},{"lineBreak":true},{"text":"穿锦衣紫袍长大的，","poem":1},{"lineBreak":true},{"text":"如今躺卧在粪堆中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"虽然无人攻击，所多玛却在顷刻之间倾覆。","poem":1},{"lineBreak":true},{"text":"我的百姓比所多玛受到的惩罚更重。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"锡安的首领曾比雪纯净，","poem":1},{"lineBreak":true},{"text":"比奶更白，","poem":1},{"lineBreak":true},{"text":"身体比红宝石更红润，","poem":1},{"lineBreak":true},{"text":"相貌美如蓝宝石。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"现在，他们的面目比煤炭还黑，","poem":1},{"lineBreak":true},{"text":"走在街上无人认得。","poem":1},{"lineBreak":true},{"text":"他们骨瘦如柴，干如枯木。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"死于刀下的胜过死于饥饿的，","poem":1},{"lineBreak":true},{"text":"就是因田间缺粮而饿死的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"我的百姓遭毁灭时，","poem":1},{"lineBreak":true},{"text":"慈母亲手煮自己的儿女充饥。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和华大发烈怒，","poem":1},{"lineBreak":true},{"text":"倾倒祂的怒气，","poem":1},{"lineBreak":true},{"text":"在锡安燃起大火，","poem":1},{"lineBreak":true},{"text":"焚毁城的根基。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"地上的君王和世上的居民都不相信敌人能闯进耶路撒冷的城门。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"这都是因为她先知的罪行和祭司的过犯。","poem":1},{"lineBreak":true},{"text":"他们在城中杀害义人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"他们如盲人在街上游荡，","poem":1},{"lineBreak":true},{"text":"沾满血污，","poem":1},{"lineBreak":true},{"text":"无人敢碰他们的衣服。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"人们向他们喊道：","poem":1},{"lineBreak":true},{"text":"“走开！你们是不洁的！","poem":1},{"lineBreak":true},{"text":"走开！走开！不要靠近我们。”","poem":1},{"lineBreak":true},{"text":"于是他们逃亡、流荡，","poem":1},{"lineBreak":true},{"text":"列国的人说：","poem":1},{"lineBreak":true},{"text":"“他们不可再住在我们这里。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和华亲自驱散他们，","poem":1},{"lineBreak":true},{"text":"不再眷顾他们；","poem":1},{"lineBreak":true},{"text":"人们不再尊重祭司，","poem":1},{"lineBreak":true},{"text":"也不再恩待长老。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"我们望眼欲穿，","poem":1},{"lineBreak":true},{"text":"盼望援军的到来，","poem":1},{"lineBreak":true},{"text":"盼望的却是无力拯救之国。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"敌人步步紧逼，","poem":1},{"lineBreak":true},{"text":"使我们不敢上自己的街。","poem":1},{"lineBreak":true},{"text":"我们的结局近了，","poem":1},{"lineBreak":true},{"text":"我们的日子到头了，","poem":1},{"lineBreak":true},{"text":"我们的结局来了！","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"追赶我们的人比飞鹰更快，","poem":1},{"lineBreak":true},{"text":"他们在山上追捕我们，","poem":1},{"lineBreak":true},{"text":"在旷野伏击我们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"我们的生命之气——","poem":1},{"lineBreak":true},{"text":"耶和华膏立的王落入他们的陷阱。","poem":1},{"lineBreak":true},{"text":"我们原希望借他的荫庇立足于列国中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"你们住在乌斯地区的以东人啊，","poem":1},{"lineBreak":true},{"text":"只管欢喜作乐吧！","poem":1},{"lineBreak":true},{"text":"因为盛满耶和华愤怒的杯也要传到你们那里。","poem":1},{"lineBreak":true},{"text":"你们必喝醉，以致赤身露体。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"少女锡安啊！你已经受到了应得的刑罚，","poem":1},{"lineBreak":true},{"text":"耶和华必不再使你流亡。","poem":1},{"lineBreak":true},{"text":"少女以东啊，耶和华要因你的罪过而惩罚你，","poem":1},{"lineBreak":true},{"text":"揭露你的罪恶！","poem":1}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}