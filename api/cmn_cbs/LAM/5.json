{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cbs","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"c30d434a9c11b69e4a3c4fcca3e1c906b7bbbc2857206d2d433c76b2dc06b1f1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cbs/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["求耶和华怜悯"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你顾念我们的遭遇，","poem":1},{"lineBreak":true},{"text":"看看我们所受的耻辱！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我们的土地被陌生人侵占，","poem":1},{"lineBreak":true},{"text":"我们的房屋落入外族人手中。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我们成了丧父的孤儿，","poem":1},{"lineBreak":true},{"text":"我们的母亲成了寡妇。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们喝水要付钱，","poem":1},{"lineBreak":true},{"text":"烧的柴要用钱买。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"敌人紧追不舍，","poem":1},{"lineBreak":true},{"text":"我们疲惫不堪，不得安歇。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"为了得到食物，","poem":1},{"lineBreak":true},{"text":"我们向埃及、亚述卑躬屈膝。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我们的祖先犯了罪，","poem":1},{"lineBreak":true},{"text":"已经逝去，","poem":1},{"lineBreak":true},{"text":"我们却要承担他们的罪责。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"奴仆做了我们的主人，","poem":1},{"lineBreak":true},{"text":"无人从他们手中解救我们。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"旷野中杀机四伏，","poem":1},{"lineBreak":true},{"text":"我们冒着生命危险才得到粮食。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我们因饥饿而发热，","poem":1},{"lineBreak":true},{"text":"皮肤热如烤炉。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"妇女在锡安遭强暴，","poem":1},{"lineBreak":true},{"text":"少女在犹大的城邑被奸污。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"首领双手被吊起来，","poem":1},{"lineBreak":true},{"text":"老人得不到尊敬。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"青年被迫推磨，","poem":1},{"lineBreak":true},{"text":"孩童肩背柴捆，步履蹒跚。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"老人不再坐在城门口，","poem":1},{"lineBreak":true},{"text":"青年不再弹琴奏乐。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我们心中的快乐消失，","poem":1},{"lineBreak":true},{"text":"我们的舞蹈变成了哀哭。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"荣耀的冠冕从我们头上落下。","poem":1},{"lineBreak":true},{"text":"我们犯了罪，我们有祸了！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"此情此景使我们黯然神伤，","poem":1},{"lineBreak":true},{"text":"泪眼模糊。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"锡安山一片荒凉，","poem":1},{"lineBreak":true},{"text":"豺狼四处游荡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和华啊，你永远掌权，","poem":1},{"lineBreak":true},{"text":"你的宝座世代长存。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你为何永远忘记我们？","poem":1},{"lineBreak":true},{"text":"为何如此长久地弃绝我们？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和华啊，求你使我们回到你身边，","poem":1},{"lineBreak":true},{"text":"让我们归向你，","poem":1},{"lineBreak":true},{"text":"恢复我们昔日的繁荣！","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"难道你完全弃绝了我们，","poem":1},{"lineBreak":true},{"text":"仍然向我们大发烈怒吗？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}