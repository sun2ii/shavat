{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MAT","translationId":"cmn_cbs","name":"马太福音","commonName":"马太福音","title":"马太福音","order":40,"numberOfChapters":28,"sha256":"cb976bdaab3d48920627d0a7d7e253e7af9397a2f353687afb31854f81be656c","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/cmn_cbs/MAT/28.json","totalNumberOfVerses":1071},"chapter":{"number":1,"content":[{"type":"heading","content":["耶稣基督的家谱"]},{"type":"verse","number":1,"content":["耶稣基督是亚伯拉罕的子孙、大卫的后裔，以下是祂的家谱："]},{"type":"verse","number":2,"content":["亚伯拉罕生以撒， 以撒生雅各， 雅各生犹大和他的兄弟，"]},{"type":"verse","number":3,"content":["犹大和她玛生法勒斯和谢拉， 法勒斯生希斯仑， 希斯仑生兰",{"noteId":0},"，"]},{"type":"verse","number":4,"content":["兰生亚米拿达， 亚米拿达生拿顺， 拿顺生撒门，"]},{"type":"verse","number":5,"content":["撒门和喇合生波阿斯， 波阿斯和路得生俄备得， 俄备得生耶西，"]},{"type":"verse","number":6,"content":["耶西生大卫王。",{"lineBreak":true},"大卫和乌利亚的妻子生所罗门，"]},{"type":"verse","number":7,"content":["所罗门生罗波安， 罗波安生亚比雅， 亚比雅生亚撒，"]},{"type":"verse","number":8,"content":["亚撒生约沙法， 约沙法生约兰， 约兰生乌西雅，"]},{"type":"verse","number":9,"content":["乌西雅生约坦， 约坦生亚哈斯， 亚哈斯生希西迦，"]},{"type":"verse","number":10,"content":["希西迦生玛拿西， 玛拿西生亚们， 亚们生约西亚，"]},{"type":"verse","number":11,"content":["约西亚生耶哥尼雅和他的兄弟， 那时以色列人被掳往巴比伦。"]},{"type":"line_break"},{"type":"verse","number":12,"content":["被掳到巴比伦以后， 耶哥尼雅生撒拉铁， 撒拉铁生所罗巴伯，"]},{"type":"verse","number":13,"content":["所罗巴伯生亚比玉， 亚比玉生以利亚敬， 以利亚敬生亚所，"]},{"type":"verse","number":14,"content":["亚所生撒督， 撒督生亚金， 亚金生以律，"]},{"type":"verse","number":15,"content":["以律生以利亚撒， 以利亚撒生马但， 马但生雅各，"]},{"type":"verse","number":16,"content":["雅各生约瑟。 约瑟就是玛丽亚的丈夫， 那被称为基督",{"noteId":1},"的耶稣就是玛丽亚生的。"]},{"type":"verse","number":17,"content":["这样，从亚伯拉罕到大卫共有十四代，从大卫到被掳至巴比伦也是十四代，从被掳至巴比伦到基督降生也是十四代。"]},{"type":"heading","content":["耶稣的降生"]},{"type":"verse","number":18,"content":["耶稣基督降生的经过记载如下。 耶稣的母亲玛丽亚和约瑟订了婚，还没有成亲就从圣灵怀了孕。"]},{"type":"verse","number":19,"content":["她未婚夫约瑟是个义人，不愿公开地羞辱她，就想暗中和她解除婚约。"]},{"type":"verse","number":20,"content":["他正在考虑这事的时候，主的一位天使在梦中向他显现，说：“大卫的后裔约瑟，不要怕，把玛丽亚娶过来，因为她所怀的孕是从圣灵来的。"]},{"type":"verse","number":21,"content":["她将生一个儿子，你要给祂取名叫耶稣",{"noteId":2},"，因为祂要把自己的子民从罪恶中救出来。”"]},{"type":"verse","number":22,"content":["这一切应验了主借着先知所说的话："]},{"type":"verse","number":23,"content":["“必有童贞女怀孕生子，祂的名字要叫以马内利。”",{"noteId":3},"以马内利的意思是“上帝与我们同在”。"]},{"type":"verse","number":24,"content":["约瑟醒来，就遵从主的天使所吩咐的娶玛丽亚为妻，"]},{"type":"verse","number":25,"content":["只是在她生下孩子之前没有与她同房。约瑟给孩子取名叫耶稣。"]}],"footnotes":[{"noteId":0,"caller":"+","text":"“兰”希腊文是“亚兰”。","reference":{"chapter":1,"verse":3}},{"noteId":1,"caller":"+","text":"“基督”意思是“受膏者”。","reference":{"chapter":1,"verse":16}},{"noteId":2,"caller":"+","text":"“耶稣”意思是“救主”。","reference":{"chapter":1,"verse":21}},{"noteId":3,"caller":"+","text":"以赛亚书7:14。","reference":{"chapter":1,"verse":23}}]},"thisChapterLink":"/api/cmn_cbs/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/MAL/4.json","previousChapterAudioLinks":{},"numberOfVerses":25}