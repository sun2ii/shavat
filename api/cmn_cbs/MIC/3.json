{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cbs","name":"弥迦书","commonName":"弥迦书","title":"弥迦书","order":33,"numberOfChapters":7,"sha256":"2f452e45ab0a57cd41ee90eea1e3a317e2fb9fa13c9d1eb63e3a525aa69770b1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cbs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["斥责以色列的领袖"]},{"type":"verse","number":1,"content":[{"text":"我说：“雅各的首领，以色列家的统治者啊！","poem":1},{"lineBreak":true},{"text":"你们要听！","poem":1},{"lineBreak":true},{"text":"难道你们不知正义吗？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"然而，你们憎恶良善，","poem":1},{"lineBreak":true},{"text":"喜爱邪恶，","poem":1},{"lineBreak":true},{"text":"剥下我百姓的皮，","poem":1},{"lineBreak":true},{"text":"从他们的骨头上剔肉。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们吃我百姓的肉，","poem":1},{"lineBreak":true},{"text":"剥我百姓的皮，","poem":1},{"lineBreak":true},{"text":"打碎他们的骨头，","poem":1},{"lineBreak":true},{"text":"把他们切成块，","poem":1},{"lineBreak":true},{"text":"如同下在锅里、放进釜中的肉。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你们遭难的时候，","poem":1},{"lineBreak":true},{"text":"向耶和华呼求，","poem":1},{"lineBreak":true},{"text":"祂必不应允你们。","poem":1},{"lineBreak":true},{"text":"因你们的恶行，","poem":1},{"lineBreak":true},{"text":"祂必掩面不顾你们。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"“使我的子民步入歧途的先知啊，","poem":1},{"lineBreak":true},{"text":"你们向供养你们的人报平安，","poem":1},{"lineBreak":true},{"text":"出言攻击那不供养你们的人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因此，黑夜必笼罩你们，","poem":1},{"lineBreak":true},{"text":"使你们看不见异象；","poem":1},{"lineBreak":true},{"text":"幽暗必临到你们，","poem":1},{"lineBreak":true},{"text":"使你们无法占卜。","poem":1},{"lineBreak":true},{"text":"太阳要为先知沉落，","poem":1},{"lineBreak":true},{"text":"白昼变为黑夜。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"先见必抱愧，","poem":1},{"lineBreak":true},{"text":"占卜者必蒙羞。","poem":1},{"lineBreak":true},{"text":"因得不到上帝的答复，","poem":1},{"lineBreak":true},{"text":"你们都必羞愧地捂着脸。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"至于我，","poem":1},{"lineBreak":true},{"text":"因有耶和华的灵，","poem":1},{"lineBreak":true},{"text":"我充满权能、正义和力量，","poem":1},{"lineBreak":true},{"text":"能向雅各宣告他的过犯，","poem":1},{"lineBreak":true},{"text":"向以色列宣告他的罪恶。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"雅各家的首领，以色列家的统治者啊，","poem":1},{"lineBreak":true},{"text":"你们要听！","poem":1},{"lineBreak":true},{"text":"你们厌恶正义，颠倒是非；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"以血腥建立锡安，","poem":1},{"lineBreak":true},{"text":"以罪恶建造耶路撒冷。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"城里的首领为贪赃而枉法，","poem":1},{"lineBreak":true},{"text":"祭司为银子而施教，","poem":1},{"lineBreak":true},{"text":"先知为钱财而占卜。","poem":1},{"lineBreak":true},{"text":"他们却宣称倚靠耶和华，说：","poem":1},{"lineBreak":true},{"text":"“耶和华不是在我们当中吗？","poem":1},{"lineBreak":true},{"text":"灾祸不会临到我们。”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"所以，因你们的缘故，","poem":1},{"lineBreak":true},{"text":"锡安必被夷为平地，","poem":1},{"lineBreak":true},{"text":"耶路撒冷必沦为废墟，","poem":1},{"lineBreak":true},{"text":"圣殿山必成为长满荒林的高岗。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}