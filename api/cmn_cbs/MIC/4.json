{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cbs","name":"弥迦书","commonName":"弥迦书","title":"弥迦书","order":33,"numberOfChapters":7,"sha256":"2f452e45ab0a57cd41ee90eea1e3a317e2fb9fa13c9d1eb63e3a525aa69770b1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cbs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["耶路撒冷的将来"]},{"type":"verse","number":1,"content":[{"text":"在末后的日子，","poem":1},{"lineBreak":true},{"text":"耶和华殿所在的山必耸立，","poem":1},{"lineBreak":true},{"text":"高过群山，超过万岭，","poem":1},{"lineBreak":true},{"text":"万民都要涌向它。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"列国都必来，说：","poem":1},{"lineBreak":true},{"text":"“来吧，让我们登耶和华的山，","poem":1},{"lineBreak":true},{"text":"去雅各之上帝的殿。","poem":1},{"lineBreak":true},{"text":"祂必教导我们行祂的道，","poem":1},{"lineBreak":true},{"text":"让我们走祂的路。”","poem":1},{"lineBreak":true},{"text":"因为训诲必出于锡安，","poem":1},{"lineBreak":true},{"text":"耶和华的话语必来自耶路撒冷。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂必在列邦施行审判，","poem":1},{"lineBreak":true},{"text":"为远方的强国平息纷争。","poem":1},{"lineBreak":true},{"text":"他们必把刀剑打成犁头，","poem":1},{"lineBreak":true},{"text":"将矛枪打成镰刀。","poem":1},{"lineBreak":true},{"text":"国与国不再刀兵相见，","poem":1},{"lineBreak":true},{"text":"人们也不再学习战事。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"人人都安然坐在自己的葡萄树和无花果树下，","poem":1},{"lineBreak":true},{"text":"不再担惊受怕。","poem":1},{"lineBreak":true},{"text":"这是万军之耶和华亲口说的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"万民都遵从自己神明的名，","poem":1},{"lineBreak":true},{"text":"但我们要永远遵从我们的上帝耶和华的名。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"“到那日，我要聚集瘸腿的，","poem":1},{"lineBreak":true},{"text":"招聚被掳的和被我惩罚的。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我要使瘸腿的成为余民，","poem":1},{"lineBreak":true},{"text":"让被掳的成为强国。","poem":1},{"lineBreak":true},{"text":"耶和华要在锡安山做王治理他们，","poem":1},{"lineBreak":true},{"text":"从那时直到永远。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“你这羊群的瞭望塔，","poem":1},{"lineBreak":true},{"text":"少女锡安的坚垒啊！","poem":1},{"lineBreak":true},{"text":"你从前的国权必得恢复，","poem":1},{"lineBreak":true},{"text":"少女耶路撒冷的王位必归你。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"现在你为何大声哭喊？","poem":1},{"lineBreak":true},{"text":"是因为你没有王吗？","poem":1},{"lineBreak":true},{"text":"难道你的谋士都死了吗，","poem":1},{"lineBreak":true},{"text":"以致你像分娩的妇人一样痛苦不堪？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"少女锡安啊，","poem":1},{"lineBreak":true},{"text":"你要像分娩的妇人一样辗转呻吟，","poem":1},{"lineBreak":true},{"text":"因为你现在要离开这城，","poem":1},{"lineBreak":true},{"text":"住在荒野，被掳到巴比伦。","poem":1},{"lineBreak":true},{"text":"在那里，你将得到解救；","poem":1},{"lineBreak":true},{"text":"在那里，耶和华必从敌人手中救赎你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"现在许多国家一起来攻击你，说：","poem":1},{"lineBreak":true},{"text":"“愿锡安遭蹂躏，","poem":1},{"lineBreak":true},{"text":"我们要看着锡安被毁灭。”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们却不知道耶和华的心意，","poem":1},{"lineBreak":true},{"text":"也不明白祂的计划。","poem":1},{"lineBreak":true},{"text":"祂聚集他们，","poem":1},{"lineBreak":true},{"text":"像把禾捆堆积在麦场一样。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"“少女锡安啊，","poem":1},{"lineBreak":true},{"text":"起来打谷吧！","poem":1},{"lineBreak":true},{"text":"我要给你铁角，","poem":1},{"lineBreak":true},{"text":"我要给你铜蹄。","poem":1},{"lineBreak":true},{"text":"你要打碎列国，","poem":1},{"lineBreak":true},{"text":"将他们的不义之财献给耶和华，","poem":1},{"lineBreak":true},{"text":"把他们的财富献给普天下的主。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}