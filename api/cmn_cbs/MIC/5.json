{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cbs","name":"弥迦书","commonName":"弥迦书","title":"弥迦书","order":33,"numberOfChapters":7,"sha256":"2f452e45ab0a57cd41ee90eea1e3a317e2fb9fa13c9d1eb63e3a525aa69770b1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cbs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["耶和华的应许"]},{"type":"verse","number":1,"content":[{"text":"耶路撒冷的居民","poem":1},{"noteId":2},{"text":"啊，","poem":1},{"lineBreak":true},{"text":"现在你们要调集军队！","poem":1},{"lineBreak":true},{"text":"敌人正四面围攻我们，","poem":1},{"lineBreak":true},{"text":"要用杖击打以色列首领的脸颊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"以法他的伯利恒啊，","poem":1},{"lineBreak":true},{"text":"你在犹大各城中毫不起眼，","poem":1},{"lineBreak":true},{"text":"但将有一位从你那里出来，","poem":1},{"lineBreak":true},{"text":"为我统治以色列；","poem":1},{"lineBreak":true},{"text":"祂的根源自亘古，来自太初。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因此，耶和华要将以色列人交给他们的敌人，","poem":1},{"lineBreak":true},{"text":"直到那临盆的妇人生下儿子。","poem":1},{"lineBreak":true},{"text":"那时，祂流亡的弟兄将重返他们的以色列同胞那里。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂要挺身而起，","poem":1},{"lineBreak":true},{"text":"倚靠耶和华的能力，","poem":1},{"lineBreak":true},{"text":"奉祂上帝耶和华的威名牧养祂的群羊。","poem":1},{"lineBreak":true},{"text":"他们将安然居住，","poem":1},{"lineBreak":true},{"text":"因为那时祂必受尊崇，直达地极。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂必给他们带来平安！","poem":1},{"lineBreak":true},{"text":"亚述人侵略我们的国土、践踏我们的宫殿时，","poem":1},{"lineBreak":true},{"text":"我们将选立七位牧者和八位首领抗击他们。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们要用刀剑统治亚述，统治宁录地区。","poem":1},{"lineBreak":true},{"text":"亚述人侵入我们国境、践踏我们疆土时，","poem":1},{"lineBreak":true},{"text":"祂必拯救我们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"雅各余剩的子孙将在万民中像从耶和华那里降下的雨露，","poem":1},{"lineBreak":true},{"text":"又像洒在草上的甘霖。","poem":1},{"lineBreak":true},{"text":"他们不依靠人，","poem":1},{"lineBreak":true},{"text":"不冀望于世人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"在各国各民中，","poem":1},{"lineBreak":true},{"text":"雅各余剩的子孙犹如林间百兽中的狮子，","poem":1},{"lineBreak":true},{"text":"又像闯入羊群的猛狮，","poem":1},{"lineBreak":true},{"text":"将猎物扑倒撕碎，","poem":1},{"lineBreak":true},{"text":"无人能搭救。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愿你们伸手战胜仇敌！","poem":1},{"lineBreak":true},{"text":"愿你们的仇敌都被铲除！","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"“到那日，","poem":1},{"lineBreak":true},{"text":"我要消灭你们的战马，","poem":1},{"lineBreak":true},{"text":"毁坏你们的战车。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我要摧毁你们境内的城邑，","poem":1},{"lineBreak":true},{"text":"拆除你们所有的堡垒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我要除掉你们手中的巫术，","poem":1},{"lineBreak":true},{"text":"使你们那里不再有占卜的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我要从你们中间除去雕刻的神像和神柱，","poem":1},{"lineBreak":true},{"text":"使你们不再跪拜自己所造的。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我要从你们中间铲除亚舍拉神像，","poem":1},{"lineBreak":true},{"text":"毁灭你们的城邑。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要在烈怒中报应那些不听从我的国家。”","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"“耶路撒冷的居民”希伯来文是“被围攻的女子”。","reference":{"chapter":5,"verse":1}}]},"thisChapterLink":"/api/cmn_cbs/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}