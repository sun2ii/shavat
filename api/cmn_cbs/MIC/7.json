{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cbs","name":"弥迦书","commonName":"弥迦书","title":"弥迦书","order":33,"numberOfChapters":7,"sha256":"2f452e45ab0a57cd41ee90eea1e3a317e2fb9fa13c9d1eb63e3a525aa69770b1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cbs/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["以色列的败坏"]},{"type":"verse","number":1,"content":[{"text":"我真悲惨！","poem":1},{"lineBreak":true},{"text":"我就像夏天的果子已被收尽，","poem":1},{"lineBreak":true},{"text":"葡萄已被摘净，","poem":1},{"lineBreak":true},{"text":"找不到一串可吃的，","poem":1},{"lineBreak":true},{"text":"寻不见我心中渴望的初熟无花果。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"虔敬人已从大地上灭绝，","poem":1},{"lineBreak":true},{"text":"世间再没有正直人。","poem":1},{"lineBreak":true},{"text":"人人伺机杀人流血，","poem":1},{"lineBreak":true},{"text":"用网罗猎取自己的弟兄。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们善于作恶。","poem":1},{"lineBreak":true},{"text":"领袖和审判官索要贿赂，","poem":1},{"lineBreak":true},{"text":"显贵袒露心中的恶欲，朋比为奸。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们当中最好的不过是蒺藜，","poem":1},{"lineBreak":true},{"text":"最正直的也不过是荆棘篱笆。","poem":1},{"lineBreak":true},{"text":"你们的守望者所说的日子，","poem":1},{"lineBreak":true},{"text":"就是你们受惩罚的日子已经来到。","poem":1},{"lineBreak":true},{"text":"你们必惊慌失措。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"不要相信邻居，","poem":1},{"lineBreak":true},{"text":"不要信赖朋友，","poem":1},{"lineBreak":true},{"text":"即使对你怀中的妻子也要守口如瓶。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因为儿子藐视父亲，","poem":1},{"lineBreak":true},{"text":"女儿与母亲作对，","poem":1},{"lineBreak":true},{"text":"媳妇与婆婆作对；","poem":1},{"lineBreak":true},{"text":"家人之间反目成仇。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"至于我，","poem":1},{"lineBreak":true},{"text":"我要仰望耶和华，","poem":1},{"lineBreak":true},{"text":"等候拯救我的上帝；","poem":1},{"lineBreak":true},{"text":"我的上帝必垂听我的祈求。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的仇敌啊，","poem":1},{"lineBreak":true},{"text":"你们不要对我幸灾乐祸！","poem":1},{"lineBreak":true},{"text":"我虽跌倒，但必再起来；","poem":1},{"lineBreak":true},{"text":"我虽坐在黑暗里，","poem":1},{"lineBreak":true},{"text":"但耶和华必做我的光。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我得罪了耶和华，","poem":1},{"lineBreak":true},{"text":"所以要承受祂的怒气，","poem":1},{"lineBreak":true},{"text":"直到祂为我辩护，替我申冤。","poem":1},{"lineBreak":true},{"text":"祂必领我进入光明，","poem":1},{"lineBreak":true},{"text":"我必亲睹祂的公义。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的仇敌见状都必满面羞愧，","poem":1},{"lineBreak":true},{"text":"他们曾问我：“你的上帝耶和华在哪里？”","poem":1},{"lineBreak":true},{"text":"我必亲眼看见他们遭到报应，","poem":1},{"lineBreak":true},{"text":"他们要像街上的泥土一样被人践踏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"以色列啊，","poem":1},{"lineBreak":true},{"text":"终有一日你会重建自己的城墙。","poem":1},{"lineBreak":true},{"text":"到那日，你必扩张自己的疆域。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"那日，从亚述到埃及的各城，","poem":1},{"lineBreak":true},{"text":"从埃及到幼发拉底河，","poem":1},{"lineBreak":true},{"text":"从天涯到海角","poem":1},{"noteId":3},{"text":"，","poem":1},{"lineBreak":true},{"text":"人们都要到你这里来。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"然而，大地要因地上居民的恶行而荒凉。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你用你的杖牧养你的子民，","poem":1},{"lineBreak":true},{"text":"就是那作你产业的群羊。","poem":1},{"lineBreak":true},{"text":"他们独自住在林中，","poem":1},{"lineBreak":true},{"text":"住在肥沃的田园间。","poem":1},{"lineBreak":true},{"text":"愿他们像从前一样放养在巴珊和基列。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"“我要向他们显出神迹奇事，","poem":1},{"lineBreak":true},{"text":"就像他们离开埃及时一样。”","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"列国看见这一切，","poem":1},{"lineBreak":true},{"text":"都必因自己势力衰微而羞愧，","poem":1},{"lineBreak":true},{"text":"都必用手捂口，耳朵变聋。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他们要像蛇一样舔土，","poem":1},{"lineBreak":true},{"text":"又如地上的爬虫，","poem":1},{"lineBreak":true},{"text":"战战兢兢地走出营寨；","poem":1},{"lineBreak":true},{"text":"他们必畏惧我们的上帝耶和华，","poem":1},{"lineBreak":true},{"text":"他们必对你充满恐惧。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"有何神明像你一样赦免罪恶，","poem":1},{"lineBreak":true},{"text":"饶恕你幸存子民的过犯？","poem":1},{"lineBreak":true},{"text":"你不会永远发怒，","poem":1},{"lineBreak":true},{"text":"因为你乐于施恩。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你必再次怜悯我们，","poem":1},{"lineBreak":true},{"text":"将我们的罪恶践踏在脚下，","poem":1},{"lineBreak":true},{"text":"把我们的一切过犯抛进深海。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你必按古时给我们列祖的誓言，","poem":1},{"lineBreak":true},{"text":"以信实待雅各，","poem":1},{"lineBreak":true},{"text":"以慈爱待亚伯拉罕。","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"“从天涯到海角”希伯来文是“从海到海，从山到山”。","reference":{"chapter":7,"verse":12}}]},"thisChapterLink":"/api/cmn_cbs/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}