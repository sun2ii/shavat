{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"NAM","translationId":"cmn_cbs","name":"那鸿书","commonName":"那鸿书","title":"那鸿书","order":34,"numberOfChapters":3,"sha256":"d79e693d9291c1181c46290aa4a5c562ffc6093c31b065e417b80f6ab1b31ef0","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cbs/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["以下是关于尼尼微的预言，是伊勒歌斯人那鸿的异象录。"]},{"type":"heading","content":["耶和华向尼尼微发怒"]},{"type":"verse","number":2,"content":[{"text":"耶和华是痛恨不贞、施行报应的上帝。","poem":1},{"lineBreak":true},{"text":"耶和华施行报应，充满烈怒。","poem":1},{"lineBreak":true},{"text":"耶和华报应祂的仇敌，向他们发烈怒。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华不轻易发怒，大有能力。","poem":1},{"lineBreak":true},{"text":"耶和华断不以有罪的为无罪。","poem":1},{"lineBreak":true},{"text":"祂行走在旋风和暴风中，","poem":1},{"lineBreak":true},{"text":"云彩是祂脚下的尘土。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂斥责大海，使大海干涸；","poem":1},{"lineBreak":true},{"text":"祂使一切河流枯竭。","poem":1},{"lineBreak":true},{"text":"巴珊和迦密的草木凋零，","poem":1},{"lineBreak":true},{"text":"黎巴嫩的鲜花衰残。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在祂面前，群山震动，丘陵消融。","poem":1},{"lineBreak":true},{"text":"在祂面前，大地隆起，","poem":1},{"lineBreak":true},{"text":"世界和世上的一切都战栗。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂发怒，谁能站立？","poem":1},{"lineBreak":true},{"text":"祂发烈怒，谁能承受？","poem":1},{"lineBreak":true},{"text":"祂的愤怒如火焰喷涌而出，","poem":1},{"lineBreak":true},{"text":"磐石在祂面前崩裂。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华是良善的，","poem":1},{"lineBreak":true},{"text":"是人患难时的避难所；","poem":1},{"lineBreak":true},{"text":"祂看顾那些信靠祂的人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂必用滔滔洪水毁灭尼尼微，","poem":1},{"lineBreak":true},{"text":"把祂的敌人驱逐到黑暗中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"尼尼微人啊，","poem":1},{"lineBreak":true},{"text":"你们为何图谋抵挡耶和华？","poem":1},{"lineBreak":true},{"text":"祂要彻底毁灭你们，","poem":1},{"lineBreak":true},{"text":"无需击打两次。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你们像纠结的荆棘，","poem":1},{"lineBreak":true},{"text":"又像酩酊大醉的人，","poem":1},{"lineBreak":true},{"text":"要如干秸被火烧尽。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你们中间出来一人，","poem":1},{"lineBreak":true},{"text":"一个邪恶的阴谋者，","poem":1},{"lineBreak":true},{"text":"图谋抵挡耶和华。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"“尽管尼尼微势力强大、人口众多，","poem":1},{"lineBreak":true},{"text":"但必被铲除，化为乌有。","poem":1},{"lineBreak":true},{"text":"我的子民啊，我使你们受了苦，","poem":1},{"lineBreak":true},{"text":"但必不再使你们受苦。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"现在我要打碎他们套在你们颈上的轭，","poem":1},{"lineBreak":true},{"text":"松开你们身上的锁链。”","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"尼尼微啊，","poem":1},{"lineBreak":true},{"text":"耶和华已发出有关你的命令：","poem":1},{"lineBreak":true},{"text":"“你的名不会传于后世。","poem":1},{"lineBreak":true},{"text":"我要摧毁你神庙中雕刻和铸造的偶像。","poem":1},{"lineBreak":true},{"text":"我要为你掘好坟墓，","poem":1},{"lineBreak":true},{"text":"因为你毫无用处。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"看啊，","poem":1},{"lineBreak":true},{"text":"传喜讯、报平安的人穿山越岭而来。","poem":1},{"lineBreak":true},{"text":"犹大啊，","poem":1},{"lineBreak":true},{"text":"庆祝你的节期，","poem":1},{"lineBreak":true},{"text":"还你许的愿吧！","poem":1},{"lineBreak":true},{"text":"邪恶之人将不再侵扰你，","poem":1},{"lineBreak":true},{"text":"他们都将被彻底毁灭。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}