{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"NAM","translationId":"cmn_cbs","name":"那鸿书","commonName":"那鸿书","title":"那鸿书","order":34,"numberOfChapters":3,"sha256":"d79e693d9291c1181c46290aa4a5c562ffc6093c31b065e417b80f6ab1b31ef0","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cbs/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["尼尼微的覆灭"]},{"type":"verse","number":1,"content":[{"text":"尼尼微啊，","poem":1},{"lineBreak":true},{"text":"攻击者已经向你扑来。","poem":1},{"lineBreak":true},{"text":"你要进驻堡垒，","poem":1},{"lineBreak":true},{"text":"把守道路，","poem":1},{"lineBreak":true},{"text":"集中全力，","poem":1},{"lineBreak":true},{"text":"准备上阵！","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"虽然掳掠者曾掳掠雅各，","poem":1},{"lineBreak":true},{"text":"掳掠以色列，","poem":1},{"lineBreak":true},{"text":"毁坏他们的葡萄树枝，","poem":1},{"lineBreak":true},{"text":"但耶和华必恢复雅各的荣耀，","poem":1},{"lineBreak":true},{"text":"恢复以色列的荣耀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"他的勇士手持红色盾牌，","poem":1},{"lineBreak":true},{"text":"他的士兵身穿朱红战衣。","poem":1},{"lineBreak":true},{"text":"他们整装待发之日，","poem":1},{"lineBreak":true},{"text":"战车铁光闪闪，","poem":1},{"lineBreak":true},{"text":"松木矛枪在空中挥舞。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"战车在街道上狂奔，","poem":1},{"lineBreak":true},{"text":"在广场上横冲直撞，","poem":1},{"lineBreak":true},{"text":"亮如火炬，疾似闪电。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"亚述王召集将领，","poem":1},{"lineBreak":true},{"text":"他们一路跌跌撞撞，","poem":1},{"lineBreak":true},{"text":"奔上城墙，架起防御盾牌。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"河闸大开，宫殿坍塌。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"王后赤身被掳；","poem":1},{"lineBreak":true},{"text":"宫女捶胸悲泣，","poem":1},{"lineBreak":true},{"text":"像鸽子一样哀鸣。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"尼尼微城自古以来就像聚水的池子，","poem":1},{"lineBreak":true},{"text":"如今居民却像泄漏的池水四散奔逃。","poem":1},{"lineBreak":true},{"text":"虽有人喊：“站住！站住！”","poem":1},{"lineBreak":true},{"text":"却无人回头。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"抢银子吧！抢金子吧！","poem":1},{"lineBreak":true},{"text":"城里有无尽的财富和数不清的宝物。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"尼尼微被洗劫一空！","poem":1},{"lineBreak":true},{"text":"沦为废墟！","poem":1},{"lineBreak":true},{"text":"一片荒凉！","poem":1},{"lineBreak":true},{"text":"人们胆战心惊，双膝哆嗦，","poem":1},{"lineBreak":true},{"text":"浑身发抖，面色苍白。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"如今那狮子的洞穴，","poem":1},{"lineBreak":true},{"text":"那喂养猛狮的地方在哪里呢？","poem":1},{"lineBreak":true},{"text":"从前，雄狮、母狮和幼狮曾在那里出入，","poem":1},{"lineBreak":true},{"text":"无人惊扰。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"雄狮为幼狮撕碎充足的食物，","poem":1},{"lineBreak":true},{"text":"为母狮绞杀猎物，","poem":1},{"lineBreak":true},{"text":"洞穴里堆满猎物，","poem":1},{"lineBreak":true},{"text":"堆满撕碎的肉。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"万军之耶和华说：","poem":1},{"lineBreak":true},{"text":"“我与你为敌，","poem":1},{"lineBreak":true},{"text":"我要烧毁你的战车，","poem":1},{"lineBreak":true},{"text":"使刀剑吞噬你的猛狮；","poem":1},{"lineBreak":true},{"text":"我要使你无法再掳掠他国，","poem":1},{"lineBreak":true},{"text":"你使者的声音将从此消逝。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}