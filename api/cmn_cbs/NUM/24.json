{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"NUM","translationId":"cmn_cbs","name":"民数记","commonName":"民数记","title":"民数记","order":4,"numberOfChapters":36,"sha256":"ba1ab46e42e784cde98e7b69dca91399dcc7d758951f802d5da0412989293c76","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/cmn_cbs/NUM/36.json","totalNumberOfVerses":1267},"chapter":{"number":24,"content":[{"type":"heading","content":["巴兰第三次预言"]},{"type":"verse","number":1,"content":["巴兰见耶和华乐意赐福给以色列人，就不再像先前两次那样去求兆头，而是转向旷野。"]},{"type":"verse","number":2,"content":["他举目眺望，看见以色列人按支派扎营。上帝的灵降在他身上，"]},{"type":"verse","number":3,"content":["他便吟诗预言说：",{"text":"“比珥之子巴兰的预言，","poem":1},{"lineBreak":true},{"text":"是眼睛明亮者的话，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他得听上帝之言，","poem":1},{"lineBreak":true},{"text":"俯伏在地，眼目睁开","poem":1},{"lineBreak":true},{"text":"得见全能者的异象。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"雅各啊，","poem":1},{"lineBreak":true},{"text":"你的帐篷何等华美！","poem":1},{"lineBreak":true},{"text":"以色列啊，","poem":1},{"lineBreak":true},{"text":"你的居所何等佳美！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"像连绵的山谷，","poem":1},{"lineBreak":true},{"text":"如河畔的园子；","poem":1},{"lineBreak":true},{"text":"像耶和华栽种的沉香，","poem":1},{"lineBreak":true},{"text":"如水边的香柏树。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们沐浴充沛的甘霖，","poem":1},{"lineBreak":true},{"text":"撒种于湿润的沃土。","poem":1},{"lineBreak":true},{"text":"他们的君王高过亚甲，","poem":1},{"lineBreak":true},{"text":"国度名震四方。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"上帝带他们出埃及，","poem":1},{"lineBreak":true},{"text":"祂","poem":1},{"noteId":11},{"text":"的力量如野牛之角。","poem":1},{"lineBreak":true},{"text":"他们要吞灭敌国，","poem":1},{"lineBreak":true},{"text":"打碎敌人的骨头，","poem":1},{"lineBreak":true},{"text":"用利箭射穿仇敌。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们蹲伏如雄狮，","poem":1},{"lineBreak":true},{"text":"躺卧如母狮，谁敢招惹？","poem":1},{"lineBreak":true},{"text":"愿祝福他们的人蒙祝福！","poem":1},{"lineBreak":true},{"text":"愿咒诅他们的人受咒诅！”","poem":1}]},{"type":"verse","number":10,"content":["巴勒听了大怒，用力击掌，对巴兰说：“我请你来咒诅我的仇敌，你竟三次祝福他们。"]},{"type":"verse","number":11,"content":["现在快回家去吧！我说过要给你重赏，但耶和华不让你得到。”"]},{"type":"verse","number":12,"content":["巴兰说：“我不是对你派来的使臣说过吗？"]},{"type":"verse","number":13,"content":["就是你把满屋的金银都给我，我也不能违背耶和华的命令、凭自己的意思行事——无论好事坏事。我只能说耶和华让我说的话。"]},{"type":"verse","number":14,"content":["现在我要回本族去了。但我要告诉你日后以色列人会怎样对待你的人民。”"]},{"type":"heading","content":["巴兰第四次预言"]},{"type":"verse","number":15,"content":["巴兰吟诗预言说：",{"text":"“比珥之子巴兰的预言，","poem":1},{"lineBreak":true},{"text":"是眼睛明亮者的话，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他得听上帝之言，","poem":1},{"lineBreak":true},{"text":"明白至高者的旨意，","poem":1},{"lineBreak":true},{"text":"俯伏在地，眼目睁开，","poem":1},{"lineBreak":true},{"text":"得见全能者的异象。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我所见的尚未发生，","poem":1},{"lineBreak":true},{"text":"我目睹的关乎将来。","poem":1},{"lineBreak":true},{"text":"一颗星要从雅各家升起，","poem":1},{"lineBreak":true},{"text":"一位君王要从以色列兴起。","poem":1},{"lineBreak":true},{"text":"他要打烂摩押的前额，","poem":1},{"lineBreak":true},{"text":"击碎塞特人的头颅。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他必征服以东，","poem":1},{"lineBreak":true},{"text":"占领敌疆西珥，","poem":1},{"lineBreak":true},{"text":"以色列必勇往直前。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"雅各的后裔必掌权，","poem":1},{"lineBreak":true},{"text":"消灭城中的余民。”","poem":1}]},{"type":"heading","content":["巴兰最后的预言"]},{"type":"verse","number":20,"content":["巴兰观看亚玛力人，并以诗歌预言说：",{"text":"“亚玛力原是列国之首，","poem":1},{"lineBreak":true},{"text":"但他的结局却是灭亡。”","poem":1}]},{"type":"verse","number":21,"content":["巴兰又观看基尼人，并以诗歌预言说：",{"text":"“虽然你的居所坚固，","poem":1},{"lineBreak":true},{"text":"你的巢筑在峭壁，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"但你必遭灭顶，","poem":1},{"lineBreak":true},{"text":"被亚述掳去。”","poem":1}]},{"type":"verse","number":23,"content":["巴兰又以诗歌预言说：",{"text":"“唉！若上帝做这事，","poem":1},{"lineBreak":true},{"text":"谁能存活呢？","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"船只从基提驶来，","poem":1},{"lineBreak":true},{"text":"征服亚述和希伯，","poem":1},{"lineBreak":true},{"text":"但他也要灭亡。”","poem":1}]},{"type":"verse","number":25,"content":["说完，巴兰动身返回家乡，巴勒也回去了。"]}],"footnotes":[{"noteId":11,"caller":"+","text":"“祂”或译“他们”。","reference":{"chapter":24,"verse":8}}]},"thisChapterLink":"/api/cmn_cbs/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}