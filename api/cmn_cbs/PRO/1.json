{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":1,"content":[{"type":"heading","content":["箴言的价值"]},{"type":"verse","number":1,"content":["这是大卫的儿子以色列王所罗门的箴言。"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"为使人认识智慧和教诲，","poem":1},{"text":"领悟真知灼见，","poem":2}]},{"type":"verse","number":3,"content":[{"text":"接受精明处事的教诲，","poem":1},{"text":"为人处事仁义、公平、正直；","poem":2}]},{"type":"verse","number":4,"content":[{"text":"使愚昧人明智，","poem":1},{"text":"使年轻人有知识和明辨力；","poem":2}]},{"type":"verse","number":5,"content":[{"text":"使智者听了长学问，","poem":1},{"text":"明哲听了得指引；","poem":2}]},{"type":"verse","number":6,"content":[{"text":"使人领悟箴言和比喻，","poem":1},{"text":"明白智者的话和谜语。","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":["知识始于敬畏耶和华，",{"text":"愚人轻视智慧和教诲。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"孩子啊，","poem":1},{"text":"你要听从父亲的教诲，","poem":2},{"lineBreak":true},{"text":"不可背弃母亲的训诲。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"因为这要作你头上的华冠，","poem":1},{"text":"颈上的项链。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"孩子啊，恶人若引诱你，","poem":1},{"text":"不要屈从。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"他们若说：“跟我们来吧，","poem":1},{"text":"我们去埋伏杀人，","poem":2},{"lineBreak":true},{"text":"任意暗害无辜者；","poem":2}]},{"type":"verse","number":12,"content":[{"text":"我们要像阴间一样生吞他们，","poem":1},{"text":"整个吞没他们，","poem":2},{"lineBreak":true},{"text":"使他们如坠入坟墓的人；","poem":2}]},{"type":"verse","number":13,"content":[{"text":"我们必得到各样宝物，","poem":1},{"text":"把战利品装满我们的房屋。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"跟我们一起干吧，","poem":1},{"text":"大家有福同享！”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"孩子啊，","poem":1},{"text":"不要走他们的道，","poem":2},{"lineBreak":true},{"text":"切莫行他们的路。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"因为他们奔向罪恶，","poem":1},{"text":"急速地去杀人流血。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"在飞鸟眼前设网罗，徒劳无功。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们埋伏，却自流己血；","poem":1},{"text":"他们伏击，却自害己命。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"这就是贪爱不义之财者的结局，","poem":1},{"text":"不义之财终要夺去他们的性命。","poem":2}]},{"type":"heading","content":["智慧的劝诫"]},{"type":"verse","number":20,"content":[{"text":"智慧在大街上高喊，","poem":1},{"text":"在广场上扬声，","poem":2}]},{"type":"verse","number":21,"content":[{"text":"在热闹的街头宣告，","poem":1},{"text":"在城门口发言：","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“你们愚昧人喜爱愚昧，","poem":1},{"text":"嘲讽者以嘲弄为乐，","poem":2},{"lineBreak":true},{"text":"无知者厌恶知识，","poem":2},{"lineBreak":true},{"text":"要到什么时候呢？","poem":2}]},{"type":"verse","number":23,"content":[{"text":"你们若因我的责备而回转，","poem":1},{"text":"我就向你们显明我的旨意","poem":2},{"noteId":0},{"text":"，","poem":2},{"lineBreak":true},{"text":"叫你们明白我的话语。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"我呼唤你们，","poem":1},{"text":"你们却充耳不闻；","poem":2},{"lineBreak":true},{"text":"我向你们招手，","poem":2},{"lineBreak":true},{"text":"你们却视若无睹。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"你们漠视我的劝诫，","poem":1},{"text":"不接受我的责备。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"因此，","poem":1},{"text":"你们遭遇灾难时，","poem":2},{"lineBreak":true},{"text":"我必发笑；","poem":2},{"lineBreak":true},{"text":"惊恐临到你们时，","poem":2},{"lineBreak":true},{"text":"我必嗤笑。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"那时，恐惧如风暴袭击你们，","poem":1},{"text":"灾难如旋风临到你们，","poem":2},{"lineBreak":true},{"text":"忧愁和苦难吞没你们。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"你们呼求我，","poem":1},{"text":"我也不回答；","poem":2},{"lineBreak":true},{"text":"你们恳切地寻找我，","poem":2},{"lineBreak":true},{"text":"却找不到。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"因为你们厌恶知识，","poem":1},{"text":"决定不敬畏耶和华，","poem":2}]},{"type":"verse","number":30,"content":[{"text":"不接受我的劝诫，","poem":1},{"text":"又藐视我的责备。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"所以，你们必自食其果，","poem":1},{"text":"因自己的恶谋而吃尽苦头。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"愚昧人背离正道，","poem":1},{"text":"自招灭亡；","poem":2},{"lineBreak":true},{"text":"愚顽人逍遥自在，","poem":2},{"lineBreak":true},{"text":"毁掉自己。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"然而，那听从我的必安然居住，","poem":1},{"text":"得享安宁，","poem":2},{"lineBreak":true},{"text":"不怕灾祸。”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“我就向你们显明我的旨意”希伯来文是“我就将我的灵浇灌你们”。","reference":{"chapter":1,"verse":23}}]},"thisChapterLink":"/api/cmn_cbs/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}