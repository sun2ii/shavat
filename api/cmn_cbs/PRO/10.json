{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":10,"content":[{"type":"heading","content":["所罗门的箴言"]},{"type":"verse","number":1,"content":["以下是所罗门的箴言：",{"text":"智慧儿使父亲快乐，","poem":2},{"lineBreak":true},{"text":"愚昧儿叫母亲忧伤。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"不义之财毫无益处，","poem":1},{"text":"公义救人脱离死亡。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"耶和华不让义人挨饿，","poem":1},{"text":"祂使恶人的奢望成空。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"游手好闲招致贫穷，","poem":1},{"text":"勤奋努力带来富足。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"精明儿夏季时贮藏，","poem":1},{"text":"不肖子收成时酣睡。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"祝福临到义人的头，","poem":1},{"text":"残暴充满恶人的口。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"义人流芳于世，","poem":1},{"text":"恶人名声败坏。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"心存智慧的接受诫命；","poem":1},{"text":"说话愚昧的自招灭亡。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"行正道者活得安稳，","poem":1},{"text":"走歪路者终必败露。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"挤眉弄眼，带来忧伤；","poem":1},{"text":"胡言乱语，导致灭亡。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"义人的口是生命之泉，","poem":1},{"text":"恶人的口却充满残暴。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"恨能挑起纷争，","poem":1},{"text":"爱能遮掩一切过犯。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"明哲口中有智慧，","poem":1},{"text":"无知者背上受鞭打。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"智者储藏知识，","poem":1},{"text":"愚人口惹祸端。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"钱财是富人的坚城，","poem":1},{"text":"贫乏带给穷人毁灭。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"义人的报酬是生命，","poem":1},{"text":"恶人的果子是惩罚。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"听从教诲的，走生命之路；","poem":1},{"text":"拒绝责备的，必步入歧途。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"暗藏仇恨的满口虚谎，","poem":1},{"text":"散布流言的愚不可及。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"言多必失，智者慎言。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"义人之舌似纯银，","poem":1},{"text":"恶人之心无价值。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"义人的口滋养众人，","poem":1},{"text":"愚人因无知而死亡。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"耶和华的祝福使人富足，","poem":1},{"text":"祝福中不加任何忧愁","poem":2},{"noteId":3},{"text":"。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"愚人以恶为乐，","poem":1},{"text":"哲士喜爱智慧。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"恶人所怕的必临到他，","poem":1},{"text":"义人的心愿必得实现。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"暴风扫过，","poem":1},{"text":"恶人消逝无踪，","poem":2},{"lineBreak":true},{"text":"义人永不动摇。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"懒汉让差他的人难受，","poem":1},{"text":"如醋倒牙，如烟熏目。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"敬畏耶和华的享长寿，","poem":1},{"text":"恶人的寿数必被缩短。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"义人的憧憬带来欢乐，","poem":1},{"text":"恶人的希望终必破灭。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"耶和华的道保护正直人，","poem":1},{"text":"毁灭作恶之人。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"义人永不动摇，","poem":1},{"text":"恶人无处容身。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"义人的口发出智慧，","poem":1},{"text":"诡诈的舌必被割掉。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"义人说话得体合宜，","poem":1},{"text":"恶人口出乖谬之言。","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":3,"caller":"+","text":"“祝福中不加任何忧愁”或译“劳苦无法使其加增”。","reference":{"chapter":10,"verse":22}}]},"thisChapterLink":"/api/cmn_cbs/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}