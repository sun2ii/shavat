{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"耶和华憎恶骗人的天平，","poem":1},{"text":"喜爱公平的砝码。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"傲慢带来羞辱，","poem":1},{"text":"谦卑者有智慧。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"正直人被诚实引导，","poem":1},{"text":"奸诈者被奸诈毁灭。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"在降怒之日，财富毫无益处，","poem":1},{"text":"唯有公义能救人免于死亡。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"纯全人行义走坦途，","poem":1},{"text":"恶人作恶致沉沦。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"正直人被义行所救，","poem":1},{"text":"奸诈者被私欲所掳。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"恶人一死，他的希望就破灭，","poem":1},{"text":"他对财势的冀望转眼成空。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"义人脱离患难，","poem":1},{"text":"恶人落入其中。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"不敬虔者张口败坏邻舍，","poem":1},{"text":"义人却因知识获得拯救。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"义人亨通，全城快乐；","poem":1},{"text":"恶人灭亡，人人欢呼。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"城因正直人的祝福而兴盛，","poem":1},{"text":"因恶人的口舌而倾覆。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"无知者轻视邻舍，","poem":1},{"text":"明哲保持缄默。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"嚼舌者泄露秘密，","poem":1},{"text":"忠信者守口如瓶。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"缺乏智谋，国必败亡；","poem":1},{"text":"谋士众多，战无不胜。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"为他人作保，必受亏损；","poem":1},{"text":"厌恶当保人，得享平安。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"贤淑的女子得到尊荣，","poem":1},{"text":"残暴的男子得到资财。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"仁慈的人造福自己，","poem":1},{"text":"残酷的人惹祸上身。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"恶人赚来的转眼成空，","poem":1},{"text":"播种公义的必获奖赏。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"坚持行义，必得生命；","poem":1},{"text":"追逐罪恶，终必灭亡。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"心术不正的人令耶和华憎恶，","poem":1},{"text":"纯全无过的人蒙耶和华喜爱。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"恶人终必受到惩罚，","poem":1},{"text":"义人的子孙必得拯救。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"女子貌美无内涵，","poem":1},{"text":"如同猪鼻挂金环。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"义人的愿望结出善果，","poem":1},{"text":"恶人的希望招致烈怒。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"有人乐善好施，反倒越来越富；","poem":1},{"text":"有人极其吝啬，反而越来越穷。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"慷慨好施的必得昌盛，","poem":1},{"text":"恩待他人的必蒙恩待。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"囤粮不卖，惹人咒诅；","poem":1},{"text":"乐意卖粮，必蒙祝福。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"寻求良善得恩惠，","poem":1},{"text":"追求罪恶遭祸患。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"倚仗财势者必衰败，","poem":1},{"text":"义人必兴旺如绿叶。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"祸害自家，必一无所有，","poem":1},{"text":"愚人必做智者的仆役。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"义人结果如生命之树，","poem":1},{"text":"智者深得人心。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"看啊！义人在世上尚且遭报","poem":1},{"noteId":4},{"text":"，","poem":1},{"text":"更何况恶人和罪人呢！","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":4,"caller":"+","text":"“义人在世上尚且遭报”《七十士译本》作“义人尚且难以得救”，参见彼得前书4:18。","reference":{"chapter":11,"verse":31}}]},"thisChapterLink":"/api/cmn_cbs/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}