{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"喜爱管教的喜爱知识，","poem":1},{"text":"厌恶责备的愚不可及。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"善良的人蒙耶和华赐恩，","poem":1},{"text":"诡诈的人被耶和华定罪。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"人不能靠恶行坚立自己，","poem":1},{"text":"义人的根基却不会动摇。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"贤德的妻子是丈夫的冠冕，","poem":1},{"text":"无耻的妻子如丈夫的骨瘤。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"义人的心思公平正直，","poem":1},{"text":"恶人的计谋阴险诡诈。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"恶人的言语暗藏杀机，","poem":1},{"text":"正直人的口拯救生命。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"恶人覆灭不复存在，","poem":1},{"text":"义人的家屹立不倒。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"人有智慧受称赞，","poem":1},{"text":"心术不正遭唾弃。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"地位卑微却有仆人，","poem":1},{"text":"胜过自大却饿肚子。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"义人顾惜自己的牲畜，","poem":1},{"text":"恶人的怜悯也是残忍。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"努力耕耘，丰衣足食；","poem":1},{"text":"追求虚荣，愚不可及。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"恶人贪恋坏人的赃物，","poem":1},{"text":"义人的根结出硕果。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"恶人被自己的恶言所困，","poem":1},{"text":"但义人可以脱离险境。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"口出良言，饱尝美福；","poem":1},{"text":"双手勤劳，终得回报。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"愚人自以为是，","poem":1},{"text":"智者肯听劝诫。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"愚人难压怒气，","poem":1},{"text":"明哲忍辱负重。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"忠实的证人讲真话，","poem":1},{"text":"作伪证者满口谎言。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"出言不慎犹如利剑伤人，","poem":1},{"text":"智者之言却能医治创伤。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"诚实的口永远长存，","poem":1},{"text":"撒谎的舌转瞬即逝。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"图谋恶事的心怀诡诈，","poem":1},{"text":"劝人和睦的喜乐洋溢。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"义人无灾无难，","poem":1},{"text":"恶人灾祸连连。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"耶和华厌恶说谎的嘴，","poem":1},{"text":"祂喜爱行为诚实的人。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"明哲不露锋芒，","poem":1},{"text":"愚人心吐愚昧。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"殷勤的手必掌权，","poem":1},{"text":"懒惰者必做奴仆。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"忧虑的心使人消沉，","poem":1},{"text":"一句良言振奋人心。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"义人引人走正路，","poem":1},{"text":"恶人领人入歧途。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"懒汉不烤猎物，","poem":1},{"text":"勤快人得资财。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"公义的道上有生命，","poem":1},{"text":"公义的路上无死亡。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}