{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"智慧儿听从父训，","poem":1},{"text":"嘲讽者不听责备。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"口出良言尝善果，","poem":1},{"text":"奸徒贪行残暴事","poem":2},{"noteId":5},{"text":"。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"说话谨慎，可保性命；","poem":1},{"text":"口无遮拦，自取灭亡。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"懒惰人空有幻想，","poem":1},{"text":"勤快人心想事成。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"义人憎恶虚谎，","poem":1},{"text":"恶人可憎可耻。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"公义守卫正直的人，","poem":1},{"text":"邪恶倾覆犯罪之徒。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"有人装作富有，","poem":1},{"text":"其实身无分文；","poem":2},{"lineBreak":true},{"text":"有人假装贫穷，","poem":2},{"lineBreak":true},{"text":"却是腰缠万贯。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"富人用财富赎命，","poem":1},{"text":"穷人却免受惊吓。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"义人的光灿烂，","poem":1},{"text":"恶人的灯熄灭。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"自高自大招惹纷争，","poem":1},{"text":"虚心受教才是睿智。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"不义之财必耗尽，","poem":1},{"text":"勤俭积蓄财富增。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"盼望无期，使人忧伤；","poem":1},{"text":"夙愿得偿，带来生机","poem":2},{"noteId":6},{"text":"。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"蔑视训言，自招灭亡；","poem":1},{"text":"敬畏诫命，必得赏赐。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"智者的训诲是生命之泉，","poem":1},{"text":"可使人避开死亡的陷阱。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"睿智使人蒙恩惠，","poem":1},{"text":"奸徒之路通灭亡。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"明哲知而后行，","poem":1},{"text":"愚人炫耀愚昧。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"奸恶的使者陷入灾祸，","poem":1},{"text":"忠诚的使者带来医治。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"不受管教的贫穷羞愧，","poem":1},{"text":"接受责备的受到尊崇。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"愿望实现使心甘甜，","poem":1},{"text":"远离恶事为愚人憎恶。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"与智者同行必得智慧，","poem":1},{"text":"与愚人结伴必受亏损。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"祸患追赶罪人，","poem":1},{"text":"义人必得善报。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"善人为子孙留下产业，","poem":1},{"text":"罪人给义人积聚财富。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"穷人的田地出产丰富，","poem":1},{"text":"因不公而被抢掠一空。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"不用杖管教儿女是憎恶他们，","poem":1},{"text":"疼爱儿女的随时管教他们。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"义人丰衣足食，","poem":1},{"text":"恶人食不果腹。","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":5,"caller":"+","text":"“奸徒贪行残暴事”或译“奸徒必饱受虐待”。","reference":{"chapter":13,"verse":2}},{"noteId":6,"caller":"+","text":"“带来生机”希伯来文是“使人像棵生命树”。","reference":{"chapter":13,"verse":12}}]},"thisChapterLink":"/api/cmn_cbs/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}