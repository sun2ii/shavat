{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"智慧的女子建立家室，","poem":1},{"text":"愚昧的女子亲手拆毁。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"行为正直的人敬畏耶和华，","poem":1},{"text":"行事邪僻的人轻视耶和华。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"愚人的狂言招来鞭打，","poem":1},{"text":"智者的唇舌保护自己。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"没有耕牛槽头净，","poem":1},{"text":"五谷丰登需壮牛。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"忠实的证人不会撒谎，","poem":1},{"text":"虚假的证人谎话连篇。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"嘲讽者徒然寻智慧，","poem":1},{"text":"明哲轻易得知识。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"你要远离愚昧人，","poem":1},{"text":"他口中毫无知识。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"明哲凭智慧辨道，","poem":1},{"text":"愚人被愚昧欺骗。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"愚妄人戏看罪恶，","poem":1},{"text":"正直人彼此恩待。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"心头的愁苦，唯有自己明白；","poem":1},{"text":"心中的喜乐，外人无法分享。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"恶人的房屋必遭毁灭，","poem":1},{"text":"正直人的帐篷必兴盛。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"有一条路看似正确，","poem":1},{"text":"最终却通向死亡。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"欢笑难消内心的痛苦，","poem":1},{"text":"欢乐过后，悲伤犹在。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"背弃正道，自食恶果；","poem":1},{"text":"善人行善，必得善报。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"愚人什么都信，","poem":1},{"text":"明哲步步谨慎。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"智者小心谨慎，远离恶事；","poem":1},{"text":"愚人骄傲自负，行事鲁莽。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"急躁易怒的人做事愚昧，","poem":1},{"text":"阴险奸诈之人遭人痛恨。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"愚人得愚昧作产业，","poem":1},{"text":"明哲得知识为冠冕。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"坏人俯伏在善人面前，","poem":1},{"text":"恶人俯伏在义人门口。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"穷人遭邻舍厌，","poem":1},{"text":"富人朋友众多。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"藐视邻舍是罪过，","poem":1},{"text":"怜悯穷人蒙福乐。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"图谋恶事的步入歧途，","poem":1},{"text":"行善的得慈爱与忠诚。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"殷勤工作，带来益处；","poem":1},{"text":"满嘴空谈，导致贫穷。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"智者以财富为冠冕，","poem":1},{"text":"愚人以愚昧为装饰。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"诚实的证人挽救性命，","poem":1},{"text":"口吐谎言者欺骗他人。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"敬畏耶和华的信心坚定，","poem":1},{"text":"他的子孙也有庇护所。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"敬畏耶和华是生命之泉，","poem":1},{"text":"可使人避开死亡的陷阱。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"人口众多，是君王的荣耀；","poem":1},{"text":"没有臣民，君主必然败亡。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"不轻易发怒者深明事理，","poem":1},{"text":"鲁莽急躁的人显出愚昧。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"心平气和，滋润生命；","poem":1},{"text":"妒火中烧，啃蚀骨头。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"欺压穷人等于侮辱造物主，","poem":1},{"text":"怜悯贫弱就是尊敬造物主。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"恶人因恶行而灭亡，","poem":1},{"text":"义人到死仍有倚靠。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"智慧存在哲士心里，","poem":1},{"text":"愚人心中充满无知。","poem":2}]},{"type":"verse","number":34,"content":[{"text":"公义能叫邦国兴盛，","poem":1},{"text":"罪恶是人民的耻辱。","poem":2}]},{"type":"verse","number":35,"content":[{"text":"明智的臣子蒙王喜悦，","poem":1},{"text":"可耻的仆人惹王发怒。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}