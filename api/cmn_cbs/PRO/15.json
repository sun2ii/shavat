{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"温和的回答平息怒气，","poem":1},{"text":"粗暴的言词激起愤怒。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"智者的舌头传扬知识，","poem":1},{"text":"愚人的嘴巴吐露愚昧。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"耶和华的眼目无所不在，","poem":1},{"text":"无论善人恶人，祂都鉴察。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"温和的言词是生命树，","poem":1},{"text":"乖谬的话语伤透人心。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"愚人蔑视父亲的管教，","poem":1},{"text":"接受责备的才算明智。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"义人家中财富充足，","poem":1},{"text":"恶人得利惹来祸患。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"智者的嘴传扬知识，","poem":1},{"text":"愚人的心并非如此。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"耶和华憎恨恶人的祭物，","poem":1},{"text":"悦纳正直人的祈祷。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"耶和华憎恨恶人的行径，","poem":1},{"text":"喜爱追求公义的人。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"背离正道，必遭严惩；","poem":1},{"text":"厌恶责备，必致死亡。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"阴间和死地在耶和华面前尚且无法隐藏，","poem":1},{"text":"何况世人的心思呢！","poem":2}]},{"type":"verse","number":12,"content":[{"text":"嘲讽者不爱听责备，","poem":1},{"text":"也不愿请教智者。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"心中喜乐，容光焕发；","poem":1},{"text":"心里悲伤，精神颓丧。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"哲士的心追求知识，","poem":1},{"text":"愚人的口吞吃愚昧。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"困苦人天天受煎熬，","poem":1},{"text":"乐观者常常有喜乐。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"财物虽少但敬畏耶和华，","poem":1},{"text":"胜过家财万贯却充满烦恼。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"粗茶淡饭但彼此相爱，","poem":1},{"text":"胜过美酒佳肴却互相憎恨。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"脾气暴躁，惹起争端；","poem":1},{"text":"忍耐克制，平息纠纷。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"懒惰人的路布满荆棘，","poem":1},{"text":"正直人的道平坦宽阔。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"智慧之子使父亲欢喜，","poem":1},{"text":"愚昧之人却藐视母亲。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"无知者以愚昧为乐，","poem":1},{"text":"明哲之士遵循正道。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"缺乏商讨，计划失败；","poem":1},{"text":"集思广益，事无不成。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"应对得体，心中愉快；","poem":1},{"text":"言语合宜，何等美好！","poem":2}]},{"type":"verse","number":24,"content":[{"text":"智者循生命之路上升，","poem":1},{"text":"以免坠入阴间。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"耶和华拆毁傲慢人的房屋，","poem":1},{"text":"祂使寡妇的地界完整无损。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"耶和华憎恨恶念，","poem":1},{"text":"恩言乃是纯洁的。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"贪不义财，自害己家；","poem":1},{"text":"厌恶贿赂，安然存活。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"义人三思而后答，","poem":1},{"text":"恶人张口吐恶言。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"耶和华远离恶人，","poem":1},{"text":"却听义人的祷告。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"眼神发光令人心喜，","poem":1},{"text":"喜讯出来滋润骨头。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"倾听生命的训诫，","poem":1},{"text":"使人与智者同列。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"不受管教就是轻看自己，","poem":1},{"text":"听从责备才能得到智慧。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"敬畏耶和华乃是智训，","poem":1},{"text":"学会谦卑才能得尊荣。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}