{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"心中的策划在于人，","poem":1},{"text":"应对之言来自耶和华。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"人看自己的行为都纯全，","poem":1},{"text":"但是耶和华却衡量人心。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"把你的事交托耶和华，","poem":1},{"text":"你的计划必实现。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"耶和华所造的万物各有其用，","poem":1},{"text":"连恶人也是为灾难之日所造。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"耶和华厌恶心骄气傲者，","poem":1},{"text":"他们必逃不过祂的责罚。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"慈爱和忠信可让罪恶得赎，","poem":1},{"text":"敬畏耶和华使人远离罪恶。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"人所行的若蒙耶和华喜悦，","poem":1},{"text":"耶和华必使仇敌与他和好。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"收入微薄但行事公义，","poem":1},{"text":"胜过获利丰厚却不正当。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"人心中筹划自己的道路，","poem":1},{"text":"但耶和华决定他的脚步。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"王口中有上帝的话，","poem":1},{"text":"断案时必无差错。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"公道的秤与天平属于耶和华，","poem":1},{"text":"袋中一切的砝码由祂制定。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"君王憎恨恶行，","poem":1},{"text":"因王位靠公义而立。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"王喜爱公义的言词，","poem":1},{"text":"器重说话正直的人。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"王的烈怒是死亡使者，","poem":1},{"text":"然而智者能平息王怒。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"王的笑容带给人生命，","poem":1},{"text":"他的恩惠像春雨之云。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"得智慧胜过得黄金，","poem":1},{"text":"获悟性胜过获白银。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"正直人的大道远离罪恶，","poem":1},{"text":"坚守正道的保全性命。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"骄横是沦亡的前奏，","poem":1},{"text":"狂傲是败落的预兆。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"宁可谦卑地与贫寒人相处，","poem":1},{"text":"也不跟狂傲人共享战利品。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"听从训言的人受益匪浅，","poem":1},{"text":"信靠耶和华的人蒙祝福。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"智者以明辨著称，","poem":1},{"text":"甜言增加说服力。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"智慧是智者的生命泉，","poem":1},{"text":"愚昧为愚人带来惩罚。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"智者三思而后言，","poem":1},{"text":"其言更有说服力。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"良言如蜜，","poem":1},{"text":"使人心灵甘甜、身体康健。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"有一条路看似正确，","poem":1},{"text":"最终却通向死亡。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"工人的胃口促他工作，","poem":1},{"text":"口腹之需是他的动力。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"不务正业的人图谋恶事，","poem":1},{"text":"他的口舌如烈焰般危险。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"邪僻的人散播纷争，","poem":1},{"text":"造谣的人破坏友情。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"残暴之徒引诱邻舍走入歧途。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"恶人眯起眼睛图谋不轨，","poem":1},{"text":"歹徒咬着嘴唇策划恶事。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"白发是荣耀的冠冕，","poem":1},{"text":"行为公义方能得到。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"不轻易发怒者胜过勇士，","poem":1},{"text":"能自我控制胜过攻陷城池。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"人可以摇签求问，","poem":1},{"text":"但耶和华决定一切。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}