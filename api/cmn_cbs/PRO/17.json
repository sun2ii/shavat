{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"粗茶淡饭但相安无事，","poem":1},{"text":"胜过佳肴满桌却勾心斗角。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"精明的仆人必管辖家主的不肖子，","poem":1},{"text":"并与他们一同承受家业。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"鼎炼银，炉炼金，","poem":1},{"text":"耶和华试炼人心。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"作恶者留心听恶言，","poem":1},{"text":"说谎者侧耳听坏话。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"嘲笑穷人等于侮辱造物主，","poem":1},{"text":"幸灾乐祸的人必难逃惩罚。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"子孙是老人的华冠，","poem":1},{"text":"父母是儿女的荣耀。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"愚人高谈阔论不相宜，","poem":1},{"text":"统治者说谎更不合适。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"行贿者视贿赂为法宝，","poem":1},{"text":"可以使他无往不利。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"饶恕过犯的促进友爱；","poem":1},{"text":"重提旧怨的破坏友情。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"责备哲士一句，","poem":1},{"text":"胜过杖打愚人百下。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"恶人一心反叛，","poem":1},{"text":"残忍的使者必奉命来惩罚他。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"宁愿遇见丢失幼崽的母熊，","poem":1},{"text":"也不愿碰上做蠢事的愚人。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"人若以恶报善，","poem":1},{"text":"家里必祸患不断。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"争端爆发如洪水决堤，","poem":1},{"text":"当在爆发前将其制止。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"放过罪人的和定罪无辜的，","poem":1},{"text":"都为耶和华所憎恶。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"愚人无心求智慧，","poem":1},{"text":"手中有钱有何用？","poem":2}]},{"type":"verse","number":17,"content":[{"text":"朋友时时彼此关爱，","poem":1},{"text":"手足生来患难与共。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"无知的人才会为他人作保。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"喜爱争斗的喜爱犯罪，","poem":1},{"text":"骄傲自大的自招灭亡。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"心术不正，难觅幸福；","poem":1},{"text":"口吐谎言，陷入祸患。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"生愚昧子带来忧伤，","poem":1},{"text":"愚人之父毫无喜乐。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"喜乐的心乃是良药，","poem":1},{"text":"忧伤的灵使骨枯干。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"恶人暗中收受贿赂，","poem":1},{"text":"颠倒是非。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"哲士追求智慧，","poem":1},{"text":"愚人漫无目标。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"愚昧儿令父亲忧虑，","poem":1},{"text":"让母亲苦恼。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"责罚义人不妥，","poem":1},{"text":"杖责君子不义。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"谨言慎行的有知识，","poem":1},{"text":"温和冷静的有悟性。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"愚人缄默可算为智慧，","poem":1},{"text":"闭口不言可算为明智。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}