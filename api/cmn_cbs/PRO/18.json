{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"孤傲者独求己愿，","poem":1},{"text":"他恼恨一切真知。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"愚人不喜欢悟性，","poem":1},{"text":"只喜欢发表意见。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"邪恶与藐视同行，","poem":1},{"text":"无耻与羞辱为伴。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"人口中的话如同深水，","poem":1},{"text":"智慧之泉像涓涓溪流。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"袒护恶人不好，","poem":1},{"text":"冤枉义人不善。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"愚人说话引起纷争，","poem":1},{"text":"他的口招来鞭打。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"愚人的口自招灭亡，","poem":1},{"text":"他的嘴坑害他自己。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"闲言碎语如同美食，","poem":1},{"text":"深入人的五脏六腑。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"懒惰人与毁坏者意气相投。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华的名是坚固保障，","poem":1},{"text":"义人投奔其中就得安稳。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"钱财是富人的坚城，","poem":1},{"text":"在他幻想中是高墙。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"骄傲是败亡的前奏，","poem":1},{"text":"谦卑是尊荣的先锋。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"未听先答的人，","poem":1},{"text":"自显愚昧和羞辱。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"人的心灵能忍受疾病，","poem":1},{"text":"谁能忍受破碎的心灵？","poem":2}]},{"type":"verse","number":15,"content":[{"text":"哲士的心得知识，","poem":1},{"text":"智者的耳求知识。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"礼物为人开路，","poem":1},{"text":"领人晋见权贵。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"先告状的看似有理，","poem":1},{"text":"一经对质真相大白。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"抽签可以平息争端，","poem":1},{"text":"调解强者间的纠纷。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"与结怨的兄弟和解比攻城还难，","poem":1},{"text":"争端难破，如坚城的门闩。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"人因口中所说的话而饱足，","poem":1},{"text":"因嘴中所出的言语而满足。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"口舌能够定生死，","poem":1},{"text":"多嘴多言食恶果。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"得到妻子就是得到珍宝，","poem":1},{"text":"也是蒙了耶和华的恩惠。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"穷人哀声恳求，","poem":1},{"text":"富人恶言相向。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"滥交友，自招损；","poem":1},{"text":"得知己，胜手足。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}