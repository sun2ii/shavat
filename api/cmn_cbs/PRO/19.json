{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"行为正直的穷人，","poem":1},{"text":"胜过言语诡诈的愚人。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"热诚却无知不足取，","poem":1},{"text":"行动急躁难免有错。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"人因愚昧而自毁前程，","poem":1},{"text":"他的心却抱怨耶和华。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"财富招来许多朋友，","poem":1},{"text":"穷人却遭朋友抛弃。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"作伪证者难免受罚，","poem":1},{"text":"撒谎的人罪责难逃。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"大家都讨好慷慨的人，","poem":1},{"text":"人人都结交好施赠的。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"穷人被亲人厌弃，","poem":1},{"text":"朋友都远远躲避。","poem":2},{"lineBreak":true},{"text":"他苦苦哀求，也无人理会。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"得到智慧的珍惜生命，","poem":1},{"text":"持守悟性的找到福乐。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"作伪证者难免受罚，","poem":1},{"text":"撒谎的人自取灭亡。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"愚人奢华宴乐不相宜，","poem":1},{"text":"奴隶管辖王子更离谱。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"智者不轻易发怒，","poem":1},{"text":"饶恕过犯是他的荣耀。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"君王的震怒像雄狮怒吼，","poem":1},{"text":"君王的恩泽如草上甘露。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"愚昧之子是父亲的灾殃，","poem":1},{"text":"争闹之妻如雨滴漏不止。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"房屋钱财是祖先的遗产，","poem":1},{"text":"贤慧之妻乃耶和华所赐。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"懒惰使人沉睡，","poem":1},{"text":"懈怠使人挨饿。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"遵守诫命的保全性命，","poem":1},{"text":"藐视正道的自寻死路。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"善待穷人等于借贷给耶和华，","poem":1},{"text":"耶和华必回报他的善行。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"管教孩子宜早不宜晚，","poem":1},{"text":"不可任由他走向灭亡。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"脾气暴躁的人必吃苦头。","poem":1},{"text":"你若救他，一次肯定不够。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"你要受教听劝，","poem":1},{"text":"终必得到智慧。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"人心中有许多计划，","poem":1},{"text":"唯耶和华的旨意成就。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"人心爱慕忠诚，","poem":1},{"text":"受穷胜过撒谎。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"敬畏耶和华使人得享生命，","poem":1},{"text":"安然满足，免遭祸患。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"懒惰人手放在餐盘，","poem":1},{"text":"却懒得送食物进嘴。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"责打嘲讽者，愚人学会谨慎；","poem":1},{"text":"责备明哲，他会增长见识。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"苛待父亲的人可鄙，","poem":1},{"text":"逼走母亲的人可耻。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"孩子啊，你若不听教诲，","poem":1},{"text":"就会偏离知识。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"作伪证者嘲讽公义，","poem":1},{"text":"恶人的口吞吃罪恶。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"刑罚用来对付嘲讽者，","poem":1},{"text":"鞭子用来责打愚人背。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}