{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":2,"content":[{"type":"heading","content":["智慧的益处"]},{"type":"verse","number":1,"content":[{"text":"孩子啊，","poem":1},{"text":"你若接受我的教诲，","poem":2},{"lineBreak":true},{"text":"珍爱我的诫命，","poem":2}]},{"type":"verse","number":2,"content":[{"text":"侧耳聆听智慧，","poem":1},{"text":"倾心渴慕悟性；","poem":2}]},{"type":"verse","number":3,"content":[{"text":"你若呼求洞见，","poem":1},{"text":"高声寻求悟性，","poem":2}]},{"type":"verse","number":4,"content":[{"text":"寻它如寻银子，","poem":1},{"text":"找它如找宝藏，","poem":2}]},{"type":"verse","number":5,"content":[{"text":"你就会懂得敬畏耶和华，","poem":1},{"text":"能够认识上帝。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"因为耶和华赐人智慧，","poem":1},{"text":"知识和悟性出自祂的口。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"祂使正直人充满智慧，","poem":1},{"text":"是行为纯全者的盾牌。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"祂看守正义之路，","poem":1},{"text":"护卫虔诚人的道。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"这样，你就明白何为仁义、","poem":1},{"text":"公平、正直，","poem":2},{"lineBreak":true},{"text":"及一切美善之道。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"因为智慧必进入你心，","poem":1},{"text":"知识必令你的灵欢乐。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"明辨力必护佑你，","poem":1},{"text":"悟性必看顾你。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"智慧必救你远离恶道，","poem":1},{"text":"脱离言语荒谬的人。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"他们舍弃正道，走上黑路，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"以行恶为乐，喜爱恶人的邪僻；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他们的道路歪邪，行径扭曲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"智慧要救你脱离淫妇，","poem":1},{"text":"脱离花言巧语的妓女。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"她撇弃了年轻时的丈夫，","poem":1},{"text":"忘了在上帝面前立的约。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"她的家通向死亡，","poem":1},{"text":"她的路直达阴间。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"到她那里的人都有去无回，","poem":1},{"text":"找不到生命之道。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"所以你要行善人的路，","poem":1},{"text":"守义人的道。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"因为在地上，","poem":1},{"text":"正直人必安居，","poem":2},{"lineBreak":true},{"text":"纯全无过的人必长存，","poem":2}]},{"type":"verse","number":22,"content":[{"text":"地上的恶人必被铲除，","poem":1},{"text":"世上的奸徒必被根除。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}