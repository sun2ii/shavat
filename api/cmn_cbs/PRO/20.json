{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"酒使人放肆，烈酒叫人吵闹。","poem":1},{"text":"因酒误事，实为不智。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"君王震怒如狮子咆哮，","poem":1},{"text":"触怒他的人自寻死路。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"避免纷争是光荣，","poem":1},{"text":"愚人个个爱争吵。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"懒惰人不按时耕种，","poem":1},{"text":"收获时必一无所得。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"人心的谋略如深水，","poem":1},{"text":"唯有哲士才能汲取。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"人都声称自己忠诚，","poem":1},{"text":"但谁能找到忠信者？","poem":2}]},{"type":"verse","number":7,"content":[{"text":"义人行为正直，","poem":1},{"text":"他的后代也蒙福。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"王坐在宝座上审判，","poem":1},{"text":"他的眼目明察罪恶。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"谁敢说：“我心灵洁净，纯洁无罪？”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"缺斤少两、尺寸不足，","poem":1},{"text":"都为耶和华所憎恶。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"孩童的举动是否纯良，","poem":1},{"text":"显明他的本性。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"能听的耳，能看的眼，","poem":1},{"text":"两者都为耶和华所造。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"不要贪睡，免得贫穷；","poem":1},{"text":"勤劳工作，粮食丰足。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"买主总说货物不好，","poem":1},{"text":"买走后又连连自夸。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"世间有黄金和许多宝石，","poem":1},{"text":"唯有博学之言才是珍宝。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"谁为陌生人作保，就拿去谁的外衣；","poem":1},{"text":"谁为外族人作保，谁就要承担责任。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"骗来的饼觉得香甜，","poem":1},{"text":"最后却是满口泥沙。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"集思出良策，","poem":1},{"text":"征战靠智谋。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"嚼舌的人泄露秘密，","poem":1},{"text":"不可结交多嘴的人。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"咒骂父母的人，","poem":1},{"text":"他的生命","poem":2},{"noteId":7},{"text":"必消逝在黑暗中。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"起初轻易得来之财，","poem":1},{"text":"最终不会成为祝福。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"不要说：“我要以恶报恶”，","poem":1},{"text":"要等候耶和华，祂必替你申冤。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"耶和华憎恶缺斤少两，","poem":1},{"text":"祂厌恶骗人的天平。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"人的脚步由耶和华所定，","poem":1},{"text":"人怎能知道自己的道路？","poem":2}]},{"type":"verse","number":25,"content":[{"text":"人向主许愿要三思，","poem":1},{"text":"免得事后作茧自缚。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"明君必筛出恶人，","poem":1},{"text":"用石磙碾轧他们。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"人的灵是耶和华的灯，","poem":1},{"text":"鉴察人的肺腑心肠。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"君王靠慈爱和忠信护佑，","poem":1},{"text":"他的王位因慈爱而稳固。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"力量是青年的荣耀，","poem":1},{"text":"白发是老人的尊荣。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"鞭伤能驱除罪恶，","poem":1},{"text":"责打能洁净人心。","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":7,"caller":"+","text":"“生命”希伯来文是“灯”。","reference":{"chapter":20,"verse":20}}]},"thisChapterLink":"/api/cmn_cbs/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}