{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"耶和华掌管君王的心，","poem":1},{"text":"易如支配垄沟的流水。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"人自以为行事正确，","poem":1},{"text":"但耶和华衡量人心。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"秉公行义比献祭更蒙耶和华喜悦。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"高傲的眼，狂妄的心，恶人的灯，","poem":1},{"text":"都是罪恶。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"勤劳者的计划必致富足，","poem":1},{"text":"行事急躁的人必致贫困。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"骗来的财如过眼云雾，","poem":1},{"text":"使人掉进死亡的陷阱。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"恶人的暴力必毁灭自己，","poem":1},{"text":"因为他们行事不公不义。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"犯罪的人行径扭曲，","poem":1},{"text":"纯洁的人行为正直。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"宁愿住在屋顶的一角，","poem":1},{"text":"也不跟争闹之妻同屋。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"恶人贪恋邪恶，","poem":1},{"text":"对邻舍残忍无情。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"惩罚嘲讽者，愚人得智慧；","poem":1},{"text":"训导智者，他便长见识。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"公义的上帝鉴察恶人的家，","poem":1},{"text":"并使他们覆灭。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"掩耳不听穷人呼求的，","poem":1},{"text":"将来求救必无人回应。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"暗中送的礼物能平息愤怒，","poem":1},{"text":"塞进怀里的贿赂止息盛怒。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"正义得到伸张，","poem":1},{"text":"义人喜，恶人怕。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"人偏离明智之道，","poem":1},{"text":"终必与阴魂为伍。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"贪图享受必穷困，","poem":1},{"text":"奢华宴乐难富足。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"恶人作义人的赎价，","poem":1},{"text":"奸徒替正直人受罚。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"宁愿独居旷野，","poem":1},{"text":"不跟吵闹易怒的女子同住。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"智者家中积存宝物和油，","poem":1},{"text":"愚人将所有的挥霍一空。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"追求公义与慈爱的，","poem":1},{"text":"必寻得生命、公义和尊荣。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"智者攀上勇士的城池，","poem":1},{"text":"摧毁他们倚仗的坚垒。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"管住口舌，免遭祸患。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"嘲讽者狂妄自大，","poem":1},{"text":"行事骄横无比。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"懒人的欲望害死自己，","poem":1},{"text":"因为他的手不肯做工。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"懒人整天贪得无厌，","poem":1},{"text":"义人施舍毫不吝啬。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"恶人的祭物已经可憎，","poem":1},{"text":"何况他怀着恶意来献！","poem":2}]},{"type":"verse","number":28,"content":[{"text":"作伪证的终灭亡，","poem":1},{"text":"聆听者的证词有效。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"恶人虚张声势，","poem":1},{"text":"正直人谨慎行事。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"任何智慧、悟性和谋略，","poem":1},{"text":"都不能对抗耶和华。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"马为争战之日预备，","poem":1},{"text":"胜败由耶和华决定。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}