{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"美名胜过巨富，","poem":1},{"text":"恩宠好过金银。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"富人和穷人同世而立，","poem":1},{"text":"二者皆由耶和华所造。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"明哲遇祸躲避，","poem":1},{"text":"愚人前去受害。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"心存谦卑、敬畏耶和华，","poem":1},{"text":"必得财富、尊荣和生命。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"奸徒之道有荆棘和陷阱，","poem":1},{"text":"想保全生命的必须远避。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"教导孩童走正路，","poem":1},{"text":"他到老也不偏离。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"富人管辖穷人，","poem":1},{"text":"欠债的是债主的仆人。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"播种不义的必收灾祸，","poem":1},{"text":"他暴怒的杖必被折断。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"慷慨的人必蒙福，","poem":1},{"text":"因他给穷人食物。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"赶走嘲讽者，纷争平息，","poem":1},{"text":"争吵和羞辱也会消除。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"喜爱清心、口吐恩言的人，","poem":1},{"text":"必与君王为友。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"耶和华的眼目护卫知识，","poem":1},{"text":"祂必推翻奸徒的言论。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"懒惰人说：“外面有狮子，","poem":1},{"text":"我会命丧街头。”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"淫妇的口是深坑，","poem":1},{"text":"耶和华憎恶的人必陷进去。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"愚昧缠住孩童的心，","poem":1},{"text":"教棍能远远赶走它。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"靠压榨穷人敛财和送礼给富人的，","poem":1},{"text":"都必穷困潦倒。","poem":2}]},{"type":"heading","content":["智者之言"]},{"type":"verse","number":17,"content":[{"text":"你要侧耳听智者之言，","poem":1},{"text":"专心领受我的教诲，","poem":2}]},{"type":"verse","number":18,"content":[{"text":"铭记在心、随时诵咏，","poem":1},{"text":"方为美事。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"今天我将这些指示你，","poem":1},{"text":"为要使你倚靠耶和华。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"关于谋略和知识，","poem":1},{"text":"我已写给你三十条，","poem":2}]},{"type":"verse","number":21,"content":[{"text":"要使你认识真理，","poem":1},{"text":"好如实答复差你来的人。","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"不可仗势剥削贫穷人，","poem":1},{"text":"法庭上不可欺凌困苦者，","poem":2}]},{"type":"verse","number":23,"content":[{"text":"因为耶和华必为他们申冤，","poem":1},{"text":"夺去掠夺他们之人的性命。","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"不可结交脾气暴躁者，","poem":1},{"text":"不要跟易怒之人来往，","poem":2}]},{"type":"verse","number":25,"content":[{"text":"免得你沾染他们的恶习，","poem":1},{"text":"不能自拔。","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"不要为人击掌作保，","poem":1},{"text":"不要为欠债的抵押。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"如果你还不起，","poem":1},{"text":"连你的床也会被抬走。","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"不可移动祖先定下的界石。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你看那精明能干的人，","poem":1},{"text":"他必侍立在君王面前，","poem":2},{"lineBreak":true},{"text":"不会效力于泛泛之辈。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}