{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"你若与官长同席，","poem":1},{"text":"要注意面对的是谁。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"如果你是贪吃的人，","poem":1},{"text":"就要节制食欲","poem":2},{"noteId":8},{"text":"；","poem":2}]},{"type":"verse","number":3,"content":[{"text":"不可贪恋他的美食，","poem":1},{"text":"这美食是圈套。","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"别为钱财耗尽心力，","poem":1},{"text":"要明智，适可而止。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"钱财眨眼之间消逝无踪，","poem":1},{"text":"它必长出翅膀如鹰飞去。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"不要吃吝啬人的饭，","poem":1},{"text":"不可贪图他的美味。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"因为他总是精于算计，","poem":1},{"text":"嘴上说“请吃，请喝”，","poem":2},{"lineBreak":true},{"text":"心里却另有盘算。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"你必呕出所吃的那点饭，","poem":1},{"text":"你说的美言都必枉费。","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"不要和愚人说话，","poem":1},{"text":"他必藐视你的智言。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"不可挪移古时的界石，","poem":1},{"text":"不可侵占孤儿的田地。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"因他们的救赎主强大，","poem":1},{"text":"祂必对付你，替他们申冤。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"你要专心接受教诲，","poem":1},{"text":"侧耳倾听博学之言。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"不要疏于管教孩子，","poem":1},{"text":"杖责不会使他毙命，","poem":2}]},{"type":"verse","number":14,"content":[{"text":"杖责能救他脱离死亡。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"孩子啊，","poem":1},{"text":"你若心里有智慧，","poem":2},{"lineBreak":true},{"text":"我心里也会欢喜。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"你的口若说正直的话，","poem":1},{"text":"我的内心也欢畅不已。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"不要心里羡慕罪人，","poem":1},{"text":"要终日敬畏耶和华。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"这样，你必前途光明，","poem":1},{"text":"你的盼望不会幻灭。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"孩子啊，听我的话，","poem":1},{"text":"要有智慧，心守正道。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"不要结交酒肉朋友，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"因为好酒贪吃者必穷困，","poem":1},{"text":"贪睡的人必穿破衣烂衫。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"要听从生养你的父亲，","poem":1},{"text":"不可轻视年老的母亲。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"要买真理，不可卖掉，","poem":1},{"text":"要买智慧、教诲和悟性。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"义人的父亲喜乐无限，","poem":1},{"text":"智慧之子使父母欢欣。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"愿你使父母快乐，","poem":1},{"text":"叫生你的人欢欣。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"孩子啊，把你的心交给我，","poem":1},{"text":"双目要紧盯我的道路。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"妓女是深坑，淫妇是陷阱；","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"她像强盗般埋伏，","poem":1},{"text":"使世间增添奸徒。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"谁有灾祸？谁有忧伤？","poem":1},{"text":"谁有争吵？谁有怨言？","poem":2},{"lineBreak":true},{"text":"谁无故受伤？谁两眼发红？","poem":2}]},{"type":"verse","number":30,"content":[{"text":"就是那些沉迷醉乡，","poem":1},{"text":"品尝调和酒的人！","poem":2}]},{"type":"verse","number":31,"content":[{"text":"虽然鲜红的酒在杯中闪烁，","poem":1},{"text":"喝下去痛快，但不要注视。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"它终必像蛇一样伤你，","poem":1},{"text":"像毒蛇一样咬你。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"你的眼会看见怪异的景象，","poem":1},{"text":"你会神智不清，胡言乱语。","poem":2}]},{"type":"verse","number":34,"content":[{"text":"你好像躺在怒海中，","poem":1},{"text":"又像卧在桅杆顶上。","poem":2}]},{"type":"verse","number":35,"content":[{"text":"你会说：“人打我，我不痛；","poem":1},{"text":"人揍我，我不知。","poem":2},{"lineBreak":true},{"text":"什么时候醒了，再干一杯！”","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"“节制食欲”希伯来文是“把刀放在喉咙上”。","reference":{"chapter":23,"verse":2}}]},"thisChapterLink":"/api/cmn_cbs/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}