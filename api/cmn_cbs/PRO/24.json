{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"不要羡慕恶人，","poem":1},{"text":"不要渴望与他们为伍；","poem":2}]},{"type":"verse","number":2,"content":[{"text":"因为他们心里图谋暴行，","poem":1},{"text":"口中谈论恶事。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"家靠智慧而建立，","poem":1},{"text":"靠悟性而稳固，","poem":2}]},{"type":"verse","number":4,"content":[{"text":"借知识而充满各种珍宝。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"智者充满能力，","poem":1},{"text":"哲士力上加力。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"出征打仗，要凭智谋；","poem":1},{"text":"谋士众多，才有胜算。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"智慧对愚人高不可及，","poem":1},{"text":"他在城门口沉默不语。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"图谋作恶的必被称为阴谋家。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愚人的计谋是罪恶，","poem":1},{"text":"人人都厌恶嘲讽者。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"逆境中丧胆的必力量衰微。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"被拉去屠杀的，你要抢救；","poem":1},{"text":"行将被宰杀的，你要拦阻。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"你若推说自己毫不知情，","poem":1},{"text":"鉴察人心的主岂不洞察？","poem":2},{"lineBreak":true},{"text":"保守你生命的岂不知情？","poem":2},{"lineBreak":true},{"text":"祂必按你的行为报应你。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"孩子啊，你要吃蜜，因蜜美好，","poem":1},{"text":"蜂房滴下的蜜甘甜可口。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"智慧同样使你的心灵甘甜；","poem":1},{"text":"你若找到智慧，前途必光明，","poem":2},{"lineBreak":true},{"text":"盼望也不会幻灭。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"不要像恶人一样暗算义人家，","poem":1},{"text":"不要破坏他的居所。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"因为义人跌倒七次仍会起来，","poem":1},{"text":"恶人却被灾祸击垮。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"仇敌跌倒，不要幸灾乐祸；","poem":1},{"text":"仇敌败落，不要心里欢喜。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"否则，耶和华看见会不悦，","poem":1},{"text":"不再向仇敌发烈怒。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"不要因恶人而愤愤不平，","poem":1},{"text":"也不要羡慕邪恶之徒；","poem":2}]},{"type":"verse","number":20,"content":[{"text":"因为恶人毫无前途，","poem":1},{"text":"恶人的灯终必熄灭。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"孩子啊，要敬畏耶和华和君王，","poem":1},{"text":"不要跟叛逆之徒为伍。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"因为灾祸必骤然临到他们，","poem":1},{"text":"谁知道耶和华和君王如何毁灭他们？","poem":2}]},{"type":"heading","content":["其他智言"]},{"type":"verse","number":23,"content":[{"text":"以下也是智者的箴言：","poem":1},{"text":"判案时偏袒实为不善。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"判恶人无罪的，","poem":1},{"text":"必遭万民咒诅，","poem":2},{"lineBreak":true},{"text":"为列国痛恨。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"责备恶人的必有欢乐，","poem":1},{"text":"美好的福气必临到他。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"诚实的回答如同友好的亲吻。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"要安排好外面的事，","poem":1},{"text":"把田间的工作准备妥当，","poem":2},{"lineBreak":true},{"text":"然后建造房屋。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"别无故作证害邻舍，","poem":1},{"text":"也不可撒谎欺骗人。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"不可说：“别人怎样待我，","poem":1},{"text":"我就怎样待他；","poem":2},{"lineBreak":true},{"text":"我要照他所做的报复他。”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"我走过懒惰人的田地和无知者的葡萄园，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"那里荆棘遍地，","poem":1},{"text":"刺草丛生，","poem":2},{"lineBreak":true},{"text":"石墙倒塌。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"我仔细思想所见之事，","poem":1},{"text":"领悟到一个教训：","poem":2}]},{"type":"verse","number":33,"content":[{"text":"再睡一会儿，","poem":1},{"text":"再打个盹儿，","poem":2},{"lineBreak":true},{"text":"再抱着手躺一会儿，","poem":2}]},{"type":"verse","number":34,"content":[{"text":"贫穷必像盗贼一样临到你，","poem":1},{"text":"缺乏必像武士一样扑向你。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}