{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":25,"content":[{"type":"heading","content":["所罗门的箴言（续）"]},{"type":"verse","number":1,"content":["以下也是所罗门的箴言，由犹大王希西迦的人抄录。"]},{"type":"verse","number":2,"content":[{"text":"将事隐藏是上帝的荣耀，","poem":1},{"text":"把事查明是君王的光荣。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"天之高，地之厚，","poem":1},{"text":"君王的心测不透。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"除掉银子里的渣滓，","poem":1},{"text":"银匠就能铸造器皿。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"清除君王身边的恶人，","poem":1},{"text":"王位必因公义而巩固。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"不可在王面前妄自尊大，","poem":1},{"text":"不要占据大人物的位子。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"与其在权贵面前被贬低，","poem":1},{"text":"不如等人邀请你坐上座。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"不可贸然打官司，","poem":1},{"text":"以免被邻舍羞辱，","poem":2},{"lineBreak":true},{"text":"无所适从。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"遇到跟邻舍对簿公堂，","poem":1},{"text":"不可泄露他人的秘密，","poem":2}]},{"type":"verse","number":10,"content":[{"text":"免得听见的人辱骂你，","poem":1},{"text":"你的恶名将永难洗刷。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"一句话说得合宜，","poem":1},{"text":"就像金苹果放在银器里。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"对受教者而言，","poem":1},{"text":"智者的责备犹如金耳环和金饰物。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"忠信的使者叫主人心里舒畅，","poem":1},{"text":"就像夏收之时有冰雪的凉气。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"夸口送礼物却食言的人，","poem":1},{"text":"就像没有雨水的风和云。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"坚忍的耐心说服君王，","poem":1},{"text":"柔和的舌头折断骨头。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"找到蜂蜜要酌量而食，","poem":1},{"text":"免得吃多了呕吐。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"不要频频去邻舍家，","poem":1},{"text":"免得惹人烦、遭人厌。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"作伪证陷害邻舍的人，","poem":1},{"text":"无异于大锤、快刀和利箭。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"危难时投靠奸诈之人，","poem":1},{"text":"形同倚靠坏牙和跛脚。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"对忧伤的人唱歌，","poem":1},{"text":"如同天寒脱衣、伤口撒盐。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"你的仇敌若饿了，","poem":1},{"text":"就给他吃的；","poem":2},{"lineBreak":true},{"text":"若渴了，就给他水喝；","poem":2}]},{"type":"verse","number":22,"content":[{"text":"因为你这是把炭火堆在他头上，","poem":1},{"text":"耶和华必奖赏你。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"北风带来雨水，","poem":1},{"text":"谗言激起愤怒。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"宁愿住在屋顶的一角，","poem":1},{"text":"也不跟争闹之妻同屋。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"有好消息从远方传来，","poem":1},{"text":"如凉水滋润干渴的人。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"义人向恶人低头，","poem":1},{"text":"就像清泉被搅浑，","poem":2},{"lineBreak":true},{"text":"水井受污染。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"蜂蜜吃得太多有害无益，","poem":1},{"text":"追求自己的荣耀也不光彩。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"无法自制的人就像墙垣被毁之城。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}