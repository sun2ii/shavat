{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"愚人得尊荣本不合宜，","poem":1},{"text":"如夏天降雪、收割时下雨。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"麻雀翻飞，燕子翱翔，","poem":1},{"text":"咒诅不会无端降临。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"鞭子打马，缰绳勒驴，","poem":1},{"text":"棍棒责打愚人的背。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"别照愚人的愚昧回答他，","poem":1},{"text":"免得你像他一样。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"要照愚人的愚昧回答他，","poem":1},{"text":"免得他自以为有智慧。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"靠愚人传信，","poem":1},{"text":"如同砍断自己的脚，","poem":2},{"lineBreak":true},{"text":"自讨苦吃。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"愚人口中说箴言，","poem":1},{"text":"如同跛子空有腿。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"把尊荣给愚人，","poem":1},{"text":"就像把石子绑在甩石器上。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"愚人口中说箴言，","poem":1},{"text":"如醉汉手握荆棘。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"雇用愚人或路人，","poem":1},{"text":"如同弓箭手乱箭伤人。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"愚人一再重复愚昧事，","poem":1},{"text":"就像狗转身吃自己所吐的。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"自以为有智慧的人，","poem":1},{"text":"还不如愚人有希望。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"懒惰人说：“路上有狮子，","poem":1},{"text":"街上有猛狮。”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"懒惰人赖在床上滚来滚去，","poem":1},{"text":"就像门在门轴上转来转去。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"懒惰人手放在餐盘，","poem":1},{"text":"却懒得送食物进嘴。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"懒惰人自以为比七个善于应对的人更有智慧。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"插手他人的纠纷，","poem":1},{"text":"犹如揪狗的耳朵。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"欺骗邻舍还说是开玩笑，","poem":1},{"text":"如同疯子乱抛火把、乱射利箭。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"没有木柴，火自然熄灭；","poem":1},{"text":"没有闲话，争端便平息。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"好斗之人煽动争端，","poem":1},{"text":"如同余火加炭、火上加柴。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"闲言碎语如同美食，","poem":1},{"text":"深入人的五脏六腑。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"火热的嘴，邪恶的心，","poem":1},{"text":"犹如瓦器镀了层银。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"怨恨人的用美言掩饰自己，","poem":1},{"text":"心中却藏着诡诈。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"纵然他甜言蜜语，你也不可信他，","poem":1},{"text":"因为他心中充满各种可憎之事。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"虽然他用诡计掩饰怨恨，","poem":1},{"text":"他的邪恶必被会众揭穿。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"挖陷阱的，必自陷其中；","poem":1},{"text":"滚石头的，必自伤己身。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"撒谎的舌恨它所害的人，","poem":1},{"text":"谄媚的嘴带来毁灭。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":27}