{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"不要为明天夸口，","poem":1},{"text":"因为你不知一天会怎样。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"让别人夸奖你，不要开口自夸；","poem":1},{"text":"让外人称赞你，不要自吹自擂。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"石头沉，沙土重，","poem":1},{"text":"不如愚人惹的麻烦重。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"暴怒固然残酷，","poem":1},{"text":"愤恨好比狂澜，","poem":2},{"lineBreak":true},{"text":"然而嫉妒更是无人能敌。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"开诚布公的责备胜过隐藏的爱。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"朋友加的创伤出自真诚，","poem":1},{"text":"仇敌连连亲吻却是多余。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"饱足的人连蜂蜜也嫌弃，","poem":1},{"text":"饥饿的人吃苦食也甘甜。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"离乡背井的人就像离巢的飞鸟。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"膏油和香料使人畅快，","poem":1},{"text":"朋友的忠告令人甘甜。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"不可抛弃你的朋友和父亲的至交。","poem":1},{"text":"患难时别投靠兄弟，","poem":2},{"lineBreak":true},{"text":"近邻胜过远亲。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"孩子啊，你要做智者，","poem":1},{"text":"使我的心喜乐，","poem":2},{"lineBreak":true},{"text":"我好回答讥笑我的人。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"明哲遇祸躲避，","poem":1},{"text":"愚人前去受害。","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"谁为陌生人作保，就拿去谁的外衣；","poem":2},{"lineBreak":true},{"text":"谁为外族人作保，谁就要承担责任。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"清早高声为邻舍祝福，","poem":1},{"text":"无异于咒诅他。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"喋喋不休的妻子，","poem":1},{"text":"就像雨天房屋漏个不停；","poem":2}]},{"type":"verse","number":16,"content":[{"text":"想制止她犹如制止狂风，","poem":1},{"text":"又像用手抓油一样困难。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"朋友互相切磋，","poem":1},{"lineBreak":true},{"text":"如铁磨铁越磨越利。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"看护无花果树的吃无花果，","poem":1},{"text":"照顾主人的也必得尊荣。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"水能映照人的面貌，","poem":1},{"text":"心能反映人的本相。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"阴间和死亡填不满，","poem":1},{"text":"人的眼目永不满足。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"鼎炼银，炉炼金，","poem":1},{"text":"赞美也考验人。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"就算把愚人放在臼里与麦子一起捣碎，","poem":1},{"text":"他仍然难脱愚昧。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"你要了解你的羊群，","poem":1},{"text":"小心照料你的牲畜。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"因为钱财有用尽时，","poem":1},{"text":"冠冕不能万代长存。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"干草割去，嫩草长出，","poem":1},{"text":"山间的野草都被收起来。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"小羊的皮毛可做衣服，","poem":1},{"text":"卖山羊的钱可买田地，","poem":2}]},{"type":"verse","number":27,"content":[{"text":"母山羊的奶足够你和家人喝，","poem":1},{"text":"也够养活你的仆婢。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}