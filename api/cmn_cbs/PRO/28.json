{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"恶人未被追赶也逃窜，","poem":1},{"text":"义人坦然无惧如雄狮。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"国中有罪，君王常换；","poem":1},{"text":"国有哲士，长治久安。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"穷人","poem":1},{"noteId":9},{"text":"欺压贫民，","poem":1},{"text":"如暴雨冲毁粮食。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"背弃律法的称赞恶人，","poem":1},{"text":"遵守律法的抗拒恶人。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"邪恶之人不明白公义，","poem":1},{"text":"寻求耶和华的全然明白。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"行为正直的穷人，","poem":1},{"text":"胜过行事邪僻的富人。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"遵守律法的是智慧之子，","poem":1},{"text":"与贪食者为伍的令父蒙羞。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"人放高利贷牟利，","poem":1},{"text":"是为济贫者积财。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"人若不听从律法，","poem":1},{"text":"他的祷告也可憎。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"引诱正直人走邪道，","poem":1},{"text":"必掉进自己设的陷阱；","poem":2},{"lineBreak":true},{"text":"但纯全无过的人必承受福分。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"富人自以为有智慧，","poem":1},{"text":"却被明智的穷人看透。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"义人得胜，众民欢腾；","poem":1},{"text":"恶人当道，人人躲藏。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"自掩其罪，必不亨通；","poem":1},{"text":"痛改前非，必蒙怜悯。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"常敬畏主的必蒙福，","poem":1},{"text":"心里刚硬的必遭祸。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"暴虐的君王辖制穷人，","poem":1},{"text":"如咆哮的狮、觅食的熊。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"昏庸的君王残暴不仁，","poem":1},{"text":"恨不义之财的享长寿。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"背负血债者必终生逃亡，","poem":1},{"text":"谁也不要帮他。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"纯全无过的必蒙拯救，","poem":1},{"text":"行为邪僻的转眼覆灭。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"勤奋耕耘，丰衣足食；","poem":1},{"text":"追求虚荣，穷困潦倒。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"忠信的人必大蒙祝福，","poem":1},{"text":"急于发财的难免受罚。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"徇私偏袒实为不善，","poem":1},{"text":"人却为一点饼而枉法。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"贪婪的人急于发财，","poem":1},{"text":"却不知贫穷即将临到。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"责备人的至终比谄媚者更受爱戴。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"窃取父母之财而不知罪者与匪类无异。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"贪得无厌的人挑起纷争，","poem":1},{"text":"信靠耶和华的富足昌盛。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"愚人心中自以为是，","poem":1},{"text":"凭智慧行事的平安稳妥。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"周济穷人的一无所缺，","poem":1},{"text":"视而不见的多受咒诅。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"恶人当道，人人躲藏；","poem":1},{"text":"恶人灭亡，义人增多。","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":9,"caller":"+","text":"“穷人”有些抄本作“暴君”。","reference":{"chapter":28,"verse":3}}]},"thisChapterLink":"/api/cmn_cbs/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}