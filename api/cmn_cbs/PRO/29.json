{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"屡教不改、顽固不化者，","poem":1},{"text":"必突然灭亡，无可挽救。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"义人增多，民众欢腾；","poem":1},{"text":"恶人得势，民众叹息。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"爱慕智慧的使父亲欢欣，","poem":1},{"text":"结交妓女的必耗尽钱财。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"君王秉公行义，国家安定；","poem":1},{"text":"他若收受贿赂，国必倾倒。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"奉承邻舍，等于设网罗绊他。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"恶人被自己的罪缠住，","poem":1},{"text":"义人却常常欢喜歌唱。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"义人关心穷人的冤屈，","poem":1},{"text":"恶人对此漠不关心。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"狂徒煽动全城，","poem":1},{"text":"智者平息众怒。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"智者跟愚人对簿公堂，","poem":1},{"text":"愚人会怒骂嬉笑不止。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"嗜杀之徒憎恶纯全无过的人，","poem":1},{"text":"但正直的人保护他们","poem":2},{"noteId":10},{"text":"。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"愚人尽情发泄怒气，","poem":1},{"text":"智者默然克制怒气。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"君王若听谗言，","poem":1},{"text":"臣仆必成奸徒。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"贫穷人和欺压者有共同点：","poem":1},{"text":"他们的眼睛都是耶和华所赐。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"君王若秉公审判穷人，","poem":1},{"text":"他的王位必永远坚立。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"管教之杖使孩子得智慧，","poem":1},{"text":"放纵的子女让母亲蒙羞。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"恶人当道，罪恶泛滥；","poem":1},{"text":"义人必得见他们败亡。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"好好管教儿子，","poem":1},{"text":"他会带给你平安，使你心里喜乐。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"百姓无神谕便任意妄为，","poem":1},{"text":"但遵守律法的人必蒙福。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"管教仆人不能单靠言语，","poem":1},{"text":"因为他虽明白却不理会。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"言语急躁的人，","poem":1},{"text":"还不如愚人有希望。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"从小娇纵的仆人，","poem":1},{"text":"最终必反仆为主。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"愤怒的人挑起纷争，","poem":1},{"text":"暴躁的人多有过犯。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"骄傲的人必遭贬抑，","poem":1},{"text":"谦卑的人必得尊荣。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"与盗贼为伍是憎恶自己，","poem":1},{"text":"他即使发誓也不敢作证。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"惧怕人的必自陷网罗，","poem":1},{"text":"信靠耶和华的必安稳。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"许多人讨君王的欢心，","poem":1},{"text":"但正义伸张靠耶和华。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"为非作歹，义人厌恶；","poem":1},{"text":"行为正直，恶人憎恨。","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"“但正直的人保护他们”或译“索取正直人的性命”。","reference":{"chapter":29,"verse":10}}]},"thisChapterLink":"/api/cmn_cbs/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}