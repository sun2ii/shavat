{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":3,"content":[{"type":"heading","content":["信靠耶和华"]},{"type":"verse","number":1,"content":[{"text":"孩子啊，不要忘记我的训诲，","poem":1},{"text":"要把我的诫命存在心里，","poem":2}]},{"type":"verse","number":2,"content":[{"text":"因为这必使你延年益寿，","poem":1},{"text":"幸福平安。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"不要让慈爱和信实离开你，","poem":1},{"text":"要把它们系在你的颈项上，","poem":2},{"lineBreak":true},{"text":"刻在你的心坎上。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"这样，你必蒙上帝和世人的喜悦，","poem":1},{"text":"享有美誉。","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你要全心信靠耶和华，","poem":1},{"text":"不可倚靠自己的悟性。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"凡事都要信从祂，","poem":1},{"text":"祂必指引你走正路。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"不要自以为有智慧，","poem":1},{"text":"要敬畏耶和华，远离恶事。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"这样可医治你的身体，","poem":1},{"text":"滋润你的筋骨。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"你要用自己的财富和一切初熟的物产来尊崇耶和华，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂必使你五谷满仓，","poem":1},{"text":"榨酒池溢出新酿。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"孩子啊，不可轻视耶和华的管教，","poem":1},{"text":"也不可厌烦祂的责备。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"因为耶和华管教祂所爱的人，","poem":1},{"text":"就像父亲管教他所疼爱的孩子。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"找到智慧、得到悟性的人有福了，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因为智慧比银子更有价值，","poem":1},{"text":"比金子更有益处，","poem":2}]},{"type":"verse","number":15,"content":[{"text":"比珠宝更珍贵；","poem":1},{"text":"你所喜爱的一切都难以相比。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"智慧的右手有长寿，","poem":1},{"text":"左手有富贵和尊荣。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"她的路上有福乐，","poem":1},{"text":"她的道上有平安。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"对持守智慧的人来说，","poem":1},{"text":"智慧是生命树，","poem":2},{"lineBreak":true},{"text":"紧握智慧的人必蒙福。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"耶和华以智慧奠立大地，","poem":1},{"text":"以悟性铺设诸天；","poem":2}]},{"type":"verse","number":20,"content":[{"text":"祂用知识使深渊裂开，","poem":1},{"text":"使天上降下甘露。","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"孩子啊，你要守护智慧和明辨力，","poem":1},{"text":"别让她们离开你的视线。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"她们必给你带来生命，","poem":1},{"text":"作你颈项上华美的装饰。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"如此，你必步履稳健，不致失足；","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你必安然躺卧，睡得香甜。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"不要怕突来的灾祸，","poem":1},{"text":"不要怕恶人遭毁灭，","poem":2}]},{"type":"verse","number":26,"content":[{"text":"因为耶和华是你的靠山，","poem":1},{"text":"祂使你的脚不陷入网罗。","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"倘若有力量行善，","poem":1},{"text":"就当帮助有需要的人，不要推托。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"倘若可以帮忙，","poem":1},{"text":"就不可对有求于你的邻人说：","poem":2},{"lineBreak":true},{"text":"“回去吧，明天再来，我必给你！”","poem":2}]},{"type":"verse","number":29,"content":[{"text":"邻舍在你附近安分居住，","poem":1},{"text":"不可谋害他。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"别人若没有害你，","poem":1},{"text":"不要无故与他相争。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"不要羡慕残暴之徒，","poem":1},{"text":"也不可步其后尘，","poem":2}]},{"type":"verse","number":32,"content":[{"text":"因为耶和华憎恶邪僻之徒，","poem":1},{"text":"喜爱正直的人。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"耶和华咒诅恶人的家，","poem":1},{"text":"赐福义人的家。","poem":2}]},{"type":"verse","number":34,"content":[{"text":"耶和华讥笑好讥诮的人，","poem":1},{"text":"恩待谦卑的人。","poem":2}]},{"type":"verse","number":35,"content":[{"text":"智者得尊荣，","poem":1},{"text":"愚人受羞辱。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}