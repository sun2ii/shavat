{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":30,"content":[{"type":"heading","content":["亚古珥的箴言"]},{"type":"verse","number":1,"content":["以下是雅基的儿子亚古珥的箴言。",{"text":"这人说：上帝啊，我很疲倦；","poem":2},{"lineBreak":true},{"text":"上帝啊，我很疲倦，精疲力尽。","poem":2},{"noteId":11}]},{"type":"verse","number":2,"content":[{"text":"我比众人都愚蠢，","poem":1},{"text":"不具备人的悟性。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"我从未学到智慧，","poem":1},{"text":"也不认识至圣者。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"谁升上高天又降下来？","poem":1},{"text":"谁将风聚在掌中？","poem":2},{"lineBreak":true},{"text":"谁将众水裹在衣服里？","poem":2},{"lineBreak":true},{"text":"谁定了地的边界？","poem":2},{"lineBreak":true},{"text":"祂叫什么名字？","poem":2},{"lineBreak":true},{"text":"祂儿子叫什么名字？","poem":2},{"lineBreak":true},{"text":"你知道吗？","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"上帝的话句句千真万确，","poem":1},{"text":"祂作投靠祂之人的盾牌。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"你不可对祂的话有所添加，","poem":1},{"text":"免得祂责备你，","poem":2},{"lineBreak":true},{"text":"揭穿你的虚谎。","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"上帝啊，我向你求两件事，","poem":1},{"text":"求你在我有生之年赐给我。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"求你使虚伪和谎言远离我，","poem":1},{"text":"求你让我不贫穷也不富足，","poem":2},{"lineBreak":true},{"text":"赐给我需用的饮食，","poem":2}]},{"type":"verse","number":9,"content":[{"text":"免得我因为饱足就不认你，","poem":1},{"text":"说：“耶和华是谁呢？”","poem":2},{"lineBreak":true},{"text":"又恐怕我因穷困而偷窃，","poem":2},{"lineBreak":true},{"text":"以致辱没我上帝的名。","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"别向主人毁谤他的仆人，","poem":1},{"text":"免得你受咒诅、担当罪责。","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"有一种","poem":1},{"noteId":12},{"text":"人咒诅父亲，","poem":1},{"text":"不为母亲祝福。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"有一种人自以为纯洁，","poem":1},{"text":"却没有洗掉自己的污秽。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"有一种人趾高气扬，","poem":1},{"text":"目空一切。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"有一种人牙如剑，","poem":1},{"text":"齿如刀，","poem":2},{"lineBreak":true},{"text":"要吞吃世间的困苦人和贫穷人。","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"水蛭有两个女儿，","poem":1},{"text":"她们不停地叫：“给我！给我！”","poem":2},{"text":"三样东西从不知足，","poem":1},{"lineBreak":true},{"text":"永不言“够”的共有四样：","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"阴间、不孕的妇人、","poem":1},{"text":"干旱的土地和烧不够的火焰。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"嘲笑父亲、藐视母亲教诲的，","poem":1},{"text":"眼睛必被谷中的乌鸦啄出，","poem":2},{"lineBreak":true},{"text":"被秃鹰吃掉。","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"我测不透的妙事有三样，","poem":1},{"lineBreak":true},{"text":"我不明白的事共有四样：","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"鹰在空中飞翔之道，","poem":1},{"text":"蛇在石上爬行之道，","poem":2},{"lineBreak":true},{"text":"船在海中航行之道，","poem":2},{"lineBreak":true},{"text":"男女相爱之道。","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"淫妇的道是这样：","poem":1},{"text":"她吃完就擦擦嘴，","poem":2},{"lineBreak":true},{"text":"说，“我没有做坏事。”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"使大地震动的事有三样，","poem":1},{"lineBreak":true},{"text":"大地无法承受的事共有四样：","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"奴仆做王，","poem":1},{"text":"愚人吃饱，","poem":2}]},{"type":"verse","number":23,"content":[{"text":"丑恶女子出嫁，","poem":1},{"text":"婢女取代主母。","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"地上有四种动物，","poem":1},{"text":"身体虽小却极其聪明：","poem":2}]},{"type":"verse","number":25,"content":[{"text":"蚂蚁力量虽小，","poem":1},{"text":"却在夏天储备粮食；","poem":2}]},{"type":"verse","number":26,"content":[{"text":"石獾虽不强壮，","poem":1},{"text":"却在岩石中做窝；","poem":2}]},{"type":"verse","number":27,"content":[{"text":"蝗虫虽无君王，","poem":1},{"text":"却整齐地列队前进；","poem":2}]},{"type":"verse","number":28,"content":[{"text":"壁虎虽易捕捉，","poem":1},{"text":"却居住在王宫大内。","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"步履威武的有三样，","poem":1},{"lineBreak":true},{"text":"走路雄壮的共有四样：","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"威震百兽、从不畏缩的狮子，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"昂首阔步的雄鸡，","poem":1},{"text":"公山羊和率领军队的君王。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"你若行事愚昧、","poem":1},{"text":"妄自尊大或图谋不轨，","poem":2},{"lineBreak":true},{"text":"就当用手掩口。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"激起愤怒会引起争端，","poem":1},{"text":"正如搅牛奶会搅出奶油，","poem":2},{"lineBreak":true},{"text":"拧鼻子会拧出鼻血。","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"“这人说”希伯来文或译“这人对以铁说，对以铁和乌甲说”。","reference":{"chapter":30,"verse":1}},{"noteId":12,"caller":"+","text":"“种”希伯来文是“世代”，11-14节也相同。","reference":{"chapter":30,"verse":11}}]},"thisChapterLink":"/api/cmn_cbs/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}