{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":31,"content":[{"type":"heading","content":["利慕伊勒王的箴言"]},{"type":"verse","number":1,"content":["以下是利慕伊勒王的箴言，",{"text":"是他母亲给他的教诲：","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"我儿，我亲生的骨肉，","poem":1},{"text":"我许愿得来的孩子啊，","poem":2},{"lineBreak":true},{"text":"我该怎样教导你呢？","poem":2}]},{"type":"verse","number":3,"content":[{"text":"不要在女人身上耗费精力，","poem":1},{"text":"不要迷恋那些能毁灭王的人。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"利慕伊勒啊，","poem":1},{"text":"君王不可喝酒，","poem":2},{"lineBreak":true},{"text":"不可喝酒，","poem":2},{"lineBreak":true},{"text":"首领不宜喝烈酒，","poem":2}]},{"type":"verse","number":5,"content":[{"text":"免得喝酒后忘记律例，","poem":1},{"text":"不为困苦人伸张正义。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"把烈酒给行将灭亡的人，","poem":1},{"text":"把淡酒给心中忧伤的人，","poem":2}]},{"type":"verse","number":7,"content":[{"text":"让他们喝了忘掉自己的贫穷，","poem":1},{"text":"不再记得自己的痛苦。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"要为不能自辩者说话，","poem":1},{"text":"为一切不幸的人申冤。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"你要开口秉公审判，","poem":1},{"text":"为贫穷困苦者辩护。","poem":2}]},{"type":"heading","content":["贤德的妻子"]},{"type":"verse","number":10,"content":[{"noteId":13},{"text":"谁能找到贤德之妻？","poem":1},{"text":"她的价值远胜过珠宝。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"她丈夫信赖她，","poem":1},{"text":"什么也不缺乏。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"她一生对丈夫有益无损。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"她寻找羊毛和细麻，","poem":1},{"text":"愉快地亲手做衣。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"她好像商船，","poem":1},{"text":"从远方运来粮食。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"天未亮她就起床，","poem":1},{"text":"为全家预备食物，","poem":2},{"lineBreak":true},{"text":"分派婢女做家事。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"她选中田地便买下来，","poem":1},{"text":"亲手赚钱栽种葡萄园。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"她精力充沛，","poem":1},{"text":"双臂有力。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"她深谙经营之道，","poem":1},{"text":"她的灯彻夜不熄。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"她手拿卷线杆，","poem":1},{"text":"手握纺线锤。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"她乐于周济穷人，","poem":1},{"text":"伸手帮助困苦者。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"她不因下雪而为家人担心，","poem":1},{"text":"因为全家都穿着朱红暖衣。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"她为自己缝制绣花毯，","poem":1},{"text":"用细麻和紫布做衣服。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"她丈夫在城门口与当地长老同坐，","poem":1},{"text":"受人尊重。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"她缝制细麻衣裳出售，","poem":1},{"text":"又制作腰带卖给商人。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"她充满力量和尊荣，","poem":1},{"text":"她以笑颜迎接未来。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"她说的话带着智慧，","poem":1},{"text":"她的训言充满慈爱。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"她料理一切家务，","poem":1},{"text":"从不偷懒吃闲饭。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"她的儿女肃立，","poem":1},{"text":"为她祝福，","poem":2},{"lineBreak":true},{"text":"她的丈夫也称赞她，","poem":2}]},{"type":"verse","number":29,"content":[{"text":"说：“世上贤德的女子很多，","poem":1},{"text":"唯有你无与伦比。”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"艳丽是虚假的，","poem":1},{"text":"美貌是短暂的，","poem":2},{"lineBreak":true},{"text":"唯有敬畏耶和华的女子配得称赞。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"愿她享受自己的劳动成果，","poem":1},{"text":"愿她的事迹使她在城门口受称赞。","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"10-30节是字母诗，每一节依次由一个希伯来字母开头。","reference":{"chapter":31,"verse":10}}]},"thisChapterLink":"/api/cmn_cbs/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}