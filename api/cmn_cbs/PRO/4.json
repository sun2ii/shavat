{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":4,"content":[{"type":"heading","content":["父亲的教诲"]},{"type":"verse","number":1,"content":[{"text":"孩子们啊，","poem":1},{"text":"你们要听从父亲的教诲，","poem":2},{"lineBreak":true},{"text":"留心学习，以便领悟，","poem":2}]},{"type":"verse","number":2,"content":[{"text":"因为我给你们的训诲是美好的，","poem":1},{"text":"不可背弃我的教导。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"我年幼时在父亲身边，","poem":1},{"text":"是母亲唯一的宠儿。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"父亲教导我说：","poem":1},{"text":"“你心里要牢记我的话，","poem":2},{"lineBreak":true},{"text":"遵守我的诫命，就必存活。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"你要求取智慧和悟性，","poem":1},{"text":"不要忘记或违背我的吩咐。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"不可离弃智慧，智慧必护佑你；","poem":1},{"text":"你要热爱智慧，智慧必看顾你。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"智慧至上，要求取智慧，","poem":1},{"text":"要不惜一切获取悟性。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"高举智慧，她必使你受尊崇；","poem":1},{"text":"拥抱智慧，她必使你得尊荣。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"她必为你戴上华冠，","poem":1},{"text":"加上荣冕。”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"孩子啊，你要听从我的教导，","poem":1},{"text":"就必延年益寿。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"我已经指示你走智慧之道，","poem":1},{"text":"引导你行正确的路。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"你行走，脚下不受阻碍；","poem":1},{"text":"你奔跑，也不会跌倒。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"你要持守教诲，不要松懈；","poem":1},{"text":"要守护好，因为那是你的生命。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"不要涉足恶人的道，","poem":1},{"text":"不要行走坏人的路；","poem":2}]},{"type":"verse","number":15,"content":[{"text":"要避开，不可踏足，","poem":1},{"text":"要绕道前行。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"因为他们不作恶就无法入睡，","poem":1},{"text":"不绊倒人就无法安眠；","poem":2}]},{"type":"verse","number":17,"content":[{"text":"他们吃的是邪恶饼，","poem":1},{"text":"喝的是残暴酒。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"义人的道路好像黎明的曙光，","poem":1},{"text":"越照越亮，直到正午。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"恶人的道路一片幽暗，","poem":1},{"text":"他们不知被何物绊倒。","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"孩子啊，你要聆听我的吩咐，","poem":1},{"text":"侧耳听我的训言；","poem":2}]},{"type":"verse","number":21,"content":[{"text":"不要让它们离开你的视线，","poem":1},{"text":"要牢记在心。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"因为得到它们就得到生命，","poem":1},{"text":"全身也必康健。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"要一丝不苟地守护你的心，","poem":1},{"text":"因为生命之泉从心中涌出。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"不讲欺诈之言，","poem":1},{"text":"不说荒谬的话。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"眼睛要正视前方，","poem":1},{"text":"双目要向前直看。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"要铺平脚下的路，","poem":1},{"text":"使所行之道稳妥。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"不可偏右偏左，","poem":1},{"text":"要远离恶事。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}