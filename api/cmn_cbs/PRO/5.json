{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":5,"content":[{"type":"heading","content":["远避淫乱"]},{"type":"verse","number":1,"content":[{"text":"孩子啊，要留心听我的智言，","poem":1},{"text":"侧耳听我的慧语，","poem":2}]},{"type":"verse","number":2,"content":[{"text":"好保持明辨力，","poem":1},{"text":"嘴唇谨守知识。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"淫妇满口甜言蜜语，","poem":1},{"text":"油嘴滑舌，","poem":2}]},{"type":"verse","number":4,"content":[{"text":"最后却苦如艾草，","poem":1},{"text":"锋利似双刃剑。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"她的双脚走进死地，","poem":1},{"text":"她的步伐迈向阴间。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"她不走生命的康庄大道，","poem":1},{"text":"偏离了正途也不自知。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"孩子们啊，要听从我，","poem":1},{"text":"不可违背我的话！","poem":2}]},{"type":"verse","number":8,"content":[{"text":"要远远避开淫妇，","poem":1},{"text":"不可靠近她的家门，","poem":2}]},{"type":"verse","number":9,"content":[{"text":"免得你为别人枉费精力，","poem":1},{"text":"为残忍之徒断送青春；","poem":2}]},{"type":"verse","number":10,"content":[{"text":"免得外人吞尽你的财富，","poem":1},{"text":"你的辛劳所得归给外人。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"临终之时，肉体衰残，","poem":1},{"text":"你必呻吟不止，","poem":2}]},{"type":"verse","number":12,"content":[{"text":"说：“我为何厌恶教诲，","poem":1},{"text":"心里藐视责备！","poem":2}]},{"type":"verse","number":13,"content":[{"text":"不听从老师的话，","poem":1},{"text":"不侧耳听导师之言。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"在会众当中，","poem":1},{"text":"我几乎身败名裂。”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"你当喝自己池中的水，","poem":1},{"text":"饮自己井里的活水。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"你的泉水岂可外流？","poem":1},{"text":"你的河水怎可溢到街上？","poem":2}]},{"type":"verse","number":17,"content":[{"text":"这些要专属于你，","poem":1},{"text":"不可与外人共享。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"要使你的泉源蒙福，","poem":1},{"text":"要爱你年轻时所娶的妻。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"她秀美可爱宛如母鹿，","poem":1},{"text":"愿她的胸令你时时满足，","poem":2},{"lineBreak":true},{"text":"愿她的爱让你常常陶醉。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"孩子啊，为何迷恋淫妇？","poem":1},{"text":"为何拥抱妓女的胸？","poem":2}]},{"type":"verse","number":21,"content":[{"text":"因为人的所作所为逃不过耶和华的眼目，","poem":1},{"text":"祂必鉴察人一切所行之道。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"恶人被自己的罪恶捉住，","poem":1},{"text":"被自己罪恶的绳索捆绑。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"他因不听管教而丧命，","poem":1},{"text":"因极其愚妄而入歧途。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}