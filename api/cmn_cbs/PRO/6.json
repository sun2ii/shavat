{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":6,"content":[{"type":"heading","content":["日常警言"]},{"type":"verse","number":1,"content":[{"text":"孩子啊，你若为邻人作保，","poem":1},{"text":"为外人击掌立约，","poem":2}]},{"type":"verse","number":2,"content":[{"text":"你就被自己口中的话套住，","poem":1},{"text":"被自己的诺言缠住。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"孩子啊，你已落入邻人的手中，","poem":1},{"text":"你当如此自救：","poem":2},{"lineBreak":true},{"text":"要谦卑地向他求情。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"勿让你的眼睛睡觉，","poem":1},{"text":"莫叫你的眼皮打盹。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"要救自己脱离困境，","poem":1},{"text":"像羚羊挣脱猎人的手，","poem":2},{"lineBreak":true},{"text":"飞鸟逃脱捕鸟人的手。","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"懒惰的人啊，去看看蚂蚁，","poem":1},{"text":"观察它的生活，就会有智慧。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"蚂蚁没有元帅，","poem":1},{"text":"没有官长，","poem":2},{"lineBreak":true},{"text":"也没有君王，","poem":2}]},{"type":"verse","number":8,"content":[{"text":"却在夏季储备粮食，","poem":1},{"text":"在收割时积聚食物。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"懒惰的人啊，你要躺到何时？","poem":1},{"text":"要睡到何时才起床？","poem":2}]},{"type":"verse","number":10,"content":[{"text":"再睡一会儿，再打个盹儿，","poem":1},{"text":"再抱着手躺一会儿，","poem":2}]},{"type":"verse","number":11,"content":[{"text":"贫穷必像盗贼一样临到你，","poem":1},{"text":"缺乏必像武士一样扑向你。","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"无赖与恶人满口诡诈，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"挤眉弄眼，指手画脚，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"心术不正，图谋恶事，常常挑起争端。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因此，灾难必突然临到，","poem":1},{"text":"他们顷刻之间遭到毁灭，","poem":2},{"lineBreak":true},{"text":"无可挽救。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"耶和华所憎恶的事有六样，","poem":1},{"lineBreak":true},{"text":"连祂厌恶的事共有七样：","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"高傲的眼睛，","poem":1},{"text":"撒谎的舌头，","poem":2},{"lineBreak":true},{"text":"杀害无辜的手，","poem":2}]},{"type":"verse","number":18,"content":[{"text":"图谋诡计的心，","poem":1},{"text":"奔跑作恶的脚，","poem":2}]},{"type":"verse","number":19,"content":[{"text":"撒谎的假证人，","poem":1},{"text":"以及在弟兄中挑起争端的人。","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"孩子啊，要遵守你父亲的诫命，","poem":1},{"text":"不可背弃你母亲的训诲。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"你要常常将这些系在心坎上，","poem":1},{"text":"戴在颈项上。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"你行走，它们必引领你；","poem":1},{"text":"你躺卧，它们必护卫你；","poem":2},{"lineBreak":true},{"text":"你醒来，它们必与你交谈。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"因为诫命是灯，训诲是光，","poem":1},{"text":"管教和责备是生命之道，","poem":2}]},{"type":"verse","number":24,"content":[{"text":"能使你远离邪恶的女人，","poem":1},{"text":"避开油嘴滑舌的妓女。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"你的心不要贪恋她的美色，","poem":1},{"text":"也不要被她的媚眼所迷惑，","poem":2}]},{"type":"verse","number":26,"content":[{"text":"因为娼妓会使人倾家荡产","poem":1},{"noteId":1},{"text":"，","poem":1},{"text":"淫妇会猎杀人宝贵的生命。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"人若将火藏在怀中，","poem":1},{"text":"哪能不烧着衣服呢？","poem":2}]},{"type":"verse","number":28,"content":[{"text":"人若行走在火炭上，","poem":1},{"text":"哪能不烫伤双脚呢？","poem":2}]},{"type":"verse","number":29,"content":[{"text":"与别人妻子通奸也是这样，","poem":1},{"text":"凡亲近她的必难逃罪责。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"贼因充饥而偷，","poem":1},{"text":"没有人藐视他；","poem":2}]},{"type":"verse","number":31,"content":[{"text":"但若被抓到，他要偿还七倍，","poem":1},{"text":"就是倾家荡产也要偿还。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"和有夫之妇通奸的，","poem":1},{"text":"实在愚不可及，","poem":2},{"lineBreak":true},{"text":"他是自寻死路。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"他必挨打，受辱，","poem":1},{"text":"他的耻辱永难抹去。","poem":2}]},{"type":"verse","number":34,"content":[{"text":"那丈夫妒火燃烧，","poem":1},{"text":"报仇时绝不留情。","poem":2}]},{"type":"verse","number":35,"content":[{"text":"赔他再多财物，他也不会接受；","poem":1},{"text":"送他再多礼物，他都不肯罢休。","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"“娼妓会使人倾家荡产”或译“娼妓的嫖资不过是一个饼”。","reference":{"chapter":6,"verse":26}}]},"thisChapterLink":"/api/cmn_cbs/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}