{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":7,"content":[{"type":"heading","content":["要远离淫妇"]},{"type":"verse","number":1,"content":[{"text":"孩子啊，你要遵从我的吩咐，","poem":1},{"text":"把我的诫命珍藏在心中。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"遵守我的诫命，你便存活。","poem":1},{"text":"要爱护我的训诲，","poem":2},{"lineBreak":true},{"text":"如爱护眼中的瞳仁。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"要系在你的指头上，","poem":1},{"text":"刻在你的心版上。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"你要把智慧当作姊妹，","poem":1},{"text":"将悟性视为亲人。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"她们能使你远离淫妇，","poem":1},{"text":"远离妓女的甜言蜜语。","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我曾在家里的窗前，","poem":1},{"text":"透过窗棂往外观看，","poem":2}]},{"type":"verse","number":7,"content":[{"text":"只见在愚昧人中，","poem":1},{"text":"有个无知的青年，","poem":2}]},{"type":"verse","number":8,"content":[{"text":"他穿过靠近淫妇的巷口，","poem":1},{"text":"朝她的家门走去，","poem":2}]},{"type":"verse","number":9,"content":[{"text":"趁着日暮黄昏，","poem":1},{"text":"借着夜色昏暗。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"看啊！一个妓女打扮、","poem":1},{"text":"心术不正的女子出来迎接他。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"她喧嚷放荡，不安分守家，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"有时在街上，有时在广场，","poem":1},{"text":"或在各巷口守候。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"她缠着那青年，与他亲吻，","poem":1},{"text":"厚颜无耻地说：","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“我今天刚献祭还了愿，","poem":1},{"text":"家里有平安祭肉","poem":2},{"noteId":2},{"text":"，","poem":2}]},{"type":"verse","number":15,"content":[{"text":"因此我出来迎接你，寻找你，","poem":1},{"text":"终于找到了你！","poem":2}]},{"type":"verse","number":16,"content":[{"text":"我已经铺好了床，","poem":1},{"text":"铺上了埃及的绣花布，","poem":2}]},{"type":"verse","number":17,"content":[{"text":"又用没药、沉香、肉桂熏了床。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"来吧，让我们通宵畅饮爱情，","poem":1},{"text":"让我们尽情欢爱！","poem":2}]},{"type":"verse","number":19,"content":[{"text":"因为我丈夫不在家，出远门了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他带着钱囊去了，月圆才回来。”","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"淫妇花言巧语勾引他，","poem":1},{"text":"用谄媚的话语诱惑他。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"那青年立刻随她而去，","poem":1},{"text":"像走向屠宰场的公牛，","poem":2},{"lineBreak":true},{"text":"又像掉入陷阱的雄鹿，","poem":2}]},{"type":"verse","number":23,"content":[{"text":"直等到利箭射穿他的肝。","poem":1},{"text":"他像只自投网罗的飞鸟，","poem":2},{"lineBreak":true},{"text":"浑然不知要赔上性命！","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"孩子们啊，你们要听从我的话，","poem":1},{"text":"留意我口中的训言，","poem":2}]},{"type":"verse","number":25,"content":[{"text":"别让你的心偏向淫妇的道，","poem":1},{"text":"步入她的歧途。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"因为她使许多人丧命，","poem":1},{"text":"被她杀害的数目众多。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"她的家是通往阴间的路，","poem":1},{"text":"引人坠入死亡之室。","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"按犹太律法规定，还愿之后所得的祭肉要在第二天吃完。参考利未记7:16。","reference":{"chapter":7,"verse":14}}]},"thisChapterLink":"/api/cmn_cbs/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}