{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":8,"content":[{"type":"heading","content":["智慧的呼唤"]},{"type":"verse","number":1,"content":[{"text":"智慧不是在呼唤吗？","poem":1},{"text":"悟性不是在呐喊吗？","poem":2}]},{"type":"verse","number":2,"content":[{"text":"她在路边高处站立，","poem":1},{"text":"她在十字街头停留，","poem":2}]},{"type":"verse","number":3,"content":[{"text":"在城门旁，在入口处大喊：","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“世人啊，我呼唤你们，","poem":1},{"text":"我向天下人大声呼吁。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"愚昧人啊，要学会谨慎！","poem":1},{"text":"愚顽人啊，要慎思明辨！","poem":2}]},{"type":"verse","number":6,"content":[{"text":"你们听啊，我要说美好的话，","poem":1},{"text":"开口谈论正直的事。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"我的口传扬真理，","poem":1},{"text":"我的嘴憎恨邪恶。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"我口中的言语公正，","poem":1},{"text":"没有歪曲错谬的话。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"我的话，智者明白，哲士认同。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"要接受我的教诲，而非白银；","poem":1},{"text":"要选择知识，而非黄金。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"因为智慧比宝石更珍贵，","poem":1},{"text":"一切美物都不能与之相比。","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“我智慧与谨慎同住，","poem":1},{"text":"我拥有知识和明辨力。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"敬畏耶和华就当憎恨邪恶，","poem":1},{"text":"我憎恨骄傲、狂妄、恶道和谎言。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"我有谋略和真知，","poem":1},{"text":"又有悟性和能力。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"君王靠我安邦定国，","poem":1},{"text":"首领借我秉公行义，","poem":2}]},{"type":"verse","number":16,"content":[{"text":"王公大臣靠我治理天下，","poem":1},{"text":"官宦贵胄凭我公正断案。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"爱我的，我也爱他；","poem":1},{"text":"恳切寻求我的，必能寻见。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"富贵和尊荣在我，","poem":1},{"text":"恒久的财富和公义也在我。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"我的果实胜过纯金，","poem":1},{"text":"我的出产胜过纯银。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"我在公义的道上奔走，","poem":1},{"text":"在公平的路上前行。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"我要赐财富给爱我的人，","poem":1},{"text":"使他们的库房充盈。","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“在耶和华造物的起头，","poem":1},{"text":"在太初万物被造以前，","poem":2},{"lineBreak":true},{"text":"就已经有我。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"从亘古，从太初，","poem":1},{"text":"大地还没有形成以前，","poem":2},{"lineBreak":true},{"text":"我已经被立。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"没有深渊，","poem":1},{"text":"没有涌流的水泉以前，","poem":2},{"lineBreak":true},{"text":"我已经诞生。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"大山未曾奠定，","poem":1},{"text":"小丘未曾形成，","poem":2},{"lineBreak":true},{"text":"我已经出生。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"那时耶和华还没有造大地和原野，","poem":1},{"text":"还没有造一粒尘土。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"祂铺设诸天的时候，我已在场。","poem":1},{"text":"祂在深渊上画出地平线，","poem":2}]},{"type":"verse","number":28,"content":[{"text":"上使穹苍坚固，","poem":1},{"text":"下使深渊的泉源安稳，","poem":2}]},{"type":"verse","number":29,"content":[{"text":"设定沧海的界限，","poem":1},{"text":"使海水不得越过祂定的范围，","poem":2},{"lineBreak":true},{"text":"为大地奠定根基。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"那时，我就在祂身旁，","poem":1},{"text":"做祂的工程师，","poem":2},{"lineBreak":true},{"text":"天天成为祂的喜乐，","poem":2},{"lineBreak":true},{"text":"终日在祂面前欢悦，","poem":2}]},{"type":"verse","number":31,"content":[{"text":"因祂所造的人世而欢悦，","poem":1},{"text":"因祂所造的世人而喜乐。","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“孩子们啊，你们要听从我，","poem":1},{"text":"持守我道路的人有福了。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"要听从教诲，不可轻忽，","poem":1},{"text":"要做智者。","poem":2}]},{"type":"verse","number":34,"content":[{"text":"人若听从我、天天在我门口仰望、","poem":1},{"text":"在我门边等候，就有福了。","poem":2}]},{"type":"verse","number":35,"content":[{"text":"因为找到我的，便找到了生命，","poem":1},{"text":"他必蒙耶和华的恩惠。","poem":2}]},{"type":"verse","number":36,"content":[{"text":"没找到我就是害自己；","poem":1},{"text":"憎恨我就是喜爱死亡。”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}