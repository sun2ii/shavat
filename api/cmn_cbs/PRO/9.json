{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbs","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"8768272cec2e37604eadd6c506c8eb69f5cdfe752866e0e5f4708d36d1a41a61","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbs/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":9,"content":[{"type":"heading","content":["智慧和愚昧"]},{"type":"verse","number":1,"content":[{"text":"智慧建造她的房屋，","poem":1},{"text":"她凿出七根柱子。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"她宰了牲口，","poem":1},{"text":"调了美酒，","poem":2},{"lineBreak":true},{"text":"设了宴席，","poem":2}]},{"type":"verse","number":3,"content":[{"text":"派婢女出去邀请宾客，","poem":1},{"text":"自己在城中高处呼喊：","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“愚昧人啊，到这里来吧！”","poem":1},{"text":"她又对无知者说：","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“来吃我做的饭，","poem":1},{"text":"喝我调的酒吧！","poem":2}]},{"type":"verse","number":6,"content":[{"text":"你们要抛弃愚昧，就能存活，","poem":1},{"text":"要转向悟性之道。”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"纠正嘲讽者，必自招羞辱；","poem":1},{"text":"责备恶人，必自招伤害。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"不要责备嘲讽者，免得他恨你；","poem":1},{"text":"要责备智者，他必爱你。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"教导智者，他就更有智慧；","poem":1},{"text":"指教义人，他就更有见识。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"智慧始于敬畏耶和华，","poem":1},{"text":"认识至圣者便是明智。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"智慧可增添你的年日，","poem":1},{"text":"加添你的寿数。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"人有智慧，自得益处；","poem":1},{"text":"人好嘲讽，自食恶果。","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"愚昧的女人喧嚷，蒙昧，无知。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"她坐在自己的家门口，","poem":1},{"text":"坐在城中高处的座位上，","poem":2}]},{"type":"verse","number":15,"content":[{"text":"招呼着匆匆前行的过客：","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"“愚昧人啊，到这里来吧！”","poem":1},{"text":"她又对无知者说：","poem":2}]},{"type":"verse","number":17,"content":[{"text":"“偷来的水甜，偷来的饼香。”","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们却不知她那里亡魂憧憧，","poem":1},{"text":"她的客人已落在阴间的深处。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}