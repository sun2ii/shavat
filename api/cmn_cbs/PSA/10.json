{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":10,"content":[{"type":"heading","content":["求上帝惩治恶人"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，你为何远远站着？","poem":1},{"lineBreak":true},{"text":"为何在我遭难时隐藏起来？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"恶人狂妄地追逼穷苦人，","poem":1},{"lineBreak":true},{"text":"愿他们落入自己所设的圈套。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"恶人夸耀自己的贪欲，","poem":1},{"lineBreak":true},{"text":"贪婪的人咒诅和藐视耶和华。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们狂傲自大，不寻求耶和华，","poem":1},{"lineBreak":true},{"text":"他们心中没有上帝。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们凡事顺利，","poem":1},{"lineBreak":true},{"text":"对你的审判不屑一顾，","poem":1},{"lineBreak":true},{"text":"对所有的仇敌嗤之以鼻。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们自以为可以屹立不倒，","poem":1},{"lineBreak":true},{"text":"世世代代永不遭殃。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们满口咒诅、谎话和恐吓之言，","poem":1},{"lineBreak":true},{"text":"舌头沾满祸害和邪恶。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们埋伏在村庄，","poem":1},{"lineBreak":true},{"text":"杀害无辜，暗中监视受害者。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们像狮子埋伏在暗处，","poem":1},{"lineBreak":true},{"text":"伺机猎取无助的人，","poem":1},{"lineBreak":true},{"text":"用网罗拖走他们。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"无助的人被击垮，","poem":1},{"lineBreak":true},{"text":"倒在他们的暴力下。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们自言自语：“上帝忘记了，","poem":1},{"lineBreak":true},{"text":"祂掩面不理，永不察看！”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华啊，求你起来！","poem":1},{"lineBreak":true},{"text":"上帝啊，求你举手施罚，","poem":1},{"lineBreak":true},{"text":"不要忘记无助的人！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"恶人为何藐视上帝，","poem":1},{"lineBreak":true},{"text":"以为上帝不会追究呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"但你已看到世人的疾苦，","poem":1},{"lineBreak":true},{"text":"随时伸出援手。","poem":1},{"lineBreak":true},{"text":"困苦无助的人投靠你，","poem":1},{"lineBreak":true},{"text":"你是孤儿的帮助。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"求你打断恶人的臂膀，","poem":1},{"lineBreak":true},{"text":"彻底追究他们的罪恶。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华永永远远是君王，","poem":1},{"lineBreak":true},{"text":"列国必从祂的土地上灭亡。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"你知道困苦人的愿望，","poem":1},{"lineBreak":true},{"text":"你必垂听他们的呼求，","poem":1},{"lineBreak":true},{"text":"使他们心里刚强。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你为孤儿和受欺压的人申冤，","poem":1},{"lineBreak":true},{"text":"使区区世人不能再恐吓他们。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}