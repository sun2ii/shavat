{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":101,"content":[{"type":"heading","content":["君王的诺言"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"我要歌颂你的慈爱和公正，","poem":1},{"lineBreak":true},{"text":"我要颂赞你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要谨慎行事，","poem":1},{"lineBreak":true},{"text":"走正直的路，","poem":1},{"lineBreak":true},{"text":"你何时来我这里？","poem":1},{"lineBreak":true},{"text":"我要存纯全的心在家中行事。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我要弃绝恶事，","poem":1},{"lineBreak":true},{"text":"我憎恶背弃上帝者的行为，","poem":1},{"lineBreak":true},{"text":"不沾染他们的恶行。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要远离心术不正的人，","poem":1},{"lineBreak":true},{"text":"不与邪恶的事有任何瓜葛。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我要消灭暗中毁谤邻居的人，","poem":1},{"lineBreak":true},{"text":"也不容忍心高气傲的人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我要看顾地上忠信的人，","poem":1},{"lineBreak":true},{"text":"让他们与我同住。","poem":1},{"lineBreak":true},{"text":"行事正直的人才能服侍我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"诡诈的人必不得与我同住，","poem":1},{"lineBreak":true},{"text":"口出谎言的人必不得侍立在我面前。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"每天早晨我要消灭国中所有的恶人，","poem":1},{"lineBreak":true},{"text":"从耶和华的城中铲除一切作恶的人。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}