{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":102,"content":[{"type":"heading","content":["患难中的祈祷"]},{"type":"hebrew_subtitle","content":["受苦之人的祷告，在疲惫不堪时向耶和华的倾诉。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你听我的祷告，","poem":1},{"lineBreak":true},{"text":"愿我的呼求达到你面前！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在危难的时候，","poem":1},{"lineBreak":true},{"text":"求你不要掩面不理我。","poem":1},{"lineBreak":true},{"text":"我的呼求的时候，求你垂听，","poem":1},{"lineBreak":true},{"text":"赶快应允我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的年日如烟消散，","poem":1},{"lineBreak":true},{"text":"我的骨头如火焚烧。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的心被摧残，如草枯萎，","poem":1},{"lineBreak":true},{"text":"以致我不思饮食。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我因哀叹而瘦骨嶙峋。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我就像旷野中的鸮鸟，","poem":1},{"lineBreak":true},{"text":"又像废墟中的猫头鹰。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我无法入睡，","poem":1},{"lineBreak":true},{"text":"我就像屋顶上一只孤伶伶的麻雀。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的仇敌终日辱骂我，","poem":1},{"lineBreak":true},{"text":"嘲笑我的用我的名字咒诅人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我以炉灰为食物，","poem":1},{"lineBreak":true},{"text":"眼泪拌着水喝，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因为你向我大发烈怒，","poem":1},{"lineBreak":true},{"text":"把我捡起来扔掉了。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的年日像黄昏的影子，","poem":1},{"lineBreak":true},{"text":"又如枯干的草芥。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和华啊！唯有你永远做王，","poem":1},{"lineBreak":true},{"text":"你的大名万代长存。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你必起来怜悯锡安，","poem":1},{"lineBreak":true},{"text":"因为该恩待她了，时候已到。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你的仆人们喜爱城中的石头，","poem":1},{"lineBreak":true},{"text":"怜惜城中的尘土。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"列国敬畏耶和华的名，","poem":1},{"lineBreak":true},{"text":"世上的君王都敬畏祂的荣耀。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因为耶和华必重建锡安，","poem":1},{"lineBreak":true},{"text":"带着荣耀显现。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂必垂听穷人的祷告，","poem":1},{"lineBreak":true},{"text":"不藐视他们的祈求。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"要为后代记下这一切，","poem":1},{"lineBreak":true},{"text":"好让将来受造的人赞美耶和华。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和华从至高的圣所俯视人间，","poem":1},{"lineBreak":true},{"text":"从天上察看大地，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"要垂听被囚之人的哀叹，","poem":1},{"lineBreak":true},{"text":"释放被定死罪的人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"这样，万族万国聚集敬拜","poem":1},{"lineBreak":true},{"text":"耶和华时，","poem":1},{"lineBreak":true},{"text":"人们必在锡安传扬祂的名，","poem":1},{"lineBreak":true},{"text":"在耶路撒冷赞美祂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"祂使我未老先衰，","poem":1},{"lineBreak":true},{"text":"缩短了我的岁月。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我说：“我的上帝啊，","poem":1},{"lineBreak":true},{"text":"你世代长存，","poem":1},{"lineBreak":true},{"text":"求你不要叫我中年早逝。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"太初你奠立大地的根基，","poem":1},{"lineBreak":true},{"text":"亲手创造诸天。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"天地都要消亡，","poem":1},{"lineBreak":true},{"text":"但你永远长存。","poem":1},{"lineBreak":true},{"text":"天地都会像外衣渐渐破旧，","poem":1},{"lineBreak":true},{"text":"你必更换天地，如同更换衣服，","poem":1},{"lineBreak":true},{"text":"天地都要消逝。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"但你永远不变，","poem":1},{"lineBreak":true},{"text":"你的年日永无穷尽。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你仆人的后代必生生不息，","poem":1},{"lineBreak":true},{"text":"他们的子孙必在你面前坚立。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":27}