{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":103,"content":[{"type":"heading","content":["上帝的慈爱"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"我的心啊，要称颂耶和华，","poem":1},{"lineBreak":true},{"text":"我的肺腑心肠啊，要称颂祂的圣名。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的心啊，要称颂耶和华，","poem":1},{"lineBreak":true},{"text":"不要忘记祂的一切恩惠。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂赦免你一切的罪恶，","poem":1},{"lineBreak":true},{"text":"医治你一切的疾病。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂救赎你的生命脱离死亡，","poem":1},{"lineBreak":true},{"text":"以慈爱和怜悯环绕你。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂以美物满足你的愿望，","poem":1},{"lineBreak":true},{"text":"使你如鹰一般恢复青春。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和华为一切受欺压的人伸张正义，主持公道。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂让摩西明白自己的旨意，","poem":1},{"lineBreak":true},{"text":"向以色列人彰显自己的作为。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华好怜悯，有恩典，","poem":1},{"lineBreak":true},{"text":"不轻易发怒，充满慈爱。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂不永久责备人，","poem":1},{"lineBreak":true},{"text":"也不永远怀怒。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂没有按我们的罪恶对待我们，","poem":1},{"lineBreak":true},{"text":"也没有照我们的罪过惩罚我们。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因为天离地有多高，","poem":1},{"lineBreak":true},{"text":"祂对敬畏祂之人的爱也多大！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"东离西有多远，","poem":1},{"lineBreak":true},{"text":"祂叫我们的过犯离我们也多远！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华怜爱敬畏祂的人，","poem":1},{"lineBreak":true},{"text":"如同慈父怜爱自己的儿女。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因为祂知道我们的本源，","poem":1},{"lineBreak":true},{"text":"顾念我们不过是尘土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"世人的年日如同草芥，","poem":1},{"lineBreak":true},{"text":"如野地茂盛的花，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"一经风吹，便无影无踪，","poem":1},{"lineBreak":true},{"text":"从原处永远消逝。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和华永永远远爱敬畏祂的人，","poem":1},{"lineBreak":true},{"text":"以公义待他们的子子孙孙，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"就是那些守祂的约、","poem":1},{"lineBreak":true},{"text":"一心遵行祂命令的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和华在天上设立了宝座，","poem":1},{"lineBreak":true},{"text":"祂的王权统管万有。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"听从耶和华的命令、遵行祂吩咐的大能天使啊，","poem":1},{"lineBreak":true},{"text":"你们要称颂祂！","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"事奉耶和华、遵从祂旨意的天军啊，","poem":1},{"lineBreak":true},{"text":"你们要称颂祂！","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和华所造的万物啊，","poem":1},{"lineBreak":true},{"text":"要在祂掌管的各处称颂祂。","poem":1},{"lineBreak":true},{"text":"我的心啊，要称颂耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}