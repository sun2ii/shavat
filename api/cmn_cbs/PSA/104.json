{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":104,"content":[{"type":"heading","content":["称颂创造主上帝"]},{"type":"verse","number":1,"content":[{"text":"我的心啊，要称颂耶和华。","poem":1},{"lineBreak":true},{"text":"我的上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"你是多么伟大！","poem":1},{"lineBreak":true},{"text":"你以尊贵和威严为衣，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你身披光华如披外袍，","poem":1},{"lineBreak":true},{"text":"你铺展穹苍如铺幔子。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂在水上立起楼阁的栋梁。","poem":1},{"lineBreak":true},{"text":"祂以云彩为车驾，乘风飞驰。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂以风为使者，","poem":1},{"lineBreak":true},{"text":"以火焰为仆役。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂将大地立在根基上，","poem":1},{"lineBreak":true},{"text":"使它永不动摇。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你以深水为衣覆盖大地，","poem":1},{"lineBreak":true},{"text":"使大水淹没群山。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你一声怒叱，众水便奔逃；","poem":1},{"lineBreak":true},{"text":"你一声雷鸣，众水就奔流，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"漫过山峦，流进山谷，","poem":1},{"lineBreak":true},{"text":"归到你指定的地方。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你为众水划定不可逾越的界线，","poem":1},{"lineBreak":true},{"text":"以免大地再遭淹没。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和华使泉水涌流在谷地，","poem":1},{"lineBreak":true},{"text":"奔腾在山间，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"让野地的动物有水喝，","poem":1},{"lineBreak":true},{"text":"野驴可以解渴。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"飞鸟也在溪旁栖息，","poem":1},{"lineBreak":true},{"text":"在树梢上歌唱。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂从天上的楼阁降雨在山间，","poem":1},{"lineBreak":true},{"text":"大地因祂的作为而丰美富饶。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂使绿草生长，滋养牲畜，","poem":1},{"lineBreak":true},{"text":"让人种植作物，","poem":1},{"lineBreak":true},{"text":"享受大地的出产，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"有沁人心怀的醇酒、","poem":1},{"lineBreak":true},{"text":"滋润容颜的膏油、","poem":1},{"lineBreak":true},{"text":"增强活力的五谷。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华种植了黎巴嫩的香柏树，","poem":1},{"lineBreak":true},{"text":"使它们得到充沛的水源，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"鸟儿在树上搭窝，","poem":1},{"lineBreak":true},{"text":"鹳鸟在松树上栖息。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"高山是野山羊的住处，","poem":1},{"lineBreak":true},{"text":"峭壁是石獾的藏身之所。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你命月亮定节令，","poem":1},{"lineBreak":true},{"text":"使太阳自知西沉。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你造黑暗，定为夜晚，","poem":1},{"lineBreak":true},{"text":"作林中百兽出没的时间。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"猛狮吼叫着觅食，","poem":1},{"lineBreak":true},{"text":"寻找上帝所赐的食物。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"太阳升起，","poem":1},{"lineBreak":true},{"text":"百兽便躲避，卧在洞中，","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"人们外出工作，直到黄昏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"耶和华啊，你的创造如此繁多！","poem":1},{"lineBreak":true},{"text":"你用智慧造了这一切，","poem":1},{"lineBreak":true},{"text":"大地充满了你创造的万物。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"汪洋浩瀚，","poem":1},{"lineBreak":true},{"text":"充满了无数的大小水族，","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"船只往来于海上，","poem":1},{"lineBreak":true},{"text":"你造的海怪也在水中嬉戏。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"它们都倚靠你按时供应食物。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你赐下食物，它们才有吃的，","poem":1},{"lineBreak":true},{"text":"你伸手赐下美食，它们才得饱足。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你若掩面不顾它们，","poem":1},{"lineBreak":true},{"text":"它们会惊慌失措。","poem":1},{"lineBreak":true},{"text":"你一收回它们的气息，","poem":1},{"lineBreak":true},{"text":"它们便死亡，归于尘土。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"你一吹气便创造了它们，","poem":1},{"lineBreak":true},{"text":"你使大地焕然一新。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"愿耶和华的荣耀存到永远！","poem":1},{"lineBreak":true},{"text":"愿耶和华以祂的创造为乐！","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"祂一看大地，大地就震动；","poem":1},{"lineBreak":true},{"text":"祂一摸群山，群山就冒烟。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"我要一生一世向耶和华歌唱，","poem":1},{"lineBreak":true},{"text":"我一息尚存就要赞美我的上帝。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"愿祂喜悦我的默想，","poem":1},{"lineBreak":true},{"text":"耶和华是我的喜乐。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"愿罪人从地上消逝，","poem":1},{"lineBreak":true},{"text":"愿恶人荡然无存。","poem":1},{"lineBreak":true},{"text":"我的心啊，要称颂耶和华！","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}