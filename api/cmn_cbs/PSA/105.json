{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":105,"content":[{"type":"heading","content":["上帝和祂的子民"]},{"type":"verse","number":1,"content":[{"text":"你们要称谢耶和华，呼求祂的名，","poem":1},{"lineBreak":true},{"text":"在列邦传扬祂的作为。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要歌颂、赞美祂，","poem":1},{"lineBreak":true},{"text":"述说祂一切奇妙的作为。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要以祂的圣名为荣，","poem":1},{"lineBreak":true},{"text":"愿寻求耶和华的人心中快乐。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"要寻求耶和华和祂的能力，","poem":1},{"lineBreak":true},{"text":"时常来到祂面前。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂仆人亚伯拉罕的后裔啊，","poem":1},{"lineBreak":true},{"text":"祂所拣选的雅各的子孙啊，","poem":1},{"lineBreak":true},{"text":"要记住祂所行的神迹奇事和祂口中的判词。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂是我们的上帝耶和华，","poem":1},{"lineBreak":true},{"text":"祂在普天下施行审判。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂永远记得祂的约，","poem":1},{"lineBreak":true},{"text":"历经千代也不忘祂的应许，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"就是祂与亚伯拉罕所立的约，","poem":1},{"lineBreak":true},{"text":"向以撒所起的誓。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂将这约定为律例赐给雅各，","poem":1},{"lineBreak":true},{"text":"定为永远的约赐给以色列。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂说：“我必把迦南赐给你，","poem":1},{"lineBreak":true},{"text":"作为你的产业。”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"那时他们人丁稀少，寥寥可数，","poem":1},{"lineBreak":true},{"text":"在当地寄居。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他们在异国他乡流离飘零。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华不容人压迫他们，","poem":1},{"lineBreak":true},{"text":"还为他们的缘故责备君王，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"说：“不可加害我膏立的人，","poem":1},{"lineBreak":true},{"text":"也不可伤害我的先知。”","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"祂命饥荒降在那里，","poem":1},{"lineBreak":true},{"text":"断绝一切食物供应。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂派一个人先去，","poem":1},{"lineBreak":true},{"text":"这人就是被卖为奴隶的约瑟。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他被戴上脚镣，套上枷锁，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"直到后来他的预言应验，","poem":1},{"lineBreak":true},{"text":"耶和华的话试炼了他。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"埃及王派人释放他，","poem":1},{"lineBreak":true},{"text":"百姓的首领给他自由，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"派他执掌朝政，","poem":1},{"lineBreak":true},{"text":"管理国中的一切，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"有权柄管束王的大臣，","poem":1},{"lineBreak":true},{"text":"将智慧传授王的长老。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"以色列来到埃及，","poem":1},{"lineBreak":true},{"text":"雅各寄居在含地。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"耶和华使祂的子民生养众多，","poem":1},{"lineBreak":true},{"text":"比他们的仇敌还要强盛。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"祂使仇敌转念憎恨祂的子民，","poem":1},{"lineBreak":true},{"text":"用诡计虐待祂的仆人。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"祂派遣祂的仆人摩西和祂拣选的亚伦，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"在埃及行神迹，","poem":1},{"lineBreak":true},{"text":"在含地行奇事。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"祂使黑暗降下笼罩那里；","poem":1},{"lineBreak":true},{"text":"他们没有违背祂的话。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"祂使埃及的水变成血，","poem":1},{"lineBreak":true},{"text":"鱼都死去；","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"又使国中到处是青蛙，","poem":1},{"lineBreak":true},{"text":"王宫禁院也不能幸免。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"祂一发命令，","poem":1},{"lineBreak":true},{"text":"苍蝇蜂拥而至，虱子遍满全境。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"祂使雨变成冰雹，","poem":1},{"lineBreak":true},{"text":"遍地电光闪闪。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"祂击倒他们的葡萄树和无花果树，","poem":1},{"lineBreak":true},{"text":"摧毁他们境内的树木。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"祂一发声，","poem":1},{"lineBreak":true},{"text":"就飞来无数蝗虫和蚂蚱，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"吃尽他们土地上的植物，","poem":1},{"lineBreak":true},{"text":"吃尽他们田间的出产。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"祂又击杀他们境内所有的长子，","poem":1},{"lineBreak":true},{"text":"就是他们年轻力壮时生的长子。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"祂带领以色列人携金带银地离开埃及，","poem":1},{"lineBreak":true},{"text":"各支派中无人畏缩。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"埃及人惧怕他们，","poem":1},{"lineBreak":true},{"text":"乐见他们离去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"祂铺展云彩为他们遮荫，","poem":1},{"lineBreak":true},{"text":"晚上用火给他们照明。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"他们祈求，","poem":1},{"lineBreak":true},{"text":"祂就赐下鹌鹑，降下天粮，","poem":1},{"lineBreak":true},{"text":"叫他们饱足。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"祂使磐石裂开、涌出水来，","poem":1},{"lineBreak":true},{"text":"在干旱之地奔流成河。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"因为祂顾念祂赐给仆人亚伯拉罕的神圣应许。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"祂带领祂的子民欢然离去，","poem":1},{"lineBreak":true},{"text":"祂所拣选的百姓欢呼前行。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"祂把列国的土地赐给他们，","poem":1},{"lineBreak":true},{"text":"使他们获得别人的劳动成果。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"祂这样做是要使他们持守祂的命令，","poem":1},{"lineBreak":true},{"text":"遵行祂的律法。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":44}