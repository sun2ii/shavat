{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":106,"content":[{"type":"heading","content":["上帝恩待祂的子民"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"要称谢耶和华，","poem":1},{"lineBreak":true},{"text":"因为祂是美善的，","poem":1},{"lineBreak":true},{"text":"祂的慈爱永远长存！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"谁能述说耶和华的大能作为？","poem":1},{"lineBreak":true},{"text":"谁能道尽祂当受赞美之处？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"那些行事公正，","poem":1},{"lineBreak":true},{"text":"持守公义的人有福了。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华啊！","poem":1},{"lineBreak":true},{"text":"你恩待你子民的时候，","poem":1},{"lineBreak":true},{"text":"求你顾念我；","poem":1},{"lineBreak":true},{"text":"你拯救他们的时候，","poem":1},{"lineBreak":true},{"text":"求你帮助我，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"使我看到你所拣选的人繁荣昌盛，","poem":1},{"lineBreak":true},{"text":"与他们同乐，","poem":1},{"lineBreak":true},{"text":"与你的子民一同夸耀。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我们跟祖先一样也犯了罪，","poem":1},{"lineBreak":true},{"text":"行事邪恶。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我们祖先在埃及漠视你奇妙的作为，","poem":1},{"lineBreak":true},{"text":"忘记你向他们屡施慈爱，","poem":1},{"lineBreak":true},{"text":"在红海边反叛你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"但祂为了自己的名拯救了他们，","poem":1},{"lineBreak":true},{"text":"以彰显祂的大能。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂斥责红海，海就干了，","poem":1},{"lineBreak":true},{"text":"祂带领他们走过深渊，","poem":1},{"lineBreak":true},{"text":"如履干地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂救他们脱离敌人的权势，","poem":1},{"lineBreak":true},{"text":"从仇敌的手中救赎了他们。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"海水淹没了敌军，","poem":1},{"lineBreak":true},{"text":"没有一人生还。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"那时他们才相信祂的话，","poem":1},{"lineBreak":true},{"text":"歌唱赞美祂。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"然而，他们很快忘了祂的作为，","poem":1},{"lineBreak":true},{"text":"不愿等候祂的引导。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们在旷野大起贪念，","poem":1},{"lineBreak":true},{"text":"在荒野试探上帝。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂满足了他们的要求，","poem":1},{"lineBreak":true},{"text":"但在他们当中降下了瘟疫。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他们还在营中嫉妒摩西和耶和华的圣仆亚伦。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"大地裂开吞没了大坍，","poem":1},{"lineBreak":true},{"text":"埋葬了亚比兰一伙人。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"火在他们的党羽中烧起，","poem":1},{"lineBreak":true},{"text":"烧灭了这些恶人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他们在何烈山铸造牛犊，祭拜金属偶像，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他们用吃草之牛的铸像代替荣耀的上帝。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们忘记了拯救他们的上帝，","poem":1},{"lineBreak":true},{"text":"祂曾在埃及行奇事，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"在含地行神迹，","poem":1},{"lineBreak":true},{"text":"在红海边行可畏的事。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"因此祂说要消灭他们。","poem":1},{"lineBreak":true},{"text":"若不是祂拣选的摩西站在裂口处向祂求情，","poem":1},{"lineBreak":true},{"text":"祂早已发烈怒毁灭了他们。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他们藐视那佳美之地，","poem":1},{"lineBreak":true},{"text":"不相信祂的应许。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他们在帐篷里发怨言，","poem":1},{"lineBreak":true},{"text":"不听从祂的命令。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因此，祂举手起誓要使他们倒毙在旷野，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"使他们的后代倒在列国，分散到各地。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他们与巴力·毗珥苟合，","poem":1},{"lineBreak":true},{"text":"吃献给假神的祭物。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他们的所作所为触怒耶和华，","poem":1},{"lineBreak":true},{"text":"以致瘟疫降在他们中间。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"那时，非尼哈起来惩罚罪人，","poem":1},{"lineBreak":true},{"text":"瘟疫才停止。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"这就是他的义行，世代永存。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他们在米利巴泉边惹耶和华发怒，","poem":1},{"lineBreak":true},{"text":"连累了摩西。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"因为他们惹摩西发怒，","poem":1},{"lineBreak":true},{"text":"以致他说了鲁莽的话。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"他们没有照耶和华的命令消灭外族人，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"反倒与他们混居，","poem":1},{"lineBreak":true},{"text":"仿效他们的习俗，","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"拜他们的偶像，陷入网罗。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"他们把自己的儿女当祭物献给鬼魔，","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"他们把自己的儿女献给迦南的偶像作祭物，","poem":1},{"lineBreak":true},{"text":"流他们儿女无辜的血，","poem":1},{"lineBreak":true},{"text":"玷污了那地方。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"他们的行为玷污了自己，","poem":1},{"lineBreak":true},{"text":"所作所为使自己沦为淫妇。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"耶和华因此向祂的子民发怒，","poem":1},{"lineBreak":true},{"text":"祂厌恶自己的产业，","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"使他们落在列邦的手中，","poem":1},{"lineBreak":true},{"text":"受敌人的辖制。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"他们的敌人压迫他们，","poem":1},{"lineBreak":true},{"text":"他们被制服在敌人手下。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"祂多次拯救他们，","poem":1},{"lineBreak":true},{"text":"他们却执意背叛，","poem":1},{"lineBreak":true},{"text":"陷入罪中不能自拔。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"但祂听见他们在苦难中呼求时，","poem":1},{"lineBreak":true},{"text":"仍然眷顾他们。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"祂顾念与他们所立的约，","poem":1},{"lineBreak":true},{"text":"凭丰盛的慈爱怜悯他们。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"祂使掳掠他们的人怜悯他们。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"我们的上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你拯救我们，","poem":1},{"lineBreak":true},{"text":"从列国招聚我们，","poem":1},{"lineBreak":true},{"text":"我们好称谢你的圣名，","poem":1},{"lineBreak":true},{"text":"以赞美你为荣。","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"以色列的上帝耶和华永永远远当受称颂。","poem":1},{"lineBreak":true},{"text":"愿众民都说：“阿们！”","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}