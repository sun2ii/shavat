{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":107,"content":[{"type":"heading","content":["称谢上帝的美善"]},{"type":"verse","number":1,"content":[{"text":"你们要称谢耶和华，","poem":1},{"lineBreak":true},{"text":"因为祂是美善的；","poem":1},{"lineBreak":true},{"text":"祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华救赎的人，","poem":1},{"lineBreak":true},{"text":"就是祂从敌人手中救赎出来，","poem":1},{"lineBreak":true},{"text":"从东西南北各个地方招聚的人，","poem":1},{"lineBreak":true},{"text":"都要称谢祂。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们在旷野中飘泊，居无定所，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"又饥又渴，精疲力竭。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们在患难中呼求耶和华，","poem":1},{"lineBreak":true},{"text":"祂便救他们脱离困境，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"带领他们走直路，","poem":1},{"lineBreak":true},{"text":"到可居住的城邑。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们要称谢耶和华的慈爱，","poem":1},{"lineBreak":true},{"text":"称谢祂为世人所行的奇事。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为祂满足干渴的人，","poem":1},{"lineBreak":true},{"text":"以美食喂饱饥饿的人。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"有些人坐在黑暗里，","poem":1},{"lineBreak":true},{"text":"在死亡的阴影下，","poem":1},{"lineBreak":true},{"text":"被铁链捆绑，","poem":1},{"lineBreak":true},{"text":"痛苦不堪，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因为他们违背上帝的话，","poem":1},{"lineBreak":true},{"text":"藐视至高者的旨意。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"所以上帝使他们服苦役，","poem":1},{"lineBreak":true},{"text":"他们跌倒也无人扶助。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"于是，他们在患难中呼求耶和华，","poem":1},{"lineBreak":true},{"text":"祂便救他们脱离困境。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂带领他们脱离黑暗和死亡的阴影，","poem":1},{"lineBreak":true},{"text":"断开他们的锁链。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他们要称谢耶和华的慈爱，","poem":1},{"lineBreak":true},{"text":"称谢祂为世人所行的奇事。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因为祂打碎了铜门，","poem":1},{"lineBreak":true},{"text":"砍断了铁闩。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"有些人因自己的悖逆而愚顽，","poem":1},{"lineBreak":true},{"text":"因自己的罪过而受苦，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"食欲全消，几近死亡。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"于是，他们在患难中呼求耶和华，","poem":1},{"lineBreak":true},{"text":"祂便救他们脱离困境。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"祂一发令，就医治了他们，","poem":1},{"lineBreak":true},{"text":"救他们脱离死亡。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们要称谢耶和华的慈爱，","poem":1},{"lineBreak":true},{"text":"称谢祂为世人所行的奇事。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他们要向祂献上感恩祭，","poem":1},{"lineBreak":true},{"text":"欢然歌颂祂的作为。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"有些人乘船在汪洋大海上经商，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他们看见了耶和华的作为，","poem":1},{"lineBreak":true},{"text":"看见了祂在深海所行的奇事。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"祂一声令下，","poem":1},{"lineBreak":true},{"text":"狂风大作，巨浪滔天。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他们的船只忽而被抛向半空，","poem":1},{"lineBreak":true},{"text":"忽而落入深渊，","poem":1},{"lineBreak":true},{"text":"他们吓得胆战心惊，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"东倒西歪，如同醉汉，","poem":1},{"lineBreak":true},{"text":"束手无策。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"于是，他们在患难中呼求耶和华，","poem":1},{"lineBreak":true},{"text":"祂便救他们脱离困境。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"祂使狂风止息，海浪平静。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他们因风平浪静而欢喜，","poem":1},{"lineBreak":true},{"text":"祂带领他们到所向往的港湾。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他们要称谢耶和华的慈爱，","poem":1},{"lineBreak":true},{"text":"称谢祂为世人所行的奇事。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他们要在众人面前尊崇祂，","poem":1},{"lineBreak":true},{"text":"在长老的聚会中赞美祂。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"祂使江河变成荒漠，","poem":1},{"lineBreak":true},{"text":"水泉变成干地，","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"叫沃土变成荒凉的盐碱地，","poem":1},{"lineBreak":true},{"text":"因为那里的居民邪恶。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"祂叫荒漠水塘遍布，","poem":1},{"lineBreak":true},{"text":"使旱地甘泉涌流。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"祂使饥饿的人住在那里，","poem":1},{"lineBreak":true},{"text":"建造可安居的城邑，","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"耕种田地，栽植葡萄园，","poem":1},{"lineBreak":true},{"text":"收成丰硕。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"祂赐福给他们，","poem":1},{"lineBreak":true},{"text":"使他们人丁兴旺，","poem":1},{"lineBreak":true},{"text":"牲口有增无减。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"后来他们在压迫、患难和痛苦的煎熬下人口减少，","poem":1},{"lineBreak":true},{"text":"地位卑下。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"祂使贵族蒙羞受辱，","poem":1},{"lineBreak":true},{"text":"漂流在荒芜之地。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"但祂搭救贫苦的人脱离苦难，","poem":1},{"lineBreak":true},{"text":"使他们家族兴旺，多如羊群。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"正直人看见就欢喜，","poem":1},{"lineBreak":true},{"text":"邪恶人都哑口无言。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"有智慧的人都要留心这些事，","poem":1},{"lineBreak":true},{"text":"他们要思想耶和华的慈爱。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":42}