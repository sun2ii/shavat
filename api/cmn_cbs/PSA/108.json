{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":108,"content":[{"type":"heading","content":["祈求上帝的帮助"]},{"type":"hebrew_subtitle","content":["大卫的诗歌。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊！我心坚定不移，","poem":1},{"lineBreak":true},{"text":"我要用心灵唱诗歌颂你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"琴瑟啊，醒来吧！","poem":1},{"lineBreak":true},{"text":"我要唤醒黎明！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华啊，我要在列邦称谢你，","poem":1},{"lineBreak":true},{"text":"在列国歌颂你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因为你的慈爱广及诸天，","poem":1},{"lineBreak":true},{"text":"你的信实高达穹苍。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"愿你受的尊崇超过诸天，","poem":1},{"lineBreak":true},{"text":"愿你的荣耀覆盖大地。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你应允我们的祷告，","poem":1},{"lineBreak":true},{"text":"伸出右手拯救我们，","poem":1},{"lineBreak":true},{"text":"使你所爱的人获救。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝在祂的圣所说：","poem":1},{"lineBreak":true},{"text":"“我要欢然划分示剑，丈量疏割谷。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"基列是我的，玛拿西也是我的，","poem":1},{"lineBreak":true},{"text":"以法莲是我的头盔，","poem":1},{"lineBreak":true},{"text":"犹大是我的权杖。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"摩押是我的洗脚盆，","poem":1},{"lineBreak":true},{"text":"我要把鞋扔给以东，","poem":1},{"lineBreak":true},{"text":"我要朝非利士高唱凯歌。”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"谁能带我进入坚固的城池？","poem":1},{"lineBreak":true},{"text":"谁能领我到以东？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝啊，你抛弃了我们吗？","poem":1},{"lineBreak":true},{"text":"上帝啊，你不再和我们的军队一同出战了吗？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你帮助我们攻打仇敌，","poem":1},{"lineBreak":true},{"text":"因为人的帮助徒然无益。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我们依靠上帝才能取胜，","poem":1},{"lineBreak":true},{"text":"祂必践踏我们的敌人。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}