{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":109,"content":[{"type":"heading","content":["患难中的苦诉"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"我所赞美的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你不要沉默不语。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为邪恶和诡诈的人开口攻击我，","poem":1},{"lineBreak":true},{"text":"用撒谎的舌头毁谤我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们对我恶语相向，","poem":1},{"lineBreak":true},{"text":"无缘无故地攻击我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我爱他们，他们却控告我，","poem":1},{"lineBreak":true},{"text":"但我专心祷告。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们对我以恶报善，","poem":1},{"lineBreak":true},{"text":"以恨报爱。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你差恶人攻击我的仇敌，","poem":1},{"lineBreak":true},{"text":"派对头站在他右边控告他。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"当他受审时，","poem":1},{"lineBreak":true},{"text":"愿他被判为有罪，","poem":1},{"lineBreak":true},{"text":"他的祷告也算为罪过。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愿他的年日短少，","poem":1},{"lineBreak":true},{"text":"愿别人取代他的职位。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愿他的孩子失去父亲，","poem":1},{"lineBreak":true},{"text":"妻子成为寡妇。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"愿他的孩子流浪行乞，","poem":1},{"lineBreak":true},{"text":"被赶出自己破败的家。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"愿债主夺取他所有的财产，","poem":1},{"lineBreak":true},{"text":"陌生人抢走他的劳动成果。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"愿无人向他施恩，","poem":1},{"lineBreak":true},{"text":"无人同情他的孤儿。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"愿他断子绝孙，","poem":1},{"lineBreak":true},{"text":"他的姓氏传不到下一代。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"愿耶和华记住他祖辈的罪恶，","poem":1},{"lineBreak":true},{"text":"不除去他母亲的罪过。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愿耶和华永不忘记他的罪恶，","poem":1},{"lineBreak":true},{"text":"把他的名号从世上铲除。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因为他毫无仁慈，","poem":1},{"lineBreak":true},{"text":"迫害困苦、贫穷和伤心的人，","poem":1},{"lineBreak":true},{"text":"置他们于死地。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他喜欢咒诅人，","poem":1},{"lineBreak":true},{"text":"愿咒诅临到他；","poem":1},{"lineBreak":true},{"text":"他不喜欢祝福人，","poem":1},{"lineBreak":true},{"text":"愿祝福远离他。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他咒诅成性，","poem":1},{"lineBreak":true},{"text":"愿咒诅如水侵入他的身体，","poem":1},{"lineBreak":true},{"text":"如油浸透他的骨头。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"愿咒诅不离其身，","poem":1},{"lineBreak":true},{"text":"如同身上的衣服和腰间的带子。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"愿耶和华这样报应那些控告我，","poem":1},{"lineBreak":true},{"text":"以恶言攻击我的人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"主耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你因自己的名恩待我，","poem":1},{"lineBreak":true},{"text":"因你的美善和慈爱拯救我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为我贫穷困苦，","poem":1},{"lineBreak":true},{"text":"内心饱受创伤。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我像黄昏的日影一样消逝，","poem":1},{"lineBreak":true},{"text":"如蝗虫一般被抖落。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"禁食使我双腿发软，","poem":1},{"lineBreak":true},{"text":"瘦骨嶙峋。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"仇敌都嘲笑我，","poem":1},{"lineBreak":true},{"text":"他们看见我就连连摇头。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我的上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你帮助我，施慈爱拯救我，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"让他们知道这是你的作为，","poem":1},{"lineBreak":true},{"text":"你耶和华行了此事。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"任凭他们咒诅吧，","poem":1},{"lineBreak":true},{"text":"你必赐福给我。","poem":1},{"lineBreak":true},{"text":"攻击我的人必蒙羞，","poem":1},{"lineBreak":true},{"text":"但你的仆人必欢喜。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"愿控告我的人满面羞辱，","poem":1},{"lineBreak":true},{"text":"愿他们浑身被耻辱包裹。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我要竭力颂扬耶和华，","poem":1},{"lineBreak":true},{"text":"在人群中赞美祂。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"因为祂保护贫穷的人，","poem":1},{"lineBreak":true},{"text":"救他们脱离定他们死罪的人。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}