pe":"verse","number":7,"content":[{"lineBreak":true},{"text":"因为耶和华是公义的，","poem":1},{"lineBreak":true},{"text":"祂喜爱公义。","poem":1},{"lineBreak":true},{"text":"正直的人必见祂的面。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}