{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":110,"content":[{"type":"heading","content":["上帝和祂拣选的王"]},{"type":"hebrew_subtitle","content":["大卫的诗歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和华对我主说：","poem":1},{"lineBreak":true},{"text":"“你坐在我的右边，","poem":1},{"lineBreak":true},{"text":"等我使你的仇敌成为你的脚凳。”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华必从锡安扩展你的王权，","poem":1},{"lineBreak":true},{"text":"你要在众仇敌中掌权。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你跟仇敌作战的时候，","poem":1},{"lineBreak":true},{"text":"你的百姓必甘心跟从，","poem":1},{"lineBreak":true},{"text":"他们衣着圣洁，","poem":1},{"lineBreak":true},{"text":"如清晨的甘露。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华起了誓，绝不反悔，","poem":1},{"lineBreak":true},{"text":"祂说：“你照麦基洗德的模式永远做祭司。”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"主在你右边保护你，","poem":1},{"lineBreak":true},{"text":"祂发怒的时候，必毁灭列王。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂要审判列国，","poem":1},{"lineBreak":true},{"text":"使列国尸横遍野。","poem":1},{"lineBreak":true},{"text":"祂要毁灭世上的首领。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂要喝路旁的溪水，","poem":1},{"lineBreak":true},{"text":"祂必精神抖擞。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}