{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":111,"content":[{"type":"heading","content":["赞美上帝"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"在正直人的大会及会众中，","poem":1},{"lineBreak":true},{"text":"我要全心称谢耶和华。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华的作为伟大，","poem":1},{"lineBreak":true},{"text":"所有喜欢的人都必思想。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂的作为荣耀威严，","poem":1},{"lineBreak":true},{"text":"祂的公义永远长存。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂使人铭记祂奇妙的作为。","poem":1},{"lineBreak":true},{"text":"耶和华有恩典、好怜悯。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂赐下粮食给那些敬畏祂的人，","poem":1},{"lineBreak":true},{"text":"祂永不忘记自己的约。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂向子民彰显大能的作为，","poem":1},{"lineBreak":true},{"text":"把列国的土地赐给他们。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂凭信实和公正行事，","poem":1},{"lineBreak":true},{"text":"祂一切的法则都可靠，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"是凭信实和正直赐下的，","poem":1},{"lineBreak":true},{"text":"存到永永远远。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂救赎了自己的子民，","poem":1},{"lineBreak":true},{"text":"立了永远的约，","poem":1},{"lineBreak":true},{"text":"祂的名神圣可畏。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"智慧始于敬畏耶和华，","poem":1},{"lineBreak":true},{"text":"遵行祂命令者皆明睿。","poem":1},{"lineBreak":true},{"text":"祂永远当受赞美。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}