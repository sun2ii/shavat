{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":112,"content":[{"type":"heading","content":["敬畏上帝者必蒙福"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"敬畏耶和华、热爱祂命令的人有福了！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他的子孙在世上必兴盛，","poem":1},{"lineBreak":true},{"text":"正直人的后代必蒙福。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他的家财丰厚，","poem":1},{"lineBreak":true},{"text":"他的公义永远长存。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"黑暗中必有光照亮正直人，","poem":1},{"lineBreak":true},{"text":"照亮有恩慈、好怜悯、行公义的人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"慷慨借贷，","poem":1},{"lineBreak":true},{"text":"行事公正的人必亨通。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"义人必永不动摇，","poem":1},{"lineBreak":true},{"text":"他必永得眷顾。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他不怕恶讯，","poem":1},{"lineBreak":true},{"text":"他一心信靠耶和华。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他心里笃定，毫不害怕，","poem":1},{"lineBreak":true},{"text":"他终必战胜仇敌。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他慷慨施舍，周济穷人；","poem":1},{"lineBreak":true},{"text":"他的公义永远长存；","poem":1},{"lineBreak":true},{"text":"他的角被高举，得享尊荣。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"恶人见状恼怒不已，","poem":1},{"lineBreak":true},{"text":"他咬牙切齿地死去。","poem":1},{"lineBreak":true},{"text":"恶人的盼望必破灭。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}