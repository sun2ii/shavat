{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":113,"content":[{"type":"heading","content":["赞美上帝的美善"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"耶和华的仆人啊，","poem":1},{"lineBreak":true},{"text":"你们要赞美，赞美耶和华的名。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿耶和华的名受称颂，","poem":1},{"lineBreak":true},{"text":"从现在直到永远！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"从日出之地到日落之处，","poem":1},{"lineBreak":true},{"text":"普世都应当赞美耶和华的名。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华高居万国之上，","poem":1},{"lineBreak":true},{"text":"祂的荣耀高过诸天。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"谁能与我们的上帝耶和华相比？","poem":1},{"lineBreak":true},{"text":"祂坐在至高之处，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"俯视诸天和大地。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂从灰尘中提拔贫穷人，","poem":1},{"lineBreak":true},{"text":"从粪堆中提升困苦人，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"使他们与王子同坐，","poem":1},{"lineBreak":true},{"text":"与本国的王子同坐。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂使不育的妇人安居家中，","poem":1},{"lineBreak":true},{"text":"成为快乐的母亲。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}