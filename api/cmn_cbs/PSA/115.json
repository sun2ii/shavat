{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":115,"content":[{"type":"heading","content":["上帝是独一真神"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"不要将荣耀归于我们，","poem":1},{"lineBreak":true},{"text":"不要归于我们。","poem":1},{"lineBreak":true},{"text":"荣耀归于你的名，","poem":1},{"lineBreak":true},{"text":"因为你慈爱、信实！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"为何让列国说","poem":1},{"lineBreak":true},{"text":"“他们的上帝在哪里”？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我们的上帝高居在天，","poem":1},{"lineBreak":true},{"text":"按自己的旨意行事。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们的偶像是人用金银造的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"它们有口不能言，有眼不能看，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"有耳不能听，有鼻不能闻，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"有手不能摸，有脚不能走，","poem":1},{"lineBreak":true},{"text":"有喉咙也不能发声。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"造偶像的必和偶像一样，","poem":1},{"lineBreak":true},{"text":"信靠偶像的人也是如此。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"以色列人啊，要信靠耶和华！","poem":1},{"lineBreak":true},{"text":"祂是你们的帮助，","poem":1},{"lineBreak":true},{"text":"是你们的盾牌。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"亚伦家啊，要信靠耶和华！","poem":1},{"lineBreak":true},{"text":"祂是你们的帮助，","poem":1},{"lineBreak":true},{"text":"是你们的盾牌。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"敬畏耶和华的人啊，要信靠祂！","poem":1},{"lineBreak":true},{"text":"祂是你们的帮助，","poem":1},{"lineBreak":true},{"text":"是你们的盾牌。","poem":1},{"noteId":9}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华顾念我们，赐福给我们。","poem":1},{"lineBreak":true},{"text":"祂要赐福给以色列人，","poem":1},{"lineBreak":true},{"text":"赐福给亚伦家。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华要赐福给一切敬畏祂的人，","poem":1},{"lineBreak":true},{"text":"不分尊贵卑贱。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"愿耶和华使你们和你们的后代人丁兴旺！","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愿创造天地的耶和华赐福给你们！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"高天属于耶和华，","poem":1},{"lineBreak":true},{"text":"但祂把大地赐给了世人。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"死人不能颂赞耶和华，","poem":1},{"lineBreak":true},{"text":"下坟墓的人不能赞美祂。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"但我们要赞美耶和华，","poem":1},{"lineBreak":true},{"text":"从现在直到永远。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"平行经文：诗篇135:15‑20。","reference":{"chapter":115,"verse":11}}]},"thisChapterLink":"/api/cmn_cbs/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}