{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":116,"content":[{"type":"heading","content":["感谢拯救之恩"]},{"type":"verse","number":1,"content":[{"text":"我爱耶和华，","poem":1},{"lineBreak":true},{"text":"因为祂垂听了我的呼求和祷告。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为祂侧耳听我的祈求，","poem":1},{"lineBreak":true},{"text":"我一生都要求告祂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"死亡的绳索缠绕我，","poem":1},{"lineBreak":true},{"text":"阴间的恐怖笼罩我，","poem":1},{"lineBreak":true},{"text":"我陷入困苦和忧愁。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"于是，我求告耶和华的名，","poem":1},{"lineBreak":true},{"text":"说：“耶和华啊，求你救我。”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华仁慈、公义，","poem":1},{"lineBreak":true},{"text":"我们的上帝充满怜悯。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华保护心地单纯的人，","poem":1},{"lineBreak":true},{"text":"危难之时祂拯救了我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的心啊，恢复安宁吧，","poem":1},{"lineBreak":true},{"text":"因为耶和华恩待你。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂救我的性命脱离死亡，","poem":1},{"lineBreak":true},{"text":"止住我眼中的泪水，","poem":1},{"lineBreak":true},{"text":"使我双脚免于滑倒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我要在世上事奉耶和华。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我相信，所以才说：","poem":1},{"lineBreak":true},{"text":"“我受尽了痛苦。”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我曾惊恐地说：","poem":1},{"lineBreak":true},{"text":"“人人都说谎。”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我拿什么报答耶和华赐给我的一切恩惠呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我要因耶和华的拯救之恩举杯称颂祂的名。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我要在耶和华的子民面前还我向祂许的愿。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"耶和华的眼目顾惜祂圣民的存亡。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华啊！我是你的仆人，","poem":1},{"lineBreak":true},{"text":"是你的仆人，是你婢女的儿子。","poem":1},{"lineBreak":true},{"text":"你除去了我的锁链。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我要向你献上感恩祭，","poem":1},{"lineBreak":true},{"text":"求告耶和华的名。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要在耶路撒冷，","poem":1},{"lineBreak":true},{"text":"在耶和华的殿中，","poem":1},{"lineBreak":true},{"text":"在耶和华的子民面前还我向祂许的愿。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":18}