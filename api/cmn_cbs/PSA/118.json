{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":118,"content":[{"type":"heading","content":["为胜利而感恩"]},{"type":"verse","number":1,"content":[{"text":"你们要称谢耶和华，","poem":1},{"lineBreak":true},{"text":"因为祂是美善的，","poem":1},{"lineBreak":true},{"text":"祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿以色列人说：","poem":1},{"lineBreak":true},{"text":"“祂的慈爱永远长存。”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愿亚伦家说：","poem":1},{"lineBreak":true},{"text":"“祂的慈爱永远长存。”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"愿那些敬畏耶和华的人说：","poem":1},{"lineBreak":true},{"text":"“祂的慈爱永远长存。”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我在苦难中求告耶和华，","poem":1},{"lineBreak":true},{"text":"祂就答应我，救我脱离困境。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"有耶和华与我同在，","poem":1},{"lineBreak":true},{"text":"我必不惧怕，","poem":1},{"lineBreak":true},{"text":"人能把我怎么样？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华与我同在，帮助我，","poem":1},{"lineBreak":true},{"text":"我必看见那些恨我的人一败涂地。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"投靠耶和华胜过倚靠人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"投靠耶和华胜过倚靠权贵。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"列国围住我，","poem":1},{"lineBreak":true},{"text":"但我靠着耶和华的名消灭了他们。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们四面围住我，","poem":1},{"lineBreak":true},{"text":"但我靠着耶和华的名消灭了他们。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们如蜜蜂围住我，","poem":1},{"lineBreak":true},{"text":"然而他们必像燃烧的荆棘，","poem":1},{"lineBreak":true},{"text":"转瞬消逝；","poem":1},{"lineBreak":true},{"text":"我靠着耶和华的名消灭了他们。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我受到猛烈的攻击，","poem":1},{"lineBreak":true},{"text":"几乎要倒下了，","poem":1},{"lineBreak":true},{"text":"但耶和华帮助了我。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华是我的力量，","poem":1},{"lineBreak":true},{"text":"是我的诗歌；","poem":1},{"lineBreak":true},{"text":"祂拯救了我。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"义人的帐篷里传出胜利的欢呼声：","poem":1},{"lineBreak":true},{"text":"“耶和华用右手施展大能！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华高举右手，","poem":1},{"lineBreak":true},{"text":"耶和华用右手施展大能！”","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我必不至于死，","poem":1},{"lineBreak":true},{"text":"我要活着，","poem":1},{"lineBreak":true},{"text":"并要述说耶和华的作为。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和华虽然重重地惩罚我，","poem":1},{"lineBreak":true},{"text":"却没有置我于死地。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"给我打开公义的门吧，","poem":1},{"lineBreak":true},{"text":"我要进去称谢耶和华。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"这是耶和华的门，","poem":1},{"lineBreak":true},{"text":"义人都可以进去。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和华啊！我称谢你，","poem":1},{"lineBreak":true},{"text":"因为你应允了我的祷告，","poem":1},{"lineBreak":true},{"text":"拯救了我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"工匠丢弃的石头已成了房角石。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"这是耶和华的作为，","poem":1},{"lineBreak":true},{"text":"在我们看来奇妙莫测。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"这是耶和华得胜的日子，","poem":1},{"lineBreak":true},{"text":"我们要欢喜快乐。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"耶和华啊，求你拯救我们；","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你使我们亨通。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"奉耶和华之名来的当受称颂！","poem":1},{"lineBreak":true},{"text":"我们要在耶和华的殿中祝福你们。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"耶和华是上帝，","poem":1},{"lineBreak":true},{"text":"祂的光照亮我们。","poem":1},{"lineBreak":true},{"text":"要用绳索拴住祭牲，","poem":1},{"lineBreak":true},{"text":"牵到祭坛的角那里。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你是我的上帝，我要称谢你；","poem":1},{"lineBreak":true},{"text":"你是我的上帝，我要尊崇你。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你们要称谢耶和华，","poem":1},{"lineBreak":true},{"text":"因为祂是美善的，","poem":1},{"lineBreak":true},{"text":"祂的慈爱永远长存。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}