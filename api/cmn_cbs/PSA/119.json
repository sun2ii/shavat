{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":119,"content":[{"type":"heading","content":["耶和华的律法"]},{"type":"verse","number":1,"content":[{"text":"行为正直、遵行耶和华律法的人有福了！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"遵守祂的法度、全心寻求祂的人有福了！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们不做不义之事，","poem":1},{"lineBreak":true},{"text":"只遵行祂的旨意。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华啊，你已经赐下法则，","poem":1},{"lineBreak":true},{"text":"为了让我们竭力遵行。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我渴望坚定地遵从你的律例。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我重视你的一切命令，","poem":1},{"lineBreak":true},{"text":"便不致羞愧。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我学习你公义的法令时，","poem":1},{"lineBreak":true},{"text":"要存着正直的心来称谢你。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我要遵守你的律例，","poem":1},{"lineBreak":true},{"text":"求你不要完全弃绝我。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"青年如何保持纯洁呢？","poem":1},{"lineBreak":true},{"text":"就是要遵行你的话。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我全心寻求你，","poem":1},{"lineBreak":true},{"text":"求你不要让我偏离你的命令。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我把你的话珍藏在心中，","poem":1},{"lineBreak":true},{"text":"免得我得罪你。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华啊，你当受称颂！","poem":1},{"lineBreak":true},{"text":"求你将你的律例教导我。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我宣扬你口中所出的一切法令。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我喜爱你的法度如同人喜爱财富。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要默想你的法则，","poem":1},{"lineBreak":true},{"text":"思想你的旨意。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我以遵行你的律例为乐，","poem":1},{"lineBreak":true},{"text":"我不忘记你的话语。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"求你以厚恩待你仆人，","poem":1},{"lineBreak":true},{"text":"使我能活着，并遵守你的话语。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你开我的眼睛，","poem":1},{"lineBreak":true},{"text":"使我能明白你律法中的奥妙。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我在世上是过客，","poem":1},{"lineBreak":true},{"text":"求你不要向我隐藏你的命令。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我时刻切慕你的法令，","poem":1},{"lineBreak":true},{"text":"以致心力憔悴。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你斥责受咒诅、偏离你命令的狂傲人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"求你除去我所受的羞辱和藐视，","poem":1},{"lineBreak":true},{"text":"因为我遵从你的法度。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"虽然权贵们坐着毁谤我，","poem":1},{"lineBreak":true},{"text":"仆人仍要默想你的律例。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你的法度是我的喜乐，","poem":1},{"lineBreak":true},{"text":"是我的谋士。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我的性命几乎坠入尘埃，","poem":1},{"lineBreak":true},{"text":"求你凭应许保全我性命。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我陈明自己的行为，","poem":1},{"lineBreak":true},{"text":"你就回应了我；","poem":1},{"lineBreak":true},{"text":"求你将你的律例教导我。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"求你使我明白你的法则，","poem":1},{"lineBreak":true},{"text":"我要默想你的奇妙作为。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我伤心欲绝，","poem":1},{"lineBreak":true},{"text":"求你照你的应许使我坚强起来。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"求你使我远离奸诈之路，","poem":1},{"lineBreak":true},{"text":"开恩将你的律法教导我。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我已经选择了真理之路，","poem":1},{"lineBreak":true},{"text":"决心遵行你的法令。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"我持守你的法度，耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你不要使我蒙羞。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我竭力遵守你的命令，","poem":1},{"lineBreak":true},{"text":"因为你拓宽我的悟性。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"耶和华啊，求你将你的律例教导我，","poem":1},{"lineBreak":true},{"text":"我必遵守到底。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"求你赐我悟性，使我遵守你的律法，","poem":1},{"lineBreak":true},{"text":"并且全心遵守。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"求你引导我遵行你的命令，","poem":1},{"lineBreak":true},{"text":"因为这是我喜爱的。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"求你使我的心向往你的法度，","poem":1},{"lineBreak":true},{"text":"而非不义之财。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"求你使我的眼目远离虚空之事，","poem":1},{"lineBreak":true},{"text":"按你的旨意保全我性命。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"求你实现你给仆人的应许，","poem":1},{"lineBreak":true},{"text":"就是你给敬畏你之人的应许。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"求你除去我所害怕的羞辱，","poem":1},{"lineBreak":true},{"text":"因为你的法令是美善的。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"我渴望遵行你的法则，","poem":1},{"lineBreak":true},{"text":"求你按你的公义保全我性命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"耶和华啊！","poem":1},{"lineBreak":true},{"text":"愿你的慈爱临到我，","poem":1},{"lineBreak":true},{"text":"愿你的拯救临到我，","poem":1},{"lineBreak":true},{"text":"正如你的应许，","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"好叫我能应对嘲笑我的人，","poem":1},{"lineBreak":true},{"text":"因为我信靠你的话。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"断不要从我口中拿走真理之言，","poem":1},{"lineBreak":true},{"text":"因为你的法令是我的盼望。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"我要持守你的律法，","poem":1},{"lineBreak":true},{"text":"直到永永远远。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"我要自由地生活，","poem":1},{"lineBreak":true},{"text":"因为我寻求你的法则。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"我要在君王面前讲论你的法度，","poem":1},{"lineBreak":true},{"text":"我不以此为耻。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"我以遵行你的命令为乐，","poem":1},{"lineBreak":true},{"text":"我喜爱你的命令。","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"我尊崇你的命令，","poem":1},{"lineBreak":true},{"text":"我喜爱你的命令，","poem":1},{"lineBreak":true},{"text":"我要默想你的律例。","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"求你顾念你对仆人的应许，","poem":1},{"lineBreak":true},{"text":"你的话带给我盼望。","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"你的应许保全我性命，","poem":1},{"lineBreak":true},{"text":"是我患难中的安慰。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"狂傲人肆意嘲讽我，","poem":1},{"lineBreak":true},{"text":"但我仍然没有偏离你的律法。","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"我牢记你古时赐下的法令，","poem":1},{"lineBreak":true},{"text":"你的法令是我的安慰。","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"我见恶人丢弃你的律法，","poem":1},{"lineBreak":true},{"text":"就怒火中烧。","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"我在世上寄居，","poem":1},{"lineBreak":true},{"text":"你的律例就是我的诗歌。","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"耶和华啊，我在夜间思想你的名，","poem":1},{"lineBreak":true},{"text":"我要遵守你的律法。","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"我向来遵行你的法则。","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"耶和华啊，你是我的福分！","poem":1},{"lineBreak":true},{"text":"我决心遵行你的话语。","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"我一心求你施恩，","poem":1},{"lineBreak":true},{"text":"求你照着你的应许恩待我。","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"我思想自己走过的路，","poem":1},{"lineBreak":true},{"text":"就移步归向你的法度。","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"我毫不迟疑地遵守你的命令。","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"虽然恶人用绳索捆绑我，","poem":1},{"lineBreak":true},{"text":"我仍不忘记你的律法。","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"因为你公义的法令，","poem":1},{"lineBreak":true},{"text":"我半夜起来称谢你。","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"我与所有敬畏你、遵守你法则的人为友。","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"耶和华啊，你的慈爱充满大地，","poem":1},{"lineBreak":true},{"text":"求你将你的律例教导我。","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"你信守诺言，善待了仆人。","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"求你赐我知识，教我判别是非，","poem":1},{"lineBreak":true},{"text":"因为我信靠你的命令。","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"从前我没有受苦的时候走迷了路，","poem":1},{"lineBreak":true},{"text":"现在我要遵行你的话。","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"你是美善的，","poem":1},{"lineBreak":true},{"text":"你所行的都是美善的，","poem":1},{"lineBreak":true},{"text":"求你将你的律例教导我。","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"傲慢人毁谤我，","poem":1},{"lineBreak":true},{"text":"但我一心遵守你的法则。","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"他们执迷不悟，","poem":1},{"lineBreak":true},{"text":"但我喜爱你的律法。","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"我受苦对我有益，","poem":1},{"lineBreak":true},{"text":"使我可以学习你的律例。","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"你颁布的律法对我而言比千万金银更宝贵。","poem":1}]},{"type":"verse","number":73,"content":[{"lineBreak":true},{"text":"你亲手造我、塑我，","poem":1},{"lineBreak":true},{"text":"求你赐我悟性来学习你的命令。","poem":1}]},{"type":"verse","number":74,"content":[{"lineBreak":true},{"text":"敬畏你的人见我就欢喜，","poem":1},{"lineBreak":true},{"text":"因为你的话是我的盼望。","poem":1}]},{"type":"verse","number":75,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"我知道你的法令公义，","poem":1},{"lineBreak":true},{"text":"你是凭信实管教我。","poem":1}]},{"type":"verse","number":76,"content":[{"lineBreak":true},{"text":"求你照着你给仆人的应许，","poem":1},{"lineBreak":true},{"text":"用你的慈爱来安慰我。","poem":1}]},{"type":"verse","number":77,"content":[{"lineBreak":true},{"text":"求你怜悯我，使我可以存活，","poem":1},{"lineBreak":true},{"text":"因为你的律法是我的喜乐。","poem":1}]},{"type":"verse","number":78,"content":[{"lineBreak":true},{"text":"愿狂傲人受辱，","poem":1},{"lineBreak":true},{"text":"因他们诋毁我；","poem":1},{"lineBreak":true},{"text":"但我要默想你的法则。","poem":1}]},{"type":"verse","number":79,"content":[{"lineBreak":true},{"text":"愿敬畏你的人到我这里来，","poem":1},{"lineBreak":true},{"text":"好明白你的法度。","poem":1}]},{"type":"verse","number":80,"content":[{"lineBreak":true},{"text":"愿我能全心遵守你的律例，","poem":1},{"lineBreak":true},{"text":"使我不致羞愧。","poem":1}]},{"type":"verse","number":81,"content":[{"lineBreak":true},{"text":"我的心迫切渴慕你的拯救，","poem":1},{"lineBreak":true},{"text":"你的话是我的盼望。","poem":1}]},{"type":"verse","number":82,"content":[{"lineBreak":true},{"text":"我期盼你的应许实现，","poem":1},{"lineBreak":true},{"text":"望眼欲穿。","poem":1},{"lineBreak":true},{"text":"我说：“你何时才安慰我？”","poem":1}]},{"type":"verse","number":83,"content":[{"lineBreak":true},{"text":"我形容枯槁，好像烟熏的皮袋，","poem":1},{"lineBreak":true},{"text":"但我仍然没有忘记你的律例。","poem":1}]},{"type":"verse","number":84,"content":[{"lineBreak":true},{"text":"你仆人还要等候多久呢？","poem":1},{"lineBreak":true},{"text":"你何时才会惩罚那些迫害我的人呢？","poem":1}]},{"type":"verse","number":85,"content":[{"lineBreak":true},{"text":"违背你律法的狂傲人挖陷阱害我。","poem":1}]},{"type":"verse","number":86,"content":[{"lineBreak":true},{"text":"你的一切命令都可靠，","poem":1},{"lineBreak":true},{"text":"他们无故地迫害我，","poem":1},{"lineBreak":true},{"text":"求你帮助我。","poem":1}]},{"type":"verse","number":87,"content":[{"lineBreak":true},{"text":"他们几乎置我于死地，","poem":1},{"lineBreak":true},{"text":"但我仍然没有背弃你的法则。","poem":1}]},{"type":"verse","number":88,"content":[{"lineBreak":true},{"text":"求你施慈爱保全我性命，","poem":1},{"lineBreak":true},{"text":"我好遵守你颁布的法度。","poem":1}]},{"type":"verse","number":89,"content":[{"lineBreak":true},{"text":"耶和华啊，你的话立定在天，","poem":1},{"lineBreak":true},{"text":"永远不变。","poem":1}]},{"type":"verse","number":90,"content":[{"lineBreak":true},{"text":"你的信实万代长存；","poem":1},{"lineBreak":true},{"text":"你奠定大地，它恒久不变。","poem":1}]},{"type":"verse","number":91,"content":[{"lineBreak":true},{"text":"天地照你的法令存到今日，","poem":1},{"lineBreak":true},{"text":"因为万物都是你的仆役。","poem":1}]},{"type":"verse","number":92,"content":[{"lineBreak":true},{"text":"我若不以你的律法为乐，","poem":1},{"lineBreak":true},{"text":"早已死在苦难中了。","poem":1}]},{"type":"verse","number":93,"content":[{"lineBreak":true},{"text":"我永不忘记你的法则，","poem":1},{"lineBreak":true},{"text":"因你借此保全我性命。","poem":1}]},{"type":"verse","number":94,"content":[{"lineBreak":true},{"text":"我属于你，求你拯救我，","poem":1},{"lineBreak":true},{"text":"因为我寻求你的法则。","poem":1}]},{"type":"verse","number":95,"content":[{"lineBreak":true},{"text":"恶人伺机害我，","poem":1},{"lineBreak":true},{"text":"但我仍然思想你的法度。","poem":1}]},{"type":"verse","number":96,"content":[{"lineBreak":true},{"text":"我看到万事都有尽头，","poem":1},{"lineBreak":true},{"text":"唯有你的命令无边无界。","poem":1}]},{"type":"verse","number":97,"content":[{"lineBreak":true},{"text":"我多么爱慕你的律法，","poem":1},{"lineBreak":true},{"text":"终日默想。","poem":1}]},{"type":"verse","number":98,"content":[{"lineBreak":true},{"text":"你的命令常在我心中，","poem":1},{"lineBreak":true},{"text":"它使我比仇敌有智慧。","poem":1}]},{"type":"verse","number":99,"content":[{"lineBreak":true},{"text":"我比所有老师更有洞见，","poem":1},{"lineBreak":true},{"text":"因为我默想你的法度。","poem":1}]},{"type":"verse","number":100,"content":[{"lineBreak":true},{"text":"我比长者更明智，","poem":1},{"lineBreak":true},{"text":"因为我遵守你的法则。","poem":1}]},{"type":"verse","number":101,"content":[{"lineBreak":true},{"text":"为了遵行你的话，","poem":1},{"lineBreak":true},{"text":"我拒绝走恶道。","poem":1}]},{"type":"verse","number":102,"content":[{"lineBreak":true},{"text":"我没有偏离你的法令，","poem":1},{"lineBreak":true},{"text":"因为你教导过我。","poem":1}]},{"type":"verse","number":103,"content":[{"lineBreak":true},{"text":"你的话在我上颚何等甘美，","poem":1},{"lineBreak":true},{"text":"在我口中比蜜还甜。","poem":1}]},{"type":"verse","number":104,"content":[{"lineBreak":true},{"text":"我从你的法则中得到智慧，","poem":1},{"lineBreak":true},{"text":"因此我厌恶一切诡诈之道。","poem":1}]},{"type":"verse","number":105,"content":[{"lineBreak":true},{"text":"你的话是我脚前的灯，","poem":1},{"lineBreak":true},{"text":"是我路上的光。","poem":1}]},{"type":"verse","number":106,"content":[{"lineBreak":true},{"text":"我已起誓，我必信守诺言：","poem":1},{"lineBreak":true},{"text":"我要遵行你公义的法令。","poem":1}]},{"type":"verse","number":107,"content":[{"lineBreak":true},{"text":"我饱受痛苦，耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你照你的话保全我性命。","poem":1}]},{"type":"verse","number":108,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你悦纳我由衷的赞美，","poem":1},{"lineBreak":true},{"text":"将你的法令教导我。","poem":1}]},{"type":"verse","number":109,"content":[{"lineBreak":true},{"text":"我的生命时刻面临危险，","poem":1},{"lineBreak":true},{"text":"但我不会忘记你的律法。","poem":1}]},{"type":"verse","number":110,"content":[{"lineBreak":true},{"text":"恶人为我设下网罗，","poem":1},{"lineBreak":true},{"text":"但我没有偏离你的法则。","poem":1}]},{"type":"verse","number":111,"content":[{"lineBreak":true},{"text":"你的法度永远是我的宝贵产业，","poem":1},{"lineBreak":true},{"text":"是我心中的喜乐。","poem":1}]},{"type":"verse","number":112,"content":[{"lineBreak":true},{"text":"我决心遵行你的律例，","poem":1},{"lineBreak":true},{"text":"一直到底。","poem":1}]},{"type":"verse","number":113,"content":[{"lineBreak":true},{"text":"我厌恶心怀二意的人，","poem":1},{"lineBreak":true},{"text":"我喜爱你的律法。","poem":1}]},{"type":"verse","number":114,"content":[{"lineBreak":true},{"text":"你是我的藏身之所，","poem":1},{"lineBreak":true},{"text":"是我的盾牌，","poem":1},{"lineBreak":true},{"text":"你的话语是我的盼望。","poem":1}]},{"type":"verse","number":115,"content":[{"lineBreak":true},{"text":"你们这些恶人离开我吧，","poem":1},{"lineBreak":true},{"text":"我要遵行我上帝的命令。","poem":1}]},{"type":"verse","number":116,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你按你的应许扶持我，","poem":1},{"lineBreak":true},{"text":"使我存活，","poem":1},{"lineBreak":true},{"text":"不要使我的盼望落空。","poem":1}]},{"type":"verse","number":117,"content":[{"lineBreak":true},{"text":"求你扶持我，使我得救，","poem":1},{"lineBreak":true},{"text":"我要时刻关注你的律例。","poem":1}]},{"type":"verse","number":118,"content":[{"lineBreak":true},{"text":"你弃绝一切偏离你律例的人，","poem":1},{"lineBreak":true},{"text":"他们的诡计无法得逞。","poem":1}]},{"type":"verse","number":119,"content":[{"lineBreak":true},{"text":"你铲除世上的恶人，","poem":1},{"lineBreak":true},{"text":"如同除掉渣滓，","poem":1},{"lineBreak":true},{"text":"因此我喜爱你的法度。","poem":1}]},{"type":"verse","number":120,"content":[{"lineBreak":true},{"text":"我因敬畏你而战栗","poem":1},{"lineBreak":true},{"text":"我惧怕你的法令。","poem":1}]},{"type":"verse","number":121,"content":[{"lineBreak":true},{"text":"我做事公平正直，","poem":1},{"lineBreak":true},{"text":"求你不要把我交给欺压我的人。","poem":1}]},{"type":"verse","number":122,"content":[{"lineBreak":true},{"text":"求你保障仆人的福祉，","poem":1},{"lineBreak":true},{"text":"不要让傲慢的人欺压我。","poem":1}]},{"type":"verse","number":123,"content":[{"lineBreak":true},{"text":"我望眼欲穿地期盼你拯救我，","poem":1},{"lineBreak":true},{"text":"盼望你实现你公义的应许。","poem":1}]},{"type":"verse","number":124,"content":[{"lineBreak":true},{"text":"求你凭慈爱待你仆人，","poem":1},{"lineBreak":true},{"text":"将你的律例教导我。","poem":1}]},{"type":"verse","number":125,"content":[{"lineBreak":true},{"text":"我是你的仆人，","poem":1},{"lineBreak":true},{"text":"求你赐我悟性可以明白你的法度。","poem":1}]},{"type":"verse","number":126,"content":[{"lineBreak":true},{"text":"耶和华啊，人们违背你的律法，","poem":1},{"lineBreak":true},{"text":"是你惩罚他们的时候了。","poem":1}]},{"type":"verse","number":127,"content":[{"lineBreak":true},{"text":"所以我爱你的命令胜于爱金子，","poem":1},{"lineBreak":true},{"text":"胜于爱纯金。","poem":1}]},{"type":"verse","number":128,"content":[{"lineBreak":true},{"text":"我遵行你一切的法则，","poem":1},{"lineBreak":true},{"text":"我憎恨一切恶道。","poem":1}]},{"type":"verse","number":129,"content":[{"lineBreak":true},{"text":"你的法度奇妙，","poem":1},{"lineBreak":true},{"text":"所以我一心遵守。","poem":1}]},{"type":"verse","number":130,"content":[{"lineBreak":true},{"text":"你的话语一解明，","poem":1},{"lineBreak":true},{"text":"就发出亮光，","poem":1},{"lineBreak":true},{"text":"使愚人得到启迪。","poem":1}]},{"type":"verse","number":131,"content":[{"lineBreak":true},{"text":"我张着口气喘吁吁，","poem":1},{"lineBreak":true},{"text":"因我渴慕你的命令。","poem":1}]},{"type":"verse","number":132,"content":[{"lineBreak":true},{"text":"求你眷顾我、怜悯我，","poem":1},{"lineBreak":true},{"text":"正如你素来恩待爱你名的人。","poem":1}]},{"type":"verse","number":133,"content":[{"lineBreak":true},{"text":"求你照你的应许引导我的脚步，","poem":1},{"lineBreak":true},{"text":"不要让罪恶辖制我。","poem":1}]},{"type":"verse","number":134,"content":[{"lineBreak":true},{"text":"求你救我脱离恶人的欺压，","poem":1},{"lineBreak":true},{"text":"好使我能遵守你的法则。","poem":1}]},{"type":"verse","number":135,"content":[{"lineBreak":true},{"text":"求你以容光照耀仆人，","poem":1},{"lineBreak":true},{"text":"将你的律例教导我。","poem":1}]},{"type":"verse","number":136,"content":[{"lineBreak":true},{"text":"我泪流成河，","poem":1},{"lineBreak":true},{"text":"因为人们不遵行你的律法。","poem":1}]},{"type":"verse","number":137,"content":[{"lineBreak":true},{"text":"耶和华啊，你是公义的，","poem":1},{"lineBreak":true},{"text":"你的法令是公正的。","poem":1}]},{"type":"verse","number":138,"content":[{"lineBreak":true},{"text":"你定的法度公义，完全可信。","poem":1}]},{"type":"verse","number":139,"content":[{"lineBreak":true},{"text":"我看见仇敌无视你的话语，","poem":1},{"lineBreak":true},{"text":"就心急如焚。","poem":1}]},{"type":"verse","number":140,"content":[{"lineBreak":true},{"text":"你仆人喜爱你的应许，","poem":1},{"lineBreak":true},{"text":"因为你的应许纯全可靠。","poem":1}]},{"type":"verse","number":141,"content":[{"lineBreak":true},{"text":"我虽然卑微、受人藐视，","poem":1},{"lineBreak":true},{"text":"但我不忘记你的法则。","poem":1}]},{"type":"verse","number":142,"content":[{"lineBreak":true},{"text":"你的公义常存，","poem":1},{"lineBreak":true},{"text":"你的律法是真理。","poem":1}]},{"type":"verse","number":143,"content":[{"lineBreak":true},{"text":"我虽然遭遇困苦患难，","poem":1},{"lineBreak":true},{"text":"但你的命令是我的喜乐。","poem":1}]},{"type":"verse","number":144,"content":[{"lineBreak":true},{"text":"你的法度永远公正，","poem":1},{"lineBreak":true},{"text":"求你赐我悟性，使我存活。","poem":1}]},{"type":"verse","number":145,"content":[{"lineBreak":true},{"text":"耶和华啊，我全心呼求你，","poem":1},{"lineBreak":true},{"text":"求你应允我，","poem":1},{"lineBreak":true},{"text":"我必遵守你的律例。","poem":1}]},{"type":"verse","number":146,"content":[{"lineBreak":true},{"text":"我向你呼求，求你救我，","poem":1},{"lineBreak":true},{"text":"我必持守你的法度。","poem":1}]},{"type":"verse","number":147,"content":[{"lineBreak":true},{"text":"天不亮，","poem":1},{"lineBreak":true},{"text":"我就起来呼求你的帮助，","poem":1},{"lineBreak":true},{"text":"你的话语是我的盼望。","poem":1}]},{"type":"verse","number":148,"content":[{"lineBreak":true},{"text":"我整夜不睡，默想你的应许。","poem":1}]},{"type":"verse","number":149,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你凭你的慈爱垂听我的呼求，","poem":1},{"lineBreak":true},{"text":"照你的法令保全我性命。","poem":1}]},{"type":"verse","number":150,"content":[{"lineBreak":true},{"text":"作恶多端的人逼近了，","poem":1},{"lineBreak":true},{"text":"他们远离你的律法。","poem":1}]},{"type":"verse","number":151,"content":[{"lineBreak":true},{"text":"但耶和华啊，你就在我身边，","poem":1},{"lineBreak":true},{"text":"你的一切命令都是真理。","poem":1}]},{"type":"verse","number":152,"content":[{"lineBreak":true},{"text":"我很早就从你的法度中知道，","poem":1},{"lineBreak":true},{"text":"你立的法度永远长存。","poem":1}]},{"type":"verse","number":153,"content":[{"lineBreak":true},{"text":"求你鉴察我的苦难，搭救我，","poem":1},{"lineBreak":true},{"text":"因为我没有忘记你的律法。","poem":1}]},{"type":"verse","number":154,"content":[{"lineBreak":true},{"text":"求你为我申冤，救赎我，","poem":1},{"lineBreak":true},{"text":"照你的应许保全我性命。","poem":1}]},{"type":"verse","number":155,"content":[{"lineBreak":true},{"text":"恶人不寻求你的律例，","poem":1},{"lineBreak":true},{"text":"以致得不到拯救。","poem":1}]},{"type":"verse","number":156,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"你有无比的怜悯之心，","poem":1},{"lineBreak":true},{"text":"求你照你的法令保全我性命。","poem":1}]},{"type":"verse","number":157,"content":[{"lineBreak":true},{"text":"迫害我的仇敌众多，","poem":1},{"lineBreak":true},{"text":"但我却没有偏离你的法度。","poem":1}]},{"type":"verse","number":158,"content":[{"lineBreak":true},{"text":"我看见背信之徒就厌恶，","poem":1},{"lineBreak":true},{"text":"因为他们不遵行你的话。","poem":1}]},{"type":"verse","number":159,"content":[{"lineBreak":true},{"text":"耶和华啊，你看我多爱你的法则，","poem":1},{"lineBreak":true},{"text":"求你施慈爱保全我性命。","poem":1}]},{"type":"verse","number":160,"content":[{"lineBreak":true},{"text":"你的话都是真理，","poem":1},{"lineBreak":true},{"text":"你一切公义的法令永不改变。","poem":1}]},{"type":"verse","number":161,"content":[{"lineBreak":true},{"text":"权贵无故迫害我，","poem":1},{"lineBreak":true},{"text":"但我的心对你的话充满敬畏。","poem":1}]},{"type":"verse","number":162,"content":[{"lineBreak":true},{"text":"我喜爱你的应许，","poem":1},{"lineBreak":true},{"text":"如获至宝。","poem":1}]},{"type":"verse","number":163,"content":[{"lineBreak":true},{"text":"我憎恶虚假，","poem":1},{"lineBreak":true},{"text":"但我喜爱你的律法。","poem":1}]},{"type":"verse","number":164,"content":[{"lineBreak":true},{"text":"因你公义的法令，","poem":1},{"lineBreak":true},{"text":"我要每天七次赞美你。","poem":1}]},{"type":"verse","number":165,"content":[{"lineBreak":true},{"text":"喜爱你律法的人大有平安，","poem":1},{"lineBreak":true},{"text":"什么也不能使他跌倒。","poem":1}]},{"type":"verse","number":166,"content":[{"lineBreak":true},{"text":"耶和华啊，我等候你的拯救，","poem":1},{"lineBreak":true},{"text":"我遵行你的命令。","poem":1}]},{"type":"verse","number":167,"content":[{"lineBreak":true},{"text":"我深爱你的法度，一心遵守。","poem":1}]},{"type":"verse","number":168,"content":[{"lineBreak":true},{"text":"我遵守你的法则和法度，","poem":1},{"lineBreak":true},{"text":"你知道我做的每一件事。","poem":1}]},{"type":"verse","number":169,"content":[{"lineBreak":true},{"text":"耶和华啊，求你垂听我的呼求，","poem":1},{"lineBreak":true},{"text":"照你的话赐我悟性。","poem":1}]},{"type":"verse","number":170,"content":[{"lineBreak":true},{"text":"求你垂听我的祈求，","poem":1},{"lineBreak":true},{"text":"照你的应许拯救我。","poem":1}]},{"type":"verse","number":171,"content":[{"lineBreak":true},{"text":"愿我的嘴唇涌出赞美，","poem":1},{"lineBreak":true},{"text":"因你将你的律例教导了我。","poem":1}]},{"type":"verse","number":172,"content":[{"lineBreak":true},{"text":"愿我的舌头歌颂你的应许，","poem":1},{"lineBreak":true},{"text":"因为你一切的命令尽都公义。","poem":1}]},{"type":"verse","number":173,"content":[{"lineBreak":true},{"text":"愿你的手随时帮助我，","poem":1},{"lineBreak":true},{"text":"因为我选择了你的法则。","poem":1}]},{"type":"verse","number":174,"content":[{"lineBreak":true},{"text":"耶和华啊，我盼望你的拯救，","poem":1},{"lineBreak":true},{"text":"你的律法是我的喜乐。","poem":1}]},{"type":"verse","number":175,"content":[{"lineBreak":true},{"text":"求你让我存活，我好赞美你，","poem":1},{"lineBreak":true},{"text":"愿你的法令成为我的帮助。","poem":1}]},{"type":"verse","number":176,"content":[{"lineBreak":true},{"text":"我像只迷途的羊，","poem":1},{"lineBreak":true},{"text":"求你来寻找仆人，","poem":1},{"lineBreak":true},{"text":"因为我没有忘记你的命令。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}