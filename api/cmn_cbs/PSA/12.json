{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":12,"content":[{"type":"heading","content":["祈求上帝帮助"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你救助！","poem":1},{"lineBreak":true},{"text":"因为敬虔的人已经绝迹，","poem":1},{"lineBreak":true},{"text":"忠信的人在世间消失了。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"人们彼此说谎，","poem":1},{"lineBreak":true},{"text":"花言巧语，口是心非。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愿耶和华铲除一切花言巧语和狂妄自夸的人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们说：“我们必靠舌头制胜，","poem":1},{"lineBreak":true},{"text":"嘴唇是我们自己的，","poem":1},{"lineBreak":true},{"text":"谁管得着我们？”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华说：“因为困苦人受欺压，","poem":1},{"lineBreak":true},{"text":"贫穷人痛苦哀叹，","poem":1},{"lineBreak":true},{"text":"我要挺身保护他们，","poem":1},{"lineBreak":true},{"text":"遂其所愿。”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华的言语纯全，","poem":1},{"lineBreak":true},{"text":"就像在炉中炼过七次的银子。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华啊，你必保护贫苦人，","poem":1},{"lineBreak":true},{"text":"永远不容恶人侵害我们。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"众人若抑善扬恶，","poem":1},{"lineBreak":true},{"text":"恶人必横行无忌。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}