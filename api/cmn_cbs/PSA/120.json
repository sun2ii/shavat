xt":"但我讲和平时，他们却要战争。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}