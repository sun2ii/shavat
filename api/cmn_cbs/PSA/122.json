{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":122,"content":[{"type":"heading","content":["为耶路撒冷祷告"]},{"type":"hebrew_subtitle","content":["大卫的上圣殿朝圣之诗。"]},{"type":"verse","number":1,"content":[{"text":"人们对我说：","poem":1},{"lineBreak":true},{"text":"“让我们去耶和华的殿吧！”","poem":1},{"lineBreak":true},{"text":"我感到欢喜。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，","poem":1},{"lineBreak":true},{"text":"我们正站在你的城门里。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶路撒冷被建成一座整齐坚固的城。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华拣选的以色列各支派，","poem":1},{"lineBreak":true},{"text":"都遵照祂赐的法度去那里称谢祂的名。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"那里有审判的王座，","poem":1},{"lineBreak":true},{"text":"就是大卫家的王座。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"要为耶路撒冷的平安祷告，","poem":1},{"lineBreak":true},{"text":"愿爱这城的人亨通。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶路撒冷啊！","poem":1},{"lineBreak":true},{"text":"愿你城内有平安，","poem":1},{"lineBreak":true},{"text":"你的宫里有安宁，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"为了我的亲人和朋友，","poem":1},{"lineBreak":true},{"text":"我要祈求平安临到你。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"为了我们的上帝耶和华的殿，","poem":1},{"lineBreak":true},{"text":"我要为你求福祉。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}