","number":8,"content":[{"lineBreak":true},{"text":"我们的帮助来自创造天地的耶和华的名。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}