{},"nextChapterApiLink":"/api/cmn_cbs/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}