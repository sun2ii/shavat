{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":130,"content":[{"type":"heading","content":["患难中求助的祷告"]},{"type":"hebrew_subtitle","content":["上圣殿朝圣之诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊！","poem":1},{"lineBreak":true},{"text":"我从深渊向你呼求。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"主啊，求你垂听我的呼求，","poem":1},{"lineBreak":true},{"text":"侧耳听我的祈求。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"主耶和华啊，","poem":1},{"lineBreak":true},{"text":"倘若你追究我们的罪过，","poem":1},{"lineBreak":true},{"text":"谁能站得住呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"然而，你乐意赦免，","poem":1},{"lineBreak":true},{"text":"所以你当受敬畏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我等候耶和华，一心等候祂，","poem":1},{"lineBreak":true},{"text":"祂的话语是我的盼望。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我一心等候主，","poem":1},{"lineBreak":true},{"text":"比守夜的盼望天明还要迫切，","poem":1},{"lineBreak":true},{"text":"比守夜的盼望天明还要迫切。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"以色列啊，要仰望耶和华，","poem":1},{"lineBreak":true},{"text":"因为祂有慈爱，有完全的救赎。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂必救赎以色列脱离一切罪恶。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}