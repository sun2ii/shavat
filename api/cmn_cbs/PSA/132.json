{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":132,"content":[{"type":"heading","content":["求上帝赐福圣殿"]},{"type":"hebrew_subtitle","content":["上圣殿朝圣之诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你顾念大卫和他所受的一切苦难。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他曾向耶和华起誓，","poem":1},{"lineBreak":true},{"text":"向雅各的大能者许愿说：","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"“我不为耶和华找到居所，","poem":1},{"lineBreak":true},{"text":"不为雅各的大能者找到安居之处，","poem":1},{"lineBreak":true},{"text":"必不进家门，","poem":1},{"lineBreak":true},{"text":"不沾床，不睡觉，不打盹。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我们在以法他听到约柜的消息，","poem":1},{"lineBreak":true},{"text":"在雅珥的田野找到了它。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"让我们进入耶和华的居所，","poem":1},{"lineBreak":true},{"text":"在祂脚凳前俯伏敬拜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你起来和你大能的约柜一同进入安息之所。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愿你的祭司身披公义，","poem":1},{"lineBreak":true},{"text":"愿你忠心的子民欢唱。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"为了你仆人大卫的缘故，","poem":1},{"lineBreak":true},{"text":"求你不要弃绝你所膏立的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和华曾向大卫起了永不废弃的誓说：","poem":1},{"lineBreak":true},{"text":"“我必使你的后代继承你的王位。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你的后代若守我的约，","poem":1},{"lineBreak":true},{"text":"遵行我教导他们的法度，","poem":1},{"lineBreak":true},{"text":"他们的子孙必永远坐在你的宝座上。”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因为耶和华已经拣选了锡安，","poem":1},{"lineBreak":true},{"text":"愿意将锡安作为祂的居所。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂说：“这是我永远的安息之所；","poem":1},{"lineBreak":true},{"text":"我要住在这里，","poem":1},{"lineBreak":true},{"text":"因为我喜欢这地方。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要赐福，使她粮食充足，","poem":1},{"lineBreak":true},{"text":"使她里面的穷人饮食无忧。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要用救恩作她祭司的衣裳，","poem":1},{"lineBreak":true},{"text":"她忠心的子民必欢唱。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我必使大卫的角在那里兴起，","poem":1},{"lineBreak":true},{"text":"我必为我所膏立的预备明灯。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我必使他的仇敌抱愧蒙羞，","poem":1},{"lineBreak":true},{"text":"但他头上的王冠必光芒四射。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":16}