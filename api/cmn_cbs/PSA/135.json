{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":135,"content":[{"type":"heading","content":["赞美之歌"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"赞美祂的名！","poem":1},{"lineBreak":true},{"text":"耶和华的仆人啊，","poem":1},{"lineBreak":true},{"text":"在耶和华的殿中，","poem":1},{"lineBreak":true},{"text":"在我们上帝的院宇中事奉的人啊，","poem":1},{"lineBreak":true},{"text":"你们要赞美祂！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们要赞美耶和华，","poem":1},{"lineBreak":true},{"text":"因为祂是美善的；","poem":1},{"lineBreak":true},{"text":"你们要歌颂祂的名，","poem":1},{"lineBreak":true},{"text":"因为祂的名美好无比。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂拣选雅各做祂的子民，","poem":1},{"lineBreak":true},{"text":"拣选以色列作祂的产业。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我知道耶和华伟大，","poem":1},{"lineBreak":true},{"text":"我们的主超越一切神明。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华在天上、地下、海洋、","poem":1},{"lineBreak":true},{"text":"深渊按自己的旨意行事。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂使云雾从地极上升，","poem":1},{"lineBreak":true},{"text":"发出电光，带来雨水，","poem":1},{"lineBreak":true},{"text":"从祂的仓库带出风来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"祂击杀了埃及人的长子和头胎的牲畜。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂在埃及行神迹奇事，","poem":1},{"lineBreak":true},{"text":"惩罚法老和他的一切臣仆。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂毁灭列国，","poem":1},{"lineBreak":true},{"text":"杀戮强大的君王：","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"亚摩利王西宏、巴珊王噩和迦南所有的君王。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂把这些国家的土地赐给祂的以色列子民，","poem":1},{"lineBreak":true},{"text":"作为他们的产业。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华啊，你的名永远长存，","poem":1},{"lineBreak":true},{"text":"耶和华啊，你的威名传到万代。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因为耶和华必为祂的子民申冤，","poem":1},{"lineBreak":true},{"text":"怜悯祂的仆人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"外族人的偶像是人用金银造的。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"它们有口不能言，有眼不能看，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"有耳不能听，口中毫无气息。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"造偶像的必和偶像一样，","poem":1},{"lineBreak":true},{"text":"信靠偶像的人也是如此。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"以色列人啊，","poem":1},{"lineBreak":true},{"text":"你们要称颂耶和华！","poem":1},{"lineBreak":true},{"text":"亚伦家啊，","poem":1},{"lineBreak":true},{"text":"你们要称颂耶和华！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"利未家啊，","poem":1},{"lineBreak":true},{"text":"你们要称颂耶和华！","poem":1},{"lineBreak":true},{"text":"你们敬畏耶和华的人都要称颂祂！","poem":1},{"noteId":10}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"要赞美锡安的耶和华，","poem":1},{"lineBreak":true},{"text":"赞美住在耶路撒冷的耶和华。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"平行经文：诗篇115:4‑11。","reference":{"chapter":135,"verse":20}}]},"thisChapterLink":"/api/cmn_cbs/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":20}