{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":136,"content":[{"type":"heading","content":["上帝的慈爱永远长存"]},{"type":"verse","number":1,"content":[{"text":"你们要称谢耶和华，","poem":1},{"lineBreak":true},{"text":"因为祂是美善的，","poem":1},{"lineBreak":true},{"text":"祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们要称谢万神之神，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们要称谢万主之主，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"要称谢那位独行大奇事的，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要称谢那位用智慧创造诸天的，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"要称谢那位在水上铺展大地的，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"要称谢那位创造大光的，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂让太阳管理白昼，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂让月亮星辰管理黑夜，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"要称谢那位击杀埃及人长子的，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂带领以色列人离开埃及，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂伸出臂膀施展大能，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"要称谢那位分开红海的，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂引领以色列人走过红海，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂让法老和他的军兵葬身红海，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"要称谢那位带领祂子民走过旷野的，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"要称谢那位击杀大君王的，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂击杀了大能的君王，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂击杀了亚摩利王西宏，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"祂击杀了巴珊王噩，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"祂把他们的土地赐给祂子民作产业，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"祂把他们的土地赐给祂的仆人以色列人作产业，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"祂眷顾处于卑贱境地的我们，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"祂拯救我们脱离仇敌，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"祂赐食物给一切活物，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"你们要称谢天上的上帝，","poem":1},{"lineBreak":true},{"text":"因为祂的慈爱永远长存。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}