{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":137,"content":[{"type":"heading","content":["被掳者的哀歌"]},{"type":"verse","number":1,"content":[{"text":"我们坐在巴比伦河畔，","poem":1},{"lineBreak":true},{"text":"想起锡安禁不住凄然泪下。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我们把琴挂在柳树上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为俘虏我们的人要我们在那里唱歌，","poem":1},{"lineBreak":true},{"text":"掳掠我们的人要我们歌唱，说：","poem":1},{"lineBreak":true},{"text":"“给我们唱一首锡安的歌。”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们流落异邦，","poem":1},{"lineBreak":true},{"text":"怎能唱颂赞耶和华的歌呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，倘若我忘了你，","poem":1},{"lineBreak":true},{"text":"情愿我的右手无法再弹琴；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"倘若我忘了你，","poem":1},{"lineBreak":true},{"text":"不以你为我的至爱，","poem":1},{"lineBreak":true},{"text":"情愿我的舌头不能再歌唱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你记住耶路撒冷沦陷时以东人的行径。","poem":1},{"lineBreak":true},{"text":"他们喊道：","poem":1},{"lineBreak":true},{"text":"“拆毁这城，把它夷为平地！”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"巴比伦城啊，","poem":1},{"lineBreak":true},{"text":"你快要灭亡了，","poem":1},{"lineBreak":true},{"text":"那向你以牙还牙为我们复仇的人有福了！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"那抓住你的婴孩摔在石头上的人有福了！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}