{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":138,"content":[{"type":"heading","content":["感恩的祷告"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我全心称谢你，","poem":1},{"lineBreak":true},{"text":"在众神明面前歌颂你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要向你的圣殿下拜，称谢你的名，","poem":1},{"lineBreak":true},{"text":"因为你是慈爱和信实的，","poem":1},{"lineBreak":true},{"text":"你显明自己的尊名和应许伟大无比。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我呼求的时候，你就应允我；","poem":1},{"lineBreak":true},{"text":"你使我刚强壮胆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华啊，世上所有的君王听见你的话都要称谢你。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们要歌唱耶和华的作为，","poem":1},{"lineBreak":true},{"text":"因为耶和华荣耀无比。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华虽至高无上，","poem":1},{"lineBreak":true},{"text":"却仍看顾卑微的人，","poem":1},{"lineBreak":true},{"text":"祂对骄傲的人也了如指掌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华啊，虽然我身陷患难，","poem":1},{"lineBreak":true},{"text":"你必保全我性命，","poem":1},{"lineBreak":true},{"text":"伸手攻击我恼怒的仇敌，","poem":1},{"lineBreak":true},{"text":"用右手拯救我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华必成就祂为我所定的计划；","poem":1},{"lineBreak":true},{"text":"耶和华啊，你的慈爱永远长存。","poem":1},{"lineBreak":true},{"text":"求你不要撇弃你亲手所造的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}