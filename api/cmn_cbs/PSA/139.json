{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":139,"content":[{"type":"heading","content":["上帝的全知和佑护"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，你洞察我，","poem":1},{"lineBreak":true},{"text":"知道我的一切。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我或坐下或起来，你都知道，","poem":1},{"lineBreak":true},{"text":"你从远处就知道我的心思意念。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我或外出或躺卧，你都了解，","poem":1},{"lineBreak":true},{"text":"你熟悉我的一切行为。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华啊，我话未出口，","poem":1},{"lineBreak":true},{"text":"你已洞悉一切。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你在我前后护卫着我，","poem":1},{"lineBreak":true},{"text":"以大能的手保护我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"这一切实在是太奇妙，","poem":1},{"lineBreak":true},{"text":"太深奥了，我无法明白。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我去哪里可躲开你的灵？","poem":1},{"lineBreak":true},{"text":"我跑到哪里可避开你的面？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我若升到天上，你在那里；","poem":1},{"lineBreak":true},{"text":"我若下到阴间，你也在那里。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"纵使我乘黎明之翼飞到遥远的海岸居住，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"就是在那里，你的手必引导我，","poem":1},{"lineBreak":true},{"text":"你大能的手必扶持我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我想，黑暗一定可以遮蔽我，","poem":1},{"lineBreak":true},{"text":"让我四围的光明变成黑夜。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"然而，即使黑暗也无法遮住你的视线。","poem":1},{"lineBreak":true},{"text":"在你看来，黑夜亮如白昼，","poem":1},{"lineBreak":true},{"text":"黑暗与光明无异。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你创造了我的肺腑心肠，","poem":1},{"lineBreak":true},{"text":"使我在母腹中成形。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我称谢你，因为我受造奇妙可畏；","poem":1},{"lineBreak":true},{"text":"你的作为奇妙，我心深深知道。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我在隐秘处被造、在大地深处成形时，","poem":1},{"lineBreak":true},{"text":"你对我的形体一清二楚。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我的身体还未成形，","poem":1},{"lineBreak":true},{"text":"你早已看见了。","poem":1},{"lineBreak":true},{"text":"你为我所定的年日，","poem":1},{"lineBreak":true},{"text":"我尚未开始就已经记在你的册子上了。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"上帝啊，你的意念对我来说是何等宝贵，","poem":1},{"lineBreak":true},{"text":"数量何等浩博！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我若数算，它们比海沙还多。","poem":1},{"lineBreak":true},{"text":"我醒来的时候，","poem":1},{"lineBreak":true},{"text":"依然与你在一起。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"上帝啊，愿你杀戮恶人！","poem":1},{"lineBreak":true},{"text":"嗜血成性的人啊，你们走开！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他们恶言顶撞你，","poem":1},{"lineBreak":true},{"text":"你的仇敌亵渎你的名。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"我憎恨那些憎恨你的人，","poem":1},{"lineBreak":true},{"text":"我厌恶那些攻击你的人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我恨透了他们，","poem":1},{"lineBreak":true},{"text":"我视他们为敌人。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"上帝啊，求你鉴察我，","poem":1},{"lineBreak":true},{"text":"好知道我的内心；","poem":1},{"lineBreak":true},{"text":"求你试验我，好知道我的心思。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"求你看看我里面是否有邪恶，","poem":1},{"lineBreak":true},{"text":"引导我走永恒的道路。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}