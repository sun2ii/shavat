{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":140,"content":[{"type":"heading","content":["祈求上帝保护"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊！","poem":1},{"lineBreak":true},{"text":"求你拯救我脱离恶人，","poem":1},{"lineBreak":true},{"text":"保护我脱离残暴之徒。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他们心怀叵测，整天挑起争端。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们的言语恶毒如蛇，","poem":1},{"lineBreak":true},{"text":"嘴唇有蛇的毒液。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你使我免遭恶人的毒手，","poem":1},{"lineBreak":true},{"text":"保护我脱离残暴之徒。","poem":1},{"lineBreak":true},{"text":"他们图谋害我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"傲慢人在我的路上暗设网罗，","poem":1},{"lineBreak":true},{"text":"布下圈套，挖了陷阱。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我对耶和华说：“你是我的上帝。”","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你垂听我的呼求。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"主耶和华，我大能的拯救者啊，","poem":1},{"lineBreak":true},{"text":"在战争的日子，你护庇我的头。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你不要让恶人的愿望实现，","poem":1},{"lineBreak":true},{"text":"不要让他们的阴谋得逞，","poem":1},{"lineBreak":true},{"text":"免得他们狂妄自大。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"愿那些围攻我的人自食其嘴唇的恶果。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"愿火炭落在他们身上，","poem":1},{"lineBreak":true},{"text":"愿他们被扔进火里，","poem":1},{"lineBreak":true},{"text":"被抛进深坑，不再兴起。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"愿毁谤者在地上无法立足，","poem":1},{"lineBreak":true},{"text":"愿祸患毁灭残暴之徒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我知道耶和华必为贫穷人伸张正义，","poem":1},{"lineBreak":true},{"text":"为困苦者申冤。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"义人必赞美你的名，","poem":1},{"lineBreak":true},{"text":"正直人必活在你面前。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}