{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":141,"content":[{"type":"heading","content":["求上帝荫庇"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我向你呼求，","poem":1},{"lineBreak":true},{"text":"求你快来帮助我；","poem":1},{"lineBreak":true},{"text":"我向你呼求的时候，求你垂听。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿我的祷告如香升到你面前，","poem":1},{"lineBreak":true},{"text":"愿我举手所献的祷告如同晚祭。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你守住我的口，","poem":1},{"lineBreak":true},{"text":"看住我的嘴。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华啊，求你不要让我的心偏向邪恶，","poem":1},{"lineBreak":true},{"text":"免得我与恶人同流合污；","poem":1},{"lineBreak":true},{"text":"也不要让我吃他们的美食。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我情愿受义人出于爱心的责打，","poem":1},{"lineBreak":true},{"text":"他们的责备是良药，我不会逃避。","poem":1},{"lineBreak":true},{"text":"我要不断地用祷告抵挡恶人的行径。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们的首领被抛下悬崖的时候，","poem":1},{"lineBreak":true},{"text":"他们就会知道我所言不虚。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"那些恶人的骨头散落在阴间入口，","poem":1},{"lineBreak":true},{"text":"好像耕田翻起的土块。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"主耶和华啊，","poem":1},{"lineBreak":true},{"text":"我仰望你，我投靠你，","poem":1},{"lineBreak":true},{"text":"求你不要让我遭害。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你保守我不落入恶人设下的网罗，","poem":1},{"lineBreak":true},{"text":"不要掉进他们的陷阱。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"愿他们作茧自缚，","poem":1},{"lineBreak":true},{"text":"而我可以安然逃脱。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}