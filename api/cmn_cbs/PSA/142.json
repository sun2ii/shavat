{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":142,"content":[{"type":"heading","content":["苦难中的呼求"]},{"type":"hebrew_subtitle","content":["大卫在洞里作的训诲诗，也是祷告。"]},{"type":"verse","number":1,"content":[{"text":"我向耶和华大声呼求，","poem":1},{"lineBreak":true},{"text":"我高声向祂求助，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在祂面前倾诉我的苦情，","poem":1},{"lineBreak":true},{"text":"向祂述说我的患难。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华啊，我心力交瘁的时候，","poem":1},{"lineBreak":true},{"text":"只有你知道我当走的路。","poem":1},{"lineBreak":true},{"text":"敌人已在我行的路上铺下网罗。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"看看我左右，无人关心我；","poem":1},{"lineBreak":true},{"text":"我走投无路，无人眷顾我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华啊，我向你呼求，","poem":1},{"lineBreak":true},{"text":"你是我的避难所，","poem":1},{"lineBreak":true},{"text":"在世上你是我的福分。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你垂听我的呼求，","poem":1},{"lineBreak":true},{"text":"因为我身陷绝境。","poem":1},{"lineBreak":true},{"text":"求你救我脱离迫害我的人，","poem":1},{"lineBreak":true},{"text":"因为他们比我强大。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你救我脱离牢笼，","poem":1},{"lineBreak":true},{"text":"好让我赞美你。","poem":1},{"lineBreak":true},{"text":"因为你恩待我，","poem":1},{"lineBreak":true},{"text":"义人必聚集在我周围。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}