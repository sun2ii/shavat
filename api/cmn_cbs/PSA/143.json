{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":143,"content":[{"type":"heading","content":["求上帝拯救"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你垂听我的祷告，","poem":1},{"lineBreak":true},{"text":"倾听我的祈求，","poem":1},{"lineBreak":true},{"text":"求你凭你的信实和公义应允我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你不要审判你的仆人，","poem":1},{"lineBreak":true},{"text":"因为在你面前世间没有一个义人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"敌人迫害我，打垮我，","poem":1},{"lineBreak":true},{"text":"使我生活在黑暗中，","poem":1},{"lineBreak":true},{"text":"像死去很久的人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我精疲力竭，心惊胆战。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我想起遥远的过去，","poem":1},{"lineBreak":true},{"text":"我默想你的一切作为，","poem":1},{"lineBreak":true},{"text":"我回想你所做的事。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我举手向你呼求，","poem":1},{"lineBreak":true},{"text":"我的心渴慕你如同干旱之地渴慕甘霖。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华啊，求你快快应允我！","poem":1},{"lineBreak":true},{"text":"我已绝望，求你不要掩面不顾我，","poem":1},{"lineBreak":true},{"text":"不然我必和下坟墓的人无异。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你让我在清晨就听见你的慈言爱语，","poem":1},{"lineBreak":true},{"text":"因为我信靠你；","poem":1},{"lineBreak":true},{"text":"求你指示我当走的路，","poem":1},{"lineBreak":true},{"text":"因为我的心仰望你。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华啊，求你救我脱离仇敌，","poem":1},{"lineBreak":true},{"text":"我要到你那里寻求庇护。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"求你教导我遵行你的旨意，","poem":1},{"lineBreak":true},{"text":"因为你是我的上帝，","poem":1},{"lineBreak":true},{"text":"愿你良善的灵引导我走平坦的路。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华啊，求你为你的名而保全我性命，","poem":1},{"lineBreak":true},{"text":"凭你的公义救我脱离患难。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你施慈爱，铲除我的仇敌，","poem":1},{"lineBreak":true},{"text":"求你消灭一切迫害我的人，","poem":1},{"lineBreak":true},{"text":"因为我是你的仆人。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}