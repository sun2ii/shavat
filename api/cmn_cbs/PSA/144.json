{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":144,"content":[{"type":"heading","content":["祈求拯救与丰裕"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"我的磐石耶和华当受称颂，","poem":1},{"lineBreak":true},{"text":"祂训练我的手作战，","poem":1},{"lineBreak":true},{"text":"训练我的手指打仗。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"祂是我慈爱的上帝，","poem":1},{"lineBreak":true},{"text":"我的堡垒，我的避难所，","poem":1},{"lineBreak":true},{"text":"我的拯救者，我的盾牌，","poem":1},{"lineBreak":true},{"text":"我投靠祂。","poem":1},{"lineBreak":true},{"text":"祂使列国臣服于我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"人算什么，你竟顾念他？","poem":1},{"lineBreak":true},{"text":"世人算什么，你竟眷顾他？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因为人不过像一口气，","poem":1},{"lineBreak":true},{"text":"他的年日不过像影子转眼消逝。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你打开天门，亲自降临；","poem":1},{"lineBreak":true},{"text":"求你触摸群山，使群山冒烟。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你发出闪电驱散敌人，","poem":1},{"lineBreak":true},{"text":"求你射出利箭击溃他们。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你从天上伸手从惊涛骇浪中拯救我，","poem":1},{"lineBreak":true},{"text":"从外族人手中拯救我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们满口谎言，","poem":1},{"lineBreak":true},{"text":"起誓也心怀诡诈。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"上帝啊，我要向你唱新歌，","poem":1},{"lineBreak":true},{"text":"用十弦琴歌颂你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你使君王得胜，","poem":1},{"lineBreak":true},{"text":"救你的仆人大卫逃离刀剑的杀戮。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你从外族人手中拯救我，","poem":1},{"lineBreak":true},{"text":"他们满口谎言，","poem":1},{"lineBreak":true},{"text":"起誓也心怀诡诈。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"愿我们的儿子年轻时像茁壮的树木，","poem":1},{"lineBreak":true},{"text":"我们的女儿像宫殿中精雕的柱子。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"愿我们的仓库堆满各样谷物，","poem":1},{"lineBreak":true},{"text":"我们的羊在田野多多繁衍，","poem":1},{"lineBreak":true},{"text":"成千上万。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"愿我们的牲口驮满货物","poem":1},{"noteId":11},{"text":"，","poem":1},{"lineBreak":true},{"text":"我们的城墙坚固，","poem":1},{"lineBreak":true},{"text":"无人被掳，街上没有哭叫声。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"生活在这种光景里的人有福了！","poem":1},{"lineBreak":true},{"text":"尊耶和华为上帝的民有福了！","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"“牲口驮满货物”或译“多多繁殖”。","reference":{"chapter":144,"verse":14}}]},"thisChapterLink":"/api/cmn_cbs/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}