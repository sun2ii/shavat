{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":145,"content":[{"type":"heading","content":["赞美之歌"]},{"type":"hebrew_subtitle","content":["大卫的赞美诗。"]},{"type":"verse","number":1,"content":[{"text":"我的上帝，我的王啊！","poem":1},{"lineBreak":true},{"text":"我要尊崇你，","poem":1},{"lineBreak":true},{"text":"我要永永远远称颂你的名。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要天天称颂你，","poem":1},{"lineBreak":true},{"text":"永永远远赞美你的名。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华是伟大的，","poem":1},{"lineBreak":true},{"text":"当受至高的颂赞，","poem":1},{"lineBreak":true},{"text":"祂的伟大无法测度。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"愿世世代代颂赞你的事迹，","poem":1},{"lineBreak":true},{"text":"传扬你大能的作为。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我要默想你的荣耀、威严和奇妙作为。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"人们要述说你令人敬畏的大能作为，","poem":1},{"lineBreak":true},{"text":"我也要传扬你的伟大事迹。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们要倾诉你的厚恩，","poem":1},{"lineBreak":true},{"text":"歌颂你的公义。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华有恩典、好怜悯，","poem":1},{"lineBreak":true},{"text":"不轻易发怒，充满慈爱。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华善待众生，","poem":1},{"lineBreak":true},{"text":"怜悯祂所造的万物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"你所创造的万物都要称谢你，","poem":1},{"lineBreak":true},{"text":"你忠心的子民也要颂扬你。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们要述说你国度的荣耀，","poem":1},{"lineBreak":true},{"text":"讲论你的大能，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"好让世人知道你大能的作为和你国度的威严与荣耀。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你的国度永远长存，","poem":1},{"lineBreak":true},{"text":"你的统治直到万代。","poem":1},{"lineBreak":true},{"text":"耶和华信守自己的一切应许，","poem":1},{"lineBreak":true},{"text":"祂的作为都充满慈爱。","poem":1},{"noteId":12}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华扶起跌倒的人，","poem":1},{"lineBreak":true},{"text":"扶持被重担所压的人。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"世人都仰望你，","poem":1},{"lineBreak":true},{"text":"你按时赐给他们所需的食物。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你伸手满足一切生命的需要。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和华的作为公义，","poem":1},{"lineBreak":true},{"text":"祂所行的充满慈爱。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和华垂顾一切求告祂的人，","poem":1},{"lineBreak":true},{"text":"一切诚心求告祂的人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂使敬畏祂的人心愿得偿，","poem":1},{"lineBreak":true},{"text":"垂听他们的呼求，拯救他们。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和华保护所有爱祂的人，","poem":1},{"lineBreak":true},{"text":"毁灭一切恶人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我要开口赞美耶和华，","poem":1},{"lineBreak":true},{"text":"万物都要称颂祂的圣名，","poem":1},{"lineBreak":true},{"text":"直到永永远远。","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"“耶和华信守……慈爱”许多手抄本无此句。","reference":{"chapter":145,"verse":13}}]},"thisChapterLink":"/api/cmn_cbs/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}