{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":146,"content":[{"type":"heading","content":["赞美上帝的帮助"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"我的心啊，你要赞美耶和华。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要一生赞美耶和华，","poem":1},{"lineBreak":true},{"text":"我一息尚存都要歌颂祂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们不要倚靠权贵，","poem":1},{"lineBreak":true},{"text":"不要倚靠世人，","poem":1},{"lineBreak":true},{"text":"他们救不了你们。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们气息一断，便归回尘土，","poem":1},{"lineBreak":true},{"text":"他们的打算转眼成空。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"蒙雅各的上帝相助、仰望耶和华上帝的人有福了！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华创造了天地、海洋和其中的万物，","poem":1},{"lineBreak":true},{"text":"祂永远信实可靠。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂为受压制的人申冤，","poem":1},{"lineBreak":true},{"text":"赐食物给饥饿的人。","poem":1},{"lineBreak":true},{"text":"耶和华使被囚者得自由。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华使瞎眼的人能看见，","poem":1},{"lineBreak":true},{"text":"耶和华扶持被重担所压的人，","poem":1},{"lineBreak":true},{"text":"耶和华喜爱义人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华保护寄居异地的人，","poem":1},{"lineBreak":true},{"text":"看顾孤儿寡妇，","poem":1},{"lineBreak":true},{"text":"并挫败恶人的阴谋诡计。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华永远掌权。","poem":1},{"lineBreak":true},{"text":"锡安啊，","poem":1},{"lineBreak":true},{"text":"你的上帝要世世代代做王。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}