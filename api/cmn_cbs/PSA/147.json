{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":147,"content":[{"type":"heading","content":["赞美上帝复兴耶路撒冷"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"歌颂我们的上帝，真是美好！","poem":1},{"lineBreak":true},{"text":"赞美祂，真是快乐合宜！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华重建耶路撒冷，","poem":1},{"lineBreak":true},{"text":"召集流亡的以色列人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂医治心灵破碎的人，","poem":1},{"lineBreak":true},{"text":"包扎他们的创伤。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂决定众星的数目，","poem":1},{"lineBreak":true},{"text":"给它们一一命名。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我们的主伟大无比，充满力量，","poem":1},{"lineBreak":true},{"text":"祂的智慧没有穷尽。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华扶持谦卑人，","poem":1},{"lineBreak":true},{"text":"祂使恶人坠入尘埃。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你们要以感恩的心歌颂耶和华，","poem":1},{"lineBreak":true},{"text":"弹琴赞美我们的上帝。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂以云霞遮蔽天空，","poem":1},{"lineBreak":true},{"text":"降雨水滋润大地，","poem":1},{"lineBreak":true},{"text":"使山上长出青草。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂赐食物给走兽，","poem":1},{"lineBreak":true},{"text":"喂养嗷嗷待哺的小乌鸦。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华所喜悦的不是强健的马匹，","poem":1},{"lineBreak":true},{"text":"也不是矫捷的战士，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"而是敬畏祂、仰望祂慈爱的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶路撒冷啊，要称颂耶和华；","poem":1},{"lineBreak":true},{"text":"锡安啊，要赞美你的上帝。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因为祂使你的城门坚固，","poem":1},{"lineBreak":true},{"text":"赐福给你的儿女。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂使你四境平安，","poem":1},{"lineBreak":true},{"text":"饱享上好的麦子。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂向大地发出命令，","poem":1},{"lineBreak":true},{"text":"祂的话迅速传开。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"祂降下羊毛般的白雪，","poem":1},{"lineBreak":true},{"text":"撒下炉灰般的寒霜。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂抛下碎石般的冰雹，","poem":1},{"lineBreak":true},{"text":"谁能经得住祂降下的严寒呢？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂一声令下，冰雪便溶化；","poem":1},{"lineBreak":true},{"text":"祂使微风吹拂，河川奔流。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂将自己的话传于雅各，","poem":1},{"lineBreak":true},{"text":"将自己的律例和法令指示以色列。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"祂未曾这样对待其他国家，","poem":1},{"lineBreak":true},{"text":"他们不知道祂的法令。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}