{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":148,"content":[{"type":"heading","content":["万物当赞美上帝"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"从天上赞美祂，","poem":1},{"lineBreak":true},{"text":"在高天赞美祂！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"众天使啊，你们要赞美祂！","poem":1},{"lineBreak":true},{"text":"众天军啊，你们要赞美祂！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"太阳、月亮啊，你们要赞美祂！","poem":1},{"lineBreak":true},{"text":"闪亮的星辰啊，你们要赞美祂！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"天上的天啊，你们要赞美祂！","poem":1},{"lineBreak":true},{"text":"天上的水啊，你们要赞美祂！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愿这一切都来赞美耶和华的名！","poem":1},{"lineBreak":true},{"text":"因为祂一发命令便创造了万物。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂使这一切各处其位，永不改变，","poem":1},{"lineBreak":true},{"text":"祂颁布的律例永不废弃。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"要在世上赞美耶和华，","poem":1},{"lineBreak":true},{"text":"海中的巨兽和深渊啊，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"火焰、冰雹、雪花、云霞和听祂吩咐的狂风啊，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"高山、丘陵、果树和香柏树啊，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"野兽、牲畜、爬虫和飞鸟啊，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"世上的君王、万国、首领和审判官啊，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"少男、少女、老人和孩童啊，","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"愿他们都赞美耶和华，","poem":1},{"lineBreak":true},{"text":"因为唯有祂的名当受尊崇，","poem":1},{"lineBreak":true},{"text":"祂的荣耀在天地之上。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂使祂子民的角高举，","poem":1},{"lineBreak":true},{"text":"叫祂忠心的子民，","poem":1},{"lineBreak":true},{"text":"祂心爱的以色列人得到尊荣。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}