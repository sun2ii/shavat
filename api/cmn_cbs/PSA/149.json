{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":149,"content":[{"type":"heading","content":["以色列要赞美上帝"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"要向耶和华唱新歌，","poem":1},{"lineBreak":true},{"text":"在祂忠心子民的聚会中颂赞祂！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿以色列因他的造物主而欢喜，","poem":1},{"lineBreak":true},{"text":"愿锡安的百姓因他们的君王而快乐。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愿他们跳舞赞美祂的名，","poem":1},{"lineBreak":true},{"text":"击鼓弹琴歌颂祂。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因为耶和华喜爱祂的子民，","poem":1},{"lineBreak":true},{"text":"祂赐尊荣给谦卑的人，","poem":1},{"lineBreak":true},{"text":"使他们得胜。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愿祂忠心的子民在荣耀中欢乐，","poem":1},{"lineBreak":true},{"text":"愿他们躺卧在床上的时候也欢唱。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愿他们高声颂赞耶和华，","poem":1},{"lineBreak":true},{"text":"手握两刃利剑向列国复仇，","poem":1},{"lineBreak":true},{"text":"在列邦中施行惩罚，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"用铁链捆绑他们的君王，","poem":1},{"lineBreak":true},{"text":"用铁铐锁住他们的首领，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"按他们的罪状审判他们。","poem":1},{"lineBreak":true},{"text":"这就是祂忠心的子民所得的荣耀。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":8}