{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":16,"content":[{"type":"heading","content":["信靠之福"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊！我投靠你，","poem":1},{"lineBreak":true},{"text":"求你保护我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我对耶和华说：“你是我的主，","poem":1},{"lineBreak":true},{"text":"我的福祉都从你而来。”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"世上的圣民极其尊贵，","poem":1},{"lineBreak":true},{"text":"是我所喜爱的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"追随其他神明的人，其愁苦必有增无减。","poem":1},{"lineBreak":true},{"text":"我必不向他们的假神浇奠血祭，","poem":1},{"lineBreak":true},{"text":"口中也不提假神的名号。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华啊，你是我的一切，","poem":1},{"lineBreak":true},{"text":"你是我的福分，","poem":1},{"lineBreak":true},{"text":"你掌管我的一切。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你用准绳量给我佳美之地，","poem":1},{"lineBreak":true},{"text":"我的产业何其美！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我要称颂那训导我的耶和华，","poem":1},{"lineBreak":true},{"text":"我的良心也在夜间提醒我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我常以耶和华为念，","poem":1},{"lineBreak":true},{"text":"祂在我右边，我必不动摇。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因此，我的心欢喜，","poem":1},{"lineBreak":true},{"text":"我的灵快乐，","poem":1},{"lineBreak":true},{"text":"我的身体也安然无恙。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因为你不会把我的灵魂撇在阴间，","poem":1},{"lineBreak":true},{"text":"也不会让你的圣者身体朽坏。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你把生命之路指示我，","poem":1},{"lineBreak":true},{"text":"你右手有永远的福乐，","poem":1},{"lineBreak":true},{"text":"我在你面前充满喜乐。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}