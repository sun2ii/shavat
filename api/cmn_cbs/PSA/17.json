{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":17,"content":[{"type":"heading","content":["无辜者的祈祷"]},{"type":"hebrew_subtitle","content":["大卫的祈祷。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你听我祈求公义的声音，","poem":1},{"lineBreak":true},{"text":"侧耳听我的呼求，","poem":1},{"lineBreak":true},{"text":"垂听我真诚的祷告。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿你宣判我无罪，","poem":1},{"lineBreak":true},{"text":"愿你明察是非。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你试验过我的心思，","poem":1},{"lineBreak":true},{"text":"夜间鉴察过我，磨炼过我，","poem":1},{"lineBreak":true},{"text":"找不出任何过犯；","poem":1},{"lineBreak":true},{"text":"我立志口不犯罪。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我遵守你的教导，洁身自守，","poem":1},{"lineBreak":true},{"text":"不与残暴之徒同流。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我坚定地走你的道路，","poem":1},{"lineBreak":true},{"text":"脚步从未偏离。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"上帝啊！我向你求告，","poem":1},{"lineBreak":true},{"text":"因为你必应允我。","poem":1},{"lineBreak":true},{"text":"求你侧耳听我的祷告。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你彰显你奇妙的慈爱，","poem":1},{"lineBreak":true},{"text":"用右手拯救投靠你的人脱离仇敌。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你保护我，像保护眼中的瞳仁，","poem":1},{"lineBreak":true},{"text":"用你的翅膀荫庇我，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"救我脱离恶人的攻击，","poem":1},{"lineBreak":true},{"text":"脱离四围杀气腾腾的仇敌。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们良心丧尽，口出狂言。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们穷追围堵，","poem":1},{"lineBreak":true},{"text":"伺机把我打倒在地。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们像急于撕碎猎物的饿狮，","poem":1},{"lineBreak":true},{"text":"又像蹲伏在暗处的猛狮。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你起来迎头击倒他们，","poem":1},{"lineBreak":true},{"text":"求你持刀救我脱离恶人。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你伸手救我脱离这些人，","poem":1},{"lineBreak":true},{"text":"脱离这些只在今生有福分的世人。","poem":1},{"lineBreak":true},{"text":"你使他们财宝无数。","poem":1},{"lineBreak":true},{"text":"他们儿女众多，","poem":1},{"lineBreak":true},{"text":"还把财富留给子孙。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"但我必因公义而得见你的面；","poem":1},{"lineBreak":true},{"text":"我醒来见到你的真容就心满意足了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}