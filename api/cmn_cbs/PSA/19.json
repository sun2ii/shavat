{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":19,"content":[{"type":"heading","content":["上帝的作为和律法"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"诸天述说上帝的荣耀，","poem":1},{"lineBreak":true},{"text":"穹苍传扬祂手的作为。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"它们日复一日地诉说，","poem":1},{"lineBreak":true},{"text":"夜复一夜地宣扬知识，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"无言无语，无声无息。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"它们的声音传遍天下，","poem":1},{"lineBreak":true},{"text":"它们的话语传到地极。","poem":1},{"lineBreak":true},{"text":"上帝在天上为太阳设立居所。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"太阳出来时，如步出洞房的新郎，","poem":1},{"lineBreak":true},{"text":"又如欢然奔跑赛程的健儿。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"它从天这边升起，","poem":1},{"lineBreak":true},{"text":"滑过长空，绕到天那边，","poem":1},{"lineBreak":true},{"text":"热量广及万物。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华的律法完美，","poem":1},{"lineBreak":true},{"text":"能更新生命；","poem":1},{"lineBreak":true},{"text":"耶和华的法度可靠，","poem":1},{"lineBreak":true},{"text":"让愚人有智慧。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华的法则公正，","poem":1},{"lineBreak":true},{"text":"使人心里喜乐；","poem":1},{"lineBreak":true},{"text":"耶和华的命令纯全，","poem":1},{"lineBreak":true},{"text":"让人眼目明亮。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华受的敬畏纯洁，","poem":1},{"lineBreak":true},{"text":"存到永远；","poem":1},{"lineBreak":true},{"text":"耶和华的法令可靠，","poem":1},{"lineBreak":true},{"text":"全然公义。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"这些比金子，比许多纯金还宝贵，","poem":1},{"lineBreak":true},{"text":"比蜂蜜，比蜂房滴下的纯蜜更甘甜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你仆人从中受到警戒，","poem":1},{"lineBreak":true},{"text":"遵守的人必得大赏赐。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"谁能知道自己的过失呢？","poem":1},{"lineBreak":true},{"text":"求你赦免我隐藏的过错。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"求你阻止仆人犯任意妄为之罪，","poem":1},{"lineBreak":true},{"text":"不让罪恶辖制我。","poem":1},{"lineBreak":true},{"text":"这样，我才纯全正直，","poem":1},{"lineBreak":true},{"text":"免犯大过。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华，我的磐石、我的救赎主啊，","poem":1},{"lineBreak":true},{"text":"愿你喜悦我口中的言语、心中的意念。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}