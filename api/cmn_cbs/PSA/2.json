{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":2,"content":[{"type":"heading","content":["上帝膏立的君王"]},{"type":"verse","number":1,"content":[{"text":"列国为何骚动不安？","poem":1},{"lineBreak":true},{"text":"万民为何枉费心机？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"世上的君王一同行动，","poem":1},{"lineBreak":true},{"text":"官长聚集商议，","poem":1},{"lineBreak":true},{"text":"要抵挡耶和华和祂所膏立的王。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们说：","poem":1},{"lineBreak":true},{"text":"“让我们挣断他们的锁链，","poem":1},{"lineBreak":true},{"text":"摆脱他们的捆索！”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"坐在天上宝座上的主必笑他们，","poem":1},{"lineBreak":true},{"text":"祂必嘲笑他们。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"那时，祂必怒斥他们，","poem":1},{"lineBreak":true},{"text":"发烈怒惊吓他们。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂说：","poem":1},{"lineBreak":true},{"text":"“在我的锡安圣山上，","poem":1},{"lineBreak":true},{"text":"我已立了我的君王。”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"那位君王说：","poem":1},{"lineBreak":true},{"text":"“我要宣告耶和华的旨意，","poem":1},{"lineBreak":true},{"text":"祂对我说，‘你是我的儿子，","poem":1},{"lineBreak":true},{"text":"我今日成为你父亲。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你向我祈求，我必把列国赐给你作产业，","poem":1},{"lineBreak":true},{"text":"让天下都归你所有。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你要用铁杖击垮他们，","poem":1},{"lineBreak":true},{"text":"像打碎陶器般打碎他们。’”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"所以君王啊，要慎思明辨！","poem":1},{"lineBreak":true},{"text":"世上的统治者啊，要接受劝诫！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"要怀着敬畏事奉耶和华，","poem":1},{"lineBreak":true},{"text":"要喜乐也要战战兢兢。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"要降服在祂儿子面前，","poem":1},{"lineBreak":true},{"text":"免得祂发怒，","poem":1},{"lineBreak":true},{"text":"你们便在途中灭亡，","poem":1},{"lineBreak":true},{"text":"因为祂的怒气将临。","poem":1},{"lineBreak":true},{"text":"投靠祂的人有福了！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}