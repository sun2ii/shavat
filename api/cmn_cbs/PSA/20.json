{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":20,"content":[{"type":"heading","content":["祈求胜利"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"愿耶和华应允你患难时的呼求。","poem":1},{"lineBreak":true},{"text":"愿雅各之上帝的名保护你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿祂从圣所帮助你，","poem":1},{"lineBreak":true},{"text":"从锡安山扶持你。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愿祂顾念你献的一切祭物，","poem":1},{"lineBreak":true},{"text":"悦纳你的燔祭。（细拉）","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"愿祂使你心愿得偿、","poem":1},{"lineBreak":true},{"text":"所有计划都实现。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我们要因你得胜而高声欢唱，","poem":1},{"lineBreak":true},{"text":"奉我们上帝的名竖起旌旗。","poem":1},{"lineBreak":true},{"text":"愿耶和华应允你一切的祈求。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"现在我知道耶和华拯救祂膏立的王，","poem":1},{"lineBreak":true},{"text":"祂从圣天之上应允他，","poem":1},{"lineBreak":true},{"text":"用右手的大能拯救他。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"有人靠战车，有人靠战马，","poem":1},{"lineBreak":true},{"text":"但我们靠的是我们的上帝耶和华的名。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们都一败涂地，","poem":1},{"lineBreak":true},{"text":"我们却屹立不倒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华啊，求你拯救你立的王。","poem":1},{"lineBreak":true},{"text":"我们呼求的时候，","poem":1},{"lineBreak":true},{"text":"求你垂听。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}