{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":21,"content":[{"type":"heading","content":["颂赞胜利"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"君王因你的能力而欢欣，","poem":1},{"lineBreak":true},{"text":"因你的拯救而雀跃。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你满足了他的心愿，","poem":1},{"lineBreak":true},{"text":"未曾拒绝他的请求。（细拉）","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你赐给他丰盛的祝福，","poem":1},{"lineBreak":true},{"text":"给他戴上纯金的冠冕。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他向你祈求长寿，","poem":1},{"lineBreak":true},{"text":"你就赐给他永生。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的救助带给他无上荣耀，","poem":1},{"lineBreak":true},{"text":"你赐给他尊荣和威严。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你给他的祝福永无穷尽，","poem":1},{"lineBreak":true},{"text":"你的同在使他充满喜乐。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"君王信靠耶和华，","poem":1},{"lineBreak":true},{"text":"靠着至高者的慈爱必不动摇。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"你的手必寻索你的一切敌人，","poem":1},{"lineBreak":true},{"text":"你用右手搜出那些恨你的人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你一出现，","poem":1},{"lineBreak":true},{"text":"他们便像身在火炉中，","poem":1},{"lineBreak":true},{"text":"你发烈怒吞灭他们，","poem":1},{"lineBreak":true},{"text":"你的烈火烧灭他们。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你必从世上铲除他们的子孙，","poem":1},{"lineBreak":true},{"text":"从人间灭绝他们的后裔。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们虽然用阴谋诡计对抗你，","poem":1},{"lineBreak":true},{"text":"却不能成功。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你必弯弓搭箭瞄准他们的脸，","poem":1},{"lineBreak":true},{"text":"使他们掉头逃跑。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华啊，愿你彰显大能，受人尊崇！","poem":1},{"lineBreak":true},{"text":"我们要歌颂、赞美你的权能。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}