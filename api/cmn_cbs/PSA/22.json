{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":22,"content":[{"type":"heading","content":["苦难中的呼求和感恩"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长，调用“朝鹿”。"]},{"type":"verse","number":1,"content":[{"text":"我的上帝，我的上帝，","poem":1},{"lineBreak":true},{"text":"你为什么离弃我？","poem":1},{"lineBreak":true},{"text":"为何远远地不来救我，","poem":1},{"lineBreak":true},{"text":"不听我的哀号呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"我白天呼求，你不回应；","poem":1},{"lineBreak":true},{"text":"我夜间呼求，仍无安宁。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"然而，你是圣洁的，","poem":1},{"lineBreak":true},{"text":"你的宝座设立在以色列人的颂赞之上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们的祖先信靠你，","poem":1},{"lineBreak":true},{"text":"他们信靠你，","poem":1},{"lineBreak":true},{"text":"你就解救他们。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们向你呼求，","poem":1},{"lineBreak":true},{"text":"就得到拯救；","poem":1},{"lineBreak":true},{"text":"他们信靠你，","poem":1},{"lineBreak":true},{"text":"就不会蒙羞。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"但我只是一条虫，而非人，","poem":1},{"lineBreak":true},{"text":"受尽羞辱和藐视。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"看见我的人都讥笑我，","poem":1},{"lineBreak":true},{"text":"他们撇着嘴、摇着头说：","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“他信靠耶和华，","poem":1},{"lineBreak":true},{"text":"让耶和华救他吧！","poem":1},{"lineBreak":true},{"text":"既然耶和华喜悦他，","poem":1},{"lineBreak":true},{"text":"让耶和华拯救他吧！”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"但耶和华啊，","poem":1},{"lineBreak":true},{"text":"是你使我从母腹中出生，","poem":1},{"lineBreak":true},{"text":"让我在母亲怀里便倚靠你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我一出生就被交托给你，","poem":1},{"lineBreak":true},{"text":"你从我出母胎就是我的上帝。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你不要远离我，","poem":1},{"lineBreak":true},{"text":"因为危难当头，无人帮我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我被许多仇敌围困，","poem":1},{"lineBreak":true},{"text":"他们像巴珊的公牛那样强壮。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他们张口要吞噬我，","poem":1},{"lineBreak":true},{"text":"如同吼叫着撕食猎物的狮子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"我的力量如水消逝，","poem":1},{"lineBreak":true},{"text":"我的骨头都脱了节，","poem":1},{"lineBreak":true},{"text":"我的心如蜡熔化。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的力量枯竭如焦土，","poem":1},{"lineBreak":true},{"text":"我的舌头紧贴上颚。","poem":1},{"lineBreak":true},{"text":"你把我放在死亡的尘土中。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"恶人包围我，犹如一群恶犬，","poem":1},{"lineBreak":true},{"text":"他们刺伤我的手脚。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我身上的骨头历历可见，","poem":1},{"lineBreak":true},{"text":"人们都幸灾乐祸地盯着我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们分我的外衣，","poem":1},{"lineBreak":true},{"text":"又为我的内衣抽签。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和华啊，求你不要远离我。","poem":1},{"lineBreak":true},{"text":"你是我的力量，","poem":1},{"lineBreak":true},{"text":"求你快来帮助我。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"求你救我逃脱刀剑之灾，","poem":1},{"lineBreak":true},{"text":"从这些恶犬的利爪下拯救我的生命。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"求你救我脱离狮子的口，","poem":1},{"lineBreak":true},{"text":"使我脱离野牛的角。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"我要向众弟兄传扬你的名，","poem":1},{"lineBreak":true},{"text":"在会众当中赞美你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"敬畏耶和华的人啊，要赞美祂！","poem":1},{"lineBreak":true},{"text":"所有雅各的后裔啊，要尊崇祂，","poem":1},{"lineBreak":true},{"text":"所有以色列的后裔啊，要敬畏祂。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"因为祂没有藐视、厌恶苦难中的人，","poem":1},{"lineBreak":true},{"text":"也没有掩面不顾他们，","poem":1},{"lineBreak":true},{"text":"而是垂听他们的呼求。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"我要在大会中赞美你，","poem":1},{"lineBreak":true},{"text":"在敬畏你的人面前履行我的誓言。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"穷苦人必吃得饱足，","poem":1},{"lineBreak":true},{"text":"寻求耶和华的人必赞美祂，","poem":1},{"lineBreak":true},{"text":"他们的心要永远欢欣。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"普世都要心系耶和华，归向祂，","poem":1},{"lineBreak":true},{"text":"各国人民都要敬拜祂。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"因为耶和华是主宰，","poem":1},{"lineBreak":true},{"text":"祂统治列国。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"世上的富贵人要欢宴敬拜祂，","poem":1},{"lineBreak":true},{"text":"必归尘土、无法长活的世人都要跪拜祂。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"世世代代的人都要事奉祂，","poem":1},{"lineBreak":true},{"text":"向后人传扬主所行的奇事。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他们要向将来的人传讲祂的公义作为。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}