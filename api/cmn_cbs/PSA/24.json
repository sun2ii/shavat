{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":24,"content":[{"type":"heading","content":["荣耀的君王"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"大地和其中的万物都属于耶和华，","poem":1},{"lineBreak":true},{"text":"世界和世上的一切都是祂的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"祂把大地奠基于海中，","poem":1},{"lineBreak":true},{"text":"建立在大水之上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"谁能登耶和华的山？","poem":1},{"lineBreak":true},{"text":"谁能站在祂的圣所中？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"只有那些手洁心清，","poem":1},{"lineBreak":true},{"text":"不拜假神，不起假誓的人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们必蒙耶和华赐福，","poem":1},{"lineBreak":true},{"text":"被救他们的上帝称为义人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"这就是寻求耶和华的人，","poem":1},{"lineBreak":true},{"text":"他们敬拜雅各的上帝。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"众城门啊，抬起头来！","poem":1},{"lineBreak":true},{"text":"古老的城门啊，抬起来吧！","poem":1},{"lineBreak":true},{"text":"好让荣耀的君王进来。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"谁是荣耀的君王呢？是强大无比的耶和华，","poem":1},{"lineBreak":true},{"text":"是战无不胜的耶和华。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"众城门啊，抬起头来！","poem":1},{"lineBreak":true},{"text":"古老的城门啊，抬起来吧！","poem":1},{"lineBreak":true},{"text":"好让荣耀的君王进来。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"谁是荣耀的君王呢？","poem":1},{"lineBreak":true},{"text":"万军之耶和华是荣耀的君王。（细拉）","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}