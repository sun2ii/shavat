{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":25,"content":[{"type":"heading","content":["祈求引导和赦免"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我的心仰望你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的上帝啊，我信靠你，","poem":1},{"lineBreak":true},{"text":"求你不要叫我蒙羞，","poem":1},{"lineBreak":true},{"text":"不要让我的仇敌向我夸胜。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"等候你的必不羞愧，","poem":1},{"lineBreak":true},{"text":"背信弃义者必蒙羞。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你指引我走你的路，","poem":1},{"lineBreak":true},{"text":"教导我行你的道。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"求你以你的真理引领我，","poem":1},{"lineBreak":true},{"text":"教导我，因为你是拯救我的上帝，","poem":1},{"lineBreak":true},{"text":"我终日等候你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你顾念你亘古以来常施的怜悯和慈爱，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你饶恕我年轻时的罪恶和过犯。","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你以你的恩惠和慈爱待我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华良善公正，","poem":1},{"lineBreak":true},{"text":"祂教导罪人走正路。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂指引谦卑人追求公义，","poem":1},{"lineBreak":true},{"text":"教导他们行祂的道。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"遵守祂的约和法度的人，","poem":1},{"lineBreak":true},{"text":"耶和华总以慈爱和信实相待。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华啊，我罪恶深重，","poem":1},{"lineBreak":true},{"text":"求你为了自己的名而赦免我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"凡敬畏耶和华的人，","poem":1},{"lineBreak":true},{"text":"耶和华必指示他当走的路。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他必享福，","poem":1},{"lineBreak":true},{"text":"他的后代必承受土地。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华与敬畏祂的人为友，","poem":1},{"lineBreak":true},{"text":"使他们认识祂的约。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我常常仰望耶和华，","poem":1},{"lineBreak":true},{"text":"因为唯有祂能使我的脚脱离网罗。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和华啊，我孤苦零丁，","poem":1},{"lineBreak":true},{"text":"求你眷顾我，恩待我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我心中充满愁烦，","poem":1},{"lineBreak":true},{"text":"求你救我脱离患难。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你体恤我的忧伤和痛苦，","poem":1},{"lineBreak":true},{"text":"赦免我一切的罪。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你看我的仇敌何其多，","poem":1},{"lineBreak":true},{"text":"他们都痛恨我。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"求你保护、搭救我的性命，","poem":1},{"lineBreak":true},{"text":"别让我蒙羞，因为我投靠你。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"求你以纯全和正直护卫我，","poem":1},{"lineBreak":true},{"text":"因为我等候你。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"求你救赎以色列脱离一切困境。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}