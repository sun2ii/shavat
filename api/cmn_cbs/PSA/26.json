{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":26,"content":[{"type":"heading","content":["义人的祈求"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你为我主持公道，","poem":1},{"lineBreak":true},{"text":"因为我行为纯全，","poem":1},{"lineBreak":true},{"text":"毫不动摇地信靠你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华啊，求你察验我，","poem":1},{"lineBreak":true},{"text":"试炼我，鉴察我的心思意念。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为我铭记你的慈爱，","poem":1},{"lineBreak":true},{"text":"我行在你的真理中。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我没有与诡诈者为伍，","poem":1},{"lineBreak":true},{"text":"没有跟虚伪之人同流。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我憎恨恶徒群聚，","poem":1},{"lineBreak":true},{"text":"不会与恶人交往。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华啊，我洗手表明清白，","poem":1},{"lineBreak":true},{"text":"再走近你的祭坛，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"要高唱感恩之歌，","poem":1},{"lineBreak":true},{"text":"述说你的一切奇妙作为。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华啊，我爱你居住的殿，","poem":1},{"lineBreak":true},{"text":"你荣耀充满的地方。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"别把我的灵魂和罪人同毁，","poem":1},{"lineBreak":true},{"text":"别把我的性命与嗜血之徒同灭。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们满腹奸计，大肆收受贿赂。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"但我行为纯全，","poem":1},{"lineBreak":true},{"text":"求你救赎我，怜悯我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我站在平坦之地，","poem":1},{"lineBreak":true},{"text":"我要在会众中赞美耶和华。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}