{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":27,"content":[{"type":"heading","content":["赞美的祷告"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华是我的光，我的拯救，","poem":1},{"lineBreak":true},{"text":"我还怕谁？","poem":1},{"lineBreak":true},{"text":"耶和华是我的堡垒，","poem":1},{"lineBreak":true},{"text":"我还怕谁？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"恶人前来吞吃我，","poem":1},{"lineBreak":true},{"text":"仇敌来攻击我时，","poem":1},{"lineBreak":true},{"text":"必失足跌倒。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"虽然大军围攻我，","poem":1},{"lineBreak":true},{"text":"我心中却一无所惧；","poem":1},{"lineBreak":true},{"text":"虽然战争来临，我仍满怀信心。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我向耶和华求一件事，","poem":1},{"lineBreak":true},{"text":"我还要求，就是能一生住在祂的殿中，","poem":1},{"lineBreak":true},{"text":"在那里瞻仰祂的荣美，寻求祂的旨意。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"危难之时，祂庇护我，","poem":1},{"lineBreak":true},{"text":"把我藏在祂的帐幕里，","poem":1},{"lineBreak":true},{"text":"高高地安置在磐石上。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我要昂首面对四围的敌人，","poem":1},{"lineBreak":true},{"text":"我要在祂的帐幕里欢呼献祭，","poem":1},{"lineBreak":true},{"text":"歌颂赞美祂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华啊，求你垂听我的呼求，","poem":1},{"lineBreak":true},{"text":"求你恩待我，应允我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你说：“来寻求我的面！”","poem":1},{"lineBreak":true},{"text":"我心中响应：","poem":1},{"lineBreak":true},{"text":"“耶和华啊，我要寻求你的面。”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"别掩面不理我，","poem":1},{"lineBreak":true},{"text":"别愤然拒绝你的仆人，","poem":1},{"lineBreak":true},{"text":"你一向是我的帮助。","poem":1},{"lineBreak":true},{"text":"拯救我的上帝啊，","poem":1},{"lineBreak":true},{"text":"别离开我，别撇弃我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"纵使父母撇弃我，","poem":1},{"lineBreak":true},{"text":"耶和华也必收留我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华啊，求你指教我行你的道，","poem":1},{"lineBreak":true},{"text":"因仇敌环伺，求你引导我走坦途。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你不要把我交给仇敌，遂其所愿，","poem":1},{"lineBreak":true},{"text":"因为他们诬告我，恐吓我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我深信今世必能看见耶和华的美善。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"要等候耶和华，","poem":1},{"lineBreak":true},{"text":"要刚强壮胆，","poem":1},{"lineBreak":true},{"text":"等候耶和华。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}