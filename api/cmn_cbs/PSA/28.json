{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":28,"content":[{"type":"heading","content":["祈求上帝帮助"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我呼求你；","poem":1},{"lineBreak":true},{"text":"我的磐石啊，别不理我。","poem":1},{"lineBreak":true},{"text":"你若默然不语，","poem":1},{"lineBreak":true},{"text":"我必如下坟墓的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我向你呼求，","poem":1},{"lineBreak":true},{"text":"向你的至圣所举手祷告时，","poem":1},{"lineBreak":true},{"text":"求你垂听我的祈求。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"求你不要把我与邪恶之徒同灭，","poem":1},{"lineBreak":true},{"text":"他们对邻居口蜜腹剑。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"求你使他们罪有应得，","poem":1},{"lineBreak":true},{"text":"按他们手上的罪恶报应他们，","poem":1},{"lineBreak":true},{"text":"按他们的恶行报应他们。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们既然毫不在意耶和华的事迹和作为，","poem":1},{"lineBreak":true},{"text":"祂必毁灭他们，","poem":1},{"lineBreak":true},{"text":"不再复兴他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和华当受称颂！","poem":1},{"lineBreak":true},{"text":"因为祂听了我的恳求。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂是我的力量，我的盾牌，","poem":1},{"lineBreak":true},{"text":"我信靠祂，就得帮助。","poem":1},{"lineBreak":true},{"text":"我的心欢喜雀跃，","poem":1},{"lineBreak":true},{"text":"我要歌唱赞美祂。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华是祂子民的力量，","poem":1},{"lineBreak":true},{"text":"是祂膏立之人得救的堡垒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你拯救你的子民，赐福给你的产业，","poem":1},{"lineBreak":true},{"text":"永远牧养他们，扶持他们。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}