{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":3,"content":[{"type":"heading","content":["求助的早祷"]},{"type":"hebrew_subtitle","content":["大卫逃避儿子押沙龙时作的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我的敌人何其多！","poem":1},{"lineBreak":true},{"text":"众人群起攻击我！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"众人都说上帝不会来救我。（细拉）","poem":1},{"noteId":0}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"可是，耶和华啊！","poem":1},{"lineBreak":true},{"text":"你是四面保护我的盾牌，","poem":1},{"lineBreak":true},{"text":"是我的荣耀，你使我昂首而立。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我向耶和华呼求，","poem":1},{"lineBreak":true},{"text":"祂就从祂的圣山上回应我。（细拉）","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我躺下，我睡觉，我醒来，","poem":1},{"lineBreak":true},{"text":"都蒙耶和华护佑。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我虽被千万仇敌围困，","poem":1},{"lineBreak":true},{"text":"也不会惧怕。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华啊，求你起来！","poem":1},{"lineBreak":true},{"text":"我的上帝啊，求你救我！","poem":1},{"lineBreak":true},{"text":"求你掴我一切仇敌的脸，","poem":1},{"lineBreak":true},{"text":"打碎恶人的牙齿。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"救恩来自耶和华。","poem":1},{"lineBreak":true},{"text":"愿你赐福你的子民！（细拉）","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“细拉”语意不明，常在诗篇中出现，可能是一种音乐术语。","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/cmn_cbs/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}