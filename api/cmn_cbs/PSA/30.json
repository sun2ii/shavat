{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":30,"content":[{"type":"heading","content":["感恩的祷告"]},{"type":"hebrew_subtitle","content":["大卫的诗，作献殿之歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我要尊崇你，","poem":1},{"lineBreak":true},{"text":"因为你救我脱离危难，","poem":1},{"lineBreak":true},{"text":"不让我的仇敌幸灾乐祸。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"我呼求你，你就医治了我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华啊，你从阴间把我救出，","poem":1},{"lineBreak":true},{"text":"没有让我下坟墓。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华忠心的子民啊，","poem":1},{"lineBreak":true},{"text":"你们要歌颂祂，","poem":1},{"lineBreak":true},{"text":"赞美祂的圣名。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因为祂的怒气瞬间消逝，","poem":1},{"lineBreak":true},{"text":"祂的恩惠却持续一生。","poem":1},{"lineBreak":true},{"text":"人虽整夜哭泣，","poem":1},{"lineBreak":true},{"text":"早晨必定欢呼。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我在顺境中曾说：","poem":1},{"lineBreak":true},{"text":"“我永不动摇。”","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"你向我施恩，我便稳固如山；","poem":1},{"lineBreak":true},{"text":"你掩面不理我，我就惊慌失措。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华啊，我向你呼求，","poem":1},{"lineBreak":true},{"text":"恳求你怜悯，说：","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“我被毁灭、下坟墓有何益处？","poem":1},{"lineBreak":true},{"text":"尘土能赞美你、宣扬你的信实吗？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华啊，求你垂听我的呼求，怜悯我！","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你帮助我！”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你把我的哀哭变成了舞步，","poem":1},{"lineBreak":true},{"text":"为我脱下悲伤的麻衣，","poem":1},{"lineBreak":true},{"text":"披上喜乐的外袍，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"好叫我的心歌颂你，","poem":1},{"lineBreak":true},{"text":"不致默然无声。","poem":1},{"lineBreak":true},{"text":"我的上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"我要永远称颂你！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}