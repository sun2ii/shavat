{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":31,"content":[{"type":"heading","content":["信靠上帝的祷告"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我投靠你，","poem":1},{"lineBreak":true},{"text":"求你让我永不蒙羞；","poem":1},{"lineBreak":true},{"text":"求你凭公义搭救我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你侧耳听我的呼求，","poem":1},{"lineBreak":true},{"text":"快来救我，作我避难的磐石，","poem":1},{"lineBreak":true},{"text":"作拯救我的堡垒。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为你是我的磐石，我的堡垒，","poem":1},{"lineBreak":true},{"text":"求你为了自己的名而引导我，","poem":1},{"lineBreak":true},{"text":"带领我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你是我的避难所，","poem":1},{"lineBreak":true},{"text":"求你救我脱离人们为我设下的陷阱。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我将我的灵魂交在你手中。","poem":1},{"lineBreak":true},{"text":"信实的上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"你必救赎我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我憎恨拜假神的人，","poem":1},{"lineBreak":true},{"text":"我只信靠耶和华。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你已经看见我的困苦，","poem":1},{"lineBreak":true},{"text":"知道我心中的愁烦，","poem":1},{"lineBreak":true},{"text":"我因你的恩慈而欢喜快乐。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你没有将我交在仇敌手中，","poem":1},{"lineBreak":true},{"text":"你使我双脚站在宽阔之地。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华啊，我落在苦难之中，","poem":1},{"lineBreak":true},{"text":"求你怜悯我，","poem":1},{"lineBreak":true},{"text":"愁苦令我眼目昏聩，身心疲惫。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的生命被愁苦吞噬，","poem":1},{"lineBreak":true},{"text":"岁月被哀伤耗尽，","poem":1},{"lineBreak":true},{"text":"力量因罪恶而消逝，","poem":1},{"lineBreak":true},{"text":"我成了枯骨一堆。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"仇敌羞辱我，","poem":1},{"lineBreak":true},{"text":"邻居厌弃我，","poem":1},{"lineBreak":true},{"text":"朋友害怕我，","poem":1},{"lineBreak":true},{"text":"路人纷纷躲避我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我被人遗忘，就像已死之人，","poem":1},{"lineBreak":true},{"text":"又像破碎的陶器。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我听见许多人窃窃私语，","poem":1},{"lineBreak":true},{"text":"恐怖四下弥漫。","poem":1},{"lineBreak":true},{"text":"他们图谋不轨，","poem":1},{"lineBreak":true},{"text":"谋害我的性命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"然而，耶和华啊，","poem":1},{"lineBreak":true},{"text":"我依然信靠你；","poem":1},{"lineBreak":true},{"text":"我说：“你是我的上帝。”","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的时日都掌握在你手中，","poem":1},{"lineBreak":true},{"text":"求你救我脱离仇敌和追逼我的人。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"求你以容光照耀仆人，","poem":1},{"lineBreak":true},{"text":"施慈爱拯救我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和华啊，我曾向你呼求，","poem":1},{"lineBreak":true},{"text":"求你不要叫我蒙羞。","poem":1},{"lineBreak":true},{"text":"求你使恶人蒙羞，","poem":1},{"lineBreak":true},{"text":"在阴间寂然无声。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"愿撒谎之人哑声，","poem":1},{"lineBreak":true},{"text":"他们骄傲自大，","poem":1},{"lineBreak":true},{"text":"狂言攻击义人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你的恩惠何其大，","poem":1},{"lineBreak":true},{"text":"是为敬畏你的人预备的，","poem":1},{"lineBreak":true},{"text":"在世人面前赐给投靠你的人。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你把他们藏在你那里，","poem":1},{"lineBreak":true},{"text":"使他们得到庇护，","poem":1},{"lineBreak":true},{"text":"免遭世人暗算。","poem":1},{"lineBreak":true},{"text":"你使他们躲在避难所，","poem":1},{"lineBreak":true},{"text":"免受恶言恶语的攻击。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和华当受称颂！","poem":1},{"lineBreak":true},{"text":"因为我被困城中时，","poem":1},{"lineBreak":true},{"text":"祂以奇妙的爱待我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我曾惊恐地说：","poem":1},{"lineBreak":true},{"text":"“我从你面前被弃绝！”","poem":1},{"lineBreak":true},{"text":"其实我求助的时候，","poem":1},{"lineBreak":true},{"text":"你听了我的呼求。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"耶和华忠心的子民啊，","poem":1},{"lineBreak":true},{"text":"你们要爱祂。","poem":1},{"lineBreak":true},{"text":"祂保护忠心的人，","poem":1},{"lineBreak":true},{"text":"严惩骄傲的人。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"凡等候耶和华的人啊，","poem":1},{"lineBreak":true},{"text":"要刚强壮胆！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}