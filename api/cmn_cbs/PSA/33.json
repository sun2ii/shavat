{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":33,"content":[{"type":"heading","content":["颂赞之歌"]},{"type":"verse","number":1,"content":[{"text":"义人啊，","poem":1},{"lineBreak":true},{"text":"你们要欢然歌颂耶和华，","poem":1},{"lineBreak":true},{"text":"正直的人理应赞美祂。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们要弹琴赞美耶和华，","poem":1},{"lineBreak":true},{"text":"弹奏十弦琴歌颂祂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要向祂唱新歌，","poem":1},{"lineBreak":true},{"text":"琴声要美妙，歌声要嘹亮。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因为耶和华的话正直，","poem":1},{"lineBreak":true},{"text":"祂的作为信实可靠。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂喜爱公义和公正，","poem":1},{"lineBreak":true},{"text":"大地充满祂的慈爱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"诸天靠祂的话被造，","poem":1},{"lineBreak":true},{"text":"万象靠祂口中的气而成。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂将海水聚在一处，","poem":1},{"lineBreak":true},{"text":"把汪洋收进仓库。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"愿普世都敬畏耶和华！","poem":1},{"lineBreak":true},{"text":"愿世人都畏惧祂！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为祂一发话，就创造了万有；","poem":1},{"lineBreak":true},{"text":"祂一声命令，便立定了万物。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂挫败列国的谋算，","poem":1},{"lineBreak":true},{"text":"拦阻列邦的计划。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂的计划永不落空，","poem":1},{"lineBreak":true},{"text":"祂的旨意万代长存。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"尊祂为上帝的邦国有福了！","poem":1},{"lineBreak":true},{"text":"蒙拣选做祂子民的人有福了！","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"祂从天上俯视人间，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"从祂的居所察看世人。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂塑造人心，","poem":1},{"lineBreak":true},{"text":"洞察人的一切行为。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"君王不能靠兵多取胜，","poem":1},{"lineBreak":true},{"text":"勇士不能凭力大获救。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"靠战马取胜实属妄想，","poem":1},{"lineBreak":true},{"text":"马虽力大也不能救人。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"但耶和华看顾敬畏祂的人，","poem":1},{"lineBreak":true},{"text":"祂看顾仰望祂慈爱的人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂救他们脱离死亡，","poem":1},{"lineBreak":true},{"text":"保护他们度过饥荒。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我们的心等候耶和华，","poem":1},{"lineBreak":true},{"text":"祂是我们的帮助，","poem":1},{"lineBreak":true},{"text":"是我们的盾牌。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我们信靠祂的圣名，","poem":1},{"lineBreak":true},{"text":"我们的心因祂而充满喜乐。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和华啊，我们仰望你，求你向我们施慈爱。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}