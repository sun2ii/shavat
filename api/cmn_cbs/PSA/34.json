{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":34,"content":[{"type":"heading","content":["上帝的美善"]},{"type":"hebrew_subtitle","content":["大卫在亚比米勒面前装疯，被赶出去后，作了此诗。"]},{"type":"verse","number":1,"content":[{"text":"我要常常称颂耶和华，","poem":1},{"lineBreak":true},{"text":"我的口时刻赞美祂。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我因耶和华而夸耀，","poem":1},{"lineBreak":true},{"text":"困苦人听见必欢欣。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要跟我们一同尊耶和华为大，","poem":1},{"lineBreak":true},{"text":"让我们一起尊崇祂的名！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我求助耶和华，祂便应允我，","poem":1},{"lineBreak":true},{"text":"救我脱离一切恐惧。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"仰望祂的人都有荣光，","poem":1},{"lineBreak":true},{"text":"他们必不致满面蒙羞。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我这可怜的人向祂呼求，","poem":1},{"lineBreak":true},{"text":"祂就垂听，","poem":1},{"lineBreak":true},{"text":"救我脱离一切困境。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂的天使在敬畏祂的人四围安营，","poem":1},{"lineBreak":true},{"text":"要搭救他们。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你们要亲身体验，","poem":1},{"lineBreak":true},{"text":"就知道耶和华的美善；","poem":1},{"lineBreak":true},{"text":"投靠祂的人有福了！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华的圣民啊，","poem":1},{"lineBreak":true},{"text":"你们要敬畏祂，","poem":1},{"lineBreak":true},{"text":"因为敬畏祂的人一无所缺。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"猛狮也会忍饥挨饿，","poem":1},{"lineBreak":true},{"text":"但寻求耶和华的人什么福分都不缺。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"孩子们啊，来听我说，","poem":1},{"lineBreak":true},{"text":"我要教导你们敬畏耶和华。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"若有人热爱生命，","poem":1},{"lineBreak":true},{"text":"渴望长寿和幸福，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"就要舌头不出恶言，","poem":1},{"lineBreak":true},{"text":"嘴唇不说诡诈的话。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"要弃恶行善，","poem":1},{"lineBreak":true},{"text":"竭力追求和睦。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和华的眼睛看顾义人，","poem":1},{"lineBreak":true},{"text":"祂的耳朵垂听他们的呼求。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华严惩作恶之人，","poem":1},{"lineBreak":true},{"text":"从世上铲除他们的名。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"义人向耶和华呼救，祂就垂听，","poem":1},{"lineBreak":true},{"text":"拯救他们脱离一切患难。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂安慰悲痛欲绝的人，","poem":1},{"lineBreak":true},{"text":"拯救心灵破碎的人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"义人遭遇许多患难，","poem":1},{"lineBreak":true},{"text":"但耶和华必从中救他，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"保全他一身的骨头，","poem":1},{"lineBreak":true},{"text":"连一根也不折断。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"恶人必遭恶报，","poem":1},{"lineBreak":true},{"text":"憎恨义人的必被定罪。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和华必救赎祂的仆人，","poem":1},{"lineBreak":true},{"text":"投靠祂的人必不被定罪。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}