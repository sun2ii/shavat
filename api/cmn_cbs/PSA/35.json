{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":35,"content":[{"type":"heading","content":["求上帝申冤"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你与我的敌人为敌，","poem":1},{"lineBreak":true},{"text":"攻击那些攻击我的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你拿起大小盾牌来帮助我，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"举起矛枪攻击追赶我的人。","poem":1},{"lineBreak":true},{"text":"求你对我说：","poem":1},{"lineBreak":true},{"text":"“我是你的拯救。”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"愿害我命的人蒙羞受辱，","poem":1},{"lineBreak":true},{"text":"谋害我的人落荒而逃！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愿耶和华的天使驱散他们，","poem":1},{"lineBreak":true},{"text":"如风吹散糠秕！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愿他们的道路漆黑湿滑，","poem":1},{"lineBreak":true},{"text":"有耶和华的天使在后追赶！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因为他们无故设网罗，","poem":1},{"lineBreak":true},{"text":"挖陷阱要害我性命。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愿他们突遭祸患，","poem":1},{"lineBreak":true},{"text":"愿他们作茧自缚，","poem":1},{"lineBreak":true},{"text":"愿他们自食恶果。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我要因耶和华而欢欣，","poem":1},{"lineBreak":true},{"text":"因祂的拯救而快乐。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我从心底发出赞叹：","poem":1},{"lineBreak":true},{"text":"“耶和华啊，谁能像你？","poem":1},{"lineBreak":true},{"text":"你拯救弱者免受强者欺压，","poem":1},{"lineBreak":true},{"text":"拯救穷困的人免遭掠夺。”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"恶人诬告我，","poem":1},{"lineBreak":true},{"text":"盘问我毫无所知的事情。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们对我以恶报善，","poem":1},{"lineBreak":true},{"text":"令我伤心欲绝。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他们生病时，","poem":1},{"lineBreak":true},{"text":"我披上麻衣，","poem":1},{"lineBreak":true},{"text":"谦卑地为他们禁食祷告，","poem":1},{"lineBreak":true},{"text":"但我的祷告未蒙垂听。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我为他们哀伤，","poem":1},{"lineBreak":true},{"text":"视他们为朋友、弟兄；","poem":1},{"lineBreak":true},{"text":"我低头为他们哭泣，","poem":1},{"lineBreak":true},{"text":"如同哀悼自己的母亲。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我遭遇患难时，","poem":1},{"lineBreak":true},{"text":"他们却聚在一起幸灾乐祸，","poem":1},{"lineBreak":true},{"text":"合伙攻击我。","poem":1},{"lineBreak":true},{"text":"素不相识的人也群起攻击我，","poem":1},{"lineBreak":true},{"text":"不住地毁谤我。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他们肆无忌惮地嘲弄我，","poem":1},{"lineBreak":true},{"text":"咬牙切齿地憎恶我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"你袖手旁观要到何时？","poem":1},{"lineBreak":true},{"text":"求你救我的性命免遭残害，","poem":1},{"lineBreak":true},{"text":"救我脱离这些狮子。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要在大会中称谢你，","poem":1},{"lineBreak":true},{"text":"在众人面前赞美你。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"求你不要让无故攻击我的人幸灾乐祸，","poem":1},{"lineBreak":true},{"text":"不要让无故恨我的人向我轻蔑地挤眼。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他们言语暴戾，","poem":1},{"lineBreak":true},{"text":"谋害安分守己的人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们轻蔑地高喊：“哈哈！哈哈！","poem":1},{"lineBreak":true},{"text":"我们亲眼看见了。”","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和华啊，这一切你都看见了，","poem":1},{"lineBreak":true},{"text":"求你不要再缄默。","poem":1},{"lineBreak":true},{"text":"主啊，求你不要远离我。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我的上帝，我的主啊，","poem":1},{"lineBreak":true},{"text":"求你起来为我辩护，为我申冤。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我的上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你按你的公义判我无罪，","poem":1},{"lineBreak":true},{"text":"别让他们幸灾乐祸。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"别让他们说：","poem":1},{"lineBreak":true},{"text":"“哈哈，我们如愿以偿了！”","poem":1},{"lineBreak":true},{"text":"别让他们说：","poem":1},{"lineBreak":true},{"text":"“我们除掉他了！”","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"愿幸灾乐祸的人蒙羞受辱，","poem":1},{"lineBreak":true},{"text":"愿自高自大的人无地自容！","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"愿盼望我冤屈得雪的人扬声欢呼！","poem":1},{"lineBreak":true},{"text":"愿他们常说：“耶和华当受尊崇！","poem":1},{"lineBreak":true},{"text":"祂乐意赐福给自己的仆人。”","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我要诉说你的公义，","poem":1},{"lineBreak":true},{"text":"终日赞美你。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}