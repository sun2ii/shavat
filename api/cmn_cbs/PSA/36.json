{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":36,"content":[{"type":"heading","content":["人的邪恶与上帝的美善"]},{"type":"hebrew_subtitle","content":["耶和华的仆人大卫的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"罪恶在恶人内心深处说话，","poem":1},{"lineBreak":true},{"text":"他们眼中对上帝毫无畏惧。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他们自以为是，浑然不知自己的罪，","poem":1},{"lineBreak":true},{"text":"也不憎恶自己的罪。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们满口恶言谎话，","poem":1},{"lineBreak":true},{"text":"毫无智慧和善行。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们躺在床上盘算作恶，","poem":1},{"lineBreak":true},{"text":"执意走罪恶的道路，","poem":1},{"lineBreak":true},{"text":"恶性不改。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华啊，你的慈爱广及诸天，","poem":1},{"lineBreak":true},{"text":"你的信实高达穹苍。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你的公义稳如高山，","poem":1},{"lineBreak":true},{"text":"你的判断深不可测。","poem":1},{"lineBreak":true},{"text":"耶和华啊，你保护人类，","poem":1},{"lineBreak":true},{"text":"也保护牲畜。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝啊，你的慈爱无比宝贵！","poem":1},{"lineBreak":true},{"text":"世人都投靠在你翅膀的荫下。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你让他们饱享你殿里的美食，","poem":1},{"lineBreak":true},{"text":"畅饮你乐河中的水。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为你那里有生命之泉，","poem":1},{"lineBreak":true},{"text":"在你的光中我们得见光。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"求你常施慈爱给认识你的人，","poem":1},{"lineBreak":true},{"text":"以公义恩待心地正直的人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"别让骄傲人的脚践踏我，","poem":1},{"lineBreak":true},{"text":"别让邪恶人的手驱赶我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"看啊！作恶的人已经倒下，","poem":1},{"lineBreak":true},{"text":"他们被击倒，再也起不来。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}