{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":37,"content":[{"type":"heading","content":["义人和恶人的结局"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"不要因为恶人而烦躁，","poem":1},{"lineBreak":true},{"text":"也不要羡慕不义之人，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为他们如瞬息枯萎的草芥，","poem":1},{"lineBreak":true},{"text":"又如转眼消逝的青草。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"要信靠耶和华，要行善，","poem":1},{"lineBreak":true},{"text":"要在这片土地上安然度日。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"要以耶和华为乐，","poem":1},{"lineBreak":true},{"text":"祂必成全你的心愿。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要把你的路交托给耶和华，","poem":1},{"lineBreak":true},{"text":"信靠祂，祂必帮助你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂使你的公义如晨光照耀，","poem":1},{"lineBreak":true},{"text":"使你的仁义如日中天。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"要在耶和华面前安静，","poem":1},{"lineBreak":true},{"text":"耐心等候祂，","poem":1},{"lineBreak":true},{"text":"不要因恶人道路通达、阴谋得逞而烦躁。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你要抑制怒气，除掉愤怒；","poem":1},{"lineBreak":true},{"text":"不要烦躁不安，","poem":1},{"lineBreak":true},{"text":"那会导致你作恶。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为作恶的必被消灭，","poem":1},{"lineBreak":true},{"text":"但等候耶和华的必承受土地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"再过片刻，恶人必不复存在，","poem":1},{"lineBreak":true},{"text":"虽寻遍其住处，也不见踪影。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"但谦卑人必承受土地，","poem":1},{"lineBreak":true},{"text":"得享太平昌盛。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"恶人谋害义人，","poem":1},{"lineBreak":true},{"text":"对他们咬牙切齿。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"但主嗤笑邪恶人，","poem":1},{"lineBreak":true},{"text":"因为祂知道他们末日将临。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"恶人拔剑张弓要消灭穷苦人，","poem":1},{"lineBreak":true},{"text":"杀戮正直人，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"但他们的剑必刺穿自己的心，","poem":1},{"lineBreak":true},{"text":"他们的弓必被折断。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"义人清贫一生强过恶人财富如山。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因为恶人的势力终必瓦解，","poem":1},{"lineBreak":true},{"text":"耶和华必扶持义人。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和华看顾纯全者的时日，","poem":1},{"lineBreak":true},{"text":"他们的产业永远长存。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他们在灾难中不致蒙羞，","poem":1},{"lineBreak":true},{"text":"在饥荒时仍得饱足。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"但恶人必灭亡，","poem":1},{"lineBreak":true},{"text":"耶和华的仇敌必像野地的花一样凋零，","poem":1},{"lineBreak":true},{"text":"消逝如烟。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"恶人借债不还，","poem":1},{"lineBreak":true},{"text":"义人慷慨给予。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"蒙耶和华赐福的人必承受土地，","poem":1},{"lineBreak":true},{"text":"被耶和华咒诅的人必遭铲除。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"耶和华巩固义人的脚步，","poem":1},{"lineBreak":true},{"text":"喜悦他们所走的路。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他们即使失脚，也不会跌倒，","poem":1},{"lineBreak":true},{"text":"因为耶和华的手扶持他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"从幼年到老年，","poem":1},{"lineBreak":true},{"text":"我从未见过义人遭弃，","poem":1},{"lineBreak":true},{"text":"也未见其后人讨饭。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他们总是乐善好施，","poem":1},{"lineBreak":true},{"text":"他们的后代都蒙祝福。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"你要离恶行善，","poem":1},{"lineBreak":true},{"text":"就必永远安居。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"因为耶和华喜爱公正，","poem":1},{"lineBreak":true},{"text":"不丢弃信靠祂的人，","poem":1},{"lineBreak":true},{"text":"永远保护他们。","poem":1},{"lineBreak":true},{"text":"恶人的后代必被铲除。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"义人必承受土地，","poem":1},{"lineBreak":true},{"text":"在地上永远安居。","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"义人口出智慧，诉说正义，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"铭记上帝的律法，","poem":1},{"lineBreak":true},{"text":"从不失脚。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"恶人窥探义人，","poem":1},{"lineBreak":true},{"text":"伺机谋害。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"但耶和华不会让他们落在恶人手中，","poem":1},{"lineBreak":true},{"text":"也不会让义人在审判时被定罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"要等候耶和华，","poem":1},{"lineBreak":true},{"text":"坚守祂的道，","poem":1},{"lineBreak":true},{"text":"祂必赐你土地，使你有尊荣。","poem":1},{"lineBreak":true},{"text":"你必亲眼看见恶人被铲除。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"我见过邪恶残暴之人，","poem":1},{"lineBreak":true},{"text":"势如本地青翠的香柏树，","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"再一看，他已经消失得无影无踪，","poem":1},{"lineBreak":true},{"text":"我寻找他，却找不到。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"你观察那纯全正直的人，","poem":1},{"lineBreak":true},{"text":"因为和平的人前途美好。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"罪人必同遭毁灭，","poem":1},{"lineBreak":true},{"text":"恶人必没有前途。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"耶和华拯救义人，","poem":1},{"lineBreak":true},{"text":"患难时作他们的庇护所。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"耶和华救助他们，","poem":1},{"lineBreak":true},{"text":"救他们脱离恶人，拯救他们，","poem":1},{"lineBreak":true},{"text":"因为他们投靠祂。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}