{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":38,"content":[{"type":"heading","content":["受苦者的祈求"]},{"type":"hebrew_subtitle","content":["大卫作的祷告诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你不要发怒责罚我，","poem":1},{"lineBreak":true},{"text":"不要在烈怒下管教我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为你的箭射穿我，","poem":1},{"lineBreak":true},{"text":"你的手击打我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的怒气使我浑身是病，","poem":1},{"lineBreak":true},{"text":"我的罪恶使我骨头朽烂。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的罪恶滔天，如同重担压身。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我因愚昧而伤口发臭流脓。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我疼得弯腰驼背，","poem":1},{"lineBreak":true},{"text":"终日哀伤。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的腰灼痛难忍，","poem":1},{"lineBreak":true},{"text":"我浑身是病。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我精疲力尽，彻底崩溃；","poem":1},{"lineBreak":true},{"text":"我心中悲伤，呻吟不止。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"主啊，我的渴望都显露在你面前，","poem":1},{"lineBreak":true},{"text":"我的叹息瞒不过你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的心砰砰直跳，","poem":1},{"lineBreak":true},{"text":"力量衰竭，","poem":1},{"lineBreak":true},{"text":"眼睛黯淡无光。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因我的疾病，朋友同伴回避我，","poem":1},{"lineBreak":true},{"text":"亲人避而远之。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"要我命的人设下陷阱，","poem":1},{"lineBreak":true},{"text":"想害我的人威胁我，","poem":1},{"lineBreak":true},{"text":"他们整天图谋奸计。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"但我像耳聋的人一样听不见，","poem":1},{"lineBreak":true},{"text":"又像无法说话的哑巴。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我就像一个不能听、不能辩的人。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和华啊，我等候你；","poem":1},{"lineBreak":true},{"text":"主，我的上帝啊，你必应允我。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我曾求告你，","poem":1},{"lineBreak":true},{"text":"别让他们幸灾乐祸，","poem":1},{"lineBreak":true},{"text":"在我失脚时沾沾自喜。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我快要跌倒，","poem":1},{"lineBreak":true},{"text":"我的痛苦常伴。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要承认我的罪过，","poem":1},{"lineBreak":true},{"text":"罪恶使我心里惴惴不安。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的仇敌势力强大，","poem":1},{"lineBreak":true},{"text":"无故恨我的人不计其数。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我追求良善，","poem":1},{"lineBreak":true},{"text":"他们就恨我，以恶报善。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和华啊，求你不要撇弃我！","poem":1},{"lineBreak":true},{"text":"我的上帝啊，求你不要远离我！","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"拯救我的主啊，","poem":1},{"lineBreak":true},{"text":"求你快来帮助我！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}