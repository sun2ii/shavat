{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":39,"content":[{"type":"heading","content":["受苦者的呼求"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长耶杜顿。"]},{"type":"verse","number":1,"content":[{"text":"我说：“我要谨言慎行，","poem":1},{"lineBreak":true},{"text":"免犯口舌之罪。","poem":1},{"lineBreak":true},{"text":"只要身边有恶人，","poem":1},{"lineBreak":true},{"text":"我就用嚼环勒住自己的口。”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"然而，我默不作声，","poem":1},{"lineBreak":true},{"text":"连好话也不出口时，","poem":1},{"lineBreak":true},{"text":"内心就更加痛苦。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我心如火烧，越沉思越烦躁，","poem":1},{"lineBreak":true},{"text":"便开口呼求：","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“耶和华啊，求你让我知道我人生的终点和寿数，","poem":1},{"lineBreak":true},{"text":"明白人生何其短暂。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你使我的生命转瞬即逝，","poem":1},{"lineBreak":true},{"text":"我的岁月在你眼中不到片刻。","poem":1},{"lineBreak":true},{"text":"人的生命不过是一丝气息，（细拉）","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"人生不过是幻影，","poem":1},{"lineBreak":true},{"text":"劳碌奔波却一场空，","poem":1},{"lineBreak":true},{"text":"积蓄财富却不知谁来享用。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"主啊，如今我等候什么呢？","poem":1},{"lineBreak":true},{"text":"你是我的盼望。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你救我脱离一切过犯，","poem":1},{"lineBreak":true},{"text":"不要让愚昧人嘲笑我。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我默然不语，一言不发，","poem":1},{"lineBreak":true},{"text":"因为我受的责罚是出于你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"求你不要再惩罚我，","poem":1},{"lineBreak":true},{"text":"你的责打使我几乎丧命。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因为人犯罪，你责罚管教他们，","poem":1},{"lineBreak":true},{"text":"如同蛀虫吞噬他们所爱的。","poem":1},{"lineBreak":true},{"text":"世人不过是一丝气息。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你垂听我的祷告，","poem":1},{"lineBreak":true},{"text":"倾听我的呼求，","poem":1},{"lineBreak":true},{"text":"别对我的眼泪无动于衷。","poem":1},{"lineBreak":true},{"text":"因为我在你面前只是客旅，","poem":1},{"lineBreak":true},{"text":"是寄居的，","poem":1},{"lineBreak":true},{"text":"正如我的祖先。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"求你宽恕我，","poem":1},{"lineBreak":true},{"text":"好让我在离世之前能重展笑容。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}