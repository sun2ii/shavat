{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":40,"content":[{"type":"heading","content":["赞美上帝之歌"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"我曾耐心等候耶和华，","poem":1},{"lineBreak":true},{"text":"祂垂听了我的呼求。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"祂把我从绝望的深渊拉出来，","poem":1},{"lineBreak":true},{"text":"救我脱离泥泞沼泽，","poem":1},{"lineBreak":true},{"text":"把我安置在磐石上，","poem":1},{"lineBreak":true},{"text":"使我步履稳健。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂赐给我一首新歌，","poem":1},{"lineBreak":true},{"text":"一首赞美我们上帝的诗歌。","poem":1},{"lineBreak":true},{"text":"许多人看见便敬畏、信靠耶和华。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"信靠耶和华的人有福了！","poem":1},{"lineBreak":true},{"text":"他们不随从骄傲自大、信靠假神的人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"你行了许多奇事，","poem":1},{"lineBreak":true},{"text":"为我们定了许多美好的计划，","poem":1},{"lineBreak":true},{"text":"谁能与你相比！","poem":1},{"lineBreak":true},{"text":"你奇妙的作为不可胜数，述说不尽。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祭物和供物非你所悦，","poem":1},{"lineBreak":true},{"text":"你开通了我的耳朵，","poem":1},{"lineBreak":true},{"text":"燔祭和赎罪祭非你所要。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"于是我说：","poem":1},{"lineBreak":true},{"text":"“看啊，我来了，","poem":1},{"lineBreak":true},{"text":"正如经卷上关于我的记载。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"我乐意遵行你的旨意，","poem":1},{"lineBreak":true},{"text":"我铭记你的律法。”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我在大会中宣扬你的公义，","poem":1},{"lineBreak":true},{"text":"耶和华啊，你知道我没有闭口不言。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我述说你的信实和拯救之恩，","poem":1},{"lineBreak":true},{"text":"没有把你的公义埋没在心，","poem":1},{"lineBreak":true},{"text":"没有对会众避而不谈你的慈爱和真理。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你不要向我止住你的怜悯，","poem":1},{"lineBreak":true},{"text":"愿你的慈爱和真理时刻守护我！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我患难重重，罪恶缠身，","poem":1},{"lineBreak":true},{"text":"以致挡住我的视线。","poem":1},{"lineBreak":true},{"text":"我的罪过比我的头发还多，","poem":1},{"lineBreak":true},{"text":"我心惊胆战。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华啊，求你施恩搭救我！","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你快来帮助我！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"愿谋取我性命的人蒙羞受辱！","poem":1},{"lineBreak":true},{"text":"愿喜欢我遭害的人抱愧而逃！","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愿那些哈哈嘲笑我的人羞愧难当！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"愿所有寻求你的人因你而欢喜快乐！","poem":1},{"lineBreak":true},{"text":"愿渴望蒙你拯救的人时常说：","poem":1},{"lineBreak":true},{"text":"“耶和华至大！”","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我贫穷困苦，","poem":1},{"lineBreak":true},{"text":"但主眷顾我。","poem":1},{"lineBreak":true},{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"你是我的帮助、我的拯救，","poem":1},{"lineBreak":true},{"text":"求你不要迟延！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}