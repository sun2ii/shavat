{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":41,"content":[{"type":"heading","content":["病中的祷告"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"善待穷人的有福了！","poem":1},{"lineBreak":true},{"text":"患难之日，耶和华必救他们。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华必保护他们，","poem":1},{"lineBreak":true},{"text":"救他们的性命，","poem":1},{"lineBreak":true},{"text":"使他们在地上享福，","poem":1},{"lineBreak":true},{"text":"不让仇敌恶谋得逞。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们卧病在床，","poem":1},{"lineBreak":true},{"text":"耶和华必扶持他们，","poem":1},{"lineBreak":true},{"text":"使他们恢复健康。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我祷告说：“耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你怜悯我，医治我，","poem":1},{"lineBreak":true},{"text":"因为我得罪了你。”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的仇敌恶言议论我，说：","poem":1},{"lineBreak":true},{"text":"“他何时才会死，","poem":1},{"lineBreak":true},{"text":"并且名字被人遗忘呢？”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们来看我时，","poem":1},{"lineBreak":true},{"text":"心怀恶意，满口谎言，","poem":1},{"lineBreak":true},{"text":"出去后散布流言。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"所有恨我的人都交头接耳，","poem":1},{"lineBreak":true},{"text":"设计害我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们说：“他患了恶病，","poem":1},{"lineBreak":true},{"text":"再也从卧榻上起不来了！”","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"连我所信赖、吃我饭的挚友也用脚踢我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你怜悯我，叫我痊愈，","poem":1},{"lineBreak":true},{"text":"我好报复他们。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我知道你喜悦我，","poem":1},{"lineBreak":true},{"text":"因为你没有让仇敌胜过我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你因我纯全而扶持我，","poem":1},{"lineBreak":true},{"text":"让我永远侍立在你面前。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"以色列的上帝耶和华永永远远当受称颂。","poem":1},{"lineBreak":true},{"text":"阿们！阿们！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}