{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":44,"content":[{"type":"heading","content":["祈求上帝保护"]},{"type":"hebrew_subtitle","content":["可拉后裔作的训诲诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"我们亲耳听过祖先讲述你在古时，","poem":1},{"lineBreak":true},{"text":"在我们祖先时代的作为。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你亲手赶出外族，","poem":1},{"lineBreak":true},{"text":"把我们的祖先安置在那里；","poem":1},{"lineBreak":true},{"text":"你击溃列邦，","poem":1},{"lineBreak":true},{"text":"使我们的祖先兴旺发达。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们不是靠自己的刀剑征服那里，","poem":1},{"lineBreak":true},{"text":"不是靠自己的臂膀得胜，","poem":1},{"lineBreak":true},{"text":"而是靠你的右手、你的臂膀和你的容光，","poem":1},{"lineBreak":true},{"text":"因为你爱他们。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你是我的君王，我的上帝；","poem":1},{"lineBreak":true},{"text":"你命定雅各得胜。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我们靠你击退敌人，","poem":1},{"lineBreak":true},{"text":"靠你的名践踏仇敌。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我不倚靠我的弓，","poem":1},{"lineBreak":true},{"text":"我的剑不能使我得胜。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"只有你救我们脱离敌人，","poem":1},{"lineBreak":true},{"text":"使我们的仇敌蒙羞。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我们终日凭上帝夸耀，","poem":1},{"lineBreak":true},{"text":"我们永远赞美你的名。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"现在你却丢弃我们，让我们受辱，","poem":1},{"lineBreak":true},{"text":"不再同我们的军队出战。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你使我们在仇敌面前败退，","poem":1},{"lineBreak":true},{"text":"遭敌人掳掠。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你使我们如被宰杀的羊，","poem":1},{"lineBreak":true},{"text":"将我们分散在列国。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你把我们廉价卖掉，","poem":1},{"lineBreak":true},{"text":"并未从买卖中获利。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你使我们遭四邻辱骂，","poem":1},{"lineBreak":true},{"text":"被周围人讥讽、嘲笑。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你使我们成为列国的笑柄，","poem":1},{"lineBreak":true},{"text":"列邦对我们连连摇头。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我终日受辱，满脸尽是耻辱，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因为咒骂和毁谤我的人讥笑我，","poem":1},{"lineBreak":true},{"text":"仇敌报复我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"虽然这一切临到我们身上，","poem":1},{"lineBreak":true},{"text":"我们却没有忘记你，","poem":1},{"lineBreak":true},{"text":"也没有违背你的约。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我们对你没有异心，","poem":1},{"lineBreak":true},{"text":"也没有偏离你的道路。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你在豺狼出没的地方压碎我们，","poem":1},{"lineBreak":true},{"text":"使死亡的阴影笼罩我们。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"倘若我们忘记我们上帝的名，","poem":1},{"lineBreak":true},{"text":"或举手向外邦的神明祷告，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"上帝难道察觉不到吗？","poem":1},{"lineBreak":true},{"text":"祂洞悉人心中的秘密。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"为了你，我们终日出生入死，","poem":1},{"lineBreak":true},{"text":"被视为待宰的羊。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"主啊，求你醒来，","poem":1},{"lineBreak":true},{"text":"你为何沉睡？","poem":1},{"lineBreak":true},{"text":"求你起来，不要永远丢弃我们。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你为何掩面不理我们，","poem":1},{"lineBreak":true},{"text":"忘记我们所受的苦难和压迫？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我们仆倒在地，横卧在尘土中。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"求你起来帮助我们，","poem":1},{"lineBreak":true},{"text":"因你的慈爱而救赎我们。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}