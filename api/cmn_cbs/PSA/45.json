{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":45,"content":[{"type":"heading","content":["婚礼诗歌"]},{"type":"hebrew_subtitle","content":["可拉后裔作的训诲诗，也是情歌，交给乐长，调用“百合花”。"]},{"type":"verse","number":1,"content":[{"text":"我心中涌出美丽的诗章，","poem":1},{"lineBreak":true},{"text":"我要把它献给王，","poem":1},{"lineBreak":true},{"text":"我的舌头是诗人手上的妙笔。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你俊美无比，口出恩言，","poem":1},{"lineBreak":true},{"text":"因此上帝永远赐福给你。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"英勇的王啊，","poem":1},{"lineBreak":true},{"text":"佩上你的宝剑，","poem":1},{"lineBreak":true},{"text":"展示你的尊贵和威严！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你威严无比，所向披靡，","poem":1},{"lineBreak":true},{"text":"捍卫真理、谦卑和公义。","poem":1},{"lineBreak":true},{"text":"愿你的右手彰显可畏的作为！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的利箭刺穿敌人的心窝，","poem":1},{"lineBreak":true},{"text":"列国臣服在你脚下。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"上帝啊，你的宝座永远长存，","poem":1},{"lineBreak":true},{"text":"你以公义的杖执掌王权。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你喜爱公义，憎恶邪恶，","poem":1},{"lineBreak":true},{"text":"所以上帝，你的上帝，","poem":1},{"lineBreak":true},{"text":"用喜乐之油膏你，","poem":1},{"lineBreak":true},{"text":"使你超过同伴。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你的衣袍散发出没药、沉香和肉桂的芬芳，","poem":1},{"lineBreak":true},{"text":"你陶醉在象牙宫的弦乐中。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"众公主在你的贵客中，","poem":1},{"lineBreak":true},{"text":"戴俄斐金饰的王后站在你右边。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"女子啊，要聆听，","poem":1},{"lineBreak":true},{"text":"要侧耳倾听：不要再挂念家乡的父老，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"王就会喜欢你的美貌，","poem":1},{"lineBreak":true},{"text":"你要敬重他，因他是你的主。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"泰尔人必来送礼，","poem":1},{"lineBreak":true},{"text":"富人必来取悦你。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"公主身穿金线衣，无比华贵。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"她身披锦绣，","poem":1},{"lineBreak":true},{"text":"由侍女伴随前来见王，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"她们欢喜快乐地被带入王宫。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你的子孙将来要继承祖先的王位，","poem":1},{"lineBreak":true},{"text":"你要立他们在各地做王。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我要使万代铭记你的名，","poem":1},{"lineBreak":true},{"text":"列邦必永远称谢你。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}