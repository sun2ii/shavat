{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":46,"content":[{"type":"heading","content":["上帝与我们同在"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗，交给乐长，调用女高音。"]},{"type":"verse","number":1,"content":[{"text":"上帝是我们的避难所，","poem":1},{"lineBreak":true},{"text":"是我们的力量，","poem":1},{"lineBreak":true},{"text":"是我们患难中随时的帮助。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因此，任大地震动，","poem":1},{"lineBreak":true},{"text":"群山沉入深海；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"任海涛汹涌澎湃，","poem":1},{"lineBreak":true},{"text":"群山摇撼颤抖，","poem":1},{"lineBreak":true},{"text":"我们也不惧怕。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"有一条河的支流给上帝的城，","poem":1},{"lineBreak":true},{"text":"给至高者的圣所带来喜乐。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝住在里面，","poem":1},{"lineBreak":true},{"text":"城必屹立不倒。","poem":1},{"lineBreak":true},{"text":"天一亮，上帝必帮助这城。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"列邦动荡，列国倾覆。","poem":1},{"lineBreak":true},{"text":"上帝的声音使大地熔化。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"万军之耶和华与我们同在，","poem":1},{"lineBreak":true},{"text":"雅各的上帝是我们的堡垒。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你们来看耶和华的作为吧！","poem":1},{"lineBreak":true},{"text":"祂使大地荒凉。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂平息天下的战争，","poem":1},{"lineBreak":true},{"text":"祂断弓、折枪、烧毁盾牌。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂说：“要安静，","poem":1},{"lineBreak":true},{"text":"要知道我是上帝，","poem":1},{"lineBreak":true},{"text":"我必在列国受尊崇，","poem":1},{"lineBreak":true},{"text":"在普世受尊崇。”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"万军之耶和华与我们同在，","poem":1},{"lineBreak":true},{"text":"雅各的上帝是我们的堡垒。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}