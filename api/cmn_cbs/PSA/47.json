{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":47,"content":[{"type":"heading","content":["至高的主宰"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"万民啊，你们要鼓掌，","poem":1},{"lineBreak":true},{"text":"向上帝高声欢呼！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为至高者耶和华当受敬畏，","poem":1},{"lineBreak":true},{"text":"祂是掌管天下的大君王。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂使列国降服于我们，","poem":1},{"lineBreak":true},{"text":"让列邦伏在我们脚下。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂为我们选定产业，","poem":1},{"lineBreak":true},{"text":"就是祂所爱的雅各引以为荣的产业。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"上帝在欢呼声中登上宝座；","poem":1},{"lineBreak":true},{"text":"耶和华在角声中登上宝座。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"要歌颂，歌颂上帝！","poem":1},{"lineBreak":true},{"text":"要歌颂，歌颂我们的君王！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因为上帝是普天下的君王，","poem":1},{"lineBreak":true},{"text":"要向祂唱颂赞的乐章。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"上帝坐在圣洁的宝座上治理列国。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"列邦的首领聚集在一起，","poem":1},{"lineBreak":true},{"text":"要做亚伯拉罕之上帝的子民，","poem":1},{"lineBreak":true},{"text":"因为上帝主宰世上的君王，","poem":1},{"lineBreak":true},{"text":"祂至高无上。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}