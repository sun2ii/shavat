{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":48,"content":[{"type":"heading","content":["上帝的城锡安"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华何等伟大！","poem":1},{"lineBreak":true},{"text":"我们的上帝在祂的城中，","poem":1},{"lineBreak":true},{"text":"在祂的圣山上当大受颂赞。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"北面的锡安山雄伟壮丽，","poem":1},{"lineBreak":true},{"text":"令世人欢喜，","poem":1},{"lineBreak":true},{"text":"是伟大君王的城。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝在城内的殿宇中，","poem":1},{"lineBreak":true},{"text":"祂亲自做这城的庇护。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"世上的君王一同聚集，齐来攻城。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们看见这城后，","poem":1},{"lineBreak":true},{"text":"大惊失色，慌忙逃跑。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们被恐惧笼罩，","poem":1},{"lineBreak":true},{"text":"痛苦如分娩的妇人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你毁灭他们，","poem":1},{"lineBreak":true},{"text":"如同东风摧毁他施的船只。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我们曾经听说，如今在万军之耶和华的城中，","poem":1},{"lineBreak":true},{"text":"在我们上帝的城中亲眼看见：","poem":1},{"lineBreak":true},{"text":"上帝要坚立这城，直到永远。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"上帝啊，我们在你的殿中默想你的慈爱。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，你秉公行义，","poem":1},{"lineBreak":true},{"text":"你的名普世皆知，","poem":1},{"lineBreak":true},{"text":"颂赞你的声音响彻地极。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因你的审判，","poem":1},{"lineBreak":true},{"text":"锡安山欢喜，","poem":1},{"lineBreak":true},{"text":"犹大的城邑充满快乐。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你们要围绕锡安数点她的城楼，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"留意她的城墙，","poem":1},{"lineBreak":true},{"text":"观看她的殿宇，","poem":1},{"lineBreak":true},{"text":"好告诉子孙后代。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因为上帝永永远远是我们的上帝，","poem":1},{"lineBreak":true},{"text":"祂必引领我们，","poem":1},{"lineBreak":true},{"text":"直到我们离世之日。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}