{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":49,"content":[{"type":"heading","content":["财富的虚幻"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"万民啊，你们要听！","poem":1},{"lineBreak":true},{"text":"世人啊，要侧耳听！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"不论贵贱贫富，都要留心听！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为我口出智慧，我心思明智。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要侧耳听箴言，","poem":1},{"lineBreak":true},{"text":"弹琴解释谜语。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"危难来临，四面被奸诈之徒包围时，我何必惧怕？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们倚靠金钱、夸耀财富，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"却不能救赎自己的生命，","poem":1},{"lineBreak":true},{"text":"也无法向上帝付生命的赎价。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因为生命的赎价高昂，","poem":1},{"lineBreak":true},{"text":"无人付得起，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"以致可以永远活着，不进坟墓。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"诚如所见，即使智者也要死去，","poem":1},{"lineBreak":true},{"text":"愚人和庸者也要灭亡，","poem":1},{"lineBreak":true},{"text":"将他们的财富留给别人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"尽管他们用自己的名字来为产业命名，","poem":1},{"lineBreak":true},{"text":"坟墓却是他们永远的归宿，","poem":1},{"lineBreak":true},{"text":"世代的住处。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"人不能长享富贵，","poem":1},{"lineBreak":true},{"text":"终必死去，与兽无异。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"这就是愚昧人及其追随者的下场！（细拉）","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们注定要死，与羊无异，","poem":1},{"lineBreak":true},{"text":"死亡是他们的牧者；","poem":1},{"lineBreak":true},{"text":"到了早晨，","poem":1},{"lineBreak":true},{"text":"他们必被正直人管辖。","poem":1},{"lineBreak":true},{"text":"他们的躯体必烂在阴间，","poem":1},{"lineBreak":true},{"text":"远离自己的豪宅。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"但上帝必救赎我的生命脱离阴间的权势，","poem":1},{"lineBreak":true},{"text":"并接我到祂身边。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"当他人财富增多，日益奢华，","poem":1},{"lineBreak":true},{"text":"不要害怕。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因为他们死时什么也带不走，","poem":1},{"lineBreak":true},{"text":"他们的荣华不会跟进坟墓。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们活着时自以为有福，","poem":1},{"lineBreak":true},{"text":"人们都赞扬他们的成就，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"到头来他们还是要归到祖先那里，","poem":1},{"lineBreak":true},{"text":"再也看不见光明。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"人有财富，却无明智的心，","poem":1},{"lineBreak":true},{"text":"无异于必死的兽类。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}