{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":5,"content":[{"type":"heading","content":["求上帝保护"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长，用管乐器。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你垂听我的祷告，","poem":1},{"lineBreak":true},{"text":"顾念我的哀叹。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的王，我的上帝啊！","poem":1},{"lineBreak":true},{"text":"求你倾听我的呼求，","poem":1},{"lineBreak":true},{"text":"因为我向你祈祷。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华啊！早晨你听我的祷告。","poem":1},{"lineBreak":true},{"text":"早晨我到你面前祈求，","poem":1},{"lineBreak":true},{"text":"切切等候。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你不是一位喜欢邪恶的上帝，","poem":1},{"lineBreak":true},{"text":"恶人不能与你同住。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"狂妄之人不能站在你面前，","poem":1},{"lineBreak":true},{"text":"你憎恶一切作恶之人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"说谎的，你毁灭；","poem":1},{"lineBreak":true},{"text":"凶残诡诈的，你痛恨。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"但我要凭你丰盛的慈爱进入你的居所，","poem":1},{"lineBreak":true},{"text":"我要怀着敬畏向你的圣殿下拜。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华啊，因为仇敌环伺，","poem":1},{"lineBreak":true},{"text":"求你以公义引领我，","poem":1},{"lineBreak":true},{"text":"使我走你安排的正路。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们口中毫无实话，","poem":1},{"lineBreak":true},{"text":"心里充满恶毒，","poem":1},{"lineBreak":true},{"text":"喉咙是敞开的坟墓，","poem":1},{"lineBreak":true},{"text":"舌头上尽是诡诈。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"求你定他们的罪，","poem":1},{"lineBreak":true},{"text":"让他们作茧自缚。","poem":1},{"lineBreak":true},{"text":"他们背叛你，罪恶深重，","poem":1},{"lineBreak":true},{"text":"求你把他们赶走。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"愿投靠你的人快乐，欢歌不断。","poem":1},{"lineBreak":true},{"text":"求你庇护他们，","poem":1},{"lineBreak":true},{"text":"让爱你名的人因你而喜乐。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华啊，你必赐福给义人，","poem":1},{"lineBreak":true},{"text":"你的恩惠像盾牌四面保护他们。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}