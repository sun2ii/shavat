{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":50,"content":[{"type":"heading","content":["真正的敬拜"]},{"type":"hebrew_subtitle","content":["亚萨的诗。"]},{"type":"verse","number":1,"content":[{"text":"从日出之地到日落之处，","poem":1},{"lineBreak":true},{"text":"大能的上帝耶和华召唤世人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"上帝从完美的锡安发光。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我们的上帝来临，","poem":1},{"lineBreak":true},{"text":"并非悄然无声，","poem":1},{"lineBreak":true},{"text":"祂前面有烈火燃烧，","poem":1},{"lineBreak":true},{"text":"周围有暴风怒吼。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂召唤天地，","poem":1},{"lineBreak":true},{"text":"为要审判祂的子民。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂说：“把我的圣民招聚到我这里，","poem":1},{"lineBreak":true},{"text":"就是那些用祭物和我立约的人。”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"诸天宣扬上帝的公义，","poem":1},{"lineBreak":true},{"text":"因为上帝是审判官。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"祂说：“我的子民啊，听我说！","poem":1},{"lineBreak":true},{"text":"以色列啊，我要指控你！","poem":1},{"lineBreak":true},{"text":"我是上帝，是你的上帝。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我责怪你，不是因为你的祭物，","poem":1},{"lineBreak":true},{"text":"也不是因为你经常献给我的燔祭。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我不需要你棚里的公牛和圈里的山羊，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因为林中的百兽是我的，","poem":1},{"lineBreak":true},{"text":"群山上的牲畜是我的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我知道山中所有的飞鸟，","poem":1},{"lineBreak":true},{"text":"田野的动物都是我的。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"就是我饿了，也不用告诉你，","poem":1},{"lineBreak":true},{"text":"因为世界和其中的一切都是我的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"难道我吃公牛的肉，","poem":1},{"lineBreak":true},{"text":"喝山羊的血吗？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你要向上帝献上感恩祭，","poem":1},{"lineBreak":true},{"text":"向至高者兑现誓言，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"在患难中呼求我，","poem":1},{"lineBreak":true},{"text":"我必拯救你，你必尊崇我。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"但上帝对恶人说：","poem":1},{"lineBreak":true},{"text":"“你怎能背诵我的律法，","poem":1},{"lineBreak":true},{"text":"口中谈论我的约？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你憎恶我的管教，","poem":1},{"lineBreak":true},{"text":"把我的话抛在脑后。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你见了盗贼就与他同流合污，","poem":1},{"lineBreak":true},{"text":"又喜欢与淫乱的人交往。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你满口恶言，谎话连篇。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你坐着陷害自己的兄弟，","poem":1},{"lineBreak":true},{"text":"毁谤自己的同胞兄弟。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我对你的所作所为默然不语，","poem":1},{"lineBreak":true},{"text":"你就以为我与你是同道。","poem":1},{"lineBreak":true},{"text":"现在我要责备你，","poem":1},{"lineBreak":true},{"text":"当面指出你的罪状。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"忘记上帝的人啊，","poem":1},{"lineBreak":true},{"text":"你们要省察，","poem":1},{"lineBreak":true},{"text":"免得我撕碎你们，","poem":1},{"lineBreak":true},{"text":"那时谁也救不了你们。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"向我献上感恩就是尊崇我，","poem":1},{"lineBreak":true},{"text":"我必拯救走正路的人。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}