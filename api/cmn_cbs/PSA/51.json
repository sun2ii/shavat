{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":51,"content":[{"type":"heading","content":["祈求上帝赦免"]},{"type":"hebrew_subtitle","content":["大卫与拔示巴通奸后，先知拿单来找他，他作了此诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你按你的慈爱怜悯我；","poem":1},{"lineBreak":true},{"text":"按你极大的怜悯除去我的过犯。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你洗净我的罪过，","poem":1},{"lineBreak":true},{"text":"清除我的罪恶。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我知道自己的过犯，","poem":1},{"lineBreak":true},{"text":"我的罪恶一直萦绕眼前。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我犯罪得罪了你，","poem":1},{"lineBreak":true},{"text":"唯独得罪了你，","poem":1},{"lineBreak":true},{"text":"做了你看为邪恶的事，","poem":1},{"lineBreak":true},{"text":"所以你责备我是正当的，","poem":1},{"lineBreak":true},{"text":"你对我的审判是公正的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我生来就是个罪人，","poem":1},{"lineBreak":true},{"text":"在母腹成胎的时候就有罪。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你所喜爱的是内心的诚实，","poem":1},{"lineBreak":true},{"text":"求你使我内心有智慧。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你用牛膝草洁净我的罪，","poem":1},{"lineBreak":true},{"text":"使我干净；","poem":1},{"lineBreak":true},{"text":"求你洗净我，使我比雪更白。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你让我听到欢喜快乐的声音，","poem":1},{"lineBreak":true},{"text":"让我这被你压碎的骨头可以欢乐。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你掩面不看我的罪过，","poem":1},{"lineBreak":true},{"text":"除去我一切的罪恶。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"求你为我造一颗纯洁的心，","poem":1},{"lineBreak":true},{"text":"使我里面重新有正直的灵。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"不要丢弃我，","poem":1},{"lineBreak":true},{"text":"使我离开你，","poem":1},{"lineBreak":true},{"text":"也不要从我身上收回你的圣灵。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你让我重新享受蒙你拯救的喜乐，","poem":1},{"lineBreak":true},{"text":"赐我一个乐意顺服你的心灵。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我就会把你的法则教导悖逆之人，","poem":1},{"lineBreak":true},{"text":"使罪人归向你。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"上帝啊，拯救我的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你救我脱离杀人流血的罪，","poem":1},{"lineBreak":true},{"text":"使我开口颂扬你的公义。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"主啊，求你开我的嘴唇，","poem":1},{"lineBreak":true},{"text":"我的口要向你发出赞美。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你不喜欢祭物，","poem":1},{"lineBreak":true},{"text":"否则我会献上，","poem":1},{"lineBreak":true},{"text":"你也不喜爱燔祭。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你所要的祭是忧伤的心灵。","poem":1},{"lineBreak":true},{"text":"上帝啊，你必不轻看忧伤痛悔的心。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你恩待锡安，重建耶路撒冷的城墙。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"那时，你必悦纳诚心献上的祭物、燔祭和全牲燔祭，","poem":1},{"lineBreak":true},{"text":"人们必把公牛献在你的坛上。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}