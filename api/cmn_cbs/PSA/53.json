{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":53,"content":[{"type":"heading","content":["人的邪恶"]},{"type":"hebrew_subtitle","content":["大卫作的训诲诗，交给乐长，调用“麻哈拉”。"]},{"type":"verse","number":1,"content":[{"text":"愚昧人心里想：","poem":1},{"lineBreak":true},{"text":"“没有上帝。”","poem":1},{"lineBreak":true},{"text":"他们全然败坏，行为邪恶，","poem":1},{"lineBreak":true},{"text":"无人行善。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"上帝从天上俯视人间，","poem":1},{"lineBreak":true},{"text":"要看有没有明智者，","poem":1},{"lineBreak":true},{"text":"有没有寻求上帝的人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人人偏离正道，","poem":1},{"lineBreak":true},{"text":"一同堕落，无人行善，","poem":1},{"lineBreak":true},{"text":"连一个也没有。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"恶人吞吃我的百姓如同吃饭，","poem":1},{"lineBreak":true},{"text":"他们不求告上帝。","poem":1},{"lineBreak":true},{"text":"难道他们都无知吗？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们平白无故地充满恐惧。","poem":1},{"lineBreak":true},{"text":"上帝必使攻击你的仇敌粉身碎骨，","poem":1},{"lineBreak":true},{"text":"你必使他们蒙羞受辱，","poem":1},{"lineBreak":true},{"text":"因为上帝弃绝了他们。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愿以色列的拯救来自锡安。","poem":1},{"lineBreak":true},{"text":"上帝救回祂被掳的子民时，","poem":1},{"lineBreak":true},{"text":"雅各要欢喜，以色列要快乐。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}