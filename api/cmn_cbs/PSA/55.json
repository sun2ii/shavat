{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":55,"content":[{"type":"heading","content":["被朋友出卖者的祷告"]},{"type":"hebrew_subtitle","content":["大卫作的训诲诗，交给乐长，用弦乐器。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"求你垂听我的祷告，","poem":1},{"lineBreak":true},{"text":"不要对我的呼求置之不理。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你垂听、应允我的呼求。","poem":1},{"lineBreak":true},{"text":"我思绪烦乱，坐立不安。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"仇敌向我咆哮，","poem":1},{"lineBreak":true},{"text":"恶人迫害我。","poem":1},{"lineBreak":true},{"text":"他们带给我苦难，","poem":1},{"lineBreak":true},{"text":"怒气冲冲地攻击我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我内心悲痛，","poem":1},{"lineBreak":true},{"text":"被死亡的恐怖笼罩。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我吓得浑身颤栗，惊恐不已。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我说：“但愿我像鸽子一样有翅膀，","poem":1},{"lineBreak":true},{"text":"我好飞去，得享安息。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我要飞到远方，宿在旷野。（细拉）","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我要赶快躲进避难所，","poem":1},{"lineBreak":true},{"text":"避过暴雨狂风。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"主啊，","poem":1},{"lineBreak":true},{"text":"我在城中看见暴力和争斗，","poem":1},{"lineBreak":true},{"text":"求你使他们言语混乱。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们昼夜在城墙上出没，","poem":1},{"lineBreak":true},{"text":"城内充满了邪恶和压迫，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"毁坏的势力在城内肆虐，","poem":1},{"lineBreak":true},{"text":"恐吓与欺诈遍布街市。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"倘若是仇敌辱骂我，","poem":1},{"lineBreak":true},{"text":"我还能忍受；","poem":1},{"lineBreak":true},{"text":"倘若是恨我的人欺凌我，","poem":1},{"lineBreak":true},{"text":"我还可以躲开。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"可是，竟然是你，我志同道合的伙伴，我的挚友！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"从前我们情谊深厚，","poem":1},{"lineBreak":true},{"text":"与众人同去上帝的殿。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愿死亡突然抓住我的仇敌，","poem":1},{"lineBreak":true},{"text":"愿他们活活地下阴间，","poem":1},{"lineBreak":true},{"text":"因为他们的内心和家中罪恶充斥。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"但我要呼求上帝，","poem":1},{"lineBreak":true},{"text":"耶和华必拯救我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"晚上、早晨和中午，","poem":1},{"lineBreak":true},{"text":"我痛苦地呼求，","poem":1},{"lineBreak":true},{"text":"祂必垂听我的声音。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"虽然许多人攻击我，","poem":1},{"lineBreak":true},{"text":"祂必救我平安脱险。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"永掌王权的上帝必鉴察并惩罚他们，","poem":1},{"lineBreak":true},{"text":"因为他们顽固不化、不敬畏上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"我的同伴违背盟约，出手攻击朋友。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他口蜜腹剑，笑里藏刀。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"把你的重担卸给耶和华，","poem":1},{"lineBreak":true},{"text":"祂必扶持你。","poem":1},{"lineBreak":true},{"text":"祂绝不让义人跌倒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"你必把恶人送进灭亡的坑里。","poem":1},{"lineBreak":true},{"text":"嗜血成性的骗子必早早夭亡。","poem":1},{"lineBreak":true},{"text":"但我要信靠你。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}