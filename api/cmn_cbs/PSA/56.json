{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":56,"content":[{"type":"heading","content":["信靠上帝的祷告"]},{"type":"hebrew_subtitle","content":["大卫作的诗，交给乐长，调用“远方无声鸽”，大卫在迦特被非利士人抓住时所作。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你怜悯我，","poem":1},{"lineBreak":true},{"text":"因为仇敌迫害我，整日攻击我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的仇敌整日迫害我，","poem":1},{"lineBreak":true},{"text":"许多人狂妄地攻击我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我害怕的时候，","poem":1},{"lineBreak":true},{"text":"就倚靠你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我靠着上帝赞美祂的应许，","poem":1},{"lineBreak":true},{"text":"我信靠上帝，就不惧怕，","poem":1},{"lineBreak":true},{"text":"区区世人能把我怎样？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们整天歪曲我的话，","poem":1},{"lineBreak":true},{"text":"总是图谋害我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们勾结起来，","poem":1},{"lineBreak":true},{"text":"暗中监视我的行踪，","poem":1},{"lineBreak":true},{"text":"伺机害我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"不要让这些作恶的人逃脱，","poem":1},{"lineBreak":true},{"text":"求你发烈怒毁灭他们。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你记录我的哀伤，","poem":1},{"lineBreak":true},{"text":"你把我的眼泪收在袋中。","poem":1},{"lineBreak":true},{"text":"我的遭遇都记录在你的册子上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我向你求救的时候，","poem":1},{"lineBreak":true},{"text":"敌人都落荒而逃。","poem":1},{"lineBreak":true},{"text":"我知道上帝是我的帮助。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我靠着上帝赞美祂的应许，","poem":1},{"lineBreak":true},{"text":"我靠着耶和华赞美祂的应许。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我信靠上帝，就不惧怕，","poem":1},{"lineBreak":true},{"text":"区区世人能把我怎样？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"我要恪守向你发的誓言，","poem":1},{"lineBreak":true},{"text":"献上感恩祭。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因为你救我脱离死亡，","poem":1},{"lineBreak":true},{"text":"使我没有跌倒，","poem":1},{"lineBreak":true},{"text":"让我可以活在你面前，","poem":1},{"lineBreak":true},{"text":"沐浴生命之光。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}