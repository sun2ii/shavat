{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":57,"content":[{"type":"heading","content":["被围困中的呼求"]},{"type":"hebrew_subtitle","content":["大卫作的诗，交给乐长，调用“休要毁坏”。当时他因逃避扫罗躲进了洞里。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你怜悯我，怜悯我，","poem":1},{"lineBreak":true},{"text":"因为我投靠你。","poem":1},{"lineBreak":true},{"text":"我要在你翅膀下得到荫庇，","poem":1},{"lineBreak":true},{"text":"直到灾难结束。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我向至高的上帝，","poem":1},{"lineBreak":true},{"text":"向为我成就一切的上帝呼求。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝从天上施助、拯救我，","poem":1},{"lineBreak":true},{"text":"使迫害我的人蒙羞。（细拉）","poem":1},{"lineBreak":true},{"text":"上帝必彰显祂的慈爱和信实。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我被狮子包围，","poem":1},{"lineBreak":true},{"text":"躺卧在吃人的野兽中。","poem":1},{"lineBreak":true},{"text":"他们的牙齿是矛和箭，","poem":1},{"lineBreak":true},{"text":"舌头是尖刀。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝啊，愿你受的尊崇超过诸天，","poem":1},{"lineBreak":true},{"text":"愿你的荣耀覆盖大地。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的仇敌设下网罗，","poem":1},{"lineBreak":true},{"text":"我心中沮丧。","poem":1},{"lineBreak":true},{"text":"他们在我走的路上挖了陷阱，","poem":1},{"lineBreak":true},{"text":"自己却掉了进去。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"上帝啊，我心坚定，我心坚定，","poem":1},{"lineBreak":true},{"text":"我要唱诗歌颂你。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的心啊，醒来吧！","poem":1},{"lineBreak":true},{"text":"琴瑟啊，醒来吧！","poem":1},{"lineBreak":true},{"text":"我要唤醒黎明！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"主啊，我要在列邦称谢你，","poem":1},{"lineBreak":true},{"text":"在列国歌颂你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因为你的慈爱高达诸天，","poem":1},{"lineBreak":true},{"text":"你的信实广及穹苍。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝啊，愿你受的尊崇超过诸天，","poem":1},{"lineBreak":true},{"text":"愿你的荣耀覆盖大地。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}