{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":58,"content":[{"type":"heading","content":["祈求上帝惩罚恶人"]},{"type":"hebrew_subtitle","content":["大卫作的诗，交给乐长，调用“休要毁坏”。"]},{"type":"verse","number":1,"content":[{"text":"你们做官长的主持公道吗？","poem":1},{"lineBreak":true},{"text":"你们的审判公正吗？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"不，你们心中图谋不义，","poem":1},{"lineBreak":true},{"text":"你们在地上行凶作恶。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"恶人生下来就步入歧途，","poem":1},{"lineBreak":true},{"text":"一出母胎就离开正道，","poem":1},{"lineBreak":true},{"text":"谎话连篇。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们恶毒如蛇，","poem":1},{"lineBreak":true},{"text":"像耳聋的眼镜蛇，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"任法师的邪术再高超，","poem":1},{"lineBreak":true},{"text":"也听不见他的咒语。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"上帝啊，求你敲碎他们的牙齿；","poem":1},{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你拔掉这些猛狮的利齿。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愿他们如流水逝去，","poem":1},{"lineBreak":true},{"text":"愿他们弯弓搭箭时箭头折断。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愿他们像蜗牛一样溶为烂泥，","poem":1},{"lineBreak":true},{"text":"又如未见天日就流产的胎儿。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"刹那间，荆棘还没有把锅烧热的工夫，","poem":1},{"lineBreak":true},{"text":"上帝必全然除灭他们。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"义人必因见恶人遭报而欢欣，","poem":1},{"lineBreak":true},{"text":"并用恶人的血洗脚。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"这样，人们必说：","poem":1},{"lineBreak":true},{"text":"“义人终有善报，","poem":1},{"lineBreak":true},{"text":"确实有一位审判天下的上帝。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}