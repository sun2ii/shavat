{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":59,"content":[{"type":"heading","content":["祈求上帝佑护"]},{"type":"hebrew_subtitle","content":["大卫作的诗，交给乐长，调用“休要毁坏”。当时扫罗派人去监视大卫的家，要杀害大卫。"]},{"type":"verse","number":1,"content":[{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你救我脱离仇敌，","poem":1},{"lineBreak":true},{"text":"保护我免遭敌人的攻击。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你救我脱离作恶之徒，","poem":1},{"lineBreak":true},{"text":"救我脱离嗜血成性之人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"看啊，他们埋伏害我。","poem":1},{"lineBreak":true},{"text":"耶和华啊，我并未犯罪作恶，","poem":1},{"lineBreak":true},{"text":"凶残的人却攻击我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我没有过错，","poem":1},{"lineBreak":true},{"text":"他们却准备攻击我。","poem":1},{"lineBreak":true},{"text":"求你起来帮助我，","poem":1},{"lineBreak":true},{"text":"顾念我的困境。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"万军之耶和华，以色列的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你起来惩罚列国，","poem":1},{"lineBreak":true},{"text":"不要怜悯奸诈的恶人。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"他们夜晚回来，","poem":1},{"lineBreak":true},{"text":"嚎叫如狗，在城中游荡。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们出口伤人，舌如利剑，","poem":1},{"lineBreak":true},{"text":"还说：“谁听得见？”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"但你耶和华必嗤笑他们，","poem":1},{"lineBreak":true},{"text":"嘲讽列国。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"你是我的力量，我的堡垒，","poem":1},{"lineBreak":true},{"text":"我仰望你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的上帝以慈爱待我，","poem":1},{"lineBreak":true},{"text":"祂会帮助我，","poem":1},{"lineBreak":true},{"text":"让我欣然看见仇敌遭报。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"保护我们的主啊，","poem":1},{"lineBreak":true},{"text":"求你不要杀掉他们，","poem":1},{"lineBreak":true},{"text":"免得我的百姓忘记教训。","poem":1},{"lineBreak":true},{"text":"求你用你的能力驱散他们，","poem":1},{"lineBreak":true},{"text":"使他们沦为卑贱。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们的嘴巴充满罪恶，","poem":1},{"lineBreak":true},{"text":"口中尽是咒诅和谎言，","poem":1},{"lineBreak":true},{"text":"愿他们陷在狂傲中不能自拔。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"求你发烈怒毁灭他们，","poem":1},{"lineBreak":true},{"text":"彻底铲除他们，","poem":1},{"lineBreak":true},{"text":"使普天下都知道上帝在雅各家掌权。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"他们夜晚回来，","poem":1},{"lineBreak":true},{"text":"嚎叫如狗，在城中游荡，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"四处觅食，","poem":1},{"lineBreak":true},{"text":"吃不饱就狂吠不止。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"但我要歌颂你的能力，","poem":1},{"lineBreak":true},{"text":"在清晨颂扬你的慈爱，","poem":1},{"lineBreak":true},{"text":"因为你是我的堡垒，","poem":1},{"lineBreak":true},{"text":"是我患难时的避难所。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"上帝啊，你是我的力量，","poem":1},{"lineBreak":true},{"text":"我要颂赞你，","poem":1},{"lineBreak":true},{"text":"你是我的堡垒，","poem":1},{"lineBreak":true},{"text":"是以慈爱待我的上帝。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}