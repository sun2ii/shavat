{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":6,"content":[{"type":"heading","content":["患难中祈求怜悯"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长，用弦乐器。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你不要愤然责备我，","poem":1},{"lineBreak":true},{"text":"不要发烈怒惩罚我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华啊，求你怜悯，","poem":1},{"lineBreak":true},{"text":"因为我软弱无力。","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你医治，","poem":1},{"lineBreak":true},{"text":"因为我痛彻入骨。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我心中惶恐不安，","poem":1},{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"你让我这样要到何时呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华啊，求你回来救我，","poem":1},{"lineBreak":true},{"text":"因你的慈爱而拯救我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因为死去的人不会记得你，","poem":1},{"lineBreak":true},{"text":"谁会在阴间赞美你呢？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我因哀叹心力交瘁，","poem":1},{"lineBreak":true},{"text":"夜夜哭泣，泪漂床榻，","poem":1},{"lineBreak":true},{"text":"湿透被褥。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的眼睛因忧愁而模糊，","poem":1},{"lineBreak":true},{"text":"因敌人环伺而昏花。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你们所有作恶的人，快走开！","poem":1},{"lineBreak":true},{"text":"因为耶和华已经听见我的哭声。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华听见了我的恳求，","poem":1},{"lineBreak":true},{"text":"祂必悦纳我的祷告。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我所有的仇敌都必羞愧，","poem":1},{"lineBreak":true},{"text":"惊恐不已；","poem":1},{"lineBreak":true},{"text":"他们必忽然蒙羞，","poem":1},{"lineBreak":true},{"text":"掉头逃窜。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}