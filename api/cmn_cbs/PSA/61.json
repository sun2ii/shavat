{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":61,"content":[{"type":"heading","content":["祈求上帝保护"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长，用弦乐器。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你倾听我的呼求，","poem":1},{"lineBreak":true},{"text":"垂听我的祷告！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我心力憔悴时，","poem":1},{"lineBreak":true},{"text":"从地极呼求你，","poem":1},{"lineBreak":true},{"text":"求你领我到高高的磐石上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为你是我的避难所，","poem":1},{"lineBreak":true},{"text":"是抗击仇敌的坚垒。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要永远住在你的帐幕里，","poem":1},{"lineBreak":true},{"text":"在你翅膀下得荫庇！（细拉）","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝啊，你已经听见我的誓言，","poem":1},{"lineBreak":true},{"text":"把你赐给敬畏你名之人的产业赐给我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你延长王的寿命，","poem":1},{"lineBreak":true},{"text":"使他的年日恒久。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愿他在你的护佑下永远做王，","poem":1},{"lineBreak":true},{"text":"求你以慈爱和信实来保护他。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"这样，我要永远歌颂你的名，","poem":1},{"lineBreak":true},{"text":"天天还我许的愿。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}