{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":62,"content":[{"type":"heading","content":["唯上帝是拯救"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长，照耶杜顿的做法。"]},{"type":"verse","number":1,"content":[{"text":"我的心默默等候上帝，","poem":1},{"lineBreak":true},{"text":"我的救恩从祂而来。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"唯有祂才是我的磐石，","poem":1},{"lineBreak":true},{"text":"我的拯救，我的堡垒，","poem":1},{"lineBreak":true},{"text":"我必不致动摇。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我就像一面摇摇欲坠的墙壁、行将倒塌的篱笆，","poem":1},{"lineBreak":true},{"text":"你们要攻击我、置我于死地到何时呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们千方百计把我从高位拉下。","poem":1},{"lineBreak":true},{"text":"他们善于说谎，嘴上祝福，","poem":1},{"lineBreak":true},{"text":"心却咒诅。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我的心啊！要默默等候上帝，","poem":1},{"lineBreak":true},{"text":"因为我的盼望从祂而来。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"唯有祂才是我的磐石，","poem":1},{"lineBreak":true},{"text":"我的拯救，我的堡垒，","poem":1},{"lineBreak":true},{"text":"我必不致动摇。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的拯救和荣耀都仰赖上帝，","poem":1},{"lineBreak":true},{"text":"祂是我的坚固磐石，是我的避难所。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"众百姓啊，","poem":1},{"lineBreak":true},{"text":"要时刻信靠上帝，","poem":1},{"lineBreak":true},{"text":"向祂倾心吐意，","poem":1},{"lineBreak":true},{"text":"因为祂是我们的避难所。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"卑贱人不过是一丝气息，","poem":1},{"lineBreak":true},{"text":"尊贵人不过是一场幻影，","poem":1},{"lineBreak":true},{"text":"放在天平上就浮起来，","poem":1},{"lineBreak":true},{"text":"他们总共比空气还轻。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"不要依靠敲诈勒索，","poem":1},{"lineBreak":true},{"text":"别妄想靠偷盗发财，","poem":1},{"lineBreak":true},{"text":"即使财富增多，也不要倚靠它。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝再三告诉我：","poem":1},{"lineBreak":true},{"text":"权能属于上帝。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"主啊，你充满慈爱。","poem":1},{"lineBreak":true},{"text":"你必照各人的行为来施行赏罚。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}