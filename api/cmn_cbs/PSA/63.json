{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":63,"content":[{"type":"heading","content":["渴慕上帝"]},{"type":"hebrew_subtitle","content":["大卫在犹大旷野时作的诗。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，你是我的上帝，","poem":1},{"lineBreak":true},{"text":"我迫切地寻求你！","poem":1},{"lineBreak":true},{"text":"在干旱、枯竭、无水之地，","poem":1},{"lineBreak":true},{"text":"我的身心渴慕你，切望你！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我曾在你的圣所瞻仰你，","poem":1},{"lineBreak":true},{"text":"目睹你的权能和荣耀。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的慈爱胜过生命，","poem":1},{"lineBreak":true},{"text":"我的嘴唇要赞美你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我一生都要赞美你，","poem":1},{"lineBreak":true},{"text":"奉你的名举手祷告。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我心满意足，如享盛宴，","poem":1},{"lineBreak":true},{"text":"我欢然开口赞美你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我躺在床上的时候思念你，","poem":1},{"lineBreak":true},{"text":"整夜地思想你。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因为你是我的帮助，","poem":1},{"lineBreak":true},{"text":"我在你翅膀的荫下欢歌。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的心依恋你，","poem":1},{"lineBreak":true},{"text":"你的右手扶持我。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"那些要害我的人必下到地的深处。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们必丧身刀下，","poem":1},{"lineBreak":true},{"text":"成为豺狼的食物。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"但王要因上帝而欢欣，","poem":1},{"lineBreak":true},{"text":"凡靠祂起誓的人必欢喜，","poem":1},{"lineBreak":true},{"text":"说谎者的口必被封住。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}