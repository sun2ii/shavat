{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":64,"content":[{"type":"heading","content":["祈求上帝的保护"]},{"type":"hebrew_subtitle","content":["大卫作的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你倾听我的苦诉，","poem":1},{"lineBreak":true},{"text":"求你保护我的性命不受仇敌的威胁。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你保护我免遭恶人的谋害，","poem":1},{"lineBreak":true},{"text":"使我脱离作恶之徒。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们舌头锋利如刀，","poem":1},{"lineBreak":true},{"text":"言语恶毒，犹如利箭。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们埋伏起来，","poem":1},{"lineBreak":true},{"text":"暗箭伤害纯全无过的人。","poem":1},{"lineBreak":true},{"text":"他们突然袭击，毫无顾忌。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们朋比为奸，","poem":1},{"lineBreak":true},{"text":"商量暗设网罗，","poem":1},{"lineBreak":true},{"text":"以为谁也看不见。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们图谋不义之事，","poem":1},{"lineBreak":true},{"text":"认为策划得无懈可击。","poem":1},{"lineBreak":true},{"text":"人心真是狡猾。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"但上帝必用箭射他们，","poem":1},{"lineBreak":true},{"text":"将他们突然射伤。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们必自作自受，","poem":1},{"lineBreak":true},{"text":"被自己的舌头所害。","poem":1},{"lineBreak":true},{"text":"看见的人都连连摇头。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"这样，人人必敬畏上帝，","poem":1},{"lineBreak":true},{"text":"传扬祂奇妙的作为，","poem":1},{"lineBreak":true},{"text":"思想祂所做的事。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"义人必因耶和华而欢欣，","poem":1},{"lineBreak":true},{"text":"并且投靠祂，","poem":1},{"lineBreak":true},{"text":"心地正直的人必欢喜。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}