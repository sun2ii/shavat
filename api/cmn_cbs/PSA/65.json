{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":65,"content":[{"type":"heading","content":["赞美和感恩"]},{"type":"hebrew_subtitle","content":["大卫作的诗歌，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，人们在锡安赞美你，","poem":1},{"lineBreak":true},{"text":"向你履行誓言。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你垂听祷告，","poem":1},{"lineBreak":true},{"text":"世人都来到你面前。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我们深陷罪中之时，","poem":1},{"lineBreak":true},{"text":"你赦免我们的过犯。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"蒙你拣选、","poem":1},{"lineBreak":true},{"text":"能住在你圣所的人有福了！","poem":1},{"lineBreak":true},{"text":"我们因你所居圣殿的美好而满足。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"拯救我们的上帝啊，","poem":1},{"lineBreak":true},{"text":"你凭公义、行可畏之事来应允我们的祈求。","poem":1},{"lineBreak":true},{"text":"你是天涯海角普世人的盼望。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你充满力量，以大能创造群山，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"又平息怒海狂涛，","poem":1},{"lineBreak":true},{"text":"止息列邦的喧嚣。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你奇妙的作为使远在地极的人心生敬畏，","poem":1},{"lineBreak":true},{"text":"你使日出之地和日落之处都传来欢呼声。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你眷顾大地，降下沛雨，","poem":1},{"lineBreak":true},{"text":"使土地肥沃富饶。","poem":1},{"lineBreak":true},{"text":"上帝啊，你的江河满溢，","poem":1},{"lineBreak":true},{"text":"浇灌大地，为世人预备五谷。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你降下甘霖，浇透垄沟，","poem":1},{"lineBreak":true},{"text":"滋润垄背，使地松软，","poem":1},{"lineBreak":true},{"text":"恩泽庄稼。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你赐下丰年福月，","poem":1},{"lineBreak":true},{"text":"你的脚踪恩泽满溢。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"旷野的草地生机盎然，","poem":1},{"lineBreak":true},{"text":"山岭间充满欢乐，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"草场遍布羊群，","poem":1},{"lineBreak":true},{"text":"谷中长满庄稼，","poem":1},{"lineBreak":true},{"text":"处处欢歌笑语。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}