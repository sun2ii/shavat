{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":66,"content":[{"type":"heading","content":["颂赞与感恩"]},{"type":"hebrew_subtitle","content":["一首诗歌，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"普世啊，你们要向上帝欢呼，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"颂赞祂荣耀的名，","poem":1},{"lineBreak":true},{"text":"献给祂荣耀的赞美。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要对上帝说：“你的作为令人敬畏！","poem":1},{"lineBreak":true},{"text":"你的大能使敌人屈膝投降。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"普天下都敬拜你，","poem":1},{"lineBreak":true},{"text":"颂赞你，颂赞你的名。”（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你们来看看上帝的作为，","poem":1},{"lineBreak":true},{"text":"祂为世人行了可畏之事！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂将沧海变为干地，","poem":1},{"lineBreak":true},{"text":"让百姓步行经过。","poem":1},{"lineBreak":true},{"text":"让我们因祂而欢欣吧！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂以大能永远掌权，","poem":1},{"lineBreak":true},{"text":"祂的眼目鉴察列国，","poem":1},{"lineBreak":true},{"text":"悖逆之徒不可在祂面前妄自尊大。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"列邦啊，要赞美我们的上帝，","poem":1},{"lineBreak":true},{"text":"让歌颂祂的声音四处飘扬。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂保全我们的生命，","poem":1},{"lineBreak":true},{"text":"不让我们失脚滑倒。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，你试验我们，","poem":1},{"lineBreak":true},{"text":"熬炼我们如熬炼银子。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你让我们陷入网罗，","poem":1},{"lineBreak":true},{"text":"把重担压在我们的背上。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你让人骑在我们的头上。","poem":1},{"lineBreak":true},{"text":"我们曾经历水火，","poem":1},{"lineBreak":true},{"text":"但你带我们到达丰盛之地。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我要带着燔祭来到你殿中，","poem":1},{"lineBreak":true},{"text":"履行我向你许的誓言，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"就是我在危难中开口许下的誓言。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要献上肥美的牲畜，","poem":1},{"lineBreak":true},{"text":"以公绵羊作馨香之祭献给你，","poem":1},{"lineBreak":true},{"text":"我要献上公牛和山羊。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"敬畏上帝的人啊，你们都来听吧，","poem":1},{"lineBreak":true},{"text":"我要告诉你们祂为我所做的事。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我曾开口向祂呼求，","poem":1},{"lineBreak":true},{"text":"嘴中扬声赞美祂。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"倘若我心中藏匿罪恶，","poem":1},{"lineBreak":true},{"text":"主必不垂听我的呼求。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"然而，上帝听了我的祷告，","poem":1},{"lineBreak":true},{"text":"倾听了我的祈求。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"上帝当受称颂！","poem":1},{"lineBreak":true},{"text":"祂没有对我的祷告拒而不听，","poem":1},{"lineBreak":true},{"text":"也没有收回祂对我的慈爱。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}