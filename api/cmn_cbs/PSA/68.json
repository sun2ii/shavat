{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":68,"content":[{"type":"heading","content":["得胜的凯歌"]},{"type":"hebrew_subtitle","content":["大卫作的诗歌，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"愿上帝起来驱散祂的仇敌，","poem":1},{"lineBreak":true},{"text":"使恨祂的人四散奔逃。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿你驱散他们，","poem":1},{"lineBreak":true},{"text":"如风把烟吹散。","poem":1},{"lineBreak":true},{"text":"愿恶人在上帝面前灭亡，","poem":1},{"lineBreak":true},{"text":"如蜡在火中熔化。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愿义人在上帝面前欢欣快乐，","poem":1},{"lineBreak":true},{"text":"愿他们高兴欢喜。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"要歌颂上帝，","poem":1},{"lineBreak":true},{"text":"赞美祂的名，","poem":1},{"lineBreak":true},{"text":"要颂扬乘驾云彩的上帝。","poem":1},{"lineBreak":true},{"text":"祂的名字是耶和华，","poem":1},{"lineBreak":true},{"text":"要在祂面前欢喜快乐。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"住在圣所的上帝是孤儿的父亲，","poem":1},{"lineBreak":true},{"text":"寡妇的保护者。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂使孤苦者有家，","poem":1},{"lineBreak":true},{"text":"让被囚者欢然脱离牢笼。","poem":1},{"lineBreak":true},{"text":"但叛逆者要住在干旱之地。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"你曾带领你的子民走过旷野。（细拉）","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"那时，在西奈山的上帝面前，","poem":1},{"lineBreak":true},{"text":"在以色列的上帝面前，","poem":1},{"lineBreak":true},{"text":"大地震动，诸天降雨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"上帝啊，你降下沛雨，","poem":1},{"lineBreak":true},{"text":"滋润你干旱的产业以色列，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"让你的子民得以安居在那里。","poem":1},{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"你满怀恩慈地供养穷苦人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"主下达命令，","poem":1},{"lineBreak":true},{"text":"成群的妇女便奔走相告：","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"“众王和他们的军队逃走了，逃走了！”","poem":1},{"lineBreak":true},{"text":"家中的妇女都在分战利品。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"即使躺在羊圈里的人也披金戴银，","poem":1},{"lineBreak":true},{"text":"就像鸽子镀银的翅膀和金光闪闪的羽毛。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"全能的上帝驱散了众王，","poem":1},{"lineBreak":true},{"text":"势如大雪洒落在撒们。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"巴珊的山巍峨雄壮，群峰耸立。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"崇山峻岭啊，","poem":1},{"lineBreak":true},{"text":"你们为何嫉妒地盯着上帝选为居所的山，","poem":1},{"lineBreak":true},{"text":"耶和华永远居住的地方呢？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"上帝带着千千万万的战车从西奈山来到祂的圣所。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你升上高天时，","poem":1},{"lineBreak":true},{"text":"带着许多俘虏；","poem":1},{"lineBreak":true},{"text":"你接受了众人的礼物，","poem":1},{"lineBreak":true},{"text":"甚至叛逆者的礼物。","poem":1},{"lineBreak":true},{"text":"耶和华上帝就住在那里。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"要称颂主，","poem":1},{"lineBreak":true},{"text":"称颂我们的救主上帝，","poem":1},{"lineBreak":true},{"text":"祂天天背负我们的重担。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"我们的上帝是拯救的上帝，","poem":1},{"lineBreak":true},{"text":"主耶和华救我们脱离死亡。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"上帝必打碎仇敌的头颅，","poem":1},{"lineBreak":true},{"text":"敲破怙恶不悛者的脑袋。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"主说：","poem":1},{"lineBreak":true},{"text":"“我要把他们从巴珊带回来，","poem":1},{"lineBreak":true},{"text":"从深海带回来，","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"好让你们的脚从他们的血泊中踩过，","poem":1},{"lineBreak":true},{"text":"你们的狗也可以舔他们的血。”","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"上帝啊，你的队伍已经出现；","poem":1},{"lineBreak":true},{"text":"我的上帝，我的王啊，","poem":1},{"lineBreak":true},{"text":"你的队伍进了圣所，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"歌唱的在前，奏乐的殿后，","poem":1},{"lineBreak":true},{"text":"摇手鼓的少女居中。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你们要在大会中赞美上帝，","poem":1},{"lineBreak":true},{"text":"以色列的会众都要赞美耶和华。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"最小的便雅悯支派在前领路，","poem":1},{"lineBreak":true},{"text":"后面跟着大群的犹大首领，","poem":1},{"lineBreak":true},{"text":"还有西布伦和拿弗他利的首领。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"上帝啊，求你施展你的权能；","poem":1},{"lineBreak":true},{"text":"上帝啊，求你像以前一样为我们彰显你的力量。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"因着你耶路撒冷的圣殿，君王都带礼物来献给你。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"求你斥责那芦苇中的野兽，","poem":1},{"lineBreak":true},{"text":"斥责成群的公牛和列邦的牛犊，","poem":1},{"lineBreak":true},{"text":"使他们俯首献上贡银。","poem":1},{"lineBreak":true},{"text":"求你驱散好战的列邦。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"埃及的使节来朝见，","poem":1},{"lineBreak":true},{"text":"古实也要归降上帝。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"世上的列国啊，","poem":1},{"lineBreak":true},{"text":"要向上帝歌唱，","poem":1},{"lineBreak":true},{"text":"你们要歌颂主，","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"歌颂凌驾在万古穹苍之上的主。","poem":1},{"lineBreak":true},{"text":"听啊，祂声如雷鸣。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你们要传扬上帝的大能，","poem":1},{"lineBreak":true},{"text":"祂的威荣普照以色列，","poem":1},{"lineBreak":true},{"text":"祂的权能彰显于穹苍。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"上帝啊，你在圣所中令人敬畏。","poem":1},{"lineBreak":true},{"text":"以色列的上帝把力量和权能赐给祂的子民。","poem":1},{"lineBreak":true},{"text":"上帝当受称颂！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}