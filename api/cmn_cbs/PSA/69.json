{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":69,"content":[{"type":"heading","content":["祈求上帝拯救的祷告"]},{"type":"hebrew_subtitle","content":["大卫作的诗，交给乐长，调用“百合花”。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你拯救我，","poem":1},{"lineBreak":true},{"text":"因为洪水快把我淹没；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我深陷泥沼，无法站稳脚；","poem":1},{"lineBreak":true},{"text":"我落入深渊，被洪流淹没。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我连连呼救，已声嘶力竭；","poem":1},{"lineBreak":true},{"text":"我期盼上帝的帮助，望眼欲穿。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"无故恨我的人不计其数，","poem":1},{"lineBreak":true},{"text":"无故害我的仇敌势力强大，","poem":1},{"lineBreak":true},{"text":"逼我偿还我没有偷过的东西。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝啊，你知道我的愚昧，","poem":1},{"lineBreak":true},{"text":"我的罪恶也瞒不过你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"主——万军之耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你不要使等候你的人因我而受辱；","poem":1},{"lineBreak":true},{"text":"以色列的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你不要让寻求你的人因我而蒙羞。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我为了你的缘故遭受辱骂，","poem":1},{"lineBreak":true},{"text":"羞辱满面。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的弟兄视我为陌生人，","poem":1},{"lineBreak":true},{"text":"我的手足看我为外人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我为你的殿心急如焚，","poem":1},{"lineBreak":true},{"text":"辱骂你之人的辱骂都落在我身上。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我悲伤禁食，","poem":1},{"lineBreak":true},{"text":"他们就羞辱我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我披上麻衣，","poem":1},{"lineBreak":true},{"text":"他们就讥笑我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我成了街谈巷议的话题，","poem":1},{"lineBreak":true},{"text":"醉汉作歌取笑我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"可是，耶和华啊，","poem":1},{"lineBreak":true},{"text":"在你悦纳人的时候，我向你祷告。","poem":1},{"lineBreak":true},{"text":"上帝啊，求你以你的大爱和信实的拯救应允我。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"求你救我脱离泥沼，","poem":1},{"lineBreak":true},{"text":"不要让我沉下去；","poem":1},{"lineBreak":true},{"text":"求你救我脱离恨我的人，","poem":1},{"lineBreak":true},{"text":"使我离开深渊。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"求你不要让洪水淹没我，","poem":1},{"lineBreak":true},{"text":"不要让深渊吞灭我，","poem":1},{"lineBreak":true},{"text":"不要让坟墓吞噬我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和华啊，求你答应我的祷告，","poem":1},{"lineBreak":true},{"text":"因为你的慈爱充满良善；","poem":1},{"lineBreak":true},{"text":"求你以丰盛的怜悯眷顾我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"求你不要掩面不理你的仆人。","poem":1},{"lineBreak":true},{"text":"我正身陷困境，","poem":1},{"lineBreak":true},{"text":"求你快快答应我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你前来拯救我，","poem":1},{"lineBreak":true},{"text":"因仇敌环伺而救赎我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你知道我受的辱骂、欺凌和羞辱，","poem":1},{"lineBreak":true},{"text":"我的仇敌都在你面前。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他们的辱骂使我心碎，","poem":1},{"lineBreak":true},{"text":"令我绝望无助。","poem":1},{"lineBreak":true},{"text":"我渴望有人同情，却没有一个；","poem":1},{"lineBreak":true},{"text":"期望有人安慰，却无一人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们给我苦胆当食物，","poem":1},{"lineBreak":true},{"text":"又拿醋给我解渴。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"愿他们面前的宴席变为网罗，","poem":1},{"lineBreak":true},{"text":"成为他们的报应和陷阱。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"愿他们眼目昏暗，无法看见；","poem":1},{"lineBreak":true},{"text":"愿他们颤颤巍巍，直不起腰来。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"求你向他们倾倒烈怒，","poem":1},{"lineBreak":true},{"text":"愿你的怒火淹没他们。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"愿他们的家园一片荒凉，","poem":1},{"lineBreak":true},{"text":"愿他们的帐篷无人居住。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因为他们迫害你击打过的人，","poem":1},{"lineBreak":true},{"text":"嘲笑你所打伤之人的痛苦。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"求你清算他们的种种罪行，","poem":1},{"lineBreak":true},{"text":"不要让他们得享你的拯救。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"愿他们从生命册上被抹去，","poem":1},{"lineBreak":true},{"text":"不得和义人的名字同列。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"上帝啊，我陷入痛苦和忧伤，","poem":1},{"lineBreak":true},{"text":"愿你的救恩保护我。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我要用歌声赞美上帝的名，","poem":1},{"lineBreak":true},{"text":"以感恩的心尊崇祂。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"这要比献上公牛，献上有蹄有角的公牛更讨耶和华喜悦。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"卑微的人看见这一切就欢喜快乐，","poem":1},{"lineBreak":true},{"text":"愿你们寻求上帝的人心神振奋。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"耶和华垂听穷苦人的祈求，","poem":1},{"lineBreak":true},{"text":"不轻看祂被囚的子民。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"愿天地都赞美祂，","poem":1},{"lineBreak":true},{"text":"愿海和其中的一切都赞美祂！","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"因为上帝必拯救锡安，","poem":1},{"lineBreak":true},{"text":"重建犹大的城邑。","poem":1},{"lineBreak":true},{"text":"祂的子民要住在那里，","poem":1},{"lineBreak":true},{"text":"拥有那片土地。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"祂仆人的后裔要承受那地方为业，","poem":1},{"lineBreak":true},{"text":"凡爱祂名的人都要住在那里。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}