{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":7,"content":[{"type":"heading","content":["求上帝伸张正义"]},{"type":"hebrew_subtitle","content":["大卫向耶和华唱的流离歌，与便雅悯人古实有关。"]},{"type":"verse","number":1,"content":[{"text":"我的上帝耶和华啊，我投靠你，","poem":1},{"lineBreak":true},{"text":"求你拯救我脱离追赶我的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"免得他们像狮子般撕裂我，把我撕碎，","poem":1},{"lineBreak":true},{"text":"无人搭救。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"倘若我犯了罪，","poem":1},{"lineBreak":true},{"text":"手上沾了不义；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"倘若我恩将仇报，","poem":1},{"lineBreak":true},{"text":"无故抢夺仇敌，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"就让仇敌追赶我，直到追上，","poem":1},{"lineBreak":true},{"text":"把我的性命践踏在土中，使我声名扫地。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你发怒攻击我暴怒的仇敌。","poem":1},{"lineBreak":true},{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你醒来，为我伸张正义。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愿万民都环绕你，","poem":1},{"lineBreak":true},{"text":"愿你从高天治理他们，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愿你审判万民！","poem":1},{"lineBreak":true},{"text":"至高的耶和华啊，","poem":1},{"lineBreak":true},{"text":"我是公义正直的，","poem":1},{"lineBreak":true},{"text":"求你为我主持公道。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"鉴察人心肺腑的公义上帝啊，","poem":1},{"lineBreak":true},{"text":"求你铲除邪恶，扶持义人。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝是我的盾牌，","poem":1},{"lineBreak":true},{"text":"祂拯救心地正直的人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝是公义的审判官，","poem":1},{"lineBreak":true},{"text":"天天向恶人发怒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们若不悔改，祂必磨刀霍霍，","poem":1},{"lineBreak":true},{"text":"弯弓搭箭。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂准备好了夺命的兵器，","poem":1},{"lineBreak":true},{"text":"火箭已在弦上。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"恶人心怀恶念，","poem":1},{"lineBreak":true},{"text":"居心叵测，滋生虚谎。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他们挖了陷阱，却自陷其中。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他们的恶行回到自己头上，","poem":1},{"lineBreak":true},{"text":"他们的暴力落到自己脑壳上。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我要因耶和华公义而称谢祂，","poem":1},{"lineBreak":true},{"text":"我要歌颂至高者耶和华的名。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}