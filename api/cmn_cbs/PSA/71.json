{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":71,"content":[{"type":"heading","content":["一个老年人的祈祷"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我投靠你，","poem":1},{"lineBreak":true},{"text":"求你让我永不蒙羞。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你凭公义解救我，搭救我，","poem":1},{"lineBreak":true},{"text":"侧耳听我的呼求，拯救我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"求你作我避难的磐石，","poem":1},{"lineBreak":true},{"text":"让我可以随时投靠你。","poem":1},{"lineBreak":true},{"text":"求你下令救我，","poem":1},{"lineBreak":true},{"text":"因为你是我的磐石，我的堡垒。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你从恶人手中拯救我，","poem":1},{"lineBreak":true},{"text":"从邪恶、残暴之徒掌下拯救我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"主耶和华啊，你是我的盼望，","poem":1},{"lineBreak":true},{"text":"我从小就信靠你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你使我出了母胎，","poem":1},{"lineBreak":true},{"text":"我从出生就依靠你，","poem":1},{"lineBreak":true},{"text":"我要永远赞美你。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的遭遇使许多人感到惊骇，","poem":1},{"lineBreak":true},{"text":"但你是我坚固的避难所。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我口中充满对你的赞美，","poem":1},{"lineBreak":true},{"text":"终日述说你的荣耀。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我年老时，求你不要丢弃我；","poem":1},{"lineBreak":true},{"text":"我体力衰微时，求你不要离弃我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因为我的仇敌议论我，","poem":1},{"lineBreak":true},{"text":"那些想杀害我的一起策划阴谋，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"说：“上帝已经丢弃了他。","poem":1},{"lineBreak":true},{"text":"你们去追赶、捉拿他吧，","poem":1},{"lineBreak":true},{"text":"因为无人会救他。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"上帝啊，不要远离我；","poem":1},{"lineBreak":true},{"text":"我的上帝啊，求你快来帮助我！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"愿我的仇敌在羞辱中灭亡，","poem":1},{"lineBreak":true},{"text":"愿那些害我的人抱愧蒙羞。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我必常常心怀盼望，","poem":1},{"lineBreak":true},{"text":"向你献上更多赞美。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我虽然无法测度，","poem":1},{"lineBreak":true},{"text":"但必终日传扬你的公义和拯救之恩。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"主耶和华啊，","poem":1},{"lineBreak":true},{"text":"我要传扬你大能的作为，","poem":1},{"lineBreak":true},{"text":"单单述说你的公义。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"我从小就受你的教导，","poem":1},{"lineBreak":true},{"text":"直到今日我仍传扬你奇妙的作为。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"就是我年老发白的时候，","poem":1},{"lineBreak":true},{"text":"求你也不要丢弃我，","poem":1},{"lineBreak":true},{"text":"好让我把你的大能告诉下一代，","poem":1},{"lineBreak":true},{"text":"把你的能力讲给后人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"上帝啊，你的公义高达穹苍，","poem":1},{"lineBreak":true},{"text":"你成就了奇妙大事。","poem":1},{"lineBreak":true},{"text":"上帝啊，有谁能像你？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你使我经历了许多患难，","poem":1},{"lineBreak":true},{"text":"最终必使我重获新生，","poem":1},{"lineBreak":true},{"text":"把我从大地深处救上来。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你必赐我更大的尊荣，","poem":1},{"lineBreak":true},{"text":"你必再次安慰我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"我要弹琴赞美你的信实；","poem":1},{"lineBreak":true},{"text":"以色列的圣者啊，","poem":1},{"lineBreak":true},{"text":"我要伴随着琴声赞美你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你救赎了我的灵魂，","poem":1},{"lineBreak":true},{"text":"我的口和灵魂都要欢呼歌颂你。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我要终日向人述说你的公义，","poem":1},{"lineBreak":true},{"text":"因为那些想害我的人已经蒙羞受辱。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}