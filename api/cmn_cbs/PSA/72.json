{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":72,"content":[{"type":"heading","content":["为君王祈祷"]},{"type":"hebrew_subtitle","content":["所罗门的诗。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"求你将你的公正赐给王，","poem":1},{"lineBreak":true},{"text":"将你的公义赐给王的儿子。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"让他凭公义审判你的子民，","poem":1},{"lineBreak":true},{"text":"按公平对待那些贫苦的人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愿大山给百姓带来繁荣，","poem":1},{"lineBreak":true},{"text":"小山带来公义。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"愿他为百姓中受苦的人主持公道，","poem":1},{"lineBreak":true},{"text":"拯救贫穷的人，打倒欺压者。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"只要日月尚存，","poem":1},{"lineBreak":true},{"text":"愿百姓世世代代敬畏你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愿他的统治如春雨降在新割过的草场上，","poem":1},{"lineBreak":true},{"text":"又像甘霖滋润大地。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"在他统治之下，","poem":1},{"lineBreak":true},{"text":"愿义人兴旺，国富民强，","poem":1},{"lineBreak":true},{"text":"如月长存。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愿他的疆域横跨洋海，","poem":1},{"lineBreak":true},{"text":"从幼发拉底河直到地极。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愿旷野的居民都来向他下拜，","poem":1},{"lineBreak":true},{"text":"敌人都仆倒在尘土中。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"愿他施和海岛的君王都纳贡称臣，","poem":1},{"lineBreak":true},{"text":"愿示巴和西巴的君王都献上礼物。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"愿君王都敬拜他，","poem":1},{"lineBreak":true},{"text":"万国都事奉他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"贫穷人呼求，他便搭救；","poem":1},{"lineBreak":true},{"text":"困苦人无助，他就伸出援手。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他怜悯软弱和贫困的人，","poem":1},{"lineBreak":true},{"text":"拯救贫困人的性命。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他要救他们脱离压迫和暴力，","poem":1},{"lineBreak":true},{"text":"因为他爱惜他们的生命。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愿王寿命长久，","poem":1},{"lineBreak":true},{"text":"愿人将示巴的金子献给他，","poem":1},{"lineBreak":true},{"text":"愿人不断为他祷告，终日祝福他。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"愿遍地五谷丰登，","poem":1},{"lineBreak":true},{"text":"山顶上晃动着累累果实，","poem":1},{"lineBreak":true},{"text":"如黎巴嫩的密林。","poem":1},{"lineBreak":true},{"text":"愿各城人口稠密如原野的青草。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"愿他的名流芳百世，如日长存。","poem":1},{"lineBreak":true},{"text":"愿万国都因他而蒙福，","poem":1},{"lineBreak":true},{"text":"并称他是有福的。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"以色列的上帝耶和华当受称颂，","poem":1},{"lineBreak":true},{"text":"唯有祂行奇妙的事。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"愿祂荣耀的名永受称颂！","poem":1},{"lineBreak":true},{"text":"愿普天下充满祂的荣耀。","poem":1},{"lineBreak":true},{"text":"阿们！阿们！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶西的儿子大卫的祷告结束。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}