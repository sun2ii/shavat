{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":73,"content":[{"type":"heading","content":["上帝的公正审判"]},{"type":"hebrew_subtitle","content":["亚萨的诗。"]},{"type":"verse","number":1,"content":[{"text":"上帝实在善待以色列人，","poem":1},{"lineBreak":true},{"text":"恩待那些内心纯洁的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我却身陷险地，","poem":1},{"lineBreak":true},{"text":"几乎失脚跌倒。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我看见狂傲的恶人亨通就心怀不平。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们一生平顺，健康强壮。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们不像别人受苦，","poem":1},{"lineBreak":true},{"text":"不像世人遭难。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们把骄傲作项链戴在颈上，","poem":1},{"lineBreak":true},{"text":"把暴力作外袍裹在身上。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们胖得眼睛凸出，","poem":1},{"lineBreak":true},{"text":"心中充满罪恶。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们讥讽嘲笑，言语恶毒，","poem":1},{"lineBreak":true},{"text":"狂言恫吓胁迫。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们的口亵渎上天，","poem":1},{"lineBreak":true},{"text":"舌头诋毁大地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝的子民也跟随他们，","poem":1},{"lineBreak":true},{"text":"喝尽他们杯中的水。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们说：","poem":1},{"lineBreak":true},{"text":"“上帝怎能知道？","poem":1},{"lineBreak":true},{"text":"至高者会察觉吗？”","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"看这些恶人，","poem":1},{"lineBreak":true},{"text":"他们总是生活安逸，财富日增。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我洁身自爱，保持清白，","poem":1},{"lineBreak":true},{"text":"实属徒然。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我天天遭灾，日日受罚。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"要是我这样说，","poem":1},{"lineBreak":true},{"text":"我就是背叛了你的子民。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我想明白这一切，","poem":1},{"lineBreak":true},{"text":"却百思不得其解。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"直到我进入你的圣所，","poem":1},{"lineBreak":true},{"text":"才明白他们的结局。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你确实把他们放在容易滑倒的地方，","poem":1},{"lineBreak":true},{"text":"使他们落入毁灭中。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他们顷刻间被毁灭，","poem":1},{"lineBreak":true},{"text":"在恐怖中彻底灭亡。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他们如同人醒后的一场梦。","poem":1},{"lineBreak":true},{"text":"主啊，你起来必视他们如幻梦。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我曾感到悲伤，心如刀绞。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我当时愚昧无知，","poem":1},{"lineBreak":true},{"text":"在你面前如畜类。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"然而，我一直和你在一起，","poem":1},{"lineBreak":true},{"text":"你牵着我的右手引导我。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你以谆谆教诲指引我，","poem":1},{"lineBreak":true},{"text":"以后必接我到荣耀中。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"除你以外，在天上我还有谁？","poem":1},{"lineBreak":true},{"text":"除你以外，在地上我别无爱慕。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"尽管我身心俱衰，","poem":1},{"lineBreak":true},{"text":"上帝永远是我心中的力量，","poem":1},{"lineBreak":true},{"text":"是我永远的福分。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"那些远离你的人必灭亡，","poem":1},{"lineBreak":true},{"text":"你必灭绝不忠于你的人。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"亲近上帝对我而言何等美好。","poem":1},{"lineBreak":true},{"text":"我以主耶和华为我的避难所，","poem":1},{"lineBreak":true},{"text":"并宣扬祂的一切作为。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}