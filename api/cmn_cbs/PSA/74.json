{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":74,"content":[{"type":"heading","content":["祈求上帝眷顾祂的子民"]},{"type":"hebrew_subtitle","content":["亚萨的训诲诗。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"你为何永远丢弃了我们？","poem":1},{"lineBreak":true},{"text":"你为何对自己草场上的羊大发雷霆？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你眷顾你古时买赎的子民，","poem":1},{"lineBreak":true},{"text":"你救赎为产业的族类，","poem":1},{"lineBreak":true},{"text":"求你眷顾你所居住的锡安山。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"求你前往那久已荒废之地，","poem":1},{"lineBreak":true},{"text":"看看敌人对圣所的破坏。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的仇敌在你的圣所咆哮，","poem":1},{"lineBreak":true},{"text":"他们竖立起自己的旗帜。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们大肆毁坏，","poem":1},{"lineBreak":true},{"text":"好像人抡起斧头砍伐树林。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们用斧头、锤子把雕刻的墙板都捣毁了。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们纵火焚烧你的圣所，","poem":1},{"lineBreak":true},{"text":"把它夷为平地，","poem":1},{"lineBreak":true},{"text":"亵渎了你的居所。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们心里说：“我们要全部摧毁。”","poem":1},{"lineBreak":true},{"text":"于是他们烧毁了境内所有敬拜上帝的地方。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我们再也看不到你的征兆，","poem":1},{"lineBreak":true},{"text":"先知也没有了。","poem":1},{"lineBreak":true},{"text":"无人知道这一切何时才会结束。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"仇敌嘲笑你的名要到何时呢？","poem":1},{"lineBreak":true},{"text":"他们要永无休止地辱骂你吗？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你为何不伸出大能的右手？","poem":1},{"lineBreak":true},{"text":"求你出手给他们致命的一击。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"上帝自古以来就是我的王，","poem":1},{"lineBreak":true},{"text":"祂给世上带来拯救。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你曾用大能分开海水，","poem":1},{"lineBreak":true},{"text":"打碎水中巨兽的头。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你曾打碎海怪的头，","poem":1},{"lineBreak":true},{"text":"把它丢给旷野的禽兽吃。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你曾开辟泉源和溪流，","poem":1},{"lineBreak":true},{"text":"也曾使滔滔河水枯干。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"白昼和黑夜都属于你，","poem":1},{"lineBreak":true},{"text":"你设立了日月。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你划定地上的疆界，","poem":1},{"lineBreak":true},{"text":"又创造盛夏和寒冬。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你记住敌人对你的嘲笑和愚妄人对你的亵渎。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"求你不要把你的子民交给仇敌","poem":1},{"noteId":4},{"text":"，","poem":1},{"lineBreak":true},{"text":"不要永远忘记你受苦的子民。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"求你顾念你立的约，","poem":1},{"lineBreak":true},{"text":"因地上黑暗之处充满了暴力。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"求你不要让受压迫的人羞愧而去。","poem":1},{"lineBreak":true},{"text":"愿贫穷困苦的人赞美你的名。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"上帝啊，求你起来维护自己，","poem":1},{"lineBreak":true},{"text":"别忘记愚妄人怎样整天嘲笑你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"不要忽视你仇敌的喧嚷，","poem":1},{"lineBreak":true},{"text":"或者你对头的连连叫嚣。","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"“子民”希伯来文是“鸽子”；“仇敌”希伯来文是“野兽”。","reference":{"chapter":74,"verse":19}}]},"thisChapterLink":"/api/cmn_cbs/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}