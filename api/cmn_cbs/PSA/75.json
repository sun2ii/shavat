{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":75,"content":[{"type":"heading","content":["上帝是审判者"]},{"type":"hebrew_subtitle","content":["亚萨的诗，交给乐长，调用“休要毁坏”。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"我们称谢你，我们称谢你，","poem":1},{"lineBreak":true},{"text":"因为你与我们同在。","poem":1},{"lineBreak":true},{"text":"人们都述说你奇妙的作为。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你说：“我已定好时间，","poem":1},{"lineBreak":true},{"text":"我必秉公审判。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"大地和世人颤抖的时候，","poem":1},{"lineBreak":true},{"text":"是我使地的根基稳固。（细拉）","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我警告狂妄人不要再狂傲，","poem":1},{"lineBreak":true},{"text":"告诫恶人不要再张狂。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"不要再狂妄自大，","poem":1},{"lineBreak":true},{"text":"不要说话傲气冲天。”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"人的尊贵不是来自东方，","poem":1},{"lineBreak":true},{"text":"不是来自西方，","poem":1},{"lineBreak":true},{"text":"也不是来自旷野。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"决定人尊贵的是上帝：","poem":1},{"lineBreak":true},{"text":"祂提升这个，贬抑那个。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华手中的杯里盛满泛着泡沫、精心调制的怒酒。","poem":1},{"lineBreak":true},{"text":"祂倒出怒酒，让世上的恶人喝得一滴不剩。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我要永远宣扬祂的作为，","poem":1},{"lineBreak":true},{"text":"我要颂赞雅各的上帝。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝必铲除恶人的势力，","poem":1},{"lineBreak":true},{"text":"使义人充满力量。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}