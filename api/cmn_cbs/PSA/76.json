{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":76,"content":[{"type":"heading","content":["上帝是胜利者"]},{"type":"hebrew_subtitle","content":["亚萨的诗歌，交给乐长，用弦乐器。"]},{"type":"verse","number":1,"content":[{"text":"上帝在犹大人人皆知，","poem":1},{"lineBreak":true},{"text":"在以色列威名远扬。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"祂的住处在撒冷，","poem":1},{"lineBreak":true},{"text":"祂的居所在锡安。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂在那里摧毁敌人的火箭、","poem":1},{"lineBreak":true},{"text":"盾牌和刀剑等兵器。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"上帝啊，你荣耀无比，","poem":1},{"lineBreak":true},{"text":"你的威严超过盛产猎物的群山。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"强敌被掳掠，他们倒地而亡，","poem":1},{"lineBreak":true},{"text":"勇士都无还手之力。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"雅各的上帝啊，你一斥责，","poem":1},{"lineBreak":true},{"text":"他们就人仰马翻。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"唯有你当受敬畏。","poem":1},{"lineBreak":true},{"text":"你发怒的时候，","poem":1},{"lineBreak":true},{"text":"谁能在你面前站立呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"你从天上宣告审判。","poem":1},{"lineBreak":true},{"text":"你施行审判，","poem":1},{"lineBreak":true},{"text":"拯救世上一切受苦之人时，","poem":1},{"lineBreak":true},{"text":"大地一片恐惧静默。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你向人类发怒带给你荣耀，","poem":1},{"lineBreak":true},{"text":"你要发尽你的烈怒。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你们要向你们的上帝耶和华许愿、还愿，","poem":1},{"lineBreak":true},{"text":"愿四周的邻邦都带礼物来献给当受敬畏的主。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂挫败首领的傲气，","poem":1},{"lineBreak":true},{"text":"世上的君王都敬畏祂。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":11}