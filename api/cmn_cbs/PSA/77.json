{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":77,"content":[{"type":"heading","content":["患难中的安慰"]},{"type":"hebrew_subtitle","content":["亚萨的诗，照耶杜顿的做法，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"我呼求上帝，我高声呼求，","poem":1},{"lineBreak":true},{"text":"上帝垂听我的祷告。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在困境中寻求主。","poem":1},{"lineBreak":true},{"text":"我整夜举手祷告，","poem":1},{"lineBreak":true},{"text":"我的心无法得到安慰。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我思想上帝，发出哀叹；","poem":1},{"lineBreak":true},{"text":"我默念，心力交瘁。（细拉）","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你使我无法合眼，","poem":1},{"lineBreak":true},{"text":"我心乱如麻，默然无语。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我回想从前的日子，","poem":1},{"lineBreak":true},{"text":"那久远的岁月，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"想起自己夜间所唱的歌。","poem":1},{"lineBreak":true},{"text":"我沉思默想，扪心自问：","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“难道主要永远丢弃我，","poem":1},{"lineBreak":true},{"text":"不再恩待我了吗？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"难道祂的慈爱永远消逝了吗？","poem":1},{"lineBreak":true},{"text":"祂的应许永远落空了吗？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"难道上帝已忘记施恩，","poem":1},{"lineBreak":true},{"text":"在愤怒中收回了祂的慈爱吗？”（细拉）","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"于是我说：“我感到悲伤的是，","poem":1},{"lineBreak":true},{"text":"至高者已不再彰显大能。”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华啊，我要回想你的作为，","poem":1},{"lineBreak":true},{"text":"回想你从前所行的奇事。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我要默想你所行的一切事，","poem":1},{"lineBreak":true},{"text":"思想你一切大能的作为。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"上帝啊，你的作为全然圣洁，","poem":1},{"lineBreak":true},{"text":"有哪个神明像你一样伟大？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你是行奇事的上帝，","poem":1},{"lineBreak":true},{"text":"你在列邦中彰显你的大能。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你以大能的臂膀救赎了你的子民，","poem":1},{"lineBreak":true},{"text":"就是雅各和约瑟的后代。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"上帝啊，众水看见你就战栗，","poem":1},{"lineBreak":true},{"text":"深渊看见你就颤抖。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"云层倒出雨水，","poem":1},{"lineBreak":true},{"text":"天上雷霆霹雳，电光四射。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"旋风中传来你的雷声，","poem":1},{"lineBreak":true},{"text":"你的闪电照亮世界，","poem":1},{"lineBreak":true},{"text":"大地颤抖震动。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你的道路穿越海洋，经过洪涛，","poem":1},{"lineBreak":true},{"text":"但你的足迹无处可寻。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你借着摩西和亚伦的手引领你的子民，","poem":1},{"lineBreak":true},{"text":"如同牧人引领羊群。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}