{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":78,"content":[{"type":"heading","content":["上帝引导祂的子民"]},{"type":"hebrew_subtitle","content":["亚萨的训诲诗。"]},{"type":"verse","number":1,"content":[{"text":"我的百姓啊！","poem":1},{"lineBreak":true},{"text":"你们要听我的教导，","poem":1},{"lineBreak":true},{"text":"侧耳倾听我的话。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要开口讲比喻，","poem":1},{"lineBreak":true},{"text":"道出古时的奥秘，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"是我们所闻所知、世代流传下来的事。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们不要在子孙面前隐瞒事实，","poem":1},{"lineBreak":true},{"text":"要把耶和华可称颂的作为、","poem":1},{"lineBreak":true},{"text":"祂的权能和所行的奇事告诉下一代。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因为祂为雅各制定法度，","poem":1},{"lineBreak":true},{"text":"为以色列设立律法，","poem":1},{"lineBreak":true},{"text":"又吩咐我们的祖先把这些律法传给儿女，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"使子孙后代都知道，","poem":1},{"lineBreak":true},{"text":"世代相传。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"这样，他们就会信靠上帝，","poem":1},{"lineBreak":true},{"text":"遵行祂的命令，","poem":1},{"lineBreak":true},{"text":"不忘记祂的作为；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"也不会像自己的祖先那样顽梗叛逆，","poem":1},{"lineBreak":true},{"text":"对上帝不忠，心怀二意。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"以法莲人备上了弓箭，","poem":1},{"lineBreak":true},{"text":"却临阵逃命。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们不遵守上帝的约，","poem":1},{"lineBreak":true},{"text":"拒绝遵行祂的律法。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们忘记了祂的作为，","poem":1},{"lineBreak":true},{"text":"忘记了祂彰显的奇事。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂曾在埃及，在琐安地区，","poem":1},{"lineBreak":true},{"text":"当着他们祖先的面行神迹。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂把海水分开，带领他们安然渡过；","poem":1},{"lineBreak":true},{"text":"祂使海水堆起如墙壁。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂白天以云柱带领他们，","poem":1},{"lineBreak":true},{"text":"晚上用火柱引导他们。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂在旷野劈开磐石，","poem":1},{"lineBreak":true},{"text":"供应他们丰沛的水源。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"祂使水从磐石中滚滚流出，","poem":1},{"lineBreak":true},{"text":"如滔滔江河。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"然而，他们仍旧犯罪，","poem":1},{"lineBreak":true},{"text":"在旷野反叛至高的上帝。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们顽梗地试探上帝，","poem":1},{"lineBreak":true},{"text":"索要他们想吃的食物。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他们抨击上帝，说：","poem":1},{"lineBreak":true},{"text":"“难道上帝可以在旷野摆宴席吗？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"祂击打磐石，","poem":1},{"lineBreak":true},{"text":"水就涌出，流淌成河，","poem":1},{"lineBreak":true},{"text":"但祂能赐给祂子民食物和肉吗？”","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和华听后大怒，","poem":1},{"lineBreak":true},{"text":"祂的怒火烧向雅各，","poem":1},{"lineBreak":true},{"text":"祂的怒气发向以色列。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为他们不相信上帝，也不信靠祂的拯救。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"祂向穹苍发出命令，","poem":1},{"lineBreak":true},{"text":"又打开天门，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"降下吗哪给他们吃，赐下天粮。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他们吃了天使的食物，","poem":1},{"lineBreak":true},{"text":"上帝赐给他们丰富的食物。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"祂使空中刮起东风，","poem":1},{"lineBreak":true},{"text":"用大能引来南风，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"使飞鸟如雨降下，多如尘埃，","poem":1},{"lineBreak":true},{"text":"使他们有多如海沙的肉吃。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"祂使飞鸟降落在他们营中的帐篷周围，","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"让他们吃得极其饱足，","poem":1},{"lineBreak":true},{"text":"上帝遂了他们的心愿。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"但是，他们还没有吃完，","poem":1},{"lineBreak":true},{"text":"肉还在口中的时候，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"上帝就向他们发怒，","poem":1},{"lineBreak":true},{"text":"杀掉了他们当中最强壮的，","poem":1},{"lineBreak":true},{"text":"消灭了以色列的青年。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"即使如此，","poem":1},{"lineBreak":true},{"text":"他们依旧犯罪，","poem":1},{"lineBreak":true},{"text":"不相信上帝奇妙的作为。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"所以上帝使他们虚度一生，","poem":1},{"lineBreak":true},{"text":"让他们的岁月充满恐惧。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"直到上帝击杀他们的时候，","poem":1},{"lineBreak":true},{"text":"他们才回转，诚心寻求祂。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"他们才想起上帝是他们的磐石，","poem":1},{"lineBreak":true},{"text":"至高的上帝是他们的救赎主。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他们却虚情假意，满口谎言。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"他们对祂不忠心，","poem":1},{"lineBreak":true},{"text":"也不信守祂的约。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"但上帝充满怜悯，","poem":1},{"lineBreak":true},{"text":"赦免了他们的罪，","poem":1},{"lineBreak":true},{"text":"没有毁灭他们。","poem":1},{"lineBreak":true},{"text":"祂多次收住怒气，","poem":1},{"lineBreak":true},{"text":"没有完全发出祂的烈怒。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"祂顾念他们不过是血肉之躯，","poem":1},{"lineBreak":true},{"text":"像一阵风一去不复返。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"他们在旷野屡屡反叛祂，","poem":1},{"lineBreak":true},{"text":"在荒地使祂伤心。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"他们再三试探上帝，","poem":1},{"lineBreak":true},{"text":"惹怒以色列的圣者。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"他们忘记了祂的大能，","poem":1},{"lineBreak":true},{"text":"忘记了祂救赎他们脱离压迫的日子，","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"也忘记了祂在埃及所行的神迹，","poem":1},{"lineBreak":true},{"text":"在琐安的田野所行的奇事。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"祂曾使江河溪流变成血，","poem":1},{"lineBreak":true},{"text":"以致无人能喝。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"祂曾使成群的苍蝇吞没他们，","poem":1},{"lineBreak":true},{"text":"使青蛙毁灭他们。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"祂把他们的五谷给蚱蜢，","poem":1},{"lineBreak":true},{"text":"让蝗虫吃尽他们的收成。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"祂用冰雹毁坏他们的葡萄树，","poem":1},{"lineBreak":true},{"text":"用严霜毁坏他们的桑树，","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"又用冰雹毁灭他们的牛群，","poem":1},{"lineBreak":true},{"text":"用闪电毁灭他们的牲畜。","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"祂把怒火、烈怒、愤恨和祸患倾倒在他们身上，","poem":1},{"lineBreak":true},{"text":"遣下一群降灾的天使。","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"祂的怒气尽发，","poem":1},{"lineBreak":true},{"text":"使他们被瘟疫吞噬，难逃一死。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"祂击杀了埃及人所有的长子，","poem":1},{"lineBreak":true},{"text":"就是含帐篷中头生的儿子。","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"祂像带领群羊一样带出祂的子民，","poem":1},{"lineBreak":true},{"text":"像引领羊群一样领他们经过旷野，","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"使他们一路平安，免受惊吓，","poem":1},{"lineBreak":true},{"text":"大海却淹没了他们的仇敌。","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"祂带领他们来到祂圣地的边界，","poem":1},{"lineBreak":true},{"text":"来到祂右手为他们预备的山区，","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"从他们面前赶出外族人，","poem":1},{"lineBreak":true},{"text":"把外族人的土地分给他们，","poem":1},{"lineBreak":true},{"text":"作为他们的产业，","poem":1},{"lineBreak":true},{"text":"使以色列各支派安顿下来。","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"他们却仍旧试探、反叛至高的上帝，","poem":1},{"lineBreak":true},{"text":"不遵行祂的法度。","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"他们跟祖先一样背信弃义，","poem":1},{"lineBreak":true},{"text":"像断弓一样毫不可靠。","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"他们建造丘坛，惹祂发怒；","poem":1},{"lineBreak":true},{"text":"他们竖起偶像，令祂愤恨。","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"上帝得知他们的恶行后大怒，","poem":1},{"lineBreak":true},{"text":"祂彻底弃绝了以色列人。","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"祂离弃了设在示罗的圣幕，","poem":1},{"lineBreak":true},{"text":"就是祂在人间的居所，","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"任凭祂大能的约柜被掳去，","poem":1},{"lineBreak":true},{"text":"让祂的荣耀落在敌人手中。","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"祂使自己的子民被刀剑杀戮，","poem":1},{"lineBreak":true},{"text":"向自己的产业大发怒气。","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"青年被烈火吞噬，","poem":1},{"lineBreak":true},{"text":"少女无婚礼颂歌。","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"祭司丧身刀下，","poem":1},{"lineBreak":true},{"text":"寡妇无法哭丧。","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"那时，主像从睡眠中醒来，","poem":1},{"lineBreak":true},{"text":"又如酒后醒来的勇士。","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"祂击退仇敌，","poem":1},{"lineBreak":true},{"text":"叫他们永远蒙羞。","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"祂丢弃了约瑟的帐篷，","poem":1},{"lineBreak":true},{"text":"没有拣选以法莲支派。","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"祂拣选了犹大支派，","poem":1},{"lineBreak":true},{"text":"祂所喜爱的锡安山。","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"祂为自己建造高耸的圣所，","poem":1},{"lineBreak":true},{"text":"使它像大地一样长存。","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"祂拣选了祂的仆人大卫，","poem":1},{"lineBreak":true},{"text":"把他从羊圈中召来，","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"让他离开牧羊的生活，","poem":1},{"lineBreak":true},{"text":"去牧养祂的子民雅各的后裔，","poem":1},{"lineBreak":true},{"text":"牧养祂的产业以色列。","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"于是，大卫以正直的心牧养他们，","poem":1},{"lineBreak":true},{"text":"用灵巧的手带领他们。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}