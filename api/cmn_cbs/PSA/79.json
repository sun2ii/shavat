{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":79,"content":[{"type":"heading","content":["祈求上帝拯救"]},{"type":"hebrew_subtitle","content":["亚萨的诗。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"外族人侵占你的产业，","poem":1},{"lineBreak":true},{"text":"玷污你的圣殿，","poem":1},{"lineBreak":true},{"text":"使耶路撒冷沦为废墟。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他们把你仆人的尸体喂飞鸟，","poem":1},{"lineBreak":true},{"text":"把你忠心子民的尸体给野兽吃，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"使耶路撒冷周围血流成河，","poem":1},{"lineBreak":true},{"text":"尸体无人埋葬。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们成了邻国羞辱的对象，","poem":1},{"lineBreak":true},{"text":"周围的人都嗤笑、讥讽我们。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华啊，你向我们发怒，","poem":1},{"lineBreak":true},{"text":"要到何时呢？","poem":1},{"lineBreak":true},{"text":"难道要到永远吗？","poem":1},{"lineBreak":true},{"text":"你的怒火要烧到何时呢？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你把烈怒撒向那些不承认你的列邦，","poem":1},{"lineBreak":true},{"text":"撒向那些不求告你的列国。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因为他们吞噬了雅各，","poem":1},{"lineBreak":true},{"text":"摧毁了他的家园。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你不要向我们追讨我们祖先的罪，","poem":1},{"lineBreak":true},{"text":"愿你快快地怜悯我们，","poem":1},{"lineBreak":true},{"text":"因为我们落入绝望中。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"拯救我们的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你为了自己荣耀的名而帮助我们，","poem":1},{"lineBreak":true},{"text":"为你名的缘故拯救我们，","poem":1},{"lineBreak":true},{"text":"赦免我们的罪。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"为何让列邦说：","poem":1},{"lineBreak":true},{"text":"“他们的上帝在哪里？”","poem":1},{"lineBreak":true},{"text":"求你让我们亲眼看见，","poem":1},{"lineBreak":true},{"text":"也让列邦都知道，","poem":1},{"lineBreak":true},{"text":"你为自己被害的子民申冤。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你垂听被囚之人的哀叹，","poem":1},{"lineBreak":true},{"text":"求你用大能的臂膀留住死囚的性命。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"主啊，我们的邻邦羞辱你，","poem":1},{"lineBreak":true},{"text":"求你以七倍的羞辱来报应他们。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"这样，你的子民，你草场上的羊必永远称谢你，世代称颂你。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}