{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":8,"content":[{"type":"heading","content":["上帝的荣耀与人的尊贵"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长，用迦特乐器。"]},{"type":"verse","number":1,"content":[{"text":"我们的主耶和华啊，","poem":1},{"lineBreak":true},{"text":"你的名在普世何其尊贵！","poem":1},{"lineBreak":true},{"text":"你的荣耀充满诸天。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你使孩童和婴儿口中发出颂赞，","poem":1},{"lineBreak":true},{"text":"好叫仇敌和复仇者都哑口无言。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我观看你指头创造的穹苍和你摆列的月亮星辰，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"人算什么，你竟顾念他！","poem":1},{"lineBreak":true},{"text":"世人算什么，你竟眷顾他！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你使他比天使低微一点，","poem":1},{"lineBreak":true},{"text":"赐他荣耀和尊贵作冠冕。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你派他管理你亲手造的万物，","poem":1},{"lineBreak":true},{"text":"使万物降服在他脚下：","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"一切牛羊、田野的兽、","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"空中的鸟、海里的鱼及其他水族。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我们的主耶和华啊，","poem":1},{"lineBreak":true},{"text":"你的名在普世何其尊贵！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}