{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":80,"content":[{"type":"heading","content":["为国家复兴祈求"]},{"type":"hebrew_subtitle","content":["亚萨的诗，交给乐长，调用“作证的百合花”。"]},{"type":"verse","number":1,"content":[{"text":"以色列的牧者啊，","poem":1},{"lineBreak":true},{"text":"你像照顾羊群一样带领约瑟的子孙，","poem":1},{"lineBreak":true},{"text":"求你垂听我们的祈祷。","poem":1},{"lineBreak":true},{"text":"坐在基路伯天使之上的耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你向以法莲、便雅悯和玛拿西发出光辉，","poem":1},{"lineBreak":true},{"text":"求你施展大能来拯救我们。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝啊，求你复兴我们，","poem":1},{"lineBreak":true},{"text":"用你脸上的荣光照耀我们，","poem":1},{"lineBreak":true},{"text":"使我们得救。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"万军之上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"你因你子民的祷告而发怒，","poem":1},{"lineBreak":true},{"text":"要到何时呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你使我们以泪为食，","poem":1},{"lineBreak":true},{"text":"喝下满碗的泪水。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你使我们成为邻国争夺的对象，","poem":1},{"lineBreak":true},{"text":"仇敌都嘲笑我们。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"万军之上帝啊，","poem":1},{"lineBreak":true},{"text":"求你复兴我们，","poem":1},{"lineBreak":true},{"text":"用你脸上的荣光照耀我们，","poem":1},{"lineBreak":true},{"text":"使我们得救。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你从埃及带出一棵葡萄树，","poem":1},{"lineBreak":true},{"text":"赶走外族人，把它栽种起来。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你为它开垦土地，","poem":1},{"lineBreak":true},{"text":"它就扎根生长，布满这片土地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"它的树荫遮盖群山，","poem":1},{"lineBreak":true},{"text":"枝子遮蔽高大的香柏树。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"它的枝条延伸到地中海，","poem":1},{"lineBreak":true},{"text":"嫩枝伸展到幼发拉底河。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你为何拆毁了它的篱笆，","poem":1},{"lineBreak":true},{"text":"让路人随意摘取葡萄呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"林中的野猪蹂躏它，","poem":1},{"lineBreak":true},{"text":"田间的野兽吞吃它。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"万军之上帝啊，求你回来，","poem":1},{"lineBreak":true},{"text":"求你在天上垂顾，看护这棵葡萄树，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"这棵你右手栽种的根茎，","poem":1},{"lineBreak":true},{"text":"你为自己培育的苗子。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"这树被砍倒，被焚烧，","poem":1},{"lineBreak":true},{"text":"愿你发怒毁灭仇敌。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"求你扶持你拣选的人，","poem":1},{"lineBreak":true},{"text":"就是你为自己所养育的人子。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我们必不再背弃你，","poem":1},{"lineBreak":true},{"text":"求你使我们复苏，我们必敬拜你。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"万军之上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你复兴我们，","poem":1},{"lineBreak":true},{"text":"用你脸上的荣光照耀我们，","poem":1},{"lineBreak":true},{"text":"使我们得救。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":18}