{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":81,"content":[{"type":"heading","content":["歌颂上帝的恩惠"]},{"type":"hebrew_subtitle","content":["亚萨的诗，交给乐长，用迦特乐器。"]},{"type":"verse","number":1,"content":[{"text":"要歌颂赐我们力量的上帝，","poem":1},{"lineBreak":true},{"text":"向雅各的上帝欢呼。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要唱诗，击鼓，弹奏悦耳的琴瑟。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要在我们过节的朔日和望日","poem":1},{"noteId":5},{"text":"吹响号角。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"这是以色列的律例，","poem":1},{"lineBreak":true},{"text":"是雅各的上帝所定的法令。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝攻击埃及的时候，","poem":1},{"lineBreak":true},{"text":"为约瑟立下此法度。","poem":1},{"lineBreak":true},{"text":"我在那里听见陌生的声音说：","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“我卸下了你肩上的重担，","poem":1},{"lineBreak":true},{"text":"使你的双手放下筐子，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你在苦难中向我呼求，","poem":1},{"lineBreak":true},{"text":"我就拯救了你，","poem":1},{"lineBreak":true},{"text":"从雷声隆隆的密云中应允了你。","poem":1},{"lineBreak":true},{"text":"我在米利巴泉边考验你。（细拉）","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的子民啊，","poem":1},{"lineBreak":true},{"text":"要听我的警告。","poem":1},{"lineBreak":true},{"text":"以色列人啊，","poem":1},{"lineBreak":true},{"text":"但愿你们听从我的话。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你们当中不可有别的神明，","poem":1},{"lineBreak":true},{"text":"也不可向外族的神明下拜，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我是你们的上帝耶和华，","poem":1},{"lineBreak":true},{"text":"曾带你们出埃及。","poem":1},{"lineBreak":true},{"text":"张开你们的口吧，","poem":1},{"lineBreak":true},{"text":"我必使你们饱足。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的子民却不肯听我的话，","poem":1},{"lineBreak":true},{"text":"以色列不愿意顺从我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因此我就任凭他们顽固不化，","poem":1},{"lineBreak":true},{"text":"为所欲为。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"但愿我的子民肯听从我，","poem":1},{"lineBreak":true},{"text":"以色列人肯遵行我的道。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"那时，我必迅速制服他们的敌人，","poem":1},{"lineBreak":true},{"text":"伸手攻击他们的仇敌。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"恨耶和华的人要向祂投降，","poem":1},{"lineBreak":true},{"text":"他们会永远沉沦。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要以上好的麦子供养我的子民，","poem":1},{"lineBreak":true},{"text":"让他们饱享磐石间的蜂蜜。”","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"“朔日和望日”即每月的初一和十五。","reference":{"chapter":81,"verse":3}}]},"thisChapterLink":"/api/cmn_cbs/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}