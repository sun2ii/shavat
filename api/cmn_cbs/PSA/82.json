{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":82,"content":[{"type":"heading","content":["斥责不公正的审判"]},{"type":"hebrew_subtitle","content":["亚萨的诗。"]},{"type":"verse","number":1,"content":[{"text":"上帝站在天庭的会中，","poem":1},{"lineBreak":true},{"text":"向众神明宣布祂的判决，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"说：“你们不秉公行义，","poem":1},{"lineBreak":true},{"text":"偏袒恶人要到何时呢？（细拉）","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们要为穷人和孤儿主持公道，","poem":1},{"lineBreak":true},{"text":"为贫寒和受压迫的人伸张正义。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"要救助弱小穷苦的人，","poem":1},{"lineBreak":true},{"text":"使他们脱离恶人的欺压。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你们愚昧无知，","poem":1},{"lineBreak":true},{"text":"行在黑暗中，","poem":1},{"lineBreak":true},{"text":"大地的根基摇动。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我曾说你们都是神，","poem":1},{"lineBreak":true},{"text":"都是至高者的儿子，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"但你们要跟世人一样死去，","poem":1},{"lineBreak":true},{"text":"像人间的王侯一样灭亡。”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"上帝啊，求你起来审判世界，","poem":1},{"lineBreak":true},{"text":"因为世上的万国都属于你。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}