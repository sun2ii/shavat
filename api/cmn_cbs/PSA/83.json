{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":83,"content":[{"type":"heading","content":["祈求上帝击败仇敌"]},{"type":"hebrew_subtitle","content":["亚萨的诗。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你不要缄默无声。","poem":1},{"lineBreak":true},{"text":"上帝啊，求你不要闭口不言。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"看啊，你的敌人在喧嚷，","poem":1},{"lineBreak":true},{"text":"恨你的人趾高气扬。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们用诡计害你的子民，","poem":1},{"lineBreak":true},{"text":"他们一起谋害你珍爱的人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们说：","poem":1},{"lineBreak":true},{"text":"“来吧，让我们铲除以色列，","poem":1},{"lineBreak":true},{"text":"让他们亡国，被人遗忘。”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们串通一气，","poem":1},{"lineBreak":true},{"text":"勾结起来抵挡你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们是以东人、以实玛利人、摩押人、夏甲人、","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"迦巴勒人、亚扪人、亚玛力人、非利士人和泰尔人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"亚述也跟他们勾结，","poem":1},{"lineBreak":true},{"text":"要助罗得的后代一臂之力。（细拉）","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你对付他们，","poem":1},{"lineBreak":true},{"text":"如同对付米甸人，","poem":1},{"lineBreak":true},{"text":"如同对付基顺河边的西西拉与耶宾。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们在隐·多珥灭亡，","poem":1},{"lineBreak":true},{"text":"成了地上的粪土。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你使他们首领的下场像俄立和西伊伯一样，","poem":1},{"lineBreak":true},{"text":"使他们王侯的下场像西巴和撒慕拿一样。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们曾说：","poem":1},{"lineBreak":true},{"text":"“让我们夺取上帝的草场吧。”","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我的上帝啊，求你把他们驱散，","poem":1},{"lineBreak":true},{"text":"如同狂风吹散尘土和碎秸。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"烈火怎样烧毁森林，","poem":1},{"lineBreak":true},{"text":"火焰怎样吞没山岭，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"求你也照样用狂风追赶他们，","poem":1},{"lineBreak":true},{"text":"用暴雨恐吓他们。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你使他们满脸尽是耻辱，","poem":1},{"lineBreak":true},{"text":"这样他们才会来寻求你的名。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"愿他们永远羞愧惊恐，","poem":1},{"lineBreak":true},{"text":"愿他们在耻辱中灭亡。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"让他们知道你名叫耶和华，","poem":1},{"lineBreak":true},{"text":"唯有你是普天下的至高者。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}