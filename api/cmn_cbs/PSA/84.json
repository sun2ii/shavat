{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":84,"content":[{"type":"heading","content":["渴慕住在圣殿"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗，交给乐长，用迦特乐器。"]},{"type":"verse","number":1,"content":[{"text":"万军之耶和华啊，","poem":1},{"lineBreak":true},{"text":"你的居所多么可爱！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我渴慕进入耶和华的院宇，","poem":1},{"lineBreak":true},{"text":"我的身心向永活的上帝欢呼。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"万军之耶和华，","poem":1},{"lineBreak":true},{"text":"我的王我的上帝啊，","poem":1},{"lineBreak":true},{"text":"在你的祭坛边，麻雀找到了家，","poem":1},{"lineBreak":true},{"text":"燕子筑巢养育幼雏。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"住在你殿里的人有福了！","poem":1},{"lineBreak":true},{"text":"他们不断地歌颂你。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"靠你得力量的人有福了！","poem":1},{"lineBreak":true},{"text":"他们向往到锡安朝见你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们走过流泪谷，","poem":1},{"lineBreak":true},{"text":"这谷就变成泉源之地，","poem":1},{"lineBreak":true},{"text":"秋雨使谷中水塘遍布。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们越走越有力，","poem":1},{"lineBreak":true},{"text":"都要到锡安朝见上帝。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"万军之上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你听我的祷告；","poem":1},{"lineBreak":true},{"text":"雅各的上帝啊，求你垂听。（细拉）","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"上帝啊，求你照看我们的盾牌，","poem":1},{"lineBreak":true},{"text":"垂顾你所膏立的王。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"在你的院宇住一日胜过在别处住千日！","poem":1},{"lineBreak":true},{"text":"我宁愿在我上帝的殿中看门，","poem":1},{"lineBreak":true},{"text":"也不愿住在恶人的帐篷里。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因为耶和华上帝是太阳，是盾牌；","poem":1},{"lineBreak":true},{"text":"祂赐下恩惠和尊荣，","poem":1},{"lineBreak":true},{"text":"不留下任何好处不赐给行为纯全的人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"万军之耶和华啊，","poem":1},{"lineBreak":true},{"text":"信靠你的人有福了！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}