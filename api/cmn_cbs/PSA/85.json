{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":85,"content":[{"type":"heading","content":["为国家求福"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗，交给乐长。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，你恩待了你的土地，","poem":1},{"lineBreak":true},{"text":"恢复了雅各的福祉。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你赦免了你子民的罪恶，","poem":1},{"lineBreak":true},{"text":"遮盖了他们所有的过犯。（细拉）","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你收回所有怒气，","poem":1},{"lineBreak":true},{"text":"不再发烈怒。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"拯救我们的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你复兴我们，","poem":1},{"lineBreak":true},{"text":"止息你对我们的怒气。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你要向我们永远发怒吗？","poem":1},{"lineBreak":true},{"text":"你的怒气要延续到万代吗？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你不再复兴我们，","poem":1},{"lineBreak":true},{"text":"使你的子民靠你欢喜吗？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华啊，求你向我们施慈爱，","poem":1},{"lineBreak":true},{"text":"拯救我们。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我要听耶和华上帝所说的话，","poem":1},{"lineBreak":true},{"text":"因为祂应许赐平安给祂的子民，","poem":1},{"lineBreak":true},{"text":"祂的圣民。","poem":1},{"lineBreak":true},{"text":"但他们不可再转向愚昧。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂必很快拯救敬畏祂的人，","poem":1},{"lineBreak":true},{"text":"好让祂的荣耀常驻在我们的地上。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"慈爱和忠信相遇，","poem":1},{"lineBreak":true},{"text":"公义与平安相亲。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"忠信从地上生出，","poem":1},{"lineBreak":true},{"text":"公义从天上俯视。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华赐下福祉，","poem":1},{"lineBreak":true},{"text":"我们的土地就出产丰富。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"公义要行在祂面前，为祂开路。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}