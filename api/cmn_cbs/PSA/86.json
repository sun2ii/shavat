{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":86,"content":[{"type":"heading","content":["祈求上帝施恩"]},{"type":"hebrew_subtitle","content":["大卫的祈祷。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我贫穷困苦，","poem":1},{"lineBreak":true},{"text":"求你垂听我的祷告，应允我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你保护我的性命，","poem":1},{"lineBreak":true},{"text":"因为我忠于你。","poem":1},{"lineBreak":true},{"text":"你是我的上帝，我信靠你，","poem":1},{"lineBreak":true},{"text":"求你拯救你的仆人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"主啊，我终日向你呼求，","poem":1},{"lineBreak":true},{"text":"求你怜悯我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"主啊，我的心仰望你，","poem":1},{"lineBreak":true},{"text":"求你赐仆人欢乐。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"主啊，你良善仁慈，乐意赦免，","poem":1},{"lineBreak":true},{"text":"以丰盛的慈爱待一切求告你的人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华啊，求你听我的祷告，","poem":1},{"lineBreak":true},{"text":"垂听我的恳求。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"患难之时，我要向你呼求，","poem":1},{"lineBreak":true},{"text":"因为你必应允我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"主啊，众神明中没有一位能与你相比，","poem":1},{"lineBreak":true},{"text":"你的作为无与伦比。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"主啊，你创造的万国都要来敬拜你，","poem":1},{"lineBreak":true},{"text":"将荣耀归给你的名。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因为你伟大无比，行事奇妙，","poem":1},{"lineBreak":true},{"text":"唯有你是上帝。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华啊，求你教我行你的道，","poem":1},{"lineBreak":true},{"text":"我要行在你的真理中，","poem":1},{"lineBreak":true},{"text":"求你使我一心敬畏你的名。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"主，我的上帝啊，","poem":1},{"lineBreak":true},{"text":"我要全心赞美你，","poem":1},{"lineBreak":true},{"text":"我要永远将荣耀归给你的名。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因为你向我大施慈爱，","poem":1},{"lineBreak":true},{"text":"你从阴间深处救了我。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"上帝啊，狂傲的人起来攻击我，","poem":1},{"lineBreak":true},{"text":"一群凶残之徒要杀害我，","poem":1},{"lineBreak":true},{"text":"他们不把你放在眼里。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"但主啊，","poem":1},{"lineBreak":true},{"text":"你是有怜悯和恩典的上帝，","poem":1},{"lineBreak":true},{"text":"不轻易发怒，充满慈爱，","poem":1},{"lineBreak":true},{"text":"无比信实。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"求你垂顾我，怜悯我，","poem":1},{"lineBreak":true},{"text":"赐力量给你的仆人，","poem":1},{"lineBreak":true},{"text":"拯救你婢女的儿子。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"求你赐下恩待我的凭据，","poem":1},{"lineBreak":true},{"text":"使那些恨我的人见状就抱愧蒙羞，","poem":1},{"lineBreak":true},{"text":"因为你耶和华帮助我、安慰我。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}