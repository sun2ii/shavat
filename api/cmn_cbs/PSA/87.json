{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":87,"content":[{"type":"heading","content":["颂赞锡安"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和华的城坐落在圣山上。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"祂喜爱锡安的门，","poem":1},{"lineBreak":true},{"text":"胜过雅各其他住处。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝的城啊，","poem":1},{"lineBreak":true},{"text":"人们传扬你的荣耀。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“我要把埃及人","poem":1},{"noteId":6},{"text":"、巴比伦人、非利士人、泰尔人和古实人列为认识我的民族，","poem":1},{"lineBreak":true},{"text":"视他们为生在锡安的人。”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"至于锡安，必有人说：","poem":1},{"lineBreak":true},{"text":"“万族必生在这城，","poem":1},{"lineBreak":true},{"text":"至高者必亲自坚立这城。”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华将万民登记入册的时候，","poem":1},{"lineBreak":true},{"text":"必把他们列为生在锡安的人。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"他们跳舞歌唱说：","poem":1},{"lineBreak":true},{"text":"“我们蒙福的泉源都在锡安。”","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"“埃及人”希伯来文是“拉哈伯”，埃及的别名。","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/cmn_cbs/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}