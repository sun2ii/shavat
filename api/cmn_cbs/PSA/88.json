{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":88,"content":[{"type":"heading","content":["求上帝眷顾"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗歌，就是以斯拉人希幔的训诲诗，交给乐长，调用“麻哈拉利暗俄”",{"noteId":7},"。"]},{"type":"verse","number":1,"content":[{"text":"耶和华，拯救我的上帝啊，","poem":1},{"lineBreak":true},{"text":"我昼夜不停地呼求你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你垂听我的祷告，","poem":1},{"lineBreak":true},{"text":"侧耳听我的呼求。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我饱经患难，","poem":1},{"lineBreak":true},{"text":"生命在阴间的边缘。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我被列在下坟墓的人中，","poem":1},{"lineBreak":true},{"text":"我的精力耗尽。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我被扔在死人中，","poem":1},{"lineBreak":true},{"text":"如同被杀的人躺在坟墓里，","poem":1},{"lineBreak":true},{"text":"被你遗忘，不再蒙你眷顾。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你已经把我扔在极深的坑中，","poem":1},{"lineBreak":true},{"text":"扔在漆黑的深渊。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的烈怒重重地压着我，","poem":1},{"lineBreak":true},{"text":"你用汹涌的波涛把我淹没。（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你使我众叛亲离，遭人唾弃。","poem":1},{"lineBreak":true},{"text":"我陷入困境，无路可逃。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我因忧伤而眼睛昏花。","poem":1},{"lineBreak":true},{"text":"耶和华啊，我天天呼求你，","poem":1},{"lineBreak":true},{"text":"举手向你呼求。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你要行神迹给死人看吗？","poem":1},{"lineBreak":true},{"text":"死人会起来赞美你吗？（细拉）","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"坟墓里的死人怎能述说你的慈爱呢？","poem":1},{"lineBreak":true},{"text":"灭亡的人怎能传扬你的信实呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"黑暗之地有谁知道你的神迹呢？","poem":1},{"lineBreak":true},{"text":"在被遗忘之地有谁知道你的公义作为呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华啊，我向你呼求，","poem":1},{"lineBreak":true},{"text":"我在清晨向你祷告。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华啊，你为何弃绝我？","poem":1},{"lineBreak":true},{"text":"为何掩面不理我？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我从小受苦，几乎丧命。","poem":1},{"lineBreak":true},{"text":"你使我惊恐不已，陷入绝望。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你的烈怒吞噬了我，","poem":1},{"lineBreak":true},{"text":"你可怕的攻击毁灭了我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"这些灾难如洪涛整天环绕我，","poem":1},{"lineBreak":true},{"text":"四面围住我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你使我的亲朋好友离我而去，","poem":1},{"lineBreak":true},{"text":"只有黑暗与我相伴。","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"“麻哈拉利暗俄”意为“受苦”。","reference":{"chapter":88,"verse":0}}]},"thisChapterLink":"/api/cmn_cbs/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}