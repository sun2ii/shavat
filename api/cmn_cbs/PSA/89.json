{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":89,"content":[{"type":"heading","content":["永远配受称颂的上帝"]},{"type":"hebrew_subtitle","content":["以斯拉人以探的训诲诗。"]},{"type":"verse","number":1,"content":[{"text":"我要永远称颂耶和华的慈爱！","poem":1},{"lineBreak":true},{"text":"我的口要传扬你的信实直到万代。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要宣告：","poem":1},{"lineBreak":true},{"text":"你的慈爱存到永远，","poem":1},{"lineBreak":true},{"text":"你的信实坚立在天。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你曾说：","poem":1},{"lineBreak":true},{"text":"“我与我所拣选的人立了约，","poem":1},{"lineBreak":true},{"text":"向我的仆人大卫起了誓，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"‘我要使你的后裔永远坐在宝座上，世代为王。’”（细拉）","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华啊，诸天要颂扬你的奇妙，","poem":1},{"lineBreak":true},{"text":"众圣者要同聚赞美你的信实。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"天上有谁能与耶和华相比，","poem":1},{"lineBreak":true},{"text":"众天使中谁能像祂？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂在众圣者的会中大受敬畏，","poem":1},{"lineBreak":true},{"text":"祂的威严无与伦比。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"万军之上帝耶和华啊，","poem":1},{"lineBreak":true},{"text":"谁能像你能力伟大，信实无比？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你掌管汹涌的大海，","poem":1},{"lineBreak":true},{"text":"平息惊涛骇浪。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你击碎海怪","poem":1},{"noteId":8},{"text":"，使其毙命，","poem":1},{"lineBreak":true},{"text":"以大能的臂膀驱散仇敌。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"天地都属于你，","poem":1},{"lineBreak":true},{"text":"世界和其中的一切都是你造的。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你创造了南北，","poem":1},{"lineBreak":true},{"text":"他泊山和黑门山欢颂你的名。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你有大能的臂膀，","poem":1},{"lineBreak":true},{"text":"你的手有力量，你的右手高举。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你的宝座以公平和正义为根基，","poem":1},{"lineBreak":true},{"text":"你以慈爱和信实为先锋。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"懂得向你欢呼的人有福了，","poem":1},{"lineBreak":true},{"text":"他们走在你的荣光之中。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他们因你的名终日欢欣，","poem":1},{"lineBreak":true},{"text":"因你的公义而雀跃。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你是他们的力量和荣耀，","poem":1},{"lineBreak":true},{"text":"你的恩惠使我们的角高举。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我们的盾牌是耶和华所赐的，","poem":1},{"lineBreak":true},{"text":"我们的王属于以色列的圣者。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你曾在异象中对你忠心的子民说：","poem":1},{"lineBreak":true},{"text":"“我已把力量赐给一位勇士，","poem":1},{"lineBreak":true},{"text":"已提升我在民中拣选的人。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我找到了我的仆人大卫，","poem":1},{"lineBreak":true},{"text":"用我的圣油膏立他。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我的手必扶持他，","poem":1},{"lineBreak":true},{"text":"我的臂膀必加给他力量。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"仇敌胜不过他，","poem":1},{"lineBreak":true},{"text":"恶人不能欺压他。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我要当着他的面击垮他的敌人，","poem":1},{"lineBreak":true},{"text":"打倒恨他的人。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我要以信实和慈爱待他，","poem":1},{"lineBreak":true},{"text":"他的角必因我的名而高举。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我要使他左手掌管大海，","poem":1},{"lineBreak":true},{"text":"右手统治江河。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他要向我高呼，","poem":1},{"lineBreak":true},{"text":"‘你是我的父亲，我的上帝，","poem":1},{"lineBreak":true},{"text":"拯救我的磐石。’","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我要立他为我的长子，","poem":1},{"lineBreak":true},{"text":"做世上至尊的君王。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我要永远用慈爱待他，","poem":1},{"lineBreak":true},{"text":"我与他立的约永不失效。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我要使他的后裔永无穷尽，","poem":1},{"lineBreak":true},{"text":"让他的王位与天同存。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"如果他的后代背弃我的律法，","poem":1},{"lineBreak":true},{"text":"不遵行我的典章，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"触犯我的律例，","poem":1},{"lineBreak":true},{"text":"不守我的诫命，","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我必因他们的罪过而杖责他们，","poem":1},{"lineBreak":true},{"text":"因他们的罪愆而鞭笞他们。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"但我不会收回我的慈爱，","poem":1},{"lineBreak":true},{"text":"也不会背弃我的信实。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"我必不毁约，也不食言。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"因我曾凭自己的圣洁起誓，","poem":1},{"lineBreak":true},{"text":"我对大卫绝无谎言。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他的后裔必永无穷尽，","poem":1},{"lineBreak":true},{"text":"他的王位必在我面前如日长存，","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"又如天上忠心作证的月亮一样永固。”（细拉）","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"如今，你对你所膏立的王大发怒气，拒绝并丢弃了他。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"你废弃与他所立的约，","poem":1},{"lineBreak":true},{"text":"把他的冠冕扔在尘土中。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"你攻破了他的城墙，","poem":1},{"lineBreak":true},{"text":"使他的坚垒沦为废墟。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"路人都趁机劫掠他的财物，","poem":1},{"lineBreak":true},{"text":"邻居都嘲笑他。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"你助长了他敌人的势力，","poem":1},{"lineBreak":true},{"text":"使敌人洋洋得意。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"你使他的刀剑卷刃，","poem":1},{"lineBreak":true},{"text":"你使他败退沙场。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"你使他的威荣尽失，","poem":1},{"lineBreak":true},{"text":"王位倾覆。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"你使他未老先衰，","poem":1},{"lineBreak":true},{"text":"受尽羞辱。（细拉）","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"你隐藏自己要到何时呢？","poem":1},{"lineBreak":true},{"text":"要到永远吗？","poem":1},{"lineBreak":true},{"text":"你的怒火要烧到何时呢？","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"求你顾念我的生命何其短暂！","poem":1},{"lineBreak":true},{"text":"你创造的世人何其虚幻！","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"谁能长生不死？","poem":1},{"lineBreak":true},{"text":"谁能救自己脱离阴间的权势呢？（细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"主啊，你从前凭自己的信实向大卫应许的慈爱在哪里呢？","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"主啊，求你记住仆人们如何受羞辱，","poem":1},{"lineBreak":true},{"text":"我心中如何忍受列国的嘲笑。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"你的仇敌嘲笑你所膏立的王，","poem":1},{"lineBreak":true},{"text":"他们嘲笑他的一举一动。","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"耶和华永远当受称颂。","poem":1},{"lineBreak":true},{"text":"阿们！阿们！","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"“海怪”希伯来文是“拉哈伯”。","reference":{"chapter":89,"verse":10}}]},"thisChapterLink":"/api/cmn_cbs/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}