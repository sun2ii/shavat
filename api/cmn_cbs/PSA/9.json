{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":9,"content":[{"type":"heading","content":["称颂上帝的公义"]},{"type":"hebrew_subtitle","content":["大卫的诗，交给乐长，调用“慕拉辨”",{"noteId":1},"。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我要全心赞美你，","poem":1},{"lineBreak":true},{"text":"传扬你一切奇妙的作为。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要因你欢喜快乐，","poem":1},{"lineBreak":true},{"text":"至高者啊，我要歌颂你的名。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的仇敌必败退，","poem":1},{"lineBreak":true},{"text":"在你面前倒地身亡。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你坐在宝座上按公义审判，","poem":1},{"lineBreak":true},{"text":"你为我主持公道。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你斥责列国，消灭恶人，","poem":1},{"lineBreak":true},{"text":"永永远远抹去他们的名字。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"仇敌永远灭亡了，","poem":1},{"lineBreak":true},{"text":"你把他们的城池连根拔起，","poem":1},{"lineBreak":true},{"text":"无人再记得他们。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华永远掌权，","poem":1},{"lineBreak":true},{"text":"祂已设立施行审判的宝座。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂要按公义审判世界，","poem":1},{"lineBreak":true},{"text":"按公正审判万民。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华是受欺压之人的避难所，","poem":1},{"lineBreak":true},{"text":"是他们患难之时的避风港。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"凡认识你名的人都必信靠你，","poem":1},{"lineBreak":true},{"text":"因为你从来不丢弃寻求你的人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"要歌颂住在锡安的耶和华，","poem":1},{"lineBreak":true},{"text":"在列邦传扬祂的作为。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因为祂追讨血债，眷顾受害者，","poem":1},{"lineBreak":true},{"text":"不忽略受苦者的呼求。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"看看仇敌对我的迫害！","poem":1},{"lineBreak":true},{"text":"求你怜悯我，","poem":1},{"lineBreak":true},{"text":"救我离开死亡之门，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我好在少女锡安的城门口称颂你，","poem":1},{"lineBreak":true},{"text":"因你的拯救而欢乐。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"列邦挖了陷阱却自陷其中，","poem":1},{"lineBreak":true},{"text":"暗设网罗却缠住自己的脚。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华彰显自己，施行审判，","poem":1},{"lineBreak":true},{"text":"使恶人自食其果。（细拉）","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"恶人必下阴间，忘记上帝的列邦都落此下场。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"贫乏人不会永远被遗忘，","poem":1},{"lineBreak":true},{"text":"受苦人的希望也不会一直落空。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和华啊，求你起来，","poem":1},{"lineBreak":true},{"text":"别让世人向你夸胜，","poem":1},{"lineBreak":true},{"text":"愿你审判列邦。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你使列邦恐惧颤抖，","poem":1},{"lineBreak":true},{"text":"让他们明白自己不过是人。（细拉）","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"“慕拉辨”希伯来文的意思是“丧子”。","reference":{"chapter":9,"verse":0}}]},"thisChapterLink":"/api/cmn_cbs/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}