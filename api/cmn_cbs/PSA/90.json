{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":90,"content":[{"type":"heading","content":["上帝与世人"]},{"type":"hebrew_subtitle","content":["上帝的仆人摩西的祈祷。"]},{"type":"verse","number":1,"content":[{"text":"主啊，","poem":1},{"lineBreak":true},{"text":"你是我们世世代代的居所。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"群山尚未诞生，","poem":1},{"lineBreak":true},{"text":"大地和世界还未形成，","poem":1},{"lineBreak":true},{"text":"你就是上帝，直到永永远远。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你叫人归回尘土，","poem":1},{"lineBreak":true},{"text":"说：“世人啊，归回尘土吧。”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"在你眼中，","poem":1},{"lineBreak":true},{"text":"千年如刚过的昨日，又如夜里的一更。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你像急流一般把世人冲走，","poem":1},{"lineBreak":true},{"text":"叫他们如梦消逝。","poem":1},{"lineBreak":true},{"text":"他们像清晨的嫩草，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"清晨还生机盎然，","poem":1},{"lineBreak":true},{"text":"傍晚就凋谢枯萎。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我们被你的怒气消灭，","poem":1},{"lineBreak":true},{"text":"你的愤怒使我们颤抖。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你知道我们的罪恶，","poem":1},{"lineBreak":true},{"text":"我们隐秘的罪显露在你面前。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我们活在你的烈怒之下，","poem":1},{"lineBreak":true},{"text":"一生就像一声叹息飞逝而去。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我们一生七十岁，","poem":1},{"lineBreak":true},{"text":"强壮的可活八十岁，","poem":1},{"lineBreak":true},{"text":"但人生最美好的时光也充满劳苦和愁烦，","poem":1},{"lineBreak":true},{"text":"生命转瞬即逝，","poem":1},{"lineBreak":true},{"text":"我们便如飞而去。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"谁明白你愤怒的威力？","poem":1},{"lineBreak":true},{"text":"谁明白你的烈怒而给你当得的敬畏呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你教导我们明白人生有限，","poem":1},{"lineBreak":true},{"text":"使我们做有智慧的人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华啊，我还要等候多久？","poem":1},{"lineBreak":true},{"text":"求你回转，怜悯你的仆人。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"求你在清晨以慈爱来满足我们，","poem":1},{"lineBreak":true},{"text":"使我们一生欢喜歌唱。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你使我们先前经历了多少苦难和不幸的岁月，","poem":1},{"lineBreak":true},{"text":"求你也赐给我们多少欢乐的岁月。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"求你让仆人们看见你的作为，","poem":1},{"lineBreak":true},{"text":"让我们的后代看见你的威荣。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"愿主，我们的上帝恩待我们，","poem":1},{"lineBreak":true},{"text":"使我们所做的亨通，","poem":1},{"lineBreak":true},{"text":"使我们所做的亨通。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}