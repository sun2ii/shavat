{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":91,"content":[{"type":"heading","content":["上帝是我们的保护者"]},{"type":"verse","number":1,"content":[{"text":"安居在至高者隐秘处的人，","poem":1},{"lineBreak":true},{"text":"必蒙全能者的荫庇。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要对耶和华说：","poem":1},{"lineBreak":true},{"text":"“你是我的避难所，我的堡垒，","poem":1},{"lineBreak":true},{"text":"是我所信靠的上帝。”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂必救你脱离猎人的网罗和致命的瘟疫。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂必用祂的羽毛遮盖你，","poem":1},{"lineBreak":true},{"text":"你必在祂翅膀下蒙庇护，","poem":1},{"lineBreak":true},{"text":"祂的信实是你的盾牌和壁垒。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你必不惧怕黑夜的恐怖，","poem":1},{"lineBreak":true},{"text":"或白日的飞箭，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"或黑暗中横行的瘟疫，","poem":1},{"lineBreak":true},{"text":"或正午肆虐的灾难。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"尽管千人仆倒在你左边，","poem":1},{"lineBreak":true},{"text":"万人仆倒在你右边，","poem":1},{"lineBreak":true},{"text":"你必安然无恙。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你必亲眼目睹恶人受惩罚。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为你以耶和华为避难所，","poem":1},{"lineBreak":true},{"text":"以至高者为居所，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祸患不会临到你身上，","poem":1},{"lineBreak":true},{"text":"灾难不会靠近你的帐篷。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因为祂必吩咐祂的天使随时随地保护你。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们会用手托住你，","poem":1},{"lineBreak":true},{"text":"不让你的脚碰在石头上。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你必将狮子和毒蛇踩在脚下，","poem":1},{"lineBreak":true},{"text":"你必践踏猛狮和巨蛇。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华说：“因为他爱慕我，我必拯救他；","poem":1},{"lineBreak":true},{"text":"因为他信靠我的名，我必保护他。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他求告我，我就答应他；","poem":1},{"lineBreak":true},{"text":"他遭遇患难，我必与他同在。","poem":1},{"lineBreak":true},{"text":"我必解救他，赐他尊贵的地位。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我必赐他长寿，","poem":1},{"lineBreak":true},{"text":"并让他看见我的拯救之恩。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}