{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":92,"content":[{"type":"heading","content":["赞美之歌"]},{"type":"hebrew_subtitle","content":["安息日唱的诗歌。"]},{"type":"verse","number":1,"content":[{"text":"至高的耶和华啊，","poem":1},{"lineBreak":true},{"text":"赞美你、歌颂你的名是何等美好！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"伴随着十弦琴和竖琴的乐声，","poem":1},{"lineBreak":true},{"text":"我早晨宣扬你的慈爱，","poem":1},{"lineBreak":true},{"text":"晚上述说你的信实。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华啊，你的作为使我快乐，","poem":1},{"lineBreak":true},{"text":"我要因你手所做的而欢唱。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华啊，你的作为何等伟大！","poem":1},{"lineBreak":true},{"text":"你的心思何等深奥！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"无知的人不会明白，","poem":1},{"lineBreak":true},{"text":"愚蠢的人无法理解：","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"虽然恶人如草滋生，歹徒一时亨通，","poem":1},{"lineBreak":true},{"text":"但他们终必永远灭亡。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"唯有你永远受尊崇。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华啊，你的仇敌终必灭亡，","poem":1},{"lineBreak":true},{"text":"凡作恶的都要被驱散。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你使我的角高举，如野牛之角，","poem":1},{"lineBreak":true},{"text":"你用新油浇灌我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我亲眼看见我的敌人被击溃，","poem":1},{"lineBreak":true},{"text":"亲耳听见那些攻击我的恶人被打败。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"义人必如棕树一样繁盛，","poem":1},{"lineBreak":true},{"text":"像黎巴嫩香柏树一样茁壮。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他们栽在耶和华的殿中，","poem":1},{"lineBreak":true},{"text":"他们在我们上帝的院子里长得枝繁叶茂。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们到老仍然结果子，","poem":1},{"lineBreak":true},{"text":"一片青翠，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"宣扬说：“耶和华公正无私，","poem":1},{"lineBreak":true},{"text":"祂是我的磐石，","poem":1},{"lineBreak":true},{"text":"祂里面毫无不义。”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":14}