{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":94,"content":[{"type":"heading","content":["上帝是审判者"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，你是申冤的上帝；","poem":1},{"lineBreak":true},{"text":"申冤的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你彰显荣光。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"审判世界的主啊，","poem":1},{"lineBreak":true},{"text":"求你起来使骄傲人受应得的报应。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"恶人洋洋得意，要到何时呢？","poem":1},{"lineBreak":true},{"text":"要到何时呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们口吐狂妄之言，","poem":1},{"lineBreak":true},{"text":"作恶的人都爱自夸。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华啊，他们压迫你的子民，","poem":1},{"lineBreak":true},{"text":"苦害你的产业。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们杀死寡妇和寄居者，","poem":1},{"lineBreak":true},{"text":"还谋害孤儿，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"并说：“耶和华看不见，","poem":1},{"lineBreak":true},{"text":"雅各的上帝不会知道。”","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"民中的愚昧人啊，你们要思想；","poem":1},{"lineBreak":true},{"text":"无知的人啊，你们何时才有智慧？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"难道造耳朵的上帝听不见吗？","poem":1},{"lineBreak":true},{"text":"难道造眼睛的上帝看不见吗？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"管教列国的上帝难道不惩罚吗？","poem":1},{"lineBreak":true},{"text":"赐人知识的上帝难道无知吗？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华洞悉人的思想，","poem":1},{"lineBreak":true},{"text":"祂知道人的思想虚妄。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和华啊，蒙你管教并用律法训诲的人有福了！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你使他们在患难中有平安，","poem":1},{"lineBreak":true},{"text":"直到为恶人挖好了坑。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华不会丢弃祂的子民，","poem":1},{"lineBreak":true},{"text":"也不会遗弃祂的产业。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"公正的审判必重现，","poem":1},{"lineBreak":true},{"text":"心地正直的人都必拥护。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"谁肯为我奋起攻击恶人？","poem":1},{"lineBreak":true},{"text":"谁肯为我起来抵挡作恶的人？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和华若不帮助我，","poem":1},{"lineBreak":true},{"text":"我早已归入死亡的沉寂中了。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我说：“我失脚滑倒了！”","poem":1},{"lineBreak":true},{"text":"耶和华啊，你便以慈爱扶助我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"当我忧心忡忡的时候，","poem":1},{"lineBreak":true},{"text":"你的抚慰带给我欢乐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"借律例制造不幸的首领，","poem":1},{"lineBreak":true},{"text":"岂能与你联盟？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们结党攻击义人，","poem":1},{"lineBreak":true},{"text":"残害无辜。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"但耶和华是我的堡垒，","poem":1},{"lineBreak":true},{"text":"我的上帝是保护我的磐石。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"祂必使恶人自食恶果，","poem":1},{"lineBreak":true},{"text":"因他们的罪恶而毁灭他们。","poem":1},{"lineBreak":true},{"text":"我们的上帝耶和华必毁灭他们。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}