{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":95,"content":[{"type":"heading","content":["赞美上帝之歌"]},{"type":"verse","number":1,"content":[{"text":"来吧，让我们向耶和华歌唱，","poem":1},{"lineBreak":true},{"text":"向拯救我们的磐石欢呼。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"让我们怀着感恩的心来到祂面前，","poem":1},{"lineBreak":true},{"text":"用诗歌颂扬祂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为耶和华是伟大的上帝，","poem":1},{"lineBreak":true},{"text":"是众神明之上的大君王。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂掌管地的深处，","poem":1},{"lineBreak":true},{"text":"祂拥有山的高峰。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"海洋属于祂，是祂创造的，","poem":1},{"lineBreak":true},{"text":"陆地也是祂造的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"来吧，让我们俯伏敬拜，","poem":1},{"lineBreak":true},{"text":"在创造我们的耶和华面前跪下。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因为祂是我们的上帝，","poem":1},{"lineBreak":true},{"text":"我们是祂照管的子民，","poem":1},{"lineBreak":true},{"text":"是祂牧放的羊群。","poem":1},{"lineBreak":true},{"text":"但愿你们今日听从祂的声音！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"不可像你们祖先在米利巴，","poem":1},{"lineBreak":true},{"text":"在旷野的玛撒那样心里顽固。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华说：“虽然他们见过我的作为，","poem":1},{"lineBreak":true},{"text":"却仍然试我、探我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"所以，我憎恶他们四十年之久，","poem":1},{"lineBreak":true},{"text":"我说，‘他们心向歧途，不认识我的道路。’","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因此我愤然起誓说，","poem":1},{"lineBreak":true},{"text":"‘他们绝不可进入我的安息！’”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}