{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":96,"content":[{"type":"heading","content":["上帝是至高的君王"]},{"type":"verse","number":1,"content":[{"text":"你们要向耶和华唱新歌，","poem":1},{"lineBreak":true},{"text":"普世都要歌颂耶和华。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要歌颂耶和华，颂赞祂的名，","poem":1},{"lineBreak":true},{"text":"天天传扬祂的拯救之恩。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要在列国述说祂的荣耀，","poem":1},{"lineBreak":true},{"text":"在万民中述说祂的奇妙作为。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因为耶和华无比伟大，","poem":1},{"lineBreak":true},{"text":"当受至高的颂扬；","poem":1},{"lineBreak":true},{"text":"祂超越一切神明，当受敬畏。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"列邦的神明都是假的，","poem":1},{"lineBreak":true},{"text":"唯独耶和华创造了诸天。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂带着尊贵和威严，","poem":1},{"lineBreak":true},{"text":"祂的圣所充满能力和荣美。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"万族万民啊，","poem":1},{"lineBreak":true},{"text":"要把荣耀和能力归给耶和华，","poem":1},{"lineBreak":true},{"text":"归给耶和华！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"要将耶和华之名当得的荣耀归给祂，","poem":1},{"lineBreak":true},{"text":"要带着祭物到祂的院宇。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"当敬拜圣洁荣耀的耶和华，","poem":1},{"lineBreak":true},{"text":"大地要在祂面前颤抖。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"要告诉列国：","poem":1},{"lineBreak":true},{"text":"“耶和华掌权，","poem":1},{"lineBreak":true},{"text":"世界坚立不摇，","poem":1},{"lineBreak":true},{"text":"祂必公正地审判万民。”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"愿天欢喜，愿地快乐，","poem":1},{"lineBreak":true},{"text":"愿海洋和其中的一切都欢呼。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"愿田野和其中的万物都欢腾，","poem":1},{"lineBreak":true},{"text":"愿林中的树木都在耶和华面前欢唱。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因为祂来了，祂来审判天下，","poem":1},{"lineBreak":true},{"text":"祂要按公义审判世界，","poem":1},{"lineBreak":true},{"text":"凭祂的信实审判万民。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}