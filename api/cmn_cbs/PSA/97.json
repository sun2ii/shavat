{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":97,"content":[{"type":"heading","content":["上帝是至高的统治者"]},{"type":"verse","number":1,"content":[{"text":"耶和华掌权，大地要欢欣！","poem":1},{"lineBreak":true},{"text":"众海岛要快乐！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"密云和黑暗环绕在祂周围，","poem":1},{"lineBreak":true},{"text":"公义和公平是祂宝座的根基。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"烈火做祂的先锋，","poem":1},{"lineBreak":true},{"text":"烧灭祂周围的仇敌。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂的闪电照亮世界，","poem":1},{"lineBreak":true},{"text":"大地看见就颤抖。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在天下之主耶和华面前，","poem":1},{"lineBreak":true},{"text":"群山如蜡熔化。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"诸天述说祂的公义，","poem":1},{"lineBreak":true},{"text":"万民瞻仰祂的荣耀。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愿一切祭拜偶像、","poem":1},{"lineBreak":true},{"text":"以神像夸口的人都蒙羞。","poem":1},{"lineBreak":true},{"text":"所有的神明啊，","poem":1},{"lineBreak":true},{"text":"你们都要向耶和华下拜。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华啊，听见你的审判，","poem":1},{"lineBreak":true},{"text":"锡安就欢喜，","poem":1},{"lineBreak":true},{"text":"犹大的城邑就快乐。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为你耶和华是普世的至高者，","poem":1},{"lineBreak":true},{"text":"凌驾于万神之上。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"爱耶和华的人都要憎恨罪恶，","poem":1},{"lineBreak":true},{"text":"因为祂保护敬虔人的生命，","poem":1},{"lineBreak":true},{"text":"从恶人手中解救他们。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"光照亮义人，","poem":1},{"lineBreak":true},{"text":"心地正直的人有喜乐。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你们义人要以耶和华为乐，","poem":1},{"lineBreak":true},{"text":"称谢祂的圣名。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}