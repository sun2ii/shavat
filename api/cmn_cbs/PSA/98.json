{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":98,"content":[{"type":"heading","content":["颂扬上帝的拯救"]},{"type":"hebrew_subtitle","content":["一首诗歌。"]},{"type":"verse","number":1,"content":[{"text":"你们要向耶和华唱新歌，","poem":1},{"lineBreak":true},{"text":"因为祂的作为奇妙，","poem":1},{"lineBreak":true},{"text":"祂以右手和圣洁的臂膀施行拯救。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华显明了祂的拯救之恩，","poem":1},{"lineBreak":true},{"text":"向列邦彰显了祂的公义。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂没有忘记以慈爱和信实对待以色列人，","poem":1},{"lineBreak":true},{"text":"普天下都看见我们上帝的救恩。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"普世要向耶和华欢呼，","poem":1},{"lineBreak":true},{"text":"欢欢喜喜地高声颂扬。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要弹奏竖琴歌颂耶和华，","poem":1},{"lineBreak":true},{"text":"伴着琴声唱诗歌颂祂。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"要伴随着号声和角声在大君王耶和华面前欢呼。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"大海和海中的一切要颂扬，","poem":1},{"lineBreak":true},{"text":"大地和地上的一切要欢呼。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"江河要鼓掌，","poem":1},{"lineBreak":true},{"text":"群山要在耶和华面前齐声欢唱，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为祂要来审判大地，","poem":1},{"lineBreak":true},{"text":"要公义地审判世界，","poem":1},{"lineBreak":true},{"text":"公正地审判万民。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}