{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbs","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"8a6689b3544af059e6077f6a9b93d6c43499c5f9692b20ed9d590c493ca23457","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbs/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":99,"content":[{"type":"heading","content":["上帝是圣洁的君王"]},{"type":"verse","number":1,"content":[{"text":"耶和华掌权，万民当颤抖；","poem":1},{"lineBreak":true},{"text":"祂坐在基路伯天使之上，","poem":1},{"lineBreak":true},{"text":"大地当战栗。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华在锡安伟大无比，","poem":1},{"lineBreak":true},{"text":"超越万邦。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"万邦要赞美你伟大而可畏的名，","poem":1},{"lineBreak":true},{"text":"你是圣洁的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你是大能的君王，","poem":1},{"lineBreak":true},{"text":"喜爱正义，维护公平，","poem":1},{"lineBreak":true},{"text":"在雅各家秉公行义。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要尊崇我们的上帝耶和华，","poem":1},{"lineBreak":true},{"text":"俯伏在祂脚凳前敬拜，","poem":1},{"lineBreak":true},{"text":"祂是圣洁的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂的祭司中有摩西和亚伦，","poem":1},{"lineBreak":true},{"text":"呼求祂的人中有撒母耳。","poem":1},{"lineBreak":true},{"text":"他们求告耶和华，","poem":1},{"lineBreak":true},{"text":"祂就应允他们。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂在云柱中向他们说话，","poem":1},{"lineBreak":true},{"text":"他们遵守祂赐下的法度和律例。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华，我们的上帝啊，","poem":1},{"lineBreak":true},{"text":"你应允了他们，","poem":1},{"lineBreak":true},{"text":"向他们显明你是赦罪的上帝，","poem":1},{"lineBreak":true},{"text":"但也惩罚他们的罪恶。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"要尊崇我们的上帝耶和华，","poem":1},{"lineBreak":true},{"text":"在祂的圣山上敬拜祂，","poem":1},{"lineBreak":true},{"text":"因为我们的上帝耶和华是圣洁的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}