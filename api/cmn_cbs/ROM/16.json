{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ROM","translationId":"cmn_cbs","name":"罗马书","commonName":"罗马书","title":"罗马书","order":45,"numberOfChapters":16,"sha256":"f17302e149fed1e38f90b58a032375190a256d10c3b29f06d530401a01210ee2","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ROM/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/cmn_cbs/ROM/16.json","totalNumberOfVerses":431},"chapter":{"number":16,"content":[{"type":"heading","content":["介绍菲比"]},{"type":"verse","number":1,"content":["现在我给你们推荐我们的姊妹菲比，她是坚革哩教会的女执事。"]},{"type":"verse","number":2,"content":["请你们在主里照着做圣徒的本分接待她。无论她有什么需要，请你们帮助她，因为她帮助过许多人，也帮助过我。"]},{"type":"heading","content":["问候圣徒"]},{"type":"verse","number":3,"content":["请代我问候百基拉和亚居拉夫妇，他们是我在基督耶稣里的同工，"]},{"type":"verse","number":4,"content":["为了救我将生死置之度外。不但我感谢他们，就是外族人的教会也感谢他们。"]},{"type":"verse","number":5,"content":["请问候在他们家中聚会的教会。请问候我所爱的以拜尼土，在亚细亚他第一个信从基督。"]},{"type":"verse","number":6,"content":["请问候玛丽亚。她为你们多受劳苦。"]},{"type":"verse","number":7,"content":["请问候安多尼古和犹尼亚，他们是我的亲人，曾与我一同坐牢，在使徒中很有名望，比我先信基督。"]},{"type":"verse","number":8,"content":["请问候我在主里所爱的暗伯利。"]},{"type":"verse","number":9,"content":["请问候在基督里与我同工的耳巴奴和我所爱的士大古。"]},{"type":"verse","number":10,"content":["请问候亚比利，他在基督里曾受过考验。请问候亚利多布家里的人。"]},{"type":"verse","number":11,"content":["请问候我的亲人希罗天。请问候拿其数家中的信徒。"]},{"type":"verse","number":12,"content":["请问候土非娜和土富撒，她们都为主劳苦。请问候我所爱的彼息，她为主多受劳苦。"]},{"type":"verse","number":13,"content":["请问候主所拣选的鲁孚，也问候他的母亲，他的母亲就是我的母亲。"]},{"type":"verse","number":14,"content":["请问候亚逊其土、弗勒干、黑米、八罗巴、黑马和他们当中的其他弟兄姊妹。"]},{"type":"verse","number":15,"content":["请问候非罗罗古、犹利亚、尼利亚和他的妹妹、阿林巴和他们那里的众圣徒。"]},{"type":"verse","number":16,"content":["你们要以圣洁的吻彼此问候。基督的众教会都问候你们。"]},{"type":"heading","content":["提防悖逆者"]},{"type":"verse","number":17,"content":["弟兄姊妹，我劝你们要留意那些制造分裂和障碍、背离你们所学之道的人，你们要避开他们。"]},{"type":"verse","number":18,"content":["他们并不是在事奉我们的主基督，只是为了满足自己的欲望，用花言巧语欺骗单纯幼稚的人。"]},{"type":"verse","number":19,"content":["你们对主的顺服已人人皆知，我为你们高兴，我希望你们在好事上聪明，在坏事上无知。"]},{"type":"verse","number":20,"content":["赐平安的上帝快要把撒旦践踏在你们脚下了。愿我们主耶稣的恩典与你们同在！"]},{"type":"heading","content":["其他人的问候"]},{"type":"verse","number":21,"content":["我的同工提摩太和我的亲人路求、耶孙和所西巴德问候你们。"]},{"type":"verse","number":22,"content":["我这代笔写信的德特在主里问候你们。"]},{"type":"verse","number":23,"content":["接待我也接待全教会的该犹问候你们。主管本城财政的以拉都问候你们，括土弟兄也问候你们。"]},{"type":"verse","number":24,"content":["愿我们的主耶稣基督赐恩典给你们众人！阿们。",{"noteId":68}]},{"type":"verse","number":25,"content":["愿荣耀归于上帝！祂能按照我传讲的耶稣基督的福音，并通过启示万古隐藏的奥秘使你们刚强。"]},{"type":"verse","number":26,"content":["按照永恒上帝的命令，这奥秘如今已经显明出来，并借着先知们所写的经书公诸于世，让万族的人都信从耶稣基督。"]},{"type":"verse","number":27,"content":["愿荣耀借着耶稣基督归于独一全智的上帝，直到永远。阿们！"]}],"footnotes":[{"noteId":68,"caller":"+","text":"有古卷无24节。","reference":{"chapter":16,"verse":24}}]},"thisChapterLink":"/api/cmn_cbs/ROM/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/1CO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ROM/15.json","previousChapterAudioLinks":{},"numberOfVerses":27}