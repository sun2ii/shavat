{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbs","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"a1b9ea3e7c4cdbbe0fb6b63466ad904cef54a76ec119af58d82c1c0ecf301c14","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["这是所罗门的歌，是歌中最美妙的歌。"]},{"type":"verse","number":2,"content":[{"text":"深深地吻我吧！","poem":1},{"lineBreak":true},{"text":"因为你的爱情比美酒更香甜。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的膏油芬芳怡人，","poem":1},{"lineBreak":true},{"text":"你的美名馨香四溢，","poem":1},{"lineBreak":true},{"text":"如同倒出来的香膏，","poem":1},{"lineBreak":true},{"text":"难怪少女们都爱慕你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你带我走，让我们一起奔跑吧！","poem":1},{"lineBreak":true},{"text":"王啊，把我带进你的寝宫吧！","poem":1},"耶路撒冷的少女：",{"text":"我们为你欢喜快乐，","poem":1},{"lineBreak":true},{"text":"我们要颂扬你那胜似美酒的爱情。","poem":1},"女子：",{"text":"难怪少女们都爱慕你！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶路撒冷的少女啊！","poem":1},{"lineBreak":true},{"text":"我虽然黑似基达的帐篷，","poem":1},{"lineBreak":true},{"text":"却美如所罗门的锦帐。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"不要因为我被太阳晒黑就看不起我。","poem":1},{"lineBreak":true},{"text":"这是因为我的兄弟恼恨我，","poem":1},{"lineBreak":true},{"text":"要我在烈日之下看守葡萄园，","poem":1},{"lineBreak":true},{"text":"使我无暇照顾自己","poem":1},{"noteId":0},{"text":"。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我心爱的人啊，告诉我吧，","poem":1},{"lineBreak":true},{"text":"你在哪里牧羊？","poem":1},{"lineBreak":true},{"text":"中午带羊去哪里歇息？","poem":1},{"lineBreak":true},{"text":"我何必在你同伴的羊群旁游荡，","poem":1},{"lineBreak":true},{"text":"像风尘女子一样呢？","poem":1}]},{"type":"verse","number":8,"content":[{"text":"绝色佳人啊！","poem":1},{"lineBreak":true},{"text":"要是你不知道，","poem":1},{"lineBreak":true},{"text":"就跟着羊群的足迹，","poem":1},{"lineBreak":true},{"text":"到牧人的帐篷边喂养你的山羊羔吧。","poem":1}]},{"type":"verse","number":9,"content":[{"text":"我的爱人啊，","poem":1},{"lineBreak":true},{"text":"你好比法老战车上套的牝马。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耳环辉映你妩媚的脸颊，","poem":1},{"lineBreak":true},{"text":"珠链轻衬你美丽的颈项。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我们要为你打造镶有银珠的金饰。","poem":1}]},{"type":"verse","number":12,"content":[{"text":"王坐席的时候，","poem":1},{"lineBreak":true},{"text":"我身上的哪哒香膏芬芳四溢。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我的良人在我眼中，","poem":1},{"lineBreak":true},{"text":"好像我怀中的一袋没药。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我的良人在我眼中，","poem":1},{"lineBreak":true},{"text":"好像隐·基底葡萄园中的凤仙花。","poem":1}]},{"type":"verse","number":15,"content":[{"text":"我的爱人啊！","poem":1},{"lineBreak":true},{"text":"你真是美极了！美极了！","poem":1},{"lineBreak":true},{"text":"你的双眸好像鸽子。","poem":1}]},{"type":"verse","number":16,"content":[{"text":"我的良人啊！","poem":1},{"lineBreak":true},{"text":"你真英俊！真可爱！","poem":1},{"lineBreak":true},{"text":"我们以青草作床榻，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"以香柏树作屋梁，","poem":1},{"lineBreak":true},{"text":"以松树作椽子。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“我无暇照顾自己”希伯来文是“我却无法照料自己的葡萄园。”","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/cmn_cbs/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}