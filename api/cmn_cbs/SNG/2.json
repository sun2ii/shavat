{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbs","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"a1b9ea3e7c4cdbbe0fb6b63466ad904cef54a76ec119af58d82c1c0ecf301c14","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"我是沙仑平原的玫瑰花，","poem":1},{"lineBreak":true},{"text":"是谷中的百合花。","poem":1}]},{"type":"verse","number":2,"content":[{"text":"我的爱人在众少女中，","poem":1},{"lineBreak":true},{"text":"就像荆棘中的一朵百合花。","poem":1}]},{"type":"verse","number":3,"content":[{"text":"我的良人在众男子中，","poem":1},{"lineBreak":true},{"text":"好像林中的一棵苹果树。","poem":1},{"lineBreak":true},{"text":"我欢欢喜喜地坐在他的树荫下，","poem":1},{"lineBreak":true},{"text":"轻尝他香甜可口的果子。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他带我走进宴席大厅，","poem":1},{"lineBreak":true},{"text":"众人都看见他对我充满柔情爱意。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"请用葡萄干来补充我的力气，","poem":1},{"lineBreak":true},{"text":"用苹果来提振我的精神，","poem":1},{"lineBreak":true},{"text":"因为我思爱成病。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他的左手扶着我的头，","poem":1},{"lineBreak":true},{"text":"他的右手紧抱着我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶路撒冷的少女啊！","poem":1},{"lineBreak":true},{"text":"我指着羚羊和田野的母鹿","poem":1},{"noteId":1},{"text":"吩咐你们，","poem":1},{"lineBreak":true},{"text":"不要叫醒或惊动爱情，","poem":1},{"lineBreak":true},{"text":"等它自发吧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"听啊！是我良人的声音，","poem":1},{"lineBreak":true},{"text":"他攀过高岗，跃过山丘，","poem":1},{"lineBreak":true},{"text":"终于来了！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的良人好像羚羊和幼鹿。","poem":1},{"lineBreak":true},{"text":"看啊，他就在墙外，","poem":1},{"lineBreak":true},{"text":"正从窗户往里观看，","poem":1},{"lineBreak":true},{"text":"从窗棂间往里凝视。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他对我说：","poem":1},{"lineBreak":true},{"text":"“我的爱人，起来吧！","poem":1},{"lineBreak":true},{"text":"我的佳偶，跟我来！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你看！冬天过去了，","poem":1},{"lineBreak":true},{"text":"雨水止住了。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"大地百花盛开，","poem":1},{"lineBreak":true},{"text":"百鸟争鸣的季节已经来临，","poem":1},{"lineBreak":true},{"text":"田野也传来斑鸠的叫声。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"无花果快成熟了，","poem":1},{"lineBreak":true},{"text":"葡萄树也开满了花，","poem":1},{"lineBreak":true},{"text":"散发着阵阵芬芳。","poem":1},{"lineBreak":true},{"text":"我的爱人，起来吧；","poem":1},{"lineBreak":true},{"text":"我的佳偶，跟我来。”","poem":1}]},{"type":"verse","number":14,"content":[{"text":"我的鸽子啊，","poem":1},{"lineBreak":true},{"text":"你在岩穴中，","poem":1},{"lineBreak":true},{"text":"在悬崖的隐秘处。","poem":1},{"lineBreak":true},{"text":"让我看看你的脸，","poem":1},{"lineBreak":true},{"text":"听听你的声音吧，","poem":1},{"lineBreak":true},{"text":"因为你的声音温柔，","poem":1},{"lineBreak":true},{"text":"你的脸庞秀丽。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"为我们抓住狐狸，","poem":1},{"lineBreak":true},{"text":"抓住破坏葡萄园的小狐狸，","poem":1},{"lineBreak":true},{"text":"因为我们的葡萄树正在开花。","poem":1}]},{"type":"verse","number":16,"content":[{"text":"我的良人属于我，我也属于他。","poem":1},{"lineBreak":true},{"text":"他在百合花间牧放羊群。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的良人啊，","poem":1},{"lineBreak":true},{"text":"凉风吹起、日影飞逝的时候，","poem":1},{"lineBreak":true},{"text":"但愿你快快回来，","poem":1},{"lineBreak":true},{"text":"就像比特山的羚羊和小鹿一样。","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":1,"caller":"+","text":"“羚羊和田野的母鹿”在希伯来文中与“万军之全能上帝”发音相似。","reference":{"chapter":2,"verse":7}}]},"thisChapterLink":"/api/cmn_cbs/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}