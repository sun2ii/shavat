{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbs","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"a1b9ea3e7c4cdbbe0fb6b63466ad904cef54a76ec119af58d82c1c0ecf301c14","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"我夜晚躺在床上，","poem":1},{"lineBreak":true},{"text":"思念着我心爱的人；","poem":1},{"lineBreak":true},{"text":"我寻找他，却找不到。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要起来寻遍城里的街巷和广场，","poem":1},{"lineBreak":true},{"text":"我要寻找我心爱的人。","poem":1},{"lineBreak":true},{"text":"我寻找他，却寻不到。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我遇上城中巡逻的守卫，","poem":1},{"lineBreak":true},{"text":"就问：“你们看到我心爱的人了吗？”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我刚离开他们，便找到了我心爱的人。","poem":1},{"lineBreak":true},{"text":"我拉着他，不让他走；","poem":1},{"lineBreak":true},{"text":"我把他带回娘家，","poem":1},{"lineBreak":true},{"text":"到怀我者的卧室。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶路撒冷的少女啊！","poem":1},{"lineBreak":true},{"text":"我指着羚羊和田野的母鹿吩咐你们，","poem":1},{"lineBreak":true},{"text":"不要叫醒或惊动爱情，","poem":1},{"lineBreak":true},{"text":"等它自发吧。","poem":1}]},{"type":"verse","number":6,"content":[{"text":"那像烟柱一样从旷野上来，","poem":1},{"lineBreak":true},{"text":"散发着商人贩卖的没药、乳香等各样芬芳之气的是什么呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"看啊，是所罗门的轿子，","poem":1},{"lineBreak":true},{"text":"周围是六十名勇士，","poem":1},{"lineBreak":true},{"text":"都是以色列的精兵。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们个个骁勇善战，手持利剑，","poem":1},{"lineBreak":true},{"text":"腰配战刀，防备夜间的偷袭。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"所罗门王用黎巴嫩木为自己造了一顶轿子。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"银轿柱、金靠背、紫锦坐垫，","poem":1},{"lineBreak":true},{"text":"轿里装饰着耶路撒冷少女的爱情。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"锡安的少女啊，","poem":1},{"lineBreak":true},{"text":"出去看看所罗门王的风采吧！","poem":1},{"lineBreak":true},{"text":"他头上的王冠是他母亲在他成婚那天，","poem":1},{"lineBreak":true},{"text":"在他心中欢乐之日为他戴上的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}