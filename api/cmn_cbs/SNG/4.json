{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbs","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"a1b9ea3e7c4cdbbe0fb6b63466ad904cef54a76ec119af58d82c1c0ecf301c14","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"我的爱人啊，你真美丽！真美丽！","poem":1},{"lineBreak":true},{"text":"面纱下的双眸好像鸽子，","poem":1},{"lineBreak":true},{"text":"你的秀发就好像跃下基列山冈的山羊群。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你的牙齿如同一群新剪了毛、从水里洗净上来的母羊，","poem":1},{"lineBreak":true},{"text":"成双成对，","poem":1},{"lineBreak":true},{"text":"一颗也没有脱落。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的唇好像朱红丝带，","poem":1},{"lineBreak":true},{"text":"你的口娇美，","poem":1},{"lineBreak":true},{"text":"你面纱后面的双颊如两瓣石榴。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的颈项宛若一行行石头建造的大卫楼塔，","poem":1},{"lineBreak":true},{"text":"上面装饰着一千个勇士的盾牌。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的胸好像一对小鹿，","poem":1},{"lineBreak":true},{"text":"一对在百合花间吃草的孪生小鹿。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我要登上没药山和乳香冈，","poem":1},{"lineBreak":true},{"text":"直到晚风吹起、日影消逝。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的爱人啊，","poem":1},{"lineBreak":true},{"text":"你全然美丽，毫无瑕疵。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的新娘啊，","poem":1},{"lineBreak":true},{"text":"跟我一起离开黎巴嫩，","poem":1},{"lineBreak":true},{"text":"跟我一起离开黎巴嫩吧！","poem":1},{"lineBreak":true},{"text":"离开亚玛拿山顶，","poem":1},{"lineBreak":true},{"text":"离开示尼珥山和黑门山巅，","poem":1},{"lineBreak":true},{"text":"离开狮穴和豹山吧。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的妹妹，我的新娘啊，","poem":1},{"lineBreak":true},{"text":"你夺去了我的心。","poem":1},{"lineBreak":true},{"text":"你的秋波一闪，","poem":1},{"lineBreak":true},{"text":"你项链上的明珠，","poem":1},{"lineBreak":true},{"text":"夺去了我的心。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的妹妹，我的新娘啊，","poem":1},{"lineBreak":true},{"text":"你的爱情多么迷人，","poem":1},{"lineBreak":true},{"text":"你的爱情比美酒香甜。","poem":1},{"lineBreak":true},{"text":"你身上膏油的芬芳远胜过一切香料。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的新娘，你的嘴唇滴蜜，","poem":1},{"lineBreak":true},{"text":"你的舌头底下藏着奶与蜜。","poem":1},{"lineBreak":true},{"text":"你衣服散发的香气，","poem":1},{"lineBreak":true},{"text":"就像黎巴嫩山一样芬芳。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我的妹妹，我的新娘，","poem":1},{"lineBreak":true},{"text":"你是紧锁的园子，","poem":1},{"lineBreak":true},{"text":"封闭的井，隐藏的泉源。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你好像一个石榴果园，","poem":1},{"lineBreak":true},{"text":"结满了上好的果子，","poem":1},{"lineBreak":true},{"text":"还有凤仙花和哪哒树、","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"哪哒和番红花、菖蒲和肉桂，","poem":1},{"lineBreak":true},{"text":"以及各样乳香木、没药、沉香和一切上好的香料。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你是园中的甘泉，是活水的井，","poem":1},{"lineBreak":true},{"text":"是从黎巴嫩流下来的溪水。","poem":1}]},{"type":"verse","number":16,"content":[{"text":"北风啊，兴起吧！","poem":1},{"lineBreak":true},{"text":"南风啊，吹来吧！","poem":1},{"lineBreak":true},{"text":"吹向我的园子，","poem":1},{"lineBreak":true},{"text":"使它的清香四溢。","poem":1},{"lineBreak":true},{"text":"愿我的良人走进自己的园中，","poem":1},{"lineBreak":true},{"text":"享受其中的珍果。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}