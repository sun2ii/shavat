{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbs","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"a1b9ea3e7c4cdbbe0fb6b63466ad904cef54a76ec119af58d82c1c0ecf301c14","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"我的妹妹，我的新娘啊，","poem":1},{"lineBreak":true},{"text":"我已经来到自己的园中，","poem":1},{"lineBreak":true},{"text":"采了我的没药和香料，","poem":1},{"lineBreak":true},{"text":"品尝了我的蜂房和蜂蜜，","poem":1},{"lineBreak":true},{"text":"也享用了我的美酒和鲜奶。","poem":1},"耶路撒冷的少女：",{"text":"朋友们，尽情吃喝吧。","poem":1},{"lineBreak":true},{"text":"相爱的人啊，沉醉在爱中吧！","poem":1}]},{"type":"verse","number":2,"content":[{"text":"我虽然躺在床上，心却清醒。","poem":1},{"lineBreak":true},{"text":"我听见我的良人叩门，说：","poem":1},{"lineBreak":true},{"text":"“开门吧！我的妹妹，我的爱人，","poem":1},{"lineBreak":true},{"text":"我完美无瑕的小鸽子啊，","poem":1},{"lineBreak":true},{"text":"我的头上沾满了露水，","poem":1},{"lineBreak":true},{"text":"头发被夜间的露珠弄湿了。”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"可是我已经脱了衣裳，怎能再穿上呢？","poem":1},{"lineBreak":true},{"text":"我已经洗了脚，怎能再沾土呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的良人从门孔伸进手来，","poem":1},{"lineBreak":true},{"text":"我的心神随之荡漾，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"就起来为他开门；","poem":1},{"lineBreak":true},{"text":"我的双手滴下没药，","poem":1},{"lineBreak":true},{"text":"门闩也沾了我指头滴下的没药。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我为良人开了门，","poem":1},{"lineBreak":true},{"text":"他却已经离开了。","poem":1},{"lineBreak":true},{"text":"他的离去使我心中失落。","poem":1},{"noteId":2},{"lineBreak":true},{"text":"我到处找他，却找不着；","poem":1},{"lineBreak":true},{"text":"我呼唤他，却得不到回答。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"城中巡逻的卫兵遇见我，","poem":1},{"lineBreak":true},{"text":"把我打伤了，","poem":1},{"lineBreak":true},{"text":"看守城墙的人还抢走了我的披肩。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶路撒冷的少女啊，","poem":1},{"lineBreak":true},{"text":"我恳求你们，","poem":1},{"lineBreak":true},{"text":"倘若遇见我的良人，","poem":1},{"lineBreak":true},{"text":"请告诉他我思爱成病。","poem":1}]},{"type":"verse","number":9,"content":[{"text":"绝色佳人啊！","poem":1},{"lineBreak":true},{"text":"你的良人与别的男子比较，","poem":1},{"lineBreak":true},{"text":"究竟有什么长处，","poem":1},{"lineBreak":true},{"text":"以致你这样恳求我们呢？","poem":1}]},{"type":"verse","number":10,"content":[{"text":"我的良人红光满面，","poem":1},{"lineBreak":true},{"text":"超越万人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他头如纯金，","poem":1},{"lineBreak":true},{"text":"头发像波浪，","poem":1},{"lineBreak":true},{"text":"黑如乌鸦。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他的眼睛清澈明亮，","poem":1},{"lineBreak":true},{"text":"如同溪旁用奶洗净的白鸽，","poem":1},{"lineBreak":true},{"text":"如同镶嵌合适的宝石。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他的双颊芬芳，","poem":1},{"lineBreak":true},{"text":"犹如种满香草的花圃。","poem":1},{"lineBreak":true},{"text":"他的嘴唇好像滴着没药汁的百合花。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他的双臂如同镶着水苍玉的金杖，","poem":1},{"lineBreak":true},{"text":"身体如同镶嵌蓝宝石的象牙。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他的双腿好像纯金座上的白玉石柱，","poem":1},{"lineBreak":true},{"text":"他的容貌像黎巴嫩，","poem":1},{"lineBreak":true},{"text":"佳美如香柏树。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他的嘴甘甜，","poem":1},{"lineBreak":true},{"text":"整个人都令人爱慕。","poem":1},{"lineBreak":true},{"text":"耶路撒冷的少女啊，","poem":1},{"lineBreak":true},{"text":"这就是我的良人，","poem":1},{"lineBreak":true},{"text":"我的朋友。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"“他的离去使我心中失落”或译“他说话时，我神不守舍”。","reference":{"chapter":5,"verse":6}}]},"thisChapterLink":"/api/cmn_cbs/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}