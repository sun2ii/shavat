{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbs","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"a1b9ea3e7c4cdbbe0fb6b63466ad904cef54a76ec119af58d82c1c0ecf301c14","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"绝色佳人啊，","poem":1},{"lineBreak":true},{"text":"你的良人去了何处？","poem":1},{"lineBreak":true},{"text":"你的良人转往何方？","poem":1},{"lineBreak":true},{"text":"我们好帮你寻找他。","poem":1}]},{"type":"verse","number":2,"content":[{"text":"我的良人下到自己的园中，","poem":1},{"lineBreak":true},{"text":"在香草花圃中牧放他的羊群，","poem":1},{"lineBreak":true},{"text":"采集百合花。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我属于我的良人，","poem":1},{"lineBreak":true},{"text":"我的良人也属于我。","poem":1},{"lineBreak":true},{"text":"他在百合花间牧放羊群。","poem":1}]},{"type":"verse","number":4,"content":[{"text":"我的爱人啊，","poem":1},{"lineBreak":true},{"text":"你像得撒一样秀丽，","poem":1},{"lineBreak":true},{"text":"像耶路撒冷一样佳美，","poem":1},{"lineBreak":true},{"text":"像旌旗飘扬的军队一样威严。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"求你把视线移开吧，","poem":1},{"lineBreak":true},{"text":"因为你的眼波使我迷乱。","poem":1},{"lineBreak":true},{"text":"你的秀发像从基列山坡下来的山羊群。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你的牙齿如同一群从水里洗净上来的母羊，","poem":1},{"lineBreak":true},{"text":"成双成对，","poem":1},{"lineBreak":true},{"text":"一颗也没有脱落。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你面纱后面的双颊如两瓣石榴。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"虽有六十个王后，","poem":1},{"lineBreak":true},{"text":"八十个妃嫔和无数的宫女，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"但我完美无瑕的小鸽子独一无二，","poem":1},{"lineBreak":true},{"text":"她是她母亲的独女和最爱。","poem":1},{"lineBreak":true},{"text":"众女子看见她都夸她有福，","poem":1},{"lineBreak":true},{"text":"王后和妃嫔见了也连连称赞她，说：","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"“这位灿烂似晨光，","poem":1},{"lineBreak":true},{"text":"皎洁如月亮，明媚如太阳，","poem":1},{"lineBreak":true},{"text":"亮丽如布满天际之星辰","poem":1},{"noteId":3},{"text":"的是谁呢？”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我下到核桃园中，","poem":1},{"lineBreak":true},{"text":"要看看谷中嫩绿的花木，","poem":1},{"lineBreak":true},{"text":"看看葡萄树是否已发芽，","poem":1},{"lineBreak":true},{"text":"石榴树是否正在开花。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"不知不觉，","poem":1},{"lineBreak":true},{"text":"我的心把我带到我尊长的车上。","poem":1}]},{"type":"verse","number":13,"content":[{"text":"回来吧，回来吧，","poem":1},{"lineBreak":true},{"text":"书拉密的少女！","poem":1},{"lineBreak":true},{"text":"回来吧，回来吧，","poem":1},{"lineBreak":true},{"text":"好让我们再看看你！","poem":1},"男子：",{"text":"你们为何目不转睛地看着书拉密的少女，","poem":1},{"lineBreak":true},{"text":"好像观看玛哈念的舞蹈呢？","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":3,"caller":"+","text":"“布满天际之星辰”希伯来文是“威严如旌旗飘扬的军队”，希伯来人常把星星比作天上的军队。","reference":{"chapter":6,"verse":10}}]},"thisChapterLink":"/api/cmn_cbs/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}