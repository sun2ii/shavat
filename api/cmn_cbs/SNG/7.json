{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbs","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"a1b9ea3e7c4cdbbe0fb6b63466ad904cef54a76ec119af58d82c1c0ecf301c14","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"我的公主啊，你的脚配上鞋多么美啊！","poem":1},{"lineBreak":true},{"text":"你美玉般圆润的腿是巧匠的杰作。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你的肚脐好像不缺调和酒的圆杯。","poem":1},{"lineBreak":true},{"text":"你的腰好像被百合花环绕的麦堆。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的胸好像一对小鹿，","poem":1},{"lineBreak":true},{"text":"一对孪生小鹿。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的脖子宛如象牙塔，","poem":1},{"lineBreak":true},{"text":"眼睛好像希实本境内巴特·拉并门旁的水池。","poem":1},{"lineBreak":true},{"text":"你的鼻子好像眺望大马士革的黎巴嫩塔。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的头高昂如迦密山，","poem":1},{"lineBreak":true},{"text":"你的秀发好像紫锦，","poem":1},{"lineBreak":true},{"text":"君王的心被你的缕缕青丝系住。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的爱人，你是多么美丽，","poem":1},{"lineBreak":true},{"text":"多么讨人喜爱，令人陶醉啊！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你亭亭玉立如同棕树，","poem":1},{"lineBreak":true},{"text":"你的胸就像树上的果串。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我要攀上这棕树，","poem":1},{"lineBreak":true},{"text":"握住树上的果子。","poem":1},{"lineBreak":true},{"text":"愿你的胸像葡萄串，","poem":1},{"lineBreak":true},{"text":"你的气息如苹果般清香。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你的亲吻像上好的美酒。","poem":1},"女子：",{"text":"愿美酒流入我良人的口中，","poem":1},{"lineBreak":true},{"text":"缓缓注入他陶醉的唇齿间。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我属于我的良人，","poem":1},{"lineBreak":true},{"text":"是他所恋慕的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的良人，来吧！","poem":1},{"lineBreak":true},{"text":"让我们到田间去，","poem":1},{"lineBreak":true},{"text":"在村庄里住宿吧。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我们清晨去葡萄园，","poem":1},{"lineBreak":true},{"text":"看看葡萄树是否已经发芽开花，","poem":1},{"lineBreak":true},{"text":"石榴树是否正在开花。","poem":1},{"lineBreak":true},{"text":"我要在那里把我的爱情献给你。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"那里风茄飘香，","poem":1},{"lineBreak":true},{"text":"门口有各样上好的新陈美果。","poem":1},{"lineBreak":true},{"text":"我的良人，这都是我为你存留的。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}