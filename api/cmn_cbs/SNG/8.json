{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbs","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"a1b9ea3e7c4cdbbe0fb6b63466ad904cef54a76ec119af58d82c1c0ecf301c14","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbs/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"如果你是我的同胞兄弟就好了。","poem":1},{"lineBreak":true},{"text":"这样，在外头遇见你，","poem":1},{"lineBreak":true},{"text":"我也可以亲吻你，","poem":1},{"lineBreak":true},{"text":"没有人会取笑我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我可以把你带进教养我的母亲家。","poem":1},{"lineBreak":true},{"text":"我要给你喝石榴汁酿的醇酒。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他的左手扶着我的头，","poem":1},{"lineBreak":true},{"text":"他的右手紧抱着我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶路撒冷的少女啊，","poem":1},{"lineBreak":true},{"text":"我吩咐你们，","poem":1},{"lineBreak":true},{"text":"不要叫醒或惊动爱情，","poem":1},{"lineBreak":true},{"text":"等它自发吧。","poem":1}]},{"type":"verse","number":5,"content":[{"text":"那从旷野上来、靠在良人身旁的是谁呢？","poem":1},"女子：",{"text":"我在苹果树下唤醒你，","poem":1},{"lineBreak":true},{"text":"你母亲在那里怀你养你，","poem":1},{"lineBreak":true},{"text":"为你受生产之苦。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"请把我印在你的心上，","poem":1},{"lineBreak":true},{"text":"刻在你的手臂上，","poem":1},{"lineBreak":true},{"text":"因为爱情如死亡一般坚固，","poem":1},{"lineBreak":true},{"text":"嫉妒像阴间一样残酷，","poem":1},{"lineBreak":true},{"text":"它燃起的火焰是烧灭一切的烈火。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"爱情，大水不能熄灭，","poem":1},{"lineBreak":true},{"text":"江河不能淹没。","poem":1},{"lineBreak":true},{"text":"若有人想倾其家财买爱情，","poem":1},{"lineBreak":true},{"text":"必遭唾弃。","poem":1}]},{"type":"verse","number":8,"content":[{"text":"我们有一个小妹，","poem":1},{"lineBreak":true},{"text":"她的胸还没有发育。","poem":1},{"lineBreak":true},{"text":"若有人来提亲，","poem":1},{"lineBreak":true},{"text":"我们该怎么办？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"她若是墙，","poem":1},{"lineBreak":true},{"text":"我们要在上面建造银塔；","poem":1},{"lineBreak":true},{"text":"她若是门，","poem":1},{"lineBreak":true},{"text":"我们要用香柏木板围护她。","poem":1}]},{"type":"verse","number":10,"content":[{"text":"我是一面墙，","poem":1},{"lineBreak":true},{"text":"我的双乳像城楼，","poem":1},{"lineBreak":true},{"text":"我在他眼中像找到平安的人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"所罗门在巴力·哈们有一个葡萄园，","poem":1},{"lineBreak":true},{"text":"他把葡萄园租给看守的人，","poem":1},{"lineBreak":true},{"text":"租金是每人一千块银子。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我的葡萄园，我自己作主。","poem":1},{"lineBreak":true},{"text":"所罗门啊，你的一千块银子自己留着，","poem":1},{"lineBreak":true},{"text":"二百块银子给管果园的人。","poem":1}]},{"type":"verse","number":13,"content":[{"text":"你这住在园中的人啊，","poem":1},{"lineBreak":true},{"text":"同伴们都在聆听你的声音，","poem":1},{"lineBreak":true},{"text":"求你让我也听见吧！","poem":1}]},{"type":"verse","number":14,"content":[{"text":"我的良人啊，","poem":1},{"lineBreak":true},{"text":"愿你像香草山上的羚羊和小鹿，","poem":1},{"lineBreak":true},{"text":"快快来到我身边！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}