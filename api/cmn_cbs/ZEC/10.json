{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ZEC","translationId":"cmn_cbs","name":"撒迦利亚书","commonName":"撒迦利亚书","title":"撒迦利亚书","order":38,"numberOfChapters":14,"sha256":"8cf62f43a8ce797cc4cdd63e937097d1b0225901663353bd7ce9b6f60df7db51","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cbs/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["耶和华应许拯救以色列"]},{"type":"verse","number":1,"content":[{"text":"要在春季向耶和华求雨。","poem":1},{"lineBreak":true},{"text":"祂造出雷雨，","poem":1},{"lineBreak":true},{"text":"为世人降下甘霖，","poem":1},{"lineBreak":true},{"text":"赐人田间的菜蔬。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为神像说的是虚言，","poem":1},{"lineBreak":true},{"text":"占卜者讲的是谎话，","poem":1},{"lineBreak":true},{"text":"他们诉说的是假梦，","poem":1},{"lineBreak":true},{"text":"他们的安慰是空话。","poem":1},{"lineBreak":true},{"text":"所以人们如迷失的羊，","poem":1},{"lineBreak":true},{"text":"因无牧人而遭受困苦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“我必向牧人发怒，","poem":1},{"lineBreak":true},{"text":"我必惩罚这些首领","poem":1},{"noteId":10},{"text":"。","poem":1},{"lineBreak":true},{"text":"因为万军之耶和华必眷顾祂的羊群犹大家，","poem":1},{"lineBreak":true},{"text":"使他们像战场上的骏马。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"房角石、橛子、战弓，","poem":1},{"lineBreak":true},{"text":"以及所有掌权者必出自犹大。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们必如战场上的勇士，","poem":1},{"lineBreak":true},{"text":"将仇敌践踏在街上的泥土中。","poem":1},{"lineBreak":true},{"text":"他们必争战，","poem":1},{"lineBreak":true},{"text":"因为耶和华与他们同在。","poem":1},{"lineBreak":true},{"text":"他们必使敌方的骑兵蒙羞。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“我必使犹大家强盛，","poem":1},{"lineBreak":true},{"text":"我必拯救约瑟家。","poem":1},{"lineBreak":true},{"text":"我必带他们回到故土，","poem":1},{"lineBreak":true},{"text":"因为我怜悯他们。","poem":1},{"lineBreak":true},{"text":"他们必好像从未被我抛弃一样，","poem":1},{"lineBreak":true},{"text":"因为我是他们的上帝耶和华，","poem":1},{"lineBreak":true},{"text":"我必应允他们的祷告。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"以法莲人必如勇士，","poem":1},{"lineBreak":true},{"text":"他们必心里畅快，如同喝了酒，","poem":1},{"lineBreak":true},{"text":"他们的儿女见状也必喜乐，","poem":1},{"lineBreak":true},{"text":"他们必因耶和华而欢欣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“我必吹哨聚集他们，","poem":1},{"lineBreak":true},{"text":"因为我救赎了他们，","poem":1},{"lineBreak":true},{"text":"他们必像从前一样人数众多。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"虽然我把他们分散到列国，","poem":1},{"lineBreak":true},{"text":"他们必在远方想起我，","poem":1},{"lineBreak":true},{"text":"他们及其子女必得以幸存，","poem":1},{"lineBreak":true},{"text":"并且回到故土。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我必从埃及领他们归回，","poem":1},{"lineBreak":true},{"text":"从亚述招聚他们，","poem":1},{"lineBreak":true},{"text":"领他们到基列和黎巴嫩，","poem":1},{"lineBreak":true},{"text":"那里将不够他们居住。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂必经过苦海，","poem":1},{"lineBreak":true},{"text":"击打海浪，","poem":1},{"lineBreak":true},{"text":"尼罗河必干涸，","poem":1},{"lineBreak":true},{"text":"亚述的骄傲必扫地，","poem":1},{"lineBreak":true},{"text":"埃及的势力必灭没。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我必让他们靠耶和华而强盛，","poem":1},{"lineBreak":true},{"text":"他们必奉祂的名行事。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。”","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":10,"caller":"+","text":"“首领”希伯来文作“公山羊”。","reference":{"chapter":10,"verse":3}}]},"thisChapterLink":"/api/cmn_cbs/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}