{"translation":{"id":"cmn_cbs","name":"Biblica® 圣经当代译本开放资源","website":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbs","licenseNotes":null,"shortName":"CBS","englishName":"Mandarin Chinese Open Contemporary Bible (Simplified)","language":"cmn","textDirection":"ltr","sha256":"74bf453a33641322ae4ddd23e051ee64d1412722972e541371ef97308285fe7d","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ZEP","translationId":"cmn_cbs","name":"西番雅书","commonName":"西番雅书","title":"西番雅书","order":36,"numberOfChapters":3,"sha256":"fc1196cb65315a28a092f977ca923fa3326df17ab28ce5e53635179f429191aa","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbs/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cbs/ZEP/3.json","totalNumberOfVerses":51},"chapter":{"number":2,"content":[{"type":"heading","content":["呼吁百姓悔改"]},{"type":"verse","number":1,"content":["不知羞耻的国民啊，",{"text":"趁命令尚未发出、","poem":1},{"lineBreak":true},{"text":"日子尚未消逝如风中的糠秕、","poem":1},{"lineBreak":true},{"text":"耶和华的烈怒尚未临到你们、","poem":1},{"lineBreak":true},{"text":"祂向你们发怒的日子尚未来临，","poem":1},{"lineBreak":true},{"text":"要聚集，聚集起来！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"世上所有遵守耶和华典章的谦卑人啊，","poem":1},{"lineBreak":true},{"text":"要寻求耶和华，追求公义，追求谦卑。","poem":1},{"lineBreak":true},{"text":"也许在耶和华发怒的日子，","poem":1},{"lineBreak":true},{"text":"你们可以得到庇护。","poem":1}]},{"type":"heading","content":["审判以色列的邻国"]},{"type":"verse","number":4,"content":[{"text":"迦萨必被抛弃，","poem":1},{"lineBreak":true},{"text":"亚实基伦必沦为废墟，","poem":1},{"lineBreak":true},{"text":"亚实突的居民必在中午被赶走，","poem":1},{"lineBreak":true},{"text":"以革伦必被连根拔除。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"住在海边的基利提人啊，","poem":1},{"lineBreak":true},{"text":"你们有祸了！","poem":1},{"lineBreak":true},{"text":"非利士人的迦南啊，","poem":1},{"lineBreak":true},{"text":"耶和华宣告要毁灭你，","poem":1},{"lineBreak":true},{"text":"使你杳无人烟。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"沿海地区必成为草场，","poem":1},{"lineBreak":true},{"text":"有牧人的居所和羊圈。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"那里必归给犹大家的余民，","poem":1},{"lineBreak":true},{"text":"他们必在那里放牧，","poem":1},{"lineBreak":true},{"text":"晚上睡在亚实基伦的房屋里，","poem":1},{"lineBreak":true},{"text":"因为他们的上帝耶和华必眷顾他们，","poem":1},{"lineBreak":true},{"text":"使他们回归故土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"以色列的上帝——万军之耶和华说：","poem":1},{"lineBreak":true},{"text":"“我听见了摩押人的毁谤和亚扪人的辱骂。","poem":1},{"lineBreak":true},{"text":"他们毁谤我的子民，扬言侵占他们的土地。","poem":1},{"lineBreak":true},{"text":"我凭自己的永恒起誓，","poem":1},{"lineBreak":true},{"text":"摩押和亚扪必刺草丛生、盐坑遍地、永远荒废，","poem":1},{"lineBreak":true},{"text":"如所多玛和蛾摩拉一样。","poem":1},{"lineBreak":true},{"text":"我余下的子民必掳掠他们，","poem":1},{"lineBreak":true},{"text":"我幸存的百姓必承受他们的土地。”","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"这是他们的报应，","poem":1},{"lineBreak":true},{"text":"因为他们狂妄自大，","poem":1},{"lineBreak":true},{"text":"羞辱万军之耶和华的子民。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华必令他们恐惧，","poem":1},{"lineBreak":true},{"text":"因为祂要削弱世上的神明。","poem":1},{"lineBreak":true},{"text":"天下万民必在本地敬拜祂。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"古实人啊，","poem":1},{"lineBreak":true},{"text":"你们也必死在耶和华的刀下。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂必伸手攻击北方，毁灭亚述，","poem":1},{"lineBreak":true},{"text":"使尼尼微一片荒凉，","poem":1},{"lineBreak":true},{"text":"如干旱的旷野。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"牲畜和野兽必躺卧在那里，","poem":1},{"lineBreak":true},{"text":"猫头鹰和刺猬栖身在房柱上，","poem":1},{"lineBreak":true},{"text":"窗口传出鸟鸣，","poem":1},{"lineBreak":true},{"text":"门庭都必破败，","poem":1},{"lineBreak":true},{"text":"露出香柏木梁。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"这就是那欢乐安逸、","poem":1},{"lineBreak":true},{"text":"自以为天下无双的城，","poem":1},{"lineBreak":true},{"text":"现在竟然如此荒凉，","poem":1},{"lineBreak":true},{"text":"成为野兽栖息之地！","poem":1},{"lineBreak":true},{"text":"路过的人都摇手嘲笑它。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbs/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbs/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbs/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}