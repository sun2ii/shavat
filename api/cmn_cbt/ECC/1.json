{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cbt","name":"傳道書","commonName":"傳道書","title":"傳道書","order":21,"numberOfChapters":12,"sha256":"0820c676ad433f3511909fd6951fb4fcc4ff6d4c48e9ee637e3a4d5e7b84f784","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cbt/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":1,"content":[{"type":"heading","content":["萬事虛空"]},{"type":"verse","number":1,"content":["以下是在耶路撒冷做王的大衛之子傳道者的話。"]},{"type":"verse","number":2,"content":[{"text":"傳道者說：虛空的虛空，","poem":1},{"lineBreak":true},{"text":"虛空的虛空，一切都是虛空。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人在日光之下的一切勞碌有什麼益處呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"一代過去，一代又來，","poem":1},{"lineBreak":true},{"text":"大地卻永遠長存。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"太陽升起，太陽落下，","poem":1},{"lineBreak":true},{"text":"匆忙回到升起之地。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"風吹向南，又轉向北，","poem":1},{"lineBreak":true},{"text":"循環不息，周而復始。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"江河湧流入海，海卻不會滿溢；","poem":1},{"lineBreak":true},{"text":"江河從何處流出，又返回何處。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"萬事令人厭煩，人述說不盡。","poem":1},{"lineBreak":true},{"text":"眼看，看不飽；","poem":1},{"lineBreak":true},{"text":"耳聽，聽不夠。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"以往發生的事，將來還會發生；","poem":1},{"lineBreak":true},{"text":"先前做過的事，將來也必再做。","poem":1},{"lineBreak":true},{"text":"日光之下，根本沒有新事。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"人可以指著哪件事說","poem":1},{"lineBreak":true},{"text":"「看啊，這是新事」？","poem":1},{"lineBreak":true},{"text":"所謂的新事在我們以前早就有了。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"過去的事無人記得，","poem":1},{"lineBreak":true},{"text":"將來的事後人也不記得。","poem":1}]},{"type":"heading","content":["智慧之虛空"]},{"type":"verse","number":12,"content":["我傳道者曾在耶路撒冷做以色列的王。"]},{"type":"verse","number":13,"content":["我專心用智慧去研究、探索天下萬事，發現上帝給世人的是極重的苦工。"]},{"type":"verse","number":14,"content":["我觀察一切日光之下所做的事，看啊，都是虛空，好像捕風。"]},{"type":"verse","number":15,"content":["彎曲的不能變直，缺少的無法補足",{"noteId":0},"。"]},{"type":"verse","number":16,"content":["我心裡想：「我獲得極大的智慧，遠超過以前統治耶路撒冷的人。我擁有豐富的智慧和知識。」"]},{"type":"verse","number":17,"content":["我又專心察明智慧和知識、狂妄和愚昧，卻發現這也是捕風。"]},{"type":"verse","number":18,"content":["因為智慧越高，愁煩越多；知識越多，痛苦越深。"]}],"footnotes":[{"noteId":0,"caller":"+","text":"「補足」希伯來文是「數算」。","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/cmn_cbt/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}