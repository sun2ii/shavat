{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cbt","name":"傳道書","commonName":"傳道書","title":"傳道書","order":21,"numberOfChapters":12,"sha256":"0820c676ad433f3511909fd6951fb4fcc4ff6d4c48e9ee637e3a4d5e7b84f784","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cbt/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"死蒼蠅會使芬芳的膏油發臭，","poem":1},{"lineBreak":true},{"text":"同樣，一點點愚昧足以毀掉智慧和尊榮。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"智者的心引導他走正路，","poem":1},{"lineBreak":true},{"text":"愚人的心帶領他入歧途。","poem":1},{"noteId":5}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愚人走路時也無知，","poem":1},{"lineBreak":true},{"text":"向眾人顯出他的愚昧。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"如果當權的人向你大發雷霆，","poem":1},{"lineBreak":true},{"text":"不要因此就離開崗位，","poem":1},{"lineBreak":true},{"text":"因為平心靜氣能避免大錯。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我發現日光之下有一件可悲的事，","poem":1},{"lineBreak":true},{"text":"似乎是掌權者所犯的錯誤：","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愚人身居許多高位，","poem":1},{"lineBreak":true},{"text":"富人卻屈居在下。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我曾看見奴僕騎在馬上，","poem":1},{"lineBreak":true},{"text":"王子卻像奴僕一樣步行。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"挖掘陷阱的，自己必掉在其中；","poem":1},{"lineBreak":true},{"text":"拆圍牆的，必被蛇咬；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"開鑿石頭的，必被石頭砸傷；","poem":1},{"lineBreak":true},{"text":"劈木頭的，必遭木頭的威脅。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"斧頭鈍了若不磨利，","poem":1},{"lineBreak":true},{"text":"用起來必多費力氣，","poem":1},{"lineBreak":true},{"text":"但智慧能助人成功。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"弄蛇人行法術之前，","poem":1},{"lineBreak":true},{"text":"若先被蛇咬，","poem":1},{"lineBreak":true},{"text":"行法術還有什麼用呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"智者口出恩言，","poem":1},{"lineBreak":true},{"text":"愚人的話毀滅自己。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"愚人開口是愚昧，","poem":1},{"lineBreak":true},{"text":"閉口是邪惡狂妄。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"愚人高談闊論，","poem":1},{"lineBreak":true},{"text":"其實無人知道將來的事，","poem":1},{"lineBreak":true},{"text":"人死後，誰能告訴他世間的事呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愚人因勞碌而筋疲力盡，","poem":1},{"lineBreak":true},{"text":"連進城的路也認不出來。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"一國之君若年幼無知，","poem":1},{"lineBreak":true},{"text":"他的臣宰清早便宴樂，","poem":1},{"lineBreak":true},{"text":"那國就有禍了！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"一國之君若英明尊貴，","poem":1},{"lineBreak":true},{"text":"他的臣宰為了強身而飲食有律，","poem":1},{"lineBreak":true},{"text":"不酗酒宴樂，那國就有福了！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"屋頂因人懶惰而坍塌，","poem":1},{"lineBreak":true},{"text":"房間因人遊手好閒而漏雨。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"宴席帶來歡笑，","poem":1},{"lineBreak":true},{"text":"酒使人開懷，","poem":1},{"lineBreak":true},{"text":"錢使人萬事亨通。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"不可咒詛君王，","poem":1},{"lineBreak":true},{"text":"連這樣的意念都不可有，","poem":1},{"lineBreak":true},{"text":"也不可在臥室裡咒詛富豪，","poem":1},{"lineBreak":true},{"text":"因為天空的飛鳥會通風報信，","poem":1},{"lineBreak":true},{"text":"有翅膀的會把事情四處傳開。","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"這一節希伯來文是「智者的心在右，愚人的心在左。」","reference":{"chapter":10,"verse":2}}]},"thisChapterLink":"/api/cmn_cbt/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}