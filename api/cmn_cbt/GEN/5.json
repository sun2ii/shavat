{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"GEN","translationId":"cmn_cbt","name":"創世記","commonName":"創世記","title":"創世記","order":1,"numberOfChapters":50,"sha256":"1404fb057bc5d112b6346816325dee0ee8a74030ba18767f6f29f0e588eca9ab","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cmn_cbt/GEN/50.json","totalNumberOfVerses":1531},"chapter":{"number":5,"content":[{"type":"heading","content":["亞當的後代"]},{"type":"verse","number":1,"content":["以下是關於亞當後代的記載。 上帝造人的時候，是照祂自己的樣式造的。"]},{"type":"verse","number":2,"content":["祂造了男人和女人，又賜福給他們，並在造他們的那日稱他們為「人」。"]},{"type":"verse","number":3,"content":["亞當一百三十歲時生了一子，樣式和形像與自己相似，就給他取名叫塞特。"]},{"type":"verse","number":4,"content":["亞當生了塞特以後，又活了八百年，生兒育女，"]},{"type":"verse","number":5,"content":["共活了九百三十歲才去世。"]},{"type":"verse","number":6,"content":["塞特一百零五歲時生以挪士，"]},{"type":"verse","number":7,"content":["之後又活了八百零七年，生兒育女，"]},{"type":"verse","number":8,"content":["共活了九百一十二歲才去世。"]},{"type":"verse","number":9,"content":["以挪士九十歲時生該南，"]},{"type":"verse","number":10,"content":["之後又活了八百一十五年，生兒育女，"]},{"type":"verse","number":11,"content":["共活了九百零五歲才去世。"]},{"type":"verse","number":12,"content":["該南七十歲時生瑪勒列，"]},{"type":"verse","number":13,"content":["之後又活了八百四十年，生兒育女，"]},{"type":"verse","number":14,"content":["共活了九百一十歲才去世。"]},{"type":"verse","number":15,"content":["瑪勒列六十五歲時生雅列，"]},{"type":"verse","number":16,"content":["之後又活了八百三十年，生兒育女，"]},{"type":"verse","number":17,"content":["共活了八百九十五歲才去世。"]},{"type":"verse","number":18,"content":["雅列一百六十二歲時生以諾，"]},{"type":"verse","number":19,"content":["之後又活了八百年，生兒育女，"]},{"type":"verse","number":20,"content":["共活了九百六十二歲才去世。"]},{"type":"verse","number":21,"content":["以諾六十五歲時生瑪土撒拉，"]},{"type":"verse","number":22,"content":["之後與上帝親密同行三百年，生兒育女，"]},{"type":"verse","number":23,"content":["共活了三百六十五歲。"]},{"type":"verse","number":24,"content":["以諾與上帝親密同行，後來被上帝接去，不在世上了。"]},{"type":"verse","number":25,"content":["瑪土撒拉一百八十七歲時生拉麥，"]},{"type":"verse","number":26,"content":["之後又活了七百八十二年，生兒育女，"]},{"type":"verse","number":27,"content":["共活了九百六十九歲才去世。"]},{"type":"verse","number":28,"content":["拉麥一百八十二歲時生了一個兒子，"]},{"type":"verse","number":29,"content":["取名叫挪亞",{"noteId":4},"，他說：「耶和華咒詛了大地，這孩子必使我們從艱辛勞苦中得安慰。」"]},{"type":"verse","number":30,"content":["拉麥生挪亞之後，又活了五百九十五年，生兒育女，"]},{"type":"verse","number":31,"content":["共活了七百七十七歲才去世。"]},{"type":"verse","number":32,"content":["挪亞五百歲後生閃、含和雅弗。"]}],"footnotes":[{"noteId":4,"caller":"+","text":"希伯來文中「挪亞」與「安慰」諧音。","reference":{"chapter":5,"verse":29}}]},"thisChapterLink":"/api/cmn_cbt/GEN/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/GEN/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/GEN/4.json","previousChapterAudioLinks":{},"numberOfVerses":32}