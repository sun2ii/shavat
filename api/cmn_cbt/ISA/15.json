{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbt","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"37240f583e914ba42181e29fd451e0e08b4e7c4e2af1563522da6f6a9285f631","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":15,"content":[{"type":"heading","content":["關於摩押的預言"]},{"type":"verse","number":1,"content":["以下是關於摩押的預言：",{"text":"摩押的亞珥城必在一夜之間被摧毀，淪為廢墟；","poem":1},{"lineBreak":true},{"text":"摩押的基珥城必在一夜之間被摧毀，淪為廢墟。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"摩押人上到神廟，","poem":1},{"lineBreak":true},{"text":"上到底本的邱壇痛哭。","poem":1},{"lineBreak":true},{"text":"他們都剃光頭髮，刮掉鬍鬚，","poem":1},{"lineBreak":true},{"text":"為尼波和米底巴城哀號。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們身披麻衣走在街上，","poem":1},{"lineBreak":true},{"text":"人們在房頂和廣場上號啕大哭。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"希實本人和以利亞利人都在哭喊，","poem":1},{"lineBreak":true},{"text":"聲音一直傳到雅雜，","poem":1},{"lineBreak":true},{"text":"因此摩押的戰士大聲喊叫，","poem":1},{"lineBreak":true},{"text":"膽戰心驚。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的心為摩押哀號。","poem":1},{"lineBreak":true},{"text":"她的人民逃難到瑣珥和伊基拉·施利施亞。","poem":1},{"lineBreak":true},{"text":"他們上到魯希斜坡，邊走邊哭，","poem":1},{"lineBreak":true},{"text":"在去何羅念的路上因自己的毀滅而哀哭。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"寧林的河道乾涸，","poem":1},{"lineBreak":true},{"text":"青草枯萎，植被消失，毫無綠色。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因此，摩押人把自己積存的財物都運過柳樹河。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"摩押境內哀聲四起，","poem":1},{"lineBreak":true},{"text":"號啕聲傳到以基蓮，","poem":1},{"lineBreak":true},{"text":"傳到比珥·以琳。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"底門的河裡流的都是血，","poem":1},{"lineBreak":true},{"text":"但我還要降更多災難給底門：","poem":1},{"lineBreak":true},{"text":"獅子必吞噬逃出摩押的人和那裡的餘民。","poem":1}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}