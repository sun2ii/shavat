{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbt","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"37240f583e914ba42181e29fd451e0e08b4e7c4e2af1563522da6f6a9285f631","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":2,"content":[{"type":"heading","content":["主必統治萬邦"]},{"type":"verse","number":1,"content":["亞摩斯的兒子以賽亞看到以下有關猶大和耶路撒冷的異象。"]},{"type":"verse","number":2,"content":[{"text":"在末後的日子，","poem":1},{"lineBreak":true},{"text":"耶和華殿所在的山必聳立，","poem":1},{"lineBreak":true},{"text":"高過群山，超過萬嶺，","poem":1},{"lineBreak":true},{"text":"萬國都要湧向它。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"列邦都必來，說：","poem":1},{"lineBreak":true},{"text":"「來吧！讓我們登耶和華的山，","poem":1},{"lineBreak":true},{"text":"去雅各之上帝的殿。","poem":1},{"lineBreak":true},{"text":"祂必教導我們行祂的道，","poem":1},{"lineBreak":true},{"text":"讓我們走祂的路。」","poem":1},{"lineBreak":true},{"text":"因為訓誨必出於錫安，","poem":1},{"lineBreak":true},{"text":"耶和華的話語必來自耶路撒冷。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂必在列國施行審判，","poem":1},{"lineBreak":true},{"text":"為列邦平息紛爭。","poem":1},{"lineBreak":true},{"text":"他們必把刀劍打成犁頭，","poem":1},{"lineBreak":true},{"text":"將矛槍打成鐮刀。","poem":1},{"lineBreak":true},{"text":"國與國不再刀兵相見，","poem":1},{"lineBreak":true},{"text":"人們也不再學習戰事。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"雅各家啊，來吧！","poem":1},{"lineBreak":true},{"text":"讓我們走在耶和華的光中。","poem":1}]},{"type":"heading","content":["耶和華審判的日子"]},{"type":"verse","number":6,"content":[{"text":"耶和華啊，你離棄了你的子民雅各的後代，","poem":1},{"lineBreak":true},{"text":"因為他們當中充滿了東方的惡俗，","poem":1},{"lineBreak":true},{"text":"像非利士人一樣占卜，","poem":1},{"lineBreak":true},{"text":"跟外族人同流合污。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們境內金銀充裕，","poem":1},{"lineBreak":true},{"text":"財寶無窮；","poem":1},{"lineBreak":true},{"text":"他們境內馬匹遍地，","poem":1},{"lineBreak":true},{"text":"戰車無數。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們境內偶像林立，","poem":1},{"lineBreak":true},{"text":"他們跪拜自己的手工作品，","poem":1},{"lineBreak":true},{"text":"跪拜自己用指頭所造之物。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們必受羞辱，遭貶抑。","poem":1},{"lineBreak":true},{"text":"求你不要赦免他們。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"要躲進巖洞，藏入地穴，","poem":1},{"lineBreak":true},{"text":"逃避耶和華的可畏和威榮！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"到那日，狂妄之徒必受羞辱，","poem":1},{"lineBreak":true},{"text":"驕傲的人必遭貶抑；","poem":1},{"lineBreak":true},{"text":"唯獨耶和華將受尊崇。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因為萬軍之耶和華已定了日子，","poem":1},{"lineBreak":true},{"text":"要懲罰一切狂妄自大的人，","poem":1},{"lineBreak":true},{"text":"要懲罰一切高傲的人，","poem":1},{"lineBreak":true},{"text":"他們必受羞辱；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂必毀滅黎巴嫩高大的香柏樹，","poem":1},{"lineBreak":true},{"text":"毀滅巴珊的橡樹，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"毀滅一切崇山峻嶺，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"毀滅所有高聳的城樓，","poem":1},{"lineBreak":true},{"text":"毀滅所有堅固的城牆，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"毀滅他施的一切商船，","poem":1},{"lineBreak":true},{"text":"毀滅一切華美的船隻。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"到那日，狂妄的人必受羞辱，","poem":1},{"lineBreak":true},{"text":"驕傲的人必遭貶抑，","poem":1},{"lineBreak":true},{"text":"唯獨耶和華受尊崇。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"偶像必被徹底剷除。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和華使大地震動的時候，","poem":1},{"lineBreak":true},{"text":"眾人必躲進巖穴，藏入地洞，","poem":1},{"lineBreak":true},{"text":"逃避祂的可畏和威榮。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"到那日，眾人必把造來敬拜的金銀偶像丟給田鼠和蝙蝠。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和華使大地震動的時候，","poem":1},{"lineBreak":true},{"text":"眾人必躲進山洞和巖穴，","poem":1},{"lineBreak":true},{"text":"逃避祂的可畏和威榮。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"不要再倚靠世人，","poem":1},{"lineBreak":true},{"text":"他們的生命不過是一口氣，","poem":1},{"lineBreak":true},{"text":"他們有什麼值得稱道的呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}