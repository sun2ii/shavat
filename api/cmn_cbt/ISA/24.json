{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbt","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"37240f583e914ba42181e29fd451e0e08b4e7c4e2af1563522da6f6a9285f631","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":24,"content":[{"type":"heading","content":["主必審判世界"]},{"type":"verse","number":1,"content":["看啊，耶和華必摧毀大地，",{"text":"使大地荒涼。","poem":1},{"lineBreak":true},{"text":"祂毀壞地面，驅散萬民。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"那時，祭司和百姓，","poem":1},{"lineBreak":true},{"text":"主人和僕人，","poem":1},{"lineBreak":true},{"text":"主母和婢女，","poem":1},{"lineBreak":true},{"text":"買的和賣的，","poem":1},{"lineBreak":true},{"text":"貸的和借的，","poem":1},{"lineBreak":true},{"text":"債主和債戶都必遭難。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"大地必被完全毀壞，洗劫一空。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"大地枯竭凋零，","poem":1},{"lineBreak":true},{"text":"世界衰敗沒落，","poem":1},{"lineBreak":true},{"text":"世上的權貴也敗落。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"大地被世人玷污，","poem":1},{"lineBreak":true},{"text":"他們干犯律法，","poem":1},{"lineBreak":true},{"text":"不守律例，背棄永遠的約。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"所以咒詛必吞噬大地，","poem":1},{"lineBreak":true},{"text":"世人必因罪而受懲罰。","poem":1},{"lineBreak":true},{"text":"他們必被焚燒，","poem":1},{"lineBreak":true},{"text":"所剩無幾。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"葡萄樹枯萎，新酒枯竭，","poem":1},{"lineBreak":true},{"text":"歡樂的人都發出悲歎。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愉快的鼓聲止息，","poem":1},{"lineBreak":true},{"text":"悅耳的琴音消失，","poem":1},{"lineBreak":true},{"text":"宴樂的喧鬧不復聽聞。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"再沒有人對酒高歌，","poem":1},{"lineBreak":true},{"text":"濃酒變得苦澀。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"毀壞的城一片荒涼，","poem":1},{"lineBreak":true},{"text":"家家房門緊閉，無人能進。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"人們因無酒而在街上喊叫；","poem":1},{"lineBreak":true},{"text":"一切歡樂變作哀愁，","poem":1},{"lineBreak":true},{"text":"地上喜樂不復存在。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"城裡一片荒涼，","poem":1},{"lineBreak":true},{"text":"城門被撞成碎片。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"世上萬民必所剩無幾，","poem":1},{"lineBreak":true},{"text":"像打過的橄欖樹，","poem":1},{"lineBreak":true},{"text":"又如摘過的葡萄樹。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"劫後餘生的人必高聲歡呼，","poem":1},{"lineBreak":true},{"text":"在西方讚美耶和華的威嚴。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因此，要在東方尊崇耶和華，","poem":1},{"lineBreak":true},{"text":"要在眾海島讚美以色列的上帝耶和華的名。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我們聽見從地極傳來歌唱聲：","poem":1},{"lineBreak":true},{"text":"「榮耀歸給公義者。」","poem":1},{"lineBreak":true},{"text":"我說：「我完了！","poem":1},{"lineBreak":true},{"text":"我完了！我有禍了！","poem":1},{"lineBreak":true},{"text":"因為詭詐的行事詭詐，","poem":1},{"lineBreak":true},{"text":"詭詐的行事極其詭詐。」","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"世人啊！","poem":1},{"lineBreak":true},{"text":"恐怖、陷阱和網羅要臨到你們。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"逃避恐怖的必掉進陷阱，","poem":1},{"lineBreak":true},{"text":"爬出陷阱的必被網羅纏住。","poem":1},{"lineBreak":true},{"text":"天上的水閘開啟，","poem":1},{"lineBreak":true},{"text":"大地的根基搖動。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"大地崩潰、撕裂，劇烈震動。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"大地像醉漢東搖西晃，","poem":1},{"lineBreak":true},{"text":"又像暴風中的茅屋搖來擺去。","poem":1},{"lineBreak":true},{"text":"它被沉重的罪惡壓垮，","poem":1},{"lineBreak":true},{"text":"再也無法起來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"到那日，耶和華必在天上懲罰天上的眾權能者，","poem":1},{"lineBreak":true},{"text":"在地上懲罰地上的君王。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他們必像囚犯一樣被聚在一起，","poem":1},{"lineBreak":true},{"text":"關在牢裡，囚在獄中，","poem":1},{"lineBreak":true},{"text":"多日之後必受懲罰。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"那時，月亮必大驚失色，","poem":1},{"lineBreak":true},{"text":"太陽必羞愧無光，","poem":1},{"lineBreak":true},{"text":"因為萬軍之耶和華必在錫安山，","poem":1},{"lineBreak":true},{"text":"在耶路撒冷掌權，","poem":1},{"lineBreak":true},{"text":"在祂子民的長老面前彰顯榮耀。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}