{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbt","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"37240f583e914ba42181e29fd451e0e08b4e7c4e2af1563522da6f6a9285f631","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":27,"content":[{"type":"heading","content":["以色列必蒙拯救"]},{"type":"verse","number":1,"content":["到那日，耶和華必用祂無堅不摧的利劍懲罰海怪，那蜿蜒、快速爬行的蛇。祂必殺死那海中的怪物。"]},{"type":"verse","number":2,"content":[{"text":"到那日，你們要歌頌那佳美的葡萄園。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我耶和華是看守它的，","poem":1},{"lineBreak":true},{"text":"我勤加澆灌，","poem":1},{"lineBreak":true},{"text":"晝夜守護，","poem":1},{"lineBreak":true},{"text":"不讓人毀壞。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我不再發怒。","poem":1},{"lineBreak":true},{"text":"若是發現荊棘和蒺藜，","poem":1},{"lineBreak":true},{"text":"我就對付它們，","poem":1},{"lineBreak":true},{"text":"把它們燒光，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"除非它們尋求我的庇護，","poem":1},{"lineBreak":true},{"text":"要與我和好，","poem":1},{"lineBreak":true},{"text":"要與我和好。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"將來，雅各必扎根生長，","poem":1},{"lineBreak":true},{"text":"以色列必發芽開花，","poem":1},{"lineBreak":true},{"text":"果實遍地。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華豈像擊打以色列的敵人那樣擊打以色列人？","poem":1},{"lineBreak":true},{"text":"祂豈像殺戮以色列的敵人那樣殺戮以色列人？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂與以色列人為敵，","poem":1},{"lineBreak":true},{"text":"使他們被擄，","poem":1},{"lineBreak":true},{"text":"祂驅逐他們離開本地，","poem":1},{"lineBreak":true},{"text":"在刮東風的日子，用暴風吹散他們。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"雅各家的罪惡必藉此得到赦免，","poem":1},{"lineBreak":true},{"text":"他們罪惡被除掉後的碩果是：","poem":1},{"lineBreak":true},{"text":"把一切祭壇的石頭打得粉碎，如同石灰粉，","poem":1},{"lineBreak":true},{"text":"推倒亞舍拉神像和香壇。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"堅城荒涼，居所被遺棄，","poem":1},{"lineBreak":true},{"text":"如同曠野一樣杳無人煙。","poem":1},{"lineBreak":true},{"text":"牛犢在那裡吃草、躺臥，","poem":1},{"lineBreak":true},{"text":"吃光樹枝上的葉子。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"樹枝枯乾斷落，","poem":1},{"lineBreak":true},{"text":"婦女拿去作柴燒。","poem":1},{"lineBreak":true},{"text":"因為這是愚昧無知的民族，","poem":1},{"lineBreak":true},{"text":"所以他們的創造主必不憐憫他們，","poem":1},{"lineBreak":true},{"text":"也不向他們施恩。","poem":1}]},{"type":"verse","number":12,"content":["以色列人啊，到那日，耶和華必從幼發拉底河到埃及小河把你們一個個召集起來，像打樹拾果子一樣。"]},{"type":"verse","number":13,"content":["到那日，號角大響後，亞述地將要滅亡的以色列人和流亡到埃及的以色列人，都必來到耶路撒冷的聖山敬拜耶和華。"]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}