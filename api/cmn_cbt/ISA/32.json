{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbt","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"37240f583e914ba42181e29fd451e0e08b4e7c4e2af1563522da6f6a9285f631","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":32,"content":[{"type":"heading","content":["公義的君王"]},{"type":"verse","number":1,"content":["看啊，必有一位君王以公義治國，",{"text":"官長必秉公施政。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"每人都像避風處和躲避暴風雨的庇護所，","poem":1},{"lineBreak":true},{"text":"如荒漠中的溪流，","poem":1},{"lineBreak":true},{"text":"又似乾旱之地遮蔭的巨石。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人們的眼睛必不再迷濛，","poem":1},{"lineBreak":true},{"text":"耳朵必留心聽。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"急躁的人必慎思明辨，","poem":1},{"lineBreak":true},{"text":"口吃的人必口齒伶俐。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愚人不再被稱為君子，","poem":1},{"lineBreak":true},{"text":"惡徒不再受到尊重。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因為愚昧人說愚昧話，","poem":1},{"lineBreak":true},{"text":"心裡邪惡，行事不義，","poem":1},{"lineBreak":true},{"text":"褻瀆耶和華，","poem":1},{"lineBreak":true},{"text":"使饑餓的人沒飯吃，","poem":1},{"lineBreak":true},{"text":"使口渴的人沒水喝。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"惡棍們手段邪惡，","poem":1},{"lineBreak":true},{"text":"用奸計和謊言毀滅困苦的人，","poem":1},{"lineBreak":true},{"text":"罔顧窮人的正當訴求。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"高尚的人計劃高尚的事，","poem":1},{"lineBreak":true},{"text":"在高尚的事上持之以恆。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"生活安逸的婦女啊，","poem":1},{"lineBreak":true},{"text":"來聽我的聲音！","poem":1},{"lineBreak":true},{"text":"無憂無慮的女子啊，","poem":1},{"lineBreak":true},{"text":"要側耳聽我的言語！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"無憂無慮的女子啊，","poem":1},{"lineBreak":true},{"text":"再過一年多，","poem":1},{"lineBreak":true},{"text":"你們必因恐懼而顫抖。","poem":1},{"lineBreak":true},{"text":"那時，必沒有葡萄可摘，","poem":1},{"lineBreak":true},{"text":"沒有果子可收。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"生活安逸的婦女啊，顫抖吧！","poem":1},{"lineBreak":true},{"text":"無憂無慮的女子啊，戰慄吧！","poem":1},{"lineBreak":true},{"text":"你們要脫下衣服，","poem":1},{"lineBreak":true},{"text":"腰束麻布，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"為美好的田地和碩果纍纍的葡萄樹捶胸痛哭吧！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"為我百姓那長滿荊棘和蒺藜的土地，","poem":1},{"lineBreak":true},{"text":"為那曾經充滿歡樂的城邑和所有家庭哀哭吧！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"王宮必被遺棄，","poem":1},{"lineBreak":true},{"text":"繁榮的城邑必荒蕪，","poem":1},{"lineBreak":true},{"text":"山岡和瞭望塔必永遠荒廢，","poem":1},{"lineBreak":true},{"text":"成為野驢的樂園、羊群的草場。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"等到聖靈從上面澆灌我們的時候，","poem":1},{"lineBreak":true},{"text":"曠野要變為沃野，","poem":1},{"lineBreak":true},{"text":"沃野上莊稼茂密如林。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"那時，公平必住在曠野，","poem":1},{"lineBreak":true},{"text":"公義必居於沃野。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"公義必帶來平安，","poem":1},{"lineBreak":true},{"text":"公義結的果子是永遠的和平與安寧。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我的子民必住在平安之地、","poem":1},{"lineBreak":true},{"text":"安穩之處、寧靜之所。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"但冰雹必掃平森林，","poem":1},{"lineBreak":true},{"text":"城邑也被夷為平地。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你們這些在河邊撒種、自由地牧放牛驢的人有福了！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}