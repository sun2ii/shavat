{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cbt","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"37240f583e914ba42181e29fd451e0e08b4e7c4e2af1563522da6f6a9285f631","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cbt/ISA/66.json","totalNumberOfVerses":1289},"chapter":{"number":34,"content":[{"type":"heading","content":["審判列國"]},{"type":"verse","number":1,"content":["列國啊，近前來聽吧！",{"text":"列邦啊，留心聽吧！","poem":1},{"lineBreak":true},{"text":"大地和地上的萬物、世界和世上的一切都要聽。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為耶和華向列國發怒，","poem":1},{"lineBreak":true},{"text":"向他們的軍隊發烈怒。","poem":1},{"lineBreak":true},{"text":"祂要毀滅他們，殺盡他們。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們必曝屍在外，","poem":1},{"lineBreak":true},{"text":"臭氣燻天，","poem":1},{"lineBreak":true},{"text":"血浸山嶺。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"天上的萬象必融化，","poem":1},{"lineBreak":true},{"text":"穹蒼像書卷捲起；","poem":1},{"lineBreak":true},{"text":"星辰隕落，","poem":1},{"lineBreak":true},{"text":"像凋零的葡萄葉，","poem":1},{"lineBreak":true},{"text":"又像枯落的無花果。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華的刀劍在天上飽飲了血後，","poem":1},{"lineBreak":true},{"text":"必降下來懲罰祂決意要毀滅的以東人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂的刀沾滿了血和脂肪，","poem":1},{"lineBreak":true},{"text":"是羊羔、公山羊的血和公綿羊腎臟上的脂肪。","poem":1},{"lineBreak":true},{"text":"因為耶和華在波斯拉有祭物，","poem":1},{"lineBreak":true},{"text":"在以東有大殺戮。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"野牛和他們一同倒下，","poem":1},{"lineBreak":true},{"text":"牛犢與公牛一同被殺。","poem":1},{"lineBreak":true},{"text":"他們的土地被血浸透，","poem":1},{"lineBreak":true},{"text":"土壤被脂肪覆蓋。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因為這是耶和華報應的日子，","poem":1},{"lineBreak":true},{"text":"是祂為錫安報仇之年。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"以東的河流要變為瀝青，","poem":1},{"lineBreak":true},{"text":"土壤要變成硫磺，","poem":1},{"lineBreak":true},{"text":"土地要成為燃燒的瀝青，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"晝夜燃燒，濃煙滾滾，","poem":1},{"lineBreak":true},{"text":"永不止息。","poem":1},{"lineBreak":true},{"text":"以東必世世代代荒廢，","poem":1},{"lineBreak":true},{"text":"永遠人蹤絕跡。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"老鷹和刺蝟必佔據那裡，","poem":1},{"lineBreak":true},{"text":"貓頭鷹和烏鴉必在那裡做窩。","poem":1},{"lineBreak":true},{"text":"耶和華要用空虛的準繩丈量以東，","poem":1},{"lineBreak":true},{"text":"用混沌的線錘丈量它。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"以東沒有一個顯貴可以稱王，","poem":1},{"lineBreak":true},{"text":"那裡所有的首領全都消失。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"那裡的宮殿荊棘叢生，","poem":1},{"lineBreak":true},{"text":"蒺藜、刺草遍佈堅城，","poem":1},{"lineBreak":true},{"text":"成了野狗的巢穴和鴕鳥的住處。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"在那裡，豺狼和曠野的其他走獸出沒，","poem":1},{"lineBreak":true},{"text":"野山羊對叫，","poem":1},{"lineBreak":true},{"text":"夜間的怪物在那裡棲息，","poem":1},{"lineBreak":true},{"text":"找到安歇之處。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"貓頭鷹在那裡做窩，","poem":1},{"lineBreak":true},{"text":"下蛋，孵化，","poem":1},{"lineBreak":true},{"text":"把幼鳥保護在翅膀底下，","poem":1},{"lineBreak":true},{"text":"鷙鳥也成雙成對地聚集在那裡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"你們要去查考並閱讀耶和華的書卷：","poem":1},{"lineBreak":true},{"text":"以上的動物必一個不少，","poem":1},{"lineBreak":true},{"text":"無一缺少配偶。","poem":1},{"lineBreak":true},{"text":"因為這是耶和華親口說的，","poem":1},{"lineBreak":true},{"text":"祂的靈必把牠們聚在一起。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂親手為牠們抽籤，","poem":1},{"lineBreak":true},{"text":"用準繩為牠們分地。","poem":1},{"lineBreak":true},{"text":"牠們必永遠佔據那裡，","poem":1},{"lineBreak":true},{"text":"世世代代住在那裡。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}