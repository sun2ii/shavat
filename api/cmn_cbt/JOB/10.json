{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"「我厭惡自己的生命，","poem":1},{"lineBreak":true},{"text":"我要傾訴我的哀怨，","poem":1},{"lineBreak":true},{"text":"吐露心中的苦水。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我對上帝說，『不要定我的罪。","poem":1},{"lineBreak":true},{"text":"請告訴我，你為何指控我？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"難道你喜悅壓迫、鄙視你造的人，","poem":1},{"lineBreak":true},{"text":"卻青睞惡人的計謀？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"難道你的眼是肉眼，","poem":1},{"lineBreak":true},{"text":"目光如凡人一般？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"難道你的年日像人一樣有限，","poem":1},{"lineBreak":true},{"text":"歲月如世人般短暫？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"以致你探查我的過犯，","poem":1},{"lineBreak":true},{"text":"追究我的罪愆？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"其實你知道我沒有犯罪，","poem":1},{"lineBreak":true},{"text":"無人能從你手中解救我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"「『你親手造我塑我，","poem":1},{"lineBreak":true},{"text":"現在卻要毀滅我。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"別忘了你用泥土造我","poem":1},{"noteId":6},{"text":"，","poem":1},{"lineBreak":true},{"text":"難道要使我復歸塵土？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你不是將我像奶一樣倒出，","poem":1},{"lineBreak":true},{"text":"使我像乳酪一樣凝固嗎？","poem":1},{"noteId":7}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你給我穿上皮肉，","poem":1},{"lineBreak":true},{"text":"用筋骨把我編織。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你賜我生命給我慈愛，","poem":1},{"lineBreak":true},{"text":"你的眷顧使我保全性命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"「『但你心中藏著計劃，","poem":1},{"lineBreak":true},{"text":"我知道你早有此意，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我若犯罪，你就鑒察，","poem":1},{"lineBreak":true},{"text":"不肯赦免我的罪。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我若有罪，便遭禍患；","poem":1},{"lineBreak":true},{"text":"即使清白，也不敢抬頭，","poem":1},{"lineBreak":true},{"text":"因為我飽嘗羞辱，吃盡苦頭。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我若昂首挺立，","poem":1},{"lineBreak":true},{"text":"你會像獅子般追捕我，","poem":1},{"lineBreak":true},{"text":"再次施展大能攻擊我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你重新派證人指控我，","poem":1},{"lineBreak":true},{"text":"你對我越來越憤怒，","poem":1},{"lineBreak":true},{"text":"使軍隊輪流攻擊我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你為何讓我出母腹？","poem":1},{"lineBreak":true},{"text":"我不如當時就死去，","poem":1},{"lineBreak":true},{"text":"不被世人看見，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"好像我從未出生，","poem":1},{"lineBreak":true},{"text":"一出母腹就被送進墳墓。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的年日不是所剩無幾嗎？","poem":1},{"lineBreak":true},{"text":"求你放過我，","poem":1},{"lineBreak":true},{"text":"讓我歡樂片刻。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我很快就一去不返，","poem":1},{"lineBreak":true},{"text":"進入幽冥黑暗之地。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"那裡一片漆黑，幽暗混亂；","poem":1},{"lineBreak":true},{"text":"那裡的光猶如黑暗。』」","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"「用泥土造我」或譯「把我造的像泥土」。","reference":{"chapter":10,"verse":9}},{"noteId":7,"caller":"+","text":"此句描述胚胎在母腹中如何成形。","reference":{"chapter":10,"verse":10}}]},"thisChapterLink":"/api/cmn_cbt/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}