{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":11,"content":[{"type":"heading","content":["瑣法的回答"]},{"type":"verse","number":1,"content":[{"text":"拿瑪人瑣法回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"「難道滔滔不絕就無人反駁？","poem":1},{"lineBreak":true},{"text":"難道嘮嘮叨叨就證明有理？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你喋喋不休，豈能使人緘默不言？","poem":1},{"lineBreak":true},{"text":"你嘲笑譏諷，豈不該有人使你羞愧？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你自以為信仰純全，","poem":1},{"lineBreak":true},{"text":"在上帝眼中清白。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"唯願上帝發言，","poem":1},{"lineBreak":true},{"text":"開口駁斥你，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"告訴你智慧的奧秘，","poem":1},{"lineBreak":true},{"text":"因為真智慧深奧難懂。","poem":1},{"lineBreak":true},{"text":"要知道，上帝沒有追究你全部的罪愆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"「你能測度上帝的深奧，","poem":1},{"lineBreak":true},{"text":"查明全能者的極限嗎？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"那可比諸天還高，你能做什麼？","poem":1},{"lineBreak":true},{"text":"那可比陰間還深，你能知道什麼？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"那可比大地還寬廣，","poem":1},{"lineBreak":true},{"text":"比海洋還遼闊。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂若來囚禁你，","poem":1},{"lineBreak":true},{"text":"開庭審判，","poem":1},{"lineBreak":true},{"text":"誰能阻攔？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂洞悉詭詐之人，","poem":1},{"lineBreak":true},{"text":"看見罪惡，","poem":1},{"lineBreak":true},{"text":"豈會不理？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"愚蠢人若能變得聰明，","poem":1},{"lineBreak":true},{"text":"野驢駒也可生成人樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"「你若把心安正，","poem":1},{"lineBreak":true},{"text":"向祂伸出雙手；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你若除去手中的罪惡，","poem":1},{"lineBreak":true},{"text":"不容帳篷裡有任何不義，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"就必能無愧地仰起臉，","poem":1},{"lineBreak":true},{"text":"站立得穩，無所畏懼。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你必忘記自己的苦楚，","poem":1},{"lineBreak":true},{"text":"它從你記憶中如流水逝去。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你的人生將比正午還光明，","poem":1},{"lineBreak":true},{"text":"生命中的黑暗也必像黎明。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你必安穩，因有盼望，","poem":1},{"lineBreak":true},{"text":"你必得到保護，安然歇息。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你睡覺時必無人驚擾，","poem":1},{"lineBreak":true},{"text":"許多人必求你施恩。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"但惡人必眼目失明，無路可逃，","poem":1},{"lineBreak":true},{"text":"他們的指望只有死亡。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}