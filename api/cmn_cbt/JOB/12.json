{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":12,"content":[{"type":"heading","content":["約伯的回答"]},{"type":"verse","number":1,"content":["約伯回答說："]},{"type":"verse","number":2,"content":[{"text":"「你們真是重要人物，","poem":1},{"lineBreak":true},{"text":"你們死了，智慧也會消逝！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"但我也有心智，不比你們遜色。","poem":1},{"lineBreak":true},{"text":"你們說的，誰不知道？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我這求告上帝並蒙祂應允的人竟成了朋友的笑柄，","poem":1},{"lineBreak":true},{"text":"我這公義純全的人竟成了笑柄。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"安逸的人心中藐視災禍，","poem":1},{"lineBreak":true},{"text":"災禍隨時臨到滑倒的人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"強盜的帳篷太平，","poem":1},{"lineBreak":true},{"text":"冒犯上帝、手捧神像的人安穩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"「你去問走獸，牠們會指教你；","poem":1},{"lineBreak":true},{"text":"問天上的飛禽，牠們會告訴你；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"向大地討教，大地會指教你，","poem":1},{"lineBreak":true},{"text":"或讓海中的魚為你闡明。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"牠們當中哪個不知這是耶和華親手所為？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"所有生命都在祂手中，","poem":1},{"lineBreak":true},{"text":"世人的氣息也不例外。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耳朵豈不辨別話語，","poem":1},{"lineBreak":true},{"text":"舌頭豈不品嘗食物？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"智慧與老人相伴，","poem":1},{"lineBreak":true},{"text":"知識與長者為伍。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"「上帝有智慧和權能，","poem":1},{"lineBreak":true},{"text":"謀略和知識屬於祂。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂拆毀的，無法重建；","poem":1},{"lineBreak":true},{"text":"祂囚禁的，無法獲釋。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂攔住水源，便有乾旱；","poem":1},{"lineBreak":true},{"text":"祂放開水源，大地被淹沒。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"祂充滿力量和智慧。","poem":1},{"lineBreak":true},{"text":"騙子和受騙者都在祂權下。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂使謀士赤身被擄，","poem":1},{"lineBreak":true},{"text":"使審判官愚拙不堪。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂除去君王的腰帶，","poem":1},{"lineBreak":true},{"text":"在他們腰間綁上囚索。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂使祭司赤身被擄，","poem":1},{"lineBreak":true},{"text":"祂推翻久握大權者。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"祂奪去謀士的口才，","poem":1},{"lineBreak":true},{"text":"祂拿走長者的洞見。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"祂使權貴倍受羞辱，","poem":1},{"lineBreak":true},{"text":"祂除掉強者的權勢。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"祂揭露黑暗中的奧秘，","poem":1},{"lineBreak":true},{"text":"祂把幽暗帶入光明中。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"祂使列國興起又滅亡，","poem":1},{"lineBreak":true},{"text":"祂使列國擴張又崩潰。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"祂奪去世人首領的心智，","poem":1},{"lineBreak":true},{"text":"使他們在無路的荒野流浪。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他們在無光的黑暗中摸索，","poem":1},{"lineBreak":true},{"text":"像醉漢般踉踉蹌蹌。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}