{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"「這一切，我親眼見過，","poem":1},{"lineBreak":true},{"text":"親耳聽過，且已明白。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們知道的我也知道，","poem":1},{"lineBreak":true},{"text":"我不比你們遜色。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"但我想和全能者對話，","poem":1},{"lineBreak":true},{"text":"我渴望跟上帝理論。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你們卻編造謊言，","poem":1},{"lineBreak":true},{"text":"都是無用的醫生。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但願你們閉口不言，","poem":1},{"lineBreak":true},{"text":"那樣還算你們明智。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"請聽我的申辯，","poem":1},{"lineBreak":true},{"text":"留心聽我口中的爭訟。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你們要為上帝說謊，","poem":1},{"lineBreak":true},{"text":"為祂說詭詐的話嗎？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你們要偏袒上帝嗎？","poem":1},{"lineBreak":true},{"text":"你們要替祂辯護嗎？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂查問你們時豈會有好結果？","poem":1},{"lineBreak":true},{"text":"你們豈能像欺騙人一樣欺騙祂？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你們若暗中偏袒，","poem":1},{"lineBreak":true},{"text":"祂必責備你們。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"難道祂的威嚴不令你們恐懼嗎？","poem":1},{"lineBreak":true},{"text":"難道你們不對祂充滿敬畏嗎？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你們的名言是無用的灰燼，","poem":1},{"lineBreak":true},{"text":"你們的雄辯是土築的營壘。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"「你們住口，讓我發言；","poem":1},{"lineBreak":true},{"text":"我願承擔一切後果。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我已經豁出性命，","poem":1},{"lineBreak":true},{"text":"不惜冒生命危險。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂必殺我，我毫無指望，","poem":1},{"noteId":8},{"lineBreak":true},{"text":"但我仍要在祂面前為自己申辯。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"這樣我才能得救，","poem":1},{"lineBreak":true},{"text":"因為不信上帝的人不可到祂面前。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"請留心聽我說話，","poem":1},{"lineBreak":true},{"text":"側耳聽我發言。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"看啊，我已準備好辯詞，","poem":1},{"lineBreak":true},{"text":"我知道自己有理。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"若有人能指控我，","poem":1},{"lineBreak":true},{"text":"我就緘默，情願死去。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"上帝啊，只求你應允我兩件事，","poem":1},{"lineBreak":true},{"text":"我就不躲避你的面，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"求你把手從我身上挪開，","poem":1},{"lineBreak":true},{"text":"不要用你的威嚴驚嚇我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"這樣，你傳喚我，我必回應；","poem":1},{"lineBreak":true},{"text":"或者讓我陳述，你來回答。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我究竟有什麼過錯和罪惡？","poem":1},{"lineBreak":true},{"text":"求你指出我的過犯和罪愆。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你為何掩面不看我？","poem":1},{"lineBreak":true},{"text":"為何把我當作仇敵？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你要恐嚇一片風中的落葉嗎？","poem":1},{"lineBreak":true},{"text":"你要追趕枯乾的草芥嗎？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你記下指控我的罪狀，","poem":1},{"lineBreak":true},{"text":"讓我承擔幼年的罪惡。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你給我上了腳鐐，","poem":1},{"lineBreak":true},{"text":"監視我的一舉一動，","poem":1},{"lineBreak":true},{"text":"為我的腳掌設界限。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我消逝如朽爛之物，","poem":1},{"lineBreak":true},{"text":"又如蟲蛀的衣服。","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":8,"caller":"+","text":"「祂必殺我，我毫無指望」或譯「即使祂殺我，我也信靠祂」。","reference":{"chapter":13,"verse":15}}]},"thisChapterLink":"/api/cmn_cbt/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}