{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"「人為婦人所生，","poem":1},{"lineBreak":true},{"text":"一生短暫，充滿患難。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他如花盛開，轉眼凋謝；","poem":1},{"lineBreak":true},{"text":"如影消逝，無法久留。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你還察看這樣的世人嗎？","poem":1},{"lineBreak":true},{"text":"還要把我帶來受審嗎？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"誰能使污穢產生潔淨呢？","poem":1},{"lineBreak":true},{"text":"沒有人能。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"人的年日已被限定，","poem":1},{"lineBreak":true},{"text":"你掌管他的歲月，","poem":1},{"lineBreak":true},{"text":"設定他無法逾越的界限。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你轉身，別去管他，","poem":1},{"lineBreak":true},{"text":"好讓他如雇工度完他的日子。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"樹木若被砍下，還有希望，","poem":1},{"lineBreak":true},{"text":"它仍可重新萌芽，","poem":1},{"lineBreak":true},{"text":"嫩枝生長不息。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"雖然樹根在土裡衰老，","poem":1},{"lineBreak":true},{"text":"樹樁在地裡死去，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"但一有水氣，","poem":1},{"lineBreak":true},{"text":"它就會像新栽的樹一樣發芽長枝。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"但人一死，就失去力量；","poem":1},{"lineBreak":true},{"text":"人一嚥氣，就不知去向。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"湖水會枯竭，","poem":1},{"lineBreak":true},{"text":"江河會乾涸，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"人躺下便不再起來，","poem":1},{"lineBreak":true},{"text":"到諸天不復存在，","poem":1},{"lineBreak":true},{"text":"他仍不會醒來，","poem":1},{"lineBreak":true},{"text":"不會從長眠中被喚醒。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"但願你把我藏在陰間，","poem":1},{"lineBreak":true},{"text":"把我藏起來直到你息怒，","poem":1},{"lineBreak":true},{"text":"定下眷顧我的日期。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人若死了，還能復生嗎？","poem":1},{"lineBreak":true},{"text":"我要在勞苦的歲月中等待，","poem":1},{"lineBreak":true},{"text":"直到我得釋放的日子來臨。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"那時你呼喚，我便回應，","poem":1},{"lineBreak":true},{"text":"你必惦念你親手所造之物。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"那時你必數算我的腳步，","poem":1},{"lineBreak":true},{"text":"但不會追究我的罪惡。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的過犯會被封在袋中，","poem":1},{"lineBreak":true},{"text":"你會遮蓋我的罪愆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"「高山崩塌，","poem":1},{"lineBreak":true},{"text":"磐石挪移；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"流水磨損石頭，","poem":1},{"lineBreak":true},{"text":"急流沖走泥土；","poem":1},{"lineBreak":true},{"text":"你也這樣粉碎人的希望。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你永遠擊敗他，使他消逝；","poem":1},{"lineBreak":true},{"text":"你改變他的容顏，讓他離世。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他的後人得尊榮，他無從知曉；","poem":1},{"lineBreak":true},{"text":"他們遭貶抑，他也無法察覺。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他只感受到自身的痛苦，","poem":1},{"lineBreak":true},{"text":"只為自己哀哭。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}