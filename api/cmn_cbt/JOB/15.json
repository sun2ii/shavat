{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":15,"content":[{"type":"heading","content":["以利法再次發言"]},{"type":"verse","number":1,"content":["提幔人以利法回答說："]},{"type":"verse","number":2,"content":[{"text":"「智者豈會用空談作答，","poem":1},{"lineBreak":true},{"text":"滿腹東風？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"申辯時豈會講無用的話，","poem":1},{"lineBreak":true},{"text":"說無益之言？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你摒棄對上帝的敬畏，","poem":1},{"lineBreak":true},{"text":"拒絕向祂默禱。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的罪指示你開口，","poem":1},{"lineBreak":true},{"text":"使你說出詭詐之言。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"並非我定你的罪，","poem":1},{"lineBreak":true},{"text":"定你罪的是你的口，","poem":1},{"lineBreak":true},{"text":"指控你的是你的嘴唇。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你豈是第一個出生的人？","poem":1},{"lineBreak":true},{"text":"你豈在群山之前被造？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你豈聽過上帝的密旨？","poem":1},{"lineBreak":true},{"text":"你豈獨攬智慧？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"有何事你知而我們不知，","poem":1},{"lineBreak":true},{"text":"你懂而我們不懂？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我們這裡有白髮老人，","poem":1},{"lineBreak":true},{"text":"比你父親還年長。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝用溫柔的話安慰你，","poem":1},{"lineBreak":true},{"text":"難道你還嫌不夠嗎？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你為何失去理智，","poem":1},{"lineBreak":true},{"text":"為何雙眼冒火，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"以致你向上帝發怒，","poem":1},{"lineBreak":true},{"text":"口出惡言？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人算什麼，怎能純潔？","poem":1},{"lineBreak":true},{"text":"婦人所生的算什麼，怎能公義？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"連上帝的聖者都無法令祂信任，","poem":1},{"lineBreak":true},{"text":"連諸天在祂的眼中都不潔淨，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"更何況可憎敗壞、","poem":1},{"lineBreak":true},{"text":"嗜惡如喝水的世人？","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"「讓我告訴你，你好好聽著。","poem":1},{"lineBreak":true},{"text":"我要把所見的陳明，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"那是智者的教導，","poem":1},{"lineBreak":true},{"text":"是他們未曾隱瞞的祖訓。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"這片土地只賜給了他們，","poem":1},{"lineBreak":true},{"text":"沒有外人在他們中間出入。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"惡人一生受折磨，","poem":1},{"lineBreak":true},{"text":"殘暴之徒終身受苦。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他耳邊響著恐怖的聲音，","poem":1},{"lineBreak":true},{"text":"他安逸時遭強盜襲擊。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他不指望能逃脫黑暗，","poem":1},{"lineBreak":true},{"text":"他註定要喪身刀下。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他到處流浪，尋找食物，","poem":1},{"lineBreak":true},{"text":"他知道黑暗之日快要來臨。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"患難和痛苦使他害怕，","poem":1},{"lineBreak":true},{"text":"像預備上陣的君王一樣壓制他。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"因為他揮拳對抗上帝，","poem":1},{"lineBreak":true},{"text":"藐視全能者，","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"手拿堅盾狂妄地衝撞祂。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他滿臉肥肉，","poem":1},{"lineBreak":true},{"text":"腰間堆滿脂肪。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他活在毀滅的城邑，","poem":1},{"lineBreak":true},{"text":"住在被人廢棄、","poem":1},{"lineBreak":true},{"text":"行將坍塌的房屋。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他不再富足，","poem":1},{"lineBreak":true},{"text":"家財不能久留，","poem":1},{"lineBreak":true},{"text":"地產無法加增。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他無法逃脫黑暗，","poem":1},{"lineBreak":true},{"text":"火焰要燒焦他的嫩枝，","poem":1},{"lineBreak":true},{"text":"上帝口中的氣要毀滅他。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他不可自欺，信靠虛空，","poem":1},{"lineBreak":true},{"text":"因為虛空必成為他的回報。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"在他離世以前，虛空必臨到他，","poem":1},{"lineBreak":true},{"text":"他的枝子再不會青綠。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他必像一棵葡萄樹，","poem":1},{"lineBreak":true},{"text":"葡萄未熟已掉落；","poem":1},{"lineBreak":true},{"text":"又像一棵橄欖樹，","poem":1},{"lineBreak":true},{"text":"花剛開便凋零。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"不信上帝之輩必不生育，","poem":1},{"lineBreak":true},{"text":"受賄者的帳篷必被火燒。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"他們心懷不軌，生出罪惡，","poem":1},{"lineBreak":true},{"text":"他們滿腹詭詐。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}