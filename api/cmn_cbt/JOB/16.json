{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":16,"content":[{"type":"heading","content":["約伯的回答"]},{"type":"verse","number":1,"content":["約伯回答說："]},{"type":"verse","number":2,"content":[{"text":"「這些話，我聽過很多，","poem":1},{"lineBreak":true},{"text":"你們的安慰無不讓人愁煩。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們的空談無休無止嗎？","poem":1},{"lineBreak":true},{"text":"是什麼惹你們說個不停？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"倘若你我易地而處，","poem":1},{"lineBreak":true},{"text":"我也能說你們那樣的話，","poem":1},{"lineBreak":true},{"text":"滔滔不絕地攻擊你們，","poem":1},{"lineBreak":true},{"text":"向你們搖頭。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但我會對你們講鼓勵的話，","poem":1},{"lineBreak":true},{"text":"用勸慰之言減輕你們的痛苦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"「我若申辯，痛苦不減；","poem":1},{"lineBreak":true},{"text":"我若緘默，痛苦猶在。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝啊，你無疑使我精疲力竭，","poem":1},{"lineBreak":true},{"text":"家破人亡，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你榨乾了我，","poem":1},{"lineBreak":true},{"text":"使我骨瘦如柴，","poem":1},{"lineBreak":true},{"text":"這成了當面指控我的罪證。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"上帝在憤怒中撕裂我，迫害我，","poem":1},{"lineBreak":true},{"text":"向我咬牙切齒；","poem":1},{"lineBreak":true},{"text":"仇敵惡狠狠地盯著我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們嘲笑我，","poem":1},{"lineBreak":true},{"text":"輕蔑地摑我的臉，","poem":1},{"lineBreak":true},{"text":"聯合起來攻擊我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝把我交給罪人，","poem":1},{"lineBreak":true},{"text":"把我扔到惡人手中。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我本來平順，祂擊垮了我，","poem":1},{"lineBreak":true},{"text":"祂抓住我的頸項將我摔碎，","poem":1},{"lineBreak":true},{"text":"把我當祂的箭靶。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂的弓箭手四面圍住我，","poem":1},{"lineBreak":true},{"text":"祂毫不留情地刺透我的腎臟，","poem":1},{"lineBreak":true},{"text":"使我肝膽塗地。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂一次次地擊傷我，","poem":1},{"lineBreak":true},{"text":"像勇士一樣撲向我。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我將麻衣縫在皮膚上，","poem":1},{"lineBreak":true},{"text":"把我的榮耀埋在塵土中。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我哭得臉頰紅腫，","poem":1},{"lineBreak":true},{"text":"眼皮發黑。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"但我未行殘暴之事，","poem":1},{"lineBreak":true},{"text":"我的禱告純真。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"「大地啊！不要掩蓋我的血，","poem":1},{"lineBreak":true},{"text":"不要讓我的呼求銷聲匿跡。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"此時，我的見證人在天上，","poem":1},{"lineBreak":true},{"text":"我的辯護者在高天上。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的朋友譏笑我，","poem":1},{"lineBreak":true},{"text":"我在上帝面前淚水湧流。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"但願人與上帝之間有仲裁者，","poem":1},{"lineBreak":true},{"text":"如同人與人之間。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因為我的年日不多，","poem":1},{"lineBreak":true},{"text":"我快要踏上不歸路。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}