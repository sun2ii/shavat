{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"「我的心靈破碎，我的年日將盡，","poem":1},{"lineBreak":true},{"text":"墳墓等候著我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"無疑，嘲笑的人圍著我，","poem":1},{"lineBreak":true},{"text":"我眼睜睜地看著他們挑釁。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝啊，求你為我作保。","poem":1},{"lineBreak":true},{"text":"除你以外，誰肯做我的保人？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你蒙蔽了他們的心智，","poem":1},{"lineBreak":true},{"text":"因此你必不讓他們得勝。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"人為了分產業而控告朋友，","poem":1},{"lineBreak":true},{"text":"其子孫的眼睛要失明。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"上帝使我成了人們的笑柄，","poem":1},{"lineBreak":true},{"text":"他們在我臉上吐唾沫。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"哀傷使我眼目昏花，","poem":1},{"lineBreak":true},{"text":"我整個人骨瘦如柴。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"這使正直的人震驚，","poem":1},{"lineBreak":true},{"text":"使無辜的人起來討伐不敬虔的人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"義人堅守自己的道，","poem":1},{"lineBreak":true},{"text":"手潔的人更有力量。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"來吧，你們眾人再來，","poem":1},{"lineBreak":true},{"text":"我在你們中間不會找到一個智者。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的年日已盡，","poem":1},{"lineBreak":true},{"text":"我的計劃破滅，","poem":1},{"lineBreak":true},{"text":"我的心願落空。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們以黑夜為白晝，","poem":1},{"lineBreak":true},{"text":"說光明與黑暗相似。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我若期望陰間作我的家園，","poem":1},{"lineBreak":true},{"text":"在黑暗之地鋪設我的床榻，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"稱墳墓為父親，","poem":1},{"lineBreak":true},{"text":"稱蛆蟲為母親、姊妹，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"那麼，我的希望在哪裡？","poem":1},{"lineBreak":true},{"text":"誰能看到我的希望？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我的希望會跟我下到陰間，","poem":1},{"lineBreak":true},{"text":"與我同歸塵土嗎？」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}