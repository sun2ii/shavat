{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":18,"content":[{"type":"heading","content":["比勒達發言"]},{"type":"verse","number":1,"content":["書亞人比勒達回答說："]},{"type":"verse","number":2,"content":[{"text":"「你要狡辯到何時呢？","poem":1},{"lineBreak":true},{"text":"你先想清楚，然後我們再談。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"為何你把我們當作牲畜，","poem":1},{"lineBreak":true},{"text":"把我們視為蠢貨？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你這氣得要撕碎自己的人，","poem":1},{"lineBreak":true},{"text":"大地會因你而荒涼嗎？","poem":1},{"lineBreak":true},{"text":"磐石會因你而挪移嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"「惡人的光必熄滅。","poem":1},{"lineBreak":true},{"text":"他的火焰不再閃耀。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他帳篷中燈光暗淡，","poem":1},{"lineBreak":true},{"text":"他上面的燈熄滅了。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"惡人強勁的步伐變得蹣跚，","poem":1},{"lineBreak":true},{"text":"他必被自己的陰謀所害。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他自陷網羅，","poem":1},{"lineBreak":true},{"text":"步入圈套。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"套索纏住他的腳跟，","poem":1},{"lineBreak":true},{"text":"網羅緊緊地罩住他。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"土裡埋著絆他的繩索，","poem":1},{"lineBreak":true},{"text":"路上有陷阱等待著他。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"恐懼四面籠罩著他，","poem":1},{"lineBreak":true},{"text":"步步緊追著他。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他餓得氣力衰竭，","poem":1},{"lineBreak":true},{"text":"災禍隨時臨到他。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"疾病侵蝕他的皮肉，","poem":1},{"lineBreak":true},{"text":"可怕的死亡吞噬他的肢體。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他被拖出安穩的帳篷，","poem":1},{"lineBreak":true},{"text":"被押到冥王","poem":1},{"noteId":9},{"text":"那裡。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他的帳篷燃燒著烈焰，","poem":1},{"lineBreak":true},{"text":"他的居所撒滿了硫磺。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他下面的根莖枯乾，","poem":1},{"lineBreak":true},{"text":"上面的枝子枯萎。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他從世上銷聲匿跡，","poem":1},{"lineBreak":true},{"text":"無人記得他的名字。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他從光明中被趕入黑暗，","poem":1},{"lineBreak":true},{"text":"他被逐出這個世界。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他在本族中無子無孫，","poem":1},{"lineBreak":true},{"text":"他所居之地無人生還。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他的下場令西方的人震驚，","poem":1},{"lineBreak":true},{"text":"令東方的人戰慄。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"這就是不義之人的歸宿，","poem":1},{"lineBreak":true},{"text":"不認識上帝之人的下場。」","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"「冥王」希伯來文是「恐怖之王」。","reference":{"chapter":18,"verse":14}}]},"thisChapterLink":"/api/cmn_cbt/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}