{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":19,"content":[{"type":"heading","content":["約伯的回答"]},{"type":"verse","number":1,"content":["約伯回答說："]},{"type":"verse","number":2,"content":[{"text":"「你們要折磨我多久？","poem":1},{"lineBreak":true},{"text":"用言語壓碎我到何時？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們侮辱我已有十次之多，","poem":1},{"lineBreak":true},{"text":"苦待我也不以為恥。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"即使我真有過錯，","poem":1},{"lineBreak":true},{"text":"也由我獨自承擔。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你們若真要妄自尊大，","poem":1},{"lineBreak":true},{"text":"利用我的恥辱來指責我，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"也該知道是上帝冤枉了我，","poem":1},{"lineBreak":true},{"text":"用網羅套住我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我喊冤，卻無人回應；","poem":1},{"lineBreak":true},{"text":"我呼救，卻不見公道。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"上帝築起牆壘，阻斷我的路，","poem":1},{"lineBreak":true},{"text":"祂使黑暗籠罩我的路途。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂剝去我的榮耀，","poem":1},{"lineBreak":true},{"text":"摘走我頭上的冠冕。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂從四面攻擊我，直到我消逝；","poem":1},{"lineBreak":true},{"text":"祂把我的希望像樹一樣連根拔除。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂向我發烈怒，","poem":1},{"lineBreak":true},{"text":"視我為仇敵。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂的大軍蜂擁而來，","poem":1},{"lineBreak":true},{"text":"築起圍城坡道攻擊我，","poem":1},{"lineBreak":true},{"text":"在我帳篷四周紮營。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"「祂使我的弟兄遠離我，","poem":1},{"lineBreak":true},{"text":"我的熟人完全背棄我。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我的親屬離開我，","poem":1},{"lineBreak":true},{"text":"我的摯友忘記我。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的客人和婢女都視我如陌路，","poem":1},{"lineBreak":true},{"text":"把我當作外族人。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我呼喚僕人，他卻不回應；","poem":1},{"lineBreak":true},{"text":"我開口哀求，他也不理睬。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我妻子厭惡我的氣息，","poem":1},{"lineBreak":true},{"text":"我的手足都嫌棄我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"連小孩子都鄙視我；","poem":1},{"lineBreak":true},{"text":"我一出現，他們就嘲笑我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的密友都憎惡我，","poem":1},{"lineBreak":true},{"text":"我愛的人也反對我。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我瘦得只剩下皮包骨，","poem":1},{"lineBreak":true},{"text":"我離死亡僅一線之隔","poem":1},{"noteId":10},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"「我的朋友啊，可憐我吧！可憐我吧！","poem":1},{"lineBreak":true},{"text":"因為上帝的手擊打我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你們為何像上帝一樣逼我？","poem":1},{"lineBreak":true},{"text":"為何吃了我的肉還不滿足？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"但願把我的話寫下來，","poem":1},{"lineBreak":true},{"text":"記錄在書卷上，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"用鐵筆和鉛鐫刻在磐石上，","poem":1},{"lineBreak":true},{"text":"直存到永遠。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我知道我的救贖主活著，","poem":1},{"lineBreak":true},{"text":"最後祂必站在地上。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我的皮肉雖然要朽爛，","poem":1},{"lineBreak":true},{"text":"但我必活著","poem":1},{"noteId":11},{"text":"見上帝。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我要親自見祂，","poem":1},{"lineBreak":true},{"text":"我要親眼見祂。","poem":1},{"lineBreak":true},{"text":"我心中充滿渴望！","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你們說禍根在我身上，","poem":1},{"lineBreak":true},{"text":"還想繼續迫害我。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你們自己應當畏懼刀劍，","poem":1},{"lineBreak":true},{"text":"因為烈怒會帶來刀劍的懲罰，","poem":1},{"lineBreak":true},{"text":"那時你們將知道有審判。」","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"「我離死亡僅一線之隔」希伯來文是「我只剩牙皮逃脫」。","reference":{"chapter":19,"verse":20}},{"noteId":11,"caller":"+","text":"「活著」或譯「在肉體之外」。","reference":{"chapter":19,"verse":26}}]},"thisChapterLink":"/api/cmn_cbt/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}