{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":20,"content":[{"type":"heading","content":["瑣法再度發言"]},{"type":"verse","number":1,"content":["拿瑪人瑣法回答說："]},{"type":"verse","number":2,"content":[{"text":"「我感到煩躁不安，","poem":1},{"lineBreak":true},{"text":"心中有話不吐不快。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我聽見侮辱我的斥責，","poem":1},{"lineBreak":true},{"text":"我的理智催促我回答。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"難道你不知道嗎？從古至今，","poem":1},{"lineBreak":true},{"text":"自從世上有人以來，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"惡人得勢不會長久，","poem":1},{"lineBreak":true},{"text":"不信上帝者的快樂轉瞬即逝。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"雖然他傲氣沖天，","poem":1},{"lineBreak":true},{"text":"把頭挺到雲端，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"終必如自己的糞便永遠消亡，","poem":1},{"lineBreak":true},{"text":"見過他的人都不知他在何處。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他如夢消逝，蹤影杳然；","poem":1},{"lineBreak":true},{"text":"如夜間的異象，飛逝而去。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"見過他的人不會再見到他，","poem":1},{"lineBreak":true},{"text":"他將從家鄉消失無蹤。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他的兒女要向窮人乞憐，","poem":1},{"lineBreak":true},{"text":"他要親手償還不義之財。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他的筋骨依然強健，","poem":1},{"lineBreak":true},{"text":"卻要隨他葬入塵土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"「他以邪惡為甘飴，","poem":1},{"lineBreak":true},{"text":"將其藏在舌下，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"含在口中，","poem":1},{"lineBreak":true},{"text":"慢慢品味。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"這食物在腹中變質，","poem":1},{"lineBreak":true},{"text":"變成了蛇的毒液。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他要吐出所吞下的財富，","poem":1},{"lineBreak":true},{"text":"上帝要倒空他腹中之物。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他吸吮蛇的毒液，","poem":1},{"lineBreak":true},{"text":"被蛇的舌頭害死。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他無法享用流淌不盡的奶與蜜。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他留不住勞碌的成果，","poem":1},{"lineBreak":true},{"text":"無法享用所賺的財富。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他欺壓、拋棄窮人，","poem":1},{"lineBreak":true},{"text":"強佔他人的房屋。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他貪慾無度，","poem":1},{"lineBreak":true},{"text":"不放過任何喜愛之物。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他吞掉一切所有，","poem":1},{"lineBreak":true},{"text":"他的福樂不能長久。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他在富足時將陷入困境，","poem":1},{"lineBreak":true},{"text":"各種災禍將接踵而至。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"上帝的怒火如雨降在他身上，","poem":1},{"lineBreak":true},{"text":"填滿他的肚腹。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他躲過了鐵刃，","poem":1},{"lineBreak":true},{"text":"卻被銅箭射穿。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"利箭穿透他的後背，","poem":1},{"lineBreak":true},{"text":"閃亮的箭頭刺破他的膽囊，","poem":1},{"lineBreak":true},{"text":"恐怖籠罩著他。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他的財寶消失在幽冥中，","poem":1},{"lineBreak":true},{"text":"天火","poem":1},{"noteId":12},{"text":"要吞噬他，","poem":1},{"lineBreak":true},{"text":"焚毀他帳篷中殘留的一切。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"天要揭露他的罪惡，","poem":1},{"lineBreak":true},{"text":"地要站出來指控他。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"在上帝發烈怒的日子，","poem":1},{"lineBreak":true},{"text":"洪流將席捲他的家產。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"這便是上帝給惡人的歸宿，","poem":1},{"lineBreak":true},{"text":"是上帝讓他們承受的結局。」","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"「天火」希伯來文是「非人手點燃的火」。","reference":{"chapter":20,"verse":26}}]},"thisChapterLink":"/api/cmn_cbt/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}