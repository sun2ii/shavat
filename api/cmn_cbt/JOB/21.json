{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":21,"content":[{"type":"heading","content":["約伯的回答"]},{"type":"verse","number":1,"content":[{"text":"約伯回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"「你們仔細聽我說，","poem":1},{"lineBreak":true},{"text":"便是給我的慰藉。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"請容忍我把話說完，","poem":1},{"lineBreak":true},{"text":"之後任憑你們嘲笑。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我豈是向人抱怨？","poem":1},{"lineBreak":true},{"text":"我有理由不耐煩。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你們看到我會大吃一驚，","poem":1},{"lineBreak":true},{"text":"嚇得用手掩口。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我一想到自己，就心驚膽戰，","poem":1},{"lineBreak":true},{"text":"渾身發抖。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"為何惡人活著，得享長壽，","poem":1},{"lineBreak":true},{"text":"勢力強大？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們的兒孫圍繞膝前，","poem":1},{"lineBreak":true},{"text":"他們得見後代茁壯成長。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們家中平安無懼，","poem":1},{"lineBreak":true},{"text":"他們不被上帝杖打。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們的公牛繁殖力強，","poem":1},{"lineBreak":true},{"text":"他們的母牛從不掉胎。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們讓孩童像羊群一樣走到戶外，","poem":1},{"lineBreak":true},{"text":"盡情地歡跳。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們伴著鈴鼓和豎琴歌唱，","poem":1},{"lineBreak":true},{"text":"在笛聲中歡喜不已。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他們一生幸福，","poem":1},{"lineBreak":true},{"text":"安然下到陰間。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們對上帝說，『離開我們，","poem":1},{"lineBreak":true},{"text":"我們不想學習你的道。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"全能者是誰，竟要我們事奉祂？","poem":1},{"lineBreak":true},{"text":"向祂禱告有何益處？』","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"看啊，他們的幸福不在他們手中；","poem":1},{"lineBreak":true},{"text":"因此，我決不苟同他們的謀劃。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"「惡人的燈何曾熄滅？","poem":1},{"lineBreak":true},{"text":"災難何曾臨到他們？","poem":1},{"lineBreak":true},{"text":"上帝何曾發怒使他們受苦？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他們何曾像風中的碎稭，","poem":1},{"lineBreak":true},{"text":"像被暴風捲去的糠秕？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你們說上帝會把懲罰留給他們的兒女，","poem":1},{"lineBreak":true},{"text":"我認為不如報應在他們本人身上，","poem":1},{"lineBreak":true},{"text":"讓他們親自領教。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"願他們親眼看見自己滅亡。","poem":1},{"lineBreak":true},{"text":"願他們喝下全能者的烈怒。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"因為他們的歲月一旦度盡，","poem":1},{"lineBreak":true},{"text":"又怎會關心身後的家人？","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"「上帝既審判身居高位者，","poem":1},{"lineBreak":true},{"text":"誰還能傳授知識給祂？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"有人至死仍充滿活力，","poem":1},{"lineBreak":true},{"text":"盡享平靖安逸。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他營養充足，","poem":1},{"lineBreak":true},{"text":"骨骼健壯。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"有人至死心中苦痛，","poem":1},{"lineBreak":true},{"text":"從未嘗過幸福的滋味。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"二者都埋入塵土，","poem":1},{"lineBreak":true},{"text":"被蛆蟲覆蓋。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我知道你們的想法，","poem":1},{"lineBreak":true},{"text":"並那些冤枉我的詭計。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你們問，『權貴的房子如今何在？","poem":1},{"lineBreak":true},{"text":"惡人住的帳篷今在何方？』","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"難道你們沒有問過旅客，","poem":1},{"lineBreak":true},{"text":"不接受他們的說法？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"就是惡人在災難之日倖存，","poem":1},{"lineBreak":true},{"text":"在上帝發怒之日得以逃脫。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"誰會當面斥責他們的惡行，","poem":1},{"lineBreak":true},{"text":"因其所作所為而報應他們？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他們被抬入墳墓後，","poem":1},{"lineBreak":true},{"text":"還有人看守墓地。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他們在谷中的沃土安息，","poem":1},{"lineBreak":true},{"text":"送葬的人前擁後隨，不計其數。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你們的空談怎能安慰我？","poem":1},{"lineBreak":true},{"text":"你們的回答純屬荒謬。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}