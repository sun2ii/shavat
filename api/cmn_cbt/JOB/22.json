{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":22,"content":[{"type":"heading","content":["以利法再次回答"]},{"type":"verse","number":1,"content":[{"text":"提幔人以利法回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"「人對上帝能有何益處？","poem":1},{"lineBreak":true},{"text":"即使智者對祂又有何益？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"全能者豈會因你為人公義而喜悅，","poem":1},{"lineBreak":true},{"text":"因你行為純全而獲利？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂豈會因你敬虔而責備你、審判你？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你豈不是罪惡深重，","poem":1},{"lineBreak":true},{"text":"過犯無數？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你無故強取弟兄的物品作抵押，","poem":1},{"lineBreak":true},{"text":"剝去貧寒者的衣服，任其赤身露體。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你不給疲乏的人水喝，","poem":1},{"lineBreak":true},{"text":"不給饑餓的人食物。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"土地歸了權貴，","poem":1},{"lineBreak":true},{"text":"只讓顯要佔有。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你讓寡婦空手而去，","poem":1},{"lineBreak":true},{"text":"你打斷孤兒的臂膀。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因此你周圍佈滿網羅，","poem":1},{"lineBreak":true},{"text":"恐懼突然籠罩你。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"黑暗遮掩你的視線，","poem":1},{"lineBreak":true},{"text":"洪水淹沒你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"「上帝豈不在高天之上嗎？","poem":1},{"lineBreak":true},{"text":"看，天上的星宿何其高遠！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你卻說，『上帝知道什麼？","poem":1},{"lineBreak":true},{"text":"祂怎能穿透幽暗施行審判？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"當祂在穹蒼巡弋時，","poem":1},{"lineBreak":true},{"text":"密雲擋住祂的視線。』","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"難道你要走惡人的古道，","poem":1},{"lineBreak":true},{"text":"步他們的後塵？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他們死期未到便已夭逝，","poem":1},{"lineBreak":true},{"text":"他們的根基被洪濤捲走。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他們對上帝說，『離開我們吧！","poem":1},{"lineBreak":true},{"text":"全能者能把我們怎麼樣？』","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"然而，是上帝把美物充滿他們的家；","poem":1},{"lineBreak":true},{"text":"因此，我決不苟同他們的謀劃。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"義人看見他們的結局便歡喜，","poem":1},{"lineBreak":true},{"text":"無辜者見了便嘲笑，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"說，『我們的仇敵果然被剷除，","poem":1},{"lineBreak":true},{"text":"他們的財產已被火吞噬。』","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"「你要順從上帝，與祂和好，","poem":1},{"lineBreak":true},{"text":"福樂就會臨到你。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你要接受祂的教誨，","poem":1},{"lineBreak":true},{"text":"把祂的話謹記在心。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你若歸向全能者，就必得到恢復。","poem":1},{"lineBreak":true},{"text":"你若將罪惡從帳篷中遠遠趕走，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"將金子扔進塵土，","poem":1},{"lineBreak":true},{"text":"將俄斐的金子丟在佈滿石頭的溪谷，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"全能者必成為你的金子，","poem":1},{"lineBreak":true},{"text":"成為你珍貴的銀子。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"那時，你必以全能者為樂，","poem":1},{"lineBreak":true},{"text":"你必抬頭仰望上帝。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你向祂禱告，祂必垂聽，","poem":1},{"lineBreak":true},{"text":"你必向祂還所許的願。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你想做的事都會成功，","poem":1},{"lineBreak":true},{"text":"必有光照亮你的道路。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"人遭貶抑時，你說，『他們太高傲了。』","poem":1},{"lineBreak":true},{"text":"上帝拯救眼目低垂的人。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"祂甚至會解救有罪之人，","poem":1},{"lineBreak":true},{"text":"他們必因你的手清潔而獲救。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}