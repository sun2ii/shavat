{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"「全能者為何不定下審判的日期？","poem":1},{"lineBreak":true},{"text":"為何認識祂的人要空等一場？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"惡人挪移界石，","poem":1},{"lineBreak":true},{"text":"搶奪羊群去牧養。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們牽走孤兒的驢，","poem":1},{"lineBreak":true},{"text":"強取寡婦的牛作抵押。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們把貧民趕離正路，","poem":1},{"lineBreak":true},{"text":"地上的窮人被迫東躲西藏。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"窮人如荒漠中的野驢，","poem":1},{"lineBreak":true},{"text":"在荒地殷勤覓食，給兒女糊口。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們割田間的草料，","poem":1},{"lineBreak":true},{"text":"摘惡人剩餘的葡萄。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們整夜赤身露體，","poem":1},{"lineBreak":true},{"text":"沒有被子可以禦寒。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們被山雨澆透，","poem":1},{"lineBreak":true},{"text":"只能在巖石下棲身。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"惡人奪去寡母懷中的孤兒，","poem":1},{"lineBreak":true},{"text":"強取窮人的孩子作抵押，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"使他們赤身露體地流浪，","poem":1},{"lineBreak":true},{"text":"餓著肚子扛禾捆。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們在惡人的橄欖林中榨油，","poem":1},{"lineBreak":true},{"text":"在酒池踩踏，卻受乾渴之苦。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"城中傳來垂死之人的呻吟，","poem":1},{"lineBreak":true},{"text":"受傷者不斷呼救，","poem":1},{"lineBreak":true},{"text":"上帝卻置之不理。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"「有人與光明為敵，","poem":1},{"lineBreak":true},{"text":"不認識光明之道，","poem":1},{"lineBreak":true},{"text":"也不走光明之路。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"兇手黎明起來，","poem":1},{"lineBreak":true},{"text":"殺害貧苦的人，","poem":1},{"lineBreak":true},{"text":"夜晚又去做賊。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"姦夫的眼睛盼著黃昏，","poem":1},{"lineBreak":true},{"text":"心想，『沒人會看見我』，","poem":1},{"lineBreak":true},{"text":"並把臉蒙起來。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"盜賊夜間挖牆行竊，","poem":1},{"lineBreak":true},{"text":"日間躲藏起來，","poem":1},{"lineBreak":true},{"text":"不想認識光明。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因為他們把暗夜當白晝，","poem":1},{"lineBreak":true},{"text":"他們熟知暗夜的恐怖。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"「惡人如水上的泡沫。","poem":1},{"lineBreak":true},{"text":"他們的產業被咒詛，","poem":1},{"lineBreak":true},{"text":"無人踏足其葡萄園。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"陰間吞噬犯罪之人，","poem":1},{"lineBreak":true},{"text":"如同乾熱吞噬融雪。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他們的生母忘記他們，","poem":1},{"lineBreak":true},{"text":"蟲子在他們身上飽餐。","poem":1},{"lineBreak":true},{"text":"沒有人再記得他們，","poem":1},{"lineBreak":true},{"text":"惡人像樹木一樣折斷。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他們惡待不育的婦人，","poem":1},{"lineBreak":true},{"text":"毫不善待寡婦。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"但上帝用大能擄走權貴，","poem":1},{"lineBreak":true},{"text":"他們再強大也難保性命。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"上帝讓他們暫享安逸，","poem":1},{"lineBreak":true},{"text":"但他們逃不過祂的眼睛。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他們一時得勢，轉瞬消逝；","poem":1},{"lineBreak":true},{"text":"他們淪為卑賤，像其他人一樣滅亡，","poem":1},{"lineBreak":true},{"text":"像麥穗一樣被割掉。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我說的都是實情，誰能否認？","poem":1},{"lineBreak":true},{"text":"誰能證明我的話是空談？」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}