{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":26,"content":[{"type":"heading","content":["約伯的回答"]},{"type":"verse","number":1,"content":[{"text":"約伯回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"「你真是幫了軟弱者的大忙！","poem":1},{"lineBreak":true},{"text":"救了臂膀無力的人！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"無智慧的人真多虧你的指教！","poem":1},{"lineBreak":true},{"text":"承蒙你的真知灼見！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"誰幫你說出這些話？","poem":1},{"lineBreak":true},{"text":"誰的靈在藉著你發言？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"「陰魂和水族在水底顫抖，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"陰間裸露在祂面前，","poem":1},{"lineBreak":true},{"text":"滅亡之地毫無遮掩。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂將北極鋪在空中，","poem":1},{"lineBreak":true},{"text":"將地懸在虛無中；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂將水捲在密雲中，","poem":1},{"lineBreak":true},{"text":"雲負重卻不裂開。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂遮蓋自己的寶座","poem":1},{"noteId":13},{"text":"，","poem":1},{"lineBreak":true},{"text":"把雲彩鋪在上面。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂在海面上畫出地平線，","poem":1},{"lineBreak":true},{"text":"作為光明與黑暗的交界。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂的斥責使天柱震動驚駭，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂的能力使大海平靜，","poem":1},{"lineBreak":true},{"text":"祂運用智慧擊碎海怪。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂吹的氣使天空晴朗，","poem":1},{"lineBreak":true},{"text":"祂揮手刺穿逃跑的蛇。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"看啊，這不過是祂作為的一斑，","poem":1},{"lineBreak":true},{"text":"是我們聽到的點滴微音！","poem":1},{"lineBreak":true},{"text":"誰能領悟祂的雷霆萬鈞？」","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":13,"caller":"+","text":"「寶座」或譯「滿月」。","reference":{"chapter":26,"verse":9}}]},"thisChapterLink":"/api/cmn_cbt/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}