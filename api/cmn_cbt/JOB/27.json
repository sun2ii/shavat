{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"約伯接著說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"「我憑不給我公道的永恆上帝，","poem":1},{"lineBreak":true},{"text":"憑使我靈魂陷入痛苦的全能者起誓，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"只要我一息尚存，","poem":1},{"lineBreak":true},{"text":"鼻中還有上帝之氣，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的嘴唇決不說惡語，","poem":1},{"lineBreak":true},{"text":"舌頭決不講謊話。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我決不承認你們有理，","poem":1},{"lineBreak":true},{"text":"我至死堅信自己無辜。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我堅守自己的公義，決不放棄，","poem":1},{"lineBreak":true},{"text":"我有生之年都問心無愧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"「願我仇敵的下場和惡人一樣，","poem":1},{"lineBreak":true},{"text":"願我對頭的結局和罪人相同。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因為不敬虔的人將被剷除，上帝將奪去他的性命。","poem":1},{"lineBreak":true},{"text":"那時，他還有何指望？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"患難臨到他時，","poem":1},{"lineBreak":true},{"text":"上帝豈會垂聽他的呼求？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他豈會以全能者為樂，","poem":1},{"lineBreak":true},{"text":"時時求告上帝？","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"「我要教導你們有關上帝的能力，","poem":1},{"lineBreak":true},{"text":"我不會隱瞞全能者的作為。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"其實你們也曾親眼目睹，","poem":1},{"lineBreak":true},{"text":"為何還講這些虛妄之言？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"「以下是上帝給惡人的歸宿，","poem":1},{"lineBreak":true},{"text":"全能者讓兇徒承受的結局。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他的兒女再多也難逃殺戮，","poem":1},{"lineBreak":true},{"text":"他的子孫永遠無法果腹。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他倖存的後人被瘟疫吞噬，","poem":1},{"lineBreak":true},{"text":"家中的寡婦也不哀哭。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"儘管他堆積的銀子多如塵沙，","poem":1},{"lineBreak":true},{"text":"儲存的衣服高若土堆，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"但義人將穿他儲存的衣服，","poem":1},{"lineBreak":true},{"text":"清白的人將分他的銀子。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他建的房子像蛾繭，","poem":1},{"lineBreak":true},{"text":"像守望者搭的草棚。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他睡前還是富翁，","poem":1},{"lineBreak":true},{"text":"醒來後財富已空。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"恐懼如洪水般淹沒他，","poem":1},{"lineBreak":true},{"text":"暴風在夜間把他捲去。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"東風把他颳走，","poem":1},{"lineBreak":true},{"text":"吹得無影無蹤。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"狂風","poem":1},{"noteId":14},{"text":"毫不留情地擊打他，","poem":1},{"lineBreak":true},{"text":"他拼命地逃離風的威力。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"狂風向他拍掌，","poem":1},{"lineBreak":true},{"text":"呼嘯著吹走他。","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"「狂風」希伯來文指代不清，也可譯作「祂」，指上帝，23節同。","reference":{"chapter":27,"verse":22}}]},"thisChapterLink":"/api/cmn_cbt/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}