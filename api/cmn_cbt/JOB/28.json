{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":28,"content":[{"type":"heading","content":["智慧頌"]},{"type":"verse","number":1,"content":[{"text":"「銀從礦中採取，","poem":1},{"lineBreak":true},{"text":"金有冶煉之地，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"鐵從地下挖掘，","poem":1},{"lineBreak":true},{"text":"銅從石中提煉。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"世人探尋黑暗的盡頭，","poem":1},{"lineBreak":true},{"text":"搜索幽暗的深處，","poem":1},{"lineBreak":true},{"text":"要得隱藏的礦石。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們在杳無人煙、人蹤絕跡之地開礦，","poem":1},{"lineBreak":true},{"text":"他們遠離人群，懸在半空搖來搖去。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"大地出產糧食，","poem":1},{"lineBreak":true},{"text":"地下烈火翻騰。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"地下的石頭出藍寶石，","poem":1},{"lineBreak":true},{"text":"還蘊藏著金沙。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"礦中的路徑，猛禽不知道，","poem":1},{"lineBreak":true},{"text":"鷹眼也未曾見過，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"猛獸未曾踏足，","poem":1},{"lineBreak":true},{"text":"獅子未曾經過。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"世人開鑿堅石，","poem":1},{"lineBreak":true},{"text":"翻動山的根基，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"在巖石中鑿通道，","poem":1},{"lineBreak":true},{"text":"一覽各樣的寶藏。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們把水流截斷，","poem":1},{"lineBreak":true},{"text":"使隱藏之物顯露。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"「然而，智慧何處尋？","poem":1},{"lineBreak":true},{"text":"聰明之道在哪裡？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"無人知道智慧的價值，","poem":1},{"lineBreak":true},{"text":"人世間找不到她。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"深淵說，『她不在我裡面。』","poem":1},{"lineBreak":true},{"text":"海洋說，『她不在我這裡。』","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"金子買不到她，","poem":1},{"lineBreak":true},{"text":"銀子換不來她；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"俄斐的金子無法與她相比，","poem":1},{"lineBreak":true},{"text":"紅瑪瑙和藍寶石不能與她媲美；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"黃金和水晶無法與她相比，","poem":1},{"lineBreak":true},{"text":"純金的器皿不能與她兌換；","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"珊瑚和碧玉不能與她相提並論，","poem":1},{"lineBreak":true},{"text":"紅寶石的價值遠不如她；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"古實的黃玉無法與她相比，","poem":1},{"lineBreak":true},{"text":"純金不能與她等量齊觀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"「然而，智慧何處尋？","poem":1},{"lineBreak":true},{"text":"聰明之道在哪裡？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"眾生的眼睛看不見她，","poem":1},{"lineBreak":true},{"text":"空中的飛鳥找不到她。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"毀滅和死亡說，","poem":1},{"lineBreak":true},{"text":"『我們只風聞其名。』","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"上帝認識通往智慧的路，","poem":1},{"lineBreak":true},{"text":"祂知道智慧在哪裡，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"因祂縱覽地極，","poem":1},{"lineBreak":true},{"text":"遍察天下萬物。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"祂定下風的重量，","poem":1},{"lineBreak":true},{"text":"量出水的規模；","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"祂頒佈雨露的規律，","poem":1},{"lineBreak":true},{"text":"劃定雷電的路線。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"那時祂已看見智慧，並評估她，","poem":1},{"lineBreak":true},{"text":"堅立她，探察她。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"祂對世人說，『敬畏主就是智慧，","poem":1},{"lineBreak":true},{"text":"遠離惡便是聰明。』」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}