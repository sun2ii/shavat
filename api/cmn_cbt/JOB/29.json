{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":29,"content":[{"type":"heading","content":["回憶昔日的幸福"]},{"type":"verse","number":1,"content":[{"text":"約伯接著說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"「但願我回到從前的歲月，","poem":1},{"lineBreak":true},{"text":"回到上帝看顧我的日子。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"那時，祂的燈在我頭上照耀，","poem":1},{"lineBreak":true},{"text":"祂的光伴我走過黑暗。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"那時，我身強力壯，","poem":1},{"lineBreak":true},{"text":"上帝是我家的密友；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"全能者尚與我同在，","poem":1},{"lineBreak":true},{"text":"兒女圍繞在我身旁；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我用奶油洗腳，","poem":1},{"lineBreak":true},{"text":"磐石為我湧出油河。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"「那時，我去城門口，","poem":1},{"lineBreak":true},{"text":"到廣場就坐，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"青年看見我便迴避，","poem":1},{"lineBreak":true},{"text":"老人也起身肅立；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"王侯都停止講話，","poem":1},{"lineBreak":true},{"text":"用手掩口；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"權貴都靜默無聲，","poem":1},{"lineBreak":true},{"text":"舌頭緊貼上膛。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"聽見我的都祝福我，","poem":1},{"lineBreak":true},{"text":"看見我的都稱讚我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因為我拯救求助的窮人，","poem":1},{"lineBreak":true},{"text":"解救無人援助的孤兒。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"臨終的人為我祝福，","poem":1},{"lineBreak":true},{"text":"我使寡婦心裡歡唱。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我以公義為衣穿在身上，","poem":1},{"lineBreak":true},{"text":"公正是我的外袍和頭巾。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我做盲人的眼、","poem":1},{"lineBreak":true},{"text":"瘸腿之人的腳；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我做窮人的父，","poem":1},{"lineBreak":true},{"text":"為陌生人伸冤。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我打落惡人的毒牙，","poem":1},{"lineBreak":true},{"text":"從他們口中救出受害者。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"「我想，『我必在家中安然離世，","poem":1},{"lineBreak":true},{"text":"我的年日必多如塵沙。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的根伸展到水邊，","poem":1},{"lineBreak":true},{"text":"枝子整夜沐浴甘露。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的尊榮永不褪色。","poem":1},{"lineBreak":true},{"text":"手中的弓常新不敗。』","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"「人們期待聆聽我的話，","poem":1},{"lineBreak":true},{"text":"默然等候我的指教。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我講完後，無人再發言；","poem":1},{"lineBreak":true},{"text":"我的話滋潤他們的心田。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他們盼我如盼甘霖，","poem":1},{"lineBreak":true},{"text":"張著口如慕春雨。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我的微笑令他們受寵若驚，","poem":1},{"lineBreak":true},{"text":"他們從不使我臉色不悅。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我為他們選擇道路，並且做首領，","poem":1},{"lineBreak":true},{"text":"我就像住在軍中的君王，","poem":1},{"lineBreak":true},{"text":"又如傷心之人的安慰者。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}