{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":3,"content":[{"type":"heading","content":["約伯咒詛自己"]},{"type":"verse","number":1,"content":["後來，約伯開口咒詛自己的生日，"]},{"type":"verse","number":2,"content":["說："]},{"type":"verse","number":3,"content":[{"text":"「願我出生的那日和懷我的那夜都滅沒。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"願那日一片黑暗，","poem":1},{"lineBreak":true},{"text":"被天上的上帝遺忘，","poem":1},{"lineBreak":true},{"text":"沒有陽光照耀。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"願那日被幽暗和濃濃的黑影籠罩，","poem":1},{"lineBreak":true},{"text":"被密雲覆蓋，","poem":1},{"lineBreak":true},{"text":"被陰暗淹沒。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"願那夜被幽暗吞噬，","poem":1},{"lineBreak":true},{"text":"不列在年日中，","poem":1},{"lineBreak":true},{"text":"不算在歲月裡。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"願那夜無人生育，","poem":1},{"lineBreak":true},{"text":"毫無快樂之聲。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"願那些咒詛白日、","poem":1},{"lineBreak":true},{"text":"能惹動海怪的人，","poem":1},{"lineBreak":true},{"text":"咒詛那夜。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"願那夜的晨星昏暗，","poem":1},{"lineBreak":true},{"text":"等不到晨光的出現，","poem":1},{"lineBreak":true},{"text":"看不見黎明的眼簾。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因為那夜沒有關閉我母胎的門，","poem":1},{"lineBreak":true},{"text":"也沒有遮住我眼前的患難。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"「為何我不出生時就夭折，","poem":1},{"lineBreak":true},{"text":"出母胎時就斷氣？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"為何要把我抱在膝上，","poem":1},{"lineBreak":true},{"text":"用乳汁哺育我？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"不然我早已安然躺臥、長眠安息，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"與世上的君王和謀臣作伴——他們為自己建造的宮殿已荒廢，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"與房屋堆滿金銀的王侯同眠。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"為何我沒有像未見天日就流產的嬰兒一樣消逝？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"那裡，惡人不再攪擾，","poem":1},{"lineBreak":true},{"text":"疲憊者得到安息，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"被囚者得到安寧，","poem":1},{"lineBreak":true},{"text":"聽不見監工的斥責。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"尊貴與卑賤的人都在那裡，","poem":1},{"lineBreak":true},{"text":"奴僕不再受主人的轄制。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"「為何賜光給受苦的人，","poem":1},{"lineBreak":true},{"text":"賜生命給心靈痛苦的人？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他們等候死亡卻等不到，","poem":1},{"lineBreak":true},{"text":"他們求死勝於求寶藏。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他們歸入墳墓時非常快樂，","poem":1},{"lineBreak":true},{"text":"欣喜若狂。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"為何賜生命給前路渺茫、","poem":1},{"lineBreak":true},{"text":"被上帝圍困的人？","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我以歎息為食，","poem":1},{"lineBreak":true},{"text":"呻吟如水湧流。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我害怕的事發生了，","poem":1},{"lineBreak":true},{"text":"我恐懼的事來臨了。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我不得安寧，","poem":1},{"lineBreak":true},{"text":"不得平靜，","poem":1},{"lineBreak":true},{"text":"不得安息，","poem":1},{"lineBreak":true},{"text":"只有患難。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}