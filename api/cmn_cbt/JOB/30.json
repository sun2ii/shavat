{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":30,"content":[{"type":"heading","content":["哀歎今日的痛苦"]},{"type":"verse","number":1,"content":[{"text":"「但如今，比我年少的人竟嘲笑我，","poem":1},{"lineBreak":true},{"text":"他們的父親曾被我鄙視，","poem":1},{"lineBreak":true},{"text":"連我的牧羊犬都不如。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他們精力衰竭，","poem":1},{"lineBreak":true},{"text":"無力的手於我何益？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們貧窮饑餓，瘦弱不堪，","poem":1},{"lineBreak":true},{"text":"夜間在乾旱荒涼之地啃食。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們在草叢中拔鹹草充饑，","poem":1},{"lineBreak":true},{"text":"以羅騰樹根為食。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們被趕離人群，","poem":1},{"lineBreak":true},{"text":"像賊一樣被喝斥。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們只好住在荒谷，","poem":1},{"lineBreak":true},{"text":"在地洞和巖穴棲身；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"在雜草間嚎叫如獸，","poem":1},{"lineBreak":true},{"text":"在樹叢中蜷縮一團。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們是愚昧無名之輩，","poem":1},{"lineBreak":true},{"text":"被人用鞭子趕出境外。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"「如今，他們竟唱歌諷刺我，","poem":1},{"lineBreak":true},{"text":"我成了他們的笑柄。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們厭惡我，不願靠近我，","poem":1},{"lineBreak":true},{"text":"任意朝我臉上吐唾沫。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因為上帝苦待我，使我毫無力量，","poem":1},{"lineBreak":true},{"text":"他們才在我面前肆無忌憚。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"這些無賴從右邊攻擊我，","poem":1},{"lineBreak":true},{"text":"迫使我逃亡，","poem":1},{"lineBreak":true},{"text":"他們展開攻勢要毀滅我。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他們截斷我的路，","poem":1},{"lineBreak":true},{"text":"想方設法害我，無人相助。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們衝破防線，","poem":1},{"lineBreak":true},{"text":"從廢墟中向我襲來。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"恐懼籠罩著我，","poem":1},{"lineBreak":true},{"text":"我的尊榮隨風而去，","poem":1},{"lineBreak":true},{"text":"我的榮華如雲消散。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"「如今我的生命將盡，","poem":1},{"lineBreak":true},{"text":"痛苦的日子抓住我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"夜間我的骨頭刺痛，","poem":1},{"lineBreak":true},{"text":"啃噬之痛無休無止。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"上帝猛力抓住我的衣服，","poem":1},{"lineBreak":true},{"text":"緊緊地揪住我的衣領。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂把我扔進淤泥，","poem":1},{"lineBreak":true},{"text":"使我如塵埃灰燼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"「上帝啊！我向你呼求，你不回應；","poem":1},{"lineBreak":true},{"text":"我站起來，你也不理睬。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你變得對我殘酷無情，","poem":1},{"lineBreak":true},{"text":"用你大能的手迫害我，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"把我提到風中，讓我被風吹走，","poem":1},{"lineBreak":true},{"text":"被暴風拋來拋去。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我知道你要帶我去死亡之地，","poem":1},{"lineBreak":true},{"text":"那是你為眾生所定的歸宿。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"「誠然，不幸的人在困境中呼救，","poem":1},{"lineBreak":true},{"text":"無人會伸手加害他。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"難道我不曾為受苦的人哭泣，","poem":1},{"lineBreak":true},{"text":"我的心不曾為窮困者悲傷嗎？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我盼望幸福，來的卻是災禍；","poem":1},{"lineBreak":true},{"text":"我期待光明，來的卻是黑暗。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我心裡一直煩亂不安，","poem":1},{"lineBreak":true},{"text":"苦難的日子迎面襲來。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我皮膚發黑，不是因為日曬，","poem":1},{"lineBreak":true},{"text":"我在會眾中站起來呼救。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我成了豺狼的兄弟，","poem":1},{"lineBreak":true},{"text":"鴕鳥的夥伴。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我的皮膚發黑、脫落，","poem":1},{"lineBreak":true},{"text":"我的骨頭發熱，如被火燒。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"我的琴唱出哀樂，","poem":1},{"lineBreak":true},{"text":"我的簫奏出悲鳴。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}