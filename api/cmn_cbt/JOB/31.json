{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":31,"content":[{"type":"heading","content":["約伯最後的申辯"]},{"type":"verse","number":1,"content":[{"text":"「我跟自己的眼睛立了約，","poem":1},{"lineBreak":true},{"text":"決不貪看女色。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"天上的上帝所定的是什麼？","poem":1},{"lineBreak":true},{"text":"高處的全能者賜下什麼產業？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"豈不是降災難給不義之人，","poem":1},{"lineBreak":true},{"text":"降禍患給作惡的人？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"上帝豈不鑒察我走的路，","poem":1},{"lineBreak":true},{"text":"數算我的腳步？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我何曾與虛假同行，","poem":1},{"lineBreak":true},{"text":"疾步追隨詭詐？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"願上帝把我放在公義的天平上稱量，","poem":1},{"lineBreak":true},{"text":"讓祂知道我的清白。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"倘若我的腳偏離正路，","poem":1},{"lineBreak":true},{"text":"貪圖眼目之慾，","poem":1},{"lineBreak":true},{"text":"或手上粘著罪污，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"願我種的莊稼被別人享用，","poem":1},{"lineBreak":true},{"text":"我田中的出產被連根拔起。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的心若迷戀女人，","poem":1},{"lineBreak":true},{"text":"在鄰居的門口窺探，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"願我妻子為別人推磨，","poem":1},{"lineBreak":true},{"text":"願別人與她同房。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因為這是大惡，","poem":1},{"lineBreak":true},{"text":"是當受審判的罪，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"是燒向滅亡的火焰，","poem":1},{"lineBreak":true},{"text":"會吞噬我所有家業。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我的僕婢告我，","poem":1},{"lineBreak":true},{"text":"我也會講公道，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"否則上帝追究，我怎麼辦？","poem":1},{"lineBreak":true},{"text":"祂審問我，我如何回答？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"在母腹創造我的，豈不也創造了他們？","poem":1},{"lineBreak":true},{"text":"豈不是同一位使我們在母腹中成胎？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我何曾拒絕窮人的請求，","poem":1},{"lineBreak":true},{"text":"或使寡婦眼露失望之情，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"或獨吞我的食物，","poem":1},{"lineBreak":true},{"text":"不與孤兒同享？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我自幼就如父親般撫養孤兒，","poem":1},{"lineBreak":true},{"text":"我自出母胎就照顧寡婦。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"倘若我見有人凍得要死，","poem":1},{"lineBreak":true},{"text":"或有窮人衣不蔽體，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"卻沒有把我的羊毛給他們禦寒，","poem":1},{"lineBreak":true},{"text":"以致他們向我道謝；","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"倘若我仗著在城門口有勢力，","poem":1},{"lineBreak":true},{"text":"就動手欺負孤兒，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"情願我的肩膀從肩胛脫落，","poem":1},{"lineBreak":true},{"text":"我的手臂從手肘折斷。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"因為我懼怕上帝降災禍，","poem":1},{"lineBreak":true},{"text":"我無法承擔祂的威嚴。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"「我若仰仗金子，","poem":1},{"lineBreak":true},{"text":"依靠純金，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"因財富充裕、","poem":1},{"lineBreak":true},{"text":"或家產豐足而歡喜；","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我若見太陽發光，","poem":1},{"lineBreak":true},{"text":"明月在天上移動，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"就暗自心生迷戀，","poem":1},{"lineBreak":true},{"text":"向它們吻手示敬，","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"就是犯了當受審判的罪惡，","poem":1},{"lineBreak":true},{"text":"因為這是背棄天上的上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"「我何曾因敵人遭殃而歡喜，","poem":1},{"lineBreak":true},{"text":"因他們遇禍而快樂？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我從未咒詛他們喪命，","poem":1},{"lineBreak":true},{"text":"以致我的口犯罪。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"住在我帳篷中的人，","poem":1},{"lineBreak":true},{"text":"誰沒飽餐我的肉食呢？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我的家門向路人敞開，","poem":1},{"lineBreak":true},{"text":"從未有旅客露宿街頭。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"我何曾像亞當一樣遮掩我的過犯，","poem":1},{"lineBreak":true},{"text":"將罪惡藏在懷中，","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"因害怕群眾，","poem":1},{"lineBreak":true},{"text":"畏懼族人的藐視，","poem":1},{"lineBreak":true},{"text":"就默不作聲、閉門不出？","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"「但願有人聽我申訴！","poem":1},{"lineBreak":true},{"text":"看啊，我在這裡畫押，願全能者回答我！","poem":1},{"lineBreak":true},{"text":"願我的控訴者寫好狀詞！","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"我會把狀詞披在肩上，","poem":1},{"lineBreak":true},{"text":"如冠冕一般戴在頭上。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"我會像王者一樣到祂面前，","poem":1},{"lineBreak":true},{"text":"向祂交代我的一切所為。","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"「若我的田地向我喊冤，","poem":1},{"lineBreak":true},{"text":"條條犁溝一同哭訴；","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"若我白吃地的出產，","poem":1},{"lineBreak":true},{"text":"或使地的主人喪命，","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"願地長出蒺藜而非麥子，","poem":1},{"lineBreak":true},{"text":"長出雜草而非大麥。」","poem":1},{"lineBreak":true},{"text":"約伯的話說完了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}