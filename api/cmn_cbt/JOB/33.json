{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"「約伯啊，請聽我言，","poem":1},{"lineBreak":true},{"text":"請留心聽我每一句話。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要開口發言，","poem":1},{"lineBreak":true},{"text":"我話已在舌尖。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的話發自正直的心，","poem":1},{"lineBreak":true},{"text":"我的口如實陳明道理。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"上帝的靈創造了我，","poem":1},{"lineBreak":true},{"text":"全能者的氣賦予我生命。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"如果你能，就反駁我，","poem":1},{"lineBreak":true},{"text":"站出來與我辯論。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"在上帝面前，我與你無異，","poem":1},{"lineBreak":true},{"text":"也是泥土造的。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"所以你不用懼怕我，","poem":1},{"lineBreak":true},{"text":"我不會對你施加壓力。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"「你的話已進到我耳中，","poem":1},{"lineBreak":true},{"text":"我聽見你說，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"『我純全無過，","poem":1},{"lineBreak":true},{"text":"我清白無罪，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝卻挑我的錯，","poem":1},{"lineBreak":true},{"text":"與我為敵；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂給我戴上腳鐐，","poem":1},{"lineBreak":true},{"text":"鑒察我的一舉一動。』","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"「我來答覆你，你這話沒有道理，","poem":1},{"lineBreak":true},{"text":"因為上帝比世人大。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你為何向祂抱怨，","poem":1},{"lineBreak":true},{"text":"說祂不理會世人的話？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"上帝一再用各種方式說話，","poem":1},{"lineBreak":true},{"text":"然而世人卻不明白。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"人躺在床上沉睡時，","poem":1},{"lineBreak":true},{"text":"在夢境和夜間的異象中，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"上帝開啟他們的耳朵，","poem":1},{"lineBreak":true},{"text":"用警告驚嚇他們，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"使他們離開罪惡，","poem":1},{"lineBreak":true},{"text":"不再驕傲，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"以免他們的靈魂墜入深坑，","poem":1},{"lineBreak":true},{"text":"他們的性命被刀劍奪去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"「人因受罰而臥病在床，","poem":1},{"lineBreak":true},{"text":"骨頭疼痛不止，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"以致毫無食慾，","poem":1},{"lineBreak":true},{"text":"對佳餚心生厭惡。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他日漸消瘦，","poem":1},{"lineBreak":true},{"text":"只剩下骨頭。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他的靈魂臨近深坑，","poem":1},{"lineBreak":true},{"text":"他的生命瀕臨死亡。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"如果一千天使中有一位能做他的中保，","poem":1},{"lineBreak":true},{"text":"指示他當行的事，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"上帝","poem":1},{"noteId":16},{"text":"就會憐憫他，說，『別讓他下墳墓，","poem":1},{"lineBreak":true},{"text":"我已得到他的贖金。』","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"那時，他的皮肉比孩童還嫩，","poem":1},{"lineBreak":true},{"text":"他將恢復青春的活力。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他向上帝禱告時必蒙悅納，","poem":1},{"lineBreak":true},{"text":"他歡呼著朝見上帝，","poem":1},{"lineBreak":true},{"text":"再度被祂視為義人。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他會當眾歌唱說，","poem":1},{"lineBreak":true},{"text":"『我犯了罪，顛倒是非，","poem":1},{"lineBreak":true},{"text":"祂卻沒有按我的罪報應我。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"祂救贖我的靈魂，使之免下深坑，","poem":1},{"lineBreak":true},{"text":"使我的生命得見光明。』","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"「看啊，這都是上帝的作為，","poem":1},{"lineBreak":true},{"text":"祂一次次地恩待世人，","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"從深坑救回人的靈魂，","poem":1},{"lineBreak":true},{"text":"使他沐浴生命之光。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"約伯啊，留心聽我說，","poem":1},{"lineBreak":true},{"text":"不要作聲，我要發言。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"你若有話，就答覆我；","poem":1},{"lineBreak":true},{"text":"你只管說，我願看到你的清白。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"否則，請聽我言；","poem":1},{"lineBreak":true},{"text":"不要作聲，我要傳授你智慧。」","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":16,"caller":"+","text":"「上帝」希伯來文是「他」，也可能指天使。","reference":{"chapter":33,"verse":24}}]},"thisChapterLink":"/api/cmn_cbt/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}