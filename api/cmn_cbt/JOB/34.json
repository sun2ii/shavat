{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":[{"text":"以利戶又說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"「各位智者，請聽我言；","poem":1},{"lineBreak":true},{"text":"明達之士，要側耳聽我的話。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為耳朵辨別話語，","poem":1},{"lineBreak":true},{"text":"正如舌頭品嘗食物。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我們來鑒別何為正，","poem":1},{"lineBreak":true},{"text":"一起來認識何為善。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"約伯曾說，『我是清白的，","poem":1},{"lineBreak":true},{"text":"上帝卻奪去我的公道。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我雖然有理，卻被認為是撒謊者；","poem":1},{"lineBreak":true},{"text":"我雖然無過，卻受到致命的創傷。』","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"有誰像約伯？","poem":1},{"lineBreak":true},{"text":"他肆意嘲諷，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"與惡者為伍，","poem":1},{"lineBreak":true},{"text":"同壞人作伴。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為他說，『人取悅上帝毫無益處。』","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"「所以明智的人啊，請聽我言，","poem":1},{"lineBreak":true},{"text":"上帝絕不會作惡，","poem":1},{"lineBreak":true},{"text":"全能者絕無不義。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂按人所行的對待人，","poem":1},{"lineBreak":true},{"text":"照人所做的報應人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"上帝絕不會作惡，","poem":1},{"lineBreak":true},{"text":"全能者不會顛倒是非。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"誰曾派祂治理大地，","poem":1},{"lineBreak":true},{"text":"讓祂掌管整個世界呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"上帝若決定收回自己的靈和氣，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"所有生命將一同滅亡，","poem":1},{"lineBreak":true},{"text":"世人也將歸回塵土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"「你若明理，請聽我言，","poem":1},{"lineBreak":true},{"text":"側耳聽我說。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"憎惡正義的豈可掌權？","poem":1},{"lineBreak":true},{"text":"你要譴責公義的大能者嗎？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂可以稱君王為廢物，","poem":1},{"lineBreak":true},{"text":"稱權貴為惡徒。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂不偏袒王侯，","poem":1},{"lineBreak":true},{"text":"也不輕貧重富，","poem":1},{"lineBreak":true},{"text":"因為他們都是祂親手造的。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他們夜半猝然死去，","poem":1},{"lineBreak":true},{"text":"百姓震顫，繼而消逝，","poem":1},{"lineBreak":true},{"text":"權貴也被剷除，非藉人手。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"祂注目世人所行之道，","poem":1},{"lineBreak":true},{"text":"察看他們走的每一步。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"沒有黑暗和陰影可供作惡者藏身。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"祂不必再三察驗，","poem":1},{"lineBreak":true},{"text":"把人召到面前審判。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"祂擊垮權貴無需審查，","poem":1},{"lineBreak":true},{"text":"另立他人取而代之。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"祂知道他們的行為，","poem":1},{"lineBreak":true},{"text":"祂使他們在夜間傾覆、滅亡。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"祂當眾擊打他們，","poem":1},{"lineBreak":true},{"text":"正如擊打惡人。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"因為他們離棄祂，","poem":1},{"lineBreak":true},{"text":"無視祂的正道，","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"以致窮人的呼求傳到祂那裡，","poem":1},{"lineBreak":true},{"text":"祂也聽見了困苦者的呼求。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"但祂若保持緘默，誰能定祂有罪？","poem":1},{"lineBreak":true},{"text":"祂若掩起臉來，誰能看得見祂？","poem":1},{"lineBreak":true},{"text":"個人和國家都靠祂垂顧，","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"以免不敬虔者做王，","poem":1},{"lineBreak":true},{"text":"禍國殃民。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"「有誰對上帝說，","poem":1},{"lineBreak":true},{"text":"『我受了管教，不會再犯罪；","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我不明白的事，求你指教我；","poem":1},{"lineBreak":true},{"text":"我若行了惡事，必不再行』？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"難道因為你拒絕接受，","poem":1},{"lineBreak":true},{"text":"上帝就要迎合你的要求嗎？","poem":1},{"lineBreak":true},{"text":"要做抉擇的是你，而非我，","poem":1},{"lineBreak":true},{"text":"請說說你的高見。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"明達的人和聽我發言的智者都會說，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"『約伯所言毫無知識，","poem":1},{"lineBreak":true},{"text":"他的話沒有智慧。』","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"願約伯被試煉到底，","poem":1},{"lineBreak":true},{"text":"因為他的回答如惡人之言。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"他的叛逆使他罪上加罪，","poem":1},{"lineBreak":true},{"text":"他在我們中間拍手譏笑，","poem":1},{"lineBreak":true},{"text":"用許多話褻瀆上帝。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}