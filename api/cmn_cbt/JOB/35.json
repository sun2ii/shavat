{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["以利戶又說："]},{"type":"verse","number":2,"content":[{"text":"「你在上帝面前自以為義，","poem":1},{"lineBreak":true},{"text":"你認為這合理嗎？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你還說，『這與我何干？","poem":1},{"lineBreak":true},{"text":"我不犯罪又有何益處？』","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要答覆你和你的朋友。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要抬頭觀看諸天，","poem":1},{"lineBreak":true},{"text":"瞻望頭頂的穹蒼。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你若犯罪，與上帝何妨？","poem":1},{"lineBreak":true},{"text":"你若罪惡纍纍，對祂有何影響？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你若為人公義，與祂何益？","poem":1},{"lineBreak":true},{"text":"祂從你手上能得什麼好處？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你的罪惡只能傷害你的同類，","poem":1},{"lineBreak":true},{"text":"你的公義只能令世人受益。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"「人們因飽受壓迫而呼求，","poem":1},{"lineBreak":true},{"text":"因強權者的壓制而求救。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"但無人問，『創造我的上帝在哪裡？","poem":1},{"lineBreak":true},{"text":"祂使人夜間歡唱，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"使我們比地上的走獸聰明，","poem":1},{"lineBreak":true},{"text":"比天上的飛鳥有智慧。』","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們因惡人的囂張而呼求，","poem":1},{"lineBreak":true},{"text":"上帝卻不回答。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"上帝必不垂聽虛妄的呼求，","poem":1},{"lineBreak":true},{"text":"全能者必不理會。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"更何況你說你看不見祂，","poem":1},{"lineBreak":true},{"text":"你的案子已呈上，在等祂裁決。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你還說祂沒有發怒降罰，","poem":1},{"lineBreak":true},{"text":"也毫不理會罪惡。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"約伯啊，你說的盡是虛言，","poem":1},{"lineBreak":true},{"text":"講了一堆無知的話。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}