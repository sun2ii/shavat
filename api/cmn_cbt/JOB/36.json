{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["以利戶又說："]},{"type":"verse","number":2,"content":[{"text":"「再給我片刻，容我講明，","poem":1},{"lineBreak":true},{"text":"我還有話替上帝說。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我要旁徵博引，","poem":1},{"lineBreak":true},{"text":"證明我的創造主公義。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的話絕非虛言，","poem":1},{"lineBreak":true},{"text":"知識全備者在你身旁。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"「上帝有大能，但不藐視人，","poem":1},{"lineBreak":true},{"text":"祂無所不知。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂不容惡人活命，","poem":1},{"lineBreak":true},{"text":"祂為窮苦人伸冤。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂時時看顧義人，","poem":1},{"lineBreak":true},{"text":"使他們與君王同坐寶座，","poem":1},{"lineBreak":true},{"text":"永遠受尊崇。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們若被鎖鏈捆綁，","poem":1},{"lineBreak":true},{"text":"被苦難的繩索纏住，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂就會指明他們的所作所為，","poem":1},{"lineBreak":true},{"text":"讓他們知道自己狂妄的罪愆。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂開啟他們的耳朵，使之受教，","poem":1},{"lineBreak":true},{"text":"督促他們離開罪惡。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們若聽從、事奉祂，","poem":1},{"lineBreak":true},{"text":"就可一生幸福，安享天年。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"否則，他們必死於刀下，","poem":1},{"lineBreak":true},{"text":"在無知中滅亡。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"不信上帝的人心存憤怒，","poem":1},{"lineBreak":true},{"text":"被上帝捆綁也不求救。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們早年喪命，","poem":1},{"lineBreak":true},{"text":"與廟中的男妓一同夭亡。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"上帝藉苦難拯救受苦的人，","poem":1},{"lineBreak":true},{"text":"藉患難開通他們的耳朵。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"祂也要引領你脫離困境，","poem":1},{"lineBreak":true},{"text":"進入廣闊自由之地，","poem":1},{"lineBreak":true},{"text":"使你享受滿桌佳餚。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"「但你飽受惡人當得的審判，","poem":1},{"lineBreak":true},{"text":"審判和懲罰臨到了你。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"當心，不可因憤怒而嘲罵，","poem":1},{"lineBreak":true},{"text":"不可因贖金大就偏離正道。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"難道你呼求、使出渾身力氣，","poem":1},{"lineBreak":true},{"text":"就能脫離困境嗎？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"不要渴望黑夜來臨，","poem":1},{"lineBreak":true},{"text":"那時眾民在家中消亡。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"當心，不可轉向罪惡，","poem":1},{"lineBreak":true},{"text":"因你喜歡罪惡勝於苦難。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"看啊，上帝的能力無以倫比。","poem":1},{"lineBreak":true},{"text":"誰能像祂那樣賜人教誨？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"誰能為祂指定道路？","poem":1},{"lineBreak":true},{"text":"誰能說祂行事不義？","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"人們都歌唱祂的作為，","poem":1},{"lineBreak":true},{"text":"你也要記得頌揚。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"祂的作為，天下人都已看見，","poem":1},{"lineBreak":true},{"text":"世人從遠處目睹。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我們無法明白上帝的偉大，","poem":1},{"lineBreak":true},{"text":"祂的年歲無法數算。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"祂吸取水滴，","poem":1},{"lineBreak":true},{"text":"使之在雲霧中化為雨，","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"從雲端沛然降下，","poem":1},{"lineBreak":true},{"text":"滋潤人間。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"誰能明白雲層的鋪展，","poem":1},{"lineBreak":true},{"text":"及祂幔幕發出的雷聲？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"祂在四圍鋪展閃電，","poem":1},{"lineBreak":true},{"text":"覆蓋大海的深處。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"祂藉此治理萬民，","poem":1},{"lineBreak":true},{"text":"賜下豐富的食物。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"祂手握閃電，","poem":1},{"lineBreak":true},{"text":"令它射向目標。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"雷聲顯明祂的作為，","poem":1},{"lineBreak":true},{"text":"就連牲畜也能察覺。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}