{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"「因此我心戰慄，","poem":1},{"lineBreak":true},{"text":"在胸膛跳動。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"請仔細聽祂發出的雷聲，","poem":1},{"lineBreak":true},{"text":"聽祂口中發出的轟鳴。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂使閃電劃過整個天空，","poem":1},{"lineBreak":true},{"text":"亮光直照到地極。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"隨後雷聲隆隆，","poem":1},{"lineBreak":true},{"text":"祂發出威嚴之聲。","poem":1},{"lineBreak":true},{"text":"祂一發聲，雷電交加。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝發出奇妙的雷聲，","poem":1},{"lineBreak":true},{"text":"我們無法測度祂偉大的作為。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂命雪降在大地，","poem":1},{"lineBreak":true},{"text":"令雨傾盆倒下，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"使人們停下工作，","poem":1},{"lineBreak":true},{"text":"以便世人都知道祂的作為。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"野獸躲進窩裡，","poem":1},{"lineBreak":true},{"text":"留在洞中。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"暴風從南天而來，","poem":1},{"lineBreak":true},{"text":"寒流由北方而至。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝噓氣成冰，","poem":1},{"lineBreak":true},{"text":"使寬闊的水面凝結。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂使密雲佈滿水氣，","poem":1},{"lineBreak":true},{"text":"從雲端發出閃電。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"雲隨祂的指令旋轉，","poem":1},{"lineBreak":true},{"text":"在地面遵行祂的吩咐，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"或為懲罰大地，","poem":1},{"lineBreak":true},{"text":"或為彰顯慈愛。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"「約伯啊，請留心聽，","poem":1},{"lineBreak":true},{"text":"要駐足沉思上帝的奇妙作為。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你知道上帝如何發出命令，","poem":1},{"lineBreak":true},{"text":"使雲中電光閃爍嗎？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你知道全知者的奇妙作為——","poem":1},{"lineBreak":true},{"text":"祂如何使雲彩飄浮嗎？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"南風吹來，大地沉寂時，","poem":1},{"lineBreak":true},{"text":"你就汗濕衣襟，你知道為何嗎？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你能像祂那樣鋪展堅如銅鏡的穹蒼嗎？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我們因愚昧而無法陳訴，","poem":1},{"lineBreak":true},{"text":"請指教我們如何與祂對話。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我怎敢與祂對話？","poem":1},{"lineBreak":true},{"text":"豈有人自取滅亡？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"風吹散天空的雲後，","poem":1},{"lineBreak":true},{"text":"無人能仰視太陽的強光。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"北方出現金色的光芒，","poem":1},{"lineBreak":true},{"text":"上帝充滿可怕的威嚴。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我們無法測度全能者，","poem":1},{"lineBreak":true},{"text":"祂充滿能力，無比正直公義，","poem":1},{"lineBreak":true},{"text":"不恃強凌弱。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"所以，人們都敬畏祂，","poem":1},{"lineBreak":true},{"text":"祂不看顧自以為有智慧的人。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}