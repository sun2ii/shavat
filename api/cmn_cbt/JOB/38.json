{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":38,"content":[{"type":"heading","content":["耶和華回答約伯"]},{"type":"verse","number":1,"content":[{"text":"那時，耶和華從旋風中對約伯說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"「是誰用無知的話蒙蔽我的旨意？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你要像勇士一樣束腰備戰，","poem":1},{"lineBreak":true},{"text":"我來提問，你來回答。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"「我立大地根基的時候，你在哪裡？","poem":1},{"lineBreak":true},{"text":"你若那麼聰明，請告訴我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你可知道誰為大地定的尺寸？","poem":1},{"lineBreak":true},{"text":"誰用準繩把它丈量？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"是什麼支撐大地的根基？","poem":1},{"lineBreak":true},{"text":"誰為它安放的基石？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"當時晨星齊聲歌唱，","poem":1},{"lineBreak":true},{"text":"眾天使都發出歡呼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"「大海從母胎奔騰而出時，","poem":1},{"lineBreak":true},{"text":"誰為它劃定界限？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"是我為大海披上雲彩，","poem":1},{"lineBreak":true},{"text":"為它裹上厚厚的幽暗。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"是我為它劃定界限，","poem":1},{"lineBreak":true},{"text":"並安上門和閂，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"說，『你到此為止，不可越界；","poem":1},{"lineBreak":true},{"text":"你狂傲的波濤要停在這裡。』","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"「你生平可曾向晨曦發號施令，","poem":1},{"lineBreak":true},{"text":"為黎明的曙光指定崗位，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"使陽光普照大地，","poem":1},{"lineBreak":true},{"text":"抖出藏匿的惡人？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"日光使大地改觀，如泥上蓋印，","poem":1},{"lineBreak":true},{"text":"萬物如衣服般顯出顏色。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"惡人得不到光明，","poem":1},{"lineBreak":true},{"text":"強橫的臂膀必折斷。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你可曾到過大海的源頭，","poem":1},{"lineBreak":true},{"text":"走過深淵的底部？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"死亡之門可曾向你顯露？","poem":1},{"lineBreak":true},{"text":"你可曾見過幽冥之門？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你知道大地有多廣闊嗎？","poem":1},{"lineBreak":true},{"text":"你若全知道，就告訴我吧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"「哪條路通往光明的居所？","poem":1},{"lineBreak":true},{"text":"哪裡是黑暗的住處？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你能把它們帶回原處嗎？","poem":1},{"lineBreak":true},{"text":"你認識通往其居所的路嗎？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你肯定知道，","poem":1},{"lineBreak":true},{"text":"因為那時你已出生，","poem":1},{"lineBreak":true},{"text":"你的壽數又很長久！","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"「你曾到過雪庫，","poem":1},{"lineBreak":true},{"text":"或見過雹倉嗎？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"那是我為降災之時，","poem":1},{"lineBreak":true},{"text":"為爭戰之日而預備的。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"光從哪條路散開？","poem":1},{"lineBreak":true},{"text":"東風從哪條路吹遍大地？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"誰為豪雨開水道，","poem":1},{"lineBreak":true},{"text":"為雷電闢路徑，","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"使雨水降在杳無人煙之地，","poem":1},{"lineBreak":true},{"text":"降在無人居住的曠野，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"以滋潤荒涼不毛之地，","poem":1},{"lineBreak":true},{"text":"使土地長出青草？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"雨水有父親嗎？","poem":1},{"lineBreak":true},{"text":"誰生的露珠？","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"冰出自誰的胎？","poem":1},{"lineBreak":true},{"text":"誰生的天上的霜？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"水變得堅硬如石，","poem":1},{"lineBreak":true},{"text":"深淵表面凝結成冰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"「你能繫住昴星的結，","poem":1},{"lineBreak":true},{"text":"解開參星的帶嗎？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"你能按季節領出星座，","poem":1},{"lineBreak":true},{"text":"引導北斗及其眾星嗎？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"你知道天的定律嗎？","poem":1},{"lineBreak":true},{"text":"你能使地服從天律嗎？","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你能號令雲彩，","poem":1},{"lineBreak":true},{"text":"使傾盆大雨覆蓋你嗎？","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"你能命閃電發出，","poem":1},{"lineBreak":true},{"text":"讓它聽候調遣嗎？","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"誰將智慧放在人胸中？","poem":1},{"lineBreak":true},{"text":"誰使人內心有聰明？","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"塵土結成硬團，","poem":1},{"lineBreak":true},{"text":"土塊黏在一起時，","poem":1},{"lineBreak":true},{"text":"誰能憑智慧數算雲彩？","poem":1},{"lineBreak":true},{"text":"誰能傾倒天上的水囊？","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"「獅子臥在洞中，","poem":1},{"lineBreak":true},{"text":"猛獅埋伏在隱秘處，","poem":1},{"lineBreak":true},{"text":"你能為牠們獵取食物，","poem":1},{"lineBreak":true},{"text":"使牠們飽餐嗎？","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"烏鴉的幼雛餓得飛來飛去，","poem":1},{"lineBreak":true},{"text":"向上帝哀鳴時，","poem":1},{"lineBreak":true},{"text":"誰供應烏鴉食物？","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":39}