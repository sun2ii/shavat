{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"「你知道野山羊何時生產嗎？","poem":1},{"lineBreak":true},{"text":"你看過母鹿產仔嗎？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你能算出牠們懷胎的月數嗎？","poem":1},{"lineBreak":true},{"text":"你知道牠們分娩的日期嗎？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"牠們屈身產仔，","poem":1},{"lineBreak":true},{"text":"結束分娩之痛。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"幼仔健壯，在荒野長大，","poem":1},{"lineBreak":true},{"text":"離群而去，不再回來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"「誰讓野驢逍遙自在？","poem":1},{"lineBreak":true},{"text":"誰解開了牠的韁繩？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我使牠以曠野為家，","poem":1},{"lineBreak":true},{"text":"以鹽地作居所。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"牠嗤笑城邑的喧鬧，","poem":1},{"lineBreak":true},{"text":"不聽趕牲口的吆喝。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"牠以群山作牧場，","poem":1},{"lineBreak":true},{"text":"尋找各種青草。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"「野牛豈肯為你效勞，","poem":1},{"lineBreak":true},{"text":"在你的槽旁過夜？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你豈能用韁繩把野牛牽到犁溝？","poem":1},{"lineBreak":true},{"text":"牠豈肯跟著你在山谷耕地？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你豈能倚靠牠的大力，","poem":1},{"lineBreak":true},{"text":"把你的重活交給牠？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"豈能靠牠運回糧食，","poem":1},{"lineBreak":true},{"text":"替你堆聚到麥場？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"「鴕鳥歡然拍動翅膀，","poem":1},{"lineBreak":true},{"text":"牠豈有白鸛的翎羽？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"牠將蛋產在地上，","poem":1},{"lineBreak":true},{"text":"使蛋得到沙土的溫暖，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"卻不知蛋會被踩碎，","poem":1},{"lineBreak":true},{"text":"或遭野獸踐踏。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"牠苛待雛鳥，好像牠們並非己出，","poem":1},{"lineBreak":true},{"text":"就算徒勞一場，牠也不怕。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因為上帝未賜牠智慧，","poem":1},{"lineBreak":true},{"text":"沒有給牠悟性。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"然而，一旦牠展翅奔跑，","poem":1},{"lineBreak":true},{"text":"必嗤笑馬兒和騎士。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"「馬的力量豈是你賜的？","poem":1},{"lineBreak":true},{"text":"牠頸上的鬃毛豈是你披的？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"豈是你使牠跳躍如蝗蟲，","poem":1},{"lineBreak":true},{"text":"發出令人膽寒的長嘶？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"牠在谷中刨地，","poem":1},{"lineBreak":true},{"text":"炫耀力量，奮力衝向敵軍。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"牠嘲笑恐懼，毫不害怕，","poem":1},{"lineBreak":true},{"text":"不因刀劍而退縮。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"牠背上的箭袋錚錚作響，","poem":1},{"lineBreak":true},{"text":"長矛和標槍閃閃發光。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"角聲一響，牠便無法靜立，","poem":1},{"lineBreak":true},{"text":"異常亢奮，急於馳騁大地。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"聽到角聲，牠就發出長嘶，","poem":1},{"lineBreak":true},{"text":"牠老遠便嗅到戰爭的氣味，","poem":1},{"lineBreak":true},{"text":"並聽見吶喊和將領的號令。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"「鷹隼展翅翱翔，飛往南方，","poem":1},{"lineBreak":true},{"text":"豈是靠你的智慧？","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"禿鷹騰飛，在高處搭窩，","poem":1},{"lineBreak":true},{"text":"豈是奉你的命令？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"牠居住在懸崖上，","poem":1},{"lineBreak":true},{"text":"盤踞在山巖峭壁，","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"牠從那裡搜尋獵物，","poem":1},{"lineBreak":true},{"text":"牠的目光直達遠方。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"牠的幼雛噬血，","poem":1},{"lineBreak":true},{"text":"哪裡有屍體，牠就在哪裡。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}