{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":4,"content":[{"type":"heading","content":["以利法的責難"]},{"type":"verse","number":1,"content":["提幔人以利法回答說："]},{"type":"verse","number":2,"content":[{"text":"「若有人向你進言，","poem":1},{"lineBreak":true},{"text":"你會厭煩嗎？","poem":1},{"lineBreak":true},{"text":"可是，誰能忍住不說呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你曾教導許多人，","poem":1},{"lineBreak":true},{"text":"使無力的手強壯。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的話使人免於跌倒，","poem":1},{"lineBreak":true},{"text":"你使顫抖的膝硬朗。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但現在苦難一來，","poem":1},{"lineBreak":true},{"text":"你便灰心喪膽；","poem":1},{"lineBreak":true},{"text":"災禍來臨，","poem":1},{"lineBreak":true},{"text":"你便驚慌失措。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你敬畏上帝還沒有信心嗎？","poem":1},{"lineBreak":true},{"text":"你行為純全還沒有盼望嗎？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你想一想，","poem":1},{"lineBreak":true},{"text":"哪有無辜的人滅亡？","poem":1},{"lineBreak":true},{"text":"哪有正直的人遭殃？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"據我所見，","poem":1},{"lineBreak":true},{"text":"播惡收惡，","poem":1},{"lineBreak":true},{"text":"種禍得禍。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們被上帝的氣息所毀，","poem":1},{"lineBreak":true},{"text":"被上帝的怒氣所滅。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"獅子咆哮，猛獅吼叫，","poem":1},{"lineBreak":true},{"text":"雄獅的牙齒被敲掉。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"雄獅因無食而死，","poem":1},{"lineBreak":true},{"text":"母獅的幼崽離散。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"「有信息暗暗地傳給我，","poem":1},{"lineBreak":true},{"text":"一聲低語傳入我耳中。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"夜間人們沉睡的時候，","poem":1},{"lineBreak":true},{"text":"在攪擾思緒的異象中，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"恐懼襲來，","poem":1},{"lineBreak":true},{"text":"令我戰慄不已，","poem":1},{"lineBreak":true},{"text":"全身發抖。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"有靈從我臉上拂過，","poem":1},{"lineBreak":true},{"text":"使我毛骨悚然。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"那靈停住，","poem":1},{"lineBreak":true},{"text":"我無法辨認其模樣。","poem":1},{"lineBreak":true},{"text":"眼前出現一個形狀，","poem":1},{"lineBreak":true},{"text":"寂靜中聽見有聲音說，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"『在上帝面前，世人豈算得上公義？","poem":1},{"lineBreak":true},{"text":"在創造主面前，凡人豈算得上純潔？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"連上帝的僕人都無法令祂信任，","poem":1},{"lineBreak":true},{"text":"連祂的天使都被祂找出過錯，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"更何況那源自塵土、","poem":1},{"lineBreak":true},{"text":"住在土造的軀殼裡、","poem":1},{"lineBreak":true},{"text":"脆弱如蛾蟲的世人呢？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"早晚之間，他們便被毀滅，","poem":1},{"lineBreak":true},{"text":"永遠消逝，無人察覺。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他們帳篷的繩索拔掉了，","poem":1},{"lineBreak":true},{"text":"他們昏昏聵聵地死去。』","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}