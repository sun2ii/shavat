{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["耶和華又對約伯說："]},{"type":"verse","number":2,"content":[{"text":"「強辯者豈可與全能者爭論？","poem":1},{"lineBreak":true},{"text":"與上帝辯駁的人請作出答覆。」","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"約伯回答耶和華說：","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"「我這樣卑微，怎能答覆你？","poem":1},{"lineBreak":true},{"text":"我只有用手掩口。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我說了一次，不能答覆；","poem":1},{"lineBreak":true},{"text":"說了兩次，不敢再說。」","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"那時，耶和華從旋風中對約伯說：","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"「你要像勇士一樣束腰備戰，","poem":1},{"lineBreak":true},{"text":"我來提問，你來回答。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你要推翻我的公義，","poem":1},{"lineBreak":true},{"text":"歸罪於我而自以為義嗎？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你有上帝那樣的臂膀嗎？","poem":1},{"lineBreak":true},{"text":"你能像祂那樣發出雷鳴嗎？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"請展示你的榮耀和光輝，","poem":1},{"lineBreak":true},{"text":"披上你的尊榮和威嚴；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"發洩你滿腔的怒火，","poem":1},{"lineBreak":true},{"text":"鑒察一切驕傲的人，貶抑他們；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"鑒察一切驕傲的人，貶低他們，","poem":1},{"lineBreak":true},{"text":"將惡人原地踐踏；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"將他們一起埋進塵土，","poem":1},{"lineBreak":true},{"text":"藏入幽冥。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"這樣，我就承認你的右手能拯救自己。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"「你看河馬，","poem":1},{"lineBreak":true},{"text":"牠和你都是我造的，","poem":1},{"lineBreak":true},{"text":"牠像牛一樣吃草。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你看牠腰間的氣力，","poem":1},{"lineBreak":true},{"text":"牠腹部肌肉的力量。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"牠尾巴挺直如香柏樹，","poem":1},{"lineBreak":true},{"text":"大腿的筋緊密相連，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"骨頭如銅管，","poem":1},{"lineBreak":true},{"text":"四肢像鐵棍。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"牠是上帝創造的傑作，","poem":1},{"lineBreak":true},{"text":"創造主賜給牠利刃","poem":1},{"noteId":17},{"text":"。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"群山供應牠食物，","poem":1},{"lineBreak":true},{"text":"百獸在那裡玩耍。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"牠躺在蓮葉之下，","poem":1},{"lineBreak":true},{"text":"藏在泥沼的蘆葦間，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"蓮葉為牠遮蔭，","poem":1},{"lineBreak":true},{"text":"溪畔的柳樹環繞牠。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"河水氾濫，牠不驚懼；","poem":1},{"lineBreak":true},{"text":"約旦河漲到牠口邊，牠也無憂。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"誰能在牠警覺時捕捉牠，","poem":1},{"lineBreak":true},{"text":"或用鉤子穿透牠的鼻子？","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":17,"caller":"+","text":"「創造主賜給牠利刃」或譯「只有創造主能持利刃接近牠」。","reference":{"chapter":40,"verse":19}}]},"thisChapterLink":"/api/cmn_cbt/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}