{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"「你豈能用魚鉤釣海怪，","poem":1},{"lineBreak":true},{"text":"用繩索綁住牠的舌頭？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你豈能用繩子穿牠的鼻子，","poem":1},{"lineBreak":true},{"text":"用鉤子穿牠的腮骨？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"牠豈會向你連連求饒，","poem":1},{"lineBreak":true},{"text":"對你說柔和的話？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"牠豈肯與你立約，","poem":1},{"lineBreak":true},{"text":"一生做你的奴隸？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你豈能拿牠當小鳥玩耍，","poem":1},{"lineBreak":true},{"text":"或拴起來給幼女取樂？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"漁夫們豈能把牠當貨物出售，","poem":1},{"lineBreak":true},{"text":"賣給商人？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你豈能在牠皮上戳滿長矛，","poem":1},{"lineBreak":true},{"text":"頭上插滿魚叉？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你動手碰碰牠，","poem":1},{"lineBreak":true},{"text":"就知道是場惡戰，絕不會再碰。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"企圖捕捉牠的都會失望，","poem":1},{"lineBreak":true},{"text":"人看到牠就會心驚膽戰。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"再兇猛的人也不敢惹牠。","poem":1},{"lineBreak":true},{"text":"這樣，誰能在我面前站立得住？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"誰給過我什麼，要我償還呢？","poem":1},{"lineBreak":true},{"text":"天下萬物都是我的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"「關於牠的四肢、大力和健美的身體，","poem":1},{"lineBreak":true},{"text":"我不能緘默不言。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"誰能剝去牠的外皮？","poem":1},{"lineBreak":true},{"text":"誰能給牠戴上轡頭？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"誰能打開牠的嘴巴？","poem":1},{"lineBreak":true},{"text":"牠的牙齒令人恐懼。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"牠的脊背覆著行行鱗甲，","poem":1},{"lineBreak":true},{"text":"牢牢地密封在一起，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"緊密無間，","poem":1},{"lineBreak":true},{"text":"連氣也透不進去。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"鱗甲彼此相連相扣，","poem":1},{"lineBreak":true},{"text":"無法分開。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"牠打噴嚏時，水光四射；","poem":1},{"lineBreak":true},{"text":"牠的眼睛亮如晨光；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"口中噴出火炬，","poem":1},{"lineBreak":true},{"text":"迸出火星；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"鼻孔冒煙，","poem":1},{"lineBreak":true},{"text":"如沸騰的鍋和燃燒的蘆葦；","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"呼氣可點燃煤炭，","poem":1},{"lineBreak":true},{"text":"口中噴出火焰；","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"頸項強而有力，","poem":1},{"lineBreak":true},{"text":"恐懼在牠前面開路；","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"身上的皺褶緊密相連，","poem":1},{"lineBreak":true},{"text":"牢牢地密封在一起；","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"心堅如石，","poem":1},{"lineBreak":true},{"text":"硬如磨石。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"牠一站起來，勇士都害怕，","poem":1},{"lineBreak":true},{"text":"見牠衝來，他們慌忙退縮。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"刀劍擋不住牠，","poem":1},{"lineBreak":true},{"text":"長矛、標槍、尖戟也無能為力。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"牠視鐵如乾草，","poem":1},{"lineBreak":true},{"text":"視銅如朽木。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"利箭嚇不跑牠，","poem":1},{"lineBreak":true},{"text":"彈石在牠看來只是碎稭；","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"棍棒無異於稭稈，","poem":1},{"lineBreak":true},{"text":"牠嗤笑投來的標槍。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"牠腹部有鋒利的瓦片，","poem":1},{"lineBreak":true},{"text":"在淤泥上留下道道耙痕。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"牠使深淵如鍋翻騰，","poem":1},{"lineBreak":true},{"text":"使大海如油鍋滾動。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"牠游過後留下一道波光，","poem":1},{"lineBreak":true},{"text":"使深淵彷彿披上銀髮。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"地上沒有動物能與牠相比，","poem":1},{"lineBreak":true},{"text":"像牠那樣無所畏懼。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"牠藐視群雄，","poem":1},{"lineBreak":true},{"text":"在高傲的百獸中稱王。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}