{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"「你只管呼救吧，","poem":1},{"lineBreak":true},{"text":"誰會回應你呢？","poem":1},{"lineBreak":true},{"text":"你向哪位聖者求助呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"憤恨害死愚昧人，","poem":1},{"lineBreak":true},{"text":"嫉妒殺死無知者。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我見愚昧人扎了根，","poem":1},{"lineBreak":true},{"text":"突然咒詛臨到他家。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他的兒女毫無安寧，","poem":1},{"lineBreak":true},{"text":"在城門口受欺壓也無人搭救。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"饑餓的人吞掉他的莊稼，","poem":1},{"lineBreak":true},{"text":"連荊棘裡的也不放過；","poem":1},{"lineBreak":true},{"text":"乾渴的人吞盡他的財富。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"苦難並非從土裡長出，","poem":1},{"lineBreak":true},{"text":"患難並非從地裡生出。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"人生來必遇患難，","poem":1},{"lineBreak":true},{"text":"正如火花必向上飛。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"「若是我，","poem":1},{"lineBreak":true},{"text":"就向上帝求助，","poem":1},{"lineBreak":true},{"text":"向祂陳明苦衷。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂行的奇事不可測度，","poem":1},{"lineBreak":true},{"text":"祂行的神蹟不可勝數。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂降下雨水澆灌大地，","poem":1},{"lineBreak":true},{"text":"賜下甘霖滋潤田園。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂提拔卑微的人，","poem":1},{"lineBreak":true},{"text":"庇護哀痛的人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂挫敗狡猾人的陰謀，","poem":1},{"lineBreak":true},{"text":"使他們無法得逞。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂使智者中了自己的詭計，","poem":1},{"lineBreak":true},{"text":"使奸徒的計謀迅速落空。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們白天遇到黑暗，","poem":1},{"lineBreak":true},{"text":"午間摸索如在夜晚。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"上帝拯救窮苦人脫離惡人的中傷，","poem":1},{"lineBreak":true},{"text":"脫離殘暴之徒的轄制，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"好使貧寒之人有盼望，","poem":1},{"lineBreak":true},{"text":"使不義之徒啞口無言。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"「被上帝責備的人有福了，","poem":1},{"lineBreak":true},{"text":"不可輕視全能者的管教。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因為祂打傷，祂也包紮；","poem":1},{"lineBreak":true},{"text":"祂擊傷，祂也伸手醫治。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"六次遭難，祂都救你；","poem":1},{"lineBreak":true},{"text":"第七次，災禍也傷不到你。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"饑荒時，祂必救你脫離死亡；","poem":1},{"lineBreak":true},{"text":"戰爭中，祂必救你脫離刀劍。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你必免受惡毒的譭謗，","poem":1},{"lineBreak":true},{"text":"災難來臨也不懼怕。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你必笑對災殃和饑荒，","poem":1},{"lineBreak":true},{"text":"毫不懼怕地上的野獸。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你必與田間的石頭立約，","poem":1},{"lineBreak":true},{"text":"野獸必與你和平相處。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你必知道家裡安然無恙，","poem":1},{"lineBreak":true},{"text":"察看羊圈，一隻不少。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你必知道子孫昌盛，","poem":1},{"lineBreak":true},{"text":"後代如遍地的青草。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你必壽終正寢才歸墳墓，","poem":1},{"lineBreak":true},{"text":"如同莊稼熟後才被收割。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"看啊，我們已經查驗了，","poem":1},{"lineBreak":true},{"text":"這一切真實可靠，","poem":1},{"lineBreak":true},{"text":"你當聆聽並學以致用。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}