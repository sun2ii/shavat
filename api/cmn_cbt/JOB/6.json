{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":6,"content":[{"type":"heading","content":["約伯自述無辜"]},{"type":"verse","number":1,"content":["約伯回答說："]},{"type":"verse","number":2,"content":[{"text":"「要是能稱量我的苦難，","poem":1},{"lineBreak":true},{"text":"把我的災殃放在秤上，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"那將比海沙還重；","poem":1},{"lineBreak":true},{"text":"所以我言語魯莽。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因為全能者的箭射中我，","poem":1},{"lineBreak":true},{"text":"箭毒侵蝕我的靈，","poem":1},{"lineBreak":true},{"text":"祂使恐懼列隊襲來。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"野驢有草豈會叫喚？","poem":1},{"lineBreak":true},{"text":"牛有飼料豈會哞叫？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"淡食無鹽豈可下嚥？","poem":1},{"lineBreak":true},{"text":"蛋清有什麼滋味呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我碰都不想碰，","poem":1},{"lineBreak":true},{"text":"它們令我噁心。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"唯願我的祈求蒙應允，","poem":1},{"lineBreak":true},{"text":"願上帝成全我的冀望，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"願祂壓碎我，","poem":1},{"lineBreak":true},{"text":"伸手毀滅我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"這樣，我還能感到欣慰，","poem":1},{"lineBreak":true},{"text":"在殘酷的痛苦中雀躍，","poem":1},{"lineBreak":true},{"text":"因我沒有違背聖者之言。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我有何力量可以支撐下去？","poem":1},{"lineBreak":true},{"text":"有何前景讓我忍耐下去？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我的力量豈能堅如石？","poem":1},{"lineBreak":true},{"text":"我豈是銅造之軀？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我毫無自救之力，","poem":1},{"lineBreak":true},{"text":"已到窮途末路。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"「即使絕望者拋棄對上帝的敬畏，","poem":1},{"lineBreak":true},{"text":"也應該得到朋友的恩待。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的弟兄難以信賴，","poem":1},{"lineBreak":true},{"text":"如同季節河，","poem":1},{"lineBreak":true},{"text":"又像乾涸的河床——","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"結冰後顏色發黑，","poem":1},{"lineBreak":true},{"text":"融雪後水流漲溢；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"水流在乾季時消失，","poem":1},{"lineBreak":true},{"text":"河床在烈日下乾涸。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"商隊偏離路線來找水喝，","poem":1},{"lineBreak":true},{"text":"結果在荒漠中死去。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"提瑪的商隊來找水喝，","poem":1},{"lineBreak":true},{"text":"示巴的旅客指望解渴，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"結果希望化為泡影，","poem":1},{"lineBreak":true},{"text":"到了那裡大失所望。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你們同樣也幫不了我，","poem":1},{"lineBreak":true},{"text":"你們看見災禍便害怕。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我何嘗對你們說過，","poem":1},{"lineBreak":true},{"text":"『請你們供應我，","poem":1},{"lineBreak":true},{"text":"把你們的財產給我一份，","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"從仇敵手中拯救我，","poem":1},{"lineBreak":true},{"text":"從殘暴之徒手中救贖我』？","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"「請多賜教，我會閉口不言；","poem":1},{"lineBreak":true},{"text":"請指出我錯在何處。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"忠言何等逆耳！","poem":1},{"lineBreak":true},{"text":"但你們的指責有何根據？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你們既視絕望者的話如風，","poem":1},{"lineBreak":true},{"text":"還要來糾正嗎？","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你們甚至抽籤得孤兒，","poem":1},{"lineBreak":true},{"text":"把朋友當貨物賣掉。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"懇請你們看著我，","poem":1},{"lineBreak":true},{"text":"我在你們面前撒過謊嗎？","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"請三思而行，不可不公正；","poem":1},{"lineBreak":true},{"text":"請重新考慮，因我誠實無過。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我豈會說詭詐之言？","poem":1},{"lineBreak":true},{"text":"我豈會是非不辨？","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}