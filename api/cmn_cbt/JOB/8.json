{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":8,"content":[{"type":"heading","content":["比勒達發言"]},{"type":"verse","number":1,"content":["書亞人比勒達回答說："]},{"type":"verse","number":2,"content":[{"text":"「你要這樣絮叨到何時？","poem":1},{"lineBreak":true},{"text":"你的話猶如陣陣狂風。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝豈會歪曲正義？","poem":1},{"lineBreak":true},{"text":"全能者豈會顛倒是非？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"如果你的兒女得罪了祂，","poem":1},{"lineBreak":true},{"text":"祂會給他們應有的懲罰。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但你若尋求上帝，","poem":1},{"lineBreak":true},{"text":"向全能者懇求；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你若純潔、正直，","poem":1},{"lineBreak":true},{"text":"祂必起身相助，","poem":1},{"lineBreak":true},{"text":"恢復你公義的家園。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你起初雖然卑微，","poem":1},{"lineBreak":true},{"text":"日後必興旺發達。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"「你要請教先輩，","poem":1},{"lineBreak":true},{"text":"探究祖先的經驗。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為我們昨天才出生，一無所知，","poem":1},{"lineBreak":true},{"text":"我們在世的日子如同掠影。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"先輩必給你教誨和指點，","poem":1},{"lineBreak":true},{"text":"向你道出明智之言。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"「蒲草無泥豈可長高？","poem":1},{"lineBreak":true},{"text":"蘆葦無水豈可茂盛？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"它們還在生長、尚未割下，","poem":1},{"lineBreak":true},{"text":"已比百草先枯萎。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"忘記上帝的人，結局也是如此；","poem":1},{"lineBreak":true},{"text":"不信上帝的人，盼望終必破滅。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他所仰仗的虛若游絲，","poem":1},{"lineBreak":true},{"text":"他所倚靠的誠如蛛網。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他倚靠它，它卻支撐不住；","poem":1},{"lineBreak":true},{"text":"他抓緊它，它卻脆弱不穩。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他像陽光下生機勃勃的植物，","poem":1},{"lineBreak":true},{"text":"枝條爬滿了園囿，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"根莖盤繞石堆，","poem":1},{"lineBreak":true},{"text":"深深扎入石縫。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"一旦他被連根拔起，","poem":1},{"lineBreak":true},{"text":"原處必否認見過他。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他的生命就這樣消逝","poem":1},{"noteId":1},{"text":"，","poem":1},{"lineBreak":true},{"text":"地上會興起其他人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"「上帝絕不會拋棄純全的人，","poem":1},{"lineBreak":true},{"text":"也不會扶持邪惡的人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"祂要使你笑口常開，","poem":1},{"lineBreak":true},{"text":"歡聲不斷。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"憎恨你的人必抱愧蒙羞，","poem":1},{"lineBreak":true},{"text":"惡人的帳篷必不復存在。」","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"「他的生命就這樣消逝」或譯「這就是他一生的樂趣」。","reference":{"chapter":8,"verse":19}}]},"thisChapterLink":"/api/cmn_cbt/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}