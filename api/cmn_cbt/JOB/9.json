{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cbt","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"3aa72174529879f59c9c24a590c7f512dafc69fc78e843aed0f93864112147ea","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cbt/JOB/42.json","totalNumberOfVerses":1068},"chapter":{"number":9,"content":[{"type":"heading","content":["約伯的回應"]},{"type":"verse","number":1,"content":["約伯回答說："]},{"type":"verse","number":2,"content":[{"text":"「不錯，我知道你所言不虛，","poem":1},{"lineBreak":true},{"text":"但人怎能在上帝面前算為義人？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人若想與祂辯駁，","poem":1},{"lineBreak":true},{"text":"千次也不能勝一次。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂充滿智慧，能力無比，","poem":1},{"lineBreak":true},{"text":"誰能抗拒祂還能平安無恙？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂可猝然挪動群山，","poem":1},{"lineBreak":true},{"text":"在怒氣中把山翻倒。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂震動大地，使其挪位，","poem":1},{"lineBreak":true},{"text":"以致地的支柱搖撼。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂一聲令下，","poem":1},{"lineBreak":true},{"text":"太陽便不再升起，","poem":1},{"lineBreak":true},{"text":"眾星也不再發光。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂獨自鋪展穹蒼，","poem":1},{"lineBreak":true},{"text":"步行在海浪之上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂創造了北斗星、參星、昴星及南天的星座。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂行的奇事不可測度，","poem":1},{"lineBreak":true},{"text":"奇蹟不可勝數。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂經過我身旁，我卻看不見；","poem":1},{"lineBreak":true},{"text":"祂從旁邊掠過，我也無法察覺。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂若奪取，誰能阻擋？","poem":1},{"lineBreak":true},{"text":"誰敢問祂，『你做什麼？』","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"上帝不會忍怒不發，","poem":1},{"lineBreak":true},{"text":"海怪","poem":1},{"noteId":2},{"text":"的幫手必屈膝在祂腳前。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"「因此，我怎敢與祂辯駁？","poem":1},{"lineBreak":true},{"text":"怎敢措辭與祂理論？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我縱然無辜，也無法申訴，","poem":1},{"lineBreak":true},{"text":"只能乞求我的審判者施恩。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"即使我呼喚祂的時候，祂回應我，","poem":1},{"lineBreak":true},{"text":"我仍不相信祂會垂聽我的聲音。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂用暴風摧毀我，","poem":1},{"lineBreak":true},{"text":"無故地使我飽受創傷。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂不肯讓我喘息，","poem":1},{"lineBreak":true},{"text":"祂使我嘗盡苦頭。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"若論力量，祂甚強大；","poem":1},{"lineBreak":true},{"text":"若上公堂，誰敢傳祂？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"即使我清白無辜，我的口也會認罪；","poem":1},{"lineBreak":true},{"text":"即使我純全無過，祂也會判我有罪。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我雖純全無過，也已毫不在乎自己，","poem":1},{"lineBreak":true},{"text":"我厭惡我的生命。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因為，我認為都是一樣，","poem":1},{"lineBreak":true},{"text":"純全無過的人和惡人都會被祂毀滅。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"災禍突然奪走人命時，","poem":1},{"lineBreak":true},{"text":"祂嘲笑無辜者的遭遇。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"大地落入惡人手中，","poem":1},{"lineBreak":true},{"text":"蒙蔽審判官眼睛的不是祂是誰？","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"「我的年日比信差還快，","poem":1},{"lineBreak":true},{"text":"匆匆而過，不見幸福。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我的歲月疾馳如蒲草船，","poem":1},{"lineBreak":true},{"text":"快如急降抓食的老鷹。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"即使我說要忘掉怨恨，","poem":1},{"lineBreak":true},{"text":"拋開愁容，強顏歡笑，","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"諸多的患難仍使我懼怕，","poem":1},{"lineBreak":true},{"text":"我知道祂","poem":1},{"noteId":3},{"text":"不承認我無辜。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"既然我被定為有罪，","poem":1},{"lineBreak":true},{"text":"又何必徒然掙扎？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"即使我用雪水淨身，","poem":1},{"lineBreak":true},{"text":"用鹼水洗手，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"祂仍會把我扔進污坑，","poem":1},{"lineBreak":true},{"text":"連我的衣服也嫌棄我。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"祂並非世人，與我迥異，","poem":1},{"lineBreak":true},{"text":"我無法與祂辯駁，一起對簿公堂。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"我倆中間沒有仲裁者，","poem":1},{"lineBreak":true},{"text":"無人為我們斷定是非","poem":1},{"noteId":4},{"text":"。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"若能拿開祂責打我的刑杖，","poem":1},{"lineBreak":true},{"text":"使我不再受祂的驚嚇，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"我就會放膽發言，不必對祂心存恐懼，","poem":1},{"lineBreak":true},{"text":"但現在我卻不能這樣","poem":1},{"noteId":5},{"text":"。","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":2,"caller":"+","text":"「海怪」希伯來文是「拉哈伯」，下同26·12。","reference":{"chapter":9,"verse":13}},{"noteId":3,"caller":"+","text":"「祂」希伯來文是「你」，下同31節。","reference":{"chapter":9,"verse":28}},{"noteId":4,"caller":"+","text":"「為我們斷定是非」希伯來文是「把手按在我們身上」。","reference":{"chapter":9,"verse":33}},{"noteId":5,"caller":"+","text":"「但現在我卻不能這樣」或譯「因為我知道自己的清白」。","reference":{"chapter":9,"verse":35}}]},"thisChapterLink":"/api/cmn_cbt/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}