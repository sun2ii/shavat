{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JON","translationId":"cmn_cbt","name":"約拿書","commonName":"約拿書","title":"約拿書","order":32,"numberOfChapters":4,"sha256":"f91d6b16eb9a5d63ebd94eb0437fbc5c9dbfa1e954ec315b49b5370c5c15f3ef","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/cmn_cbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["約拿的禱告"]},{"type":"verse","number":1,"content":["約拿在魚腹中向他的上帝耶和華禱告說："]},{"type":"verse","number":2,"content":[{"text":"「耶和華啊，我遭遇患難的時候向你求告，","poem":1},{"lineBreak":true},{"text":"你就應允我。","poem":1},{"lineBreak":true},{"text":"我在陰間的深處呼求你，","poem":1},{"lineBreak":true},{"text":"你也垂聽我的聲音。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你把我拋進深海，","poem":1},{"lineBreak":true},{"text":"拋進大洋的腹地，","poem":1},{"lineBreak":true},{"text":"洋流圍困我，","poem":1},{"lineBreak":true},{"text":"你的巨浪洪濤淹沒我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我心想，我從你面前被趕走，","poem":1},{"lineBreak":true},{"text":"但我還要再瞻仰你的聖殿。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"波濤吞噬我，","poem":1},{"lineBreak":true},{"text":"深海圍困我，","poem":1},{"lineBreak":true},{"text":"海草纏繞著我的頭。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我下沉到山的根基，","poem":1},{"lineBreak":true},{"text":"大地的門閂把我永遠關住；","poem":1},{"lineBreak":true},{"text":"然而，我的上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"你卻把我的性命從深坑中拯救出來。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的生命漸漸消逝的時候，","poem":1},{"lineBreak":true},{"text":"我就想起了耶和華。","poem":1},{"lineBreak":true},{"text":"我的禱告進入你的聖殿，","poem":1},{"lineBreak":true},{"text":"達到你面前。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"那些信奉虛無神明的人，","poem":1},{"lineBreak":true},{"text":"背棄了憐愛他們的上帝","poem":1},{"noteId":0},{"text":"，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"但我要用感謝的聲音向你獻祭，","poem":1},{"lineBreak":true},{"text":"我必還我許的願，","poem":1},{"lineBreak":true},{"text":"因為救恩來自耶和華。」","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"於是，耶和華命令那條魚，","poem":1},{"lineBreak":true},{"text":"魚就把約拿吐到陸地上。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"「背棄了憐愛他們的上帝」或譯「背棄了他們對上帝的忠誠」。","reference":{"chapter":2,"verse":8}}]},"thisChapterLink":"/api/cmn_cbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}