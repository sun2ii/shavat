{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cbt","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"116b5eec352d92466c3407c484861baa5fe24f8d05cb718844c986cf0d754a57","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cbt/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["刑罰、悔改和盼望"]},{"type":"verse","number":1,"content":[{"text":"我在耶和華烈怒的杖下受盡痛苦。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"祂把我趕進黑暗，","poem":1},{"lineBreak":true},{"text":"使我行路不見光明，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"又屢屢攻擊我，終日不斷。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"祂使我皮肉枯槁，","poem":1},{"lineBreak":true},{"text":"祂折斷我的骨頭。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂使我四面受困，","poem":1},{"lineBreak":true},{"text":"嘗盡痛苦艱辛。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂使我住在幽暗中，","poem":1},{"lineBreak":true},{"text":"像久已死去的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"祂圍困我，使我無法逃脫，","poem":1},{"lineBreak":true},{"text":"祂給我戴上沉重的鎖鏈。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"即使我哀哭呼求，","poem":1},{"lineBreak":true},{"text":"祂也掩耳不聽。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂用鑿好的石頭阻擋我的去路，","poem":1},{"lineBreak":true},{"text":"使我的道路曲折難行。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"祂像埋伏的巨熊，","poem":1},{"lineBreak":true},{"text":"又像伺機突襲的猛獅，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"把我拖離大路，","poem":1},{"lineBreak":true},{"text":"撕成碎片，使我一片淒涼。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂彎弓搭箭，把我當箭靶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"祂用箭袋中的箭射穿我的心臟。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我成了萬民的笑柄，","poem":1},{"lineBreak":true},{"text":"他們終日唱歌諷刺我。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂使我飽受苦楚，嘗盡苦澀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"祂用石子硌斷我的牙齒，","poem":1},{"lineBreak":true},{"text":"把我踐踏在塵土中。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你使我失去平安，","poem":1},{"lineBreak":true},{"text":"忘記了什麼是福樂。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我說：「我精疲力竭，","poem":1},{"lineBreak":true},{"text":"對耶和華失去盼望。」","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"想起我的痛苦和漂泊流離，","poem":1},{"lineBreak":true},{"text":"就如苦艾和膽汁一樣苦澀。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"那情景縈繞心頭，","poem":1},{"lineBreak":true},{"text":"使我心情沉重。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"然而，我想起這事，","poem":1},{"lineBreak":true},{"text":"便有了盼望，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因為耶和華的慈愛永不終止，","poem":1},{"lineBreak":true},{"text":"祂的憐憫永無窮盡。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"祂的慈愛和憐憫每天早晨都是新的，","poem":1},{"lineBreak":true},{"text":"祂的信實無比偉大！","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我心裡知道，","poem":1},{"lineBreak":true},{"text":"耶和華是我的福分，","poem":1},{"lineBreak":true},{"text":"我要仰望祂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"耶和華必恩待那些等候和尋求祂的人，","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因此，默然等候耶和華的拯救是美好的。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"年輕時負軛受苦是有益的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"受耶和華管教時，","poem":1},{"lineBreak":true},{"text":"要默然獨坐。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"要謙卑地臉伏於地，","poem":1},{"lineBreak":true},{"text":"或許還有希望。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"要任人打臉，甘受凌辱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"因為主不會永遠撇棄人。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"主儘管使人憂傷，","poem":1},{"lineBreak":true},{"text":"祂依然憐憫人，","poem":1},{"lineBreak":true},{"text":"因為祂有豐盛的慈愛。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"祂不願使人憂傷、痛苦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"將囚犯踩在腳下，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"在至高者面前冤枉他人，","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"審理案件時顛倒是非，","poem":1},{"lineBreak":true},{"text":"都是主所不容許的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"若非主發命令，","poem":1},{"lineBreak":true},{"text":"誰能說成就成呢？","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"禍福豈不都出自至高者的口嗎？","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"世人因自己的罪受罰，","poem":1},{"lineBreak":true},{"text":"又何必怨天尤人呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"讓我們省察自己的行為，","poem":1},{"lineBreak":true},{"text":"重新歸向耶和華吧！","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"讓我們舉起雙手，","poem":1},{"lineBreak":true},{"text":"誠心向天上的上帝禱告說：","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"「我們犯罪、背叛，","poem":1},{"lineBreak":true},{"text":"你沒有赦免我們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"「你滿懷憤怒地追趕我們，","poem":1},{"lineBreak":true},{"text":"毫不留情地殺戮我們。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"你以密雲遮蓋自己，","poem":1},{"lineBreak":true},{"text":"以致禱告達不到你那裡。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"你使我們在列國中淪為廢物、渣滓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"「我們的仇敵都幸災樂禍。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"我們充滿恐懼，","poem":1},{"lineBreak":true},{"text":"面臨陷阱、殘害和毀滅。」","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"因同胞被毀滅，我淚流成河。","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"我的眼淚湧流不息，","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"直到耶和華從天上垂顧。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"目睹城中婦女的遭遇，","poem":1},{"lineBreak":true},{"text":"我痛苦不已。","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"敵人無故地追捕我，","poem":1},{"lineBreak":true},{"text":"如同捕獵飛鳥。","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"他們把我推進坑裡，","poem":1},{"lineBreak":true},{"text":"又用石頭砸我。","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"水已經漫過我的頭，","poem":1},{"lineBreak":true},{"text":"我想我要滅亡了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"我在深坑呼求你的名。","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"你曾垂聽我的呼求，","poem":1},{"lineBreak":true},{"text":"求你現在不要掩耳不聽我的求救聲。","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"我向你呼求的時候，","poem":1},{"lineBreak":true},{"text":"你曾走近我身旁，","poem":1},{"lineBreak":true},{"text":"安慰我說：「不要害怕！」","poem":1}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"主啊，你為我申了冤，","poem":1},{"lineBreak":true},{"text":"救贖了我的性命。","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"耶和華啊，你已明察我的冤情，","poem":1},{"lineBreak":true},{"text":"求你為我主持公道。","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"你看見了他們怎樣仇恨我、","poem":1},{"lineBreak":true},{"text":"謀害我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"你聽見了他們怎樣辱罵我、","poem":1},{"lineBreak":true},{"text":"謀害我。","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"他們整天誹謗我，圖謀害我。","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"你看！他們或坐下或起來，","poem":1},{"lineBreak":true},{"text":"都唱歌諷刺我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你按照他們的所作所為報應他們！","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"求你使他們心裡剛硬，","poem":1},{"lineBreak":true},{"text":"讓你的咒詛落在他們身上！","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"求你發怒追趕他們，","poem":1},{"lineBreak":true},{"text":"從你諸天之下剷除他們！","poem":1}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}