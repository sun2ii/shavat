{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cbt","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"116b5eec352d92466c3407c484861baa5fe24f8d05cb718844c986cf0d754a57","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cbt/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["求耶和華憐憫"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你顧念我們的遭遇，","poem":1},{"lineBreak":true},{"text":"看看我們所受的恥辱！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我們的土地被陌生人侵佔，","poem":1},{"lineBreak":true},{"text":"我們的房屋落入外族人手中。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我們成了喪父的孤兒，","poem":1},{"lineBreak":true},{"text":"我們的母親成了寡婦。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我們喝水要付錢，","poem":1},{"lineBreak":true},{"text":"燒的柴要用錢買。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"敵人緊追不捨，","poem":1},{"lineBreak":true},{"text":"我們疲憊不堪，不得安歇。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"為了得到食物，","poem":1},{"lineBreak":true},{"text":"我們向埃及、亞述卑躬屈膝。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我們的祖先犯了罪，","poem":1},{"lineBreak":true},{"text":"已經逝去，","poem":1},{"lineBreak":true},{"text":"我們卻要承擔他們的罪責。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"奴僕做了我們的主人，","poem":1},{"lineBreak":true},{"text":"無人從他們手中解救我們。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"曠野中殺機四伏，","poem":1},{"lineBreak":true},{"text":"我們冒著生命危險才得到糧食。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我們因饑餓而發熱，","poem":1},{"lineBreak":true},{"text":"皮膚熱如烤爐。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"婦女在錫安遭強暴，","poem":1},{"lineBreak":true},{"text":"少女在猶大的城邑被姦污。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"首領雙手被吊起來，","poem":1},{"lineBreak":true},{"text":"老人得不到尊敬。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"青年被迫推磨，","poem":1},{"lineBreak":true},{"text":"孩童肩背柴捆，步履蹣跚。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"老人不再坐在城門口，","poem":1},{"lineBreak":true},{"text":"青年不再彈琴奏樂。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我們心中的快樂消失，","poem":1},{"lineBreak":true},{"text":"我們的舞蹈變成了哀哭。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"榮耀的冠冕從我們頭上落下。","poem":1},{"lineBreak":true},{"text":"我們犯了罪，我們有禍了！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"此情此景使我們黯然神傷，","poem":1},{"lineBreak":true},{"text":"淚眼模糊。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"錫安山一片荒涼，","poem":1},{"lineBreak":true},{"text":"豺狼四處遊蕩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和華啊，你永遠掌權，","poem":1},{"lineBreak":true},{"text":"你的寶座世代長存。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你為何永遠忘記我們？","poem":1},{"lineBreak":true},{"text":"為何如此長久地棄絕我們？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和華啊，求你使我們回到你身邊，","poem":1},{"lineBreak":true},{"text":"讓我們歸向你，","poem":1},{"lineBreak":true},{"text":"恢復我們昔日的繁榮！","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"難道你完全棄絕了我們，","poem":1},{"lineBreak":true},{"text":"仍然向我們大發烈怒嗎？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}