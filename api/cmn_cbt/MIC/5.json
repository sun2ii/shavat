{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cbt","name":"彌迦書","commonName":"彌迦書","title":"彌迦書","order":33,"numberOfChapters":7,"sha256":"7653aa64f11ed5e86b64f5806ce4393d656010dca6eac643843bbaa97a4000ce","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cbt/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["耶和華的應許"]},{"type":"verse","number":1,"content":[{"text":"耶路撒冷的居民","poem":1},{"noteId":2},{"text":"啊，","poem":1},{"lineBreak":true},{"text":"現在你們要調集軍隊！","poem":1},{"lineBreak":true},{"text":"敵人正四面圍攻我們，","poem":1},{"lineBreak":true},{"text":"要用杖擊打以色列首領的臉頰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"以法他的伯利恆啊，","poem":1},{"lineBreak":true},{"text":"你在猶大各城中毫不起眼，","poem":1},{"lineBreak":true},{"text":"但將有一位從你那裡出來，","poem":1},{"lineBreak":true},{"text":"為我統治以色列；","poem":1},{"lineBreak":true},{"text":"祂的根源自亙古，來自太初。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因此，耶和華要將以色列人交給他們的敵人，","poem":1},{"lineBreak":true},{"text":"直到那臨盆的婦人生下兒子。","poem":1},{"lineBreak":true},{"text":"那時，祂流亡的弟兄將重返他們的以色列同胞那裡。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂要挺身而起，","poem":1},{"lineBreak":true},{"text":"倚靠耶和華的能力，","poem":1},{"lineBreak":true},{"text":"奉祂上帝耶和華的威名牧養祂的群羊。","poem":1},{"lineBreak":true},{"text":"他們將安然居住，","poem":1},{"lineBreak":true},{"text":"因為那時祂必受尊崇，直達地極。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂必給他們帶來平安！","poem":1},{"lineBreak":true},{"text":"亞述人侵略我們的國土、踐踏我們的宮殿時，","poem":1},{"lineBreak":true},{"text":"我們將選立七位牧者和八位首領抗擊他們。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們要用刀劍統治亞述，統治寧錄地區。","poem":1},{"lineBreak":true},{"text":"亞述人侵入我們國境、踐踏我們疆土時，","poem":1},{"lineBreak":true},{"text":"祂必拯救我們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"雅各餘剩的子孫將在萬民中像從耶和華那裡降下的雨露，","poem":1},{"lineBreak":true},{"text":"又像灑在草上的甘霖。","poem":1},{"lineBreak":true},{"text":"他們不依靠人，","poem":1},{"lineBreak":true},{"text":"不冀望於世人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"在各國各民中，","poem":1},{"lineBreak":true},{"text":"雅各餘剩的子孫猶如林間百獸中的獅子，","poem":1},{"lineBreak":true},{"text":"又像闖入羊群的猛獅，","poem":1},{"lineBreak":true},{"text":"將獵物撲倒撕碎，","poem":1},{"lineBreak":true},{"text":"無人能搭救。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"願你們伸手戰勝仇敵！","poem":1},{"lineBreak":true},{"text":"願你們的仇敵都被剷除！","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和華說：","poem":1},{"lineBreak":true},{"text":"「到那日，","poem":1},{"lineBreak":true},{"text":"我要消滅你們的戰馬，","poem":1},{"lineBreak":true},{"text":"毀壞你們的戰車。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我要摧毀你們境內的城邑，","poem":1},{"lineBreak":true},{"text":"拆除你們所有的堡壘。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我要除掉你們手中的巫術，","poem":1},{"lineBreak":true},{"text":"使你們那裡不再有占卜的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我要從你們中間除去雕刻的神像和神柱，","poem":1},{"lineBreak":true},{"text":"使你們不再跪拜自己所造的。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我要從你們中間剷除亞舍拉神像，","poem":1},{"lineBreak":true},{"text":"毀滅你們的城邑。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要在烈怒中報應那些不聽從我的國家。」","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"「耶路撒冷的居民」希伯來文是「被圍攻的女子」。","reference":{"chapter":5,"verse":1}}]},"thisChapterLink":"/api/cmn_cbt/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}