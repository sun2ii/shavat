{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"NAM","translationId":"cmn_cbt","name":"那鴻書","commonName":"那鴻書","title":"那鴻書","order":34,"numberOfChapters":3,"sha256":"6864a0b55315302c1d2f10b5b4421eee104e8e7528ba32c5bd70e07385cb10b5","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cbt/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["尼尼微的覆滅"]},{"type":"verse","number":1,"content":[{"text":"尼尼微啊，","poem":1},{"lineBreak":true},{"text":"攻擊者已經向你撲來。","poem":1},{"lineBreak":true},{"text":"你要進駐堡壘，","poem":1},{"lineBreak":true},{"text":"把守道路，","poem":1},{"lineBreak":true},{"text":"集中全力，","poem":1},{"lineBreak":true},{"text":"準備上陣！","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"雖然擄掠者曾擄掠雅各，","poem":1},{"lineBreak":true},{"text":"擄掠以色列，","poem":1},{"lineBreak":true},{"text":"毀壞他們的葡萄樹枝，","poem":1},{"lineBreak":true},{"text":"但耶和華必恢復雅各的榮耀，","poem":1},{"lineBreak":true},{"text":"恢復以色列的榮耀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"他的勇士手持紅色盾牌，","poem":1},{"lineBreak":true},{"text":"他的士兵身穿朱紅戰衣。","poem":1},{"lineBreak":true},{"text":"他們整裝待發之日，","poem":1},{"lineBreak":true},{"text":"戰車鐵光閃閃，","poem":1},{"lineBreak":true},{"text":"松木矛槍在空中揮舞。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"戰車在街道上狂奔，","poem":1},{"lineBreak":true},{"text":"在廣場上橫衝直撞，","poem":1},{"lineBreak":true},{"text":"亮如火炬，疾似閃電。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"亞述王召集將領，","poem":1},{"lineBreak":true},{"text":"他們一路跌跌撞撞，","poem":1},{"lineBreak":true},{"text":"奔上城牆，架起防禦盾牌。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"河閘大開，宮殿坍塌。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"王后赤身被擄；","poem":1},{"lineBreak":true},{"text":"宮女捶胸悲泣，","poem":1},{"lineBreak":true},{"text":"像鴿子一樣哀鳴。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"尼尼微城自古以來就像聚水的池子，","poem":1},{"lineBreak":true},{"text":"如今居民卻像洩漏的池水四散奔逃。","poem":1},{"lineBreak":true},{"text":"雖有人喊：「站住！站住！」","poem":1},{"lineBreak":true},{"text":"卻無人回頭。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"搶銀子吧！搶金子吧！","poem":1},{"lineBreak":true},{"text":"城裡有無盡的財富和數不清的寶物。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"尼尼微被洗劫一空！","poem":1},{"lineBreak":true},{"text":"淪為廢墟！","poem":1},{"lineBreak":true},{"text":"一片荒涼！","poem":1},{"lineBreak":true},{"text":"人們膽戰心驚，雙膝哆嗦，","poem":1},{"lineBreak":true},{"text":"渾身發抖，面色蒼白。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"如今那獅子的洞穴，","poem":1},{"lineBreak":true},{"text":"那餵養猛獅的地方在哪裡呢？","poem":1},{"lineBreak":true},{"text":"從前，雄獅、母獅和幼獅曾在那裡出入，","poem":1},{"lineBreak":true},{"text":"無人驚擾。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"雄獅為幼獅撕碎充足的食物，","poem":1},{"lineBreak":true},{"text":"為母獅絞殺獵物，","poem":1},{"lineBreak":true},{"text":"洞穴裡堆滿獵物，","poem":1},{"lineBreak":true},{"text":"堆滿撕碎的肉。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"萬軍之耶和華說：","poem":1},{"lineBreak":true},{"text":"「我與你為敵，","poem":1},{"lineBreak":true},{"text":"我要燒毀你的戰車，","poem":1},{"lineBreak":true},{"text":"使刀劍吞噬你的猛獅；","poem":1},{"lineBreak":true},{"text":"我要使你無法再擄掠他國，","poem":1},{"lineBreak":true},{"text":"你使者的聲音將從此消逝。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}