{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":1,"content":[{"type":"heading","content":["箴言的價值"]},{"type":"verse","number":1,"content":["這是大衛的兒子以色列王所羅門的箴言。"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"為使人認識智慧和教誨，","poem":1},{"text":"領悟真知灼見，","poem":2}]},{"type":"verse","number":3,"content":[{"text":"接受精明處事的教誨，","poem":1},{"text":"為人處事仁義、公平、正直；","poem":2}]},{"type":"verse","number":4,"content":[{"text":"使愚昧人明智，","poem":1},{"text":"使年輕人有知識和明辨力；","poem":2}]},{"type":"verse","number":5,"content":[{"text":"使智者聽了長學問，","poem":1},{"text":"明哲聽了得指引；","poem":2}]},{"type":"verse","number":6,"content":[{"text":"使人領悟箴言和比喻，","poem":1},{"text":"明白智者的話和謎語。","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":["知識始於敬畏耶和華，",{"text":"愚人輕視智慧和教誨。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"孩子啊，","poem":1},{"text":"你要聽從父親的教誨，","poem":2},{"lineBreak":true},{"text":"不可背棄母親的訓誨。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"因為這要作你頭上的華冠，","poem":1},{"text":"頸上的項鏈。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"孩子啊，惡人若引誘你，","poem":1},{"text":"不要屈從。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"他們若說：「跟我們來吧，","poem":1},{"text":"我們去埋伏殺人，","poem":2},{"lineBreak":true},{"text":"任意暗害無辜者；","poem":2}]},{"type":"verse","number":12,"content":[{"text":"我們要像陰間一樣生吞他們，","poem":1},{"text":"整個吞沒他們，","poem":2},{"lineBreak":true},{"text":"使他們如墜入墳墓的人；","poem":2}]},{"type":"verse","number":13,"content":[{"text":"我們必得到各樣寶物，","poem":1},{"text":"把戰利品裝滿我們的房屋。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"跟我們一起幹吧，","poem":1},{"text":"大家有福同享！」","poem":2}]},{"type":"verse","number":15,"content":[{"text":"孩子啊，","poem":1},{"text":"不要走他們的道，","poem":2},{"lineBreak":true},{"text":"切莫行他們的路。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"因為他們奔向罪惡，","poem":1},{"text":"急速地去殺人流血。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"在飛鳥眼前設網羅，徒勞無功。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他們埋伏，卻自流己血；","poem":1},{"text":"他們伏擊，卻自害己命。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"這就是貪愛不義之財者的結局，","poem":1},{"text":"不義之財終要奪去他們的性命。","poem":2}]},{"type":"heading","content":["智慧的勸誡"]},{"type":"verse","number":20,"content":[{"text":"智慧在大街上高喊，","poem":1},{"text":"在廣場上揚聲，","poem":2}]},{"type":"verse","number":21,"content":[{"text":"在熱鬧的街頭宣告，","poem":1},{"text":"在城門口發言：","poem":2}]},{"type":"verse","number":22,"content":[{"text":"「你們愚昧人喜愛愚昧，","poem":1},{"text":"嘲諷者以嘲弄為樂，","poem":2},{"lineBreak":true},{"text":"無知者厭惡知識，","poem":2},{"lineBreak":true},{"text":"要到什麼時候呢？","poem":2}]},{"type":"verse","number":23,"content":[{"text":"你們若因我的責備而回轉，","poem":1},{"text":"我就向你們顯明我的旨意","poem":2},{"noteId":0},{"text":"，","poem":2},{"lineBreak":true},{"text":"叫你們明白我的話語。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"我呼喚你們，","poem":1},{"text":"你們卻充耳不聞；","poem":2},{"lineBreak":true},{"text":"我向你們招手，","poem":2},{"lineBreak":true},{"text":"你們卻視若無睹。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"你們漠視我的勸誡，","poem":1},{"text":"不接受我的責備。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"因此，","poem":1},{"text":"你們遭遇災難時，","poem":2},{"lineBreak":true},{"text":"我必發笑；","poem":2},{"lineBreak":true},{"text":"驚恐臨到你們時，","poem":2},{"lineBreak":true},{"text":"我必嗤笑。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"那時，恐懼如風暴襲擊你們，","poem":1},{"text":"災難如旋風臨到你們，","poem":2},{"lineBreak":true},{"text":"憂愁和苦難吞沒你們。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"你們呼求我，","poem":1},{"text":"我也不回答；","poem":2},{"lineBreak":true},{"text":"你們懇切地尋找我，","poem":2},{"lineBreak":true},{"text":"卻找不到。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"因為你們厭惡知識，","poem":1},{"text":"決定不敬畏耶和華，","poem":2}]},{"type":"verse","number":30,"content":[{"text":"不接受我的勸誡，","poem":1},{"text":"又藐視我的責備。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"所以，你們必自食其果，","poem":1},{"text":"因自己的惡謀而吃盡苦頭。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"愚昧人背離正道，","poem":1},{"text":"自招滅亡；","poem":2},{"lineBreak":true},{"text":"愚頑人逍遙自在，","poem":2},{"lineBreak":true},{"text":"毀掉自己。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"然而，那聽從我的必安然居住，","poem":1},{"text":"得享安寧，","poem":2},{"lineBreak":true},{"text":"不怕災禍。」","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"「我就向你們顯明我的旨意」希伯來文是「我就將我的靈澆灌你們」。","reference":{"chapter":1,"verse":23}}]},"thisChapterLink":"/api/cmn_cbt/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}