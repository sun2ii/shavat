{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":10,"content":[{"type":"heading","content":["所羅門的箴言"]},{"type":"verse","number":1,"content":["以下是所羅門的箴言：",{"text":"智慧兒使父親快樂，","poem":2},{"lineBreak":true},{"text":"愚昧兒叫母親憂傷。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"不義之財毫無益處，","poem":1},{"text":"公義救人脫離死亡。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"耶和華不讓義人挨餓，","poem":1},{"text":"祂使惡人的奢望成空。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"遊手好閒招致貧窮，","poem":1},{"text":"勤奮努力帶來富足。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"精明兒夏季時貯藏，","poem":1},{"text":"不肖子收成時酣睡。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"祝福臨到義人的頭，","poem":1},{"text":"殘暴充滿惡人的口。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"義人流芳於世，","poem":1},{"text":"惡人名聲敗壞。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"心存智慧的接受誡命；","poem":1},{"text":"說話愚昧的自招滅亡。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"行正道者活得安穩，","poem":1},{"text":"走歪路者終必敗露。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"擠眉弄眼，帶來憂傷；","poem":1},{"text":"胡言亂語，導致滅亡。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"義人的口是生命之泉，","poem":1},{"text":"惡人的口卻充滿殘暴。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"恨能挑起紛爭，","poem":1},{"text":"愛能遮掩一切過犯。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"明哲口中有智慧，","poem":1},{"text":"無知者背上受鞭打。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"智者儲藏知識，","poem":1},{"text":"愚人口惹禍端。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"錢財是富人的堅城，","poem":1},{"text":"貧乏帶給窮人毀滅。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"義人的報酬是生命，","poem":1},{"text":"惡人的果子是懲罰。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"聽從教誨的，走生命之路；","poem":1},{"text":"拒絕責備的，必步入歧途。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"暗藏仇恨的滿口虛謊，","poem":1},{"text":"散佈流言的愚不可及。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"言多必失，智者慎言。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"義人之舌似純銀，","poem":1},{"text":"惡人之心無價值。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"義人的口滋養眾人，","poem":1},{"text":"愚人因無知而死亡。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"耶和華的祝福使人富足，","poem":1},{"text":"祝福中不加任何憂愁","poem":2},{"noteId":3},{"text":"。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"愚人以惡為樂，","poem":1},{"text":"哲士喜愛智慧。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"惡人所怕的必臨到他，","poem":1},{"text":"義人的心願必得實現。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"暴風掃過，","poem":1},{"text":"惡人消逝無蹤，","poem":2},{"lineBreak":true},{"text":"義人永不動搖。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"懶漢讓差他的人難受，","poem":1},{"text":"如醋倒牙，如煙薰目。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"敬畏耶和華的享長壽，","poem":1},{"text":"惡人的壽數必被縮短。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"義人的憧憬帶來歡樂，","poem":1},{"text":"惡人的希望終必破滅。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"耶和華的道保護正直人，","poem":1},{"text":"毀滅作惡之人。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"義人永不動搖，","poem":1},{"text":"惡人無處容身。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"義人的口發出智慧，","poem":1},{"text":"詭詐的舌必被割掉。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"義人說話得體合宜，","poem":1},{"text":"惡人口出乖謬之言。","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":3,"caller":"+","text":"「祝福中不加任何憂愁」或譯「勞苦無法使其加增」。","reference":{"chapter":10,"verse":22}}]},"thisChapterLink":"/api/cmn_cbt/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}