{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"耶和華憎惡騙人的天平，","poem":1},{"text":"喜愛公平的砝碼。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"傲慢帶來羞辱，","poem":1},{"text":"謙卑者有智慧。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"正直人被誠實引導，","poem":1},{"text":"奸詐者被奸詐毀滅。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"在降怒之日，財富毫無益處，","poem":1},{"text":"唯有公義能救人免於死亡。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"純全人行義走坦途，","poem":1},{"text":"惡人作惡致沉淪。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"正直人被義行所救，","poem":1},{"text":"奸詐者被私慾所擄。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"惡人一死，他的希望就破滅，","poem":1},{"text":"他對財勢的冀望轉眼成空。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"義人脫離患難，","poem":1},{"text":"惡人落入其中。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"不敬虔者張口敗壞鄰舍，","poem":1},{"text":"義人卻因知識獲得拯救。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"義人亨通，全城快樂；","poem":1},{"text":"惡人滅亡，人人歡呼。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"城因正直人的祝福而興盛，","poem":1},{"text":"因惡人的口舌而傾覆。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"無知者輕視鄰舍，","poem":1},{"text":"明哲保持緘默。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"嚼舌者洩露秘密，","poem":1},{"text":"忠信者守口如瓶。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"缺乏智謀，國必敗亡；","poem":1},{"text":"謀士眾多，戰無不勝。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"為他人作保，必受虧損；","poem":1},{"text":"厭惡當保人，得享平安。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"賢淑的女子得到尊榮，","poem":1},{"text":"殘暴的男子得到資財。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"仁慈的人造福自己，","poem":1},{"text":"殘酷的人惹禍上身。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"惡人賺來的轉眼成空，","poem":1},{"text":"播種公義的必獲獎賞。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"堅持行義，必得生命；","poem":1},{"text":"追逐罪惡，終必滅亡。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"心術不正的人令耶和華憎惡，","poem":1},{"text":"純全無過的人蒙耶和華喜愛。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"惡人終必受到懲罰，","poem":1},{"text":"義人的子孫必得拯救。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"女子貌美無內涵，","poem":1},{"text":"如同豬鼻掛金環。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"義人的願望結出善果，","poem":1},{"text":"惡人的希望招致烈怒。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"有人樂善好施，反倒越來越富；","poem":1},{"text":"有人極其吝嗇，反而越來越窮。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"慷慨好施的必得昌盛，","poem":1},{"text":"恩待他人的必蒙恩待。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"囤糧不賣，惹人咒詛；","poem":1},{"text":"樂意賣糧，必蒙祝福。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"尋求良善得恩惠，","poem":1},{"text":"追求罪惡遭禍患。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"倚仗財勢者必衰敗，","poem":1},{"text":"義人必興旺如綠葉。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"禍害自家，必一無所有，","poem":1},{"text":"愚人必做智者的僕役。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"義人結果如生命之樹，","poem":1},{"text":"智者深得人心。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"看啊！義人在世上尚且遭報","poem":1},{"noteId":4},{"text":"，","poem":1},{"text":"更何況惡人和罪人呢！","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":4,"caller":"+","text":"「義人在世上尚且遭報」《七十士譯本》作「義人尚且難以得救」，參見彼得前書4·18。","reference":{"chapter":11,"verse":31}}]},"thisChapterLink":"/api/cmn_cbt/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}