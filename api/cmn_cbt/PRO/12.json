{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"喜愛管教的喜愛知識，","poem":1},{"text":"厭惡責備的愚不可及。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"善良的人蒙耶和華賜恩，","poem":1},{"text":"詭詐的人被耶和華定罪。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"人不能靠惡行堅立自己，","poem":1},{"text":"義人的根基卻不會動搖。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"賢德的妻子是丈夫的冠冕，","poem":1},{"text":"無恥的妻子如丈夫的骨瘤。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"義人的心思公平正直，","poem":1},{"text":"惡人的計謀陰險詭詐。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"惡人的言語暗藏殺機，","poem":1},{"text":"正直人的口拯救生命。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"惡人覆滅不復存在，","poem":1},{"text":"義人的家屹立不倒。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"人有智慧受稱讚，","poem":1},{"text":"心術不正遭唾棄。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"地位卑微卻有僕人，","poem":1},{"text":"勝過自大卻餓肚子。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"義人顧惜自己的牲畜，","poem":1},{"text":"惡人的憐憫也是殘忍。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"努力耕耘，豐衣足食；","poem":1},{"text":"追求虛榮，愚不可及。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"惡人貪戀壞人的贓物，","poem":1},{"text":"義人的根結出碩果。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"惡人被自己的惡言所困，","poem":1},{"text":"但義人可以脫離險境。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"口出良言，飽嘗美福；","poem":1},{"text":"雙手勤勞，終得回報。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"愚人自以為是，","poem":1},{"text":"智者肯聽勸誡。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"愚人難壓怒氣，","poem":1},{"text":"明哲忍辱負重。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"忠實的證人講真話，","poem":1},{"text":"作偽證者滿口謊言。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"出言不慎猶如利劍傷人，","poem":1},{"text":"智者之言卻能醫治創傷。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"誠實的口永遠長存，","poem":1},{"text":"撒謊的舌轉瞬即逝。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"圖謀惡事的心懷詭詐，","poem":1},{"text":"勸人和睦的喜樂洋溢。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"義人無災無難，","poem":1},{"text":"惡人災禍連連。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"耶和華厭惡說謊的嘴，","poem":1},{"text":"祂喜愛行為誠實的人。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"明哲不露鋒芒，","poem":1},{"text":"愚人心吐愚昧。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"殷勤的手必掌權，","poem":1},{"text":"懶惰者必做奴僕。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"憂慮的心使人消沉，","poem":1},{"text":"一句良言振奮人心。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"義人引人走正路，","poem":1},{"text":"惡人領人入歧途。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"懶漢不烤獵物，","poem":1},{"text":"勤快人得資財。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"公義的道上有生命，","poem":1},{"text":"公義的路上無死亡。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}