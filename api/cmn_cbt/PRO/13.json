{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"智慧兒聽從父訓，","poem":1},{"text":"嘲諷者不聽責備。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"口出良言嘗善果，","poem":1},{"text":"奸徒貪行殘暴事","poem":2},{"noteId":5},{"text":"。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"說話謹慎，可保性命；","poem":1},{"text":"口無遮攔，自取滅亡。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"懶惰人空有幻想，","poem":1},{"text":"勤快人心想事成。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"義人憎惡虛謊，","poem":1},{"text":"惡人可憎可恥。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"公義守衛正直的人，","poem":1},{"text":"邪惡傾覆犯罪之徒。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"有人裝作富有，","poem":1},{"text":"其實身無分文；","poem":2},{"lineBreak":true},{"text":"有人假裝貧窮，","poem":2},{"lineBreak":true},{"text":"卻是腰纏萬貫。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"富人用財富贖命，","poem":1},{"text":"窮人卻免受驚嚇。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"義人的光燦爛，","poem":1},{"text":"惡人的燈熄滅。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"自高自大招惹紛爭，","poem":1},{"text":"虛心受教才是睿智。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"不義之財必耗盡，","poem":1},{"text":"勤儉積蓄財富增。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"盼望無期，使人憂傷；","poem":1},{"text":"夙願得償，帶來生機","poem":2},{"noteId":6},{"text":"。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"蔑視訓言，自招滅亡；","poem":1},{"text":"敬畏誡命，必得賞賜。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"智者的訓誨是生命之泉，","poem":1},{"text":"可使人避開死亡的陷阱。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"睿智使人蒙恩惠，","poem":1},{"text":"奸徒之路通滅亡。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"明哲知而後行，","poem":1},{"text":"愚人炫耀愚昧。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"奸惡的使者陷入災禍，","poem":1},{"text":"忠誠的使者帶來醫治。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"不受管教的貧窮羞愧，","poem":1},{"text":"接受責備的受到尊崇。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"願望實現使心甘甜，","poem":1},{"text":"遠離惡事為愚人憎惡。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"與智者同行必得智慧，","poem":1},{"text":"與愚人結伴必受虧損。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"禍患追趕罪人，","poem":1},{"text":"義人必得善報。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"善人為子孫留下產業，","poem":1},{"text":"罪人給義人積聚財富。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"窮人的田地出產豐富，","poem":1},{"text":"因不公而被搶掠一空。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"不用杖管教兒女是憎惡他們，","poem":1},{"text":"疼愛兒女的隨時管教他們。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"義人豐衣足食，","poem":1},{"text":"惡人食不果腹。","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":5,"caller":"+","text":"「奸徒貪行殘暴事」或譯「奸徒必飽受虐待」。","reference":{"chapter":13,"verse":2}},{"noteId":6,"caller":"+","text":"「帶來生機」希伯來文是「使人像棵生命樹」。","reference":{"chapter":13,"verse":12}}]},"thisChapterLink":"/api/cmn_cbt/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}