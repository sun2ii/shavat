{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"智慧的女子建立家室，","poem":1},{"text":"愚昧的女子親手拆毀。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"行為正直的人敬畏耶和華，","poem":1},{"text":"行事邪僻的人輕視耶和華。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"愚人的狂言招來鞭打，","poem":1},{"text":"智者的唇舌保護自己。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"沒有耕牛槽頭淨，","poem":1},{"text":"五穀豐登需壯牛。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"忠實的證人不會撒謊，","poem":1},{"text":"虛假的證人謊話連篇。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"嘲諷者徒然尋智慧，","poem":1},{"text":"明哲輕易得知識。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"你要遠離愚昧人，","poem":1},{"text":"他口中毫無知識。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"明哲憑智慧辨道，","poem":1},{"text":"愚人被愚昧欺騙。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"愚妄人戲看罪惡，","poem":1},{"text":"正直人彼此恩待。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"心頭的愁苦，唯有自己明白；","poem":1},{"text":"心中的喜樂，外人無法分享。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"惡人的房屋必遭毀滅，","poem":1},{"text":"正直人的帳篷必興盛。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"有一條路看似正確，","poem":1},{"text":"最終卻通向死亡。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"歡笑難消內心的痛苦，","poem":1},{"text":"歡樂過後，悲傷猶在。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"背棄正道，自食惡果；","poem":1},{"text":"善人行善，必得善報。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"愚人什麼都信，","poem":1},{"text":"明哲步步謹慎。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"智者小心謹慎，遠離惡事；","poem":1},{"text":"愚人驕傲自負，行事魯莽。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"急躁易怒的人做事愚昧，","poem":1},{"text":"陰險奸詐之人遭人痛恨。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"愚人得愚昧作產業，","poem":1},{"text":"明哲得知識為冠冕。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"壞人俯伏在善人面前，","poem":1},{"text":"惡人俯伏在義人門口。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"窮人遭鄰舍厭，","poem":1},{"text":"富人朋友眾多。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"藐視鄰舍是罪過，","poem":1},{"text":"憐憫窮人蒙福樂。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"圖謀惡事的步入歧途，","poem":1},{"text":"行善的得慈愛與忠誠。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"殷勤工作，帶來益處；","poem":1},{"text":"滿嘴空談，導致貧窮。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"智者以財富為冠冕，","poem":1},{"text":"愚人以愚昧為裝飾。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"誠實的證人挽救性命，","poem":1},{"text":"口吐謊言者欺騙他人。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"敬畏耶和華的信心堅定，","poem":1},{"text":"他的子孫也有庇護所。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"敬畏耶和華是生命之泉，","poem":1},{"text":"可使人避開死亡的陷阱。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"人口眾多，是君王的榮耀；","poem":1},{"text":"沒有臣民，君主必然敗亡。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"不輕易發怒者深明事理，","poem":1},{"text":"魯莽急躁的人顯出愚昧。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"心平氣和，滋潤生命；","poem":1},{"text":"妒火中燒，啃蝕骨頭。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"欺壓窮人等於侮辱造物主，","poem":1},{"text":"憐憫貧弱就是尊敬造物主。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"惡人因惡行而滅亡，","poem":1},{"text":"義人到死仍有倚靠。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"智慧存在哲士心裡，","poem":1},{"text":"愚人心中充滿無知。","poem":2}]},{"type":"verse","number":34,"content":[{"text":"公義能叫邦國興盛，","poem":1},{"text":"罪惡是人民的恥辱。","poem":2}]},{"type":"verse","number":35,"content":[{"text":"明智的臣子蒙王喜悅，","poem":1},{"text":"可恥的僕人惹王發怒。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}