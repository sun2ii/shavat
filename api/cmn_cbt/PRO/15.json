{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"溫和的回答平息怒氣，","poem":1},{"text":"粗暴的言詞激起憤怒。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"智者的舌頭傳揚知識，","poem":1},{"text":"愚人的嘴巴吐露愚昧。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"耶和華的眼目無所不在，","poem":1},{"text":"無論善人惡人，祂都鑒察。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"溫和的言詞是生命樹，","poem":1},{"text":"乖謬的話語傷透人心。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"愚人蔑視父親的管教，","poem":1},{"text":"接受責備的才算明智。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"義人家中財富充足，","poem":1},{"text":"惡人得利惹來禍患。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"智者的嘴傳揚知識，","poem":1},{"text":"愚人的心並非如此。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"耶和華憎恨惡人的祭物，","poem":1},{"text":"悅納正直人的祈禱。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"耶和華憎恨惡人的行徑，","poem":1},{"text":"喜愛追求公義的人。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"背離正道，必遭嚴懲；","poem":1},{"text":"厭惡責備，必致死亡。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"陰間和死地在耶和華面前尚且無法隱藏，","poem":1},{"text":"何況世人的心思呢！","poem":2}]},{"type":"verse","number":12,"content":[{"text":"嘲諷者不愛聽責備，","poem":1},{"text":"也不願請教智者。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"心中喜樂，容光煥發；","poem":1},{"text":"心裡悲傷，精神頹喪。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"哲士的心追求知識，","poem":1},{"text":"愚人的口吞吃愚昧。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"困苦人天天受煎熬，","poem":1},{"text":"樂觀者常常有喜樂。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"財物雖少但敬畏耶和華，","poem":1},{"text":"勝過家財萬貫卻充滿煩惱。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"粗茶淡飯但彼此相愛，","poem":1},{"text":"勝過美酒佳餚卻互相憎恨。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"脾氣暴躁，惹起爭端；","poem":1},{"text":"忍耐克制，平息糾紛。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"懶惰人的路佈滿荊棘，","poem":1},{"text":"正直人的道平坦寬闊。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"智慧之子使父親歡喜，","poem":1},{"text":"愚昧之人卻藐視母親。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"無知者以愚昧為樂，","poem":1},{"text":"明哲之士遵循正道。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"缺乏商討，計劃失敗；","poem":1},{"text":"集思廣益，事無不成。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"應對得體，心中愉快；","poem":1},{"text":"言語合宜，何等美好！","poem":2}]},{"type":"verse","number":24,"content":[{"text":"智者循生命之路上升，","poem":1},{"text":"以免墜入陰間。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"耶和華拆毀傲慢人的房屋，","poem":1},{"text":"祂使寡婦的地界完整無損。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"耶和華憎恨惡念，","poem":1},{"text":"恩言乃是純潔的。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"貪不義財，自害己家；","poem":1},{"text":"厭惡賄賂，安然存活。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"義人三思而後答，","poem":1},{"text":"惡人張口吐惡言。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"耶和華遠離惡人，","poem":1},{"text":"卻聽義人的禱告。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"眼神發光令人心喜，","poem":1},{"text":"喜訊出來滋潤骨頭。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"傾聽生命的訓誡，","poem":1},{"text":"使人與智者同列。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"不受管教就是輕看自己，","poem":1},{"text":"聽從責備才能得到智慧。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"敬畏耶和華乃是智訓，","poem":1},{"text":"學會謙卑才能得尊榮。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}