{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"心中的策劃在於人，","poem":1},{"text":"應對之言來自耶和華。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"人看自己的行為都純全，","poem":1},{"text":"但是耶和華卻衡量人心。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"把你的事交托耶和華，","poem":1},{"text":"你的計劃必實現。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"耶和華所造的萬物各有其用，","poem":1},{"text":"連惡人也是為災難之日所造。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"耶和華厭惡心驕氣傲者，","poem":1},{"text":"他們必逃不過祂的責罰。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"慈愛和忠信可讓罪惡得贖，","poem":1},{"text":"敬畏耶和華使人遠離罪惡。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"人所行的若蒙耶和華喜悅，","poem":1},{"text":"耶和華必使仇敵與他和好。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"收入微薄但行事公義，","poem":1},{"text":"勝過獲利豐厚卻不正當。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"人心中籌劃自己的道路，","poem":1},{"text":"但耶和華決定他的腳步。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"王口中有上帝的話，","poem":1},{"text":"斷案時必無差錯。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"公道的秤與天平屬於耶和華，","poem":1},{"text":"袋中一切的砝碼由祂制定。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"君王憎恨惡行，","poem":1},{"text":"因王位靠公義而立。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"王喜愛公義的言詞，","poem":1},{"text":"器重說話正直的人。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"王的烈怒是死亡使者，","poem":1},{"text":"然而智者能平息王怒。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"王的笑容帶給人生命，","poem":1},{"text":"他的恩惠像春雨之雲。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"得智慧勝過得黃金，","poem":1},{"text":"獲悟性勝過獲白銀。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"正直人的大道遠離罪惡，","poem":1},{"text":"堅守正道的保全性命。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"驕橫是淪亡的前奏，","poem":1},{"text":"狂傲是敗落的預兆。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"寧可謙卑地與貧寒人相處，","poem":1},{"text":"也不跟狂傲人共享戰利品。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"聽從訓言的人受益匪淺，","poem":1},{"text":"信靠耶和華的人蒙祝福。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"智者以明辨著稱，","poem":1},{"text":"甜言增加說服力。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"智慧是智者的生命泉，","poem":1},{"text":"愚昧為愚人帶來懲罰。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"智者三思而後言，","poem":1},{"text":"其言更有說服力。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"良言如蜜，","poem":1},{"text":"使人心靈甘甜、身體康健。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"有一條路看似正確，","poem":1},{"text":"最終卻通向死亡。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"工人的胃口促他工作，","poem":1},{"text":"口腹之需是他的動力。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"不務正業的人圖謀惡事，","poem":1},{"text":"他的口舌如烈焰般危險。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"邪僻的人散播紛爭，","poem":1},{"text":"造謠的人破壞友情。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"殘暴之徒引誘鄰舍走入歧途。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"惡人眯起眼睛圖謀不軌，","poem":1},{"text":"歹徒咬著嘴唇策劃惡事。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"白髮是榮耀的冠冕，","poem":1},{"text":"行為公義方能得到。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"不輕易發怒者勝過勇士，","poem":1},{"text":"能自我控制勝過攻陷城池。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"人可以搖籤求問，","poem":1},{"text":"但耶和華決定一切。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}