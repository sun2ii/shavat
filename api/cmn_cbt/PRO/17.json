{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"粗茶淡飯但相安無事，","poem":1},{"text":"勝過佳餚滿桌卻勾心鬥角。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"精明的僕人必管轄家主的不肖子，","poem":1},{"text":"並與他們一同承受家業。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"鼎煉銀，爐煉金，","poem":1},{"text":"耶和華試煉人心。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"作惡者留心聽惡言，","poem":1},{"text":"說謊者側耳聽壞話。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"嘲笑窮人等於侮辱造物主，","poem":1},{"text":"幸災樂禍的人必難逃懲罰。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"子孫是老人的華冠，","poem":1},{"text":"父母是兒女的榮耀。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"愚人高談闊論不相宜，","poem":1},{"text":"統治者說謊更不合適。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"行賄者視賄賂為法寶，","poem":1},{"text":"可以使他無往不利。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"饒恕過犯的促進友愛；","poem":1},{"text":"重提舊怨的破壞友情。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"責備哲士一句，","poem":1},{"text":"勝過杖打愚人百下。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"惡人一心反叛，","poem":1},{"text":"殘忍的使者必奉命來懲罰他。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"寧願遇見丟失幼崽的母熊，","poem":1},{"text":"也不願碰上做蠢事的愚人。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"人若以惡報善，","poem":1},{"text":"家裡必禍患不斷。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"爭端爆發如洪水決堤，","poem":1},{"text":"當在爆發前將其制止。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"放過罪人的和定罪無辜的，","poem":1},{"text":"都為耶和華所憎惡。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"愚人無心求智慧，","poem":1},{"text":"手中有錢有何用？","poem":2}]},{"type":"verse","number":17,"content":[{"text":"朋友時時彼此關愛，","poem":1},{"text":"手足生來患難與共。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"無知的人才會為他人作保。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"喜愛爭鬥的喜愛犯罪，","poem":1},{"text":"驕傲自大的自招滅亡。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"心術不正，難覓幸福；","poem":1},{"text":"口吐謊言，陷入禍患。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"生愚昧子帶來憂傷，","poem":1},{"text":"愚人之父毫無喜樂。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"喜樂的心乃是良藥，","poem":1},{"text":"憂傷的靈使骨枯乾。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"惡人暗中收受賄賂，","poem":1},{"text":"顛倒是非。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"哲士追求智慧，","poem":1},{"text":"愚人漫無目標。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"愚昧兒令父親憂慮，","poem":1},{"text":"讓母親苦惱。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"責罰義人不妥，","poem":1},{"text":"杖責君子不義。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"謹言慎行的有知識，","poem":1},{"text":"溫和冷靜的有悟性。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"愚人緘默可算為智慧，","poem":1},{"text":"閉口不言可算為明智。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}