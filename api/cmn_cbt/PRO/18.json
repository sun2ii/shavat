{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"孤傲者獨求己願，","poem":1},{"text":"他惱恨一切真知。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"愚人不喜歡悟性，","poem":1},{"text":"只喜歡發表意見。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"邪惡與藐視同行，","poem":1},{"text":"無恥與羞辱為伴。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"人口中的話如同深水，","poem":1},{"text":"智慧之泉像涓涓溪流。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"袒護惡人不好，","poem":1},{"text":"冤枉義人不善。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"愚人說話引起紛爭，","poem":1},{"text":"他的口招來鞭打。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"愚人的口自招滅亡，","poem":1},{"text":"他的嘴坑害他自己。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"閒言碎語如同美食，","poem":1},{"text":"深入人的五臟六腑。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"懶惰人與毀壞者意氣相投。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華的名是堅固保障，","poem":1},{"text":"義人投奔其中就得安穩。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"錢財是富人的堅城，","poem":1},{"text":"在他幻想中是高牆。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"驕傲是敗亡的前奏，","poem":1},{"text":"謙卑是尊榮的先鋒。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"未聽先答的人，","poem":1},{"text":"自顯愚昧和羞辱。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"人的心靈能忍受疾病，","poem":1},{"text":"誰能忍受破碎的心靈？","poem":2}]},{"type":"verse","number":15,"content":[{"text":"哲士的心得知識，","poem":1},{"text":"智者的耳求知識。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"禮物為人開路，","poem":1},{"text":"領人晉見權貴。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"先告狀的看似有理，","poem":1},{"text":"一經對質真相大白。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"抽籤可以平息爭端，","poem":1},{"text":"調解強者間的糾紛。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"與結怨的兄弟和解比攻城還難，","poem":1},{"text":"爭端難破，如堅城的門閂。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"人因口中所說的話而飽足，","poem":1},{"text":"因嘴中所出的言語而滿足。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"口舌能夠定生死，","poem":1},{"text":"多嘴多言食惡果。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"得到妻子就是得到珍寶，","poem":1},{"text":"也是蒙了耶和華的恩惠。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"窮人哀聲懇求，","poem":1},{"text":"富人惡言相向。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"濫交友，自招損；","poem":1},{"text":"得知己，勝手足。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}