{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"行為正直的窮人，","poem":1},{"text":"勝過言語詭詐的愚人。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"熱誠卻無知不足取，","poem":1},{"text":"行動急躁難免有錯。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"人因愚昧而自毀前程，","poem":1},{"text":"他的心卻抱怨耶和華。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"財富招來許多朋友，","poem":1},{"text":"窮人卻遭朋友拋棄。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"作偽證者難免受罰，","poem":1},{"text":"撒謊的人罪責難逃。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"大家都討好慷慨的人，","poem":1},{"text":"人人都結交好施贈的。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"窮人被親人厭棄，","poem":1},{"text":"朋友都遠遠躲避。","poem":2},{"lineBreak":true},{"text":"他苦苦哀求，也無人理會。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"得到智慧的珍惜生命，","poem":1},{"text":"持守悟性的找到福樂。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"作偽證者難免受罰，","poem":1},{"text":"撒謊的人自取滅亡。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"愚人奢華宴樂不相宜，","poem":1},{"text":"奴隸管轄王子更離譜。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"智者不輕易發怒，","poem":1},{"text":"饒恕過犯是他的榮耀。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"君王的震怒像雄獅怒吼，","poem":1},{"text":"君王的恩澤如草上甘露。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"愚昧之子是父親的災殃，","poem":1},{"text":"爭鬧之妻如雨滴漏不止。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"房屋錢財是祖先的遺產，","poem":1},{"text":"賢慧之妻乃耶和華所賜。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"懶惰使人沉睡，","poem":1},{"text":"懈怠使人挨餓。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"遵守誡命的保全性命，","poem":1},{"text":"藐視正道的自尋死路。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"善待窮人等於借貸給耶和華，","poem":1},{"text":"耶和華必回報他的善行。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"管教孩子宜早不宜晚，","poem":1},{"text":"不可任由他走向滅亡。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"脾氣暴躁的人必吃苦頭。","poem":1},{"text":"你若救他，一次肯定不夠。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"你要受教聽勸，","poem":1},{"text":"終必得到智慧。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"人心中有許多計劃，","poem":1},{"text":"唯耶和華的旨意成就。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"人心愛慕忠誠，","poem":1},{"text":"受窮勝過撒謊。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"敬畏耶和華使人得享生命，","poem":1},{"text":"安然滿足，免遭禍患。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"懶惰人手放在餐盤，","poem":1},{"text":"卻懶得送食物進嘴。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"責打嘲諷者，愚人學會謹慎；","poem":1},{"text":"責備明哲，他會增長見識。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"苛待父親的人可鄙，","poem":1},{"text":"逼走母親的人可恥。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"孩子啊，你若不聽教誨，","poem":1},{"text":"就會偏離知識。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"作偽證者嘲諷公義，","poem":1},{"text":"惡人的口吞吃罪惡。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"刑罰用來對付嘲諷者，","poem":1},{"text":"鞭子用來責打愚人背。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}