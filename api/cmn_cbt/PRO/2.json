{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":2,"content":[{"type":"heading","content":["智慧的益處"]},{"type":"verse","number":1,"content":[{"text":"孩子啊，","poem":1},{"text":"你若接受我的教誨，","poem":2},{"lineBreak":true},{"text":"珍愛我的誡命，","poem":2}]},{"type":"verse","number":2,"content":[{"text":"側耳聆聽智慧，","poem":1},{"text":"傾心渴慕悟性；","poem":2}]},{"type":"verse","number":3,"content":[{"text":"你若呼求洞見，","poem":1},{"text":"高聲尋求悟性，","poem":2}]},{"type":"verse","number":4,"content":[{"text":"尋它如尋銀子，","poem":1},{"text":"找它如找寶藏，","poem":2}]},{"type":"verse","number":5,"content":[{"text":"你就會懂得敬畏耶和華，","poem":1},{"text":"能夠認識上帝。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"因為耶和華賜人智慧，","poem":1},{"text":"知識和悟性出自祂的口。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"祂使正直人充滿智慧，","poem":1},{"text":"是行為純全者的盾牌。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"祂看守正義之路，","poem":1},{"text":"護衛虔誠人的道。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"這樣，你就明白何為仁義、","poem":1},{"text":"公平、正直，","poem":2},{"lineBreak":true},{"text":"及一切美善之道。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"因為智慧必進入你心，","poem":1},{"text":"知識必令你的靈歡樂。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"明辨力必護佑你，","poem":1},{"text":"悟性必看顧你。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"智慧必救你遠離惡道，","poem":1},{"text":"脫離言語荒謬的人。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"他們捨棄正道，走上黑路，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"以行惡為樂，喜愛惡人的邪僻；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他們的道路歪邪，行徑扭曲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"智慧要救你脫離淫婦，","poem":1},{"text":"脫離花言巧語的妓女。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"她撇棄了年輕時的丈夫，","poem":1},{"text":"忘了在上帝面前立的約。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"她的家通向死亡，","poem":1},{"text":"她的路直達陰間。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"到她那裡的人都有去無回，","poem":1},{"text":"找不到生命之道。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"所以你要行善人的路，","poem":1},{"text":"守義人的道。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"因為在地上，","poem":1},{"text":"正直人必安居，","poem":2},{"lineBreak":true},{"text":"純全無過的人必長存，","poem":2}]},{"type":"verse","number":22,"content":[{"text":"地上的惡人必被剷除，","poem":1},{"text":"世上的奸徒必被根除。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}