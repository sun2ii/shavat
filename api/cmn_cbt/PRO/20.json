{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"酒使人放肆，烈酒叫人吵鬧。","poem":1},{"text":"因酒誤事，實為不智。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"君王震怒如獅子咆哮，","poem":1},{"text":"觸怒他的人自尋死路。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"避免紛爭是光榮，","poem":1},{"text":"愚人個個愛爭吵。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"懶惰人不按時耕種，","poem":1},{"text":"收穫時必一無所得。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"人心的謀略如深水，","poem":1},{"text":"唯有哲士才能汲取。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"人都聲稱自己忠誠，","poem":1},{"text":"但誰能找到忠信者？","poem":2}]},{"type":"verse","number":7,"content":[{"text":"義人行為正直，","poem":1},{"text":"他的後代也蒙福。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"王坐在寶座上審判，","poem":1},{"text":"他的眼目明察罪惡。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"誰敢說：「我心靈潔淨，純潔無罪？」","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"缺斤少兩、尺寸不足，","poem":1},{"text":"都為耶和華所憎惡。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"孩童的舉動是否純良，","poem":1},{"text":"顯明他的本性。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"能聽的耳，能看的眼，","poem":1},{"text":"兩者都為耶和華所造。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"不要貪睡，免得貧窮；","poem":1},{"text":"勤勞工作，糧食豐足。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"買主總說貨物不好，","poem":1},{"text":"買走後又連連自誇。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"世間有黃金和許多寶石，","poem":1},{"text":"唯有博學之言才是珍寶。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"誰為陌生人作保，就拿去誰的外衣；","poem":1},{"text":"誰為外族人作保，誰就要承擔責任。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"騙來的餅覺得香甜，","poem":1},{"text":"最後卻是滿口泥沙。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"集思出良策，","poem":1},{"text":"征戰靠智謀。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"嚼舌的人洩露秘密，","poem":1},{"text":"不可結交多嘴的人。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"咒罵父母的人，","poem":1},{"text":"他的生命","poem":2},{"noteId":7},{"text":"必消逝在黑暗中。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"起初輕易得來之財，","poem":1},{"text":"最終不會成為祝福。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"不要說：「我要以惡報惡」，","poem":1},{"text":"要等候耶和華，祂必替你伸冤。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"耶和華憎惡缺斤少兩，","poem":1},{"text":"祂厭惡騙人的天平。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"人的腳步由耶和華所定，","poem":1},{"text":"人怎能知道自己的道路？","poem":2}]},{"type":"verse","number":25,"content":[{"text":"人向主許願要三思，","poem":1},{"text":"免得事後作繭自縛。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"明君必篩出惡人，","poem":1},{"text":"用石磙碾軋他們。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"人的靈是耶和華的燈，","poem":1},{"text":"鑒察人的肺腑心腸。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"君王靠慈愛和忠信護佑，","poem":1},{"text":"他的王位因慈愛而穩固。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"力量是青年的榮耀，","poem":1},{"text":"白髮是老人的尊榮。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"鞭傷能驅除罪惡，","poem":1},{"text":"責打能潔淨人心。","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":7,"caller":"+","text":"「生命」希伯來文是「燈」。","reference":{"chapter":20,"verse":20}}]},"thisChapterLink":"/api/cmn_cbt/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}