{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"耶和華掌管君王的心，","poem":1},{"text":"易如支配壟溝的流水。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"人自以為行事正確，","poem":1},{"text":"但耶和華衡量人心。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"秉公行義比獻祭更蒙耶和華喜悅。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"高傲的眼，狂妄的心，惡人的燈，","poem":1},{"text":"都是罪惡。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"勤勞者的計劃必致富足，","poem":1},{"text":"行事急躁的人必致貧困。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"騙來的財如過眼雲霧，","poem":1},{"text":"使人掉進死亡的陷阱。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"惡人的暴力必毀滅自己，","poem":1},{"text":"因為他們行事不公不義。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"犯罪的人行徑扭曲，","poem":1},{"text":"純潔的人行為正直。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"寧願住在屋頂的一角，","poem":1},{"text":"也不跟爭鬧之妻同屋。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"惡人貪戀邪惡，","poem":1},{"text":"對鄰舍殘忍無情。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"懲罰嘲諷者，愚人得智慧；","poem":1},{"text":"訓導智者，他便長見識。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"公義的上帝鑒察惡人的家，","poem":1},{"text":"並使他們覆滅。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"掩耳不聽窮人呼求的，","poem":1},{"text":"將來求救必無人回應。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"暗中送的禮物能平息憤怒，","poem":1},{"text":"塞進懷裡的賄賂止息盛怒。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"正義得到伸張，","poem":1},{"text":"義人喜，惡人怕。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"人偏離明智之道，","poem":1},{"text":"終必與陰魂為伍。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"貪圖享受必窮困，","poem":1},{"text":"奢華宴樂難富足。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"惡人作義人的贖價，","poem":1},{"text":"奸徒替正直人受罰。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"寧願獨居曠野，","poem":1},{"text":"不跟吵鬧易怒的女子同住。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"智者家中積存寶物和油，","poem":1},{"text":"愚人將所有的揮霍一空。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"追求公義與慈愛的，","poem":1},{"text":"必尋得生命、公義和尊榮。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"智者攀上勇士的城池，","poem":1},{"text":"摧毀他們倚仗的堅壘。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"管住口舌，免遭禍患。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"嘲諷者狂妄自大，","poem":1},{"text":"行事驕橫無比。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"懶人的慾望害死自己，","poem":1},{"text":"因為他的手不肯做工。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"懶人整天貪得無厭，","poem":1},{"text":"義人施捨毫不吝嗇。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"惡人的祭物已經可憎，","poem":1},{"text":"何況他懷著惡意來獻！","poem":2}]},{"type":"verse","number":28,"content":[{"text":"作偽證的終滅亡，","poem":1},{"text":"聆聽者的證詞有效。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"惡人虛張聲勢，","poem":1},{"text":"正直人謹慎行事。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"任何智慧、悟性和謀略，","poem":1},{"text":"都不能對抗耶和華。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"馬為爭戰之日預備，","poem":1},{"text":"勝敗由耶和華決定。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}