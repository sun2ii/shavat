{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"美名勝過巨富，","poem":1},{"text":"恩寵好過金銀。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"富人和窮人同世而立，","poem":1},{"text":"二者皆由耶和華所造。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"明哲遇禍躲避，","poem":1},{"text":"愚人前去受害。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"心存謙卑、敬畏耶和華，","poem":1},{"text":"必得財富、尊榮和生命。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"奸徒之道有荊棘和陷阱，","poem":1},{"text":"想保全生命的必須遠避。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"教導孩童走正路，","poem":1},{"text":"他到老也不偏離。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"富人管轄窮人，","poem":1},{"text":"欠債的是債主的僕人。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"播種不義的必收災禍，","poem":1},{"text":"他暴怒的杖必被折斷。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"慷慨的人必蒙福，","poem":1},{"text":"因他給窮人食物。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"趕走嘲諷者，紛爭平息，","poem":1},{"text":"爭吵和羞辱也會消除。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"喜愛清心、口吐恩言的人，","poem":1},{"text":"必與君王為友。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"耶和華的眼目護衛知識，","poem":1},{"text":"祂必推翻奸徒的言論。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"懶惰人說：「外面有獅子，","poem":1},{"text":"我會命喪街頭。」","poem":2}]},{"type":"verse","number":14,"content":[{"text":"淫婦的口是深坑，","poem":1},{"text":"耶和華憎惡的人必陷進去。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"愚昧纏住孩童的心，","poem":1},{"text":"教棍能遠遠趕走它。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"靠壓榨窮人斂財和送禮給富人的，","poem":1},{"text":"都必窮困潦倒。","poem":2}]},{"type":"heading","content":["智者之言"]},{"type":"verse","number":17,"content":[{"text":"你要側耳聽智者之言，","poem":1},{"text":"專心領受我的教誨，","poem":2}]},{"type":"verse","number":18,"content":[{"text":"銘記在心、隨時誦詠，","poem":1},{"text":"方為美事。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"今天我將這些指示你，","poem":1},{"text":"為要使你倚靠耶和華。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"關於謀略和知識，","poem":1},{"text":"我已寫給你三十條，","poem":2}]},{"type":"verse","number":21,"content":[{"text":"要使你認識真理，","poem":1},{"text":"好如實答覆差你來的人。","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"不可仗勢剝削貧窮人，","poem":1},{"text":"法庭上不可欺凌困苦者，","poem":2}]},{"type":"verse","number":23,"content":[{"text":"因為耶和華必為他們伸冤，","poem":1},{"text":"奪去掠奪他們之人的性命。","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"不可結交脾氣暴躁者，","poem":1},{"text":"不要跟易怒之人來往，","poem":2}]},{"type":"verse","number":25,"content":[{"text":"免得你沾染他們的惡習，","poem":1},{"text":"不能自拔。","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"不要為人擊掌作保，","poem":1},{"text":"不要為欠債的抵押。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"如果你還不起，","poem":1},{"text":"連你的床也會被抬走。","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"不可移動祖先定下的界石。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你看那精明能幹的人，","poem":1},{"text":"他必侍立在君王面前，","poem":2},{"lineBreak":true},{"text":"不會效力於泛泛之輩。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}