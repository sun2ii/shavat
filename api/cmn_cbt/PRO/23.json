{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"你若與官長同席，","poem":1},{"text":"要注意面對的是誰。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"如果你是貪吃的人，","poem":1},{"text":"就要節制食慾","poem":2},{"noteId":8},{"text":"；","poem":2}]},{"type":"verse","number":3,"content":[{"text":"不可貪戀他的美食，","poem":1},{"text":"這美食是圈套。","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"別為錢財耗盡心力，","poem":1},{"text":"要明智，適可而止。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"錢財眨眼之間消逝無蹤，","poem":1},{"text":"它必長出翅膀如鷹飛去。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"不要吃吝嗇人的飯，","poem":1},{"text":"不可貪圖他的美味。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"因為他總是精於算計，","poem":1},{"text":"嘴上說「請吃，請喝」，","poem":2},{"lineBreak":true},{"text":"心裡卻另有盤算。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"你必嘔出所吃的那點飯，","poem":1},{"text":"你說的美言都必枉費。","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"不要和愚人說話，","poem":1},{"text":"他必藐視你的智言。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"不可挪移古時的界石，","poem":1},{"text":"不可侵佔孤兒的田地。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"因他們的救贖主強大，","poem":1},{"text":"祂必對付你，替他們伸冤。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"你要專心接受教誨，","poem":1},{"text":"側耳傾聽博學之言。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"不要疏於管教孩子，","poem":1},{"text":"杖責不會使他斃命，","poem":2}]},{"type":"verse","number":14,"content":[{"text":"杖責能救他脫離死亡。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"孩子啊，","poem":1},{"text":"你若心裡有智慧，","poem":2},{"lineBreak":true},{"text":"我心裡也會歡喜。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"你的口若說正直的話，","poem":1},{"text":"我的內心也歡暢不已。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"不要心裡羡慕罪人，","poem":1},{"text":"要終日敬畏耶和華。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"這樣，你必前途光明，","poem":1},{"text":"你的盼望不會幻滅。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"孩子啊，聽我的話，","poem":1},{"text":"要有智慧，心守正道。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"不要結交酒肉朋友，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"因為好酒貪吃者必窮困，","poem":1},{"text":"貪睡的人必穿破衣爛衫。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"要聽從生養你的父親，","poem":1},{"text":"不可輕視年老的母親。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"要買真理，不可賣掉，","poem":1},{"text":"要買智慧、教誨和悟性。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"義人的父親喜樂無限，","poem":1},{"text":"智慧之子使父母歡欣。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"願你使父母快樂，","poem":1},{"text":"叫生你的人歡欣。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"孩子啊，把你的心交給我，","poem":1},{"text":"雙目要緊盯我的道路。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"妓女是深坑，淫婦是陷阱；","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"她像強盜般埋伏，","poem":1},{"text":"使世間增添奸徒。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"誰有災禍？誰有憂傷？","poem":1},{"text":"誰有爭吵？誰有怨言？","poem":2},{"lineBreak":true},{"text":"誰無故受傷？誰兩眼發紅？","poem":2}]},{"type":"verse","number":30,"content":[{"text":"就是那些沉迷醉鄉，","poem":1},{"text":"品嘗調和酒的人！","poem":2}]},{"type":"verse","number":31,"content":[{"text":"雖然鮮紅的酒在杯中閃爍，","poem":1},{"text":"喝下去痛快，但不要注視。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"它終必像蛇一樣傷你，","poem":1},{"text":"像毒蛇一樣咬你。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"你的眼會看見怪異的景象，","poem":1},{"text":"你會神智不清，胡言亂語。","poem":2}]},{"type":"verse","number":34,"content":[{"text":"你好像躺在怒海中，","poem":1},{"text":"又像臥在桅桿頂上。","poem":2}]},{"type":"verse","number":35,"content":[{"text":"你會說：「人打我，我不痛；","poem":1},{"text":"人揍我，我不知。","poem":2},{"lineBreak":true},{"text":"什麼時候醒了，再乾一杯！」","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"「節制食慾」希伯來文是「把刀放在喉嚨上」。","reference":{"chapter":23,"verse":2}}]},"thisChapterLink":"/api/cmn_cbt/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}