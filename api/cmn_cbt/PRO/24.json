{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"不要羡慕惡人，","poem":1},{"text":"不要渴望與他們為伍；","poem":2}]},{"type":"verse","number":2,"content":[{"text":"因為他們心裡圖謀暴行，","poem":1},{"text":"口中談論惡事。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"家靠智慧而建立，","poem":1},{"text":"靠悟性而穩固，","poem":2}]},{"type":"verse","number":4,"content":[{"text":"藉知識而充滿各種珍寶。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"智者充滿能力，","poem":1},{"text":"哲士力上加力。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"出征打仗，要憑智謀；","poem":1},{"text":"謀士眾多，才有勝算。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"智慧對愚人高不可及，","poem":1},{"text":"他在城門口沉默不語。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"圖謀作惡的必被稱為陰謀家。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愚人的計謀是罪惡，","poem":1},{"text":"人人都厭惡嘲諷者。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"逆境中喪膽的必力量衰微。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"被拉去屠殺的，你要搶救；","poem":1},{"text":"行將被宰殺的，你要攔阻。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"你若推說自己毫不知情，","poem":1},{"text":"鑒察人心的主豈不洞察？","poem":2},{"lineBreak":true},{"text":"保守你生命的豈不知情？","poem":2},{"lineBreak":true},{"text":"祂必按你的行為報應你。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"孩子啊，你要吃蜜，因蜜美好，","poem":1},{"text":"蜂房滴下的蜜甘甜可口。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"智慧同樣使你的心靈甘甜；","poem":1},{"text":"你若找到智慧，前途必光明，","poem":2},{"lineBreak":true},{"text":"盼望也不會幻滅。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"不要像惡人一樣暗算義人家，","poem":1},{"text":"不要破壞他的居所。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"因為義人跌倒七次仍會起來，","poem":1},{"text":"惡人卻被災禍擊垮。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"仇敵跌倒，不要幸災樂禍；","poem":1},{"text":"仇敵敗落，不要心裡歡喜。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"否則，耶和華看見會不悅，","poem":1},{"text":"不再向仇敵發烈怒。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"不要因惡人而憤憤不平，","poem":1},{"text":"也不要羡慕邪惡之徒；","poem":2}]},{"type":"verse","number":20,"content":[{"text":"因為惡人毫無前途，","poem":1},{"text":"惡人的燈終必熄滅。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"孩子啊，要敬畏耶和華和君王，","poem":1},{"text":"不要跟叛逆之徒為伍。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"因為災禍必驟然臨到他們，","poem":1},{"text":"誰知道耶和華和君王如何毀滅他們？","poem":2}]},{"type":"heading","content":["其他智言"]},{"type":"verse","number":23,"content":[{"text":"以下也是智者的箴言：","poem":1},{"text":"判案時偏袒實為不善。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"判惡人無罪的，","poem":1},{"text":"必遭萬民咒詛，","poem":2},{"lineBreak":true},{"text":"為列國痛恨。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"責備惡人的必有歡樂，","poem":1},{"text":"美好的福氣必臨到他。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"誠實的回答如同友好的親吻。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"要安排好外面的事，","poem":1},{"text":"把田間的工作準備妥當，","poem":2},{"lineBreak":true},{"text":"然後建造房屋。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"別無故作證害鄰舍，","poem":1},{"text":"也不可撒謊欺騙人。","poem":2}]},{"type":"verse","number":29,"content":[{"text":"不可說：「別人怎樣待我，","poem":1},{"text":"我就怎樣待他；","poem":2},{"lineBreak":true},{"text":"我要照他所做的報復他。」","poem":2}]},{"type":"verse","number":30,"content":[{"text":"我走過懶惰人的田地和無知者的葡萄園，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"那裡荊棘遍地，","poem":1},{"text":"刺草叢生，","poem":2},{"lineBreak":true},{"text":"石牆倒塌。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"我仔細思想所見之事，","poem":1},{"text":"領悟到一個教訓：","poem":2}]},{"type":"verse","number":33,"content":[{"text":"再睡一會兒，","poem":1},{"text":"再打個盹兒，","poem":2},{"lineBreak":true},{"text":"再抱著手躺一會兒，","poem":2}]},{"type":"verse","number":34,"content":[{"text":"貧窮必像盜賊一樣臨到你，","poem":1},{"text":"缺乏必像武士一樣撲向你。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}