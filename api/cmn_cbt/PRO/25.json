{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":25,"content":[{"type":"heading","content":["所羅門的箴言（續）"]},{"type":"verse","number":1,"content":["以下也是所羅門的箴言，由猶大王希西迦的人抄錄。"]},{"type":"verse","number":2,"content":[{"text":"將事隱藏是上帝的榮耀，","poem":1},{"text":"把事查明是君王的光榮。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"天之高，地之厚，","poem":1},{"text":"君王的心測不透。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"除掉銀子裡的渣滓，","poem":1},{"text":"銀匠就能鑄造器皿。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"清除君王身邊的惡人，","poem":1},{"text":"王位必因公義而鞏固。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"不可在王面前妄自尊大，","poem":1},{"text":"不要佔據大人物的位子。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"與其在權貴面前被貶低，","poem":1},{"text":"不如等人邀請你坐上座。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"不可貿然打官司，","poem":1},{"text":"以免被鄰舍羞辱，","poem":2},{"lineBreak":true},{"text":"無所適從。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"遇到跟鄰舍對簿公堂，","poem":1},{"text":"不可洩露他人的秘密，","poem":2}]},{"type":"verse","number":10,"content":[{"text":"免得聽見的人辱罵你，","poem":1},{"text":"你的惡名將永難洗刷。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"一句話說得合宜，","poem":1},{"text":"就像金蘋果放在銀器裡。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"對受教者而言，","poem":1},{"text":"智者的責備猶如金耳環和金飾物。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"忠信的使者叫主人心裡舒暢，","poem":1},{"text":"就像夏收之時有冰雪的涼氣。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"誇口送禮物卻食言的人，","poem":1},{"text":"就像沒有雨水的風和雲。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"堅忍的耐心說服君王，","poem":1},{"text":"柔和的舌頭折斷骨頭。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"找到蜂蜜要酌量而食，","poem":1},{"text":"免得吃多了嘔吐。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"不要頻頻去鄰舍家，","poem":1},{"text":"免得惹人煩、遭人厭。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"作偽證陷害鄰舍的人，","poem":1},{"text":"無異於大錘、快刀和利箭。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"危難時投靠奸詐之人，","poem":1},{"text":"形同倚靠壞牙和跛腳。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"對憂傷的人唱歌，","poem":1},{"text":"如同天寒脫衣、傷口撒鹽。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"你的仇敵若餓了，","poem":1},{"text":"就給他吃的；","poem":2},{"lineBreak":true},{"text":"若渴了，就給他水喝；","poem":2}]},{"type":"verse","number":22,"content":[{"text":"因為你這是把炭火堆在他頭上，","poem":1},{"text":"耶和華必獎賞你。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"北風帶來雨水，","poem":1},{"text":"讒言激起憤怒。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"寧願住在屋頂的一角，","poem":1},{"text":"也不跟爭鬧之妻同屋。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"有好消息從遠方傳來，","poem":1},{"text":"如涼水滋潤乾渴的人。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"義人向惡人低頭，","poem":1},{"text":"就像清泉被攪渾，","poem":2},{"lineBreak":true},{"text":"水井受污染。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"蜂蜜吃得太多有害無益，","poem":1},{"text":"追求自己的榮耀也不光彩。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"無法自制的人就像牆垣被毀之城。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}