{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"愚人得尊榮本不合宜，","poem":1},{"text":"如夏天降雪、收割時下雨。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"麻雀翻飛，燕子翱翔，","poem":1},{"text":"咒詛不會無端降臨。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"鞭子打馬，韁繩勒驢，","poem":1},{"text":"棍棒責打愚人的背。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"別照愚人的愚昧回答他，","poem":1},{"text":"免得你像他一樣。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"要照愚人的愚昧回答他，","poem":1},{"text":"免得他自以為有智慧。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"靠愚人傳信，","poem":1},{"text":"如同砍斷自己的腳，","poem":2},{"lineBreak":true},{"text":"自討苦吃。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"愚人口中說箴言，","poem":1},{"text":"如同跛子空有腿。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"把尊榮給愚人，","poem":1},{"text":"就像把石子綁在甩石器上。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"愚人口中說箴言，","poem":1},{"text":"如醉漢手握荊棘。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"雇用愚人或路人，","poem":1},{"text":"如同弓箭手亂箭傷人。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"愚人一再重複愚昧事，","poem":1},{"text":"就像狗轉身吃自己所吐的。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"自以為有智慧的人，","poem":1},{"text":"還不如愚人有希望。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"懶惰人說：「路上有獅子，","poem":1},{"text":"街上有猛獅。」","poem":2}]},{"type":"verse","number":14,"content":[{"text":"懶惰人賴在床上滾來滾去，","poem":1},{"text":"就像門在門軸上轉來轉去。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"懶惰人手放在餐盤，","poem":1},{"text":"卻懶得送食物進嘴。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"懶惰人自以為比七個善於應對的人更有智慧。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"插手他人的糾紛，","poem":1},{"text":"猶如揪狗的耳朵。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"欺騙鄰舍還說是開玩笑，","poem":1},{"text":"如同瘋子亂拋火把、亂射利箭。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"沒有木柴，火自然熄滅；","poem":1},{"text":"沒有閒話，爭端便平息。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"好鬥之人煽動爭端，","poem":1},{"text":"如同餘火加炭、火上加柴。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"閒言碎語如同美食，","poem":1},{"text":"深入人的五臟六腑。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"火熱的嘴，邪惡的心，","poem":1},{"text":"猶如瓦器鍍了層銀。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"怨恨人的用美言掩飾自己，","poem":1},{"text":"心中卻藏著詭詐。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"縱然他甜言蜜語，你也不可信他，","poem":1},{"text":"因為他心中充滿各種可憎之事。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"雖然他用詭計掩飾怨恨，","poem":1},{"text":"他的邪惡必被會眾揭穿。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"挖陷阱的，必自陷其中；","poem":1},{"text":"滾石頭的，必自傷己身。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"撒謊的舌恨它所害的人，","poem":1},{"text":"諂媚的嘴帶來毀滅。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":27}