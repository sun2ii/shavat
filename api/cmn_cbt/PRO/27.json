{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"不要為明天誇口，","poem":1},{"text":"因為你不知一天會怎樣。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"讓別人誇獎你，不要開口自誇；","poem":1},{"text":"讓外人稱讚你，不要自吹自擂。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"石頭沉，沙土重，","poem":1},{"text":"不如愚人惹的麻煩重。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"暴怒固然殘酷，","poem":1},{"text":"憤恨好比狂瀾，","poem":2},{"lineBreak":true},{"text":"然而嫉妒更是無人能敵。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"開誠佈公的責備勝過隱藏的愛。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"朋友加的創傷出自真誠，","poem":1},{"text":"仇敵連連親吻卻是多餘。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"飽足的人連蜂蜜也嫌棄，","poem":1},{"text":"饑餓的人吃苦食也甘甜。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"離鄉背井的人就像離巢的飛鳥。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"膏油和香料使人暢快，","poem":1},{"text":"朋友的忠告令人甘甜。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"不可拋棄你的朋友和父親的至交。","poem":1},{"text":"患難時別投靠兄弟，","poem":2},{"lineBreak":true},{"text":"近鄰勝過遠親。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"孩子啊，你要做智者，","poem":1},{"text":"使我的心喜樂，","poem":2},{"lineBreak":true},{"text":"我好回答譏笑我的人。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"明哲遇禍躲避，","poem":1},{"text":"愚人前去受害。","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"誰為陌生人作保，就拿去誰的外衣；","poem":2},{"lineBreak":true},{"text":"誰為外族人作保，誰就要承擔責任。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"清早高聲為鄰舍祝福，","poem":1},{"text":"無異於咒詛他。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"喋喋不休的妻子，","poem":1},{"text":"就像雨天房屋漏個不停；","poem":2}]},{"type":"verse","number":16,"content":[{"text":"想制止她猶如制止狂風，","poem":1},{"text":"又像用手抓油一樣困難。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"朋友互相切磋，","poem":1},{"lineBreak":true},{"text":"如鐵磨鐵越磨越利。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"看護無花果樹的吃無花果，","poem":1},{"text":"照顧主人的也必得尊榮。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"水能映照人的面貌，","poem":1},{"text":"心能反映人的本相。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"陰間和死亡填不滿，","poem":1},{"text":"人的眼目永不滿足。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"鼎煉銀，爐煉金，","poem":1},{"text":"讚美也考驗人。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"就算把愚人放在臼裡與麥子一起搗碎，","poem":1},{"text":"他仍然難脫愚昧。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"你要瞭解你的羊群，","poem":1},{"text":"小心照料你的牲畜。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"因為錢財有用盡時，","poem":1},{"text":"冠冕不能萬代長存。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"乾草割去，嫩草長出，","poem":1},{"text":"山間的野草都被收起來。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"小羊的皮毛可做衣服，","poem":1},{"text":"賣山羊的錢可買田地，","poem":2}]},{"type":"verse","number":27,"content":[{"text":"母山羊的奶足夠你和家人喝，","poem":1},{"text":"也夠養活你的僕婢。","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}