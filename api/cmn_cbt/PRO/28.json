{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"惡人未被追趕也逃竄，","poem":1},{"text":"義人坦然無懼如雄獅。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"國中有罪，君王常換；","poem":1},{"text":"國有哲士，長治久安。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"窮人","poem":1},{"noteId":9},{"text":"欺壓貧民，","poem":1},{"text":"如暴雨沖毀糧食。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"背棄律法的稱讚惡人，","poem":1},{"text":"遵守律法的抗拒惡人。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"邪惡之人不明白公義，","poem":1},{"text":"尋求耶和華的全然明白。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"行為正直的窮人，","poem":1},{"text":"勝過行事邪僻的富人。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"遵守律法的是智慧之子，","poem":1},{"text":"與貪食者為伍的令父蒙羞。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"人放高利貸牟利，","poem":1},{"text":"是為濟貧者積財。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"人若不聽從律法，","poem":1},{"text":"他的禱告也可憎。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"引誘正直人走邪道，","poem":1},{"text":"必掉進自己設的陷阱；","poem":2},{"lineBreak":true},{"text":"但純全無過的人必承受福分。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"富人自以為有智慧，","poem":1},{"text":"卻被明智的窮人看透。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"義人得勝，眾民歡騰；","poem":1},{"text":"惡人當道，人人躲藏。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"自掩其罪，必不亨通；","poem":1},{"text":"痛改前非，必蒙憐憫。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"常敬畏主的必蒙福，","poem":1},{"text":"心裡剛硬的必遭禍。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"暴虐的君王轄制窮人，","poem":1},{"text":"如咆哮的獅、覓食的熊。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"昏庸的君王殘暴不仁，","poem":1},{"text":"恨不義之財的享長壽。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"背負血債者必終生逃亡，","poem":1},{"text":"誰也不要幫他。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"純全無過的必蒙拯救，","poem":1},{"text":"行為邪僻的轉眼覆滅。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"勤奮耕耘，豐衣足食；","poem":1},{"text":"追求虛榮，窮困潦倒。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"忠信的人必大蒙祝福，","poem":1},{"text":"急於發財的難免受罰。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"徇私偏袒實為不善，","poem":1},{"text":"人卻為一點餅而枉法。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"貪婪的人急於發財，","poem":1},{"text":"卻不知貧窮即將臨到。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"責備人的至終比諂媚者更受愛戴。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"竊取父母之財而不知罪者與匪類無異。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"貪得無厭的人挑起紛爭，","poem":1},{"text":"信靠耶和華的富足昌盛。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"愚人心中自以為是，","poem":1},{"text":"憑智慧行事的平安穩妥。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"賙濟窮人的一無所缺，","poem":1},{"text":"視而不見的多受咒詛。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"惡人當道，人人躲藏；","poem":1},{"text":"惡人滅亡，義人增多。","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":9,"caller":"+","text":"「窮人」有些抄本作「暴君」。","reference":{"chapter":28,"verse":3}}]},"thisChapterLink":"/api/cmn_cbt/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}