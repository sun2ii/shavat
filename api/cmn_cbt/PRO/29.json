{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"屢教不改、頑固不化者，","poem":1},{"text":"必突然滅亡，無可挽救。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"義人增多，民眾歡騰；","poem":1},{"text":"惡人得勢，民眾歎息。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"愛慕智慧的使父親歡欣，","poem":1},{"text":"結交妓女的必耗盡錢財。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"君王秉公行義，國家安定；","poem":1},{"text":"他若收受賄賂，國必傾倒。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"奉承鄰舍，等於設網羅絆他。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"惡人被自己的罪纏住，","poem":1},{"text":"義人卻常常歡喜歌唱。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"義人關心窮人的冤屈，","poem":1},{"text":"惡人對此漠不關心。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"狂徒煽動全城，","poem":1},{"text":"智者平息眾怒。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"智者跟愚人對簿公堂，","poem":1},{"text":"愚人會怒罵嬉笑不止。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"嗜殺之徒憎惡純全無過的人，","poem":1},{"text":"但正直的人保護他們","poem":2},{"noteId":10},{"text":"。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"愚人盡情發洩怒氣，","poem":1},{"text":"智者默然克制怒氣。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"君王若聽讒言，","poem":1},{"text":"臣僕必成奸徒。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"貧窮人和欺壓者有共同點：","poem":1},{"text":"他們的眼睛都是耶和華所賜。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"君王若秉公審判窮人，","poem":1},{"text":"他的王位必永遠堅立。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"管教之杖使孩子得智慧，","poem":1},{"text":"放縱的子女讓母親蒙羞。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"惡人當道，罪惡氾濫；","poem":1},{"text":"義人必得見他們敗亡。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"好好管教兒子，","poem":1},{"text":"他會帶給你平安，使你心裡喜樂。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"百姓無神諭便任意妄為，","poem":1},{"text":"但遵守律法的人必蒙福。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"管教僕人不能單靠言語，","poem":1},{"text":"因為他雖明白卻不理會。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"言語急躁的人，","poem":1},{"text":"還不如愚人有希望。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"從小嬌縱的僕人，","poem":1},{"text":"最終必反仆為主。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"憤怒的人挑起紛爭，","poem":1},{"text":"暴躁的人多有過犯。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"驕傲的人必遭貶抑，","poem":1},{"text":"謙卑的人必得尊榮。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"與盜賊為伍是憎惡自己，","poem":1},{"text":"他即使發誓也不敢作證。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"懼怕人的必自陷網羅，","poem":1},{"text":"信靠耶和華的必安穩。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"許多人討君王的歡心，","poem":1},{"text":"但正義伸張靠耶和華。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"為非作歹，義人厭惡；","poem":1},{"text":"行為正直，惡人憎恨。","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"「但正直的人保護他們」或譯「索取正直人的性命」。","reference":{"chapter":29,"verse":10}}]},"thisChapterLink":"/api/cmn_cbt/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}