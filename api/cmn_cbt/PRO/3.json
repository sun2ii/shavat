{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":3,"content":[{"type":"heading","content":["信靠耶和華"]},{"type":"verse","number":1,"content":[{"text":"孩子啊，不要忘記我的訓誨，","poem":1},{"text":"要把我的誡命存在心裡，","poem":2}]},{"type":"verse","number":2,"content":[{"text":"因為這必使你延年益壽，","poem":1},{"text":"幸福平安。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"不要讓慈愛和信實離開你，","poem":1},{"text":"要把它們繫在你的頸項上，","poem":2},{"lineBreak":true},{"text":"刻在你的心坎上。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"這樣，你必蒙上帝和世人的喜悅，","poem":1},{"text":"享有美譽。","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你要全心信靠耶和華，","poem":1},{"text":"不可倚靠自己的悟性。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"凡事都要信從祂，","poem":1},{"text":"祂必指引你走正路。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"不要自以為有智慧，","poem":1},{"text":"要敬畏耶和華，遠離惡事。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"這樣可醫治你的身體，","poem":1},{"text":"滋潤你的筋骨。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"你要用自己的財富和一切初熟的物產來尊崇耶和華，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂必使你五穀滿倉，","poem":1},{"text":"榨酒池溢出新釀。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"孩子啊，不可輕視耶和華的管教，","poem":1},{"text":"也不可厭煩祂的責備。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"因為耶和華管教祂所愛的人，","poem":1},{"text":"就像父親管教他所疼愛的孩子。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"找到智慧、得到悟性的人有福了，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因為智慧比銀子更有價值，","poem":1},{"text":"比金子更有益處，","poem":2}]},{"type":"verse","number":15,"content":[{"text":"比珠寶更珍貴；","poem":1},{"text":"你所喜愛的一切都難以相比。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"智慧的右手有長壽，","poem":1},{"text":"左手有富貴和尊榮。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"她的路上有福樂，","poem":1},{"text":"她的道上有平安。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"對持守智慧的人來說，","poem":1},{"text":"智慧是生命樹，","poem":2},{"lineBreak":true},{"text":"緊握智慧的人必蒙福。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"耶和華以智慧奠立大地，","poem":1},{"text":"以悟性鋪設諸天；","poem":2}]},{"type":"verse","number":20,"content":[{"text":"祂用知識使深淵裂開，","poem":1},{"text":"使天上降下甘露。","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"孩子啊，你要守護智慧和明辨力，","poem":1},{"text":"別讓她們離開你的視線。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"她們必給你帶來生命，","poem":1},{"text":"作你頸項上華美的裝飾。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"如此，你必步履穩健，不致失足；","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你必安然躺臥，睡得香甜。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"不要怕突來的災禍，","poem":1},{"text":"不要怕惡人遭毀滅，","poem":2}]},{"type":"verse","number":26,"content":[{"text":"因為耶和華是你的靠山，","poem":1},{"text":"祂使你的腳不陷入網羅。","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"倘若有力量行善，","poem":1},{"text":"就當幫助有需要的人，不要推託。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"倘若可以幫忙，","poem":1},{"text":"就不可對有求於你的鄰人說：","poem":2},{"lineBreak":true},{"text":"「回去吧，明天再來，我必給你！」","poem":2}]},{"type":"verse","number":29,"content":[{"text":"鄰舍在你附近安分居住，","poem":1},{"text":"不可謀害他。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"別人若沒有害你，","poem":1},{"text":"不要無故與他相爭。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"不要羡慕殘暴之徒，","poem":1},{"text":"也不可步其後塵，","poem":2}]},{"type":"verse","number":32,"content":[{"text":"因為耶和華憎惡邪僻之徒，","poem":1},{"text":"喜愛正直的人。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"耶和華咒詛惡人的家，","poem":1},{"text":"賜福義人的家。","poem":2}]},{"type":"verse","number":34,"content":[{"text":"耶和華譏笑好譏誚的人，","poem":1},{"text":"恩待謙卑的人。","poem":2}]},{"type":"verse","number":35,"content":[{"text":"智者得尊榮，","poem":1},{"text":"愚人受羞辱。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}