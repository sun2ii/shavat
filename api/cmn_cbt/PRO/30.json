{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":30,"content":[{"type":"heading","content":["亞古珥的箴言"]},{"type":"verse","number":1,"content":["以下是雅基的兒子亞古珥的箴言。",{"text":"這人說：上帝啊，我很疲倦；","poem":2},{"lineBreak":true},{"text":"上帝啊，我很疲倦，精疲力盡。","poem":2},{"noteId":11}]},{"type":"verse","number":2,"content":[{"text":"我比眾人都愚蠢，","poem":1},{"text":"不具備人的悟性。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"我從未學到智慧，","poem":1},{"text":"也不認識至聖者。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"誰升上高天又降下來？","poem":1},{"text":"誰將風聚在掌中？","poem":2},{"lineBreak":true},{"text":"誰將眾水裹在衣服裡？","poem":2},{"lineBreak":true},{"text":"誰定了地的邊界？","poem":2},{"lineBreak":true},{"text":"祂叫什麼名字？","poem":2},{"lineBreak":true},{"text":"祂兒子叫什麼名字？","poem":2},{"lineBreak":true},{"text":"你知道嗎？","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"上帝的話句句千真萬確，","poem":1},{"text":"祂作投靠祂之人的盾牌。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"你不可對祂的話有所添加，","poem":1},{"text":"免得祂責備你，","poem":2},{"lineBreak":true},{"text":"揭穿你的虛謊。","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"上帝啊，我向你求兩件事，","poem":1},{"text":"求你在我有生之年賜給我。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"求你使虛偽和謊言遠離我，","poem":1},{"text":"求你讓我不貧窮也不富足，","poem":2},{"lineBreak":true},{"text":"賜給我需用的飲食，","poem":2}]},{"type":"verse","number":9,"content":[{"text":"免得我因為飽足就不認你，","poem":1},{"text":"說：「耶和華是誰呢？」","poem":2},{"lineBreak":true},{"text":"又恐怕我因窮困而偷竊，","poem":2},{"lineBreak":true},{"text":"以致辱沒我上帝的名。","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"別向主人譭謗他的僕人，","poem":1},{"text":"免得你受咒詛、擔當罪責。","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"有一種","poem":1},{"noteId":12},{"text":"人咒詛父親，","poem":1},{"text":"不為母親祝福。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"有一種人自以為純潔，","poem":1},{"text":"卻沒有洗掉自己的污穢。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"有一種人趾高氣揚，","poem":1},{"text":"目空一切。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"有一種人牙如劍，","poem":1},{"text":"齒如刀，","poem":2},{"lineBreak":true},{"text":"要吞吃世間的困苦人和貧窮人。","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"水蛭有兩個女兒，","poem":1},{"text":"她們不停地叫：「給我！給我！」","poem":2},{"text":"三樣東西從不知足，","poem":1},{"lineBreak":true},{"text":"永不言「夠」的共有四樣：","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"陰間、不孕的婦人、","poem":1},{"text":"乾旱的土地和燒不夠的火焰。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"嘲笑父親、藐視母親教誨的，","poem":1},{"text":"眼睛必被谷中的烏鴉啄出，","poem":2},{"lineBreak":true},{"text":"被禿鷹吃掉。","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"我測不透的妙事有三樣，","poem":1},{"lineBreak":true},{"text":"我不明白的事共有四樣：","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"鷹在空中飛翔之道，","poem":1},{"text":"蛇在石上爬行之道，","poem":2},{"lineBreak":true},{"text":"船在海中航行之道，","poem":2},{"lineBreak":true},{"text":"男女相愛之道。","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"淫婦的道是這樣：","poem":1},{"text":"她吃完就擦擦嘴，","poem":2},{"lineBreak":true},{"text":"說，「我沒有做壞事。」","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"使大地震動的事有三樣，","poem":1},{"lineBreak":true},{"text":"大地無法承受的事共有四樣：","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"奴僕做王，","poem":1},{"text":"愚人吃飽，","poem":2}]},{"type":"verse","number":23,"content":[{"text":"醜惡女子出嫁，","poem":1},{"text":"婢女取代主母。","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"地上有四種動物，","poem":1},{"text":"身體雖小卻極其聰明：","poem":2}]},{"type":"verse","number":25,"content":[{"text":"螞蟻力量雖小，","poem":1},{"text":"卻在夏天儲備糧食；","poem":2}]},{"type":"verse","number":26,"content":[{"text":"石獾雖不強壯，","poem":1},{"text":"卻在巖石中做窩；","poem":2}]},{"type":"verse","number":27,"content":[{"text":"蝗蟲雖無君王，","poem":1},{"text":"卻整齊地列隊前進；","poem":2}]},{"type":"verse","number":28,"content":[{"text":"壁虎雖易捕捉，","poem":1},{"text":"卻居住在王宮大內。","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"步履威武的有三樣，","poem":1},{"lineBreak":true},{"text":"走路雄壯的共有四樣：","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"威震百獸、從不畏縮的獅子，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"昂首闊步的雄雞，","poem":1},{"text":"公山羊和率領軍隊的君王。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"你若行事愚昧、","poem":1},{"text":"妄自尊大或圖謀不軌，","poem":2},{"lineBreak":true},{"text":"就當用手掩口。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"激起憤怒會引起爭端，","poem":1},{"text":"正如攪牛奶會攪出奶油，","poem":2},{"lineBreak":true},{"text":"擰鼻子會擰出鼻血。","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"「這人說」希伯來文或譯「這人對以鐵說，對以鐵和烏甲說」。","reference":{"chapter":30,"verse":1}},{"noteId":12,"caller":"+","text":"「種」希伯來文是「世代」，11-14節也相同。","reference":{"chapter":30,"verse":11}}]},"thisChapterLink":"/api/cmn_cbt/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}