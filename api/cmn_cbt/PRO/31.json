{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":31,"content":[{"type":"heading","content":["利慕伊勒王的箴言"]},{"type":"verse","number":1,"content":["以下是利慕伊勒王的箴言，",{"text":"是他母親給他的教誨：","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"我兒，我親生的骨肉，","poem":1},{"text":"我許願得來的孩子啊，","poem":2},{"lineBreak":true},{"text":"我該怎樣教導你呢？","poem":2}]},{"type":"verse","number":3,"content":[{"text":"不要在女人身上耗費精力，","poem":1},{"text":"不要迷戀那些能毀滅王的人。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"利慕伊勒啊，","poem":1},{"text":"君王不可喝酒，","poem":2},{"lineBreak":true},{"text":"不可喝酒，","poem":2},{"lineBreak":true},{"text":"首領不宜喝烈酒，","poem":2}]},{"type":"verse","number":5,"content":[{"text":"免得喝酒後忘記律例，","poem":1},{"text":"不為困苦人伸張正義。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"把烈酒給行將滅亡的人，","poem":1},{"text":"把淡酒給心中憂傷的人，","poem":2}]},{"type":"verse","number":7,"content":[{"text":"讓他們喝了忘掉自己的貧窮，","poem":1},{"text":"不再記得自己的痛苦。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"要為不能自辯者說話，","poem":1},{"text":"為一切不幸的人伸冤。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"你要開口秉公審判，","poem":1},{"text":"為貧窮困苦者辯護。","poem":2}]},{"type":"heading","content":["賢德的妻子"]},{"type":"verse","number":10,"content":[{"noteId":13},{"text":"誰能找到賢德之妻？","poem":1},{"text":"她的價值遠勝過珠寶。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"她丈夫信賴她，","poem":1},{"text":"什麼也不缺乏。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"她一生對丈夫有益無損。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"她尋找羊毛和細麻，","poem":1},{"text":"愉快地親手做衣。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"她好像商船，","poem":1},{"text":"從遠方運來糧食。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"天未亮她就起床，","poem":1},{"text":"為全家預備食物，","poem":2},{"lineBreak":true},{"text":"分派婢女做家事。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"她選中田地便買下來，","poem":1},{"text":"親手賺錢栽種葡萄園。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"她精力充沛，","poem":1},{"text":"雙臂有力。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"她深諳經營之道，","poem":1},{"text":"她的燈徹夜不熄。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"她手拿捲線桿，","poem":1},{"text":"手握紡線錘。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"她樂於賙濟窮人，","poem":1},{"text":"伸手幫助困苦者。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"她不因下雪而為家人擔心，","poem":1},{"text":"因為全家都穿著朱紅暖衣。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"她為自己縫製繡花毯，","poem":1},{"text":"用細麻和紫布做衣服。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"她丈夫在城門口與當地長老同坐，","poem":1},{"text":"受人尊重。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"她縫製細麻衣裳出售，","poem":1},{"text":"又製作腰帶賣給商人。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"她充滿力量和尊榮，","poem":1},{"text":"她以笑顏迎接未來。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"她說的話帶著智慧，","poem":1},{"text":"她的訓言充滿慈愛。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"她料理一切家務，","poem":1},{"text":"從不偷懶吃閒飯。","poem":2}]},{"type":"verse","number":28,"content":[{"text":"她的兒女肅立，","poem":1},{"text":"為她祝福，","poem":2},{"lineBreak":true},{"text":"她的丈夫也稱讚她，","poem":2}]},{"type":"verse","number":29,"content":[{"text":"說：「世上賢德的女子很多，","poem":1},{"text":"唯有你無與倫比。」","poem":2}]},{"type":"verse","number":30,"content":[{"text":"豔麗是虛假的，","poem":1},{"text":"美貌是短暫的，","poem":2},{"lineBreak":true},{"text":"唯有敬畏耶和華的女子配得稱讚。","poem":2}]},{"type":"verse","number":31,"content":[{"text":"願她享受自己的勞動成果，","poem":1},{"text":"願她的事蹟使她在城門口受稱讚。","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"10-30節是字母詩，每一節依次由一個希伯來字母開頭。","reference":{"chapter":31,"verse":10}}]},"thisChapterLink":"/api/cmn_cbt/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}