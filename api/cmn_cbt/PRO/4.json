{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":4,"content":[{"type":"heading","content":["父親的教誨"]},{"type":"verse","number":1,"content":[{"text":"孩子們啊，","poem":1},{"text":"你們要聽從父親的教誨，","poem":2},{"lineBreak":true},{"text":"留心學習，以便領悟，","poem":2}]},{"type":"verse","number":2,"content":[{"text":"因為我給你們的訓誨是美好的，","poem":1},{"text":"不可背棄我的教導。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"我年幼時在父親身邊，","poem":1},{"text":"是母親唯一的寵兒。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"父親教導我說：","poem":1},{"text":"「你心裡要牢記我的話，","poem":2},{"lineBreak":true},{"text":"遵守我的誡命，就必存活。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"你要求取智慧和悟性，","poem":1},{"text":"不要忘記或違背我的吩咐。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"不可離棄智慧，智慧必護佑你；","poem":1},{"text":"你要熱愛智慧，智慧必看顧你。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"智慧至上，要求取智慧，","poem":1},{"text":"要不惜一切獲取悟性。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"高舉智慧，她必使你受尊崇；","poem":1},{"text":"擁抱智慧，她必使你得尊榮。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"她必為你戴上華冠，","poem":1},{"text":"加上榮冕。」","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"孩子啊，你要聽從我的教導，","poem":1},{"text":"就必延年益壽。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"我已經指示你走智慧之道，","poem":1},{"text":"引導你行正確的路。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"你行走，腳下不受阻礙；","poem":1},{"text":"你奔跑，也不會跌倒。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"你要持守教誨，不要鬆懈；","poem":1},{"text":"要守護好，因為那是你的生命。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"不要涉足惡人的道，","poem":1},{"text":"不要行走壞人的路；","poem":2}]},{"type":"verse","number":15,"content":[{"text":"要避開，不可踏足，","poem":1},{"text":"要繞道前行。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"因為他們不作惡就無法入睡，","poem":1},{"text":"不絆倒人就無法安眠；","poem":2}]},{"type":"verse","number":17,"content":[{"text":"他們吃的是邪惡餅，","poem":1},{"text":"喝的是殘暴酒。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"義人的道路好像黎明的曙光，","poem":1},{"text":"越照越亮，直到正午。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"惡人的道路一片幽暗，","poem":1},{"text":"他們不知被何物絆倒。","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"孩子啊，你要聆聽我的吩咐，","poem":1},{"text":"側耳聽我的訓言；","poem":2}]},{"type":"verse","number":21,"content":[{"text":"不要讓它們離開你的視線，","poem":1},{"text":"要牢記在心。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"因為得到它們就得到生命，","poem":1},{"text":"全身也必康健。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"要一絲不苟地守護你的心，","poem":1},{"text":"因為生命之泉從心中湧出。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"不講欺詐之言，","poem":1},{"text":"不說荒謬的話。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"眼睛要正視前方，","poem":1},{"text":"雙目要向前直看。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"要鋪平腳下的路，","poem":1},{"text":"使所行之道穩妥。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"不可偏右偏左，","poem":1},{"text":"要遠離惡事。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}