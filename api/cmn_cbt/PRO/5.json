{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":5,"content":[{"type":"heading","content":["遠避淫亂"]},{"type":"verse","number":1,"content":[{"text":"孩子啊，要留心聽我的智言，","poem":1},{"text":"側耳聽我的慧語，","poem":2}]},{"type":"verse","number":2,"content":[{"text":"好保持明辨力，","poem":1},{"text":"嘴唇謹守知識。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"淫婦滿口甜言蜜語，","poem":1},{"text":"油嘴滑舌，","poem":2}]},{"type":"verse","number":4,"content":[{"text":"最後卻苦如艾草，","poem":1},{"text":"鋒利似雙刃劍。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"她的雙腳走進死地，","poem":1},{"text":"她的步伐邁向陰間。","poem":2}]},{"type":"verse","number":6,"content":[{"text":"她不走生命的康莊大道，","poem":1},{"text":"偏離了正途也不自知。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"孩子們啊，要聽從我，","poem":1},{"text":"不可違背我的話！","poem":2}]},{"type":"verse","number":8,"content":[{"text":"要遠遠避開淫婦，","poem":1},{"text":"不可靠近她的家門，","poem":2}]},{"type":"verse","number":9,"content":[{"text":"免得你為別人枉費精力，","poem":1},{"text":"為殘忍之徒斷送青春；","poem":2}]},{"type":"verse","number":10,"content":[{"text":"免得外人吞盡你的財富，","poem":1},{"text":"你的辛勞所得歸給外人。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"臨終之時，肉體衰殘，","poem":1},{"text":"你必呻吟不止，","poem":2}]},{"type":"verse","number":12,"content":[{"text":"說：「我為何厭惡教誨，","poem":1},{"text":"心裡藐視責備！","poem":2}]},{"type":"verse","number":13,"content":[{"text":"不聽從老師的話，","poem":1},{"text":"不側耳聽導師之言。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"在會眾當中，","poem":1},{"text":"我幾乎身敗名裂。」","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"你當喝自己池中的水，","poem":1},{"text":"飲自己井裡的活水。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"你的泉水豈可外流？","poem":1},{"text":"你的河水怎可溢到街上？","poem":2}]},{"type":"verse","number":17,"content":[{"text":"這些要專屬於你，","poem":1},{"text":"不可與外人共享。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"要使你的泉源蒙福，","poem":1},{"text":"要愛你年輕時所娶的妻。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"她秀美可愛宛如母鹿，","poem":1},{"text":"願她的胸令你時時滿足，","poem":2},{"lineBreak":true},{"text":"願她的愛讓你常常陶醉。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"孩子啊，為何迷戀淫婦？","poem":1},{"text":"為何擁抱妓女的胸？","poem":2}]},{"type":"verse","number":21,"content":[{"text":"因為人的所作所為逃不過耶和華的眼目，","poem":1},{"text":"祂必鑒察人一切所行之道。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"惡人被自己的罪惡捉住，","poem":1},{"text":"被自己罪惡的繩索捆綁。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"他因不聽管教而喪命，","poem":1},{"text":"因極其愚妄而入歧途。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}