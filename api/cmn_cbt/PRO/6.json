{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":6,"content":[{"type":"heading","content":["日常警言"]},{"type":"verse","number":1,"content":[{"text":"孩子啊，你若為鄰人作保，","poem":1},{"text":"為外人擊掌立約，","poem":2}]},{"type":"verse","number":2,"content":[{"text":"你就被自己口中的話套住，","poem":1},{"text":"被自己的諾言纏住。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"孩子啊，你已落入鄰人的手中，","poem":1},{"text":"你當如此自救：","poem":2},{"lineBreak":true},{"text":"要謙卑地向他求情。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"勿讓你的眼睛睡覺，","poem":1},{"text":"莫叫你的眼皮打盹。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"要救自己脫離困境，","poem":1},{"text":"像羚羊掙脫獵人的手，","poem":2},{"lineBreak":true},{"text":"飛鳥逃脫捕鳥人的手。","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"懶惰的人啊，去看看螞蟻，","poem":1},{"text":"觀察牠的生活，就會有智慧。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"螞蟻沒有元帥，","poem":1},{"text":"沒有官長，","poem":2},{"lineBreak":true},{"text":"也沒有君王，","poem":2}]},{"type":"verse","number":8,"content":[{"text":"卻在夏季儲備糧食，","poem":1},{"text":"在收割時積聚食物。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"懶惰的人啊，你要躺到何時？","poem":1},{"text":"要睡到何時才起床？","poem":2}]},{"type":"verse","number":10,"content":[{"text":"再睡一會兒，再打個盹兒，","poem":1},{"text":"再抱著手躺一會兒，","poem":2}]},{"type":"verse","number":11,"content":[{"text":"貧窮必像盜賊一樣臨到你，","poem":1},{"text":"缺乏必像武士一樣撲向你。","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"無賴與惡人滿口詭詐，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"擠眉弄眼，指手畫腳，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"心術不正，圖謀惡事，常常挑起爭端。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因此，災難必突然臨到，","poem":1},{"text":"他們頃刻之間遭到毀滅，","poem":2},{"lineBreak":true},{"text":"無可挽救。","poem":2}]},{"type":"verse","number":16,"content":[{"text":"耶和華所憎惡的事有六樣，","poem":1},{"lineBreak":true},{"text":"連祂厭惡的事共有七樣：","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"高傲的眼睛，","poem":1},{"text":"撒謊的舌頭，","poem":2},{"lineBreak":true},{"text":"殺害無辜的手，","poem":2}]},{"type":"verse","number":18,"content":[{"text":"圖謀詭計的心，","poem":1},{"text":"奔跑作惡的腳，","poem":2}]},{"type":"verse","number":19,"content":[{"text":"撒謊的假證人，","poem":1},{"text":"以及在弟兄中挑起爭端的人。","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"孩子啊，要遵守你父親的誡命，","poem":1},{"text":"不可背棄你母親的訓誨。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"你要常常將這些繫在心坎上，","poem":1},{"text":"戴在頸項上。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"你行走，它們必引領你；","poem":1},{"text":"你躺臥，它們必護衛你；","poem":2},{"lineBreak":true},{"text":"你醒來，它們必與你交談。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"因為誡命是燈，訓誨是光，","poem":1},{"text":"管教和責備是生命之道，","poem":2}]},{"type":"verse","number":24,"content":[{"text":"能使你遠離邪惡的女人，","poem":1},{"text":"避開油嘴滑舌的妓女。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"你的心不要貪戀她的美色，","poem":1},{"text":"也不要被她的媚眼所迷惑，","poem":2}]},{"type":"verse","number":26,"content":[{"text":"因為娼妓會使人傾家蕩產","poem":1},{"noteId":1},{"text":"，","poem":1},{"text":"淫婦會獵殺人寶貴的生命。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"人若將火藏在懷中，","poem":1},{"text":"哪能不燒著衣服呢？","poem":2}]},{"type":"verse","number":28,"content":[{"text":"人若行走在火炭上，","poem":1},{"text":"哪能不燙傷雙腳呢？","poem":2}]},{"type":"verse","number":29,"content":[{"text":"與別人妻子通姦也是這樣，","poem":1},{"text":"凡親近她的必難逃罪責。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"賊因充饑而偷，","poem":1},{"text":"沒有人藐視他；","poem":2}]},{"type":"verse","number":31,"content":[{"text":"但若被抓到，他要償還七倍，","poem":1},{"text":"就是傾家蕩產也要償還。","poem":2}]},{"type":"verse","number":32,"content":[{"text":"和有夫之婦通姦的，","poem":1},{"text":"實在愚不可及，","poem":2},{"lineBreak":true},{"text":"他是自尋死路。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"他必挨打，受辱，","poem":1},{"text":"他的恥辱永難抹去。","poem":2}]},{"type":"verse","number":34,"content":[{"text":"那丈夫妒火燃燒，","poem":1},{"text":"報仇時絕不留情。","poem":2}]},{"type":"verse","number":35,"content":[{"text":"賠他再多財物，他也不會接受；","poem":1},{"text":"送他再多禮物，他都不肯甘休。","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"「娼妓會使人傾家蕩產」或譯「娼妓的嫖資不過是一個餅」。","reference":{"chapter":6,"verse":26}}]},"thisChapterLink":"/api/cmn_cbt/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}