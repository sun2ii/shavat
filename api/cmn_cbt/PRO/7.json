{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":7,"content":[{"type":"heading","content":["要遠離淫婦"]},{"type":"verse","number":1,"content":[{"text":"孩子啊，你要遵從我的吩咐，","poem":1},{"text":"把我的誡命珍藏在心中。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"遵守我的誡命，你便存活。","poem":1},{"text":"要愛護我的訓誨，","poem":2},{"lineBreak":true},{"text":"如愛護眼中的瞳人。","poem":2}]},{"type":"verse","number":3,"content":[{"text":"要繫在你的指頭上，","poem":1},{"text":"刻在你的心版上。","poem":2}]},{"type":"verse","number":4,"content":[{"text":"你要把智慧當作姊妹，","poem":1},{"text":"將悟性視為親人。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"她們能使你遠離淫婦，","poem":1},{"text":"遠離妓女的甜言蜜語。","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我曾在家裡的窗前，","poem":1},{"text":"透過窗櫺往外觀看，","poem":2}]},{"type":"verse","number":7,"content":[{"text":"只見在愚昧人中，","poem":1},{"text":"有個無知的青年，","poem":2}]},{"type":"verse","number":8,"content":[{"text":"他穿過靠近淫婦的巷口，","poem":1},{"text":"朝她的家門走去，","poem":2}]},{"type":"verse","number":9,"content":[{"text":"趁著日暮黃昏，","poem":1},{"text":"藉著夜色昏暗。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"看啊！一個妓女打扮、","poem":1},{"text":"心術不正的女子出來迎接他。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"她喧嚷放蕩，不安分守家，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"有時在街上，有時在廣場，","poem":1},{"text":"或在各巷口守候。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"她纏著那青年，與他親吻，","poem":1},{"text":"厚顏無恥地說：","poem":2}]},{"type":"verse","number":14,"content":[{"text":"「我今天剛獻祭還了願，","poem":1},{"text":"家裡有平安祭肉","poem":2},{"noteId":2},{"text":"，","poem":2}]},{"type":"verse","number":15,"content":[{"text":"因此我出來迎接你，尋找你，","poem":1},{"text":"終於找到了你！","poem":2}]},{"type":"verse","number":16,"content":[{"text":"我已經鋪好了床，","poem":1},{"text":"鋪上了埃及的繡花布，","poem":2}]},{"type":"verse","number":17,"content":[{"text":"又用沒藥、沉香、肉桂薰了床。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"來吧，讓我們通宵暢飲愛情，","poem":1},{"text":"讓我們盡情歡愛！","poem":2}]},{"type":"verse","number":19,"content":[{"text":"因為我丈夫不在家，出遠門了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他帶著錢囊去了，月圓才回來。」","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"淫婦花言巧語勾引他，","poem":1},{"text":"用諂媚的話語誘惑他。","poem":2}]},{"type":"verse","number":22,"content":[{"text":"那青年立刻隨她而去，","poem":1},{"text":"像走向屠宰場的公牛，","poem":2},{"lineBreak":true},{"text":"又像掉入陷阱的雄鹿，","poem":2}]},{"type":"verse","number":23,"content":[{"text":"直等到利箭射穿他的肝。","poem":1},{"text":"他像隻自投網羅的飛鳥，","poem":2},{"lineBreak":true},{"text":"渾然不知要賠上性命！","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"孩子們啊，你們要聽從我的話，","poem":1},{"text":"留意我口中的訓言，","poem":2}]},{"type":"verse","number":25,"content":[{"text":"別讓你的心偏向淫婦的道，","poem":1},{"text":"步入她的歧途。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"因為她使許多人喪命，","poem":1},{"text":"被她殺害的數目眾多。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"她的家是通往陰間的路，","poem":1},{"text":"引人墜入死亡之室。","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"按猶太律法規定，還願之後所得的祭肉要在第二天吃完。參考利未記7·16。","reference":{"chapter":7,"verse":14}}]},"thisChapterLink":"/api/cmn_cbt/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}