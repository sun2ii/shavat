{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":8,"content":[{"type":"heading","content":["智慧的呼喚"]},{"type":"verse","number":1,"content":[{"text":"智慧不是在呼喚嗎？","poem":1},{"text":"悟性不是在吶喊嗎？","poem":2}]},{"type":"verse","number":2,"content":[{"text":"她在路邊高處站立，","poem":1},{"text":"她在十字街頭停留，","poem":2}]},{"type":"verse","number":3,"content":[{"text":"在城門旁，在入口處大喊：","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"「世人啊，我呼喚你們，","poem":1},{"text":"我向天下人大聲呼籲。","poem":2}]},{"type":"verse","number":5,"content":[{"text":"愚昧人啊，要學會謹慎！","poem":1},{"text":"愚頑人啊，要慎思明辨！","poem":2}]},{"type":"verse","number":6,"content":[{"text":"你們聽啊，我要說美好的話，","poem":1},{"text":"開口談論正直的事。","poem":2}]},{"type":"verse","number":7,"content":[{"text":"我的口傳揚真理，","poem":1},{"text":"我的嘴憎恨邪惡。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"我口中的言語公正，","poem":1},{"text":"沒有歪曲錯謬的話。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"我的話，智者明白，哲士認同。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"要接受我的教誨，而非白銀；","poem":1},{"text":"要選擇知識，而非黃金。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"因為智慧比寶石更珍貴，","poem":1},{"text":"一切美物都不能與之相比。","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"「我智慧與謹慎同住，","poem":1},{"text":"我擁有知識和明辨力。","poem":2}]},{"type":"verse","number":13,"content":[{"text":"敬畏耶和華就當憎恨邪惡，","poem":1},{"text":"我憎恨驕傲、狂妄、惡道和謊言。","poem":2}]},{"type":"verse","number":14,"content":[{"text":"我有謀略和真知，","poem":1},{"text":"又有悟性和能力。","poem":2}]},{"type":"verse","number":15,"content":[{"text":"君王靠我安邦定國，","poem":1},{"text":"首領藉我秉公行義，","poem":2}]},{"type":"verse","number":16,"content":[{"text":"王公大臣靠我治理天下，","poem":1},{"text":"官宦貴胄憑我公正斷案。","poem":2}]},{"type":"verse","number":17,"content":[{"text":"愛我的，我也愛他；","poem":1},{"text":"懇切尋求我的，必能尋見。","poem":2}]},{"type":"verse","number":18,"content":[{"text":"富貴和尊榮在我，","poem":1},{"text":"恆久的財富和公義也在我。","poem":2}]},{"type":"verse","number":19,"content":[{"text":"我的果實勝過純金，","poem":1},{"text":"我的出產勝過純銀。","poem":2}]},{"type":"verse","number":20,"content":[{"text":"我在公義的道上奔走，","poem":1},{"text":"在公平的路上前行。","poem":2}]},{"type":"verse","number":21,"content":[{"text":"我要賜財富給愛我的人，","poem":1},{"text":"使他們的庫房充盈。","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"「在耶和華造物的起頭，","poem":1},{"text":"在太初萬物被造以前，","poem":2},{"lineBreak":true},{"text":"就已經有我。","poem":2}]},{"type":"verse","number":23,"content":[{"text":"從亙古，從太初，","poem":1},{"text":"大地還沒有形成以前，","poem":2},{"lineBreak":true},{"text":"我已經被立。","poem":2}]},{"type":"verse","number":24,"content":[{"text":"沒有深淵，","poem":1},{"text":"沒有湧流的水泉以前，","poem":2},{"lineBreak":true},{"text":"我已經誕生。","poem":2}]},{"type":"verse","number":25,"content":[{"text":"大山未曾奠定，","poem":1},{"text":"小丘未曾形成，","poem":2},{"lineBreak":true},{"text":"我已經出生。","poem":2}]},{"type":"verse","number":26,"content":[{"text":"那時耶和華還沒有造大地和原野，","poem":1},{"text":"還沒有造一粒塵土。","poem":2}]},{"type":"verse","number":27,"content":[{"text":"祂鋪設諸天的時候，我已在場。","poem":1},{"text":"祂在深淵上畫出地平線，","poem":2}]},{"type":"verse","number":28,"content":[{"text":"上使穹蒼堅固，","poem":1},{"text":"下使深淵的泉源安穩，","poem":2}]},{"type":"verse","number":29,"content":[{"text":"設定滄海的界限，","poem":1},{"text":"使海水不得越過祂定的範圍，","poem":2},{"lineBreak":true},{"text":"為大地奠定根基。","poem":2}]},{"type":"verse","number":30,"content":[{"text":"那時，我就在祂身旁，","poem":1},{"text":"做祂的工程師，","poem":2},{"lineBreak":true},{"text":"天天成為祂的喜樂，","poem":2},{"lineBreak":true},{"text":"終日在祂面前歡悅，","poem":2}]},{"type":"verse","number":31,"content":[{"text":"因祂所造的人世而歡悅，","poem":1},{"text":"因祂所造的世人而喜樂。","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"「孩子們啊，你們要聽從我，","poem":1},{"text":"持守我道路的人有福了。","poem":2}]},{"type":"verse","number":33,"content":[{"text":"要聽從教誨，不可輕忽，","poem":1},{"text":"要做智者。","poem":2}]},{"type":"verse","number":34,"content":[{"text":"人若聽從我、天天在我門口仰望、","poem":1},{"text":"在我門邊等候，就有福了。","poem":2}]},{"type":"verse","number":35,"content":[{"text":"因為找到我的，便找到了生命，","poem":1},{"text":"他必蒙耶和華的恩惠。","poem":2}]},{"type":"verse","number":36,"content":[{"text":"沒找到我就是害自己；","poem":1},{"text":"憎恨我就是喜愛死亡。」","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}