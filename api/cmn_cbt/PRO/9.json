{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cbt","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"6852ea39622ec530f4caf76a373c08077480224164f99cb5ebaba2a71c6d6ea8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cbt/PRO/31.json","totalNumberOfVerses":914},"chapter":{"number":9,"content":[{"type":"heading","content":["智慧和愚昧"]},{"type":"verse","number":1,"content":[{"text":"智慧建造她的房屋，","poem":1},{"text":"她鑿出七根柱子。","poem":2}]},{"type":"verse","number":2,"content":[{"text":"她宰了牲口，","poem":1},{"text":"調了美酒，","poem":2},{"lineBreak":true},{"text":"設了宴席，","poem":2}]},{"type":"verse","number":3,"content":[{"text":"派婢女出去邀請賓客，","poem":1},{"text":"自己在城中高處呼喊：","poem":2}]},{"type":"verse","number":4,"content":[{"text":"「愚昧人啊，到這裡來吧！」","poem":1},{"text":"她又對無知者說：","poem":2}]},{"type":"verse","number":5,"content":[{"text":"「來吃我做的飯，","poem":1},{"text":"喝我調的酒吧！","poem":2}]},{"type":"verse","number":6,"content":[{"text":"你們要拋棄愚昧，就能存活，","poem":1},{"text":"要轉向悟性之道。」","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"糾正嘲諷者，必自招羞辱；","poem":1},{"text":"責備惡人，必自招傷害。","poem":2}]},{"type":"verse","number":8,"content":[{"text":"不要責備嘲諷者，免得他恨你；","poem":1},{"text":"要責備智者，他必愛你。","poem":2}]},{"type":"verse","number":9,"content":[{"text":"教導智者，他就更有智慧；","poem":1},{"text":"指教義人，他就更有見識。","poem":2}]},{"type":"verse","number":10,"content":[{"text":"智慧始於敬畏耶和華，","poem":1},{"text":"認識至聖者便是明智。","poem":2}]},{"type":"verse","number":11,"content":[{"text":"智慧可增添你的年日，","poem":1},{"text":"加添你的壽數。","poem":2}]},{"type":"verse","number":12,"content":[{"text":"人有智慧，自得益處；","poem":1},{"text":"人好嘲諷，自食惡果。","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"愚昧的女人喧嚷，蒙昧，無知。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"她坐在自己的家門口，","poem":1},{"text":"坐在城中高處的座位上，","poem":2}]},{"type":"verse","number":15,"content":[{"text":"招呼著匆匆前行的過客：","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"「愚昧人啊，到這裡來吧！」","poem":1},{"text":"她又對無知者說：","poem":2}]},{"type":"verse","number":17,"content":[{"text":"「偷來的水甜，偷來的餅香。」","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他們卻不知她那裡亡魂幢幢，","poem":1},{"text":"她的客人已落在陰間的深處。","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}