t":"惡人的路必通向滅亡。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}