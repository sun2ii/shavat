{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":10,"content":[{"type":"heading","content":["求上帝懲治惡人"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，你為何遠遠站著？","poem":1},{"lineBreak":true},{"text":"為何在我遭難時隱藏起來？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"惡人狂妄地追逼窮苦人，","poem":1},{"lineBreak":true},{"text":"願他們落入自己所設的圈套。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"惡人誇耀自己的貪慾，","poem":1},{"lineBreak":true},{"text":"貪婪的人咒詛和藐視耶和華。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們狂傲自大，不尋求耶和華，","poem":1},{"lineBreak":true},{"text":"他們心中沒有上帝。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們凡事順利，","poem":1},{"lineBreak":true},{"text":"對你的審判不屑一顧，","poem":1},{"lineBreak":true},{"text":"對所有的仇敵嗤之以鼻。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們自以為可以屹立不倒，","poem":1},{"lineBreak":true},{"text":"世世代代永不遭殃。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們滿口咒詛、謊話和恐嚇之言，","poem":1},{"lineBreak":true},{"text":"舌頭沾滿禍害和邪惡。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們埋伏在村莊，","poem":1},{"lineBreak":true},{"text":"暗中殺害無辜，偷偷監視受害者。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們像獅子埋伏在暗處，","poem":1},{"lineBreak":true},{"text":"伺機獵取無助的人，","poem":1},{"lineBreak":true},{"text":"用網羅拖走他們。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"無助的人被擊垮，","poem":1},{"lineBreak":true},{"text":"倒在他們的暴力下。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們自言自語：「上帝忘記了，","poem":1},{"lineBreak":true},{"text":"祂掩面不理，永不察看！」","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和華啊，求你起來！","poem":1},{"lineBreak":true},{"text":"上帝啊，求你舉手施罰，","poem":1},{"lineBreak":true},{"text":"不要忘記無助的人！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"惡人為何藐視上帝，","poem":1},{"lineBreak":true},{"text":"以為上帝不會追究呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"但你已看到世人的疾苦，","poem":1},{"lineBreak":true},{"text":"隨時伸出援手。","poem":1},{"lineBreak":true},{"text":"困苦無助的人投靠你，","poem":1},{"lineBreak":true},{"text":"你是孤兒的幫助。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"求你打斷惡人的臂膀，","poem":1},{"lineBreak":true},{"text":"徹底追究他們的罪惡。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華永永遠遠是君王，","poem":1},{"lineBreak":true},{"text":"列國必從祂的土地上滅亡。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"你知道困苦人的願望，","poem":1},{"lineBreak":true},{"text":"你必垂聽他們的呼求，","poem":1},{"lineBreak":true},{"text":"使他們心裡剛強。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你為孤兒和受欺壓的人伸冤，","poem":1},{"lineBreak":true},{"text":"使區區世人不能再恐嚇他們。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}