{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":101,"content":[{"type":"heading","content":["君王的諾言"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"我要歌頌你的慈愛和公正，","poem":1},{"lineBreak":true},{"text":"我要頌讚你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要謹慎行事，","poem":1},{"lineBreak":true},{"text":"走正直的路，","poem":1},{"lineBreak":true},{"text":"你何時來我這裡？","poem":1},{"lineBreak":true},{"text":"我要存純全的心在家中行事。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我要棄絕惡事，","poem":1},{"lineBreak":true},{"text":"我憎惡背棄上帝者的行為，","poem":1},{"lineBreak":true},{"text":"不沾染他們的惡行。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要遠離心術不正的人，","poem":1},{"lineBreak":true},{"text":"不與邪惡的事有任何瓜葛。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我要消滅暗中譭謗鄰居的人，","poem":1},{"lineBreak":true},{"text":"也不容忍心高氣傲的人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我要看顧地上忠信的人，","poem":1},{"lineBreak":true},{"text":"讓他們與我同住。","poem":1},{"lineBreak":true},{"text":"行事正直的人才能服侍我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"詭詐的人必不得與我同住，","poem":1},{"lineBreak":true},{"text":"口出謊言的人必不得侍立在我面前。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"每天早晨我要消滅國中所有的惡人，","poem":1},{"lineBreak":true},{"text":"從耶和華的城中剷除一切作惡的人。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}