{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":102,"content":[{"type":"heading","content":["患難中的祈禱"]},{"type":"hebrew_subtitle","content":["受苦之人的禱告，在疲憊不堪時向耶和華的傾訴。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你聽我的禱告，","poem":1},{"lineBreak":true},{"text":"願我的呼求達到你面前！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在危難的時候，","poem":1},{"lineBreak":true},{"text":"求你不要掩面不理我。","poem":1},{"lineBreak":true},{"text":"我的呼求的時候，求你垂聽，","poem":1},{"lineBreak":true},{"text":"趕快應允我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的年日如煙消散，","poem":1},{"lineBreak":true},{"text":"我的骨頭如火焚燒。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的心被摧殘，如草枯萎，","poem":1},{"lineBreak":true},{"text":"以致我不思飲食。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我因哀歎而瘦骨嶙峋。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我就像曠野中的鴞鳥，","poem":1},{"lineBreak":true},{"text":"又像廢墟中的貓頭鷹。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我無法入睡，","poem":1},{"lineBreak":true},{"text":"我就像屋頂上一隻孤伶伶的麻雀。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的仇敵終日辱罵我，","poem":1},{"lineBreak":true},{"text":"嘲笑我的用我的名字咒詛人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我以爐灰為食物，","poem":1},{"lineBreak":true},{"text":"眼淚拌著水喝，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因為你向我大發烈怒，","poem":1},{"lineBreak":true},{"text":"把我撿起來扔掉了。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的年日像黃昏的影子，","poem":1},{"lineBreak":true},{"text":"又如枯乾的草芥。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和華啊！唯有你永遠做王，","poem":1},{"lineBreak":true},{"text":"你的大名萬代長存。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你必起來憐憫錫安，","poem":1},{"lineBreak":true},{"text":"因為該恩待她了，時候已到。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你的僕人們喜愛城中的石頭，","poem":1},{"lineBreak":true},{"text":"憐惜城中的塵土。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"列國敬畏耶和華的名，","poem":1},{"lineBreak":true},{"text":"世上的君王都敬畏祂的榮耀。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因為耶和華必重建錫安，","poem":1},{"lineBreak":true},{"text":"帶著榮耀顯現。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂必垂聽窮人的禱告，","poem":1},{"lineBreak":true},{"text":"不藐視他們的祈求。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"要為後代記下這一切，","poem":1},{"lineBreak":true},{"text":"好讓將來受造的人讚美耶和華。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和華從至高的聖所俯視人間，","poem":1},{"lineBreak":true},{"text":"從天上察看大地，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"要垂聽被囚之人的哀歎，","poem":1},{"lineBreak":true},{"text":"釋放被定死罪的人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"這樣，萬族萬國聚集敬拜","poem":1},{"lineBreak":true},{"text":"耶和華時，","poem":1},{"lineBreak":true},{"text":"人們必在錫安傳揚祂的名，","poem":1},{"lineBreak":true},{"text":"在耶路撒冷讚美祂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"祂使我未老先衰，","poem":1},{"lineBreak":true},{"text":"縮短了我的歲月。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我說：「我的上帝啊，","poem":1},{"lineBreak":true},{"text":"你世代長存，","poem":1},{"lineBreak":true},{"text":"求你不要叫我中年早逝。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"太初你奠立大地的根基，","poem":1},{"lineBreak":true},{"text":"親手創造諸天。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"天地都要消亡，","poem":1},{"lineBreak":true},{"text":"但你永遠長存。","poem":1},{"lineBreak":true},{"text":"天地都會像外衣漸漸破舊，","poem":1},{"lineBreak":true},{"text":"你必更換天地，如同更換衣服，","poem":1},{"lineBreak":true},{"text":"天地都要消逝。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"但你永遠不變，","poem":1},{"lineBreak":true},{"text":"你的年日永無窮盡。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你僕人的後代必生生不息，","poem":1},{"lineBreak":true},{"text":"他們的子孫必在你面前堅立。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":27}