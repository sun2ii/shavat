{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":104,"content":[{"type":"heading","content":["稱頌創造主上帝"]},{"type":"verse","number":1,"content":[{"text":"我的心啊，要稱頌耶和華。","poem":1},{"lineBreak":true},{"text":"我的上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"你是多麼偉大！","poem":1},{"lineBreak":true},{"text":"你以尊貴和威嚴為衣，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你身披光華如披外袍，","poem":1},{"lineBreak":true},{"text":"你鋪展穹蒼如鋪幔子。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂在水上立起樓閣的棟梁。","poem":1},{"lineBreak":true},{"text":"祂以雲彩為車駕，乘風飛馳。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂以風為使者，","poem":1},{"lineBreak":true},{"text":"以火焰為僕役。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂將大地立在根基上，","poem":1},{"lineBreak":true},{"text":"使它永不動搖。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你以深水為衣覆蓋大地，","poem":1},{"lineBreak":true},{"text":"使大水淹沒群山。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你一聲怒叱，眾水便奔逃；","poem":1},{"lineBreak":true},{"text":"你一聲雷鳴，眾水就奔流，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"漫過山巒，流進山谷，","poem":1},{"lineBreak":true},{"text":"歸到你指定的地方。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你為眾水劃定不可逾越的界線，","poem":1},{"lineBreak":true},{"text":"以免大地再遭淹沒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和華使泉水湧流在谷地，","poem":1},{"lineBreak":true},{"text":"奔騰在山間，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"讓野地的動物有水喝，","poem":1},{"lineBreak":true},{"text":"野驢可以解渴。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"飛鳥也在溪旁棲息，","poem":1},{"lineBreak":true},{"text":"在樹梢上歌唱。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂從天上的樓閣降雨在山間，","poem":1},{"lineBreak":true},{"text":"大地因祂的作為而豐美富饒。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂使綠草生長，滋養牲畜，","poem":1},{"lineBreak":true},{"text":"讓人種植作物，","poem":1},{"lineBreak":true},{"text":"享受大地的出產，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"有沁人心懷的醇酒、","poem":1},{"lineBreak":true},{"text":"滋潤容顏的膏油、","poem":1},{"lineBreak":true},{"text":"增強活力的五穀。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華種植了黎巴嫩的香柏樹，","poem":1},{"lineBreak":true},{"text":"使它們得到充沛的水源，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"鳥兒在樹上搭窩，","poem":1},{"lineBreak":true},{"text":"鸛鳥在松樹上棲息。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"高山是野山羊的住處，","poem":1},{"lineBreak":true},{"text":"峭壁是石獾的藏身之所。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你命月亮定節令，","poem":1},{"lineBreak":true},{"text":"使太陽自知西沉。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你造黑暗，定為夜晚，","poem":1},{"lineBreak":true},{"text":"作林中百獸出沒的時間。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"猛獅吼叫著覓食，","poem":1},{"lineBreak":true},{"text":"尋找上帝所賜的食物。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"太陽升起，","poem":1},{"lineBreak":true},{"text":"百獸便躲避，臥在洞中，","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"人們外出工作，直到黃昏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"耶和華啊，你的創造如此繁多！","poem":1},{"lineBreak":true},{"text":"你用智慧造了這一切，","poem":1},{"lineBreak":true},{"text":"大地充滿了你創造的萬物。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"汪洋浩瀚，","poem":1},{"lineBreak":true},{"text":"充滿了無數的大小水族，","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"船隻往來於海上，","poem":1},{"lineBreak":true},{"text":"你造的海怪也在水中嬉戲。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"牠們都倚靠你按時供應食物。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你賜下食物，牠們才有吃的，","poem":1},{"lineBreak":true},{"text":"你伸手賜下美食，牠們才得飽足。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你若掩面不顧牠們，","poem":1},{"lineBreak":true},{"text":"牠們會驚慌失措。","poem":1},{"lineBreak":true},{"text":"你一收回牠們的氣息，","poem":1},{"lineBreak":true},{"text":"牠們便死亡，歸於塵土。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"你一吹氣便創造了牠們，","poem":1},{"lineBreak":true},{"text":"你使大地煥然一新。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"願耶和華的榮耀存到永遠！","poem":1},{"lineBreak":true},{"text":"願耶和華以祂的創造為樂！","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"祂一看大地，大地就震動；","poem":1},{"lineBreak":true},{"text":"祂一摸群山，群山就冒煙。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"我要一生一世向耶和華歌唱，","poem":1},{"lineBreak":true},{"text":"我一息尚存就要讚美我的上帝。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"願祂喜悅我的默想，","poem":1},{"lineBreak":true},{"text":"耶和華是我的喜樂。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"願罪人從地上消逝，","poem":1},{"lineBreak":true},{"text":"願惡人蕩然無存。","poem":1},{"lineBreak":true},{"text":"我的心啊，要稱頌耶和華！","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}