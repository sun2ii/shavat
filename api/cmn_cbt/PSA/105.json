{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":105,"content":[{"type":"heading","content":["上帝和祂的子民"]},{"type":"verse","number":1,"content":[{"text":"你們要稱謝耶和華，呼求祂的名，","poem":1},{"lineBreak":true},{"text":"在列邦傳揚祂的作為。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要歌頌、讚美祂，","poem":1},{"lineBreak":true},{"text":"述說祂一切奇妙的作為。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要以祂的聖名為榮，","poem":1},{"lineBreak":true},{"text":"願尋求耶和華的人心中快樂。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"要尋求耶和華和祂的能力，","poem":1},{"lineBreak":true},{"text":"時常來到祂面前。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂僕人亞伯拉罕的後裔啊，","poem":1},{"lineBreak":true},{"text":"祂所揀選的雅各的子孫啊，","poem":1},{"lineBreak":true},{"text":"要記住祂所行的神蹟奇事和祂口中的判詞。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂是我們的上帝耶和華，","poem":1},{"lineBreak":true},{"text":"祂在普天下施行審判。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂永遠記得祂的約，","poem":1},{"lineBreak":true},{"text":"歷經千代也不忘祂的應許，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"就是祂與亞伯拉罕所立的約，","poem":1},{"lineBreak":true},{"text":"向以撒所起的誓。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂將這約定為律例賜給雅各，","poem":1},{"lineBreak":true},{"text":"定為永遠的約賜給以色列。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂說：「我必把迦南賜給你，","poem":1},{"lineBreak":true},{"text":"作為你的產業。」","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"那時他們人丁稀少，寥寥可數，","poem":1},{"lineBreak":true},{"text":"在當地寄居。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他們在異國他鄉流離飄零。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華不容人壓迫他們，","poem":1},{"lineBreak":true},{"text":"還為他們的緣故責備君王，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"說：「不可加害我膏立的人，","poem":1},{"lineBreak":true},{"text":"也不可傷害我的先知。」","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"祂命饑荒降在那裡，","poem":1},{"lineBreak":true},{"text":"斷絕一切食物供應。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂派一個人先去，","poem":1},{"lineBreak":true},{"text":"這人就是被賣為奴隸的約瑟。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他被戴上腳鐐，套上枷鎖，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"直到後來他的預言應驗，","poem":1},{"lineBreak":true},{"text":"耶和華的話試煉了他。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"埃及王派人釋放他，","poem":1},{"lineBreak":true},{"text":"百姓的首領給他自由，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"派他執掌朝政，","poem":1},{"lineBreak":true},{"text":"管理國中的一切，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"有權柄管束王的大臣，","poem":1},{"lineBreak":true},{"text":"將智慧傳授王的長老。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"以色列來到埃及，","poem":1},{"lineBreak":true},{"text":"雅各寄居在含地。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"耶和華使祂的子民生養眾多，","poem":1},{"lineBreak":true},{"text":"比他們的仇敵還要強盛。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"祂使仇敵轉念憎恨祂的子民，","poem":1},{"lineBreak":true},{"text":"用詭計虐待祂的僕人。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"祂派遣祂的僕人摩西和祂揀選的亞倫，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"在埃及行神蹟，","poem":1},{"lineBreak":true},{"text":"在含地行奇事。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"祂使黑暗降下籠罩那裡；","poem":1},{"lineBreak":true},{"text":"他們沒有違背祂的話。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"祂使埃及的水變成血，","poem":1},{"lineBreak":true},{"text":"魚都死去；","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"又使國中到處是青蛙，","poem":1},{"lineBreak":true},{"text":"王宮禁院也不能倖免。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"祂一發命令，","poem":1},{"lineBreak":true},{"text":"蒼蠅蜂擁而至，蝨子遍滿全境。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"祂使雨變成冰雹，","poem":1},{"lineBreak":true},{"text":"遍地電光閃閃。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"祂擊倒他們的葡萄樹和無花果樹，","poem":1},{"lineBreak":true},{"text":"摧毀他們境內的樹木。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"祂一發聲，","poem":1},{"lineBreak":true},{"text":"就飛來無數蝗蟲和螞蚱，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"吃盡他們土地上的植物，","poem":1},{"lineBreak":true},{"text":"吃盡他們田間的出產。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"祂又擊殺他們境內所有的長子，","poem":1},{"lineBreak":true},{"text":"就是他們年輕力壯時生的長子。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"祂帶領以色列人攜金帶銀地離開埃及，","poem":1},{"lineBreak":true},{"text":"各支派中無人畏縮。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"埃及人懼怕他們，","poem":1},{"lineBreak":true},{"text":"樂見他們離去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"祂鋪展雲彩為他們遮蔭，","poem":1},{"lineBreak":true},{"text":"晚上用火給他們照明。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"他們祈求，","poem":1},{"lineBreak":true},{"text":"祂就賜下鵪鶉，降下天糧，","poem":1},{"lineBreak":true},{"text":"叫他們飽足。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"祂使磐石裂開、湧出水來，","poem":1},{"lineBreak":true},{"text":"在乾旱之地奔流成河。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"因為祂顧念祂賜給僕人亞伯拉罕的神聖應許。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"祂帶領祂的子民歡然離去，","poem":1},{"lineBreak":true},{"text":"祂所揀選的百姓歡呼前行。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"祂把列國的土地賜給他們，","poem":1},{"lineBreak":true},{"text":"使他們獲得別人的勞動成果。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"祂這樣做是要使他們持守祂的命令，","poem":1},{"lineBreak":true},{"text":"遵行祂的律法。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":44}