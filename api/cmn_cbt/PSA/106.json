{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":106,"content":[{"type":"heading","content":["上帝恩待祂的子民"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"要稱謝耶和華，","poem":1},{"lineBreak":true},{"text":"因為祂是美善的，","poem":1},{"lineBreak":true},{"text":"祂的慈愛永遠長存！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"誰能述說耶和華的大能作為？","poem":1},{"lineBreak":true},{"text":"誰能道盡祂當受讚美之處？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"那些行事公正，","poem":1},{"lineBreak":true},{"text":"持守公義的人有福了。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華啊！","poem":1},{"lineBreak":true},{"text":"你恩待你子民的時候，","poem":1},{"lineBreak":true},{"text":"求你顧念我；","poem":1},{"lineBreak":true},{"text":"你拯救他們的時候，","poem":1},{"lineBreak":true},{"text":"求你幫助我，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"使我看到你所揀選的人繁榮昌盛，","poem":1},{"lineBreak":true},{"text":"與他們同樂，","poem":1},{"lineBreak":true},{"text":"與你的子民一同誇耀。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我們跟祖先一樣也犯了罪，","poem":1},{"lineBreak":true},{"text":"行事邪惡。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我們祖先在埃及漠視你奇妙的作為，","poem":1},{"lineBreak":true},{"text":"忘記你向他們屢施慈愛，","poem":1},{"lineBreak":true},{"text":"在紅海邊反叛你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"但祂為了自己的名拯救了他們，","poem":1},{"lineBreak":true},{"text":"以彰顯祂的大能。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂斥責紅海，海就乾了，","poem":1},{"lineBreak":true},{"text":"祂帶領他們走過深淵，","poem":1},{"lineBreak":true},{"text":"如履乾地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂救他們脫離敵人的權勢，","poem":1},{"lineBreak":true},{"text":"從仇敵的手中救贖了他們。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"海水淹沒了敵軍，","poem":1},{"lineBreak":true},{"text":"沒有一人生還。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"那時他們才相信祂的話，","poem":1},{"lineBreak":true},{"text":"歌唱讚美祂。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"然而，他們很快忘了祂的作為，","poem":1},{"lineBreak":true},{"text":"不願等候祂的引導。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們在曠野大起貪念，","poem":1},{"lineBreak":true},{"text":"在荒野試探上帝。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂滿足了他們的要求，","poem":1},{"lineBreak":true},{"text":"但在他們當中降下了瘟疫。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他們還在營中嫉妒摩西和耶和華的聖僕亞倫。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"大地裂開吞沒了大坍，","poem":1},{"lineBreak":true},{"text":"埋葬了亞比蘭一夥人。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"火在他們的黨羽中燒起，","poem":1},{"lineBreak":true},{"text":"燒滅了這些惡人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他們在何烈山鑄造牛犢，祭拜金屬偶像，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他們用吃草之牛的鑄像代替榮耀的上帝。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他們忘記了拯救他們的上帝，","poem":1},{"lineBreak":true},{"text":"祂曾在埃及行奇事，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"在含地行神蹟，","poem":1},{"lineBreak":true},{"text":"在紅海邊行可畏的事。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"因此祂說要消滅他們。","poem":1},{"lineBreak":true},{"text":"若不是祂揀選的摩西站在裂口處向祂求情，","poem":1},{"lineBreak":true},{"text":"祂早已發烈怒毀滅了他們。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他們藐視那佳美之地，","poem":1},{"lineBreak":true},{"text":"不相信祂的應許。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他們在帳篷裡發怨言，","poem":1},{"lineBreak":true},{"text":"不聽從祂的命令。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因此，祂舉手起誓要使他們倒斃在曠野，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"使他們的後代倒在列國，分散到各地。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他們與巴力·毗珥苟合，","poem":1},{"lineBreak":true},{"text":"吃獻給假神的祭物。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他們的所作所為觸怒耶和華，","poem":1},{"lineBreak":true},{"text":"以致瘟疫降在他們中間。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"那時，非尼哈起來懲罰罪人，","poem":1},{"lineBreak":true},{"text":"瘟疫才停止。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"這就是他的義行，世代永存。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他們在米利巴泉邊惹耶和華發怒，","poem":1},{"lineBreak":true},{"text":"連累了摩西。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"因為他們惹摩西發怒，","poem":1},{"lineBreak":true},{"text":"以致他說了魯莽的話。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"他們沒有照耶和華的命令消滅外族人，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"反倒與他們混居，","poem":1},{"lineBreak":true},{"text":"仿效他們的習俗，","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"拜他們的偶像，陷入網羅。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"他們把自己的兒女當祭物獻給鬼魔，","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"他們把自己的兒女獻給迦南的偶像作祭物，","poem":1},{"lineBreak":true},{"text":"流他們兒女無辜的血，","poem":1},{"lineBreak":true},{"text":"玷污了那地方。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"他們的行為玷污了自己，","poem":1},{"lineBreak":true},{"text":"所作所為使自己淪為淫婦。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"耶和華因此向祂的子民發怒，","poem":1},{"lineBreak":true},{"text":"祂厭惡自己的產業，","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"使他們落在列邦的手中，","poem":1},{"lineBreak":true},{"text":"受敵人的轄制。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"他們的敵人壓迫他們，","poem":1},{"lineBreak":true},{"text":"他們被制服在敵人手下。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"祂多次拯救他們，","poem":1},{"lineBreak":true},{"text":"他們卻執意背叛，","poem":1},{"lineBreak":true},{"text":"陷入罪中不能自拔。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"但祂聽見他們在苦難中呼求時，","poem":1},{"lineBreak":true},{"text":"仍然眷顧他們。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"祂顧念與他們所立的約，","poem":1},{"lineBreak":true},{"text":"憑豐盛的慈愛憐憫他們。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"祂使擄掠他們的人憐憫他們。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"我們的上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你拯救我們，","poem":1},{"lineBreak":true},{"text":"從列國招聚我們，","poem":1},{"lineBreak":true},{"text":"我們好稱謝你的聖名，","poem":1},{"lineBreak":true},{"text":"以讚美你為榮。","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"以色列的上帝耶和華永永遠遠當受稱頌。","poem":1},{"lineBreak":true},{"text":"願眾民都說：「阿們！」","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}