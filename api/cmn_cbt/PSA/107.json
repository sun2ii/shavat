{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":107,"content":[{"type":"heading","content":["稱謝上帝的美善"]},{"type":"verse","number":1,"content":[{"text":"你們要稱謝耶和華，","poem":1},{"lineBreak":true},{"text":"因為祂是美善的；","poem":1},{"lineBreak":true},{"text":"祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華救贖的人，","poem":1},{"lineBreak":true},{"text":"就是祂從敵人手中救贖出來，","poem":1},{"lineBreak":true},{"text":"從東西南北各個地方招聚的人，","poem":1},{"lineBreak":true},{"text":"都要稱謝祂。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們在曠野中飄泊，居無定所，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"又饑又渴，精疲力竭。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們在患難中呼求耶和華，","poem":1},{"lineBreak":true},{"text":"祂便救他們脫離困境，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"帶領他們走直路，","poem":1},{"lineBreak":true},{"text":"到可居住的城邑。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們要稱謝耶和華的慈愛，","poem":1},{"lineBreak":true},{"text":"稱謝祂為世人所行的奇事。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為祂滿足乾渴的人，","poem":1},{"lineBreak":true},{"text":"以美食餵飽饑餓的人。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"有些人坐在黑暗裡，","poem":1},{"lineBreak":true},{"text":"在死亡的陰影下，","poem":1},{"lineBreak":true},{"text":"被鐵鏈捆綁，","poem":1},{"lineBreak":true},{"text":"痛苦不堪，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因為他們違背上帝的話，","poem":1},{"lineBreak":true},{"text":"藐視至高者的旨意。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"所以上帝使他們服苦役，","poem":1},{"lineBreak":true},{"text":"他們跌倒也無人扶助。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"於是，他們在患難中呼求耶和華，","poem":1},{"lineBreak":true},{"text":"祂便救他們脫離困境。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂帶領他們脫離黑暗和死亡的陰影，","poem":1},{"lineBreak":true},{"text":"斷開他們的鎖鏈。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他們要稱謝耶和華的慈愛，","poem":1},{"lineBreak":true},{"text":"稱謝祂為世人所行的奇事。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因為祂打碎了銅門，","poem":1},{"lineBreak":true},{"text":"砍斷了鐵閂。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"有些人因自己的悖逆而愚頑，","poem":1},{"lineBreak":true},{"text":"因自己的罪過而受苦，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"食慾全消，幾近死亡。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"於是，他們在患難中呼求耶和華，","poem":1},{"lineBreak":true},{"text":"祂便救他們脫離困境。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"祂一發令，就醫治了他們，","poem":1},{"lineBreak":true},{"text":"救他們脫離死亡。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他們要稱謝耶和華的慈愛，","poem":1},{"lineBreak":true},{"text":"稱謝祂為世人所行的奇事。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他們要向祂獻上感恩祭，","poem":1},{"lineBreak":true},{"text":"歡然歌頌祂的作為。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"有些人乘船在汪洋大海上經商，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他們看見了耶和華的作為，","poem":1},{"lineBreak":true},{"text":"看見了祂在深海所行的奇事。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"祂一聲令下，","poem":1},{"lineBreak":true},{"text":"狂風大作，巨浪滔天。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他們的船隻忽而被拋向半空，","poem":1},{"lineBreak":true},{"text":"忽而落入深淵，","poem":1},{"lineBreak":true},{"text":"他們嚇得膽戰心驚，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"東倒西歪，如同醉漢，","poem":1},{"lineBreak":true},{"text":"束手無策。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"於是，他們在患難中呼求耶和華，","poem":1},{"lineBreak":true},{"text":"祂便救他們脫離困境。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"祂使狂風止息，海浪平靜。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他們因風平浪靜而歡喜，","poem":1},{"lineBreak":true},{"text":"祂帶領他們到所嚮往的港灣。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他們要稱謝耶和華的慈愛，","poem":1},{"lineBreak":true},{"text":"稱謝祂為世人所行的奇事。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他們要在眾人面前尊崇祂，","poem":1},{"lineBreak":true},{"text":"在長老的聚會中讚美祂。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"祂使江河變成荒漠，","poem":1},{"lineBreak":true},{"text":"水泉變成乾地，","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"叫沃土變成荒涼的鹽鹼地，","poem":1},{"lineBreak":true},{"text":"因為那裡的居民邪惡。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"祂叫荒漠水塘遍佈，","poem":1},{"lineBreak":true},{"text":"使旱地甘泉湧流。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"祂使饑餓的人住在那裡，","poem":1},{"lineBreak":true},{"text":"建造可安居的城邑，","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"耕種田地，栽植葡萄園，","poem":1},{"lineBreak":true},{"text":"收成豐碩。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"祂賜福給他們，","poem":1},{"lineBreak":true},{"text":"使他們人丁興旺，","poem":1},{"lineBreak":true},{"text":"牲口有增無減。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"後來他們在壓迫、患難和痛苦的煎熬下人口減少，","poem":1},{"lineBreak":true},{"text":"地位卑下。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"祂使貴族蒙羞受辱，","poem":1},{"lineBreak":true},{"text":"漂流在荒蕪之地。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"但祂搭救貧苦的人脫離苦難，","poem":1},{"lineBreak":true},{"text":"使他們家族興旺，多如羊群。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"正直人看見就歡喜，","poem":1},{"lineBreak":true},{"text":"邪惡人都啞口無言。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"有智慧的人都要留心這些事，","poem":1},{"lineBreak":true},{"text":"他們要思想耶和華的慈愛。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":42}