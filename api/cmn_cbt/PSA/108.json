{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":108,"content":[{"type":"heading","content":["祈求上帝的幫助"]},{"type":"hebrew_subtitle","content":["大衛的詩歌。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊！我心堅定不移，","poem":1},{"lineBreak":true},{"text":"我要用心靈唱詩歌頌你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"琴瑟啊，醒來吧！","poem":1},{"lineBreak":true},{"text":"我要喚醒黎明！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華啊，我要在列邦稱謝你，","poem":1},{"lineBreak":true},{"text":"在列國歌頌你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因為你的慈愛廣及諸天，","poem":1},{"lineBreak":true},{"text":"你的信實高達穹蒼。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"願你受的尊崇超過諸天，","poem":1},{"lineBreak":true},{"text":"願你的榮耀覆蓋大地。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你應允我們的禱告，","poem":1},{"lineBreak":true},{"text":"伸出右手拯救我們，","poem":1},{"lineBreak":true},{"text":"使你所愛的人獲救。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝在祂的聖所說：","poem":1},{"lineBreak":true},{"text":"「我要歡然劃分示劍，丈量疏割谷。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"基列是我的，瑪拿西也是我的，","poem":1},{"lineBreak":true},{"text":"以法蓮是我的頭盔，","poem":1},{"lineBreak":true},{"text":"猶大是我的權杖。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"摩押是我的洗腳盆，","poem":1},{"lineBreak":true},{"text":"我要把鞋扔給以東，","poem":1},{"lineBreak":true},{"text":"我要朝非利士高唱凱歌。」","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"誰能帶我進入堅固的城池？","poem":1},{"lineBreak":true},{"text":"誰能領我到以東？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝啊，你拋棄了我們嗎？","poem":1},{"lineBreak":true},{"text":"上帝啊，你不再和我們的軍隊一同出戰了嗎？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你幫助我們攻打仇敵，","poem":1},{"lineBreak":true},{"text":"因為人的幫助徒然無益。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我們依靠上帝才能取勝，","poem":1},{"lineBreak":true},{"text":"祂必踐踏我們的敵人。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}