{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":109,"content":[{"type":"heading","content":["患難中的苦訴"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"我所讚美的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你不要沉默不語。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為邪惡和詭詐的人開口攻擊我，","poem":1},{"lineBreak":true},{"text":"用撒謊的舌頭譭謗我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們對我惡語相向，","poem":1},{"lineBreak":true},{"text":"無緣無故地攻擊我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我愛他們，他們卻控告我，","poem":1},{"lineBreak":true},{"text":"但我專心禱告。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們對我以惡報善，","poem":1},{"lineBreak":true},{"text":"以恨報愛。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你差惡人攻擊我的仇敵，","poem":1},{"lineBreak":true},{"text":"派對頭站在他右邊控告他。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"當他受審時，","poem":1},{"lineBreak":true},{"text":"願他被判為有罪，","poem":1},{"lineBreak":true},{"text":"他的禱告也算為罪過。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"願他的年日短少，","poem":1},{"lineBreak":true},{"text":"願別人取代他的職位。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"願他的孩子失去父親，","poem":1},{"lineBreak":true},{"text":"妻子成為寡婦。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"願他的孩子流浪行乞，","poem":1},{"lineBreak":true},{"text":"被趕出自己破敗的家。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"願債主奪取他所有的財產，","poem":1},{"lineBreak":true},{"text":"陌生人搶走他的勞動成果。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"願無人向他施恩，","poem":1},{"lineBreak":true},{"text":"無人同情他的孤兒。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"願他斷子絕孫，","poem":1},{"lineBreak":true},{"text":"他的姓氏傳不到下一代。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"願耶和華記住他祖輩的罪惡，","poem":1},{"lineBreak":true},{"text":"不除去他母親的罪過。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"願耶和華永不忘記他的罪惡，","poem":1},{"lineBreak":true},{"text":"把他的名號從世上剷除。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因為他毫無仁慈，","poem":1},{"lineBreak":true},{"text":"迫害困苦、貧窮和傷心的人，","poem":1},{"lineBreak":true},{"text":"置他們於死地。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他喜歡咒詛人，","poem":1},{"lineBreak":true},{"text":"願咒詛臨到他；","poem":1},{"lineBreak":true},{"text":"他不喜歡祝福人，","poem":1},{"lineBreak":true},{"text":"願祝福遠離他。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他咒詛成性，","poem":1},{"lineBreak":true},{"text":"願咒詛如水侵入他的身體，","poem":1},{"lineBreak":true},{"text":"如油浸透他的骨頭。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"願咒詛不離其身，","poem":1},{"lineBreak":true},{"text":"如同身上的衣服和腰間的帶子。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"願耶和華這樣報應那些控告我，","poem":1},{"lineBreak":true},{"text":"以惡言攻擊我的人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"主耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你因自己的名恩待我，","poem":1},{"lineBreak":true},{"text":"因你的美善和慈愛拯救我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因為我貧窮困苦，","poem":1},{"lineBreak":true},{"text":"內心飽受創傷。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我像黃昏的日影一樣消逝，","poem":1},{"lineBreak":true},{"text":"如蝗蟲一般被抖落。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"禁食使我雙腿發軟，","poem":1},{"lineBreak":true},{"text":"瘦骨嶙峋。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"仇敵都嘲笑我，","poem":1},{"lineBreak":true},{"text":"他們看見我就連連搖頭。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我的上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你幫助我，施慈愛拯救我，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"讓他們知道這是你的作為，","poem":1},{"lineBreak":true},{"text":"你耶和華行了此事。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"任憑他們咒詛吧，","poem":1},{"lineBreak":true},{"text":"你必賜福給我。","poem":1},{"lineBreak":true},{"text":"攻擊我的人必蒙羞，","poem":1},{"lineBreak":true},{"text":"但你的僕人必歡喜。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"願控告我的人滿面羞辱，","poem":1},{"lineBreak":true},{"text":"願他們渾身被恥辱包裹。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我要竭力頌揚耶和華，","poem":1},{"lineBreak":true},{"text":"在人群中讚美祂。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"因為祂保護貧窮的人，","poem":1},{"lineBreak":true},{"text":"救他們脫離定他們死罪的人。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}