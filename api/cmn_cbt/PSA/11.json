{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":11,"content":[{"type":"heading","content":["信靠上帝"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"我投靠耶和華，","poem":1},{"lineBreak":true},{"text":"你們怎能對我說：「要像飛鳥一樣逃到山裡。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"看啊，惡人彎弓搭箭，","poem":1},{"lineBreak":true},{"text":"要暗射心地正直的人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"根基若遭毀壞，","poem":1},{"lineBreak":true},{"text":"義人還能做什麼？」","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華在祂的聖殿裡，","poem":1},{"lineBreak":true},{"text":"坐在天上的寶座上，","poem":1},{"lineBreak":true},{"text":"放眼巡視，察看世人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華察驗義人，","poem":1},{"lineBreak":true},{"text":"祂心裡憎恨邪惡和殘暴之徒。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂要把烈焰熊熊的火炭和硫磺降在惡人身上，","poem":1},{"lineBreak":true},{"text":"用炙熱的風懲罰他們。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因為耶和華是公義的，","poem":1},{"lineBreak":true},{"text":"祂喜愛公義。","poem":1},{"lineBreak":true},{"text":"正直的人必見祂的面。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}