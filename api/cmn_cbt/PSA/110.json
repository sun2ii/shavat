{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":110,"content":[{"type":"heading","content":["上帝和祂揀選的王"]},{"type":"hebrew_subtitle","content":["大衛的詩歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和華對我主說：","poem":1},{"lineBreak":true},{"text":"「你坐在我的右邊，","poem":1},{"lineBreak":true},{"text":"等我使你的仇敵成為你的腳凳。」","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華必從錫安擴展你的王權，","poem":1},{"lineBreak":true},{"text":"你要在眾仇敵中掌權。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你跟仇敵作戰的時候，","poem":1},{"lineBreak":true},{"text":"你的百姓必甘心跟從，","poem":1},{"lineBreak":true},{"text":"他們衣著聖潔，","poem":1},{"lineBreak":true},{"text":"如清晨的甘露。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華起了誓，絕不反悔，","poem":1},{"lineBreak":true},{"text":"祂說：「你照麥基洗德的模式永遠做祭司。」","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"主在你右邊保護你，","poem":1},{"lineBreak":true},{"text":"祂發怒的時候，必毀滅列王。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂要審判列國，","poem":1},{"lineBreak":true},{"text":"使列國屍橫遍野。","poem":1},{"lineBreak":true},{"text":"祂要毀滅世上的首領。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂要喝路旁的溪水，","poem":1},{"lineBreak":true},{"text":"祂必精神抖擻。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}