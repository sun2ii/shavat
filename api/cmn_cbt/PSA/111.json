{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":111,"content":[{"type":"heading","content":["讚美上帝"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"在正直人的大會及會眾中，","poem":1},{"lineBreak":true},{"text":"我要全心稱謝耶和華。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華的作為偉大，","poem":1},{"lineBreak":true},{"text":"所有喜歡的人都必思想。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂的作為榮耀威嚴，","poem":1},{"lineBreak":true},{"text":"祂的公義永遠長存。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂使人銘記祂奇妙的作為。","poem":1},{"lineBreak":true},{"text":"耶和華有恩典、好憐憫。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂賜下糧食給那些敬畏祂的人，","poem":1},{"lineBreak":true},{"text":"祂永不忘記自己的約。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂向子民彰顯大能的作為，","poem":1},{"lineBreak":true},{"text":"把列國的土地賜給他們。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂憑信實和公正行事，","poem":1},{"lineBreak":true},{"text":"祂一切的法則都可靠，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"是憑信實和正直賜下的，","poem":1},{"lineBreak":true},{"text":"存到永永遠遠。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂救贖了自己的子民，","poem":1},{"lineBreak":true},{"text":"立了永遠的約，","poem":1},{"lineBreak":true},{"text":"祂的名神聖可畏。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"智慧始於敬畏耶和華，","poem":1},{"lineBreak":true},{"text":"遵行祂命令者皆明睿。","poem":1},{"lineBreak":true},{"text":"祂永遠當受讚美。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}