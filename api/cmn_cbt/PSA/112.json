{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":112,"content":[{"type":"heading","content":["敬畏上帝者必蒙福"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"敬畏耶和華、熱愛祂命令的人有福了！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他的子孫在世上必興盛，","poem":1},{"lineBreak":true},{"text":"正直人的後代必蒙福。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他的家財豐厚，","poem":1},{"lineBreak":true},{"text":"他的公義永遠長存。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"黑暗中必有光照亮正直人，","poem":1},{"lineBreak":true},{"text":"照亮有恩慈、好憐憫、行公義的人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"慷慨借貸，","poem":1},{"lineBreak":true},{"text":"行事公正的人必亨通。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"義人必永不動搖，","poem":1},{"lineBreak":true},{"text":"他必永得眷顧。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他不怕惡訊，","poem":1},{"lineBreak":true},{"text":"他一心信靠耶和華。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他心裡篤定，毫不害怕，","poem":1},{"lineBreak":true},{"text":"他終必戰勝仇敵。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他慷慨施捨，賙濟窮人；","poem":1},{"lineBreak":true},{"text":"他的公義永遠長存；","poem":1},{"lineBreak":true},{"text":"他的角被高舉，得享尊榮。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"惡人見狀惱怒不已，","poem":1},{"lineBreak":true},{"text":"他咬牙切齒地死去。","poem":1},{"lineBreak":true},{"text":"惡人的盼望必破滅。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}