{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":113,"content":[{"type":"heading","content":["讚美上帝的美善"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"耶和華的僕人啊，","poem":1},{"lineBreak":true},{"text":"你們要讚美，讚美耶和華的名。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願耶和華的名受稱頌，","poem":1},{"lineBreak":true},{"text":"從現在直到永遠！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"從日出之地到日落之處，","poem":1},{"lineBreak":true},{"text":"普世都應當讚美耶和華的名。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華高居萬國之上，","poem":1},{"lineBreak":true},{"text":"祂的榮耀高過諸天。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"誰能與我們的上帝耶和華相比？","poem":1},{"lineBreak":true},{"text":"祂坐在至高之處，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"俯視諸天和大地。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂從灰塵中提拔貧窮人，","poem":1},{"lineBreak":true},{"text":"從糞堆中提升困苦人，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"使他們與王子同坐，","poem":1},{"lineBreak":true},{"text":"與本國的王子同坐。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂使不育的婦人安居家中，","poem":1},{"lineBreak":true},{"text":"成為快樂的母親。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}