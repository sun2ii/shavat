{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":115,"content":[{"type":"heading","content":["上帝是獨一真神"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"不要將榮耀歸於我們，","poem":1},{"lineBreak":true},{"text":"不要歸於我們。","poem":1},{"lineBreak":true},{"text":"榮耀歸於你的名，","poem":1},{"lineBreak":true},{"text":"因為你慈愛、信實！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"為何讓列國說","poem":1},{"lineBreak":true},{"text":"「他們的上帝在哪裡」？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我們的上帝高居在天，","poem":1},{"lineBreak":true},{"text":"按自己的旨意行事。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們的偶像是人用金銀造的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"它們有口不能言，有眼不能看，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"有耳不能聽，有鼻不能聞，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"有手不能摸，有腳不能走，","poem":1},{"lineBreak":true},{"text":"有喉嚨也不能發聲。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"造偶像的必和偶像一樣，","poem":1},{"lineBreak":true},{"text":"信靠偶像的人也是如此。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"以色列人啊，要信靠耶和華！","poem":1},{"lineBreak":true},{"text":"祂是你們的幫助，","poem":1},{"lineBreak":true},{"text":"是你們的盾牌。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"亞倫家啊，要信靠耶和華！","poem":1},{"lineBreak":true},{"text":"祂是你們的幫助，","poem":1},{"lineBreak":true},{"text":"是你們的盾牌。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"敬畏耶和華的人啊，要信靠祂！","poem":1},{"lineBreak":true},{"text":"祂是你們的幫助，","poem":1},{"lineBreak":true},{"text":"是你們的盾牌。","poem":1},{"noteId":9}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和華顧念我們，賜福給我們。","poem":1},{"lineBreak":true},{"text":"祂要賜福給以色列人，","poem":1},{"lineBreak":true},{"text":"賜福給亞倫家。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華要賜福給一切敬畏祂的人，","poem":1},{"lineBreak":true},{"text":"不分尊貴卑賤。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"願耶和華使你們和你們的後代人丁興旺！","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"願創造天地的耶和華賜福給你們！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"高天屬於耶和華，","poem":1},{"lineBreak":true},{"text":"但祂把大地賜給了世人。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"死人不能頌讚耶和華，","poem":1},{"lineBreak":true},{"text":"下墳墓的人不能讚美祂。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"但我們要讚美耶和華，","poem":1},{"lineBreak":true},{"text":"從現在直到永遠。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"平行經文：詩篇135·15‑20。","reference":{"chapter":115,"verse":11}}]},"thisChapterLink":"/api/cmn_cbt/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}