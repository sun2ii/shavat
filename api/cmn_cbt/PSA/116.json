{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":116,"content":[{"type":"heading","content":["感謝拯救之恩"]},{"type":"verse","number":1,"content":[{"text":"我愛耶和華，","poem":1},{"lineBreak":true},{"text":"因為祂垂聽了我的呼求和禱告。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為祂側耳聽我的祈求，","poem":1},{"lineBreak":true},{"text":"我一生都要求告祂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"死亡的繩索纏繞我，","poem":1},{"lineBreak":true},{"text":"陰間的恐怖籠罩我，","poem":1},{"lineBreak":true},{"text":"我陷入困苦和憂愁。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"於是，我求告耶和華的名，","poem":1},{"lineBreak":true},{"text":"說：「耶和華啊，求你救我。」","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華仁慈、公義，","poem":1},{"lineBreak":true},{"text":"我們的上帝充滿憐憫。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華保護心地單純的人，","poem":1},{"lineBreak":true},{"text":"危難之時祂拯救了我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的心啊，恢復安寧吧，","poem":1},{"lineBreak":true},{"text":"因為耶和華恩待你。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂救我的性命脫離死亡，","poem":1},{"lineBreak":true},{"text":"止住我眼中的淚水，","poem":1},{"lineBreak":true},{"text":"使我雙腳免於滑倒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我要在世上事奉耶和華。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我相信，所以才說：","poem":1},{"lineBreak":true},{"text":"「我受盡了痛苦。」","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我曾驚恐地說：","poem":1},{"lineBreak":true},{"text":"「人人都說謊。」","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我拿什麼報答耶和華賜給我的一切恩惠呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我要因耶和華的拯救之恩舉杯稱頌祂的名。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我要在耶和華的子民面前還我向祂許的願。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"耶和華的眼目顧惜祂聖民的存亡。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華啊！我是你的僕人，","poem":1},{"lineBreak":true},{"text":"是你的僕人，是你婢女的兒子。","poem":1},{"lineBreak":true},{"text":"你除去了我的鎖鏈。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我要向你獻上感恩祭，","poem":1},{"lineBreak":true},{"text":"求告耶和華的名。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要在耶路撒冷，","poem":1},{"lineBreak":true},{"text":"在耶和華的殿中，","poem":1},{"lineBreak":true},{"text":"在耶和華的子民面前還我向祂許的願。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":18}