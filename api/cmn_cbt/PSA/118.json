{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":118,"content":[{"type":"heading","content":["為勝利而感恩"]},{"type":"verse","number":1,"content":[{"text":"你們要稱謝耶和華，","poem":1},{"lineBreak":true},{"text":"因為祂是美善的，","poem":1},{"lineBreak":true},{"text":"祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願以色列人說：","poem":1},{"lineBreak":true},{"text":"「祂的慈愛永遠長存。」","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"願亞倫家說：","poem":1},{"lineBreak":true},{"text":"「祂的慈愛永遠長存。」","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"願那些敬畏耶和華的人說：","poem":1},{"lineBreak":true},{"text":"「祂的慈愛永遠長存。」","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我在苦難中求告耶和華，","poem":1},{"lineBreak":true},{"text":"祂就答應我，救我脫離困境。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"有耶和華與我同在，","poem":1},{"lineBreak":true},{"text":"我必不懼怕，","poem":1},{"lineBreak":true},{"text":"人能把我怎麼樣？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華與我同在，幫助我，","poem":1},{"lineBreak":true},{"text":"我必看見那些恨我的人一敗塗地。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"投靠耶和華勝過倚靠人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"投靠耶和華勝過倚靠權貴。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"列國圍住我，","poem":1},{"lineBreak":true},{"text":"但我靠著耶和華的名消滅了他們。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們四面圍住我，","poem":1},{"lineBreak":true},{"text":"但我靠著耶和華的名消滅了他們。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們如蜜蜂圍住我，","poem":1},{"lineBreak":true},{"text":"然而他們必像燃燒的荊棘，","poem":1},{"lineBreak":true},{"text":"轉瞬消逝；","poem":1},{"lineBreak":true},{"text":"我靠著耶和華的名消滅了他們。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我受到猛烈的攻擊，","poem":1},{"lineBreak":true},{"text":"幾乎要倒下了，","poem":1},{"lineBreak":true},{"text":"但耶和華幫助了我。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華是我的力量，","poem":1},{"lineBreak":true},{"text":"是我的詩歌；","poem":1},{"lineBreak":true},{"text":"祂拯救了我。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"義人的帳篷裡傳出勝利的歡呼聲：","poem":1},{"lineBreak":true},{"text":"「耶和華用右手施展大能！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華高舉右手，","poem":1},{"lineBreak":true},{"text":"耶和華用右手施展大能！」","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我必不至於死，","poem":1},{"lineBreak":true},{"text":"我要活著，","poem":1},{"lineBreak":true},{"text":"並要述說耶和華的作為。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和華雖然重重地懲罰我，","poem":1},{"lineBreak":true},{"text":"卻沒有置我於死地。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"給我打開公義的門吧，","poem":1},{"lineBreak":true},{"text":"我要進去稱謝耶和華。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"這是耶和華的門，","poem":1},{"lineBreak":true},{"text":"義人都可以進去。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和華啊！我稱謝你，","poem":1},{"lineBreak":true},{"text":"因為你應允了我的禱告，","poem":1},{"lineBreak":true},{"text":"拯救了我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"工匠丟棄的石頭已成了房角石。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"這是耶和華的作為，","poem":1},{"lineBreak":true},{"text":"在我們看來奇妙莫測。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"這是耶和華得勝的日子，","poem":1},{"lineBreak":true},{"text":"我們要歡喜快樂。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"耶和華啊，求你拯救我們；","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你使我們亨通。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"奉耶和華之名來的當受稱頌！","poem":1},{"lineBreak":true},{"text":"我們要在耶和華的殿中祝福你們。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"耶和華是上帝，","poem":1},{"lineBreak":true},{"text":"祂的光照亮我們。","poem":1},{"lineBreak":true},{"text":"要用繩索拴住祭牲，","poem":1},{"lineBreak":true},{"text":"牽到祭壇的角那裡。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你是我的上帝，我要稱謝你；","poem":1},{"lineBreak":true},{"text":"你是我的上帝，我要尊崇你。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你們要稱謝耶和華，","poem":1},{"lineBreak":true},{"text":"因為祂是美善的，","poem":1},{"lineBreak":true},{"text":"祂的慈愛永遠長存。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}