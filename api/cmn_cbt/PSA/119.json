{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":119,"content":[{"type":"heading","content":["耶和華的律法"]},{"type":"verse","number":1,"content":[{"text":"行為正直、遵行耶和華律法的人有福了！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"遵守祂的法度、全心尋求祂的人有福了！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們不做不義之事，","poem":1},{"lineBreak":true},{"text":"只遵行祂的旨意。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華啊，你已經賜下法則，","poem":1},{"lineBreak":true},{"text":"為了讓我們竭力遵行。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我渴望堅定地遵從你的律例。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我重視你的一切命令，","poem":1},{"lineBreak":true},{"text":"便不致羞愧。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我學習你公義的法令時，","poem":1},{"lineBreak":true},{"text":"要存著正直的心來稱謝你。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我要遵守你的律例，","poem":1},{"lineBreak":true},{"text":"求你不要完全棄絕我。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"青年如何保持純潔呢？","poem":1},{"lineBreak":true},{"text":"就是要遵行你的話。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我全心尋求你，","poem":1},{"lineBreak":true},{"text":"求你不要讓我偏離你的命令。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我把你的話珍藏在心中，","poem":1},{"lineBreak":true},{"text":"免得我得罪你。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和華啊，你當受稱頌！","poem":1},{"lineBreak":true},{"text":"求你將你的律例教導我。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我宣揚你口中所出的一切法令。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我喜愛你的法度如同人喜愛財富。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要默想你的法則，","poem":1},{"lineBreak":true},{"text":"思想你的旨意。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我以遵行你的律例為樂，","poem":1},{"lineBreak":true},{"text":"我不忘記你的話語。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"求你以厚恩待你僕人，","poem":1},{"lineBreak":true},{"text":"使我能活著，並遵守你的話語。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你開我的眼睛，","poem":1},{"lineBreak":true},{"text":"使我能明白你律法中的奧妙。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我在世上是過客，","poem":1},{"lineBreak":true},{"text":"求你不要向我隱藏你的命令。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我時刻切慕你的法令，","poem":1},{"lineBreak":true},{"text":"以致心力憔悴。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你斥責受咒詛、偏離你命令的狂傲人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"求你除去我所受的羞辱和藐視，","poem":1},{"lineBreak":true},{"text":"因為我遵從你的法度。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"雖然權貴們坐著譭謗我，","poem":1},{"lineBreak":true},{"text":"僕人仍要默想你的律例。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你的法度是我的喜樂，","poem":1},{"lineBreak":true},{"text":"是我的謀士。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我的性命幾乎墜入塵埃，","poem":1},{"lineBreak":true},{"text":"求你憑應許保全我性命。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我陳明自己的行為，","poem":1},{"lineBreak":true},{"text":"你就回應了我；","poem":1},{"lineBreak":true},{"text":"求你將你的律例教導我。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"求你使我明白你的法則，","poem":1},{"lineBreak":true},{"text":"我要默想你的奇妙作為。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我傷心欲絕，","poem":1},{"lineBreak":true},{"text":"求你照你的應許使我堅強起來。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"求你使我遠離奸詐之路，","poem":1},{"lineBreak":true},{"text":"開恩將你的律法教導我。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我已經選擇了真理之路，","poem":1},{"lineBreak":true},{"text":"決心遵行你的法令。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"我持守你的法度，耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你不要使我蒙羞。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我竭力遵守你的命令，","poem":1},{"lineBreak":true},{"text":"因為你拓寬我的悟性。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"耶和華啊，求你將你的律例教導我，","poem":1},{"lineBreak":true},{"text":"我必遵守到底。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"求你賜我悟性，使我遵守你的律法，","poem":1},{"lineBreak":true},{"text":"並且全心遵守。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"求你引導我遵行你的命令，","poem":1},{"lineBreak":true},{"text":"因為這是我喜愛的。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"求你使我的心嚮往你的法度，","poem":1},{"lineBreak":true},{"text":"而非不義之財。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"求你使我的眼目遠離虛空之事，","poem":1},{"lineBreak":true},{"text":"按你的旨意保全我性命。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"求你實現你給僕人的應許，","poem":1},{"lineBreak":true},{"text":"就是你給敬畏你之人的應許。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"求你除去我所害怕的羞辱，","poem":1},{"lineBreak":true},{"text":"因為你的法令是美善的。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"我渴望遵行你的法則，","poem":1},{"lineBreak":true},{"text":"求你按你的公義保全我性命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"耶和華啊！","poem":1},{"lineBreak":true},{"text":"願你的慈愛臨到我，","poem":1},{"lineBreak":true},{"text":"願你的拯救臨到我，","poem":1},{"lineBreak":true},{"text":"正如你的應許，","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"好叫我能應對嘲笑我的人，","poem":1},{"lineBreak":true},{"text":"因為我信靠你的話。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"斷不要從我口中拿走真理之言，","poem":1},{"lineBreak":true},{"text":"因為你的法令是我的盼望。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"我要持守你的律法，","poem":1},{"lineBreak":true},{"text":"直到永永遠遠。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"我要自由地生活，","poem":1},{"lineBreak":true},{"text":"因為我尋求你的法則。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"我要在君王面前講論你的法度，","poem":1},{"lineBreak":true},{"text":"我不以此為恥。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"我以遵行你的命令為樂，","poem":1},{"lineBreak":true},{"text":"我喜愛你的命令。","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"我尊崇你的命令，","poem":1},{"lineBreak":true},{"text":"我喜愛你的命令，","poem":1},{"lineBreak":true},{"text":"我要默想你的律例。","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"求你顧念你對僕人的應許，","poem":1},{"lineBreak":true},{"text":"你的話帶給我盼望。","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"你的應許保全我性命，","poem":1},{"lineBreak":true},{"text":"是我患難中的安慰。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"狂傲人肆意嘲諷我，","poem":1},{"lineBreak":true},{"text":"但我仍然沒有偏離你的律法。","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"我牢記你古時賜下的法令，","poem":1},{"lineBreak":true},{"text":"你的法令是我的安慰。","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"我見惡人丟棄你的律法，","poem":1},{"lineBreak":true},{"text":"就怒火中燒。","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"我在世上寄居，","poem":1},{"lineBreak":true},{"text":"你的律例就是我的詩歌。","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"耶和華啊，我在夜間思想你的名，","poem":1},{"lineBreak":true},{"text":"我要遵守你的律法。","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"我向來遵行你的法則。","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"耶和華啊，你是我的福分！","poem":1},{"lineBreak":true},{"text":"我決心遵行你的話語。","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"我一心求你施恩，","poem":1},{"lineBreak":true},{"text":"求你照著你的應許恩待我。","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"我思想自己走過的路，","poem":1},{"lineBreak":true},{"text":"就移步歸向你的法度。","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"我毫不遲疑地遵守你的命令。","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"雖然惡人用繩索捆綁我，","poem":1},{"lineBreak":true},{"text":"我仍不忘記你的律法。","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"因為你公義的法令，","poem":1},{"lineBreak":true},{"text":"我半夜起來稱謝你。","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"我與所有敬畏你、遵守你法則的人為友。","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"耶和華啊，你的慈愛充滿大地，","poem":1},{"lineBreak":true},{"text":"求你將你的律例教導我。","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"你信守諾言，善待了僕人。","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"求你賜我知識，教我判別是非，","poem":1},{"lineBreak":true},{"text":"因為我信靠你的命令。","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"從前我沒有受苦的時候走迷了路，","poem":1},{"lineBreak":true},{"text":"現在我要遵行你的話。","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"你是美善的，","poem":1},{"lineBreak":true},{"text":"你所行的都是美善的，","poem":1},{"lineBreak":true},{"text":"求你將你的律例教導我。","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"傲慢人譭謗我，","poem":1},{"lineBreak":true},{"text":"但我一心遵守你的法則。","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"他們執迷不悟，","poem":1},{"lineBreak":true},{"text":"但我喜愛你的律法。","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"我受苦對我有益，","poem":1},{"lineBreak":true},{"text":"使我可以學習你的律例。","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"你頒布的律法對我而言比千萬金銀更寶貴。","poem":1}]},{"type":"verse","number":73,"content":[{"lineBreak":true},{"text":"你親手造我、塑我，","poem":1},{"lineBreak":true},{"text":"求你賜我悟性來學習你的命令。","poem":1}]},{"type":"verse","number":74,"content":[{"lineBreak":true},{"text":"敬畏你的人見我就歡喜，","poem":1},{"lineBreak":true},{"text":"因為你的話是我的盼望。","poem":1}]},{"type":"verse","number":75,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"我知道你的法令公義，","poem":1},{"lineBreak":true},{"text":"你是憑信實管教我。","poem":1}]},{"type":"verse","number":76,"content":[{"lineBreak":true},{"text":"求你照著你給僕人的應許，","poem":1},{"lineBreak":true},{"text":"用你的慈愛來安慰我。","poem":1}]},{"type":"verse","number":77,"content":[{"lineBreak":true},{"text":"求你憐憫我，使我可以存活，","poem":1},{"lineBreak":true},{"text":"因為你的律法是我的喜樂。","poem":1}]},{"type":"verse","number":78,"content":[{"lineBreak":true},{"text":"願狂傲人受辱，","poem":1},{"lineBreak":true},{"text":"因他們詆譭我；","poem":1},{"lineBreak":true},{"text":"但我要默想你的法則。","poem":1}]},{"type":"verse","number":79,"content":[{"lineBreak":true},{"text":"願敬畏你的人到我這裡來，","poem":1},{"lineBreak":true},{"text":"好明白你的法度。","poem":1}]},{"type":"verse","number":80,"content":[{"lineBreak":true},{"text":"願我能全心遵守你的律例，","poem":1},{"lineBreak":true},{"text":"使我不致羞愧。","poem":1}]},{"type":"verse","number":81,"content":[{"lineBreak":true},{"text":"我的心迫切渴慕你的拯救，","poem":1},{"lineBreak":true},{"text":"你的話是我的盼望。","poem":1}]},{"type":"verse","number":82,"content":[{"lineBreak":true},{"text":"我期盼你的應許實現，","poem":1},{"lineBreak":true},{"text":"望眼欲穿。","poem":1},{"lineBreak":true},{"text":"我說：「你何時才安慰我？」","poem":1}]},{"type":"verse","number":83,"content":[{"lineBreak":true},{"text":"我形容枯槁，好像煙薰的皮袋，","poem":1},{"lineBreak":true},{"text":"但我仍然沒有忘記你的律例。","poem":1}]},{"type":"verse","number":84,"content":[{"lineBreak":true},{"text":"你僕人還要等候多久呢？","poem":1},{"lineBreak":true},{"text":"你何時才會懲罰那些迫害我的人呢？","poem":1}]},{"type":"verse","number":85,"content":[{"lineBreak":true},{"text":"違背你律法的狂傲人挖陷阱害我。","poem":1}]},{"type":"verse","number":86,"content":[{"lineBreak":true},{"text":"你的一切命令都可靠，","poem":1},{"lineBreak":true},{"text":"他們無故地迫害我，","poem":1},{"lineBreak":true},{"text":"求你幫助我。","poem":1}]},{"type":"verse","number":87,"content":[{"lineBreak":true},{"text":"他們幾乎置我於死地，","poem":1},{"lineBreak":true},{"text":"但我仍然沒有背棄你的法則。","poem":1}]},{"type":"verse","number":88,"content":[{"lineBreak":true},{"text":"求你施慈愛保全我性命，","poem":1},{"lineBreak":true},{"text":"我好遵守你頒布的法度。","poem":1}]},{"type":"verse","number":89,"content":[{"lineBreak":true},{"text":"耶和華啊，你的話立定在天，","poem":1},{"lineBreak":true},{"text":"永遠不變。","poem":1}]},{"type":"verse","number":90,"content":[{"lineBreak":true},{"text":"你的信實萬代長存；","poem":1},{"lineBreak":true},{"text":"你奠定大地，它恆久不變。","poem":1}]},{"type":"verse","number":91,"content":[{"lineBreak":true},{"text":"天地照你的法令存到今日，","poem":1},{"lineBreak":true},{"text":"因為萬物都是你的僕役。","poem":1}]},{"type":"verse","number":92,"content":[{"lineBreak":true},{"text":"我若不以你的律法為樂，","poem":1},{"lineBreak":true},{"text":"早已死在苦難中了。","poem":1}]},{"type":"verse","number":93,"content":[{"lineBreak":true},{"text":"我永不忘記你的法則，","poem":1},{"lineBreak":true},{"text":"因你藉此保全我性命。","poem":1}]},{"type":"verse","number":94,"content":[{"lineBreak":true},{"text":"我屬於你，求你拯救我，","poem":1},{"lineBreak":true},{"text":"因為我尋求你的法則。","poem":1}]},{"type":"verse","number":95,"content":[{"lineBreak":true},{"text":"惡人伺機害我，","poem":1},{"lineBreak":true},{"text":"但我仍然思想你的法度。","poem":1}]},{"type":"verse","number":96,"content":[{"lineBreak":true},{"text":"我看到萬事都有盡頭，","poem":1},{"lineBreak":true},{"text":"唯有你的命令無邊無界。","poem":1}]},{"type":"verse","number":97,"content":[{"lineBreak":true},{"text":"我多麼愛慕你的律法，","poem":1},{"lineBreak":true},{"text":"終日默想。","poem":1}]},{"type":"verse","number":98,"content":[{"lineBreak":true},{"text":"你的命令常在我心中，","poem":1},{"lineBreak":true},{"text":"它使我比仇敵有智慧。","poem":1}]},{"type":"verse","number":99,"content":[{"lineBreak":true},{"text":"我比所有老師更有洞見，","poem":1},{"lineBreak":true},{"text":"因為我默想你的法度。","poem":1}]},{"type":"verse","number":100,"content":[{"lineBreak":true},{"text":"我比長者更明智，","poem":1},{"lineBreak":true},{"text":"因為我遵守你的法則。","poem":1}]},{"type":"verse","number":101,"content":[{"lineBreak":true},{"text":"為了遵行你的話，","poem":1},{"lineBreak":true},{"text":"我拒絕走惡道。","poem":1}]},{"type":"verse","number":102,"content":[{"lineBreak":true},{"text":"我沒有偏離你的法令，","poem":1},{"lineBreak":true},{"text":"因為你教導過我。","poem":1}]},{"type":"verse","number":103,"content":[{"lineBreak":true},{"text":"你的話在我上顎何等甘美，","poem":1},{"lineBreak":true},{"text":"在我口中比蜜還甜。","poem":1}]},{"type":"verse","number":104,"content":[{"lineBreak":true},{"text":"我從你的法則中得到智慧，","poem":1},{"lineBreak":true},{"text":"因此我厭惡一切詭詐之道。","poem":1}]},{"type":"verse","number":105,"content":[{"lineBreak":true},{"text":"你的話是我腳前的燈，","poem":1},{"lineBreak":true},{"text":"是我路上的光。","poem":1}]},{"type":"verse","number":106,"content":[{"lineBreak":true},{"text":"我已起誓，我必信守諾言：","poem":1},{"lineBreak":true},{"text":"我要遵行你公義的法令。","poem":1}]},{"type":"verse","number":107,"content":[{"lineBreak":true},{"text":"我飽受痛苦，耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你照你的話保全我性命。","poem":1}]},{"type":"verse","number":108,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你悅納我由衷的讚美，","poem":1},{"lineBreak":true},{"text":"將你的法令教導我。","poem":1}]},{"type":"verse","number":109,"content":[{"lineBreak":true},{"text":"我的生命時刻面臨危險，","poem":1},{"lineBreak":true},{"text":"但我不會忘記你的律法。","poem":1}]},{"type":"verse","number":110,"content":[{"lineBreak":true},{"text":"惡人為我設下網羅，","poem":1},{"lineBreak":true},{"text":"但我沒有偏離你的法則。","poem":1}]},{"type":"verse","number":111,"content":[{"lineBreak":true},{"text":"你的法度永遠是我的寶貴產業，","poem":1},{"lineBreak":true},{"text":"是我心中的喜樂。","poem":1}]},{"type":"verse","number":112,"content":[{"lineBreak":true},{"text":"我決心遵行你的律例，","poem":1},{"lineBreak":true},{"text":"一直到底。","poem":1}]},{"type":"verse","number":113,"content":[{"lineBreak":true},{"text":"我厭惡心懷二意的人，","poem":1},{"lineBreak":true},{"text":"我喜愛你的律法。","poem":1}]},{"type":"verse","number":114,"content":[{"lineBreak":true},{"text":"你是我的藏身之所，","poem":1},{"lineBreak":true},{"text":"是我的盾牌，","poem":1},{"lineBreak":true},{"text":"你的話語是我的盼望。","poem":1}]},{"type":"verse","number":115,"content":[{"lineBreak":true},{"text":"你們這些惡人離開我吧，","poem":1},{"lineBreak":true},{"text":"我要遵行我上帝的命令。","poem":1}]},{"type":"verse","number":116,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你按你的應許扶持我，","poem":1},{"lineBreak":true},{"text":"使我存活，","poem":1},{"lineBreak":true},{"text":"不要使我的盼望落空。","poem":1}]},{"type":"verse","number":117,"content":[{"lineBreak":true},{"text":"求你扶持我，使我得救，","poem":1},{"lineBreak":true},{"text":"我要時刻關注你的律例。","poem":1}]},{"type":"verse","number":118,"content":[{"lineBreak":true},{"text":"你棄絕一切偏離你律例的人，","poem":1},{"lineBreak":true},{"text":"他們的詭計無法得逞。","poem":1}]},{"type":"verse","number":119,"content":[{"lineBreak":true},{"text":"你剷除世上的惡人，","poem":1},{"lineBreak":true},{"text":"如同除掉渣滓，","poem":1},{"lineBreak":true},{"text":"因此我喜愛你的法度。","poem":1}]},{"type":"verse","number":120,"content":[{"lineBreak":true},{"text":"我因敬畏你而戰慄，","poem":1},{"lineBreak":true},{"text":"我懼怕你的法令。","poem":1}]},{"type":"verse","number":121,"content":[{"lineBreak":true},{"text":"我做事公平正直，","poem":1},{"lineBreak":true},{"text":"求你不要把我交給欺壓我的人。","poem":1}]},{"type":"verse","number":122,"content":[{"lineBreak":true},{"text":"求你保障僕人的福祉，","poem":1},{"lineBreak":true},{"text":"不要讓傲慢的人欺壓我。","poem":1}]},{"type":"verse","number":123,"content":[{"lineBreak":true},{"text":"我望眼欲穿地期盼你拯救我，","poem":1},{"lineBreak":true},{"text":"盼望你實現你公義的應許。","poem":1}]},{"type":"verse","number":124,"content":[{"lineBreak":true},{"text":"求你憑慈愛待你僕人，","poem":1},{"lineBreak":true},{"text":"將你的律例教導我。","poem":1}]},{"type":"verse","number":125,"content":[{"lineBreak":true},{"text":"我是你的僕人，","poem":1},{"lineBreak":true},{"text":"求你賜我悟性可以明白你的法度。","poem":1}]},{"type":"verse","number":126,"content":[{"lineBreak":true},{"text":"耶和華啊，人們違背你的律法，","poem":1},{"lineBreak":true},{"text":"是你懲罰他們的時候了。","poem":1}]},{"type":"verse","number":127,"content":[{"lineBreak":true},{"text":"所以我愛你的命令勝於愛金子，","poem":1},{"lineBreak":true},{"text":"勝於愛純金。","poem":1}]},{"type":"verse","number":128,"content":[{"lineBreak":true},{"text":"我遵行你一切的法則，","poem":1},{"lineBreak":true},{"text":"我憎恨一切惡道。","poem":1}]},{"type":"verse","number":129,"content":[{"lineBreak":true},{"text":"你的法度奇妙，","poem":1},{"lineBreak":true},{"text":"所以我一心遵守。","poem":1}]},{"type":"verse","number":130,"content":[{"lineBreak":true},{"text":"你的話語一解明，","poem":1},{"lineBreak":true},{"text":"就發出亮光，","poem":1},{"lineBreak":true},{"text":"使愚人得到啟迪。","poem":1}]},{"type":"verse","number":131,"content":[{"lineBreak":true},{"text":"我張著口氣喘吁吁，","poem":1},{"lineBreak":true},{"text":"因我渴慕你的命令。","poem":1}]},{"type":"verse","number":132,"content":[{"lineBreak":true},{"text":"求你眷顧我、憐憫我，","poem":1},{"lineBreak":true},{"text":"正如你素來恩待愛你名的人。","poem":1}]},{"type":"verse","number":133,"content":[{"lineBreak":true},{"text":"求你照你的應許引導我的腳步，","poem":1},{"lineBreak":true},{"text":"不要讓罪惡轄制我。","poem":1}]},{"type":"verse","number":134,"content":[{"lineBreak":true},{"text":"求你救我脫離惡人的欺壓，","poem":1},{"lineBreak":true},{"text":"好使我能遵守你的法則。","poem":1}]},{"type":"verse","number":135,"content":[{"lineBreak":true},{"text":"求你以容光照耀僕人，","poem":1},{"lineBreak":true},{"text":"將你的律例教導我。","poem":1}]},{"type":"verse","number":136,"content":[{"lineBreak":true},{"text":"我淚流成河，","poem":1},{"lineBreak":true},{"text":"因為人們不遵行你的律法。","poem":1}]},{"type":"verse","number":137,"content":[{"lineBreak":true},{"text":"耶和華啊，你是公義的，","poem":1},{"lineBreak":true},{"text":"你的法令是公正的。","poem":1}]},{"type":"verse","number":138,"content":[{"lineBreak":true},{"text":"你定的法度公義，完全可信。","poem":1}]},{"type":"verse","number":139,"content":[{"lineBreak":true},{"text":"我看見仇敵無視你的話語，","poem":1},{"lineBreak":true},{"text":"就心急如焚。","poem":1}]},{"type":"verse","number":140,"content":[{"lineBreak":true},{"text":"你僕人喜愛你的應許，","poem":1},{"lineBreak":true},{"text":"因為你的應許純全可靠。","poem":1}]},{"type":"verse","number":141,"content":[{"lineBreak":true},{"text":"我雖然卑微、受人藐視，","poem":1},{"lineBreak":true},{"text":"但我不忘記你的法則。","poem":1}]},{"type":"verse","number":142,"content":[{"lineBreak":true},{"text":"你的公義常存，","poem":1},{"lineBreak":true},{"text":"你的律法是真理。","poem":1}]},{"type":"verse","number":143,"content":[{"lineBreak":true},{"text":"我雖然遭遇困苦患難，","poem":1},{"lineBreak":true},{"text":"但你的命令是我的喜樂。","poem":1}]},{"type":"verse","number":144,"content":[{"lineBreak":true},{"text":"你的法度永遠公正，","poem":1},{"lineBreak":true},{"text":"求你賜我悟性，使我存活。","poem":1}]},{"type":"verse","number":145,"content":[{"lineBreak":true},{"text":"耶和華啊，我全心呼求你，","poem":1},{"lineBreak":true},{"text":"求你應允我，","poem":1},{"lineBreak":true},{"text":"我必遵守你的律例。","poem":1}]},{"type":"verse","number":146,"content":[{"lineBreak":true},{"text":"我向你呼求，求你救我，","poem":1},{"lineBreak":true},{"text":"我必持守你的法度。","poem":1}]},{"type":"verse","number":147,"content":[{"lineBreak":true},{"text":"天不亮，","poem":1},{"lineBreak":true},{"text":"我就起來呼求你的幫助，","poem":1},{"lineBreak":true},{"text":"你的話語是我的盼望。","poem":1}]},{"type":"verse","number":148,"content":[{"lineBreak":true},{"text":"我整夜不睡，默想你的應許。","poem":1}]},{"type":"verse","number":149,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你憑你的慈愛垂聽我的呼求，","poem":1},{"lineBreak":true},{"text":"照你的法令保全我性命。","poem":1}]},{"type":"verse","number":150,"content":[{"lineBreak":true},{"text":"作惡多端的人逼近了，","poem":1},{"lineBreak":true},{"text":"他們遠離你的律法。","poem":1}]},{"type":"verse","number":151,"content":[{"lineBreak":true},{"text":"但耶和華啊，你就在我身邊，","poem":1},{"lineBreak":true},{"text":"你的一切命令都是真理。","poem":1}]},{"type":"verse","number":152,"content":[{"lineBreak":true},{"text":"我很早就從你的法度中知道，","poem":1},{"lineBreak":true},{"text":"你立的法度永遠長存。","poem":1}]},{"type":"verse","number":153,"content":[{"lineBreak":true},{"text":"求你鑒察我的苦難，搭救我，","poem":1},{"lineBreak":true},{"text":"因為我沒有忘記你的律法。","poem":1}]},{"type":"verse","number":154,"content":[{"lineBreak":true},{"text":"求你為我伸冤，救贖我，","poem":1},{"lineBreak":true},{"text":"照你的應許保全我性命。","poem":1}]},{"type":"verse","number":155,"content":[{"lineBreak":true},{"text":"惡人不尋求你的律例，","poem":1},{"lineBreak":true},{"text":"以致得不到拯救。","poem":1}]},{"type":"verse","number":156,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"你有無比的憐憫之心，","poem":1},{"lineBreak":true},{"text":"求你照你的法令保全我性命。","poem":1}]},{"type":"verse","number":157,"content":[{"lineBreak":true},{"text":"迫害我的仇敵眾多，","poem":1},{"lineBreak":true},{"text":"但我卻沒有偏離你的法度。","poem":1}]},{"type":"verse","number":158,"content":[{"lineBreak":true},{"text":"我看見背信之徒就厭惡，","poem":1},{"lineBreak":true},{"text":"因為他們不遵行你的話。","poem":1}]},{"type":"verse","number":159,"content":[{"lineBreak":true},{"text":"耶和華啊，你看我多愛你的法則，","poem":1},{"lineBreak":true},{"text":"求你施慈愛保全我性命。","poem":1}]},{"type":"verse","number":160,"content":[{"lineBreak":true},{"text":"你的話都是真理，","poem":1},{"lineBreak":true},{"text":"你一切公義的法令永不改變。","poem":1}]},{"type":"verse","number":161,"content":[{"lineBreak":true},{"text":"權貴無故迫害我，","poem":1},{"lineBreak":true},{"text":"但我的心對你的話充滿敬畏。","poem":1}]},{"type":"verse","number":162,"content":[{"lineBreak":true},{"text":"我喜愛你的應許，","poem":1},{"lineBreak":true},{"text":"如獲至寶。","poem":1}]},{"type":"verse","number":163,"content":[{"lineBreak":true},{"text":"我憎惡虛假，","poem":1},{"lineBreak":true},{"text":"但我喜愛你的律法。","poem":1}]},{"type":"verse","number":164,"content":[{"lineBreak":true},{"text":"因你公義的法令，","poem":1},{"lineBreak":true},{"text":"我要每天七次讚美你。","poem":1}]},{"type":"verse","number":165,"content":[{"lineBreak":true},{"text":"喜愛你律法的人大有平安，","poem":1},{"lineBreak":true},{"text":"什麼也不能使他跌倒。","poem":1}]},{"type":"verse","number":166,"content":[{"lineBreak":true},{"text":"耶和華啊，我等候你的拯救，","poem":1},{"lineBreak":true},{"text":"我遵行你的命令。","poem":1}]},{"type":"verse","number":167,"content":[{"lineBreak":true},{"text":"我深愛你的法度，一心遵守。","poem":1}]},{"type":"verse","number":168,"content":[{"lineBreak":true},{"text":"我遵守你的法則和法度，","poem":1},{"lineBreak":true},{"text":"你知道我做的每一件事。","poem":1}]},{"type":"verse","number":169,"content":[{"lineBreak":true},{"text":"耶和華啊，求你垂聽我的呼求，","poem":1},{"lineBreak":true},{"text":"照你的話賜我悟性。","poem":1}]},{"type":"verse","number":170,"content":[{"lineBreak":true},{"text":"求你垂聽我的祈求，","poem":1},{"lineBreak":true},{"text":"照你的應許拯救我。","poem":1}]},{"type":"verse","number":171,"content":[{"lineBreak":true},{"text":"願我的嘴唇湧出讚美，","poem":1},{"lineBreak":true},{"text":"因你將你的律例教導了我。","poem":1}]},{"type":"verse","number":172,"content":[{"lineBreak":true},{"text":"願我的舌頭歌頌你的應許，","poem":1},{"lineBreak":true},{"text":"因為你一切的命令盡都公義。","poem":1}]},{"type":"verse","number":173,"content":[{"lineBreak":true},{"text":"願你的手隨時幫助我，","poem":1},{"lineBreak":true},{"text":"因為我選擇了你的法則。","poem":1}]},{"type":"verse","number":174,"content":[{"lineBreak":true},{"text":"耶和華啊，我盼望你的拯救，","poem":1},{"lineBreak":true},{"text":"你的律法是我的喜樂。","poem":1}]},{"type":"verse","number":175,"content":[{"lineBreak":true},{"text":"求你讓我存活，我好讚美你，","poem":1},{"lineBreak":true},{"text":"願你的法令成為我的幫助。","poem":1}]},{"type":"verse","number":176,"content":[{"lineBreak":true},{"text":"我像隻迷途的羊，","poem":1},{"lineBreak":true},{"text":"求你來尋找僕人，","poem":1},{"lineBreak":true},{"text":"因為我沒有忘記你的命令。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}