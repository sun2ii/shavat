rue},{"text":"耶和華的言語純全，","poem":1},{"lineBreak":true},{"text":"就像在爐中煉過七次的銀子。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華啊，你必保護貧苦人，","poem":1},{"lineBreak":true},{"text":"永遠不容惡人侵害我們。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"眾人若抑善揚惡，","poem":1},{"lineBreak":true},{"text":"惡人必橫行無忌。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}