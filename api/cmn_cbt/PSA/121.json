ent":[{"lineBreak":true},{"text":"不論你出或入，","poem":1},{"lineBreak":true},{"text":"耶和華都會保護你，從現在直到永遠。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}