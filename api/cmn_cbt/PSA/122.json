{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":122,"content":[{"type":"heading","content":["為耶路撒冷禱告"]},{"type":"hebrew_subtitle","content":["大衛的上聖殿朝聖之詩。"]},{"type":"verse","number":1,"content":[{"text":"人們對我說：","poem":1},{"lineBreak":true},{"text":"「讓我們去耶和華的殿吧！」","poem":1},{"lineBreak":true},{"text":"我感到歡喜。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，","poem":1},{"lineBreak":true},{"text":"我們正站在你的城門裡。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶路撒冷被建成一座整齊堅固的城。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華揀選的以色列各支派，","poem":1},{"lineBreak":true},{"text":"都遵照祂賜的法度去那裡稱謝祂的名。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"那裡有審判的王座，","poem":1},{"lineBreak":true},{"text":"就是大衛家的王座。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"要為耶路撒冷的平安禱告，","poem":1},{"lineBreak":true},{"text":"願愛這城的人亨通。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶路撒冷啊！","poem":1},{"lineBreak":true},{"text":"願你城內有平安，","poem":1},{"lineBreak":true},{"text":"你的宮裡有安寧，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"為了我的親人和朋友，","poem":1},{"lineBreak":true},{"text":"我要祈求平安臨到你。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"為了我們的上帝耶和華的殿，","poem":1},{"lineBreak":true},{"text":"我要為你求福祉。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}