mber":8,"content":[{"lineBreak":true},{"text":"我們的幫助來自創造天地的耶和華的名。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}