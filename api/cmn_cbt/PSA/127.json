{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":127,"content":[{"type":"heading","content":["頌讚上帝的美善"]},{"type":"hebrew_subtitle","content":["所羅門上聖殿朝聖之詩。"]},{"type":"verse","number":1,"content":[{"text":"若不是耶和華建造房屋，","poem":1},{"lineBreak":true},{"text":"建造的人都徒然勞力。","poem":1},{"lineBreak":true},{"text":"若不是耶和華看守城池，","poem":1},{"lineBreak":true},{"text":"看守的人都徒然守望。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你早起晚睡，","poem":1},{"lineBreak":true},{"text":"為生活操勞也是徒然，","poem":1},{"lineBreak":true},{"text":"因為耶和華使祂所愛的人安眠。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"兒女是耶和華所賜的產業，","poem":1},{"lineBreak":true},{"text":"孩子是祂所給的賞賜。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"人年輕時生的兒女猶如戰士手中的箭。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"袋中裝滿了箭的人有福了！","poem":1},{"lineBreak":true},{"text":"他們在城門與仇敵爭論時，","poem":1},{"lineBreak":true},{"text":"必不致蒙羞。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}