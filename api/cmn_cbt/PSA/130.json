{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":130,"content":[{"type":"heading","content":["患難中求助的禱告"]},{"type":"hebrew_subtitle","content":["上聖殿朝聖之詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊！","poem":1},{"lineBreak":true},{"text":"我從深淵向你呼求。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"主啊，求你垂聽我的呼求，","poem":1},{"lineBreak":true},{"text":"側耳聽我的祈求。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"主耶和華啊，","poem":1},{"lineBreak":true},{"text":"倘若你追究我們的罪過，","poem":1},{"lineBreak":true},{"text":"誰能站得住呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"然而，你樂意赦免，","poem":1},{"lineBreak":true},{"text":"所以你當受敬畏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我等候耶和華，一心等候祂，","poem":1},{"lineBreak":true},{"text":"祂的話語是我的盼望。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我一心等候主，","poem":1},{"lineBreak":true},{"text":"比守夜的盼望天明還要迫切，","poem":1},{"lineBreak":true},{"text":"比守夜的盼望天明還要迫切。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"以色列啊，要仰望耶和華，","poem":1},{"lineBreak":true},{"text":"因為祂有慈愛，有完全的救贖。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂必救贖以色列脫離一切罪惡。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}