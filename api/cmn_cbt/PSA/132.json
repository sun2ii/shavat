{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":132,"content":[{"type":"heading","content":["求上帝賜福聖殿"]},{"type":"hebrew_subtitle","content":["上聖殿朝聖之詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你顧念大衛和他所受的一切苦難。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他曾向耶和華起誓，","poem":1},{"lineBreak":true},{"text":"向雅各的大能者許願說：","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"「我不為耶和華找到居所，","poem":1},{"lineBreak":true},{"text":"不為雅各的大能者找到安居之處，","poem":1},{"lineBreak":true},{"text":"必不進家門，","poem":1},{"lineBreak":true},{"text":"不沾床，不睡覺，不打盹。」","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我們在以法他聽到約櫃的消息，","poem":1},{"lineBreak":true},{"text":"在雅珥的田野找到了它。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"讓我們進入耶和華的居所，","poem":1},{"lineBreak":true},{"text":"在祂腳凳前俯伏敬拜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你起來和你大能的約櫃一同進入安息之所。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"願你的祭司身披公義，","poem":1},{"lineBreak":true},{"text":"願你忠心的子民歡唱。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"為了你僕人大衛的緣故，","poem":1},{"lineBreak":true},{"text":"求你不要棄絕你所膏立的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和華曾向大衛起了永不廢棄的誓說：","poem":1},{"lineBreak":true},{"text":"「我必使你的後代繼承你的王位。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你的後代若守我的約，","poem":1},{"lineBreak":true},{"text":"遵行我教導他們的法度，","poem":1},{"lineBreak":true},{"text":"他們的子孫必永遠坐在你的寶座上。」","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因為耶和華已經揀選了錫安，","poem":1},{"lineBreak":true},{"text":"願意將錫安作為祂的居所。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂說：「這是我永遠的安息之所；","poem":1},{"lineBreak":true},{"text":"我要住在這裡，","poem":1},{"lineBreak":true},{"text":"因為我喜歡這地方。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要賜福，使她糧食充足，","poem":1},{"lineBreak":true},{"text":"使她裡面的窮人飲食無憂。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要用救恩作她祭司的衣裳，","poem":1},{"lineBreak":true},{"text":"她忠心的子民必歡唱。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我必使大衛的角在那裡興起，","poem":1},{"lineBreak":true},{"text":"我必為我所膏立的預備明燈。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我必使他的仇敵抱愧蒙羞，","poem":1},{"lineBreak":true},{"text":"但他頭上的王冠必光芒四射。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":16}