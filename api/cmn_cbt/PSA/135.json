{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":135,"content":[{"type":"heading","content":["讚美之歌"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"讚美祂的名！","poem":1},{"lineBreak":true},{"text":"耶和華的僕人啊，","poem":1},{"lineBreak":true},{"text":"在耶和華的殿中，","poem":1},{"lineBreak":true},{"text":"在我們上帝的院宇中事奉的人啊，","poem":1},{"lineBreak":true},{"text":"你們要讚美祂！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們要讚美耶和華，","poem":1},{"lineBreak":true},{"text":"因為祂是美善的；","poem":1},{"lineBreak":true},{"text":"你們要歌頌祂的名，","poem":1},{"lineBreak":true},{"text":"因為祂的名美好無比。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂揀選雅各做祂的子民，","poem":1},{"lineBreak":true},{"text":"揀選以色列作祂的產業。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我知道耶和華偉大，","poem":1},{"lineBreak":true},{"text":"我們的主超越一切神明。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華在天上、地下、海洋、","poem":1},{"lineBreak":true},{"text":"深淵按自己的旨意行事。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂使雲霧從地極上升，","poem":1},{"lineBreak":true},{"text":"發出電光，帶來雨水，","poem":1},{"lineBreak":true},{"text":"從祂的倉庫帶出風來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"祂擊殺了埃及人的長子和頭胎的牲畜。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂在埃及行神蹟奇事，","poem":1},{"lineBreak":true},{"text":"懲罰法老和他的一切臣僕。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂毀滅列國，","poem":1},{"lineBreak":true},{"text":"殺戮強大的君王：","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"亞摩利王西宏、巴珊王噩和迦南所有的君王。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂把這些國家的土地賜給祂的以色列子民，","poem":1},{"lineBreak":true},{"text":"作為他們的產業。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華啊，你的名永遠長存，","poem":1},{"lineBreak":true},{"text":"耶和華啊，你的威名傳到萬代。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因為耶和華必為祂的子民伸冤，","poem":1},{"lineBreak":true},{"text":"憐憫祂的僕人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"外族人的偶像是人用金銀造的。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"它們有口不能言，有眼不能看，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"有耳不能聽，口中毫無氣息。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"造偶像的必和偶像一樣，","poem":1},{"lineBreak":true},{"text":"信靠偶像的人也是如此。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"以色列人啊，","poem":1},{"lineBreak":true},{"text":"你們要稱頌耶和華！","poem":1},{"lineBreak":true},{"text":"亞倫家啊，","poem":1},{"lineBreak":true},{"text":"你們要稱頌耶和華！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"利未家啊，","poem":1},{"lineBreak":true},{"text":"你們要稱頌耶和華！","poem":1},{"lineBreak":true},{"text":"你們敬畏耶和華的人都要稱頌祂！","poem":1},{"noteId":10}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"要讚美錫安的耶和華，","poem":1},{"lineBreak":true},{"text":"讚美住在耶路撒冷的耶和華。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"平行經文：詩篇115·4‑11。","reference":{"chapter":135,"verse":20}}]},"thisChapterLink":"/api/cmn_cbt/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":20}