{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":136,"content":[{"type":"heading","content":["上帝的慈愛永遠長存"]},{"type":"verse","number":1,"content":[{"text":"你們要稱謝耶和華，","poem":1},{"lineBreak":true},{"text":"因為祂是美善的，","poem":1},{"lineBreak":true},{"text":"祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們要稱謝萬神之神，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們要稱謝萬主之主，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"要稱謝那位獨行大奇事的，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要稱謝那位用智慧創造諸天的，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"要稱謝那位在水上鋪展大地的，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"要稱謝那位創造大光的，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂讓太陽管理白晝，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂讓月亮星辰管理黑夜，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"要稱謝那位擊殺埃及人長子的，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂帶領以色列人離開埃及，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂伸出臂膀施展大能，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"要稱謝那位分開紅海的，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂引領以色列人走過紅海，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂讓法老和他的軍兵葬身紅海，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"要稱謝那位帶領祂子民走過曠野的，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"要稱謝那位擊殺大君王的，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂擊殺了大能的君王，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂擊殺了亞摩利王西宏，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"祂擊殺了巴珊王噩，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"祂把他們的土地賜給祂子民作產業，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"祂把他們的土地賜給祂的僕人以色列人作產業，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"祂眷顧處於卑賤境地的我們，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"祂拯救我們脫離仇敵，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"祂賜食物給一切活物，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"你們要稱謝天上的上帝，","poem":1},{"lineBreak":true},{"text":"因為祂的慈愛永遠長存。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}