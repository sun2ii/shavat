{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":137,"content":[{"type":"heading","content":["被擄者的哀歌"]},{"type":"verse","number":1,"content":[{"text":"我們坐在巴比倫河畔，","poem":1},{"lineBreak":true},{"text":"想起錫安禁不住淒然淚下。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我們把琴掛在柳樹上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為俘虜我們的人要我們在那裡唱歌，","poem":1},{"lineBreak":true},{"text":"擄掠我們的人要我們歌唱，說：","poem":1},{"lineBreak":true},{"text":"「給我們唱一首錫安的歌。」","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我們流落異邦，","poem":1},{"lineBreak":true},{"text":"怎能唱頌讚耶和華的歌呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，倘若我忘了你，","poem":1},{"lineBreak":true},{"text":"情願我的右手無法再彈琴；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"倘若我忘了你，","poem":1},{"lineBreak":true},{"text":"不以你為我的至愛，","poem":1},{"lineBreak":true},{"text":"情願我的舌頭不能再歌唱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你記住耶路撒冷淪陷時以東人的行徑。","poem":1},{"lineBreak":true},{"text":"他們喊道：","poem":1},{"lineBreak":true},{"text":"「拆毀這城，把它夷為平地！」","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"巴比倫城啊，","poem":1},{"lineBreak":true},{"text":"你快要滅亡了，","poem":1},{"lineBreak":true},{"text":"那向你以牙還牙為我們復仇的人有福了！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"那抓住你的嬰孩摔在石頭上的人有福了！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}