{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":138,"content":[{"type":"heading","content":["感恩的禱告"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我全心稱謝你，","poem":1},{"lineBreak":true},{"text":"在眾神明面前歌頌你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要向你的聖殿下拜，稱謝你的名，","poem":1},{"lineBreak":true},{"text":"因為你是慈愛和信實的，","poem":1},{"lineBreak":true},{"text":"你顯明自己的尊名和應許偉大無比。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我呼求的時候，你就應允我；","poem":1},{"lineBreak":true},{"text":"你使我剛強壯膽。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華啊，世上所有的君王聽見你的話都要稱謝你。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們要歌唱耶和華的作為，","poem":1},{"lineBreak":true},{"text":"因為耶和華榮耀無比。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華雖至高無上，","poem":1},{"lineBreak":true},{"text":"卻仍看顧卑微的人，","poem":1},{"lineBreak":true},{"text":"祂對驕傲的人也瞭若指掌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和華啊，雖然我身陷患難，","poem":1},{"lineBreak":true},{"text":"你必保全我性命，","poem":1},{"lineBreak":true},{"text":"伸手攻擊我惱怒的仇敵，","poem":1},{"lineBreak":true},{"text":"用右手拯救我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華必成就祂為我所定的計劃；","poem":1},{"lineBreak":true},{"text":"耶和華啊，你的慈愛永遠長存。","poem":1},{"lineBreak":true},{"text":"求你不要撇棄你親手所造的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}