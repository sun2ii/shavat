{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":139,"content":[{"type":"heading","content":["上帝的全知和佑護"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，你洞察我，","poem":1},{"lineBreak":true},{"text":"知道我的一切。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我或坐下或起來，你都知道，","poem":1},{"lineBreak":true},{"text":"你從遠處就知道我的心思意念。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我或外出或躺臥，你都瞭解，","poem":1},{"lineBreak":true},{"text":"你熟悉我的一切行為。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華啊，我話未出口，","poem":1},{"lineBreak":true},{"text":"你已洞悉一切。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你在我前後護衛著我，","poem":1},{"lineBreak":true},{"text":"以大能的手保護我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"這一切實在是太奇妙，","poem":1},{"lineBreak":true},{"text":"太深奧了，我無法明白。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我去哪裡可躲開你的靈？","poem":1},{"lineBreak":true},{"text":"我跑到哪裡可避開你的面？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我若升到天上，你在那裡；","poem":1},{"lineBreak":true},{"text":"我若下到陰間，你也在那裡。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"縱使我乘黎明之翼飛到遙遠的海岸居住，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"就是在那裡，你的手必引導我，","poem":1},{"lineBreak":true},{"text":"你大能的手必扶持我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我想，黑暗一定可以遮蔽我，","poem":1},{"lineBreak":true},{"text":"讓我四圍的光明變成黑夜。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"然而，即使黑暗也無法遮住你的視線。","poem":1},{"lineBreak":true},{"text":"在你看來，黑夜亮如白晝，","poem":1},{"lineBreak":true},{"text":"黑暗與光明無異。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你創造了我的肺腑心腸，","poem":1},{"lineBreak":true},{"text":"使我在母腹中成形。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我稱謝你，因為我受造奇妙可畏；","poem":1},{"lineBreak":true},{"text":"你的作為奇妙，我心深深知道。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我在隱秘處被造、在大地深處成形時，","poem":1},{"lineBreak":true},{"text":"你對我的形體一清二楚。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我的身體還未成形，","poem":1},{"lineBreak":true},{"text":"你早已看見了。","poem":1},{"lineBreak":true},{"text":"你為我所定的年日，","poem":1},{"lineBreak":true},{"text":"我尚未開始就已經記在你的冊子上了。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"上帝啊，你的意念對我來說是何等寶貴，","poem":1},{"lineBreak":true},{"text":"數量何等浩博！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我若數算，它們比海沙還多。","poem":1},{"lineBreak":true},{"text":"我醒來的時候，","poem":1},{"lineBreak":true},{"text":"依然與你在一起。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"上帝啊，願你殺戮惡人！","poem":1},{"lineBreak":true},{"text":"嗜血成性的人啊，你們走開！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他們惡言頂撞你，","poem":1},{"lineBreak":true},{"text":"你的仇敵褻瀆你的名。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"我憎恨那些憎恨你的人，","poem":1},{"lineBreak":true},{"text":"我厭惡那些攻擊你的人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我恨透了他們，","poem":1},{"lineBreak":true},{"text":"我視他們為敵人。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"上帝啊，求你鑒察我，","poem":1},{"lineBreak":true},{"text":"好知道我的內心；","poem":1},{"lineBreak":true},{"text":"求你試驗我，好知道我的心思。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"求你看看我裡面是否有邪惡，","poem":1},{"lineBreak":true},{"text":"引導我走永恆的道路。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}