{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":14,"content":[{"type":"heading","content":["世人的邪惡"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"愚昧人心裡想：「沒有上帝。」","poem":1},{"lineBreak":true},{"text":"他們全然敗壞，行為邪惡，","poem":1},{"lineBreak":true},{"text":"無人行善。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華從天上俯視人間，","poem":1},{"lineBreak":true},{"text":"要看有沒有明智者，","poem":1},{"lineBreak":true},{"text":"有沒有尋求上帝的人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人人偏離正道，","poem":1},{"lineBreak":true},{"text":"一同墮落；","poem":1},{"lineBreak":true},{"text":"無人行善，","poem":1},{"lineBreak":true},{"text":"連一個也沒有！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"惡人吞吃我的百姓如同吃飯，","poem":1},{"lineBreak":true},{"text":"他們不求告耶和華。","poem":1},{"lineBreak":true},{"text":"難道他們都無知嗎？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但他們終必充滿恐懼，","poem":1},{"lineBreak":true},{"text":"因為上帝在義人當中。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你們惡人羞辱困苦人的計劃，","poem":1},{"lineBreak":true},{"text":"但耶和華是他們的避難所。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"願以色列的拯救來自錫安！","poem":1},{"lineBreak":true},{"text":"耶和華救回祂被擄的子民時，","poem":1},{"lineBreak":true},{"text":"雅各要歡喜，以色列要快樂。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}