{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":140,"content":[{"type":"heading","content":["祈求上帝保護"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊！","poem":1},{"lineBreak":true},{"text":"求你拯救我脫離惡人，","poem":1},{"lineBreak":true},{"text":"保護我脫離殘暴之徒。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他們心懷叵測，整天挑起爭端。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們的言語惡毒如蛇，","poem":1},{"lineBreak":true},{"text":"嘴唇有蛇的毒液。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你使我免遭惡人的毒手，","poem":1},{"lineBreak":true},{"text":"保護我脫離殘暴之徒。","poem":1},{"lineBreak":true},{"text":"他們圖謀害我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"傲慢人在我的路上暗設網羅，","poem":1},{"lineBreak":true},{"text":"佈下圈套，挖了陷阱。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我對耶和華說：「你是我的上帝。」","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你垂聽我的呼求。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"主耶和華，我大能的拯救者啊，","poem":1},{"lineBreak":true},{"text":"在戰爭的日子，你護庇我的頭。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你不要讓惡人的願望實現，","poem":1},{"lineBreak":true},{"text":"不要讓他們的陰謀得逞，","poem":1},{"lineBreak":true},{"text":"免得他們狂妄自大。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"願那些圍攻我的人自食其嘴唇的惡果。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"願火炭落在他們身上，","poem":1},{"lineBreak":true},{"text":"願他們被扔進火裡，","poem":1},{"lineBreak":true},{"text":"被拋進深坑，不再興起。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"願譭謗者在地上無法立足，","poem":1},{"lineBreak":true},{"text":"願禍患毀滅殘暴之徒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我知道耶和華必為貧窮人伸張正義，","poem":1},{"lineBreak":true},{"text":"為困苦者伸冤。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"義人必讚美你的名，","poem":1},{"lineBreak":true},{"text":"正直人必活在你面前。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}