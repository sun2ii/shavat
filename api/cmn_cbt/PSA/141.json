{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":141,"content":[{"type":"heading","content":["求上帝蔭庇"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我向你呼求，","poem":1},{"lineBreak":true},{"text":"求你快來幫助我；","poem":1},{"lineBreak":true},{"text":"我向你呼求的時候，求你垂聽。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願我的禱告如香升到你面前，","poem":1},{"lineBreak":true},{"text":"願我舉手所獻的禱告如同晚祭。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你守住我的口，","poem":1},{"lineBreak":true},{"text":"看住我的嘴。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華啊，求你不要讓我的心偏向邪惡，","poem":1},{"lineBreak":true},{"text":"免得我與惡人同流合污；","poem":1},{"lineBreak":true},{"text":"也不要讓我吃他們的美食。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我情願受義人出於愛心的責打，","poem":1},{"lineBreak":true},{"text":"他們的責備是良藥，我不會逃避。","poem":1},{"lineBreak":true},{"text":"我要不斷地用禱告抵擋惡人的行徑。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們的首領被拋下懸崖的時候，","poem":1},{"lineBreak":true},{"text":"他們就會知道我所言不虛。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"那些惡人的骨頭散落在陰間入口，","poem":1},{"lineBreak":true},{"text":"好像耕田翻起的土塊。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"主耶和華啊，","poem":1},{"lineBreak":true},{"text":"我仰望你，我投靠你，","poem":1},{"lineBreak":true},{"text":"求你不要讓我遭害。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你保守我不落入惡人設下的網羅，","poem":1},{"lineBreak":true},{"text":"不要掉進他們的陷阱。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"願他們作繭自縛，","poem":1},{"lineBreak":true},{"text":"而我可以安然逃脫。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}