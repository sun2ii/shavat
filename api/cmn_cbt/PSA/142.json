{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":142,"content":[{"type":"heading","content":["苦難中的呼求"]},{"type":"hebrew_subtitle","content":["大衛在洞裡作的訓誨詩，也是禱告。"]},{"type":"verse","number":1,"content":[{"text":"我向耶和華大聲呼求，","poem":1},{"lineBreak":true},{"text":"我高聲向祂求助，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在祂面前傾訴我的苦情，","poem":1},{"lineBreak":true},{"text":"向祂述說我的患難。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華啊，我心力交瘁的時候，","poem":1},{"lineBreak":true},{"text":"只有你知道我當走的路。","poem":1},{"lineBreak":true},{"text":"敵人已在我行的路上鋪下網羅。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"看看我左右，無人關心我；","poem":1},{"lineBreak":true},{"text":"我走投無路，無人眷顧我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華啊，我向你呼求，","poem":1},{"lineBreak":true},{"text":"你是我的避難所，","poem":1},{"lineBreak":true},{"text":"在世上你是我的福分。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你垂聽我的呼求，","poem":1},{"lineBreak":true},{"text":"因為我身陷絕境。","poem":1},{"lineBreak":true},{"text":"求你救我脫離迫害我的人，","poem":1},{"lineBreak":true},{"text":"因為他們比我強大。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你救我脫離牢籠，","poem":1},{"lineBreak":true},{"text":"好讓我讚美你。","poem":1},{"lineBreak":true},{"text":"因為你恩待我，","poem":1},{"lineBreak":true},{"text":"義人必聚集在我周圍。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}