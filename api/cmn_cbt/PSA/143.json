{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":143,"content":[{"type":"heading","content":["求上帝拯救"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你垂聽我的禱告，","poem":1},{"lineBreak":true},{"text":"傾聽我的祈求，","poem":1},{"lineBreak":true},{"text":"求你憑你的信實和公義應允我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你不要審判你的僕人，","poem":1},{"lineBreak":true},{"text":"因為在你面前世間沒有一個義人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"敵人迫害我，打垮我，","poem":1},{"lineBreak":true},{"text":"使我生活在黑暗中，","poem":1},{"lineBreak":true},{"text":"像死去很久的人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我精疲力竭，心驚膽戰。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我想起遙遠的過去，","poem":1},{"lineBreak":true},{"text":"我默想你的一切作為，","poem":1},{"lineBreak":true},{"text":"我回想你所做的事。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我舉手向你呼求，","poem":1},{"lineBreak":true},{"text":"我的心渴慕你如同乾旱之地渴慕甘霖。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和華啊，求你快快應允我！","poem":1},{"lineBreak":true},{"text":"我已絕望，求你不要掩面不顧我，","poem":1},{"lineBreak":true},{"text":"不然我必和下墳墓的人無異。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你讓我在清晨就聽見你的慈言愛語，","poem":1},{"lineBreak":true},{"text":"因為我信靠你；","poem":1},{"lineBreak":true},{"text":"求你指示我當走的路，","poem":1},{"lineBreak":true},{"text":"因為我的心仰望你。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華啊，求你救我脫離仇敵，","poem":1},{"lineBreak":true},{"text":"我要到你那裡尋求庇護。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"求你教導我遵行你的旨意，","poem":1},{"lineBreak":true},{"text":"因為你是我的上帝，","poem":1},{"lineBreak":true},{"text":"願你良善的靈引導我走平坦的路。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華啊，求你為你的名而保全我性命，","poem":1},{"lineBreak":true},{"text":"憑你的公義救我脫離患難。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你施慈愛，剷除我的仇敵，","poem":1},{"lineBreak":true},{"text":"求你消滅一切迫害我的人，","poem":1},{"lineBreak":true},{"text":"因為我是你的僕人。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}