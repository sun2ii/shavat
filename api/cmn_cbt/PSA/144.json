{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":144,"content":[{"type":"heading","content":["祈求拯救與豐裕"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"我的磐石耶和華當受稱頌，","poem":1},{"lineBreak":true},{"text":"祂訓練我的手作戰，","poem":1},{"lineBreak":true},{"text":"訓練我的手指打仗。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"祂是我慈愛的上帝，","poem":1},{"lineBreak":true},{"text":"我的堡壘，我的避難所，","poem":1},{"lineBreak":true},{"text":"我的拯救者，我的盾牌，","poem":1},{"lineBreak":true},{"text":"我投靠祂。","poem":1},{"lineBreak":true},{"text":"祂使列國臣服於我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"人算什麼，你竟顧念他？","poem":1},{"lineBreak":true},{"text":"世人算什麼，你竟眷顧他？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因為人不過像一口氣，","poem":1},{"lineBreak":true},{"text":"他的年日不過像影子轉眼消逝。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你打開天門，親自降臨；","poem":1},{"lineBreak":true},{"text":"求你觸摸群山，使群山冒煙。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你發出閃電驅散敵人，","poem":1},{"lineBreak":true},{"text":"求你射出利箭擊潰他們。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你從天上伸手從驚濤駭浪中拯救我，","poem":1},{"lineBreak":true},{"text":"從外族人手中拯救我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們滿口謊言，","poem":1},{"lineBreak":true},{"text":"起誓也心懷詭詐。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"上帝啊，我要向你唱新歌，","poem":1},{"lineBreak":true},{"text":"用十弦琴歌頌你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你使君王得勝，","poem":1},{"lineBreak":true},{"text":"救你的僕人大衛逃離刀劍的殺戮。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你從外族人手中拯救我，","poem":1},{"lineBreak":true},{"text":"他們滿口謊言，","poem":1},{"lineBreak":true},{"text":"起誓也心懷詭詐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"願我們的兒子年輕時像茁壯的樹木，","poem":1},{"lineBreak":true},{"text":"我們的女兒像宮殿中精雕的柱子。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"願我們的倉庫堆滿各樣穀物，","poem":1},{"lineBreak":true},{"text":"我們的羊在田野多多繁衍，","poem":1},{"lineBreak":true},{"text":"成千上萬。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"願我們的牲口馱滿貨物","poem":1},{"noteId":11},{"text":"，","poem":1},{"lineBreak":true},{"text":"我們的城牆堅固，","poem":1},{"lineBreak":true},{"text":"無人被擄，街上沒有哭叫聲。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"生活在這種光景裡的人有福了！","poem":1},{"lineBreak":true},{"text":"尊耶和華為上帝的民有福了！","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"「牲口馱滿貨物」或譯「多多繁殖」。","reference":{"chapter":144,"verse":14}}]},"thisChapterLink":"/api/cmn_cbt/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}