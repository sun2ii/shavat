{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":145,"content":[{"type":"heading","content":["讚美之歌"]},{"type":"hebrew_subtitle","content":["大衛的讚美詩。"]},{"type":"verse","number":1,"content":[{"text":"我的上帝，我的王啊！","poem":1},{"lineBreak":true},{"text":"我要尊崇你，","poem":1},{"lineBreak":true},{"text":"我要永永遠遠稱頌你的名。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要天天稱頌你，","poem":1},{"lineBreak":true},{"text":"永永遠遠讚美你的名。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華是偉大的，","poem":1},{"lineBreak":true},{"text":"當受至高的頌讚，","poem":1},{"lineBreak":true},{"text":"祂的偉大無法測度。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"願世世代代頌讚你的事蹟，","poem":1},{"lineBreak":true},{"text":"傳揚你大能的作為。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我要默想你的榮耀、威嚴和奇妙作為。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"人們要述說你令人敬畏的大能作為，","poem":1},{"lineBreak":true},{"text":"我也要傳揚你的偉大事蹟。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們要傾訴你的厚恩，","poem":1},{"lineBreak":true},{"text":"歌頌你的公義。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和華有恩典、好憐憫，","poem":1},{"lineBreak":true},{"text":"不輕易發怒，充滿慈愛。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華善待眾生，","poem":1},{"lineBreak":true},{"text":"憐憫祂所造的萬物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"你所創造的萬物都要稱謝你，","poem":1},{"lineBreak":true},{"text":"你忠心的子民也要頌揚你。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們要述說你國度的榮耀，","poem":1},{"lineBreak":true},{"text":"講論你的大能，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"好讓世人知道你大能的作為和你國度的威嚴與榮耀。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你的國度永遠長存，","poem":1},{"lineBreak":true},{"text":"你的統治直到萬代。","poem":1},{"lineBreak":true},{"text":"耶和華信守自己的一切應許，","poem":1},{"lineBreak":true},{"text":"祂的作為都充滿慈愛。","poem":1},{"noteId":12}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華扶起跌倒的人，","poem":1},{"lineBreak":true},{"text":"扶持被重擔所壓的人。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"世人都仰望你，","poem":1},{"lineBreak":true},{"text":"你按時賜給他們所需的食物。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你伸手滿足一切生命的需要。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和華的作為公義，","poem":1},{"lineBreak":true},{"text":"祂所行的充滿慈愛。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和華垂顧一切求告祂的人，","poem":1},{"lineBreak":true},{"text":"一切誠心求告祂的人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂使敬畏祂的人心願得償，","poem":1},{"lineBreak":true},{"text":"垂聽他們的呼求，拯救他們。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和華保護所有愛祂的人，","poem":1},{"lineBreak":true},{"text":"毀滅一切惡人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我要開口讚美耶和華，","poem":1},{"lineBreak":true},{"text":"萬物都要稱頌祂的聖名，","poem":1},{"lineBreak":true},{"text":"直到永永遠遠。","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"「耶和華信守……慈愛」許多手抄本無此句。","reference":{"chapter":145,"verse":13}}]},"thisChapterLink":"/api/cmn_cbt/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}