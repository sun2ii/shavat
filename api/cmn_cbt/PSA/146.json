{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":146,"content":[{"type":"heading","content":["讚美上帝的幫助"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"我的心啊，你要讚美耶和華。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要一生讚美耶和華，","poem":1},{"lineBreak":true},{"text":"我一息尚存都要歌頌祂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們不要倚靠權貴，","poem":1},{"lineBreak":true},{"text":"不要倚靠世人，","poem":1},{"lineBreak":true},{"text":"他們救不了你們。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們氣息一斷，便歸回塵土，","poem":1},{"lineBreak":true},{"text":"他們的打算轉眼成空。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"蒙雅各的上帝相助、仰望耶和華上帝的人有福了！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華創造了天地、海洋和其中的萬物，","poem":1},{"lineBreak":true},{"text":"祂永遠信實可靠。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂為受壓制的人伸冤，","poem":1},{"lineBreak":true},{"text":"賜食物給饑餓的人。","poem":1},{"lineBreak":true},{"text":"耶和華使被囚者得自由。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華使瞎眼的人能看見，","poem":1},{"lineBreak":true},{"text":"耶和華扶持被重擔所壓的人，","poem":1},{"lineBreak":true},{"text":"耶和華喜愛義人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華保護寄居異地的人，","poem":1},{"lineBreak":true},{"text":"看顧孤兒寡婦，","poem":1},{"lineBreak":true},{"text":"並挫敗惡人的陰謀詭計。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華永遠掌權。","poem":1},{"lineBreak":true},{"text":"錫安啊，","poem":1},{"lineBreak":true},{"text":"你的上帝要世世代代做王。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}