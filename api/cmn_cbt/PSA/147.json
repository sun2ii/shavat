{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":147,"content":[{"type":"heading","content":["讚美上帝復興耶路撒冷"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"歌頌我們的上帝，真是美好！","poem":1},{"lineBreak":true},{"text":"讚美祂，真是快樂合宜！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華重建耶路撒冷，","poem":1},{"lineBreak":true},{"text":"召集流亡的以色列人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂醫治心靈破碎的人，","poem":1},{"lineBreak":true},{"text":"包紮他們的創傷。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂決定眾星的數目，","poem":1},{"lineBreak":true},{"text":"給它們一一命名。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我們的主偉大無比，充滿力量，","poem":1},{"lineBreak":true},{"text":"祂的智慧沒有窮盡。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華扶持謙卑人，","poem":1},{"lineBreak":true},{"text":"祂使惡人墜入塵埃。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你們要以感恩的心歌頌耶和華，","poem":1},{"lineBreak":true},{"text":"彈琴讚美我們的上帝。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂以雲霞遮蔽天空，","poem":1},{"lineBreak":true},{"text":"降雨水滋潤大地，","poem":1},{"lineBreak":true},{"text":"使山上長出青草。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂賜食物給走獸，","poem":1},{"lineBreak":true},{"text":"餵養嗷嗷待哺的小烏鴉。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華所喜悅的不是強健的馬匹，","poem":1},{"lineBreak":true},{"text":"也不是矯捷的戰士，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"而是敬畏祂、仰望祂慈愛的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶路撒冷啊，要稱頌耶和華；","poem":1},{"lineBreak":true},{"text":"錫安啊，要讚美你的上帝。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因為祂使你的城門堅固，","poem":1},{"lineBreak":true},{"text":"賜福給你的兒女。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂使你四境平安，","poem":1},{"lineBreak":true},{"text":"飽享上好的麥子。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂向大地發出命令，","poem":1},{"lineBreak":true},{"text":"祂的話迅速傳開。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"祂降下羊毛般的白雪，","poem":1},{"lineBreak":true},{"text":"撒下爐灰般的寒霜。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂拋下碎石般的冰雹，","poem":1},{"lineBreak":true},{"text":"誰能經得住祂降下的嚴寒呢？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂一聲令下，冰雪便溶化；","poem":1},{"lineBreak":true},{"text":"祂使微風吹拂，河川奔流。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂將自己的話傳於雅各，","poem":1},{"lineBreak":true},{"text":"將自己的律例和法令指示以色列。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"祂未曾這樣對待其他國家，","poem":1},{"lineBreak":true},{"text":"他們不知道祂的法令。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}