{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":148,"content":[{"type":"heading","content":["萬物當讚美上帝"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"從天上讚美祂，","poem":1},{"lineBreak":true},{"text":"在高天讚美祂！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"眾天使啊，你們要讚美祂！","poem":1},{"lineBreak":true},{"text":"眾天軍啊，你們要讚美祂！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"太陽、月亮啊，你們要讚美祂！","poem":1},{"lineBreak":true},{"text":"閃亮的星辰啊，你們要讚美祂！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"天上的天啊，你們要讚美祂！","poem":1},{"lineBreak":true},{"text":"天上的水啊，你們要讚美祂！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"願這一切都來讚美耶和華的名！","poem":1},{"lineBreak":true},{"text":"因為祂一發命令便創造了萬物。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂使這一切各處其位，永不改變，","poem":1},{"lineBreak":true},{"text":"祂頒布的律例永不廢棄。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"要在世上讚美耶和華，","poem":1},{"lineBreak":true},{"text":"海中的巨獸和深淵啊，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"火焰、冰雹、雪花、雲霞和聽祂吩咐的狂風啊，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"高山、丘陵、果樹和香柏樹啊，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"野獸、牲畜、爬蟲和飛鳥啊，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"世上的君王、萬國、首領和審判官啊，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"少男、少女、老人和孩童啊，","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"願他們都讚美耶和華，","poem":1},{"lineBreak":true},{"text":"因為唯有祂的名當受尊崇，","poem":1},{"lineBreak":true},{"text":"祂的榮耀在天地之上。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂使祂子民的角高舉，","poem":1},{"lineBreak":true},{"text":"叫祂忠心的子民，","poem":1},{"lineBreak":true},{"text":"祂心愛的以色列人得到尊榮。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}