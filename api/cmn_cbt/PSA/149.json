{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":149,"content":[{"type":"heading","content":["以色列要讚美上帝"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"要向耶和華唱新歌，","poem":1},{"lineBreak":true},{"text":"在祂忠心子民的聚會中頌讚祂！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願以色列因他的造物主而歡喜，","poem":1},{"lineBreak":true},{"text":"願錫安的百姓因他們的君王而快樂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"願他們跳舞讚美祂的名，","poem":1},{"lineBreak":true},{"text":"擊鼓彈琴歌頌祂。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因為耶和華喜愛祂的子民，","poem":1},{"lineBreak":true},{"text":"祂賜尊榮給謙卑的人，","poem":1},{"lineBreak":true},{"text":"使他們得勝。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"願祂忠心的子民在榮耀中歡樂，","poem":1},{"lineBreak":true},{"text":"願他們躺臥在床上的時候也歡唱。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"願他們高聲頌讚耶和華，","poem":1},{"lineBreak":true},{"text":"手握兩刃利劍向列國復仇，","poem":1},{"lineBreak":true},{"text":"在列邦中施行懲罰，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"用鐵鏈捆綁他們的君王，","poem":1},{"lineBreak":true},{"text":"用鐵銬鎖住他們的首領，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"按他們的罪狀審判他們。","poem":1},{"lineBreak":true},{"text":"這就是祂忠心的子民所得的榮耀。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":8}