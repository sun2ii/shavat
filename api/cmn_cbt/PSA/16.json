{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":16,"content":[{"type":"heading","content":["信靠之福"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊！我投靠你，","poem":1},{"lineBreak":true},{"text":"求你保護我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我對耶和華說：「你是我的主，","poem":1},{"lineBreak":true},{"text":"我的福祉都從你而來。」","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"世上的聖民極其尊貴，","poem":1},{"lineBreak":true},{"text":"是我所喜愛的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"追隨其他神明的人，其愁苦必有增無減。","poem":1},{"lineBreak":true},{"text":"我必不向他們的假神澆奠血祭，","poem":1},{"lineBreak":true},{"text":"口中也不提假神的名號。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華啊，你是我的一切，","poem":1},{"lineBreak":true},{"text":"你是我的福分，","poem":1},{"lineBreak":true},{"text":"你掌管我的一切。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你用準繩量給我佳美之地，","poem":1},{"lineBreak":true},{"text":"我的產業何其美！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我要稱頌那訓導我的耶和華，","poem":1},{"lineBreak":true},{"text":"我的良心也在夜間提醒我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我常以耶和華為念，","poem":1},{"lineBreak":true},{"text":"祂在我右邊，我必不動搖。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因此，我的心歡喜，","poem":1},{"lineBreak":true},{"text":"我的靈快樂，","poem":1},{"lineBreak":true},{"text":"我的身體也安然無恙。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因為你不會把我的靈魂撇在陰間，","poem":1},{"lineBreak":true},{"text":"也不會讓你的聖者身體朽壞。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你把生命之路指示我，","poem":1},{"lineBreak":true},{"text":"你右手有永遠的福樂，","poem":1},{"lineBreak":true},{"text":"我在你面前充滿喜樂。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}