{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":17,"content":[{"type":"heading","content":["無辜者的祈禱"]},{"type":"hebrew_subtitle","content":["大衛的祈禱。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你聽我祈求公義的聲音，","poem":1},{"lineBreak":true},{"text":"側耳聽我的呼求，","poem":1},{"lineBreak":true},{"text":"垂聽我真誠的禱告。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願你宣判我無罪，","poem":1},{"lineBreak":true},{"text":"願你明察是非。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你試驗過我的心思，","poem":1},{"lineBreak":true},{"text":"夜間鑒察過我，磨煉過我，","poem":1},{"lineBreak":true},{"text":"找不出任何過犯；","poem":1},{"lineBreak":true},{"text":"我立志口不犯罪。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我遵守你的教導，潔身自守，","poem":1},{"lineBreak":true},{"text":"不與殘暴之徒同流。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我堅定地走你的道路，","poem":1},{"lineBreak":true},{"text":"腳步從未偏離。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"上帝啊！我向你求告，","poem":1},{"lineBreak":true},{"text":"因為你必應允我。","poem":1},{"lineBreak":true},{"text":"求你側耳聽我的禱告。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你彰顯你奇妙的慈愛，","poem":1},{"lineBreak":true},{"text":"用右手拯救投靠你的人脫離仇敵。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你保護我，像保護眼中的瞳人，","poem":1},{"lineBreak":true},{"text":"用你的翅膀蔭庇我，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"救我脫離惡人的攻擊，","poem":1},{"lineBreak":true},{"text":"脫離四圍殺氣騰騰的仇敵。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們良心喪盡，口出狂言。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們窮追圍堵，","poem":1},{"lineBreak":true},{"text":"伺機把我打倒在地。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們像急於撕碎獵物的餓獅，","poem":1},{"lineBreak":true},{"text":"又像蹲伏在暗處的猛獅。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你起來迎頭擊倒他們，","poem":1},{"lineBreak":true},{"text":"求你持刀救我脫離惡人。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你伸手救我脫離這些人，","poem":1},{"lineBreak":true},{"text":"脫離這些只在今生有福分的世人。","poem":1},{"lineBreak":true},{"text":"你使他們財寶無數。","poem":1},{"lineBreak":true},{"text":"他們兒女眾多，","poem":1},{"lineBreak":true},{"text":"還把財富留給子孫。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"但我必因公義而得見你的面；","poem":1},{"lineBreak":true},{"text":"我醒來見到你的真容就心滿意足了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}