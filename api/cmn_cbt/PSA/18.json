{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":18,"content":[{"type":"heading","content":["大衛的勝利之歌"]},{"type":"hebrew_subtitle","content":["耶和華的僕人大衛的詩，交給樂長。耶和華從掃羅及所有仇敵手中拯救大衛那天，他向耶和華吟唱此詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，你是我的力量，","poem":1},{"lineBreak":true},{"text":"我愛你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華是我的磐石，我的堡壘，","poem":1},{"lineBreak":true},{"text":"我的拯救者；","poem":1},{"lineBreak":true},{"text":"我的上帝是庇護我的磐石，","poem":1},{"lineBreak":true},{"text":"我的盾牌，","poem":1},{"lineBreak":true},{"text":"是拯救我的力量，我的堅壘。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我求告當受頌讚的耶和華，","poem":1},{"lineBreak":true},{"text":"祂便救我脫離仇敵。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"死亡的鎖鏈纏住我，","poem":1},{"lineBreak":true},{"text":"毀滅的狂流淹沒我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"陰間的繩索捆綁我，","poem":1},{"lineBreak":true},{"text":"死亡的網羅籠罩我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我在苦難中呼求耶和華，","poem":1},{"lineBreak":true},{"text":"向我的上帝求助。","poem":1},{"lineBreak":true},{"text":"祂從殿中垂聽我的呼求，","poem":1},{"lineBreak":true},{"text":"我的聲音達到祂耳中。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂一發怒，大地震動顫抖，","poem":1},{"lineBreak":true},{"text":"山的根基搖晃。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂的鼻孔冒煙，","poem":1},{"lineBreak":true},{"text":"口噴烈焰和火炭。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂使穹蒼低垂，親自降臨，","poem":1},{"lineBreak":true},{"text":"腳下踩著密雲。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂乘著基路伯天使飛翔，","poem":1},{"lineBreak":true},{"text":"乘著風的翅膀疾馳。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂藏身於黑暗中，","poem":1},{"lineBreak":true},{"text":"四圍以密雲作幔幕。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"從祂面前的榮光中，","poem":1},{"lineBreak":true},{"text":"冰雹和火炭衝破雲層。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華在天上打雷，","poem":1},{"lineBreak":true},{"text":"至高者發出的聲音響徹在冰雹和火炭中。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂射出利箭驅散仇敵，","poem":1},{"lineBreak":true},{"text":"發出閃電擊潰他們。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和華啊，你一聲斥責，","poem":1},{"lineBreak":true},{"text":"鼻孔一吹氣，海底就顯現，","poem":1},{"lineBreak":true},{"text":"大地也露出根基。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"祂從高天伸手抓住我，","poem":1},{"lineBreak":true},{"text":"從大水中把我拉上來。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"祂救我脫離強敵，","poem":1},{"lineBreak":true},{"text":"脫離我無法戰勝的仇敵。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他們在我危難之時攻擊我，","poem":1},{"lineBreak":true},{"text":"但耶和華扶持我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂領我到寬闊之地，","poem":1},{"lineBreak":true},{"text":"祂搭救我，因為祂喜悅我。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和華按我的公義善待我，","poem":1},{"lineBreak":true},{"text":"按我的清白賞賜我，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"因為我遵行祂的道，","poem":1},{"lineBreak":true},{"text":"沒有作惡背棄我的上帝。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我遵守祂的一切法令，","poem":1},{"lineBreak":true},{"text":"沒有把祂的律例棄置一旁。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我在祂面前純全無過，","poem":1},{"lineBreak":true},{"text":"沒有沾染罪惡。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"耶和華按我的公義、","poem":1},{"lineBreak":true},{"text":"照我在祂面前的清白獎賞我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"仁慈的人，你以仁慈待他；","poem":1},{"lineBreak":true},{"text":"純全的人，你以純全待他；","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"純潔的人，你以純潔待他；","poem":1},{"lineBreak":true},{"text":"乖謬的人，你以計謀待他。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你拯救謙卑的人，","poem":1},{"lineBreak":true},{"text":"貶抑眼目高傲的人。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我的上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"你點亮我的燈，","poem":1},{"lineBreak":true},{"text":"你使我的黑暗變為光明。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我靠著你迎戰敵軍，","poem":1},{"lineBreak":true},{"text":"靠著我的上帝躍過牆垣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"上帝的道完美，","poem":1},{"lineBreak":true},{"text":"耶和華的話純全，","poem":1},{"lineBreak":true},{"text":"祂是一切投靠祂之人的盾牌。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"除了耶和華，誰是上帝呢？","poem":1},{"lineBreak":true},{"text":"除了我們的上帝，誰是磐石呢？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"上帝賜我力量，","poem":1},{"lineBreak":true},{"text":"使我行為純全。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"祂使我的腳如母鹿的蹄，","poem":1},{"lineBreak":true},{"text":"穩踏在高處。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"祂訓練我的手如何爭戰，","poem":1},{"lineBreak":true},{"text":"使我的臂膀能拉開銅弓。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"耶和華啊，你是拯救我的盾牌，","poem":1},{"lineBreak":true},{"text":"你的右手扶持我，","poem":1},{"lineBreak":true},{"text":"你的垂顧使我強大。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"你使我腳下的道路寬闊，","poem":1},{"lineBreak":true},{"text":"使我不致滑倒。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"我追趕仇敵直到追上，","poem":1},{"lineBreak":true},{"text":"不消滅他們決不回頭。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"我打垮他們，","poem":1},{"lineBreak":true},{"text":"使他們倒在我的腳下，","poem":1},{"lineBreak":true},{"text":"再也站不起來。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"你賜我征戰的能力，","poem":1},{"lineBreak":true},{"text":"使我的仇敵降服在我腳下。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"你使我的仇敵敗逃，","poem":1},{"lineBreak":true},{"text":"我殲滅了恨我的人。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"他們呼救，卻無人拯救；","poem":1},{"lineBreak":true},{"text":"他們呼求耶和華，祂也不應允。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"我把他們打得粉碎，","poem":1},{"lineBreak":true},{"text":"如同風中的灰塵；","poem":1},{"lineBreak":true},{"text":"我把他們倒掉，","poem":1},{"lineBreak":true},{"text":"如同街上的泥土。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"你救我脫離我百姓的攻擊，","poem":1},{"lineBreak":true},{"text":"立我做列國的元首。","poem":1},{"lineBreak":true},{"text":"素不相識的民族也服侍我。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"外族人望風而降，","poem":1},{"lineBreak":true},{"text":"對我俯首稱臣。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"他們聞風喪膽，","poem":1},{"lineBreak":true},{"text":"戰戰兢兢地走出他們的城池。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"耶和華永遠活著，","poem":1},{"lineBreak":true},{"text":"我的磐石當受頌讚，","poem":1},{"lineBreak":true},{"text":"拯救我的上帝當受尊崇。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"祂是為我伸冤的上帝，","poem":1},{"lineBreak":true},{"text":"祂使列邦臣服於我。","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"祂救我脫離仇敵，","poem":1},{"lineBreak":true},{"text":"使我勝過強敵，","poem":1},{"lineBreak":true},{"text":"救我脫離殘暴之徒。","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"因此，耶和華啊，","poem":1},{"lineBreak":true},{"text":"我要在列邦中讚美你，","poem":1},{"lineBreak":true},{"text":"歌頌你的名。","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"耶和華使祂立的王大獲全勝，","poem":1},{"lineBreak":true},{"text":"向祂膏立的大衛及其後代廣施慈愛，直到永遠。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}