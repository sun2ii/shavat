{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":19,"content":[{"type":"heading","content":["上帝的作為和律法"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"諸天述說上帝的榮耀，","poem":1},{"lineBreak":true},{"text":"穹蒼傳揚祂手的作為。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"它們日復一日地訴說，","poem":1},{"lineBreak":true},{"text":"夜復一夜地宣揚知識，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"無言無語，無聲無息。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"它們的聲音傳遍天下，","poem":1},{"lineBreak":true},{"text":"它們的話語傳到地極。","poem":1},{"lineBreak":true},{"text":"上帝在天上為太陽設立居所。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"太陽出來時，如步出洞房的新郎，","poem":1},{"lineBreak":true},{"text":"又如歡然奔跑賽程的健兒。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"它從天這邊升起，","poem":1},{"lineBreak":true},{"text":"滑過長空，繞到天那邊，","poem":1},{"lineBreak":true},{"text":"熱量廣及萬物。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華的律法完美，","poem":1},{"lineBreak":true},{"text":"能更新生命；","poem":1},{"lineBreak":true},{"text":"耶和華的法度可靠，","poem":1},{"lineBreak":true},{"text":"讓愚人有智慧。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華的法則公正，","poem":1},{"lineBreak":true},{"text":"使人心裡喜樂；","poem":1},{"lineBreak":true},{"text":"耶和華的命令純全，","poem":1},{"lineBreak":true},{"text":"讓人眼目明亮。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華受的敬畏純潔，","poem":1},{"lineBreak":true},{"text":"存到永遠；","poem":1},{"lineBreak":true},{"text":"耶和華的法令可靠，","poem":1},{"lineBreak":true},{"text":"全然公義。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"這些比金子，比許多純金還寶貴，","poem":1},{"lineBreak":true},{"text":"比蜂蜜，比蜂房滴下的純蜜更甘甜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你僕人從中受到警戒，","poem":1},{"lineBreak":true},{"text":"遵守的人必得大賞賜。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"誰能知道自己的過失呢？","poem":1},{"lineBreak":true},{"text":"求你赦免我隱藏的過錯。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"求你阻止僕人犯任意妄為之罪，","poem":1},{"lineBreak":true},{"text":"不讓罪惡轄制我。","poem":1},{"lineBreak":true},{"text":"這樣，我才純全正直，","poem":1},{"lineBreak":true},{"text":"免犯大過。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華，我的磐石、我的救贖主啊，","poem":1},{"lineBreak":true},{"text":"願你喜悅我口中的言語、心中的意念。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}