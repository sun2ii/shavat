{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":2,"content":[{"type":"heading","content":["上帝膏立的君王"]},{"type":"verse","number":1,"content":[{"text":"列國為何騷動不安？","poem":1},{"lineBreak":true},{"text":"萬民為何枉費心機？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"世上的君王一同行動，","poem":1},{"lineBreak":true},{"text":"官長聚集商議，","poem":1},{"lineBreak":true},{"text":"要抵擋耶和華和祂所膏立的王。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們說：","poem":1},{"lineBreak":true},{"text":"「讓我們掙斷他們的鎖鏈，","poem":1},{"lineBreak":true},{"text":"擺脫他們的捆索！」","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"坐在天上寶座上的主必笑他們，","poem":1},{"lineBreak":true},{"text":"祂必嘲笑他們。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"那時，祂必怒斥他們，","poem":1},{"lineBreak":true},{"text":"發烈怒驚嚇他們。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂說：","poem":1},{"lineBreak":true},{"text":"「在我的錫安聖山上，","poem":1},{"lineBreak":true},{"text":"我已立了我的君王。」","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"那位君王說：","poem":1},{"lineBreak":true},{"text":"「我要宣告耶和華的旨意，","poem":1},{"lineBreak":true},{"text":"祂對我說，『你是我的兒子，","poem":1},{"lineBreak":true},{"text":"我今日成為你父親。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你向我祈求，我必把列國賜給你作產業，","poem":1},{"lineBreak":true},{"text":"讓天下都歸你所有。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你要用鐵杖擊垮他們，","poem":1},{"lineBreak":true},{"text":"像打碎陶器般打碎他們。』」","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"所以君王啊，要慎思明辨！","poem":1},{"lineBreak":true},{"text":"世上的統治者啊，要接受勸誡！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"要懷著敬畏事奉耶和華，","poem":1},{"lineBreak":true},{"text":"要喜樂也要戰戰兢兢。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"要降服在祂兒子面前，","poem":1},{"lineBreak":true},{"text":"免得祂發怒，","poem":1},{"lineBreak":true},{"text":"你們便在途中滅亡，","poem":1},{"lineBreak":true},{"text":"因為祂的怒氣將臨。","poem":1},{"lineBreak":true},{"text":"投靠祂的人有福了！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}