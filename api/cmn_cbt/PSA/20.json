{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":20,"content":[{"type":"heading","content":["祈求勝利"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"願耶和華應允你患難時的呼求。","poem":1},{"lineBreak":true},{"text":"願雅各之上帝的名保護你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願祂從聖所幫助你，","poem":1},{"lineBreak":true},{"text":"從錫安山扶持你。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"願祂顧念你獻的一切祭物，","poem":1},{"lineBreak":true},{"text":"悅納你的燔祭。（細拉）","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"願祂使你心願得償、","poem":1},{"lineBreak":true},{"text":"所有計劃都實現。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我們要因你得勝而高聲歡唱，","poem":1},{"lineBreak":true},{"text":"奉耶和華的名豎起旌旗。","poem":1},{"lineBreak":true},{"text":"願耶和華應允你一切的祈求。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"現在我知道耶和華拯救祂膏立的王，","poem":1},{"lineBreak":true},{"text":"祂從聖天之上應允他，","poem":1},{"lineBreak":true},{"text":"用右手的大能拯救他。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"有人靠戰車，有人靠戰馬，","poem":1},{"lineBreak":true},{"text":"但我們靠的是我們的上帝耶和華的名。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們都一敗塗地，","poem":1},{"lineBreak":true},{"text":"我們卻屹立不倒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華啊，求你拯救你立的王。","poem":1},{"lineBreak":true},{"text":"我們呼求的時候，","poem":1},{"lineBreak":true},{"text":"求你垂聽。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}