{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":21,"content":[{"type":"heading","content":["頌讚勝利"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"君王因你的能力而歡欣，","poem":1},{"lineBreak":true},{"text":"因你的拯救而雀躍。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你滿足了他的心願，","poem":1},{"lineBreak":true},{"text":"未曾拒絕他的請求。（細拉）","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你賜給他豐盛的祝福，","poem":1},{"lineBreak":true},{"text":"給他戴上純金的冠冕。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他向你祈求長壽，","poem":1},{"lineBreak":true},{"text":"你就賜給他永生。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的救助帶給他無上榮耀，","poem":1},{"lineBreak":true},{"text":"你賜給他尊榮和威嚴。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你給他的祝福永無窮盡，","poem":1},{"lineBreak":true},{"text":"你的同在使他充滿喜樂。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"君王信靠耶和華，","poem":1},{"lineBreak":true},{"text":"靠著至高者的慈愛必不動搖。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"你的手必尋索你的一切敵人，","poem":1},{"lineBreak":true},{"text":"你用右手搜出那些恨你的人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你一出現，","poem":1},{"lineBreak":true},{"text":"他們便像身在火爐中，","poem":1},{"lineBreak":true},{"text":"你發烈怒吞滅他們，","poem":1},{"lineBreak":true},{"text":"你的烈火燒滅他們。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你必從世上剷除他們的子孫，","poem":1},{"lineBreak":true},{"text":"從人間滅絕他們的後裔。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們雖然用陰謀詭計對抗你，","poem":1},{"lineBreak":true},{"text":"卻不能成功。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你必彎弓搭箭瞄準他們的臉，","poem":1},{"lineBreak":true},{"text":"使他們掉頭逃跑。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華啊，願你彰顯大能，受人尊崇！","poem":1},{"lineBreak":true},{"text":"我們要歌頌、讚美你的權能。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}