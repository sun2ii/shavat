{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":22,"content":[{"type":"heading","content":["苦難中的呼求和感恩"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長，調用「朝鹿」。"]},{"type":"verse","number":1,"content":[{"text":"我的上帝，我的上帝，","poem":1},{"lineBreak":true},{"text":"你為什麼離棄我？","poem":1},{"lineBreak":true},{"text":"為何遠遠地不來救我，","poem":1},{"lineBreak":true},{"text":"不聽我的哀號呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"我白天呼求，你不回應；","poem":1},{"lineBreak":true},{"text":"我夜間呼求，仍無安寧。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"然而，你是聖潔的，","poem":1},{"lineBreak":true},{"text":"你的寶座設立在以色列人的頌讚之上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我們的祖先信靠你，","poem":1},{"lineBreak":true},{"text":"他們信靠你，","poem":1},{"lineBreak":true},{"text":"你就解救他們。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們向你呼求，","poem":1},{"lineBreak":true},{"text":"就得到拯救；","poem":1},{"lineBreak":true},{"text":"他們信靠你，","poem":1},{"lineBreak":true},{"text":"就不會蒙羞。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"但我只是一條蟲，而非人，","poem":1},{"lineBreak":true},{"text":"受盡羞辱和藐視。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"看見我的人都譏笑我，","poem":1},{"lineBreak":true},{"text":"他們撇著嘴、搖著頭說：","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"「他信靠耶和華，","poem":1},{"lineBreak":true},{"text":"讓耶和華救他吧！","poem":1},{"lineBreak":true},{"text":"既然耶和華喜悅他，","poem":1},{"lineBreak":true},{"text":"讓耶和華拯救他吧！」","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"但耶和華啊，","poem":1},{"lineBreak":true},{"text":"是你使我從母腹中出生，","poem":1},{"lineBreak":true},{"text":"讓我在母親懷裡便倚靠你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我一出生就被交托給你，","poem":1},{"lineBreak":true},{"text":"你從我出母胎就是我的上帝。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你不要遠離我，","poem":1},{"lineBreak":true},{"text":"因為危難當頭，無人幫我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我被許多仇敵圍困，","poem":1},{"lineBreak":true},{"text":"他們像巴珊的公牛那樣強壯。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他們張口要吞噬我，","poem":1},{"lineBreak":true},{"text":"如同吼叫著撕食獵物的獅子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"我的力量如水消逝，","poem":1},{"lineBreak":true},{"text":"我的骨頭都脫了節，","poem":1},{"lineBreak":true},{"text":"我的心如蠟熔化。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的力量枯竭如焦土，","poem":1},{"lineBreak":true},{"text":"我的舌頭緊貼上顎。","poem":1},{"lineBreak":true},{"text":"你把我放在死亡的塵土中。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"惡人包圍我，猶如一群惡犬，","poem":1},{"lineBreak":true},{"text":"他們刺傷我的手腳。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我身上的骨頭歷歷可見，","poem":1},{"lineBreak":true},{"text":"人們都幸災樂禍地盯著我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他們分我的外衣，","poem":1},{"lineBreak":true},{"text":"又為我的內衣抽籤。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和華啊，求你不要遠離我。","poem":1},{"lineBreak":true},{"text":"你是我的力量，","poem":1},{"lineBreak":true},{"text":"求你快來幫助我。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"求你救我逃脫刀劍之災，","poem":1},{"lineBreak":true},{"text":"從這些惡犬的利爪下拯救我的生命。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"求你救我脫離獅子的口，","poem":1},{"lineBreak":true},{"text":"使我脫離野牛的角。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"我要向眾弟兄傳揚你的名，","poem":1},{"lineBreak":true},{"text":"在會眾當中讚美你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"敬畏耶和華的人啊，要讚美祂！","poem":1},{"lineBreak":true},{"text":"所有雅各的後裔啊，要尊崇祂，","poem":1},{"lineBreak":true},{"text":"所有以色列的後裔啊，要敬畏祂。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"因為祂沒有藐視、厭惡苦難中的人，","poem":1},{"lineBreak":true},{"text":"也沒有掩面不顧他們，","poem":1},{"lineBreak":true},{"text":"而是垂聽他們的呼求。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"我要在大會中讚美你，","poem":1},{"lineBreak":true},{"text":"在敬畏你的人面前履行我的誓言。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"窮苦人必吃得飽足，","poem":1},{"lineBreak":true},{"text":"尋求耶和華的人必讚美祂，","poem":1},{"lineBreak":true},{"text":"他們的心要永遠歡欣。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"普世都要心繫耶和華，歸向祂，","poem":1},{"lineBreak":true},{"text":"各國人民都要敬拜祂。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"因為耶和華是主宰，","poem":1},{"lineBreak":true},{"text":"祂統治列國。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"世上的富貴人要歡宴敬拜祂，","poem":1},{"lineBreak":true},{"text":"必歸塵土、無法長活的世人都要跪拜祂。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"世世代代的人都要事奉祂，","poem":1},{"lineBreak":true},{"text":"向後人傳揚主所行的奇事。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他們要向將來的人傳講祂的公義作為。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}