{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":24,"content":[{"type":"heading","content":["榮耀的君王"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"大地和其中的萬物都屬於耶和華，","poem":1},{"lineBreak":true},{"text":"世界和世上的一切都是祂的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"祂把大地奠基於海中，","poem":1},{"lineBreak":true},{"text":"建立在大水之上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"誰能登耶和華的山？","poem":1},{"lineBreak":true},{"text":"誰能站在祂的聖所中？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"只有那些手潔心清，","poem":1},{"lineBreak":true},{"text":"不拜假神，不起假誓的人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們必蒙耶和華賜福，","poem":1},{"lineBreak":true},{"text":"被救他們的上帝稱為義人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"這就是尋求耶和華的人，","poem":1},{"lineBreak":true},{"text":"他們敬拜雅各的上帝。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"眾城門啊，抬起頭來！","poem":1},{"lineBreak":true},{"text":"古老的城門啊，抬起來吧！","poem":1},{"lineBreak":true},{"text":"好讓榮耀的君王進來。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"誰是榮耀的君王呢？是強大無比的耶和華，","poem":1},{"lineBreak":true},{"text":"是戰無不勝的耶和華。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"眾城門啊，抬起頭來！","poem":1},{"lineBreak":true},{"text":"古老的城門啊，抬起來吧！","poem":1},{"lineBreak":true},{"text":"好讓榮耀的君王進來。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"誰是榮耀的君王呢？","poem":1},{"lineBreak":true},{"text":"萬軍之耶和華是榮耀的君王。（細拉）","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}