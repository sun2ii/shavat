{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":25,"content":[{"type":"heading","content":["祈求引導和赦免"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我的心仰望你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的上帝啊，我信靠你，","poem":1},{"lineBreak":true},{"text":"求你不要叫我蒙羞，","poem":1},{"lineBreak":true},{"text":"不要讓我的仇敵向我誇勝。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"等候你的必不羞愧，","poem":1},{"lineBreak":true},{"text":"背信棄義者必蒙羞。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你指引我走你的路，","poem":1},{"lineBreak":true},{"text":"教導我行你的道。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"求你以你的真理引領我，","poem":1},{"lineBreak":true},{"text":"教導我，因為你是拯救我的上帝，","poem":1},{"lineBreak":true},{"text":"我終日等候你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你顧念你亙古以來常施的憐憫和慈愛，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你饒恕我年輕時的罪惡和過犯。","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你以你的恩惠和慈愛待我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華良善公正，","poem":1},{"lineBreak":true},{"text":"祂教導罪人走正路。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂指引謙卑人追求公義，","poem":1},{"lineBreak":true},{"text":"教導他們行祂的道。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"遵守祂的約和法度的人，","poem":1},{"lineBreak":true},{"text":"耶和華總以慈愛和信實相待。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華啊，我罪惡深重，","poem":1},{"lineBreak":true},{"text":"求你為了自己的名而赦免我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"凡敬畏耶和華的人，","poem":1},{"lineBreak":true},{"text":"耶和華必指示他當走的路。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他必享福，","poem":1},{"lineBreak":true},{"text":"他的後代必承受土地。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華與敬畏祂的人為友，","poem":1},{"lineBreak":true},{"text":"使他們認識祂的約。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我常常仰望耶和華，","poem":1},{"lineBreak":true},{"text":"因為唯有祂能使我的腳脫離網羅。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和華啊，我孤苦零丁，","poem":1},{"lineBreak":true},{"text":"求你眷顧我，恩待我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我心中充滿愁煩，","poem":1},{"lineBreak":true},{"text":"求你救我脫離患難。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你體恤我的憂傷和痛苦，","poem":1},{"lineBreak":true},{"text":"赦免我一切的罪。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你看我的仇敵何其多，","poem":1},{"lineBreak":true},{"text":"他們都痛恨我。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"求你保護、搭救我的性命，","poem":1},{"lineBreak":true},{"text":"別讓我蒙羞，因為我投靠你。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"求你以純全和正直護衛我，","poem":1},{"lineBreak":true},{"text":"因為我等候你。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"求你救贖以色列脫離一切困境。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}