{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":26,"content":[{"type":"heading","content":["義人的祈求"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你為我主持公道，","poem":1},{"lineBreak":true},{"text":"因為我行為純全，","poem":1},{"lineBreak":true},{"text":"毫不動搖地信靠你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華啊，求你察驗我，","poem":1},{"lineBreak":true},{"text":"試煉我，鑒察我的心思意念。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為我銘記你的慈愛，","poem":1},{"lineBreak":true},{"text":"我行在你的真理中。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我沒有與詭詐者為伍，","poem":1},{"lineBreak":true},{"text":"沒有跟虛偽之人同流。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我憎恨惡徒群聚，","poem":1},{"lineBreak":true},{"text":"不會與惡人交往。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華啊，我洗手表明清白，","poem":1},{"lineBreak":true},{"text":"再走近你的祭壇，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"要高唱感恩之歌，","poem":1},{"lineBreak":true},{"text":"述說你的一切奇妙作為。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華啊，我愛你居住的殿，","poem":1},{"lineBreak":true},{"text":"你榮耀充滿的地方。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"別把我的靈魂和罪人同毀，","poem":1},{"lineBreak":true},{"text":"別把我的性命與嗜血之徒同滅。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們滿腹奸計，大肆收受賄賂。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"但我行為純全，","poem":1},{"lineBreak":true},{"text":"求你救贖我，憐憫我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我站在平坦之地，","poem":1},{"lineBreak":true},{"text":"我要在會眾中讚美耶和華。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}