{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":28,"content":[{"type":"heading","content":["祈求上帝幫助"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我呼求你；","poem":1},{"lineBreak":true},{"text":"我的磐石啊，別不理我。","poem":1},{"lineBreak":true},{"text":"你若默然不語，","poem":1},{"lineBreak":true},{"text":"我必如下墳墓的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我向你呼求，","poem":1},{"lineBreak":true},{"text":"向你的至聖所舉手禱告時，","poem":1},{"lineBreak":true},{"text":"求你垂聽我的祈求。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"求你不要把我與邪惡之徒同滅，","poem":1},{"lineBreak":true},{"text":"他們對鄰居口蜜腹劍。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"求你使他們罪有應得，","poem":1},{"lineBreak":true},{"text":"按他們手上的罪惡報應他們，","poem":1},{"lineBreak":true},{"text":"按他們的惡行報應他們。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們既然毫不在意耶和華的事蹟和作為，","poem":1},{"lineBreak":true},{"text":"祂必毀滅他們，","poem":1},{"lineBreak":true},{"text":"不再復興他們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和華當受稱頌！","poem":1},{"lineBreak":true},{"text":"因為祂聽了我的懇求。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂是我的力量，我的盾牌，","poem":1},{"lineBreak":true},{"text":"我信靠祂，就得幫助。","poem":1},{"lineBreak":true},{"text":"我的心歡喜雀躍，","poem":1},{"lineBreak":true},{"text":"我要歌唱讚美祂。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華是祂子民的力量，","poem":1},{"lineBreak":true},{"text":"是祂膏立之人得救的堡壘。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你拯救你的子民，賜福給你的產業，","poem":1},{"lineBreak":true},{"text":"永遠牧養他們，扶持他們。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}