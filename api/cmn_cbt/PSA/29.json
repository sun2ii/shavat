{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":29,"content":[{"type":"heading","content":["上帝威嚴的聲音"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝的眾子啊，","poem":1},{"lineBreak":true},{"text":"要讚美耶和華，","poem":1},{"lineBreak":true},{"text":"讚美耶和華的榮耀和能力，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要讚美耶和華榮耀的名，","poem":1},{"lineBreak":true},{"text":"穿上聖潔的衣服敬拜祂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華的聲音迴盪在水上，","poem":1},{"lineBreak":true},{"text":"榮耀的上帝打雷，","poem":1},{"lineBreak":true},{"text":"耶和華在洪濤之上打雷。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華的聲音充滿能力；","poem":1},{"lineBreak":true},{"text":"耶和華的聲音充滿威嚴。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華的聲音震斷香柏樹，","poem":1},{"lineBreak":true},{"text":"耶和華劈碎黎巴嫩的香柏樹，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"使黎巴嫩山跳躍如小牛，","poem":1},{"lineBreak":true},{"text":"西連山跳躍如野牛。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華的聲音攜閃電而來。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華的聲音震動曠野，","poem":1},{"lineBreak":true},{"text":"耶和華震動加低斯的曠野。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華的聲音擊倒橡樹","poem":1},{"noteId":2},{"text":"，","poem":1},{"lineBreak":true},{"text":"使樹木凋零。","poem":1},{"lineBreak":true},{"text":"眾人在祂殿中高呼：","poem":1},{"lineBreak":true},{"text":"「榮耀！」","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華坐在洪濤之上，","poem":1},{"lineBreak":true},{"text":"耶和華永遠坐著為王。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華賜力量給自己的子民，","poem":1},{"lineBreak":true},{"text":"耶和華賜給他們平安的福樂。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"「擊倒橡樹」或譯「使母鹿生產」。","reference":{"chapter":29,"verse":9}}]},"thisChapterLink":"/api/cmn_cbt/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}