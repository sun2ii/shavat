{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":3,"content":[{"type":"heading","content":["求助的早禱"]},{"type":"hebrew_subtitle","content":["大衛逃避兒子押沙龍時作的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我的敵人何其多！","poem":1},{"lineBreak":true},{"text":"眾人群起攻擊我！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"眾人都說上帝不會來救我。（細拉）","poem":1},{"noteId":0}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"可是，耶和華啊！","poem":1},{"lineBreak":true},{"text":"你是四面保護我的盾牌，","poem":1},{"lineBreak":true},{"text":"是我的榮耀，你使我昂首而立。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我向耶和華呼求，","poem":1},{"lineBreak":true},{"text":"祂就從祂的聖山上回應我。（細拉）","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我躺下，我睡覺，我醒來，","poem":1},{"lineBreak":true},{"text":"都蒙耶和華護佑。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我雖被千萬仇敵圍困，","poem":1},{"lineBreak":true},{"text":"也不會懼怕。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華啊，求你起來！","poem":1},{"lineBreak":true},{"text":"我的上帝啊，求你救我！","poem":1},{"lineBreak":true},{"text":"求你摑我一切仇敵的臉，","poem":1},{"lineBreak":true},{"text":"打碎惡人的牙齒。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"救恩來自耶和華。","poem":1},{"lineBreak":true},{"text":"願你賜福你的子民！（細拉）","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"「細拉」語意不明，常在詩篇中出現，可能是一種音樂術語。","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/cmn_cbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}