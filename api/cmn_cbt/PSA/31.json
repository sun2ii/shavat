{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":31,"content":[{"type":"heading","content":["信靠上帝的禱告"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我投靠你，","poem":1},{"lineBreak":true},{"text":"求你讓我永不蒙羞；","poem":1},{"lineBreak":true},{"text":"求你憑公義搭救我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你側耳聽我的呼求，","poem":1},{"lineBreak":true},{"text":"快來救我，作我避難的磐石，","poem":1},{"lineBreak":true},{"text":"作拯救我的堡壘。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為你是我的磐石，我的堡壘，","poem":1},{"lineBreak":true},{"text":"求你為了自己的名而引導我，","poem":1},{"lineBreak":true},{"text":"帶領我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你是我的避難所，","poem":1},{"lineBreak":true},{"text":"求你救我脫離人們為我設下的陷阱。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我將我的靈魂交在你手中。","poem":1},{"lineBreak":true},{"text":"信實的上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"你必救贖我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我憎恨拜假神的人，","poem":1},{"lineBreak":true},{"text":"我只信靠耶和華。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你已經看見我的困苦，","poem":1},{"lineBreak":true},{"text":"知道我心中的愁煩，","poem":1},{"lineBreak":true},{"text":"我因你的恩慈而歡喜快樂。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你沒有將我交在仇敵手中，","poem":1},{"lineBreak":true},{"text":"你使我雙腳站在寬闊之地。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華啊，我落在苦難之中，","poem":1},{"lineBreak":true},{"text":"求你憐憫我，","poem":1},{"lineBreak":true},{"text":"愁苦令我眼目昏聵，身心疲憊。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的生命被愁苦吞噬，","poem":1},{"lineBreak":true},{"text":"歲月被哀傷耗盡，","poem":1},{"lineBreak":true},{"text":"力量因罪惡而消逝，","poem":1},{"lineBreak":true},{"text":"我成了枯骨一堆。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"仇敵羞辱我，","poem":1},{"lineBreak":true},{"text":"鄰居厭棄我，","poem":1},{"lineBreak":true},{"text":"朋友害怕我，","poem":1},{"lineBreak":true},{"text":"路人紛紛躲避我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我被人遺忘，就像已死之人，","poem":1},{"lineBreak":true},{"text":"又像破碎的陶器。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我聽見許多人竊竊私語，","poem":1},{"lineBreak":true},{"text":"恐怖四下瀰漫。","poem":1},{"lineBreak":true},{"text":"他們圖謀不軌，","poem":1},{"lineBreak":true},{"text":"謀害我的性命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"然而，耶和華啊，","poem":1},{"lineBreak":true},{"text":"我依然信靠你；","poem":1},{"lineBreak":true},{"text":"我說：「你是我的上帝。」","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的時日都掌握在你手中，","poem":1},{"lineBreak":true},{"text":"求你救我脫離仇敵和追逼我的人。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"求你以容光照耀僕人，","poem":1},{"lineBreak":true},{"text":"施慈愛拯救我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和華啊，我曾向你呼求，","poem":1},{"lineBreak":true},{"text":"求你不要叫我蒙羞。","poem":1},{"lineBreak":true},{"text":"求你使惡人蒙羞，","poem":1},{"lineBreak":true},{"text":"在陰間寂然無聲。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"願撒謊之人啞聲，","poem":1},{"lineBreak":true},{"text":"他們驕傲自大，","poem":1},{"lineBreak":true},{"text":"狂言攻擊義人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你的恩惠何其大，","poem":1},{"lineBreak":true},{"text":"是為敬畏你的人預備的，","poem":1},{"lineBreak":true},{"text":"在世人面前賜給投靠你的人。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你把他們藏在你那裡，","poem":1},{"lineBreak":true},{"text":"使他們得到庇護，","poem":1},{"lineBreak":true},{"text":"免遭世人暗算。","poem":1},{"lineBreak":true},{"text":"你使他們躲在避難所，","poem":1},{"lineBreak":true},{"text":"免受惡言惡語的攻擊。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和華當受稱頌！","poem":1},{"lineBreak":true},{"text":"因為我被困城中時，","poem":1},{"lineBreak":true},{"text":"祂以奇妙的愛待我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我曾驚恐地說：","poem":1},{"lineBreak":true},{"text":"「我從你面前被棄絕！」","poem":1},{"lineBreak":true},{"text":"其實我求助的時候，","poem":1},{"lineBreak":true},{"text":"你聽了我的呼求。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"耶和華忠心的子民啊，","poem":1},{"lineBreak":true},{"text":"你們要愛祂。","poem":1},{"lineBreak":true},{"text":"祂保護忠心的人，","poem":1},{"lineBreak":true},{"text":"嚴懲驕傲的人。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"凡等候耶和華的人啊，","poem":1},{"lineBreak":true},{"text":"要剛強壯膽！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}