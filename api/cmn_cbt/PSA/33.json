{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":33,"content":[{"type":"heading","content":["頌讚之歌"]},{"type":"verse","number":1,"content":[{"text":"義人啊，","poem":1},{"lineBreak":true},{"text":"你們要歡然歌頌耶和華，","poem":1},{"lineBreak":true},{"text":"正直的人理應讚美祂。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們要彈琴讚美耶和華，","poem":1},{"lineBreak":true},{"text":"彈奏十弦琴歌頌祂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要向祂唱新歌，","poem":1},{"lineBreak":true},{"text":"琴聲要美妙，歌聲要嘹亮。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因為耶和華的話正直，","poem":1},{"lineBreak":true},{"text":"祂的作為信實可靠。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂喜愛公義和公正，","poem":1},{"lineBreak":true},{"text":"大地充滿祂的慈愛。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"諸天靠祂的話被造，","poem":1},{"lineBreak":true},{"text":"萬象靠祂口中的氣而成。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂將海水聚在一處，","poem":1},{"lineBreak":true},{"text":"把汪洋收進倉庫。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"願普世都敬畏耶和華！","poem":1},{"lineBreak":true},{"text":"願世人都畏懼祂！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為祂一發話，就創造了萬有；","poem":1},{"lineBreak":true},{"text":"祂一聲命令，便立定了萬物。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂挫敗列國的謀算，","poem":1},{"lineBreak":true},{"text":"攔阻列邦的計劃。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"祂的計劃永不落空，","poem":1},{"lineBreak":true},{"text":"祂的旨意萬代長存。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"尊祂為上帝的邦國有福了！","poem":1},{"lineBreak":true},{"text":"蒙揀選做祂子民的人有福了！","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"祂從天上俯視人間，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"從祂的居所察看世人。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂塑造人心，","poem":1},{"lineBreak":true},{"text":"洞察人的一切行為。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"君王不能靠兵多取勝，","poem":1},{"lineBreak":true},{"text":"勇士不能憑力大獲救。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"靠戰馬取勝實屬妄想，","poem":1},{"lineBreak":true},{"text":"馬雖力大也不能救人。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"但耶和華看顧敬畏祂的人，","poem":1},{"lineBreak":true},{"text":"祂看顧仰望祂慈愛的人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"祂救他們脫離死亡，","poem":1},{"lineBreak":true},{"text":"保護他們度過饑荒。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我們的心等候耶和華，","poem":1},{"lineBreak":true},{"text":"祂是我們的幫助，","poem":1},{"lineBreak":true},{"text":"是我們的盾牌。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我們信靠祂的聖名，","poem":1},{"lineBreak":true},{"text":"我們的心因祂而充滿喜樂。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和華啊，我們仰望你，求你向我們施慈愛。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}