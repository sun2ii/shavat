{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":34,"content":[{"type":"heading","content":["上帝的美善"]},{"type":"hebrew_subtitle","content":["大衛在亞比米勒面前裝瘋，被趕出去後，作了此詩。"]},{"type":"verse","number":1,"content":[{"text":"我要常常稱頌耶和華，","poem":1},{"lineBreak":true},{"text":"我的口時刻讚美祂。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我因耶和華而誇耀，","poem":1},{"lineBreak":true},{"text":"困苦人聽見必歡欣。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要跟我們一同尊耶和華為大，","poem":1},{"lineBreak":true},{"text":"讓我們一起尊崇祂的名！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我求助耶和華，祂便應允我，","poem":1},{"lineBreak":true},{"text":"救我脫離一切恐懼。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"仰望祂的人都有榮光，","poem":1},{"lineBreak":true},{"text":"他們必不致滿面蒙羞。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我這可憐的人向祂呼求，","poem":1},{"lineBreak":true},{"text":"祂就垂聽，","poem":1},{"lineBreak":true},{"text":"救我脫離一切困境。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂的天使在敬畏祂的人四圍安營，","poem":1},{"lineBreak":true},{"text":"要搭救他們。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你們要親身體驗，","poem":1},{"lineBreak":true},{"text":"就知道耶和華的美善；","poem":1},{"lineBreak":true},{"text":"投靠祂的人有福了！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華的聖民啊，","poem":1},{"lineBreak":true},{"text":"你們要敬畏祂，","poem":1},{"lineBreak":true},{"text":"因為敬畏祂的人一無所缺。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"猛獅也會忍饑挨餓，","poem":1},{"lineBreak":true},{"text":"但尋求耶和華的人什麼福分都不缺。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"孩子們啊，來聽我說，","poem":1},{"lineBreak":true},{"text":"我要教導你們敬畏耶和華。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"若有人熱愛生命，","poem":1},{"lineBreak":true},{"text":"渴望長壽和幸福，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"就要舌頭不出惡言，","poem":1},{"lineBreak":true},{"text":"嘴唇不說詭詐的話。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"要棄惡行善，","poem":1},{"lineBreak":true},{"text":"竭力追求和睦。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和華的眼睛看顧義人，","poem":1},{"lineBreak":true},{"text":"祂的耳朵垂聽他們的呼求。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華嚴懲作惡之人，","poem":1},{"lineBreak":true},{"text":"從世上剷除他們的名。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"義人向耶和華呼救，祂就垂聽，","poem":1},{"lineBreak":true},{"text":"拯救他們脫離一切患難。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"祂安慰悲痛欲絕的人，","poem":1},{"lineBreak":true},{"text":"拯救心靈破碎的人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"義人遭遇許多患難，","poem":1},{"lineBreak":true},{"text":"但耶和華必從中救他，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"保全他一身的骨頭，","poem":1},{"lineBreak":true},{"text":"連一根也不折斷。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"惡人必遭惡報，","poem":1},{"lineBreak":true},{"text":"憎恨義人的必被定罪。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和華必救贖祂的僕人，","poem":1},{"lineBreak":true},{"text":"投靠祂的人必不被定罪。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}