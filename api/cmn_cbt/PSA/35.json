{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":35,"content":[{"type":"heading","content":["求上帝伸冤"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你與我的敵人為敵，","poem":1},{"lineBreak":true},{"text":"攻擊那些攻擊我的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你拿起大小盾牌來幫助我，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"舉起矛槍攻擊追趕我的人。","poem":1},{"lineBreak":true},{"text":"求你對我說：","poem":1},{"lineBreak":true},{"text":"「我是你的拯救。」","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"願害我命的人蒙羞受辱，","poem":1},{"lineBreak":true},{"text":"謀害我的人落荒而逃！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"願耶和華的天使驅散他們，","poem":1},{"lineBreak":true},{"text":"如風吹散糠秕！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"願他們的道路漆黑濕滑，","poem":1},{"lineBreak":true},{"text":"有耶和華的天使在後追趕！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因為他們無故設網羅，","poem":1},{"lineBreak":true},{"text":"挖陷阱要害我性命。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"願他們突遭禍患，","poem":1},{"lineBreak":true},{"text":"願他們作繭自縛，","poem":1},{"lineBreak":true},{"text":"願他們自食惡果。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我要因耶和華而歡欣，","poem":1},{"lineBreak":true},{"text":"因祂的拯救而快樂。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我從心底發出讚歎：","poem":1},{"lineBreak":true},{"text":"「耶和華啊，誰能像你？","poem":1},{"lineBreak":true},{"text":"你拯救弱者免受強者欺壓，","poem":1},{"lineBreak":true},{"text":"拯救窮困的人免遭掠奪。」","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"惡人誣告我，","poem":1},{"lineBreak":true},{"text":"盤問我毫無所知的事情。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們對我以惡報善，","poem":1},{"lineBreak":true},{"text":"令我傷心欲絕。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他們生病時，","poem":1},{"lineBreak":true},{"text":"我披上麻衣，","poem":1},{"lineBreak":true},{"text":"謙卑地為他們禁食禱告，","poem":1},{"lineBreak":true},{"text":"但我的禱告未蒙垂聽。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我為他們哀傷，","poem":1},{"lineBreak":true},{"text":"視他們為朋友、弟兄；","poem":1},{"lineBreak":true},{"text":"我低頭為他們哭泣，","poem":1},{"lineBreak":true},{"text":"如同哀悼自己的母親。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我遭遇患難時，","poem":1},{"lineBreak":true},{"text":"他們卻聚在一起幸災樂禍，","poem":1},{"lineBreak":true},{"text":"合夥攻擊我。","poem":1},{"lineBreak":true},{"text":"素不相識的人也群起攻擊我，","poem":1},{"lineBreak":true},{"text":"不住地譭謗我。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他們肆無忌憚地嘲弄我，","poem":1},{"lineBreak":true},{"text":"咬牙切齒地憎惡我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"你袖手旁觀要到何時？","poem":1},{"lineBreak":true},{"text":"求你救我的性命免遭殘害，","poem":1},{"lineBreak":true},{"text":"救我脫離這些獅子。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要在大會中稱謝你，","poem":1},{"lineBreak":true},{"text":"在眾人面前讚美你。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"求你不要讓無故攻擊我的人幸災樂禍，","poem":1},{"lineBreak":true},{"text":"不要讓無故恨我的人向我輕蔑地擠眼。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他們言語暴戾，","poem":1},{"lineBreak":true},{"text":"謀害安分守己的人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他們輕蔑地高喊：「哈哈！哈哈！","poem":1},{"lineBreak":true},{"text":"我們親眼看見了。」","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和華啊，這一切你都看見了，","poem":1},{"lineBreak":true},{"text":"求你不要再緘默。","poem":1},{"lineBreak":true},{"text":"主啊，求你不要遠離我。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我的上帝，我的主啊，","poem":1},{"lineBreak":true},{"text":"求你起來為我辯護，為我伸冤。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我的上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你按你的公義判我無罪，","poem":1},{"lineBreak":true},{"text":"別讓他們幸災樂禍。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"別讓他們說：","poem":1},{"lineBreak":true},{"text":"「哈哈，我們如願以償了！」","poem":1},{"lineBreak":true},{"text":"別讓他們說：","poem":1},{"lineBreak":true},{"text":"「我們除掉他了！」","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"願幸災樂禍的人蒙羞受辱，","poem":1},{"lineBreak":true},{"text":"願自高自大的人無地自容！","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"願盼望我冤屈得雪的人揚聲歡呼！","poem":1},{"lineBreak":true},{"text":"願他們常說：「耶和華當受尊崇！","poem":1},{"lineBreak":true},{"text":"祂樂意賜福給自己的僕人。」","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我要訴說你的公義，","poem":1},{"lineBreak":true},{"text":"終日讚美你。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}