{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":36,"content":[{"type":"heading","content":["人的邪惡與上帝的美善"]},{"type":"hebrew_subtitle","content":["耶和華的僕人大衛的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"罪惡在惡人內心深處說話，","poem":1},{"lineBreak":true},{"text":"他們眼中對上帝毫無畏懼。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他們自以為是，渾然不知自己的罪，","poem":1},{"lineBreak":true},{"text":"也不憎惡自己的罪。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們滿口惡言謊話，","poem":1},{"lineBreak":true},{"text":"毫無智慧和善行。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們躺在床上盤算作惡，","poem":1},{"lineBreak":true},{"text":"執意走罪惡的道路，","poem":1},{"lineBreak":true},{"text":"惡性不改。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華啊，你的慈愛廣及諸天，","poem":1},{"lineBreak":true},{"text":"你的信實高達穹蒼。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你的公義穩如高山，","poem":1},{"lineBreak":true},{"text":"你的判斷深不可測。","poem":1},{"lineBreak":true},{"text":"耶和華啊，你保護人類，","poem":1},{"lineBreak":true},{"text":"也保護牲畜。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝啊，你的慈愛無比寶貴！","poem":1},{"lineBreak":true},{"text":"世人都投靠在你翅膀的蔭下。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你讓他們飽享你殿裡的美食，","poem":1},{"lineBreak":true},{"text":"暢飲你樂河中的水。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為你那裡有生命之泉，","poem":1},{"lineBreak":true},{"text":"在你的光中我們得見光。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"求你常施慈愛給認識你的人，","poem":1},{"lineBreak":true},{"text":"以公義恩待心地正直的人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"別讓驕傲人的腳踐踏我，","poem":1},{"lineBreak":true},{"text":"別讓邪惡人的手驅趕我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"看啊！作惡的人已經倒下，","poem":1},{"lineBreak":true},{"text":"他們被擊倒，再也起不來。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}