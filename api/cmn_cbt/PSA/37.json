{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":37,"content":[{"type":"heading","content":["義人和惡人的結局"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"不要因為惡人而煩躁，","poem":1},{"lineBreak":true},{"text":"也不要羡慕不義之人，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為他們如瞬息枯萎的草芥，","poem":1},{"lineBreak":true},{"text":"又如轉眼消逝的青草。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"要信靠耶和華，要行善，","poem":1},{"lineBreak":true},{"text":"要在這片土地上安然度日。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"要以耶和華為樂，","poem":1},{"lineBreak":true},{"text":"祂必成全你的心願。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要把你的路交托給耶和華，","poem":1},{"lineBreak":true},{"text":"信靠祂，祂必幫助你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂使你的公義如晨光照耀，","poem":1},{"lineBreak":true},{"text":"使你的仁義如日中天。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"要在耶和華面前安靜，","poem":1},{"lineBreak":true},{"text":"耐心等候祂，","poem":1},{"lineBreak":true},{"text":"不要因惡人道路通達、陰謀得逞而煩躁。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你要抑制怒氣，除掉憤怒；","poem":1},{"lineBreak":true},{"text":"不要煩躁不安，","poem":1},{"lineBreak":true},{"text":"那會導致你作惡。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為作惡的必被消滅，","poem":1},{"lineBreak":true},{"text":"但等候耶和華的必承受土地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"再過片刻，惡人必不復存在，","poem":1},{"lineBreak":true},{"text":"雖尋遍其住處，也不見蹤影。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"但謙卑人必承受土地，","poem":1},{"lineBreak":true},{"text":"得享太平昌盛。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"惡人謀害義人，","poem":1},{"lineBreak":true},{"text":"對他們咬牙切齒。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"但主嗤笑邪惡人，","poem":1},{"lineBreak":true},{"text":"因為祂知道他們末日將臨。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"惡人拔劍張弓要消滅窮苦人，","poem":1},{"lineBreak":true},{"text":"殺戮正直人，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"但他們的劍必刺穿自己的心，","poem":1},{"lineBreak":true},{"text":"他們的弓必被折斷。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"義人清貧一生強過惡人財富如山。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因為惡人的勢力終必瓦解，","poem":1},{"lineBreak":true},{"text":"耶和華必扶持義人。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和華看顧純全者的時日，","poem":1},{"lineBreak":true},{"text":"他們的產業永遠長存。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他們在災難中不致蒙羞，","poem":1},{"lineBreak":true},{"text":"在饑荒時仍得飽足。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"但惡人必滅亡，","poem":1},{"lineBreak":true},{"text":"耶和華的仇敵必像野地的花一樣凋零，","poem":1},{"lineBreak":true},{"text":"消逝如煙。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"惡人借債不還，","poem":1},{"lineBreak":true},{"text":"義人慷慨給予。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"蒙耶和華賜福的人必承受土地，","poem":1},{"lineBreak":true},{"text":"被耶和華咒詛的人必遭剷除。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"耶和華鞏固義人的腳步，","poem":1},{"lineBreak":true},{"text":"喜悅他們所走的路。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他們即使失腳，也不會跌倒，","poem":1},{"lineBreak":true},{"text":"因為耶和華的手扶持他們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"從幼年到老年，","poem":1},{"lineBreak":true},{"text":"我從未見過義人遭棄，","poem":1},{"lineBreak":true},{"text":"也未見其後人討飯。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他們總是樂善好施，","poem":1},{"lineBreak":true},{"text":"他們的後代都蒙祝福。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"你要離惡行善，","poem":1},{"lineBreak":true},{"text":"就必永遠安居。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"因為耶和華喜愛公正，","poem":1},{"lineBreak":true},{"text":"不丟棄信靠祂的人，","poem":1},{"lineBreak":true},{"text":"永遠保護他們。","poem":1},{"lineBreak":true},{"text":"惡人的後代必被剷除。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"義人必承受土地，","poem":1},{"lineBreak":true},{"text":"在地上永遠安居。","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"義人口出智慧，訴說正義，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"銘記上帝的律法，","poem":1},{"lineBreak":true},{"text":"從不失腳。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"惡人窺探義人，","poem":1},{"lineBreak":true},{"text":"伺機謀害。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"但耶和華不會讓他們落在惡人手中，","poem":1},{"lineBreak":true},{"text":"也不會讓義人在審判時被定罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"要等候耶和華，","poem":1},{"lineBreak":true},{"text":"堅守祂的道，","poem":1},{"lineBreak":true},{"text":"祂必賜你土地，使你有尊榮。","poem":1},{"lineBreak":true},{"text":"你必親眼看見惡人被剷除。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"我見過邪惡殘暴之人，","poem":1},{"lineBreak":true},{"text":"勢如本地青翠的香柏樹，","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"再一看，他已經消失得無影無蹤，","poem":1},{"lineBreak":true},{"text":"我尋找他，卻找不到。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"你觀察那純全正直的人，","poem":1},{"lineBreak":true},{"text":"因為和平的人前途美好。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"罪人必同遭毀滅，","poem":1},{"lineBreak":true},{"text":"惡人必沒有前途。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"耶和華拯救義人，","poem":1},{"lineBreak":true},{"text":"患難時作他們的庇護所。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"耶和華救助他們，","poem":1},{"lineBreak":true},{"text":"救他們脫離惡人，拯救他們，","poem":1},{"lineBreak":true},{"text":"因為他們投靠祂。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}