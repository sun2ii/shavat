{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":38,"content":[{"type":"heading","content":["受苦者的祈求"]},{"type":"hebrew_subtitle","content":["大衛作的禱告詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你不要發怒責罰我，","poem":1},{"lineBreak":true},{"text":"不要在烈怒下管教我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為你的箭射穿我，","poem":1},{"lineBreak":true},{"text":"你的手擊打我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的怒氣使我渾身是病，","poem":1},{"lineBreak":true},{"text":"我的罪惡使我骨頭朽爛。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的罪惡滔天，如同重擔壓身。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我因愚昧而傷口發臭流膿。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我疼得彎腰駝背，","poem":1},{"lineBreak":true},{"text":"終日哀傷。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的腰灼痛難忍，","poem":1},{"lineBreak":true},{"text":"我渾身是病。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我精疲力盡，徹底崩潰；","poem":1},{"lineBreak":true},{"text":"我心中悲傷，呻吟不止。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"主啊，我的渴望都顯露在你面前，","poem":1},{"lineBreak":true},{"text":"我的歎息瞞不過你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的心砰砰直跳，","poem":1},{"lineBreak":true},{"text":"力量衰竭，","poem":1},{"lineBreak":true},{"text":"眼睛黯淡無光。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因我的疾病，朋友同伴迴避我，","poem":1},{"lineBreak":true},{"text":"親人避而遠之。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"要我命的人設下陷阱，","poem":1},{"lineBreak":true},{"text":"想害我的人威脅我，","poem":1},{"lineBreak":true},{"text":"他們整天圖謀奸計。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"但我像耳聾的人一樣聽不見，","poem":1},{"lineBreak":true},{"text":"又像無法說話的啞巴。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我就像一個不能聽、不能辯的人。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和華啊，我等候你；","poem":1},{"lineBreak":true},{"text":"主，我的上帝啊，你必應允我。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我曾求告你，","poem":1},{"lineBreak":true},{"text":"別讓他們幸災樂禍，","poem":1},{"lineBreak":true},{"text":"在我失腳時沾沾自喜。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我快要跌倒，","poem":1},{"lineBreak":true},{"text":"我的痛苦常伴。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要承認我的罪過，","poem":1},{"lineBreak":true},{"text":"罪惡使我心裡惴惴不安。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的仇敵勢力強大，","poem":1},{"lineBreak":true},{"text":"無故恨我的人不計其數。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我追求良善，","poem":1},{"lineBreak":true},{"text":"他們就恨我，以惡報善。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和華啊，求你不要撇棄我！","poem":1},{"lineBreak":true},{"text":"我的上帝啊，求你不要遠離我！","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"拯救我的主啊，","poem":1},{"lineBreak":true},{"text":"求你快來幫助我！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}