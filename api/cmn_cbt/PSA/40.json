{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":40,"content":[{"type":"heading","content":["讚美上帝之歌"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"我曾耐心等候耶和華，","poem":1},{"lineBreak":true},{"text":"祂垂聽了我的呼求。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"祂把我從絕望的深淵拉出來，","poem":1},{"lineBreak":true},{"text":"救我脫離泥濘沼澤，","poem":1},{"lineBreak":true},{"text":"把我安置在磐石上，","poem":1},{"lineBreak":true},{"text":"使我步履穩健。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂賜給我一首新歌，","poem":1},{"lineBreak":true},{"text":"一首讚美我們上帝的詩歌。","poem":1},{"lineBreak":true},{"text":"許多人看見便敬畏、信靠耶和華。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"信靠耶和華的人有福了！","poem":1},{"lineBreak":true},{"text":"他們不隨從驕傲自大、信靠假神的人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"你行了許多奇事，","poem":1},{"lineBreak":true},{"text":"為我們定了許多美好的計劃，","poem":1},{"lineBreak":true},{"text":"誰能與你相比！","poem":1},{"lineBreak":true},{"text":"你奇妙的作為不可勝數，述說不盡。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祭物和供物非你所悅，","poem":1},{"lineBreak":true},{"text":"你開通了我的耳朵，","poem":1},{"lineBreak":true},{"text":"燔祭和贖罪祭非你所要。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"於是我說：","poem":1},{"lineBreak":true},{"text":"「看啊，我來了，","poem":1},{"lineBreak":true},{"text":"正如經卷上關於我的記載。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"我樂意遵行你的旨意，","poem":1},{"lineBreak":true},{"text":"我銘記你的律法。」","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我在大會中宣揚你的公義，","poem":1},{"lineBreak":true},{"text":"耶和華啊，你知道我沒有閉口不言。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我述說你的信實和拯救之恩，","poem":1},{"lineBreak":true},{"text":"沒有把你的公義埋沒在心，","poem":1},{"lineBreak":true},{"text":"沒有對會眾避而不談你的慈愛和真理。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你不要向我止住你的憐憫，","poem":1},{"lineBreak":true},{"text":"願你的慈愛和真理時刻守護我！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我患難重重，罪惡纏身，","poem":1},{"lineBreak":true},{"text":"以致擋住我的視線。","poem":1},{"lineBreak":true},{"text":"我的罪過比我的頭髮還多，","poem":1},{"lineBreak":true},{"text":"我心驚膽戰。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華啊，求你施恩搭救我！","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你快來幫助我！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"願謀取我性命的人蒙羞受辱！","poem":1},{"lineBreak":true},{"text":"願喜歡我遭害的人抱愧而逃！","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"願那些哈哈嘲笑我的人羞愧難當！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"願所有尋求你的人因你而歡喜快樂！","poem":1},{"lineBreak":true},{"text":"願渴望蒙你拯救的人時常說：","poem":1},{"lineBreak":true},{"text":"「耶和華至大！」","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我貧窮困苦，","poem":1},{"lineBreak":true},{"text":"但主眷顧我。","poem":1},{"lineBreak":true},{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"你是我的幫助、我的拯救，","poem":1},{"lineBreak":true},{"text":"求你不要遲延！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}