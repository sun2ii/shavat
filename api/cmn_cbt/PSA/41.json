{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":41,"content":[{"type":"heading","content":["病中的禱告"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"善待窮人的有福了！","poem":1},{"lineBreak":true},{"text":"患難之日，耶和華必救他們。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華必保護他們，","poem":1},{"lineBreak":true},{"text":"救他們的性命，","poem":1},{"lineBreak":true},{"text":"使他們在地上享福，","poem":1},{"lineBreak":true},{"text":"不讓仇敵惡謀得逞。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們臥病在床，","poem":1},{"lineBreak":true},{"text":"耶和華必扶持他們，","poem":1},{"lineBreak":true},{"text":"使他們恢復健康。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我禱告說：「耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你憐憫我，醫治我，","poem":1},{"lineBreak":true},{"text":"因為我得罪了你。」","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的仇敵惡言議論我，說：","poem":1},{"lineBreak":true},{"text":"「他何時才會死，","poem":1},{"lineBreak":true},{"text":"並且名字被人遺忘呢？」","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們來看我時，","poem":1},{"lineBreak":true},{"text":"心懷惡意，滿口謊言，","poem":1},{"lineBreak":true},{"text":"出去後散佈流言。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"所有恨我的人都交頭接耳，","poem":1},{"lineBreak":true},{"text":"設計害我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們說：「他患了惡病，","poem":1},{"lineBreak":true},{"text":"再也從臥榻上起不來了！」","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"連我所信賴、吃我飯的摯友也用腳踢我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你憐憫我，叫我痊癒，","poem":1},{"lineBreak":true},{"text":"我好報復他們。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我知道你喜悅我，","poem":1},{"lineBreak":true},{"text":"因為你沒有讓仇敵勝過我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你因我純全而扶持我，","poem":1},{"lineBreak":true},{"text":"讓我永遠侍立在你面前。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"以色列的上帝耶和華永永遠遠當受稱頌。","poem":1},{"lineBreak":true},{"text":"阿們！阿們！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}