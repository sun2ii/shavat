{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":43,"content":[{"type":"heading","content":["流亡異鄉者的禱告"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"求你為我主持公道，","poem":1},{"lineBreak":true},{"text":"在不虔敬的民面前為我辯護，","poem":1},{"lineBreak":true},{"text":"救我脫離詭詐邪惡的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你是庇護我的上帝，","poem":1},{"lineBreak":true},{"text":"你為何丟棄我？","poem":1},{"lineBreak":true},{"text":"為何讓我受仇敵的攻擊，","poem":1},{"lineBreak":true},{"text":"使我哀傷不已呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"求你以光明和真理引導我，","poem":1},{"lineBreak":true},{"text":"領我到你的聖山，到你的居所。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要到上帝的祭壇前，","poem":1},{"lineBreak":true},{"text":"到賜我喜樂的上帝面前。","poem":1},{"lineBreak":true},{"text":"上帝啊，我的上帝，","poem":1},{"lineBreak":true},{"text":"我要彈琴讚美你。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的心啊！","poem":1},{"lineBreak":true},{"text":"你為何沮喪？為何在我裡面煩躁？","poem":1},{"lineBreak":true},{"text":"要仰望上帝，","poem":1},{"lineBreak":true},{"text":"因為我還要讚美祂——我的救主，我的上帝。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}