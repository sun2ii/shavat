{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":44,"content":[{"type":"heading","content":["祈求上帝保護"]},{"type":"hebrew_subtitle","content":["可拉後裔作的訓誨詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"我們親耳聽過祖先講述你在古時，","poem":1},{"lineBreak":true},{"text":"在我們祖先時代的作為。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你親手趕出外族，","poem":1},{"lineBreak":true},{"text":"把我們的祖先安置在那裡；","poem":1},{"lineBreak":true},{"text":"你擊潰列邦，","poem":1},{"lineBreak":true},{"text":"使我們的祖先興旺發達。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們不是靠自己的刀劍征服那裡，","poem":1},{"lineBreak":true},{"text":"不是靠自己的臂膀得勝，","poem":1},{"lineBreak":true},{"text":"而是靠你的右手、你的臂膀和你的容光，","poem":1},{"lineBreak":true},{"text":"因為你愛他們。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你是我的君王，我的上帝；","poem":1},{"lineBreak":true},{"text":"你命定雅各得勝。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我們靠你擊退敵人，","poem":1},{"lineBreak":true},{"text":"靠你的名踐踏仇敵。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我不倚靠我的弓，","poem":1},{"lineBreak":true},{"text":"我的劍不能使我得勝。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"只有你救我們脫離敵人，","poem":1},{"lineBreak":true},{"text":"使我們的仇敵蒙羞。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我們終日憑上帝誇耀，","poem":1},{"lineBreak":true},{"text":"我們永遠讚美你的名。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"現在你卻丟棄我們，讓我們受辱，","poem":1},{"lineBreak":true},{"text":"不再同我們的軍隊出戰。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你使我們在仇敵面前敗退，","poem":1},{"lineBreak":true},{"text":"遭敵人擄掠。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你使我們如被宰殺的羊，","poem":1},{"lineBreak":true},{"text":"將我們分散在列國。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你把我們廉價賣掉，","poem":1},{"lineBreak":true},{"text":"並未從買賣中獲利。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你使我們遭四鄰辱罵，","poem":1},{"lineBreak":true},{"text":"被周圍人譏諷、嘲笑。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你使我們成為列國的笑柄，","poem":1},{"lineBreak":true},{"text":"列邦對我們連連搖頭。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我終日受辱，滿臉盡是恥辱，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因為咒罵和譭謗我的人譏笑我，","poem":1},{"lineBreak":true},{"text":"仇敵報復我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"雖然這一切臨到我們身上，","poem":1},{"lineBreak":true},{"text":"我們卻沒有忘記你，","poem":1},{"lineBreak":true},{"text":"也沒有違背你的約。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我們對你沒有異心，","poem":1},{"lineBreak":true},{"text":"也沒有偏離你的道路。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你在豺狼出沒的地方壓碎我們，","poem":1},{"lineBreak":true},{"text":"使死亡的陰影籠罩我們。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"倘若我們忘記我們上帝的名，","poem":1},{"lineBreak":true},{"text":"或舉手向外邦的神明禱告，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"上帝難道察覺不到嗎？","poem":1},{"lineBreak":true},{"text":"祂洞悉人心中的秘密。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"為了你，我們終日出生入死，","poem":1},{"lineBreak":true},{"text":"被視為待宰的羊。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"主啊，求你醒來，","poem":1},{"lineBreak":true},{"text":"你為何沉睡？","poem":1},{"lineBreak":true},{"text":"求你起來，不要永遠丟棄我們。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你為何掩面不理我們，","poem":1},{"lineBreak":true},{"text":"忘記我們所受的苦難和壓迫？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我們仆倒在地，橫臥在塵土中。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"求你起來幫助我們，","poem":1},{"lineBreak":true},{"text":"因你的慈愛而救贖我們。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}