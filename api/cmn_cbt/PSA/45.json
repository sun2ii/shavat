{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":45,"content":[{"type":"heading","content":["婚禮詩歌"]},{"type":"hebrew_subtitle","content":["可拉後裔作的訓誨詩，也是情歌，交給樂長，調用「百合花」。"]},{"type":"verse","number":1,"content":[{"text":"我心中湧出美麗的詩章，","poem":1},{"lineBreak":true},{"text":"我要把它獻給王，","poem":1},{"lineBreak":true},{"text":"我的舌頭是詩人手上的妙筆。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你俊美無比，口出恩言，","poem":1},{"lineBreak":true},{"text":"因此上帝永遠賜福給你。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"英勇的王啊，","poem":1},{"lineBreak":true},{"text":"佩上你的寶劍，","poem":1},{"lineBreak":true},{"text":"展示你的尊貴和威嚴！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你威嚴無比，所向披靡，","poem":1},{"lineBreak":true},{"text":"捍衛真理、謙卑和公義。","poem":1},{"lineBreak":true},{"text":"願你的右手彰顯可畏的作為！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的利箭刺穿敵人的心窩，","poem":1},{"lineBreak":true},{"text":"列國臣服在你腳下。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"上帝啊，你的寶座永遠長存，","poem":1},{"lineBreak":true},{"text":"你以公義的杖執掌王權。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你喜愛公義，憎惡邪惡，","poem":1},{"lineBreak":true},{"text":"所以上帝，你的上帝，","poem":1},{"lineBreak":true},{"text":"用喜樂之油膏你，","poem":1},{"lineBreak":true},{"text":"使你超過同伴。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你的衣袍散發出沒藥、沉香和肉桂的芬芳，","poem":1},{"lineBreak":true},{"text":"你陶醉在象牙宮的弦樂中。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"眾公主在你的貴客中，","poem":1},{"lineBreak":true},{"text":"戴俄斐金飾的王后站在你右邊。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"女子啊，要聆聽，","poem":1},{"lineBreak":true},{"text":"要側耳傾聽：不要再掛念家鄉的父老，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"王就會喜歡你的美貌，","poem":1},{"lineBreak":true},{"text":"你要敬重他，因他是你的主。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"泰爾人必來送禮，","poem":1},{"lineBreak":true},{"text":"富人必來取悅你。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"公主身穿金線衣，無比華貴。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"她身披錦繡，","poem":1},{"lineBreak":true},{"text":"由侍女伴隨前來見王，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"她們歡喜快樂地被帶入王宮。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你的子孫將來要繼承祖先的王位，","poem":1},{"lineBreak":true},{"text":"你要立他們在各地做王。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我要使萬代銘記你的名，","poem":1},{"lineBreak":true},{"text":"列邦必永遠稱謝你。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}