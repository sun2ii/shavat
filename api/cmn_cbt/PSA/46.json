{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":46,"content":[{"type":"heading","content":["上帝與我們同在"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩，交給樂長，調用女高音。"]},{"type":"verse","number":1,"content":[{"text":"上帝是我們的避難所，","poem":1},{"lineBreak":true},{"text":"是我們的力量，","poem":1},{"lineBreak":true},{"text":"是我們患難中隨時的幫助。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因此，任大地震動，","poem":1},{"lineBreak":true},{"text":"群山沉入深海；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"任海濤洶湧澎湃，","poem":1},{"lineBreak":true},{"text":"群山搖撼顫抖，","poem":1},{"lineBreak":true},{"text":"我們也不懼怕。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"有一條河的支流給上帝的城，","poem":1},{"lineBreak":true},{"text":"給至高者的聖所帶來喜樂。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝住在裡面，","poem":1},{"lineBreak":true},{"text":"城必屹立不倒。","poem":1},{"lineBreak":true},{"text":"天一亮，上帝必幫助這城。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"列邦動盪，列國傾覆。","poem":1},{"lineBreak":true},{"text":"上帝的聲音使大地熔化。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"萬軍之耶和華與我們同在，","poem":1},{"lineBreak":true},{"text":"雅各的上帝是我們的堡壘。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你們來看耶和華的作為吧！","poem":1},{"lineBreak":true},{"text":"祂使大地荒涼。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂平息天下的戰爭，","poem":1},{"lineBreak":true},{"text":"祂斷弓、折槍、燒毀盾牌。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祂說：「要安靜，","poem":1},{"lineBreak":true},{"text":"要知道我是上帝，","poem":1},{"lineBreak":true},{"text":"我必在列國受尊崇，","poem":1},{"lineBreak":true},{"text":"在普世受尊崇。」","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"萬軍之耶和華與我們同在，","poem":1},{"lineBreak":true},{"text":"雅各的上帝是我們的堡壘。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}