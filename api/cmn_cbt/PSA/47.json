{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":47,"content":[{"type":"heading","content":["至高的主宰"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"萬民啊，你們要鼓掌，","poem":1},{"lineBreak":true},{"text":"向上帝高聲歡呼！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為至高者耶和華當受敬畏，","poem":1},{"lineBreak":true},{"text":"祂是掌管天下的大君王。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂使列國降服於我們，","poem":1},{"lineBreak":true},{"text":"讓列邦伏在我們腳下。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂為我們選定產業，","poem":1},{"lineBreak":true},{"text":"就是祂所愛的雅各引以為榮的產業。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"上帝在歡呼聲中登上寶座；","poem":1},{"lineBreak":true},{"text":"耶和華在角聲中登上寶座。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"要歌頌，歌頌上帝！","poem":1},{"lineBreak":true},{"text":"要歌頌，歌頌我們的君王！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因為上帝是普天下的君王，","poem":1},{"lineBreak":true},{"text":"要向祂唱頌讚的樂章。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"上帝坐在聖潔的寶座上治理列國。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"列邦的首領聚集在一起，","poem":1},{"lineBreak":true},{"text":"要做亞伯拉罕之上帝的子民，","poem":1},{"lineBreak":true},{"text":"因為上帝主宰世上的君王，","poem":1},{"lineBreak":true},{"text":"祂至高無上。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}