{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":48,"content":[{"type":"heading","content":["上帝的城錫安"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華何等偉大！","poem":1},{"lineBreak":true},{"text":"我們的上帝在祂的城中，","poem":1},{"lineBreak":true},{"text":"在祂的聖山上當大受頌讚。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"北面的錫安山雄偉壯麗，","poem":1},{"lineBreak":true},{"text":"令世人歡喜，","poem":1},{"lineBreak":true},{"text":"是偉大君王的城。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝在城內的殿宇中，","poem":1},{"lineBreak":true},{"text":"祂親自做這城的庇護。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"世上的君王一同聚集，齊來攻城。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們看見這城後，","poem":1},{"lineBreak":true},{"text":"大驚失色，慌忙逃跑。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們被恐懼籠罩，","poem":1},{"lineBreak":true},{"text":"痛苦如分娩的婦人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你毀滅他們，","poem":1},{"lineBreak":true},{"text":"如同東風摧毀他施的船隻。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我們曾經聽說，如今在萬軍之耶和華的城中，","poem":1},{"lineBreak":true},{"text":"在我們上帝的城中親眼看見：","poem":1},{"lineBreak":true},{"text":"上帝要堅立這城，直到永遠。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"上帝啊，我們在你的殿中默想你的慈愛。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，你秉公行義，","poem":1},{"lineBreak":true},{"text":"你的名普世皆知，","poem":1},{"lineBreak":true},{"text":"頌讚你的聲音響徹地極。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因你的審判，","poem":1},{"lineBreak":true},{"text":"錫安山歡喜，","poem":1},{"lineBreak":true},{"text":"猶大的城邑充滿快樂。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你們要圍繞錫安數點她的城樓，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"留意她的城牆，","poem":1},{"lineBreak":true},{"text":"觀看她的殿宇，","poem":1},{"lineBreak":true},{"text":"好告訴子孫後代。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因為上帝永永遠遠是我們的上帝，","poem":1},{"lineBreak":true},{"text":"祂必引領我們，","poem":1},{"lineBreak":true},{"text":"直到我們離世之日。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}