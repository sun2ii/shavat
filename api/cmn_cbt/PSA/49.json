{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":49,"content":[{"type":"heading","content":["財富的虛幻"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"萬民啊，你們要聽！","poem":1},{"lineBreak":true},{"text":"世人啊，要側耳聽！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"不論貴賤貧富，都要留心聽！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為我口出智慧，我心思明智。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要側耳聽箴言，","poem":1},{"lineBreak":true},{"text":"彈琴解釋謎語。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"危難來臨，四面被奸詐之徒包圍時，我何必懼怕？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們倚靠金錢、誇耀財富，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"卻不能救贖自己的生命，","poem":1},{"lineBreak":true},{"text":"也無法向上帝付生命的贖價。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因為生命的贖價高昂，","poem":1},{"lineBreak":true},{"text":"無人付得起，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"以致可以永遠活著，不進墳墓。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"誠如所見，即使智者也要死去，","poem":1},{"lineBreak":true},{"text":"愚人和庸者也要滅亡，","poem":1},{"lineBreak":true},{"text":"將他們的財富留給別人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"儘管他們用自己的名字來為產業命名，","poem":1},{"lineBreak":true},{"text":"墳墓卻是他們永遠的歸宿，","poem":1},{"lineBreak":true},{"text":"世代的住處。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"人不能長享富貴，","poem":1},{"lineBreak":true},{"text":"終必死去，與獸無異。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"這就是愚昧人及其追隨者的下場！（細拉）","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們註定要死，與羊無異，","poem":1},{"lineBreak":true},{"text":"死亡是他們的牧者；","poem":1},{"lineBreak":true},{"text":"到了早晨，","poem":1},{"lineBreak":true},{"text":"他們必被正直人管轄。","poem":1},{"lineBreak":true},{"text":"他們的軀體必爛在陰間，","poem":1},{"lineBreak":true},{"text":"遠離自己的豪宅。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"但上帝必救贖我的生命脫離陰間的權勢，","poem":1},{"lineBreak":true},{"text":"並接我到祂身邊。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"當他人財富增多，日益奢華，","poem":1},{"lineBreak":true},{"text":"不要害怕。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因為他們死時什麼也帶不走，","poem":1},{"lineBreak":true},{"text":"他們的榮華不會跟進墳墓。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他們活著時自以為有福，","poem":1},{"lineBreak":true},{"text":"人們都讚揚他們的成就，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"到頭來他們還是要歸到祖先那裡，","poem":1},{"lineBreak":true},{"text":"再也看不見光明。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"人有財富，卻無明智的心，","poem":1},{"lineBreak":true},{"text":"無異於必死的獸類。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}