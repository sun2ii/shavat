{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":5,"content":[{"type":"heading","content":["求上帝保護"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長，用管樂器。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你垂聽我的禱告，","poem":1},{"lineBreak":true},{"text":"顧念我的哀歎。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的王，我的上帝啊！","poem":1},{"lineBreak":true},{"text":"求你傾聽我的呼求，","poem":1},{"lineBreak":true},{"text":"因為我向你祈禱。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華啊！早晨你聽我的禱告。","poem":1},{"lineBreak":true},{"text":"早晨我到你面前祈求，","poem":1},{"lineBreak":true},{"text":"切切等候。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你不是一位喜歡邪惡的上帝，","poem":1},{"lineBreak":true},{"text":"惡人不能與你同住。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"狂妄之人不能站在你面前，","poem":1},{"lineBreak":true},{"text":"你憎惡一切作惡之人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"說謊的，你毀滅；","poem":1},{"lineBreak":true},{"text":"兇殘詭詐的，你痛恨。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"但我要憑你豐盛的慈愛進入你的居所，","poem":1},{"lineBreak":true},{"text":"我要懷著敬畏向你的聖殿下拜。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華啊，因為仇敵環伺，","poem":1},{"lineBreak":true},{"text":"求你以公義引領我，","poem":1},{"lineBreak":true},{"text":"使我走你安排的正路。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們口中毫無實話，","poem":1},{"lineBreak":true},{"text":"心裡充滿惡毒，","poem":1},{"lineBreak":true},{"text":"喉嚨是敞開的墳墓，","poem":1},{"lineBreak":true},{"text":"舌頭上盡是詭詐。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"求你定他們的罪，","poem":1},{"lineBreak":true},{"text":"讓他們作繭自縛。","poem":1},{"lineBreak":true},{"text":"他們背叛你，罪惡深重，","poem":1},{"lineBreak":true},{"text":"求你把他們趕走。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"願投靠你的人快樂，歡歌不斷。","poem":1},{"lineBreak":true},{"text":"求你庇護他們，","poem":1},{"lineBreak":true},{"text":"讓愛你名的人因你而喜樂。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和華啊，你必賜福給義人，","poem":1},{"lineBreak":true},{"text":"你的恩惠像盾牌四面保護他們。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}