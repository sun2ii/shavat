{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":50,"content":[{"type":"heading","content":["真正的敬拜"]},{"type":"hebrew_subtitle","content":["亞薩的詩。"]},{"type":"verse","number":1,"content":[{"text":"從日出之地到日落之處，","poem":1},{"lineBreak":true},{"text":"大能的上帝耶和華召喚世人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"上帝從完美的錫安發光。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我們的上帝來臨，","poem":1},{"lineBreak":true},{"text":"並非悄然無聲，","poem":1},{"lineBreak":true},{"text":"祂前面有烈火燃燒，","poem":1},{"lineBreak":true},{"text":"周圍有暴風怒吼。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂召喚天地，","poem":1},{"lineBreak":true},{"text":"為要審判祂的子民。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"祂說：「把我的聖民招聚到我這裡，","poem":1},{"lineBreak":true},{"text":"就是那些用祭物和我立約的人。」","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"諸天宣揚上帝的公義，","poem":1},{"lineBreak":true},{"text":"因為上帝是審判官。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"祂說：「我的子民啊，聽我說！","poem":1},{"lineBreak":true},{"text":"以色列啊，我要指控你！","poem":1},{"lineBreak":true},{"text":"我是上帝，是你的上帝。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我責怪你，不是因為你的祭物，","poem":1},{"lineBreak":true},{"text":"也不是因為你經常獻給我的燔祭。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我不需要你棚裡的公牛和圈裡的山羊，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因為林中的百獸是我的，","poem":1},{"lineBreak":true},{"text":"群山上的牲畜是我的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我知道山中所有的飛鳥，","poem":1},{"lineBreak":true},{"text":"田野的動物都是我的。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"就是我餓了，也不用告訴你，","poem":1},{"lineBreak":true},{"text":"因為世界和其中的一切都是我的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"難道我吃公牛的肉，","poem":1},{"lineBreak":true},{"text":"喝山羊的血嗎？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你要向上帝獻上感恩祭，","poem":1},{"lineBreak":true},{"text":"向至高者兌現誓言，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"在患難中呼求我，","poem":1},{"lineBreak":true},{"text":"我必拯救你，你必尊崇我。」","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"但上帝對惡人說：","poem":1},{"lineBreak":true},{"text":"「你怎能背誦我的律法，","poem":1},{"lineBreak":true},{"text":"口中談論我的約？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你憎惡我的管教，","poem":1},{"lineBreak":true},{"text":"把我的話拋在腦後。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你見了盜賊就與他同流合污，","poem":1},{"lineBreak":true},{"text":"又喜歡與淫亂的人交往。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你滿口惡言，謊話連篇。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你坐著陷害自己的兄弟，","poem":1},{"lineBreak":true},{"text":"毀謗自己的同胞兄弟。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我對你的所作所為默然不語，","poem":1},{"lineBreak":true},{"text":"你就以為我與你是同道。","poem":1},{"lineBreak":true},{"text":"現在我要責備你，","poem":1},{"lineBreak":true},{"text":"當面指出你的罪狀。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"忘記上帝的人啊，","poem":1},{"lineBreak":true},{"text":"你們要省察，","poem":1},{"lineBreak":true},{"text":"免得我撕碎你們，","poem":1},{"lineBreak":true},{"text":"那時誰也救不了你們。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"向我獻上感恩就是尊崇我，","poem":1},{"lineBreak":true},{"text":"我必拯救走正路的人。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}