{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":51,"content":[{"type":"heading","content":["祈求上帝赦免"]},{"type":"hebrew_subtitle","content":["大衛與拔示巴通姦後，先知拿單來找他，他作了此詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你按你的慈愛憐憫我；","poem":1},{"lineBreak":true},{"text":"按你極大的憐憫除去我的過犯。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你洗淨我的罪過，","poem":1},{"lineBreak":true},{"text":"清除我的罪惡。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我知道自己的過犯，","poem":1},{"lineBreak":true},{"text":"我的罪惡一直縈繞眼前。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我犯罪得罪了你，","poem":1},{"lineBreak":true},{"text":"唯獨得罪了你，","poem":1},{"lineBreak":true},{"text":"做了你看為邪惡的事，","poem":1},{"lineBreak":true},{"text":"所以你責備我是正當的，","poem":1},{"lineBreak":true},{"text":"你對我的審判是公正的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我生來就是個罪人，","poem":1},{"lineBreak":true},{"text":"在母腹成胎的時候就有罪。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你所喜愛的是內心的誠實，","poem":1},{"lineBreak":true},{"text":"求你使我內心有智慧。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你用牛膝草潔淨我的罪，","poem":1},{"lineBreak":true},{"text":"使我乾淨；","poem":1},{"lineBreak":true},{"text":"求你洗淨我，使我比雪更白。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你讓我聽到歡喜快樂的聲音，","poem":1},{"lineBreak":true},{"text":"讓我這被你壓碎的骨頭可以歡樂。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你掩面不看我的罪過，","poem":1},{"lineBreak":true},{"text":"除去我一切的罪惡。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"求你為我造一顆純潔的心，","poem":1},{"lineBreak":true},{"text":"使我裡面重新有正直的靈。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"不要丟棄我，","poem":1},{"lineBreak":true},{"text":"使我離開你，","poem":1},{"lineBreak":true},{"text":"也不要從我身上收回你的聖靈。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你讓我重新享受蒙你拯救的喜樂，","poem":1},{"lineBreak":true},{"text":"賜我一個樂意順服你的心靈。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我就會把你的法則教導悖逆之人，","poem":1},{"lineBreak":true},{"text":"使罪人歸向你。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"上帝啊，拯救我的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你救我脫離殺人流血的罪，","poem":1},{"lineBreak":true},{"text":"使我開口頌揚你的公義。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"主啊，求你開我的嘴唇，","poem":1},{"lineBreak":true},{"text":"我的口要向你發出讚美。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你不喜歡祭物，","poem":1},{"lineBreak":true},{"text":"否則我會獻上，","poem":1},{"lineBreak":true},{"text":"你也不喜愛燔祭。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你所要的祭是憂傷的心靈。","poem":1},{"lineBreak":true},{"text":"上帝啊，你必不輕看憂傷痛悔的心。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你恩待錫安，重建耶路撒冷的城牆。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"那時，你必悅納誠心獻上的祭物、燔祭和全牲燔祭，","poem":1},{"lineBreak":true},{"text":"人們必把公牛獻在你的壇上。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}