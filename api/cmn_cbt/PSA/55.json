{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":55,"content":[{"type":"heading","content":["被朋友出賣者的禱告"]},{"type":"hebrew_subtitle","content":["大衛作的訓誨詩，交給樂長，用弦樂器。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"求你垂聽我的禱告，","poem":1},{"lineBreak":true},{"text":"不要對我的呼求置之不理。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你垂聽、應允我的呼求。","poem":1},{"lineBreak":true},{"text":"我思緒煩亂，坐立不安。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"仇敵向我咆哮，","poem":1},{"lineBreak":true},{"text":"惡人迫害我。","poem":1},{"lineBreak":true},{"text":"他們帶給我苦難，","poem":1},{"lineBreak":true},{"text":"怒氣沖沖地攻擊我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我內心悲痛，","poem":1},{"lineBreak":true},{"text":"被死亡的恐怖籠罩。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我嚇得渾身顫慄，驚恐不已。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我說：「但願我像鴿子一樣有翅膀，","poem":1},{"lineBreak":true},{"text":"我好飛去，得享安息。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我要飛到遠方，宿在曠野。（細拉）","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我要趕快躲進避難所，","poem":1},{"lineBreak":true},{"text":"避過暴雨狂風。」","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"主啊，","poem":1},{"lineBreak":true},{"text":"我在城中看見暴力和爭鬥，","poem":1},{"lineBreak":true},{"text":"求你使他們言語混亂。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們晝夜在城牆上出沒，","poem":1},{"lineBreak":true},{"text":"城內充滿了邪惡和壓迫，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"毀壞的勢力在城內肆虐，","poem":1},{"lineBreak":true},{"text":"恐嚇與欺詐遍佈街市。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"倘若是仇敵辱罵我，","poem":1},{"lineBreak":true},{"text":"我還能忍受；","poem":1},{"lineBreak":true},{"text":"倘若是恨我的人欺凌我，","poem":1},{"lineBreak":true},{"text":"我還可以躲開。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"可是，竟然是你，我志同道合的夥伴，我的摯友！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"從前我們情誼深厚，","poem":1},{"lineBreak":true},{"text":"與眾人同去上帝的殿。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"願死亡突然抓住我的仇敵，","poem":1},{"lineBreak":true},{"text":"願他們活活地下陰間，","poem":1},{"lineBreak":true},{"text":"因為他們的內心和家中罪惡充斥。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"但我要呼求上帝，","poem":1},{"lineBreak":true},{"text":"耶和華必拯救我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"晚上、早晨和中午，","poem":1},{"lineBreak":true},{"text":"我痛苦地呼求，","poem":1},{"lineBreak":true},{"text":"祂必垂聽我的聲音。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"雖然許多人攻擊我，","poem":1},{"lineBreak":true},{"text":"祂必救我平安脫險。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"永掌王權的上帝必鑒察並懲罰他們，","poem":1},{"lineBreak":true},{"text":"因為他們頑固不化、不敬畏上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"我的同伴違背盟約，出手攻擊朋友。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他口蜜腹劍，笑裡藏刀。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"把你的重擔卸給耶和華，","poem":1},{"lineBreak":true},{"text":"祂必扶持你。","poem":1},{"lineBreak":true},{"text":"祂絕不讓義人跌倒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"你必把惡人送進滅亡的坑裡。","poem":1},{"lineBreak":true},{"text":"嗜血成性的騙子必早早夭亡。","poem":1},{"lineBreak":true},{"text":"但我要信靠你。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}