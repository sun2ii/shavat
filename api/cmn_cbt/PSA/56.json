{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":56,"content":[{"type":"heading","content":["信靠上帝的禱告"]},{"type":"hebrew_subtitle","content":["大衛作的詩，交給樂長，調用「遠方無聲鴿」，大衛在迦特被非利士人抓住時所作。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你憐憫我，","poem":1},{"lineBreak":true},{"text":"因為仇敵迫害我，整日攻擊我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的仇敵整日迫害我，","poem":1},{"lineBreak":true},{"text":"許多人狂妄地攻擊我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我害怕的時候，","poem":1},{"lineBreak":true},{"text":"就倚靠你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我靠著上帝讚美祂的應許，","poem":1},{"lineBreak":true},{"text":"我信靠上帝，就不懼怕，","poem":1},{"lineBreak":true},{"text":"區區世人能把我怎樣？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們整天歪曲我的話，","poem":1},{"lineBreak":true},{"text":"總是圖謀害我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們勾結起來，","poem":1},{"lineBreak":true},{"text":"暗中監視我的行蹤，","poem":1},{"lineBreak":true},{"text":"伺機害我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"不要讓這些作惡的人逃脫，","poem":1},{"lineBreak":true},{"text":"求你發烈怒毀滅他們。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你記錄我的哀傷，","poem":1},{"lineBreak":true},{"text":"你把我的眼淚收在袋中。","poem":1},{"lineBreak":true},{"text":"我的遭遇都記錄在你的冊子上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我向你求救的時候，","poem":1},{"lineBreak":true},{"text":"敵人都落荒而逃。","poem":1},{"lineBreak":true},{"text":"我知道上帝是我的幫助。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我靠著上帝讚美祂的應許，","poem":1},{"lineBreak":true},{"text":"我靠著耶和華讚美祂的應許。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我信靠上帝，就不懼怕，","poem":1},{"lineBreak":true},{"text":"區區世人能把我怎樣？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"我要恪守向你發的誓言，","poem":1},{"lineBreak":true},{"text":"獻上感恩祭。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因為你救我脫離死亡，","poem":1},{"lineBreak":true},{"text":"使我沒有跌倒，","poem":1},{"lineBreak":true},{"text":"讓我可以活在你面前，","poem":1},{"lineBreak":true},{"text":"沐浴生命之光。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}