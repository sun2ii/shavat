{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":57,"content":[{"type":"heading","content":["被圍困中的呼求"]},{"type":"hebrew_subtitle","content":["大衛作的詩，交給樂長，調用「休要毀壞」。當時他因逃避掃羅躲進了洞裡。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你憐憫我，憐憫我，","poem":1},{"lineBreak":true},{"text":"因為我投靠你。","poem":1},{"lineBreak":true},{"text":"我要在你翅膀下得到蔭庇，","poem":1},{"lineBreak":true},{"text":"直到災難結束。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我向至高的上帝，","poem":1},{"lineBreak":true},{"text":"向為我成就一切的上帝呼求。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝從天上施助、拯救我，","poem":1},{"lineBreak":true},{"text":"使迫害我的人蒙羞。（細拉）","poem":1},{"lineBreak":true},{"text":"上帝必彰顯祂的慈愛和信實。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我被獅子包圍，","poem":1},{"lineBreak":true},{"text":"躺臥在吃人的野獸中。","poem":1},{"lineBreak":true},{"text":"他們的牙齒是矛和箭，","poem":1},{"lineBreak":true},{"text":"舌頭是尖刀。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝啊，願你受的尊崇超過諸天，","poem":1},{"lineBreak":true},{"text":"願你的榮耀覆蓋大地。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的仇敵設下網羅，","poem":1},{"lineBreak":true},{"text":"我心中沮喪。","poem":1},{"lineBreak":true},{"text":"他們在我走的路上挖了陷阱，","poem":1},{"lineBreak":true},{"text":"自己卻掉了進去。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"上帝啊，我心堅定，我心堅定，","poem":1},{"lineBreak":true},{"text":"我要唱詩歌頌你。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的心啊，醒來吧！","poem":1},{"lineBreak":true},{"text":"琴瑟啊，醒來吧！","poem":1},{"lineBreak":true},{"text":"我要喚醒黎明！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"主啊，我要在列邦稱謝你，","poem":1},{"lineBreak":true},{"text":"在列國歌頌你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因為你的慈愛高達諸天，","poem":1},{"lineBreak":true},{"text":"你的信實廣及穹蒼。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝啊，願你受的尊崇超過諸天，","poem":1},{"lineBreak":true},{"text":"願你的榮耀覆蓋大地。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}