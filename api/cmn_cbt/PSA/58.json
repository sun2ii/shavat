{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":58,"content":[{"type":"heading","content":["祈求上帝懲罰惡人"]},{"type":"hebrew_subtitle","content":["大衛作的詩，交給樂長，調用「休要毀壞」。"]},{"type":"verse","number":1,"content":[{"text":"你們做官長的主持公道嗎？","poem":1},{"lineBreak":true},{"text":"你們的審判公正嗎？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"不，你們心中圖謀不義，","poem":1},{"lineBreak":true},{"text":"你們在地上行兇作惡。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"惡人生下來就步入歧途，","poem":1},{"lineBreak":true},{"text":"一出母胎就離開正道，","poem":1},{"lineBreak":true},{"text":"謊話連篇。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們惡毒如蛇，","poem":1},{"lineBreak":true},{"text":"像耳聾的眼鏡蛇，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"任法師的邪術再高超，","poem":1},{"lineBreak":true},{"text":"也聽不見他的咒語。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"上帝啊，求你敲碎他們的牙齒；","poem":1},{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你拔掉這些猛獅的利齒。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"願他們如流水逝去，","poem":1},{"lineBreak":true},{"text":"願他們彎弓搭箭時箭頭折斷。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"願他們像蝸牛一樣溶為爛泥，","poem":1},{"lineBreak":true},{"text":"又如未見天日就流產的胎兒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"刹那間，荊棘還沒有把鍋燒熱的工夫，","poem":1},{"lineBreak":true},{"text":"上帝必全然除滅他們。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"義人必因見惡人遭報而歡欣，","poem":1},{"lineBreak":true},{"text":"並用惡人的血洗腳。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"這樣，人們必說：","poem":1},{"lineBreak":true},{"text":"「義人終有善報，","poem":1},{"lineBreak":true},{"text":"確實有一位審判天下的上帝。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}