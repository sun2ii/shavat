{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":59,"content":[{"type":"heading","content":["祈求上帝佑護"]},{"type":"hebrew_subtitle","content":["大衛作的詩，交給樂長，調用「休要毀壞」。當時掃羅派人去監視大衛的家，要殺害大衛。"]},{"type":"verse","number":1,"content":[{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你救我脫離仇敵，","poem":1},{"lineBreak":true},{"text":"保護我免遭敵人的攻擊。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你救我脫離作惡之徒，","poem":1},{"lineBreak":true},{"text":"救我脫離嗜血成性之人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"看啊，他們埋伏害我。","poem":1},{"lineBreak":true},{"text":"耶和華啊，我並未犯罪作惡，","poem":1},{"lineBreak":true},{"text":"兇殘的人卻攻擊我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我沒有過錯，","poem":1},{"lineBreak":true},{"text":"他們卻準備攻擊我。","poem":1},{"lineBreak":true},{"text":"求你起來幫助我，","poem":1},{"lineBreak":true},{"text":"顧念我的困境。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"萬軍之耶和華，以色列的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你起來懲罰列國，","poem":1},{"lineBreak":true},{"text":"不要憐憫奸詐的惡人。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"他們夜晚回來，","poem":1},{"lineBreak":true},{"text":"嚎叫如狗，在城中遊蕩。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們出口傷人，舌如利劍，","poem":1},{"lineBreak":true},{"text":"還說：「誰聽得見？」","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"但你耶和華必嗤笑他們，","poem":1},{"lineBreak":true},{"text":"嘲諷列國。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"你是我的力量，我的堡壘，","poem":1},{"lineBreak":true},{"text":"我仰望你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的上帝以慈愛待我，","poem":1},{"lineBreak":true},{"text":"祂會幫助我，","poem":1},{"lineBreak":true},{"text":"讓我欣然看見仇敵遭報。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"保護我們的主啊，","poem":1},{"lineBreak":true},{"text":"求你不要殺掉他們，","poem":1},{"lineBreak":true},{"text":"免得我的百姓忘記教訓。","poem":1},{"lineBreak":true},{"text":"求你用你的能力驅散他們，","poem":1},{"lineBreak":true},{"text":"使他們淪為卑賤。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們的嘴巴充滿罪惡，","poem":1},{"lineBreak":true},{"text":"口中盡是咒詛和謊言，","poem":1},{"lineBreak":true},{"text":"願他們陷在狂傲中不能自拔。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"求你發烈怒毀滅他們，","poem":1},{"lineBreak":true},{"text":"徹底剷除他們，","poem":1},{"lineBreak":true},{"text":"使普天下都知道上帝在雅各家掌權。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"他們夜晚回來，","poem":1},{"lineBreak":true},{"text":"嚎叫如狗，在城中遊蕩，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"四處覓食，","poem":1},{"lineBreak":true},{"text":"吃不飽就狂吠不止。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"但我要歌頌你的能力，","poem":1},{"lineBreak":true},{"text":"在清晨頌揚你的慈愛，","poem":1},{"lineBreak":true},{"text":"因為你是我的堡壘，","poem":1},{"lineBreak":true},{"text":"是我患難時的避難所。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"上帝啊，你是我的力量，","poem":1},{"lineBreak":true},{"text":"我要頌讚你，","poem":1},{"lineBreak":true},{"text":"你是我的堡壘，","poem":1},{"lineBreak":true},{"text":"是以慈愛待我的上帝。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}