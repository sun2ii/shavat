{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":6,"content":[{"type":"heading","content":["患難中祈求憐憫"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長，用弦樂器。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你不要憤然責備我，","poem":1},{"lineBreak":true},{"text":"不要發烈怒懲罰我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華啊，求你憐憫，","poem":1},{"lineBreak":true},{"text":"因為我軟弱無力。","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你醫治，","poem":1},{"lineBreak":true},{"text":"因為我痛徹入骨。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我心中惶恐不安，","poem":1},{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"你讓我這樣要到何時呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華啊，求你回來救我，","poem":1},{"lineBreak":true},{"text":"因你的慈愛而拯救我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因為死去的人不會記得你，","poem":1},{"lineBreak":true},{"text":"誰會在陰間讚美你呢？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我因哀歎心力交瘁，","poem":1},{"lineBreak":true},{"text":"夜夜哭泣，淚漂床榻，","poem":1},{"lineBreak":true},{"text":"濕透被褥。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的眼睛因憂愁而模糊，","poem":1},{"lineBreak":true},{"text":"因敵人環伺而昏花。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你們所有作惡的人，快走開！","poem":1},{"lineBreak":true},{"text":"因為耶和華已經聽見我的哭聲。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華聽見了我的懇求，","poem":1},{"lineBreak":true},{"text":"祂必悅納我的禱告。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我所有的仇敵都必羞愧，","poem":1},{"lineBreak":true},{"text":"驚恐不已；","poem":1},{"lineBreak":true},{"text":"他們必忽然蒙羞，","poem":1},{"lineBreak":true},{"text":"掉頭逃竄。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}