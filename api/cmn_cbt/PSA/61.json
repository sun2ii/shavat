{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":61,"content":[{"type":"heading","content":["祈求上帝保護"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長，用弦樂器。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你傾聽我的呼求，","poem":1},{"lineBreak":true},{"text":"垂聽我的禱告！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我心力憔悴時，","poem":1},{"lineBreak":true},{"text":"從地極呼求你，","poem":1},{"lineBreak":true},{"text":"求你領我到高高的磐石上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為你是我的避難所，","poem":1},{"lineBreak":true},{"text":"是抗擊仇敵的堅壘。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要永遠住在你的帳幕裡，","poem":1},{"lineBreak":true},{"text":"在你翅膀下得蔭庇！（細拉）","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝啊，你已經聽見我的誓言，","poem":1},{"lineBreak":true},{"text":"把你賜給敬畏你名之人的產業賜給我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你延長王的壽命，","poem":1},{"lineBreak":true},{"text":"使他的年日恆久。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"願他在你的護佑下永遠做王，","poem":1},{"lineBreak":true},{"text":"求你以慈愛和信實來保護他。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"這樣，我要永遠歌頌你的名，","poem":1},{"lineBreak":true},{"text":"天天還我許的願。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}