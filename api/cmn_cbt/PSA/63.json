{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":63,"content":[{"type":"heading","content":["渴慕上帝"]},{"type":"hebrew_subtitle","content":["大衛在猶大曠野時作的詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，你是我的上帝，","poem":1},{"lineBreak":true},{"text":"我迫切地尋求你！","poem":1},{"lineBreak":true},{"text":"在乾旱、枯竭、無水之地，","poem":1},{"lineBreak":true},{"text":"我的身心渴慕你，切望你！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我曾在你的聖所瞻仰你，","poem":1},{"lineBreak":true},{"text":"目睹你的權能和榮耀。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的慈愛勝過生命，","poem":1},{"lineBreak":true},{"text":"我的嘴唇要讚美你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我一生都要讚美你，","poem":1},{"lineBreak":true},{"text":"奉你的名舉手禱告。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我心滿意足，如享盛宴，","poem":1},{"lineBreak":true},{"text":"我歡然開口讚美你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我躺在床上的時候思念你，","poem":1},{"lineBreak":true},{"text":"整夜地思想你。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因為你是我的幫助，","poem":1},{"lineBreak":true},{"text":"我在你翅膀的蔭下歡歌。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的心依戀你，","poem":1},{"lineBreak":true},{"text":"你的右手扶持我。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"那些要害我的人必下到地的深處。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們必喪身刀下，","poem":1},{"lineBreak":true},{"text":"成為豺狼的食物。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"但王要因上帝而歡欣，","poem":1},{"lineBreak":true},{"text":"凡靠祂起誓的人必歡喜，","poem":1},{"lineBreak":true},{"text":"說謊者的口必被封住。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}