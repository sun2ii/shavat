{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":64,"content":[{"type":"heading","content":["祈求上帝的保護"]},{"type":"hebrew_subtitle","content":["大衛作的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你傾聽我的苦訴，","poem":1},{"lineBreak":true},{"text":"求你保護我的性命不受仇敵的威脅。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你保護我免遭惡人的謀害，","poem":1},{"lineBreak":true},{"text":"使我脫離作惡之徒。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們舌頭鋒利如刀，","poem":1},{"lineBreak":true},{"text":"言語惡毒，猶如利箭。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們埋伏起來，","poem":1},{"lineBreak":true},{"text":"暗箭傷害純全無過的人。","poem":1},{"lineBreak":true},{"text":"他們突然襲擊，毫無顧忌。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們朋比為奸，","poem":1},{"lineBreak":true},{"text":"商量暗設網羅，","poem":1},{"lineBreak":true},{"text":"以為誰也看不見。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們圖謀不義之事，","poem":1},{"lineBreak":true},{"text":"認為策劃得無懈可擊。","poem":1},{"lineBreak":true},{"text":"人心真是狡猾。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"但上帝必用箭射他們，","poem":1},{"lineBreak":true},{"text":"將他們突然射傷。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們必自作自受，","poem":1},{"lineBreak":true},{"text":"被自己的舌頭所害。","poem":1},{"lineBreak":true},{"text":"看見的人都連連搖頭。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"這樣，人人必敬畏上帝，","poem":1},{"lineBreak":true},{"text":"傳揚祂奇妙的作為，","poem":1},{"lineBreak":true},{"text":"思想祂所做的事。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"義人必因耶和華而歡欣，","poem":1},{"lineBreak":true},{"text":"並且投靠祂，","poem":1},{"lineBreak":true},{"text":"心地正直的人必歡喜。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}