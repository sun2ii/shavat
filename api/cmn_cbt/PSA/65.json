{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":65,"content":[{"type":"heading","content":["讚美和感恩"]},{"type":"hebrew_subtitle","content":["大衛作的詩歌，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，人們在錫安讚美你，","poem":1},{"lineBreak":true},{"text":"向你履行誓言。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你垂聽禱告，","poem":1},{"lineBreak":true},{"text":"世人都來到你面前。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我們深陷罪中之時，","poem":1},{"lineBreak":true},{"text":"你赦免我們的過犯。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"蒙你揀選、","poem":1},{"lineBreak":true},{"text":"能住在你聖所的人有福了！","poem":1},{"lineBreak":true},{"text":"我們因你所居聖殿的美好而滿足。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"拯救我們的上帝啊，","poem":1},{"lineBreak":true},{"text":"你憑公義、行可畏之事來應允我們的祈求。","poem":1},{"lineBreak":true},{"text":"你是天涯海角普世人的盼望。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你充滿力量，以大能創造群山，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"又平息怒海狂濤，","poem":1},{"lineBreak":true},{"text":"止息列邦的喧囂。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你奇妙的作為使遠在地極的人心生敬畏，","poem":1},{"lineBreak":true},{"text":"你使日出之地和日落之處都傳來歡呼聲。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你眷顧大地，降下沛雨，","poem":1},{"lineBreak":true},{"text":"使土地肥沃富饒。","poem":1},{"lineBreak":true},{"text":"上帝啊，你的江河滿溢，","poem":1},{"lineBreak":true},{"text":"澆灌大地，為世人預備五穀。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你降下甘霖，澆透壟溝，","poem":1},{"lineBreak":true},{"text":"滋潤壟背，使地鬆軟，","poem":1},{"lineBreak":true},{"text":"恩澤莊稼。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你賜下豐年福月，","poem":1},{"lineBreak":true},{"text":"你的腳蹤恩澤滿溢。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"曠野的草地生機盎然，","poem":1},{"lineBreak":true},{"text":"山嶺間充滿歡樂，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"草場遍佈羊群，","poem":1},{"lineBreak":true},{"text":"谷中長滿莊稼，","poem":1},{"lineBreak":true},{"text":"處處歡歌笑語。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}