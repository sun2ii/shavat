{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":66,"content":[{"type":"heading","content":["頌讚與感恩"]},{"type":"hebrew_subtitle","content":["一首詩歌，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"普世啊，你們要向上帝歡呼，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"頌讚祂榮耀的名，","poem":1},{"lineBreak":true},{"text":"獻給祂榮耀的讚美。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要對上帝說：「你的作為令人敬畏！","poem":1},{"lineBreak":true},{"text":"你的大能使敵人屈膝投降。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"普天下都敬拜你，","poem":1},{"lineBreak":true},{"text":"頌讚你，頌讚你的名。」（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你們來看看上帝的作為，","poem":1},{"lineBreak":true},{"text":"祂為世人行了可畏之事！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂將滄海變為乾地，","poem":1},{"lineBreak":true},{"text":"讓百姓步行經過。","poem":1},{"lineBreak":true},{"text":"讓我們因祂而歡欣吧！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂以大能永遠掌權，","poem":1},{"lineBreak":true},{"text":"祂的眼目鑒察列國，","poem":1},{"lineBreak":true},{"text":"悖逆之徒不可在祂面前妄自尊大。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"列邦啊，要讚美我們的上帝，","poem":1},{"lineBreak":true},{"text":"讓歌頌祂的聲音四處飄揚。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂保全我們的生命，","poem":1},{"lineBreak":true},{"text":"不讓我們失腳滑倒。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，你試驗我們，","poem":1},{"lineBreak":true},{"text":"熬煉我們如熬煉銀子。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你讓我們陷入網羅，","poem":1},{"lineBreak":true},{"text":"把重擔壓在我們的背上。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你讓人騎在我們的頭上。","poem":1},{"lineBreak":true},{"text":"我們曾經歷水火，","poem":1},{"lineBreak":true},{"text":"但你帶我們到達豐盛之地。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我要帶著燔祭來到你殿中，","poem":1},{"lineBreak":true},{"text":"履行我向你許的誓言，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"就是我在危難中開口許下的誓言。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要獻上肥美的牲畜，","poem":1},{"lineBreak":true},{"text":"以公綿羊作馨香之祭獻給你，","poem":1},{"lineBreak":true},{"text":"我要獻上公牛和山羊。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"敬畏上帝的人啊，你們都來聽吧，","poem":1},{"lineBreak":true},{"text":"我要告訴你們祂為我所做的事。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我曾開口向祂呼求，","poem":1},{"lineBreak":true},{"text":"嘴中揚聲讚美祂。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"倘若我心中藏匿罪惡，","poem":1},{"lineBreak":true},{"text":"主必不垂聽我的呼求。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"然而，上帝聽了我的禱告，","poem":1},{"lineBreak":true},{"text":"傾聽了我的祈求。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"上帝當受稱頌！","poem":1},{"lineBreak":true},{"text":"祂沒有對我的禱告拒而不聽，","poem":1},{"lineBreak":true},{"text":"也沒有收回祂對我的慈愛。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}