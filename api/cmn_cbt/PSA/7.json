{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":7,"content":[{"type":"heading","content":["求上帝伸張正義"]},{"type":"hebrew_subtitle","content":["大衛向耶和華唱的流離歌，與便雅憫人古實有關。"]},{"type":"verse","number":1,"content":[{"text":"我的上帝耶和華啊，我投靠你，","poem":1},{"lineBreak":true},{"text":"求你拯救我脫離追趕我的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"免得他們像獅子般撕裂我，把我撕碎，","poem":1},{"lineBreak":true},{"text":"無人搭救。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"倘若我犯了罪，","poem":1},{"lineBreak":true},{"text":"手上沾了不義；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"倘若我恩將仇報，","poem":1},{"lineBreak":true},{"text":"無故搶奪仇敵，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"就讓仇敵追趕我，直到追上，","poem":1},{"lineBreak":true},{"text":"把我的性命踐踏在土中，使我聲名掃地。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你發怒攻擊我暴怒的仇敵。","poem":1},{"lineBreak":true},{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你醒來，為我伸張正義。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"願萬民都環繞你，","poem":1},{"lineBreak":true},{"text":"願你從高天治理他們，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"願你審判萬民！","poem":1},{"lineBreak":true},{"text":"至高的耶和華啊，","poem":1},{"lineBreak":true},{"text":"我是公義正直的，","poem":1},{"lineBreak":true},{"text":"求你為我主持公道。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"鑒察人心肺腑的公義上帝啊，","poem":1},{"lineBreak":true},{"text":"求你剷除邪惡，扶持義人。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝是我的盾牌，","poem":1},{"lineBreak":true},{"text":"祂拯救心地正直的人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝是公義的審判官，","poem":1},{"lineBreak":true},{"text":"天天向惡人發怒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們若不悔改，祂必磨刀霍霍，","poem":1},{"lineBreak":true},{"text":"彎弓搭箭。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂準備好了奪命的兵器，","poem":1},{"lineBreak":true},{"text":"火箭已在弦上。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"惡人心懷惡念，","poem":1},{"lineBreak":true},{"text":"居心叵測，滋生虛謊。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他們挖了陷阱，卻自陷其中。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他們的惡行回到自己頭上，","poem":1},{"lineBreak":true},{"text":"他們的暴力落到自己腦殼上。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我要因耶和華公義而稱謝祂，","poem":1},{"lineBreak":true},{"text":"我要歌頌至高者耶和華的名。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}