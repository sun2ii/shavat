{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":71,"content":[{"type":"heading","content":["一個老年人的祈禱"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我投靠你，","poem":1},{"lineBreak":true},{"text":"求你讓我永不蒙羞。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你憑公義解救我，搭救我，","poem":1},{"lineBreak":true},{"text":"側耳聽我的呼求，拯救我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"求你作我避難的磐石，","poem":1},{"lineBreak":true},{"text":"讓我可以隨時投靠你。","poem":1},{"lineBreak":true},{"text":"求你下令救我，","poem":1},{"lineBreak":true},{"text":"因為你是我的磐石，我的堡壘。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你從惡人手中拯救我，","poem":1},{"lineBreak":true},{"text":"從邪惡、殘暴之徒掌下拯救我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"主耶和華啊，你是我的盼望，","poem":1},{"lineBreak":true},{"text":"我從小就信靠你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你使我出了母胎，","poem":1},{"lineBreak":true},{"text":"我從出生就依靠你，","poem":1},{"lineBreak":true},{"text":"我要永遠讚美你。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的遭遇使許多人感到驚駭，","poem":1},{"lineBreak":true},{"text":"但你是我堅固的避難所。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我口中充滿對你的讚美，","poem":1},{"lineBreak":true},{"text":"終日述說你的榮耀。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我年老時，求你不要丟棄我；","poem":1},{"lineBreak":true},{"text":"我體力衰微時，求你不要離棄我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因為我的仇敵議論我，","poem":1},{"lineBreak":true},{"text":"那些想殺害我的一起策劃陰謀，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"說：「上帝已經丟棄了他。","poem":1},{"lineBreak":true},{"text":"你們去追趕、捉拿他吧，","poem":1},{"lineBreak":true},{"text":"因為無人會救他。」","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"上帝啊，不要遠離我；","poem":1},{"lineBreak":true},{"text":"我的上帝啊，求你快來幫助我！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"願我的仇敵在羞辱中滅亡，","poem":1},{"lineBreak":true},{"text":"願那些害我的人抱愧蒙羞。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我必常常心懷盼望，","poem":1},{"lineBreak":true},{"text":"向你獻上更多讚美。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我雖然無法測度，","poem":1},{"lineBreak":true},{"text":"但必終日傳揚你的公義和拯救之恩。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"主耶和華啊，","poem":1},{"lineBreak":true},{"text":"我要傳揚你大能的作為，","poem":1},{"lineBreak":true},{"text":"單單述說你的公義。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"我從小就受你的教導，","poem":1},{"lineBreak":true},{"text":"直到今日我仍傳揚你奇妙的作為。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"就是我年老髮白的時候，","poem":1},{"lineBreak":true},{"text":"求你也不要丟棄我，","poem":1},{"lineBreak":true},{"text":"好讓我把你的大能告訴下一代，","poem":1},{"lineBreak":true},{"text":"把你的能力講給後人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"上帝啊，你的公義高達穹蒼，","poem":1},{"lineBreak":true},{"text":"你成就了奇妙大事。","poem":1},{"lineBreak":true},{"text":"上帝啊，有誰能像你？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你使我經歷了許多患難，","poem":1},{"lineBreak":true},{"text":"最終必使我重獲新生，","poem":1},{"lineBreak":true},{"text":"把我從大地深處救上來。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你必賜我更大的尊榮，","poem":1},{"lineBreak":true},{"text":"你必再次安慰我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我的上帝啊，","poem":1},{"lineBreak":true},{"text":"我要彈琴讚美你的信實；","poem":1},{"lineBreak":true},{"text":"以色列的聖者啊，","poem":1},{"lineBreak":true},{"text":"我要伴隨著琴聲讚美你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你救贖了我的靈魂，","poem":1},{"lineBreak":true},{"text":"我的口和靈魂都要歡呼歌頌你。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我要終日向人述說你的公義，","poem":1},{"lineBreak":true},{"text":"因為那些想害我的人已經蒙羞受辱。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}