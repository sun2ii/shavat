{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":72,"content":[{"type":"heading","content":["為君王祈禱"]},{"type":"hebrew_subtitle","content":["所羅門的詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"求你將你的公正賜給王，","poem":1},{"lineBreak":true},{"text":"將你的公義賜給王的兒子。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"讓他憑公義審判你的子民，","poem":1},{"lineBreak":true},{"text":"按公平對待那些貧苦的人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"願大山給百姓帶來繁榮，","poem":1},{"lineBreak":true},{"text":"小山帶來公義。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"願他為百姓中受苦的人主持公道，","poem":1},{"lineBreak":true},{"text":"拯救貧窮的人，打倒欺壓者。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"只要日月尚存，","poem":1},{"lineBreak":true},{"text":"願百姓世世代代敬畏你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"願他的統治如春雨降在新割過的草場上，","poem":1},{"lineBreak":true},{"text":"又像甘霖滋潤大地。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"在他統治之下，","poem":1},{"lineBreak":true},{"text":"願義人興旺，國富民強，","poem":1},{"lineBreak":true},{"text":"如月長存。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"願他的疆域橫跨洋海，","poem":1},{"lineBreak":true},{"text":"從幼發拉底河直到地極。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"願曠野的居民都來向他下拜，","poem":1},{"lineBreak":true},{"text":"敵人都仆倒在塵土中。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"願他施和海島的君王都納貢稱臣，","poem":1},{"lineBreak":true},{"text":"願示巴和西巴的君王都獻上禮物。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"願君王都敬拜他，","poem":1},{"lineBreak":true},{"text":"萬國都事奉他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"貧窮人呼求，他便搭救；","poem":1},{"lineBreak":true},{"text":"困苦人無助，他就伸出援手。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他憐憫軟弱和貧困的人，","poem":1},{"lineBreak":true},{"text":"拯救貧困人的性命。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他要救他們脫離壓迫和暴力，","poem":1},{"lineBreak":true},{"text":"因為他愛惜他們的生命。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"願王壽命長久，","poem":1},{"lineBreak":true},{"text":"願人將示巴的金子獻給他，","poem":1},{"lineBreak":true},{"text":"願人不斷為他禱告，終日祝福他。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"願遍地五穀豐登，","poem":1},{"lineBreak":true},{"text":"山頂上晃動著累累果實，","poem":1},{"lineBreak":true},{"text":"如黎巴嫩的密林。","poem":1},{"lineBreak":true},{"text":"願各城人口稠密如原野的青草。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"願他的名流芳百世，如日長存。","poem":1},{"lineBreak":true},{"text":"願萬國都因他而蒙福，","poem":1},{"lineBreak":true},{"text":"並稱他是有福的。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"以色列的上帝耶和華當受稱頌，","poem":1},{"lineBreak":true},{"text":"唯有祂行奇妙的事。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"願祂榮耀的名永受稱頌！","poem":1},{"lineBreak":true},{"text":"願普天下充滿祂的榮耀。","poem":1},{"lineBreak":true},{"text":"阿們！阿們！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶西的兒子大衛的禱告結束。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}