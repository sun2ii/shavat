{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":73,"content":[{"type":"heading","content":["上帝的公正審判"]},{"type":"hebrew_subtitle","content":["亞薩的詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝實在善待以色列人，","poem":1},{"lineBreak":true},{"text":"恩待那些內心純潔的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我卻身陷險地，","poem":1},{"lineBreak":true},{"text":"幾乎失腳跌倒。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我看見狂傲的惡人亨通就心懷不平。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們一生平順，健康強壯。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們不像別人受苦，","poem":1},{"lineBreak":true},{"text":"不像世人遭難。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們把驕傲作項鏈戴在頸上，","poem":1},{"lineBreak":true},{"text":"把暴力作外袍裹在身上。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們胖得眼睛凸出，","poem":1},{"lineBreak":true},{"text":"心中充滿罪惡。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們譏諷嘲笑，言語惡毒，","poem":1},{"lineBreak":true},{"text":"狂言恫嚇脅迫。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們的口褻瀆上天，","poem":1},{"lineBreak":true},{"text":"舌頭詆譭大地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝的子民也跟隨他們，","poem":1},{"lineBreak":true},{"text":"喝盡他們杯中的水。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們說：","poem":1},{"lineBreak":true},{"text":"「上帝怎能知道？","poem":1},{"lineBreak":true},{"text":"至高者會察覺嗎？」","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"看這些惡人，","poem":1},{"lineBreak":true},{"text":"他們總是生活安逸，財富日增。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我潔身自愛，保持清白，","poem":1},{"lineBreak":true},{"text":"實屬徒然。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我天天遭災，日日受罰。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"要是我這樣說，","poem":1},{"lineBreak":true},{"text":"我就是背叛了你的子民。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我想明白這一切，","poem":1},{"lineBreak":true},{"text":"卻百思不得其解。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"直到我進入你的聖所，","poem":1},{"lineBreak":true},{"text":"才明白他們的結局。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你確實把他們放在容易滑倒的地方，","poem":1},{"lineBreak":true},{"text":"使他們落入毀滅中。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他們頃刻間被毀滅，","poem":1},{"lineBreak":true},{"text":"在恐怖中徹底滅亡。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他們如同人醒後的一場夢。","poem":1},{"lineBreak":true},{"text":"主啊，你起來必視他們如幻夢。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我曾感到悲傷，心如刀絞。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我當時愚昧無知，","poem":1},{"lineBreak":true},{"text":"在你面前如畜類。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"然而，我一直和你在一起，","poem":1},{"lineBreak":true},{"text":"你牽著我的右手引導我。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你以諄諄教誨指引我，","poem":1},{"lineBreak":true},{"text":"以後必接我到榮耀中。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"除你以外，在天上我還有誰？","poem":1},{"lineBreak":true},{"text":"除你以外，在地上我別無愛慕。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"儘管我身心俱衰，","poem":1},{"lineBreak":true},{"text":"上帝永遠是我心中的力量，","poem":1},{"lineBreak":true},{"text":"是我永遠的福分。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"那些遠離你的人必滅亡，","poem":1},{"lineBreak":true},{"text":"你必滅絕不忠於你的人。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"親近上帝對我而言何等美好。","poem":1},{"lineBreak":true},{"text":"我以主耶和華為我的避難所，","poem":1},{"lineBreak":true},{"text":"並宣揚祂的一切作為。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}