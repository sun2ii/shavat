{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":74,"content":[{"type":"heading","content":["祈求上帝眷顧祂的子民"]},{"type":"hebrew_subtitle","content":["亞薩的訓誨詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"你為何永遠丟棄了我們？","poem":1},{"lineBreak":true},{"text":"你為何對自己草場上的羊大發雷霆？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你眷顧你古時買贖的子民，","poem":1},{"lineBreak":true},{"text":"你救贖為產業的族類，","poem":1},{"lineBreak":true},{"text":"求你眷顧你所居住的錫安山。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"求你前往那久已荒廢之地，","poem":1},{"lineBreak":true},{"text":"看看敵人對聖所的破壞。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的仇敵在你的聖所咆哮，","poem":1},{"lineBreak":true},{"text":"他們豎立起自己的旗幟。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們大肆毀壞，","poem":1},{"lineBreak":true},{"text":"好像人掄起斧頭砍伐樹林。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們用斧頭、錘子把雕刻的牆板都搗毀了。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們縱火焚燒你的聖所，","poem":1},{"lineBreak":true},{"text":"把它夷為平地，","poem":1},{"lineBreak":true},{"text":"褻瀆了你的居所。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們心裡說：「我們要全部摧毀。」","poem":1},{"lineBreak":true},{"text":"於是他們燒毀了境內所有敬拜上帝的地方。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我們再也看不到你的徵兆，","poem":1},{"lineBreak":true},{"text":"先知也沒有了。","poem":1},{"lineBreak":true},{"text":"無人知道這一切何時才會結束。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"仇敵嘲笑你的名要到何時呢？","poem":1},{"lineBreak":true},{"text":"他們要永無休止地辱罵你嗎？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你為何不伸出大能的右手？","poem":1},{"lineBreak":true},{"text":"求你出手給他們致命的一擊。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"上帝自古以來就是我的王，","poem":1},{"lineBreak":true},{"text":"祂給世上帶來拯救。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你曾用大能分開海水，","poem":1},{"lineBreak":true},{"text":"打碎水中巨獸的頭。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你曾打碎海怪的頭，","poem":1},{"lineBreak":true},{"text":"把牠丟給曠野的禽獸吃。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你曾開闢泉源和溪流，","poem":1},{"lineBreak":true},{"text":"也曾使滔滔河水枯乾。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"白晝和黑夜都屬於你，","poem":1},{"lineBreak":true},{"text":"你設立了日月。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你劃定地上的疆界，","poem":1},{"lineBreak":true},{"text":"又創造盛夏和寒冬。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你記住敵人對你的嘲笑和愚妄人對你的褻瀆。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"求你不要把你的子民交給仇敵","poem":1},{"noteId":4},{"text":"，","poem":1},{"lineBreak":true},{"text":"不要永遠忘記你受苦的子民。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"求你顧念你立的約，","poem":1},{"lineBreak":true},{"text":"因地上黑暗之處充滿了暴力。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"求你不要讓受壓迫的人羞愧而去。","poem":1},{"lineBreak":true},{"text":"願貧窮困苦的人讚美你的名。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"上帝啊，求你起來維護自己，","poem":1},{"lineBreak":true},{"text":"別忘記愚妄人怎樣整天嘲笑你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"不要忽視你仇敵的喧嚷，","poem":1},{"lineBreak":true},{"text":"或者你對頭的連連叫囂。","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"「子民」希伯來文是「鴿子」；「仇敵」希伯來文是「野獸」。","reference":{"chapter":74,"verse":19}}]},"thisChapterLink":"/api/cmn_cbt/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}