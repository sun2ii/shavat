{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":75,"content":[{"type":"heading","content":["上帝是審判者"]},{"type":"hebrew_subtitle","content":["亞薩的詩，交給樂長，調用「休要毀壞」。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"我們稱謝你，我們稱謝你，","poem":1},{"lineBreak":true},{"text":"因為你與我們同在。","poem":1},{"lineBreak":true},{"text":"人們都述說你奇妙的作為。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你說：「我已定好時間，","poem":1},{"lineBreak":true},{"text":"我必秉公審判。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"大地和世人顫抖的時候，","poem":1},{"lineBreak":true},{"text":"是我使地的根基穩固。（細拉）","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我警告狂妄人不要再狂傲，","poem":1},{"lineBreak":true},{"text":"告誡惡人不要再張狂。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"不要再狂妄自大，","poem":1},{"lineBreak":true},{"text":"不要說話傲氣沖天。」","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"人的尊貴不是來自東方，","poem":1},{"lineBreak":true},{"text":"不是來自西方，","poem":1},{"lineBreak":true},{"text":"也不是來自曠野。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"決定人尊貴的是上帝：","poem":1},{"lineBreak":true},{"text":"祂提升這個，貶抑那個。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華手中的杯裡盛滿泛著泡沫、精心調製的怒酒。","poem":1},{"lineBreak":true},{"text":"祂倒出怒酒，讓世上的惡人喝得一滴不剩。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我要永遠宣揚祂的作為，","poem":1},{"lineBreak":true},{"text":"我要頌讚雅各的上帝。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝必剷除惡人的勢力，","poem":1},{"lineBreak":true},{"text":"使義人充滿力量。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}