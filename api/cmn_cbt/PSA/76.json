{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":76,"content":[{"type":"heading","content":["上帝是勝利者"]},{"type":"hebrew_subtitle","content":["亞薩的詩歌，交給樂長，用弦樂器。"]},{"type":"verse","number":1,"content":[{"text":"上帝在猶大人人皆知，","poem":1},{"lineBreak":true},{"text":"在以色列威名遠揚。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"祂的住處在撒冷，","poem":1},{"lineBreak":true},{"text":"祂的居所在錫安。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂在那裡摧毀敵人的火箭、","poem":1},{"lineBreak":true},{"text":"盾牌和刀劍等兵器。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"上帝啊，你榮耀無比，","poem":1},{"lineBreak":true},{"text":"你的威嚴超過盛產獵物的群山。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"強敵被擄掠，他們倒地而亡，","poem":1},{"lineBreak":true},{"text":"勇士都無還手之力。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"雅各的上帝啊，你一斥責，","poem":1},{"lineBreak":true},{"text":"他們就人仰馬翻。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"唯有你當受敬畏。","poem":1},{"lineBreak":true},{"text":"你發怒的時候，","poem":1},{"lineBreak":true},{"text":"誰能在你面前站立呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"上帝啊，","poem":1},{"lineBreak":true},{"text":"你從天上宣告審判。","poem":1},{"lineBreak":true},{"text":"你施行審判，","poem":1},{"lineBreak":true},{"text":"拯救世上一切受苦之人時，","poem":1},{"lineBreak":true},{"text":"大地一片恐懼靜默。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你向人類發怒帶給你榮耀，","poem":1},{"lineBreak":true},{"text":"你要發盡你的烈怒。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你們要向你們的上帝耶和華許願、還願，","poem":1},{"lineBreak":true},{"text":"願四周的鄰邦都帶禮物來獻給當受敬畏的主。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂挫敗首領的傲氣，","poem":1},{"lineBreak":true},{"text":"世上的君王都敬畏祂。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":11}