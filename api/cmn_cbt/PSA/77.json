{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":77,"content":[{"type":"heading","content":["患難中的安慰"]},{"type":"hebrew_subtitle","content":["亞薩的詩，照耶杜頓的做法，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"我呼求上帝，我高聲呼求，","poem":1},{"lineBreak":true},{"text":"上帝垂聽我的禱告。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在困境中尋求主。","poem":1},{"lineBreak":true},{"text":"我整夜舉手禱告，","poem":1},{"lineBreak":true},{"text":"我的心無法得到安慰。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我思想上帝，發出哀歎；","poem":1},{"lineBreak":true},{"text":"我默念，心力交瘁。（細拉）","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你使我無法合眼，","poem":1},{"lineBreak":true},{"text":"我心亂如麻，默然無語。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我回想從前的日子，","poem":1},{"lineBreak":true},{"text":"那久遠的歲月，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"想起自己夜間所唱的歌。","poem":1},{"lineBreak":true},{"text":"我沉思默想，捫心自問：","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"「難道主要永遠丟棄我，","poem":1},{"lineBreak":true},{"text":"不再恩待我了嗎？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"難道祂的慈愛永遠消逝了嗎？","poem":1},{"lineBreak":true},{"text":"祂的應許永遠落空了嗎？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"難道上帝已忘記施恩，","poem":1},{"lineBreak":true},{"text":"在憤怒中收回了祂的慈愛嗎？」（細拉）","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"於是我說：「我感到悲傷的是，","poem":1},{"lineBreak":true},{"text":"至高者已不再彰顯大能。」","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華啊，我要回想你的作為，","poem":1},{"lineBreak":true},{"text":"回想你從前所行的奇事。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我要默想你所行的一切事，","poem":1},{"lineBreak":true},{"text":"思想你一切大能的作為。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"上帝啊，你的作為全然聖潔，","poem":1},{"lineBreak":true},{"text":"有哪個神明像你一樣偉大？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你是行奇事的上帝，","poem":1},{"lineBreak":true},{"text":"你在列邦中彰顯你的大能。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你以大能的臂膀救贖了你的子民，","poem":1},{"lineBreak":true},{"text":"就是雅各和約瑟的後代。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"上帝啊，眾水看見你就戰慄，","poem":1},{"lineBreak":true},{"text":"深淵看見你就顫抖。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"雲層倒出雨水，","poem":1},{"lineBreak":true},{"text":"天上雷霆霹靂，電光四射。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"旋風中傳來你的雷聲，","poem":1},{"lineBreak":true},{"text":"你的閃電照亮世界，","poem":1},{"lineBreak":true},{"text":"大地顫抖震動。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你的道路穿越海洋，經過洪濤，","poem":1},{"lineBreak":true},{"text":"但你的足跡無處可尋。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你藉著摩西和亞倫的手引領你的子民，","poem":1},{"lineBreak":true},{"text":"如同牧人引領羊群。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}