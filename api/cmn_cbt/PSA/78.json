{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":78,"content":[{"type":"heading","content":["上帝引導祂的子民"]},{"type":"hebrew_subtitle","content":["亞薩的訓誨詩。"]},{"type":"verse","number":1,"content":[{"text":"我的百姓啊！","poem":1},{"lineBreak":true},{"text":"你們要聽我的教導，","poem":1},{"lineBreak":true},{"text":"側耳傾聽我的話。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要開口講比喻，","poem":1},{"lineBreak":true},{"text":"道出古時的奧秘，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"是我們所聞所知、世代流傳下來的事。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我們不要在子孫面前隱瞞事實，","poem":1},{"lineBreak":true},{"text":"要把耶和華可稱頌的作為、","poem":1},{"lineBreak":true},{"text":"祂的權能和所行的奇事告訴下一代。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因為祂為雅各制定法度，","poem":1},{"lineBreak":true},{"text":"為以色列設立律法，","poem":1},{"lineBreak":true},{"text":"又吩咐我們的祖先把這些律法傳給兒女，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"使子孫後代都知道，","poem":1},{"lineBreak":true},{"text":"世代相傳。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"這樣，他們就會信靠上帝，","poem":1},{"lineBreak":true},{"text":"遵行祂的命令，","poem":1},{"lineBreak":true},{"text":"不忘記祂的作為；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"也不會像自己的祖先那樣頑梗叛逆，","poem":1},{"lineBreak":true},{"text":"對上帝不忠，心懷二意。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"以法蓮人備上了弓箭，","poem":1},{"lineBreak":true},{"text":"卻臨陣逃命。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們不遵守上帝的約，","poem":1},{"lineBreak":true},{"text":"拒絕遵行祂的律法。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們忘記了祂的作為，","poem":1},{"lineBreak":true},{"text":"忘記了祂彰顯的奇事。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"祂曾在埃及，在瑣安地區，","poem":1},{"lineBreak":true},{"text":"當著他們祖先的面行神蹟。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"祂把海水分開，帶領他們安然渡過；","poem":1},{"lineBreak":true},{"text":"祂使海水堆起如牆壁。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"祂白天以雲柱帶領他們，","poem":1},{"lineBreak":true},{"text":"晚上用火柱引導他們。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"祂在曠野劈開磐石，","poem":1},{"lineBreak":true},{"text":"供應他們豐沛的水源。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"祂使水從磐石中滾滾流出，","poem":1},{"lineBreak":true},{"text":"如滔滔江河。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"然而，他們仍舊犯罪，","poem":1},{"lineBreak":true},{"text":"在曠野反叛至高的上帝。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他們頑梗地試探上帝，","poem":1},{"lineBreak":true},{"text":"索要他們想吃的食物。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他們抨擊上帝，說：","poem":1},{"lineBreak":true},{"text":"「難道上帝可以在曠野擺宴席嗎？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"祂擊打磐石，","poem":1},{"lineBreak":true},{"text":"水就湧出，流淌成河，","poem":1},{"lineBreak":true},{"text":"但祂能賜給祂子民食物和肉嗎？」","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和華聽後大怒，","poem":1},{"lineBreak":true},{"text":"祂的怒火燒向雅各，","poem":1},{"lineBreak":true},{"text":"祂的怒氣發向以色列。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因為他們不相信上帝，也不信靠祂的拯救。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"祂向穹蒼發出命令，","poem":1},{"lineBreak":true},{"text":"又打開天門，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"降下嗎哪給他們吃，賜下天糧。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他們吃了天使的食物，","poem":1},{"lineBreak":true},{"text":"上帝賜給他們豐富的食物。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"祂使空中颳起東風，","poem":1},{"lineBreak":true},{"text":"用大能引來南風，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"使飛鳥如雨降下，多如塵埃，","poem":1},{"lineBreak":true},{"text":"使他們有多如海沙的肉吃。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"祂使飛鳥降落在他們營中的帳篷周圍，","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"讓他們吃得極其飽足，","poem":1},{"lineBreak":true},{"text":"上帝遂了他們的心願。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"但是，他們還沒有吃完，","poem":1},{"lineBreak":true},{"text":"肉還在口中的時候，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"上帝就向他們發怒，","poem":1},{"lineBreak":true},{"text":"殺掉了他們當中最強壯的，","poem":1},{"lineBreak":true},{"text":"消滅了以色列的青年。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"即使如此，","poem":1},{"lineBreak":true},{"text":"他們依舊犯罪，","poem":1},{"lineBreak":true},{"text":"不相信上帝奇妙的作為。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"所以上帝使他們虛度一生，","poem":1},{"lineBreak":true},{"text":"讓他們的歲月充滿恐懼。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"直到上帝擊殺他們的時候，","poem":1},{"lineBreak":true},{"text":"他們才回轉，誠心尋求祂。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"他們才想起上帝是他們的磐石，","poem":1},{"lineBreak":true},{"text":"至高的上帝是他們的救贖主。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他們卻虛情假意，滿口謊言。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"他們對祂不忠心，","poem":1},{"lineBreak":true},{"text":"也不信守祂的約。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"但上帝充滿憐憫，","poem":1},{"lineBreak":true},{"text":"赦免了他們的罪，","poem":1},{"lineBreak":true},{"text":"沒有毀滅他們。","poem":1},{"lineBreak":true},{"text":"祂多次收住怒氣，","poem":1},{"lineBreak":true},{"text":"沒有完全發出祂的烈怒。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"祂顧念他們不過是血肉之軀，","poem":1},{"lineBreak":true},{"text":"像一陣風一去不復返。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"他們在曠野屢屢反叛祂，","poem":1},{"lineBreak":true},{"text":"在荒地使祂傷心。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"他們再三試探上帝，","poem":1},{"lineBreak":true},{"text":"惹怒以色列的聖者。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"他們忘記了祂的大能，","poem":1},{"lineBreak":true},{"text":"忘記了祂救贖他們脫離壓迫的日子，","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"也忘記了祂在埃及所行的神蹟，","poem":1},{"lineBreak":true},{"text":"在瑣安的田野所行的奇事。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"祂曾使江河溪流變成血，","poem":1},{"lineBreak":true},{"text":"以致無人能喝。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"祂曾使成群的蒼蠅吞沒他們，","poem":1},{"lineBreak":true},{"text":"使青蛙毀滅他們。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"祂把他們的五穀給蚱蜢，","poem":1},{"lineBreak":true},{"text":"讓蝗蟲吃盡他們的收成。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"祂用冰雹毀壞他們的葡萄樹，","poem":1},{"lineBreak":true},{"text":"用嚴霜毀壞他們的桑樹，","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"又用冰雹毀滅他們的牛群，","poem":1},{"lineBreak":true},{"text":"用閃電毀滅他們的牲畜。","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"祂把怒火、烈怒、憤恨和禍患傾倒在他們身上，","poem":1},{"lineBreak":true},{"text":"遣下一群降災的天使。","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"祂的怒氣盡發，","poem":1},{"lineBreak":true},{"text":"使他們被瘟疫吞噬，難逃一死。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"祂擊殺了埃及人所有的長子，","poem":1},{"lineBreak":true},{"text":"就是含帳篷中頭生的兒子。","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"祂像帶領群羊一樣帶出祂的子民，","poem":1},{"lineBreak":true},{"text":"像引領羊群一樣領他們經過曠野，","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"使他們一路平安，免受驚嚇，","poem":1},{"lineBreak":true},{"text":"大海卻淹沒了他們的仇敵。","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"祂帶領他們來到祂聖地的邊界，","poem":1},{"lineBreak":true},{"text":"來到祂右手為他們預備的山區，","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"從他們面前趕出外族人，","poem":1},{"lineBreak":true},{"text":"把外族人的土地分給他們，","poem":1},{"lineBreak":true},{"text":"作為他們的產業，","poem":1},{"lineBreak":true},{"text":"使以色列各支派安頓下來。","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"他們卻仍舊試探、反叛至高的上帝，","poem":1},{"lineBreak":true},{"text":"不遵行祂的法度。","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"他們跟祖先一樣背信棄義，","poem":1},{"lineBreak":true},{"text":"像斷弓一樣毫不可靠。","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"他們建造邱壇，惹祂發怒；","poem":1},{"lineBreak":true},{"text":"他們豎起偶像，令祂憤恨。","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"上帝得知他們的惡行後大怒，","poem":1},{"lineBreak":true},{"text":"祂徹底棄絕了以色列人。","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"祂離棄了設在示羅的聖幕，","poem":1},{"lineBreak":true},{"text":"就是祂在人間的居所，","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"任憑祂大能的約櫃被擄去，","poem":1},{"lineBreak":true},{"text":"讓祂的榮耀落在敵人手中。","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"祂使自己的子民被刀劍殺戮，","poem":1},{"lineBreak":true},{"text":"向自己的產業大發怒氣。","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"青年被烈火吞噬，","poem":1},{"lineBreak":true},{"text":"少女無婚禮頌歌。","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"祭司喪身刀下，","poem":1},{"lineBreak":true},{"text":"寡婦無法哭喪。","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"那時，主像從睡眠中醒來，","poem":1},{"lineBreak":true},{"text":"又如酒後醒來的勇士。","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"祂擊退仇敵，","poem":1},{"lineBreak":true},{"text":"叫他們永遠蒙羞。","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"祂丟棄了約瑟的帳篷，","poem":1},{"lineBreak":true},{"text":"沒有揀選以法蓮支派。","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"祂揀選了猶大支派，","poem":1},{"lineBreak":true},{"text":"祂所喜愛的錫安山。","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"祂為自己建造高聳的聖所，","poem":1},{"lineBreak":true},{"text":"使它像大地一樣長存。","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"祂揀選了祂的僕人大衛，","poem":1},{"lineBreak":true},{"text":"把他從羊圈中召來，","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"讓他離開牧羊的生活，","poem":1},{"lineBreak":true},{"text":"去牧養祂的子民雅各的後裔，","poem":1},{"lineBreak":true},{"text":"牧養祂的產業以色列。","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"於是，大衛以正直的心牧養他們，","poem":1},{"lineBreak":true},{"text":"用靈巧的手帶領他們。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}