{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":80,"content":[{"type":"heading","content":["為國家復興祈求"]},{"type":"hebrew_subtitle","content":["亞薩的詩，交給樂長，調用「作證的百合花」。"]},{"type":"verse","number":1,"content":[{"text":"以色列的牧者啊，","poem":1},{"lineBreak":true},{"text":"你像照顧羊群一樣帶領約瑟的子孫，","poem":1},{"lineBreak":true},{"text":"求你垂聽我們的祈禱。","poem":1},{"lineBreak":true},{"text":"坐在基路伯天使之上的耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你向以法蓮、便雅憫和瑪拿西發出光輝，","poem":1},{"lineBreak":true},{"text":"求你施展大能來拯救我們。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝啊，求你復興我們，","poem":1},{"lineBreak":true},{"text":"用你臉上的榮光照耀我們，","poem":1},{"lineBreak":true},{"text":"使我們得救。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"萬軍之上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"你因你子民的禱告而發怒，","poem":1},{"lineBreak":true},{"text":"要到何時呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你使我們以淚為食，","poem":1},{"lineBreak":true},{"text":"喝下滿碗的淚水。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你使我們成為鄰國爭奪的對象，","poem":1},{"lineBreak":true},{"text":"仇敵都嘲笑我們。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"萬軍之上帝啊，","poem":1},{"lineBreak":true},{"text":"求你復興我們，","poem":1},{"lineBreak":true},{"text":"用你臉上的榮光照耀我們，","poem":1},{"lineBreak":true},{"text":"使我們得救。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你從埃及帶出一棵葡萄樹，","poem":1},{"lineBreak":true},{"text":"趕走外族人，把它栽種起來。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你為它開墾土地，","poem":1},{"lineBreak":true},{"text":"它就扎根生長，佈滿這片土地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"它的樹蔭遮蓋群山，","poem":1},{"lineBreak":true},{"text":"枝子遮蔽高大的香柏樹。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"它的枝條延伸到地中海，","poem":1},{"lineBreak":true},{"text":"嫩枝伸展到幼發拉底河。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你為何拆毀了它的籬笆，","poem":1},{"lineBreak":true},{"text":"讓路人隨意摘取葡萄呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"林中的野豬蹂躪它，","poem":1},{"lineBreak":true},{"text":"田間的野獸吞吃它。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"萬軍之上帝啊，求你回來，","poem":1},{"lineBreak":true},{"text":"求你在天上垂顧，看護這棵葡萄樹，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"這棵你右手栽種的根莖，","poem":1},{"lineBreak":true},{"text":"你為自己培育的苗子。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"這樹被砍倒，被焚燒，","poem":1},{"lineBreak":true},{"text":"願你發怒毀滅仇敵。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"求你扶持你揀選的人，","poem":1},{"lineBreak":true},{"text":"就是你為自己所養育的人子。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我們必不再背棄你，","poem":1},{"lineBreak":true},{"text":"求你使我們復甦，我們必敬拜你。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"萬軍之上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你復興我們，","poem":1},{"lineBreak":true},{"text":"用你臉上的榮光照耀我們，","poem":1},{"lineBreak":true},{"text":"使我們得救。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":18}