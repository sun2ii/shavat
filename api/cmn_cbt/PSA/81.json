{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":81,"content":[{"type":"heading","content":["歌頌上帝的恩惠"]},{"type":"hebrew_subtitle","content":["亞薩的詩，交給樂長，用迦特樂器。"]},{"type":"verse","number":1,"content":[{"text":"要歌頌賜我們力量的上帝，","poem":1},{"lineBreak":true},{"text":"向雅各的上帝歡呼。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要唱詩，擊鼓，彈奏悅耳的琴瑟。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要在我們過節的朔日和望日","poem":1},{"noteId":5},{"text":"吹響號角。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"這是以色列的律例，","poem":1},{"lineBreak":true},{"text":"是雅各的上帝所定的法令。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝攻擊埃及的時候，","poem":1},{"lineBreak":true},{"text":"為約瑟立下此法度。","poem":1},{"lineBreak":true},{"text":"我在那裡聽見陌生的聲音說：","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"「我卸下了你肩上的重擔，","poem":1},{"lineBreak":true},{"text":"使你的雙手放下筐子，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你在苦難中向我呼求，","poem":1},{"lineBreak":true},{"text":"我就拯救了你，","poem":1},{"lineBreak":true},{"text":"從雷聲隆隆的密雲中應允了你。","poem":1},{"lineBreak":true},{"text":"我在米利巴泉邊考驗你。（細拉）","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的子民啊，","poem":1},{"lineBreak":true},{"text":"要聽我的警告。","poem":1},{"lineBreak":true},{"text":"以色列人啊，","poem":1},{"lineBreak":true},{"text":"但願你們聽從我的話。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你們當中不可有別的神明，","poem":1},{"lineBreak":true},{"text":"也不可向外族的神明下拜，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我是你們的上帝耶和華，","poem":1},{"lineBreak":true},{"text":"曾帶你們出埃及。","poem":1},{"lineBreak":true},{"text":"張開你們的口吧，","poem":1},{"lineBreak":true},{"text":"我必使你們飽足。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的子民卻不肯聽我的話，","poem":1},{"lineBreak":true},{"text":"以色列不願意順從我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因此我就任憑他們頑固不化，","poem":1},{"lineBreak":true},{"text":"為所欲為。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"但願我的子民肯聽從我，","poem":1},{"lineBreak":true},{"text":"以色列人肯遵行我的道。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"那時，我必迅速制伏他們的敵人，","poem":1},{"lineBreak":true},{"text":"伸手攻擊他們的仇敵。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"恨耶和華的人要向祂投降，","poem":1},{"lineBreak":true},{"text":"他們會永遠沉淪。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要以上好的麥子供養我的子民，","poem":1},{"lineBreak":true},{"text":"讓他們飽享磐石間的蜂蜜。」","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"「朔日和望日」即每月的初一和十五。","reference":{"chapter":81,"verse":3}}]},"thisChapterLink":"/api/cmn_cbt/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}