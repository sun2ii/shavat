{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":82,"content":[{"type":"heading","content":["斥責不公正的審判"]},{"type":"hebrew_subtitle","content":["亞薩的詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝站在天庭的會中，","poem":1},{"lineBreak":true},{"text":"向眾神明宣佈祂的判決，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"說：「你們不秉公行義，","poem":1},{"lineBreak":true},{"text":"偏袒惡人要到何時呢？（細拉）","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們要為窮人和孤兒主持公道，","poem":1},{"lineBreak":true},{"text":"為貧寒和受壓迫的人伸張正義。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"要救助弱小窮苦的人，","poem":1},{"lineBreak":true},{"text":"使他們脫離惡人的欺壓。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你們愚昧無知，","poem":1},{"lineBreak":true},{"text":"行在黑暗中，","poem":1},{"lineBreak":true},{"text":"大地的根基搖動。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我曾說你們都是神，","poem":1},{"lineBreak":true},{"text":"都是至高者的兒子，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"但你們要跟世人一樣死去，","poem":1},{"lineBreak":true},{"text":"像人間的王侯一樣滅亡。」","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"上帝啊，求你起來審判世界，","poem":1},{"lineBreak":true},{"text":"因為世上的萬國都屬於你。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}