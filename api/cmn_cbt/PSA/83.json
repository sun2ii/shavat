{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":83,"content":[{"type":"heading","content":["祈求上帝擊敗仇敵"]},{"type":"hebrew_subtitle","content":["亞薩的詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你不要緘默無聲。","poem":1},{"lineBreak":true},{"text":"上帝啊，求你不要閉口不言。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"看啊，你的敵人在喧嚷，","poem":1},{"lineBreak":true},{"text":"恨你的人趾高氣揚。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們用詭計害你的子民，","poem":1},{"lineBreak":true},{"text":"他們一起謀害你珍愛的人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們說：","poem":1},{"lineBreak":true},{"text":"「來吧，讓我們剷除以色列，","poem":1},{"lineBreak":true},{"text":"讓他們亡國，被人遺忘。」","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們串通一氣，","poem":1},{"lineBreak":true},{"text":"勾結起來抵擋你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們是以東人、以實瑪利人、摩押人、夏甲人、","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"迦巴勒人、亞捫人、亞瑪力人、非利士人和泰爾人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"亞述也跟他們勾結，","poem":1},{"lineBreak":true},{"text":"要助羅得的後代一臂之力。（細拉）","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你對付他們，","poem":1},{"lineBreak":true},{"text":"如同對付米甸人，","poem":1},{"lineBreak":true},{"text":"如同對付基順河邊的西西拉與耶賓。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們在隱·多珥滅亡，","poem":1},{"lineBreak":true},{"text":"成了地上的糞土。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你使他們首領的下場像俄立和西伊伯一樣，","poem":1},{"lineBreak":true},{"text":"使他們王侯的下場像西巴和撒慕拿一樣。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們曾說：","poem":1},{"lineBreak":true},{"text":"「讓我們奪取上帝的草場吧。」","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我的上帝啊，求你把他們驅散，","poem":1},{"lineBreak":true},{"text":"如同狂風吹散塵土和碎稭。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"烈火怎樣燒毀森林，","poem":1},{"lineBreak":true},{"text":"火焰怎樣吞沒山嶺，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"求你也照樣用狂風追趕他們，","poem":1},{"lineBreak":true},{"text":"用暴雨恐嚇他們。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你使他們滿臉盡是恥辱，","poem":1},{"lineBreak":true},{"text":"這樣他們才會來尋求你的名。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"願他們永遠羞愧驚恐，","poem":1},{"lineBreak":true},{"text":"願他們在恥辱中滅亡。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"讓他們知道你名叫耶和華，","poem":1},{"lineBreak":true},{"text":"唯有你是普天下的至高者。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}