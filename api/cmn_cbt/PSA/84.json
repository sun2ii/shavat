{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":84,"content":[{"type":"heading","content":["渴慕住在聖殿"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩，交給樂長，用迦特樂器。"]},{"type":"verse","number":1,"content":[{"text":"萬軍之耶和華啊，","poem":1},{"lineBreak":true},{"text":"你的居所多麼可愛！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我渴慕進入耶和華的院宇，","poem":1},{"lineBreak":true},{"text":"我的身心向永活的上帝歡呼。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"萬軍之耶和華，","poem":1},{"lineBreak":true},{"text":"我的王我的上帝啊，","poem":1},{"lineBreak":true},{"text":"在你的祭壇邊，麻雀找到了家，","poem":1},{"lineBreak":true},{"text":"燕子築巢養育幼雛。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"住在你殿裡的人有福了！","poem":1},{"lineBreak":true},{"text":"他們不斷地歌頌你。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"靠你得力量的人有福了！","poem":1},{"lineBreak":true},{"text":"他們嚮往到錫安朝見你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們走過流淚谷，","poem":1},{"lineBreak":true},{"text":"這谷就變成泉源之地，","poem":1},{"lineBreak":true},{"text":"秋雨使谷中水塘遍佈。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們越走越有力，","poem":1},{"lineBreak":true},{"text":"都要到錫安朝見上帝。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"萬軍之上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你聽我的禱告；","poem":1},{"lineBreak":true},{"text":"雅各的上帝啊，求你垂聽。（細拉）","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"上帝啊，求你照看我們的盾牌，","poem":1},{"lineBreak":true},{"text":"垂顧你所膏立的王。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"在你的院宇住一日勝過在別處住千日！","poem":1},{"lineBreak":true},{"text":"我寧願在我上帝的殿中看門，","poem":1},{"lineBreak":true},{"text":"也不願住在惡人的帳篷裡。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因為耶和華上帝是太陽，是盾牌；","poem":1},{"lineBreak":true},{"text":"祂賜下恩惠和尊榮，","poem":1},{"lineBreak":true},{"text":"不留下任何好處不賜給行為純全的人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"萬軍之耶和華啊，","poem":1},{"lineBreak":true},{"text":"信靠你的人有福了！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}