{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":85,"content":[{"type":"heading","content":["為國家求福"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩，交給樂長。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，你恩待了你的土地，","poem":1},{"lineBreak":true},{"text":"恢復了雅各的福祉。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你赦免了你子民的罪惡，","poem":1},{"lineBreak":true},{"text":"遮蓋了他們所有的過犯。（細拉）","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你收回所有怒氣，","poem":1},{"lineBreak":true},{"text":"不再發烈怒。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"拯救我們的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你復興我們，","poem":1},{"lineBreak":true},{"text":"止息你對我們的怒氣。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你要向我們永遠發怒嗎？","poem":1},{"lineBreak":true},{"text":"你的怒氣要延續到萬代嗎？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你不再復興我們，","poem":1},{"lineBreak":true},{"text":"使你的子民靠你歡喜嗎？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華啊，求你向我們施慈愛，","poem":1},{"lineBreak":true},{"text":"拯救我們。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我要聽耶和華上帝所說的話，","poem":1},{"lineBreak":true},{"text":"因為祂應許賜平安給祂的子民，","poem":1},{"lineBreak":true},{"text":"祂的聖民。","poem":1},{"lineBreak":true},{"text":"但他們不可再轉向愚昧。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"祂必很快拯救敬畏祂的人，","poem":1},{"lineBreak":true},{"text":"好讓祂的榮耀常駐在我們的地上。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"慈愛和忠信相遇，","poem":1},{"lineBreak":true},{"text":"公義與平安相親。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"忠信從地上生出，","poem":1},{"lineBreak":true},{"text":"公義從天上俯視。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和華賜下福祉，","poem":1},{"lineBreak":true},{"text":"我們的土地就出產豐富。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"公義要行在祂面前，為祂開路。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}