{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":87,"content":[{"type":"heading","content":["頌讚錫安"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和華的城座落在聖山上。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"祂喜愛錫安的門，","poem":1},{"lineBreak":true},{"text":"勝過雅各其他住處。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝的城啊，","poem":1},{"lineBreak":true},{"text":"人們傳揚你的榮耀。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"「我要把埃及人","poem":1},{"noteId":6},{"text":"、巴比倫人、非利士人、泰爾人和古實人列為認識我的民族，","poem":1},{"lineBreak":true},{"text":"視他們為生在錫安的人。」","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"至於錫安，必有人說：","poem":1},{"lineBreak":true},{"text":"「萬族必生在這城，","poem":1},{"lineBreak":true},{"text":"至高者必親自堅立這城。」","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華將萬民登記入冊的時候，","poem":1},{"lineBreak":true},{"text":"必把他們列為生在錫安的人。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"他們跳舞歌唱說：","poem":1},{"lineBreak":true},{"text":"「我們蒙福的泉源都在錫安。」","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"「埃及人」希伯來文是「拉哈伯」，埃及的別名。","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/cmn_cbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}