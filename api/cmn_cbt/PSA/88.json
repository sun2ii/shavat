{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":88,"content":[{"type":"heading","content":["求上帝眷顧"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩歌，就是以斯拉人希幔的訓誨詩，交給樂長，調用「麻哈拉利暗俄」",{"noteId":7},"。"]},{"type":"verse","number":1,"content":[{"text":"耶和華，拯救我的上帝啊，","poem":1},{"lineBreak":true},{"text":"我晝夜不停地呼求你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你垂聽我的禱告，","poem":1},{"lineBreak":true},{"text":"側耳聽我的呼求。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我飽經患難，","poem":1},{"lineBreak":true},{"text":"生命在陰間的邊緣。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我被列在下墳墓的人中，","poem":1},{"lineBreak":true},{"text":"我的精力耗盡。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我被扔在死人中，","poem":1},{"lineBreak":true},{"text":"如同被殺的人躺在墳墓裡，","poem":1},{"lineBreak":true},{"text":"被你遺忘，不再蒙你眷顧。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你已經把我扔在極深的坑中，","poem":1},{"lineBreak":true},{"text":"扔在漆黑的深淵。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的烈怒重重地壓著我，","poem":1},{"lineBreak":true},{"text":"你用洶湧的波濤把我淹沒。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你使我眾叛親離，遭人唾棄。","poem":1},{"lineBreak":true},{"text":"我陷入困境，無路可逃。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我因憂傷而眼睛昏花。","poem":1},{"lineBreak":true},{"text":"耶和華啊，我天天呼求你，","poem":1},{"lineBreak":true},{"text":"舉手向你呼求。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你要行神蹟給死人看嗎？","poem":1},{"lineBreak":true},{"text":"死人會起來讚美你嗎？（細拉）","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"墳墓裡的死人怎能述說你的慈愛呢？","poem":1},{"lineBreak":true},{"text":"滅亡的人怎能傳揚你的信實呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"黑暗之地有誰知道你的神蹟呢？","poem":1},{"lineBreak":true},{"text":"在被遺忘之地有誰知道你的公義作為呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華啊，我向你呼求，","poem":1},{"lineBreak":true},{"text":"我在清晨向你禱告。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華啊，你為何棄絕我？","poem":1},{"lineBreak":true},{"text":"為何掩面不理我？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我從小受苦，幾乎喪命。","poem":1},{"lineBreak":true},{"text":"你使我驚恐不已，陷入絕望。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你的烈怒吞噬了我，","poem":1},{"lineBreak":true},{"text":"你可怕的攻擊毀滅了我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"這些災難如洪濤整天環繞我，","poem":1},{"lineBreak":true},{"text":"四面圍住我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你使我的親朋好友離我而去，","poem":1},{"lineBreak":true},{"text":"只有黑暗與我相伴。","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"「麻哈拉利暗俄」意為「受苦」。","reference":{"chapter":88,"verse":0}}]},"thisChapterLink":"/api/cmn_cbt/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}