{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":89,"content":[{"type":"heading","content":["永遠配受稱頌的上帝"]},{"type":"hebrew_subtitle","content":["以斯拉人以探的訓誨詩。"]},{"type":"verse","number":1,"content":[{"text":"我要永遠稱頌耶和華的慈愛！","poem":1},{"lineBreak":true},{"text":"我的口要傳揚你的信實直到萬代。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要宣告：","poem":1},{"lineBreak":true},{"text":"你的慈愛存到永遠，","poem":1},{"lineBreak":true},{"text":"你的信實堅立在天。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你曾說：","poem":1},{"lineBreak":true},{"text":"「我與我所揀選的人立了約，","poem":1},{"lineBreak":true},{"text":"向我的僕人大衛起了誓，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"『我要使你的後裔永遠坐在寶座上，世代為王。』」（細拉）","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華啊，諸天要頌揚你的奇妙，","poem":1},{"lineBreak":true},{"text":"眾聖者要同聚讚美你的信實。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"天上有誰能與耶和華相比，","poem":1},{"lineBreak":true},{"text":"眾天使中誰能像祂？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂在眾聖者的會中大受敬畏，","poem":1},{"lineBreak":true},{"text":"祂的威嚴無與倫比。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"萬軍之上帝耶和華啊，","poem":1},{"lineBreak":true},{"text":"誰能像你能力偉大，信實無比？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你掌管洶湧的大海，","poem":1},{"lineBreak":true},{"text":"平息驚濤駭浪。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你擊碎海怪","poem":1},{"noteId":8},{"text":"，使其斃命，","poem":1},{"lineBreak":true},{"text":"以大能的臂膀驅散仇敵。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"天地都屬於你，","poem":1},{"lineBreak":true},{"text":"世界和其中的一切都是你造的。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你創造了南北，","poem":1},{"lineBreak":true},{"text":"他泊山和黑門山歡頌你的名。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你有大能的臂膀，","poem":1},{"lineBreak":true},{"text":"你的手有力量，你的右手高舉。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你的寶座以公平和正義為根基，","poem":1},{"lineBreak":true},{"text":"你以慈愛和信實為先鋒。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"懂得向你歡呼的人有福了，","poem":1},{"lineBreak":true},{"text":"他們走在你的榮光之中。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他們因你的名終日歡欣，","poem":1},{"lineBreak":true},{"text":"因你的公義而雀躍。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你是他們的力量和榮耀，","poem":1},{"lineBreak":true},{"text":"你的恩惠使我們的角高舉。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我們的盾牌是耶和華所賜的，","poem":1},{"lineBreak":true},{"text":"我們的王屬於以色列的聖者。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你曾在異象中對你忠心的子民說：","poem":1},{"lineBreak":true},{"text":"「我已把力量賜給一位勇士，","poem":1},{"lineBreak":true},{"text":"已提升我在民中揀選的人。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我找到了我的僕人大衛，","poem":1},{"lineBreak":true},{"text":"用我的聖油膏立他。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我的手必扶持他，","poem":1},{"lineBreak":true},{"text":"我的臂膀必加給他力量。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"仇敵勝不過他，","poem":1},{"lineBreak":true},{"text":"惡人不能欺壓他。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我要當著他的面擊垮他的敵人，","poem":1},{"lineBreak":true},{"text":"打倒恨他的人。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我要以信實和慈愛待他，","poem":1},{"lineBreak":true},{"text":"他的角必因我的名而高舉。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我要使他左手掌管大海，","poem":1},{"lineBreak":true},{"text":"右手統治江河。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他要向我高呼，","poem":1},{"lineBreak":true},{"text":"『你是我的父親，我的上帝，","poem":1},{"lineBreak":true},{"text":"拯救我的磐石。』","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我要立他為我的長子，","poem":1},{"lineBreak":true},{"text":"做世上至尊的君王。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我要永遠用慈愛待他，","poem":1},{"lineBreak":true},{"text":"我與他立的約永不失效。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我要使他的後裔永無窮盡，","poem":1},{"lineBreak":true},{"text":"讓他的王位與天同存。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"如果他的後代背棄我的律法，","poem":1},{"lineBreak":true},{"text":"不遵行我的典章，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"觸犯我的律例，","poem":1},{"lineBreak":true},{"text":"不守我的誡命，","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我必因他們的罪過而杖責他們，","poem":1},{"lineBreak":true},{"text":"因他們的罪愆而鞭笞他們。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"但我不會收回我的慈愛，","poem":1},{"lineBreak":true},{"text":"也不會背棄我的信實。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"我必不毀約，也不食言。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"因我曾憑自己的聖潔起誓，","poem":1},{"lineBreak":true},{"text":"我對大衛絕無謊言。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他的後裔必永無窮盡，","poem":1},{"lineBreak":true},{"text":"他的王位必在我面前如日長存，","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"又如天上忠心作證的月亮一樣永固。」（細拉）","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"如今，你對你所膏立的王大發怒氣，拒絕並丟棄了他。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"你廢棄與他所立的約，","poem":1},{"lineBreak":true},{"text":"把他的冠冕扔在塵土中。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"你攻破了他的城牆，","poem":1},{"lineBreak":true},{"text":"使他的堅壘淪為廢墟。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"路人都趁機劫掠他的財物，","poem":1},{"lineBreak":true},{"text":"鄰居都嘲笑他。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"你助長了他敵人的勢力，","poem":1},{"lineBreak":true},{"text":"使敵人洋洋得意。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"你使他的刀劍卷刃，","poem":1},{"lineBreak":true},{"text":"你使他敗退沙場。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"你使他的威榮盡失，","poem":1},{"lineBreak":true},{"text":"王位傾覆。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"你使他未老先衰，","poem":1},{"lineBreak":true},{"text":"受盡羞辱。（細拉）","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"你隱藏自己要到何時呢？","poem":1},{"lineBreak":true},{"text":"要到永遠嗎？","poem":1},{"lineBreak":true},{"text":"你的怒火要燒到何時呢？","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"求你顧念我的生命何其短暫！","poem":1},{"lineBreak":true},{"text":"你創造的世人何其虛幻！","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"誰能長生不死？","poem":1},{"lineBreak":true},{"text":"誰能救自己脫離陰間的權勢呢？（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"主啊，你從前憑自己的信實向大衛應許的慈愛在哪裡呢？","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"主啊，求你記住僕人們如何受羞辱，","poem":1},{"lineBreak":true},{"text":"我心中如何忍受列國的嘲笑。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"你的仇敵嘲笑你所膏立的王，","poem":1},{"lineBreak":true},{"text":"他們嘲笑他的一舉一動。","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"耶和華永遠當受稱頌。","poem":1},{"lineBreak":true},{"text":"阿們！阿們！","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"「海怪」希伯來文是「拉哈伯」。","reference":{"chapter":89,"verse":10}}]},"thisChapterLink":"/api/cmn_cbt/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}