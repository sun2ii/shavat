{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":9,"content":[{"type":"heading","content":["稱頌上帝的公義"]},{"type":"hebrew_subtitle","content":["大衛的詩，交給樂長，調用「慕拉辨」",{"noteId":1},"。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我要全心讚美你，","poem":1},{"lineBreak":true},{"text":"傳揚你一切奇妙的作為。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要因你歡喜快樂，","poem":1},{"lineBreak":true},{"text":"至高者啊，我要歌頌你的名。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的仇敵必敗退，","poem":1},{"lineBreak":true},{"text":"在你面前倒地身亡。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你坐在寶座上按公義審判，","poem":1},{"lineBreak":true},{"text":"你為我主持公道。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你斥責列國，消滅惡人，","poem":1},{"lineBreak":true},{"text":"永永遠遠抹去他們的名字。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"仇敵永遠滅亡了，","poem":1},{"lineBreak":true},{"text":"你把他們的城池連根拔起，","poem":1},{"lineBreak":true},{"text":"無人再記得他們。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華永遠掌權，","poem":1},{"lineBreak":true},{"text":"祂已設立施行審判的寶座。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"祂要按公義審判世界，","poem":1},{"lineBreak":true},{"text":"按公正審判萬民。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華是受欺壓之人的避難所，","poem":1},{"lineBreak":true},{"text":"是他們患難之時的避風港。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"凡認識你名的人都必信靠你，","poem":1},{"lineBreak":true},{"text":"因為你從來不丟棄尋求你的人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"要歌頌住在錫安的耶和華，","poem":1},{"lineBreak":true},{"text":"在列邦傳揚祂的作為。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因為祂追討血債，眷顧受害者，","poem":1},{"lineBreak":true},{"text":"不忽略受苦者的呼求。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"看看仇敵對我的迫害！","poem":1},{"lineBreak":true},{"text":"求你憐憫我，","poem":1},{"lineBreak":true},{"text":"救我離開死亡之門，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我好在少女錫安的城門口稱頌你，","poem":1},{"lineBreak":true},{"text":"因你的拯救而歡樂。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"列邦挖了陷阱卻自陷其中，","poem":1},{"lineBreak":true},{"text":"暗設網羅卻纏住自己的腳。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華彰顯自己，施行審判，","poem":1},{"lineBreak":true},{"text":"使惡人自食其果。（細拉）","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"惡人必下陰間，忘記上帝的列邦都落此下場。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"貧乏人不會永遠被遺忘，","poem":1},{"lineBreak":true},{"text":"受苦人的希望也不會一直落空。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和華啊，求你起來，","poem":1},{"lineBreak":true},{"text":"別讓世人向你誇勝，","poem":1},{"lineBreak":true},{"text":"願你審判列邦。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你使列邦恐懼顫抖，","poem":1},{"lineBreak":true},{"text":"讓他們明白自己不過是人。（細拉）","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"「慕拉辨」希伯來文的意思是「喪子」。","reference":{"chapter":9,"verse":0}}]},"thisChapterLink":"/api/cmn_cbt/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}