{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":90,"content":[{"type":"heading","content":["上帝與世人"]},{"type":"hebrew_subtitle","content":["上帝的僕人摩西的祈禱。"]},{"type":"verse","number":1,"content":[{"text":"主啊，","poem":1},{"lineBreak":true},{"text":"你是我們世世代代的居所。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"群山尚未誕生，","poem":1},{"lineBreak":true},{"text":"大地和世界還未形成，","poem":1},{"lineBreak":true},{"text":"你就是上帝，直到永永遠遠。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你叫人歸回塵土，","poem":1},{"lineBreak":true},{"text":"說：「世人啊，歸回塵土吧。」","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"在你眼中，","poem":1},{"lineBreak":true},{"text":"千年如剛過的昨日，又如夜裡的一更。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你像急流一般把世人沖走，","poem":1},{"lineBreak":true},{"text":"叫他們如夢消逝。","poem":1},{"lineBreak":true},{"text":"他們像清晨的嫩草，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"清晨還生機盎然，","poem":1},{"lineBreak":true},{"text":"傍晚就凋謝枯萎。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我們被你的怒氣消滅，","poem":1},{"lineBreak":true},{"text":"你的憤怒使我們顫抖。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你知道我們的罪惡，","poem":1},{"lineBreak":true},{"text":"我們隱秘的罪顯露在你面前。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我們活在你的烈怒之下，","poem":1},{"lineBreak":true},{"text":"一生就像一聲歎息飛逝而去。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我們一生七十歲，","poem":1},{"lineBreak":true},{"text":"強壯的可活八十歲，","poem":1},{"lineBreak":true},{"text":"但人生最美好的時光也充滿勞苦和愁煩，","poem":1},{"lineBreak":true},{"text":"生命轉瞬即逝，","poem":1},{"lineBreak":true},{"text":"我們便如飛而去。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"誰明白你憤怒的威力？","poem":1},{"lineBreak":true},{"text":"誰明白你的烈怒而給你當得的敬畏呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你教導我們明白人生有限，","poem":1},{"lineBreak":true},{"text":"使我們做有智慧的人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華啊，我還要等候多久？","poem":1},{"lineBreak":true},{"text":"求你回轉，憐憫你的僕人。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"求你在清晨以慈愛來滿足我們，","poem":1},{"lineBreak":true},{"text":"使我們一生歡喜歌唱。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你使我們先前經歷了多少苦難和不幸的歲月，","poem":1},{"lineBreak":true},{"text":"求你也賜給我們多少歡樂的歲月。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"求你讓僕人們看見你的作為，","poem":1},{"lineBreak":true},{"text":"讓我們的後代看見你的威榮。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"願主，我們的上帝恩待我們，","poem":1},{"lineBreak":true},{"text":"使我們所做的亨通，","poem":1},{"lineBreak":true},{"text":"使我們所做的亨通。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}