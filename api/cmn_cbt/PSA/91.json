{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":91,"content":[{"type":"heading","content":["上帝是我們的保護者"]},{"type":"verse","number":1,"content":[{"text":"安居在至高者隱秘處的人，","poem":1},{"lineBreak":true},{"text":"必蒙全能者的蔭庇。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要對耶和華說：","poem":1},{"lineBreak":true},{"text":"「你是我的避難所，我的堡壘，","poem":1},{"lineBreak":true},{"text":"是我所信靠的上帝。」","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂必救你脫離獵人的網羅和致命的瘟疫。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂必用祂的羽毛遮蓋你，","poem":1},{"lineBreak":true},{"text":"你必在祂翅膀下蒙庇護，","poem":1},{"lineBreak":true},{"text":"祂的信實是你的盾牌和壁壘。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你必不懼怕黑夜的恐怖，","poem":1},{"lineBreak":true},{"text":"或白日的飛箭，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"或黑暗中橫行的瘟疫，","poem":1},{"lineBreak":true},{"text":"或正午肆虐的災難。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"儘管千人仆倒在你左邊，","poem":1},{"lineBreak":true},{"text":"萬人仆倒在你右邊，","poem":1},{"lineBreak":true},{"text":"你必安然無恙。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你必親眼目睹惡人受懲罰。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為你以耶和華為避難所，","poem":1},{"lineBreak":true},{"text":"以至高者為居所，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"禍患不會臨到你身上，","poem":1},{"lineBreak":true},{"text":"災難不會靠近你的帳篷。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因為祂必吩咐祂的天使隨時隨地保護你。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們會用手托住你，","poem":1},{"lineBreak":true},{"text":"不讓你的腳碰在石頭上。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你必將獅子和毒蛇踩在腳下，","poem":1},{"lineBreak":true},{"text":"你必踐踏猛獅和巨蛇。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華說：「因為他愛慕我，我必拯救他；","poem":1},{"lineBreak":true},{"text":"因為他信靠我的名，我必保護他。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他求告我，我就答應他；","poem":1},{"lineBreak":true},{"text":"他遭遇患難，我必與他同在。","poem":1},{"lineBreak":true},{"text":"我必解救他，賜他尊貴的地位。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我必賜他長壽，","poem":1},{"lineBreak":true},{"text":"並讓他看見我的拯救之恩。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}