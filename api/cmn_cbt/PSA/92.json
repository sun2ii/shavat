{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":92,"content":[{"type":"heading","content":["讚美之歌"]},{"type":"hebrew_subtitle","content":["安息日唱的詩歌。"]},{"type":"verse","number":1,"content":[{"text":"至高的耶和華啊，","poem":1},{"lineBreak":true},{"text":"讚美你、歌頌你的名是何等美好！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"伴隨著十弦琴和豎琴的樂聲，","poem":1},{"lineBreak":true},{"text":"我早晨宣揚你的慈愛，","poem":1},{"lineBreak":true},{"text":"晚上述說你的信實。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華啊，你的作為使我快樂，","poem":1},{"lineBreak":true},{"text":"我要因你手所做的而歡唱。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華啊，你的作為何等偉大！","poem":1},{"lineBreak":true},{"text":"你的心思何等深奧！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"無知的人不會明白，","poem":1},{"lineBreak":true},{"text":"愚蠢的人無法理解：","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"雖然惡人如草滋生，歹徒一時亨通，","poem":1},{"lineBreak":true},{"text":"但他們終必永遠滅亡。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"唯有你永遠受尊崇。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華啊，你的仇敵終必滅亡，","poem":1},{"lineBreak":true},{"text":"凡作惡的都要被驅散。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你使我的角高舉，如野牛之角，","poem":1},{"lineBreak":true},{"text":"你用新油澆灌我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我親眼看見我的敵人被擊潰，","poem":1},{"lineBreak":true},{"text":"親耳聽見那些攻擊我的惡人被打敗。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"義人必如棕樹一樣繁盛，","poem":1},{"lineBreak":true},{"text":"像黎巴嫩香柏樹一樣茁壯。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他們栽在耶和華的殿中，","poem":1},{"lineBreak":true},{"text":"他們在我們上帝的院子裡長得枝繁葉茂。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們到老仍然結果子，","poem":1},{"lineBreak":true},{"text":"一片青翠，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"宣揚說：「耶和華公正無私，","poem":1},{"lineBreak":true},{"text":"祂是我的磐石，","poem":1},{"lineBreak":true},{"text":"祂裡面毫無不義。」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":14}