{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":94,"content":[{"type":"heading","content":["上帝是審判者"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，你是伸冤的上帝；","poem":1},{"lineBreak":true},{"text":"伸冤的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你彰顯榮光。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"審判世界的主啊，","poem":1},{"lineBreak":true},{"text":"求你起來使驕傲人受應得的報應。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"惡人洋洋得意，要到何時呢？","poem":1},{"lineBreak":true},{"text":"要到何時呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們口吐狂妄之言，","poem":1},{"lineBreak":true},{"text":"作惡的人都愛自誇。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華啊，他們壓迫你的子民，","poem":1},{"lineBreak":true},{"text":"苦害你的產業。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們殺死寡婦和寄居者，","poem":1},{"lineBreak":true},{"text":"還謀害孤兒，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"並說：「耶和華看不見，","poem":1},{"lineBreak":true},{"text":"雅各的上帝不會知道。」","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"民中的愚昧人啊，你們要思想；","poem":1},{"lineBreak":true},{"text":"無知的人啊，你們何時才有智慧？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"難道造耳朵的上帝聽不見嗎？","poem":1},{"lineBreak":true},{"text":"難道造眼睛的上帝看不見嗎？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"管教列國的上帝難道不懲罰嗎？","poem":1},{"lineBreak":true},{"text":"賜人知識的上帝難道無知嗎？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華洞悉人的思想，","poem":1},{"lineBreak":true},{"text":"祂知道人的思想虛妄。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和華啊，蒙你管教並用律法訓誨的人有福了！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你使他們在患難中有平安，","poem":1},{"lineBreak":true},{"text":"直到為惡人挖好了坑。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華不會丟棄祂的子民，","poem":1},{"lineBreak":true},{"text":"也不會遺棄祂的產業。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"公正的審判必重現，","poem":1},{"lineBreak":true},{"text":"心地正直的人都必擁護。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"誰肯為我奮起攻擊惡人？","poem":1},{"lineBreak":true},{"text":"誰肯為我起來抵擋作惡的人？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和華若不幫助我，","poem":1},{"lineBreak":true},{"text":"我早已歸入死亡的沉寂中了。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我說：「我失腳滑倒了！」","poem":1},{"lineBreak":true},{"text":"耶和華啊，你便以慈愛扶助我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"當我憂心忡忡的時候，","poem":1},{"lineBreak":true},{"text":"你的撫慰帶給我歡樂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"藉律例製造不幸的首領，","poem":1},{"lineBreak":true},{"text":"豈能與你聯盟？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他們結黨攻擊義人，","poem":1},{"lineBreak":true},{"text":"殘害無辜。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"但耶和華是我的堡壘，","poem":1},{"lineBreak":true},{"text":"我的上帝是保護我的磐石。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"祂必使惡人自食惡果，","poem":1},{"lineBreak":true},{"text":"因他們的罪惡而毀滅他們。","poem":1},{"lineBreak":true},{"text":"我們的上帝耶和華必毀滅他們。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}