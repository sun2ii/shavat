{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":95,"content":[{"type":"heading","content":["讚美上帝之歌"]},{"type":"verse","number":1,"content":[{"text":"來吧，讓我們向耶和華歌唱，","poem":1},{"lineBreak":true},{"text":"向拯救我們的磐石歡呼。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"讓我們懷著感恩的心來到祂面前，","poem":1},{"lineBreak":true},{"text":"用詩歌頌揚祂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為耶和華是偉大的上帝，","poem":1},{"lineBreak":true},{"text":"是眾神明之上的大君王。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂掌管地的深處，","poem":1},{"lineBreak":true},{"text":"祂擁有山的高峰。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"海洋屬於祂，是祂創造的，","poem":1},{"lineBreak":true},{"text":"陸地也是祂造的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"來吧，讓我們俯伏敬拜，","poem":1},{"lineBreak":true},{"text":"在創造我們的耶和華面前跪下。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因為祂是我們的上帝，","poem":1},{"lineBreak":true},{"text":"我們是祂照管的子民，","poem":1},{"lineBreak":true},{"text":"是祂牧放的羊群。","poem":1},{"lineBreak":true},{"text":"但願你們今日聽從祂的聲音！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"不可像你們祖先在米利巴，","poem":1},{"lineBreak":true},{"text":"在曠野的瑪撒那樣心裡頑固。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華說：「雖然他們見過我的作為，","poem":1},{"lineBreak":true},{"text":"卻仍然試我、探我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"所以，我憎惡他們四十年之久，","poem":1},{"lineBreak":true},{"text":"我說，『他們心向歧途，不認識我的道路。』","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因此我憤然起誓說，","poem":1},{"lineBreak":true},{"text":"『他們絕不可進入我的安息！』」","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}