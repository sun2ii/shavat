{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":96,"content":[{"type":"heading","content":["上帝是至高的君王"]},{"type":"verse","number":1,"content":[{"text":"你們要向耶和華唱新歌，","poem":1},{"lineBreak":true},{"text":"普世都要歌頌耶和華。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要歌頌耶和華，頌讚祂的名，","poem":1},{"lineBreak":true},{"text":"天天傳揚祂的拯救之恩。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要在列國述說祂的榮耀，","poem":1},{"lineBreak":true},{"text":"在萬民中述說祂的奇妙作為。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因為耶和華無比偉大，","poem":1},{"lineBreak":true},{"text":"當受至高的頌揚；","poem":1},{"lineBreak":true},{"text":"祂超越一切神明，當受敬畏。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"列邦的神明都是假的，","poem":1},{"lineBreak":true},{"text":"唯獨耶和華創造了諸天。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂帶著尊貴和威嚴，","poem":1},{"lineBreak":true},{"text":"祂的聖所充滿能力和榮美。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"萬族萬民啊，","poem":1},{"lineBreak":true},{"text":"要把榮耀和能力歸給耶和華，","poem":1},{"lineBreak":true},{"text":"歸給耶和華！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"要將耶和華之名當得的榮耀歸給祂，","poem":1},{"lineBreak":true},{"text":"要帶著祭物到祂的院宇。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"當敬拜聖潔榮耀的耶和華，","poem":1},{"lineBreak":true},{"text":"大地要在祂面前顫抖。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"要告訴列國：","poem":1},{"lineBreak":true},{"text":"「耶和華掌權，","poem":1},{"lineBreak":true},{"text":"世界堅立不搖，","poem":1},{"lineBreak":true},{"text":"祂必公正地審判萬民。」","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"願天歡喜，願地快樂，","poem":1},{"lineBreak":true},{"text":"願海洋和其中的一切都歡呼。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"願田野和其中的萬物都歡騰，","poem":1},{"lineBreak":true},{"text":"願林中的樹木都在耶和華面前歡唱。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因為祂來了，祂來審判天下，","poem":1},{"lineBreak":true},{"text":"祂要按公義審判世界，","poem":1},{"lineBreak":true},{"text":"憑祂的信實審判萬民。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}