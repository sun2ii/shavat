{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":97,"content":[{"type":"heading","content":["上帝是至高的統治者"]},{"type":"verse","number":1,"content":[{"text":"耶和華掌權，大地要歡欣！","poem":1},{"lineBreak":true},{"text":"眾海島要快樂！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"密雲和黑暗環繞在祂周圍，","poem":1},{"lineBreak":true},{"text":"公義和公平是祂寶座的根基。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"烈火做祂的先鋒，","poem":1},{"lineBreak":true},{"text":"燒滅祂周圍的仇敵。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"祂的閃電照亮世界，","poem":1},{"lineBreak":true},{"text":"大地看見就顫抖。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在天下之主耶和華面前，","poem":1},{"lineBreak":true},{"text":"群山如蠟熔化。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"諸天述說祂的公義，","poem":1},{"lineBreak":true},{"text":"萬民瞻仰祂的榮耀。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"願一切祭拜偶像、","poem":1},{"lineBreak":true},{"text":"以神像誇口的人都蒙羞。","poem":1},{"lineBreak":true},{"text":"所有的神明啊，","poem":1},{"lineBreak":true},{"text":"你們都要向耶和華下拜。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華啊，聽見你的審判，","poem":1},{"lineBreak":true},{"text":"錫安就歡喜，","poem":1},{"lineBreak":true},{"text":"猶大的城邑就快樂。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為你耶和華是普世的至高者，","poem":1},{"lineBreak":true},{"text":"淩駕於萬神之上。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"愛耶和華的人都要憎恨罪惡，","poem":1},{"lineBreak":true},{"text":"因為祂保護敬虔人的生命，","poem":1},{"lineBreak":true},{"text":"從惡人手中解救他們。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"光照亮義人，","poem":1},{"lineBreak":true},{"text":"心底正直的人有喜樂。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你們義人要以耶和華為樂，","poem":1},{"lineBreak":true},{"text":"稱謝祂的聖名。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}