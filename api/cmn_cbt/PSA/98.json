{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":98,"content":[{"type":"heading","content":["頌揚上帝的拯救"]},{"type":"hebrew_subtitle","content":["一首詩歌。"]},{"type":"verse","number":1,"content":[{"text":"你們要向耶和華唱新歌，","poem":1},{"lineBreak":true},{"text":"因為祂的作為奇妙，","poem":1},{"lineBreak":true},{"text":"祂以右手和聖潔的臂膀施行拯救。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華顯明了祂的拯救之恩，","poem":1},{"lineBreak":true},{"text":"向列邦彰顯了祂的公義。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"祂沒有忘記以慈愛和信實對待以色列人，","poem":1},{"lineBreak":true},{"text":"普天下都看見我們上帝的救恩。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"普世要向耶和華歡呼，","poem":1},{"lineBreak":true},{"text":"歡歡喜喜地高聲頌揚。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要彈奏豎琴歌頌耶和華，","poem":1},{"lineBreak":true},{"text":"伴著琴聲唱詩歌頌祂。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"要伴隨著號聲和角聲在大君王耶和華面前歡呼。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"大海和海中的一切要頌揚，","poem":1},{"lineBreak":true},{"text":"大地和地上的一切要歡呼。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"江河要鼓掌，","poem":1},{"lineBreak":true},{"text":"群山要在耶和華面前齊聲歡唱，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為祂要來審判大地，","poem":1},{"lineBreak":true},{"text":"要公義地審判世界，","poem":1},{"lineBreak":true},{"text":"公正地審判萬民。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}