{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cbt","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"459b5a4b12b2ca0929884c296e82479f990b5c49c76874f4a699afa4e3d9e703","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cbt/PSA/150.json","totalNumberOfVerses":2449},"chapter":{"number":99,"content":[{"type":"heading","content":["上帝是聖潔的君王"]},{"type":"verse","number":1,"content":[{"text":"耶和華掌權，萬民當顫抖；","poem":1},{"lineBreak":true},{"text":"祂坐在基路伯天使之上，","poem":1},{"lineBreak":true},{"text":"大地當戰慄。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華在錫安偉大無比，","poem":1},{"lineBreak":true},{"text":"超越萬邦。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"萬邦要讚美你偉大而可畏的名，","poem":1},{"lineBreak":true},{"text":"你是聖潔的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你是大能的君王，","poem":1},{"lineBreak":true},{"text":"喜愛正義，維護公平，","poem":1},{"lineBreak":true},{"text":"在雅各家秉公行義。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要尊崇我們的上帝耶和華，","poem":1},{"lineBreak":true},{"text":"俯伏在祂腳凳前敬拜，","poem":1},{"lineBreak":true},{"text":"祂是聖潔的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祂的祭司中有摩西和亞倫，","poem":1},{"lineBreak":true},{"text":"呼求祂的人中有撒母耳。","poem":1},{"lineBreak":true},{"text":"他們求告耶和華，","poem":1},{"lineBreak":true},{"text":"祂就應允他們。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"祂在雲柱中向他們說話，","poem":1},{"lineBreak":true},{"text":"他們遵守祂賜下的法度和律例。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華，我們的上帝啊，","poem":1},{"lineBreak":true},{"text":"你應允了他們，","poem":1},{"lineBreak":true},{"text":"向他們顯明你是赦罪的上帝，","poem":1},{"lineBreak":true},{"text":"但也懲罰他們的罪惡。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"要尊崇我們的上帝耶和華，","poem":1},{"lineBreak":true},{"text":"在祂的聖山上敬拜祂，","poem":1},{"lineBreak":true},{"text":"因為我們的上帝耶和華是聖潔的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}