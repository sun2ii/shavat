{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbt","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"820389c30d8a5130337eaf73a3bc30375c6a468dc71a42108db52533b55d6738","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["這是所羅門的歌，是歌中最美妙的歌。"]},{"type":"verse","number":2,"content":[{"text":"深深地吻我吧！","poem":1},{"lineBreak":true},{"text":"因為你的愛情比美酒更香甜。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的膏油芬芳怡人，","poem":1},{"lineBreak":true},{"text":"你的美名馨香四溢，","poem":1},{"lineBreak":true},{"text":"如同倒出來的香膏，","poem":1},{"lineBreak":true},{"text":"難怪少女們都愛慕你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你帶我走，讓我們一起奔跑吧！","poem":1},{"lineBreak":true},{"text":"王啊，把我帶進你的寢宮吧！","poem":1},"耶路撒冷的少女：",{"text":"我們為你歡喜快樂，","poem":1},{"lineBreak":true},{"text":"我們要頌揚你那勝似美酒的愛情。","poem":1},"女子：",{"text":"難怪少女們都愛慕你！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶路撒冷的少女啊！","poem":1},{"lineBreak":true},{"text":"我雖然黑似基達的帳篷，","poem":1},{"lineBreak":true},{"text":"卻美如所羅門的錦帳。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"不要因為我被太陽曬黑就看不起我。","poem":1},{"lineBreak":true},{"text":"這是因為我的兄弟惱恨我，","poem":1},{"lineBreak":true},{"text":"要我在烈日之下看守葡萄園，","poem":1},{"lineBreak":true},{"text":"使我無暇照顧自己","poem":1},{"noteId":0},{"text":"。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我心愛的人啊，告訴我吧，","poem":1},{"lineBreak":true},{"text":"你在哪裡牧羊？","poem":1},{"lineBreak":true},{"text":"中午帶羊去哪裡歇息？","poem":1},{"lineBreak":true},{"text":"我何必在你同伴的羊群旁遊蕩，","poem":1},{"lineBreak":true},{"text":"像風塵女子一樣呢？","poem":1}]},{"type":"verse","number":8,"content":[{"text":"絕色佳人啊！","poem":1},{"lineBreak":true},{"text":"要是你不知道，","poem":1},{"lineBreak":true},{"text":"就跟著羊群的足跡，","poem":1},{"lineBreak":true},{"text":"到牧人的帳篷邊餵養你的山羊羔吧。","poem":1}]},{"type":"verse","number":9,"content":[{"text":"我的愛人啊，","poem":1},{"lineBreak":true},{"text":"你好比法老戰車上套的牝馬。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耳環輝映你嫵媚的臉頰，","poem":1},{"lineBreak":true},{"text":"珠鏈輕襯你美麗的頸項。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我們要為你打造鑲有銀珠的金飾。","poem":1}]},{"type":"verse","number":12,"content":[{"text":"王坐席的時候，","poem":1},{"lineBreak":true},{"text":"我身上的哪噠香膏芬芳四溢。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我的良人在我眼中，","poem":1},{"lineBreak":true},{"text":"好像我懷中的一袋沒藥。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我的良人在我眼中，","poem":1},{"lineBreak":true},{"text":"好像隱·基底葡萄園中的鳳仙花。","poem":1}]},{"type":"verse","number":15,"content":[{"text":"我的愛人啊！","poem":1},{"lineBreak":true},{"text":"你真是美極了！美極了！","poem":1},{"lineBreak":true},{"text":"你的雙眸好像鴿子。","poem":1}]},{"type":"verse","number":16,"content":[{"text":"我的良人啊！","poem":1},{"lineBreak":true},{"text":"你真英俊！真可愛！","poem":1},{"lineBreak":true},{"text":"我們以青草作床榻，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"以香柏樹作屋梁，","poem":1},{"lineBreak":true},{"text":"以松樹作椽子。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"「我無暇照顧自己」希伯來文是「我卻無法照料自己的葡萄園。」","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/cmn_cbt/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}