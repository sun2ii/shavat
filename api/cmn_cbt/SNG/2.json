{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbt","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"820389c30d8a5130337eaf73a3bc30375c6a468dc71a42108db52533b55d6738","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"我是沙崙平原的玫瑰花，","poem":1},{"lineBreak":true},{"text":"是谷中的百合花。","poem":1}]},{"type":"verse","number":2,"content":[{"text":"我的愛人在眾少女中，","poem":1},{"lineBreak":true},{"text":"就像荊棘中的一朵百合花。","poem":1}]},{"type":"verse","number":3,"content":[{"text":"我的良人在眾男子中，","poem":1},{"lineBreak":true},{"text":"好像林中的一棵蘋果樹。","poem":1},{"lineBreak":true},{"text":"我歡歡喜喜地坐在他的樹蔭下，","poem":1},{"lineBreak":true},{"text":"輕嘗他香甜可口的果子。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他帶我走進宴席大廳，","poem":1},{"lineBreak":true},{"text":"眾人都看見他對我充滿柔情愛意。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"請用葡萄乾來補充我的力氣，","poem":1},{"lineBreak":true},{"text":"用蘋果來提振我的精神，","poem":1},{"lineBreak":true},{"text":"因為我思愛成病。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他的左手扶著我的頭，","poem":1},{"lineBreak":true},{"text":"他的右手緊抱著我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶路撒冷的少女啊！","poem":1},{"lineBreak":true},{"text":"我指著羚羊和田野的母鹿","poem":1},{"noteId":1},{"text":"吩咐你們，","poem":1},{"lineBreak":true},{"text":"不要叫醒或驚動愛情，","poem":1},{"lineBreak":true},{"text":"等它自發吧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"聽啊！是我良人的聲音，","poem":1},{"lineBreak":true},{"text":"他攀過高崗，躍過山丘，","poem":1},{"lineBreak":true},{"text":"終於來了！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的良人好像羚羊和幼鹿。","poem":1},{"lineBreak":true},{"text":"看啊，他就在牆外，","poem":1},{"lineBreak":true},{"text":"正從窗戶往裡觀看，","poem":1},{"lineBreak":true},{"text":"從窗櫺間往裡凝視。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他對我說：","poem":1},{"lineBreak":true},{"text":"「我的愛人，起來吧！","poem":1},{"lineBreak":true},{"text":"我的佳偶，跟我來！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你看！冬天過去了，","poem":1},{"lineBreak":true},{"text":"雨水止住了。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"大地百花盛開，","poem":1},{"lineBreak":true},{"text":"百鳥爭鳴的季節已經來臨，","poem":1},{"lineBreak":true},{"text":"田野也傳來斑鳩的叫聲。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"無花果快成熟了，","poem":1},{"lineBreak":true},{"text":"葡萄樹也開滿了花，","poem":1},{"lineBreak":true},{"text":"散發著陣陣芬芳。","poem":1},{"lineBreak":true},{"text":"我的愛人，起來吧；","poem":1},{"lineBreak":true},{"text":"我的佳偶，跟我來。」","poem":1}]},{"type":"verse","number":14,"content":[{"text":"我的鴿子啊，","poem":1},{"lineBreak":true},{"text":"你在巖穴中，","poem":1},{"lineBreak":true},{"text":"在懸崖的隱秘處。","poem":1},{"lineBreak":true},{"text":"讓我看看你的臉，","poem":1},{"lineBreak":true},{"text":"聽聽你的聲音吧，","poem":1},{"lineBreak":true},{"text":"因為你的聲音溫柔，","poem":1},{"lineBreak":true},{"text":"你的臉龐秀麗。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"為我們抓住狐狸，","poem":1},{"lineBreak":true},{"text":"抓住破壞葡萄園的小狐狸，","poem":1},{"lineBreak":true},{"text":"因為我們的葡萄樹正在開花。","poem":1}]},{"type":"verse","number":16,"content":[{"text":"我的良人屬於我，我也屬於他。","poem":1},{"lineBreak":true},{"text":"他在百合花間牧放羊群。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的良人啊，","poem":1},{"lineBreak":true},{"text":"涼風吹起、日影飛逝的時候，","poem":1},{"lineBreak":true},{"text":"但願你快快回來，","poem":1},{"lineBreak":true},{"text":"就像比特山的羚羊和小鹿一樣。","poem":1}]},{"type":"line_break"}],"footnotes":[{"noteId":1,"caller":"+","text":"「羚羊和田野的母鹿」在希伯來文中與「萬軍之全能上帝」發音相似。","reference":{"chapter":2,"verse":7}}]},"thisChapterLink":"/api/cmn_cbt/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}