{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbt","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"820389c30d8a5130337eaf73a3bc30375c6a468dc71a42108db52533b55d6738","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"我夜晚躺在床上，","poem":1},{"lineBreak":true},{"text":"思念著我心愛的人；","poem":1},{"lineBreak":true},{"text":"我尋找他，卻找不到。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要起來尋遍城裡的街巷和廣場，","poem":1},{"lineBreak":true},{"text":"我要尋找我心愛的人。","poem":1},{"lineBreak":true},{"text":"我尋找他，卻尋不到。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我遇上城中巡邏的守衛，","poem":1},{"lineBreak":true},{"text":"就問：「你們看到我心愛的人了嗎？」","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我剛離開他們，便找到了我心愛的人。","poem":1},{"lineBreak":true},{"text":"我拉著他，不讓他走；","poem":1},{"lineBreak":true},{"text":"我把他帶回娘家，","poem":1},{"lineBreak":true},{"text":"到懷我者的臥室。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶路撒冷的少女啊！","poem":1},{"lineBreak":true},{"text":"我指著羚羊和田野的母鹿吩咐你們，","poem":1},{"lineBreak":true},{"text":"不要叫醒或驚動愛情，","poem":1},{"lineBreak":true},{"text":"等它自發吧。","poem":1}]},{"type":"verse","number":6,"content":[{"text":"那像煙柱一樣從曠野上來，","poem":1},{"lineBreak":true},{"text":"散發著商人販賣的沒藥、乳香等各樣芬芳之氣的是什麼呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"看啊，是所羅門的轎子，","poem":1},{"lineBreak":true},{"text":"周圍是六十名勇士，","poem":1},{"lineBreak":true},{"text":"都是以色列的精兵。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們個個驍勇善戰，手持利劍，","poem":1},{"lineBreak":true},{"text":"腰配戰刀，防備夜間的偷襲。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"所羅門王用黎巴嫩木為自己造了一頂轎子。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"銀轎柱、金靠背、紫錦坐墊，","poem":1},{"lineBreak":true},{"text":"轎裡裝飾著耶路撒冷少女的愛情。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"錫安的少女啊，","poem":1},{"lineBreak":true},{"text":"出去看看所羅門王的風采吧！","poem":1},{"lineBreak":true},{"text":"他頭上的王冠是他母親在他成婚那天，","poem":1},{"lineBreak":true},{"text":"在他心中歡樂之日為他戴上的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}