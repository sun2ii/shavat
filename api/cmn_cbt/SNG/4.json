{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbt","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"820389c30d8a5130337eaf73a3bc30375c6a468dc71a42108db52533b55d6738","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"我的愛人啊，你真美麗！真美麗！","poem":1},{"lineBreak":true},{"text":"面紗下的雙眸好像鴿子，","poem":1},{"lineBreak":true},{"text":"你的秀髮就好像躍下基列山岡的山羊群。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你的牙齒如同一群新剪了毛、從水裡洗淨上來的母羊，","poem":1},{"lineBreak":true},{"text":"成雙成對，","poem":1},{"lineBreak":true},{"text":"一顆也沒有脫落。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的唇好像朱紅絲帶，","poem":1},{"lineBreak":true},{"text":"你的口嬌美，","poem":1},{"lineBreak":true},{"text":"你面紗後面的雙頰如兩瓣石榴。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的頸項宛若一行行石頭建造的大衛樓塔，","poem":1},{"lineBreak":true},{"text":"上面裝飾著一千個勇士的盾牌。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的胸好像一對小鹿，","poem":1},{"lineBreak":true},{"text":"一對在百合花間吃草的孿生小鹿。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我要登上沒藥山和乳香岡，","poem":1},{"lineBreak":true},{"text":"直到晚風吹起、日影消逝。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的愛人啊，","poem":1},{"lineBreak":true},{"text":"你全然美麗，毫無瑕疵。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的新娘啊，","poem":1},{"lineBreak":true},{"text":"跟我一起離開黎巴嫩，","poem":1},{"lineBreak":true},{"text":"跟我一起離開黎巴嫩吧！","poem":1},{"lineBreak":true},{"text":"離開亞瑪拿山頂，","poem":1},{"lineBreak":true},{"text":"離開示尼珥山和黑門山巔，","poem":1},{"lineBreak":true},{"text":"離開獅穴和豹山吧。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的妹妹，我的新娘啊，","poem":1},{"lineBreak":true},{"text":"你奪去了我的心。","poem":1},{"lineBreak":true},{"text":"你的秋波一閃，","poem":1},{"lineBreak":true},{"text":"你項鏈上的明珠，","poem":1},{"lineBreak":true},{"text":"奪去了我的心。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的妹妹，我的新娘啊，","poem":1},{"lineBreak":true},{"text":"你的愛情多麼迷人，","poem":1},{"lineBreak":true},{"text":"你的愛情比美酒香甜。","poem":1},{"lineBreak":true},{"text":"你身上膏油的芬芳遠勝過一切香料。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的新娘，你的嘴唇滴蜜，","poem":1},{"lineBreak":true},{"text":"你的舌頭底下藏著奶與蜜。","poem":1},{"lineBreak":true},{"text":"你衣服散發的香氣，","poem":1},{"lineBreak":true},{"text":"就像黎巴嫩山一樣芬芳。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我的妹妹，我的新娘，","poem":1},{"lineBreak":true},{"text":"你是緊鎖的園子，","poem":1},{"lineBreak":true},{"text":"封閉的井，隱藏的泉源。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你好像一個石榴果園，","poem":1},{"lineBreak":true},{"text":"結滿了上好的果子，","poem":1},{"lineBreak":true},{"text":"還有鳳仙花和哪噠樹、","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"哪噠和番紅花、菖蒲和肉桂，","poem":1},{"lineBreak":true},{"text":"以及各樣乳香木、沒藥、沉香和一切上好的香料。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你是園中的甘泉，是活水的井，","poem":1},{"lineBreak":true},{"text":"是從黎巴嫩流下來的溪水。","poem":1}]},{"type":"verse","number":16,"content":[{"text":"北風啊，興起吧！","poem":1},{"lineBreak":true},{"text":"南風啊，吹來吧！","poem":1},{"lineBreak":true},{"text":"吹向我的園子，","poem":1},{"lineBreak":true},{"text":"使它的清香四溢。","poem":1},{"lineBreak":true},{"text":"願我的良人走進自己的園中，","poem":1},{"lineBreak":true},{"text":"享受其中的珍果。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}