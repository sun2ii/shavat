{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbt","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"820389c30d8a5130337eaf73a3bc30375c6a468dc71a42108db52533b55d6738","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"我的妹妹，我的新娘啊，","poem":1},{"lineBreak":true},{"text":"我已經來到自己的園中，","poem":1},{"lineBreak":true},{"text":"採了我的沒藥和香料，","poem":1},{"lineBreak":true},{"text":"品嘗了我的蜂房和蜂蜜，","poem":1},{"lineBreak":true},{"text":"也享用了我的美酒和鮮奶。","poem":1},"耶路撒冷的少女：",{"text":"朋友們，盡情吃喝吧。","poem":1},{"lineBreak":true},{"text":"相愛的人啊，沉醉在愛中吧！","poem":1}]},{"type":"verse","number":2,"content":[{"text":"我雖然躺在床上，心卻清醒。","poem":1},{"lineBreak":true},{"text":"我聽見我的良人叩門，說：","poem":1},{"lineBreak":true},{"text":"「開門吧！我的妹妹，我的愛人，","poem":1},{"lineBreak":true},{"text":"我完美無瑕的小鴿子啊，","poem":1},{"lineBreak":true},{"text":"我的頭上沾滿了露水，","poem":1},{"lineBreak":true},{"text":"頭髮被夜間的露珠弄濕了。」","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"可是我已經脫了衣裳，怎能再穿上呢？","poem":1},{"lineBreak":true},{"text":"我已經洗了腳，怎能再沾土呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的良人從門孔伸進手來，","poem":1},{"lineBreak":true},{"text":"我的心神隨之蕩漾，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"就起來為他開門；","poem":1},{"lineBreak":true},{"text":"我的雙手滴下沒藥，","poem":1},{"lineBreak":true},{"text":"門閂也沾了我指頭滴下的沒藥。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我為良人開了門，","poem":1},{"lineBreak":true},{"text":"他卻已經離開了。","poem":1},{"lineBreak":true},{"text":"他的離去使我心中失落。","poem":1},{"noteId":2},{"lineBreak":true},{"text":"我到處找他，卻找不著；","poem":1},{"lineBreak":true},{"text":"我呼喚他，卻得不到回答。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"城中巡邏的衛兵遇見我，","poem":1},{"lineBreak":true},{"text":"把我打傷了，","poem":1},{"lineBreak":true},{"text":"看守城牆的人還搶走了我的披肩。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶路撒冷的少女啊，","poem":1},{"lineBreak":true},{"text":"我懇求你們，","poem":1},{"lineBreak":true},{"text":"倘若遇見我的良人，","poem":1},{"lineBreak":true},{"text":"請告訴他我思愛成病。","poem":1}]},{"type":"verse","number":9,"content":[{"text":"絕色佳人啊！","poem":1},{"lineBreak":true},{"text":"你的良人與別的男子比較，","poem":1},{"lineBreak":true},{"text":"究竟有什麼長處，","poem":1},{"lineBreak":true},{"text":"以致你這樣懇求我們呢？","poem":1}]},{"type":"verse","number":10,"content":[{"text":"我的良人紅光滿面，","poem":1},{"lineBreak":true},{"text":"超越萬人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他頭如純金，","poem":1},{"lineBreak":true},{"text":"頭髮像波浪，","poem":1},{"lineBreak":true},{"text":"黑如烏鴉。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他的眼睛清澈明亮，","poem":1},{"lineBreak":true},{"text":"如同溪旁用奶洗淨的白鴿，","poem":1},{"lineBreak":true},{"text":"如同鑲嵌合適的寶石。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他的雙頰芬芳，","poem":1},{"lineBreak":true},{"text":"猶如種滿香草的花圃。","poem":1},{"lineBreak":true},{"text":"他的嘴唇好像滴著沒藥汁的百合花。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他的雙臂如同鑲著水蒼玉的金杖，","poem":1},{"lineBreak":true},{"text":"身體如同鑲嵌藍寶石的象牙。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他的雙腿好像純金座上的白玉石柱，","poem":1},{"lineBreak":true},{"text":"他的容貌像黎巴嫩，","poem":1},{"lineBreak":true},{"text":"佳美如香柏樹。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他的嘴甘甜，","poem":1},{"lineBreak":true},{"text":"整個人都令人愛慕。","poem":1},{"lineBreak":true},{"text":"耶路撒冷的少女啊，","poem":1},{"lineBreak":true},{"text":"這就是我的良人，","poem":1},{"lineBreak":true},{"text":"我的朋友。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"「他的離去使我心中失落」或譯「他說話時，我神不守舍」。","reference":{"chapter":5,"verse":6}}]},"thisChapterLink":"/api/cmn_cbt/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}