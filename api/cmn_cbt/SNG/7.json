{"translation":{"id":"cmn_cbt","name":"Biblica® 聖經，當代譯本開放資源","website":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmncbt","licenseNotes":null,"shortName":"CBT","englishName":"Chinese, Mandarin: Biblica® 聖經,當代譯本開放資源 (Bible)","language":"cmn","textDirection":"ltr","sha256":"b36dae22680d13a66a36842989888505161ddf7eefb726364331d95aae2197c4","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30961,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cbt","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"820389c30d8a5130337eaf73a3bc30375c6a468dc71a42108db52533b55d6738","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cbt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cbt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"我的公主啊，你的腳配上鞋多麼美啊！","poem":1},{"lineBreak":true},{"text":"你美玉般圓潤的腿是巧匠的傑作。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你的肚臍好像不缺調和酒的圓杯。","poem":1},{"lineBreak":true},{"text":"你的腰好像被百合花環繞的麥堆。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的胸好像一對小鹿，","poem":1},{"lineBreak":true},{"text":"一對孿生小鹿。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的脖子宛如象牙塔，","poem":1},{"lineBreak":true},{"text":"眼睛好像希實本境內巴特·拉並門旁的水池。","poem":1},{"lineBreak":true},{"text":"你的鼻子好像眺望大馬士革的黎巴嫩塔。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的頭高昂如迦密山，","poem":1},{"lineBreak":true},{"text":"你的秀髮好像紫錦，","poem":1},{"lineBreak":true},{"text":"君王的心被你的縷縷青絲繫住。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的愛人，你是多麼美麗，","poem":1},{"lineBreak":true},{"text":"多麼討人喜愛，令人陶醉啊！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你亭亭玉立如同棕樹，","poem":1},{"lineBreak":true},{"text":"你的胸就像樹上的果串。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我要攀上這棕樹，","poem":1},{"lineBreak":true},{"text":"握住樹上的果子。","poem":1},{"lineBreak":true},{"text":"願你的胸像葡萄串，","poem":1},{"lineBreak":true},{"text":"你的氣息如蘋果般清香。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你的親吻像上好的美酒。","poem":1},"女子：",{"text":"願美酒流入我良人的口中，","poem":1},{"lineBreak":true},{"text":"緩緩注入他陶醉的唇齒間。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我屬於我的良人，","poem":1},{"lineBreak":true},{"text":"是他所戀慕的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的良人，來吧！","poem":1},{"lineBreak":true},{"text":"讓我們到田間去，","poem":1},{"lineBreak":true},{"text":"在村莊裡住宿吧。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我們清晨去葡萄園，","poem":1},{"lineBreak":true},{"text":"看看葡萄樹是否已經發芽開花，","poem":1},{"lineBreak":true},{"text":"石榴樹是否正在開花。","poem":1},{"lineBreak":true},{"text":"我要在那裡把我的愛情獻給你。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"那裡風茄飄香，","poem":1},{"lineBreak":true},{"text":"門口有各樣上好的新陳美果。","poem":1},{"lineBreak":true},{"text":"我的良人，這都是我為你存留的。","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/cmn_cbt/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cbt/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cbt/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}