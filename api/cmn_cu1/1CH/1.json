{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"1CH","translationId":"cmn_cu1","name":"历代志上","commonName":"历代志上","title":"历代志上","order":13,"numberOfChapters":29,"sha256":"d2d0580e06c55b9e400ab219f7145534e6a1f88cc8ea7d8b90ad9f9171320d26","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cmn_cu1/1CH/29.json","totalNumberOfVerses":939},"chapter":{"number":1,"content":[{"type":"heading","content":["从亚当到亚伯拉罕"]},{"type":"verse","number":1,"content":["亚当生塞特；塞特生以挪士；"]},{"type":"verse","number":2,"content":["以挪士生该南；该南生玛勒列；玛勒列生雅列；"]},{"type":"verse","number":3,"content":["雅列生以诺；以诺生玛土撒拉；玛土撒拉生拉麦；"]},{"type":"verse","number":4,"content":["拉麦生挪亚；挪亚生闪、含、雅弗。"]},{"type":"verse","number":5,"content":["雅弗的儿子是歌篾、玛各、玛代、雅完、土巴、米设、提拉。"]},{"type":"verse","number":6,"content":["歌篾的儿子是亚实基拿、低法",{"noteId":0},"、陀迦玛。"]},{"type":"verse","number":7,"content":["雅完的儿子是以利沙、他施、基提、多单",{"noteId":1},"。"]},{"type":"verse","number":8,"content":["含的儿子是古实、麦西、弗、迦南。"]},{"type":"verse","number":9,"content":["古实的儿子是西巴、哈腓拉、撒弗他、拉玛、撒弗提迦。拉玛的儿子是示巴、底但。"]},{"type":"verse","number":10,"content":["古实生宁录；他为世上英雄之首。"]},{"type":"verse","number":11,"content":["麦西生路低人、亚拿米人、利哈比人、拿弗土希人、"]},{"type":"verse","number":12,"content":["帕斯鲁细人、迦斯路希人、迦斐托人；从迦斐托出来的有非利士人。"]},{"type":"verse","number":13,"content":["迦南生长子西顿，又生赫"]},{"type":"verse","number":14,"content":["和耶布斯人、亚摩利人、革迦撒人、"]},{"type":"verse","number":15,"content":["希未人、亚基人、西尼人、"]},{"type":"verse","number":16,"content":["亚瓦底人、洗玛利人，并哈马人。"]},{"type":"verse","number":17,"content":["闪的儿子是以拦、亚述、亚法 撒、路德、亚兰、乌斯、户勒、基帖、米设",{"noteId":2},"。"]},{"type":"verse","number":18,"content":["亚法撒生沙拉；沙拉生希伯。"]},{"type":"verse","number":19,"content":["希伯生了两个儿子：一个名叫法勒",{"noteId":3},"，因为那时人就分地居住；法勒的兄弟名叫约坍。"]},{"type":"verse","number":20,"content":["约坍生亚摩答、沙列、哈萨玛非、耶拉、"]},{"type":"verse","number":21,"content":["哈多兰、乌萨、德拉、"]},{"type":"verse","number":22,"content":["以巴录、亚比玛利、示巴、"]},{"type":"verse","number":23,"content":["阿斐、哈腓拉、约巴。这都是约坍的儿子。"]},{"type":"verse","number":24,"content":["闪生亚法撒；亚法撒生沙拉；"]},{"type":"verse","number":25,"content":["沙拉生希伯；希伯生法勒；法勒生拉吴；"]},{"type":"verse","number":26,"content":["拉吴生西鹿；西鹿生拿鹤；拿鹤生他拉；"]},{"type":"verse","number":27,"content":["他拉生亚伯兰，亚伯兰就是亚伯拉罕。"]},{"type":"heading","content":["以实玛利的后裔"]},{"type":"verse","number":28,"content":["亚伯拉罕的儿子是以撒、以实玛利。"]},{"type":"verse","number":29,"content":["以实玛利的儿子记在下面：以实玛利的长子是尼拜约，其次是基达、押德别、米比衫、"]},{"type":"verse","number":30,"content":["米施玛、度玛、玛撒、哈达、提玛、"]},{"type":"verse","number":31,"content":["伊突、拿非施、基底玛。这都是以实玛利的儿子。"]},{"type":"verse","number":32,"content":["亚伯拉罕的妾基土拉所生的儿子，就是心兰、约珊、米但、米甸、伊施巴、书亚。约珊的儿子是示巴、底但。"]},{"type":"verse","number":33,"content":["米甸的儿子是以法、以弗、哈诺、亚比大、以勒大。这都是基土拉的子孙。"]},{"type":"heading","content":["以扫的后裔"]},{"type":"verse","number":34,"content":["亚伯拉罕生以撒；以撒的儿子是以扫和以色列。"]},{"type":"verse","number":35,"content":["以扫的儿子是以利法、流珥、耶乌施、雅兰、可拉。"]},{"type":"verse","number":36,"content":["以利法的儿子是提幔、阿抹、洗玻、迦坦、基纳斯、亭纳、亚玛力。"]},{"type":"verse","number":37,"content":["流珥的儿子是拿哈、谢拉、沙玛、米撒。"]},{"type":"heading","content":["以东地的原住民"]},{"type":"verse","number":38,"content":["西珥的儿子是罗坍、朔巴、祭便、亚拿、底顺、以察、底珊。"]},{"type":"verse","number":39,"content":["罗坍的儿子是何利、荷幔；罗坍的妹子是亭纳。"]},{"type":"verse","number":40,"content":["朔巴的儿子是亚勒文、玛拿辖、以巴录、示非、阿南。祭便的儿子是亚雅、亚拿。"]},{"type":"verse","number":41,"content":["亚拿的儿子是底顺。底顺的儿子是哈默兰、伊是班、益兰、基兰。"]},{"type":"verse","number":42,"content":["以察的儿子是辟罕、撒番、亚干。底珊的儿子是乌斯、亚兰。"]},{"type":"heading","content":["以东诸王"]},{"type":"verse","number":43,"content":["以色列人未有君王治理之先，在以东地作王的记在下面：有比珥的儿子比拉，他的京城名叫亭哈巴。"]},{"type":"verse","number":44,"content":["比拉死了，波斯拉人谢拉的儿子约巴接续他作王。"]},{"type":"verse","number":45,"content":["约巴死了，提幔地的人户珊接续他作王。"]},{"type":"verse","number":46,"content":["户珊死了，比达的儿子哈达接续他作王。这哈达就是在摩押地杀败米甸人的，他的京城名叫亚未得。"]},{"type":"verse","number":47,"content":["哈达死了，玛士利加人桑拉接续他作王。"]},{"type":"verse","number":48,"content":["桑拉死了，大河边的利河伯人扫罗接续他作王。"]},{"type":"verse","number":49,"content":["扫罗死了，亚革波的儿子巴勒·哈南接续他作王。"]},{"type":"verse","number":50,"content":["巴勒·哈南死了，哈达接续他作王。他的京城名叫巴伊，他的妻子名叫米希她别，是米·萨合的孙女，玛特列的女儿。"]},{"type":"verse","number":51,"content":["哈达死了，以东人的族长有亭纳族长、亚勒瓦族长、耶帖族长、"]},{"type":"verse","number":52,"content":["亚何利巴玛族长、以拉族长、比嫩族长、"]},{"type":"verse","number":53,"content":["基纳斯族长、提幔族长、米比萨族长、"]},{"type":"verse","number":54,"content":["玛基叠族长、以兰族长。这都是以东人的族长。"]}],"footnotes":[{"noteId":0,"caller":"-","text":"在创世记十章三节是利法","reference":{"chapter":1,"verse":6}},{"noteId":1,"caller":"-","text":"有作罗单的","reference":{"chapter":1,"verse":7}},{"noteId":2,"caller":"-","text":"在创世记十章二十三节是玛施","reference":{"chapter":1,"verse":17}},{"noteId":3,"caller":"-","text":"就是分的意思","reference":{"chapter":1,"verse":19}}]},"thisChapterLink":"/api/cmn_cu1/1CH/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/1CH/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/2KI/25.json","previousChapterAudioLinks":{},"numberOfVerses":54}