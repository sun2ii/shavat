{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"1CH","translationId":"cmn_cu1","name":"历代志上","commonName":"历代志上","title":"历代志上","order":13,"numberOfChapters":29,"sha256":"d2d0580e06c55b9e400ab219f7145534e6a1f88cc8ea7d8b90ad9f9171320d26","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cmn_cu1/1CH/29.json","totalNumberOfVerses":939},"chapter":{"number":2,"content":[{"type":"heading","content":["犹大的后裔"]},{"type":"verse","number":1,"content":["以色列的儿子是吕便、西缅、利未、犹大、以萨迦、西布伦、"]},{"type":"verse","number":2,"content":["但、约瑟、便雅悯、拿弗他利、迦得、亚设。"]},{"type":"verse","number":3,"content":["犹大的儿子是珥、俄南、示拉，这三人是迦南人书亚女儿所生的。犹大的长子珥在耶和华眼中看为恶，耶和华就使他死了。"]},{"type":"verse","number":4,"content":["犹大的儿妇她玛给犹大生法勒斯和谢拉。犹大共有五个儿子。"]},{"type":"verse","number":5,"content":["法勒斯的儿子是希斯 、哈母勒。"]},{"type":"verse","number":6,"content":["谢拉的儿子是心利、以探、希幔、甲各、大拉",{"noteId":4},"，共五人。"]},{"type":"verse","number":7,"content":["迦米的儿子是亚干，这亚干在当灭的物上犯了罪，连累了以色列人。"]},{"type":"verse","number":8,"content":["以探的儿子是亚撒利雅。"]},{"type":"heading","content":["大卫王的家谱"]},{"type":"verse","number":9,"content":["希斯 所生的儿子是耶拉篾、兰、基路拜。"]},{"type":"verse","number":10,"content":["兰生亚米拿达；亚米拿达生拿顺。拿顺作犹大人的首领。"]},{"type":"verse","number":11,"content":["拿顺生撒门；撒门生波阿斯；"]},{"type":"verse","number":12,"content":["波阿斯生俄备得；俄备得生耶西；"]},{"type":"verse","number":13,"content":["耶西生长子以利押，次子亚比拿达，三子示米亚",{"noteId":5},"，"]},{"type":"verse","number":14,"content":["四子拿坦业，五子拉代，"]},{"type":"verse","number":15,"content":["六子阿鲜，七子大卫。"]},{"type":"verse","number":16,"content":["他们的姊妹是洗鲁雅和亚比该。洗鲁雅的儿子是亚比筛、约押、亚撒黑，共三人。"]},{"type":"verse","number":17,"content":["亚比该生亚玛撒；亚玛撒的父亲是以实玛利人益帖。"]},{"type":"heading","content":["希斯 的后裔"]},{"type":"verse","number":18,"content":["希斯 的儿子迦勒娶阿苏巴和耶略为妻，阿苏巴的儿子是耶设、朔罢、押墩。"]},{"type":"verse","number":19,"content":["阿苏巴死了，迦勒又娶以法她，生了户珥。"]},{"type":"verse","number":20,"content":["户珥生乌利；乌利生比撒列。"]},{"type":"verse","number":21,"content":["希斯 正六十岁娶了基列父亲玛吉的女儿，与她同房；玛吉的女儿生了西割；"]},{"type":"verse","number":22,"content":["西割生睚珥。睚珥在基列地有二十三个城邑。"]},{"type":"verse","number":23,"content":["后来基述人和亚兰人夺了睚珥的城邑，并基纳和其乡村，共六十个。这都是基列父亲玛吉之子的。"]},{"type":"verse","number":24,"content":["希斯 在迦勒·以法他死后，他的妻亚比雅给他生了亚施户；亚施户是提哥亚的父亲。"]},{"type":"heading","content":["耶拉篾的后裔"]},{"type":"verse","number":25,"content":["希斯 的长子耶拉篾生长子兰，又生布拿、阿连、阿鲜、亚希雅。"]},{"type":"verse","number":26,"content":["耶拉篾又娶一妻名叫亚她拉，是阿南的母亲。"]},{"type":"verse","number":27,"content":["耶拉篾长子兰的儿子是玛斯、雅悯、以结。"]},{"type":"verse","number":28,"content":["阿南的儿子是沙买、雅大。沙买的儿子是拿答、亚比述。"]},{"type":"verse","number":29,"content":["亚比述的妻名叫亚比孩，亚比孩给他生了亚办和摩利。"]},{"type":"verse","number":30,"content":["拿答的儿子是西列、亚遍；西列死了没有儿子。"]},{"type":"verse","number":31,"content":["亚遍的儿子是以示；以示的儿子是示珊；示珊的儿子是亚来。"]},{"type":"verse","number":32,"content":["沙买兄弟雅大的儿子是益帖、约拿单；益帖死了没有儿子。"]},{"type":"verse","number":33,"content":["约拿单的儿子是比勒、撒萨。这都是耶拉篾的子孙。"]},{"type":"verse","number":34,"content":["示珊没有儿子，只有女儿。示珊有一个仆人名叫耶哈，是埃及人。"]},{"type":"verse","number":35,"content":["示珊将女儿给了仆人耶哈为妻，给他生了亚太。"]},{"type":"verse","number":36,"content":["亚太生拿单；拿单生撒拔；"]},{"type":"verse","number":37,"content":["撒拔生以弗拉；以弗拉生俄备得；"]},{"type":"verse","number":38,"content":["俄备得生耶户；耶户生亚撒利雅；"]},{"type":"verse","number":39,"content":["亚撒利雅生希利斯；希利斯生以利亚萨；"]},{"type":"verse","number":40,"content":["以利亚萨生西斯买；西斯买生沙龙；"]},{"type":"verse","number":41,"content":["沙龙生耶加米雅；耶加米雅生以利沙玛。"]},{"type":"heading","content":["迦勒的其余后裔"]},{"type":"verse","number":42,"content":["耶拉篾兄弟迦勒的长子米沙，是西弗之祖玛利沙的儿子，是希伯 之祖。"]},{"type":"verse","number":43,"content":["希伯 的儿子是可拉、他普亚、利肯、示玛。"]},{"type":"verse","number":44,"content":["示玛生拉含，是约干之祖。利肯生沙买。"]},{"type":"verse","number":45,"content":["沙买的儿子是玛云；玛云是伯·夙之祖。"]},{"type":"verse","number":46,"content":["迦勒的妾以法生哈兰、摩撒、迦谢；哈兰生迦卸。（"]},{"type":"verse","number":47,"content":["雅代的儿子是利健、约坦、基珊、毗力、以法、沙亚弗。）"]},{"type":"verse","number":48,"content":["迦勒的妾玛迦生示别、特哈拿，"]},{"type":"verse","number":49,"content":["又生麦玛拿之祖沙亚弗、抹比拿和基比亚之祖示法。迦勒的女儿是押撒。"]},{"type":"verse","number":50,"content":["迦勒的子孙就是以法她的长子、户珥的儿子，记在下面：基列·耶琳之祖朔巴，"]},{"type":"verse","number":51,"content":["伯利恒之祖萨玛，伯迦得之祖哈勒。"]},{"type":"verse","number":52,"content":["基列·耶琳之祖朔巴的子孙是哈罗以和一半米努·哈人",{"noteId":6},"。"]},{"type":"verse","number":53,"content":["基列·耶琳的诸族是以帖人、布特人、舒玛人、密来人，又从这些族中生出琐拉人和以实陶人来。"]},{"type":"verse","number":54,"content":["萨玛的子孙是伯利恒人、尼陀法人、亚他绿·伯·约押人、一半玛拿哈人、琐利人，"]},{"type":"verse","number":55,"content":["和住雅比斯众文士家的特拉人、示米押人、苏甲人。这都是基尼人利甲家之祖哈末所生的。"]}],"footnotes":[{"noteId":4,"caller":"-","text":"就是达大","reference":{"chapter":2,"verse":6}},{"noteId":5,"caller":"-","text":"示米亚就是沙玛，见撒母耳上十六章九节","reference":{"chapter":2,"verse":13}},{"noteId":6,"caller":"-","text":"米努·哈人就是玛拿哈人","reference":{"chapter":2,"verse":52}}]},"thisChapterLink":"/api/cmn_cu1/1CH/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/1CH/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/1CH/1.json","previousChapterAudioLinks":{},"numberOfVerses":55}