{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"1CH","translationId":"cmn_cu1","name":"历代志上","commonName":"历代志上","title":"历代志上","order":13,"numberOfChapters":29,"sha256":"d2d0580e06c55b9e400ab219f7145534e6a1f88cc8ea7d8b90ad9f9171320d26","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cmn_cu1/1CH/29.json","totalNumberOfVerses":939},"chapter":{"number":8,"content":[{"type":"heading","content":["便雅悯的后裔"]},{"type":"verse","number":1,"content":["便雅悯的长子比拉，次子亚实别，三子亚哈拉，"]},{"type":"verse","number":2,"content":["四子挪哈，五子拉法。"]},{"type":"verse","number":3,"content":["比拉的儿子是亚大、基拉、亚比忽、"]},{"type":"verse","number":4,"content":["亚比书、乃幔、亚何亚、"]},{"type":"verse","number":5,"content":["基拉、示孚汛、户兰。"]},{"type":"verse","number":6,"content":["以忽的儿子作迦巴居民的族长，被掳到玛拿辖；"]},{"type":"verse","number":7,"content":["以忽的儿子乃幔、亚希亚、基拉也被掳去。基拉生乌撒、亚希忽。"]},{"type":"verse","number":8,"content":["沙哈连休他二妻户伸和巴拉之后，在摩押地生了儿子。"]},{"type":"verse","number":9,"content":["他与妻贺得同房，生了约巴、洗比雅、米沙、玛拉干、"]},{"type":"verse","number":10,"content":["耶乌斯、沙迦、米玛。他这些儿子都是族长。"]},{"type":"verse","number":11,"content":["他的妻户伸给他生的儿子有亚比突、以利巴力。"]},{"type":"verse","number":12,"content":["以利巴力的儿子是希伯、米珊、沙麦。沙麦建立阿挪和罗德二城与其村庄。"]},{"type":"heading","content":["在亚雅 的便雅悯人"]},{"type":"verse","number":13,"content":["又有比利亚和示玛是亚雅 居民的族长，是驱逐迦特人的。"]},{"type":"verse","number":14,"content":["亚希约、沙煞、耶利末、"]},{"type":"verse","number":15,"content":["西巴第雅、亚拉得、亚得、"]},{"type":"verse","number":16,"content":["米迦勒、伊施巴、约哈都是比利亚的儿子。"]},{"type":"heading","content":["在耶路撒冷的便雅悯人"]},{"type":"verse","number":17,"content":["西巴第雅、米书兰、希西基、希伯、"]},{"type":"verse","number":18,"content":["伊施米莱、伊斯利亚、约巴都是以利巴力的儿子。"]},{"type":"verse","number":19,"content":["雅金、细基 利、撒底、"]},{"type":"verse","number":20,"content":["以利乃、洗勒太、以列、"]},{"type":"verse","number":21,"content":["亚大雅、比拉雅、申拉都是示每的儿子。"]},{"type":"verse","number":22,"content":["伊施班、希伯、以列、"]},{"type":"verse","number":23,"content":["亚伯顿、细基利、哈难、"]},{"type":"verse","number":24,"content":["哈拿尼雅、以拦、安陀提雅、"]},{"type":"verse","number":25,"content":["伊弗底雅、毗努伊勒都是沙煞的儿子。"]},{"type":"verse","number":26,"content":["珊示莱、示哈利、亚他利雅、"]},{"type":"verse","number":27,"content":["雅利西、以利亚、细基利都是耶罗罕的儿子。"]},{"type":"verse","number":28,"content":["这些人都是著名的族长，住在耶路撒冷。"]},{"type":"heading","content":["在基遍和耶路撒冷的便雅悯人"]},{"type":"verse","number":29,"content":["在基遍住的有基遍的父亲耶利。他的妻名叫玛迦；"]},{"type":"verse","number":30,"content":["他长子是亚伯顿。他又生苏珥、基士、巴力、拿答、"]},{"type":"verse","number":31,"content":["基多、亚希约、撒迦、米基罗。"]},{"type":"verse","number":32,"content":["米基罗生示米暗。这些人和他们的弟兄在耶路撒冷对面居住。"]},{"type":"heading","content":["扫罗王的家族"]},{"type":"verse","number":33,"content":["尼珥生基士；基士生扫罗；扫罗生约拿单、麦基舒亚、亚比拿达、伊施·巴力。"]},{"type":"verse","number":34,"content":["约拿单的儿子是米力·巴力",{"noteId":8},"；米力·巴力生米迦。"]},{"type":"verse","number":35,"content":["米迦的儿子是毗敦、米勒、他利亚、亚哈斯；"]},{"type":"verse","number":36,"content":["亚哈斯生耶何阿达；耶何阿达生亚拉篾、亚斯玛威、心利；心利生摩撒；"]},{"type":"verse","number":37,"content":["摩撒生比尼亚；比尼亚的儿子是拉法；拉法的儿子是以利亚萨；以利亚萨的儿子是亚悉。"]},{"type":"verse","number":38,"content":["亚悉有六个儿子，他们的名字是亚斯利干、波基路、以实玛利、示亚利雅、俄巴底雅、哈难。这都是亚悉的儿子。"]},{"type":"verse","number":39,"content":["亚悉兄弟以设的长子是乌兰，次子耶乌施，三子是以利法列。"]},{"type":"verse","number":40,"content":["乌兰的儿子都是大能的勇士，是弓箭手，他们有许多的子孙，共一百五十名，都是便雅悯人。"]}],"footnotes":[{"noteId":8,"caller":"-","text":"在撒母耳下四章四节是米非波设","reference":{"chapter":8,"verse":34}}]},"thisChapterLink":"/api/cmn_cu1/1CH/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/1CH/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/1CH/7.json","previousChapterAudioLinks":{},"numberOfVerses":40}