{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"1PE","translationId":"cmn_cu1","name":"彼得前书","commonName":"彼得前书","title":"彼得前书","order":60,"numberOfChapters":5,"sha256":"7dd06bf3640798c48402d95c7029fea9dd3ca3d652c59417d5c51123ee5227fe","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/1PE/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cu1/1PE/5.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["活石和圣洁的国度"]},{"type":"verse","number":1,"content":["所以，你们既除去一切的恶毒",{"noteId":3},"、诡诈，并假善、嫉妒，和一切毁谤的话，"]},{"type":"verse","number":2,"content":["就要爱慕那纯净的灵奶，像才生的婴孩爱慕奶一样，叫你们因此渐长，以致得救。"]},{"type":"verse","number":3,"content":["你们若尝过主恩的滋味，就必如此。"]},{"type":"verse","number":4,"content":["主乃活石，固然是被人所弃的，却是被 神所拣选、所宝贵的。"]},{"type":"verse","number":5,"content":["你们来到主面前，也就像活石，被建造成为灵宫，作圣洁的祭司，借着耶稣基督奉献 神所悦纳的灵祭。"]},{"type":"verse","number":6,"content":["因为经上说：",{"text":"看哪，我把所拣选、","poem":1},{"lineBreak":true},{"text":"所宝贵的房角石安放在锡安；","poem":1},{"lineBreak":true},{"text":"信靠他的人必不至于羞愧。","poem":1}]},{"type":"verse","number":7,"content":["所以，他在你们信的人就为宝贵，在那不信的人有话说：",{"text":"匠人所弃的石头","poem":1},{"lineBreak":true},{"text":"已作了房角的头块石头。","poem":1}]},{"type":"verse","number":8,"content":["又说：作了绊脚的石头，跌人的磐石。他们既不顺从，就在道理上绊跌",{"noteId":4},"；他们这样绊跌也是预定的。"]},{"type":"verse","number":9,"content":["惟有你们是被拣选的族类，是有君尊的祭司，是圣洁的国度，是属 神的子民，要叫你们宣扬那召你们出黑暗入奇妙光明者的美德。"]},{"type":"verse","number":10,"content":[{"text":"你们从前算不得子民，","poem":1},{"lineBreak":true},{"text":"现在却作了 神的子民；","poem":1},{"lineBreak":true},{"text":"从前未曾蒙怜恤，","poem":1},{"lineBreak":true},{"text":"现在却蒙了怜恤。","poem":1}]},{"type":"heading","content":["作 神的仆人"]},{"type":"verse","number":11,"content":["亲爱的弟兄啊，你们是客旅，是寄居的。我劝你们要禁戒肉体的私欲；这私欲是与灵魂争战的。"]},{"type":"verse","number":12,"content":["你们在外邦人中，应当品行端正，叫那些毁谤你们是作恶的，因看见你们的好行为，便在鉴察",{"noteId":5},"的日子归荣耀给 神。"]},{"type":"verse","number":13,"content":["你们为主的缘故，要顺服人的一切制度，或是在上的君王，"]},{"type":"verse","number":14,"content":["或是君王所派罚恶赏善的臣宰。"]},{"type":"verse","number":15,"content":["因为 神的旨意原是要你们行善，可以堵住那糊涂无知人的口。"]},{"type":"verse","number":16,"content":["你们虽是自由的，却不可借着自由遮盖恶毒",{"noteId":6},"，总要作 神的仆人。"]},{"type":"verse","number":17,"content":["务要尊敬众人，亲爱教中的弟兄，敬畏 神，尊敬君王。"]},{"type":"heading","content":["基督受苦的榜样"]},{"type":"verse","number":18,"content":["你们作仆人的，凡事要存敬畏的心顺服主人；不但顺服那善良温和的，就是那乖僻的也要顺服。"]},{"type":"verse","number":19,"content":["倘若人为叫良心对得住 神，就忍受冤屈的苦楚，这是可喜爱的。"]},{"type":"verse","number":20,"content":["你们若因犯罪受责打，能忍耐，有什么可夸的呢？但你们若因行善受苦，能忍耐，这在 神看是可喜爱的。"]},{"type":"verse","number":21,"content":["你们蒙召原是为此；因基督也为你们受过苦，给你们留下榜样，叫你们跟随他的脚踪行。"]},{"type":"verse","number":22,"content":["他并没有犯罪，口里也没有诡诈。"]},{"type":"verse","number":23,"content":["他被骂不还口；受害不说威吓的话，只将自己交托那按公义审判人的主。"]},{"type":"verse","number":24,"content":["他被挂在木头上，亲身担当了我们的罪，使我们既然在罪上死，就得以在义上活。因他受的鞭伤，你们便得了医治。"]},{"type":"verse","number":25,"content":["你们从前好像迷路的羊，如今却归到你们灵魂的牧人监督了。"]}],"footnotes":[{"noteId":3,"caller":"-","text":"或译：阴毒","reference":{"chapter":2,"verse":1}},{"noteId":4,"caller":"-","text":"或译：他们绊跌都因不顺从道理","reference":{"chapter":2,"verse":8}},{"noteId":5,"caller":"-","text":"或译：眷顾","reference":{"chapter":2,"verse":12}},{"noteId":6,"caller":"-","text":"或译：阴毒","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/cmn_cu1/1PE/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/1PE/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/1PE/1.json","previousChapterAudioLinks":{},"numberOfVerses":25}