{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"2CH","translationId":"cmn_cu1","name":"历代志下","commonName":"历代志下","title":"历代志下","order":14,"numberOfChapters":36,"sha256":"11e64342757a4a6aa21c0c6299496e1b4d142c8a04944b979b3bf57868809712","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/cmn_cu1/2CH/36.json","totalNumberOfVerses":821},"chapter":{"number":11,"content":[{"type":"heading","content":["示玛雅的预言"]},{"type":"verse","number":1,"content":["罗波安来到耶路撒冷，招聚犹大家和便雅悯家，共十八万人，都是挑选的战士，要与以色列人争战，好将国夺回再归自己。"]},{"type":"verse","number":2,"content":["但耶和华的话临到神人示玛雅说："]},{"type":"verse","number":3,"content":["「你去告诉所罗门的儿子犹大王罗波安和住犹大、便雅悯的以色列众人说，"]},{"type":"verse","number":4,"content":["耶和华如此说：『你们不可上去与你们的弟兄争战，各归各家去吧！因为这事出于我。』」众人就听从耶和华的话归回，不去与耶罗波安争战。"]},{"type":"heading","content":["罗波安修筑诸城"]},{"type":"verse","number":5,"content":["罗波安住在耶路撒冷，在犹大地修筑城邑，"]},{"type":"verse","number":6,"content":["为保障修筑伯利恒、以坦、提哥亚、"]},{"type":"verse","number":7,"content":["伯·夙、梭哥、亚杜兰、"]},{"type":"verse","number":8,"content":["迦特、玛利沙、西弗、"]},{"type":"verse","number":9,"content":["亚多莱音、拉吉、亚西加、"]},{"type":"verse","number":10,"content":["琐拉、亚雅 、希伯 。这都是犹大和便雅悯的坚固城。"]},{"type":"verse","number":11,"content":["罗波安又坚固各处的保障，在其中安置军长，又预备下粮食、油、酒。"]},{"type":"verse","number":12,"content":["他在各城里预备盾牌和枪，且使城极其坚固。犹大和便雅悯都归了他。"]},{"type":"heading","content":["祭司和利未人都归犹大"]},{"type":"verse","number":13,"content":["以色列全地的祭司和利未人都从四方来归罗波安。"]},{"type":"verse","number":14,"content":["利未人撇下他们的郊野和产业，来到犹大与耶路撒 冷，是因耶罗波安和他的儿子拒绝他们，不许他们供祭司职分事奉耶和华。"]},{"type":"verse","number":15,"content":["耶罗波安为邱坛、为鬼魔",{"noteId":2},"、为自己所铸造的牛犊设立祭司。"]},{"type":"verse","number":16,"content":["以色列各支派中，凡立定心意寻求耶和华—以色列 神的，都随从利未人，来到耶路撒冷祭祀耶和华—他们列祖的 神。"]},{"type":"verse","number":17,"content":["这样，就坚固犹大国，使所罗门的儿子罗波安强盛三年，因为他们三年遵行大卫和所罗门的道。"]},{"type":"heading","content":["罗波安的家室"]},{"type":"verse","number":18,"content":["罗波安娶大卫儿子耶利摩的女儿玛哈拉为妻，又娶耶西儿子以利押的女儿亚比孩为妻。"]},{"type":"verse","number":19,"content":["从她生了几个儿子，就是耶乌施、示玛利雅、撒罕。"]},{"type":"verse","number":20,"content":["后来又娶押沙龙的女儿玛迦",{"noteId":3},"，从她生了亚比雅、亚太、细撒、示罗密。"]},{"type":"verse","number":21,"content":["罗波安娶十八个妻，立六十个妾，生二十八个儿子，六十个女儿；他却爱押沙龙的女儿玛迦，比爱别的妻妾更甚。"]},{"type":"verse","number":22,"content":["罗波安立玛迦的儿子亚比雅作太子，在他弟兄中为首，因为想要立他接续作王。"]},{"type":"verse","number":23,"content":["罗波安办事精明，使他众子分散在犹大和便雅悯全地各坚固城里，又赐他们许多粮食，为他们多寻妻子。"]}],"footnotes":[{"noteId":2,"caller":"-","text":"原文是公山羊","reference":{"chapter":11,"verse":15}},{"noteId":3,"caller":"-","text":"十三章二节是乌列的女儿米该雅","reference":{"chapter":11,"verse":20}}]},"thisChapterLink":"/api/cmn_cu1/2CH/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/2CH/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/2CH/10.json","previousChapterAudioLinks":{},"numberOfVerses":23}