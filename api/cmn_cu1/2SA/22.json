{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"2SA","translationId":"cmn_cu1","name":"撒母耳记下","commonName":"撒母耳记下","title":"撒母耳记下","order":10,"numberOfChapters":24,"sha256":"2a264db417f1763c92ff71ac5282913beefde61284fc2dc01c740071952a99eb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/cmn_cu1/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":22,"content":[{"type":"heading","content":["大卫的凯歌"]},{"type":"verse","number":1,"content":["当耶和华救大卫脱离一切仇敌和扫罗之手的日子，他向耶和华念这诗，"]},{"type":"verse","number":2,"content":["说：",{"text":"耶和华是我的岩石，","poem":1},{"lineBreak":true},{"text":"我的山寨，我的救主，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的 神，我的磐石，我所投靠的。","poem":1},{"lineBreak":true},{"text":"他是我的盾牌，是拯救我的角，","poem":1},{"lineBreak":true},{"text":"是我的高台，是我的避难所。","poem":1},{"lineBreak":true},{"text":"我的救主啊，你是救我脱离强暴的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要求告当赞美的耶和华，","poem":1},{"lineBreak":true},{"text":"这样，我必从仇敌手中被救出来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"曾有死亡的波浪环绕我，","poem":1},{"lineBreak":true},{"text":"匪类的急流使我惊惧，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"阴间的绳索缠绕我，","poem":1},{"lineBreak":true},{"text":"死亡的网罗临到我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我在急难中求告耶和华，","poem":1},{"lineBreak":true},{"text":"向我的 神呼求。","poem":1},{"lineBreak":true},{"text":"他从殿中听了我的声音；","poem":1},{"lineBreak":true},{"text":"我的呼求入了他的耳中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"那时因他发怒，地就摇撼战抖；","poem":1},{"lineBreak":true},{"text":"天的根基也震动摇撼。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"从他鼻孔冒烟上腾；","poem":1},{"lineBreak":true},{"text":"从他口中发火焚烧，连炭也着了。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他又使天下垂，亲自降临；","poem":1},{"lineBreak":true},{"text":"有黑云在他脚下。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他坐着基路伯飞行，","poem":1},{"lineBreak":true},{"text":"在风的翅膀上显现。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他以黑暗和聚集的水、","poem":1},{"lineBreak":true},{"text":"天空的厚云为他四围的行宫。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因他面前的光辉炭都着了。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华从天上打雷；","poem":1},{"lineBreak":true},{"text":"至高者发出声音。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他射出箭来，使仇敌四散，","poem":1},{"lineBreak":true},{"text":"发出闪电，使他们扰乱。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华的斥责一发，鼻孔的气一出，","poem":1},{"lineBreak":true},{"text":"海底就出现，大地的根基也显露。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"他从高天伸手抓住我，","poem":1},{"lineBreak":true},{"text":"把我从大水中拉上来。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他救我脱离我的劲敌和那些恨我的人，","poem":1},{"lineBreak":true},{"text":"因为他们比我强盛。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我遭遇灾难的日子，他们来攻击我；","poem":1},{"lineBreak":true},{"text":"但耶和华是我的倚靠。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他又领我到宽阔之处；","poem":1},{"lineBreak":true},{"text":"他救拔我，因他喜悦我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"耶和华按着我的公义报答我，","poem":1},{"lineBreak":true},{"text":"按着我手中的清洁赏赐我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为我遵守了耶和华的道，","poem":1},{"lineBreak":true},{"text":"未曾作恶离开我的 神。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"他的一切典章常在我面前；","poem":1},{"lineBreak":true},{"text":"他的律例，我也未曾离弃。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我在他面前作了完全人；","poem":1},{"lineBreak":true},{"text":"我也保守自己远离我的罪孽。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"所以耶和华按我的公义，","poem":1},{"lineBreak":true},{"text":"按我在他眼前的清洁赏赐我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"慈爱的人，你以慈爱待他；","poem":1},{"lineBreak":true},{"text":"完全的人，你以完全待他；","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"清洁的人，你以清洁待他；","poem":1},{"lineBreak":true},{"text":"乖僻的人，你以弯曲待他。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"困苦的百姓，你必拯救；","poem":1},{"lineBreak":true},{"text":"但你的眼目察看高傲的人，使他降卑。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"耶和华啊，你是我的灯；","poem":1},{"lineBreak":true},{"text":"耶和华必照明我的黑暗。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我借着你冲入敌军，","poem":1},{"lineBreak":true},{"text":"借着我的 神跳过墙垣。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"至于 神，他的道是完全的；","poem":1},{"lineBreak":true},{"text":"耶和华的话是炼净的。","poem":1},{"lineBreak":true},{"text":"凡投靠他的，他便作他们的盾牌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"除了耶和华，谁是 神呢？","poem":1},{"lineBreak":true},{"text":"除了我们的 神，谁是磐石呢？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"神是我坚固的保障；","poem":1},{"lineBreak":true},{"text":"他引导完全人行他的路。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"他使我的脚快如母鹿的蹄，","poem":1},{"lineBreak":true},{"text":"又使我在高处安稳。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"他教导我的手能以争战，","poem":1},{"lineBreak":true},{"text":"甚至我的膀臂能开铜弓。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"你把你的救恩给我作盾牌；","poem":1},{"lineBreak":true},{"text":"你的温和使我为大。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"你使我脚下的地步宽阔；","poem":1},{"lineBreak":true},{"text":"我的脚未曾滑跌。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"我追赶我的仇敌，灭绝了他们，","poem":1},{"lineBreak":true},{"text":"未灭以先，我没有归回。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"我灭绝了他们，","poem":1},{"lineBreak":true},{"text":"打伤了他们，使他们不能起来；","poem":1},{"lineBreak":true},{"text":"他们都倒在我的脚下。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"因为你曾以力量束我的腰，使我能争战；","poem":1},{"lineBreak":true},{"text":"你也使那起来攻击我的都服在我以下。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"你又使我的仇敌在我面前转背逃跑，","poem":1},{"lineBreak":true},{"text":"叫我能以剪除那恨我的人。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"他们仰望，却无人拯救；","poem":1},{"lineBreak":true},{"text":"就是呼求耶和华，他也不应允。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"我捣碎他们，如同地上的灰尘，","poem":1},{"lineBreak":true},{"text":"践踏他们，四散在地，如同街上的泥土。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"你救我脱离我百姓的争竞，","poem":1},{"lineBreak":true},{"text":"保护我作列国的元首；","poem":1},{"lineBreak":true},{"text":"我素不认识的民必事奉我。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"外邦人要投降我，","poem":1},{"lineBreak":true},{"text":"一听见我的名声就必顺从我。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"外邦人要衰残，","poem":1},{"lineBreak":true},{"text":"战战兢兢地出他们的营寨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"耶和华是活神，愿我的磐石被人称颂！","poem":1},{"lineBreak":true},{"text":"愿 神—那拯救我的磐石被人尊崇！","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"这位 神就是那为我伸冤、","poem":1},{"lineBreak":true},{"text":"使众民服在我以下的。","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"你救我脱离仇敌，","poem":1},{"lineBreak":true},{"text":"又把我举起，高过那些起来攻击我的；","poem":1},{"lineBreak":true},{"text":"你救我脱离强暴的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"耶和华啊，因此我要在外邦中称谢你，","poem":1},{"lineBreak":true},{"text":"歌颂你的名。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"耶和华赐极大的救恩给他所立的王，","poem":1},{"lineBreak":true},{"text":"施慈爱给他的受膏者，","poem":1},{"lineBreak":true},{"text":"就是给大卫和他的后裔，","poem":1},{"lineBreak":true},{"text":"直到永远！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}