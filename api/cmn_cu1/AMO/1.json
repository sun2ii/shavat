{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"AMO","translationId":"cmn_cu1","name":"阿摩司书","commonName":"阿摩司书","title":"阿摩司书","order":30,"numberOfChapters":9,"sha256":"42c4027397b1c6cfa551ec206eda319190accd30126769b0ef64f13ff07a4bf7","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cmn_cu1/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["当犹大王乌西雅，以色列王约阿施的儿子耶罗波安在位的时候，大地震前二年，提哥亚牧人中的阿摩司得默示论以色列。"]},{"type":"verse","number":2,"content":[{"text":"他说：耶和华必从锡安吼叫，","poem":1},{"lineBreak":true},{"text":"从耶路撒冷发声；","poem":1},{"lineBreak":true},{"text":"牧人的草场要悲哀；","poem":1},{"lineBreak":true},{"text":"迦密的山顶要枯干。","poem":1}]},{"type":"heading","content":["神审判以色列的邻国"]},{"type":"heading","content":["—亚兰"]},{"type":"verse","number":3,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"大马士革三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去她的刑罚；","poem":1},{"lineBreak":true},{"text":"因为她以打粮食的铁器打过基列。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我却要降火在哈薛的家中，","poem":1},{"lineBreak":true},{"text":"烧灭便·哈达的宫殿。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我必折断大马士革的门闩，","poem":1},{"lineBreak":true},{"text":"剪除亚文平原的居民和伯·伊甸掌权的。","poem":1},{"lineBreak":true},{"text":"亚兰人必被掳到吉珥。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"heading","content":["—非利士"]},{"type":"verse","number":6,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"迦萨三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去她的刑罚；","poem":1},{"lineBreak":true},{"text":"因为她掳掠众民交给以东。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我却要降火在迦萨的城内，","poem":1},{"lineBreak":true},{"text":"烧灭其中的宫殿。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我必剪除亚实突的居民和亚实基伦掌权的，","poem":1},{"lineBreak":true},{"text":"也必反手攻击以革伦。","poem":1},{"lineBreak":true},{"text":"非利士人所余剩的必都灭亡。","poem":1},{"lineBreak":true},{"text":"这是主耶和华说的。","poem":1}]},{"type":"heading","content":["—泰尔"]},{"type":"verse","number":9,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"泰尔三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去她的刑罚；","poem":1},{"lineBreak":true},{"text":"因为她将众民交给以东，","poem":1},{"lineBreak":true},{"text":"并不记念弟兄的盟约。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我却要降火在泰尔的城内，","poem":1},{"lineBreak":true},{"text":"烧灭其中的宫殿。","poem":1}]},{"type":"heading","content":["—以东"]},{"type":"verse","number":11,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"以东三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去她的刑罚；","poem":1},{"lineBreak":true},{"text":"因为她拿刀追赶兄弟，毫无怜悯，","poem":1},{"lineBreak":true},{"text":"发怒撕裂，永怀忿怒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我却要降火在提幔，","poem":1},{"lineBreak":true},{"text":"烧灭波斯拉的宫殿。","poem":1}]},{"type":"heading","content":["—亚扪"]},{"type":"verse","number":13,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"亚扪人三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去他们的刑罚；","poem":1},{"lineBreak":true},{"text":"因为他们剖开基列的孕妇，","poem":1},{"lineBreak":true},{"text":"扩张自己的境界。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我却要在争战呐喊的日子，","poem":1},{"lineBreak":true},{"text":"旋风狂暴的时候，","poem":1},{"lineBreak":true},{"text":"点火在拉巴的城内，","poem":1},{"lineBreak":true},{"text":"烧灭其中的宫殿。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他们的王和首领必一同被掳去。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}