{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"AMO","translationId":"cmn_cu1","name":"阿摩司书","commonName":"阿摩司书","title":"阿摩司书","order":30,"numberOfChapters":9,"sha256":"42c4027397b1c6cfa551ec206eda319190accd30126769b0ef64f13ff07a4bf7","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cmn_cu1/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"heading","content":["—摩押"]},{"type":"verse","number":1,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"摩押三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去她的刑罚；","poem":1},{"lineBreak":true},{"text":"因为她将以东王的骸骨焚烧成灰。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我却要降火在摩押，","poem":1},{"lineBreak":true},{"text":"烧灭加略的宫殿。","poem":1},{"lineBreak":true},{"text":"摩押必在哄嚷呐喊吹角之中死亡。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我必剪除摩押中的审判者，","poem":1},{"lineBreak":true},{"text":"将其中的一切首领和他一同杀戮。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"heading","content":["—犹大"]},{"type":"verse","number":4,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"犹大人三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去他们的刑罚；","poem":1},{"lineBreak":true},{"text":"因为他们厌弃耶和华的训诲，","poem":1},{"lineBreak":true},{"text":"不遵守他的律例。","poem":1},{"lineBreak":true},{"text":"他们列祖所随从虚假的偶像使他们走迷了。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我却要降火在犹大，","poem":1},{"lineBreak":true},{"text":"烧灭耶路撒冷的宫殿。","poem":1}]},{"type":"heading","content":["神审判以色列"]},{"type":"verse","number":6,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"以色列人三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去他们的刑罚；","poem":1},{"lineBreak":true},{"text":"因他们为银子卖了义人，","poem":1},{"lineBreak":true},{"text":"为一双鞋卖了穷人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们见穷人头上所蒙的灰也都垂涎，","poem":1},{"lineBreak":true},{"text":"阻碍谦卑人的道路。","poem":1},{"lineBreak":true},{"text":"父子同一个女子行淫，","poem":1},{"lineBreak":true},{"text":"亵渎我的圣名。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们在各坛旁铺人所当的衣服，卧在其上，","poem":1},{"lineBreak":true},{"text":"又在他们神的庙中喝受罚之人的酒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我从以色列人面前除灭亚摩利人。","poem":1},{"lineBreak":true},{"text":"他虽高大如香柏树，坚固如橡树，","poem":1},{"lineBreak":true},{"text":"我却上灭他的果子，下绝他的根本。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我也将你们从埃及地领上来，","poem":1},{"lineBreak":true},{"text":"在旷野引导你们四十年，","poem":1},{"lineBreak":true},{"text":"使你们得亚摩利人之地为业。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我从你们子弟中兴起先知，","poem":1},{"lineBreak":true},{"text":"又从你们少年人中兴起拿细耳人。","poem":1},{"lineBreak":true},{"text":"以色列人哪，不是这样吗？","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"你们却给拿细耳人酒喝，","poem":1},{"lineBreak":true},{"text":"嘱咐先知说：不要说预言。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"看哪，在你们所住之地，我必压你们，","poem":1},{"lineBreak":true},{"text":"如同装满禾捆的车压物一样。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"快跑的不能逃脱；","poem":1},{"lineBreak":true},{"text":"有力的不能用力；","poem":1},{"lineBreak":true},{"text":"刚勇的也不能自救。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"拿弓的不能站立；","poem":1},{"lineBreak":true},{"text":"腿快的不能逃脱；","poem":1},{"lineBreak":true},{"text":"骑马的也不能自救。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"到那日，勇士中最有胆量的，","poem":1},{"lineBreak":true},{"text":"必赤身逃跑。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}