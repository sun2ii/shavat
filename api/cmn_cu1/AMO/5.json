{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"AMO","translationId":"cmn_cu1","name":"阿摩司书","commonName":"阿摩司书","title":"阿摩司书","order":30,"numberOfChapters":9,"sha256":"42c4027397b1c6cfa551ec206eda319190accd30126769b0ef64f13ff07a4bf7","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cmn_cu1/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["呼吁以色列人悔改"]},{"type":"verse","number":1,"content":[{"text":"以色列家啊，要听我为你们所作的哀歌：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"以色列民","poem":1},{"noteId":0},{"text":"跌倒，不得再起；","poem":1},{"lineBreak":true},{"text":"躺在地上，无人搀扶。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"主耶和华如此说：","poem":1},{"lineBreak":true},{"text":"以色列家的城发出一千兵的，只剩一百；","poem":1},{"lineBreak":true},{"text":"发出一百的，只剩十个。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华向以色列家如此说：","poem":1},{"lineBreak":true},{"text":"你们要寻求我，就必存活。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"不要往伯特利寻求，","poem":1},{"lineBreak":true},{"text":"不要进入吉甲，","poem":1},{"lineBreak":true},{"text":"不要过到别是巴；","poem":1},{"lineBreak":true},{"text":"因为吉甲必被掳掠，","poem":1},{"lineBreak":true},{"text":"伯特利也必归于无有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"要寻求耶和华，就必存活，","poem":1},{"lineBreak":true},{"text":"免得他在约瑟家像火发出，","poem":1},{"lineBreak":true},{"text":"在伯特利焚烧，无人扑灭。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你们这使公平变为茵 、","poem":1},{"lineBreak":true},{"text":"将公义丢弃于地的，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"要寻求那造昴星和参星，","poem":1},{"lineBreak":true},{"text":"使死荫变为晨光，","poem":1},{"lineBreak":true},{"text":"使白日变为黑夜，","poem":1},{"lineBreak":true},{"text":"命海水来浇在地上的—","poem":1},{"lineBreak":true},{"text":"耶和华是他的名；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他使力强的忽遭灭亡，","poem":1},{"lineBreak":true},{"text":"以致保障遭遇毁坏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你们怨恨那在城门口责备人的，","poem":1},{"lineBreak":true},{"text":"憎恶那说正直话的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你们践踏贫民，","poem":1},{"lineBreak":true},{"text":"向他们勒索麦子；","poem":1},{"lineBreak":true},{"text":"你们用凿过的石头建造房屋，","poem":1},{"lineBreak":true},{"text":"却不得住在其内；","poem":1},{"lineBreak":true},{"text":"栽种美好的葡萄园，","poem":1},{"lineBreak":true},{"text":"却不得喝所出的酒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我知道你们的罪过何等多，","poem":1},{"lineBreak":true},{"text":"你们的罪恶何等大。","poem":1},{"lineBreak":true},{"text":"你们苦待义人，收受贿赂，在城门口屈枉穷乏人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"所以通达人见这样的时势必静默不言，","poem":1},{"lineBreak":true},{"text":"因为时势真恶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"你们要求善，","poem":1},{"lineBreak":true},{"text":"不要求恶，就必存活。","poem":1},{"lineBreak":true},{"text":"这样，耶和华—万军之 神","poem":1},{"lineBreak":true},{"text":"必照你们所说的与你们同在。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"要恶恶好善，","poem":1},{"lineBreak":true},{"text":"在城门口秉公行义；","poem":1},{"lineBreak":true},{"text":"或者耶和华—万军之 神向约瑟的余民施恩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"主耶和华—万军之 神如此说：","poem":1},{"lineBreak":true},{"text":"在一切宽阔处必有哀号的声音；","poem":1},{"lineBreak":true},{"text":"在各街市上必有人说：","poem":1},{"lineBreak":true},{"text":"哀哉！哀哉！","poem":1},{"lineBreak":true},{"text":"又必叫农夫来哭号，","poem":1},{"lineBreak":true},{"text":"叫善唱哀歌的来举哀。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"在各葡萄园必有哀号的声音，","poem":1},{"lineBreak":true},{"text":"因为我必从你中间经过。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"想望耶和华日子来到的有祸了！","poem":1},{"lineBreak":true},{"text":"你们为何想望耶和华的日子呢？","poem":1},{"lineBreak":true},{"text":"那日黑暗没有光明，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"景况好像人躲避狮子又遇见熊，","poem":1},{"lineBreak":true},{"text":"或是进房屋以手靠墙，就被蛇咬。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和华的日子不是黑暗没有光明吗？","poem":1},{"lineBreak":true},{"text":"不是幽暗毫无光辉吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"我厌恶你们的节期，","poem":1},{"lineBreak":true},{"text":"也不喜悦你们的严肃会。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你们虽然向我献燔祭和素祭，","poem":1},{"lineBreak":true},{"text":"我却不悦纳，","poem":1},{"lineBreak":true},{"text":"也不顾你们用肥畜献的平安祭；","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"要使你们歌唱的声音远离我，","poem":1},{"lineBreak":true},{"text":"因为我不听你们弹琴的响声。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"惟愿公平如大水滚滚，","poem":1},{"lineBreak":true},{"text":"使公义如江河滔滔。","poem":1}]},{"type":"verse","number":25,"content":["「以色列家啊，你们在旷野四十年，岂是将祭物和供物献给我呢？"]},{"type":"verse","number":26,"content":["你们抬着为自己所造之摩洛的帐幕和偶像的龛，并你们的神星。"]},{"type":"verse","number":27,"content":["所以我要把你们掳到大马士革以外。」这是耶和华、名为万军之 神说的。"]}],"footnotes":[{"noteId":0,"caller":"-","text":"原文是处女","reference":{"chapter":5,"verse":2}}]},"thisChapterLink":"/api/cmn_cu1/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}