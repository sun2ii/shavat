{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"AMO","translationId":"cmn_cu1","name":"阿摩司书","commonName":"阿摩司书","title":"阿摩司书","order":30,"numberOfChapters":9,"sha256":"42c4027397b1c6cfa551ec206eda319190accd30126769b0ef64f13ff07a4bf7","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cmn_cu1/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["一筐水果的异象"]},{"type":"verse","number":1,"content":["主耶和华又指示我一件事：我看见一筐夏天的果子。"]},{"type":"verse","number":2,"content":["他说：「阿摩司啊，你看见什么？」我说：「看见一筐夏天的果子。」耶和华说：「我民以色列的结局到了，我必不再宽恕他们。」"]},{"type":"verse","number":3,"content":["主耶和华说：「那日，殿中的诗歌变为哀号；必有许多尸首在各处抛弃，无人作声。」"]},{"type":"heading","content":["以色列的结局"]},{"type":"verse","number":4,"content":[{"text":"你们这些要吞吃穷乏人、","poem":1},{"lineBreak":true},{"text":"使困苦人衰败的，当听我的话！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你们说：月朔几时过去，","poem":1},{"lineBreak":true},{"text":"我们好卖粮；","poem":1},{"lineBreak":true},{"text":"安息日几时过去，","poem":1},{"lineBreak":true},{"text":"我们好摆开麦子；","poem":1},{"lineBreak":true},{"text":"卖出用小升斗，","poem":1},{"lineBreak":true},{"text":"收银用大戥子，","poem":1},{"lineBreak":true},{"text":"用诡诈的天平欺哄人，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"好用银子买贫寒人，","poem":1},{"lineBreak":true},{"text":"用一双鞋换穷乏人，","poem":1},{"lineBreak":true},{"text":"将坏了的麦子卖给人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华指着雅各的荣耀起誓说：","poem":1},{"lineBreak":true},{"text":"他们的一切行为，我必永远不忘。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"地岂不因这事震动？","poem":1},{"lineBreak":true},{"text":"其上的居民不也悲哀吗？","poem":1},{"lineBreak":true},{"text":"地必全然像尼罗河涨起，","poem":1},{"lineBreak":true},{"text":"如同埃及河涌上落下。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"主耶和华说：到那日，","poem":1},{"lineBreak":true},{"text":"我必使日头在午间落下，","poem":1},{"lineBreak":true},{"text":"使地在白昼黑暗。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我必使你们的节期变为悲哀，","poem":1},{"lineBreak":true},{"text":"歌曲变为哀歌。","poem":1},{"lineBreak":true},{"text":"众人腰束麻布，头上光秃，","poem":1},{"lineBreak":true},{"text":"使这场悲哀如丧独生子，","poem":1},{"lineBreak":true},{"text":"至终如痛苦的日子一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"主耶和华说：日子将到，","poem":1},{"lineBreak":true},{"text":"我必命饥荒降在地上。","poem":1},{"lineBreak":true},{"text":"人饥饿非因无饼，干渴非因无水，","poem":1},{"lineBreak":true},{"text":"乃因不听耶和华的话。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们必飘流，从这海到那海，","poem":1},{"lineBreak":true},{"text":"从北边到东边，往来奔跑，","poem":1},{"lineBreak":true},{"text":"寻求耶和华的话，却寻不着。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"当那日，美貌的处女","poem":1},{"lineBreak":true},{"text":"和少年的男子必因干渴发昏。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"那指着撒马利亚牛犊","poem":1},{"noteId":4},{"text":"起誓的说：","poem":1},{"lineBreak":true},{"text":"但哪，我们指着你那里的活神起誓；","poem":1},{"lineBreak":true},{"text":"又说：我们指着别是巴的神道","poem":1},{"noteId":5},{"text":"起誓。","poem":1},{"lineBreak":true},{"text":"这些人都必仆倒，永不再起来。","poem":1}]}],"footnotes":[{"noteId":4,"caller":"-","text":"原文是罪","reference":{"chapter":8,"verse":14}},{"noteId":5,"caller":"-","text":"神：原文是活","reference":{"chapter":8,"verse":14}}]},"thisChapterLink":"/api/cmn_cu1/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}