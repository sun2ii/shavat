{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"AMO","translationId":"cmn_cu1","name":"阿摩司书","commonName":"阿摩司书","title":"阿摩司书","order":30,"numberOfChapters":9,"sha256":"42c4027397b1c6cfa551ec206eda319190accd30126769b0ef64f13ff07a4bf7","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cmn_cu1/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["耶和华的审判"]},{"type":"verse","number":1,"content":[{"text":"我看见主站在祭坛旁边；","poem":1},{"lineBreak":true},{"text":"他说：你要击打柱顶，使门槛震动，","poem":1},{"lineBreak":true},{"text":"打碎柱顶，落在众人头上；","poem":1},{"lineBreak":true},{"text":"所剩下的人，我必用刀杀戮，","poem":1},{"lineBreak":true},{"text":"无一人能逃避，无一人能逃脱。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他们虽然挖透阴间，","poem":1},{"lineBreak":true},{"text":"我的手必取出他们来；","poem":1},{"lineBreak":true},{"text":"虽然爬上天去，","poem":1},{"lineBreak":true},{"text":"我必拿下他们来；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"虽然藏在迦密山顶，","poem":1},{"lineBreak":true},{"text":"我必搜寻，捉出他们来；","poem":1},{"lineBreak":true},{"text":"虽然从我眼前藏在海底，","poem":1},{"lineBreak":true},{"text":"我必命蛇咬他们；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"虽被仇敌掳去，","poem":1},{"lineBreak":true},{"text":"我必命刀剑杀戮他们；","poem":1},{"lineBreak":true},{"text":"我必向他们定住眼目，","poem":1},{"lineBreak":true},{"text":"降祸不降福。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"主—万军之耶和华摸地，地就消化，","poem":1},{"lineBreak":true},{"text":"凡住在地上的都必悲哀。","poem":1},{"lineBreak":true},{"text":"地必全然像尼罗河涨起，","poem":1},{"lineBreak":true},{"text":"如同埃及河落下。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"那在天上建造楼阁、","poem":1},{"lineBreak":true},{"text":"在地上安定穹苍、","poem":1},{"lineBreak":true},{"text":"命海水浇在地上的—","poem":1},{"lineBreak":true},{"text":"耶和华是他的名。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华说：以色列人哪，","poem":1},{"lineBreak":true},{"text":"我岂不看你们如古实人吗？","poem":1},{"lineBreak":true},{"text":"我岂不是领以色列人出埃及地，","poem":1},{"lineBreak":true},{"text":"领非利士人出迦斐托，","poem":1},{"lineBreak":true},{"text":"领亚兰人出吉珥吗？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"主耶和华的眼目察看这有罪的国，","poem":1},{"lineBreak":true},{"text":"必将这国从地上灭绝，","poem":1},{"lineBreak":true},{"text":"却不将雅各家灭绝净尽。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我必出令，","poem":1},{"lineBreak":true},{"text":"将以色列家分散在列国中，","poem":1},{"lineBreak":true},{"text":"好像用筛子筛谷，","poem":1},{"lineBreak":true},{"text":"连一粒也不落在地上。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我民中的一切罪人说：","poem":1},{"lineBreak":true},{"text":"灾祸必追不上我们，","poem":1},{"lineBreak":true},{"text":"也迎不着我们。","poem":1},{"lineBreak":true},{"text":"他们必死在刀下。","poem":1}]},{"type":"heading","content":["以色列的未来复兴"]},{"type":"verse","number":11,"content":[{"text":"到那日，我必建立大卫倒塌的帐幕，","poem":1},{"lineBreak":true},{"text":"堵住其中的破口，","poem":1},{"lineBreak":true},{"text":"把那破坏的建立起来，","poem":1},{"lineBreak":true},{"text":"重新修造，像古时一样，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"使以色列人得以东所余剩的","poem":1},{"lineBreak":true},{"text":"和所有称为我名下的国。","poem":1},{"lineBreak":true},{"text":"此乃行这事的耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"日子将到，","poem":1},{"lineBreak":true},{"text":"耕种的必接续收割的；","poem":1},{"lineBreak":true},{"text":"踹葡萄的必接续撒种的；","poem":1},{"lineBreak":true},{"text":"大山要滴下甜酒；","poem":1},{"lineBreak":true},{"text":"小山都必流奶","poem":1},{"noteId":6},{"text":"。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我必使我民以色列被掳的归回；","poem":1},{"lineBreak":true},{"text":"他们必重修荒废的城邑居住，","poem":1},{"lineBreak":true},{"text":"栽种葡萄园，喝其中所出的酒，","poem":1},{"lineBreak":true},{"text":"修造果木园，吃其中的果子。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要将他们栽于本地，","poem":1},{"lineBreak":true},{"text":"他们不再从我所赐给他们的地上拔出来。","poem":1},{"lineBreak":true},{"text":"这是耶和华—你的 神说的。","poem":1}]}],"footnotes":[{"noteId":6,"caller":"-","text":"原文是消化，见约珥三章十八节","reference":{"chapter":9,"verse":13}}]},"thisChapterLink":"/api/cmn_cu1/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}