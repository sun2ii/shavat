{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"DEU","translationId":"cmn_cu1","name":"申命记","commonName":"申命记","title":"申命记","order":5,"numberOfChapters":34,"sha256":"35327388dd3d83dc5cbf3bb3b8e1fb1773933284ab37065518e57d824ed6b819","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/cmn_cu1/DEU/34.json","totalNumberOfVerses":951},"chapter":{"number":33,"content":[{"type":"heading","content":["摩西祝福以色列众支派"]},{"type":"verse","number":1,"content":["以下是神人摩西在未死之先为以色列人所祝的福："]},{"type":"verse","number":2,"content":[{"text":"他说：耶和华从西奈而来，","poem":1},{"lineBreak":true},{"text":"从西珥向他们显现，","poem":1},{"lineBreak":true},{"text":"从巴兰山发出光辉，","poem":1},{"lineBreak":true},{"text":"从万万圣者中来临，","poem":1},{"lineBreak":true},{"text":"从他右手为百姓传出烈火的律法。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他疼爱百姓；","poem":1},{"lineBreak":true},{"text":"众圣徒都在他手中。","poem":1},{"lineBreak":true},{"text":"他们坐在他的脚下，","poem":1},{"lineBreak":true},{"text":"领受他的言语。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"摩西将律法传给我们，","poem":1},{"lineBreak":true},{"text":"作为雅各会众的产业。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"百姓的众首领，","poem":1},{"lineBreak":true},{"text":"以色列的各支派，","poem":1},{"lineBreak":true},{"text":"一同聚会的时候，","poem":1},{"lineBreak":true},{"text":"耶和华","poem":1},{"noteId":9},{"text":"在耶书 中为王。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"愿吕便存活，不致死亡；","poem":1},{"lineBreak":true},{"text":"愿他人数不致稀少。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"为犹大祝福说：","poem":1},{"lineBreak":true},{"text":"求耶和华俯听犹大的声音，","poem":1},{"lineBreak":true},{"text":"引导他归于本族；","poem":1},{"lineBreak":true},{"text":"他曾用手为自己争战，","poem":1},{"lineBreak":true},{"text":"你必帮助他攻击敌人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"论利未说：","poem":1},{"lineBreak":true},{"text":"耶和华啊，你的土明和乌陵","poem":1},{"lineBreak":true},{"text":"都在你的虔诚人那里。","poem":1},{"lineBreak":true},{"text":"你在玛撒曾试验他，","poem":1},{"lineBreak":true},{"text":"在米利巴水与他争论。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他论自己的父母说：","poem":1},{"lineBreak":true},{"text":"我未曾看见；","poem":1},{"lineBreak":true},{"text":"他也不承认弟兄，","poem":1},{"lineBreak":true},{"text":"也不认识自己的儿女。","poem":1},{"lineBreak":true},{"text":"这是因利未人遵行你的话，","poem":1},{"lineBreak":true},{"text":"谨守你的约。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们要将你的典章教训雅各，","poem":1},{"lineBreak":true},{"text":"将你的律法教训以色列。","poem":1},{"lineBreak":true},{"text":"他们要把香焚在你面前，","poem":1},{"lineBreak":true},{"text":"把全牲的燔祭献在你的坛上。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求耶和华降福在他的财物上，","poem":1},{"lineBreak":true},{"text":"悦纳他手里所办的事。","poem":1},{"lineBreak":true},{"text":"那些起来攻击他和恨恶他的人，","poem":1},{"lineBreak":true},{"text":"愿你刺透他们的腰，","poem":1},{"lineBreak":true},{"text":"使他们不得再起来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"论便雅悯说：","poem":1},{"lineBreak":true},{"text":"耶和华所亲爱的必同耶和华安然居住；","poem":1},{"lineBreak":true},{"text":"耶和华终日遮蔽他，也住在他两肩之中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"论约瑟说：","poem":1},{"lineBreak":true},{"text":"愿他的地蒙耶和华赐福，","poem":1},{"lineBreak":true},{"text":"得天上的宝物、甘露，","poem":1},{"lineBreak":true},{"text":"以及地里所藏的泉水；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"得太阳所晒熟的美果，","poem":1},{"lineBreak":true},{"text":"月亮所养成的宝物；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"得上古之山的至宝，","poem":1},{"lineBreak":true},{"text":"永世之岭的宝物；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"得地和其中所充满的宝物，","poem":1},{"lineBreak":true},{"text":"并住荆棘中上主的喜悦。","poem":1},{"lineBreak":true},{"text":"愿这些福都归于约瑟的头上，","poem":1},{"lineBreak":true},{"text":"归于那与弟兄迥别之人的顶上。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他为牛群中头生的，有威严；","poem":1},{"lineBreak":true},{"text":"他的角是野牛的角，","poem":1},{"lineBreak":true},{"text":"用以抵触万邦，直到地极。","poem":1},{"lineBreak":true},{"text":"这角是以法莲的万万，","poem":1},{"lineBreak":true},{"text":"玛拿西的千千。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"论西布伦说：","poem":1},{"lineBreak":true},{"text":"西布伦哪，你出外可以欢喜。","poem":1},{"lineBreak":true},{"text":"以萨迦啊，在你帐棚里可以快乐。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他们要将列邦召到山上，","poem":1},{"lineBreak":true},{"text":"在那里献公义的祭；","poem":1},{"lineBreak":true},{"text":"因为他们要吸取海里的丰富，","poem":1},{"lineBreak":true},{"text":"并沙中所藏的珍宝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"论迦得说：","poem":1},{"lineBreak":true},{"text":"使迦得扩张的应当称颂！","poem":1},{"lineBreak":true},{"text":"迦得住如母狮；","poem":1},{"lineBreak":true},{"text":"他撕裂膀臂，连头顶也撕裂。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他为自己选择头一段地，","poem":1},{"lineBreak":true},{"text":"因在那里有设立律法者的分存留。","poem":1},{"lineBreak":true},{"text":"他与百姓的首领同来；","poem":1},{"lineBreak":true},{"text":"他施行耶和华的公义","poem":1},{"lineBreak":true},{"text":"和耶和华与以色列所立的典章。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"论但说：","poem":1},{"lineBreak":true},{"text":"但为小狮子，","poem":1},{"lineBreak":true},{"text":"从巴珊跳出来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"论拿弗他利说：","poem":1},{"lineBreak":true},{"text":"拿弗他利啊，你足沾恩惠，","poem":1},{"lineBreak":true},{"text":"满得耶和华的福，","poem":1},{"lineBreak":true},{"text":"可以得西方和南方为业。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"论亚设说：","poem":1},{"lineBreak":true},{"text":"愿亚设享受多子的福乐，","poem":1},{"lineBreak":true},{"text":"得他弟兄的喜悦，","poem":1},{"lineBreak":true},{"text":"可以把脚蘸在油中。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你的门闩","poem":1},{"noteId":10},{"text":"是铜的，铁的。","poem":1},{"lineBreak":true},{"text":"你的日子如何，你的力量也必如何。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"耶书 哪，没有能比 神的。","poem":1},{"lineBreak":true},{"text":"他为帮助你，乘在天空，","poem":1},{"lineBreak":true},{"text":"显其威荣，驾行穹苍。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"永生的 神是你的居所；","poem":1},{"lineBreak":true},{"text":"他永久的膀臂在你以下。","poem":1},{"lineBreak":true},{"text":"他在你前面撵出仇敌，","poem":1},{"lineBreak":true},{"text":"说：毁灭吧。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"以色列安然居住；","poem":1},{"lineBreak":true},{"text":"雅各的本源独居五谷新酒之地。","poem":1},{"lineBreak":true},{"text":"他的天也滴甘露。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"以色列啊，你是有福的！","poem":1},{"lineBreak":true},{"text":"谁像你这蒙耶和华所拯救的百姓呢？","poem":1},{"lineBreak":true},{"text":"他是你的盾牌，帮助你，","poem":1},{"lineBreak":true},{"text":"是你威荣的刀剑。","poem":1},{"lineBreak":true},{"text":"你的仇敌必投降你；","poem":1},{"lineBreak":true},{"text":"你必踏在他们的高处。","poem":1}]}],"footnotes":[{"noteId":9,"caller":"-","text":"原文是他","reference":{"chapter":33,"verse":5}},{"noteId":10,"caller":"-","text":"或译：鞋","reference":{"chapter":33,"verse":25}}]},"thisChapterLink":"/api/cmn_cu1/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}