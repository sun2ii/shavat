{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cu1","name":"传道书","commonName":"传道书","title":"传道书","order":21,"numberOfChapters":12,"sha256":"4f50543f99f7225fcd6ddfe629f589e05c0655922cd97b07218d4e006aaad07c","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cu1/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":1,"content":[{"type":"heading","content":["人生的虚空"]},{"type":"verse","number":1,"content":["在耶路撒冷作王、大卫的儿子、传道者的言语。"]},{"type":"verse","number":2,"content":[{"text":"传道者说：虚空的虚空，","poem":1},{"lineBreak":true},{"text":"虚空的虚空，凡事都是虚空。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人一切的劳碌，","poem":1},{"lineBreak":true},{"text":"就是他在日光之下的劳碌，有什么益处呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"一代过去，一代又来，","poem":1},{"lineBreak":true},{"text":"地却永远长存。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"日头出来，日头落下，","poem":1},{"lineBreak":true},{"text":"急归所出之地。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"风往南刮，又向北转，","poem":1},{"lineBreak":true},{"text":"不住地旋转，而且返回转行原道。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"江河都往海里流，海却不满；","poem":1},{"lineBreak":true},{"text":"江河从何处流，仍归还何处。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"万事令人厌烦","poem":1},{"noteId":0},{"text":"，","poem":1},{"lineBreak":true},{"text":"人不能说尽。","poem":1},{"lineBreak":true},{"text":"眼看，看不饱；","poem":1},{"lineBreak":true},{"text":"耳听，听不足。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"已有的事后必再有；","poem":1},{"lineBreak":true},{"text":"已行的事后必再行。","poem":1},{"lineBreak":true},{"text":"日光之下并无新事。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"岂有一件事人能指着说这是新的？","poem":1},{"lineBreak":true},{"text":"哪知，在我们以前的世代早已有了。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"已过的世代，无人记念；","poem":1},{"lineBreak":true},{"text":"将来的世代，后来的人也不记念。","poem":1}]},{"type":"heading","content":["传道者的经验"]},{"type":"verse","number":12,"content":["我传道者在耶路撒冷作过以色列的王。"]},{"type":"verse","number":13,"content":["我专心用智慧寻求、查究天下所做的一切事，乃知 神叫世人所经练的是极重的劳苦。"]},{"type":"verse","number":14,"content":["我见日光之下所做的一切事，都是虚空，都是捕风。"]},{"type":"verse","number":15,"content":[{"text":"弯曲的，不能变直；","poem":1},{"lineBreak":true},{"text":"缺少的，不能足数。","poem":1}]},{"type":"verse","number":16,"content":["我心里议论说：我得了大智慧，胜过我以前在耶路撒冷的众人，而且我心中多经历智慧和知识的事。"]},{"type":"verse","number":17,"content":["我又专心察明智慧、狂妄，和愚昧，乃知这也是捕风。"]},{"type":"verse","number":18,"content":[{"text":"因为多有智慧，就多有愁烦；","poem":1},{"lineBreak":true},{"text":"加增知识的，就加增忧伤。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"或译：万物满有困乏","reference":{"chapter":1,"verse":8}}]},"thisChapterLink":"/api/cmn_cu1/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}