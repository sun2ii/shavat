{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cu1","name":"传道书","commonName":"传道书","title":"传道书","order":21,"numberOfChapters":12,"sha256":"4f50543f99f7225fcd6ddfe629f589e05c0655922cd97b07218d4e006aaad07c","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cu1/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"死苍蝇使做香的膏油发出臭气；","poem":1},{"lineBreak":true},{"text":"这样，一点愚昧也能败坏智慧和尊荣。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"智慧人的心居右；","poem":1},{"lineBreak":true},{"text":"愚昧人的心居左。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"并且愚昧人行路显出无知，","poem":1},{"lineBreak":true},{"text":"对众人说，他是愚昧人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"掌权者的心若向你发怒，","poem":1},{"lineBreak":true},{"text":"不要离开你的本位，","poem":1},{"lineBreak":true},{"text":"因为柔和能免大过。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我见日光之下有一件祸患，","poem":1},{"lineBreak":true},{"text":"似乎出于掌权的错误，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"就是愚昧人立在高位；","poem":1},{"lineBreak":true},{"text":"富足人坐在低位。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我见过仆人骑马，","poem":1},{"lineBreak":true},{"text":"王子像仆人在地上步行。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"挖陷坑的，自己必掉在其中；","poem":1},{"lineBreak":true},{"text":"拆墙垣的，必为蛇所咬。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"凿开","poem":1},{"noteId":7},{"text":"石头的，必受损伤；","poem":1},{"lineBreak":true},{"text":"劈开木头的，必遭危险。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"铁器钝了，若不将刃磨快，就必多费气力；","poem":1},{"lineBreak":true},{"text":"但得智慧指教，便有益处。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"未行法术以先，蛇若咬人，","poem":1},{"lineBreak":true},{"text":"后行法术也是无益。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"智慧人的口说出恩言；","poem":1},{"lineBreak":true},{"text":"愚昧人的嘴吞灭自己。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他口中的言语起头是愚昧；","poem":1},{"lineBreak":true},{"text":"他话的末尾是奸恶的狂妄。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"愚昧人多有言语，","poem":1},{"lineBreak":true},{"text":"人却不知将来有什么事；","poem":1},{"lineBreak":true},{"text":"他身后的事谁能告诉他呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"凡愚昧人，他的劳碌使自己困乏，","poem":1},{"lineBreak":true},{"text":"因为连进城的路，他也不知道。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"邦国啊，你的王若是孩童，","poem":1},{"lineBreak":true},{"text":"你的群臣早晨宴乐，","poem":1},{"lineBreak":true},{"text":"你就有祸了！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"邦国啊，你的王若是贵胄之子，","poem":1},{"lineBreak":true},{"text":"你的群臣按时吃喝，","poem":1},{"lineBreak":true},{"text":"为要补力，不为酒醉，","poem":1},{"lineBreak":true},{"text":"你就有福了！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因人懒惰，房顶塌下；","poem":1},{"lineBreak":true},{"text":"因人手懒，房屋滴漏。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"设摆筵席是为喜笑。","poem":1},{"lineBreak":true},{"text":"酒能使人快活；","poem":1},{"lineBreak":true},{"text":"钱能叫万事应心。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你不可咒诅君王，","poem":1},{"lineBreak":true},{"text":"也不可心怀此念；","poem":1},{"lineBreak":true},{"text":"在你卧房也不可咒诅富户。","poem":1},{"lineBreak":true},{"text":"因为空中的鸟必传扬这声音，","poem":1},{"lineBreak":true},{"text":"有翅膀的也必述说这事。","poem":1}]}],"footnotes":[{"noteId":7,"caller":"-","text":"或译：挪移","reference":{"chapter":10,"verse":9}}]},"thisChapterLink":"/api/cmn_cu1/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}