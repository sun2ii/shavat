{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cu1","name":"传道书","commonName":"传道书","title":"传道书","order":21,"numberOfChapters":12,"sha256":"4f50543f99f7225fcd6ddfe629f589e05c0655922cd97b07218d4e006aaad07c","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cu1/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":3,"content":[{"type":"heading","content":["万事均有定时"]},{"type":"verse","number":1,"content":[{"text":"凡事都有定期，","poem":1},{"lineBreak":true},{"text":"天下万务都有定时。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"生有时，死有时；","poem":1},{"lineBreak":true},{"text":"栽种有时，拔出所栽种的也有时；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"杀戮有时，医治有时；","poem":1},{"lineBreak":true},{"text":"拆毁有时，建造有时；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"哭有时，笑有时；","poem":1},{"lineBreak":true},{"text":"哀恸有时，跳舞有时；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"抛掷石头有时，堆聚石头有时；","poem":1},{"lineBreak":true},{"text":"怀抱有时，不怀抱有时；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"寻找有时，失落有时；","poem":1},{"lineBreak":true},{"text":"保守有时，舍弃有时；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"撕裂有时，缝补有时；","poem":1},{"lineBreak":true},{"text":"静默有时，言语有时；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"喜爱有时，恨恶有时；","poem":1},{"lineBreak":true},{"text":"争战有时，和好有时。","poem":1}]},{"type":"verse","number":9,"content":["这样看来，做事的人在他的劳碌上有什么益处呢？"]},{"type":"verse","number":10,"content":["我见 神叫世人劳苦，使他们在其中受经练。"]},{"type":"verse","number":11,"content":["神造万物，各按其时成为美好，又将永生",{"noteId":2},"安置在世人心里。然而 神从始至终的作为，人不能参透。"]},{"type":"verse","number":12,"content":["我知道世人，莫强如终身喜乐行善；"]},{"type":"verse","number":13,"content":["并且人人吃喝，在他一切劳碌中享福，这也是 神的恩赐。"]},{"type":"verse","number":14,"content":["我知道 神一切所做的都必永存；无所增添，无所减少。 神这样行，是要人在他面前存敬畏的心。"]},{"type":"verse","number":15,"content":["现今的事早先就有了，将来的事早已也有了，并且 神使已过的事重新再来",{"noteId":3},"。"]},{"type":"heading","content":["世上的不公平"]},{"type":"verse","number":16,"content":["我又见日光之下，在审判之处有奸恶，在公义之处也有奸恶。"]},{"type":"verse","number":17,"content":["我心里说， 神必审判义人和恶人；因为在那里，各样事务，一切工作，都有定时。"]},{"type":"verse","number":18,"content":["我心里说，这乃为世人的缘故，是 神要试验他们，使他们觉得自己不过像兽一样。"]},{"type":"verse","number":19,"content":["因为世人遭遇的，兽也遭遇，所遭遇的都是一样：这个怎样死，那个也怎样死，气息都是一样。人不能强于兽，都是虚空。"]},{"type":"verse","number":20,"content":["都归一处，都是出于尘土，也都归于尘土。"]},{"type":"verse","number":21,"content":["谁知道人的灵是往上升，兽的魂是下入地呢？"]},{"type":"verse","number":22,"content":["故此，我见人莫强如在他经营的事上喜乐，因为这是他的分。他身后的事谁能使他回来得见呢？"]}],"footnotes":[{"noteId":2,"caller":"-","text":"原文是永远","reference":{"chapter":3,"verse":11}},{"noteId":3,"caller":"-","text":"或译：并且 神再寻回已过的事","reference":{"chapter":3,"verse":15}}]},"thisChapterLink":"/api/cmn_cu1/ECC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ECC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ECC/2.json","previousChapterAudioLinks":{},"numberOfVerses":22}