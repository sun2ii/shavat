{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cu1","name":"传道书","commonName":"传道书","title":"传道书","order":21,"numberOfChapters":12,"sha256":"4f50543f99f7225fcd6ddfe629f589e05c0655922cd97b07218d4e006aaad07c","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cu1/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":7,"content":[{"type":"heading","content":["智愚之别"]},{"type":"verse","number":1,"content":[{"text":"名誉强如美好的膏油；人死的日子胜过人生的日子。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"往遭丧的家去，","poem":1},{"lineBreak":true},{"text":"强如往宴乐的家去；","poem":1},{"lineBreak":true},{"text":"因为死是众人的结局，","poem":1},{"lineBreak":true},{"text":"活人也必将这事放在心上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"忧愁强如喜笑；","poem":1},{"lineBreak":true},{"text":"因为面带愁容，终必使心喜乐。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"智慧人的心在遭丧之家；","poem":1},{"lineBreak":true},{"text":"愚昧人的心在快乐之家。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"听智慧人的责备，","poem":1},{"lineBreak":true},{"text":"强如听愚昧人的歌唱。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愚昧人的笑声，","poem":1},{"lineBreak":true},{"text":"好像锅下烧荆棘的爆声；","poem":1},{"lineBreak":true},{"text":"这也是虚空。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"勒索使智慧人变为愚妄；","poem":1},{"lineBreak":true},{"text":"贿赂能败坏人的慧心。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"事情的终局强如事情的起头；","poem":1},{"lineBreak":true},{"text":"存心忍耐的，胜过居心骄傲的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你不要心里急躁恼怒，","poem":1},{"lineBreak":true},{"text":"因为恼怒存在愚昧人的怀中。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"不要说：","poem":1},{"lineBreak":true},{"text":"先前的日子强过如今的日子，","poem":1},{"lineBreak":true},{"text":"是什么缘故呢？","poem":1},{"lineBreak":true},{"text":"你这样问，不是出于智慧。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"智慧和产业并好，","poem":1},{"lineBreak":true},{"text":"而且见天日的人得智慧更为有益。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因为智慧护庇人，","poem":1},{"lineBreak":true},{"text":"好像银钱护庇人一样。","poem":1},{"lineBreak":true},{"text":"惟独智慧能保全智慧人的生命。","poem":1},{"lineBreak":true},{"text":"这就是知识的益处。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你要察看 神的作为；","poem":1},{"lineBreak":true},{"text":"因 神使为曲的，谁能变为直呢？","poem":1}]},{"type":"verse","number":14,"content":["遇亨通的日子你当喜乐；遭患难的日子你当思想；因为 神使这两样并列，为的是叫人查不出身后有什么事。"]},{"type":"verse","number":15,"content":["有义人行义，反致灭亡；有恶人行恶，倒享长寿。这都是我在虚度之日中所见过的。"]},{"type":"verse","number":16,"content":["不要行义过分，也不要过于自逞智慧，何必自取败亡呢？"]},{"type":"verse","number":17,"content":["不要行恶过分，也不要为人愚昧，何必不到期而死呢？"]},{"type":"verse","number":18,"content":["你持守这个为美，那个也不要松手；因为敬畏 神的人，必从这两样出来。"]},{"type":"verse","number":19,"content":["智慧使有智慧的人比城中十个官长更有能力。"]},{"type":"verse","number":20,"content":["时常行善而不犯罪的义人，世上实在没有。"]},{"type":"verse","number":21,"content":["人所说的一切话，你不要放在心上，恐怕听见你的仆人咒诅你。"]},{"type":"verse","number":22,"content":["因为你心里知道，自己也曾屡次咒诅别人。"]},{"type":"verse","number":23,"content":["我曾用智慧试验这一切事；我说，要得智慧，智慧却离我远。"]},{"type":"verse","number":24,"content":["万事之理，离我甚远，而且最深，谁能测透呢？"]},{"type":"verse","number":25,"content":["我转念，一心要知道，要考察，要寻求智慧和万事的理由；又要知道邪恶为愚昧，愚昧为狂妄。"]},{"type":"verse","number":26,"content":["我得知有等妇人比死还苦：她的心是网罗，手是锁链。凡蒙 神喜悦的人必能躲避她；有罪的人却被她缠住了。"]},{"type":"verse","number":27,"content":["传道者说：「看哪，一千男子中，我找到一个正直人，但众女子中，没有找到一个。」我将这事一一比较，要寻求其理，我心仍要寻找，却未曾找到。"]},{"type":"verse","number":29,"content":["我所找到的只有一件，就是 神造人原是正直，但他们寻出许多巧计。"]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":28}