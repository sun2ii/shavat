{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"EPH","translationId":"cmn_cu1","name":"以弗所书","commonName":"以弗所书","title":"以弗所书","order":49,"numberOfChapters":6,"sha256":"2ac18dbf4261729a6066f17020268ade9794f1e51a047d656eaddb61447bb9b3","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/EPH/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/cmn_cu1/EPH/6.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["保罗奉差向外邦人传福音"]},{"type":"verse","number":1,"content":["因此，我—保罗为你们外邦人作了基督耶稣被囚的，替你们祈祷",{"noteId":5},"。"]},{"type":"verse","number":2,"content":["谅必你们曾听见 神赐恩给我，将关切你们的职分托付我，"]},{"type":"verse","number":3,"content":["用启示使我知道福音的奥秘，正如我以前略略写过的。"]},{"type":"verse","number":4,"content":["你们念了，就能晓得我深知基督的奥秘。"]},{"type":"verse","number":5,"content":["这奥秘在以前的世代没有叫人知道，像如今借着圣灵启示他的圣使徒和先知一样。"]},{"type":"verse","number":6,"content":["这奥秘就是外邦人在基督耶稣里，借着福音，得以同为后嗣，同为一体，同蒙应许。"]},{"type":"verse","number":7,"content":["我作了这福音的执事，是照 神的恩赐，这恩赐是照他运行的大能赐给我的。"]},{"type":"verse","number":8,"content":["我本来比众圣徒中最小的还小，然而他还赐我这恩典，叫我把基督那测不透的丰富传给外邦人，"]},{"type":"verse","number":9,"content":["又使众人都明白，这历代以来隐藏在创造万物之 神里的奥秘是如何安排的，"]},{"type":"verse","number":10,"content":["为要借着教会使天上执政的、掌权的，现在得知 神百般的智慧。"]},{"type":"verse","number":11,"content":["这是照 神从万世以前，在我们主基督耶稣里所定的旨意。"]},{"type":"verse","number":12,"content":["我们因信耶稣，就在他里面放胆无惧，笃信不疑地来到 神面前。"]},{"type":"verse","number":13,"content":["所以，我求你们不要因我为你们所受的患难丧胆，这原是你们的荣耀。"]},{"type":"heading","content":["明白基督的爱"]},{"type":"verse","number":14,"content":["因此，我在父面前屈膝，（"]},{"type":"verse","number":15,"content":["天上地上的各",{"noteId":6},"家，都是从他得名。）"]},{"type":"verse","number":16,"content":["求他按着他丰盛的荣耀，借着他的灵，叫你们心里的力量刚强起来，"]},{"type":"verse","number":17,"content":["使基督因你们的信，住在你们心里，叫你们的爱心有根有基，"]},{"type":"verse","number":18,"content":["能以和众圣徒一同明白基督的爱是何等长阔高深，"]},{"type":"verse","number":19,"content":["并知道这爱是过于人所能测度的，便叫 神一切所充满的，充满了你们。"]},{"type":"verse","number":20,"content":["神能照着运行在我们心里的大力充充足足地成就一切，超过我们所求所想的。"]},{"type":"verse","number":21,"content":["但愿他在教会中，并在基督耶稣里，得着荣耀，直到世世代代，永永远远。阿们！"]}],"footnotes":[{"noteId":5,"caller":"-","text":"此句是照对十四节所加","reference":{"chapter":3,"verse":1}},{"noteId":6,"caller":"-","text":"或译：全","reference":{"chapter":3,"verse":15}}]},"thisChapterLink":"/api/cmn_cu1/EPH/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/EPH/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/EPH/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}