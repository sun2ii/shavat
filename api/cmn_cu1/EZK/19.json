{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"EZK","translationId":"cmn_cu1","name":"以西结书","commonName":"以西结书","title":"以西结书","order":26,"numberOfChapters":48,"sha256":"aa1b925988838e1371bb072e339379f03dcec5f83d41111f9f14f58e31d5e89e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/cmn_cu1/EZK/48.json","totalNumberOfVerses":1270},"chapter":{"number":19,"content":[{"type":"heading","content":["挽歌"]},{"type":"verse","number":1,"content":["你当为以色列的王作起哀歌，"]},{"type":"verse","number":2,"content":["说：",{"text":"你的母亲是什么呢？","poem":1},{"lineBreak":true},{"text":"是个母狮子，蹲伏在狮子中间，","poem":1},{"lineBreak":true},{"text":"在少壮狮子中养育小狮子。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"在它小狮子中养大一个，","poem":1},{"lineBreak":true},{"text":"成了少壮狮子，","poem":1},{"lineBreak":true},{"text":"学会抓食而吃人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"列国听见了就把它捉在他们的坑中，","poem":1},{"lineBreak":true},{"text":"用钩子拉到埃及地去。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"母狮见自己等候失了指望，","poem":1},{"lineBreak":true},{"text":"就从它小狮子中又将一个养为少壮狮子。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"它在众狮子中走来走去，","poem":1},{"lineBreak":true},{"text":"成了少壮狮子，","poem":1},{"lineBreak":true},{"text":"学会抓食而吃人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"它知道列国的宫殿，","poem":1},{"lineBreak":true},{"text":"又使他们的城邑变为荒场；","poem":1},{"lineBreak":true},{"text":"因它咆哮的声音，","poem":1},{"lineBreak":true},{"text":"遍地和其中所有的就都荒废。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"于是四围邦国各省的人来攻击它，","poem":1},{"lineBreak":true},{"text":"将网撒在它身上，","poem":1},{"lineBreak":true},{"text":"捉在他们的坑中。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们用钩子钩住它，将它放在笼中，","poem":1},{"lineBreak":true},{"text":"带到巴比伦王那里，","poem":1},{"lineBreak":true},{"text":"将它放入坚固之所，","poem":1},{"lineBreak":true},{"text":"使它的声音在以色列山上不再听见。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你的母亲先前如葡萄树，","poem":1},{"lineBreak":true},{"text":"极其茂盛","poem":1},{"noteId":20},{"text":"，栽于水旁。","poem":1},{"lineBreak":true},{"text":"因为水多，","poem":1},{"lineBreak":true},{"text":"就多结果子，满生枝子；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"生出坚固的枝干，可作掌权者的杖。","poem":1},{"lineBreak":true},{"text":"这枝干高举在茂密的枝中，","poem":1},{"lineBreak":true},{"text":"而且它生长高大，枝子繁多，","poem":1},{"lineBreak":true},{"text":"远远可见。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"但这葡萄树因忿怒被拔出摔在地上；","poem":1},{"lineBreak":true},{"text":"东风吹干其上的果子，","poem":1},{"lineBreak":true},{"text":"坚固的枝干折断枯干，","poem":1},{"lineBreak":true},{"text":"被火烧毁了；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"如今栽于旷野干旱无水之地。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"火也从它枝干中发出，","poem":1},{"lineBreak":true},{"text":"烧灭果子，","poem":1},{"lineBreak":true},{"text":"以致没有坚固的枝干可做掌权者的杖。","poem":1},{"lineBreak":true},{"text":"这是哀歌，也必用以作哀歌。","poem":1}]}],"footnotes":[{"noteId":20,"caller":"-","text":"原文是在你血中","reference":{"chapter":19,"verse":10}}]},"thisChapterLink":"/api/cmn_cu1/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}