{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"EZK","translationId":"cmn_cu1","name":"以西结书","commonName":"以西结书","title":"以西结书","order":26,"numberOfChapters":48,"sha256":"aa1b925988838e1371bb072e339379f03dcec5f83d41111f9f14f58e31d5e89e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/cmn_cu1/EZK/48.json","totalNumberOfVerses":1270},"chapter":{"number":27,"content":[{"type":"heading","content":["哀悼泰尔的挽歌"]},{"type":"verse","number":1,"content":["耶和华的话又临到我说："]},{"type":"verse","number":2,"content":["「人子啊，要为泰尔作起哀歌，"]},{"type":"verse","number":3,"content":["说：你居住海口，是众民的商埠；你的交易通到许多的海岛。主耶和华如此说：",{"text":"泰尔啊，你曾说：","poem":1},{"lineBreak":true},{"text":"我是全然美丽的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的境界在海中，","poem":1},{"lineBreak":true},{"text":"造你的使你全然美丽。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们用示尼珥的松树做你的一切板，","poem":1},{"lineBreak":true},{"text":"用黎巴嫩的香柏树做桅杆，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"用巴珊的橡树做你的桨，","poem":1},{"lineBreak":true},{"text":"用象牙镶嵌基提海岛的黄杨木为坐板","poem":1},{"noteId":26},{"text":"。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的篷帆是用埃及绣花细麻布做的，","poem":1},{"lineBreak":true},{"text":"可以做你的大旗；","poem":1},{"lineBreak":true},{"text":"你的凉棚是用以利沙岛的蓝色、紫色布做的。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"西顿和亚发的居民作你荡桨的。","poem":1},{"lineBreak":true},{"text":"泰尔啊，你中间的智慧人作掌舵的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"迦巴勒的老者和聪明人","poem":1},{"lineBreak":true},{"text":"都在你中间作补缝的；","poem":1},{"lineBreak":true},{"text":"一切泛海的船只和水手","poem":1},{"lineBreak":true},{"text":"都在你中间经营交易的事。","poem":1}]},{"type":"verse","number":10,"content":["「波斯人、路德人、弗人在你军营中作战士；他们在你中间悬挂盾牌和头盔，彰显你的尊荣。"]},{"type":"verse","number":11,"content":["亚发人和你的军队都在你四围的墙上，你的望楼也有勇士；他们悬挂盾牌，成全你的美丽。"]},{"type":"verse","number":12,"content":["「他施人因你多有各类的财物，就作你的客商，拿银、铁、锡、铅兑换你的货物。"]},{"type":"verse","number":13,"content":["雅完人、土巴人、米设人都与你交易；他们用人口和铜器兑换你的货物。"]},{"type":"verse","number":14,"content":["陀迦玛族用马和战马并骡子兑换你的货物。"]},{"type":"verse","number":15,"content":["底但人与你交易，许多海岛作你的码头；他们拿象牙、乌木与你兑换",{"noteId":27},"。"]},{"type":"verse","number":16,"content":["亚兰人因你的工作很多，就作你的客商；他们用绿宝石、紫色布绣货、细麻布、珊瑚、红宝石兑换你的货物。"]},{"type":"verse","number":17,"content":["犹大和以色列地的人都与你交易；他们用米匿的麦子、饼、蜜、油、乳香兑换你的货物。"]},{"type":"verse","number":18,"content":["大马士革人因你的工作很多，又因你多有各类的财物，就拿黑本酒和白羊毛与你交易。"]},{"type":"verse","number":19,"content":["威但人和雅完人拿纺成的线、亮铁、桂皮、菖蒲兑换你的货物。"]},{"type":"verse","number":20,"content":["底但人用高贵的毯子、鞍、屉与你交易。"]},{"type":"verse","number":21,"content":["阿拉伯人和基达的一切首领都作你的客商，用羊羔、公绵羊、公山羊与你交易。"]},{"type":"verse","number":22,"content":["示巴和拉玛的商人与你交易，他们用各类上好的香料、各类的宝石，和黄金兑换你的货物。"]},{"type":"verse","number":23,"content":["哈兰人、干尼人、伊甸人、示巴的商人，和亚述人、基抹人与你交易。"]},{"type":"verse","number":24,"content":["这些商人以美好的货物包在绣花蓝色包袱内，又有华丽的衣服装在香柏木的箱子里，用绳捆着与你交易。"]},{"type":"verse","number":25,"content":[{"text":"他施的船只接连成帮为你运货，","poem":1},{"lineBreak":true},{"text":"你便在海中丰富极其荣华。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"荡桨的已经把你荡到大水之处，","poem":1},{"lineBreak":true},{"text":"东风在海中将你打破。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你的资财、物件、货物、","poem":1},{"lineBreak":true},{"text":"水手、掌舵的、","poem":1},{"lineBreak":true},{"text":"补缝的、经营交易的，","poem":1},{"lineBreak":true},{"text":"并你中间的战士和人民，","poem":1},{"lineBreak":true},{"text":"在你破坏的日子必都沉在海中。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你掌舵的呼号之声一发，","poem":1},{"lineBreak":true},{"text":"郊野都必震动。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"凡荡桨的和水手，","poem":1},{"lineBreak":true},{"text":"并一切泛海掌舵的，","poem":1},{"lineBreak":true},{"text":"都必下船登岸。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他们必为你放声痛哭，","poem":1},{"lineBreak":true},{"text":"把尘土撒在头上，","poem":1},{"lineBreak":true},{"text":"在灰中打滚；","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"又为你使头上光秃，","poem":1},{"lineBreak":true},{"text":"用麻布束腰，","poem":1},{"lineBreak":true},{"text":"号咷痛哭，","poem":1},{"lineBreak":true},{"text":"苦苦悲哀。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他们哀号的时候，","poem":1},{"lineBreak":true},{"text":"为你作起哀歌哀哭，","poem":1},{"lineBreak":true},{"text":"说：有何城如泰尔？","poem":1},{"lineBreak":true},{"text":"有何城如她在海中成为寂寞的呢？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"你由海上运出货物，","poem":1},{"lineBreak":true},{"text":"就使许多国民充足；","poem":1},{"lineBreak":true},{"text":"你以许多资财、货物","poem":1},{"lineBreak":true},{"text":"使地上的君王丰富。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你在深水中被海浪打破的时候，","poem":1},{"lineBreak":true},{"text":"你的货物和你中间的一切人民，","poem":1},{"lineBreak":true},{"text":"就都沉下去了。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"海岛的居民为你惊奇；","poem":1},{"lineBreak":true},{"text":"他们的君王都甚恐慌，","poem":1},{"lineBreak":true},{"text":"面带愁容。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"各国民中的客商都向你发嘶声；","poem":1},{"lineBreak":true},{"text":"你令人惊恐，","poem":1},{"lineBreak":true},{"text":"不再存留于世，直到永远。」","poem":1}]}],"footnotes":[{"noteId":26,"caller":"-","text":"或译：舱板","reference":{"chapter":27,"verse":6}},{"noteId":27,"caller":"-","text":"或译：进贡","reference":{"chapter":27,"verse":15}}]},"thisChapterLink":"/api/cmn_cu1/EZK/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/EZK/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/EZK/26.json","previousChapterAudioLinks":{},"numberOfVerses":36}