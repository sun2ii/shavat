{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"GEN","translationId":"cmn_cu1","name":"创世记","commonName":"创世记","title":"创世记","order":1,"numberOfChapters":50,"sha256":"cce15cc7fd65c9f16227e0f34f3b0514633bfb9ef883e0936d6560885eb025fb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cmn_cu1/GEN/50.json","totalNumberOfVerses":1532},"chapter":{"number":3,"content":[{"type":"heading","content":["人违背命令"]},{"type":"verse","number":1,"content":["耶和华 神所造的，惟有蛇比田野一切的活物更狡猾。蛇对女人说：「 神岂是真说不许你们吃园中所有树上的果子吗？」"]},{"type":"verse","number":2,"content":["女人对蛇说：「园中树上的果子，我们可以吃，"]},{"type":"verse","number":3,"content":["惟有园当中那棵树上的果子， 神曾说：『你们不可吃，也不可摸，免得你们死。』」"]},{"type":"verse","number":4,"content":["蛇对女人说：「你们不一定死；"]},{"type":"verse","number":5,"content":["因为 神知道，你们吃的日子眼睛就明亮了，你们便如 神能知道善恶。」"]},{"type":"verse","number":6,"content":["于是女人见那棵树的果子好作食物，也悦人的眼目，且是可喜爱的，能使人有智慧，就摘下果子来吃了，又给她丈夫，她丈夫也吃了。"]},{"type":"verse","number":7,"content":["他们二人的眼睛就明亮了，才知道自己是赤身露体，便拿无花果树的叶子为自己编做裙子。"]},{"type":"verse","number":8,"content":["天起了凉风，耶和华 神在园中行走。那人和他妻子听见 神的声音，就藏在园里的树木中，躲避耶和华 神的面。"]},{"type":"verse","number":9,"content":["耶和华 神呼唤那人，对他说：「你在哪里？」"]},{"type":"verse","number":10,"content":["他说：「我在园中听见你的声音，我就害怕；因为我赤身露体，我便藏了。」"]},{"type":"verse","number":11,"content":["耶和华说：「谁告诉你赤身露体呢？莫非你吃了我吩咐你不可吃的那树上的果子吗？」"]},{"type":"verse","number":12,"content":["那人说：「你所赐给我、与我同居的女人，她把那树上的果子给我，我就吃了。」"]},{"type":"verse","number":13,"content":["耶和华 神对女人说：「你做的是什么事呢？」女人说：「那蛇引诱我，我就吃了。」"]},{"type":"heading","content":["神的宣判"]},{"type":"verse","number":14,"content":[{"text":"耶和华 神对蛇说：","poem":1},{"lineBreak":true},{"text":"你既做了这事，就必受咒诅，","poem":1},{"lineBreak":true},{"text":"比一切的牲畜野兽更甚；","poem":1},{"lineBreak":true},{"text":"你必用肚子行走，","poem":1},{"lineBreak":true},{"text":"终身吃土。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我又要叫你和女人彼此为仇；","poem":1},{"lineBreak":true},{"text":"你的后裔和女人的后裔也彼此为仇。","poem":1},{"lineBreak":true},{"text":"女人的后裔要伤你的头；","poem":1},{"lineBreak":true},{"text":"你要伤他的脚跟。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"又对女人说：","poem":1},{"lineBreak":true},{"text":"我必多多加增你怀胎的苦楚；","poem":1},{"lineBreak":true},{"text":"你生产儿女必多受苦楚。","poem":1},{"lineBreak":true},{"text":"你必恋慕你丈夫；","poem":1},{"lineBreak":true},{"text":"你丈夫必管辖你。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"又对亚当说：","poem":1},{"lineBreak":true},{"text":"你既听从妻子的话，","poem":1},{"lineBreak":true},{"text":"吃了我所吩咐你不可吃的那树上的果子，","poem":1},{"lineBreak":true},{"text":"地必为你的缘故受咒诅；","poem":1},{"lineBreak":true},{"text":"你必终身劳苦才能从地里得吃的。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"地必给你长出荆棘和蒺藜来；","poem":1},{"lineBreak":true},{"text":"你也要吃田间的菜蔬。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你必汗流满面才得糊口，","poem":1},{"lineBreak":true},{"text":"直到你归了土，","poem":1},{"lineBreak":true},{"text":"因为你是从土而出的。","poem":1},{"lineBreak":true},{"text":"你本是尘土，仍要归于尘土。","poem":1}]},{"type":"verse","number":20,"content":["亚当给他妻子起名叫夏娃，因为她是众生之母。"]},{"type":"verse","number":21,"content":["耶和华 神为亚当和他妻子用皮子做衣服给他们穿。"]},{"type":"heading","content":["亚当和夏娃被赶出伊甸园"]},{"type":"verse","number":22,"content":["耶和华 神说：「那人已经与我们相似，能知道善恶；现在恐怕他伸手又摘生命树的果子吃，就永远活着。」"]},{"type":"verse","number":23,"content":["耶和华 神便打发他出伊甸园去，耕种他所自出之土。"]},{"type":"verse","number":24,"content":["于是把他赶出去了；又在伊甸园的东边安设基路伯和四面转动发火焰的剑，要把守生命树的道路。"]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/GEN/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/GEN/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/GEN/2.json","previousChapterAudioLinks":{},"numberOfVerses":24}