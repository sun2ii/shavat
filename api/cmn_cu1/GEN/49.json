{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"GEN","translationId":"cmn_cu1","name":"创世记","commonName":"创世记","title":"创世记","order":1,"numberOfChapters":50,"sha256":"cce15cc7fd65c9f16227e0f34f3b0514633bfb9ef883e0936d6560885eb025fb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cmn_cu1/GEN/50.json","totalNumberOfVerses":1532},"chapter":{"number":49,"content":[{"type":"heading","content":["雅各的遗嘱"]},{"type":"verse","number":1,"content":["雅各叫了他的儿子们来，说：「你们都来聚集，我好把你们日后必遇的事告诉你们。"]},{"type":"verse","number":2,"content":[{"text":"雅各的儿子们，你们要聚集而听，","poem":1},{"lineBreak":true},{"text":"要听你们父亲以色列的话。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"吕便哪，你是我的长子，","poem":1},{"lineBreak":true},{"text":"是我力量强壮的时候生的，","poem":1},{"lineBreak":true},{"text":"本当大有尊荣，权力超众。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"但你放纵情欲，滚沸如水，","poem":1},{"lineBreak":true},{"text":"必不得居首位；","poem":1},{"lineBreak":true},{"text":"因为你上了你父亲的床，","poem":1},{"lineBreak":true},{"text":"污秽了我的榻。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"西缅和利未是弟兄；","poem":1},{"lineBreak":true},{"text":"他们的刀剑是残忍的器具。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的灵啊，不要与他们同谋；","poem":1},{"lineBreak":true},{"text":"我的心哪，不要与他们联络；","poem":1},{"lineBreak":true},{"text":"因为他们趁怒杀害人命，","poem":1},{"lineBreak":true},{"text":"任意砍断牛腿大筋。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们的怒气暴烈可咒；","poem":1},{"lineBreak":true},{"text":"他们的忿恨残忍可诅。","poem":1},{"lineBreak":true},{"text":"我要使他们分居在雅各家里，","poem":1},{"lineBreak":true},{"text":"散住在以色列地中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"犹大啊，你弟兄们必赞美你；","poem":1},{"lineBreak":true},{"text":"你手必掐住仇敌的颈项；","poem":1},{"lineBreak":true},{"text":"你父亲的儿子们必向你下拜。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"犹大是个小狮子；","poem":1},{"lineBreak":true},{"text":"我儿啊，你抓了食便上去。","poem":1},{"lineBreak":true},{"text":"你屈下身去，卧如公狮，","poem":1},{"lineBreak":true},{"text":"蹲如母狮，谁敢惹你？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"圭必不离犹大，","poem":1},{"lineBreak":true},{"text":"杖必不离他两脚之间，","poem":1},{"lineBreak":true},{"text":"直等细罗","poem":1},{"noteId":55},{"text":"来到，","poem":1},{"lineBreak":true},{"text":"万民都必归顺。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"犹大把小驴拴在葡萄树上，","poem":1},{"lineBreak":true},{"text":"把驴驹拴在美好的葡萄树上。","poem":1},{"lineBreak":true},{"text":"他在葡萄酒中洗了衣服，","poem":1},{"lineBreak":true},{"text":"在葡萄汁中洗了袍褂。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他的眼睛必因酒红润；","poem":1},{"lineBreak":true},{"text":"他的牙齿必因奶白亮。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"西布伦必住在海口，","poem":1},{"lineBreak":true},{"text":"必成为停船的海口；","poem":1},{"lineBreak":true},{"text":"他的境界必延到西顿。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"以萨迦是个强壮的驴，","poem":1},{"lineBreak":true},{"text":"卧在羊圈之中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他以安静为佳，以肥地为美，","poem":1},{"lineBreak":true},{"text":"便低肩背重，成为服苦的仆人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"但必判断他的民，","poem":1},{"lineBreak":true},{"text":"作以色列支派之一。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"但必作道上的蛇，路中的虺，","poem":1},{"lineBreak":true},{"text":"咬伤马蹄，使骑马的坠落于后。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和华啊，我向来等候你的救恩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"迦得必被敌军追逼，","poem":1},{"lineBreak":true},{"text":"他却要追逼他们的脚跟。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"亚设之地必出肥美的粮食，","poem":1},{"lineBreak":true},{"text":"且出君王的美味。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"拿弗他利是被释放的母鹿；","poem":1},{"lineBreak":true},{"text":"他出嘉美的言语。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"约瑟是多结果子的树枝，","poem":1},{"lineBreak":true},{"text":"是泉旁多结果的枝子；","poem":1},{"lineBreak":true},{"text":"他的枝条探出墙外。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"弓箭手将他苦害，","poem":1},{"lineBreak":true},{"text":"向他射箭，逼迫他。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"但他的弓仍旧坚硬；","poem":1},{"lineBreak":true},{"text":"他的手健壮敏捷。","poem":1},{"lineBreak":true},{"text":"这是因以色列的牧者，以色列的磐石—","poem":1},{"lineBreak":true},{"text":"就是雅各的大能者。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你父亲的 神必帮助你；","poem":1},{"lineBreak":true},{"text":"那全能者必将天上所有的福，","poem":1},{"lineBreak":true},{"text":"地里所藏的福，以及生产乳养的福，都赐给你。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你父亲所祝的福","poem":1},{"lineBreak":true},{"text":"胜过我祖先所祝的福，","poem":1},{"lineBreak":true},{"text":"如永世的山岭，至极的边界；","poem":1},{"lineBreak":true},{"text":"这些福必降在约瑟的头上，","poem":1},{"lineBreak":true},{"text":"临到那与弟兄迥别之人的顶上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"便雅悯是个撕掠的狼，","poem":1},{"lineBreak":true},{"text":"早晨要吃他所抓的，","poem":1},{"lineBreak":true},{"text":"晚上要分他所夺的。」","poem":1}]},{"type":"verse","number":28,"content":["这一切是以色列的十二支派；这也是他们的父亲对他们所说的话，为他们所祝的福，都是按着各人的福分为他们祝福。"]},{"type":"heading","content":["雅各的死和埋葬"]},{"type":"verse","number":29,"content":["他又嘱咐他们说：「我将要归到我列祖",{"noteId":56},"那里，你们要将我葬在赫人以弗 田间的洞里，与我祖我父在一处，"]},{"type":"verse","number":30,"content":["就是在迦南地幔利前、麦比拉田间的洞；那洞和田是亚伯拉罕向赫人以弗 买来为业，作坟地的。"]},{"type":"verse","number":31,"content":["他们在那里葬了亚伯拉罕和他妻子撒拉，又在那里葬了以撒和他的妻子利百加；我也在那里葬了利亚。"]},{"type":"verse","number":32,"content":["那块田和田间的洞原是向赫人买的。」"]},{"type":"verse","number":33,"content":["雅各嘱咐众子已毕，就把脚收在床上，气绝而死，归他列祖",{"noteId":57},"那里去了。"]}],"footnotes":[{"noteId":55,"caller":"-","text":"就是赐平安者","reference":{"chapter":49,"verse":10}},{"noteId":56,"caller":"-","text":"原文是本民","reference":{"chapter":49,"verse":29}},{"noteId":57,"caller":"-","text":"原文是本民","reference":{"chapter":49,"verse":33}}]},"thisChapterLink":"/api/cmn_cu1/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}