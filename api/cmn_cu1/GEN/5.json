{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"GEN","translationId":"cmn_cu1","name":"创世记","commonName":"创世记","title":"创世记","order":1,"numberOfChapters":50,"sha256":"cce15cc7fd65c9f16227e0f34f3b0514633bfb9ef883e0936d6560885eb025fb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cmn_cu1/GEN/50.json","totalNumberOfVerses":1532},"chapter":{"number":5,"content":[{"type":"heading","content":["亚当的后代"]},{"type":"verse","number":1,"content":["亚当的后代记在下面。（当 神造人的日子，是照着自己的样式造的，"]},{"type":"verse","number":2,"content":["并且造男造女。在他们被造的日子， 神赐福给他们，称他们为「人」。）"]},{"type":"verse","number":3,"content":["亚当活到一百三十岁，生了一个儿子，形象样式和自己相似，就给他起名叫塞特。"]},{"type":"verse","number":4,"content":["亚当生塞特之后，又在世八百年，并且生儿养女。"]},{"type":"verse","number":5,"content":["亚当共活了九百三十岁就死了。"]},{"type":"verse","number":6,"content":["塞特活到一百零五岁，生了以挪士。"]},{"type":"verse","number":7,"content":["塞特生以挪士之后，又活了八百零七年，并且生儿养女。"]},{"type":"verse","number":8,"content":["塞特共活了九百一十二岁就死了。"]},{"type":"verse","number":9,"content":["以挪士活到九十岁，生了该南。"]},{"type":"verse","number":10,"content":["以挪士生该南之后，又活了八百一十五年，并且生儿养女。"]},{"type":"verse","number":11,"content":["以挪士共活了九百零五岁就死了。"]},{"type":"verse","number":12,"content":["该南活到七十岁，生了玛勒列。"]},{"type":"verse","number":13,"content":["该南生玛勒列之后，又活了八百四十年，并且生儿养女。"]},{"type":"verse","number":14,"content":["该南共活了九百一十岁就死了。"]},{"type":"verse","number":15,"content":["玛勒列活到六十五岁，生了雅列。"]},{"type":"verse","number":16,"content":["玛勒列生雅列之后，又活了八百三十年，并且生儿养女。"]},{"type":"verse","number":17,"content":["玛勒列共活了八百九十五岁就死了。"]},{"type":"verse","number":18,"content":["雅列活到一百六十二岁，生了以诺。"]},{"type":"verse","number":19,"content":["雅列生以诺之后，又活了八百年，并且生儿养女。"]},{"type":"verse","number":20,"content":["雅列共活了九百六十二岁就死了。"]},{"type":"verse","number":21,"content":["以诺活到六十五岁，生了玛土撒拉。"]},{"type":"verse","number":22,"content":["以诺生玛土撒拉之后，与 神同行三百年，并且生儿养女。"]},{"type":"verse","number":23,"content":["以诺共活了三百六十五岁。"]},{"type":"verse","number":24,"content":["以诺与 神同行， 神将他取去，他就不在世了。"]},{"type":"verse","number":25,"content":["玛土撒拉活到一百八十七岁，生了拉麦。"]},{"type":"verse","number":26,"content":["玛土撒拉生拉麦之后，又活了七百八十二年，并且生儿养女。"]},{"type":"verse","number":27,"content":["玛土撒拉共活了九百六十九岁就死了。"]},{"type":"verse","number":28,"content":["拉麦活到一百八十二岁，生了一个儿子，"]},{"type":"verse","number":29,"content":["给他起名叫挪亚，说：「这个儿子必为我们的操作和手中的劳苦安慰我们；这操作劳苦是因为耶和华咒诅地。」"]},{"type":"verse","number":30,"content":["拉麦生挪亚之后，又活了五百九十五年，并且生儿养女。"]},{"type":"verse","number":31,"content":["拉麦共活了七百七十七岁就死了。"]},{"type":"verse","number":32,"content":["挪亚五百岁生了闪、含、雅弗。"]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/GEN/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/GEN/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/GEN/4.json","previousChapterAudioLinks":{},"numberOfVerses":32}