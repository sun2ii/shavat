{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HAB","translationId":"cmn_cu1","name":"哈巴谷书","commonName":"哈巴谷书","title":"哈巴谷书","order":35,"numberOfChapters":3,"sha256":"27e8baa39eb6443a7e10b27edb3723b342eb500d5102d70e20e335dcf084f717","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cu1/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["哈巴谷的祈祷"]},{"type":"verse","number":1,"content":["先知哈巴谷的祷告，调用流离歌。"]},{"type":"verse","number":2,"content":[{"text":"耶和华啊，我听见你的名声","poem":1},{"noteId":2},{"text":"就惧怕。","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你在这些年间复兴你的作为，","poem":1},{"lineBreak":true},{"text":"在这些年间显明出来；","poem":1},{"lineBreak":true},{"text":"在发怒的时候以怜悯为念。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"神从提幔而来；","poem":1},{"lineBreak":true},{"text":"圣者从巴兰山临到。 （细拉）","poem":1},{"lineBreak":true},{"text":"他的荣光遮蔽诸天；","poem":1},{"lineBreak":true},{"text":"颂赞充满大地。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他的辉煌如同日光；","poem":1},{"lineBreak":true},{"text":"从他手里射出光线，","poem":1},{"lineBreak":true},{"text":"在其中藏着他的能力。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在他前面有瘟疫流行；","poem":1},{"lineBreak":true},{"text":"在他脚下有热症发出。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他站立，量了大地","poem":1},{"noteId":3},{"text":"，","poem":1},{"lineBreak":true},{"text":"观看，赶散万民。","poem":1},{"lineBreak":true},{"text":"永久的山崩裂；","poem":1},{"lineBreak":true},{"text":"长存的岭塌陷；","poem":1},{"lineBreak":true},{"text":"他的作为与古时一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我见古珊的帐棚遭难，","poem":1},{"lineBreak":true},{"text":"米甸的幔子战兢。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华啊，你乘在马上，","poem":1},{"lineBreak":true},{"text":"坐在得胜的车上，","poem":1},{"lineBreak":true},{"text":"岂是不喜悦江河、","poem":1},{"lineBreak":true},{"text":"向江河发怒气、","poem":1},{"lineBreak":true},{"text":"向洋海发愤恨吗？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你的弓全然显露，","poem":1},{"lineBreak":true},{"text":"向众支派所起的誓都是可信的。 （细拉）","poem":1},{"lineBreak":true},{"text":"你以江河分开大地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"山岭见你，无不战惧；","poem":1},{"lineBreak":true},{"text":"大水泛滥过去，","poem":1},{"lineBreak":true},{"text":"深渊发声，汹涌翻腾","poem":1},{"noteId":4},{"text":"。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因你的箭射出发光，","poem":1},{"lineBreak":true},{"text":"你的枪闪出光耀，","poem":1},{"lineBreak":true},{"text":"日月都在本宫停住。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你发忿恨通行大地，","poem":1},{"lineBreak":true},{"text":"发怒气责打列国，如同打粮。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你出来要拯救你的百姓，","poem":1},{"lineBreak":true},{"text":"拯救你的受膏者，","poem":1},{"lineBreak":true},{"text":"打破恶人家长的头，","poem":1},{"lineBreak":true},{"text":"露出他的脚","poem":1},{"noteId":5},{"text":"，直到颈项。 （细拉）","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你用敌人的戈矛刺透他战士的头；","poem":1},{"lineBreak":true},{"text":"他们来如旋风，要将我们分散。","poem":1},{"lineBreak":true},{"text":"他们所喜爱的是暗中吞吃贫民。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你乘马践踏红海，","poem":1},{"lineBreak":true},{"text":"就是践踏汹涌的大水。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"我听见耶和华的声音，","poem":1},{"lineBreak":true},{"text":"身体战兢，嘴唇发颤，","poem":1},{"lineBreak":true},{"text":"骨中朽烂；","poem":1},{"lineBreak":true},{"text":"我在所立之处战兢。","poem":1},{"lineBreak":true},{"text":"我只可安静等候灾难之日临到，","poem":1},{"lineBreak":true},{"text":"犯境之民上来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"虽然无花果树不发旺，","poem":1},{"lineBreak":true},{"text":"葡萄树不结果，","poem":1},{"lineBreak":true},{"text":"橄榄树也不效力，","poem":1},{"lineBreak":true},{"text":"田地不出粮食，","poem":1},{"lineBreak":true},{"text":"圈中绝了羊，","poem":1},{"lineBreak":true},{"text":"棚内也没有牛；","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"然而，我要因耶和华欢欣，","poem":1},{"lineBreak":true},{"text":"因救我的 神喜乐。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"主耶和华是我的力量；","poem":1},{"lineBreak":true},{"text":"他使我的脚快如母鹿的蹄，","poem":1},{"lineBreak":true},{"text":"又使我稳行在高处。","poem":1},{"lineBreak":true},{"text":"这歌交与伶长，用丝弦的乐器。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"-","text":"或译：言语","reference":{"chapter":3,"verse":2}},{"noteId":3,"caller":"-","text":"或译：使地震动","reference":{"chapter":3,"verse":6}},{"noteId":4,"caller":"-","text":"原文是向上举手","reference":{"chapter":3,"verse":10}},{"noteId":5,"caller":"-","text":"原文是根基","reference":{"chapter":3,"verse":13}}]},"thisChapterLink":"/api/cmn_cu1/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}