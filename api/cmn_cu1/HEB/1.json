{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HEB","translationId":"cmn_cu1","name":"希伯来书","commonName":"希伯来书","title":"希伯来书","order":58,"numberOfChapters":13,"sha256":"2c6f2c6885c0d90704c9582e6fe7720be42b3b4d3b820007897ccb662d08a6fa","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/cmn_cu1/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["神借着他儿子说话"]},{"type":"verse","number":1,"content":["神既在古时借着众先知多次多方地晓谕列祖，"]},{"type":"verse","number":2,"content":["就在这末世借着他儿子晓谕我们；又早已立他为承受万有的，也曾借着他创造诸世界。"]},{"type":"verse","number":3,"content":["他是 神荣耀所发的光辉，是 神本体的真像，常用他权能的命令托住万有。他洗净了人的罪，就坐在高天至大者的右边。"]},{"type":"verse","number":4,"content":["他所承受的名，既比天使的名更尊贵，就远超过天使。"]},{"type":"heading","content":["儿子远超过天使"]},{"type":"verse","number":5,"content":["所有的天使， 神从来对哪一个说：",{"text":"你是我的儿子，","poem":1},{"lineBreak":true},{"text":"我今日生你？","poem":1},"又指着哪一个说：",{"text":"我要作他的父，","poem":1},{"lineBreak":true},{"text":"他要作我的子？","poem":1}]},{"type":"verse","number":6,"content":["再者， 神使长子到世上来的时候",{"noteId":0},"，就说：",{"text":"神的使者都要拜他。","poem":1}]},{"type":"verse","number":7,"content":["论到使者，又说：",{"text":"神以风为使者，","poem":1},{"lineBreak":true},{"text":"以火焰为仆役；","poem":1}]},{"type":"verse","number":8,"content":["论到子却说：",{"text":"神啊，你的宝座是永永远远的；","poem":1},{"lineBreak":true},{"text":"你的国权是正直的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你喜爱公义，恨恶罪恶；","poem":1},{"lineBreak":true},{"text":"所以 神，就是你的 神，用喜乐油膏你，","poem":1},{"lineBreak":true},{"text":"胜过膏你的同伴；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"又说：主啊，你起初立了地的根基；","poem":1},{"lineBreak":true},{"text":"天也是你手所造的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"天地都要灭没，你却要长存。","poem":1},{"lineBreak":true},{"text":"天地都要像衣服渐渐旧了；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你要将天地卷起来，像一件外衣，","poem":1},{"lineBreak":true},{"text":"天地就都改变了。","poem":1},{"lineBreak":true},{"text":"惟有你永不改变；","poem":1},{"lineBreak":true},{"text":"你的年数没有穷尽。","poem":1}]},{"type":"verse","number":13,"content":["所有的天使， 神从来对哪一个说：",{"text":"你坐在我的右边，","poem":1},{"lineBreak":true},{"text":"等我使你仇敌作你的脚凳？","poem":1}]},{"type":"verse","number":14,"content":["天使岂不都是服役的灵、奉差遣为那将要承受救恩的人效力吗？"]}],"footnotes":[{"noteId":0,"caller":"-","text":"或译： 神再使长子到世上来的时候","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/cmn_cu1/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}