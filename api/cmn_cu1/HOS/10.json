{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cu1","name":"何西阿书","commonName":"何西阿书","title":"何西阿书","order":28,"numberOfChapters":14,"sha256":"04647d3e8f44e649b6d73328cb40599132a398e7b6297ea6c2f76790eabfc589","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cu1/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"以色列是茂盛的葡萄树，结果繁多。","poem":1},{"lineBreak":true},{"text":"果子越多，就越增添祭坛；","poem":1},{"lineBreak":true},{"text":"地土越肥美，就越造美丽的柱像。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他们心怀二意，","poem":1},{"lineBreak":true},{"text":"现今要定为有罪。","poem":1},{"lineBreak":true},{"text":"耶和华必拆毁他们的祭坛，","poem":1},{"lineBreak":true},{"text":"毁坏他们的柱像。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"他们必说：我们没有王，","poem":1},{"lineBreak":true},{"text":"因为我们不敬畏耶和华。","poem":1},{"lineBreak":true},{"text":"王能为我们做什么呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们为立约说谎言，起假誓；","poem":1},{"lineBreak":true},{"text":"因此，灾罚如苦菜滋生在田间的犁沟中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"撒马利亚的居民必因伯·亚文的牛犊惊恐；","poem":1},{"lineBreak":true},{"text":"崇拜牛犊的民和喜爱牛犊的祭司","poem":1},{"lineBreak":true},{"text":"都必因荣耀离开它，为它悲哀。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"人必将牛犊带到亚述当作礼物，","poem":1},{"lineBreak":true},{"text":"献给耶雷布王。","poem":1},{"lineBreak":true},{"text":"以法莲必蒙羞；","poem":1},{"lineBreak":true},{"text":"以色列必因自己的计谋惭愧。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"至于撒马利亚，她的王必灭没，","poem":1},{"lineBreak":true},{"text":"如水面的沫子一样。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"伯·亚文的邱坛—","poem":1},{"lineBreak":true},{"text":"就是以色列取罪的地方必被毁灭；","poem":1},{"lineBreak":true},{"text":"荆棘和蒺藜必长在他们的祭坛上。","poem":1},{"lineBreak":true},{"text":"他们必对大山说：遮盖我们！","poem":1},{"lineBreak":true},{"text":"对小山说：倒在我们身上！","poem":1}]},{"type":"heading","content":["神审判以色列"]},{"type":"verse","number":9,"content":[{"text":"以色列啊，","poem":1},{"lineBreak":true},{"text":"你从基比亚的日子以来时常犯罪。","poem":1},{"lineBreak":true},{"text":"你们的先人曾站在那里，","poem":1},{"lineBreak":true},{"text":"现今住基比亚的人","poem":1},{"lineBreak":true},{"text":"以为攻击罪孽之辈的战事临不到自己。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我必随意惩罚他们。","poem":1},{"lineBreak":true},{"text":"他们为两样的罪所缠；","poem":1},{"lineBreak":true},{"text":"列邦的民必聚集攻击他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"以法莲是驯良的母牛犊，喜爱踹谷，","poem":1},{"lineBreak":true},{"text":"我却将轭加在它肥美的颈项上，","poem":1},{"lineBreak":true},{"text":"我要使以法莲拉套","poem":1},{"noteId":15},{"text":"。","poem":1},{"lineBreak":true},{"text":"犹大必耕田；","poem":1},{"lineBreak":true},{"text":"雅各必耙地。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你们要为自己栽种公义，","poem":1},{"lineBreak":true},{"text":"就能收割慈爱。","poem":1},{"lineBreak":true},{"text":"现今正是寻求耶和华的时候；","poem":1},{"lineBreak":true},{"text":"你们要开垦荒地，等他临到，","poem":1},{"lineBreak":true},{"text":"使公义如雨降在你们身上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"你们耕种的是奸恶，","poem":1},{"lineBreak":true},{"text":"收割的是罪孽，","poem":1},{"lineBreak":true},{"text":"吃的是谎话的果子。","poem":1},{"lineBreak":true},{"text":"因你倚靠自己的行为，","poem":1},{"lineBreak":true},{"text":"仰赖勇士众多，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"所以在这民中必有哄嚷之声，","poem":1},{"lineBreak":true},{"text":"你一切的保障必被拆毁，","poem":1},{"lineBreak":true},{"text":"就如沙勒幔在争战的日子拆毁伯·亚比勒，","poem":1},{"lineBreak":true},{"text":"将其中的母子一同摔死。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因他们的大恶，","poem":1},{"lineBreak":true},{"text":"伯特利必使你们遭遇如此。","poem":1},{"lineBreak":true},{"text":"到了黎明，以色列的王必全然灭绝。","poem":1}]}],"footnotes":[{"noteId":15,"caller":"-","text":"或译：被骑","reference":{"chapter":10,"verse":11}}]},"thisChapterLink":"/api/cmn_cu1/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}