{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cu1","name":"何西阿书","commonName":"何西阿书","title":"何西阿书","order":28,"numberOfChapters":14,"sha256":"04647d3e8f44e649b6d73328cb40599132a398e7b6297ea6c2f76790eabfc589","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cu1/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":11,"content":[{"type":"heading","content":["怜爱叛民"]},{"type":"verse","number":1,"content":[{"text":"以色列年幼的时候，我爱他，","poem":1},{"lineBreak":true},{"text":"就从埃及召出我的儿子来。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"先知越发招呼他们，","poem":1},{"lineBreak":true},{"text":"他们越发走开，","poem":1},{"lineBreak":true},{"text":"向诸巴力献祭，","poem":1},{"lineBreak":true},{"text":"给雕刻的偶像烧香。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我原教导以法莲行走，","poem":1},{"lineBreak":true},{"text":"用膀臂抱着他们，","poem":1},{"lineBreak":true},{"text":"他们却不知道是我医治他们。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我用慈绳","poem":1},{"noteId":16},{"text":"爱索牵引他们；","poem":1},{"lineBreak":true},{"text":"我待他们如人放松牛的两腮夹板，","poem":1},{"lineBreak":true},{"text":"把粮食放在他们面前。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"他们必不归回埃及地，","poem":1},{"lineBreak":true},{"text":"亚述人却要作他们的王，","poem":1},{"lineBreak":true},{"text":"因他们不肯归向我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"刀剑必临到他们的城邑，","poem":1},{"lineBreak":true},{"text":"毁坏门闩，把人吞灭，","poem":1},{"lineBreak":true},{"text":"都因他们随从自己的计谋。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的民偏要背道离开我；","poem":1},{"lineBreak":true},{"text":"众先知虽然招呼他们归向至上的主，","poem":1},{"lineBreak":true},{"text":"却无人尊崇主。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"以法莲哪，我怎能舍弃你？","poem":1},{"lineBreak":true},{"text":"以色列啊，我怎能弃绝你？","poem":1},{"lineBreak":true},{"text":"我怎能使你如押玛？","poem":1},{"lineBreak":true},{"text":"怎能使你如洗扁？","poem":1},{"lineBreak":true},{"text":"我回心转意，","poem":1},{"lineBreak":true},{"text":"我的怜爱大大发动。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我必不发猛烈的怒气，","poem":1},{"lineBreak":true},{"text":"也不再毁灭以法莲。","poem":1},{"lineBreak":true},{"text":"因我是 神，并非世人，","poem":1},{"lineBreak":true},{"text":"是你们中间的圣者；","poem":1},{"lineBreak":true},{"text":"我必不在怒中临到你们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和华必如狮子吼叫，","poem":1},{"lineBreak":true},{"text":"子民必跟随他。","poem":1},{"lineBreak":true},{"text":"他一吼叫，","poem":1},{"lineBreak":true},{"text":"他们就从西方急速而来。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们必如雀鸟从埃及急速而来，","poem":1},{"lineBreak":true},{"text":"又如鸽子从亚述地来到。","poem":1},{"lineBreak":true},{"text":"我必使他们住自己的房屋。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"heading","content":["以色列和犹大受谴责"]},{"type":"verse","number":12,"content":[{"text":"以法莲用谎话，","poem":1},{"lineBreak":true},{"text":"以色列家用诡计围绕我；","poem":1},{"lineBreak":true},{"text":"犹大却靠 神掌权，","poem":1},{"lineBreak":true},{"text":"向圣者有忠心","poem":1},{"noteId":17},{"text":"。","poem":1}]}],"footnotes":[{"noteId":16,"caller":"-","text":"慈：原文是人的","reference":{"chapter":11,"verse":4}},{"noteId":17,"caller":"-","text":"或译：犹大向 神，向诚实的圣者犹疑不定","reference":{"chapter":11,"verse":12}}]},"thisChapterLink":"/api/cmn_cu1/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}