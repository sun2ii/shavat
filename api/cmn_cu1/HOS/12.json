{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cu1","name":"何西阿书","commonName":"何西阿书","title":"何西阿书","order":28,"numberOfChapters":14,"sha256":"04647d3e8f44e649b6d73328cb40599132a398e7b6297ea6c2f76790eabfc589","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cu1/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"以法莲吃风，且追赶东风，","poem":1},{"lineBreak":true},{"text":"时常增添虚谎和强暴，","poem":1},{"lineBreak":true},{"text":"与亚述立约，把油送到埃及。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"耶和华与犹大争辩，","poem":1},{"lineBreak":true},{"text":"必照雅各所行的惩罚他，","poem":1},{"lineBreak":true},{"text":"按他所做的报应他。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他在腹中抓住哥哥的脚跟，","poem":1},{"lineBreak":true},{"text":"壮年的时候与 神较力，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"与天使较力，并且得胜，","poem":1},{"lineBreak":true},{"text":"哭泣恳求，","poem":1},{"lineBreak":true},{"text":"在伯特利遇见耶和华。","poem":1},{"lineBreak":true},{"text":"耶和华—万军之 神在那里晓谕我们以色列人；","poem":1},{"lineBreak":true},{"text":"耶和华是他可记念的名。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"所以你当归向你的 神，","poem":1},{"lineBreak":true},{"text":"谨守仁爱、公平，常常等候你的 神。","poem":1}]},{"type":"heading","content":["其他的判词"]},{"type":"verse","number":7,"content":[{"text":"以法莲是商人，","poem":1},{"lineBreak":true},{"text":"手里有诡诈的天平，爱行欺骗。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"以法莲说：","poem":1},{"lineBreak":true},{"text":"我果然成了富足，得了财宝；","poem":1},{"lineBreak":true},{"text":"我所劳碌得来的，","poem":1},{"lineBreak":true},{"text":"人必不见有什么不义，可算为罪的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"自从你出埃及地以来，","poem":1},{"lineBreak":true},{"text":"我就是耶和华—你的 神；","poem":1},{"lineBreak":true},{"text":"我必使你再住帐棚，如在大会的日子一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"我已晓谕众先知，","poem":1},{"lineBreak":true},{"text":"并且加增默示，","poem":1},{"lineBreak":true},{"text":"借先知设立比喻。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"基列人没有罪孽吗？","poem":1},{"lineBreak":true},{"text":"他们全然是虚假的。","poem":1},{"lineBreak":true},{"text":"人在吉甲献牛犊为祭，","poem":1},{"lineBreak":true},{"text":"他们的祭坛好像田间犁沟中的乱堆。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"从前雅各逃到亚兰地，","poem":1},{"lineBreak":true},{"text":"以色列为得妻服事人，","poem":1},{"lineBreak":true},{"text":"为得妻与人放羊。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华借先知领以色列从埃及上来；","poem":1},{"lineBreak":true},{"text":"以色列也借先知而得保存。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"以法莲大大惹动主怒，","poem":1},{"lineBreak":true},{"text":"所以他流血的罪必归在他身上。","poem":1},{"lineBreak":true},{"text":"主必将那因以法莲所受的羞辱归还他。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":13}