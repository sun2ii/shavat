{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cu1","name":"何西阿书","commonName":"何西阿书","title":"何西阿书","order":28,"numberOfChapters":14,"sha256":"04647d3e8f44e649b6d73328cb40599132a398e7b6297ea6c2f76790eabfc589","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cu1/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":13,"content":[{"type":"heading","content":["以色列最后的审判"]},{"type":"verse","number":1,"content":[{"text":"从前以法莲说话，人都战兢，","poem":1},{"lineBreak":true},{"text":"他在以色列中居处高位；","poem":1},{"lineBreak":true},{"text":"但他在事奉巴力的事上犯罪就死了。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"现今他们罪上加罪，","poem":1},{"lineBreak":true},{"text":"用银子为自己铸造偶像，","poem":1},{"lineBreak":true},{"text":"就是照自己的聪明制造，","poem":1},{"lineBreak":true},{"text":"都是匠人的工作。","poem":1},{"lineBreak":true},{"text":"有人论说，","poem":1},{"lineBreak":true},{"text":"献祭的人可以向牛犊亲嘴。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因此，他们必如早晨的云雾，","poem":1},{"lineBreak":true},{"text":"又如速散的甘露，","poem":1},{"lineBreak":true},{"text":"像场上的糠秕被狂风吹去，","poem":1},{"lineBreak":true},{"text":"又像烟气腾于窗外。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"自从你出埃及地以来，","poem":1},{"lineBreak":true},{"text":"我就是耶和华—你的 神。","poem":1},{"lineBreak":true},{"text":"在我以外，你不可认识别神；","poem":1},{"lineBreak":true},{"text":"除我以外并没有救主。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我曾在旷野干旱之地认识你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"这些民照我所赐的食物得了饱足；","poem":1},{"lineBreak":true},{"text":"既得饱足，心就高傲，","poem":1},{"lineBreak":true},{"text":"忘记了我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因此，我向他们如狮子，","poem":1},{"lineBreak":true},{"text":"又如豹伏在道旁。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我遇见他们必像丢崽子的母熊，","poem":1},{"lineBreak":true},{"text":"撕裂他们的胸膛","poem":1},{"noteId":18},{"text":"。","poem":1},{"lineBreak":true},{"text":"在那里，我必像母狮吞吃他们；","poem":1},{"lineBreak":true},{"text":"野兽必撕裂他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"以色列啊，你与我反对，","poem":1},{"lineBreak":true},{"text":"就是反对帮助你的，自取败坏。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你曾求我说：","poem":1},{"lineBreak":true},{"text":"给我立王和首领。","poem":1},{"lineBreak":true},{"text":"现在你的王在哪里呢？","poem":1},{"lineBreak":true},{"text":"治理你的在哪里呢？","poem":1},{"lineBreak":true},{"text":"让他在你所有的城中拯救你吧！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我在怒气中将王赐你，","poem":1},{"lineBreak":true},{"text":"又在烈怒中将王废去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"以法莲的罪孽包裹；","poem":1},{"lineBreak":true},{"text":"他的罪恶收藏。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"产妇的疼痛必临到他身上；","poem":1},{"lineBreak":true},{"text":"他是无智慧之子，","poem":1},{"lineBreak":true},{"text":"到了产期不当迟延。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我必救赎他们脱离阴间，","poem":1},{"lineBreak":true},{"text":"救赎他们脱离死亡。","poem":1},{"lineBreak":true},{"text":"死亡啊，你的灾害在哪里呢？","poem":1},{"lineBreak":true},{"text":"阴间哪，你的毁灭在哪里呢？","poem":1},{"lineBreak":true},{"text":"在我眼前绝无后悔之事。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他在弟兄中虽然茂盛，","poem":1},{"lineBreak":true},{"text":"必有东风刮来，","poem":1},{"lineBreak":true},{"text":"就是耶和华的风从旷野上来。","poem":1},{"lineBreak":true},{"text":"他的泉源必干；","poem":1},{"lineBreak":true},{"text":"他的源头必竭；","poem":1},{"lineBreak":true},{"text":"仇敌必掳掠他所积蓄的一切宝器。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"撒马利亚必担当自己的罪，","poem":1},{"lineBreak":true},{"text":"因为悖逆她的 神。","poem":1},{"lineBreak":true},{"text":"她必倒在刀下；","poem":1},{"lineBreak":true},{"text":"婴孩必被摔死；","poem":1},{"lineBreak":true},{"text":"孕妇必被剖开。","poem":1}]}],"footnotes":[{"noteId":18,"caller":"-","text":"或译：心膜","reference":{"chapter":13,"verse":8}}]},"thisChapterLink":"/api/cmn_cu1/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}