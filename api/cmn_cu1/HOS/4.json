{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cu1","name":"何西阿书","commonName":"何西阿书","title":"何西阿书","order":28,"numberOfChapters":14,"sha256":"04647d3e8f44e649b6d73328cb40599132a398e7b6297ea6c2f76790eabfc589","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cu1/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":4,"content":[{"type":"heading","content":["耶和华谴责以色列"]},{"type":"verse","number":1,"content":[{"text":"以色列人哪，你们当听耶和华的话。","poem":1},{"lineBreak":true},{"text":"耶和华与这地的居民争辩，","poem":1},{"lineBreak":true},{"text":"因这地上无诚实，","poem":1},{"lineBreak":true},{"text":"无良善，无人认识 神。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"但起假誓，不践前言，","poem":1},{"lineBreak":true},{"text":"杀害，偷盗，奸淫，行强暴，","poem":1},{"lineBreak":true},{"text":"杀人流血，接连不断。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因此，这地悲哀，","poem":1},{"lineBreak":true},{"text":"其上的民、田野的兽、","poem":1},{"lineBreak":true},{"text":"空中的鸟必都衰微，","poem":1},{"lineBreak":true},{"text":"海中的鱼也必消灭。","poem":1}]},{"type":"heading","content":["谴责祭司"]},{"type":"verse","number":4,"content":[{"text":"然而，人都不必争辩，也不必指责，","poem":1},{"lineBreak":true},{"text":"因为这民与抗拒祭司的人一样。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你这祭司必日间跌倒；","poem":1},{"lineBreak":true},{"text":"先知也必夜间与你一同跌倒；","poem":1},{"lineBreak":true},{"text":"我必灭绝你的母亲。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的民因无知识而灭亡。","poem":1},{"lineBreak":true},{"text":"你弃掉知识，","poem":1},{"lineBreak":true},{"text":"我也必弃掉你，","poem":1},{"lineBreak":true},{"text":"使你不再给我作祭司。","poem":1},{"lineBreak":true},{"text":"你既忘了你 神的律法，","poem":1},{"lineBreak":true},{"text":"我也必忘记你的儿女。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"祭司越发增多，就越发得罪我；","poem":1},{"lineBreak":true},{"text":"我必使他们的荣耀变为羞辱。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们吃我民的赎罪祭，","poem":1},{"lineBreak":true},{"text":"满心愿意我民犯罪。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"将来民如何，","poem":1},{"lineBreak":true},{"text":"祭司也必如何；","poem":1},{"lineBreak":true},{"text":"我必因他们所行的惩罚他们，","poem":1},{"lineBreak":true},{"text":"照他们所做的报应他们。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们吃，却不得饱；","poem":1},{"lineBreak":true},{"text":"行淫，而不得立后；","poem":1},{"lineBreak":true},{"text":"因为他们离弃耶和华，","poem":1},{"lineBreak":true},{"text":"不遵他的命。","poem":1}]},{"type":"heading","content":["谴责拜偶像的罪"]},{"type":"verse","number":11,"content":[{"text":"奸淫和酒，并新酒，","poem":1},{"lineBreak":true},{"text":"夺去人的心。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我的民求问木偶，","poem":1},{"lineBreak":true},{"text":"以为木杖能指示他们；","poem":1},{"lineBreak":true},{"text":"因为他们的淫心使他们失迷，","poem":1},{"lineBreak":true},{"text":"他们就行淫离弃 神，","poem":1},{"lineBreak":true},{"text":"不守约束，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"在各山顶，各高冈的橡树、","poem":1},{"lineBreak":true},{"text":"杨树、栗树之下，献祭烧香，","poem":1},{"lineBreak":true},{"text":"因为树影美好。","poem":1},{"lineBreak":true},{"text":"所以，你们的女儿淫乱，","poem":1},{"lineBreak":true},{"text":"你们的新妇","poem":1},{"noteId":11},{"text":"行淫。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你们的女儿淫乱，","poem":1},{"lineBreak":true},{"text":"你们的新妇行淫，","poem":1},{"lineBreak":true},{"text":"我却不惩罚她们；","poem":1},{"lineBreak":true},{"text":"因为你们自己离群与娼妓同居，","poem":1},{"lineBreak":true},{"text":"与妓女一同献祭。","poem":1},{"lineBreak":true},{"text":"这无知的民必致倾倒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"以色列啊，你虽然行淫，","poem":1},{"lineBreak":true},{"text":"犹大却不可犯罪。","poem":1},{"lineBreak":true},{"text":"不要往吉甲去，","poem":1},{"lineBreak":true},{"text":"不要上到伯·亚文，","poem":1},{"lineBreak":true},{"text":"也不要指着永生的耶和华起誓。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"以色列倔强，","poem":1},{"lineBreak":true},{"text":"犹如倔强的母牛；","poem":1},{"lineBreak":true},{"text":"现在耶和华要放他们，","poem":1},{"lineBreak":true},{"text":"如同放羊羔在宽阔之地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"以法莲亲近偶像，","poem":1},{"lineBreak":true},{"text":"任凭他吧！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们所喝的已经发酸，","poem":1},{"lineBreak":true},{"text":"他们时常行淫，","poem":1},{"lineBreak":true},{"text":"他们的官长最爱羞耻的事。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"风把他们裹在翅膀里；","poem":1},{"lineBreak":true},{"text":"他们因所献的祭必致蒙羞。","poem":1}]}],"footnotes":[{"noteId":11,"caller":"-","text":"或译：儿妇；下同","reference":{"chapter":4,"verse":13}}]},"thisChapterLink":"/api/cmn_cu1/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}