{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cu1","name":"何西阿书","commonName":"何西阿书","title":"何西阿书","order":28,"numberOfChapters":14,"sha256":"04647d3e8f44e649b6d73328cb40599132a398e7b6297ea6c2f76790eabfc589","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cu1/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":6,"content":[{"type":"heading","content":["以色列无悔改诚意"]},{"type":"verse","number":1,"content":[{"text":"来吧，我们归向耶和华！","poem":1},{"lineBreak":true},{"text":"他撕裂我们，也必医治；","poem":1},{"lineBreak":true},{"text":"他打伤我们，也必缠裹。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"过两天他必使我们苏醒，","poem":1},{"lineBreak":true},{"text":"第三天他必使我们兴起，","poem":1},{"lineBreak":true},{"text":"我们就在他面前得以存活。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我们务要认识耶和华，","poem":1},{"lineBreak":true},{"text":"竭力追求认识他。","poem":1},{"lineBreak":true},{"text":"他出现确如晨光；","poem":1},{"lineBreak":true},{"text":"他必临到我们像甘雨，","poem":1},{"lineBreak":true},{"text":"像滋润田地的春雨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"主说：以法莲哪，我可向你怎样行呢？","poem":1},{"lineBreak":true},{"text":"犹大啊，我可向你怎样做呢？","poem":1},{"lineBreak":true},{"text":"因为你们的良善如同早晨的云雾，","poem":1},{"lineBreak":true},{"text":"又如速散的甘露。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因此，我借先知砍伐他们，","poem":1},{"lineBreak":true},{"text":"以我口中的话杀戮他们；","poem":1},{"lineBreak":true},{"text":"我施行的审判如光发出。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我喜爱良善","poem":1},{"noteId":13},{"text":"，不喜爱祭祀；","poem":1},{"lineBreak":true},{"text":"喜爱认识 神，胜于燔祭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"他们却如亚当背约，","poem":1},{"lineBreak":true},{"text":"在境内向我行事诡诈。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"基列是作孽之人的城，","poem":1},{"lineBreak":true},{"text":"被血沾染。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"强盗成群，怎样埋伏杀人，","poem":1},{"lineBreak":true},{"text":"祭司结党，也照样在示剑的路上杀戮，","poem":1},{"lineBreak":true},{"text":"行了邪恶。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"在以色列家，我见了可憎的事；","poem":1},{"lineBreak":true},{"text":"在以法莲那里有淫行，","poem":1},{"lineBreak":true},{"text":"以色列被玷污。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"犹大啊，我使被掳之民归回的时候，","poem":1},{"lineBreak":true},{"text":"必有为你所命定的收场。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"或译：怜恤","reference":{"chapter":6,"verse":6}}]},"thisChapterLink":"/api/cmn_cu1/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}