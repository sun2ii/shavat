{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cu1","name":"何西阿书","commonName":"何西阿书","title":"何西阿书","order":28,"numberOfChapters":14,"sha256":"04647d3e8f44e649b6d73328cb40599132a398e7b6297ea6c2f76790eabfc589","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cu1/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":8,"content":[{"type":"heading","content":["以色列人因拜偶像被定罪"]},{"type":"verse","number":1,"content":[{"text":"你用口吹角吧！","poem":1},{"lineBreak":true},{"text":"敌人如鹰来攻打耶和华的家；","poem":1},{"lineBreak":true},{"text":"因为这民违背我的约，","poem":1},{"lineBreak":true},{"text":"干犯我的律法。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他们必呼叫我说：","poem":1},{"lineBreak":true},{"text":"我的 神啊，我们以色列认识你了。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"以色列丢弃良善","poem":1},{"noteId":14},{"text":"；","poem":1},{"lineBreak":true},{"text":"仇敌必追逼他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他们立君王，却不由我；","poem":1},{"lineBreak":true},{"text":"他们立首领，我却不认。","poem":1},{"lineBreak":true},{"text":"他们用金银为自己制造偶像，","poem":1},{"lineBreak":true},{"text":"以致被剪除。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"撒马利亚啊，耶和华已经丢弃你的牛犊；","poem":1},{"lineBreak":true},{"text":"我的怒气向拜牛犊的人发作。","poem":1},{"lineBreak":true},{"text":"他们到几时方能无罪呢？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"这牛犊出于以色列，","poem":1},{"lineBreak":true},{"text":"是匠人所造的，并不是神。","poem":1},{"lineBreak":true},{"text":"撒马利亚的牛犊必被打碎。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们所种的是风，所收的是暴风；","poem":1},{"lineBreak":true},{"text":"所种的不成禾稼，就是发苗也不结实；","poem":1},{"lineBreak":true},{"text":"即便结实，外邦人必吞吃。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"以色列被吞吃；","poem":1},{"lineBreak":true},{"text":"现今在列国中，好像人不喜悦的器皿。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们投奔亚述，如同独行的野驴；","poem":1},{"lineBreak":true},{"text":"以法莲贿买朋党。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们虽在列邦中贿买人，","poem":1},{"lineBreak":true},{"text":"现在我却要聚集惩罚他们；","poem":1},{"lineBreak":true},{"text":"他们因君王和首领所加的重担日渐衰微。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"以法莲增添祭坛取罪；","poem":1},{"lineBreak":true},{"text":"因此，祭坛使他犯罪。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我为他写了律法万条，","poem":1},{"lineBreak":true},{"text":"他却以为与他毫无关涉。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"至于献给我的祭物，","poem":1},{"lineBreak":true},{"text":"他们自食其肉，","poem":1},{"lineBreak":true},{"text":"耶和华却不悦纳他们。","poem":1},{"lineBreak":true},{"text":"现在必记念他们的罪孽，","poem":1},{"lineBreak":true},{"text":"追讨他们的罪恶；","poem":1},{"lineBreak":true},{"text":"他们必归回埃及。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"以色列忘记造他的主，建造宫殿；","poem":1},{"lineBreak":true},{"text":"犹大多造坚固城，","poem":1},{"lineBreak":true},{"text":"我却要降火焚烧他的城邑，","poem":1},{"lineBreak":true},{"text":"烧灭其中的宫殿。","poem":1}]}],"footnotes":[{"noteId":14,"caller":"-","text":"或译：福分","reference":{"chapter":8,"verse":3}}]},"thisChapterLink":"/api/cmn_cu1/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}