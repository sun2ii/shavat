{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":11,"content":[{"type":"heading","content":["和平的国度"]},{"type":"verse","number":1,"content":[{"text":"从耶西的本","poem":1},{"noteId":11},{"text":"必发一条；","poem":1},{"lineBreak":true},{"text":"从他根生的枝子必结果实。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华的灵必住在他身上，","poem":1},{"lineBreak":true},{"text":"就是使他有智慧和聪明的灵，","poem":1},{"lineBreak":true},{"text":"谋略和能力的灵，","poem":1},{"lineBreak":true},{"text":"知识和敬畏耶和华的灵。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他必以敬畏耶和华为乐；","poem":1},{"lineBreak":true},{"text":"行审判不凭眼见，","poem":1},{"lineBreak":true},{"text":"断是非也不凭耳闻；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"却要以公义审判贫穷人，","poem":1},{"lineBreak":true},{"text":"以正直判断世上的谦卑人，","poem":1},{"lineBreak":true},{"text":"以口中的杖击打世界，","poem":1},{"lineBreak":true},{"text":"以嘴里的气杀戮恶人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"公义必当他的腰带；","poem":1},{"lineBreak":true},{"text":"信实必当他胁下的带子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"豺狼必与绵羊羔同居，","poem":1},{"lineBreak":true},{"text":"豹子与山羊羔同卧；","poem":1},{"lineBreak":true},{"text":"少壮狮子与牛犊并肥畜同群；","poem":1},{"lineBreak":true},{"text":"小孩子要牵引它们。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"牛必与熊同食；","poem":1},{"lineBreak":true},{"text":"牛犊必与小熊同卧；","poem":1},{"lineBreak":true},{"text":"狮子必吃草，与牛一样。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"吃奶的孩子必玩耍在虺蛇的洞口；","poem":1},{"lineBreak":true},{"text":"断奶的婴儿必按手在毒蛇的穴上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"在我圣山的遍处，","poem":1},{"lineBreak":true},{"text":"这一切都不伤人，不害物；","poem":1},{"lineBreak":true},{"text":"因为认识耶和华的知识要充满遍地，","poem":1},{"lineBreak":true},{"text":"好像水充满洋海一般。","poem":1}]},{"type":"heading","content":["流亡的人回乡"]},{"type":"verse","number":10,"content":["到那日，耶西的根立作万民的大旗；外邦人必寻求他，他安息之所大有荣耀。"]},{"type":"verse","number":11,"content":["当那日，主必二次伸手救回自己百姓中所余剩的，就是在亚述、埃及、巴忒罗、古实、以拦、示拿、哈马，并众海岛所剩下的。"]},{"type":"verse","number":12,"content":[{"text":"他必向列国竖立大旗，","poem":1},{"lineBreak":true},{"text":"招回以色列被赶散的人，","poem":1},{"lineBreak":true},{"text":"又从地的四方聚集分散的犹大人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"以法莲的嫉妒就必消散；","poem":1},{"lineBreak":true},{"text":"扰害犹大的必被剪除。","poem":1},{"lineBreak":true},{"text":"以法莲必不嫉妒犹大，","poem":1},{"lineBreak":true},{"text":"犹大也不扰害以法莲。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们要向西飞，","poem":1},{"lineBreak":true},{"text":"扑在非利士人的肩头上","poem":1},{"noteId":12},{"text":"，","poem":1},{"lineBreak":true},{"text":"一同掳掠东方人，","poem":1},{"lineBreak":true},{"text":"伸手按住以东和摩押；","poem":1},{"lineBreak":true},{"text":"亚扪人也必顺服他们。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和华必使埃及海汊枯干，","poem":1},{"lineBreak":true},{"text":"抡手用暴热的风使大河分为七条，","poem":1},{"lineBreak":true},{"text":"令人过去不致湿脚。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"为主余剩的百姓，","poem":1},{"lineBreak":true},{"text":"就是从亚述剩下回来的，","poem":1},{"lineBreak":true},{"text":"必有一条大道，","poem":1},{"lineBreak":true},{"text":"如当日以色列从埃及地上来一样。","poem":1}]}],"footnotes":[{"noteId":11,"caller":"-","text":"原文是ⶍ","reference":{"chapter":11,"verse":1}},{"noteId":12,"caller":"-","text":"肩头上：或译西界","reference":{"chapter":11,"verse":14}}]},"thisChapterLink":"/api/cmn_cu1/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}