{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":12,"content":[{"type":"heading","content":["感恩的诗歌"]},{"type":"verse","number":1,"content":["到那日，你必说：",{"text":"耶和华啊，我要称谢你！","poem":1},{"lineBreak":true},{"text":"因为你虽然向我发怒，","poem":1},{"lineBreak":true},{"text":"你的怒气却已转消；","poem":1},{"lineBreak":true},{"text":"你又安慰了我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"看哪！ 神是我的拯救；","poem":1},{"lineBreak":true},{"text":"我要倚靠他，并不惧怕。","poem":1},{"lineBreak":true},{"text":"因为主耶和华是我的力量，","poem":1},{"lineBreak":true},{"text":"是我的诗歌，","poem":1},{"lineBreak":true},{"text":"他也成了我的拯救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["所以，你们必从救恩的泉源欢然取水。"]},{"type":"verse","number":4,"content":["在那日，你们要说：",{"text":"当称谢耶和华，求告他的名；","poem":1},{"lineBreak":true},{"text":"将他所行的传扬在万民中，","poem":1},{"lineBreak":true},{"text":"提说他的名已被尊崇。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你们要向耶和华唱歌，","poem":1},{"lineBreak":true},{"text":"因他所行的甚是美好；","poem":1},{"lineBreak":true},{"text":"但愿这事普传天下。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"锡安的居民哪，当扬声欢呼，","poem":1},{"lineBreak":true},{"text":"因为在你们中间的以色列圣者乃为至大。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}