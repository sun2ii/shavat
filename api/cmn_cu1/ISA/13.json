{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":13,"content":[{"type":"heading","content":["神要惩罚巴比伦"]},{"type":"verse","number":1,"content":["亚摩斯的儿子以赛亚得默示，论巴比伦。"]},{"type":"verse","number":2,"content":[{"text":"应当在净光的山竖立大旗，","poem":1},{"lineBreak":true},{"text":"向群众扬声招手，","poem":1},{"lineBreak":true},{"text":"使他们进入贵胄的门。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我吩咐我所挑出来的人；","poem":1},{"lineBreak":true},{"text":"我招呼我的勇士—","poem":1},{"lineBreak":true},{"text":"就是那矜夸高傲之辈，","poem":1},{"lineBreak":true},{"text":"为要成就我怒中所定的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"山间有多人的声音，","poem":1},{"lineBreak":true},{"text":"好像是大国人民。","poem":1},{"lineBreak":true},{"text":"有许多国的民聚集哄嚷的声音；","poem":1},{"lineBreak":true},{"text":"这是万军之耶和华点齐军队，预备打仗。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们从远方来，","poem":1},{"lineBreak":true},{"text":"从天边来，","poem":1},{"lineBreak":true},{"text":"就是耶和华并他恼恨的兵器","poem":1},{"lineBreak":true},{"text":"要毁灭这全地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"你们要哀号，","poem":1},{"lineBreak":true},{"text":"因为耶和华的日子临近了！","poem":1},{"lineBreak":true},{"text":"这日来到，","poem":1},{"lineBreak":true},{"text":"好像毁灭从全能者来到。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"所以，人手都必软弱；","poem":1},{"lineBreak":true},{"text":"人心都必消化。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们必惊惶悲痛；","poem":1},{"lineBreak":true},{"text":"愁苦必将他们抓住。","poem":1},{"lineBreak":true},{"text":"他们疼痛，好像产难的妇人一样，","poem":1},{"lineBreak":true},{"text":"彼此惊奇相看，脸如火焰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和华的日子临到，","poem":1},{"lineBreak":true},{"text":"必有残忍、忿恨、烈怒，","poem":1},{"lineBreak":true},{"text":"使这地荒凉，","poem":1},{"lineBreak":true},{"text":"从其中除灭罪人。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"天上的众星群宿都不发光；","poem":1},{"lineBreak":true},{"text":"日头一出就变黑暗；","poem":1},{"lineBreak":true},{"text":"月亮也不放光。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我必因邪恶刑罚世界，","poem":1},{"lineBreak":true},{"text":"因罪孽刑罚恶人，","poem":1},{"lineBreak":true},{"text":"使骄傲人的狂妄止息，","poem":1},{"lineBreak":true},{"text":"制伏强暴人的狂傲。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我必使人比精金还少，","poem":1},{"lineBreak":true},{"text":"使人比俄斐纯金更少。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我—万军之耶和华在忿恨中发烈怒的日子，","poem":1},{"lineBreak":true},{"text":"必使天震动，","poem":1},{"lineBreak":true},{"text":"使地摇撼，离其本位。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人必像被追赶的鹿，","poem":1},{"lineBreak":true},{"text":"像无人收聚的羊，","poem":1},{"lineBreak":true},{"text":"各归回本族，","poem":1},{"lineBreak":true},{"text":"各逃到本土。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"凡被仇敌追上的必被刺死；","poem":1},{"lineBreak":true},{"text":"凡被捉住的必被刀杀。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他们的婴孩必在他们眼前摔碎；","poem":1},{"lineBreak":true},{"text":"他们的房屋必被抢夺；","poem":1},{"lineBreak":true},{"text":"他们的妻子必被玷污。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"我必激动米底亚人来攻击他们。","poem":1},{"lineBreak":true},{"text":"米底亚人不注重银子，","poem":1},{"lineBreak":true},{"text":"也不喜爱金子。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们必用弓击碎少年人，","poem":1},{"lineBreak":true},{"text":"不怜悯妇人所生的，","poem":1},{"lineBreak":true},{"text":"眼也不顾惜孩子。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"巴比伦素来为列国的荣耀，","poem":1},{"lineBreak":true},{"text":"为迦勒底人所矜夸的华美，","poem":1},{"lineBreak":true},{"text":"必像 神所倾覆的所多玛、蛾摩拉一样。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"其内必永无人烟，","poem":1},{"lineBreak":true},{"text":"世世代代无人居住。","poem":1},{"lineBreak":true},{"text":"阿拉伯人也不在那里支搭帐棚；","poem":1},{"lineBreak":true},{"text":"牧羊的人也不使羊群卧在那里。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"只有旷野的走兽卧在那里；","poem":1},{"lineBreak":true},{"text":"咆哮的兽满了房屋。","poem":1},{"lineBreak":true},{"text":"鸵鸟住在那里；","poem":1},{"lineBreak":true},{"text":"野山羊在那里跳舞。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"豺狼必在它宫中呼号；","poem":1},{"lineBreak":true},{"text":"野狗必在它华美殿内吼叫。","poem":1},{"lineBreak":true},{"text":"巴比伦受罚的时候临近；","poem":1},{"lineBreak":true},{"text":"它的日子必不长久。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}