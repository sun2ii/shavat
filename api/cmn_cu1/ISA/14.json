{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":14,"content":[{"type":"heading","content":["从流亡中归回"]},{"type":"verse","number":1,"content":["耶和华要怜恤雅各，必再拣选以色列，将他们安置在本地。寄居的必与他们联合，紧贴雅各家。"]},{"type":"verse","number":2,"content":["外邦人必将他们带回本土；以色列家必在耶和华的地上得外邦人为仆婢，也要掳掠先前掳掠他们的，辖制先前欺压他们的。"]},{"type":"heading","content":["巴比伦王下到阴间"]},{"type":"verse","number":3,"content":["当耶和华使你脱离愁苦、烦恼，并人勉强你做的苦工，得享安息的日子，"]},{"type":"verse","number":4,"content":["你必题这诗歌论巴比伦王说：",{"text":"欺压人的何竟息灭？","poem":1},{"lineBreak":true},{"text":"强暴的何竟止息？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华折断了恶人的杖，","poem":1},{"lineBreak":true},{"text":"辖制人的圭，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"就是在忿怒中连连攻击众民的，","poem":1},{"lineBreak":true},{"text":"在怒气中辖制列国，","poem":1},{"lineBreak":true},{"text":"行逼迫无人阻止的。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"现在全地得安息，享平静；","poem":1},{"lineBreak":true},{"text":"人皆发声欢呼。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"松树和黎巴嫩的香柏树","poem":1},{"lineBreak":true},{"text":"都因你欢乐，说：","poem":1},{"lineBreak":true},{"text":"自从你仆倒，","poem":1},{"lineBreak":true},{"text":"再无人上来砍伐我们。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你下到阴间，","poem":1},{"lineBreak":true},{"text":"阴间就因你震动来迎接你，","poem":1},{"lineBreak":true},{"text":"又因你惊动在世曾为首领的阴魂，","poem":1},{"lineBreak":true},{"text":"并使那曾为列国君王的，","poem":1},{"lineBreak":true},{"text":"都离位站起。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们都要发言对你说：","poem":1},{"lineBreak":true},{"text":"你也变为软弱像我们一样吗？","poem":1},{"lineBreak":true},{"text":"你也成了我们的样子吗？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你的威势和你琴瑟的声音都下到阴间。","poem":1},{"lineBreak":true},{"text":"你下铺的是虫，上盖的是蛆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"明亮之星，早晨之子啊，","poem":1},{"lineBreak":true},{"text":"你何竟从天坠落？","poem":1},{"lineBreak":true},{"text":"你这攻败列国的何竟被砍倒在地上？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你心里曾说：","poem":1},{"lineBreak":true},{"text":"我要升到天上；","poem":1},{"lineBreak":true},{"text":"我要高举我的宝座在 神众星以上；","poem":1},{"lineBreak":true},{"text":"我要坐在聚会的山上，在北方的极处。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我要升到高云之上；","poem":1},{"lineBreak":true},{"text":"我要与至上者同等。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"然而，你必坠落阴间，","poem":1},{"lineBreak":true},{"text":"到坑中极深之处。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"凡看见你的都要定睛看你，","poem":1},{"lineBreak":true},{"text":"留意看你，说：","poem":1},{"lineBreak":true},{"text":"使大地战抖，","poem":1},{"lineBreak":true},{"text":"使列国震动，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"使世界如同荒野，","poem":1},{"lineBreak":true},{"text":"使城邑倾覆，","poem":1},{"lineBreak":true},{"text":"不释放被掳的人归家，","poem":1},{"lineBreak":true},{"text":"是这个人吗？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"列国的君王","poem":1},{"lineBreak":true},{"text":"俱各在自己阴宅的荣耀中安睡。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"惟独你被抛弃，","poem":1},{"lineBreak":true},{"text":"不得入你的坟墓，","poem":1},{"lineBreak":true},{"text":"好像可憎的枝子，","poem":1},{"lineBreak":true},{"text":"以被杀的人为衣，","poem":1},{"lineBreak":true},{"text":"就是被刀刺透，","poem":1},{"lineBreak":true},{"text":"坠落坑中石头那里的；","poem":1},{"lineBreak":true},{"text":"你又像被践踏的尸首一样。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你不得与君王同葬；","poem":1},{"lineBreak":true},{"text":"因为你败坏你的国，杀戮你的民。","poem":1},{"lineBreak":true},{"text":"恶人后裔的名，必永不提说。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"先人既有罪孽，","poem":1},{"lineBreak":true},{"text":"就要预备杀戮他的子孙，","poem":1},{"lineBreak":true},{"text":"免得他们兴起来，得了遍地，","poem":1},{"lineBreak":true},{"text":"在世上修满城邑。","poem":1}]},{"type":"heading","content":["神要毁灭巴比伦"]},{"type":"verse","number":22,"content":[{"text":"万军之耶和华说：","poem":1},{"lineBreak":true},{"text":"我必兴起攻击他们，","poem":1},{"lineBreak":true},{"text":"将巴比伦的名号和所余剩的人，","poem":1},{"lineBreak":true},{"text":"连子带孙一并剪除。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我必使巴比伦为箭猪所得，","poem":1},{"lineBreak":true},{"text":"又变为水池；","poem":1},{"lineBreak":true},{"text":"我要用灭亡的扫帚扫净它。","poem":1},{"lineBreak":true},{"text":"这是万军之耶和华说的。","poem":1}]},{"type":"heading","content":["神要毁灭亚述"]},{"type":"verse","number":24,"content":[{"text":"万军之耶和华起誓说：","poem":1},{"lineBreak":true},{"text":"我怎样思想，必照样成就；","poem":1},{"lineBreak":true},{"text":"我怎样定意，必照样成立，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"就是在我地上打折亚述人，","poem":1},{"lineBreak":true},{"text":"在我山上将他践踏。","poem":1},{"lineBreak":true},{"text":"他加的轭必离开以色列人；","poem":1},{"lineBreak":true},{"text":"他加的重担必离开他们的肩头。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"这是向全地所定的旨意；","poem":1},{"lineBreak":true},{"text":"这是向万国所伸出的手。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"万军之耶和华既然定意，谁能废弃呢？","poem":1},{"lineBreak":true},{"text":"他的手已经伸出，谁能转回呢？","poem":1}]},{"type":"heading","content":["神要毁灭非利士"]},{"type":"verse","number":28,"content":[{"text":"亚哈斯王崩的那年，就有以下的默示：","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"非利士全地啊，","poem":1},{"lineBreak":true},{"text":"不要因击打你的杖折断就喜乐。","poem":1},{"lineBreak":true},{"text":"因为从蛇的根必生出毒蛇；","poem":1},{"lineBreak":true},{"text":"它所生的是火焰的飞龙。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"贫寒人的长子必有所食；","poem":1},{"lineBreak":true},{"text":"穷乏人必安然躺卧。","poem":1},{"lineBreak":true},{"text":"我必以饥荒治死你的根；","poem":1},{"lineBreak":true},{"text":"你所余剩的人必被杀戮。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"门哪，应当哀号！","poem":1},{"lineBreak":true},{"text":"城啊，应当呼喊！","poem":1},{"lineBreak":true},{"text":"非利士全地啊，你都消化了！","poem":1},{"lineBreak":true},{"text":"因为有烟从北方出来，","poem":1},{"lineBreak":true},{"text":"他行伍中并无乱队的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"可怎样回答外邦","poem":1},{"noteId":13},{"text":"的使者呢？","poem":1},{"lineBreak":true},{"text":"必说：耶和华建立了锡安；","poem":1},{"lineBreak":true},{"text":"他百姓中的困苦人必投奔在其中。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"或指非利士","reference":{"chapter":14,"verse":32}}]},"thisChapterLink":"/api/cmn_cu1/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}