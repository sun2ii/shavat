{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":15,"content":[{"type":"heading","content":["神要毁灭摩押"]},{"type":"verse","number":1,"content":["论摩押的默示：",{"text":"一夜之间，摩押的亚珥变为荒废，","poem":1},{"lineBreak":true},{"text":"归于无有；","poem":1},{"lineBreak":true},{"text":"一夜之间，摩押的基珥变为荒废，","poem":1},{"lineBreak":true},{"text":"归于无有。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他们上巴益，又往底本，","poem":1},{"lineBreak":true},{"text":"到高处去哭泣。","poem":1},{"lineBreak":true},{"text":"摩押人因尼波和米底巴哀号，","poem":1},{"lineBreak":true},{"text":"各人头上光秃，","poem":1},{"lineBreak":true},{"text":"胡须剃净。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们在街市上都腰束麻布，","poem":1},{"lineBreak":true},{"text":"在房顶上和宽阔处俱各哀号，","poem":1},{"lineBreak":true},{"text":"眼泪汪汪。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"希实本和以利亚利悲哀的声音达到雅杂，","poem":1},{"lineBreak":true},{"text":"所以摩押带兵器的高声喊嚷，","poem":1},{"lineBreak":true},{"text":"人心战兢。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我心为摩押悲哀；","poem":1},{"lineBreak":true},{"text":"他的贵胄","poem":1},{"noteId":14},{"text":"逃到琐珥，","poem":1},{"lineBreak":true},{"text":"到伊基拉·施利施亚。","poem":1},{"lineBreak":true},{"text":"他们上鲁希坡，随走随哭；","poem":1},{"lineBreak":true},{"text":"在何罗念的路上，因毁灭举起哀声。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因为宁林的水成为干涸，","poem":1},{"lineBreak":true},{"text":"青草枯干，嫩草灭没，","poem":1},{"lineBreak":true},{"text":"青绿之物，一无所有。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因此，摩押人所得的财物","poem":1},{"lineBreak":true},{"text":"和所积蓄的都要运过柳树河。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"哀声遍闻摩押的四境；","poem":1},{"lineBreak":true},{"text":"哀号的声音达到以基莲；","poem":1},{"lineBreak":true},{"text":"哀号的声音达到比珥·以琳。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"底们的水充满了血；","poem":1},{"lineBreak":true},{"text":"我还要加增底们的灾难，","poem":1},{"lineBreak":true},{"text":"叫狮子来追上摩押逃脱的民","poem":1},{"lineBreak":true},{"text":"和那地上所余剩的人。","poem":1}]}],"footnotes":[{"noteId":14,"caller":"-","text":"或译：逃民","reference":{"chapter":15,"verse":5}}]},"thisChapterLink":"/api/cmn_cu1/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}