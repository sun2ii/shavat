{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":19,"content":[{"type":"heading","content":["神要惩罚埃及"]},{"type":"verse","number":1,"content":["论埃及的默示：",{"text":"看哪，耶和华乘驾快云，","poem":1},{"lineBreak":true},{"text":"临到埃及。","poem":1},{"lineBreak":true},{"text":"埃及的偶像在他面前战兢；","poem":1},{"lineBreak":true},{"text":"埃及人的心在里面消化。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我必激动埃及人攻击埃及人—","poem":1},{"lineBreak":true},{"text":"弟兄攻击弟兄，","poem":1},{"lineBreak":true},{"text":"邻舍攻击邻舍；","poem":1},{"lineBreak":true},{"text":"这城攻击那城，","poem":1},{"lineBreak":true},{"text":"这国攻击那国。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"埃及人的心神必在里面耗尽；","poem":1},{"lineBreak":true},{"text":"我必败坏他们的谋略。","poem":1},{"lineBreak":true},{"text":"他们必求问偶像和念咒的、","poem":1},{"lineBreak":true},{"text":"交鬼的、行巫术的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我必将埃及人交在残忍主的手中；","poem":1},{"lineBreak":true},{"text":"强暴王必辖制他们。","poem":1},{"lineBreak":true},{"text":"这是主—万军之耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"海中的水必绝尽，","poem":1},{"lineBreak":true},{"text":"河也消没干涸。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"江河要变臭；","poem":1},{"lineBreak":true},{"text":"埃及的河水都必减少枯干。","poem":1},{"lineBreak":true},{"text":"苇子和芦荻都必衰残；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"靠尼罗河旁的草田，","poem":1},{"lineBreak":true},{"text":"并沿尼罗河所种的田，都必枯干。","poem":1},{"lineBreak":true},{"text":"庄稼被风吹去，归于无有。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"打鱼的必哀哭。","poem":1},{"lineBreak":true},{"text":"在尼罗河一切钓鱼的必悲伤；","poem":1},{"lineBreak":true},{"text":"在水上撒网的必都衰弱。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"用梳好的麻造物的","poem":1},{"lineBreak":true},{"text":"和织白布的都必羞愧；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"国柱必被打碎，","poem":1},{"lineBreak":true},{"text":"所有佣工的，心必愁烦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"琐安的首领极其愚昧；","poem":1},{"lineBreak":true},{"text":"法老大有智慧的谋士，","poem":1},{"lineBreak":true},{"text":"所筹划的成为愚谋。","poem":1},{"lineBreak":true},{"text":"你们怎敢对法老说：","poem":1},{"lineBreak":true},{"text":"我是智慧人的子孙，","poem":1},{"lineBreak":true},{"text":"我是古王的后裔？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你的智慧人在哪里呢？","poem":1},{"lineBreak":true},{"text":"万军之耶和华向埃及所定的旨意，","poem":1},{"lineBreak":true},{"text":"他们可以知道，可以告诉你吧！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"琐安的首领都变为愚昧；","poem":1},{"lineBreak":true},{"text":"挪弗的首领都受了迷惑。","poem":1},{"lineBreak":true},{"text":"当埃及支派房角石的，","poem":1},{"lineBreak":true},{"text":"使埃及人走错了路。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华使乖谬的灵搀入埃及中间；","poem":1},{"lineBreak":true},{"text":"首领使埃及一切所做的都有差错，","poem":1},{"lineBreak":true},{"text":"好像醉酒之人呕吐的时候东倒西歪一样。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"埃及中，无论是头与尾，","poem":1},{"lineBreak":true},{"text":"棕枝与芦苇，所做之工都不成就。","poem":1}]},{"type":"verse","number":16,"content":["到那日，埃及人必像妇人一样，他们必因万军之耶和华在埃及以上所抡的手，战兢惧怕。"]},{"type":"verse","number":17,"content":["犹大地必使埃及惊恐，向谁提起犹大地，谁就惧怕。这是因万军之耶和华向埃及所定的旨意。"]},{"type":"verse","number":18,"content":["当那日，埃及地必有五城的人说迦南的方言，又指着万军之耶和华起誓。有一城必称为「灭亡城」。"]},{"type":"verse","number":19,"content":["当那日，在埃及地中必有为耶和华筑的一座坛；在埃及的边界上必有为耶和华立的一根柱。"]},{"type":"verse","number":20,"content":["这都要在埃及地为万军之耶和华作记号和证据。埃及人因为受人的欺压哀求耶和华，他就差遣一位救主作护卫者，拯救他们。"]},{"type":"verse","number":21,"content":["耶和华必被埃及人所认识。在那日，埃及人必认识耶和华，也要献祭物和供物敬拜他，并向耶和华许愿还愿。"]},{"type":"verse","number":22,"content":["耶和华必击打埃及，又击打又医治，埃及人就归向耶和华。他必应允他们的祷告，医治他们。"]},{"type":"verse","number":23,"content":["当那日，必有从埃及通亚述去的大道。亚述人要进入埃及，埃及人也进入亚述；埃及人要与亚述人一同敬拜耶和华。"]},{"type":"verse","number":24,"content":["当那日，以色列必与埃及、亚述三国一律，使地上的人得福；"]},{"type":"verse","number":25,"content":["因为万军之耶和华赐福给他们，说：「埃及—我的百姓，亚述—我手的工作，以色列—我的产业，都有福了！」"]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}