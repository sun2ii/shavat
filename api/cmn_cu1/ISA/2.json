{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":2,"content":[{"type":"heading","content":["永恒的和平"]},{"type":"verse","number":1,"content":["亚摩斯的儿子以赛亚得默示，论到犹大和耶路撒冷。"]},{"type":"verse","number":2,"content":[{"text":"末后的日子，耶和华殿的山必坚立，","poem":1},{"lineBreak":true},{"text":"超乎诸山，高举过于万岭；","poem":1},{"lineBreak":true},{"text":"万民都要流归这山。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"必有许多国的民前往，说：","poem":1},{"lineBreak":true},{"text":"来吧，我们登耶和华的山，","poem":1},{"lineBreak":true},{"text":"奔雅各 神的殿。","poem":1},{"lineBreak":true},{"text":"主必将他的道教训我们；","poem":1},{"lineBreak":true},{"text":"我们也要行他的路。","poem":1},{"lineBreak":true},{"text":"因为训诲必出于锡安；","poem":1},{"lineBreak":true},{"text":"耶和华的言语必出于耶路撒冷。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他必在列国中施行审判，","poem":1},{"lineBreak":true},{"text":"为许多国民断定是非。","poem":1},{"lineBreak":true},{"text":"他们要将刀打成犁头，","poem":1},{"lineBreak":true},{"text":"把枪打成镰刀。","poem":1},{"lineBreak":true},{"text":"这国不举刀攻击那国；","poem":1},{"lineBreak":true},{"text":"他们也不再学习战事。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"雅各家啊，来吧！","poem":1},{"lineBreak":true},{"text":"我们在耶和华的光明中行走。","poem":1}]},{"type":"heading","content":["骄者必败"]},{"type":"verse","number":6,"content":[{"text":"耶和华，你离弃了你百姓雅各家，","poem":1},{"lineBreak":true},{"text":"是因他们充满了东方的风俗，","poem":1},{"lineBreak":true},{"text":"作观兆的，像非利士人一样，","poem":1},{"lineBreak":true},{"text":"并与外邦人击掌。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们的国满了金银，","poem":1},{"lineBreak":true},{"text":"财宝也无穷；","poem":1},{"lineBreak":true},{"text":"他们的地满了马匹，","poem":1},{"lineBreak":true},{"text":"车辆也无数。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们的地满了偶像；","poem":1},{"lineBreak":true},{"text":"他们跪拜自己手所造的，","poem":1},{"lineBreak":true},{"text":"就是自己指头所做的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"卑贱人屈膝；","poem":1},{"lineBreak":true},{"text":"尊贵人下跪；","poem":1},{"lineBreak":true},{"text":"所以不可饶恕他们。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你当进入岩穴，藏在土中，","poem":1},{"lineBreak":true},{"text":"躲避耶和华的惊吓和他威严的荣光。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"到那日，眼目高傲的必降为卑；","poem":1},{"lineBreak":true},{"text":"性情狂傲的都必屈膝；","poem":1},{"lineBreak":true},{"text":"惟独耶和华被尊崇。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"必有万军耶和华降罚的一个日子，","poem":1},{"lineBreak":true},{"text":"要临到骄傲狂妄的；","poem":1},{"lineBreak":true},{"text":"一切自高的都必降为卑；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"又临到黎巴嫩高大的香柏树和巴珊的橡树；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"又临到一切高山的峻岭；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"又临到高台和坚固城墙；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"又临到他施的船只并一切可爱的美物。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"骄傲的必屈膝；","poem":1},{"lineBreak":true},{"text":"狂妄的必降卑。","poem":1},{"lineBreak":true},{"text":"在那日，惟独耶和华被尊崇；","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"偶像必全然废弃。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和华兴起，使地大震动的时候，","poem":1},{"lineBreak":true},{"text":"人就进入石洞，进入土穴，","poem":1},{"lineBreak":true},{"text":"躲避耶和华的惊吓和他威严的荣光。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"到那日，人必将为拜而造的金偶像、银偶像","poem":1},{"lineBreak":true},{"text":"抛给田鼠和蝙蝠。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"到耶和华兴起，使地大震动的时候，","poem":1},{"lineBreak":true},{"text":"人好进入磐石洞中和岩石穴里，","poem":1},{"lineBreak":true},{"text":"躲避耶和华的惊吓和他威严的荣光。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你们休要倚靠世人。","poem":1},{"lineBreak":true},{"text":"他鼻孔里不过有气息；","poem":1},{"lineBreak":true},{"text":"他在一切事上可算什么呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}