{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":21,"content":[{"type":"heading","content":["巴比伦的覆灭"]},{"type":"verse","number":1,"content":["论海旁旷野的默示：",{"text":"有仇敌从旷野，从可怕之地而来，","poem":1},{"lineBreak":true},{"text":"好像南方的旋风，猛然扫过。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"令人凄惨的异象已默示于我。","poem":1},{"lineBreak":true},{"text":"诡诈的行诡诈，毁灭的行毁灭。","poem":1},{"lineBreak":true},{"text":"以拦哪，你要上去！","poem":1},{"lineBreak":true},{"text":"米底亚啊，你要围困！","poem":1},{"lineBreak":true},{"text":"主说：我使一切叹息止住。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"所以，我满腰疼痛；","poem":1},{"lineBreak":true},{"text":"痛苦将我抓住，","poem":1},{"lineBreak":true},{"text":"好像产难的妇人一样。","poem":1},{"lineBreak":true},{"text":"我疼痛甚至不能听；","poem":1},{"lineBreak":true},{"text":"我惊惶甚至不能看。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我心慌张，惊恐威吓我。","poem":1},{"lineBreak":true},{"text":"我所羡慕的黄昏，变为我的战兢。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们摆设筵席，","poem":1},{"lineBreak":true},{"text":"派人守望，又吃又喝。","poem":1},{"lineBreak":true},{"text":"首领啊，你们起来，","poem":1},{"lineBreak":true},{"text":"用油抹盾牌。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"主对我如此说：","poem":1},{"lineBreak":true},{"text":"你去设立守望的，","poem":1},{"lineBreak":true},{"text":"使他将所看见的述说。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他看见军队，","poem":1},{"lineBreak":true},{"text":"就是骑马的一对一对地来，","poem":1},{"lineBreak":true},{"text":"又看见驴队，骆驼队，","poem":1},{"lineBreak":true},{"text":"就要侧耳细听。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他像狮子吼叫，说：","poem":1},{"lineBreak":true},{"text":"主啊，我白日常站在望楼上，","poem":1},{"lineBreak":true},{"text":"整夜立在我守望所。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"看哪，有一队军兵骑着马，","poem":1},{"lineBreak":true},{"text":"一对一对地来。","poem":1},{"lineBreak":true},{"text":"他就说：巴比伦倾倒了！倾倒了！","poem":1},{"lineBreak":true},{"text":"他一切雕刻的神像都打碎于地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我被打的禾稼，我场上的谷啊，","poem":1},{"lineBreak":true},{"text":"我从万军之耶和华—","poem":1},{"lineBreak":true},{"text":"以色列的 神那里所听见的，都告诉你们了。","poem":1}]},{"type":"heading","content":["论以东的信息"]},{"type":"verse","number":11,"content":[{"text":"论度玛的默示：","poem":1},{"lineBreak":true},{"text":"有人声从西珥呼问我说：","poem":1},{"lineBreak":true},{"text":"守望的啊，夜里如何？","poem":1},{"lineBreak":true},{"text":"守望的啊，夜里如何？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"守望的说：","poem":1},{"lineBreak":true},{"text":"早晨将到，黑夜也来。","poem":1},{"lineBreak":true},{"text":"你们若要问就可以问，","poem":1},{"lineBreak":true},{"text":"可以回头再来。","poem":1}]},{"type":"heading","content":["论阿拉伯的信息"]},{"type":"verse","number":13,"content":[{"text":"论阿拉伯的默示：","poem":1},{"lineBreak":true},{"text":"底但结伴的客旅啊，","poem":1},{"lineBreak":true},{"text":"你们必在阿拉伯的树林中住宿。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"提玛地的居民拿水来，送给口渴的，","poem":1},{"lineBreak":true},{"text":"拿饼来迎接逃避的。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因为他们逃避刀剑和出了鞘的刀，","poem":1},{"lineBreak":true},{"text":"并上了弦的弓与刀兵的重灾。","poem":1}]},{"type":"verse","number":16,"content":["主对我这样说：「一年之内，照雇工的年数，基达的一切荣耀必归于无有。"]},{"type":"verse","number":17,"content":["弓箭手所余剩的，就是基达人的勇士，必然稀少，因为这是耶和华—以色列的 神说的。」"]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}