{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":23,"content":[{"type":"heading","content":["神要责罚泰尔的海港"]},{"type":"verse","number":1,"content":["论泰尔的默示：",{"text":"他施的船只都要哀号；","poem":1},{"lineBreak":true},{"text":"因为泰尔变为荒场，","poem":1},{"lineBreak":true},{"text":"甚至没有房屋，没有可进之路。","poem":1},{"lineBreak":true},{"text":"这消息是从基提地得来的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"沿海的居民，","poem":1},{"lineBreak":true},{"text":"就是素来靠航海西顿的商家得丰盛的，","poem":1},{"lineBreak":true},{"text":"你们当静默无言。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"在大水之上，","poem":1},{"lineBreak":true},{"text":"西曷的粮食、","poem":1},{"lineBreak":true},{"text":"尼罗河的庄稼是泰尔的进项；","poem":1},{"lineBreak":true},{"text":"她作列国的大码头。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"西顿哪，你当惭愧；","poem":1},{"lineBreak":true},{"text":"因为大海说，","poem":1},{"lineBreak":true},{"text":"就是海中的保障说：","poem":1},{"lineBreak":true},{"text":"我没有劬劳，也没有生产，","poem":1},{"lineBreak":true},{"text":"没有养育男子，也没有抚养童女。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"这风声传到埃及；","poem":1},{"lineBreak":true},{"text":"埃及人为泰尔的风声极其疼痛。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"泰尔人哪，你们当过到他施去；","poem":1},{"lineBreak":true},{"text":"沿海的居民哪，你们都当哀号。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"这是你们欢乐的城，","poem":1},{"lineBreak":true},{"text":"从上古而有的吗？","poem":1},{"lineBreak":true},{"text":"其中的居民往远方寄居。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"泰尔本是赐冠冕的。","poem":1},{"lineBreak":true},{"text":"她的商家是王子；","poem":1},{"lineBreak":true},{"text":"她的买卖人是世上的尊贵人。","poem":1},{"lineBreak":true},{"text":"遭遇如此是谁定的呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"是万军之耶和华所定的！","poem":1},{"lineBreak":true},{"text":"为要污辱一切高傲的荣耀，","poem":1},{"lineBreak":true},{"text":"使地上一切的尊贵人被藐视。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他施的民","poem":1},{"noteId":18},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"可以流行你的地，好像尼罗河；","poem":1},{"lineBreak":true},{"text":"不再有腰带拘紧你。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华已经向海伸手，","poem":1},{"lineBreak":true},{"text":"震动列国。","poem":1},{"lineBreak":true},{"text":"至于迦南，","poem":1},{"lineBreak":true},{"text":"他已经吩咐拆毁其中的保障。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他又说：受欺压西顿的居民","poem":1},{"noteId":19},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"你必不得再欢乐。","poem":1},{"lineBreak":true},{"text":"起来！过到基提去；","poem":1},{"lineBreak":true},{"text":"就是在那里也不得安歇。","poem":1},{"lineBreak":true},"（"]},{"type":"verse","number":13,"content":["看哪，迦勒底人之地向来没有这民，这国是亚述人为住旷野的人所立的。现在他们建筑戍楼，拆毁泰尔的宫殿，使她成为荒凉。）"]},{"type":"verse","number":14,"content":[{"text":"他施的船只都要哀号，","poem":1},{"lineBreak":true},{"text":"因为你们的保障变为荒场。","poem":1}]},{"type":"verse","number":15,"content":["到那时，泰尔必被忘记七十年，照着一王的年日。七十年后，泰尔的景况必像妓女所唱的歌："]},{"type":"verse","number":16,"content":[{"text":"你这被忘记的妓女啊，","poem":1},{"lineBreak":true},{"text":"拿琴周流城内，","poem":1},{"lineBreak":true},{"text":"巧弹多唱，使人再想念你。","poem":1}]},{"type":"verse","number":17,"content":["七十年后，耶和华必眷顾泰尔，她就仍得利息",{"noteId":20},"，与地上的万国交易",{"noteId":21},"。"]},{"type":"verse","number":18,"content":["她的货财和利息要归耶和华为圣，必不积攒存留；因为她的货财必为住在耶和华面前的人所得，使他们吃饱，穿耐久的衣服。"]}],"footnotes":[{"noteId":18,"caller":"-","text":"原文是女","reference":{"chapter":23,"verse":10}},{"noteId":19,"caller":"-","text":"原文是处女","reference":{"chapter":23,"verse":12}},{"noteId":20,"caller":"-","text":"原文是雇价；下同","reference":{"chapter":23,"verse":17}},{"noteId":21,"caller":"-","text":"原文是行淫","reference":{"chapter":23,"verse":17}}]},"thisChapterLink":"/api/cmn_cu1/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}