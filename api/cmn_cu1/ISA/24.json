{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":24,"content":[{"type":"heading","content":["耶和华要责罚世界"]},{"type":"verse","number":1,"content":[{"text":"看哪，耶和华使地空虚，变为荒凉；","poem":1},{"lineBreak":true},{"text":"又翻转大地，将居民分散。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"那时百姓怎样，祭司也怎样；","poem":1},{"lineBreak":true},{"text":"仆人怎样，主人也怎样；","poem":1},{"lineBreak":true},{"text":"婢女怎样，主母也怎样；","poem":1},{"lineBreak":true},{"text":"买物的怎样，卖物的也怎样；","poem":1},{"lineBreak":true},{"text":"放债的怎样，借债的也怎样；","poem":1},{"lineBreak":true},{"text":"取利的怎样，出利的也怎样。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"地必全然空虚，尽都荒凉；","poem":1},{"lineBreak":true},{"text":"因为这话是耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"地上悲哀衰残，","poem":1},{"lineBreak":true},{"text":"世界败落衰残；","poem":1},{"lineBreak":true},{"text":"地上居高位的人也败落了。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"地被其上的居民污秽；","poem":1},{"lineBreak":true},{"text":"因为他们犯了律法，","poem":1},{"lineBreak":true},{"text":"废了律例，背了永约。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"所以，地被咒诅吞灭；","poem":1},{"lineBreak":true},{"text":"住在其上的显为有罪。","poem":1},{"lineBreak":true},{"text":"地上的居民被火焚烧，","poem":1},{"lineBreak":true},{"text":"剩下的人稀少。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"新酒悲哀，葡萄树衰残；","poem":1},{"lineBreak":true},{"text":"心中欢乐的俱都叹息。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"击鼓之乐止息；","poem":1},{"lineBreak":true},{"text":"宴乐人的声音完毕，","poem":1},{"lineBreak":true},{"text":"弹琴之乐也止息了。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"人必不得饮酒唱歌；","poem":1},{"lineBreak":true},{"text":"喝浓酒的，必以为苦。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"荒凉的城拆毁了；","poem":1},{"lineBreak":true},{"text":"各家关门闭户，使人都不得进去。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"在街上因酒有悲叹的声音；","poem":1},{"lineBreak":true},{"text":"一切喜乐变为昏暗；","poem":1},{"lineBreak":true},{"text":"地上的欢乐归于无有。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"城中只有荒凉；","poem":1},{"lineBreak":true},{"text":"城门拆毁净尽。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"在地上的万民中，","poem":1},{"lineBreak":true},{"text":"必像打过的橄榄树，","poem":1},{"lineBreak":true},{"text":"又像已摘的葡萄所剩无几。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"这些人要高声欢呼；","poem":1},{"lineBreak":true},{"text":"他们为耶和华的威严，从海那里扬起声来。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因此，你们要在东方荣耀耶和华，","poem":1},{"lineBreak":true},{"text":"在众海岛荣耀耶和华—以色列 神的名。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我们听见从地极有人歌唱，说：","poem":1},{"lineBreak":true},{"text":"荣耀归于义人。","poem":1},{"lineBreak":true},{"text":"我却说：我消灭了！","poem":1},{"lineBreak":true},{"text":"我消灭了，我有祸了！","poem":1},{"lineBreak":true},{"text":"诡诈的行诡诈；","poem":1},{"lineBreak":true},{"text":"诡诈的大行诡诈。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"地上的居民哪，","poem":1},{"lineBreak":true},{"text":"恐惧、陷坑、网罗都临近你。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"躲避恐惧声音的必坠入陷坑；","poem":1},{"lineBreak":true},{"text":"从陷坑上来的必被网罗缠住；","poem":1},{"lineBreak":true},{"text":"因为天上的窗户都开了，","poem":1},{"lineBreak":true},{"text":"地的根基也震动了。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"地全然破坏，尽都崩裂，","poem":1},{"lineBreak":true},{"text":"大大地震动了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"地要东倒西歪，好像醉酒的人；","poem":1},{"lineBreak":true},{"text":"又摇来摇去，好像吊床。","poem":1},{"lineBreak":true},{"text":"罪过在其上沉重，","poem":1},{"lineBreak":true},{"text":"必然塌陷，不能复起。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"到那日，耶和华在高处必惩罚高处的众军，","poem":1},{"lineBreak":true},{"text":"在地上必惩罚地上的列王。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他们必被聚集，像囚犯被聚在牢狱中，","poem":1},{"lineBreak":true},{"text":"并要囚在监牢里，","poem":1},{"lineBreak":true},{"text":"多日之后便被讨罪","poem":1},{"noteId":22},{"text":"。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"那时，月亮要蒙羞，日头要惭愧；","poem":1},{"lineBreak":true},{"text":"因为万军之耶和华必在锡安山，","poem":1},{"lineBreak":true},{"text":"在耶路撒冷作王；","poem":1},{"lineBreak":true},{"text":"在敬畏他的长老面前，必有荣耀。","poem":1}]}],"footnotes":[{"noteId":22,"caller":"-","text":"或译：眷顾","reference":{"chapter":24,"verse":22}}]},"thisChapterLink":"/api/cmn_cu1/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}