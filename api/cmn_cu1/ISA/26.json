{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":26,"content":[{"type":"heading","content":["神使他的百姓得胜"]},{"type":"verse","number":1,"content":["当那日，在犹大地人必唱这歌说：",{"text":"我们有坚固的城。","poem":1},{"lineBreak":true},{"text":"耶和华要将救恩定为城墙，为外郭。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"敞开城门，","poem":1},{"lineBreak":true},{"text":"使守信的义民得以进入。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"坚心倚赖你的，","poem":1},{"lineBreak":true},{"text":"你必保守他十分平安，","poem":1},{"lineBreak":true},{"text":"因为他倚靠你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你们当倚靠耶和华直到永远，","poem":1},{"lineBreak":true},{"text":"因为耶和华是永久的磐石。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他使住高处的与高城一并败落，","poem":1},{"lineBreak":true},{"text":"将城拆毁，拆平，直到尘埃，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"要被脚践踏，","poem":1},{"lineBreak":true},{"text":"就是被困苦人的脚和穷乏人的脚践踏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"义人的道是正直的；","poem":1},{"lineBreak":true},{"text":"你为正直的主，必修平义人的路。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华啊，我们在你行审判的路上等候你；","poem":1},{"lineBreak":true},{"text":"我们心里所羡慕的是你的名，","poem":1},{"lineBreak":true},{"text":"就是你那可记念的名。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"夜间，我心中羡慕你；","poem":1},{"lineBreak":true},{"text":"我里面的灵切切寻求你。","poem":1},{"lineBreak":true},{"text":"因为你在世上行审判的时候，","poem":1},{"lineBreak":true},{"text":"地上的居民就学习公义。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"以恩惠待恶人，","poem":1},{"lineBreak":true},{"text":"他仍不学习公义；","poem":1},{"lineBreak":true},{"text":"在正直的地上，他必行事不义，","poem":1},{"lineBreak":true},{"text":"也不注意耶和华的威严。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华啊，你的手高举，","poem":1},{"lineBreak":true},{"text":"他们仍然不看；","poem":1},{"lineBreak":true},{"text":"却要看你为百姓发的热心，因而抱愧，","poem":1},{"lineBreak":true},{"text":"并且有火烧灭你的敌人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华啊，你必派定我们得平安，","poem":1},{"lineBreak":true},{"text":"因为我们所做的事都是你给我们成就的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华—我们的 神啊，","poem":1},{"lineBreak":true},{"text":"在你以外曾有别的主管辖我们，","poem":1},{"lineBreak":true},{"text":"但我们专要倚靠你，提你的名。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们死了，必不能再活；","poem":1},{"lineBreak":true},{"text":"他们去世，必不能再起；","poem":1},{"lineBreak":true},{"text":"因为你刑罚他们，毁灭他们，","poem":1},{"lineBreak":true},{"text":"他们的名号就全然消灭。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和华啊，你增添国民，","poem":1},{"lineBreak":true},{"text":"你增添国民；","poem":1},{"lineBreak":true},{"text":"你得了荣耀，","poem":1},{"lineBreak":true},{"text":"又扩张地的四境。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和华啊，他们在急难中寻求你；","poem":1},{"lineBreak":true},{"text":"你的惩罚临到他们身上，","poem":1},{"lineBreak":true},{"text":"他们就倾心吐胆祷告你。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"妇人怀孕，临产疼痛，","poem":1},{"lineBreak":true},{"text":"在痛苦之中喊叫；","poem":1},{"lineBreak":true},{"text":"耶和华啊，我们在你面前也是如此。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我们也曾怀孕疼痛，","poem":1},{"lineBreak":true},{"text":"所产的竟像风一样。","poem":1},{"lineBreak":true},{"text":"我们在地上未曾行什么拯救的事；","poem":1},{"lineBreak":true},{"text":"世上的居民也未曾败落。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"死人","poem":1},{"noteId":23},{"text":"要复活，","poem":1},{"lineBreak":true},{"text":"尸首","poem":1},{"noteId":24},{"text":"要兴起。","poem":1},{"lineBreak":true},{"text":"睡在尘埃的啊，要醒起歌唱！","poem":1},{"lineBreak":true},{"text":"因你的甘露好像菜蔬上的甘露，","poem":1},{"lineBreak":true},{"text":"地也要交出死人来。","poem":1}]},{"type":"heading","content":["审判和复兴"]},{"type":"verse","number":20,"content":[{"text":"我的百姓啊，你们要来进入内室，","poem":1},{"lineBreak":true},{"text":"关上门，隐藏片时，","poem":1},{"lineBreak":true},{"text":"等到忿怒过去。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"因为耶和华从他的居所出来，","poem":1},{"lineBreak":true},{"text":"要刑罚地上居民的罪孽。","poem":1},{"lineBreak":true},{"text":"地也必露出其中的血，","poem":1},{"lineBreak":true},{"text":"不再掩盖被杀的人。","poem":1}]}],"footnotes":[{"noteId":23,"caller":"-","text":"原文是你的死人","reference":{"chapter":26,"verse":19}},{"noteId":24,"caller":"-","text":"原文是我的尸首","reference":{"chapter":26,"verse":19}}]},"thisChapterLink":"/api/cmn_cu1/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}