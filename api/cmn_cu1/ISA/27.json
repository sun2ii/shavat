{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["到那日，耶和华必用他刚硬有力的大刀刑罚鳄鱼—就是那快行的蛇，刑罚鳄鱼—就是那曲行的蛇，并杀海中的大鱼。"]},{"type":"verse","number":2,"content":[{"text":"当那日，有出酒的葡萄园，","poem":1},{"lineBreak":true},{"text":"你们要指这园唱歌说：","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我—耶和华是看守葡萄园的；","poem":1},{"lineBreak":true},{"text":"我必时刻浇灌，","poem":1},{"lineBreak":true},{"text":"昼夜看守，","poem":1},{"lineBreak":true},{"text":"免得有人损害。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我心中不存忿怒。","poem":1},{"lineBreak":true},{"text":"惟愿荆棘蒺藜与我交战，","poem":1},{"lineBreak":true},{"text":"我就勇往直前，","poem":1},{"lineBreak":true},{"text":"把它一同焚烧。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"不然，让它持住我的能力，","poem":1},{"lineBreak":true},{"text":"使它与我和好，","poem":1},{"lineBreak":true},{"text":"愿它与我和好。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"将来雅各要扎根，","poem":1},{"lineBreak":true},{"text":"以色列要发芽开花；","poem":1},{"lineBreak":true},{"text":"他们的果实必充满世界。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"主击打他们，","poem":1},{"lineBreak":true},{"text":"岂像击打那些击打他们的人吗？","poem":1},{"lineBreak":true},{"text":"他们被杀戮，","poem":1},{"lineBreak":true},{"text":"岂像被他们所杀戮的吗？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你打发他们去，","poem":1},{"lineBreak":true},{"text":"是相机宜与他们相争；","poem":1},{"lineBreak":true},{"text":"刮东风的日子，","poem":1},{"lineBreak":true},{"text":"就用暴风将他们逐去。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"所以，雅各的罪孽得赦免，","poem":1},{"lineBreak":true},{"text":"他的罪过得除掉的果效，全在乎此：","poem":1},{"lineBreak":true},{"text":"就是他叫祭坛的石头变为打碎的灰石，","poem":1},{"lineBreak":true},{"text":"以致木偶和日像不再立起。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因为坚固城变为凄凉，","poem":1},{"lineBreak":true},{"text":"成了撇下离弃的居所，像旷野一样；","poem":1},{"lineBreak":true},{"text":"牛犊必在那里吃草，","poem":1},{"lineBreak":true},{"text":"在那里躺卧，并吃尽其中的树枝。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"枝条枯干，必被折断；","poem":1},{"lineBreak":true},{"text":"妇女要来点火烧着。","poem":1},{"lineBreak":true},{"text":"因为这百姓蒙昧无知，","poem":1},{"lineBreak":true},{"text":"所以，创造他们的必不怜恤他们；","poem":1},{"lineBreak":true},{"text":"造成他们的也不施恩与他们。","poem":1}]},{"type":"verse","number":12,"content":["以色列人哪，到那日，耶和华必从大河，直到埃及小河，将你们一一地收集，如同人打树拾果一样。"]},{"type":"verse","number":13,"content":["当那日，必大发角声，在亚述地将要灭亡的，并在埃及地被赶散的，都要来，他们就在耶路撒冷圣山上敬拜耶和华。"]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}