{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":3,"content":[{"type":"heading","content":["耶路撒冷的混乱"]},{"type":"verse","number":1,"content":[{"text":"主—万军之耶和华从耶路撒冷和犹大，","poem":1},{"lineBreak":true},{"text":"除掉众人所倚靠的，所仗赖的，","poem":1},{"lineBreak":true},{"text":"就是所倚靠的粮，所仗赖的水；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"除掉勇士和战士，","poem":1},{"lineBreak":true},{"text":"审判官和先知，","poem":1},{"lineBreak":true},{"text":"占卜的和长老，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"五十夫长和尊贵人，","poem":1},{"lineBreak":true},{"text":"谋士和有巧艺的，","poem":1},{"lineBreak":true},{"text":"以及妙行法术的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"主说：我必使孩童作他们的首领，","poem":1},{"lineBreak":true},{"text":"使婴孩辖管他们。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"百姓要彼此欺压；","poem":1},{"lineBreak":true},{"text":"各人受邻舍的欺压。","poem":1},{"lineBreak":true},{"text":"少年人必侮慢老年人；","poem":1},{"lineBreak":true},{"text":"卑贱人必侮慢尊贵人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"人在父家拉住弟兄，说：","poem":1},{"lineBreak":true},{"text":"你有衣服，可以作我们的官长。","poem":1},{"lineBreak":true},{"text":"这败落的事归在你手下吧！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"那时，他必扬声说：","poem":1},{"lineBreak":true},{"text":"我不作医治你们的人；","poem":1},{"lineBreak":true},{"text":"因我家中没有粮食，也没有衣服，","poem":1},{"lineBreak":true},{"text":"你们不可立我作百姓的官长。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶路撒冷败落，","poem":1},{"lineBreak":true},{"text":"犹大倾倒；","poem":1},{"lineBreak":true},{"text":"因为他们的舌头和行为与耶和华反对，","poem":1},{"lineBreak":true},{"text":"惹了他荣光的眼目。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"他们的面色证明自己的不正；","poem":1},{"lineBreak":true},{"text":"他们述说自己的罪恶，并不隐瞒，","poem":1},{"lineBreak":true},{"text":"好像所多玛一样。","poem":1},{"lineBreak":true},{"text":"他们有祸了！因为作恶自害。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你们要论义人说：他必享福乐，","poem":1},{"lineBreak":true},{"text":"因为要吃自己行为所结的果子。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"恶人有祸了！他必遭灾难！","poem":1},{"lineBreak":true},{"text":"因为要照自己手所行的受报应。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"至于我的百姓，","poem":1},{"lineBreak":true},{"text":"孩童欺压他们，","poem":1},{"lineBreak":true},{"text":"妇女辖管他们。","poem":1},{"lineBreak":true},{"text":"我的百姓啊，引导你的使你走错，","poem":1},{"lineBreak":true},{"text":"并毁坏你所行的道路。","poem":1}]},{"type":"heading","content":["耶和华审判他的人民"]},{"type":"verse","number":13,"content":[{"text":"耶和华起来辩论，","poem":1},{"lineBreak":true},{"text":"站着审判众民。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华必审问他民中的长老和首领，说：","poem":1},{"lineBreak":true},{"text":"吃尽葡萄园果子的就是你们；","poem":1},{"lineBreak":true},{"text":"向贫穷人所夺的都在你们家中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"主—万军之耶和华说：","poem":1},{"lineBreak":true},{"text":"你们为何压制我的百姓，","poem":1},{"lineBreak":true},{"text":"搓磨贫穷人的脸呢？","poem":1}]},{"type":"heading","content":["对耶路撒冷女子的警告"]},{"type":"verse","number":16,"content":[{"text":"耶和华又说：","poem":1},{"lineBreak":true},{"text":"因为锡安的女子狂傲，","poem":1},{"lineBreak":true},{"text":"行走挺项，卖弄眼目，","poem":1},{"lineBreak":true},{"text":"俏步徐行，脚下玎珰，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"所以，主必使锡安的女子头长秃疮；","poem":1},{"lineBreak":true},{"text":"耶和华又使她们赤露下体。","poem":1}]},{"type":"verse","number":18,"content":["到那日，主必除掉她们华美的脚钏、发网、月牙圈、"]},{"type":"verse","number":19,"content":["耳环、手镯、蒙脸的帕子、"]},{"type":"verse","number":20,"content":["华冠、足链、华带、香盒、符囊、"]},{"type":"verse","number":21,"content":["戒指、鼻环、"]},{"type":"verse","number":22,"content":["吉服、外套、云肩、荷包、"]},{"type":"verse","number":23,"content":["手镜、细麻衣、裹头巾、蒙身的帕子。"]},{"type":"verse","number":24,"content":[{"text":"必有臭烂代替馨香，","poem":1},{"lineBreak":true},{"text":"绳子代替腰带，","poem":1},{"lineBreak":true},{"text":"光秃代替美发，","poem":1},{"lineBreak":true},{"text":"麻衣系腰代替华服，","poem":1},{"lineBreak":true},{"text":"烙伤代替美容。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你的男丁必倒在刀下；","poem":1},{"lineBreak":true},{"text":"你的勇士必死在阵上。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"锡安","poem":1},{"noteId":1},{"text":"的城门必悲伤、哀号；","poem":1},{"lineBreak":true},{"text":"她必荒凉坐在地上。","poem":1}]}],"footnotes":[{"noteId":1,"caller":"-","text":"原文是她","reference":{"chapter":3,"verse":26}}]},"thisChapterLink":"/api/cmn_cu1/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}