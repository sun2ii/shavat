{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":32,"content":[{"type":"heading","content":["公正的王"]},{"type":"verse","number":1,"content":[{"text":"看哪，必有一王凭公义行政；","poem":1},{"lineBreak":true},{"text":"必有首领借公平掌权。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"必有一人像避风所和避暴雨的隐密处，","poem":1},{"lineBreak":true},{"text":"又像河流在干旱之地，","poem":1},{"lineBreak":true},{"text":"像大磐石的影子在疲乏之地。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"那能看的人，眼不再昏迷；","poem":1},{"lineBreak":true},{"text":"能听的人，耳必得听闻。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"冒失人的心必明白知识；","poem":1},{"lineBreak":true},{"text":"结巴人的舌必说话通快。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愚顽人不再称为高明；","poem":1},{"lineBreak":true},{"text":"吝啬人不再称为大方。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因为愚顽人必说愚顽话，","poem":1},{"lineBreak":true},{"text":"心里想作罪孽，","poem":1},{"lineBreak":true},{"text":"惯行亵渎的事，","poem":1},{"lineBreak":true},{"text":"说错谬的话攻击耶和华，","poem":1},{"lineBreak":true},{"text":"使饥饿的人无食可吃，","poem":1},{"lineBreak":true},{"text":"使口渴的人无水可喝。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"吝啬人所用的法子是恶的；","poem":1},{"lineBreak":true},{"text":"他图谋恶计，","poem":1},{"lineBreak":true},{"text":"用谎言毁灭谦卑人；","poem":1},{"lineBreak":true},{"text":"穷乏人讲公理的时候，","poem":1},{"lineBreak":true},{"text":"他也是这样行。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"高明人却谋高明事，","poem":1},{"lineBreak":true},{"text":"在高明事上也必永存。","poem":1}]},{"type":"heading","content":["审判和复兴"]},{"type":"verse","number":9,"content":[{"text":"安逸的妇女啊，起来听我的声音！","poem":1},{"lineBreak":true},{"text":"无虑的女子啊，侧耳听我的言语！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"无虑的女子啊，再过一年多，必受骚扰；","poem":1},{"lineBreak":true},{"text":"因为无葡萄可摘，","poem":1},{"lineBreak":true},{"text":"无果子","poem":1},{"noteId":28},{"text":"可收。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"安逸的妇女啊，要战兢；","poem":1},{"lineBreak":true},{"text":"无虑的女子啊，要受骚扰。","poem":1},{"lineBreak":true},{"text":"脱去衣服，赤着身体，","poem":1},{"lineBreak":true},{"text":"腰束麻布。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"她们必为美好的田地","poem":1},{"lineBreak":true},{"text":"和多结果的葡萄树，捶胸哀哭。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"荆棘蒺藜必长在我百姓的地上，","poem":1},{"lineBreak":true},{"text":"又长在欢乐的城中和一切快乐的房屋上。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因为宫殿必被撇下，","poem":1},{"lineBreak":true},{"text":"多民的城必被离弃；","poem":1},{"lineBreak":true},{"text":"山冈望楼永为洞穴，","poem":1},{"lineBreak":true},{"text":"作野驴所喜乐的，","poem":1},{"lineBreak":true},{"text":"为羊群的草场。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"等到圣灵从上浇灌我们，","poem":1},{"lineBreak":true},{"text":"旷野就变为肥田，","poem":1},{"lineBreak":true},{"text":"肥田看如树林。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"那时，公平要居在旷野；","poem":1},{"lineBreak":true},{"text":"公义要居在肥田。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"公义的果效必是平安；","poem":1},{"lineBreak":true},{"text":"公义的效验必是平稳，直到永远。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我的百姓必住在平安的居所，","poem":1},{"lineBreak":true},{"text":"安稳的住处，平静的安歇所。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"（但要降冰雹打倒树林；","poem":1},{"lineBreak":true},{"text":"城必全然拆平。）","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你们在各水边撒种、","poem":1},{"lineBreak":true},{"text":"牧放牛驴的有福了！","poem":1}]}],"footnotes":[{"noteId":28,"caller":"-","text":"或译：禾稼","reference":{"chapter":32,"verse":10}}]},"thisChapterLink":"/api/cmn_cu1/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}