{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":33,"content":[{"type":"heading","content":["求救的祈祷"]},{"type":"verse","number":1,"content":[{"text":"祸哉！你这毁灭人的，","poem":1},{"lineBreak":true},{"text":"自己倒不被毁灭；","poem":1},{"lineBreak":true},{"text":"行事诡诈的，","poem":1},{"lineBreak":true},{"text":"人倒不以诡诈待你。","poem":1},{"lineBreak":true},{"text":"你毁灭罢休了，","poem":1},{"lineBreak":true},{"text":"自己必被毁灭；","poem":1},{"lineBreak":true},{"text":"你行完了诡诈，","poem":1},{"lineBreak":true},{"text":"人必以诡诈待你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"耶和华啊，求你施恩于我们；","poem":1},{"lineBreak":true},{"text":"我们等候你。","poem":1},{"lineBreak":true},{"text":"求你每早晨作我们的膀臂，","poem":1},{"lineBreak":true},{"text":"遭难的时候为我们的拯救。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"喧嚷的响声一发，众民奔逃；","poem":1},{"lineBreak":true},{"text":"你一兴起，列国四散。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你们所掳的必被敛尽，","poem":1},{"lineBreak":true},{"text":"好像蚂蚱吃","poem":1},{"noteId":29},{"text":"尽禾稼。","poem":1},{"lineBreak":true},{"text":"人要蹦在其上，好像蝗虫一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和华被尊崇，因他居在高处；","poem":1},{"lineBreak":true},{"text":"他以公平公义充满锡安。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你一生一世必得安稳—","poem":1},{"lineBreak":true},{"text":"有丰盛的救恩，","poem":1},{"lineBreak":true},{"text":"并智慧和知识；","poem":1},{"lineBreak":true},{"text":"你以敬畏耶和华为至宝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"看哪，他们的豪杰在外头哀号；","poem":1},{"lineBreak":true},{"text":"求和的使臣痛痛哭泣。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"大路荒凉，行人止息；","poem":1},{"lineBreak":true},{"text":"敌人背约，","poem":1},{"lineBreak":true},{"text":"藐视城邑，","poem":1},{"lineBreak":true},{"text":"不顾人民。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"地上悲哀衰残；","poem":1},{"lineBreak":true},{"text":"黎巴嫩羞愧枯干；","poem":1},{"lineBreak":true},{"text":"沙 像旷野；","poem":1},{"lineBreak":true},{"text":"巴珊和迦密的树林凋残。","poem":1}]},{"type":"heading","content":["耶和华对敌人的警告"]},{"type":"verse","number":10,"content":[{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"现在我要起来；","poem":1},{"lineBreak":true},{"text":"我要兴起；","poem":1},{"lineBreak":true},{"text":"我要勃然而兴。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你们要怀的是糠秕，","poem":1},{"lineBreak":true},{"text":"要生的是碎秸；","poem":1},{"lineBreak":true},{"text":"你们的气就是吞灭自己的火。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"列邦必像已烧的石灰，","poem":1},{"lineBreak":true},{"text":"像已割的荆棘在火中焚烧。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你们远方的人当听我所行的；","poem":1},{"lineBreak":true},{"text":"你们近处的人当承认我的大能。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"锡安中的罪人都惧怕；","poem":1},{"lineBreak":true},{"text":"不敬虔的人被战兢抓住。","poem":1},{"lineBreak":true},{"text":"我们中间谁能与吞灭的火同住？","poem":1},{"lineBreak":true},{"text":"我们中间谁能与永火同住呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"行事公义、说话正直、","poem":1},{"lineBreak":true},{"text":"憎恶欺压的财利、","poem":1},{"lineBreak":true},{"text":"摆手不受贿赂、","poem":1},{"lineBreak":true},{"text":"塞耳不听流血的话，","poem":1},{"lineBreak":true},{"text":"闭眼不看邪恶事的，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他必居高处；","poem":1},{"lineBreak":true},{"text":"他的保障是磐石的坚垒；","poem":1},{"lineBreak":true},{"text":"他的粮必不缺乏","poem":1},{"noteId":30},{"text":"；","poem":1},{"lineBreak":true},{"text":"他的水必不断绝。","poem":1}]},{"type":"heading","content":["光荣的将来"]},{"type":"verse","number":17,"content":[{"text":"你的眼必见王的荣美，","poem":1},{"lineBreak":true},{"text":"必见辽阔之地。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你的心必思想那惊吓的事，","poem":1},{"lineBreak":true},{"text":"自问说：记数目的在哪里呢？","poem":1},{"lineBreak":true},{"text":"平贡银的在哪里呢？","poem":1},{"lineBreak":true},{"text":"数戍楼的在哪里呢？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你必不见那强暴的民，","poem":1},{"lineBreak":true},{"text":"就是说话深奥，你不能明白，","poem":1},{"lineBreak":true},{"text":"言语呢喃，你不能懂得的。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你要看锡安—我们守圣节的城！","poem":1},{"lineBreak":true},{"text":"你的眼必见耶路撒冷为安静的居所，","poem":1},{"lineBreak":true},{"text":"为不挪移的帐幕，","poem":1},{"lineBreak":true},{"text":"橛子永不拔出，","poem":1},{"lineBreak":true},{"text":"绳索一根也不折断。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"在那里，耶和华必显威严与我们同在，","poem":1},{"lineBreak":true},{"text":"当作江河宽阔之地；","poem":1},{"lineBreak":true},{"text":"其中必没有荡桨摇橹的船来往，","poem":1},{"lineBreak":true},{"text":"也没有威武的船经过。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为，耶和华是审判我们的；","poem":1},{"lineBreak":true},{"text":"耶和华是给我们设律法的；","poem":1},{"lineBreak":true},{"text":"耶和华是我们的王；","poem":1},{"lineBreak":true},{"text":"他必拯救我们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"你的绳索松开：","poem":1},{"lineBreak":true},{"text":"不能栽稳桅杆，","poem":1},{"lineBreak":true},{"text":"也不能扬起篷来。","poem":1},{"lineBreak":true},{"text":"那时许多掳来的物被分了；","poem":1},{"lineBreak":true},{"text":"瘸腿的把掠物夺去了。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"城内居民必不说：我病了；","poem":1},{"lineBreak":true},{"text":"其中居住的百姓，罪孽都赦免了。","poem":1}]}],"footnotes":[{"noteId":29,"caller":"-","text":"原文是敛","reference":{"chapter":33,"verse":4}},{"noteId":30,"caller":"-","text":"原文是赐给","reference":{"chapter":33,"verse":16}}]},"thisChapterLink":"/api/cmn_cu1/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}