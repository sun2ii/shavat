{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":34,"content":[{"type":"heading","content":["神要惩罚仇敌"]},{"type":"verse","number":1,"content":[{"text":"列国啊，要近前来听！","poem":1},{"lineBreak":true},{"text":"众民哪，要侧耳而听！","poem":1},{"lineBreak":true},{"text":"地和其上所充满的，","poem":1},{"lineBreak":true},{"text":"世界和其中一切所出的都应当听！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为耶和华向万国发忿恨，","poem":1},{"lineBreak":true},{"text":"向他们的全军发烈怒，","poem":1},{"lineBreak":true},{"text":"将他们灭尽，交出他们受杀戮。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"被杀的必然抛弃，","poem":1},{"lineBreak":true},{"text":"尸首臭气上腾；","poem":1},{"lineBreak":true},{"text":"诸山被他们的血融化。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"天上的万象都要消没；","poem":1},{"lineBreak":true},{"text":"天被卷起，好像书卷。","poem":1},{"lineBreak":true},{"text":"其上的万象要残败，","poem":1},{"lineBreak":true},{"text":"像葡萄树的叶子残败，","poem":1},{"lineBreak":true},{"text":"又像无花果树的叶子残败一样。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因为我的刀在天上已经喝足；","poem":1},{"lineBreak":true},{"text":"这刀必临到以东和我所咒诅的民，","poem":1},{"lineBreak":true},{"text":"要施行审判。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华的刀满了血，","poem":1},{"lineBreak":true},{"text":"用脂油和羊羔、公山羊的血，","poem":1},{"lineBreak":true},{"text":"并公绵羊腰子的脂油滋润的；","poem":1},{"lineBreak":true},{"text":"因为耶和华在波斯拉有献祭的事，","poem":1},{"lineBreak":true},{"text":"在以东地大行杀戮。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"野牛、牛犊，和公牛要一同下来。","poem":1},{"lineBreak":true},{"text":"他们的地喝醉了血；","poem":1},{"lineBreak":true},{"text":"他们的尘土因脂油肥润。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因耶和华有报仇之日，","poem":1},{"lineBreak":true},{"text":"为锡安的争辩有报应之年。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"以东的河水要变为石油，","poem":1},{"lineBreak":true},{"text":"尘埃要变为硫磺；","poem":1},{"lineBreak":true},{"text":"地土成为烧着的石油，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"昼夜总不熄灭，","poem":1},{"lineBreak":true},{"text":"烟气永远上腾，","poem":1},{"lineBreak":true},{"text":"必世世代代成为荒废，","poem":1},{"lineBreak":true},{"text":"永永远远无人经过。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"鹈鹕、箭猪却要得为业；","poem":1},{"lineBreak":true},{"text":"猫头鹰、乌鸦要住在其间。","poem":1},{"lineBreak":true},{"text":"耶和华必将空虚的准绳，","poem":1},{"lineBreak":true},{"text":"混沌的线铊，拉在其上。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"以东人要召贵胄来治国；","poem":1},{"lineBreak":true},{"text":"那里却无一个，","poem":1},{"lineBreak":true},{"text":"首领也都归于无有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"以东的宫殿要长荆棘；","poem":1},{"lineBreak":true},{"text":"保障要长蒺藜和刺草；","poem":1},{"lineBreak":true},{"text":"要作野狗的住处，","poem":1},{"lineBreak":true},{"text":"鸵鸟的居所。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"旷野的走兽要和豺狼相遇；","poem":1},{"lineBreak":true},{"text":"野山羊要与伴偶对叫。","poem":1},{"lineBreak":true},{"text":"夜间的怪物必在那里栖身，","poem":1},{"lineBreak":true},{"text":"自找安歇之处。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"箭蛇要在那里做窝，","poem":1},{"lineBreak":true},{"text":"下蛋，抱蛋，生子，","poem":1},{"lineBreak":true},{"text":"聚子在其影下；","poem":1},{"lineBreak":true},{"text":"鹞鹰各与伴偶聚集在那里。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"你们要查考宣读耶和华的书。","poem":1},{"lineBreak":true},{"text":"这都无一缺少，","poem":1},{"lineBreak":true},{"text":"无一没有伴偶；","poem":1},{"lineBreak":true},{"text":"因为我的口已经吩咐，","poem":1},{"lineBreak":true},{"text":"他的灵将它们聚集。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他也为它们拈阄，","poem":1},{"lineBreak":true},{"text":"又亲手用准绳给它们分地；","poem":1},{"lineBreak":true},{"text":"它们必永得为业，","poem":1},{"lineBreak":true},{"text":"世世代代住在其间。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}