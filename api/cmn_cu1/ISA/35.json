{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":35,"content":[{"type":"heading","content":["神圣之路"]},{"type":"verse","number":1,"content":[{"text":"旷野和干旱之地必然欢喜；","poem":1},{"lineBreak":true},{"text":"沙漠也必快乐；","poem":1},{"lineBreak":true},{"text":"又像玫瑰开花，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"必开花繁盛，","poem":1},{"lineBreak":true},{"text":"乐上加乐，而且欢呼。","poem":1},{"lineBreak":true},{"text":"黎巴嫩的荣耀，","poem":1},{"lineBreak":true},{"text":"并迦密与沙 的华美，必赐给它。","poem":1},{"lineBreak":true},{"text":"人必看见耶和华的荣耀，","poem":1},{"lineBreak":true},{"text":"我们 神的华美。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你们要使软弱的手坚壮，","poem":1},{"lineBreak":true},{"text":"无力的膝稳固。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"对胆怯的人说：","poem":1},{"lineBreak":true},{"text":"你们要刚强，不要惧怕。","poem":1},{"lineBreak":true},{"text":"看哪，你们的 神必来报仇，","poem":1},{"lineBreak":true},{"text":"必来施行极大的报应；","poem":1},{"lineBreak":true},{"text":"他必来拯救你们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"那时，瞎子的眼必睁开；","poem":1},{"lineBreak":true},{"text":"聋子的耳必开通。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"那时，瘸子必跳跃像鹿；","poem":1},{"lineBreak":true},{"text":"哑巴的舌头必能歌唱。","poem":1},{"lineBreak":true},{"text":"在旷野必有水发出；","poem":1},{"lineBreak":true},{"text":"在沙漠必有河涌流。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"发光的沙","poem":1},{"noteId":31},{"text":"要变为水池；","poem":1},{"lineBreak":true},{"text":"干渴之地要变为泉源。","poem":1},{"lineBreak":true},{"text":"在野狗躺卧之处，","poem":1},{"lineBreak":true},{"text":"必有青草、芦苇，和蒲草。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"在那里必有一条大道，","poem":1},{"lineBreak":true},{"text":"称为圣路。","poem":1},{"lineBreak":true},{"text":"污秽人不得经过，","poem":1},{"lineBreak":true},{"text":"必专为赎民行走；","poem":1},{"lineBreak":true},{"text":"行路的人虽愚昧，","poem":1},{"lineBreak":true},{"text":"也不致失迷。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"在那里必没有狮子，","poem":1},{"lineBreak":true},{"text":"猛兽也不登这路；","poem":1},{"lineBreak":true},{"text":"在那里都遇不见，","poem":1},{"lineBreak":true},{"text":"只有赎民在那里行走。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"并且耶和华救赎的民必归回，","poem":1},{"lineBreak":true},{"text":"歌唱来到锡安；","poem":1},{"lineBreak":true},{"text":"永乐必归到他们的头上；","poem":1},{"lineBreak":true},{"text":"他们必得着欢喜快乐，","poem":1},{"lineBreak":true},{"text":"忧愁叹息尽都逃避。","poem":1}]}],"footnotes":[{"noteId":31,"caller":"-","text":"或译：蜃楼","reference":{"chapter":35,"verse":7}}]},"thisChapterLink":"/api/cmn_cu1/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}