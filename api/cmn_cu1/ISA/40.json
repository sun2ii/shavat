{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":40,"content":[{"type":"heading","content":["安慰的话"]},{"type":"verse","number":1,"content":[{"text":"你们的 神说：","poem":1},{"lineBreak":true},{"text":"你们要安慰，安慰我的百姓。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要对耶路撒冷说安慰的话，","poem":1},{"lineBreak":true},{"text":"又向她宣告说，","poem":1},{"lineBreak":true},{"text":"她争战的日子已满了；","poem":1},{"lineBreak":true},{"text":"她的罪孽赦免了；","poem":1},{"lineBreak":true},{"text":"她为自己的一切罪，","poem":1},{"lineBreak":true},{"text":"从耶和华手中加倍受罚。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"有人声喊着说：","poem":1},{"lineBreak":true},{"text":"在旷野预备耶和华的路","poem":1},{"noteId":35},{"text":"，","poem":1},{"lineBreak":true},{"text":"在沙漠地修平我们 神的道。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"一切山洼都要填满，","poem":1},{"lineBreak":true},{"text":"大小山冈都要削平；","poem":1},{"lineBreak":true},{"text":"高高低低的要改为平坦，","poem":1},{"lineBreak":true},{"text":"崎崎岖岖的必成为平原。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华的荣耀必然显现；","poem":1},{"lineBreak":true},{"text":"凡有血气的必一同看见；","poem":1},{"lineBreak":true},{"text":"因为这是耶和华亲口说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"有人声说：你喊叫吧！","poem":1},{"lineBreak":true},{"text":"有一个说：我喊叫什么呢？","poem":1},{"lineBreak":true},{"text":"说：凡有血气的尽都如草；","poem":1},{"lineBreak":true},{"text":"他的美容都像野地的花。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"草必枯干，花必凋残，","poem":1},{"lineBreak":true},{"text":"因为耶和华的气吹在其上；","poem":1},{"lineBreak":true},{"text":"百姓诚然是草。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"草必枯干，花必凋残，","poem":1},{"lineBreak":true},{"text":"惟有我们 神的话必永远立定。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"报好信息给锡安的啊，","poem":1},{"lineBreak":true},{"text":"你要登高山；","poem":1},{"lineBreak":true},{"text":"报好信息给耶路撒冷的啊，","poem":1},{"lineBreak":true},{"text":"你要极力扬声。","poem":1},{"lineBreak":true},{"text":"扬声不要惧怕，","poem":1},{"lineBreak":true},{"text":"对犹大的城邑说：","poem":1},{"lineBreak":true},{"text":"看哪，你们的 神！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"主耶和华必像大能者临到；","poem":1},{"lineBreak":true},{"text":"他的膀臂必为他掌权。","poem":1},{"lineBreak":true},{"text":"他的赏赐在他那里；","poem":1},{"lineBreak":true},{"text":"他的报应在他面前。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他必像牧人牧养自己的羊群，","poem":1},{"lineBreak":true},{"text":"用膀臂聚集羊羔抱在怀中，","poem":1},{"lineBreak":true},{"text":"慢慢引导那乳养小羊的。","poem":1}]},{"type":"heading","content":["以色列的 神无可比拟"]},{"type":"verse","number":12,"content":[{"text":"谁曾用手心量诸水，","poem":1},{"lineBreak":true},{"text":"用手虎口量苍天，","poem":1},{"lineBreak":true},{"text":"用升斗盛大地的尘土，","poem":1},{"lineBreak":true},{"text":"用秤称山岭，","poem":1},{"lineBreak":true},{"text":"用天平平冈陵呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"谁曾测度耶和华的心","poem":1},{"noteId":36},{"text":"，","poem":1},{"lineBreak":true},{"text":"或作他的谋士指教他呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他与谁商议，谁教导他，","poem":1},{"lineBreak":true},{"text":"谁将公平的路指示他，","poem":1},{"lineBreak":true},{"text":"又将知识教训他，","poem":1},{"lineBreak":true},{"text":"将通达的道指教他呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"看哪，万民都像水桶的一滴，","poem":1},{"lineBreak":true},{"text":"又算如天平上的微尘；","poem":1},{"lineBreak":true},{"text":"他举起众海岛，好像极微之物。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"黎巴嫩的树林不够当柴烧；","poem":1},{"lineBreak":true},{"text":"其中的走兽也不够作燔祭。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"万民在他面前好像虚无，","poem":1},{"lineBreak":true},{"text":"被他看为不及虚无，乃为虚空。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"你们究竟将谁比 神，","poem":1},{"lineBreak":true},{"text":"用什么形象与 神比较呢？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"偶像是匠人铸造，","poem":1},{"lineBreak":true},{"text":"银匠用金包裹，","poem":1},{"lineBreak":true},{"text":"为它铸造银链。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"穷乏献不起这样供物的，","poem":1},{"lineBreak":true},{"text":"就拣选不能朽坏的树木，","poem":1},{"lineBreak":true},{"text":"为自己寻找巧匠，","poem":1},{"lineBreak":true},{"text":"立起不能摇动的偶像。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"你们岂不曾知道吗？","poem":1},{"lineBreak":true},{"text":"你们岂不曾听见吗？","poem":1},{"lineBreak":true},{"text":"从起初岂没有人告诉你们吗？","poem":1},{"lineBreak":true},{"text":"自从立地的根基，","poem":1},{"lineBreak":true},{"text":"你们岂没有明白吗？","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"神坐在地球大圈之上；","poem":1},{"lineBreak":true},{"text":"地上的居民好像蝗虫。","poem":1},{"lineBreak":true},{"text":"他铺张穹苍如幔子，","poem":1},{"lineBreak":true},{"text":"展开诸天如可住的帐棚。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他使君王归于虚无，","poem":1},{"lineBreak":true},{"text":"使地上的审判官成为虚空。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"他们是刚才","poem":1},{"noteId":37},{"text":"栽上，","poem":1},{"lineBreak":true},{"text":"刚才种上，","poem":1},{"lineBreak":true},{"text":"根也刚才扎在地里，","poem":1},{"lineBreak":true},{"text":"他一吹在其上，便都枯干；","poem":1},{"lineBreak":true},{"text":"旋风将他们吹去，像碎秸一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"那圣者说：你们将谁比我，","poem":1},{"lineBreak":true},{"text":"叫他与我相等呢？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你们向上举目，","poem":1},{"lineBreak":true},{"text":"看谁创造这万象，","poem":1},{"lineBreak":true},{"text":"按数目领出，","poem":1},{"lineBreak":true},{"text":"他一一称其名；","poem":1},{"lineBreak":true},{"text":"因他的权能，","poem":1},{"lineBreak":true},{"text":"又因他的大能大力，","poem":1},{"lineBreak":true},{"text":"连一个都不缺。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"雅各啊，你为何说，","poem":1},{"lineBreak":true},{"text":"我的道路向耶和华隐藏？","poem":1},{"lineBreak":true},{"text":"以色列啊，你为何言，","poem":1},{"lineBreak":true},{"text":"我的冤屈 神并不查问？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你岂不曾知道吗？","poem":1},{"lineBreak":true},{"text":"你岂不曾听见吗？","poem":1},{"lineBreak":true},{"text":"永在的 神耶和华，创造地极的主，","poem":1},{"lineBreak":true},{"text":"并不疲乏，也不困倦；","poem":1},{"lineBreak":true},{"text":"他的智慧无法测度。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"疲乏的，他赐能力；","poem":1},{"lineBreak":true},{"text":"软弱的，他加力量。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"就是少年人也要疲乏困倦；","poem":1},{"lineBreak":true},{"text":"强壮的也必全然跌倒。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"但那等候耶和华的必从新得力。","poem":1},{"lineBreak":true},{"text":"他们必如鹰展翅上腾；","poem":1},{"lineBreak":true},{"text":"他们奔跑却不困倦，","poem":1},{"lineBreak":true},{"text":"行走却不疲乏。","poem":1}]}],"footnotes":[{"noteId":35,"caller":"-","text":"或译：在旷野，有人声喊着说：当预备耶和华的路","reference":{"chapter":40,"verse":3}},{"noteId":36,"caller":"-","text":"或译：谁曾指示耶和华的灵","reference":{"chapter":40,"verse":13}},{"noteId":37,"caller":"-","text":"或译：不曾；下同","reference":{"chapter":40,"verse":24}}]},"thisChapterLink":"/api/cmn_cu1/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}