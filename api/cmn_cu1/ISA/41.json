{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":41,"content":[{"type":"heading","content":["神对以色列的保证"]},{"type":"verse","number":1,"content":[{"text":"众海岛啊，当在我面前静默；","poem":1},{"lineBreak":true},{"text":"众民当从新得力，","poem":1},{"lineBreak":true},{"text":"都要近前来才可以说话，","poem":1},{"lineBreak":true},{"text":"我们可以彼此辩论。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"谁从东方兴起一人，","poem":1},{"lineBreak":true},{"text":"凭公义召他来到脚前呢？","poem":1},{"lineBreak":true},{"text":"耶和华将列国交给他，","poem":1},{"lineBreak":true},{"text":"使他管辖君王，","poem":1},{"lineBreak":true},{"text":"把他们如灰尘交与他的刀，","poem":1},{"lineBreak":true},{"text":"如风吹的碎秸交与他的弓。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他追赶他们，","poem":1},{"lineBreak":true},{"text":"走他所未走的道，","poem":1},{"lineBreak":true},{"text":"坦然前行。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"谁行做成就这事，","poem":1},{"lineBreak":true},{"text":"从起初宣召历代呢？","poem":1},{"lineBreak":true},{"text":"就是我—耶和华！","poem":1},{"lineBreak":true},{"text":"我是首先的，","poem":1},{"lineBreak":true},{"text":"也与末后的同在。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"海岛看见就都害怕；","poem":1},{"lineBreak":true},{"text":"地极也都战兢，","poem":1},{"lineBreak":true},{"text":"就近前来。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们各人帮助邻舍，","poem":1},{"lineBreak":true},{"text":"各人对弟兄说：壮胆吧！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"木匠勉励银匠，","poem":1},{"lineBreak":true},{"text":"用锤打光的勉励打砧的，","poem":1},{"lineBreak":true},{"text":"论焊工说，焊得好；","poem":1},{"lineBreak":true},{"text":"又用钉子钉稳，免得偶像动摇。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"惟你以色列—我的仆人，","poem":1},{"lineBreak":true},{"text":"雅各—我所拣选的，","poem":1},{"lineBreak":true},{"text":"我朋友亚伯拉罕的后裔，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你是我从地极所领","poem":1},{"noteId":38},{"text":"来的，","poem":1},{"lineBreak":true},{"text":"从地角所召来的，","poem":1},{"lineBreak":true},{"text":"且对你说：你是我的仆人；","poem":1},{"lineBreak":true},{"text":"我拣选你，并不弃绝你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你不要害怕，因为我与你同在；","poem":1},{"lineBreak":true},{"text":"不要惊惶，因为我是你的 神。","poem":1},{"lineBreak":true},{"text":"我必坚固你，我必帮助你；","poem":1},{"lineBreak":true},{"text":"我必用我公义的右手扶持你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"凡向你发怒的必都抱愧蒙羞；","poem":1},{"lineBreak":true},{"text":"与你相争的必如无有，并要灭亡。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"与你争竞的，你要找他们也找不着；","poem":1},{"lineBreak":true},{"text":"与你争战的必如无有，成为虚无。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因为我耶和华—","poem":1},{"lineBreak":true},{"text":"你的 神必搀扶你的右手，","poem":1},{"lineBreak":true},{"text":"对你说：不要害怕！","poem":1},{"lineBreak":true},{"text":"我必帮助你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"你这虫雅各和你们以色列人，","poem":1},{"lineBreak":true},{"text":"不要害怕！","poem":1},{"lineBreak":true},{"text":"耶和华说：我必帮助你。","poem":1},{"lineBreak":true},{"text":"你的救赎主就是以色列的圣者。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"看哪，我已使你成为","poem":1},{"lineBreak":true},{"text":"有快齿打粮的新器具；","poem":1},{"lineBreak":true},{"text":"你要把山岭打得粉碎，","poem":1},{"lineBreak":true},{"text":"使冈陵如同糠秕。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你要把它簸扬，风要吹去；","poem":1},{"lineBreak":true},{"text":"旋风要把它刮散。","poem":1},{"lineBreak":true},{"text":"你倒要以耶和华为喜乐，","poem":1},{"lineBreak":true},{"text":"以以色列的圣者为夸耀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"困苦穷乏人寻求水却没有；","poem":1},{"lineBreak":true},{"text":"他们因口渴，舌头干燥。","poem":1},{"lineBreak":true},{"text":"我—耶和华必应允他们；","poem":1},{"lineBreak":true},{"text":"我—以色列的 神必不离弃他们。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要在净光的高处开江河，","poem":1},{"lineBreak":true},{"text":"在谷中开泉源；","poem":1},{"lineBreak":true},{"text":"我要使沙漠变为水池，","poem":1},{"lineBreak":true},{"text":"使干地变为涌泉。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我要在旷野种上香柏树、","poem":1},{"lineBreak":true},{"text":"皂荚树、番石榴树，和野橄榄树。","poem":1},{"lineBreak":true},{"text":"我在沙漠要把松树、杉树，","poem":1},{"lineBreak":true},{"text":"并黄杨树一同栽植；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"好叫人看见、知道、","poem":1},{"lineBreak":true},{"text":"思想、明白；","poem":1},{"lineBreak":true},{"text":"这是耶和华的手所做的，","poem":1},{"lineBreak":true},{"text":"是以色列的圣者所造的。","poem":1}]},{"type":"heading","content":["耶和华向假神挑战"]},{"type":"verse","number":21,"content":[{"text":"耶和华对假神说：","poem":1},{"lineBreak":true},{"text":"你们要呈上你们的案件；","poem":1},{"lineBreak":true},{"text":"雅各的君说：","poem":1},{"lineBreak":true},{"text":"你们要声明你们确实的理由。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"可以声明，指示我们将来必遇的事，","poem":1},{"lineBreak":true},{"text":"说明先前的是什么事，","poem":1},{"lineBreak":true},{"text":"好叫我们思索，得知事的结局，","poem":1},{"lineBreak":true},{"text":"或者把将来的事指示我们。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"要说明后来的事，","poem":1},{"lineBreak":true},{"text":"好叫我们知道你们是神。","poem":1},{"lineBreak":true},{"text":"你们或降福，或降祸，","poem":1},{"lineBreak":true},{"text":"使我们惊奇，一同观看。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"看哪，你们属乎虚无；","poem":1},{"lineBreak":true},{"text":"你们的作为也属乎虚空。","poem":1},{"lineBreak":true},{"text":"那选择你们的是可憎恶的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"我从北方兴起一人；","poem":1},{"lineBreak":true},{"text":"他是求告我名的，","poem":1},{"lineBreak":true},{"text":"从日出之地而来。","poem":1},{"lineBreak":true},{"text":"他必临到掌权的，","poem":1},{"lineBreak":true},{"text":"好像临到灰泥，","poem":1},{"lineBreak":true},{"text":"仿佛窑匠踹泥一样。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"谁从起初指明这事，使我们知道呢？","poem":1},{"lineBreak":true},{"text":"谁从先前说明，使我们说他不错呢？","poem":1},{"lineBreak":true},{"text":"谁也没有指明；","poem":1},{"lineBreak":true},{"text":"谁也没有说明；","poem":1},{"lineBreak":true},{"text":"谁也没有听见你们的话。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我首先对锡安说：","poem":1},{"lineBreak":true},{"text":"看哪，我要将一位报好信息的赐给耶路撒冷。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我看的时候并没有人；","poem":1},{"lineBreak":true},{"text":"我问的时候，","poem":1},{"lineBreak":true},{"text":"他们中间也没有谋士可以回答一句。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"看哪，他们和他们的工作都是虚空，","poem":1},{"lineBreak":true},{"text":"且是虚无。","poem":1},{"lineBreak":true},{"text":"他们所铸的偶像都是风，","poem":1},{"lineBreak":true},{"text":"都是虚的。","poem":1}]}],"footnotes":[{"noteId":38,"caller":"-","text":"原文是抓","reference":{"chapter":41,"verse":9}}]},"thisChapterLink":"/api/cmn_cu1/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}