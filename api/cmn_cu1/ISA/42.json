{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":42,"content":[{"type":"heading","content":["耶和华的仆人"]},{"type":"verse","number":1,"content":[{"text":"看哪，我的仆人—","poem":1},{"lineBreak":true},{"text":"我所扶持所拣选、心里所喜悦的！","poem":1},{"lineBreak":true},{"text":"我已将我的灵赐给他；","poem":1},{"lineBreak":true},{"text":"他必将公理传给外邦。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他不喧嚷，不扬声，","poem":1},{"lineBreak":true},{"text":"也不使街上听见他的声音。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"压伤的芦苇，他不折断；","poem":1},{"lineBreak":true},{"text":"将残的灯火，他不吹灭。","poem":1},{"lineBreak":true},{"text":"他凭真实将公理传开。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他不灰心，也不丧胆，","poem":1},{"lineBreak":true},{"text":"直到他在地上设立公理；","poem":1},{"lineBreak":true},{"text":"海岛都等候他的训诲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"创造诸天，铺张穹苍，","poem":1},{"lineBreak":true},{"text":"将地和地所出的一并铺开，","poem":1},{"lineBreak":true},{"text":"赐气息给地上的众人，","poem":1},{"lineBreak":true},{"text":"又赐灵性给行在其上之人的 神耶和华，","poem":1},{"lineBreak":true},{"text":"他如此说：","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我—耶和华凭公义召你，","poem":1},{"lineBreak":true},{"text":"必搀扶你的手，保守你，","poem":1},{"lineBreak":true},{"text":"使你作众民的中保","poem":1},{"noteId":39},{"text":"，","poem":1},{"lineBreak":true},{"text":"作外邦人的光，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"开瞎子的眼，","poem":1},{"lineBreak":true},{"text":"领被囚的出牢狱，","poem":1},{"lineBreak":true},{"text":"领坐黑暗的出监牢。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我是耶和华，这是我的名；","poem":1},{"lineBreak":true},{"text":"我必不将我的荣耀归给假神，","poem":1},{"lineBreak":true},{"text":"也不将我的称赞归给雕刻的偶像。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"看哪，先前的事已经成就，","poem":1},{"lineBreak":true},{"text":"现在我将新事说明，","poem":1},{"lineBreak":true},{"text":"这事未发以先，我就说给你们听。","poem":1}]},{"type":"heading","content":["颂赞之歌"]},{"type":"verse","number":10,"content":[{"text":"航海的和海中所有的，","poem":1},{"lineBreak":true},{"text":"海岛和其上的居民，","poem":1},{"lineBreak":true},{"text":"都当向耶和华唱新歌，","poem":1},{"lineBreak":true},{"text":"从地极赞美他。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"旷野和其中的城邑，","poem":1},{"lineBreak":true},{"text":"并基达人居住的村庄都当扬声；","poem":1},{"lineBreak":true},{"text":"西拉的居民当欢呼，","poem":1},{"lineBreak":true},{"text":"在山顶上呐喊。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们当将荣耀归给耶和华，","poem":1},{"lineBreak":true},{"text":"在海岛中传扬他的颂赞。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华必像勇士出去，","poem":1},{"lineBreak":true},{"text":"必像战士激动热心，","poem":1},{"lineBreak":true},{"text":"要喊叫，大声呐喊，","poem":1},{"lineBreak":true},{"text":"要用大力攻击仇敌。","poem":1}]},{"type":"heading","content":["神应许帮助他的子民"]},{"type":"verse","number":14,"content":[{"text":"我许久闭口不言，静默不语；","poem":1},{"lineBreak":true},{"text":"现在我要喊叫，像产难的妇人；","poem":1},{"lineBreak":true},{"text":"我要急气而喘哮。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要使大山小冈变为荒场，","poem":1},{"lineBreak":true},{"text":"使其上的花草都枯干；","poem":1},{"lineBreak":true},{"text":"我要使江河变为洲岛，","poem":1},{"lineBreak":true},{"text":"使水池都干涸。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要引瞎子行不认识的道，","poem":1},{"lineBreak":true},{"text":"领他们走不知道的路；","poem":1},{"lineBreak":true},{"text":"在他们面前使黑暗变为光明，","poem":1},{"lineBreak":true},{"text":"使弯曲变为平直。","poem":1},{"lineBreak":true},{"text":"这些事我都要行，","poem":1},{"lineBreak":true},{"text":"并不离弃他们。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"倚靠雕刻的偶像，","poem":1},{"lineBreak":true},{"text":"对铸造的偶像说：","poem":1},{"lineBreak":true},{"text":"你是我们的神；","poem":1},{"lineBreak":true},{"text":"这等人要退后，全然蒙羞。","poem":1}]},{"type":"heading","content":["以色列人不受教益"]},{"type":"verse","number":18,"content":[{"text":"你们这耳聋的，听吧！","poem":1},{"lineBreak":true},{"text":"你们这眼瞎的，看吧！","poem":1},{"lineBreak":true},{"text":"使你们能看见。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"谁比我的仆人眼瞎呢？","poem":1},{"lineBreak":true},{"text":"谁比我差遣的使者耳聋呢？","poem":1},{"lineBreak":true},{"text":"谁瞎眼像那与我和好的？","poem":1},{"lineBreak":true},{"text":"谁瞎眼像耶和华的仆人呢？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你看见许多事却不领会，","poem":1},{"lineBreak":true},{"text":"耳朵开通却不听见。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和华因自己公义的缘故，","poem":1},{"lineBreak":true},{"text":"喜欢使律法","poem":1},{"noteId":40},{"text":"为大，为尊。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"但这百姓是被抢被夺的，","poem":1},{"lineBreak":true},{"text":"都牢笼在坑中，隐藏在狱里；","poem":1},{"lineBreak":true},{"text":"他们作掠物，无人拯救，","poem":1},{"lineBreak":true},{"text":"作掳物，无人说交还。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你们中间谁肯侧耳听此，","poem":1},{"lineBreak":true},{"text":"谁肯留心而听，以防将来呢？","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"谁将雅各交出当作掳物，","poem":1},{"lineBreak":true},{"text":"将以色列交给抢夺的呢？","poem":1},{"lineBreak":true},{"text":"岂不是耶和华吗？","poem":1},{"lineBreak":true},{"text":"就是我们所得罪的那位。","poem":1},{"lineBreak":true},{"text":"他们不肯遵行他的道，","poem":1},{"lineBreak":true},{"text":"也不听从他的训诲。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"所以，他将猛烈的怒气和争战的勇力","poem":1},{"lineBreak":true},{"text":"倾倒在以色列的身上。","poem":1},{"lineBreak":true},{"text":"在他四围如火着起，他还不知道，","poem":1},{"lineBreak":true},{"text":"烧着他，他也不介意。","poem":1}]}],"footnotes":[{"noteId":39,"caller":"-","text":"中保：原文是约","reference":{"chapter":42,"verse":6}},{"noteId":40,"caller":"-","text":"或译：训诲","reference":{"chapter":42,"verse":21}}]},"thisChapterLink":"/api/cmn_cu1/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}