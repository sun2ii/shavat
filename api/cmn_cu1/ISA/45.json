{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":45,"content":[{"type":"heading","content":["耶和华立塞鲁士为王"]},{"type":"verse","number":1,"content":[{"text":"我—耶和华所膏的塞鲁士；","poem":1},{"lineBreak":true},{"text":"我搀扶他的右手，","poem":1},{"lineBreak":true},{"text":"使列国降伏在他面前。","poem":1},{"lineBreak":true},{"text":"我也要放松列王的腰带，","poem":1},{"lineBreak":true},{"text":"使城门在他面前敞开，","poem":1},{"lineBreak":true},{"text":"不得关闭。","poem":1},{"lineBreak":true},{"text":"我对他如此说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我必在你前面行，","poem":1},{"lineBreak":true},{"text":"修平崎岖之地。","poem":1},{"lineBreak":true},{"text":"我必打破铜门，","poem":1},{"lineBreak":true},{"text":"砍断铁闩。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我要将暗中的宝物和隐密的财宝赐给你，","poem":1},{"lineBreak":true},{"text":"使你知道提名召你的，","poem":1},{"lineBreak":true},{"text":"就是我—耶和华、以色列的 神。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因我仆人雅各，","poem":1},{"lineBreak":true},{"text":"我所拣选以色列的缘故，","poem":1},{"lineBreak":true},{"text":"我就提名召你；","poem":1},{"lineBreak":true},{"text":"你虽不认识我，","poem":1},{"lineBreak":true},{"text":"我也加给你名号。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我是耶和华，在我以外并没有别神；","poem":1},{"lineBreak":true},{"text":"除了我以外再没有 神。","poem":1},{"lineBreak":true},{"text":"你虽不认识我，","poem":1},{"lineBreak":true},{"text":"我必给你束腰。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"从日出之地到日落之处","poem":1},{"lineBreak":true},{"text":"使人都知道除了我以外，没有别神。","poem":1},{"lineBreak":true},{"text":"我是耶和华；","poem":1},{"lineBreak":true},{"text":"在我以外并没有别神。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我造光，又造暗；","poem":1},{"lineBreak":true},{"text":"我施平安，又降灾祸；","poem":1},{"lineBreak":true},{"text":"造作这一切的是我—耶和华。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"诸天哪，自上而滴，","poem":1},{"lineBreak":true},{"text":"穹苍降下公义；","poem":1},{"lineBreak":true},{"text":"地面开裂，产出救恩，","poem":1},{"lineBreak":true},{"text":"使公义一同发生；","poem":1},{"lineBreak":true},{"text":"这都是我—耶和华所造的。","poem":1}]},{"type":"heading","content":["创造和历史的主宰"]},{"type":"verse","number":9,"content":[{"text":"祸哉，那与造他的主争论的！","poem":1},{"lineBreak":true},{"text":"他不过是地上瓦片中的一块瓦片。","poem":1},{"lineBreak":true},{"text":"泥土岂可对抟弄他的说：你做什么呢？","poem":1},{"lineBreak":true},{"text":"所做的物岂可说：你没有手呢？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祸哉，那对父亲说：","poem":1},{"lineBreak":true},{"text":"你生的是什么呢？","poem":1},{"lineBreak":true},{"text":"或对母亲","poem":1},{"noteId":44},{"text":"说：","poem":1},{"lineBreak":true},{"text":"你产的是什么呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华—以色列的圣者，","poem":1},{"lineBreak":true},{"text":"就是造就以色列的如此说：","poem":1},{"lineBreak":true},{"text":"将来的事，你们可以问我；","poem":1},{"lineBreak":true},{"text":"至于我的众子，并我手的工作，","poem":1},{"lineBreak":true},{"text":"你们可以求我命定","poem":1},{"noteId":45},{"text":"。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我造地，又造人在地上。","poem":1},{"lineBreak":true},{"text":"我亲手铺张诸天；","poem":1},{"lineBreak":true},{"text":"天上万象也是我所命定的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我凭公义兴起塞鲁士","poem":1},{"noteId":46},{"text":"，","poem":1},{"lineBreak":true},{"text":"又要修直他一切道路。","poem":1},{"lineBreak":true},{"text":"他必建造我的城，","poem":1},{"lineBreak":true},{"text":"释放我被掳的民；","poem":1},{"lineBreak":true},{"text":"不是为工价，也不是为赏赐。","poem":1},{"lineBreak":true},{"text":"这是万军之耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"埃及劳碌得来的和古实的货物必归你；","poem":1},{"lineBreak":true},{"text":"身量高大的西巴人必投降你，也要属你。","poem":1},{"lineBreak":true},{"text":"他们必带着锁链过来随从你，","poem":1},{"lineBreak":true},{"text":"又向你下拜，祈求你说：","poem":1},{"lineBreak":true},{"text":"神真在你们中间，此外再没有别神；","poem":1},{"lineBreak":true},{"text":"再没有别的 神。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"救主—以色列的 神啊，","poem":1},{"lineBreak":true},{"text":"你实在是自隐的 神。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"凡制造偶像的都必抱愧蒙羞，","poem":1},{"lineBreak":true},{"text":"都要一同归于惭愧。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"惟有以色列必蒙耶和华的拯救，","poem":1},{"lineBreak":true},{"text":"得永远的救恩。","poem":1},{"lineBreak":true},{"text":"你们必不蒙羞，也不抱愧，","poem":1},{"lineBreak":true},{"text":"直到永世无尽。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"创造诸天的耶和华，","poem":1},{"lineBreak":true},{"text":"制造成全大地的 神，","poem":1},{"lineBreak":true},{"text":"他创造坚定大地，","poem":1},{"lineBreak":true},{"text":"并非使地荒凉，","poem":1},{"lineBreak":true},{"text":"是要给人居住。","poem":1},{"lineBreak":true},{"text":"他如此说：","poem":1},{"lineBreak":true},{"text":"我是耶和华，再没有别神。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我没有在隐密黑暗之地说话；","poem":1},{"lineBreak":true},{"text":"我没有对雅各的后裔说：","poem":1},{"lineBreak":true},{"text":"你们寻求我是徒然的。","poem":1},{"lineBreak":true},{"text":"我—耶和华所讲的是公义，","poem":1},{"lineBreak":true},{"text":"所说的是正直。","poem":1}]},{"type":"heading","content":["天地之主和巴比伦的偶像"]},{"type":"verse","number":20,"content":[{"text":"你们从列国逃脱的人，","poem":1},{"lineBreak":true},{"text":"要一同聚集前来。","poem":1},{"lineBreak":true},{"text":"那些抬着雕刻木偶、","poem":1},{"lineBreak":true},{"text":"祷告不能救人之神的，","poem":1},{"lineBreak":true},{"text":"毫无知识。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你们要述说陈明你们的理，","poem":1},{"lineBreak":true},{"text":"让他们彼此商议。","poem":1},{"lineBreak":true},{"text":"谁从古时指明？","poem":1},{"lineBreak":true},{"text":"谁从上古述说？","poem":1},{"lineBreak":true},{"text":"不是我—耶和华吗？","poem":1},{"lineBreak":true},{"text":"除了我以外，再没有 神；","poem":1},{"lineBreak":true},{"text":"我是公义的 神，又是救主；","poem":1},{"lineBreak":true},{"text":"除了我以外，再没有别神。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"地极的人都当仰望我，","poem":1},{"lineBreak":true},{"text":"就必得救；","poem":1},{"lineBreak":true},{"text":"因为我是 神，再没有别神。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我指着自己起誓，","poem":1},{"lineBreak":true},{"text":"我口所出的话是凭公义，并不反回：","poem":1},{"lineBreak":true},{"text":"万膝必向我跪拜；","poem":1},{"lineBreak":true},{"text":"万口必凭我起誓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"人论我说，","poem":1},{"lineBreak":true},{"text":"公义、能力，惟独在乎耶和华；","poem":1},{"lineBreak":true},{"text":"人都必归向他。","poem":1},{"lineBreak":true},{"text":"凡向他发怒的必至蒙羞。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"以色列的后裔都必因耶和华得称为义，","poem":1},{"lineBreak":true},{"text":"并要夸耀。","poem":1}]}],"footnotes":[{"noteId":44,"caller":"-","text":"原文是妇人","reference":{"chapter":45,"verse":10}},{"noteId":45,"caller":"-","text":"原文是吩咐我","reference":{"chapter":45,"verse":11}},{"noteId":46,"caller":"-","text":"原文是他","reference":{"chapter":45,"verse":13}}]},"thisChapterLink":"/api/cmn_cu1/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}