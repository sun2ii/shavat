{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":47,"content":[{"type":"heading","content":["审判巴比伦"]},{"type":"verse","number":1,"content":[{"text":"巴比伦的处女啊，","poem":1},{"lineBreak":true},{"text":"下来坐在尘埃；","poem":1},{"lineBreak":true},{"text":"迦勒底的闺女啊，","poem":1},{"lineBreak":true},{"text":"没有宝座，要坐在地上；","poem":1},{"lineBreak":true},{"text":"因为你不再称为柔弱娇嫩的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要用磨磨面，","poem":1},{"lineBreak":true},{"text":"揭去帕子，","poem":1},{"lineBreak":true},{"text":"脱去长衣，露腿趟河。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的下体必被露出；","poem":1},{"lineBreak":true},{"text":"你的丑陋必被看见。","poem":1},{"lineBreak":true},{"text":"我要报仇，","poem":1},{"lineBreak":true},{"text":"谁也不宽容。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们救赎主的名是","poem":1},{"lineBreak":true},{"text":"万军之耶和华—以色列的圣者。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"迦勒底的闺女啊，","poem":1},{"lineBreak":true},{"text":"你要默然静坐，进入暗中，","poem":1},{"lineBreak":true},{"text":"因为你不再称为列国的主母。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我向我的百姓发怒，","poem":1},{"lineBreak":true},{"text":"使我的产业被亵渎，","poem":1},{"lineBreak":true},{"text":"将他们交在你手中，","poem":1},{"lineBreak":true},{"text":"你毫不怜悯他们，","poem":1},{"lineBreak":true},{"text":"把极重的轭加在老年人身上。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你自己说：我必永为主母，","poem":1},{"lineBreak":true},{"text":"所以你不将这事放在心上，","poem":1},{"lineBreak":true},{"text":"也不思想这事的结局。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你这专好宴乐、安然居住的，","poem":1},{"lineBreak":true},{"text":"现在当听这话。","poem":1},{"lineBreak":true},{"text":"你心中说：惟有我，","poem":1},{"lineBreak":true},{"text":"除我以外再没有别的。","poem":1},{"lineBreak":true},{"text":"我必不致寡居，","poem":1},{"lineBreak":true},{"text":"也不遭丧子之事。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"哪知，丧子、寡居这两件事","poem":1},{"lineBreak":true},{"text":"在一日转眼之间必临到你；","poem":1},{"lineBreak":true},{"text":"正在你多行邪术、广施符咒的时候，","poem":1},{"lineBreak":true},{"text":"这两件事必全然临到你身上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你素来倚仗自己的恶行，说：","poem":1},{"lineBreak":true},{"text":"无人看见我。","poem":1},{"lineBreak":true},{"text":"你的智慧聪明使你偏邪，","poem":1},{"lineBreak":true},{"text":"并且你心里说：惟有我，","poem":1},{"lineBreak":true},{"text":"除我以外再没有别的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因此，祸患要临到你身；","poem":1},{"lineBreak":true},{"text":"你不知何时发现","poem":1},{"noteId":47},{"lineBreak":true},{"text":"灾害落在你身上，","poem":1},{"lineBreak":true},{"text":"你也不能除掉；","poem":1},{"lineBreak":true},{"text":"所不知道的毁灭也必忽然临到你身。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"站起来吧！","poem":1},{"lineBreak":true},{"text":"用你从幼年劳神施行的符咒和你许多的邪术；","poem":1},{"lineBreak":true},{"text":"或者可得益处，","poem":1},{"lineBreak":true},{"text":"或者可得强胜。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你筹划太多，以致疲倦。","poem":1},{"lineBreak":true},{"text":"让那些观天象的，看星宿的，","poem":1},{"lineBreak":true},{"text":"在月朔说预言的，都站起来，","poem":1},{"lineBreak":true},{"text":"救你脱离所要临到你的事。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"他们要像碎秸被火焚烧，","poem":1},{"lineBreak":true},{"text":"不能救自己脱离火焰之力；","poem":1},{"lineBreak":true},{"text":"这火并非可烤的炭火，","poem":1},{"lineBreak":true},{"text":"也不是可以坐在其前的火。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你所劳神的事都要这样与你无益；","poem":1},{"lineBreak":true},{"text":"从幼年与你贸易的也都各奔各乡，无人救你。","poem":1}]}],"footnotes":[{"noteId":47,"caller":"-","text":"或译：如何驱逐","reference":{"chapter":47,"verse":11}}]},"thisChapterLink":"/api/cmn_cu1/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}