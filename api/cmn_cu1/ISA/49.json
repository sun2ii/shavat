{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":49,"content":[{"type":"heading","content":["外邦之光"]},{"type":"verse","number":1,"content":[{"text":"众海岛啊，当听我言！","poem":1},{"lineBreak":true},{"text":"远方的众民哪，留心而听！","poem":1},{"lineBreak":true},{"text":"自我出胎，耶和华就选召我；","poem":1},{"lineBreak":true},{"text":"自出母腹，他就提我的名。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他使我的口如快刀，","poem":1},{"lineBreak":true},{"text":"将我藏在他手荫之下；","poem":1},{"lineBreak":true},{"text":"又使我成为磨亮的箭，","poem":1},{"lineBreak":true},{"text":"将我藏在他箭袋之中；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"对我说：你是我的仆人以色列；","poem":1},{"lineBreak":true},{"text":"我必因你得荣耀。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我却说：我劳碌是徒然；","poem":1},{"lineBreak":true},{"text":"我尽力是虚无虚空。","poem":1},{"lineBreak":true},{"text":"然而，我当得的理必在耶和华那里；","poem":1},{"lineBreak":true},{"text":"我的赏赐必在我 神那里。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和华从我出胎，造就我作他的仆人，","poem":1},{"lineBreak":true},{"text":"要使雅各归向他，","poem":1},{"lineBreak":true},{"text":"使以色列到他那里聚集。","poem":1},{"lineBreak":true},{"text":"原来耶和华看我为尊贵；","poem":1},{"lineBreak":true},{"text":"我的 神也成为我的力量。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"现在他说：你作我的仆人，","poem":1},{"lineBreak":true},{"text":"使雅各众支派复兴，","poem":1},{"lineBreak":true},{"text":"使以色列中得保全的归回尚为小事，","poem":1},{"lineBreak":true},{"text":"我还要使你作外邦人的光，","poem":1},{"lineBreak":true},{"text":"叫你施行我的救恩，直到地极。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"救赎主—以色列的圣者耶和华","poem":1},{"lineBreak":true},{"text":"对那被人所藐视、本国所憎恶、","poem":1},{"lineBreak":true},{"text":"官长所虐待的如此说：","poem":1},{"lineBreak":true},{"text":"君王要看见就站起，","poem":1},{"lineBreak":true},{"text":"首领也要下拜；","poem":1},{"lineBreak":true},{"text":"都因信实的耶和华，","poem":1},{"lineBreak":true},{"text":"就是拣选你—以色列的圣者。","poem":1}]},{"type":"heading","content":["耶路撒冷的复兴"]},{"type":"verse","number":8,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"在悦纳的时候，我应允了你；","poem":1},{"lineBreak":true},{"text":"在拯救的日子，我济助了你。","poem":1},{"lineBreak":true},{"text":"我要保护你，","poem":1},{"lineBreak":true},{"text":"使你作众民的中保","poem":1},{"noteId":50},{"text":"；","poem":1},{"lineBreak":true},{"text":"复兴遍地，","poem":1},{"lineBreak":true},{"text":"使人承受荒凉之地为业。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"对那被捆绑的人说：出来吧！","poem":1},{"lineBreak":true},{"text":"对那在黑暗的人说：显露吧！","poem":1},{"lineBreak":true},{"text":"他们在路上必得饮食，","poem":1},{"lineBreak":true},{"text":"在一切净光的高处必有食物。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"不饥不渴，","poem":1},{"lineBreak":true},{"text":"炎热和烈日必不伤害他们；","poem":1},{"lineBreak":true},{"text":"因为怜恤他们的必引导他们，","poem":1},{"lineBreak":true},{"text":"领他们到水泉旁边。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我必使我的众山成为大道；","poem":1},{"lineBreak":true},{"text":"我的大路也被修高。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"看哪，这些从远方来；","poem":1},{"lineBreak":true},{"text":"这些从北方、从西方来；","poem":1},{"lineBreak":true},{"text":"这些从秦","poem":1},{"noteId":51},{"text":"国来。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"诸天哪，应当欢呼！","poem":1},{"lineBreak":true},{"text":"大地啊，应当快乐！","poem":1},{"lineBreak":true},{"text":"众山哪，应当发声歌唱！","poem":1},{"lineBreak":true},{"text":"因为耶和华已经安慰他的百姓，","poem":1},{"lineBreak":true},{"text":"也要怜恤他困苦之民。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"锡安说：耶和华离弃了我；","poem":1},{"lineBreak":true},{"text":"主忘记了我。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"妇人焉能忘记她吃奶的婴孩，","poem":1},{"lineBreak":true},{"text":"不怜恤她所生的儿子？","poem":1},{"lineBreak":true},{"text":"即或有忘记的，","poem":1},{"lineBreak":true},{"text":"我却不忘记你。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"看哪，我将你铭刻在我掌上；","poem":1},{"lineBreak":true},{"text":"你的墙垣常在我眼前。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你的儿女必急速归回；","poem":1},{"lineBreak":true},{"text":"毁坏你的，使你荒废的，必都离你出去，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你举目向四方观看；","poem":1},{"lineBreak":true},{"text":"他们都聚集来到你这里。","poem":1},{"lineBreak":true},{"text":"耶和华说：我指着我的永生起誓：","poem":1},{"lineBreak":true},{"text":"你必要以他们为妆饰佩戴，","poem":1},{"lineBreak":true},{"text":"以他们为华带束腰，像新妇一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"至于你荒废凄凉之处，","poem":1},{"lineBreak":true},{"text":"并你被毁坏之地，","poem":1},{"lineBreak":true},{"text":"现今众民居住必显为太窄；","poem":1},{"lineBreak":true},{"text":"吞灭你的必离你遥远。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你必听见丧子之后所生的儿女说：","poem":1},{"lineBreak":true},{"text":"这地方我居住太窄，","poem":1},{"lineBreak":true},{"text":"求你给我地方居住。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"那时你心里必说：我既丧子独居，","poem":1},{"lineBreak":true},{"text":"是被掳的，漂流在外。","poem":1},{"lineBreak":true},{"text":"谁给我生这些？","poem":1},{"lineBreak":true},{"text":"谁将这些养大呢？","poem":1},{"lineBreak":true},{"text":"撇下我一人独居的时候，","poem":1},{"lineBreak":true},{"text":"这些在哪里呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"主耶和华如此说：","poem":1},{"lineBreak":true},{"text":"我必向列国举手，","poem":1},{"lineBreak":true},{"text":"向万民竖立大旗；","poem":1},{"lineBreak":true},{"text":"他们必将你的众子怀中抱来，","poem":1},{"lineBreak":true},{"text":"将你的众女肩上扛来。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"列王必作你的养父；","poem":1},{"lineBreak":true},{"text":"王后必作你的乳母。","poem":1},{"lineBreak":true},{"text":"他们必将脸伏地，向你下拜，","poem":1},{"lineBreak":true},{"text":"并舔你脚上的尘土。","poem":1},{"lineBreak":true},{"text":"你便知道我是耶和华；","poem":1},{"lineBreak":true},{"text":"等候我的必不致羞愧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"勇士抢去的岂能夺回？","poem":1},{"lineBreak":true},{"text":"该掳掠的岂能解救吗？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"但耶和华如此说：","poem":1},{"lineBreak":true},{"text":"就是勇士所掳掠的，也可以夺回；","poem":1},{"lineBreak":true},{"text":"强暴人所抢的，也可以解救。","poem":1},{"lineBreak":true},{"text":"与你相争的，我必与他相争；","poem":1},{"lineBreak":true},{"text":"我要拯救你的儿女。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"并且我必使那欺压你的吃自己的肉，","poem":1},{"lineBreak":true},{"text":"也要以自己的血喝醉，好像喝甜酒一样。","poem":1},{"lineBreak":true},{"text":"凡有血气的必都知道我—耶和华是你的救主，","poem":1},{"lineBreak":true},{"text":"是你的救赎主，是雅各的大能者。","poem":1}]}],"footnotes":[{"noteId":50,"caller":"-","text":"中保：原文是约","reference":{"chapter":49,"verse":8}},{"noteId":51,"caller":"-","text":"原文是希尼","reference":{"chapter":49,"verse":12}}]},"thisChapterLink":"/api/cmn_cu1/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}