{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":5,"content":[{"type":"heading","content":["葡萄园之歌"]},{"type":"verse","number":1,"content":[{"text":"我要为我所亲爱的唱歌，","poem":1},{"lineBreak":true},{"text":"是我所爱者的歌，论他葡萄园的事：","poem":1},{"lineBreak":true},{"text":"我所亲爱的有葡萄园在肥美的山冈上。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他刨挖园子，捡去石头，","poem":1},{"lineBreak":true},{"text":"栽种上等的葡萄树，","poem":1},{"lineBreak":true},{"text":"在园中盖了一座楼，","poem":1},{"lineBreak":true},{"text":"又凿出压酒池；","poem":1},{"lineBreak":true},{"text":"指望结好葡萄，","poem":1},{"lineBreak":true},{"text":"反倒结了野葡萄。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶路撒冷的居民和犹大人哪，","poem":1},{"lineBreak":true},{"text":"请你们现今在我与我的葡萄园中，断定是非。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我为我葡萄园所做之外，","poem":1},{"lineBreak":true},{"text":"还有什么可做的呢？","poem":1},{"lineBreak":true},{"text":"我指望结好葡萄，","poem":1},{"lineBreak":true},{"text":"怎么倒结了野葡萄呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"现在我告诉你们，","poem":1},{"lineBreak":true},{"text":"我要向我葡萄园怎样行：","poem":1},{"lineBreak":true},{"text":"我必撤去篱笆，使它被吞灭，","poem":1},{"lineBreak":true},{"text":"拆毁墙垣，使它被践踏。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我必使它荒废，不再修理，","poem":1},{"lineBreak":true},{"text":"不再锄刨，荆棘蒺藜倒要生长。","poem":1},{"lineBreak":true},{"text":"我也必命云不降雨在其上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"万军之耶和华的葡萄园就是以色列家；","poem":1},{"lineBreak":true},{"text":"他所喜爱的树就是犹大人。","poem":1},{"lineBreak":true},{"text":"他指望的是公平，","poem":1},{"lineBreak":true},{"text":"谁知倒有暴虐","poem":1},{"noteId":2},{"text":"；","poem":1},{"lineBreak":true},{"text":"指望的是公义，","poem":1},{"lineBreak":true},{"text":"谁知倒有冤声。","poem":1}]},{"type":"heading","content":["人的恶行"]},{"type":"verse","number":8,"content":[{"text":"祸哉！那些以房接房，","poem":1},{"lineBreak":true},{"text":"以地连地，","poem":1},{"lineBreak":true},{"text":"以致不留余地的，","poem":1},{"lineBreak":true},{"text":"只顾自己独居境内。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我耳闻万军之耶和华说：","poem":1},{"lineBreak":true},{"text":"必有许多又大又美的房屋","poem":1},{"lineBreak":true},{"text":"成为荒凉，无人居住。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"三十亩葡萄园只出一罢特酒；","poem":1},{"lineBreak":true},{"text":"一贺梅珥谷种只结一伊法粮食。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"祸哉！那些清早起来追求浓酒，","poem":1},{"lineBreak":true},{"text":"留连到夜深，甚至因酒发烧的人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们在筵席上","poem":1},{"lineBreak":true},{"text":"弹琴，鼓瑟，击鼓，吹笛，饮酒，","poem":1},{"lineBreak":true},{"text":"却不顾念耶和华的作为，","poem":1},{"lineBreak":true},{"text":"也不留心他手所做的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"所以，我的百姓因无知就被掳去；","poem":1},{"lineBreak":true},{"text":"他们的尊贵人甚是饥饿，","poem":1},{"lineBreak":true},{"text":"群众极其干渴。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"故此，阴间扩张其欲，","poem":1},{"lineBreak":true},{"text":"开了无限量的口；","poem":1},{"lineBreak":true},{"text":"他们的荣耀、群众、繁华，","poem":1},{"lineBreak":true},{"text":"并快乐的人都落在其中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"卑贱人被压服；","poem":1},{"lineBreak":true},{"text":"尊贵人降为卑；","poem":1},{"lineBreak":true},{"text":"眼目高傲的人也降为卑。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"惟有万军之耶和华因公平而崇高；","poem":1},{"lineBreak":true},{"text":"圣者 神因公义显为圣。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"那时，羊羔必来吃草，如同在自己的草场；","poem":1},{"lineBreak":true},{"text":"丰肥人的荒场被游行的人吃尽。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"祸哉！那些以虚假之细绳牵罪孽的人！","poem":1},{"lineBreak":true},{"text":"他们又像以套绳拉罪恶，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"说：任他急速行，赶快成就他的作为，","poem":1},{"lineBreak":true},{"text":"使我们看看；","poem":1},{"lineBreak":true},{"text":"任以色列圣者所谋划的临近成就，","poem":1},{"lineBreak":true},{"text":"使我们知道。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"祸哉！那些称恶为善，称善为恶，","poem":1},{"lineBreak":true},{"text":"以暗为光，以光为暗，","poem":1},{"lineBreak":true},{"text":"以苦为甜，以甜为苦的人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"祸哉！那些自以为有智慧，","poem":1},{"lineBreak":true},{"text":"自看为通达的人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"祸哉！那些勇于饮酒，","poem":1},{"lineBreak":true},{"text":"以能力调浓酒的人。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他们因受贿赂，就称恶人为义，","poem":1},{"lineBreak":true},{"text":"将义人的义夺去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"火苗怎样吞灭碎秸，","poem":1},{"lineBreak":true},{"text":"干草怎样落在火焰之中，","poem":1},{"lineBreak":true},{"text":"照样，他们的根必像朽物，","poem":1},{"lineBreak":true},{"text":"他们的花必像灰尘飞腾；","poem":1},{"lineBreak":true},{"text":"因为他们厌弃万军之耶和华的训诲，","poem":1},{"lineBreak":true},{"text":"藐视以色列圣者的言语。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"所以，耶和华的怒气向他的百姓发作。","poem":1},{"lineBreak":true},{"text":"他的手伸出攻击他们，山岭就震动；","poem":1},{"lineBreak":true},{"text":"他们的尸首在街市上好像粪土。","poem":1},{"lineBreak":true},{"text":"虽然如此，他的怒气还未转消；","poem":1},{"lineBreak":true},{"text":"他的手仍伸不缩。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他必竖立大旗，招远方的国民，","poem":1},{"lineBreak":true},{"text":"发嘶声叫他们从地极而来；","poem":1},{"lineBreak":true},{"text":"看哪，他们必急速奔来。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"其中没有疲倦的，绊跌的；","poem":1},{"lineBreak":true},{"text":"没有打盹的，睡觉的；","poem":1},{"lineBreak":true},{"text":"腰带并不放松，","poem":1},{"lineBreak":true},{"text":"鞋带也不折断。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他们的箭快利，","poem":1},{"lineBreak":true},{"text":"弓也上了弦。","poem":1},{"lineBreak":true},{"text":"马蹄算如坚石，","poem":1},{"lineBreak":true},{"text":"车轮好像旋风。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他们要吼叫，像母狮子，","poem":1},{"lineBreak":true},{"text":"咆哮，像少壮狮子；","poem":1},{"lineBreak":true},{"text":"他们要咆哮抓食，","poem":1},{"lineBreak":true},{"text":"坦然叼去，无人救回。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"那日，他们要向以色列人吼叫，","poem":1},{"lineBreak":true},{"text":"像海浪匉訇；","poem":1},{"lineBreak":true},{"text":"人若望地，只见黑暗艰难，","poem":1},{"lineBreak":true},{"text":"光明在云中变为昏暗。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"-","text":"或译：倒流人血","reference":{"chapter":5,"verse":7}}]},"thisChapterLink":"/api/cmn_cu1/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}