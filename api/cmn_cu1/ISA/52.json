{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":52,"content":[{"type":"heading","content":["神要拯救耶路撒冷"]},{"type":"verse","number":1,"content":[{"text":"锡安哪，兴起！兴起！","poem":1},{"lineBreak":true},{"text":"披上你的能力！","poem":1},{"lineBreak":true},{"text":"圣城耶路撒冷啊，穿上你华美的衣服！","poem":1},{"lineBreak":true},{"text":"因为从今以后，","poem":1},{"lineBreak":true},{"text":"未受割礼、不洁净的必不再进入你中间。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，要抖下尘土！","poem":1},{"lineBreak":true},{"text":"起来坐在位上！","poem":1},{"lineBreak":true},{"text":"锡安被掳的居民","poem":1},{"noteId":53},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"要解开你颈项的锁链！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["耶和华如此说：「你们是无价被卖的，也必无银被赎。"]},{"type":"verse","number":4,"content":["主耶和华如此说：起先我的百姓下到埃及，在那里寄居，又有亚述人无故欺压他们。"]},{"type":"verse","number":5,"content":["耶和华说：我的百姓既是无价被掳去，如今我在这里做什么呢？耶和华说：辖制他们的人呼叫，我的名整天受亵渎。"]},{"type":"verse","number":6,"content":["所以，我的百姓必知道我的名；到那日他们必知道说这话的就是我。看哪，是我！」"]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"那报佳音，传平安，","poem":1},{"lineBreak":true},{"text":"报好信，传救恩的，","poem":1},{"lineBreak":true},{"text":"对锡安说：你的 神作王了！","poem":1},{"lineBreak":true},{"text":"这人的脚登山何等佳美！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"听啊，你守望之人的声音，","poem":1},{"lineBreak":true},{"text":"他们扬起声来，一同歌唱；","poem":1},{"lineBreak":true},{"text":"因为耶和华归回锡安的时候，","poem":1},{"lineBreak":true},{"text":"他们必亲眼看见。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶路撒冷的荒场啊，","poem":1},{"lineBreak":true},{"text":"要发起欢声，一同歌唱；","poem":1},{"lineBreak":true},{"text":"因为耶和华安慰了他的百姓，","poem":1},{"lineBreak":true},{"text":"救赎了耶路撒冷。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华在万国眼前露出圣臂；","poem":1},{"lineBreak":true},{"text":"地极的人都看见我们 神的救恩了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你们离开吧！离开吧！","poem":1},{"lineBreak":true},{"text":"从巴比伦出来。","poem":1},{"lineBreak":true},{"text":"不要沾不洁净的物；","poem":1},{"lineBreak":true},{"text":"要从其中出来。","poem":1},{"lineBreak":true},{"text":"你们扛抬耶和华器皿的人哪，","poem":1},{"lineBreak":true},{"text":"务要自洁。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你们出来必不致急忙，","poem":1},{"lineBreak":true},{"text":"也不致奔逃。","poem":1},{"lineBreak":true},{"text":"因为，耶和华必在你们前头行；","poem":1},{"lineBreak":true},{"text":"以色列的 神必作你们的后盾。","poem":1}]},{"type":"heading","content":["受苦的仆人"]},{"type":"verse","number":13,"content":[{"text":"我的仆人行事必有智慧","poem":1},{"noteId":54},{"text":"，","poem":1},{"lineBreak":true},{"text":"必被高举上升，","poem":1},{"lineBreak":true},{"text":"且成为至高。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"许多人因他","poem":1},{"noteId":55},{"text":"惊奇；","poem":1},{"lineBreak":true},{"text":"他的面貌比别人憔悴；","poem":1},{"lineBreak":true},{"text":"他的形容比世人枯槁。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"这样，他必洗净","poem":1},{"noteId":56},{"text":"许多国民；","poem":1},{"lineBreak":true},{"text":"君王要向他闭口。","poem":1},{"lineBreak":true},{"text":"因所未曾传与他们的，他们必看见；","poem":1},{"lineBreak":true},{"text":"未曾听见的，他们要明白。","poem":1}]}],"footnotes":[{"noteId":53,"caller":"-","text":"原文是女子","reference":{"chapter":52,"verse":2}},{"noteId":54,"caller":"-","text":"或译：行事通达","reference":{"chapter":52,"verse":13}},{"noteId":55,"caller":"-","text":"原文是你","reference":{"chapter":52,"verse":14}},{"noteId":56,"caller":"-","text":"或译：鼓动","reference":{"chapter":52,"verse":15}}]},"thisChapterLink":"/api/cmn_cu1/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}