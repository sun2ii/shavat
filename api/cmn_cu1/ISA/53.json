{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"我们所传的","poem":1},{"noteId":57},{"text":"有谁信呢？","poem":1},{"lineBreak":true},{"text":"耶和华的膀臂向谁显露呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他在耶和华面前生长如嫩芽，","poem":1},{"lineBreak":true},{"text":"像根出于干地。","poem":1},{"lineBreak":true},{"text":"他无佳形美容；","poem":1},{"lineBreak":true},{"text":"我们看见他的时候，","poem":1},{"lineBreak":true},{"text":"也无美貌使我们羡慕他。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他被藐视，被人厌弃；","poem":1},{"lineBreak":true},{"text":"多受痛苦，常经忧患。","poem":1},{"lineBreak":true},{"text":"他被藐视，","poem":1},{"lineBreak":true},{"text":"好像被人掩面不看的一样；","poem":1},{"lineBreak":true},{"text":"我们也不尊重他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他诚然担当我们的忧患，","poem":1},{"lineBreak":true},{"text":"背负我们的痛苦；","poem":1},{"lineBreak":true},{"text":"我们却以为他受责罚，","poem":1},{"lineBreak":true},{"text":"被 神击打苦待了。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"哪知他为我们的过犯受害，","poem":1},{"lineBreak":true},{"text":"为我们的罪孽压伤。","poem":1},{"lineBreak":true},{"text":"因他受的刑罚，我们得平安；","poem":1},{"lineBreak":true},{"text":"因他受的鞭伤，我们得医治。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我们都如羊走迷；","poem":1},{"lineBreak":true},{"text":"各人偏行己路；","poem":1},{"lineBreak":true},{"text":"耶和华使我们众人的罪孽都归在他身上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"他被欺压，","poem":1},{"lineBreak":true},{"text":"在受苦的时候却不开口","poem":1},{"noteId":58},{"text":"；","poem":1},{"lineBreak":true},{"text":"他像羊羔被牵到宰杀之地，","poem":1},{"lineBreak":true},{"text":"又像羊在剪毛的人手下无声，","poem":1},{"lineBreak":true},{"text":"他也是这样不开口。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因受欺压和审判，他被夺去，","poem":1},{"lineBreak":true},{"text":"至于他同世的人，谁想他受鞭打、","poem":1},{"lineBreak":true},{"text":"从活人之地被剪除，","poem":1},{"lineBreak":true},{"text":"是因我百姓的罪过呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他虽然未行强暴，","poem":1},{"lineBreak":true},{"text":"口中也没有诡诈，","poem":1},{"lineBreak":true},{"text":"人还使他与恶人同埋；","poem":1},{"lineBreak":true},{"text":"谁知死的时候与财主同葬。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和华却定意","poem":1},{"noteId":59},{"text":"将他压伤，","poem":1},{"lineBreak":true},{"text":"使他受痛苦。","poem":1},{"lineBreak":true},{"text":"耶和华以他为赎罪祭","poem":1},{"noteId":60},{"text":"。","poem":1},{"lineBreak":true},{"text":"他必看见后裔，并且延长年日。","poem":1},{"lineBreak":true},{"text":"耶和华所喜悦的事必在他手中亨通。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他必看见自己劳苦的功效，","poem":1},{"lineBreak":true},{"text":"便心满意足。","poem":1},{"lineBreak":true},{"text":"有许多人因认识我的义仆得称为义；","poem":1},{"lineBreak":true},{"text":"并且他要担当他们的罪孽。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"所以，我要使他与位大的同分，","poem":1},{"lineBreak":true},{"text":"与强盛的均分掳物。","poem":1},{"lineBreak":true},{"text":"因为他将命倾倒，以致于死；","poem":1},{"lineBreak":true},{"text":"他也被列在罪犯之中。","poem":1},{"lineBreak":true},{"text":"他却担当多人的罪，","poem":1},{"lineBreak":true},{"text":"又为罪犯代求。","poem":1}]}],"footnotes":[{"noteId":57,"caller":"-","text":"或译：所传与我们的","reference":{"chapter":53,"verse":1}},{"noteId":58,"caller":"-","text":"或译：他受欺压，却自卑不开口","reference":{"chapter":53,"verse":7}},{"noteId":59,"caller":"-","text":"或译：喜悦","reference":{"chapter":53,"verse":10}},{"noteId":60,"caller":"-","text":"或译：他献本身为赎罪祭","reference":{"chapter":53,"verse":10}}]},"thisChapterLink":"/api/cmn_cu1/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}