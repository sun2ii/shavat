{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":55,"content":[{"type":"heading","content":["神要施怜悯"]},{"type":"verse","number":1,"content":[{"text":"你们一切干渴的都当就近水来；","poem":1},{"lineBreak":true},{"text":"没有银钱的也可以来。","poem":1},{"lineBreak":true},{"text":"你们都来，买了吃；","poem":1},{"lineBreak":true},{"text":"不用银钱，不用价值，","poem":1},{"lineBreak":true},{"text":"也来买酒和奶。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们为何花钱","poem":1},{"noteId":63},{"text":"买那不足为食物的？","poem":1},{"lineBreak":true},{"text":"用劳碌得来的买那不使人饱足的呢？","poem":1},{"lineBreak":true},{"text":"你们要留意听我的话就能吃那美物，","poem":1},{"lineBreak":true},{"text":"得享肥甘，心中喜乐。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们当就近我来；","poem":1},{"lineBreak":true},{"text":"侧耳而听，就必得活。","poem":1},{"lineBreak":true},{"text":"我必与你们立永约，","poem":1},{"lineBreak":true},{"text":"就是应许大卫那可靠的恩典。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我已立他作万民的见证，","poem":1},{"lineBreak":true},{"text":"为万民的君王和司令。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你素不认识的国民，你也必召来；","poem":1},{"lineBreak":true},{"text":"素不认识你的国民也必向你奔跑，","poem":1},{"lineBreak":true},{"text":"都因耶和华—你的 神以色列的圣者，","poem":1},{"lineBreak":true},{"text":"因为他已经荣耀你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"当趁耶和华可寻找的时候寻找他，","poem":1},{"lineBreak":true},{"text":"相近的时候求告他。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"恶人当离弃自己的道路；","poem":1},{"lineBreak":true},{"text":"不义的人当除掉自己的意念。","poem":1},{"lineBreak":true},{"text":"归向耶和华，耶和华就必怜恤他；","poem":1},{"lineBreak":true},{"text":"当归向我们的 神，因为 神必广行赦免。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华说：我的意念非同你们的意念；","poem":1},{"lineBreak":true},{"text":"我的道路非同你们的道路。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"天怎样高过地，","poem":1},{"lineBreak":true},{"text":"照样，我的道路高过你们的道路；","poem":1},{"lineBreak":true},{"text":"我的意念高过你们的意念。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["雨雪从天而降，并不返回，",{"text":"却滋润地土，使地上发芽结实，","poem":1},{"lineBreak":true},{"text":"使撒种的有种，使要吃的有粮。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我口所出的话也必如此，","poem":1},{"lineBreak":true},{"text":"决不徒然返回，","poem":1},{"lineBreak":true},{"text":"却要成就我所喜悦的，","poem":1},{"lineBreak":true},{"text":"在我发他去成就","poem":1},{"noteId":64},{"text":"的事上必然亨通。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你们必欢欢喜喜而出来，","poem":1},{"lineBreak":true},{"text":"平平安安蒙引导。","poem":1},{"lineBreak":true},{"text":"大山小山必在你们面前发声歌唱；","poem":1},{"lineBreak":true},{"text":"田野的树木也都拍掌。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"松树长出，代替荆棘；","poem":1},{"lineBreak":true},{"text":"番石榴长出，代替蒺藜。","poem":1},{"lineBreak":true},{"text":"这要为耶和华留名，","poem":1},{"lineBreak":true},{"text":"作为永远的证据，不能剪除。","poem":1}]}],"footnotes":[{"noteId":63,"caller":"-","text":"原文是平银","reference":{"chapter":55,"verse":2}},{"noteId":64,"caller":"-","text":"发他去成就：或译所命定","reference":{"chapter":55,"verse":11}}]},"thisChapterLink":"/api/cmn_cu1/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}