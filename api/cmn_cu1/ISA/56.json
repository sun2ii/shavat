{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":56,"content":[{"type":"heading","content":["神的子民将包括各国的百姓"]},{"type":"verse","number":1,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"你们当守公平，行公义；","poem":1},{"lineBreak":true},{"text":"因我的救恩临近，","poem":1},{"lineBreak":true},{"text":"我的公义将要显现。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"谨守安息日而不干犯，","poem":1},{"lineBreak":true},{"text":"禁止己手而不作恶；","poem":1},{"lineBreak":true},{"text":"如此行、如此持守的人便为有福。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"与耶和华联合的外邦人不要说：","poem":1},{"lineBreak":true},{"text":"耶和华必定将我从他民中分别出来。","poem":1},{"lineBreak":true},{"text":"太监也不要说：我是枯树。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因为耶和华如此说：","poem":1},{"lineBreak":true},{"text":"那些谨守我的安息日，","poem":1},{"lineBreak":true},{"text":"拣选我所喜悦的事，","poem":1},{"lineBreak":true},{"text":"持守我约的太监，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我必使他们在我殿中，","poem":1},{"lineBreak":true},{"text":"在我墙内，有记念，有名号，","poem":1},{"lineBreak":true},{"text":"比有儿女的更美。","poem":1},{"lineBreak":true},{"text":"我必赐他们永远的名，不能剪除。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"还有那些与耶和华联合的外邦人，","poem":1},{"lineBreak":true},{"text":"要事奉他，要爱耶和华的名，","poem":1},{"lineBreak":true},{"text":"要作他的仆人—","poem":1},{"lineBreak":true},{"text":"就是凡守安息日不干犯，","poem":1},{"lineBreak":true},{"text":"又持守他","poem":1},{"noteId":65},{"text":"约的人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我必领他们到我的圣山，","poem":1},{"lineBreak":true},{"text":"使他们在祷告我的殿中喜乐。","poem":1},{"lineBreak":true},{"text":"他们的燔祭和平安祭，","poem":1},{"lineBreak":true},{"text":"在我坛上必蒙悦纳，","poem":1},{"lineBreak":true},{"text":"因我的殿必称为万民祷告的殿。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"主耶和华，","poem":1},{"lineBreak":true},{"text":"就是招聚以色列被赶散的，说：","poem":1},{"lineBreak":true},{"text":"在这被招聚的人以外，","poem":1},{"lineBreak":true},{"text":"我还要招聚别人归并他们。","poem":1}]},{"type":"heading","content":["以色列的领袖被定罪"]},{"type":"verse","number":9,"content":[{"text":"田野的诸兽都来吞吃吧！","poem":1},{"lineBreak":true},{"text":"林中的诸兽也要如此。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他看守的人是瞎眼的，","poem":1},{"lineBreak":true},{"text":"都没有知识，","poem":1},{"lineBreak":true},{"text":"都是哑巴狗，不能叫唤；","poem":1},{"lineBreak":true},{"text":"但知做梦，躺卧，贪睡，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"这些狗贪食，不知饱足。","poem":1},{"lineBreak":true},{"text":"这些牧人不能明白—","poem":1},{"lineBreak":true},{"text":"各人偏行己路，","poem":1},{"lineBreak":true},{"text":"各从各方求自己的利益。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们说：来吧！我去拿酒，","poem":1},{"lineBreak":true},{"text":"我们饱饮浓酒；","poem":1},{"lineBreak":true},{"text":"明日必和今日一样，","poem":1},{"lineBreak":true},{"text":"就是宴乐无量极大之日。","poem":1}]}],"footnotes":[{"noteId":65,"caller":"-","text":"原文是我","reference":{"chapter":56,"verse":6}}]},"thisChapterLink":"/api/cmn_cu1/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}