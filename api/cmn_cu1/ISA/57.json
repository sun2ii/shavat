{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":57,"content":[{"type":"heading","content":["以色列拜偶像被定罪"]},{"type":"verse","number":1,"content":[{"text":"义人死亡，","poem":1},{"lineBreak":true},{"text":"无人放在心上；","poem":1},{"lineBreak":true},{"text":"虔诚人被收去，","poem":1},{"lineBreak":true},{"text":"无人思念。","poem":1},{"lineBreak":true},{"text":"这义人被收去是免了将来的祸患；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他们得享","poem":1},{"noteId":66},{"text":"平安。","poem":1},{"lineBreak":true},{"text":"素行正直的，各人在坟里","poem":1},{"noteId":67},{"text":"安歇。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们这些巫婆的儿子，","poem":1},{"lineBreak":true},{"text":"奸夫和妓女的种子，","poem":1},{"lineBreak":true},{"text":"都要前来！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你们向谁戏笑？","poem":1},{"lineBreak":true},{"text":"向谁张口吐舌呢？","poem":1},{"lineBreak":true},{"text":"你们岂不是悖逆的儿女，","poem":1},{"lineBreak":true},{"text":"虚谎的种类呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你们在橡树中间，在各青翠树下欲火攻心；","poem":1},{"lineBreak":true},{"text":"在山谷间，在石穴下杀了儿女；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"在谷中光滑石头里有你的分。","poem":1},{"lineBreak":true},{"text":"这些就是你所得的分；","poem":1},{"lineBreak":true},{"text":"你也向他浇了奠祭，献了供物，","poem":1},{"lineBreak":true},{"text":"因这事我岂能容忍吗？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你在高而又高的山上安设床榻，","poem":1},{"lineBreak":true},{"text":"也上那里去献祭。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你在门后，在门框后，","poem":1},{"lineBreak":true},{"text":"立起你的纪念；","poem":1},{"lineBreak":true},{"text":"向外人赤露，又上去扩张床榻，","poem":1},{"lineBreak":true},{"text":"与他们立约；","poem":1},{"lineBreak":true},{"text":"你在那里看见他们的床就甚喜爱。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你把油带到王那里，","poem":1},{"lineBreak":true},{"text":"又多加香料，","poem":1},{"lineBreak":true},{"text":"打发使者往远方去，","poem":1},{"lineBreak":true},{"text":"自卑自贱直到阴间，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你因路远疲倦，","poem":1},{"lineBreak":true},{"text":"却不说这是枉然；","poem":1},{"lineBreak":true},{"text":"你以为有复兴之力，","poem":1},{"lineBreak":true},{"text":"所以不觉疲惫。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你怕谁？因谁恐惧？","poem":1},{"lineBreak":true},{"text":"竟说谎，不记念我，","poem":1},{"lineBreak":true},{"text":"又不将这事放在心上。","poem":1},{"lineBreak":true},{"text":"我不是许久闭口不言，","poem":1},{"lineBreak":true},{"text":"你仍不怕我吗？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我要指明你的公义；","poem":1},{"lineBreak":true},{"text":"至于你所行的都必与你无益。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你哀求的时候，","poem":1},{"lineBreak":true},{"text":"让你所聚集的拯救你吧！","poem":1},{"lineBreak":true},{"text":"风要把他们刮散，","poem":1},{"lineBreak":true},{"text":"一口气要把他们都吹去。","poem":1},{"lineBreak":true},{"text":"但那投靠我的必得地土，","poem":1},{"lineBreak":true},{"text":"必承受我的圣山为业。","poem":1}]},{"type":"heading","content":["神应许帮助和医治"]},{"type":"verse","number":14,"content":[{"text":"耶和华要说：","poem":1},{"lineBreak":true},{"text":"你们修筑修筑，预备道路，","poem":1},{"lineBreak":true},{"text":"将绊脚石从我百姓的路中除掉。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因为那至高至上、永远长存","poem":1},{"noteId":68},{"lineBreak":true},{"text":"名为圣者的如此说：","poem":1},{"lineBreak":true},{"text":"我住在至高至圣的所在，","poem":1},{"lineBreak":true},{"text":"也与心灵痛悔谦卑的人同居；","poem":1},{"lineBreak":true},{"text":"要使谦卑人的灵苏醒，","poem":1},{"lineBreak":true},{"text":"也使痛悔人的心苏醒。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我必不永远相争，也不长久发怒，","poem":1},{"lineBreak":true},{"text":"恐怕我所造的人与灵性都必发昏。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因他贪婪的罪孽，我就发怒击打他；","poem":1},{"lineBreak":true},{"text":"我向他掩面发怒，","poem":1},{"lineBreak":true},{"text":"他却仍然随心背道。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我看见他所行的道，也要医治他；","poem":1},{"lineBreak":true},{"text":"又要引导他，","poem":1},{"lineBreak":true},{"text":"使他和那一同伤心的人再得安慰。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我造就嘴唇的果子；","poem":1},{"lineBreak":true},{"text":"愿平安康泰归与远处的人，","poem":1},{"lineBreak":true},{"text":"也归与近处的人；","poem":1},{"lineBreak":true},{"text":"并且我要医治他。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"惟独恶人，好像翻腾的海，","poem":1},{"lineBreak":true},{"text":"不得平静；","poem":1},{"lineBreak":true},{"text":"其中的水常涌出污秽和淤泥来。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我的 神说：恶人必不得平安！","poem":1}]}],"footnotes":[{"noteId":66,"caller":"-","text":"原文是进入","reference":{"chapter":57,"verse":2}},{"noteId":67,"caller":"-","text":"原文是床上","reference":{"chapter":57,"verse":2}},{"noteId":68,"caller":"-","text":"原文是住在永远","reference":{"chapter":57,"verse":15}}]},"thisChapterLink":"/api/cmn_cu1/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}