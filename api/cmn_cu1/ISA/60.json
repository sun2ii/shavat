{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":60,"content":[{"type":"heading","content":["耶路撒冷未来的荣耀"]},{"type":"verse","number":1,"content":[{"text":"兴起，发光！因为你的光已经来到！","poem":1},{"lineBreak":true},{"text":"耶和华的荣耀发现照耀你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"看哪，黑暗遮盖大地，","poem":1},{"lineBreak":true},{"text":"幽暗遮盖万民，","poem":1},{"lineBreak":true},{"text":"耶和华却要显现照耀你；","poem":1},{"lineBreak":true},{"text":"他的荣耀要现在你身上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"万国要来就你的光；","poem":1},{"lineBreak":true},{"text":"君王要来就你发现的光辉。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"你举目向四方观看；","poem":1},{"lineBreak":true},{"text":"众人都聚集来到你这里。","poem":1},{"lineBreak":true},{"text":"你的众子从远方而来；","poem":1},{"lineBreak":true},{"text":"你的众女也被怀抱而来。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"那时，你看见就有光荣；","poem":1},{"lineBreak":true},{"text":"你心又跳动又宽畅；","poem":1},{"lineBreak":true},{"text":"因为大海丰盛的货物必转来归你；","poem":1},{"lineBreak":true},{"text":"列国的财宝也必来归你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"成群的骆驼，","poem":1},{"lineBreak":true},{"text":"并米甸和以法的独峰驼必遮满你；","poem":1},{"lineBreak":true},{"text":"示巴的众人都必来到；","poem":1},{"lineBreak":true},{"text":"要奉上黄金乳香，","poem":1},{"lineBreak":true},{"text":"又要传说耶和华的赞美。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"基达的羊群都必聚集到你这里，","poem":1},{"lineBreak":true},{"text":"尼拜约的公羊要供你使用，","poem":1},{"lineBreak":true},{"text":"在我坛上必蒙悦纳；","poem":1},{"lineBreak":true},{"text":"我必荣耀我荣耀的殿。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"那些飞来如云、","poem":1},{"lineBreak":true},{"text":"又如鸽子向窗户飞回的是谁呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"众海岛必等候我，","poem":1},{"lineBreak":true},{"text":"首先是他施的船只，","poem":1},{"lineBreak":true},{"text":"将你的众子连他们的金银从远方一同带来，","poem":1},{"lineBreak":true},{"text":"都为耶和华—你 神的名，","poem":1},{"lineBreak":true},{"text":"又为以色列的圣者，","poem":1},{"lineBreak":true},{"text":"因为他已经荣耀了你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"外邦人必建筑你的城墙；","poem":1},{"lineBreak":true},{"text":"他们的王必服事你。","poem":1},{"lineBreak":true},{"text":"我曾发怒击打你，","poem":1},{"lineBreak":true},{"text":"现今却施恩怜恤你。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你的城门必时常开放，","poem":1},{"lineBreak":true},{"text":"昼夜不关；","poem":1},{"lineBreak":true},{"text":"使人把列国的财物带来归你，","poem":1},{"lineBreak":true},{"text":"并将他们的君王牵引而来。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"哪一邦哪一国不事奉你，就必灭亡，","poem":1},{"lineBreak":true},{"text":"也必全然荒废。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"黎巴嫩的荣耀，","poem":1},{"lineBreak":true},{"text":"就是松树、杉树、黄杨树，","poem":1},{"lineBreak":true},{"text":"都必一同归你，","poem":1},{"lineBreak":true},{"text":"为要修饰我圣所之地；","poem":1},{"lineBreak":true},{"text":"我也要使我脚踏之处得荣耀。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"素来苦待你的，他的子孙都必屈身来就你；","poem":1},{"lineBreak":true},{"text":"藐视你的，都要在你脚下跪拜。","poem":1},{"lineBreak":true},{"text":"他们要称你为「耶和华的城」，","poem":1},{"lineBreak":true},{"text":"为「以色列圣者的锡安」。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"你虽然被撇弃被厌恶，","poem":1},{"lineBreak":true},{"text":"甚至无人经过，","poem":1},{"lineBreak":true},{"text":"我却使你变为永远的荣华，","poem":1},{"lineBreak":true},{"text":"成为累代的喜乐。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你也必吃万国的奶，","poem":1},{"lineBreak":true},{"text":"又吃君王的奶。","poem":1},{"lineBreak":true},{"text":"你便知道我—耶和华是你的救主，","poem":1},{"lineBreak":true},{"text":"是你的救赎主，雅各的大能者。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"我要拿金子代替铜，","poem":1},{"lineBreak":true},{"text":"拿银子代替铁，","poem":1},{"lineBreak":true},{"text":"拿铜代替木头，","poem":1},{"lineBreak":true},{"text":"拿铁代替石头；","poem":1},{"lineBreak":true},{"text":"并要以和平为你的官长，","poem":1},{"lineBreak":true},{"text":"以公义为你的监督。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你地上不再听见强暴的事，","poem":1},{"lineBreak":true},{"text":"境内不再听见荒凉毁灭的事。","poem":1},{"lineBreak":true},{"text":"你必称你的墙为「拯救」，","poem":1},{"lineBreak":true},{"text":"称你的门为「赞美」。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"日头不再作你白昼的光；","poem":1},{"lineBreak":true},{"text":"月亮也不再发光照耀你。","poem":1},{"lineBreak":true},{"text":"耶和华却要作你永远的光；","poem":1},{"lineBreak":true},{"text":"你 神要为你的荣耀。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你的日头不再下落；","poem":1},{"lineBreak":true},{"text":"你的月亮也不退缩；","poem":1},{"lineBreak":true},{"text":"因为耶和华必作你永远的光。","poem":1},{"lineBreak":true},{"text":"你悲哀的日子也完毕了。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你的居民都成为义人，","poem":1},{"lineBreak":true},{"text":"永远得地为业；","poem":1},{"lineBreak":true},{"text":"是我种的栽子，我手的工作，","poem":1},{"lineBreak":true},{"text":"使我得荣耀。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"至小的族要加增千倍；","poem":1},{"lineBreak":true},{"text":"微弱的国必成为强盛。","poem":1},{"lineBreak":true},{"text":"我—耶和华要按定期速成这事。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}