{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":61,"content":[{"type":"heading","content":["拯救的好消息"]},{"type":"verse","number":1,"content":[{"text":"主耶和华的灵在我身上；","poem":1},{"lineBreak":true},{"text":"因为耶和华用膏膏我，","poem":1},{"lineBreak":true},{"text":"叫我传好信息给谦卑的人","poem":1},{"noteId":71},{"text":"，","poem":1},{"lineBreak":true},{"text":"差遣我医好伤心的人，","poem":1},{"lineBreak":true},{"text":"报告被掳的得释放，","poem":1},{"lineBreak":true},{"text":"被囚的出监牢；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"报告耶和华的恩年，","poem":1},{"lineBreak":true},{"text":"和我们 神报仇的日子；","poem":1},{"lineBreak":true},{"text":"安慰一切悲哀的人，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"赐华冠与锡安悲哀的人，代替灰尘；","poem":1},{"lineBreak":true},{"text":"喜乐油代替悲哀；","poem":1},{"lineBreak":true},{"text":"赞美衣代替忧伤之灵；","poem":1},{"lineBreak":true},{"text":"使他们称为「公义树」，","poem":1},{"lineBreak":true},{"text":"是耶和华所栽的，叫他得荣耀。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们必修造已久的荒场，","poem":1},{"lineBreak":true},{"text":"建立先前凄凉之处，","poem":1},{"lineBreak":true},{"text":"重修历代荒凉之城。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"那时，外人必起来牧放你们的羊群；","poem":1},{"lineBreak":true},{"text":"外邦人必作你们耕种田地的，","poem":1},{"lineBreak":true},{"text":"修理葡萄园的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你们倒要称为耶和华的祭司；","poem":1},{"lineBreak":true},{"text":"人必称你们为我们 神的仆役。","poem":1},{"lineBreak":true},{"text":"你们必吃用列国的财物，","poem":1},{"lineBreak":true},{"text":"因得他们的荣耀自夸。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你们必得加倍的好处，代替所受的羞辱；","poem":1},{"lineBreak":true},{"text":"分中所得的喜乐，必代替所受的凌辱。","poem":1},{"lineBreak":true},{"text":"在境内必得加倍的产业；","poem":1},{"lineBreak":true},{"text":"永远之乐必归与你们","poem":1},{"noteId":72},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"因为我—耶和华喜爱公平，","poem":1},{"lineBreak":true},{"text":"恨恶抢夺和罪孽；","poem":1},{"lineBreak":true},{"text":"我要凭诚实施行报应，","poem":1},{"lineBreak":true},{"text":"并要与我的百姓立永约。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们的后裔必在列国中被人认识；","poem":1},{"lineBreak":true},{"text":"他们的子孙在众民中也是如此。","poem":1},{"lineBreak":true},{"text":"凡看见他们的必认他们是耶和华赐福的后裔。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"我因耶和华大大欢喜；","poem":1},{"lineBreak":true},{"text":"我的心靠 神快乐。","poem":1},{"lineBreak":true},{"text":"因他以拯救为衣给我穿上，","poem":1},{"lineBreak":true},{"text":"以公义为袍给我披上，","poem":1},{"lineBreak":true},{"text":"好像新郎戴上华冠，","poem":1},{"lineBreak":true},{"text":"又像新妇佩戴妆饰。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"田地怎样使百谷发芽，","poem":1},{"lineBreak":true},{"text":"园子怎样使所种的发生，","poem":1},{"lineBreak":true},{"text":"主耶和华必照样","poem":1},{"lineBreak":true},{"text":"使公义和赞美在万民中发出。","poem":1}]}],"footnotes":[{"noteId":71,"caller":"-","text":"或译：传福音给贫穷的人","reference":{"chapter":61,"verse":1}},{"noteId":72,"caller":"-","text":"原文是他们","reference":{"chapter":61,"verse":7}}]},"thisChapterLink":"/api/cmn_cu1/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}