{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":62,"content":[{"type":"verse","number":1,"content":[{"text":"我因锡安必不静默，","poem":1},{"lineBreak":true},{"text":"为耶路撒冷必不息声，","poem":1},{"lineBreak":true},{"text":"直到他的公义如光辉发出，","poem":1},{"lineBreak":true},{"text":"他的救恩如明灯发亮。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"列国必见你的公义；","poem":1},{"lineBreak":true},{"text":"列王必见你的荣耀。","poem":1},{"lineBreak":true},{"text":"你必得新名的称呼，","poem":1},{"lineBreak":true},{"text":"是耶和华亲口所起的。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你在耶和华的手中要作为华冠，","poem":1},{"lineBreak":true},{"text":"在你 神的掌上必作为冕旒。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你必不再称为「撇弃的」；","poem":1},{"lineBreak":true},{"text":"你的地也不再称为「荒凉的」。","poem":1},{"lineBreak":true},{"text":"你却要称为「我所喜悦的」；","poem":1},{"lineBreak":true},{"text":"你的地也必称为「有夫之妇」。","poem":1},{"lineBreak":true},{"text":"因为耶和华喜悦你，","poem":1},{"lineBreak":true},{"text":"你的地也必归他。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"少年人怎样娶处女，","poem":1},{"lineBreak":true},{"text":"你的众民","poem":1},{"noteId":73},{"text":"也要照样娶你；","poem":1},{"lineBreak":true},{"text":"新郎怎样喜悦新妇，","poem":1},{"lineBreak":true},{"text":"你的 神也要照样喜悦你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶路撒冷啊，","poem":1},{"lineBreak":true},{"text":"我在你城上设立守望的，","poem":1},{"lineBreak":true},{"text":"他们昼夜必不静默。","poem":1},{"lineBreak":true},{"text":"呼吁耶和华的，你们不要歇息，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"也不要使他歇息，","poem":1},{"lineBreak":true},{"text":"直等他建立耶路撒冷，","poem":1},{"lineBreak":true},{"text":"使耶路撒冷在地上成为可赞美的。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华指着自己的右手和大能的膀臂起誓说：","poem":1},{"lineBreak":true},{"text":"我必不再将你的五谷给你仇敌作食物；","poem":1},{"lineBreak":true},{"text":"外邦人也不再喝你劳碌得来的新酒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"惟有那收割的要吃，并赞美耶和华；","poem":1},{"lineBreak":true},{"text":"那聚敛的要在我圣所的院内喝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你们当从门经过经过，","poem":1},{"lineBreak":true},{"text":"预备百姓的路；","poem":1},{"lineBreak":true},{"text":"修筑修筑大道，","poem":1},{"lineBreak":true},{"text":"捡去石头，","poem":1},{"lineBreak":true},{"text":"为万民竖立大旗，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"看哪，耶和华曾宣告到地极，","poem":1},{"lineBreak":true},{"text":"对锡安的居民","poem":1},{"noteId":74},{"text":"说：","poem":1},{"lineBreak":true},{"text":"你的拯救者来到。","poem":1},{"lineBreak":true},{"text":"他的赏赐在他那里；","poem":1},{"lineBreak":true},{"text":"他的报应在他面前。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"人必称他们为「圣民」，为「耶和华的赎民」；","poem":1},{"lineBreak":true},{"text":"你也必称为「被眷顾、不撇弃的城」。","poem":1}]}],"footnotes":[{"noteId":73,"caller":"-","text":"民：原文是子","reference":{"chapter":62,"verse":5}},{"noteId":74,"caller":"-","text":"原文是女子","reference":{"chapter":62,"verse":11}}]},"thisChapterLink":"/api/cmn_cu1/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}