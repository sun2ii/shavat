{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"愿你裂天而降；","poem":1},{"lineBreak":true},{"text":"愿山在你面前震动—","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"好像火烧干柴，","poem":1},{"lineBreak":true},{"text":"又像火将水烧开，","poem":1},{"lineBreak":true},{"text":"使你敌人知道你的名，","poem":1},{"lineBreak":true},{"text":"使列国在你面前发颤！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你曾行我们不能逆料可畏的事。","poem":1},{"lineBreak":true},{"text":"那时你降临，山岭在你面前震动。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"从古以来，人未曾听见、未曾耳闻、未曾眼见","poem":1},{"lineBreak":true},{"text":"在你以外有什么神为等候他的人行事。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你迎接那欢喜行义、记念你道的人；","poem":1},{"lineBreak":true},{"text":"你曾发怒，我们仍犯罪；","poem":1},{"lineBreak":true},{"text":"这景况已久，我们还能得救吗？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我们都像不洁净的人；","poem":1},{"lineBreak":true},{"text":"所有的义都像污秽的衣服。","poem":1},{"lineBreak":true},{"text":"我们都像叶子渐渐枯干；","poem":1},{"lineBreak":true},{"text":"我们的罪孽好像风把我们吹去。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"并且无人求告你的名；","poem":1},{"lineBreak":true},{"text":"无人奋力抓住你。","poem":1},{"lineBreak":true},{"text":"原来你掩面不顾我们，","poem":1},{"lineBreak":true},{"text":"使我们因罪孽消化。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华啊，现在你仍是我们的父！","poem":1},{"lineBreak":true},{"text":"我们是泥，你是窑匠；","poem":1},{"lineBreak":true},{"text":"我们都是你手的工作。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华啊，求你不要大发震怒，","poem":1},{"lineBreak":true},{"text":"也不要永远记念罪孽。","poem":1},{"lineBreak":true},{"text":"求你垂顾我们，","poem":1},{"lineBreak":true},{"text":"我们都是你的百姓。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你的圣邑变为旷野。","poem":1},{"lineBreak":true},{"text":"锡安变为旷野；","poem":1},{"lineBreak":true},{"text":"耶路撒冷成为荒场。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我们圣洁华美的殿—","poem":1},{"lineBreak":true},{"text":"就是我们列祖赞美你的所在被火焚烧；","poem":1},{"lineBreak":true},{"text":"我们所羡慕的美地尽都荒废。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华啊，有这些事，你还忍得住吗？","poem":1},{"lineBreak":true},{"text":"你仍静默使我们深受苦难吗？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}