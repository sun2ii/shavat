{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cu1","name":"以赛亚书","commonName":"以赛亚书","title":"以赛亚书","order":23,"numberOfChapters":66,"sha256":"041bfa209c1bd8138686a87c00c5325476bd6721f47866508098b9a4f8ea9feb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cu1/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":65,"content":[{"type":"heading","content":["神对悖逆者的惩罚"]},{"type":"verse","number":1,"content":[{"text":"素来没有访问我的，现在求问我；","poem":1},{"lineBreak":true},{"text":"没有寻找我的，我叫他们遇见；","poem":1},{"lineBreak":true},{"text":"没有称为我名下的，我对他们说：","poem":1},{"lineBreak":true},{"text":"我在这里！我在这里！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我整天伸手招呼那悖逆的百姓；","poem":1},{"lineBreak":true},{"text":"他们随自己的意念行不善之道。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"这百姓时常当面惹我发怒；","poem":1},{"lineBreak":true},{"text":"在园中献祭，","poem":1},{"lineBreak":true},{"text":"在坛","poem":1},{"noteId":76},{"text":"上烧香；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"在坟墓间坐着，","poem":1},{"lineBreak":true},{"text":"在隐密处住宿，","poem":1},{"lineBreak":true},{"text":"吃猪肉；","poem":1},{"lineBreak":true},{"text":"他们器皿中有可憎之物做的汤；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"且对人说：你站开吧！","poem":1},{"lineBreak":true},{"text":"不要挨近我，因为我比你圣洁。","poem":1},{"lineBreak":true},{"text":"主说：这些人是我鼻中的烟，","poem":1},{"lineBreak":true},{"text":"是整天烧着的火。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"看哪，这都写在我面前。","poem":1},{"lineBreak":true},{"text":"我必不静默，必施行报应，","poem":1},{"lineBreak":true},{"text":"必将你们的罪孽和你们列祖的罪孽，","poem":1},{"lineBreak":true},{"text":"就是在山上烧香，","poem":1},{"lineBreak":true},{"text":"在冈上亵渎我的罪孽，","poem":1},{"lineBreak":true},{"text":"一同报应在他们后人怀中，","poem":1},{"lineBreak":true},{"text":"我先要把他们所行的量给他们；","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华如此说：葡萄中寻得新酒，","poem":1},{"lineBreak":true},{"text":"人就说：不要毁坏，","poem":1},{"lineBreak":true},{"text":"因为福在其中。","poem":1},{"lineBreak":true},{"text":"我因我仆人的缘故也必照样而行，","poem":1},{"lineBreak":true},{"text":"不将他们全然毁灭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我必从雅各中领出后裔，","poem":1},{"lineBreak":true},{"text":"从犹大中领出承受我众山的。","poem":1},{"lineBreak":true},{"text":"我的选民必承受；","poem":1},{"lineBreak":true},{"text":"我的仆人要在那里居住。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"沙 平原必成为羊群的圈；","poem":1},{"lineBreak":true},{"text":"亚割谷必成为牛群躺卧之处，","poem":1},{"lineBreak":true},{"text":"都为寻求我的民所得。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"但你们这些离弃耶和华、","poem":1},{"lineBreak":true},{"text":"忘记我的圣山、给时运摆筵席","poem":1},{"noteId":77},{"text":"、","poem":1},{"lineBreak":true},{"text":"给天命盛满调和酒的，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我要命定你们归在刀下，","poem":1},{"lineBreak":true},{"text":"都必屈身被杀；","poem":1},{"lineBreak":true},{"text":"因为我呼唤，你们没有答应；","poem":1},{"lineBreak":true},{"text":"我说话，你们没有听从；","poem":1},{"lineBreak":true},{"text":"反倒行我眼中看为恶的，","poem":1},{"lineBreak":true},{"text":"拣选我所不喜悦的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"所以，主耶和华如此说：","poem":1},{"lineBreak":true},{"text":"我的仆人必得吃，你们却饥饿；","poem":1},{"lineBreak":true},{"text":"我的仆人必得喝，你们却干渴；","poem":1},{"lineBreak":true},{"text":"我的仆人必欢喜，你们却蒙羞。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我的仆人因心中高兴欢呼，","poem":1},{"lineBreak":true},{"text":"你们却因心中忧愁哀哭，","poem":1},{"lineBreak":true},{"text":"又因心里忧伤哀号。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你们必留下自己的名，","poem":1},{"lineBreak":true},{"text":"为我选民指着赌咒。","poem":1},{"lineBreak":true},{"text":"主耶和华必杀你们，","poem":1},{"lineBreak":true},{"text":"另起别名称呼他的仆人。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"这样，在地上为自己求福的，","poem":1},{"lineBreak":true},{"text":"必凭真实的 神求福；","poem":1},{"lineBreak":true},{"text":"在地上起誓的，","poem":1},{"lineBreak":true},{"text":"必指真实的 神起誓。","poem":1},{"lineBreak":true},{"text":"因为，从前的患难已经忘记，","poem":1},{"lineBreak":true},{"text":"也从我眼前隐藏了。","poem":1}]},{"type":"heading","content":["新天新地"]},{"type":"verse","number":17,"content":[{"text":"看哪！我造新天新地；","poem":1},{"lineBreak":true},{"text":"从前的事不再被记念，也不再追想。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你们当因我所造的永远欢喜快乐；","poem":1},{"lineBreak":true},{"text":"因我造耶路撒冷为人所喜，","poem":1},{"lineBreak":true},{"text":"造其中的居民为人所乐。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我必因耶路撒冷欢喜，","poem":1},{"lineBreak":true},{"text":"因我的百姓快乐；","poem":1},{"lineBreak":true},{"text":"其中必不再听见哭泣的声音和哀号的声音。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"其中必没有数日夭亡的婴孩，","poem":1},{"lineBreak":true},{"text":"也没有寿数不满的老者；","poem":1},{"lineBreak":true},{"text":"因为百岁死的仍算孩童，","poem":1},{"lineBreak":true},{"text":"有百岁死的罪人算被咒诅。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们要建造房屋，自己居住；","poem":1},{"lineBreak":true},{"text":"栽种葡萄园，吃其中的果子。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他们建造的，别人不得住；","poem":1},{"lineBreak":true},{"text":"他们栽种的，别人不得吃；","poem":1},{"lineBreak":true},{"text":"因为我民的日子必像树木的日子；","poem":1},{"lineBreak":true},{"text":"我选民亲手劳碌得来的必长久享用。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他们必不徒然劳碌，","poem":1},{"lineBreak":true},{"text":"所生产的，也不遭灾害，","poem":1},{"lineBreak":true},{"text":"因为都是蒙耶和华赐福的后裔；","poem":1},{"lineBreak":true},{"text":"他们的子孙也是如此。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他们尚未求告，我就应允；","poem":1},{"lineBreak":true},{"text":"正说话的时候，我就垂听。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"豺狼必与羊羔同食；","poem":1},{"lineBreak":true},{"text":"狮子必吃草与牛一样；","poem":1},{"lineBreak":true},{"text":"尘土必作蛇的食物。","poem":1},{"lineBreak":true},{"text":"在我圣山的遍处，","poem":1},{"lineBreak":true},{"text":"这一切都不伤人，不害物。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]}],"footnotes":[{"noteId":76,"caller":"-","text":"原文是砖","reference":{"chapter":65,"verse":3}},{"noteId":77,"caller":"-","text":"原文是桌子","reference":{"chapter":65,"verse":11}}]},"thisChapterLink":"/api/cmn_cu1/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":24}