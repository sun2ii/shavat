{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JDG","translationId":"cmn_cu1","name":"士师记","commonName":"士师记","title":"士师记","order":7,"numberOfChapters":21,"sha256":"de9d04b664d21d890bf6473ff6252458b988c85e6cc9ad776d235156dfad6dec","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/cmn_cu1/JDG/21.json","totalNumberOfVerses":617},"chapter":{"number":5,"content":[{"type":"heading","content":["底波拉和巴拉的歌"]},{"type":"verse","number":1,"content":["那时，底波拉和亚比挪庵的儿子巴拉作歌，说："]},{"type":"verse","number":2,"content":[{"text":"因为以色列中有军长率领，","poem":1},{"lineBreak":true},{"text":"百姓也甘心牺牲自己，","poem":1},{"lineBreak":true},{"text":"你们应当颂赞耶和华！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"君王啊，要听！","poem":1},{"lineBreak":true},{"text":"王子啊，要侧耳而听！","poem":1},{"lineBreak":true},{"text":"我要向耶和华歌唱；","poem":1},{"lineBreak":true},{"text":"我要歌颂耶和华—以色列的 神。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华啊，你从西珥出来，","poem":1},{"lineBreak":true},{"text":"由以东地行走。","poem":1},{"lineBreak":true},{"text":"那时地震天漏，","poem":1},{"lineBreak":true},{"text":"云也落雨。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"山见耶和华的面就震动，","poem":1},{"lineBreak":true},{"text":"西奈山见耶和华—以色列 神的面也是如此。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"在亚拿之子珊迦的时候，","poem":1},{"lineBreak":true},{"text":"又在雅亿的日子，","poem":1},{"lineBreak":true},{"text":"大道无人行走，","poem":1},{"lineBreak":true},{"text":"都是绕道而行。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"以色列中的官长停职，","poem":1},{"lineBreak":true},{"text":"直到我底波拉兴起，","poem":1},{"lineBreak":true},{"text":"等我兴起作以色列的母。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"以色列人选择新神，","poem":1},{"lineBreak":true},{"text":"争战的事就临到城门。","poem":1},{"lineBreak":true},{"text":"那时，以色列四万人中","poem":1},{"lineBreak":true},{"text":"岂能见盾牌枪矛呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我心倾向以色列的首领，","poem":1},{"lineBreak":true},{"text":"他们在民中甘心牺牲自己。","poem":1},{"lineBreak":true},{"text":"你们应当颂赞耶和华！","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"骑白驴的、坐绣花毯子的、行路的，","poem":1},{"lineBreak":true},{"text":"你们都当传扬！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"在远离弓箭响声打水之处，","poem":1},{"lineBreak":true},{"text":"人必述说耶和华公义的作为，","poem":1},{"lineBreak":true},{"text":"就是他治理以色列公义的作为。","poem":1},{"lineBreak":true},{"text":"那时耶和华的民下到城门。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"底波拉啊，兴起！兴起！","poem":1},{"lineBreak":true},{"text":"你当兴起，兴起，唱歌。","poem":1},{"lineBreak":true},{"text":"亚比挪庵的儿子巴拉啊，你当奋兴，","poem":1},{"lineBreak":true},{"text":"掳掠你的敌人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"那时有余剩的贵胄和百姓一同下来；","poem":1},{"lineBreak":true},{"text":"耶和华降临，为我攻击勇士。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"有根本在亚玛力人的地，","poem":1},{"lineBreak":true},{"text":"从以法莲下来的；","poem":1},{"lineBreak":true},{"text":"便雅悯在民中跟随你。","poem":1},{"lineBreak":true},{"text":"有掌权的从玛吉下来；","poem":1},{"lineBreak":true},{"text":"有持杖检点民数的从西布伦下来；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"以萨迦的首领与底波拉同来；","poem":1},{"lineBreak":true},{"text":"以萨迦怎样，巴拉也怎样。","poem":1},{"lineBreak":true},{"text":"众人都跟随巴拉冲下平原；","poem":1},{"lineBreak":true},{"text":"在吕便的溪水旁有心中定大志的。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你为何坐在羊圈内","poem":1},{"lineBreak":true},{"text":"听群中吹笛的声音呢？","poem":1},{"lineBreak":true},{"text":"在吕便的溪水旁有心中设大谋的。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"基列人安居在约旦河外。","poem":1},{"lineBreak":true},{"text":"但人为何等在船上？","poem":1},{"lineBreak":true},{"text":"亚设人在海口静坐，","poem":1},{"lineBreak":true},{"text":"在港口安居。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"西布伦人是拚命敢死的；","poem":1},{"lineBreak":true},{"text":"拿弗他利人在田野的高处也是如此。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"君王都来争战。","poem":1},{"lineBreak":true},{"text":"那时迦南诸王在米吉多水旁的他纳争战，","poem":1},{"lineBreak":true},{"text":"却未得掳掠银钱。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"星宿从天上争战，","poem":1},{"lineBreak":true},{"text":"从其轨道攻击西西拉。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"基顺古河把敌人冲没；","poem":1},{"lineBreak":true},{"text":"我的灵啊，应当努力前行。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"那时壮马驰驱，","poem":1},{"lineBreak":true},{"text":"踢跳，奔腾。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"耶和华的使者说：","poem":1},{"lineBreak":true},{"text":"应当咒诅米罗斯，","poem":1},{"lineBreak":true},{"text":"大大咒诅其中的居民；","poem":1},{"lineBreak":true},{"text":"因为他们不来帮助耶和华，","poem":1},{"lineBreak":true},{"text":"不来帮助耶和华攻击勇士。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"愿基尼人希百的妻雅亿比众妇人多得福气，","poem":1},{"lineBreak":true},{"text":"比住帐棚的妇人更蒙福祉。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"西西拉求水，","poem":1},{"lineBreak":true},{"text":"雅亿给他奶子，","poem":1},{"lineBreak":true},{"text":"用宝贵的盘子给他奶油。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"雅亿左手拿着帐棚的橛子，","poem":1},{"lineBreak":true},{"text":"右手拿着匠人的锤子，","poem":1},{"lineBreak":true},{"text":"击打西西拉，","poem":1},{"lineBreak":true},{"text":"打伤他的头，","poem":1},{"lineBreak":true},{"text":"把他的鬓角打破穿通。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"西西拉在她脚前曲身仆倒，","poem":1},{"lineBreak":true},{"text":"在她脚前曲身倒卧；","poem":1},{"lineBreak":true},{"text":"在那里曲身，就在那里死亡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"西西拉的母亲从窗户里往外观看，","poem":1},{"lineBreak":true},{"text":"从窗棂中呼叫说：","poem":1},{"lineBreak":true},{"text":"他的战车为何耽延不来呢？","poem":1},{"lineBreak":true},{"text":"他的车轮为何行得慢呢？","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"聪明的宫女安慰她","poem":1},{"noteId":3},{"text":"，","poem":1},{"lineBreak":true},{"text":"她也自言自语地说：","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他们莫非得财而分？","poem":1},{"lineBreak":true},{"text":"每人得了一两个女子？","poem":1},{"lineBreak":true},{"text":"西西拉得了彩衣为掳物，","poem":1},{"lineBreak":true},{"text":"得绣花的彩衣为掠物。","poem":1},{"lineBreak":true},{"text":"这彩衣两面绣花，","poem":1},{"lineBreak":true},{"text":"乃是披在被掳之人颈项上的。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"愿你的仇敌都这样灭亡！","poem":1},{"lineBreak":true},{"text":"愿爱你的人如日头出现，光辉烈烈！","poem":1},{"lineBreak":true},{"text":"这样，国中太平四十年。","poem":1}]}],"footnotes":[{"noteId":3,"caller":"-","text":"原文是回答她","reference":{"chapter":5,"verse":29}}]},"thisChapterLink":"/api/cmn_cu1/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}