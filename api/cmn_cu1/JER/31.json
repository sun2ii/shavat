{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JER","translationId":"cmn_cu1","name":"耶利米书","commonName":"耶利米书","title":"耶利米书","order":24,"numberOfChapters":52,"sha256":"16ded5dc4e2ddb729010e3886586b1a875952506b8d309b0047c2ac2b798eef4","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cmn_cu1/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":31,"content":[{"type":"heading","content":["以色列人还乡"]},{"type":"verse","number":1,"content":["耶和华说：「那时，我必作以色列各家的 神；他们必作我的子民。」"]},{"type":"verse","number":2,"content":["耶和华如此说：",{"text":"脱离刀剑的就是以色列人。","poem":1},{"lineBreak":true},{"text":"我使他享安息的时候，","poem":1},{"lineBreak":true},{"text":"他曾在旷野蒙恩。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"古时","poem":1},{"noteId":33},{"text":"耶和华向以色列","poem":1},{"noteId":34},{"text":"显现，说：","poem":1},{"lineBreak":true},{"text":"我以永远的爱爱你，","poem":1},{"lineBreak":true},{"text":"因此我以慈爱吸引你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"以色列的民","poem":1},{"noteId":35},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"我要再建立你，你就被建立；","poem":1},{"lineBreak":true},{"text":"你必再以击鼓为美，","poem":1},{"lineBreak":true},{"text":"与欢乐的人一同跳舞而出；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"又必在撒马利亚的山上栽种葡萄园，","poem":1},{"lineBreak":true},{"text":"栽种的人要享用所结的果子。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"日子必到，以法莲山上守望的人必呼叫说：","poem":1},{"lineBreak":true},{"text":"起来吧！我们可以上锡安，","poem":1},{"lineBreak":true},{"text":"到耶和华—我们的 神那里去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"你们当为雅各欢乐歌唱，","poem":1},{"lineBreak":true},{"text":"因万国中为首的欢呼。","poem":1},{"lineBreak":true},{"text":"当传扬颂赞说：","poem":1},{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你拯救你的百姓以色列所剩下的人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我必将他们从北方领来，","poem":1},{"lineBreak":true},{"text":"从地极招聚；","poem":1},{"lineBreak":true},{"text":"同着他们来的有瞎子、瘸子、孕妇、产妇；","poem":1},{"lineBreak":true},{"text":"他们必成为大帮回到这里来。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们要哭泣而来。","poem":1},{"lineBreak":true},{"text":"我要照他们恳求的引导他们，","poem":1},{"lineBreak":true},{"text":"使他们在河水旁走正直的路，","poem":1},{"lineBreak":true},{"text":"在其上不致绊跌；","poem":1},{"lineBreak":true},{"text":"因为我是以色列的父，","poem":1},{"lineBreak":true},{"text":"以法莲是我的长子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"列国啊，要听耶和华的话，","poem":1},{"lineBreak":true},{"text":"传扬在远处的海岛说：","poem":1},{"lineBreak":true},{"text":"赶散以色列的必招聚他，","poem":1},{"lineBreak":true},{"text":"又看守他，好像牧人看守羊群。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因耶和华救赎了雅各，","poem":1},{"lineBreak":true},{"text":"救赎他脱离比他更强之人的手。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们要来到锡安的高处歌唱，","poem":1},{"lineBreak":true},{"text":"又流归耶和华施恩之地，","poem":1},{"lineBreak":true},{"text":"就是有五谷、新酒，和油，","poem":1},{"lineBreak":true},{"text":"并羊羔、牛犊之地。","poem":1},{"lineBreak":true},{"text":"他们的心必像浇灌的园子；","poem":1},{"lineBreak":true},{"text":"他们也不再有一点愁烦。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"那时，处女必欢乐跳舞；","poem":1},{"lineBreak":true},{"text":"年少的、年老的，也必一同欢乐；","poem":1},{"lineBreak":true},{"text":"因为我要使他们的悲哀变为欢喜，","poem":1},{"lineBreak":true},{"text":"并要安慰他们，使他们的愁烦转为快乐。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我必以肥油使祭司的心满足；","poem":1},{"lineBreak":true},{"text":"我的百姓也要因我的恩惠知足。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"heading","content":["耶和华怜悯以色列"]},{"type":"verse","number":15,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"在拉玛听见号咷痛哭的声音，","poem":1},{"lineBreak":true},{"text":"是拉结哭她儿女，不肯受安慰，","poem":1},{"lineBreak":true},{"text":"因为他们都不在了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"你禁止声音不要哀哭，","poem":1},{"lineBreak":true},{"text":"禁止眼目不要流泪，","poem":1},{"lineBreak":true},{"text":"因你所做之工必有赏赐；","poem":1},{"lineBreak":true},{"text":"他们必从敌国归回。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和华说：你末后必有指望；","poem":1},{"lineBreak":true},{"text":"你的儿女必回到自己的境界。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我听见以法莲为自己悲叹说：","poem":1},{"lineBreak":true},{"text":"你责罚我，我便受责罚，","poem":1},{"lineBreak":true},{"text":"像不惯负轭的牛犊一样。","poem":1},{"lineBreak":true},{"text":"求你使我回转，我便回转，","poem":1},{"lineBreak":true},{"text":"因为你是耶和华—我的 神。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我回转以后就真正懊悔；","poem":1},{"lineBreak":true},{"text":"受教以后就拍腿叹息；","poem":1},{"lineBreak":true},{"text":"我因担当幼年的凌辱就抱愧蒙羞。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和华说：以法莲是我的爱子吗？","poem":1},{"lineBreak":true},{"text":"是可喜悦的孩子吗？","poem":1},{"lineBreak":true},{"text":"我每逢责备他，仍深顾念他；","poem":1},{"lineBreak":true},{"text":"所以我的心肠恋慕他；","poem":1},{"lineBreak":true},{"text":"我必要怜悯他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"以色列民","poem":1},{"noteId":36},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"你当为自己设立指路碑，","poem":1},{"lineBreak":true},{"text":"竖起引路柱。","poem":1},{"lineBreak":true},{"text":"你要留心向大路，","poem":1},{"lineBreak":true},{"text":"就是你所去的原路；","poem":1},{"lineBreak":true},{"text":"你当回转，回转到你这些城邑。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"背道的民","poem":1},{"noteId":37},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"你反来复去要到几时呢？","poem":1},{"lineBreak":true},{"text":"耶和华在地上造了一件新事，","poem":1},{"lineBreak":true},{"text":"就是女子护卫男子。","poem":1}]},{"type":"heading","content":["神子民的光明前途"]},{"type":"verse","number":23,"content":["万军之耶和华—以色列的 神如此说：「我使被掳之人归回的时候，他们在犹大地和其中的城邑必再这样说：",{"text":"公义的居所啊，","poem":1},{"lineBreak":true},{"text":"圣山哪，愿耶和华赐福给你。","poem":1}]},{"type":"verse","number":24,"content":["犹大和属犹大城邑的人，农夫和放羊的人，要一同住在其中。"]},{"type":"verse","number":25,"content":["疲乏的人，我使他饱饫；愁烦的人，我使他知足。」"]},{"type":"verse","number":26,"content":["先知说：「我醒了，觉着睡得香甜！」"]},{"type":"verse","number":27,"content":["耶和华说：「日子将到，我要把人的种和牲畜的种播种在以色列家和犹大家。"]},{"type":"verse","number":28,"content":["我先前怎样留意将他们拔出、拆毁、毁坏、倾覆、苦害，也必照样留意将他们建立、栽植。这是耶和华说的。"]},{"type":"verse","number":29,"content":["当那些日子，人不再说：",{"text":"父亲吃了酸葡萄，","poem":1},{"lineBreak":true},{"text":"儿子的牙酸倒了。","poem":1}]},{"type":"verse","number":30,"content":["但各人必因自己的罪死亡；凡吃酸葡萄的，自己的牙必酸倒。」"]},{"type":"verse","number":31,"content":["耶和华说：「日子将到，我要与以色列家和犹大家另立新约，"]},{"type":"verse","number":32,"content":["不像我拉着他们祖宗的手，领他们出埃及地的时候，与他们所立的约。我虽作他们的丈夫，他们却背了我的约。这是耶和华说的。」"]},{"type":"verse","number":33,"content":["耶和华说：「那些日子以后，我与以色列家所立的约乃是这样：我要将我的律法放在他们里面，写在他们心上。我要作他们的 神，他们要作我的子民。"]},{"type":"verse","number":34,"content":["他们各人不再教导自己的邻舍和自己的弟兄说：『你该认识耶和华』，因为他们从最小的到至大的都必认识我。我要赦免他们的罪孽，不再记念他们的罪恶。这是耶和华说的。」"]},{"type":"verse","number":35,"content":[{"text":"那使太阳白日发光，","poem":1},{"lineBreak":true},{"text":"使星月有定例，黑夜发亮，","poem":1},{"lineBreak":true},{"text":"又搅动大海，使海中波浪匉訇的，","poem":1},{"lineBreak":true},{"text":"万军之耶和华是他的名。","poem":1},{"lineBreak":true},{"text":"他如此说：","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"这些定例若能在我面前废掉，","poem":1},{"lineBreak":true},{"text":"以色列的后裔也就在我面前断绝，","poem":1},{"lineBreak":true},{"text":"永远不再成国。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":["耶和华如此说：",{"text":"若能量度上天，","poem":1},{"lineBreak":true},{"text":"寻察下地的根基，","poem":1},{"lineBreak":true},{"text":"我就因以色列后裔一切所行的弃绝他们。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"verse","number":38,"content":["耶和华说：「日子将到，这城必为耶和华建造，从哈楠业楼直到角门。"]},{"type":"verse","number":39,"content":["准绳要往外量出，直到迦立山，又转到歌亚。"]},{"type":"verse","number":40,"content":["抛尸的全谷和倒灰之处，并一切田地，直到汲沦溪，又直到东方马门的拐角，都要归耶和华为圣，不再拔出，不再倾覆，直到永远。」"]}],"footnotes":[{"noteId":33,"caller":"-","text":"或译：从远方","reference":{"chapter":31,"verse":3}},{"noteId":34,"caller":"-","text":"原文是我","reference":{"chapter":31,"verse":3}},{"noteId":35,"caller":"-","text":"原文是处女","reference":{"chapter":31,"verse":4}},{"noteId":36,"caller":"-","text":"原文是处女","reference":{"chapter":31,"verse":21}},{"noteId":37,"caller":"-","text":"原文是女子","reference":{"chapter":31,"verse":22}}]},"thisChapterLink":"/api/cmn_cu1/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}