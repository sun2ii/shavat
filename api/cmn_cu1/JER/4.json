{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JER","translationId":"cmn_cu1","name":"耶利米书","commonName":"耶利米书","title":"耶利米书","order":24,"numberOfChapters":52,"sha256":"16ded5dc4e2ddb729010e3886586b1a875952506b8d309b0047c2ac2b798eef4","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cmn_cu1/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":4,"content":[{"type":"heading","content":["呼召以色列悔改"]},{"type":"verse","number":1,"content":[{"text":"耶和华说：以色列啊，","poem":1},{"lineBreak":true},{"text":"你若回来归向我，","poem":1},{"lineBreak":true},{"text":"若从我眼前除掉你可憎的偶像，","poem":1},{"lineBreak":true},{"text":"你就不被迁移。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你必凭诚实、公平、公义，","poem":1},{"lineBreak":true},{"text":"指着永生的耶和华起誓；","poem":1},{"lineBreak":true},{"text":"列国必因耶和华称自己为有福，","poem":1},{"lineBreak":true},{"text":"也必因他夸耀。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华对犹大和耶路撒冷人如此说：","poem":1},{"lineBreak":true},{"text":"要开垦你们的荒地，","poem":1},{"lineBreak":true},{"text":"不要撒种在荆棘中。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"犹大人和耶路撒冷的居民哪，","poem":1},{"lineBreak":true},{"text":"你们当自行割礼，归耶和华，","poem":1},{"lineBreak":true},{"text":"将心里的污秽除掉；","poem":1},{"lineBreak":true},{"text":"恐怕我的忿怒因你们的恶行发作，","poem":1},{"lineBreak":true},{"text":"如火着起，","poem":1},{"lineBreak":true},{"text":"甚至无人能以熄灭！","poem":1}]},{"type":"heading","content":["外患威胁犹大"]},{"type":"verse","number":5,"content":[{"text":"你们当传扬在犹大，","poem":1},{"lineBreak":true},{"text":"宣告在耶路撒冷说：","poem":1},{"lineBreak":true},{"text":"你们当在国中吹角，高声呼叫说：","poem":1},{"lineBreak":true},{"text":"你们当聚集！","poem":1},{"lineBreak":true},{"text":"我们好进入坚固城！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"应当向锡安竖立大旗。","poem":1},{"lineBreak":true},{"text":"要逃避，不要迟延，","poem":1},{"lineBreak":true},{"text":"因我必使灾祸与大毁灭从北方来到。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"有狮子从密林中上来，","poem":1},{"lineBreak":true},{"text":"是毁坏列国的。","poem":1},{"lineBreak":true},{"text":"它已经动身出离本处，","poem":1},{"lineBreak":true},{"text":"要使你的地荒凉，","poem":1},{"lineBreak":true},{"text":"使你的城邑变为荒场无人居住。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因此，你们当腰束麻布，大声哀号，","poem":1},{"lineBreak":true},{"text":"因为耶和华的烈怒没有向我们转消。","poem":1}]},{"type":"verse","number":9,"content":["耶和华说：「到那时，君王和首领的心都要消灭；祭司都要惊奇，先知都要诧异。」"]},{"type":"verse","number":10,"content":["我说：「哀哉！主耶和华啊，你真是大大地欺哄这百姓和耶路撒冷，说：『你们必得平安。』其实刀剑害及性命了。」"]},{"type":"verse","number":11,"content":["那时，必有话对这百姓和耶路撒冷说：「有一阵热风从旷野净光的高处向我的众民",{"noteId":4},"刮来，不是为簸扬，也不是为扬净。"]},{"type":"verse","number":12,"content":["必有一阵更大的风从这些地方为我刮来；现在我又必发出判语，攻击他们。」"]},{"type":"heading","content":["犹大被敌人围困"]},{"type":"verse","number":13,"content":[{"text":"看哪，仇敌必如云上来；","poem":1},{"lineBreak":true},{"text":"他的战车如旋风，","poem":1},{"lineBreak":true},{"text":"他的马匹比鹰更快。","poem":1},{"lineBreak":true},{"text":"我们有祸了！","poem":1},{"lineBreak":true},{"text":"我们败落了！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，你当洗去心中的恶，","poem":1},{"lineBreak":true},{"text":"使你可以得救。","poem":1},{"lineBreak":true},{"text":"恶念存在你心里要到几时呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"有声音从但传扬，","poem":1},{"lineBreak":true},{"text":"从以法莲山报祸患。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你们当传给列国，","poem":1},{"lineBreak":true},{"text":"报告攻击耶路撒冷的事说：","poem":1},{"lineBreak":true},{"text":"有探望的人从远方来到，","poem":1},{"lineBreak":true},{"text":"向犹大的城邑大声呐喊。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他们周围攻击耶路撒冷，","poem":1},{"lineBreak":true},{"text":"好像看守田园的，","poem":1},{"lineBreak":true},{"text":"因为她背叛了我。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你的行动，你的作为，招惹这事；","poem":1},{"lineBreak":true},{"text":"这是你罪恶的结果，","poem":1},{"lineBreak":true},{"text":"实在是苦，","poem":1},{"lineBreak":true},{"text":"是害及你心了！","poem":1}]},{"type":"heading","content":["耶利米为同胞担忧"]},{"type":"verse","number":19,"content":[{"text":"我的肺腑啊，我的肺腑啊，我心疼痛！","poem":1},{"lineBreak":true},{"text":"我心在我里面烦躁不安。","poem":1},{"lineBreak":true},{"text":"我不能静默不言，","poem":1},{"lineBreak":true},{"text":"因为我已经听见角声和打仗的喊声。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"毁坏的信息连络不绝，","poem":1},{"lineBreak":true},{"text":"因为全地荒废。","poem":1},{"lineBreak":true},{"text":"我的帐棚忽然毁坏；","poem":1},{"lineBreak":true},{"text":"我的幔子顷刻破裂。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我看见大旗，听见角声，","poem":1},{"lineBreak":true},{"text":"要到几时呢？","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和华说：我的百姓愚顽，不认识我；","poem":1},{"lineBreak":true},{"text":"他们是愚昧无知的儿女，","poem":1},{"lineBreak":true},{"text":"有智慧行恶，没有知识行善。","poem":1}]},{"type":"heading","content":["耶利米的异象—将要来临的毁灭"]},{"type":"verse","number":23,"content":[{"text":"先知说：我观看地，","poem":1},{"lineBreak":true},{"text":"不料，地是空虚混沌；","poem":1},{"lineBreak":true},{"text":"我观看天，天也无光。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我观看大山，不料，尽都震动，","poem":1},{"lineBreak":true},{"text":"小山也都摇来摇去。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我观看，不料，无人；","poem":1},{"lineBreak":true},{"text":"空中的飞鸟也都躲避。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我观看，不料，肥田变为荒地；","poem":1},{"lineBreak":true},{"text":"一切城邑在耶和华面前，","poem":1},{"lineBreak":true},{"text":"因他的烈怒都被拆毁。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"耶和华如此说：全地必然荒凉，","poem":1},{"lineBreak":true},{"text":"我却不毁灭净尽。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"因此，地要悲哀，","poem":1},{"lineBreak":true},{"text":"在上的天也必黑暗；","poem":1},{"lineBreak":true},{"text":"因为我言已出，我意已定，","poem":1},{"lineBreak":true},{"text":"必不后悔，也不转意不做。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"各城的人因马兵和弓箭手的响声就都逃跑，","poem":1},{"lineBreak":true},{"text":"进入密林，爬上磐石；","poem":1},{"lineBreak":true},{"text":"各城被撇下，","poem":1},{"lineBreak":true},{"text":"无人住在其中。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"你凄凉的时候要怎样行呢？","poem":1},{"lineBreak":true},{"text":"你虽穿上朱红衣服，","poem":1},{"lineBreak":true},{"text":"佩戴黄金装饰，","poem":1},{"lineBreak":true},{"text":"用颜料修饰眼目，","poem":1},{"lineBreak":true},{"text":"这样标致是枉然的！","poem":1},{"lineBreak":true},{"text":"恋爱你的藐视你，","poem":1},{"lineBreak":true},{"text":"并且寻索你的性命。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"我听见有声音，仿佛妇人产难的声音，","poem":1},{"lineBreak":true},{"text":"好像生头胎疼痛的声音，","poem":1},{"lineBreak":true},{"text":"是锡安女子","poem":1},{"noteId":5},{"text":"的声音；","poem":1},{"lineBreak":true},{"text":"她喘着气、挓挲手，","poem":1},{"lineBreak":true},{"text":"说：我有祸了！","poem":1},{"lineBreak":true},{"text":"在杀人的跟前，我的心发昏了。","poem":1}]}],"footnotes":[{"noteId":4,"caller":"-","text":"原文是民女","reference":{"chapter":4,"verse":11}},{"noteId":5,"caller":"-","text":"就是指民的意思","reference":{"chapter":4,"verse":31}}]},"thisChapterLink":"/api/cmn_cu1/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}