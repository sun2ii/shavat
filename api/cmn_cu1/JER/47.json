{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JER","translationId":"cmn_cu1","name":"耶利米书","commonName":"耶利米书","title":"耶利米书","order":24,"numberOfChapters":52,"sha256":"16ded5dc4e2ddb729010e3886586b1a875952506b8d309b0047c2ac2b798eef4","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cmn_cu1/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":47,"content":[{"type":"heading","content":["有关非利士的话"]},{"type":"verse","number":1,"content":["法老攻击迦萨之先，有耶和华论非利士人的话临到先知耶利米。"]},{"type":"verse","number":2,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"有水从北方发起，成为涨溢的河，","poem":1},{"lineBreak":true},{"text":"要涨过遍地和其中所有的，","poem":1},{"lineBreak":true},{"text":"并城和其中所住的。","poem":1},{"lineBreak":true},{"text":"人必呼喊；","poem":1},{"lineBreak":true},{"text":"境内的居民都必哀号。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"听见敌人壮马蹄跳的响声","poem":1},{"lineBreak":true},{"text":"和战车隆隆、车轮轰轰；","poem":1},{"lineBreak":true},{"text":"为父的手就发软，","poem":1},{"lineBreak":true},{"text":"不回头看顾儿女。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因为日子将到，","poem":1},{"lineBreak":true},{"text":"要毁灭一切非利士人，","poem":1},{"lineBreak":true},{"text":"剪除帮助泰尔、西顿所剩下的人。","poem":1},{"lineBreak":true},{"text":"原来耶和华必毁灭非利士人，","poem":1},{"lineBreak":true},{"text":"就是迦斐托海岛余剩的人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"迦萨成了光秃；","poem":1},{"lineBreak":true},{"text":"平原中所剩的亚实基伦归于无有。","poem":1},{"lineBreak":true},{"text":"你用刀划身，要到几时呢？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华的刀剑哪，你到几时才止息呢？","poem":1},{"lineBreak":true},{"text":"你要入鞘，安靖不动。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华既吩咐你攻击亚实基伦和海边之地，","poem":1},{"lineBreak":true},{"text":"他已经派定你，焉能止息呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}