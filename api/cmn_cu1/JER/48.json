{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JER","translationId":"cmn_cu1","name":"耶利米书","commonName":"耶利米书","title":"耶利米书","order":24,"numberOfChapters":52,"sha256":"16ded5dc4e2ddb729010e3886586b1a875952506b8d309b0047c2ac2b798eef4","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cmn_cu1/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":48,"content":[{"type":"heading","content":["摩押的毁灭"]},{"type":"verse","number":1,"content":["论摩押。万军之耶和华—以色列的 神如此说：",{"text":"尼波有祸了！因变为荒场。","poem":1},{"lineBreak":true},{"text":"基列亭蒙羞被攻取；","poem":1},{"lineBreak":true},{"text":"米斯迦蒙羞被毁坏；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"摩押不再被称赞。","poem":1},{"lineBreak":true},{"text":"有人在希实本设计谋害她，说：","poem":1},{"lineBreak":true},{"text":"来吧！我们将她剪除，不再成国。","poem":1},{"lineBreak":true},{"text":"玛得缅哪，你也必默默无声；","poem":1},{"lineBreak":true},{"text":"刀剑必追赶你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"从何罗念有喊荒凉大毁灭的哀声：","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"摩押毁灭了！","poem":1},{"lineBreak":true},{"text":"她的孩童","poem":1},{"noteId":57},{"text":"发哀声，使人听见。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"人上鲁希坡随走随哭，","poem":1},{"lineBreak":true},{"text":"因为在何罗念的下坡听见毁灭的哀声。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你们要奔逃，自救性命，","poem":1},{"lineBreak":true},{"text":"独自居住，好像旷野的杜松。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你因倚靠自己所做的和自己的财宝必被攻取。","poem":1},{"lineBreak":true},{"text":"基抹和属他的祭司、首领也要一同被掳去。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"行毁灭的必来到各城，","poem":1},{"lineBreak":true},{"text":"并无一城得免。","poem":1},{"lineBreak":true},{"text":"山谷必致败落，","poem":1},{"lineBreak":true},{"text":"平原必被毁坏；","poem":1},{"lineBreak":true},{"text":"正如耶和华所说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"要将翅膀给摩押，","poem":1},{"lineBreak":true},{"text":"使她可以飞去。","poem":1},{"lineBreak":true},{"text":"她的城邑必致荒凉，","poem":1},{"lineBreak":true},{"text":"无人居住。","poem":1},"（"]},{"type":"verse","number":10,"content":["懒惰为耶和华行事的，必受咒诅；禁止刀剑不经血的，必受咒诅。）"]},{"type":"heading","content":["摩押的城镇被毁灭"]},{"type":"verse","number":11,"content":[{"text":"摩押自幼年以来常享安逸，","poem":1},{"lineBreak":true},{"text":"如酒在渣滓上澄清，","poem":1},{"lineBreak":true},{"text":"没有从这器皿倒在那器皿里，","poem":1},{"lineBreak":true},{"text":"也未曾被掳去。","poem":1},{"lineBreak":true},{"text":"因此，它的原味尚存，","poem":1},{"lineBreak":true},{"text":"香气未变。","poem":1}]},{"type":"verse","number":12,"content":["耶和华说：「日子将到，我必打发倒酒的往她那里去，将她倒出来，倒空她的器皿，打碎她的坛子。"]},{"type":"verse","number":13,"content":["摩押必因基抹羞愧，像以色列家从前倚靠伯特利的神羞愧一样。"]},{"type":"verse","number":14,"content":[{"text":"你们怎么说：","poem":1},{"lineBreak":true},{"text":"我们是勇士，是有勇力打仗的呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"摩押变为荒场，","poem":1},{"lineBreak":true},{"text":"敌人上去进了她的城邑。","poem":1},{"lineBreak":true},{"text":"她所特选的少年人下去遭了杀戮；","poem":1},{"lineBreak":true},{"text":"这是君王—名为万军之耶和华说的。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"摩押的灾殃临近；","poem":1},{"lineBreak":true},{"text":"她的苦难速速来到。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"凡在她四围的和认识她名的，","poem":1},{"lineBreak":true},{"text":"你们都要为她悲伤，说：","poem":1},{"lineBreak":true},{"text":"那结实的杖和那美好的棍，","poem":1},{"lineBreak":true},{"text":"何竟折断了呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"住在底本的民哪","poem":1},{"noteId":58},{"text":"，","poem":1},{"lineBreak":true},{"text":"要从你荣耀的位上下来，","poem":1},{"lineBreak":true},{"text":"坐受干渴；","poem":1},{"lineBreak":true},{"text":"因毁灭摩押的上来攻击你，","poem":1},{"lineBreak":true},{"text":"毁坏了你的保障。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"住亚罗珥的啊，","poem":1},{"lineBreak":true},{"text":"要站在道旁观望，","poem":1},{"lineBreak":true},{"text":"问逃避的男人和逃脱的女人说：","poem":1},{"lineBreak":true},{"text":"是什么事呢？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"摩押因毁坏蒙羞；","poem":1},{"lineBreak":true},{"text":"你们要哀号呼喊，","poem":1},{"lineBreak":true},{"text":"要在亚嫩旁报告说：","poem":1},{"lineBreak":true},{"text":"摩押变为荒场！","poem":1}]},{"type":"verse","number":21,"content":["「刑罚临到平原之地的何伦、雅杂、米法押、"]},{"type":"verse","number":22,"content":["底本、尼波、伯·低比拉太音、"]},{"type":"verse","number":23,"content":["基列亭、伯·迦末、伯·米恩、"]},{"type":"verse","number":24,"content":["加略、波斯拉，和摩押地远近所有的城邑。"]},{"type":"verse","number":25,"content":["摩押的角砍断了，摩押的膀臂折断了。这是耶和华说的。」"]},{"type":"heading","content":["摩押要受凌辱"]},{"type":"verse","number":26,"content":["「你们要使摩押沉醉，因她向耶和华夸大。她要在自己所吐之中打滚，又要被人嗤笑。"]},{"type":"verse","number":27,"content":["摩押啊，你不曾嗤笑以色列吗？她岂是在贼中查出来的呢？你每逢提到她便摇头。"]},{"type":"verse","number":28,"content":[{"text":"摩押的居民哪，","poem":1},{"lineBreak":true},{"text":"要离开城邑，住在山崖里，","poem":1},{"lineBreak":true},{"text":"像鸽子在深渊口上搭窝。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我们听说摩押人骄傲，","poem":1},{"lineBreak":true},{"text":"是极其骄傲；","poem":1},{"lineBreak":true},{"text":"听说他自高自傲，","poem":1},{"lineBreak":true},{"text":"并且狂妄，居心自大。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"我知道他的忿怒是虚空的；","poem":1},{"lineBreak":true},{"text":"他夸大的话一无所成。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"因此，我要为摩押哀号，","poem":1},{"lineBreak":true},{"text":"为摩押全地呼喊；","poem":1},{"lineBreak":true},{"text":"人必为吉珥·哈列设人叹息。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"西比玛的葡萄树啊，我为你哀哭，","poem":1},{"lineBreak":true},{"text":"甚于雅谢人哀哭。","poem":1},{"lineBreak":true},{"text":"你的枝子蔓延过海，","poem":1},{"lineBreak":true},{"text":"直长到雅谢海。","poem":1},{"lineBreak":true},{"text":"那行毁灭的已经临到你夏天的果子","poem":1},{"lineBreak":true},{"text":"和你所摘的葡萄。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"肥田和摩押地的欢喜快乐都被夺去；","poem":1},{"lineBreak":true},{"text":"我使酒榨的酒绝流，","poem":1},{"lineBreak":true},{"text":"无人踹酒欢呼；","poem":1},{"lineBreak":true},{"text":"那欢呼却变为仇敌的呐喊","poem":1},{"noteId":59},{"text":"。","poem":1}]},{"type":"verse","number":34,"content":["「希实本人发的哀声达到以利亚利，直达到雅杂；从琐珥达到何罗念，直到伊基拉·施利施亚，因为宁林的水必然干涸。」"]},{"type":"verse","number":35,"content":["耶和华说：「我必在摩押地使那在邱坛献祭的，和那向他的神烧香的都断绝了。"]},{"type":"verse","number":36,"content":["我心腹为摩押哀鸣如箫，我心肠为吉珥·哈列设人也是如此，因摩押人所得的财物都灭没了。"]},{"type":"verse","number":37,"content":["「各人头上光秃，胡须剪短，手有划伤，腰束麻布。"]},{"type":"verse","number":38,"content":["在摩押的各房顶上和街市上处处有人哀哭；因我打碎摩押，好像打碎无人喜悦的器皿。这是耶和华说的。"]},{"type":"verse","number":39,"content":["摩押何等毁坏！何等哀号！何等羞愧转背！这样，摩押必令四围的人嗤笑惊骇。」"]},{"type":"heading","content":["摩押无路可逃"]},{"type":"verse","number":40,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"仇敌必如大鹰飞起，","poem":1},{"lineBreak":true},{"text":"展开翅膀，攻击摩押。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"加略被攻取，保障也被占据。","poem":1},{"lineBreak":true},{"text":"到那日，摩押的勇士心中疼痛如临产的妇人。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"摩押必被毁灭，不再成国，","poem":1},{"lineBreak":true},{"text":"因她向耶和华夸大。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"耶和华说：摩押的居民哪，","poem":1},{"lineBreak":true},{"text":"恐惧、陷坑、网罗都临近你。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"躲避恐惧的必坠入陷坑；","poem":1},{"lineBreak":true},{"text":"从陷坑上来的必被网罗缠住；","poem":1},{"lineBreak":true},{"text":"因我必使追讨之年临到摩押。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"躲避的人无力站在希实本的影下；","poem":1},{"lineBreak":true},{"text":"因为有火从希实本发出，","poem":1},{"lineBreak":true},{"text":"有火焰出于西宏的城，","poem":1},{"lineBreak":true},{"text":"烧尽摩押的角和哄嚷人的头顶。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"摩押啊，你有祸了！","poem":1},{"lineBreak":true},{"text":"属基抹的民灭亡了！","poem":1},{"lineBreak":true},{"text":"因你的众子都被掳去，","poem":1},{"lineBreak":true},{"text":"你的众女也被掳去。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"到末后，我还要使被掳的摩押人归回。","poem":1},{"lineBreak":true},{"text":"摩押受审判的话到此为止。","poem":1}]}],"footnotes":[{"noteId":57,"caller":"-","text":"或译：家僮","reference":{"chapter":48,"verse":4}},{"noteId":58,"caller":"-","text":"原文是女子","reference":{"chapter":48,"verse":18}},{"noteId":59,"caller":"-","text":"原文是那欢呼却不是欢呼","reference":{"chapter":48,"verse":33}}]},"thisChapterLink":"/api/cmn_cu1/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}