{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JER","translationId":"cmn_cu1","name":"耶利米书","commonName":"耶利米书","title":"耶利米书","order":24,"numberOfChapters":52,"sha256":"16ded5dc4e2ddb729010e3886586b1a875952506b8d309b0047c2ac2b798eef4","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cmn_cu1/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":6,"content":[{"type":"heading","content":["耶路撒冷受敌人围攻"]},{"type":"verse","number":1,"content":[{"text":"便雅悯人哪，你们要逃出耶路撒冷，","poem":1},{"lineBreak":true},{"text":"在提哥亚吹角，","poem":1},{"lineBreak":true},{"text":"在伯·哈基琳立号旗；","poem":1},{"lineBreak":true},{"text":"因为有灾祸与大毁灭从北方张望。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"那秀美娇嫩的锡安女子","poem":1},{"noteId":8},{"text":"，","poem":1},{"lineBreak":true},{"text":"我必剪除。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"牧人必引他们的羊群到她那里，","poem":1},{"lineBreak":true},{"text":"在她周围支搭帐棚，","poem":1},{"lineBreak":true},{"text":"各在自己所占之地使羊吃草。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你们要准备攻击她。","poem":1},{"lineBreak":true},{"text":"起来吧，我们可以趁午时上去。","poem":1},{"lineBreak":true},{"text":"哀哉！日已渐斜，","poem":1},{"lineBreak":true},{"text":"晚影拖长了。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"起来吧，我们夜间上去，","poem":1},{"lineBreak":true},{"text":"毁坏她的宫殿。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"因为万军之耶和华如此说：","poem":1},{"lineBreak":true},{"text":"你们要砍伐树木，","poem":1},{"lineBreak":true},{"text":"筑垒攻打耶路撒冷。","poem":1},{"lineBreak":true},{"text":"这就是那该罚的城，","poem":1},{"lineBreak":true},{"text":"其中尽是欺压。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"井怎样涌出水来，","poem":1},{"lineBreak":true},{"text":"这城也照样涌出恶来；","poem":1},{"lineBreak":true},{"text":"在其间常听见有强暴毁灭的事，","poem":1},{"lineBreak":true},{"text":"病患损伤也常在我面前。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，你当受教，","poem":1},{"lineBreak":true},{"text":"免得我心与你生疏，","poem":1},{"lineBreak":true},{"text":"免得我使你荒凉，","poem":1},{"lineBreak":true},{"text":"成为无人居住之地。","poem":1}]},{"type":"heading","content":["叛逆的以色列"]},{"type":"verse","number":9,"content":[{"text":"万军之耶和华曾如此说：","poem":1},{"lineBreak":true},{"text":"敌人必掳尽以色列剩下的民，","poem":1},{"lineBreak":true},{"text":"如同摘净葡萄一样。","poem":1},{"lineBreak":true},{"text":"你要像摘葡萄的人摘了又摘，回手放在筐子里。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"现在我可以向谁说话作见证，使他们听呢？","poem":1},{"lineBreak":true},{"text":"他们的耳朵未受割礼，不能听见。","poem":1},{"lineBreak":true},{"text":"看哪，耶和华的话他们以为羞辱，","poem":1},{"lineBreak":true},{"text":"不以为喜悦。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因此我被耶和华的忿怒充满，难以含忍。","poem":1},{"lineBreak":true},{"text":"我要倾在街中的孩童和聚会的少年人身上，","poem":1},{"lineBreak":true},{"text":"连夫带妻，","poem":1},{"lineBreak":true},{"text":"并年老的与日子满足的都必被擒拿。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们的房屋、田地，","poem":1},{"lineBreak":true},{"text":"和妻子都必转归别人；","poem":1},{"lineBreak":true},{"text":"我要伸手攻击这地的居民。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因为他们从最小的到至大的都一味地贪婪，","poem":1},{"lineBreak":true},{"text":"从先知到祭司都行事虚谎。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们轻轻忽忽地医治我百姓的损伤，","poem":1},{"lineBreak":true},{"text":"说：平安了！平安了！","poem":1},{"lineBreak":true},{"text":"其实没有平安。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他们行可憎的事知道惭愧吗？","poem":1},{"lineBreak":true},{"text":"不然，他们毫不惭愧，","poem":1},{"lineBreak":true},{"text":"也不知羞耻。","poem":1},{"lineBreak":true},{"text":"因此，他们必在仆倒的人中仆倒；","poem":1},{"lineBreak":true},{"text":"我向他们讨罪的时候，","poem":1},{"lineBreak":true},{"text":"他们必致跌倒。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"heading","content":["以色列拒绝 神的道路"]},{"type":"verse","number":16,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"你们当站在路上察看，","poem":1},{"lineBreak":true},{"text":"访问古道，","poem":1},{"lineBreak":true},{"text":"哪是善道，便行在其间；","poem":1},{"lineBreak":true},{"text":"这样，你们心里必得安息。","poem":1},{"lineBreak":true},{"text":"他们却说：我们不行在其间。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我设立守望的人照管你们，","poem":1},{"lineBreak":true},{"text":"说：要听角声。","poem":1},{"lineBreak":true},{"text":"他们却说：我们不听。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"列国啊，因此你们当听！","poem":1},{"lineBreak":true},{"text":"会众啊，要知道他们必遭遇的事。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"地啊，当听！","poem":1},{"lineBreak":true},{"text":"我必使灾祸临到这百姓，","poem":1},{"lineBreak":true},{"text":"就是他们意念所结的果子；","poem":1},{"lineBreak":true},{"text":"因为他们不听从我的言语，","poem":1},{"lineBreak":true},{"text":"至于我的训诲","poem":1},{"noteId":9},{"text":"，他们也厌弃了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"从示巴出的乳香，","poem":1},{"lineBreak":true},{"text":"从远方出的菖蒲","poem":1},{"noteId":10},{"lineBreak":true},{"text":"奉来给我有何益呢？","poem":1},{"lineBreak":true},{"text":"你们的燔祭不蒙悦纳；","poem":1},{"lineBreak":true},{"text":"你们的平安祭，我也不喜悦。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"所以耶和华如此说：","poem":1},{"lineBreak":true},{"text":"我要将绊脚石放在这百姓前面。","poem":1},{"lineBreak":true},{"text":"父亲和儿子要一同跌在其上；","poem":1},{"lineBreak":true},{"text":"邻舍与朋友也都灭亡。","poem":1}]},{"type":"heading","content":["北方来的侵略者"]},{"type":"verse","number":22,"content":[{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"看哪，有一种民从北方而来，","poem":1},{"lineBreak":true},{"text":"并有一大国被激动，从地极来到。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他们拿弓和枪，","poem":1},{"lineBreak":true},{"text":"性情残忍，不施怜悯；","poem":1},{"lineBreak":true},{"text":"他们的声音像海浪匉訇。","poem":1},{"lineBreak":true},{"text":"锡安城","poem":1},{"noteId":11},{"text":"啊，","poem":1},{"lineBreak":true},{"text":"他们骑马都摆队伍，","poem":1},{"lineBreak":true},{"text":"如上战场的人要攻击你。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我们听见他们的风声，手就发软；","poem":1},{"lineBreak":true},{"text":"痛苦将我们抓住，","poem":1},{"lineBreak":true},{"text":"疼痛仿佛产难的妇人。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你们不要往田野去，","poem":1},{"lineBreak":true},{"text":"也不要行在路上，","poem":1},{"lineBreak":true},{"text":"因四围有仇敌的刀剑和惊吓。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我民","poem":1},{"noteId":12},{"text":"哪，应当腰束麻布，滚在灰中。","poem":1},{"lineBreak":true},{"text":"你要悲伤，如丧独生子痛痛哭号，","poem":1},{"lineBreak":true},{"text":"因为灭命的要忽然临到我们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"我使你在我民中为高台","poem":1},{"noteId":13},{"text":"，为保障，","poem":1},{"lineBreak":true},{"text":"使你知道试验他们的行动。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他们都是极悖逆的，","poem":1},{"lineBreak":true},{"text":"往来谗谤人。","poem":1},{"lineBreak":true},{"text":"他们是铜是铁，","poem":1},{"lineBreak":true},{"text":"都行坏事。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"风箱吹火，铅被烧毁；","poem":1},{"lineBreak":true},{"text":"他们炼而又炼，终是徒然；","poem":1},{"lineBreak":true},{"text":"因为恶劣的还未除掉。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"人必称他们为被弃的银渣，","poem":1},{"lineBreak":true},{"text":"因为耶和华已经弃掉他们。","poem":1}]}],"footnotes":[{"noteId":8,"caller":"-","text":"就是指民的意思","reference":{"chapter":6,"verse":2}},{"noteId":9,"caller":"-","text":"或译：律法","reference":{"chapter":6,"verse":19}},{"noteId":10,"caller":"-","text":"或译：甘蔗","reference":{"chapter":6,"verse":20}},{"noteId":11,"caller":"-","text":"原文是女子","reference":{"chapter":6,"verse":23}},{"noteId":12,"caller":"-","text":"原文是民女","reference":{"chapter":6,"verse":26}},{"noteId":13,"caller":"-","text":"或译：试验人的","reference":{"chapter":6,"verse":27}}]},"thisChapterLink":"/api/cmn_cu1/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}