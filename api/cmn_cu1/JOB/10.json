{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"我厌烦我的性命，","poem":1},{"lineBreak":true},{"text":"必由着自己述说我的哀情；","poem":1},{"lineBreak":true},{"text":"因心里苦恼，我要说话，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"对 神说：不要定我有罪，","poem":1},{"lineBreak":true},{"text":"要指示我，你为何与我争辩？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你手所造的，","poem":1},{"lineBreak":true},{"text":"你又欺压，又藐视，","poem":1},{"lineBreak":true},{"text":"却光照恶人的计谋。","poem":1},{"lineBreak":true},{"text":"这事你以为美吗？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的眼岂是肉眼？","poem":1},{"lineBreak":true},{"text":"你查看岂像人查看吗？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的日子岂像人的日子，","poem":1},{"lineBreak":true},{"text":"你的年岁岂像人的年岁，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"就追问我的罪孽，","poem":1},{"lineBreak":true},{"text":"寻察我的罪过吗？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"其实，你知道我没有罪恶，","poem":1},{"lineBreak":true},{"text":"并没有能救我脱离你手的。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你的手创造我，造就我的四肢百体，","poem":1},{"lineBreak":true},{"text":"你还要毁灭我。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你记念—制造我如抟泥一般，","poem":1},{"lineBreak":true},{"text":"你还要使我归于尘土吗？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你不是倒出我来好像奶，","poem":1},{"lineBreak":true},{"text":"使我凝结如同奶饼吗？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你以皮和肉为衣给我穿上，","poem":1},{"lineBreak":true},{"text":"用骨与筋把我全体联络。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你将生命和慈爱赐给我；","poem":1},{"lineBreak":true},{"text":"你也眷顾保全我的心灵。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"然而，你待我的这些事早已藏在你心里；","poem":1},{"lineBreak":true},{"text":"我知道你久有此意。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我若犯罪，你就察看我，","poem":1},{"lineBreak":true},{"text":"并不赦免我的罪孽。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我若行恶，便有了祸；","poem":1},{"lineBreak":true},{"text":"我若为义，也不敢抬头，","poem":1},{"lineBreak":true},{"text":"正是满心羞愧，","poem":1},{"lineBreak":true},{"text":"眼见我的苦情。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我若昂首自得，你就追捕我如狮子，","poem":1},{"lineBreak":true},{"text":"又在我身上显出奇能。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你重立见证攻击我，","poem":1},{"lineBreak":true},{"text":"向我加增恼怒，","poem":1},{"lineBreak":true},{"text":"如军兵更换着攻击我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"你为何使我出母胎呢？","poem":1},{"lineBreak":true},{"text":"不如我当时气绝，无人得见我；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"这样，就如没有我一般，","poem":1},{"lineBreak":true},{"text":"一出母胎就被送入坟墓。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的日子不是甚少吗？","poem":1},{"lineBreak":true},{"text":"求你停手宽容我，","poem":1},{"lineBreak":true},{"text":"叫我在往而不返之先—","poem":1},{"lineBreak":true},{"text":"就是往黑暗和死荫之地以先—","poem":1},{"lineBreak":true},{"text":"可以稍得畅快。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"那地甚是幽暗，是死荫混沌之地；","poem":1},{"lineBreak":true},{"text":"那里的光好像幽暗。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}