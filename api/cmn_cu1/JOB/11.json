{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"拿玛人琐法回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"这许多的言语岂不该回答吗？","poem":1},{"lineBreak":true},{"text":"多嘴多舌的人岂可称为义吗？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你夸大的话岂能使人不作声吗？","poem":1},{"lineBreak":true},{"text":"你戏笑的时候岂没有人叫你害羞吗？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你说：我的道理纯全；","poem":1},{"lineBreak":true},{"text":"我在你眼前洁净。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"惟愿 神说话；","poem":1},{"lineBreak":true},{"text":"愿他开口攻击你，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"并将智慧的奥秘指示你；","poem":1},{"lineBreak":true},{"text":"他有诸般的智识。","poem":1},{"lineBreak":true},{"text":"所以当知道 神追讨你","poem":1},{"lineBreak":true},{"text":"比你罪孽该得的还少。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你考察就能测透 神吗？","poem":1},{"lineBreak":true},{"text":"你岂能尽情测透全能者吗？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他的智慧高于天，你还能做什么？","poem":1},{"lineBreak":true},{"text":"深于阴间，你还能知道什么？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"其量比地长，","poem":1},{"lineBreak":true},{"text":"比海宽。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他若经过，将人拘禁，","poem":1},{"lineBreak":true},{"text":"招人受审，谁能阻挡他呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他本知道虚妄的人；","poem":1},{"lineBreak":true},{"text":"人的罪孽，他虽不留意，还是无所不见。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"空虚的人却毫无知识；","poem":1},{"lineBreak":true},{"text":"人生在世好像野驴的驹子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"你若将心安正，","poem":1},{"lineBreak":true},{"text":"又向主举手；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你手里若有罪孽，","poem":1},{"lineBreak":true},{"text":"就当远远地除掉，","poem":1},{"lineBreak":true},{"text":"也不容非义住在你帐棚之中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"那时，你必仰起脸来毫无斑点；","poem":1},{"lineBreak":true},{"text":"你也必坚固，无所惧怕。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你必忘记你的苦楚，","poem":1},{"lineBreak":true},{"text":"就是想起也如流过去的水一样。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你在世的日子要比正午更明，","poem":1},{"lineBreak":true},{"text":"虽有黑暗仍像早晨。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你因有指望就必稳固，","poem":1},{"lineBreak":true},{"text":"也必四围巡查，坦然安息。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你躺卧，无人惊吓，","poem":1},{"lineBreak":true},{"text":"且有许多人向你求恩。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"但恶人的眼目必要失明。","poem":1},{"lineBreak":true},{"text":"他们无路可逃；","poem":1},{"lineBreak":true},{"text":"他们的指望就是气绝。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}