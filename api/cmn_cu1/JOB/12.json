{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"约伯回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们真是子民哪，","poem":1},{"lineBreak":true},{"text":"你们死亡，智慧也就灭没了。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"但我也有聪明，与你们一样，","poem":1},{"lineBreak":true},{"text":"并非不及你们。","poem":1},{"lineBreak":true},{"text":"你们所说的，谁不知道呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我这求告 神、蒙他应允的人","poem":1},{"lineBreak":true},{"text":"竟成了朋友所讥笑的；","poem":1},{"lineBreak":true},{"text":"公义完全人竟受了人的讥笑。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"安逸的人心里藐视灾祸；","poem":1},{"lineBreak":true},{"text":"这灾祸常常等待滑脚的人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"强盗的帐棚兴旺，","poem":1},{"lineBreak":true},{"text":"惹 神的人稳固，","poem":1},{"lineBreak":true},{"text":"神多将财物送到他们手中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"你且问走兽，走兽必指教你；","poem":1},{"lineBreak":true},{"text":"又问空中的飞鸟，飞鸟必告诉你；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"或与地说话，地必指教你；","poem":1},{"lineBreak":true},{"text":"海中的鱼也必向你说明。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"看这一切，","poem":1},{"lineBreak":true},{"text":"谁不知道是耶和华的手做成的呢？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"凡活物的生命和人类的气息都在他手中。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耳朵岂不试验言语，","poem":1},{"lineBreak":true},{"text":"正如上膛尝食物吗？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"年老的有智慧；","poem":1},{"lineBreak":true},{"text":"寿高的有知识。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"在 神有智慧和能力；","poem":1},{"lineBreak":true},{"text":"他有谋略和知识。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他拆毁的，就不能再建造；","poem":1},{"lineBreak":true},{"text":"他捆住人，便不得开释。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他把水留住，水便枯干；","poem":1},{"lineBreak":true},{"text":"他再发出水来，水就翻地。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"在他有能力和智慧，","poem":1},{"lineBreak":true},{"text":"被诱惑的与诱惑人的都是属他。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他把谋士剥衣掳去，","poem":1},{"lineBreak":true},{"text":"又使审判官变成愚人。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他放松君王的绑，","poem":1},{"lineBreak":true},{"text":"又用带子捆他们的腰。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他把祭司剥衣掳去，","poem":1},{"lineBreak":true},{"text":"又使有能的人倾败。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他废去忠信人的讲论，","poem":1},{"lineBreak":true},{"text":"又夺去老人的聪明。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他使君王蒙羞被辱，","poem":1},{"lineBreak":true},{"text":"放松有力之人的腰带。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他将深奥的事从黑暗中彰显，","poem":1},{"lineBreak":true},{"text":"使死荫显为光明。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他使邦国兴旺而又毁灭；","poem":1},{"lineBreak":true},{"text":"他使邦国开广而又掳去。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他将地上民中首领的聪明夺去，","poem":1},{"lineBreak":true},{"text":"使他们在荒废无路之地漂流；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他们无光，在黑暗中摸索，","poem":1},{"lineBreak":true},{"text":"又使他们东倒西歪，像醉酒的人一样。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}