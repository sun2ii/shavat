{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"这一切，我眼都见过；","poem":1},{"lineBreak":true},{"text":"我耳都听过，而且明白。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们所知道的，我也知道，","poem":1},{"lineBreak":true},{"text":"并非不及你们。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我真要对全能者说话；","poem":1},{"lineBreak":true},{"text":"我愿与 神理论。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你们是编造谎言的，","poem":1},{"lineBreak":true},{"text":"都是无用的医生。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"惟愿你们全然不作声；","poem":1},{"lineBreak":true},{"text":"这就算为你们的智慧！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"请你们听我的辩论，","poem":1},{"lineBreak":true},{"text":"留心听我口中的分诉。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你们要为 神说不义的话吗？","poem":1},{"lineBreak":true},{"text":"为他说诡诈的言语吗？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你们要为 神徇情吗？","poem":1},{"lineBreak":true},{"text":"要为他争论吗？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他查出你们来，这岂是好吗？","poem":1},{"lineBreak":true},{"text":"人欺哄人，你们也要照样欺哄他吗？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你们若暗中徇情，","poem":1},{"lineBreak":true},{"text":"他必要责备你们。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他的尊荣岂不叫你们惧怕吗？","poem":1},{"lineBreak":true},{"text":"他的惊吓岂不临到你们吗？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你们以为可记念的箴言是炉灰的箴言；","poem":1},{"lineBreak":true},{"text":"你们以为可靠的坚垒是淤泥的坚垒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"你们不要作声，任凭我吧！","poem":1},{"lineBreak":true},{"text":"让我说话，无论如何我都承当。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我何必把我的肉挂在牙上，","poem":1},{"lineBreak":true},{"text":"将我的命放在手中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他必杀我；我虽无指望，","poem":1},{"lineBreak":true},{"text":"然而我在他面前还要辩明我所行的。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"这要成为我的拯救，","poem":1},{"lineBreak":true},{"text":"因为不虔诚的人不得到他面前。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你们要细听我的言语，","poem":1},{"lineBreak":true},{"text":"使我所辩论的入你们的耳中。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我已陈明我的案，","poem":1},{"lineBreak":true},{"text":"知道自己有义。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"有谁与我争论，","poem":1},{"lineBreak":true},{"text":"我就情愿缄默不言，气绝而亡。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"惟有两件不要向我施行，","poem":1},{"lineBreak":true},{"text":"我就不躲开你的面：","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"就是把你的手缩回，远离我身；","poem":1},{"lineBreak":true},{"text":"又不使你的惊惶威吓我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"这样，你呼叫，我就回答；","poem":1},{"lineBreak":true},{"text":"或是让我说话，你回答我。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我的罪孽和罪过有多少呢？","poem":1},{"lineBreak":true},{"text":"求你叫我知道我的过犯与罪愆。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你为何掩面、","poem":1},{"lineBreak":true},{"text":"拿我当仇敌呢？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你要惊动被风吹的叶子吗？","poem":1},{"lineBreak":true},{"text":"要追赶枯干的碎秸吗？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你按罪状刑罚我，","poem":1},{"lineBreak":true},{"text":"又使我担当幼年的罪孽；","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"也把我的脚上了木狗，","poem":1},{"lineBreak":true},{"text":"并窥察我一切的道路，","poem":1},{"lineBreak":true},{"text":"为我的脚掌划定界限。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我已经像灭绝的烂物，","poem":1},{"lineBreak":true},{"text":"像虫蛀的衣裳。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}