{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"人为妇人所生，","poem":1},{"lineBreak":true},{"text":"日子短少，多有患难；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"出来如花，又被割下，","poem":1},{"lineBreak":true},{"text":"飞去如影，不能存留。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"这样的人你岂睁眼看他吗？","poem":1},{"lineBreak":true},{"text":"又叫我来受审吗？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"谁能使洁净之物出于污秽之中呢？","poem":1},{"lineBreak":true},{"text":"无论谁也不能！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"人的日子既然限定，","poem":1},{"lineBreak":true},{"text":"他的月数在你那里，","poem":1},{"lineBreak":true},{"text":"你也派定他的界限，使他不能越过，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"便求你转眼不看他，使他得歇息，","poem":1},{"lineBreak":true},{"text":"直等他像雇工人完毕他的日子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"树若被砍下，","poem":1},{"lineBreak":true},{"text":"还可指望发芽，","poem":1},{"lineBreak":true},{"text":"嫩枝生长不息；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"其根虽然衰老在地里，","poem":1},{"lineBreak":true},{"text":"干也死在土中，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"及至得了水气，还要发芽，","poem":1},{"lineBreak":true},{"text":"又长枝条，像新栽的树一样。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"但人死亡而消灭；","poem":1},{"lineBreak":true},{"text":"他气绝，竟在何处呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"海中的水绝尽，","poem":1},{"lineBreak":true},{"text":"江河消散干涸。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"人也是如此，躺下不再起来，","poem":1},{"lineBreak":true},{"text":"等到天没有了，仍不得复醒，","poem":1},{"lineBreak":true},{"text":"也不得从睡中唤醒。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"惟愿你把我藏在阴间，","poem":1},{"lineBreak":true},{"text":"存于隐密处，等你的忿怒过去；","poem":1},{"lineBreak":true},{"text":"愿你为我定了日期，记念我。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人若死了岂能再活呢？","poem":1},{"lineBreak":true},{"text":"我只要在我一切争战的日子，","poem":1},{"lineBreak":true},{"text":"等我被释放","poem":1},{"noteId":2},{"text":"的时候来到。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你呼叫，我便回答；","poem":1},{"lineBreak":true},{"text":"你手所做的，你必羡慕。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"但如今你数点我的脚步，","poem":1},{"lineBreak":true},{"text":"岂不窥察我的罪过吗？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的过犯被你封在囊中，","poem":1},{"lineBreak":true},{"text":"也缝严了我的罪孽。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"山崩变为无有；","poem":1},{"lineBreak":true},{"text":"磐石挪开原处。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"水流消磨石头，","poem":1},{"lineBreak":true},{"text":"所流溢的洗去地上的尘土；","poem":1},{"lineBreak":true},{"text":"你也照样灭绝人的指望。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你攻击人常常得胜，使他去世；","poem":1},{"lineBreak":true},{"text":"你改变他的容貌，叫他往而不回。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他儿子得尊荣，他也不知道，","poem":1},{"lineBreak":true},{"text":"降为卑，他也不觉得。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"但知身上疼痛，","poem":1},{"lineBreak":true},{"text":"心中悲哀。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"-","text":"或译：改变","reference":{"chapter":14,"verse":14}}]},"thisChapterLink":"/api/cmn_cu1/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}