{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":15,"content":[{"type":"heading","content":["第二次对话"]},{"type":"verse","number":1,"content":[{"text":"提幔人以利法回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"智慧人岂可用虚空的知识回答，","poem":1},{"lineBreak":true},{"text":"用东风充满肚腹呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他岂可用无益的话","poem":1},{"lineBreak":true},{"text":"和无济于事的言语理论呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你是废弃敬畏的意，","poem":1},{"lineBreak":true},{"text":"在 神面前阻止敬虔的心。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的罪孽指教你的口；","poem":1},{"lineBreak":true},{"text":"你选用诡诈人的舌头。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你自己的口定你有罪，并非是我；","poem":1},{"lineBreak":true},{"text":"你自己的嘴见证你的不是。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"你岂是头一个被生的人吗？","poem":1},{"lineBreak":true},{"text":"你受造在诸山之先吗？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你曾听见 神的密旨吗？","poem":1},{"lineBreak":true},{"text":"你还将智慧独自得尽吗？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你知道什么是我们不知道的呢？","poem":1},{"lineBreak":true},{"text":"你明白什么是我们不明白的呢？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我们这里有白发的和年纪老迈的，","poem":1},{"lineBreak":true},{"text":"比你父亲还老。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"神用温和的话安慰你，","poem":1},{"lineBreak":true},{"text":"你以为太小吗？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你的心为何将你逼去？","poem":1},{"lineBreak":true},{"text":"你的眼为何冒出火星，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"使你的灵反对 神，","poem":1},{"lineBreak":true},{"text":"也任你的口发这言语？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人是什么，竟算为洁净呢？","poem":1},{"lineBreak":true},{"text":"妇人所生的是什么，竟算为义呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"神不信靠他的众圣者；","poem":1},{"lineBreak":true},{"text":"在他眼前，天也不洁净，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"何况那污秽可憎、","poem":1},{"lineBreak":true},{"text":"喝罪孽如水的世人呢！","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"我指示你，你要听；","poem":1},{"lineBreak":true},{"text":"我要述说所看见的，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"就是智慧人从列祖所受，","poem":1},{"lineBreak":true},{"text":"传说而不隐瞒的。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"这地惟独赐给他们，","poem":1},{"lineBreak":true},{"text":"并没有外人从他们中间经过。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"恶人一生之日劬劳痛苦；","poem":1},{"lineBreak":true},{"text":"强暴人一生的年数也是如此。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"惊吓的声音常在他耳中；","poem":1},{"lineBreak":true},{"text":"在平安时，抢夺的必临到他那里。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他不信自己能从黑暗中转回；","poem":1},{"lineBreak":true},{"text":"他被刀剑等候。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他漂流在外求食，说：哪里有食物呢？","poem":1},{"lineBreak":true},{"text":"他知道黑暗的日子在他手边预备好了。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"急难困苦叫他害怕，","poem":1},{"lineBreak":true},{"text":"而且胜了他，好像君王预备上阵一样。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他伸手攻击 神，","poem":1},{"lineBreak":true},{"text":"以骄傲攻击全能者，","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"挺着颈项，","poem":1},{"lineBreak":true},{"text":"用盾牌的厚凸面向全能者直闯；","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"是因他的脸蒙上脂油，","poem":1},{"lineBreak":true},{"text":"腰积成肥肉。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他曾住在荒凉城邑，","poem":1},{"lineBreak":true},{"text":"无人居住、将成乱堆的房屋。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他不得富足，财物不得常存，","poem":1},{"lineBreak":true},{"text":"产业在地上也不加增。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他不得出离黑暗。","poem":1},{"lineBreak":true},{"text":"火焰要将他的枝子烧干；","poem":1},{"lineBreak":true},{"text":"因 神口中的气，他要灭亡","poem":1},{"noteId":3},{"text":"。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他不用倚靠虚假欺哄自己，","poem":1},{"lineBreak":true},{"text":"因虚假必成为他的报应。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他的日期未到之先，这事必成就；","poem":1},{"lineBreak":true},{"text":"他的枝子不得青绿。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他必像葡萄树的葡萄，未熟而落；","poem":1},{"lineBreak":true},{"text":"又像橄榄树的花，一开而谢。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"原来不敬虔之辈必无生育；","poem":1},{"lineBreak":true},{"text":"受贿赂之人的帐棚必被火烧。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"他们所怀的是毒害，所生的是罪孽；","poem":1},{"lineBreak":true},{"text":"心里所预备的是诡诈。","poem":1}]}],"footnotes":[{"noteId":3,"caller":"-","text":"原文是走去","reference":{"chapter":15,"verse":30}}]},"thisChapterLink":"/api/cmn_cu1/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}