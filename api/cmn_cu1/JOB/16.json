{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"约伯回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"这样的话我听了许多；","poem":1},{"lineBreak":true},{"text":"你们安慰人，反叫人愁烦。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"虚空的言语有穷尽吗？","poem":1},{"lineBreak":true},{"text":"有什么话惹动你回答呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我也能说你们那样的话；","poem":1},{"lineBreak":true},{"text":"你们若处在我的境遇，","poem":1},{"lineBreak":true},{"text":"我也会联络言语攻击你们，","poem":1},{"lineBreak":true},{"text":"又能向你们摇头。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但我必用口坚固你们，","poem":1},{"lineBreak":true},{"text":"用嘴消解你们的忧愁。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我虽说话，忧愁仍不得消解；","poem":1},{"lineBreak":true},{"text":"我虽停住不说，忧愁就离开我吗？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"但现在 神使我困倦，","poem":1},{"lineBreak":true},{"text":"使亲友远离我，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"又抓住我，作见证攻击我；","poem":1},{"lineBreak":true},{"text":"我身体的枯瘦也当面见证我的不是。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"主发怒撕裂我，逼迫我，","poem":1},{"lineBreak":true},{"text":"向我切齿；","poem":1},{"lineBreak":true},{"text":"我的敌人怒目看我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们向我开口，","poem":1},{"lineBreak":true},{"text":"打我的脸羞辱我，","poem":1},{"lineBreak":true},{"text":"聚会攻击我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"神把我交给不敬虔的人，","poem":1},{"lineBreak":true},{"text":"把我扔到恶人的手中。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我素来安逸，他折断我，","poem":1},{"lineBreak":true},{"text":"掐住我的颈项，把我摔碎，","poem":1},{"lineBreak":true},{"text":"又立我为他的箭靶子。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他的弓箭手四面围绕我；","poem":1},{"lineBreak":true},{"text":"他破裂我的肺腑，并不留情，","poem":1},{"lineBreak":true},{"text":"把我的胆倾倒在地上，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"将我破裂又破裂，","poem":1},{"lineBreak":true},{"text":"如同勇士向我直闯。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"我缝麻布在我皮肤上，","poem":1},{"lineBreak":true},{"text":"把我的角放在尘土中。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我的脸因哭泣发紫，","poem":1},{"lineBreak":true},{"text":"在我的眼皮上有死荫。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的手中却无强暴；","poem":1},{"lineBreak":true},{"text":"我的祈祷也是清洁。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"地啊，不要遮盖我的血！","poem":1},{"lineBreak":true},{"text":"不要阻挡我的哀求！","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"现今，在天有我的见证，","poem":1},{"lineBreak":true},{"text":"在上有我的中保。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的朋友讥诮我，","poem":1},{"lineBreak":true},{"text":"我却向 神眼泪汪汪。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"愿人得与 神辩白，","poem":1},{"lineBreak":true},{"text":"如同人与朋友辩白一样；","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为再过几年，","poem":1},{"lineBreak":true},{"text":"我必走那往而不返之路。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}