{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"我的心灵消耗，我的日子灭尽；","poem":1},{"lineBreak":true},{"text":"坟墓为我预备好了。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"真有戏笑我的在我这里，","poem":1},{"lineBreak":true},{"text":"我眼常见他们惹动我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"愿主拿凭据给我，自己为我作保。","poem":1},{"lineBreak":true},{"text":"在你以外谁肯与我击掌呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因你使他们心不明理，","poem":1},{"lineBreak":true},{"text":"所以你必不高举他们。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"控告他的朋友、以朋友为可抢夺的，","poem":1},{"lineBreak":true},{"text":"连他儿女的眼睛也要失明。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"神使我作了民中的笑谈；","poem":1},{"lineBreak":true},{"text":"他们也吐唾沫在我脸上。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的眼睛因忧愁昏花；","poem":1},{"lineBreak":true},{"text":"我的百体好像影儿。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"正直人因此必惊奇；","poem":1},{"lineBreak":true},{"text":"无辜的人要兴起攻击不敬虔之辈。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"然而，义人要持守所行的道；","poem":1},{"lineBreak":true},{"text":"手洁的人要力上加力。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"至于你们众人，可以再来辩论吧！","poem":1},{"lineBreak":true},{"text":"你们中间，我找不着一个智慧人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的日子已经过了；","poem":1},{"lineBreak":true},{"text":"我的谋算、我心所想望的已经断绝。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们以黑夜为白昼，","poem":1},{"lineBreak":true},{"text":"说：亮光近乎黑暗。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我若盼望阴间为我的房屋，","poem":1},{"lineBreak":true},{"text":"若下榻在黑暗中，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"若对朽坏说：你是我的父；","poem":1},{"lineBreak":true},{"text":"对虫说：你是我的母亲姊妹；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"这样，我的指望在哪里呢？","poem":1},{"lineBreak":true},{"text":"我所指望的谁能看见呢？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"等到安息在尘土中，","poem":1},{"lineBreak":true},{"text":"这指望必下到阴间的门闩那里了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}