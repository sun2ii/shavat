{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"书亚人比勒达回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你寻索言语要到几时呢？","poem":1},{"lineBreak":true},{"text":"你可以揣摩思想，然后我们就说话。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我们为何算为畜生，","poem":1},{"lineBreak":true},{"text":"在你眼中看作污秽呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你这恼怒将自己撕裂的，","poem":1},{"lineBreak":true},{"text":"难道大地为你见弃、","poem":1},{"lineBreak":true},{"text":"磐石挪开原处吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"恶人的亮光必要熄灭；","poem":1},{"lineBreak":true},{"text":"他的火焰必不照耀。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他帐棚中的亮光要变为黑暗；","poem":1},{"lineBreak":true},{"text":"他以上的灯也必熄灭。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他坚强的脚步必见狭窄；","poem":1},{"lineBreak":true},{"text":"自己的计谋必将他绊倒。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因为他被自己的脚陷入网中，","poem":1},{"lineBreak":true},{"text":"走在缠人的网罗上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"圈套必抓住他的脚跟；","poem":1},{"lineBreak":true},{"text":"机关必擒获他。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"活扣为他藏在土内；","poem":1},{"lineBreak":true},{"text":"羁绊为他藏在路上。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"四面的惊吓要使他害怕，","poem":1},{"lineBreak":true},{"text":"并且追赶他的脚跟。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他的力量必因饥饿衰败；","poem":1},{"lineBreak":true},{"text":"祸患要在他旁边等候。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他本身的肢体要被吞吃；","poem":1},{"lineBreak":true},{"text":"死亡的长子要吞吃他的肢体。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他要从所倚靠的帐棚被拔出来，","poem":1},{"lineBreak":true},{"text":"带到惊吓的王那里。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"不属他的必住在他的帐棚里；","poem":1},{"lineBreak":true},{"text":"硫磺必撒在他所住之处。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"下边，他的根本要枯干；","poem":1},{"lineBreak":true},{"text":"上边，他的枝子要剪除。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他的记念在地上必然灭亡；","poem":1},{"lineBreak":true},{"text":"他的名字在街上也不存留。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他必从光明中被撵到黑暗里，","poem":1},{"lineBreak":true},{"text":"必被赶出世界。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"在本民中必无子无孙；","poem":1},{"lineBreak":true},{"text":"在寄居之地也无一人存留。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"以后来的要惊奇他的日子，","poem":1},{"lineBreak":true},{"text":"好像以前去的受了惊骇。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"不义之人的住处总是这样；","poem":1},{"lineBreak":true},{"text":"此乃不认识 神之人的地步。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}