{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"约伯回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们搅扰我的心，","poem":1},{"lineBreak":true},{"text":"用言语压碎我要到几时呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们这十次羞辱我；","poem":1},{"lineBreak":true},{"text":"你们苦待我也不以为耻。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"果真我有错，","poem":1},{"lineBreak":true},{"text":"这错乃是在我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你们果然要向我夸大，","poem":1},{"lineBreak":true},{"text":"以我的羞辱为证指责我，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"就该知道是 神倾覆我，","poem":1},{"lineBreak":true},{"text":"用网罗围绕我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我因委曲呼叫，却不蒙应允；","poem":1},{"lineBreak":true},{"text":"我呼求，却不得公断。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"神用篱笆拦住我的道路，使我不得经过；","poem":1},{"lineBreak":true},{"text":"又使我的路径黑暗。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他剥去我的荣光，","poem":1},{"lineBreak":true},{"text":"摘去我头上的冠冕。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他在四围攻击我，我便归于死亡，","poem":1},{"lineBreak":true},{"text":"将我的指望如树拔出来。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他的忿怒向我发作，","poem":1},{"lineBreak":true},{"text":"以我为敌人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他的军旅一齐上来，","poem":1},{"lineBreak":true},{"text":"修筑战路攻击我，","poem":1},{"lineBreak":true},{"text":"在我帐棚的四围安营。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"他把我的弟兄隔在远处，","poem":1},{"lineBreak":true},{"text":"使我所认识的全然与我生疏。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我的亲戚与我断绝；","poem":1},{"lineBreak":true},{"text":"我的密友都忘记我。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"在我家寄居的，","poem":1},{"lineBreak":true},{"text":"和我的使女都以我为外人；","poem":1},{"lineBreak":true},{"text":"我在他们眼中看为外邦人。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我呼唤仆人，","poem":1},{"lineBreak":true},{"text":"虽用口求他，他还是不回答。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我口的气味，我妻子厌恶；","poem":1},{"lineBreak":true},{"text":"我的恳求，我同胞也憎嫌。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"连小孩子也藐视我；","poem":1},{"lineBreak":true},{"text":"我若起来，他们都嘲笑我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的密友都憎恶我；","poem":1},{"lineBreak":true},{"text":"我平日所爱的人向我翻脸。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的皮肉紧贴骨头；","poem":1},{"lineBreak":true},{"text":"我只剩牙皮逃脱了。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我朋友啊，可怜我！可怜我！","poem":1},{"lineBreak":true},{"text":"因为 神的手攻击我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你们为什么仿佛 神逼迫我，","poem":1},{"lineBreak":true},{"text":"吃我的肉还以为不足呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"惟愿我的言语现在写上，","poem":1},{"lineBreak":true},{"text":"都记录在书上；","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"用铁笔镌刻，","poem":1},{"lineBreak":true},{"text":"用铅灌在磐石上，直存到永远。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我知道我的救赎主活着，","poem":1},{"lineBreak":true},{"text":"末了必站立在地上。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我这皮肉灭绝之后，","poem":1},{"lineBreak":true},{"text":"我必在肉体之外得见 神。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我自己要见他，","poem":1},{"lineBreak":true},{"text":"亲眼要看他，并不像外人。","poem":1},{"lineBreak":true},{"text":"我的心肠在我里面消灭了！","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你们若说：我们逼迫他要何等地重呢？","poem":1},{"lineBreak":true},{"text":"惹事的根乃在乎他；","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你们就当惧怕刀剑；","poem":1},{"lineBreak":true},{"text":"因为忿怒惹动刀剑的刑罚，","poem":1},{"lineBreak":true},{"text":"使你们知道有报应","poem":1},{"noteId":4},{"text":"。","poem":1}]}],"footnotes":[{"noteId":4,"caller":"-","text":"原文是审判","reference":{"chapter":19,"verse":29}}]},"thisChapterLink":"/api/cmn_cu1/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}