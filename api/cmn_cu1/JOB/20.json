{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"拿玛人琐法回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我心中急躁，","poem":1},{"lineBreak":true},{"text":"所以我的思念叫我回答。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我已听见那羞辱我，责备我的话；","poem":1},{"lineBreak":true},{"text":"我的悟性叫我回答。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你岂不知亘古以来，","poem":1},{"lineBreak":true},{"text":"自从人生在地，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"恶人夸胜是暂时的，","poem":1},{"lineBreak":true},{"text":"不敬虔人的喜乐不过转眼之间吗？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他的尊荣虽达到天上，","poem":1},{"lineBreak":true},{"text":"头虽顶到云中，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他终必灭亡，像自己的粪一样；","poem":1},{"lineBreak":true},{"text":"素来见他的人要说：他在哪里呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他必飞去如梦，不再寻见，","poem":1},{"lineBreak":true},{"text":"速被赶去，如夜间的异象。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"亲眼见过他的，必不再见他；","poem":1},{"lineBreak":true},{"text":"他的本处也再见不着他。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他的儿女要求穷人的恩；","poem":1},{"lineBreak":true},{"text":"他的手要赔还不义之财。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他的骨头虽然有青年之力，","poem":1},{"lineBreak":true},{"text":"却要和他一同躺卧在尘土中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"他口内虽以恶为甘甜，","poem":1},{"lineBreak":true},{"text":"藏在舌头底下，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"爱恋不舍，含在口中；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他的食物在肚里却要化为酸，","poem":1},{"lineBreak":true},{"text":"在他里面成为虺蛇的恶毒。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他吞了财宝，还要吐出；","poem":1},{"lineBreak":true},{"text":"神要从他腹中掏出来。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他必吸饮虺蛇的毒气；","poem":1},{"lineBreak":true},{"text":"蝮蛇的舌头也必杀他。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"流奶与蜜之河，","poem":1},{"lineBreak":true},{"text":"他不得再见。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他劳碌得来的要赔还，不得享用","poem":1},{"noteId":5},{"text":"；","poem":1},{"lineBreak":true},{"text":"不能照所得的财货欢乐。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他欺压穷人，且又离弃；","poem":1},{"lineBreak":true},{"text":"强取非自己所盖的房屋","poem":1},{"noteId":6},{"text":"。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他因贪而无厌，","poem":1},{"lineBreak":true},{"text":"所喜悦的连一样也不能保守。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"其余的没有一样他不吞灭，","poem":1},{"lineBreak":true},{"text":"所以他的福乐不能长久。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他在满足有余的时候，必到狭窄的地步；","poem":1},{"lineBreak":true},{"text":"凡受苦楚的人都必加手在他身上。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他正要充满肚腹的时候，","poem":1},{"lineBreak":true},{"text":"神必将猛烈的忿怒降在他身上；","poem":1},{"lineBreak":true},{"text":"正在他吃饭的时候，","poem":1},{"lineBreak":true},{"text":"要将这忿怒像雨降在他身上。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他要躲避铁器；","poem":1},{"lineBreak":true},{"text":"铜弓的箭要将他射透。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他把箭一抽，就从他身上出来；","poem":1},{"lineBreak":true},{"text":"发光的箭头从他胆中出来，","poem":1},{"lineBreak":true},{"text":"有惊惶临在他身上。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他的财宝归于黑暗；","poem":1},{"lineBreak":true},{"text":"人所不吹的火要把他烧灭，","poem":1},{"lineBreak":true},{"text":"要把他帐棚中所剩下的烧毁。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"天要显明他的罪孽；","poem":1},{"lineBreak":true},{"text":"地要兴起攻击他。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他的家产必然过去；","poem":1},{"lineBreak":true},{"text":"神发怒的日子，他的货物都要消灭。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"这是恶人从 神所得的分，","poem":1},{"lineBreak":true},{"text":"是 神为他所定的产业。","poem":1}]}],"footnotes":[{"noteId":5,"caller":"-","text":"原文是吞下","reference":{"chapter":20,"verse":18}},{"noteId":6,"caller":"-","text":"或译：强取房屋不得再建造","reference":{"chapter":20,"verse":19}}]},"thisChapterLink":"/api/cmn_cu1/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}