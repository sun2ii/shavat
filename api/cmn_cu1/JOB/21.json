{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"约伯回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们要细听我的言语，","poem":1},{"lineBreak":true},{"text":"就算是你们安慰我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"请宽容我，我又要说话；","poem":1},{"lineBreak":true},{"text":"说了以后，任凭你们嗤笑吧！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我岂是向人诉冤？","poem":1},{"lineBreak":true},{"text":"为何不焦急呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你们要看着我而惊奇，","poem":1},{"lineBreak":true},{"text":"用手捂口。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我每逢思想，心就惊惶，","poem":1},{"lineBreak":true},{"text":"浑身战兢。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"恶人为何存活，","poem":1},{"lineBreak":true},{"text":"享大寿数，势力强盛呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们眼见儿孙，","poem":1},{"lineBreak":true},{"text":"和他们一同坚立。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们的家宅平安无惧；","poem":1},{"lineBreak":true},{"text":"神的杖也不加在他们身上。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们的公牛孳生而不断绝；","poem":1},{"lineBreak":true},{"text":"母牛下犊而不掉胎。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们打发小孩子出去，多如羊群；","poem":1},{"lineBreak":true},{"text":"他们的儿女踊跃跳舞。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们随着琴鼓歌唱，","poem":1},{"lineBreak":true},{"text":"又因箫声欢喜。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他们度日诸事亨通，","poem":1},{"lineBreak":true},{"text":"转眼下入阴间。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们对 神说：离开我们吧！","poem":1},{"lineBreak":true},{"text":"我们不愿晓得你的道。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"全能者是谁，我们何必事奉他呢？","poem":1},{"lineBreak":true},{"text":"求告他有什么益处呢？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"看哪，他们亨通不在乎自己；","poem":1},{"lineBreak":true},{"text":"恶人所谋定的离我好远。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"恶人的灯何尝熄灭？","poem":1},{"lineBreak":true},{"text":"患难何尝临到他们呢？","poem":1},{"lineBreak":true},{"text":"神何尝发怒，向他们分散灾祸呢？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们何尝像风前的碎秸，","poem":1},{"lineBreak":true},{"text":"如暴风刮去的糠秕呢？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你们说： 神为恶人的儿女积蓄罪孽；","poem":1},{"lineBreak":true},{"text":"我说：不如本人受报，好使他亲自知道。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"愿他亲眼看见自己败亡，","poem":1},{"lineBreak":true},{"text":"亲自饮全能者的忿怒。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他的岁月既尽，","poem":1},{"lineBreak":true},{"text":"他还顾他本家吗？","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"神既审判那在高位的，","poem":1},{"lineBreak":true},{"text":"谁能将知识教训他呢？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"有人至死身体强壮，","poem":1},{"lineBreak":true},{"text":"尽得平靖安逸；","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他的奶桶充满，","poem":1},{"lineBreak":true},{"text":"他的骨髓滋润。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"有人至死心中痛苦，","poem":1},{"lineBreak":true},{"text":"终身未尝福乐的滋味；","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他们一样躺卧在尘土中，","poem":1},{"lineBreak":true},{"text":"都被虫子遮盖。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"我知道你们的意思，","poem":1},{"lineBreak":true},{"text":"并诬害我的计谋。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你们说：霸者的房屋在哪里？","poem":1},{"lineBreak":true},{"text":"恶人住过的帐棚在哪里？","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你们岂没有询问过路的人吗？","poem":1},{"lineBreak":true},{"text":"不知道他们所引的证据吗？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"就是恶人在祸患的日子得存留，","poem":1},{"lineBreak":true},{"text":"在发怒的日子得逃脱。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他所行的，有谁当面给他说明？","poem":1},{"lineBreak":true},{"text":"他所做的，有谁报应他呢？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"然而他要被抬到茔地；","poem":1},{"lineBreak":true},{"text":"并有人看守坟墓。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他要以谷中的土块为甘甜；","poem":1},{"lineBreak":true},{"text":"在他以先去的无数，","poem":1},{"lineBreak":true},{"text":"在他以后去的更多。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你们对答的话中既都错谬，","poem":1},{"lineBreak":true},{"text":"怎么徒然安慰我呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}