{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":22,"content":[{"type":"heading","content":["第三次对话"]},{"type":"verse","number":1,"content":[{"text":"提幔人以利法回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"人岂能使 神有益呢？","poem":1},{"lineBreak":true},{"text":"智慧人但能有益于己。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你为人公义，岂叫全能者喜悦呢？","poem":1},{"lineBreak":true},{"text":"你行为完全，岂能使他得利呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"岂是因你敬畏他","poem":1},{"lineBreak":true},{"text":"就责备你、审判你吗？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的罪恶岂不是大吗？","poem":1},{"lineBreak":true},{"text":"你的罪孽也没有穷尽；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因你无故强取弟兄的物为当头，","poem":1},{"lineBreak":true},{"text":"剥去贫寒人的衣服。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"困乏的人，你没有给他水喝；","poem":1},{"lineBreak":true},{"text":"饥饿的人，你没有给他食物。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"有能力的人就得地土；","poem":1},{"lineBreak":true},{"text":"尊贵的人也住在其中。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你打发寡妇空手回去，","poem":1},{"lineBreak":true},{"text":"折断孤儿的膀臂。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因此，有网罗环绕你，","poem":1},{"lineBreak":true},{"text":"有恐惧忽然使你惊惶；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"或有黑暗蒙蔽你，","poem":1},{"lineBreak":true},{"text":"并有洪水淹没你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"神岂不是在高天吗？","poem":1},{"lineBreak":true},{"text":"你看星宿何其高呢！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你说： 神知道什么？","poem":1},{"lineBreak":true},{"text":"他岂能看透幽暗施行审判呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"密云将他遮盖，使他不能看见；","poem":1},{"lineBreak":true},{"text":"他周游穹苍。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你要依从上古的道吗？","poem":1},{"lineBreak":true},{"text":"这道是恶人所行的。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他们未到死期，忽然除灭；","poem":1},{"lineBreak":true},{"text":"根基毁坏，好像被江河冲去。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他们向 神说：离开我们吧！","poem":1},{"lineBreak":true},{"text":"又说：全能者能把我们怎么样呢？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"哪知 神以美物充满他们的房屋；","poem":1},{"lineBreak":true},{"text":"但恶人所谋定的离我好远。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"义人看见他们的结局就欢喜；","poem":1},{"lineBreak":true},{"text":"无辜的人嗤笑他们，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"说：那起来攻击我们的果然被剪除，","poem":1},{"lineBreak":true},{"text":"其余的都被火烧灭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"你要认识 神，就得平安；","poem":1},{"lineBreak":true},{"text":"福气也必临到你。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你当领受他口中的教训，","poem":1},{"lineBreak":true},{"text":"将他的言语存在心里。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你若归向全能者，从你帐棚中远除不义，","poem":1},{"lineBreak":true},{"text":"就必得建立。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"要将你的珍宝丢在尘土里，","poem":1},{"lineBreak":true},{"text":"将俄斐的黄金丢在溪河石头之间；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"全能者就必为你的珍宝，","poem":1},{"lineBreak":true},{"text":"作你的宝银。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你就要以全能者为喜乐，","poem":1},{"lineBreak":true},{"text":"向 神仰起脸来。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你要祷告他，他就听你；","poem":1},{"lineBreak":true},{"text":"你也要还你的愿。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你定意要做何事，必然给你成就；","poem":1},{"lineBreak":true},{"text":"亮光也必照耀你的路。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"人使你降卑，你仍可说：必得高升；","poem":1},{"lineBreak":true},{"text":"谦卑的人， 神必然拯救。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"人非无辜， 神且要搭救他；","poem":1},{"lineBreak":true},{"text":"他因你手中清洁，必蒙拯救。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}