{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"约伯回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"如今我的哀告还算为悖逆；","poem":1},{"lineBreak":true},{"text":"我的责罚比我的唉哼还重。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"惟愿我能知道在哪里可以寻见 神，","poem":1},{"lineBreak":true},{"text":"能到他的台前，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我就在他面前将我的案件陈明，","poem":1},{"lineBreak":true},{"text":"满口辩白。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我必知道他回答我的言语，","poem":1},{"lineBreak":true},{"text":"明白他向我所说的话。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他岂用大能与我争辩吗？","poem":1},{"lineBreak":true},{"text":"必不这样！他必理会我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"在他那里正直人可以与他辩论；","poem":1},{"lineBreak":true},{"text":"这样，我必永远脱离那审判我的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"只是，我往前行，他不在那里，","poem":1},{"lineBreak":true},{"text":"往后退，也不能见他。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他在左边行事，我却不能看见，","poem":1},{"lineBreak":true},{"text":"在右边隐藏，我也不能见他。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"然而他知道我所行的路；","poem":1},{"lineBreak":true},{"text":"他试炼我之后，我必如精金。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我脚追随他的步履；","poem":1},{"lineBreak":true},{"text":"我谨守他的道，并不偏离。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他嘴唇的命令，我未曾背弃；","poem":1},{"lineBreak":true},{"text":"我看重他口中的言语，过于我需用的饮食。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"只是他心志已定，谁能使他转意呢？","poem":1},{"lineBreak":true},{"text":"他心里所愿的，就行出来。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他向我所定的，就必做成；","poem":1},{"lineBreak":true},{"text":"这类的事他还有许多。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"所以我在他面前惊惶；","poem":1},{"lineBreak":true},{"text":"我思念这事便惧怕他。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"神使我丧胆；","poem":1},{"lineBreak":true},{"text":"全能者使我惊惶。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的恐惧不是因为黑暗，","poem":1},{"lineBreak":true},{"text":"也不是因为幽暗蒙蔽我的脸。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}