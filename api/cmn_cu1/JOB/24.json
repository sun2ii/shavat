{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"全能者既定期罚恶，","poem":1},{"lineBreak":true},{"text":"为何不使认识他的人看见那日子呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"有人挪移地界，","poem":1},{"lineBreak":true},{"text":"抢夺群畜而牧养。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们拉去孤儿的驴，","poem":1},{"lineBreak":true},{"text":"强取寡妇的牛为当头。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们使穷人离开正道；","poem":1},{"lineBreak":true},{"text":"世上的贫民尽都隐藏。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"这些贫穷人如同野驴出到旷野，殷勤寻找食物；","poem":1},{"lineBreak":true},{"text":"他们靠着野地给儿女糊口，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"收割别人田间的禾稼，","poem":1},{"lineBreak":true},{"text":"摘取恶人余剩的葡萄，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"终夜赤身无衣，","poem":1},{"lineBreak":true},{"text":"天气寒冷毫无遮盖，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"在山上被大雨淋湿，","poem":1},{"lineBreak":true},{"text":"因没有避身之处就挨近磐石。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"又有人从母怀中抢夺孤儿，","poem":1},{"lineBreak":true},{"text":"强取穷人的衣服为当头，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"使人赤身无衣，到处流行，","poem":1},{"lineBreak":true},{"text":"且因饥饿扛抬禾捆，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"在那些人的围墙内造油，榨酒，","poem":1},{"lineBreak":true},{"text":"自己还口渴。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"在多民的城内有人唉哼，","poem":1},{"lineBreak":true},{"text":"受伤的人哀号；","poem":1},{"lineBreak":true},{"text":"神却不理会那恶人的愚妄。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"又有人背弃光明，","poem":1},{"lineBreak":true},{"text":"不认识光明的道，","poem":1},{"lineBreak":true},{"text":"不住在光明的路上。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"杀人的黎明起来，","poem":1},{"lineBreak":true},{"text":"杀害困苦穷乏人，","poem":1},{"lineBreak":true},{"text":"夜间又作盗贼。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"奸夫等候黄昏，","poem":1},{"lineBreak":true},{"text":"说：必无眼能见我，","poem":1},{"lineBreak":true},{"text":"就把脸蒙蔽。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"盗贼黑夜挖窟窿；","poem":1},{"lineBreak":true},{"text":"白日躲藏，","poem":1},{"lineBreak":true},{"text":"并不认识光明。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他们看早晨如幽暗，","poem":1},{"lineBreak":true},{"text":"因为他们晓得幽暗的惊骇。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"这些恶人犹如浮萍快快飘去。","poem":1},{"lineBreak":true},{"text":"他们所得的分在世上被咒诅；","poem":1},{"lineBreak":true},{"text":"他们不得再走葡萄园的路。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"干旱炎热消没雪水；","poem":1},{"lineBreak":true},{"text":"阴间也如此消没犯罪之辈。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"怀他的母","poem":1},{"noteId":7},{"text":"要忘记他；","poem":1},{"lineBreak":true},{"text":"虫子要吃他，觉得甘甜；","poem":1},{"lineBreak":true},{"text":"他不再被人记念。","poem":1},{"lineBreak":true},{"text":"不义的人必如树折断。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"他恶待","poem":1},{"noteId":8},{"text":"不怀孕不生养的妇人，","poem":1},{"lineBreak":true},{"text":"不善待寡妇。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"然而 神用能力保全有势力的人；","poem":1},{"lineBreak":true},{"text":"那性命难保的人仍然兴起。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"神使他们安稳，他们就有所倚靠；","poem":1},{"lineBreak":true},{"text":"神的眼目也看顾他们的道路。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他们被高举，不过片时就没有了；","poem":1},{"lineBreak":true},{"text":"他们降为卑，被除灭，与众人一样，","poem":1},{"lineBreak":true},{"text":"又如谷穗被割。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"若不是这样，谁能证实我是说谎的，","poem":1},{"lineBreak":true},{"text":"将我的言语驳为虚空呢？","poem":1}]}],"footnotes":[{"noteId":7,"caller":"-","text":"原文是胎","reference":{"chapter":24,"verse":20}},{"noteId":8,"caller":"-","text":"或译：他吞灭","reference":{"chapter":24,"verse":21}}]},"thisChapterLink":"/api/cmn_cu1/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}