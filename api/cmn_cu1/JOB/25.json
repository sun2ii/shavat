{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"书亚人比勒达回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"神有治理之权，有威严可畏；","poem":1},{"lineBreak":true},{"text":"他在高处施行和平。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他的诸军岂能数算？","poem":1},{"lineBreak":true},{"text":"他的光亮一发，谁不蒙照呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"这样在 神面前，人怎能称义？","poem":1},{"lineBreak":true},{"text":"妇人所生的怎能洁净？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在 神眼前，月亮也无光亮，","poem":1},{"lineBreak":true},{"text":"星宿也不清洁。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"何况如虫的人，","poem":1},{"lineBreak":true},{"text":"如蛆的世人呢！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}