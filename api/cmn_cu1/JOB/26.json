{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"约伯回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"无能的人蒙你何等的帮助！","poem":1},{"lineBreak":true},{"text":"膀臂无力的人蒙你何等的拯救！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"无智慧的人蒙你何等的指教！","poem":1},{"lineBreak":true},{"text":"你向他多显大知识！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你向谁发出言语来？","poem":1},{"lineBreak":true},{"text":"谁的灵从你而出？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在大水和水族以下的阴魂战兢。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"在 神面前，阴间显露；","poem":1},{"lineBreak":true},{"text":"灭亡也不得遮掩。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"神将北极铺在空中，","poem":1},{"lineBreak":true},{"text":"将大地悬在虚空；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"将水包在密云中，","poem":1},{"lineBreak":true},{"text":"云却不破裂；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"遮蔽他的宝座，","poem":1},{"lineBreak":true},{"text":"将云铺在其上；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"在水面的周围划出界限，","poem":1},{"lineBreak":true},{"text":"直到光明黑暗的交界。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"天的柱子因他的斥责震动惊奇。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他以能力搅动","poem":1},{"noteId":9},{"text":"大海；","poem":1},{"lineBreak":true},{"text":"他借知识打伤拉哈伯，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"借他的灵使天有妆饰；","poem":1},{"lineBreak":true},{"text":"他的手刺杀快蛇。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"看哪，这不过是 神工作的些微；","poem":1},{"lineBreak":true},{"text":"我们所听于他的是何等细微的声音！","poem":1},{"lineBreak":true},{"text":"他大能的雷声谁能明透呢？","poem":1}]}],"footnotes":[{"noteId":9,"caller":"-","text":"或译：平静","reference":{"chapter":26,"verse":12}}]},"thisChapterLink":"/api/cmn_cu1/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}