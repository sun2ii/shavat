{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"约伯接着说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"神夺去我的理，全能者使我心中愁苦。","poem":1},{"lineBreak":true},{"text":"我指着永生的 神起誓：","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的生命尚在我里面；","poem":1},{"lineBreak":true},{"text":"神所赐呼吸之气仍在我的鼻孔内。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的嘴决不说非义之言；","poem":1},{"lineBreak":true},{"text":"我的舌也不说诡诈之语。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我断不以你们为是；","poem":1},{"lineBreak":true},{"text":"我至死必不以自己为不正！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我持定我的义，必不放松；","poem":1},{"lineBreak":true},{"text":"在世的日子，我心必不责备我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"愿我的仇敌如恶人一样；","poem":1},{"lineBreak":true},{"text":"愿那起来攻击我的，如不义之人一般。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"不敬虔的人虽然得利，","poem":1},{"lineBreak":true},{"text":"神夺取其命的时候还有什么指望呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"患难临到他，","poem":1},{"lineBreak":true},{"text":"神岂能听他的呼求？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他岂以全能者为乐，","poem":1},{"lineBreak":true},{"text":"随时求告 神呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"神的作为，我要指教你们；","poem":1},{"lineBreak":true},{"text":"全能者所行的，我也不隐瞒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你们自己也都见过，","poem":1},{"lineBreak":true},{"text":"为何全然变为虚妄呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"神为恶人所定的分，","poem":1},{"lineBreak":true},{"text":"强暴人从全能者所得的报","poem":1},{"noteId":10},{"text":"乃是这样：","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"倘或他的儿女增多，还是被刀所杀；","poem":1},{"lineBreak":true},{"text":"他的子孙必不得饱食。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他所遗留的人必死而埋葬；","poem":1},{"lineBreak":true},{"text":"他的寡妇也不哀哭。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他虽积蓄银子如尘沙，","poem":1},{"lineBreak":true},{"text":"预备衣服如泥土；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他只管预备，义人却要穿上；","poem":1},{"lineBreak":true},{"text":"他的银子，无辜的人要分取。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他建造房屋如虫做窝，","poem":1},{"lineBreak":true},{"text":"又如守望者所搭的棚。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他虽富足躺卧，却不得收殓，","poem":1},{"lineBreak":true},{"text":"转眼之间就不在了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"惊恐如波涛将他追上；","poem":1},{"lineBreak":true},{"text":"暴风在夜间将他刮去。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"东风把他飘去，","poem":1},{"lineBreak":true},{"text":"又刮他离开本处。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"神要向他射箭，并不留情；","poem":1},{"lineBreak":true},{"text":"他恨不得逃脱 神的手。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"人要向他拍掌，","poem":1},{"lineBreak":true},{"text":"并要发叱声，使他离开本处。","poem":1}]}],"footnotes":[{"noteId":10,"caller":"-","text":"原文是产业","reference":{"chapter":27,"verse":13}}]},"thisChapterLink":"/api/cmn_cu1/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}