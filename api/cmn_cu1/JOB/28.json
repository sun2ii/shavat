{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":28,"content":[{"type":"heading","content":["歌颂智慧"]},{"type":"verse","number":1,"content":[{"text":"银子有矿；","poem":1},{"lineBreak":true},{"text":"炼金有方。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"铁从地里挖出；","poem":1},{"lineBreak":true},{"text":"铜从石中熔化。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人为黑暗定界限，","poem":1},{"lineBreak":true},{"text":"查究幽暗阴翳的石头，直到极处，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"在无人居住之处刨开矿穴，","poem":1},{"lineBreak":true},{"text":"过路的人也想不到他们；","poem":1},{"lineBreak":true},{"text":"又与人远离，悬在空中摇来摇去。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"至于地，能出粮食，","poem":1},{"lineBreak":true},{"text":"地内好像被火翻起来。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"地中的石头有蓝宝石，","poem":1},{"lineBreak":true},{"text":"并有金沙。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"矿中的路鸷鸟不得知道；","poem":1},{"lineBreak":true},{"text":"鹰眼也未见过。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"狂傲的野兽未曾行过；","poem":1},{"lineBreak":true},{"text":"猛烈的狮子也未曾经过。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"人伸手凿开坚石，","poem":1},{"lineBreak":true},{"text":"倾倒山根，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"在磐石中凿出水道，","poem":1},{"lineBreak":true},{"text":"亲眼看见各样宝物。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他封闭水不得滴流，","poem":1},{"lineBreak":true},{"text":"使隐藏的物显露出来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"然而，智慧有何处可寻？","poem":1},{"lineBreak":true},{"text":"聪明之处在哪里呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"智慧的价值无人能知，","poem":1},{"lineBreak":true},{"text":"在活人之地也无处可寻。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"深渊说：不在我内；","poem":1},{"lineBreak":true},{"text":"沧海说：不在我中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"智慧非用黄金可得，","poem":1},{"lineBreak":true},{"text":"也不能平白银为它的价值。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"俄斐金和贵重的红玛瑙，","poem":1},{"lineBreak":true},{"text":"并蓝宝石，不足与较量；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"黄金和玻璃不足与比较；","poem":1},{"lineBreak":true},{"text":"精金的器皿不足与兑换。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"珊瑚、水晶都不足论；","poem":1},{"lineBreak":true},{"text":"智慧的价值胜过珍珠","poem":1},{"noteId":11},{"text":"。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"古实的红璧玺不足与比较；","poem":1},{"lineBreak":true},{"text":"精金也不足与较量。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"智慧从何处来呢？","poem":1},{"lineBreak":true},{"text":"聪明之处在哪里呢？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"是向一切有生命的眼目隐藏，","poem":1},{"lineBreak":true},{"text":"向空中的飞鸟掩蔽。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"灭没和死亡说：","poem":1},{"lineBreak":true},{"text":"我们风闻其名。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"神明白智慧的道路，","poem":1},{"lineBreak":true},{"text":"晓得智慧的所在。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"因他鉴察直到地极，","poem":1},{"lineBreak":true},{"text":"遍观普天之下，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"要为风定轻重，","poem":1},{"lineBreak":true},{"text":"又度量诸水；","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他为雨露定命令，","poem":1},{"lineBreak":true},{"text":"为雷电定道路。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"那时他看见智慧，而且述说；","poem":1},{"lineBreak":true},{"text":"他坚定，并且查究。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他对人说：敬畏主就是智慧；","poem":1},{"lineBreak":true},{"text":"远离恶便是聪明。","poem":1}]}],"footnotes":[{"noteId":11,"caller":"-","text":"或译：红宝石","reference":{"chapter":28,"verse":18}}]},"thisChapterLink":"/api/cmn_cu1/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}