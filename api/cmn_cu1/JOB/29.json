{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":29,"content":[{"type":"heading","content":["约伯最后的申诉"]},{"type":"verse","number":1,"content":[{"text":"约伯又接着说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"惟愿我的景况如从前的月份，","poem":1},{"lineBreak":true},{"text":"如 神保守我的日子。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"那时他的灯照在我头上；","poem":1},{"lineBreak":true},{"text":"我借他的光行过黑暗。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我愿如壮年的时候：","poem":1},{"lineBreak":true},{"text":"那时我在帐棚中，","poem":1},{"lineBreak":true},{"text":"神待我有密友之情；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"全能者仍与我同在；","poem":1},{"lineBreak":true},{"text":"我的儿女都环绕我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"奶多可洗我的脚；","poem":1},{"lineBreak":true},{"text":"磐石为我出油成河。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我出到城门，","poem":1},{"lineBreak":true},{"text":"在街上设立座位；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"少年人见我而回避，","poem":1},{"lineBreak":true},{"text":"老年人也起身站立；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"王子都停止说话，","poem":1},{"lineBreak":true},{"text":"用手捂口；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"首领静默无声，","poem":1},{"lineBreak":true},{"text":"舌头贴住上膛。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耳朵听我的，就称我有福；","poem":1},{"lineBreak":true},{"text":"眼睛看我的，便称赞我；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因我拯救哀求的困苦人","poem":1},{"lineBreak":true},{"text":"和无人帮助的孤儿。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"将要灭亡的为我祝福；","poem":1},{"lineBreak":true},{"text":"我也使寡妇心中欢乐。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我以公义为衣服，","poem":1},{"lineBreak":true},{"text":"以公平为外袍和冠冕。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我为瞎子的眼，","poem":1},{"lineBreak":true},{"text":"瘸子的脚。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我为穷乏人的父；","poem":1},{"lineBreak":true},{"text":"素不认识的人，我查明他的案件。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我打破不义之人的牙床，","poem":1},{"lineBreak":true},{"text":"从他牙齿中夺了所抢的。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我便说：我必死在家中","poem":1},{"noteId":12},{"text":"，","poem":1},{"lineBreak":true},{"text":"必增添我的日子，多如尘沙。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的根长到水边；","poem":1},{"lineBreak":true},{"text":"露水终夜沾在我的枝上。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的荣耀在身上增新；","poem":1},{"lineBreak":true},{"text":"我的弓在手中日强。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"人听见我而仰望，","poem":1},{"lineBreak":true},{"text":"静默等候我的指教。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我说话之后，他们就不再说；","poem":1},{"lineBreak":true},{"text":"我的言语像雨露滴在他们身上。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他们仰望我如仰望雨，","poem":1},{"lineBreak":true},{"text":"又张开口如切慕春雨。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他们不敢自信，我就向他们含笑；","poem":1},{"lineBreak":true},{"text":"他们不使我脸上的光改变。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我为他们选择道路，又坐首位；","poem":1},{"lineBreak":true},{"text":"我如君王在军队中居住，","poem":1},{"lineBreak":true},{"text":"又如吊丧的安慰伤心的人。","poem":1}]}],"footnotes":[{"noteId":12,"caller":"-","text":"原文是窝中","reference":{"chapter":29,"verse":18}}]},"thisChapterLink":"/api/cmn_cu1/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}