{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":3,"content":[{"type":"heading","content":["约伯咒诅自己"]},{"type":"verse","number":1,"content":["此后，约伯开口咒诅自己的生日，"]},{"type":"verse","number":2,"content":["说："]},{"type":"verse","number":3,"content":[{"text":"愿我生的那日","poem":1},{"lineBreak":true},{"text":"和说怀了男胎的那夜都灭没。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"愿那日变为黑暗；","poem":1},{"lineBreak":true},{"text":"愿 神不从上面寻找它；","poem":1},{"lineBreak":true},{"text":"愿亮光不照于其上。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愿黑暗和死荫索取那日；","poem":1},{"lineBreak":true},{"text":"愿密云停在其上；","poem":1},{"lineBreak":true},{"text":"愿日蚀恐吓它。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愿那夜被幽暗夺取，","poem":1},{"lineBreak":true},{"text":"不在年中的日子同乐，","poem":1},{"lineBreak":true},{"text":"也不入月中的数目。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愿那夜没有生育，","poem":1},{"lineBreak":true},{"text":"其间也没有欢乐的声音。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愿那咒诅日子且能惹动鳄鱼的","poem":1},{"lineBreak":true},{"text":"咒诅那夜。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愿那夜黎明的星宿变为黑暗，","poem":1},{"lineBreak":true},{"text":"盼亮却不亮，","poem":1},{"lineBreak":true},{"text":"也不见早晨的光线","poem":1},{"noteId":1},{"text":"；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因没有把怀我胎的门关闭，","poem":1},{"lineBreak":true},{"text":"也没有将患难对我的眼隐藏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我为何不出母胎而死？","poem":1},{"lineBreak":true},{"text":"为何不出母腹绝气？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"为何有膝接收我？","poem":1},{"lineBreak":true},{"text":"为何有奶哺养我？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"不然，我就早已躺卧安睡，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"和地上为自己重造荒邱的君王、谋士，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"或与有金子、将银子装满了房屋的王子","poem":1},{"lineBreak":true},{"text":"一同安息；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"或像隐而未现、不到期而落的胎，","poem":1},{"lineBreak":true},{"text":"归于无有，如同未见光的婴孩。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"在那里恶人止息搅扰，","poem":1},{"lineBreak":true},{"text":"困乏人得享安息，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"被囚的人同得安逸，","poem":1},{"lineBreak":true},{"text":"不听见督工的声音。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"大小都在那里；","poem":1},{"lineBreak":true},{"text":"奴仆脱离主人的辖制。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"受患难的人为何有光赐给他呢？","poem":1},{"lineBreak":true},{"text":"心中愁苦的人为何有生命赐给他呢？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们切望死，却不得死；","poem":1},{"lineBreak":true},{"text":"求死，胜于求隐藏的珍宝。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他们寻见坟墓就快乐，","poem":1},{"lineBreak":true},{"text":"极其欢喜。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"人的道路既然遮隐，","poem":1},{"lineBreak":true},{"text":"神又把他四面围困，","poem":1},{"lineBreak":true},{"text":"为何有光赐给他呢？","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我未曾吃饭就发出叹息；","poem":1},{"lineBreak":true},{"text":"我唉哼的声音涌出如水。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"因我所恐惧的临到我身，","poem":1},{"lineBreak":true},{"text":"我所惧怕的迎我而来。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我不得安逸，不得平静，","poem":1},{"lineBreak":true},{"text":"也不得安息，却有患难来到。","poem":1}]}],"footnotes":[{"noteId":1,"caller":"-","text":"原文是眼皮","reference":{"chapter":3,"verse":9}}]},"thisChapterLink":"/api/cmn_cu1/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}