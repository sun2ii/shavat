{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"但如今，比我年少的人戏笑我；","poem":1},{"lineBreak":true},{"text":"其人之父我曾藐视，","poem":1},{"lineBreak":true},{"text":"不肯安在看守我羊群的狗中。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他们壮年的气力既已衰败，","poem":1},{"lineBreak":true},{"text":"其手之力与我何益呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们因穷乏饥饿，身体枯瘦，","poem":1},{"lineBreak":true},{"text":"在荒废凄凉的幽暗中啃干燥之地，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"在草丛之中采咸草，","poem":1},{"lineBreak":true},{"text":"罗腾","poem":1},{"noteId":13},{"text":"的根为他们的食物。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们从人中被赶出；","poem":1},{"lineBreak":true},{"text":"人追喊他们如贼一般，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"以致他们住在荒谷之间，","poem":1},{"lineBreak":true},{"text":"在地洞和岩穴中；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"在草丛中叫唤，","poem":1},{"lineBreak":true},{"text":"在荆棘下聚集。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"这都是愚顽下贱人的儿女；","poem":1},{"lineBreak":true},{"text":"他们被鞭打，赶出境外。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"现在这些人以我为歌曲，","poem":1},{"lineBreak":true},{"text":"以我为笑谈。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们厌恶我，躲在旁边站着，","poem":1},{"lineBreak":true},{"text":"不住地吐唾沫在我脸上。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"松开他们的绳索苦待我，","poem":1},{"lineBreak":true},{"text":"在我面前脱去辔头。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"这等下流人在我右边起来，","poem":1},{"lineBreak":true},{"text":"推开我的脚，筑成战路来攻击我。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"这些无人帮助的，","poem":1},{"lineBreak":true},{"text":"毁坏我的道，加增我的灾。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们来如同闯进大破口，","poem":1},{"lineBreak":true},{"text":"在毁坏之间滚在我身上。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"惊恐临到我，","poem":1},{"lineBreak":true},{"text":"驱逐我的尊荣如风；","poem":1},{"lineBreak":true},{"text":"我的福禄如云过去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"现在我心极其悲伤；","poem":1},{"lineBreak":true},{"text":"困苦的日子将我抓住。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"夜间，我里面的骨头刺我，","poem":1},{"lineBreak":true},{"text":"疼痛不止，好像啃我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因 神的大力，我的外衣污秽不堪，","poem":1},{"lineBreak":true},{"text":"又如里衣的领子将我缠住。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"神把我扔在淤泥中，","poem":1},{"lineBreak":true},{"text":"我就像尘土和炉灰一般。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"主啊，我呼求你，你不应允我；","poem":1},{"lineBreak":true},{"text":"我站起来，你就定睛看我。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你向我变心，待我残忍，","poem":1},{"lineBreak":true},{"text":"又用大能追逼我，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"把我提在风中，使我驾风而行，","poem":1},{"lineBreak":true},{"text":"又使我消灭在烈风中。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我知道要使我临到死地，","poem":1},{"lineBreak":true},{"text":"到那为众生所定的阴宅。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"然而，人仆倒岂不伸手？","poem":1},{"lineBreak":true},{"text":"遇灾难岂不求救呢？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"人遭难，我岂不为他哭泣呢？","poem":1},{"lineBreak":true},{"text":"人穷乏，我岂不为他忧愁呢？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我仰望得好处，灾祸就到了；","poem":1},{"lineBreak":true},{"text":"我等待光明，黑暗便来了。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我心里烦扰不安，","poem":1},{"lineBreak":true},{"text":"困苦的日子临到我身。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我没有日光就哀哭行去","poem":1},{"noteId":14},{"text":"；","poem":1},{"lineBreak":true},{"text":"我在会中站着求救。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我与野狗为弟兄，","poem":1},{"lineBreak":true},{"text":"与鸵鸟为同伴。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我的皮肤黑而脱落；","poem":1},{"lineBreak":true},{"text":"我的骨头因热烧焦。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"所以，我的琴音变为悲音；","poem":1},{"lineBreak":true},{"text":"我的箫声变为哭声。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"小树名，松类","reference":{"chapter":30,"verse":4}},{"noteId":14,"caller":"-","text":"或译：我面发黑并非因日晒","reference":{"chapter":30,"verse":28}}]},"thisChapterLink":"/api/cmn_cu1/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}