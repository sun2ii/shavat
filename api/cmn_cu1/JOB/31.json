{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"我与眼睛立约，","poem":1},{"lineBreak":true},{"text":"怎能恋恋瞻望处女呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"从至上的 神所得之分，","poem":1},{"lineBreak":true},{"text":"从至高全能者所得之业是什么呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"岂不是祸患临到不义的，","poem":1},{"lineBreak":true},{"text":"灾害临到作孽的呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"神岂不是察看我的道路，","poem":1},{"lineBreak":true},{"text":"数点我的脚步呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我若与虚谎同行，","poem":1},{"lineBreak":true},{"text":"脚若追随诡诈；","poem":1},{"lineBreak":true},{"text":"（","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我若被公道的天平称度，","poem":1},{"lineBreak":true},{"text":"使 神可以知道我的纯正；）","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的脚步若偏离正路，","poem":1},{"lineBreak":true},{"text":"我的心若随着我的眼目，","poem":1},{"lineBreak":true},{"text":"若有玷污粘在我手上；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"就愿我所种的有别人吃，","poem":1},{"lineBreak":true},{"text":"我田所产的被拔出来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我若受迷惑，向妇人起淫念，","poem":1},{"lineBreak":true},{"text":"在邻舍的门外蹲伏，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"就愿我的妻子给别人推磨，","poem":1},{"lineBreak":true},{"text":"别人也与她同室。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因为这是大罪，","poem":1},{"lineBreak":true},{"text":"是审判官当罚的罪孽。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"这本是火焚烧，直到毁灭，","poem":1},{"lineBreak":true},{"text":"必拔除我所有的家产。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我的仆婢与我争辩的时候，","poem":1},{"lineBreak":true},{"text":"我若藐视不听他们的情节；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"神兴起，我怎样行呢？","poem":1},{"lineBreak":true},{"text":"他察问，我怎样回答呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"造我在腹中的，不也是造他吗？","poem":1},{"lineBreak":true},{"text":"将他与我抟在腹中的岂不是一位吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"我若不容贫寒人得其所愿，","poem":1},{"lineBreak":true},{"text":"或叫寡妇眼中失望，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"或独自吃我一点食物，","poem":1},{"lineBreak":true},{"text":"孤儿没有与我同吃；","poem":1},{"lineBreak":true},{"text":"（","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"从幼年时孤儿与我同长，好像父子一样；","poem":1},{"lineBreak":true},{"text":"我从出母腹就扶助","poem":1},{"noteId":15},{"text":"寡妇。）","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我若见人因无衣死亡，","poem":1},{"lineBreak":true},{"text":"或见穷乏人身无遮盖；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我若不使他因我羊的毛得暖，","poem":1},{"lineBreak":true},{"text":"为我祝福；","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我若在城门口见有帮助我的，","poem":1},{"lineBreak":true},{"text":"举手攻击孤儿；","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"情愿我的肩头从缺盆骨脱落，","poem":1},{"lineBreak":true},{"text":"我的膀臂从羊矢骨折断。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"因 神降的灾祸使我恐惧；","poem":1},{"lineBreak":true},{"text":"因他的威严，我不能妄为。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"我若以黄金为指望，","poem":1},{"lineBreak":true},{"text":"对精金说：你是我的倚靠；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我若因财物丰裕，","poem":1},{"lineBreak":true},{"text":"因我手多得资财而欢喜；","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我若见太阳发光，","poem":1},{"lineBreak":true},{"text":"明月行在空中，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"心就暗暗被引诱，","poem":1},{"lineBreak":true},{"text":"口便亲手；","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"这也是审判官当罚的罪孽，","poem":1},{"lineBreak":true},{"text":"又是我背弃在上的 神。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"我若见恨我的遭报就欢喜，","poem":1},{"lineBreak":true},{"text":"见他遭灾便高兴；","poem":1},{"lineBreak":true},{"text":"（","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我没有容口犯罪，","poem":1},{"lineBreak":true},{"text":"咒诅他的生命；）","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"若我帐棚的人未尝说，","poem":1},{"lineBreak":true},{"text":"谁不以主人的食物吃饱呢？","poem":1},{"lineBreak":true},{"text":"（","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"从来我没有容客旅在街上住宿，","poem":1},{"lineBreak":true},{"text":"却开门迎接行路的人；）","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"我若像亚当","poem":1},{"noteId":16},{"text":"遮掩我的过犯，","poem":1},{"lineBreak":true},{"text":"将罪孽藏在怀中；","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"因惧怕大众，","poem":1},{"lineBreak":true},{"text":"又因宗族藐视我使我惊恐，","poem":1},{"lineBreak":true},{"text":"以致闭口无言，杜门不出；","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"惟愿有一位肯听我！","poem":1},{"lineBreak":true},{"text":"（看哪，在这里有我所划的押，","poem":1},{"lineBreak":true},{"text":"愿全能者回答我！）","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"愿那敌我者所写的状词在我这里！","poem":1},{"lineBreak":true},{"text":"我必带在肩上，又绑在头上为冠冕。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"我必向他述说我脚步的数目，","poem":1},{"lineBreak":true},{"text":"必如君王进到他面前。","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"我若夺取田地，这地向我喊冤，","poem":1},{"lineBreak":true},{"text":"犁沟一同哭泣；","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"我若吃地的出产不给价值，","poem":1},{"lineBreak":true},{"text":"或叫原主丧命；","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"愿这地长蒺藜代替麦子，","poem":1},{"lineBreak":true},{"text":"长恶草代替大麦。","poem":1},{"lineBreak":true},{"text":"约伯的话说完了。","poem":1}]}],"footnotes":[{"noteId":15,"caller":"-","text":"原文是引领","reference":{"chapter":31,"verse":18}},{"noteId":16,"caller":"-","text":"或译：别人","reference":{"chapter":31,"verse":33}}]},"thisChapterLink":"/api/cmn_cu1/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}