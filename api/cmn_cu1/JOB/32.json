{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":32,"content":[{"type":"heading","content":["以利户的话"]},{"type":"verse","number":1,"content":["于是这三个人，因约伯自以为义就不再回答他。"]},{"type":"verse","number":2,"content":["那时有布西人兰族巴拉迦的儿子以利户向约伯发怒；因约伯自以为义，不以 神为义。"]},{"type":"verse","number":3,"content":["他又向约伯的三个朋友发怒；因为他们想不出回答的话来，仍以约伯为有罪。"]},{"type":"verse","number":4,"content":["以利户要与约伯说话，就等候他们，因为他们比自己年老。"]},{"type":"verse","number":5,"content":["以利户见这三个人口中无话回答，就怒气发作。"]},{"type":"verse","number":6,"content":["布西人巴拉迦的儿子以利户回答说：",{"lineBreak":true},{"text":"我年轻，你们老迈；","poem":1},{"lineBreak":true},{"text":"因此我退让，不敢向你们陈说我的意见。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我说，年老的当先说话；","poem":1},{"lineBreak":true},{"text":"寿高的当以智慧教训人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"但在人里面有灵；","poem":1},{"lineBreak":true},{"text":"全能者的气使人有聪明。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"尊贵的不都有智慧；","poem":1},{"lineBreak":true},{"text":"寿高的不都能明白公平。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因此我说：你们要听我言；","poem":1},{"lineBreak":true},{"text":"我也要陈说我的意见。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你们查究所要说的话；","poem":1},{"lineBreak":true},{"text":"那时我等候你们的话，","poem":1},{"lineBreak":true},{"text":"侧耳听你们的辩论，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"留心听你们；","poem":1},{"lineBreak":true},{"text":"谁知你们中间无一人折服约伯，","poem":1},{"lineBreak":true},{"text":"驳倒他的话。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你们切不可说：我们寻得智慧；","poem":1},{"lineBreak":true},{"text":"神能胜他，人却不能。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"约伯没有向我争辩；","poem":1},{"lineBreak":true},{"text":"我也不用你们的话回答他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"他们惊奇不再回答，","poem":1},{"lineBreak":true},{"text":"一言不发。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我岂因他们不说话，","poem":1},{"lineBreak":true},{"text":"站住不再回答，仍旧等候呢？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我也要回答我的一分话，","poem":1},{"lineBreak":true},{"text":"陈说我的意见。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因为我的言语满怀；","poem":1},{"lineBreak":true},{"text":"我里面的灵激动我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的胸怀如盛酒之囊没有出气之缝，","poem":1},{"lineBreak":true},{"text":"又如新皮袋快要破裂。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我要说话，使我舒畅；","poem":1},{"lineBreak":true},{"text":"我要开口回答。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我必不看人的情面，","poem":1},{"lineBreak":true},{"text":"也不奉承人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我不晓得奉承；","poem":1},{"lineBreak":true},{"text":"若奉承，造我的主必快快除灭我。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}