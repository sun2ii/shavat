{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"约伯啊，请听我的话，","poem":1},{"lineBreak":true},{"text":"留心听我一切的言语。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我现在开口，","poem":1},{"lineBreak":true},{"text":"用舌发言。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的言语要发明心中所存的正直；","poem":1},{"lineBreak":true},{"text":"我所知道的，我嘴唇要诚实地说出。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"神的灵造我；","poem":1},{"lineBreak":true},{"text":"全能者的气使我得生。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你若回答我，","poem":1},{"lineBreak":true},{"text":"就站起来，在我面前陈明。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我在 神面前与你一样，","poem":1},{"lineBreak":true},{"text":"也是用土造成。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我不用威严惊吓你，","poem":1},{"lineBreak":true},{"text":"也不用势力重压你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你所说的，我听见了，","poem":1},{"lineBreak":true},{"text":"也听见你的言语，说：","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我是清洁无过的，我是无辜的；","poem":1},{"lineBreak":true},{"text":"在我里面也没有罪孽。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"神找机会攻击我，","poem":1},{"lineBreak":true},{"text":"以我为仇敌，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"把我的脚上了木狗，","poem":1},{"lineBreak":true},{"text":"窥察我一切的道路。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"我要回答你说：你这话无理，","poem":1},{"lineBreak":true},{"text":"因 神比世人更大。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你为何与他争论呢？","poem":1},{"lineBreak":true},{"text":"因他的事都不对人解说？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"神说一次、两次，","poem":1},{"lineBreak":true},{"text":"世人却不理会。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"人躺在床上沉睡的时候，","poem":1},{"lineBreak":true},{"text":"神就用梦和夜间的异象，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"开通他们的耳朵，","poem":1},{"lineBreak":true},{"text":"将当受的教训印在他们心上，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"好叫人不从自己的谋算，","poem":1},{"lineBreak":true},{"text":"不行骄傲的事","poem":1},{"noteId":17},{"text":"，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"拦阻人不陷于坑里，","poem":1},{"lineBreak":true},{"text":"不死在刀下。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"人在床上被惩治，","poem":1},{"lineBreak":true},{"text":"骨头中不住地疼痛，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"以致他的口厌弃食物，","poem":1},{"lineBreak":true},{"text":"心厌恶美味。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他的肉消瘦，不得再见；","poem":1},{"lineBreak":true},{"text":"先前不见的骨头都凸出来。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他的灵魂临近深坑；","poem":1},{"lineBreak":true},{"text":"他的生命近于灭命的。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"一千天使中，","poem":1},{"lineBreak":true},{"text":"若有一个作传话的与 神同在，","poem":1},{"lineBreak":true},{"text":"指示人所当行的事，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"神就给他开恩，","poem":1},{"lineBreak":true},{"text":"说：救赎他免得下坑；","poem":1},{"lineBreak":true},{"text":"我已经得了赎价。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他的肉要比孩童的肉更嫩；","poem":1},{"lineBreak":true},{"text":"他就返老还童。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他祷告 神，","poem":1},{"lineBreak":true},{"text":"神就喜悦他，","poem":1},{"lineBreak":true},{"text":"使他欢呼朝见 神的面；","poem":1},{"lineBreak":true},{"text":"神又看他为义。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他在人前歌唱说：","poem":1},{"lineBreak":true},{"text":"我犯了罪，颠倒是非，","poem":1},{"lineBreak":true},{"text":"这竟与我无益。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"神救赎我的灵魂免入深坑；","poem":1},{"lineBreak":true},{"text":"我的生命也必见光。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"神两次、三次向人行这一切的事，","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"为要从深坑救回人的灵魂，","poem":1},{"lineBreak":true},{"text":"使他被光照耀，与活人一样。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"约伯啊，你当侧耳听我的话，","poem":1},{"lineBreak":true},{"text":"不要作声，等我讲说。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"你若有话说，就可以回答我；","poem":1},{"lineBreak":true},{"text":"你只管说，因我愿以你为是。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"若不然，你就听我说；","poem":1},{"lineBreak":true},{"text":"你不要作声，我便将智慧教训你。","poem":1}]}],"footnotes":[{"noteId":17,"caller":"-","text":"原文是将骄傲向人隐藏","reference":{"chapter":33,"verse":17}}]},"thisChapterLink":"/api/cmn_cu1/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}