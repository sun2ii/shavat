{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":[{"text":"以利户又说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们智慧人要听我的话；","poem":1},{"lineBreak":true},{"text":"有知识的人要留心听我说。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为耳朵试验话语，","poem":1},{"lineBreak":true},{"text":"好像上膛尝食物。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们当选择何为是，","poem":1},{"lineBreak":true},{"text":"彼此知道何为善。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"约伯曾说：我是公义，","poem":1},{"lineBreak":true},{"text":"神夺去我的理；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我虽有理，还算为说谎言的；","poem":1},{"lineBreak":true},{"text":"我虽无过，受的伤还不能医治。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"谁像约伯，","poem":1},{"lineBreak":true},{"text":"喝讥诮如同喝水呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他与作孽的结伴，","poem":1},{"lineBreak":true},{"text":"和恶人同行。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他说：人以 神为乐，","poem":1},{"lineBreak":true},{"text":"总是无益。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"所以，你们明理的人要听我的话。","poem":1},{"lineBreak":true},{"text":"神断不致行恶；","poem":1},{"lineBreak":true},{"text":"全能者断不致作孽。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他必按人所做的报应人，","poem":1},{"lineBreak":true},{"text":"使各人照所行的得报。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"神必不作恶；","poem":1},{"lineBreak":true},{"text":"全能者也不偏离公平。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"谁派他治理地，","poem":1},{"lineBreak":true},{"text":"安定全世界呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他若专心为己，","poem":1},{"lineBreak":true},{"text":"将灵和气收归自己，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"凡有血气的就必一同死亡；","poem":1},{"lineBreak":true},{"text":"世人必仍归尘土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"你若明理，就当听我的话，","poem":1},{"lineBreak":true},{"text":"留心听我言语的声音。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"难道恨恶公平的可以掌权吗？","poem":1},{"lineBreak":true},{"text":"那有公义的、有大能的，岂可定他有罪吗？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他对君王说：你是鄙陋的；","poem":1},{"lineBreak":true},{"text":"对贵臣说：你是邪恶的。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他待王子不徇情面，","poem":1},{"lineBreak":true},{"text":"也不看重富足的过于贫穷的，","poem":1},{"lineBreak":true},{"text":"因为都是他手所造。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"在转眼之间，半夜之中，","poem":1},{"lineBreak":true},{"text":"他们就死亡。","poem":1},{"lineBreak":true},{"text":"百姓被震动而去世；","poem":1},{"lineBreak":true},{"text":"有权力的被夺去非借人手。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"神注目观看人的道路，","poem":1},{"lineBreak":true},{"text":"看明人的脚步。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"没有黑暗、阴翳能给作孽的藏身。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"神审判人，不必使人到他面前再三鉴察。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他用难测之法打破有能力的人，","poem":1},{"lineBreak":true},{"text":"设立别人代替他们。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他原知道他们的行为，","poem":1},{"lineBreak":true},{"text":"使他们在夜间倾倒灭亡。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他在众人眼前击打他们，","poem":1},{"lineBreak":true},{"text":"如同击打恶人一样。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"因为他们偏行不跟从他，","poem":1},{"lineBreak":true},{"text":"也不留心他的道，","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"甚至使贫穷人的哀声达到他那里；","poem":1},{"lineBreak":true},{"text":"他也听了困苦人的哀声。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"他使人安静，谁能扰乱","poem":1},{"noteId":18},{"text":"呢？","poem":1},{"lineBreak":true},{"text":"他掩面，谁能见他呢？","poem":1},{"lineBreak":true},{"text":"无论待一国或一人都是如此—","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"使不虔敬的人不得作王，","poem":1},{"lineBreak":true},{"text":"免得有人牢笼百姓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"有谁对 神说：","poem":1},{"lineBreak":true},{"text":"我受了责罚，不再犯罪；","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我所看不明的，求你指教我；","poem":1},{"lineBreak":true},{"text":"我若作了孽，必不再作？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他施行报应，","poem":1},{"lineBreak":true},{"text":"岂要随你的心愿、叫你推辞不受吗？","poem":1},{"lineBreak":true},{"text":"选定的是你，不是我。","poem":1},{"lineBreak":true},{"text":"你所知道的只管说吧！","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"明理的人和听我话的智慧人必对我说：","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"约伯说话没有知识，","poem":1},{"lineBreak":true},{"text":"言语中毫无智慧。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"愿约伯被试验到底，","poem":1},{"lineBreak":true},{"text":"因他回答像恶人一样。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"他在罪上又加悖逆；","poem":1},{"lineBreak":true},{"text":"在我们中间拍手，","poem":1},{"lineBreak":true},{"text":"用许多言语轻慢 神。","poem":1}]}],"footnotes":[{"noteId":18,"caller":"-","text":"或译：定罪","reference":{"chapter":34,"verse":29}}]},"thisChapterLink":"/api/cmn_cu1/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}