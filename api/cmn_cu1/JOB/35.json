{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":[{"text":"以利户又说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你以为有理，","poem":1},{"lineBreak":true},{"text":"或以为你的公义胜于 神的公义，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"才说这与我有什么益处？","poem":1},{"lineBreak":true},{"text":"我不犯罪比犯罪有什么好处呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要回答你和在你这里的朋友。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你要向天观看，","poem":1},{"lineBreak":true},{"text":"瞻望那高于你的穹苍。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你若犯罪，能使 神受何害呢？","poem":1},{"lineBreak":true},{"text":"你的过犯加增，能使 神受何损呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你若是公义，还能加增他什么呢？","poem":1},{"lineBreak":true},{"text":"他从你手里还接受什么呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你的过恶或能害你这类的人；","poem":1},{"lineBreak":true},{"text":"你的公义或能叫世人得益处。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"人因多受欺压就哀求，","poem":1},{"lineBreak":true},{"text":"因受能者的辖制","poem":1},{"noteId":19},{"text":"便求救，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"却无人说：造我的 神在哪里？","poem":1},{"lineBreak":true},{"text":"他使人夜间歌唱，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"教训我们胜于地上的走兽，","poem":1},{"lineBreak":true},{"text":"使我们有聪明胜于空中的飞鸟。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们在那里，","poem":1},{"lineBreak":true},{"text":"因恶人的骄傲呼求，却无人答应。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"虚妄的呼求， 神必不垂听；","poem":1},{"lineBreak":true},{"text":"全能者也必不眷顾。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"何况你说，你不得见他；","poem":1},{"lineBreak":true},{"text":"你的案件在他面前，你等候他吧。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"但如今因他未曾发怒降罚，","poem":1},{"lineBreak":true},{"text":"也不甚理会狂傲，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"所以约伯开口说虚妄的话，","poem":1},{"lineBreak":true},{"text":"多发无知识的言语。","poem":1}]}],"footnotes":[{"noteId":19,"caller":"-","text":"原文是膀臂","reference":{"chapter":35,"verse":9}}]},"thisChapterLink":"/api/cmn_cu1/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}