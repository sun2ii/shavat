{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":[{"text":"以利户又接着说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你再容我片时，我就指示你，","poem":1},{"lineBreak":true},{"text":"因我还有话为 神说。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我要将所知道的从远处引来，","poem":1},{"lineBreak":true},{"text":"将公义归给造我的主。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的言语真不虚谎；","poem":1},{"lineBreak":true},{"text":"有知识全备的与你同在。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"神有大能，并不藐视人；","poem":1},{"lineBreak":true},{"text":"他的智慧甚广。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他不保护恶人的性命，","poem":1},{"lineBreak":true},{"text":"却为困苦人伸冤。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他时常看顾义人，","poem":1},{"lineBreak":true},{"text":"使他们和君王同坐宝座，","poem":1},{"lineBreak":true},{"text":"永远要被高举。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们若被锁链捆住，","poem":1},{"lineBreak":true},{"text":"被苦难的绳索缠住，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他就把他们的作为和过犯指示他们，","poem":1},{"lineBreak":true},{"text":"叫他们知道有骄傲的行动。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他也开通他们的耳朵得受教训，","poem":1},{"lineBreak":true},{"text":"吩咐他们离开罪孽转回。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们若听从事奉他，","poem":1},{"lineBreak":true},{"text":"就必度日亨通，历年福乐；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"若不听从，","poem":1},{"lineBreak":true},{"text":"就要被刀杀灭，无知无识而死。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"那心中不敬虔的人积蓄怒气；","poem":1},{"lineBreak":true},{"text":"神捆绑他们，他们竟不求救；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"必在青年时死亡，","poem":1},{"lineBreak":true},{"text":"与污秽人一样丧命。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"神借着困苦救拔困苦人，","poem":1},{"lineBreak":true},{"text":"趁他们受欺压开通他们的耳朵。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"神也必引你出离患难，","poem":1},{"lineBreak":true},{"text":"进入宽阔不狭窄之地；","poem":1},{"lineBreak":true},{"text":"摆在你席上的必满有肥甘。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"但你满口有恶人批评的言语；","poem":1},{"lineBreak":true},{"text":"判断和刑罚抓住你。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"不可容忿怒触动你，使你不服责罚；","poem":1},{"lineBreak":true},{"text":"也不可因赎价大就偏行。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你的呼求","poem":1},{"noteId":20},{"text":"，或是你一切的势力，","poem":1},{"lineBreak":true},{"text":"果有灵验，叫你不受患难吗？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"不要切慕黑夜，","poem":1},{"lineBreak":true},{"text":"就是众民在本处被除灭的时候。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你要谨慎，不可重看罪孽，","poem":1},{"lineBreak":true},{"text":"因你选择罪孽过于选择苦难。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"神行事有高大的能力；","poem":1},{"lineBreak":true},{"text":"教训人的有谁像他呢？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"谁派定他的道路？","poem":1},{"lineBreak":true},{"text":"谁能说：你所行的不义？","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"你不可忘记称赞他所行的为大，","poem":1},{"lineBreak":true},{"text":"就是人所歌颂的。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他所行的，万人都看见；","poem":1},{"lineBreak":true},{"text":"世人也从远处观看。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"神为大，我们不能全知；","poem":1},{"lineBreak":true},{"text":"他的年数不能测度。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他吸取水点，","poem":1},{"lineBreak":true},{"text":"这水点从云雾中就变成雨；","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"云彩将雨落下，沛然降与世人。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"谁能明白云彩如何铺张，","poem":1},{"lineBreak":true},{"text":"和 神行宫的雷声呢？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他将亮光普照在自己的四围；","poem":1},{"lineBreak":true},{"text":"他又遮覆海底。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他用这些审判众民，","poem":1},{"lineBreak":true},{"text":"且赐丰富的粮食。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他以电光遮手，","poem":1},{"lineBreak":true},{"text":"命闪电击中敌人","poem":1},{"noteId":21},{"text":"。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"所发的雷声显明他的作为，","poem":1},{"lineBreak":true},{"text":"又向牲畜指明要起暴风。","poem":1}]}],"footnotes":[{"noteId":20,"caller":"-","text":"或译：资财","reference":{"chapter":36,"verse":19}},{"noteId":21,"caller":"-","text":"或译：中了靶子","reference":{"chapter":36,"verse":32}}]},"thisChapterLink":"/api/cmn_cu1/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}