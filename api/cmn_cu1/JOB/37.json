{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"因此我心战兢，","poem":1},{"lineBreak":true},{"text":"从原处移动。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"听啊， 神轰轰的声音","poem":1},{"lineBreak":true},{"text":"是他口中所发的响声。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他发响声震遍天下，","poem":1},{"lineBreak":true},{"text":"发电光闪到地极。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"随后人听见有雷声轰轰，大发威严，","poem":1},{"lineBreak":true},{"text":"雷电接连不断。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"神发出奇妙的雷声；","poem":1},{"lineBreak":true},{"text":"他行大事，我们不能测透。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他对雪说：要降在地上；","poem":1},{"lineBreak":true},{"text":"对大雨和暴雨也是这样说。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他封住各人的手，","poem":1},{"lineBreak":true},{"text":"叫所造的万人都晓得他的作为。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"百兽进入穴中，","poem":1},{"lineBreak":true},{"text":"卧在洞内。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"暴风出于南宫；","poem":1},{"lineBreak":true},{"text":"寒冷出于北方。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"神嘘气成冰；","poem":1},{"lineBreak":true},{"text":"宽阔之水也都凝结。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他使密云盛满水气，","poem":1},{"lineBreak":true},{"text":"布散电光之云；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"这云是借他的指引游行旋转，","poem":1},{"lineBreak":true},{"text":"得以在全地面上行他一切所吩咐的，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"或为责罚，或为润地，","poem":1},{"lineBreak":true},{"text":"或为施行慈爱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"约伯啊，你要留心听，","poem":1},{"lineBreak":true},{"text":"要站立思想 神奇妙的作为。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"神如何吩咐这些，","poem":1},{"lineBreak":true},{"text":"如何使云中的电光照耀，你知道吗？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"云彩如何浮于空中，","poem":1},{"lineBreak":true},{"text":"那知识全备者奇妙的作为，你知道吗？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"南风使地寂静，","poem":1},{"lineBreak":true},{"text":"你的衣服就如火热，你知道吗？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你岂能与 神同铺穹苍吗？","poem":1},{"lineBreak":true},{"text":"这穹苍坚硬，如同铸成的镜子。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我们愚昧不能陈说；","poem":1},{"lineBreak":true},{"text":"请你指教我们该对他说什么话。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"人岂可说：我愿与他说话？","poem":1},{"lineBreak":true},{"text":"岂有人自愿灭亡吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"现在有云遮蔽，人不得见穹苍的光亮；","poem":1},{"lineBreak":true},{"text":"但风吹过，天又发晴。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"金光出于北方，","poem":1},{"lineBreak":true},{"text":"在 神那里有可怕的威严。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"论到全能者，我们不能测度；","poem":1},{"lineBreak":true},{"text":"他大有能力，有公平和大义，","poem":1},{"lineBreak":true},{"text":"必不苦待人。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"所以，人敬畏他；","poem":1},{"lineBreak":true},{"text":"凡自以为心中有智慧的人，他都不顾念。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}