{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":38,"content":[{"type":"heading","content":["耶和华回答约伯"]},{"type":"verse","number":1,"content":[{"text":"那时，耶和华从旋风中回答约伯说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"谁用无知的言语使我的旨意暗昧不明？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你要如勇士束腰；","poem":1},{"lineBreak":true},{"text":"我问你，你可以指示我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我立大地根基的时候，你在哪里呢？","poem":1},{"lineBreak":true},{"text":"你若有聪明，只管说吧！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你若晓得就说，是谁定地的尺度？","poem":1},{"lineBreak":true},{"text":"是谁把准绳拉在其上？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"地的根基安置在何处？","poem":1},{"lineBreak":true},{"text":"地的角石是谁安放的？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"那时，晨星一同歌唱；","poem":1},{"lineBreak":true},{"text":"神的众子也都欢呼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"海水冲出，如出胎胞，","poem":1},{"lineBreak":true},{"text":"那时谁将它关闭呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"是我用云彩当海的衣服，","poem":1},{"lineBreak":true},{"text":"用幽暗当包裹它的布，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"为它定界限，","poem":1},{"lineBreak":true},{"text":"又安门和闩，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"说：你只可到这里，不可越过；","poem":1},{"lineBreak":true},{"text":"你狂傲的浪要到此止住。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"你自生以来，曾命定晨光，","poem":1},{"lineBreak":true},{"text":"使清晨的日光知道本位，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"叫这光普照地的四极，","poem":1},{"lineBreak":true},{"text":"将恶人从其中驱逐出来吗？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因这光，地面改变如泥上印印，","poem":1},{"lineBreak":true},{"text":"万物出现如衣服一样。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"亮光不照恶人；","poem":1},{"lineBreak":true},{"text":"强横的膀臂也必折断。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"你曾进到海源，","poem":1},{"lineBreak":true},{"text":"或在深渊的隐密处行走吗？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"死亡的门曾向你显露吗？","poem":1},{"lineBreak":true},{"text":"死荫的门你曾见过吗？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"地的广大你能明透吗？","poem":1},{"lineBreak":true},{"text":"你若全知道，只管说吧！","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"光明的居所从何而至？","poem":1},{"lineBreak":true},{"text":"黑暗的本位在于何处？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你能带到本境，","poem":1},{"lineBreak":true},{"text":"能看明其室之路吗？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你总知道，","poem":1},{"lineBreak":true},{"text":"因为你早已生在世上，","poem":1},{"lineBreak":true},{"text":"你日子的数目也多。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"你曾进入雪库，","poem":1},{"lineBreak":true},{"text":"或见过雹仓吗？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"这雪雹乃是我为降灾，","poem":1},{"lineBreak":true},{"text":"并打仗和争战的日子所预备的。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"光亮从何路分开？","poem":1},{"lineBreak":true},{"text":"东风从何路分散遍地？","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"谁为雨水分道？","poem":1},{"lineBreak":true},{"text":"谁为雷电开路？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"使雨降在无人之地、","poem":1},{"lineBreak":true},{"text":"无人居住的旷野？","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"使荒废凄凉之地得以丰足，","poem":1},{"lineBreak":true},{"text":"青草得以发生？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"雨有父吗？","poem":1},{"lineBreak":true},{"text":"露水珠是谁生的呢？","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"冰出于谁的胎？","poem":1},{"lineBreak":true},{"text":"天上的霜是谁生的呢？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"诸水坚硬","poem":1},{"noteId":22},{"text":"如石头；","poem":1},{"lineBreak":true},{"text":"深渊之面凝结成冰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"你能系住昴星的结吗？","poem":1},{"lineBreak":true},{"text":"能解开参星的带吗？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"你能按时领出十二宫吗？","poem":1},{"lineBreak":true},{"text":"能引导北斗和随它的众星","poem":1},{"noteId":23},{"text":"吗？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"你知道天的定例吗？","poem":1},{"lineBreak":true},{"text":"能使地归在天的权下吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"你能向云彩扬起声来，","poem":1},{"lineBreak":true},{"text":"使倾盆的雨遮盖你吗？","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"你能发出闪电，叫它行去，","poem":1},{"lineBreak":true},{"text":"使它对你说：我们在这里？","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"谁将智慧放在怀中？","poem":1},{"lineBreak":true},{"text":"谁将聪明赐于心内？","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"谁能用智慧数算云彩呢？","poem":1},{"lineBreak":true},{"text":"尘土聚集成团，土块紧紧结连；","poem":1},{"lineBreak":true},{"text":"那时，谁能倾倒天上的瓶呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"母狮子在洞中蹲伏，","poem":1},{"lineBreak":true},{"text":"少壮狮子在隐密处埋伏；","poem":1},{"lineBreak":true},{"text":"你能为它们抓取食物，","poem":1},{"lineBreak":true},{"text":"使它们饱足吗？","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"乌鸦之雏因无食物飞来飞去，哀告 神；","poem":1},{"lineBreak":true},{"text":"那时，谁为它预备食物呢？","poem":1}]}],"footnotes":[{"noteId":22,"caller":"-","text":"或译：隐藏","reference":{"chapter":38,"verse":30}},{"noteId":23,"caller":"-","text":"星：原文是子","reference":{"chapter":38,"verse":32}}]},"thisChapterLink":"/api/cmn_cu1/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":39}