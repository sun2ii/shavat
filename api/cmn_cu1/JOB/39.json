{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"山岩间的野山羊几时生产，你知道吗？","poem":1},{"lineBreak":true},{"text":"母鹿下犊之期，你能察定吗？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"它们怀胎的月数，你能数算吗？","poem":1},{"lineBreak":true},{"text":"它们几时生产，你能晓得吗？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"它们屈身，将子生下，","poem":1},{"lineBreak":true},{"text":"就除掉疼痛。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"这子渐渐肥壮，在荒野长大，","poem":1},{"lineBreak":true},{"text":"去而不回。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"谁放野驴出去自由？","poem":1},{"lineBreak":true},{"text":"谁解开快驴的绳索？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我使旷野作它的住处，","poem":1},{"lineBreak":true},{"text":"使咸地当它的居所。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"它嗤笑城内的喧嚷，","poem":1},{"lineBreak":true},{"text":"不听赶牲口的喝声。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"遍山是它的草场；","poem":1},{"lineBreak":true},{"text":"它寻找各样青绿之物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"野牛岂肯服事你？","poem":1},{"lineBreak":true},{"text":"岂肯住在你的槽旁？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你岂能用套绳将野牛笼在犁沟之间？","poem":1},{"lineBreak":true},{"text":"它岂肯随你耙山谷之地？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"岂可因它的力大就倚靠它？","poem":1},{"lineBreak":true},{"text":"岂可把你的工交给它做吗？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"岂可信靠它把你的粮食运到家，","poem":1},{"lineBreak":true},{"text":"又收聚你禾场上的谷吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"鸵鸟的翅膀欢然搧展，","poem":1},{"lineBreak":true},{"text":"岂是显慈爱的翎毛和羽毛吗？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因它把蛋留在地上，","poem":1},{"lineBreak":true},{"text":"在尘土中使得温暖；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"却想不到被脚踹碎，","poem":1},{"lineBreak":true},{"text":"或被野兽践踏。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"它忍心待雏，似乎不是自己的；","poem":1},{"lineBreak":true},{"text":"虽然徒受劳苦，也不为雏惧怕；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因为 神使它没有智慧，","poem":1},{"lineBreak":true},{"text":"也未将悟性赐给它。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"它几时挺身展开翅膀，","poem":1},{"lineBreak":true},{"text":"就嗤笑马和骑马的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"马的大力是你所赐的吗？","poem":1},{"lineBreak":true},{"text":"它颈项上挓挲的鬃是你给它披上的吗？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"是你叫它跳跃像蝗虫吗？","poem":1},{"lineBreak":true},{"text":"它喷气之威使人惊惶。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"它在谷中刨地，自喜其力；","poem":1},{"lineBreak":true},{"text":"它出去迎接佩带兵器的人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"它嗤笑可怕的事并不惊惶，","poem":1},{"lineBreak":true},{"text":"也不因刀剑退回。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"箭袋和发亮的枪，","poem":1},{"lineBreak":true},{"text":"并短枪在它身上铮铮有声。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"它发猛烈的怒气将地吞下；","poem":1},{"lineBreak":true},{"text":"一听角声就不耐站立。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"角每发声，它说呵哈；","poem":1},{"lineBreak":true},{"text":"它从远处闻着战气，","poem":1},{"lineBreak":true},{"text":"又听见军长大发雷声和兵丁呐喊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"鹰雀飞翔，展开翅膀一直向南，","poem":1},{"lineBreak":true},{"text":"岂是借你的智慧吗？","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"大鹰上腾在高处搭窝，","poem":1},{"lineBreak":true},{"text":"岂是听你的吩咐吗？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"它住在山岩，","poem":1},{"lineBreak":true},{"text":"以山峰和坚固之所为家，","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"从那里窥看食物，","poem":1},{"lineBreak":true},{"text":"眼睛远远观望。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"它的雏也咂血；","poem":1},{"lineBreak":true},{"text":"被杀的人在哪里，它也在那里。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}