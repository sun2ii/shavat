{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":4,"content":[{"type":"heading","content":["第一次对话"]},{"type":"verse","number":1,"content":[{"text":"提幔人以利法回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"人若想与你说话，你就厌烦吗？","poem":1},{"lineBreak":true},{"text":"但谁能忍住不说呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你素来教导许多的人，","poem":1},{"lineBreak":true},{"text":"又坚固软弱的手。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的言语曾扶助那将要跌倒的人；","poem":1},{"lineBreak":true},{"text":"你又使软弱的膝稳固。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但现在祸患临到你，你就昏迷，","poem":1},{"lineBreak":true},{"text":"挨近你，你便惊惶。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你的倚靠不是在你敬畏 神吗？","poem":1},{"lineBreak":true},{"text":"你的盼望不是在你行事纯正吗？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"请你追想：无辜的人有谁灭亡？","poem":1},{"lineBreak":true},{"text":"正直的人在何处剪除？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"按我所见，耕罪孽、种毒害的人","poem":1},{"lineBreak":true},{"text":"都照样收割。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"神一出气，他们就灭亡；","poem":1},{"lineBreak":true},{"text":"神一发怒，他们就消没。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"狮子的吼叫和猛狮的声音尽都止息；","poem":1},{"lineBreak":true},{"text":"少壮狮子的牙齿也都敲掉。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"老狮子因绝食而死；","poem":1},{"lineBreak":true},{"text":"母狮之子也都离散。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"我暗暗地得了默示；","poem":1},{"lineBreak":true},{"text":"我耳朵也听其细微的声音。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"在思念夜中、异象之间，","poem":1},{"lineBreak":true},{"text":"世人沉睡的时候，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"恐惧、战兢临到我身，","poem":1},{"lineBreak":true},{"text":"使我百骨打战。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"有灵从我面前经过，","poem":1},{"lineBreak":true},{"text":"我身上的毫毛直立。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"那灵停住，","poem":1},{"lineBreak":true},{"text":"我却不能辨其形状；","poem":1},{"lineBreak":true},{"text":"有影像在我眼前。","poem":1},{"lineBreak":true},{"text":"我在静默中听见有声音说：","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"必死的人岂能比 神公义吗？","poem":1},{"lineBreak":true},{"text":"人岂能比造他的主洁净吗？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"主不信靠他的臣仆，","poem":1},{"lineBreak":true},{"text":"并且指他的使者为愚昧；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"何况那住在土房、根基在尘土里、","poem":1},{"lineBreak":true},{"text":"被蠹虫所毁坏的人呢？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"早晚之间，就被毁灭，","poem":1},{"lineBreak":true},{"text":"永归无有，无人理会。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他帐棚的绳索岂不从中抽出来呢？","poem":1},{"lineBreak":true},{"text":"他死，且是无智慧而死。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}