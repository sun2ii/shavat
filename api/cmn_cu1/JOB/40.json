{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":[{"text":"耶和华又对约伯说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"强辩的岂可与全能者争论吗？","poem":1},{"lineBreak":true},{"text":"与 神辩驳的可以回答这些吧！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"于是，约伯回答耶和华说：","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我是卑贱的！我用什么回答你呢？","poem":1},{"lineBreak":true},{"text":"只好用手捂口。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我说了一次，再不回答；","poem":1},{"lineBreak":true},{"text":"说了两次，就不再说。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"于是，耶和华从旋风中回答约伯说：","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你要如勇士束腰；","poem":1},{"lineBreak":true},{"text":"我问你，你可以指示我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你岂可废弃我所拟定的？","poem":1},{"lineBreak":true},{"text":"岂可定我有罪，好显自己为义吗？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你有 神那样的膀臂吗？","poem":1},{"lineBreak":true},{"text":"你能像他发雷声吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你要以荣耀庄严为妆饰，","poem":1},{"lineBreak":true},{"text":"以尊荣威严为衣服；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"要发出你满溢的怒气，","poem":1},{"lineBreak":true},{"text":"见一切骄傲的人，使他降卑；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"见一切骄傲的人，将他制伏，","poem":1},{"lineBreak":true},{"text":"把恶人践踏在本处；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"将他们一同隐藏在尘土中，","poem":1},{"lineBreak":true},{"text":"把他们的脸蒙蔽在隐密处；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我就认你右手能以救自己。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"你且观看河马；","poem":1},{"lineBreak":true},{"text":"我造你也造它。","poem":1},{"lineBreak":true},{"text":"它吃草与牛一样；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"它的气力在腰间，","poem":1},{"lineBreak":true},{"text":"能力在肚腹的筋上。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"它摇动尾巴如香柏树；","poem":1},{"lineBreak":true},{"text":"它大腿的筋互相联络。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"它的骨头好像铜管；","poem":1},{"lineBreak":true},{"text":"它的肢体仿佛铁棍。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"它在 神所造的物中为首；","poem":1},{"lineBreak":true},{"text":"创造它的给它刀剑。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"诸山给它出食物，","poem":1},{"lineBreak":true},{"text":"也是百兽游玩之处。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"它伏在莲叶之下，","poem":1},{"lineBreak":true},{"text":"卧在芦苇隐密处和水洼子里。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"莲叶的阴凉遮蔽它；","poem":1},{"lineBreak":true},{"text":"溪旁的柳树环绕它。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"河水泛滥，它不发战；","poem":1},{"lineBreak":true},{"text":"就是约旦河的水涨到它口边，也是安然。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"在它防备的时候，谁能捉拿它？","poem":1},{"lineBreak":true},{"text":"谁能牢笼它穿它的鼻子呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}