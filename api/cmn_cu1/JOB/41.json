{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"你能用鱼钩钓上鳄鱼吗？","poem":1},{"lineBreak":true},{"text":"能用绳子压下它的舌头吗？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你能用绳索穿它的鼻子吗？","poem":1},{"lineBreak":true},{"text":"能用钩穿它的腮骨吗？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"它岂向你连连恳求，","poem":1},{"lineBreak":true},{"text":"说柔和的话吗？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"岂肯与你立约，","poem":1},{"lineBreak":true},{"text":"使你拿它永远作奴仆吗？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你岂可拿它当雀鸟玩耍吗？","poem":1},{"lineBreak":true},{"text":"岂可为你的幼女将它拴住吗？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"搭伙的渔夫岂可拿它当货物吗？","poem":1},{"lineBreak":true},{"text":"能把它分给商人吗？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你能用倒钩枪扎满它的皮，","poem":1},{"lineBreak":true},{"text":"能用鱼叉叉满它的头吗？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你按手在它身上，想与它争战，","poem":1},{"lineBreak":true},{"text":"就不再这样行吧！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"人指望捉拿它是徒然的；","poem":1},{"lineBreak":true},{"text":"一见它，岂不丧胆吗？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"没有那么凶猛的人敢惹它。","poem":1},{"lineBreak":true},{"text":"这样，谁能在我面前站立得住呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"谁先给我什么，使我偿还呢？","poem":1},{"lineBreak":true},{"text":"天下万物都是我的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"论到鳄鱼的肢体和其大力，并美好的骨骼，","poem":1},{"lineBreak":true},{"text":"我不能缄默不言。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"谁能剥它的外衣？","poem":1},{"lineBreak":true},{"text":"谁能进它上下牙骨之间呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"谁能开它的腮颊？","poem":1},{"lineBreak":true},{"text":"它牙齿四围是可畏的。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"它以坚固的鳞甲为可夸，","poem":1},{"lineBreak":true},{"text":"紧紧合闭，封得严密。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"这鳞甲一一相连，","poem":1},{"lineBreak":true},{"text":"甚至气不得透入其间，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"都是互相联络、胶结，","poem":1},{"lineBreak":true},{"text":"不能分离。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"它打喷嚏就发出光来；","poem":1},{"lineBreak":true},{"text":"它眼睛好像早晨的光线","poem":1},{"noteId":24},{"text":"。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"从它口中发出烧着的火把，","poem":1},{"lineBreak":true},{"text":"与飞迸的火星；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"从它鼻孔冒出烟来，","poem":1},{"lineBreak":true},{"text":"如烧开的锅和点着的芦苇。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"它的气点着煤炭，","poem":1},{"lineBreak":true},{"text":"有火焰从它口中发出。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"它颈项中存着劲力；","poem":1},{"lineBreak":true},{"text":"在它面前的都恐吓蹦跳。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"它的肉块互相联络，","poem":1},{"lineBreak":true},{"text":"紧贴其身，不能摇动。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"它的心结实如石头，","poem":1},{"lineBreak":true},{"text":"如下磨石那样结实。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"它一起来，勇士都惊恐，","poem":1},{"lineBreak":true},{"text":"心里慌乱，便都昏迷。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"人若用刀，用枪，用标枪，","poem":1},{"lineBreak":true},{"text":"用尖枪扎它，都是无用。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"它以铁为干草，","poem":1},{"lineBreak":true},{"text":"以铜为烂木。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"箭不能恐吓它使它逃避；","poem":1},{"lineBreak":true},{"text":"弹石在它看为碎秸。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"棍棒算为禾秸；","poem":1},{"lineBreak":true},{"text":"它嗤笑短枪飕的响声。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"它肚腹下如尖瓦片；","poem":1},{"lineBreak":true},{"text":"它如钉耙经过淤泥。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"它使深渊开滚如锅，","poem":1},{"lineBreak":true},{"text":"使洋海如锅中的膏油。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"它行的路随后发光，","poem":1},{"lineBreak":true},{"text":"令人想深渊如同白发。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"在地上没有像它造的那样，","poem":1},{"lineBreak":true},{"text":"无所惧怕。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"凡高大的，它无不藐视；","poem":1},{"lineBreak":true},{"text":"它在骄傲的水族上作王。","poem":1}]}],"footnotes":[{"noteId":24,"caller":"-","text":"原文是眼皮","reference":{"chapter":41,"verse":18}}]},"thisChapterLink":"/api/cmn_cu1/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}