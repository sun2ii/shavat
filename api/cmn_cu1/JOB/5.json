{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"你且呼求，有谁答应你？","poem":1},{"lineBreak":true},{"text":"诸圣者之中，你转向哪一位呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"忿怒害死愚妄人；","poem":1},{"lineBreak":true},{"text":"嫉妒杀死痴迷人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我曾见愚妄人扎下根，","poem":1},{"lineBreak":true},{"text":"但我忽然咒诅他的住处。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他的儿女远离稳妥的地步，","poem":1},{"lineBreak":true},{"text":"在城门口被压，并无人搭救。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他的庄稼有饥饿的人吃尽了，","poem":1},{"lineBreak":true},{"text":"就是在荆棘里的也抢去了；","poem":1},{"lineBreak":true},{"text":"他的财宝有网罗张口吞灭了。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"祸患原不是从土中出来；","poem":1},{"lineBreak":true},{"text":"患难也不是从地里发生。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"人生在世必遇患难，","poem":1},{"lineBreak":true},{"text":"如同火星飞腾。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"至于我，我必仰望 神，","poem":1},{"lineBreak":true},{"text":"把我的事情托付他。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他行大事不可测度，","poem":1},{"lineBreak":true},{"text":"行奇事不可胜数：","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"降雨在地上，","poem":1},{"lineBreak":true},{"text":"赐水于田里；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"将卑微的安置在高处，","poem":1},{"lineBreak":true},{"text":"将哀痛的举到稳妥之地；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"破坏狡猾人的计谋，","poem":1},{"lineBreak":true},{"text":"使他们所谋的不得成就。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他叫有智慧的中了自己的诡计，","poem":1},{"lineBreak":true},{"text":"使狡诈人的计谋速速灭亡。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们白昼遇见黑暗，","poem":1},{"lineBreak":true},{"text":"午间摸索如在夜间。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"神拯救穷乏人","poem":1},{"lineBreak":true},{"text":"脱离他们口中的刀和强暴人的手。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"这样，贫寒的人有指望，","poem":1},{"lineBreak":true},{"text":"罪孽之辈必塞口无言。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"神所惩治的人是有福的！","poem":1},{"lineBreak":true},{"text":"所以你不可轻看全能者的管教。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因为他打破，又缠裹；","poem":1},{"lineBreak":true},{"text":"他击伤，用手医治。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你六次遭难，他必救你；","poem":1},{"lineBreak":true},{"text":"就是七次，灾祸也无法害你。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"在饥荒中，他必救你脱离死亡；","poem":1},{"lineBreak":true},{"text":"在争战中，他必救你脱离刀剑的权力。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你必被隐藏，不受口舌之害；","poem":1},{"lineBreak":true},{"text":"灾殃临到，你也不惧怕。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你遇见灾害饥馑，就必嬉笑；","poem":1},{"lineBreak":true},{"text":"地上的野兽，你也不惧怕。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"因为你必与田间的石头立约；","poem":1},{"lineBreak":true},{"text":"田里的野兽也必与你和好。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你必知道你帐棚平安，","poem":1},{"lineBreak":true},{"text":"要查看你的羊圈，一无所失；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"也必知道你的后裔将来发达，","poem":1},{"lineBreak":true},{"text":"你的子孙像地上的青草。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你必寿高年迈才归坟墓，","poem":1},{"lineBreak":true},{"text":"好像禾捆到时收藏。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"这理，我们已经考察，本是如此。","poem":1},{"lineBreak":true},{"text":"你须要听，要知道是与自己有益。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}