{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"约伯回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"惟愿我的烦恼称一称，","poem":1},{"lineBreak":true},{"text":"我一切的灾害放在天平里；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"现今都比海沙更重，","poem":1},{"lineBreak":true},{"text":"所以我的言语急躁。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因全能者的箭射入我身；","poem":1},{"lineBreak":true},{"text":"其毒，我的灵喝尽了；","poem":1},{"lineBreak":true},{"text":"神的惊吓摆阵攻击我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"野驴有草岂能叫唤？","poem":1},{"lineBreak":true},{"text":"牛有料岂能吼叫？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"物淡而无盐岂可吃吗？","poem":1},{"lineBreak":true},{"text":"蛋青有什么滋味呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"看为可厌的食物，","poem":1},{"lineBreak":true},{"text":"我心不肯挨近。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"惟愿我得着所求的，","poem":1},{"lineBreak":true},{"text":"愿 神赐我所切望的；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"就是愿 神把我压碎，","poem":1},{"lineBreak":true},{"text":"伸手将我剪除。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我因没有违弃那圣者的言语，","poem":1},{"lineBreak":true},{"text":"就仍以此为安慰，","poem":1},{"lineBreak":true},{"text":"在不止息的痛苦中还可踊跃。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我有什么气力使我等候？","poem":1},{"lineBreak":true},{"text":"我有什么结局使我忍耐？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我的气力岂是石头的气力？","poem":1},{"lineBreak":true},{"text":"我的肉身岂是铜的呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"在我岂不是毫无帮助吗？","poem":1},{"lineBreak":true},{"text":"智慧岂不是从我心中赶出净尽吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"那将要灰心、离弃全能者、","poem":1},{"lineBreak":true},{"text":"不敬畏 神的人，","poem":1},{"lineBreak":true},{"text":"他的朋友当以慈爱待他。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的弟兄诡诈，好像溪水，","poem":1},{"lineBreak":true},{"text":"又像溪水流干的河道。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"这河因结冰发黑，","poem":1},{"lineBreak":true},{"text":"有雪藏在其中；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"天气渐暖就随时消化，","poem":1},{"lineBreak":true},{"text":"日头炎热便从原处干涸。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"结伴的客旅离弃大道，","poem":1},{"lineBreak":true},{"text":"顺河偏行，到荒野之地死亡。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"提玛结伴的客旅瞻望；","poem":1},{"lineBreak":true},{"text":"示巴同伙的人等候。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他们因失了盼望就抱愧，","poem":1},{"lineBreak":true},{"text":"来到那里便蒙羞。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"现在你们正是这样，","poem":1},{"lineBreak":true},{"text":"看见惊吓的事便惧怕。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我岂说：请你们供给我，","poem":1},{"lineBreak":true},{"text":"从你们的财物中送礼物给我？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"岂说：拯救我脱离敌人的手吗？","poem":1},{"lineBreak":true},{"text":"救赎我脱离强暴人的手吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"请你们教导我，我便不作声；","poem":1},{"lineBreak":true},{"text":"使我明白在何事上有错。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"正直的言语力量何其大！","poem":1},{"lineBreak":true},{"text":"但你们责备是责备什么呢？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"绝望人的讲论既然如风，","poem":1},{"lineBreak":true},{"text":"你们还想要驳正言语吗？","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你们想为孤儿拈阄，","poem":1},{"lineBreak":true},{"text":"以朋友当货物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"现在请你们看看我，","poem":1},{"lineBreak":true},{"text":"我决不当面说谎。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"请你们转意，不要不公；","poem":1},{"lineBreak":true},{"text":"请再转意，我的事有理。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我的舌上岂有不义吗？","poem":1},{"lineBreak":true},{"text":"我的口里岂不辨奸恶吗？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}