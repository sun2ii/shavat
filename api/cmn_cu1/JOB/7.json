{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"人在世上岂无争战吗？","poem":1},{"lineBreak":true},{"text":"他的日子不像雇工人的日子吗？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"像奴仆切慕黑影，","poem":1},{"lineBreak":true},{"text":"像雇工人盼望工价；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我也照样经过困苦的日月，","poem":1},{"lineBreak":true},{"text":"夜间的疲乏为我而定。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我躺卧的时候便说：","poem":1},{"lineBreak":true},{"text":"我何时起来，黑夜就过去呢？","poem":1},{"lineBreak":true},{"text":"我尽是反来复去，直到天亮。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的肉体以虫子和尘土为衣；","poem":1},{"lineBreak":true},{"text":"我的皮肤才收了口又重新破裂。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的日子比梭更快，","poem":1},{"lineBreak":true},{"text":"都消耗在无指望之中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"求你想念，我的生命不过是一口气；","poem":1},{"lineBreak":true},{"text":"我的眼睛必不再见福乐。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"观看我的人，他的眼必不再见我；","poem":1},{"lineBreak":true},{"text":"你的眼目要看我，我却不在了。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"云彩消散而过；","poem":1},{"lineBreak":true},{"text":"照样，人下阴间也不再上来。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他不再回自己的家；","poem":1},{"lineBreak":true},{"text":"故土也不再认识他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我不禁止我口；","poem":1},{"lineBreak":true},{"text":"我灵愁苦，要发出言语；","poem":1},{"lineBreak":true},{"text":"我心苦恼，要吐露哀情。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我对 神说：我岂是洋海，","poem":1},{"lineBreak":true},{"text":"岂是大鱼，你竟防守我呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"若说：我的床必安慰我，","poem":1},{"lineBreak":true},{"text":"我的榻必解释我的苦情，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你就用梦惊骇我，","poem":1},{"lineBreak":true},{"text":"用异象恐吓我，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"甚至我宁肯噎死，宁肯死亡，","poem":1},{"lineBreak":true},{"text":"胜似留我这一身的骨头。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我厌弃性命，不愿永活。","poem":1},{"lineBreak":true},{"text":"你任凭我吧，因我的日子都是虚空。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"人算什么，你竟看他为大，","poem":1},{"lineBreak":true},{"text":"将他放在心上？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"每早鉴察他，","poem":1},{"lineBreak":true},{"text":"时刻试验他？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你到何时才转眼不看我，","poem":1},{"lineBreak":true},{"text":"才任凭我咽下唾沫呢？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"鉴察人的主啊，我若有罪，于你何妨？","poem":1},{"lineBreak":true},{"text":"为何以我当你的箭靶子，","poem":1},{"lineBreak":true},{"text":"使我厌弃自己的性命？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"为何不赦免我的过犯，","poem":1},{"lineBreak":true},{"text":"除掉我的罪孽？","poem":1},{"lineBreak":true},{"text":"我现今要躺卧在尘土中；","poem":1},{"lineBreak":true},{"text":"你要殷勤地寻找我，我却不在了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}