{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"书亚人比勒达回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"这些话你要说到几时？","poem":1},{"lineBreak":true},{"text":"口中的言语如狂风要到几时呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"神岂能偏离公平？","poem":1},{"lineBreak":true},{"text":"全能者岂能偏离公义？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"或者你的儿女得罪了他；","poem":1},{"lineBreak":true},{"text":"他使他们受报应。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你若殷勤地寻求 神，","poem":1},{"lineBreak":true},{"text":"向全能者恳求；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你若清洁正直，","poem":1},{"lineBreak":true},{"text":"他必定为你起来，","poem":1},{"lineBreak":true},{"text":"使你公义的居所兴旺。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你起初虽然微小，","poem":1},{"lineBreak":true},{"text":"终久必甚发达。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"请你考问前代，","poem":1},{"lineBreak":true},{"text":"追念他们的列祖所查究的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我们不过从昨日才有，一无所知；","poem":1},{"lineBreak":true},{"text":"我们在世的日子好像影儿。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们岂不指教你，告诉你，","poem":1},{"lineBreak":true},{"text":"从心里发出言语来呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"蒲草没有泥岂能发长？","poem":1},{"lineBreak":true},{"text":"芦荻没有水岂能生发？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"尚青的时候，还没有割下，","poem":1},{"lineBreak":true},{"text":"比百样的草先枯槁。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"凡忘记 神的人，景况也是这样；","poem":1},{"lineBreak":true},{"text":"不虔敬人的指望要灭没。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他所仰赖的必折断；","poem":1},{"lineBreak":true},{"text":"他所倚靠的是蜘蛛网。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他要倚靠房屋，房屋却站立不住；","poem":1},{"lineBreak":true},{"text":"他要抓住房屋，房屋却不能存留。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他在日光之下发青，","poem":1},{"lineBreak":true},{"text":"蔓子爬满了园子；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他的根盘绕石堆，","poem":1},{"lineBreak":true},{"text":"扎入石地。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他若从本地被拔出，","poem":1},{"lineBreak":true},{"text":"那地就不认识他，说：","poem":1},{"lineBreak":true},{"text":"我没有见过你。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"看哪，这就是他道中之乐；","poem":1},{"lineBreak":true},{"text":"以后必另有人从地而生。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"神必不丢弃完全人，","poem":1},{"lineBreak":true},{"text":"也不扶助邪恶人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他还要以喜笑充满你的口，","poem":1},{"lineBreak":true},{"text":"以欢呼充满你的嘴。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"恨恶你的要披戴惭愧；","poem":1},{"lineBreak":true},{"text":"恶人的帐棚必归于无有。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}