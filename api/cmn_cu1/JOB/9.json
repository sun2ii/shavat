{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cu1","name":"约伯记","commonName":"约伯记","title":"约伯记","order":18,"numberOfChapters":42,"sha256":"874796c2a3eb73036d71ac9f1a85d305483400ee19fc61db9f76e87d836724b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cu1/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"约伯回答说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我真知道是这样；","poem":1},{"lineBreak":true},{"text":"但人在 神面前怎能成为义呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"若愿意与他争辩，","poem":1},{"lineBreak":true},{"text":"千中之一也不能回答。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他心里有智慧，且大有能力。","poem":1},{"lineBreak":true},{"text":"谁向 神刚硬而得亨通呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他发怒，把山翻倒挪移，","poem":1},{"lineBreak":true},{"text":"山并不知觉。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他使地震动，离其本位，","poem":1},{"lineBreak":true},{"text":"地的柱子就摇撼。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他吩咐日头不出来，就不出来，","poem":1},{"lineBreak":true},{"text":"又封闭众星。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他独自铺张苍天，","poem":1},{"lineBreak":true},{"text":"步行在海浪之上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他造北斗、参星、昴星，","poem":1},{"lineBreak":true},{"text":"并南方的密宫；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他行大事，不可测度，","poem":1},{"lineBreak":true},{"text":"行奇事，不可胜数。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他从我旁边经过，我却不看见；","poem":1},{"lineBreak":true},{"text":"他在我面前行走，我倒不知觉。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他夺取，谁能阻挡？","poem":1},{"lineBreak":true},{"text":"谁敢问他：你做什么？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"神必不收回他的怒气；","poem":1},{"lineBreak":true},{"text":"扶助拉哈伯的，屈身在他以下。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"既是这样，我怎敢回答他，","poem":1},{"lineBreak":true},{"text":"怎敢选择言语与他辩论呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我虽有义，也不回答他，","poem":1},{"lineBreak":true},{"text":"只要向那审判我的恳求。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我若呼吁，他应允我；","poem":1},{"lineBreak":true},{"text":"我仍不信他真听我的声音。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他用暴风折断我，","poem":1},{"lineBreak":true},{"text":"无故地加增我的损伤。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我就是喘一口气，他都不容，","poem":1},{"lineBreak":true},{"text":"倒使我满心苦恼。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"若论力量，他真有能力！","poem":1},{"lineBreak":true},{"text":"若论审判，他说谁能将我传来呢？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我虽有义，自己的口要定我为有罪；","poem":1},{"lineBreak":true},{"text":"我虽完全，我口必显我为弯曲。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我本完全，不顾自己；","poem":1},{"lineBreak":true},{"text":"我厌恶我的性命。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"善恶无分，都是一样；","poem":1},{"lineBreak":true},{"text":"所以我说，完全人和恶人，他都灭绝。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"若忽然遭杀害之祸，","poem":1},{"lineBreak":true},{"text":"他必戏笑无辜的人遇难。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"世界交在恶人手中；","poem":1},{"lineBreak":true},{"text":"蒙蔽世界审判官的脸，","poem":1},{"lineBreak":true},{"text":"若不是他，是谁呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"我的日子比跑信的更快，","poem":1},{"lineBreak":true},{"text":"急速过去，不见福乐。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我的日子过去如快船，","poem":1},{"lineBreak":true},{"text":"如急落抓食的鹰。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我若说：我要忘记我的哀情，","poem":1},{"lineBreak":true},{"text":"除去我的愁容，心中畅快；","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我因愁苦而惧怕，","poem":1},{"lineBreak":true},{"text":"知道你必不以我为无辜。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我必被你定为有罪，","poem":1},{"lineBreak":true},{"text":"我何必徒然劳苦呢？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我若用雪水洗身，","poem":1},{"lineBreak":true},{"text":"用硷洁净我的手，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"你还要扔我在坑里，","poem":1},{"lineBreak":true},{"text":"我的衣服都憎恶我。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他本不像我是人，使我可以回答他，","poem":1},{"lineBreak":true},{"text":"又使我们可以同听审判。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"我们中间没有听讼的人","poem":1},{"lineBreak":true},{"text":"可以向我们两造按手。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"愿他把杖离开我，","poem":1},{"lineBreak":true},{"text":"不使惊惶威吓我。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"我就说话，也不惧怕他，","poem":1},{"lineBreak":true},{"text":"现在我却不是那样。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}