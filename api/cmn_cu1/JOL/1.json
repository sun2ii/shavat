{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOL","translationId":"cmn_cu1","name":"约珥书","commonName":"约珥书","title":"约珥书","order":29,"numberOfChapters":3,"sha256":"51cc74195201b09308c68d8461e7b1c597c54ed5f150000c302f6e5afab37557","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cu1/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["耶和华的话临到毗土珥的儿子约珥。"]},{"type":"heading","content":["百姓因收成受损坏而悲伤"]},{"type":"verse","number":2,"content":[{"text":"老年人哪，当听我的话；","poem":1},{"lineBreak":true},{"text":"国中的居民哪，都要侧耳而听。","poem":1},{"lineBreak":true},{"text":"在你们的日子，","poem":1},{"lineBreak":true},{"text":"或你们列祖的日子，","poem":1},{"lineBreak":true},{"text":"曾有这样的事吗？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们要将这事传与子，","poem":1},{"lineBreak":true},{"text":"子传与孙，","poem":1},{"lineBreak":true},{"text":"孙传与后代。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"剪虫剩下的，蝗虫来吃；","poem":1},{"lineBreak":true},{"text":"蝗虫剩下的，蝻子来吃；","poem":1},{"lineBreak":true},{"text":"蝻子剩下的，蚂蚱来吃。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"酒醉的人哪，要清醒哭泣；","poem":1},{"lineBreak":true},{"text":"好酒的人哪，都要为甜酒哀号，","poem":1},{"lineBreak":true},{"text":"因为从你们的口中断绝了。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"有一队蝗虫","poem":1},{"noteId":0},{"text":"又强盛又无数，","poem":1},{"lineBreak":true},{"text":"侵犯我的地；","poem":1},{"lineBreak":true},{"text":"它的牙齿如狮子的牙齿，","poem":1},{"lineBreak":true},{"text":"大牙如母狮的大牙。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"它毁坏我的葡萄树，","poem":1},{"lineBreak":true},{"text":"剥了我无花果树的皮，","poem":1},{"lineBreak":true},{"text":"剥尽而丢弃，使枝条露白。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我的民哪，你当哀号，像处女腰束麻布，","poem":1},{"lineBreak":true},{"text":"为幼年的丈夫哀号。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"素祭和奠祭从耶和华的殿中断绝；","poem":1},{"lineBreak":true},{"text":"事奉耶和华的祭司都悲哀。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"田荒凉，地悲哀；","poem":1},{"lineBreak":true},{"text":"因为五谷毁坏，","poem":1},{"lineBreak":true},{"text":"新酒干竭，油也缺乏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"农夫啊，你们要惭愧；","poem":1},{"lineBreak":true},{"text":"修理葡萄园的啊，你们要哀号；","poem":1},{"lineBreak":true},{"text":"因为大麦小麦与田间的庄稼都灭绝了。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"葡萄树枯干；","poem":1},{"lineBreak":true},{"text":"无花果树衰残。","poem":1},{"lineBreak":true},{"text":"石榴树、棕树、苹果树，","poem":1},{"lineBreak":true},{"text":"连田野一切的树木也都枯干；","poem":1},{"lineBreak":true},{"text":"众人的喜乐尽都消灭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"祭司啊，你们当腰束麻布痛哭；","poem":1},{"lineBreak":true},{"text":"伺候祭坛的啊，你们要哀号；","poem":1},{"lineBreak":true},{"text":"事奉我 神的啊，你们要来披上麻布过夜，","poem":1},{"lineBreak":true},{"text":"因为素祭和奠祭从你们 神的殿中断绝了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"你们要分定禁食的日子，","poem":1},{"lineBreak":true},{"text":"宣告严肃会，","poem":1},{"lineBreak":true},{"text":"招聚长老和国中的一切居民","poem":1},{"lineBreak":true},{"text":"到耶和华—你们 神的殿，","poem":1},{"lineBreak":true},{"text":"向耶和华哀求。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"哀哉！耶和华的日子临近了。","poem":1},{"lineBreak":true},{"text":"这日来到，好像毁灭从全能者来到。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"粮食不是在我们眼前断绝了吗？","poem":1},{"lineBreak":true},{"text":"欢喜快乐不是从我们 神的殿中止息了吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"谷种在土块下朽烂；","poem":1},{"lineBreak":true},{"text":"仓也荒凉，廪也破坏；","poem":1},{"lineBreak":true},{"text":"因为五谷枯干了。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"牲畜哀鸣；","poem":1},{"lineBreak":true},{"text":"牛群混乱，因为无草；","poem":1},{"lineBreak":true},{"text":"羊群也受了困苦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和华啊，我向你求告，","poem":1},{"lineBreak":true},{"text":"因为火烧灭旷野的草场；","poem":1},{"lineBreak":true},{"text":"火焰烧尽田野的树木。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"田野的走兽向你发喘；","poem":1},{"lineBreak":true},{"text":"因为溪水干涸，","poem":1},{"lineBreak":true},{"text":"火也烧灭旷野的草场。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"原文是民","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/cmn_cu1/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}