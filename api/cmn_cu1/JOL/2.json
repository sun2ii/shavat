{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOL","translationId":"cmn_cu1","name":"约珥书","commonName":"约珥书","title":"约珥书","order":29,"numberOfChapters":3,"sha256":"51cc74195201b09308c68d8461e7b1c597c54ed5f150000c302f6e5afab37557","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cu1/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["以蝗虫为耶和华日子的警告"]},{"type":"verse","number":1,"content":[{"text":"你们要在锡安吹角，","poem":1},{"lineBreak":true},{"text":"在我圣山吹出大声。","poem":1},{"lineBreak":true},{"text":"国中的居民都要发颤；","poem":1},{"lineBreak":true},{"text":"因为耶和华的日子将到，","poem":1},{"lineBreak":true},{"text":"已经临近。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"那日是黑暗、幽冥、","poem":1},{"lineBreak":true},{"text":"密云、乌黑的日子，","poem":1},{"lineBreak":true},{"text":"好像晨光铺满山岭。","poem":1},{"lineBreak":true},{"text":"有一队蝗虫","poem":1},{"noteId":1},{"text":"又大又强；","poem":1},{"lineBreak":true},{"text":"从来没有这样的，","poem":1},{"lineBreak":true},{"text":"以后直到万代也必没有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"它们前面如火烧灭，","poem":1},{"lineBreak":true},{"text":"后面如火焰烧尽。","poem":1},{"lineBreak":true},{"text":"未到以前，地如伊甸园；","poem":1},{"lineBreak":true},{"text":"过去以后，成了荒凉的旷野；","poem":1},{"lineBreak":true},{"text":"没有一样能躲避它们的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"它们的形状如马，","poem":1},{"lineBreak":true},{"text":"奔跑如马兵。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在山顶蹦跳的响声如车辆的响声，","poem":1},{"lineBreak":true},{"text":"又如火焰烧碎秸的响声，","poem":1},{"lineBreak":true},{"text":"好像强盛的民摆阵预备打仗。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"它们一来，众民伤恸，","poem":1},{"lineBreak":true},{"text":"脸都变色。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"它们如勇士奔跑，","poem":1},{"lineBreak":true},{"text":"像战士爬城；","poem":1},{"lineBreak":true},{"text":"各都步行，不乱队伍。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"彼此并不拥挤，向前各行其路，","poem":1},{"lineBreak":true},{"text":"直闯兵器，不偏左右。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"它们蹦上城，蹿上墙，","poem":1},{"lineBreak":true},{"text":"爬上房屋，","poem":1},{"lineBreak":true},{"text":"进入窗户如同盗贼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"它们一来，","poem":1},{"lineBreak":true},{"text":"地震天动，","poem":1},{"lineBreak":true},{"text":"日月昏暗，","poem":1},{"lineBreak":true},{"text":"星宿无光。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华在他军旅前发声，","poem":1},{"lineBreak":true},{"text":"他的队伍甚大；","poem":1},{"lineBreak":true},{"text":"成就他命的是强盛者。","poem":1},{"lineBreak":true},{"text":"因为耶和华的日子大而可畏，","poem":1},{"lineBreak":true},{"text":"谁能当得起呢？","poem":1}]},{"type":"line_break"},{"type":"heading","content":["呼吁百姓悔改"]},{"type":"verse","number":12,"content":[{"text":"耶和华说：虽然如此，","poem":1},{"lineBreak":true},{"text":"你们应当禁食、哭泣、悲哀，","poem":1},{"lineBreak":true},{"text":"一心归向我。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你们要撕裂心肠，","poem":1},{"lineBreak":true},{"text":"不撕裂衣服。","poem":1},{"lineBreak":true},{"text":"归向耶和华—你们的 神；","poem":1},{"lineBreak":true},{"text":"因为他有恩典，有怜悯，","poem":1},{"lineBreak":true},{"text":"不轻易发怒，","poem":1},{"lineBreak":true},{"text":"有丰盛的慈爱，","poem":1},{"lineBreak":true},{"text":"并且后悔不降所说的灾。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"或者他转意后悔，留下余福，","poem":1},{"lineBreak":true},{"text":"就是留下献给耶和华—你们 神的素祭和奠祭，","poem":1},{"lineBreak":true},{"text":"也未可知。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"你们要在锡安吹角，","poem":1},{"lineBreak":true},{"text":"分定禁食的日子，","poem":1},{"lineBreak":true},{"text":"宣告严肃会。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"聚集众民，使会众自洁：","poem":1},{"lineBreak":true},{"text":"招聚老者，","poem":1},{"lineBreak":true},{"text":"聚集孩童和吃奶的；","poem":1},{"lineBreak":true},{"text":"使新郎出离洞房，","poem":1},{"lineBreak":true},{"text":"新妇出离内室。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"事奉耶和华的祭司","poem":1},{"lineBreak":true},{"text":"要在廊子和祭坛中间哭泣，说：","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你顾惜你的百姓，","poem":1},{"lineBreak":true},{"text":"不要使你的产业受羞辱，","poem":1},{"lineBreak":true},{"text":"列邦管辖他们。","poem":1},{"lineBreak":true},{"text":"为何容列国的人说：","poem":1},{"lineBreak":true},{"text":"「他们的 神在哪里」呢？","poem":1}]},{"type":"heading","content":["神再赐福泽"]},{"type":"verse","number":18,"content":[{"text":"耶和华就为自己的地发热心，","poem":1},{"lineBreak":true},{"text":"怜恤他的百姓。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和华应允他的百姓说：","poem":1},{"lineBreak":true},{"text":"我必赐给你们五谷、新酒，和油，","poem":1},{"lineBreak":true},{"text":"使你们饱足；","poem":1},{"lineBreak":true},{"text":"我也不再使你们受列国的羞辱；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"却要使北方来的军队远离你们，","poem":1},{"lineBreak":true},{"text":"将他们赶到干旱荒废之地：","poem":1},{"lineBreak":true},{"text":"前队赶入东海，","poem":1},{"lineBreak":true},{"text":"后队赶入西海；","poem":1},{"lineBreak":true},{"text":"因为他们所行的大恶","poem":1},{"noteId":2},{"text":"，","poem":1},{"lineBreak":true},{"text":"臭气上升，腥味腾空。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"地土啊，不要惧怕；","poem":1},{"lineBreak":true},{"text":"要欢喜快乐，","poem":1},{"lineBreak":true},{"text":"因为耶和华行了大事。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"田野的走兽啊，不要惧怕；","poem":1},{"lineBreak":true},{"text":"因为，旷野的草发生，","poem":1},{"lineBreak":true},{"text":"树木结果，","poem":1},{"lineBreak":true},{"text":"无花果树、葡萄树也都效力。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"锡安的民哪，你们要快乐，","poem":1},{"lineBreak":true},{"text":"为耶和华—你们的 神欢喜；","poem":1},{"lineBreak":true},{"text":"因他赐给你们合宜的秋雨，","poem":1},{"lineBreak":true},{"text":"为你们降下甘霖，","poem":1},{"lineBreak":true},{"text":"就是秋雨、春雨，和先前一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"禾场必满了麦子；","poem":1},{"lineBreak":true},{"text":"酒榨与油榨必有新酒和油盈溢。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我打发到你们中间的大军队，","poem":1},{"lineBreak":true},{"text":"就是蝗虫、蝻子、蚂蚱、剪虫，","poem":1},{"lineBreak":true},{"text":"那些年所吃的，我要补还你们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"你们必多吃而得饱足，","poem":1},{"lineBreak":true},{"text":"就赞美为你们行奇妙事之耶和华—你们 神的名。","poem":1},{"lineBreak":true},{"text":"我的百姓必永远不至羞愧。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你们必知道我是在以色列中间，","poem":1},{"lineBreak":true},{"text":"又知道我是耶和华—你们的 神；","poem":1},{"lineBreak":true},{"text":"在我以外并无别神。","poem":1},{"lineBreak":true},{"text":"我的百姓必永远不致羞愧。","poem":1}]},{"type":"heading","content":["耶和华的日子"]},{"type":"verse","number":28,"content":[{"text":"以后，我要将我的灵浇灌凡有血气的。","poem":1},{"lineBreak":true},{"text":"你们的儿女要说预言；","poem":1},{"lineBreak":true},{"text":"你们的老年人要做异梦，","poem":1},{"lineBreak":true},{"text":"少年人要见异象。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"在那些日子，","poem":1},{"lineBreak":true},{"text":"我要将我的灵浇灌我的仆人和使女。","poem":1}]},{"type":"verse","number":30,"content":["「在天上地下，我要显出奇事，有血，有火，有烟柱。"]},{"type":"verse","number":31,"content":["日头要变为黑暗，月亮要变为血，这都在耶和华大而可畏的日子未到以前。"]},{"type":"verse","number":32,"content":["到那时候，凡求告耶和华名的就必得救；因为照耶和华所说的，在锡安山，耶路撒冷必有逃脱的人，在剩下的人中必有耶和华所召的。」"]}],"footnotes":[{"noteId":1,"caller":"-","text":"原文是民","reference":{"chapter":2,"verse":2}},{"noteId":2,"caller":"-","text":"原文是事","reference":{"chapter":2,"verse":20}}]},"thisChapterLink":"/api/cmn_cu1/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}