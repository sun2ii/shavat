{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOL","translationId":"cmn_cu1","name":"约珥书","commonName":"约珥书","title":"约珥书","order":29,"numberOfChapters":3,"sha256":"51cc74195201b09308c68d8461e7b1c597c54ed5f150000c302f6e5afab37557","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cu1/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["神要审判万民"]},{"type":"verse","number":1,"content":["「到那日，我使犹大和耶路撒冷被掳之人归回的时候，"]},{"type":"verse","number":2,"content":["我要聚集万民，带他们下到约沙法谷，在那里施行审判；因为他们将我的百姓，就是我的产业以色列，分散在列国中，又分取我的地土，"]},{"type":"verse","number":3,"content":["且为我的百姓拈阄，将童子换妓女，卖童女买酒喝。"]},{"type":"verse","number":4,"content":["「泰尔、西顿，和非利士四境的人哪，你们与我何干？你们要报复我吗？若报复我，我必使报应速速归到你们的头上。"]},{"type":"verse","number":5,"content":["你们既然夺取我的金银，又将我可爱的宝物带入你们宫殿",{"noteId":3},"，"]},{"type":"verse","number":6,"content":["并将犹大人和耶路撒冷人卖给希腊人",{"noteId":4},"，使他们远离自己的境界。"]},{"type":"verse","number":7,"content":["我必激动他们离开你们所卖到之地，又必使报应归到你们的头上。"]},{"type":"verse","number":8,"content":["我必将你们的儿女卖在犹大人的手中，他们必卖给远方示巴国的人。这是耶和华说的。」"]},{"type":"verse","number":9,"content":[{"text":"当在万民中宣告说：","poem":1},{"lineBreak":true},{"text":"要预备打仗；","poem":1},{"lineBreak":true},{"text":"激动勇士，","poem":1},{"lineBreak":true},{"text":"使一切战士上前来。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"要将犁头打成刀剑，","poem":1},{"lineBreak":true},{"text":"将镰刀打成戈矛；","poem":1},{"lineBreak":true},{"text":"软弱的要说：我有勇力。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"四围的列国啊，","poem":1},{"lineBreak":true},{"text":"你们要速速地来，","poem":1},{"lineBreak":true},{"text":"一同聚集。","poem":1},{"lineBreak":true},{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你使你的大能者降临。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"万民都当兴起，","poem":1},{"lineBreak":true},{"text":"上到约沙法谷；","poem":1},{"lineBreak":true},{"text":"因为我必坐在那里，","poem":1},{"lineBreak":true},{"text":"审判四围的列国。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"开镰吧！因为庄稼熟了；","poem":1},{"lineBreak":true},{"text":"践踏吧！因为酒榨满了。","poem":1},{"lineBreak":true},{"text":"酒池盈溢；","poem":1},{"lineBreak":true},{"text":"他们的罪恶甚大。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"许多许多的人在断定谷，","poem":1},{"lineBreak":true},{"text":"因为耶和华的日子临近断定谷。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"日月昏暗，","poem":1},{"lineBreak":true},{"text":"星宿无光。","poem":1}]},{"type":"heading","content":["神将赐福给他的子民"]},{"type":"verse","number":16,"content":[{"text":"耶和华必从锡安吼叫，","poem":1},{"lineBreak":true},{"text":"从耶路撒冷发声，","poem":1},{"lineBreak":true},{"text":"天地就震动。","poem":1},{"lineBreak":true},{"text":"耶和华却要作他百姓的避难所，","poem":1},{"lineBreak":true},{"text":"作以色列人的保障。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"你们就知道我是耶和华—你们的 神，","poem":1},{"lineBreak":true},{"text":"且又住在锡安—我的圣山。","poem":1},{"lineBreak":true},{"text":"那时，耶路撒冷必成为圣；","poem":1},{"lineBreak":true},{"text":"外邦人不再从其中经过。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"到那日，大山要滴甜酒；","poem":1},{"lineBreak":true},{"text":"小山要流奶子；","poem":1},{"lineBreak":true},{"text":"犹大溪河都有水流。","poem":1},{"lineBreak":true},{"text":"必有泉源从耶和华的殿中流出来，","poem":1},{"lineBreak":true},{"text":"滋润什亭谷。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"埃及必然荒凉，","poem":1},{"lineBreak":true},{"text":"以东变为凄凉的旷野，","poem":1},{"lineBreak":true},{"text":"都因向犹大人所行的强暴，","poem":1},{"lineBreak":true},{"text":"又因在本地流无辜人的血。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"但犹大必存到永远；","poem":1},{"lineBreak":true},{"text":"耶路撒冷必存到万代。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我未曾报复","poem":1},{"noteId":5},{"text":"流血的罪，","poem":1},{"lineBreak":true},{"text":"现在我要报复，","poem":1},{"lineBreak":true},{"text":"因为耶和华住在锡安。","poem":1}]}],"footnotes":[{"noteId":3,"caller":"-","text":"或译：庙中","reference":{"chapter":3,"verse":5}},{"noteId":4,"caller":"-","text":"原文是雅完人","reference":{"chapter":3,"verse":6}},{"noteId":5,"caller":"-","text":"或译：洗除；下同","reference":{"chapter":3,"verse":21}}]},"thisChapterLink":"/api/cmn_cu1/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}