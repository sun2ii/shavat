{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JON","translationId":"cmn_cu1","name":"约拿书","commonName":"约拿书","title":"约拿书","order":32,"numberOfChapters":4,"sha256":"0008d19fae71ee096b7c0300b3bb08f70bf68552f98a4321777a48f4ce2ae5b3","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/cmn_cu1/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["约拿的祷告"]},{"type":"verse","number":1,"content":["约拿在鱼腹中祷告耶和华—他的 神，"]},{"type":"verse","number":2,"content":["说：",{"text":"我遭遇患难求告耶和华，","poem":1},{"lineBreak":true},{"text":"你就应允我；","poem":1},{"lineBreak":true},{"text":"从阴间的深处呼求，","poem":1},{"lineBreak":true},{"text":"你就俯听我的声音。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你将我投下深渊，","poem":1},{"lineBreak":true},{"text":"就是海的深处；","poem":1},{"lineBreak":true},{"text":"大水环绕我，","poem":1},{"lineBreak":true},{"text":"你的波浪洪涛都漫过我身。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我说：我从你眼前虽被驱逐，","poem":1},{"lineBreak":true},{"text":"我仍要仰望你的圣殿。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"诸水环绕我，几乎淹没我；","poem":1},{"lineBreak":true},{"text":"深渊围住我；","poem":1},{"lineBreak":true},{"text":"海草缠绕我的头。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我下到山根，","poem":1},{"lineBreak":true},{"text":"地的门将我永远关住。","poem":1},{"lineBreak":true},{"text":"耶和华—我的 神啊，","poem":1},{"lineBreak":true},{"text":"你却将我的性命从坑中救出来。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我心在我里面发昏的时候，","poem":1},{"lineBreak":true},{"text":"我就想念耶和华。","poem":1},{"lineBreak":true},{"text":"我的祷告进入你的圣殿，","poem":1},{"lineBreak":true},{"text":"达到你的面前。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"那信奉虚无之神的人，","poem":1},{"lineBreak":true},{"text":"离弃怜爱他们的主；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"但我必用感谢的声音献祭与你。","poem":1},{"lineBreak":true},{"text":"我所许的愿，我必偿还。","poem":1},{"lineBreak":true},{"text":"救恩出于耶和华。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华吩咐鱼，鱼就把约拿吐在旱地上。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}