{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cu1","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"b316e29205d0d8a036632de38a7d021198bc40183df819ba95bfb7759fcc2949","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cu1/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["耶路撒冷的忧患"]},{"type":"verse","number":1,"content":[{"text":"先前满有人民的城，","poem":1},{"lineBreak":true},{"text":"现在何竟独坐！","poem":1},{"lineBreak":true},{"text":"先前在列国中为大的，","poem":1},{"lineBreak":true},{"text":"现在竟如寡妇；","poem":1},{"lineBreak":true},{"text":"先前在诸省中为王后的，","poem":1},{"lineBreak":true},{"text":"现在成为进贡的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"她夜间痛哭，泪流满腮；","poem":1},{"lineBreak":true},{"text":"在一切所亲爱的中间没有一个安慰她的。","poem":1},{"lineBreak":true},{"text":"她的朋友都以诡诈待她，","poem":1},{"lineBreak":true},{"text":"成为她的仇敌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"犹大因遭遇苦难，","poem":1},{"lineBreak":true},{"text":"又因多服劳苦就迁到外邦。","poem":1},{"lineBreak":true},{"text":"她住在列国中，寻不着安息；","poem":1},{"lineBreak":true},{"text":"追逼她的都在狭窄之地将她追上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"锡安的路径因无人来守圣节就悲伤；","poem":1},{"lineBreak":true},{"text":"她的城门凄凉；","poem":1},{"lineBreak":true},{"text":"她的祭司叹息；","poem":1},{"lineBreak":true},{"text":"她的处女受艰难，自己也愁苦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"她的敌人为首；","poem":1},{"lineBreak":true},{"text":"她的仇敌亨通；","poem":1},{"lineBreak":true},{"text":"因耶和华为她许多的罪过使她受苦；","poem":1},{"lineBreak":true},{"text":"她的孩童被敌人掳去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"锡安城","poem":1},{"noteId":0},{"text":"的威荣全都失去。","poem":1},{"lineBreak":true},{"text":"她的首领像找不着草场的鹿；","poem":1},{"lineBreak":true},{"text":"在追赶的人前无力行走。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶路撒冷在困苦窘迫之时，","poem":1},{"lineBreak":true},{"text":"就追想古时一切的乐境。","poem":1},{"lineBreak":true},{"text":"她百姓落在敌人手中，无人救济；","poem":1},{"lineBreak":true},{"text":"敌人看见，就因她的荒凉嗤笑。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶路撒冷大大犯罪，","poem":1},{"lineBreak":true},{"text":"所以成为不洁之物；","poem":1},{"lineBreak":true},{"text":"素来尊敬她的，见她赤露就都藐视她；","poem":1},{"lineBreak":true},{"text":"她自己也叹息退后。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"她的污秽是在衣襟上；","poem":1},{"lineBreak":true},{"text":"她不思想自己的结局，","poem":1},{"lineBreak":true},{"text":"所以非常地败落，","poem":1},{"lineBreak":true},{"text":"无人安慰她。","poem":1},{"lineBreak":true},{"text":"她说：耶和华啊，求你看我的苦难，","poem":1},{"lineBreak":true},{"text":"因为仇敌夸大。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"敌人伸手，夺取她的美物；","poem":1},{"lineBreak":true},{"text":"她眼见外邦人进入她的圣所—","poem":1},{"lineBreak":true},{"text":"论这外邦人，你曾吩咐不可入你的会中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"她的民都叹息，寻求食物；","poem":1},{"lineBreak":true},{"text":"他们用美物换粮食，要救性命。","poem":1},{"lineBreak":true},{"text":"他们说：耶和华啊，求你观看，","poem":1},{"lineBreak":true},{"text":"因为我甚是卑贱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"你们一切过路的人哪，这事你们不介意吗？","poem":1},{"lineBreak":true},{"text":"你们要观看：","poem":1},{"lineBreak":true},{"text":"有像这临到我的痛苦没有—","poem":1},{"lineBreak":true},{"text":"就是耶和华在他发烈怒的日子使我所受的苦？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"他从高天使火进入我的骨头，","poem":1},{"lineBreak":true},{"text":"克制了我；","poem":1},{"lineBreak":true},{"text":"他铺下网罗，绊我的脚，","poem":1},{"lineBreak":true},{"text":"使我转回；","poem":1},{"lineBreak":true},{"text":"他使我终日凄凉发昏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"我罪过的轭是他手所绑的，","poem":1},{"lineBreak":true},{"text":"犹如轭绳缚在我颈项上；","poem":1},{"lineBreak":true},{"text":"他使我的力量衰败。","poem":1},{"lineBreak":true},{"text":"主将我交在我所不能敌挡的人手中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"主轻弃我中间的一切勇士，","poem":1},{"lineBreak":true},{"text":"招聚多人","poem":1},{"noteId":1},{"text":"攻击我，","poem":1},{"lineBreak":true},{"text":"要压碎我的少年人。","poem":1},{"lineBreak":true},{"text":"主将犹大居民踹下，","poem":1},{"lineBreak":true},{"text":"像在酒榨中一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"我因这些事哭泣；","poem":1},{"lineBreak":true},{"text":"我眼泪汪汪；","poem":1},{"lineBreak":true},{"text":"因为那当安慰我、救我性命的，","poem":1},{"lineBreak":true},{"text":"离我甚远。","poem":1},{"lineBreak":true},{"text":"我的儿女孤苦，","poem":1},{"lineBreak":true},{"text":"因为仇敌得了胜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"锡安举手，无人安慰。","poem":1},{"lineBreak":true},{"text":"耶和华论雅各已经出令，","poem":1},{"lineBreak":true},{"text":"使四围的人作他仇敌；","poem":1},{"lineBreak":true},{"text":"耶路撒冷在他们中间像不洁之物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"耶和华是公义的！","poem":1},{"lineBreak":true},{"text":"他这样待我，是因我违背他的命令。","poem":1},{"lineBreak":true},{"text":"众民哪，请听我的话，","poem":1},{"lineBreak":true},{"text":"看我的痛苦；","poem":1},{"lineBreak":true},{"text":"我的处女和少年人都被掳去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"我招呼我所亲爱的，","poem":1},{"lineBreak":true},{"text":"他们却愚弄我。","poem":1},{"lineBreak":true},{"text":"我的祭司和长老正寻求食物、救性命的时候，","poem":1},{"lineBreak":true},{"text":"就在城中绝气。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"耶和华啊，求你观看，","poem":1},{"lineBreak":true},{"text":"因为我在急难中。","poem":1},{"lineBreak":true},{"text":"我心肠扰乱；","poem":1},{"lineBreak":true},{"text":"我心在我里面翻转，","poem":1},{"lineBreak":true},{"text":"因我大大悖逆。","poem":1},{"lineBreak":true},{"text":"在外，刀剑使人丧子；","poem":1},{"lineBreak":true},{"text":"在家，犹如死亡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"听见我叹息的有人；","poem":1},{"lineBreak":true},{"text":"安慰我的却无人！","poem":1},{"lineBreak":true},{"text":"我的仇敌都听见我所遭的患难；","poem":1},{"lineBreak":true},{"text":"因你做这事，他们都喜乐。","poem":1},{"lineBreak":true},{"text":"你必使你报告的日子来到，","poem":1},{"lineBreak":true},{"text":"他们就像我一样。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"愿他们的恶行都呈在你面前；","poem":1},{"lineBreak":true},{"text":"你怎样因我的一切罪过待我，","poem":1},{"lineBreak":true},{"text":"求你照样待他们；","poem":1},{"lineBreak":true},{"text":"因我叹息甚多，心中发昏。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"原文是女子；下同","reference":{"chapter":1,"verse":6}},{"noteId":1,"caller":"-","text":"原文是大会","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/cmn_cu1/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}