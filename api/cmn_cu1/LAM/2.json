{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cu1","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"b316e29205d0d8a036632de38a7d021198bc40183df819ba95bfb7759fcc2949","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cu1/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["耶和华刑罚耶路撒冷"]},{"type":"verse","number":1,"content":[{"text":"主何竟发怒，使黑云遮蔽锡安城！","poem":1},{"lineBreak":true},{"text":"他将以色列的华美从天扔在地上；","poem":1},{"lineBreak":true},{"text":"在他发怒的日子并不记念自己的脚凳。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"主吞灭雅各一切的住处，并不顾惜。","poem":1},{"lineBreak":true},{"text":"他发怒倾覆犹大民的保障，","poem":1},{"lineBreak":true},{"text":"使这保障坍倒在地；","poem":1},{"lineBreak":true},{"text":"他辱没这国和其中的首领。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"他发烈怒，把以色列的角全然砍断，","poem":1},{"lineBreak":true},{"text":"在仇敌面前收回右手。","poem":1},{"lineBreak":true},{"text":"他像火焰四围吞灭，将雅各烧毁。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他张弓好像仇敌；","poem":1},{"lineBreak":true},{"text":"他站着举起右手，","poem":1},{"lineBreak":true},{"text":"如同敌人将悦人眼目的，尽行杀戮。","poem":1},{"lineBreak":true},{"text":"在锡安百姓的帐棚上","poem":1},{"lineBreak":true},{"text":"倒出他的忿怒，像火一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"主如仇敌吞灭以色列和锡安的一切宫殿，","poem":1},{"lineBreak":true},{"text":"拆毁百姓的保障；","poem":1},{"lineBreak":true},{"text":"在犹大民中加增悲伤哭号。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"他强取自己的帐幕，好像是园中的窝棚，","poem":1},{"lineBreak":true},{"text":"毁坏他的聚会之处。","poem":1},{"lineBreak":true},{"text":"耶和华使圣节和安息日在锡安都被忘记，","poem":1},{"lineBreak":true},{"text":"又在怒气的愤恨中藐视君王和祭司。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华丢弃自己的祭坛，","poem":1},{"lineBreak":true},{"text":"憎恶自己的圣所，","poem":1},{"lineBreak":true},{"text":"将宫殿的墙垣交付仇敌。","poem":1},{"lineBreak":true},{"text":"他们在耶和华的殿中喧嚷，","poem":1},{"lineBreak":true},{"text":"像在圣会之日一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华定意拆毁锡安的城墙；","poem":1},{"lineBreak":true},{"text":"他拉了准绳，","poem":1},{"lineBreak":true},{"text":"不将手收回，定要毁灭。","poem":1},{"lineBreak":true},{"text":"他使外郭和城墙都悲哀，","poem":1},{"lineBreak":true},{"text":"一同衰败。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"锡安的门都陷入地内；","poem":1},{"lineBreak":true},{"text":"主将她的门闩毁坏，折断。","poem":1},{"lineBreak":true},{"text":"她的君王和首领落在没有律法的列国中；","poem":1},{"lineBreak":true},{"text":"她的先知不得见耶和华的异象。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"锡安城的长老坐在地上默默无声；","poem":1},{"lineBreak":true},{"text":"他们扬起尘土落在头上，腰束麻布；","poem":1},{"lineBreak":true},{"text":"耶路撒冷的处女垂头至地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我眼中流泪，以致失明；","poem":1},{"lineBreak":true},{"text":"我的心肠扰乱，肝胆涂地，","poem":1},{"lineBreak":true},{"text":"都因我众民遭毁灭，","poem":1},{"lineBreak":true},{"text":"又因孩童和吃奶的在城内街上发昏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"那时，他们在城内街上发昏，好像受伤的，","poem":1},{"lineBreak":true},{"text":"在母亲的怀里，将要丧命；","poem":1},{"lineBreak":true},{"text":"对母亲说：谷、酒在哪里呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶路撒冷的民哪，我可用什么向你证明呢？","poem":1},{"lineBreak":true},{"text":"我可用什么与你相比呢？","poem":1},{"lineBreak":true},{"text":"锡安的民哪，我可拿什么和你比较，好安慰你呢？","poem":1},{"lineBreak":true},{"text":"因为你的裂口大如海，","poem":1},{"lineBreak":true},{"text":"谁能医治你呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"你的先知为你见虚假和愚昧的异象，","poem":1},{"lineBreak":true},{"text":"并没有显露你的罪孽，","poem":1},{"lineBreak":true},{"text":"使你被掳的归回；","poem":1},{"lineBreak":true},{"text":"却为你见虚假的默示","poem":1},{"lineBreak":true},{"text":"和使你被赶出本境的缘故。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"凡过路的都向你拍掌。","poem":1},{"lineBreak":true},{"text":"他们向耶路撒冷城嗤笑，摇头，说：","poem":1},{"lineBreak":true},{"text":"难道人所称为全美的，","poem":1},{"lineBreak":true},{"text":"称为全地所喜悦的，就是这城吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"你的仇敌都向你大大张口；","poem":1},{"lineBreak":true},{"text":"他们嗤笑，又切齿说：","poem":1},{"lineBreak":true},{"text":"我们吞灭她。","poem":1},{"lineBreak":true},{"text":"这真是我们所盼望的日子临到了！","poem":1},{"lineBreak":true},{"text":"我们亲眼看见了！","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"耶和华成就了他所定的，","poem":1},{"lineBreak":true},{"text":"应验了他古时所命定的。","poem":1},{"lineBreak":true},{"text":"他倾覆了，并不顾惜，","poem":1},{"lineBreak":true},{"text":"使你的仇敌向你夸耀；","poem":1},{"lineBreak":true},{"text":"使你敌人的角也被高举。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"锡安民的心哀求主。","poem":1},{"lineBreak":true},{"text":"锡安的城墙啊，愿你流泪如河，","poem":1},{"lineBreak":true},{"text":"昼夜不息；","poem":1},{"lineBreak":true},{"text":"愿你眼中的瞳人泪流不止。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"夜间，每逢交更的时候要起来呼喊，","poem":1},{"lineBreak":true},{"text":"在主面前倾心如水。","poem":1},{"lineBreak":true},{"text":"你的孩童在各市口上受饿发昏；","poem":1},{"lineBreak":true},{"text":"你要为他们的性命向主举手祷告。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"耶和华啊，求你观看！","poem":1},{"lineBreak":true},{"text":"见你向谁这样行？","poem":1},{"lineBreak":true},{"text":"妇人岂可吃自己所生育手里所摇弄的婴孩吗？","poem":1},{"lineBreak":true},{"text":"祭司和先知岂可在主的圣所中被杀戮吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"少年人和老年人都在街上躺卧；","poem":1},{"lineBreak":true},{"text":"我的处女和壮丁都倒在刀下；","poem":1},{"lineBreak":true},{"text":"你发怒的日子杀死他们。","poem":1},{"lineBreak":true},{"text":"你杀了，并不顾惜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"你招聚四围惊吓我的，","poem":1},{"lineBreak":true},{"text":"像在大会的日子招聚人一样。","poem":1},{"lineBreak":true},{"text":"耶和华发怒的日子，","poem":1},{"lineBreak":true},{"text":"无人逃脱，无人存留。","poem":1},{"lineBreak":true},{"text":"我所摇弄所养育的婴孩，","poem":1},{"lineBreak":true},{"text":"仇敌都杀净了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}