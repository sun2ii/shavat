{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cu1","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"b316e29205d0d8a036632de38a7d021198bc40183df819ba95bfb7759fcc2949","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cu1/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["刑罚、悔改、希望"]},{"type":"verse","number":1,"content":[{"text":"我是因耶和华忿怒的杖，","poem":1},{"lineBreak":true},{"text":"遭遇困苦的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他引导我，使我行在黑暗中，","poem":1},{"lineBreak":true},{"text":"不行在光明里。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他真是终日再三反手攻击我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他使我的皮肉枯干；","poem":1},{"lineBreak":true},{"text":"他折断","poem":1},{"noteId":2},{"text":"我的骨头。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他筑垒攻击我，","poem":1},{"lineBreak":true},{"text":"用苦楚","poem":1},{"noteId":3},{"text":"和艰难围困我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他使我住在幽暗之处，","poem":1},{"lineBreak":true},{"text":"像死了许久的人一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"他用篱笆围住我，使我不能出去；","poem":1},{"lineBreak":true},{"text":"他使我的铜链沉重。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我哀号求救；","poem":1},{"lineBreak":true},{"text":"他使我的祷告不得上达。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他用凿过的石头挡住我的道；","poem":1},{"lineBreak":true},{"text":"他使我的路弯曲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"他向我如熊埋伏，","poem":1},{"lineBreak":true},{"text":"如狮子在隐密处。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他使我转离正路，","poem":1},{"lineBreak":true},{"text":"将我撕碎，使我凄凉。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他张弓将我当作箭靶子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"他把箭袋中的箭射入我的肺腑。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我成了众民的笑话；","poem":1},{"lineBreak":true},{"text":"他们终日以我为歌曲。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他用苦楚充满我，使我饱用茵 。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"他又用沙石碜断我的牙，","poem":1},{"lineBreak":true},{"text":"用灰尘将我蒙蔽。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你使我远离平安，","poem":1},{"lineBreak":true},{"text":"我忘记好处。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我就说：我的力量衰败；","poem":1},{"lineBreak":true},{"text":"我在耶和华那里毫无指望！","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和华啊，求你记念我","poem":1},{"lineBreak":true},{"text":"如茵 和苦胆的困苦窘迫。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我心想念这些，","poem":1},{"lineBreak":true},{"text":"就在里面忧闷。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我想起这事，","poem":1},{"lineBreak":true},{"text":"心里就有指望。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"我们不致消灭，","poem":1},{"lineBreak":true},{"text":"是出于耶和华诸般的慈爱；","poem":1},{"lineBreak":true},{"text":"是因他的怜悯不致断绝。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"每早晨，这都是新的；","poem":1},{"lineBreak":true},{"text":"你的诚实极其广大！","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我心里说：耶和华是我的分，","poem":1},{"lineBreak":true},{"text":"因此，我要仰望他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"凡等候耶和华，心里寻求他的，","poem":1},{"lineBreak":true},{"text":"耶和华必施恩给他。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"人仰望耶和华，","poem":1},{"lineBreak":true},{"text":"静默等候他的救恩，","poem":1},{"lineBreak":true},{"text":"这原是好的。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"人在幼年负轭，","poem":1},{"lineBreak":true},{"text":"这原是好的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"他当独坐无言，","poem":1},{"lineBreak":true},{"text":"因为这是耶和华加在他身上的。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他当口贴尘埃，","poem":1},{"lineBreak":true},{"text":"或者有指望。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他当由人打他的腮颊，","poem":1},{"lineBreak":true},{"text":"要满受凌辱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"因为主必不永远丢弃人。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"主虽使人忧愁，","poem":1},{"lineBreak":true},{"text":"还要照他诸般的慈爱发怜悯。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"因他并不甘心使人受苦，","poem":1},{"lineBreak":true},{"text":"使人忧愁。","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"人将世上被囚的踹","poem":1},{"noteId":4},{"text":"在脚下，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"或在至高者面前屈枉人，","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"或在人的讼事上颠倒是非，","poem":1},{"lineBreak":true},{"text":"这都是主看不上的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"除非主命定，","poem":1},{"lineBreak":true},{"text":"谁能说成就成呢？","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"祸福不都出于至高者的口吗？","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"活人因自己的罪受罚，","poem":1},{"lineBreak":true},{"text":"为何发怨言呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"我们当深深考察自己的行为，","poem":1},{"lineBreak":true},{"text":"再归向耶和华。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"我们当诚心向天上的 神举手祷告。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"我们犯罪背逆，","poem":1},{"lineBreak":true},{"text":"你并不赦免。","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"你自被怒气遮蔽，追赶我们；","poem":1},{"lineBreak":true},{"text":"你施行杀戮，并不顾惜。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"你以黑云遮蔽自己，","poem":1},{"lineBreak":true},{"text":"以致祷告不得透入。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"你使我们在万民中成为污秽和渣滓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"我们的仇敌都向我们大大张口。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"恐惧和陷坑，残害和毁灭，","poem":1},{"lineBreak":true},{"text":"都临近我们。","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"因我众民遭的毁灭，","poem":1},{"lineBreak":true},{"text":"我就眼泪下流如河。","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"我的眼多多流泪，","poem":1},{"lineBreak":true},{"text":"总不止息，","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"直等耶和华垂顾，","poem":1},{"lineBreak":true},{"text":"从天观看。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"因我本城的众民，","poem":1},{"lineBreak":true},{"text":"我的眼，使我的心伤痛。","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"无故与我为仇的追逼我，","poem":1},{"lineBreak":true},{"text":"像追雀鸟一样。","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"他们使我的命在牢狱中断绝，","poem":1},{"lineBreak":true},{"text":"并将一块石头抛在我身上。","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"众水流过我头，","poem":1},{"lineBreak":true},{"text":"我说：我命断绝了！","poem":1}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"耶和华啊，","poem":1},{"lineBreak":true},{"text":"我从深牢中求告你的名。","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"你曾听见我的声音；","poem":1},{"lineBreak":true},{"text":"我求你解救，","poem":1},{"lineBreak":true},{"text":"你不要掩耳不听。","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"我求告你的日子，你临近我，","poem":1},{"lineBreak":true},{"text":"说：不要惧怕！","poem":1}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"主啊，你伸明了我的冤；","poem":1},{"lineBreak":true},{"text":"你救赎了我的命。","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"耶和华啊，你见了我受的委屈；","poem":1},{"lineBreak":true},{"text":"求你为我伸冤。","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"他们仇恨我，谋害我，","poem":1},{"lineBreak":true},{"text":"你都看见了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"耶和华啊，你听见他们辱骂我的话，","poem":1},{"lineBreak":true},{"text":"知道他们向我所设的计，","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"并那些起来攻击我的人口中所说的话，","poem":1},{"lineBreak":true},{"text":"以及终日向我所设的计谋。","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"求你观看，","poem":1},{"lineBreak":true},{"text":"他们坐下，起来，都以我为歌曲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"耶和华啊，你要按着他们手所做的","poem":1},{"lineBreak":true},{"text":"向他们施行报应。","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"你要使他们心里刚硬，","poem":1},{"lineBreak":true},{"text":"使你的咒诅临到他们。","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"你要发怒追赶他们，","poem":1},{"lineBreak":true},{"text":"从耶和华的天下除灭他们。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"-","text":"或译：压伤","reference":{"chapter":3,"verse":4}},{"noteId":3,"caller":"-","text":"原文是苦胆","reference":{"chapter":3,"verse":5}},{"noteId":4,"caller":"-","text":"原文是压","reference":{"chapter":3,"verse":34}}]},"thisChapterLink":"/api/cmn_cu1/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}