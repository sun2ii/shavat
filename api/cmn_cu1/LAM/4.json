{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cu1","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"b316e29205d0d8a036632de38a7d021198bc40183df819ba95bfb7759fcc2949","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cu1/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["耶路撒冷陷落之后"]},{"type":"verse","number":1,"content":[{"text":"黄金何其失光！","poem":1},{"lineBreak":true},{"text":"纯金何其变色！","poem":1},{"lineBreak":true},{"text":"圣所的石头倒在各市口上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"锡安宝贵的众子好比精金，","poem":1},{"lineBreak":true},{"text":"现在何竟算为窑匠手所做的瓦瓶？","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"野狗尚且把奶乳哺其子，","poem":1},{"lineBreak":true},{"text":"我民的妇人倒成为残忍，","poem":1},{"lineBreak":true},{"text":"好像旷野的鸵鸟一般。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"吃奶孩子的舌头因干渴贴住上膛；","poem":1},{"lineBreak":true},{"text":"孩童求饼，无人擘给他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"素来吃美好食物的，","poem":1},{"lineBreak":true},{"text":"现今在街上变为孤寒；","poem":1},{"lineBreak":true},{"text":"素来卧朱红褥子的，","poem":1},{"lineBreak":true},{"text":"现今躺卧粪堆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"都因我众民的罪孽比所多玛的罪还大；","poem":1},{"lineBreak":true},{"text":"所多玛虽然无人加手于她，","poem":1},{"lineBreak":true},{"text":"还是转眼之间被倾覆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"锡安的贵胄素来比雪纯净，","poem":1},{"lineBreak":true},{"text":"比奶更白；","poem":1},{"lineBreak":true},{"text":"他们的身体比红宝玉","poem":1},{"noteId":5},{"text":"更红，","poem":1},{"lineBreak":true},{"text":"像光润的蓝宝石一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"现在他们的面貌比煤炭更黑，","poem":1},{"lineBreak":true},{"text":"以致在街上无人认识；","poem":1},{"lineBreak":true},{"text":"他们的皮肤紧贴骨头，","poem":1},{"lineBreak":true},{"text":"枯干如同槁木。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"饿死的不如被刀杀的，","poem":1},{"lineBreak":true},{"text":"因为这是缺了田间的土产，","poem":1},{"lineBreak":true},{"text":"就身体衰弱，渐渐消灭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"慈心的妇人，当我众民被毁灭的时候，","poem":1},{"lineBreak":true},{"text":"亲手煮自己的儿女作为食物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和华发怒成就他所定的，","poem":1},{"lineBreak":true},{"text":"倒出他的烈怒；","poem":1},{"lineBreak":true},{"text":"在锡安使火着起，","poem":1},{"lineBreak":true},{"text":"烧毁锡安的根基。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"地上的君王和世上的居民都不信","poem":1},{"lineBreak":true},{"text":"敌人和仇敌能进耶路撒冷的城门。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"这都因她先知的罪恶和祭司的罪孽；","poem":1},{"lineBreak":true},{"text":"他们在城中流了义人的血。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"他们在街上如瞎子乱走，","poem":1},{"lineBreak":true},{"text":"又被血玷污，","poem":1},{"lineBreak":true},{"text":"以致人不能摸他们的衣服。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"人向他们喊着说：","poem":1},{"lineBreak":true},{"text":"不洁净的，躲开，躲开！","poem":1},{"lineBreak":true},{"text":"不要挨近我！","poem":1},{"lineBreak":true},{"text":"他们逃走飘流的时候，","poem":1},{"lineBreak":true},{"text":"列国中有人说：","poem":1},{"lineBreak":true},{"text":"他们不可仍在这里寄居。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和华发怒，将他们分散，","poem":1},{"lineBreak":true},{"text":"不再眷顾他们；","poem":1},{"lineBreak":true},{"text":"人不重看祭司，也不厚待长老。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"我们仰望人来帮助，","poem":1},{"lineBreak":true},{"text":"以致眼目失明，还是枉然；","poem":1},{"lineBreak":true},{"text":"我们所盼望的，竟盼望一个不能救人的国！","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"仇敌追赶我们的脚步像打猎的，","poem":1},{"lineBreak":true},{"text":"以致我们不敢在自己的街上行走。","poem":1},{"lineBreak":true},{"text":"我们的结局临近；","poem":1},{"lineBreak":true},{"text":"我们的日子满足；","poem":1},{"lineBreak":true},{"text":"我们的结局来到了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"追赶我们的比空中的鹰更快；","poem":1},{"lineBreak":true},{"text":"他们在山上追逼我们，","poem":1},{"lineBreak":true},{"text":"在旷野埋伏，等候我们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"耶和华的受膏者好比我们鼻中的气，","poem":1},{"lineBreak":true},{"text":"在他们的坑中被捉住；","poem":1},{"lineBreak":true},{"text":"我们曾论到他说：","poem":1},{"lineBreak":true},{"text":"我们必在他荫下，","poem":1},{"lineBreak":true},{"text":"在列国中存活。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"住乌斯地的以东民哪，只管欢喜快乐；","poem":1},{"lineBreak":true},{"text":"苦杯也必传到你那里；","poem":1},{"lineBreak":true},{"text":"你必喝醉，以致露体。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"锡安的民哪，你罪孽的刑罚受足了，","poem":1},{"lineBreak":true},{"text":"耶和华必不使你再被掳去。","poem":1},{"lineBreak":true},{"text":"以东的民哪，他必追讨你的罪孽，","poem":1},{"lineBreak":true},{"text":"显露你的罪恶。","poem":1}]}],"footnotes":[{"noteId":5,"caller":"-","text":"或译：珊瑚","reference":{"chapter":4,"verse":7}}]},"thisChapterLink":"/api/cmn_cu1/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}