{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cu1","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"b316e29205d0d8a036632de38a7d021198bc40183df819ba95bfb7759fcc2949","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cu1/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["求耶和华垂怜"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你记念我们所遭遇的事，","poem":1},{"lineBreak":true},{"text":"观看我们所受的凌辱。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我们的产业归与外邦人；","poem":1},{"lineBreak":true},{"text":"我们的房屋归与外路人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我们是无父的孤儿；","poem":1},{"lineBreak":true},{"text":"我们的母亲好像寡妇。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们出钱才得水喝；","poem":1},{"lineBreak":true},{"text":"我们的柴是人卖给我们的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"追赶我们的，到了我们的颈项上；","poem":1},{"lineBreak":true},{"text":"我们疲乏不得歇息。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我们投降埃及人和亚述人，","poem":1},{"lineBreak":true},{"text":"为要得粮吃饱。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我们列祖犯罪，而今不在了；","poem":1},{"lineBreak":true},{"text":"我们担当他们的罪孽。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"奴仆辖制我们，","poem":1},{"lineBreak":true},{"text":"无人救我们脱离他们的手。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为旷野的刀剑，","poem":1},{"lineBreak":true},{"text":"我们冒着险才得粮食。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因饥饿燥热，","poem":1},{"lineBreak":true},{"text":"我们的皮肤就黑如炉。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"敌人在锡安玷污妇人，","poem":1},{"lineBreak":true},{"text":"在犹大的城邑玷污处女。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们吊起首领的手，","poem":1},{"lineBreak":true},{"text":"也不尊敬老人的面。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"少年人扛磨石，","poem":1},{"lineBreak":true},{"text":"孩童背木柴，都绊跌了。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"老年人在城门口断绝；","poem":1},{"lineBreak":true},{"text":"少年人不再作乐。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我们心中的快乐止息，","poem":1},{"lineBreak":true},{"text":"跳舞变为悲哀。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"冠冕从我们的头上落下；","poem":1},{"lineBreak":true},{"text":"我们犯罪了，我们有祸了！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"这些事我们心里发昏，","poem":1},{"lineBreak":true},{"text":"我们的眼睛昏花。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"锡安山荒凉，","poem":1},{"lineBreak":true},{"text":"野狗","poem":1},{"noteId":6},{"text":"行在其上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和华啊，你存到永远；","poem":1},{"lineBreak":true},{"text":"你的宝座存到万代。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你为何永远忘记我们？","poem":1},{"lineBreak":true},{"text":"为何许久离弃我们？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和华啊，求你使我们向你回转，","poem":1},{"lineBreak":true},{"text":"我们便得回转。","poem":1},{"lineBreak":true},{"text":"求你复新我们的日子，像古时一样。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你竟全然弃绝我们，","poem":1},{"lineBreak":true},{"text":"向我们大发烈怒？","poem":1}]}],"footnotes":[{"noteId":6,"caller":"-","text":"或译：狐狸","reference":{"chapter":5,"verse":18}}]},"thisChapterLink":"/api/cmn_cu1/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}