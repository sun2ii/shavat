{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cu1","name":"弥迦书","commonName":"弥迦书","title":"弥迦书","order":33,"numberOfChapters":7,"sha256":"5d5b897647548ba0f6a03c05fd8c35d9e107b33b299c49301880b3a83eca015c","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cu1/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["当犹大王约坦、亚哈斯、希西家在位的时候，摩利沙人弥迦得耶和华的默示，论撒马利亚和耶路撒冷。"]},{"type":"heading","content":["为撒马利亚和耶路撒冷唱哀歌"]},{"type":"verse","number":2,"content":[{"text":"万民哪，你们都要听！","poem":1},{"lineBreak":true},{"text":"地和其上所有的，也都要侧耳而听！","poem":1},{"lineBreak":true},{"text":"主耶和华从他的圣殿","poem":1},{"lineBreak":true},{"text":"要见证你们的不是。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"看哪，耶和华出了他的居所，","poem":1},{"lineBreak":true},{"text":"降临步行地的高处。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"众山在他以下必消化，","poem":1},{"lineBreak":true},{"text":"诸谷必崩裂，","poem":1},{"lineBreak":true},{"text":"如蜡化在火中，","poem":1},{"lineBreak":true},{"text":"如水冲下山坡。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"这都因雅各的罪过，","poem":1},{"lineBreak":true},{"text":"以色列家的罪恶。","poem":1},{"lineBreak":true},{"text":"雅各的罪过在哪里呢？","poem":1},{"lineBreak":true},{"text":"岂不是在撒马利亚吗？","poem":1},{"lineBreak":true},{"text":"犹大的邱坛在哪里呢？","poem":1},{"lineBreak":true},{"text":"岂不是在耶路撒冷吗？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"所以我必使撒马利亚变为田野的乱堆，","poem":1},{"lineBreak":true},{"text":"又作为种葡萄之处；","poem":1},{"lineBreak":true},{"text":"也必将她的石头倒在谷中，","poem":1},{"lineBreak":true},{"text":"露出根基来。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"她一切雕刻的偶像必被打碎；","poem":1},{"lineBreak":true},{"text":"她所得的财物必被火烧；","poem":1},{"lineBreak":true},{"text":"所有的偶像我必毁灭；","poem":1},{"lineBreak":true},{"text":"因为是从妓女雇价所聚来的，","poem":1},{"lineBreak":true},{"text":"后必归为妓女的雇价。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"先知说：因此我必大声哀号，","poem":1},{"lineBreak":true},{"text":"赤脚露体而行；","poem":1},{"lineBreak":true},{"text":"又要呼号如野狗，","poem":1},{"lineBreak":true},{"text":"哀鸣如鸵鸟。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为撒马利亚的伤痕无法医治，","poem":1},{"lineBreak":true},{"text":"延及犹大和耶路撒冷我民的城门。","poem":1}]},{"type":"heading","content":["敌人迫近耶路撒冷"]},{"type":"verse","number":10,"content":[{"text":"不要在迦特报告这事，","poem":1},{"lineBreak":true},{"text":"总不要哭泣；","poem":1},{"lineBreak":true},{"text":"我在伯·亚弗拉滚于灰尘之中。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"沙斐的居民哪，你们要赤身蒙羞过去。","poem":1},{"lineBreak":true},{"text":"撒南的居民不敢出来。","poem":1},{"lineBreak":true},{"text":"伯·以薛人的哀哭使你们无处可站。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"玛律的居民心甚忧急，切望得好处，","poem":1},{"lineBreak":true},{"text":"因为灾祸从耶和华那里临到耶路撒冷的城门。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"拉吉的居民哪，要用快马套车；","poem":1},{"lineBreak":true},{"text":"锡安民","poem":1},{"noteId":0},{"text":"的罪由你而起；","poem":1},{"lineBreak":true},{"text":"以色列人的罪过在你那里显出。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"犹大啊，你要将礼物送给摩利设·迦特。","poem":1},{"lineBreak":true},{"text":"亚革悉的众族必用诡诈待以色列诸王。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"玛利沙的居民哪，","poem":1},{"lineBreak":true},{"text":"我必使那夺取你的来到你这里；","poem":1},{"lineBreak":true},{"text":"以色列的尊贵人","poem":1},{"noteId":1},{"text":"必到亚杜兰。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"犹大啊，要为你所喜爱的儿女剪除你的头发，","poem":1},{"lineBreak":true},{"text":"使头光秃，要大大地光秃，如同秃鹰，","poem":1},{"lineBreak":true},{"text":"因为他们都被掳去离开你。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"原文是女子","reference":{"chapter":1,"verse":13}},{"noteId":1,"caller":"-","text":"原文是荣耀","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/cmn_cu1/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}