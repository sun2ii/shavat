{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cu1","name":"弥迦书","commonName":"弥迦书","title":"弥迦书","order":33,"numberOfChapters":7,"sha256":"5d5b897647548ba0f6a03c05fd8c35d9e107b33b299c49301880b3a83eca015c","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cu1/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["弥迦斥责以色列的领袖"]},{"type":"verse","number":1,"content":[{"text":"我说：雅各的首领，","poem":1},{"lineBreak":true},{"text":"以色列家的官长啊，你们要听！","poem":1},{"lineBreak":true},{"text":"你们不当知道公平吗？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们恶善好恶，","poem":1},{"lineBreak":true},{"text":"从人身上剥皮，","poem":1},{"lineBreak":true},{"text":"从人骨头上剔肉，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"吃我民的肉，","poem":1},{"lineBreak":true},{"text":"剥他们的皮，","poem":1},{"lineBreak":true},{"text":"打折他们的骨头，","poem":1},{"lineBreak":true},{"text":"分成块子像要下锅，","poem":1},{"lineBreak":true},{"text":"又像釜中的肉。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"到了遭灾的时候，","poem":1},{"lineBreak":true},{"text":"这些人必哀求耶和华，","poem":1},{"lineBreak":true},{"text":"他却不应允他们。","poem":1},{"lineBreak":true},{"text":"那时他必照他们所行的恶事向他们掩面。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"论到使我民走差路的先知—","poem":1},{"lineBreak":true},{"text":"他们牙齿有所嚼的，","poem":1},{"lineBreak":true},{"text":"他们就呼喊说：平安了！","poem":1},{"lineBreak":true},{"text":"凡不供给他们吃的，","poem":1},{"lineBreak":true},{"text":"他们就预备攻击他","poem":1},{"noteId":6},{"text":"—","poem":1},{"lineBreak":true},{"text":"耶和华如此说：","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你们必遭遇黑夜，以致不见异象；","poem":1},{"lineBreak":true},{"text":"又必遭遇幽暗，以致不能占卜。","poem":1},{"lineBreak":true},{"text":"日头必向你们沉落，","poem":1},{"lineBreak":true},{"text":"白昼变为黑暗。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"先见必抱愧，","poem":1},{"lineBreak":true},{"text":"占卜的必蒙羞，","poem":1},{"lineBreak":true},{"text":"都必捂着嘴唇，","poem":1},{"lineBreak":true},{"text":"因为 神不应允他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"至于我，我借耶和华的灵，","poem":1},{"lineBreak":true},{"text":"满有力量、公平、才能，","poem":1},{"lineBreak":true},{"text":"可以向雅各说明他的过犯，","poem":1},{"lineBreak":true},{"text":"向以色列指出他的罪恶。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"雅各家的首领、以色列家的官长啊，","poem":1},{"lineBreak":true},{"text":"当听我的话！","poem":1},{"lineBreak":true},{"text":"你们厌恶公平，","poem":1},{"lineBreak":true},{"text":"在一切事上屈枉正直；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"以人血建立锡安，","poem":1},{"lineBreak":true},{"text":"以罪孽建造耶路撒冷。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"首领为贿赂行审判；","poem":1},{"lineBreak":true},{"text":"祭司为雇价施训诲；","poem":1},{"lineBreak":true},{"text":"先知为银钱行占卜。","poem":1},{"lineBreak":true},{"text":"他们却倚赖耶和华，说：","poem":1},{"lineBreak":true},{"text":"耶和华不是在我们中间吗？","poem":1},{"lineBreak":true},{"text":"灾祸必不临到我们。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"所以因你们的缘故，","poem":1},{"lineBreak":true},{"text":"锡安必被耕种像一块田，","poem":1},{"lineBreak":true},{"text":"耶路撒冷必变为乱堆；","poem":1},{"lineBreak":true},{"text":"这殿的山必像丛林的高处。","poem":1}]}],"footnotes":[{"noteId":6,"caller":"-","text":"预备攻击他：或译说必遭遇刀兵","reference":{"chapter":3,"verse":5}}]},"thisChapterLink":"/api/cmn_cu1/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}