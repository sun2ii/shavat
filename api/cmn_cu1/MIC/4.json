{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cu1","name":"弥迦书","commonName":"弥迦书","title":"弥迦书","order":33,"numberOfChapters":7,"sha256":"5d5b897647548ba0f6a03c05fd8c35d9e107b33b299c49301880b3a83eca015c","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cu1/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["耶和华作王，天下太平"]},{"type":"verse","number":1,"content":[{"text":"末后的日子，","poem":1},{"lineBreak":true},{"text":"耶和华殿的山必坚立，","poem":1},{"lineBreak":true},{"text":"超乎诸山，高举过于万岭；","poem":1},{"lineBreak":true},{"text":"万民都要流归这山。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"必有许多国的民前往，说：","poem":1},{"lineBreak":true},{"text":"来吧，我们登耶和华的山，","poem":1},{"lineBreak":true},{"text":"奔雅各 神的殿。","poem":1},{"lineBreak":true},{"text":"主必将他的道教训我们；","poem":1},{"lineBreak":true},{"text":"我们也要行他的路。","poem":1},{"lineBreak":true},{"text":"因为训诲必出于锡安；","poem":1},{"lineBreak":true},{"text":"耶和华的言语必出于耶路撒冷。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"他必在多国的民中施行审判，","poem":1},{"lineBreak":true},{"text":"为远方强盛的国断定是非。","poem":1},{"lineBreak":true},{"text":"他们要将刀打成犁头，","poem":1},{"lineBreak":true},{"text":"把枪打成镰刀。","poem":1},{"lineBreak":true},{"text":"这国不举刀攻击那国；","poem":1},{"lineBreak":true},{"text":"他们也不再学习战事。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"人人都要坐在自己葡萄树下","poem":1},{"lineBreak":true},{"text":"和无花果树下，无人惊吓。","poem":1},{"lineBreak":true},{"text":"这是万军之耶和华亲口说的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"万民各奉己神的名而行；","poem":1},{"lineBreak":true},{"text":"我们却永永远远奉耶和华—我们 神的名而行。","poem":1}]},{"type":"heading","content":["以色列人归回本国"]},{"type":"verse","number":6,"content":[{"text":"耶和华说：到那日，","poem":1},{"lineBreak":true},{"text":"我必聚集瘸腿的，","poem":1},{"lineBreak":true},{"text":"招聚被赶出的和我所惩治的。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我必使瘸腿的为余剩之民，","poem":1},{"lineBreak":true},{"text":"使赶到远方的为强盛之民。","poem":1},{"lineBreak":true},{"text":"耶和华要在锡安山作王治理他们，","poem":1},{"lineBreak":true},{"text":"从今直到永远。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你这羊群的高台、锡安城","poem":1},{"noteId":7},{"text":"的山哪，","poem":1},{"lineBreak":true},{"text":"从前的权柄—","poem":1},{"lineBreak":true},{"text":"就是耶路撒冷民","poem":1},{"noteId":8},{"text":"的国权—","poem":1},{"lineBreak":true},{"text":"必归与你。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"现在你为何大声哭号呢？","poem":1},{"lineBreak":true},{"text":"疼痛抓住你仿佛产难的妇人，","poem":1},{"lineBreak":true},{"text":"是因你中间没有君王吗？","poem":1},{"lineBreak":true},{"text":"你的谋士灭亡了吗？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"锡安的民","poem":1},{"noteId":9},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"你要疼痛劬劳，仿佛产难的妇人；","poem":1},{"lineBreak":true},{"text":"因为你必从城里出来，","poem":1},{"lineBreak":true},{"text":"住在田野，到巴比伦去。","poem":1},{"lineBreak":true},{"text":"在那里要蒙解救；","poem":1},{"lineBreak":true},{"text":"在那里耶和华必救赎你脱离仇敌的手。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"现在有许多国的民聚集攻击你，说：","poem":1},{"lineBreak":true},{"text":"愿锡安被玷污！","poem":1},{"lineBreak":true},{"text":"愿我们亲眼见她遭报！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们却不知道耶和华的意念，","poem":1},{"lineBreak":true},{"text":"也不明白他的筹划。","poem":1},{"lineBreak":true},{"text":"他聚集他们，好像把禾捆聚到禾场一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"锡安的民","poem":1},{"noteId":10},{"text":"哪，起来踹谷吧！","poem":1},{"lineBreak":true},{"text":"我必使你的角成为铁，","poem":1},{"lineBreak":true},{"text":"使你的蹄成为铜。","poem":1},{"lineBreak":true},{"text":"你必打碎多国的民，","poem":1},{"lineBreak":true},{"text":"将他们的财献与耶和华，","poem":1},{"lineBreak":true},{"text":"将他们的货献与普天下的主。","poem":1}]}],"footnotes":[{"noteId":7,"caller":"-","text":"原文是女子","reference":{"chapter":4,"verse":8}},{"noteId":8,"caller":"-","text":"原文是女子","reference":{"chapter":4,"verse":8}},{"noteId":9,"caller":"-","text":"原文是女子","reference":{"chapter":4,"verse":10}},{"noteId":10,"caller":"-","text":"原文是女子","reference":{"chapter":4,"verse":13}}]},"thisChapterLink":"/api/cmn_cu1/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}