{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cu1","name":"弥迦书","commonName":"弥迦书","title":"弥迦书","order":33,"numberOfChapters":7,"sha256":"5d5b897647548ba0f6a03c05fd8c35d9e107b33b299c49301880b3a83eca015c","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cu1/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"成群的民","poem":1},{"noteId":11},{"text":"哪，现在你要聚集成队；","poem":1},{"lineBreak":true},{"text":"因为仇敌围攻我们，","poem":1},{"lineBreak":true},{"text":"要用杖击打以色列审判者的脸。","poem":1}]},{"type":"heading","content":["神应许一位掌权者出于伯利恒"]},{"type":"verse","number":2,"content":[{"text":"伯利恒的以法他啊，","poem":1},{"lineBreak":true},{"text":"你在犹大诸城中为小，","poem":1},{"lineBreak":true},{"text":"将来必有一位从你那里出来，","poem":1},{"lineBreak":true},{"text":"在以色列中为我作掌权的；","poem":1},{"lineBreak":true},{"text":"他的根源从亘古，从太初就有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和华必将以色列人交付敌人，","poem":1},{"lineBreak":true},{"text":"直等那生产的妇人生下子来。","poem":1},{"lineBreak":true},{"text":"那时掌权者","poem":1},{"noteId":12},{"text":"其余的弟兄","poem":1},{"lineBreak":true},{"text":"必归到以色列人那里。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他必起来，倚靠耶和华的大能，","poem":1},{"lineBreak":true},{"text":"并耶和华—他 神之名的威严，","poem":1},{"lineBreak":true},{"text":"牧养他的羊群。","poem":1},{"lineBreak":true},{"text":"他们要安然居住；","poem":1},{"lineBreak":true},{"text":"因为他必日见尊大，直到地极。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"这位必作我们的平安。","poem":1},"解救和惩罚",{"text":"当亚述人进入我们的地境，","poem":1},{"lineBreak":true},{"text":"践踏宫殿的时候，","poem":1},{"lineBreak":true},{"text":"我们就立起七个牧者，","poem":1},{"lineBreak":true},{"text":"八个首领攻击他。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们必用刀剑毁坏亚述地","poem":1},{"lineBreak":true},{"text":"和宁录地的关口。","poem":1},{"lineBreak":true},{"text":"亚述人进入我们的地境践踏的时候，","poem":1},{"lineBreak":true},{"text":"他必拯救我们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"雅各余剩的人必在多国的民中，","poem":1},{"lineBreak":true},{"text":"如从耶和华那里降下的露水，","poem":1},{"lineBreak":true},{"text":"又如甘霖降在草上；","poem":1},{"lineBreak":true},{"text":"不仗赖人力，也不等候世人之功。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"雅各余剩的人必在多国多民中，","poem":1},{"lineBreak":true},{"text":"如林间百兽中的狮子，","poem":1},{"lineBreak":true},{"text":"又如少壮狮子在羊群中。","poem":1},{"lineBreak":true},{"text":"他若经过就必践踏撕裂，","poem":1},{"lineBreak":true},{"text":"无人搭救。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愿你的手举起，高过敌人！","poem":1},{"lineBreak":true},{"text":"愿你的仇敌都被剪除！","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和华说：到那日，","poem":1},{"lineBreak":true},{"text":"我必从你中间剪除马匹，","poem":1},{"lineBreak":true},{"text":"毁坏车辆，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"也必从你国中除灭城邑，","poem":1},{"lineBreak":true},{"text":"拆毁一切的保障，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"又必除掉你手中的邪术；","poem":1},{"lineBreak":true},{"text":"你那里也不再有占卜的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我必从你中间除灭雕刻的偶像和柱像，","poem":1},{"lineBreak":true},{"text":"你就不再跪拜自己手所造的。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我必从你中间拔出木偶，","poem":1},{"lineBreak":true},{"text":"又毁灭你的城邑。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我也必在怒气和忿怒中向那不听从的列国施报。","poem":1}]}],"footnotes":[{"noteId":11,"caller":"-","text":"原文是女子","reference":{"chapter":5,"verse":1}},{"noteId":12,"caller":"-","text":"原文是他","reference":{"chapter":5,"verse":3}}]},"thisChapterLink":"/api/cmn_cu1/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}