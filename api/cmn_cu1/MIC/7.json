{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cu1","name":"弥迦书","commonName":"弥迦书","title":"弥迦书","order":33,"numberOfChapters":7,"sha256":"5d5b897647548ba0f6a03c05fd8c35d9e107b33b299c49301880b3a83eca015c","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cu1/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["以色列人的腐败"]},{"type":"verse","number":1,"content":[{"text":"哀哉！我","poem":1},{"noteId":13},{"text":"好像夏天的果子已被收尽，","poem":1},{"lineBreak":true},{"text":"又像摘了葡萄所剩下的，","poem":1},{"lineBreak":true},{"text":"没有一挂可吃的；","poem":1},{"lineBreak":true},{"text":"我心羡慕初熟的无花果。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"地上虔诚人灭尽；","poem":1},{"lineBreak":true},{"text":"世间没有正直人；","poem":1},{"lineBreak":true},{"text":"各人埋伏，要杀人流血，","poem":1},{"lineBreak":true},{"text":"都用网罗猎取弟兄。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们双手作恶；","poem":1},{"lineBreak":true},{"text":"君王徇情面，审判官要贿赂；","poem":1},{"lineBreak":true},{"text":"位分大的吐出恶意，","poem":1},{"lineBreak":true},{"text":"都彼此结联行恶。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们最好的，不过是蒺藜；","poem":1},{"lineBreak":true},{"text":"最正直的，不过是荆棘篱笆。","poem":1},{"lineBreak":true},{"text":"你守望者说，降罚的日子已经来到。","poem":1},{"lineBreak":true},{"text":"他们必扰乱不安。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"不要倚赖邻舍；","poem":1},{"lineBreak":true},{"text":"不要信靠密友。","poem":1},{"lineBreak":true},{"text":"要守住你的口；","poem":1},{"lineBreak":true},{"text":"不要向你怀中的妻提说。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因为，儿子藐视父亲；","poem":1},{"lineBreak":true},{"text":"女儿抗拒母亲；","poem":1},{"lineBreak":true},{"text":"媳妇抗拒婆婆；","poem":1},{"lineBreak":true},{"text":"人的仇敌就是自己家里的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"至于我，我要仰望耶和华，","poem":1},{"lineBreak":true},{"text":"要等候那救我的 神；","poem":1},{"lineBreak":true},{"text":"我的 神必应允我。","poem":1}]},{"type":"heading","content":["耶和华拯救他的子民"]},{"type":"verse","number":8,"content":[{"text":"我的仇敌啊，不要向我夸耀。","poem":1},{"lineBreak":true},{"text":"我虽跌倒，却要起来；","poem":1},{"lineBreak":true},{"text":"我虽坐在黑暗里，","poem":1},{"lineBreak":true},{"text":"耶和华却作我的光。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我要忍受耶和华的恼怒；","poem":1},{"lineBreak":true},{"text":"因我得罪了他，","poem":1},{"lineBreak":true},{"text":"直等他为我辨屈，为我伸冤。","poem":1},{"lineBreak":true},{"text":"他必领我到光明中；","poem":1},{"lineBreak":true},{"text":"我必得见他的公义。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"那时我的仇敌，","poem":1},{"lineBreak":true},{"text":"就是曾对我说「耶和华—你 神在哪里」的，","poem":1},{"lineBreak":true},{"text":"他一看见这事就被羞愧遮盖。","poem":1},{"lineBreak":true},{"text":"我必亲眼见他遭报；","poem":1},{"lineBreak":true},{"text":"他必被践踏，如同街上的泥土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"以色列啊，日子必到，","poem":1},{"lineBreak":true},{"text":"你的墙垣必重修；","poem":1},{"lineBreak":true},{"text":"到那日，你的境界必开展","poem":1},{"noteId":14},{"text":"。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"当那日，人必从亚述，","poem":1},{"lineBreak":true},{"text":"从埃及的城邑，","poem":1},{"lineBreak":true},{"text":"从埃及到大河，","poem":1},{"lineBreak":true},{"text":"从这海到那海，","poem":1},{"lineBreak":true},{"text":"从这山到那山，","poem":1},{"lineBreak":true},{"text":"都归到你这里。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"然而，这地因居民的缘故，","poem":1},{"lineBreak":true},{"text":"又因他们行事的结果，必然荒凉。","poem":1}]},{"type":"heading","content":["耶和华怜悯以色列"]},{"type":"verse","number":14,"content":[{"text":"求耶和华在迦密山的树林中，","poem":1},{"lineBreak":true},{"text":"用你的杖牧放你独居的民，","poem":1},{"lineBreak":true},{"text":"就是你产业的羊群。","poem":1},{"lineBreak":true},{"text":"求你容他们在巴珊和基列得食物，像古时一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"耶和华说：","poem":1},{"lineBreak":true},{"text":"我要把奇事显给他们看，","poem":1},{"lineBreak":true},{"text":"好像出埃及地的时候一样。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"列国看见这事就必为自己的势力惭愧；","poem":1},{"lineBreak":true},{"text":"他们必用手捂口，掩耳不听。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他们必舔土如蛇，","poem":1},{"lineBreak":true},{"text":"又如土中腹行的物，","poem":1},{"lineBreak":true},{"text":"战战兢兢地出他们的营寨。","poem":1},{"lineBreak":true},{"text":"他们必战惧投降耶和华，","poem":1},{"lineBreak":true},{"text":"也必因我们的 神而惧怕。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"神啊，有何神像你，赦免罪孽，","poem":1},{"lineBreak":true},{"text":"饶恕你产业之余民的罪过，","poem":1},{"lineBreak":true},{"text":"不永远怀怒，喜爱施恩？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"必再怜悯我们，","poem":1},{"lineBreak":true},{"text":"将我们的罪孽踏在脚下，","poem":1},{"lineBreak":true},{"text":"又将我们的一切罪投于深海。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你必按古时起誓应许我们列祖的话，","poem":1},{"lineBreak":true},{"text":"向雅各发诚实，","poem":1},{"lineBreak":true},{"text":"向亚伯拉罕施慈爱。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"或译：以色列","reference":{"chapter":7,"verse":1}},{"noteId":14,"caller":"-","text":"或译：命令必传到远方","reference":{"chapter":7,"verse":11}}]},"thisChapterLink":"/api/cmn_cu1/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}