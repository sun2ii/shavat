{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"NAM","translationId":"cmn_cu1","name":"那鸿书","commonName":"那鸿书","title":"那鸿书","order":34,"numberOfChapters":3,"sha256":"20c85688d540f86fb7c7364b27f22e34b5fdd7c38d41e0f8bbbac59b855e10e8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cu1/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["论尼尼微的默示，就是伊勒歌斯人那鸿所得的默示。"]},{"type":"heading","content":["耶和华向尼尼微发怒"]},{"type":"verse","number":2,"content":[{"text":"耶和华是忌邪施报的 神。","poem":1},{"lineBreak":true},{"text":"耶和华施报大有忿怒；","poem":1},{"lineBreak":true},{"text":"向他的敌人施报，","poem":1},{"lineBreak":true},{"text":"向他的仇敌怀怒。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华不轻易发怒，大有能力，","poem":1},{"lineBreak":true},{"text":"万不以有罪的为无罪。","poem":1},{"lineBreak":true},{"text":"他乘旋风和暴风而来，","poem":1},{"lineBreak":true},{"text":"云彩为他脚下的尘土。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他斥责海，使海干了，","poem":1},{"lineBreak":true},{"text":"使一切江河干涸。","poem":1},{"lineBreak":true},{"text":"巴珊和迦密的树林衰残；","poem":1},{"lineBreak":true},{"text":"黎巴嫩的花草也衰残了。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"大山因他震动；","poem":1},{"lineBreak":true},{"text":"小山也都消化。","poem":1},{"lineBreak":true},{"text":"大地在他面前突起；","poem":1},{"lineBreak":true},{"text":"世界和住在其间的也都如此。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他发忿恨，谁能立得住呢？","poem":1},{"lineBreak":true},{"text":"他发烈怒，谁能当得起呢？","poem":1},{"lineBreak":true},{"text":"他的忿怒如火倾倒；","poem":1},{"lineBreak":true},{"text":"磐石因他崩裂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华本为善，","poem":1},{"lineBreak":true},{"text":"在患难的日子为人的保障，","poem":1},{"lineBreak":true},{"text":"并且认得那些投靠他的人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"但他必以涨溢的洪水淹没尼尼微，","poem":1},{"lineBreak":true},{"text":"又驱逐仇敌进入黑暗。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"尼尼微人哪，设何谋攻击耶和华呢？","poem":1},{"lineBreak":true},{"text":"他必将你们灭绝净尽；","poem":1},{"lineBreak":true},{"text":"灾难不再兴起。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你们像丛杂的荆棘，","poem":1},{"lineBreak":true},{"text":"像喝醉了的人，","poem":1},{"lineBreak":true},{"text":"又如枯干的碎秸全然烧灭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"有一人从你那里出来，","poem":1},{"lineBreak":true},{"text":"图谋邪恶，设恶计攻击耶和华。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华如此说：","poem":1},{"lineBreak":true},{"text":"尼尼微虽然势力充足，人数繁多，","poem":1},{"lineBreak":true},{"text":"也被剪除，归于无有。","poem":1},{"lineBreak":true},{"text":"犹大啊，我虽然使你受苦，","poem":1},{"lineBreak":true},{"text":"却不再使你受苦。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"现在我必从你颈项上折断他的轭，","poem":1},{"lineBreak":true},{"text":"扭开他的绳索。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华已经出令，指着尼尼微说：","poem":1},{"lineBreak":true},{"text":"你名下的人必不留后；","poem":1},{"lineBreak":true},{"text":"我必从你神的庙中除灭雕刻的偶像和铸造的偶像；","poem":1},{"lineBreak":true},{"text":"我必因你鄙陋，使你归于坟墓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"看哪，有报好信传平安之人的脚登山，说：","poem":1},{"lineBreak":true},{"text":"犹大啊，可以守你的节期，","poem":1},{"lineBreak":true},{"text":"还你所许的愿吧！","poem":1},{"lineBreak":true},{"text":"因为那恶人不再从你中间经过，","poem":1},{"lineBreak":true},{"text":"他已灭绝净尽了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}