{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"NAM","translationId":"cmn_cu1","name":"那鸿书","commonName":"那鸿书","title":"那鸿书","order":34,"numberOfChapters":3,"sha256":"20c85688d540f86fb7c7364b27f22e34b5fdd7c38d41e0f8bbbac59b855e10e8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cu1/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["尼尼微的倾覆"]},{"type":"verse","number":1,"content":[{"text":"尼尼微啊，那打碎邦国的上来攻击你。","poem":1},{"lineBreak":true},{"text":"你要看守保障，谨防道路，","poem":1},{"lineBreak":true},{"text":"使腰强壮，大大勉力。","poem":1},{"lineBreak":true},{"text":"（","poem":1}]},{"type":"verse","number":2,"content":[{"text":"耶和华复兴雅各的荣华，","poem":1},{"lineBreak":true},{"text":"好像以色列的荣华一样；","poem":1},{"lineBreak":true},{"text":"因为使地空虚的，","poem":1},{"lineBreak":true},{"text":"已经使雅各和以色列空虚，","poem":1},{"lineBreak":true},{"text":"将他们的葡萄枝毁坏了。）","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"他勇士的盾牌是红的，","poem":1},{"lineBreak":true},{"text":"精兵都穿朱红衣服。","poem":1},{"lineBreak":true},{"text":"在他预备争战的日子，","poem":1},{"lineBreak":true},{"text":"战车上的钢铁闪烁如火，","poem":1},{"lineBreak":true},{"text":"柏木把的枪也抡起来了。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"车辆在街上","poem":1},{"noteId":0},{"text":"急行，","poem":1},{"lineBreak":true},{"text":"在宽阔处奔来奔去，","poem":1},{"lineBreak":true},{"text":"形状如火把，","poem":1},{"lineBreak":true},{"text":"飞跑如闪电。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"尼尼微王招聚他的贵胄；","poem":1},{"lineBreak":true},{"text":"他们步行绊跌，","poem":1},{"lineBreak":true},{"text":"速上城墙，预备挡牌。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"河闸开放，宫殿冲没。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"王后蒙羞，被人掳去；","poem":1},{"lineBreak":true},{"text":"宫女捶胸，哀鸣如鸽。","poem":1},{"lineBreak":true},{"text":"此乃命定之事。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"尼尼微自古以来充满人民，","poem":1},{"lineBreak":true},{"text":"如同聚水的池子；","poem":1},{"lineBreak":true},{"text":"现在居民却都逃跑。","poem":1},{"lineBreak":true},{"text":"虽有人呼喊说：站住！站住！","poem":1},{"lineBreak":true},{"text":"却无人回顾。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你们抢掠金银吧！","poem":1},{"lineBreak":true},{"text":"因为所积蓄的无穷，","poem":1},{"lineBreak":true},{"text":"华美的宝器无数。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"尼尼微现在空虚荒凉，","poem":1},{"lineBreak":true},{"text":"人心消化，双膝相碰，","poem":1},{"lineBreak":true},{"text":"腰都疼痛，脸都变色。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"狮子的洞和少壮狮子喂养之处在哪里呢？","poem":1},{"lineBreak":true},{"text":"公狮母狮小狮游行、无人惊吓之地在哪里呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"公狮为小狮撕碎许多食物，","poem":1},{"lineBreak":true},{"text":"为母狮掐死活物，","poem":1},{"lineBreak":true},{"text":"把撕碎的、掐死的充满它的洞穴。","poem":1}]},{"type":"verse","number":13,"content":["万军之耶和华说：「我与你为敌，必将你的车辆焚烧成烟，刀剑也必吞灭你的少壮狮子。我必从地上除灭你所撕碎的，你使者的声音必不再听见。」"]}],"footnotes":[{"noteId":0,"caller":"-","text":"或译：城外","reference":{"chapter":2,"verse":4}}]},"thisChapterLink":"/api/cmn_cu1/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}