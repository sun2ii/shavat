{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"NAM","translationId":"cmn_cu1","name":"那鸿书","commonName":"那鸿书","title":"那鸿书","order":34,"numberOfChapters":3,"sha256":"20c85688d540f86fb7c7364b27f22e34b5fdd7c38d41e0f8bbbac59b855e10e8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cu1/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"祸哉！这流人血的城，","poem":1},{"lineBreak":true},{"text":"充满谎诈和强暴—","poem":1},{"lineBreak":true},{"text":"抢夺的事总不止息。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"鞭声响亮，车轮轰轰，","poem":1},{"lineBreak":true},{"text":"马匹踢跳，车辆奔腾，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"马兵争先，刀剑发光，","poem":1},{"lineBreak":true},{"text":"枪矛闪烁，被杀的甚多，","poem":1},{"lineBreak":true},{"text":"尸首成了大堆，","poem":1},{"lineBreak":true},{"text":"尸骸无数，人碰着而跌倒，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"都因那美貌的妓女多有淫行，","poem":1},{"lineBreak":true},{"text":"惯行邪术，借淫行诱惑列国，","poem":1},{"lineBreak":true},{"text":"用邪术诱惑","poem":1},{"noteId":1},{"text":"多族。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"万军之耶和华说：我与你为敌；","poem":1},{"lineBreak":true},{"text":"我必揭起你的衣襟，蒙在你脸上，","poem":1},{"lineBreak":true},{"text":"使列国看见你的赤体，","poem":1},{"lineBreak":true},{"text":"使列邦观看你的丑陋。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我必将可憎污秽之物抛在你身上，","poem":1},{"lineBreak":true},{"text":"辱没你，为众目所观。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"凡看见你的，都必逃跑离开你，","poem":1},{"lineBreak":true},{"text":"说：尼尼微荒凉了！有谁为你悲伤呢？","poem":1},{"lineBreak":true},{"text":"我何处寻得安慰你的人呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你岂比挪亚们强呢？","poem":1},{"lineBreak":true},{"text":"挪亚们坐落在众河之间，周围有水；","poem":1},{"lineBreak":true},{"text":"海","poem":1},{"noteId":2},{"text":"作她的濠沟，","poem":1},{"lineBreak":true},{"text":"又作她的城墙。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"古实和埃及是她无穷的力量；","poem":1},{"lineBreak":true},{"text":"弗人和路比族是她的帮手。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"但她被迁移，被掳去；","poem":1},{"lineBreak":true},{"text":"她的婴孩在各市口上也被摔死。","poem":1},{"lineBreak":true},{"text":"人为她的尊贵人拈阄；","poem":1},{"lineBreak":true},{"text":"她所有的大人都被链子锁着。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你也必喝醉，必被埋藏，","poem":1},{"lineBreak":true},{"text":"并因仇敌的缘故寻求避难所。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你一切保障必像无花果树上初熟的无花果，","poem":1},{"lineBreak":true},{"text":"若一摇撼就落在想吃之人的口中。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你地上的人民如同妇女；","poem":1},{"lineBreak":true},{"text":"你国中的关口向仇敌敞开；","poem":1},{"lineBreak":true},{"text":"你的门闩被火焚烧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"你要打水预备受困；","poem":1},{"lineBreak":true},{"text":"要坚固你的保障，","poem":1},{"lineBreak":true},{"text":"踹土和泥，修补砖窑。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"在那里，火必烧灭你；","poem":1},{"lineBreak":true},{"text":"刀必杀戮你，","poem":1},{"lineBreak":true},{"text":"吞灭你如同蝻子。","poem":1},{"lineBreak":true},{"text":"任你加增人数多如蝻子，","poem":1},{"lineBreak":true},{"text":"多如蝗虫吧！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你增添商贾，多过天上的星；","poem":1},{"lineBreak":true},{"text":"蝻子吃尽而去。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你的首领多如蝗虫；","poem":1},{"lineBreak":true},{"text":"你的军长仿佛成群的蚂蚱，","poem":1},{"lineBreak":true},{"text":"天凉的时候齐落在篱笆上，","poem":1},{"lineBreak":true},{"text":"日头一出便都飞去，","poem":1},{"lineBreak":true},{"text":"人不知道落在何处。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"亚述王啊，你的牧人睡觉；","poem":1},{"lineBreak":true},{"text":"你的贵胄安歇；","poem":1},{"lineBreak":true},{"text":"你的人民散在山间，无人招聚。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你的损伤无法医治；","poem":1},{"lineBreak":true},{"text":"你的伤痕极其重大。","poem":1},{"lineBreak":true},{"text":"凡听你信息的必都因此向你拍掌。","poem":1},{"lineBreak":true},{"text":"你所行的恶谁没有时常遭遇呢？","poem":1}]}],"footnotes":[{"noteId":1,"caller":"-","text":"原文是卖","reference":{"chapter":3,"verse":4}},{"noteId":2,"caller":"-","text":"指尼罗河","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/cmn_cu1/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}