{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"NEH","translationId":"cmn_cu1","name":"尼希米记","commonName":"尼希米记","title":"尼希米记","order":16,"numberOfChapters":13,"sha256":"df2302cd95811b185c2d5ceed29a0e326db0fe88bea139e34d3089f62ac641f2","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/cmn_cu1/NEH/13.json","totalNumberOfVerses":405},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["城墙修完，我安了门扇，守门的、歌唱的，和利未人都已派定。"]},{"type":"verse","number":2,"content":["我就派我的弟兄哈拿尼和营楼的宰官哈拿尼雅管理耶路撒冷；因为哈拿尼雅是忠信的，又敬畏 神过于众人。"]},{"type":"verse","number":3,"content":["我吩咐他们说：「等到太阳上升才可开耶路撒冷的城门；人尚看守的时候就要关门上闩；也当派耶路撒冷的居民各按班次看守自己房屋对面之处。」"]},{"type":"heading","content":["被掳归回者的名单"]},{"type":"verse","number":4,"content":["城是广大，其中的民却稀少，房屋还没有建造。"]},{"type":"verse","number":5,"content":["我的 神感动我心，招聚贵胄、官长，和百姓，要照家谱计算。我找着第一次上来之人的家谱，其上写着："]},{"type":"verse","number":6,"content":["巴比伦王尼布甲尼撒从前掳去犹大省的人，现在他们的子孙从被掳到之地回耶路撒冷和犹大，各归本城。"]},{"type":"verse","number":7,"content":["他们是同着所罗巴伯、耶书亚、尼希米、亚撒利雅、拉米、拿哈玛尼、末底改、必珊、米斯毗列、比革瓦伊、尼宏、巴拿回来的。"]},{"type":"verse","number":8,"content":["以色列人民的数目记在下面：巴录的子孙二千一百七十二名；"]},{"type":"verse","number":9,"content":["示法提雅的子孙三百七十二名；"]},{"type":"verse","number":10,"content":["亚拉的子孙六百五十二名；"]},{"type":"verse","number":11,"content":["巴哈·摩押的后裔，就是耶书亚和约押的子孙二千八百一十八名；"]},{"type":"verse","number":12,"content":["以拦的子孙一千二百五十四名；"]},{"type":"verse","number":13,"content":["萨土的子孙八百四十五名；"]},{"type":"verse","number":14,"content":["萨改的子孙七百六十名；"]},{"type":"verse","number":15,"content":["宾内的子孙六百四十八名；"]},{"type":"verse","number":16,"content":["比拜的子孙六百二十八名；"]},{"type":"verse","number":17,"content":["押甲的子孙二千三百二十二名；"]},{"type":"verse","number":18,"content":["亚多尼干的子孙六百六十七名；"]},{"type":"verse","number":19,"content":["比革瓦伊的子孙二千零六十七名；"]},{"type":"verse","number":20,"content":["亚丁的子孙六百五十五名；"]},{"type":"verse","number":21,"content":["亚特的后裔，就是希西家的子孙九十八名；"]},{"type":"verse","number":22,"content":["哈顺的子孙三百二十八名；"]},{"type":"verse","number":23,"content":["比赛的子孙三百二十四名；"]},{"type":"verse","number":24,"content":["哈拉的子孙一百一十二名；"]},{"type":"verse","number":25,"content":["基遍人九十五名；"]},{"type":"verse","number":26,"content":["伯利恒人和尼陀法人共一百八十八名；"]},{"type":"verse","number":27,"content":["亚拿突人一百二十八名；"]},{"type":"verse","number":28,"content":["伯·亚斯玛弗人四十二名；"]},{"type":"verse","number":29,"content":["基列·耶琳人、基非拉人、比录人共七百四十三名；"]},{"type":"verse","number":30,"content":["拉玛人和迦巴人共六百二十一名；"]},{"type":"verse","number":31,"content":["默玛人一百二十二名；"]},{"type":"verse","number":32,"content":["伯特利人和艾人共一百二十三名；"]},{"type":"verse","number":33,"content":["别的尼波人五十二名；"]},{"type":"verse","number":34,"content":["别的以拦子孙一千二百五十四名；"]},{"type":"verse","number":35,"content":["哈琳的子孙三百二十名；"]},{"type":"verse","number":36,"content":["耶利哥人三百四十五名；"]},{"type":"verse","number":37,"content":["罗德人、哈第人、阿挪人共七百二十一名；"]},{"type":"verse","number":38,"content":["西拿人三千九百三十名。"]},{"type":"verse","number":39,"content":["祭司：耶书亚家，耶大雅的子孙九百七十三名；"]},{"type":"verse","number":40,"content":["音麦的子孙一千零五十二名；"]},{"type":"verse","number":41,"content":["巴施户珥的子孙一千二百四十七名；"]},{"type":"verse","number":42,"content":["哈琳的子孙一千零一十七名。"]},{"type":"verse","number":43,"content":["利未人：何达威的后裔，就是耶书亚和甲篾的子孙七十四名。"]},{"type":"verse","number":44,"content":["歌唱的：亚萨的子孙一百四十八名。"]},{"type":"verse","number":45,"content":["守门的：沙龙的子孙、亚特的子孙、达们的子孙、亚谷的子孙、哈底大的子孙、朔拜的子孙，共一百三十八名。"]},{"type":"verse","number":46,"content":["尼提宁",{"noteId":4},"：西哈的子孙、哈苏巴的子孙、答巴俄的子孙、"]},{"type":"verse","number":47,"content":["基绿的子孙、西亚的子孙、巴顿的子孙、"]},{"type":"verse","number":48,"content":["利巴拿的子孙、哈迦巴的子孙、萨买的子孙、"]},{"type":"verse","number":49,"content":["哈难的子孙、吉德的子孙、迦哈的子孙、"]},{"type":"verse","number":50,"content":["利亚雅的子孙、利汛的子孙、尼哥大的子孙、"]},{"type":"verse","number":51,"content":["迦散的子孙、乌撒的子孙、巴西亚的子孙、"]},{"type":"verse","number":52,"content":["比赛的子孙、米乌宁的子孙、尼普心的子孙、"]},{"type":"verse","number":53,"content":["巴卜的子孙、哈古巴的子孙、哈忽的子孙、"]},{"type":"verse","number":54,"content":["巴洗律的子孙、米希大的子孙、哈沙的子孙、"]},{"type":"verse","number":55,"content":["巴柯的子孙、西西拉的子孙、答玛的子孙、"]},{"type":"verse","number":56,"content":["尼细亚的子孙、哈提法的子孙。"]},{"type":"verse","number":57,"content":["所罗门仆人的后裔，就是琐太的子孙、琐斐列的子孙、比路大的子孙、"]},{"type":"verse","number":58,"content":["雅拉的子孙、达昆的子孙、吉德的子孙、"]},{"type":"verse","number":59,"content":["示法提雅的子孙、哈替的子孙、玻黑列·哈斯巴音的子孙、亚们的子孙。"]},{"type":"verse","number":60,"content":["尼提宁和所罗门仆人的后裔共三百九十二名。"]},{"type":"verse","number":61,"content":["从特米拉、特哈萨、基绿、亚顿、音麦上来的，不能指明他们的宗族谱系是以色列人不是；"]},{"type":"verse","number":62,"content":["他们是第莱雅的子孙、多比雅的子孙、尼哥大的子孙，共六百四十二名。"]},{"type":"verse","number":63,"content":["祭司中，哈巴雅的子孙、哈哥斯的子孙、巴西莱的子孙；因为他们的先祖娶了基列人巴西莱的女儿为妻，所以起名叫巴西莱。"]},{"type":"verse","number":64,"content":["这三家的人在族谱之中寻查自己的谱系，却寻不着，因此算为不洁，不准供祭司的职任。"]},{"type":"verse","number":65,"content":["省长对他们说：「不可吃至圣的物，直到有用乌陵和土明决疑的祭司兴起来。」"]},{"type":"verse","number":66,"content":["会众共有四万二千三百六十名。"]},{"type":"verse","number":67,"content":["此外，还有他们的仆婢七千三百三十七名，又有歌唱的男女二百四十五名。"]},{"type":"verse","number":68,"content":["他们有马七百三十六匹，骡子二百四十五匹，"]},{"type":"verse","number":69,"content":["骆驼四百三十五只，驴六千七百二十匹。"]},{"type":"verse","number":70,"content":["有些族长为工程捐助。省长捐入库中的金子一千达利克，碗五十个，祭司的礼服五百三十件。"]},{"type":"verse","number":71,"content":["又有族长捐入工程库的金子二万达利克，银子二千二百弥拿。"]},{"type":"verse","number":72,"content":["其余百姓所捐的金子二万达利克，银子二千弥拿，祭司的礼服六十七件。"]},{"type":"verse","number":73,"content":["于是祭司、利未人、守门的、歌唱的、民中的一些人、尼提宁，并以色列众人，各住在自己的城里。"]}],"footnotes":[{"noteId":4,"caller":"-","text":"就是殿役","reference":{"chapter":7,"verse":46}}]}