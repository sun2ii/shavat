{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"OBA","translationId":"cmn_cu1","name":"俄巴底亚书","commonName":"俄巴底亚书","title":"俄巴底亚书","order":31,"numberOfChapters":1,"sha256":"699f047e4f85cf153df2a4c5be844e6b9e384eb8c888d89a23cfe67bc6fe19bf","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/cmn_cu1/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"俄巴底亚得了耶和华的默示。","poem":1},"耶和华要惩罚以东",{"text":"论以东说：","poem":1},{"lineBreak":true},{"text":"我从耶和华那里听见信息，","poem":1},{"lineBreak":true},{"text":"并有使者被差往列国去，","poem":1},{"lineBreak":true},{"text":"说：起来吧，","poem":1},{"lineBreak":true},{"text":"一同起来与以东争战！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我使你—以东在列国中为最小的，","poem":1},{"lineBreak":true},{"text":"被人大大藐视。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"住在山穴中、居所在高处的啊，","poem":1},{"lineBreak":true},{"text":"你因狂傲自欺，","poem":1},{"lineBreak":true},{"text":"心里说：谁能将我拉下地去呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你虽如大鹰高飞，","poem":1},{"lineBreak":true},{"text":"在星宿之间搭窝，","poem":1},{"lineBreak":true},{"text":"我必从那里拉下你来。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"盗贼若来在你那里，","poem":1},{"lineBreak":true},{"text":"或强盗夜间而来—","poem":1},{"lineBreak":true},{"text":"你何竟被剪除—","poem":1},{"lineBreak":true},{"text":"岂不偷窃直到够了呢？","poem":1},{"lineBreak":true},{"text":"摘葡萄的若来到你那里，","poem":1},{"lineBreak":true},{"text":"岂不剩下些葡萄呢？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"以扫的隐密处何竟被搜寻？","poem":1},{"lineBreak":true},{"text":"他隐藏的宝物何竟被查出？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"与你结盟的都送你上路，直到交界；","poem":1},{"lineBreak":true},{"text":"与你和好的欺骗你，且胜过你；","poem":1},{"lineBreak":true},{"text":"与你一同吃饭的设下网罗陷害你；","poem":1},{"lineBreak":true},{"text":"在你心里毫无聪明。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华说：到那日，","poem":1},{"lineBreak":true},{"text":"我岂不从以东除灭智慧人？","poem":1},{"lineBreak":true},{"text":"从以扫山除灭聪明人？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"提幔哪，","poem":1},{"lineBreak":true},{"text":"你的勇士必惊惶，","poem":1},{"lineBreak":true},{"text":"甚至以扫山的人都被杀戮剪除。","poem":1}]},{"type":"heading","content":["以东受罚的原因"]},{"type":"verse","number":10,"content":[{"text":"因你向兄弟雅各行强暴，","poem":1},{"lineBreak":true},{"text":"羞愧必遮盖你，","poem":1},{"lineBreak":true},{"text":"你也必永远断绝。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"当外人掳掠雅各的财物，","poem":1},{"lineBreak":true},{"text":"外邦人进入他的城门，","poem":1},{"lineBreak":true},{"text":"为耶路撒冷拈阄的日子，","poem":1},{"lineBreak":true},{"text":"你竟站在一旁，像与他们同伙。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你兄弟遭难的日子，","poem":1},{"lineBreak":true},{"text":"你不当瞪眼看着；","poem":1},{"lineBreak":true},{"text":"犹大人被灭的日子，","poem":1},{"lineBreak":true},{"text":"你不当因此欢乐；","poem":1},{"lineBreak":true},{"text":"他们遭难的日子，","poem":1},{"lineBreak":true},{"text":"你不当说狂傲的话。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我民遭灾的日子，","poem":1},{"lineBreak":true},{"text":"你不当进他们的城门；","poem":1},{"lineBreak":true},{"text":"他们遭灾的日子，","poem":1},{"lineBreak":true},{"text":"你不当瞪眼看着他们受苦；","poem":1},{"lineBreak":true},{"text":"他们遭灾的日子，","poem":1},{"lineBreak":true},{"text":"你不当伸手抢他们的财物；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你不当站在岔路口剪除他们中间逃脱的；","poem":1},{"lineBreak":true},{"text":"他们遭难的日子，","poem":1},{"lineBreak":true},{"text":"你不当将他们剩下的人交付仇敌。","poem":1}]},{"type":"heading","content":["神要审判万国"]},{"type":"verse","number":15,"content":[{"text":"耶和华降罚的日子临近万国。","poem":1},{"lineBreak":true},{"text":"你怎样行，他也必照样向你行；","poem":1},{"lineBreak":true},{"text":"你的报应必归到你头上。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你们犹大人在我圣山怎样喝了苦杯，","poem":1},{"lineBreak":true},{"text":"万国也必照样常常地喝；","poem":1},{"lineBreak":true},{"text":"且喝且咽，他们就归于无有。","poem":1}]},{"type":"heading","content":["以色列的胜利"]},{"type":"verse","number":17,"content":[{"text":"在锡安山必有逃脱的人，","poem":1},{"lineBreak":true},{"text":"那山也必成圣；","poem":1},{"lineBreak":true},{"text":"雅各家必得原有的产业。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"雅各家必成为大火；","poem":1},{"lineBreak":true},{"text":"约瑟家必为火焰；","poem":1},{"lineBreak":true},{"text":"以扫家必如碎秸；","poem":1},{"lineBreak":true},{"text":"火必将他烧着吞灭。","poem":1},{"lineBreak":true},{"text":"以扫家必无余剩的。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"南地的人必得以扫山；","poem":1},{"lineBreak":true},{"text":"高原的人必得非利士地，","poem":1},{"lineBreak":true},{"text":"也得以法莲地和撒马利亚地；","poem":1},{"lineBreak":true},{"text":"便雅悯人必得基列。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"在迦南人中被掳的以色列众人","poem":1},{"lineBreak":true},{"text":"必得地直到撒勒法；","poem":1},{"lineBreak":true},{"text":"在西法拉中被掳的耶路撒冷人","poem":1},{"lineBreak":true},{"text":"必得南地的城邑。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"必有拯救者上到锡安山，审判以扫山；","poem":1},{"lineBreak":true},{"text":"国度就归耶和华了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}