{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":1,"content":[{"type":"heading","content":["箴言的价值"]},{"type":"verse","number":1,"content":[{"text":"以色列王大卫儿子所罗门的箴言：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要使人晓得智慧和训诲，","poem":1},{"lineBreak":true},{"text":"分辨通达的言语，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"使人处事领受智慧、","poem":1},{"lineBreak":true},{"text":"仁义、公平、正直的训诲，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"使愚人灵明，","poem":1},{"lineBreak":true},{"text":"使少年人有知识和谋略，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"使智慧人听见，增长学问，","poem":1},{"lineBreak":true},{"text":"使聪明人得着智谋，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"使人明白箴言和譬喻，","poem":1},{"lineBreak":true},{"text":"懂得智慧人的言词和谜语。","poem":1}]},{"type":"heading","content":["给年青人的忠告"]},{"type":"verse","number":7,"content":[{"text":"敬畏耶和华是知识的开端；","poem":1},{"lineBreak":true},{"text":"愚妄人藐视智慧和训诲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我儿，要听你父亲的训诲，","poem":1},{"lineBreak":true},{"text":"不可离弃你母亲的法则","poem":1},{"noteId":0},{"text":"；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为这要作你头上的华冠，","poem":1},{"lineBreak":true},{"text":"你项上的金链。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"我儿，恶人若引诱你，","poem":1},{"lineBreak":true},{"text":"你不可随从。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们若说：你与我们同去，","poem":1},{"lineBreak":true},{"text":"我们要埋伏流人之血，","poem":1},{"lineBreak":true},{"text":"要蹲伏害无罪之人；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我们好像阴间，把他们活活吞下；","poem":1},{"lineBreak":true},{"text":"他们如同下坑的人，","poem":1},{"lineBreak":true},{"text":"被我们囫囵吞了；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我们必得各样宝物，","poem":1},{"lineBreak":true},{"text":"将所掳来的，装满房屋；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你与我们大家同分，","poem":1},{"lineBreak":true},{"text":"我们共用一个囊袋；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我儿，不要与他们同行一道，","poem":1},{"lineBreak":true},{"text":"禁止你脚走他们的路。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因为，他们的脚奔跑行恶；","poem":1},{"lineBreak":true},{"text":"他们急速流人的血，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"好像飞鸟，","poem":1},{"lineBreak":true},{"text":"网罗设在眼前仍不躲避。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"这些人埋伏，是为自流己血；","poem":1},{"lineBreak":true},{"text":"蹲伏，是为自害己命。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"凡贪恋财利的，所行之路都是如此；","poem":1},{"lineBreak":true},{"text":"这贪恋之心乃夺去得财者之命。","poem":1}]},{"type":"heading","content":["智慧呼唤人"]},{"type":"verse","number":20,"content":[{"text":"智慧在街市上呼喊，","poem":1},{"lineBreak":true},{"text":"在宽阔处发声，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"在热闹街头喊叫，","poem":1},{"lineBreak":true},{"text":"在城门口，在城中发出言语，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"说：你们愚昧人喜爱愚昧，","poem":1},{"lineBreak":true},{"text":"亵慢人喜欢亵慢，","poem":1},{"lineBreak":true},{"text":"愚顽人恨恶知识，要到几时呢？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你们当因我的责备回转；","poem":1},{"lineBreak":true},{"text":"我要将我的灵浇灌你们，","poem":1},{"lineBreak":true},{"text":"将我的话指示你们。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我呼唤，你们不肯听从；","poem":1},{"lineBreak":true},{"text":"我伸手，无人理会；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"反轻弃我一切的劝戒，","poem":1},{"lineBreak":true},{"text":"不肯受我的责备。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你们遭灾难，我就发笑；","poem":1},{"lineBreak":true},{"text":"惊恐临到你们，我必嗤笑。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"惊恐临到你们，好像狂风；","poem":1},{"lineBreak":true},{"text":"灾难来到，如同暴风；","poem":1},{"lineBreak":true},{"text":"急难痛苦临到你们身上。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"那时，你们必呼求我，我却不答应，","poem":1},{"lineBreak":true},{"text":"恳切地寻找我，却寻不见。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"因为，你们恨恶知识，","poem":1},{"lineBreak":true},{"text":"不喜爱敬畏耶和华，","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"不听我的劝戒，","poem":1},{"lineBreak":true},{"text":"藐视我一切的责备，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"所以必吃自结的果子，","poem":1},{"lineBreak":true},{"text":"充满自设的计谋。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"愚昧人背道，必杀己身；","poem":1},{"lineBreak":true},{"text":"愚顽人安逸，必害己命。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"惟有听从我的，必安然居住，","poem":1},{"lineBreak":true},{"text":"得享安静，不怕灾祸。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"或译：指教","reference":{"chapter":1,"verse":8}}]},"thisChapterLink":"/api/cmn_cu1/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}