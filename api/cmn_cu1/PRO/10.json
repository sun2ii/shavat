{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":10,"content":[{"type":"heading","content":["所罗门的箴言"]},{"type":"verse","number":1,"content":[{"text":"所罗门的箴言：","poem":1},{"lineBreak":true},{"text":"智慧之子使父亲欢乐；","poem":1},{"lineBreak":true},{"text":"愚昧之子叫母亲担忧。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"不义之财毫无益处；","poem":1},{"lineBreak":true},{"text":"惟有公义能救人脱离死亡。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华不使义人受饥饿；","poem":1},{"lineBreak":true},{"text":"恶人所欲的，他必推开。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"手懒的，要受贫穷；","poem":1},{"lineBreak":true},{"text":"手勤的，却要富足。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"夏天聚敛的，是智慧之子；","poem":1},{"lineBreak":true},{"text":"收割时沉睡的，是贻羞之子。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"福祉临到义人的头；","poem":1},{"lineBreak":true},{"text":"强暴蒙蔽恶人的口。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"义人的纪念被称赞；","poem":1},{"lineBreak":true},{"text":"恶人的名字必朽烂。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"心中智慧的，必受命令；","poem":1},{"lineBreak":true},{"text":"口里愚妄的，必致倾倒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"行正直路的，步步安稳；","poem":1},{"lineBreak":true},{"text":"走弯曲道的，必致败露。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"以眼传神的，使人忧患；","poem":1},{"lineBreak":true},{"text":"口里愚妄的，必致倾倒。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"义人的口是生命的泉源；","poem":1},{"lineBreak":true},{"text":"强暴蒙蔽恶人的口。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"恨能挑启争端；","poem":1},{"lineBreak":true},{"text":"爱能遮掩一切过错。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"明哲人嘴里有智慧；","poem":1},{"lineBreak":true},{"text":"无知人背上受刑杖。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"智慧人积存知识；","poem":1},{"lineBreak":true},{"text":"愚妄人的口速致败坏。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"富户的财物是他的坚城；","poem":1},{"lineBreak":true},{"text":"穷人的贫乏是他的败坏。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"义人的勤劳致生；","poem":1},{"lineBreak":true},{"text":"恶人的进项致死","poem":1},{"noteId":13},{"text":"。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"谨守训诲的，乃在生命的道上；","poem":1},{"lineBreak":true},{"text":"违弃责备的，便失迷了路。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"隐藏怨恨的，有说谎的嘴；","poem":1},{"lineBreak":true},{"text":"口出谗谤的，是愚妄的人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"多言多语难免有过；","poem":1},{"lineBreak":true},{"text":"禁止嘴唇是有智慧。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"义人的舌乃似高银；","poem":1},{"lineBreak":true},{"text":"恶人的心所值无几。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"义人的口教养多人；","poem":1},{"lineBreak":true},{"text":"愚昧人因无知而死亡。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和华所赐的福使人富足，","poem":1},{"lineBreak":true},{"text":"并不加上忧虑。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"愚妄人以行恶为戏耍；","poem":1},{"lineBreak":true},{"text":"明哲人却以智慧为乐。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"恶人所怕的，必临到他；","poem":1},{"lineBreak":true},{"text":"义人所愿的，必蒙应允。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"暴风一过，恶人归于无有；","poem":1},{"lineBreak":true},{"text":"义人的根基却是永久。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"懒惰人叫差他的人","poem":1},{"lineBreak":true},{"text":"如醋倒牙，如烟薰目。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"敬畏耶和华使人日子加多；","poem":1},{"lineBreak":true},{"text":"但恶人的年岁必被减少。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"义人的盼望必得喜乐；","poem":1},{"lineBreak":true},{"text":"恶人的指望必致灭没。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"耶和华的道是正直人的保障，","poem":1},{"lineBreak":true},{"text":"却成了作孽人的败坏。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"义人永不挪移；","poem":1},{"lineBreak":true},{"text":"恶人不得住在地上。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"义人的口滋生智慧；","poem":1},{"lineBreak":true},{"text":"乖谬的舌必被割断。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"义人的嘴能令人喜悦；","poem":1},{"lineBreak":true},{"text":"恶人的口说乖谬的话。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"死：原文是罪","reference":{"chapter":10,"verse":16}}]},"thisChapterLink":"/api/cmn_cu1/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}