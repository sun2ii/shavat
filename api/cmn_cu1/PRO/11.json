{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"诡诈的天平为耶和华所憎恶；","poem":1},{"lineBreak":true},{"text":"公平的法码为他所喜悦。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"骄傲来，羞耻也来；","poem":1},{"lineBreak":true},{"text":"谦逊人却有智慧。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"正直人的纯正必引导自己；","poem":1},{"lineBreak":true},{"text":"奸诈人的乖僻必毁灭自己。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"发怒的日子资财无益；","poem":1},{"lineBreak":true},{"text":"惟有公义能救人脱离死亡。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"完全人的义必指引他的路；","poem":1},{"lineBreak":true},{"text":"但恶人必因自己的恶跌倒。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"正直人的义必拯救自己；","poem":1},{"lineBreak":true},{"text":"奸诈人必陷在自己的罪孽中。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"恶人一死，他的指望必灭绝；","poem":1},{"lineBreak":true},{"text":"罪人的盼望也必灭没。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"义人得脱离患难，","poem":1},{"lineBreak":true},{"text":"有恶人来代替他。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"不虔敬的人用口败坏邻舍；","poem":1},{"lineBreak":true},{"text":"义人却因知识得救。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"义人享福，合城喜乐；","poem":1},{"lineBreak":true},{"text":"恶人灭亡，人都欢呼。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"城因正直人祝福便高举，","poem":1},{"lineBreak":true},{"text":"却因邪恶人的口就倾覆。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"藐视邻舍的，毫无智慧；","poem":1},{"lineBreak":true},{"text":"明哲人却静默不言。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"往来传舌的，泄漏密事；","poem":1},{"lineBreak":true},{"text":"心中诚实的，遮隐事情。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"无智谋，民就败落；","poem":1},{"lineBreak":true},{"text":"谋士多，人便安居。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"为外人作保的，必受亏损；","poem":1},{"lineBreak":true},{"text":"恨恶击掌的，却得安稳。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"恩德的妇女得尊荣；","poem":1},{"lineBreak":true},{"text":"强暴的男子得资财。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"仁慈的人善待自己；","poem":1},{"lineBreak":true},{"text":"残忍的人扰害己身。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"恶人经营，得虚浮的工价；","poem":1},{"lineBreak":true},{"text":"撒义种的，得实在的果效。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"恒心为义的，必得生命；","poem":1},{"lineBreak":true},{"text":"追求邪恶的，必致死亡。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"心中乖僻的，为耶和华所憎恶；","poem":1},{"lineBreak":true},{"text":"行事完全的，为他所喜悦。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"恶人虽然连手，必不免受罚；","poem":1},{"lineBreak":true},{"text":"义人的后裔必得拯救。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"妇女美貌而无见识，","poem":1},{"lineBreak":true},{"text":"如同金环带在猪鼻上。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"义人的心愿尽得好处；","poem":1},{"lineBreak":true},{"text":"恶人的指望致干忿怒。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"有施散的，却更增添；","poem":1},{"lineBreak":true},{"text":"有吝惜过度的，反致穷乏。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"好施舍的，必得丰裕；","poem":1},{"lineBreak":true},{"text":"滋润人的，必得滋润。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"屯粮不卖的，民必咒诅他；","poem":1},{"lineBreak":true},{"text":"情愿出卖的，人必为他祝福。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"恳切求善的，就求得恩惠；","poem":1},{"lineBreak":true},{"text":"惟独求恶的，恶必临到他身。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"倚仗自己财物的，必跌倒；","poem":1},{"lineBreak":true},{"text":"义人必发旺，如青叶。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"扰害己家的，必承受清风；","poem":1},{"lineBreak":true},{"text":"愚昧人必作慧心人的仆人。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"义人所结的果子就是生命树；","poem":1},{"lineBreak":true},{"text":"有智慧的，必能得人。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"看哪，义人在世尚且受报，","poem":1},{"lineBreak":true},{"text":"何况恶人和罪人呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}