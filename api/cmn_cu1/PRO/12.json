{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"喜爱管教的，就是喜爱知识；","poem":1},{"lineBreak":true},{"text":"恨恶责备的，却是畜类。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"善人必蒙耶和华的恩惠；","poem":1},{"lineBreak":true},{"text":"设诡计的人，耶和华必定他的罪。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人靠恶行不能坚立；","poem":1},{"lineBreak":true},{"text":"义人的根必不动摇。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"才德的妇人是丈夫的冠冕；","poem":1},{"lineBreak":true},{"text":"贻羞的妇人如同朽烂在她丈夫的骨中。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"义人的思念是公平；","poem":1},{"lineBreak":true},{"text":"恶人的计谋是诡诈。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"恶人的言论是埋伏流人的血；","poem":1},{"lineBreak":true},{"text":"正直人的口必拯救人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"恶人倾覆，归于无有；","poem":1},{"lineBreak":true},{"text":"义人的家必站得住。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"人必按自己的智慧被称赞；","poem":1},{"lineBreak":true},{"text":"心中乖谬的，必被藐视。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"被人轻贱，却有仆人，","poem":1},{"lineBreak":true},{"text":"强如自尊，缺少食物。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"义人顾惜他牲畜的命；","poem":1},{"lineBreak":true},{"text":"恶人的怜悯也是残忍。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耕种自己田地的，必得饱食；","poem":1},{"lineBreak":true},{"text":"追随虚浮的，却是无知。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"恶人想得坏人的网罗；","poem":1},{"lineBreak":true},{"text":"义人的根得以结实。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"恶人嘴中的过错是自己的网罗；","poem":1},{"lineBreak":true},{"text":"但义人必脱离患难。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人因口所结的果子，必饱得美福；","poem":1},{"lineBreak":true},{"text":"人手所做的，必为自己的报应。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愚妄人所行的，在自己眼中看为正直；","poem":1},{"lineBreak":true},{"text":"惟智慧人肯听人的劝教。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"愚妄人的恼怒立时显露；","poem":1},{"lineBreak":true},{"text":"通达人能忍辱藏羞。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"说出真话的，显明公义；","poem":1},{"lineBreak":true},{"text":"作假见证的，显出诡诈。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"说话浮躁的，如刀刺人；","poem":1},{"lineBreak":true},{"text":"智慧人的舌头却为医人的良药。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"口吐真言，永远坚立；","poem":1},{"lineBreak":true},{"text":"舌说谎话，只存片时。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"图谋恶事的，心存诡诈；","poem":1},{"lineBreak":true},{"text":"劝人和睦的，便得喜乐。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"义人不遭灾害；恶人满受祸患。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"说谎言的嘴为耶和华所憎恶；","poem":1},{"lineBreak":true},{"text":"行事诚实的，为他所喜悦。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"通达人隐藏知识；","poem":1},{"lineBreak":true},{"text":"愚昧人的心彰显愚昧。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"殷勤人的手必掌权；","poem":1},{"lineBreak":true},{"text":"懒惰的人必服苦。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"人心忧虑，屈而不伸；","poem":1},{"lineBreak":true},{"text":"一句良言，使心欢乐。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"义人引导他的邻舍；","poem":1},{"lineBreak":true},{"text":"恶人的道叫人失迷。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"懒惰的人不烤打猎所得的；","poem":1},{"lineBreak":true},{"text":"殷勤的人却得宝贵的财物。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"在公义的道上有生命；","poem":1},{"lineBreak":true},{"text":"其路之中并无死亡。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}