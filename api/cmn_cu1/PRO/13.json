{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"智慧子听父亲的教训；","poem":1},{"lineBreak":true},{"text":"亵慢人不听责备。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"人因口所结的果子，必享美福；","poem":1},{"lineBreak":true},{"text":"奸诈人必遭强暴。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"谨守口的，得保生命；","poem":1},{"lineBreak":true},{"text":"大张嘴的，必致败亡。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"懒惰人羡慕，却无所得；","poem":1},{"lineBreak":true},{"text":"殷勤人必得丰裕。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"义人恨恶谎言；","poem":1},{"lineBreak":true},{"text":"恶人有臭名，且致惭愧。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"行为正直的，有公义保守；","poem":1},{"lineBreak":true},{"text":"犯罪的，被邪恶倾覆。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"假作富足的，却一无所有；","poem":1},{"lineBreak":true},{"text":"装作穷乏的，却广有财物。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"人的资财是他生命的赎价；","poem":1},{"lineBreak":true},{"text":"穷乏人却听不见威吓的话。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"义人的光明亮","poem":1},{"noteId":14},{"text":"；","poem":1},{"lineBreak":true},{"text":"恶人的灯要熄灭。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"骄傲只启争竞；","poem":1},{"lineBreak":true},{"text":"听劝言的，却有智慧。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"不劳而得之财必然消耗；","poem":1},{"lineBreak":true},{"text":"勤劳积蓄的，必见加增。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"所盼望的迟延未得，令人心忧；","poem":1},{"lineBreak":true},{"text":"所愿意的临到，却是生命树。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"藐视训言的，自取灭亡；","poem":1},{"lineBreak":true},{"text":"敬畏诫命的，必得善报。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"智慧人的法则","poem":1},{"noteId":15},{"text":"是生命的泉源，","poem":1},{"lineBreak":true},{"text":"可以使人离开死亡的网罗。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"美好的聪明使人蒙恩；","poem":1},{"lineBreak":true},{"text":"奸诈人的道路崎岖难行。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"凡通达人都凭知识行事；","poem":1},{"lineBreak":true},{"text":"愚昧人张扬自己的愚昧。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"奸恶的使者必陷在祸患里；","poem":1},{"lineBreak":true},{"text":"忠信的使臣乃医人的良药。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"弃绝管教的，必致贫受辱；","poem":1},{"lineBreak":true},{"text":"领受责备的，必得尊荣。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"所欲的成就，心觉甘甜；","poem":1},{"lineBreak":true},{"text":"远离恶事，为愚昧人所憎恶。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"与智慧人同行的，必得智慧；","poem":1},{"lineBreak":true},{"text":"和愚昧人作伴的，必受亏损。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"祸患追赶罪人；","poem":1},{"lineBreak":true},{"text":"义人必得善报。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"善人给子孙遗留产业；","poem":1},{"lineBreak":true},{"text":"罪人为义人积存资财。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"穷人耕种多得粮食，","poem":1},{"lineBreak":true},{"text":"但因不义，有消灭的。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"不忍用杖打儿子的，是恨恶他；","poem":1},{"lineBreak":true},{"text":"疼爱儿子的，随时管教。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"义人吃得饱足；","poem":1},{"lineBreak":true},{"text":"恶人肚腹缺粮。","poem":1}]}],"footnotes":[{"noteId":14,"caller":"-","text":"原文是欢喜","reference":{"chapter":13,"verse":9}},{"noteId":15,"caller":"-","text":"或译：指教","reference":{"chapter":13,"verse":14}}]},"thisChapterLink":"/api/cmn_cu1/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}