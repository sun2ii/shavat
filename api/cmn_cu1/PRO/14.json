{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"智慧妇人建立家室；","poem":1},{"lineBreak":true},{"text":"愚妄妇人亲手拆毁。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"行动正直的，敬畏耶和华；","poem":1},{"lineBreak":true},{"text":"行事乖僻的，却藐视他。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愚妄人口中骄傲，如杖责打己身；","poem":1},{"lineBreak":true},{"text":"智慧人的嘴必保守自己。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"家里无牛，槽头干净；","poem":1},{"lineBreak":true},{"text":"土产加多乃凭牛力。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"诚实见证人不说谎话；","poem":1},{"lineBreak":true},{"text":"假见证人吐出谎言。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"亵慢人寻智慧，却寻不着；","poem":1},{"lineBreak":true},{"text":"聪明人易得知识。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"到愚昧人面前，","poem":1},{"lineBreak":true},{"text":"不见他嘴中有知识。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"通达人的智慧在乎明白己道；","poem":1},{"lineBreak":true},{"text":"愚昧人的愚妄乃是诡诈","poem":1},{"noteId":16},{"text":"。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愚妄人犯罪，以为戏耍","poem":1},{"noteId":17},{"text":"；","poem":1},{"lineBreak":true},{"text":"正直人互相喜悦。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"心中的苦楚，自己知道；","poem":1},{"lineBreak":true},{"text":"心里的喜乐，外人无干。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"奸恶人的房屋必倾倒；","poem":1},{"lineBreak":true},{"text":"正直人的帐棚必兴盛。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"有一条路，人以为正，","poem":1},{"lineBreak":true},{"text":"至终成为死亡之路。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"人在喜笑中，心也忧愁；","poem":1},{"lineBreak":true},{"text":"快乐至极就生愁苦。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"心中背道的，必满得自己的结果；","poem":1},{"lineBreak":true},{"text":"善人必从自己的行为得以知足。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愚蒙人是话都信；","poem":1},{"lineBreak":true},{"text":"通达人步步谨慎。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"智慧人惧怕，就远离恶事；","poem":1},{"lineBreak":true},{"text":"愚妄人却狂傲自恃。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"轻易发怒的，行事愚妄；","poem":1},{"lineBreak":true},{"text":"设立诡计的，被人恨恶。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"愚蒙人得愚昧为产业；","poem":1},{"lineBreak":true},{"text":"通达人得知识为冠冕。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"坏人俯伏在善人面前；","poem":1},{"lineBreak":true},{"text":"恶人俯伏在义人门口。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"贫穷人连邻舍也恨他；","poem":1},{"lineBreak":true},{"text":"富足人朋友最多。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"藐视邻舍的，这人有罪；","poem":1},{"lineBreak":true},{"text":"怜悯贫穷的，这人有福。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"谋恶的，岂非走入迷途吗？","poem":1},{"lineBreak":true},{"text":"谋善的，必得慈爱和诚实。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"诸般勤劳都有益处；","poem":1},{"lineBreak":true},{"text":"嘴上多言乃致穷乏。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"智慧人的财为自己的冠冕；","poem":1},{"lineBreak":true},{"text":"愚妄人的愚昧终是愚昧。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"作真见证的，救人性命；","poem":1},{"lineBreak":true},{"text":"吐出谎言的，施行诡诈。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"敬畏耶和华的，大有倚靠；","poem":1},{"lineBreak":true},{"text":"他的儿女也有避难所。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"敬畏耶和华就是生命的泉源，","poem":1},{"lineBreak":true},{"text":"可以使人离开死亡的网罗。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"帝王荣耀在乎民多；","poem":1},{"lineBreak":true},{"text":"君王衰败在乎民少。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"不轻易发怒的，大有聪明；","poem":1},{"lineBreak":true},{"text":"性情暴躁的，大显愚妄。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"心中安静是肉体的生命；","poem":1},{"lineBreak":true},{"text":"嫉妒是骨中的朽烂。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"欺压贫寒的，是辱没造他的主；","poem":1},{"lineBreak":true},{"text":"怜悯穷乏的，乃是尊敬主。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"恶人在所行的恶上必被推倒；","poem":1},{"lineBreak":true},{"text":"义人临死，有所投靠。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"智慧存在聪明人心中；","poem":1},{"lineBreak":true},{"text":"愚昧人心里所存的，显而易见。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"公义使邦国高举；","poem":1},{"lineBreak":true},{"text":"罪恶是人民的羞辱。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"智慧的臣子蒙王恩惠；","poem":1},{"lineBreak":true},{"text":"贻羞的仆人遭其震怒。","poem":1}]}],"footnotes":[{"noteId":16,"caller":"-","text":"或译：自叹","reference":{"chapter":14,"verse":8}},{"noteId":17,"caller":"-","text":"或译：赎愆祭愚弄愚妄人","reference":{"chapter":14,"verse":9}}]},"thisChapterLink":"/api/cmn_cu1/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}