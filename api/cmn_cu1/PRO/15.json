{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"回答柔和，使怒消退；","poem":1},{"lineBreak":true},{"text":"言语暴戾，触动怒气。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"智慧人的舌善发知识；","poem":1},{"lineBreak":true},{"text":"愚昧人的口吐出愚昧。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华的眼目无处不在；","poem":1},{"lineBreak":true},{"text":"恶人善人，他都鉴察。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"温良的舌是生命树；","poem":1},{"lineBreak":true},{"text":"乖谬的嘴使人心碎。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愚妄人藐视父亲的管教；","poem":1},{"lineBreak":true},{"text":"领受责备的，得着见识。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"义人家中多有财宝；","poem":1},{"lineBreak":true},{"text":"恶人得利反受扰害。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"智慧人的嘴播扬知识；","poem":1},{"lineBreak":true},{"text":"愚昧人的心并不如此。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"恶人献祭，为耶和华所憎恶；","poem":1},{"lineBreak":true},{"text":"正直人祈祷，为他所喜悦。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"恶人的道路，为耶和华所憎恶；","poem":1},{"lineBreak":true},{"text":"追求公义的，为他所喜爱。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"舍弃正路的，必受严刑；","poem":1},{"lineBreak":true},{"text":"恨恶责备的，必致死亡。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"阴间和灭亡尚在耶和华眼前，","poem":1},{"lineBreak":true},{"text":"何况世人的心呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"亵慢人不爱受责备；","poem":1},{"lineBreak":true},{"text":"他也不就近智慧人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"心中喜乐，面带笑容；","poem":1},{"lineBreak":true},{"text":"心里忧愁，灵被损伤。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"聪明人心求知识；","poem":1},{"lineBreak":true},{"text":"愚昧人口吃愚昧。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"困苦人的日子都是愁苦；","poem":1},{"lineBreak":true},{"text":"心中欢畅的，常享丰筵。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"少有财宝，敬畏耶和华，","poem":1},{"lineBreak":true},{"text":"强如多有财宝，烦乱不安。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"吃素菜，彼此相爱，","poem":1},{"lineBreak":true},{"text":"强如吃肥牛，彼此相恨。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"暴怒的人挑启争端；","poem":1},{"lineBreak":true},{"text":"忍怒的人止息纷争。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"懒惰人的道像荆棘的篱笆；","poem":1},{"lineBreak":true},{"text":"正直人的路是平坦的大道。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"智慧子使父亲喜乐；","poem":1},{"lineBreak":true},{"text":"愚昧人藐视母亲。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"无知的人以愚妄为乐；","poem":1},{"lineBreak":true},{"text":"聪明的人按正直而行。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"不先商议，所谋无效；","poem":1},{"lineBreak":true},{"text":"谋士众多，所谋乃成。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"口善应对，自觉喜乐；","poem":1},{"lineBreak":true},{"text":"话合其时，何等美好。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"智慧人从生命的道上升，","poem":1},{"lineBreak":true},{"text":"使他远离在下的阴间。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"耶和华必拆毁骄傲人的家，","poem":1},{"lineBreak":true},{"text":"却要立定寡妇的地界。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"恶谋为耶和华所憎恶；","poem":1},{"lineBreak":true},{"text":"良言乃为纯净。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"贪恋财利的，扰害己家；","poem":1},{"lineBreak":true},{"text":"恨恶贿赂的，必得存活。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"义人的心，思量如何回答；","poem":1},{"lineBreak":true},{"text":"恶人的口吐出恶言。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"耶和华远离恶人，","poem":1},{"lineBreak":true},{"text":"却听义人的祷告。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"眼有光，使心喜乐；","poem":1},{"lineBreak":true},{"text":"好信息，使骨滋润。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"听从生命责备的，","poem":1},{"lineBreak":true},{"text":"必常在智慧人中。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"弃绝管教的，轻看自己的生命；","poem":1},{"lineBreak":true},{"text":"听从责备的，却得智慧。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"敬畏耶和华是智慧的训诲；","poem":1},{"lineBreak":true},{"text":"尊荣以前，必有谦卑。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}