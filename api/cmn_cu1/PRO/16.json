{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"心中的谋算在乎人；","poem":1},{"lineBreak":true},{"text":"舌头的应对由于耶和华。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"人一切所行的，在自己眼中看为清洁；","poem":1},{"lineBreak":true},{"text":"惟有耶和华衡量人心。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你所做的，要交托耶和华，","poem":1},{"lineBreak":true},{"text":"你所谋的，就必成立。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华所造的，各适其用；","poem":1},{"lineBreak":true},{"text":"就是恶人也为祸患的日子所造。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"凡心里骄傲的，为耶和华所憎恶；","poem":1},{"lineBreak":true},{"text":"虽然连手，他必不免受罚。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因怜悯诚实，罪孽得赎；","poem":1},{"lineBreak":true},{"text":"敬畏耶和华的，远离恶事。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"人所行的，若蒙耶和华喜悦，","poem":1},{"lineBreak":true},{"text":"耶和华也使他的仇敌与他和好。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"多有财利，行事不义，","poem":1},{"lineBreak":true},{"text":"不如少有财利，行事公义。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"人心筹算自己的道路；","poem":1},{"lineBreak":true},{"text":"惟耶和华指引他的脚步。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"王的嘴中有神语，","poem":1},{"lineBreak":true},{"text":"审判之时，他的口必不差错。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"公道的天平和秤都属耶和华；","poem":1},{"lineBreak":true},{"text":"囊中一切法码都为他所定。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"作恶，为王所憎恶，","poem":1},{"lineBreak":true},{"text":"因国位是靠公义坚立。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"公义的嘴为王所喜悦；","poem":1},{"lineBreak":true},{"text":"说正直话的，为王所喜爱。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"王的震怒如杀人的使者；","poem":1},{"lineBreak":true},{"text":"但智慧人能止息王怒。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"王的脸光使人有生命；","poem":1},{"lineBreak":true},{"text":"王的恩典好像春云时雨。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"得智慧胜似得金子；","poem":1},{"lineBreak":true},{"text":"选聪明强如选银子。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"正直人的道是远离恶事；","poem":1},{"lineBreak":true},{"text":"谨守己路的，是保全性命。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"骄傲在败坏以先；","poem":1},{"lineBreak":true},{"text":"狂心在跌倒之前。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"心里谦卑与穷乏人来往，","poem":1},{"lineBreak":true},{"text":"强如将掳物与骄傲人同分。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"谨守训言的，必得好处；","poem":1},{"lineBreak":true},{"text":"倚靠耶和华的，便为有福。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"心中有智慧，必称为通达人；","poem":1},{"lineBreak":true},{"text":"嘴中的甜言，加增人的学问。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"人有智慧就有生命的泉源；","poem":1},{"lineBreak":true},{"text":"愚昧人必被愚昧惩治。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"智慧人的心教训他的口，","poem":1},{"lineBreak":true},{"text":"又使他的嘴增长学问。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"良言如同蜂房，","poem":1},{"lineBreak":true},{"text":"使心觉甘甜，使骨得医治。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"有一条路，人以为正，","poem":1},{"lineBreak":true},{"text":"至终成为死亡之路。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"劳力人的胃口使他劳力，","poem":1},{"lineBreak":true},{"text":"因为他的口腹催逼他。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"匪徒图谋奸恶，","poem":1},{"lineBreak":true},{"text":"嘴上仿佛有烧焦的火。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"乖僻人播散纷争；","poem":1},{"lineBreak":true},{"text":"传舌的，离间密友。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"强暴人诱惑邻舍，","poem":1},{"lineBreak":true},{"text":"领他走不善之道。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"眼目紧合的，图谋乖僻；","poem":1},{"lineBreak":true},{"text":"嘴唇紧闭的，成就邪恶。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"白发是荣耀的冠冕，","poem":1},{"lineBreak":true},{"text":"在公义的道上必能得着。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"不轻易发怒的，胜过勇士；","poem":1},{"lineBreak":true},{"text":"治服己心的，强如取城。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"签放在怀里，","poem":1},{"lineBreak":true},{"text":"定事由耶和华。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}