{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"设筵满屋，大家相争，","poem":1},{"lineBreak":true},{"text":"不如有块干饼，大家相安。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"仆人办事聪明，必管辖贻羞之子，","poem":1},{"lineBreak":true},{"text":"又在众子中同分产业。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"鼎为炼银，炉为炼金；","poem":1},{"lineBreak":true},{"text":"惟有耶和华熬炼人心。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"行恶的，留心听奸诈之言；","poem":1},{"lineBreak":true},{"text":"说谎的，侧耳听邪恶之语。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"戏笑穷人的，是辱没造他的主；","poem":1},{"lineBreak":true},{"text":"幸灾乐祸的，必不免受罚。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"子孙为老人的冠冕；","poem":1},{"lineBreak":true},{"text":"父亲是儿女的荣耀。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愚顽人说美言本不相宜，","poem":1},{"lineBreak":true},{"text":"何况君王说谎话呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"贿赂在馈送的人眼中看为宝玉，","poem":1},{"lineBreak":true},{"text":"随处运动都得顺利。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"遮掩人过的，寻求人爱；","poem":1},{"lineBreak":true},{"text":"屡次挑错的，离间密友。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"一句责备话深入聪明人的心，","poem":1},{"lineBreak":true},{"text":"强如责打愚昧人一百下。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"恶人只寻背叛，","poem":1},{"lineBreak":true},{"text":"所以必有严厉的使者奉差攻击他。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"宁可遇见丢崽子的母熊，","poem":1},{"lineBreak":true},{"text":"不可遇见正行愚妄的愚昧人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"以恶报善的，","poem":1},{"lineBreak":true},{"text":"祸患必不离他的家。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"纷争的起头如水放开，","poem":1},{"lineBreak":true},{"text":"所以，在争闹之先必当止息争竞。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"定恶人为义的，定义人为恶的，","poem":1},{"lineBreak":true},{"text":"这都为耶和华所憎恶。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"愚昧人既无聪明，","poem":1},{"lineBreak":true},{"text":"为何手拿价银买智慧呢？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"朋友乃时常亲爱，","poem":1},{"lineBreak":true},{"text":"弟兄为患难而生。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"在邻舍面前击掌作保","poem":1},{"lineBreak":true},{"text":"乃是无知的人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"喜爱争竞的，是喜爱过犯；","poem":1},{"lineBreak":true},{"text":"高立家门的，乃自取败坏。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"心存邪僻的，寻不着好处；","poem":1},{"lineBreak":true},{"text":"舌弄是非的，陷在祸患中。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"生愚昧子的，必自愁苦；","poem":1},{"lineBreak":true},{"text":"愚顽人的父毫无喜乐。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"喜乐的心乃是良药；","poem":1},{"lineBreak":true},{"text":"忧伤的灵使骨枯干。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"恶人暗中受贿赂，","poem":1},{"lineBreak":true},{"text":"为要颠倒判断。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"明哲人眼前有智慧；","poem":1},{"lineBreak":true},{"text":"愚昧人眼望地极。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"愚昧子使父亲愁烦，","poem":1},{"lineBreak":true},{"text":"使母亲忧苦。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"刑罚义人为不善；","poem":1},{"lineBreak":true},{"text":"责打君子为不义。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"寡少言语的，有知识；","poem":1},{"lineBreak":true},{"text":"性情温良的，有聪明。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"愚昧人若静默不言也可算为智慧；","poem":1},{"lineBreak":true},{"text":"闭口不说也可算为聪明。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}