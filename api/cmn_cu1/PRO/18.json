{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"与众寡合的，独自寻求心愿，","poem":1},{"lineBreak":true},{"text":"并恼恨一切真智慧。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愚昧人不喜爱明哲，","poem":1},{"lineBreak":true},{"text":"只喜爱显露心意。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"恶人来，藐视随来；","poem":1},{"lineBreak":true},{"text":"羞耻到，辱骂同到。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"人口中的言语如同深水；","poem":1},{"lineBreak":true},{"text":"智慧的泉源好像涌流的河水。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"瞻徇恶人的情面，","poem":1},{"lineBreak":true},{"text":"偏断义人的案件，都为不善。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愚昧人张嘴启争端，","poem":1},{"lineBreak":true},{"text":"开口招鞭打。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愚昧人的口自取败坏；","poem":1},{"lineBreak":true},{"text":"他的嘴是他生命的网罗。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"传舌人的言语如同美食，","poem":1},{"lineBreak":true},{"text":"深入人的心腹。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"做工懈怠的，","poem":1},{"lineBreak":true},{"text":"与浪费人为弟兄。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华的名是坚固台；","poem":1},{"lineBreak":true},{"text":"义人奔入便得安稳。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"富足人的财物是他的坚城，","poem":1},{"lineBreak":true},{"text":"在他心想，犹如高墙。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"败坏之先，人心骄傲；","poem":1},{"lineBreak":true},{"text":"尊荣以前，必有谦卑。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"未曾听完先回答的，","poem":1},{"lineBreak":true},{"text":"便是他的愚昧和羞辱。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人有疾病，心能忍耐；","poem":1},{"lineBreak":true},{"text":"心灵忧伤，谁能承当呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"聪明人的心得知识；","poem":1},{"lineBreak":true},{"text":"智慧人的耳求知识。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"人的礼物为他开路，","poem":1},{"lineBreak":true},{"text":"引他到高位的人面前。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"先诉情由的，似乎有理；","poem":1},{"lineBreak":true},{"text":"但邻舍来到，就察出实情。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"掣签能止息争竞，","poem":1},{"lineBreak":true},{"text":"也能解散强胜的人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"弟兄结怨，劝他和好，比取坚固城还难；","poem":1},{"lineBreak":true},{"text":"这样的争竞如同坚寨的门闩。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"人口中所结的果子，必充满肚腹；","poem":1},{"lineBreak":true},{"text":"他嘴所出的，必使他饱足。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"生死在舌头的权下，","poem":1},{"lineBreak":true},{"text":"喜爱它的，必吃它所结的果子。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"得着贤妻的，是得着好处，","poem":1},{"lineBreak":true},{"text":"也是蒙了耶和华的恩惠。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"贫穷人说哀求的话；","poem":1},{"lineBreak":true},{"text":"富足人用威吓的话回答。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"滥交朋友的，自取败坏；","poem":1},{"lineBreak":true},{"text":"但有一朋友比弟兄更亲密。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}