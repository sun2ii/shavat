{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"行为纯正的贫穷人","poem":1},{"lineBreak":true},{"text":"胜过乖谬愚妄的富足人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"心无知识的，乃为不善；","poem":1},{"lineBreak":true},{"text":"脚步急快的，难免犯罪。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人的愚昧倾败他的道；","poem":1},{"lineBreak":true},{"text":"他的心也抱怨耶和华。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"财物使朋友增多；","poem":1},{"lineBreak":true},{"text":"但穷人朋友远离。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"作假见证的，必不免受罚；","poem":1},{"lineBreak":true},{"text":"吐出谎言的，终不能逃脱。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"好施散的，有多人求他的恩情；","poem":1},{"lineBreak":true},{"text":"爱送礼的，人都为他的朋友。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"贫穷人，弟兄都恨他；","poem":1},{"lineBreak":true},{"text":"何况他的朋友，更远离他！","poem":1},{"lineBreak":true},{"text":"他用言语追随，他们却走了。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"得着智慧的，爱惜生命；","poem":1},{"lineBreak":true},{"text":"保守聪明的，必得好处。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"作假见证的，不免受罚；","poem":1},{"lineBreak":true},{"text":"吐出谎言的，也必灭亡。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"愚昧人宴乐度日是不合宜的；","poem":1},{"lineBreak":true},{"text":"何况仆人管辖王子呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"人有见识就不轻易发怒；","poem":1},{"lineBreak":true},{"text":"宽恕人的过失便是自己的荣耀。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"王的忿怒好像狮子吼叫；","poem":1},{"lineBreak":true},{"text":"他的恩典却如草上的甘露。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"愚昧的儿子是父亲的祸患；","poem":1},{"lineBreak":true},{"text":"妻子的争吵如雨连连滴漏。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"房屋钱财是祖宗所遗留的；","poem":1},{"lineBreak":true},{"text":"惟有贤慧的妻是耶和华所赐的。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"懒惰使人沉睡；","poem":1},{"lineBreak":true},{"text":"懈怠的人必受饥饿。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"谨守诫命的，保全生命；","poem":1},{"lineBreak":true},{"text":"轻忽己路的，必致死亡。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"怜悯贫穷的，就是借给耶和华；","poem":1},{"lineBreak":true},{"text":"他的善行，耶和华必偿还。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"趁有指望，管教你的儿子；","poem":1},{"lineBreak":true},{"text":"你的心不可任他死亡。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"暴怒的人必受刑罚；","poem":1},{"lineBreak":true},{"text":"你若救他，必须再救。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你要听劝教，受训诲，","poem":1},{"lineBreak":true},{"text":"使你终久有智慧。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"人心多有计谋；","poem":1},{"lineBreak":true},{"text":"惟有耶和华的筹算才能立定。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"施行仁慈的，令人爱慕；","poem":1},{"lineBreak":true},{"text":"穷人强如说谎言的。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"敬畏耶和华的，得着生命；","poem":1},{"lineBreak":true},{"text":"他必恒久知足，不遭祸患。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"懒惰人放手在盘子里，","poem":1},{"lineBreak":true},{"text":"就是向口撤回，他也不肯。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"鞭打亵慢人，愚蒙人必长见识；","poem":1},{"lineBreak":true},{"text":"责备明哲人，他就明白知识。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"虐待父亲、撵出母亲的，","poem":1},{"lineBreak":true},{"text":"是贻羞致辱之子。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我儿，不可听了教训","poem":1},{"lineBreak":true},{"text":"而又偏离知识的言语。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"匪徒作见证戏笑公平；","poem":1},{"lineBreak":true},{"text":"恶人的口吞下罪孽。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"刑罚是为亵慢人预备的；","poem":1},{"lineBreak":true},{"text":"鞭打是为愚昧人的背预备的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}