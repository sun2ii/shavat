{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":2,"content":[{"type":"heading","content":["智慧的赏赐"]},{"type":"verse","number":1,"content":[{"text":"我儿，你若领受我的言语，","poem":1},{"lineBreak":true},{"text":"存记我的命令，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"侧耳听智慧，","poem":1},{"lineBreak":true},{"text":"专心求聪明，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"呼求明哲，","poem":1},{"lineBreak":true},{"text":"扬声求聪明，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"寻找它，如寻找银子，","poem":1},{"lineBreak":true},{"text":"搜求它，如搜求隐藏的珍宝，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你就明白敬畏耶和华，","poem":1},{"lineBreak":true},{"text":"得以认识 神。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因为，耶和华赐人智慧；","poem":1},{"lineBreak":true},{"text":"知识和聪明都由他口而出。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他给正直人存留真智慧，","poem":1},{"lineBreak":true},{"text":"给行为纯正的人作盾牌，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"为要保守公平人的路，","poem":1},{"lineBreak":true},{"text":"护庇虔敬人的道。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"你也必明白仁义、公平、","poem":1},{"lineBreak":true},{"text":"正直、一切的善道。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"智慧必入你心；","poem":1},{"lineBreak":true},{"text":"你的灵要以知识为美。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"谋略必护卫你；","poem":1},{"lineBreak":true},{"text":"聪明必保守你，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"要救你脱离恶道","poem":1},{"noteId":1},{"text":"，","poem":1},{"lineBreak":true},{"text":"脱离说乖谬话的人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"那等人舍弃正直的路，","poem":1},{"lineBreak":true},{"text":"行走黑暗的道，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"欢喜作恶，","poem":1},{"lineBreak":true},{"text":"喜爱恶人的乖僻，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"在他们的道中弯曲，","poem":1},{"lineBreak":true},{"text":"在他们的路上偏僻。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"智慧要救你脱离淫妇，","poem":1},{"lineBreak":true},{"text":"就是那油嘴滑舌的外女。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"她离弃幼年的配偶，","poem":1},{"lineBreak":true},{"text":"忘了 神的盟约。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"她的家陷入死地；","poem":1},{"lineBreak":true},{"text":"她的路偏向阴间。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"凡到她那里去的，不得转回，","poem":1},{"lineBreak":true},{"text":"也得不着生命的路。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"智慧必使你行善人的道，","poem":1},{"lineBreak":true},{"text":"守义人的路。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"正直人必在世上居住；","poem":1},{"lineBreak":true},{"text":"完全人必在地上存留。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"惟有恶人必然剪除；","poem":1},{"lineBreak":true},{"text":"奸诈的，必然拔出。","poem":1}]}],"footnotes":[{"noteId":1,"caller":"-","text":"或译：恶人的道","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/cmn_cu1/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}