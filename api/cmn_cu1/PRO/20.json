{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"酒能使人亵慢，浓酒使人喧嚷；","poem":1},{"lineBreak":true},{"text":"凡因酒错误的，就无智慧。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"王的威吓如同狮子吼叫；","poem":1},{"lineBreak":true},{"text":"惹动他怒的，是自害己命。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"远离纷争是人的尊荣；","poem":1},{"lineBreak":true},{"text":"愚妄人都爱争闹。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"懒惰人因冬寒不肯耕种，","poem":1},{"lineBreak":true},{"text":"到收割的时候，他必讨饭而无所得。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"人心怀藏谋略，好像深水，","poem":1},{"lineBreak":true},{"text":"惟明哲人才能汲引出来。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"人多述说自己的仁慈，","poem":1},{"lineBreak":true},{"text":"但忠信人谁能遇着呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"行为纯正的义人，","poem":1},{"lineBreak":true},{"text":"他的子孙是有福的！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"王坐在审判的位上，","poem":1},{"lineBreak":true},{"text":"以眼目驱散诸恶。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"谁能说，我洁净了我的心，","poem":1},{"lineBreak":true},{"text":"我脱净了我的罪？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"两样的法码，两样的升斗，","poem":1},{"lineBreak":true},{"text":"都为耶和华所憎恶。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"孩童的动作是清洁，是正直，","poem":1},{"lineBreak":true},{"text":"都显明他的本性。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"能听的耳，能看的眼，","poem":1},{"lineBreak":true},{"text":"都是耶和华所造的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"不要贪睡，免致贫穷；","poem":1},{"lineBreak":true},{"text":"眼要睁开，你就吃饱。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"买物的说：不好，不好；","poem":1},{"lineBreak":true},{"text":"及至买去，他便自夸。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"有金子和许多珍珠","poem":1},{"noteId":18},{"text":"，","poem":1},{"lineBreak":true},{"text":"惟有知识的嘴乃为贵重的珍宝。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"谁为生人作保，就拿谁的衣服；","poem":1},{"lineBreak":true},{"text":"谁为外人作保，谁就要承当。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"以虚谎而得的食物，人觉甘甜；","poem":1},{"lineBreak":true},{"text":"但后来，他的口必充满尘沙。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"计谋都凭筹算立定；","poem":1},{"lineBreak":true},{"text":"打仗要凭智谋。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"往来传舌的，泄漏密事；","poem":1},{"lineBreak":true},{"text":"大张嘴的，不可与他结交。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"咒骂父母的，他的灯必灭，","poem":1},{"lineBreak":true},{"text":"变为漆黑的黑暗。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"起初速得的产业，","poem":1},{"lineBreak":true},{"text":"终久却不为福。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你不要说，我要以恶报恶；","poem":1},{"lineBreak":true},{"text":"要等候耶和华，他必拯救你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"两样的法码为耶和华所憎恶；","poem":1},{"lineBreak":true},{"text":"诡诈的天平也为不善。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"人的脚步为耶和华所定；","poem":1},{"lineBreak":true},{"text":"人岂能明白自己的路呢？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"人冒失说，这是圣物，","poem":1},{"lineBreak":true},{"text":"许愿之后才查问，就是自陷网罗。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"智慧的王簸散恶人，","poem":1},{"lineBreak":true},{"text":"用碌碡滚轧他们。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"人的灵是耶和华的灯，","poem":1},{"lineBreak":true},{"text":"鉴察人的心腹。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"王因仁慈和诚实得以保全他的国位，","poem":1},{"lineBreak":true},{"text":"也因仁慈立稳。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"强壮乃少年人的荣耀；","poem":1},{"lineBreak":true},{"text":"白发为老年人的尊荣。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"鞭伤除净人的罪恶；","poem":1},{"lineBreak":true},{"text":"责打能入人的心腹。","poem":1}]}],"footnotes":[{"noteId":18,"caller":"-","text":"或译：红宝石","reference":{"chapter":20,"verse":15}}]},"thisChapterLink":"/api/cmn_cu1/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}