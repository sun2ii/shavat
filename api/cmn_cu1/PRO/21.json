{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"王的心在耶和华手中，","poem":1},{"lineBreak":true},{"text":"好像陇沟的水随意流转。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"人所行的，在自己眼中都看为正；","poem":1},{"lineBreak":true},{"text":"惟有耶和华衡量人心。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"行仁义公平","poem":1},{"lineBreak":true},{"text":"比献祭更蒙耶和华悦纳。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"恶人发达","poem":1},{"noteId":19},{"text":"，眼高心傲，","poem":1},{"lineBreak":true},{"text":"这乃是罪。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"殷勤筹划的，足致丰裕；","poem":1},{"lineBreak":true},{"text":"行事急躁的，都必缺乏。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"用诡诈之舌求财的，就是自己取死；","poem":1},{"lineBreak":true},{"text":"所得之财乃是吹来吹去的浮云。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"恶人的强暴必将自己扫除，","poem":1},{"lineBreak":true},{"text":"因他们不肯按公平行事。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"负罪之人的路甚是弯曲；","poem":1},{"lineBreak":true},{"text":"至于清洁的人，他所行的乃是正直。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"宁可住在房顶的角上，","poem":1},{"lineBreak":true},{"text":"不在宽阔的房屋与争吵的妇人同住。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"恶人的心乐人受祸；","poem":1},{"lineBreak":true},{"text":"他眼并不怜恤邻舍。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"亵慢的人受刑罚，愚蒙的人就得智慧；","poem":1},{"lineBreak":true},{"text":"智慧人受训诲，便得知识。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"义人思想恶人的家，","poem":1},{"lineBreak":true},{"text":"知道恶人倾倒，必致灭亡。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"塞耳不听穷人哀求的，","poem":1},{"lineBreak":true},{"text":"他将来呼吁也不蒙应允。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"暗中送的礼物挽回怒气；","poem":1},{"lineBreak":true},{"text":"怀中搋的贿赂止息暴怒。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"秉公行义使义人喜乐，","poem":1},{"lineBreak":true},{"text":"使作孽的人败坏。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"迷离通达道路的，","poem":1},{"lineBreak":true},{"text":"必住在阴魂的会中。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"爱宴乐的，必致穷乏；","poem":1},{"lineBreak":true},{"text":"好酒，爱膏油的，必不富足。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"恶人作了义人的赎价；","poem":1},{"lineBreak":true},{"text":"奸诈人代替正直人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"宁可住在旷野，","poem":1},{"lineBreak":true},{"text":"不与争吵使气的妇人同住。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"智慧人家中积蓄宝物膏油；","poem":1},{"lineBreak":true},{"text":"愚昧人随得来随吞下。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"追求公义仁慈的，","poem":1},{"lineBreak":true},{"text":"就寻得生命、公义，和尊荣。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"智慧人爬上勇士的城墙，","poem":1},{"lineBreak":true},{"text":"倾覆他所倚靠的坚垒。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"谨守口与舌的，","poem":1},{"lineBreak":true},{"text":"就保守自己免受灾难。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"心骄气傲的人名叫亵慢；","poem":1},{"lineBreak":true},{"text":"他行事狂妄，都出于骄傲。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"懒惰人的心愿将他杀害，","poem":1},{"lineBreak":true},{"text":"因为他手不肯做工。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"有终日贪得无厌的；","poem":1},{"lineBreak":true},{"text":"义人施舍而不吝惜。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"恶人的祭物是可憎的；","poem":1},{"lineBreak":true},{"text":"何况他存恶意来献呢？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"作假见证的必灭亡；","poem":1},{"lineBreak":true},{"text":"惟有听真情而言的，其言长存。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"恶人脸无羞耻；","poem":1},{"lineBreak":true},{"text":"正直人行事坚定。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"没有人能以智慧、聪明、","poem":1},{"lineBreak":true},{"text":"谋略敌挡耶和华。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"马是为打仗之日预备的；","poem":1},{"lineBreak":true},{"text":"得胜乃在乎耶和华。","poem":1}]}],"footnotes":[{"noteId":19,"caller":"-","text":"发达：原文是灯","reference":{"chapter":21,"verse":4}}]},"thisChapterLink":"/api/cmn_cu1/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}