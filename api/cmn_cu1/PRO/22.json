{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"美名胜过大财；","poem":1},{"lineBreak":true},{"text":"恩宠强如金银。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"富户穷人在世相遇，","poem":1},{"lineBreak":true},{"text":"都为耶和华所造。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"通达人见祸藏躲；","poem":1},{"lineBreak":true},{"text":"愚蒙人前往受害。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"敬畏耶和华心存谦卑，","poem":1},{"lineBreak":true},{"text":"就得富有、尊荣、生命为赏赐。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"乖僻人的路上有荆棘和网罗；","poem":1},{"lineBreak":true},{"text":"保守自己生命的，必要远离。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"教养孩童，使他走当行的道，","poem":1},{"lineBreak":true},{"text":"就是到老他也不偏离。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"富户管辖穷人；","poem":1},{"lineBreak":true},{"text":"欠债的是债主的仆人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"撒罪孽的，必收灾祸；","poem":1},{"lineBreak":true},{"text":"他逞怒的杖也必废掉。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"眼目慈善的，就必蒙福，","poem":1},{"lineBreak":true},{"text":"因他将食物分给穷人。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"赶出亵慢人，争端就消除；","poem":1},{"lineBreak":true},{"text":"纷争和羞辱也必止息。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"喜爱清心的人因他嘴上的恩言，","poem":1},{"lineBreak":true},{"text":"王必与他为友。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华的眼目眷顾聪明人，","poem":1},{"lineBreak":true},{"text":"却倾败奸诈人的言语。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"懒惰人说：外头有狮子；","poem":1},{"lineBreak":true},{"text":"我在街上就必被杀。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"淫妇的口为深坑；","poem":1},{"lineBreak":true},{"text":"耶和华所憎恶的，必陷在其中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愚蒙迷住孩童的心，","poem":1},{"lineBreak":true},{"text":"用管教的杖可以远远赶除。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"欺压贫穷为要利己的，","poem":1},{"lineBreak":true},{"text":"并送礼与富户的，都必缺乏。","poem":1}]},{"type":"heading","content":["智言三十则"]},{"type":"verse","number":17,"content":[{"text":"你须侧耳听受智慧人的言语，","poem":1},{"lineBreak":true},{"text":"留心领会我的知识。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你若心中存记，","poem":1},{"lineBreak":true},{"text":"嘴上咬定，这便为美。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我今日以此特特指教你，","poem":1},{"lineBreak":true},{"text":"为要使你倚靠耶和华。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"谋略和知识的美事，","poem":1},{"lineBreak":true},{"text":"我岂没有写给你吗？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"要使你知道真言的实理，","poem":1},{"lineBreak":true},{"text":"你好将真言回复那打发你来的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"贫穷人，你不可因他贫穷就抢夺他的物，","poem":1},{"lineBreak":true},{"text":"也不可在城门口欺压困苦人；","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"因耶和华必为他辨屈；","poem":1},{"lineBreak":true},{"text":"抢夺他的，耶和华必夺取那人的命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"好生气的人，不可与他结交；","poem":1},{"lineBreak":true},{"text":"暴怒的人，不可与他来往；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"恐怕你效法他的行为，","poem":1},{"lineBreak":true},{"text":"自己就陷在网罗里。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"不要与人击掌，","poem":1},{"lineBreak":true},{"text":"不要为欠债的作保。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你若没有什么偿还，","poem":1},{"lineBreak":true},{"text":"何必使人夺去你睡卧的床呢？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你先祖所立的地界，","poem":1},{"lineBreak":true},{"text":"你不可挪移。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"你看见办事殷勤的人吗？","poem":1},{"lineBreak":true},{"text":"他必站在君王面前，","poem":1},{"lineBreak":true},{"text":"必不站在下贱人面前。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}