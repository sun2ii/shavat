{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"你若与官长坐席，","poem":1},{"lineBreak":true},{"text":"要留意在你面前的是谁。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你若是贪食的，","poem":1},{"lineBreak":true},{"text":"就当拿刀放在喉咙上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"不可贪恋他的美食，","poem":1},{"lineBreak":true},{"text":"因为是哄人的食物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"不要劳碌求富，","poem":1},{"lineBreak":true},{"text":"休仗自己的聪明。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你岂要定睛在虚无的钱财上吗？","poem":1},{"lineBreak":true},{"text":"因钱财必长翅膀，如鹰向天飞去。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"不要吃恶眼人的饭，","poem":1},{"lineBreak":true},{"text":"也不要贪他的美味；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因为他心怎样思量，","poem":1},{"lineBreak":true},{"text":"他为人就是怎样。","poem":1},{"lineBreak":true},{"text":"他虽对你说，请吃，请喝，","poem":1},{"lineBreak":true},{"text":"他的心却与你相背。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你所吃的那点食物必吐出来；","poem":1},{"lineBreak":true},{"text":"你所说的甘美言语也必落空。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"你不要说话给愚昧人听，","poem":1},{"lineBreak":true},{"text":"因他必藐视你智慧的言语。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"不可挪移古时的地界，","poem":1},{"lineBreak":true},{"text":"也不可侵入孤儿的田地；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因他们的救赎主大有能力，","poem":1},{"lineBreak":true},{"text":"他必向你为他们辨屈。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"你要留心领受训诲，","poem":1},{"lineBreak":true},{"text":"侧耳听从知识的言语。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"不可不管教孩童；","poem":1},{"lineBreak":true},{"text":"你用杖打他，他必不至于死。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你要用杖打他，","poem":1},{"lineBreak":true},{"text":"就可以救他的灵魂免下阴间。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"我儿，你心若存智慧，","poem":1},{"lineBreak":true},{"text":"我的心也甚欢喜。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你的嘴若说正直话，","poem":1},{"lineBreak":true},{"text":"我的心肠也必快乐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"你心中不要嫉妒罪人，","poem":1},{"lineBreak":true},{"text":"只要终日敬畏耶和华；","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因为至终必有善报，","poem":1},{"lineBreak":true},{"text":"你的指望也不致断绝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"我儿，你当听，当存智慧，","poem":1},{"lineBreak":true},{"text":"好在正道上引导你的心。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"好饮酒的，好吃肉的，","poem":1},{"lineBreak":true},{"text":"不要与他们来往；","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"因为好酒贪食的，必致贫穷；","poem":1},{"lineBreak":true},{"text":"好睡觉的，必穿破烂衣服。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"你要听从生你的父亲；","poem":1},{"lineBreak":true},{"text":"你母亲老了，也不可藐视她。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你当买真理；","poem":1},{"lineBreak":true},{"text":"就是智慧、训诲，和聪明也都不可卖。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"义人的父亲必大得快乐；","poem":1},{"lineBreak":true},{"text":"人生智慧的儿子，必因他欢喜。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你要使父母欢喜，","poem":1},{"lineBreak":true},{"text":"使生你的快乐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"我儿，要将你的心归我；","poem":1},{"lineBreak":true},{"text":"你的眼目也要喜悦我的道路。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"妓女是深坑；","poem":1},{"lineBreak":true},{"text":"外女是窄阱。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"她埋伏好像强盗；","poem":1},{"lineBreak":true},{"text":"她使人中多有奸诈的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"谁有祸患？谁有忧愁？","poem":1},{"lineBreak":true},{"text":"谁有争斗？谁有哀叹","poem":1},{"noteId":20},{"text":"？","poem":1},{"lineBreak":true},{"text":"谁无故受伤？谁眼目红赤？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"就是那流连饮酒、","poem":1},{"lineBreak":true},{"text":"常去寻找调和酒的人。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"酒发红，在杯中闪烁，","poem":1},{"lineBreak":true},{"text":"你不可观看，","poem":1},{"lineBreak":true},{"text":"虽然下咽舒畅，","poem":1},{"lineBreak":true},{"text":"终久是咬你如蛇，刺你如毒蛇。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"你眼必看见异怪的事","poem":1},{"noteId":21},{"text":"；","poem":1},{"lineBreak":true},{"text":"你心必发出乖谬的话。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你必像躺在海中，","poem":1},{"lineBreak":true},{"text":"或像卧在桅杆上。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"你必说：人打我，我却未受伤；","poem":1},{"lineBreak":true},{"text":"人鞭打我，我竟不觉得。","poem":1},{"lineBreak":true},{"text":"我几时清醒，我仍去寻酒。","poem":1}]}],"footnotes":[{"noteId":20,"caller":"-","text":"或译：怨言","reference":{"chapter":23,"verse":29}},{"noteId":21,"caller":"-","text":"或译：淫妇","reference":{"chapter":23,"verse":33}}]},"thisChapterLink":"/api/cmn_cu1/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":34}