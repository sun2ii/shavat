{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"你不要嫉妒恶人，","poem":1},{"lineBreak":true},{"text":"也不要起意与他们相处；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为，他们的心图谋强暴，","poem":1},{"lineBreak":true},{"text":"他们的口谈论奸恶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"房屋因智慧建造，","poem":1},{"lineBreak":true},{"text":"又因聪明立稳；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"其中因知识充满各样美好宝贵的财物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"智慧人大有能力；","poem":1},{"lineBreak":true},{"text":"有知识的人力上加力。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你去打仗，要凭智谋；","poem":1},{"lineBreak":true},{"text":"谋士众多，人便得胜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"智慧极高，非愚昧人所能及，","poem":1},{"lineBreak":true},{"text":"所以在城门内不敢开口。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"设计作恶的，","poem":1},{"lineBreak":true},{"text":"必称为奸人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愚妄人的思念乃是罪恶；","poem":1},{"lineBreak":true},{"text":"亵慢者为人所憎恶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你在患难之日若胆怯，","poem":1},{"lineBreak":true},{"text":"你的力量就微小。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"人被拉到死地，你要解救；","poem":1},{"lineBreak":true},{"text":"人将被杀，你须拦阻。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你若说：这事我未曾知道，","poem":1},{"lineBreak":true},{"text":"那衡量人心的岂不明白吗？","poem":1},{"lineBreak":true},{"text":"保守你命的岂不知道吗？","poem":1},{"lineBreak":true},{"text":"他岂不按各人所行的报应各人吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我儿，你要吃蜜，因为是好的；","poem":1},{"lineBreak":true},{"text":"吃蜂房下滴的蜜便觉甘甜。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你心得了智慧，也必觉得如此。","poem":1},{"lineBreak":true},{"text":"你若找着，至终必有善报；","poem":1},{"lineBreak":true},{"text":"你的指望也不致断绝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"你这恶人，不要埋伏攻击义人的家；","poem":1},{"lineBreak":true},{"text":"不要毁坏他安居之所。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因为，义人虽七次跌倒，仍必兴起；","poem":1},{"lineBreak":true},{"text":"恶人却被祸患倾倒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"你仇敌跌倒，你不要欢喜；","poem":1},{"lineBreak":true},{"text":"他倾倒，你心不要快乐；","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"恐怕耶和华看见就不喜悦，","poem":1},{"lineBreak":true},{"text":"将怒气从仇敌身上转过来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"不要为作恶的心怀不平，","poem":1},{"lineBreak":true},{"text":"也不要嫉妒恶人；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"因为，恶人终不得善报；","poem":1},{"lineBreak":true},{"text":"恶人的灯也必熄灭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"我儿，你要敬畏耶和华与君王，","poem":1},{"lineBreak":true},{"text":"不要与反复无常的人结交，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为他们的灾难必忽然而起。","poem":1},{"lineBreak":true},{"text":"耶和华与君王所施行的毁灭，","poem":1},{"lineBreak":true},{"text":"谁能知道呢？","poem":1}]},{"type":"heading","content":["其他智言"]},{"type":"verse","number":23,"content":[{"text":"以下也是智慧人的箴言：","poem":1},{"lineBreak":true},{"text":"审判时看人情面是不好的。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"对恶人说「你是义人」的，","poem":1},{"lineBreak":true},{"text":"这人万民必咒诅，列邦必憎恶。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"责备恶人的，必得喜悦；","poem":1},{"lineBreak":true},{"text":"美好的福也必临到他。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"应对正直的，犹如与人亲嘴。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"你要在外头预备工料，","poem":1},{"lineBreak":true},{"text":"在田间办理整齐，","poem":1},{"lineBreak":true},{"text":"然后建造房屋。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"不可无故作见证陷害邻舍，","poem":1},{"lineBreak":true},{"text":"也不可用嘴欺骗人。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"不可说：人怎样待我，我也怎样待他；","poem":1},{"lineBreak":true},{"text":"我必照他所行的报复他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"我经过懒惰人的田地、","poem":1},{"lineBreak":true},{"text":"无知人的葡萄园，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"荆棘长满了地皮，","poem":1},{"lineBreak":true},{"text":"刺草遮盖了田面，","poem":1},{"lineBreak":true},{"text":"石墙也坍塌了。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我看见就留心思想；","poem":1},{"lineBreak":true},{"text":"我看着就领了训诲。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"再睡片时，打盹片时，","poem":1},{"lineBreak":true},{"text":"抱着手躺卧片时，","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你的贫穷就必如强盗速来，","poem":1},{"lineBreak":true},{"text":"你的缺乏仿佛拿兵器的人来到。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}