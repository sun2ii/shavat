{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":25,"content":[{"type":"heading","content":["所罗门的另一些箴言"]},{"type":"verse","number":1,"content":[{"text":"以下也是所罗门的箴言，是犹大王希西家的人所誊录的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"将事隐秘乃 神的荣耀；","poem":1},{"lineBreak":true},{"text":"将事察清乃君王的荣耀。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"天之高，地之厚，","poem":1},{"lineBreak":true},{"text":"君王之心也测不透。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"除去银子的渣滓就有银子出来，","poem":1},{"lineBreak":true},{"text":"银匠能以做器皿。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"除去王面前的恶人，","poem":1},{"lineBreak":true},{"text":"国位就靠公义坚立。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"不要在王面前妄自尊大；","poem":1},{"lineBreak":true},{"text":"不要在大人的位上站立。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"宁可有人说：请你上来，","poem":1},{"lineBreak":true},{"text":"强如在你觐见的王子面前叫你退下。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"不要冒失出去与人争竞，","poem":1},{"lineBreak":true},{"text":"免得至终被他羞辱，","poem":1},{"lineBreak":true},{"text":"你就不知道怎样行了。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你与邻舍争讼，","poem":1},{"lineBreak":true},{"text":"要与他一人辩论，","poem":1},{"lineBreak":true},{"text":"不可泄漏人的密事，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"恐怕听见的人骂你，","poem":1},{"lineBreak":true},{"text":"你的臭名就难以脱离。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"一句话说得合宜，","poem":1},{"lineBreak":true},{"text":"就如金苹果在银网子里。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"智慧人的劝戒，在顺从的人耳中，","poem":1},{"lineBreak":true},{"text":"好像金耳环和精金的妆饰。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"忠信的使者叫差他的人心里舒畅，","poem":1},{"lineBreak":true},{"text":"就如在收割时有冰雪的凉气。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"空夸赠送礼物的，","poem":1},{"lineBreak":true},{"text":"好像无雨的风云。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"恒常忍耐可以劝动君王；","poem":1},{"lineBreak":true},{"text":"柔和的舌头能折断骨头。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你得了蜜吗？只可吃够而已，","poem":1},{"lineBreak":true},{"text":"恐怕你过饱就呕吐出来。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你的脚要少进邻舍的家，","poem":1},{"lineBreak":true},{"text":"恐怕他厌烦你，恨恶你。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"作假见证陷害邻舍的，","poem":1},{"lineBreak":true},{"text":"就是大槌，是利刀，是快箭。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"患难时倚靠不忠诚的人，","poem":1},{"lineBreak":true},{"text":"好像破坏的牙，错骨缝的脚。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"对伤心的人唱歌，","poem":1},{"lineBreak":true},{"text":"就如冷天脱衣服，","poem":1},{"lineBreak":true},{"text":"又如硷上倒醋。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你的仇敌若饿了，就给他饭吃；","poem":1},{"lineBreak":true},{"text":"若渴了，就给他水喝；","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为，你这样行就是把炭火堆在他的头上；","poem":1},{"lineBreak":true},{"text":"耶和华也必赏赐你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"北风生雨，","poem":1},{"lineBreak":true},{"text":"谗谤人的舌头也生怒容。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"宁可住在房顶的角上，","poem":1},{"lineBreak":true},{"text":"不在宽阔的房屋与争吵的妇人同住。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"有好消息从远方来，","poem":1},{"lineBreak":true},{"text":"就如拿凉水给口渴的人喝。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"义人在恶人面前退缩，","poem":1},{"lineBreak":true},{"text":"好像趟浑之泉，弄浊之井。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"吃蜜过多是不好的；","poem":1},{"lineBreak":true},{"text":"考究自己的荣耀也是可厌的。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"人不制伏自己的心，","poem":1},{"lineBreak":true},{"text":"好像毁坏的城邑没有墙垣。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}