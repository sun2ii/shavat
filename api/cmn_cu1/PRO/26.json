{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"夏天落雪，收割时下雨，都不相宜；","poem":1},{"lineBreak":true},{"text":"愚昧人得尊荣也是如此。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"麻雀往来，燕子翻飞；","poem":1},{"lineBreak":true},{"text":"这样，无故的咒诅也必不临到。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"鞭子是为打马，辔头是为勒驴；","poem":1},{"lineBreak":true},{"text":"刑杖是为打愚昧人的背。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"不要照愚昧人的愚妄话回答他，","poem":1},{"lineBreak":true},{"text":"恐怕你与他一样。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要照愚昧人的愚妄话回答他，","poem":1},{"lineBreak":true},{"text":"免得他自以为有智慧。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"借愚昧人手寄信的，","poem":1},{"lineBreak":true},{"text":"是砍断自己的脚，自受","poem":1},{"noteId":22},{"text":"损害。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"瘸子的脚空存无用；","poem":1},{"lineBreak":true},{"text":"箴言在愚昧人的口中也是如此。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"将尊荣给愚昧人的，","poem":1},{"lineBreak":true},{"text":"好像人把石子包在机弦里。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"箴言在愚昧人的口中，","poem":1},{"lineBreak":true},{"text":"好像荆棘刺入醉汉的手。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"雇愚昧人的，与雇过路人的，","poem":1},{"lineBreak":true},{"text":"就像射伤众人的弓箭手。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"愚昧人行愚妄事，行了又行，","poem":1},{"lineBreak":true},{"text":"就如狗转过来吃它所吐的。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你见自以为有智慧的人吗？","poem":1},{"lineBreak":true},{"text":"愚昧人比他更有指望。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"懒惰人说：道上有猛狮，","poem":1},{"lineBreak":true},{"text":"街上有壮狮。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"门在枢纽转动，","poem":1},{"lineBreak":true},{"text":"懒惰人在床上也是如此。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"懒惰人放手在盘子里，","poem":1},{"lineBreak":true},{"text":"就是向口撤回也以为劳乏。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"懒惰人看自己比七个善于应对的人更有智慧。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"过路被事激动，管理不干己的争竞，","poem":1},{"lineBreak":true},{"text":"好像人揪住狗耳。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"人欺凌邻舍，却说：","poem":1},{"lineBreak":true},{"text":"我岂不是戏耍吗？","poem":1},{"lineBreak":true},{"text":"他就像疯狂的人抛掷火把、利箭，","poem":1},{"lineBreak":true},{"text":"与杀人的兵器","poem":1},{"noteId":23},{"text":"。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"火缺了柴就必熄灭；","poem":1},{"lineBreak":true},{"text":"无人传舌，争竞便止息。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"好争竞的人煽惑争端，","poem":1},{"lineBreak":true},{"text":"就如余火加炭，火上加柴一样。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"传舌人的言语，如同美食，","poem":1},{"lineBreak":true},{"text":"深入人的心腹。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"火热的嘴，奸恶的心，","poem":1},{"lineBreak":true},{"text":"好像银渣包的瓦器。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"怨恨人的，用嘴粉饰，","poem":1},{"lineBreak":true},{"text":"心里却藏着诡诈；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他用甜言蜜语，你不可信他，","poem":1},{"lineBreak":true},{"text":"因为他心中有七样可憎恶的。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他虽用诡诈遮掩自己的怨恨，","poem":1},{"lineBreak":true},{"text":"他的邪恶必在会中显露。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"挖陷坑的，自己必掉在其中；","poem":1},{"lineBreak":true},{"text":"滚石头的，石头必反滚在他身上。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"虚谎的舌恨他所压伤的人；","poem":1},{"lineBreak":true},{"text":"谄媚的口败坏人的事。","poem":1}]}],"footnotes":[{"noteId":22,"caller":"-","text":"原文是：喝","reference":{"chapter":26,"verse":6}},{"noteId":23,"caller":"-","text":"-19 原文是死亡","reference":{"chapter":26,"verse":18}}]},"thisChapterLink":"/api/cmn_cu1/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":27}