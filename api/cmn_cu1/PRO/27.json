{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"不要为明日自夸，","poem":1},{"lineBreak":true},{"text":"因为一日要生何事，你尚且不能知道。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要别人夸奖你，不可用口自夸；","poem":1},{"lineBreak":true},{"text":"等外人称赞你，不可用嘴自称。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"石头重，沙土沉，","poem":1},{"lineBreak":true},{"text":"愚妄人的恼怒比这两样更重。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"忿怒为残忍，怒气为狂澜，","poem":1},{"lineBreak":true},{"text":"惟有嫉妒，谁能敌得住呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"当面的责备强如背地的爱情。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"朋友加的伤痕出于忠诚；","poem":1},{"lineBreak":true},{"text":"仇敌连连亲嘴却是多余。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"人吃饱了，厌恶蜂房的蜜；","poem":1},{"lineBreak":true},{"text":"人饥饿了，一切苦物都觉甘甜。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"人离本处飘流，","poem":1},{"lineBreak":true},{"text":"好像雀鸟离窝游飞。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"膏油与香料使人心喜悦；","poem":1},{"lineBreak":true},{"text":"朋友诚实的劝教也是如此甘美。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你的朋友和父亲的朋友，","poem":1},{"lineBreak":true},{"text":"你都不可离弃。","poem":1},{"lineBreak":true},{"text":"你遭难的日子，不要上弟兄的家去；","poem":1},{"lineBreak":true},{"text":"相近的邻舍强如远方的弟兄。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我儿，你要作智慧人，好叫我的心欢喜，","poem":1},{"lineBreak":true},{"text":"使我可以回答那讥诮我的人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"通达人见祸藏躲；","poem":1},{"lineBreak":true},{"text":"愚蒙人前往受害。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"谁为生人作保，就拿谁的衣服；","poem":1},{"lineBreak":true},{"text":"谁为外女作保，谁就承当。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"清晨起来，大声给朋友祝福的，","poem":1},{"lineBreak":true},{"text":"就算是咒诅他。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"大雨之日连连滴漏，","poem":1},{"lineBreak":true},{"text":"和争吵的妇人一样；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"想拦阻她的，便是拦阻风，","poem":1},{"lineBreak":true},{"text":"也是右手抓油。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"铁磨铁，磨出刃来；","poem":1},{"lineBreak":true},{"text":"朋友相感","poem":1},{"noteId":24},{"text":"也是如此。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"看守无花果树的，必吃树上的果子；","poem":1},{"lineBreak":true},{"text":"敬奉主人的，必得尊荣。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"水中照脸，彼此相符；","poem":1},{"lineBreak":true},{"text":"人与人，心也相对。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"阴间和灭亡永不满足；","poem":1},{"lineBreak":true},{"text":"人的眼目也是如此。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"鼎为炼银，炉为炼金，","poem":1},{"lineBreak":true},{"text":"人的称赞也试炼人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你虽用杵将愚妄人与打碎的麦子一同捣在臼中，","poem":1},{"lineBreak":true},{"text":"他的愚妄还是离不了他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"你要详细知道你羊群的景况，","poem":1},{"lineBreak":true},{"text":"留心料理你的牛群；","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"因为资财不能永有，","poem":1},{"lineBreak":true},{"text":"冠冕岂能存到万代？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"干草割去，嫩草发现，","poem":1},{"lineBreak":true},{"text":"山上的菜蔬也被收敛。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"羊羔之毛是为你作衣服；","poem":1},{"lineBreak":true},{"text":"山羊是为作田地的价值，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"并有母山羊奶够你吃，","poem":1},{"lineBreak":true},{"text":"也够你的家眷吃，","poem":1},{"lineBreak":true},{"text":"且够养你的婢女。","poem":1}]}],"footnotes":[{"noteId":24,"caller":"-","text":"原文是磨朋友的脸","reference":{"chapter":27,"verse":17}}]},"thisChapterLink":"/api/cmn_cu1/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}