{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"恶人虽无人追赶也逃跑；","poem":1},{"lineBreak":true},{"text":"义人却胆壮像狮子。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"邦国因有罪过，君王就多更换；","poem":1},{"lineBreak":true},{"text":"因有聪明知识的人，国必长存。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"穷人欺压贫民，","poem":1},{"lineBreak":true},{"text":"好像暴雨冲没粮食。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"违弃律法的，夸奖恶人；","poem":1},{"lineBreak":true},{"text":"遵守律法的，却与恶人相争。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"坏人不明白公义；","poem":1},{"lineBreak":true},{"text":"惟有寻求耶和华的，无不明白。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"行为纯正的穷乏人","poem":1},{"lineBreak":true},{"text":"胜过行事乖僻的富足人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"谨守律法的，是智慧之子；","poem":1},{"lineBreak":true},{"text":"与贪食人作伴的，却羞辱其父。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"人以厚利加增财物，","poem":1},{"lineBreak":true},{"text":"是给那怜悯穷人者积蓄的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"转耳不听律法的，","poem":1},{"lineBreak":true},{"text":"他的祈祷也为可憎。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"诱惑正直人行恶道的，必掉在自己的坑里；","poem":1},{"lineBreak":true},{"text":"惟有完全人必承受福分。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"富足人自以为有智慧，","poem":1},{"lineBreak":true},{"text":"但聪明的贫穷人能将他查透。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"义人得志，有大荣耀；","poem":1},{"lineBreak":true},{"text":"恶人兴起，人就躲藏。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"遮掩自己罪过的，必不亨通；","poem":1},{"lineBreak":true},{"text":"承认离弃罪过的，必蒙怜恤。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"常存敬畏的，便为有福；","poem":1},{"lineBreak":true},{"text":"心存刚硬的，必陷在祸患里。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"暴虐的君王辖制贫民，","poem":1},{"lineBreak":true},{"text":"好像吼叫的狮子、觅食的熊。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"无知的君多行暴虐；","poem":1},{"lineBreak":true},{"text":"以贪财为可恨的，必年长日久。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"背负流人血之罪的，必往坑里奔跑，","poem":1},{"lineBreak":true},{"text":"谁也不可拦阻他。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"行动正直的，必蒙拯救；","poem":1},{"lineBreak":true},{"text":"行事弯曲的，立时跌倒。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耕种自己田地的，必得饱食；","poem":1},{"lineBreak":true},{"text":"追随虚浮的，足受穷乏。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"诚实人必多得福；","poem":1},{"lineBreak":true},{"text":"想要急速发财的，不免受罚。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"看人的情面乃为不好；","poem":1},{"lineBreak":true},{"text":"人因一块饼枉法也为不好。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"人有恶眼想要急速发财，","poem":1},{"lineBreak":true},{"text":"却不知穷乏必临到他身。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"责备人的，后来蒙人喜悦，","poem":1},{"lineBreak":true},{"text":"多于那用舌头谄媚人的。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"偷窃父母的，说：这不是罪，","poem":1},{"lineBreak":true},{"text":"此人就是与强盗同类。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"心中贪婪的，挑起争端；","poem":1},{"lineBreak":true},{"text":"倚靠耶和华的，必得丰裕。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"心中自是的，便是愚昧人；","poem":1},{"lineBreak":true},{"text":"凭智慧行事的，必蒙拯救。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"周济贫穷的，不致缺乏；","poem":1},{"lineBreak":true},{"text":"佯为不见的，必多受咒诅。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"恶人兴起，人就躲藏；","poem":1},{"lineBreak":true},{"text":"恶人败亡，义人增多。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}