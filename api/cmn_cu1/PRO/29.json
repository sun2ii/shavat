{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"人屡次受责罚，仍然硬着颈项；","poem":1},{"lineBreak":true},{"text":"他必顷刻败坏，无法可治。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"义人增多，民就喜乐；","poem":1},{"lineBreak":true},{"text":"恶人掌权，民就叹息。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"爱慕智慧的，使父亲喜乐；","poem":1},{"lineBreak":true},{"text":"与妓女结交的，却浪费钱财。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"王借公平，使国坚定；","poem":1},{"lineBreak":true},{"text":"索要贿赂，使国倾败。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"谄媚邻舍的，","poem":1},{"lineBreak":true},{"text":"就是设网罗绊他的脚。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"恶人犯罪，自陷网罗；","poem":1},{"lineBreak":true},{"text":"惟独义人欢呼喜乐。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"义人知道查明穷人的案；","poem":1},{"lineBreak":true},{"text":"恶人没有聪明，就不得而知。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"亵慢人煽惑通城；","poem":1},{"lineBreak":true},{"text":"智慧人止息众怒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"智慧人与愚妄人相争，","poem":1},{"lineBreak":true},{"text":"或怒或笑，总不能使他止息。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"好流人血的，恨恶完全人，","poem":1},{"lineBreak":true},{"text":"索取正直人的性命。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"愚妄人怒气全发；","poem":1},{"lineBreak":true},{"text":"智慧人忍气含怒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"君王若听谎言，","poem":1},{"lineBreak":true},{"text":"他一切臣仆都是奸恶。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"贫穷人、强暴人在世相遇；","poem":1},{"lineBreak":true},{"text":"他们的眼目都蒙耶和华光照。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"君王凭诚实判断穷人；","poem":1},{"lineBreak":true},{"text":"他的国位必永远坚立。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"杖打和责备能加增智慧；","poem":1},{"lineBreak":true},{"text":"放纵的儿子使母亲羞愧。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"恶人加多，过犯也加多，","poem":1},{"lineBreak":true},{"text":"义人必看见他们跌倒。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"管教你的儿子，他就使你得安息，","poem":1},{"lineBreak":true},{"text":"也必使你心里喜乐。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"没有异象","poem":1},{"noteId":25},{"text":"，民就放肆；","poem":1},{"lineBreak":true},{"text":"惟遵守律法的，便为有福。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"只用言语，仆人不肯受管教；","poem":1},{"lineBreak":true},{"text":"他虽然明白，也不留意。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你见言语急躁的人吗？","poem":1},{"lineBreak":true},{"text":"愚昧人比他更有指望。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"人将仆人从小娇养，","poem":1},{"lineBreak":true},{"text":"这仆人终久必成了他的儿子。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"好气的人挑启争端；","poem":1},{"lineBreak":true},{"text":"暴怒的人多多犯罪。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"人的高傲必使他卑下；","poem":1},{"lineBreak":true},{"text":"心里谦逊的，必得尊荣。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"人与盗贼分赃，是恨恶自己的性命；","poem":1},{"lineBreak":true},{"text":"他听见叫人发誓的声音，却不言语。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"惧怕人的，陷入网罗；","poem":1},{"lineBreak":true},{"text":"惟有倚靠耶和华的，必得安稳。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"求王恩的人多；","poem":1},{"lineBreak":true},{"text":"定人事乃在耶和华。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"为非作歹的，被义人憎嫌；","poem":1},{"lineBreak":true},{"text":"行事正直的，被恶人憎恶。","poem":1}]}],"footnotes":[{"noteId":25,"caller":"-","text":"或译：默示","reference":{"chapter":29,"verse":18}}]},"thisChapterLink":"/api/cmn_cu1/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}