{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":3,"content":[{"type":"heading","content":["给青年人的忠告"]},{"type":"verse","number":1,"content":[{"text":"我儿，不要忘记我的法则","poem":1},{"noteId":2},{"text":"；","poem":1},{"lineBreak":true},{"text":"你心要谨守我的诫命；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为它必将长久的日子，","poem":1},{"lineBreak":true},{"text":"生命的年数与平安，加给你。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"不可使慈爱、诚实离开你，","poem":1},{"lineBreak":true},{"text":"要系在你颈项上，刻在你心版上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"这样，你必在 神和世人眼前","poem":1},{"lineBreak":true},{"text":"蒙恩宠，有聪明。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你要专心仰赖耶和华，","poem":1},{"lineBreak":true},{"text":"不可倚靠自己的聪明，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"在你一切所行的事上都要认定他，","poem":1},{"lineBreak":true},{"text":"他必指引你的路。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"不要自以为有智慧；","poem":1},{"lineBreak":true},{"text":"要敬畏耶和华，远离恶事。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"这便医治你的肚脐，","poem":1},{"lineBreak":true},{"text":"滋润你的百骨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"你要以财物","poem":1},{"lineBreak":true},{"text":"和一切初熟的土产尊荣耶和华。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"这样，你的仓房必充满有余；","poem":1},{"lineBreak":true},{"text":"你的酒榨有新酒盈溢。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我儿，你不可轻看耶和华的管教","poem":1},{"noteId":3},{"text":"，","poem":1},{"lineBreak":true},{"text":"也不可厌烦他的责备；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因为耶和华所爱的，他必责备，","poem":1},{"lineBreak":true},{"text":"正如父亲责备所喜爱的儿子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"得智慧，得聪明的，","poem":1},{"lineBreak":true},{"text":"这人便为有福。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因为得智慧胜过得银子，","poem":1},{"lineBreak":true},{"text":"其利益强如精金，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"比珍珠","poem":1},{"noteId":4},{"text":"宝贵；","poem":1},{"lineBreak":true},{"text":"你一切所喜爱的，都不足与比较。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"她右手有长寿，","poem":1},{"lineBreak":true},{"text":"左手有富贵。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"她的道是安乐；","poem":1},{"lineBreak":true},{"text":"她的路全是平安。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"她与持守她的作生命树；","poem":1},{"lineBreak":true},{"text":"持定她的，俱各有福。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和华以智慧立地，","poem":1},{"lineBreak":true},{"text":"以聪明定天，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"以知识使深渊裂开，","poem":1},{"lineBreak":true},{"text":"使天空滴下甘露。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"我儿，要谨守真智慧和谋略，","poem":1},{"lineBreak":true},{"text":"不可使她离开你的眼目。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"这样，她必作你的生命，","poem":1},{"lineBreak":true},{"text":"颈项的美饰。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你就坦然行路，","poem":1},{"lineBreak":true},{"text":"不致碰脚。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你躺下，必不惧怕；","poem":1},{"lineBreak":true},{"text":"你躺卧，睡得香甜。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"忽然来的惊恐，不要害怕；","poem":1},{"lineBreak":true},{"text":"恶人遭毁灭，也不要恐惧。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因为耶和华是你所倚靠的；","poem":1},{"lineBreak":true},{"text":"他必保守你的脚不陷入网罗。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"你手若有行善的力量，不可推辞，","poem":1},{"lineBreak":true},{"text":"就当向那应得的人施行。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你那里若有现成的，不可对邻舍说：","poem":1},{"lineBreak":true},{"text":"去吧，明天再来，我必给你。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你的邻舍既在你附近安居，","poem":1},{"lineBreak":true},{"text":"你不可设计害他。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"人未曾加害与你，","poem":1},{"lineBreak":true},{"text":"不可无故与他相争。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"不可嫉妒强暴的人，","poem":1},{"lineBreak":true},{"text":"也不可选择他所行的路。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"因为，乖僻人为耶和华所憎恶；","poem":1},{"lineBreak":true},{"text":"正直人为他所亲密。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"耶和华咒诅恶人的家庭，","poem":1},{"lineBreak":true},{"text":"赐福与义人的居所。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"他讥诮那好讥诮的人，","poem":1},{"lineBreak":true},{"text":"赐恩给谦卑的人。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"智慧人必承受尊荣；","poem":1},{"lineBreak":true},{"text":"愚昧人高升也成为羞辱。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"-","text":"或译：指教","reference":{"chapter":3,"verse":1}},{"noteId":3,"caller":"-","text":"或译：惩治","reference":{"chapter":3,"verse":11}},{"noteId":4,"caller":"-","text":"或译：红宝石","reference":{"chapter":3,"verse":15}}]},"thisChapterLink":"/api/cmn_cu1/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}