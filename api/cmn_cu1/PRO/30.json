{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":30,"content":[{"type":"heading","content":["亚古珥语录"]},{"type":"verse","number":1,"content":[{"text":"雅基的儿子亚古珥的言语就是真言。","poem":1},{"lineBreak":true},{"text":"这人对以铁和乌甲说：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我比众人更蠢笨，","poem":1},{"lineBreak":true},{"text":"也没有人的聪明。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我没有学好智慧，","poem":1},{"lineBreak":true},{"text":"也不认识至圣者。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"谁升天又降下来？","poem":1},{"lineBreak":true},{"text":"谁聚风在掌握中？","poem":1},{"lineBreak":true},{"text":"谁包水在衣服里？","poem":1},{"lineBreak":true},{"text":"谁立定地的四极？","poem":1},{"lineBreak":true},{"text":"他名叫什么？","poem":1},{"lineBreak":true},{"text":"他儿子名叫什么？","poem":1},{"lineBreak":true},{"text":"你知道吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"神的言语句句都是炼净的；","poem":1},{"lineBreak":true},{"text":"投靠他的，他便作他们的盾牌。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他的言语，你不可加添，","poem":1},{"lineBreak":true},{"text":"恐怕他责备你，你就显为说谎言的。","poem":1}]},{"type":"heading","content":["其他箴言"]},{"type":"verse","number":7,"content":[{"text":"我求你两件事，","poem":1},{"lineBreak":true},{"text":"在我未死之先，不要不赐给我：","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你使虚假和谎言远离我；","poem":1},{"lineBreak":true},{"text":"使我也不贫穷也不富足；","poem":1},{"lineBreak":true},{"text":"赐给我需用的饮食，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"恐怕我饱足不认你，说：","poem":1},{"lineBreak":true},{"text":"耶和华是谁呢？","poem":1},{"lineBreak":true},{"text":"又恐怕我贫穷就偷窃，","poem":1},{"lineBreak":true},{"text":"以致亵渎我 神的名。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你不要向主人谗谤仆人，","poem":1},{"lineBreak":true},{"text":"恐怕他咒诅你，你便算为有罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"有一宗人","poem":1},{"noteId":26},{"text":"，咒诅父亲，","poem":1},{"lineBreak":true},{"text":"不给母亲祝福。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"有一宗人，自以为清洁，","poem":1},{"lineBreak":true},{"text":"却没有洗去自己的污秽。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"有一宗人，眼目何其高傲，","poem":1},{"lineBreak":true},{"text":"眼皮也是高举。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"有一宗人，牙如剑，齿如刀，","poem":1},{"lineBreak":true},{"text":"要吞灭地上的困苦人和世间的穷乏人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"蚂蟥有两个女儿，","poem":1},{"lineBreak":true},{"text":"常说：给呀，给呀！","poem":1},{"lineBreak":true},{"text":"有三样不知足的，","poem":1},{"lineBreak":true},{"text":"连不说「够的」共有四样：","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"就是阴间和石胎，","poem":1},{"lineBreak":true},{"text":"浸水不足的地，并火。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"戏笑父亲、藐视而不听从母亲的，","poem":1},{"lineBreak":true},{"text":"他的眼睛必为谷中的乌鸦啄出来，为鹰雏所吃。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"我所测不透的奇妙有三样，","poem":1},{"lineBreak":true},{"text":"连我所不知道的共有四样：","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"就是鹰在空中飞的道；","poem":1},{"lineBreak":true},{"text":"蛇在磐石上爬的道；","poem":1},{"lineBreak":true},{"text":"船在海中行的道；","poem":1},{"lineBreak":true},{"text":"男与女交合的道。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"淫妇的道也是这样：","poem":1},{"lineBreak":true},{"text":"她吃了，把嘴一擦就说：","poem":1},{"lineBreak":true},{"text":"我没有行恶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"使地震动的有三样，","poem":1},{"lineBreak":true},{"text":"连地担不起的共有四样：","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"就是仆人作王；","poem":1},{"lineBreak":true},{"text":"愚顽人吃饱；","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"丑恶的女子出嫁；","poem":1},{"lineBreak":true},{"text":"婢女接续主母。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"地上有四样小物，却甚聪明：","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"蚂蚁是无力之类，","poem":1},{"lineBreak":true},{"text":"却在夏天预备粮食。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"沙番是软弱之类，","poem":1},{"lineBreak":true},{"text":"却在磐石中造房。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"蝗虫没有君王，","poem":1},{"lineBreak":true},{"text":"却分队而出。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"守宫用爪抓墙，","poem":1},{"lineBreak":true},{"text":"却住在王宫。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"步行威武的有三样，","poem":1},{"lineBreak":true},{"text":"连行走威武的共有四样：","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"就是狮子—乃百兽中最为猛烈、无所躲避的，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"猎狗，公山羊，和无人能敌的君王。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"你若行事愚顽，自高自傲，","poem":1},{"lineBreak":true},{"text":"或是怀了恶念，就当用手捂口。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"摇牛奶必成奶油；","poem":1},{"lineBreak":true},{"text":"扭鼻子必出血。","poem":1},{"lineBreak":true},{"text":"照样，激动怒气必起争端。","poem":1}]}],"footnotes":[{"noteId":26,"caller":"-","text":"宗：原文是代；下同","reference":{"chapter":30,"verse":11}}]},"thisChapterLink":"/api/cmn_cu1/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}