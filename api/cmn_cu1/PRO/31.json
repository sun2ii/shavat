{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":31,"content":[{"type":"heading","content":["给一君王的忠告"]},{"type":"verse","number":1,"content":[{"text":"利慕伊勒王的言语，是他母亲教训他的真言。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的儿啊，我腹中生的儿啊，","poem":1},{"lineBreak":true},{"text":"我许愿得的儿啊！我当怎样教训你呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"不要将你的精力给妇女；","poem":1},{"lineBreak":true},{"text":"也不要有败坏君王的行为。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"利慕伊勒啊，君王喝酒，君王喝酒不相宜；","poem":1},{"lineBreak":true},{"text":"王子说浓酒在那里也不相宜；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"恐怕喝了就忘记律例，","poem":1},{"lineBreak":true},{"text":"颠倒一切困苦人的是非。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"可以把浓酒给将亡的人喝，","poem":1},{"lineBreak":true},{"text":"把清酒给苦心的人喝，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"让他喝了，就忘记他的贫穷，","poem":1},{"lineBreak":true},{"text":"不再记念他的苦楚。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你当为哑巴","poem":1},{"noteId":27},{"text":"开口，","poem":1},{"lineBreak":true},{"text":"为一切孤独的伸冤。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你当开口按公义判断，","poem":1},{"lineBreak":true},{"text":"为困苦和穷乏的辨屈。","poem":1}]},{"type":"heading","content":["论贤妻"]},{"type":"verse","number":10,"content":[{"text":"才德的妇人谁能得着呢？","poem":1},{"lineBreak":true},{"text":"她的价值远胜过珍珠。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"她丈夫心里倚靠她，","poem":1},{"lineBreak":true},{"text":"必不缺少利益；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"她一生使丈夫有益无损。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"她寻找羊绒和麻，","poem":1},{"lineBreak":true},{"text":"甘心用手做工。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"她好像商船从远方运粮来，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"未到黎明她就起来，","poem":1},{"lineBreak":true},{"text":"把食物分给家中的人，","poem":1},{"lineBreak":true},{"text":"将当做的工分派婢女。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"她想得田地就买来；","poem":1},{"lineBreak":true},{"text":"用手所得之利栽种葡萄园。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"她以能力束腰，","poem":1},{"lineBreak":true},{"text":"使膀臂有力。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"她觉得所经营的有利；","poem":1},{"lineBreak":true},{"text":"她的灯终夜不灭。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"她手拿捻线竿，","poem":1},{"lineBreak":true},{"text":"手把纺线车。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"她张手周济困苦人，","poem":1},{"lineBreak":true},{"text":"伸手帮补穷乏人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"她不因下雪为家里的人担心，","poem":1},{"lineBreak":true},{"text":"因为全家都穿着朱红衣服。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"她为自己制作绣花毯子；","poem":1},{"lineBreak":true},{"text":"她的衣服是细麻和紫色布做的。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"她丈夫在城门口与本地的长老同坐，","poem":1},{"lineBreak":true},{"text":"为众人所认识。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"她做细麻布衣裳出卖，","poem":1},{"lineBreak":true},{"text":"又将腰带卖与商家。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"能力和威仪是她的衣服；","poem":1},{"lineBreak":true},{"text":"她想到日后的景况就喜笑。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"她开口就发智慧；","poem":1},{"lineBreak":true},{"text":"她舌上有仁慈的法则。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"她观察家务，","poem":1},{"lineBreak":true},{"text":"并不吃闲饭。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"她的儿女起来称她有福；","poem":1},{"lineBreak":true},{"text":"她的丈夫也称赞她，","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"说：才德的女子很多，","poem":1},{"lineBreak":true},{"text":"惟独你超过一切。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"艳丽是虚假的，美容是虚浮的；","poem":1},{"lineBreak":true},{"text":"惟敬畏耶和华的妇女必得称赞。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"愿她享受操作所得的；","poem":1},{"lineBreak":true},{"text":"愿她的工作在城门口荣耀她。","poem":1}]}],"footnotes":[{"noteId":27,"caller":"-","text":"或译：不能自辩的","reference":{"chapter":31,"verse":8}}]},"thisChapterLink":"/api/cmn_cu1/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}