{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":4,"content":[{"type":"heading","content":["智慧的益处"]},{"type":"verse","number":1,"content":[{"text":"众子啊，要听父亲的教训，","poem":1},{"lineBreak":true},{"text":"留心得知聪明。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因我所给你们的是好教训；","poem":1},{"lineBreak":true},{"text":"不可离弃我的法则","poem":1},{"noteId":5},{"text":"。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我在父亲面前为孝子，","poem":1},{"lineBreak":true},{"text":"在母亲眼中为独一的娇儿。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"父亲教训我说：你心要存记我的言语，","poem":1},{"lineBreak":true},{"text":"遵守我的命令，便得存活。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要得智慧，要得聪明，不可忘记，","poem":1},{"lineBreak":true},{"text":"也不可偏离我口中的言语。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"不可离弃智慧，智慧就护卫你；","poem":1},{"lineBreak":true},{"text":"要爱她，她就保守你。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"智慧为首；","poem":1},{"lineBreak":true},{"text":"所以，要得智慧。","poem":1},{"lineBreak":true},{"text":"在你一切所得之内必得聪明","poem":1},{"noteId":6},{"text":"。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"高举智慧，她就使你高升；","poem":1},{"lineBreak":true},{"text":"怀抱智慧，她就使你尊荣。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"她必将华冠加在你头上，","poem":1},{"lineBreak":true},{"text":"把荣冕交给你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"我儿，你要听受我的言语，","poem":1},{"lineBreak":true},{"text":"就必延年益寿。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我已指教你走智慧的道，","poem":1},{"lineBreak":true},{"text":"引导你行正直的路。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你行走，脚步必不致狭窄；","poem":1},{"lineBreak":true},{"text":"你奔跑，也不致跌倒。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"要持定训诲，不可放松；","poem":1},{"lineBreak":true},{"text":"必当谨守，因为它是你的生命。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"不可行恶人的路；","poem":1},{"lineBreak":true},{"text":"不要走坏人的道。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"要躲避，不可经过；","poem":1},{"lineBreak":true},{"text":"要转身而去。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"这等人若不行恶，不得睡觉；","poem":1},{"lineBreak":true},{"text":"不使人跌倒，睡卧不安；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因为他们以奸恶吃饼，","poem":1},{"lineBreak":true},{"text":"以强暴喝酒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"但义人的路好像黎明的光，","poem":1},{"lineBreak":true},{"text":"越照越明，直到日午。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"恶人的道好像幽暗，","poem":1},{"lineBreak":true},{"text":"自己不知因什么跌倒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"我儿，要留心听我的言词，","poem":1},{"lineBreak":true},{"text":"侧耳听我的话语，","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"都不可离你的眼目，","poem":1},{"lineBreak":true},{"text":"要存记在你心中。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为得着它的，就得了生命，","poem":1},{"lineBreak":true},{"text":"又得了医全体的良药。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你要保守你心，胜过保守一切","poem":1},{"noteId":7},{"text":"，","poem":1},{"lineBreak":true},{"text":"因为一生的果效是由心发出。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你要除掉邪僻的口，","poem":1},{"lineBreak":true},{"text":"弃绝乖谬的嘴。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你的眼目要向前正看；","poem":1},{"lineBreak":true},{"text":"你的眼睛","poem":1},{"noteId":8},{"text":"当向前直观。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"要修平你脚下的路，","poem":1},{"lineBreak":true},{"text":"坚定你一切的道。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"不可偏向左右；","poem":1},{"lineBreak":true},{"text":"要使你的脚离开邪恶。","poem":1}]}],"footnotes":[{"noteId":5,"caller":"-","text":"或译：指教","reference":{"chapter":4,"verse":2}},{"noteId":6,"caller":"-","text":"或译：用你一切所得的去换聪明","reference":{"chapter":4,"verse":7}},{"noteId":7,"caller":"-","text":"或译：你要切切保守你心","reference":{"chapter":4,"verse":23}},{"noteId":8,"caller":"-","text":"原文是皮","reference":{"chapter":4,"verse":25}}]},"thisChapterLink":"/api/cmn_cu1/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}