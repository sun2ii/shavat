{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":5,"content":[{"type":"heading","content":["警告勿犯淫乱"]},{"type":"verse","number":1,"content":[{"text":"我儿，要留心我智慧的话语，","poem":1},{"lineBreak":true},{"text":"侧耳听我聪明的言词，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"为要使你谨守谋略，","poem":1},{"lineBreak":true},{"text":"嘴唇保存知识。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为淫妇的嘴滴下蜂蜜；","poem":1},{"lineBreak":true},{"text":"她的口比油更滑，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"至终却苦似茵 ，","poem":1},{"lineBreak":true},{"text":"快如两刃的刀。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"她的脚下入死地；","poem":1},{"lineBreak":true},{"text":"她脚步踏住阴间，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"以致她找不着生命平坦的道。","poem":1},{"lineBreak":true},{"text":"她的路变迁不定，","poem":1},{"lineBreak":true},{"text":"自己还不知道。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"众子啊，现在要听从我；","poem":1},{"lineBreak":true},{"text":"不可离弃我口中的话。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你所行的道要离她远，","poem":1},{"lineBreak":true},{"text":"不可就近她的房门，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"恐怕将你的尊荣给别人，","poem":1},{"lineBreak":true},{"text":"将你的岁月给残忍的人；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"恐怕外人满得你的力量，","poem":1},{"lineBreak":true},{"text":"你劳碌得来的，归入外人的家；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"终久，你皮肉和身体消毁，","poem":1},{"lineBreak":true},{"text":"你就悲叹，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"说：我怎么恨恶训诲，","poem":1},{"lineBreak":true},{"text":"心中藐视责备，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"也不听从我师傅的话，","poem":1},{"lineBreak":true},{"text":"又不侧耳听那教训我的人？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我在圣会里，","poem":1},{"lineBreak":true},{"text":"几乎落在诸般恶中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"你要喝自己池中的水，","poem":1},{"lineBreak":true},{"text":"饮自己井里的活水。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你的泉源岂可涨溢在外？","poem":1},{"lineBreak":true},{"text":"你的河水岂可流在街上？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"惟独归你一人，","poem":1},{"lineBreak":true},{"text":"不可与外人同用。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"要使你的泉源蒙福；","poem":1},{"lineBreak":true},{"text":"要喜悦你幼年所娶的妻。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"她如可爱的麀鹿，可喜的母鹿；","poem":1},{"lineBreak":true},{"text":"愿她的胸怀使你时时知足，","poem":1},{"lineBreak":true},{"text":"她的爱情使你常常恋慕。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我儿，你为何恋慕淫妇？","poem":1},{"lineBreak":true},{"text":"为何抱外女的胸怀？","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"因为，人所行的道都在耶和华眼前；","poem":1},{"lineBreak":true},{"text":"他也修平人一切的路。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"恶人必被自己的罪孽捉住；","poem":1},{"lineBreak":true},{"text":"他必被自己的罪恶如绳索缠绕。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他因不受训诲就必死亡；","poem":1},{"lineBreak":true},{"text":"又因愚昧过甚，必走差了路。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}