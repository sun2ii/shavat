{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":6,"content":[{"type":"heading","content":["更多的警告"]},{"type":"verse","number":1,"content":[{"text":"我儿，你若为朋友作保，","poem":1},{"lineBreak":true},{"text":"替外人击掌，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你就被口中的话语缠住，","poem":1},{"lineBreak":true},{"text":"被嘴里的言语捉住。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我儿，你既落在朋友手中，","poem":1},{"lineBreak":true},{"text":"就当这样行才可救自己：","poem":1},{"lineBreak":true},{"text":"你要自卑，去恳求你的朋友。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"不要容你的眼睛睡觉；","poem":1},{"lineBreak":true},{"text":"不要容你的眼皮打盹。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要救自己，如鹿脱离猎户的手，","poem":1},{"lineBreak":true},{"text":"如鸟脱离捕鸟人的手。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"懒惰人哪，","poem":1},{"lineBreak":true},{"text":"你去察看蚂蚁的动作就可得智慧。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"蚂蚁没有元帅，","poem":1},{"lineBreak":true},{"text":"没有官长，没有君王，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"尚且在夏天预备食物，","poem":1},{"lineBreak":true},{"text":"在收割时聚敛粮食。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"懒惰人哪，你要睡到几时呢？","poem":1},{"lineBreak":true},{"text":"你何时睡醒呢？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"再睡片时，打盹片时，","poem":1},{"lineBreak":true},{"text":"抱着手躺卧片时，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你的贫穷就必如强盗速来，","poem":1},{"lineBreak":true},{"text":"你的缺乏仿佛拿兵器的人来到。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"无赖的恶徒，","poem":1},{"lineBreak":true},{"text":"行动就用乖僻的口，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"用眼传神，","poem":1},{"lineBreak":true},{"text":"用脚示意，","poem":1},{"lineBreak":true},{"text":"用指点划，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"心中乖僻，","poem":1},{"lineBreak":true},{"text":"常设恶谋，","poem":1},{"lineBreak":true},{"text":"布散纷争。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"所以，灾难必忽然临到他身；","poem":1},{"lineBreak":true},{"text":"他必顷刻败坏，无法可治。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和华所恨恶的有六样，","poem":1},{"lineBreak":true},{"text":"连他心所憎恶的共有七样：","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"就是高傲的眼，","poem":1},{"lineBreak":true},{"text":"撒谎的舌，","poem":1},{"lineBreak":true},{"text":"流无辜人血的手，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"图谋恶计的心，","poem":1},{"lineBreak":true},{"text":"飞跑行恶的脚，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"吐谎言的假见证，","poem":1},{"lineBreak":true},{"text":"并弟兄中布散纷争的人。","poem":1}]},{"type":"heading","content":["警告勿犯淫乱"]},{"type":"verse","number":20,"content":[{"text":"我儿，要谨守你父亲的诫命；","poem":1},{"lineBreak":true},{"text":"不可离弃你母亲的法则","poem":1},{"noteId":9},{"text":"，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"要常系在你心上，","poem":1},{"lineBreak":true},{"text":"挂在你项上。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你行走，它必引导你；","poem":1},{"lineBreak":true},{"text":"你躺卧，它必保守你；","poem":1},{"lineBreak":true},{"text":"你睡醒，它必与你谈论。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"因为诫命是灯，法则","poem":1},{"noteId":10},{"text":"是光，","poem":1},{"lineBreak":true},{"text":"训诲的责备是生命的道，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"能保你远离恶妇，","poem":1},{"lineBreak":true},{"text":"远离外女谄媚的舌头。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你心中不要恋慕她的美色，","poem":1},{"lineBreak":true},{"text":"也不要被她眼皮勾引。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因为，妓女能使人只剩一块饼；","poem":1},{"lineBreak":true},{"text":"淫妇猎取人宝贵的生命。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"人若怀里搋火，","poem":1},{"lineBreak":true},{"text":"衣服岂能不烧呢？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"人若在火炭上走，","poem":1},{"lineBreak":true},{"text":"脚岂能不烫呢？","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"亲近邻舍之妻的，也是如此；","poem":1},{"lineBreak":true},{"text":"凡挨近她的，不免受罚。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"贼因饥饿偷窃充饥，","poem":1},{"lineBreak":true},{"text":"人不藐视他，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"若被找着，他必赔还七倍，","poem":1},{"lineBreak":true},{"text":"必将家中所有的尽都偿还。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"与妇人行淫的，便是无知；","poem":1},{"lineBreak":true},{"text":"行这事的，必丧掉生命。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他必受伤损，必被凌辱；","poem":1},{"lineBreak":true},{"text":"他的羞耻不得涂抹。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"因为人的嫉恨成了烈怒，","poem":1},{"lineBreak":true},{"text":"报仇的时候决不留情。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"什么赎价，他都不顾；","poem":1},{"lineBreak":true},{"text":"你虽送许多礼物，他也不肯干休。","poem":1}]}],"footnotes":[{"noteId":9,"caller":"-","text":"或译：指教","reference":{"chapter":6,"verse":20}},{"noteId":10,"caller":"-","text":"或译：指教","reference":{"chapter":6,"verse":23}}]},"thisChapterLink":"/api/cmn_cu1/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}