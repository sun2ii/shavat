{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"我儿，你要遵守我的言语，","poem":1},{"lineBreak":true},{"text":"将我的命令存记在心。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"遵守我的命令就得存活；","poem":1},{"lineBreak":true},{"text":"保守我的法则","poem":1},{"noteId":11},{"text":"，","poem":1},{"lineBreak":true},{"text":"好像保守眼中的瞳人，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"系在你指头上，","poem":1},{"lineBreak":true},{"text":"刻在你心版上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"对智慧说：你是我的姊妹，","poem":1},{"lineBreak":true},{"text":"称呼聪明为你的亲人，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"她就保你远离淫妇，","poem":1},{"lineBreak":true},{"text":"远离说谄媚话的外女。","poem":1}]},{"type":"heading","content":["淫乱的妇人"]},{"type":"verse","number":6,"content":[{"text":"我曾在我房屋的窗户内，","poem":1},{"lineBreak":true},{"text":"从我窗棂之间往外观看：","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"见愚蒙人内，少年人中，","poem":1},{"lineBreak":true},{"text":"分明有一个无知的少年人，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"从街上经过，走近淫妇的巷口，","poem":1},{"lineBreak":true},{"text":"直往通她家的路去，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"在黄昏，或晚上，","poem":1},{"lineBreak":true},{"text":"或半夜，或黑暗之中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"看哪，有一个妇人来迎接他，","poem":1},{"lineBreak":true},{"text":"是妓女的打扮，有诡诈的心思。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"这妇人喧嚷，不守约束，","poem":1},{"lineBreak":true},{"text":"在家里停不住脚，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"有时在街市上，有时在宽阔处，","poem":1},{"lineBreak":true},{"text":"或在各巷口蹲伏，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"拉住那少年人，与他亲嘴，","poem":1},{"lineBreak":true},{"text":"脸无羞耻对他说：","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"平安祭在我这里，","poem":1},{"lineBreak":true},{"text":"今日才还了我所许的愿。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因此，我出来迎接你，","poem":1},{"lineBreak":true},{"text":"恳切求见你的面，恰巧遇见了你。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我已经用绣花毯子","poem":1},{"lineBreak":true},{"text":"和埃及线织的花纹布铺了我的床。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我又用没药、沉香、桂皮","poem":1},{"lineBreak":true},{"text":"薰了我的榻。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你来，我们可以饱享爱情，直到早晨；","poem":1},{"lineBreak":true},{"text":"我们可以彼此亲爱欢乐。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"因为我丈夫不在家，出门行远路；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他手拿银囊，必到月望才回家。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"淫妇用许多巧言诱他随从，","poem":1},{"lineBreak":true},{"text":"用谄媚的嘴逼他同行。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"少年人立刻跟随她，好像牛往宰杀之地；","poem":1},{"lineBreak":true},{"text":"又像愚昧人带锁链去受刑罚，","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"直等箭穿他的肝；","poem":1},{"lineBreak":true},{"text":"如同雀鸟急入网罗，却不知是自丧己命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"众子啊，现在要听从我，","poem":1},{"lineBreak":true},{"text":"留心听我口中的话。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你的心不可偏向淫妇的道，","poem":1},{"lineBreak":true},{"text":"不要入她的迷途。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因为，被她伤害仆倒的不少；","poem":1},{"lineBreak":true},{"text":"被她杀戮的而且甚多。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"她的家是在阴间之路，","poem":1},{"lineBreak":true},{"text":"下到死亡之宫。","poem":1}]}],"footnotes":[{"noteId":11,"caller":"-","text":"或译：指教","reference":{"chapter":7,"verse":2}}]},"thisChapterLink":"/api/cmn_cu1/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}