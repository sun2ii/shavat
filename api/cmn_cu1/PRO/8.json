{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":8,"content":[{"type":"heading","content":["智慧颂"]},{"type":"verse","number":1,"content":[{"text":"智慧岂不呼叫？","poem":1},{"lineBreak":true},{"text":"聪明岂不发声？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"她在道旁高处的顶上，","poem":1},{"lineBreak":true},{"text":"在十字路口站立，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"在城门旁，在城门口，","poem":1},{"lineBreak":true},{"text":"在城门洞，大声说：","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"众人哪，我呼叫你们，","poem":1},{"lineBreak":true},{"text":"我向世人发声。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"说：愚蒙人哪，你们要会悟灵明；","poem":1},{"lineBreak":true},{"text":"愚昧人哪，你们当心里明白。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你们当听，因我要说极美的话；","poem":1},{"lineBreak":true},{"text":"我张嘴要论正直的事。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的口要发出真理；","poem":1},{"lineBreak":true},{"text":"我的嘴憎恶邪恶。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我口中的言语都是公义，","poem":1},{"lineBreak":true},{"text":"并无弯曲乖僻。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"有聪明的，以为明显，","poem":1},{"lineBreak":true},{"text":"得知识的，以为正直。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你们当受我的教训，不受白银；","poem":1},{"lineBreak":true},{"text":"宁得知识，胜过黄金。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"因为智慧比珍珠","poem":1},{"noteId":12},{"text":"更美；","poem":1},{"lineBreak":true},{"text":"一切可喜爱的都不足与比较。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我—智慧以灵明为居所，","poem":1},{"lineBreak":true},{"text":"又寻得知识和谋略。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"敬畏耶和华在乎恨恶邪恶；","poem":1},{"lineBreak":true},{"text":"那骄傲、狂妄，并恶道，","poem":1},{"lineBreak":true},{"text":"以及乖谬的口，都为我所恨恶。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我有谋略和真知识；","poem":1},{"lineBreak":true},{"text":"我乃聪明，我有能力。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"帝王借我坐国位；","poem":1},{"lineBreak":true},{"text":"君王借我定公平。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"王子和首领，","poem":1},{"lineBreak":true},{"text":"世上一切的审判官，都是借我掌权。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"爱我的，我也爱他；","poem":1},{"lineBreak":true},{"text":"恳切寻求我的，必寻得见。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"丰富尊荣在我；","poem":1},{"lineBreak":true},{"text":"恒久的财并公义也在我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的果实胜过黄金，强如精金；","poem":1},{"lineBreak":true},{"text":"我的出产超乎高银。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我在公义的道上走，","poem":1},{"lineBreak":true},{"text":"在公平的路中行，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"使爱我的，承受货财，","poem":1},{"lineBreak":true},{"text":"并充满他们的府库。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"在耶和华造化的起头，","poem":1},{"lineBreak":true},{"text":"在太初创造万物之先，就有了我。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"从亘古，从太初，","poem":1},{"lineBreak":true},{"text":"未有世界以前，我已被立。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"没有深渊，","poem":1},{"lineBreak":true},{"text":"没有大水的泉源，我已生出。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"大山未曾奠定，","poem":1},{"lineBreak":true},{"text":"小山未有之先，我已生出。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"耶和华还没有创造大地和田野，","poem":1},{"lineBreak":true},{"text":"并世上的土质，我已生出。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他立高天，我在那里；","poem":1},{"lineBreak":true},{"text":"他在渊面的周围，划出圆圈。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"上使穹苍坚硬，","poem":1},{"lineBreak":true},{"text":"下使渊源稳固，","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"为沧海定出界限，使水不越过他的命令，","poem":1},{"lineBreak":true},{"text":"立定大地的根基。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"那时，我在他那里为工师，","poem":1},{"lineBreak":true},{"text":"日日为他所喜爱，","poem":1},{"lineBreak":true},{"text":"常常在他面前踊跃，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"踊跃在他为人预备可住之地，","poem":1},{"lineBreak":true},{"text":"也喜悦住在世人之间。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"众子啊，现在要听从我，","poem":1},{"lineBreak":true},{"text":"因为谨守我道的，便为有福。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"要听教训就得智慧，","poem":1},{"lineBreak":true},{"text":"不可弃绝。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"听从我、日日在我门口仰望、","poem":1},{"lineBreak":true},{"text":"在我门框旁边等候的，那人便为有福。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"因为寻得我的，就寻得生命，","poem":1},{"lineBreak":true},{"text":"也必蒙耶和华的恩惠。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"得罪我的，却害了自己的性命；","poem":1},{"lineBreak":true},{"text":"恨恶我的，都喜爱死亡。","poem":1}]}],"footnotes":[{"noteId":12,"caller":"-","text":"或译：红宝石","reference":{"chapter":8,"verse":11}}]},"thisChapterLink":"/api/cmn_cu1/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}