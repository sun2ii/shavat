{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cu1","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"d9c66442d1cd53abbbbb91640fdfa336d79e9fab8ab433514b7bb79131fc512b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cu1/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":9,"content":[{"type":"heading","content":["智慧和愚蠢"]},{"type":"verse","number":1,"content":[{"text":"智慧建造房屋，","poem":1},{"lineBreak":true},{"text":"凿成七根柱子，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"宰杀牲畜，","poem":1},{"lineBreak":true},{"text":"调和旨酒，","poem":1},{"lineBreak":true},{"text":"设摆筵席；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"打发使女出去，","poem":1},{"lineBreak":true},{"text":"自己在城中至高处呼叫，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"说：谁是愚蒙人，可以转到这里来！","poem":1},{"lineBreak":true},{"text":"又对那无知的人说：","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你们来，吃我的饼，","poem":1},{"lineBreak":true},{"text":"喝我调和的酒。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你们愚蒙人，要舍弃愚蒙，","poem":1},{"lineBreak":true},{"text":"就得存活，并要走光明的道。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"指斥亵慢人的，必受辱骂；","poem":1},{"lineBreak":true},{"text":"责备恶人的，必被玷污。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"不要责备亵慢人，恐怕他恨你；","poem":1},{"lineBreak":true},{"text":"要责备智慧人，他必爱你。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"教导智慧人，他就越发有智慧；","poem":1},{"lineBreak":true},{"text":"指示义人，他就增长学问。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"敬畏耶和华是智慧的开端；","poem":1},{"lineBreak":true},{"text":"认识至圣者便是聪明。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你借着我，日子必增多，","poem":1},{"lineBreak":true},{"text":"年岁也必加添。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你若有智慧，是与自己有益；","poem":1},{"lineBreak":true},{"text":"你若亵慢，就必独自担当。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"愚昧的妇人喧嚷；","poem":1},{"lineBreak":true},{"text":"她是愚蒙，一无所知。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"她坐在自己的家门口，","poem":1},{"lineBreak":true},{"text":"坐在城中高处的座位上，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"呼叫过路的，","poem":1},{"lineBreak":true},{"text":"就是直行其道的人，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"说：谁是愚蒙人，可以转到这里来！","poem":1},{"lineBreak":true},{"text":"又对那无知的人说：","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"偷来的水是甜的，","poem":1},{"lineBreak":true},{"text":"暗吃的饼是好的。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"人却不知有阴魂在她那里；","poem":1},{"lineBreak":true},{"text":"她的客在阴间的深处。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}