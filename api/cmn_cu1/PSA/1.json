ineBreak":true},{"text":"恶人的道路却必灭亡。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}