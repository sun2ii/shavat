{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":10,"content":[{"type":"heading","content":["为公义而祈祷"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，你为什么站在远处？","poem":1},{"lineBreak":true},{"text":"在患难的时候为什么隐藏？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"恶人在骄横中把困苦人追得火急；","poem":1},{"lineBreak":true},{"text":"愿他们陷在自己所设的计谋里。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因为恶人以心愿自夸；","poem":1},{"lineBreak":true},{"text":"贪财的背弃耶和华，并且轻慢他","poem":1},{"noteId":3},{"text":"。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"恶人面带骄傲，说：耶和华必不追究；","poem":1},{"lineBreak":true},{"text":"他一切所想的都以为没有 神。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"凡他所做的，时常稳固；","poem":1},{"lineBreak":true},{"text":"你的审判超过他的眼界。","poem":1},{"lineBreak":true},{"text":"至于他一切的敌人，","poem":1},{"lineBreak":true},{"text":"他都向他们喷气。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他心里说：我必不动摇，","poem":1},{"lineBreak":true},{"text":"世世代代不遭灾难。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"他满口是咒骂、诡诈、欺压，","poem":1},{"lineBreak":true},{"text":"舌底是毒害、奸恶。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他在村庄埋伏等候；","poem":1},{"lineBreak":true},{"text":"他在隐密处杀害无辜的人。","poem":1},{"lineBreak":true},{"text":"他的眼睛窥探无倚无靠的人；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他埋伏在暗地，如狮子蹲在洞中。","poem":1},{"lineBreak":true},{"text":"他埋伏，要掳去困苦人；","poem":1},{"lineBreak":true},{"text":"他拉网，就把困苦人掳去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"他屈身蹲伏，","poem":1},{"lineBreak":true},{"text":"无倚无靠的人就倒在他爪牙","poem":1},{"noteId":4},{"text":"之下。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他心里说： 神竟忘记了；","poem":1},{"lineBreak":true},{"text":"他掩面永不观看。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和华啊，求你起来！","poem":1},{"lineBreak":true},{"text":"神啊，求你举手，不要忘记困苦人！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"恶人为何轻慢 神，","poem":1},{"lineBreak":true},{"text":"心里说：你必不追究？","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"其实你已经观看；","poem":1},{"lineBreak":true},{"text":"因为奸恶毒害，你都看见了，","poem":1},{"lineBreak":true},{"text":"为要以手施行报应。","poem":1},{"lineBreak":true},{"text":"无倚无靠的人把自己交托你；","poem":1},{"lineBreak":true},{"text":"你向来是帮助孤儿的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"愿你打断恶人的膀臂；","poem":1},{"lineBreak":true},{"text":"至于坏人，愿你追究他的恶，直到净尽。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华永永远远为王；","poem":1},{"lineBreak":true},{"text":"外邦人从他的地已经灭绝了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"耶和华啊，谦卑人的心愿，","poem":1},{"lineBreak":true},{"text":"你早已知道","poem":1},{"noteId":5},{"text":"。","poem":1},{"lineBreak":true},{"text":"你必预备他们的心，","poem":1},{"lineBreak":true},{"text":"也必侧耳听他们的祈求，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"为要给孤儿和受欺压的人伸冤，","poem":1},{"lineBreak":true},{"text":"使强横的人不再威吓他们。","poem":1}]}],"footnotes":[{"noteId":3,"caller":"-","text":"或译：他祝福贪财的，却轻慢耶和华","reference":{"chapter":10,"verse":3}},{"noteId":4,"caller":"-","text":"爪牙：或译强暴人","reference":{"chapter":10,"verse":10}},{"noteId":5,"caller":"-","text":"原文是听见","reference":{"chapter":10,"verse":17}}]},"thisChapterLink":"/api/cmn_cu1/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}