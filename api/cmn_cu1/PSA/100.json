{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":100,"content":[{"type":"heading","content":["颂赞之诗"]},{"type":"hebrew_subtitle","content":["称谢诗。"]},{"type":"verse","number":1,"content":[{"text":"普天下当向耶和华欢呼！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们当乐意事奉耶和华，","poem":1},{"lineBreak":true},{"text":"当来向他歌唱！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你们当晓得耶和华是 神！","poem":1},{"lineBreak":true},{"text":"我们是他造的，也是属他的；","poem":1},{"lineBreak":true},{"text":"我们是他的民，也是他草场的羊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"当称谢进入他的门；","poem":1},{"lineBreak":true},{"text":"当赞美进入他的院。","poem":1},{"lineBreak":true},{"text":"当感谢他，称颂他的名！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"因为耶和华本为善。","poem":1},{"lineBreak":true},{"text":"他的慈爱存到永远；","poem":1},{"lineBreak":true},{"text":"他的信实直到万代。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}