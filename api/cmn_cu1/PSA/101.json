{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":101,"content":[{"type":"heading","content":["王的诺言"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"我要歌唱慈爱和公平；","poem":1},{"lineBreak":true},{"text":"耶和华啊，我要向你歌颂！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要用智慧行完全的道。","poem":1},{"lineBreak":true},{"text":"你几时到我这里来呢？","poem":1},{"lineBreak":true},{"text":"我要存完全的心行在我家中。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"邪僻的事，我都不摆在我眼前；","poem":1},{"lineBreak":true},{"text":"悖逆人所做的事，我甚恨恶，","poem":1},{"lineBreak":true},{"text":"不容沾在我身上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"弯曲的心思，我必远离；","poem":1},{"lineBreak":true},{"text":"一切的恶人","poem":1},{"noteId":37},{"text":"，我不认识。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在暗中谗谤他邻居的，我必将他灭绝；","poem":1},{"lineBreak":true},{"text":"眼目高傲、心里骄纵的，我必不容他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我眼要看国中的诚实人，叫他们与我同住；","poem":1},{"lineBreak":true},{"text":"行为完全的，他要伺候我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"行诡诈的，必不得住在我家里；","poem":1},{"lineBreak":true},{"text":"说谎话的，必不得立在我眼前。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我每日早晨要灭绝国中所有的恶人，","poem":1},{"lineBreak":true},{"text":"好把一切作孽的从耶和华的城里剪除。","poem":1}]}],"footnotes":[{"noteId":37,"caller":"-","text":"或译：恶事","reference":{"chapter":101,"verse":4}}]},"thisChapterLink":"/api/cmn_cu1/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}