{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":102,"content":[{"type":"heading","content":["遭难中的祈祷"]},{"type":"hebrew_subtitle","content":["困苦人发昏的时候，在耶和华面前吐露苦情的祷告。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你听我的祷告，","poem":1},{"lineBreak":true},{"text":"容我的呼求达到你面前！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在急难的日子，求你向我侧耳；","poem":1},{"lineBreak":true},{"text":"不要向我掩面！","poem":1},{"lineBreak":true},{"text":"我呼求的日子，求你快快应允我！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因为，我的年日如烟云消灭；","poem":1},{"lineBreak":true},{"text":"我的骨头如火把烧着。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的心被伤，如草枯干，","poem":1},{"lineBreak":true},{"text":"甚至我忘记吃饭。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因我唉哼的声音，","poem":1},{"lineBreak":true},{"text":"我的肉紧贴骨头。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我如同旷野的鹈鹕；","poem":1},{"lineBreak":true},{"text":"我好像荒场的鸮鸟。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我警醒不睡；","poem":1},{"lineBreak":true},{"text":"我像房顶上孤单的麻雀。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的仇敌终日辱骂我；","poem":1},{"lineBreak":true},{"text":"向我猖狂的人指着我赌咒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我吃过炉灰，如同吃饭；","poem":1},{"lineBreak":true},{"text":"我所喝的与眼泪搀杂。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"这都因你的恼恨和忿怒；","poem":1},{"lineBreak":true},{"text":"你把我拾起来，又把我摔下去。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的年日如日影偏斜；","poem":1},{"lineBreak":true},{"text":"我也如草枯干。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"惟你—耶和华必存到永远；","poem":1},{"lineBreak":true},{"text":"你可记念的名也存到万代。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你必起来怜恤锡安，","poem":1},{"lineBreak":true},{"text":"因现在是可怜她的时候，","poem":1},{"lineBreak":true},{"text":"日期已经到了。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你的仆人原来喜悦她的石头，","poem":1},{"lineBreak":true},{"text":"可怜她的尘土。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"列国要敬畏耶和华的名；","poem":1},{"lineBreak":true},{"text":"世上诸王都敬畏你的荣耀。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因为耶和华建造了锡安，","poem":1},{"lineBreak":true},{"text":"在他荣耀里显现。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他垂听穷人的祷告，","poem":1},{"lineBreak":true},{"text":"并不藐视他们的祈求。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"这必为后代的人记下，","poem":1},{"lineBreak":true},{"text":"将来受造的民要赞美耶和华。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"因为，他从至高的圣所垂看；","poem":1},{"lineBreak":true},{"text":"耶和华从天向地观察，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"要垂听被囚之人的叹息，","poem":1},{"lineBreak":true},{"text":"要释放将要死的人，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"使人在锡安传扬耶和华的名，","poem":1},{"lineBreak":true},{"text":"在耶路撒冷传扬赞美他的话，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"就是在万民和列国","poem":1},{"lineBreak":true},{"text":"聚会事奉耶和华的时候。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"他使我的力量中道衰弱，","poem":1},{"lineBreak":true},{"text":"使我的年日短少。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我说：我的 神啊，","poem":1},{"lineBreak":true},{"text":"不要使我中年去世。","poem":1},{"lineBreak":true},{"text":"你的年数世世无穷！","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"你起初立了地的根基；","poem":1},{"lineBreak":true},{"text":"天也是你手所造的。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"天地都要灭没，你却要长存；","poem":1},{"lineBreak":true},{"text":"天地都要如外衣渐渐旧了。","poem":1},{"lineBreak":true},{"text":"你要将天地如里衣更换，","poem":1},{"lineBreak":true},{"text":"天地就都改变了。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"惟有你永不改变；","poem":1},{"lineBreak":true},{"text":"你的年数没有穷尽。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你仆人的子孙要长存；","poem":1},{"lineBreak":true},{"text":"他们的后裔要坚立在你面前。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}