{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":103,"content":[{"type":"heading","content":["耶和华的慈爱"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"我的心哪，你要称颂耶和华！","poem":1},{"lineBreak":true},{"text":"凡在我里面的，也要称颂他的圣名！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的心哪，你要称颂耶和华！","poem":1},{"lineBreak":true},{"text":"不可忘记他的一切恩惠！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他赦免你的一切罪孽，","poem":1},{"lineBreak":true},{"text":"医治你的一切疾病。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他救赎你的命脱离死亡，","poem":1},{"lineBreak":true},{"text":"以仁爱和慈悲为你的冠冕。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他用美物使你所愿的得以知足，","poem":1},{"lineBreak":true},{"text":"以致你如鹰返老还童。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和华施行公义，","poem":1},{"lineBreak":true},{"text":"为一切受屈的人伸冤。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他使摩西知道他的法则，","poem":1},{"lineBreak":true},{"text":"叫以色列人晓得他的作为。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华有怜悯，有恩典，","poem":1},{"lineBreak":true},{"text":"不轻易发怒，且有丰盛的慈爱。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他不长久责备，","poem":1},{"lineBreak":true},{"text":"也不永远怀怒。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他没有按我们的罪过待我们，","poem":1},{"lineBreak":true},{"text":"也没有照我们的罪孽报应我们。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"天离地何等的高，","poem":1},{"lineBreak":true},{"text":"他的慈爱向敬畏他的人也是何等的大！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"东离西有多远，","poem":1},{"lineBreak":true},{"text":"他叫我们的过犯离我们也有多远！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"父亲怎样怜恤他的儿女，","poem":1},{"lineBreak":true},{"text":"耶和华也怎样怜恤敬畏他的人！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因为他知道我们的本体，","poem":1},{"lineBreak":true},{"text":"思念我们不过是尘土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"至于世人，他的年日如草一样。","poem":1},{"lineBreak":true},{"text":"他发旺如野地的花，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"经风一吹，便归无有；","poem":1},{"lineBreak":true},{"text":"它的原处也不再认识它。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"但耶和华的慈爱归于敬畏他的人，","poem":1},{"lineBreak":true},{"text":"从亘古到永远；","poem":1},{"lineBreak":true},{"text":"他的公义也归于子子孙孙—","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"就是那些遵守他的约、","poem":1},{"lineBreak":true},{"text":"记念他的训词而遵行的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和华在天上立定宝座；","poem":1},{"lineBreak":true},{"text":"他的权柄","poem":1},{"noteId":38},{"text":"统管万有。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"听从他命令、成全他旨意、","poem":1},{"lineBreak":true},{"text":"有大能的天使，都要称颂耶和华！","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你们作他的诸军，作他的仆役，","poem":1},{"lineBreak":true},{"text":"行他所喜悦的，都要称颂耶和华！","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你们一切被他造的，","poem":1},{"lineBreak":true},{"text":"在他所治理的各处，","poem":1},{"lineBreak":true},{"text":"都要称颂耶和华！","poem":1},{"lineBreak":true},{"text":"我的心哪，你要称颂耶和华！","poem":1}]}],"footnotes":[{"noteId":38,"caller":"-","text":"原文是国","reference":{"chapter":103,"verse":19}}]},"thisChapterLink":"/api/cmn_cu1/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}