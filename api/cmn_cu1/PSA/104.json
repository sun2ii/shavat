{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":104,"content":[{"type":"heading","content":["造化主颂"]},{"type":"verse","number":1,"content":[{"text":"我的心哪，你要称颂耶和华！","poem":1},{"lineBreak":true},{"text":"耶和华—我的 神啊，你为至大！","poem":1},{"lineBreak":true},{"text":"你以尊荣威严为衣服，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"披上亮光，如披外袍，","poem":1},{"lineBreak":true},{"text":"铺张穹苍，如铺幔子，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"在水中立楼阁的栋梁，","poem":1},{"lineBreak":true},{"text":"用云彩为车辇，","poem":1},{"lineBreak":true},{"text":"借着风的翅膀而行，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"以风为使者，","poem":1},{"lineBreak":true},{"text":"以火焰为仆役，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"将地立在根基上，","poem":1},{"lineBreak":true},{"text":"使地永不动摇。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你用深水遮盖地面，犹如衣裳；","poem":1},{"lineBreak":true},{"text":"诸水高过山岭。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的斥责一发，水便奔逃；","poem":1},{"lineBreak":true},{"text":"你的雷声一发，水便奔流。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"诸山升上，诸谷沉下","poem":1},{"noteId":39},{"text":"，","poem":1},{"lineBreak":true},{"text":"归你为它所安定之地。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你定了界限，使水不能过去，","poem":1},{"lineBreak":true},{"text":"不再转回遮盖地面。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和华使泉源涌在山谷，","poem":1},{"lineBreak":true},{"text":"流在山间，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"使野地的走兽有水喝，","poem":1},{"lineBreak":true},{"text":"野驴得解其渴。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"天上的飞鸟在水旁住宿，","poem":1},{"lineBreak":true},{"text":"在树枝上啼叫。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他从楼阁中浇灌山岭；","poem":1},{"lineBreak":true},{"text":"因他作为的功效，地就丰足。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"他使草生长，给六畜吃，","poem":1},{"lineBreak":true},{"text":"使菜蔬发长，供给人用，","poem":1},{"lineBreak":true},{"text":"使人从地里能得食物，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"又得酒能悦人心，","poem":1},{"lineBreak":true},{"text":"得油能润人面，","poem":1},{"lineBreak":true},{"text":"得粮能养人心。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"佳美的树木，就是黎巴嫩的香柏树，","poem":1},{"lineBreak":true},{"text":"是耶和华所栽种的，都满了汁浆。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"雀鸟在其上搭窝；","poem":1},{"lineBreak":true},{"text":"至于鹤，松树是它的房屋。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"高山为野山羊的住所；","poem":1},{"lineBreak":true},{"text":"岩石为沙番的藏处。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你安置月亮为定节令；","poem":1},{"lineBreak":true},{"text":"日头自知沉落。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你造黑暗为夜，","poem":1},{"lineBreak":true},{"text":"林中的百兽就都爬出来。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"少壮狮子吼叫，要抓食，","poem":1},{"lineBreak":true},{"text":"向 神寻求食物。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"日头一出，兽便躲避，","poem":1},{"lineBreak":true},{"text":"卧在洞里。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"人出去做工，","poem":1},{"lineBreak":true},{"text":"劳碌直到晚上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"耶和华啊，你所造的何其多！","poem":1},{"lineBreak":true},{"text":"都是你用智慧造成的；","poem":1},{"lineBreak":true},{"text":"遍地满了你的丰富。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"那里有海，又大又广；","poem":1},{"lineBreak":true},{"text":"其中有无数的动物，","poem":1},{"lineBreak":true},{"text":"大小活物都有。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"那里有船行走，","poem":1},{"lineBreak":true},{"text":"有你所造的鳄鱼游泳在其中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"这都仰望你按时给它食物。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你给它们，它们便拾起来；","poem":1},{"lineBreak":true},{"text":"你张手，它们饱得美食。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你掩面，它们便惊惶；","poem":1},{"lineBreak":true},{"text":"你收回它们的气，它们就死亡，归于尘土。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"你发出你的灵，它们便受造；","poem":1},{"lineBreak":true},{"text":"你使地面更换为新。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"愿耶和华的荣耀存到永远！","poem":1},{"lineBreak":true},{"text":"愿耶和华喜悦自己所造的！","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他看地，地便震动；","poem":1},{"lineBreak":true},{"text":"他摸山，山就冒烟。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"我要一生向耶和华唱诗！","poem":1},{"lineBreak":true},{"text":"我还活的时候，要向我 神歌颂！","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"愿他以我的默念为甘甜！","poem":1},{"lineBreak":true},{"text":"我要因耶和华欢喜！","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"愿罪人从世上消灭！","poem":1},{"lineBreak":true},{"text":"愿恶人归于无有！","poem":1},{"lineBreak":true},{"text":"我的心哪，要称颂耶和华！","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华","poem":1},{"noteId":40},{"text":"！","poem":1}]}],"footnotes":[{"noteId":39,"caller":"-","text":"或译：随山上翻，随谷下流","reference":{"chapter":104,"verse":8}},{"noteId":40,"caller":"-","text":"原文是哈利路亚；下同","reference":{"chapter":104,"verse":35}}]},"thisChapterLink":"/api/cmn_cu1/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}