{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":105,"content":[{"type":"heading","content":["神和他的子民"]},{"type":"verse","number":1,"content":[{"text":"你们要称谢耶和华，求告他的名，","poem":1},{"lineBreak":true},{"text":"在万民中传扬他的作为！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要向他唱诗歌颂，","poem":1},{"lineBreak":true},{"text":"谈论他一切奇妙的作为！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要以他的圣名夸耀！","poem":1},{"lineBreak":true},{"text":"寻求耶和华的人，心中应当欢喜！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"要寻求耶和华与他的能力，","poem":1},{"lineBreak":true},{"text":"时常寻求他的面。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他仆人亚伯拉罕的后裔，","poem":1},{"lineBreak":true},{"text":"他所拣选雅各的子孙哪，","poem":1},{"lineBreak":true},{"text":"你们要记念他奇妙的作为和他的奇事，","poem":1},{"lineBreak":true},{"text":"并他口中的判语。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"他是耶和华—我们的 神；","poem":1},{"lineBreak":true},{"text":"全地都有他的判断。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他记念他的约，直到永远；","poem":1},{"lineBreak":true},{"text":"他所吩咐的话，直到千代—","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"就是与亚伯拉罕所立的约，","poem":1},{"lineBreak":true},{"text":"向以撒所起的誓。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他又将这约向雅各定为律例，","poem":1},{"lineBreak":true},{"text":"向以色列定为永远的约，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"说：我必将迦南地赐给你，","poem":1},{"lineBreak":true},{"text":"作你产业的分。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"当时，他们人丁有限，数目稀少，","poem":1},{"lineBreak":true},{"text":"并且在那地为寄居的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他们从这邦游到那邦，","poem":1},{"lineBreak":true},{"text":"从这国行到那国。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他不容什么人欺负他们，","poem":1},{"lineBreak":true},{"text":"为他们的缘故责备君王，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"说：不可难为我受膏的人，","poem":1},{"lineBreak":true},{"text":"也不可恶待我的先知。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"他命饥荒降在那地上，","poem":1},{"lineBreak":true},{"text":"将所倚靠的粮食全行断绝，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"在他们以先打发一个人去","poem":1},{"lineBreak":true},{"text":"—约瑟被卖为奴仆。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"人用脚镣伤他的脚；","poem":1},{"lineBreak":true},{"text":"他被铁链捆拘。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和华的话试炼他，","poem":1},{"lineBreak":true},{"text":"直等到他所说的应验了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"王打发人把他解开，","poem":1},{"lineBreak":true},{"text":"就是治理众民的，把他释放，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"立他作王家之主，","poem":1},{"lineBreak":true},{"text":"掌管他一切所有的，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"使他随意捆绑他的臣宰，","poem":1},{"lineBreak":true},{"text":"将智慧教导他的长老。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"以色列也到了埃及；","poem":1},{"lineBreak":true},{"text":"雅各在含地寄居。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"耶和华使他的百姓生养众多，","poem":1},{"lineBreak":true},{"text":"使他们比敌人强盛，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"使敌人的心转去恨他的百姓，","poem":1},{"lineBreak":true},{"text":"并用诡计待他的仆人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"他打发他的仆人摩西","poem":1},{"lineBreak":true},{"text":"和他所拣选的亚伦，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"在敌人中间显他的神迹，","poem":1},{"lineBreak":true},{"text":"在含地显他的奇事。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他命黑暗，就有黑暗；","poem":1},{"lineBreak":true},{"text":"没有违背他话的。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他叫埃及的水变为血，","poem":1},{"lineBreak":true},{"text":"叫他们的鱼死了。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"在他们的地上以及王宫的内室，","poem":1},{"lineBreak":true},{"text":"青蛙多多滋生。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他说一声，苍蝇就成群而来，","poem":1},{"lineBreak":true},{"text":"并有虱子进入他们四境。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他给他们降下冰雹为雨，","poem":1},{"lineBreak":true},{"text":"在他们的地上降下火焰。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他也击打他们的葡萄树和无花果树，","poem":1},{"lineBreak":true},{"text":"毁坏他们境内的树木。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"他说一声，就有蝗虫蚂蚱上来，","poem":1},{"lineBreak":true},{"text":"不计其数，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"吃尽了他们地上各样的菜蔬","poem":1},{"lineBreak":true},{"text":"和田地的出产。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他又击杀他们国内一切的长子，","poem":1},{"lineBreak":true},{"text":"就是他们强壮时头生的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"他领自己的百姓带银子金子出来；","poem":1},{"lineBreak":true},{"text":"他支派中没有一个软弱的。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"他们出来的时候，埃及人便欢喜；","poem":1},{"lineBreak":true},{"text":"原来埃及人惧怕他们。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"他铺张云彩当遮盖，","poem":1},{"lineBreak":true},{"text":"夜间使火光照。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"他们一求，他就使鹌鹑飞来，","poem":1},{"lineBreak":true},{"text":"并用天上的粮食叫他们饱足。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"他打开磐石，水就涌出；","poem":1},{"lineBreak":true},{"text":"在干旱之处，水流成河。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"这都因他记念他的圣言","poem":1},{"lineBreak":true},{"text":"和他的仆人亚伯拉罕。","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"他带领百姓欢乐而出，","poem":1},{"lineBreak":true},{"text":"带领选民欢呼前往。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"他将列国的地赐给他们，","poem":1},{"lineBreak":true},{"text":"他们便承受众民劳碌得来的，","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"好使他们遵他的律例，","poem":1},{"lineBreak":true},{"text":"守他的律法。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":44}