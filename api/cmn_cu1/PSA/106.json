{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":106,"content":[{"type":"heading","content":["神对他子民的良善"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"要称谢耶和华，因他本为善；","poem":1},{"lineBreak":true},{"text":"他的慈爱永远长存！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"谁能传说耶和华的大能？","poem":1},{"lineBreak":true},{"text":"谁能表明他一切的美德？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"凡遵守公平、常行公义的，","poem":1},{"lineBreak":true},{"text":"这人便为有福！","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华啊，你用恩惠待你的百姓；","poem":1},{"lineBreak":true},{"text":"求你也用这恩惠记念我，开你的救恩眷顾我，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"使我见你选民的福，","poem":1},{"lineBreak":true},{"text":"乐你国民的乐，","poem":1},{"lineBreak":true},{"text":"与你的产业一同夸耀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我们与我们的祖宗一同犯罪；","poem":1},{"lineBreak":true},{"text":"我们作了孽，行了恶。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我们的祖宗在埃及不明白你的奇事，","poem":1},{"lineBreak":true},{"text":"不记念你丰盛的慈爱，","poem":1},{"lineBreak":true},{"text":"反倒在红海行了悖逆。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"然而，他因自己的名拯救他们，","poem":1},{"lineBreak":true},{"text":"为要彰显他的大能，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"并且斥责红海，海便干了；","poem":1},{"lineBreak":true},{"text":"他带领他们经过深处，如同经过旷野。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他拯救他们脱离恨他们人的手，","poem":1},{"lineBreak":true},{"text":"从仇敌手中救赎他们。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"水淹没他们的敌人，","poem":1},{"lineBreak":true},{"text":"没有一个存留。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"那时，他们才信了他的话，","poem":1},{"lineBreak":true},{"text":"歌唱赞美他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"等不多时，他们就忘了他的作为，","poem":1},{"lineBreak":true},{"text":"不仰望他的指教，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"反倒在旷野大起欲心，","poem":1},{"lineBreak":true},{"text":"在荒地试探 神。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他将他们所求的赐给他们，","poem":1},{"lineBreak":true},{"text":"却使他们的心灵软弱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"他们又在营中嫉妒摩西","poem":1},{"lineBreak":true},{"text":"和耶和华的圣者亚伦。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"地裂开，吞下大坍，","poem":1},{"lineBreak":true},{"text":"掩盖亚比兰一党的人。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"有火在他们的党中发起；","poem":1},{"lineBreak":true},{"text":"有火焰烧毁了恶人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"他们在何烈山造了牛犊，","poem":1},{"lineBreak":true},{"text":"叩拜铸成的像。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"如此将他们荣耀的主","poem":1},{"lineBreak":true},{"text":"换为吃草之牛的像，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"忘了 神—他们的救主；","poem":1},{"lineBreak":true},{"text":"他曾在埃及行大事，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"在含地行奇事，","poem":1},{"lineBreak":true},{"text":"在红海行可畏的事。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"所以，他说要灭绝他们；","poem":1},{"lineBreak":true},{"text":"若非有他所拣选的摩西站在当中","poem":1},{"noteId":41},{"text":"，","poem":1},{"lineBreak":true},{"text":"使他的忿怒转消，","poem":1},{"lineBreak":true},{"text":"恐怕他就灭绝他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"他们又藐视那美地，","poem":1},{"lineBreak":true},{"text":"不信他的话，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"在自己帐棚内发怨言，","poem":1},{"lineBreak":true},{"text":"不听耶和华的声音。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"所以，他对他们起誓：","poem":1},{"lineBreak":true},{"text":"必叫他们倒在旷野，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"叫他们的后裔倒在列国之中，","poem":1},{"lineBreak":true},{"text":"分散在各地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"他们又与巴力·毗珥连合，","poem":1},{"lineBreak":true},{"text":"且吃了祭死神","poem":1},{"noteId":42},{"text":"的物。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他们这样行，惹耶和华发怒，","poem":1},{"lineBreak":true},{"text":"便有瘟疫流行在他们中间。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"那时，非尼哈站起，刑罚恶人，","poem":1},{"lineBreak":true},{"text":"瘟疫这才止息。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"那就算为他的义，","poem":1},{"lineBreak":true},{"text":"世世代代，直到永远。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"他们在米利巴水又叫耶和华发怒，","poem":1},{"lineBreak":true},{"text":"甚至摩西也受了亏损，","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"是因他们惹动他的灵，","poem":1},{"lineBreak":true},{"text":"摩西","poem":1},{"noteId":43},{"text":"用嘴说了急躁的话。","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"他们不照耶和华所吩咐的","poem":1},{"lineBreak":true},{"text":"灭绝外邦人，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"反与他们混杂相合，","poem":1},{"lineBreak":true},{"text":"学习他们的行为，","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"事奉他们的偶像，","poem":1},{"lineBreak":true},{"text":"这就成了自己的网罗，","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"把自己的儿女祭祀鬼魔，","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"流无辜人的血，","poem":1},{"lineBreak":true},{"text":"就是自己儿女的血，","poem":1},{"lineBreak":true},{"text":"把他们祭祀迦南的偶像，","poem":1},{"lineBreak":true},{"text":"那地就被血污秽了。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"这样，他们被自己所做的污秽了，","poem":1},{"lineBreak":true},{"text":"在行为上犯了邪淫。","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"所以，耶和华的怒气向他的百姓发作，","poem":1},{"lineBreak":true},{"text":"憎恶他的产业，","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"将他们交在外邦人的手里；","poem":1},{"lineBreak":true},{"text":"恨他们的人就辖制他们。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"他们的仇敌也欺压他们，","poem":1},{"lineBreak":true},{"text":"他们就伏在敌人手下。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"他屡次搭救他们，","poem":1},{"lineBreak":true},{"text":"他们却设谋背逆，","poem":1},{"lineBreak":true},{"text":"因自己的罪孽降为卑下。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"然而，他听见他们哀告的时候，","poem":1},{"lineBreak":true},{"text":"就眷顾他们的急难，","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"为他们记念他的约，","poem":1},{"lineBreak":true},{"text":"照他丰盛的慈爱后悔。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"他也使他们在凡掳掠他们的人面前蒙怜恤。","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"耶和华—我们的 神啊，求你拯救我们，","poem":1},{"lineBreak":true},{"text":"从外邦中招聚我们，","poem":1},{"lineBreak":true},{"text":"我们好称赞你的圣名，","poem":1},{"lineBreak":true},{"text":"以赞美你为夸胜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"耶和华—以色列的 神是应当称颂的，","poem":1},{"lineBreak":true},{"text":"从亘古直到永远。","poem":1},{"lineBreak":true},{"text":"愿众民都说：阿们！","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[{"noteId":41,"caller":"-","text":"原文是破口","reference":{"chapter":106,"verse":23}},{"noteId":42,"caller":"-","text":"或译：人","reference":{"chapter":106,"verse":28}},{"noteId":43,"caller":"-","text":"原文是他","reference":{"chapter":106,"verse":33}}]},"thisChapterLink":"/api/cmn_cu1/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}