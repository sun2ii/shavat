{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":107,"content":[{"type":"heading","content":["颂赞 神的良善"]},{"type":"verse","number":1,"content":[{"text":"你们要称谢耶和华，因他本为善；","poem":1},{"lineBreak":true},{"text":"他的慈爱永远长存！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿耶和华的赎民说这话，","poem":1},{"lineBreak":true},{"text":"就是他从敌人手中所救赎的，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"从各地，从东从西，","poem":1},{"lineBreak":true},{"text":"从南从北，所招聚来的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他们在旷野荒地漂流，","poem":1},{"lineBreak":true},{"text":"寻不见可住的城邑，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"又饥又渴，","poem":1},{"lineBreak":true},{"text":"心里发昏。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"于是，他们在苦难中哀求耶和华；","poem":1},{"lineBreak":true},{"text":"他从他们的祸患中搭救他们，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"又领他们行走直路，","poem":1},{"lineBreak":true},{"text":"使他们往可居住的城邑。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"但愿人因耶和华的慈爱","poem":1},{"lineBreak":true},{"text":"和他向人所行的奇事都称赞他；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因他使心里渴慕的人得以知足，","poem":1},{"lineBreak":true},{"text":"使心里饥饿的人得饱美物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"那些坐在黑暗中、死荫里的人","poem":1},{"lineBreak":true},{"text":"被困苦和铁链捆锁，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"是因他们违背 神的话语，","poem":1},{"lineBreak":true},{"text":"藐视至高者的旨意。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"所以，他用劳苦治服他们的心；","poem":1},{"lineBreak":true},{"text":"他们仆倒，无人扶助。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"于是，他们在苦难中哀求耶和华；","poem":1},{"lineBreak":true},{"text":"他从他们的祸患中拯救他们。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他从黑暗中和死荫里领他们出来，","poem":1},{"lineBreak":true},{"text":"折断他们的绑索。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"但愿人因耶和华的慈爱","poem":1},{"lineBreak":true},{"text":"和他向人所行的奇事都称赞他；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因为他打破了铜门，","poem":1},{"lineBreak":true},{"text":"砍断了铁闩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"愚妄人因自己的过犯","poem":1},{"lineBreak":true},{"text":"和自己的罪孽便受苦楚。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们心里厌恶各样的食物，","poem":1},{"lineBreak":true},{"text":"就临近死门。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"于是，他们在苦难中哀求耶和华；","poem":1},{"lineBreak":true},{"text":"他从他们的祸患中拯救他们。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他发命医治他们，","poem":1},{"lineBreak":true},{"text":"救他们脱离死亡。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"但愿人因耶和华的慈爱","poem":1},{"lineBreak":true},{"text":"和他向人所行的奇事都称赞他。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"愿他们以感谢为祭献给他，","poem":1},{"lineBreak":true},{"text":"欢呼述说他的作为！","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"在海上坐船，","poem":1},{"lineBreak":true},{"text":"在大水中经理事务的，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他们看见耶和华的作为，","poem":1},{"lineBreak":true},{"text":"并他在深水中的奇事。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"因他一吩咐，狂风就起来，","poem":1},{"lineBreak":true},{"text":"海中的波浪也扬起。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他们上到天空，下到海底；","poem":1},{"lineBreak":true},{"text":"他们的心因患难便消化。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他们摇摇晃晃，东倒西歪，好像醉酒的人；","poem":1},{"lineBreak":true},{"text":"他们的智慧无法可施。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"于是，他们在苦难中哀求耶和华，","poem":1},{"lineBreak":true},{"text":"他从他们的祸患中领出他们来。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他使狂风止息，","poem":1},{"lineBreak":true},{"text":"波浪就平静。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"风息浪静，他们便欢喜；","poem":1},{"lineBreak":true},{"text":"他就引他们到所愿去的海口。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"但愿人因耶和华的慈爱","poem":1},{"lineBreak":true},{"text":"和他向人所行的奇事都称赞他。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"愿他们在民的会中尊崇他，","poem":1},{"lineBreak":true},{"text":"在长老的位上赞美他！","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"他使江河变为旷野，","poem":1},{"lineBreak":true},{"text":"叫水泉变为干渴之地，","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"使肥地变为硷地；","poem":1},{"lineBreak":true},{"text":"这都因其间居民的罪恶。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"他使旷野变为水潭，","poem":1},{"lineBreak":true},{"text":"叫旱地变为水泉。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他使饥饿的人住在那里，","poem":1},{"lineBreak":true},{"text":"好建造可住的城邑，","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"又种田地，栽葡萄园，","poem":1},{"lineBreak":true},{"text":"得享所出的土产。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"他又赐福给他们，叫他们生养众多，","poem":1},{"lineBreak":true},{"text":"也不叫他们的牲畜减少。","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"他们又因暴虐、患难、愁苦，","poem":1},{"lineBreak":true},{"text":"就减少且卑下。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"他使君王蒙羞被辱，","poem":1},{"lineBreak":true},{"text":"使他们在荒废无路之地漂流。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"他却将穷乏人安置在高处，脱离苦难，","poem":1},{"lineBreak":true},{"text":"使他的家属多如羊群。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"正直人看见就欢喜；","poem":1},{"lineBreak":true},{"text":"罪孽之辈必塞口无言。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"凡有智慧的，必在这些事上留心，","poem":1},{"lineBreak":true},{"text":"也必思想耶和华的慈爱。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}