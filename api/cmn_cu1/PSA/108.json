{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":108,"content":[{"type":"heading","content":["抗敌求助"]},{"type":"hebrew_subtitle","content":["大卫的诗歌。"]},{"type":"verse","number":1,"content":[{"text":"神啊，我心坚定；","poem":1},{"lineBreak":true},{"text":"我口","poem":1},{"noteId":44},{"text":"要唱诗歌颂！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"琴瑟啊，你们当醒起！","poem":1},{"lineBreak":true},{"text":"我自己要极早醒起！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华啊，我要在万民中称谢你，","poem":1},{"lineBreak":true},{"text":"在列邦中歌颂你！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因为，你的慈爱大过诸天；","poem":1},{"lineBreak":true},{"text":"你的诚实达到穹苍。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"神啊，愿你崇高过于诸天！","poem":1},{"lineBreak":true},{"text":"愿你的荣耀高过全地！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你应允我们，用右手拯救我们，","poem":1},{"lineBreak":true},{"text":"好叫你所亲爱的人得救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"神已经指着他的圣洁说","poem":1},{"noteId":45},{"text":"：","poem":1},{"lineBreak":true},{"text":"我要欢乐；我要分开示剑，","poem":1},{"lineBreak":true},{"text":"丈量疏割谷。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"基列是我的；","poem":1},{"lineBreak":true},{"text":"玛拿西是我的；","poem":1},{"lineBreak":true},{"text":"以法莲是护卫我头的；","poem":1},{"lineBreak":true},{"text":"犹大是我的杖；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"摩押是我的沐浴盆；","poem":1},{"lineBreak":true},{"text":"我要向以东抛鞋；","poem":1},{"lineBreak":true},{"text":"我必因胜非利士呼喊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"谁能领我进坚固城？","poem":1},{"lineBreak":true},{"text":"谁能引我到以东地？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"神啊，你不是丢弃了我们吗？","poem":1},{"lineBreak":true},{"text":"神啊，你不和我们的军兵同去吗？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你帮助我们攻击敌人，","poem":1},{"lineBreak":true},{"text":"因为人的帮助是枉然的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我们倚靠 神才得施展大能，","poem":1},{"lineBreak":true},{"text":"因为践踏我们敌人的就是他。","poem":1}]}],"footnotes":[{"noteId":44,"caller":"-","text":"原文是荣耀","reference":{"chapter":108,"verse":1}},{"noteId":45,"caller":"-","text":"说：或译应许我","reference":{"chapter":108,"verse":7}}]},"thisChapterLink":"/api/cmn_cu1/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}