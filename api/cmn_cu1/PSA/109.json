{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":109,"content":[{"type":"heading","content":["遭难者的苦诉"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"我所赞美的 神啊，","poem":1},{"lineBreak":true},{"text":"求你不要闭口不言。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为恶人的嘴和诡诈人的口已经张开攻击我；","poem":1},{"lineBreak":true},{"text":"他们用撒谎的舌头对我说话。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们围绕我，说怨恨的话，","poem":1},{"lineBreak":true},{"text":"又无故地攻打我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们与我为敌以报我爱，","poem":1},{"lineBreak":true},{"text":"但我专心祈祷。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们向我以恶报善，","poem":1},{"lineBreak":true},{"text":"以恨报爱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"愿你派一个恶人辖制他，","poem":1},{"lineBreak":true},{"text":"派一个对头站在他右边！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他受审判的时候，","poem":1},{"lineBreak":true},{"text":"愿他出来担当罪名！","poem":1},{"lineBreak":true},{"text":"愿他的祈祷反成为罪！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愿他的年日短少！","poem":1},{"lineBreak":true},{"text":"愿别人得他的职分！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愿他的儿女为孤儿，","poem":1},{"lineBreak":true},{"text":"他的妻子为寡妇！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"愿他的儿女漂流讨饭，","poem":1},{"lineBreak":true},{"text":"从他们荒凉之处出来求食！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"愿强暴的债主牢笼他一切所有的！","poem":1},{"lineBreak":true},{"text":"愿外人抢他劳碌得来的！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"愿无人向他延绵施恩！","poem":1},{"lineBreak":true},{"text":"愿无人可怜他的孤儿！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"愿他的后人断绝，","poem":1},{"lineBreak":true},{"text":"名字被涂抹，不传于下代！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"愿他祖宗的罪孽被耶和华记念！","poem":1},{"lineBreak":true},{"text":"愿他母亲的罪过不被涂抹！","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愿这些罪常在耶和华面前，","poem":1},{"lineBreak":true},{"text":"使他的名号断绝于世！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因为他不想施恩，","poem":1},{"lineBreak":true},{"text":"却逼迫困苦穷乏的和伤心的人，","poem":1},{"lineBreak":true},{"text":"要把他们治死。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他爱咒骂，咒骂就临到他；","poem":1},{"lineBreak":true},{"text":"他不喜爱福乐，福乐就与他远离！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他拿咒骂当衣服穿上；","poem":1},{"lineBreak":true},{"text":"这咒骂就如水进他里面，","poem":1},{"lineBreak":true},{"text":"像油入他的骨头。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"愿这咒骂当他遮身的衣服，","poem":1},{"lineBreak":true},{"text":"当他常束的腰带！","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"这就是我对头和用恶言议论我的人","poem":1},{"lineBreak":true},{"text":"从耶和华那里所受的报应。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"主—耶和华啊，求你为你的名恩待我；","poem":1},{"lineBreak":true},{"text":"因你的慈爱美好，求你搭救我！","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为我困苦穷乏，","poem":1},{"lineBreak":true},{"text":"内心受伤。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我如日影渐渐偏斜而去；","poem":1},{"lineBreak":true},{"text":"我如蝗虫被抖出来。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我因禁食，膝骨软弱；","poem":1},{"lineBreak":true},{"text":"我身上的肉也渐渐瘦了。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我受他们的羞辱，","poem":1},{"lineBreak":true},{"text":"他们看见我便摇头。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"耶和华—我的 神啊，求你帮助我，","poem":1},{"lineBreak":true},{"text":"照你的慈爱拯救我，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"使他们知道这是你的手，","poem":1},{"lineBreak":true},{"text":"是你—耶和华所行的事。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"任凭他们咒骂，惟愿你赐福；","poem":1},{"lineBreak":true},{"text":"他们几时起来就必蒙羞，","poem":1},{"lineBreak":true},{"text":"你的仆人却要欢喜。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"愿我的对头披戴羞辱！","poem":1},{"lineBreak":true},{"text":"愿他们以自己的羞愧为外袍遮身！","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我要用口极力称谢耶和华；","poem":1},{"lineBreak":true},{"text":"我要在众人中间赞美他；","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"因为他必站在穷乏人的右边，","poem":1},{"lineBreak":true},{"text":"要救他脱离审判他灵魂的人。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}