{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":11,"content":[{"type":"heading","content":["在主里得安稳"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"我是投靠耶和华；","poem":1},{"lineBreak":true},{"text":"你们怎么对我说：你当像鸟飞往你的山去。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"看哪，恶人弯弓，把箭搭在弦上，","poem":1},{"lineBreak":true},{"text":"要在暗中射那心里正直的人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"根基若毁坏，","poem":1},{"lineBreak":true},{"text":"义人还能做什么呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华在他的圣殿里；","poem":1},{"lineBreak":true},{"text":"耶和华的宝座在天上；","poem":1},{"lineBreak":true},{"text":"他的慧眼察看世人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华试验义人；","poem":1},{"lineBreak":true},{"text":"惟有恶人和喜爱强暴的人，他心里恨恶。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他要向恶人密布网罗；","poem":1},{"lineBreak":true},{"text":"有烈火、硫磺、热风，作他们杯中的分。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因为耶和华是公义的，他喜爱公义；","poem":1},{"lineBreak":true},{"text":"正直人必得见他的面。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}