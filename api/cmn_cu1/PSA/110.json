{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":110,"content":[{"type":"heading","content":["耶和华及其所选之王"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华对我主说：","poem":1},{"lineBreak":true},{"text":"你坐在我的右边，","poem":1},{"lineBreak":true},{"text":"等我使你仇敌作你的脚凳。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"耶和华必使你从锡安伸出能力的杖来；","poem":1},{"lineBreak":true},{"text":"你要在你仇敌中掌权。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"当你掌权的日子","poem":1},{"noteId":46},{"text":"，","poem":1},{"lineBreak":true},{"text":"你的民要以圣洁的妆饰为衣","poem":1},{"noteId":47},{"text":"，","poem":1},{"lineBreak":true},{"text":"甘心牺牲自己；","poem":1},{"lineBreak":true},{"text":"你的民多如清晨的甘露","poem":1},{"noteId":48},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华起了誓，决不后悔，说：","poem":1},{"lineBreak":true},{"text":"你是照着麦基洗德的等次永远为祭司。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"在你右边的主，","poem":1},{"lineBreak":true},{"text":"当他发怒的日子，必打伤列王。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他要在列邦中刑罚恶人，","poem":1},{"lineBreak":true},{"text":"尸首就遍满各处；","poem":1},{"lineBreak":true},{"text":"他要在许多国中打破仇敌的头。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他要喝路旁的河水，","poem":1},{"lineBreak":true},{"text":"因此必抬起头来。","poem":1}]}],"footnotes":[{"noteId":46,"caller":"-","text":"或译：行军的日子","reference":{"chapter":110,"verse":3}},{"noteId":47,"caller":"-","text":"或译：以圣洁为妆饰","reference":{"chapter":110,"verse":3}},{"noteId":48,"caller":"-","text":"或译：你少年时光耀如清晨的甘露","reference":{"chapter":110,"verse":3}}]},"thisChapterLink":"/api/cmn_cu1/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}