{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":111,"content":[{"type":"heading","content":["赞美耶和华"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"我要在正直人的大会中，并公会中，","poem":1},{"lineBreak":true},{"text":"一心称谢耶和华。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华的作为本为大；","poem":1},{"lineBreak":true},{"text":"凡喜爱的都必考察。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他所行的是尊荣和威严；","poem":1},{"lineBreak":true},{"text":"他的公义存到永远。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他行了奇事，使人记念；","poem":1},{"lineBreak":true},{"text":"耶和华有恩惠，有怜悯。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他赐粮食给敬畏他的人；","poem":1},{"lineBreak":true},{"text":"他必永远记念他的约。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他向百姓显出大能的作为，","poem":1},{"lineBreak":true},{"text":"把外邦的地赐给他们为业。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他手所行的是诚实公平；","poem":1},{"lineBreak":true},{"text":"他的训词都是确实的，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"是永永远远坚定的，","poem":1},{"lineBreak":true},{"text":"是按诚实正直设立的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他向百姓施行救赎，","poem":1},{"lineBreak":true},{"text":"命定他的约，直到永远；","poem":1},{"lineBreak":true},{"text":"他的名圣而可畏。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"敬畏耶和华是智慧的开端；","poem":1},{"lineBreak":true},{"text":"凡遵行他命令的是聪明人。","poem":1},{"lineBreak":true},{"text":"耶和华是永远当赞美的！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}