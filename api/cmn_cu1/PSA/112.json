{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":112,"content":[{"type":"heading","content":["义人之福"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"敬畏耶和华，甚喜爱他命令的，","poem":1},{"lineBreak":true},{"text":"这人便为有福！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他的后裔在世必强盛；","poem":1},{"lineBreak":true},{"text":"正直人的后代必要蒙福。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他家中有货物，有钱财；","poem":1},{"lineBreak":true},{"text":"他的公义存到永远。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"正直人在黑暗中，有光向他发现；","poem":1},{"lineBreak":true},{"text":"他有恩惠，有怜悯，有公义。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"施恩与人、借贷与人的，这人事情顺利；","poem":1},{"lineBreak":true},{"text":"他被审判的时候要诉明自己的冤。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他永不动摇；","poem":1},{"lineBreak":true},{"text":"义人被记念，直到永远。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他必不怕凶恶的信息；","poem":1},{"lineBreak":true},{"text":"他心坚定，倚靠耶和华。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他心确定，总不惧怕，","poem":1},{"lineBreak":true},{"text":"直到他看见敌人遭报。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他施舍钱财，周济贫穷；","poem":1},{"lineBreak":true},{"text":"他的仁义存到永远。","poem":1},{"lineBreak":true},{"text":"他的角必被高举，大有荣耀。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"恶人看见便恼恨，必咬牙而消化；","poem":1},{"lineBreak":true},{"text":"恶人的心愿要归灭绝。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}