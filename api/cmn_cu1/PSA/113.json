{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":113,"content":[{"type":"heading","content":["赞美耶和华的良善"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"耶和华的仆人哪，你们要赞美，","poem":1},{"lineBreak":true},{"text":"赞美耶和华的名！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华的名是应当称颂的，","poem":1},{"lineBreak":true},{"text":"从今时直到永远！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"从日出之地到日落之处，","poem":1},{"lineBreak":true},{"text":"耶和华的名是应当赞美的！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华超乎万民之上；","poem":1},{"lineBreak":true},{"text":"他的荣耀高过诸天。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"谁像耶和华—我们的 神呢？","poem":1},{"lineBreak":true},{"text":"他坐在至高之处，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"自己谦卑，","poem":1},{"lineBreak":true},{"text":"观看天上地下的事。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他从灰尘里抬举贫寒人，","poem":1},{"lineBreak":true},{"text":"从粪堆中提拔穷乏人，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"使他们与王子同坐，","poem":1},{"lineBreak":true},{"text":"就是与本国的王子同坐。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他使不能生育的妇人安居家中，","poem":1},{"lineBreak":true},{"text":"为多子的乐母。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}