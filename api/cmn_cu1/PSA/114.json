{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":114,"content":[{"type":"heading","content":["逾越节之歌"]},{"type":"verse","number":1,"content":[{"text":"以色列出了埃及，","poem":1},{"lineBreak":true},{"text":"雅各家离开说异言之民；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"那时，犹大为主的圣所，","poem":1},{"lineBreak":true},{"text":"以色列为他所治理的国度。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"沧海看见就奔逃；","poem":1},{"lineBreak":true},{"text":"约旦河也倒流。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"大山踊跃，如公羊；","poem":1},{"lineBreak":true},{"text":"小山跳舞，如羊羔。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"沧海啊，你为何奔逃？","poem":1},{"lineBreak":true},{"text":"约旦哪，你为何倒流？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"大山哪，你为何踊跃，如公羊？","poem":1},{"lineBreak":true},{"text":"小山哪，你为何跳舞，如羊羔？","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"大地啊，你因见主的面，","poem":1},{"lineBreak":true},{"text":"就是雅各 神的面，便要震动。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他叫磐石变为水池，","poem":1},{"lineBreak":true},{"text":"叫坚石变为泉源。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}