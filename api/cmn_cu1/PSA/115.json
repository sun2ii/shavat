{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":115,"content":[{"type":"heading","content":["独一真神"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，荣耀不要归与我们，","poem":1},{"lineBreak":true},{"text":"不要归与我们；","poem":1},{"lineBreak":true},{"text":"要因你的慈爱和诚实归在你的名下！","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"为何容外邦人说：","poem":1},{"lineBreak":true},{"text":"他们的 神在哪里呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"然而，我们的 神在天上，","poem":1},{"lineBreak":true},{"text":"都随自己的意旨行事。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们的偶像是金的，银的，","poem":1},{"lineBreak":true},{"text":"是人手所造的，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"有口却不能言，","poem":1},{"lineBreak":true},{"text":"有眼却不能看，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"有耳却不能听，","poem":1},{"lineBreak":true},{"text":"有鼻却不能闻，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"有手却不能摸，","poem":1},{"lineBreak":true},{"text":"有脚却不能走，","poem":1},{"lineBreak":true},{"text":"有喉咙也不能出声。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"造他的要和他一样；","poem":1},{"lineBreak":true},{"text":"凡靠他的也要如此。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"以色列啊，你要倚靠耶和华！","poem":1},{"lineBreak":true},{"text":"他是你的帮助和你的盾牌。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"亚伦家啊，你们要倚靠耶和华！","poem":1},{"lineBreak":true},{"text":"他是你们的帮助和你们的盾牌。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你们敬畏耶和华的，要倚靠耶和华！","poem":1},{"lineBreak":true},{"text":"他是你们的帮助和你们的盾牌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和华向来眷念我们；","poem":1},{"lineBreak":true},{"text":"他还要赐福给我们：","poem":1},{"lineBreak":true},{"text":"要赐福给以色列的家，","poem":1},{"lineBreak":true},{"text":"赐福给亚伦的家。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"凡敬畏耶和华的，无论大小，","poem":1},{"lineBreak":true},{"text":"主必赐福给他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"愿耶和华叫你们","poem":1},{"lineBreak":true},{"text":"和你们的子孙日见加增。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你们蒙了造天地之耶和华的福！","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"天，是耶和华的天；","poem":1},{"lineBreak":true},{"text":"地，他却给了世人。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"死人不能赞美耶和华；","poem":1},{"lineBreak":true},{"text":"下到寂静中的也都不能。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"但我们要称颂耶和华，","poem":1},{"lineBreak":true},{"text":"从今时直到永远。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}