{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":116,"content":[{"type":"heading","content":["为出死入生而赞美 神"]},{"type":"verse","number":1,"content":[{"text":"我爱耶和华，","poem":1},{"lineBreak":true},{"text":"因为他听了我的声音和我的恳求。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他既向我侧耳，","poem":1},{"lineBreak":true},{"text":"我一生要求告他。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"死亡的绳索缠绕我；","poem":1},{"lineBreak":true},{"text":"阴间的痛苦抓住我；","poem":1},{"lineBreak":true},{"text":"我遭遇患难愁苦。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"那时，我便求告耶和华的名，说：","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你救我的灵魂！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和华有恩惠，有公义；","poem":1},{"lineBreak":true},{"text":"我们的 神以怜悯为怀。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华保护愚人；","poem":1},{"lineBreak":true},{"text":"我落到卑微的地步，他救了我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的心哪！你要仍归安乐，","poem":1},{"lineBreak":true},{"text":"因为耶和华用厚恩待你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"主啊，你救我的命免了死亡，","poem":1},{"lineBreak":true},{"text":"救我的眼免了流泪，","poem":1},{"lineBreak":true},{"text":"救我的脚免了跌倒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我要在耶和华面前行活人之路。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我因信，所以如此说话；","poem":1},{"lineBreak":true},{"text":"我受了极大的困苦。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我曾急促地说：","poem":1},{"lineBreak":true},{"text":"人都是说谎的！","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"我拿什么报答耶和华向我所赐的一切厚恩？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我要举起救恩的杯，","poem":1},{"lineBreak":true},{"text":"称扬耶和华的名。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我要在他众民面前向耶和华还我的愿。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"在耶和华眼中，","poem":1},{"lineBreak":true},{"text":"看圣民之死极为宝贵。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华啊，我真是你的仆人；","poem":1},{"lineBreak":true},{"text":"我是你的仆人，是你婢女的儿子。","poem":1},{"lineBreak":true},{"text":"你已经解开我的绑索。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我要以感谢为祭献给你，","poem":1},{"lineBreak":true},{"text":"又要求告耶和华的名。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要在他众民面前，","poem":1},{"lineBreak":true},{"text":"在耶和华殿的院内，","poem":1},{"lineBreak":true},{"text":"在耶路撒冷当中，","poem":1},{"lineBreak":true},{"text":"向耶和华还我的愿。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":18}