{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":118,"content":[{"type":"heading","content":["因胜利而称谢耶和华"]},{"type":"verse","number":1,"content":[{"text":"你们要称谢耶和华，因他本为善；","poem":1},{"lineBreak":true},{"text":"他的慈爱永远长存！","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"愿以色列说：","poem":1},{"lineBreak":true},{"text":"他的慈爱永远长存！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愿亚伦的家说：","poem":1},{"lineBreak":true},{"text":"他的慈爱永远长存！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"愿敬畏耶和华的说：","poem":1},{"lineBreak":true},{"text":"他的慈爱永远长存！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我在急难中求告耶和华，他就应允我，","poem":1},{"lineBreak":true},{"text":"把我安置在宽阔之地。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"有耶和华帮助我，我必不惧怕，","poem":1},{"lineBreak":true},{"text":"人能把我怎么样呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"在那帮助我的人中，有耶和华帮助我，","poem":1},{"lineBreak":true},{"text":"所以我要看见那恨我的人遭报。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"投靠耶和华，强似倚赖人；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"投靠耶和华，强似倚赖王子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"万民围绕我，","poem":1},{"lineBreak":true},{"text":"我靠耶和华的名必剿灭他们。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们环绕我，围困我，","poem":1},{"lineBreak":true},{"text":"我靠耶和华的名必剿灭他们。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们如同蜂子围绕我，","poem":1},{"lineBreak":true},{"text":"好像烧荆棘的火，必被熄灭；","poem":1},{"lineBreak":true},{"text":"我靠耶和华的名，必剿灭他们。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你推我，要叫我跌倒，","poem":1},{"lineBreak":true},{"text":"但耶和华帮助了我。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华是我的力量，是我的诗歌；","poem":1},{"lineBreak":true},{"text":"他也成了我的拯救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"在义人的帐棚里，有欢呼拯救的声音；","poem":1},{"lineBreak":true},{"text":"耶和华的右手施展大能。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华的右手高举；","poem":1},{"lineBreak":true},{"text":"耶和华的右手施展大能。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我必不致死，仍要存活，","poem":1},{"lineBreak":true},{"text":"并要传扬耶和华的作为。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和华虽严严地惩治我，","poem":1},{"lineBreak":true},{"text":"却未曾将我交于死亡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"给我敞开义门；","poem":1},{"lineBreak":true},{"text":"我要进去称谢耶和华！","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"这是耶和华的门；","poem":1},{"lineBreak":true},{"text":"义人要进去！","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"我要称谢你，因为你已经应允我，","poem":1},{"lineBreak":true},{"text":"又成了我的拯救！","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"匠人所弃的石头","poem":1},{"lineBreak":true},{"text":"已成了房角的头块石头。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"这是耶和华所做的，","poem":1},{"lineBreak":true},{"text":"在我们眼中看为希奇。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"这是耶和华所定的日子，","poem":1},{"lineBreak":true},{"text":"我们在其中要高兴欢喜！","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"耶和华啊，求你拯救！","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你使我们亨通！","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"奉耶和华名来的是应当称颂的！","poem":1},{"lineBreak":true},{"text":"我们从耶和华的殿中为你们祝福！","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"耶和华是 神；","poem":1},{"lineBreak":true},{"text":"他光照了我们。","poem":1},{"lineBreak":true},{"text":"理当用绳索把祭牲拴住，","poem":1},{"lineBreak":true},{"text":"牵到坛角那里。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"你是我的 神，我要称谢你！","poem":1},{"lineBreak":true},{"text":"你是我的 神，我要尊崇你！","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"你们要称谢耶和华，因他本为善；","poem":1},{"lineBreak":true},{"text":"他的慈爱永远长存！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}