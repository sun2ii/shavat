{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":119,"content":[{"type":"heading","content":["耶和华的律法"]},{"type":"verse","number":1,"content":[{"text":"行为完全、遵行耶和华律法的，","poem":1},{"lineBreak":true},{"text":"这人便为有福！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"遵守他的法度、一心寻求他的，","poem":1},{"lineBreak":true},{"text":"这人便为有福！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"这人不做非义的事，","poem":1},{"lineBreak":true},{"text":"但遵行他的道。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华啊，你曾将你的训词吩咐我们，","poem":1},{"lineBreak":true},{"text":"为要我们殷勤遵守。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但愿我行事坚定，","poem":1},{"lineBreak":true},{"text":"得以遵守你的律例。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我看重你的一切命令，","poem":1},{"lineBreak":true},{"text":"就不至于羞愧。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我学了你公义的判语，","poem":1},{"lineBreak":true},{"text":"就要以正直的心称谢你。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我必守你的律例；","poem":1},{"lineBreak":true},{"text":"求你总不要丢弃我！","poem":1}]},{"type":"heading","content":["顺从耶和华的律法"]},{"type":"verse","number":9,"content":[{"text":"少年人用什么洁净他的行为呢？","poem":1},{"lineBreak":true},{"text":"是要遵行你的话！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我一心寻求了你；","poem":1},{"lineBreak":true},{"text":"求你不要叫我偏离你的命令。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我将你的话藏在心里，","poem":1},{"lineBreak":true},{"text":"免得我得罪你。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华啊，你是应当称颂的！","poem":1},{"lineBreak":true},{"text":"求你将你的律例教训我！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我用嘴唇传扬你口中的一切典章。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我喜悦你的法度，","poem":1},{"lineBreak":true},{"text":"如同喜悦一切的财物。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要默想你的训词，","poem":1},{"lineBreak":true},{"text":"看重你的道路。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要在你的律例中自乐；","poem":1},{"lineBreak":true},{"text":"我不忘记你的话。","poem":1}]},{"type":"heading","content":["因耶和华律法而蒙福"]},{"type":"verse","number":17,"content":[{"text":"求你用厚恩待你的仆人，使我存活，","poem":1},{"lineBreak":true},{"text":"我就遵守你的话。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你开我的眼睛，","poem":1},{"lineBreak":true},{"text":"使我看出你律法中的奇妙。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我是在地上作寄居的；","poem":1},{"lineBreak":true},{"text":"求你不要向我隐瞒你的命令！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我时常切慕你的典章，","poem":1},{"lineBreak":true},{"text":"甚至心碎。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"受咒诅、偏离你命令的骄傲人，","poem":1},{"lineBreak":true},{"text":"你已经责备他们。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"求你除掉我所受的羞辱和藐视，","poem":1},{"lineBreak":true},{"text":"因我遵守你的法度。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"虽有首领坐着妄论我，","poem":1},{"lineBreak":true},{"text":"你仆人却思想你的律例。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你的法度是我所喜乐的，","poem":1},{"lineBreak":true},{"text":"是我的谋士。","poem":1}]},{"type":"heading","content":["决定遵行耶和华的律法"]},{"type":"verse","number":25,"content":[{"text":"我的性命几乎归于尘土；","poem":1},{"lineBreak":true},{"text":"求你照你的话将我救活！","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我述说我所行的，你应允了我；","poem":1},{"lineBreak":true},{"text":"求你将你的律例教训我！","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"求你使我明白你的训词，","poem":1},{"lineBreak":true},{"text":"我就思想你的奇事。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我的心因愁苦而消化；","poem":1},{"lineBreak":true},{"text":"求你照你的话使我坚立！","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"求你使我离开奸诈的道，","poem":1},{"lineBreak":true},{"text":"开恩将你的律法赐给我！","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我拣选了忠信的道，","poem":1},{"lineBreak":true},{"text":"将你的典章摆在我面前。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"我持守你的法度；","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你不要叫我羞愧！","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"你开广我心的时候，","poem":1},{"lineBreak":true},{"text":"我就往你命令的道上直奔。","poem":1}]},{"type":"heading","content":["求主赐悟性"]},{"type":"verse","number":33,"content":[{"text":"耶和华啊，求你将你的律例指教我，","poem":1},{"lineBreak":true},{"text":"我必遵守到底！","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"求你赐我悟性，我便遵守你的律法，","poem":1},{"lineBreak":true},{"text":"且要一心遵守。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"求你叫我遵行你的命令，","poem":1},{"lineBreak":true},{"text":"因为这是我所喜乐的。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"求你使我的心趋向你的法度，","poem":1},{"lineBreak":true},{"text":"不趋向非义之财。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"求你叫我转眼不看虚假，","poem":1},{"lineBreak":true},{"text":"又叫我在你的道中生活。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"你向敬畏你的人所应许的话，","poem":1},{"lineBreak":true},{"text":"求你向仆人坚定！","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"求你使我所怕的羞辱远离我，","poem":1},{"lineBreak":true},{"text":"因你的典章本为美。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"我羡慕你的训词；","poem":1},{"lineBreak":true},{"text":"求你使我在你的公义上生活！","poem":1}]},{"type":"heading","content":["倚靠耶和华的律法"]},{"type":"verse","number":41,"content":[{"text":"耶和华啊，愿你照你的话，使你的慈爱，","poem":1},{"lineBreak":true},{"text":"就是你的救恩，临到我身上，","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"我就有话回答那羞辱我的，","poem":1},{"lineBreak":true},{"text":"因我倚靠你的话。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"求你叫真理的话总不离开我口，","poem":1},{"lineBreak":true},{"text":"因我仰望你的典章。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"我要常守你的律法，","poem":1},{"lineBreak":true},{"text":"直到永永远远。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"我要自由而行","poem":1},{"noteId":49},{"text":"，","poem":1},{"lineBreak":true},{"text":"因我素来考究你的训词。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"我也要在君王面前论说你的法度，","poem":1},{"lineBreak":true},{"text":"并不至于羞愧。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"我要在你的命令中自乐；","poem":1},{"lineBreak":true},{"text":"这命令素来是我所爱的。","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"我又要遵行","poem":1},{"noteId":50},{"text":"你的命令，","poem":1},{"lineBreak":true},{"text":"这命令素来是我所爱的；","poem":1},{"lineBreak":true},{"text":"我也要思想你的律例。","poem":1}]},{"type":"heading","content":["因耶和华的律法而安稳"]},{"type":"verse","number":49,"content":[{"text":"求你记念向你仆人所应许的话，","poem":1},{"lineBreak":true},{"text":"叫我有盼望。","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"这话将我救活了；","poem":1},{"lineBreak":true},{"text":"我在患难中，因此得安慰。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"骄傲的人甚侮慢我，","poem":1},{"lineBreak":true},{"text":"我却未曾偏离你的律法。","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"耶和华啊，我记念你从古以来的典章，","poem":1},{"lineBreak":true},{"text":"就得了安慰。","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"我见恶人离弃你的律法，","poem":1},{"lineBreak":true},{"text":"就怒气发作，犹如火烧。","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"我在世寄居，","poem":1},{"lineBreak":true},{"text":"素来以你的律例为诗歌。","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"耶和华啊，我夜间记念你的名，","poem":1},{"lineBreak":true},{"text":"遵守你的律法。","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"我所以如此，","poem":1},{"lineBreak":true},{"text":"是因我守你的训词。","poem":1}]},{"type":"heading","content":["深爱耶和华的律法"]},{"type":"verse","number":57,"content":[{"text":"耶和华是我的福分；","poem":1},{"lineBreak":true},{"text":"我曾说，我要遵守你的言语。","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"我一心求过你的恩；","poem":1},{"lineBreak":true},{"text":"愿你照你的话怜悯我！","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"我思想我所行的道，","poem":1},{"lineBreak":true},{"text":"就转步归向你的法度。","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"我急忙遵守你的命令，","poem":1},{"lineBreak":true},{"text":"并不迟延。","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"恶人的绳索缠绕我，","poem":1},{"lineBreak":true},{"text":"我却没有忘记你的律法。","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"我因你公义的典章，","poem":1},{"lineBreak":true},{"text":"半夜必起来称谢你。","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"凡敬畏你、守你训词的人，","poem":1},{"lineBreak":true},{"text":"我都与他作伴。","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"耶和华啊，你的慈爱遍满大地；","poem":1},{"lineBreak":true},{"text":"求你将你的律例教训我！","poem":1}]},{"type":"heading","content":["耶和华律法的宝贵"]},{"type":"verse","number":65,"content":[{"text":"耶和华啊，你向来是照你的话善待仆人。","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"求你将精明和知识赐给我，","poem":1},{"lineBreak":true},{"text":"因我信了你的命令。","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"我未受苦以先走迷了路，","poem":1},{"lineBreak":true},{"text":"现在却遵守你的话。","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"你本为善，所行的也善；","poem":1},{"lineBreak":true},{"text":"求你将你的律例教训我！","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"骄傲人编造谎言攻击我，","poem":1},{"lineBreak":true},{"text":"我却要一心守你的训词。","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"他们心蒙脂油，","poem":1},{"lineBreak":true},{"text":"我却喜爱你的律法。","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"我受苦是与我有益，","poem":1},{"lineBreak":true},{"text":"为要使我学习你的律例。","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"你口中的训言","poem":1},{"noteId":51},{"text":"与我有益，","poem":1},{"lineBreak":true},{"text":"胜于千万的金银。","poem":1}]},{"type":"heading","content":["耶和华律法的公正"]},{"type":"verse","number":73,"content":[{"text":"你的手制造我，建立我；","poem":1},{"lineBreak":true},{"text":"求你赐我悟性，可以学习你的命令！","poem":1}]},{"type":"verse","number":74,"content":[{"lineBreak":true},{"text":"敬畏你的人见我就要欢喜，","poem":1},{"lineBreak":true},{"text":"因我仰望你的话。","poem":1}]},{"type":"verse","number":75,"content":[{"lineBreak":true},{"text":"耶和华啊，我知道你的判语是公义的；","poem":1},{"lineBreak":true},{"text":"你使我受苦是以诚实待我。","poem":1}]},{"type":"verse","number":76,"content":[{"lineBreak":true},{"text":"求你照着应许仆人的话，","poem":1},{"lineBreak":true},{"text":"以慈爱安慰我。","poem":1}]},{"type":"verse","number":77,"content":[{"lineBreak":true},{"text":"愿你的慈悲临到我，使我存活，","poem":1},{"lineBreak":true},{"text":"因你的律法是我所喜爱的。","poem":1}]},{"type":"verse","number":78,"content":[{"lineBreak":true},{"text":"愿骄傲人蒙羞，因为他们无理地倾覆我；","poem":1},{"lineBreak":true},{"text":"但我要思想你的训词。","poem":1}]},{"type":"verse","number":79,"content":[{"lineBreak":true},{"text":"愿敬畏你的人归向我，","poem":1},{"lineBreak":true},{"text":"他们就知道你的法度。","poem":1}]},{"type":"verse","number":80,"content":[{"lineBreak":true},{"text":"愿我的心在你的律例上完全，","poem":1},{"lineBreak":true},{"text":"使我不致蒙羞。","poem":1}]},{"type":"heading","content":["求主解救"]},{"type":"verse","number":81,"content":[{"text":"我心渴想你的救恩，","poem":1},{"lineBreak":true},{"text":"仰望你的应许。","poem":1}]},{"type":"verse","number":82,"content":[{"lineBreak":true},{"text":"我因盼望你的应许眼睛失明，说：","poem":1},{"lineBreak":true},{"text":"你何时安慰我？","poem":1}]},{"type":"verse","number":83,"content":[{"lineBreak":true},{"text":"我好像烟薰的皮袋，","poem":1},{"lineBreak":true},{"text":"却不忘记你的律例。","poem":1}]},{"type":"verse","number":84,"content":[{"lineBreak":true},{"text":"你仆人的年日有多少呢？","poem":1},{"lineBreak":true},{"text":"你几时向逼迫我的人施行审判呢？","poem":1}]},{"type":"verse","number":85,"content":[{"lineBreak":true},{"text":"不从你律法的骄傲人为我掘了坑。","poem":1}]},{"type":"verse","number":86,"content":[{"lineBreak":true},{"text":"你的命令尽都诚实；","poem":1},{"lineBreak":true},{"text":"他们无理地逼迫我，求你帮助我！","poem":1}]},{"type":"verse","number":87,"content":[{"lineBreak":true},{"text":"他们几乎把我从世上灭绝，","poem":1},{"lineBreak":true},{"text":"但我没有离弃你的训词。","poem":1}]},{"type":"verse","number":88,"content":[{"lineBreak":true},{"text":"求你照你的慈爱将我救活，","poem":1},{"lineBreak":true},{"text":"我就遵守你口中的法度。","poem":1}]},{"type":"heading","content":["信赖耶和华的律法"]},{"type":"verse","number":89,"content":[{"text":"耶和华啊，你的话安定在天，","poem":1},{"lineBreak":true},{"text":"直到永远。","poem":1}]},{"type":"verse","number":90,"content":[{"lineBreak":true},{"text":"你的诚实存到万代；","poem":1},{"lineBreak":true},{"text":"你坚定了地，地就长存。","poem":1}]},{"type":"verse","number":91,"content":[{"lineBreak":true},{"text":"天地照你的安排存到今日；","poem":1},{"lineBreak":true},{"text":"万物都是你的仆役。","poem":1}]},{"type":"verse","number":92,"content":[{"lineBreak":true},{"text":"我若不是喜爱你的律法，","poem":1},{"lineBreak":true},{"text":"早就在苦难中灭绝了！","poem":1}]},{"type":"verse","number":93,"content":[{"lineBreak":true},{"text":"我永不忘记你的训词，","poem":1},{"lineBreak":true},{"text":"因你用这训词将我救活了。","poem":1}]},{"type":"verse","number":94,"content":[{"lineBreak":true},{"text":"我是属你的，求你救我，","poem":1},{"lineBreak":true},{"text":"因我寻求了你的训词。","poem":1}]},{"type":"verse","number":95,"content":[{"lineBreak":true},{"text":"恶人等待我，要灭绝我，","poem":1},{"lineBreak":true},{"text":"我却要揣摩你的法度。","poem":1}]},{"type":"verse","number":96,"content":[{"lineBreak":true},{"text":"我看万事尽都有限，","poem":1},{"lineBreak":true},{"text":"惟有你的命令极其宽广。","poem":1}]},{"type":"heading","content":["喜爱耶和华的律法"]},{"type":"verse","number":97,"content":[{"text":"我何等爱慕你的律法，","poem":1},{"lineBreak":true},{"text":"终日不住地思想。","poem":1}]},{"type":"verse","number":98,"content":[{"lineBreak":true},{"text":"你的命令常存在我心里，","poem":1},{"lineBreak":true},{"text":"使我比仇敌有智慧。","poem":1}]},{"type":"verse","number":99,"content":[{"lineBreak":true},{"text":"我比我的师傅更通达，","poem":1},{"lineBreak":true},{"text":"因我思想你的法度。","poem":1}]},{"type":"verse","number":100,"content":[{"lineBreak":true},{"text":"我比年老的更明白，","poem":1},{"lineBreak":true},{"text":"因我守了你的训词。","poem":1}]},{"type":"verse","number":101,"content":[{"lineBreak":true},{"text":"我禁止我脚走一切的邪路，","poem":1},{"lineBreak":true},{"text":"为要遵守你的话。","poem":1}]},{"type":"verse","number":102,"content":[{"lineBreak":true},{"text":"我没有偏离你的典章，","poem":1},{"lineBreak":true},{"text":"因为你教训了我。","poem":1}]},{"type":"verse","number":103,"content":[{"lineBreak":true},{"text":"你的言语在我上膛何等甘美，","poem":1},{"lineBreak":true},{"text":"在我口中比蜜更甜！","poem":1}]},{"type":"verse","number":104,"content":[{"lineBreak":true},{"text":"我借着你的训词得以明白，","poem":1},{"lineBreak":true},{"text":"所以我恨一切的假道。","poem":1}]},{"type":"heading","content":["耶和华律法的亮光"]},{"type":"verse","number":105,"content":[{"text":"你的话是我脚前的灯，","poem":1},{"lineBreak":true},{"text":"是我路上的光。","poem":1}]},{"type":"verse","number":106,"content":[{"lineBreak":true},{"text":"你公义的典章，我曾起誓遵守，","poem":1},{"lineBreak":true},{"text":"我必按誓而行。","poem":1}]},{"type":"verse","number":107,"content":[{"lineBreak":true},{"text":"我甚是受苦；","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你照你的话将我救活！","poem":1}]},{"type":"verse","number":108,"content":[{"lineBreak":true},{"text":"耶和华啊，求你悦纳我口中的赞美为供物，","poem":1},{"lineBreak":true},{"text":"又将你的典章教训我！","poem":1}]},{"type":"verse","number":109,"content":[{"lineBreak":true},{"text":"我的性命常在危险之中，","poem":1},{"lineBreak":true},{"text":"我却不忘记你的律法。","poem":1}]},{"type":"verse","number":110,"content":[{"lineBreak":true},{"text":"恶人为我设下网罗，","poem":1},{"lineBreak":true},{"text":"我却没有偏离你的训词。","poem":1}]},{"type":"verse","number":111,"content":[{"lineBreak":true},{"text":"我以你的法度为永远的产业，","poem":1},{"lineBreak":true},{"text":"因这是我心中所喜爱的。","poem":1}]},{"type":"verse","number":112,"content":[{"lineBreak":true},{"text":"我的心专向你的律例，","poem":1},{"lineBreak":true},{"text":"永远遵行，一直到底。","poem":1}]},{"type":"heading","content":["因耶和华律法得安全"]},{"type":"verse","number":113,"content":[{"text":"心怀二意的人为我所恨；","poem":1},{"lineBreak":true},{"text":"但你的律法为我所爱。","poem":1}]},{"type":"verse","number":114,"content":[{"lineBreak":true},{"text":"你是我藏身之处，又是我的盾牌；","poem":1},{"lineBreak":true},{"text":"我甚仰望你的话语。","poem":1}]},{"type":"verse","number":115,"content":[{"lineBreak":true},{"text":"作恶的人哪，你们离开我吧！","poem":1},{"lineBreak":true},{"text":"我好遵守我 神的命令。","poem":1}]},{"type":"verse","number":116,"content":[{"lineBreak":true},{"text":"求你照你的话扶持我，使我存活，","poem":1},{"lineBreak":true},{"text":"也不叫我因失望而害羞。","poem":1}]},{"type":"verse","number":117,"content":[{"lineBreak":true},{"text":"求你扶持我，我便得救，","poem":1},{"lineBreak":true},{"text":"时常看重你的律例。","poem":1}]},{"type":"verse","number":118,"content":[{"lineBreak":true},{"text":"凡偏离你律例的人，你都轻弃他们，","poem":1},{"lineBreak":true},{"text":"因为他们的诡诈必归虚空。","poem":1}]},{"type":"verse","number":119,"content":[{"lineBreak":true},{"text":"凡地上的恶人，你除掉他，好像除掉渣滓；","poem":1},{"lineBreak":true},{"text":"因此我爱你的法度。","poem":1}]},{"type":"verse","number":120,"content":[{"lineBreak":true},{"text":"我因惧怕你，肉就发抖；","poem":1},{"lineBreak":true},{"text":"我也怕你的判语。","poem":1}]},{"type":"heading","content":["遵从耶和华的律法"]},{"type":"verse","number":121,"content":[{"text":"我行过公平和公义，","poem":1},{"lineBreak":true},{"text":"求你不要撇下我给欺压我的人！","poem":1}]},{"type":"verse","number":122,"content":[{"lineBreak":true},{"text":"求你为仆人作保，使我得好处，","poem":1},{"lineBreak":true},{"text":"不容骄傲人欺压我！","poem":1}]},{"type":"verse","number":123,"content":[{"lineBreak":true},{"text":"我因盼望你的救恩","poem":1},{"lineBreak":true},{"text":"和你公义的话眼睛失明。","poem":1}]},{"type":"verse","number":124,"content":[{"lineBreak":true},{"text":"求你照你的慈爱待仆人，","poem":1},{"lineBreak":true},{"text":"将你的律例教训我。","poem":1}]},{"type":"verse","number":125,"content":[{"lineBreak":true},{"text":"我是你的仆人，求你赐我悟性，","poem":1},{"lineBreak":true},{"text":"使我得知你的法度。","poem":1}]},{"type":"verse","number":126,"content":[{"lineBreak":true},{"text":"这是耶和华降罚的时候，","poem":1},{"lineBreak":true},{"text":"因人废了你的律法。","poem":1}]},{"type":"verse","number":127,"content":[{"lineBreak":true},{"text":"所以，我爱你的命令胜于金子，","poem":1},{"lineBreak":true},{"text":"更胜于精金。","poem":1}]},{"type":"verse","number":128,"content":[{"lineBreak":true},{"text":"你一切的训词，在万事上我都以为正直；","poem":1},{"lineBreak":true},{"text":"我却恨恶一切假道。","poem":1}]},{"type":"heading","content":["渴慕遵行耶和华的律法"]},{"type":"verse","number":129,"content":[{"text":"你的法度奇妙，","poem":1},{"lineBreak":true},{"text":"所以我一心谨守。","poem":1}]},{"type":"verse","number":130,"content":[{"lineBreak":true},{"text":"你的言语一解开就发出亮光，","poem":1},{"lineBreak":true},{"text":"使愚人通达。","poem":1}]},{"type":"verse","number":131,"content":[{"lineBreak":true},{"text":"我张口而气喘，","poem":1},{"lineBreak":true},{"text":"因我切慕你的命令。","poem":1}]},{"type":"verse","number":132,"content":[{"lineBreak":true},{"text":"求你转向我，怜悯我，","poem":1},{"lineBreak":true},{"text":"好像你素常待那些爱你名的人。","poem":1}]},{"type":"verse","number":133,"content":[{"lineBreak":true},{"text":"求你用你的话使我脚步稳当，","poem":1},{"lineBreak":true},{"text":"不许什么罪孽辖制我。","poem":1}]},{"type":"verse","number":134,"content":[{"lineBreak":true},{"text":"求你救我脱离人的欺压，","poem":1},{"lineBreak":true},{"text":"我要遵守你的训词。","poem":1}]},{"type":"verse","number":135,"content":[{"lineBreak":true},{"text":"求你用脸光照仆人，","poem":1},{"lineBreak":true},{"text":"又将你的律例教训我。","poem":1}]},{"type":"verse","number":136,"content":[{"lineBreak":true},{"text":"我的眼泪下流成河，","poem":1},{"lineBreak":true},{"text":"因为他们不守你的律法。","poem":1}]},{"type":"heading","content":["耶和华律法的公正"]},{"type":"verse","number":137,"content":[{"text":"耶和华啊，你是公义的；","poem":1},{"lineBreak":true},{"text":"你的判语也是正直的！","poem":1}]},{"type":"verse","number":138,"content":[{"lineBreak":true},{"text":"你所命定的法度是凭公义和至诚。","poem":1}]},{"type":"verse","number":139,"content":[{"lineBreak":true},{"text":"我心焦急，如同火烧，","poem":1},{"lineBreak":true},{"text":"因我敌人忘记你的言语。","poem":1}]},{"type":"verse","number":140,"content":[{"lineBreak":true},{"text":"你的话极其精炼，","poem":1},{"lineBreak":true},{"text":"所以你的仆人喜爱。","poem":1}]},{"type":"verse","number":141,"content":[{"lineBreak":true},{"text":"我微小，被人藐视，","poem":1},{"lineBreak":true},{"text":"却不忘记你的训词。","poem":1}]},{"type":"verse","number":142,"content":[{"lineBreak":true},{"text":"你的公义永远长存；","poem":1},{"lineBreak":true},{"text":"你的律法尽都真实。","poem":1}]},{"type":"verse","number":143,"content":[{"lineBreak":true},{"text":"我遭遇患难愁苦，","poem":1},{"lineBreak":true},{"text":"你的命令却是我所喜爱的。","poem":1}]},{"type":"verse","number":144,"content":[{"lineBreak":true},{"text":"你的法度永远是公义的；","poem":1},{"lineBreak":true},{"text":"求你赐我悟性，我就活了。","poem":1}]},{"type":"heading","content":["求主解救"]},{"type":"verse","number":145,"content":[{"text":"耶和华啊，我一心呼吁你；","poem":1},{"lineBreak":true},{"text":"求你应允我，我必谨守你的律例！","poem":1}]},{"type":"verse","number":146,"content":[{"lineBreak":true},{"text":"我向你呼吁，求你救我！","poem":1},{"lineBreak":true},{"text":"我要遵守你的法度。","poem":1}]},{"type":"verse","number":147,"content":[{"lineBreak":true},{"text":"我趁天未亮呼求；","poem":1},{"lineBreak":true},{"text":"我仰望了你的言语。","poem":1}]},{"type":"verse","number":148,"content":[{"lineBreak":true},{"text":"我趁夜更未换将眼睁开，","poem":1},{"lineBreak":true},{"text":"为要思想你的话语。","poem":1}]},{"type":"verse","number":149,"content":[{"lineBreak":true},{"text":"求你照你的慈爱听我的声音；","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你照你的典章将我救活！","poem":1}]},{"type":"verse","number":150,"content":[{"lineBreak":true},{"text":"追求奸恶的人临近了；","poem":1},{"lineBreak":true},{"text":"他们远离你的律法。","poem":1}]},{"type":"verse","number":151,"content":[{"lineBreak":true},{"text":"耶和华啊，你与我相近；","poem":1},{"lineBreak":true},{"text":"你一切的命令尽都真实！","poem":1}]},{"type":"verse","number":152,"content":[{"lineBreak":true},{"text":"我因学你的法度，","poem":1},{"lineBreak":true},{"text":"久已知道是你永远立定的。","poem":1}]},{"type":"heading","content":["请求恩助"]},{"type":"verse","number":153,"content":[{"text":"求你看顾我的苦难，搭救我，","poem":1},{"lineBreak":true},{"text":"因我不忘记你的律法。","poem":1}]},{"type":"verse","number":154,"content":[{"lineBreak":true},{"text":"求你为我辨屈，救赎我，","poem":1},{"lineBreak":true},{"text":"照你的话将我救活。","poem":1}]},{"type":"verse","number":155,"content":[{"lineBreak":true},{"text":"救恩远离恶人，","poem":1},{"lineBreak":true},{"text":"因为他们不寻求你的律例。","poem":1}]},{"type":"verse","number":156,"content":[{"lineBreak":true},{"text":"耶和华啊，你的慈悲本为大；","poem":1},{"lineBreak":true},{"text":"求你照你的典章将我救活。","poem":1}]},{"type":"verse","number":157,"content":[{"lineBreak":true},{"text":"逼迫我的，抵挡我的，很多，","poem":1},{"lineBreak":true},{"text":"我却没有偏离你的法度。","poem":1}]},{"type":"verse","number":158,"content":[{"lineBreak":true},{"text":"我看见奸恶的人就甚憎恶，","poem":1},{"lineBreak":true},{"text":"因为他们不遵守你的话。","poem":1}]},{"type":"verse","number":159,"content":[{"lineBreak":true},{"text":"你看我怎样爱你的训词！","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你照你的慈爱将我救活！","poem":1}]},{"type":"verse","number":160,"content":[{"lineBreak":true},{"text":"你话的总纲是真实；","poem":1},{"lineBreak":true},{"text":"你一切公义的典章是永远长存。","poem":1}]},{"type":"heading","content":["热爱耶和华的律法"]},{"type":"verse","number":161,"content":[{"text":"首领无故地逼迫我，","poem":1},{"lineBreak":true},{"text":"但我的心畏惧你的言语。","poem":1}]},{"type":"verse","number":162,"content":[{"lineBreak":true},{"text":"我喜爱你的话，","poem":1},{"lineBreak":true},{"text":"好像人得了许多掳物。","poem":1}]},{"type":"verse","number":163,"content":[{"lineBreak":true},{"text":"谎话是我所恨恶所憎嫌的；","poem":1},{"lineBreak":true},{"text":"惟你的律法是我所爱的。","poem":1}]},{"type":"verse","number":164,"content":[{"lineBreak":true},{"text":"我因你公义的典章一天七次赞美你。","poem":1}]},{"type":"verse","number":165,"content":[{"lineBreak":true},{"text":"爱你律法的人有大平安，","poem":1},{"lineBreak":true},{"text":"什么都不能使他们绊脚。","poem":1}]},{"type":"verse","number":166,"content":[{"lineBreak":true},{"text":"耶和华啊，我仰望了你的救恩，","poem":1},{"lineBreak":true},{"text":"遵行了你的命令。","poem":1}]},{"type":"verse","number":167,"content":[{"lineBreak":true},{"text":"我心里守了你的法度；","poem":1},{"lineBreak":true},{"text":"这法度我甚喜爱。","poem":1}]},{"type":"verse","number":168,"content":[{"lineBreak":true},{"text":"我遵守了你的训词和法度，","poem":1},{"lineBreak":true},{"text":"因我一切所行的都在你面前。","poem":1}]},{"type":"heading","content":["求主帮助"]},{"type":"verse","number":169,"content":[{"text":"耶和华啊，愿我的呼吁达到你面前，","poem":1},{"lineBreak":true},{"text":"照你的话赐我悟性。","poem":1}]},{"type":"verse","number":170,"content":[{"lineBreak":true},{"text":"愿我的恳求达到你面前，","poem":1},{"lineBreak":true},{"text":"照你的话搭救我。","poem":1}]},{"type":"verse","number":171,"content":[{"lineBreak":true},{"text":"愿我的嘴发出赞美的话，","poem":1},{"lineBreak":true},{"text":"因为你将律例教训我。","poem":1}]},{"type":"verse","number":172,"content":[{"lineBreak":true},{"text":"愿我的舌头歌唱你的话，","poem":1},{"lineBreak":true},{"text":"因你一切的命令尽都公义。","poem":1}]},{"type":"verse","number":173,"content":[{"lineBreak":true},{"text":"愿你用手帮助我，","poem":1},{"lineBreak":true},{"text":"因我拣选了你的训词。","poem":1}]},{"type":"verse","number":174,"content":[{"lineBreak":true},{"text":"耶和华啊，我切慕你的救恩！","poem":1},{"lineBreak":true},{"text":"你的律法也是我所喜爱的。","poem":1}]},{"type":"verse","number":175,"content":[{"lineBreak":true},{"text":"愿我的性命存活，得以赞美你！","poem":1},{"lineBreak":true},{"text":"愿你的典章帮助我！","poem":1}]},{"type":"verse","number":176,"content":[{"lineBreak":true},{"text":"我如亡羊走迷了路，求你寻找仆人，","poem":1},{"lineBreak":true},{"text":"因我不忘记你的命令。","poem":1}]}],"footnotes":[{"noteId":49,"caller":"-","text":"或译：我要行在宽阔之地","reference":{"chapter":119,"verse":45}},{"noteId":50,"caller":"-","text":"原文是举手","reference":{"chapter":119,"verse":48}},{"noteId":51,"caller":"-","text":"或译：律法","reference":{"chapter":119,"verse":72}}]},"thisChapterLink":"/api/cmn_cu1/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}