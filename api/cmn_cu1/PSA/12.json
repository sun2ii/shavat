{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":12,"content":[{"type":"heading","content":["求助的祈祷"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。调用第八。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你帮助，因虔诚人断绝了；","poem":1},{"lineBreak":true},{"text":"世人中间的忠信人没有了。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"人人向邻舍说谎；","poem":1},{"lineBreak":true},{"text":"他们说话，是嘴唇油滑，心口不一。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"凡油滑的嘴唇和夸大的舌头，","poem":1},{"lineBreak":true},{"text":"耶和华必要剪除。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们曾说：我们必能以舌头得胜；","poem":1},{"lineBreak":true},{"text":"我们的嘴唇是我们自己的，","poem":1},{"lineBreak":true},{"text":"谁能作我们的主呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和华说：因为困苦人的冤屈","poem":1},{"lineBreak":true},{"text":"和贫穷人的叹息，","poem":1},{"lineBreak":true},{"text":"我现在要起来，","poem":1},{"lineBreak":true},{"text":"把他安置在他所切慕的稳妥之地。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华的言语是纯净的言语，","poem":1},{"lineBreak":true},{"text":"如同银子在泥炉中炼过七次。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华啊，你必保护他们；","poem":1},{"lineBreak":true},{"text":"你必保佑他们永远脱离这世代的人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"下流人在世人中升高，","poem":1},{"lineBreak":true},{"text":"就有恶人到处游行。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}