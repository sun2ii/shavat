{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":120,"content":[{"type":"heading","content":["求主恩助"]},{"type":"hebrew_subtitle","content":["上行（或作登阶，下同）之诗。"]},{"type":"verse","number":1,"content":[{"text":"我在急难中求告耶和华，","poem":1},{"lineBreak":true},{"text":"他就应允我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华啊，求你救我脱离说谎的嘴唇和诡诈的舌头！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"诡诈的舌头啊，要给你什么呢？","poem":1},{"lineBreak":true},{"text":"要拿什么加给你呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"就是勇士的利箭和罗腾木","poem":1},{"noteId":52},{"text":"的炭火。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我寄居在米设，","poem":1},{"lineBreak":true},{"text":"住在基达帐棚之中，有祸了！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我与那恨恶和睦的人许久同住。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我愿和睦，","poem":1},{"lineBreak":true},{"text":"但我发言，他们就要争战。","poem":1}]}],"footnotes":[{"noteId":52,"caller":"-","text":"小树名，松类","reference":{"chapter":120,"verse":4}}]},"thisChapterLink":"/api/cmn_cu1/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}