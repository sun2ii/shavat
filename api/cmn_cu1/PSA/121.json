lineBreak":true},{"text":"他要保护你的性命。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你出你入，耶和华要保护你，","poem":1},{"lineBreak":true},{"text":"从今时直到永远。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}