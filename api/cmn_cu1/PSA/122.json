{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":122,"content":[{"type":"heading","content":["耶路撒冷颂"]},{"type":"hebrew_subtitle","content":["大卫上行之诗。"]},{"type":"verse","number":1,"content":[{"text":"人对我说：我们往耶和华的殿去，","poem":1},{"lineBreak":true},{"text":"我就欢喜。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，","poem":1},{"lineBreak":true},{"text":"我们的脚站在你的门内。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶路撒冷被建造，","poem":1},{"lineBreak":true},{"text":"如同连络整齐的一座城。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"众支派，就是耶和华的支派，上那里去，","poem":1},{"lineBreak":true},{"text":"按以色列的常例","poem":1},{"noteId":53},{"text":"称赞耶和华的名。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因为在那里设立审判的宝座，","poem":1},{"lineBreak":true},{"text":"就是大卫家的宝座。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"你们要为耶路撒冷求平安！","poem":1},{"lineBreak":true},{"text":"耶路撒冷啊，爱你的人必然兴旺！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愿你城中平安！","poem":1},{"lineBreak":true},{"text":"愿你宫内兴旺！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因我弟兄和同伴的缘故，我要说：","poem":1},{"lineBreak":true},{"text":"愿平安在你中间！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因耶和华—我们 神殿的缘故，","poem":1},{"lineBreak":true},{"text":"我要为你求福！","poem":1}]}],"footnotes":[{"noteId":53,"caller":"-","text":"或译：作以色列的证据","reference":{"chapter":122,"verse":4}}]},"thisChapterLink":"/api/cmn_cu1/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}