{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":123,"content":[{"type":"heading","content":["求主怜悯"]},{"type":"hebrew_subtitle","content":["上行之诗。"]},{"type":"verse","number":1,"content":[{"text":"坐在天上的主啊，","poem":1},{"lineBreak":true},{"text":"我向你举目。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"看哪，仆人的眼睛怎样望主人的手，","poem":1},{"lineBreak":true},{"text":"使女的眼睛怎样望主母的手，","poem":1},{"lineBreak":true},{"text":"我们的眼睛也照样望耶和华—我们的 神，","poem":1},{"lineBreak":true},{"text":"直到他怜悯我们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和华啊，求你怜悯我们，怜悯我们！","poem":1},{"lineBreak":true},{"text":"因为我们被藐视，已到极处。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们被那些安逸人的讥诮","poem":1},{"lineBreak":true},{"text":"和骄傲人的藐视，已到极处。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}