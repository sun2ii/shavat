{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":124,"content":[{"type":"heading","content":["神是他子民的保护者"]},{"type":"hebrew_subtitle","content":["大卫上行之诗。"]},{"type":"verse","number":1,"content":[{"text":"以色列人要说：","poem":1},{"lineBreak":true},{"text":"若不是耶和华帮助我们，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"若不是耶和华帮助我们，","poem":1},{"lineBreak":true},{"text":"当人起来攻击我们、","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"向我们发怒的时候，","poem":1},{"lineBreak":true},{"text":"就把我们活活地吞了。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"那时，波涛必漫过我们，","poem":1},{"lineBreak":true},{"text":"河水必淹没我们，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"狂傲的水必淹没我们。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华是应当称颂的！","poem":1},{"lineBreak":true},{"text":"他没有把我们当野食交给他们吞吃","poem":1},{"noteId":54},{"text":"。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我们好像雀鸟，从捕鸟人的网罗里逃脱；","poem":1},{"lineBreak":true},{"text":"网罗破裂，我们逃脱了。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我们得帮助，","poem":1},{"lineBreak":true},{"text":"是在乎倚靠造天地之耶和华的名。","poem":1}]}],"footnotes":[{"noteId":54,"caller":"-","text":"原文是牙齿","reference":{"chapter":124,"verse":6}}]},"thisChapterLink":"/api/cmn_cu1/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}