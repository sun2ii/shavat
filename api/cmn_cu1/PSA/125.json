{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":125,"content":[{"type":"heading","content":["耶和华子民的安全"]},{"type":"hebrew_subtitle","content":["上行之诗。"]},{"type":"verse","number":1,"content":[{"text":"倚靠耶和华的人","poem":1},{"lineBreak":true},{"text":"好像锡安山，永不动摇。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"众山怎样围绕耶路撒冷，","poem":1},{"lineBreak":true},{"text":"耶和华也照样围绕他的百姓，","poem":1},{"lineBreak":true},{"text":"从今时直到永远。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"恶人的杖不常落在义人的分上，","poem":1},{"lineBreak":true},{"text":"免得义人伸手作恶。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华啊，求你善待那些为善","poem":1},{"lineBreak":true},{"text":"和心里正直的人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"至于那偏行弯曲道路的人，","poem":1},{"lineBreak":true},{"text":"耶和华必使他和作恶的人一同出去受刑。","poem":1},{"lineBreak":true},{"text":"愿平安归于以色列！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}