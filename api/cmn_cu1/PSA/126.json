{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":126,"content":[{"type":"heading","content":["被掳归回者的欢乐"]},{"type":"hebrew_subtitle","content":["上行之诗。"]},{"type":"verse","number":1,"content":[{"text":"当耶和华将那些被掳的带回锡安的时候，","poem":1},{"lineBreak":true},{"text":"我们好像做梦的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我们满口喜笑、","poem":1},{"lineBreak":true},{"text":"满舌欢呼的时候，","poem":1},{"lineBreak":true},{"text":"外邦中就有人说：","poem":1},{"lineBreak":true},{"text":"耶和华为他们行了大事！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华果然为我们行了大事，","poem":1},{"lineBreak":true},{"text":"我们就欢喜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华啊，求你使我们被掳的人归回，","poem":1},{"lineBreak":true},{"text":"好像南地的河水复流。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"流泪撒种的，","poem":1},{"lineBreak":true},{"text":"必欢呼收割！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"那带种流泪出去的，","poem":1},{"lineBreak":true},{"text":"必要欢欢乐乐地带禾捆回来！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}