{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":127,"content":[{"type":"heading","content":["称颂 神的良善"]},{"type":"hebrew_subtitle","content":["所罗门上行之诗。"]},{"type":"verse","number":1,"content":[{"text":"若不是耶和华建造房屋，","poem":1},{"lineBreak":true},{"text":"建造的人就枉然劳力；","poem":1},{"lineBreak":true},{"text":"若不是耶和华看守城池，","poem":1},{"lineBreak":true},{"text":"看守的人就枉然警醒。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们清晨早起，夜晚安歇，","poem":1},{"lineBreak":true},{"text":"吃劳碌得来的饭，本是枉然；","poem":1},{"lineBreak":true},{"text":"惟有耶和华所亲爱的，必叫他安然睡觉。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"儿女是耶和华所赐的产业；","poem":1},{"lineBreak":true},{"text":"所怀的胎是他所给的赏赐。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"少年时所生的儿女","poem":1},{"lineBreak":true},{"text":"好像勇士手中的箭。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"箭袋充满的人便为有福；","poem":1},{"lineBreak":true},{"text":"他们在城门口和仇敌说话的时候，","poem":1},{"lineBreak":true},{"text":"必不至于羞愧。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}