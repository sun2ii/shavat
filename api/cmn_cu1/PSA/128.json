{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":128,"content":[{"type":"heading","content":["顺从耶和华的赏报"]},{"type":"hebrew_subtitle","content":["上行之诗。"]},{"type":"verse","number":1,"content":[{"text":"凡敬畏耶和华、","poem":1},{"lineBreak":true},{"text":"遵行他道的人便为有福！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你要吃劳碌得来的；","poem":1},{"lineBreak":true},{"text":"你要享福，事情顺利。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你妻子在你的内室，好像多结果子的葡萄树；","poem":1},{"lineBreak":true},{"text":"你儿女围绕你的桌子，好像橄榄栽子。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"看哪，敬畏耶和华的人必要这样蒙福！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"愿耶和华从锡安赐福给你！","poem":1},{"lineBreak":true},{"text":"愿你一生一世看见耶路撒冷的好处！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愿你看见你儿女的儿女！","poem":1},{"lineBreak":true},{"text":"愿平安归于以色列！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}