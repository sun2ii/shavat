{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":129,"content":[{"type":"heading","content":["求耶和华退敌"]},{"type":"hebrew_subtitle","content":["上行之诗。"]},{"type":"verse","number":1,"content":[{"text":"以色列当说：从我幼年以来，","poem":1},{"lineBreak":true},{"text":"敌人屡次苦害我，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"从我幼年以来，敌人屡次苦害我，","poem":1},{"lineBreak":true},{"text":"却没有胜了我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"如同扶犁的在我背上扶犁而耕，","poem":1},{"lineBreak":true},{"text":"耕的犁沟甚长。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华是公义的；","poem":1},{"lineBreak":true},{"text":"他砍断了恶人的绳索。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愿恨恶锡安的都蒙羞退后！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愿他们像房顶上的草，","poem":1},{"lineBreak":true},{"text":"未长成而枯干，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"收割的不够一把，","poem":1},{"lineBreak":true},{"text":"捆禾的也不满怀。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"过路的也不说：","poem":1},{"lineBreak":true},{"text":"愿耶和华所赐的福归与你们！","poem":1},{"lineBreak":true},{"text":"我们奉耶和华的名给你们祝福！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}