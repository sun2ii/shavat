{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":13,"content":[{"type":"heading","content":["求耶和华看顾"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，你忘记我要到几时呢？要到永远吗？","poem":1},{"lineBreak":true},{"text":"你掩面不顾我要到几时呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我心里筹算，终日愁苦，要到几时呢？","poem":1},{"lineBreak":true},{"text":"我的仇敌升高压制我，要到几时呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和华—我的 神啊，求你看顾我，应允我！","poem":1},{"lineBreak":true},{"text":"使我眼目光明，免得我沉睡至死；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"免得我的仇敌说：我胜了他；","poem":1},{"lineBreak":true},{"text":"免得我的敌人在我摇动的时候喜乐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"但我倚靠你的慈爱；","poem":1},{"lineBreak":true},{"text":"我的心因你的救恩快乐。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我要向耶和华歌唱，","poem":1},{"lineBreak":true},{"text":"因他用厚恩待我。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}