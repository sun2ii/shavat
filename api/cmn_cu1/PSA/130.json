{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":130,"content":[{"type":"heading","content":["求助的祈祷"]},{"type":"hebrew_subtitle","content":["上行之诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我从深处向你求告！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"主啊，求你听我的声音！","poem":1},{"lineBreak":true},{"text":"愿你侧耳听我恳求的声音！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"主—耶和华啊，你若究察罪孽，","poem":1},{"lineBreak":true},{"text":"谁能站得住呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"但在你有赦免之恩，","poem":1},{"lineBreak":true},{"text":"要叫人敬畏你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我等候耶和华，我的心等候；","poem":1},{"lineBreak":true},{"text":"我也仰望他的话。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的心等候主，","poem":1},{"lineBreak":true},{"text":"胜于守夜的，等候天亮，","poem":1},{"lineBreak":true},{"text":"胜于守夜的，等候天亮。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"以色列啊，你当仰望耶和华！","poem":1},{"lineBreak":true},{"text":"因他有慈爱，有丰盛的救恩。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他必救赎以色列脱离一切的罪孽。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}