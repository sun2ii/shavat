{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":132,"content":[{"type":"heading","content":["圣殿颂"]},{"type":"hebrew_subtitle","content":["上行之诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你记念大卫所受的一切苦难！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他怎样向耶和华起誓，","poem":1},{"lineBreak":true},{"text":"向雅各的大能者许愿，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"说：我必不进我的帐幕，","poem":1},{"lineBreak":true},{"text":"也不上我的床榻；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我不容我的眼睛睡觉，","poem":1},{"lineBreak":true},{"text":"也不容我的眼目打盹；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"直等我为耶和华寻得所在，","poem":1},{"lineBreak":true},{"text":"为雅各的大能者寻得居所。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我们听说约柜在以法他，","poem":1},{"lineBreak":true},{"text":"我们在基列·耶琳就寻见了。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我们要进他的居所，","poem":1},{"lineBreak":true},{"text":"在他脚凳前下拜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华啊，求你兴起，","poem":1},{"lineBreak":true},{"text":"和你有能力的约柜同入安息之所！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愿你的祭司披上公义！","poem":1},{"lineBreak":true},{"text":"愿你的圣民欢呼！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"求你因你仆人大卫的缘故，","poem":1},{"lineBreak":true},{"text":"不要厌弃你的受膏者！","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和华向大卫、凭诚实起了誓，","poem":1},{"lineBreak":true},{"text":"必不反复，说：","poem":1},{"lineBreak":true},{"text":"我要使你所生的","poem":1},{"lineBreak":true},{"text":"坐在你的宝座上。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你的众子若守我的约","poem":1},{"lineBreak":true},{"text":"和我所教训他们的法度，","poem":1},{"lineBreak":true},{"text":"他们的子孙必永远坐在你的宝座上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"因为耶和华拣选了锡安，","poem":1},{"lineBreak":true},{"text":"愿意当作自己的居所，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"说：这是我永远安息之所；","poem":1},{"lineBreak":true},{"text":"我要住在这里，","poem":1},{"lineBreak":true},{"text":"因为是我所愿意的。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要使其中的粮食丰满，","poem":1},{"lineBreak":true},{"text":"使其中的穷人饱足。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要使祭司披上救恩，","poem":1},{"lineBreak":true},{"text":"圣民大声欢呼！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我要叫大卫的角在那里发生；","poem":1},{"lineBreak":true},{"text":"我为我的受膏者预备明灯。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要使他的仇敌披上羞耻；","poem":1},{"lineBreak":true},{"text":"但他的冠冕要在头上发光。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}