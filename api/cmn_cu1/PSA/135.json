{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":135,"content":[{"type":"heading","content":["称颂的圣诗"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华的名！","poem":1},{"lineBreak":true},{"text":"耶和华的仆人站在耶和华殿中；","poem":1},{"lineBreak":true},{"text":"站在我们 神殿院中的，你们要赞美他！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"耶和华本为善；","poem":1},{"lineBreak":true},{"text":"要歌颂他的名，","poem":1},{"lineBreak":true},{"text":"因为这是美好的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华拣选雅各归自己，","poem":1},{"lineBreak":true},{"text":"拣选以色列特作自己的子民。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"原来我知道耶和华为大，","poem":1},{"lineBreak":true},{"text":"也知道我们的主超乎万神之上。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华在天上，在地下，","poem":1},{"lineBreak":true},{"text":"在海中，在一切的深处，","poem":1},{"lineBreak":true},{"text":"都随自己的意旨而行。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他使云雾从地极上腾，","poem":1},{"lineBreak":true},{"text":"造电随雨而闪，","poem":1},{"lineBreak":true},{"text":"从府库中带出风来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"他将埃及头生的，","poem":1},{"lineBreak":true},{"text":"连人带牲畜都击杀了。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"埃及啊，他施行神迹奇事，","poem":1},{"lineBreak":true},{"text":"在你当中，在法老和他一切臣仆身上。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他击杀许多的民，","poem":1},{"lineBreak":true},{"text":"又杀戮大能的王，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"就是亚摩利王西宏和巴珊王噩，","poem":1},{"lineBreak":true},{"text":"并迦南一切的国王，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"将他们的地赏赐他的百姓以色列为业。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和华啊，你的名存到永远！","poem":1},{"lineBreak":true},{"text":"耶和华啊，你可记念的名存到万代！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华要为他的百姓伸冤，","poem":1},{"lineBreak":true},{"text":"为他的仆人后悔。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"外邦的偶像是金的，银的，","poem":1},{"lineBreak":true},{"text":"是人手所造的；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"有口却不能言，","poem":1},{"lineBreak":true},{"text":"有眼却不能看，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"有耳却不能听，","poem":1},{"lineBreak":true},{"text":"口中也没有气息。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"造他的要和他一样，","poem":1},{"lineBreak":true},{"text":"凡靠他的也要如此。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"以色列家啊，你们要称颂耶和华！","poem":1},{"lineBreak":true},{"text":"亚伦家啊，你们要称颂耶和华！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"利未家啊，你们要称颂耶和华！","poem":1},{"lineBreak":true},{"text":"你们敬畏耶和华的，要称颂耶和华！","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"住在耶路撒冷的耶和华","poem":1},{"lineBreak":true},{"text":"该从锡安受称颂。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":20}