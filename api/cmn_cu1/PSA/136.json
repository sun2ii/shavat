{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":136,"content":[{"type":"heading","content":["感恩的圣诗"]},{"type":"verse","number":1,"content":[{"text":"你们要称谢耶和华，因他本为善；","poem":1},{"lineBreak":true},{"text":"他的慈爱永远长存。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们要称谢万神之神，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们要称谢万主之主，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"称谢那独行大奇事的，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"称谢那用智慧造天的，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"称谢那铺地在水以上的，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"称谢那造成大光的，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他造日头管白昼，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他造月亮星宿管黑夜，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"称谢那击杀埃及人之长子的，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他领以色列人从他们中间出来，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他施展大能的手和伸出来的膀臂，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"称谢那分裂红海的，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他领以色列从其中经过，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"却把法老和他的军兵推翻在红海里，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"称谢那引导自己的民行走旷野的，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"称谢那击杀大君王的，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他杀戮有名的君王，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"就是杀戮亚摩利王西宏，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"又杀巴珊王噩，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他将他们的地赐他的百姓为业，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存；","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"就是赐他的仆人以色列为业，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"他顾念我们在卑微的地步，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他救拔我们脱离敌人，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他赐粮食给凡有血气的，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"你们要称谢天上的 神，","poem":1},{"lineBreak":true},{"text":"因他的慈爱永远长存。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}