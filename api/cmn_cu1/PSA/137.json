{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":137,"content":[{"type":"heading","content":["以色列人被掳的哀歌"]},{"type":"verse","number":1,"content":[{"text":"我们曾在巴比伦的河边坐下，","poem":1},{"lineBreak":true},{"text":"一追想锡安就哭了。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我们把琴挂在那里的柳树上；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为在那里，掳掠我们的要我们唱歌，","poem":1},{"lineBreak":true},{"text":"抢夺我们的要我们作乐，说：","poem":1},{"lineBreak":true},{"text":"给我们唱一首锡安歌吧！","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我们怎能在外邦唱耶和华的歌呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，我若忘记你，","poem":1},{"lineBreak":true},{"text":"情愿我的右手忘记技巧！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我若不记念你，","poem":1},{"lineBreak":true},{"text":"若不看耶路撒冷过于我所最喜乐的，","poem":1},{"lineBreak":true},{"text":"情愿我的舌头贴于上膛！","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶路撒冷遭难的日子，","poem":1},{"lineBreak":true},{"text":"以东人说：拆毁！拆毁！","poem":1},{"lineBreak":true},{"text":"直拆到根基！","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你记念这仇！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"将要被灭的巴比伦城啊","poem":1},{"noteId":55},{"text":"，","poem":1},{"lineBreak":true},{"text":"报复你像你待我们的，那人便为有福！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"拿你的婴孩摔在磐石上的，","poem":1},{"lineBreak":true},{"text":"那人便为有福！","poem":1}]}],"footnotes":[{"noteId":55,"caller":"-","text":"城：原文是女子","reference":{"chapter":137,"verse":8}}]},"thisChapterLink":"/api/cmn_cu1/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}