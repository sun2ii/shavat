{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":138,"content":[{"type":"heading","content":["感恩之祷"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"我要一心称谢你，","poem":1},{"lineBreak":true},{"text":"在诸神面前歌颂你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要向你的圣殿下拜，","poem":1},{"lineBreak":true},{"text":"为你的慈爱和诚实称赞你的名；","poem":1},{"lineBreak":true},{"text":"因你使你的话显为大，","poem":1},{"lineBreak":true},{"text":"过于你所应许的","poem":1},{"noteId":56},{"text":"。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我呼求的日子，你就应允我，","poem":1},{"lineBreak":true},{"text":"鼓励我，使我心里有能力。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华啊，地上的君王都要称谢你，","poem":1},{"lineBreak":true},{"text":"因他们听见了你口中的言语。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们要歌颂耶和华的作为，","poem":1},{"lineBreak":true},{"text":"因耶和华大有荣耀。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华虽高，仍看顾低微的人；","poem":1},{"lineBreak":true},{"text":"他却从远处看出骄傲的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我虽行在患难中，你必将我救活；","poem":1},{"lineBreak":true},{"text":"我的仇敌发怒，你必伸手抵挡他们；","poem":1},{"lineBreak":true},{"text":"你的右手也必救我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华必成全关乎我的事；","poem":1},{"lineBreak":true},{"text":"耶和华啊，你的慈爱永远长存！","poem":1},{"lineBreak":true},{"text":"求你不要离弃你手所造的。","poem":1}]}],"footnotes":[{"noteId":56,"caller":"-","text":"或译：超乎你的名声","reference":{"chapter":138,"verse":2}}]},"thisChapterLink":"/api/cmn_cu1/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}