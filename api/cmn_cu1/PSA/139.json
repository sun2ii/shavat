{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":139,"content":[{"type":"heading","content":["耶和华的全知和眷顾"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，你已经鉴察我，认识我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我坐下，我起来，你都晓得；","poem":1},{"lineBreak":true},{"text":"你从远处知道我的意念。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我行路，我躺卧，你都细察；","poem":1},{"lineBreak":true},{"text":"你也深知我一切所行的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华啊，我舌头上的话，","poem":1},{"lineBreak":true},{"text":"你没有一句不知道的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你在我前后环绕我，","poem":1},{"lineBreak":true},{"text":"按手在我身上。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"这样的知识奇妙，是我不能测的，","poem":1},{"lineBreak":true},{"text":"至高，是我不能及的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我往哪里去躲避你的灵？","poem":1},{"lineBreak":true},{"text":"我往哪里逃、躲避你的面？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我若升到天上，你在那里；","poem":1},{"lineBreak":true},{"text":"我若在阴间下榻，你也在那里。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我若展开清晨的翅膀，","poem":1},{"lineBreak":true},{"text":"飞到海极居住，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"就是在那里，你的手必引导我；","poem":1},{"lineBreak":true},{"text":"你的右手也必扶持我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我若说：黑暗必定遮蔽我，","poem":1},{"lineBreak":true},{"text":"我周围的亮光必成为黑夜；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"黑暗也不能遮蔽我，使你不见，","poem":1},{"lineBreak":true},{"text":"黑夜却如白昼发亮。","poem":1},{"lineBreak":true},{"text":"黑暗和光明，在你看都是一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我的肺腑是你所造的；","poem":1},{"lineBreak":true},{"text":"我在母腹中，你已覆庇我。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我要称谢你，因我受造，奇妙可畏；","poem":1},{"lineBreak":true},{"text":"你的作为奇妙，这是我心深知道的。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我在暗中受造，在地的深处被联络；","poem":1},{"lineBreak":true},{"text":"那时，我的形体并不向你隐藏。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我未成形的体质，你的眼早已看见了；","poem":1},{"lineBreak":true},{"text":"你所定的日子，我尚未度一日","poem":1},{"noteId":57},{"text":"，","poem":1},{"lineBreak":true},{"text":"你都写在你的册上了。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"神啊，你的意念向我何等宝贵！","poem":1},{"lineBreak":true},{"text":"其数何等众多！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我若数点，比海沙更多；","poem":1},{"lineBreak":true},{"text":"我睡醒的时候，仍和你同在。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"神啊，你必要杀戮恶人；","poem":1},{"lineBreak":true},{"text":"所以，你们好流人血的，离开我去吧！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"因为他们说恶言顶撞你；","poem":1},{"lineBreak":true},{"text":"你的仇敌也妄称你的名。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和华啊，恨恶你的，我岂不恨恶他们吗？","poem":1},{"lineBreak":true},{"text":"攻击你的，我岂不憎嫌他们吗？","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我切切地恨恶他们，","poem":1},{"lineBreak":true},{"text":"以他们为仇敌。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"神啊，求你鉴察我，知道我的心思，","poem":1},{"lineBreak":true},{"text":"试炼我，知道我的意念，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"看在我里面有什么恶行没有，","poem":1},{"lineBreak":true},{"text":"引导我走永生的道路。","poem":1}]}],"footnotes":[{"noteId":57,"caller":"-","text":"或译：我被造的肢体尚未有其一","reference":{"chapter":139,"verse":16}}]},"thisChapterLink":"/api/cmn_cu1/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}