{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":14,"content":[{"type":"heading","content":["人的邪恶"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"愚顽人心里说：没有 神。","poem":1},{"lineBreak":true},{"text":"他们都是邪恶，行了可憎恶的事；","poem":1},{"lineBreak":true},{"text":"没有一个人行善。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"耶和华从天上垂看世人，","poem":1},{"lineBreak":true},{"text":"要看有明白的没有，","poem":1},{"lineBreak":true},{"text":"有寻求 神的没有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"他们都偏离正路，","poem":1},{"lineBreak":true},{"text":"一同变为污秽；","poem":1},{"lineBreak":true},{"text":"并没有行善的，","poem":1},{"lineBreak":true},{"text":"连一个也没有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"作孽的都没有知识吗？","poem":1},{"lineBreak":true},{"text":"他们吞吃我的百姓，如同吃饭一样，","poem":1},{"lineBreak":true},{"text":"并不求告耶和华。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"他们在那里大大地害怕，","poem":1},{"lineBreak":true},{"text":"因为 神在义人的族类中。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你们叫困苦人的谋算变为羞辱；","poem":1},{"lineBreak":true},{"text":"然而耶和华是他的避难所。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"但愿以色列的救恩从锡安而出。","poem":1},{"lineBreak":true},{"text":"耶和华救回他被掳的子民那时，","poem":1},{"lineBreak":true},{"text":"雅各要快乐，以色列要欢喜。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}