{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":140,"content":[{"type":"heading","content":["求耶和华护佑"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你拯救我脱离凶恶的人，","poem":1},{"lineBreak":true},{"text":"保护我脱离强暴的人！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他们心中图谋奸恶，","poem":1},{"lineBreak":true},{"text":"常常聚集要争战。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们使舌头尖利如蛇，","poem":1},{"lineBreak":true},{"text":"嘴里有虺蛇的毒气。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华啊，求你拯救我脱离恶人的手，","poem":1},{"lineBreak":true},{"text":"保护我脱离强暴的人！","poem":1},{"lineBreak":true},{"text":"他们图谋推我跌倒。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"骄傲人为我暗设网罗和绳索；","poem":1},{"lineBreak":true},{"text":"他们在路旁铺下网，设下圈套。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我曾对耶和华说：你是我的 神。","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你留心听我恳求的声音！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"主—耶和华、我救恩的力量啊，","poem":1},{"lineBreak":true},{"text":"在争战的日子，你遮蔽了我的头。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华啊，求你不要遂恶人的心愿；","poem":1},{"lineBreak":true},{"text":"不要成就他们的计谋，恐怕他们自高。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"至于那些昂首围困我的人，","poem":1},{"lineBreak":true},{"text":"愿他们嘴唇的奸恶陷害","poem":1},{"noteId":58},{"text":"自己！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"愿火炭落在他们身上！","poem":1},{"lineBreak":true},{"text":"愿他们被丢在火中，","poem":1},{"lineBreak":true},{"text":"抛在深坑里，不能再起来。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"说恶言的人在地上必坚立不住；","poem":1},{"lineBreak":true},{"text":"祸患必猎取强暴的人，将他打倒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"我知道耶和华必为困苦人伸冤，","poem":1},{"lineBreak":true},{"text":"必为穷乏人辨屈。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"义人必要称赞你的名；","poem":1},{"lineBreak":true},{"text":"正直人必住在你面前。","poem":1}]}],"footnotes":[{"noteId":58,"caller":"-","text":"原文是遮蔽","reference":{"chapter":140,"verse":9}}]},"thisChapterLink":"/api/cmn_cu1/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}