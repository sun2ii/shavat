{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":141,"content":[{"type":"heading","content":["晚 祷"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我曾求告你，","poem":1},{"lineBreak":true},{"text":"求你快快临到我这里！","poem":1},{"lineBreak":true},{"text":"我求告你的时候，","poem":1},{"lineBreak":true},{"text":"愿你留心听我的声音！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿我的祷告如香陈列在你面前！","poem":1},{"lineBreak":true},{"text":"愿我举手祈求，如献晚祭！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和华啊，求你禁止我的口，","poem":1},{"lineBreak":true},{"text":"把守我的嘴！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"求你不叫我的心偏向邪恶，","poem":1},{"lineBreak":true},{"text":"以致我和作孽的人同行恶事；","poem":1},{"lineBreak":true},{"text":"也不叫我吃他们的美食。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"任凭义人击打我，这算为仁慈；","poem":1},{"lineBreak":true},{"text":"任凭他责备我，这算为头上的膏油；","poem":1},{"lineBreak":true},{"text":"我的头不要躲闪。","poem":1},{"lineBreak":true},{"text":"正在他们行恶的时候，我仍要祈祷。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们的审判官被扔在岩下；","poem":1},{"lineBreak":true},{"text":"众人要听我的话，因为这话甘甜。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我们的骨头散在墓旁，","poem":1},{"lineBreak":true},{"text":"好像人耕田、刨地的土块。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"主—耶和华啊，我的眼目仰望你；","poem":1},{"lineBreak":true},{"text":"我投靠你，求你不要将我撇得孤苦！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你保护我脱离恶人为我设的网罗","poem":1},{"lineBreak":true},{"text":"和作孽之人的圈套！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"愿恶人落在自己的网里，","poem":1},{"lineBreak":true},{"text":"我却得以逃脱。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}