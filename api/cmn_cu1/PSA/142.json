{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":142,"content":[{"type":"heading","content":["求主眷顾"]},{"type":"hebrew_subtitle","content":["大卫在洞里作的训诲诗，乃是祈祷。"]},{"type":"verse","number":1,"content":[{"text":"我发声哀告耶和华，","poem":1},{"lineBreak":true},{"text":"发声恳求耶和华。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在他面前吐露我的苦情，","poem":1},{"lineBreak":true},{"text":"陈说我的患难。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的灵在我里面发昏的时候，","poem":1},{"lineBreak":true},{"text":"你知道我的道路。","poem":1},{"lineBreak":true},{"text":"在我行的路上，","poem":1},{"lineBreak":true},{"text":"敌人为我暗设网罗。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"求你向我右边观看，","poem":1},{"lineBreak":true},{"text":"因为没有人认识我；","poem":1},{"lineBreak":true},{"text":"我无处避难，","poem":1},{"lineBreak":true},{"text":"也没有人眷顾我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和华啊，我曾向你哀求。","poem":1},{"lineBreak":true},{"text":"我说：你是我的避难所；","poem":1},{"lineBreak":true},{"text":"在活人之地，你是我的福分。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你侧耳听我的呼求，","poem":1},{"lineBreak":true},{"text":"因我落到极卑之地；","poem":1},{"lineBreak":true},{"text":"求你救我脱离逼迫我的人，","poem":1},{"lineBreak":true},{"text":"因为他们比我强盛。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你领我出离被囚之地，","poem":1},{"lineBreak":true},{"text":"我好称赞你的名。","poem":1},{"lineBreak":true},{"text":"义人必环绕我，","poem":1},{"lineBreak":true},{"text":"因为你是用厚恩待我。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}