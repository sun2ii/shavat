{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":143,"content":[{"type":"heading","content":["求主拯救"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你听我的祷告，","poem":1},{"lineBreak":true},{"text":"留心听我的恳求，","poem":1},{"lineBreak":true},{"text":"凭你的信实和公义应允我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你不要审问仆人；","poem":1},{"lineBreak":true},{"text":"因为在你面前，凡活着的人没有一个是义的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"原来仇敌逼迫我，","poem":1},{"lineBreak":true},{"text":"将我打倒在地，","poem":1},{"lineBreak":true},{"text":"使我住在幽暗之处，","poem":1},{"lineBreak":true},{"text":"像死了许久的人一样。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"所以，我的灵在我里面发昏；","poem":1},{"lineBreak":true},{"text":"我的心在我里面凄惨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我追想古时之日，","poem":1},{"lineBreak":true},{"text":"思想你的一切作为，","poem":1},{"lineBreak":true},{"text":"默念你手的工作。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我向你举手；","poem":1},{"lineBreak":true},{"text":"我的心渴想你，","poem":1},{"lineBreak":true},{"text":"如干旱之地盼雨一样。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华啊，求你速速应允我！","poem":1},{"lineBreak":true},{"text":"我心神耗尽！","poem":1},{"lineBreak":true},{"text":"不要向我掩面，","poem":1},{"lineBreak":true},{"text":"免得我像那些下坑的人一样。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你使我清晨得听你慈爱之言，","poem":1},{"lineBreak":true},{"text":"因我倚靠你；","poem":1},{"lineBreak":true},{"text":"求你使我知道当行的路，","poem":1},{"lineBreak":true},{"text":"因我的心仰望你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和华啊，求你救我脱离我的仇敌！","poem":1},{"lineBreak":true},{"text":"我往你那里藏身。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"求你指教我遵行你的旨意，","poem":1},{"lineBreak":true},{"text":"因你是我的 神。","poem":1},{"lineBreak":true},{"text":"你的灵本为善；","poem":1},{"lineBreak":true},{"text":"求你引我到平坦之地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和华啊，求你为你的名将我救活，","poem":1},{"lineBreak":true},{"text":"凭你的公义，将我从患难中领出来，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"凭你的慈爱剪除我的仇敌，","poem":1},{"lineBreak":true},{"text":"灭绝一切苦待我的人，","poem":1},{"lineBreak":true},{"text":"因我是你的仆人。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}