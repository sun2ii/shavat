{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":144,"content":[{"type":"heading","content":["君王为胜利感恩"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华—我的磐石是应当称颂的！","poem":1},{"lineBreak":true},{"text":"他教导我的手争战，","poem":1},{"lineBreak":true},{"text":"教导我的指头打仗。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他是我慈爱的主，我的山寨，","poem":1},{"lineBreak":true},{"text":"我的高台，我的救主，","poem":1},{"lineBreak":true},{"text":"我的盾牌，是我所投靠的；","poem":1},{"lineBreak":true},{"text":"他使我的百姓服在我以下。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和华啊，人算什么，你竟认识他！","poem":1},{"lineBreak":true},{"text":"世人算什么，你竟顾念他！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"人好像一口气；","poem":1},{"lineBreak":true},{"text":"他的年日如同影儿快快过去。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华啊，求你使天下垂，亲自降临，","poem":1},{"lineBreak":true},{"text":"摸山，山就冒烟。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你发出闪电，使他们四散，","poem":1},{"lineBreak":true},{"text":"射出你的箭，使他们扰乱。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你从上伸手救拔我，","poem":1},{"lineBreak":true},{"text":"救我出离大水，","poem":1},{"lineBreak":true},{"text":"救我脱离外邦人的手。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们的口说谎话；","poem":1},{"lineBreak":true},{"text":"他们的右手起假誓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"神啊，我要向你唱新歌，","poem":1},{"lineBreak":true},{"text":"用十弦瑟向你歌颂。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你是那拯救君王的；","poem":1},{"lineBreak":true},{"text":"你是那救仆人大卫脱离害命之刀的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你救拔我，","poem":1},{"lineBreak":true},{"text":"救我脱离外邦人的手。","poem":1},{"lineBreak":true},{"text":"他们的口说谎话；","poem":1},{"lineBreak":true},{"text":"他们的右手起假誓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"我们的儿子从幼年好像树栽子长大；","poem":1},{"lineBreak":true},{"text":"我们的女儿如同殿角石，","poem":1},{"lineBreak":true},{"text":"是按建宫的样式凿成的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我们的仓盈满，能出各样的粮食；","poem":1},{"lineBreak":true},{"text":"我们的羊在田间孳生千万。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我们的牛驮着满驮，","poem":1},{"lineBreak":true},{"text":"没有人闯进来抢夺，","poem":1},{"lineBreak":true},{"text":"也没有人出去争战；","poem":1},{"lineBreak":true},{"text":"我们的街市上也没有哭号的声音。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"遇见这光景的百姓便为有福！","poem":1},{"lineBreak":true},{"text":"有耶和华为他们的 神，这百姓便为有福！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}