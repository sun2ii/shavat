{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":145,"content":[{"type":"heading","content":["称颂的圣诗"]},{"type":"hebrew_subtitle","content":["大卫的赞美诗。"]},{"type":"verse","number":1,"content":[{"text":"我的 神我的王啊，我要尊崇你！","poem":1},{"lineBreak":true},{"text":"我要永永远远称颂你的名！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要天天称颂你，","poem":1},{"lineBreak":true},{"text":"也要永永远远赞美你的名！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华本为大，该受大赞美；","poem":1},{"lineBreak":true},{"text":"其大无法测度。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"这代要对那代颂赞你的作为，","poem":1},{"lineBreak":true},{"text":"也要传扬你的大能。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我要默念你威严的尊荣","poem":1},{"lineBreak":true},{"text":"和你奇妙的作为。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"人要传说你可畏之事的能力；","poem":1},{"lineBreak":true},{"text":"我也要传扬你的大德。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们记念你的大恩就要传出来，","poem":1},{"lineBreak":true},{"text":"并要歌唱你的公义。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华有恩惠，有怜悯，","poem":1},{"lineBreak":true},{"text":"不轻易发怒，大有慈爱。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华善待万民；","poem":1},{"lineBreak":true},{"text":"他的慈悲覆庇他一切所造的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和华啊，你一切所造的都要称谢你；","poem":1},{"lineBreak":true},{"text":"你的圣民也要称颂你，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"传说你国的荣耀，","poem":1},{"lineBreak":true},{"text":"谈论你的大能，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"好叫世人知道你大能的作为，","poem":1},{"lineBreak":true},{"text":"并你国度威严的荣耀。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你的国是永远的国！","poem":1},{"lineBreak":true},{"text":"你执掌的权柄存到万代！","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"凡跌倒的，耶和华将他们扶持；","poem":1},{"lineBreak":true},{"text":"凡被压下的，将他们扶起。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"万民都举目仰望你；","poem":1},{"lineBreak":true},{"text":"你随时给他们食物。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你张手，","poem":1},{"lineBreak":true},{"text":"使有生气的都随愿饱足。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和华在他一切所行的，无不公义；","poem":1},{"lineBreak":true},{"text":"在他一切所做的都有慈爱。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"凡求告耶和华的，就是诚心求告他的，","poem":1},{"lineBreak":true},{"text":"耶和华便与他们相近。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"敬畏他的，他必成就他们的心愿，","poem":1},{"lineBreak":true},{"text":"也必听他们的呼求，拯救他们。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和华保护一切爱他的人，","poem":1},{"lineBreak":true},{"text":"却要灭绝一切的恶人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"我的口要说出赞美耶和华的话；","poem":1},{"lineBreak":true},{"text":"惟愿凡有血气的都永永远远称颂他的圣名。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}