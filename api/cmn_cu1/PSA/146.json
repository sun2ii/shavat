{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":146,"content":[{"type":"heading","content":["赞美耶和华的救助"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"我的心哪，你要赞美耶和华！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我一生要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"我还活的时候要歌颂我的 神！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你们不要倚靠君王，不要倚靠世人；","poem":1},{"lineBreak":true},{"text":"他一点不能帮助。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他的气一断，就归回尘土；","poem":1},{"lineBreak":true},{"text":"他所打算的，当日就消灭了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"以雅各的 神为帮助、","poem":1},{"lineBreak":true},{"text":"仰望耶和华—他 神的，这人便为有福！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华造天、地、海，和其中的万物；","poem":1},{"lineBreak":true},{"text":"他守诚实，直到永远。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他为受屈的伸冤，","poem":1},{"lineBreak":true},{"text":"赐食物与饥饿的。","poem":1},{"lineBreak":true},{"text":"耶和华释放被囚的；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华开了瞎子的眼睛；","poem":1},{"lineBreak":true},{"text":"耶和华扶起被压下的人。","poem":1},{"lineBreak":true},{"text":"耶和华喜爱义人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华保护寄居的，","poem":1},{"lineBreak":true},{"text":"扶持孤儿和寡妇，","poem":1},{"lineBreak":true},{"text":"却使恶人的道路弯曲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和华要作王，直到永远！","poem":1},{"lineBreak":true},{"text":"锡安哪，你的 神要作王，直到万代！","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}