{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":147,"content":[{"type":"heading","content":["赞美 神的全能"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"因歌颂我们的 神为善为美；","poem":1},{"lineBreak":true},{"text":"赞美的话是合宜的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华建造耶路撒冷，","poem":1},{"lineBreak":true},{"text":"聚集以色列中被赶散的人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他医好伤心的人，","poem":1},{"lineBreak":true},{"text":"裹好他们的伤处。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他数点星宿的数目，","poem":1},{"lineBreak":true},{"text":"一一称它的名。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我们的主为大，最有能力；","poem":1},{"lineBreak":true},{"text":"他的智慧无法测度。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华扶持谦卑人，","poem":1},{"lineBreak":true},{"text":"将恶人倾覆于地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"你们要以感谢向耶和华歌唱，","poem":1},{"lineBreak":true},{"text":"用琴向我们的 神歌颂。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他用云遮天，为地降雨，","poem":1},{"lineBreak":true},{"text":"使草生长在山上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他赐食给走兽","poem":1},{"lineBreak":true},{"text":"和啼叫的小乌鸦。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他不喜悦马的力大，","poem":1},{"lineBreak":true},{"text":"不喜爱人的腿快。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华喜爱敬畏他","poem":1},{"lineBreak":true},{"text":"和盼望他慈爱的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶路撒冷啊，你要颂赞耶和华！","poem":1},{"lineBreak":true},{"text":"锡安哪，你要赞美你的 神！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因为他坚固了你的门闩，","poem":1},{"lineBreak":true},{"text":"赐福给你中间的儿女。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他使你境内平安，","poem":1},{"lineBreak":true},{"text":"用上好的麦子使你满足。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他发命在地；","poem":1},{"lineBreak":true},{"text":"他的话颁行最快。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他降雪如羊毛，","poem":1},{"lineBreak":true},{"text":"撒霜如炉灰。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他掷下冰雹如碎渣；","poem":1},{"lineBreak":true},{"text":"他发出寒冷，谁能当得起呢？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他一出令，这些就都消化；","poem":1},{"lineBreak":true},{"text":"他使风刮起，水便流动。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"他将他的道指示雅各，","poem":1},{"lineBreak":true},{"text":"将他的律例典章指示以色列。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"别国他都没有这样待过；","poem":1},{"lineBreak":true},{"text":"至于他的典章，他们向来没有知道。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}