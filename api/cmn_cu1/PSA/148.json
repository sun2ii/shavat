{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":148,"content":[{"type":"heading","content":["宣召万有赞美耶和华"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"从天上赞美耶和华，","poem":1},{"lineBreak":true},{"text":"在高处赞美他！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他的众使者都要赞美他！","poem":1},{"lineBreak":true},{"text":"他的诸军都要赞美他！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"日头月亮，你们要赞美他！","poem":1},{"lineBreak":true},{"text":"放光的星宿，你们都要赞美他！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"天上的天和天上的水，","poem":1},{"lineBreak":true},{"text":"你们都要赞美他！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"愿这些都赞美耶和华的名！","poem":1},{"lineBreak":true},{"text":"因他一吩咐便都造成。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他将这些立定，直到永永远远；","poem":1},{"lineBreak":true},{"text":"他定了命，不能废去","poem":1},{"noteId":59},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"所有在地上的，","poem":1},{"lineBreak":true},{"text":"大鱼和一切深洋，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"火与冰雹，雪和雾气，","poem":1},{"lineBreak":true},{"text":"成就他命的狂风，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"大山和小山，","poem":1},{"lineBreak":true},{"text":"结果的树木和一切香柏树，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"野兽和一切牲畜，","poem":1},{"lineBreak":true},{"text":"昆虫和飞鸟，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"世上的君王和万民，","poem":1},{"lineBreak":true},{"text":"首领和世上一切审判官，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"少年人和处女，","poem":1},{"lineBreak":true},{"text":"老年人和孩童，","poem":1},{"lineBreak":true},{"text":"都当赞美耶和华！","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"愿这些都赞美耶和华的名！","poem":1},{"lineBreak":true},{"text":"因为独有他的名被尊崇；","poem":1},{"lineBreak":true},{"text":"他的荣耀在天地之上。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他将他百姓的角高举，","poem":1},{"lineBreak":true},{"text":"因此他","poem":1},{"noteId":60},{"text":"一切圣民以色列人，","poem":1},{"lineBreak":true},{"text":"就是与他相近的百姓，都赞美他！","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[{"noteId":59,"caller":"-","text":"或译：越过","reference":{"chapter":148,"verse":6}},{"noteId":60,"caller":"-","text":"或译：他使","reference":{"chapter":148,"verse":14}}]},"thisChapterLink":"/api/cmn_cu1/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}