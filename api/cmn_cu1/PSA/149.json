{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":149,"content":[{"type":"heading","content":["赞美的圣诗"]},{"type":"verse","number":1,"content":[{"text":"你们要赞美耶和华！","poem":1},{"lineBreak":true},{"text":"向耶和华唱新歌，","poem":1},{"lineBreak":true},{"text":"在圣民的会中赞美他！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿以色列因造他的主欢喜！","poem":1},{"lineBreak":true},{"text":"愿锡安的民因他们的王快乐！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愿他们跳舞赞美他的名，","poem":1},{"lineBreak":true},{"text":"击鼓弹琴歌颂他！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因为耶和华喜爱他的百姓；","poem":1},{"lineBreak":true},{"text":"他要用救恩当作谦卑人的妆饰。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愿圣民因所得的荣耀高兴！","poem":1},{"lineBreak":true},{"text":"愿他们在床上欢呼！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愿他们口中称赞 神为高，","poem":1},{"lineBreak":true},{"text":"手里有两刃的刀，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"为要报复列邦，","poem":1},{"lineBreak":true},{"text":"刑罚万民。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"要用链子捆他们的君王，","poem":1},{"lineBreak":true},{"text":"用铁镣锁他们的大臣；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"要在他们身上施行所记录的审判。","poem":1},{"lineBreak":true},{"text":"他的圣民都有这荣耀。","poem":1},{"lineBreak":true},{"text":"你们要赞美耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}