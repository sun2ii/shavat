{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":15,"content":[{"type":"heading","content":["得居圣山者的品行"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，谁能寄居你的帐幕？","poem":1},{"lineBreak":true},{"text":"谁能住在你的圣山？","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"就是行为正直、做事公义、","poem":1},{"lineBreak":true},{"text":"心里说实话的人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他不以舌头谗谤人，","poem":1},{"lineBreak":true},{"text":"不恶待朋友，","poem":1},{"lineBreak":true},{"text":"也不随伙毁谤邻里。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他眼中藐视匪类，","poem":1},{"lineBreak":true},{"text":"却尊重那敬畏耶和华的人。","poem":1},{"lineBreak":true},{"text":"他发了誓，虽然自己吃亏也不更改。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他不放债取利，","poem":1},{"lineBreak":true},{"text":"不受贿赂以害无辜。","poem":1},{"lineBreak":true},{"text":"行这些事的人必永不动摇。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}