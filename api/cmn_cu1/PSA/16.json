{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":16,"content":[{"type":"heading","content":["为信心稳固而祈祷"]},{"type":"hebrew_subtitle","content":["大卫的金诗。"]},{"type":"verse","number":1,"content":[{"text":"神啊，求你保佑我，","poem":1},{"lineBreak":true},{"text":"因为我投靠你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的心哪，你曾对耶和华说：你是我的主；","poem":1},{"lineBreak":true},{"text":"我的好处不在你以外。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"论到世上的圣民，他们又美又善，","poem":1},{"lineBreak":true},{"text":"是我最喜悦的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"以别神代替耶和华的","poem":1},{"noteId":6},{"text":"，","poem":1},{"lineBreak":true},{"text":"他们的愁苦必加增；","poem":1},{"lineBreak":true},{"text":"他们所浇奠的血我不献上；","poem":1},{"lineBreak":true},{"text":"我嘴唇也不提别神的名号。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和华是我的产业，","poem":1},{"lineBreak":true},{"text":"是我杯中的分；","poem":1},{"lineBreak":true},{"text":"我所得的，你为我持守。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"用绳量给我的地界，坐落在佳美之处；","poem":1},{"lineBreak":true},{"text":"我的产业实在美好。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我必称颂那指教我的耶和华；","poem":1},{"lineBreak":true},{"text":"我的心肠在夜间也警戒我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我将耶和华常摆在我面前，","poem":1},{"lineBreak":true},{"text":"因他在我右边，我便不致摇动。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"因此，我的心欢喜，我的灵","poem":1},{"noteId":7},{"text":"快乐；","poem":1},{"lineBreak":true},{"text":"我的肉身也要安然居住。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因为你必不将我的灵魂撇在阴间，","poem":1},{"lineBreak":true},{"text":"也不叫你的圣者见朽坏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你必将生命的道路指示我。","poem":1},{"lineBreak":true},{"text":"在你面前有满足的喜乐；","poem":1},{"lineBreak":true},{"text":"在你右手中有永远的福乐。","poem":1}]}],"footnotes":[{"noteId":6,"caller":"-","text":"或译：送礼物给别神的","reference":{"chapter":16,"verse":4}},{"noteId":7,"caller":"-","text":"原文是荣耀","reference":{"chapter":16,"verse":9}}]},"thisChapterLink":"/api/cmn_cu1/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}