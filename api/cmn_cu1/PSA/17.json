{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":17,"content":[{"type":"heading","content":["无辜的人的祷告"]},{"type":"hebrew_subtitle","content":["大卫的祈祷。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你听闻公义，","poem":1},{"lineBreak":true},{"text":"侧耳听我的呼吁！","poem":1},{"lineBreak":true},{"text":"求你留心听我这不出于诡诈嘴唇的祈祷！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿我的判语从你面前发出；","poem":1},{"lineBreak":true},{"text":"愿你的眼睛观看公正。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你已经试验我的心；","poem":1},{"lineBreak":true},{"text":"你在夜间鉴察我；","poem":1},{"lineBreak":true},{"text":"你熬炼我，却找不着什么；","poem":1},{"lineBreak":true},{"text":"我立志叫我口中没有过失。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"论到人的行为，我借着你嘴唇的言语自己谨守，","poem":1},{"lineBreak":true},{"text":"不行强暴人的道路。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的脚踏定了你的路径；","poem":1},{"lineBreak":true},{"text":"我的两脚未曾滑跌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"神啊，我曾求告你，因为你必应允我；","poem":1},{"lineBreak":true},{"text":"求你向我侧耳，听我的言语。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你显出你奇妙的慈爱来；","poem":1},{"lineBreak":true},{"text":"你是那用右手拯救投靠你的脱离起来攻击他们的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"求你保护我，如同保护眼中的瞳人；","poem":1},{"lineBreak":true},{"text":"将我隐藏在你翅膀的荫下，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"使我脱离那欺压我的恶人，","poem":1},{"lineBreak":true},{"text":"就是围困我要害我命的仇敌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"他们的心被脂油包裹；","poem":1},{"lineBreak":true},{"text":"他们用口说骄傲的话。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们围困了我们的脚步；","poem":1},{"lineBreak":true},{"text":"他们瞪着眼，要把我们推倒在地。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他像狮子急要抓食，","poem":1},{"lineBreak":true},{"text":"又像少壮狮子蹲伏在暗处。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和华啊，求你起来，前去迎敌，将他打倒！","poem":1},{"lineBreak":true},{"text":"用你的刀救护我命脱离恶人。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华啊，求你用手救我脱离世人，","poem":1},{"lineBreak":true},{"text":"脱离那只在今生有福分的世人！","poem":1},{"lineBreak":true},{"text":"你把你的财宝充满他们的肚腹；","poem":1},{"lineBreak":true},{"text":"他们因有儿女就心满意足，","poem":1},{"lineBreak":true},{"text":"将其余的财物留给他们的婴孩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"至于我，我必在义中见你的面；","poem":1},{"lineBreak":true},{"text":"我醒了的时候，得见","poem":1},{"noteId":8},{"text":"你的形象就心满意足了。","poem":1}]}],"footnotes":[{"noteId":8,"caller":"-","text":"或译：着","reference":{"chapter":17,"verse":15}}]},"thisChapterLink":"/api/cmn_cu1/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}