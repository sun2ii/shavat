{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":18,"content":[{"type":"heading","content":["大卫的胜利之歌"]},{"type":"hebrew_subtitle","content":["耶和华的仆人大卫的诗，交与伶长。当耶和华救他脱离一切仇敌和扫罗之手的日子，他向耶和华念这诗的话。说："]},{"type":"verse","number":1,"content":[{"text":"耶和华，我的力量啊，我爱你！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华是我的岩石，我的山寨，我的救主，","poem":1},{"lineBreak":true},{"text":"我的 神，我的磐石，我所投靠的。","poem":1},{"lineBreak":true},{"text":"他是我的盾牌，","poem":1},{"lineBreak":true},{"text":"是拯救我的角，是我的高台。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我要求告当赞美的耶和华；","poem":1},{"lineBreak":true},{"text":"这样我必从仇敌手中被救出来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"曾有死亡的绳索缠绕我，","poem":1},{"lineBreak":true},{"text":"匪类的急流使我惊惧，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"阴间的绳索缠绕我，","poem":1},{"lineBreak":true},{"text":"死亡的网罗临到我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我在急难中求告耶和华，","poem":1},{"lineBreak":true},{"text":"向我的 神呼求。","poem":1},{"lineBreak":true},{"text":"他从殿中听了我的声音；","poem":1},{"lineBreak":true},{"text":"我在他面前的呼求入了他的耳中。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"那时，因他发怒，地就摇撼战抖；","poem":1},{"lineBreak":true},{"text":"山的根基也震动摇撼。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"从他鼻孔冒烟上腾；","poem":1},{"lineBreak":true},{"text":"从他口中发火焚烧，连炭也着了。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他又使天下垂，亲自降临，","poem":1},{"lineBreak":true},{"text":"有黑云在他脚下。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他坐着基路伯飞行；","poem":1},{"lineBreak":true},{"text":"他借着风的翅膀快飞。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他以黑暗为藏身之处，","poem":1},{"lineBreak":true},{"text":"以水的黑暗、天空的厚云为他四围的行宫。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因他面前的光辉，","poem":1},{"lineBreak":true},{"text":"他的厚云行过便有冰雹火炭。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和华也在天上打雷；","poem":1},{"lineBreak":true},{"text":"至高者发出声音便有冰雹火炭。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他射出箭来，使仇敌四散；","poem":1},{"lineBreak":true},{"text":"多多发出闪电，使他们扰乱。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和华啊，你的斥责一发，","poem":1},{"lineBreak":true},{"text":"你鼻孔的气一出，","poem":1},{"lineBreak":true},{"text":"海底就出现，","poem":1},{"lineBreak":true},{"text":"大地的根基也显露。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他从高天伸手抓住我，","poem":1},{"lineBreak":true},{"text":"把我从大水中拉上来。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他救我脱离我的劲敌和那些恨我的人，","poem":1},{"lineBreak":true},{"text":"因为他们比我强盛。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我遭遇灾难的日子，他们来攻击我；","poem":1},{"lineBreak":true},{"text":"但耶和华是我的倚靠。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他又领我到宽阔之处；","poem":1},{"lineBreak":true},{"text":"他救拔我，因他喜悦我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"耶和华按着我的公义报答我，","poem":1},{"lineBreak":true},{"text":"按着我手中的清洁赏赐我。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"因为我遵守了耶和华的道，","poem":1},{"lineBreak":true},{"text":"未曾作恶离开我的 神。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他的一切典章常在我面前；","poem":1},{"lineBreak":true},{"text":"他的律例我也未曾丢弃。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我在他面前作了完全人；","poem":1},{"lineBreak":true},{"text":"我也保守自己远离我的罪孽。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"所以，耶和华按我的公义，","poem":1},{"lineBreak":true},{"text":"按我在他眼前手中的清洁偿还我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"慈爱的人，你以慈爱待他；","poem":1},{"lineBreak":true},{"text":"完全的人，你以完全待他。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"清洁的人，你以清洁待他；","poem":1},{"lineBreak":true},{"text":"乖僻的人，你以弯曲待他。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"困苦的百姓，你必拯救；","poem":1},{"lineBreak":true},{"text":"高傲的眼目，你必使他降卑。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你必点着我的灯；","poem":1},{"lineBreak":true},{"text":"耶和华—我的 神必照明我的黑暗。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我借着你冲入敌军，","poem":1},{"lineBreak":true},{"text":"借着我的 神跳过墙垣。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"至于 神，他的道是完全的；","poem":1},{"lineBreak":true},{"text":"耶和华的话是炼净的。","poem":1},{"lineBreak":true},{"text":"凡投靠他的，他便作他们的盾牌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"除了耶和华，谁是 神呢？","poem":1},{"lineBreak":true},{"text":"除了我们的 神，谁是磐石呢？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"惟有那以力量束我的腰、","poem":1},{"lineBreak":true},{"text":"使我行为完全的，他是 神。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他使我的脚快如母鹿的蹄，","poem":1},{"lineBreak":true},{"text":"又使我在高处安稳。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"他教导我的手能以争战，","poem":1},{"lineBreak":true},{"text":"甚至我的膀臂能开铜弓。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"你把你的救恩给我作盾牌；","poem":1},{"lineBreak":true},{"text":"你的右手扶持我；","poem":1},{"lineBreak":true},{"text":"你的温和使我为大。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"你使我脚下的地步宽阔；","poem":1},{"lineBreak":true},{"text":"我的脚未曾滑跌。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"我要追赶我的仇敌，并要追上他们；","poem":1},{"lineBreak":true},{"text":"不将他们灭绝，我总不归回。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"我要打伤他们，使他们不能起来；","poem":1},{"lineBreak":true},{"text":"他们必倒在我的脚下。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"因为你曾以力量束我的腰，使我能争战；","poem":1},{"lineBreak":true},{"text":"你也使那起来攻击我的都服在我以下。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"你又使我的仇敌在我面前转背逃跑，","poem":1},{"lineBreak":true},{"text":"叫我能以剪除那恨我的人。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"他们呼求，却无人拯救；","poem":1},{"lineBreak":true},{"text":"就是呼求耶和华，他也不应允。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"我捣碎他们，如同风前的灰尘，","poem":1},{"lineBreak":true},{"text":"倒出他们，如同街上的泥土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"你救我脱离百姓的争竞，","poem":1},{"lineBreak":true},{"text":"立我作列国的元首；","poem":1},{"lineBreak":true},{"text":"我素不认识的民必事奉我。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"他们一听见我的名声就必顺从我；","poem":1},{"lineBreak":true},{"text":"外邦人要投降我。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"外邦人要衰残，","poem":1},{"lineBreak":true},{"text":"战战兢兢地出他们的营寨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"耶和华是活神。","poem":1},{"lineBreak":true},{"text":"愿我的磐石被人称颂；","poem":1},{"lineBreak":true},{"text":"愿救我的 神被人尊崇。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"这位 神，就是那为我伸冤、","poem":1},{"lineBreak":true},{"text":"使众民服在我以下的。","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"你救我脱离仇敌，","poem":1},{"lineBreak":true},{"text":"又把我举起，高过那些起来攻击我的；","poem":1},{"lineBreak":true},{"text":"你救我脱离强暴的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"耶和华啊，因此我要在外邦中称谢你，","poem":1},{"lineBreak":true},{"text":"歌颂你的名。","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"耶和华赐极大的救恩给他所立的王，","poem":1},{"lineBreak":true},{"text":"施慈爱给他的受膏者，","poem":1},{"lineBreak":true},{"text":"就是给大卫和他的后裔，直到永远。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}