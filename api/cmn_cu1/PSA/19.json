{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":19,"content":[{"type":"heading","content":["造化的荣耀"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"诸天述说 神的荣耀；","poem":1},{"lineBreak":true},{"text":"穹苍传扬他的手段。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"这日到那日发出言语；","poem":1},{"lineBreak":true},{"text":"这夜到那夜传出知识。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"无言无语，","poem":1},{"lineBreak":true},{"text":"也无声音可听。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"它的量带通遍天下，","poem":1},{"lineBreak":true},{"text":"它的言语传到地极。","poem":1},{"lineBreak":true},{"text":"神在其间为太阳安设帐幕；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"太阳如同新郎出洞房，","poem":1},{"lineBreak":true},{"text":"又如勇士欢然奔路。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"它从天这边出来，绕到天那边，","poem":1},{"lineBreak":true},{"text":"没有一物被隐藏不得它的热气。","poem":1}]},{"type":"heading","content":["耶和华的律法"]},{"type":"verse","number":7,"content":[{"text":"耶和华的律法全备，能苏醒人心；","poem":1},{"lineBreak":true},{"text":"耶和华的法度确定，能使愚人有智慧。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华的训词正直，能快活人的心；","poem":1},{"lineBreak":true},{"text":"耶和华的命令清洁，能明亮人的眼目。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华的道理洁净，存到永远；","poem":1},{"lineBreak":true},{"text":"耶和华的典章真实，全然公义—","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"都比金子可羡慕，且比极多的精金可羡慕；","poem":1},{"lineBreak":true},{"text":"比蜜甘甜，且比蜂房下滴的蜜甘甜。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"况且你的仆人因此受警戒，","poem":1},{"lineBreak":true},{"text":"守着这些便有大赏。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"谁能知道自己的错失呢？","poem":1},{"lineBreak":true},{"text":"愿你赦免我隐而未现的过错。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"求你拦阻仆人不犯任意妄为的罪，","poem":1},{"lineBreak":true},{"text":"不容这罪辖制我，","poem":1},{"lineBreak":true},{"text":"我便完全，免犯大罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"耶和华—我的磐石，我的救赎主啊，","poem":1},{"lineBreak":true},{"text":"愿我口中的言语、心里的意念在你面前蒙悦纳。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}