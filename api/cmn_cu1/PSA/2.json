{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":2,"content":[{"type":"heading","content":["神所拣选的君王"]},{"type":"verse","number":1,"content":[{"text":"外邦为什么争闹？","poem":1},{"lineBreak":true},{"text":"万民为什么谋算虚妄的事？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"世上的君王一齐起来，","poem":1},{"lineBreak":true},{"text":"臣宰一同商议，","poem":1},{"lineBreak":true},{"text":"要敌挡耶和华并他的受膏者，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"说：我们要挣开他们的捆绑，","poem":1},{"lineBreak":true},{"text":"脱去他们的绳索。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"那坐在天上的必发笑；","poem":1},{"lineBreak":true},{"text":"主必嗤笑他们。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"那时，他要在怒中责备他们，","poem":1},{"lineBreak":true},{"text":"在烈怒中惊吓他们，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"说：我已经立我的君","poem":1},{"lineBreak":true},{"text":"在锡安—我的圣山上了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"受膏者说：我要传圣旨。","poem":1},{"lineBreak":true},{"text":"耶和华曾对我说：你是我的儿子，","poem":1},{"lineBreak":true},{"text":"我今日生你。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你求我，我就将列国赐你为基业，","poem":1},{"lineBreak":true},{"text":"将地极赐你为田产。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你必用铁杖打破他们；","poem":1},{"lineBreak":true},{"text":"你必将他们如同窑匠的瓦器摔碎。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"现在，你们君王应当省悟！","poem":1},{"lineBreak":true},{"text":"你们世上的审判官该受管教！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"当存畏惧事奉耶和华，","poem":1},{"lineBreak":true},{"text":"又当存战兢而快乐。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"当以嘴亲子，恐怕他发怒，","poem":1},{"lineBreak":true},{"text":"你们便在道中灭亡，","poem":1},{"lineBreak":true},{"text":"因为他的怒气快要发作。","poem":1},{"lineBreak":true},{"text":"凡投靠他的，都是有福的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}