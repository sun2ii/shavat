{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":20,"content":[{"type":"heading","content":["祈求胜利"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"愿耶和华在你遭难的日子应允你；","poem":1},{"lineBreak":true},{"text":"愿名为雅各 神的高举你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿他从圣所救助你，","poem":1},{"lineBreak":true},{"text":"从锡安坚固你，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"记念你的一切供献，","poem":1},{"lineBreak":true},{"text":"悦纳你的燔祭， （细拉）","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"将你心所愿的赐给你，","poem":1},{"lineBreak":true},{"text":"成就你的一切筹算。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我们要因你的救恩夸胜，","poem":1},{"lineBreak":true},{"text":"要奉我们 神的名竖立旌旗。","poem":1},{"lineBreak":true},{"text":"愿耶和华成就你一切所求的！","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"现在我知道耶和华救护他的受膏者，","poem":1},{"lineBreak":true},{"text":"必从他的圣天上应允他，","poem":1},{"lineBreak":true},{"text":"用右手的能力救护他。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"有人靠车，有人靠马，","poem":1},{"lineBreak":true},{"text":"但我们要提到耶和华—我们 神的名。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们都屈身仆倒，","poem":1},{"lineBreak":true},{"text":"我们却起来，立得正直。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"求耶和华施行拯救；","poem":1},{"lineBreak":true},{"text":"我们呼求的时候，愿王应允我们！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}