{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":21,"content":[{"type":"heading","content":["为胜利而歌颂"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，王必因你的能力欢喜；","poem":1},{"lineBreak":true},{"text":"因你的救恩，他的快乐何其大！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他心里所愿的，你已经赐给他；","poem":1},{"lineBreak":true},{"text":"他嘴唇所求的，你未尝不应允。 （细拉）","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你以美福迎接他，","poem":1},{"lineBreak":true},{"text":"把精金的冠冕戴在他头上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他向你求寿，你便赐给他，","poem":1},{"lineBreak":true},{"text":"就是日子长久，直到永远。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他因你的救恩大有荣耀；","poem":1},{"lineBreak":true},{"text":"你又将尊荣威严加在他身上。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你使他有洪福，直到永远，","poem":1},{"lineBreak":true},{"text":"又使他在你面前欢喜快乐。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"王倚靠耶和华，","poem":1},{"lineBreak":true},{"text":"因至高者的慈爱必不摇动。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你的手要搜出你的一切仇敌；","poem":1},{"lineBreak":true},{"text":"你的右手要搜出那些恨你的人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你发怒的时候，要使他们如在炎热的火炉中。","poem":1},{"lineBreak":true},{"text":"耶和华要在他的震怒中吞灭他们；","poem":1},{"lineBreak":true},{"text":"那火要把他们烧尽了。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你必从世上灭绝他们的子孙","poem":1},{"noteId":9},{"text":"，","poem":1},{"lineBreak":true},{"text":"从人间灭绝他们的后裔。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因为他们有意加害于你；","poem":1},{"lineBreak":true},{"text":"他们想出计谋，却不能作成。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你必使他们转背逃跑，","poem":1},{"lineBreak":true},{"text":"向他们的脸搭箭在弦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和华啊，愿你因自己的能力显为至高！","poem":1},{"lineBreak":true},{"text":"这样，我们就唱诗，歌颂你的大能。","poem":1}]}],"footnotes":[{"noteId":9,"caller":"-","text":"原文是果子","reference":{"chapter":21,"verse":10}}]},"thisChapterLink":"/api/cmn_cu1/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}