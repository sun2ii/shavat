{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":22,"content":[{"type":"heading","content":["痛苦中的祷告和赞美"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。调用朝鹿。"]},{"type":"verse","number":1,"content":[{"text":"我的 神，我的 神！为什么离弃我？","poem":1},{"lineBreak":true},{"text":"为什么远离不救我？不听我唉哼的言语？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的 神啊，我白日呼求，你不应允，","poem":1},{"lineBreak":true},{"text":"夜间呼求，并不住声。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"但你是圣洁的，","poem":1},{"lineBreak":true},{"text":"是用以色列的赞美为宝座","poem":1},{"noteId":10},{"text":"的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们的祖宗倚靠你；","poem":1},{"lineBreak":true},{"text":"他们倚靠你，你便解救他们。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们哀求你，便蒙解救；","poem":1},{"lineBreak":true},{"text":"他们倚靠你，就不羞愧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"但我是虫，不是人，","poem":1},{"lineBreak":true},{"text":"被众人羞辱，被百姓藐视。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"凡看见我的都嗤笑我；","poem":1},{"lineBreak":true},{"text":"他们撇嘴摇头，说：","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他把自己交托耶和华，耶和华可以救他吧！","poem":1},{"lineBreak":true},{"text":"耶和华既喜悦他，可以搭救他吧！","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"但你是叫我出母腹的；","poem":1},{"lineBreak":true},{"text":"我在母怀里，你就使我有倚靠的心。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我自出母胎就被交在你手里；","poem":1},{"lineBreak":true},{"text":"从我母亲生我，你就是我的 神。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你不要远离我！","poem":1},{"lineBreak":true},{"text":"因为急难临近了，没有人帮助我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"有许多公牛围绕我，","poem":1},{"lineBreak":true},{"text":"巴珊大力的公牛四面困住我。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"它们向我张口，","poem":1},{"lineBreak":true},{"text":"好像抓撕吼叫的狮子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"我如水被倒出来；","poem":1},{"lineBreak":true},{"text":"我的骨头都脱了节；","poem":1},{"lineBreak":true},{"text":"我心在我里面如蜡熔化。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的精力枯干，如同瓦片；","poem":1},{"lineBreak":true},{"text":"我的舌头贴在我牙床上。","poem":1},{"lineBreak":true},{"text":"你将我安置在死地的尘土中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"犬类围着我，恶党环绕我；","poem":1},{"lineBreak":true},{"text":"他们扎了我的手，我的脚。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的骨头，我都能数过；","poem":1},{"lineBreak":true},{"text":"他们瞪着眼看我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们分我的外衣，","poem":1},{"lineBreak":true},{"text":"为我的里衣拈阄。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和华啊，求你不要远离我！","poem":1},{"lineBreak":true},{"text":"我的救主啊，求你快来帮助我！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"求你救我的灵魂脱离刀剑，","poem":1},{"lineBreak":true},{"text":"救我的生命","poem":1},{"noteId":11},{"text":"脱离犬类，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"救我脱离狮子的口；","poem":1},{"lineBreak":true},{"text":"你已经应允我，使我脱离野牛的角。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"我要将你的名传与我的弟兄，","poem":1},{"lineBreak":true},{"text":"在会中我要赞美你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你们敬畏耶和华的人要赞美他！","poem":1},{"lineBreak":true},{"text":"雅各的后裔都要荣耀他！","poem":1},{"lineBreak":true},{"text":"以色列的后裔都要惧怕他！","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"因为他没有藐视憎恶受苦的人，","poem":1},{"lineBreak":true},{"text":"也没有向他掩面；","poem":1},{"lineBreak":true},{"text":"那受苦之人呼吁的时候，他就垂听。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"我在大会中赞美你的话是从你而来的；","poem":1},{"lineBreak":true},{"text":"我要在敬畏耶和华的人面前还我的愿。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"谦卑的人必吃得饱足；","poem":1},{"lineBreak":true},{"text":"寻求耶和华的人必赞美他。","poem":1},{"lineBreak":true},{"text":"愿你们的心永远活着！","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"地的四极都要想念耶和华，并且归顺他；","poem":1},{"lineBreak":true},{"text":"列国的万族都要在你面前敬拜。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"因为国权是耶和华的；","poem":1},{"lineBreak":true},{"text":"他是管理万国的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"地上一切丰肥的人必吃喝而敬拜；","poem":1},{"lineBreak":true},{"text":"凡下到尘土中—不能存活自己性命的人","poem":1},{"lineBreak":true},{"text":"—都要在他面前下拜。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他必有后裔事奉他；","poem":1},{"lineBreak":true},{"text":"主所行的事必传与后代。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他们必来把他的公义传给将要生的民，","poem":1},{"lineBreak":true},{"text":"言明这事是他所行的。","poem":1}]}],"footnotes":[{"noteId":10,"caller":"-","text":"或译：居所","reference":{"chapter":22,"verse":3}},{"noteId":11,"caller":"-","text":"生命：原文是独一者","reference":{"chapter":22,"verse":20}}]},"thisChapterLink":"/api/cmn_cu1/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}