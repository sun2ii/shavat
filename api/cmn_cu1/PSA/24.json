{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":24,"content":[{"type":"heading","content":["伟大的君王"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"地和其中所充满的，","poem":1},{"lineBreak":true},{"text":"世界和住在其间的，都属耶和华。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他把地建立在海上，","poem":1},{"lineBreak":true},{"text":"安定在大水之上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"谁能登耶和华的山？","poem":1},{"lineBreak":true},{"text":"谁能站在他的圣所？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"就是手洁心清，不向虚妄，","poem":1},{"lineBreak":true},{"text":"起誓不怀诡诈的人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他必蒙耶和华赐福，","poem":1},{"lineBreak":true},{"text":"又蒙救他的 神使他成义。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"这是寻求耶和华的族类，","poem":1},{"lineBreak":true},{"text":"是寻求你面的雅各。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"众城门哪，你们要抬起头来！","poem":1},{"lineBreak":true},{"text":"永久的门户，你们要被举起！","poem":1},{"lineBreak":true},{"text":"那荣耀的王将要进来！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"荣耀的王是谁呢？","poem":1},{"lineBreak":true},{"text":"就是有力有能的耶和华，","poem":1},{"lineBreak":true},{"text":"在战场上有能的耶和华！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"众城门哪，你们要抬起头来！","poem":1},{"lineBreak":true},{"text":"永久的门户，你们要把头抬起！","poem":1},{"lineBreak":true},{"text":"那荣耀的王将要进来！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"荣耀的王是谁呢？","poem":1},{"lineBreak":true},{"text":"万军之耶和华，","poem":1},{"lineBreak":true},{"text":"他是荣耀的王！ （细拉）","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}