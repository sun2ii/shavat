{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":25,"content":[{"type":"heading","content":["求主指引保护"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我的心仰望你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的 神啊，我素来倚靠你；","poem":1},{"lineBreak":true},{"text":"求你不要叫我羞愧，","poem":1},{"lineBreak":true},{"text":"不要叫我的仇敌向我夸胜。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"凡等候你的必不羞愧；","poem":1},{"lineBreak":true},{"text":"惟有那无故行奸诈的必要羞愧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华啊，求你将你的道指示我，","poem":1},{"lineBreak":true},{"text":"将你的路教训我！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"求你以你的真理引导我，教训我，","poem":1},{"lineBreak":true},{"text":"因为你是救我的 神。","poem":1},{"lineBreak":true},{"text":"我终日等候你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和华啊，求你记念你的怜悯和慈爱，","poem":1},{"lineBreak":true},{"text":"因为这是亘古以来所常有的。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你不要记念我幼年的罪愆和我的过犯；","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你因你的恩惠，按你的慈爱记念我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华是良善正直的，","poem":1},{"lineBreak":true},{"text":"所以他必指示罪人走正路。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他必按公平引领谦卑人，","poem":1},{"lineBreak":true},{"text":"将他的道教训他们。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"凡遵守他的约和他法度的人，","poem":1},{"lineBreak":true},{"text":"耶和华都以慈爱诚实待他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和华啊，求你因你的名赦免我的罪，","poem":1},{"lineBreak":true},{"text":"因为我的罪重大。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"谁敬畏耶和华，","poem":1},{"lineBreak":true},{"text":"耶和华必指示他当选择的道路。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他必安然居住；","poem":1},{"lineBreak":true},{"text":"他的后裔必承受地土。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华与敬畏他的人亲密；","poem":1},{"lineBreak":true},{"text":"他必将自己的约指示他们。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的眼目时常仰望耶和华，","poem":1},{"lineBreak":true},{"text":"因为他必将我的脚从网里拉出来。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"求你转向我，怜恤我，","poem":1},{"lineBreak":true},{"text":"因为我是孤独困苦。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我心里的愁苦甚多，","poem":1},{"lineBreak":true},{"text":"求你救我脱离我的祸患。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你看顾我的困苦，我的艰难，","poem":1},{"lineBreak":true},{"text":"赦免我一切的罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"求你察看我的仇敌，","poem":1},{"lineBreak":true},{"text":"因为他们人多，并且痛痛地恨我。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"求你保护我的性命，搭救我，","poem":1},{"lineBreak":true},{"text":"使我不致羞愧，因为我投靠你。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"愿纯全、正直保守我，","poem":1},{"lineBreak":true},{"text":"因为我等候你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"神啊，求你救赎以色列脱离他一切的愁苦。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}