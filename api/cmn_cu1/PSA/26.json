{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":26,"content":[{"type":"heading","content":["义人的祈祷"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你为我伸冤，","poem":1},{"lineBreak":true},{"text":"因我向来行事纯全；","poem":1},{"lineBreak":true},{"text":"我又倚靠耶和华，并不摇动。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华啊，求你察看我，试验我，","poem":1},{"lineBreak":true},{"text":"熬炼我的肺腑心肠。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为你的慈爱常在我眼前，","poem":1},{"lineBreak":true},{"text":"我也按你的真理而行。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我没有和虚谎人同坐，","poem":1},{"lineBreak":true},{"text":"也不与瞒哄人的同群。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我恨恶恶人的会，","poem":1},{"lineBreak":true},{"text":"必不与恶人同坐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和华啊，我要洗手表明无辜，","poem":1},{"lineBreak":true},{"text":"才环绕你的祭坛；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我好发称谢的声音，","poem":1},{"lineBreak":true},{"text":"也要述说你一切奇妙的作为。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华啊，我喜爱你所住的殿","poem":1},{"lineBreak":true},{"text":"和你显荣耀的居所。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"不要把我的灵魂和罪人一同除掉；","poem":1},{"lineBreak":true},{"text":"不要把我的性命和流人血的一同除掉。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们的手中有奸恶，","poem":1},{"lineBreak":true},{"text":"右手满有贿赂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"至于我，却要行事纯全；","poem":1},{"lineBreak":true},{"text":"求你救赎我，怜恤我！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我的脚站在平坦地方；","poem":1},{"lineBreak":true},{"text":"在众会中我要称颂耶和华！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}