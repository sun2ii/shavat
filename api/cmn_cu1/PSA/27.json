{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":27,"content":[{"type":"heading","content":["赞美的祷告"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华是我的亮光，是我的拯救，","poem":1},{"lineBreak":true},{"text":"我还怕谁呢？","poem":1},{"lineBreak":true},{"text":"耶和华是我性命的保障","poem":1},{"noteId":12},{"text":"，","poem":1},{"lineBreak":true},{"text":"我还惧谁呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"那作恶的就是我的仇敌，","poem":1},{"lineBreak":true},{"text":"前来吃我肉的时候就绊跌仆倒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"虽有军兵安营攻击我，我的心也不害怕；","poem":1},{"lineBreak":true},{"text":"虽然兴起刀兵攻击我，我必仍旧安稳。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"有一件事，我曾求耶和华，我仍要寻求：","poem":1},{"lineBreak":true},{"text":"就是一生一世住在耶和华的殿中，","poem":1},{"lineBreak":true},{"text":"瞻仰他的荣美，在他的殿里求问。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"因为我遭遇患难，他必暗暗地保守我；","poem":1},{"lineBreak":true},{"text":"在他亭子里，把我藏在他帐幕的隐密处，","poem":1},{"lineBreak":true},{"text":"将我高举在磐石上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"现在我得以昂首，高过四面的仇敌。","poem":1},{"lineBreak":true},{"text":"我要在他的帐幕里欢然献祭；","poem":1},{"lineBreak":true},{"text":"我要唱诗歌颂耶和华。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华啊，我用声音呼吁的时候，求你垂听；","poem":1},{"lineBreak":true},{"text":"并求你怜恤我，应允我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你说：你们当寻求我的面。","poem":1},{"lineBreak":true},{"text":"那时我心向你说：耶和华啊，","poem":1},{"lineBreak":true},{"text":"你的面我正要寻求。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"不要向我掩面。","poem":1},{"lineBreak":true},{"text":"不要发怒赶逐仆人，","poem":1},{"lineBreak":true},{"text":"你向来是帮助我的。","poem":1},{"lineBreak":true},{"text":"救我的 神啊，不要丢掉我，","poem":1},{"lineBreak":true},{"text":"也不要离弃我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我父母离弃我，","poem":1},{"lineBreak":true},{"text":"耶和华必收留我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和华啊，求你将你的道指教我，","poem":1},{"lineBreak":true},{"text":"因我仇敌的缘故引导我走平坦的路。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你不要把我交给敌人，遂其所愿；","poem":1},{"lineBreak":true},{"text":"因为妄作见证的和口吐凶言的，起来攻击我。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我若不信在活人之地得见耶和华的恩惠，","poem":1},{"lineBreak":true},{"text":"就早已丧胆了。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"要等候耶和华！","poem":1},{"lineBreak":true},{"text":"当壮胆，坚固你的心！","poem":1},{"lineBreak":true},{"text":"我再说，要等候耶和华！","poem":1}]}],"footnotes":[{"noteId":12,"caller":"-","text":"或译：力量","reference":{"chapter":27,"verse":1}}]},"thisChapterLink":"/api/cmn_cu1/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}