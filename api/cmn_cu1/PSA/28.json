{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":28,"content":[{"type":"heading","content":["求主帮助"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我要求告你！","poem":1},{"lineBreak":true},{"text":"我的磐石啊，不要向我缄默！","poem":1},{"lineBreak":true},{"text":"倘若你向我闭口，","poem":1},{"lineBreak":true},{"text":"我就如将死的人一样。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我呼求你，向你至圣所举手的时候，","poem":1},{"lineBreak":true},{"text":"求你垂听我恳求的声音！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"不要把我和恶人并作孽的一同除掉；","poem":1},{"lineBreak":true},{"text":"他们与邻舍说和平话，心里却是奸恶。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"愿你按着他们所做的，","poem":1},{"lineBreak":true},{"text":"并他们所行的恶事待他们。","poem":1},{"lineBreak":true},{"text":"愿你照着他们手所做的待他们，","poem":1},{"lineBreak":true},{"text":"将他们所应得的报应加给他们。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们既然不留心耶和华所行的和他手所做的，","poem":1},{"lineBreak":true},{"text":"他就必毁坏他们，不建立他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和华是应当称颂的，","poem":1},{"lineBreak":true},{"text":"因为他听了我恳求的声音。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华是我的力量，是我的盾牌；","poem":1},{"lineBreak":true},{"text":"我心里倚靠他就得帮助。","poem":1},{"lineBreak":true},{"text":"所以我心中欢乐，","poem":1},{"lineBreak":true},{"text":"我必用诗歌颂赞他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华是他百姓的力量，","poem":1},{"lineBreak":true},{"text":"又是他受膏者得救的保障。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你拯救你的百姓，赐福给你的产业，","poem":1},{"lineBreak":true},{"text":"牧养他们，扶持他们，直到永远。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}