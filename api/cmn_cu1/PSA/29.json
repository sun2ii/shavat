{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":29,"content":[{"type":"heading","content":["在暴风雨中耶和华的威声"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"神的众子啊，你们要将荣耀、能力归给耶和华，","poem":1},{"lineBreak":true},{"text":"归给耶和华！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要将耶和华的名所当得的荣耀归给他，","poem":1},{"lineBreak":true},{"text":"以圣洁的","poem":1},{"noteId":13},{"text":"妆饰敬拜耶和华。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和华的声音发在水上；","poem":1},{"lineBreak":true},{"text":"荣耀的 神打雷，","poem":1},{"lineBreak":true},{"text":"耶和华打雷在大水之上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华的声音大有能力；","poem":1},{"lineBreak":true},{"text":"耶和华的声音满有威严。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和华的声音震破香柏树；","poem":1},{"lineBreak":true},{"text":"耶和华震碎黎巴嫩的香柏树。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他也使之跳跃如牛犊，","poem":1},{"lineBreak":true},{"text":"使黎巴嫩和西连跳跃如野牛犊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和华的声音使火焰分岔。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华的声音震动旷野；","poem":1},{"lineBreak":true},{"text":"耶和华震动加低斯的旷野。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和华的声音惊动母鹿落胎，","poem":1},{"lineBreak":true},{"text":"树木也脱落净光。","poem":1},{"lineBreak":true},{"text":"凡在他殿中的，都称说他的荣耀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"洪水泛滥之时，耶和华坐着为王；","poem":1},{"lineBreak":true},{"text":"耶和华坐着为王，直到永远。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华必赐力量给他的百姓；","poem":1},{"lineBreak":true},{"text":"耶和华必赐平安的福给他的百姓。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"的：或译为","reference":{"chapter":29,"verse":2}}]},"thisChapterLink":"/api/cmn_cu1/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}