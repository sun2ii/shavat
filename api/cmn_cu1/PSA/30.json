{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":30,"content":[{"type":"heading","content":["感恩的祷告"]},{"type":"hebrew_subtitle","content":["大卫在献殿的时候，作这诗歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我要尊崇你，","poem":1},{"lineBreak":true},{"text":"因为你曾提拔我，不叫仇敌向我夸耀。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华—我的 神啊，","poem":1},{"lineBreak":true},{"text":"我曾呼求你，你医治了我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华啊，你曾把我的灵魂从阴间救上来，","poem":1},{"lineBreak":true},{"text":"使我存活，不至于下坑。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华的圣民哪，你们要歌颂他，","poem":1},{"lineBreak":true},{"text":"称赞他可记念的圣名。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因为，他的怒气不过是转眼之间；","poem":1},{"lineBreak":true},{"text":"他的恩典乃是一生之久。","poem":1},{"lineBreak":true},{"text":"一宿虽然有哭泣，","poem":1},{"lineBreak":true},{"text":"早晨便必欢呼。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"至于我，我凡事平顺，便说：","poem":1},{"lineBreak":true},{"text":"我永不动摇。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华啊，你曾施恩，叫我的江山稳固；","poem":1},{"lineBreak":true},{"text":"你掩了面，我就惊惶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华啊，我曾求告你；","poem":1},{"lineBreak":true},{"text":"我向耶和华恳求，说：","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我被害流血，下到坑中，有什么益处呢？","poem":1},{"lineBreak":true},{"text":"尘土岂能称赞你，传说你的诚实吗？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华啊，求你应允我，怜恤我！","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你帮助我！","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你已将我的哀哭变为跳舞，","poem":1},{"lineBreak":true},{"text":"将我的麻衣脱去，给我披上喜乐，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"好叫我的灵","poem":1},{"noteId":14},{"text":"歌颂你，并不住声。","poem":1},{"lineBreak":true},{"text":"耶和华—我的 神啊，我要称谢你，直到永远！","poem":1}]}],"footnotes":[{"noteId":14,"caller":"-","text":"原文是荣耀","reference":{"chapter":30,"verse":12}}]},"thisChapterLink":"/api/cmn_cu1/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}