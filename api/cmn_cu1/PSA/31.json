{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":31,"content":[{"type":"heading","content":["信靠 神的祈祷"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我投靠你；","poem":1},{"lineBreak":true},{"text":"求你使我永不羞愧；","poem":1},{"lineBreak":true},{"text":"凭你的公义搭救我！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你侧耳而听，","poem":1},{"lineBreak":true},{"text":"快快救我！","poem":1},{"lineBreak":true},{"text":"作我坚固的磐石，","poem":1},{"lineBreak":true},{"text":"拯救我的保障！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因为你是我的岩石，我的山寨；","poem":1},{"lineBreak":true},{"text":"所以，求你为你名的缘故引导我，指点我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"求你救我脱离人为我暗设的网罗，","poem":1},{"lineBreak":true},{"text":"因为你是我的保障。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我将我的灵魂交在你手里；","poem":1},{"lineBreak":true},{"text":"耶和华诚实的 神啊，你救赎了我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我恨恶那信奉虚无之神的人；","poem":1},{"lineBreak":true},{"text":"我却倚靠耶和华。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我要为你的慈爱高兴欢喜；","poem":1},{"lineBreak":true},{"text":"因为你见过我的困苦，知道我心中的艰难。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你未曾把我交在仇敌手里；","poem":1},{"lineBreak":true},{"text":"你使我的脚站在宽阔之处。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和华啊，求你怜恤我，","poem":1},{"lineBreak":true},{"text":"因为我在急难之中；","poem":1},{"lineBreak":true},{"text":"我的眼睛因忧愁而干瘪，","poem":1},{"lineBreak":true},{"text":"连我的身心也不安舒。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的生命为愁苦所消耗；","poem":1},{"lineBreak":true},{"text":"我的年岁为叹息所旷废。","poem":1},{"lineBreak":true},{"text":"我的力量因我的罪孽衰败；","poem":1},{"lineBreak":true},{"text":"我的骨头也枯干。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我因一切敌人成了羞辱，","poem":1},{"lineBreak":true},{"text":"在我的邻舍跟前更甚；","poem":1},{"lineBreak":true},{"text":"那认识我的都惧怕我，","poem":1},{"lineBreak":true},{"text":"在外头看见我的都躲避我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我被人忘记，如同死人，无人记念；","poem":1},{"lineBreak":true},{"text":"我好像破碎的器皿。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我听见了许多人的谗谤，","poem":1},{"lineBreak":true},{"text":"四围都是惊吓；","poem":1},{"lineBreak":true},{"text":"他们一同商议攻击我的时候，","poem":1},{"lineBreak":true},{"text":"就图谋要害我的性命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"耶和华啊，我仍旧倚靠你；","poem":1},{"lineBreak":true},{"text":"我说：你是我的 神。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我终身的事在你手中；","poem":1},{"lineBreak":true},{"text":"求你救我脱离仇敌的手和那些逼迫我的人。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"求你使你的脸光照仆人，","poem":1},{"lineBreak":true},{"text":"凭你的慈爱拯救我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和华啊，求你叫我不致羞愧，","poem":1},{"lineBreak":true},{"text":"因为我曾呼吁你；","poem":1},{"lineBreak":true},{"text":"求你使恶人羞愧，","poem":1},{"lineBreak":true},{"text":"使他们在阴间缄默无声。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"那撒谎的人逞骄傲轻慢，","poem":1},{"lineBreak":true},{"text":"出狂妄的话攻击义人；","poem":1},{"lineBreak":true},{"text":"愿他的嘴哑而无言。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"敬畏你、投靠你的人，你为他们所积存的，","poem":1},{"lineBreak":true},{"text":"在世人面前所施行的恩惠是何等大呢！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你必把他们藏在你面前的隐密处，","poem":1},{"lineBreak":true},{"text":"免得遇见人的计谋；","poem":1},{"lineBreak":true},{"text":"你必暗暗地保守他们在亭子里，","poem":1},{"lineBreak":true},{"text":"免受口舌的争闹。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"耶和华是应当称颂的，","poem":1},{"lineBreak":true},{"text":"因为他在坚固城里向我施展奇妙的慈爱。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"至于我，我曾急促地说：","poem":1},{"lineBreak":true},{"text":"我从你眼前被隔绝。","poem":1},{"lineBreak":true},{"text":"然而，我呼求你的时候，","poem":1},{"lineBreak":true},{"text":"你仍听我恳求的声音。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"耶和华的圣民哪，你们都要爱他！","poem":1},{"lineBreak":true},{"text":"耶和华保护诚实人，","poem":1},{"lineBreak":true},{"text":"足足报应行事骄傲的人。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"凡仰望耶和华的人，","poem":1},{"lineBreak":true},{"text":"你们都要壮胆，坚固你们的心！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}