{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":32,"content":[{"type":"heading","content":["认罪与蒙赦"]},{"type":"hebrew_subtitle","content":["大卫的训诲诗。"]},{"type":"verse","number":1,"content":[{"text":"得赦免其过、遮盖其罪的，","poem":1},{"lineBreak":true},{"text":"这人是有福的！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"凡心里没有诡诈、耶和华不算为有罪的，","poem":1},{"lineBreak":true},{"text":"这人是有福的！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"我闭口不认罪的时候，","poem":1},{"lineBreak":true},{"text":"因终日唉哼而骨头枯干。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"黑夜白日，你的手在我身上沉重；","poem":1},{"lineBreak":true},{"text":"我的精液耗尽，如同夏天的干旱。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我向你陈明我的罪，","poem":1},{"lineBreak":true},{"text":"不隐瞒我的恶。","poem":1},{"lineBreak":true},{"text":"我说：我要向耶和华承认我的过犯，","poem":1},{"lineBreak":true},{"text":"你就赦免我的罪恶。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"为此，凡虔诚人都当趁你可寻找的时候祷告你；","poem":1},{"lineBreak":true},{"text":"大水泛溢的时候，必不能到他那里。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你是我藏身之处；","poem":1},{"lineBreak":true},{"text":"你必保佑我脱离苦难，","poem":1},{"lineBreak":true},{"text":"以得救的乐歌四面环绕我。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我要教导你，指示你当行的路；","poem":1},{"lineBreak":true},{"text":"我要定睛在你身上劝戒你。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你不可像那无知的骡马，","poem":1},{"lineBreak":true},{"text":"必用嚼环辔头勒住它；","poem":1},{"lineBreak":true},{"text":"不然，就不能驯服。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"恶人必多受苦楚；","poem":1},{"lineBreak":true},{"text":"惟独倚靠耶和华的必有慈爱四面环绕他。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你们义人应当靠耶和华欢喜快乐；","poem":1},{"lineBreak":true},{"text":"你们心里正直的人都当欢呼。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}