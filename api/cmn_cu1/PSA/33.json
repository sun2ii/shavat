{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":33,"content":[{"type":"heading","content":["颂赞之歌"]},{"type":"verse","number":1,"content":[{"text":"义人哪，你们应当靠耶和华欢乐；","poem":1},{"lineBreak":true},{"text":"正直人的赞美是合宜的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你们应当弹琴称谢耶和华，","poem":1},{"lineBreak":true},{"text":"用十弦瑟歌颂他。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"应当向他唱新歌，","poem":1},{"lineBreak":true},{"text":"弹得巧妙，声音洪亮。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"因为耶和华的言语正直；","poem":1},{"lineBreak":true},{"text":"凡他所做的尽都诚实。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他喜爱仁义公平；","poem":1},{"lineBreak":true},{"text":"遍地满了耶和华的慈爱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"诸天借耶和华的命而造；","poem":1},{"lineBreak":true},{"text":"万象借他口中的气而成。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他聚集海水如垒，","poem":1},{"lineBreak":true},{"text":"收藏深洋在库房。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"愿全地都敬畏耶和华！","poem":1},{"lineBreak":true},{"text":"愿世上的居民都惧怕他！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为他说有，就有，","poem":1},{"lineBreak":true},{"text":"命立，就立。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华使列国的筹算归于无有，","poem":1},{"lineBreak":true},{"text":"使众民的思念无有功效。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华的筹算永远立定；","poem":1},{"lineBreak":true},{"text":"他心中的思念万代常存。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"以耶和华为 神的，那国是有福的！","poem":1},{"lineBreak":true},{"text":"他所拣选为自己产业的，那民是有福的！","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和华从天上观看；","poem":1},{"lineBreak":true},{"text":"他看见一切的世人。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"从他的居所往外察看地上一切的居民—","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他是那造成他们众人心的，","poem":1},{"lineBreak":true},{"text":"留意他们一切作为的。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"君王不能因兵多得胜；","poem":1},{"lineBreak":true},{"text":"勇士不能因力大得救。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"靠马得救是枉然的；","poem":1},{"lineBreak":true},{"text":"马也不能因力大救人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"耶和华的眼目看顾敬畏他的人","poem":1},{"lineBreak":true},{"text":"和仰望他慈爱的人，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"要救他们的命脱离死亡，","poem":1},{"lineBreak":true},{"text":"并使他们在饥荒中存活。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"我们的心向来等候耶和华；","poem":1},{"lineBreak":true},{"text":"他是我们的帮助，我们的盾牌。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我们的心必靠他欢喜，","poem":1},{"lineBreak":true},{"text":"因为我们向来倚靠他的圣名。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和华啊，求你照着我们所仰望你的，","poem":1},{"lineBreak":true},{"text":"向我们施行慈爱！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}