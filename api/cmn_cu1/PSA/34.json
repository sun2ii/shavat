{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":34,"content":[{"type":"heading","content":["颂赞 神的美善"]},{"type":"hebrew_subtitle","content":["大卫在亚比米勒面前装疯，被他赶出去，就作这诗。"]},{"type":"verse","number":1,"content":[{"text":"我要时时称颂耶和华；","poem":1},{"lineBreak":true},{"text":"赞美他的话必常在我口中。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的心必因耶和华夸耀；","poem":1},{"lineBreak":true},{"text":"谦卑人听见就要喜乐。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你们和我当称耶和华为大，","poem":1},{"lineBreak":true},{"text":"一同高举他的名。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我曾寻求耶和华，他就应允我，","poem":1},{"lineBreak":true},{"text":"救我脱离了一切的恐惧。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"凡仰望他的，便有光荣；","poem":1},{"lineBreak":true},{"text":"他们的脸必不蒙羞。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我这困苦人呼求，耶和华便垂听，","poem":1},{"lineBreak":true},{"text":"救我脱离一切患难。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华的使者在敬畏他的人四围安营，","poem":1},{"lineBreak":true},{"text":"搭救他们。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你们要尝尝主恩的滋味，便知道他是美善；","poem":1},{"lineBreak":true},{"text":"投靠他的人有福了！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华的圣民哪，你们当敬畏他，","poem":1},{"lineBreak":true},{"text":"因敬畏他的一无所缺。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"少壮狮子还缺食忍饿，","poem":1},{"lineBreak":true},{"text":"但寻求耶和华的什么好处都不缺。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"众弟子啊，你们当来听我的话！","poem":1},{"lineBreak":true},{"text":"我要将敬畏耶和华的道教训你们。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"有何人喜好存活，","poem":1},{"lineBreak":true},{"text":"爱慕长寿，得享美福，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"就要禁止舌头不出恶言，","poem":1},{"lineBreak":true},{"text":"嘴唇不说诡诈的话。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"要离恶行善，","poem":1},{"lineBreak":true},{"text":"寻求和睦，一心追赶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"耶和华的眼目看顾义人；","poem":1},{"lineBreak":true},{"text":"他的耳朵听他们的呼求。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华向行恶的人变脸，","poem":1},{"lineBreak":true},{"text":"要从世上除灭他们的名号。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"义人呼求，耶和华听见了，","poem":1},{"lineBreak":true},{"text":"便救他们脱离一切患难。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和华靠近伤心的人，","poem":1},{"lineBreak":true},{"text":"拯救灵性痛悔的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"义人多有苦难，","poem":1},{"lineBreak":true},{"text":"但耶和华救他脱离这一切，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"又保全他一身的骨头，","poem":1},{"lineBreak":true},{"text":"连一根也不折断。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"恶必害死恶人；","poem":1},{"lineBreak":true},{"text":"恨恶义人的，必被定罪。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和华救赎他仆人的灵魂；","poem":1},{"lineBreak":true},{"text":"凡投靠他的，必不致定罪。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}