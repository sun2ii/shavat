{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":35,"content":[{"type":"heading","content":["求助的祷告"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，与我相争的，求你与他们相争！","poem":1},{"lineBreak":true},{"text":"与我相战的，求你与他们相战！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"拿着大小的盾牌，","poem":1},{"lineBreak":true},{"text":"起来帮助我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"抽出枪来，挡住那追赶我的；","poem":1},{"lineBreak":true},{"text":"求你对我的灵魂说：我是拯救你的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"愿那寻索我命的，蒙羞受辱！","poem":1},{"lineBreak":true},{"text":"愿那谋害我的，退后羞愧！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愿他们像风前的糠，","poem":1},{"lineBreak":true},{"text":"有耶和华的使者赶逐他们。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愿他们的道路又暗又滑，","poem":1},{"lineBreak":true},{"text":"有耶和华的使者追赶他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"因他们无故地为我暗设网罗，","poem":1},{"lineBreak":true},{"text":"无故地挖坑，要害我的性命。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愿灾祸忽然临到他身上！","poem":1},{"lineBreak":true},{"text":"愿他暗设的网缠住自己！","poem":1},{"lineBreak":true},{"text":"愿他落在其中遭灾祸！","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我的心必靠耶和华快乐，","poem":1},{"lineBreak":true},{"text":"靠他的救恩高兴。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的骨头都要说：","poem":1},{"lineBreak":true},{"text":"耶和华啊，谁能像你","poem":1},{"lineBreak":true},{"text":"救护困苦人脱离那比他强壮的，","poem":1},{"lineBreak":true},{"text":"救护困苦穷乏人脱离那抢夺他的？","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"凶恶的见证人起来，","poem":1},{"lineBreak":true},{"text":"盘问我所不知道的事。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们向我以恶报善，","poem":1},{"lineBreak":true},{"text":"使我的灵魂孤苦。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"至于我，当他们有病的时候，","poem":1},{"lineBreak":true},{"text":"我便穿麻衣，禁食，刻苦己心；","poem":1},{"lineBreak":true},{"text":"我所求的都归到自己的怀中。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我这样行，好像他是我的朋友，我的弟兄；","poem":1},{"lineBreak":true},{"text":"我屈身悲哀，如同人为母亲哀痛。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"我在患难中，他们却欢喜，大家聚集。","poem":1},{"lineBreak":true},{"text":"我所不认识的那些下流人聚集攻击我；","poem":1},{"lineBreak":true},{"text":"他们不住地把我撕裂。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他们如同席上好嬉笑的狂妄人向我咬牙。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"主啊，你看着不理要到几时呢？","poem":1},{"lineBreak":true},{"text":"求你救我的灵魂脱离他们的残害！","poem":1},{"lineBreak":true},{"text":"救我的生命","poem":1},{"noteId":15},{"text":"脱离少壮狮子！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我在大会中要称谢你，","poem":1},{"lineBreak":true},{"text":"在众民中要赞美你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"求你不容那无理与我为仇的向我夸耀！","poem":1},{"lineBreak":true},{"text":"不容那无故恨我的向我挤眼！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"因为他们不说和平话，","poem":1},{"lineBreak":true},{"text":"倒想出诡诈的言语害地上的安静人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们大大张口攻击我，说：","poem":1},{"lineBreak":true},{"text":"阿哈，阿哈，我们的眼已经看见了！","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"耶和华啊，你已经看见了，求你不要闭口！","poem":1},{"lineBreak":true},{"text":"主啊，求你不要远离我！","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我的 神我的主啊，求你奋兴醒起，","poem":1},{"lineBreak":true},{"text":"判清我的事，伸明我的冤！","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"耶和华—我的 神啊，求你按你的公义判断我，","poem":1},{"lineBreak":true},{"text":"不容他们向我夸耀！","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"不容他们心里说：阿哈，遂我们的心愿了！","poem":1},{"lineBreak":true},{"text":"不容他们说：我们已经把他吞了！","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"愿那喜欢我遭难的一同抱愧蒙羞！","poem":1},{"lineBreak":true},{"text":"愿那向我妄自尊大的披惭愧，蒙羞辱！","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"愿那喜悦我冤屈得伸的","poem":1},{"noteId":16},{"text":"欢呼快乐；","poem":1},{"lineBreak":true},{"text":"愿他们常说：当尊耶和华为大！","poem":1},{"lineBreak":true},{"text":"耶和华喜悦他的仆人平安。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我的舌头要终日论说你的公义，","poem":1},{"lineBreak":true},{"text":"时常赞美你。","poem":1}]}],"footnotes":[{"noteId":15,"caller":"-","text":"生命：原文是独一者","reference":{"chapter":35,"verse":17}},{"noteId":16,"caller":"-","text":"冤屈得伸：原文是公义","reference":{"chapter":35,"verse":27}}]},"thisChapterLink":"/api/cmn_cu1/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}