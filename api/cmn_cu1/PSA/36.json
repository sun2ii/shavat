{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":36,"content":[{"type":"heading","content":["人的邪恶"]},{"type":"hebrew_subtitle","content":["耶和华的仆人大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"恶人的罪过在他心里说：","poem":1},{"lineBreak":true},{"text":"我眼中不怕 神！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他自夸自媚，","poem":1},{"lineBreak":true},{"text":"以为他的罪孽终不显露，不被恨恶。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他口中的言语尽是罪孽诡诈；","poem":1},{"lineBreak":true},{"text":"他与智慧善行已经断绝。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他在床上图谋罪孽，","poem":1},{"lineBreak":true},{"text":"定意行不善的道，不憎恶恶事。","poem":1}]},{"type":"heading","content":["神的良善"]},{"type":"verse","number":5,"content":[{"text":"耶和华啊，你的慈爱上及诸天；","poem":1},{"lineBreak":true},{"text":"你的信实达到穹苍。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你的公义好像高山；","poem":1},{"lineBreak":true},{"text":"你的判断如同深渊。","poem":1},{"lineBreak":true},{"text":"耶和华啊，人民、牲畜，你都救护。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"神啊，你的慈爱何其宝贵！","poem":1},{"lineBreak":true},{"text":"世人投靠在你翅膀的荫下。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们必因你殿里的肥甘得以饱足；","poem":1},{"lineBreak":true},{"text":"你也必叫他们喝你乐河的水。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为，在你那里有生命的源头；","poem":1},{"lineBreak":true},{"text":"在你的光中，我们必得见光。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"愿你常施慈爱给认识你的人，","poem":1},{"lineBreak":true},{"text":"常以公义待心里正直的人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"不容骄傲人的脚践踏我；","poem":1},{"lineBreak":true},{"text":"不容凶恶人的手赶逐我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"在那里，作孽的人已经仆倒；","poem":1},{"lineBreak":true},{"text":"他们被推倒，不能再起来。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}