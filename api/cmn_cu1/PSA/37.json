{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":37,"content":[{"type":"heading","content":["义人和恶人的结局"]},{"type":"hebrew_subtitle","content":["大卫的诗。"]},{"type":"verse","number":1,"content":[{"text":"不要为作恶的心怀不平，","poem":1},{"lineBreak":true},{"text":"也不要向那行不义的生出嫉妒。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为他们如草快被割下，","poem":1},{"lineBreak":true},{"text":"又如青菜快要枯干。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你当倚靠耶和华而行善，","poem":1},{"lineBreak":true},{"text":"住在地上，以他的信实为粮；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"又要以耶和华为乐，","poem":1},{"lineBreak":true},{"text":"他就将你心里所求的赐给你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"当将你的事交托耶和华，","poem":1},{"lineBreak":true},{"text":"并倚靠他，他就必成全。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他要使你的公义如光发出，","poem":1},{"lineBreak":true},{"text":"使你的公平明如正午。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"你当默然倚靠耶和华，耐性等候他；","poem":1},{"lineBreak":true},{"text":"不要因那道路通达的和那恶谋成就的心怀不平。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"当止住怒气，离弃忿怒；","poem":1},{"lineBreak":true},{"text":"不要心怀不平，以致作恶。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为作恶的必被剪除；","poem":1},{"lineBreak":true},{"text":"惟有等候耶和华的必承受地土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"还有片时，恶人要归于无有；","poem":1},{"lineBreak":true},{"text":"你就是细察他的住处也要归于无有。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"但谦卑人必承受地土，","poem":1},{"lineBreak":true},{"text":"以丰盛的平安为乐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"恶人设谋害义人，","poem":1},{"lineBreak":true},{"text":"又向他咬牙。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"主要笑他，","poem":1},{"lineBreak":true},{"text":"因见他受罚的日子将要来到。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"恶人已经弓上弦，刀出鞘，","poem":1},{"lineBreak":true},{"text":"要打倒困苦穷乏的人，","poem":1},{"lineBreak":true},{"text":"要杀害行动正直的人。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他们的刀必刺入自己的心；","poem":1},{"lineBreak":true},{"text":"他们的弓必被折断。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"一个义人所有的虽少，","poem":1},{"lineBreak":true},{"text":"强过许多恶人的富余。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因为恶人的膀臂必被折断；","poem":1},{"lineBreak":true},{"text":"但耶和华是扶持义人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"耶和华知道完全人的日子；","poem":1},{"lineBreak":true},{"text":"他们的产业要存到永远。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他们在急难的时候不致羞愧，","poem":1},{"lineBreak":true},{"text":"在饥荒的日子必得饱足。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"恶人却要灭亡。","poem":1},{"lineBreak":true},{"text":"耶和华的仇敌要像羊羔的脂油","poem":1},{"noteId":17},{"text":"；","poem":1},{"lineBreak":true},{"text":"他们要消灭，要如烟消灭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"恶人借贷而不偿还；","poem":1},{"lineBreak":true},{"text":"义人却恩待人，并且施舍。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"蒙耶和华赐福的必承受地土；","poem":1},{"lineBreak":true},{"text":"被他咒诅的必被剪除。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"义人的脚步被耶和华立定；","poem":1},{"lineBreak":true},{"text":"他的道路，耶和华也喜爱。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他虽失脚也不至全身仆倒，","poem":1},{"lineBreak":true},{"text":"因为耶和华用手搀扶他","poem":1},{"noteId":18},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"我从前年幼，现在年老，","poem":1},{"lineBreak":true},{"text":"却未见过义人被弃，","poem":1},{"lineBreak":true},{"text":"也未见过他的后裔讨饭。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他终日恩待人，借给人；","poem":1},{"lineBreak":true},{"text":"他的后裔也蒙福！","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"你当离恶行善，","poem":1},{"lineBreak":true},{"text":"就可永远安居。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"因为，耶和华喜爱公平，","poem":1},{"lineBreak":true},{"text":"不撇弃他的圣民；","poem":1},{"lineBreak":true},{"text":"他们永蒙保佑，","poem":1},{"lineBreak":true},{"text":"但恶人的后裔必被剪除。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"义人必承受地土，","poem":1},{"lineBreak":true},{"text":"永居其上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"义人的口谈论智慧；","poem":1},{"lineBreak":true},{"text":"他的舌头讲说公平。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"神的律法在他心里；","poem":1},{"lineBreak":true},{"text":"他的脚总不滑跌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"恶人窥探义人，","poem":1},{"lineBreak":true},{"text":"想要杀他。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"耶和华必不撇他在恶人手中；","poem":1},{"lineBreak":true},{"text":"当审判的时候，也不定他的罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"你当等候耶和华，遵守他的道，","poem":1},{"lineBreak":true},{"text":"他就抬举你，使你承受地土；","poem":1},{"lineBreak":true},{"text":"恶人被剪除的时候，你必看见。","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"我见过恶人大有势力，","poem":1},{"lineBreak":true},{"text":"好像一棵青翠树在本土生发。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"有人从那里经过，不料，他没有了；","poem":1},{"lineBreak":true},{"text":"我也寻找他，却寻不着。","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"你要细察那完全人，观看那正直人，","poem":1},{"lineBreak":true},{"text":"因为和平人有好结局。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"至于犯法的人，必一同灭绝；","poem":1},{"lineBreak":true},{"text":"恶人终必剪除。","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"但义人得救是由于耶和华；","poem":1},{"lineBreak":true},{"text":"他在患难时作他们的营寨。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"耶和华帮助他们，解救他们；","poem":1},{"lineBreak":true},{"text":"他解救他们脱离恶人，把他们救出来，","poem":1},{"lineBreak":true},{"text":"因为他们投靠他。","poem":1}]}],"footnotes":[{"noteId":17,"caller":"-","text":"或译：像草地的华美","reference":{"chapter":37,"verse":20}},{"noteId":18,"caller":"-","text":"或译：搀扶他的手","reference":{"chapter":37,"verse":24}}]},"thisChapterLink":"/api/cmn_cu1/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}