{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":38,"content":[{"type":"heading","content":["受苦者的祈祷"]},{"type":"hebrew_subtitle","content":["大卫的纪念诗。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你不要在怒中责备我，","poem":1},{"lineBreak":true},{"text":"不要在烈怒中惩罚我！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为，你的箭射入我身；","poem":1},{"lineBreak":true},{"text":"你的手压住我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因你的恼怒，我的肉无一完全；","poem":1},{"lineBreak":true},{"text":"因我的罪过，我的骨头也不安宁。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的罪孽高过我的头，","poem":1},{"lineBreak":true},{"text":"如同重担叫我担当不起。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"因我的愚昧，","poem":1},{"lineBreak":true},{"text":"我的伤发臭流脓。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我疼痛，大大拳曲，","poem":1},{"lineBreak":true},{"text":"终日哀痛。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我满腰是火；","poem":1},{"lineBreak":true},{"text":"我的肉无一完全。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我被压伤，身体疲倦；","poem":1},{"lineBreak":true},{"text":"因心里不安，我就唉哼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"主啊，我的心愿都在你面前；","poem":1},{"lineBreak":true},{"text":"我的叹息不向你隐瞒。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我心跳动，我力衰微，","poem":1},{"lineBreak":true},{"text":"连我眼中的光也没有了。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的良朋密友因我的灾病都躲在旁边站着；","poem":1},{"lineBreak":true},{"text":"我的亲戚本家也远远地站立。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"那寻索我命的设下网罗；","poem":1},{"lineBreak":true},{"text":"那想要害我的口出恶言，","poem":1},{"lineBreak":true},{"text":"终日思想诡计。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"但我如聋子不听，","poem":1},{"lineBreak":true},{"text":"像哑巴不开口。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我如不听见的人，","poem":1},{"lineBreak":true},{"text":"口中没有回话。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"耶和华啊，我仰望你！","poem":1},{"lineBreak":true},{"text":"主—我的 神啊，你必应允我！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我曾说：恐怕他们向我夸耀；","poem":1},{"lineBreak":true},{"text":"我失脚的时候，他们向我夸大。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"我几乎跌倒；","poem":1},{"lineBreak":true},{"text":"我的痛苦常在我面前。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要承认我的罪孽；","poem":1},{"lineBreak":true},{"text":"我要因我的罪忧愁。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"但我的仇敌又活泼又强壮，","poem":1},{"lineBreak":true},{"text":"无理恨我的增多了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"以恶报善的与我作对，","poem":1},{"lineBreak":true},{"text":"因我是追求良善。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"耶和华啊，求你不要撇弃我！","poem":1},{"lineBreak":true},{"text":"我的 神啊，求你不要远离我！","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"拯救我的主啊，求你快快帮助我！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}