{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":39,"content":[{"type":"heading","content":["受苦者的认罪"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长耶杜顿。"]},{"type":"verse","number":1,"content":[{"text":"我曾说：我要谨慎我的言行，","poem":1},{"lineBreak":true},{"text":"免得我舌头犯罪；","poem":1},{"lineBreak":true},{"text":"恶人在我面前的时候，","poem":1},{"lineBreak":true},{"text":"我要用嚼环勒住我的口。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我默然无声，连好话也不出口；","poem":1},{"lineBreak":true},{"text":"我的愁苦就发动了，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的心在我里面发热。","poem":1},{"lineBreak":true},{"text":"我默想的时候，火就烧起，","poem":1},{"lineBreak":true},{"text":"我便用舌头说话。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华啊，求你叫我晓得我身之终！","poem":1},{"lineBreak":true},{"text":"我的寿数几何？","poem":1},{"lineBreak":true},{"text":"叫我知道我的生命不长！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你使我的年日窄如手掌；","poem":1},{"lineBreak":true},{"text":"我一生的年数，在你面前如同无有。","poem":1},{"lineBreak":true},{"text":"各人最稳妥的时候，真是全然虚幻。 （细拉）","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"世人行动实系幻影。","poem":1},{"lineBreak":true},{"text":"他们忙乱，真是枉然；","poem":1},{"lineBreak":true},{"text":"积蓄财宝，不知将来有谁收取。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"主啊，如今我等什么呢？","poem":1},{"lineBreak":true},{"text":"我的指望在乎你！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你救我脱离一切的过犯，","poem":1},{"lineBreak":true},{"text":"不要使我受愚顽人的羞辱。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因我所遭遇的是出于你，","poem":1},{"lineBreak":true},{"text":"我就默然不语。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"求你把你的责罚从我身上免去；","poem":1},{"lineBreak":true},{"text":"因你手的责打，我便消灭。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你因人的罪恶惩罚他的时候，","poem":1},{"lineBreak":true},{"text":"叫他的笑容","poem":1},{"noteId":19},{"text":"消灭，如衣被虫所咬。","poem":1},{"lineBreak":true},{"text":"世人真是虚幻！ （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和华啊，求你听我的祷告，","poem":1},{"lineBreak":true},{"text":"留心听我的呼求！","poem":1},{"lineBreak":true},{"text":"我流泪，求你不要静默无声！","poem":1},{"lineBreak":true},{"text":"因为我在你面前是客旅，","poem":1},{"lineBreak":true},{"text":"是寄居的，像我列祖一般。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"求你宽容我，","poem":1},{"lineBreak":true},{"text":"使我在去而不返之先可以力量复原。","poem":1}]}],"footnotes":[{"noteId":19,"caller":"-","text":"的笑容：或译所喜爱的","reference":{"chapter":39,"verse":11}}]},"thisChapterLink":"/api/cmn_cu1/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}