{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":41,"content":[{"type":"heading","content":["病中祈祷"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"眷顾贫穷的有福了！","poem":1},{"lineBreak":true},{"text":"他遭难的日子，耶和华必搭救他。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华必保全他，使他存活；","poem":1},{"lineBreak":true},{"text":"他必在地上享福。","poem":1},{"lineBreak":true},{"text":"求你不要把他交给仇敌，遂其所愿。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他病重在榻，耶和华必扶持他；","poem":1},{"lineBreak":true},{"text":"他在病中，你必给他铺床。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我曾说：耶和华啊，求你怜恤我，医治我！","poem":1},{"lineBreak":true},{"text":"因为我得罪了你。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的仇敌用恶言议论我说：","poem":1},{"lineBreak":true},{"text":"他几时死，他的名才灭亡呢？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他来看我就说假话；","poem":1},{"lineBreak":true},{"text":"他心存奸恶，走到外边才说出来。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"一切恨我的，都交头接耳地议论我；","poem":1},{"lineBreak":true},{"text":"他们设计要害我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"他们说：有怪病贴在他身上；","poem":1},{"lineBreak":true},{"text":"他已躺卧，必不能再起来。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"连我知己的朋友，","poem":1},{"lineBreak":true},{"text":"我所倚靠、吃过我饭的也用脚踢我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华啊，求你怜恤我，","poem":1},{"lineBreak":true},{"text":"使我起来，好报复他们！","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"因我的仇敌不得向我夸胜，","poem":1},{"lineBreak":true},{"text":"我从此便知道你喜爱我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你因我纯正就扶持我，","poem":1},{"lineBreak":true},{"text":"使我永远站在你的面前。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和华—以色列的 神是应当称颂的，","poem":1},{"lineBreak":true},{"text":"从亘古直到永远。阿们！阿们！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}