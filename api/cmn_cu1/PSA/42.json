{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":42,"content":[{"type":"heading","content":["流亡异乡者的祷告（一）"]},{"type":"hebrew_subtitle","content":["可拉后裔的训诲诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"神啊，我的心切慕你，","poem":1},{"lineBreak":true},{"text":"如鹿切慕溪水。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的心渴想 神，就是永生 神；","poem":1},{"lineBreak":true},{"text":"我几时得朝见 神呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我昼夜以眼泪当饮食；","poem":1},{"lineBreak":true},{"text":"人不住地对我说：你的 神在哪里呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我从前与众人同往，","poem":1},{"lineBreak":true},{"text":"用欢呼称赞的声音","poem":1},{"lineBreak":true},{"text":"领他们到 神的殿里，大家守节。","poem":1},{"lineBreak":true},{"text":"我追想这些事，","poem":1},{"lineBreak":true},{"text":"我的心极其悲伤。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的心哪，你为何忧闷？","poem":1},{"lineBreak":true},{"text":"为何在我里面烦躁？","poem":1},{"lineBreak":true},{"text":"应当仰望 神，因他笑脸帮助我；","poem":1},{"lineBreak":true},{"text":"我还要称赞他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我的 神啊，我的心在我里面忧闷，","poem":1},{"lineBreak":true},{"text":"所以我从约旦地，","poem":1},{"lineBreak":true},{"text":"从黑门岭，从米萨山记念你。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的瀑布发声，深渊就与深渊响应；","poem":1},{"lineBreak":true},{"text":"你的波浪洪涛漫过我身。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"白昼，耶和华必向我施慈爱；","poem":1},{"lineBreak":true},{"text":"黑夜，我要歌颂祷告赐我生命的 神。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我要对 神—我的磐石说：","poem":1},{"lineBreak":true},{"text":"你为何忘记我呢？","poem":1},{"lineBreak":true},{"text":"我为何因仇敌的欺压时常哀痛呢？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的敌人辱骂我，","poem":1},{"lineBreak":true},{"text":"好像打碎我的骨头，","poem":1},{"lineBreak":true},{"text":"不住地对我说：","poem":1},{"lineBreak":true},{"text":"你的 神在哪里呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我的心哪，你为何忧闷？","poem":1},{"lineBreak":true},{"text":"为何在我里面烦躁？","poem":1},{"lineBreak":true},{"text":"应当仰望 神，因我还要称赞他。","poem":1},{"lineBreak":true},{"text":"他是我脸上的光荣","poem":1},{"noteId":20},{"text":"，是我的 神。","poem":1}]}],"footnotes":[{"noteId":20,"caller":"-","text":"原文是帮助","reference":{"chapter":42,"verse":11}}]},"thisChapterLink":"/api/cmn_cu1/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}