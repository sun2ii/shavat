{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":43,"content":[{"type":"heading","content":["流亡异乡者的祷告（二）"]},{"type":"verse","number":1,"content":[{"text":"神啊，求你伸我的冤，","poem":1},{"lineBreak":true},{"text":"向不虔诚的国为我辨屈；","poem":1},{"lineBreak":true},{"text":"求你救我脱离诡诈不义的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为你是赐我力量的 神，为何丢弃我呢？","poem":1},{"lineBreak":true},{"text":"我为何因仇敌的欺压时常哀痛呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"求你发出你的亮光和真实，好引导我，","poem":1},{"lineBreak":true},{"text":"带我到你的圣山，到你的居所！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我就走到 神的祭坛，","poem":1},{"lineBreak":true},{"text":"到我最喜乐的 神那里。","poem":1},{"lineBreak":true},{"text":"神啊，我的 神，","poem":1},{"lineBreak":true},{"text":"我要弹琴称赞你！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我的心哪，你为何忧闷？","poem":1},{"lineBreak":true},{"text":"为何在我里面烦躁？","poem":1},{"lineBreak":true},{"text":"应当仰望 神，因我还要称赞他。","poem":1},{"lineBreak":true},{"text":"他是我脸上的光荣","poem":1},{"noteId":21},{"text":"，是我的 神。","poem":1}]}],"footnotes":[{"noteId":21,"caller":"-","text":"原文是帮助","reference":{"chapter":43,"verse":5}}]},"thisChapterLink":"/api/cmn_cu1/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}