{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":44,"content":[{"type":"heading","content":["求主保护"]},{"type":"hebrew_subtitle","content":["可拉后裔的训诲诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"神啊，你在古时，","poem":1},{"lineBreak":true},{"text":"我们列祖的日子所行的事，","poem":1},{"lineBreak":true},{"text":"我们亲耳听见了；","poem":1},{"lineBreak":true},{"text":"我们的列祖也给我们述说过。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你曾用手赶出外邦人，","poem":1},{"lineBreak":true},{"text":"却栽培了我们列祖；","poem":1},{"lineBreak":true},{"text":"你苦待列邦，","poem":1},{"lineBreak":true},{"text":"却叫我们列祖发达。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为他们不是靠自己的刀剑得地土，","poem":1},{"lineBreak":true},{"text":"也不是靠自己的膀臂得胜，","poem":1},{"lineBreak":true},{"text":"乃是靠你的右手、你的膀臂，","poem":1},{"lineBreak":true},{"text":"和你脸上的亮光，","poem":1},{"lineBreak":true},{"text":"因为你喜悦他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"神啊，你是我的王；","poem":1},{"lineBreak":true},{"text":"求你出令使雅各得胜。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我们靠你要推倒我们的敌人，","poem":1},{"lineBreak":true},{"text":"靠你的名要践踏那起来攻击我们的人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因为，我必不靠我的弓；","poem":1},{"lineBreak":true},{"text":"我的刀也不能使我得胜。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"惟你救了我们脱离敌人，","poem":1},{"lineBreak":true},{"text":"使恨我们的人羞愧。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我们终日因 神夸耀，","poem":1},{"lineBreak":true},{"text":"还要永远称谢你的名。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"但如今你丢弃了我们，使我们受辱，","poem":1},{"lineBreak":true},{"text":"不和我们的军兵同去。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你使我们向敌人转身退后；","poem":1},{"lineBreak":true},{"text":"那恨我们的人任意抢夺。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你使我们当作快要被吃的羊，","poem":1},{"lineBreak":true},{"text":"把我们分散在列邦中。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你卖了你的子民也不赚利，","poem":1},{"lineBreak":true},{"text":"所得的价值并不加添你的资财。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"你使我们受邻国的羞辱，","poem":1},{"lineBreak":true},{"text":"被四围的人嗤笑讥刺。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你使我们在列邦中作了笑谈，","poem":1},{"lineBreak":true},{"text":"使众民向我们摇头。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的凌辱终日在我面前，","poem":1},{"lineBreak":true},{"text":"我脸上的羞愧将我遮蔽，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"都因那辱骂毁谤人的声音，","poem":1},{"lineBreak":true},{"text":"又因仇敌和报仇人的缘故。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"这都临到我们身上，","poem":1},{"lineBreak":true},{"text":"我们却没有忘记你，","poem":1},{"lineBreak":true},{"text":"也没有违背你的约。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我们的心没有退后；","poem":1},{"lineBreak":true},{"text":"我们的脚也没有偏离你的路。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你在野狗之处压伤我们，","poem":1},{"lineBreak":true},{"text":"用死荫遮蔽我们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"倘若我们忘了 神的名，","poem":1},{"lineBreak":true},{"text":"或向别神举手，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"神岂不鉴察这事吗？","poem":1},{"lineBreak":true},{"text":"因为他晓得人心里的隐秘。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我们为你的缘故终日被杀；","poem":1},{"lineBreak":true},{"text":"人看我们如将宰的羊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"主啊，求你睡醒，为何尽睡呢？","poem":1},{"lineBreak":true},{"text":"求你兴起，不要永远丢弃我们！","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你为何掩面，","poem":1},{"lineBreak":true},{"text":"不顾我们所遭的苦难和所受的欺压？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我们的性命伏于尘土；","poem":1},{"lineBreak":true},{"text":"我们的肚腹紧贴地面。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"求你起来帮助我们！","poem":1},{"lineBreak":true},{"text":"凭你的慈爱救赎我们！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}