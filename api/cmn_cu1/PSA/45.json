{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":45,"content":[{"type":"heading","content":["王家婚礼诗歌"]},{"type":"hebrew_subtitle","content":["可拉后裔的训诲诗，又是爱慕歌，交与伶长。调用百合花。"]},{"type":"verse","number":1,"content":[{"text":"我心里涌出美辞；","poem":1},{"lineBreak":true},{"text":"我论到我为王做的事，","poem":1},{"lineBreak":true},{"text":"我的舌头是快手笔。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"你比世人更美；","poem":1},{"lineBreak":true},{"text":"在你嘴里满有恩惠；","poem":1},{"lineBreak":true},{"text":"所以 神赐福给你，直到永远。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"大能者啊，愿你腰间佩刀，","poem":1},{"lineBreak":true},{"text":"大有荣耀和威严！","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"为真理、谦卑、公义赫然坐车前往，无不得胜；","poem":1},{"lineBreak":true},{"text":"你的右手必显明可畏的事。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的箭锋快，射中王敌之心；","poem":1},{"lineBreak":true},{"text":"万民仆倒在你以下。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"神啊，你的宝座是永永远远的；","poem":1},{"lineBreak":true},{"text":"你的国权是正直的。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你喜爱公义，恨恶罪恶；","poem":1},{"lineBreak":true},{"text":"所以 神—就是你的 神—用喜乐油膏你，","poem":1},{"lineBreak":true},{"text":"胜过膏你的同伴。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你的衣服都有没药、沉香、肉桂的香气；","poem":1},{"lineBreak":true},{"text":"象牙宫中有丝弦乐器的声音使你欢喜。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"有君王的女儿在你尊贵妇女之中；","poem":1},{"lineBreak":true},{"text":"王后佩戴俄斐金饰站在你右边。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"女子啊，你要听，要想，要侧耳而听！","poem":1},{"lineBreak":true},{"text":"不要记念你的民和你的父家，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"王就羡慕你的美貌；","poem":1},{"lineBreak":true},{"text":"因为他是你的主，你当敬拜他。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"泰尔的民","poem":1},{"noteId":22},{"text":"必来送礼；","poem":1},{"lineBreak":true},{"text":"民中的富足人也必向你求恩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"王女在宫里极其荣华；","poem":1},{"lineBreak":true},{"text":"她的衣服是用金线绣的。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"她要穿锦绣的衣服，被引到王前；","poem":1},{"lineBreak":true},{"text":"随从她的陪伴童女也要被带到你面前。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"她们要欢喜快乐被引导；","poem":1},{"lineBreak":true},{"text":"她们要进入王宫。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"你的子孙要接续你的列祖；","poem":1},{"lineBreak":true},{"text":"你要立他们在全地作王。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我必叫你的名被万代记念，","poem":1},{"lineBreak":true},{"text":"所以万民要永永远远称谢你。","poem":1}]}],"footnotes":[{"noteId":22,"caller":"-","text":"原文是女子","reference":{"chapter":45,"verse":12}}]},"thisChapterLink":"/api/cmn_cu1/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}