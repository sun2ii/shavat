{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":46,"content":[{"type":"heading","content":["神与我们同在"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗歌，交与伶长。调用女音。"]},{"type":"verse","number":1,"content":[{"text":"神是我们的避难所，是我们的力量，","poem":1},{"lineBreak":true},{"text":"是我们在患难中随时的帮助。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"所以，地虽改变，","poem":1},{"lineBreak":true},{"text":"山虽摇动到海心，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"其中的水虽匉訇翻腾，","poem":1},{"lineBreak":true},{"text":"山虽因海涨而战抖，","poem":1},{"lineBreak":true},{"text":"我们也不害怕。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"有一道河，这河的分汊使 神的城欢喜；","poem":1},{"lineBreak":true},{"text":"这城就是至高者居住的圣所。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"神在其中，城必不动摇；","poem":1},{"lineBreak":true},{"text":"到天一亮， 神必帮助这城。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"外邦喧嚷，列国动摇；","poem":1},{"lineBreak":true},{"text":"神发声，地便熔化。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"万军之耶和华与我们同在；","poem":1},{"lineBreak":true},{"text":"雅各的 神是我们的避难所！ （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你们来看耶和华的作为，","poem":1},{"lineBreak":true},{"text":"看他使地怎样荒凉。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他止息刀兵，直到地极；","poem":1},{"lineBreak":true},{"text":"他折弓、断枪，把战车焚烧在火中。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你们要休息，要知道我是 神！","poem":1},{"lineBreak":true},{"text":"我必在外邦中被尊崇，在遍地上也被尊崇。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"万军之耶和华与我们同在；","poem":1},{"lineBreak":true},{"text":"雅各的 神是我们的避难所！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}