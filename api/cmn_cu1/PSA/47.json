{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":47,"content":[{"type":"heading","content":["至高的主宰"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"万民哪，你们都要拍掌！","poem":1},{"lineBreak":true},{"text":"要用夸胜的声音向 神呼喊！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为耶和华至高者是可畏的；","poem":1},{"lineBreak":true},{"text":"他是治理全地的大君王。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他叫万民服在我们以下，","poem":1},{"lineBreak":true},{"text":"又叫列邦服在我们脚下。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他为我们选择产业，","poem":1},{"lineBreak":true},{"text":"就是他所爱之雅各的荣耀。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"神上升，有喊声相送；","poem":1},{"lineBreak":true},{"text":"耶和华上升，有角声相送。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你们要向 神歌颂，歌颂！","poem":1},{"lineBreak":true},{"text":"向我们王歌颂，歌颂！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因为 神是全地的王；","poem":1},{"lineBreak":true},{"text":"你们要用悟性歌颂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"神作王治理万国；","poem":1},{"lineBreak":true},{"text":"神坐在他的圣宝座上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"列邦的君王聚集要作亚伯拉罕之 神的民。","poem":1},{"lineBreak":true},{"text":"因为世界的盾牌是属 神的；","poem":1},{"lineBreak":true},{"text":"他为至高！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}