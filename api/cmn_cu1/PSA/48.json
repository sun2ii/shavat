{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":48,"content":[{"type":"heading","content":["锡安— 神的城"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和华本为大！","poem":1},{"lineBreak":true},{"text":"在我们 神的城中，","poem":1},{"lineBreak":true},{"text":"在他的圣山上，该受大赞美。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"锡安山—大君王的城，","poem":1},{"lineBreak":true},{"text":"在北面居高华美，","poem":1},{"lineBreak":true},{"text":"为全地所喜悦。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"神在其宫中，","poem":1},{"lineBreak":true},{"text":"自显为避难所。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"看哪，众王会合，","poem":1},{"lineBreak":true},{"text":"一同经过。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们见了这城就惊奇丧胆，","poem":1},{"lineBreak":true},{"text":"急忙逃跑。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们在那里被战兢疼痛抓住，","poem":1},{"lineBreak":true},{"text":"好像产难的妇人一样。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"神啊，你用东风打破他施的船只。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我们在万军之耶和华的城中","poem":1},{"lineBreak":true},{"text":"—就是我们 神的城中—所看见的，","poem":1},{"lineBreak":true},{"text":"正如我们所听见的。","poem":1},{"lineBreak":true},{"text":"神必坚立这城，直到永远。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"神啊，我们在你的殿中想念你的慈爱。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"神啊，你受的赞美正与你的名相称，直到地极！","poem":1},{"lineBreak":true},{"text":"你的右手满了公义。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因你的判断，锡安山应当欢喜，","poem":1},{"lineBreak":true},{"text":"犹大的城邑","poem":1},{"noteId":23},{"text":"应当快乐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"你们当周游锡安，","poem":1},{"lineBreak":true},{"text":"四围旋绕，数点城楼，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"细看她的外郭，","poem":1},{"lineBreak":true},{"text":"察看她的宫殿，","poem":1},{"lineBreak":true},{"text":"为要传说到后代。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因为这 神永永远远为我们的 神；","poem":1},{"lineBreak":true},{"text":"他必作我们引路的，直到死时。","poem":1}]}],"footnotes":[{"noteId":23,"caller":"-","text":"原文是女子","reference":{"chapter":48,"verse":11}}]},"thisChapterLink":"/api/cmn_cu1/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}