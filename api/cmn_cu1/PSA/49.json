{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":49,"content":[{"type":"heading","content":["恃财之愚"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"万民哪，你们都当听这话！","poem":1},{"lineBreak":true},{"text":"世上一切的居民，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"无论上流下流，富足贫穷，","poem":1},{"lineBreak":true},{"text":"都当留心听！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我口要说智慧的言语；","poem":1},{"lineBreak":true},{"text":"我心要想通达的道理。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要侧耳听比喻，","poem":1},{"lineBreak":true},{"text":"用琴解谜语。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"在患难的日子，奸恶随我脚跟，四面环绕我，","poem":1},{"lineBreak":true},{"text":"我何必惧怕？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"那些倚仗财货自夸钱财多的人，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"一个也无法赎自己的弟兄，","poem":1},{"lineBreak":true},{"text":"也不能替他将赎价给 神，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"叫他长远活着，不见朽坏；","poem":1},{"lineBreak":true},{"text":"因为赎他生命的价值极贵，","poem":1},{"lineBreak":true},{"text":"只可永远罢休。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"他必见智慧人死，","poem":1},{"lineBreak":true},{"text":"又见愚顽人和畜类人一同灭亡，","poem":1},{"lineBreak":true},{"text":"将他们的财货留给别人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们心里思想：","poem":1},{"lineBreak":true},{"text":"他们的家室必永存，","poem":1},{"lineBreak":true},{"text":"住宅必留到万代；","poem":1},{"lineBreak":true},{"text":"他们以自己的名称自己的地。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"但人居尊贵中不能长久，","poem":1},{"lineBreak":true},{"text":"如同死亡的畜类一样。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"他们行的这道本为自己的愚昧；","poem":1},{"lineBreak":true},{"text":"但他们以后的人还佩服他们的话语。 （细拉）","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们如同羊群派定下阴间；","poem":1},{"lineBreak":true},{"text":"死亡必作他们的牧者。","poem":1},{"lineBreak":true},{"text":"到了早晨，正直人必管辖他们；","poem":1},{"lineBreak":true},{"text":"他们的美容必被阴间所灭，以致无处可存。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"只是 神必救赎我的灵魂脱离阴间的权柄，","poem":1},{"lineBreak":true},{"text":"因他必收纳我。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"见人发财、家室增荣的时候，","poem":1},{"lineBreak":true},{"text":"你不要惧怕；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因为，他死的时候什么也不能带去；","poem":1},{"lineBreak":true},{"text":"他的荣耀不能随他下去。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他活着的时候，虽然自夸为有福","poem":1},{"lineBreak":true},{"text":"（你若利己，人必夸奖你）；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他仍必归到他历代的祖宗那里，","poem":1},{"lineBreak":true},{"text":"永不见光。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"人在尊贵中而不醒悟，","poem":1},{"lineBreak":true},{"text":"就如死亡的畜类一样。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":19}