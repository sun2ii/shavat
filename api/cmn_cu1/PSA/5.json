{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":5,"content":[{"type":"heading","content":["求主保护"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。用吹的乐器。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你留心听我的言语，","poem":1},{"lineBreak":true},{"text":"顾念我的心思！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的王我的 神啊，求你垂听我呼求的声音！","poem":1},{"lineBreak":true},{"text":"因为我向你祈祷。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华啊，早晨你必听我的声音；","poem":1},{"lineBreak":true},{"text":"早晨我必向你陈明我的心意，并要警醒！","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"因为你不是喜悦恶事的 神，","poem":1},{"lineBreak":true},{"text":"恶人不能与你同居。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"狂傲人不能站在你眼前；","poem":1},{"lineBreak":true},{"text":"凡作孽的，都是你所恨恶的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"说谎言的，你必灭绝；","poem":1},{"lineBreak":true},{"text":"好流人血弄诡诈的，都为耶和华所憎恶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"至于我，我必凭你丰盛的慈爱进入你的居所；","poem":1},{"lineBreak":true},{"text":"我必存敬畏你的心向你的圣殿下拜。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华啊，求你因我的仇敌，凭你的公义引领我，","poem":1},{"lineBreak":true},{"text":"使你的道路在我面前正直。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"因为，他们的口中没有诚实；","poem":1},{"lineBreak":true},{"text":"他们的心里满有邪恶；","poem":1},{"lineBreak":true},{"text":"他们的喉咙是敞开的坟墓；","poem":1},{"lineBreak":true},{"text":"他们用舌头谄媚人。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"神啊，求你定他们的罪！","poem":1},{"lineBreak":true},{"text":"愿他们因自己的计谋跌倒；","poem":1},{"lineBreak":true},{"text":"愿你在他们许多的过犯中把他们逐出，","poem":1},{"lineBreak":true},{"text":"因为他们背叛了你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"凡投靠你的，愿他们喜乐，时常欢呼，","poem":1},{"lineBreak":true},{"text":"因为你护庇他们；","poem":1},{"lineBreak":true},{"text":"又愿那爱你名的人都靠你欢欣。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因为你必赐福与义人；","poem":1},{"lineBreak":true},{"text":"耶和华啊，你必用恩惠如同盾牌四面护卫他。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}