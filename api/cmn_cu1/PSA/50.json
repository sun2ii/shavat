{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":50,"content":[{"type":"heading","content":["真实的敬拜"]},{"type":"hebrew_subtitle","content":["亚萨的诗。"]},{"type":"verse","number":1,"content":[{"text":"大能者 神—耶和华已经发言招呼天下，","poem":1},{"lineBreak":true},{"text":"从日出之地到日落之处。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"从全美的锡安中，","poem":1},{"lineBreak":true},{"text":"神已经发光了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"我们的 神要来，决不闭口。","poem":1},{"lineBreak":true},{"text":"有烈火在他面前吞灭；","poem":1},{"lineBreak":true},{"text":"有暴风在他四围大刮。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他招呼上天下地，","poem":1},{"lineBreak":true},{"text":"为要审判他的民，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"说：招聚我的圣民到我这里来，","poem":1},{"lineBreak":true},{"text":"就是那些用祭物与我立约的人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"诸天必表明他的公义，","poem":1},{"lineBreak":true},{"text":"因为 神是施行审判的。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我的民哪，你们当听我的话！","poem":1},{"lineBreak":true},{"text":"以色列啊，我要劝戒你；","poem":1},{"lineBreak":true},{"text":"我是 神，是你的 神！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我并不因你的祭物责备你；","poem":1},{"lineBreak":true},{"text":"你的燔祭常在我面前。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我不从你家中取公牛，","poem":1},{"lineBreak":true},{"text":"也不从你圈内取山羊；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因为，树林中的百兽是我的，","poem":1},{"lineBreak":true},{"text":"千山上的牲畜也是我的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"山中的飞鸟，我都知道；","poem":1},{"lineBreak":true},{"text":"野地的走兽也都属我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"我若是饥饿，我不用告诉你，","poem":1},{"lineBreak":true},{"text":"因为世界和其中所充满的都是我的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我岂吃公牛的肉呢？","poem":1},{"lineBreak":true},{"text":"我岂喝山羊的血呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你们要以感谢为祭献与 神，","poem":1},{"lineBreak":true},{"text":"又要向至高者还你的愿，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"并要在患难之日求告我；","poem":1},{"lineBreak":true},{"text":"我必搭救你，你也要荣耀我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"但 神对恶人说：你怎敢传说我的律例，","poem":1},{"lineBreak":true},{"text":"口中提到我的约呢？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"其实你恨恶管教，","poem":1},{"lineBreak":true},{"text":"将我的言语丢在背后。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你见了盗贼就乐意与他同伙，","poem":1},{"lineBreak":true},{"text":"又与行奸淫的人一同有分。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"你口任说恶言；","poem":1},{"lineBreak":true},{"text":"你舌编造诡诈。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你坐着毁谤你的兄弟，","poem":1},{"lineBreak":true},{"text":"谗毁你亲母的儿子。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你行了这些事，我还闭口不言，","poem":1},{"lineBreak":true},{"text":"你想我恰和你一样；","poem":1},{"lineBreak":true},{"text":"其实我要责备你，将这些事摆在你眼前。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"你们忘记 神的，要思想这事，","poem":1},{"lineBreak":true},{"text":"免得我把你们撕碎，无人搭救。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"凡以感谢献上为祭的便是荣耀我；","poem":1},{"lineBreak":true},{"text":"那按正路而行的，我必使他得着我的救恩。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}