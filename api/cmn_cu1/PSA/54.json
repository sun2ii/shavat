{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":54,"content":[{"type":"heading","content":["遭敌迫害求主保护"]},{"type":"hebrew_subtitle","content":["西弗人来对扫罗说：「大卫岂不是在我们那里藏身吗？」那时，大卫作这训诲诗，交与伶长。用丝弦的乐器。"]},{"type":"verse","number":1,"content":[{"text":"神啊，求你以你的名救我，","poem":1},{"lineBreak":true},{"text":"凭你的大能为我伸冤。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"神啊，求你听我的祷告，","poem":1},{"lineBreak":true},{"text":"留心听我口中的言语。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为，外人起来攻击我，","poem":1},{"lineBreak":true},{"text":"强暴人寻索我的命；","poem":1},{"lineBreak":true},{"text":"他们眼中没有 神。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"神是帮助我的，是扶持我命的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他要报应我仇敌所行的恶；","poem":1},{"lineBreak":true},{"text":"求你凭你的诚实灭绝他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我要把甘心祭献给你。","poem":1},{"lineBreak":true},{"text":"耶和华啊，我要称赞你的名；这名本为美好。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他从一切的急难中把我救出来；","poem":1},{"lineBreak":true},{"text":"我的眼睛也看见了我仇敌遭报。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}