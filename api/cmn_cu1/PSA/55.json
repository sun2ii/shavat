{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":55,"content":[{"type":"heading","content":["被友出卖者的祷告"]},{"type":"hebrew_subtitle","content":["大卫的训诲诗，交与伶长。用丝弦的乐器。"]},{"type":"verse","number":1,"content":[{"text":"神啊，求你留心听我的祷告，","poem":1},{"lineBreak":true},{"text":"不要隐藏不听我的恳求！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你侧耳听我，应允我。","poem":1},{"lineBreak":true},{"text":"我哀叹不安，发声唉哼，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"都因仇敌的声音，恶人的欺压；","poem":1},{"lineBreak":true},{"text":"因为他们将罪孽加在我身上，发怒气逼迫我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我心在我里面甚是疼痛；","poem":1},{"lineBreak":true},{"text":"死的惊惶临到我身。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"恐惧战兢归到我身；","poem":1},{"lineBreak":true},{"text":"惊恐漫过了我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我说：但愿我有翅膀像鸽子，","poem":1},{"lineBreak":true},{"text":"我就飞去，得享安息。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我必远游，","poem":1},{"lineBreak":true},{"text":"宿在旷野。 （细拉）","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我必速速逃到避所，","poem":1},{"lineBreak":true},{"text":"脱离狂风暴雨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"主啊，求你吞灭他们，变乱他们的舌头！","poem":1},{"lineBreak":true},{"text":"因为我在城中见了强暴争竞的事。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们在城墙上昼夜绕行；","poem":1},{"lineBreak":true},{"text":"在城内也有罪孽和奸恶。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"邪恶在其中；","poem":1},{"lineBreak":true},{"text":"欺压和诡诈不离街市。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"原来不是仇敌辱骂我，","poem":1},{"lineBreak":true},{"text":"若是仇敌，还可忍耐；","poem":1},{"lineBreak":true},{"text":"也不是恨我的人向我狂大，","poem":1},{"lineBreak":true},{"text":"若是恨我的人就必躲避他。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"不料是你；你原与我平等，","poem":1},{"lineBreak":true},{"text":"是我的同伴，是我知己的朋友！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我们素常彼此谈论，以为甘甜；","poem":1},{"lineBreak":true},{"text":"我们与群众在 神的殿中同行。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愿死亡忽然临到他们！","poem":1},{"lineBreak":true},{"text":"愿他们活活地下入阴间！","poem":1},{"lineBreak":true},{"text":"因为他们的住处，他们的心中，都是邪恶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"至于我，我要求告 神；","poem":1},{"lineBreak":true},{"text":"耶和华必拯救我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我要晚上、早晨、晌午哀声悲叹；","poem":1},{"lineBreak":true},{"text":"他也必听我的声音。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他救赎我命脱离攻击我的人，","poem":1},{"lineBreak":true},{"text":"使我得享平安，","poem":1},{"lineBreak":true},{"text":"因为与我相争的人甚多。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"那没有更变、不敬畏 神的人，","poem":1},{"lineBreak":true},{"text":"从太古常存的 神必听见而苦待他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"他背了约，","poem":1},{"lineBreak":true},{"text":"伸手攻击与他和好的人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他的口如奶油光滑，","poem":1},{"lineBreak":true},{"text":"他的心却怀着争战；","poem":1},{"lineBreak":true},{"text":"他的话比油柔和，","poem":1},{"lineBreak":true},{"text":"其实是拔出来的刀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"你要把你的重担卸给耶和华，","poem":1},{"lineBreak":true},{"text":"他必抚养你；","poem":1},{"lineBreak":true},{"text":"他永不叫义人动摇。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"神啊，你必使恶人下入灭亡的坑；","poem":1},{"lineBreak":true},{"text":"流人血、行诡诈的人必活不到半世，","poem":1},{"lineBreak":true},{"text":"但我要倚靠你。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}