{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":56,"content":[{"type":"heading","content":["信靠 神的祈祷"]},{"type":"hebrew_subtitle","content":["非利士人在迦特拿住大卫。那时，他作这金诗，交与伶长。调用远方无声鸽。"]},{"type":"verse","number":1,"content":[{"text":"神啊，求你怜悯我，因为人要把我吞了，","poem":1},{"lineBreak":true},{"text":"终日攻击欺压我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的仇敌终日要把我吞了，","poem":1},{"lineBreak":true},{"text":"因逞骄傲攻击我的人甚多。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我惧怕的时候要倚靠你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我倚靠 神，我要赞美他的话；","poem":1},{"lineBreak":true},{"text":"我倚靠 神，必不惧怕。","poem":1},{"lineBreak":true},{"text":"血气之辈能把我怎么样呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"他们终日颠倒我的话；","poem":1},{"lineBreak":true},{"text":"他们一切的心思都是要害我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们聚集，埋伏窥探我的脚踪，","poem":1},{"lineBreak":true},{"text":"等候要害我的命。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们岂能因罪孽逃脱吗？","poem":1},{"lineBreak":true},{"text":"神啊，求你在怒中使众民堕落！","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我几次流离，你都记数；","poem":1},{"lineBreak":true},{"text":"求你把我眼泪装在你的皮袋里。","poem":1},{"lineBreak":true},{"text":"这不都记在你册子上吗？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我呼求的日子，我的仇敌都要转身退后。","poem":1},{"lineBreak":true},{"text":"神帮助我，这是我所知道的。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我倚靠 神，我要赞美他的话；","poem":1},{"lineBreak":true},{"text":"我倚靠耶和华，我要赞美他的话。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我倚靠 神，必不惧怕。","poem":1},{"lineBreak":true},{"text":"人能把我怎么样呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"神啊，我向你所许的愿在我身上；","poem":1},{"lineBreak":true},{"text":"我要将感谢祭献给你。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因为你救我的命脱离死亡。","poem":1},{"lineBreak":true},{"text":"你岂不是救护我的脚不跌倒、","poem":1},{"lineBreak":true},{"text":"使我在生命光中行在 神面前吗？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}