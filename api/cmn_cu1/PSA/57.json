{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":57,"content":[{"type":"heading","content":["求主施援"]},{"type":"hebrew_subtitle","content":["大卫逃避扫罗，藏在洞里。那时，他作这金诗，交与伶长。调用休要毁坏。"]},{"type":"verse","number":1,"content":[{"text":"神啊，求你怜悯我，怜悯我！","poem":1},{"lineBreak":true},{"text":"因为我的心投靠你。","poem":1},{"lineBreak":true},{"text":"我要投靠在你翅膀的荫下，","poem":1},{"lineBreak":true},{"text":"等到灾害过去。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要求告至高的 神，","poem":1},{"lineBreak":true},{"text":"就是为我成全诸事的 神。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"那要吞我的人辱骂我的时候，","poem":1},{"lineBreak":true},{"text":"神从天上必施恩救我，","poem":1},{"lineBreak":true},{"text":"也必向我发出慈爱和诚实。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我的性命在狮子中间；","poem":1},{"lineBreak":true},{"text":"我躺卧在性如烈火的世人当中。","poem":1},{"lineBreak":true},{"text":"他们的牙齿是枪、箭；","poem":1},{"lineBreak":true},{"text":"他们的舌头是快刀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"神啊，愿你崇高过于诸天！","poem":1},{"lineBreak":true},{"text":"愿你的荣耀高过全地！","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"他们为我的脚设下网罗，压制我的心；","poem":1},{"lineBreak":true},{"text":"他们在我面前挖了坑，自己反掉在其中。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"神啊，我心坚定，我心坚定；","poem":1},{"lineBreak":true},{"text":"我要唱诗，我要歌颂！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的灵","poem":1},{"noteId":25},{"text":"啊，你当醒起！","poem":1},{"lineBreak":true},{"text":"琴瑟啊，你们当醒起！","poem":1},{"lineBreak":true},{"text":"我自己要极早醒起！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"主啊，我要在万民中称谢你，","poem":1},{"lineBreak":true},{"text":"在列邦中歌颂你！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因为，你的慈爱高及诸天；","poem":1},{"lineBreak":true},{"text":"你的诚实达到穹苍。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"神啊，愿你崇高过于诸天！","poem":1},{"lineBreak":true},{"text":"愿你的荣耀高过全地！","poem":1}]}],"footnotes":[{"noteId":25,"caller":"-","text":"原文是荣耀","reference":{"chapter":57,"verse":8}}]},"thisChapterLink":"/api/cmn_cu1/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}