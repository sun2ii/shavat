{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":58,"content":[{"type":"heading","content":["求 神罚恶"]},{"type":"hebrew_subtitle","content":["大卫的金诗，交与伶长。调用休要毁坏。"]},{"type":"verse","number":1,"content":[{"text":"世人哪，你们默然不语，真合公义吗？","poem":1},{"lineBreak":true},{"text":"施行审判，岂按正直吗？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"不然！你们是心中作恶；","poem":1},{"lineBreak":true},{"text":"你们在地上秤出你们手所行的强暴。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"恶人一出母胎就与 神疏远，","poem":1},{"lineBreak":true},{"text":"一离母腹便走错路，说谎话。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们的毒气好像蛇的毒气；","poem":1},{"lineBreak":true},{"text":"他们好像塞耳的聋虺，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"不听行法术的声音，","poem":1},{"lineBreak":true},{"text":"虽用极灵的咒语也是不听。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"神啊，求你敲碎他们口中的牙！","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你敲掉少壮狮子的大牙！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愿他们消灭，如急流的水一般；","poem":1},{"lineBreak":true},{"text":"他们瞅准射箭的时候，愿箭头仿佛砍断。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愿他们像蜗牛消化过去，","poem":1},{"lineBreak":true},{"text":"又像妇人坠落未见天日的胎。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你们用荆棘烧火，锅还未热，","poem":1},{"lineBreak":true},{"text":"他要用旋风把青的和烧着的一齐刮去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"义人见仇敌遭报就欢喜，","poem":1},{"lineBreak":true},{"text":"要在恶人的血中洗脚。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因此，人必说：义人诚然有善报；","poem":1},{"lineBreak":true},{"text":"在地上果有施行判断的 神！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}