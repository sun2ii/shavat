{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":6,"content":[{"type":"heading","content":["患难中求助的祈祷"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。用丝弦的乐器，调用第八。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你不要在怒中责备我，","poem":1},{"lineBreak":true},{"text":"也不要在烈怒中惩罚我！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华啊，求你可怜我，因为我软弱。","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你医治我，因为我的骨头发战。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我心也大大地惊惶。","poem":1},{"lineBreak":true},{"text":"耶和华啊，你要到几时才救我呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华啊，求你转回搭救我！","poem":1},{"lineBreak":true},{"text":"因你的慈爱拯救我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因为，在死地无人记念你，","poem":1},{"lineBreak":true},{"text":"在阴间有谁称谢你？","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我因唉哼而困乏；","poem":1},{"lineBreak":true},{"text":"我每夜流泪，把床榻漂起，","poem":1},{"lineBreak":true},{"text":"把褥子湿透。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我因忧愁眼睛干瘪，","poem":1},{"lineBreak":true},{"text":"又因我一切的敌人眼睛昏花。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你们一切作孽的人，离开我吧！","poem":1},{"lineBreak":true},{"text":"因为耶和华听了我哀哭的声音。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和华听了我的恳求；","poem":1},{"lineBreak":true},{"text":"耶和华必收纳我的祷告。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的一切仇敌都必羞愧，大大惊惶；","poem":1},{"lineBreak":true},{"text":"他们必要退后，忽然羞愧。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}