{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":60,"content":[{"type":"heading","content":["求主解救"]},{"type":"hebrew_subtitle","content":["大卫与两河间的亚兰并琐巴的亚兰争战的时候，约押转回，在盐谷攻击以东，杀了一万二千人。那时，大卫作这金诗叫人学习，交与伶长。调用为证的百合花。"]},{"type":"verse","number":1,"content":[{"text":"神啊，你丢弃了我们，使我们破败；","poem":1},{"lineBreak":true},{"text":"你向我们发怒，求你使我们复兴！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你使地震动，而且崩裂；","poem":1},{"lineBreak":true},{"text":"求你将裂口医好，因为地摇动。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你叫你的民遇见艰难；","poem":1},{"lineBreak":true},{"text":"你叫我们喝那使人东倒西歪的酒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"你把旌旗赐给敬畏你的人，","poem":1},{"lineBreak":true},{"text":"可以为真理扬起来。 （细拉）","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"求你应允我们，用右手拯救我们，","poem":1},{"lineBreak":true},{"text":"好叫你所亲爱的人得救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"神已经指着他的圣洁说","poem":1},{"noteId":26},{"text":"：我要欢乐；","poem":1},{"lineBreak":true},{"text":"我要分开示剑，丈量疏割谷。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"基列是我的，玛拿西也是我的。","poem":1},{"lineBreak":true},{"text":"以法莲是护卫我头的；","poem":1},{"lineBreak":true},{"text":"犹大是我的杖。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"摩押是我的沐浴盆；","poem":1},{"lineBreak":true},{"text":"我要向以东抛鞋。","poem":1},{"lineBreak":true},{"text":"非利士啊，你还能因我欢呼吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"谁能领我进坚固城？","poem":1},{"lineBreak":true},{"text":"谁能引我到以东地？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"神啊，你不是丢弃了我们吗？","poem":1},{"lineBreak":true},{"text":"神啊，你不和我们的军兵同去吗？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你帮助我们攻击敌人，","poem":1},{"lineBreak":true},{"text":"因为人的帮助是枉然的。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我们倚靠 神才得施展大能，","poem":1},{"lineBreak":true},{"text":"因为践踏我们敌人的就是他。","poem":1}]}],"footnotes":[{"noteId":26,"caller":"-","text":"说：或译应许我","reference":{"chapter":60,"verse":6}}]},"thisChapterLink":"/api/cmn_cu1/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}