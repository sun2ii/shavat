{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":61,"content":[{"type":"heading","content":["求主保佑"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。用丝弦的乐器。"]},{"type":"verse","number":1,"content":[{"text":"神啊，求你听我的呼求，","poem":1},{"lineBreak":true},{"text":"侧耳听我的祷告！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我心里发昏的时候，","poem":1},{"lineBreak":true},{"text":"我要从地极求告你。","poem":1},{"lineBreak":true},{"text":"求你领我到那比我更高的磐石！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为你作过我的避难所，","poem":1},{"lineBreak":true},{"text":"作过我的坚固台，脱离仇敌。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要永远住在你的帐幕里！","poem":1},{"lineBreak":true},{"text":"我要投靠在你翅膀下的隐密处！ （细拉）","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"神啊，你原是听了我所许的愿；","poem":1},{"lineBreak":true},{"text":"你将产业赐给敬畏你名的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"你要加添王的寿数；","poem":1},{"lineBreak":true},{"text":"他的年岁必存到世世。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他必永远坐在 神面前；","poem":1},{"lineBreak":true},{"text":"愿你预备慈爱和诚实保佑他！","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"这样，我要歌颂你的名，直到永远，","poem":1},{"lineBreak":true},{"text":"好天天还我所许的愿。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}