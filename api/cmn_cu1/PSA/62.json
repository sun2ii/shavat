{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":62,"content":[{"type":"heading","content":["在 神保佑中安稳自在"]},{"type":"hebrew_subtitle","content":["大卫的诗，照耶杜顿的作法，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"我的心默默无声，专等候 神；","poem":1},{"lineBreak":true},{"text":"我的救恩是从他而来。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"惟独他是我的磐石，我的拯救；","poem":1},{"lineBreak":true},{"text":"他是我的高台，我必不很动摇。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你们大家攻击一人，把他毁坏，","poem":1},{"lineBreak":true},{"text":"如同毁坏歪斜的墙、将倒的壁，要到几时呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们彼此商议，专要从他的尊位上把他推下；","poem":1},{"lineBreak":true},{"text":"他们喜爱谎话，口虽祝福，心却咒诅。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我的心哪，你当默默无声，专等候 神，","poem":1},{"lineBreak":true},{"text":"因为我的盼望是从他而来。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"惟独他是我的磐石，我的拯救；","poem":1},{"lineBreak":true},{"text":"他是我的高台，我必不动摇。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的拯救、我的荣耀都在乎 神；","poem":1},{"lineBreak":true},{"text":"我力量的磐石、我的避难所都在乎 神。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你们众民当时时倚靠他，","poem":1},{"lineBreak":true},{"text":"在他面前倾心吐意；","poem":1},{"lineBreak":true},{"text":"神是我们的避难所。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"下流人真是虚空；","poem":1},{"lineBreak":true},{"text":"上流人也是虚假；","poem":1},{"lineBreak":true},{"text":"放在天平里就必浮起；","poem":1},{"lineBreak":true},{"text":"他们一共比空气还轻。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"不要仗势欺人，","poem":1},{"lineBreak":true},{"text":"也不要因抢夺而骄傲；","poem":1},{"lineBreak":true},{"text":"若财宝加增，不要放在心上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"神说了一次、两次，我都听见：","poem":1},{"lineBreak":true},{"text":"就是能力都属乎 神。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"主啊，慈爱也是属乎你，","poem":1},{"lineBreak":true},{"text":"因为你照着各人所行的报应他。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}