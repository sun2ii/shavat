{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":63,"content":[{"type":"heading","content":["渴慕 神"]},{"type":"hebrew_subtitle","content":["大卫在犹大旷野的时候，作了这诗。"]},{"type":"verse","number":1,"content":[{"text":"神啊，你是我的 神，","poem":1},{"lineBreak":true},{"text":"我要切切地寻求你，","poem":1},{"lineBreak":true},{"text":"在干旱疲乏无水之地，我渴想你；","poem":1},{"lineBreak":true},{"text":"我的心切慕你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在圣所中曾如此瞻仰你，","poem":1},{"lineBreak":true},{"text":"为要见你的能力和你的荣耀。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因你的慈爱比生命更好，","poem":1},{"lineBreak":true},{"text":"我的嘴唇要颂赞你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我还活的时候要这样称颂你；","poem":1},{"lineBreak":true},{"text":"我要奉你的名举手。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我在床上记念你，","poem":1},{"lineBreak":true},{"text":"在夜更的时候思想你；","poem":1},{"lineBreak":true},{"text":"我的心就像饱足了骨髓肥油，","poem":1},{"lineBreak":true},{"text":"我也要以欢乐的嘴唇赞美你。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因为你曾帮助我，","poem":1},{"lineBreak":true},{"text":"我就在你翅膀的荫下欢呼。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我心紧紧地跟随你；","poem":1},{"lineBreak":true},{"text":"你的右手扶持我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"但那些寻索要灭我命的人","poem":1},{"lineBreak":true},{"text":"必往地底下去；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们必被刀剑所杀，","poem":1},{"lineBreak":true},{"text":"被野狗所吃。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"但是王必因 神欢喜。","poem":1},{"lineBreak":true},{"text":"凡指着他发誓的必要夸口，","poem":1},{"lineBreak":true},{"text":"因为说谎之人的口必被塞住。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":10}