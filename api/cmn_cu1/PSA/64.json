{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":64,"content":[{"type":"heading","content":["求主保护"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"神啊，我哀叹的时候，求你听我的声音！","poem":1},{"lineBreak":true},{"text":"求你保护我的性命，不受仇敌的惊恐！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你把我隐藏，","poem":1},{"lineBreak":true},{"text":"使我脱离作恶之人的暗谋和作孽之人的扰乱。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们磨舌如刀，","poem":1},{"lineBreak":true},{"text":"发出苦毒的言语，好像比准了的箭，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"要在暗地射完全人；","poem":1},{"lineBreak":true},{"text":"他们忽然射他，并不惧怕。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们彼此勉励设下恶计；","poem":1},{"lineBreak":true},{"text":"他们商量暗设网罗，","poem":1},{"lineBreak":true},{"text":"说：谁能看见？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们图谋奸恶，","poem":1},{"lineBreak":true},{"text":"说：我们是极力图谋的。","poem":1},{"lineBreak":true},{"text":"他们各人的意念心思是深的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"但 神要射他们；","poem":1},{"lineBreak":true},{"text":"他们忽然被箭射伤。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们必然绊跌，被自己的舌头所害；","poem":1},{"lineBreak":true},{"text":"凡看见他们的必都摇头。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"众人都要害怕，","poem":1},{"lineBreak":true},{"text":"要传扬 神的工作，","poem":1},{"lineBreak":true},{"text":"并且明白他的作为。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"义人必因耶和华欢喜，并要投靠他；","poem":1},{"lineBreak":true},{"text":"凡心里正直的人都要夸口。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}