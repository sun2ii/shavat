{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":65,"content":[{"type":"heading","content":["颂赞主恩"]},{"type":"hebrew_subtitle","content":["大卫的诗歌，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"神啊，锡安的人都等候赞美你；","poem":1},{"lineBreak":true},{"text":"所许的愿也要向你偿还。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"听祷告的主啊，","poem":1},{"lineBreak":true},{"text":"凡有血气的都要来就你。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"罪孽胜了我；","poem":1},{"lineBreak":true},{"text":"至于我们的过犯，你都要赦免。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你所拣选、使他亲近你、住在你院中的，","poem":1},{"lineBreak":true},{"text":"这人便为有福！","poem":1},{"lineBreak":true},{"text":"我们必因你居所、你圣殿的美福知足了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"拯救我们的 神啊，你必以威严秉公义应允我们；","poem":1},{"lineBreak":true},{"text":"你本是一切地极和海上远处的人所倚靠的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他既以大能束腰，","poem":1},{"lineBreak":true},{"text":"就用力量安定诸山，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"使诸海的响声和其中波浪的响声，","poem":1},{"lineBreak":true},{"text":"并万民的喧哗，都平静了。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"住在地极的人因你的神迹惧怕；","poem":1},{"lineBreak":true},{"text":"你使日出日落之地都欢呼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"你眷顾地，降下透雨，","poem":1},{"lineBreak":true},{"text":"使地大得肥美。","poem":1},{"lineBreak":true},{"text":"神的河满了水；","poem":1},{"lineBreak":true},{"text":"你这样浇灌了地，","poem":1},{"lineBreak":true},{"text":"好为人预备五谷。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你浇透地的犁沟，润平犁脊，","poem":1},{"lineBreak":true},{"text":"降甘霖，使地软和；","poem":1},{"lineBreak":true},{"text":"其中发长的，蒙你赐福。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你以恩典为年岁的冠冕；","poem":1},{"lineBreak":true},{"text":"你的路径都滴下脂油，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"滴在旷野的草场上。","poem":1},{"lineBreak":true},{"text":"小山以欢乐束腰；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"草场以羊群为衣；","poem":1},{"lineBreak":true},{"text":"谷中也长满了五谷。","poem":1},{"lineBreak":true},{"text":"这一切都欢呼歌唱。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}