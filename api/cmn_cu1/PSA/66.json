{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":66,"content":[{"type":"heading","content":["颂赞感恩的诗"]},{"type":"hebrew_subtitle","content":["一篇诗歌，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"全地都当向 神欢呼！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"歌颂他名的荣耀！","poem":1},{"lineBreak":true},{"text":"用赞美的言语将他的荣耀发明！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"当对 神说：你的作为何等可畏！","poem":1},{"lineBreak":true},{"text":"因你的大能，仇敌要投降你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"全地要敬拜你，歌颂你，","poem":1},{"lineBreak":true},{"text":"要歌颂你的名。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你们来看 神所行的，","poem":1},{"lineBreak":true},{"text":"他向世人所做之事是可畏的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他将海变成干地，众民步行过河；","poem":1},{"lineBreak":true},{"text":"我们在那里因他欢喜。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他用权能治理万民，直到永远。","poem":1},{"lineBreak":true},{"text":"他的眼睛鉴察列邦；","poem":1},{"lineBreak":true},{"text":"悖逆的人不可自高。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"万民哪，你们当称颂我们的 神，","poem":1},{"lineBreak":true},{"text":"使人得听赞美他的声音。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他使我们的性命存活，","poem":1},{"lineBreak":true},{"text":"也不叫我们的脚摇动。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"神啊，你曾试验我们，","poem":1},{"lineBreak":true},{"text":"熬炼我们，如熬炼银子一样。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你使我们进入网罗，","poem":1},{"lineBreak":true},{"text":"把重担放在我们的身上。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你使人坐车轧我们的头；","poem":1},{"lineBreak":true},{"text":"我们经过水火，","poem":1},{"lineBreak":true},{"text":"你却使我们到丰富之地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我要用燔祭进你的殿，","poem":1},{"lineBreak":true},{"text":"向你还我的愿，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"就是在急难时我嘴唇所发的、","poem":1},{"lineBreak":true},{"text":"口中所许的。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要把肥牛作燔祭，","poem":1},{"lineBreak":true},{"text":"将公羊的香祭献给你，","poem":1},{"lineBreak":true},{"text":"又把公牛和山羊献上。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"凡敬畏 神的人，你们都来听！","poem":1},{"lineBreak":true},{"text":"我要述说他为我所行的事。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我曾用口求告他；","poem":1},{"lineBreak":true},{"text":"我的舌头也称他为高。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我若心里注重罪孽，","poem":1},{"lineBreak":true},{"text":"主必不听。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"但 神实在听见了；","poem":1},{"lineBreak":true},{"text":"他侧耳听了我祷告的声音。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"神是应当称颂的！","poem":1},{"lineBreak":true},{"text":"他并没有推却我的祷告，","poem":1},{"lineBreak":true},{"text":"也没有叫他的慈爱离开我。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}