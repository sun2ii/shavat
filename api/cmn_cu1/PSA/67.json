{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":67,"content":[{"type":"heading","content":["感恩的诗"]},{"type":"hebrew_subtitle","content":["一篇诗歌，交与伶长。用丝弦的乐器。"]},{"type":"verse","number":1,"content":[{"text":"愿 神怜悯我们，赐福与我们，","poem":1},{"lineBreak":true},{"text":"用脸光照我们， （细拉）","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"好叫世界得知你的道路，","poem":1},{"lineBreak":true},{"text":"万国得知你的救恩。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"神啊，愿列邦称赞你！","poem":1},{"lineBreak":true},{"text":"愿万民都称赞你！","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"愿万国都快乐欢呼；","poem":1},{"lineBreak":true},{"text":"因为你必按公正审判万民，","poem":1},{"lineBreak":true},{"text":"引导世上的万国。 （细拉）","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"神啊，愿列邦称赞你！","poem":1},{"lineBreak":true},{"text":"愿万民都称赞你！","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"地已经出了土产；","poem":1},{"lineBreak":true},{"text":"神—就是我们的 神要赐福与我们。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"神要赐福与我们；","poem":1},{"lineBreak":true},{"text":"地的四极都要敬畏他！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}