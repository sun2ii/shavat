{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":68,"content":[{"type":"heading","content":["胜利之歌"]},{"type":"hebrew_subtitle","content":["大卫的诗歌，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"愿 神兴起，使他的仇敌四散，","poem":1},{"lineBreak":true},{"text":"叫那恨他的人从他面前逃跑。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他们被驱逐，如烟被风吹散；","poem":1},{"lineBreak":true},{"text":"恶人见 神之面而消灭，如蜡被火熔化。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"惟有义人必然欢喜，","poem":1},{"lineBreak":true},{"text":"在 神面前高兴快乐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"你们当向 神唱诗，歌颂他的名；","poem":1},{"lineBreak":true},{"text":"为那坐车行过旷野的修平大路。","poem":1},{"lineBreak":true},{"text":"他的名是耶和华，","poem":1},{"lineBreak":true},{"text":"要在他面前欢乐！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"神在他的圣所作孤儿的父，","poem":1},{"lineBreak":true},{"text":"作寡妇的伸冤者。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"神叫孤独的有家，","poem":1},{"lineBreak":true},{"text":"使被囚的出来享福；","poem":1},{"lineBreak":true},{"text":"惟有悖逆的住在干燥之地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"神啊，你曾在你百姓前头出来，","poem":1},{"lineBreak":true},{"text":"在旷野行走。 （细拉）","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"那时，地见 神的面而震动，天也落雨；","poem":1},{"lineBreak":true},{"text":"西奈山见以色列 神的面也震动。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"神啊，你降下大雨；","poem":1},{"lineBreak":true},{"text":"你产业以色列疲乏的时候，你使他坚固。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你的会众住在其中；","poem":1},{"lineBreak":true},{"text":"神啊，你的恩惠是为困苦人预备的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"主发命令，","poem":1},{"lineBreak":true},{"text":"传好信息的妇女成了大群。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"统兵的君王逃跑了，逃跑了；","poem":1},{"lineBreak":true},{"text":"在家等候的妇女分受所夺的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你们安卧在羊圈的时候，","poem":1},{"lineBreak":true},{"text":"好像鸽子的翅膀镀白银，翎毛镀黄金一般。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"全能者在境内赶散列王的时候，","poem":1},{"lineBreak":true},{"text":"势如飘雪在撒们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"巴珊山是 神的山；","poem":1},{"lineBreak":true},{"text":"巴珊山是多峰多岭的山。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你们多峰多岭的山哪，","poem":1},{"lineBreak":true},{"text":"为何斜看 神所愿居住的山？","poem":1},{"lineBreak":true},{"text":"耶和华必住这山，直到永远！","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"神的车辇累万盈千；","poem":1},{"lineBreak":true},{"text":"主在其中，好像在西奈圣山一样。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你已经升上高天，掳掠仇敌；","poem":1},{"lineBreak":true},{"text":"你在人间，就是在悖逆的人间，受了供献，","poem":1},{"lineBreak":true},{"text":"叫耶和华 神可以与他们同住。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"天天背负我们重担的主，","poem":1},{"lineBreak":true},{"text":"就是拯救我们的 神，","poem":1},{"lineBreak":true},{"text":"是应当称颂的！ （细拉）","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"神是为我们施行诸般救恩的 神；","poem":1},{"lineBreak":true},{"text":"人能脱离死亡是在乎主耶和华。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"但 神要打破他仇敌的头，","poem":1},{"lineBreak":true},{"text":"就是那常犯罪之人的发顶。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"主说：我要使众民从巴珊而归，","poem":1},{"lineBreak":true},{"text":"使他们从深海而回，","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"使你打碎仇敌，你的脚踹在血中，","poem":1},{"lineBreak":true},{"text":"使你狗的舌头从其中得分。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"神啊，你是我的 神，我的王；","poem":1},{"lineBreak":true},{"text":"人已经看见你行走，进入圣所。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"歌唱的行在前，作乐的随在后，","poem":1},{"lineBreak":true},{"text":"都在击鼓的童女中间。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"从以色列源头而来的，","poem":1},{"lineBreak":true},{"text":"当在各会中称颂主 神！","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"在那里，有统管他们的小便雅悯，","poem":1},{"lineBreak":true},{"text":"有犹大的首领和他们的群众，","poem":1},{"lineBreak":true},{"text":"有西布伦的首领，","poem":1},{"lineBreak":true},{"text":"有拿弗他利的首领。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"以色列的能力是 神所赐的；","poem":1},{"lineBreak":true},{"text":"神啊，求你坚固你为我们所成全的事！","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"因你耶路撒冷的殿，","poem":1},{"lineBreak":true},{"text":"列王必带贡物献给你。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"求你叱喝芦苇中的野兽和群公牛，","poem":1},{"lineBreak":true},{"text":"并列邦中的牛犊。","poem":1},{"lineBreak":true},{"text":"把银块踹在脚下；","poem":1},{"lineBreak":true},{"text":"神已经赶散好争战的列邦。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"埃及的公侯要出来朝见 神；","poem":1},{"lineBreak":true},{"text":"古实人要急忙举手祷告。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"世上的列国啊，你们要向 神歌唱；","poem":1},{"lineBreak":true},{"text":"愿你们歌颂主！","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"歌颂那自古驾行在诸天以上的主！","poem":1},{"lineBreak":true},{"text":"他发出声音，是极大的声音。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你们要将能力归给 神。","poem":1},{"lineBreak":true},{"text":"他的威荣在以色列之上；","poem":1},{"lineBreak":true},{"text":"他的能力是在穹苍。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"神啊，你从圣所显为可畏；","poem":1},{"lineBreak":true},{"text":"以色列的 神是那将力量权能赐给他百姓的。","poem":1},{"lineBreak":true},{"text":"神是应当称颂的！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}