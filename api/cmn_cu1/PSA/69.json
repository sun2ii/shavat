{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":69,"content":[{"type":"heading","content":["求助的祷告"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。调用百合花。"]},{"type":"verse","number":1,"content":[{"text":"神啊，求你救我！","poem":1},{"lineBreak":true},{"text":"因为众水要淹没我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我陷在深淤泥中，没有立脚之地；","poem":1},{"lineBreak":true},{"text":"我到了深水中，大水漫过我身。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我因呼求困乏，喉咙发干；","poem":1},{"lineBreak":true},{"text":"我因等候 神，眼睛失明。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"无故恨我的，比我头发还多；","poem":1},{"lineBreak":true},{"text":"无理与我为仇、要把我剪除的，甚为强盛。","poem":1},{"lineBreak":true},{"text":"我没有抢夺的，要叫我偿还。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"神啊，我的愚昧，你原知道；","poem":1},{"lineBreak":true},{"text":"我的罪愆不能隐瞒。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"万军的主—耶和华啊，","poem":1},{"lineBreak":true},{"text":"求你叫那等候你的，不要因我蒙羞！","poem":1},{"lineBreak":true},{"text":"以色列的 神啊，","poem":1},{"lineBreak":true},{"text":"求你叫那寻求你的，不要因我受辱！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因我为你的缘故受了辱骂，","poem":1},{"lineBreak":true},{"text":"满面羞愧。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的弟兄看我为外路人；","poem":1},{"lineBreak":true},{"text":"我的同胞看我为外邦人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"因我为你的殿心里焦急，如同火烧，","poem":1},{"lineBreak":true},{"text":"并且辱骂你人的辱骂都落在我身上。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我哭泣，以禁食刻苦我心；","poem":1},{"lineBreak":true},{"text":"这倒算为我的羞辱。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我拿麻布当衣裳，","poem":1},{"lineBreak":true},{"text":"就成了他们的笑谈。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"坐在城门口的谈论我；","poem":1},{"lineBreak":true},{"text":"酒徒也以我为歌曲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"但我在悦纳的时候向你—耶和华祈祷。","poem":1},{"lineBreak":true},{"text":"神啊，求你按你丰盛的慈爱，","poem":1},{"lineBreak":true},{"text":"凭你拯救的诚实应允我！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"求你搭救我出离淤泥，","poem":1},{"lineBreak":true},{"text":"不叫我陷在其中；","poem":1},{"lineBreak":true},{"text":"求你使我脱离那些恨我的人，","poem":1},{"lineBreak":true},{"text":"使我出离深水。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"求你不容大水漫过我，","poem":1},{"lineBreak":true},{"text":"不容深渊吞灭我，","poem":1},{"lineBreak":true},{"text":"不容坑坎在我以上合口。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和华啊，求你应允我！","poem":1},{"lineBreak":true},{"text":"因为你的慈爱本为美好；","poem":1},{"lineBreak":true},{"text":"求你按你丰盛的慈悲回转眷顾我！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"不要掩面不顾你的仆人；","poem":1},{"lineBreak":true},{"text":"我是在急难之中，求你速速地应允我！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你亲近我，救赎我！","poem":1},{"lineBreak":true},{"text":"求你因我的仇敌把我赎回！","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"你知道我受的辱骂、欺凌、羞辱；","poem":1},{"lineBreak":true},{"text":"我的敌人都在你面前。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"辱骂伤破了我的心，","poem":1},{"lineBreak":true},{"text":"我又满了忧愁。","poem":1},{"lineBreak":true},{"text":"我指望有人体恤，却没有一个；","poem":1},{"lineBreak":true},{"text":"我指望有人安慰，却找不着一个。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们拿苦胆给我当食物；","poem":1},{"lineBreak":true},{"text":"我渴了，他们拿醋给我喝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"愿他们的筵席在他们面前变为网罗，","poem":1},{"lineBreak":true},{"text":"在他们平安的时候变为机槛。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"愿他们的眼睛昏蒙，不得看见；","poem":1},{"lineBreak":true},{"text":"愿你使他们的腰常常战抖。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"求你将你的恼恨倒在他们身上，","poem":1},{"lineBreak":true},{"text":"叫你的烈怒追上他们。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"愿他们的住处变为荒场；","poem":1},{"lineBreak":true},{"text":"愿他们的帐棚无人居住。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因为，你所击打的，他们就逼迫；","poem":1},{"lineBreak":true},{"text":"你所击伤的，他们戏说他的愁苦。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"愿你在他们的罪上加罪，","poem":1},{"lineBreak":true},{"text":"不容他们在你面前称义。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"愿他们从生命册上被涂抹，","poem":1},{"lineBreak":true},{"text":"不得记录在义人之中。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"但我是困苦忧伤的；","poem":1},{"lineBreak":true},{"text":"神啊，愿你的救恩将我安置在高处。","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"我要以诗歌赞美 神的名，","poem":1},{"lineBreak":true},{"text":"以感谢称他为大！","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"这便叫耶和华喜悦，胜似献牛，","poem":1},{"lineBreak":true},{"text":"或是献有角有蹄的公牛。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"谦卑的人看见了就喜乐；","poem":1},{"lineBreak":true},{"text":"寻求 神的人，愿你们的心苏醒。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"因为耶和华听了穷乏人，","poem":1},{"lineBreak":true},{"text":"不藐视被囚的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"愿天和地、","poem":1},{"lineBreak":true},{"text":"洋海和其中一切的动物都赞美他！","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"因为 神要拯救锡安，建造犹大的城邑；","poem":1},{"lineBreak":true},{"text":"他的民要在那里居住，得以为业。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他仆人的后裔要承受为业；","poem":1},{"lineBreak":true},{"text":"爱他名的人也要住在其中。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}