{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":7,"content":[{"type":"heading","content":["为公义而祈祷"]},{"type":"hebrew_subtitle","content":["大卫指着便雅悯人古实的话，向耶和华唱的流离歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和华—我的 神啊，我投靠你！","poem":1},{"lineBreak":true},{"text":"求你救我脱离一切追赶我的人，将我救拔出来！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"恐怕他们像狮子撕裂我，","poem":1},{"lineBreak":true},{"text":"甚至撕碎，无人搭救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和华—我的 神啊，我若行了这事，","poem":1},{"lineBreak":true},{"text":"若有罪孽在我手里，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我若以恶报那与我交好的人—","poem":1},{"lineBreak":true},{"text":"连那无故与我为敌的，我也救了他，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"就任凭仇敌追赶我，直到追上，","poem":1},{"lineBreak":true},{"text":"将我的性命踏在地下，","poem":1},{"lineBreak":true},{"text":"使我的荣耀归于灰尘。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和华啊，求你在怒中起来，","poem":1},{"lineBreak":true},{"text":"挺身而立，抵挡我敌人的暴怒！","poem":1},{"lineBreak":true},{"text":"求你为我兴起！你已经命定施行审判！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愿众民的会环绕你！","poem":1},{"lineBreak":true},{"text":"愿你从其上归于高位！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华向众民施行审判；","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你按我的公义和我心中的纯正判断我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"愿恶人的恶断绝！","poem":1},{"lineBreak":true},{"text":"愿你坚立义人！","poem":1},{"lineBreak":true},{"text":"因为公义的 神察验人的心肠肺腑。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"神是我的盾牌；","poem":1},{"lineBreak":true},{"text":"他拯救心里正直的人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"神是公义的审判者，","poem":1},{"lineBreak":true},{"text":"又是天天向恶人发怒的 神。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"若有人不回头，他的刀必磨快，","poem":1},{"lineBreak":true},{"text":"弓必上弦，预备妥当了。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他也预备了杀人的器械；","poem":1},{"lineBreak":true},{"text":"他所射的是火箭。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"试看恶人因奸恶而劬劳，","poem":1},{"lineBreak":true},{"text":"所怀的是毒害，所生的是虚假。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他掘了坑，又挖深了，","poem":1},{"lineBreak":true},{"text":"竟掉在自己所挖的阱里。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他的毒害必临到他自己的头上；","poem":1},{"lineBreak":true},{"text":"他的强暴必落到他自己的脑袋上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"我要照着耶和华的公义称谢他，","poem":1},{"lineBreak":true},{"text":"歌颂耶和华至高者的名。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}