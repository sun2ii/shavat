{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":70,"content":[{"type":"heading","content":["求助的祈祷"]},{"type":"hebrew_subtitle","content":["大卫的纪念诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"神啊，求你快快搭救我！","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你速速帮助我！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿那些寻索我命的，抱愧蒙羞；","poem":1},{"lineBreak":true},{"text":"愿那些喜悦我遭害的，退后受辱。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愿那些对我说阿哈、阿哈的，","poem":1},{"lineBreak":true},{"text":"因羞愧退后。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"愿一切寻求你的，因你高兴欢喜；","poem":1},{"lineBreak":true},{"text":"愿那些喜爱你救恩的，常说：当尊 神为大！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但我是困苦穷乏的；","poem":1},{"lineBreak":true},{"text":"神啊，求你速速到我这里来！","poem":1},{"lineBreak":true},{"text":"你是帮助我的，搭救我的。","poem":1},{"lineBreak":true},{"text":"耶和华啊，求你不要耽延！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}