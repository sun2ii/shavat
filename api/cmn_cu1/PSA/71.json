{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":71,"content":[{"type":"heading","content":["老年人的祈祷"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，我投靠你；","poem":1},{"lineBreak":true},{"text":"求你叫我永不羞愧！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你凭你的公义搭救我，救拔我；","poem":1},{"lineBreak":true},{"text":"侧耳听我，拯救我！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"求你作我常住的磐石；","poem":1},{"lineBreak":true},{"text":"你已经命定要救我，","poem":1},{"lineBreak":true},{"text":"因为你是我的岩石，我的山寨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我的 神啊，求你救我脱离恶人的手，","poem":1},{"lineBreak":true},{"text":"脱离不义和残暴之人的手。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"主—耶和华啊，你是我所盼望的；","poem":1},{"lineBreak":true},{"text":"从我年幼，你是我所倚靠的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我从出母胎被你扶持；","poem":1},{"lineBreak":true},{"text":"使我出母腹的是你。","poem":1},{"lineBreak":true},{"text":"我必常常赞美你！","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"许多人以我为怪，","poem":1},{"lineBreak":true},{"text":"但你是我坚固的避难所。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你的赞美，你的荣耀","poem":1},{"lineBreak":true},{"text":"终日必满了我的口。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我年老的时候，求你不要丢弃我！","poem":1},{"lineBreak":true},{"text":"我力气衰弱的时候，求你不要离弃我！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的仇敌议论我；","poem":1},{"lineBreak":true},{"text":"那些窥探要害我命的彼此商议，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"说： 神已经离弃他；","poem":1},{"lineBreak":true},{"text":"我们追赶他，捉拿他吧！","poem":1},{"lineBreak":true},{"text":"因为没有人搭救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"神啊，求你不要远离我！","poem":1},{"lineBreak":true},{"text":"我的 神啊，求你速速帮助我！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"愿那与我性命为敌的，羞愧被灭；","poem":1},{"lineBreak":true},{"text":"愿那谋害我的，受辱蒙羞。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我却要常常盼望，","poem":1},{"lineBreak":true},{"text":"并要越发赞美你。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的口终日要述说你的公义和你的救恩，","poem":1},{"lineBreak":true},{"text":"因我不计其数。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要来说主—耶和华大能的事；","poem":1},{"lineBreak":true},{"text":"我单要提说你的公义。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"神啊，自我年幼时，你就教训我；","poem":1},{"lineBreak":true},{"text":"直到如今，我传扬你奇妙的作为。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"神啊，我到年老发白的时候，","poem":1},{"lineBreak":true},{"text":"求你不要离弃我！","poem":1},{"lineBreak":true},{"text":"等我将你的能力指示下代，","poem":1},{"lineBreak":true},{"text":"将你的大能指示后世的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"神啊，你的公义甚高；","poem":1},{"lineBreak":true},{"text":"行过大事的 神啊，谁能像你！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你是叫我们多经历重大急难的，","poem":1},{"lineBreak":true},{"text":"必使我们复活，","poem":1},{"lineBreak":true},{"text":"从地的深处救上来。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"求你使我越发昌大，","poem":1},{"lineBreak":true},{"text":"又转来安慰我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"我的 神啊，我要鼓瑟称赞你，","poem":1},{"lineBreak":true},{"text":"称赞你的诚实！","poem":1},{"lineBreak":true},{"text":"以色列的圣者啊，我要弹琴歌颂你！","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我歌颂你的时候，","poem":1},{"lineBreak":true},{"text":"我的嘴唇和你所赎我的灵魂都必欢呼；","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"并且我的舌头必终日讲论你的公义，","poem":1},{"lineBreak":true},{"text":"因为那些谋害我的人已经蒙羞受辱了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}