{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":72,"content":[{"type":"heading","content":["为王祈祷"]},{"type":"hebrew_subtitle","content":["所罗门的诗。"]},{"type":"verse","number":1,"content":[{"text":"神啊，求你将判断的权柄赐给王，","poem":1},{"lineBreak":true},{"text":"将公义赐给王的儿子。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他要按公义审判你的民，","poem":1},{"lineBreak":true},{"text":"按公平审判你的困苦人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"大山小山都要因公义使民得享平安。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他必为民中的困苦人伸冤，","poem":1},{"lineBreak":true},{"text":"拯救穷乏之辈，","poem":1},{"lineBreak":true},{"text":"压碎那欺压人的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"太阳还存，月亮还在，","poem":1},{"lineBreak":true},{"text":"人要敬畏你，直到万代！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他必降临，像雨降在已割的草地上，","poem":1},{"lineBreak":true},{"text":"如甘霖滋润田地。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"在他的日子，义人要发旺，","poem":1},{"lineBreak":true},{"text":"大有平安，好像月亮长存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"他要执掌权柄，从这海直到那海，","poem":1},{"lineBreak":true},{"text":"从大河直到地极。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"住在旷野的，必在他面前下拜；","poem":1},{"lineBreak":true},{"text":"他的仇敌必要舔土。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他施和海岛的王要进贡；","poem":1},{"lineBreak":true},{"text":"示巴和西巴的王要献礼物。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"诸王都要叩拜他；","poem":1},{"lineBreak":true},{"text":"万国都要事奉他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"因为，穷乏人呼求的时候，他要搭救；","poem":1},{"lineBreak":true},{"text":"没有人帮助的困苦人，他也要搭救。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他要怜恤贫寒和穷乏的人，","poem":1},{"lineBreak":true},{"text":"拯救穷苦人的性命。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他要救赎他们脱离欺压和强暴；","poem":1},{"lineBreak":true},{"text":"他们的血在他眼中看为宝贵。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"他们要存活。","poem":1},{"lineBreak":true},{"text":"示巴的金子要奉给他；","poem":1},{"lineBreak":true},{"text":"人要常常为他祷告，终日称颂他。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"在地的山顶上，五谷必然茂盛","poem":1},{"noteId":27},{"text":"；","poem":1},{"lineBreak":true},{"text":"所结的谷实要响动，如黎巴嫩的树林；","poem":1},{"lineBreak":true},{"text":"城里的人要发旺，如地上的草。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他的名要存到永远，","poem":1},{"lineBreak":true},{"text":"要留传如日之久。","poem":1},{"lineBreak":true},{"text":"人要因他蒙福；","poem":1},{"lineBreak":true},{"text":"万国要称他有福。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"独行奇事的耶和华—以色列的 神","poem":1},{"lineBreak":true},{"text":"是应当称颂的！","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他荣耀的名也当称颂，直到永远。","poem":1},{"lineBreak":true},{"text":"愿他的荣耀充满全地！","poem":1},{"lineBreak":true},{"text":"阿们！阿们！","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"耶西的儿子—大卫的祈祷完毕。","poem":1}]}],"footnotes":[{"noteId":27,"caller":"-","text":"或译：有一把五谷","reference":{"chapter":72,"verse":16}}]},"thisChapterLink":"/api/cmn_cu1/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}