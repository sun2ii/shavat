{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":73,"content":[{"type":"heading","content":["神的公正"]},{"type":"hebrew_subtitle","content":["亚萨的诗。"]},{"type":"verse","number":1,"content":[{"text":"神实在恩待以色列那些清心的人！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"至于我，我的脚几乎失闪；","poem":1},{"lineBreak":true},{"text":"我的脚险些滑跌。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我见恶人和狂傲人享平安就心怀不平。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他们死的时候没有疼痛；","poem":1},{"lineBreak":true},{"text":"他们的力气却也壮实。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们不像别人受苦，","poem":1},{"lineBreak":true},{"text":"也不像别人遭灾。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"所以，骄傲如链子戴在他们的项上；","poem":1},{"lineBreak":true},{"text":"强暴像衣裳遮住他们的身体。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们的眼睛因体胖而凸出；","poem":1},{"lineBreak":true},{"text":"他们所得的，过于心里所想的。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们讥笑人，凭恶意说欺压人的话；","poem":1},{"lineBreak":true},{"text":"他们说话自高。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他们的口亵渎上天；","poem":1},{"lineBreak":true},{"text":"他们的舌毁谤全地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"所以 神的民归到这里，","poem":1},{"lineBreak":true},{"text":"喝尽了满杯的苦水。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他们说： 神怎能晓得？","poem":1},{"lineBreak":true},{"text":"至高者岂有知识呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"看哪，这就是恶人；","poem":1},{"lineBreak":true},{"text":"他们既是常享安逸，财宝便加增。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我实在徒然洁净了我的心，","poem":1},{"lineBreak":true},{"text":"徒然洗手表明无辜。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因为，我终日遭灾难；","poem":1},{"lineBreak":true},{"text":"每早晨受惩治。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"我若说，我要这样讲，","poem":1},{"lineBreak":true},{"text":"这就是以奸诈待你的众子。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我思索怎能明白这事，","poem":1},{"lineBreak":true},{"text":"眼看实系为难，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"等我进了 神的圣所，","poem":1},{"lineBreak":true},{"text":"思想他们的结局。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你实在把他们安在滑地，","poem":1},{"lineBreak":true},{"text":"使他们掉在沉沦之中。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他们转眼之间成了何等的荒凉！","poem":1},{"lineBreak":true},{"text":"他们被惊恐灭尽了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"人睡醒了，怎样看梦；","poem":1},{"lineBreak":true},{"text":"主啊，你醒了也必照样轻看他们的影像。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"因而，我心里发酸，","poem":1},{"lineBreak":true},{"text":"肺腑被刺。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我这样愚昧无知，","poem":1},{"lineBreak":true},{"text":"在你面前如畜类一般。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"然而，我常与你同在；","poem":1},{"lineBreak":true},{"text":"你搀着我的右手。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你要以你的训言引导我，","poem":1},{"lineBreak":true},{"text":"以后必接我到荣耀里。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"除你以外，在天上我有谁呢？","poem":1},{"lineBreak":true},{"text":"除你以外，在地上我也没有所爱慕的。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我的肉体和我的心肠衰残；","poem":1},{"lineBreak":true},{"text":"但 神是我心里的力量，","poem":1},{"lineBreak":true},{"text":"又是我的福分，直到永远。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"远离你的，必要死亡；","poem":1},{"lineBreak":true},{"text":"凡离弃你行邪淫的，你都灭绝了。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"但我亲近 神是与我有益；","poem":1},{"lineBreak":true},{"text":"我以主耶和华为我的避难所，","poem":1},{"lineBreak":true},{"text":"好叫我述说你一切的作为。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}