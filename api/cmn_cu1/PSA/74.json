{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":74,"content":[{"type":"heading","content":["求主解救国家"]},{"type":"hebrew_subtitle","content":["亚萨的训诲诗。"]},{"type":"verse","number":1,"content":[{"text":"神啊，你为何永远丢弃我们呢？","poem":1},{"lineBreak":true},{"text":"你为何向你草场的羊发怒，如烟冒出呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你记念你古时所得来的会众，","poem":1},{"lineBreak":true},{"text":"就是你所赎、作你产业支派的，","poem":1},{"lineBreak":true},{"text":"并记念你向来所居住的锡安山。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"求你举步去看那日久荒凉之地，","poem":1},{"lineBreak":true},{"text":"仇敌在圣所中所行的一切恶事。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"你的敌人在你会中吼叫；","poem":1},{"lineBreak":true},{"text":"他们竖了自己的旗为记号。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们好像人扬起斧子，","poem":1},{"lineBreak":true},{"text":"砍伐林中的树。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"圣所中一切雕刻的，","poem":1},{"lineBreak":true},{"text":"他们现在用斧子锤子打坏了。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们用火焚烧你的圣所，","poem":1},{"lineBreak":true},{"text":"亵渎你名的居所，拆毁到地。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他们心里说：我们要尽行毁灭；","poem":1},{"lineBreak":true},{"text":"他们就在遍地把 神的会所都烧毁了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我们不见我们的标帜，不再有先知；","poem":1},{"lineBreak":true},{"text":"我们内中也没有人知道这灾祸要到几时呢！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"神啊，敌人辱骂要到几时呢？","poem":1},{"lineBreak":true},{"text":"仇敌亵渎你的名要到永远吗？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你为什么缩回你的右手？","poem":1},{"lineBreak":true},{"text":"求你从怀中伸出来，毁灭他们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"神自古以来为我的王，","poem":1},{"lineBreak":true},{"text":"在地上施行拯救。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你曾用能力将海分开，","poem":1},{"lineBreak":true},{"text":"将水中大鱼的头打破。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你曾砸碎鳄鱼的头，","poem":1},{"lineBreak":true},{"text":"把它给旷野的禽兽","poem":1},{"noteId":28},{"text":"为食物。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你曾分裂磐石，水便成了溪河；","poem":1},{"lineBreak":true},{"text":"你使长流的江河干了。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"白昼属你，黑夜也属你；","poem":1},{"lineBreak":true},{"text":"亮光和日头是你所预备的。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"地的一切疆界是你所立的；","poem":1},{"lineBreak":true},{"text":"夏天和冬天是你所定的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"耶和华啊，仇敌辱骂，","poem":1},{"lineBreak":true},{"text":"愚顽民亵渎了你的名，求你记念这事。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"不要将你斑鸠的性命交给野兽；","poem":1},{"lineBreak":true},{"text":"不要永远忘记你困苦人的性命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"求你顾念所立的约，","poem":1},{"lineBreak":true},{"text":"因为地上黑暗之处都满了强暴的居所。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"不要叫受欺压的人蒙羞回去；","poem":1},{"lineBreak":true},{"text":"要叫困苦穷乏的人赞美你的名。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"神啊，求你起来为自己伸诉！","poem":1},{"lineBreak":true},{"text":"要记念愚顽人怎样终日辱骂你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"不要忘记你敌人的声音；","poem":1},{"lineBreak":true},{"text":"那起来敌你之人的喧哗时常上升。","poem":1}]}],"footnotes":[{"noteId":28,"caller":"-","text":"禽兽：原文是民","reference":{"chapter":74,"verse":14}}]},"thisChapterLink":"/api/cmn_cu1/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}