{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":75,"content":[{"type":"heading","content":["神是审判者"]},{"type":"hebrew_subtitle","content":["亚萨的诗歌，交与伶长。调用休要毁坏。"]},{"type":"verse","number":1,"content":[{"text":"神啊，我们称谢你，我们称谢你！","poem":1},{"lineBreak":true},{"text":"因为你的名相近，人都述说你奇妙的作为。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"我到了所定的日期，","poem":1},{"lineBreak":true},{"text":"必按正直施行审判。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"地和其上的居民都消化了；","poem":1},{"lineBreak":true},{"text":"我曾立了地的柱子。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我对狂傲人说：不要行事狂傲！","poem":1},{"lineBreak":true},{"text":"对凶恶人说：不要举角！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"不要把你们的角高举；","poem":1},{"lineBreak":true},{"text":"不要挺着颈项说话。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因为高举非从东，非从西，","poem":1},{"lineBreak":true},{"text":"也非从南而来。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"惟有 神断定；","poem":1},{"lineBreak":true},{"text":"他使这人降卑，使那人升高。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华手里有杯，","poem":1},{"lineBreak":true},{"text":"其中的酒起沫，杯内满了搀杂的酒；","poem":1},{"lineBreak":true},{"text":"他倒出来，","poem":1},{"lineBreak":true},{"text":"地上的恶人必都喝这酒的渣滓，而且喝尽。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"但我要宣扬，直到永远！","poem":1},{"lineBreak":true},{"text":"我要歌颂雅各的 神！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"恶人一切的角，我要砍断；","poem":1},{"lineBreak":true},{"text":"惟有义人的角必被高举。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}