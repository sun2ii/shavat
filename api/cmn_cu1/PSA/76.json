{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":76,"content":[{"type":"heading","content":["神是胜利者"]},{"type":"hebrew_subtitle","content":["亚萨的诗歌，交与伶长。用丝弦的乐器。"]},{"type":"verse","number":1,"content":[{"text":"在犹大， 神为人所认识；","poem":1},{"lineBreak":true},{"text":"在以色列，他的名为大。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"在撒冷有他的帐幕；","poem":1},{"lineBreak":true},{"text":"在锡安有他的居所。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他在那里折断弓上的火箭，","poem":1},{"lineBreak":true},{"text":"并盾牌、刀剑，和争战的兵器。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"你从有野食之山而来，","poem":1},{"lineBreak":true},{"text":"有光华和荣美。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"心中勇敢的人都被抢夺；","poem":1},{"lineBreak":true},{"text":"他们睡了长觉，没有一个英雄能措手。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"雅各的 神啊，你的斥责一发，","poem":1},{"lineBreak":true},{"text":"坐车的、骑马的都沉睡了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"惟独你是可畏的！","poem":1},{"lineBreak":true},{"text":"你怒气一发，谁能在你面前站得住呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你从天上使人听判断。","poem":1},{"lineBreak":true},{"text":"神起来施行审判，","poem":1},{"lineBreak":true},{"text":"要救地上一切谦卑的人；","poem":1},{"lineBreak":true},{"text":"那时地就惧怕而静默。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"人的忿怒要成全你的荣美；","poem":1},{"lineBreak":true},{"text":"人的余怒，你要禁止。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你们许愿，当向耶和华—你们的 神还愿；","poem":1},{"lineBreak":true},{"text":"在他四面的人都当拿贡物献给那可畏的主。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他要挫折王子的骄气；","poem":1},{"lineBreak":true},{"text":"他向地上的君王显威可畏。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":11}