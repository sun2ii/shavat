{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":77,"content":[{"type":"heading","content":["遇难时得安慰"]},{"type":"hebrew_subtitle","content":["亚萨的诗，照耶杜顿的作法，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"我要向 神发声呼求；","poem":1},{"lineBreak":true},{"text":"我向 神发声，他必留心听我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在患难之日寻求主；","poem":1},{"lineBreak":true},{"text":"我在夜间不住地举手祷告；","poem":1},{"lineBreak":true},{"text":"我的心不肯受安慰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"我想念 神，就烦燥不安；","poem":1},{"lineBreak":true},{"text":"我沉吟悲伤，心便发昏。 （细拉）","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你叫我不能闭眼；","poem":1},{"lineBreak":true},{"text":"我烦乱不安，甚至不能说话。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我追想古时之日，","poem":1},{"lineBreak":true},{"text":"上古之年。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我想起我夜间的歌曲，扪心自问；","poem":1},{"lineBreak":true},{"text":"我心里也仔细省察。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"难道主要永远丢弃我，","poem":1},{"lineBreak":true},{"text":"不再施恩吗？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"难道他的慈爱永远穷尽，","poem":1},{"lineBreak":true},{"text":"他的应许世世废弃吗？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"难道 神忘记开恩，","poem":1},{"lineBreak":true},{"text":"因发怒就止住他的慈悲吗？ （细拉）","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我便说：这是我的懦弱，","poem":1},{"lineBreak":true},{"text":"但我要追念至高者显出右手之年代。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我要提说耶和华所行的；","poem":1},{"lineBreak":true},{"text":"我要记念你古时的奇事。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我也要思想你的经营，","poem":1},{"lineBreak":true},{"text":"默念你的作为。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"神啊，你的作为是洁净的；","poem":1},{"lineBreak":true},{"text":"有何神大如 神呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你是行奇事的 神；","poem":1},{"lineBreak":true},{"text":"你曾在列邦中彰显你的能力。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你曾用你的膀臂赎了你的民，","poem":1},{"lineBreak":true},{"text":"就是雅各和约瑟的子孙。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"神啊，诸水见你，","poem":1},{"lineBreak":true},{"text":"一见就都惊惶；","poem":1},{"lineBreak":true},{"text":"深渊也都战抖。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"云中倒出水来；","poem":1},{"lineBreak":true},{"text":"天空发出响声；","poem":1},{"lineBreak":true},{"text":"你的箭也飞行四方。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你的雷声在旋风中；","poem":1},{"lineBreak":true},{"text":"电光照亮世界；","poem":1},{"lineBreak":true},{"text":"大地战抖震动。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你的道在海中；","poem":1},{"lineBreak":true},{"text":"你的路在大水中；","poem":1},{"lineBreak":true},{"text":"你的脚踪无人知道。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你曾借摩西和亚伦的手引导你的百姓，","poem":1},{"lineBreak":true},{"text":"好像羊群一般。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}