{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":78,"content":[{"type":"heading","content":["神与他的子民"]},{"type":"hebrew_subtitle","content":["亚萨的训诲诗。"]},{"type":"verse","number":1,"content":[{"text":"我的民哪，你们要留心听我的训诲，","poem":1},{"lineBreak":true},{"text":"侧耳听我口中的话。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要开口说比喻；","poem":1},{"lineBreak":true},{"text":"我要说出古时的谜语，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"是我们所听见、所知道的，","poem":1},{"lineBreak":true},{"text":"也是我们的祖宗告诉我们的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们不将这些事向他们的子孙隐瞒，","poem":1},{"lineBreak":true},{"text":"要将耶和华的美德和他的能力，","poem":1},{"lineBreak":true},{"text":"并他奇妙的作为，述说给后代听。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"因为，他在雅各中立法度，","poem":1},{"lineBreak":true},{"text":"在以色列中设律法；","poem":1},{"lineBreak":true},{"text":"是他吩咐我们祖宗要传给子孙的，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"使将要生的后代子孙可以晓得；","poem":1},{"lineBreak":true},{"text":"他们也要起来告诉他们的子孙，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"好叫他们仰望 神，","poem":1},{"lineBreak":true},{"text":"不忘记 神的作为，","poem":1},{"lineBreak":true},{"text":"惟要守他的命令。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"不要像他们的祖宗，","poem":1},{"lineBreak":true},{"text":"是顽梗悖逆、居心不正之辈，","poem":1},{"lineBreak":true},{"text":"向着 神，心不诚实。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"以法莲的子孙带着兵器，拿着弓，","poem":1},{"lineBreak":true},{"text":"临阵之日转身退后。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们不遵守 神的约，","poem":1},{"lineBreak":true},{"text":"不肯照他的律法行；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"又忘记他所行的","poem":1},{"lineBreak":true},{"text":"和他显给他们奇妙的作为。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他在埃及地，在琐安田，","poem":1},{"lineBreak":true},{"text":"在他们祖宗的眼前施行奇事。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他将海分裂，使他们过去，","poem":1},{"lineBreak":true},{"text":"又叫水立起如垒。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他白日用云彩，","poem":1},{"lineBreak":true},{"text":"终夜用火光引导他们。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他在旷野分裂磐石，","poem":1},{"lineBreak":true},{"text":"多多地给他们水喝，如从深渊而出。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他使水从磐石涌出，","poem":1},{"lineBreak":true},{"text":"叫水如江河下流。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"他们却仍旧得罪他，","poem":1},{"lineBreak":true},{"text":"在干燥之地悖逆至高者。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他们心中试探 神，","poem":1},{"lineBreak":true},{"text":"随自己所欲的求食物，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"并且妄论 神说：","poem":1},{"lineBreak":true},{"text":"神在旷野岂能摆设筵席吗？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他曾击打磐石，使水涌出，成了江河；","poem":1},{"lineBreak":true},{"text":"他还能赐粮食吗？","poem":1},{"lineBreak":true},{"text":"还能为他的百姓预备肉吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"所以，耶和华听见就发怒；","poem":1},{"lineBreak":true},{"text":"有烈火向雅各烧起；","poem":1},{"lineBreak":true},{"text":"有怒气向以色列上腾；","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因为他们不信服 神，","poem":1},{"lineBreak":true},{"text":"不倚赖他的救恩。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他却吩咐天空，","poem":1},{"lineBreak":true},{"text":"又敞开天上的门，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"降吗哪，像雨给他们吃，","poem":1},{"lineBreak":true},{"text":"将天上的粮食赐给他们。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"各人","poem":1},{"noteId":29},{"text":"吃大能者的食物；","poem":1},{"lineBreak":true},{"text":"他赐下粮食，使他们饱足。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他领东风起在天空，","poem":1},{"lineBreak":true},{"text":"又用能力引了南风来。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他降肉，像雨在他们当中，多如尘土，","poem":1},{"lineBreak":true},{"text":"又降飞鸟，多如海沙，","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"落在他们的营中，","poem":1},{"lineBreak":true},{"text":"在他们住处的四面。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他们吃了，而且饱足；","poem":1},{"lineBreak":true},{"text":"这样就随了他们所欲的。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他们贪而无厌，","poem":1},{"lineBreak":true},{"text":"食物还在他们口中的时候，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"神的怒气就向他们上腾，","poem":1},{"lineBreak":true},{"text":"杀了他们内中的肥壮人，","poem":1},{"lineBreak":true},{"text":"打倒以色列的少年人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"虽是这样，他们仍旧犯罪，","poem":1},{"lineBreak":true},{"text":"不信他奇妙的作为。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"因此，他叫他们的日子全归虚空，","poem":1},{"lineBreak":true},{"text":"叫他们的年岁尽属惊恐。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"他杀他们的时候，他们才求问他，","poem":1},{"lineBreak":true},{"text":"回心转意，切切地寻求 神。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"他们也追念 神是他们的磐石，","poem":1},{"lineBreak":true},{"text":"至高的 神是他们的救赎主。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他们却用口谄媚他，","poem":1},{"lineBreak":true},{"text":"用舌向他说谎。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"因他们的心向他不正，","poem":1},{"lineBreak":true},{"text":"在他的约上也不忠心。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"但他有怜悯，","poem":1},{"lineBreak":true},{"text":"赦免他们的罪孽，","poem":1},{"lineBreak":true},{"text":"不灭绝他们，","poem":1},{"lineBreak":true},{"text":"而且屡次消他的怒气，","poem":1},{"lineBreak":true},{"text":"不发尽他的忿怒。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"他想到他们不过是血气，","poem":1},{"lineBreak":true},{"text":"是一阵去而不返的风。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"他们在旷野悖逆他，","poem":1},{"lineBreak":true},{"text":"在荒地叫他担忧，何其多呢！","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"他们再三试探 神，","poem":1},{"lineBreak":true},{"text":"惹动以色列的圣者。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"他们不追念他的能力","poem":1},{"noteId":30},{"lineBreak":true},{"text":"和赎他们脱离敌人的日子；","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"他怎样在埃及地显神迹，","poem":1},{"lineBreak":true},{"text":"在琐安田显奇事，","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"把他们的江河并河汊的水都变为血，","poem":1},{"lineBreak":true},{"text":"使他们不能喝。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"他叫苍蝇成群落在他们当中，嘬尽他们，","poem":1},{"lineBreak":true},{"text":"又叫青蛙灭了他们，","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"把他们的土产交给蚂蚱，","poem":1},{"lineBreak":true},{"text":"把他们辛苦得来的交给蝗虫。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"他降冰雹打坏他们的葡萄树，","poem":1},{"lineBreak":true},{"text":"下严霜打坏他们的桑树，","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"又把他们的牲畜交给冰雹，","poem":1},{"lineBreak":true},{"text":"把他们的群畜交给闪电。","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"他使猛烈的怒气和忿怒、恼恨、苦难","poem":1},{"lineBreak":true},{"text":"成了一群降灾的使者，临到他们。","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"他为自己的怒气修平了路，","poem":1},{"lineBreak":true},{"text":"将他们交给瘟疫，","poem":1},{"lineBreak":true},{"text":"使他们死亡，","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"在埃及击杀一切长子，","poem":1},{"lineBreak":true},{"text":"在含的帐棚中击杀他们强壮时头生的。","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"他却领出自己的民如羊，","poem":1},{"lineBreak":true},{"text":"在旷野引他们如羊群。","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"他领他们稳稳妥妥地，使他们不致害怕；","poem":1},{"lineBreak":true},{"text":"海却淹没他们的仇敌。","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"他带他们到自己圣地的边界，","poem":1},{"lineBreak":true},{"text":"到他右手所得的这山地。","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"他在他们面前赶出外邦人，","poem":1},{"lineBreak":true},{"text":"用绳子将外邦的地量给他们为业，","poem":1},{"lineBreak":true},{"text":"叫以色列支派的人住在他们的帐棚里。","poem":1}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"他们仍旧试探、悖逆至高的 神，","poem":1},{"lineBreak":true},{"text":"不守他的法度，","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"反倒退后，行诡诈，像他们的祖宗一样；","poem":1},{"lineBreak":true},{"text":"他们改变，如同翻背的弓。","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"因他们的邱坛惹了他的怒气；","poem":1},{"lineBreak":true},{"text":"因他们雕刻的偶像触动他的愤恨。","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"神听见就发怒，","poem":1},{"lineBreak":true},{"text":"极其憎恶以色列人。","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"甚至他离弃示罗的帐幕，","poem":1},{"lineBreak":true},{"text":"就是他在人间所搭的帐棚；","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"又将他的约柜","poem":1},{"noteId":31},{"text":"交与人掳去，","poem":1},{"lineBreak":true},{"text":"将他的荣耀交在敌人手中；","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"并将他的百姓交与刀剑，","poem":1},{"lineBreak":true},{"text":"向他的产业发怒。","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"少年人被火烧灭；","poem":1},{"lineBreak":true},{"text":"处女也无喜歌。","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"祭司倒在刀下，","poem":1},{"lineBreak":true},{"text":"寡妇却不哀哭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"那时，主像世人睡醒，","poem":1},{"lineBreak":true},{"text":"像勇士饮酒呼喊。","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"他就打退了他的敌人，","poem":1},{"lineBreak":true},{"text":"叫他们永蒙羞辱；","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"并且他弃掉约瑟的帐棚，","poem":1},{"lineBreak":true},{"text":"不拣选以法莲支派，","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"却拣选犹大支派—他所喜爱的锡安山；","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"盖造他的圣所，好像高峰，","poem":1},{"lineBreak":true},{"text":"又像他建立永存之地；","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"又拣选他的仆人大卫，","poem":1},{"lineBreak":true},{"text":"从羊圈中将他召来，","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"叫他不再跟从那些带奶的母羊，","poem":1},{"lineBreak":true},{"text":"为要牧养自己的百姓雅各","poem":1},{"lineBreak":true},{"text":"和自己的产业以色列。","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"于是，他按心中的纯正牧养他们，","poem":1},{"lineBreak":true},{"text":"用手中的巧妙引导他们。","poem":1}]}],"footnotes":[{"noteId":29,"caller":"-","text":"或译：人","reference":{"chapter":78,"verse":25}},{"noteId":30,"caller":"-","text":"原文是手","reference":{"chapter":78,"verse":42}},{"noteId":31,"caller":"-","text":"原文是能力","reference":{"chapter":78,"verse":61}}]},"thisChapterLink":"/api/cmn_cu1/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}