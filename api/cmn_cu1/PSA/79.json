{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":79,"content":[{"type":"heading","content":["求主解救国家"]},{"type":"hebrew_subtitle","content":["亚萨的诗。"]},{"type":"verse","number":1,"content":[{"text":"神啊，外邦人进入你的产业，","poem":1},{"lineBreak":true},{"text":"污秽你的圣殿，使耶路撒冷变成荒堆，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"把你仆人的尸首交与天空的飞鸟为食，","poem":1},{"lineBreak":true},{"text":"把你圣民的肉交与地上的野兽，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"在耶路撒冷周围流他们的血如水，","poem":1},{"lineBreak":true},{"text":"无人葬埋。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我们成为邻国的羞辱，","poem":1},{"lineBreak":true},{"text":"成为我们四围人的嗤笑讥刺。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和华啊，这到几时呢？","poem":1},{"lineBreak":true},{"text":"你要动怒到永远吗？","poem":1},{"lineBreak":true},{"text":"你的愤恨要如火焚烧吗？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愿你将你的忿怒倒在那不认识你的外邦","poem":1},{"lineBreak":true},{"text":"和那不求告你名的国度。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因为他们吞了雅各，","poem":1},{"lineBreak":true},{"text":"把他的住处变为荒场。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"求你不要记念我们先祖的罪孽，向我们追讨；","poem":1},{"lineBreak":true},{"text":"愿你的慈悲快迎着我们，","poem":1},{"lineBreak":true},{"text":"因为我们落到极卑微的地步。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"拯救我们的 神啊，求你因你名的荣耀帮助我们！","poem":1},{"lineBreak":true},{"text":"为你名的缘故搭救我们，赦免我们的罪。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"为何容外邦人说「他们的 神在哪里」呢？","poem":1},{"lineBreak":true},{"text":"愿你使外邦人知道你在我们眼前","poem":1},{"lineBreak":true},{"text":"伸你仆人流血的冤。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"愿被囚之人的叹息达到你面前；","poem":1},{"lineBreak":true},{"text":"愿你按你的大能力存留那些将要死的人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"主啊，愿你将我们邻邦所羞辱你的羞辱","poem":1},{"lineBreak":true},{"text":"加七倍归到他们身上。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"这样，你的民，你草场的羊，","poem":1},{"lineBreak":true},{"text":"要称谢你，直到永远；","poem":1},{"lineBreak":true},{"text":"要述说赞美你的话，直到万代。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}