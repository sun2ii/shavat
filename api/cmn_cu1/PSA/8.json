{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":8,"content":[{"type":"heading","content":["神的荣耀和人的尊贵"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。用迦特乐器。"]},{"type":"verse","number":1,"content":[{"text":"耶和华—我们的主啊，","poem":1},{"lineBreak":true},{"text":"你的名在全地何其美！","poem":1},{"lineBreak":true},{"text":"你将你的荣耀彰显于天。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你因敌人的缘故，","poem":1},{"lineBreak":true},{"text":"从婴孩和吃奶的口中，","poem":1},{"lineBreak":true},{"text":"建立了能力，","poem":1},{"lineBreak":true},{"text":"使仇敌和报仇的闭口无言。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"我观看你指头所造的天，","poem":1},{"lineBreak":true},{"text":"并你所陈设的月亮星宿，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"便说：人算什么，你竟顾念他！","poem":1},{"lineBreak":true},{"text":"世人算什么，你竟眷顾他！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你叫他比天使","poem":1},{"noteId":0},{"text":"微小一点，","poem":1},{"lineBreak":true},{"text":"并赐他荣耀尊贵为冠冕。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你派他管理你手所造的，","poem":1},{"lineBreak":true},{"text":"使万物，就是一切的牛羊、","poem":1},{"lineBreak":true},{"text":"田野的兽、空中的鸟、海里的鱼，","poem":1},{"lineBreak":true},{"text":"凡经行海道的，都服在他的脚下。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和华—我们的主啊，","poem":1},{"lineBreak":true},{"text":"你的名在全地何其美！","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"或译： 神","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/cmn_cu1/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":7}