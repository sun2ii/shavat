{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":80,"content":[{"type":"heading","content":["求主复兴国家"]},{"type":"hebrew_subtitle","content":["亚萨的诗，交与伶长。调用为证的百合花。"]},{"type":"verse","number":1,"content":[{"text":"领约瑟如领羊群之以色列的牧者啊，求你留心听！","poem":1},{"lineBreak":true},{"text":"坐在二基路伯上的啊，求你发出光来！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"在以法莲、便雅悯、玛拿西前面","poem":1},{"lineBreak":true},{"text":"施展你的大能，来救我们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"神啊，求你使我们回转","poem":1},{"noteId":32},{"text":"，","poem":1},{"lineBreak":true},{"text":"使你的脸发光，我们便要得救！","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和华—万军之 神啊，","poem":1},{"lineBreak":true},{"text":"你向你百姓的祷告发怒，要到几时呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你以眼泪当食物给他们吃，","poem":1},{"lineBreak":true},{"text":"又多量出眼泪给他们喝。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你使邻邦因我们纷争；","poem":1},{"lineBreak":true},{"text":"我们的仇敌彼此戏笑。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"万军之 神啊，求你使我们回转，","poem":1},{"lineBreak":true},{"text":"使你的脸发光，我们便要得救！","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你从埃及挪出一棵葡萄树，","poem":1},{"lineBreak":true},{"text":"赶出外邦人，把这树栽上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你在这树根前预备了地方，","poem":1},{"lineBreak":true},{"text":"它就深深扎根，爬满了地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"它的影子遮满了山，","poem":1},{"lineBreak":true},{"text":"枝子好像佳美的香柏树。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"它发出枝子，长到大海，","poem":1},{"lineBreak":true},{"text":"发出蔓子，延到大河。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你为何拆毁这树的篱笆，","poem":1},{"lineBreak":true},{"text":"任凭一切过路的人摘取？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"林中出来的野猪把它糟踏；","poem":1},{"lineBreak":true},{"text":"野地的走兽拿它当食物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"万军之 神啊，求你回转！","poem":1},{"lineBreak":true},{"text":"从天上垂看，眷顾这葡萄树，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"保护你右手所栽的","poem":1},{"lineBreak":true},{"text":"和你为自己所坚固的枝子。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"这树已经被火焚烧，被刀砍伐；","poem":1},{"lineBreak":true},{"text":"他们因你脸上的怒容就灭亡了。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"愿你的手扶持你右边的人，","poem":1},{"lineBreak":true},{"text":"就是你为自己所坚固的人子。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"这样，我们便不退后离开你；","poem":1},{"lineBreak":true},{"text":"求你救活我们，我们就要求告你的名。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和华—万军之 神啊，求你使我们回转，","poem":1},{"lineBreak":true},{"text":"使你的脸发光，我们便要得救！","poem":1}]}],"footnotes":[{"noteId":32,"caller":"-","text":"或译：复兴","reference":{"chapter":80,"verse":3}}]},"thisChapterLink":"/api/cmn_cu1/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}