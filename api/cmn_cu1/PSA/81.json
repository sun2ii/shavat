{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":81,"content":[{"type":"heading","content":["圣洁的诗"]},{"type":"hebrew_subtitle","content":["亚萨的诗，交与伶长。用迦特乐器。"]},{"type":"verse","number":1,"content":[{"text":"你们当向 神—我们的力量大声欢呼，","poem":1},{"lineBreak":true},{"text":"向雅各的 神发声欢乐！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"唱起诗歌，打手鼓，","poem":1},{"lineBreak":true},{"text":"弹美琴与瑟。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"当在月朔并月望—","poem":1},{"lineBreak":true},{"text":"我们过节的日期吹角，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因这是为以色列定的律例，","poem":1},{"lineBreak":true},{"text":"是雅各 神的典章。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他去攻击埃及地的时候，","poem":1},{"lineBreak":true},{"text":"在约瑟中间立此为证。","poem":1},{"lineBreak":true},{"text":"我在那里听见我所不明白的言语：","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"神说：我使你的肩得脱重担，","poem":1},{"lineBreak":true},{"text":"你的手放下筐子。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你在急难中呼求，我就搭救你；","poem":1},{"lineBreak":true},{"text":"我在雷的隐密处应允你，","poem":1},{"lineBreak":true},{"text":"在米利巴水那里试验你。 （细拉）","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的民哪，你当听，我要劝戒你；","poem":1},{"lineBreak":true},{"text":"以色列啊，甚愿你肯听从我。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"在你当中，不可有别的神；","poem":1},{"lineBreak":true},{"text":"外邦的神，你也不可下拜。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我是耶和华—你的 神，","poem":1},{"lineBreak":true},{"text":"曾把你从埃及地领上来；","poem":1},{"lineBreak":true},{"text":"你要大大张口，我就给你充满。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"无奈，我的民不听我的声音；","poem":1},{"lineBreak":true},{"text":"以色列全不理我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我便任凭他们心里刚硬，","poem":1},{"lineBreak":true},{"text":"随自己的计谋而行。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"甚愿我的民肯听从我，","poem":1},{"lineBreak":true},{"text":"以色列肯行我的道，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我便速速治服他们的仇敌，","poem":1},{"lineBreak":true},{"text":"反手攻击他们的敌人。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"恨耶和华的人必来投降，","poem":1},{"lineBreak":true},{"text":"但他的百姓必永久长存。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他也必拿上好的麦子给他们吃，","poem":1},{"lineBreak":true},{"text":"又拿从磐石出的蜂蜜叫他们饱足。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}