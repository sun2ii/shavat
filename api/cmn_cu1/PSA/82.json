{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":82,"content":[{"type":"heading","content":["神是最高的主宰"]},{"type":"hebrew_subtitle","content":["亚萨的诗。"]},{"type":"verse","number":1,"content":[{"text":"神站在有权力者的会中，","poem":1},{"lineBreak":true},{"text":"在诸神中行审判，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"说：你们审判不秉公义，","poem":1},{"lineBreak":true},{"text":"徇恶人的情面，要到几时呢？ （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你们当为贫寒的人和孤儿伸冤；","poem":1},{"lineBreak":true},{"text":"当为困苦和穷乏的人施行公义。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"当保护贫寒和穷乏的人，","poem":1},{"lineBreak":true},{"text":"救他们脱离恶人的手。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你们仍不知道，也不明白，","poem":1},{"lineBreak":true},{"text":"在黑暗中走来走去；","poem":1},{"lineBreak":true},{"text":"地的根基都摇动了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我曾说：你们是神，","poem":1},{"lineBreak":true},{"text":"都是至高者的儿子。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"然而，你们要死，与世人一样，","poem":1},{"lineBreak":true},{"text":"要仆倒，像王子中的一位。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"神啊，求你起来审判世界，","poem":1},{"lineBreak":true},{"text":"因为你要得万邦为业。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}