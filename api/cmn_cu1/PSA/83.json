{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":83,"content":[{"type":"heading","content":["求主败敌"]},{"type":"hebrew_subtitle","content":["亚萨的诗歌。"]},{"type":"verse","number":1,"content":[{"text":"神啊，求你不要静默！","poem":1},{"lineBreak":true},{"text":"神啊，求你不要闭口，也不要不作声！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为你的仇敌喧嚷，","poem":1},{"lineBreak":true},{"text":"恨你的抬起头来。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们同谋奸诈要害你的百姓，","poem":1},{"lineBreak":true},{"text":"彼此商议要害你所隐藏的人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他们说：来吧，我们将他们剪灭，","poem":1},{"lineBreak":true},{"text":"使他们不再成国！","poem":1},{"lineBreak":true},{"text":"使以色列的名不再被人记念！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们同心商议，","poem":1},{"lineBreak":true},{"text":"彼此结盟，要抵挡你，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"就是住帐棚的以东人和以实玛利人，","poem":1},{"lineBreak":true},{"text":"摩押和夏甲人，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"迦巴勒、亚扪，","poem":1},{"lineBreak":true},{"text":"和亚玛力、非利士并泰尔的居民。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"亚述也与他们连合；","poem":1},{"lineBreak":true},{"text":"他们作罗得子孙的帮手。 （细拉）","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你待他们，如待米甸，","poem":1},{"lineBreak":true},{"text":"如在基顺河待西西拉和耶宾一样。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他们在隐·多珥灭亡，","poem":1},{"lineBreak":true},{"text":"成了地上的粪土。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你叫他们的首领像俄立和西伊伯，","poem":1},{"lineBreak":true},{"text":"叫他们的王子都像西巴和撒慕拿。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们说：我们要得 神的住处，","poem":1},{"lineBreak":true},{"text":"作为自己的产业。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我的 神啊，求你叫他们像旋风的尘土，","poem":1},{"lineBreak":true},{"text":"像风前的碎秸。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"火怎样焚烧树林，","poem":1},{"lineBreak":true},{"text":"火焰怎样烧着山岭，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"求你也照样用狂风追赶他们，","poem":1},{"lineBreak":true},{"text":"用暴雨恐吓他们。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"愿你使他们满面羞耻，","poem":1},{"lineBreak":true},{"text":"好叫他们寻求你—耶和华的名！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"愿他们永远羞愧惊惶！","poem":1},{"lineBreak":true},{"text":"愿他们惭愧灭亡！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"使他们知道：惟独你—","poem":1},{"lineBreak":true},{"text":"名为耶和华的—是全地以上的至高者！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}