{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":84,"content":[{"type":"heading","content":["渴慕耶和华的殿宇"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗，交与伶长。用迦特乐器。"]},{"type":"verse","number":1,"content":[{"text":"万军之耶和华啊，","poem":1},{"lineBreak":true},{"text":"你的居所何等可爱！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我羡慕渴想耶和华的院宇；","poem":1},{"lineBreak":true},{"text":"我的心肠，我的肉体向永生 神呼吁","poem":1},{"noteId":33},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"万军之耶和华—我的王，我的 神啊，","poem":1},{"lineBreak":true},{"text":"在你祭坛那里，麻雀为自己找着房屋，","poem":1},{"lineBreak":true},{"text":"燕子为自己找着抱雏之窝。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"如此住在你殿中的便为有福！","poem":1},{"lineBreak":true},{"text":"他们仍要赞美你。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"靠你有力量、心中想往锡安大道的，","poem":1},{"lineBreak":true},{"text":"这人便为有福！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们经过「流泪谷」，叫这谷变为泉源之地；","poem":1},{"lineBreak":true},{"text":"并有秋雨之福盖满了全谷。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们行走，力上加力，","poem":1},{"lineBreak":true},{"text":"各人到锡安朝见 神。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华—万军之 神啊，求你听我的祷告！","poem":1},{"lineBreak":true},{"text":"雅各的 神啊，求你留心听！ （细拉）","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"神啊，你是我们的盾牌；","poem":1},{"lineBreak":true},{"text":"求你垂顾观看你受膏者的面！","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"在你的院宇住一日，","poem":1},{"lineBreak":true},{"text":"胜似在别处住千日；","poem":1},{"lineBreak":true},{"text":"宁可在我 神殿中看门，","poem":1},{"lineBreak":true},{"text":"不愿住在恶人的帐棚里。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因为耶和华— 神是日头，是盾牌，","poem":1},{"lineBreak":true},{"text":"要赐下恩惠和荣耀。","poem":1},{"lineBreak":true},{"text":"他未尝留下一样好处不给那些行动正直的人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"万军之耶和华啊，","poem":1},{"lineBreak":true},{"text":"倚靠你的人便为有福！","poem":1}]}],"footnotes":[{"noteId":33,"caller":"-","text":"或译：欢呼","reference":{"chapter":84,"verse":2}}]},"thisChapterLink":"/api/cmn_cu1/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}