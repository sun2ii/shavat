{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":85,"content":[{"type":"heading","content":["为国求福"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗，交与伶长。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，你已经向你的地施恩，","poem":1},{"lineBreak":true},{"text":"救回被掳的雅各。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你赦免了你百姓的罪孽，","poem":1},{"lineBreak":true},{"text":"遮盖了他们一切的过犯。 （细拉）","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你收转了所发的忿怒","poem":1},{"lineBreak":true},{"text":"和你猛烈的怒气。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"拯救我们的 神啊，求你使我们回转，","poem":1},{"lineBreak":true},{"text":"叫你的恼恨向我们止息。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你要向我们发怒到永远吗？","poem":1},{"lineBreak":true},{"text":"你要将你的怒气延留到万代吗？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你不再将我们救活，","poem":1},{"lineBreak":true},{"text":"使你的百姓靠你欢喜吗？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和华啊，求你使我们得见你的慈爱，","poem":1},{"lineBreak":true},{"text":"又将你的救恩赐给我们。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我要听 神—耶和华所说的话；","poem":1},{"lineBreak":true},{"text":"因为他必应许将平安赐给他的百姓—他的圣民；","poem":1},{"lineBreak":true},{"text":"他们却不可再转去妄行。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他的救恩诚然与敬畏他的人相近，","poem":1},{"lineBreak":true},{"text":"叫荣耀住在我们的地上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"慈爱和诚实彼此相遇；","poem":1},{"lineBreak":true},{"text":"公义和平安彼此相亲。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"诚实从地而生；","poem":1},{"lineBreak":true},{"text":"公义从天而现。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和华必将好处赐给我们；","poem":1},{"lineBreak":true},{"text":"我们的地也要多出土产。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"公义要行在他面前，","poem":1},{"lineBreak":true},{"text":"叫他的脚踪成为可走的路。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}