{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":86,"content":[{"type":"heading","content":["求主恩助"]},{"type":"hebrew_subtitle","content":["大卫的祈祷。"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，求你侧耳应允我，","poem":1},{"lineBreak":true},{"text":"因我是困苦穷乏的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你保存我的性命，因我是虔诚人。","poem":1},{"lineBreak":true},{"text":"我的 神啊，求你拯救这倚靠你的仆人！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"主啊，求你怜悯我，","poem":1},{"lineBreak":true},{"text":"因我终日求告你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"主啊，求你使仆人心里欢喜，","poem":1},{"lineBreak":true},{"text":"因为我的心仰望你。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"主啊，你本为良善，乐意饶恕人，","poem":1},{"lineBreak":true},{"text":"有丰盛的慈爱赐给凡求告你的人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和华啊，求你留心听我的祷告，","poem":1},{"lineBreak":true},{"text":"垂听我恳求的声音。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我在患难之日要求告你，","poem":1},{"lineBreak":true},{"text":"因为你必应允我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"主啊，诸神之中没有可比你的；","poem":1},{"lineBreak":true},{"text":"你的作为也无可比。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"主啊，你所造的万民都要来敬拜你；","poem":1},{"lineBreak":true},{"text":"他们也要荣耀你的名。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因你为大，且行奇妙的事；","poem":1},{"lineBreak":true},{"text":"惟独你是 神。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华啊，求你将你的道指教我；","poem":1},{"lineBreak":true},{"text":"我要照你的真理行；","poem":1},{"lineBreak":true},{"text":"求你使我专心敬畏你的名！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"主—我的 神啊，我要一心称赞你；","poem":1},{"lineBreak":true},{"text":"我要荣耀你的名，直到永远。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因为，你向我发的慈爱是大的；","poem":1},{"lineBreak":true},{"text":"你救了我的灵魂免入极深的阴间。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"神啊，骄傲的人起来攻击我，","poem":1},{"lineBreak":true},{"text":"又有一党强横的人寻索我的命；","poem":1},{"lineBreak":true},{"text":"他们没有将你放在眼中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"主啊，你是有怜悯有恩典的 神，","poem":1},{"lineBreak":true},{"text":"不轻易发怒，并有丰盛的慈爱和诚实。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"求你向我转脸，怜恤我，","poem":1},{"lineBreak":true},{"text":"将你的力量赐给仆人，救你婢女的儿子。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"求你向我显出恩待我的凭据，","poem":1},{"lineBreak":true},{"text":"叫恨我的人看见便羞愧，","poem":1},{"lineBreak":true},{"text":"因为你—耶和华帮助我，安慰我。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}