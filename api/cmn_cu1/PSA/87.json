{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":87,"content":[{"type":"heading","content":["锡安颂"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和华所立的根基在圣山上。","poem":1}]},{"type":"verse","number":2,"content":[{"text":"他爱锡安的门，","poem":1},{"lineBreak":true},{"text":"胜于爱雅各一切的住处。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"神的城啊，","poem":1},{"lineBreak":true},{"text":"有荣耀的事乃指着你说的。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我要提起拉哈伯和巴比伦人，","poem":1},{"lineBreak":true},{"text":"是在认识我之中的；","poem":1},{"lineBreak":true},{"text":"看哪，非利士和泰尔并古实人，","poem":1},{"lineBreak":true},{"text":"个个生在那里。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"论到锡安，必说：","poem":1},{"lineBreak":true},{"text":"这一个、那一个都生在其中，","poem":1},{"lineBreak":true},{"text":"而且至高者必亲自坚立这城。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"当耶和华记录万民的时候，","poem":1},{"lineBreak":true},{"text":"他要点出这一个生在那里。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"歌唱的，跳舞的，都要说：","poem":1},{"lineBreak":true},{"text":"我的泉源都在你里面。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}