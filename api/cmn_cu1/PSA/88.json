{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":88,"content":[{"type":"heading","content":["求主眷顾"]},{"type":"hebrew_subtitle","content":["可拉后裔的诗歌，就是以斯拉人希幔的训诲诗，交与伶长。调用麻哈拉利暗俄。"]},{"type":"verse","number":1,"content":[{"text":"耶和华—拯救我的 神啊，","poem":1},{"lineBreak":true},{"text":"我昼夜在你面前呼吁。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愿我的祷告达到你面前；","poem":1},{"lineBreak":true},{"text":"求你侧耳听我的呼求！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因为我心里满了患难；","poem":1},{"lineBreak":true},{"text":"我的性命临近阴间。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我算和下坑的人同列，","poem":1},{"lineBreak":true},{"text":"如同无力","poem":1},{"noteId":34},{"text":"的人一样。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我被丢在死人中，","poem":1},{"lineBreak":true},{"text":"好像被杀的人躺在坟墓里。","poem":1},{"lineBreak":true},{"text":"他们是你不再记念的，","poem":1},{"lineBreak":true},{"text":"与你隔绝了。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你把我放在极深的坑里，","poem":1},{"lineBreak":true},{"text":"在黑暗地方，在深处。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的忿怒重压我身；","poem":1},{"lineBreak":true},{"text":"你用一切的波浪困住我。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你把我所认识的隔在远处，","poem":1},{"lineBreak":true},{"text":"使我为他们所憎恶；","poem":1},{"lineBreak":true},{"text":"我被拘困，不得出来。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的眼睛因困苦而干瘪。","poem":1},{"lineBreak":true},{"text":"耶和华啊，我天天求告你，向你举手。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你岂要行奇事给死人看吗？","poem":1},{"lineBreak":true},{"text":"难道阴魂还能起来称赞你吗？ （细拉）","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"岂能在坟墓里述说你的慈爱吗？","poem":1},{"lineBreak":true},{"text":"岂能在灭亡中述说你的信实吗？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你的奇事岂能在幽暗里被知道吗？","poem":1},{"lineBreak":true},{"text":"你的公义岂能在忘记之地被知道吗？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和华啊，我呼求你；","poem":1},{"lineBreak":true},{"text":"我早晨的祷告要达到你面前。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和华啊，你为何丢弃我？","poem":1},{"lineBreak":true},{"text":"为何掩面不顾我？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我自幼受苦，几乎死亡；","poem":1},{"lineBreak":true},{"text":"我受你的惊恐，甚至慌张。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你的烈怒漫过我身；","poem":1},{"lineBreak":true},{"text":"你的惊吓把我剪除。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"这些终日如水环绕我，","poem":1},{"lineBreak":true},{"text":"一齐都来围困我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你把我的良朋密友隔在远处，","poem":1},{"lineBreak":true},{"text":"使我所认识的人进入黑暗里。","poem":1}]}],"footnotes":[{"noteId":34,"caller":"-","text":"或译：没有帮助","reference":{"chapter":88,"verse":4}}]},"thisChapterLink":"/api/cmn_cu1/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}