{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":89,"content":[{"type":"heading","content":["困难中的圣诗"]},{"type":"hebrew_subtitle","content":["以斯拉人以探的训诲诗。"]},{"type":"verse","number":1,"content":[{"text":"我要歌唱耶和华的慈爱，直到永远；","poem":1},{"lineBreak":true},{"text":"我要用口将你的信实传与万代。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因我曾说：你的慈悲必建立到永远；","poem":1},{"lineBreak":true},{"text":"你的信实必坚立在天上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我与我所拣选的人立了约，","poem":1},{"lineBreak":true},{"text":"向我的仆人大卫起了誓：","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要建立你的后裔，直到永远；","poem":1},{"lineBreak":true},{"text":"要建立你的宝座，直到万代。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和华啊，诸天要称赞你的奇事；","poem":1},{"lineBreak":true},{"text":"在圣者的会中，要称赞你的信实。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"在天空谁能比耶和华呢？","poem":1},{"lineBreak":true},{"text":"神的众子中，谁能像耶和华呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他在圣者的会中，是大有威严的 神，","poem":1},{"lineBreak":true},{"text":"比一切在他四围的更可畏惧。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华—万军之 神啊，","poem":1},{"lineBreak":true},{"text":"哪一个大能者像你耶和华？","poem":1},{"lineBreak":true},{"text":"你的信实是在你的四围。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你管辖海的狂傲；","poem":1},{"lineBreak":true},{"text":"波浪翻腾，你就使它平静了。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你打碎了拉哈伯，似乎是已杀的人；","poem":1},{"lineBreak":true},{"text":"你用有能的膀臂打散了你的仇敌。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"天属你，地也属你；","poem":1},{"lineBreak":true},{"text":"世界和其中所充满的都为你所建立。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"南北为你所创造；","poem":1},{"lineBreak":true},{"text":"他泊和黑门都因你的名欢呼。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你有大能的膀臂；","poem":1},{"lineBreak":true},{"text":"你的手有力，你的右手也高举。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"公义和公平是你宝座的根基；","poem":1},{"lineBreak":true},{"text":"慈爱和诚实行在你前面。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"知道向你欢呼的，那民是有福的！","poem":1},{"lineBreak":true},{"text":"耶和华啊，他们在你脸上的光里行走。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他们因你的名终日欢乐，","poem":1},{"lineBreak":true},{"text":"因你的公义得以高举。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你是他们力量的荣耀；","poem":1},{"lineBreak":true},{"text":"因为你喜悦我们，我们的角必被高举。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我们的盾牌属耶和华；","poem":1},{"lineBreak":true},{"text":"我们的王属以色列的圣者。","poem":1}]},{"type":"heading","content":["神对大卫的应许"]},{"type":"verse","number":19,"content":[{"text":"当时，你在异象中晓谕你的圣民，说：","poem":1},{"lineBreak":true},{"text":"我已把救助之力加在那有能者的身上；","poem":1},{"lineBreak":true},{"text":"我高举那从民中所拣选的。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我寻得我的仆人大卫，","poem":1},{"lineBreak":true},{"text":"用我的圣膏膏他。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我的手必使他坚立；","poem":1},{"lineBreak":true},{"text":"我的膀臂也必坚固他。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"仇敌必不勒索他；","poem":1},{"lineBreak":true},{"text":"凶恶之子也不苦害他。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我要在他面前打碎他的敌人，","poem":1},{"lineBreak":true},{"text":"击杀那恨他的人。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"只是我的信实和我的慈爱要与他同在；","poem":1},{"lineBreak":true},{"text":"因我的名，他的角必被高举。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我要使他的左手伸到海上，","poem":1},{"lineBreak":true},{"text":"右手伸到河上。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他要称呼我说：你是我的父，","poem":1},{"lineBreak":true},{"text":"是我的 神，是拯救我的磐石。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我也要立他为长子，","poem":1},{"lineBreak":true},{"text":"为世上最高的君王。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我要为他存留我的慈爱，直到永远；","poem":1},{"lineBreak":true},{"text":"我与他立的约必要坚定。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我也要使他的后裔存到永远，","poem":1},{"lineBreak":true},{"text":"使他的宝座如天之久。","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"倘若他的子孙离弃我的律法，","poem":1},{"lineBreak":true},{"text":"不照我的典章行，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"背弃我的律例，","poem":1},{"lineBreak":true},{"text":"不遵守我的诫命，","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我就要用杖责罚他们的过犯，","poem":1},{"lineBreak":true},{"text":"用鞭责罚他们的罪孽。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"只是我必不将我的慈爱全然收回，","poem":1},{"lineBreak":true},{"text":"也必不叫我的信实废弃。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"我必不背弃我的约，","poem":1},{"lineBreak":true},{"text":"也不改变我口中所出的。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"我一次指着自己的圣洁起誓：","poem":1},{"lineBreak":true},{"text":"我决不向大卫说谎！","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他的后裔要存到永远；","poem":1},{"lineBreak":true},{"text":"他的宝座在我面前如日之恒一般，","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"又如月亮永远坚立，","poem":1},{"lineBreak":true},{"text":"如天上确实的见证。 （细拉）","poem":1}]},{"type":"heading","content":["君主惨败的哀歌"]},{"type":"verse","number":38,"content":[{"text":"但你恼怒你的受膏者，","poem":1},{"lineBreak":true},{"text":"就丢掉弃绝他。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"你厌恶了与仆人所立的约，","poem":1},{"lineBreak":true},{"text":"将他的冠冕践踏于地。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"你拆毁了他一切的篱笆，","poem":1},{"lineBreak":true},{"text":"使他的保障变为荒场。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"凡过路的人都抢夺他；","poem":1},{"lineBreak":true},{"text":"他成为邻邦的羞辱。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"你高举了他敌人的右手；","poem":1},{"lineBreak":true},{"text":"你叫他一切的仇敌欢喜。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"你叫他的刀剑卷刃，","poem":1},{"lineBreak":true},{"text":"叫他在争战之中站立不住。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"你使他的光辉止息，","poem":1},{"lineBreak":true},{"text":"将他的宝座推倒于地。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"你减少他青年的日子，","poem":1},{"lineBreak":true},{"text":"又使他蒙羞。 （细拉）","poem":1}]},{"type":"heading","content":["求救的祷告"]},{"type":"verse","number":46,"content":[{"text":"耶和华啊，这要到几时呢？","poem":1},{"lineBreak":true},{"text":"你要将自己隐藏到永远吗？","poem":1},{"lineBreak":true},{"text":"你的忿怒如火焚烧要到几时呢？","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"求你想念我的时候是何等的短少；","poem":1},{"lineBreak":true},{"text":"你创造世人，要使他们归何等的虚空呢？","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"谁能常活免死、","poem":1},{"lineBreak":true},{"text":"救他的灵魂脱离阴间的权柄呢？ （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"主啊，你从前凭你的信实","poem":1},{"lineBreak":true},{"text":"向大卫立誓要施行的慈爱在哪里呢？","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"主啊，求你记念仆人们所受的羞辱，","poem":1},{"lineBreak":true},{"text":"记念我怎样将一切强盛民的羞辱存在我怀里。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"耶和华啊，你的仇敌用这羞辱羞辱了你的仆人，","poem":1},{"lineBreak":true},{"text":"羞辱了你受膏者的脚踪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"耶和华是应当称颂的，直到永远。","poem":1},{"lineBreak":true},{"text":"阿们！阿们！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}