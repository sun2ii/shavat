{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":9,"content":[{"type":"heading","content":["称颂耶和华的公义"]},{"type":"hebrew_subtitle","content":["大卫的诗，交与伶长。调用慕拉便。"]},{"type":"verse","number":1,"content":[{"text":"我要一心称谢耶和华；","poem":1},{"lineBreak":true},{"text":"我要传扬你一切奇妙的作为。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要因你欢喜快乐；","poem":1},{"lineBreak":true},{"text":"至高者啊，我要歌颂你的名！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"我的仇敌转身退去的时候，","poem":1},{"lineBreak":true},{"text":"他们一见你的面就跌倒灭亡。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因你已经为我伸冤，为我辨屈；","poem":1},{"lineBreak":true},{"text":"你坐在宝座上，按公义审判。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你曾斥责外邦，你曾灭绝恶人；","poem":1},{"lineBreak":true},{"text":"你曾涂抹他们的名，直到永永远远。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"仇敌到了尽头；","poem":1},{"lineBreak":true},{"text":"他们被毁坏，直到永远。","poem":1},{"lineBreak":true},{"text":"你拆毁他们的城邑，","poem":1},{"lineBreak":true},{"text":"连他们的名号都归于无有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"惟耶和华坐着为王，直到永远；","poem":1},{"lineBreak":true},{"text":"他已经为审判设摆他的宝座。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他要按公义审判世界，","poem":1},{"lineBreak":true},{"text":"按正直判断万民。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和华又要给受欺压的人作高台，","poem":1},{"lineBreak":true},{"text":"在患难的时候作高台。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和华啊，认识你名的人要倚靠你，","poem":1},{"lineBreak":true},{"text":"因你没有离弃寻求你的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"应当歌颂居锡安的耶和华，","poem":1},{"lineBreak":true},{"text":"将他所行的传扬在众民中。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因为那追讨流人血之罪的—他记念受屈的人，","poem":1},{"lineBreak":true},{"text":"不忘记困苦人的哀求。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和华啊，你是从死门把我提拔起来的；","poem":1},{"lineBreak":true},{"text":"求你怜恤我，看那恨我的人所加给我的苦难，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"好叫我述说你一切的美德；","poem":1},{"lineBreak":true},{"text":"我必在锡安城","poem":1},{"noteId":1},{"text":"的门因你的救恩欢乐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"外邦人陷在自己所掘的坑中；","poem":1},{"lineBreak":true},{"text":"他们的脚在自己暗设的网罗里缠住了。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和华已将自己显明了，他已施行审判；","poem":1},{"lineBreak":true},{"text":"恶人被自己手所做的缠住了","poem":1},{"noteId":2},{"text":"。 （细拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"恶人，就是忘记 神的外邦人，","poem":1},{"lineBreak":true},{"text":"都必归到阴间。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"穷乏人必不永久被忘；","poem":1},{"lineBreak":true},{"text":"困苦人的指望必不永远落空。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和华啊，求你起来，不容人得胜！","poem":1},{"lineBreak":true},{"text":"愿外邦人在你面前受审判！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和华啊，求你使外邦人恐惧；","poem":1},{"lineBreak":true},{"text":"愿他们知道自己不过是人。 （细拉）","poem":1}]}],"footnotes":[{"noteId":1,"caller":"-","text":"原文是女子","reference":{"chapter":9,"verse":14}},{"noteId":2,"caller":"-","text":"或译：他叫恶人被自己手所做的累住了","reference":{"chapter":9,"verse":16}}]},"thisChapterLink":"/api/cmn_cu1/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}