{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":90,"content":[{"type":"heading","content":["神与人"]},{"type":"hebrew_subtitle","content":["神人摩西的祈祷。"]},{"type":"verse","number":1,"content":[{"text":"主啊，你世世代代作我们的居所。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"诸山未曾生出，","poem":1},{"lineBreak":true},{"text":"地与世界你未曾造成，","poem":1},{"lineBreak":true},{"text":"从亘古到永远，你是 神。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你使人归于尘土，说：","poem":1},{"lineBreak":true},{"text":"你们世人要归回。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"在你看来，千年如已过的昨日，","poem":1},{"lineBreak":true},{"text":"又如夜间的一更。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你叫他们如水冲去；","poem":1},{"lineBreak":true},{"text":"他们如睡一觉。","poem":1},{"lineBreak":true},{"text":"早晨，他们如生长的草，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"早晨发芽生长，","poem":1},{"lineBreak":true},{"text":"晚上割下枯干。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我们因你的怒气而消灭，","poem":1},{"lineBreak":true},{"text":"因你的忿怒而惊惶。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你将我们的罪孽摆在你面前，","poem":1},{"lineBreak":true},{"text":"将我们的隐恶摆在你面光之中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我们经过的日子都在你震怒之下；","poem":1},{"lineBreak":true},{"text":"我们度尽的年岁好像一声叹息。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我们一生的年日是七十岁，","poem":1},{"lineBreak":true},{"text":"若是强壮可到八十岁；","poem":1},{"lineBreak":true},{"text":"但其中所矜夸的不过是劳苦愁烦，","poem":1},{"lineBreak":true},{"text":"转眼成空，我们便如飞而去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"谁晓得你怒气的权势？","poem":1},{"lineBreak":true},{"text":"谁按着你该受的敬畏晓得你的忿怒呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你指教我们怎样数算自己的日子，","poem":1},{"lineBreak":true},{"text":"好叫我们得着智慧的心。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和华啊，我们要等到几时呢？","poem":1},{"lineBreak":true},{"text":"求你转回，为你的仆人后悔。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"求你使我们早早饱得你的慈爱，","poem":1},{"lineBreak":true},{"text":"好叫我们一生一世欢呼喜乐。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"求你照着你使我们受苦的日子，","poem":1},{"lineBreak":true},{"text":"和我们遭难的年岁，叫我们喜乐。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"愿你的作为向你仆人显现；","poem":1},{"lineBreak":true},{"text":"愿你的荣耀向他们子孙显明。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"愿主—我们 神的荣美归于我们身上。","poem":1},{"lineBreak":true},{"text":"愿你坚立我们手所做的工；","poem":1},{"lineBreak":true},{"text":"我们手所做的工，愿你坚立。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}