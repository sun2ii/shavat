{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":91,"content":[{"type":"heading","content":["神是我们的保护者"]},{"type":"verse","number":1,"content":[{"text":"住在至高者隐密处的，","poem":1},{"lineBreak":true},{"text":"必住在全能者的荫下。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要论到耶和华说：","poem":1},{"lineBreak":true},{"text":"他是我的避难所，是我的山寨，","poem":1},{"lineBreak":true},{"text":"是我的 神，是我所倚靠的。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他必救你脱离捕鸟人的网罗","poem":1},{"lineBreak":true},{"text":"和毒害的瘟疫。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他必用自己的翎毛遮蔽你；","poem":1},{"lineBreak":true},{"text":"你要投靠在他的翅膀底下；","poem":1},{"lineBreak":true},{"text":"他的诚实是大小的盾牌。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你必不怕黑夜的惊骇，","poem":1},{"lineBreak":true},{"text":"或是白日飞的箭，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"也不怕黑夜行的瘟疫，","poem":1},{"lineBreak":true},{"text":"或是午间灭人的毒病。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"虽有千人仆倒在你旁边，","poem":1},{"lineBreak":true},{"text":"万人仆倒在你右边，","poem":1},{"lineBreak":true},{"text":"这灾却不得临近你。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你惟亲眼观看，","poem":1},{"lineBreak":true},{"text":"见恶人遭报。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和华是我的避难所；","poem":1},{"lineBreak":true},{"text":"你已将至高者当你的居所，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"祸患必不临到你，","poem":1},{"lineBreak":true},{"text":"灾害也不挨近你的帐棚。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"因他要为你吩咐他的使者，","poem":1},{"lineBreak":true},{"text":"在你行的一切道路上保护你。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他们要用手托着你，","poem":1},{"lineBreak":true},{"text":"免得你的脚碰在石头上。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你要踹在狮子和虺蛇的身上，","poem":1},{"lineBreak":true},{"text":"践踏少壮狮子和大蛇。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"神说：因为他专心爱我，我就要搭救他；","poem":1},{"lineBreak":true},{"text":"因为他知道我的名，我要把他安置在高处。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他若求告我，我就应允他；","poem":1},{"lineBreak":true},{"text":"他在急难中，我要与他同在；","poem":1},{"lineBreak":true},{"text":"我要搭救他，使他尊贵。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要使他足享长寿，","poem":1},{"lineBreak":true},{"text":"将我的救恩显明给他。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}