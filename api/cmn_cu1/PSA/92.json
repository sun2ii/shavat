{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":92,"content":[{"type":"heading","content":["颂赞之诗"]},{"type":"hebrew_subtitle","content":["安息日的诗歌。"]},{"type":"verse","number":1,"content":[{"text":"称谢耶和华！","poem":1},{"lineBreak":true},{"text":"歌颂你至高者的名！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"用十弦的乐器和瑟，","poem":1},{"lineBreak":true},{"text":"用琴弹幽雅的声音，","poem":1},{"lineBreak":true},{"text":"早晨传扬你的慈爱；","poem":1},{"lineBreak":true},{"text":"每夜传扬你的信实。","poem":1},{"lineBreak":true},{"text":"这本为美事。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因你—耶和华借着你的作为叫我高兴，","poem":1},{"lineBreak":true},{"text":"我要因你手的工作欢呼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和华啊，你的工作何其大！","poem":1},{"lineBreak":true},{"text":"你的心思极其深！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"畜类人不晓得；","poem":1},{"lineBreak":true},{"text":"愚顽人也不明白。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"恶人茂盛如草，","poem":1},{"lineBreak":true},{"text":"一切作孽之人发旺的时候，","poem":1},{"lineBreak":true},{"text":"正是他们要灭亡，","poem":1},{"lineBreak":true},{"text":"直到永远。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"惟你—耶和华是至高，","poem":1},{"lineBreak":true},{"text":"直到永远。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和华啊，你的仇敌都要灭亡；","poem":1},{"lineBreak":true},{"text":"一切作孽的也要离散。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你却高举了我的角，如野牛的角；","poem":1},{"lineBreak":true},{"text":"我是被新油膏了的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我眼睛看见仇敌遭报；","poem":1},{"lineBreak":true},{"text":"我耳朵听见那些起来攻击我的恶人受罚。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"义人要发旺如棕树，","poem":1},{"lineBreak":true},{"text":"生长如黎巴嫩的香柏树。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他们栽于耶和华的殿中，","poem":1},{"lineBreak":true},{"text":"发旺在我们 神的院里。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他们年老的时候仍要结果子，","poem":1},{"lineBreak":true},{"text":"要满了汁浆而常发青，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"好显明耶和华是正直的。","poem":1},{"lineBreak":true},{"text":"他是我的磐石，在他毫无不义。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":14}