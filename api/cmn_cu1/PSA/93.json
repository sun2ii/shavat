{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":93,"content":[{"type":"heading","content":["神是王"]},{"type":"verse","number":1,"content":[{"text":"耶和华作王！","poem":1},{"lineBreak":true},{"text":"他以威严为衣穿上；","poem":1},{"lineBreak":true},{"text":"耶和华以能力为衣，以能力束腰，","poem":1},{"lineBreak":true},{"text":"世界就坚定，不得动摇。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你的宝座从太初立定；","poem":1},{"lineBreak":true},{"text":"你从亘古就有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和华啊，大水扬起，","poem":1},{"lineBreak":true},{"text":"大水发声，波浪澎湃。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和华在高处大有能力，","poem":1},{"lineBreak":true},{"text":"胜过诸水的响声，洋海的大浪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和华啊，你的法度最的确；","poem":1},{"lineBreak":true},{"text":"你的殿永称为圣，是合宜的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}