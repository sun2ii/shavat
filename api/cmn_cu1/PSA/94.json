{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":94,"content":[{"type":"heading","content":["神审判万人"]},{"type":"verse","number":1,"content":[{"text":"耶和华啊，你是伸冤的 神；","poem":1},{"lineBreak":true},{"text":"伸冤的 神啊，求你发出光来！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"审判世界的主啊，求你挺身而立，","poem":1},{"lineBreak":true},{"text":"使骄傲人受应得的报应！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和华啊，恶人夸胜要到几时呢？","poem":1},{"lineBreak":true},{"text":"要到几时呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他们絮絮叨叨说傲慢的话；","poem":1},{"lineBreak":true},{"text":"一切作孽的人都自己夸张。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和华啊，他们强压你的百姓，","poem":1},{"lineBreak":true},{"text":"苦害你的产业。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他们杀死寡妇和寄居的，","poem":1},{"lineBreak":true},{"text":"又杀害孤儿。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他们说：耶和华必不看见；","poem":1},{"lineBreak":true},{"text":"雅各的 神必不思念。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你们民间的畜类人当思想；","poem":1},{"lineBreak":true},{"text":"你们愚顽人到几时才有智慧呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"造耳朵的，难道自己不听见吗？","poem":1},{"lineBreak":true},{"text":"造眼睛的，难道自己不看见吗？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"管教列邦的，就是叫人得知识的，","poem":1},{"lineBreak":true},{"text":"难道自己不惩治人吗？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华知道人的意念是虚妄的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和华啊，你所管教、","poem":1},{"lineBreak":true},{"text":"用律法所教训的人是有福的！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你使他在遭难的日子得享平安；","poem":1},{"lineBreak":true},{"text":"惟有恶人陷在所挖的坑中。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因为耶和华必不丢弃他的百姓，","poem":1},{"lineBreak":true},{"text":"也不离弃他的产业。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"审判要转向公义；","poem":1},{"lineBreak":true},{"text":"心里正直的，必都随从。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"谁肯为我起来攻击作恶的？","poem":1},{"lineBreak":true},{"text":"谁肯为我站起抵挡作孽的？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"若不是耶和华帮助我，","poem":1},{"lineBreak":true},{"text":"我就住在寂静之中了。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我正说我失了脚，","poem":1},{"lineBreak":true},{"text":"耶和华啊，那时你的慈爱扶助我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我心里多忧多疑，","poem":1},{"lineBreak":true},{"text":"你安慰我，就使我欢乐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"那借着律例架弄残害、","poem":1},{"lineBreak":true},{"text":"在位上行奸恶的，岂能与你相交吗？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他们大家聚集攻击义人，","poem":1},{"lineBreak":true},{"text":"将无辜的人定为死罪。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"但耶和华向来作了我的高台；","poem":1},{"lineBreak":true},{"text":"我的 神作了我投靠的磐石。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他叫他们的罪孽归到他们身上。","poem":1},{"lineBreak":true},{"text":"他们正在行恶之中，他要剪除他们；","poem":1},{"lineBreak":true},{"text":"耶和华—我们的 神要把他们剪除。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}