{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":95,"content":[{"type":"heading","content":["颂赞之诗"]},{"type":"verse","number":1,"content":[{"text":"来啊，我们要向耶和华歌唱，","poem":1},{"lineBreak":true},{"text":"向拯救我们的磐石欢呼！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我们要来感谢他，","poem":1},{"lineBreak":true},{"text":"用诗歌向他欢呼！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因耶和华为大 神，","poem":1},{"lineBreak":true},{"text":"为大王，超乎万神之上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"地的深处在他手中；","poem":1},{"lineBreak":true},{"text":"山的高峰也属他。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"海洋属他，是他造的；","poem":1},{"lineBreak":true},{"text":"旱地也是他手造成的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"来啊，我们要屈身敬拜，","poem":1},{"lineBreak":true},{"text":"在造我们的耶和华面前跪下。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因为他是我们的 神；","poem":1},{"lineBreak":true},{"text":"我们是他草场的羊，是他手下的民。","poem":1},{"lineBreak":true},{"text":"惟愿你们今天听他的话：","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你们不可硬着心，像当日在米利巴，","poem":1},{"lineBreak":true},{"text":"就是在旷野的玛撒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"那时，你们的祖宗试我探我，","poem":1},{"lineBreak":true},{"text":"并且观看我的作为。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"四十年之久，我厌烦那世代，说：","poem":1},{"lineBreak":true},{"text":"这是心里迷糊的百姓，","poem":1},{"lineBreak":true},{"text":"竟不晓得我的作为！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"所以，我在怒中起誓，说：","poem":1},{"lineBreak":true},{"text":"他们断不可进入我的安息！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}