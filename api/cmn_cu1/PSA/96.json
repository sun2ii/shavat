{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":96,"content":[{"type":"heading","content":["神是最高的君王"]},{"type":"verse","number":1,"content":[{"text":"你们要向耶和华唱新歌！","poem":1},{"lineBreak":true},{"text":"全地都要向耶和华歌唱！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要向耶和华歌唱，称颂他的名！","poem":1},{"lineBreak":true},{"text":"天天传扬他的救恩！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"在列邦中述说他的荣耀！","poem":1},{"lineBreak":true},{"text":"在万民中述说他的奇事！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因耶和华为大，当受极大的赞美；","poem":1},{"lineBreak":true},{"text":"他在万神之上，当受敬畏。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"外邦的神都属虚无；","poem":1},{"lineBreak":true},{"text":"惟独耶和华创造诸天。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"有尊荣和威严在他面前；","poem":1},{"lineBreak":true},{"text":"有能力与华美在他圣所。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"民中的万族啊，你们要将荣耀、能力归给耶和华，","poem":1},{"lineBreak":true},{"text":"都归给耶和华！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"要将耶和华的名所当得的荣耀归给他，","poem":1},{"lineBreak":true},{"text":"拿供物来进入他的院宇。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"当以圣洁的","poem":1},{"noteId":35},{"text":"妆饰敬拜耶和华；","poem":1},{"lineBreak":true},{"text":"全地要在他面前战抖！","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"人在列邦中要说：耶和华作王！","poem":1},{"lineBreak":true},{"text":"世界就坚定，不得动摇；","poem":1},{"lineBreak":true},{"text":"他要按公正审判众民。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"愿天欢喜，愿地快乐！","poem":1},{"lineBreak":true},{"text":"愿海和其中所充满的澎湃！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"愿田和其中所有的都欢乐！","poem":1},{"lineBreak":true},{"text":"那时，林中的树木都要在耶和华面前欢呼。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因为他来了，他来要审判全地。","poem":1},{"lineBreak":true},{"text":"他要按公义审判世界，","poem":1},{"lineBreak":true},{"text":"按他的信实审判万民。","poem":1}]}],"footnotes":[{"noteId":35,"caller":"-","text":"的：或译为","reference":{"chapter":96,"verse":9}}]},"thisChapterLink":"/api/cmn_cu1/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}