{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":97,"content":[{"type":"heading","content":["神是最高的统治者"]},{"type":"verse","number":1,"content":[{"text":"耶和华作王！愿地快乐！","poem":1},{"lineBreak":true},{"text":"愿众海岛欢喜！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"密云和幽暗在他的四围；","poem":1},{"lineBreak":true},{"text":"公义和公平是他宝座的根基。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"有烈火在他前头行，","poem":1},{"lineBreak":true},{"text":"烧灭他四围的敌人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他的闪电光照世界，","poem":1},{"lineBreak":true},{"text":"大地看见便震动。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"诸山见耶和华的面，","poem":1},{"lineBreak":true},{"text":"就是全地之主的面，便消化如蜡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"诸天表明他的公义；","poem":1},{"lineBreak":true},{"text":"万民看见他的荣耀。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愿一切事奉雕刻的偶像、","poem":1},{"lineBreak":true},{"text":"靠虚无之神自夸的，都蒙羞愧。","poem":1},{"lineBreak":true},{"text":"万神哪，你们都当拜他。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和华啊，锡安听见你的判断就欢喜；","poem":1},{"lineBreak":true},{"text":"犹大的城邑","poem":1},{"noteId":36},{"text":"也都快乐。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为你—耶和华至高，超乎全地；","poem":1},{"lineBreak":true},{"text":"你被尊崇，远超万神之上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你们爱耶和华的，都当恨恶罪恶；","poem":1},{"lineBreak":true},{"text":"他保护圣民的性命，","poem":1},{"lineBreak":true},{"text":"搭救他们脱离恶人的手。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"散布亮光是为义人；","poem":1},{"lineBreak":true},{"text":"预备喜乐是为正直人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你们义人当靠耶和华欢喜，","poem":1},{"lineBreak":true},{"text":"称谢他可记念的圣名。","poem":1}]}],"footnotes":[{"noteId":36,"caller":"-","text":"原文是女子","reference":{"chapter":97,"verse":8}}]},"thisChapterLink":"/api/cmn_cu1/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}