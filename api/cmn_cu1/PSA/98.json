{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":98,"content":[{"type":"heading","content":["神掌管世界"]},{"type":"hebrew_subtitle","content":["一篇诗。"]},{"type":"verse","number":1,"content":[{"text":"你们要向耶和华唱新歌！","poem":1},{"lineBreak":true},{"text":"因为他行过奇妙的事；","poem":1},{"lineBreak":true},{"text":"他的右手和圣臂施行救恩。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华发明了他的救恩，","poem":1},{"lineBreak":true},{"text":"在列邦人眼前显出公义；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"记念他向以色列家所发的慈爱，所凭的信实。","poem":1},{"lineBreak":true},{"text":"地的四极都看见我们 神的救恩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"全地都要向耶和华欢乐；","poem":1},{"lineBreak":true},{"text":"要发起大声，欢呼歌颂！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要用琴歌颂耶和华，","poem":1},{"lineBreak":true},{"text":"用琴和诗歌的声音歌颂他！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"用号和角声，","poem":1},{"lineBreak":true},{"text":"在大君王耶和华面前欢呼！","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"愿海和其中所充满的澎湃；","poem":1},{"lineBreak":true},{"text":"世界和住在其间的也要发声。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"愿大水拍手；","poem":1},{"lineBreak":true},{"text":"愿诸山在耶和华面前一同欢呼；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因为他来要审判遍地。","poem":1},{"lineBreak":true},{"text":"他要按公义审判世界，","poem":1},{"lineBreak":true},{"text":"按公正审判万民。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}