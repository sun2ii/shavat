{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cu1","name":"诗篇","commonName":"诗篇","title":"诗篇","order":19,"numberOfChapters":150,"sha256":"dbc381a0d937a76da00e224516c540ebdb97b246a5380bed1b67f15a492e5440","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cu1/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":99,"content":[{"type":"heading","content":["神是至高之王"]},{"type":"verse","number":1,"content":[{"text":"耶和华作王；万民当战抖！","poem":1},{"lineBreak":true},{"text":"他坐在二基路伯上，地当动摇。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和华在锡安为大；","poem":1},{"lineBreak":true},{"text":"他超乎万民之上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他们当称赞他大而可畏的名；","poem":1},{"lineBreak":true},{"text":"他本为圣！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"王有能力，喜爱公平，坚立公正，","poem":1},{"lineBreak":true},{"text":"在雅各中施行公平和公义。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你们当尊崇耶和华—我们的 神，","poem":1},{"lineBreak":true},{"text":"在他脚凳前下拜。","poem":1},{"lineBreak":true},{"text":"他本为圣！","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"在他的祭司中有摩西和亚伦；","poem":1},{"lineBreak":true},{"text":"在求告他名的人中有撒母耳。","poem":1},{"lineBreak":true},{"text":"他们求告耶和华，他就应允他们。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他在云柱中对他们说话；","poem":1},{"lineBreak":true},{"text":"他们遵守他的法度和他所赐给他们的律例。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和华—我们的 神啊，你应允他们；","poem":1},{"lineBreak":true},{"text":"你是赦免他们的 神，","poem":1},{"lineBreak":true},{"text":"却按他们所行的报应他们。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你们要尊崇耶和华—我们的 神，","poem":1},{"lineBreak":true},{"text":"在他的圣山下拜，","poem":1},{"lineBreak":true},{"text":"因为耶和华—我们的 神本为圣！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}