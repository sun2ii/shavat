{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"REV","translationId":"cmn_cu1","name":"启示录","commonName":"启示录","title":"启示录","order":66,"numberOfChapters":22,"sha256":"d51813eeb92e52c116e540460191a340affdfe0ba2e16b4df2e89cff219ae65e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/cmn_cu1/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["巴比伦倾倒"]},{"type":"verse","number":1,"content":["此后，我看见另有一位有大权柄的天使从天降下，地就因他的荣耀发光。"]},{"type":"verse","number":2,"content":["他大声喊着说：",{"text":"巴比伦大城倾倒了！倾倒了！","poem":1},{"lineBreak":true},{"text":"成了鬼魔的住处","poem":1},{"lineBreak":true},{"text":"和各样污秽之灵的巢穴","poem":1},{"noteId":13},{"text":"，","poem":1},{"lineBreak":true},{"text":"并各样污秽可憎之雀鸟的巢穴。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因为列国都被她邪淫大怒的酒倾倒了。","poem":1},{"lineBreak":true},{"text":"地上的君王与她行淫；","poem":1},{"lineBreak":true},{"text":"地上的客商因她奢华太过就发了财。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我又听见从天上有声音说：","poem":1},{"lineBreak":true},{"text":"我的民哪，你们要从那城出来，","poem":1},{"lineBreak":true},{"text":"免得与她一同有罪，受她所受的灾殃；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因她的罪恶滔天；","poem":1},{"lineBreak":true},{"text":"她的不义， 神已经想起来了。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"她怎样待人，也要怎样待她，","poem":1},{"lineBreak":true},{"text":"按她所行的加倍地报应她；","poem":1},{"lineBreak":true},{"text":"用她调酒的杯加倍地调给她喝。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"她怎样荣耀自己，怎样奢华，","poem":1},{"lineBreak":true},{"text":"也当叫她照样痛苦悲哀，","poem":1},{"lineBreak":true},{"text":"因她心里说：","poem":1},{"lineBreak":true},{"text":"我坐了皇后的位，","poem":1},{"lineBreak":true},{"text":"并不是寡妇，","poem":1},{"lineBreak":true},{"text":"决不至于悲哀。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"所以在一天之内，","poem":1},{"lineBreak":true},{"text":"她的灾殃要一齐来到，","poem":1},{"lineBreak":true},{"text":"就是死亡、悲哀、饥荒。","poem":1},{"lineBreak":true},{"text":"她又要被火烧尽了，","poem":1},{"lineBreak":true},{"text":"因为审判她的主 神大有能力。","poem":1}]},{"type":"verse","number":9,"content":["地上的君王，素来与她行淫、一同奢华的，看见烧她的烟，就必为她哭泣哀号。"]},{"type":"verse","number":10,"content":["因怕她的痛苦，就远远地站着说：哀哉！哀哉！",{"text":"巴比伦大城，坚固的城啊，","poem":1},{"lineBreak":true},{"text":"一时之间你的刑罚就来到了。","poem":1}]},{"type":"verse","number":11,"content":["地上的客商也都为她哭泣悲哀，因为没有人再买他们的货物了；"]},{"type":"verse","number":12,"content":["这货物就是金、银、宝石、珍珠、细麻布、紫色料、绸子、朱红色料、各样香木、各样象牙的器皿、各样极宝贵的木头，和铜、铁、汉白玉的器皿，"]},{"type":"verse","number":13,"content":["并肉桂、豆蔻、香料、香膏、乳香、酒、油、细面、麦子、牛、羊、车、马，和奴仆、人口。"]},{"type":"verse","number":14,"content":[{"text":"巴比伦哪，你所贪爱的果子离开了你；","poem":1},{"lineBreak":true},{"text":"你一切的珍馐美味","poem":1},{"lineBreak":true},{"text":"和华美的物件也从你中间毁灭，","poem":1},{"lineBreak":true},{"text":"决不能再见了。","poem":1}]},{"type":"verse","number":15,"content":["贩卖这些货物、借着她发了财的客商，因怕她的痛苦，就远远地站着哭泣悲哀，说："]},{"type":"verse","number":16,"content":[{"text":"哀哉！哀哉！这大城啊，","poem":1},{"lineBreak":true},{"text":"素常穿着细麻、","poem":1},{"lineBreak":true},{"text":"紫色、朱红色的衣服，","poem":1},{"lineBreak":true},{"text":"又用金子、宝石，和珍珠为妆饰。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"一时之间，这么大的富厚就归于无有了。","poem":1},"凡船主和坐船往各处去的，并众水手，连所有靠海为业的，都远远地站着，"]},{"type":"verse","number":18,"content":["看见烧她的烟，就喊着说：「有何城能比这大城呢？」"]},{"type":"verse","number":19,"content":["他们又把尘土撒在头上，哭泣悲哀，喊着说：",{"text":"哀哉！哀哉！这大城啊。","poem":1},{"lineBreak":true},{"text":"凡有船在海中的，都因她的珍宝成了富足！","poem":1},{"lineBreak":true},{"text":"她在一时之间就成了荒场！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"天哪，众圣徒、众使徒、众先知啊，","poem":1},{"lineBreak":true},{"text":"你们都要因她欢喜，","poem":1},{"lineBreak":true},{"text":"因为 神已经在她身上伸了你们的冤。","poem":1}]},{"type":"verse","number":21,"content":["有一位大力的天使举起一块石头，好像大磨石，扔在海里，说：",{"text":"巴比伦大城也必这样猛力地被扔下去，","poem":1},{"lineBreak":true},{"text":"决不能再见了。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"弹琴、作乐、吹笛、吹号的声音，","poem":1},{"lineBreak":true},{"text":"在你中间决不能再听见；","poem":1},{"lineBreak":true},{"text":"各行手艺人在你中间决不能再遇见；","poem":1},{"lineBreak":true},{"text":"推磨的声音在你中间决不能再听见；","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"灯光在你中间决不能再照耀；","poem":1},{"lineBreak":true},{"text":"新郎和新妇的声音，在你中间决不能再听见。","poem":1},{"lineBreak":true},{"text":"你的客商原来是地上的尊贵人；","poem":1},{"lineBreak":true},{"text":"万国也被你的邪术迷惑了。","poem":1}]},{"type":"verse","number":24,"content":["先知和圣徒，并地上一切被杀之人的血，都在这城里看见了。"]}],"footnotes":[{"noteId":13,"caller":"-","text":"或译：牢狱；下同","reference":{"chapter":18,"verse":2}}]},"thisChapterLink":"/api/cmn_cu1/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}