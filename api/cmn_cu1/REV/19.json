{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"REV","translationId":"cmn_cu1","name":"启示录","commonName":"启示录","title":"启示录","order":66,"numberOfChapters":22,"sha256":"d51813eeb92e52c116e540460191a340affdfe0ba2e16b4df2e89cff219ae65e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/cmn_cu1/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":["此后，我听见好像群众在天上大声说：",{"text":"哈利路亚","poem":1},{"noteId":14},{"text":"！","poem":1},{"lineBreak":true},{"text":"救恩、荣耀、权能都属乎我们的 神！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他的判断是真实公义的；","poem":1},{"lineBreak":true},{"text":"因他判断了那用淫行败坏世界的大淫妇，","poem":1},{"lineBreak":true},{"text":"并且向淫妇讨流仆人血的罪，","poem":1},{"lineBreak":true},{"text":"给他们伸冤。","poem":1}]},{"type":"verse","number":3,"content":["又说：",{"text":"哈利路亚！","poem":1},{"lineBreak":true},{"text":"烧淫妇的烟往上冒，","poem":1},{"lineBreak":true},{"text":"直到永永远远。","poem":1}]},{"type":"verse","number":4,"content":["那二十四位长老与四活物就俯伏敬拜坐宝座的 神，说：",{"text":"阿们！哈利路亚！","poem":1}]},{"type":"heading","content":["羔羊的婚筵"]},{"type":"verse","number":5,"content":[{"text":"有声音从宝座出来说：","poem":1},{"lineBreak":true},{"text":"神的众仆人哪，","poem":1},{"lineBreak":true},{"text":"凡敬畏他的，无论大小，","poem":1},{"lineBreak":true},{"text":"都要赞美我们的 神！","poem":1}]},{"type":"verse","number":6,"content":["我听见好像群众的声音，众水的声音，大雷的声音，说：",{"text":"哈利路亚！","poem":1},{"lineBreak":true},{"text":"因为主—我们的 神、","poem":1},{"lineBreak":true},{"text":"全能者作王了。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我们要欢喜快乐，","poem":1},{"lineBreak":true},{"text":"将荣耀归给他。","poem":1},{"lineBreak":true},{"text":"因为，羔羊婚娶的时候到了；","poem":1},{"lineBreak":true},{"text":"新妇也自己预备好了，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"就蒙恩得穿光明洁白的细麻衣。","poem":1},{"lineBreak":true},{"text":"（这细麻衣就是圣徒所行的义。）","poem":1}]},{"type":"verse","number":9,"content":["天使吩咐我说：「你要写上：凡被请赴羔羊之婚筵的有福了！」又对我说：「这是 神真实的话。」"]},{"type":"verse","number":10,"content":["我就俯伏在他脚前要拜他。他说：「千万不可！我和你，并你那些为耶稣作见证的弟兄同是作仆人的，你要敬拜 神。」因为预言中的灵意乃是为耶稣作见证。"]},{"type":"heading","content":["骑白马者"]},{"type":"verse","number":11,"content":["我观看，见天开了。有一匹白马，骑在马上的称为诚信真实，他审判，争战，都按着公义。"]},{"type":"verse","number":12,"content":["他的眼睛如火焰，他头上戴着许多冠冕；又有写着的名字，除了他自己没有人知道。"]},{"type":"verse","number":13,"content":["他穿着溅了血的衣服；他的名称为 神之道。"]},{"type":"verse","number":14,"content":["在天上的众军骑着白马，穿着细麻衣，又白又洁，跟随他。"]},{"type":"verse","number":15,"content":["有利剑从他口中出来，可以击杀列国。他必用铁杖辖管",{"noteId":15},"他们，并要踹全能 神烈怒的酒榨。"]},{"type":"verse","number":16,"content":["在他衣服和大腿上有名写着说：「万王之王，万主之主。」"]},{"type":"verse","number":17,"content":["我又看见一位天使站在日头中，向天空所飞的鸟大声喊着说：「你们聚集来赴 神的大筵席，"]},{"type":"verse","number":18,"content":["可以吃君王与将军的肉，壮士与马和骑马者的肉，并一切自主的为奴的，以及大小人民的肉。」"]},{"type":"verse","number":19,"content":["我看见那兽和地上的君王，并他们的众军都聚集，要与骑白马的并他的军兵争战。"]},{"type":"verse","number":20,"content":["那兽被擒拿；那在兽面前曾行奇事、迷惑受兽印记和拜兽像之人的假先知，也与兽同被擒拿。他们两个就活活地被扔在烧着硫磺的火湖里；"]},{"type":"verse","number":21,"content":["其余的被骑白马者口中出来的剑杀了；飞鸟都吃饱了他们的肉。"]}],"footnotes":[{"noteId":14,"caller":"-","text":"就是要赞美耶和华的意思","reference":{"chapter":19,"verse":1}},{"noteId":15,"caller":"-","text":"辖管：原文是牧","reference":{"chapter":19,"verse":15}}]},"thisChapterLink":"/api/cmn_cu1/REV/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/REV/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/REV/18.json","previousChapterAudioLinks":{},"numberOfVerses":21}