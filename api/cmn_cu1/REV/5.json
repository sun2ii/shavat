{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"REV","translationId":"cmn_cu1","name":"启示录","commonName":"启示录","title":"启示录","order":66,"numberOfChapters":22,"sha256":"d51813eeb92e52c116e540460191a340affdfe0ba2e16b4df2e89cff219ae65e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/cmn_cu1/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":5,"content":[{"type":"heading","content":["书卷和羔羊"]},{"type":"verse","number":1,"content":["我看见坐宝座的右手中有书卷，里外都写着字，用七印封严了。"]},{"type":"verse","number":2,"content":["我又看见一位大力的天使大声宣传说：「有谁配展开那书卷，揭开那七印呢？」"]},{"type":"verse","number":3,"content":["在天上、地上、地底下，没有能展开、能观看那书卷的。"]},{"type":"verse","number":4,"content":["因为没有配展开、配观看那书卷的，我就大哭。"]},{"type":"verse","number":5,"content":["长老中有一位对我说：「不要哭！看哪，犹大支派中的狮子，大卫的根，他已得胜，能以展开那书卷，揭开那七印。」"]},{"type":"verse","number":6,"content":["我又看见宝座与四活物，并长老之中有羔羊站立，像是被杀过的，有七角七眼，就是 神的七灵，奉差遣往普天下去的。"]},{"type":"verse","number":7,"content":["这羔羊前来，从坐宝座的右手里拿了书卷。"]},{"type":"verse","number":8,"content":["他既拿了书卷，四活物和二十四位长老就俯伏在羔羊面前，各拿着琴和盛满了香的金炉；这香就是众圣徒的祈祷。"]},{"type":"verse","number":9,"content":["他们唱新歌，说：",{"text":"你配拿书卷，","poem":1},{"lineBreak":true},{"text":"配揭开七印；","poem":1},{"lineBreak":true},{"text":"因为你曾被杀，","poem":1},{"lineBreak":true},{"text":"用自己的血","poem":1},{"lineBreak":true},{"text":"从各族、各方、各民、各国中买了人来，","poem":1},{"lineBreak":true},{"text":"叫他们归于 神，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"又叫他们成为国民，","poem":1},{"lineBreak":true},{"text":"作祭司归于 神，","poem":1},{"lineBreak":true},{"text":"在地上执掌王权。","poem":1}]},{"type":"verse","number":11,"content":["我又看见且听见，宝座与活物并长老的周围有许多天使的声音；他们的数目有千千万万，"]},{"type":"verse","number":12,"content":["大声说：",{"text":"曾被杀的羔羊是配得","poem":1},{"lineBreak":true},{"text":"权柄、丰富、智慧、能力、","poem":1},{"lineBreak":true},{"text":"尊贵、荣耀、颂赞的。","poem":1}]},{"type":"verse","number":13,"content":["我又听见在天上、地上、地底下、沧海里，和天地间一切所有被造之物，都说：",{"text":"但愿颂赞、尊贵、荣耀、权势","poem":1},{"lineBreak":true},{"text":"都归给坐宝座的和羔羊，","poem":1},{"lineBreak":true},{"text":"直到永永远远！","poem":1}]},{"type":"verse","number":14,"content":["四活物就说：「阿们！」众长老也俯伏敬拜。"]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/REV/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/REV/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/REV/4.json","previousChapterAudioLinks":{},"numberOfVerses":14}