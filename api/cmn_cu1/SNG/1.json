{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cu1","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"10bb0e2a77f8d37a19a6f3fb78325c237b87dab541514107917c9722d57669a1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cu1/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["所罗门的歌，是歌中的雅歌。"]},{"type":"heading","content":["第一首"]},{"type":"verse","number":2,"content":[{"text":"愿他用口与我亲嘴；","poem":1},{"lineBreak":true},{"text":"因你的爱情比酒更美。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的膏油馨香；","poem":1},{"lineBreak":true},{"text":"你的名如同倒出来的香膏，","poem":1},{"lineBreak":true},{"text":"所以众童女都爱你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"愿你吸引我，我们就快跑跟随你。","poem":1},{"lineBreak":true},{"text":"王带我进了内室，","poem":1},{"lineBreak":true},{"text":"我们必因你欢喜快乐。","poem":1},{"lineBreak":true},{"text":"我们要称赞你的爱情，","poem":1},{"lineBreak":true},{"text":"胜似称赞美酒。","poem":1},{"lineBreak":true},{"text":"他们爱你是理所当然的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶路撒冷的众女子啊，","poem":1},{"lineBreak":true},{"text":"我虽然黑，却是秀美，","poem":1},{"lineBreak":true},{"text":"如同基达的帐棚，","poem":1},{"lineBreak":true},{"text":"好像所罗门的幔子。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"不要因日头把我晒黑了就轻看我。","poem":1},{"lineBreak":true},{"text":"我同母的弟兄向我发怒，","poem":1},{"lineBreak":true},{"text":"他们使我看守葡萄园；","poem":1},{"lineBreak":true},{"text":"我自己的葡萄园却没有看守。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我心所爱的啊，求你告诉我，","poem":1},{"lineBreak":true},{"text":"你在何处牧羊？","poem":1},{"lineBreak":true},{"text":"晌午在何处使羊歇卧？","poem":1},{"lineBreak":true},{"text":"我何必在你同伴的羊群旁边","poem":1},{"lineBreak":true},{"text":"好像蒙着脸的人呢？","poem":1}]},{"type":"verse","number":8,"content":[{"text":"你这女子中极美丽的，","poem":1},{"lineBreak":true},{"text":"你若不知道，","poem":1},{"lineBreak":true},{"text":"只管跟随羊群的脚踪去，","poem":1},{"lineBreak":true},{"text":"把你的山羊羔牧放在牧人帐棚的旁边。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的佳偶，","poem":1},{"lineBreak":true},{"text":"我将你比法老车上套的骏马。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你的两腮因发辫而秀美；","poem":1},{"lineBreak":true},{"text":"你的颈项因珠串而华丽。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我们要为你编上金辫，镶上银钉。","poem":1}]},{"type":"verse","number":12,"content":[{"text":"王正坐席的时候，","poem":1},{"lineBreak":true},{"text":"我的哪哒香膏发出香味。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我以我的良人为一袋没药，","poem":1},{"lineBreak":true},{"text":"常在我怀中。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我以我的良人为一棵凤仙花，","poem":1},{"lineBreak":true},{"text":"在隐·基底葡萄园中。","poem":1}]},{"type":"verse","number":15,"content":[{"text":"我的佳偶，你甚美丽！你甚美丽！","poem":1},{"lineBreak":true},{"text":"你的眼好像鸽子眼。","poem":1}]},{"type":"verse","number":16,"content":[{"text":"我的良人哪，你甚美丽可爱！","poem":1},{"lineBreak":true},{"text":"我们以青草为床榻，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"以香柏树为房屋的栋梁，","poem":1},{"lineBreak":true},{"text":"以松树为椽子。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}