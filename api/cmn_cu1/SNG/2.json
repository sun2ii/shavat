{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cu1","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"10bb0e2a77f8d37a19a6f3fb78325c237b87dab541514107917c9722d57669a1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cu1/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"我是沙 的玫瑰花","poem":1},{"noteId":0},{"text":"，","poem":1},{"lineBreak":true},{"text":"是谷中的百合花。","poem":1}]},{"type":"verse","number":2,"content":[{"text":"我的佳偶在女子中，","poem":1},{"lineBreak":true},{"text":"好像百合花在荆棘内。","poem":1}]},{"type":"verse","number":3,"content":[{"text":"我的良人在男子中，","poem":1},{"lineBreak":true},{"text":"如同苹果树在树林中。","poem":1},{"lineBreak":true},{"text":"我欢欢喜喜坐在他的荫下，","poem":1},{"lineBreak":true},{"text":"尝他果子的滋味，觉得甘甜。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他带我入筵宴所，","poem":1},{"lineBreak":true},{"text":"以爱为旗在我以上。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"求你们给我葡萄干增补我力，","poem":1},{"lineBreak":true},{"text":"给我苹果畅快我心，","poem":1},{"lineBreak":true},{"text":"因我思爱成病。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他的左手在我头下；","poem":1},{"lineBreak":true},{"text":"他的右手将我抱住。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶路撒冷的众女子啊，","poem":1},{"lineBreak":true},{"text":"我指着羚羊或田野的母鹿嘱咐你们：","poem":1},{"lineBreak":true},{"text":"不要惊动、不要叫醒我所亲爱的，","poem":1},{"lineBreak":true},{"text":"等他自己情愿","poem":1},{"noteId":1},{"text":"。","poem":1}]},{"type":"heading","content":["第二首"]},{"type":"verse","number":8,"content":[{"text":"听啊！是我良人的声音；","poem":1},{"lineBreak":true},{"text":"看哪！他蹿山越岭而来。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的良人好像羚羊，或像小鹿。","poem":1},{"lineBreak":true},{"text":"他站在我们墙壁后，","poem":1},{"lineBreak":true},{"text":"从窗户往里观看，","poem":1},{"lineBreak":true},{"text":"从窗棂往里窥探。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我良人对我说：","poem":1},"〔新郎〕",{"text":"我的佳偶，我的美人，","poem":1},{"lineBreak":true},{"text":"起来，与我同去！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因为冬天已往，","poem":1},{"lineBreak":true},{"text":"雨水止住过去了。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"地上百花开放，","poem":1},{"lineBreak":true},{"text":"百鸟鸣叫的时候","poem":1},{"noteId":2},{"text":"已经来到；","poem":1},{"lineBreak":true},{"text":"斑鸠的声音在我们境内也听见了。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"无花果树的果子渐渐成熟；","poem":1},{"lineBreak":true},{"text":"葡萄树开花放香。","poem":1},{"lineBreak":true},{"text":"我的佳偶，我的美人，","poem":1},{"lineBreak":true},{"text":"起来，与我同去！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我的鸽子啊，你在磐石穴中，","poem":1},{"lineBreak":true},{"text":"在陡岩的隐密处。","poem":1},{"lineBreak":true},{"text":"求你容我得见你的面貌，","poem":1},{"lineBreak":true},{"text":"得听你的声音；","poem":1},{"lineBreak":true},{"text":"因为你的声音柔和，","poem":1},{"lineBreak":true},{"text":"你的面貌秀美。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"要给我们擒拿狐狸，","poem":1},{"lineBreak":true},{"text":"就是毁坏葡萄园的小狐狸，","poem":1},{"lineBreak":true},{"text":"因为我们的葡萄正在开花。","poem":1}]},{"type":"verse","number":16,"content":[{"text":"良人属我，我也属他；","poem":1},{"lineBreak":true},{"text":"他在百合花中牧放群羊。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的良人哪，","poem":1},{"lineBreak":true},{"text":"求你等到天起凉风、","poem":1},{"lineBreak":true},{"text":"日影飞去的时候，","poem":1},{"lineBreak":true},{"text":"你要转回，好像羚羊，","poem":1},{"lineBreak":true},{"text":"或像小鹿在比特山上。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"或译：水仙花","reference":{"chapter":2,"verse":1}},{"noteId":1,"caller":"-","text":"不要叫醒......情愿：或译不要激动爱情，等它自发","reference":{"chapter":2,"verse":7}},{"noteId":2,"caller":"-","text":"或译：修理葡萄树的时候","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/cmn_cu1/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}