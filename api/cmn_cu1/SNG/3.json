{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cu1","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"10bb0e2a77f8d37a19a6f3fb78325c237b87dab541514107917c9722d57669a1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cu1/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"我夜间躺卧在床上，","poem":1},{"lineBreak":true},{"text":"寻找我心所爱的；","poem":1},{"lineBreak":true},{"text":"我寻找他，却寻不见。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我说：我要起来，游行城中，","poem":1},{"lineBreak":true},{"text":"在街市上，在宽阔处，","poem":1},{"lineBreak":true},{"text":"寻找我心所爱的。","poem":1},{"lineBreak":true},{"text":"我寻找他，却寻不见。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"城中巡逻看守的人遇见我；","poem":1},{"lineBreak":true},{"text":"我问他们：你们看见我心所爱的没有？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我刚离开他们就遇见我心所爱的。","poem":1},{"lineBreak":true},{"text":"我拉住他，不容他走，","poem":1},{"lineBreak":true},{"text":"领他入我母家，","poem":1},{"lineBreak":true},{"text":"到怀我者的内室。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶路撒冷的众女子啊，","poem":1},{"lineBreak":true},{"text":"我指着羚羊或田野的母鹿嘱咐你们：","poem":1},{"lineBreak":true},{"text":"不要惊动、不要叫醒我所亲爱的，","poem":1},{"lineBreak":true},{"text":"等他自己情愿","poem":1},{"noteId":3},{"text":"。","poem":1}]},{"type":"heading","content":["第三首"]},{"type":"verse","number":6,"content":[{"text":"那从旷野上来、形状如烟柱、","poem":1},{"lineBreak":true},{"text":"以没药和乳香并商人各样香粉薰的是谁呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"看哪，是所罗门的轿；","poem":1},{"lineBreak":true},{"text":"四围有六十个勇士，","poem":1},{"lineBreak":true},{"text":"都是以色列中的勇士；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"手都持刀，善于争战，","poem":1},{"lineBreak":true},{"text":"腰间佩刀，防备夜间有惊慌。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"所罗门王用黎巴嫩木","poem":1},{"lineBreak":true},{"text":"为自己制造一乘华轿。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"轿柱是用银做的，","poem":1},{"lineBreak":true},{"text":"轿底是用金做的；","poem":1},{"lineBreak":true},{"text":"坐垫是紫色的，","poem":1},{"lineBreak":true},{"text":"其中所铺的乃耶路撒冷众女子的爱情。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"锡安的众女子啊，","poem":1},{"lineBreak":true},{"text":"你们出去观看所罗门王！","poem":1},{"lineBreak":true},{"text":"头戴冠冕，就是在他婚筵的日子、","poem":1},{"lineBreak":true},{"text":"心中喜乐的时候，他母亲给他戴上的。","poem":1}]}],"footnotes":[{"noteId":3,"caller":"-","text":"不要叫醒......情愿：或译不要激动爱情，等它自发","reference":{"chapter":3,"verse":5}}]},"thisChapterLink":"/api/cmn_cu1/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}