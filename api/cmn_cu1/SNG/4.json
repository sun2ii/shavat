{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cu1","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"10bb0e2a77f8d37a19a6f3fb78325c237b87dab541514107917c9722d57669a1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cu1/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"我的佳偶，你甚美丽！你甚美丽！","poem":1},{"lineBreak":true},{"text":"你的眼在帕子内好像鸽子眼。","poem":1},{"lineBreak":true},{"text":"你的头发如同山羊群卧在基列山旁。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你的牙齿如新剪毛的一群母羊，","poem":1},{"lineBreak":true},{"text":"洗净上来，个个都有双生，","poem":1},{"lineBreak":true},{"text":"没有一只丧掉子的。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的唇好像一条朱红线；","poem":1},{"lineBreak":true},{"text":"你的嘴也秀美。","poem":1},{"lineBreak":true},{"text":"你的两太阳在帕子内，","poem":1},{"lineBreak":true},{"text":"如同一块石榴。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的颈项好像大卫建造收藏军器的高台，","poem":1},{"lineBreak":true},{"text":"其上悬挂一千盾牌，","poem":1},{"lineBreak":true},{"text":"都是勇士的藤牌。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的两乳好像百合花中吃草的一对小鹿，","poem":1},{"lineBreak":true},{"text":"就是母鹿双生的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我要往没药山和乳香冈去，","poem":1},{"lineBreak":true},{"text":"直等到天起凉风、","poem":1},{"lineBreak":true},{"text":"日影飞去的时候回来。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的佳偶，你全然美丽，","poem":1},{"lineBreak":true},{"text":"毫无瑕疵！","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我的新妇，求你与我一同离开黎巴嫩，","poem":1},{"lineBreak":true},{"text":"与我一同离开黎巴嫩。","poem":1},{"lineBreak":true},{"text":"从亚玛拿顶，","poem":1},{"lineBreak":true},{"text":"从示尼珥与黑门顶，","poem":1},{"lineBreak":true},{"text":"从有狮子的洞，","poem":1},{"lineBreak":true},{"text":"从有豹子的山往下观看。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我妹子，我新妇，","poem":1},{"lineBreak":true},{"text":"你夺了我的心。","poem":1},{"lineBreak":true},{"text":"你用眼一看，","poem":1},{"lineBreak":true},{"text":"用你项上的一条金链，","poem":1},{"lineBreak":true},{"text":"夺了我的心！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我妹子，我新妇，","poem":1},{"lineBreak":true},{"text":"你的爱情何其美！","poem":1},{"lineBreak":true},{"text":"你的爱情比酒更美！","poem":1},{"lineBreak":true},{"text":"你膏油的香气胜过一切香品！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我新妇，你的嘴唇滴蜜，","poem":1},{"lineBreak":true},{"text":"好像蜂房滴蜜；","poem":1},{"lineBreak":true},{"text":"你的舌下有蜜，有奶。","poem":1},{"lineBreak":true},{"text":"你衣服的香气如黎巴嫩的香气。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我妹子，我新妇，","poem":1},{"lineBreak":true},{"text":"乃是关锁的园，","poem":1},{"lineBreak":true},{"text":"禁闭的井，封闭的泉源。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你园内所种的结了石榴，","poem":1},{"lineBreak":true},{"text":"有佳美的果子，","poem":1},{"lineBreak":true},{"text":"并凤仙花与哪哒树。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"有哪哒和番红花，","poem":1},{"lineBreak":true},{"text":"菖蒲和桂树，","poem":1},{"lineBreak":true},{"text":"并各样乳香木、没药、沉香，","poem":1},{"lineBreak":true},{"text":"与一切上等的果品。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你是园中的泉，活水的井，","poem":1},{"lineBreak":true},{"text":"从黎巴嫩流下来的溪水。","poem":1}]},{"type":"verse","number":16,"content":[{"text":"北风啊，兴起！","poem":1},{"lineBreak":true},{"text":"南风啊，吹来！","poem":1},{"lineBreak":true},{"text":"吹在我的园内，","poem":1},{"lineBreak":true},{"text":"使其中的香气发出来。","poem":1},{"lineBreak":true},{"text":"愿我的良人进入自己园里，","poem":1},{"lineBreak":true},{"text":"吃他佳美的果子。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}