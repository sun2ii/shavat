{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cu1","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"10bb0e2a77f8d37a19a6f3fb78325c237b87dab541514107917c9722d57669a1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cu1/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"我妹子，我新妇，","poem":1},{"lineBreak":true},{"text":"我进了我的园中，","poem":1},{"lineBreak":true},{"text":"采了我的没药和香料，","poem":1},{"lineBreak":true},{"text":"吃了我的蜜房和蜂蜜，","poem":1},{"lineBreak":true},{"text":"喝了我的酒和奶。","poem":1},"〔耶路撒冷的众女子〕",{"text":"我的朋友们，请吃！","poem":1},{"lineBreak":true},{"text":"我所亲爱的，请喝，且多多地喝！","poem":1}]},{"type":"heading","content":["第四首"]},{"type":"verse","number":2,"content":[{"text":"我身睡卧，我心却醒。","poem":1},{"lineBreak":true},{"text":"这是我良人的声音；","poem":1},{"lineBreak":true},{"text":"他敲门说：","poem":1},"〔新郎〕",{"text":"我的妹子，我的佳偶，","poem":1},{"lineBreak":true},{"text":"我的鸽子，我的完全人，","poem":1},{"lineBreak":true},{"text":"求你给我开门；","poem":1},{"lineBreak":true},{"text":"因我的头满了露水，","poem":1},{"lineBreak":true},{"text":"我的头发被夜露滴湿。","poem":1}]},{"type":"verse","number":3,"content":[{"text":"我回答说：","poem":1},{"lineBreak":true},{"text":"我脱了衣裳，怎能再穿上呢？","poem":1},{"lineBreak":true},{"text":"我洗了脚，怎能再玷污呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的良人从门孔里伸进手来，","poem":1},{"lineBreak":true},{"text":"我便因他动了心。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我起来，要给我良人开门。","poem":1},{"lineBreak":true},{"text":"我的两手滴下没药；","poem":1},{"lineBreak":true},{"text":"我的指头有没药汁滴在门闩上。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我给我的良人开了门；","poem":1},{"lineBreak":true},{"text":"我的良人却已转身走了。","poem":1},{"lineBreak":true},{"text":"他说话的时候，我神不守舍；","poem":1},{"lineBreak":true},{"text":"我寻找他，竟寻不见；","poem":1},{"lineBreak":true},{"text":"我呼叫他，他却不回答。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"城中巡逻看守的人遇见我，","poem":1},{"lineBreak":true},{"text":"打了我，伤了我；","poem":1},{"lineBreak":true},{"text":"看守城墙的人夺去我的披肩。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶路撒冷的众女子啊，我嘱咐你们：","poem":1},{"lineBreak":true},{"text":"若遇见我的良人，","poem":1},{"lineBreak":true},{"text":"要告诉他，我因思爱成病。","poem":1}]},{"type":"verse","number":9,"content":[{"text":"你这女子中极美丽的，","poem":1},{"lineBreak":true},{"text":"你的良人比别人的良人有何强处？","poem":1},{"lineBreak":true},{"text":"你的良人比别人的良人有何强处，","poem":1},{"lineBreak":true},{"text":"你就这样嘱咐我们？","poem":1}]},{"type":"verse","number":10,"content":[{"text":"我的良人白而且红，","poem":1},{"lineBreak":true},{"text":"超乎万人之上。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他的头像至精的金子；","poem":1},{"lineBreak":true},{"text":"他的头发厚密累垂，黑如乌鸦。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他的眼如溪水旁的鸽子眼，","poem":1},{"lineBreak":true},{"text":"用奶洗净，安得合式。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他的两腮如香花畦，","poem":1},{"lineBreak":true},{"text":"如香草台；","poem":1},{"lineBreak":true},{"text":"他的嘴唇像百合花，","poem":1},{"lineBreak":true},{"text":"且滴下没药汁。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他的两手好像金管，","poem":1},{"lineBreak":true},{"text":"镶嵌水苍玉；","poem":1},{"lineBreak":true},{"text":"他的身体如同雕刻的象牙，","poem":1},{"lineBreak":true},{"text":"周围镶嵌蓝宝石。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他的腿好像白玉石柱，","poem":1},{"lineBreak":true},{"text":"安在精金座上；","poem":1},{"lineBreak":true},{"text":"他的形状如黎巴嫩，","poem":1},{"lineBreak":true},{"text":"且佳美如香柏树。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他的口极其甘甜；","poem":1},{"lineBreak":true},{"text":"他全然可爱。","poem":1},{"lineBreak":true},{"text":"耶路撒冷的众女子啊，","poem":1},{"lineBreak":true},{"text":"这是我的良人；","poem":1},{"lineBreak":true},{"text":"这是我的朋友。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}