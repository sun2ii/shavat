{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cu1","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"10bb0e2a77f8d37a19a6f3fb78325c237b87dab541514107917c9722d57669a1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cu1/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"你这女子中极美丽的，","poem":1},{"lineBreak":true},{"text":"你的良人往何处去了？","poem":1},{"lineBreak":true},{"text":"你的良人转向何处去了，","poem":1},{"lineBreak":true},{"text":"我们好与你同去寻找他。","poem":1}]},{"type":"verse","number":2,"content":[{"text":"我的良人下入自己园中，","poem":1},{"lineBreak":true},{"text":"到香花畦，","poem":1},{"lineBreak":true},{"text":"在园内牧放群羊，","poem":1},{"lineBreak":true},{"text":"采百合花。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我属我的良人，","poem":1},{"lineBreak":true},{"text":"我的良人也属我；","poem":1},{"lineBreak":true},{"text":"他在百合花中牧放群羊。","poem":1}]},{"type":"heading","content":["第五首"]},{"type":"verse","number":4,"content":[{"text":"我的佳偶啊，你美丽如得撒，","poem":1},{"lineBreak":true},{"text":"秀美如耶路撒冷，","poem":1},{"lineBreak":true},{"text":"威武如展开旌旗的军队。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"求你掉转眼目不看我，","poem":1},{"lineBreak":true},{"text":"因你的眼目使我惊乱。","poem":1},{"lineBreak":true},{"text":"你的头发如同山羊群卧在基列山旁。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你的牙齿如一群母羊","poem":1},{"lineBreak":true},{"text":"洗净上来，个个都有双生，","poem":1},{"lineBreak":true},{"text":"没有一只丧掉子的。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的两太阳在帕子内，","poem":1},{"lineBreak":true},{"text":"如同一块石榴。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"有六十王后八十妃嫔，","poem":1},{"lineBreak":true},{"text":"并有无数的童女。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的鸽子，我的完全人，","poem":1},{"lineBreak":true},{"text":"只有这一个是她母亲独生的，","poem":1},{"lineBreak":true},{"text":"是生养她者所宝爱的。","poem":1},{"lineBreak":true},{"text":"众女子见了就称她有福；","poem":1},{"lineBreak":true},{"text":"王后妃嫔见了也赞美她。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"那向外观看、如晨光发现、","poem":1},{"lineBreak":true},{"text":"美丽如月亮、皎洁如日头、","poem":1},{"lineBreak":true},{"text":"威武如展开旌旗军队的是谁呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我下入核桃园，","poem":1},{"lineBreak":true},{"text":"要看谷中青绿的植物，","poem":1},{"lineBreak":true},{"text":"要看葡萄发芽没有，","poem":1},{"lineBreak":true},{"text":"石榴开花没有。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"不知不觉，","poem":1},{"lineBreak":true},{"text":"我的心将我安置在我尊长的车中。","poem":1}]},{"type":"verse","number":13,"content":[{"text":"回来，回来，书拉密女；","poem":1},{"lineBreak":true},{"text":"你回来，你回来，使我们得观看你。","poem":1},"〔新娘〕",{"text":"你们为何要观看书拉密女，","poem":1},{"lineBreak":true},{"text":"像观看玛哈念跳舞的呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}