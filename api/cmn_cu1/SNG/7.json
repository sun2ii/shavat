{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cu1","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"10bb0e2a77f8d37a19a6f3fb78325c237b87dab541514107917c9722d57669a1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cu1/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"王女啊，你的脚在鞋中何其美好！","poem":1},{"lineBreak":true},{"text":"你的大腿圆润，好像美玉，","poem":1},{"lineBreak":true},{"text":"是巧匠的手做成的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你的肚脐如圆杯，","poem":1},{"lineBreak":true},{"text":"不缺调和的酒；","poem":1},{"lineBreak":true},{"text":"你的腰如一堆麦子，","poem":1},{"lineBreak":true},{"text":"周围有百合花。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的两乳好像一对小鹿，","poem":1},{"lineBreak":true},{"text":"就是母鹿双生的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的颈项如象牙台；","poem":1},{"lineBreak":true},{"text":"你的眼目像希实本、巴特·拉并门旁的水池；","poem":1},{"lineBreak":true},{"text":"你的鼻子仿佛朝大马士革的黎巴嫩塔。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的头在你身上好像迦密山；","poem":1},{"lineBreak":true},{"text":"你头上的发是紫黑色；","poem":1},{"lineBreak":true},{"text":"王的心因这下垂的发绺系住了。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我所爱的，你何其美好！","poem":1},{"lineBreak":true},{"text":"何其可悦，使人欢畅喜乐！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的身量好像棕树；","poem":1},{"lineBreak":true},{"text":"你的两乳如同其上的果子，累累下垂。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我说：我要上这棕树，抓住枝子。","poem":1},{"lineBreak":true},{"text":"愿你的两乳好像葡萄累累下垂，","poem":1},{"lineBreak":true},{"text":"你鼻子的气味香如苹果；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你的口如上好的酒。","poem":1},"〔新娘〕",{"text":"女子说：为我的良人下咽舒畅，","poem":1},{"lineBreak":true},{"text":"流入睡觉人的嘴中。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我属我的良人，","poem":1},{"lineBreak":true},{"text":"他也恋慕我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的良人，来吧！","poem":1},{"lineBreak":true},{"text":"你我可以往田间去；","poem":1},{"lineBreak":true},{"text":"你我可以在村庄住宿。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我们早晨起来往葡萄园去，","poem":1},{"lineBreak":true},{"text":"看看葡萄发芽开花没有，","poem":1},{"lineBreak":true},{"text":"石榴放蕊没有；","poem":1},{"lineBreak":true},{"text":"我在那里要将我的爱情给你。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"风茄放香，","poem":1},{"lineBreak":true},{"text":"在我们的门内有各样新陈佳美的果子；","poem":1},{"lineBreak":true},{"text":"我的良人，这都是我为你存留的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cu1/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}