{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cu1","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"10bb0e2a77f8d37a19a6f3fb78325c237b87dab541514107917c9722d57669a1","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cu1/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"巴不得你像我的兄弟，","poem":1},{"lineBreak":true},{"text":"像吃我母亲奶的兄弟；","poem":1},{"lineBreak":true},{"text":"我在外头遇见你就与你亲嘴，","poem":1},{"lineBreak":true},{"text":"谁也不轻看我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我必引导你，","poem":1},{"lineBreak":true},{"text":"领你进我母亲的家；","poem":1},{"lineBreak":true},{"text":"我可以领受教训，","poem":1},{"lineBreak":true},{"text":"也就使你喝石榴汁酿的香酒。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他的左手必在我头下；","poem":1},{"lineBreak":true},{"text":"他的右手必将我抱住。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶路撒冷的众女子啊，","poem":1},{"lineBreak":true},{"text":"我嘱咐你们：","poem":1},{"lineBreak":true},{"text":"不要惊动、不要叫醒我所亲爱的，","poem":1},{"lineBreak":true},{"text":"等他自己情愿","poem":1},{"noteId":4},{"text":"。","poem":1}]},{"type":"heading","content":["第六首"]},{"type":"verse","number":5,"content":[{"text":"那靠着良人从旷野上来的是谁呢？","poem":1},"〔新娘〕",{"text":"我在苹果树下叫醒你。","poem":1},{"lineBreak":true},{"text":"你母亲在那里为你劬劳；","poem":1},{"lineBreak":true},{"text":"生养你的在那里为你劬劳。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你将我放在你心上如印记，","poem":1},{"lineBreak":true},{"text":"带在你臂上如戳记。","poem":1},{"lineBreak":true},{"text":"因为爱情如死之坚强，","poem":1},{"lineBreak":true},{"text":"嫉恨如阴间之残忍；","poem":1},{"lineBreak":true},{"text":"所发的电光是火焰的电光，","poem":1},{"lineBreak":true},{"text":"是耶和华的烈焰。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"爱情，众水不能息灭，","poem":1},{"lineBreak":true},{"text":"大水也不能淹没。","poem":1},{"lineBreak":true},{"text":"若有人拿家中所有的财宝要换爱情，","poem":1},{"lineBreak":true},{"text":"就全被藐视。","poem":1}]},{"type":"verse","number":8,"content":[{"text":"我们有一小妹；","poem":1},{"lineBreak":true},{"text":"她的两乳尚未长成，","poem":1},{"lineBreak":true},{"text":"人来提亲的日子，","poem":1},{"lineBreak":true},{"text":"我们当为她怎样办理？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"她若是墙，","poem":1},{"lineBreak":true},{"text":"我们要在其上建造银塔；","poem":1},{"lineBreak":true},{"text":"她若是门，","poem":1},{"lineBreak":true},{"text":"我们要用香柏木板围护她。","poem":1}]},{"type":"verse","number":10,"content":[{"text":"我是墙；","poem":1},{"lineBreak":true},{"text":"我两乳像其上的楼。","poem":1},{"lineBreak":true},{"text":"那时，我在他眼中像得平安的人。","poem":1}]},{"type":"verse","number":11,"content":[{"text":"所罗门在巴力·哈们有一葡萄园；","poem":1},{"lineBreak":true},{"text":"他将这葡萄园交给看守的人，","poem":1},{"lineBreak":true},{"text":"为其中的果子必交一千舍客勒银子。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我自己的葡萄园在我面前。","poem":1},{"lineBreak":true},{"text":"所罗门哪，一千舍客勒归你，","poem":1},{"lineBreak":true},{"text":"二百舍客勒归看守果子的人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你这住在园中的，","poem":1},{"lineBreak":true},{"text":"同伴都要听你的声音，","poem":1},{"lineBreak":true},{"text":"求你使我也得听见。","poem":1}]},{"type":"verse","number":14,"content":[{"text":"我的良人哪，求你快来！","poem":1},{"lineBreak":true},{"text":"如羚羊或小鹿在香草山上。","poem":1}]}],"footnotes":[{"noteId":4,"caller":"-","text":"不要叫醒......情愿：或译不要激动爱情，等它自发","reference":{"chapter":8,"verse":4}}]},"thisChapterLink":"/api/cmn_cu1/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}