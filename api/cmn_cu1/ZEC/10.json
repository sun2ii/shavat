{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ZEC","translationId":"cmn_cu1","name":"撒迦利亚书","commonName":"撒迦利亚书","title":"撒迦利亚书","order":38,"numberOfChapters":14,"sha256":"feb08b9a448a6d8849ead791b305b99aa373ff61cc0aae0e1cd0cc54993789dc","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cu1/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["耶和华应许解救"]},{"type":"verse","number":1,"content":[{"text":"当春雨的时候，","poem":1},{"lineBreak":true},{"text":"你们要向发闪电的耶和华求雨。","poem":1},{"lineBreak":true},{"text":"他必为众人降下甘霖，","poem":1},{"lineBreak":true},{"text":"使田园生长菜蔬。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因为，家神所言的是虚空；","poem":1},{"lineBreak":true},{"text":"卜士所见的是虚假；","poem":1},{"lineBreak":true},{"text":"做梦者所说的是假梦。","poem":1},{"lineBreak":true},{"text":"他们白白地安慰人，","poem":1},{"lineBreak":true},{"text":"所以众人如羊流离，","poem":1},{"lineBreak":true},{"text":"因无牧人就受苦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"我的怒气向牧人发作；","poem":1},{"lineBreak":true},{"text":"我必惩罚公山羊；","poem":1},{"lineBreak":true},{"text":"因我—万军之耶和华","poem":1},{"lineBreak":true},{"text":"眷顾自己的羊群，就是犹大家，","poem":1},{"lineBreak":true},{"text":"必使他们如骏马在阵上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"房角石、钉子、争战的弓，","poem":1},{"lineBreak":true},{"text":"和一切掌权的都从他而出。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他们必如勇士在阵上","poem":1},{"lineBreak":true},{"text":"将仇敌践踏在街上的泥土中。","poem":1},{"lineBreak":true},{"text":"他们必争战，因为耶和华与他们同在；","poem":1},{"lineBreak":true},{"text":"骑马的也必羞愧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我要坚固犹大家，拯救约瑟家，","poem":1},{"lineBreak":true},{"text":"要领他们归回。","poem":1},{"lineBreak":true},{"text":"我要怜恤他们；","poem":1},{"lineBreak":true},{"text":"他们必像未曾弃绝的一样，","poem":1},{"lineBreak":true},{"text":"都因我是耶和华—他们的 神，","poem":1},{"lineBreak":true},{"text":"我必应允他们的祷告。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"以法莲人必如勇士；","poem":1},{"lineBreak":true},{"text":"他们心中畅快如同喝酒；","poem":1},{"lineBreak":true},{"text":"他们的儿女必看见而快活；","poem":1},{"lineBreak":true},{"text":"他们的心必因耶和华喜乐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我要发嘶声，聚集他们，","poem":1},{"lineBreak":true},{"text":"因我已经救赎他们。","poem":1},{"lineBreak":true},{"text":"他们的人数必加增，","poem":1},{"lineBreak":true},{"text":"如从前加增一样。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我虽然","poem":1},{"noteId":13},{"text":"播散他们在列国中，","poem":1},{"lineBreak":true},{"text":"他们必在远方记念我。","poem":1},{"lineBreak":true},{"text":"他们与儿女都必存活，且得归回。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我必再领他们出埃及地，","poem":1},{"lineBreak":true},{"text":"招聚他们出亚述，","poem":1},{"lineBreak":true},{"text":"领他们到基列和黎巴嫩；","poem":1},{"lineBreak":true},{"text":"这地尚且不够他们居住。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华必经过苦海，击打海浪，","poem":1},{"lineBreak":true},{"text":"使尼罗河的深处都枯干。","poem":1},{"lineBreak":true},{"text":"亚述的骄傲必致卑微；","poem":1},{"lineBreak":true},{"text":"埃及的权柄必然灭没。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我必使他们倚靠我，得以坚固；","poem":1},{"lineBreak":true},{"text":"一举一动必奉我的名。","poem":1},{"lineBreak":true},{"text":"这是耶和华说的。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"或译：必","reference":{"chapter":10,"verse":9}}]},"thisChapterLink":"/api/cmn_cu1/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}