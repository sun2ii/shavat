{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ZEC","translationId":"cmn_cu1","name":"撒迦利亚书","commonName":"撒迦利亚书","title":"撒迦利亚书","order":38,"numberOfChapters":14,"sha256":"feb08b9a448a6d8849ead791b305b99aa373ff61cc0aae0e1cd0cc54993789dc","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cu1/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["审判邻国"]},{"type":"verse","number":1,"content":["耶和华的默示应验在哈得拉地大马士革",{"text":"—世人和以色列各支派的眼目都仰望耶和华—","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"和靠近的哈马，并泰尔、西顿；","poem":1},{"lineBreak":true},{"text":"因为这二城的人大有智慧。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"泰尔为自己修筑保障，","poem":1},{"lineBreak":true},{"text":"积蓄银子如尘沙，","poem":1},{"lineBreak":true},{"text":"堆起精金如街上的泥土。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"主必赶出她，","poem":1},{"lineBreak":true},{"text":"打败她海上的权利；","poem":1},{"lineBreak":true},{"text":"她必被火烧灭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"亚实基伦看见必惧怕；","poem":1},{"lineBreak":true},{"text":"迦萨看见甚痛苦；","poem":1},{"lineBreak":true},{"text":"以革伦因失了盼望蒙羞。","poem":1},{"lineBreak":true},{"text":"迦萨必不再有君王；","poem":1},{"lineBreak":true},{"text":"亚实基伦也不再有居民。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"私生子","poem":1},{"noteId":10},{"text":"必住在亚实突；","poem":1},{"lineBreak":true},{"text":"我必除灭非利士人的骄傲。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我必除去他口中带血之肉","poem":1},{"lineBreak":true},{"text":"和牙齿内可憎之物。","poem":1},{"lineBreak":true},{"text":"他必作为余剩的人归与我们的 神，","poem":1},{"lineBreak":true},{"text":"必在犹大像族长；","poem":1},{"lineBreak":true},{"text":"以革伦人必如耶布斯人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我必在我家的四围安营，","poem":1},{"lineBreak":true},{"text":"使敌军不得任意往来，","poem":1},{"lineBreak":true},{"text":"暴虐的人也不再经过，","poem":1},{"lineBreak":true},{"text":"因为我亲眼看顾我的家。","poem":1}]},{"type":"heading","content":["未来的君王"]},{"type":"verse","number":9,"content":[{"text":"锡安的民哪，应当大大喜乐；","poem":1},{"lineBreak":true},{"text":"耶路撒冷的民哪，应当欢呼。","poem":1},{"lineBreak":true},{"text":"看哪，你的王来到你这里！","poem":1},{"lineBreak":true},{"text":"他是公义的，并且施行拯救，","poem":1},{"lineBreak":true},{"text":"谦谦和和地骑着驴，","poem":1},{"lineBreak":true},{"text":"就是骑着驴的驹子。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我必除灭以法莲的战车","poem":1},{"lineBreak":true},{"text":"和耶路撒冷的战马；","poem":1},{"lineBreak":true},{"text":"争战的弓也必除灭。","poem":1},{"lineBreak":true},{"text":"他必向列国讲和平；","poem":1},{"lineBreak":true},{"text":"他的权柄必从这海管到那海，","poem":1},{"lineBreak":true},{"text":"从大河管到地极。","poem":1}]},{"type":"heading","content":["神子民的复兴"]},{"type":"verse","number":11,"content":[{"text":"锡安哪，我因与你立约的血，","poem":1},{"lineBreak":true},{"text":"将你中间被掳而囚的人从无水的坑中释放出来。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你们被囚而有指望的人都要转回保障。","poem":1},{"lineBreak":true},{"text":"我今日说明，我必加倍赐福给你们。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我拿犹大作上弦的弓；","poem":1},{"lineBreak":true},{"text":"我拿以法莲为张弓的箭。","poem":1},{"lineBreak":true},{"text":"锡安哪，我要激发你的众子，","poem":1},{"lineBreak":true},{"text":"攻击希腊","poem":1},{"noteId":11},{"text":"的众子，使你如勇士的刀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"耶和华必显现在他们以上；","poem":1},{"lineBreak":true},{"text":"他的箭必射出像闪电。","poem":1},{"lineBreak":true},{"text":"主耶和华必吹角，","poem":1},{"lineBreak":true},{"text":"乘南方的旋风而行。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"万军之耶和华必保护他们；","poem":1},{"lineBreak":true},{"text":"他们必吞灭仇敌，践踏弹石。","poem":1},{"lineBreak":true},{"text":"他们必喝血呐喊，犹如饮酒；","poem":1},{"lineBreak":true},{"text":"他们必像盛满血的碗，","poem":1},{"lineBreak":true},{"text":"又像坛的四角满了血。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"当那日，耶和华—他们的 神","poem":1},{"lineBreak":true},{"text":"必看他的民如群羊，拯救他们；","poem":1},{"lineBreak":true},{"text":"因为他们必像冠冕上的宝石，","poem":1},{"lineBreak":true},{"text":"高举在他的地以上","poem":1},{"noteId":12},{"text":"。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他的恩慈何等大！","poem":1},{"lineBreak":true},{"text":"他的荣美何其盛！","poem":1},{"lineBreak":true},{"text":"五谷健壮少男；","poem":1},{"lineBreak":true},{"text":"新酒培养处女。","poem":1}]}],"footnotes":[{"noteId":10,"caller":"-","text":"或译：外族人","reference":{"chapter":9,"verse":6}},{"noteId":11,"caller":"-","text":"原文是雅完","reference":{"chapter":9,"verse":13}},{"noteId":12,"caller":"-","text":"或译：在他的地上发光辉","reference":{"chapter":9,"verse":16}}]},"thisChapterLink":"/api/cmn_cu1/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}