{"translation":{"id":"cmn_cu1","name":"新标点和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89s","licenseNotes":null,"shortName":"CU1","englishName":"Chinese Union Version (simplified)","language":"cmn","textDirection":"ltr","sha256":"1f0247773be3712e994ac4eccb3b624b101fa6fae60aa587349845096ad56a19","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cu1/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ZEP","translationId":"cmn_cu1","name":"西番雅书","commonName":"西番雅书","title":"西番雅书","order":36,"numberOfChapters":3,"sha256":"98f8dfeb620c73641ccea72d07fa22d2f625c270eca8d5133c42650f815febd2","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cu1/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cu1/ZEP/3.json","totalNumberOfVerses":52},"chapter":{"number":2,"content":[{"type":"heading","content":["呼吁百姓悔改"]},{"type":"verse","number":1,"content":[{"text":"不知羞耻的国民哪，你们应当聚集！","poem":1},{"lineBreak":true},{"text":"趁命令没有发出，","poem":1},{"lineBreak":true},{"text":"日子过去如风前的糠，","poem":1},{"lineBreak":true},{"text":"耶和华的烈怒未临到你们，","poem":1},{"lineBreak":true},{"text":"他发怒的日子未到以先，","poem":1},{"lineBreak":true},{"text":"你们应当聚集前来。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"世上遵守耶和华典章的谦卑人哪，","poem":1},{"lineBreak":true},{"text":"你们都当寻求耶和华！","poem":1},{"lineBreak":true},{"text":"当寻求公义谦卑，","poem":1},{"lineBreak":true},{"text":"或者在耶和华发怒的日子可以隐藏起来。","poem":1}]},{"type":"heading","content":["以色列邻国的结局"]},{"type":"verse","number":4,"content":[{"text":"迦萨必致见弃；","poem":1},{"lineBreak":true},{"text":"亚实基伦必然荒凉。","poem":1},{"lineBreak":true},{"text":"人在正午必赶出亚实突的民；","poem":1},{"lineBreak":true},{"text":"以革伦也被拔出根来。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"住沿海之地的基利提族有祸了！","poem":1},{"lineBreak":true},{"text":"迦南、非利士人之地啊，耶和华的话与你反对，","poem":1},{"lineBreak":true},{"text":"说：我必毁灭你，以致无人居住。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"沿海之地要变为草场，","poem":1},{"lineBreak":true},{"text":"其上有牧人的住处和羊群的圈。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"这地必为犹大家剩下的人所得；","poem":1},{"lineBreak":true},{"text":"他们必在那里牧放群羊，","poem":1},{"lineBreak":true},{"text":"晚上必躺卧在亚实基伦的房屋中；","poem":1},{"lineBreak":true},{"text":"因为耶和华—他们的 神必眷顾他们，","poem":1},{"lineBreak":true},{"text":"使他们被掳的人归回。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我听见摩押人的毁谤和亚扪人的辱骂，","poem":1},{"lineBreak":true},{"text":"就是毁谤我的百姓，自夸自大，","poem":1},{"lineBreak":true},{"text":"侵犯他们的境界。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"万军之耶和华—以色列的 神说：","poem":1},{"lineBreak":true},{"text":"我指着我的永生起誓：","poem":1},{"lineBreak":true},{"text":"摩押必像所多玛，","poem":1},{"lineBreak":true},{"text":"亚扪人必像蛾摩拉，","poem":1},{"lineBreak":true},{"text":"都变为刺草、盐坑、永远荒废之地。","poem":1},{"lineBreak":true},{"text":"我百姓所剩下的必掳掠他们；","poem":1},{"lineBreak":true},{"text":"我国中所余剩的必得着他们的地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"这事临到他们是因他们骄傲，自夸自大，","poem":1},{"lineBreak":true},{"text":"毁谤万军之耶和华的百姓。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和华必向他们显可畏之威，","poem":1},{"lineBreak":true},{"text":"因他必叫世上的诸神瘦弱。","poem":1},{"lineBreak":true},{"text":"列国海岛的居民各在自己的地方敬拜他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"古实人哪，你们必被我的刀所杀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和华必伸手攻击北方，毁灭亚述，","poem":1},{"lineBreak":true},{"text":"使尼尼微荒凉，又干旱如旷野。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"群畜，就是各国","poem":1},{"noteId":0},{"text":"的走兽必卧在其中；","poem":1},{"lineBreak":true},{"text":"鹈鹕和箭猪要宿在柱顶上。","poem":1},{"lineBreak":true},{"text":"在窗户内有鸣叫的声音；","poem":1},{"lineBreak":true},{"text":"门槛都必毁坏，","poem":1},{"lineBreak":true},{"text":"香柏木已经露出。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"这是素来欢乐安然居住的城，","poem":1},{"lineBreak":true},{"text":"心里说：惟有我，除我以外再没有别的；","poem":1},{"lineBreak":true},{"text":"现在何竟荒凉成为野兽躺卧之处！","poem":1},{"lineBreak":true},{"text":"凡经过的人都必摇手嗤笑她。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"国：或译类","reference":{"chapter":2,"verse":14}}]},"thisChapterLink":"/api/cmn_cu1/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cu1/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cu1/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}