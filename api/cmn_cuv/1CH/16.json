{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"1CH","translationId":"cmn_cuv","name":"歷代志上","commonName":"歷代志上","title":"歷代志上","order":13,"numberOfChapters":29,"sha256":"a668b4b6547e2ee24f3b6e74327236fef85ba56c9634c2dd8acf5b518e6a27b8","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cmn_cuv/1CH/29.json","totalNumberOfVerses":939},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["眾人將上帝的約櫃請進去，安放在大衛所搭的帳幕裏，就在上帝面前獻燔祭和平安祭。"]},{"type":"verse","number":2,"content":["大衛獻完了燔祭和平安祭，就奉耶和華的名給民祝福，"]},{"type":"verse","number":3,"content":["並且分給以色列人，無論男女，每人一個餅，一塊肉，一個葡萄餅。"]},{"type":"verse","number":4,"content":["大衛派幾個利未人在耶和華的約櫃前事奉，頌揚，稱謝，讚美耶和華－以色列的上帝："]},{"type":"verse","number":5,"content":["為首的是亞薩，其次是撒迦利雅、雅薛、示米拉末、耶歇、瑪他提雅、以利押、比拿雅、俄別‧以東、耶利，鼓瑟彈琴；惟有亞薩敲鈸，大發響聲；"]},{"type":"verse","number":6,"content":["祭司比拿雅和雅哈悉常在上帝的約櫃前吹號。"]},{"type":"verse","number":7,"content":["那日，大衛初次藉亞薩和他的弟兄以詩歌稱頌耶和華，說："]},{"type":"heading","content":["頌讚之歌"]},{"type":"verse","number":8,"content":[{"text":"你們要稱謝耶和華，求告他的名，","poem":1},{"lineBreak":true},{"text":"在萬民中傳揚他的作為！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"要向他唱詩、歌頌，","poem":1},{"lineBreak":true},{"text":"談論他一切奇妙的作為。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"要以他的聖名誇耀；","poem":1},{"lineBreak":true},{"text":"尋求耶和華的人，心中應當歡喜。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"要尋求耶和華與他的能力，","poem":1},{"lineBreak":true},{"text":"時常尋求他的面。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他僕人以色列的後裔，","poem":1},{"lineBreak":true},{"text":"他所揀選雅各的子孫哪，","poem":1},{"lineBreak":true},{"text":"你們要記念他奇妙的作為和他的奇事，","poem":1},{"lineBreak":true},{"text":"並他口中的判語。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"他是耶和華－我們的上帝，","poem":1},{"lineBreak":true},{"text":"全地都有他的判斷。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你們要記念他的約，直到永遠；","poem":1},{"lineBreak":true},{"text":"他所吩咐的話，直到千代，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"就是與亞伯拉罕所立的約，","poem":1},{"lineBreak":true},{"text":"向以撒所起的誓。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他又將這約向雅各定為律例，","poem":1},{"lineBreak":true},{"text":"向以色列定為永遠的約，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"說：我必將迦南地賜給你，","poem":1},{"lineBreak":true},{"text":"作你產業的分。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"當時你們人丁有限，數目稀少，","poem":1},{"lineBreak":true},{"text":"並且在那地為寄居的；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他們從這邦游到那邦，","poem":1},{"lineBreak":true},{"text":"從這國行到那國。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和華不容甚麼人欺負他們，","poem":1},{"lineBreak":true},{"text":"為他們的緣故責備君王，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"說：不可難為我受膏的人，","poem":1},{"lineBreak":true},{"text":"也不可惡待我的先知！","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"全地都要向耶和華歌唱！","poem":1},{"lineBreak":true},{"text":"天天傳揚他的救恩，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"在列邦中述說他的榮耀，","poem":1},{"lineBreak":true},{"text":"在萬民中述說他的奇事。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"因耶和華為大，當受極大的讚美；","poem":1},{"lineBreak":true},{"text":"他在萬神之上，當受敬畏。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"外邦的神都屬虛無，","poem":1},{"lineBreak":true},{"text":"惟獨耶和華創造諸天。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"有尊榮和威嚴在他面前，","poem":1},{"lineBreak":true},{"text":"有能力和喜樂在他聖所。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"民中的萬族啊，","poem":1},{"lineBreak":true},{"text":"你們要將榮耀能力歸給耶和華，都歸給耶和華！","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"要將耶和華的名所當得的榮耀歸給他，","poem":1},{"lineBreak":true},{"text":"拿供物來奉到他面前；","poem":1},{"lineBreak":true},{"text":"當以聖潔的","poem":1},{"noteId":15},{"text":"妝飾敬拜耶和華。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"全地要在他面前顫抖，","poem":1},{"lineBreak":true},{"text":"世界也堅定不得動搖。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"願天歡喜，願地快樂；","poem":1},{"lineBreak":true},{"text":"願人在列邦中說：","poem":1},{"lineBreak":true},{"text":"耶和華作王了！","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"願海和其中所充滿的澎湃；","poem":1},{"lineBreak":true},{"text":"願田和其中所有的都歡樂。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"那時，林中的樹木都要在耶和華面前歡呼，","poem":1},{"lineBreak":true},{"text":"因為他來要審判全地。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"應當稱謝耶和華；","poem":1},{"lineBreak":true},{"text":"因他本為善，他的慈愛永遠長存！","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"要說：拯救我們的上帝啊，求你救我們，","poem":1},{"lineBreak":true},{"text":"聚集我們，使我們脫離外邦，","poem":1},{"lineBreak":true},{"text":"我們好稱讚你的聖名，以讚美你為誇勝。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"耶和華－以色列的上帝，","poem":1},{"lineBreak":true},{"text":"從亙古直到永遠，是應當稱頌的！","poem":1},{"lineBreak":true},{"text":"眾民都說：「阿們！」並且讚美耶和華。","poem":1}]},{"type":"heading","content":["在耶路撒冷和基遍的敬拜"]},{"type":"verse","number":37,"content":["大衛派亞薩和他的弟兄在約櫃前常常事奉耶和華，一日盡一日的職分；"]},{"type":"verse","number":38,"content":["又派俄別‧以東和他的弟兄六十八人，與耶杜頓的兒子俄別‧以東，並何薩作守門的；"]},{"type":"verse","number":39,"content":["且派祭司撒督和他弟兄眾祭司在基遍的邱壇、耶和華的帳幕前燔祭壇上，每日早晚，照着耶和華律法書上所吩咐以色列人的，常給耶和華獻燔祭。"]},{"type":"verse","number":41,"content":["與他們一同被派的有希幔、耶杜頓，和其餘被選名字錄在冊上的，稱謝耶和華，因他的慈愛永遠長存。"]},{"type":"verse","number":42,"content":["希幔、耶杜頓同着他們吹號、敲鈸，大發響聲，並用別的樂器隨着歌頌上帝。耶杜頓的子孫作守門的。"]},{"type":"verse","number":43,"content":["於是眾民各歸各家；大衛也回去為家眷祝福。"]}],"footnotes":[{"noteId":15,"caller":"-","text":"的：或譯為","reference":{"chapter":16,"verse":29}}]},"thisChapterLink":"/api/cmn_cuv/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":41}