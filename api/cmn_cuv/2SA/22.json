{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"2SA","translationId":"cmn_cuv","name":"撒母耳記下","commonName":"撒母耳記下","title":"撒母耳記下","order":10,"numberOfChapters":24,"sha256":"a579375e4f50dc4922e9a6817595452ac1b404aee89c158dbecc43e54a83218a","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/cmn_cuv/2SA/24.json","totalNumberOfVerses":694},"chapter":{"number":22,"content":[{"type":"heading","content":["大衛的凱歌"]},{"type":"verse","number":1,"content":["當耶和華救大衛脫離一切仇敵和掃羅之手的日子，他向耶和華念這詩，"]},{"type":"verse","number":2,"content":["說：",{"text":"耶和華是我的巖石，","poem":1},{"lineBreak":true},{"text":"我的山寨，我的救主，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的上帝，我的磐石，我所投靠的。","poem":1},{"lineBreak":true},{"text":"他是我的盾牌，是拯救我的角，","poem":1},{"lineBreak":true},{"text":"是我的高臺，是我的避難所。","poem":1},{"lineBreak":true},{"text":"我的救主啊，你是救我脫離強暴的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要求告當讚美的耶和華，","poem":1},{"lineBreak":true},{"text":"這樣，我必從仇敵手中被救出來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"曾有死亡的波浪環繞我，","poem":1},{"lineBreak":true},{"text":"匪類的急流使我驚懼，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"陰間的繩索纏繞我，","poem":1},{"lineBreak":true},{"text":"死亡的網羅臨到我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我在急難中求告耶和華，","poem":1},{"lineBreak":true},{"text":"向我的上帝呼求。","poem":1},{"lineBreak":true},{"text":"他從殿中聽了我的聲音；","poem":1},{"lineBreak":true},{"text":"我的呼求入了他的耳中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"那時因他發怒，地就搖撼戰抖；","poem":1},{"lineBreak":true},{"text":"天的根基也震動搖撼。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"從他鼻孔冒煙上騰；","poem":1},{"lineBreak":true},{"text":"從他口中發火焚燒，連炭也着了。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他又使天下垂，親自降臨；","poem":1},{"lineBreak":true},{"text":"有黑雲在他腳下。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他坐着基路伯飛行，","poem":1},{"lineBreak":true},{"text":"在風的翅膀上顯現。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他以黑暗和聚集的水、","poem":1},{"lineBreak":true},{"text":"天空的厚雲為他四圍的行宮。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因他面前的光輝炭都着了。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華從天上打雷；","poem":1},{"lineBreak":true},{"text":"至高者發出聲音。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他射出箭來，使仇敵四散，","poem":1},{"lineBreak":true},{"text":"發出閃電，使他們擾亂。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華的斥責一發，鼻孔的氣一出，","poem":1},{"lineBreak":true},{"text":"海底就出現，大地的根基也顯露。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"他從高天伸手抓住我，","poem":1},{"lineBreak":true},{"text":"把我從大水中拉上來。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他救我脫離我的勁敵和那些恨我的人，","poem":1},{"lineBreak":true},{"text":"因為他們比我強盛。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我遭遇災難的日子，他們來攻擊我；","poem":1},{"lineBreak":true},{"text":"但耶和華是我的倚靠。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他又領我到寬闊之處；","poem":1},{"lineBreak":true},{"text":"他救拔我，因他喜悅我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"耶和華按着我的公義報答我，","poem":1},{"lineBreak":true},{"text":"按着我手中的清潔賞賜我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因為我遵守了耶和華的道，","poem":1},{"lineBreak":true},{"text":"未曾作惡離開我的上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"他的一切典章常在我面前；","poem":1},{"lineBreak":true},{"text":"他的律例，我也未曾離棄。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我在他面前作了完全人；","poem":1},{"lineBreak":true},{"text":"我也保守自己遠離我的罪孽。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"所以耶和華按我的公義，","poem":1},{"lineBreak":true},{"text":"按我在他眼前的清潔賞賜我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"慈愛的人，你以慈愛待他；","poem":1},{"lineBreak":true},{"text":"完全的人，你以完全待他；","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"清潔的人，你以清潔待他；","poem":1},{"lineBreak":true},{"text":"乖僻的人，你以彎曲待他。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"困苦的百姓，你必拯救；","poem":1},{"lineBreak":true},{"text":"但你的眼目察看高傲的人，使他降卑。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"耶和華啊，你是我的燈；","poem":1},{"lineBreak":true},{"text":"耶和華必照明我的黑暗。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我藉着你衝入敵軍，","poem":1},{"lineBreak":true},{"text":"藉着我的上帝跳過牆垣。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"至於上帝，他的道是完全的；","poem":1},{"lineBreak":true},{"text":"耶和華的話是煉淨的。","poem":1},{"lineBreak":true},{"text":"凡投靠他的，他便作他們的盾牌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"除了耶和華，誰是上帝呢？","poem":1},{"lineBreak":true},{"text":"除了我們的上帝，誰是磐石呢？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"上帝是我堅固的保障；","poem":1},{"lineBreak":true},{"text":"他引導完全人行他的路。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"他使我的腳快如母鹿的蹄，","poem":1},{"lineBreak":true},{"text":"又使我在高處安穩。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"他教導我的手能以爭戰，","poem":1},{"lineBreak":true},{"text":"甚至我的膀臂能開銅弓。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"你把你的救恩給我作盾牌；","poem":1},{"lineBreak":true},{"text":"你的溫和使我為大。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"你使我腳下的地步寬闊；","poem":1},{"lineBreak":true},{"text":"我的腳未曾滑跌。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"我追趕我的仇敵，滅絕了他們，","poem":1},{"lineBreak":true},{"text":"未滅以先，我沒有歸回。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"我滅絕了他們，","poem":1},{"lineBreak":true},{"text":"打傷了他們，使他們不能起來；","poem":1},{"lineBreak":true},{"text":"他們都倒在我的腳下。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"因為你曾以力量束我的腰，使我能爭戰；","poem":1},{"lineBreak":true},{"text":"你也使那起來攻擊我的都服在我以下。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"你又使我的仇敵在我面前轉背逃跑，","poem":1},{"lineBreak":true},{"text":"叫我能以剪除那恨我的人。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"他們仰望，卻無人拯救；","poem":1},{"lineBreak":true},{"text":"就是呼求耶和華，他也不應允。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"我搗碎他們，如同地上的灰塵，","poem":1},{"lineBreak":true},{"text":"踐踏他們，四散在地，如同街上的泥土。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"你救我脫離我百姓的爭競，","poem":1},{"lineBreak":true},{"text":"保護我作列國的元首；","poem":1},{"lineBreak":true},{"text":"我素不認識的民必事奉我。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"外邦人要投降我，","poem":1},{"lineBreak":true},{"text":"一聽見我的名聲就必順從我。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"外邦人要衰殘，","poem":1},{"lineBreak":true},{"text":"戰戰兢兢地出他們的營寨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"耶和華是活神，願我的磐石被人稱頌！","poem":1},{"lineBreak":true},{"text":"願上帝－那拯救我的磐石被人尊崇！","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"這位上帝就是那為我伸冤、","poem":1},{"lineBreak":true},{"text":"使眾民服在我以下的。","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"你救我脫離仇敵，","poem":1},{"lineBreak":true},{"text":"又把我舉起，高過那些起來攻擊我的；","poem":1},{"lineBreak":true},{"text":"你救我脫離強暴的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"耶和華啊，因此我要在外邦中稱謝你，","poem":1},{"lineBreak":true},{"text":"歌頌你的名。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"耶和華賜極大的救恩給他所立的王，","poem":1},{"lineBreak":true},{"text":"施慈愛給他的受膏者，","poem":1},{"lineBreak":true},{"text":"就是給大衛和他的後裔，","poem":1},{"lineBreak":true},{"text":"直到永遠！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}