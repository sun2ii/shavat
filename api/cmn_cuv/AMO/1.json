{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"AMO","translationId":"cmn_cuv","name":"阿摩司書","commonName":"阿摩司書","title":"阿摩司書","order":30,"numberOfChapters":9,"sha256":"18d605b76ce0ce8b7896c55a048971d827e454f0d479e5d953f3671430cf12f3","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cmn_cuv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["當猶大王烏西雅，以色列王約阿施的兒子耶羅波安在位的時候，大地震前二年，提哥亞牧人中的阿摩司得默示論以色列。"]},{"type":"verse","number":2,"content":[{"text":"他說：耶和華必從錫安吼叫，","poem":1},{"lineBreak":true},{"text":"從耶路撒冷發聲；","poem":1},{"lineBreak":true},{"text":"牧人的草場要悲哀；","poem":1},{"lineBreak":true},{"text":"迦密的山頂要枯乾。","poem":1}]},{"type":"heading","content":["上帝審判以色列的鄰國"]},{"type":"heading","content":["－亞蘭"]},{"type":"verse","number":3,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"大馬士革三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去她的刑罰；","poem":1},{"lineBreak":true},{"text":"因為她以打糧食的鐵器打過基列。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我卻要降火在哈薛的家中，","poem":1},{"lineBreak":true},{"text":"燒滅便‧哈達的宮殿。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我必折斷大馬士革的門閂，","poem":1},{"lineBreak":true},{"text":"剪除亞文平原的居民和伯‧伊甸掌權的。","poem":1},{"lineBreak":true},{"text":"亞蘭人必被擄到吉珥。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"heading","content":["－非利士"]},{"type":"verse","number":6,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"迦薩三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去她的刑罰；","poem":1},{"lineBreak":true},{"text":"因為她擄掠眾民交給以東。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我卻要降火在迦薩的城內，","poem":1},{"lineBreak":true},{"text":"燒滅其中的宮殿。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我必剪除亞實突的居民和亞實基倫掌權的，","poem":1},{"lineBreak":true},{"text":"也必反手攻擊以革倫。","poem":1},{"lineBreak":true},{"text":"非利士人所餘剩的必都滅亡。","poem":1},{"lineBreak":true},{"text":"這是主耶和華說的。","poem":1}]},{"type":"heading","content":["－泰爾"]},{"type":"verse","number":9,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"泰爾三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去她的刑罰；","poem":1},{"lineBreak":true},{"text":"因為她將眾民交給以東，","poem":1},{"lineBreak":true},{"text":"並不記念弟兄的盟約。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我卻要降火在泰爾的城內，","poem":1},{"lineBreak":true},{"text":"燒滅其中的宮殿。","poem":1}]},{"type":"heading","content":["－以東"]},{"type":"verse","number":11,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"以東三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去她的刑罰；","poem":1},{"lineBreak":true},{"text":"因為她拿刀追趕兄弟，毫無憐憫，","poem":1},{"lineBreak":true},{"text":"發怒撕裂，永懷忿怒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我卻要降火在提幔，","poem":1},{"lineBreak":true},{"text":"燒滅波斯拉的宮殿。","poem":1}]},{"type":"heading","content":["－亞捫"]},{"type":"verse","number":13,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"亞捫人三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去他們的刑罰；","poem":1},{"lineBreak":true},{"text":"因為他們剖開基列的孕婦，","poem":1},{"lineBreak":true},{"text":"擴張自己的境界。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我卻要在爭戰吶喊的日子，","poem":1},{"lineBreak":true},{"text":"旋風狂暴的時候，","poem":1},{"lineBreak":true},{"text":"點火在拉巴的城內，","poem":1},{"lineBreak":true},{"text":"燒滅其中的宮殿。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他們的王和首領必一同被擄去。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}