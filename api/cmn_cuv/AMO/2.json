{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"AMO","translationId":"cmn_cuv","name":"阿摩司書","commonName":"阿摩司書","title":"阿摩司書","order":30,"numberOfChapters":9,"sha256":"18d605b76ce0ce8b7896c55a048971d827e454f0d479e5d953f3671430cf12f3","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cmn_cuv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"heading","content":["－摩押"]},{"type":"verse","number":1,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"摩押三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去她的刑罰；","poem":1},{"lineBreak":true},{"text":"因為她將以東王的骸骨焚燒成灰。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我卻要降火在摩押，","poem":1},{"lineBreak":true},{"text":"燒滅加略的宮殿。","poem":1},{"lineBreak":true},{"text":"摩押必在鬨嚷吶喊吹角之中死亡。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我必剪除摩押中的審判者，","poem":1},{"lineBreak":true},{"text":"將其中的一切首領和他一同殺戮。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"heading","content":["－猶大"]},{"type":"verse","number":4,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"猶大人三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去他們的刑罰；","poem":1},{"lineBreak":true},{"text":"因為他們厭棄耶和華的訓誨，","poem":1},{"lineBreak":true},{"text":"不遵守他的律例。","poem":1},{"lineBreak":true},{"text":"他們列祖所隨從虛假的偶像使他們走迷了。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我卻要降火在猶大，","poem":1},{"lineBreak":true},{"text":"燒滅耶路撒冷的宮殿。","poem":1}]},{"type":"heading","content":["上帝審判以色列"]},{"type":"verse","number":6,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"以色列人三番四次地犯罪，","poem":1},{"lineBreak":true},{"text":"我必不免去他們的刑罰；","poem":1},{"lineBreak":true},{"text":"因他們為銀子賣了義人，","poem":1},{"lineBreak":true},{"text":"為一雙鞋賣了窮人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們見窮人頭上所蒙的灰也都垂涎，","poem":1},{"lineBreak":true},{"text":"阻礙謙卑人的道路。","poem":1},{"lineBreak":true},{"text":"父子同一個女子行淫，","poem":1},{"lineBreak":true},{"text":"褻瀆我的聖名。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們在各壇旁鋪人所當的衣服，臥在其上，","poem":1},{"lineBreak":true},{"text":"又在他們神的廟中喝受罰之人的酒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我從以色列人面前除滅亞摩利人。","poem":1},{"lineBreak":true},{"text":"他雖高大如香柏樹，堅固如橡樹，","poem":1},{"lineBreak":true},{"text":"我卻上滅他的果子，下絕他的根本。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我也將你們從埃及地領上來，","poem":1},{"lineBreak":true},{"text":"在曠野引導你們四十年，","poem":1},{"lineBreak":true},{"text":"使你們得亞摩利人之地為業。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我從你們子弟中興起先知，","poem":1},{"lineBreak":true},{"text":"又從你們少年人中興起拿細耳人。","poem":1},{"lineBreak":true},{"text":"以色列人哪，不是這樣嗎？","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"你們卻給拿細耳人酒喝，","poem":1},{"lineBreak":true},{"text":"囑咐先知說：不要說預言。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"看哪，在你們所住之地，我必壓你們，","poem":1},{"lineBreak":true},{"text":"如同裝滿禾捆的車壓物一樣。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"快跑的不能逃脫；","poem":1},{"lineBreak":true},{"text":"有力的不能用力；","poem":1},{"lineBreak":true},{"text":"剛勇的也不能自救。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"拿弓的不能站立；","poem":1},{"lineBreak":true},{"text":"腿快的不能逃脫；","poem":1},{"lineBreak":true},{"text":"騎馬的也不能自救。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"到那日，勇士中最有膽量的，","poem":1},{"lineBreak":true},{"text":"必赤身逃跑。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}