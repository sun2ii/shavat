{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"AMO","translationId":"cmn_cuv","name":"阿摩司書","commonName":"阿摩司書","title":"阿摩司書","order":30,"numberOfChapters":9,"sha256":"18d605b76ce0ce8b7896c55a048971d827e454f0d479e5d953f3671430cf12f3","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cmn_cuv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["呼籲以色列人悔改"]},{"type":"verse","number":1,"content":[{"text":"以色列家啊，要聽我為你們所作的哀歌：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"以色列民","poem":1},{"noteId":0},{"text":"跌倒，不得再起；","poem":1},{"lineBreak":true},{"text":"躺在地上，無人攙扶。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"主耶和華如此說：","poem":1},{"lineBreak":true},{"text":"以色列家的城發出一千兵的，只剩一百；","poem":1},{"lineBreak":true},{"text":"發出一百的，只剩十個。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華向以色列家如此說：","poem":1},{"lineBreak":true},{"text":"你們要尋求我，就必存活。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"不要往伯特利尋求，","poem":1},{"lineBreak":true},{"text":"不要進入吉甲，","poem":1},{"lineBreak":true},{"text":"不要過到別是巴；","poem":1},{"lineBreak":true},{"text":"因為吉甲必被擄掠，","poem":1},{"lineBreak":true},{"text":"伯特利也必歸於無有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"要尋求耶和華，就必存活，","poem":1},{"lineBreak":true},{"text":"免得他在約瑟家像火發出，","poem":1},{"lineBreak":true},{"text":"在伯特利焚燒，無人撲滅。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你們這使公平變為茵蔯、","poem":1},{"lineBreak":true},{"text":"將公義丟棄於地的，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"要尋求那造昴星和參星，","poem":1},{"lineBreak":true},{"text":"使死蔭變為晨光，","poem":1},{"lineBreak":true},{"text":"使白日變為黑夜，","poem":1},{"lineBreak":true},{"text":"命海水來澆在地上的－","poem":1},{"lineBreak":true},{"text":"耶和華是他的名；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他使力強的忽遭滅亡，","poem":1},{"lineBreak":true},{"text":"以致保障遭遇毀壞。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你們怨恨那在城門口責備人的，","poem":1},{"lineBreak":true},{"text":"憎惡那說正直話的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你們踐踏貧民，","poem":1},{"lineBreak":true},{"text":"向他們勒索麥子；","poem":1},{"lineBreak":true},{"text":"你們用鑿過的石頭建造房屋，","poem":1},{"lineBreak":true},{"text":"卻不得住在其內；","poem":1},{"lineBreak":true},{"text":"栽種美好的葡萄園，","poem":1},{"lineBreak":true},{"text":"卻不得喝所出的酒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我知道你們的罪過何等多，","poem":1},{"lineBreak":true},{"text":"你們的罪惡何等大。","poem":1},{"lineBreak":true},{"text":"你們苦待義人，收受賄賂，在城門口屈枉窮乏人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"所以通達人見這樣的時勢必靜默不言，","poem":1},{"lineBreak":true},{"text":"因為時勢真惡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"你們要求善，","poem":1},{"lineBreak":true},{"text":"不要求惡，就必存活。","poem":1},{"lineBreak":true},{"text":"這樣，耶和華－萬軍之上帝","poem":1},{"lineBreak":true},{"text":"必照你們所說的與你們同在。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"要惡惡好善，","poem":1},{"lineBreak":true},{"text":"在城門口秉公行義；","poem":1},{"lineBreak":true},{"text":"或者耶和華－萬軍之上帝向約瑟的餘民施恩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"主耶和華－萬軍之上帝如此說：","poem":1},{"lineBreak":true},{"text":"在一切寬闊處必有哀號的聲音；","poem":1},{"lineBreak":true},{"text":"在各街市上必有人說：","poem":1},{"lineBreak":true},{"text":"哀哉！哀哉！","poem":1},{"lineBreak":true},{"text":"又必叫農夫來哭號，","poem":1},{"lineBreak":true},{"text":"叫善唱哀歌的來舉哀。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"在各葡萄園必有哀號的聲音，","poem":1},{"lineBreak":true},{"text":"因為我必從你中間經過。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"想望耶和華日子來到的有禍了！","poem":1},{"lineBreak":true},{"text":"你們為何想望耶和華的日子呢？","poem":1},{"lineBreak":true},{"text":"那日黑暗沒有光明，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"景況好像人躲避獅子又遇見熊，","poem":1},{"lineBreak":true},{"text":"或是進房屋以手靠牆，就被蛇咬。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和華的日子不是黑暗沒有光明嗎？","poem":1},{"lineBreak":true},{"text":"不是幽暗毫無光輝嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"我厭惡你們的節期，","poem":1},{"lineBreak":true},{"text":"也不喜悅你們的嚴肅會。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你們雖然向我獻燔祭和素祭，","poem":1},{"lineBreak":true},{"text":"我卻不悅納，","poem":1},{"lineBreak":true},{"text":"也不顧你們用肥畜獻的平安祭；","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"要使你們歌唱的聲音遠離我，","poem":1},{"lineBreak":true},{"text":"因為我不聽你們彈琴的響聲。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"惟願公平如大水滾滾，","poem":1},{"lineBreak":true},{"text":"使公義如江河滔滔。","poem":1}]},{"type":"verse","number":25,"content":["「以色列家啊，你們在曠野四十年，豈是將祭物和供物獻給我呢？"]},{"type":"verse","number":26,"content":["你們抬着為自己所造之摩洛的帳幕和偶像的龕，並你們的神星。"]},{"type":"verse","number":27,"content":["所以我要把你們擄到大馬士革以外。」這是耶和華－名為萬軍之上帝說的。"]}],"footnotes":[{"noteId":0,"caller":"-","text":"原文是處女","reference":{"chapter":5,"verse":2}}]},"thisChapterLink":"/api/cmn_cuv/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}