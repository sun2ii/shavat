{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"AMO","translationId":"cmn_cuv","name":"阿摩司書","commonName":"阿摩司書","title":"阿摩司書","order":30,"numberOfChapters":9,"sha256":"18d605b76ce0ce8b7896c55a048971d827e454f0d479e5d953f3671430cf12f3","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cmn_cuv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["以色列的毀滅"]},{"type":"verse","number":1,"content":[{"text":"國為列國之首，人最著名，","poem":1},{"lineBreak":true},{"text":"且為以色列家所歸向，","poem":1},{"lineBreak":true},{"text":"在錫安和撒馬利亞山安逸無慮的，有禍了！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們要過到甲尼察看，","poem":1},{"lineBreak":true},{"text":"從那裏往大城哈馬去，","poem":1},{"lineBreak":true},{"text":"又下到非利士人的迦特，","poem":1},{"lineBreak":true},{"text":"看那些國比你們的國還強嗎？","poem":1},{"lineBreak":true},{"text":"境界比你們的境界還寬嗎？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們以為降禍的日子還遠，","poem":1},{"lineBreak":true},{"text":"坐在位上盡行強暴","poem":1},{"noteId":1},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"你們躺臥在象牙床上，舒身在榻上，","poem":1},{"lineBreak":true},{"text":"吃群中的羊羔，棚裏的牛犢；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"彈琴鼓瑟唱消閑的歌曲，","poem":1},{"lineBreak":true},{"text":"為自己製造樂器，如同大衛所造的；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"以大碗喝酒，用上等的油抹身，","poem":1},{"lineBreak":true},{"text":"卻不為約瑟的苦難擔憂。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"所以這些人必在被擄的人中首先被擄；","poem":1},{"lineBreak":true},{"text":"舒身的人荒宴之樂必消滅了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"主耶和華－萬軍之上帝指着自己起誓說：","poem":1},{"lineBreak":true},{"text":"我憎惡雅各的榮華，厭棄他的宮殿；","poem":1},{"lineBreak":true},{"text":"因此，我必將城和其中所有的都交付敵人。","poem":1}]},{"type":"verse","number":9,"content":["那時，若在一房之內剩下十個人，也都必死。"]},{"type":"verse","number":10,"content":["死人的伯叔，就是燒他屍首的，要將這屍首搬到房外，問房屋內間的人說：「你那裏還有人沒有？」他必說：「沒有」；又說：「不要作聲，因為我們不可提耶和華的名。」"]},{"type":"verse","number":11,"content":[{"text":"看哪，耶和華出令，","poem":1},{"lineBreak":true},{"text":"大房就被攻破，","poem":1},{"lineBreak":true},{"text":"小屋就被打裂。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"馬豈能在崖石上奔跑？","poem":1},{"lineBreak":true},{"text":"人豈能在那裏用牛耕種呢？","poem":1},{"lineBreak":true},{"text":"你們卻使公平變為苦膽，","poem":1},{"lineBreak":true},{"text":"使公義的果子變為茵蔯。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你們喜愛虛浮的事，自誇說：","poem":1},{"lineBreak":true},{"text":"我們不是憑自己的力量取了角嗎？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華、萬軍之上帝說：","poem":1},{"lineBreak":true},{"text":"以色列家啊，我必興起一國攻擊你們；","poem":1},{"lineBreak":true},{"text":"他們必欺壓你們，","poem":1},{"lineBreak":true},{"text":"從哈馬口直到亞拉巴的河。","poem":1}]}],"footnotes":[{"noteId":1,"caller":"-","text":"或譯：行強暴使審判臨近","reference":{"chapter":6,"verse":3}}]},"thisChapterLink":"/api/cmn_cuv/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}