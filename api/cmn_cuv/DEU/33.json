{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"DEU","translationId":"cmn_cuv","name":"申命記","commonName":"申命記","title":"申命記","order":5,"numberOfChapters":34,"sha256":"4a98ab64316df301207d28935cf308fe8032792737350a017363e19134af391f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/cmn_cuv/DEU/34.json","totalNumberOfVerses":951},"chapter":{"number":33,"content":[{"type":"heading","content":["摩西祝福以色列眾支派"]},{"type":"verse","number":1,"content":["以下是神人摩西在未死之先為以色列人所祝的福："]},{"type":"verse","number":2,"content":[{"text":"他說：耶和華從西奈而來，","poem":1},{"lineBreak":true},{"text":"從西珥向他們顯現，","poem":1},{"lineBreak":true},{"text":"從巴蘭山發出光輝，","poem":1},{"lineBreak":true},{"text":"從萬萬聖者中來臨，","poem":1},{"lineBreak":true},{"text":"從他右手為百姓傳出烈火的律法。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他疼愛百姓；","poem":1},{"lineBreak":true},{"text":"眾聖徒都在他手中。","poem":1},{"lineBreak":true},{"text":"他們坐在他的腳下，","poem":1},{"lineBreak":true},{"text":"領受他的言語。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"摩西將律法傳給我們，","poem":1},{"lineBreak":true},{"text":"作為雅各會眾的產業。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"百姓的眾首領，","poem":1},{"lineBreak":true},{"text":"以色列的各支派，","poem":1},{"lineBreak":true},{"text":"一同聚會的時候，","poem":1},{"lineBreak":true},{"text":"耶和華","poem":1},{"noteId":9},{"text":"在耶書崙中為王。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"願呂便存活，不致死亡；","poem":1},{"lineBreak":true},{"text":"願他人數不致稀少。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"為猶大祝福說：","poem":1},{"lineBreak":true},{"text":"求耶和華俯聽猶大的聲音，","poem":1},{"lineBreak":true},{"text":"引導他歸於本族；","poem":1},{"lineBreak":true},{"text":"他曾用手為自己爭戰，","poem":1},{"lineBreak":true},{"text":"你必幫助他攻擊敵人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"論利未說：","poem":1},{"lineBreak":true},{"text":"耶和華啊，你的土明和烏陵","poem":1},{"lineBreak":true},{"text":"都在你的虔誠人那裏。","poem":1},{"lineBreak":true},{"text":"你在瑪撒曾試驗他，","poem":1},{"lineBreak":true},{"text":"在米利巴水與他爭論。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他論自己的父母說：","poem":1},{"lineBreak":true},{"text":"我未曾看見；","poem":1},{"lineBreak":true},{"text":"他也不承認弟兄，","poem":1},{"lineBreak":true},{"text":"也不認識自己的兒女。","poem":1},{"lineBreak":true},{"text":"這是因利未人遵行你的話，","poem":1},{"lineBreak":true},{"text":"謹守你的約。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們要將你的典章教訓雅各，","poem":1},{"lineBreak":true},{"text":"將你的律法教訓以色列。","poem":1},{"lineBreak":true},{"text":"他們要把香焚在你面前，","poem":1},{"lineBreak":true},{"text":"把全牲的燔祭獻在你的壇上。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求耶和華降福在他的財物上，","poem":1},{"lineBreak":true},{"text":"悅納他手裏所辦的事。","poem":1},{"lineBreak":true},{"text":"那些起來攻擊他和恨惡他的人，","poem":1},{"lineBreak":true},{"text":"願你刺透他們的腰，","poem":1},{"lineBreak":true},{"text":"使他們不得再起來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"論便雅憫說：","poem":1},{"lineBreak":true},{"text":"耶和華所親愛的必同耶和華安然居住；","poem":1},{"lineBreak":true},{"text":"耶和華終日遮蔽他，也住在他兩肩之中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"論約瑟說：","poem":1},{"lineBreak":true},{"text":"願他的地蒙耶和華賜福，","poem":1},{"lineBreak":true},{"text":"得天上的寶物、甘露，","poem":1},{"lineBreak":true},{"text":"以及地裏所藏的泉水；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"得太陽所曬熟的美果，","poem":1},{"lineBreak":true},{"text":"月亮所養成的寶物；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"得上古之山的至寶，","poem":1},{"lineBreak":true},{"text":"永世之嶺的寶物；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"得地和其中所充滿的寶物，","poem":1},{"lineBreak":true},{"text":"並住荊棘中上主的喜悅。","poem":1},{"lineBreak":true},{"text":"願這些福都歸於約瑟的頭上，","poem":1},{"lineBreak":true},{"text":"歸於那與弟兄迥別之人的頂上。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他為牛群中頭生的，有威嚴；","poem":1},{"lineBreak":true},{"text":"他的角是野牛的角，","poem":1},{"lineBreak":true},{"text":"用以牴觸萬邦，直到地極。","poem":1},{"lineBreak":true},{"text":"這角是以法蓮的萬萬，","poem":1},{"lineBreak":true},{"text":"瑪拿西的千千。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"論西布倫說：","poem":1},{"lineBreak":true},{"text":"西布倫哪，你出外可以歡喜。","poem":1},{"lineBreak":true},{"text":"以薩迦啊，在你帳棚裏可以快樂。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他們要將列邦召到山上，","poem":1},{"lineBreak":true},{"text":"在那裏獻公義的祭；","poem":1},{"lineBreak":true},{"text":"因為他們要吸取海裏的豐富，","poem":1},{"lineBreak":true},{"text":"並沙中所藏的珍寶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"論迦得說：","poem":1},{"lineBreak":true},{"text":"使迦得擴張的應當稱頌！","poem":1},{"lineBreak":true},{"text":"迦得住如母獅；","poem":1},{"lineBreak":true},{"text":"他撕裂膀臂，連頭頂也撕裂。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他為自己選擇頭一段地，","poem":1},{"lineBreak":true},{"text":"因在那裏有設立律法者的分存留。","poem":1},{"lineBreak":true},{"text":"他與百姓的首領同來；","poem":1},{"lineBreak":true},{"text":"他施行耶和華的公義","poem":1},{"lineBreak":true},{"text":"和耶和華與以色列所立的典章。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"論但說：","poem":1},{"lineBreak":true},{"text":"但為小獅子，","poem":1},{"lineBreak":true},{"text":"從巴珊跳出來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"論拿弗他利說：","poem":1},{"lineBreak":true},{"text":"拿弗他利啊，你足沾恩惠，","poem":1},{"lineBreak":true},{"text":"滿得耶和華的福，","poem":1},{"lineBreak":true},{"text":"可以得西方和南方為業。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"論亞設說：","poem":1},{"lineBreak":true},{"text":"願亞設享受多子的福樂，","poem":1},{"lineBreak":true},{"text":"得他弟兄的喜悅，","poem":1},{"lineBreak":true},{"text":"可以把腳蘸在油中。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你的門閂","poem":1},{"noteId":10},{"text":"是銅的，鐵的。","poem":1},{"lineBreak":true},{"text":"你的日子如何，你的力量也必如何。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"耶書崙哪，沒有能比上帝的。","poem":1},{"lineBreak":true},{"text":"他為幫助你，乘在天空，","poem":1},{"lineBreak":true},{"text":"顯其威榮，駕行穹蒼。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"永生的上帝是你的居所；","poem":1},{"lineBreak":true},{"text":"他永久的膀臂在你以下。","poem":1},{"lineBreak":true},{"text":"他在你前面攆出仇敵，","poem":1},{"lineBreak":true},{"text":"說：毀滅吧。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"以色列安然居住；","poem":1},{"lineBreak":true},{"text":"雅各的本源獨居五穀新酒之地。","poem":1},{"lineBreak":true},{"text":"他的天也滴甘露。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"以色列啊，你是有福的！","poem":1},{"lineBreak":true},{"text":"誰像你這蒙耶和華所拯救的百姓呢？","poem":1},{"lineBreak":true},{"text":"他是你的盾牌，幫助你，","poem":1},{"lineBreak":true},{"text":"是你威榮的刀劍。","poem":1},{"lineBreak":true},{"text":"你的仇敵必投降你；","poem":1},{"lineBreak":true},{"text":"你必踏在他們的高處。","poem":1}]}],"footnotes":[{"noteId":9,"caller":"-","text":"原文是他","reference":{"chapter":33,"verse":5}},{"noteId":10,"caller":"-","text":"或譯：鞋","reference":{"chapter":33,"verse":25}}]},"thisChapterLink":"/api/cmn_cuv/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}