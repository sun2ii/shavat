{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cuv","name":"傳道書","commonName":"傳道書","title":"傳道書","order":21,"numberOfChapters":12,"sha256":"1813d263c26e831c2567d2bb1a86aceeba0ff4bca2eb75bd8e33b93483b09179","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cuv/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":1,"content":[{"type":"heading","content":["人生的虛空"]},{"type":"verse","number":1,"content":["在耶路撒冷作王、大衛的兒子、傳道者的言語。"]},{"type":"verse","number":2,"content":[{"text":"傳道者說：虛空的虛空，","poem":1},{"lineBreak":true},{"text":"虛空的虛空，凡事都是虛空。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人一切的勞碌，","poem":1},{"lineBreak":true},{"text":"就是他在日光之下的勞碌，有甚麼益處呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"一代過去，一代又來，","poem":1},{"lineBreak":true},{"text":"地卻永遠長存。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"日頭出來，日頭落下，","poem":1},{"lineBreak":true},{"text":"急歸所出之地。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"風往南颳，又向北轉，","poem":1},{"lineBreak":true},{"text":"不住地旋轉，而且返回轉行原道。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"江河都往海裏流，海卻不滿；","poem":1},{"lineBreak":true},{"text":"江河從何處流，仍歸還何處。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"萬事令人厭煩","poem":1},{"noteId":0},{"text":"，","poem":1},{"lineBreak":true},{"text":"人不能說盡。","poem":1},{"lineBreak":true},{"text":"眼看，看不飽；","poem":1},{"lineBreak":true},{"text":"耳聽，聽不足。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"已有的事後必再有；","poem":1},{"lineBreak":true},{"text":"已行的事後必再行。","poem":1},{"lineBreak":true},{"text":"日光之下並無新事。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"豈有一件事人能指着說這是新的？","poem":1},{"lineBreak":true},{"text":"哪知，在我們以前的世代早已有了。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"已過的世代，無人記念；","poem":1},{"lineBreak":true},{"text":"將來的世代，後來的人也不記念。","poem":1}]},{"type":"heading","content":["傳道者的經驗"]},{"type":"verse","number":12,"content":["我傳道者在耶路撒冷作過以色列的王。"]},{"type":"verse","number":13,"content":["我專心用智慧尋求、查究天下所做的一切事，乃知上帝叫世人所經練的是極重的勞苦。"]},{"type":"verse","number":14,"content":["我見日光之下所做的一切事，都是虛空，都是捕風。"]},{"type":"verse","number":15,"content":[{"text":"彎曲的，不能變直；","poem":1},{"lineBreak":true},{"text":"缺少的，不能足數。","poem":1}]},{"type":"verse","number":16,"content":["我心裏議論說：我得了大智慧，勝過我以前在耶路撒冷的眾人，而且我心中多經歷智慧和知識的事。"]},{"type":"verse","number":17,"content":["我又專心察明智慧、狂妄，和愚昧，乃知這也是捕風。"]},{"type":"verse","number":18,"content":[{"text":"因為多有智慧，就多有愁煩；","poem":1},{"lineBreak":true},{"text":"加增知識的，就加增憂傷。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"或譯：萬物滿有困乏","reference":{"chapter":1,"verse":8}}]},"thisChapterLink":"/api/cmn_cuv/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}