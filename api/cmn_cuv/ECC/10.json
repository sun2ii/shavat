{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cuv","name":"傳道書","commonName":"傳道書","title":"傳道書","order":21,"numberOfChapters":12,"sha256":"1813d263c26e831c2567d2bb1a86aceeba0ff4bca2eb75bd8e33b93483b09179","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cuv/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"死蒼蠅使做香的膏油發出臭氣；","poem":1},{"lineBreak":true},{"text":"這樣，一點愚昧也能敗壞智慧和尊榮。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"智慧人的心居右；","poem":1},{"lineBreak":true},{"text":"愚昧人的心居左。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"並且愚昧人行路顯出無知，","poem":1},{"lineBreak":true},{"text":"對眾人說，他是愚昧人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"掌權者的心若向你發怒，","poem":1},{"lineBreak":true},{"text":"不要離開你的本位，","poem":1},{"lineBreak":true},{"text":"因為柔和能免大過。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我見日光之下有一件禍患，","poem":1},{"lineBreak":true},{"text":"似乎出於掌權的錯誤，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"就是愚昧人立在高位；","poem":1},{"lineBreak":true},{"text":"富足人坐在低位。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我見過僕人騎馬，","poem":1},{"lineBreak":true},{"text":"王子像僕人在地上步行。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"挖陷坑的，自己必掉在其中；","poem":1},{"lineBreak":true},{"text":"拆牆垣的，必為蛇所咬。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"鑿開","poem":1},{"noteId":7},{"text":"石頭的，必受損傷；","poem":1},{"lineBreak":true},{"text":"劈開木頭的，必遭危險。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"鐵器鈍了，若不將刃磨快，就必多費氣力；","poem":1},{"lineBreak":true},{"text":"但得智慧指教，便有益處。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"未行法術以先，蛇若咬人，","poem":1},{"lineBreak":true},{"text":"後行法術也是無益。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"智慧人的口說出恩言；","poem":1},{"lineBreak":true},{"text":"愚昧人的嘴吞滅自己。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他口中的言語起頭是愚昧；","poem":1},{"lineBreak":true},{"text":"他話的末尾是奸惡的狂妄。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"愚昧人多有言語，","poem":1},{"lineBreak":true},{"text":"人卻不知將來有甚麼事；","poem":1},{"lineBreak":true},{"text":"他身後的事誰能告訴他呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"凡愚昧人，他的勞碌使自己困乏，","poem":1},{"lineBreak":true},{"text":"因為連進城的路，他也不知道。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"邦國啊，你的王若是孩童，","poem":1},{"lineBreak":true},{"text":"你的群臣早晨宴樂，","poem":1},{"lineBreak":true},{"text":"你就有禍了！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"邦國啊，你的王若是貴冑之子，","poem":1},{"lineBreak":true},{"text":"你的群臣按時吃喝，","poem":1},{"lineBreak":true},{"text":"為要補力，不為酒醉，","poem":1},{"lineBreak":true},{"text":"你就有福了！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因人懶惰，房頂塌下；","poem":1},{"lineBreak":true},{"text":"因人手懶，房屋滴漏。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"設擺筵席是為喜笑。","poem":1},{"lineBreak":true},{"text":"酒能使人快活；","poem":1},{"lineBreak":true},{"text":"錢能叫萬事應心。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你不可咒詛君王，","poem":1},{"lineBreak":true},{"text":"也不可心懷此念；","poem":1},{"lineBreak":true},{"text":"在你臥房也不可咒詛富戶。","poem":1},{"lineBreak":true},{"text":"因為空中的鳥必傳揚這聲音，","poem":1},{"lineBreak":true},{"text":"有翅膀的也必述說這事。","poem":1}]}],"footnotes":[{"noteId":7,"caller":"-","text":"或譯：挪移","reference":{"chapter":10,"verse":9}}]},"thisChapterLink":"/api/cmn_cuv/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}