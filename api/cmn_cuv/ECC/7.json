{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ECC","translationId":"cmn_cuv","name":"傳道書","commonName":"傳道書","title":"傳道書","order":21,"numberOfChapters":12,"sha256":"1813d263c26e831c2567d2bb1a86aceeba0ff4bca2eb75bd8e33b93483b09179","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cmn_cuv/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":7,"content":[{"type":"heading","content":["智愚之別"]},{"type":"verse","number":1,"content":[{"text":"名譽強如美好的膏油；人死的日子勝過人生的日子。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"往遭喪的家去，","poem":1},{"lineBreak":true},{"text":"強如往宴樂的家去；","poem":1},{"lineBreak":true},{"text":"因為死是眾人的結局，","poem":1},{"lineBreak":true},{"text":"活人也必將這事放在心上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"憂愁強如喜笑；","poem":1},{"lineBreak":true},{"text":"因為面帶愁容，終必使心喜樂。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"智慧人的心在遭喪之家；","poem":1},{"lineBreak":true},{"text":"愚昧人的心在快樂之家。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"聽智慧人的責備，","poem":1},{"lineBreak":true},{"text":"強如聽愚昧人的歌唱。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愚昧人的笑聲，","poem":1},{"lineBreak":true},{"text":"好像鍋下燒荊棘的爆聲；","poem":1},{"lineBreak":true},{"text":"這也是虛空。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"勒索使智慧人變為愚妄；","poem":1},{"lineBreak":true},{"text":"賄賂能敗壞人的慧心。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"事情的終局強如事情的起頭；","poem":1},{"lineBreak":true},{"text":"存心忍耐的，勝過居心驕傲的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你不要心裏急躁惱怒，","poem":1},{"lineBreak":true},{"text":"因為惱怒存在愚昧人的懷中。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"不要說：","poem":1},{"lineBreak":true},{"text":"先前的日子強過如今的日子，","poem":1},{"lineBreak":true},{"text":"是甚麼緣故呢？","poem":1},{"lineBreak":true},{"text":"你這樣問，不是出於智慧。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"智慧和產業並好，","poem":1},{"lineBreak":true},{"text":"而且見天日的人得智慧更為有益。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因為智慧護庇人，","poem":1},{"lineBreak":true},{"text":"好像銀錢護庇人一樣。","poem":1},{"lineBreak":true},{"text":"惟獨智慧能保全智慧人的生命。","poem":1},{"lineBreak":true},{"text":"這就是知識的益處。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你要察看上帝的作為；","poem":1},{"lineBreak":true},{"text":"因上帝使為曲的，誰能變為直呢？","poem":1}]},{"type":"verse","number":14,"content":["遇亨通的日子你當喜樂；遭患難的日子你當思想；因為上帝使這兩樣並列，為的是叫人查不出身後有甚麼事。"]},{"type":"verse","number":15,"content":["有義人行義，反致滅亡；有惡人行惡，倒享長壽。這都是我在虛度之日中所見過的。"]},{"type":"verse","number":16,"content":["不要行義過分，也不要過於自逞智慧，何必自取敗亡呢？"]},{"type":"verse","number":17,"content":["不要行惡過分，也不要為人愚昧，何必不到期而死呢？"]},{"type":"verse","number":18,"content":["你持守這個為美，那個也不要鬆手；因為敬畏上帝的人，必從這兩樣出來。"]},{"type":"verse","number":19,"content":["智慧使有智慧的人比城中十個官長更有能力。"]},{"type":"verse","number":20,"content":["時常行善而不犯罪的義人，世上實在沒有。"]},{"type":"verse","number":21,"content":["人所說的一切話，你不要放在心上，恐怕聽見你的僕人咒詛你。"]},{"type":"verse","number":22,"content":["因為你心裏知道，自己也曾屢次咒詛別人。"]},{"type":"verse","number":23,"content":["我曾用智慧試驗這一切事；我說，要得智慧，智慧卻離我遠。"]},{"type":"verse","number":24,"content":["萬事之理，離我甚遠，而且最深，誰能測透呢？"]},{"type":"verse","number":25,"content":["我轉念，一心要知道，要考察，要尋求智慧和萬事的理由；又要知道邪惡為愚昧，愚昧為狂妄。"]},{"type":"verse","number":26,"content":["我得知有等婦人比死還苦：她的心是網羅，手是鎖鍊。凡蒙上帝喜悅的人必能躲避她；有罪的人卻被她纏住了。"]},{"type":"verse","number":27,"content":["傳道者說：「看哪，一千男子中，我找到一個正直人，但眾女子中，沒有找到一個。」我將這事一一比較，要尋求其理，我心仍要尋找，卻未曾找到。"]},{"type":"verse","number":29,"content":["我所找到的只有一件，就是上帝造人原是正直，但他們尋出許多巧計。"]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":28}