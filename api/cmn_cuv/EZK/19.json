{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"EZK","translationId":"cmn_cuv","name":"以西結書","commonName":"以西結書","title":"以西結書","order":26,"numberOfChapters":48,"sha256":"12baf83f738d213fc8fcfdfb80ed9077bac361d38fc0165824d98cb7b59e53b9","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/cmn_cuv/EZK/48.json","totalNumberOfVerses":1270},"chapter":{"number":19,"content":[{"type":"heading","content":["輓歌"]},{"type":"verse","number":1,"content":["你當為以色列的王作起哀歌，"]},{"type":"verse","number":2,"content":["說：",{"text":"你的母親是甚麼呢？","poem":1},{"lineBreak":true},{"text":"是個母獅子，蹲伏在獅子中間，","poem":1},{"lineBreak":true},{"text":"在少壯獅子中養育小獅子。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"在牠小獅子中養大一個，","poem":1},{"lineBreak":true},{"text":"成了少壯獅子，","poem":1},{"lineBreak":true},{"text":"學會抓食而吃人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"列國聽見了就把牠捉在他們的坑中，","poem":1},{"lineBreak":true},{"text":"用鉤子拉到埃及地去。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"母獅見自己等候失了指望，","poem":1},{"lineBreak":true},{"text":"就從牠小獅子中又將一個養為少壯獅子。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"牠在眾獅子中走來走去，","poem":1},{"lineBreak":true},{"text":"成了少壯獅子，","poem":1},{"lineBreak":true},{"text":"學會抓食而吃人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"牠知道列國的宮殿，","poem":1},{"lineBreak":true},{"text":"又使他們的城邑變為荒場；","poem":1},{"lineBreak":true},{"text":"因牠咆哮的聲音，","poem":1},{"lineBreak":true},{"text":"遍地和其中所有的就都荒廢。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"於是四圍邦國各省的人來攻擊牠，","poem":1},{"lineBreak":true},{"text":"將網撒在牠身上，","poem":1},{"lineBreak":true},{"text":"捉在他們的坑中。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們用鉤子鉤住牠，將牠放在籠中，","poem":1},{"lineBreak":true},{"text":"帶到巴比倫王那裏，","poem":1},{"lineBreak":true},{"text":"將牠放入堅固之所，","poem":1},{"lineBreak":true},{"text":"使牠的聲音在以色列山上不再聽見。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你的母親先前如葡萄樹，","poem":1},{"lineBreak":true},{"text":"極其茂盛","poem":1},{"noteId":20},{"text":"，栽於水旁。","poem":1},{"lineBreak":true},{"text":"因為水多，","poem":1},{"lineBreak":true},{"text":"就多結果子，滿生枝子；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"生出堅固的枝幹，可作掌權者的杖。","poem":1},{"lineBreak":true},{"text":"這枝幹高舉在茂密的枝中，","poem":1},{"lineBreak":true},{"text":"而且它生長高大，枝子繁多，","poem":1},{"lineBreak":true},{"text":"遠遠可見。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"但這葡萄樹因忿怒被拔出摔在地上；","poem":1},{"lineBreak":true},{"text":"東風吹乾其上的果子，","poem":1},{"lineBreak":true},{"text":"堅固的枝幹折斷枯乾，","poem":1},{"lineBreak":true},{"text":"被火燒毀了；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"如今栽於曠野乾旱無水之地。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"火也從它枝幹中發出，","poem":1},{"lineBreak":true},{"text":"燒滅果子，","poem":1},{"lineBreak":true},{"text":"以致沒有堅固的枝幹可做掌權者的杖。","poem":1},{"lineBreak":true},{"text":"這是哀歌，也必用以作哀歌。","poem":1}]}],"footnotes":[{"noteId":20,"caller":"-","text":"原文是在你血中","reference":{"chapter":19,"verse":10}}]},"thisChapterLink":"/api/cmn_cuv/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}