{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"EZK","translationId":"cmn_cuv","name":"以西結書","commonName":"以西結書","title":"以西結書","order":26,"numberOfChapters":48,"sha256":"12baf83f738d213fc8fcfdfb80ed9077bac361d38fc0165824d98cb7b59e53b9","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/cmn_cuv/EZK/48.json","totalNumberOfVerses":1270},"chapter":{"number":27,"content":[{"type":"heading","content":["哀悼泰爾的輓歌"]},{"type":"verse","number":1,"content":["耶和華的話又臨到我說："]},{"type":"verse","number":2,"content":["「人子啊，要為泰爾作起哀歌，"]},{"type":"verse","number":3,"content":["說：你居住海口，是眾民的商埠；你的交易通到許多的海島。主耶和華如此說：",{"text":"泰爾啊，你曾說：","poem":1},{"lineBreak":true},{"text":"我是全然美麗的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的境界在海中，","poem":1},{"lineBreak":true},{"text":"造你的使你全然美麗。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們用示尼珥的松樹做你的一切板，","poem":1},{"lineBreak":true},{"text":"用黎巴嫩的香柏樹做桅杆，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"用巴珊的橡樹做你的槳，","poem":1},{"lineBreak":true},{"text":"用象牙鑲嵌基提海島的黃楊木為坐板","poem":1},{"noteId":26},{"text":"。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的篷帆是用埃及繡花細麻布做的，","poem":1},{"lineBreak":true},{"text":"可以做你的大旗；","poem":1},{"lineBreak":true},{"text":"你的涼棚是用以利沙島的藍色、紫色布做的。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"西頓和亞發的居民作你盪槳的。","poem":1},{"lineBreak":true},{"text":"泰爾啊，你中間的智慧人作掌舵的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"迦巴勒的老者和聰明人","poem":1},{"lineBreak":true},{"text":"都在你中間作補縫的；","poem":1},{"lineBreak":true},{"text":"一切泛海的船隻和水手","poem":1},{"lineBreak":true},{"text":"都在你中間經營交易的事。","poem":1}]},{"type":"verse","number":10,"content":["「波斯人、路德人、弗人在你軍營中作戰士；他們在你中間懸掛盾牌和頭盔，彰顯你的尊榮。"]},{"type":"verse","number":11,"content":["亞發人和你的軍隊都在你四圍的牆上，你的望樓也有勇士；他們懸掛盾牌，成全你的美麗。"]},{"type":"verse","number":12,"content":["「他施人因你多有各類的財物，就作你的客商，拿銀、鐵、錫、鉛兌換你的貨物。"]},{"type":"verse","number":13,"content":["雅完人、土巴人、米設人都與你交易；他們用人口和銅器兌換你的貨物。"]},{"type":"verse","number":14,"content":["陀迦瑪族用馬和戰馬並騾子兌換你的貨物。"]},{"type":"verse","number":15,"content":["底但人與你交易，許多海島作你的碼頭；他們拿象牙、烏木與你兌換",{"noteId":27},"。"]},{"type":"verse","number":16,"content":["亞蘭人因你的工作很多，就作你的客商；他們用綠寶石、紫色布繡貨、細麻布、珊瑚、紅寶石兌換你的貨物。"]},{"type":"verse","number":17,"content":["猶大和以色列地的人都與你交易；他們用米匿的麥子、餅、蜜、油、乳香兌換你的貨物。"]},{"type":"verse","number":18,"content":["大馬士革人因你的工作很多，又因你多有各類的財物，就拿黑本酒和白羊毛與你交易。"]},{"type":"verse","number":19,"content":["威但人和雅完人拿紡成的線、亮鐵、桂皮、菖蒲兌換你的貨物。"]},{"type":"verse","number":20,"content":["底但人用高貴的毯子、鞍、屜與你交易。"]},{"type":"verse","number":21,"content":["阿拉伯人和基達的一切首領都作你的客商，用羊羔、公綿羊、公山羊與你交易。"]},{"type":"verse","number":22,"content":["示巴和拉瑪的商人與你交易，他們用各類上好的香料、各類的寶石，和黃金兌換你的貨物。"]},{"type":"verse","number":23,"content":["哈蘭人、干尼人、伊甸人、示巴的商人，和亞述人、基抹人與你交易。"]},{"type":"verse","number":24,"content":["這些商人以美好的貨物包在繡花藍色包袱內，又有華麗的衣服裝在香柏木的箱子裏，用繩捆着與你交易。"]},{"type":"verse","number":25,"content":[{"text":"他施的船隻接連成幫為你運貨，","poem":1},{"lineBreak":true},{"text":"你便在海中豐富極其榮華。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"盪槳的已經把你盪到大水之處，","poem":1},{"lineBreak":true},{"text":"東風在海中將你打破。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你的資財、物件、貨物、","poem":1},{"lineBreak":true},{"text":"水手、掌舵的、","poem":1},{"lineBreak":true},{"text":"補縫的、經營交易的，","poem":1},{"lineBreak":true},{"text":"並你中間的戰士和人民，","poem":1},{"lineBreak":true},{"text":"在你破壞的日子必都沉在海中。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你掌舵的呼號之聲一發，","poem":1},{"lineBreak":true},{"text":"郊野都必震動。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"凡盪槳的和水手，","poem":1},{"lineBreak":true},{"text":"並一切泛海掌舵的，","poem":1},{"lineBreak":true},{"text":"都必下船登岸。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他們必為你放聲痛哭，","poem":1},{"lineBreak":true},{"text":"把塵土撒在頭上，","poem":1},{"lineBreak":true},{"text":"在灰中打滾；","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"又為你使頭上光禿，","poem":1},{"lineBreak":true},{"text":"用麻布束腰，","poem":1},{"lineBreak":true},{"text":"號咷痛哭，","poem":1},{"lineBreak":true},{"text":"苦苦悲哀。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他們哀號的時候，","poem":1},{"lineBreak":true},{"text":"為你作起哀歌哀哭，","poem":1},{"lineBreak":true},{"text":"說：有何城如泰爾？","poem":1},{"lineBreak":true},{"text":"有何城如她在海中成為寂寞的呢？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"你由海上運出貨物，","poem":1},{"lineBreak":true},{"text":"就使許多國民充足；","poem":1},{"lineBreak":true},{"text":"你以許多資財、貨物","poem":1},{"lineBreak":true},{"text":"使地上的君王豐富。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你在深水中被海浪打破的時候，","poem":1},{"lineBreak":true},{"text":"你的貨物和你中間的一切人民，","poem":1},{"lineBreak":true},{"text":"就都沉下去了。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"海島的居民為你驚奇；","poem":1},{"lineBreak":true},{"text":"他們的君王都甚恐慌，","poem":1},{"lineBreak":true},{"text":"面帶愁容。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"各國民中的客商都向你發嘶聲；","poem":1},{"lineBreak":true},{"text":"你令人驚恐，","poem":1},{"lineBreak":true},{"text":"不再存留於世，直到永遠。」","poem":1}]}],"footnotes":[{"noteId":26,"caller":"-","text":"或譯：艙板","reference":{"chapter":27,"verse":6}},{"noteId":27,"caller":"-","text":"或譯：進貢","reference":{"chapter":27,"verse":15}}]},"thisChapterLink":"/api/cmn_cuv/EZK/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/EZK/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/EZK/26.json","previousChapterAudioLinks":{},"numberOfVerses":36}