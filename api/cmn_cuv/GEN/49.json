{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"GEN","translationId":"cmn_cuv","name":"創世記","commonName":"創世記","title":"創世記","order":1,"numberOfChapters":50,"sha256":"c386c509bcaf2d2e415b454ca78f5cfd89495b0f945d3896fb5dab5baca206b4","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cmn_cuv/GEN/50.json","totalNumberOfVerses":1532},"chapter":{"number":49,"content":[{"type":"heading","content":["雅各的遺囑"]},{"type":"verse","number":1,"content":["雅各叫了他的兒子們來，說：「你們都來聚集，我好把你們日後必遇的事告訴你們。"]},{"type":"verse","number":2,"content":[{"text":"雅各的兒子們，你們要聚集而聽，","poem":1},{"lineBreak":true},{"text":"要聽你們父親以色列的話。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"呂便哪，你是我的長子，","poem":1},{"lineBreak":true},{"text":"是我力量強壯的時候生的，","poem":1},{"lineBreak":true},{"text":"本當大有尊榮，權力超眾。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"但你放縱情慾，滾沸如水，","poem":1},{"lineBreak":true},{"text":"必不得居首位；","poem":1},{"lineBreak":true},{"text":"因為你上了你父親的床，","poem":1},{"lineBreak":true},{"text":"污穢了我的榻。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"西緬和利未是弟兄；","poem":1},{"lineBreak":true},{"text":"他們的刀劍是殘忍的器具。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的靈啊，不要與他們同謀；","poem":1},{"lineBreak":true},{"text":"我的心哪，不要與他們聯絡；","poem":1},{"lineBreak":true},{"text":"因為他們趁怒殺害人命，","poem":1},{"lineBreak":true},{"text":"任意砍斷牛腿大筋。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們的怒氣暴烈可咒；","poem":1},{"lineBreak":true},{"text":"他們的忿恨殘忍可詛。","poem":1},{"lineBreak":true},{"text":"我要使他們分居在雅各家裏，","poem":1},{"lineBreak":true},{"text":"散住在以色列地中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"猶大啊，你弟兄們必讚美你；","poem":1},{"lineBreak":true},{"text":"你手必掐住仇敵的頸項；","poem":1},{"lineBreak":true},{"text":"你父親的兒子們必向你下拜。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"猶大是個小獅子；","poem":1},{"lineBreak":true},{"text":"我兒啊，你抓了食便上去。","poem":1},{"lineBreak":true},{"text":"你屈下身去，臥如公獅，","poem":1},{"lineBreak":true},{"text":"蹲如母獅，誰敢惹你？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"圭必不離猶大，","poem":1},{"lineBreak":true},{"text":"杖必不離他兩腳之間，","poem":1},{"lineBreak":true},{"text":"直等細羅","poem":1},{"noteId":55},{"text":"來到，","poem":1},{"lineBreak":true},{"text":"萬民都必歸順。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"猶大把小驢拴在葡萄樹上，","poem":1},{"lineBreak":true},{"text":"把驢駒拴在美好的葡萄樹上。","poem":1},{"lineBreak":true},{"text":"他在葡萄酒中洗了衣服，","poem":1},{"lineBreak":true},{"text":"在葡萄汁中洗了袍褂。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他的眼睛必因酒紅潤；","poem":1},{"lineBreak":true},{"text":"他的牙齒必因奶白亮。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"西布倫必住在海口，","poem":1},{"lineBreak":true},{"text":"必成為停船的海口；","poem":1},{"lineBreak":true},{"text":"他的境界必延到西頓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"以薩迦是個強壯的驢，","poem":1},{"lineBreak":true},{"text":"臥在羊圈之中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他以安靜為佳，以肥地為美，","poem":1},{"lineBreak":true},{"text":"便低肩背重，成為服苦的僕人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"但必判斷他的民，","poem":1},{"lineBreak":true},{"text":"作以色列支派之一。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"但必作道上的蛇，路中的虺，","poem":1},{"lineBreak":true},{"text":"咬傷馬蹄，使騎馬的墜落於後。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和華啊，我向來等候你的救恩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"迦得必被敵軍追逼，","poem":1},{"lineBreak":true},{"text":"他卻要追逼他們的腳跟。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"亞設之地必出肥美的糧食，","poem":1},{"lineBreak":true},{"text":"且出君王的美味。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"拿弗他利是被釋放的母鹿；","poem":1},{"lineBreak":true},{"text":"他出嘉美的言語。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"約瑟是多結果子的樹枝，","poem":1},{"lineBreak":true},{"text":"是泉旁多結果的枝子；","poem":1},{"lineBreak":true},{"text":"他的枝條探出牆外。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"弓箭手將他苦害，","poem":1},{"lineBreak":true},{"text":"向他射箭，逼迫他。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"但他的弓仍舊堅硬；","poem":1},{"lineBreak":true},{"text":"他的手健壯敏捷。","poem":1},{"lineBreak":true},{"text":"這是因以色列的牧者，以色列的磐石－","poem":1},{"lineBreak":true},{"text":"就是雅各的大能者。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你父親的上帝必幫助你；","poem":1},{"lineBreak":true},{"text":"那全能者必將天上所有的福，","poem":1},{"lineBreak":true},{"text":"地裏所藏的福，以及生產乳養的福，都賜給你。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你父親所祝的福","poem":1},{"lineBreak":true},{"text":"勝過我祖先所祝的福，","poem":1},{"lineBreak":true},{"text":"如永世的山嶺，至極的邊界；","poem":1},{"lineBreak":true},{"text":"這些福必降在約瑟的頭上，","poem":1},{"lineBreak":true},{"text":"臨到那與弟兄迥別之人的頂上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"便雅憫是個撕掠的狼，","poem":1},{"lineBreak":true},{"text":"早晨要吃他所抓的，","poem":1},{"lineBreak":true},{"text":"晚上要分他所奪的。」","poem":1}]},{"type":"verse","number":28,"content":["這一切是以色列的十二支派；這也是他們的父親對他們所說的話，為他們所祝的福，都是按着各人的福分為他們祝福。"]},{"type":"heading","content":["雅各的死和埋葬"]},{"type":"verse","number":29,"content":["他又囑咐他們說：「我將要歸到我列祖",{"noteId":56},"那裏，你們要將我葬在赫人以弗崙田間的洞裏，與我祖我父在一處，"]},{"type":"verse","number":30,"content":["就是在迦南地幔利前、麥比拉田間的洞；那洞和田是亞伯拉罕向赫人以弗崙買來為業，作墳地的。"]},{"type":"verse","number":31,"content":["他們在那裏葬了亞伯拉罕和他妻子撒拉，又在那裏葬了以撒和他的妻子利百加；我也在那裏葬了利亞。"]},{"type":"verse","number":32,"content":["那塊田和田間的洞原是向赫人買的。」"]},{"type":"verse","number":33,"content":["雅各囑咐眾子已畢，就把腳收在床上，氣絕而死，歸他列祖",{"noteId":57},"那裏去了。"]}],"footnotes":[{"noteId":55,"caller":"-","text":"就是賜平安者","reference":{"chapter":49,"verse":10}},{"noteId":56,"caller":"-","text":"原文是本民","reference":{"chapter":49,"verse":29}},{"noteId":57,"caller":"-","text":"原文是本民","reference":{"chapter":49,"verse":33}}]},"thisChapterLink":"/api/cmn_cuv/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}