{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HAB","translationId":"cmn_cuv","name":"哈巴谷書","commonName":"哈巴谷書","title":"哈巴谷書","order":35,"numberOfChapters":3,"sha256":"3c3e2b7bc14d031520976fbe0e4ab846e36d1c515a15d75553ad38a39daf7e2e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cuv/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"heading","content":["耶和華回答哈巴谷"]},{"type":"verse","number":1,"content":[{"text":"我要站在守望所，","poem":1},{"lineBreak":true},{"text":"立在望樓上觀看，","poem":1},{"lineBreak":true},{"text":"看耶和華對我說甚麼話，","poem":1},{"lineBreak":true},{"text":"我可用甚麼話向他訴冤","poem":1},{"noteId":0},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"他對我說：將這默示明明地寫在版上，","poem":1},{"lineBreak":true},{"text":"使讀的人容易讀","poem":1},{"noteId":1},{"text":"。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為這默示有一定的日期，","poem":1},{"lineBreak":true},{"text":"快要應驗，並不虛謊。","poem":1},{"lineBreak":true},{"text":"雖然遲延，還要等候；","poem":1},{"lineBreak":true},{"text":"因為必然臨到，不再遲延。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"迦勒底人自高自大，心不正直；","poem":1},{"lineBreak":true},{"text":"惟義人因信得生。","poem":1}]},{"type":"heading","content":["不義的結局"]},{"type":"verse","number":5,"content":[{"text":"迦勒底人因酒詭詐，狂傲，","poem":1},{"lineBreak":true},{"text":"不住在家中，","poem":1},{"lineBreak":true},{"text":"擴充心欲，好像陰間。","poem":1},{"lineBreak":true},{"text":"他如死不能知足，","poem":1},{"lineBreak":true},{"text":"聚集萬國，堆積萬民都歸自己。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"這些國的民豈不都要提起詩歌並俗語譏刺他說：","poem":1},{"lineBreak":true},{"text":"禍哉！迦勒底人，你增添不屬自己的財物，","poem":1},{"lineBreak":true},{"text":"多多取人的當頭，要到幾時為止呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"咬傷你的豈不忽然起來，","poem":1},{"lineBreak":true},{"text":"擾害你的豈不興起，","poem":1},{"lineBreak":true},{"text":"你就作他們的擄物嗎？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因你搶奪許多的國，殺人流血，","poem":1},{"lineBreak":true},{"text":"向國內的城並城中一切居民施行強暴，","poem":1},{"lineBreak":true},{"text":"所以各國剩下的民都必搶奪你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"為本家積蓄不義之財、","poem":1},{"lineBreak":true},{"text":"在高處搭窩、指望免災的有禍了！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你圖謀剪除多國的民，犯了罪，","poem":1},{"lineBreak":true},{"text":"使你的家蒙羞，自害己命。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"牆裏的石頭必呼叫；","poem":1},{"lineBreak":true},{"text":"房內的棟樑必應聲。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"以人血建城、","poem":1},{"lineBreak":true},{"text":"以罪孽立邑的有禍了！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"眾民所勞碌得來的被火焚燒，","poem":1},{"lineBreak":true},{"text":"列國由勞乏而得的歸於虛空，","poem":1},{"lineBreak":true},{"text":"不都是出於萬軍之耶和華嗎？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"認識耶和華榮耀的知識要充滿遍地，","poem":1},{"lineBreak":true},{"text":"好像水充滿洋海一般。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"給人酒喝、又加上毒物、","poem":1},{"lineBreak":true},{"text":"使他喝醉、好看見他下體的有禍了！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你滿受羞辱，不得榮耀；","poem":1},{"lineBreak":true},{"text":"你也喝吧，顯出是未受割禮的！","poem":1},{"lineBreak":true},{"text":"耶和華右手的杯必傳到你那裏；","poem":1},{"lineBreak":true},{"text":"你的榮耀就變為大大地羞辱。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你向黎巴嫩行強暴與殘害","poem":1},{"lineBreak":true},{"text":"驚嚇野獸的事必遮蓋你；","poem":1},{"lineBreak":true},{"text":"因你殺人流血，","poem":1},{"lineBreak":true},{"text":"向國內的城並城中一切居民施行強暴。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"雕刻的偶像，人將它刻出來，","poem":1},{"lineBreak":true},{"text":"有甚麼益處呢？","poem":1},{"lineBreak":true},{"text":"鑄造的偶像就是虛謊的師傅。","poem":1},{"lineBreak":true},{"text":"製造者倚靠這啞巴偶像有甚麼益處呢？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"對木偶說：醒起！","poem":1},{"lineBreak":true},{"text":"對啞巴石像說：起來！那人有禍了！","poem":1},{"lineBreak":true},{"text":"這個還能教訓人嗎？","poem":1},{"lineBreak":true},{"text":"看哪，是包裹金銀的，其中毫無氣息。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"惟耶和華在他的聖殿中；","poem":1},{"lineBreak":true},{"text":"全地的人都當在他面前肅敬靜默。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"向他訴冤：或譯回答所疑問的","reference":{"chapter":2,"verse":1}},{"noteId":1,"caller":"-","text":"或譯：隨跑隨讀","reference":{"chapter":2,"verse":2}}]},"thisChapterLink":"/api/cmn_cuv/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}