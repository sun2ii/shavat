{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HAB","translationId":"cmn_cuv","name":"哈巴谷書","commonName":"哈巴谷書","title":"哈巴谷書","order":35,"numberOfChapters":3,"sha256":"3c3e2b7bc14d031520976fbe0e4ab846e36d1c515a15d75553ad38a39daf7e2e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cuv/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["哈巴谷的祈禱"]},{"type":"verse","number":1,"content":["先知哈巴谷的禱告，調用流離歌。"]},{"type":"verse","number":2,"content":[{"text":"耶和華啊，我聽見你的名聲","poem":1},{"noteId":2},{"text":"就懼怕。","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你在這些年間復興你的作為，","poem":1},{"lineBreak":true},{"text":"在這些年間顯明出來；","poem":1},{"lineBreak":true},{"text":"在發怒的時候以憐憫為念。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"上帝從提幔而來；","poem":1},{"lineBreak":true},{"text":"聖者從巴蘭山臨到。（細拉）","poem":1},{"lineBreak":true},{"text":"他的榮光遮蔽諸天；","poem":1},{"lineBreak":true},{"text":"頌讚充滿大地。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他的輝煌如同日光；","poem":1},{"lineBreak":true},{"text":"從他手裏射出光線，","poem":1},{"lineBreak":true},{"text":"在其中藏着他的能力。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在他前面有瘟疫流行；","poem":1},{"lineBreak":true},{"text":"在他腳下有熱症發出。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他站立，量了大地","poem":1},{"noteId":3},{"text":"，","poem":1},{"lineBreak":true},{"text":"觀看，趕散萬民。","poem":1},{"lineBreak":true},{"text":"永久的山崩裂；","poem":1},{"lineBreak":true},{"text":"長存的嶺塌陷；","poem":1},{"lineBreak":true},{"text":"他的作為與古時一樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我見古珊的帳棚遭難，","poem":1},{"lineBreak":true},{"text":"米甸的幔子戰兢。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華啊，你乘在馬上，","poem":1},{"lineBreak":true},{"text":"坐在得勝的車上，","poem":1},{"lineBreak":true},{"text":"豈是不喜悅江河、","poem":1},{"lineBreak":true},{"text":"向江河發怒氣、","poem":1},{"lineBreak":true},{"text":"向洋海發憤恨嗎？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你的弓全然顯露，","poem":1},{"lineBreak":true},{"text":"向眾支派所起的誓都是可信的。（細拉）","poem":1},{"lineBreak":true},{"text":"你以江河分開大地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"山嶺見你，無不戰懼；","poem":1},{"lineBreak":true},{"text":"大水氾濫過去，","poem":1},{"lineBreak":true},{"text":"深淵發聲，洶湧翻騰","poem":1},{"noteId":4},{"text":"。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因你的箭射出發光，","poem":1},{"lineBreak":true},{"text":"你的槍閃出光耀，","poem":1},{"lineBreak":true},{"text":"日月都在本宮停住。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你發忿恨通行大地，","poem":1},{"lineBreak":true},{"text":"發怒氣責打列國，如同打糧。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你出來要拯救你的百姓，","poem":1},{"lineBreak":true},{"text":"拯救你的受膏者，","poem":1},{"lineBreak":true},{"text":"打破惡人家長的頭，","poem":1},{"lineBreak":true},{"text":"露出他的腳","poem":1},{"noteId":5},{"text":"，直到頸項。（細拉）","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你用敵人的戈矛刺透他戰士的頭；","poem":1},{"lineBreak":true},{"text":"他們來如旋風，要將我們分散。","poem":1},{"lineBreak":true},{"text":"他們所喜愛的是暗中吞吃貧民。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你乘馬踐踏紅海，","poem":1},{"lineBreak":true},{"text":"就是踐踏洶湧的大水。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"我聽見耶和華的聲音，","poem":1},{"lineBreak":true},{"text":"身體戰兢，嘴唇發顫，","poem":1},{"lineBreak":true},{"text":"骨中朽爛；","poem":1},{"lineBreak":true},{"text":"我在所立之處戰兢。","poem":1},{"lineBreak":true},{"text":"我只可安靜等候災難之日臨到，","poem":1},{"lineBreak":true},{"text":"犯境之民上來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"雖然無花果樹不發旺，","poem":1},{"lineBreak":true},{"text":"葡萄樹不結果，","poem":1},{"lineBreak":true},{"text":"橄欖樹也不效力，","poem":1},{"lineBreak":true},{"text":"田地不出糧食，","poem":1},{"lineBreak":true},{"text":"圈中絕了羊，","poem":1},{"lineBreak":true},{"text":"棚內也沒有牛；","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"然而，我要因耶和華歡欣，","poem":1},{"lineBreak":true},{"text":"因救我的上帝喜樂。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"主耶和華是我的力量；","poem":1},{"lineBreak":true},{"text":"他使我的腳快如母鹿的蹄，","poem":1},{"lineBreak":true},{"text":"又使我穩行在高處。","poem":1},{"lineBreak":true},{"text":"這歌交與伶長，用絲弦的樂器。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"-","text":"或譯：言語","reference":{"chapter":3,"verse":2}},{"noteId":3,"caller":"-","text":"或譯：使地震動","reference":{"chapter":3,"verse":6}},{"noteId":4,"caller":"-","text":"原文是向上舉手","reference":{"chapter":3,"verse":10}},{"noteId":5,"caller":"-","text":"原文是根基","reference":{"chapter":3,"verse":13}}]},"thisChapterLink":"/api/cmn_cuv/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}