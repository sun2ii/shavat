{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HEB","translationId":"cmn_cuv","name":"希伯來書","commonName":"希伯來書","title":"希伯來書","order":58,"numberOfChapters":13,"sha256":"78bc9971805314997ff4566e48478a49f397d7d15fa573c9fb560ada92028478","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/cmn_cuv/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["上帝藉着他兒子說話"]},{"type":"verse","number":1,"content":["上帝既在古時藉着眾先知多次多方地曉諭列祖，"]},{"type":"verse","number":2,"content":["就在這末世藉着他兒子曉諭我們；又早已立他為承受萬有的，也曾藉着他創造諸世界。"]},{"type":"verse","number":3,"content":["他是上帝榮耀所發的光輝，是上帝本體的真像，常用他權能的命令托住萬有。他洗淨了人的罪，就坐在高天至大者的右邊。"]},{"type":"verse","number":4,"content":["他所承受的名，既比天使的名更尊貴，就遠超過天使。"]},{"type":"heading","content":["兒子遠超過天使"]},{"type":"verse","number":5,"content":["所有的天使，上帝從來對哪一個說：",{"text":"你是我的兒子，","poem":1},{"lineBreak":true},{"text":"我今日生你？","poem":1},"又指着哪一個說：",{"text":"我要作他的父，","poem":1},{"lineBreak":true},{"text":"他要作我的子？","poem":1}]},{"type":"verse","number":6,"content":["再者，上帝使長子到世上來的時候",{"noteId":0},"，就說：",{"text":"上帝的使者都要拜他。","poem":1}]},{"type":"verse","number":7,"content":["論到使者，又說：",{"text":"上帝以風為使者，","poem":1},{"lineBreak":true},{"text":"以火焰為僕役；","poem":1}]},{"type":"verse","number":8,"content":["論到子卻說：",{"text":"上帝啊，你的寶座是永永遠遠的；","poem":1},{"lineBreak":true},{"text":"你的國權是正直的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你喜愛公義，恨惡罪惡；","poem":1},{"lineBreak":true},{"text":"所以上帝，就是你的上帝，用喜樂油膏你，","poem":1},{"lineBreak":true},{"text":"勝過膏你的同伴；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"又說：主啊，你起初立了地的根基；","poem":1},{"lineBreak":true},{"text":"天也是你手所造的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"天地都要滅沒，你卻要長存。","poem":1},{"lineBreak":true},{"text":"天地都要像衣服漸漸舊了；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你要將天地捲起來，像一件外衣，","poem":1},{"lineBreak":true},{"text":"天地就都改變了。","poem":1},{"lineBreak":true},{"text":"惟有你永不改變；","poem":1},{"lineBreak":true},{"text":"你的年數沒有窮盡。","poem":1}]},{"type":"verse","number":13,"content":["所有的天使，上帝從來對哪一個說：",{"text":"你坐在我的右邊，","poem":1},{"lineBreak":true},{"text":"等我使你仇敵作你的腳凳？","poem":1}]},{"type":"verse","number":14,"content":["天使豈不都是服役的靈、奉差遣為那將要承受救恩的人效力嗎？"]}],"footnotes":[{"noteId":0,"caller":"-","text":"或譯：上帝再使長子到世上來的時候","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/cmn_cuv/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}