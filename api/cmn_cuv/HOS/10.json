{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cuv","name":"何西阿書","commonName":"何西阿書","title":"何西阿書","order":28,"numberOfChapters":14,"sha256":"c837f467a020938eec4ea2e106f9662e4fc510f07ebe6c3afbf22ab35e3647fb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cuv/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"以色列是茂盛的葡萄樹，結果繁多。","poem":1},{"lineBreak":true},{"text":"果子越多，就越增添祭壇；","poem":1},{"lineBreak":true},{"text":"地土越肥美，就越造美麗的柱像。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他們心懷二意，","poem":1},{"lineBreak":true},{"text":"現今要定為有罪。","poem":1},{"lineBreak":true},{"text":"耶和華必拆毀他們的祭壇，","poem":1},{"lineBreak":true},{"text":"毀壞他們的柱像。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"他們必說：我們沒有王，","poem":1},{"lineBreak":true},{"text":"因為我們不敬畏耶和華。","poem":1},{"lineBreak":true},{"text":"王能為我們做甚麼呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們為立約說謊言，起假誓；","poem":1},{"lineBreak":true},{"text":"因此，災罰如苦菜滋生在田間的犂溝中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"撒馬利亞的居民必因伯‧亞文的牛犢驚恐；","poem":1},{"lineBreak":true},{"text":"崇拜牛犢的民和喜愛牛犢的祭司","poem":1},{"lineBreak":true},{"text":"都必因榮耀離開它，為它悲哀。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"人必將牛犢帶到亞述當作禮物，","poem":1},{"lineBreak":true},{"text":"獻給耶雷布王。","poem":1},{"lineBreak":true},{"text":"以法蓮必蒙羞；","poem":1},{"lineBreak":true},{"text":"以色列必因自己的計謀慚愧。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"至於撒馬利亞，她的王必滅沒，","poem":1},{"lineBreak":true},{"text":"如水面的沫子一樣。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"伯‧亞文的邱壇－","poem":1},{"lineBreak":true},{"text":"就是以色列取罪的地方必被毀滅；","poem":1},{"lineBreak":true},{"text":"荊棘和蒺藜必長在他們的祭壇上。","poem":1},{"lineBreak":true},{"text":"他們必對大山說：遮蓋我們！","poem":1},{"lineBreak":true},{"text":"對小山說：倒在我們身上！","poem":1}]},{"type":"heading","content":["上帝審判以色列"]},{"type":"verse","number":9,"content":[{"text":"以色列啊，","poem":1},{"lineBreak":true},{"text":"你從基比亞的日子以來時常犯罪。","poem":1},{"lineBreak":true},{"text":"你們的先人曾站在那裏，","poem":1},{"lineBreak":true},{"text":"現今住基比亞的人","poem":1},{"lineBreak":true},{"text":"以為攻擊罪孽之輩的戰事臨不到自己。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我必隨意懲罰他們。","poem":1},{"lineBreak":true},{"text":"他們為兩樣的罪所纏；","poem":1},{"lineBreak":true},{"text":"列邦的民必聚集攻擊他們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"以法蓮是馴良的母牛犢，喜愛踹穀，","poem":1},{"lineBreak":true},{"text":"我卻將軛加在牠肥美的頸項上，","poem":1},{"lineBreak":true},{"text":"我要使以法蓮拉套","poem":1},{"noteId":15},{"text":"。","poem":1},{"lineBreak":true},{"text":"猶大必耕田；","poem":1},{"lineBreak":true},{"text":"雅各必耙地。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你們要為自己栽種公義，","poem":1},{"lineBreak":true},{"text":"就能收割慈愛。","poem":1},{"lineBreak":true},{"text":"現今正是尋求耶和華的時候；","poem":1},{"lineBreak":true},{"text":"你們要開墾荒地，等他臨到，","poem":1},{"lineBreak":true},{"text":"使公義如雨降在你們身上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"你們耕種的是奸惡，","poem":1},{"lineBreak":true},{"text":"收割的是罪孽，","poem":1},{"lineBreak":true},{"text":"吃的是謊話的果子。","poem":1},{"lineBreak":true},{"text":"因你倚靠自己的行為，","poem":1},{"lineBreak":true},{"text":"仰賴勇士眾多，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"所以在這民中必有鬨嚷之聲，","poem":1},{"lineBreak":true},{"text":"你一切的保障必被拆毀，","poem":1},{"lineBreak":true},{"text":"就如沙勒幔在爭戰的日子拆毀伯‧亞比勒，","poem":1},{"lineBreak":true},{"text":"將其中的母子一同摔死。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因他們的大惡，","poem":1},{"lineBreak":true},{"text":"伯特利必使你們遭遇如此。","poem":1},{"lineBreak":true},{"text":"到了黎明，以色列的王必全然滅絕。","poem":1}]}],"footnotes":[{"noteId":15,"caller":"-","text":"或譯：被騎","reference":{"chapter":10,"verse":11}}]},"thisChapterLink":"/api/cmn_cuv/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}