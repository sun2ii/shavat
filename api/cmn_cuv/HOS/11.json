{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cuv","name":"何西阿書","commonName":"何西阿書","title":"何西阿書","order":28,"numberOfChapters":14,"sha256":"c837f467a020938eec4ea2e106f9662e4fc510f07ebe6c3afbf22ab35e3647fb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cuv/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":11,"content":[{"type":"heading","content":["憐愛叛民"]},{"type":"verse","number":1,"content":[{"text":"以色列年幼的時候，我愛他，","poem":1},{"lineBreak":true},{"text":"就從埃及召出我的兒子來。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"先知越發招呼他們，","poem":1},{"lineBreak":true},{"text":"他們越發走開，","poem":1},{"lineBreak":true},{"text":"向諸巴力獻祭，","poem":1},{"lineBreak":true},{"text":"給雕刻的偶像燒香。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我原教導以法蓮行走，","poem":1},{"lineBreak":true},{"text":"用膀臂抱着他們，","poem":1},{"lineBreak":true},{"text":"他們卻不知道是我醫治他們。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我用慈繩","poem":1},{"noteId":16},{"text":"愛索牽引他們；","poem":1},{"lineBreak":true},{"text":"我待他們如人放鬆牛的兩腮夾板，","poem":1},{"lineBreak":true},{"text":"把糧食放在他們面前。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"他們必不歸回埃及地，","poem":1},{"lineBreak":true},{"text":"亞述人卻要作他們的王，","poem":1},{"lineBreak":true},{"text":"因他們不肯歸向我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"刀劍必臨到他們的城邑，","poem":1},{"lineBreak":true},{"text":"毀壞門閂，把人吞滅，","poem":1},{"lineBreak":true},{"text":"都因他們隨從自己的計謀。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的民偏要背道離開我；","poem":1},{"lineBreak":true},{"text":"眾先知雖然招呼他們歸向至上的主，","poem":1},{"lineBreak":true},{"text":"卻無人尊崇主。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"以法蓮哪，我怎能捨棄你？","poem":1},{"lineBreak":true},{"text":"以色列啊，我怎能棄絕你？","poem":1},{"lineBreak":true},{"text":"我怎能使你如押瑪？","poem":1},{"lineBreak":true},{"text":"怎能使你如洗扁？","poem":1},{"lineBreak":true},{"text":"我回心轉意，","poem":1},{"lineBreak":true},{"text":"我的憐愛大大發動。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我必不發猛烈的怒氣，","poem":1},{"lineBreak":true},{"text":"也不再毀滅以法蓮。","poem":1},{"lineBreak":true},{"text":"因我是上帝，並非世人，","poem":1},{"lineBreak":true},{"text":"是你們中間的聖者；","poem":1},{"lineBreak":true},{"text":"我必不在怒中臨到你們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和華必如獅子吼叫，","poem":1},{"lineBreak":true},{"text":"子民必跟隨他。","poem":1},{"lineBreak":true},{"text":"他一吼叫，","poem":1},{"lineBreak":true},{"text":"他們就從西方急速而來。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們必如雀鳥從埃及急速而來，","poem":1},{"lineBreak":true},{"text":"又如鴿子從亞述地來到。","poem":1},{"lineBreak":true},{"text":"我必使他們住自己的房屋。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"heading","content":["以色列和猶大受譴責"]},{"type":"verse","number":12,"content":[{"text":"以法蓮用謊話，","poem":1},{"lineBreak":true},{"text":"以色列家用詭計圍繞我；","poem":1},{"lineBreak":true},{"text":"猶大卻靠上帝掌權，","poem":1},{"lineBreak":true},{"text":"向聖者有忠心","poem":1},{"noteId":17},{"text":"。","poem":1}]}],"footnotes":[{"noteId":16,"caller":"-","text":"慈：原文是人的","reference":{"chapter":11,"verse":4}},{"noteId":17,"caller":"-","text":"或譯：猶大向上帝，向誠實的聖者猶疑不定","reference":{"chapter":11,"verse":12}}]},"thisChapterLink":"/api/cmn_cuv/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}