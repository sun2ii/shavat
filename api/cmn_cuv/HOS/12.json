{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cuv","name":"何西阿書","commonName":"何西阿書","title":"何西阿書","order":28,"numberOfChapters":14,"sha256":"c837f467a020938eec4ea2e106f9662e4fc510f07ebe6c3afbf22ab35e3647fb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cuv/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"以法蓮吃風，且追趕東風，","poem":1},{"lineBreak":true},{"text":"時常增添虛謊和強暴，","poem":1},{"lineBreak":true},{"text":"與亞述立約，把油送到埃及。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"耶和華與猶大爭辯，","poem":1},{"lineBreak":true},{"text":"必照雅各所行的懲罰他，","poem":1},{"lineBreak":true},{"text":"按他所做的報應他。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他在腹中抓住哥哥的腳跟，","poem":1},{"lineBreak":true},{"text":"壯年的時候與上帝較力，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"與天使較力，並且得勝，","poem":1},{"lineBreak":true},{"text":"哭泣懇求，","poem":1},{"lineBreak":true},{"text":"在伯特利遇見耶和華。","poem":1},{"lineBreak":true},{"text":"耶和華－萬軍之上帝在那裏曉諭我們以色列人；","poem":1},{"lineBreak":true},{"text":"耶和華是他可記念的名。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"所以你當歸向你的上帝，","poem":1},{"lineBreak":true},{"text":"謹守仁愛、公平，常常等候你的上帝。","poem":1}]},{"type":"heading","content":["其他的判詞"]},{"type":"verse","number":7,"content":[{"text":"以法蓮是商人，","poem":1},{"lineBreak":true},{"text":"手裏有詭詐的天平，愛行欺騙。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"以法蓮說：","poem":1},{"lineBreak":true},{"text":"我果然成了富足，得了財寶；","poem":1},{"lineBreak":true},{"text":"我所勞碌得來的，","poem":1},{"lineBreak":true},{"text":"人必不見有甚麼不義，可算為罪的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"自從你出埃及地以來，","poem":1},{"lineBreak":true},{"text":"我就是耶和華－你的上帝；","poem":1},{"lineBreak":true},{"text":"我必使你再住帳棚，如在大會的日子一樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"我已曉諭眾先知，","poem":1},{"lineBreak":true},{"text":"並且加增默示，","poem":1},{"lineBreak":true},{"text":"藉先知設立比喻。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"基列人沒有罪孽嗎？","poem":1},{"lineBreak":true},{"text":"他們全然是虛假的。","poem":1},{"lineBreak":true},{"text":"人在吉甲獻牛犢為祭，","poem":1},{"lineBreak":true},{"text":"他們的祭壇好像田間犂溝中的亂堆。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"從前雅各逃到亞蘭地，","poem":1},{"lineBreak":true},{"text":"以色列為得妻服事人，","poem":1},{"lineBreak":true},{"text":"為得妻與人放羊。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華藉先知領以色列從埃及上來；","poem":1},{"lineBreak":true},{"text":"以色列也藉先知而得保存。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"以法蓮大大惹動主怒，","poem":1},{"lineBreak":true},{"text":"所以他流血的罪必歸在他身上。","poem":1},{"lineBreak":true},{"text":"主必將那因以法蓮所受的羞辱歸還他。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":13}