{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cuv","name":"何西阿書","commonName":"何西阿書","title":"何西阿書","order":28,"numberOfChapters":14,"sha256":"c837f467a020938eec4ea2e106f9662e4fc510f07ebe6c3afbf22ab35e3647fb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cuv/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":13,"content":[{"type":"heading","content":["以色列最後的審判"]},{"type":"verse","number":1,"content":[{"text":"從前以法蓮說話，人都戰兢，","poem":1},{"lineBreak":true},{"text":"他在以色列中居處高位；","poem":1},{"lineBreak":true},{"text":"但他在事奉巴力的事上犯罪就死了。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"現今他們罪上加罪，","poem":1},{"lineBreak":true},{"text":"用銀子為自己鑄造偶像，","poem":1},{"lineBreak":true},{"text":"就是照自己的聰明製造，","poem":1},{"lineBreak":true},{"text":"都是匠人的工作。","poem":1},{"lineBreak":true},{"text":"有人論說，","poem":1},{"lineBreak":true},{"text":"獻祭的人可以向牛犢親嘴。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因此，他們必如早晨的雲霧，","poem":1},{"lineBreak":true},{"text":"又如速散的甘露，","poem":1},{"lineBreak":true},{"text":"像場上的糠詷被狂風吹去，","poem":1},{"lineBreak":true},{"text":"又像煙氣騰於窗外。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"自從你出埃及地以來，","poem":1},{"lineBreak":true},{"text":"我就是耶和華－你的上帝。","poem":1},{"lineBreak":true},{"text":"在我以外，你不可認識別神；","poem":1},{"lineBreak":true},{"text":"除我以外並沒有救主。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我曾在曠野乾旱之地認識你。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"這些民照我所賜的食物得了飽足；","poem":1},{"lineBreak":true},{"text":"既得飽足，心就高傲，","poem":1},{"lineBreak":true},{"text":"忘記了我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因此，我向他們如獅子，","poem":1},{"lineBreak":true},{"text":"又如豹伏在道旁。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我遇見他們必像丟崽子的母熊，","poem":1},{"lineBreak":true},{"text":"撕裂他們的胸膛","poem":1},{"noteId":18},{"text":"。","poem":1},{"lineBreak":true},{"text":"在那裏，我必像母獅吞吃他們；","poem":1},{"lineBreak":true},{"text":"野獸必撕裂他們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"以色列啊，你與我反對，","poem":1},{"lineBreak":true},{"text":"就是反對幫助你的，自取敗壞。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你曾求我說：","poem":1},{"lineBreak":true},{"text":"給我立王和首領。","poem":1},{"lineBreak":true},{"text":"現在你的王在哪裏呢？","poem":1},{"lineBreak":true},{"text":"治理你的在哪裏呢？","poem":1},{"lineBreak":true},{"text":"讓他在你所有的城中拯救你吧！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我在怒氣中將王賜你，","poem":1},{"lineBreak":true},{"text":"又在烈怒中將王廢去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"以法蓮的罪孽包裹；","poem":1},{"lineBreak":true},{"text":"他的罪惡收藏。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"產婦的疼痛必臨到他身上；","poem":1},{"lineBreak":true},{"text":"他是無智慧之子，","poem":1},{"lineBreak":true},{"text":"到了產期不當遲延。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我必救贖他們脫離陰間，","poem":1},{"lineBreak":true},{"text":"救贖他們脫離死亡。","poem":1},{"lineBreak":true},{"text":"死亡啊，你的災害在哪裏呢？","poem":1},{"lineBreak":true},{"text":"陰間哪，你的毀滅在哪裏呢？","poem":1},{"lineBreak":true},{"text":"在我眼前絕無後悔之事。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他在弟兄中雖然茂盛，","poem":1},{"lineBreak":true},{"text":"必有東風颳來，","poem":1},{"lineBreak":true},{"text":"就是耶和華的風從曠野上來。","poem":1},{"lineBreak":true},{"text":"他的泉源必乾；","poem":1},{"lineBreak":true},{"text":"他的源頭必竭；","poem":1},{"lineBreak":true},{"text":"仇敵必擄掠他所積蓄的一切寶器。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"撒馬利亞必擔當自己的罪，","poem":1},{"lineBreak":true},{"text":"因為悖逆她的上帝。","poem":1},{"lineBreak":true},{"text":"她必倒在刀下；","poem":1},{"lineBreak":true},{"text":"嬰孩必被摔死；","poem":1},{"lineBreak":true},{"text":"孕婦必被剖開。","poem":1}]}],"footnotes":[{"noteId":18,"caller":"-","text":"或譯：心膜","reference":{"chapter":13,"verse":8}}]},"thisChapterLink":"/api/cmn_cuv/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}