{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cuv","name":"何西阿書","commonName":"何西阿書","title":"何西阿書","order":28,"numberOfChapters":14,"sha256":"c837f467a020938eec4ea2e106f9662e4fc510f07ebe6c3afbf22ab35e3647fb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cuv/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"眾祭司啊，要聽我的話！","poem":1},{"lineBreak":true},{"text":"以色列家啊，要留心聽！","poem":1},{"lineBreak":true},{"text":"王家啊，要側耳而聽！","poem":1},{"lineBreak":true},{"text":"審判要臨到你們，","poem":1},{"lineBreak":true},{"text":"因你們在米斯巴如網羅，","poem":1},{"lineBreak":true},{"text":"在他泊山如鋪張的網。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"這些悖逆的人肆行殺戮，","poem":1},{"lineBreak":true},{"text":"罪孽極深；","poem":1},{"lineBreak":true},{"text":"我卻斥責他們眾人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"以法蓮為我所知；","poem":1},{"lineBreak":true},{"text":"以色列不能向我隱藏。","poem":1},{"lineBreak":true},{"text":"以法蓮哪，現在你行淫了，","poem":1},{"lineBreak":true},{"text":"以色列被玷污了。","poem":1}]},{"type":"heading","content":["何西阿警告拜偶像的人"]},{"type":"verse","number":4,"content":[{"text":"他們所行的使他們不能歸向上帝；","poem":1},{"lineBreak":true},{"text":"因有淫心在他們裏面，","poem":1},{"lineBreak":true},{"text":"他們也不認識耶和華。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"以色列的驕傲當面見證自己。","poem":1},{"lineBreak":true},{"text":"故此，以色列和以法蓮必因自己的罪孽跌倒；","poem":1},{"lineBreak":true},{"text":"猶大也必與他們一同跌倒。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們必牽着牛羊去尋求耶和華，卻尋不見；","poem":1},{"lineBreak":true},{"text":"他已經轉去離開他們。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們向耶和華行事詭詐，生了私子。","poem":1},{"lineBreak":true},{"text":"到了月朔，他們與他們的地業必被吞滅。","poem":1}]},{"type":"heading","content":["猶大和以色列的戰爭"]},{"type":"verse","number":8,"content":[{"text":"你們當在基比亞吹角，","poem":1},{"lineBreak":true},{"text":"在拉瑪吹號，","poem":1},{"lineBreak":true},{"text":"在伯‧亞文吹出大聲，說：","poem":1},{"lineBreak":true},{"text":"便雅憫哪，有仇敵在你後頭！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"在責罰的日子，以法蓮必變為荒場；","poem":1},{"lineBreak":true},{"text":"我在以色列支派中，指示將來必成的事。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"猶大的首領如同挪移地界的人，","poem":1},{"lineBreak":true},{"text":"我必將忿怒倒在他們身上，如水一般。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"以法蓮因樂從人的命令，","poem":1},{"lineBreak":true},{"text":"就受欺壓，被審判壓碎。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我使以法蓮如蟲蛀之物，","poem":1},{"lineBreak":true},{"text":"使猶大家如朽爛之木。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"以法蓮見自己有病，","poem":1},{"lineBreak":true},{"text":"猶大見自己有傷，","poem":1},{"lineBreak":true},{"text":"他們就打發人往亞述去見耶雷布王，","poem":1},{"lineBreak":true},{"text":"他卻不能醫治你們，","poem":1},{"lineBreak":true},{"text":"不能治好你們的傷。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我必向以法蓮如獅子，","poem":1},{"lineBreak":true},{"text":"向猶大家如少壯獅子。","poem":1},{"lineBreak":true},{"text":"我必撕裂而去，","poem":1},{"lineBreak":true},{"text":"我要奪去，無人搭救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"我要回到原處，","poem":1},{"lineBreak":true},{"text":"等他們自覺有罪","poem":1},{"noteId":12},{"text":"，尋求我面；","poem":1},{"lineBreak":true},{"text":"他們在急難的時候必切切尋求我。","poem":1}]}],"footnotes":[{"noteId":12,"caller":"-","text":"或譯：承認己罪","reference":{"chapter":5,"verse":15}}]},"thisChapterLink":"/api/cmn_cuv/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}