{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cuv","name":"何西阿書","commonName":"何西阿書","title":"何西阿書","order":28,"numberOfChapters":14,"sha256":"c837f467a020938eec4ea2e106f9662e4fc510f07ebe6c3afbf22ab35e3647fb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cuv/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":6,"content":[{"type":"heading","content":["以色列無悔改誠意"]},{"type":"verse","number":1,"content":[{"text":"來吧，我們歸向耶和華！","poem":1},{"lineBreak":true},{"text":"他撕裂我們，也必醫治；","poem":1},{"lineBreak":true},{"text":"他打傷我們，也必纏裹。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"過兩天他必使我們甦醒，","poem":1},{"lineBreak":true},{"text":"第三天他必使我們興起，","poem":1},{"lineBreak":true},{"text":"我們就在他面前得以存活。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我們務要認識耶和華，","poem":1},{"lineBreak":true},{"text":"竭力追求認識他。","poem":1},{"lineBreak":true},{"text":"他出現確如晨光；","poem":1},{"lineBreak":true},{"text":"他必臨到我們像甘雨，","poem":1},{"lineBreak":true},{"text":"像滋潤田地的春雨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"主說：以法蓮哪，我可向你怎樣行呢？","poem":1},{"lineBreak":true},{"text":"猶大啊，我可向你怎樣做呢？","poem":1},{"lineBreak":true},{"text":"因為你們的良善如同早晨的雲霧，","poem":1},{"lineBreak":true},{"text":"又如速散的甘露。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因此，我藉先知砍伐他們，","poem":1},{"lineBreak":true},{"text":"以我口中的話殺戮他們；","poem":1},{"lineBreak":true},{"text":"我施行的審判如光發出。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我喜愛良善","poem":1},{"noteId":13},{"text":"，不喜愛祭祀；","poem":1},{"lineBreak":true},{"text":"喜愛認識上帝，勝於燔祭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"他們卻如亞當背約，","poem":1},{"lineBreak":true},{"text":"在境內向我行事詭詐。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"基列是作孽之人的城，","poem":1},{"lineBreak":true},{"text":"被血沾染。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"強盜成群，怎樣埋伏殺人，","poem":1},{"lineBreak":true},{"text":"祭司結黨，也照樣在示劍的路上殺戮，","poem":1},{"lineBreak":true},{"text":"行了邪惡。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"在以色列家，我見了可憎的事；","poem":1},{"lineBreak":true},{"text":"在以法蓮那裏有淫行，","poem":1},{"lineBreak":true},{"text":"以色列被玷污。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"猶大啊，我使被擄之民歸回的時候，","poem":1},{"lineBreak":true},{"text":"必有為你所命定的收場。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"或譯：憐恤","reference":{"chapter":6,"verse":6}}]},"thisChapterLink":"/api/cmn_cuv/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}