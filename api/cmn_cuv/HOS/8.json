{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"HOS","translationId":"cmn_cuv","name":"何西阿書","commonName":"何西阿書","title":"何西阿書","order":28,"numberOfChapters":14,"sha256":"c837f467a020938eec4ea2e106f9662e4fc510f07ebe6c3afbf22ab35e3647fb","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cuv/HOS/14.json","totalNumberOfVerses":196},"chapter":{"number":8,"content":[{"type":"heading","content":["以色列人因拜偶像被定罪"]},{"type":"verse","number":1,"content":[{"text":"你用口吹角吧！","poem":1},{"lineBreak":true},{"text":"敵人如鷹來攻打耶和華的家；","poem":1},{"lineBreak":true},{"text":"因為這民違背我的約，","poem":1},{"lineBreak":true},{"text":"干犯我的律法。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他們必呼叫我說：","poem":1},{"lineBreak":true},{"text":"我的上帝啊，我們以色列認識你了。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"以色列丟棄良善","poem":1},{"noteId":14},{"text":"；","poem":1},{"lineBreak":true},{"text":"仇敵必追逼他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他們立君王，卻不由我；","poem":1},{"lineBreak":true},{"text":"他們立首領，我卻不認。","poem":1},{"lineBreak":true},{"text":"他們用金銀為自己製造偶像，","poem":1},{"lineBreak":true},{"text":"以致被剪除。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"撒馬利亞啊，耶和華已經丟棄你的牛犢；","poem":1},{"lineBreak":true},{"text":"我的怒氣向拜牛犢的人發作。","poem":1},{"lineBreak":true},{"text":"他們到幾時方能無罪呢？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"這牛犢出於以色列，","poem":1},{"lineBreak":true},{"text":"是匠人所造的，並不是神。","poem":1},{"lineBreak":true},{"text":"撒馬利亞的牛犢必被打碎。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們所種的是風，所收的是暴風；","poem":1},{"lineBreak":true},{"text":"所種的不成禾稼，就是發苗也不結實；","poem":1},{"lineBreak":true},{"text":"即便結實，外邦人必吞吃。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"以色列被吞吃；","poem":1},{"lineBreak":true},{"text":"現今在列國中，好像人不喜悅的器皿。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們投奔亞述，如同獨行的野驢；","poem":1},{"lineBreak":true},{"text":"以法蓮賄買朋黨。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們雖在列邦中賄買人，","poem":1},{"lineBreak":true},{"text":"現在我卻要聚集懲罰他們；","poem":1},{"lineBreak":true},{"text":"他們因君王和首領所加的重擔日漸衰微。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"以法蓮增添祭壇取罪；","poem":1},{"lineBreak":true},{"text":"因此，祭壇使他犯罪。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我為他寫了律法萬條，","poem":1},{"lineBreak":true},{"text":"他卻以為與他毫無關涉。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"至於獻給我的祭物，","poem":1},{"lineBreak":true},{"text":"他們自食其肉，","poem":1},{"lineBreak":true},{"text":"耶和華卻不悅納他們。","poem":1},{"lineBreak":true},{"text":"現在必記念他們的罪孽，","poem":1},{"lineBreak":true},{"text":"追討他們的罪惡；","poem":1},{"lineBreak":true},{"text":"他們必歸回埃及。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"以色列忘記造他的主，建造宮殿；","poem":1},{"lineBreak":true},{"text":"猶大多造堅固城，","poem":1},{"lineBreak":true},{"text":"我卻要降火焚燒他的城邑，","poem":1},{"lineBreak":true},{"text":"燒滅其中的宮殿。","poem":1}]}],"footnotes":[{"noteId":14,"caller":"-","text":"或譯：福分","reference":{"chapter":8,"verse":3}}]},"thisChapterLink":"/api/cmn_cuv/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}