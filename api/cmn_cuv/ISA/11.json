{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":11,"content":[{"type":"heading","content":["和平的國度"]},{"type":"verse","number":1,"content":[{"text":"從耶西的本","poem":1},{"noteId":11},{"text":"必發一條；","poem":1},{"lineBreak":true},{"text":"從他根生的枝子必結果實。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華的靈必住在他身上，","poem":1},{"lineBreak":true},{"text":"就是使他有智慧和聰明的靈，","poem":1},{"lineBreak":true},{"text":"謀略和能力的靈，","poem":1},{"lineBreak":true},{"text":"知識和敬畏耶和華的靈。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他必以敬畏耶和華為樂；","poem":1},{"lineBreak":true},{"text":"行審判不憑眼見，","poem":1},{"lineBreak":true},{"text":"斷是非也不憑耳聞；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"卻要以公義審判貧窮人，","poem":1},{"lineBreak":true},{"text":"以正直判斷世上的謙卑人，","poem":1},{"lineBreak":true},{"text":"以口中的杖擊打世界，","poem":1},{"lineBreak":true},{"text":"以嘴裏的氣殺戮惡人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"公義必當他的腰帶；","poem":1},{"lineBreak":true},{"text":"信實必當他脅下的帶子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"豺狼必與綿羊羔同居，","poem":1},{"lineBreak":true},{"text":"豹子與山羊羔同臥；","poem":1},{"lineBreak":true},{"text":"少壯獅子與牛犢並肥畜同群；","poem":1},{"lineBreak":true},{"text":"小孩子要牽引牠們。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"牛必與熊同食；","poem":1},{"lineBreak":true},{"text":"牛犢必與小熊同臥；","poem":1},{"lineBreak":true},{"text":"獅子必吃草，與牛一樣。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"吃奶的孩子必玩耍在虺蛇的洞口；","poem":1},{"lineBreak":true},{"text":"斷奶的嬰兒必按手在毒蛇的穴上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"在我聖山的遍處，","poem":1},{"lineBreak":true},{"text":"這一切都不傷人，不害物；","poem":1},{"lineBreak":true},{"text":"因為認識耶和華的知識要充滿遍地，","poem":1},{"lineBreak":true},{"text":"好像水充滿洋海一般。","poem":1}]},{"type":"heading","content":["流亡的人回鄉"]},{"type":"verse","number":10,"content":["到那日，耶西的根立作萬民的大旗；外邦人必尋求他，他安息之所大有榮耀。"]},{"type":"verse","number":11,"content":["當那日，主必二次伸手救回自己百姓中所餘剩的，就是在亞述、埃及、巴忒羅、古實、以攔、示拿、哈馬，並眾海島所剩下的。"]},{"type":"verse","number":12,"content":[{"text":"他必向列國豎立大旗，","poem":1},{"lineBreak":true},{"text":"招回以色列被趕散的人，","poem":1},{"lineBreak":true},{"text":"又從地的四方聚集分散的猶大人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"以法蓮的嫉妒就必消散；","poem":1},{"lineBreak":true},{"text":"擾害猶大的必被剪除。","poem":1},{"lineBreak":true},{"text":"以法蓮必不嫉妒猶大，","poem":1},{"lineBreak":true},{"text":"猶大也不擾害以法蓮。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們要向西飛，","poem":1},{"lineBreak":true},{"text":"撲在非利士人的肩頭上","poem":1},{"noteId":12},{"text":"，","poem":1},{"lineBreak":true},{"text":"一同擄掠東方人，","poem":1},{"lineBreak":true},{"text":"伸手按住以東和摩押；","poem":1},{"lineBreak":true},{"text":"亞捫人也必順服他們。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和華必使埃及海汊枯乾，","poem":1},{"lineBreak":true},{"text":"掄手用暴熱的風使大河分為七條，","poem":1},{"lineBreak":true},{"text":"令人過去不致濕腳。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"為主餘剩的百姓，","poem":1},{"lineBreak":true},{"text":"就是從亞述剩下回來的，","poem":1},{"lineBreak":true},{"text":"必有一條大道，","poem":1},{"lineBreak":true},{"text":"如當日以色列從埃及地上來一樣。","poem":1}]}],"footnotes":[{"noteId":11,"caller":"-","text":"原文是墩","reference":{"chapter":11,"verse":1}},{"noteId":12,"caller":"-","text":"肩頭上：或譯西界","reference":{"chapter":11,"verse":14}}]},"thisChapterLink":"/api/cmn_cuv/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}