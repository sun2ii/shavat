{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":12,"content":[{"type":"heading","content":["感恩的詩歌"]},{"type":"verse","number":1,"content":["到那日，你必說：",{"text":"耶和華啊，我要稱謝你！","poem":1},{"lineBreak":true},{"text":"因為你雖然向我發怒，","poem":1},{"lineBreak":true},{"text":"你的怒氣卻已轉消；","poem":1},{"lineBreak":true},{"text":"你又安慰了我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"看哪！上帝是我的拯救；","poem":1},{"lineBreak":true},{"text":"我要倚靠他，並不懼怕。","poem":1},{"lineBreak":true},{"text":"因為主耶和華是我的力量，","poem":1},{"lineBreak":true},{"text":"是我的詩歌，","poem":1},{"lineBreak":true},{"text":"他也成了我的拯救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["所以，你們必從救恩的泉源歡然取水。"]},{"type":"verse","number":4,"content":["在那日，你們要說：",{"text":"當稱謝耶和華，求告他的名；","poem":1},{"lineBreak":true},{"text":"將他所行的傳揚在萬民中，","poem":1},{"lineBreak":true},{"text":"提說他的名已被尊崇。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你們要向耶和華唱歌，","poem":1},{"lineBreak":true},{"text":"因他所行的甚是美好；","poem":1},{"lineBreak":true},{"text":"但願這事普傳天下。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"錫安的居民哪，當揚聲歡呼，","poem":1},{"lineBreak":true},{"text":"因為在你們中間的以色列聖者乃為至大。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}