{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":13,"content":[{"type":"heading","content":["神要懲罰巴比倫"]},{"type":"verse","number":1,"content":["亞摩斯的兒子以賽亞得默示，論巴比倫。"]},{"type":"verse","number":2,"content":[{"text":"應當在淨光的山豎立大旗，","poem":1},{"lineBreak":true},{"text":"向群眾揚聲招手，","poem":1},{"lineBreak":true},{"text":"使他們進入貴冑的門。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我吩咐我所挑出來的人；","poem":1},{"lineBreak":true},{"text":"我招呼我的勇士－","poem":1},{"lineBreak":true},{"text":"就是那矜誇高傲之輩，","poem":1},{"lineBreak":true},{"text":"為要成就我怒中所定的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"山間有多人的聲音，","poem":1},{"lineBreak":true},{"text":"好像是大國人民。","poem":1},{"lineBreak":true},{"text":"有許多國的民聚集鬨嚷的聲音；","poem":1},{"lineBreak":true},{"text":"這是萬軍之耶和華點齊軍隊，預備打仗。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們從遠方來，","poem":1},{"lineBreak":true},{"text":"從天邊來，","poem":1},{"lineBreak":true},{"text":"就是耶和華並他惱恨的兵器","poem":1},{"lineBreak":true},{"text":"要毀滅這全地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"你們要哀號，","poem":1},{"lineBreak":true},{"text":"因為耶和華的日子臨近了！","poem":1},{"lineBreak":true},{"text":"這日來到，","poem":1},{"lineBreak":true},{"text":"好像毀滅從全能者來到。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"所以，人手都必軟弱；","poem":1},{"lineBreak":true},{"text":"人心都必消化。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們必驚惶悲痛；","poem":1},{"lineBreak":true},{"text":"愁苦必將他們抓住。","poem":1},{"lineBreak":true},{"text":"他們疼痛，好像產難的婦人一樣，","poem":1},{"lineBreak":true},{"text":"彼此驚奇相看，臉如火焰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和華的日子臨到，","poem":1},{"lineBreak":true},{"text":"必有殘忍、忿恨、烈怒，","poem":1},{"lineBreak":true},{"text":"使這地荒涼，","poem":1},{"lineBreak":true},{"text":"從其中除滅罪人。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"天上的眾星群宿都不發光；","poem":1},{"lineBreak":true},{"text":"日頭一出就變黑暗；","poem":1},{"lineBreak":true},{"text":"月亮也不放光。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我必因邪惡刑罰世界，","poem":1},{"lineBreak":true},{"text":"因罪孽刑罰惡人，","poem":1},{"lineBreak":true},{"text":"使驕傲人的狂妄止息，","poem":1},{"lineBreak":true},{"text":"制伏強暴人的狂傲。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我必使人比精金還少，","poem":1},{"lineBreak":true},{"text":"使人比俄斐純金更少。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我－萬軍之耶和華在忿恨中發烈怒的日子，","poem":1},{"lineBreak":true},{"text":"必使天震動，","poem":1},{"lineBreak":true},{"text":"使地搖撼，離其本位。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人必像被追趕的鹿，","poem":1},{"lineBreak":true},{"text":"像無人收聚的羊，","poem":1},{"lineBreak":true},{"text":"各歸回本族，","poem":1},{"lineBreak":true},{"text":"各逃到本土。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"凡被仇敵追上的必被刺死；","poem":1},{"lineBreak":true},{"text":"凡被捉住的必被刀殺。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他們的嬰孩必在他們眼前摔碎；","poem":1},{"lineBreak":true},{"text":"他們的房屋必被搶奪；","poem":1},{"lineBreak":true},{"text":"他們的妻子必被玷污。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"我必激動米底亞人來攻擊他們。","poem":1},{"lineBreak":true},{"text":"米底亞人不注重銀子，","poem":1},{"lineBreak":true},{"text":"也不喜愛金子。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他們必用弓擊碎少年人，","poem":1},{"lineBreak":true},{"text":"不憐憫婦人所生的，","poem":1},{"lineBreak":true},{"text":"眼也不顧惜孩子。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"巴比倫素來為列國的榮耀，","poem":1},{"lineBreak":true},{"text":"為迦勒底人所矜誇的華美，","poem":1},{"lineBreak":true},{"text":"必像上帝所傾覆的所多瑪、蛾摩拉一樣。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"其內必永無人煙，","poem":1},{"lineBreak":true},{"text":"世世代代無人居住。","poem":1},{"lineBreak":true},{"text":"阿拉伯人也不在那裏支搭帳棚；","poem":1},{"lineBreak":true},{"text":"牧羊的人也不使羊群臥在那裏。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"只有曠野的走獸臥在那裏；","poem":1},{"lineBreak":true},{"text":"咆哮的獸滿了房屋。","poem":1},{"lineBreak":true},{"text":"鴕鳥住在那裏；","poem":1},{"lineBreak":true},{"text":"野山羊在那裏跳舞。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"豺狼必在它宮中呼號；","poem":1},{"lineBreak":true},{"text":"野狗必在它華美殿內吼叫。","poem":1},{"lineBreak":true},{"text":"巴比倫受罰的時候臨近；","poem":1},{"lineBreak":true},{"text":"它的日子必不長久。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}