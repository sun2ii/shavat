{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":14,"content":[{"type":"heading","content":["從流亡中歸回"]},{"type":"verse","number":1,"content":["耶和華要憐恤雅各，必再揀選以色列，將他們安置在本地。寄居的必與他們聯合，緊貼雅各家。"]},{"type":"verse","number":2,"content":["外邦人必將他們帶回本土；以色列家必在耶和華的地上得外邦人為僕婢，也要擄掠先前擄掠他們的，轄制先前欺壓他們的。"]},{"type":"heading","content":["巴比倫王下到陰間"]},{"type":"verse","number":3,"content":["當耶和華使你脫離愁苦、煩惱，並人勉強你做的苦工，得享安息的日子，"]},{"type":"verse","number":4,"content":["你必題這詩歌論巴比倫王說：",{"text":"欺壓人的何竟熄滅？","poem":1},{"lineBreak":true},{"text":"強暴的何竟止息？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華折斷了惡人的杖，","poem":1},{"lineBreak":true},{"text":"轄制人的圭，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"就是在忿怒中連連攻擊眾民的，","poem":1},{"lineBreak":true},{"text":"在怒氣中轄制列國，","poem":1},{"lineBreak":true},{"text":"行逼迫無人阻止的。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"現在全地得安息，享平靜；","poem":1},{"lineBreak":true},{"text":"人皆發聲歡呼。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"松樹和黎巴嫩的香柏樹","poem":1},{"lineBreak":true},{"text":"都因你歡樂，說：","poem":1},{"lineBreak":true},{"text":"自從你仆倒，","poem":1},{"lineBreak":true},{"text":"再無人上來砍伐我們。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你下到陰間，","poem":1},{"lineBreak":true},{"text":"陰間就因你震動來迎接你，","poem":1},{"lineBreak":true},{"text":"又因你驚動在世曾為首領的陰魂，","poem":1},{"lineBreak":true},{"text":"並使那曾為列國君王的，","poem":1},{"lineBreak":true},{"text":"都離位站起。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們都要發言對你說：","poem":1},{"lineBreak":true},{"text":"你也變為軟弱像我們一樣嗎？","poem":1},{"lineBreak":true},{"text":"你也成了我們的樣子嗎？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你的威勢和你琴瑟的聲音都下到陰間。","poem":1},{"lineBreak":true},{"text":"你下鋪的是蟲，上蓋的是蛆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"明亮之星，早晨之子啊，","poem":1},{"lineBreak":true},{"text":"你何竟從天墜落？","poem":1},{"lineBreak":true},{"text":"你這攻敗列國的何竟被砍倒在地上？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你心裏曾說：","poem":1},{"lineBreak":true},{"text":"我要升到天上；","poem":1},{"lineBreak":true},{"text":"我要高舉我的寶座在上帝眾星以上；","poem":1},{"lineBreak":true},{"text":"我要坐在聚會的山上，在北方的極處。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我要升到高雲之上；","poem":1},{"lineBreak":true},{"text":"我要與至上者同等。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"然而，你必墜落陰間，","poem":1},{"lineBreak":true},{"text":"到坑中極深之處。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"凡看見你的都要定睛看你，","poem":1},{"lineBreak":true},{"text":"留意看你，說：","poem":1},{"lineBreak":true},{"text":"使大地戰抖，","poem":1},{"lineBreak":true},{"text":"使列國震動，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"使世界如同荒野，","poem":1},{"lineBreak":true},{"text":"使城邑傾覆，","poem":1},{"lineBreak":true},{"text":"不釋放被擄的人歸家，","poem":1},{"lineBreak":true},{"text":"是這個人嗎？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"列國的君王","poem":1},{"lineBreak":true},{"text":"俱各在自己陰宅的榮耀中安睡。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"惟獨你被拋棄，","poem":1},{"lineBreak":true},{"text":"不得入你的墳墓，","poem":1},{"lineBreak":true},{"text":"好像可憎的枝子，","poem":1},{"lineBreak":true},{"text":"以被殺的人為衣，","poem":1},{"lineBreak":true},{"text":"就是被刀刺透，","poem":1},{"lineBreak":true},{"text":"墜落坑中石頭那裏的；","poem":1},{"lineBreak":true},{"text":"你又像被踐踏的屍首一樣。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你不得與君王同葬；","poem":1},{"lineBreak":true},{"text":"因為你敗壞你的國，殺戮你的民。","poem":1},{"lineBreak":true},{"text":"惡人後裔的名，必永不提說。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"先人既有罪孽，","poem":1},{"lineBreak":true},{"text":"就要預備殺戮他的子孫，","poem":1},{"lineBreak":true},{"text":"免得他們興起來，得了遍地，","poem":1},{"lineBreak":true},{"text":"在世上修滿城邑。","poem":1}]},{"type":"heading","content":["上帝要毀滅巴比倫"]},{"type":"verse","number":22,"content":[{"text":"萬軍之耶和華說：","poem":1},{"lineBreak":true},{"text":"我必興起攻擊他們，","poem":1},{"lineBreak":true},{"text":"將巴比倫的名號和所餘剩的人，","poem":1},{"lineBreak":true},{"text":"連子帶孫一併剪除。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我必使巴比倫為箭豬所得，","poem":1},{"lineBreak":true},{"text":"又變為水池；","poem":1},{"lineBreak":true},{"text":"我要用滅亡的掃帚掃淨它。","poem":1},{"lineBreak":true},{"text":"這是萬軍之耶和華說的。","poem":1}]},{"type":"heading","content":["上帝要毀滅亞述"]},{"type":"verse","number":24,"content":[{"text":"萬軍之耶和華起誓說：","poem":1},{"lineBreak":true},{"text":"我怎樣思想，必照樣成就；","poem":1},{"lineBreak":true},{"text":"我怎樣定意，必照樣成立，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"就是在我地上打折亞述人，","poem":1},{"lineBreak":true},{"text":"在我山上將他踐踏。","poem":1},{"lineBreak":true},{"text":"他加的軛必離開以色列人；","poem":1},{"lineBreak":true},{"text":"他加的重擔必離開他們的肩頭。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"這是向全地所定的旨意；","poem":1},{"lineBreak":true},{"text":"這是向萬國所伸出的手。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"萬軍之耶和華既然定意，誰能廢棄呢？","poem":1},{"lineBreak":true},{"text":"他的手已經伸出，誰能轉回呢？","poem":1}]},{"type":"heading","content":["上帝要毀滅非利士"]},{"type":"verse","number":28,"content":[{"text":"亞哈斯王崩的那年，就有以下的默示：","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"非利士全地啊，","poem":1},{"lineBreak":true},{"text":"不要因擊打你的杖折斷就喜樂。","poem":1},{"lineBreak":true},{"text":"因為從蛇的根必生出毒蛇；","poem":1},{"lineBreak":true},{"text":"牠所生的是火焰的飛龍。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"貧寒人的長子必有所食；","poem":1},{"lineBreak":true},{"text":"窮乏人必安然躺臥。","poem":1},{"lineBreak":true},{"text":"我必以饑荒治死你的根；","poem":1},{"lineBreak":true},{"text":"你所餘剩的人必被殺戮。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"門哪，應當哀號！","poem":1},{"lineBreak":true},{"text":"城啊，應當呼喊！","poem":1},{"lineBreak":true},{"text":"非利士全地啊，你都消化了！","poem":1},{"lineBreak":true},{"text":"因為有煙從北方出來，","poem":1},{"lineBreak":true},{"text":"他行伍中並無亂隊的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"可怎樣回答外邦","poem":1},{"noteId":13},{"text":"的使者呢？","poem":1},{"lineBreak":true},{"text":"必說：耶和華建立了錫安；","poem":1},{"lineBreak":true},{"text":"他百姓中的困苦人必投奔在其中。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"或指非利士","reference":{"chapter":14,"verse":32}}]},"thisChapterLink":"/api/cmn_cuv/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}