{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":15,"content":[{"type":"heading","content":["上帝要毀滅摩押"]},{"type":"verse","number":1,"content":["論摩押的默示：",{"text":"一夜之間，摩押的亞珥變為荒廢，","poem":1},{"lineBreak":true},{"text":"歸於無有；","poem":1},{"lineBreak":true},{"text":"一夜之間，摩押的基珥變為荒廢，","poem":1},{"lineBreak":true},{"text":"歸於無有。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他們上巴益，又往底本，","poem":1},{"lineBreak":true},{"text":"到高處去哭泣。","poem":1},{"lineBreak":true},{"text":"摩押人因尼波和米底巴哀號，","poem":1},{"lineBreak":true},{"text":"各人頭上光禿，","poem":1},{"lineBreak":true},{"text":"鬍鬚剃淨。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們在街市上都腰束麻布，","poem":1},{"lineBreak":true},{"text":"在房頂上和寬闊處俱各哀號，","poem":1},{"lineBreak":true},{"text":"眼淚汪汪。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"希實本和以利亞利悲哀的聲音達到雅雜，","poem":1},{"lineBreak":true},{"text":"所以摩押帶兵器的高聲喊嚷，","poem":1},{"lineBreak":true},{"text":"人心戰兢。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我心為摩押悲哀；","poem":1},{"lineBreak":true},{"text":"他的貴冑","poem":1},{"noteId":14},{"text":"逃到瑣珥，","poem":1},{"lineBreak":true},{"text":"到伊基拉‧施利施亞。","poem":1},{"lineBreak":true},{"text":"他們上魯希坡，隨走隨哭；","poem":1},{"lineBreak":true},{"text":"在何羅念的路上，因毀滅舉起哀聲。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因為寧林的水成為乾涸，","poem":1},{"lineBreak":true},{"text":"青草枯乾，嫩草滅沒，","poem":1},{"lineBreak":true},{"text":"青綠之物，一無所有。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因此，摩押人所得的財物","poem":1},{"lineBreak":true},{"text":"和所積蓄的都要運過柳樹河。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"哀聲遍聞摩押的四境；","poem":1},{"lineBreak":true},{"text":"哀號的聲音達到以基蓮；","poem":1},{"lineBreak":true},{"text":"哀號的聲音達到比珥‧以琳。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"底們的水充滿了血；","poem":1},{"lineBreak":true},{"text":"我還要加增底們的災難，","poem":1},{"lineBreak":true},{"text":"叫獅子來追上摩押逃脫的民","poem":1},{"lineBreak":true},{"text":"和那地上所餘剩的人。","poem":1}]}],"footnotes":[{"noteId":14,"caller":"-","text":"或譯：逃民","reference":{"chapter":15,"verse":5}}]},"thisChapterLink":"/api/cmn_cuv/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}