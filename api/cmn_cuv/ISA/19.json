{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":19,"content":[{"type":"heading","content":["上帝要懲罰埃及"]},{"type":"verse","number":1,"content":["論埃及的默示：",{"text":"看哪，耶和華乘駕快雲，","poem":1},{"lineBreak":true},{"text":"臨到埃及。","poem":1},{"lineBreak":true},{"text":"埃及的偶像在他面前戰兢；","poem":1},{"lineBreak":true},{"text":"埃及人的心在裏面消化。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我必激動埃及人攻擊埃及人－","poem":1},{"lineBreak":true},{"text":"弟兄攻擊弟兄，","poem":1},{"lineBreak":true},{"text":"鄰舍攻擊鄰舍；","poem":1},{"lineBreak":true},{"text":"這城攻擊那城，","poem":1},{"lineBreak":true},{"text":"這國攻擊那國。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"埃及人的心神必在裏面耗盡；","poem":1},{"lineBreak":true},{"text":"我必敗壞他們的謀略。","poem":1},{"lineBreak":true},{"text":"他們必求問偶像和念咒的、","poem":1},{"lineBreak":true},{"text":"交鬼的、行巫術的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我必將埃及人交在殘忍主的手中；","poem":1},{"lineBreak":true},{"text":"強暴王必轄制他們。","poem":1},{"lineBreak":true},{"text":"這是主－萬軍之耶和華說的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"海中的水必絕盡，","poem":1},{"lineBreak":true},{"text":"河也消沒乾涸。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"江河要變臭；","poem":1},{"lineBreak":true},{"text":"埃及的河水都必減少枯乾。","poem":1},{"lineBreak":true},{"text":"葦子和蘆荻都必衰殘；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"靠尼羅河旁的草田，","poem":1},{"lineBreak":true},{"text":"並沿尼羅河所種的田，都必枯乾。","poem":1},{"lineBreak":true},{"text":"莊稼被風吹去，歸於無有。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"打魚的必哀哭。","poem":1},{"lineBreak":true},{"text":"在尼羅河一切釣魚的必悲傷；","poem":1},{"lineBreak":true},{"text":"在水上撒網的必都衰弱。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"用梳好的麻造物的","poem":1},{"lineBreak":true},{"text":"和織白布的都必羞愧；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"國柱必被打碎，","poem":1},{"lineBreak":true},{"text":"所有傭工的，心必愁煩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"瑣安的首領極其愚昧；","poem":1},{"lineBreak":true},{"text":"法老大有智慧的謀士，","poem":1},{"lineBreak":true},{"text":"所籌劃的成為愚謀。","poem":1},{"lineBreak":true},{"text":"你們怎敢對法老說：","poem":1},{"lineBreak":true},{"text":"我是智慧人的子孫，","poem":1},{"lineBreak":true},{"text":"我是古王的後裔？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你的智慧人在哪裏呢？","poem":1},{"lineBreak":true},{"text":"萬軍之耶和華向埃及所定的旨意，","poem":1},{"lineBreak":true},{"text":"他們可以知道，可以告訴你吧！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"瑣安的首領都變為愚昧；","poem":1},{"lineBreak":true},{"text":"挪弗的首領都受了迷惑。","poem":1},{"lineBreak":true},{"text":"當埃及支派房角石的，","poem":1},{"lineBreak":true},{"text":"使埃及人走錯了路。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華使乖謬的靈攙入埃及中間；","poem":1},{"lineBreak":true},{"text":"首領使埃及一切所做的都有差錯，","poem":1},{"lineBreak":true},{"text":"好像醉酒之人嘔吐的時候東倒西歪一樣。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"埃及中，無論是頭與尾，","poem":1},{"lineBreak":true},{"text":"棕枝與蘆葦，所做之工都不成就。","poem":1}]},{"type":"verse","number":16,"content":["到那日，埃及人必像婦人一樣，他們必因萬軍之耶和華在埃及以上所掄的手，戰兢懼怕。"]},{"type":"verse","number":17,"content":["猶大地必使埃及驚恐，向誰提起猶大地，誰就懼怕。這是因萬軍之耶和華向埃及所定的旨意。"]},{"type":"verse","number":18,"content":["當那日，埃及地必有五城的人說迦南的方言，又指着萬軍之耶和華起誓。有一城必稱為「滅亡城」。"]},{"type":"verse","number":19,"content":["當那日，在埃及地中必有為耶和華築的一座壇；在埃及的邊界上必有為耶和華立的一根柱。"]},{"type":"verse","number":20,"content":["這都要在埃及地為萬軍之耶和華作記號和證據。埃及人因為受人的欺壓哀求耶和華，他就差遣一位救主作護衛者，拯救他們。"]},{"type":"verse","number":21,"content":["耶和華必被埃及人所認識。在那日，埃及人必認識耶和華，也要獻祭物和供物敬拜他，並向耶和華許願還願。"]},{"type":"verse","number":22,"content":["耶和華必擊打埃及，又擊打又醫治，埃及人就歸向耶和華。他必應允他們的禱告，醫治他們。"]},{"type":"verse","number":23,"content":["當那日，必有從埃及通亞述去的大道。亞述人要進入埃及，埃及人也進入亞述；埃及人要與亞述人一同敬拜耶和華。"]},{"type":"verse","number":24,"content":["當那日，以色列必與埃及、亞述三國一律，使地上的人得福；"]},{"type":"verse","number":25,"content":["因為萬軍之耶和華賜福給他們，說：「埃及－我的百姓，亞述－我手的工作，以色列－我的產業，都有福了！」"]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}