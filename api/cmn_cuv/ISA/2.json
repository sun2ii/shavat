{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":2,"content":[{"type":"heading","content":["永恆的和平"]},{"type":"verse","number":1,"content":["亞摩斯的兒子以賽亞得默示，論到猶大和耶路撒冷。"]},{"type":"verse","number":2,"content":[{"text":"末後的日子，耶和華殿的山必堅立，","poem":1},{"lineBreak":true},{"text":"超乎諸山，高舉過於萬嶺；","poem":1},{"lineBreak":true},{"text":"萬民都要流歸這山。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"必有許多國的民前往，說：","poem":1},{"lineBreak":true},{"text":"來吧，我們登耶和華的山，","poem":1},{"lineBreak":true},{"text":"奔雅各上帝的殿。","poem":1},{"lineBreak":true},{"text":"主必將他的道教訓我們；","poem":1},{"lineBreak":true},{"text":"我們也要行他的路。","poem":1},{"lineBreak":true},{"text":"因為訓誨必出於錫安；","poem":1},{"lineBreak":true},{"text":"耶和華的言語必出於耶路撒冷。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他必在列國中施行審判，","poem":1},{"lineBreak":true},{"text":"為許多國民斷定是非。","poem":1},{"lineBreak":true},{"text":"他們要將刀打成犂頭，","poem":1},{"lineBreak":true},{"text":"把槍打成鐮刀。","poem":1},{"lineBreak":true},{"text":"這國不舉刀攻擊那國；","poem":1},{"lineBreak":true},{"text":"他們也不再學習戰事。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"雅各家啊，來吧！","poem":1},{"lineBreak":true},{"text":"我們在耶和華的光明中行走。","poem":1}]},{"type":"heading","content":["驕者必敗"]},{"type":"verse","number":6,"content":[{"text":"耶和華，你離棄了你百姓雅各家，","poem":1},{"lineBreak":true},{"text":"是因他們充滿了東方的風俗，","poem":1},{"lineBreak":true},{"text":"作觀兆的，像非利士人一樣，","poem":1},{"lineBreak":true},{"text":"並與外邦人擊掌。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們的國滿了金銀，","poem":1},{"lineBreak":true},{"text":"財寶也無窮；","poem":1},{"lineBreak":true},{"text":"他們的地滿了馬匹，","poem":1},{"lineBreak":true},{"text":"車輛也無數。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們的地滿了偶像；","poem":1},{"lineBreak":true},{"text":"他們跪拜自己手所造的，","poem":1},{"lineBreak":true},{"text":"就是自己指頭所做的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"卑賤人屈膝；","poem":1},{"lineBreak":true},{"text":"尊貴人下跪；","poem":1},{"lineBreak":true},{"text":"所以不可饒恕他們。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你當進入巖穴，藏在土中，","poem":1},{"lineBreak":true},{"text":"躲避耶和華的驚嚇和他威嚴的榮光。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"到那日，眼目高傲的必降為卑；","poem":1},{"lineBreak":true},{"text":"性情狂傲的都必屈膝；","poem":1},{"lineBreak":true},{"text":"惟獨耶和華被尊崇。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"必有萬軍耶和華降罰的一個日子，","poem":1},{"lineBreak":true},{"text":"要臨到驕傲狂妄的；","poem":1},{"lineBreak":true},{"text":"一切自高的都必降為卑；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"又臨到黎巴嫩高大的香柏樹和巴珊的橡樹；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"又臨到一切高山的峻嶺；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"又臨到高臺和堅固城牆；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"又臨到他施的船隻並一切可愛的美物。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"驕傲的必屈膝；","poem":1},{"lineBreak":true},{"text":"狂妄的必降卑。","poem":1},{"lineBreak":true},{"text":"在那日，惟獨耶和華被尊崇；","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"偶像必全然廢棄。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和華興起，使地大震動的時候，","poem":1},{"lineBreak":true},{"text":"人就進入石洞，進入土穴，","poem":1},{"lineBreak":true},{"text":"躲避耶和華的驚嚇和他威嚴的榮光。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"到那日，人必將為拜而造的金偶像、銀偶像","poem":1},{"lineBreak":true},{"text":"拋給田鼠和蝙蝠。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"到耶和華興起，使地大震動的時候，","poem":1},{"lineBreak":true},{"text":"人好進入磐石洞中和巖石穴裏，","poem":1},{"lineBreak":true},{"text":"躲避耶和華的驚嚇和他威嚴的榮光。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你們休要倚靠世人。","poem":1},{"lineBreak":true},{"text":"他鼻孔裏不過有氣息；","poem":1},{"lineBreak":true},{"text":"他在一切事上可算甚麼呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}