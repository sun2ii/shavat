{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":23,"content":[{"type":"heading","content":["神要責罰泰爾的海港"]},{"type":"verse","number":1,"content":["論泰爾的默示：",{"text":"他施的船隻都要哀號；","poem":1},{"lineBreak":true},{"text":"因為泰爾變為荒場，","poem":1},{"lineBreak":true},{"text":"甚至沒有房屋，沒有可進之路。","poem":1},{"lineBreak":true},{"text":"這消息是從基提地得來的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"沿海的居民，","poem":1},{"lineBreak":true},{"text":"就是素來靠航海西頓的商家得豐盛的，","poem":1},{"lineBreak":true},{"text":"你們當靜默無言。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"在大水之上，","poem":1},{"lineBreak":true},{"text":"西曷的糧食、","poem":1},{"lineBreak":true},{"text":"尼羅河的莊稼是泰爾的進項；","poem":1},{"lineBreak":true},{"text":"她作列國的大碼頭。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"西頓哪，你當慚愧；","poem":1},{"lineBreak":true},{"text":"因為大海說，","poem":1},{"lineBreak":true},{"text":"就是海中的保障說：","poem":1},{"lineBreak":true},{"text":"我沒有劬勞，也沒有生產，","poem":1},{"lineBreak":true},{"text":"沒有養育男子，也沒有撫養童女。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"這風聲傳到埃及；","poem":1},{"lineBreak":true},{"text":"埃及人為泰爾的風聲極其疼痛。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"泰爾人哪，你們當過到他施去；","poem":1},{"lineBreak":true},{"text":"沿海的居民哪，你們都當哀號。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"這是你們歡樂的城，","poem":1},{"lineBreak":true},{"text":"從上古而有的嗎？","poem":1},{"lineBreak":true},{"text":"其中的居民往遠方寄居。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"泰爾本是賜冠冕的。","poem":1},{"lineBreak":true},{"text":"她的商家是王子；","poem":1},{"lineBreak":true},{"text":"她的買賣人是世上的尊貴人。","poem":1},{"lineBreak":true},{"text":"遭遇如此是誰定的呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"是萬軍之耶和華所定的！","poem":1},{"lineBreak":true},{"text":"為要污辱一切高傲的榮耀，","poem":1},{"lineBreak":true},{"text":"使地上一切的尊貴人被藐視。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他施的民","poem":1},{"noteId":18},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"可以流行你的地，好像尼羅河；","poem":1},{"lineBreak":true},{"text":"不再有腰帶拘緊你。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華已經向海伸手，","poem":1},{"lineBreak":true},{"text":"震動列國。","poem":1},{"lineBreak":true},{"text":"至於迦南，","poem":1},{"lineBreak":true},{"text":"他已經吩咐拆毀其中的保障。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他又說：受欺壓西頓的居民","poem":1},{"noteId":19},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"你必不得再歡樂。","poem":1},{"lineBreak":true},{"text":"起來！過到基提去；","poem":1},{"lineBreak":true},{"text":"就是在那裏也不得安歇。","poem":1},{"lineBreak":true},"（"]},{"type":"verse","number":13,"content":["看哪，迦勒底人之地向來沒有這民，這國是亞述人為住曠野的人所立的。現在他們建築戍樓，拆毀泰爾的宮殿，使她成為荒涼。）"]},{"type":"verse","number":14,"content":[{"text":"他施的船隻都要哀號，","poem":1},{"lineBreak":true},{"text":"因為你們的保障變為荒場。","poem":1}]},{"type":"verse","number":15,"content":["到那時，泰爾必被忘記七十年，照着一王的年日。七十年後，泰爾的景況必像妓女所唱的歌："]},{"type":"verse","number":16,"content":[{"text":"你這被忘記的妓女啊，","poem":1},{"lineBreak":true},{"text":"拿琴周流城內，","poem":1},{"lineBreak":true},{"text":"巧彈多唱，使人再想念你。","poem":1}]},{"type":"verse","number":17,"content":["七十年後，耶和華必眷顧泰爾，她就仍得利息",{"noteId":20},"，與地上的萬國交易",{"noteId":21},"。"]},{"type":"verse","number":18,"content":["她的貨財和利息要歸耶和華為聖，必不積攢存留；因為她的貨財必為住在耶和華面前的人所得，使他們吃飽，穿耐久的衣服。"]}],"footnotes":[{"noteId":18,"caller":"-","text":"原文是女","reference":{"chapter":23,"verse":10}},{"noteId":19,"caller":"-","text":"原文是處女","reference":{"chapter":23,"verse":12}},{"noteId":20,"caller":"-","text":"原文是雇價；下同","reference":{"chapter":23,"verse":17}},{"noteId":21,"caller":"-","text":"原文是行淫","reference":{"chapter":23,"verse":17}}]},"thisChapterLink":"/api/cmn_cuv/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}