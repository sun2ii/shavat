{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":24,"content":[{"type":"heading","content":["耶和華要責罰世界"]},{"type":"verse","number":1,"content":[{"text":"看哪，耶和華使地空虛，變為荒涼；","poem":1},{"lineBreak":true},{"text":"又翻轉大地，將居民分散。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"那時百姓怎樣，祭司也怎樣；","poem":1},{"lineBreak":true},{"text":"僕人怎樣，主人也怎樣；","poem":1},{"lineBreak":true},{"text":"婢女怎樣，主母也怎樣；","poem":1},{"lineBreak":true},{"text":"買物的怎樣，賣物的也怎樣；","poem":1},{"lineBreak":true},{"text":"放債的怎樣，借債的也怎樣；","poem":1},{"lineBreak":true},{"text":"取利的怎樣，出利的也怎樣。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"地必全然空虛，盡都荒涼；","poem":1},{"lineBreak":true},{"text":"因為這話是耶和華說的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"地上悲哀衰殘，","poem":1},{"lineBreak":true},{"text":"世界敗落衰殘；","poem":1},{"lineBreak":true},{"text":"地上居高位的人也敗落了。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"地被其上的居民污穢；","poem":1},{"lineBreak":true},{"text":"因為他們犯了律法，","poem":1},{"lineBreak":true},{"text":"廢了律例，背了永約。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"所以，地被咒詛吞滅；","poem":1},{"lineBreak":true},{"text":"住在其上的顯為有罪。","poem":1},{"lineBreak":true},{"text":"地上的居民被火焚燒，","poem":1},{"lineBreak":true},{"text":"剩下的人稀少。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"新酒悲哀，葡萄樹衰殘；","poem":1},{"lineBreak":true},{"text":"心中歡樂的俱都歎息。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"擊鼓之樂止息；","poem":1},{"lineBreak":true},{"text":"宴樂人的聲音完畢，","poem":1},{"lineBreak":true},{"text":"彈琴之樂也止息了。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"人必不得飲酒唱歌；","poem":1},{"lineBreak":true},{"text":"喝濃酒的，必以為苦。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"荒涼的城拆毀了；","poem":1},{"lineBreak":true},{"text":"各家關門閉戶，使人都不得進去。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"在街上因酒有悲歎的聲音；","poem":1},{"lineBreak":true},{"text":"一切喜樂變為昏暗；","poem":1},{"lineBreak":true},{"text":"地上的歡樂歸於無有。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"城中只有荒涼；","poem":1},{"lineBreak":true},{"text":"城門拆毀淨盡。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"在地上的萬民中，","poem":1},{"lineBreak":true},{"text":"必像打過的橄欖樹，","poem":1},{"lineBreak":true},{"text":"又像已摘的葡萄所剩無幾。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"這些人要高聲歡呼；","poem":1},{"lineBreak":true},{"text":"他們為耶和華的威嚴，從海那裏揚起聲來。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因此，你們要在東方榮耀耶和華，","poem":1},{"lineBreak":true},{"text":"在眾海島榮耀耶和華－以色列上帝的名。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我們聽見從地極有人歌唱，說：","poem":1},{"lineBreak":true},{"text":"榮耀歸於義人。","poem":1},{"lineBreak":true},{"text":"我卻說：我消滅了！","poem":1},{"lineBreak":true},{"text":"我消滅了，我有禍了！","poem":1},{"lineBreak":true},{"text":"詭詐的行詭詐；","poem":1},{"lineBreak":true},{"text":"詭詐的大行詭詐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"地上的居民哪，","poem":1},{"lineBreak":true},{"text":"恐懼、陷坑、網羅都臨近你。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"躲避恐懼聲音的必墜入陷坑；","poem":1},{"lineBreak":true},{"text":"從陷坑上來的必被網羅纏住；","poem":1},{"lineBreak":true},{"text":"因為天上的窗戶都開了，","poem":1},{"lineBreak":true},{"text":"地的根基也震動了。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"地全然破壞，盡都崩裂，","poem":1},{"lineBreak":true},{"text":"大大地震動了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"地要東倒西歪，好像醉酒的人；","poem":1},{"lineBreak":true},{"text":"又搖來搖去，好像吊床。","poem":1},{"lineBreak":true},{"text":"罪過在其上沉重，","poem":1},{"lineBreak":true},{"text":"必然塌陷，不能復起。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"到那日，耶和華在高處必懲罰高處的眾軍，","poem":1},{"lineBreak":true},{"text":"在地上必懲罰地上的列王。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他們必被聚集，像囚犯被聚在牢獄中，","poem":1},{"lineBreak":true},{"text":"並要囚在監牢裏，","poem":1},{"lineBreak":true},{"text":"多日之後便被討罪","poem":1},{"noteId":22},{"text":"。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"那時，月亮要蒙羞，日頭要慚愧；","poem":1},{"lineBreak":true},{"text":"因為萬軍之耶和華必在錫安山，","poem":1},{"lineBreak":true},{"text":"在耶路撒冷作王；","poem":1},{"lineBreak":true},{"text":"在敬畏他的長老面前，必有榮耀。","poem":1}]}],"footnotes":[{"noteId":22,"caller":"-","text":"或譯：眷顧","reference":{"chapter":24,"verse":22}}]},"thisChapterLink":"/api/cmn_cuv/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}