{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":26,"content":[{"type":"heading","content":["上帝使他的百姓得勝"]},{"type":"verse","number":1,"content":["當那日，在猶大地人必唱這歌說：",{"text":"我們有堅固的城。","poem":1},{"lineBreak":true},{"text":"耶和華要將救恩定為城牆，為外郭。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"敞開城門，","poem":1},{"lineBreak":true},{"text":"使守信的義民得以進入。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"堅心倚賴你的，","poem":1},{"lineBreak":true},{"text":"你必保守他十分平安，","poem":1},{"lineBreak":true},{"text":"因為他倚靠你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你們當倚靠耶和華直到永遠，","poem":1},{"lineBreak":true},{"text":"因為耶和華是永久的磐石。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他使住高處的與高城一併敗落，","poem":1},{"lineBreak":true},{"text":"將城拆毀，拆平，直到塵埃，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"要被腳踐踏，","poem":1},{"lineBreak":true},{"text":"就是被困苦人的腳和窮乏人的腳踐踏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"義人的道是正直的；","poem":1},{"lineBreak":true},{"text":"你為正直的主，必修平義人的路。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華啊，我們在你行審判的路上等候你；","poem":1},{"lineBreak":true},{"text":"我們心裏所羨慕的是你的名，","poem":1},{"lineBreak":true},{"text":"就是你那可記念的名。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"夜間，我心中羨慕你；","poem":1},{"lineBreak":true},{"text":"我裏面的靈切切尋求你。","poem":1},{"lineBreak":true},{"text":"因為你在世上行審判的時候，","poem":1},{"lineBreak":true},{"text":"地上的居民就學習公義。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"以恩惠待惡人，","poem":1},{"lineBreak":true},{"text":"他仍不學習公義；","poem":1},{"lineBreak":true},{"text":"在正直的地上，他必行事不義，","poem":1},{"lineBreak":true},{"text":"也不注意耶和華的威嚴。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華啊，你的手高舉，","poem":1},{"lineBreak":true},{"text":"他們仍然不看；","poem":1},{"lineBreak":true},{"text":"卻要看你為百姓發的熱心，因而抱愧，","poem":1},{"lineBreak":true},{"text":"並且有火燒滅你的敵人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和華啊，你必派定我們得平安，","poem":1},{"lineBreak":true},{"text":"因為我們所做的事都是你給我們成就的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華－我們的上帝啊，","poem":1},{"lineBreak":true},{"text":"在你以外曾有別的主管轄我們，","poem":1},{"lineBreak":true},{"text":"但我們專要倚靠你，提你的名。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們死了，必不能再活；","poem":1},{"lineBreak":true},{"text":"他們去世，必不能再起；","poem":1},{"lineBreak":true},{"text":"因為你刑罰他們，毀滅他們，","poem":1},{"lineBreak":true},{"text":"他們的名號就全然消滅。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和華啊，你增添國民，","poem":1},{"lineBreak":true},{"text":"你增添國民；","poem":1},{"lineBreak":true},{"text":"你得了榮耀，","poem":1},{"lineBreak":true},{"text":"又擴張地的四境。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和華啊，他們在急難中尋求你；","poem":1},{"lineBreak":true},{"text":"你的懲罰臨到他們身上，","poem":1},{"lineBreak":true},{"text":"他們就傾心吐膽禱告你。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"婦人懷孕，臨產疼痛，","poem":1},{"lineBreak":true},{"text":"在痛苦之中喊叫；","poem":1},{"lineBreak":true},{"text":"耶和華啊，我們在你面前也是如此。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我們也曾懷孕疼痛，","poem":1},{"lineBreak":true},{"text":"所產的竟像風一樣。","poem":1},{"lineBreak":true},{"text":"我們在地上未曾行甚麼拯救的事；","poem":1},{"lineBreak":true},{"text":"世上的居民也未曾敗落。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"死人","poem":1},{"noteId":23},{"text":"要復活，","poem":1},{"lineBreak":true},{"text":"屍首","poem":1},{"noteId":24},{"text":"要興起。","poem":1},{"lineBreak":true},{"text":"睡在塵埃的啊，要醒起歌唱！","poem":1},{"lineBreak":true},{"text":"因你的甘露好像菜蔬上的甘露，","poem":1},{"lineBreak":true},{"text":"地也要交出死人來。","poem":1}]},{"type":"heading","content":["審判和復興"]},{"type":"verse","number":20,"content":[{"text":"我的百姓啊，你們要來進入內室，","poem":1},{"lineBreak":true},{"text":"關上門，隱藏片時，","poem":1},{"lineBreak":true},{"text":"等到忿怒過去。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"因為耶和華從他的居所出來，","poem":1},{"lineBreak":true},{"text":"要刑罰地上居民的罪孽。","poem":1},{"lineBreak":true},{"text":"地也必露出其中的血，","poem":1},{"lineBreak":true},{"text":"不再掩蓋被殺的人。","poem":1}]}],"footnotes":[{"noteId":23,"caller":"-","text":"原文是你的死人","reference":{"chapter":26,"verse":19}},{"noteId":24,"caller":"-","text":"原文是我的屍首","reference":{"chapter":26,"verse":19}}]},"thisChapterLink":"/api/cmn_cuv/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}