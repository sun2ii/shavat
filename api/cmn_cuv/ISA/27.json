{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":["到那日，耶和華必用他剛硬有力的大刀刑罰鱷魚－就是那快行的蛇，刑罰鱷魚－就是那曲行的蛇，並殺海中的大魚。"]},{"type":"verse","number":2,"content":[{"text":"當那日，有出酒的葡萄園，","poem":1},{"lineBreak":true},{"text":"你們要指這園唱歌說：","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我－耶和華是看守葡萄園的；","poem":1},{"lineBreak":true},{"text":"我必時刻澆灌，","poem":1},{"lineBreak":true},{"text":"晝夜看守，","poem":1},{"lineBreak":true},{"text":"免得有人損害。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我心中不存忿怒。","poem":1},{"lineBreak":true},{"text":"惟願荊棘蒺藜與我交戰，","poem":1},{"lineBreak":true},{"text":"我就勇往直前，","poem":1},{"lineBreak":true},{"text":"把它一同焚燒。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"不然，讓它持住我的能力，","poem":1},{"lineBreak":true},{"text":"使它與我和好，","poem":1},{"lineBreak":true},{"text":"願它與我和好。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"將來雅各要扎根，","poem":1},{"lineBreak":true},{"text":"以色列要發芽開花；","poem":1},{"lineBreak":true},{"text":"他們的果實必充滿世界。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"主擊打他們，","poem":1},{"lineBreak":true},{"text":"豈像擊打那些擊打他們的人嗎？","poem":1},{"lineBreak":true},{"text":"他們被殺戮，","poem":1},{"lineBreak":true},{"text":"豈像被他們所殺戮的嗎？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你打發他們去，","poem":1},{"lineBreak":true},{"text":"是相機宜與他們相爭；","poem":1},{"lineBreak":true},{"text":"颳東風的日子，","poem":1},{"lineBreak":true},{"text":"就用暴風將他們逐去。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"所以，雅各的罪孽得赦免，","poem":1},{"lineBreak":true},{"text":"他的罪過得除掉的果效，全在乎此：","poem":1},{"lineBreak":true},{"text":"就是他叫祭壇的石頭變為打碎的灰石，","poem":1},{"lineBreak":true},{"text":"以致木偶和日像不再立起。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因為堅固城變為淒涼，","poem":1},{"lineBreak":true},{"text":"成了撇下離棄的居所，像曠野一樣；","poem":1},{"lineBreak":true},{"text":"牛犢必在那裏吃草，","poem":1},{"lineBreak":true},{"text":"在那裏躺臥，並吃盡其中的樹枝。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"枝條枯乾，必被折斷；","poem":1},{"lineBreak":true},{"text":"婦女要來點火燒着。","poem":1},{"lineBreak":true},{"text":"因為這百姓蒙昧無知，","poem":1},{"lineBreak":true},{"text":"所以，創造他們的必不憐恤他們；","poem":1},{"lineBreak":true},{"text":"造成他們的也不施恩與他們。","poem":1}]},{"type":"verse","number":12,"content":["以色列人哪，到那日，耶和華必從大河，直到埃及小河，將你們一一地收集，如同人打樹拾果一樣。"]},{"type":"verse","number":13,"content":["當那日，必大發角聲，在亞述地將要滅亡的，並在埃及地被趕散的，都要來，他們就在耶路撒冷聖山上敬拜耶和華。"]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}