{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":32,"content":[{"type":"heading","content":["公正的王"]},{"type":"verse","number":1,"content":[{"text":"看哪，必有一王憑公義行政；","poem":1},{"lineBreak":true},{"text":"必有首領藉公平掌權。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"必有一人像避風所和避暴雨的隱密處，","poem":1},{"lineBreak":true},{"text":"又像河流在乾旱之地，","poem":1},{"lineBreak":true},{"text":"像大磐石的影子在疲乏之地。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"那能看的人，眼不再昏迷；","poem":1},{"lineBreak":true},{"text":"能聽的人，耳必得聽聞。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"冒失人的心必明白知識；","poem":1},{"lineBreak":true},{"text":"結吧人的舌必說話通快。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愚頑人不再稱為高明；","poem":1},{"lineBreak":true},{"text":"吝嗇人不再稱為大方。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因為愚頑人必說愚頑話，","poem":1},{"lineBreak":true},{"text":"心裏想作罪孽，","poem":1},{"lineBreak":true},{"text":"慣行褻瀆的事，","poem":1},{"lineBreak":true},{"text":"說錯謬的話攻擊耶和華，","poem":1},{"lineBreak":true},{"text":"使飢餓的人無食可吃，","poem":1},{"lineBreak":true},{"text":"使口渴的人無水可喝。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"吝嗇人所用的法子是惡的；","poem":1},{"lineBreak":true},{"text":"他圖謀惡計，","poem":1},{"lineBreak":true},{"text":"用謊言毀滅謙卑人；","poem":1},{"lineBreak":true},{"text":"窮乏人講公理的時候，","poem":1},{"lineBreak":true},{"text":"他也是這樣行。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"高明人卻謀高明事，","poem":1},{"lineBreak":true},{"text":"在高明事上也必永存。","poem":1}]},{"type":"heading","content":["審判和復興"]},{"type":"verse","number":9,"content":[{"text":"安逸的婦女啊，起來聽我的聲音！","poem":1},{"lineBreak":true},{"text":"無慮的女子啊，側耳聽我的言語！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"無慮的女子啊，再過一年多，必受騷擾；","poem":1},{"lineBreak":true},{"text":"因為無葡萄可摘，","poem":1},{"lineBreak":true},{"text":"無果子","poem":1},{"noteId":28},{"text":"可收。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"安逸的婦女啊，要戰兢；","poem":1},{"lineBreak":true},{"text":"無慮的女子啊，要受騷擾。","poem":1},{"lineBreak":true},{"text":"脫去衣服，赤着身體，","poem":1},{"lineBreak":true},{"text":"腰束麻布。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"她們必為美好的田地","poem":1},{"lineBreak":true},{"text":"和多結果的葡萄樹，搥胸哀哭。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"荊棘蒺藜必長在我百姓的地上，","poem":1},{"lineBreak":true},{"text":"又長在歡樂的城中和一切快樂的房屋上。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因為宮殿必被撇下，","poem":1},{"lineBreak":true},{"text":"多民的城必被離棄；","poem":1},{"lineBreak":true},{"text":"山岡望樓永為洞穴，","poem":1},{"lineBreak":true},{"text":"作野驢所喜樂的，","poem":1},{"lineBreak":true},{"text":"為羊群的草場。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"等到聖靈從上澆灌我們，","poem":1},{"lineBreak":true},{"text":"曠野就變為肥田，","poem":1},{"lineBreak":true},{"text":"肥田看如樹林。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"那時，公平要居在曠野；","poem":1},{"lineBreak":true},{"text":"公義要居在肥田。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"公義的果效必是平安；","poem":1},{"lineBreak":true},{"text":"公義的效驗必是平穩，直到永遠。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我的百姓必住在平安的居所，","poem":1},{"lineBreak":true},{"text":"安穩的住處，平靜的安歇所。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"（ 但要降冰雹打倒樹林；","poem":1},{"lineBreak":true},{"text":"城必全然拆平。）","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你們在各水邊撒種、","poem":1},{"lineBreak":true},{"text":"牧放牛驢的有福了！","poem":1}]}],"footnotes":[{"noteId":28,"caller":"-","text":"或譯：禾稼","reference":{"chapter":32,"verse":10}}]},"thisChapterLink":"/api/cmn_cuv/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}