{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":34,"content":[{"type":"heading","content":["神要懲罰仇敵"]},{"type":"verse","number":1,"content":[{"text":"列國啊，要近前來聽！","poem":1},{"lineBreak":true},{"text":"眾民哪，要側耳而聽！","poem":1},{"lineBreak":true},{"text":"地和其上所充滿的，","poem":1},{"lineBreak":true},{"text":"世界和其中一切所出的都應當聽！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為耶和華向萬國發忿恨，","poem":1},{"lineBreak":true},{"text":"向他們的全軍發烈怒，","poem":1},{"lineBreak":true},{"text":"將他們滅盡，交出他們受殺戮。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"被殺的必然拋棄，","poem":1},{"lineBreak":true},{"text":"屍首臭氣上騰；","poem":1},{"lineBreak":true},{"text":"諸山被他們的血融化。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"天上的萬象都要消沒；","poem":1},{"lineBreak":true},{"text":"天被捲起，好像書卷。","poem":1},{"lineBreak":true},{"text":"其上的萬象要殘敗，","poem":1},{"lineBreak":true},{"text":"像葡萄樹的葉子殘敗，","poem":1},{"lineBreak":true},{"text":"又像無花果樹的葉子殘敗一樣。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因為我的刀在天上已經喝足；","poem":1},{"lineBreak":true},{"text":"這刀必臨到以東和我所咒詛的民，","poem":1},{"lineBreak":true},{"text":"要施行審判。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華的刀滿了血，","poem":1},{"lineBreak":true},{"text":"用脂油和羊羔、公山羊的血，","poem":1},{"lineBreak":true},{"text":"並公綿羊腰子的脂油滋潤的；","poem":1},{"lineBreak":true},{"text":"因為耶和華在波斯拉有獻祭的事，","poem":1},{"lineBreak":true},{"text":"在以東地大行殺戮。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"野牛、牛犢，和公牛要一同下來。","poem":1},{"lineBreak":true},{"text":"他們的地喝醉了血；","poem":1},{"lineBreak":true},{"text":"他們的塵土因脂油肥潤。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因耶和華有報仇之日，","poem":1},{"lineBreak":true},{"text":"為錫安的爭辯有報應之年。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"以東的河水要變為石油，","poem":1},{"lineBreak":true},{"text":"塵埃要變為硫磺；","poem":1},{"lineBreak":true},{"text":"地土成為燒着的石油，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"晝夜總不熄滅，","poem":1},{"lineBreak":true},{"text":"煙氣永遠上騰，","poem":1},{"lineBreak":true},{"text":"必世世代代成為荒廢，","poem":1},{"lineBreak":true},{"text":"永永遠遠無人經過。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"鵜鶘、箭豬卻要得為業；","poem":1},{"lineBreak":true},{"text":"貓頭鷹、烏鴉要住在其間。","poem":1},{"lineBreak":true},{"text":"耶和華必將空虛的準繩，","poem":1},{"lineBreak":true},{"text":"混沌的線鉈，拉在其上。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"以東人要召貴冑來治國；","poem":1},{"lineBreak":true},{"text":"那裏卻無一個，","poem":1},{"lineBreak":true},{"text":"首領也都歸於無有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"以東的宮殿要長荊棘；","poem":1},{"lineBreak":true},{"text":"保障要長蒺藜和刺草；","poem":1},{"lineBreak":true},{"text":"要作野狗的住處，","poem":1},{"lineBreak":true},{"text":"鴕鳥的居所。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"曠野的走獸要和豺狼相遇；","poem":1},{"lineBreak":true},{"text":"野山羊要與伴偶對叫。","poem":1},{"lineBreak":true},{"text":"夜間的怪物必在那裏棲身，","poem":1},{"lineBreak":true},{"text":"自找安歇之處。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"箭蛇要在那裏做窩，","poem":1},{"lineBreak":true},{"text":"下蛋，菢蛋，生子，","poem":1},{"lineBreak":true},{"text":"聚子在其影下；","poem":1},{"lineBreak":true},{"text":"鷂鷹各與伴偶聚集在那裏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"你們要查考宣讀耶和華的書。","poem":1},{"lineBreak":true},{"text":"這都無一缺少，","poem":1},{"lineBreak":true},{"text":"無一沒有伴偶；","poem":1},{"lineBreak":true},{"text":"因為我的口已經吩咐，","poem":1},{"lineBreak":true},{"text":"他的靈將牠們聚集。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他也為牠們拈鬮，","poem":1},{"lineBreak":true},{"text":"又親手用準繩給牠們分地；","poem":1},{"lineBreak":true},{"text":"牠們必永得為業，","poem":1},{"lineBreak":true},{"text":"世世代代住在其間。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}