{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":35,"content":[{"type":"heading","content":["神聖之路"]},{"type":"verse","number":1,"content":[{"text":"曠野和乾旱之地必然歡喜；","poem":1},{"lineBreak":true},{"text":"沙漠也必快樂；","poem":1},{"lineBreak":true},{"text":"又像玫瑰開花，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"必開花繁盛，","poem":1},{"lineBreak":true},{"text":"樂上加樂，而且歡呼。","poem":1},{"lineBreak":true},{"text":"黎巴嫩的榮耀，","poem":1},{"lineBreak":true},{"text":"並迦密與沙崙的華美，必賜給它。","poem":1},{"lineBreak":true},{"text":"人必看見耶和華的榮耀，","poem":1},{"lineBreak":true},{"text":"我們上帝的華美。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你們要使軟弱的手堅壯，","poem":1},{"lineBreak":true},{"text":"無力的膝穩固。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"對膽怯的人說：","poem":1},{"lineBreak":true},{"text":"你們要剛強，不要懼怕。","poem":1},{"lineBreak":true},{"text":"看哪，你們的上帝必來報仇，","poem":1},{"lineBreak":true},{"text":"必來施行極大的報應；","poem":1},{"lineBreak":true},{"text":"他必來拯救你們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"那時，瞎子的眼必睜開；","poem":1},{"lineBreak":true},{"text":"聾子的耳必開通。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"那時，瘸子必跳躍像鹿；","poem":1},{"lineBreak":true},{"text":"啞巴的舌頭必能歌唱。","poem":1},{"lineBreak":true},{"text":"在曠野必有水發出；","poem":1},{"lineBreak":true},{"text":"在沙漠必有河湧流。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"發光的沙","poem":1},{"noteId":31},{"text":"要變為水池；","poem":1},{"lineBreak":true},{"text":"乾渴之地要變為泉源。","poem":1},{"lineBreak":true},{"text":"在野狗躺臥之處，","poem":1},{"lineBreak":true},{"text":"必有青草、蘆葦，和蒲草。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"在那裏必有一條大道，","poem":1},{"lineBreak":true},{"text":"稱為聖路。","poem":1},{"lineBreak":true},{"text":"污穢人不得經過，","poem":1},{"lineBreak":true},{"text":"必專為贖民行走；","poem":1},{"lineBreak":true},{"text":"行路的人雖愚昧，","poem":1},{"lineBreak":true},{"text":"也不致失迷。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"在那裏必沒有獅子，","poem":1},{"lineBreak":true},{"text":"猛獸也不登這路；","poem":1},{"lineBreak":true},{"text":"在那裏都遇不見，","poem":1},{"lineBreak":true},{"text":"只有贖民在那裏行走。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"並且耶和華救贖的民必歸回，","poem":1},{"lineBreak":true},{"text":"歌唱來到錫安；","poem":1},{"lineBreak":true},{"text":"永樂必歸到他們的頭上；","poem":1},{"lineBreak":true},{"text":"他們必得着歡喜快樂，","poem":1},{"lineBreak":true},{"text":"憂愁歎息盡都逃避。","poem":1}]}],"footnotes":[{"noteId":31,"caller":"-","text":"或譯：蜃樓","reference":{"chapter":35,"verse":7}}]},"thisChapterLink":"/api/cmn_cuv/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}