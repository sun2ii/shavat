{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":40,"content":[{"type":"heading","content":["安慰的話"]},{"type":"verse","number":1,"content":[{"text":"你們的上帝說：","poem":1},{"lineBreak":true},{"text":"你們要安慰，安慰我的百姓。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要對耶路撒冷說安慰的話，","poem":1},{"lineBreak":true},{"text":"又向她宣告說，","poem":1},{"lineBreak":true},{"text":"她爭戰的日子已滿了；","poem":1},{"lineBreak":true},{"text":"她的罪孽赦免了；","poem":1},{"lineBreak":true},{"text":"她為自己的一切罪，","poem":1},{"lineBreak":true},{"text":"從耶和華手中加倍受罰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"有人聲喊着說：","poem":1},{"lineBreak":true},{"text":"在曠野預備耶和華的路","poem":1},{"noteId":35},{"text":"，","poem":1},{"lineBreak":true},{"text":"在沙漠地修平我們上帝的道。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"一切山窪都要填滿，","poem":1},{"lineBreak":true},{"text":"大小山岡都要削平；","poem":1},{"lineBreak":true},{"text":"高高低低的要改為平坦，","poem":1},{"lineBreak":true},{"text":"崎崎嶇嶇的必成為平原。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華的榮耀必然顯現；","poem":1},{"lineBreak":true},{"text":"凡有血氣的必一同看見；","poem":1},{"lineBreak":true},{"text":"因為這是耶和華親口說的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"有人聲說：你喊叫吧！","poem":1},{"lineBreak":true},{"text":"有一個說：我喊叫甚麼呢？","poem":1},{"lineBreak":true},{"text":"說：凡有血氣的盡都如草；","poem":1},{"lineBreak":true},{"text":"他的美容都像野地的花。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"草必枯乾，花必凋殘，","poem":1},{"lineBreak":true},{"text":"因為耶和華的氣吹在其上；","poem":1},{"lineBreak":true},{"text":"百姓誠然是草。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"草必枯乾，花必凋殘，","poem":1},{"lineBreak":true},{"text":"惟有我們上帝的話必永遠立定。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"報好信息給錫安的啊，","poem":1},{"lineBreak":true},{"text":"你要登高山；","poem":1},{"lineBreak":true},{"text":"報好信息給耶路撒冷的啊，","poem":1},{"lineBreak":true},{"text":"你要極力揚聲。","poem":1},{"lineBreak":true},{"text":"揚聲不要懼怕，","poem":1},{"lineBreak":true},{"text":"對猶大的城邑說：","poem":1},{"lineBreak":true},{"text":"看哪，你們的上帝！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"主耶和華必像大能者臨到；","poem":1},{"lineBreak":true},{"text":"他的膀臂必為他掌權。","poem":1},{"lineBreak":true},{"text":"他的賞賜在他那裏；","poem":1},{"lineBreak":true},{"text":"他的報應在他面前。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他必像牧人牧養自己的羊群，","poem":1},{"lineBreak":true},{"text":"用膀臂聚集羊羔抱在懷中，","poem":1},{"lineBreak":true},{"text":"慢慢引導那乳養小羊的。","poem":1}]},{"type":"heading","content":["以色列的上帝無可比擬"]},{"type":"verse","number":12,"content":[{"text":"誰曾用手心量諸水，","poem":1},{"lineBreak":true},{"text":"用手虎口量蒼天，","poem":1},{"lineBreak":true},{"text":"用升斗盛大地的塵土，","poem":1},{"lineBreak":true},{"text":"用秤稱山嶺，","poem":1},{"lineBreak":true},{"text":"用天平平岡陵呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"誰曾測度耶和華的心","poem":1},{"noteId":36},{"text":"，","poem":1},{"lineBreak":true},{"text":"或作他的謀士指教他呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他與誰商議，誰教導他，","poem":1},{"lineBreak":true},{"text":"誰將公平的路指示他，","poem":1},{"lineBreak":true},{"text":"又將知識教訓他，","poem":1},{"lineBreak":true},{"text":"將通達的道指教他呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"看哪，萬民都像水桶的一滴，","poem":1},{"lineBreak":true},{"text":"又算如天平上的微塵；","poem":1},{"lineBreak":true},{"text":"他舉起眾海島，好像極微之物。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"黎巴嫩的樹林不夠當柴燒；","poem":1},{"lineBreak":true},{"text":"其中的走獸也不夠作燔祭。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"萬民在他面前好像虛無，","poem":1},{"lineBreak":true},{"text":"被他看為不及虛無，乃為虛空。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"你們究竟將誰比上帝，","poem":1},{"lineBreak":true},{"text":"用甚麼形像與上帝比較呢？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"偶像是匠人鑄造，","poem":1},{"lineBreak":true},{"text":"銀匠用金包裹，","poem":1},{"lineBreak":true},{"text":"為它鑄造銀鍊。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"窮乏獻不起這樣供物的，","poem":1},{"lineBreak":true},{"text":"就揀選不能朽壞的樹木，","poem":1},{"lineBreak":true},{"text":"為自己尋找巧匠，","poem":1},{"lineBreak":true},{"text":"立起不能搖動的偶像。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"你們豈不曾知道嗎？","poem":1},{"lineBreak":true},{"text":"你們豈不曾聽見嗎？","poem":1},{"lineBreak":true},{"text":"從起初豈沒有人告訴你們嗎？","poem":1},{"lineBreak":true},{"text":"自從立地的根基，","poem":1},{"lineBreak":true},{"text":"你們豈沒有明白嗎？","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"上帝坐在地球大圈之上；","poem":1},{"lineBreak":true},{"text":"地上的居民好像蝗蟲。","poem":1},{"lineBreak":true},{"text":"他鋪張穹蒼如幔子，","poem":1},{"lineBreak":true},{"text":"展開諸天如可住的帳棚。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他使君王歸於虛無，","poem":1},{"lineBreak":true},{"text":"使地上的審判官成為虛空。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"他們是剛才","poem":1},{"noteId":37},{"text":"栽上，","poem":1},{"lineBreak":true},{"text":"剛才種上，","poem":1},{"lineBreak":true},{"text":"根也剛才扎在地裏，","poem":1},{"lineBreak":true},{"text":"他一吹在其上，便都枯乾；","poem":1},{"lineBreak":true},{"text":"旋風將他們吹去，像碎稭一樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"那聖者說：你們將誰比我，","poem":1},{"lineBreak":true},{"text":"叫他與我相等呢？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你們向上舉目，","poem":1},{"lineBreak":true},{"text":"看誰創造這萬象，","poem":1},{"lineBreak":true},{"text":"按數目領出，","poem":1},{"lineBreak":true},{"text":"他一一稱其名；","poem":1},{"lineBreak":true},{"text":"因他的權能，","poem":1},{"lineBreak":true},{"text":"又因他的大能大力，","poem":1},{"lineBreak":true},{"text":"連一個都不缺。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"雅各啊，你為何說，","poem":1},{"lineBreak":true},{"text":"我的道路向耶和華隱藏？","poem":1},{"lineBreak":true},{"text":"以色列啊，你為何言，","poem":1},{"lineBreak":true},{"text":"我的冤屈上帝並不查問？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你豈不曾知道嗎？","poem":1},{"lineBreak":true},{"text":"你豈不曾聽見嗎？","poem":1},{"lineBreak":true},{"text":"永在的上帝耶和華，創造地極的主，","poem":1},{"lineBreak":true},{"text":"並不疲乏，也不困倦；","poem":1},{"lineBreak":true},{"text":"他的智慧無法測度。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"疲乏的，他賜能力；","poem":1},{"lineBreak":true},{"text":"軟弱的，他加力量。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"就是少年人也要疲乏困倦；","poem":1},{"lineBreak":true},{"text":"強壯的也必全然跌倒。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"但那等候耶和華的必重新得力。","poem":1},{"lineBreak":true},{"text":"他們必如鷹展翅上騰；","poem":1},{"lineBreak":true},{"text":"他們奔跑卻不困倦，","poem":1},{"lineBreak":true},{"text":"行走卻不疲乏。","poem":1}]}],"footnotes":[{"noteId":35,"caller":"-","text":"或譯：在曠野，有人聲喊着說：當預備耶和華的路","reference":{"chapter":40,"verse":3}},{"noteId":36,"caller":"-","text":"或譯：誰曾指示耶和華的靈","reference":{"chapter":40,"verse":13}},{"noteId":37,"caller":"-","text":"或譯：不曾；下同","reference":{"chapter":40,"verse":24}}]},"thisChapterLink":"/api/cmn_cuv/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}