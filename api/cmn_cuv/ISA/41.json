{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":41,"content":[{"type":"heading","content":["神對以色列的保證"]},{"type":"verse","number":1,"content":[{"text":"眾海島啊，當在我面前靜默；","poem":1},{"lineBreak":true},{"text":"眾民當重新得力，","poem":1},{"lineBreak":true},{"text":"都要近前來才可以說話，","poem":1},{"lineBreak":true},{"text":"我們可以彼此辯論。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"誰從東方興起一人，","poem":1},{"lineBreak":true},{"text":"憑公義召他來到腳前呢？","poem":1},{"lineBreak":true},{"text":"耶和華將列國交給他，","poem":1},{"lineBreak":true},{"text":"使他管轄君王，","poem":1},{"lineBreak":true},{"text":"把他們如灰塵交與他的刀，","poem":1},{"lineBreak":true},{"text":"如風吹的碎稭交與他的弓。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他追趕他們，","poem":1},{"lineBreak":true},{"text":"走他所未走的道，","poem":1},{"lineBreak":true},{"text":"坦然前行。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"誰行做成就這事，","poem":1},{"lineBreak":true},{"text":"從起初宣召歷代呢？","poem":1},{"lineBreak":true},{"text":"就是我－耶和華！","poem":1},{"lineBreak":true},{"text":"我是首先的，","poem":1},{"lineBreak":true},{"text":"也與末後的同在。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"海島看見就都害怕；","poem":1},{"lineBreak":true},{"text":"地極也都戰兢，","poem":1},{"lineBreak":true},{"text":"就近前來。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們各人幫助鄰舍，","poem":1},{"lineBreak":true},{"text":"各人對弟兄說：壯膽吧！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"木匠勉勵銀匠，","poem":1},{"lineBreak":true},{"text":"用鎚打光的勉勵打砧的，","poem":1},{"lineBreak":true},{"text":"論銲工說，銲得好；","poem":1},{"lineBreak":true},{"text":"又用釘子釘穩，免得偶像動搖。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"惟你以色列－我的僕人，","poem":1},{"lineBreak":true},{"text":"雅各－我所揀選的，","poem":1},{"lineBreak":true},{"text":"我朋友亞伯拉罕的後裔，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你是我從地極所領","poem":1},{"noteId":38},{"text":"來的，","poem":1},{"lineBreak":true},{"text":"從地角所召來的，","poem":1},{"lineBreak":true},{"text":"且對你說：你是我的僕人；","poem":1},{"lineBreak":true},{"text":"我揀選你，並不棄絕你。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你不要害怕，因為我與你同在；","poem":1},{"lineBreak":true},{"text":"不要驚惶，因為我是你的上帝。","poem":1},{"lineBreak":true},{"text":"我必堅固你，我必幫助你；","poem":1},{"lineBreak":true},{"text":"我必用我公義的右手扶持你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"凡向你發怒的必都抱愧蒙羞；","poem":1},{"lineBreak":true},{"text":"與你相爭的必如無有，並要滅亡。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"與你爭競的，你要找他們也找不着；","poem":1},{"lineBreak":true},{"text":"與你爭戰的必如無有，成為虛無。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因為我耶和華－","poem":1},{"lineBreak":true},{"text":"你的上帝必攙扶你的右手，","poem":1},{"lineBreak":true},{"text":"對你說：不要害怕！","poem":1},{"lineBreak":true},{"text":"我必幫助你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"你這蟲雅各和你們以色列人，","poem":1},{"lineBreak":true},{"text":"不要害怕！","poem":1},{"lineBreak":true},{"text":"耶和華說：我必幫助你。","poem":1},{"lineBreak":true},{"text":"你的救贖主就是以色列的聖者。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"看哪，我已使你成為","poem":1},{"lineBreak":true},{"text":"有快齒打糧的新器具；","poem":1},{"lineBreak":true},{"text":"你要把山嶺打得粉碎，","poem":1},{"lineBreak":true},{"text":"使岡陵如同糠詷。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你要把它簸揚，風要吹去；","poem":1},{"lineBreak":true},{"text":"旋風要把它颳散。","poem":1},{"lineBreak":true},{"text":"你倒要以耶和華為喜樂，","poem":1},{"lineBreak":true},{"text":"以以色列的聖者為誇耀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"困苦窮乏人尋求水卻沒有；","poem":1},{"lineBreak":true},{"text":"他們因口渴，舌頭乾燥。","poem":1},{"lineBreak":true},{"text":"我－耶和華必應允他們；","poem":1},{"lineBreak":true},{"text":"我－以色列的上帝必不離棄他們。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要在淨光的高處開江河，","poem":1},{"lineBreak":true},{"text":"在谷中開泉源；","poem":1},{"lineBreak":true},{"text":"我要使沙漠變為水池，","poem":1},{"lineBreak":true},{"text":"使乾地變為湧泉。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我要在曠野種上香柏樹、","poem":1},{"lineBreak":true},{"text":"皂莢樹、番石榴樹，和野橄欖樹。","poem":1},{"lineBreak":true},{"text":"我在沙漠要把松樹、杉樹，","poem":1},{"lineBreak":true},{"text":"並黃楊樹一同栽植；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"好叫人看見、知道、","poem":1},{"lineBreak":true},{"text":"思想、明白；","poem":1},{"lineBreak":true},{"text":"這是耶和華的手所做的，","poem":1},{"lineBreak":true},{"text":"是以色列的聖者所造的。","poem":1}]},{"type":"heading","content":["耶和華向假神挑戰"]},{"type":"verse","number":21,"content":[{"text":"耶和華對假神說：","poem":1},{"lineBreak":true},{"text":"你們要呈上你們的案件；","poem":1},{"lineBreak":true},{"text":"雅各的君說：","poem":1},{"lineBreak":true},{"text":"你們要聲明你們確實的理由。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"可以聲明，指示我們將來必遇的事，","poem":1},{"lineBreak":true},{"text":"說明先前的是甚麼事，","poem":1},{"lineBreak":true},{"text":"好叫我們思索，得知事的結局，","poem":1},{"lineBreak":true},{"text":"或者把將來的事指示我們。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"要說明後來的事，","poem":1},{"lineBreak":true},{"text":"好叫我們知道你們是神。","poem":1},{"lineBreak":true},{"text":"你們或降福，或降禍，","poem":1},{"lineBreak":true},{"text":"使我們驚奇，一同觀看。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"看哪，你們屬乎虛無；","poem":1},{"lineBreak":true},{"text":"你們的作為也屬乎虛空。","poem":1},{"lineBreak":true},{"text":"那選擇你們的是可憎惡的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"我從北方興起一人；","poem":1},{"lineBreak":true},{"text":"他是求告我名的，","poem":1},{"lineBreak":true},{"text":"從日出之地而來。","poem":1},{"lineBreak":true},{"text":"他必臨到掌權的，","poem":1},{"lineBreak":true},{"text":"好像臨到灰泥，","poem":1},{"lineBreak":true},{"text":"彷彿窯匠踹泥一樣。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"誰從起初指明這事，使我們知道呢？","poem":1},{"lineBreak":true},{"text":"誰從先前說明，使我們說他不錯呢？","poem":1},{"lineBreak":true},{"text":"誰也沒有指明；","poem":1},{"lineBreak":true},{"text":"誰也沒有說明；","poem":1},{"lineBreak":true},{"text":"誰也沒有聽見你們的話。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我首先對錫安說：","poem":1},{"lineBreak":true},{"text":"看哪，我要將一位報好信息的賜給耶路撒冷。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我看的時候並沒有人；","poem":1},{"lineBreak":true},{"text":"我問的時候，","poem":1},{"lineBreak":true},{"text":"他們中間也沒有謀士可以回答一句。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"看哪，他們和他們的工作都是虛空，","poem":1},{"lineBreak":true},{"text":"且是虛無。","poem":1},{"lineBreak":true},{"text":"他們所鑄的偶像都是風，","poem":1},{"lineBreak":true},{"text":"都是虛的。","poem":1}]}],"footnotes":[{"noteId":38,"caller":"-","text":"原文是抓","reference":{"chapter":41,"verse":9}}]},"thisChapterLink":"/api/cmn_cuv/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}