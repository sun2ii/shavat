{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":42,"content":[{"type":"heading","content":["耶和華的僕人"]},{"type":"verse","number":1,"content":[{"text":"看哪，我的僕人－","poem":1},{"lineBreak":true},{"text":"我所扶持所揀選、心裏所喜悅的！","poem":1},{"lineBreak":true},{"text":"我已將我的靈賜給他；","poem":1},{"lineBreak":true},{"text":"他必將公理傳給外邦。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他不喧嚷，不揚聲，","poem":1},{"lineBreak":true},{"text":"也不使街上聽見他的聲音。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"壓傷的蘆葦，他不折斷；","poem":1},{"lineBreak":true},{"text":"將殘的燈火，他不吹滅。","poem":1},{"lineBreak":true},{"text":"他憑真實將公理傳開。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他不灰心，也不喪膽，","poem":1},{"lineBreak":true},{"text":"直到他在地上設立公理；","poem":1},{"lineBreak":true},{"text":"海島都等候他的訓誨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"創造諸天，鋪張穹蒼，","poem":1},{"lineBreak":true},{"text":"將地和地所出的一併鋪開，","poem":1},{"lineBreak":true},{"text":"賜氣息給地上的眾人，","poem":1},{"lineBreak":true},{"text":"又賜靈性給行在其上之人的上帝耶和華，","poem":1},{"lineBreak":true},{"text":"他如此說：","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我－耶和華憑公義召你，","poem":1},{"lineBreak":true},{"text":"必攙扶你的手，保守你，","poem":1},{"lineBreak":true},{"text":"使你作眾民的中保","poem":1},{"noteId":39},{"text":"，","poem":1},{"lineBreak":true},{"text":"作外邦人的光，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"開瞎子的眼，","poem":1},{"lineBreak":true},{"text":"領被囚的出牢獄，","poem":1},{"lineBreak":true},{"text":"領坐黑暗的出監牢。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我是耶和華，這是我的名；","poem":1},{"lineBreak":true},{"text":"我必不將我的榮耀歸給假神，","poem":1},{"lineBreak":true},{"text":"也不將我的稱讚歸給雕刻的偶像。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"看哪，先前的事已經成就，","poem":1},{"lineBreak":true},{"text":"現在我將新事說明，","poem":1},{"lineBreak":true},{"text":"這事未發以先，我就說給你們聽。","poem":1}]},{"type":"heading","content":["頌讚之歌"]},{"type":"verse","number":10,"content":[{"text":"航海的和海中所有的，","poem":1},{"lineBreak":true},{"text":"海島和其上的居民，","poem":1},{"lineBreak":true},{"text":"都當向耶和華唱新歌，","poem":1},{"lineBreak":true},{"text":"從地極讚美他。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"曠野和其中的城邑，","poem":1},{"lineBreak":true},{"text":"並基達人居住的村莊都當揚聲；","poem":1},{"lineBreak":true},{"text":"西拉的居民當歡呼，","poem":1},{"lineBreak":true},{"text":"在山頂上吶喊。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們當將榮耀歸給耶和華，","poem":1},{"lineBreak":true},{"text":"在海島中傳揚他的頌讚。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華必像勇士出去，","poem":1},{"lineBreak":true},{"text":"必像戰士激動熱心，","poem":1},{"lineBreak":true},{"text":"要喊叫，大聲吶喊，","poem":1},{"lineBreak":true},{"text":"要用大力攻擊仇敵。","poem":1}]},{"type":"heading","content":["神應許幫助他的子民"]},{"type":"verse","number":14,"content":[{"text":"我許久閉口不言，靜默不語；","poem":1},{"lineBreak":true},{"text":"現在我要喊叫，像產難的婦人；","poem":1},{"lineBreak":true},{"text":"我要急氣而喘哮。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要使大山小岡變為荒場，","poem":1},{"lineBreak":true},{"text":"使其上的花草都枯乾；","poem":1},{"lineBreak":true},{"text":"我要使江河變為洲島，","poem":1},{"lineBreak":true},{"text":"使水池都乾涸。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要引瞎子行不認識的道，","poem":1},{"lineBreak":true},{"text":"領他們走不知道的路；","poem":1},{"lineBreak":true},{"text":"在他們面前使黑暗變為光明，","poem":1},{"lineBreak":true},{"text":"使彎曲變為平直。","poem":1},{"lineBreak":true},{"text":"這些事我都要行，","poem":1},{"lineBreak":true},{"text":"並不離棄他們。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"倚靠雕刻的偶像，","poem":1},{"lineBreak":true},{"text":"對鑄造的偶像說：","poem":1},{"lineBreak":true},{"text":"你是我們的神；","poem":1},{"lineBreak":true},{"text":"這等人要退後，全然蒙羞。","poem":1}]},{"type":"heading","content":["以色列人不受教益"]},{"type":"verse","number":18,"content":[{"text":"你們這耳聾的，聽吧！","poem":1},{"lineBreak":true},{"text":"你們這眼瞎的，看吧！","poem":1},{"lineBreak":true},{"text":"使你們能看見。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"誰比我的僕人眼瞎呢？","poem":1},{"lineBreak":true},{"text":"誰比我差遣的使者耳聾呢？","poem":1},{"lineBreak":true},{"text":"誰瞎眼像那與我和好的？","poem":1},{"lineBreak":true},{"text":"誰瞎眼像耶和華的僕人呢？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你看見許多事卻不領會，","poem":1},{"lineBreak":true},{"text":"耳朵開通卻不聽見。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和華因自己公義的緣故，","poem":1},{"lineBreak":true},{"text":"喜歡使律法","poem":1},{"noteId":40},{"text":"為大，為尊。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"但這百姓是被搶被奪的，","poem":1},{"lineBreak":true},{"text":"都牢籠在坑中，隱藏在獄裏；","poem":1},{"lineBreak":true},{"text":"他們作掠物，無人拯救，","poem":1},{"lineBreak":true},{"text":"作擄物，無人說交還。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你們中間誰肯側耳聽此，","poem":1},{"lineBreak":true},{"text":"誰肯留心而聽，以防將來呢？","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"誰將雅各交出當作擄物，","poem":1},{"lineBreak":true},{"text":"將以色列交給搶奪的呢？","poem":1},{"lineBreak":true},{"text":"豈不是耶和華嗎？","poem":1},{"lineBreak":true},{"text":"就是我們所得罪的那位。","poem":1},{"lineBreak":true},{"text":"他們不肯遵行他的道，","poem":1},{"lineBreak":true},{"text":"也不聽從他的訓誨。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"所以，他將猛烈的怒氣和爭戰的勇力","poem":1},{"lineBreak":true},{"text":"傾倒在以色列的身上。","poem":1},{"lineBreak":true},{"text":"在他四圍如火着起，他還不知道，","poem":1},{"lineBreak":true},{"text":"燒着他，他也不介意。","poem":1}]}],"footnotes":[{"noteId":39,"caller":"-","text":"中保：原文是約","reference":{"chapter":42,"verse":6}},{"noteId":40,"caller":"-","text":"或譯：訓誨","reference":{"chapter":42,"verse":21}}]},"thisChapterLink":"/api/cmn_cuv/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}