{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":45,"content":[{"type":"heading","content":["耶和華立塞魯士為王"]},{"type":"verse","number":1,"content":[{"text":"我－耶和華所膏的塞魯士；","poem":1},{"lineBreak":true},{"text":"我攙扶他的右手，","poem":1},{"lineBreak":true},{"text":"使列國降伏在他面前。","poem":1},{"lineBreak":true},{"text":"我也要放鬆列王的腰帶，","poem":1},{"lineBreak":true},{"text":"使城門在他面前敞開，","poem":1},{"lineBreak":true},{"text":"不得關閉。","poem":1},{"lineBreak":true},{"text":"我對他如此說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我必在你前面行，","poem":1},{"lineBreak":true},{"text":"修平崎嶇之地。","poem":1},{"lineBreak":true},{"text":"我必打破銅門，","poem":1},{"lineBreak":true},{"text":"砍斷鐵閂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我要將暗中的寶物和隱密的財寶賜給你，","poem":1},{"lineBreak":true},{"text":"使你知道提名召你的，","poem":1},{"lineBreak":true},{"text":"就是我－耶和華、以色列的上帝。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因我僕人雅各，","poem":1},{"lineBreak":true},{"text":"我所揀選以色列的緣故，","poem":1},{"lineBreak":true},{"text":"我就提名召你；","poem":1},{"lineBreak":true},{"text":"你雖不認識我，","poem":1},{"lineBreak":true},{"text":"我也加給你名號。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我是耶和華，在我以外並沒有別神；","poem":1},{"lineBreak":true},{"text":"除了我以外再沒有上帝。","poem":1},{"lineBreak":true},{"text":"你雖不認識我，","poem":1},{"lineBreak":true},{"text":"我必給你束腰。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"從日出之地到日落之處","poem":1},{"lineBreak":true},{"text":"使人都知道除了我以外，沒有別神。","poem":1},{"lineBreak":true},{"text":"我是耶和華；","poem":1},{"lineBreak":true},{"text":"在我以外並沒有別神。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我造光，又造暗；","poem":1},{"lineBreak":true},{"text":"我施平安，又降災禍；","poem":1},{"lineBreak":true},{"text":"造作這一切的是我－耶和華。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"諸天哪，自上而滴，","poem":1},{"lineBreak":true},{"text":"穹蒼降下公義；","poem":1},{"lineBreak":true},{"text":"地面開裂，產出救恩，","poem":1},{"lineBreak":true},{"text":"使公義一同發生；","poem":1},{"lineBreak":true},{"text":"這都是我－耶和華所造的。","poem":1}]},{"type":"heading","content":["創造和歷史的主宰"]},{"type":"verse","number":9,"content":[{"text":"禍哉，那與造他的主爭論的！","poem":1},{"lineBreak":true},{"text":"他不過是地上瓦片中的一塊瓦片。","poem":1},{"lineBreak":true},{"text":"泥土豈可對摶弄它的說：你做甚麼呢？","poem":1},{"lineBreak":true},{"text":"所做的物豈可說：你沒有手呢？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"禍哉，那對父親說：","poem":1},{"lineBreak":true},{"text":"你生的是甚麼呢？","poem":1},{"lineBreak":true},{"text":"或對母親","poem":1},{"noteId":44},{"text":"說：","poem":1},{"lineBreak":true},{"text":"你產的是甚麼呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華－以色列的聖者，","poem":1},{"lineBreak":true},{"text":"就是造就以色列的如此說：","poem":1},{"lineBreak":true},{"text":"將來的事，你們可以問我；","poem":1},{"lineBreak":true},{"text":"至於我的眾子，並我手的工作，","poem":1},{"lineBreak":true},{"text":"你們可以求我命定","poem":1},{"noteId":45},{"text":"。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我造地，又造人在地上。","poem":1},{"lineBreak":true},{"text":"我親手鋪張諸天；","poem":1},{"lineBreak":true},{"text":"天上萬象也是我所命定的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我憑公義興起塞魯士","poem":1},{"noteId":46},{"text":"，","poem":1},{"lineBreak":true},{"text":"又要修直他一切道路。","poem":1},{"lineBreak":true},{"text":"他必建造我的城，","poem":1},{"lineBreak":true},{"text":"釋放我被擄的民；","poem":1},{"lineBreak":true},{"text":"不是為工價，也不是為賞賜。","poem":1},{"lineBreak":true},{"text":"這是萬軍之耶和華說的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"埃及勞碌得來的和古實的貨物必歸你；","poem":1},{"lineBreak":true},{"text":"身量高大的西巴人必投降你，也要屬你。","poem":1},{"lineBreak":true},{"text":"他們必帶着鎖鍊過來隨從你，","poem":1},{"lineBreak":true},{"text":"又向你下拜，祈求你說：","poem":1},{"lineBreak":true},{"text":"上帝真在你們中間，此外再沒有別神；","poem":1},{"lineBreak":true},{"text":"再沒有別的上帝。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"救主－以色列的上帝啊，","poem":1},{"lineBreak":true},{"text":"你實在是自隱的上帝。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"凡製造偶像的都必抱愧蒙羞，","poem":1},{"lineBreak":true},{"text":"都要一同歸於慚愧。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"惟有以色列必蒙耶和華的拯救，","poem":1},{"lineBreak":true},{"text":"得永遠的救恩。","poem":1},{"lineBreak":true},{"text":"你們必不蒙羞，也不抱愧，","poem":1},{"lineBreak":true},{"text":"直到永世無盡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"創造諸天的耶和華，","poem":1},{"lineBreak":true},{"text":"製造成全大地的上帝，","poem":1},{"lineBreak":true},{"text":"他創造堅定大地，","poem":1},{"lineBreak":true},{"text":"並非使地荒涼，","poem":1},{"lineBreak":true},{"text":"是要給人居住。","poem":1},{"lineBreak":true},{"text":"他如此說：","poem":1},{"lineBreak":true},{"text":"我是耶和華，再沒有別神。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我沒有在隱密黑暗之地說話；","poem":1},{"lineBreak":true},{"text":"我沒有對雅各的後裔說：","poem":1},{"lineBreak":true},{"text":"你們尋求我是徒然的。","poem":1},{"lineBreak":true},{"text":"我－耶和華所講的是公義，","poem":1},{"lineBreak":true},{"text":"所說的是正直。","poem":1}]},{"type":"heading","content":["天地之主和巴比倫的偶像"]},{"type":"verse","number":20,"content":[{"text":"你們從列國逃脫的人，","poem":1},{"lineBreak":true},{"text":"要一同聚集前來。","poem":1},{"lineBreak":true},{"text":"那些抬着雕刻木偶、","poem":1},{"lineBreak":true},{"text":"禱告不能救人之神的，","poem":1},{"lineBreak":true},{"text":"毫無知識。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你們要述說陳明你們的理，","poem":1},{"lineBreak":true},{"text":"讓他們彼此商議。","poem":1},{"lineBreak":true},{"text":"誰從古時指明？","poem":1},{"lineBreak":true},{"text":"誰從上古述說？","poem":1},{"lineBreak":true},{"text":"不是我－耶和華嗎？","poem":1},{"lineBreak":true},{"text":"除了我以外，再沒有上帝；","poem":1},{"lineBreak":true},{"text":"我是公義的上帝，又是救主；","poem":1},{"lineBreak":true},{"text":"除了我以外，再沒有別神。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"地極的人都當仰望我，","poem":1},{"lineBreak":true},{"text":"就必得救；","poem":1},{"lineBreak":true},{"text":"因為我是上帝，再沒有別神。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我指着自己起誓，","poem":1},{"lineBreak":true},{"text":"我口所出的話是憑公義，並不反回：","poem":1},{"lineBreak":true},{"text":"萬膝必向我跪拜；","poem":1},{"lineBreak":true},{"text":"萬口必憑我起誓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"人論我說，","poem":1},{"lineBreak":true},{"text":"公義、能力，惟獨在乎耶和華；","poem":1},{"lineBreak":true},{"text":"人都必歸向他。","poem":1},{"lineBreak":true},{"text":"凡向他發怒的必至蒙羞。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"以色列的後裔都必因耶和華得稱為義，","poem":1},{"lineBreak":true},{"text":"並要誇耀。","poem":1}]}],"footnotes":[{"noteId":44,"caller":"-","text":"原文是婦人","reference":{"chapter":45,"verse":10}},{"noteId":45,"caller":"-","text":"原文是吩咐我","reference":{"chapter":45,"verse":11}},{"noteId":46,"caller":"-","text":"原文是他","reference":{"chapter":45,"verse":13}}]},"thisChapterLink":"/api/cmn_cuv/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}