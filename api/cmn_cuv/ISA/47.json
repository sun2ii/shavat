{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":47,"content":[{"type":"heading","content":["審判巴比倫"]},{"type":"verse","number":1,"content":[{"text":"巴比倫的處女啊，","poem":1},{"lineBreak":true},{"text":"下來坐在塵埃；","poem":1},{"lineBreak":true},{"text":"迦勒底的閨女啊，","poem":1},{"lineBreak":true},{"text":"沒有寶座，要坐在地上；","poem":1},{"lineBreak":true},{"text":"因為你不再稱為柔弱嬌嫩的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要用磨磨麵，","poem":1},{"lineBreak":true},{"text":"揭去帕子，","poem":1},{"lineBreak":true},{"text":"脫去長衣，露腿詵河。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的下體必被露出；","poem":1},{"lineBreak":true},{"text":"你的醜陋必被看見。","poem":1},{"lineBreak":true},{"text":"我要報仇，","poem":1},{"lineBreak":true},{"text":"誰也不寬容。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我們救贖主的名是","poem":1},{"lineBreak":true},{"text":"萬軍之耶和華－以色列的聖者。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"迦勒底的閨女啊，","poem":1},{"lineBreak":true},{"text":"你要默然靜坐，進入暗中，","poem":1},{"lineBreak":true},{"text":"因為你不再稱為列國的主母。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我向我的百姓發怒，","poem":1},{"lineBreak":true},{"text":"使我的產業被褻瀆，","poem":1},{"lineBreak":true},{"text":"將他們交在你手中，","poem":1},{"lineBreak":true},{"text":"你毫不憐憫他們，","poem":1},{"lineBreak":true},{"text":"把極重的軛加在老年人身上。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你自己說：我必永為主母，","poem":1},{"lineBreak":true},{"text":"所以你不將這事放在心上，","poem":1},{"lineBreak":true},{"text":"也不思想這事的結局。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你這專好宴樂、安然居住的，","poem":1},{"lineBreak":true},{"text":"現在當聽這話。","poem":1},{"lineBreak":true},{"text":"你心中說：惟有我，","poem":1},{"lineBreak":true},{"text":"除我以外再沒有別的。","poem":1},{"lineBreak":true},{"text":"我必不致寡居，","poem":1},{"lineBreak":true},{"text":"也不遭喪子之事。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"哪知，喪子、寡居這兩件事","poem":1},{"lineBreak":true},{"text":"在一日轉眼之間必臨到你；","poem":1},{"lineBreak":true},{"text":"正在你多行邪術、廣施符咒的時候，","poem":1},{"lineBreak":true},{"text":"這兩件事必全然臨到你身上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你素來倚仗自己的惡行，說：","poem":1},{"lineBreak":true},{"text":"無人看見我。","poem":1},{"lineBreak":true},{"text":"你的智慧聰明使你偏邪，","poem":1},{"lineBreak":true},{"text":"並且你心裏說：惟有我，","poem":1},{"lineBreak":true},{"text":"除我以外再沒有別的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因此，禍患要臨到你身；","poem":1},{"lineBreak":true},{"text":"你不知何時發現","poem":1},{"noteId":47},{"text":"，","poem":1},{"lineBreak":true},{"text":"災害落在你身上，","poem":1},{"lineBreak":true},{"text":"你也不能除掉；","poem":1},{"lineBreak":true},{"text":"所不知道的毀滅也必忽然臨到你身。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"站起來吧！","poem":1},{"lineBreak":true},{"text":"用你從幼年勞神施行的符咒和你許多的邪術；","poem":1},{"lineBreak":true},{"text":"或者可得益處，","poem":1},{"lineBreak":true},{"text":"或者可得強勝。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你籌劃太多，以致疲倦。","poem":1},{"lineBreak":true},{"text":"讓那些觀天象的，看星宿的，","poem":1},{"lineBreak":true},{"text":"在月朔說預言的，都站起來，","poem":1},{"lineBreak":true},{"text":"救你脫離所要臨到你的事。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"他們要像碎稭被火焚燒，","poem":1},{"lineBreak":true},{"text":"不能救自己脫離火焰之力；","poem":1},{"lineBreak":true},{"text":"這火並非可烤的炭火，","poem":1},{"lineBreak":true},{"text":"也不是可以坐在其前的火。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你所勞神的事都要這樣與你無益；","poem":1},{"lineBreak":true},{"text":"從幼年與你貿易的也都各奔各鄉，無人救你。","poem":1}]}],"footnotes":[{"noteId":47,"caller":"-","text":"或譯：如何驅逐","reference":{"chapter":47,"verse":11}}]},"thisChapterLink":"/api/cmn_cuv/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}