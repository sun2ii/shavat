{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":49,"content":[{"type":"heading","content":["外邦之光"]},{"type":"verse","number":1,"content":[{"text":"眾海島啊，當聽我言！","poem":1},{"lineBreak":true},{"text":"遠方的眾民哪，留心而聽！","poem":1},{"lineBreak":true},{"text":"自我出胎，耶和華就選召我；","poem":1},{"lineBreak":true},{"text":"自出母腹，他就提我的名。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他使我的口如快刀，","poem":1},{"lineBreak":true},{"text":"將我藏在他手蔭之下；","poem":1},{"lineBreak":true},{"text":"又使我成為磨亮的箭，","poem":1},{"lineBreak":true},{"text":"將我藏在他箭袋之中；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"對我說：你是我的僕人以色列；","poem":1},{"lineBreak":true},{"text":"我必因你得榮耀。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我卻說：我勞碌是徒然；","poem":1},{"lineBreak":true},{"text":"我盡力是虛無虛空。","poem":1},{"lineBreak":true},{"text":"然而，我當得的理必在耶和華那裏；","poem":1},{"lineBreak":true},{"text":"我的賞賜必在我上帝那裏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和華從我出胎，造就我作他的僕人，","poem":1},{"lineBreak":true},{"text":"要使雅各歸向他，","poem":1},{"lineBreak":true},{"text":"使以色列到他那裏聚集。","poem":1},{"lineBreak":true},{"text":"原來耶和華看我為尊貴；","poem":1},{"lineBreak":true},{"text":"我的上帝也成為我的力量。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"現在他說：你作我的僕人，","poem":1},{"lineBreak":true},{"text":"使雅各眾支派復興，","poem":1},{"lineBreak":true},{"text":"使以色列中得保全的歸回尚為小事，","poem":1},{"lineBreak":true},{"text":"我還要使你作外邦人的光，","poem":1},{"lineBreak":true},{"text":"叫你施行我的救恩，直到地極。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"救贖主－以色列的聖者耶和華","poem":1},{"lineBreak":true},{"text":"對那被人所藐視、本國所憎惡、","poem":1},{"lineBreak":true},{"text":"官長所虐待的如此說：","poem":1},{"lineBreak":true},{"text":"君王要看見就站起，","poem":1},{"lineBreak":true},{"text":"首領也要下拜；","poem":1},{"lineBreak":true},{"text":"都因信實的耶和華，","poem":1},{"lineBreak":true},{"text":"就是揀選你－以色列的聖者。","poem":1}]},{"type":"heading","content":["耶路撒冷的復興"]},{"type":"verse","number":8,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"在悅納的時候，我應允了你；","poem":1},{"lineBreak":true},{"text":"在拯救的日子，我濟助了你。","poem":1},{"lineBreak":true},{"text":"我要保護你，","poem":1},{"lineBreak":true},{"text":"使你作眾民的中保","poem":1},{"noteId":50},{"text":"；","poem":1},{"lineBreak":true},{"text":"復興遍地，","poem":1},{"lineBreak":true},{"text":"使人承受荒涼之地為業。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"對那被捆綁的人說：出來吧！","poem":1},{"lineBreak":true},{"text":"對那在黑暗的人說：顯露吧！","poem":1},{"lineBreak":true},{"text":"他們在路上必得飲食，","poem":1},{"lineBreak":true},{"text":"在一切淨光的高處必有食物。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"不飢不渴，","poem":1},{"lineBreak":true},{"text":"炎熱和烈日必不傷害他們；","poem":1},{"lineBreak":true},{"text":"因為憐恤他們的必引導他們，","poem":1},{"lineBreak":true},{"text":"領他們到水泉旁邊。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我必使我的眾山成為大道；","poem":1},{"lineBreak":true},{"text":"我的大路也被修高。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"看哪，這些從遠方來；","poem":1},{"lineBreak":true},{"text":"這些從北方、從西方來；","poem":1},{"lineBreak":true},{"text":"這些從秦","poem":1},{"noteId":51},{"text":"國來。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"諸天哪，應當歡呼！","poem":1},{"lineBreak":true},{"text":"大地啊，應當快樂！","poem":1},{"lineBreak":true},{"text":"眾山哪，應當發聲歌唱！","poem":1},{"lineBreak":true},{"text":"因為耶和華已經安慰他的百姓，","poem":1},{"lineBreak":true},{"text":"也要憐恤他困苦之民。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"錫安說：耶和華離棄了我；","poem":1},{"lineBreak":true},{"text":"主忘記了我。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"婦人焉能忘記她吃奶的嬰孩，","poem":1},{"lineBreak":true},{"text":"不憐恤她所生的兒子？","poem":1},{"lineBreak":true},{"text":"即或有忘記的，","poem":1},{"lineBreak":true},{"text":"我卻不忘記你。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"看哪，我將你銘刻在我掌上；","poem":1},{"lineBreak":true},{"text":"你的牆垣常在我眼前。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你的兒女必急速歸回；","poem":1},{"lineBreak":true},{"text":"毀壞你的，使你荒廢的，必都離你出去，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你舉目向四方觀看；","poem":1},{"lineBreak":true},{"text":"他們都聚集來到你這裏。","poem":1},{"lineBreak":true},{"text":"耶和華說：我指着我的永生起誓：","poem":1},{"lineBreak":true},{"text":"你必要以他們為妝飾佩戴，","poem":1},{"lineBreak":true},{"text":"以他們為華帶束腰，像新婦一樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"至於你荒廢淒涼之處，","poem":1},{"lineBreak":true},{"text":"並你被毀壞之地，","poem":1},{"lineBreak":true},{"text":"現今眾民居住必顯為太窄；","poem":1},{"lineBreak":true},{"text":"吞滅你的必離你遙遠。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你必聽見喪子之後所生的兒女說：","poem":1},{"lineBreak":true},{"text":"這地方我居住太窄，","poem":1},{"lineBreak":true},{"text":"求你給我地方居住。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"那時你心裏必說：我既喪子獨居，","poem":1},{"lineBreak":true},{"text":"是被擄的，漂流在外。","poem":1},{"lineBreak":true},{"text":"誰給我生這些？","poem":1},{"lineBreak":true},{"text":"誰將這些養大呢？","poem":1},{"lineBreak":true},{"text":"撇下我一人獨居的時候，","poem":1},{"lineBreak":true},{"text":"這些在哪裏呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"主耶和華如此說：","poem":1},{"lineBreak":true},{"text":"我必向列國舉手，","poem":1},{"lineBreak":true},{"text":"向萬民豎立大旗；","poem":1},{"lineBreak":true},{"text":"他們必將你的眾子懷中抱來，","poem":1},{"lineBreak":true},{"text":"將你的眾女肩上扛來。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"列王必作你的養父；","poem":1},{"lineBreak":true},{"text":"王后必作你的乳母。","poem":1},{"lineBreak":true},{"text":"他們必將臉伏地，向你下拜，","poem":1},{"lineBreak":true},{"text":"並舔你腳上的塵土。","poem":1},{"lineBreak":true},{"text":"你便知道我是耶和華；","poem":1},{"lineBreak":true},{"text":"等候我的必不致羞愧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"勇士搶去的豈能奪回？","poem":1},{"lineBreak":true},{"text":"該擄掠的豈能解救嗎？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"但耶和華如此說：","poem":1},{"lineBreak":true},{"text":"就是勇士所擄掠的，也可以奪回；","poem":1},{"lineBreak":true},{"text":"強暴人所搶的，也可以解救。","poem":1},{"lineBreak":true},{"text":"與你相爭的，我必與他相爭；","poem":1},{"lineBreak":true},{"text":"我要拯救你的兒女。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"並且我必使那欺壓你的吃自己的肉，","poem":1},{"lineBreak":true},{"text":"也要以自己的血喝醉，好像喝甜酒一樣。","poem":1},{"lineBreak":true},{"text":"凡有血氣的必都知道我－耶和華是你的救主，","poem":1},{"lineBreak":true},{"text":"是你的救贖主，是雅各的大能者。","poem":1}]}],"footnotes":[{"noteId":50,"caller":"-","text":"中保：原文是約","reference":{"chapter":49,"verse":8}},{"noteId":51,"caller":"-","text":"原文是希尼","reference":{"chapter":49,"verse":12}}]},"thisChapterLink":"/api/cmn_cuv/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}