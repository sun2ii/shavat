{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":5,"content":[{"type":"heading","content":["葡萄園之歌"]},{"type":"verse","number":1,"content":[{"text":"我要為我所親愛的唱歌，","poem":1},{"lineBreak":true},{"text":"是我所愛者的歌，論他葡萄園的事：","poem":1},{"lineBreak":true},{"text":"我所親愛的有葡萄園在肥美的山岡上。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他刨挖園子，撿去石頭，","poem":1},{"lineBreak":true},{"text":"栽種上等的葡萄樹，","poem":1},{"lineBreak":true},{"text":"在園中蓋了一座樓，","poem":1},{"lineBreak":true},{"text":"又鑿出壓酒池；","poem":1},{"lineBreak":true},{"text":"指望結好葡萄，","poem":1},{"lineBreak":true},{"text":"反倒結了野葡萄。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶路撒冷的居民和猶大人哪，","poem":1},{"lineBreak":true},{"text":"請你們現今在我與我的葡萄園中，斷定是非。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我為我葡萄園所做之外，","poem":1},{"lineBreak":true},{"text":"還有甚麼可做的呢？","poem":1},{"lineBreak":true},{"text":"我指望結好葡萄，","poem":1},{"lineBreak":true},{"text":"怎麼倒結了野葡萄呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"現在我告訴你們，","poem":1},{"lineBreak":true},{"text":"我要向我葡萄園怎樣行：","poem":1},{"lineBreak":true},{"text":"我必撤去籬笆，使它被吞滅，","poem":1},{"lineBreak":true},{"text":"拆毀牆垣，使它被踐踏。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我必使它荒廢，不再修理，","poem":1},{"lineBreak":true},{"text":"不再鋤刨，荊棘蒺藜倒要生長。","poem":1},{"lineBreak":true},{"text":"我也必命雲不降雨在其上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"萬軍之耶和華的葡萄園就是以色列家；","poem":1},{"lineBreak":true},{"text":"他所喜愛的樹就是猶大人。","poem":1},{"lineBreak":true},{"text":"他指望的是公平，","poem":1},{"lineBreak":true},{"text":"誰知倒有暴虐","poem":1},{"noteId":2},{"text":"；","poem":1},{"lineBreak":true},{"text":"指望的是公義，","poem":1},{"lineBreak":true},{"text":"誰知倒有冤聲。","poem":1}]},{"type":"heading","content":["人的惡行"]},{"type":"verse","number":8,"content":[{"text":"禍哉！那些以房接房，","poem":1},{"lineBreak":true},{"text":"以地連地，","poem":1},{"lineBreak":true},{"text":"以致不留餘地的，","poem":1},{"lineBreak":true},{"text":"只顧自己獨居境內。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我耳聞萬軍之耶和華說：","poem":1},{"lineBreak":true},{"text":"必有許多又大又美的房屋","poem":1},{"lineBreak":true},{"text":"成為荒涼，無人居住。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"三十畝葡萄園只出一罷特酒；","poem":1},{"lineBreak":true},{"text":"一賀梅珥穀種只結一伊法糧食。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"禍哉！那些清早起來追求濃酒，","poem":1},{"lineBreak":true},{"text":"留連到夜深，甚至因酒發燒的人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們在筵席上","poem":1},{"lineBreak":true},{"text":"彈琴，鼓瑟，擊鼓，吹笛，飲酒，","poem":1},{"lineBreak":true},{"text":"卻不顧念耶和華的作為，","poem":1},{"lineBreak":true},{"text":"也不留心他手所做的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"所以，我的百姓因無知就被擄去；","poem":1},{"lineBreak":true},{"text":"他們的尊貴人甚是飢餓，","poem":1},{"lineBreak":true},{"text":"群眾極其乾渴。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"故此，陰間擴張其欲，","poem":1},{"lineBreak":true},{"text":"開了無限量的口；","poem":1},{"lineBreak":true},{"text":"他們的榮耀、群眾、繁華，","poem":1},{"lineBreak":true},{"text":"並快樂的人都落在其中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"卑賤人被壓服；","poem":1},{"lineBreak":true},{"text":"尊貴人降為卑；","poem":1},{"lineBreak":true},{"text":"眼目高傲的人也降為卑。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"惟有萬軍之耶和華因公平而崇高；","poem":1},{"lineBreak":true},{"text":"聖者上帝因公義顯為聖。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"那時，羊羔必來吃草，如同在自己的草場；","poem":1},{"lineBreak":true},{"text":"豐肥人的荒場被遊行的人吃盡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"禍哉！那些以虛假之細繩牽罪孽的人！","poem":1},{"lineBreak":true},{"text":"他們又像以套繩拉罪惡，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"說：任他急速行，趕快成就他的作為，","poem":1},{"lineBreak":true},{"text":"使我們看看；","poem":1},{"lineBreak":true},{"text":"任以色列聖者所謀劃的臨近成就，","poem":1},{"lineBreak":true},{"text":"使我們知道。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"禍哉！那些稱惡為善，稱善為惡，","poem":1},{"lineBreak":true},{"text":"以暗為光，以光為暗，","poem":1},{"lineBreak":true},{"text":"以苦為甜，以甜為苦的人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"禍哉！那些自以為有智慧，","poem":1},{"lineBreak":true},{"text":"自看為通達的人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"禍哉！那些勇於飲酒，","poem":1},{"lineBreak":true},{"text":"以能力調濃酒的人。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他們因受賄賂，就稱惡人為義，","poem":1},{"lineBreak":true},{"text":"將義人的義奪去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"火苗怎樣吞滅碎稭，","poem":1},{"lineBreak":true},{"text":"乾草怎樣落在火焰之中，","poem":1},{"lineBreak":true},{"text":"照樣，他們的根必像朽物，","poem":1},{"lineBreak":true},{"text":"他們的花必像灰塵飛騰；","poem":1},{"lineBreak":true},{"text":"因為他們厭棄萬軍之耶和華的訓誨，","poem":1},{"lineBreak":true},{"text":"藐視以色列聖者的言語。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"所以，耶和華的怒氣向他的百姓發作。","poem":1},{"lineBreak":true},{"text":"他的手伸出攻擊他們，山嶺就震動；","poem":1},{"lineBreak":true},{"text":"他們的屍首在街市上好像糞土。","poem":1},{"lineBreak":true},{"text":"雖然如此，他的怒氣還未轉消；","poem":1},{"lineBreak":true},{"text":"他的手仍伸不縮。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他必豎立大旗，招遠方的國民，","poem":1},{"lineBreak":true},{"text":"發嘶聲叫他們從地極而來；","poem":1},{"lineBreak":true},{"text":"看哪，他們必急速奔來。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"其中沒有疲倦的，絆跌的；","poem":1},{"lineBreak":true},{"text":"沒有打盹的，睡覺的；","poem":1},{"lineBreak":true},{"text":"腰帶並不放鬆，","poem":1},{"lineBreak":true},{"text":"鞋帶也不折斷。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他們的箭快利，","poem":1},{"lineBreak":true},{"text":"弓也上了弦。","poem":1},{"lineBreak":true},{"text":"馬蹄算如堅石，","poem":1},{"lineBreak":true},{"text":"車輪好像旋風。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他們要吼叫，像母獅子，","poem":1},{"lineBreak":true},{"text":"咆哮，像少壯獅子；","poem":1},{"lineBreak":true},{"text":"他們要咆哮抓食，","poem":1},{"lineBreak":true},{"text":"坦然叼去，無人救回。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"那日，他們要向以色列人吼叫，","poem":1},{"lineBreak":true},{"text":"像海浪匉訇；","poem":1},{"lineBreak":true},{"text":"人若望地，只見黑暗艱難，","poem":1},{"lineBreak":true},{"text":"光明在雲中變為昏暗。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"-","text":"或譯：倒流人血","reference":{"chapter":5,"verse":7}}]},"thisChapterLink":"/api/cmn_cuv/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}