{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":52,"content":[{"type":"heading","content":["上帝要拯救耶路撒冷"]},{"type":"verse","number":1,"content":[{"text":"錫安哪，興起！興起！","poem":1},{"lineBreak":true},{"text":"披上你的能力！","poem":1},{"lineBreak":true},{"text":"聖城耶路撒冷啊，穿上你華美的衣服！","poem":1},{"lineBreak":true},{"text":"因為從今以後，","poem":1},{"lineBreak":true},{"text":"未受割禮、不潔淨的必不再進入你中間。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，要抖下塵土！","poem":1},{"lineBreak":true},{"text":"起來坐在位上！","poem":1},{"lineBreak":true},{"text":"錫安被擄的居民","poem":1},{"noteId":53},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"要解開你頸項的鎖鍊！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":["耶和華如此說：「你們是無價被賣的，也必無銀被贖。"]},{"type":"verse","number":4,"content":["主耶和華如此說：起先我的百姓下到埃及，在那裏寄居，又有亞述人無故欺壓他們。"]},{"type":"verse","number":5,"content":["耶和華說：我的百姓既是無價被擄去，如今我在這裏做甚麼呢？耶和華說：轄制他們的人呼叫，我的名整天受褻瀆。"]},{"type":"verse","number":6,"content":["所以，我的百姓必知道我的名；到那日他們必知道說這話的就是我。看哪，是我！」"]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"那報佳音，傳平安，","poem":1},{"lineBreak":true},{"text":"報好信，傳救恩的，","poem":1},{"lineBreak":true},{"text":"對錫安說：你的上帝作王了！","poem":1},{"lineBreak":true},{"text":"這人的腳登山何等佳美！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"聽啊，你守望之人的聲音，","poem":1},{"lineBreak":true},{"text":"他們揚起聲來，一同歌唱；","poem":1},{"lineBreak":true},{"text":"因為耶和華歸回錫安的時候，","poem":1},{"lineBreak":true},{"text":"他們必親眼看見。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶路撒冷的荒場啊，","poem":1},{"lineBreak":true},{"text":"要發起歡聲，一同歌唱；","poem":1},{"lineBreak":true},{"text":"因為耶和華安慰了他的百姓，","poem":1},{"lineBreak":true},{"text":"救贖了耶路撒冷。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華在萬國眼前露出聖臂；","poem":1},{"lineBreak":true},{"text":"地極的人都看見我們上帝的救恩了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你們離開吧！離開吧！","poem":1},{"lineBreak":true},{"text":"從巴比倫出來。","poem":1},{"lineBreak":true},{"text":"不要沾不潔淨的物；","poem":1},{"lineBreak":true},{"text":"要從其中出來。","poem":1},{"lineBreak":true},{"text":"你們扛抬耶和華器皿的人哪，","poem":1},{"lineBreak":true},{"text":"務要自潔。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你們出來必不致急忙，","poem":1},{"lineBreak":true},{"text":"也不致奔逃。","poem":1},{"lineBreak":true},{"text":"因為，耶和華必在你們前頭行；","poem":1},{"lineBreak":true},{"text":"以色列的上帝必作你們的後盾。","poem":1}]},{"type":"heading","content":["受苦的僕人"]},{"type":"verse","number":13,"content":[{"text":"我的僕人行事必有智慧","poem":1},{"noteId":54},{"text":"，","poem":1},{"lineBreak":true},{"text":"必被高舉上升，","poem":1},{"lineBreak":true},{"text":"且成為至高。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"許多人因他","poem":1},{"noteId":55},{"text":"驚奇；","poem":1},{"lineBreak":true},{"text":"他的面貌比別人憔悴；","poem":1},{"lineBreak":true},{"text":"他的形容比世人枯槁。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"這樣，他必洗淨","poem":1},{"noteId":56},{"text":"許多國民；","poem":1},{"lineBreak":true},{"text":"君王要向他閉口。","poem":1},{"lineBreak":true},{"text":"因所未曾傳與他們的，他們必看見；","poem":1},{"lineBreak":true},{"text":"未曾聽見的，他們要明白。","poem":1}]}],"footnotes":[{"noteId":53,"caller":"-","text":"原文是女子","reference":{"chapter":52,"verse":2}},{"noteId":54,"caller":"-","text":"或譯：行事通達","reference":{"chapter":52,"verse":13}},{"noteId":55,"caller":"-","text":"原文是你","reference":{"chapter":52,"verse":14}},{"noteId":56,"caller":"-","text":"或譯：鼓動","reference":{"chapter":52,"verse":15}}]},"thisChapterLink":"/api/cmn_cuv/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}