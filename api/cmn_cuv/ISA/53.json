{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"我們所傳的","poem":1},{"noteId":57},{"text":"有誰信呢？","poem":1},{"lineBreak":true},{"text":"耶和華的膀臂向誰顯露呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他在耶和華面前生長如嫩芽，","poem":1},{"lineBreak":true},{"text":"像根出於乾地。","poem":1},{"lineBreak":true},{"text":"他無佳形美容；","poem":1},{"lineBreak":true},{"text":"我們看見他的時候，","poem":1},{"lineBreak":true},{"text":"也無美貌使我們羨慕他。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他被藐視，被人厭棄；","poem":1},{"lineBreak":true},{"text":"多受痛苦，常經憂患。","poem":1},{"lineBreak":true},{"text":"他被藐視，","poem":1},{"lineBreak":true},{"text":"好像被人掩面不看的一樣；","poem":1},{"lineBreak":true},{"text":"我們也不尊重他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他誠然擔當我們的憂患，","poem":1},{"lineBreak":true},{"text":"背負我們的痛苦；","poem":1},{"lineBreak":true},{"text":"我們卻以為他受責罰，","poem":1},{"lineBreak":true},{"text":"被上帝擊打苦待了。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"哪知他為我們的過犯受害，","poem":1},{"lineBreak":true},{"text":"為我們的罪孽壓傷。","poem":1},{"lineBreak":true},{"text":"因他受的刑罰，我們得平安；","poem":1},{"lineBreak":true},{"text":"因他受的鞭傷，我們得醫治。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我們都如羊走迷；","poem":1},{"lineBreak":true},{"text":"各人偏行己路；","poem":1},{"lineBreak":true},{"text":"耶和華使我們眾人的罪孽都歸在他身上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"他被欺壓，","poem":1},{"lineBreak":true},{"text":"在受苦的時候卻不開口","poem":1},{"noteId":58},{"text":"；","poem":1},{"lineBreak":true},{"text":"他像羊羔被牽到宰殺之地，","poem":1},{"lineBreak":true},{"text":"又像羊在剪毛的人手下無聲，","poem":1},{"lineBreak":true},{"text":"他也是這樣不開口。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因受欺壓和審判，他被奪去，","poem":1},{"lineBreak":true},{"text":"至於他同世的人，誰想他受鞭打、","poem":1},{"lineBreak":true},{"text":"從活人之地被剪除，","poem":1},{"lineBreak":true},{"text":"是因我百姓的罪過呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他雖然未行強暴，","poem":1},{"lineBreak":true},{"text":"口中也沒有詭詐，","poem":1},{"lineBreak":true},{"text":"人還使他與惡人同埋；","poem":1},{"lineBreak":true},{"text":"誰知死的時候與財主同葬。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和華卻定意","poem":1},{"noteId":59},{"text":"將他壓傷，","poem":1},{"lineBreak":true},{"text":"使他受痛苦。","poem":1},{"lineBreak":true},{"text":"耶和華以他為贖罪祭","poem":1},{"noteId":60},{"text":"。","poem":1},{"lineBreak":true},{"text":"他必看見後裔，並且延長年日。","poem":1},{"lineBreak":true},{"text":"耶和華所喜悅的事必在他手中亨通。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他必看見自己勞苦的功效，","poem":1},{"lineBreak":true},{"text":"便心滿意足。","poem":1},{"lineBreak":true},{"text":"有許多人因認識我的義僕得稱為義；","poem":1},{"lineBreak":true},{"text":"並且他要擔當他們的罪孽。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"所以，我要使他與位大的同分，","poem":1},{"lineBreak":true},{"text":"與強盛的均分擄物。","poem":1},{"lineBreak":true},{"text":"因為他將命傾倒，以致於死；","poem":1},{"lineBreak":true},{"text":"他也被列在罪犯之中。","poem":1},{"lineBreak":true},{"text":"他卻擔當多人的罪，","poem":1},{"lineBreak":true},{"text":"又為罪犯代求。","poem":1}]}],"footnotes":[{"noteId":57,"caller":"-","text":"或譯：所傳與我們的","reference":{"chapter":53,"verse":1}},{"noteId":58,"caller":"-","text":"或譯：他受欺壓，卻自卑不開口","reference":{"chapter":53,"verse":7}},{"noteId":59,"caller":"-","text":"或譯：喜悅","reference":{"chapter":53,"verse":10}},{"noteId":60,"caller":"-","text":"或譯：他獻本身為贖罪祭","reference":{"chapter":53,"verse":10}}]},"thisChapterLink":"/api/cmn_cuv/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}