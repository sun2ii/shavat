{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":55,"content":[{"type":"heading","content":["上帝要施憐憫"]},{"type":"verse","number":1,"content":[{"text":"你們一切乾渴的都當就近水來；","poem":1},{"lineBreak":true},{"text":"沒有銀錢的也可以來。","poem":1},{"lineBreak":true},{"text":"你們都來，買了吃；","poem":1},{"lineBreak":true},{"text":"不用銀錢，不用價值，","poem":1},{"lineBreak":true},{"text":"也來買酒和奶。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們為何花錢","poem":1},{"noteId":63},{"text":"買那不足為食物的？","poem":1},{"lineBreak":true},{"text":"用勞碌得來的買那不使人飽足的呢？","poem":1},{"lineBreak":true},{"text":"你們要留意聽我的話就能吃那美物，","poem":1},{"lineBreak":true},{"text":"得享肥甘，心中喜樂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們當就近我來；","poem":1},{"lineBreak":true},{"text":"側耳而聽，就必得活。","poem":1},{"lineBreak":true},{"text":"我必與你們立永約，","poem":1},{"lineBreak":true},{"text":"就是應許大衛那可靠的恩典。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我已立他作萬民的見證，","poem":1},{"lineBreak":true},{"text":"為萬民的君王和司令。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你素不認識的國民，你也必召來；","poem":1},{"lineBreak":true},{"text":"素不認識你的國民也必向你奔跑，","poem":1},{"lineBreak":true},{"text":"都因耶和華－你的上帝以色列的聖者，","poem":1},{"lineBreak":true},{"text":"因為他已經榮耀你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"當趁耶和華可尋找的時候尋找他，","poem":1},{"lineBreak":true},{"text":"相近的時候求告他。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"惡人當離棄自己的道路；","poem":1},{"lineBreak":true},{"text":"不義的人當除掉自己的意念。","poem":1},{"lineBreak":true},{"text":"歸向耶和華，耶和華就必憐恤他；","poem":1},{"lineBreak":true},{"text":"當歸向我們的上帝，因為上帝必廣行赦免。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華說：我的意念非同你們的意念；","poem":1},{"lineBreak":true},{"text":"我的道路非同你們的道路。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"天怎樣高過地，","poem":1},{"lineBreak":true},{"text":"照樣，我的道路高過你們的道路；","poem":1},{"lineBreak":true},{"text":"我的意念高過你們的意念。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":["雨雪從天而降，並不返回，",{"text":"卻滋潤地土，使地上發芽結實，","poem":1},{"lineBreak":true},{"text":"使撒種的有種，使要吃的有糧。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我口所出的話也必如此，","poem":1},{"lineBreak":true},{"text":"決不徒然返回，","poem":1},{"lineBreak":true},{"text":"卻要成就我所喜悅的，","poem":1},{"lineBreak":true},{"text":"在我發他去成就","poem":1},{"noteId":64},{"text":"的事上必然亨通。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你們必歡歡喜喜而出來，","poem":1},{"lineBreak":true},{"text":"平平安安蒙引導。","poem":1},{"lineBreak":true},{"text":"大山小山必在你們面前發聲歌唱；","poem":1},{"lineBreak":true},{"text":"田野的樹木也都拍掌。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"松樹長出，代替荊棘；","poem":1},{"lineBreak":true},{"text":"番石榴長出，代替蒺藜。","poem":1},{"lineBreak":true},{"text":"這要為耶和華留名，","poem":1},{"lineBreak":true},{"text":"作為永遠的證據，不能剪除。","poem":1}]}],"footnotes":[{"noteId":63,"caller":"-","text":"原文是平銀","reference":{"chapter":55,"verse":2}},{"noteId":64,"caller":"-","text":"發他去成就：或譯所命定","reference":{"chapter":55,"verse":11}}]},"thisChapterLink":"/api/cmn_cuv/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}