{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":56,"content":[{"type":"heading","content":["上帝的子民將包括各國的百姓"]},{"type":"verse","number":1,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"你們當守公平，行公義；","poem":1},{"lineBreak":true},{"text":"因我的救恩臨近，","poem":1},{"lineBreak":true},{"text":"我的公義將要顯現。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"謹守安息日而不干犯，","poem":1},{"lineBreak":true},{"text":"禁止己手而不作惡；","poem":1},{"lineBreak":true},{"text":"如此行、如此持守的人便為有福。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"與耶和華聯合的外邦人不要說：","poem":1},{"lineBreak":true},{"text":"耶和華必定將我從他民中分別出來。","poem":1},{"lineBreak":true},{"text":"太監也不要說：我是枯樹。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因為耶和華如此說：","poem":1},{"lineBreak":true},{"text":"那些謹守我的安息日，","poem":1},{"lineBreak":true},{"text":"揀選我所喜悅的事，","poem":1},{"lineBreak":true},{"text":"持守我約的太監，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我必使他們在我殿中，","poem":1},{"lineBreak":true},{"text":"在我牆內，有記念，有名號，","poem":1},{"lineBreak":true},{"text":"比有兒女的更美。","poem":1},{"lineBreak":true},{"text":"我必賜他們永遠的名，不能剪除。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"還有那些與耶和華聯合的外邦人，","poem":1},{"lineBreak":true},{"text":"要事奉他，要愛耶和華的名，","poem":1},{"lineBreak":true},{"text":"要作他的僕人－","poem":1},{"lineBreak":true},{"text":"就是凡守安息日不干犯，","poem":1},{"lineBreak":true},{"text":"又持守他","poem":1},{"noteId":65},{"text":"約的人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我必領他們到我的聖山，","poem":1},{"lineBreak":true},{"text":"使他們在禱告我的殿中喜樂。","poem":1},{"lineBreak":true},{"text":"他們的燔祭和平安祭，","poem":1},{"lineBreak":true},{"text":"在我壇上必蒙悅納，","poem":1},{"lineBreak":true},{"text":"因我的殿必稱為萬民禱告的殿。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"主耶和華，","poem":1},{"lineBreak":true},{"text":"就是招聚以色列被趕散的，說：","poem":1},{"lineBreak":true},{"text":"在這被招聚的人以外，","poem":1},{"lineBreak":true},{"text":"我還要招聚別人歸併他們。","poem":1}]},{"type":"heading","content":["以色列的領袖被定罪"]},{"type":"verse","number":9,"content":[{"text":"田野的諸獸都來吞吃吧！","poem":1},{"lineBreak":true},{"text":"林中的諸獸也要如此。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他看守的人是瞎眼的，","poem":1},{"lineBreak":true},{"text":"都沒有知識，","poem":1},{"lineBreak":true},{"text":"都是啞巴狗，不能叫喚；","poem":1},{"lineBreak":true},{"text":"但知做夢，躺臥，貪睡，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"這些狗貪食，不知飽足。","poem":1},{"lineBreak":true},{"text":"這些牧人不能明白－","poem":1},{"lineBreak":true},{"text":"各人偏行己路，","poem":1},{"lineBreak":true},{"text":"各從各方求自己的利益。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們說：來吧！我去拿酒，","poem":1},{"lineBreak":true},{"text":"我們飽飲濃酒；","poem":1},{"lineBreak":true},{"text":"明日必和今日一樣，","poem":1},{"lineBreak":true},{"text":"就是宴樂無量極大之日。","poem":1}]}],"footnotes":[{"noteId":65,"caller":"-","text":"原文是我","reference":{"chapter":56,"verse":6}}]},"thisChapterLink":"/api/cmn_cuv/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}