{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":57,"content":[{"type":"heading","content":["以色列拜偶像被定罪"]},{"type":"verse","number":1,"content":[{"text":"義人死亡，","poem":1},{"lineBreak":true},{"text":"無人放在心上；","poem":1},{"lineBreak":true},{"text":"虔誠人被收去，","poem":1},{"lineBreak":true},{"text":"無人思念。","poem":1},{"lineBreak":true},{"text":"這義人被收去是免了將來的禍患；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他們得享","poem":1},{"noteId":66},{"text":"平安。","poem":1},{"lineBreak":true},{"text":"素行正直的，各人在墳裏","poem":1},{"noteId":67},{"text":"安歇。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們這些巫婆的兒子，","poem":1},{"lineBreak":true},{"text":"姦夫和妓女的種子，","poem":1},{"lineBreak":true},{"text":"都要前來！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你們向誰戲笑？","poem":1},{"lineBreak":true},{"text":"向誰張口吐舌呢？","poem":1},{"lineBreak":true},{"text":"你們豈不是悖逆的兒女，","poem":1},{"lineBreak":true},{"text":"虛謊的種類呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你們在橡樹中間，在各青翠樹下慾火攻心；","poem":1},{"lineBreak":true},{"text":"在山谷間，在石穴下殺了兒女；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"在谷中光滑石頭裏有你的分。","poem":1},{"lineBreak":true},{"text":"這些就是你所得的分；","poem":1},{"lineBreak":true},{"text":"你也向他澆了奠祭，獻了供物，","poem":1},{"lineBreak":true},{"text":"因這事我豈能容忍嗎？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你在高而又高的山上安設床榻，","poem":1},{"lineBreak":true},{"text":"也上那裏去獻祭。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你在門後，在門框後，","poem":1},{"lineBreak":true},{"text":"立起你的紀念；","poem":1},{"lineBreak":true},{"text":"向外人赤露，又上去擴張床榻，","poem":1},{"lineBreak":true},{"text":"與他們立約；","poem":1},{"lineBreak":true},{"text":"你在那裏看見他們的床就甚喜愛。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你把油帶到王那裏，","poem":1},{"lineBreak":true},{"text":"又多加香料，","poem":1},{"lineBreak":true},{"text":"打發使者往遠方去，","poem":1},{"lineBreak":true},{"text":"自卑自賤直到陰間，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你因路遠疲倦，","poem":1},{"lineBreak":true},{"text":"卻不說這是枉然；","poem":1},{"lineBreak":true},{"text":"你以為有復興之力，","poem":1},{"lineBreak":true},{"text":"所以不覺疲憊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你怕誰？因誰恐懼？","poem":1},{"lineBreak":true},{"text":"竟說謊，不記念我，","poem":1},{"lineBreak":true},{"text":"又不將這事放在心上。","poem":1},{"lineBreak":true},{"text":"我不是許久閉口不言，","poem":1},{"lineBreak":true},{"text":"你仍不怕我嗎？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我要指明你的公義；","poem":1},{"lineBreak":true},{"text":"至於你所行的都必與你無益。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你哀求的時候，","poem":1},{"lineBreak":true},{"text":"讓你所聚集的拯救你吧！","poem":1},{"lineBreak":true},{"text":"風要把他們颳散，","poem":1},{"lineBreak":true},{"text":"一口氣要把他們都吹去。","poem":1},{"lineBreak":true},{"text":"但那投靠我的必得地土，","poem":1},{"lineBreak":true},{"text":"必承受我的聖山為業。","poem":1}]},{"type":"heading","content":["神應許幫助和醫治"]},{"type":"verse","number":14,"content":[{"text":"耶和華要說：","poem":1},{"lineBreak":true},{"text":"你們修築修築，預備道路，","poem":1},{"lineBreak":true},{"text":"將絆腳石從我百姓的路中除掉。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因為那至高至上、永遠長存","poem":1},{"noteId":68},{"lineBreak":true},{"text":"名為聖者的如此說：","poem":1},{"lineBreak":true},{"text":"我住在至高至聖的所在，","poem":1},{"lineBreak":true},{"text":"也與心靈痛悔謙卑的人同居；","poem":1},{"lineBreak":true},{"text":"要使謙卑人的靈甦醒，","poem":1},{"lineBreak":true},{"text":"也使痛悔人的心甦醒。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我必不永遠相爭，也不長久發怒，","poem":1},{"lineBreak":true},{"text":"恐怕我所造的人與靈性都必發昏。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因他貪婪的罪孽，我就發怒擊打他；","poem":1},{"lineBreak":true},{"text":"我向他掩面發怒，","poem":1},{"lineBreak":true},{"text":"他卻仍然隨心背道。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我看見他所行的道，也要醫治他；","poem":1},{"lineBreak":true},{"text":"又要引導他，","poem":1},{"lineBreak":true},{"text":"使他和那一同傷心的人再得安慰。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我造就嘴唇的果子；","poem":1},{"lineBreak":true},{"text":"願平安康泰歸與遠處的人，","poem":1},{"lineBreak":true},{"text":"也歸與近處的人；","poem":1},{"lineBreak":true},{"text":"並且我要醫治他。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"惟獨惡人，好像翻騰的海，","poem":1},{"lineBreak":true},{"text":"不得平靜；","poem":1},{"lineBreak":true},{"text":"其中的水常湧出污穢和淤泥來。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我的上帝說：惡人必不得平安！","poem":1}]}],"footnotes":[{"noteId":66,"caller":"-","text":"原文是進入","reference":{"chapter":57,"verse":2}},{"noteId":67,"caller":"-","text":"原文是床上","reference":{"chapter":57,"verse":2}},{"noteId":68,"caller":"-","text":"原文是住在永遠","reference":{"chapter":57,"verse":15}}]},"thisChapterLink":"/api/cmn_cuv/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}