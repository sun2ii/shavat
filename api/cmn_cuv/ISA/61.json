{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":61,"content":[{"type":"heading","content":["拯救的好消息"]},{"type":"verse","number":1,"content":[{"text":"主耶和華的靈在我身上；","poem":1},{"lineBreak":true},{"text":"因為耶和華用膏膏我，","poem":1},{"lineBreak":true},{"text":"叫我傳好信息給謙卑的人","poem":1},{"noteId":71},{"text":"，","poem":1},{"lineBreak":true},{"text":"差遣我醫好傷心的人，","poem":1},{"lineBreak":true},{"text":"報告被擄的得釋放，","poem":1},{"lineBreak":true},{"text":"被囚的出監牢；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"報告耶和華的恩年，","poem":1},{"lineBreak":true},{"text":"和我們上帝報仇的日子；","poem":1},{"lineBreak":true},{"text":"安慰一切悲哀的人，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"賜華冠與錫安悲哀的人，代替灰塵；","poem":1},{"lineBreak":true},{"text":"喜樂油代替悲哀；","poem":1},{"lineBreak":true},{"text":"讚美衣代替憂傷之靈；","poem":1},{"lineBreak":true},{"text":"使他們稱為「公義樹」，","poem":1},{"lineBreak":true},{"text":"是耶和華所栽的，叫他得榮耀。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們必修造已久的荒場，","poem":1},{"lineBreak":true},{"text":"建立先前淒涼之處，","poem":1},{"lineBreak":true},{"text":"重修歷代荒涼之城。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"那時，外人必起來牧放你們的羊群；","poem":1},{"lineBreak":true},{"text":"外邦人必作你們耕種田地的，","poem":1},{"lineBreak":true},{"text":"修理葡萄園的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你們倒要稱為耶和華的祭司；","poem":1},{"lineBreak":true},{"text":"人必稱你們為我們上帝的僕役。","poem":1},{"lineBreak":true},{"text":"你們必吃用列國的財物，","poem":1},{"lineBreak":true},{"text":"因得他們的榮耀自誇。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你們必得加倍的好處，代替所受的羞辱；","poem":1},{"lineBreak":true},{"text":"分中所得的喜樂，必代替所受的凌辱。","poem":1},{"lineBreak":true},{"text":"在境內必得加倍的產業；","poem":1},{"lineBreak":true},{"text":"永遠之樂必歸與你們","poem":1},{"noteId":72},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"因為我－耶和華喜愛公平，","poem":1},{"lineBreak":true},{"text":"恨惡搶奪和罪孽；","poem":1},{"lineBreak":true},{"text":"我要憑誠實施行報應，","poem":1},{"lineBreak":true},{"text":"並要與我的百姓立永約。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們的後裔必在列國中被人認識；","poem":1},{"lineBreak":true},{"text":"他們的子孫在眾民中也是如此。","poem":1},{"lineBreak":true},{"text":"凡看見他們的必認他們是耶和華賜福的後裔。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"我因耶和華大大歡喜；","poem":1},{"lineBreak":true},{"text":"我的心靠上帝快樂。","poem":1},{"lineBreak":true},{"text":"因他以拯救為衣給我穿上，","poem":1},{"lineBreak":true},{"text":"以公義為袍給我披上，","poem":1},{"lineBreak":true},{"text":"好像新郎戴上華冠，","poem":1},{"lineBreak":true},{"text":"又像新婦佩戴妝飾。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"田地怎樣使百穀發芽，","poem":1},{"lineBreak":true},{"text":"園子怎樣使所種的發生，","poem":1},{"lineBreak":true},{"text":"主耶和華必照樣","poem":1},{"lineBreak":true},{"text":"使公義和讚美在萬民中發出。","poem":1}]}],"footnotes":[{"noteId":71,"caller":"-","text":"或譯：傳福音給貧窮的人","reference":{"chapter":61,"verse":1}},{"noteId":72,"caller":"-","text":"原文是他們","reference":{"chapter":61,"verse":7}}]},"thisChapterLink":"/api/cmn_cuv/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}