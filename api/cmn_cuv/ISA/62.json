{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":62,"content":[{"type":"verse","number":1,"content":[{"text":"我因錫安必不靜默，","poem":1},{"lineBreak":true},{"text":"為耶路撒冷必不息聲，","poem":1},{"lineBreak":true},{"text":"直到他的公義如光輝發出，","poem":1},{"lineBreak":true},{"text":"他的救恩如明燈發亮。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"列國必見你的公義；","poem":1},{"lineBreak":true},{"text":"列王必見你的榮耀。","poem":1},{"lineBreak":true},{"text":"你必得新名的稱呼，","poem":1},{"lineBreak":true},{"text":"是耶和華親口所起的。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你在耶和華的手中要作為華冠，","poem":1},{"lineBreak":true},{"text":"在你上帝的掌上必作為冕旒。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你必不再稱為「撇棄的」；","poem":1},{"lineBreak":true},{"text":"你的地也不再稱為「荒涼的」。","poem":1},{"lineBreak":true},{"text":"你卻要稱為「我所喜悅的」；","poem":1},{"lineBreak":true},{"text":"你的地也必稱為「有夫之婦」。","poem":1},{"lineBreak":true},{"text":"因為耶和華喜悅你，","poem":1},{"lineBreak":true},{"text":"你的地也必歸他。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"少年人怎樣娶處女，","poem":1},{"lineBreak":true},{"text":"你的眾民","poem":1},{"noteId":73},{"text":"也要照樣娶你；","poem":1},{"lineBreak":true},{"text":"新郎怎樣喜悅新婦，","poem":1},{"lineBreak":true},{"text":"你的上帝也要照樣喜悅你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶路撒冷啊，","poem":1},{"lineBreak":true},{"text":"我在你城上設立守望的，","poem":1},{"lineBreak":true},{"text":"他們晝夜必不靜默。","poem":1},{"lineBreak":true},{"text":"呼籲耶和華的，你們不要歇息，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"也不要使他歇息，","poem":1},{"lineBreak":true},{"text":"直等他建立耶路撒冷，","poem":1},{"lineBreak":true},{"text":"使耶路撒冷在地上成為可讚美的。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華指着自己的右手和大能的膀臂起誓說：","poem":1},{"lineBreak":true},{"text":"我必不再將你的五穀給你仇敵作食物；","poem":1},{"lineBreak":true},{"text":"外邦人也不再喝你勞碌得來的新酒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"惟有那收割的要吃，並讚美耶和華；","poem":1},{"lineBreak":true},{"text":"那聚斂的要在我聖所的院內喝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你們當從門經過經過，","poem":1},{"lineBreak":true},{"text":"預備百姓的路；","poem":1},{"lineBreak":true},{"text":"修築修築大道，","poem":1},{"lineBreak":true},{"text":"撿去石頭，","poem":1},{"lineBreak":true},{"text":"為萬民豎立大旗，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"看哪，耶和華曾宣告到地極，","poem":1},{"lineBreak":true},{"text":"對錫安的居民","poem":1},{"noteId":74},{"text":"說：","poem":1},{"lineBreak":true},{"text":"你的拯救者來到。","poem":1},{"lineBreak":true},{"text":"他的賞賜在他那裏；","poem":1},{"lineBreak":true},{"text":"他的報應在他面前。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"人必稱他們為「聖民」，為「耶和華的贖民」；","poem":1},{"lineBreak":true},{"text":"你也必稱為「被眷顧、不撇棄的城」。","poem":1}]}],"footnotes":[{"noteId":73,"caller":"-","text":"民：原文是子","reference":{"chapter":62,"verse":5}},{"noteId":74,"caller":"-","text":"原文是女子","reference":{"chapter":62,"verse":11}}]},"thisChapterLink":"/api/cmn_cuv/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}