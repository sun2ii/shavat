{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":63,"content":[{"type":"heading","content":["耶和華恩待以色列"]},{"type":"verse","number":1,"content":[{"text":"這從以東的波斯拉來，","poem":1},{"lineBreak":true},{"text":"穿紅衣服，","poem":1},{"lineBreak":true},{"text":"裝扮華美，","poem":1},{"lineBreak":true},{"text":"能力廣大，","poem":1},{"lineBreak":true},{"text":"大步行走的是誰呢？","poem":1},{"lineBreak":true},{"text":"就是我，","poem":1},{"lineBreak":true},{"text":"是憑公義說話，","poem":1},{"lineBreak":true},{"text":"以大能施行拯救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"你的裝扮為何有紅色？","poem":1},{"lineBreak":true},{"text":"你的衣服為何像踹酒醡的呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"我獨自踹酒醡；","poem":1},{"lineBreak":true},{"text":"眾民中無一人與我同在。","poem":1},{"lineBreak":true},{"text":"我發怒將他們踹下，","poem":1},{"lineBreak":true},{"text":"發烈怒將他們踐踏。","poem":1},{"lineBreak":true},{"text":"他們的血濺在我衣服上，","poem":1},{"lineBreak":true},{"text":"並且污染了我一切的衣裳。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因為，報仇之日在我心中；","poem":1},{"lineBreak":true},{"text":"救贖我民之年已經來到。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我仰望，見無人幫助；","poem":1},{"lineBreak":true},{"text":"我詫異，沒有人扶持。","poem":1},{"lineBreak":true},{"text":"所以，我自己的膀臂為我施行拯救；","poem":1},{"lineBreak":true},{"text":"我的烈怒將我扶持。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我發怒，踹下眾民；","poem":1},{"lineBreak":true},{"text":"發烈怒，使他們沉醉，","poem":1},{"lineBreak":true},{"text":"又將他們的血倒在地上。","poem":1}]},{"type":"heading","content":["耶和華對以色列的良善"]},{"type":"verse","number":7,"content":[{"text":"我要照耶和華一切所賜給我們的，","poem":1},{"lineBreak":true},{"text":"提起他的慈愛和美德，","poem":1},{"lineBreak":true},{"text":"並他向以色列家所施的大恩；","poem":1},{"lineBreak":true},{"text":"這恩是照他的憐恤","poem":1},{"lineBreak":true},{"text":"和豐盛的慈愛賜給他們的。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他說：他們誠然是我的百姓，","poem":1},{"lineBreak":true},{"text":"不行虛假的子民；","poem":1},{"lineBreak":true},{"text":"這樣，他就作了他們的救主。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們在一切苦難中，","poem":1},{"lineBreak":true},{"text":"他也同受苦難；","poem":1},{"lineBreak":true},{"text":"並且他面前的使者拯救他們；","poem":1},{"lineBreak":true},{"text":"他以慈愛和憐憫救贖他們；","poem":1},{"lineBreak":true},{"text":"在古時的日子常保抱他們，懷搋他們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"他們竟悖逆，使主的聖靈擔憂。","poem":1},{"lineBreak":true},{"text":"他就轉作他們的仇敵，","poem":1},{"lineBreak":true},{"text":"親自攻擊他們。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"那時，他們","poem":1},{"noteId":75},{"text":"想起古時的日子－","poem":1},{"lineBreak":true},{"text":"摩西和他百姓，說：","poem":1},{"lineBreak":true},{"text":"將百姓和牧養他全群的人","poem":1},{"lineBreak":true},{"text":"從海裏領上來的在哪裏呢？","poem":1},{"lineBreak":true},{"text":"將他的聖靈降在他們中間的在哪裏呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"使他榮耀的膀臂在摩西的右手邊行動，","poem":1},{"lineBreak":true},{"text":"在他們前面將水分開，","poem":1},{"lineBreak":true},{"text":"要建立自己永遠的名，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"帶領他們經過深處，","poem":1},{"lineBreak":true},{"text":"如馬行走曠野，","poem":1},{"lineBreak":true},{"text":"使他們不致絆跌的在哪裏呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華的靈使他們得安息，","poem":1},{"lineBreak":true},{"text":"彷彿牲畜下到山谷；","poem":1},{"lineBreak":true},{"text":"照樣，你也引導你的百姓，","poem":1},{"lineBreak":true},{"text":"要建立自己榮耀的名。","poem":1}]},{"type":"heading","content":["求主憐憫幫助"]},{"type":"verse","number":15,"content":[{"text":"求你從天上垂顧，","poem":1},{"lineBreak":true},{"text":"從你聖潔榮耀的居所觀看。","poem":1},{"lineBreak":true},{"text":"你的熱心和你大能的作為在哪裏呢？","poem":1},{"lineBreak":true},{"text":"你愛慕的心腸和憐憫向我們止住了。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"亞伯拉罕雖然不認識我們，","poem":1},{"lineBreak":true},{"text":"以色列也不承認我們，","poem":1},{"lineBreak":true},{"text":"你卻是我們的父。","poem":1},{"lineBreak":true},{"text":"耶和華啊，你是我們的父；","poem":1},{"lineBreak":true},{"text":"從萬古以來，你名稱為「我們的救贖主」。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和華啊，你為何使我們走差離開你的道，","poem":1},{"lineBreak":true},{"text":"使我們心裏剛硬、不敬畏你呢？","poem":1},{"lineBreak":true},{"text":"求你為你僕人，","poem":1},{"lineBreak":true},{"text":"為你產業支派的緣故，轉回來。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你的聖民不過暫時得這產業；","poem":1},{"lineBreak":true},{"text":"我們的敵人已經踐踏你的聖所。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我們好像你未曾治理的人，","poem":1},{"lineBreak":true},{"text":"又像未曾得稱你名下的人。","poem":1}]}],"footnotes":[{"noteId":75,"caller":"-","text":"原文是他","reference":{"chapter":63,"verse":11}}]},"thisChapterLink":"/api/cmn_cuv/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}