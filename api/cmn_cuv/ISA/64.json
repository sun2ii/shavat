{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"願你裂天而降；","poem":1},{"lineBreak":true},{"text":"願山在你面前震動－","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"好像火燒乾柴，","poem":1},{"lineBreak":true},{"text":"又像火將水燒開，","poem":1},{"lineBreak":true},{"text":"使你敵人知道你的名，","poem":1},{"lineBreak":true},{"text":"使列國在你面前發顫！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你曾行我們不能逆料可畏的事。","poem":1},{"lineBreak":true},{"text":"那時你降臨，山嶺在你面前震動。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"從古以來，人未曾聽見、未曾耳聞、未曾眼見","poem":1},{"lineBreak":true},{"text":"在你以外有甚麼神為等候他的人行事。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你迎接那歡喜行義、記念你道的人；","poem":1},{"lineBreak":true},{"text":"你曾發怒，我們仍犯罪；","poem":1},{"lineBreak":true},{"text":"這景況已久，我們還能得救嗎？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我們都像不潔淨的人；","poem":1},{"lineBreak":true},{"text":"所有的義都像污穢的衣服。","poem":1},{"lineBreak":true},{"text":"我們都像葉子漸漸枯乾；","poem":1},{"lineBreak":true},{"text":"我們的罪孽好像風把我們吹去。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"並且無人求告你的名；","poem":1},{"lineBreak":true},{"text":"無人奮力抓住你。","poem":1},{"lineBreak":true},{"text":"原來你掩面不顧我們，","poem":1},{"lineBreak":true},{"text":"使我們因罪孽消化。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和華啊，現在你仍是我們的父！","poem":1},{"lineBreak":true},{"text":"我們是泥，你是窯匠；","poem":1},{"lineBreak":true},{"text":"我們都是你手的工作。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華啊，求你不要大發震怒，","poem":1},{"lineBreak":true},{"text":"也不要永遠記念罪孽。","poem":1},{"lineBreak":true},{"text":"求你垂顧我們，","poem":1},{"lineBreak":true},{"text":"我們都是你的百姓。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你的聖邑變為曠野。","poem":1},{"lineBreak":true},{"text":"錫安變為曠野；","poem":1},{"lineBreak":true},{"text":"耶路撒冷成為荒場。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我們聖潔華美的殿－","poem":1},{"lineBreak":true},{"text":"就是我們列祖讚美你的所在被火焚燒；","poem":1},{"lineBreak":true},{"text":"我們所羨慕的美地盡都荒廢。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和華啊，有這些事，你還忍得住嗎？","poem":1},{"lineBreak":true},{"text":"你仍靜默使我們深受苦難嗎？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}