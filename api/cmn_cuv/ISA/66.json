{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ISA","translationId":"cmn_cuv","name":"以賽亞書","commonName":"以賽亞書","title":"以賽亞書","order":23,"numberOfChapters":66,"sha256":"921a220806f68d66de57b27dd59223eb1b066e8d56be04c3105a8636a6e23e70","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cmn_cuv/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":66,"content":[{"type":"heading","content":["耶和華審判萬民"]},{"type":"verse","number":1,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"天是我的座位；","poem":1},{"lineBreak":true},{"text":"地是我的腳凳。","poem":1},{"lineBreak":true},{"text":"你們要為我造何等的殿宇？","poem":1},{"lineBreak":true},{"text":"哪裏是我安息的地方呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華說：這一切都是我手所造的，","poem":1},{"lineBreak":true},{"text":"所以就都有了。","poem":1},{"lineBreak":true},{"text":"但我所看顧的，","poem":1},{"lineBreak":true},{"text":"就是虛心","poem":1},{"noteId":78},{"text":"痛悔、","poem":1},{"lineBreak":true},{"text":"因我話而戰兢的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"假冒為善的宰牛，好像殺人，","poem":1},{"lineBreak":true},{"text":"獻羊羔，好像打折狗項，","poem":1},{"lineBreak":true},{"text":"獻供物，好像獻豬血，","poem":1},{"lineBreak":true},{"text":"燒乳香，好像稱頌偶像。","poem":1},{"lineBreak":true},{"text":"這等人揀選自己的道路，","poem":1},{"lineBreak":true},{"text":"心裏喜悅行可憎惡的事。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我也必揀選迷惑他們的事，","poem":1},{"lineBreak":true},{"text":"使他們所懼怕的臨到他們；","poem":1},{"lineBreak":true},{"text":"因為我呼喚，無人答應；","poem":1},{"lineBreak":true},{"text":"我說話，他們不聽從；","poem":1},{"lineBreak":true},{"text":"反倒行我眼中看為惡的，","poem":1},{"lineBreak":true},{"text":"揀選我所不喜悅的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你們因耶和華言語戰兢的人當聽他的話：","poem":1},{"lineBreak":true},{"text":"你們的弟兄－就是恨惡你們，","poem":1},{"lineBreak":true},{"text":"因我名趕出你們的，曾說：","poem":1},{"lineBreak":true},{"text":"願耶和華得榮耀，","poem":1},{"lineBreak":true},{"text":"使我們得見你們的喜樂；","poem":1},{"lineBreak":true},{"text":"但蒙羞的究竟是他們！","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"有喧嘩的聲音出自城中！","poem":1},{"lineBreak":true},{"text":"有聲音出於殿中！","poem":1},{"lineBreak":true},{"text":"是耶和華向仇敵施行報應的聲音！","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"錫安未曾劬勞就生產，","poem":1},{"lineBreak":true},{"text":"未覺疼痛就生出男孩。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"國豈能一日而生？","poem":1},{"lineBreak":true},{"text":"民豈能一時而產？","poem":1},{"lineBreak":true},{"text":"因為錫安一劬勞便生下兒女，","poem":1},{"lineBreak":true},{"text":"這樣的事誰曾聽見？","poem":1},{"lineBreak":true},{"text":"誰曾看見呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華說：我既使她臨產，","poem":1},{"lineBreak":true},{"text":"豈不使她生產呢？","poem":1},{"lineBreak":true},{"text":"你的上帝說：我既使她生產，","poem":1},{"lineBreak":true},{"text":"豈能使她閉胎不生呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你們愛慕耶路撒冷的","poem":1},{"lineBreak":true},{"text":"都要與她一同歡喜快樂；","poem":1},{"lineBreak":true},{"text":"你們為她悲哀的","poem":1},{"lineBreak":true},{"text":"都要與她一同樂上加樂；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"使你們在她安慰的懷中吃奶得飽，","poem":1},{"lineBreak":true},{"text":"使他們得她豐盛的榮耀，","poem":1},{"lineBreak":true},{"text":"猶如擠奶，滿心喜樂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"我要使平安延及她，好像江河，","poem":1},{"lineBreak":true},{"text":"使列國的榮耀延及她，如同漲溢的河。","poem":1},{"lineBreak":true},{"text":"你們要從中享受","poem":1},{"noteId":79},{"text":"；","poem":1},{"lineBreak":true},{"text":"你們必蒙抱在肋旁，搖弄在膝上。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"母親怎樣安慰兒子，我就照樣安慰你們；","poem":1},{"lineBreak":true},{"text":"你們也必因","poem":1},{"noteId":80},{"text":"耶路撒冷得安慰。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你們看見，就心中快樂；","poem":1},{"lineBreak":true},{"text":"你們的骨頭必得滋潤像嫩草一樣；","poem":1},{"lineBreak":true},{"text":"而且耶和華的手向他僕人所行的必被人知道；","poem":1},{"lineBreak":true},{"text":"他也要向仇敵發惱恨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"看哪，耶和華必在火中降臨；","poem":1},{"lineBreak":true},{"text":"他的車輦像旋風，","poem":1},{"lineBreak":true},{"text":"以烈怒施行報應，","poem":1},{"lineBreak":true},{"text":"以火焰施行責罰；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因為耶和華在一切有血氣的人身上，","poem":1},{"lineBreak":true},{"text":"必以火與刀施行審判；","poem":1},{"lineBreak":true},{"text":"被耶和華所殺的必多。","poem":1}]},{"type":"verse","number":17,"content":["「那些分別為聖、潔淨自己的，進入園內跟在其中一個人的後頭，吃豬肉和倉鼠並可憎之物，他們必一同滅絕；這是耶和華說的。"]},{"type":"verse","number":18,"content":["「我知道他們的行為和他們的意念。時候將到，我必將萬民萬族",{"noteId":81},"聚來，看見我的榮耀，"]},{"type":"verse","number":19,"content":["我要顯神蹟",{"noteId":82},"在他們中間。逃脫的，我要差到列國去，就是到他施、普勒、拉弓的路德和土巴、雅完，並素來沒有聽見我名聲、沒有看見我榮耀遼遠的海島；他們必將我的榮耀傳揚在列國中。"]},{"type":"verse","number":20,"content":["他們必將你們的弟兄從列國中送回，使他們或騎馬，或坐車，坐轎，騎騾子，騎獨峰駝，到我的聖山耶路撒冷，作為供物獻給耶和華，好像以色列人用潔淨的器皿盛供物奉到耶和華的殿中；這是耶和華說的。"]},{"type":"verse","number":21,"content":["耶和華說：我也必從他們中間取人為祭司，為利未人。」"]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"耶和華說：我所要造的新天新地，","poem":1},{"lineBreak":true},{"text":"怎樣在我面前長存；","poem":1},{"lineBreak":true},{"text":"你們的後裔和你們的名字也必照樣長存。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"每逢月朔、安息日，","poem":1},{"lineBreak":true},{"text":"凡有血氣的必來在我面前下拜。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他們必出去觀看那些違背我人的屍首；","poem":1},{"lineBreak":true},{"text":"因為他們的蟲是不死的；","poem":1},{"lineBreak":true},{"text":"他們的火是不滅的；","poem":1},{"lineBreak":true},{"text":"凡有血氣的都必憎惡他們。","poem":1}]}],"footnotes":[{"noteId":78,"caller":"-","text":"原文是貧窮","reference":{"chapter":66,"verse":2}},{"noteId":79,"caller":"-","text":"原文是咂","reference":{"chapter":66,"verse":12}},{"noteId":80,"caller":"-","text":"或譯：在","reference":{"chapter":66,"verse":13}},{"noteId":81,"caller":"-","text":"族：原文是舌","reference":{"chapter":66,"verse":18}},{"noteId":82,"caller":"-","text":"或譯：記號","reference":{"chapter":66,"verse":19}}]},"thisChapterLink":"/api/cmn_cuv/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}