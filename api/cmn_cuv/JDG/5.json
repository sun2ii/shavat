{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JDG","translationId":"cmn_cuv","name":"士師記","commonName":"士師記","title":"士師記","order":7,"numberOfChapters":21,"sha256":"6ed3d1cf3bce165264d09e27218a36f1292a6df9ad9d40d1399c8dc8fc4e8900","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/cmn_cuv/JDG/21.json","totalNumberOfVerses":617},"chapter":{"number":5,"content":[{"type":"heading","content":["底波拉和巴拉的歌"]},{"type":"verse","number":1,"content":["那時，底波拉和亞比挪菴的兒子巴拉作歌，說："]},{"type":"verse","number":2,"content":[{"text":"因為以色列中有軍長率領，","poem":1},{"lineBreak":true},{"text":"百姓也甘心犧牲自己，","poem":1},{"lineBreak":true},{"text":"你們應當頌讚耶和華！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"君王啊，要聽！","poem":1},{"lineBreak":true},{"text":"王子啊，要側耳而聽！","poem":1},{"lineBreak":true},{"text":"我要向耶和華歌唱；","poem":1},{"lineBreak":true},{"text":"我要歌頌耶和華－以色列的上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華啊，你從西珥出來，","poem":1},{"lineBreak":true},{"text":"由以東地行走。","poem":1},{"lineBreak":true},{"text":"那時地震天漏，","poem":1},{"lineBreak":true},{"text":"雲也落雨。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"山見耶和華的面就震動，","poem":1},{"lineBreak":true},{"text":"西奈山見耶和華－以色列上帝的面也是如此。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"在亞拿之子珊迦的時候，","poem":1},{"lineBreak":true},{"text":"又在雅億的日子，","poem":1},{"lineBreak":true},{"text":"大道無人行走，","poem":1},{"lineBreak":true},{"text":"都是繞道而行。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"以色列中的官長停職，","poem":1},{"lineBreak":true},{"text":"直到我底波拉興起，","poem":1},{"lineBreak":true},{"text":"等我興起作以色列的母。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"以色列人選擇新神，","poem":1},{"lineBreak":true},{"text":"爭戰的事就臨到城門。","poem":1},{"lineBreak":true},{"text":"那時，以色列四萬人中","poem":1},{"lineBreak":true},{"text":"豈能見盾牌槍矛呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我心傾向以色列的首領，","poem":1},{"lineBreak":true},{"text":"他們在民中甘心犧牲自己。","poem":1},{"lineBreak":true},{"text":"你們應當頌讚耶和華！","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"騎白驢的、坐繡花毯子的、行路的，","poem":1},{"lineBreak":true},{"text":"你們都當傳揚！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"在遠離弓箭響聲打水之處，","poem":1},{"lineBreak":true},{"text":"人必述說耶和華公義的作為，","poem":1},{"lineBreak":true},{"text":"就是他治理以色列公義的作為。","poem":1},{"lineBreak":true},{"text":"那時耶和華的民下到城門。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"底波拉啊，興起！興起！","poem":1},{"lineBreak":true},{"text":"你當興起，興起，唱歌。","poem":1},{"lineBreak":true},{"text":"亞比挪菴的兒子巴拉啊，你當奮興，","poem":1},{"lineBreak":true},{"text":"擄掠你的敵人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"那時有餘剩的貴冑和百姓一同下來；","poem":1},{"lineBreak":true},{"text":"耶和華降臨，為我攻擊勇士。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"有根本在亞瑪力人的地，","poem":1},{"lineBreak":true},{"text":"從以法蓮下來的；","poem":1},{"lineBreak":true},{"text":"便雅憫在民中跟隨你。","poem":1},{"lineBreak":true},{"text":"有掌權的從瑪吉下來；","poem":1},{"lineBreak":true},{"text":"有持杖檢點民數的從西布倫下來；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"以薩迦的首領與底波拉同來；","poem":1},{"lineBreak":true},{"text":"以薩迦怎樣，巴拉也怎樣。","poem":1},{"lineBreak":true},{"text":"眾人都跟隨巴拉衝下平原；","poem":1},{"lineBreak":true},{"text":"在呂便的溪水旁有心中定大志的。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你為何坐在羊圈內","poem":1},{"lineBreak":true},{"text":"聽群中吹笛的聲音呢？","poem":1},{"lineBreak":true},{"text":"在呂便的溪水旁有心中設大謀的。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"基列人安居在約旦河外。","poem":1},{"lineBreak":true},{"text":"但人為何等在船上？","poem":1},{"lineBreak":true},{"text":"亞設人在海口靜坐，","poem":1},{"lineBreak":true},{"text":"在港口安居。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"西布倫人是拚命敢死的；","poem":1},{"lineBreak":true},{"text":"拿弗他利人在田野的高處也是如此。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"君王都來爭戰。","poem":1},{"lineBreak":true},{"text":"那時迦南諸王在米吉多水旁的他納爭戰，","poem":1},{"lineBreak":true},{"text":"卻未得擄掠銀錢。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"星宿從天上爭戰，","poem":1},{"lineBreak":true},{"text":"從其軌道攻擊西西拉。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"基順古河把敵人沖沒；","poem":1},{"lineBreak":true},{"text":"我的靈啊，應當努力前行。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"那時壯馬馳驅，","poem":1},{"lineBreak":true},{"text":"踢跳，奔騰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"耶和華的使者說：","poem":1},{"lineBreak":true},{"text":"應當咒詛米羅斯，","poem":1},{"lineBreak":true},{"text":"大大咒詛其中的居民；","poem":1},{"lineBreak":true},{"text":"因為他們不來幫助耶和華，","poem":1},{"lineBreak":true},{"text":"不來幫助耶和華攻擊勇士。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"願基尼人希百的妻雅億比眾婦人多得福氣，","poem":1},{"lineBreak":true},{"text":"比住帳棚的婦人更蒙福祉。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"西西拉求水，","poem":1},{"lineBreak":true},{"text":"雅億給他奶子，","poem":1},{"lineBreak":true},{"text":"用寶貴的盤子給他奶油。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"雅億左手拿着帳棚的橛子，","poem":1},{"lineBreak":true},{"text":"右手拿着匠人的錘子，","poem":1},{"lineBreak":true},{"text":"擊打西西拉，","poem":1},{"lineBreak":true},{"text":"打傷他的頭，","poem":1},{"lineBreak":true},{"text":"把他的鬢角打破穿通。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"西西拉在她腳前曲身仆倒，","poem":1},{"lineBreak":true},{"text":"在她腳前曲身倒臥；","poem":1},{"lineBreak":true},{"text":"在那裏曲身，就在那裏死亡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"西西拉的母親從窗戶裏往外觀看，","poem":1},{"lineBreak":true},{"text":"從窗櫺中呼叫說：","poem":1},{"lineBreak":true},{"text":"他的戰車為何耽延不來呢？","poem":1},{"lineBreak":true},{"text":"他的車輪為何行得慢呢？","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"聰明的宮女安慰她","poem":1},{"noteId":3},{"text":"，","poem":1},{"lineBreak":true},{"text":"她也自言自語地說：","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他們莫非得財而分？","poem":1},{"lineBreak":true},{"text":"每人得了一兩個女子？","poem":1},{"lineBreak":true},{"text":"西西拉得了彩衣為擄物，","poem":1},{"lineBreak":true},{"text":"得繡花的彩衣為掠物。","poem":1},{"lineBreak":true},{"text":"這彩衣兩面繡花，","poem":1},{"lineBreak":true},{"text":"乃是披在被擄之人頸項上的。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"願你的仇敵都這樣滅亡！","poem":1},{"lineBreak":true},{"text":"願愛你的人如日頭出現，光輝烈烈！","poem":1},{"lineBreak":true},{"text":"這樣，國中太平四十年。","poem":1}]}],"footnotes":[{"noteId":3,"caller":"-","text":"原文是回答她","reference":{"chapter":5,"verse":29}}]},"thisChapterLink":"/api/cmn_cuv/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}