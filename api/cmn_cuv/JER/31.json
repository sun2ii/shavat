{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JER","translationId":"cmn_cuv","name":"耶利米書","commonName":"耶利米書","title":"耶利米書","order":24,"numberOfChapters":52,"sha256":"863aa7b1543849e3cfd2c559a4715af74ecbeb9dde4c86853162816b04e9f732","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cmn_cuv/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":31,"content":[{"type":"heading","content":["以色列人還鄉"]},{"type":"verse","number":1,"content":["耶和華說：「那時，我必作以色列各家的上帝；他們必作我的子民。」"]},{"type":"verse","number":2,"content":["耶和華如此說：",{"text":"脫離刀劍的就是以色列人。","poem":1},{"lineBreak":true},{"text":"我使他享安息的時候，","poem":1},{"lineBreak":true},{"text":"他曾在曠野蒙恩。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"古時","poem":1},{"noteId":33},{"text":"耶和華向以色列","poem":1},{"noteId":34},{"text":"顯現，說：","poem":1},{"lineBreak":true},{"text":"我以永遠的愛愛你，","poem":1},{"lineBreak":true},{"text":"因此我以慈愛吸引你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"以色列的民","poem":1},{"noteId":35},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"我要再建立你，你就被建立；","poem":1},{"lineBreak":true},{"text":"你必再以擊鼓為美，","poem":1},{"lineBreak":true},{"text":"與歡樂的人一同跳舞而出；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"又必在撒馬利亞的山上栽種葡萄園，","poem":1},{"lineBreak":true},{"text":"栽種的人要享用所結的果子。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"日子必到，以法蓮山上守望的人必呼叫說：","poem":1},{"lineBreak":true},{"text":"起來吧！我們可以上錫安，","poem":1},{"lineBreak":true},{"text":"到耶和華－我們的上帝那裏去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"你們當為雅各歡樂歌唱，","poem":1},{"lineBreak":true},{"text":"因萬國中為首的歡呼。","poem":1},{"lineBreak":true},{"text":"當傳揚頌讚說：","poem":1},{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你拯救你的百姓以色列所剩下的人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我必將他們從北方領來，","poem":1},{"lineBreak":true},{"text":"從地極招聚；","poem":1},{"lineBreak":true},{"text":"同着他們來的有瞎子、瘸子、孕婦、產婦；","poem":1},{"lineBreak":true},{"text":"他們必成為大幫回到這裏來。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們要哭泣而來。","poem":1},{"lineBreak":true},{"text":"我要照他們懇求的引導他們，","poem":1},{"lineBreak":true},{"text":"使他們在河水旁走正直的路，","poem":1},{"lineBreak":true},{"text":"在其上不致絆跌；","poem":1},{"lineBreak":true},{"text":"因為我是以色列的父，","poem":1},{"lineBreak":true},{"text":"以法蓮是我的長子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"列國啊，要聽耶和華的話，","poem":1},{"lineBreak":true},{"text":"傳揚在遠處的海島說：","poem":1},{"lineBreak":true},{"text":"趕散以色列的必招聚他，","poem":1},{"lineBreak":true},{"text":"又看守他，好像牧人看守羊群。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因耶和華救贖了雅各，","poem":1},{"lineBreak":true},{"text":"救贖他脫離比他更強之人的手。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們要來到錫安的高處歌唱，","poem":1},{"lineBreak":true},{"text":"又流歸耶和華施恩之地，","poem":1},{"lineBreak":true},{"text":"就是有五穀、新酒，和油，","poem":1},{"lineBreak":true},{"text":"並羊羔、牛犢之地。","poem":1},{"lineBreak":true},{"text":"他們的心必像澆灌的園子；","poem":1},{"lineBreak":true},{"text":"他們也不再有一點愁煩。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"那時，處女必歡樂跳舞；","poem":1},{"lineBreak":true},{"text":"年少的、年老的，也必一同歡樂；","poem":1},{"lineBreak":true},{"text":"因為我要使他們的悲哀變為歡喜，","poem":1},{"lineBreak":true},{"text":"並要安慰他們，使他們的愁煩轉為快樂。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我必以肥油使祭司的心滿足；","poem":1},{"lineBreak":true},{"text":"我的百姓也要因我的恩惠知足。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"heading","content":["耶和華憐憫以色列"]},{"type":"verse","number":15,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"在拉瑪聽見號咷痛哭的聲音，","poem":1},{"lineBreak":true},{"text":"是拉結哭她兒女，不肯受安慰，","poem":1},{"lineBreak":true},{"text":"因為他們都不在了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"你禁止聲音不要哀哭，","poem":1},{"lineBreak":true},{"text":"禁止眼目不要流淚，","poem":1},{"lineBreak":true},{"text":"因你所做之工必有賞賜；","poem":1},{"lineBreak":true},{"text":"他們必從敵國歸回。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和華說：你末後必有指望；","poem":1},{"lineBreak":true},{"text":"你的兒女必回到自己的境界。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我聽見以法蓮為自己悲歎說：","poem":1},{"lineBreak":true},{"text":"你責罰我，我便受責罰，","poem":1},{"lineBreak":true},{"text":"像不慣負軛的牛犢一樣。","poem":1},{"lineBreak":true},{"text":"求你使我回轉，我便回轉，","poem":1},{"lineBreak":true},{"text":"因為你是耶和華－我的上帝。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我回轉以後就真正懊悔；","poem":1},{"lineBreak":true},{"text":"受教以後就拍腿歎息；","poem":1},{"lineBreak":true},{"text":"我因擔當幼年的凌辱就抱愧蒙羞。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和華說：以法蓮是我的愛子嗎？","poem":1},{"lineBreak":true},{"text":"是可喜悅的孩子嗎？","poem":1},{"lineBreak":true},{"text":"我每逢責備他，仍深顧念他；","poem":1},{"lineBreak":true},{"text":"所以我的心腸戀慕他；","poem":1},{"lineBreak":true},{"text":"我必要憐憫他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"以色列民","poem":1},{"noteId":36},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"你當為自己設立指路碑，","poem":1},{"lineBreak":true},{"text":"豎起引路柱。","poem":1},{"lineBreak":true},{"text":"你要留心向大路，","poem":1},{"lineBreak":true},{"text":"就是你所去的原路；","poem":1},{"lineBreak":true},{"text":"你當回轉，回轉到你這些城邑。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"背道的民","poem":1},{"noteId":37},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"你反來覆去要到幾時呢？","poem":1},{"lineBreak":true},{"text":"耶和華在地上造了一件新事，","poem":1},{"lineBreak":true},{"text":"就是女子護衛男子。","poem":1}]},{"type":"heading","content":["上帝子民的光明前途"]},{"type":"verse","number":23,"content":["萬軍之耶和華－以色列的上帝如此說：「我使被擄之人歸回的時候，他們在猶大地和其中的城邑必再這樣說：",{"text":"公義的居所啊，","poem":1},{"lineBreak":true},{"text":"聖山哪，願耶和華賜福給你。","poem":1}]},{"type":"verse","number":24,"content":["猶大和屬猶大城邑的人，農夫和放羊的人，要一同住在其中。"]},{"type":"verse","number":25,"content":["疲乏的人，我使他飽飫；愁煩的人，我使他知足。」"]},{"type":"verse","number":26,"content":["先知說：「我醒了，覺着睡得香甜！」"]},{"type":"verse","number":27,"content":["耶和華說：「日子將到，我要把人的種和牲畜的種播種在以色列家和猶大家。"]},{"type":"verse","number":28,"content":["我先前怎樣留意將他們拔出、拆毀、毀壞、傾覆、苦害，也必照樣留意將他們建立、栽植。這是耶和華說的。"]},{"type":"verse","number":29,"content":["當那些日子，人不再說：",{"text":"父親吃了酸葡萄，","poem":1},{"lineBreak":true},{"text":"兒子的牙酸倒了。","poem":1}]},{"type":"verse","number":30,"content":["但各人必因自己的罪死亡；凡吃酸葡萄的，自己的牙必酸倒。」"]},{"type":"verse","number":31,"content":["耶和華說：「日子將到，我要與以色列家和猶大家另立新約，"]},{"type":"verse","number":32,"content":["不像我拉着他們祖宗的手，領他們出埃及地的時候，與他們所立的約。我雖作他們的丈夫，他們卻背了我的約。這是耶和華說的。」"]},{"type":"verse","number":33,"content":["耶和華說：「那些日子以後，我與以色列家所立的約乃是這樣：我要將我的律法放在他們裏面，寫在他們心上。我要作他們的上帝，他們要作我的子民。"]},{"type":"verse","number":34,"content":["他們各人不再教導自己的鄰舍和自己的弟兄說：『你該認識耶和華』，因為他們從最小的到至大的都必認識我。我要赦免他們的罪孽，不再記念他們的罪惡。這是耶和華說的。」"]},{"type":"verse","number":35,"content":[{"text":"那使太陽白日發光，","poem":1},{"lineBreak":true},{"text":"使星月有定例，黑夜發亮，","poem":1},{"lineBreak":true},{"text":"又攪動大海，使海中波浪匉訇的，","poem":1},{"lineBreak":true},{"text":"萬軍之耶和華是他的名。","poem":1},{"lineBreak":true},{"text":"他如此說：","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"這些定例若能在我面前廢掉，","poem":1},{"lineBreak":true},{"text":"以色列的後裔也就在我面前斷絕，","poem":1},{"lineBreak":true},{"text":"永遠不再成國。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":["耶和華如此說：",{"text":"若能量度上天，","poem":1},{"lineBreak":true},{"text":"尋察下地的根基，","poem":1},{"lineBreak":true},{"text":"我就因以色列後裔一切所行的棄絕他們。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"verse","number":38,"content":["耶和華說：「日子將到，這城必為耶和華建造，從哈楠業樓直到角門。"]},{"type":"verse","number":39,"content":["準繩要往外量出，直到迦立山，又轉到歌亞。"]},{"type":"verse","number":40,"content":["拋屍的全谷和倒灰之處，並一切田地，直到汲淪溪，又直到東方馬門的拐角，都要歸耶和華為聖，不再拔出，不再傾覆，直到永遠。」"]}],"footnotes":[{"noteId":33,"caller":"-","text":"或譯：從遠方","reference":{"chapter":31,"verse":3}},{"noteId":34,"caller":"-","text":"原文是我","reference":{"chapter":31,"verse":3}},{"noteId":35,"caller":"-","text":"原文是處女","reference":{"chapter":31,"verse":4}},{"noteId":36,"caller":"-","text":"原文是處女","reference":{"chapter":31,"verse":21}},{"noteId":37,"caller":"-","text":"原文是女子","reference":{"chapter":31,"verse":22}}]},"thisChapterLink":"/api/cmn_cuv/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}