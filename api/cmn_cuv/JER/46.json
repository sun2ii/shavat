{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JER","translationId":"cmn_cuv","name":"耶利米書","commonName":"耶利米書","title":"耶利米書","order":24,"numberOfChapters":52,"sha256":"863aa7b1543849e3cfd2c559a4715af74ecbeb9dde4c86853162816b04e9f732","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cmn_cuv/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":46,"content":[{"type":"heading","content":["埃及在迦基米施受挫"]},{"type":"verse","number":1,"content":["耶和華論列國的話臨到先知耶利米。"]},{"type":"verse","number":2,"content":["論到關乎埃及王法老尼哥的軍隊：這軍隊安營在幼發拉底河邊的迦基米施，是巴比倫王尼布甲尼撒在猶大王約西亞的兒子約雅敬第四年所打敗的。"]},{"type":"verse","number":3,"content":[{"text":"你們要預備大小盾牌，","poem":1},{"lineBreak":true},{"text":"往前上陣。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你們套上車，","poem":1},{"lineBreak":true},{"text":"騎上馬！","poem":1},{"lineBreak":true},{"text":"頂盔站立，","poem":1},{"lineBreak":true},{"text":"磨槍貫甲！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我為何看見他們驚惶轉身退後呢？","poem":1},{"lineBreak":true},{"text":"他們的勇士打敗了，","poem":1},{"lineBreak":true},{"text":"急忙逃跑，並不回頭；","poem":1},{"lineBreak":true},{"text":"驚嚇四圍都有！","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"不要容快跑的逃避；","poem":1},{"lineBreak":true},{"text":"不要容勇士逃脫","poem":1},{"noteId":46},{"text":"；","poem":1},{"lineBreak":true},{"text":"他們在北方幼發拉底河邊絆跌仆倒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"像尼羅河漲發，","poem":1},{"lineBreak":true},{"text":"像江河之水翻騰的是誰呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"埃及像尼羅河漲發，","poem":1},{"lineBreak":true},{"text":"像江河的水翻騰。","poem":1},{"lineBreak":true},{"text":"他說：我要漲發遮蓋遍地；","poem":1},{"lineBreak":true},{"text":"我要毀滅城邑和其中的居民。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"馬匹上去吧！","poem":1},{"lineBreak":true},{"text":"車輛急行吧！","poem":1},{"lineBreak":true},{"text":"勇士，就是手拿盾牌的古實人和弗人","poem":1},{"noteId":47},{"text":"，","poem":1},{"lineBreak":true},{"text":"並拉弓的路德族，都出去吧！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"那日是主－萬軍之耶和華報仇的日子，","poem":1},{"lineBreak":true},{"text":"要向敵人報仇。","poem":1},{"lineBreak":true},{"text":"刀劍必吞吃得飽，","poem":1},{"lineBreak":true},{"text":"飲血飲足；","poem":1},{"lineBreak":true},{"text":"因為主－萬軍之耶和華","poem":1},{"lineBreak":true},{"text":"在北方幼發拉底河邊有獻祭的事。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"埃及的民","poem":1},{"noteId":48},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"可以上基列取乳香去；","poem":1},{"lineBreak":true},{"text":"你雖多服良藥，","poem":1},{"lineBreak":true},{"text":"總是徒然，不得治好。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"列國聽見你的羞辱，","poem":1},{"lineBreak":true},{"text":"遍地滿了你的哀聲；","poem":1},{"lineBreak":true},{"text":"勇士與勇士彼此相碰，","poem":1},{"lineBreak":true},{"text":"一齊跌倒。","poem":1}]},{"type":"heading","content":["尼布甲尼撒來犯"]},{"type":"verse","number":13,"content":["耶和華對先知耶利米所說的話，論到巴比倫王尼布甲尼撒要來攻擊埃及地："]},{"type":"verse","number":14,"content":[{"text":"你們要傳揚在埃及，宣告在密奪，","poem":1},{"lineBreak":true},{"text":"報告在挪弗、答比匿說：","poem":1},{"lineBreak":true},{"text":"要站起出隊，自作準備，","poem":1},{"lineBreak":true},{"text":"因為刀劍在你四圍施行吞滅的事。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你的壯士為何被沖去呢？","poem":1},{"lineBreak":true},{"text":"他們站立不住；","poem":1},{"lineBreak":true},{"text":"因為耶和華驅逐他們，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"使多人絆跌；","poem":1},{"lineBreak":true},{"text":"他們也彼此撞倒，說：","poem":1},{"lineBreak":true},{"text":"起來吧！我們再往本民本地去，","poem":1},{"lineBreak":true},{"text":"好躲避欺壓的刀劍。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他們在那裏喊叫說：","poem":1},{"lineBreak":true},{"text":"埃及王法老不過是個聲音","poem":1},{"noteId":49},{"text":"；","poem":1},{"lineBreak":true},{"text":"他已錯過所定的時候了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"君王－名為萬軍之耶和華的說：","poem":1},{"lineBreak":true},{"text":"我指着我的永生起誓：","poem":1},{"lineBreak":true},{"text":"尼布甲尼撒","poem":1},{"noteId":50},{"text":"來的勢派","poem":1},{"lineBreak":true},{"text":"必像他泊在眾山之中，","poem":1},{"lineBreak":true},{"text":"像迦密在海邊一樣。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"住在埃及的民","poem":1},{"noteId":51},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"要預備擄去時所用的物件；","poem":1},{"lineBreak":true},{"text":"因為挪弗必成為荒場，","poem":1},{"lineBreak":true},{"text":"且被燒毀，無人居住。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"埃及是肥美的母牛犢；","poem":1},{"lineBreak":true},{"text":"但出於北方的毀滅","poem":1},{"noteId":52},{"text":"來到了！來到了！","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"其中的雇勇好像圈裏的肥牛犢，","poem":1},{"lineBreak":true},{"text":"他們轉身退後，","poem":1},{"lineBreak":true},{"text":"一齊逃跑，站立不住；","poem":1},{"lineBreak":true},{"text":"因為他們遭難的日子、","poem":1},{"lineBreak":true},{"text":"追討的時候已經臨到。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"其中的聲音好像蛇行一樣。","poem":1},{"lineBreak":true},{"text":"敵人要成隊而來，如砍伐樹木的手拿斧子攻擊他。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"耶和華說：","poem":1},{"lineBreak":true},{"text":"埃及的樹林雖然不能尋察","poem":1},{"noteId":53},{"text":"，","poem":1},{"lineBreak":true},{"text":"敵人卻要砍伐，","poem":1},{"lineBreak":true},{"text":"因他們多於蝗蟲，不可勝數。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"埃及的民","poem":1},{"noteId":54},{"text":"必然蒙羞，","poem":1},{"lineBreak":true},{"text":"必交在北方人的手中。","poem":1}]},{"type":"verse","number":25,"content":["萬軍之耶和華－以色列的上帝說：「我必刑罰挪的亞捫",{"noteId":55},"和法老，並埃及與埃及的神，以及君王，也必刑罰法老和倚靠他的人。"]},{"type":"verse","number":26,"content":["我要將他們交付尋索其命之人的手和巴比倫王尼布甲尼撒與他臣僕的手；以後埃及必再有人居住，與從前一樣。這是耶和華說的。」"]},{"type":"heading","content":["耶和華要救他的子民"]},{"type":"verse","number":27,"content":[{"text":"我的僕人雅各啊，不要懼怕！","poem":1},{"lineBreak":true},{"text":"以色列啊，不要驚惶！","poem":1},{"lineBreak":true},{"text":"因我要從遠方拯救你，","poem":1},{"lineBreak":true},{"text":"從被擄到之地拯救你的後裔。","poem":1},{"lineBreak":true},{"text":"雅各必回來，得享平靖安逸，","poem":1},{"lineBreak":true},{"text":"無人使他害怕。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我的僕人雅各啊，不要懼怕！","poem":1},{"lineBreak":true},{"text":"因我與你同在。","poem":1},{"lineBreak":true},{"text":"我要將我所趕你到的那些國滅絕淨盡，","poem":1},{"lineBreak":true},{"text":"卻不將你滅絕淨盡，","poem":1},{"lineBreak":true},{"text":"倒要從寬懲治你，","poem":1},{"lineBreak":true},{"text":"萬不能不罰你","poem":1},{"noteId":56},{"text":"。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]}],"footnotes":[{"noteId":46,"caller":"-","text":"或譯：快跑的不能逃避；勇士不能逃脫","reference":{"chapter":46,"verse":6}},{"noteId":47,"caller":"-","text":"又作利比亞人","reference":{"chapter":46,"verse":9}},{"noteId":48,"caller":"-","text":"原文是處女","reference":{"chapter":46,"verse":11}},{"noteId":49,"caller":"-","text":"或譯：已經敗亡","reference":{"chapter":46,"verse":17}},{"noteId":50,"caller":"-","text":"原文是他","reference":{"chapter":46,"verse":18}},{"noteId":51,"caller":"-","text":"原文是女子","reference":{"chapter":46,"verse":19}},{"noteId":52,"caller":"-","text":"或譯：牛詴","reference":{"chapter":46,"verse":20}},{"noteId":53,"caller":"-","text":"或譯：穿不過","reference":{"chapter":46,"verse":23}},{"noteId":54,"caller":"-","text":"原文是女子","reference":{"chapter":46,"verse":24}},{"noteId":55,"caller":"-","text":"埃及尊大之神","reference":{"chapter":46,"verse":25}},{"noteId":56,"caller":"-","text":"不罰你：或譯以你為無罪","reference":{"chapter":46,"verse":28}}]},"thisChapterLink":"/api/cmn_cuv/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}