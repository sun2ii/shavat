{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JER","translationId":"cmn_cuv","name":"耶利米書","commonName":"耶利米書","title":"耶利米書","order":24,"numberOfChapters":52,"sha256":"863aa7b1543849e3cfd2c559a4715af74ecbeb9dde4c86853162816b04e9f732","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cmn_cuv/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":47,"content":[{"type":"heading","content":["有關非利士的話"]},{"type":"verse","number":1,"content":["法老攻擊迦薩之先，有耶和華論非利士人的話臨到先知耶利米。"]},{"type":"verse","number":2,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"有水從北方發起，成為漲溢的河，","poem":1},{"lineBreak":true},{"text":"要漲過遍地和其中所有的，","poem":1},{"lineBreak":true},{"text":"並城和其中所住的。","poem":1},{"lineBreak":true},{"text":"人必呼喊；","poem":1},{"lineBreak":true},{"text":"境內的居民都必哀號。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"聽見敵人壯馬蹄跳的響聲","poem":1},{"lineBreak":true},{"text":"和戰車隆隆、車輪轟轟；","poem":1},{"lineBreak":true},{"text":"為父的手就發軟，","poem":1},{"lineBreak":true},{"text":"不回頭看顧兒女。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因為日子將到，","poem":1},{"lineBreak":true},{"text":"要毀滅一切非利士人，","poem":1},{"lineBreak":true},{"text":"剪除幫助泰爾、西頓所剩下的人。","poem":1},{"lineBreak":true},{"text":"原來耶和華必毀滅非利士人，","poem":1},{"lineBreak":true},{"text":"就是迦斐託海島餘剩的人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"迦薩成了光禿；","poem":1},{"lineBreak":true},{"text":"平原中所剩的亞實基倫歸於無有。","poem":1},{"lineBreak":true},{"text":"你用刀劃身，要到幾時呢？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華的刀劍哪，你到幾時才止息呢？","poem":1},{"lineBreak":true},{"text":"你要入鞘，安靖不動。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華既吩咐你攻擊亞實基倫和海邊之地，","poem":1},{"lineBreak":true},{"text":"他已經派定你，焉能止息呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}