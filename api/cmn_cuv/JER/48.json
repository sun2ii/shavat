{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JER","translationId":"cmn_cuv","name":"耶利米書","commonName":"耶利米書","title":"耶利米書","order":24,"numberOfChapters":52,"sha256":"863aa7b1543849e3cfd2c559a4715af74ecbeb9dde4c86853162816b04e9f732","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cmn_cuv/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":48,"content":[{"type":"heading","content":["摩押的毀滅"]},{"type":"verse","number":1,"content":["論摩押。萬軍之耶和華－以色列的上帝如此說：",{"text":"尼波有禍了！因變為荒場。","poem":1},{"lineBreak":true},{"text":"基列亭蒙羞被攻取；","poem":1},{"lineBreak":true},{"text":"米斯迦蒙羞被毀壞；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"摩押不再被稱讚。","poem":1},{"lineBreak":true},{"text":"有人在希實本設計謀害她，說：","poem":1},{"lineBreak":true},{"text":"來吧！我們將她剪除，不再成國。","poem":1},{"lineBreak":true},{"text":"瑪得緬哪，你也必默默無聲；","poem":1},{"lineBreak":true},{"text":"刀劍必追趕你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"從何羅念有喊荒涼大毀滅的哀聲：","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"摩押毀滅了！","poem":1},{"lineBreak":true},{"text":"她的孩童","poem":1},{"noteId":57},{"text":"發哀聲，使人聽見。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"人上魯希坡隨走隨哭，","poem":1},{"lineBreak":true},{"text":"因為在何羅念的下坡聽見毀滅的哀聲。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你們要奔逃，自救性命，","poem":1},{"lineBreak":true},{"text":"獨自居住，好像曠野的杜松。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你因倚靠自己所做的和自己的財寶必被攻取。","poem":1},{"lineBreak":true},{"text":"基抹和屬他的祭司、首領也要一同被擄去。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"行毀滅的必來到各城，","poem":1},{"lineBreak":true},{"text":"並無一城得免。","poem":1},{"lineBreak":true},{"text":"山谷必致敗落，","poem":1},{"lineBreak":true},{"text":"平原必被毀壞；","poem":1},{"lineBreak":true},{"text":"正如耶和華所說的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"要將翅膀給摩押，","poem":1},{"lineBreak":true},{"text":"使她可以飛去。","poem":1},{"lineBreak":true},{"text":"她的城邑必致荒涼，","poem":1},{"lineBreak":true},{"text":"無人居住。","poem":1},"（"]},{"type":"verse","number":10,"content":["懶惰為耶和華行事的，必受咒詛；禁止刀劍不經血的，必受咒詛。）"]},{"type":"heading","content":["摩押的城鎮被毀滅"]},{"type":"verse","number":11,"content":[{"text":"摩押自幼年以來常享安逸，","poem":1},{"lineBreak":true},{"text":"如酒在渣滓上澄清，","poem":1},{"lineBreak":true},{"text":"沒有從這器皿倒在那器皿裏，","poem":1},{"lineBreak":true},{"text":"也未曾被擄去。","poem":1},{"lineBreak":true},{"text":"因此，它的原味尚存，","poem":1},{"lineBreak":true},{"text":"香氣未變。","poem":1}]},{"type":"verse","number":12,"content":["耶和華說：「日子將到，我必打發倒酒的往她那裏去，將她倒出來，倒空她的器皿，打碎她的罈子。"]},{"type":"verse","number":13,"content":["摩押必因基抹羞愧，像以色列家從前倚靠伯特利的神羞愧一樣。"]},{"type":"verse","number":14,"content":[{"text":"你們怎麼說：","poem":1},{"lineBreak":true},{"text":"我們是勇士，是有勇力打仗的呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"摩押變為荒場，","poem":1},{"lineBreak":true},{"text":"敵人上去進了她的城邑。","poem":1},{"lineBreak":true},{"text":"她所特選的少年人下去遭了殺戮；","poem":1},{"lineBreak":true},{"text":"這是君王－名為萬軍之耶和華說的。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"摩押的災殃臨近；","poem":1},{"lineBreak":true},{"text":"她的苦難速速來到。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"凡在她四圍的和認識她名的，","poem":1},{"lineBreak":true},{"text":"你們都要為她悲傷，說：","poem":1},{"lineBreak":true},{"text":"那結實的杖和那美好的棍，","poem":1},{"lineBreak":true},{"text":"何竟折斷了呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"住在底本的民","poem":1},{"noteId":58},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"要從你榮耀的位上下來，","poem":1},{"lineBreak":true},{"text":"坐受乾渴；","poem":1},{"lineBreak":true},{"text":"因毀滅摩押的上來攻擊你，","poem":1},{"lineBreak":true},{"text":"毀壞了你的保障。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"住亞羅珥的啊，","poem":1},{"lineBreak":true},{"text":"要站在道旁觀望，","poem":1},{"lineBreak":true},{"text":"問逃避的男人和逃脫的女人說：","poem":1},{"lineBreak":true},{"text":"是甚麼事呢？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"摩押因毀壞蒙羞；","poem":1},{"lineBreak":true},{"text":"你們要哀號呼喊，","poem":1},{"lineBreak":true},{"text":"要在亞嫩旁報告說：","poem":1},{"lineBreak":true},{"text":"摩押變為荒場！","poem":1}]},{"type":"verse","number":21,"content":["「刑罰臨到平原之地的何倫、雅雜、米法押、"]},{"type":"verse","number":22,"content":["底本、尼波、伯‧低比拉太音、"]},{"type":"verse","number":23,"content":["基列亭、伯‧迦末、伯‧米恩、"]},{"type":"verse","number":24,"content":["加略、波斯拉，和摩押地遠近所有的城邑。"]},{"type":"verse","number":25,"content":["摩押的角砍斷了，摩押的膀臂折斷了。這是耶和華說的。」"]},{"type":"heading","content":["摩押要受凌辱"]},{"type":"verse","number":26,"content":["「你們要使摩押沉醉，因她向耶和華誇大。她要在自己所吐之中打滾，又要被人嗤笑。"]},{"type":"verse","number":27,"content":["摩押啊，你不曾嗤笑以色列嗎？她豈是在賊中查出來的呢？你每逢提到她便搖頭。"]},{"type":"verse","number":28,"content":[{"text":"摩押的居民哪，","poem":1},{"lineBreak":true},{"text":"要離開城邑，住在山崖裏，","poem":1},{"lineBreak":true},{"text":"像鴿子在深淵口上搭窩。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我們聽說摩押人驕傲，","poem":1},{"lineBreak":true},{"text":"是極其驕傲；","poem":1},{"lineBreak":true},{"text":"聽說他自高自傲，","poem":1},{"lineBreak":true},{"text":"並且狂妄，居心自大。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"耶和華說：","poem":1},{"lineBreak":true},{"text":"我知道他的忿怒是虛空的；","poem":1},{"lineBreak":true},{"text":"他誇大的話一無所成。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"因此，我要為摩押哀號，","poem":1},{"lineBreak":true},{"text":"為摩押全地呼喊；","poem":1},{"lineBreak":true},{"text":"人必為吉珥‧哈列設人歎息。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"西比瑪的葡萄樹啊，我為你哀哭，","poem":1},{"lineBreak":true},{"text":"甚於雅謝人哀哭。","poem":1},{"lineBreak":true},{"text":"你的枝子蔓延過海，","poem":1},{"lineBreak":true},{"text":"直長到雅謝海。","poem":1},{"lineBreak":true},{"text":"那行毀滅的已經臨到你夏天的果子","poem":1},{"lineBreak":true},{"text":"和你所摘的葡萄。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"肥田和摩押地的歡喜快樂都被奪去；","poem":1},{"lineBreak":true},{"text":"我使酒醡的酒絕流，","poem":1},{"lineBreak":true},{"text":"無人踹酒歡呼；","poem":1},{"lineBreak":true},{"text":"那歡呼卻變為仇敵的吶喊","poem":1},{"noteId":59},{"text":"。","poem":1}]},{"type":"verse","number":34,"content":["「希實本人發的哀聲達到以利亞利，直達到雅雜；從瑣珥達到何羅念，直到伊基拉‧施利施亞，因為寧林的水必然乾涸。」"]},{"type":"verse","number":35,"content":["耶和華說：「我必在摩押地使那在邱壇獻祭的，和那向他的神燒香的都斷絕了。"]},{"type":"verse","number":36,"content":["我心腹為摩押哀鳴如簫，我心腸為吉珥‧哈列設人也是如此，因摩押人所得的財物都滅沒了。"]},{"type":"verse","number":37,"content":["「各人頭上光禿，鬍鬚剪短，手有劃傷，腰束麻布。"]},{"type":"verse","number":38,"content":["在摩押的各房頂上和街市上處處有人哀哭；因我打碎摩押，好像打碎無人喜悅的器皿。這是耶和華說的。"]},{"type":"verse","number":39,"content":["摩押何等毀壞！何等哀號！何等羞愧轉背！這樣，摩押必令四圍的人嗤笑驚駭。」"]},{"type":"heading","content":["摩押無路可逃"]},{"type":"verse","number":40,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"仇敵必如大鷹飛起，","poem":1},{"lineBreak":true},{"text":"展開翅膀，攻擊摩押。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"加略被攻取，保障也被佔據。","poem":1},{"lineBreak":true},{"text":"到那日，摩押的勇士心中疼痛如臨產的婦人。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"摩押必被毀滅，不再成國，","poem":1},{"lineBreak":true},{"text":"因她向耶和華誇大。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"耶和華說：摩押的居民哪，","poem":1},{"lineBreak":true},{"text":"恐懼、陷坑、網羅都臨近你。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"躲避恐懼的必墜入陷坑；","poem":1},{"lineBreak":true},{"text":"從陷坑上來的必被網羅纏住；","poem":1},{"lineBreak":true},{"text":"因我必使追討之年臨到摩押。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"躲避的人無力站在希實本的影下；","poem":1},{"lineBreak":true},{"text":"因為有火從希實本發出，","poem":1},{"lineBreak":true},{"text":"有火焰出於西宏的城，","poem":1},{"lineBreak":true},{"text":"燒盡摩押的角和鬨嚷人的頭頂。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"摩押啊，你有禍了！","poem":1},{"lineBreak":true},{"text":"屬基抹的民滅亡了！","poem":1},{"lineBreak":true},{"text":"因你的眾子都被擄去，","poem":1},{"lineBreak":true},{"text":"你的眾女也被擄去。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"耶和華說：","poem":1},{"lineBreak":true},{"text":"到末後，我還要使被擄的摩押人歸回。","poem":1},{"lineBreak":true},{"text":"摩押受審判的話到此為止。","poem":1}]}],"footnotes":[{"noteId":57,"caller":"-","text":"或譯：家僮","reference":{"chapter":48,"verse":4}},{"noteId":58,"caller":"-","text":"原文是女子","reference":{"chapter":48,"verse":18}},{"noteId":59,"caller":"-","text":"原文是那歡呼卻不是歡呼","reference":{"chapter":48,"verse":33}}]},"thisChapterLink":"/api/cmn_cuv/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}