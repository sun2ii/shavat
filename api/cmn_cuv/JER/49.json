{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JER","translationId":"cmn_cuv","name":"耶利米書","commonName":"耶利米書","title":"耶利米書","order":24,"numberOfChapters":52,"sha256":"863aa7b1543849e3cfd2c559a4715af74ecbeb9dde4c86853162816b04e9f732","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cmn_cuv/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":49,"content":[{"type":"heading","content":["耶和華審判亞捫"]},{"type":"verse","number":1,"content":["論亞捫人。耶和華如此說：",{"text":"以色列沒有兒子嗎？","poem":1},{"lineBreak":true},{"text":"沒有後嗣嗎？","poem":1},{"lineBreak":true},{"text":"瑪勒堪為何得迦得之地為業呢？","poem":1},{"lineBreak":true},{"text":"屬他的民為何住其中的城邑呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華說：","poem":1},{"lineBreak":true},{"text":"日子將到，我必使人聽見打仗的喊聲，","poem":1},{"lineBreak":true},{"text":"是攻擊亞捫人拉巴的喊聲。","poem":1},{"lineBreak":true},{"text":"拉巴要成為亂堆；","poem":1},{"lineBreak":true},{"text":"屬她的鄉村","poem":1},{"noteId":60},{"text":"要被火焚燒。","poem":1},{"lineBreak":true},{"text":"先前得以色列地為業的，","poem":1},{"lineBreak":true},{"text":"此時以色列倒要得他們的地為業。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"希實本哪，你要哀號，","poem":1},{"lineBreak":true},{"text":"因為愛地變為荒場。","poem":1},{"lineBreak":true},{"text":"拉巴的居民","poem":1},{"noteId":61},{"text":"哪，要呼喊，","poem":1},{"lineBreak":true},{"text":"以麻布束腰；","poem":1},{"lineBreak":true},{"text":"要哭號，在籬笆中跑來跑去；","poem":1},{"lineBreak":true},{"text":"因瑪勒堪和屬他的祭司、","poem":1},{"lineBreak":true},{"text":"首領要一同被擄去。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"背道的民","poem":1},{"noteId":62},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"你們為何因有山谷，","poem":1},{"lineBreak":true},{"text":"就是水流的山谷誇張呢？","poem":1},{"lineBreak":true},{"text":"為何倚靠財寶說：","poem":1},{"lineBreak":true},{"text":"誰能來到我們這裏呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"主－萬軍之耶和華說：","poem":1},{"lineBreak":true},{"text":"我要使恐嚇從四圍的人中臨到你們；","poem":1},{"lineBreak":true},{"text":"你們必被趕出，","poem":1},{"lineBreak":true},{"text":"各人一直前往，","poem":1},{"lineBreak":true},{"text":"沒有人收聚逃民。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"後來我還要使被擄的亞捫人歸回。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"heading","content":["耶和華審判以東"]},{"type":"verse","number":7,"content":["論以東。萬軍之耶和華如此說：",{"lineBreak":true},{"text":"提幔中再沒有智慧嗎？","poem":1},{"lineBreak":true},{"text":"明哲人不再有謀略嗎？","poem":1},{"lineBreak":true},{"text":"他們的智慧盡歸無有嗎？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"底但的居民哪，要轉身逃跑，","poem":1},{"lineBreak":true},{"text":"住在深密處；","poem":1},{"lineBreak":true},{"text":"因為我向以掃追討的時候，","poem":1},{"lineBreak":true},{"text":"必使災殃臨到他。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"摘葡萄的若來到他那裏，","poem":1},{"lineBreak":true},{"text":"豈不剩下些葡萄呢？","poem":1},{"lineBreak":true},{"text":"盜賊若夜間而來，","poem":1},{"lineBreak":true},{"text":"豈不毀壞直到夠了呢？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我卻使以掃赤露，","poem":1},{"lineBreak":true},{"text":"顯出他的隱密處；","poem":1},{"lineBreak":true},{"text":"他不能自藏。","poem":1},{"lineBreak":true},{"text":"他的後裔、弟兄、鄰舍盡都滅絕；","poem":1},{"lineBreak":true},{"text":"他也歸於無有。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你撇下孤兒，我必保全他們的命；","poem":1},{"lineBreak":true},{"text":"你的寡婦可以倚靠我。","poem":1}]},{"type":"verse","number":12,"content":["耶和華如此說：「原不該喝那杯的一定要喝。你能盡免刑罰嗎？你必不能免，一定要喝！」"]},{"type":"verse","number":13,"content":["耶和華說：「我指着自己起誓，波斯拉必令人驚駭、羞辱、咒詛，並且荒涼。她的一切城邑必變為永遠的荒場。」"]},{"type":"verse","number":14,"content":[{"text":"我從耶和華那裏聽見信息，","poem":1},{"lineBreak":true},{"text":"並有使者被差往列國去，說：","poem":1},{"lineBreak":true},{"text":"你們聚集來攻擊以東，","poem":1},{"lineBreak":true},{"text":"要起來爭戰。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我使你在列國中為最小，","poem":1},{"lineBreak":true},{"text":"在世人中被藐視。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"住在山穴中據守山頂的啊，","poem":1},{"lineBreak":true},{"text":"論到你的威嚇，","poem":1},{"lineBreak":true},{"text":"你因心中的狂傲自欺；","poem":1},{"lineBreak":true},{"text":"你雖如大鷹高高搭窩，","poem":1},{"lineBreak":true},{"text":"我卻從那裏拉下你來。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"verse","number":17,"content":["「以東必令人驚駭；凡經過的人就受驚駭，又因她一切的災禍嗤笑。"]},{"type":"verse","number":18,"content":["耶和華說：必無人住在那裏，也無人在其中寄居，要像所多瑪、蛾摩拉，和鄰近的城邑傾覆的時候一樣。"]},{"type":"verse","number":19,"content":["仇敵必像獅子從約旦河邊的叢林上來，攻擊堅固的居所。轉眼之間，我要使以東人逃跑，離開這地。誰蒙揀選，我就派誰治理這地。誰能比我呢？誰能給我定規日期呢？有何牧人能在我面前站立得住呢？"]},{"type":"verse","number":20,"content":["你們要聽耶和華攻擊以東所說的謀略和他攻擊提幔居民所定的旨意。仇敵定要將他們群眾微弱的拉去，定要使他們的居所荒涼。"]},{"type":"verse","number":21,"content":["因他們仆倒的聲音，地就震動。人在紅海那裏必聽見呼喊的聲音。"]},{"type":"verse","number":22,"content":["仇敵必如大鷹飛起，展開翅膀攻擊波斯拉。到那日，以東的勇士心中疼痛如臨產的婦人。」"]},{"type":"heading","content":["耶和華審判大馬士革"]},{"type":"verse","number":23,"content":[{"text":"論大馬士革。","poem":1},{"lineBreak":true},{"text":"哈馬和亞珥拔蒙羞，","poem":1},{"lineBreak":true},{"text":"因他們聽見凶惡的信息就消化了。","poem":1},{"lineBreak":true},{"text":"海上有憂愁，不得平靜。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"大馬士革發軟，轉身逃跑。","poem":1},{"lineBreak":true},{"text":"戰兢將她捉住；","poem":1},{"lineBreak":true},{"text":"痛苦憂愁將她抓住，","poem":1},{"lineBreak":true},{"text":"如產難的婦人一樣。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我所喜樂可稱讚的城，","poem":1},{"lineBreak":true},{"text":"為何被撇棄了呢？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"她的少年人必仆倒在街上；","poem":1},{"lineBreak":true},{"text":"當那日，一切兵丁必默默無聲。","poem":1},{"lineBreak":true},{"text":"這是萬軍之耶和華說的。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我必在大馬士革城中使火着起，","poem":1},{"lineBreak":true},{"text":"燒滅便‧哈達的宮殿。","poem":1}]},{"type":"heading","content":["審判基達和夏瑣城"]},{"type":"verse","number":28,"content":["論巴比倫王尼布甲尼撒所攻打的基達和夏瑣的諸國。耶和華如此說：",{"text":"迦勒底人哪，起來上基達去，","poem":1},{"lineBreak":true},{"text":"毀滅東方人。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他們的帳棚和羊群都要奪去，","poem":1},{"lineBreak":true},{"text":"將幔子和一切器皿，並駱駝為自己掠去。","poem":1},{"lineBreak":true},{"text":"人向他們喊着說：","poem":1},{"lineBreak":true},{"text":"四圍都有驚嚇。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"耶和華說：","poem":1},{"lineBreak":true},{"text":"夏瑣的居民哪，要逃奔遠方，","poem":1},{"lineBreak":true},{"text":"住在深密處；","poem":1},{"lineBreak":true},{"text":"因為巴比倫王尼布甲尼撒設計謀害你們，","poem":1},{"lineBreak":true},{"text":"起意攻擊你們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"耶和華說：","poem":1},{"lineBreak":true},{"text":"迦勒底人哪，起來！","poem":1},{"lineBreak":true},{"text":"上安逸無慮的居民那裏去；","poem":1},{"lineBreak":true},{"text":"他們是無門無閂、獨自居住的。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他們的駱駝必成為掠物；","poem":1},{"lineBreak":true},{"text":"他們眾多的牲畜必成為擄物。","poem":1},{"lineBreak":true},{"text":"我必將剃周圍頭髮的人分散四方","poem":1},{"noteId":63},{"text":"，","poem":1},{"lineBreak":true},{"text":"使災殃從四圍臨到他們。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"夏瑣必成為野狗的住處，","poem":1},{"lineBreak":true},{"text":"永遠淒涼；","poem":1},{"lineBreak":true},{"text":"必無人住在那裏，","poem":1},{"lineBreak":true},{"text":"也無人在其中寄居。","poem":1}]},{"type":"heading","content":["耶和華審判以攔"]},{"type":"verse","number":34,"content":["猶大王西底家登基的時候，耶和華論以攔的話臨到先知耶利米說："]},{"type":"verse","number":35,"content":["「萬軍之耶和華如此說：我必折斷以攔人的弓，就是他們為首的權力。"]},{"type":"verse","number":36,"content":["我要使四風從天的四方颳來，臨到以攔人，將他們分散四方",{"noteId":64},"。這被趕散的人沒有一國不到的。」"]},{"type":"verse","number":37,"content":["耶和華說：「我必使以攔人在仇敵和尋索其命的人面前驚惶；我也必使災禍，就是我的烈怒臨到他們，又必使刀劍追殺他們，直到將他們滅盡。"]},{"type":"verse","number":38,"content":["我要在以攔設立我的寶座，從那裏除滅君王和首領。這是耶和華說的。"]},{"type":"verse","number":39,"content":["「到末後，我還要使被擄的以攔人歸回。這是耶和華說的。」"]}],"footnotes":[{"noteId":60,"caller":"-","text":"原文是女子","reference":{"chapter":49,"verse":2}},{"noteId":61,"caller":"-","text":"原文是女子","reference":{"chapter":49,"verse":3}},{"noteId":62,"caller":"-","text":"原文是女子","reference":{"chapter":49,"verse":4}},{"noteId":63,"caller":"-","text":"原文是風","reference":{"chapter":49,"verse":32}},{"noteId":64,"caller":"-","text":"原文是風","reference":{"chapter":49,"verse":36}}]},"thisChapterLink":"/api/cmn_cuv/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}