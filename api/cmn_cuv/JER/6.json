{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JER","translationId":"cmn_cuv","name":"耶利米書","commonName":"耶利米書","title":"耶利米書","order":24,"numberOfChapters":52,"sha256":"863aa7b1543849e3cfd2c559a4715af74ecbeb9dde4c86853162816b04e9f732","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/cmn_cuv/JER/52.json","totalNumberOfVerses":1361},"chapter":{"number":6,"content":[{"type":"heading","content":["耶路撒冷受敵人圍攻"]},{"type":"verse","number":1,"content":[{"text":"便雅憫人哪，你們要逃出耶路撒冷，","poem":1},{"lineBreak":true},{"text":"在提哥亞吹角，","poem":1},{"lineBreak":true},{"text":"在伯‧哈基琳立號旗；","poem":1},{"lineBreak":true},{"text":"因為有災禍與大毀滅從北方張望。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"那秀美嬌嫩的錫安女子","poem":1},{"noteId":8},{"text":"，","poem":1},{"lineBreak":true},{"text":"我必剪除。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"牧人必引他們的羊群到她那裏，","poem":1},{"lineBreak":true},{"text":"在她周圍支搭帳棚，","poem":1},{"lineBreak":true},{"text":"各在自己所佔之地使羊吃草。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你們要準備攻擊她。","poem":1},{"lineBreak":true},{"text":"起來吧，我們可以趁午時上去。","poem":1},{"lineBreak":true},{"text":"哀哉！日已漸斜，","poem":1},{"lineBreak":true},{"text":"晚影拖長了。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"起來吧，我們夜間上去，","poem":1},{"lineBreak":true},{"text":"毀壞她的宮殿。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"因為萬軍之耶和華如此說：","poem":1},{"lineBreak":true},{"text":"你們要砍伐樹木，","poem":1},{"lineBreak":true},{"text":"築壘攻打耶路撒冷。","poem":1},{"lineBreak":true},{"text":"這就是那該罰的城，","poem":1},{"lineBreak":true},{"text":"其中盡是欺壓。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"井怎樣湧出水來，","poem":1},{"lineBreak":true},{"text":"這城也照樣湧出惡來；","poem":1},{"lineBreak":true},{"text":"在其間常聽見有強暴毀滅的事，","poem":1},{"lineBreak":true},{"text":"病患損傷也常在我面前。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，你當受教，","poem":1},{"lineBreak":true},{"text":"免得我心與你生疏，","poem":1},{"lineBreak":true},{"text":"免得我使你荒涼，","poem":1},{"lineBreak":true},{"text":"成為無人居住之地。","poem":1}]},{"type":"heading","content":["叛逆的以色列"]},{"type":"verse","number":9,"content":[{"text":"萬軍之耶和華曾如此說：","poem":1},{"lineBreak":true},{"text":"敵人必擄盡以色列剩下的民，","poem":1},{"lineBreak":true},{"text":"如同摘淨葡萄一樣。","poem":1},{"lineBreak":true},{"text":"你要像摘葡萄的人摘了又摘，回手放在筐子裏。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"現在我可以向誰說話作見證，使他們聽呢？","poem":1},{"lineBreak":true},{"text":"他們的耳朵未受割禮，不能聽見。","poem":1},{"lineBreak":true},{"text":"看哪，耶和華的話他們以為羞辱，","poem":1},{"lineBreak":true},{"text":"不以為喜悅。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因此我被耶和華的忿怒充滿，難以含忍。","poem":1},{"lineBreak":true},{"text":"我要傾在街中的孩童和聚會的少年人身上，","poem":1},{"lineBreak":true},{"text":"連夫帶妻，","poem":1},{"lineBreak":true},{"text":"並年老的與日子滿足的都必被擒拿。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們的房屋、田地，","poem":1},{"lineBreak":true},{"text":"和妻子都必轉歸別人；","poem":1},{"lineBreak":true},{"text":"我要伸手攻擊這地的居民。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因為他們從最小的到至大的都一味地貪婪，","poem":1},{"lineBreak":true},{"text":"從先知到祭司都行事虛謊。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們輕輕忽忽地醫治我百姓的損傷，","poem":1},{"lineBreak":true},{"text":"說：平安了！平安了！","poem":1},{"lineBreak":true},{"text":"其實沒有平安。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他們行可憎的事知道慚愧嗎？","poem":1},{"lineBreak":true},{"text":"不然，他們毫不慚愧，","poem":1},{"lineBreak":true},{"text":"也不知羞恥。","poem":1},{"lineBreak":true},{"text":"因此，他們必在仆倒的人中仆倒；","poem":1},{"lineBreak":true},{"text":"我向他們討罪的時候，","poem":1},{"lineBreak":true},{"text":"他們必致跌倒。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]},{"type":"heading","content":["以色列拒絕上帝的道路"]},{"type":"verse","number":16,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"你們當站在路上察看，","poem":1},{"lineBreak":true},{"text":"訪問古道，","poem":1},{"lineBreak":true},{"text":"哪是善道，便行在其間；","poem":1},{"lineBreak":true},{"text":"這樣，你們心裏必得安息。","poem":1},{"lineBreak":true},{"text":"他們卻說：我們不行在其間。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我設立守望的人照管你們，","poem":1},{"lineBreak":true},{"text":"說：要聽角聲。","poem":1},{"lineBreak":true},{"text":"他們卻說：我們不聽。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"列國啊，因此你們當聽！","poem":1},{"lineBreak":true},{"text":"會眾啊，要知道他們必遭遇的事。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"地啊，當聽！","poem":1},{"lineBreak":true},{"text":"我必使災禍臨到這百姓，","poem":1},{"lineBreak":true},{"text":"就是他們意念所結的果子；","poem":1},{"lineBreak":true},{"text":"因為他們不聽從我的言語，","poem":1},{"lineBreak":true},{"text":"至於我的訓誨","poem":1},{"noteId":9},{"text":"，他們也厭棄了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"從示巴出的乳香，","poem":1},{"lineBreak":true},{"text":"從遠方出的菖蒲","poem":1},{"noteId":10},{"lineBreak":true},{"text":"奉來給我有何益呢？","poem":1},{"lineBreak":true},{"text":"你們的燔祭不蒙悅納；","poem":1},{"lineBreak":true},{"text":"你們的平安祭，我也不喜悅。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"所以耶和華如此說：","poem":1},{"lineBreak":true},{"text":"我要將絆腳石放在這百姓前面。","poem":1},{"lineBreak":true},{"text":"父親和兒子要一同跌在其上；","poem":1},{"lineBreak":true},{"text":"鄰舍與朋友也都滅亡。","poem":1}]},{"type":"heading","content":["北方來的侵略者"]},{"type":"verse","number":22,"content":[{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"看哪，有一種民從北方而來，","poem":1},{"lineBreak":true},{"text":"並有一大國被激動，從地極來到。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他們拿弓和槍，","poem":1},{"lineBreak":true},{"text":"性情殘忍，不施憐憫；","poem":1},{"lineBreak":true},{"text":"他們的聲音像海浪匉訇。","poem":1},{"lineBreak":true},{"text":"錫安城","poem":1},{"noteId":11},{"text":"啊，","poem":1},{"lineBreak":true},{"text":"他們騎馬都擺隊伍，","poem":1},{"lineBreak":true},{"text":"如上戰場的人要攻擊你。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我們聽見他們的風聲，手就發軟；","poem":1},{"lineBreak":true},{"text":"痛苦將我們抓住，","poem":1},{"lineBreak":true},{"text":"疼痛彷彿產難的婦人。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你們不要往田野去，","poem":1},{"lineBreak":true},{"text":"也不要行在路上，","poem":1},{"lineBreak":true},{"text":"因四圍有仇敵的刀劍和驚嚇。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我民","poem":1},{"noteId":12},{"text":"哪，應當腰束麻布，滾在灰中。","poem":1},{"lineBreak":true},{"text":"你要悲傷，如喪獨生子痛痛哭號，","poem":1},{"lineBreak":true},{"text":"因為滅命的要忽然臨到我們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"我使你在我民中為高臺","poem":1},{"noteId":13},{"text":"，為保障，","poem":1},{"lineBreak":true},{"text":"使你知道試驗他們的行動。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他們都是極悖逆的，","poem":1},{"lineBreak":true},{"text":"往來讒謗人。","poem":1},{"lineBreak":true},{"text":"他們是銅是鐵，","poem":1},{"lineBreak":true},{"text":"都行壞事。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"風箱吹火，鉛被燒毀；","poem":1},{"lineBreak":true},{"text":"他們煉而又煉，終是徒然；","poem":1},{"lineBreak":true},{"text":"因為惡劣的還未除掉。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"人必稱他們為被棄的銀渣，","poem":1},{"lineBreak":true},{"text":"因為耶和華已經棄掉他們。","poem":1}]}],"footnotes":[{"noteId":8,"caller":"-","text":"就是指民的意思","reference":{"chapter":6,"verse":2}},{"noteId":9,"caller":"-","text":"或譯：律法","reference":{"chapter":6,"verse":19}},{"noteId":10,"caller":"-","text":"或譯：甘蔗","reference":{"chapter":6,"verse":20}},{"noteId":11,"caller":"-","text":"原文是女子","reference":{"chapter":6,"verse":23}},{"noteId":12,"caller":"-","text":"原文是民女","reference":{"chapter":6,"verse":26}},{"noteId":13,"caller":"-","text":"或譯：試驗人的","reference":{"chapter":6,"verse":27}}]},"thisChapterLink":"/api/cmn_cuv/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}