{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"我厭煩我的性命，","poem":1},{"lineBreak":true},{"text":"必由着自己述說我的哀情；","poem":1},{"lineBreak":true},{"text":"因心裏苦惱，我要說話，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"對上帝說：不要定我有罪，","poem":1},{"lineBreak":true},{"text":"要指示我，你為何與我爭辯？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你手所造的，","poem":1},{"lineBreak":true},{"text":"你又欺壓，又藐視，","poem":1},{"lineBreak":true},{"text":"卻光照惡人的計謀。","poem":1},{"lineBreak":true},{"text":"這事你以為美嗎？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的眼豈是肉眼？","poem":1},{"lineBreak":true},{"text":"你查看豈像人查看嗎？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的日子豈像人的日子，","poem":1},{"lineBreak":true},{"text":"你的年歲豈像人的年歲，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"就追問我的罪孽，","poem":1},{"lineBreak":true},{"text":"尋察我的罪過嗎？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"其實，你知道我沒有罪惡，","poem":1},{"lineBreak":true},{"text":"並沒有能救我脫離你手的。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你的手創造我，造就我的四肢百體，","poem":1},{"lineBreak":true},{"text":"你還要毀滅我。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你記念－製造我如摶泥一般，","poem":1},{"lineBreak":true},{"text":"你還要使我歸於塵土嗎？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你不是倒出我來好像奶，","poem":1},{"lineBreak":true},{"text":"使我凝結如同奶餅嗎？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你以皮和肉為衣給我穿上，","poem":1},{"lineBreak":true},{"text":"用骨與筋把我全體聯絡。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你將生命和慈愛賜給我；","poem":1},{"lineBreak":true},{"text":"你也眷顧保全我的心靈。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"然而，你待我的這些事早已藏在你心裏；","poem":1},{"lineBreak":true},{"text":"我知道你久有此意。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我若犯罪，你就察看我，","poem":1},{"lineBreak":true},{"text":"並不赦免我的罪孽。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我若行惡，便有了禍；","poem":1},{"lineBreak":true},{"text":"我若為義，也不敢抬頭，","poem":1},{"lineBreak":true},{"text":"正是滿心羞愧，","poem":1},{"lineBreak":true},{"text":"眼見我的苦情。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我若昂首自得，你就追捕我如獅子，","poem":1},{"lineBreak":true},{"text":"又在我身上顯出奇能。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你重立見證攻擊我，","poem":1},{"lineBreak":true},{"text":"向我加增惱怒，","poem":1},{"lineBreak":true},{"text":"如軍兵更換着攻擊我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"你為何使我出母胎呢？","poem":1},{"lineBreak":true},{"text":"不如我當時氣絕，無人得見我；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"這樣，就如沒有我一般，","poem":1},{"lineBreak":true},{"text":"一出母胎就被送入墳墓。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的日子不是甚少嗎？","poem":1},{"lineBreak":true},{"text":"求你停手寬容我，","poem":1},{"lineBreak":true},{"text":"叫我在往而不返之先－","poem":1},{"lineBreak":true},{"text":"就是往黑暗和死蔭之地以先－","poem":1},{"lineBreak":true},{"text":"可以稍得暢快。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"那地甚是幽暗，是死蔭混沌之地；","poem":1},{"lineBreak":true},{"text":"那裏的光好像幽暗。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}