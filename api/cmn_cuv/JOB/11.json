{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"拿瑪人瑣法回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"這許多的言語豈不該回答嗎？","poem":1},{"lineBreak":true},{"text":"多嘴多舌的人豈可稱為義嗎？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你誇大的話豈能使人不作聲嗎？","poem":1},{"lineBreak":true},{"text":"你戲笑的時候豈沒有人叫你害羞嗎？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你說：我的道理純全；","poem":1},{"lineBreak":true},{"text":"我在你眼前潔淨。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"惟願上帝說話；","poem":1},{"lineBreak":true},{"text":"願他開口攻擊你，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"並將智慧的奧祕指示你；","poem":1},{"lineBreak":true},{"text":"他有諸般的智識。","poem":1},{"lineBreak":true},{"text":"所以當知道上帝追討你","poem":1},{"lineBreak":true},{"text":"比你罪孽該得的還少。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你考察就能測透上帝嗎？","poem":1},{"lineBreak":true},{"text":"你豈能盡情測透全能者嗎？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他的智慧高於天，你還能做甚麼？","poem":1},{"lineBreak":true},{"text":"深於陰間，你還能知道甚麼？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"其量比地長，","poem":1},{"lineBreak":true},{"text":"比海寬。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他若經過，將人拘禁，","poem":1},{"lineBreak":true},{"text":"招人受審，誰能阻擋他呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他本知道虛妄的人；","poem":1},{"lineBreak":true},{"text":"人的罪孽，他雖不留意，還是無所不見。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"空虛的人卻毫無知識；","poem":1},{"lineBreak":true},{"text":"人生在世好像野驢的駒子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"你若將心安正，","poem":1},{"lineBreak":true},{"text":"又向主舉手；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你手裏若有罪孽，","poem":1},{"lineBreak":true},{"text":"就當遠遠地除掉，","poem":1},{"lineBreak":true},{"text":"也不容非義住在你帳棚之中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"那時，你必仰起臉來毫無斑點；","poem":1},{"lineBreak":true},{"text":"你也必堅固，無所懼怕。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你必忘記你的苦楚，","poem":1},{"lineBreak":true},{"text":"就是想起也如流過去的水一樣。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你在世的日子要比正午更明，","poem":1},{"lineBreak":true},{"text":"雖有黑暗仍像早晨。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你因有指望就必穩固，","poem":1},{"lineBreak":true},{"text":"也必四圍巡查，坦然安息。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你躺臥，無人驚嚇，","poem":1},{"lineBreak":true},{"text":"且有許多人向你求恩。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"但惡人的眼目必要失明。","poem":1},{"lineBreak":true},{"text":"他們無路可逃；","poem":1},{"lineBreak":true},{"text":"他們的指望就是氣絕。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}