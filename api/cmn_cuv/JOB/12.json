{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"約伯回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們真是子民哪，","poem":1},{"lineBreak":true},{"text":"你們死亡，智慧也就滅沒了。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"但我也有聰明，與你們一樣，","poem":1},{"lineBreak":true},{"text":"並非不及你們。","poem":1},{"lineBreak":true},{"text":"你們所說的，誰不知道呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我這求告上帝、蒙他應允的人","poem":1},{"lineBreak":true},{"text":"竟成了朋友所譏笑的；","poem":1},{"lineBreak":true},{"text":"公義完全人竟受了人的譏笑。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"安逸的人心裏藐視災禍；","poem":1},{"lineBreak":true},{"text":"這災禍常常等待滑腳的人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"強盜的帳棚興旺，","poem":1},{"lineBreak":true},{"text":"惹上帝的人穩固，","poem":1},{"lineBreak":true},{"text":"上帝多將財物送到他們手中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"你且問走獸，走獸必指教你；","poem":1},{"lineBreak":true},{"text":"又問空中的飛鳥，飛鳥必告訴你；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"或與地說話，地必指教你；","poem":1},{"lineBreak":true},{"text":"海中的魚也必向你說明。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"看這一切，","poem":1},{"lineBreak":true},{"text":"誰不知道是耶和華的手做成的呢？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"凡活物的生命和人類的氣息都在他手中。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耳朵豈不試驗言語，","poem":1},{"lineBreak":true},{"text":"正如上膛嘗食物嗎？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"年老的有智慧；","poem":1},{"lineBreak":true},{"text":"壽高的有知識。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"在上帝有智慧和能力；","poem":1},{"lineBreak":true},{"text":"他有謀略和知識。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他拆毀的，就不能再建造；","poem":1},{"lineBreak":true},{"text":"他捆住人，便不得開釋。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他把水留住，水便枯乾；","poem":1},{"lineBreak":true},{"text":"他再發出水來，水就翻地。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"在他有能力和智慧，","poem":1},{"lineBreak":true},{"text":"被誘惑的與誘惑人的都是屬他。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他把謀士剝衣擄去，","poem":1},{"lineBreak":true},{"text":"又使審判官變成愚人。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他放鬆君王的綁，","poem":1},{"lineBreak":true},{"text":"又用帶子捆他們的腰。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他把祭司剝衣擄去，","poem":1},{"lineBreak":true},{"text":"又使有能的人傾敗。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他廢去忠信人的講論，","poem":1},{"lineBreak":true},{"text":"又奪去老人的聰明。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他使君王蒙羞被辱，","poem":1},{"lineBreak":true},{"text":"放鬆有力之人的腰帶。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他將深奧的事從黑暗中彰顯，","poem":1},{"lineBreak":true},{"text":"使死蔭顯為光明。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他使邦國興旺而又毀滅；","poem":1},{"lineBreak":true},{"text":"他使邦國開廣而又擄去。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他將地上民中首領的聰明奪去，","poem":1},{"lineBreak":true},{"text":"使他們在荒廢無路之地漂流；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他們無光，在黑暗中摸索，","poem":1},{"lineBreak":true},{"text":"又使他們東倒西歪，像醉酒的人一樣。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}