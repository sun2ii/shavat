{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"這一切，我眼都見過；","poem":1},{"lineBreak":true},{"text":"我耳都聽過，而且明白。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們所知道的，我也知道，","poem":1},{"lineBreak":true},{"text":"並非不及你們。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我真要對全能者說話；","poem":1},{"lineBreak":true},{"text":"我願與上帝理論。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你們是編造謊言的，","poem":1},{"lineBreak":true},{"text":"都是無用的醫生。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"惟願你們全然不作聲；","poem":1},{"lineBreak":true},{"text":"這就算為你們的智慧！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"請你們聽我的辯論，","poem":1},{"lineBreak":true},{"text":"留心聽我口中的分訴。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你們要為上帝說不義的話嗎？","poem":1},{"lineBreak":true},{"text":"為他說詭詐的言語嗎？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你們要為上帝徇情嗎？","poem":1},{"lineBreak":true},{"text":"要為他爭論嗎？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他查出你們來，這豈是好嗎？","poem":1},{"lineBreak":true},{"text":"人欺哄人，你們也要照樣欺哄他嗎？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你們若暗中徇情，","poem":1},{"lineBreak":true},{"text":"他必要責備你們。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他的尊榮豈不叫你們懼怕嗎？","poem":1},{"lineBreak":true},{"text":"他的驚嚇豈不臨到你們嗎？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你們以為可記念的箴言是爐灰的箴言；","poem":1},{"lineBreak":true},{"text":"你們以為可靠的堅壘是淤泥的堅壘。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"你們不要作聲，任憑我吧！","poem":1},{"lineBreak":true},{"text":"讓我說話，無論如何我都承當。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我何必把我的肉掛在牙上，","poem":1},{"lineBreak":true},{"text":"將我的命放在手中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他必殺我；我雖無指望，","poem":1},{"lineBreak":true},{"text":"然而我在他面前還要辯明我所行的。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"這要成為我的拯救，","poem":1},{"lineBreak":true},{"text":"因為不虔誠的人不得到他面前。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你們要細聽我的言語，","poem":1},{"lineBreak":true},{"text":"使我所辯論的入你們的耳中。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我已陳明我的案，","poem":1},{"lineBreak":true},{"text":"知道自己有義。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"有誰與我爭論，","poem":1},{"lineBreak":true},{"text":"我就情願緘默不言，氣絕而亡。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"惟有兩件不要向我施行，","poem":1},{"lineBreak":true},{"text":"我就不躲開你的面：","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"就是把你的手縮回，遠離我身；","poem":1},{"lineBreak":true},{"text":"又不使你的驚惶威嚇我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"這樣，你呼叫，我就回答；","poem":1},{"lineBreak":true},{"text":"或是讓我說話，你回答我。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我的罪孽和罪過有多少呢？","poem":1},{"lineBreak":true},{"text":"求你叫我知道我的過犯與罪愆。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你為何掩面、","poem":1},{"lineBreak":true},{"text":"拿我當仇敵呢？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你要驚動被風吹的葉子嗎？","poem":1},{"lineBreak":true},{"text":"要追趕枯乾的碎稭嗎？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你按罪狀刑罰我，","poem":1},{"lineBreak":true},{"text":"又使我擔當幼年的罪孽；","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"也把我的腳上了木狗，","poem":1},{"lineBreak":true},{"text":"並窺察我一切的道路，","poem":1},{"lineBreak":true},{"text":"為我的腳掌劃定界限。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我已經像滅絕的爛物，","poem":1},{"lineBreak":true},{"text":"像蟲蛀的衣裳。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}