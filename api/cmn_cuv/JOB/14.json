{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"人為婦人所生，","poem":1},{"lineBreak":true},{"text":"日子短少，多有患難；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"出來如花，又被割下，","poem":1},{"lineBreak":true},{"text":"飛去如影，不能存留。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"這樣的人你豈睜眼看他嗎？","poem":1},{"lineBreak":true},{"text":"又叫我來受審嗎？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"誰能使潔淨之物出於污穢之中呢？","poem":1},{"lineBreak":true},{"text":"無論誰也不能！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"人的日子既然限定，","poem":1},{"lineBreak":true},{"text":"他的月數在你那裏，","poem":1},{"lineBreak":true},{"text":"你也派定他的界限，使他不能越過，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"便求你轉眼不看他，使他得歇息，","poem":1},{"lineBreak":true},{"text":"直等他像雇工人完畢他的日子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"樹若被砍下，","poem":1},{"lineBreak":true},{"text":"還可指望發芽，","poem":1},{"lineBreak":true},{"text":"嫩枝生長不息；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"其根雖然衰老在地裏，","poem":1},{"lineBreak":true},{"text":"幹也死在土中，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"及至得了水氣，還要發芽，","poem":1},{"lineBreak":true},{"text":"又長枝條，像新栽的樹一樣。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"但人死亡而消滅；","poem":1},{"lineBreak":true},{"text":"他氣絕，竟在何處呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"海中的水絕盡，","poem":1},{"lineBreak":true},{"text":"江河消散乾涸。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"人也是如此，躺下不再起來，","poem":1},{"lineBreak":true},{"text":"等到天沒有了，仍不得復醒，","poem":1},{"lineBreak":true},{"text":"也不得從睡中喚醒。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"惟願你把我藏在陰間，","poem":1},{"lineBreak":true},{"text":"存於隱密處，等你的忿怒過去；","poem":1},{"lineBreak":true},{"text":"願你為我定了日期，記念我。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人若死了豈能再活呢？","poem":1},{"lineBreak":true},{"text":"我只要在我一切爭戰的日子，","poem":1},{"lineBreak":true},{"text":"等我被釋放","poem":1},{"noteId":2},{"text":"的時候來到。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你呼叫，我便回答；","poem":1},{"lineBreak":true},{"text":"你手所做的，你必羨慕。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"但如今你數點我的腳步，","poem":1},{"lineBreak":true},{"text":"豈不窺察我的罪過嗎？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的過犯被你封在囊中，","poem":1},{"lineBreak":true},{"text":"也縫嚴了我的罪孽。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"山崩變為無有；","poem":1},{"lineBreak":true},{"text":"磐石挪開原處。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"水流消磨石頭，","poem":1},{"lineBreak":true},{"text":"所流溢的洗去地上的塵土；","poem":1},{"lineBreak":true},{"text":"你也照樣滅絕人的指望。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你攻擊人常常得勝，使他去世；","poem":1},{"lineBreak":true},{"text":"你改變他的容貌，叫他往而不回。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他兒子得尊榮，他也不知道，","poem":1},{"lineBreak":true},{"text":"降為卑，他也不覺得。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"但知身上疼痛，","poem":1},{"lineBreak":true},{"text":"心中悲哀。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"-","text":"或譯：改變","reference":{"chapter":14,"verse":14}}]},"thisChapterLink":"/api/cmn_cuv/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}