{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":15,"content":[{"type":"heading","content":["第二次對話"]},{"type":"verse","number":1,"content":[{"text":"提幔人以利法回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"智慧人豈可用虛空的知識回答，","poem":1},{"lineBreak":true},{"text":"用東風充滿肚腹呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他豈可用無益的話","poem":1},{"lineBreak":true},{"text":"和無濟於事的言語理論呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你是廢棄敬畏的意，","poem":1},{"lineBreak":true},{"text":"在上帝面前阻止敬虔的心。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的罪孽指教你的口；","poem":1},{"lineBreak":true},{"text":"你選用詭詐人的舌頭。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你自己的口定你有罪，並非是我；","poem":1},{"lineBreak":true},{"text":"你自己的嘴見證你的不是。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"你豈是頭一個被生的人嗎？","poem":1},{"lineBreak":true},{"text":"你受造在諸山之先嗎？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你曾聽見上帝的密旨嗎？","poem":1},{"lineBreak":true},{"text":"你還將智慧獨自得盡嗎？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你知道甚麼是我們不知道的呢？","poem":1},{"lineBreak":true},{"text":"你明白甚麼是我們不明白的呢？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我們這裏有白髮的和年紀老邁的，","poem":1},{"lineBreak":true},{"text":"比你父親還老。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝用溫和的話安慰你，","poem":1},{"lineBreak":true},{"text":"你以為太小嗎？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你的心為何將你逼去？","poem":1},{"lineBreak":true},{"text":"你的眼為何冒出火星，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"使你的靈反對上帝，","poem":1},{"lineBreak":true},{"text":"也任你的口發這言語？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人是甚麼，竟算為潔淨呢？","poem":1},{"lineBreak":true},{"text":"婦人所生的是甚麼，竟算為義呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"上帝不信靠他的眾聖者；","poem":1},{"lineBreak":true},{"text":"在他眼前，天也不潔淨，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"何況那污穢可憎、","poem":1},{"lineBreak":true},{"text":"喝罪孽如水的世人呢！","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"我指示你，你要聽；","poem":1},{"lineBreak":true},{"text":"我要述說所看見的，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"就是智慧人從列祖所受，","poem":1},{"lineBreak":true},{"text":"傳說而不隱瞞的。","poem":1},{"lineBreak":true},{"text":"（","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"這地惟獨賜給他們，","poem":1},{"lineBreak":true},{"text":"並沒有外人從他們中間經過。）","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"惡人一生之日劬勞痛苦；","poem":1},{"lineBreak":true},{"text":"強暴人一生的年數也是如此。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"驚嚇的聲音常在他耳中；","poem":1},{"lineBreak":true},{"text":"在平安時，搶奪的必臨到他那裏。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他不信自己能從黑暗中轉回；","poem":1},{"lineBreak":true},{"text":"他被刀劍等候。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他漂流在外求食，說：哪裏有食物呢？","poem":1},{"lineBreak":true},{"text":"他知道黑暗的日子在他手邊預備好了。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"急難困苦叫他害怕，","poem":1},{"lineBreak":true},{"text":"而且勝了他，好像君王預備上陣一樣。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他伸手攻擊上帝，","poem":1},{"lineBreak":true},{"text":"以驕傲攻擊全能者，","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"挺着頸項，","poem":1},{"lineBreak":true},{"text":"用盾牌的厚凸面向全能者直闖；","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"是因他的臉蒙上脂油，","poem":1},{"lineBreak":true},{"text":"腰積成肥肉。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他曾住在荒涼城邑，","poem":1},{"lineBreak":true},{"text":"無人居住、將成亂堆的房屋。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他不得富足，財物不得常存，","poem":1},{"lineBreak":true},{"text":"產業在地上也不加增。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他不得出離黑暗。","poem":1},{"lineBreak":true},{"text":"火焰要將他的枝子燒乾；","poem":1},{"lineBreak":true},{"text":"因上帝口中的氣，他要滅亡","poem":1},{"noteId":3},{"text":"。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他不用倚靠虛假欺哄自己，","poem":1},{"lineBreak":true},{"text":"因虛假必成為他的報應。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他的日期未到之先，這事必成就；","poem":1},{"lineBreak":true},{"text":"他的枝子不得青綠。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他必像葡萄樹的葡萄，未熟而落；","poem":1},{"lineBreak":true},{"text":"又像橄欖樹的花，一開而謝。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"原來不敬虔之輩必無生育；","poem":1},{"lineBreak":true},{"text":"受賄賂之人的帳棚必被火燒。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"他們所懷的是毒害，所生的是罪孽；","poem":1},{"lineBreak":true},{"text":"心裏所預備的是詭詐。","poem":1}]}],"footnotes":[{"noteId":3,"caller":"-","text":"原文是走去","reference":{"chapter":15,"verse":30}}]},"thisChapterLink":"/api/cmn_cuv/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}