{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"約伯回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"這樣的話我聽了許多；","poem":1},{"lineBreak":true},{"text":"你們安慰人，反叫人愁煩。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"虛空的言語有窮盡嗎？","poem":1},{"lineBreak":true},{"text":"有甚麼話惹動你回答呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我也能說你們那樣的話；","poem":1},{"lineBreak":true},{"text":"你們若處在我的境遇，","poem":1},{"lineBreak":true},{"text":"我也會聯絡言語攻擊你們，","poem":1},{"lineBreak":true},{"text":"又能向你們搖頭。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但我必用口堅固你們，","poem":1},{"lineBreak":true},{"text":"用嘴消解你們的憂愁。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我雖說話，憂愁仍不得消解；","poem":1},{"lineBreak":true},{"text":"我雖停住不說，憂愁就離開我嗎？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"但現在上帝使我困倦，","poem":1},{"lineBreak":true},{"text":"使親友遠離我，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"又抓住我，作見證攻擊我；","poem":1},{"lineBreak":true},{"text":"我身體的枯瘦也當面見證我的不是。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"主發怒撕裂我，逼迫我，","poem":1},{"lineBreak":true},{"text":"向我切齒；","poem":1},{"lineBreak":true},{"text":"我的敵人怒目看我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們向我開口，","poem":1},{"lineBreak":true},{"text":"打我的臉羞辱我，","poem":1},{"lineBreak":true},{"text":"聚會攻擊我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝把我交給不敬虔的人，","poem":1},{"lineBreak":true},{"text":"把我扔到惡人的手中。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我素來安逸，他折斷我，","poem":1},{"lineBreak":true},{"text":"掐住我的頸項，把我摔碎，","poem":1},{"lineBreak":true},{"text":"又立我為他的箭靶子。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他的弓箭手四面圍繞我；","poem":1},{"lineBreak":true},{"text":"他破裂我的肺腑，並不留情，","poem":1},{"lineBreak":true},{"text":"把我的膽傾倒在地上，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"將我破裂又破裂，","poem":1},{"lineBreak":true},{"text":"如同勇士向我直闖。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"我縫麻布在我皮膚上，","poem":1},{"lineBreak":true},{"text":"把我的角放在塵土中。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我的臉因哭泣發紫，","poem":1},{"lineBreak":true},{"text":"在我的眼皮上有死蔭。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的手中卻無強暴；","poem":1},{"lineBreak":true},{"text":"我的祈禱也是清潔。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"地啊，不要遮蓋我的血！","poem":1},{"lineBreak":true},{"text":"不要阻擋我的哀求！","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"現今，在天有我的見證，","poem":1},{"lineBreak":true},{"text":"在上有我的中保。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的朋友譏誚我，","poem":1},{"lineBreak":true},{"text":"我卻向上帝眼淚汪汪。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"願人得與上帝辯白，","poem":1},{"lineBreak":true},{"text":"如同人與朋友辯白一樣；","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因為再過幾年，","poem":1},{"lineBreak":true},{"text":"我必走那往而不返之路。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}