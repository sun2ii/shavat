{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"我的心靈消耗，我的日子滅盡；","poem":1},{"lineBreak":true},{"text":"墳墓為我預備好了。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"真有戲笑我的在我這裏，","poem":1},{"lineBreak":true},{"text":"我眼常見他們惹動我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"願主拿憑據給我，自己為我作保。","poem":1},{"lineBreak":true},{"text":"在你以外誰肯與我擊掌呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因你使他們心不明理，","poem":1},{"lineBreak":true},{"text":"所以你必不高舉他們。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"控告他的朋友、以朋友為可搶奪的，","poem":1},{"lineBreak":true},{"text":"連他兒女的眼睛也要失明。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"上帝使我作了民中的笑談；","poem":1},{"lineBreak":true},{"text":"他們也吐唾沫在我臉上。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的眼睛因憂愁昏花；","poem":1},{"lineBreak":true},{"text":"我的百體好像影兒。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"正直人因此必驚奇；","poem":1},{"lineBreak":true},{"text":"無辜的人要興起攻擊不敬虔之輩。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"然而，義人要持守所行的道；","poem":1},{"lineBreak":true},{"text":"手潔的人要力上加力。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"至於你們眾人，可以再來辯論吧！","poem":1},{"lineBreak":true},{"text":"你們中間，我找不着一個智慧人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的日子已經過了；","poem":1},{"lineBreak":true},{"text":"我的謀算、我心所想望的已經斷絕。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們以黑夜為白晝，","poem":1},{"lineBreak":true},{"text":"說：亮光近乎黑暗。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我若盼望陰間為我的房屋，","poem":1},{"lineBreak":true},{"text":"若下榻在黑暗中，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"若對朽壞說：你是我的父；","poem":1},{"lineBreak":true},{"text":"對蟲說：你是我的母親姊妹；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"這樣，我的指望在哪裏呢？","poem":1},{"lineBreak":true},{"text":"我所指望的誰能看見呢？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"等到安息在塵土中，","poem":1},{"lineBreak":true},{"text":"這指望必下到陰間的門閂那裏了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}