{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"書亞人比勒達回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你尋索言語要到幾時呢？","poem":1},{"lineBreak":true},{"text":"你可以揣摩思想，然後我們就說話。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我們為何算為畜生，","poem":1},{"lineBreak":true},{"text":"在你眼中看作污穢呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你這惱怒將自己撕裂的，","poem":1},{"lineBreak":true},{"text":"難道大地為你見棄、","poem":1},{"lineBreak":true},{"text":"磐石挪開原處嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"惡人的亮光必要熄滅；","poem":1},{"lineBreak":true},{"text":"他的火焰必不照耀。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他帳棚中的亮光要變為黑暗；","poem":1},{"lineBreak":true},{"text":"他以上的燈也必熄滅。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他堅強的腳步必見狹窄；","poem":1},{"lineBreak":true},{"text":"自己的計謀必將他絆倒。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因為他被自己的腳陷入網中，","poem":1},{"lineBreak":true},{"text":"走在纏人的網羅上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"圈套必抓住他的腳跟；","poem":1},{"lineBreak":true},{"text":"機關必擒獲他。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"活扣為他藏在土內；","poem":1},{"lineBreak":true},{"text":"羈絆為他藏在路上。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"四面的驚嚇要使他害怕，","poem":1},{"lineBreak":true},{"text":"並且追趕他的腳跟。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他的力量必因飢餓衰敗；","poem":1},{"lineBreak":true},{"text":"禍患要在他旁邊等候。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他本身的肢體要被吞吃；","poem":1},{"lineBreak":true},{"text":"死亡的長子要吞吃他的肢體。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他要從所倚靠的帳棚被拔出來，","poem":1},{"lineBreak":true},{"text":"帶到驚嚇的王那裏。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"不屬他的必住在他的帳棚裏；","poem":1},{"lineBreak":true},{"text":"硫磺必撒在他所住之處。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"下邊，他的根本要枯乾；","poem":1},{"lineBreak":true},{"text":"上邊，他的枝子要剪除。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他的記念在地上必然滅亡；","poem":1},{"lineBreak":true},{"text":"他的名字在街上也不存留。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他必從光明中被攆到黑暗裏，","poem":1},{"lineBreak":true},{"text":"必被趕出世界。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"在本民中必無子無孫；","poem":1},{"lineBreak":true},{"text":"在寄居之地也無一人存留。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"以後來的要驚奇他的日子，","poem":1},{"lineBreak":true},{"text":"好像以前去的受了驚駭。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"不義之人的住處總是這樣；","poem":1},{"lineBreak":true},{"text":"此乃不認識上帝之人的地步。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}