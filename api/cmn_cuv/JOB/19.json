{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"約伯回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們攪擾我的心，","poem":1},{"lineBreak":true},{"text":"用言語壓碎我要到幾時呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們這十次羞辱我；","poem":1},{"lineBreak":true},{"text":"你們苦待我也不以為恥。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"果真我有錯，","poem":1},{"lineBreak":true},{"text":"這錯乃是在我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你們果然要向我誇大，","poem":1},{"lineBreak":true},{"text":"以我的羞辱為證指責我，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"就該知道是上帝傾覆我，","poem":1},{"lineBreak":true},{"text":"用網羅圍繞我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我因委曲呼叫，卻不蒙應允；","poem":1},{"lineBreak":true},{"text":"我呼求，卻不得公斷。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"上帝用籬笆攔住我的道路，使我不得經過；","poem":1},{"lineBreak":true},{"text":"又使我的路徑黑暗。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他剝去我的榮光，","poem":1},{"lineBreak":true},{"text":"摘去我頭上的冠冕。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他在四圍攻擊我，我便歸於死亡，","poem":1},{"lineBreak":true},{"text":"將我的指望如樹拔出來。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他的忿怒向我發作，","poem":1},{"lineBreak":true},{"text":"以我為敵人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他的軍旅一齊上來，","poem":1},{"lineBreak":true},{"text":"修築戰路攻擊我，","poem":1},{"lineBreak":true},{"text":"在我帳棚的四圍安營。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"他把我的弟兄隔在遠處，","poem":1},{"lineBreak":true},{"text":"使我所認識的全然與我生疏。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我的親戚與我斷絕；","poem":1},{"lineBreak":true},{"text":"我的密友都忘記我。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"在我家寄居的，","poem":1},{"lineBreak":true},{"text":"和我的使女都以我為外人；","poem":1},{"lineBreak":true},{"text":"我在他們眼中看為外邦人。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我呼喚僕人，","poem":1},{"lineBreak":true},{"text":"雖用口求他，他還是不回答。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我口的氣味，我妻子厭惡；","poem":1},{"lineBreak":true},{"text":"我的懇求，我同胞也憎嫌。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"連小孩子也藐視我；","poem":1},{"lineBreak":true},{"text":"我若起來，他們都嘲笑我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的密友都憎惡我；","poem":1},{"lineBreak":true},{"text":"我平日所愛的人向我翻臉。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的皮肉緊貼骨頭；","poem":1},{"lineBreak":true},{"text":"我只剩牙皮逃脫了。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我朋友啊，可憐我！可憐我！","poem":1},{"lineBreak":true},{"text":"因為上帝的手攻擊我。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你們為甚麼彷彿上帝逼迫我，","poem":1},{"lineBreak":true},{"text":"吃我的肉還以為不足呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"惟願我的言語現在寫上，","poem":1},{"lineBreak":true},{"text":"都記錄在書上；","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"用鐵筆鐫刻，","poem":1},{"lineBreak":true},{"text":"用鉛灌在磐石上，直存到永遠。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我知道我的救贖主活着，","poem":1},{"lineBreak":true},{"text":"末了必站立在地上。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我這皮肉滅絕之後，","poem":1},{"lineBreak":true},{"text":"我必在肉體之外得見上帝。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我自己要見他，","poem":1},{"lineBreak":true},{"text":"親眼要看他，並不像外人。","poem":1},{"lineBreak":true},{"text":"我的心腸在我裏面消滅了！","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你們若說：我們逼迫他要何等地重呢？","poem":1},{"lineBreak":true},{"text":"惹事的根乃在乎他；","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你們就當懼怕刀劍；","poem":1},{"lineBreak":true},{"text":"因為忿怒惹動刀劍的刑罰，","poem":1},{"lineBreak":true},{"text":"使你們知道有報應","poem":1},{"noteId":4},{"text":"。","poem":1}]}],"footnotes":[{"noteId":4,"caller":"-","text":"原文是審判","reference":{"chapter":19,"verse":29}}]},"thisChapterLink":"/api/cmn_cuv/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}