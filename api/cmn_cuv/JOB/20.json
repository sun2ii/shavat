{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"拿瑪人瑣法回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我心中急躁，","poem":1},{"lineBreak":true},{"text":"所以我的思念叫我回答。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我已聽見那羞辱我，責備我的話；","poem":1},{"lineBreak":true},{"text":"我的悟性叫我回答。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你豈不知亙古以來，","poem":1},{"lineBreak":true},{"text":"自從人生在地，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"惡人誇勝是暫時的，","poem":1},{"lineBreak":true},{"text":"不敬虔人的喜樂不過轉眼之間嗎？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他的尊榮雖達到天上，","poem":1},{"lineBreak":true},{"text":"頭雖頂到雲中，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他終必滅亡，像自己的糞一樣；","poem":1},{"lineBreak":true},{"text":"素來見他的人要說：他在哪裏呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他必飛去如夢，不再尋見，","poem":1},{"lineBreak":true},{"text":"速被趕去，如夜間的異象。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"親眼見過他的，必不再見他；","poem":1},{"lineBreak":true},{"text":"他的本處也再見不着他。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他的兒女要求窮人的恩；","poem":1},{"lineBreak":true},{"text":"他的手要賠還不義之財。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他的骨頭雖然有青年之力，","poem":1},{"lineBreak":true},{"text":"卻要和他一同躺臥在塵土中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"他口內雖以惡為甘甜，","poem":1},{"lineBreak":true},{"text":"藏在舌頭底下，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"愛戀不捨，含在口中；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他的食物在肚裏卻要化為酸，","poem":1},{"lineBreak":true},{"text":"在他裏面成為虺蛇的惡毒。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他吞了財寶，還要吐出；","poem":1},{"lineBreak":true},{"text":"上帝要從他腹中掏出來。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他必吸飲虺蛇的毒氣；","poem":1},{"lineBreak":true},{"text":"蝮蛇的舌頭也必殺他。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"流奶與蜜之河，","poem":1},{"lineBreak":true},{"text":"他不得再見。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他勞碌得來的要賠還，不得享用","poem":1},{"noteId":5},{"text":"；","poem":1},{"lineBreak":true},{"text":"不能照所得的財貨歡樂。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他欺壓窮人，且又離棄；","poem":1},{"lineBreak":true},{"text":"強取非自己所蓋的房屋","poem":1},{"noteId":6},{"text":"。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他因貪而無厭，","poem":1},{"lineBreak":true},{"text":"所喜悅的連一樣也不能保守。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"其餘的沒有一樣他不吞滅，","poem":1},{"lineBreak":true},{"text":"所以他的福樂不能長久。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他在滿足有餘的時候，必到狹窄的地步；","poem":1},{"lineBreak":true},{"text":"凡受苦楚的人都必加手在他身上。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他正要充滿肚腹的時候，","poem":1},{"lineBreak":true},{"text":"上帝必將猛烈的忿怒降在他身上；","poem":1},{"lineBreak":true},{"text":"正在他吃飯的時候，","poem":1},{"lineBreak":true},{"text":"要將這忿怒像雨降在他身上。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他要躲避鐵器；","poem":1},{"lineBreak":true},{"text":"銅弓的箭要將他射透。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他把箭一抽，就從他身上出來；","poem":1},{"lineBreak":true},{"text":"發光的箭頭從他膽中出來，","poem":1},{"lineBreak":true},{"text":"有驚惶臨在他身上。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他的財寶歸於黑暗；","poem":1},{"lineBreak":true},{"text":"人所不吹的火要把他燒滅，","poem":1},{"lineBreak":true},{"text":"要把他帳棚中所剩下的燒毀。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"天要顯明他的罪孽；","poem":1},{"lineBreak":true},{"text":"地要興起攻擊他。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他的家產必然過去；","poem":1},{"lineBreak":true},{"text":"上帝發怒的日子，他的貨物都要消滅。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"這是惡人從上帝所得的分，","poem":1},{"lineBreak":true},{"text":"是上帝為他所定的產業。","poem":1}]}],"footnotes":[{"noteId":5,"caller":"-","text":"原文是吞下","reference":{"chapter":20,"verse":18}},{"noteId":6,"caller":"-","text":"或譯：強取房屋不得再建造","reference":{"chapter":20,"verse":19}}]},"thisChapterLink":"/api/cmn_cuv/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}