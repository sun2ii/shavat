{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"約伯回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們要細聽我的言語，","poem":1},{"lineBreak":true},{"text":"就算是你們安慰我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"請寬容我，我又要說話；","poem":1},{"lineBreak":true},{"text":"說了以後，任憑你們嗤笑吧！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我豈是向人訴冤？","poem":1},{"lineBreak":true},{"text":"為何不焦急呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你們要看着我而驚奇，","poem":1},{"lineBreak":true},{"text":"用手摀口。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我每逢思想，心就驚惶，","poem":1},{"lineBreak":true},{"text":"渾身戰兢。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"惡人為何存活，","poem":1},{"lineBreak":true},{"text":"享大壽數，勢力強盛呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們眼見兒孫，","poem":1},{"lineBreak":true},{"text":"和他們一同堅立。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們的家宅平安無懼；","poem":1},{"lineBreak":true},{"text":"上帝的杖也不加在他們身上。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們的公牛孳生而不斷絕；","poem":1},{"lineBreak":true},{"text":"母牛下犢而不掉胎。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們打發小孩子出去，多如羊群；","poem":1},{"lineBreak":true},{"text":"他們的兒女踴躍跳舞。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們隨着琴鼓歌唱，","poem":1},{"lineBreak":true},{"text":"又因簫聲歡喜。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他們度日諸事亨通，","poem":1},{"lineBreak":true},{"text":"轉眼下入陰間。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們對上帝說：離開我們吧！","poem":1},{"lineBreak":true},{"text":"我們不願曉得你的道。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"全能者是誰，我們何必事奉他呢？","poem":1},{"lineBreak":true},{"text":"求告他有甚麼益處呢？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"看哪，他們亨通不在乎自己；","poem":1},{"lineBreak":true},{"text":"惡人所謀定的離我好遠。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"惡人的燈何嘗熄滅？","poem":1},{"lineBreak":true},{"text":"患難何嘗臨到他們呢？","poem":1},{"lineBreak":true},{"text":"上帝何嘗發怒，向他們分散災禍呢？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他們何嘗像風前的碎稭，","poem":1},{"lineBreak":true},{"text":"如暴風颳去的糠詷呢？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你們說：上帝為惡人的兒女積蓄罪孽；","poem":1},{"lineBreak":true},{"text":"我說：不如本人受報，好使他親自知道。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"願他親眼看見自己敗亡，","poem":1},{"lineBreak":true},{"text":"親自飲全能者的忿怒。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他的歲月既盡，","poem":1},{"lineBreak":true},{"text":"他還顧他本家嗎？","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"上帝既審判那在高位的，","poem":1},{"lineBreak":true},{"text":"誰能將知識教訓他呢？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"有人至死身體強壯，","poem":1},{"lineBreak":true},{"text":"盡得平靖安逸；","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他的奶桶充滿，","poem":1},{"lineBreak":true},{"text":"他的骨髓滋潤。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"有人至死心中痛苦，","poem":1},{"lineBreak":true},{"text":"終身未嘗福樂的滋味；","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他們一樣躺臥在塵土中，","poem":1},{"lineBreak":true},{"text":"都被蟲子遮蓋。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"我知道你們的意思，","poem":1},{"lineBreak":true},{"text":"並誣害我的計謀。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你們說：霸者的房屋在哪裏？","poem":1},{"lineBreak":true},{"text":"惡人住過的帳棚在哪裏？","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你們豈沒有詢問過路的人嗎？","poem":1},{"lineBreak":true},{"text":"不知道他們所引的證據嗎？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"就是惡人在禍患的日子得存留，","poem":1},{"lineBreak":true},{"text":"在發怒的日子得逃脫。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他所行的，有誰當面給他說明？","poem":1},{"lineBreak":true},{"text":"他所做的，有誰報應他呢？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"然而他要被抬到塋地；","poem":1},{"lineBreak":true},{"text":"並有人看守墳墓。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他要以谷中的土塊為甘甜；","poem":1},{"lineBreak":true},{"text":"在他以先去的無數，","poem":1},{"lineBreak":true},{"text":"在他以後去的更多。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你們對答的話中既都錯謬，","poem":1},{"lineBreak":true},{"text":"怎麼徒然安慰我呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}