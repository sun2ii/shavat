{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":22,"content":[{"type":"heading","content":["第三次對話"]},{"type":"verse","number":1,"content":[{"text":"提幔人以利法回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"人豈能使上帝有益呢？","poem":1},{"lineBreak":true},{"text":"智慧人但能有益於己。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你為人公義，豈叫全能者喜悅呢？","poem":1},{"lineBreak":true},{"text":"你行為完全，豈能使他得利呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"豈是因你敬畏他","poem":1},{"lineBreak":true},{"text":"就責備你、審判你嗎？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的罪惡豈不是大嗎？","poem":1},{"lineBreak":true},{"text":"你的罪孽也沒有窮盡；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因你無故強取弟兄的物為當頭，","poem":1},{"lineBreak":true},{"text":"剝去貧寒人的衣服。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"困乏的人，你沒有給他水喝；","poem":1},{"lineBreak":true},{"text":"飢餓的人，你沒有給他食物。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"有能力的人就得地土；","poem":1},{"lineBreak":true},{"text":"尊貴的人也住在其中。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你打發寡婦空手回去，","poem":1},{"lineBreak":true},{"text":"折斷孤兒的膀臂。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因此，有網羅環繞你，","poem":1},{"lineBreak":true},{"text":"有恐懼忽然使你驚惶；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"或有黑暗蒙蔽你，","poem":1},{"lineBreak":true},{"text":"並有洪水淹沒你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"上帝豈不是在高天嗎？","poem":1},{"lineBreak":true},{"text":"你看星宿何其高呢！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你說：上帝知道甚麼？","poem":1},{"lineBreak":true},{"text":"他豈能看透幽暗施行審判呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"密雲將他遮蓋，使他不能看見；","poem":1},{"lineBreak":true},{"text":"他周遊穹蒼。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你要依從上古的道嗎？","poem":1},{"lineBreak":true},{"text":"這道是惡人所行的。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他們未到死期，忽然除滅；","poem":1},{"lineBreak":true},{"text":"根基毀壞，好像被江河沖去。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他們向上帝說：離開我們吧！","poem":1},{"lineBreak":true},{"text":"又說：全能者能把我們怎麼樣呢？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"哪知上帝以美物充滿他們的房屋；","poem":1},{"lineBreak":true},{"text":"但惡人所謀定的離我好遠。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"義人看見他們的結局就歡喜；","poem":1},{"lineBreak":true},{"text":"無辜的人嗤笑他們，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"說：那起來攻擊我們的果然被剪除，","poem":1},{"lineBreak":true},{"text":"其餘的都被火燒滅。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"你要認識上帝，就得平安；","poem":1},{"lineBreak":true},{"text":"福氣也必臨到你。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你當領受他口中的教訓，","poem":1},{"lineBreak":true},{"text":"將他的言語存在心裏。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你若歸向全能者，從你帳棚中遠除不義，","poem":1},{"lineBreak":true},{"text":"就必得建立。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"要將你的珍寶丟在塵土裏，","poem":1},{"lineBreak":true},{"text":"將俄斐的黃金丟在溪河石頭之間；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"全能者就必為你的珍寶，","poem":1},{"lineBreak":true},{"text":"作你的寶銀。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你就要以全能者為喜樂，","poem":1},{"lineBreak":true},{"text":"向上帝仰起臉來。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你要禱告他，他就聽你；","poem":1},{"lineBreak":true},{"text":"你也要還你的願。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你定意要做何事，必然給你成就；","poem":1},{"lineBreak":true},{"text":"亮光也必照耀你的路。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"人使你降卑，你仍可說：必得高升；","poem":1},{"lineBreak":true},{"text":"謙卑的人，上帝必然拯救。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"人非無辜，上帝且要搭救他；","poem":1},{"lineBreak":true},{"text":"他因你手中清潔，必蒙拯救。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}