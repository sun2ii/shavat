{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"約伯回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"如今我的哀告還算為悖逆；","poem":1},{"lineBreak":true},{"text":"我的責罰比我的唉哼還重。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"惟願我能知道在哪裏可以尋見上帝，","poem":1},{"lineBreak":true},{"text":"能到他的臺前，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我就在他面前將我的案件陳明，","poem":1},{"lineBreak":true},{"text":"滿口辯白。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我必知道他回答我的言語，","poem":1},{"lineBreak":true},{"text":"明白他向我所說的話。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他豈用大能與我爭辯嗎？","poem":1},{"lineBreak":true},{"text":"必不這樣！他必理會我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"在他那裏正直人可以與他辯論；","poem":1},{"lineBreak":true},{"text":"這樣，我必永遠脫離那審判我的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"只是，我往前行，他不在那裏，","poem":1},{"lineBreak":true},{"text":"往後退，也不能見他。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他在左邊行事，我卻不能看見，","poem":1},{"lineBreak":true},{"text":"在右邊隱藏，我也不能見他。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"然而他知道我所行的路；","poem":1},{"lineBreak":true},{"text":"他試煉我之後，我必如精金。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我腳追隨他的步履；","poem":1},{"lineBreak":true},{"text":"我謹守他的道，並不偏離。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他嘴唇的命令，我未曾背棄；","poem":1},{"lineBreak":true},{"text":"我看重他口中的言語，過於我需用的飲食。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"只是他心志已定，誰能使他轉意呢？","poem":1},{"lineBreak":true},{"text":"他心裏所願的，就行出來。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他向我所定的，就必做成；","poem":1},{"lineBreak":true},{"text":"這類的事他還有許多。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"所以我在他面前驚惶；","poem":1},{"lineBreak":true},{"text":"我思念這事便懼怕他。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"上帝使我喪膽；","poem":1},{"lineBreak":true},{"text":"全能者使我驚惶。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的恐懼不是因為黑暗，","poem":1},{"lineBreak":true},{"text":"也不是因為幽暗蒙蔽我的臉。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}