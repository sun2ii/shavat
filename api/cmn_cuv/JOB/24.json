{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"全能者既定期罰惡，","poem":1},{"lineBreak":true},{"text":"為何不使認識他的人看見那日子呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"有人挪移地界，","poem":1},{"lineBreak":true},{"text":"搶奪群畜而牧養。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們拉去孤兒的驢，","poem":1},{"lineBreak":true},{"text":"強取寡婦的牛為當頭。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們使窮人離開正道；","poem":1},{"lineBreak":true},{"text":"世上的貧民盡都隱藏。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"這些貧窮人如同野驢出到曠野，殷勤尋找食物；","poem":1},{"lineBreak":true},{"text":"他們靠着野地給兒女糊口，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"收割別人田間的禾稼，","poem":1},{"lineBreak":true},{"text":"摘取惡人餘剩的葡萄，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"終夜赤身無衣，","poem":1},{"lineBreak":true},{"text":"天氣寒冷毫無遮蓋，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"在山上被大雨淋濕，","poem":1},{"lineBreak":true},{"text":"因沒有避身之處就挨近磐石。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"又有人從母懷中搶奪孤兒，","poem":1},{"lineBreak":true},{"text":"強取窮人的衣服為當頭，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"使人赤身無衣，到處流行，","poem":1},{"lineBreak":true},{"text":"且因飢餓扛抬禾捆，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"在那些人的圍牆內造油，醡酒，","poem":1},{"lineBreak":true},{"text":"自己還口渴。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"在多民的城內有人唉哼，","poem":1},{"lineBreak":true},{"text":"受傷的人哀號；","poem":1},{"lineBreak":true},{"text":"上帝卻不理會那惡人的愚妄。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"又有人背棄光明，","poem":1},{"lineBreak":true},{"text":"不認識光明的道，","poem":1},{"lineBreak":true},{"text":"不住在光明的路上。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"殺人的黎明起來，","poem":1},{"lineBreak":true},{"text":"殺害困苦窮乏人，","poem":1},{"lineBreak":true},{"text":"夜間又作盜賊。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"姦夫等候黃昏，","poem":1},{"lineBreak":true},{"text":"說：必無眼能見我，","poem":1},{"lineBreak":true},{"text":"就把臉蒙蔽。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"盜賊黑夜挖窟窿；","poem":1},{"lineBreak":true},{"text":"白日躲藏，","poem":1},{"lineBreak":true},{"text":"並不認識光明。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他們看早晨如幽暗，","poem":1},{"lineBreak":true},{"text":"因為他們曉得幽暗的驚駭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"這些惡人猶如浮萍快快飄去。","poem":1},{"lineBreak":true},{"text":"他們所得的分在世上被咒詛；","poem":1},{"lineBreak":true},{"text":"他們不得再走葡萄園的路。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"乾旱炎熱消沒雪水；","poem":1},{"lineBreak":true},{"text":"陰間也如此消沒犯罪之輩。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"懷他的母","poem":1},{"noteId":7},{"text":"要忘記他；","poem":1},{"lineBreak":true},{"text":"蟲子要吃他，覺得甘甜；","poem":1},{"lineBreak":true},{"text":"他不再被人記念。","poem":1},{"lineBreak":true},{"text":"不義的人必如樹折斷。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"他惡待","poem":1},{"noteId":8},{"text":"不懷孕不生養的婦人，","poem":1},{"lineBreak":true},{"text":"不善待寡婦。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"然而上帝用能力保全有勢力的人；","poem":1},{"lineBreak":true},{"text":"那性命難保的人仍然興起。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"上帝使他們安穩，他們就有所倚靠；","poem":1},{"lineBreak":true},{"text":"上帝的眼目也看顧他們的道路。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他們被高舉，不過片時就沒有了；","poem":1},{"lineBreak":true},{"text":"他們降為卑，被除滅，與眾人一樣，","poem":1},{"lineBreak":true},{"text":"又如穀穗被割。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"若不是這樣，誰能證實我是說謊的，","poem":1},{"lineBreak":true},{"text":"將我的言語駁為虛空呢？","poem":1}]}],"footnotes":[{"noteId":7,"caller":"-","text":"原文是胎","reference":{"chapter":24,"verse":20}},{"noteId":8,"caller":"-","text":"或譯：他吞滅","reference":{"chapter":24,"verse":21}}]},"thisChapterLink":"/api/cmn_cuv/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}