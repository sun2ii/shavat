{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":[{"text":"書亞人比勒達回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"上帝有治理之權，有威嚴可畏；","poem":1},{"lineBreak":true},{"text":"他在高處施行和平。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他的諸軍豈能數算？","poem":1},{"lineBreak":true},{"text":"他的光亮一發，誰不蒙照呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"這樣在上帝面前，人怎能稱義？","poem":1},{"lineBreak":true},{"text":"婦人所生的怎能潔淨？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在上帝眼前，月亮也無光亮，","poem":1},{"lineBreak":true},{"text":"星宿也不清潔。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"何況如蟲的人，","poem":1},{"lineBreak":true},{"text":"如蛆的世人呢！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}