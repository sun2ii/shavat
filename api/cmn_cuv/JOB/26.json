{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"約伯回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"無能的人蒙你何等的幫助！","poem":1},{"lineBreak":true},{"text":"膀臂無力的人蒙你何等的拯救！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"無智慧的人蒙你何等的指教！","poem":1},{"lineBreak":true},{"text":"你向他多顯大知識！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你向誰發出言語來？","poem":1},{"lineBreak":true},{"text":"誰的靈從你而出？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在大水和水族以下的陰魂戰兢。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"在上帝面前，陰間顯露；","poem":1},{"lineBreak":true},{"text":"滅亡也不得遮掩。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝將北極鋪在空中，","poem":1},{"lineBreak":true},{"text":"將大地懸在虛空；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"將水包在密雲中，","poem":1},{"lineBreak":true},{"text":"雲卻不破裂；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"遮蔽他的寶座，","poem":1},{"lineBreak":true},{"text":"將雲鋪在其上；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"在水面的周圍劃出界限，","poem":1},{"lineBreak":true},{"text":"直到光明黑暗的交界。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"天的柱子因他的斥責震動驚奇。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他以能力攪動","poem":1},{"noteId":9},{"text":"大海；","poem":1},{"lineBreak":true},{"text":"他藉知識打傷拉哈伯，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"藉他的靈使天有妝飾；","poem":1},{"lineBreak":true},{"text":"他的手刺殺快蛇。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"看哪，這不過是上帝工作的些微；","poem":1},{"lineBreak":true},{"text":"我們所聽於他的是何等細微的聲音！","poem":1},{"lineBreak":true},{"text":"他大能的雷聲誰能明透呢？","poem":1}]}],"footnotes":[{"noteId":9,"caller":"-","text":"或譯：平靜","reference":{"chapter":26,"verse":12}}]},"thisChapterLink":"/api/cmn_cuv/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}