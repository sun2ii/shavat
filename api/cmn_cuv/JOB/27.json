{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"約伯接着說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"上帝奪去我的理，全能者使我心中愁苦。","poem":1},{"lineBreak":true},{"text":"我指着永生的上帝起誓：","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的生命尚在我裏面；","poem":1},{"lineBreak":true},{"text":"上帝所賜呼吸之氣仍在我的鼻孔內。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的嘴決不說非義之言；","poem":1},{"lineBreak":true},{"text":"我的舌也不說詭詐之語。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我斷不以你們為是；","poem":1},{"lineBreak":true},{"text":"我至死必不以自己為不正！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我持定我的義，必不放鬆；","poem":1},{"lineBreak":true},{"text":"在世的日子，我心必不責備我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"願我的仇敵如惡人一樣；","poem":1},{"lineBreak":true},{"text":"願那起來攻擊我的，如不義之人一般。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"不敬虔的人雖然得利，","poem":1},{"lineBreak":true},{"text":"上帝奪取其命的時候還有甚麼指望呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"患難臨到他，","poem":1},{"lineBreak":true},{"text":"上帝豈能聽他的呼求？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他豈以全能者為樂，","poem":1},{"lineBreak":true},{"text":"隨時求告上帝呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝的作為，我要指教你們；","poem":1},{"lineBreak":true},{"text":"全能者所行的，我也不隱瞞。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你們自己也都見過，","poem":1},{"lineBreak":true},{"text":"為何全然變為虛妄呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"上帝為惡人所定的分，","poem":1},{"lineBreak":true},{"text":"強暴人從全能者所得的報","poem":1},{"noteId":10},{"text":"乃是這樣：","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"倘或他的兒女增多，還是被刀所殺；","poem":1},{"lineBreak":true},{"text":"他的子孫必不得飽食。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他所遺留的人必死而埋葬；","poem":1},{"lineBreak":true},{"text":"他的寡婦也不哀哭。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他雖積蓄銀子如塵沙，","poem":1},{"lineBreak":true},{"text":"預備衣服如泥土；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他只管預備，義人卻要穿上；","poem":1},{"lineBreak":true},{"text":"他的銀子，無辜的人要分取。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他建造房屋如蟲做窩，","poem":1},{"lineBreak":true},{"text":"又如守望者所搭的棚。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他雖富足躺臥，卻不得收殮，","poem":1},{"lineBreak":true},{"text":"轉眼之間就不在了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"驚恐如波濤將他追上；","poem":1},{"lineBreak":true},{"text":"暴風在夜間將他颳去。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"東風把他飄去，","poem":1},{"lineBreak":true},{"text":"又颳他離開本處。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"上帝要向他射箭，並不留情；","poem":1},{"lineBreak":true},{"text":"他恨不得逃脫上帝的手。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"人要向他拍掌，","poem":1},{"lineBreak":true},{"text":"並要發叱聲，使他離開本處。","poem":1}]}],"footnotes":[{"noteId":10,"caller":"-","text":"原文是產業","reference":{"chapter":27,"verse":13}}]},"thisChapterLink":"/api/cmn_cuv/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}