{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":28,"content":[{"type":"heading","content":["歌頌智慧"]},{"type":"verse","number":1,"content":[{"text":"銀子有礦；","poem":1},{"lineBreak":true},{"text":"煉金有方。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"鐵從地裏挖出；","poem":1},{"lineBreak":true},{"text":"銅從石中鎔化。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人為黑暗定界限，","poem":1},{"lineBreak":true},{"text":"查究幽暗陰翳的石頭，直到極處，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"在無人居住之處刨開礦穴，","poem":1},{"lineBreak":true},{"text":"過路的人也想不到他們；","poem":1},{"lineBreak":true},{"text":"又與人遠離，懸在空中搖來搖去。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"至於地，能出糧食，","poem":1},{"lineBreak":true},{"text":"地內好像被火翻起來。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"地中的石頭有藍寶石，","poem":1},{"lineBreak":true},{"text":"並有金沙。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"礦中的路鷙鳥不得知道；","poem":1},{"lineBreak":true},{"text":"鷹眼也未見過。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"狂傲的野獸未曾行過；","poem":1},{"lineBreak":true},{"text":"猛烈的獅子也未曾經過。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"人伸手鑿開堅石，","poem":1},{"lineBreak":true},{"text":"傾倒山根，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"在磐石中鑿出水道，","poem":1},{"lineBreak":true},{"text":"親眼看見各樣寶物。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他封閉水不得滴流，","poem":1},{"lineBreak":true},{"text":"使隱藏的物顯露出來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"然而，智慧有何處可尋？","poem":1},{"lineBreak":true},{"text":"聰明之處在哪裏呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"智慧的價值無人能知，","poem":1},{"lineBreak":true},{"text":"在活人之地也無處可尋。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"深淵說：不在我內；","poem":1},{"lineBreak":true},{"text":"滄海說：不在我中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"智慧非用黃金可得，","poem":1},{"lineBreak":true},{"text":"也不能平白銀為它的價值。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"俄斐金和貴重的紅瑪瑙，","poem":1},{"lineBreak":true},{"text":"並藍寶石，不足與較量；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"黃金和玻璃不足與比較；","poem":1},{"lineBreak":true},{"text":"精金的器皿不足與兌換。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"珊瑚、水晶都不足論；","poem":1},{"lineBreak":true},{"text":"智慧的價值勝過珍珠","poem":1},{"noteId":11},{"text":"。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"古實的紅璧璽不足與比較；","poem":1},{"lineBreak":true},{"text":"精金也不足與較量。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"智慧從何處來呢？","poem":1},{"lineBreak":true},{"text":"聰明之處在哪裏呢？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"是向一切有生命的眼目隱藏，","poem":1},{"lineBreak":true},{"text":"向空中的飛鳥掩蔽。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"滅沒和死亡說：","poem":1},{"lineBreak":true},{"text":"我們風聞其名。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"上帝明白智慧的道路，","poem":1},{"lineBreak":true},{"text":"曉得智慧的所在。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"因他鑒察直到地極，","poem":1},{"lineBreak":true},{"text":"遍觀普天之下，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"要為風定輕重，","poem":1},{"lineBreak":true},{"text":"又度量諸水；","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他為雨露定命令，","poem":1},{"lineBreak":true},{"text":"為雷電定道路。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"那時他看見智慧，而且述說；","poem":1},{"lineBreak":true},{"text":"他堅定，並且查究。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他對人說：敬畏主就是智慧；","poem":1},{"lineBreak":true},{"text":"遠離惡便是聰明。","poem":1}]}],"footnotes":[{"noteId":11,"caller":"-","text":"或譯：紅寶石","reference":{"chapter":28,"verse":18}}]},"thisChapterLink":"/api/cmn_cuv/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}