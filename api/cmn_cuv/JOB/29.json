{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":29,"content":[{"type":"heading","content":["約伯最後的申訴"]},{"type":"verse","number":1,"content":[{"text":"約伯又接着說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"惟願我的景況如從前的月份，","poem":1},{"lineBreak":true},{"text":"如上帝保守我的日子。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"那時他的燈照在我頭上；","poem":1},{"lineBreak":true},{"text":"我藉他的光行過黑暗。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我願如壯年的時候：","poem":1},{"lineBreak":true},{"text":"那時我在帳棚中，","poem":1},{"lineBreak":true},{"text":"上帝待我有密友之情；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"全能者仍與我同在；","poem":1},{"lineBreak":true},{"text":"我的兒女都環繞我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"奶多可洗我的腳；","poem":1},{"lineBreak":true},{"text":"磐石為我出油成河。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我出到城門，","poem":1},{"lineBreak":true},{"text":"在街上設立座位；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"少年人見我而迴避，","poem":1},{"lineBreak":true},{"text":"老年人也起身站立；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"王子都停止說話，","poem":1},{"lineBreak":true},{"text":"用手摀口；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"首領靜默無聲，","poem":1},{"lineBreak":true},{"text":"舌頭貼住上膛。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耳朵聽我的，就稱我有福；","poem":1},{"lineBreak":true},{"text":"眼睛看我的，便稱讚我；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因我拯救哀求的困苦人","poem":1},{"lineBreak":true},{"text":"和無人幫助的孤兒。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"將要滅亡的為我祝福；","poem":1},{"lineBreak":true},{"text":"我也使寡婦心中歡樂。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我以公義為衣服，","poem":1},{"lineBreak":true},{"text":"以公平為外袍和冠冕。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我為瞎子的眼，","poem":1},{"lineBreak":true},{"text":"瘸子的腳。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我為窮乏人的父；","poem":1},{"lineBreak":true},{"text":"素不認識的人，我查明他的案件。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我打破不義之人的牙床，","poem":1},{"lineBreak":true},{"text":"從他牙齒中奪了所搶的。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我便說：我必死在家中","poem":1},{"noteId":12},{"text":"，","poem":1},{"lineBreak":true},{"text":"必增添我的日子，多如塵沙。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的根長到水邊；","poem":1},{"lineBreak":true},{"text":"露水終夜霑在我的枝上。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我的榮耀在身上增新；","poem":1},{"lineBreak":true},{"text":"我的弓在手中日強。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"人聽見我而仰望，","poem":1},{"lineBreak":true},{"text":"靜默等候我的指教。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我說話之後，他們就不再說；","poem":1},{"lineBreak":true},{"text":"我的言語像雨露滴在他們身上。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他們仰望我如仰望雨，","poem":1},{"lineBreak":true},{"text":"又張開口如切慕春雨。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他們不敢自信，我就向他們含笑；","poem":1},{"lineBreak":true},{"text":"他們不使我臉上的光改變。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我為他們選擇道路，又坐首位；","poem":1},{"lineBreak":true},{"text":"我如君王在軍隊中居住，","poem":1},{"lineBreak":true},{"text":"又如弔喪的安慰傷心的人。","poem":1}]}],"footnotes":[{"noteId":12,"caller":"-","text":"原文是窩中","reference":{"chapter":29,"verse":18}}]},"thisChapterLink":"/api/cmn_cuv/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}