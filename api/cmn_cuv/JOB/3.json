{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":3,"content":[{"type":"heading","content":["約伯咒詛自己"]},{"type":"verse","number":1,"content":["此後，約伯開口咒詛自己的生日，"]},{"type":"verse","number":2,"content":["說："]},{"type":"verse","number":3,"content":[{"text":"願我生的那日","poem":1},{"lineBreak":true},{"text":"和說懷了男胎的那夜都滅沒。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"願那日變為黑暗；","poem":1},{"lineBreak":true},{"text":"願上帝不從上面尋找它；","poem":1},{"lineBreak":true},{"text":"願亮光不照於其上。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"願黑暗和死蔭索取那日；","poem":1},{"lineBreak":true},{"text":"願密雲停在其上；","poem":1},{"lineBreak":true},{"text":"願日蝕恐嚇它。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"願那夜被幽暗奪取，","poem":1},{"lineBreak":true},{"text":"不在年中的日子同樂，","poem":1},{"lineBreak":true},{"text":"也不入月中的數目。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"願那夜沒有生育，","poem":1},{"lineBreak":true},{"text":"其間也沒有歡樂的聲音。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"願那咒詛日子且能惹動鱷魚的","poem":1},{"lineBreak":true},{"text":"咒詛那夜。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"願那夜黎明的星宿變為黑暗，","poem":1},{"lineBreak":true},{"text":"盼亮卻不亮，","poem":1},{"lineBreak":true},{"text":"也不見早晨的光線","poem":1},{"noteId":1},{"text":"；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因沒有把懷我胎的門關閉，","poem":1},{"lineBreak":true},{"text":"也沒有將患難對我的眼隱藏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我為何不出母胎而死？","poem":1},{"lineBreak":true},{"text":"為何不出母腹絕氣？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"為何有膝接收我？","poem":1},{"lineBreak":true},{"text":"為何有奶哺養我？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"不然，我就早已躺臥安睡，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"和地上為自己重造荒邱的君王、謀士，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"或與有金子、將銀子裝滿了房屋的王子","poem":1},{"lineBreak":true},{"text":"一同安息；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"或像隱而未現、不到期而落的胎，","poem":1},{"lineBreak":true},{"text":"歸於無有，如同未見光的嬰孩。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"在那裏惡人止息攪擾，","poem":1},{"lineBreak":true},{"text":"困乏人得享安息，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"被囚的人同得安逸，","poem":1},{"lineBreak":true},{"text":"不聽見督工的聲音。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"大小都在那裏；","poem":1},{"lineBreak":true},{"text":"奴僕脫離主人的轄制。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"受患難的人為何有光賜給他呢？","poem":1},{"lineBreak":true},{"text":"心中愁苦的人為何有生命賜給他呢？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他們切望死，卻不得死；","poem":1},{"lineBreak":true},{"text":"求死，勝於求隱藏的珍寶。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他們尋見墳墓就快樂，","poem":1},{"lineBreak":true},{"text":"極其歡喜。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"人的道路既然遮隱，","poem":1},{"lineBreak":true},{"text":"上帝又把他四面圍困，","poem":1},{"lineBreak":true},{"text":"為何有光賜給他呢？","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我未曾吃飯就發出歎息；","poem":1},{"lineBreak":true},{"text":"我唉哼的聲音湧出如水。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"因我所恐懼的臨到我身，","poem":1},{"lineBreak":true},{"text":"我所懼怕的迎我而來。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我不得安逸，不得平靜，","poem":1},{"lineBreak":true},{"text":"也不得安息，卻有患難來到。","poem":1}]}],"footnotes":[{"noteId":1,"caller":"-","text":"原文是眼皮","reference":{"chapter":3,"verse":9}}]},"thisChapterLink":"/api/cmn_cuv/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}