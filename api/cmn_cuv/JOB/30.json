{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"但如今，比我年少的人戲笑我；","poem":1},{"lineBreak":true},{"text":"其人之父我曾藐視，","poem":1},{"lineBreak":true},{"text":"不肯安在看守我羊群的狗中。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他們壯年的氣力既已衰敗，","poem":1},{"lineBreak":true},{"text":"其手之力與我何益呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們因窮乏飢餓，身體枯瘦，","poem":1},{"lineBreak":true},{"text":"在荒廢淒涼的幽暗中齦乾燥之地，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"在草叢之中採鹹草，","poem":1},{"lineBreak":true},{"text":"羅騰","poem":1},{"noteId":13},{"text":"的根為他們的食物。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們從人中被趕出；","poem":1},{"lineBreak":true},{"text":"人追喊他們如賊一般，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"以致他們住在荒谷之間，","poem":1},{"lineBreak":true},{"text":"在地洞和巖穴中；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"在草叢中叫喚，","poem":1},{"lineBreak":true},{"text":"在荊棘下聚集。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"這都是愚頑下賤人的兒女；","poem":1},{"lineBreak":true},{"text":"他們被鞭打，趕出境外。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"現在這些人以我為歌曲，","poem":1},{"lineBreak":true},{"text":"以我為笑談。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們厭惡我，躲在旁邊站着，","poem":1},{"lineBreak":true},{"text":"不住地吐唾沫在我臉上。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"鬆開他們的繩索苦待我，","poem":1},{"lineBreak":true},{"text":"在我面前脫去轡頭。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"這等下流人在我右邊起來，","poem":1},{"lineBreak":true},{"text":"推開我的腳，築成戰路來攻擊我。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"這些無人幫助的，","poem":1},{"lineBreak":true},{"text":"毀壞我的道，加增我的災。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們來如同闖進大破口，","poem":1},{"lineBreak":true},{"text":"在毀壞之間滾在我身上。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"驚恐臨到我，","poem":1},{"lineBreak":true},{"text":"驅逐我的尊榮如風；","poem":1},{"lineBreak":true},{"text":"我的福祿如雲過去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"現在我心極其悲傷；","poem":1},{"lineBreak":true},{"text":"困苦的日子將我抓住。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"夜間，我裏面的骨頭刺我，","poem":1},{"lineBreak":true},{"text":"疼痛不止，好像齦我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因上帝的大力，我的外衣污穢不堪，","poem":1},{"lineBreak":true},{"text":"又如裏衣的領子將我纏住。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"上帝把我扔在淤泥中，","poem":1},{"lineBreak":true},{"text":"我就像塵土和爐灰一般。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"主啊，我呼求你，你不應允我；","poem":1},{"lineBreak":true},{"text":"我站起來，你就定睛看我。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你向我變心，待我殘忍，","poem":1},{"lineBreak":true},{"text":"又用大能追逼我，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"把我提在風中，使我駕風而行，","poem":1},{"lineBreak":true},{"text":"又使我消滅在烈風中。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我知道要使我臨到死地，","poem":1},{"lineBreak":true},{"text":"到那為眾生所定的陰宅。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"然而，人仆倒豈不伸手？","poem":1},{"lineBreak":true},{"text":"遇災難豈不求救呢？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"人遭難，我豈不為他哭泣呢？","poem":1},{"lineBreak":true},{"text":"人窮乏，我豈不為他憂愁呢？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我仰望得好處，災禍就到了；","poem":1},{"lineBreak":true},{"text":"我等待光明，黑暗便來了。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我心裏煩擾不安，","poem":1},{"lineBreak":true},{"text":"困苦的日子臨到我身。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我沒有日光就哀哭行去","poem":1},{"noteId":14},{"text":"；","poem":1},{"lineBreak":true},{"text":"我在會中站着求救。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我與野狗為弟兄，","poem":1},{"lineBreak":true},{"text":"與鴕鳥為同伴。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我的皮膚黑而脫落；","poem":1},{"lineBreak":true},{"text":"我的骨頭因熱燒焦。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"所以，我的琴音變為悲音；","poem":1},{"lineBreak":true},{"text":"我的簫聲變為哭聲。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"小樹名，松類","reference":{"chapter":30,"verse":4}},{"noteId":14,"caller":"-","text":"或譯：我面發黑並非因日曬","reference":{"chapter":30,"verse":28}}]},"thisChapterLink":"/api/cmn_cuv/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}