{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":[{"text":"我與眼睛立約，","poem":1},{"lineBreak":true},{"text":"怎能戀戀瞻望處女呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"從至上的上帝所得之分，","poem":1},{"lineBreak":true},{"text":"從至高全能者所得之業是甚麼呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"豈不是禍患臨到不義的，","poem":1},{"lineBreak":true},{"text":"災害臨到作孽的呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"上帝豈不是察看我的道路，","poem":1},{"lineBreak":true},{"text":"數點我的腳步呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我若與虛謊同行，","poem":1},{"lineBreak":true},{"text":"腳若追隨詭詐；","poem":1},{"lineBreak":true},{"text":"（","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我若被公道的天平稱度，","poem":1},{"lineBreak":true},{"text":"使上帝可以知道我的純正；）","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的腳步若偏離正路，","poem":1},{"lineBreak":true},{"text":"我的心若隨着我的眼目，","poem":1},{"lineBreak":true},{"text":"若有玷污粘在我手上；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"就願我所種的有別人吃，","poem":1},{"lineBreak":true},{"text":"我田所產的被拔出來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我若受迷惑，向婦人起淫念，","poem":1},{"lineBreak":true},{"text":"在鄰舍的門外蹲伏，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"就願我的妻子給別人推磨，","poem":1},{"lineBreak":true},{"text":"別人也與她同室。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因為這是大罪，","poem":1},{"lineBreak":true},{"text":"是審判官當罰的罪孽。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"這本是火焚燒，直到毀滅，","poem":1},{"lineBreak":true},{"text":"必拔除我所有的家產。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我的僕婢與我爭辯的時候，","poem":1},{"lineBreak":true},{"text":"我若藐視不聽他們的情節；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"上帝興起，我怎樣行呢？","poem":1},{"lineBreak":true},{"text":"他察問，我怎樣回答呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"造我在腹中的，不也是造他嗎？","poem":1},{"lineBreak":true},{"text":"將他與我摶在腹中的豈不是一位嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"我若不容貧寒人得其所願，","poem":1},{"lineBreak":true},{"text":"或叫寡婦眼中失望，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"或獨自吃我一點食物，","poem":1},{"lineBreak":true},{"text":"孤兒沒有與我同吃；","poem":1},{"lineBreak":true},{"text":"（","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"從幼年時孤兒與我同長，好像父子一樣；","poem":1},{"lineBreak":true},{"text":"我從出母腹就扶助","poem":1},{"noteId":15},{"text":"寡婦。）","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我若見人因無衣死亡，","poem":1},{"lineBreak":true},{"text":"或見窮乏人身無遮蓋；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我若不使他因我羊的毛得暖，","poem":1},{"lineBreak":true},{"text":"為我祝福；","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我若在城門口見有幫助我的，","poem":1},{"lineBreak":true},{"text":"舉手攻擊孤兒；","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"情願我的肩頭從缺盆骨脫落，","poem":1},{"lineBreak":true},{"text":"我的膀臂從羊矢骨折斷。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"因上帝降的災禍使我恐懼；","poem":1},{"lineBreak":true},{"text":"因他的威嚴，我不能妄為。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"我若以黃金為指望，","poem":1},{"lineBreak":true},{"text":"對精金說：你是我的倚靠；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我若因財物豐裕，","poem":1},{"lineBreak":true},{"text":"因我手多得資財而歡喜；","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我若見太陽發光，","poem":1},{"lineBreak":true},{"text":"明月行在空中，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"心就暗暗被引誘，","poem":1},{"lineBreak":true},{"text":"口便親手；","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"這也是審判官當罰的罪孽，","poem":1},{"lineBreak":true},{"text":"又是我背棄在上的上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"我若見恨我的遭報就歡喜，","poem":1},{"lineBreak":true},{"text":"見他遭災便高興；","poem":1},{"lineBreak":true},{"text":"（","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我沒有容口犯罪，","poem":1},{"lineBreak":true},{"text":"咒詛他的生命；）","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"若我帳棚的人未嘗說，","poem":1},{"lineBreak":true},{"text":"誰不以主人的食物吃飽呢？","poem":1},{"lineBreak":true},{"text":"（","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"從來我沒有容客旅在街上住宿，","poem":1},{"lineBreak":true},{"text":"卻開門迎接行路的人；）","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"我若像亞當","poem":1},{"noteId":16},{"text":"遮掩我的過犯，","poem":1},{"lineBreak":true},{"text":"將罪孽藏在懷中；","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"因懼怕大眾，","poem":1},{"lineBreak":true},{"text":"又因宗族藐視我使我驚恐，","poem":1},{"lineBreak":true},{"text":"以致閉口無言，杜門不出；","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"惟願有一位肯聽我！","poem":1},{"lineBreak":true},{"text":"（看哪，在這裏有我所劃的押，","poem":1},{"lineBreak":true},{"text":"願全能者回答我！）","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"願那敵我者所寫的狀詞在我這裏！","poem":1},{"lineBreak":true},{"text":"我必帶在肩上，又綁在頭上為冠冕。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"我必向他述說我腳步的數目，","poem":1},{"lineBreak":true},{"text":"必如君王進到他面前。","poem":1}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"我若奪取田地，這地向我喊冤，","poem":1},{"lineBreak":true},{"text":"犂溝一同哭泣；","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"我若吃地的出產不給價值，","poem":1},{"lineBreak":true},{"text":"或叫原主喪命；","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"願這地長蒺藜代替麥子，","poem":1},{"lineBreak":true},{"text":"長惡草代替大麥。","poem":1},{"lineBreak":true},{"text":"約伯的話說完了。","poem":1}]}],"footnotes":[{"noteId":15,"caller":"-","text":"原文是引領","reference":{"chapter":31,"verse":18}},{"noteId":16,"caller":"-","text":"或譯：別人","reference":{"chapter":31,"verse":33}}]},"thisChapterLink":"/api/cmn_cuv/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}