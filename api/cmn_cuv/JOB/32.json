{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":32,"content":[{"type":"heading","content":["以利戶的話"]},{"type":"verse","number":1,"content":["於是這三個人，因約伯自以為義就不再回答他。"]},{"type":"verse","number":2,"content":["那時有布西人蘭族巴拉迦的兒子以利戶向約伯發怒；因約伯自以為義，不以上帝為義。"]},{"type":"verse","number":3,"content":["他又向約伯的三個朋友發怒；因為他們想不出回答的話來，仍以約伯為有罪。"]},{"type":"verse","number":4,"content":["以利戶要與約伯說話，就等候他們，因為他們比自己年老。"]},{"type":"verse","number":5,"content":["以利戶見這三個人口中無話回答，就怒氣發作。"]},{"type":"verse","number":6,"content":["布西人巴拉迦的兒子以利戶回答說：",{"lineBreak":true},{"text":"我年輕，你們老邁；","poem":1},{"lineBreak":true},{"text":"因此我退讓，不敢向你們陳說我的意見。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我說，年老的當先說話；","poem":1},{"lineBreak":true},{"text":"壽高的當以智慧教訓人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"但在人裏面有靈；","poem":1},{"lineBreak":true},{"text":"全能者的氣使人有聰明。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"尊貴的不都有智慧；","poem":1},{"lineBreak":true},{"text":"壽高的不都能明白公平。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因此我說：你們要聽我言；","poem":1},{"lineBreak":true},{"text":"我也要陳說我的意見。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你們查究所要說的話；","poem":1},{"lineBreak":true},{"text":"那時我等候你們的話，","poem":1},{"lineBreak":true},{"text":"側耳聽你們的辯論，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"留心聽你們；","poem":1},{"lineBreak":true},{"text":"誰知你們中間無一人折服約伯，","poem":1},{"lineBreak":true},{"text":"駁倒他的話。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你們切不可說：我們尋得智慧；","poem":1},{"lineBreak":true},{"text":"上帝能勝他，人卻不能。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"約伯沒有向我爭辯；","poem":1},{"lineBreak":true},{"text":"我也不用你們的話回答他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"他們驚奇不再回答，","poem":1},{"lineBreak":true},{"text":"一言不發。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我豈因他們不說話，","poem":1},{"lineBreak":true},{"text":"站住不再回答，仍舊等候呢？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我也要回答我的一分話，","poem":1},{"lineBreak":true},{"text":"陳說我的意見。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因為我的言語滿懷；","poem":1},{"lineBreak":true},{"text":"我裏面的靈激動我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的胸懷如盛酒之囊沒有出氣之縫，","poem":1},{"lineBreak":true},{"text":"又如新皮袋快要破裂。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我要說話，使我舒暢；","poem":1},{"lineBreak":true},{"text":"我要開口回答。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我必不看人的情面，","poem":1},{"lineBreak":true},{"text":"也不奉承人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我不曉得奉承；","poem":1},{"lineBreak":true},{"text":"若奉承，造我的主必快快除滅我。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}