{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"約伯啊，請聽我的話，","poem":1},{"lineBreak":true},{"text":"留心聽我一切的言語。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我現在開口，","poem":1},{"lineBreak":true},{"text":"用舌發言。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的言語要發明心中所存的正直；","poem":1},{"lineBreak":true},{"text":"我所知道的，我嘴唇要誠實地說出。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"上帝的靈造我；","poem":1},{"lineBreak":true},{"text":"全能者的氣使我得生。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你若回答我，","poem":1},{"lineBreak":true},{"text":"就站起來，在我面前陳明。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我在上帝面前與你一樣，","poem":1},{"lineBreak":true},{"text":"也是用土造成。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我不用威嚴驚嚇你，","poem":1},{"lineBreak":true},{"text":"也不用勢力重壓你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你所說的，我聽見了，","poem":1},{"lineBreak":true},{"text":"也聽見你的言語，說：","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我是清潔無過的，我是無辜的；","poem":1},{"lineBreak":true},{"text":"在我裏面也沒有罪孽。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝找機會攻擊我，","poem":1},{"lineBreak":true},{"text":"以我為仇敵，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"把我的腳上了木狗，","poem":1},{"lineBreak":true},{"text":"窺察我一切的道路。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"我要回答你說：你這話無理，","poem":1},{"lineBreak":true},{"text":"因上帝比世人更大。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你為何與他爭論呢？","poem":1},{"lineBreak":true},{"text":"因他的事都不對人解說？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"上帝說一次、兩次，","poem":1},{"lineBreak":true},{"text":"世人卻不理會。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"人躺在床上沉睡的時候，","poem":1},{"lineBreak":true},{"text":"上帝就用夢和夜間的異象，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"開通他們的耳朵，","poem":1},{"lineBreak":true},{"text":"將當受的教訓印在他們心上，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"好叫人不從自己的謀算，","poem":1},{"lineBreak":true},{"text":"不行驕傲的事","poem":1},{"noteId":17},{"text":"，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"攔阻人不陷於坑裏，","poem":1},{"lineBreak":true},{"text":"不死在刀下。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"人在床上被懲治，","poem":1},{"lineBreak":true},{"text":"骨頭中不住地疼痛，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"以致他的口厭棄食物，","poem":1},{"lineBreak":true},{"text":"心厭惡美味。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他的肉消瘦，不得再見；","poem":1},{"lineBreak":true},{"text":"先前不見的骨頭都凸出來。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他的靈魂臨近深坑；","poem":1},{"lineBreak":true},{"text":"他的生命近於滅命的。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"一千天使中，","poem":1},{"lineBreak":true},{"text":"若有一個作傳話的與上帝同在，","poem":1},{"lineBreak":true},{"text":"指示人所當行的事，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"上帝就給他開恩，","poem":1},{"lineBreak":true},{"text":"說：救贖他免得下坑；","poem":1},{"lineBreak":true},{"text":"我已經得了贖價。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他的肉要比孩童的肉更嫩；","poem":1},{"lineBreak":true},{"text":"他就返老還童。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他禱告上帝，","poem":1},{"lineBreak":true},{"text":"上帝就喜悅他，","poem":1},{"lineBreak":true},{"text":"使他歡呼朝見上帝的面；","poem":1},{"lineBreak":true},{"text":"上帝又看他為義。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他在人前歌唱說：","poem":1},{"lineBreak":true},{"text":"我犯了罪，顛倒是非，","poem":1},{"lineBreak":true},{"text":"這竟與我無益。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"上帝救贖我的靈魂免入深坑；","poem":1},{"lineBreak":true},{"text":"我的生命也必見光。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"上帝兩次、三次向人行這一切的事，","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"為要從深坑救回人的靈魂，","poem":1},{"lineBreak":true},{"text":"使他被光照耀，與活人一樣。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"約伯啊，你當側耳聽我的話，","poem":1},{"lineBreak":true},{"text":"不要作聲，等我講說。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"你若有話說，就可以回答我；","poem":1},{"lineBreak":true},{"text":"你只管說，因我願以你為是。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"若不然，你就聽我說；","poem":1},{"lineBreak":true},{"text":"你不要作聲，我便將智慧教訓你。","poem":1}]}],"footnotes":[{"noteId":17,"caller":"-","text":"原文是將驕傲向人隱藏","reference":{"chapter":33,"verse":17}}]},"thisChapterLink":"/api/cmn_cuv/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}