{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":[{"text":"以利戶又說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們智慧人要聽我的話；","poem":1},{"lineBreak":true},{"text":"有知識的人要留心聽我說。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為耳朵試驗話語，","poem":1},{"lineBreak":true},{"text":"好像上膛嘗食物。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我們當選擇何為是，","poem":1},{"lineBreak":true},{"text":"彼此知道何為善。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"約伯曾說：我是公義，","poem":1},{"lineBreak":true},{"text":"上帝奪去我的理；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我雖有理，還算為說謊言的；","poem":1},{"lineBreak":true},{"text":"我雖無過，受的傷還不能醫治。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"誰像約伯，","poem":1},{"lineBreak":true},{"text":"喝譏誚如同喝水呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他與作孽的結伴，","poem":1},{"lineBreak":true},{"text":"和惡人同行。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他說：人以上帝為樂，","poem":1},{"lineBreak":true},{"text":"總是無益。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"所以，你們明理的人要聽我的話。","poem":1},{"lineBreak":true},{"text":"上帝斷不致行惡；","poem":1},{"lineBreak":true},{"text":"全能者斷不致作孽。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他必按人所做的報應人，","poem":1},{"lineBreak":true},{"text":"使各人照所行的得報。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"上帝必不作惡；","poem":1},{"lineBreak":true},{"text":"全能者也不偏離公平。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"誰派他治理地，","poem":1},{"lineBreak":true},{"text":"安定全世界呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他若專心為己，","poem":1},{"lineBreak":true},{"text":"將靈和氣收歸自己，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"凡有血氣的就必一同死亡；","poem":1},{"lineBreak":true},{"text":"世人必仍歸塵土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"你若明理，就當聽我的話，","poem":1},{"lineBreak":true},{"text":"留心聽我言語的聲音。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"難道恨惡公平的可以掌權嗎？","poem":1},{"lineBreak":true},{"text":"那有公義的、有大能的，豈可定他有罪嗎？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他對君王說：你是鄙陋的；","poem":1},{"lineBreak":true},{"text":"對貴臣說：你是邪惡的。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他待王子不徇情面，","poem":1},{"lineBreak":true},{"text":"也不看重富足的過於貧窮的，","poem":1},{"lineBreak":true},{"text":"因為都是他手所造。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"在轉眼之間，半夜之中，","poem":1},{"lineBreak":true},{"text":"他們就死亡。","poem":1},{"lineBreak":true},{"text":"百姓被震動而去世；","poem":1},{"lineBreak":true},{"text":"有權力的被奪去非借人手。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"上帝注目觀看人的道路，","poem":1},{"lineBreak":true},{"text":"看明人的腳步。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"沒有黑暗、陰翳能給作孽的藏身。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"上帝審判人，不必使人到他面前再三鑒察。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他用難測之法打破有能力的人，","poem":1},{"lineBreak":true},{"text":"設立別人代替他們。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他原知道他們的行為，","poem":1},{"lineBreak":true},{"text":"使他們在夜間傾倒滅亡。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他在眾人眼前擊打他們，","poem":1},{"lineBreak":true},{"text":"如同擊打惡人一樣。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"因為他們偏行不跟從他，","poem":1},{"lineBreak":true},{"text":"也不留心他的道，","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"甚至使貧窮人的哀聲達到他那裏；","poem":1},{"lineBreak":true},{"text":"他也聽了困苦人的哀聲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"他使人安靜，誰能擾亂","poem":1},{"noteId":18},{"text":"呢？","poem":1},{"lineBreak":true},{"text":"他掩面，誰能見他呢？","poem":1},{"lineBreak":true},{"text":"無論待一國或一人都是如此－","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"使不虔敬的人不得作王，","poem":1},{"lineBreak":true},{"text":"免得有人牢籠百姓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"有誰對上帝說：","poem":1},{"lineBreak":true},{"text":"我受了責罰，不再犯罪；","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我所看不明的，求你指教我；","poem":1},{"lineBreak":true},{"text":"我若作了孽，必不再作？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他施行報應，","poem":1},{"lineBreak":true},{"text":"豈要隨你的心願、叫你推辭不受嗎？","poem":1},{"lineBreak":true},{"text":"選定的是你，不是我。","poem":1},{"lineBreak":true},{"text":"你所知道的只管說吧！","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"明理的人和聽我話的智慧人必對我說：","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"約伯說話沒有知識，","poem":1},{"lineBreak":true},{"text":"言語中毫無智慧。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"願約伯被試驗到底，","poem":1},{"lineBreak":true},{"text":"因他回答像惡人一樣。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"他在罪上又加悖逆；","poem":1},{"lineBreak":true},{"text":"在我們中間拍手，","poem":1},{"lineBreak":true},{"text":"用許多言語輕慢上帝。","poem":1}]}],"footnotes":[{"noteId":18,"caller":"-","text":"或譯：定罪","reference":{"chapter":34,"verse":29}}]},"thisChapterLink":"/api/cmn_cuv/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}