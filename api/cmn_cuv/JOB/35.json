{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":[{"text":"以利戶又說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你以為有理，","poem":1},{"lineBreak":true},{"text":"或以為你的公義勝於上帝的公義，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"才說這與我有甚麼益處？","poem":1},{"lineBreak":true},{"text":"我不犯罪比犯罪有甚麼好處呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要回答你和在你這裏的朋友。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你要向天觀看，","poem":1},{"lineBreak":true},{"text":"瞻望那高於你的穹蒼。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你若犯罪，能使上帝受何害呢？","poem":1},{"lineBreak":true},{"text":"你的過犯加增，能使上帝受何損呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你若是公義，還能加增他甚麼呢？","poem":1},{"lineBreak":true},{"text":"他從你手裏還接受甚麼呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你的過惡或能害你這類的人；","poem":1},{"lineBreak":true},{"text":"你的公義或能叫世人得益處。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"人因多受欺壓就哀求，","poem":1},{"lineBreak":true},{"text":"因受能者的轄制","poem":1},{"noteId":19},{"text":"便求救，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"卻無人說：造我的上帝在哪裏？","poem":1},{"lineBreak":true},{"text":"他使人夜間歌唱，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"教訓我們勝於地上的走獸，","poem":1},{"lineBreak":true},{"text":"使我們有聰明勝於空中的飛鳥。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們在那裏，","poem":1},{"lineBreak":true},{"text":"因惡人的驕傲呼求，卻無人答應。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"虛妄的呼求，上帝必不垂聽；","poem":1},{"lineBreak":true},{"text":"全能者也必不眷顧。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"何況你說，你不得見他；","poem":1},{"lineBreak":true},{"text":"你的案件在他面前，你等候他吧。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"但如今因他未曾發怒降罰，","poem":1},{"lineBreak":true},{"text":"也不甚理會狂傲，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"所以約伯開口說虛妄的話，","poem":1},{"lineBreak":true},{"text":"多發無知識的言語。","poem":1}]}],"footnotes":[{"noteId":19,"caller":"-","text":"原文是膀臂","reference":{"chapter":35,"verse":9}}]},"thisChapterLink":"/api/cmn_cuv/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}