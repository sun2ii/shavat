{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":[{"text":"以利戶又接着說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你再容我片時，我就指示你，","poem":1},{"lineBreak":true},{"text":"因我還有話為上帝說。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我要將所知道的從遠處引來，","poem":1},{"lineBreak":true},{"text":"將公義歸給造我的主。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的言語真不虛謊；","poem":1},{"lineBreak":true},{"text":"有知識全備的與你同在。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"上帝有大能，並不藐視人；","poem":1},{"lineBreak":true},{"text":"他的智慧甚廣。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他不保護惡人的性命，","poem":1},{"lineBreak":true},{"text":"卻為困苦人伸冤。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他時常看顧義人，","poem":1},{"lineBreak":true},{"text":"使他們和君王同坐寶座，","poem":1},{"lineBreak":true},{"text":"永遠要被高舉。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們若被鎖鍊捆住，","poem":1},{"lineBreak":true},{"text":"被苦難的繩索纏住，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他就把他們的作為和過犯指示他們，","poem":1},{"lineBreak":true},{"text":"叫他們知道有驕傲的行動。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他也開通他們的耳朵得受教訓，","poem":1},{"lineBreak":true},{"text":"吩咐他們離開罪孽轉回。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們若聽從事奉他，","poem":1},{"lineBreak":true},{"text":"就必度日亨通，歷年福樂；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"若不聽從，","poem":1},{"lineBreak":true},{"text":"就要被刀殺滅，無知無識而死。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"那心中不敬虔的人積蓄怒氣；","poem":1},{"lineBreak":true},{"text":"上帝捆綁他們，他們竟不求救；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"必在青年時死亡，","poem":1},{"lineBreak":true},{"text":"與污穢人一樣喪命。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"上帝藉着困苦救拔困苦人，","poem":1},{"lineBreak":true},{"text":"趁他們受欺壓開通他們的耳朵。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"上帝也必引你出離患難，","poem":1},{"lineBreak":true},{"text":"進入寬闊不狹窄之地；","poem":1},{"lineBreak":true},{"text":"擺在你席上的必滿有肥甘。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"但你滿口有惡人批評的言語；","poem":1},{"lineBreak":true},{"text":"判斷和刑罰抓住你。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"不可容忿怒觸動你，使你不服責罰；","poem":1},{"lineBreak":true},{"text":"也不可因贖價大就偏行。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你的呼求","poem":1},{"noteId":20},{"text":"，或是你一切的勢力，","poem":1},{"lineBreak":true},{"text":"果有靈驗，叫你不受患難嗎？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"不要切慕黑夜，","poem":1},{"lineBreak":true},{"text":"就是眾民在本處被除滅的時候。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你要謹慎，不可重看罪孽，","poem":1},{"lineBreak":true},{"text":"因你選擇罪孽過於選擇苦難。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"上帝行事有高大的能力；","poem":1},{"lineBreak":true},{"text":"教訓人的有誰像他呢？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"誰派定他的道路？","poem":1},{"lineBreak":true},{"text":"誰能說：你所行的不義？","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"你不可忘記稱讚他所行的為大，","poem":1},{"lineBreak":true},{"text":"就是人所歌頌的。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他所行的，萬人都看見；","poem":1},{"lineBreak":true},{"text":"世人也從遠處觀看。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"上帝為大，我們不能全知；","poem":1},{"lineBreak":true},{"text":"他的年數不能測度。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他吸取水點，","poem":1},{"lineBreak":true},{"text":"這水點從雲霧中就變成雨；","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"雲彩將雨落下，沛然降與世人。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"誰能明白雲彩如何鋪張，","poem":1},{"lineBreak":true},{"text":"和上帝行宮的雷聲呢？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他將亮光普照在自己的四圍；","poem":1},{"lineBreak":true},{"text":"他又遮覆海底。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他用這些審判眾民，","poem":1},{"lineBreak":true},{"text":"且賜豐富的糧食。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他以電光遮手，","poem":1},{"lineBreak":true},{"text":"命閃電擊中敵人","poem":1},{"noteId":21},{"text":"。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"所發的雷聲顯明他的作為，","poem":1},{"lineBreak":true},{"text":"又向牲畜指明要起暴風。","poem":1}]}],"footnotes":[{"noteId":20,"caller":"-","text":"或譯：資財","reference":{"chapter":36,"verse":19}},{"noteId":21,"caller":"-","text":"或譯：中了靶子","reference":{"chapter":36,"verse":32}}]},"thisChapterLink":"/api/cmn_cuv/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}