{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"因此我心戰兢，","poem":1},{"lineBreak":true},{"text":"從原處移動。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"聽啊，上帝轟轟的聲音","poem":1},{"lineBreak":true},{"text":"是他口中所發的響聲。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他發響聲震遍天下，","poem":1},{"lineBreak":true},{"text":"發電光閃到地極。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"隨後人聽見有雷聲轟轟，大發威嚴，","poem":1},{"lineBreak":true},{"text":"雷電接連不斷。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝發出奇妙的雷聲；","poem":1},{"lineBreak":true},{"text":"他行大事，我們不能測透。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他對雪說：要降在地上；","poem":1},{"lineBreak":true},{"text":"對大雨和暴雨也是這樣說。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他封住各人的手，","poem":1},{"lineBreak":true},{"text":"叫所造的萬人都曉得他的作為。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"百獸進入穴中，","poem":1},{"lineBreak":true},{"text":"臥在洞內。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"暴風出於南宮；","poem":1},{"lineBreak":true},{"text":"寒冷出於北方。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝噓氣成冰；","poem":1},{"lineBreak":true},{"text":"寬闊之水也都凝結。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他使密雲盛滿水氣，","poem":1},{"lineBreak":true},{"text":"布散電光之雲；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"這雲是藉他的指引游行旋轉，","poem":1},{"lineBreak":true},{"text":"得以在全地面上行他一切所吩咐的，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"或為責罰，或為潤地，","poem":1},{"lineBreak":true},{"text":"或為施行慈愛。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"約伯啊，你要留心聽，","poem":1},{"lineBreak":true},{"text":"要站立思想上帝奇妙的作為。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"上帝如何吩咐這些，","poem":1},{"lineBreak":true},{"text":"如何使雲中的電光照耀，你知道嗎？","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"雲彩如何浮於空中，","poem":1},{"lineBreak":true},{"text":"那知識全備者奇妙的作為，你知道嗎？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"南風使地寂靜，","poem":1},{"lineBreak":true},{"text":"你的衣服就如火熱，你知道嗎？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你豈能與上帝同鋪穹蒼嗎？","poem":1},{"lineBreak":true},{"text":"這穹蒼堅硬，如同鑄成的鏡子。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我們愚昧不能陳說；","poem":1},{"lineBreak":true},{"text":"請你指教我們該對他說甚麼話。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"人豈可說：我願與他說話？","poem":1},{"lineBreak":true},{"text":"豈有人自願滅亡嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"現在有雲遮蔽，人不得見穹蒼的光亮；","poem":1},{"lineBreak":true},{"text":"但風吹過，天又發晴。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"金光出於北方，","poem":1},{"lineBreak":true},{"text":"在上帝那裏有可怕的威嚴。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"論到全能者，我們不能測度；","poem":1},{"lineBreak":true},{"text":"他大有能力，有公平和大義，","poem":1},{"lineBreak":true},{"text":"必不苦待人。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"所以，人敬畏他；","poem":1},{"lineBreak":true},{"text":"凡自以為心中有智慧的人，他都不顧念。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}