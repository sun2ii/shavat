{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":38,"content":[{"type":"heading","content":["耶和華回答約伯"]},{"type":"verse","number":1,"content":[{"text":"那時，耶和華從旋風中回答約伯說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"誰用無知的言語使我的旨意暗昧不明？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你要如勇士束腰；","poem":1},{"lineBreak":true},{"text":"我問你，你可以指示我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我立大地根基的時候，你在哪裏呢？","poem":1},{"lineBreak":true},{"text":"你若有聰明，只管說吧！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你若曉得就說，是誰定地的尺度？","poem":1},{"lineBreak":true},{"text":"是誰把準繩拉在其上？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"地的根基安置在何處？","poem":1},{"lineBreak":true},{"text":"地的角石是誰安放的？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"那時，晨星一同歌唱；","poem":1},{"lineBreak":true},{"text":"上帝的眾子也都歡呼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"海水衝出，如出胎胞，","poem":1},{"lineBreak":true},{"text":"那時誰將它關閉呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"是我用雲彩當海的衣服，","poem":1},{"lineBreak":true},{"text":"用幽暗當包裹它的布，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"為它定界限，","poem":1},{"lineBreak":true},{"text":"又安門和閂，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"說：你只可到這裏，不可越過；","poem":1},{"lineBreak":true},{"text":"你狂傲的浪要到此止住。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"你自生以來，曾命定晨光，","poem":1},{"lineBreak":true},{"text":"使清晨的日光知道本位，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"叫這光普照地的四極，","poem":1},{"lineBreak":true},{"text":"將惡人從其中驅逐出來嗎？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因這光，地面改變如泥上印印，","poem":1},{"lineBreak":true},{"text":"萬物出現如衣服一樣。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"亮光不照惡人；","poem":1},{"lineBreak":true},{"text":"強橫的膀臂也必折斷。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"你曾進到海源，","poem":1},{"lineBreak":true},{"text":"或在深淵的隱密處行走嗎？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"死亡的門曾向你顯露嗎？","poem":1},{"lineBreak":true},{"text":"死蔭的門你曾見過嗎？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"地的廣大你能明透嗎？","poem":1},{"lineBreak":true},{"text":"你若全知道，只管說吧！","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"光明的居所從何而至？","poem":1},{"lineBreak":true},{"text":"黑暗的本位在於何處？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你能帶到本境，","poem":1},{"lineBreak":true},{"text":"能看明其室之路嗎？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你總知道，","poem":1},{"lineBreak":true},{"text":"因為你早已生在世上，","poem":1},{"lineBreak":true},{"text":"你日子的數目也多。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"你曾進入雪庫，","poem":1},{"lineBreak":true},{"text":"或見過雹倉嗎？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"這雪雹乃是我為降災，","poem":1},{"lineBreak":true},{"text":"並打仗和爭戰的日子所預備的。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"光亮從何路分開？","poem":1},{"lineBreak":true},{"text":"東風從何路分散遍地？","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"誰為雨水分道？","poem":1},{"lineBreak":true},{"text":"誰為雷電開路？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"使雨降在無人之地、","poem":1},{"lineBreak":true},{"text":"無人居住的曠野？","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"使荒廢淒涼之地得以豐足，","poem":1},{"lineBreak":true},{"text":"青草得以發生？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"雨有父嗎？","poem":1},{"lineBreak":true},{"text":"露水珠是誰生的呢？","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"冰出於誰的胎？","poem":1},{"lineBreak":true},{"text":"天上的霜是誰生的呢？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"諸水堅硬","poem":1},{"noteId":22},{"text":"如石頭；","poem":1},{"lineBreak":true},{"text":"深淵之面凝結成冰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"你能繫住昴星的結嗎？","poem":1},{"lineBreak":true},{"text":"能解開參星的帶嗎？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"你能按時領出十二宮嗎？","poem":1},{"lineBreak":true},{"text":"能引導北斗和隨它的眾星","poem":1},{"noteId":23},{"text":"嗎？","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"你知道天的定例嗎？","poem":1},{"lineBreak":true},{"text":"能使地歸在天的權下嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"你能向雲彩揚起聲來，","poem":1},{"lineBreak":true},{"text":"使傾盆的雨遮蓋你嗎？","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"你能發出閃電，叫它行去，","poem":1},{"lineBreak":true},{"text":"使它對你說：我們在這裏？","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"誰將智慧放在懷中？","poem":1},{"lineBreak":true},{"text":"誰將聰明賜於心內？","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"誰能用智慧數算雲彩呢？","poem":1},{"lineBreak":true},{"text":"塵土聚集成團，土塊緊緊結連；","poem":1},{"lineBreak":true},{"text":"那時，誰能傾倒天上的瓶呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"母獅子在洞中蹲伏，","poem":1},{"lineBreak":true},{"text":"少壯獅子在隱密處埋伏；","poem":1},{"lineBreak":true},{"text":"你能為牠們抓取食物，","poem":1},{"lineBreak":true},{"text":"使牠們飽足嗎？","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"烏鴉之雛因無食物飛來飛去，哀告上帝；","poem":1},{"lineBreak":true},{"text":"那時，誰為牠預備食物呢？","poem":1}]}],"footnotes":[{"noteId":22,"caller":"-","text":"或譯：隱藏","reference":{"chapter":38,"verse":30}},{"noteId":23,"caller":"-","text":"星：原文是子","reference":{"chapter":38,"verse":32}}]},"thisChapterLink":"/api/cmn_cuv/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":39}