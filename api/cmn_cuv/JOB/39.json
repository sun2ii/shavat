{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"山巖間的野山羊幾時生產，你知道嗎？","poem":1},{"lineBreak":true},{"text":"母鹿下犢之期，你能察定嗎？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"牠們懷胎的月數，你能數算嗎？","poem":1},{"lineBreak":true},{"text":"牠們幾時生產，你能曉得嗎？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"牠們屈身，將子生下，","poem":1},{"lineBreak":true},{"text":"就除掉疼痛。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"這子漸漸肥壯，在荒野長大，","poem":1},{"lineBreak":true},{"text":"去而不回。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"誰放野驢出去自由？","poem":1},{"lineBreak":true},{"text":"誰解開快驢的繩索？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我使曠野作牠的住處，","poem":1},{"lineBreak":true},{"text":"使鹹地當牠的居所。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"牠嗤笑城內的喧嚷，","poem":1},{"lineBreak":true},{"text":"不聽趕牲口的喝聲。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"遍山是牠的草場；","poem":1},{"lineBreak":true},{"text":"牠尋找各樣青綠之物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"野牛豈肯服事你？","poem":1},{"lineBreak":true},{"text":"豈肯住在你的槽旁？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你豈能用套繩將野牛籠在犂溝之間？","poem":1},{"lineBreak":true},{"text":"牠豈肯隨你耙山谷之地？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"豈可因牠的力大就倚靠牠？","poem":1},{"lineBreak":true},{"text":"豈可把你的工交給牠做嗎？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"豈可信靠牠把你的糧食運到家，","poem":1},{"lineBreak":true},{"text":"又收聚你禾場上的穀嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"鴕鳥的翅膀歡然搧展，","poem":1},{"lineBreak":true},{"text":"豈是顯慈愛的翎毛和羽毛嗎？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因牠把蛋留在地上，","poem":1},{"lineBreak":true},{"text":"在塵土中使得溫暖；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"卻想不到被腳踹碎，","poem":1},{"lineBreak":true},{"text":"或被野獸踐踏。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"牠忍心待雛，似乎不是自己的；","poem":1},{"lineBreak":true},{"text":"雖然徒受勞苦，也不為雛懼怕；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因為上帝使牠沒有智慧，","poem":1},{"lineBreak":true},{"text":"也未將悟性賜給牠。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"牠幾時挺身展開翅膀，","poem":1},{"lineBreak":true},{"text":"就嗤笑馬和騎馬的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"馬的大力是你所賜的嗎？","poem":1},{"lineBreak":true},{"text":"牠頸項上挓挲的誃是你給牠披上的嗎？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"是你叫牠跳躍像蝗蟲嗎？","poem":1},{"lineBreak":true},{"text":"牠噴氣之威使人驚惶。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"牠在谷中刨地，自喜其力；","poem":1},{"lineBreak":true},{"text":"牠出去迎接佩帶兵器的人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"牠嗤笑可怕的事並不驚惶，","poem":1},{"lineBreak":true},{"text":"也不因刀劍退回。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"箭袋和發亮的槍，","poem":1},{"lineBreak":true},{"text":"並短槍在牠身上錚錚有聲。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"牠發猛烈的怒氣將地吞下；","poem":1},{"lineBreak":true},{"text":"一聽角聲就不耐站立。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"角每發聲，牠說呵哈；","poem":1},{"lineBreak":true},{"text":"牠從遠處聞着戰氣，","poem":1},{"lineBreak":true},{"text":"又聽見軍長大發雷聲和兵丁吶喊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"鷹雀飛翔，展開翅膀一直向南，","poem":1},{"lineBreak":true},{"text":"豈是藉你的智慧嗎？","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"大鷹上騰在高處搭窩，","poem":1},{"lineBreak":true},{"text":"豈是聽你的吩咐嗎？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"牠住在山巖，","poem":1},{"lineBreak":true},{"text":"以山峰和堅固之所為家，","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"從那裏窺看食物，","poem":1},{"lineBreak":true},{"text":"眼睛遠遠觀望。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"牠的雛也咂血；","poem":1},{"lineBreak":true},{"text":"被殺的人在哪裏，牠也在那裏。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}