{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":4,"content":[{"type":"heading","content":["第一次對話"]},{"type":"verse","number":1,"content":[{"text":"提幔人以利法回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"人若想與你說話，你就厭煩嗎？","poem":1},{"lineBreak":true},{"text":"但誰能忍住不說呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你素來教導許多的人，","poem":1},{"lineBreak":true},{"text":"又堅固軟弱的手。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的言語曾扶助那將要跌倒的人；","poem":1},{"lineBreak":true},{"text":"你又使軟弱的膝穩固。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但現在禍患臨到你，你就昏迷，","poem":1},{"lineBreak":true},{"text":"挨近你，你便驚惶。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你的倚靠不是在你敬畏上帝嗎？","poem":1},{"lineBreak":true},{"text":"你的盼望不是在你行事純正嗎？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"請你追想：無辜的人有誰滅亡？","poem":1},{"lineBreak":true},{"text":"正直的人在何處剪除？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"按我所見，耕罪孽、種毒害的人","poem":1},{"lineBreak":true},{"text":"都照樣收割。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"上帝一出氣，他們就滅亡；","poem":1},{"lineBreak":true},{"text":"上帝一發怒，他們就消沒。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"獅子的吼叫和猛獅的聲音盡都止息；","poem":1},{"lineBreak":true},{"text":"少壯獅子的牙齒也都敲掉。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"老獅子因絕食而死；","poem":1},{"lineBreak":true},{"text":"母獅之子也都離散。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"我暗暗地得了默示；","poem":1},{"lineBreak":true},{"text":"我耳朵也聽其細微的聲音。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"在思念夜中、異象之間，","poem":1},{"lineBreak":true},{"text":"世人沉睡的時候，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"恐懼、戰兢臨到我身，","poem":1},{"lineBreak":true},{"text":"使我百骨打戰。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"有靈從我面前經過，","poem":1},{"lineBreak":true},{"text":"我身上的毫毛直立。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"那靈停住，","poem":1},{"lineBreak":true},{"text":"我卻不能辨其形狀；","poem":1},{"lineBreak":true},{"text":"有影像在我眼前。","poem":1},{"lineBreak":true},{"text":"我在靜默中聽見有聲音說：","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"必死的人豈能比上帝公義嗎？","poem":1},{"lineBreak":true},{"text":"人豈能比造他的主潔淨嗎？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"主不信靠他的臣僕，","poem":1},{"lineBreak":true},{"text":"並且指他的使者為愚昧；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"何況那住在土房、根基在塵土裏、","poem":1},{"lineBreak":true},{"text":"被蠹蟲所毀壞的人呢？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"早晚之間，就被毀滅，","poem":1},{"lineBreak":true},{"text":"永歸無有，無人理會。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他帳棚的繩索豈不從中抽出來呢？","poem":1},{"lineBreak":true},{"text":"他死，且是無智慧而死。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}