{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":[{"text":"耶和華又對約伯說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"強辯的豈可與全能者爭論嗎？","poem":1},{"lineBreak":true},{"text":"與上帝辯駁的可以回答這些吧！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"於是，約伯回答耶和華說：","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我是卑賤的！我用甚麼回答你呢？","poem":1},{"lineBreak":true},{"text":"只好用手摀口。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我說了一次，再不回答；","poem":1},{"lineBreak":true},{"text":"說了兩次，就不再說。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"於是，耶和華從旋風中回答約伯說：","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你要如勇士束腰；","poem":1},{"lineBreak":true},{"text":"我問你，你可以指示我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你豈可廢棄我所擬定的？","poem":1},{"lineBreak":true},{"text":"豈可定我有罪，好顯自己為義嗎？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你有上帝那樣的膀臂嗎？","poem":1},{"lineBreak":true},{"text":"你能像他發雷聲嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你要以榮耀莊嚴為妝飾，","poem":1},{"lineBreak":true},{"text":"以尊榮威嚴為衣服；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"要發出你滿溢的怒氣，","poem":1},{"lineBreak":true},{"text":"見一切驕傲的人，使他降卑；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"見一切驕傲的人，將他制伏，","poem":1},{"lineBreak":true},{"text":"把惡人踐踏在本處；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"將他們一同隱藏在塵土中，","poem":1},{"lineBreak":true},{"text":"把他們的臉蒙蔽在隱密處；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我就認你右手能以救自己。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"你且觀看河馬；","poem":1},{"lineBreak":true},{"text":"我造你也造牠。","poem":1},{"lineBreak":true},{"text":"牠吃草與牛一樣；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"牠的氣力在腰間，","poem":1},{"lineBreak":true},{"text":"能力在肚腹的筋上。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"牠搖動尾巴如香柏樹；","poem":1},{"lineBreak":true},{"text":"牠大腿的筋互相聯絡。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"牠的骨頭好像銅管；","poem":1},{"lineBreak":true},{"text":"牠的肢體彷彿鐵棍。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"牠在上帝所造的物中為首；","poem":1},{"lineBreak":true},{"text":"創造牠的給牠刀劍。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"諸山給牠出食物，","poem":1},{"lineBreak":true},{"text":"也是百獸遊玩之處。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"牠伏在蓮葉之下，","poem":1},{"lineBreak":true},{"text":"臥在蘆葦隱密處和水窪子裏。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"蓮葉的陰涼遮蔽牠；","poem":1},{"lineBreak":true},{"text":"溪旁的柳樹環繞牠。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"河水泛濫，牠不發戰；","poem":1},{"lineBreak":true},{"text":"就是約旦河的水漲到牠口邊，也是安然。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"在牠防備的時候，誰能捉拿牠？","poem":1},{"lineBreak":true},{"text":"誰能牢籠牠穿牠的鼻子呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}