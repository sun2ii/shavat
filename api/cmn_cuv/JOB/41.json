{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"你能用魚鉤釣上鱷魚嗎？","poem":1},{"lineBreak":true},{"text":"能用繩子壓下牠的舌頭嗎？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你能用繩索穿牠的鼻子嗎？","poem":1},{"lineBreak":true},{"text":"能用鉤穿牠的腮骨嗎？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"牠豈向你連連懇求，","poem":1},{"lineBreak":true},{"text":"說柔和的話嗎？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"豈肯與你立約，","poem":1},{"lineBreak":true},{"text":"使你拿牠永遠作奴僕嗎？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你豈可拿牠當雀鳥玩耍嗎？","poem":1},{"lineBreak":true},{"text":"豈可為你的幼女將牠拴住嗎？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"搭夥的漁夫豈可拿牠當貨物嗎？","poem":1},{"lineBreak":true},{"text":"能把牠分給商人嗎？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你能用倒鉤槍扎滿牠的皮，","poem":1},{"lineBreak":true},{"text":"能用魚叉叉滿牠的頭嗎？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你按手在牠身上，想與牠爭戰，","poem":1},{"lineBreak":true},{"text":"就不再這樣行吧！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"人指望捉拿牠是徒然的；","poem":1},{"lineBreak":true},{"text":"一見牠，豈不喪膽嗎？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"沒有那麼兇猛的人敢惹牠。","poem":1},{"lineBreak":true},{"text":"這樣，誰能在我面前站立得住呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"誰先給我甚麼，使我償還呢？","poem":1},{"lineBreak":true},{"text":"天下萬物都是我的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"論到鱷魚的肢體和其大力，並美好的骨骼，","poem":1},{"lineBreak":true},{"text":"我不能緘默不言。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"誰能剝牠的外衣？","poem":1},{"lineBreak":true},{"text":"誰能進牠上下牙骨之間呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"誰能開牠的腮頰？","poem":1},{"lineBreak":true},{"text":"牠牙齒四圍是可畏的。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"牠以堅固的鱗甲為可誇，","poem":1},{"lineBreak":true},{"text":"緊緊合閉，封得嚴密。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"這鱗甲一一相連，","poem":1},{"lineBreak":true},{"text":"甚至氣不得透入其間，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"都是互相聯絡、膠結，","poem":1},{"lineBreak":true},{"text":"不能分離。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"牠打噴嚏就發出光來；","poem":1},{"lineBreak":true},{"text":"牠眼睛好像早晨的光線","poem":1},{"noteId":24},{"text":"。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"從牠口中發出燒着的火把，","poem":1},{"lineBreak":true},{"text":"與飛迸的火星；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"從牠鼻孔冒出煙來，","poem":1},{"lineBreak":true},{"text":"如燒開的鍋和點着的蘆葦。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"牠的氣點着煤炭，","poem":1},{"lineBreak":true},{"text":"有火焰從牠口中發出。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"牠頸項中存着勁力；","poem":1},{"lineBreak":true},{"text":"在牠面前的都恐嚇蹦跳。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"牠的肉塊互相聯絡，","poem":1},{"lineBreak":true},{"text":"緊貼其身，不能搖動。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"牠的心結實如石頭，","poem":1},{"lineBreak":true},{"text":"如下磨石那樣結實。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"牠一起來，勇士都驚恐，","poem":1},{"lineBreak":true},{"text":"心裏慌亂，便都昏迷。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"人若用刀，用槍，用標槍，","poem":1},{"lineBreak":true},{"text":"用尖槍扎牠，都是無用。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"牠以鐵為乾草，","poem":1},{"lineBreak":true},{"text":"以銅為爛木。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"箭不能恐嚇牠使牠逃避；","poem":1},{"lineBreak":true},{"text":"彈石在牠看為碎稭。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"棍棒算為禾稭；","poem":1},{"lineBreak":true},{"text":"牠嗤笑短槍颼的響聲。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"牠肚腹下如尖瓦片；","poem":1},{"lineBreak":true},{"text":"牠如釘耙經過淤泥。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"牠使深淵開滾如鍋，","poem":1},{"lineBreak":true},{"text":"使洋海如鍋中的膏油。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"牠行的路隨後發光，","poem":1},{"lineBreak":true},{"text":"令人想深淵如同白髮。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"在地上沒有像牠造的那樣，","poem":1},{"lineBreak":true},{"text":"無所懼怕。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"凡高大的，牠無不藐視；","poem":1},{"lineBreak":true},{"text":"牠在驕傲的水族上作王。","poem":1}]}],"footnotes":[{"noteId":24,"caller":"-","text":"原文是眼皮","reference":{"chapter":41,"verse":18}}]},"thisChapterLink":"/api/cmn_cuv/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}