{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"你且呼求，有誰答應你？","poem":1},{"lineBreak":true},{"text":"諸聖者之中，你轉向哪一位呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"忿怒害死愚妄人；","poem":1},{"lineBreak":true},{"text":"嫉妒殺死癡迷人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我曾見愚妄人扎下根，","poem":1},{"lineBreak":true},{"text":"但我忽然咒詛他的住處。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他的兒女遠離穩妥的地步，","poem":1},{"lineBreak":true},{"text":"在城門口被壓，並無人搭救。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他的莊稼有飢餓的人吃盡了，","poem":1},{"lineBreak":true},{"text":"就是在荊棘裏的也搶去了；","poem":1},{"lineBreak":true},{"text":"他的財寶有網羅張口吞滅了。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"禍患原不是從土中出來；","poem":1},{"lineBreak":true},{"text":"患難也不是從地裏發生。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"人生在世必遇患難，","poem":1},{"lineBreak":true},{"text":"如同火星飛騰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"至於我，我必仰望上帝，","poem":1},{"lineBreak":true},{"text":"把我的事情託付他。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他行大事不可測度，","poem":1},{"lineBreak":true},{"text":"行奇事不可勝數：","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"降雨在地上，","poem":1},{"lineBreak":true},{"text":"賜水於田裏；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"將卑微的安置在高處，","poem":1},{"lineBreak":true},{"text":"將哀痛的舉到穩妥之地；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"破壞狡猾人的計謀，","poem":1},{"lineBreak":true},{"text":"使他們所謀的不得成就。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他叫有智慧的中了自己的詭計，","poem":1},{"lineBreak":true},{"text":"使狡詐人的計謀速速滅亡。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們白晝遇見黑暗，","poem":1},{"lineBreak":true},{"text":"午間摸索如在夜間。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"上帝拯救窮乏人","poem":1},{"lineBreak":true},{"text":"脫離他們口中的刀和強暴人的手。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"這樣，貧寒的人有指望，","poem":1},{"lineBreak":true},{"text":"罪孽之輩必塞口無言。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"上帝所懲治的人是有福的！","poem":1},{"lineBreak":true},{"text":"所以你不可輕看全能者的管教。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因為他打破，又纏裹；","poem":1},{"lineBreak":true},{"text":"他擊傷，用手醫治。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你六次遭難，他必救你；","poem":1},{"lineBreak":true},{"text":"就是七次，災禍也無法害你。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"在饑荒中，他必救你脫離死亡；","poem":1},{"lineBreak":true},{"text":"在爭戰中，他必救你脫離刀劍的權力。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你必被隱藏，不受口舌之害；","poem":1},{"lineBreak":true},{"text":"災殃臨到，你也不懼怕。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你遇見災害饑饉，就必嬉笑；","poem":1},{"lineBreak":true},{"text":"地上的野獸，你也不懼怕。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"因為你必與田間的石頭立約；","poem":1},{"lineBreak":true},{"text":"田裏的野獸也必與你和好。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你必知道你帳棚平安，","poem":1},{"lineBreak":true},{"text":"要查看你的羊圈，一無所失；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"也必知道你的後裔將來發達，","poem":1},{"lineBreak":true},{"text":"你的子孫像地上的青草。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你必壽高年邁才歸墳墓，","poem":1},{"lineBreak":true},{"text":"好像禾捆到時收藏。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"這理，我們已經考察，本是如此。","poem":1},{"lineBreak":true},{"text":"你須要聽，要知道是與自己有益。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}