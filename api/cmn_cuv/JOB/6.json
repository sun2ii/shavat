{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"約伯回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"惟願我的煩惱稱一稱，","poem":1},{"lineBreak":true},{"text":"我一切的災害放在天平裏；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"現今都比海沙更重，","poem":1},{"lineBreak":true},{"text":"所以我的言語急躁。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因全能者的箭射入我身；","poem":1},{"lineBreak":true},{"text":"其毒，我的靈喝盡了；","poem":1},{"lineBreak":true},{"text":"上帝的驚嚇擺陣攻擊我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"野驢有草豈能叫喚？","poem":1},{"lineBreak":true},{"text":"牛有料豈能吼叫？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"物淡而無鹽豈可吃嗎？","poem":1},{"lineBreak":true},{"text":"蛋青有甚麼滋味呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"看為可厭的食物，","poem":1},{"lineBreak":true},{"text":"我心不肯挨近。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"惟願我得着所求的，","poem":1},{"lineBreak":true},{"text":"願上帝賜我所切望的；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"就是願上帝把我壓碎，","poem":1},{"lineBreak":true},{"text":"伸手將我剪除。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我因沒有違棄那聖者的言語，","poem":1},{"lineBreak":true},{"text":"就仍以此為安慰，","poem":1},{"lineBreak":true},{"text":"在不止息的痛苦中還可踴躍。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我有甚麼氣力使我等候？","poem":1},{"lineBreak":true},{"text":"我有甚麼結局使我忍耐？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我的氣力豈是石頭的氣力？","poem":1},{"lineBreak":true},{"text":"我的肉身豈是銅的呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"在我豈不是毫無幫助嗎？","poem":1},{"lineBreak":true},{"text":"智慧豈不是從我心中趕出淨盡嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"那將要灰心、離棄全能者、","poem":1},{"lineBreak":true},{"text":"不敬畏上帝的人，","poem":1},{"lineBreak":true},{"text":"他的朋友當以慈愛待他。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的弟兄詭詐，好像溪水，","poem":1},{"lineBreak":true},{"text":"又像溪水流乾的河道。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"這河因結冰發黑，","poem":1},{"lineBreak":true},{"text":"有雪藏在其中；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"天氣漸暖就隨時消化，","poem":1},{"lineBreak":true},{"text":"日頭炎熱便從原處乾涸。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"結伴的客旅離棄大道，","poem":1},{"lineBreak":true},{"text":"順河偏行，到荒野之地死亡。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"提瑪結伴的客旅瞻望；","poem":1},{"lineBreak":true},{"text":"示巴同夥的人等候。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他們因失了盼望就抱愧，","poem":1},{"lineBreak":true},{"text":"來到那裏便蒙羞。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"現在你們正是這樣，","poem":1},{"lineBreak":true},{"text":"看見驚嚇的事便懼怕。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我豈說：請你們供給我，","poem":1},{"lineBreak":true},{"text":"從你們的財物中送禮物給我？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"豈說：拯救我脫離敵人的手嗎？","poem":1},{"lineBreak":true},{"text":"救贖我脫離強暴人的手嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"請你們教導我，我便不作聲；","poem":1},{"lineBreak":true},{"text":"使我明白在何事上有錯。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"正直的言語力量何其大！","poem":1},{"lineBreak":true},{"text":"但你們責備是責備甚麼呢？","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"絕望人的講論既然如風，","poem":1},{"lineBreak":true},{"text":"你們還想要駁正言語嗎？","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你們想為孤兒拈鬮，","poem":1},{"lineBreak":true},{"text":"以朋友當貨物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"現在請你們看看我，","poem":1},{"lineBreak":true},{"text":"我決不當面說謊。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"請你們轉意，不要不公；","poem":1},{"lineBreak":true},{"text":"請再轉意，我的事有理。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我的舌上豈有不義嗎？","poem":1},{"lineBreak":true},{"text":"我的口裏豈不辨奸惡嗎？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}