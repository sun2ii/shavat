{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"人在世上豈無爭戰嗎？","poem":1},{"lineBreak":true},{"text":"他的日子不像雇工人的日子嗎？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"像奴僕切慕黑影，","poem":1},{"lineBreak":true},{"text":"像雇工人盼望工價；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我也照樣經過困苦的日月，","poem":1},{"lineBreak":true},{"text":"夜間的疲乏為我而定。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我躺臥的時候便說：","poem":1},{"lineBreak":true},{"text":"我何時起來，黑夜就過去呢？","poem":1},{"lineBreak":true},{"text":"我盡是反來覆去，直到天亮。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的肉體以蟲子和塵土為衣；","poem":1},{"lineBreak":true},{"text":"我的皮膚才收了口又重新破裂。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的日子比梭更快，","poem":1},{"lineBreak":true},{"text":"都消耗在無指望之中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"求你想念，我的生命不過是一口氣；","poem":1},{"lineBreak":true},{"text":"我的眼睛必不再見福樂。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"觀看我的人，他的眼必不再見我；","poem":1},{"lineBreak":true},{"text":"你的眼目要看我，我卻不在了。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"雲彩消散而過；","poem":1},{"lineBreak":true},{"text":"照樣，人下陰間也不再上來。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他不再回自己的家；","poem":1},{"lineBreak":true},{"text":"故土也不再認識他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我不禁止我口；","poem":1},{"lineBreak":true},{"text":"我靈愁苦，要發出言語；","poem":1},{"lineBreak":true},{"text":"我心苦惱，要吐露哀情。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我對上帝說：我豈是洋海，","poem":1},{"lineBreak":true},{"text":"豈是大魚，你竟防守我呢？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"若說：我的床必安慰我，","poem":1},{"lineBreak":true},{"text":"我的榻必解釋我的苦情，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你就用夢驚駭我，","poem":1},{"lineBreak":true},{"text":"用異象恐嚇我，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"甚至我寧肯噎死，寧肯死亡，","poem":1},{"lineBreak":true},{"text":"勝似留我這一身的骨頭。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我厭棄性命，不願永活。","poem":1},{"lineBreak":true},{"text":"你任憑我吧，因我的日子都是虛空。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"人算甚麼，你竟看他為大，","poem":1},{"lineBreak":true},{"text":"將他放在心上？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"每早鑒察他，","poem":1},{"lineBreak":true},{"text":"時刻試驗他？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你到何時才轉眼不看我，","poem":1},{"lineBreak":true},{"text":"才任憑我咽下唾沫呢？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"鑒察人的主啊，我若有罪，於你何妨？","poem":1},{"lineBreak":true},{"text":"為何以我當你的箭靶子，","poem":1},{"lineBreak":true},{"text":"使我厭棄自己的性命？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"為何不赦免我的過犯，","poem":1},{"lineBreak":true},{"text":"除掉我的罪孽？","poem":1},{"lineBreak":true},{"text":"我現今要躺臥在塵土中；","poem":1},{"lineBreak":true},{"text":"你要殷勤地尋找我，我卻不在了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}