{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"書亞人比勒達回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"這些話你要說到幾時？","poem":1},{"lineBreak":true},{"text":"口中的言語如狂風要到幾時呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝豈能偏離公平？","poem":1},{"lineBreak":true},{"text":"全能者豈能偏離公義？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"或者你的兒女得罪了他；","poem":1},{"lineBreak":true},{"text":"他使他們受報應。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你若殷勤地尋求上帝，","poem":1},{"lineBreak":true},{"text":"向全能者懇求；","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你若清潔正直，","poem":1},{"lineBreak":true},{"text":"他必定為你起來，","poem":1},{"lineBreak":true},{"text":"使你公義的居所興旺。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你起初雖然微小，","poem":1},{"lineBreak":true},{"text":"終久必甚發達。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"請你考問前代，","poem":1},{"lineBreak":true},{"text":"追念他們的列祖所查究的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我們不過從昨日才有，一無所知；","poem":1},{"lineBreak":true},{"text":"我們在世的日子好像影兒。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們豈不指教你，告訴你，","poem":1},{"lineBreak":true},{"text":"從心裏發出言語來呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"蒲草沒有泥豈能發長？","poem":1},{"lineBreak":true},{"text":"蘆荻沒有水豈能生發？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"尚青的時候，還沒有割下，","poem":1},{"lineBreak":true},{"text":"比百樣的草先枯槁。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"凡忘記上帝的人，景況也是這樣；","poem":1},{"lineBreak":true},{"text":"不虔敬人的指望要滅沒。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他所仰賴的必折斷；","poem":1},{"lineBreak":true},{"text":"他所倚靠的是蜘蛛網。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他要倚靠房屋，房屋卻站立不住；","poem":1},{"lineBreak":true},{"text":"他要抓住房屋，房屋卻不能存留。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他在日光之下發青，","poem":1},{"lineBreak":true},{"text":"蔓子爬滿了園子；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他的根盤繞石堆，","poem":1},{"lineBreak":true},{"text":"扎入石地。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他若從本地被拔出，","poem":1},{"lineBreak":true},{"text":"那地就不認識他，說：","poem":1},{"lineBreak":true},{"text":"我沒有見過你。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"看哪，這就是他道中之樂；","poem":1},{"lineBreak":true},{"text":"以後必另有人從地而生。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"上帝必不丟棄完全人，","poem":1},{"lineBreak":true},{"text":"也不扶助邪惡人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他還要以喜笑充滿你的口，","poem":1},{"lineBreak":true},{"text":"以歡呼充滿你的嘴。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"恨惡你的要披戴慚愧；","poem":1},{"lineBreak":true},{"text":"惡人的帳棚必歸於無有。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}