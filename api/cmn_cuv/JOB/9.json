{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOB","translationId":"cmn_cuv","name":"約伯記","commonName":"約伯記","title":"約伯記","order":18,"numberOfChapters":42,"sha256":"c2a2c8075ced18ee889b1f748446fbcb0aedee74df3b48c741b4e887b9daec45","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cmn_cuv/JOB/42.json","totalNumberOfVerses":1067},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":[{"text":"約伯回答說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我真知道是這樣；","poem":1},{"lineBreak":true},{"text":"但人在上帝面前怎能成為義呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"若願意與他爭辯，","poem":1},{"lineBreak":true},{"text":"千中之一也不能回答。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他心裏有智慧，且大有能力。","poem":1},{"lineBreak":true},{"text":"誰向上帝剛硬而得亨通呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他發怒，把山翻倒挪移，","poem":1},{"lineBreak":true},{"text":"山並不知覺。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他使地震動，離其本位，","poem":1},{"lineBreak":true},{"text":"地的柱子就搖撼。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他吩咐日頭不出來，就不出來，","poem":1},{"lineBreak":true},{"text":"又封閉眾星。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他獨自鋪張蒼天，","poem":1},{"lineBreak":true},{"text":"步行在海浪之上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他造北斗、參星、昴星，","poem":1},{"lineBreak":true},{"text":"並南方的密宮；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他行大事，不可測度，","poem":1},{"lineBreak":true},{"text":"行奇事，不可勝數。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他從我旁邊經過，我卻不看見；","poem":1},{"lineBreak":true},{"text":"他在我面前行走，我倒不知覺。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他奪取，誰能阻擋？","poem":1},{"lineBreak":true},{"text":"誰敢問他：你做甚麼？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"上帝必不收回他的怒氣；","poem":1},{"lineBreak":true},{"text":"扶助拉哈伯的，屈身在他以下。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"既是這樣，我怎敢回答他，","poem":1},{"lineBreak":true},{"text":"怎敢選擇言語與他辯論呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我雖有義，也不回答他，","poem":1},{"lineBreak":true},{"text":"只要向那審判我的懇求。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我若呼籲，他應允我；","poem":1},{"lineBreak":true},{"text":"我仍不信他真聽我的聲音。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他用暴風折斷我，","poem":1},{"lineBreak":true},{"text":"無故地加增我的損傷。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我就是喘一口氣，他都不容，","poem":1},{"lineBreak":true},{"text":"倒使我滿心苦惱。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"若論力量，他真有能力！","poem":1},{"lineBreak":true},{"text":"若論審判，他說誰能將我傳來呢？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我雖有義，自己的口要定我為有罪；","poem":1},{"lineBreak":true},{"text":"我雖完全，我口必顯我為彎曲。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我本完全，不顧自己；","poem":1},{"lineBreak":true},{"text":"我厭惡我的性命。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"善惡無分，都是一樣；","poem":1},{"lineBreak":true},{"text":"所以我說，完全人和惡人，他都滅絕。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"若忽然遭殺害之禍，","poem":1},{"lineBreak":true},{"text":"他必戲笑無辜的人遇難。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"世界交在惡人手中；","poem":1},{"lineBreak":true},{"text":"蒙蔽世界審判官的臉，","poem":1},{"lineBreak":true},{"text":"若不是他，是誰呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"我的日子比跑信的更快，","poem":1},{"lineBreak":true},{"text":"急速過去，不見福樂。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我的日子過去如快船，","poem":1},{"lineBreak":true},{"text":"如急落抓食的鷹。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我若說：我要忘記我的哀情，","poem":1},{"lineBreak":true},{"text":"除去我的愁容，心中暢快；","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我因愁苦而懼怕，","poem":1},{"lineBreak":true},{"text":"知道你必不以我為無辜。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我必被你定為有罪，","poem":1},{"lineBreak":true},{"text":"我何必徒然勞苦呢？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我若用雪水洗身，","poem":1},{"lineBreak":true},{"text":"用鹼潔淨我的手，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"你還要扔我在坑裏，","poem":1},{"lineBreak":true},{"text":"我的衣服都憎惡我。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他本不像我是人，使我可以回答他，","poem":1},{"lineBreak":true},{"text":"又使我們可以同聽審判。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"我們中間沒有聽訟的人","poem":1},{"lineBreak":true},{"text":"可以向我們兩造按手。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"願他把杖離開我，","poem":1},{"lineBreak":true},{"text":"不使驚惶威嚇我。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"我就說話，也不懼怕他，","poem":1},{"lineBreak":true},{"text":"現在我卻不是那樣。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}