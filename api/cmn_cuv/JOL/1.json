{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOL","translationId":"cmn_cuv","name":"約珥書","commonName":"約珥書","title":"約珥書","order":29,"numberOfChapters":3,"sha256":"7628bb5ca20986398c450eebfe51eba35f42ef0983838ad9e8b05107152c1c3b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cuv/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["耶和華的話臨到毗土珥的兒子約珥。"]},{"type":"heading","content":["百姓因收成受損壞而悲傷"]},{"type":"verse","number":2,"content":[{"text":"老年人哪，當聽我的話；","poem":1},{"lineBreak":true},{"text":"國中的居民哪，都要側耳而聽。","poem":1},{"lineBreak":true},{"text":"在你們的日子，","poem":1},{"lineBreak":true},{"text":"或你們列祖的日子，","poem":1},{"lineBreak":true},{"text":"曾有這樣的事嗎？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們要將這事傳與子，","poem":1},{"lineBreak":true},{"text":"子傳與孫，","poem":1},{"lineBreak":true},{"text":"孫傳與後代。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"剪蟲剩下的，蝗蟲來吃；","poem":1},{"lineBreak":true},{"text":"蝗蟲剩下的，蝻子來吃；","poem":1},{"lineBreak":true},{"text":"蝻子剩下的，螞蚱來吃。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"酒醉的人哪，要清醒哭泣；","poem":1},{"lineBreak":true},{"text":"好酒的人哪，都要為甜酒哀號，","poem":1},{"lineBreak":true},{"text":"因為從你們的口中斷絕了。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"有一隊蝗蟲","poem":1},{"noteId":0},{"text":"又強盛又無數，","poem":1},{"lineBreak":true},{"text":"侵犯我的地；","poem":1},{"lineBreak":true},{"text":"牠的牙齒如獅子的牙齒，","poem":1},{"lineBreak":true},{"text":"大牙如母獅的大牙。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"牠毀壞我的葡萄樹，","poem":1},{"lineBreak":true},{"text":"剝了我無花果樹的皮，","poem":1},{"lineBreak":true},{"text":"剝盡而丟棄，使枝條露白。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我的民哪，你當哀號，像處女腰束麻布，","poem":1},{"lineBreak":true},{"text":"為幼年的丈夫哀號。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"素祭和奠祭從耶和華的殿中斷絕；","poem":1},{"lineBreak":true},{"text":"事奉耶和華的祭司都悲哀。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"田荒涼，地悲哀；","poem":1},{"lineBreak":true},{"text":"因為五穀毀壞，","poem":1},{"lineBreak":true},{"text":"新酒乾竭，油也缺乏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"農夫啊，你們要慚愧；","poem":1},{"lineBreak":true},{"text":"修理葡萄園的啊，你們要哀號；","poem":1},{"lineBreak":true},{"text":"因為大麥小麥與田間的莊稼都滅絕了。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"葡萄樹枯乾；","poem":1},{"lineBreak":true},{"text":"無花果樹衰殘。","poem":1},{"lineBreak":true},{"text":"石榴樹、棕樹、蘋果樹，","poem":1},{"lineBreak":true},{"text":"連田野一切的樹木也都枯乾；","poem":1},{"lineBreak":true},{"text":"眾人的喜樂盡都消滅。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"祭司啊，你們當腰束麻布痛哭；","poem":1},{"lineBreak":true},{"text":"伺候祭壇的啊，你們要哀號；","poem":1},{"lineBreak":true},{"text":"事奉我上帝的啊，你們要來披上麻布過夜，","poem":1},{"lineBreak":true},{"text":"因為素祭和奠祭從你們上帝的殿中斷絕了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"你們要分定禁食的日子，","poem":1},{"lineBreak":true},{"text":"宣告嚴肅會，","poem":1},{"lineBreak":true},{"text":"招聚長老和國中的一切居民","poem":1},{"lineBreak":true},{"text":"到耶和華－你們上帝的殿，","poem":1},{"lineBreak":true},{"text":"向耶和華哀求。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"哀哉！耶和華的日子臨近了。","poem":1},{"lineBreak":true},{"text":"這日來到，好像毀滅從全能者來到。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"糧食不是在我們眼前斷絕了嗎？","poem":1},{"lineBreak":true},{"text":"歡喜快樂不是從我們上帝的殿中止息了嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"穀種在土塊下朽爛；","poem":1},{"lineBreak":true},{"text":"倉也荒涼，廩也破壞；","poem":1},{"lineBreak":true},{"text":"因為五穀枯乾了。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"牲畜哀鳴；","poem":1},{"lineBreak":true},{"text":"牛群混亂，因為無草；","poem":1},{"lineBreak":true},{"text":"羊群也受了困苦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和華啊，我向你求告，","poem":1},{"lineBreak":true},{"text":"因為火燒滅曠野的草場；","poem":1},{"lineBreak":true},{"text":"火焰燒盡田野的樹木。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"田野的走獸向你發喘；","poem":1},{"lineBreak":true},{"text":"因為溪水乾涸，","poem":1},{"lineBreak":true},{"text":"火也燒滅曠野的草場。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"原文是民","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/cmn_cuv/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}