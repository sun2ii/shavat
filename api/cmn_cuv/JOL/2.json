{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOL","translationId":"cmn_cuv","name":"約珥書","commonName":"約珥書","title":"約珥書","order":29,"numberOfChapters":3,"sha256":"7628bb5ca20986398c450eebfe51eba35f42ef0983838ad9e8b05107152c1c3b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cuv/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["以蝗蟲為耶和華日子的警告"]},{"type":"verse","number":1,"content":[{"text":"你們要在錫安吹角，","poem":1},{"lineBreak":true},{"text":"在我聖山吹出大聲。","poem":1},{"lineBreak":true},{"text":"國中的居民都要發顫；","poem":1},{"lineBreak":true},{"text":"因為耶和華的日子將到，","poem":1},{"lineBreak":true},{"text":"已經臨近。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"那日是黑暗、幽冥、","poem":1},{"lineBreak":true},{"text":"密雲、烏黑的日子，","poem":1},{"lineBreak":true},{"text":"好像晨光鋪滿山嶺。","poem":1},{"lineBreak":true},{"text":"有一隊蝗蟲","poem":1},{"noteId":1},{"text":"又大又強；","poem":1},{"lineBreak":true},{"text":"從來沒有這樣的，","poem":1},{"lineBreak":true},{"text":"以後直到萬代也必沒有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"牠們前面如火燒滅，","poem":1},{"lineBreak":true},{"text":"後面如火焰燒盡。","poem":1},{"lineBreak":true},{"text":"未到以前，地如伊甸園；","poem":1},{"lineBreak":true},{"text":"過去以後，成了荒涼的曠野；","poem":1},{"lineBreak":true},{"text":"沒有一樣能躲避牠們的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"牠們的形狀如馬，","poem":1},{"lineBreak":true},{"text":"奔跑如馬兵。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在山頂蹦跳的響聲如車輛的響聲，","poem":1},{"lineBreak":true},{"text":"又如火焰燒碎稭的響聲，","poem":1},{"lineBreak":true},{"text":"好像強盛的民擺陣預備打仗。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"牠們一來，眾民傷慟，","poem":1},{"lineBreak":true},{"text":"臉都變色。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"牠們如勇士奔跑，","poem":1},{"lineBreak":true},{"text":"像戰士爬城；","poem":1},{"lineBreak":true},{"text":"各都步行，不亂隊伍。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"彼此並不擁擠，向前各行其路，","poem":1},{"lineBreak":true},{"text":"直闖兵器，不偏左右。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"牠們蹦上城，躥上牆，","poem":1},{"lineBreak":true},{"text":"爬上房屋，","poem":1},{"lineBreak":true},{"text":"進入窗戶如同盜賊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"牠們一來，","poem":1},{"lineBreak":true},{"text":"地震天動，","poem":1},{"lineBreak":true},{"text":"日月昏暗，","poem":1},{"lineBreak":true},{"text":"星宿無光。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華在他軍旅前發聲，","poem":1},{"lineBreak":true},{"text":"他的隊伍甚大；","poem":1},{"lineBreak":true},{"text":"成就他命的是強盛者。","poem":1},{"lineBreak":true},{"text":"因為耶和華的日子大而可畏，","poem":1},{"lineBreak":true},{"text":"誰能當得起呢？","poem":1}]},{"type":"line_break"},{"type":"heading","content":["呼籲百姓悔改"]},{"type":"verse","number":12,"content":[{"text":"耶和華說：雖然如此，","poem":1},{"lineBreak":true},{"text":"你們應當禁食、哭泣、悲哀，","poem":1},{"lineBreak":true},{"text":"一心歸向我。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你們要撕裂心腸，","poem":1},{"lineBreak":true},{"text":"不撕裂衣服。","poem":1},{"lineBreak":true},{"text":"歸向耶和華－你們的上帝；","poem":1},{"lineBreak":true},{"text":"因為他有恩典，有憐憫，","poem":1},{"lineBreak":true},{"text":"不輕易發怒，","poem":1},{"lineBreak":true},{"text":"有豐盛的慈愛，","poem":1},{"lineBreak":true},{"text":"並且後悔不降所說的災。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"或者他轉意後悔，留下餘福，","poem":1},{"lineBreak":true},{"text":"就是留下獻給耶和華－你們上帝的素祭和奠祭，","poem":1},{"lineBreak":true},{"text":"也未可知。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"你們要在錫安吹角，","poem":1},{"lineBreak":true},{"text":"分定禁食的日子，","poem":1},{"lineBreak":true},{"text":"宣告嚴肅會。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"聚集眾民，使會眾自潔：","poem":1},{"lineBreak":true},{"text":"招聚老者，","poem":1},{"lineBreak":true},{"text":"聚集孩童和吃奶的；","poem":1},{"lineBreak":true},{"text":"使新郎出離洞房，","poem":1},{"lineBreak":true},{"text":"新婦出離內室。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"事奉耶和華的祭司","poem":1},{"lineBreak":true},{"text":"要在廊子和祭壇中間哭泣，說：","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你顧惜你的百姓，","poem":1},{"lineBreak":true},{"text":"不要使你的產業受羞辱，","poem":1},{"lineBreak":true},{"text":"列邦管轄他們。","poem":1},{"lineBreak":true},{"text":"為何容列國的人說：","poem":1},{"lineBreak":true},{"text":"「他們的上帝在哪裏」呢？","poem":1}]},{"type":"heading","content":["上帝再賜福澤"]},{"type":"verse","number":18,"content":[{"text":"耶和華就為自己的地發熱心，","poem":1},{"lineBreak":true},{"text":"憐恤他的百姓。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和華應允他的百姓說：","poem":1},{"lineBreak":true},{"text":"我必賜給你們五穀、新酒，和油，","poem":1},{"lineBreak":true},{"text":"使你們飽足；","poem":1},{"lineBreak":true},{"text":"我也不再使你們受列國的羞辱；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"卻要使北方來的軍隊遠離你們，","poem":1},{"lineBreak":true},{"text":"將他們趕到乾旱荒廢之地：","poem":1},{"lineBreak":true},{"text":"前隊趕入東海，","poem":1},{"lineBreak":true},{"text":"後隊趕入西海；","poem":1},{"lineBreak":true},{"text":"因為他們所行的大惡","poem":1},{"noteId":2},{"text":"，","poem":1},{"lineBreak":true},{"text":"臭氣上升，腥味騰空。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"地土啊，不要懼怕；","poem":1},{"lineBreak":true},{"text":"要歡喜快樂，","poem":1},{"lineBreak":true},{"text":"因為耶和華行了大事。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"田野的走獸啊，不要懼怕；","poem":1},{"lineBreak":true},{"text":"因為，曠野的草發生，","poem":1},{"lineBreak":true},{"text":"樹木結果，","poem":1},{"lineBreak":true},{"text":"無花果樹、葡萄樹也都效力。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"錫安的民哪，你們要快樂，","poem":1},{"lineBreak":true},{"text":"為耶和華－你們的上帝歡喜；","poem":1},{"lineBreak":true},{"text":"因他賜給你們合宜的秋雨，","poem":1},{"lineBreak":true},{"text":"為你們降下甘霖，","poem":1},{"lineBreak":true},{"text":"就是秋雨、春雨，和先前一樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"禾場必滿了麥子；","poem":1},{"lineBreak":true},{"text":"酒醡與油醡必有新酒和油盈溢。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我打發到你們中間的大軍隊，","poem":1},{"lineBreak":true},{"text":"就是蝗蟲、蝻子、螞蚱、剪蟲，","poem":1},{"lineBreak":true},{"text":"那些年所吃的，我要補還你們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"你們必多吃而得飽足，","poem":1},{"lineBreak":true},{"text":"就讚美為你們行奇妙事之耶和華－你們上帝的名。","poem":1},{"lineBreak":true},{"text":"我的百姓必永遠不致羞愧。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你們必知道我是在以色列中間，","poem":1},{"lineBreak":true},{"text":"又知道我是耶和華－你們的上帝；","poem":1},{"lineBreak":true},{"text":"在我以外並無別神。","poem":1},{"lineBreak":true},{"text":"我的百姓必永遠不致羞愧。","poem":1}]},{"type":"heading","content":["耶和華的日子"]},{"type":"verse","number":28,"content":[{"text":"以後，我要將我的靈澆灌凡有血氣的。","poem":1},{"lineBreak":true},{"text":"你們的兒女要說預言；","poem":1},{"lineBreak":true},{"text":"你們的老年人要做異夢，","poem":1},{"lineBreak":true},{"text":"少年人要見異象。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"在那些日子，","poem":1},{"lineBreak":true},{"text":"我要將我的靈澆灌我的僕人和使女。","poem":1}]},{"type":"verse","number":30,"content":["「在天上地下，我要顯出奇事，有血，有火，有煙柱。"]},{"type":"verse","number":31,"content":["日頭要變為黑暗，月亮要變為血，這都在耶和華大而可畏的日子未到以前。"]},{"type":"verse","number":32,"content":["到那時候，凡求告耶和華名的就必得救；因為照耶和華所說的，在錫安山，耶路撒冷必有逃脫的人，在剩下的人中必有耶和華所召的。」"]}],"footnotes":[{"noteId":1,"caller":"-","text":"原文是民","reference":{"chapter":2,"verse":2}},{"noteId":2,"caller":"-","text":"原文是事","reference":{"chapter":2,"verse":20}}]},"thisChapterLink":"/api/cmn_cuv/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}