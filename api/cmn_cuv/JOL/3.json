{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JOL","translationId":"cmn_cuv","name":"約珥書","commonName":"約珥書","title":"約珥書","order":29,"numberOfChapters":3,"sha256":"7628bb5ca20986398c450eebfe51eba35f42ef0983838ad9e8b05107152c1c3b","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cuv/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["上帝要審判萬民"]},{"type":"verse","number":1,"content":["「到那日，我使猶大和耶路撒冷被擄之人歸回的時候，"]},{"type":"verse","number":2,"content":["我要聚集萬民，帶他們下到約沙法谷，在那裏施行審判；因為他們將我的百姓，就是我的產業以色列，分散在列國中，又分取我的地土，"]},{"type":"verse","number":3,"content":["且為我的百姓拈鬮，將童子換妓女，賣童女買酒喝。"]},{"type":"verse","number":4,"content":["「泰爾、西頓，和非利士四境的人哪，你們與我何干？你們要報復我嗎？若報復我，我必使報應速速歸到你們的頭上。"]},{"type":"verse","number":5,"content":["你們既然奪取我的金銀，又將我可愛的寶物帶入你們宮殿",{"noteId":3},"，"]},{"type":"verse","number":6,"content":["並將猶大人和耶路撒冷人賣給希臘人",{"noteId":4},"，使他們遠離自己的境界。"]},{"type":"verse","number":7,"content":["我必激動他們離開你們所賣到之地，又必使報應歸到你們的頭上。"]},{"type":"verse","number":8,"content":["我必將你們的兒女賣在猶大人的手中，他們必賣給遠方示巴國的人。這是耶和華說的。」"]},{"type":"verse","number":9,"content":[{"text":"當在萬民中宣告說：","poem":1},{"lineBreak":true},{"text":"要預備打仗；","poem":1},{"lineBreak":true},{"text":"激動勇士，","poem":1},{"lineBreak":true},{"text":"使一切戰士上前來。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"要將犂頭打成刀劍，","poem":1},{"lineBreak":true},{"text":"將鐮刀打成戈矛；","poem":1},{"lineBreak":true},{"text":"軟弱的要說：我有勇力。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"四圍的列國啊，","poem":1},{"lineBreak":true},{"text":"你們要速速地來，","poem":1},{"lineBreak":true},{"text":"一同聚集。","poem":1},{"lineBreak":true},{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你使你的大能者降臨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"萬民都當興起，","poem":1},{"lineBreak":true},{"text":"上到約沙法谷；","poem":1},{"lineBreak":true},{"text":"因為我必坐在那裏，","poem":1},{"lineBreak":true},{"text":"審判四圍的列國。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"開鐮吧！因為莊稼熟了；","poem":1},{"lineBreak":true},{"text":"踐踏吧！因為酒醡滿了。","poem":1},{"lineBreak":true},{"text":"酒池盈溢；","poem":1},{"lineBreak":true},{"text":"他們的罪惡甚大。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"許多許多的人在斷定谷，","poem":1},{"lineBreak":true},{"text":"因為耶和華的日子臨近斷定谷。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"日月昏暗，","poem":1},{"lineBreak":true},{"text":"星宿無光。","poem":1}]},{"type":"heading","content":["上帝將賜福給他的子民"]},{"type":"verse","number":16,"content":[{"text":"耶和華必從錫安吼叫，","poem":1},{"lineBreak":true},{"text":"從耶路撒冷發聲，","poem":1},{"lineBreak":true},{"text":"天地就震動。","poem":1},{"lineBreak":true},{"text":"耶和華卻要作他百姓的避難所，","poem":1},{"lineBreak":true},{"text":"作以色列人的保障。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"你們就知道我是耶和華－你們的上帝，","poem":1},{"lineBreak":true},{"text":"且又住在錫安－我的聖山。","poem":1},{"lineBreak":true},{"text":"那時，耶路撒冷必成為聖；","poem":1},{"lineBreak":true},{"text":"外邦人不再從其中經過。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"到那日，大山要滴甜酒；","poem":1},{"lineBreak":true},{"text":"小山要流奶子；","poem":1},{"lineBreak":true},{"text":"猶大溪河都有水流。","poem":1},{"lineBreak":true},{"text":"必有泉源從耶和華的殿中流出來，","poem":1},{"lineBreak":true},{"text":"滋潤什亭谷。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"埃及必然荒涼，","poem":1},{"lineBreak":true},{"text":"以東變為悽涼的曠野，","poem":1},{"lineBreak":true},{"text":"都因向猶大人所行的強暴，","poem":1},{"lineBreak":true},{"text":"又因在本地流無辜人的血。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"但猶大必存到永遠；","poem":1},{"lineBreak":true},{"text":"耶路撒冷必存到萬代。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我未曾報復","poem":1},{"noteId":5},{"text":"流血的罪，","poem":1},{"lineBreak":true},{"text":"現在我要報復，","poem":1},{"lineBreak":true},{"text":"因為耶和華住在錫安。","poem":1}]}],"footnotes":[{"noteId":3,"caller":"-","text":"或譯：廟中","reference":{"chapter":3,"verse":5}},{"noteId":4,"caller":"-","text":"原文是雅完人","reference":{"chapter":3,"verse":6}},{"noteId":5,"caller":"-","text":"或譯：洗除；下同","reference":{"chapter":3,"verse":21}}]},"thisChapterLink":"/api/cmn_cuv/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}