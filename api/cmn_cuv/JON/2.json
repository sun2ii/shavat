{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"JON","translationId":"cmn_cuv","name":"約拿書","commonName":"約拿書","title":"約拿書","order":32,"numberOfChapters":4,"sha256":"d5567522b3f36e56743f9863454e9d2be7a42b5e07aa66cbef79eee85bcfaa7c","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/cmn_cuv/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["約拿的禱告"]},{"type":"verse","number":1,"content":["約拿在魚腹中禱告耶和華－他的上帝，"]},{"type":"verse","number":2,"content":["說：",{"text":"我遭遇患難求告耶和華，","poem":1},{"lineBreak":true},{"text":"你就應允我；","poem":1},{"lineBreak":true},{"text":"從陰間的深處呼求，","poem":1},{"lineBreak":true},{"text":"你就俯聽我的聲音。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你將我投下深淵，","poem":1},{"lineBreak":true},{"text":"就是海的深處；","poem":1},{"lineBreak":true},{"text":"大水環繞我，","poem":1},{"lineBreak":true},{"text":"你的波浪洪濤都漫過我身。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我說：我從你眼前雖被驅逐，","poem":1},{"lineBreak":true},{"text":"我仍要仰望你的聖殿。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"諸水環繞我，幾乎淹沒我；","poem":1},{"lineBreak":true},{"text":"深淵圍住我；","poem":1},{"lineBreak":true},{"text":"海草纏繞我的頭。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我下到山根，","poem":1},{"lineBreak":true},{"text":"地的門將我永遠關住。","poem":1},{"lineBreak":true},{"text":"耶和華－我的上帝啊，","poem":1},{"lineBreak":true},{"text":"你卻將我的性命從坑中救出來。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我心在我裏面發昏的時候，","poem":1},{"lineBreak":true},{"text":"我就想念耶和華。","poem":1},{"lineBreak":true},{"text":"我的禱告進入你的聖殿，","poem":1},{"lineBreak":true},{"text":"達到你的面前。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"那信奉虛無之神的人，","poem":1},{"lineBreak":true},{"text":"離棄憐愛他們的主；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"但我必用感謝的聲音獻祭與你。","poem":1},{"lineBreak":true},{"text":"我所許的願，我必償還。","poem":1},{"lineBreak":true},{"text":"救恩出於耶和華。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華吩咐魚，魚就把約拿吐在旱地上。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}