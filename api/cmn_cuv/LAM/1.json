{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cuv","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"ceb31f364800e6afe6cf9c657c027835180bb4ba8d0a4cc896c6832df155fb00","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cuv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["耶路撒冷的憂患"]},{"type":"verse","number":1,"content":[{"text":"先前滿有人民的城，","poem":1},{"lineBreak":true},{"text":"現在何竟獨坐！","poem":1},{"lineBreak":true},{"text":"先前在列國中為大的，","poem":1},{"lineBreak":true},{"text":"現在竟如寡婦；","poem":1},{"lineBreak":true},{"text":"先前在諸省中為王后的，","poem":1},{"lineBreak":true},{"text":"現在成為進貢的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"她夜間痛哭，淚流滿腮；","poem":1},{"lineBreak":true},{"text":"在一切所親愛的中間沒有一個安慰她的。","poem":1},{"lineBreak":true},{"text":"她的朋友都以詭詐待她，","poem":1},{"lineBreak":true},{"text":"成為她的仇敵。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"猶大因遭遇苦難，","poem":1},{"lineBreak":true},{"text":"又因多服勞苦就遷到外邦。","poem":1},{"lineBreak":true},{"text":"她住在列國中，尋不着安息；","poem":1},{"lineBreak":true},{"text":"追逼她的都在狹窄之地將她追上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"錫安的路徑因無人來守聖節就悲傷；","poem":1},{"lineBreak":true},{"text":"她的城門淒涼；","poem":1},{"lineBreak":true},{"text":"她的祭司歎息；","poem":1},{"lineBreak":true},{"text":"她的處女受艱難，自己也愁苦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"她的敵人為首；","poem":1},{"lineBreak":true},{"text":"她的仇敵亨通；","poem":1},{"lineBreak":true},{"text":"因耶和華為她許多的罪過使她受苦；","poem":1},{"lineBreak":true},{"text":"她的孩童被敵人擄去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"錫安城","poem":1},{"noteId":0},{"text":"的威榮全都失去。","poem":1},{"lineBreak":true},{"text":"她的首領像找不着草場的鹿；","poem":1},{"lineBreak":true},{"text":"在追趕的人前無力行走。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶路撒冷在困苦窘迫之時，","poem":1},{"lineBreak":true},{"text":"就追想古時一切的樂境。","poem":1},{"lineBreak":true},{"text":"她百姓落在敵人手中，無人救濟；","poem":1},{"lineBreak":true},{"text":"敵人看見，就因她的荒涼嗤笑。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶路撒冷大大犯罪，","poem":1},{"lineBreak":true},{"text":"所以成為不潔之物；","poem":1},{"lineBreak":true},{"text":"素來尊敬她的，見她赤露就都藐視她；","poem":1},{"lineBreak":true},{"text":"她自己也歎息退後。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"她的污穢是在衣襟上；","poem":1},{"lineBreak":true},{"text":"她不思想自己的結局，","poem":1},{"lineBreak":true},{"text":"所以非常地敗落，","poem":1},{"lineBreak":true},{"text":"無人安慰她。","poem":1},{"lineBreak":true},{"text":"她說：耶和華啊，求你看我的苦難，","poem":1},{"lineBreak":true},{"text":"因為仇敵誇大。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"敵人伸手，奪取她的美物；","poem":1},{"lineBreak":true},{"text":"她眼見外邦人進入她的聖所－","poem":1},{"lineBreak":true},{"text":"論這外邦人，你曾吩咐不可入你的會中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"她的民都歎息，尋求食物；","poem":1},{"lineBreak":true},{"text":"他們用美物換糧食，要救性命。","poem":1},{"lineBreak":true},{"text":"他們說：耶和華啊，求你觀看，","poem":1},{"lineBreak":true},{"text":"因為我甚是卑賤。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"你們一切過路的人哪，這事你們不介意嗎？","poem":1},{"lineBreak":true},{"text":"你們要觀看：","poem":1},{"lineBreak":true},{"text":"有像這臨到我的痛苦沒有－","poem":1},{"lineBreak":true},{"text":"就是耶和華在他發烈怒的日子使我所受的苦？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"他從高天使火進入我的骨頭，","poem":1},{"lineBreak":true},{"text":"剋制了我；","poem":1},{"lineBreak":true},{"text":"他鋪下網羅，絆我的腳，","poem":1},{"lineBreak":true},{"text":"使我轉回；","poem":1},{"lineBreak":true},{"text":"他使我終日淒涼發昏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"我罪過的軛是他手所綁的，","poem":1},{"lineBreak":true},{"text":"猶如軛繩縛在我頸項上；","poem":1},{"lineBreak":true},{"text":"他使我的力量衰敗。","poem":1},{"lineBreak":true},{"text":"主將我交在我所不能敵擋的人手中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"主輕棄我中間的一切勇士，","poem":1},{"lineBreak":true},{"text":"招聚多人","poem":1},{"noteId":1},{"text":"攻擊我，","poem":1},{"lineBreak":true},{"text":"要壓碎我的少年人。","poem":1},{"lineBreak":true},{"text":"主將猶大居民踹下，","poem":1},{"lineBreak":true},{"text":"像在酒醡中一樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"我因這些事哭泣；","poem":1},{"lineBreak":true},{"text":"我眼淚汪汪；","poem":1},{"lineBreak":true},{"text":"因為那當安慰我、救我性命的，","poem":1},{"lineBreak":true},{"text":"離我甚遠。","poem":1},{"lineBreak":true},{"text":"我的兒女孤苦，","poem":1},{"lineBreak":true},{"text":"因為仇敵得了勝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"錫安舉手，無人安慰。","poem":1},{"lineBreak":true},{"text":"耶和華論雅各已經出令，","poem":1},{"lineBreak":true},{"text":"使四圍的人作他仇敵；","poem":1},{"lineBreak":true},{"text":"耶路撒冷在他們中間像不潔之物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"耶和華是公義的！","poem":1},{"lineBreak":true},{"text":"他這樣待我，是因我違背他的命令。","poem":1},{"lineBreak":true},{"text":"眾民哪，請聽我的話，","poem":1},{"lineBreak":true},{"text":"看我的痛苦；","poem":1},{"lineBreak":true},{"text":"我的處女和少年人都被擄去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"我招呼我所親愛的，","poem":1},{"lineBreak":true},{"text":"他們卻愚弄我。","poem":1},{"lineBreak":true},{"text":"我的祭司和長老正尋求食物、救性命的時候，","poem":1},{"lineBreak":true},{"text":"就在城中絕氣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"耶和華啊，求你觀看，","poem":1},{"lineBreak":true},{"text":"因為我在急難中。","poem":1},{"lineBreak":true},{"text":"我心腸擾亂；","poem":1},{"lineBreak":true},{"text":"我心在我裏面翻轉，","poem":1},{"lineBreak":true},{"text":"因我大大悖逆。","poem":1},{"lineBreak":true},{"text":"在外，刀劍使人喪子；","poem":1},{"lineBreak":true},{"text":"在家，猶如死亡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"聽見我歎息的有人；","poem":1},{"lineBreak":true},{"text":"安慰我的卻無人！","poem":1},{"lineBreak":true},{"text":"我的仇敵都聽見我所遭的患難；","poem":1},{"lineBreak":true},{"text":"因你做這事，他們都喜樂。","poem":1},{"lineBreak":true},{"text":"你必使你報告的日子來到，","poem":1},{"lineBreak":true},{"text":"他們就像我一樣。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"願他們的惡行都呈在你面前；","poem":1},{"lineBreak":true},{"text":"你怎樣因我的一切罪過待我，","poem":1},{"lineBreak":true},{"text":"求你照樣待他們；","poem":1},{"lineBreak":true},{"text":"因我歎息甚多，心中發昏。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"原文是女子；下同","reference":{"chapter":1,"verse":6}},{"noteId":1,"caller":"-","text":"原文是大會","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/cmn_cuv/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}