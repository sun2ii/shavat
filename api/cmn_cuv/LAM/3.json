{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cuv","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"ceb31f364800e6afe6cf9c657c027835180bb4ba8d0a4cc896c6832df155fb00","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cuv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["刑罰、悔改、希望"]},{"type":"verse","number":1,"content":[{"text":"我是因耶和華忿怒的杖，","poem":1},{"lineBreak":true},{"text":"遭遇困苦的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他引導我，使我行在黑暗中，","poem":1},{"lineBreak":true},{"text":"不行在光明裏。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他真是終日再三反手攻擊我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他使我的皮肉枯乾；","poem":1},{"lineBreak":true},{"text":"他折斷","poem":1},{"noteId":2},{"text":"我的骨頭。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他築壘攻擊我，","poem":1},{"lineBreak":true},{"text":"用苦楚","poem":1},{"noteId":3},{"text":"和艱難圍困我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他使我住在幽暗之處，","poem":1},{"lineBreak":true},{"text":"像死了許久的人一樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"他用籬笆圍住我，使我不能出去；","poem":1},{"lineBreak":true},{"text":"他使我的銅鍊沉重。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我哀號求救；","poem":1},{"lineBreak":true},{"text":"他使我的禱告不得上達。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他用鑿過的石頭擋住我的道；","poem":1},{"lineBreak":true},{"text":"他使我的路彎曲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"他向我如熊埋伏，","poem":1},{"lineBreak":true},{"text":"如獅子在隱密處。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他使我轉離正路，","poem":1},{"lineBreak":true},{"text":"將我撕碎，使我淒涼。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他張弓將我當作箭靶子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"他把箭袋中的箭射入我的肺腑。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我成了眾民的笑話；","poem":1},{"lineBreak":true},{"text":"他們終日以我為歌曲。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他用苦楚充滿我，使我飽用茵蔯。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"他又用沙石磣斷我的牙，","poem":1},{"lineBreak":true},{"text":"用灰塵將我蒙蔽。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你使我遠離平安，","poem":1},{"lineBreak":true},{"text":"我忘記好處。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我就說：我的力量衰敗；","poem":1},{"lineBreak":true},{"text":"我在耶和華那裏毫無指望！","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和華啊，求你記念我","poem":1},{"lineBreak":true},{"text":"如茵蔯和苦膽的困苦窘迫。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我心想念這些，","poem":1},{"lineBreak":true},{"text":"就在裏面憂悶。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我想起這事，","poem":1},{"lineBreak":true},{"text":"心裏就有指望。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"我們不致消滅，","poem":1},{"lineBreak":true},{"text":"是出於耶和華諸般的慈愛；","poem":1},{"lineBreak":true},{"text":"是因他的憐憫不致斷絕。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"每早晨，這都是新的；","poem":1},{"lineBreak":true},{"text":"你的誠實極其廣大！","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我心裏說：耶和華是我的分，","poem":1},{"lineBreak":true},{"text":"因此，我要仰望他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"凡等候耶和華，心裏尋求他的，","poem":1},{"lineBreak":true},{"text":"耶和華必施恩給他。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"人仰望耶和華，","poem":1},{"lineBreak":true},{"text":"靜默等候他的救恩，","poem":1},{"lineBreak":true},{"text":"這原是好的。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"人在幼年負軛，","poem":1},{"lineBreak":true},{"text":"這原是好的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"他當獨坐無言，","poem":1},{"lineBreak":true},{"text":"因為這是耶和華加在他身上的。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他當口貼塵埃，","poem":1},{"lineBreak":true},{"text":"或者有指望。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他當由人打他的腮頰，","poem":1},{"lineBreak":true},{"text":"要滿受凌辱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"因為主必不永遠丟棄人。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"主雖使人憂愁，","poem":1},{"lineBreak":true},{"text":"還要照他諸般的慈愛發憐憫。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"因他並不甘心使人受苦，","poem":1},{"lineBreak":true},{"text":"使人憂愁。","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"人將世上被囚的踹","poem":1},{"noteId":4},{"text":"在腳下，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"或在至高者面前屈枉人，","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"或在人的訟事上顛倒是非，","poem":1},{"lineBreak":true},{"text":"這都是主看不上的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"除非主命定，","poem":1},{"lineBreak":true},{"text":"誰能說成就成呢？","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"禍福不都出於至高者的口嗎？","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"活人因自己的罪受罰，","poem":1},{"lineBreak":true},{"text":"為何發怨言呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"我們當深深考察自己的行為，","poem":1},{"lineBreak":true},{"text":"再歸向耶和華。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"我們當誠心向天上的上帝舉手禱告。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"我們犯罪背逆，","poem":1},{"lineBreak":true},{"text":"你並不赦免。","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"你自被怒氣遮蔽，追趕我們；","poem":1},{"lineBreak":true},{"text":"你施行殺戮，並不顧惜。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"你以黑雲遮蔽自己，","poem":1},{"lineBreak":true},{"text":"以致禱告不得透入。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"你使我們在萬民中成為污穢和渣滓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"我們的仇敵都向我們大大張口。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"恐懼和陷坑，殘害和毀滅，","poem":1},{"lineBreak":true},{"text":"都臨近我們。","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"因我眾民遭的毀滅，","poem":1},{"lineBreak":true},{"text":"我就眼淚下流如河。","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"我的眼多多流淚，","poem":1},{"lineBreak":true},{"text":"總不止息，","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"直等耶和華垂顧，","poem":1},{"lineBreak":true},{"text":"從天觀看。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"因我本城的眾民，","poem":1},{"lineBreak":true},{"text":"我的眼，使我的心傷痛。","poem":1}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"無故與我為仇的追逼我，","poem":1},{"lineBreak":true},{"text":"像追雀鳥一樣。","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"他們使我的命在牢獄中斷絕，","poem":1},{"lineBreak":true},{"text":"並將一塊石頭拋在我身上。","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"眾水流過我頭，","poem":1},{"lineBreak":true},{"text":"我說：我命斷絕了！","poem":1}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"耶和華啊，","poem":1},{"lineBreak":true},{"text":"我從深牢中求告你的名。","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"你曾聽見我的聲音；","poem":1},{"lineBreak":true},{"text":"我求你解救，","poem":1},{"lineBreak":true},{"text":"你不要掩耳不聽。","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"我求告你的日子，你臨近我，","poem":1},{"lineBreak":true},{"text":"說：不要懼怕！","poem":1}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"主啊，你伸明了我的冤；","poem":1},{"lineBreak":true},{"text":"你救贖了我的命。","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"耶和華啊，你見了我受的委屈；","poem":1},{"lineBreak":true},{"text":"求你為我伸冤。","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"他們仇恨我，謀害我，","poem":1},{"lineBreak":true},{"text":"你都看見了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"耶和華啊，你聽見他們辱罵我的話，","poem":1},{"lineBreak":true},{"text":"知道他們向我所設的計，","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"並那些起來攻擊我的人口中所說的話，","poem":1},{"lineBreak":true},{"text":"以及終日向我所設的計謀。","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"求你觀看，","poem":1},{"lineBreak":true},{"text":"他們坐下，起來，都以我為歌曲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"耶和華啊，你要按着他們手所做的","poem":1},{"lineBreak":true},{"text":"向他們施行報應。","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"你要使他們心裏剛硬，","poem":1},{"lineBreak":true},{"text":"使你的咒詛臨到他們。","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"你要發怒追趕他們，","poem":1},{"lineBreak":true},{"text":"從耶和華的天下除滅他們。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"-","text":"或譯：壓傷","reference":{"chapter":3,"verse":4}},{"noteId":3,"caller":"-","text":"原文是苦膽","reference":{"chapter":3,"verse":5}},{"noteId":4,"caller":"-","text":"原文是壓","reference":{"chapter":3,"verse":34}}]},"thisChapterLink":"/api/cmn_cuv/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}