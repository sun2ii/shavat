{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cuv","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"ceb31f364800e6afe6cf9c657c027835180bb4ba8d0a4cc896c6832df155fb00","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cuv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["耶路撒冷陷落之後"]},{"type":"verse","number":1,"content":[{"text":"黃金何其失光！","poem":1},{"lineBreak":true},{"text":"純金何其變色！","poem":1},{"lineBreak":true},{"text":"聖所的石頭倒在各市口上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"錫安寶貴的眾子好比精金，","poem":1},{"lineBreak":true},{"text":"現在何竟算為窯匠手所做的瓦瓶？","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"野狗尚且把奶乳哺其子，","poem":1},{"lineBreak":true},{"text":"我民的婦人倒成為殘忍，","poem":1},{"lineBreak":true},{"text":"好像曠野的鴕鳥一般。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"吃奶孩子的舌頭因乾渴貼住上膛；","poem":1},{"lineBreak":true},{"text":"孩童求餅，無人擘給他們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"素來吃美好食物的，","poem":1},{"lineBreak":true},{"text":"現今在街上變為孤寒；","poem":1},{"lineBreak":true},{"text":"素來臥朱紅褥子的，","poem":1},{"lineBreak":true},{"text":"現今躺臥糞堆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"都因我眾民的罪孽比所多瑪的罪還大；","poem":1},{"lineBreak":true},{"text":"所多瑪雖然無人加手於她，","poem":1},{"lineBreak":true},{"text":"還是轉眼之間被傾覆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"錫安的貴冑素來比雪純淨，","poem":1},{"lineBreak":true},{"text":"比奶更白；","poem":1},{"lineBreak":true},{"text":"他們的身體比紅寶玉","poem":1},{"noteId":5},{"text":"更紅，","poem":1},{"lineBreak":true},{"text":"像光潤的藍寶石一樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"現在他們的面貌比煤炭更黑，","poem":1},{"lineBreak":true},{"text":"以致在街上無人認識；","poem":1},{"lineBreak":true},{"text":"他們的皮膚緊貼骨頭，","poem":1},{"lineBreak":true},{"text":"枯乾如同槁木。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"餓死的不如被刀殺的，","poem":1},{"lineBreak":true},{"text":"因為這是缺了田間的土產，","poem":1},{"lineBreak":true},{"text":"就身體衰弱，漸漸消滅。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"慈心的婦人，當我眾民被毀滅的時候，","poem":1},{"lineBreak":true},{"text":"親手煮自己的兒女作為食物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和華發怒成就他所定的，","poem":1},{"lineBreak":true},{"text":"倒出他的烈怒；","poem":1},{"lineBreak":true},{"text":"在錫安使火着起，","poem":1},{"lineBreak":true},{"text":"燒毀錫安的根基。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"地上的君王和世上的居民都不信","poem":1},{"lineBreak":true},{"text":"敵人和仇敵能進耶路撒冷的城門。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"這都因她先知的罪惡和祭司的罪孽；","poem":1},{"lineBreak":true},{"text":"他們在城中流了義人的血。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"他們在街上如瞎子亂走，","poem":1},{"lineBreak":true},{"text":"又被血玷污，","poem":1},{"lineBreak":true},{"text":"以致人不能摸他們的衣服。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"人向他們喊着說：","poem":1},{"lineBreak":true},{"text":"不潔淨的，躲開，躲開！","poem":1},{"lineBreak":true},{"text":"不要挨近我！","poem":1},{"lineBreak":true},{"text":"他們逃走飄流的時候，","poem":1},{"lineBreak":true},{"text":"列國中有人說：","poem":1},{"lineBreak":true},{"text":"他們不可仍在這裏寄居。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和華發怒，將他們分散，","poem":1},{"lineBreak":true},{"text":"不再眷顧他們；","poem":1},{"lineBreak":true},{"text":"人不重看祭司，也不厚待長老。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"我們仰望人來幫助，","poem":1},{"lineBreak":true},{"text":"以致眼目失明，還是枉然；","poem":1},{"lineBreak":true},{"text":"我們所盼望的，竟盼望一個不能救人的國！","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"仇敵追趕我們的腳步像打獵的，","poem":1},{"lineBreak":true},{"text":"以致我們不敢在自己的街上行走。","poem":1},{"lineBreak":true},{"text":"我們的結局臨近；","poem":1},{"lineBreak":true},{"text":"我們的日子滿足；","poem":1},{"lineBreak":true},{"text":"我們的結局來到了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"追趕我們的比空中的鷹更快；","poem":1},{"lineBreak":true},{"text":"他們在山上追逼我們，","poem":1},{"lineBreak":true},{"text":"在曠野埋伏，等候我們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"耶和華的受膏者好比我們鼻中的氣，","poem":1},{"lineBreak":true},{"text":"在他們的坑中被捉住；","poem":1},{"lineBreak":true},{"text":"我們曾論到他說：","poem":1},{"lineBreak":true},{"text":"我們必在他蔭下，","poem":1},{"lineBreak":true},{"text":"在列國中存活。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"住烏斯地的以東民哪，只管歡喜快樂；","poem":1},{"lineBreak":true},{"text":"苦杯也必傳到你那裏；","poem":1},{"lineBreak":true},{"text":"你必喝醉，以致露體。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"錫安的民哪，你罪孽的刑罰受足了，","poem":1},{"lineBreak":true},{"text":"耶和華必不使你再被擄去。","poem":1},{"lineBreak":true},{"text":"以東的民哪，他必追討你的罪孽，","poem":1},{"lineBreak":true},{"text":"顯露你的罪惡。","poem":1}]}],"footnotes":[{"noteId":5,"caller":"-","text":"或譯：珊瑚","reference":{"chapter":4,"verse":7}}]},"thisChapterLink":"/api/cmn_cuv/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}