{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"LAM","translationId":"cmn_cuv","name":"耶利米哀歌","commonName":"耶利米哀歌","title":"耶利米哀歌","order":25,"numberOfChapters":5,"sha256":"ceb31f364800e6afe6cf9c657c027835180bb4ba8d0a4cc896c6832df155fb00","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cmn_cuv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["求耶和華垂憐"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你記念我們所遭遇的事，","poem":1},{"lineBreak":true},{"text":"觀看我們所受的凌辱。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我們的產業歸與外邦人；","poem":1},{"lineBreak":true},{"text":"我們的房屋歸與外路人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我們是無父的孤兒；","poem":1},{"lineBreak":true},{"text":"我們的母親好像寡婦。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我們出錢才得水喝；","poem":1},{"lineBreak":true},{"text":"我們的柴是人賣給我們的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"追趕我們的，到了我們的頸項上；","poem":1},{"lineBreak":true},{"text":"我們疲乏不得歇息。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我們投降埃及人和亞述人，","poem":1},{"lineBreak":true},{"text":"為要得糧吃飽。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我們列祖犯罪，而今不在了；","poem":1},{"lineBreak":true},{"text":"我們擔當他們的罪孽。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"奴僕轄制我們，","poem":1},{"lineBreak":true},{"text":"無人救我們脫離他們的手。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為曠野的刀劍，","poem":1},{"lineBreak":true},{"text":"我們冒着險才得糧食。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因飢餓燥熱，","poem":1},{"lineBreak":true},{"text":"我們的皮膚就黑如爐。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"敵人在錫安玷污婦人，","poem":1},{"lineBreak":true},{"text":"在猶大的城邑玷污處女。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們吊起首領的手，","poem":1},{"lineBreak":true},{"text":"也不尊敬老人的面。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"少年人扛磨石，","poem":1},{"lineBreak":true},{"text":"孩童背木柴，都絆跌了。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"老年人在城門口斷絕；","poem":1},{"lineBreak":true},{"text":"少年人不再作樂。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我們心中的快樂止息，","poem":1},{"lineBreak":true},{"text":"跳舞變為悲哀。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"冠冕從我們的頭上落下；","poem":1},{"lineBreak":true},{"text":"我們犯罪了，我們有禍了！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"這些事我們心裏發昏，","poem":1},{"lineBreak":true},{"text":"我們的眼睛昏花。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"錫安山荒涼，","poem":1},{"lineBreak":true},{"text":"野狗","poem":1},{"noteId":6},{"text":"行在其上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和華啊，你存到永遠；","poem":1},{"lineBreak":true},{"text":"你的寶座存到萬代。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你為何永遠忘記我們？","poem":1},{"lineBreak":true},{"text":"為何許久離棄我們？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和華啊，求你使我們向你回轉，","poem":1},{"lineBreak":true},{"text":"我們便得回轉。","poem":1},{"lineBreak":true},{"text":"求你復新我們的日子，像古時一樣。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你竟全然棄絕我們，","poem":1},{"lineBreak":true},{"text":"向我們大發烈怒？","poem":1}]}],"footnotes":[{"noteId":6,"caller":"-","text":"或譯：狐狸","reference":{"chapter":5,"verse":18}}]},"thisChapterLink":"/api/cmn_cuv/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}