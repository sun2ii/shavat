{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cuv","name":"彌迦書","commonName":"彌迦書","title":"彌迦書","order":33,"numberOfChapters":7,"sha256":"154a3728694480f8a7d2bcf5b4ba0e013ef30af0e46392cac7149fcbe6a97d4d","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cuv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["當猶大王約坦、亞哈斯、希西家在位的時候，摩利沙人彌迦得耶和華的默示，論撒馬利亞和耶路撒冷。"]},{"type":"heading","content":["為撒馬利亞和耶路撒冷唱哀歌"]},{"type":"verse","number":2,"content":[{"text":"萬民哪，你們都要聽！","poem":1},{"lineBreak":true},{"text":"地和其上所有的，也都要側耳而聽！","poem":1},{"lineBreak":true},{"text":"主耶和華從他的聖殿","poem":1},{"lineBreak":true},{"text":"要見證你們的不是。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"看哪，耶和華出了他的居所，","poem":1},{"lineBreak":true},{"text":"降臨步行地的高處。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"眾山在他以下必消化，","poem":1},{"lineBreak":true},{"text":"諸谷必崩裂，","poem":1},{"lineBreak":true},{"text":"如蠟化在火中，","poem":1},{"lineBreak":true},{"text":"如水沖下山坡。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"這都因雅各的罪過，","poem":1},{"lineBreak":true},{"text":"以色列家的罪惡。","poem":1},{"lineBreak":true},{"text":"雅各的罪過在哪裏呢？","poem":1},{"lineBreak":true},{"text":"豈不是在撒馬利亞嗎？","poem":1},{"lineBreak":true},{"text":"猶大的邱壇在哪裏呢？","poem":1},{"lineBreak":true},{"text":"豈不是在耶路撒冷嗎？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"所以我必使撒馬利亞變為田野的亂堆，","poem":1},{"lineBreak":true},{"text":"又作為種葡萄之處；","poem":1},{"lineBreak":true},{"text":"也必將她的石頭倒在谷中，","poem":1},{"lineBreak":true},{"text":"露出根基來。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"她一切雕刻的偶像必被打碎；","poem":1},{"lineBreak":true},{"text":"她所得的財物必被火燒；","poem":1},{"lineBreak":true},{"text":"所有的偶像我必毀滅；","poem":1},{"lineBreak":true},{"text":"因為是從妓女雇價所聚來的，","poem":1},{"lineBreak":true},{"text":"後必歸為妓女的雇價。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"先知說：因此我必大聲哀號，","poem":1},{"lineBreak":true},{"text":"赤腳露體而行；","poem":1},{"lineBreak":true},{"text":"又要呼號如野狗，","poem":1},{"lineBreak":true},{"text":"哀鳴如鴕鳥。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為撒馬利亞的傷痕無法醫治，","poem":1},{"lineBreak":true},{"text":"延及猶大和耶路撒冷我民的城門。","poem":1}]},{"type":"heading","content":["敵人迫近耶路撒冷"]},{"type":"verse","number":10,"content":[{"text":"不要在迦特報告這事，","poem":1},{"lineBreak":true},{"text":"總不要哭泣；","poem":1},{"lineBreak":true},{"text":"我在伯‧亞弗拉滾於灰塵之中。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"沙斐的居民哪，你們要赤身蒙羞過去。","poem":1},{"lineBreak":true},{"text":"撒南的居民不敢出來。","poem":1},{"lineBreak":true},{"text":"伯‧以薛人的哀哭使你們無處可站。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"瑪律的居民心甚憂急，切望得好處，","poem":1},{"lineBreak":true},{"text":"因為災禍從耶和華那裏臨到耶路撒冷的城門。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"拉吉的居民哪，要用快馬套車；","poem":1},{"lineBreak":true},{"text":"錫安民","poem":1},{"noteId":0},{"text":"的罪由你而起；","poem":1},{"lineBreak":true},{"text":"以色列人的罪過在你那裏顯出。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"猶大啊，你要將禮物送給摩利設‧迦特。","poem":1},{"lineBreak":true},{"text":"亞革悉的眾族必用詭詐待以色列諸王。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"瑪利沙的居民哪，","poem":1},{"lineBreak":true},{"text":"我必使那奪取你的來到你這裏；","poem":1},{"lineBreak":true},{"text":"以色列的尊貴人","poem":1},{"noteId":1},{"text":"必到亞杜蘭。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"猶大啊，要為你所喜愛的兒女剪除你的頭髮，","poem":1},{"lineBreak":true},{"text":"使頭光禿，要大大地光禿，如同禿鷹，","poem":1},{"lineBreak":true},{"text":"因為他們都被擄去離開你。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"原文是女子","reference":{"chapter":1,"verse":13}},{"noteId":1,"caller":"-","text":"原文是榮耀","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/cmn_cuv/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}