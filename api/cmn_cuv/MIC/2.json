{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cuv","name":"彌迦書","commonName":"彌迦書","title":"彌迦書","order":33,"numberOfChapters":7,"sha256":"154a3728694480f8a7d2bcf5b4ba0e013ef30af0e46392cac7149fcbe6a97d4d","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cuv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["欺壓者的命運"]},{"type":"verse","number":1,"content":[{"text":"禍哉，那些在床上圖謀罪孽、造作奸惡的！","poem":1},{"lineBreak":true},{"text":"天一發亮，因手有能力就行出來了。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他們貪圖田地就佔據，","poem":1},{"lineBreak":true},{"text":"貪圖房屋便奪取；","poem":1},{"lineBreak":true},{"text":"他們欺壓人，霸佔房屋和產業。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"所以耶和華如此說：","poem":1},{"lineBreak":true},{"text":"我籌劃災禍降與這族；","poem":1},{"lineBreak":true},{"text":"這禍在你們的頸項上不能解脫；","poem":1},{"lineBreak":true},{"text":"你們也不能昂首而行，","poem":1},{"lineBreak":true},{"text":"因為這時勢是惡的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"到那日，必有人向你們提起悲慘的哀歌，","poem":1},{"lineBreak":true},{"text":"譏刺說：我們全然敗落了！","poem":1},{"lineBreak":true},{"text":"耶和華將我們的分轉歸別人，","poem":1},{"lineBreak":true},{"text":"何竟使這分離開我們？","poem":1},{"lineBreak":true},{"text":"他將我們的田地分給悖逆的人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"所以在耶和華的會中，","poem":1},{"lineBreak":true},{"text":"你必沒有人拈鬮拉準繩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"他們","poem":1},{"noteId":2},{"text":"說：你們不可說預言；","poem":1},{"lineBreak":true},{"text":"不可向這些人說預言，","poem":1},{"lineBreak":true},{"text":"不住地羞辱我們。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"雅各家啊，豈可說耶和華的心不忍耐嗎","poem":1},{"noteId":3},{"text":"？","poem":1},{"lineBreak":true},{"text":"這些事是他所行的嗎？","poem":1},{"lineBreak":true},{"text":"我－耶和華的言語豈不是與行動正直的人有益嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"然而，近來我的民興起如仇敵，","poem":1},{"lineBreak":true},{"text":"從那些安然經過不願打仗之人身上剝去外衣。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你們將我民中的婦人從安樂家中趕出，","poem":1},{"lineBreak":true},{"text":"又將我的榮耀從她們的小孩子盡行奪去。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你們起來去吧！","poem":1},{"lineBreak":true},{"text":"這不是你們安息之所；","poem":1},{"lineBreak":true},{"text":"因為污穢使人","poem":1},{"noteId":4},{"text":"毀滅，","poem":1},{"lineBreak":true},{"text":"而且大大毀滅。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"若有人心存虛假，用謊言說：","poem":1},{"lineBreak":true},{"text":"我要向你們預言得清酒和濃酒。","poem":1},{"lineBreak":true},{"text":"那人就必作這民的先知。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"雅各家啊，我必要聚集你們，","poem":1},{"lineBreak":true},{"text":"必要招聚以色列剩下的人，","poem":1},{"lineBreak":true},{"text":"安置在一處，如波斯拉的羊，","poem":1},{"lineBreak":true},{"text":"又如草場上的羊群；","poem":1},{"lineBreak":true},{"text":"因為人數眾多就必大大喧嘩。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"開路的","poem":1},{"noteId":5},{"text":"在他們前面上去；","poem":1},{"lineBreak":true},{"text":"他們直闖過城門，從城門出去。","poem":1},{"lineBreak":true},{"text":"他們的王在前面行；","poem":1},{"lineBreak":true},{"text":"耶和華引導他們。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"-","text":"或譯：假先知","reference":{"chapter":2,"verse":6}},{"noteId":3,"caller":"-","text":"或譯：心腸狹窄嗎","reference":{"chapter":2,"verse":7}},{"noteId":4,"caller":"-","text":"或譯：地","reference":{"chapter":2,"verse":10}},{"noteId":5,"caller":"-","text":"或譯：破城的","reference":{"chapter":2,"verse":13}}]},"thisChapterLink":"/api/cmn_cuv/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}