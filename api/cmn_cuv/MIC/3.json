{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cuv","name":"彌迦書","commonName":"彌迦書","title":"彌迦書","order":33,"numberOfChapters":7,"sha256":"154a3728694480f8a7d2bcf5b4ba0e013ef30af0e46392cac7149fcbe6a97d4d","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cuv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["彌迦斥責以色列的領袖"]},{"type":"verse","number":1,"content":[{"text":"我說：雅各的首領，","poem":1},{"lineBreak":true},{"text":"以色列家的官長啊，你們要聽！","poem":1},{"lineBreak":true},{"text":"你們不當知道公平嗎？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們惡善好惡，","poem":1},{"lineBreak":true},{"text":"從人身上剝皮，","poem":1},{"lineBreak":true},{"text":"從人骨頭上剔肉，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"吃我民的肉，","poem":1},{"lineBreak":true},{"text":"剝他們的皮，","poem":1},{"lineBreak":true},{"text":"打折他們的骨頭，","poem":1},{"lineBreak":true},{"text":"分成塊子像要下鍋，","poem":1},{"lineBreak":true},{"text":"又像釜中的肉。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"到了遭災的時候，","poem":1},{"lineBreak":true},{"text":"這些人必哀求耶和華，","poem":1},{"lineBreak":true},{"text":"他卻不應允他們。","poem":1},{"lineBreak":true},{"text":"那時他必照他們所行的惡事向他們掩面。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"論到使我民走差路的先知－","poem":1},{"lineBreak":true},{"text":"他們牙齒有所嚼的，","poem":1},{"lineBreak":true},{"text":"他們就呼喊說：平安了！","poem":1},{"lineBreak":true},{"text":"凡不供給他們吃的，","poem":1},{"lineBreak":true},{"text":"他們就預備攻擊他","poem":1},{"noteId":6},{"text":"－","poem":1},{"lineBreak":true},{"text":"耶和華如此說：","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你們必遭遇黑夜，以致不見異象；","poem":1},{"lineBreak":true},{"text":"又必遭遇幽暗，以致不能占卜。","poem":1},{"lineBreak":true},{"text":"日頭必向你們沉落，","poem":1},{"lineBreak":true},{"text":"白晝變為黑暗。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"先見必抱愧，","poem":1},{"lineBreak":true},{"text":"占卜的必蒙羞，","poem":1},{"lineBreak":true},{"text":"都必摀着嘴唇，","poem":1},{"lineBreak":true},{"text":"因為上帝不應允他們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"至於我，我藉耶和華的靈，","poem":1},{"lineBreak":true},{"text":"滿有力量、公平、才能，","poem":1},{"lineBreak":true},{"text":"可以向雅各說明他的過犯，","poem":1},{"lineBreak":true},{"text":"向以色列指出他的罪惡。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"雅各家的首領、以色列家的官長啊，","poem":1},{"lineBreak":true},{"text":"當聽我的話！","poem":1},{"lineBreak":true},{"text":"你們厭惡公平，","poem":1},{"lineBreak":true},{"text":"在一切事上屈枉正直；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"以人血建立錫安，","poem":1},{"lineBreak":true},{"text":"以罪孽建造耶路撒冷。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"首領為賄賂行審判；","poem":1},{"lineBreak":true},{"text":"祭司為雇價施訓誨；","poem":1},{"lineBreak":true},{"text":"先知為銀錢行占卜。","poem":1},{"lineBreak":true},{"text":"他們卻倚賴耶和華，說：","poem":1},{"lineBreak":true},{"text":"耶和華不是在我們中間嗎？","poem":1},{"lineBreak":true},{"text":"災禍必不臨到我們。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"所以因你們的緣故，","poem":1},{"lineBreak":true},{"text":"錫安必被耕種像一塊田，","poem":1},{"lineBreak":true},{"text":"耶路撒冷必變為亂堆；","poem":1},{"lineBreak":true},{"text":"這殿的山必像叢林的高處。","poem":1}]}],"footnotes":[{"noteId":6,"caller":"-","text":"預備攻擊他：或譯說必遭遇刀兵","reference":{"chapter":3,"verse":5}}]},"thisChapterLink":"/api/cmn_cuv/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}