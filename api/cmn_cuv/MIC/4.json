{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cuv","name":"彌迦書","commonName":"彌迦書","title":"彌迦書","order":33,"numberOfChapters":7,"sha256":"154a3728694480f8a7d2bcf5b4ba0e013ef30af0e46392cac7149fcbe6a97d4d","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cuv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["耶和華作王，天下太平"]},{"type":"verse","number":1,"content":[{"text":"末後的日子，","poem":1},{"lineBreak":true},{"text":"耶和華殿的山必堅立，","poem":1},{"lineBreak":true},{"text":"超乎諸山，高舉過於萬嶺；","poem":1},{"lineBreak":true},{"text":"萬民都要流歸這山。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"必有許多國的民前往，說：","poem":1},{"lineBreak":true},{"text":"來吧，我們登耶和華的山，","poem":1},{"lineBreak":true},{"text":"奔雅各上帝的殿。","poem":1},{"lineBreak":true},{"text":"主必將他的道教訓我們；","poem":1},{"lineBreak":true},{"text":"我們也要行他的路。","poem":1},{"lineBreak":true},{"text":"因為訓誨必出於錫安；","poem":1},{"lineBreak":true},{"text":"耶和華的言語必出於耶路撒冷。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"他必在多國的民中施行審判，","poem":1},{"lineBreak":true},{"text":"為遠方強盛的國斷定是非。","poem":1},{"lineBreak":true},{"text":"他們要將刀打成犂頭，","poem":1},{"lineBreak":true},{"text":"把槍打成鐮刀。","poem":1},{"lineBreak":true},{"text":"這國不舉刀攻擊那國；","poem":1},{"lineBreak":true},{"text":"他們也不再學習戰事。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"人人都要坐在自己葡萄樹下","poem":1},{"lineBreak":true},{"text":"和無花果樹下，無人驚嚇。","poem":1},{"lineBreak":true},{"text":"這是萬軍之耶和華親口說的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"萬民各奉己神的名而行；","poem":1},{"lineBreak":true},{"text":"我們卻永永遠遠奉耶和華－我們上帝的名而行。","poem":1}]},{"type":"heading","content":["以色列人歸回本國"]},{"type":"verse","number":6,"content":[{"text":"耶和華說：到那日，","poem":1},{"lineBreak":true},{"text":"我必聚集瘸腿的，","poem":1},{"lineBreak":true},{"text":"招聚被趕出的和我所懲治的。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我必使瘸腿的為餘剩之民，","poem":1},{"lineBreak":true},{"text":"使趕到遠方的為強盛之民。","poem":1},{"lineBreak":true},{"text":"耶和華要在錫安山作王治理他們，","poem":1},{"lineBreak":true},{"text":"從今直到永遠。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你這羊群的高臺、錫安城","poem":1},{"noteId":7},{"text":"的山哪，","poem":1},{"lineBreak":true},{"text":"從前的權柄－","poem":1},{"lineBreak":true},{"text":"就是耶路撒冷民","poem":1},{"noteId":8},{"text":"的國權－","poem":1},{"lineBreak":true},{"text":"必歸與你。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"現在你為何大聲哭號呢？","poem":1},{"lineBreak":true},{"text":"疼痛抓住你彷彿產難的婦人，","poem":1},{"lineBreak":true},{"text":"是因你中間沒有君王嗎？","poem":1},{"lineBreak":true},{"text":"你的謀士滅亡了嗎？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"錫安的民","poem":1},{"noteId":9},{"text":"哪，","poem":1},{"lineBreak":true},{"text":"你要疼痛劬勞，彷彿產難的婦人；","poem":1},{"lineBreak":true},{"text":"因為你必從城裏出來，","poem":1},{"lineBreak":true},{"text":"住在田野，到巴比倫去。","poem":1},{"lineBreak":true},{"text":"在那裏要蒙解救；","poem":1},{"lineBreak":true},{"text":"在那裏耶和華必救贖你脫離仇敵的手。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"現在有許多國的民聚集攻擊你，說：","poem":1},{"lineBreak":true},{"text":"願錫安被玷污！","poem":1},{"lineBreak":true},{"text":"願我們親眼見她遭報！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們卻不知道耶和華的意念，","poem":1},{"lineBreak":true},{"text":"也不明白他的籌劃。","poem":1},{"lineBreak":true},{"text":"他聚集他們，好像把禾捆聚到禾場一樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"錫安的民","poem":1},{"noteId":10},{"text":"哪，起來踹穀吧！","poem":1},{"lineBreak":true},{"text":"我必使你的角成為鐵，","poem":1},{"lineBreak":true},{"text":"使你的蹄成為銅。","poem":1},{"lineBreak":true},{"text":"你必打碎多國的民，","poem":1},{"lineBreak":true},{"text":"將他們的財獻與耶和華，","poem":1},{"lineBreak":true},{"text":"將他們的貨獻與普天下的主。","poem":1}]}],"footnotes":[{"noteId":7,"caller":"-","text":"原文是女子","reference":{"chapter":4,"verse":8}},{"noteId":8,"caller":"-","text":"原文是女子","reference":{"chapter":4,"verse":8}},{"noteId":9,"caller":"-","text":"原文是女子","reference":{"chapter":4,"verse":10}},{"noteId":10,"caller":"-","text":"原文是女子","reference":{"chapter":4,"verse":13}}]},"thisChapterLink":"/api/cmn_cuv/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}