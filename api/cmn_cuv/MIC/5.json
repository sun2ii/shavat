{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cuv","name":"彌迦書","commonName":"彌迦書","title":"彌迦書","order":33,"numberOfChapters":7,"sha256":"154a3728694480f8a7d2bcf5b4ba0e013ef30af0e46392cac7149fcbe6a97d4d","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cuv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"成群的民","poem":1},{"noteId":11},{"text":"哪，現在你要聚集成隊；","poem":1},{"lineBreak":true},{"text":"因為仇敵圍攻我們，","poem":1},{"lineBreak":true},{"text":"要用杖擊打以色列審判者的臉。","poem":1}]},{"type":"heading","content":["上帝應許一位掌權者出於伯利恆"]},{"type":"verse","number":2,"content":[{"text":"伯利恆的以法他啊，","poem":1},{"lineBreak":true},{"text":"你在猶大諸城中為小，","poem":1},{"lineBreak":true},{"text":"將來必有一位從你那裏出來，","poem":1},{"lineBreak":true},{"text":"在以色列中為我作掌權的；","poem":1},{"lineBreak":true},{"text":"他的根源從亙古，從太初就有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和華必將以色列人交付敵人，","poem":1},{"lineBreak":true},{"text":"直等那生產的婦人生下子來。","poem":1},{"lineBreak":true},{"text":"那時掌權者","poem":1},{"noteId":12},{"text":"其餘的弟兄","poem":1},{"lineBreak":true},{"text":"必歸到以色列人那裏。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他必起來，倚靠耶和華的大能，","poem":1},{"lineBreak":true},{"text":"並耶和華－他上帝之名的威嚴，","poem":1},{"lineBreak":true},{"text":"牧養他的羊群。","poem":1},{"lineBreak":true},{"text":"他們要安然居住；","poem":1},{"lineBreak":true},{"text":"因為他必日見尊大，直到地極。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"這位必作我們的平安。","poem":1},"解救和懲罰",{"text":"當亞述人進入我們的地境，","poem":1},{"lineBreak":true},{"text":"踐踏宮殿的時候，","poem":1},{"lineBreak":true},{"text":"我們就立起七個牧者，","poem":1},{"lineBreak":true},{"text":"八個首領攻擊他。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們必用刀劍毀壞亞述地","poem":1},{"lineBreak":true},{"text":"和寧錄地的關口。","poem":1},{"lineBreak":true},{"text":"亞述人進入我們的地境踐踏的時候，","poem":1},{"lineBreak":true},{"text":"他必拯救我們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"雅各餘剩的人必在多國的民中，","poem":1},{"lineBreak":true},{"text":"如從耶和華那裏降下的露水，","poem":1},{"lineBreak":true},{"text":"又如甘霖降在草上；","poem":1},{"lineBreak":true},{"text":"不仗賴人力，也不等候世人之功。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"雅各餘剩的人必在多國多民中，","poem":1},{"lineBreak":true},{"text":"如林間百獸中的獅子，","poem":1},{"lineBreak":true},{"text":"又如少壯獅子在羊群中。","poem":1},{"lineBreak":true},{"text":"他若經過就必踐踏撕裂，","poem":1},{"lineBreak":true},{"text":"無人搭救。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"願你的手舉起，高過敵人！","poem":1},{"lineBreak":true},{"text":"願你的仇敵都被剪除！","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和華說：到那日，","poem":1},{"lineBreak":true},{"text":"我必從你中間剪除馬匹，","poem":1},{"lineBreak":true},{"text":"毀壞車輛，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"也必從你國中除滅城邑，","poem":1},{"lineBreak":true},{"text":"拆毀一切的保障，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"又必除掉你手中的邪術；","poem":1},{"lineBreak":true},{"text":"你那裏也不再有占卜的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我必從你中間除滅雕刻的偶像和柱像，","poem":1},{"lineBreak":true},{"text":"你就不再跪拜自己手所造的。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我必從你中間拔出木偶，","poem":1},{"lineBreak":true},{"text":"又毀滅你的城邑。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我也必在怒氣和忿怒中向那不聽從的列國施報。","poem":1}]}],"footnotes":[{"noteId":11,"caller":"-","text":"原文是女子","reference":{"chapter":5,"verse":1}},{"noteId":12,"caller":"-","text":"原文是他","reference":{"chapter":5,"verse":3}}]},"thisChapterLink":"/api/cmn_cuv/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}