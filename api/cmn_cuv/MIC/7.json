{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"MIC","translationId":"cmn_cuv","name":"彌迦書","commonName":"彌迦書","title":"彌迦書","order":33,"numberOfChapters":7,"sha256":"154a3728694480f8a7d2bcf5b4ba0e013ef30af0e46392cac7149fcbe6a97d4d","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/cmn_cuv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["以色列人的腐敗"]},{"type":"verse","number":1,"content":[{"text":"哀哉！我","poem":1},{"noteId":13},{"text":"好像夏天的果子已被收盡，","poem":1},{"lineBreak":true},{"text":"又像摘了葡萄所剩下的，","poem":1},{"lineBreak":true},{"text":"沒有一掛可吃的；","poem":1},{"lineBreak":true},{"text":"我心羨慕初熟的無花果。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"地上虔誠人滅盡；","poem":1},{"lineBreak":true},{"text":"世間沒有正直人；","poem":1},{"lineBreak":true},{"text":"各人埋伏，要殺人流血，","poem":1},{"lineBreak":true},{"text":"都用網羅獵取弟兄。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們雙手作惡；","poem":1},{"lineBreak":true},{"text":"君王徇情面，審判官要賄賂；","poem":1},{"lineBreak":true},{"text":"位分大的吐出惡意，","poem":1},{"lineBreak":true},{"text":"都彼此結聯行惡。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們最好的，不過是蒺藜；","poem":1},{"lineBreak":true},{"text":"最正直的，不過是荊棘籬笆。","poem":1},{"lineBreak":true},{"text":"你守望者說，降罰的日子已經來到。","poem":1},{"lineBreak":true},{"text":"他們必擾亂不安。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"不要倚賴鄰舍；","poem":1},{"lineBreak":true},{"text":"不要信靠密友。","poem":1},{"lineBreak":true},{"text":"要守住你的口；","poem":1},{"lineBreak":true},{"text":"不要向你懷中的妻提說。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因為，兒子藐視父親；","poem":1},{"lineBreak":true},{"text":"女兒抗拒母親；","poem":1},{"lineBreak":true},{"text":"媳婦抗拒婆婆；","poem":1},{"lineBreak":true},{"text":"人的仇敵就是自己家裏的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"至於我，我要仰望耶和華，","poem":1},{"lineBreak":true},{"text":"要等候那救我的上帝；","poem":1},{"lineBreak":true},{"text":"我的上帝必應允我。","poem":1}]},{"type":"heading","content":["耶和華拯救他的子民"]},{"type":"verse","number":8,"content":[{"text":"我的仇敵啊，不要向我誇耀。","poem":1},{"lineBreak":true},{"text":"我雖跌倒，卻要起來；","poem":1},{"lineBreak":true},{"text":"我雖坐在黑暗裏，","poem":1},{"lineBreak":true},{"text":"耶和華卻作我的光。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我要忍受耶和華的惱怒；","poem":1},{"lineBreak":true},{"text":"因我得罪了他，","poem":1},{"lineBreak":true},{"text":"直等他為我辨屈，為我伸冤。","poem":1},{"lineBreak":true},{"text":"他必領我到光明中；","poem":1},{"lineBreak":true},{"text":"我必得見他的公義。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"那時我的仇敵，","poem":1},{"lineBreak":true},{"text":"就是曾對我說「耶和華－你上帝在哪裏」的，","poem":1},{"lineBreak":true},{"text":"他一看見這事就被羞愧遮蓋。","poem":1},{"lineBreak":true},{"text":"我必親眼見他遭報；","poem":1},{"lineBreak":true},{"text":"他必被踐踏，如同街上的泥土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"以色列啊，日子必到，","poem":1},{"lineBreak":true},{"text":"你的牆垣必重修；","poem":1},{"lineBreak":true},{"text":"到那日，你的境界必開展","poem":1},{"noteId":14},{"text":"。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"當那日，人必從亞述，","poem":1},{"lineBreak":true},{"text":"從埃及的城邑，","poem":1},{"lineBreak":true},{"text":"從埃及到大河，","poem":1},{"lineBreak":true},{"text":"從這海到那海，","poem":1},{"lineBreak":true},{"text":"從這山到那山，","poem":1},{"lineBreak":true},{"text":"都歸到你這裏。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"然而，這地因居民的緣故，","poem":1},{"lineBreak":true},{"text":"又因他們行事的結果，必然荒涼。","poem":1}]},{"type":"heading","content":["耶和華憐憫以色列"]},{"type":"verse","number":14,"content":[{"text":"求耶和華在迦密山的樹林中，","poem":1},{"lineBreak":true},{"text":"用你的杖牧放你獨居的民，","poem":1},{"lineBreak":true},{"text":"就是你產業的羊群。","poem":1},{"lineBreak":true},{"text":"求你容他們在巴珊和基列得食物，像古時一樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"耶和華說：","poem":1},{"lineBreak":true},{"text":"我要把奇事顯給他們看，","poem":1},{"lineBreak":true},{"text":"好像出埃及地的時候一樣。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"列國看見這事就必為自己的勢力慚愧；","poem":1},{"lineBreak":true},{"text":"他們必用手摀口，掩耳不聽。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他們必舔土如蛇，","poem":1},{"lineBreak":true},{"text":"又如土中腹行的物，","poem":1},{"lineBreak":true},{"text":"戰戰兢兢地出他們的營寨。","poem":1},{"lineBreak":true},{"text":"他們必戰懼投降耶和華，","poem":1},{"lineBreak":true},{"text":"也必因我們的上帝而懼怕。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"上帝啊，有何神像你，赦免罪孽，","poem":1},{"lineBreak":true},{"text":"饒恕你產業之餘民的罪過，","poem":1},{"lineBreak":true},{"text":"不永遠懷怒，喜愛施恩？","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"必再憐憫我們，","poem":1},{"lineBreak":true},{"text":"將我們的罪孽踏在腳下，","poem":1},{"lineBreak":true},{"text":"又將我們的一切罪投於深海。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你必按古時起誓應許我們列祖的話，","poem":1},{"lineBreak":true},{"text":"向雅各發誠實，","poem":1},{"lineBreak":true},{"text":"向亞伯拉罕施慈愛。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"或譯：以色列","reference":{"chapter":7,"verse":1}},{"noteId":14,"caller":"-","text":"或譯：命令必傳到遠方","reference":{"chapter":7,"verse":11}}]},"thisChapterLink":"/api/cmn_cuv/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}