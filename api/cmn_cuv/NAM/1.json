{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"NAM","translationId":"cmn_cuv","name":"那鴻書","commonName":"那鴻書","title":"那鴻書","order":34,"numberOfChapters":3,"sha256":"b5c02dbb6b17f24d30229e33dc7983035d08bdb1ebd18ef5df2c86acdc64e424","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cuv/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["論尼尼微的默示，就是伊勒歌斯人那鴻所得的默示。"]},{"type":"heading","content":["耶和華向尼尼微發怒"]},{"type":"verse","number":2,"content":[{"text":"耶和華是忌邪施報的上帝。","poem":1},{"lineBreak":true},{"text":"耶和華施報大有忿怒；","poem":1},{"lineBreak":true},{"text":"向他的敵人施報，","poem":1},{"lineBreak":true},{"text":"向他的仇敵懷怒。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華不輕易發怒，大有能力，","poem":1},{"lineBreak":true},{"text":"萬不以有罪的為無罪。","poem":1},{"lineBreak":true},{"text":"他乘旋風和暴風而來，","poem":1},{"lineBreak":true},{"text":"雲彩為他腳下的塵土。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他斥責海，使海乾了，","poem":1},{"lineBreak":true},{"text":"使一切江河乾涸。","poem":1},{"lineBreak":true},{"text":"巴珊和迦密的樹林衰殘；","poem":1},{"lineBreak":true},{"text":"黎巴嫩的花草也衰殘了。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"大山因他震動；","poem":1},{"lineBreak":true},{"text":"小山也都消化。","poem":1},{"lineBreak":true},{"text":"大地在他面前突起；","poem":1},{"lineBreak":true},{"text":"世界和住在其間的也都如此。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他發忿恨，誰能立得住呢？","poem":1},{"lineBreak":true},{"text":"他發烈怒，誰能當得起呢？","poem":1},{"lineBreak":true},{"text":"他的忿怒如火傾倒；","poem":1},{"lineBreak":true},{"text":"磐石因他崩裂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和華本為善，","poem":1},{"lineBreak":true},{"text":"在患難的日子為人的保障，","poem":1},{"lineBreak":true},{"text":"並且認得那些投靠他的人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"但他必以漲溢的洪水淹沒尼尼微，","poem":1},{"lineBreak":true},{"text":"又驅逐仇敵進入黑暗。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"尼尼微人哪，設何謀攻擊耶和華呢？","poem":1},{"lineBreak":true},{"text":"他必將你們滅絕淨盡；","poem":1},{"lineBreak":true},{"text":"災難不再興起。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你們像叢雜的荊棘，","poem":1},{"lineBreak":true},{"text":"像喝醉了的人，","poem":1},{"lineBreak":true},{"text":"又如枯乾的碎稭全然燒滅。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"有一人從你那裏出來，","poem":1},{"lineBreak":true},{"text":"圖謀邪惡，設惡計攻擊耶和華。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和華如此說：","poem":1},{"lineBreak":true},{"text":"尼尼微雖然勢力充足，人數繁多，","poem":1},{"lineBreak":true},{"text":"也被剪除，歸於無有。","poem":1},{"lineBreak":true},{"text":"猶大啊，我雖然使你受苦，","poem":1},{"lineBreak":true},{"text":"卻不再使你受苦。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"現在我必從你頸項上折斷他的軛，","poem":1},{"lineBreak":true},{"text":"扭開他的繩索。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華已經出令，指着尼尼微說：","poem":1},{"lineBreak":true},{"text":"你名下的人必不留後；","poem":1},{"lineBreak":true},{"text":"我必從你神的廟中除滅雕刻的偶像和鑄造的偶像；","poem":1},{"lineBreak":true},{"text":"我必因你鄙陋，使你歸於墳墓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"看哪，有報好信傳平安之人的腳登山，說：","poem":1},{"lineBreak":true},{"text":"猶大啊，可以守你的節期，","poem":1},{"lineBreak":true},{"text":"還你所許的願吧！","poem":1},{"lineBreak":true},{"text":"因為那惡人不再從你中間經過，","poem":1},{"lineBreak":true},{"text":"他已滅絕淨盡了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}