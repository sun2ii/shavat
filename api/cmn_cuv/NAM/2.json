{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"NAM","translationId":"cmn_cuv","name":"那鴻書","commonName":"那鴻書","title":"那鴻書","order":34,"numberOfChapters":3,"sha256":"b5c02dbb6b17f24d30229e33dc7983035d08bdb1ebd18ef5df2c86acdc64e424","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cuv/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["尼尼微的傾覆"]},{"type":"verse","number":1,"content":[{"text":"尼尼微啊，那打碎邦國的上來攻擊你。","poem":1},{"lineBreak":true},{"text":"你要看守保障，謹防道路，","poem":1},{"lineBreak":true},{"text":"使腰強壯，大大勉力。","poem":1},{"lineBreak":true},{"text":"（","poem":1}]},{"type":"verse","number":2,"content":[{"text":"耶和華復興雅各的榮華，","poem":1},{"lineBreak":true},{"text":"好像以色列的榮華一樣；","poem":1},{"lineBreak":true},{"text":"因為使地空虛的，","poem":1},{"lineBreak":true},{"text":"已經使雅各和以色列空虛，","poem":1},{"lineBreak":true},{"text":"將他們的葡萄枝毀壞了。）","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"他勇士的盾牌是紅的，","poem":1},{"lineBreak":true},{"text":"精兵都穿朱紅衣服。","poem":1},{"lineBreak":true},{"text":"在他預備爭戰的日子，","poem":1},{"lineBreak":true},{"text":"戰車上的鋼鐵閃爍如火，","poem":1},{"lineBreak":true},{"text":"柏木把的槍也掄起來了。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"車輛在街上","poem":1},{"noteId":0},{"text":"急行，","poem":1},{"lineBreak":true},{"text":"在寬闊處奔來奔去，","poem":1},{"lineBreak":true},{"text":"形狀如火把，","poem":1},{"lineBreak":true},{"text":"飛跑如閃電。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"尼尼微王招聚他的貴冑；","poem":1},{"lineBreak":true},{"text":"他們步行絆跌，","poem":1},{"lineBreak":true},{"text":"速上城牆，預備擋牌。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"河閘開放，宮殿沖沒。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"王后蒙羞，被人擄去；","poem":1},{"lineBreak":true},{"text":"宮女搥胸，哀鳴如鴿。","poem":1},{"lineBreak":true},{"text":"此乃命定之事。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"尼尼微自古以來充滿人民，","poem":1},{"lineBreak":true},{"text":"如同聚水的池子；","poem":1},{"lineBreak":true},{"text":"現在居民卻都逃跑。","poem":1},{"lineBreak":true},{"text":"雖有人呼喊說：站住！站住！","poem":1},{"lineBreak":true},{"text":"卻無人回顧。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你們搶掠金銀吧！","poem":1},{"lineBreak":true},{"text":"因為所積蓄的無窮，","poem":1},{"lineBreak":true},{"text":"華美的寶器無數。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"尼尼微現在空虛荒涼，","poem":1},{"lineBreak":true},{"text":"人心消化，雙膝相碰，","poem":1},{"lineBreak":true},{"text":"腰都疼痛，臉都變色。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"獅子的洞和少壯獅子餵養之處在哪裏呢？","poem":1},{"lineBreak":true},{"text":"公獅母獅小獅遊行、無人驚嚇之地在哪裏呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"公獅為小獅撕碎許多食物，","poem":1},{"lineBreak":true},{"text":"為母獅掐死活物，","poem":1},{"lineBreak":true},{"text":"把撕碎的、掐死的充滿牠的洞穴。","poem":1}]},{"type":"verse","number":13,"content":["萬軍之耶和華說：「我與你為敵，必將你的車輛焚燒成煙，刀劍也必吞滅你的少壯獅子。我必從地上除滅你所撕碎的，你使者的聲音必不再聽見。」"]}],"footnotes":[{"noteId":0,"caller":"-","text":"或譯：城外","reference":{"chapter":2,"verse":4}}]},"thisChapterLink":"/api/cmn_cuv/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}