{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"NAM","translationId":"cmn_cuv","name":"那鴻書","commonName":"那鴻書","title":"那鴻書","order":34,"numberOfChapters":3,"sha256":"b5c02dbb6b17f24d30229e33dc7983035d08bdb1ebd18ef5df2c86acdc64e424","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cmn_cuv/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"禍哉！這流人血的城，","poem":1},{"lineBreak":true},{"text":"充滿謊詐和強暴－","poem":1},{"lineBreak":true},{"text":"搶奪的事總不止息。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"鞭聲響亮，車輪轟轟，","poem":1},{"lineBreak":true},{"text":"馬匹踢跳，車輛奔騰，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"馬兵爭先，刀劍發光，","poem":1},{"lineBreak":true},{"text":"槍矛閃爍，被殺的甚多，","poem":1},{"lineBreak":true},{"text":"屍首成了大堆，","poem":1},{"lineBreak":true},{"text":"屍骸無數，人碰着而跌倒，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"都因那美貌的妓女多有淫行，","poem":1},{"lineBreak":true},{"text":"慣行邪術，藉淫行誘惑列國，","poem":1},{"lineBreak":true},{"text":"用邪術誘惑","poem":1},{"noteId":1},{"text":"多族。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"萬軍之耶和華說：我與你為敵；","poem":1},{"lineBreak":true},{"text":"我必揭起你的衣襟，蒙在你臉上，","poem":1},{"lineBreak":true},{"text":"使列國看見你的赤體，","poem":1},{"lineBreak":true},{"text":"使列邦觀看你的醜陋。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我必將可憎污穢之物拋在你身上，","poem":1},{"lineBreak":true},{"text":"辱沒你，為眾目所觀。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"凡看見你的，都必逃跑離開你，","poem":1},{"lineBreak":true},{"text":"說：尼尼微荒涼了！有誰為你悲傷呢？","poem":1},{"lineBreak":true},{"text":"我何處尋得安慰你的人呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你豈比挪亞們強呢？","poem":1},{"lineBreak":true},{"text":"挪亞們坐落在眾河之間，周圍有水；","poem":1},{"lineBreak":true},{"text":"海","poem":1},{"noteId":2},{"text":"作她的濠溝，","poem":1},{"lineBreak":true},{"text":"又作她的城牆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"古實和埃及是她無窮的力量；","poem":1},{"lineBreak":true},{"text":"弗人和路比族是她的幫手。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"但她被遷移，被擄去；","poem":1},{"lineBreak":true},{"text":"她的嬰孩在各市口上也被摔死。","poem":1},{"lineBreak":true},{"text":"人為她的尊貴人拈鬮；","poem":1},{"lineBreak":true},{"text":"她所有的大人都被鍊子鎖着。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你也必喝醉，必被埋藏，","poem":1},{"lineBreak":true},{"text":"並因仇敵的緣故尋求避難所。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你一切保障必像無花果樹上初熟的無花果，","poem":1},{"lineBreak":true},{"text":"若一搖撼就落在想吃之人的口中。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你地上的人民如同婦女；","poem":1},{"lineBreak":true},{"text":"你國中的關口向仇敵敞開；","poem":1},{"lineBreak":true},{"text":"你的門閂被火焚燒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"你要打水預備受困；","poem":1},{"lineBreak":true},{"text":"要堅固你的保障，","poem":1},{"lineBreak":true},{"text":"踹土和泥，修補磚窯。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"在那裏，火必燒滅你；","poem":1},{"lineBreak":true},{"text":"刀必殺戮你，","poem":1},{"lineBreak":true},{"text":"吞滅你如同蝻子。","poem":1},{"lineBreak":true},{"text":"任你加增人數多如蝻子，","poem":1},{"lineBreak":true},{"text":"多如蝗蟲吧！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你增添商賈，多過天上的星；","poem":1},{"lineBreak":true},{"text":"蝻子吃盡而去。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你的首領多如蝗蟲；","poem":1},{"lineBreak":true},{"text":"你的軍長彷彿成群的螞蚱，","poem":1},{"lineBreak":true},{"text":"天涼的時候齊落在籬笆上，","poem":1},{"lineBreak":true},{"text":"日頭一出便都飛去，","poem":1},{"lineBreak":true},{"text":"人不知道落在何處。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"亞述王啊，你的牧人睡覺；","poem":1},{"lineBreak":true},{"text":"你的貴冑安歇；","poem":1},{"lineBreak":true},{"text":"你的人民散在山間，無人招聚。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你的損傷無法醫治；","poem":1},{"lineBreak":true},{"text":"你的傷痕極其重大。","poem":1},{"lineBreak":true},{"text":"凡聽你信息的必都因此向你拍掌。","poem":1},{"lineBreak":true},{"text":"你所行的惡誰沒有時常遭遇呢？","poem":1}]}],"footnotes":[{"noteId":1,"caller":"-","text":"原文是賣","reference":{"chapter":3,"verse":4}},{"noteId":2,"caller":"-","text":"指尼羅河","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/cmn_cuv/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}