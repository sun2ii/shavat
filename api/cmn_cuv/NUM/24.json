{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"NUM","translationId":"cmn_cuv","name":"民數記","commonName":"民數記","title":"民數記","order":4,"numberOfChapters":36,"sha256":"7c111f07a9bd9423759abb7c8e169e1e99ed2bf1c6e109dc17b097e7eec739cf","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/cmn_cuv/NUM/36.json","totalNumberOfVerses":1272},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":["巴蘭見耶和華喜歡賜福與以色列，就不像前兩次去求法術，卻面向曠野。"]},{"type":"verse","number":2,"content":["巴蘭舉目，看見以色列人照着支派居住。上帝的靈就臨到他身上，"]},{"type":"verse","number":3,"content":["他便題起詩歌說：",{"text":"比珥的兒子巴蘭說，","poem":1},{"lineBreak":true},{"text":"眼目閉住","poem":1},{"noteId":13},{"text":"的人說，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"得聽上帝的言語，","poem":1},{"lineBreak":true},{"text":"得見全能者的異象，","poem":1},{"lineBreak":true},{"text":"眼目睜開而仆倒的人說：","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"雅各啊，你的帳棚何等華美！","poem":1},{"lineBreak":true},{"text":"以色列啊，你的帳幕何其華麗！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"如接連的山谷，","poem":1},{"lineBreak":true},{"text":"如河旁的園子，","poem":1},{"lineBreak":true},{"text":"如耶和華所栽的沉香樹，","poem":1},{"lineBreak":true},{"text":"如水邊的香柏木。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"水要從他的桶裏流出；","poem":1},{"lineBreak":true},{"text":"種子要撒在多水之處。","poem":1},{"lineBreak":true},{"text":"他的王必超過亞甲；","poem":1},{"lineBreak":true},{"text":"他的國必要振興。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"上帝領他出埃及；","poem":1},{"lineBreak":true},{"text":"他似乎有野牛之力。","poem":1},{"lineBreak":true},{"text":"他要吞吃敵國，","poem":1},{"lineBreak":true},{"text":"折斷他們的骨頭，","poem":1},{"lineBreak":true},{"text":"用箭射透他們。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他蹲如公獅，","poem":1},{"lineBreak":true},{"text":"臥如母獅，誰敢惹他？","poem":1},{"lineBreak":true},{"text":"凡給你祝福的，願他蒙福；","poem":1},{"lineBreak":true},{"text":"凡咒詛你的，願他受咒詛。","poem":1}]},{"type":"verse","number":10,"content":["巴勒向巴蘭生氣，就拍起手來，對巴蘭說：「我召你來為我咒詛仇敵，不料，你這三次竟為他們祝福。"]},{"type":"verse","number":11,"content":["如今你快回本地去吧！我想使你得大尊榮，耶和華卻阻止你不得尊榮。」"]},{"type":"verse","number":12,"content":["巴蘭對巴勒說：「我豈不是對你所差遣到我那裏的使者說："]},{"type":"verse","number":13,"content":["『巴勒就是將他滿屋的金銀給我，我也不得越過耶和華的命，憑自己的心意行好行歹。耶和華說甚麼，我就要說甚麼』？」"]},{"type":"heading","content":["巴蘭末次預言"]},{"type":"verse","number":14,"content":["「現在我要回本族去。你來，我告訴你這民日後要怎樣待你的民。」"]},{"type":"verse","number":15,"content":["他就題起詩歌說：",{"text":"比珥的兒子巴蘭說：","poem":1},{"lineBreak":true},{"text":"眼目閉住","poem":1},{"noteId":14},{"text":"的人說，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"得聽上帝的言語，","poem":1},{"lineBreak":true},{"text":"明白至高者的意旨，","poem":1},{"lineBreak":true},{"text":"看見全能者的異象，","poem":1},{"lineBreak":true},{"text":"眼目睜開而仆倒的人說：","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我看他卻不在現時；","poem":1},{"lineBreak":true},{"text":"我望他卻不在近日。","poem":1},{"lineBreak":true},{"text":"有星要出於雅各，有杖要興於以色列，","poem":1},{"lineBreak":true},{"text":"必打破摩押的四角，毀壞擾亂之子。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他必得以東為基業，","poem":1},{"lineBreak":true},{"text":"又得仇敵之地西珥為產業；","poem":1},{"lineBreak":true},{"text":"以色列必行事勇敢。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"有一位出於雅各的，必掌大權；","poem":1},{"lineBreak":true},{"text":"他要除滅城中的餘民。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"巴蘭觀看亞瑪力，就題起詩歌說：","poem":1},{"lineBreak":true},{"text":"亞瑪力原為諸國之首，","poem":1},{"lineBreak":true},{"text":"但他終必沉淪。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"巴蘭觀看基尼人，就題起詩歌說：","poem":1},{"lineBreak":true},{"text":"你的住處本是堅固；","poem":1},{"lineBreak":true},{"text":"你的窩巢做在巖穴中。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"然而基尼必至衰微，","poem":1},{"lineBreak":true},{"text":"直到亞述把你擄去。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"巴蘭又題起詩歌說：","poem":1},{"lineBreak":true},{"text":"哀哉！上帝行這事，誰能得活？","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"必有人乘船從基提界而來，","poem":1},{"lineBreak":true},{"text":"苦害亞述，苦害希伯；","poem":1},{"lineBreak":true},{"text":"他也必至沉淪。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"於是巴蘭起來，回他本地去；巴勒也回去了。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"或譯：睜開","reference":{"chapter":24,"verse":3}},{"noteId":14,"caller":"-","text":"或譯：睜開","reference":{"chapter":24,"verse":15}}]},"thisChapterLink":"/api/cmn_cuv/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}