{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":1,"content":[{"type":"heading","content":["箴言的價值"]},{"type":"verse","number":1,"content":[{"text":"以色列王大衛兒子所羅門的箴言：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要使人曉得智慧和訓誨，","poem":1},{"lineBreak":true},{"text":"分辨通達的言語，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"使人處事領受智慧、","poem":1},{"lineBreak":true},{"text":"仁義、公平、正直的訓誨，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"使愚人靈明，","poem":1},{"lineBreak":true},{"text":"使少年人有知識和謀略，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"使智慧人聽見，增長學問，","poem":1},{"lineBreak":true},{"text":"使聰明人得着智謀，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"使人明白箴言和譬喻，","poem":1},{"lineBreak":true},{"text":"懂得智慧人的言詞和謎語。","poem":1}]},{"type":"heading","content":["給青年人的忠告"]},{"type":"verse","number":7,"content":[{"text":"敬畏耶和華是知識的開端；","poem":1},{"lineBreak":true},{"text":"愚妄人藐視智慧和訓誨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我兒，要聽你父親的訓誨，","poem":1},{"lineBreak":true},{"text":"不可離棄你母親的法則","poem":1},{"noteId":0},{"text":"；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為這要作你頭上的華冠，","poem":1},{"lineBreak":true},{"text":"你項上的金鍊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"我兒，惡人若引誘你，","poem":1},{"lineBreak":true},{"text":"你不可隨從。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們若說：你與我們同去，","poem":1},{"lineBreak":true},{"text":"我們要埋伏流人之血，","poem":1},{"lineBreak":true},{"text":"要蹲伏害無罪之人；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我們好像陰間，把他們活活吞下；","poem":1},{"lineBreak":true},{"text":"他們如同下坑的人，","poem":1},{"lineBreak":true},{"text":"被我們囫圇吞了；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我們必得各樣寶物，","poem":1},{"lineBreak":true},{"text":"將所擄來的，裝滿房屋；","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你與我們大家同分，","poem":1},{"lineBreak":true},{"text":"我們共用一個囊袋；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我兒，不要與他們同行一道，","poem":1},{"lineBreak":true},{"text":"禁止你腳走他們的路。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因為，他們的腳奔跑行惡；","poem":1},{"lineBreak":true},{"text":"他們急速流人的血，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"好像飛鳥，","poem":1},{"lineBreak":true},{"text":"網羅設在眼前仍不躲避。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"這些人埋伏，是為自流己血；","poem":1},{"lineBreak":true},{"text":"蹲伏，是為自害己命。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"凡貪戀財利的，所行之路都是如此；","poem":1},{"lineBreak":true},{"text":"這貪戀之心乃奪去得財者之命。","poem":1}]},{"type":"heading","content":["智慧呼喚人"]},{"type":"verse","number":20,"content":[{"text":"智慧在街市上呼喊，","poem":1},{"lineBreak":true},{"text":"在寬闊處發聲，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"在熱鬧街頭喊叫，","poem":1},{"lineBreak":true},{"text":"在城門口，在城中發出言語，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"說：你們愚昧人喜愛愚昧，","poem":1},{"lineBreak":true},{"text":"褻慢人喜歡褻慢，","poem":1},{"lineBreak":true},{"text":"愚頑人恨惡知識，要到幾時呢？","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你們當因我的責備回轉；","poem":1},{"lineBreak":true},{"text":"我要將我的靈澆灌你們，","poem":1},{"lineBreak":true},{"text":"將我的話指示你們。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我呼喚，你們不肯聽從；","poem":1},{"lineBreak":true},{"text":"我伸手，無人理會；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"反輕棄我一切的勸戒，","poem":1},{"lineBreak":true},{"text":"不肯受我的責備。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"你們遭災難，我就發笑；","poem":1},{"lineBreak":true},{"text":"驚恐臨到你們，我必嗤笑。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"驚恐臨到你們，好像狂風；","poem":1},{"lineBreak":true},{"text":"災難來到，如同暴風；","poem":1},{"lineBreak":true},{"text":"急難痛苦臨到你們身上。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"那時，你們必呼求我，我卻不答應，","poem":1},{"lineBreak":true},{"text":"懇切地尋找我，卻尋不見。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"因為，你們恨惡知識，","poem":1},{"lineBreak":true},{"text":"不喜愛敬畏耶和華，","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"不聽我的勸戒，","poem":1},{"lineBreak":true},{"text":"藐視我一切的責備，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"所以必吃自結的果子，","poem":1},{"lineBreak":true},{"text":"充滿自設的計謀。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"愚昧人背道，必殺己身；","poem":1},{"lineBreak":true},{"text":"愚頑人安逸，必害己命。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"惟有聽從我的，必安然居住，","poem":1},{"lineBreak":true},{"text":"得享安靜，不怕災禍。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"或譯：指教","reference":{"chapter":1,"verse":8}}]},"thisChapterLink":"/api/cmn_cuv/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}