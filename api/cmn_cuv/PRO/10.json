{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":10,"content":[{"type":"heading","content":["所羅門的箴言"]},{"type":"verse","number":1,"content":[{"text":"所羅門的箴言：","poem":1},{"lineBreak":true},{"text":"智慧之子使父親歡樂；","poem":1},{"lineBreak":true},{"text":"愚昧之子叫母親擔憂。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"不義之財毫無益處；","poem":1},{"lineBreak":true},{"text":"惟有公義能救人脫離死亡。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華不使義人受飢餓；","poem":1},{"lineBreak":true},{"text":"惡人所欲的，他必推開。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"手懶的，要受貧窮；","poem":1},{"lineBreak":true},{"text":"手勤的，卻要富足。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"夏天聚斂的，是智慧之子；","poem":1},{"lineBreak":true},{"text":"收割時沉睡的，是貽羞之子。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"福祉臨到義人的頭；","poem":1},{"lineBreak":true},{"text":"強暴蒙蔽惡人的口。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"義人的紀念被稱讚；","poem":1},{"lineBreak":true},{"text":"惡人的名字必朽爛。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"心中智慧的，必受命令；","poem":1},{"lineBreak":true},{"text":"口裏愚妄的，必致傾倒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"行正直路的，步步安穩；","poem":1},{"lineBreak":true},{"text":"走彎曲道的，必致敗露。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"以眼傳神的，使人憂患；","poem":1},{"lineBreak":true},{"text":"口裏愚妄的，必致傾倒。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"義人的口是生命的泉源；","poem":1},{"lineBreak":true},{"text":"強暴蒙蔽惡人的口。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"恨能挑啟爭端；","poem":1},{"lineBreak":true},{"text":"愛能遮掩一切過錯。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"明哲人嘴裏有智慧；","poem":1},{"lineBreak":true},{"text":"無知人背上受刑杖。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"智慧人積存知識；","poem":1},{"lineBreak":true},{"text":"愚妄人的口速致敗壞。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"富戶的財物是他的堅城；","poem":1},{"lineBreak":true},{"text":"窮人的貧乏是他的敗壞。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"義人的勤勞致生；","poem":1},{"lineBreak":true},{"text":"惡人的進項致死","poem":1},{"noteId":13},{"text":"。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"謹守訓誨的，乃在生命的道上；","poem":1},{"lineBreak":true},{"text":"違棄責備的，便失迷了路。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"隱藏怨恨的，有說謊的嘴；","poem":1},{"lineBreak":true},{"text":"口出讒謗的，是愚妄的人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"多言多語難免有過；","poem":1},{"lineBreak":true},{"text":"禁止嘴唇是有智慧。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"義人的舌乃似高銀；","poem":1},{"lineBreak":true},{"text":"惡人的心所值無幾。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"義人的口教養多人；","poem":1},{"lineBreak":true},{"text":"愚昧人因無知而死亡。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和華所賜的福使人富足，","poem":1},{"lineBreak":true},{"text":"並不加上憂慮。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"愚妄人以行惡為戲耍；","poem":1},{"lineBreak":true},{"text":"明哲人卻以智慧為樂。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"惡人所怕的，必臨到他；","poem":1},{"lineBreak":true},{"text":"義人所願的，必蒙應允。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"暴風一過，惡人歸於無有；","poem":1},{"lineBreak":true},{"text":"義人的根基卻是永久。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"懶惰人叫差他的人","poem":1},{"lineBreak":true},{"text":"如醋倒牙，如煙薰目。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"敬畏耶和華使人日子加多；","poem":1},{"lineBreak":true},{"text":"但惡人的年歲必被減少。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"義人的盼望必得喜樂；","poem":1},{"lineBreak":true},{"text":"惡人的指望必致滅沒。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"耶和華的道是正直人的保障，","poem":1},{"lineBreak":true},{"text":"卻成了作孽人的敗壞。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"義人永不挪移；","poem":1},{"lineBreak":true},{"text":"惡人不得住在地上。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"義人的口滋生智慧；","poem":1},{"lineBreak":true},{"text":"乖謬的舌必被割斷。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"義人的嘴能令人喜悅；","poem":1},{"lineBreak":true},{"text":"惡人的口說乖謬的話。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"死：原文是罪","reference":{"chapter":10,"verse":16}}]},"thisChapterLink":"/api/cmn_cuv/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}