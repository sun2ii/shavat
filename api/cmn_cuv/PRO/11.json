{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"詭詐的天平為耶和華所憎惡；","poem":1},{"lineBreak":true},{"text":"公平的法碼為他所喜悅。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"驕傲來，羞恥也來；","poem":1},{"lineBreak":true},{"text":"謙遜人卻有智慧。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"正直人的純正必引導自己；","poem":1},{"lineBreak":true},{"text":"奸詐人的乖僻必毀滅自己。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"發怒的日子資財無益；","poem":1},{"lineBreak":true},{"text":"惟有公義能救人脫離死亡。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"完全人的義必指引他的路；","poem":1},{"lineBreak":true},{"text":"但惡人必因自己的惡跌倒。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"正直人的義必拯救自己；","poem":1},{"lineBreak":true},{"text":"奸詐人必陷在自己的罪孽中。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"惡人一死，他的指望必滅絕；","poem":1},{"lineBreak":true},{"text":"罪人的盼望也必滅沒。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"義人得脫離患難，","poem":1},{"lineBreak":true},{"text":"有惡人來代替他。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"不虔敬的人用口敗壞鄰舍；","poem":1},{"lineBreak":true},{"text":"義人卻因知識得救。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"義人享福，合城喜樂；","poem":1},{"lineBreak":true},{"text":"惡人滅亡，人都歡呼。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"城因正直人祝福便高舉，","poem":1},{"lineBreak":true},{"text":"卻因邪惡人的口就傾覆。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"藐視鄰舍的，毫無智慧；","poem":1},{"lineBreak":true},{"text":"明哲人卻靜默不言。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"往來傳舌的，洩漏密事；","poem":1},{"lineBreak":true},{"text":"心中誠實的，遮隱事情。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"無智謀，民就敗落；","poem":1},{"lineBreak":true},{"text":"謀士多，人便安居。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"為外人作保的，必受虧損；","poem":1},{"lineBreak":true},{"text":"恨惡擊掌的，卻得安穩。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"恩德的婦女得尊榮；","poem":1},{"lineBreak":true},{"text":"強暴的男子得資財。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"仁慈的人善待自己；","poem":1},{"lineBreak":true},{"text":"殘忍的人擾害己身。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"惡人經營，得虛浮的工價；","poem":1},{"lineBreak":true},{"text":"撒義種的，得實在的果效。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"恆心為義的，必得生命；","poem":1},{"lineBreak":true},{"text":"追求邪惡的，必致死亡。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"心中乖僻的，為耶和華所憎惡；","poem":1},{"lineBreak":true},{"text":"行事完全的，為他所喜悅。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"惡人雖然連手，必不免受罰；","poem":1},{"lineBreak":true},{"text":"義人的後裔必得拯救。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"婦女美貌而無見識，","poem":1},{"lineBreak":true},{"text":"如同金環帶在豬鼻上。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"義人的心願盡得好處；","poem":1},{"lineBreak":true},{"text":"惡人的指望致干忿怒。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"有施散的，卻更增添；","poem":1},{"lineBreak":true},{"text":"有吝惜過度的，反致窮乏。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"好施捨的，必得豐裕；","poem":1},{"lineBreak":true},{"text":"滋潤人的，必得滋潤。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"屯糧不賣的，民必咒詛他；","poem":1},{"lineBreak":true},{"text":"情願出賣的，人必為他祝福。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"懇切求善的，就求得恩惠；","poem":1},{"lineBreak":true},{"text":"惟獨求惡的，惡必臨到他身。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"倚仗自己財物的，必跌倒；","poem":1},{"lineBreak":true},{"text":"義人必發旺，如青葉。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"擾害己家的，必承受清風；","poem":1},{"lineBreak":true},{"text":"愚昧人必作慧心人的僕人。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"義人所結的果子就是生命樹；","poem":1},{"lineBreak":true},{"text":"有智慧的，必能得人。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"看哪，義人在世尚且受報，","poem":1},{"lineBreak":true},{"text":"何況惡人和罪人呢？","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}