{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"喜愛管教的，就是喜愛知識；","poem":1},{"lineBreak":true},{"text":"恨惡責備的，卻是畜類。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"善人必蒙耶和華的恩惠；","poem":1},{"lineBreak":true},{"text":"設詭計的人，耶和華必定他的罪。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人靠惡行不能堅立；","poem":1},{"lineBreak":true},{"text":"義人的根必不動搖。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"才德的婦人是丈夫的冠冕；","poem":1},{"lineBreak":true},{"text":"貽羞的婦人如同朽爛在她丈夫的骨中。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"義人的思念是公平；","poem":1},{"lineBreak":true},{"text":"惡人的計謀是詭詐。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"惡人的言論是埋伏流人的血；","poem":1},{"lineBreak":true},{"text":"正直人的口必拯救人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"惡人傾覆，歸於無有；","poem":1},{"lineBreak":true},{"text":"義人的家必站得住。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"人必按自己的智慧被稱讚；","poem":1},{"lineBreak":true},{"text":"心中乖謬的，必被藐視。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"被人輕賤，卻有僕人，","poem":1},{"lineBreak":true},{"text":"強如自尊，缺少食物。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"義人顧惜他牲畜的命；","poem":1},{"lineBreak":true},{"text":"惡人的憐憫也是殘忍。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耕種自己田地的，必得飽食；","poem":1},{"lineBreak":true},{"text":"追隨虛浮的，卻是無知。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"惡人想得壞人的網羅；","poem":1},{"lineBreak":true},{"text":"義人的根得以結實。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"惡人嘴中的過錯是自己的網羅；","poem":1},{"lineBreak":true},{"text":"但義人必脫離患難。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人因口所結的果子，必飽得美福；","poem":1},{"lineBreak":true},{"text":"人手所做的，必為自己的報應。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愚妄人所行的，在自己眼中看為正直；","poem":1},{"lineBreak":true},{"text":"惟智慧人肯聽人的勸教。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"愚妄人的惱怒立時顯露；","poem":1},{"lineBreak":true},{"text":"通達人能忍辱藏羞。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"說出真話的，顯明公義；","poem":1},{"lineBreak":true},{"text":"作假見證的，顯出詭詐。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"說話浮躁的，如刀刺人；","poem":1},{"lineBreak":true},{"text":"智慧人的舌頭卻為醫人的良藥。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"口吐真言，永遠堅立；","poem":1},{"lineBreak":true},{"text":"舌說謊話，只存片時。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"圖謀惡事的，心存詭詐；","poem":1},{"lineBreak":true},{"text":"勸人和睦的，便得喜樂。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"義人不遭災害；惡人滿受禍患。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"說謊言的嘴為耶和華所憎惡；","poem":1},{"lineBreak":true},{"text":"行事誠實的，為他所喜悅。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"通達人隱藏知識；","poem":1},{"lineBreak":true},{"text":"愚昧人的心彰顯愚昧。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"殷勤人的手必掌權；","poem":1},{"lineBreak":true},{"text":"懶惰的人必服苦。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"人心憂慮，屈而不伸；","poem":1},{"lineBreak":true},{"text":"一句良言，使心歡樂。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"義人引導他的鄰舍；","poem":1},{"lineBreak":true},{"text":"惡人的道叫人失迷。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"懶惰的人不烤打獵所得的；","poem":1},{"lineBreak":true},{"text":"殷勤的人卻得寶貴的財物。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"在公義的道上有生命；","poem":1},{"lineBreak":true},{"text":"其路之中並無死亡。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}