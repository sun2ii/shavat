{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"智慧子聽父親的教訓；","poem":1},{"lineBreak":true},{"text":"褻慢人不聽責備。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"人因口所結的果子，必享美福；","poem":1},{"lineBreak":true},{"text":"奸詐人必遭強暴。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"謹守口的，得保生命；","poem":1},{"lineBreak":true},{"text":"大張嘴的，必致敗亡。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"懶惰人羨慕，卻無所得；","poem":1},{"lineBreak":true},{"text":"殷勤人必得豐裕。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"義人恨惡謊言；","poem":1},{"lineBreak":true},{"text":"惡人有臭名，且致慚愧。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"行為正直的，有公義保守；","poem":1},{"lineBreak":true},{"text":"犯罪的，被邪惡傾覆。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"假作富足的，卻一無所有；","poem":1},{"lineBreak":true},{"text":"裝作窮乏的，卻廣有財物。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"人的資財是他生命的贖價；","poem":1},{"lineBreak":true},{"text":"窮乏人卻聽不見威嚇的話。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"義人的光明亮","poem":1},{"noteId":14},{"text":"；","poem":1},{"lineBreak":true},{"text":"惡人的燈要熄滅。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"驕傲只啟爭競；","poem":1},{"lineBreak":true},{"text":"聽勸言的，卻有智慧。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"不勞而得之財必然消耗；","poem":1},{"lineBreak":true},{"text":"勤勞積蓄的，必見加增。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"所盼望的遲延未得，令人心憂；","poem":1},{"lineBreak":true},{"text":"所願意的臨到，卻是生命樹。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"藐視訓言的，自取滅亡；","poem":1},{"lineBreak":true},{"text":"敬畏誡命的，必得善報。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"智慧人的法則","poem":1},{"noteId":15},{"text":"是生命的泉源，","poem":1},{"lineBreak":true},{"text":"可以使人離開死亡的網羅。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"美好的聰明使人蒙恩；","poem":1},{"lineBreak":true},{"text":"奸詐人的道路崎嶇難行。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"凡通達人都憑知識行事；","poem":1},{"lineBreak":true},{"text":"愚昧人張揚自己的愚昧。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"奸惡的使者必陷在禍患裏；","poem":1},{"lineBreak":true},{"text":"忠信的使臣乃醫人的良藥。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"棄絕管教的，必致貧受辱；","poem":1},{"lineBreak":true},{"text":"領受責備的，必得尊榮。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"所欲的成就，心覺甘甜；","poem":1},{"lineBreak":true},{"text":"遠離惡事，為愚昧人所憎惡。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"與智慧人同行的，必得智慧；","poem":1},{"lineBreak":true},{"text":"和愚昧人作伴的，必受虧損。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"禍患追趕罪人；","poem":1},{"lineBreak":true},{"text":"義人必得善報。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"善人給子孫遺留產業；","poem":1},{"lineBreak":true},{"text":"罪人為義人積存資財。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"窮人耕種多得糧食，","poem":1},{"lineBreak":true},{"text":"但因不義，有消滅的。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"不忍用杖打兒子的，是恨惡他；","poem":1},{"lineBreak":true},{"text":"疼愛兒子的，隨時管教。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"義人吃得飽足；","poem":1},{"lineBreak":true},{"text":"惡人肚腹缺糧。","poem":1}]}],"footnotes":[{"noteId":14,"caller":"-","text":"原文是歡喜","reference":{"chapter":13,"verse":9}},{"noteId":15,"caller":"-","text":"或譯：指教","reference":{"chapter":13,"verse":14}}]},"thisChapterLink":"/api/cmn_cuv/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}