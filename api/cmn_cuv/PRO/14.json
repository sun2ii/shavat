{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"智慧婦人建立家室；","poem":1},{"lineBreak":true},{"text":"愚妄婦人親手拆毀。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"行動正直的，敬畏耶和華；","poem":1},{"lineBreak":true},{"text":"行事乖僻的，卻藐視他。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愚妄人口中驕傲，如杖責打己身；","poem":1},{"lineBreak":true},{"text":"智慧人的嘴必保守自己。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"家裏無牛，槽頭乾淨；","poem":1},{"lineBreak":true},{"text":"土產加多乃憑牛力。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"誠實見證人不說謊話；","poem":1},{"lineBreak":true},{"text":"假見證人吐出謊言。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"褻慢人尋智慧，卻尋不着；","poem":1},{"lineBreak":true},{"text":"聰明人易得知識。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"到愚昧人面前，","poem":1},{"lineBreak":true},{"text":"不見他嘴中有知識。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"通達人的智慧在乎明白己道；","poem":1},{"lineBreak":true},{"text":"愚昧人的愚妄乃是詭詐","poem":1},{"noteId":16},{"text":"。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愚妄人犯罪，以為戲耍","poem":1},{"noteId":17},{"text":"；","poem":1},{"lineBreak":true},{"text":"正直人互相喜悅。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"心中的苦楚，自己知道；","poem":1},{"lineBreak":true},{"text":"心裏的喜樂，外人無干。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"奸惡人的房屋必傾倒；","poem":1},{"lineBreak":true},{"text":"正直人的帳棚必興盛。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"有一條路，人以為正，","poem":1},{"lineBreak":true},{"text":"至終成為死亡之路。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"人在喜笑中，心也憂愁；","poem":1},{"lineBreak":true},{"text":"快樂至極就生愁苦。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"心中背道的，必滿得自己的結果；","poem":1},{"lineBreak":true},{"text":"善人必從自己的行為得以知足。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愚蒙人是話都信；","poem":1},{"lineBreak":true},{"text":"通達人步步謹慎。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"智慧人懼怕，就遠離惡事；","poem":1},{"lineBreak":true},{"text":"愚妄人卻狂傲自恃。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"輕易發怒的，行事愚妄；","poem":1},{"lineBreak":true},{"text":"設立詭計的，被人恨惡。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"愚蒙人得愚昧為產業；","poem":1},{"lineBreak":true},{"text":"通達人得知識為冠冕。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"壞人俯伏在善人面前；","poem":1},{"lineBreak":true},{"text":"惡人俯伏在義人門口。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"貧窮人連鄰舍也恨他；","poem":1},{"lineBreak":true},{"text":"富足人朋友最多。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"藐視鄰舍的，這人有罪；","poem":1},{"lineBreak":true},{"text":"憐憫貧窮的，這人有福。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"謀惡的，豈非走入迷途嗎？","poem":1},{"lineBreak":true},{"text":"謀善的，必得慈愛和誠實。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"諸般勤勞都有益處；","poem":1},{"lineBreak":true},{"text":"嘴上多言乃致窮乏。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"智慧人的財為自己的冠冕；","poem":1},{"lineBreak":true},{"text":"愚妄人的愚昧終是愚昧。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"作真見證的，救人性命；","poem":1},{"lineBreak":true},{"text":"吐出謊言的，施行詭詐。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"敬畏耶和華的，大有倚靠；","poem":1},{"lineBreak":true},{"text":"他的兒女也有避難所。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"敬畏耶和華就是生命的泉源，","poem":1},{"lineBreak":true},{"text":"可以使人離開死亡的網羅。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"帝王榮耀在乎民多；","poem":1},{"lineBreak":true},{"text":"君王衰敗在乎民少。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"不輕易發怒的，大有聰明；","poem":1},{"lineBreak":true},{"text":"性情暴躁的，大顯愚妄。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"心中安靜是肉體的生命；","poem":1},{"lineBreak":true},{"text":"嫉妒是骨中的朽爛。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"欺壓貧寒的，是辱沒造他的主；","poem":1},{"lineBreak":true},{"text":"憐憫窮乏的，乃是尊敬主。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"惡人在所行的惡上必被推倒；","poem":1},{"lineBreak":true},{"text":"義人臨死，有所投靠。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"智慧存在聰明人心中；","poem":1},{"lineBreak":true},{"text":"愚昧人心裏所存的，顯而易見。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"公義使邦國高舉；","poem":1},{"lineBreak":true},{"text":"罪惡是人民的羞辱。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"智慧的臣子蒙王恩惠；","poem":1},{"lineBreak":true},{"text":"貽羞的僕人遭其震怒。","poem":1}]}],"footnotes":[{"noteId":16,"caller":"-","text":"或譯：自欺","reference":{"chapter":14,"verse":8}},{"noteId":17,"caller":"-","text":"或譯：贖愆祭愚弄愚妄人","reference":{"chapter":14,"verse":9}}]},"thisChapterLink":"/api/cmn_cuv/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}