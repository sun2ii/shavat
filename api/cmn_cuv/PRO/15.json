{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"回答柔和，使怒消退；","poem":1},{"lineBreak":true},{"text":"言語暴戾，觸動怒氣。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"智慧人的舌善發知識；","poem":1},{"lineBreak":true},{"text":"愚昧人的口吐出愚昧。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華的眼目無處不在；","poem":1},{"lineBreak":true},{"text":"惡人善人，他都鑒察。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"溫良的舌是生命樹；","poem":1},{"lineBreak":true},{"text":"乖謬的嘴使人心碎。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"愚妄人藐視父親的管教；","poem":1},{"lineBreak":true},{"text":"領受責備的，得着見識。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"義人家中多有財寶；","poem":1},{"lineBreak":true},{"text":"惡人得利反受擾害。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"智慧人的嘴播揚知識；","poem":1},{"lineBreak":true},{"text":"愚昧人的心並不如此。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"惡人獻祭，為耶和華所憎惡；","poem":1},{"lineBreak":true},{"text":"正直人祈禱，為他所喜悅。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"惡人的道路，為耶和華所憎惡；","poem":1},{"lineBreak":true},{"text":"追求公義的，為他所喜愛。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"捨棄正路的，必受嚴刑；","poem":1},{"lineBreak":true},{"text":"恨惡責備的，必致死亡。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"陰間和滅亡尚在耶和華眼前，","poem":1},{"lineBreak":true},{"text":"何況世人的心呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"褻慢人不愛受責備；","poem":1},{"lineBreak":true},{"text":"他也不就近智慧人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"心中喜樂，面帶笑容；","poem":1},{"lineBreak":true},{"text":"心裏憂愁，靈被損傷。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"聰明人心求知識；","poem":1},{"lineBreak":true},{"text":"愚昧人口吃愚昧。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"困苦人的日子都是愁苦；","poem":1},{"lineBreak":true},{"text":"心中歡暢的，常享豐筵。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"少有財寶，敬畏耶和華，","poem":1},{"lineBreak":true},{"text":"強如多有財寶，煩亂不安。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"吃素菜，彼此相愛，","poem":1},{"lineBreak":true},{"text":"強如吃肥牛，彼此相恨。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"暴怒的人挑啟爭端；","poem":1},{"lineBreak":true},{"text":"忍怒的人止息紛爭。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"懶惰人的道像荊棘的籬笆；","poem":1},{"lineBreak":true},{"text":"正直人的路是平坦的大道。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"智慧子使父親喜樂；","poem":1},{"lineBreak":true},{"text":"愚昧人藐視母親。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"無知的人以愚妄為樂；","poem":1},{"lineBreak":true},{"text":"聰明的人按正直而行。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"不先商議，所謀無效；","poem":1},{"lineBreak":true},{"text":"謀士眾多，所謀乃成。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"口善應對，自覺喜樂；","poem":1},{"lineBreak":true},{"text":"話合其時，何等美好。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"智慧人從生命的道上升，","poem":1},{"lineBreak":true},{"text":"使他遠離在下的陰間。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"耶和華必拆毀驕傲人的家，","poem":1},{"lineBreak":true},{"text":"卻要立定寡婦的地界。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"惡謀為耶和華所憎惡；","poem":1},{"lineBreak":true},{"text":"良言乃為純淨。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"貪戀財利的，擾害己家；","poem":1},{"lineBreak":true},{"text":"恨惡賄賂的，必得存活。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"義人的心，思量如何回答；","poem":1},{"lineBreak":true},{"text":"惡人的口吐出惡言。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"耶和華遠離惡人，","poem":1},{"lineBreak":true},{"text":"卻聽義人的禱告。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"眼有光，使心喜樂；","poem":1},{"lineBreak":true},{"text":"好信息，使骨滋潤。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"聽從生命責備的，","poem":1},{"lineBreak":true},{"text":"必常在智慧人中。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"棄絕管教的，輕看自己的生命；","poem":1},{"lineBreak":true},{"text":"聽從責備的，卻得智慧。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"敬畏耶和華是智慧的訓誨；","poem":1},{"lineBreak":true},{"text":"尊榮以前，必有謙卑。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}