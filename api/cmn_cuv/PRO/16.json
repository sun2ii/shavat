{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"心中的謀算在乎人；","poem":1},{"lineBreak":true},{"text":"舌頭的應對由於耶和華。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"人一切所行的，在自己眼中看為清潔；","poem":1},{"lineBreak":true},{"text":"惟有耶和華衡量人心。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你所做的，要交託耶和華，","poem":1},{"lineBreak":true},{"text":"你所謀的，就必成立。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華所造的，各適其用；","poem":1},{"lineBreak":true},{"text":"就是惡人也為禍患的日子所造。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"凡心裏驕傲的，為耶和華所憎惡；","poem":1},{"lineBreak":true},{"text":"雖然連手，他必不免受罰。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因憐憫誠實，罪孽得贖；","poem":1},{"lineBreak":true},{"text":"敬畏耶和華的，遠離惡事。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"人所行的，若蒙耶和華喜悅，","poem":1},{"lineBreak":true},{"text":"耶和華也使他的仇敵與他和好。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"多有財利，行事不義，","poem":1},{"lineBreak":true},{"text":"不如少有財利，行事公義。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"人心籌算自己的道路；","poem":1},{"lineBreak":true},{"text":"惟耶和華指引他的腳步。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"王的嘴中有神語，","poem":1},{"lineBreak":true},{"text":"審判之時，他的口必不差錯。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"公道的天平和秤都屬耶和華；","poem":1},{"lineBreak":true},{"text":"囊中一切法碼都為他所定。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"作惡，為王所憎惡，","poem":1},{"lineBreak":true},{"text":"因國位是靠公義堅立。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"公義的嘴為王所喜悅；","poem":1},{"lineBreak":true},{"text":"說正直話的，為王所喜愛。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"王的震怒如殺人的使者；","poem":1},{"lineBreak":true},{"text":"但智慧人能止息王怒。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"王的臉光使人有生命；","poem":1},{"lineBreak":true},{"text":"王的恩典好像春雲時雨。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"得智慧勝似得金子；","poem":1},{"lineBreak":true},{"text":"選聰明強如選銀子。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"正直人的道是遠離惡事；","poem":1},{"lineBreak":true},{"text":"謹守己路的，是保全性命。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"驕傲在敗壞以先；","poem":1},{"lineBreak":true},{"text":"狂心在跌倒之前。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"心裏謙卑與窮乏人來往，","poem":1},{"lineBreak":true},{"text":"強如將擄物與驕傲人同分。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"謹守訓言的，必得好處；","poem":1},{"lineBreak":true},{"text":"倚靠耶和華的，便為有福。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"心中有智慧，必稱為通達人；","poem":1},{"lineBreak":true},{"text":"嘴中的甜言，加增人的學問。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"人有智慧就有生命的泉源；","poem":1},{"lineBreak":true},{"text":"愚昧人必被愚昧懲治。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"智慧人的心教訓他的口，","poem":1},{"lineBreak":true},{"text":"又使他的嘴增長學問。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"良言如同蜂房，","poem":1},{"lineBreak":true},{"text":"使心覺甘甜，使骨得醫治。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"有一條路，人以為正，","poem":1},{"lineBreak":true},{"text":"至終成為死亡之路。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"勞力人的胃口使他勞力，","poem":1},{"lineBreak":true},{"text":"因為他的口腹催逼他。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"匪徒圖謀奸惡，","poem":1},{"lineBreak":true},{"text":"嘴上彷彿有燒焦的火。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"乖僻人播散紛爭；","poem":1},{"lineBreak":true},{"text":"傳舌的，離間密友。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"強暴人誘惑鄰舍，","poem":1},{"lineBreak":true},{"text":"領他走不善之道。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"眼目緊合的，圖謀乖僻；","poem":1},{"lineBreak":true},{"text":"嘴唇緊閉的，成就邪惡。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"白髮是榮耀的冠冕，","poem":1},{"lineBreak":true},{"text":"在公義的道上必能得着。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"不輕易發怒的，勝過勇士；","poem":1},{"lineBreak":true},{"text":"治服己心的，強如取城。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"籤放在懷裏，","poem":1},{"lineBreak":true},{"text":"定事由耶和華。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}