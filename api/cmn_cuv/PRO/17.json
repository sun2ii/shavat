{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"設筵滿屋，大家相爭，","poem":1},{"lineBreak":true},{"text":"不如有塊乾餅，大家相安。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"僕人辦事聰明，必管轄貽羞之子，","poem":1},{"lineBreak":true},{"text":"又在眾子中同分產業。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"鼎為煉銀，爐為煉金；","poem":1},{"lineBreak":true},{"text":"惟有耶和華熬煉人心。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"行惡的，留心聽奸詐之言；","poem":1},{"lineBreak":true},{"text":"說謊的，側耳聽邪惡之語。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"戲笑窮人的，是辱沒造他的主；","poem":1},{"lineBreak":true},{"text":"幸災樂禍的，必不免受罰。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"子孫為老人的冠冕；","poem":1},{"lineBreak":true},{"text":"父親是兒女的榮耀。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愚頑人說美言本不相宜，","poem":1},{"lineBreak":true},{"text":"何況君王說謊話呢？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"賄賂在餽送的人眼中看為寶玉，","poem":1},{"lineBreak":true},{"text":"隨處運動都得順利。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"遮掩人過的，尋求人愛；","poem":1},{"lineBreak":true},{"text":"屢次挑錯的，離間密友。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"一句責備話深入聰明人的心，","poem":1},{"lineBreak":true},{"text":"強如責打愚昧人一百下。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"惡人只尋背叛，","poem":1},{"lineBreak":true},{"text":"所以必有嚴厲的使者奉差攻擊他。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"寧可遇見丟崽子的母熊，","poem":1},{"lineBreak":true},{"text":"不可遇見正行愚妄的愚昧人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"以惡報善的，","poem":1},{"lineBreak":true},{"text":"禍患必不離他的家。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"紛爭的起頭如水放開，","poem":1},{"lineBreak":true},{"text":"所以，在爭鬧之先必當止息爭競。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"定惡人為義的，定義人為惡的，","poem":1},{"lineBreak":true},{"text":"這都為耶和華所憎惡。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"愚昧人既無聰明，","poem":1},{"lineBreak":true},{"text":"為何手拿價銀買智慧呢？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"朋友乃時常親愛，","poem":1},{"lineBreak":true},{"text":"弟兄為患難而生。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"在鄰舍面前擊掌作保","poem":1},{"lineBreak":true},{"text":"乃是無知的人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"喜愛爭競的，是喜愛過犯；","poem":1},{"lineBreak":true},{"text":"高立家門的，乃自取敗壞。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"心存邪僻的，尋不着好處；","poem":1},{"lineBreak":true},{"text":"舌弄是非的，陷在禍患中。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"生愚昧子的，必自愁苦；","poem":1},{"lineBreak":true},{"text":"愚頑人的父毫無喜樂。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"喜樂的心乃是良藥；","poem":1},{"lineBreak":true},{"text":"憂傷的靈使骨枯乾。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"惡人暗中受賄賂，","poem":1},{"lineBreak":true},{"text":"為要顛倒判斷。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"明哲人眼前有智慧；","poem":1},{"lineBreak":true},{"text":"愚昧人眼望地極。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"愚昧子使父親愁煩，","poem":1},{"lineBreak":true},{"text":"使母親憂苦。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"刑罰義人為不善；","poem":1},{"lineBreak":true},{"text":"責打君子為不義。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"寡少言語的，有知識；","poem":1},{"lineBreak":true},{"text":"性情溫良的，有聰明。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"愚昧人若靜默不言也可算為智慧；","poem":1},{"lineBreak":true},{"text":"閉口不說也可算為聰明。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}