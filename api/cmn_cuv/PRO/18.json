{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"與眾寡合的，獨自尋求心願，","poem":1},{"lineBreak":true},{"text":"並惱恨一切真智慧。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"愚昧人不喜愛明哲，","poem":1},{"lineBreak":true},{"text":"只喜愛顯露心意。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"惡人來，藐視隨來；","poem":1},{"lineBreak":true},{"text":"羞恥到，辱罵同到。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"人口中的言語如同深水；","poem":1},{"lineBreak":true},{"text":"智慧的泉源好像湧流的河水。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"瞻徇惡人的情面，","poem":1},{"lineBreak":true},{"text":"偏斷義人的案件，都為不善。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"愚昧人張嘴啟爭端，","poem":1},{"lineBreak":true},{"text":"開口招鞭打。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愚昧人的口自取敗壞；","poem":1},{"lineBreak":true},{"text":"他的嘴是他生命的網羅。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"傳舌人的言語如同美食，","poem":1},{"lineBreak":true},{"text":"深入人的心腹。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"做工懈怠的，","poem":1},{"lineBreak":true},{"text":"與浪費人為弟兄。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華的名是堅固臺；","poem":1},{"lineBreak":true},{"text":"義人奔入便得安穩。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"富足人的財物是他的堅城，","poem":1},{"lineBreak":true},{"text":"在他心想，猶如高牆。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"敗壞之先，人心驕傲；","poem":1},{"lineBreak":true},{"text":"尊榮以前，必有謙卑。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"未曾聽完先回答的，","poem":1},{"lineBreak":true},{"text":"便是他的愚昧和羞辱。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"人有疾病，心能忍耐；","poem":1},{"lineBreak":true},{"text":"心靈憂傷，誰能承當呢？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"聰明人的心得知識；","poem":1},{"lineBreak":true},{"text":"智慧人的耳求知識。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"人的禮物為他開路，","poem":1},{"lineBreak":true},{"text":"引他到高位的人面前。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"先訴情由的，似乎有理；","poem":1},{"lineBreak":true},{"text":"但鄰舍來到，就察出實情。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"掣籤能止息爭競，","poem":1},{"lineBreak":true},{"text":"也能解散強勝的人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"弟兄結怨，勸他和好，比取堅固城還難；","poem":1},{"lineBreak":true},{"text":"這樣的爭競如同堅寨的門閂。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"人口中所結的果子，必充滿肚腹；","poem":1},{"lineBreak":true},{"text":"他嘴所出的，必使他飽足。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"生死在舌頭的權下，","poem":1},{"lineBreak":true},{"text":"喜愛它的，必吃它所結的果子。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"得着賢妻的，是得着好處，","poem":1},{"lineBreak":true},{"text":"也是蒙了耶和華的恩惠。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"貧窮人說哀求的話；","poem":1},{"lineBreak":true},{"text":"富足人用威嚇的話回答。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"濫交朋友的，自取敗壞；","poem":1},{"lineBreak":true},{"text":"但有一朋友比弟兄更親密。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}