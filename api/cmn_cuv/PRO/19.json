{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"行為純正的貧窮人","poem":1},{"lineBreak":true},{"text":"勝過乖謬愚妄的富足人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"心無知識的，乃為不善；","poem":1},{"lineBreak":true},{"text":"腳步急快的，難免犯罪。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"人的愚昧傾敗他的道；","poem":1},{"lineBreak":true},{"text":"他的心也抱怨耶和華。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"財物使朋友增多；","poem":1},{"lineBreak":true},{"text":"但窮人朋友遠離。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"作假見證的，必不免受罰；","poem":1},{"lineBreak":true},{"text":"吐出謊言的，終不能逃脫。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"好施散的，有多人求他的恩情；","poem":1},{"lineBreak":true},{"text":"愛送禮的，人都為他的朋友。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"貧窮人，弟兄都恨他；","poem":1},{"lineBreak":true},{"text":"何況他的朋友，更遠離他！","poem":1},{"lineBreak":true},{"text":"他用言語追隨，他們卻走了。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"得着智慧的，愛惜生命；","poem":1},{"lineBreak":true},{"text":"保守聰明的，必得好處。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"作假見證的，不免受罰；","poem":1},{"lineBreak":true},{"text":"吐出謊言的，也必滅亡。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"愚昧人宴樂度日是不合宜的；","poem":1},{"lineBreak":true},{"text":"何況僕人管轄王子呢？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"人有見識就不輕易發怒；","poem":1},{"lineBreak":true},{"text":"寬恕人的過失便是自己的榮耀。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"王的忿怒好像獅子吼叫；","poem":1},{"lineBreak":true},{"text":"他的恩典卻如草上的甘露。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"愚昧的兒子是父親的禍患；","poem":1},{"lineBreak":true},{"text":"妻子的爭吵如雨連連滴漏。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"房屋錢財是祖宗所遺留的；","poem":1},{"lineBreak":true},{"text":"惟有賢慧的妻是耶和華所賜的。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"懶惰使人沉睡；","poem":1},{"lineBreak":true},{"text":"懈怠的人必受飢餓。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"謹守誡命的，保全生命；","poem":1},{"lineBreak":true},{"text":"輕忽己路的，必致死亡。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"憐憫貧窮的，就是借給耶和華；","poem":1},{"lineBreak":true},{"text":"他的善行，耶和華必償還。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"趁有指望，管教你的兒子；","poem":1},{"lineBreak":true},{"text":"你的心不可任他死亡。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"暴怒的人必受刑罰；","poem":1},{"lineBreak":true},{"text":"你若救他，必須再救。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你要聽勸教，受訓誨，","poem":1},{"lineBreak":true},{"text":"使你終久有智慧。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"人心多有計謀；","poem":1},{"lineBreak":true},{"text":"惟有耶和華的籌算才能立定。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"施行仁慈的，令人愛慕；","poem":1},{"lineBreak":true},{"text":"窮人強如說謊言的。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"敬畏耶和華的，得着生命；","poem":1},{"lineBreak":true},{"text":"他必恆久知足，不遭禍患。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"懶惰人放手在盤子裏，","poem":1},{"lineBreak":true},{"text":"就是向口撤回，他也不肯。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"鞭打褻慢人，愚蒙人必長見識；","poem":1},{"lineBreak":true},{"text":"責備明哲人，他就明白知識。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"虐待父親、攆出母親的，","poem":1},{"lineBreak":true},{"text":"是貽羞致辱之子。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"我兒，不可聽了教訓","poem":1},{"lineBreak":true},{"text":"而又偏離知識的言語。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"匪徒作見證戲笑公平；","poem":1},{"lineBreak":true},{"text":"惡人的口吞下罪孽。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"刑罰是為褻慢人預備的；","poem":1},{"lineBreak":true},{"text":"鞭打是為愚昧人的背預備的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}