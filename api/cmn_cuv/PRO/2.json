{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":2,"content":[{"type":"heading","content":["智慧的賞賜"]},{"type":"verse","number":1,"content":[{"text":"我兒，你若領受我的言語，","poem":1},{"lineBreak":true},{"text":"存記我的命令，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"側耳聽智慧，","poem":1},{"lineBreak":true},{"text":"專心求聰明，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"呼求明哲，","poem":1},{"lineBreak":true},{"text":"揚聲求聰明，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"尋找它，如尋找銀子，","poem":1},{"lineBreak":true},{"text":"搜求它，如搜求隱藏的珍寶，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你就明白敬畏耶和華，","poem":1},{"lineBreak":true},{"text":"得以認識上帝。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因為，耶和華賜人智慧；","poem":1},{"lineBreak":true},{"text":"知識和聰明都由他口而出。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他給正直人存留真智慧，","poem":1},{"lineBreak":true},{"text":"給行為純正的人作盾牌，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"為要保守公平人的路，","poem":1},{"lineBreak":true},{"text":"護庇虔敬人的道。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"你也必明白仁義、公平、","poem":1},{"lineBreak":true},{"text":"正直、一切的善道。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"智慧必入你心；","poem":1},{"lineBreak":true},{"text":"你的靈要以知識為美。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"謀略必護衛你；","poem":1},{"lineBreak":true},{"text":"聰明必保守你，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"要救你脫離惡道","poem":1},{"noteId":1},{"text":"，","poem":1},{"lineBreak":true},{"text":"脫離說乖謬話的人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"那等人捨棄正直的路，","poem":1},{"lineBreak":true},{"text":"行走黑暗的道，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"歡喜作惡，","poem":1},{"lineBreak":true},{"text":"喜愛惡人的乖僻，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"在他們的道中彎曲，","poem":1},{"lineBreak":true},{"text":"在他們的路上偏僻。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"智慧要救你脫離淫婦，","poem":1},{"lineBreak":true},{"text":"就是那油嘴滑舌的外女。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"她離棄幼年的配偶，","poem":1},{"lineBreak":true},{"text":"忘了上帝的盟約。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"她的家陷入死地；","poem":1},{"lineBreak":true},{"text":"她的路偏向陰間。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"凡到她那裏去的，不得轉回，","poem":1},{"lineBreak":true},{"text":"也得不着生命的路。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"智慧必使你行善人的道，","poem":1},{"lineBreak":true},{"text":"守義人的路。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"正直人必在世上居住；","poem":1},{"lineBreak":true},{"text":"完全人必在地上存留。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"惟有惡人必然剪除；","poem":1},{"lineBreak":true},{"text":"奸詐的，必然拔出。","poem":1}]}],"footnotes":[{"noteId":1,"caller":"-","text":"或譯：惡人的道","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/cmn_cuv/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}