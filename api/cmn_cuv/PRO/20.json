{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"酒能使人褻慢，濃酒使人喧嚷；","poem":1},{"lineBreak":true},{"text":"凡因酒錯誤的，就無智慧。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"王的威嚇如同獅子吼叫；","poem":1},{"lineBreak":true},{"text":"惹動他怒的，是自害己命。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"遠離紛爭是人的尊榮；","poem":1},{"lineBreak":true},{"text":"愚妄人都愛爭鬧。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"懶惰人因冬寒不肯耕種，","poem":1},{"lineBreak":true},{"text":"到收割的時候，他必討飯而無所得。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"人心懷藏謀略，好像深水，","poem":1},{"lineBreak":true},{"text":"惟明哲人才能汲引出來。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"人多述說自己的仁慈，","poem":1},{"lineBreak":true},{"text":"但忠信人誰能遇着呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"行為純正的義人，","poem":1},{"lineBreak":true},{"text":"他的子孫是有福的！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"王坐在審判的位上，","poem":1},{"lineBreak":true},{"text":"以眼目驅散諸惡。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"誰能說，我潔淨了我的心，","poem":1},{"lineBreak":true},{"text":"我脫淨了我的罪？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"兩樣的法碼，兩樣的升斗，","poem":1},{"lineBreak":true},{"text":"都為耶和華所憎惡。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"孩童的動作是清潔，是正直，","poem":1},{"lineBreak":true},{"text":"都顯明他的本性。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"能聽的耳，能看的眼，","poem":1},{"lineBreak":true},{"text":"都是耶和華所造的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"不要貪睡，免致貧窮；","poem":1},{"lineBreak":true},{"text":"眼要睜開，你就吃飽。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"買物的說：不好，不好；","poem":1},{"lineBreak":true},{"text":"及至買去，他便自誇。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"有金子和許多珍珠","poem":1},{"noteId":18},{"text":"，","poem":1},{"lineBreak":true},{"text":"惟有知識的嘴乃為貴重的珍寶。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"誰為生人作保，就拿誰的衣服；","poem":1},{"lineBreak":true},{"text":"誰為外人作保，誰就要承當。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"以虛謊而得的食物，人覺甘甜；","poem":1},{"lineBreak":true},{"text":"但後來，他的口必充滿塵沙。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"計謀都憑籌算立定；","poem":1},{"lineBreak":true},{"text":"打仗要憑智謀。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"往來傳舌的，洩漏密事；","poem":1},{"lineBreak":true},{"text":"大張嘴的，不可與他結交。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"咒罵父母的，他的燈必滅，","poem":1},{"lineBreak":true},{"text":"變為漆黑的黑暗。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"起初速得的產業，","poem":1},{"lineBreak":true},{"text":"終久卻不為福。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你不要說，我要以惡報惡；","poem":1},{"lineBreak":true},{"text":"要等候耶和華，他必拯救你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"兩樣的法碼為耶和華所憎惡；","poem":1},{"lineBreak":true},{"text":"詭詐的天平也為不善。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"人的腳步為耶和華所定；","poem":1},{"lineBreak":true},{"text":"人豈能明白自己的路呢？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"人冒失說，這是聖物，","poem":1},{"lineBreak":true},{"text":"許願之後才查問，就是自陷網羅。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"智慧的王簸散惡人，","poem":1},{"lineBreak":true},{"text":"用碌碡滾軋他們。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"人的靈是耶和華的燈，","poem":1},{"lineBreak":true},{"text":"鑒察人的心腹。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"王因仁慈和誠實得以保全他的國位，","poem":1},{"lineBreak":true},{"text":"也因仁慈立穩。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"強壯乃少年人的榮耀；","poem":1},{"lineBreak":true},{"text":"白髮為老年人的尊榮。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"鞭傷除淨人的罪惡；","poem":1},{"lineBreak":true},{"text":"責打能入人的心腹。","poem":1}]}],"footnotes":[{"noteId":18,"caller":"-","text":"或譯：紅寶石","reference":{"chapter":20,"verse":15}}]},"thisChapterLink":"/api/cmn_cuv/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}