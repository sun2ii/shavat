{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"王的心在耶和華手中，","poem":1},{"lineBreak":true},{"text":"好像隴溝的水隨意流轉。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"人所行的，在自己眼中都看為正；","poem":1},{"lineBreak":true},{"text":"惟有耶和華衡量人心。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"行仁義公平","poem":1},{"lineBreak":true},{"text":"比獻祭更蒙耶和華悅納。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"惡人發達","poem":1},{"noteId":19},{"text":"，眼高心傲，","poem":1},{"lineBreak":true},{"text":"這乃是罪。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"殷勤籌劃的，足致豐裕；","poem":1},{"lineBreak":true},{"text":"行事急躁的，都必缺乏。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"用詭詐之舌求財的，就是自己取死；","poem":1},{"lineBreak":true},{"text":"所得之財乃是吹來吹去的浮雲。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"惡人的強暴必將自己掃除，","poem":1},{"lineBreak":true},{"text":"因他們不肯按公平行事。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"負罪之人的路甚是彎曲；","poem":1},{"lineBreak":true},{"text":"至於清潔的人，他所行的乃是正直。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"寧可住在房頂的角上，","poem":1},{"lineBreak":true},{"text":"不在寬闊的房屋與爭吵的婦人同住。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"惡人的心樂人受禍；","poem":1},{"lineBreak":true},{"text":"他眼並不憐恤鄰舍。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"褻慢的人受刑罰，愚蒙的人就得智慧；","poem":1},{"lineBreak":true},{"text":"智慧人受訓誨，便得知識。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"義人思想惡人的家，","poem":1},{"lineBreak":true},{"text":"知道惡人傾倒，必致滅亡。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"塞耳不聽窮人哀求的，","poem":1},{"lineBreak":true},{"text":"他將來呼籲也不蒙應允。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"暗中送的禮物挽回怒氣；","poem":1},{"lineBreak":true},{"text":"懷中搋的賄賂止息暴怒。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"秉公行義使義人喜樂，","poem":1},{"lineBreak":true},{"text":"使作孽的人敗壞。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"迷離通達道路的，","poem":1},{"lineBreak":true},{"text":"必住在陰魂的會中。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"愛宴樂的，必致窮乏；","poem":1},{"lineBreak":true},{"text":"好酒，愛膏油的，必不富足。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"惡人作了義人的贖價；","poem":1},{"lineBreak":true},{"text":"奸詐人代替正直人。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"寧可住在曠野，","poem":1},{"lineBreak":true},{"text":"不與爭吵使氣的婦人同住。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"智慧人家中積蓄寶物膏油；","poem":1},{"lineBreak":true},{"text":"愚昧人隨得來隨吞下。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"追求公義仁慈的，","poem":1},{"lineBreak":true},{"text":"就尋得生命、公義，和尊榮。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"智慧人爬上勇士的城牆，","poem":1},{"lineBreak":true},{"text":"傾覆他所倚靠的堅壘。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"謹守口與舌的，","poem":1},{"lineBreak":true},{"text":"就保守自己免受災難。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"心驕氣傲的人名叫褻慢；","poem":1},{"lineBreak":true},{"text":"他行事狂妄，都出於驕傲。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"懶惰人的心願將他殺害，","poem":1},{"lineBreak":true},{"text":"因為他手不肯做工。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"有終日貪得無饜的；","poem":1},{"lineBreak":true},{"text":"義人施捨而不吝惜。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"惡人的祭物是可憎的；","poem":1},{"lineBreak":true},{"text":"何況他存惡意來獻呢？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"作假見證的必滅亡；","poem":1},{"lineBreak":true},{"text":"惟有聽真情而言的，其言長存。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"惡人臉無羞恥；","poem":1},{"lineBreak":true},{"text":"正直人行事堅定。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"沒有人能以智慧、聰明、","poem":1},{"lineBreak":true},{"text":"謀略敵擋耶和華。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"馬是為打仗之日預備的；","poem":1},{"lineBreak":true},{"text":"得勝乃在乎耶和華。","poem":1}]}],"footnotes":[{"noteId":19,"caller":"-","text":"發達：原文是燈","reference":{"chapter":21,"verse":4}}]},"thisChapterLink":"/api/cmn_cuv/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}