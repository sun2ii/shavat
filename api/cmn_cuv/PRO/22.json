{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"美名勝過大財；","poem":1},{"lineBreak":true},{"text":"恩寵強如金銀。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"富戶窮人在世相遇，","poem":1},{"lineBreak":true},{"text":"都為耶和華所造。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"通達人見禍藏躲；","poem":1},{"lineBreak":true},{"text":"愚蒙人前往受害。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"敬畏耶和華心存謙卑，","poem":1},{"lineBreak":true},{"text":"就得富有、尊榮、生命為賞賜。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"乖僻人的路上有荊棘和網羅；","poem":1},{"lineBreak":true},{"text":"保守自己生命的，必要遠離。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"教養孩童，使他走當行的道，","poem":1},{"lineBreak":true},{"text":"就是到老他也不偏離。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"富戶管轄窮人；","poem":1},{"lineBreak":true},{"text":"欠債的是債主的僕人。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"撒罪孽的，必收災禍；","poem":1},{"lineBreak":true},{"text":"他逞怒的杖也必廢掉。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"眼目慈善的，就必蒙福，","poem":1},{"lineBreak":true},{"text":"因他將食物分給窮人。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"趕出褻慢人，爭端就消除；","poem":1},{"lineBreak":true},{"text":"紛爭和羞辱也必止息。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"喜愛清心的人因他嘴上的恩言，","poem":1},{"lineBreak":true},{"text":"王必與他為友。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和華的眼目眷顧聰明人，","poem":1},{"lineBreak":true},{"text":"卻傾敗奸詐人的言語。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"懶惰人說：外頭有獅子；","poem":1},{"lineBreak":true},{"text":"我在街上就必被殺。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"淫婦的口為深坑；","poem":1},{"lineBreak":true},{"text":"耶和華所憎惡的，必陷在其中。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"愚蒙迷住孩童的心，","poem":1},{"lineBreak":true},{"text":"用管教的杖可以遠遠趕除。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"欺壓貧窮為要利己的，","poem":1},{"lineBreak":true},{"text":"並送禮與富戶的，都必缺乏。","poem":1}]},{"type":"heading","content":["智言三十則"]},{"type":"verse","number":17,"content":[{"text":"你須側耳聽受智慧人的言語，","poem":1},{"lineBreak":true},{"text":"留心領會我的知識。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你若心中存記，","poem":1},{"lineBreak":true},{"text":"嘴上咬定，這便為美。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我今日以此特特指教你，","poem":1},{"lineBreak":true},{"text":"為要使你倚靠耶和華。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"謀略和知識的美事，","poem":1},{"lineBreak":true},{"text":"我豈沒有寫給你嗎？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"要使你知道真言的實理，","poem":1},{"lineBreak":true},{"text":"你好將真言回覆那打發你來的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"貧窮人，你不可因他貧窮就搶奪他的物，","poem":1},{"lineBreak":true},{"text":"也不可在城門口欺壓困苦人；","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"因耶和華必為他辨屈；","poem":1},{"lineBreak":true},{"text":"搶奪他的，耶和華必奪取那人的命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"好生氣的人，不可與他結交；","poem":1},{"lineBreak":true},{"text":"暴怒的人，不可與他來往；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"恐怕你效法他的行為，","poem":1},{"lineBreak":true},{"text":"自己就陷在網羅裏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"不要與人擊掌，","poem":1},{"lineBreak":true},{"text":"不要為欠債的作保。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"你若沒有甚麼償還，","poem":1},{"lineBreak":true},{"text":"何必使人奪去你睡臥的床呢？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你先祖所立的地界，","poem":1},{"lineBreak":true},{"text":"你不可挪移。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"你看見辦事殷勤的人嗎？","poem":1},{"lineBreak":true},{"text":"他必站在君王面前，","poem":1},{"lineBreak":true},{"text":"必不站在下賤人面前。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}