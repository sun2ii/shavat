{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"你若與官長坐席，","poem":1},{"lineBreak":true},{"text":"要留意在你面前的是誰。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你若是貪食的，","poem":1},{"lineBreak":true},{"text":"就當拿刀放在喉嚨上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"不可貪戀他的美食，","poem":1},{"lineBreak":true},{"text":"因為是哄人的食物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"不要勞碌求富，","poem":1},{"lineBreak":true},{"text":"休仗自己的聰明。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你豈要定睛在虛無的錢財上嗎？","poem":1},{"lineBreak":true},{"text":"因錢財必長翅膀，如鷹向天飛去。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"不要吃惡眼人的飯，","poem":1},{"lineBreak":true},{"text":"也不要貪他的美味；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因為他心怎樣思量，","poem":1},{"lineBreak":true},{"text":"他為人就是怎樣。","poem":1},{"lineBreak":true},{"text":"他雖對你說，請吃，請喝，","poem":1},{"lineBreak":true},{"text":"他的心卻與你相背。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你所吃的那點食物必吐出來；","poem":1},{"lineBreak":true},{"text":"你所說的甘美言語也必落空。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"你不要說話給愚昧人聽，","poem":1},{"lineBreak":true},{"text":"因他必藐視你智慧的言語。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"不可挪移古時的地界，","poem":1},{"lineBreak":true},{"text":"也不可侵入孤兒的田地；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因他們的救贖主大有能力，","poem":1},{"lineBreak":true},{"text":"他必向你為他們辨屈。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"你要留心領受訓誨，","poem":1},{"lineBreak":true},{"text":"側耳聽從知識的言語。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"不可不管教孩童；","poem":1},{"lineBreak":true},{"text":"你用杖打他，他必不至於死。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你要用杖打他，","poem":1},{"lineBreak":true},{"text":"就可以救他的靈魂免下陰間。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"我兒，你心若存智慧，","poem":1},{"lineBreak":true},{"text":"我的心也甚歡喜。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你的嘴若說正直話，","poem":1},{"lineBreak":true},{"text":"我的心腸也必快樂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"你心中不要嫉妒罪人，","poem":1},{"lineBreak":true},{"text":"只要終日敬畏耶和華；","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"因為至終必有善報，","poem":1},{"lineBreak":true},{"text":"你的指望也不致斷絕。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"我兒，你當聽，當存智慧，","poem":1},{"lineBreak":true},{"text":"好在正道上引導你的心。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"好飲酒的，好吃肉的，","poem":1},{"lineBreak":true},{"text":"不要與他們來往；","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"因為好酒貪食的，必致貧窮；","poem":1},{"lineBreak":true},{"text":"好睡覺的，必穿破爛衣服。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"你要聽從生你的父親；","poem":1},{"lineBreak":true},{"text":"你母親老了，也不可藐視她。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你當買真理；","poem":1},{"lineBreak":true},{"text":"就是智慧、訓誨，和聰明也都不可賣。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"義人的父親必大得快樂；","poem":1},{"lineBreak":true},{"text":"人生智慧的兒子，必因他歡喜。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你要使父母歡喜，","poem":1},{"lineBreak":true},{"text":"使生你的快樂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"我兒，要將你的心歸我；","poem":1},{"lineBreak":true},{"text":"你的眼目也要喜悅我的道路。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"妓女是深坑；","poem":1},{"lineBreak":true},{"text":"外女是窄阱。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"她埋伏好像強盜；","poem":1},{"lineBreak":true},{"text":"她使人中多有奸詐的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"誰有禍患？誰有憂愁？","poem":1},{"lineBreak":true},{"text":"誰有爭鬥？誰有哀歎","poem":1},{"noteId":20},{"text":"？","poem":1},{"lineBreak":true},{"text":"誰無故受傷？誰眼目紅赤？","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"就是那流連飲酒、","poem":1},{"lineBreak":true},{"text":"常去尋找調和酒的人。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"酒發紅，在杯中閃爍，","poem":1},{"lineBreak":true},{"text":"你不可觀看，","poem":1},{"lineBreak":true},{"text":"雖然下咽舒暢，","poem":1},{"lineBreak":true},{"text":"終久是咬你如蛇，刺你如毒蛇。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"你眼必看見異怪的事","poem":1},{"noteId":21},{"text":"；","poem":1},{"lineBreak":true},{"text":"你心必發出乖謬的話。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你必像躺在海中，","poem":1},{"lineBreak":true},{"text":"或像臥在桅杆上。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"你必說：人打我，我卻未受傷；","poem":1},{"lineBreak":true},{"text":"人鞭打我，我竟不覺得。","poem":1},{"lineBreak":true},{"text":"我幾時清醒，我仍去尋酒。","poem":1}]}],"footnotes":[{"noteId":20,"caller":"-","text":"或譯：怨言","reference":{"chapter":23,"verse":29}},{"noteId":21,"caller":"-","text":"或譯：淫婦","reference":{"chapter":23,"verse":33}}]},"thisChapterLink":"/api/cmn_cuv/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":34}