{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"你不要嫉妒惡人，","poem":1},{"lineBreak":true},{"text":"也不要起意與他們相處；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為，他們的心圖謀強暴，","poem":1},{"lineBreak":true},{"text":"他們的口談論奸惡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"房屋因智慧建造，","poem":1},{"lineBreak":true},{"text":"又因聰明立穩；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"其中因知識充滿各樣美好寶貴的財物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"智慧人大有能力；","poem":1},{"lineBreak":true},{"text":"有知識的人力上加力。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你去打仗，要憑智謀；","poem":1},{"lineBreak":true},{"text":"謀士眾多，人便得勝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"智慧極高，非愚昧人所能及，","poem":1},{"lineBreak":true},{"text":"所以在城門內不敢開口。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"設計作惡的，","poem":1},{"lineBreak":true},{"text":"必稱為奸人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"愚妄人的思念乃是罪惡；","poem":1},{"lineBreak":true},{"text":"褻慢者為人所憎惡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你在患難之日若膽怯，","poem":1},{"lineBreak":true},{"text":"你的力量就微小。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"人被拉到死地，你要解救；","poem":1},{"lineBreak":true},{"text":"人將被殺，你須攔阻。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你若說：這事我未曾知道，","poem":1},{"lineBreak":true},{"text":"那衡量人心的豈不明白嗎？","poem":1},{"lineBreak":true},{"text":"保守你命的豈不知道嗎？","poem":1},{"lineBreak":true},{"text":"他豈不按各人所行的報應各人嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我兒，你要吃蜜，因為是好的；","poem":1},{"lineBreak":true},{"text":"吃蜂房下滴的蜜便覺甘甜。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你心得了智慧，也必覺得如此。","poem":1},{"lineBreak":true},{"text":"你若找着，至終必有善報；","poem":1},{"lineBreak":true},{"text":"你的指望也不致斷絕。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"你這惡人，不要埋伏攻擊義人的家；","poem":1},{"lineBreak":true},{"text":"不要毀壞他安居之所。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因為，義人雖七次跌倒，仍必興起；","poem":1},{"lineBreak":true},{"text":"惡人卻被禍患傾倒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"你仇敵跌倒，你不要歡喜；","poem":1},{"lineBreak":true},{"text":"他傾倒，你心不要快樂；","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"恐怕耶和華看見就不喜悅，","poem":1},{"lineBreak":true},{"text":"將怒氣從仇敵身上轉過來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"不要為作惡的心懷不平，","poem":1},{"lineBreak":true},{"text":"也不要嫉妒惡人；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"因為，惡人終不得善報；","poem":1},{"lineBreak":true},{"text":"惡人的燈也必熄滅。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"我兒，你要敬畏耶和華與君王，","poem":1},{"lineBreak":true},{"text":"不要與反覆無常的人結交，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因為他們的災難必忽然而起。","poem":1},{"lineBreak":true},{"text":"耶和華與君王所施行的毀滅，","poem":1},{"lineBreak":true},{"text":"誰能知道呢？","poem":1}]},{"type":"heading","content":["其他智言"]},{"type":"verse","number":23,"content":[{"text":"以下也是智慧人的箴言：","poem":1},{"lineBreak":true},{"text":"審判時看人情面是不好的。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"對惡人說「你是義人」的，","poem":1},{"lineBreak":true},{"text":"這人萬民必咒詛，列邦必憎惡。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"責備惡人的，必得喜悅；","poem":1},{"lineBreak":true},{"text":"美好的福也必臨到他。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"應對正直的，猶如與人親嘴。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"你要在外頭預備工料，","poem":1},{"lineBreak":true},{"text":"在田間辦理整齊，","poem":1},{"lineBreak":true},{"text":"然後建造房屋。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"不可無故作見證陷害鄰舍，","poem":1},{"lineBreak":true},{"text":"也不可用嘴欺騙人。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"不可說：人怎樣待我，我也怎樣待他；","poem":1},{"lineBreak":true},{"text":"我必照他所行的報復他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"我經過懶惰人的田地、","poem":1},{"lineBreak":true},{"text":"無知人的葡萄園，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"荊棘長滿了地皮，","poem":1},{"lineBreak":true},{"text":"刺草遮蓋了田面，","poem":1},{"lineBreak":true},{"text":"石牆也坍塌了。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"我看見就留心思想；","poem":1},{"lineBreak":true},{"text":"我看着就領了訓誨。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"再睡片時，打盹片時，","poem":1},{"lineBreak":true},{"text":"抱着手躺臥片時，","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你的貧窮就必如強盜速來，","poem":1},{"lineBreak":true},{"text":"你的缺乏彷彿拿兵器的人來到。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}