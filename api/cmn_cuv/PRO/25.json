{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":25,"content":[{"type":"heading","content":["所羅門的另一些箴言"]},{"type":"verse","number":1,"content":[{"text":"以下也是所羅門的箴言，是猶大王希西家的人所謄錄的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"將事隱祕乃上帝的榮耀；","poem":1},{"lineBreak":true},{"text":"將事察清乃君王的榮耀。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"天之高，地之厚，","poem":1},{"lineBreak":true},{"text":"君王之心也測不透。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"除去銀子的渣滓就有銀子出來，","poem":1},{"lineBreak":true},{"text":"銀匠能以做器皿。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"除去王面前的惡人，","poem":1},{"lineBreak":true},{"text":"國位就靠公義堅立。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"不要在王面前妄自尊大；","poem":1},{"lineBreak":true},{"text":"不要在大人的位上站立。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"寧可有人說：請你上來，","poem":1},{"lineBreak":true},{"text":"強如在你覲見的王子面前叫你退下。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"不要冒失出去與人爭競，","poem":1},{"lineBreak":true},{"text":"免得至終被他羞辱，","poem":1},{"lineBreak":true},{"text":"你就不知道怎樣行了。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你與鄰舍爭訟，","poem":1},{"lineBreak":true},{"text":"要與他一人辯論，","poem":1},{"lineBreak":true},{"text":"不可洩漏人的密事，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"恐怕聽見的人罵你，","poem":1},{"lineBreak":true},{"text":"你的臭名就難以脫離。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"一句話說得合宜，","poem":1},{"lineBreak":true},{"text":"就如金蘋果在銀網子裏。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"智慧人的勸戒，在順從的人耳中，","poem":1},{"lineBreak":true},{"text":"好像金耳環和精金的妝飾。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"忠信的使者叫差他的人心裏舒暢，","poem":1},{"lineBreak":true},{"text":"就如在收割時有冰雪的涼氣。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"空誇贈送禮物的，","poem":1},{"lineBreak":true},{"text":"好像無雨的風雲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"恆常忍耐可以勸動君王；","poem":1},{"lineBreak":true},{"text":"柔和的舌頭能折斷骨頭。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你得了蜜嗎？只可吃夠而已，","poem":1},{"lineBreak":true},{"text":"恐怕你過飽就嘔吐出來。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"你的腳要少進鄰舍的家，","poem":1},{"lineBreak":true},{"text":"恐怕他厭煩你，恨惡你。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"作假見證陷害鄰舍的，","poem":1},{"lineBreak":true},{"text":"就是大槌，是利刀，是快箭。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"患難時倚靠不忠誠的人，","poem":1},{"lineBreak":true},{"text":"好像破壞的牙，錯骨縫的腳。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"對傷心的人唱歌，","poem":1},{"lineBreak":true},{"text":"就如冷天脫衣服，","poem":1},{"lineBreak":true},{"text":"又如鹼上倒醋。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你的仇敵若餓了，就給他飯吃；","poem":1},{"lineBreak":true},{"text":"若渴了，就給他水喝；","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因為，你這樣行就是把炭火堆在他的頭上；","poem":1},{"lineBreak":true},{"text":"耶和華也必賞賜你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"北風生雨，","poem":1},{"lineBreak":true},{"text":"讒謗人的舌頭也生怒容。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"寧可住在房頂的角上，","poem":1},{"lineBreak":true},{"text":"不在寬闊的房屋與爭吵的婦人同住。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"有好消息從遠方來，","poem":1},{"lineBreak":true},{"text":"就如拿涼水給口渴的人喝。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"義人在惡人面前退縮，","poem":1},{"lineBreak":true},{"text":"好像詵渾之泉，弄濁之井。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"吃蜜過多是不好的；","poem":1},{"lineBreak":true},{"text":"考究自己的榮耀也是可厭的。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"人不制伏自己的心，","poem":1},{"lineBreak":true},{"text":"好像毀壞的城邑沒有牆垣。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}