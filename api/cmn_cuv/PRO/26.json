{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"夏天落雪，收割時下雨，都不相宜；","poem":1},{"lineBreak":true},{"text":"愚昧人得尊榮也是如此。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"麻雀往來，燕子翻飛；","poem":1},{"lineBreak":true},{"text":"這樣，無故的咒詛也必不臨到。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"鞭子是為打馬，轡頭是為勒驢；","poem":1},{"lineBreak":true},{"text":"刑杖是為打愚昧人的背。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"不要照愚昧人的愚妄話回答他，","poem":1},{"lineBreak":true},{"text":"恐怕你與他一樣。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要照愚昧人的愚妄話回答他，","poem":1},{"lineBreak":true},{"text":"免得他自以為有智慧。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"藉愚昧人手寄信的，","poem":1},{"lineBreak":true},{"text":"是砍斷自己的腳，自受","poem":1},{"noteId":22},{"text":"損害。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"瘸子的腳空存無用；","poem":1},{"lineBreak":true},{"text":"箴言在愚昧人的口中也是如此。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"將尊榮給愚昧人的，","poem":1},{"lineBreak":true},{"text":"好像人把石子包在機弦裏。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"箴言在愚昧人的口中，","poem":1},{"lineBreak":true},{"text":"好像荊棘刺入醉漢的手。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"雇愚昧人的，與雇過路人的，","poem":1},{"lineBreak":true},{"text":"就像射傷眾人的弓箭手。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"愚昧人行愚妄事，行了又行，","poem":1},{"lineBreak":true},{"text":"就如狗轉過來吃牠所吐的。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你見自以為有智慧的人嗎？","poem":1},{"lineBreak":true},{"text":"愚昧人比他更有指望。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"懶惰人說：道上有猛獅，","poem":1},{"lineBreak":true},{"text":"街上有壯獅。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"門在樞紐轉動，","poem":1},{"lineBreak":true},{"text":"懶惰人在床上也是如此。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"懶惰人放手在盤子裏，","poem":1},{"lineBreak":true},{"text":"就是向口撤回也以為勞乏。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"懶惰人看自己比七個善於應對的人更有智慧。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"過路被事激動，管理不干己的爭競，","poem":1},{"lineBreak":true},{"text":"好像人揪住狗耳。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"人欺凌鄰舍，卻說：","poem":1},{"lineBreak":true},{"text":"我豈不是戲耍嗎？","poem":1},{"lineBreak":true},{"text":"他就像瘋狂的人拋擲火把、利箭，","poem":1},{"lineBreak":true},{"text":"與殺人的兵器","poem":1},{"noteId":23},{"text":"。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"火缺了柴就必熄滅；","poem":1},{"lineBreak":true},{"text":"無人傳舌，爭競便止息。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"好爭競的人煽惑爭端，","poem":1},{"lineBreak":true},{"text":"就如餘火加炭，火上加柴一樣。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"傳舌人的言語，如同美食，","poem":1},{"lineBreak":true},{"text":"深入人的心腹。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"火熱的嘴，奸惡的心，","poem":1},{"lineBreak":true},{"text":"好像銀渣包的瓦器。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"怨恨人的，用嘴粉飾，","poem":1},{"lineBreak":true},{"text":"心裏卻藏着詭詐；","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他用甜言蜜語，你不可信他，","poem":1},{"lineBreak":true},{"text":"因為他心中有七樣可憎惡的。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他雖用詭詐遮掩自己的怨恨，","poem":1},{"lineBreak":true},{"text":"他的邪惡必在會中顯露。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"挖陷坑的，自己必掉在其中；","poem":1},{"lineBreak":true},{"text":"滾石頭的，石頭必反滾在他身上。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"虛謊的舌恨他所壓傷的人；","poem":1},{"lineBreak":true},{"text":"諂媚的口敗壞人的事。","poem":1}]}],"footnotes":[{"noteId":22,"caller":"-","text":"原文是：喝","reference":{"chapter":26,"verse":6}},{"noteId":23,"caller":"-","text":"-19 原文是死亡","reference":{"chapter":26,"verse":18}}]},"thisChapterLink":"/api/cmn_cuv/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":27}