{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"不要為明日自誇，","poem":1},{"lineBreak":true},{"text":"因為一日要生何事，你尚且不能知道。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要別人誇獎你，不可用口自誇；","poem":1},{"lineBreak":true},{"text":"等外人稱讚你，不可用嘴自稱。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"石頭重，沙土沉，","poem":1},{"lineBreak":true},{"text":"愚妄人的惱怒比這兩樣更重。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"忿怒為殘忍，怒氣為狂瀾，","poem":1},{"lineBreak":true},{"text":"惟有嫉妒，誰能敵得住呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"當面的責備強如背地的愛情。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"朋友加的傷痕出於忠誠；","poem":1},{"lineBreak":true},{"text":"仇敵連連親嘴卻是多餘。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"人吃飽了，厭惡蜂房的蜜；","poem":1},{"lineBreak":true},{"text":"人飢餓了，一切苦物都覺甘甜。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"人離本處飄流，","poem":1},{"lineBreak":true},{"text":"好像雀鳥離窩遊飛。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"膏油與香料使人心喜悅；","poem":1},{"lineBreak":true},{"text":"朋友誠實的勸教也是如此甘美。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你的朋友和父親的朋友，","poem":1},{"lineBreak":true},{"text":"你都不可離棄。","poem":1},{"lineBreak":true},{"text":"你遭難的日子，不要上弟兄的家去；","poem":1},{"lineBreak":true},{"text":"相近的鄰舍強如遠方的弟兄。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我兒，你要作智慧人，好叫我的心歡喜，","poem":1},{"lineBreak":true},{"text":"使我可以回答那譏誚我的人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"通達人見禍藏躲；","poem":1},{"lineBreak":true},{"text":"愚蒙人前往受害。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"誰為生人作保，就拿誰的衣服；","poem":1},{"lineBreak":true},{"text":"誰為外女作保，誰就承當。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"清晨起來，大聲給朋友祝福的，","poem":1},{"lineBreak":true},{"text":"就算是咒詛他。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"大雨之日連連滴漏，","poem":1},{"lineBreak":true},{"text":"和爭吵的婦人一樣；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"想攔阻她的，便是攔阻風，","poem":1},{"lineBreak":true},{"text":"也是右手抓油。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"鐵磨鐵，磨出刃來；","poem":1},{"lineBreak":true},{"text":"朋友相感","poem":1},{"noteId":24},{"text":"也是如此。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"看守無花果樹的，必吃樹上的果子；","poem":1},{"lineBreak":true},{"text":"敬奉主人的，必得尊榮。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"水中照臉，彼此相符；","poem":1},{"lineBreak":true},{"text":"人與人，心也相對。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"陰間和滅亡永不滿足；","poem":1},{"lineBreak":true},{"text":"人的眼目也是如此。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"鼎為煉銀，爐為煉金，","poem":1},{"lineBreak":true},{"text":"人的稱讚也試煉人。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你雖用杵將愚妄人與打碎的麥子一同搗在臼中，","poem":1},{"lineBreak":true},{"text":"他的愚妄還是離不了他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"你要詳細知道你羊群的景況，","poem":1},{"lineBreak":true},{"text":"留心料理你的牛群；","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"因為資財不能永有，","poem":1},{"lineBreak":true},{"text":"冠冕豈能存到萬代？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"乾草割去，嫩草發現，","poem":1},{"lineBreak":true},{"text":"山上的菜蔬也被收斂。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"羊羔之毛是為你作衣服；","poem":1},{"lineBreak":true},{"text":"山羊是為作田地的價值，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"並有母山羊奶夠你吃，","poem":1},{"lineBreak":true},{"text":"也夠你的家眷吃，","poem":1},{"lineBreak":true},{"text":"且夠養你的婢女。","poem":1}]}],"footnotes":[{"noteId":24,"caller":"-","text":"原文是磨朋友的臉","reference":{"chapter":27,"verse":17}}]},"thisChapterLink":"/api/cmn_cuv/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}