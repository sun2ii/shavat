{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"惡人雖無人追趕也逃跑；","poem":1},{"lineBreak":true},{"text":"義人卻膽壯像獅子。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"邦國因有罪過，君王就多更換；","poem":1},{"lineBreak":true},{"text":"因有聰明知識的人，國必長存。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"窮人欺壓貧民，","poem":1},{"lineBreak":true},{"text":"好像暴雨沖沒糧食。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"違棄律法的，誇獎惡人；","poem":1},{"lineBreak":true},{"text":"遵守律法的，卻與惡人相爭。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"壞人不明白公義；","poem":1},{"lineBreak":true},{"text":"惟有尋求耶和華的，無不明白。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"行為純正的窮乏人","poem":1},{"lineBreak":true},{"text":"勝過行事乖僻的富足人。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"謹守律法的，是智慧之子；","poem":1},{"lineBreak":true},{"text":"與貪食人作伴的，卻羞辱其父。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"人以厚利加增財物，","poem":1},{"lineBreak":true},{"text":"是給那憐憫窮人者積蓄的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"轉耳不聽律法的，","poem":1},{"lineBreak":true},{"text":"他的祈禱也為可憎。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"誘惑正直人行惡道的，必掉在自己的坑裏；","poem":1},{"lineBreak":true},{"text":"惟有完全人必承受福分。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"富足人自以為有智慧，","poem":1},{"lineBreak":true},{"text":"但聰明的貧窮人能將他查透。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"義人得志，有大榮耀；","poem":1},{"lineBreak":true},{"text":"惡人興起，人就躲藏。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"遮掩自己罪過的，必不亨通；","poem":1},{"lineBreak":true},{"text":"承認離棄罪過的，必蒙憐恤。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"常存敬畏的，便為有福；","poem":1},{"lineBreak":true},{"text":"心存剛硬的，必陷在禍患裏。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"暴虐的君王轄制貧民，","poem":1},{"lineBreak":true},{"text":"好像吼叫的獅子、覓食的熊。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"無知的君多行暴虐；","poem":1},{"lineBreak":true},{"text":"以貪財為可恨的，必年長日久。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"背負流人血之罪的，必往坑裏奔跑，","poem":1},{"lineBreak":true},{"text":"誰也不可攔阻他。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"行動正直的，必蒙拯救；","poem":1},{"lineBreak":true},{"text":"行事彎曲的，立時跌倒。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耕種自己田地的，必得飽食；","poem":1},{"lineBreak":true},{"text":"追隨虛浮的，足受窮乏。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"誠實人必多得福；","poem":1},{"lineBreak":true},{"text":"想要急速發財的，不免受罰。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"看人的情面乃為不好；","poem":1},{"lineBreak":true},{"text":"人因一塊餅枉法也為不好。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"人有惡眼想要急速發財，","poem":1},{"lineBreak":true},{"text":"卻不知窮乏必臨到他身。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"責備人的，後來蒙人喜悅，","poem":1},{"lineBreak":true},{"text":"多於那用舌頭諂媚人的。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"偷竊父母的，說：這不是罪，","poem":1},{"lineBreak":true},{"text":"此人就是與強盜同類。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"心中貪婪的，挑起爭端；","poem":1},{"lineBreak":true},{"text":"倚靠耶和華的，必得豐裕。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"心中自是的，便是愚昧人；","poem":1},{"lineBreak":true},{"text":"憑智慧行事的，必蒙拯救。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"賙濟貧窮的，不致缺乏；","poem":1},{"lineBreak":true},{"text":"佯為不見的，必多受咒詛。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"惡人興起，人就躲藏；","poem":1},{"lineBreak":true},{"text":"惡人敗亡，義人增多。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}