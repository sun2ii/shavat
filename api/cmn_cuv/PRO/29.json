{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"人屢次受責罰，仍然硬着頸項；","poem":1},{"lineBreak":true},{"text":"他必頃刻敗壞，無法可治。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"義人增多，民就喜樂；","poem":1},{"lineBreak":true},{"text":"惡人掌權，民就歎息。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"愛慕智慧的，使父親喜樂；","poem":1},{"lineBreak":true},{"text":"與妓女結交的，卻浪費錢財。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"王藉公平，使國堅定；","poem":1},{"lineBreak":true},{"text":"索要賄賂，使國傾敗。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"諂媚鄰舍的，","poem":1},{"lineBreak":true},{"text":"就是設網羅絆他的腳。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"惡人犯罪，自陷網羅；","poem":1},{"lineBreak":true},{"text":"惟獨義人歡呼喜樂。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"義人知道查明窮人的案；","poem":1},{"lineBreak":true},{"text":"惡人沒有聰明，就不得而知。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"褻慢人煽惑通城；","poem":1},{"lineBreak":true},{"text":"智慧人止息眾怒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"智慧人與愚妄人相爭，","poem":1},{"lineBreak":true},{"text":"或怒或笑，總不能使他止息。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"好流人血的，恨惡完全人，","poem":1},{"lineBreak":true},{"text":"索取正直人的性命。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"愚妄人怒氣全發；","poem":1},{"lineBreak":true},{"text":"智慧人忍氣含怒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"君王若聽謊言，","poem":1},{"lineBreak":true},{"text":"他一切臣僕都是奸惡。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"貧窮人、強暴人在世相遇；","poem":1},{"lineBreak":true},{"text":"他們的眼目都蒙耶和華光照。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"君王憑誠實判斷窮人；","poem":1},{"lineBreak":true},{"text":"他的國位必永遠堅立。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"杖打和責備能加增智慧；","poem":1},{"lineBreak":true},{"text":"放縱的兒子使母親羞愧。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"惡人加多，過犯也加多，","poem":1},{"lineBreak":true},{"text":"義人必看見他們跌倒。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"管教你的兒子，他就使你得安息，","poem":1},{"lineBreak":true},{"text":"也必使你心裏喜樂。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"沒有異象","poem":1},{"noteId":25},{"text":"，民就放肆；","poem":1},{"lineBreak":true},{"text":"惟遵守律法的，便為有福。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"只用言語，僕人不肯受管教；","poem":1},{"lineBreak":true},{"text":"他雖然明白，也不留意。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你見言語急躁的人嗎？","poem":1},{"lineBreak":true},{"text":"愚昧人比他更有指望。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"人將僕人從小嬌養，","poem":1},{"lineBreak":true},{"text":"這僕人終久必成了他的兒子。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"好氣的人挑啟爭端；","poem":1},{"lineBreak":true},{"text":"暴怒的人多多犯罪。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"人的高傲必使他卑下；","poem":1},{"lineBreak":true},{"text":"心裏謙遜的，必得尊榮。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"人與盜賊分贓，是恨惡自己的性命；","poem":1},{"lineBreak":true},{"text":"他聽見叫人發誓的聲音，卻不言語。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"懼怕人的，陷入網羅；","poem":1},{"lineBreak":true},{"text":"惟有倚靠耶和華的，必得安穩。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"求王恩的人多；","poem":1},{"lineBreak":true},{"text":"定人事乃在耶和華。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"為非作歹的，被義人憎嫌；","poem":1},{"lineBreak":true},{"text":"行事正直的，被惡人憎惡。","poem":1}]}],"footnotes":[{"noteId":25,"caller":"-","text":"或譯：默示","reference":{"chapter":29,"verse":18}}]},"thisChapterLink":"/api/cmn_cuv/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}