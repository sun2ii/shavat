{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":3,"content":[{"type":"heading","content":["給青年人的忠告"]},{"type":"verse","number":1,"content":[{"text":"我兒，不要忘記我的法則","poem":1},{"noteId":2},{"text":"；","poem":1},{"lineBreak":true},{"text":"你心要謹守我的誡命；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為它必將長久的日子，","poem":1},{"lineBreak":true},{"text":"生命的年數與平安，加給你。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"不可使慈愛、誠實離開你，","poem":1},{"lineBreak":true},{"text":"要繫在你頸項上，刻在你心版上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"這樣，你必在上帝和世人眼前","poem":1},{"lineBreak":true},{"text":"蒙恩寵，有聰明。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你要專心仰賴耶和華，","poem":1},{"lineBreak":true},{"text":"不可倚靠自己的聰明，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"在你一切所行的事上都要認定他，","poem":1},{"lineBreak":true},{"text":"他必指引你的路。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"不要自以為有智慧；","poem":1},{"lineBreak":true},{"text":"要敬畏耶和華，遠離惡事。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"這便醫治你的肚臍，","poem":1},{"lineBreak":true},{"text":"滋潤你的百骨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"你要以財物","poem":1},{"lineBreak":true},{"text":"和一切初熟的土產尊榮耶和華。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"這樣，你的倉房必充滿有餘；","poem":1},{"lineBreak":true},{"text":"你的酒醡有新酒盈溢。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我兒，你不可輕看耶和華的管教","poem":1},{"noteId":3},{"text":"，","poem":1},{"lineBreak":true},{"text":"也不可厭煩他的責備；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因為耶和華所愛的，他必責備，","poem":1},{"lineBreak":true},{"text":"正如父親責備所喜愛的兒子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"得智慧，得聰明的，","poem":1},{"lineBreak":true},{"text":"這人便為有福。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因為得智慧勝過得銀子，","poem":1},{"lineBreak":true},{"text":"其利益強如精金，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"比珍珠","poem":1},{"noteId":4},{"text":"寶貴；","poem":1},{"lineBreak":true},{"text":"你一切所喜愛的，都不足與比較。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"她右手有長壽，","poem":1},{"lineBreak":true},{"text":"左手有富貴。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"她的道是安樂；","poem":1},{"lineBreak":true},{"text":"她的路全是平安。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"她與持守她的作生命樹；","poem":1},{"lineBreak":true},{"text":"持定她的，俱各有福。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和華以智慧立地，","poem":1},{"lineBreak":true},{"text":"以聰明定天，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"以知識使深淵裂開，","poem":1},{"lineBreak":true},{"text":"使天空滴下甘露。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"我兒，要謹守真智慧和謀略，","poem":1},{"lineBreak":true},{"text":"不可使她離開你的眼目。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"這樣，她必作你的生命，","poem":1},{"lineBreak":true},{"text":"頸項的美飾。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你就坦然行路，","poem":1},{"lineBreak":true},{"text":"不致碰腳。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你躺下，必不懼怕；","poem":1},{"lineBreak":true},{"text":"你躺臥，睡得香甜。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"忽然來的驚恐，不要害怕；","poem":1},{"lineBreak":true},{"text":"惡人遭毀滅，也不要恐懼。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因為耶和華是你所倚靠的；","poem":1},{"lineBreak":true},{"text":"他必保守你的腳不陷入網羅。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"你手若有行善的力量，不可推辭，","poem":1},{"lineBreak":true},{"text":"就當向那應得的人施行。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你那裏若有現成的，不可對鄰舍說：","poem":1},{"lineBreak":true},{"text":"去吧，明天再來，我必給你。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你的鄰舍既在你附近安居，","poem":1},{"lineBreak":true},{"text":"你不可設計害他。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"人未曾加害與你，","poem":1},{"lineBreak":true},{"text":"不可無故與他相爭。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"不可嫉妒強暴的人，","poem":1},{"lineBreak":true},{"text":"也不可選擇他所行的路。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"因為，乖僻人為耶和華所憎惡；","poem":1},{"lineBreak":true},{"text":"正直人為他所親密。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"耶和華咒詛惡人的家庭，","poem":1},{"lineBreak":true},{"text":"賜福與義人的居所。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"他譏誚那好譏誚的人，","poem":1},{"lineBreak":true},{"text":"賜恩給謙卑的人。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"智慧人必承受尊榮；","poem":1},{"lineBreak":true},{"text":"愚昧人高升也成為羞辱。","poem":1}]}],"footnotes":[{"noteId":2,"caller":"-","text":"或譯：指教","reference":{"chapter":3,"verse":1}},{"noteId":3,"caller":"-","text":"或譯：懲治","reference":{"chapter":3,"verse":11}},{"noteId":4,"caller":"-","text":"或譯：紅寶石","reference":{"chapter":3,"verse":15}}]},"thisChapterLink":"/api/cmn_cuv/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}