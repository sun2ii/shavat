{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":30,"content":[{"type":"heading","content":["亞古珥語錄"]},{"type":"verse","number":1,"content":[{"text":"雅基的兒子亞古珥的言語就是真言。","poem":1},{"lineBreak":true},{"text":"這人對以鐵和烏甲說：","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我比眾人更蠢笨，","poem":1},{"lineBreak":true},{"text":"也沒有人的聰明。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我沒有學好智慧，","poem":1},{"lineBreak":true},{"text":"也不認識至聖者。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"誰升天又降下來？","poem":1},{"lineBreak":true},{"text":"誰聚風在掌握中？","poem":1},{"lineBreak":true},{"text":"誰包水在衣服裏？","poem":1},{"lineBreak":true},{"text":"誰立定地的四極？","poem":1},{"lineBreak":true},{"text":"他名叫甚麼？","poem":1},{"lineBreak":true},{"text":"他兒子名叫甚麼？","poem":1},{"lineBreak":true},{"text":"你知道嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"上帝的言語句句都是煉淨的；","poem":1},{"lineBreak":true},{"text":"投靠他的，他便作他們的盾牌。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他的言語，你不可加添，","poem":1},{"lineBreak":true},{"text":"恐怕他責備你，你就顯為說謊言的。","poem":1}]},{"type":"heading","content":["其他箴言"]},{"type":"verse","number":7,"content":[{"text":"我求你兩件事，","poem":1},{"lineBreak":true},{"text":"在我未死之先，不要不賜給我：","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你使虛假和謊言遠離我；","poem":1},{"lineBreak":true},{"text":"使我也不貧窮也不富足；","poem":1},{"lineBreak":true},{"text":"賜給我需用的飲食，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"恐怕我飽足不認你，說：","poem":1},{"lineBreak":true},{"text":"耶和華是誰呢？","poem":1},{"lineBreak":true},{"text":"又恐怕我貧窮就偷竊，","poem":1},{"lineBreak":true},{"text":"以致褻瀆我上帝的名。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你不要向主人讒謗僕人，","poem":1},{"lineBreak":true},{"text":"恐怕他咒詛你，你便算為有罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"有一宗人","poem":1},{"noteId":26},{"text":"，咒詛父親，","poem":1},{"lineBreak":true},{"text":"不給母親祝福。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"有一宗人，自以為清潔，","poem":1},{"lineBreak":true},{"text":"卻沒有洗去自己的污穢。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"有一宗人，眼目何其高傲，","poem":1},{"lineBreak":true},{"text":"眼皮也是高舉。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"有一宗人，牙如劍，齒如刀，","poem":1},{"lineBreak":true},{"text":"要吞滅地上的困苦人和世間的窮乏人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"螞蟥有兩個女兒，","poem":1},{"lineBreak":true},{"text":"常說：給呀，給呀！","poem":1},{"lineBreak":true},{"text":"有三樣不知足的，","poem":1},{"lineBreak":true},{"text":"連不說「夠的」共有四樣：","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"就是陰間和石胎，","poem":1},{"lineBreak":true},{"text":"浸水不足的地，並火。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"戲笑父親、藐視而不聽從母親的，","poem":1},{"lineBreak":true},{"text":"他的眼睛必為谷中的烏鴉啄出來，為鷹雛所吃。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"我所測不透的奇妙有三樣，","poem":1},{"lineBreak":true},{"text":"連我所不知道的共有四樣：","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"就是鷹在空中飛的道；","poem":1},{"lineBreak":true},{"text":"蛇在磐石上爬的道；","poem":1},{"lineBreak":true},{"text":"船在海中行的道；","poem":1},{"lineBreak":true},{"text":"男與女交合的道。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"淫婦的道也是這樣：","poem":1},{"lineBreak":true},{"text":"她吃了，把嘴一擦就說：","poem":1},{"lineBreak":true},{"text":"我沒有行惡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"使地震動的有三樣，","poem":1},{"lineBreak":true},{"text":"連地擔不起的共有四樣：","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"就是僕人作王；","poem":1},{"lineBreak":true},{"text":"愚頑人吃飽；","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"醜惡的女子出嫁；","poem":1},{"lineBreak":true},{"text":"婢女接續主母。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"地上有四樣小物，卻甚聰明：","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"螞蟻是無力之類，","poem":1},{"lineBreak":true},{"text":"卻在夏天預備糧食。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"沙番是軟弱之類，","poem":1},{"lineBreak":true},{"text":"卻在磐石中造房。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"蝗蟲沒有君王，","poem":1},{"lineBreak":true},{"text":"卻分隊而出。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"守宮用爪抓牆，","poem":1},{"lineBreak":true},{"text":"卻住在王宮。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"步行威武的有三樣，","poem":1},{"lineBreak":true},{"text":"連行走威武的共有四樣：","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"就是獅子－乃百獸中最為猛烈、無所躲避的，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"獵狗，公山羊，和無人能敵的君王。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"你若行事愚頑，自高自傲，","poem":1},{"lineBreak":true},{"text":"或是懷了惡念，就當用手摀口。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"搖牛奶必成奶油；","poem":1},{"lineBreak":true},{"text":"扭鼻子必出血。","poem":1},{"lineBreak":true},{"text":"照樣，激動怒氣必起爭端。","poem":1}]}],"footnotes":[{"noteId":26,"caller":"-","text":"宗：原文是代；下同","reference":{"chapter":30,"verse":11}}]},"thisChapterLink":"/api/cmn_cuv/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}