{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":31,"content":[{"type":"heading","content":["給一君王的忠告"]},{"type":"verse","number":1,"content":[{"text":"利慕伊勒王的言語，是他母親教訓他的真言。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的兒啊，我腹中生的兒啊，","poem":1},{"lineBreak":true},{"text":"我許願得的兒啊！我當怎樣教訓你呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"不要將你的精力給婦女；","poem":1},{"lineBreak":true},{"text":"也不要有敗壞君王的行為。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"利慕伊勒啊，君王喝酒，君王喝酒不相宜；","poem":1},{"lineBreak":true},{"text":"王子說濃酒在那裏也不相宜；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"恐怕喝了就忘記律例，","poem":1},{"lineBreak":true},{"text":"顛倒一切困苦人的是非。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"可以把濃酒給將亡的人喝，","poem":1},{"lineBreak":true},{"text":"把清酒給苦心的人喝，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"讓他喝了，就忘記他的貧窮，","poem":1},{"lineBreak":true},{"text":"不再記念他的苦楚。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你當為啞巴","poem":1},{"noteId":27},{"text":"開口，","poem":1},{"lineBreak":true},{"text":"為一切孤獨的伸冤。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你當開口按公義判斷，","poem":1},{"lineBreak":true},{"text":"為困苦和窮乏的辨屈。","poem":1}]},{"type":"heading","content":["論賢妻"]},{"type":"verse","number":10,"content":[{"text":"才德的婦人誰能得着呢？","poem":1},{"lineBreak":true},{"text":"她的價值遠勝過珍珠。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"她丈夫心裏倚靠她，","poem":1},{"lineBreak":true},{"text":"必不缺少利益；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"她一生使丈夫有益無損。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"她尋找羊羢和麻，","poem":1},{"lineBreak":true},{"text":"甘心用手做工。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"她好像商船從遠方運糧來，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"未到黎明她就起來，","poem":1},{"lineBreak":true},{"text":"把食物分給家中的人，","poem":1},{"lineBreak":true},{"text":"將當做的工分派婢女。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"她想得田地就買來；","poem":1},{"lineBreak":true},{"text":"用手所得之利栽種葡萄園。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"她以能力束腰，","poem":1},{"lineBreak":true},{"text":"使膀臂有力。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"她覺得所經營的有利；","poem":1},{"lineBreak":true},{"text":"她的燈終夜不滅。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"她手拿撚線竿，","poem":1},{"lineBreak":true},{"text":"手把紡線車。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"她張手賙濟困苦人，","poem":1},{"lineBreak":true},{"text":"伸手幫補窮乏人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"她不因下雪為家裏的人擔心，","poem":1},{"lineBreak":true},{"text":"因為全家都穿着朱紅衣服。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"她為自己製作繡花毯子；","poem":1},{"lineBreak":true},{"text":"她的衣服是細麻和紫色布做的。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"她丈夫在城門口與本地的長老同坐，","poem":1},{"lineBreak":true},{"text":"為眾人所認識。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"她做細麻布衣裳出賣，","poem":1},{"lineBreak":true},{"text":"又將腰帶賣與商家。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"能力和威儀是她的衣服；","poem":1},{"lineBreak":true},{"text":"她想到日後的景況就喜笑。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"她開口就發智慧；","poem":1},{"lineBreak":true},{"text":"她舌上有仁慈的法則。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"她觀察家務，","poem":1},{"lineBreak":true},{"text":"並不吃閒飯。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"她的兒女起來稱她有福；","poem":1},{"lineBreak":true},{"text":"她的丈夫也稱讚她，","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"說：才德的女子很多，","poem":1},{"lineBreak":true},{"text":"惟獨你超過一切。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"艷麗是虛假的，美容是虛浮的；","poem":1},{"lineBreak":true},{"text":"惟敬畏耶和華的婦女必得稱讚。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"願她享受操作所得的；","poem":1},{"lineBreak":true},{"text":"願她的工作在城門口榮耀她。","poem":1}]}],"footnotes":[{"noteId":27,"caller":"-","text":"或譯：不能自辯的","reference":{"chapter":31,"verse":8}}]},"thisChapterLink":"/api/cmn_cuv/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}