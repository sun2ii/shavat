{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":4,"content":[{"type":"heading","content":["智慧的益處"]},{"type":"verse","number":1,"content":[{"text":"眾子啊，要聽父親的教訓，","poem":1},{"lineBreak":true},{"text":"留心得知聰明。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因我所給你們的是好教訓；","poem":1},{"lineBreak":true},{"text":"不可離棄我的法則","poem":1},{"noteId":5},{"text":"。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我在父親面前為孝子，","poem":1},{"lineBreak":true},{"text":"在母親眼中為獨一的嬌兒。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"父親教訓我說：你心要存記我的言語，","poem":1},{"lineBreak":true},{"text":"遵守我的命令，便得存活。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要得智慧，要得聰明，不可忘記，","poem":1},{"lineBreak":true},{"text":"也不可偏離我口中的言語。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"不可離棄智慧，智慧就護衛你；","poem":1},{"lineBreak":true},{"text":"要愛她，她就保守你。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"智慧為首；","poem":1},{"lineBreak":true},{"text":"所以，要得智慧。","poem":1},{"lineBreak":true},{"text":"在你一切所得之內必得聰明","poem":1},{"noteId":6},{"text":"。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"高舉智慧，她就使你高升；","poem":1},{"lineBreak":true},{"text":"懷抱智慧，她就使你尊榮。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"她必將華冠加在你頭上，","poem":1},{"lineBreak":true},{"text":"把榮冕交給你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"我兒，你要聽受我的言語，","poem":1},{"lineBreak":true},{"text":"就必延年益壽。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我已指教你走智慧的道，","poem":1},{"lineBreak":true},{"text":"引導你行正直的路。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你行走，腳步必不致狹窄；","poem":1},{"lineBreak":true},{"text":"你奔跑，也不致跌倒。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"要持定訓誨，不可放鬆；","poem":1},{"lineBreak":true},{"text":"必當謹守，因為它是你的生命。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"不可行惡人的路；","poem":1},{"lineBreak":true},{"text":"不要走壞人的道。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"要躲避，不可經過；","poem":1},{"lineBreak":true},{"text":"要轉身而去。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"這等人若不行惡，不得睡覺；","poem":1},{"lineBreak":true},{"text":"不使人跌倒，睡臥不安；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因為他們以奸惡吃餅，","poem":1},{"lineBreak":true},{"text":"以強暴喝酒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"但義人的路好像黎明的光，","poem":1},{"lineBreak":true},{"text":"越照越明，直到日午。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"惡人的道好像幽暗，","poem":1},{"lineBreak":true},{"text":"自己不知因甚麼跌倒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"我兒，要留心聽我的言詞，","poem":1},{"lineBreak":true},{"text":"側耳聽我的話語，","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"都不可離你的眼目，","poem":1},{"lineBreak":true},{"text":"要存記在你心中。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因為得着它的，就得了生命，","poem":1},{"lineBreak":true},{"text":"又得了醫全體的良藥。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你要保守你心，勝過保守一切","poem":1},{"noteId":7},{"text":"，","poem":1},{"lineBreak":true},{"text":"因為一生的果效是由心發出。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你要除掉邪僻的口，","poem":1},{"lineBreak":true},{"text":"棄絕乖謬的嘴。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你的眼目要向前正看；","poem":1},{"lineBreak":true},{"text":"你的眼睛","poem":1},{"noteId":8},{"text":"當向前直觀。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"要修平你腳下的路，","poem":1},{"lineBreak":true},{"text":"堅定你一切的道。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"不可偏向左右；","poem":1},{"lineBreak":true},{"text":"要使你的腳離開邪惡。","poem":1}]}],"footnotes":[{"noteId":5,"caller":"-","text":"或譯：指教","reference":{"chapter":4,"verse":2}},{"noteId":6,"caller":"-","text":"或譯：用你一切所得的去換聰明","reference":{"chapter":4,"verse":7}},{"noteId":7,"caller":"-","text":"或譯：你要切切保守你心","reference":{"chapter":4,"verse":23}},{"noteId":8,"caller":"-","text":"原文是皮","reference":{"chapter":4,"verse":25}}]},"thisChapterLink":"/api/cmn_cuv/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}