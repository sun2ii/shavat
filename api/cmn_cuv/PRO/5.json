{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":5,"content":[{"type":"heading","content":["警告勿犯淫亂"]},{"type":"verse","number":1,"content":[{"text":"我兒，要留心我智慧的話語，","poem":1},{"lineBreak":true},{"text":"側耳聽我聰明的言詞，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"為要使你謹守謀略，","poem":1},{"lineBreak":true},{"text":"嘴唇保存知識。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為淫婦的嘴滴下蜂蜜；","poem":1},{"lineBreak":true},{"text":"她的口比油更滑，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"至終卻苦似茵蔯，","poem":1},{"lineBreak":true},{"text":"快如兩刃的刀。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"她的腳下入死地；","poem":1},{"lineBreak":true},{"text":"她腳步踏住陰間，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"以致她找不着生命平坦的道。","poem":1},{"lineBreak":true},{"text":"她的路變遷不定，","poem":1},{"lineBreak":true},{"text":"自己還不知道。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"眾子啊，現在要聽從我；","poem":1},{"lineBreak":true},{"text":"不可離棄我口中的話。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你所行的道要離她遠，","poem":1},{"lineBreak":true},{"text":"不可就近她的房門，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"恐怕將你的尊榮給別人，","poem":1},{"lineBreak":true},{"text":"將你的歲月給殘忍的人；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"恐怕外人滿得你的力量，","poem":1},{"lineBreak":true},{"text":"你勞碌得來的，歸入外人的家；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"終久，你皮肉和身體消毀，","poem":1},{"lineBreak":true},{"text":"你就悲歎，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"說：我怎麼恨惡訓誨，","poem":1},{"lineBreak":true},{"text":"心中藐視責備，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"也不聽從我師傅的話，","poem":1},{"lineBreak":true},{"text":"又不側耳聽那教訓我的人？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我在聖會裏，","poem":1},{"lineBreak":true},{"text":"幾乎落在諸般惡中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"你要喝自己池中的水，","poem":1},{"lineBreak":true},{"text":"飲自己井裏的活水。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你的泉源豈可漲溢在外？","poem":1},{"lineBreak":true},{"text":"你的河水豈可流在街上？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"惟獨歸你一人，","poem":1},{"lineBreak":true},{"text":"不可與外人同用。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"要使你的泉源蒙福；","poem":1},{"lineBreak":true},{"text":"要喜悅你幼年所娶的妻。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"她如可愛的麀鹿，可喜的母鹿；","poem":1},{"lineBreak":true},{"text":"願她的胸懷使你時時知足，","poem":1},{"lineBreak":true},{"text":"她的愛情使你常常戀慕。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我兒，你為何戀慕淫婦？","poem":1},{"lineBreak":true},{"text":"為何抱外女的胸懷？","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"因為，人所行的道都在耶和華眼前；","poem":1},{"lineBreak":true},{"text":"他也修平人一切的路。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"惡人必被自己的罪孽捉住；","poem":1},{"lineBreak":true},{"text":"他必被自己的罪惡如繩索纏繞。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他因不受訓誨就必死亡；","poem":1},{"lineBreak":true},{"text":"又因愚昧過甚，必走差了路。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}