{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":6,"content":[{"type":"heading","content":["更多的警告"]},{"type":"verse","number":1,"content":[{"text":"我兒，你若為朋友作保，","poem":1},{"lineBreak":true},{"text":"替外人擊掌，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你就被口中的話語纏住，","poem":1},{"lineBreak":true},{"text":"被嘴裏的言語捉住。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我兒，你既落在朋友手中，","poem":1},{"lineBreak":true},{"text":"就當這樣行才可救自己：","poem":1},{"lineBreak":true},{"text":"你要自卑，去懇求你的朋友。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"不要容你的眼睛睡覺；","poem":1},{"lineBreak":true},{"text":"不要容你的眼皮打盹。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要救自己，如鹿脫離獵戶的手，","poem":1},{"lineBreak":true},{"text":"如鳥脫離捕鳥人的手。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"懶惰人哪，","poem":1},{"lineBreak":true},{"text":"你去察看螞蟻的動作就可得智慧。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"螞蟻沒有元帥，","poem":1},{"lineBreak":true},{"text":"沒有官長，沒有君王，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"尚且在夏天預備食物，","poem":1},{"lineBreak":true},{"text":"在收割時聚斂糧食。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"懶惰人哪，你要睡到幾時呢？","poem":1},{"lineBreak":true},{"text":"你何時睡醒呢？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"再睡片時，打盹片時，","poem":1},{"lineBreak":true},{"text":"抱着手躺臥片時，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你的貧窮就必如強盜速來，","poem":1},{"lineBreak":true},{"text":"你的缺乏彷彿拿兵器的人來到。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"無賴的惡徒，","poem":1},{"lineBreak":true},{"text":"行動就用乖僻的口，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"用眼傳神，","poem":1},{"lineBreak":true},{"text":"用腳示意，","poem":1},{"lineBreak":true},{"text":"用指點劃，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"心中乖僻，","poem":1},{"lineBreak":true},{"text":"常設惡謀，","poem":1},{"lineBreak":true},{"text":"布散紛爭。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"所以，災難必忽然臨到他身；","poem":1},{"lineBreak":true},{"text":"他必頃刻敗壞，無法可治。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和華所恨惡的有六樣，","poem":1},{"lineBreak":true},{"text":"連他心所憎惡的共有七樣：","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"就是高傲的眼，","poem":1},{"lineBreak":true},{"text":"撒謊的舌，","poem":1},{"lineBreak":true},{"text":"流無辜人血的手，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"圖謀惡計的心，","poem":1},{"lineBreak":true},{"text":"飛跑行惡的腳，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"吐謊言的假見證，","poem":1},{"lineBreak":true},{"text":"並弟兄中布散紛爭的人。","poem":1}]},{"type":"heading","content":["警告勿犯淫亂"]},{"type":"verse","number":20,"content":[{"text":"我兒，要謹守你父親的誡命；","poem":1},{"lineBreak":true},{"text":"不可離棄你母親的法則","poem":1},{"noteId":9},{"text":"，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"要常繫在你心上，","poem":1},{"lineBreak":true},{"text":"掛在你項上。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你行走，它必引導你；","poem":1},{"lineBreak":true},{"text":"你躺臥，它必保守你；","poem":1},{"lineBreak":true},{"text":"你睡醒，它必與你談論。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"因為誡命是燈，法則","poem":1},{"noteId":10},{"text":"是光，","poem":1},{"lineBreak":true},{"text":"訓誨的責備是生命的道，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"能保你遠離惡婦，","poem":1},{"lineBreak":true},{"text":"遠離外女諂媚的舌頭。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你心中不要戀慕她的美色，","poem":1},{"lineBreak":true},{"text":"也不要被她眼皮勾引。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因為，妓女能使人只剩一塊餅；","poem":1},{"lineBreak":true},{"text":"淫婦獵取人寶貴的生命。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"人若懷裏搋火，","poem":1},{"lineBreak":true},{"text":"衣服豈能不燒呢？","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"人若在火炭上走，","poem":1},{"lineBreak":true},{"text":"腳豈能不燙呢？","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"親近鄰舍之妻的，也是如此；","poem":1},{"lineBreak":true},{"text":"凡挨近她的，不免受罰。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"賊因飢餓偷竊充飢，","poem":1},{"lineBreak":true},{"text":"人不藐視他，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"若被找着，他必賠還七倍，","poem":1},{"lineBreak":true},{"text":"必將家中所有的盡都償還。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"與婦人行淫的，便是無知；","poem":1},{"lineBreak":true},{"text":"行這事的，必喪掉生命。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他必受傷損，必被凌辱；","poem":1},{"lineBreak":true},{"text":"他的羞恥不得塗抹。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"因為人的嫉恨成了烈怒，","poem":1},{"lineBreak":true},{"text":"報仇的時候決不留情。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"甚麼贖價，他都不顧；","poem":1},{"lineBreak":true},{"text":"你雖送許多禮物，他也不肯干休。","poem":1}]}],"footnotes":[{"noteId":9,"caller":"-","text":"或譯：指教","reference":{"chapter":6,"verse":20}},{"noteId":10,"caller":"-","text":"或譯：指教","reference":{"chapter":6,"verse":23}}]},"thisChapterLink":"/api/cmn_cuv/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}