{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"我兒，你要遵守我的言語，","poem":1},{"lineBreak":true},{"text":"將我的命令存記在心。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"遵守我的命令就得存活；","poem":1},{"lineBreak":true},{"text":"保守我的法則","poem":1},{"noteId":11},{"text":"，","poem":1},{"lineBreak":true},{"text":"好像保守眼中的瞳人，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"繫在你指頭上，","poem":1},{"lineBreak":true},{"text":"刻在你心版上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"對智慧說：你是我的姊妹，","poem":1},{"lineBreak":true},{"text":"稱呼聰明為你的親人，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"她就保你遠離淫婦，","poem":1},{"lineBreak":true},{"text":"遠離說諂媚話的外女。","poem":1}]},{"type":"heading","content":["淫亂的婦人"]},{"type":"verse","number":6,"content":[{"text":"我曾在我房屋的窗戶內，","poem":1},{"lineBreak":true},{"text":"從我窗欞之間往外觀看：","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"見愚蒙人內，少年人中，","poem":1},{"lineBreak":true},{"text":"分明有一個無知的少年人，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"從街上經過，走近淫婦的巷口，","poem":1},{"lineBreak":true},{"text":"直往通她家的路去，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"在黃昏，或晚上，","poem":1},{"lineBreak":true},{"text":"或半夜，或黑暗之中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"看哪，有一個婦人來迎接他，","poem":1},{"lineBreak":true},{"text":"是妓女的打扮，有詭詐的心思。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"這婦人喧嚷，不守約束，","poem":1},{"lineBreak":true},{"text":"在家裏停不住腳，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"有時在街市上，有時在寬闊處，","poem":1},{"lineBreak":true},{"text":"或在各巷口蹲伏，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"拉住那少年人，與他親嘴，","poem":1},{"lineBreak":true},{"text":"臉無羞恥對他說：","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"平安祭在我這裏，","poem":1},{"lineBreak":true},{"text":"今日才還了我所許的願。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"因此，我出來迎接你，","poem":1},{"lineBreak":true},{"text":"懇切求見你的面，恰巧遇見了你。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我已經用繡花毯子","poem":1},{"lineBreak":true},{"text":"和埃及線織的花紋布鋪了我的床。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我又用沒藥、沉香、桂皮","poem":1},{"lineBreak":true},{"text":"薰了我的榻。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你來，我們可以飽享愛情，直到早晨；","poem":1},{"lineBreak":true},{"text":"我們可以彼此親愛歡樂。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"因為我丈夫不在家，出門行遠路；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他手拿銀囊，必到月望才回家。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"淫婦用許多巧言誘他隨從，","poem":1},{"lineBreak":true},{"text":"用諂媚的嘴逼他同行。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"少年人立刻跟隨她，好像牛往宰殺之地；","poem":1},{"lineBreak":true},{"text":"又像愚昧人帶鎖鍊去受刑罰，","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"直等箭穿他的肝；","poem":1},{"lineBreak":true},{"text":"如同雀鳥急入網羅，卻不知是自喪己命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"眾子啊，現在要聽從我，","poem":1},{"lineBreak":true},{"text":"留心聽我口中的話。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"你的心不可偏向淫婦的道，","poem":1},{"lineBreak":true},{"text":"不要入她的迷途。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因為，被她傷害仆倒的不少；","poem":1},{"lineBreak":true},{"text":"被她殺戮的而且甚多。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"她的家是在陰間之路，","poem":1},{"lineBreak":true},{"text":"下到死亡之宮。","poem":1}]}],"footnotes":[{"noteId":11,"caller":"-","text":"或譯：指教","reference":{"chapter":7,"verse":2}}]},"thisChapterLink":"/api/cmn_cuv/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}