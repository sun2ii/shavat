{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":8,"content":[{"type":"heading","content":["智慧頌"]},{"type":"verse","number":1,"content":[{"text":"智慧豈不呼叫？","poem":1},{"lineBreak":true},{"text":"聰明豈不發聲？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"她在道旁高處的頂上，","poem":1},{"lineBreak":true},{"text":"在十字路口站立，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"在城門旁，在城門口，","poem":1},{"lineBreak":true},{"text":"在城門洞，大聲說：","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"眾人哪，我呼叫你們，","poem":1},{"lineBreak":true},{"text":"我向世人發聲。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"說：愚蒙人哪，你們要會悟靈明；","poem":1},{"lineBreak":true},{"text":"愚昧人哪，你們當心裏明白。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你們當聽，因我要說極美的話；","poem":1},{"lineBreak":true},{"text":"我張嘴要論正直的事。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的口要發出真理；","poem":1},{"lineBreak":true},{"text":"我的嘴憎惡邪惡。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我口中的言語都是公義，","poem":1},{"lineBreak":true},{"text":"並無彎曲乖僻。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"有聰明的，以為明顯，","poem":1},{"lineBreak":true},{"text":"得知識的，以為正直。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你們當受我的教訓，不受白銀；","poem":1},{"lineBreak":true},{"text":"寧得知識，勝過黃金。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"因為智慧比珍珠","poem":1},{"noteId":12},{"text":"更美；","poem":1},{"lineBreak":true},{"text":"一切可喜愛的都不足與比較。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我－智慧以靈明為居所，","poem":1},{"lineBreak":true},{"text":"又尋得知識和謀略。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"敬畏耶和華在乎恨惡邪惡；","poem":1},{"lineBreak":true},{"text":"那驕傲、狂妄，並惡道，","poem":1},{"lineBreak":true},{"text":"以及乖謬的口，都為我所恨惡。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我有謀略和真知識；","poem":1},{"lineBreak":true},{"text":"我乃聰明，我有能力。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"帝王藉我坐國位；","poem":1},{"lineBreak":true},{"text":"君王藉我定公平。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"王子和首領，","poem":1},{"lineBreak":true},{"text":"世上一切的審判官，都是藉我掌權。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"愛我的，我也愛他；","poem":1},{"lineBreak":true},{"text":"懇切尋求我的，必尋得見。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"豐富尊榮在我；","poem":1},{"lineBreak":true},{"text":"恆久的財並公義也在我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我的果實勝過黃金，強如精金；","poem":1},{"lineBreak":true},{"text":"我的出產超乎高銀。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我在公義的道上走，","poem":1},{"lineBreak":true},{"text":"在公平的路中行，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"使愛我的，承受貨財，","poem":1},{"lineBreak":true},{"text":"並充滿他們的府庫。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"在耶和華造化的起頭，","poem":1},{"lineBreak":true},{"text":"在太初創造萬物之先，就有了我。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"從亙古，從太初，","poem":1},{"lineBreak":true},{"text":"未有世界以前，我已被立。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"沒有深淵，","poem":1},{"lineBreak":true},{"text":"沒有大水的泉源，我已生出。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"大山未曾奠定，","poem":1},{"lineBreak":true},{"text":"小山未有之先，我已生出。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"耶和華還沒有創造大地和田野，","poem":1},{"lineBreak":true},{"text":"並世上的土質，我已生出。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他立高天，我在那裏；","poem":1},{"lineBreak":true},{"text":"他在淵面的周圍，劃出圓圈。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"上使穹蒼堅硬，","poem":1},{"lineBreak":true},{"text":"下使淵源穩固，","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"為滄海定出界限，使水不越過他的命令，","poem":1},{"lineBreak":true},{"text":"立定大地的根基。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"那時，我在他那裏為工師，","poem":1},{"lineBreak":true},{"text":"日日為他所喜愛，","poem":1},{"lineBreak":true},{"text":"常常在他面前踴躍，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"踴躍在他為人預備可住之地，","poem":1},{"lineBreak":true},{"text":"也喜悅住在世人之間。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"眾子啊，現在要聽從我，","poem":1},{"lineBreak":true},{"text":"因為謹守我道的，便為有福。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"要聽教訓就得智慧，","poem":1},{"lineBreak":true},{"text":"不可棄絕。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"聽從我、日日在我門口仰望、","poem":1},{"lineBreak":true},{"text":"在我門框旁邊等候的，那人便為有福。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"因為尋得我的，就尋得生命，","poem":1},{"lineBreak":true},{"text":"也必蒙耶和華的恩惠。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"得罪我的，卻害了自己的性命；","poem":1},{"lineBreak":true},{"text":"恨惡我的，都喜愛死亡。","poem":1}]}],"footnotes":[{"noteId":12,"caller":"-","text":"或譯：紅寶石","reference":{"chapter":8,"verse":11}}]},"thisChapterLink":"/api/cmn_cuv/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}