{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PRO","translationId":"cmn_cuv","name":"箴言","commonName":"箴言","title":"箴言","order":20,"numberOfChapters":31,"sha256":"480078da4416c62cce37a08b7fd7298ffd7b7c55154621ec72621cb8561b40bd","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/cmn_cuv/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":9,"content":[{"type":"heading","content":["智慧和愚蠢"]},{"type":"verse","number":1,"content":[{"text":"智慧建造房屋，","poem":1},{"lineBreak":true},{"text":"鑿成七根柱子，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"宰殺牲畜，","poem":1},{"lineBreak":true},{"text":"調和旨酒，","poem":1},{"lineBreak":true},{"text":"設擺筵席；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"打發使女出去，","poem":1},{"lineBreak":true},{"text":"自己在城中至高處呼叫，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"說：誰是愚蒙人，可以轉到這裏來！","poem":1},{"lineBreak":true},{"text":"又對那無知的人說：","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你們來，吃我的餅，","poem":1},{"lineBreak":true},{"text":"喝我調和的酒。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你們愚蒙人，要捨棄愚蒙，","poem":1},{"lineBreak":true},{"text":"就得存活，並要走光明的道。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"指斥褻慢人的，必受辱罵；","poem":1},{"lineBreak":true},{"text":"責備惡人的，必被玷污。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"不要責備褻慢人，恐怕他恨你；","poem":1},{"lineBreak":true},{"text":"要責備智慧人，他必愛你。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"教導智慧人，他就越發有智慧；","poem":1},{"lineBreak":true},{"text":"指示義人，他就增長學問。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"敬畏耶和華是智慧的開端；","poem":1},{"lineBreak":true},{"text":"認識至聖者便是聰明。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你藉着我，日子必增多，","poem":1},{"lineBreak":true},{"text":"年歲也必加添。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你若有智慧，是與自己有益；","poem":1},{"lineBreak":true},{"text":"你若褻慢，就必獨自擔當。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"愚昧的婦人喧嚷；","poem":1},{"lineBreak":true},{"text":"她是愚蒙，一無所知。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"她坐在自己的家門口，","poem":1},{"lineBreak":true},{"text":"坐在城中高處的座位上，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"呼叫過路的，","poem":1},{"lineBreak":true},{"text":"就是直行其道的人，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"說：誰是愚蒙人，可以轉到這裏來！","poem":1},{"lineBreak":true},{"text":"又對那無知的人說：","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"偷來的水是甜的，","poem":1},{"lineBreak":true},{"text":"暗吃的餅是好的。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"人卻不知有陰魂在她那裏；","poem":1},{"lineBreak":true},{"text":"她的客在陰間的深處。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}