{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":1,"content":[{"type":"heading","content":["真福"]},{"type":"verse","number":1,"content":[{"text":"不從惡人的計謀，","poem":1},{"lineBreak":true},{"text":"不站罪人的道路，","poem":1},{"lineBreak":true},{"text":"不坐褻慢人的座位，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"惟喜愛耶和華的律法，","poem":1},{"lineBreak":true},{"text":"晝夜思想，","poem":1},{"lineBreak":true},{"text":"這人便為有福！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他要像一棵樹栽在溪水旁，","poem":1},{"lineBreak":true},{"text":"按時候結果子，","poem":1},{"lineBreak":true},{"text":"葉子也不枯乾。","poem":1},{"lineBreak":true},{"text":"凡他所做的盡都順利。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"惡人並不是這樣，","poem":1},{"lineBreak":true},{"text":"乃像糠詷被風吹散。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因此，當審判的時候，惡人必站立不住；","poem":1},{"lineBreak":true},{"text":"罪人在義人的會中也是如此。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因為耶和華知道義人的道路；","poem":1},{"lineBreak":true},{"text":"惡人的道路卻必滅亡。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}