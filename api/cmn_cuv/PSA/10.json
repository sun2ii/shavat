{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":10,"content":[{"type":"heading","content":["為公義而祈禱"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，你為甚麼站在遠處？","poem":1},{"lineBreak":true},{"text":"在患難的時候為甚麼隱藏？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"惡人在驕橫中把困苦人追得火急；","poem":1},{"lineBreak":true},{"text":"願他們陷在自己所設的計謀裏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因為惡人以心願自誇；","poem":1},{"lineBreak":true},{"text":"貪財的背棄耶和華，並且輕慢他","poem":1},{"noteId":3},{"text":"。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"惡人面帶驕傲，說：耶和華必不追究；","poem":1},{"lineBreak":true},{"text":"他一切所想的都以為沒有上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"凡他所做的，時常穩固；","poem":1},{"lineBreak":true},{"text":"你的審判超過他的眼界。","poem":1},{"lineBreak":true},{"text":"至於他一切的敵人，","poem":1},{"lineBreak":true},{"text":"他都向他們噴氣。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他心裏說：我必不動搖，","poem":1},{"lineBreak":true},{"text":"世世代代不遭災難。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"他滿口是咒罵、詭詐、欺壓，","poem":1},{"lineBreak":true},{"text":"舌底是毒害、奸惡。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他在村莊埋伏等候；","poem":1},{"lineBreak":true},{"text":"他在隱密處殺害無辜的人。","poem":1},{"lineBreak":true},{"text":"他的眼睛窺探無倚無靠的人；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他埋伏在暗地，如獅子蹲在洞中。","poem":1},{"lineBreak":true},{"text":"他埋伏，要擄去困苦人；","poem":1},{"lineBreak":true},{"text":"他拉網，就把困苦人擄去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"他屈身蹲伏，","poem":1},{"lineBreak":true},{"text":"無倚無靠的人就倒在他爪牙","poem":1},{"noteId":4},{"text":"之下。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他心裏說：上帝竟忘記了；","poem":1},{"lineBreak":true},{"text":"他掩面永不觀看。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和華啊，求你起來！","poem":1},{"lineBreak":true},{"text":"上帝啊，求你舉手，不要忘記困苦人！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"惡人為何輕慢上帝，","poem":1},{"lineBreak":true},{"text":"心裏說：你必不追究？","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"其實你已經觀看；","poem":1},{"lineBreak":true},{"text":"因為奸惡毒害，你都看見了，","poem":1},{"lineBreak":true},{"text":"為要以手施行報應。","poem":1},{"lineBreak":true},{"text":"無倚無靠的人把自己交託你；","poem":1},{"lineBreak":true},{"text":"你向來是幫助孤兒的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"願你打斷惡人的膀臂；","poem":1},{"lineBreak":true},{"text":"至於壞人，願你追究他的惡，直到淨盡。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華永永遠遠為王；","poem":1},{"lineBreak":true},{"text":"外邦人從他的地已經滅絕了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"耶和華啊，謙卑人的心願，","poem":1},{"lineBreak":true},{"text":"你早已知道","poem":1},{"noteId":5},{"text":"。","poem":1},{"lineBreak":true},{"text":"你必預備他們的心，","poem":1},{"lineBreak":true},{"text":"也必側耳聽他們的祈求，","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"為要給孤兒和受欺壓的人伸冤，","poem":1},{"lineBreak":true},{"text":"使強橫的人不再威嚇他們。","poem":1}]}],"footnotes":[{"noteId":3,"caller":"-","text":"或譯：他祝福貪財的，卻輕慢耶和華","reference":{"chapter":10,"verse":3}},{"noteId":4,"caller":"-","text":"爪牙：或譯強暴人","reference":{"chapter":10,"verse":10}},{"noteId":5,"caller":"-","text":"原文是聽見","reference":{"chapter":10,"verse":17}}]},"thisChapterLink":"/api/cmn_cuv/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}