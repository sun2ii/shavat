{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":100,"content":[{"type":"heading","content":["頌讚之詩"]},{"type":"hebrew_subtitle","content":["稱謝詩。"]},{"type":"verse","number":1,"content":[{"text":"普天下當向耶和華歡呼！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們當樂意事奉耶和華，","poem":1},{"lineBreak":true},{"text":"當來向他歌唱！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你們當曉得耶和華是上帝！","poem":1},{"lineBreak":true},{"text":"我們是他造的，也是屬他的；","poem":1},{"lineBreak":true},{"text":"我們是他的民，也是他草場的羊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"當稱謝進入他的門；","poem":1},{"lineBreak":true},{"text":"當讚美進入他的院。","poem":1},{"lineBreak":true},{"text":"當感謝他，稱頌他的名！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"因為耶和華本為善。","poem":1},{"lineBreak":true},{"text":"他的慈愛存到永遠；","poem":1},{"lineBreak":true},{"text":"他的信實直到萬代。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}