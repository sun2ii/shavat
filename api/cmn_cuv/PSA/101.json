{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":101,"content":[{"type":"heading","content":["王的諾言"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"我要歌唱慈愛和公平；","poem":1},{"lineBreak":true},{"text":"耶和華啊，我要向你歌頌！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要用智慧行完全的道。","poem":1},{"lineBreak":true},{"text":"你幾時到我這裏來呢？","poem":1},{"lineBreak":true},{"text":"我要存完全的心行在我家中。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"邪僻的事，我都不擺在我眼前；","poem":1},{"lineBreak":true},{"text":"悖逆人所做的事，我甚恨惡，","poem":1},{"lineBreak":true},{"text":"不容沾在我身上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"彎曲的心思，我必遠離；","poem":1},{"lineBreak":true},{"text":"一切的惡人","poem":1},{"noteId":37},{"text":"，我不認識。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"在暗中讒謗他鄰居的，我必將他滅絕；","poem":1},{"lineBreak":true},{"text":"眼目高傲、心裏驕縱的，我必不容他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我眼要看國中的誠實人，叫他們與我同住；","poem":1},{"lineBreak":true},{"text":"行為完全的，他要伺候我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"行詭詐的，必不得住在我家裏；","poem":1},{"lineBreak":true},{"text":"說謊話的，必不得立在我眼前。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我每日早晨要滅絕國中所有的惡人，","poem":1},{"lineBreak":true},{"text":"好把一切作孽的從耶和華的城裏剪除。","poem":1}]}],"footnotes":[{"noteId":37,"caller":"-","text":"或譯：惡事","reference":{"chapter":101,"verse":4}}]},"thisChapterLink":"/api/cmn_cuv/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}