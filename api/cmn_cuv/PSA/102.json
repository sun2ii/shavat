{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":102,"content":[{"type":"heading","content":["遭難中的祈禱"]},{"type":"hebrew_subtitle","content":["困苦人發昏的時候，在耶和華面前吐露苦情的禱告。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你聽我的禱告，","poem":1},{"lineBreak":true},{"text":"容我的呼求達到你面前！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在急難的日子，求你向我側耳；","poem":1},{"lineBreak":true},{"text":"不要向我掩面！","poem":1},{"lineBreak":true},{"text":"我呼求的日子，求你快快應允我！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因為，我的年日如煙雲消滅；","poem":1},{"lineBreak":true},{"text":"我的骨頭如火把燒着。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的心被傷，如草枯乾，","poem":1},{"lineBreak":true},{"text":"甚至我忘記吃飯。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因我唉哼的聲音，","poem":1},{"lineBreak":true},{"text":"我的肉緊貼骨頭。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我如同曠野的鵜鶘；","poem":1},{"lineBreak":true},{"text":"我好像荒場的鴞鳥。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我警醒不睡；","poem":1},{"lineBreak":true},{"text":"我像房頂上孤單的麻雀。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的仇敵終日辱罵我；","poem":1},{"lineBreak":true},{"text":"向我猖狂的人指着我賭咒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我吃過爐灰，如同吃飯；","poem":1},{"lineBreak":true},{"text":"我所喝的與眼淚攙雜。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"這都因你的惱恨和忿怒；","poem":1},{"lineBreak":true},{"text":"你把我拾起來，又把我摔下去。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的年日如日影偏斜；","poem":1},{"lineBreak":true},{"text":"我也如草枯乾。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"惟你－耶和華必存到永遠；","poem":1},{"lineBreak":true},{"text":"你可記念的名也存到萬代。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你必起來憐恤錫安，","poem":1},{"lineBreak":true},{"text":"因現在是可憐她的時候，","poem":1},{"lineBreak":true},{"text":"日期已經到了。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你的僕人原來喜悅她的石頭，","poem":1},{"lineBreak":true},{"text":"可憐她的塵土。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"列國要敬畏耶和華的名；","poem":1},{"lineBreak":true},{"text":"世上諸王都敬畏你的榮耀。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因為耶和華建造了錫安，","poem":1},{"lineBreak":true},{"text":"在他榮耀裏顯現。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他垂聽窮人的禱告，","poem":1},{"lineBreak":true},{"text":"並不藐視他們的祈求。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"這必為後代的人記下，","poem":1},{"lineBreak":true},{"text":"將來受造的民要讚美耶和華。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"因為，他從至高的聖所垂看；","poem":1},{"lineBreak":true},{"text":"耶和華從天向地觀察，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"要垂聽被囚之人的歎息，","poem":1},{"lineBreak":true},{"text":"要釋放將要死的人，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"使人在錫安傳揚耶和華的名，","poem":1},{"lineBreak":true},{"text":"在耶路撒冷傳揚讚美他的話，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"就是在萬民和列國","poem":1},{"lineBreak":true},{"text":"聚會事奉耶和華的時候。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"他使我的力量中道衰弱，","poem":1},{"lineBreak":true},{"text":"使我的年日短少。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我說：我的上帝啊，","poem":1},{"lineBreak":true},{"text":"不要使我中年去世。","poem":1},{"lineBreak":true},{"text":"你的年數世世無窮！","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"你起初立了地的根基；","poem":1},{"lineBreak":true},{"text":"天也是你手所造的。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"天地都要滅沒，你卻要長存；","poem":1},{"lineBreak":true},{"text":"天地都要如外衣漸漸舊了。","poem":1},{"lineBreak":true},{"text":"你要將天地如裏衣更換，","poem":1},{"lineBreak":true},{"text":"天地就都改變了。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"惟有你永不改變；","poem":1},{"lineBreak":true},{"text":"你的年數沒有窮盡。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你僕人的子孫要長存；","poem":1},{"lineBreak":true},{"text":"他們的後裔要堅立在你面前。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}