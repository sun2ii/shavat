{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":103,"content":[{"type":"heading","content":["耶和華的慈愛"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"我的心哪，你要稱頌耶和華！","poem":1},{"lineBreak":true},{"text":"凡在我裏面的，也要稱頌他的聖名！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的心哪，你要稱頌耶和華！","poem":1},{"lineBreak":true},{"text":"不可忘記他的一切恩惠！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他赦免你的一切罪孽，","poem":1},{"lineBreak":true},{"text":"醫治你的一切疾病。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他救贖你的命脫離死亡，","poem":1},{"lineBreak":true},{"text":"以仁愛和慈悲為你的冠冕。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他用美物使你所願的得以知足，","poem":1},{"lineBreak":true},{"text":"以致你如鷹返老還童。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和華施行公義，","poem":1},{"lineBreak":true},{"text":"為一切受屈的人伸冤。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他使摩西知道他的法則，","poem":1},{"lineBreak":true},{"text":"叫以色列人曉得他的作為。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華有憐憫，有恩典，","poem":1},{"lineBreak":true},{"text":"不輕易發怒，且有豐盛的慈愛。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他不長久責備，","poem":1},{"lineBreak":true},{"text":"也不永遠懷怒。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他沒有按我們的罪過待我們，","poem":1},{"lineBreak":true},{"text":"也沒有照我們的罪孽報應我們。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"天離地何等的高，","poem":1},{"lineBreak":true},{"text":"他的慈愛向敬畏他的人也是何等的大！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"東離西有多遠，","poem":1},{"lineBreak":true},{"text":"他叫我們的過犯離我們也有多遠！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"父親怎樣憐恤他的兒女，","poem":1},{"lineBreak":true},{"text":"耶和華也怎樣憐恤敬畏他的人！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因為他知道我們的本體，","poem":1},{"lineBreak":true},{"text":"思念我們不過是塵土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"至於世人，他的年日如草一樣。","poem":1},{"lineBreak":true},{"text":"他發旺如野地的花，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"經風一吹，便歸無有；","poem":1},{"lineBreak":true},{"text":"它的原處也不再認識它。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"但耶和華的慈愛歸於敬畏他的人，","poem":1},{"lineBreak":true},{"text":"從亙古到永遠；","poem":1},{"lineBreak":true},{"text":"他的公義也歸於子子孫孫－","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"就是那些遵守他的約、","poem":1},{"lineBreak":true},{"text":"記念他的訓詞而遵行的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和華在天上立定寶座；","poem":1},{"lineBreak":true},{"text":"他的權柄","poem":1},{"noteId":38},{"text":"統管萬有。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"聽從他命令、成全他旨意、","poem":1},{"lineBreak":true},{"text":"有大能的天使，都要稱頌耶和華！","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"你們作他的諸軍，作他的僕役，","poem":1},{"lineBreak":true},{"text":"行他所喜悅的，都要稱頌耶和華！","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"你們一切被他造的，","poem":1},{"lineBreak":true},{"text":"在他所治理的各處，","poem":1},{"lineBreak":true},{"text":"都要稱頌耶和華！","poem":1},{"lineBreak":true},{"text":"我的心哪，你要稱頌耶和華！","poem":1}]}],"footnotes":[{"noteId":38,"caller":"-","text":"原文是國","reference":{"chapter":103,"verse":19}}]},"thisChapterLink":"/api/cmn_cuv/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}