{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":104,"content":[{"type":"heading","content":["造化主頌"]},{"type":"verse","number":1,"content":[{"text":"我的心哪，你要稱頌耶和華！","poem":1},{"lineBreak":true},{"text":"耶和華－我的上帝啊，你為至大！","poem":1},{"lineBreak":true},{"text":"你以尊榮威嚴為衣服，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"披上亮光，如披外袍，","poem":1},{"lineBreak":true},{"text":"鋪張穹蒼，如鋪幔子，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"在水中立樓閣的棟樑，","poem":1},{"lineBreak":true},{"text":"用雲彩為車輦，","poem":1},{"lineBreak":true},{"text":"藉着風的翅膀而行，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"以風為使者，","poem":1},{"lineBreak":true},{"text":"以火焰為僕役，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"將地立在根基上，","poem":1},{"lineBreak":true},{"text":"使地永不動搖。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你用深水遮蓋地面，猶如衣裳；","poem":1},{"lineBreak":true},{"text":"諸水高過山嶺。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的斥責一發，水便奔逃；","poem":1},{"lineBreak":true},{"text":"你的雷聲一發，水便奔流。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"諸山升上，諸谷沉下","poem":1},{"noteId":39},{"text":"，","poem":1},{"lineBreak":true},{"text":"歸你為它所安定之地。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你定了界限，使水不能過去，","poem":1},{"lineBreak":true},{"text":"不再轉回遮蓋地面。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和華使泉源湧在山谷，","poem":1},{"lineBreak":true},{"text":"流在山間，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"使野地的走獸有水喝，","poem":1},{"lineBreak":true},{"text":"野驢得解其渴。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"天上的飛鳥在水旁住宿，","poem":1},{"lineBreak":true},{"text":"在樹枝上啼叫。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他從樓閣中澆灌山嶺；","poem":1},{"lineBreak":true},{"text":"因他作為的功效，地就豐足。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"他使草生長，給六畜吃，","poem":1},{"lineBreak":true},{"text":"使菜蔬發長，供給人用，","poem":1},{"lineBreak":true},{"text":"使人從地裏能得食物，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"又得酒能悅人心，","poem":1},{"lineBreak":true},{"text":"得油能潤人面，","poem":1},{"lineBreak":true},{"text":"得糧能養人心。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"佳美的樹木，就是黎巴嫩的香柏樹，","poem":1},{"lineBreak":true},{"text":"是耶和華所栽種的，都滿了汁漿。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"雀鳥在其上搭窩；","poem":1},{"lineBreak":true},{"text":"至於鶴，松樹是牠的房屋。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"高山為野山羊的住所；","poem":1},{"lineBreak":true},{"text":"巖石為沙番的藏處。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你安置月亮為定節令；","poem":1},{"lineBreak":true},{"text":"日頭自知沉落。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你造黑暗為夜，","poem":1},{"lineBreak":true},{"text":"林中的百獸就都爬出來。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"少壯獅子吼叫，要抓食，","poem":1},{"lineBreak":true},{"text":"向上帝尋求食物。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"日頭一出，獸便躲避，","poem":1},{"lineBreak":true},{"text":"臥在洞裏。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"人出去做工，","poem":1},{"lineBreak":true},{"text":"勞碌直到晚上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"耶和華啊，你所造的何其多！","poem":1},{"lineBreak":true},{"text":"都是你用智慧造成的；","poem":1},{"lineBreak":true},{"text":"遍地滿了你的豐富。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"那裏有海，又大又廣；","poem":1},{"lineBreak":true},{"text":"其中有無數的動物，","poem":1},{"lineBreak":true},{"text":"大小活物都有。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"那裏有船行走，","poem":1},{"lineBreak":true},{"text":"有你所造的鱷魚游泳在其中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"這都仰望你按時給牠食物。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你給牠們，牠們便拾起來；","poem":1},{"lineBreak":true},{"text":"你張手，牠們飽得美食。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"你掩面，牠們便驚惶；","poem":1},{"lineBreak":true},{"text":"你收回牠們的氣，牠們就死亡，歸於塵土。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"你發出你的靈，牠們便受造；","poem":1},{"lineBreak":true},{"text":"你使地面更換為新。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"願耶和華的榮耀存到永遠！","poem":1},{"lineBreak":true},{"text":"願耶和華喜悅自己所造的！","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他看地，地便震動；","poem":1},{"lineBreak":true},{"text":"他摸山，山就冒煙。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"我要一生向耶和華唱詩！","poem":1},{"lineBreak":true},{"text":"我還活的時候，要向我上帝歌頌！","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"願他以我的默念為甘甜！","poem":1},{"lineBreak":true},{"text":"我要因耶和華歡喜！","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"願罪人從世上消滅！","poem":1},{"lineBreak":true},{"text":"願惡人歸於無有！","poem":1},{"lineBreak":true},{"text":"我的心哪，要稱頌耶和華！","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華","poem":1},{"noteId":40},{"text":"！","poem":1}]}],"footnotes":[{"noteId":39,"caller":"-","text":"或譯：隨山上翻，隨谷下流","reference":{"chapter":104,"verse":8}},{"noteId":40,"caller":"-","text":"原文是哈利路亞；下同","reference":{"chapter":104,"verse":35}}]},"thisChapterLink":"/api/cmn_cuv/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}