{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":105,"content":[{"type":"heading","content":["上帝和他的子民"]},{"type":"verse","number":1,"content":[{"text":"你們要稱謝耶和華， 求告他的名，","poem":1},{"lineBreak":true},{"text":"在萬民中傳揚他的作為！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要向他唱詩歌頌，","poem":1},{"lineBreak":true},{"text":"談論他一切奇妙的作為！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"要以他的聖名誇耀！","poem":1},{"lineBreak":true},{"text":"尋求耶和華的人，心中應當歡喜！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"要尋求耶和華與他的能力，","poem":1},{"lineBreak":true},{"text":"時常尋求他的面。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他僕人亞伯拉罕的後裔，","poem":1},{"lineBreak":true},{"text":"他所揀選雅各的子孫哪，","poem":1},{"lineBreak":true},{"text":"你們要記念他奇妙的作為和他的奇事，","poem":1},{"lineBreak":true},{"text":"並他口中的判語。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"他是耶和華－我們的上帝；","poem":1},{"lineBreak":true},{"text":"全地都有他的判斷。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他記念他的約，直到永遠；","poem":1},{"lineBreak":true},{"text":"他所吩咐的話，直到千代－","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"就是與亞伯拉罕所立的約，","poem":1},{"lineBreak":true},{"text":"向以撒所起的誓。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他又將這約向雅各定為律例，","poem":1},{"lineBreak":true},{"text":"向以色列定為永遠的約，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"說：我必將迦南地賜給你，","poem":1},{"lineBreak":true},{"text":"作你產業的分。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"當時，他們人丁有限，數目稀少，","poem":1},{"lineBreak":true},{"text":"並且在那地為寄居的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他們從這邦遊到那邦，","poem":1},{"lineBreak":true},{"text":"從這國行到那國。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他不容甚麼人欺負他們，","poem":1},{"lineBreak":true},{"text":"為他們的緣故責備君王，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"說：不可難為我受膏的人，","poem":1},{"lineBreak":true},{"text":"也不可惡待我的先知。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"他命饑荒降在那地上，","poem":1},{"lineBreak":true},{"text":"將所倚靠的糧食全行斷絕，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"在他們以先打發一個人去","poem":1},{"lineBreak":true},{"text":"－約瑟被賣為奴僕。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"人用腳鐐傷他的腳；","poem":1},{"lineBreak":true},{"text":"他被鐵鍊捆拘。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"耶和華的話試煉他，","poem":1},{"lineBreak":true},{"text":"直等到他所說的應驗了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"王打發人把他解開，","poem":1},{"lineBreak":true},{"text":"就是治理眾民的，把他釋放，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"立他作王家之主，","poem":1},{"lineBreak":true},{"text":"掌管他一切所有的，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"使他隨意捆綁他的臣宰，","poem":1},{"lineBreak":true},{"text":"將智慧教導他的長老。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"以色列也到了埃及；","poem":1},{"lineBreak":true},{"text":"雅各在含地寄居。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"耶和華使他的百姓生養眾多，","poem":1},{"lineBreak":true},{"text":"使他們比敵人強盛，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"使敵人的心轉去恨他的百姓，","poem":1},{"lineBreak":true},{"text":"並用詭計待他的僕人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"他打發他的僕人摩西","poem":1},{"lineBreak":true},{"text":"和他所揀選的亞倫，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"在敵人中間顯他的神蹟，","poem":1},{"lineBreak":true},{"text":"在含地顯他的奇事。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"他命黑暗，就有黑暗；","poem":1},{"lineBreak":true},{"text":"沒有違背他話的。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他叫埃及的水變為血，","poem":1},{"lineBreak":true},{"text":"叫他們的魚死了。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"在他們的地上以及王宮的內室，","poem":1},{"lineBreak":true},{"text":"青蛙多多滋生。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他說一聲，蒼蠅就成群而來，","poem":1},{"lineBreak":true},{"text":"並有虱子進入他們四境。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"他給他們降下冰雹為雨，","poem":1},{"lineBreak":true},{"text":"在他們的地上降下火焰。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他也擊打他們的葡萄樹和無花果樹，","poem":1},{"lineBreak":true},{"text":"毀壞他們境內的樹木。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"他說一聲，就有蝗蟲螞蚱上來，","poem":1},{"lineBreak":true},{"text":"不計其數，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"吃盡了他們地上各樣的菜蔬","poem":1},{"lineBreak":true},{"text":"和田地的出產。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他又擊殺他們國內一切的長子，","poem":1},{"lineBreak":true},{"text":"就是他們強壯時頭生的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"他領自己的百姓帶銀子金子出來；","poem":1},{"lineBreak":true},{"text":"他支派中沒有一個軟弱的。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"他們出來的時候，埃及人便歡喜；","poem":1},{"lineBreak":true},{"text":"原來埃及人懼怕他們。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"他鋪張雲彩當遮蓋，","poem":1},{"lineBreak":true},{"text":"夜間使火光照。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"他們一求，他就使鵪鶉飛來，","poem":1},{"lineBreak":true},{"text":"並用天上的糧食叫他們飽足。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"他打開磐石，水就湧出；","poem":1},{"lineBreak":true},{"text":"在乾旱之處，水流成河。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"這都因他記念他的聖言","poem":1},{"lineBreak":true},{"text":"和他的僕人亞伯拉罕。","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"他帶領百姓歡樂而出，","poem":1},{"lineBreak":true},{"text":"帶領選民歡呼前往。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"他將列國的地賜給他們，","poem":1},{"lineBreak":true},{"text":"他們便承受眾民勞碌得來的，","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"好使他們遵他的律例，","poem":1},{"lineBreak":true},{"text":"守他的律法。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":44}