{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":106,"content":[{"type":"heading","content":["上帝對他子民的良善"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"要稱謝耶和華，因他本為善；","poem":1},{"lineBreak":true},{"text":"他的慈愛永遠長存！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"誰能傳說耶和華的大能？","poem":1},{"lineBreak":true},{"text":"誰能表明他一切的美德？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"凡遵守公平、常行公義的，","poem":1},{"lineBreak":true},{"text":"這人便為有福！","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華啊，你用恩惠待你的百姓；","poem":1},{"lineBreak":true},{"text":"求你也用這恩惠記念我，開你的救恩眷顧我，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"使我見你選民的福，","poem":1},{"lineBreak":true},{"text":"樂你國民的樂，","poem":1},{"lineBreak":true},{"text":"與你的產業一同誇耀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我們與我們的祖宗一同犯罪；","poem":1},{"lineBreak":true},{"text":"我們作了孽，行了惡。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我們的祖宗在埃及不明白你的奇事，","poem":1},{"lineBreak":true},{"text":"不記念你豐盛的慈愛，","poem":1},{"lineBreak":true},{"text":"反倒在紅海行了悖逆。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"然而，他因自己的名拯救他們，","poem":1},{"lineBreak":true},{"text":"為要彰顯他的大能，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"並且斥責紅海，海便乾了；","poem":1},{"lineBreak":true},{"text":"他帶領他們經過深處，如同經過曠野。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他拯救他們脫離恨他們人的手，","poem":1},{"lineBreak":true},{"text":"從仇敵手中救贖他們。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"水淹沒他們的敵人，","poem":1},{"lineBreak":true},{"text":"沒有一個存留。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"那時，他們才信了他的話，","poem":1},{"lineBreak":true},{"text":"歌唱讚美他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"等不多時，他們就忘了他的作為，","poem":1},{"lineBreak":true},{"text":"不仰望他的指教，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"反倒在曠野大起慾心，","poem":1},{"lineBreak":true},{"text":"在荒地試探上帝。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他將他們所求的賜給他們，","poem":1},{"lineBreak":true},{"text":"卻使他們的心靈軟弱。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"他們又在營中嫉妒摩西","poem":1},{"lineBreak":true},{"text":"和耶和華的聖者亞倫。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"地裂開，吞下大坍，","poem":1},{"lineBreak":true},{"text":"掩蓋亞比蘭一黨的人。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"有火在他們的黨中發起；","poem":1},{"lineBreak":true},{"text":"有火焰燒毀了惡人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"他們在何烈山造了牛犢，","poem":1},{"lineBreak":true},{"text":"叩拜鑄成的像。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"如此將他們榮耀的主","poem":1},{"lineBreak":true},{"text":"換為吃草之牛的像，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"忘了上帝－他們的救主；","poem":1},{"lineBreak":true},{"text":"他曾在埃及行大事，","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"在含地行奇事，","poem":1},{"lineBreak":true},{"text":"在紅海行可畏的事。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"所以，他說要滅絕他們；","poem":1},{"lineBreak":true},{"text":"若非有他所揀選的摩西站在當中","poem":1},{"noteId":41},{"text":"，","poem":1},{"lineBreak":true},{"text":"使他的忿怒轉消，","poem":1},{"lineBreak":true},{"text":"恐怕他就滅絕他們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"他們又藐視那美地，","poem":1},{"lineBreak":true},{"text":"不信他的話，","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"在自己帳棚內發怨言，","poem":1},{"lineBreak":true},{"text":"不聽耶和華的聲音。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"所以，他對他們起誓：","poem":1},{"lineBreak":true},{"text":"必叫他們倒在曠野，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"叫他們的後裔倒在列國之中，","poem":1},{"lineBreak":true},{"text":"分散在各地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"他們又與巴力‧毗珥連合，","poem":1},{"lineBreak":true},{"text":"且吃了祭死神","poem":1},{"noteId":42},{"text":"的物。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他們這樣行，惹耶和華發怒，","poem":1},{"lineBreak":true},{"text":"便有瘟疫流行在他們中間。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"那時，非尼哈站起，刑罰惡人，","poem":1},{"lineBreak":true},{"text":"瘟疫這才止息。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"那就算為他的義，","poem":1},{"lineBreak":true},{"text":"世世代代，直到永遠。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"他們在米利巴水又叫耶和華發怒，","poem":1},{"lineBreak":true},{"text":"甚至摩西也受了虧損，","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"是因他們惹動他的靈，","poem":1},{"lineBreak":true},{"text":"摩西","poem":1},{"noteId":43},{"text":"用嘴說了急躁的話。","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"他們不照耶和華所吩咐的","poem":1},{"lineBreak":true},{"text":"滅絕外邦人，","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"反與他們混雜相合，","poem":1},{"lineBreak":true},{"text":"學習他們的行為，","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"事奉他們的偶像，","poem":1},{"lineBreak":true},{"text":"這就成了自己的網羅，","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"把自己的兒女祭祀鬼魔，","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"流無辜人的血，","poem":1},{"lineBreak":true},{"text":"就是自己兒女的血，","poem":1},{"lineBreak":true},{"text":"把他們祭祀迦南的偶像，","poem":1},{"lineBreak":true},{"text":"那地就被血污穢了。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"這樣，他們被自己所做的污穢了，","poem":1},{"lineBreak":true},{"text":"在行為上犯了邪淫。","poem":1}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"所以，耶和華的怒氣向他的百姓發作，","poem":1},{"lineBreak":true},{"text":"憎惡他的產業，","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"將他們交在外邦人的手裏；","poem":1},{"lineBreak":true},{"text":"恨他們的人就轄制他們。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"他們的仇敵也欺壓他們，","poem":1},{"lineBreak":true},{"text":"他們就伏在敵人手下。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"他屢次搭救他們，","poem":1},{"lineBreak":true},{"text":"他們卻設謀背逆，","poem":1},{"lineBreak":true},{"text":"因自己的罪孽降為卑下。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"然而，他聽見他們哀告的時候，","poem":1},{"lineBreak":true},{"text":"就眷顧他們的急難，","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"為他們記念他的約，","poem":1},{"lineBreak":true},{"text":"照他豐盛的慈愛後悔。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"他也使他們在凡擄掠他們的人面前蒙憐恤。","poem":1}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"耶和華－我們的上帝啊，求你拯救我們，","poem":1},{"lineBreak":true},{"text":"從外邦中招聚我們，","poem":1},{"lineBreak":true},{"text":"我們好稱讚你的聖名，","poem":1},{"lineBreak":true},{"text":"以讚美你為誇勝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"耶和華－以色列的上帝是應當稱頌的，","poem":1},{"lineBreak":true},{"text":"從亙古直到永遠。","poem":1},{"lineBreak":true},{"text":"願眾民都說：阿們！","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[{"noteId":41,"caller":"-","text":"原文是破口","reference":{"chapter":106,"verse":23}},{"noteId":42,"caller":"-","text":"或譯：人","reference":{"chapter":106,"verse":28}},{"noteId":43,"caller":"-","text":"原文是他","reference":{"chapter":106,"verse":33}}]},"thisChapterLink":"/api/cmn_cuv/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}