{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":107,"content":[{"type":"heading","content":["頌讚上帝的良善"]},{"type":"verse","number":1,"content":[{"text":"你們要稱謝耶和華，因他本為善；","poem":1},{"lineBreak":true},{"text":"他的慈愛永遠長存！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願耶和華的贖民說這話，","poem":1},{"lineBreak":true},{"text":"就是他從敵人手中所救贖的，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"從各地，從東從西，","poem":1},{"lineBreak":true},{"text":"從南從北，所招聚來的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他們在曠野荒地漂流，","poem":1},{"lineBreak":true},{"text":"尋不見可住的城邑，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"又飢又渴，","poem":1},{"lineBreak":true},{"text":"心裏發昏。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"於是，他們在苦難中哀求耶和華；","poem":1},{"lineBreak":true},{"text":"他從他們的禍患中搭救他們，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"又領他們行走直路，","poem":1},{"lineBreak":true},{"text":"使他們往可居住的城邑。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"但願人因耶和華的慈愛","poem":1},{"lineBreak":true},{"text":"和他向人所行的奇事都稱讚他；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因他使心裏渴慕的人得以知足，","poem":1},{"lineBreak":true},{"text":"使心裏飢餓的人得飽美物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"那些坐在黑暗中、死蔭裏的人","poem":1},{"lineBreak":true},{"text":"被困苦和鐵鍊捆鎖，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"是因他們違背上帝的話語，","poem":1},{"lineBreak":true},{"text":"藐視至高者的旨意。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"所以，他用勞苦治服他們的心；","poem":1},{"lineBreak":true},{"text":"他們仆倒，無人扶助。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"於是，他們在苦難中哀求耶和華；","poem":1},{"lineBreak":true},{"text":"他從他們的禍患中拯救他們。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他從黑暗中和死蔭裏領他們出來，","poem":1},{"lineBreak":true},{"text":"折斷他們的綁索。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"但願人因耶和華的慈愛","poem":1},{"lineBreak":true},{"text":"和他向人所行的奇事都稱讚他；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因為他打破了銅門，","poem":1},{"lineBreak":true},{"text":"砍斷了鐵閂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"愚妄人因自己的過犯","poem":1},{"lineBreak":true},{"text":"和自己的罪孽便受苦楚。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他們心裏厭惡各樣的食物，","poem":1},{"lineBreak":true},{"text":"就臨近死門。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"於是，他們在苦難中哀求耶和華；","poem":1},{"lineBreak":true},{"text":"他從他們的禍患中拯救他們。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他發命醫治他們，","poem":1},{"lineBreak":true},{"text":"救他們脫離死亡。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"但願人因耶和華的慈愛","poem":1},{"lineBreak":true},{"text":"和他向人所行的奇事都稱讚他。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"願他們以感謝為祭獻給他，","poem":1},{"lineBreak":true},{"text":"歡呼述說他的作為！","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"在海上坐船，","poem":1},{"lineBreak":true},{"text":"在大水中經理事務的，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他們看見耶和華的作為，","poem":1},{"lineBreak":true},{"text":"並他在深水中的奇事。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"因他一吩咐，狂風就起來，","poem":1},{"lineBreak":true},{"text":"海中的波浪也揚起。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他們上到天空，下到海底；","poem":1},{"lineBreak":true},{"text":"他們的心因患難便消化。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他們搖搖晃晃，東倒西歪，好像醉酒的人；","poem":1},{"lineBreak":true},{"text":"他們的智慧無法可施。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"於是，他們在苦難中哀求耶和華，","poem":1},{"lineBreak":true},{"text":"他從他們的禍患中領出他們來。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他使狂風止息，","poem":1},{"lineBreak":true},{"text":"波浪就平靜。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"風息浪靜，他們便歡喜；","poem":1},{"lineBreak":true},{"text":"他就引他們到所願去的海口。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"但願人因耶和華的慈愛","poem":1},{"lineBreak":true},{"text":"和他向人所行的奇事都稱讚他。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"願他們在民的會中尊崇他，","poem":1},{"lineBreak":true},{"text":"在長老的位上讚美他！","poem":1}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"他使江河變為曠野，","poem":1},{"lineBreak":true},{"text":"叫水泉變為乾渴之地，","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"使肥地變為鹼地；","poem":1},{"lineBreak":true},{"text":"這都因其間居民的罪惡。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"他使曠野變為水潭，","poem":1},{"lineBreak":true},{"text":"叫旱地變為水泉。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他使飢餓的人住在那裏，","poem":1},{"lineBreak":true},{"text":"好建造可住的城邑，","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"又種田地，栽葡萄園，","poem":1},{"lineBreak":true},{"text":"得享所出的土產。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"他又賜福給他們，叫他們生養眾多，","poem":1},{"lineBreak":true},{"text":"也不叫他們的牲畜減少。","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"他們又因暴虐、患難、愁苦，","poem":1},{"lineBreak":true},{"text":"就減少且卑下。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"他使君王蒙羞被辱，","poem":1},{"lineBreak":true},{"text":"使他們在荒廢無路之地漂流。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"他卻將窮乏人安置在高處，脫離苦難，","poem":1},{"lineBreak":true},{"text":"使他的家屬多如羊群。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"正直人看見就歡喜；","poem":1},{"lineBreak":true},{"text":"罪孽之輩必塞口無言。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"凡有智慧的，必在這些事上留心，","poem":1},{"lineBreak":true},{"text":"也必思想耶和華的慈愛。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}