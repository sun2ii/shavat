{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":108,"content":[{"type":"heading","content":["抗敵求助"]},{"type":"hebrew_subtitle","content":["大衛的詩歌。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，我心堅定；","poem":1},{"lineBreak":true},{"text":"我口","poem":1},{"noteId":44},{"text":"要唱詩歌頌！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"琴瑟啊，你們當醒起！","poem":1},{"lineBreak":true},{"text":"我自己要極早醒起！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華啊，我要在萬民中稱謝你，","poem":1},{"lineBreak":true},{"text":"在列邦中歌頌你！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因為，你的慈愛大過諸天；","poem":1},{"lineBreak":true},{"text":"你的誠實達到穹蒼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"上帝啊，願你崇高過於諸天！","poem":1},{"lineBreak":true},{"text":"願你的榮耀高過全地！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你應允我們，用右手拯救我們，","poem":1},{"lineBreak":true},{"text":"好叫你所親愛的人得救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"上帝已經指着他的聖潔說","poem":1},{"noteId":45},{"text":"：","poem":1},{"lineBreak":true},{"text":"我要歡樂；我要分開示劍，","poem":1},{"lineBreak":true},{"text":"丈量疏割谷。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"基列是我的；","poem":1},{"lineBreak":true},{"text":"瑪拿西是我的；","poem":1},{"lineBreak":true},{"text":"以法蓮是護衛我頭的；","poem":1},{"lineBreak":true},{"text":"猶大是我的杖；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"摩押是我的沐浴盆；","poem":1},{"lineBreak":true},{"text":"我要向以東拋鞋；","poem":1},{"lineBreak":true},{"text":"我必因勝非利士呼喊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"誰能領我進堅固城？","poem":1},{"lineBreak":true},{"text":"誰能引我到以東地？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝啊，你不是丟棄了我們嗎？","poem":1},{"lineBreak":true},{"text":"上帝啊，你不和我們的軍兵同去嗎？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你幫助我們攻擊敵人，","poem":1},{"lineBreak":true},{"text":"因為人的幫助是枉然的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我們倚靠上帝才得施展大能，","poem":1},{"lineBreak":true},{"text":"因為踐踏我們敵人的就是他。","poem":1}]}],"footnotes":[{"noteId":44,"caller":"-","text":"原文是榮耀","reference":{"chapter":108,"verse":1}},{"noteId":45,"caller":"-","text":"說：或譯應許我","reference":{"chapter":108,"verse":7}}]},"thisChapterLink":"/api/cmn_cuv/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}