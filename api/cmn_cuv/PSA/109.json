{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":109,"content":[{"type":"heading","content":["遭難者的苦訴"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"我所讚美的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你不要閉口不言。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為惡人的嘴和詭詐人的口已經張開攻擊我；","poem":1},{"lineBreak":true},{"text":"他們用撒謊的舌頭對我說話。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們圍繞我，說怨恨的話，","poem":1},{"lineBreak":true},{"text":"又無故地攻打我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們與我為敵以報我愛，","poem":1},{"lineBreak":true},{"text":"但我專心祈禱。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們向我以惡報善，","poem":1},{"lineBreak":true},{"text":"以恨報愛。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"願你派一個惡人轄制他，","poem":1},{"lineBreak":true},{"text":"派一個對頭站在他右邊！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他受審判的時候，","poem":1},{"lineBreak":true},{"text":"願他出來擔當罪名！","poem":1},{"lineBreak":true},{"text":"願他的祈禱反成為罪！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"願他的年日短少！","poem":1},{"lineBreak":true},{"text":"願別人得他的職分！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"願他的兒女為孤兒，","poem":1},{"lineBreak":true},{"text":"他的妻子為寡婦！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"願他的兒女漂流討飯，","poem":1},{"lineBreak":true},{"text":"從他們荒涼之處出來求食！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"願強暴的債主牢籠他一切所有的！","poem":1},{"lineBreak":true},{"text":"願外人搶他勞碌得來的！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"願無人向他延綿施恩！","poem":1},{"lineBreak":true},{"text":"願無人可憐他的孤兒！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"願他的後人斷絕，","poem":1},{"lineBreak":true},{"text":"名字被塗抹，不傳於下代！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"願他祖宗的罪孽被耶和華記念！","poem":1},{"lineBreak":true},{"text":"願他母親的罪過不被塗抹！","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"願這些罪常在耶和華面前，","poem":1},{"lineBreak":true},{"text":"使他的名號斷絕於世！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"因為他不想施恩，","poem":1},{"lineBreak":true},{"text":"卻逼迫困苦窮乏的和傷心的人，","poem":1},{"lineBreak":true},{"text":"要把他們治死。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他愛咒罵，咒罵就臨到他；","poem":1},{"lineBreak":true},{"text":"他不喜愛福樂，福樂就與他遠離！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他拿咒罵當衣服穿上；","poem":1},{"lineBreak":true},{"text":"這咒罵就如水進他裏面，","poem":1},{"lineBreak":true},{"text":"像油入他的骨頭。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"願這咒罵當他遮身的衣服，","poem":1},{"lineBreak":true},{"text":"當他常束的腰帶！","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"這就是我對頭和用惡言議論我的人","poem":1},{"lineBreak":true},{"text":"從耶和華那裏所受的報應。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"主－耶和華啊，求你為你的名恩待我；","poem":1},{"lineBreak":true},{"text":"因你的慈愛美好，求你搭救我！","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因為我困苦窮乏，","poem":1},{"lineBreak":true},{"text":"內心受傷。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我如日影漸漸偏斜而去；","poem":1},{"lineBreak":true},{"text":"我如蝗蟲被抖出來。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"我因禁食，膝骨軟弱；","poem":1},{"lineBreak":true},{"text":"我身上的肉也漸漸瘦了。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我受他們的羞辱，","poem":1},{"lineBreak":true},{"text":"他們看見我便搖頭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"耶和華－我的上帝啊，求你幫助我，","poem":1},{"lineBreak":true},{"text":"照你的慈愛拯救我，","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"使他們知道這是你的手，","poem":1},{"lineBreak":true},{"text":"是你－耶和華所行的事。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"任憑他們咒罵，惟願你賜福；","poem":1},{"lineBreak":true},{"text":"他們幾時起來就必蒙羞，","poem":1},{"lineBreak":true},{"text":"你的僕人卻要歡喜。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"願我的對頭披戴羞辱！","poem":1},{"lineBreak":true},{"text":"願他們以自己的羞愧為外袍遮身！","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我要用口極力稱謝耶和華；","poem":1},{"lineBreak":true},{"text":"我要在眾人中間讚美他；","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"因為他必站在窮乏人的右邊，","poem":1},{"lineBreak":true},{"text":"要救他脫離審判他靈魂的人。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}