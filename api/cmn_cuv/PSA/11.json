{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":11,"content":[{"type":"heading","content":["在主裏得安穩"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"我是投靠耶和華；","poem":1},{"lineBreak":true},{"text":"你們怎麼對我說：你當像鳥飛往你的山去。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"看哪，惡人彎弓，把箭搭在弦上，","poem":1},{"lineBreak":true},{"text":"要在暗中射那心裏正直的人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"根基若毀壞，","poem":1},{"lineBreak":true},{"text":"義人還能做甚麼呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華在他的聖殿裏；","poem":1},{"lineBreak":true},{"text":"耶和華的寶座在天上；","poem":1},{"lineBreak":true},{"text":"他的慧眼察看世人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華試驗義人；","poem":1},{"lineBreak":true},{"text":"惟有惡人和喜愛強暴的人，他心裏恨惡。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他要向惡人密布網羅；","poem":1},{"lineBreak":true},{"text":"有烈火、硫磺、熱風，作他們杯中的分。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因為耶和華是公義的，他喜愛公義；","poem":1},{"lineBreak":true},{"text":"正直人必得見他的面。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}