{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":110,"content":[{"type":"heading","content":["耶和華及其所選之王"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華對我主說：","poem":1},{"lineBreak":true},{"text":"你坐在我的右邊，","poem":1},{"lineBreak":true},{"text":"等我使你仇敵作你的腳凳。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"耶和華必使你從錫安伸出能力的杖來；","poem":1},{"lineBreak":true},{"text":"你要在你仇敵中掌權。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"當你掌權的日子","poem":1},{"noteId":46},{"text":"，","poem":1},{"lineBreak":true},{"text":"你的民要以聖潔的妝飾為衣","poem":1},{"noteId":47},{"text":"，","poem":1},{"lineBreak":true},{"text":"甘心犧牲自己；","poem":1},{"lineBreak":true},{"text":"你的民多如清晨的甘露","poem":1},{"noteId":48},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華起了誓，決不後悔，說：","poem":1},{"lineBreak":true},{"text":"你是照着麥基洗德的等次永遠為祭司。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"在你右邊的主，","poem":1},{"lineBreak":true},{"text":"當他發怒的日子，必打傷列王。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他要在列邦中刑罰惡人，","poem":1},{"lineBreak":true},{"text":"屍首就遍滿各處；","poem":1},{"lineBreak":true},{"text":"他要在許多國中打破仇敵的頭。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他要喝路旁的河水，","poem":1},{"lineBreak":true},{"text":"因此必抬起頭來。","poem":1}]}],"footnotes":[{"noteId":46,"caller":"-","text":"或譯：行軍的日子","reference":{"chapter":110,"verse":3}},{"noteId":47,"caller":"-","text":"或譯：以聖潔為妝飾","reference":{"chapter":110,"verse":3}},{"noteId":48,"caller":"-","text":"或譯：你少年時光耀如清晨的甘露","reference":{"chapter":110,"verse":3}}]},"thisChapterLink":"/api/cmn_cuv/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}