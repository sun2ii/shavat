{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":111,"content":[{"type":"heading","content":["讚美耶和華"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"我要在正直人的大會中，並公會中，","poem":1},{"lineBreak":true},{"text":"一心稱謝耶和華。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華的作為本為大；","poem":1},{"lineBreak":true},{"text":"凡喜愛的都必考察。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他所行的是尊榮和威嚴；","poem":1},{"lineBreak":true},{"text":"他的公義存到永遠。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他行了奇事，使人記念；","poem":1},{"lineBreak":true},{"text":"耶和華有恩惠，有憐憫。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他賜糧食給敬畏他的人；","poem":1},{"lineBreak":true},{"text":"他必永遠記念他的約。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他向百姓顯出大能的作為，","poem":1},{"lineBreak":true},{"text":"把外邦的地賜給他們為業。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他手所行的是誠實公平；","poem":1},{"lineBreak":true},{"text":"他的訓詞都是確實的，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"是永永遠遠堅定的，","poem":1},{"lineBreak":true},{"text":"是按誠實正直設立的。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他向百姓施行救贖，","poem":1},{"lineBreak":true},{"text":"命定他的約，直到永遠；","poem":1},{"lineBreak":true},{"text":"他的名聖而可畏。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"敬畏耶和華是智慧的開端；","poem":1},{"lineBreak":true},{"text":"凡遵行他命令的是聰明人。","poem":1},{"lineBreak":true},{"text":"耶和華是永遠當讚美的！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}