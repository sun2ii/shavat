{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":112,"content":[{"type":"heading","content":["義人之福"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"敬畏耶和華，甚喜愛他命令的，","poem":1},{"lineBreak":true},{"text":"這人便為有福！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他的後裔在世必強盛；","poem":1},{"lineBreak":true},{"text":"正直人的後代必要蒙福。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他家中有貨物，有錢財；","poem":1},{"lineBreak":true},{"text":"他的公義存到永遠。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"正直人在黑暗中，有光向他發現；","poem":1},{"lineBreak":true},{"text":"他有恩惠，有憐憫，有公義。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"施恩與人、借貸與人的，這人事情順利；","poem":1},{"lineBreak":true},{"text":"他被審判的時候要訴明自己的冤。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他永不動搖；","poem":1},{"lineBreak":true},{"text":"義人被記念，直到永遠。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他必不怕凶惡的信息；","poem":1},{"lineBreak":true},{"text":"他心堅定，倚靠耶和華。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他心確定，總不懼怕，","poem":1},{"lineBreak":true},{"text":"直到他看見敵人遭報。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他施捨錢財，賙濟貧窮；","poem":1},{"lineBreak":true},{"text":"他的仁義存到永遠。","poem":1},{"lineBreak":true},{"text":"他的角必被高舉，大有榮耀。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"惡人看見便惱恨，必咬牙而消化；","poem":1},{"lineBreak":true},{"text":"惡人的心願要歸滅絕。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}