{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":113,"content":[{"type":"heading","content":["讚美耶和華的良善"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"耶和華的僕人哪，你們要讚美，","poem":1},{"lineBreak":true},{"text":"讚美耶和華的名！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華的名是應當稱頌的，","poem":1},{"lineBreak":true},{"text":"從今時直到永遠！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"從日出之地到日落之處，","poem":1},{"lineBreak":true},{"text":"耶和華的名是應當讚美的！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華超乎萬民之上；","poem":1},{"lineBreak":true},{"text":"他的榮耀高過諸天。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"誰像耶和華－我們的上帝呢？","poem":1},{"lineBreak":true},{"text":"他坐在至高之處，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"自己謙卑，","poem":1},{"lineBreak":true},{"text":"觀看天上地下的事。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他從灰塵裏抬舉貧寒人，","poem":1},{"lineBreak":true},{"text":"從糞堆中提拔窮乏人，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"使他們與王子同坐，","poem":1},{"lineBreak":true},{"text":"就是與本國的王子同坐。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他使不能生育的婦人安居家中，","poem":1},{"lineBreak":true},{"text":"為多子的樂母。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}