{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":114,"content":[{"type":"heading","content":["逾越節之歌"]},{"type":"verse","number":1,"content":[{"text":"以色列出了埃及，","poem":1},{"lineBreak":true},{"text":"雅各家離開說異言之民；","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"那時，猶大為主的聖所，","poem":1},{"lineBreak":true},{"text":"以色列為他所治理的國度。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"滄海看見就奔逃；","poem":1},{"lineBreak":true},{"text":"約旦河也倒流。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"大山踴躍，如公羊；","poem":1},{"lineBreak":true},{"text":"小山跳舞，如羊羔。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"滄海啊，你為何奔逃？","poem":1},{"lineBreak":true},{"text":"約旦哪，你為何倒流？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"大山哪，你為何踴躍，如公羊？","poem":1},{"lineBreak":true},{"text":"小山哪，你為何跳舞，如羊羔？","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"大地啊，你因見主的面，","poem":1},{"lineBreak":true},{"text":"就是雅各上帝的面，便要震動。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他叫磐石變為水池，","poem":1},{"lineBreak":true},{"text":"叫堅石變為泉源。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}