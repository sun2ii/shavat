{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":115,"content":[{"type":"heading","content":["獨一真神"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，榮耀不要歸與我們，","poem":1},{"lineBreak":true},{"text":"不要歸與我們；","poem":1},{"lineBreak":true},{"text":"要因你的慈愛和誠實歸在你的名下！","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"為何容外邦人說：","poem":1},{"lineBreak":true},{"text":"他們的上帝在哪裏呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"然而，我們的上帝在天上，","poem":1},{"lineBreak":true},{"text":"都隨自己的意旨行事。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們的偶像是金的，銀的，","poem":1},{"lineBreak":true},{"text":"是人手所造的，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"有口卻不能言，","poem":1},{"lineBreak":true},{"text":"有眼卻不能看，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"有耳卻不能聽，","poem":1},{"lineBreak":true},{"text":"有鼻卻不能聞，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"有手卻不能摸，","poem":1},{"lineBreak":true},{"text":"有腳卻不能走，","poem":1},{"lineBreak":true},{"text":"有喉嚨也不能出聲。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"造他的要和他一樣；","poem":1},{"lineBreak":true},{"text":"凡靠他的也要如此。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"以色列啊，你要倚靠耶和華！","poem":1},{"lineBreak":true},{"text":"他是你的幫助和你的盾牌。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"亞倫家啊，你們要倚靠耶和華！","poem":1},{"lineBreak":true},{"text":"他是你們的幫助和你們的盾牌。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你們敬畏耶和華的，要倚靠耶和華！","poem":1},{"lineBreak":true},{"text":"他是你們的幫助和你們的盾牌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和華向來眷念我們；","poem":1},{"lineBreak":true},{"text":"他還要賜福給我們：","poem":1},{"lineBreak":true},{"text":"要賜福給以色列的家，","poem":1},{"lineBreak":true},{"text":"賜福給亞倫的家。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"凡敬畏耶和華的，無論大小，","poem":1},{"lineBreak":true},{"text":"主必賜福給他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"願耶和華叫你們","poem":1},{"lineBreak":true},{"text":"和你們的子孫日見加增。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你們蒙了造天地之耶和華的福！","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"天，是耶和華的天；","poem":1},{"lineBreak":true},{"text":"地，他卻給了世人。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"死人不能讚美耶和華；","poem":1},{"lineBreak":true},{"text":"下到寂靜中的也都不能。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"但我們要稱頌耶和華，","poem":1},{"lineBreak":true},{"text":"從今時直到永遠。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}