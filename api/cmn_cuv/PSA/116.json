{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":116,"content":[{"type":"heading","content":["為出死入生而讚美上帝"]},{"type":"verse","number":1,"content":[{"text":"我愛耶和華，","poem":1},{"lineBreak":true},{"text":"因為他聽了我的聲音和我的懇求。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他既向我側耳，","poem":1},{"lineBreak":true},{"text":"我一生要求告他。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"死亡的繩索纏繞我；","poem":1},{"lineBreak":true},{"text":"陰間的痛苦抓住我；","poem":1},{"lineBreak":true},{"text":"我遭遇患難愁苦。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"那時，我便求告耶和華的名，說：","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你救我的靈魂！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和華有恩惠，有公義；","poem":1},{"lineBreak":true},{"text":"我們的上帝以憐憫為懷。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華保護愚人；","poem":1},{"lineBreak":true},{"text":"我落到卑微的地步，他救了我。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的心哪！你要仍歸安樂，","poem":1},{"lineBreak":true},{"text":"因為耶和華用厚恩待你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"主啊，你救我的命免了死亡，","poem":1},{"lineBreak":true},{"text":"救我的眼免了流淚，","poem":1},{"lineBreak":true},{"text":"救我的腳免了跌倒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我要在耶和華面前行活人之路。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我因信，所以如此說話；","poem":1},{"lineBreak":true},{"text":"我受了極大的困苦。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我曾急促地說：","poem":1},{"lineBreak":true},{"text":"人都是說謊的！","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"我拿甚麼報答耶和華向我所賜的一切厚恩？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我要舉起救恩的杯，","poem":1},{"lineBreak":true},{"text":"稱揚耶和華的名。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我要在他眾民面前向耶和華還我的願。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"在耶和華眼中，","poem":1},{"lineBreak":true},{"text":"看聖民之死極為寶貴。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華啊，我真是你的僕人；","poem":1},{"lineBreak":true},{"text":"我是你的僕人，是你婢女的兒子。","poem":1},{"lineBreak":true},{"text":"你已經解開我的綁索。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我要以感謝為祭獻給你，","poem":1},{"lineBreak":true},{"text":"又要求告耶和華的名。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要在他眾民面前，","poem":1},{"lineBreak":true},{"text":"在耶和華殿的院內，","poem":1},{"lineBreak":true},{"text":"在耶路撒冷當中，","poem":1},{"lineBreak":true},{"text":"向耶和華還我的願。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":18}