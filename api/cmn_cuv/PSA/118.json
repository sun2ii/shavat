{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":118,"content":[{"type":"heading","content":["因勝利而稱謝耶和華"]},{"type":"verse","number":1,"content":[{"text":"你們要稱謝耶和華，因他本為善；","poem":1},{"lineBreak":true},{"text":"他的慈愛永遠長存！","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"願以色列說：","poem":1},{"lineBreak":true},{"text":"他的慈愛永遠長存！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"願亞倫的家說：","poem":1},{"lineBreak":true},{"text":"他的慈愛永遠長存！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"願敬畏耶和華的說：","poem":1},{"lineBreak":true},{"text":"他的慈愛永遠長存！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我在急難中求告耶和華，他就應允我，","poem":1},{"lineBreak":true},{"text":"把我安置在寬闊之地。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"有耶和華幫助我，我必不懼怕，","poem":1},{"lineBreak":true},{"text":"人能把我怎麼樣呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"在那幫助我的人中，有耶和華幫助我，","poem":1},{"lineBreak":true},{"text":"所以我要看見那恨我的人遭報。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"投靠耶和華，強似倚賴人；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"投靠耶和華，強似倚賴王子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"萬民圍繞我，","poem":1},{"lineBreak":true},{"text":"我靠耶和華的名必剿滅他們。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們環繞我，圍困我，","poem":1},{"lineBreak":true},{"text":"我靠耶和華的名必剿滅他們。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們如同蜂子圍繞我，","poem":1},{"lineBreak":true},{"text":"好像燒荊棘的火，必被熄滅；","poem":1},{"lineBreak":true},{"text":"我靠耶和華的名，必剿滅他們。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你推我，要叫我跌倒，","poem":1},{"lineBreak":true},{"text":"但耶和華幫助了我。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華是我的力量，是我的詩歌；","poem":1},{"lineBreak":true},{"text":"他也成了我的拯救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"在義人的帳棚裏，有歡呼拯救的聲音；","poem":1},{"lineBreak":true},{"text":"耶和華的右手施展大能。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華的右手高舉；","poem":1},{"lineBreak":true},{"text":"耶和華的右手施展大能。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我必不致死，仍要存活，","poem":1},{"lineBreak":true},{"text":"並要傳揚耶和華的作為。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和華雖嚴嚴地懲治我，","poem":1},{"lineBreak":true},{"text":"卻未曾將我交於死亡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"給我敞開義門；","poem":1},{"lineBreak":true},{"text":"我要進去稱謝耶和華！","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"這是耶和華的門；","poem":1},{"lineBreak":true},{"text":"義人要進去！","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"我要稱謝你，因為你已經應允我，","poem":1},{"lineBreak":true},{"text":"又成了我的拯救！","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"匠人所棄的石頭","poem":1},{"lineBreak":true},{"text":"已成了房角的頭塊石頭。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"這是耶和華所做的，","poem":1},{"lineBreak":true},{"text":"在我們眼中看為希奇。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"這是耶和華所定的日子，","poem":1},{"lineBreak":true},{"text":"我們在其中要高興歡喜！","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"耶和華啊，求你拯救！","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你使我們亨通！","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"奉耶和華名來的是應當稱頌的！","poem":1},{"lineBreak":true},{"text":"我們從耶和華的殿中為你們祝福！","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"耶和華是上帝；","poem":1},{"lineBreak":true},{"text":"他光照了我們。","poem":1},{"lineBreak":true},{"text":"理當用繩索把祭牲拴住，","poem":1},{"lineBreak":true},{"text":"牽到壇角那裏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"你是我的上帝，我要稱謝你！","poem":1},{"lineBreak":true},{"text":"你是我的上帝，我要尊崇你！","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"你們要稱謝耶和華，因他本為善；","poem":1},{"lineBreak":true},{"text":"他的慈愛永遠長存！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}