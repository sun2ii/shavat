{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":119,"content":[{"type":"heading","content":["耶和華的律法"]},{"type":"verse","number":1,"content":[{"text":"行為完全、遵行耶和華律法的，","poem":1},{"lineBreak":true},{"text":"這人便為有福！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"遵守他的法度、一心尋求他的，","poem":1},{"lineBreak":true},{"text":"這人便為有福！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"這人不做非義的事，","poem":1},{"lineBreak":true},{"text":"但遵行他的道。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華啊，你曾將你的訓詞吩咐我們，","poem":1},{"lineBreak":true},{"text":"為要我們殷勤遵守。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但願我行事堅定，","poem":1},{"lineBreak":true},{"text":"得以遵守你的律例。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我看重你的一切命令，","poem":1},{"lineBreak":true},{"text":"就不至於羞愧。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我學了你公義的判語，","poem":1},{"lineBreak":true},{"text":"就要以正直的心稱謝你。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我必守你的律例；","poem":1},{"lineBreak":true},{"text":"求你總不要丟棄我！","poem":1}]},{"type":"heading","content":["順從耶和華的律法"]},{"type":"verse","number":9,"content":[{"text":"少年人用甚麼潔淨他的行為呢？","poem":1},{"lineBreak":true},{"text":"是要遵行你的話！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我一心尋求了你；","poem":1},{"lineBreak":true},{"text":"求你不要叫我偏離你的命令。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我將你的話藏在心裏，","poem":1},{"lineBreak":true},{"text":"免得我得罪你。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和華啊，你是應當稱頌的！","poem":1},{"lineBreak":true},{"text":"求你將你的律例教訓我！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我用嘴唇傳揚你口中的一切典章。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我喜悅你的法度，","poem":1},{"lineBreak":true},{"text":"如同喜悅一切的財物。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要默想你的訓詞，","poem":1},{"lineBreak":true},{"text":"看重你的道路。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要在你的律例中自樂；","poem":1},{"lineBreak":true},{"text":"我不忘記你的話。","poem":1}]},{"type":"heading","content":["因耶和華律法而蒙福"]},{"type":"verse","number":17,"content":[{"text":"求你用厚恩待你的僕人，使我存活，","poem":1},{"lineBreak":true},{"text":"我就遵守你的話。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你開我的眼睛，","poem":1},{"lineBreak":true},{"text":"使我看出你律法中的奇妙。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我是在地上作寄居的；","poem":1},{"lineBreak":true},{"text":"求你不要向我隱瞞你的命令！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"我時常切慕你的典章，","poem":1},{"lineBreak":true},{"text":"甚至心碎。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"受咒詛、偏離你命令的驕傲人，","poem":1},{"lineBreak":true},{"text":"你已經責備他們。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"求你除掉我所受的羞辱和藐視，","poem":1},{"lineBreak":true},{"text":"因我遵守你的法度。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"雖有首領坐着妄論我，","poem":1},{"lineBreak":true},{"text":"你僕人卻思想你的律例。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你的法度是我所喜樂的，","poem":1},{"lineBreak":true},{"text":"是我的謀士。","poem":1}]},{"type":"heading","content":["決定遵行耶和華的律法"]},{"type":"verse","number":25,"content":[{"text":"我的性命幾乎歸於塵土；","poem":1},{"lineBreak":true},{"text":"求你照你的話將我救活！","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我述說我所行的，你應允了我；","poem":1},{"lineBreak":true},{"text":"求你將你的律例教訓我！","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"求你使我明白你的訓詞，","poem":1},{"lineBreak":true},{"text":"我就思想你的奇事。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我的心因愁苦而消化；","poem":1},{"lineBreak":true},{"text":"求你照你的話使我堅立！","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"求你使我離開奸詐的道，","poem":1},{"lineBreak":true},{"text":"開恩將你的律法賜給我！","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"我揀選了忠信的道，","poem":1},{"lineBreak":true},{"text":"將你的典章擺在我面前。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"我持守你的法度；","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你不要叫我羞愧！","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"你開廣我心的時候，","poem":1},{"lineBreak":true},{"text":"我就往你命令的道上直奔。","poem":1}]},{"type":"heading","content":["求主賜悟性"]},{"type":"verse","number":33,"content":[{"text":"耶和華啊，求你將你的律例指教我，","poem":1},{"lineBreak":true},{"text":"我必遵守到底！","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"求你賜我悟性，我便遵守你的律法，","poem":1},{"lineBreak":true},{"text":"且要一心遵守。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"求你叫我遵行你的命令，","poem":1},{"lineBreak":true},{"text":"因為這是我所喜樂的。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"求你使我的心趨向你的法度，","poem":1},{"lineBreak":true},{"text":"不趨向非義之財。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"求你叫我轉眼不看虛假，","poem":1},{"lineBreak":true},{"text":"又叫我在你的道中生活。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"你向敬畏你的人所應許的話，","poem":1},{"lineBreak":true},{"text":"求你向僕人堅定！","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"求你使我所怕的羞辱遠離我，","poem":1},{"lineBreak":true},{"text":"因你的典章本為美。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"我羨慕你的訓詞；","poem":1},{"lineBreak":true},{"text":"求你使我在你的公義上生活！","poem":1}]},{"type":"heading","content":["倚靠耶和華的律法"]},{"type":"verse","number":41,"content":[{"text":"耶和華啊，願你照你的話，使你的慈愛，","poem":1},{"lineBreak":true},{"text":"就是你的救恩，臨到我身上，","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"我就有話回答那羞辱我的，","poem":1},{"lineBreak":true},{"text":"因我倚靠你的話。","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"求你叫真理的話總不離開我口，","poem":1},{"lineBreak":true},{"text":"因我仰望你的典章。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"我要常守你的律法，","poem":1},{"lineBreak":true},{"text":"直到永永遠遠。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"我要自由而行","poem":1},{"noteId":49},{"text":"，","poem":1},{"lineBreak":true},{"text":"因我素來考究你的訓詞。","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"我也要在君王面前論說你的法度，","poem":1},{"lineBreak":true},{"text":"並不至於羞愧。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"我要在你的命令中自樂；","poem":1},{"lineBreak":true},{"text":"這命令素來是我所愛的。","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"我又要遵行","poem":1},{"noteId":50},{"text":"你的命令，","poem":1},{"lineBreak":true},{"text":"這命令素來是我所愛的；","poem":1},{"lineBreak":true},{"text":"我也要思想你的律例。","poem":1}]},{"type":"heading","content":["因耶和華的律法而安穩"]},{"type":"verse","number":49,"content":[{"text":"求你記念向你僕人所應許的話，","poem":1},{"lineBreak":true},{"text":"叫我有盼望。","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"這話將我救活了；","poem":1},{"lineBreak":true},{"text":"我在患難中，因此得安慰。","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"驕傲的人甚侮慢我，","poem":1},{"lineBreak":true},{"text":"我卻未曾偏離你的律法。","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"耶和華啊，我記念你從古以來的典章，","poem":1},{"lineBreak":true},{"text":"就得了安慰。","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"我見惡人離棄你的律法，","poem":1},{"lineBreak":true},{"text":"就怒氣發作，猶如火燒。","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"我在世寄居，","poem":1},{"lineBreak":true},{"text":"素來以你的律例為詩歌。","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"耶和華啊，我夜間記念你的名，","poem":1},{"lineBreak":true},{"text":"遵守你的律法。","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"我所以如此，","poem":1},{"lineBreak":true},{"text":"是因我守你的訓詞。","poem":1}]},{"type":"heading","content":["深愛耶和華的律法"]},{"type":"verse","number":57,"content":[{"text":"耶和華是我的福分；","poem":1},{"lineBreak":true},{"text":"我曾說，我要遵守你的言語。","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"我一心求過你的恩；","poem":1},{"lineBreak":true},{"text":"願你照你的話憐憫我！","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"我思想我所行的道，","poem":1},{"lineBreak":true},{"text":"就轉步歸向你的法度。","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"我急忙遵守你的命令，","poem":1},{"lineBreak":true},{"text":"並不遲延。","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"惡人的繩索纏繞我，","poem":1},{"lineBreak":true},{"text":"我卻沒有忘記你的律法。","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"我因你公義的典章，","poem":1},{"lineBreak":true},{"text":"半夜必起來稱謝你。","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"凡敬畏你、守你訓詞的人，","poem":1},{"lineBreak":true},{"text":"我都與他作伴。","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"耶和華啊，你的慈愛遍滿大地；","poem":1},{"lineBreak":true},{"text":"求你將你的律例教訓我！","poem":1}]},{"type":"heading","content":["耶和華律法的寶貴"]},{"type":"verse","number":65,"content":[{"text":"耶和華啊，你向來是照你的話善待僕人。","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"求你將精明和知識賜給我，","poem":1},{"lineBreak":true},{"text":"因我信了你的命令。","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"我未受苦以先走迷了路，","poem":1},{"lineBreak":true},{"text":"現在卻遵守你的話。","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"你本為善，所行的也善；","poem":1},{"lineBreak":true},{"text":"求你將你的律例教訓我！","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"驕傲人編造謊言攻擊我，","poem":1},{"lineBreak":true},{"text":"我卻要一心守你的訓詞。","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"他們心蒙脂油，","poem":1},{"lineBreak":true},{"text":"我卻喜愛你的律法。","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"我受苦是與我有益，","poem":1},{"lineBreak":true},{"text":"為要使我學習你的律例。","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"你口中的訓言","poem":1},{"noteId":51},{"text":"與我有益，","poem":1},{"lineBreak":true},{"text":"勝於千萬的金銀。","poem":1}]},{"type":"heading","content":["耶和華律法的公正"]},{"type":"verse","number":73,"content":[{"text":"你的手製造我，建立我；","poem":1},{"lineBreak":true},{"text":"求你賜我悟性，可以學習你的命令！","poem":1}]},{"type":"verse","number":74,"content":[{"lineBreak":true},{"text":"敬畏你的人見我就要歡喜，","poem":1},{"lineBreak":true},{"text":"因我仰望你的話。","poem":1}]},{"type":"verse","number":75,"content":[{"lineBreak":true},{"text":"耶和華啊，我知道你的判語是公義的；","poem":1},{"lineBreak":true},{"text":"你使我受苦是以誠實待我。","poem":1}]},{"type":"verse","number":76,"content":[{"lineBreak":true},{"text":"求你照着應許僕人的話，","poem":1},{"lineBreak":true},{"text":"以慈愛安慰我。","poem":1}]},{"type":"verse","number":77,"content":[{"lineBreak":true},{"text":"願你的慈悲臨到我，使我存活，","poem":1},{"lineBreak":true},{"text":"因你的律法是我所喜愛的。","poem":1}]},{"type":"verse","number":78,"content":[{"lineBreak":true},{"text":"願驕傲人蒙羞，因為他們無理地傾覆我；","poem":1},{"lineBreak":true},{"text":"但我要思想你的訓詞。","poem":1}]},{"type":"verse","number":79,"content":[{"lineBreak":true},{"text":"願敬畏你的人歸向我，","poem":1},{"lineBreak":true},{"text":"他們就知道你的法度。","poem":1}]},{"type":"verse","number":80,"content":[{"lineBreak":true},{"text":"願我的心在你的律例上完全，","poem":1},{"lineBreak":true},{"text":"使我不致蒙羞。","poem":1}]},{"type":"heading","content":["求主解救"]},{"type":"verse","number":81,"content":[{"text":"我心渴想你的救恩，","poem":1},{"lineBreak":true},{"text":"仰望你的應許。","poem":1}]},{"type":"verse","number":82,"content":[{"lineBreak":true},{"text":"我因盼望你的應許眼睛失明，說：","poem":1},{"lineBreak":true},{"text":"你何時安慰我？","poem":1}]},{"type":"verse","number":83,"content":[{"lineBreak":true},{"text":"我好像煙薰的皮袋，","poem":1},{"lineBreak":true},{"text":"卻不忘記你的律例。","poem":1}]},{"type":"verse","number":84,"content":[{"lineBreak":true},{"text":"你僕人的年日有多少呢？","poem":1},{"lineBreak":true},{"text":"你幾時向逼迫我的人施行審判呢？","poem":1}]},{"type":"verse","number":85,"content":[{"lineBreak":true},{"text":"不從你律法的驕傲人為我掘了坑。","poem":1}]},{"type":"verse","number":86,"content":[{"lineBreak":true},{"text":"你的命令盡都誠實；","poem":1},{"lineBreak":true},{"text":"他們無理地逼迫我，求你幫助我！","poem":1}]},{"type":"verse","number":87,"content":[{"lineBreak":true},{"text":"他們幾乎把我從世上滅絕，","poem":1},{"lineBreak":true},{"text":"但我沒有離棄你的訓詞。","poem":1}]},{"type":"verse","number":88,"content":[{"lineBreak":true},{"text":"求你照你的慈愛將我救活，","poem":1},{"lineBreak":true},{"text":"我就遵守你口中的法度。","poem":1}]},{"type":"heading","content":["信賴耶和華的律法"]},{"type":"verse","number":89,"content":[{"text":"耶和華啊，你的話安定在天，","poem":1},{"lineBreak":true},{"text":"直到永遠。","poem":1}]},{"type":"verse","number":90,"content":[{"lineBreak":true},{"text":"你的誠實存到萬代；","poem":1},{"lineBreak":true},{"text":"你堅定了地，地就長存。","poem":1}]},{"type":"verse","number":91,"content":[{"lineBreak":true},{"text":"天地照你的安排存到今日；","poem":1},{"lineBreak":true},{"text":"萬物都是你的僕役。","poem":1}]},{"type":"verse","number":92,"content":[{"lineBreak":true},{"text":"我若不是喜愛你的律法，","poem":1},{"lineBreak":true},{"text":"早就在苦難中滅絕了！","poem":1}]},{"type":"verse","number":93,"content":[{"lineBreak":true},{"text":"我永不忘記你的訓詞，","poem":1},{"lineBreak":true},{"text":"因你用這訓詞將我救活了。","poem":1}]},{"type":"verse","number":94,"content":[{"lineBreak":true},{"text":"我是屬你的，求你救我，","poem":1},{"lineBreak":true},{"text":"因我尋求了你的訓詞。","poem":1}]},{"type":"verse","number":95,"content":[{"lineBreak":true},{"text":"惡人等待我，要滅絕我，","poem":1},{"lineBreak":true},{"text":"我卻要揣摩你的法度。","poem":1}]},{"type":"verse","number":96,"content":[{"lineBreak":true},{"text":"我看萬事盡都有限，","poem":1},{"lineBreak":true},{"text":"惟有你的命令極其寬廣。","poem":1}]},{"type":"heading","content":["喜愛耶和華的律法"]},{"type":"verse","number":97,"content":[{"text":"我何等愛慕你的律法，","poem":1},{"lineBreak":true},{"text":"終日不住地思想。","poem":1}]},{"type":"verse","number":98,"content":[{"lineBreak":true},{"text":"你的命令常存在我心裏，","poem":1},{"lineBreak":true},{"text":"使我比仇敵有智慧。","poem":1}]},{"type":"verse","number":99,"content":[{"lineBreak":true},{"text":"我比我的師傅更通達，","poem":1},{"lineBreak":true},{"text":"因我思想你的法度。","poem":1}]},{"type":"verse","number":100,"content":[{"lineBreak":true},{"text":"我比年老的更明白，","poem":1},{"lineBreak":true},{"text":"因我守了你的訓詞。","poem":1}]},{"type":"verse","number":101,"content":[{"lineBreak":true},{"text":"我禁止我腳走一切的邪路，","poem":1},{"lineBreak":true},{"text":"為要遵守你的話。","poem":1}]},{"type":"verse","number":102,"content":[{"lineBreak":true},{"text":"我沒有偏離你的典章，","poem":1},{"lineBreak":true},{"text":"因為你教訓了我。","poem":1}]},{"type":"verse","number":103,"content":[{"lineBreak":true},{"text":"你的言語在我上膛何等甘美，","poem":1},{"lineBreak":true},{"text":"在我口中比蜜更甜！","poem":1}]},{"type":"verse","number":104,"content":[{"lineBreak":true},{"text":"我藉着你的訓詞得以明白，","poem":1},{"lineBreak":true},{"text":"所以我恨一切的假道。","poem":1}]},{"type":"heading","content":["耶和華律法的亮光"]},{"type":"verse","number":105,"content":[{"text":"你的話是我腳前的燈，","poem":1},{"lineBreak":true},{"text":"是我路上的光。","poem":1}]},{"type":"verse","number":106,"content":[{"lineBreak":true},{"text":"你公義的典章，我曾起誓遵守，","poem":1},{"lineBreak":true},{"text":"我必按誓而行。","poem":1}]},{"type":"verse","number":107,"content":[{"lineBreak":true},{"text":"我甚是受苦；","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你照你的話將我救活！","poem":1}]},{"type":"verse","number":108,"content":[{"lineBreak":true},{"text":"耶和華啊，求你悅納我口中的讚美為供物，","poem":1},{"lineBreak":true},{"text":"又將你的典章教訓我！","poem":1}]},{"type":"verse","number":109,"content":[{"lineBreak":true},{"text":"我的性命常在危險之中，","poem":1},{"lineBreak":true},{"text":"我卻不忘記你的律法。","poem":1}]},{"type":"verse","number":110,"content":[{"lineBreak":true},{"text":"惡人為我設下網羅，","poem":1},{"lineBreak":true},{"text":"我卻沒有偏離你的訓詞。","poem":1}]},{"type":"verse","number":111,"content":[{"lineBreak":true},{"text":"我以你的法度為永遠的產業，","poem":1},{"lineBreak":true},{"text":"因這是我心中所喜愛的。","poem":1}]},{"type":"verse","number":112,"content":[{"lineBreak":true},{"text":"我的心專向你的律例，","poem":1},{"lineBreak":true},{"text":"永遠遵行，一直到底。","poem":1}]},{"type":"heading","content":["因耶和華律法得安全"]},{"type":"verse","number":113,"content":[{"text":"心懷二意的人為我所恨；","poem":1},{"lineBreak":true},{"text":"但你的律法為我所愛。","poem":1}]},{"type":"verse","number":114,"content":[{"lineBreak":true},{"text":"你是我藏身之處，又是我的盾牌；","poem":1},{"lineBreak":true},{"text":"我甚仰望你的話語。","poem":1}]},{"type":"verse","number":115,"content":[{"lineBreak":true},{"text":"作惡的人哪，你們離開我吧！","poem":1},{"lineBreak":true},{"text":"我好遵守我上帝的命令。","poem":1}]},{"type":"verse","number":116,"content":[{"lineBreak":true},{"text":"求你照你的話扶持我，使我存活，","poem":1},{"lineBreak":true},{"text":"也不叫我因失望而害羞。","poem":1}]},{"type":"verse","number":117,"content":[{"lineBreak":true},{"text":"求你扶持我，我便得救，","poem":1},{"lineBreak":true},{"text":"時常看重你的律例。","poem":1}]},{"type":"verse","number":118,"content":[{"lineBreak":true},{"text":"凡偏離你律例的人，你都輕棄他們，","poem":1},{"lineBreak":true},{"text":"因為他們的詭詐必歸虛空。","poem":1}]},{"type":"verse","number":119,"content":[{"lineBreak":true},{"text":"凡地上的惡人，你除掉他，好像除掉渣滓；","poem":1},{"lineBreak":true},{"text":"因此我愛你的法度。","poem":1}]},{"type":"verse","number":120,"content":[{"lineBreak":true},{"text":"我因懼怕你，肉就發抖；","poem":1},{"lineBreak":true},{"text":"我也怕你的判語。","poem":1}]},{"type":"heading","content":["遵從耶和華的律法"]},{"type":"verse","number":121,"content":[{"text":"我行過公平和公義，","poem":1},{"lineBreak":true},{"text":"求你不要撇下我給欺壓我的人！","poem":1}]},{"type":"verse","number":122,"content":[{"lineBreak":true},{"text":"求你為僕人作保，使我得好處，","poem":1},{"lineBreak":true},{"text":"不容驕傲人欺壓我！","poem":1}]},{"type":"verse","number":123,"content":[{"lineBreak":true},{"text":"我因盼望你的救恩","poem":1},{"lineBreak":true},{"text":"和你公義的話眼睛失明。","poem":1}]},{"type":"verse","number":124,"content":[{"lineBreak":true},{"text":"求你照你的慈愛待僕人，","poem":1},{"lineBreak":true},{"text":"將你的律例教訓我。","poem":1}]},{"type":"verse","number":125,"content":[{"lineBreak":true},{"text":"我是你的僕人，求你賜我悟性，","poem":1},{"lineBreak":true},{"text":"使我得知你的法度。","poem":1}]},{"type":"verse","number":126,"content":[{"lineBreak":true},{"text":"這是耶和華降罰的時候，","poem":1},{"lineBreak":true},{"text":"因人廢了你的律法。","poem":1}]},{"type":"verse","number":127,"content":[{"lineBreak":true},{"text":"所以，我愛你的命令勝於金子，","poem":1},{"lineBreak":true},{"text":"更勝於精金。","poem":1}]},{"type":"verse","number":128,"content":[{"lineBreak":true},{"text":"你一切的訓詞，在萬事上我都以為正直；","poem":1},{"lineBreak":true},{"text":"我卻恨惡一切假道。","poem":1}]},{"type":"heading","content":["渴慕遵行耶和華的律法"]},{"type":"verse","number":129,"content":[{"text":"你的法度奇妙，","poem":1},{"lineBreak":true},{"text":"所以我一心謹守。","poem":1}]},{"type":"verse","number":130,"content":[{"lineBreak":true},{"text":"你的言語一解開就發出亮光，","poem":1},{"lineBreak":true},{"text":"使愚人通達。","poem":1}]},{"type":"verse","number":131,"content":[{"lineBreak":true},{"text":"我張口而氣喘，","poem":1},{"lineBreak":true},{"text":"因我切慕你的命令。","poem":1}]},{"type":"verse","number":132,"content":[{"lineBreak":true},{"text":"求你轉向我，憐憫我，","poem":1},{"lineBreak":true},{"text":"好像你素常待那些愛你名的人。","poem":1}]},{"type":"verse","number":133,"content":[{"lineBreak":true},{"text":"求你用你的話使我腳步穩當，","poem":1},{"lineBreak":true},{"text":"不許甚麼罪孽轄制我。","poem":1}]},{"type":"verse","number":134,"content":[{"lineBreak":true},{"text":"求你救我脫離人的欺壓，","poem":1},{"lineBreak":true},{"text":"我要遵守你的訓詞。","poem":1}]},{"type":"verse","number":135,"content":[{"lineBreak":true},{"text":"求你用臉光照僕人，","poem":1},{"lineBreak":true},{"text":"又將你的律例教訓我。","poem":1}]},{"type":"verse","number":136,"content":[{"lineBreak":true},{"text":"我的眼淚下流成河，","poem":1},{"lineBreak":true},{"text":"因為他們不守你的律法。","poem":1}]},{"type":"heading","content":["耶和華律法的公正"]},{"type":"verse","number":137,"content":[{"text":"耶和華啊，你是公義的；","poem":1},{"lineBreak":true},{"text":"你的判語也是正直的！","poem":1}]},{"type":"verse","number":138,"content":[{"lineBreak":true},{"text":"你所命定的法度是憑公義和至誠。","poem":1}]},{"type":"verse","number":139,"content":[{"lineBreak":true},{"text":"我心焦急，如同火燒，","poem":1},{"lineBreak":true},{"text":"因我敵人忘記你的言語。","poem":1}]},{"type":"verse","number":140,"content":[{"lineBreak":true},{"text":"你的話極其精煉，","poem":1},{"lineBreak":true},{"text":"所以你的僕人喜愛。","poem":1}]},{"type":"verse","number":141,"content":[{"lineBreak":true},{"text":"我微小，被人藐視，","poem":1},{"lineBreak":true},{"text":"卻不忘記你的訓詞。","poem":1}]},{"type":"verse","number":142,"content":[{"lineBreak":true},{"text":"你的公義永遠長存；","poem":1},{"lineBreak":true},{"text":"你的律法盡都真實。","poem":1}]},{"type":"verse","number":143,"content":[{"lineBreak":true},{"text":"我遭遇患難愁苦，","poem":1},{"lineBreak":true},{"text":"你的命令卻是我所喜愛的。","poem":1}]},{"type":"verse","number":144,"content":[{"lineBreak":true},{"text":"你的法度永遠是公義的；","poem":1},{"lineBreak":true},{"text":"求你賜我悟性，我就活了。","poem":1}]},{"type":"heading","content":["求主解救"]},{"type":"verse","number":145,"content":[{"text":"耶和華啊，我一心呼籲你；","poem":1},{"lineBreak":true},{"text":"求你應允我，我必謹守你的律例！","poem":1}]},{"type":"verse","number":146,"content":[{"lineBreak":true},{"text":"我向你呼籲，求你救我！","poem":1},{"lineBreak":true},{"text":"我要遵守你的法度。","poem":1}]},{"type":"verse","number":147,"content":[{"lineBreak":true},{"text":"我趁天未亮呼求；","poem":1},{"lineBreak":true},{"text":"我仰望了你的言語。","poem":1}]},{"type":"verse","number":148,"content":[{"lineBreak":true},{"text":"我趁夜更未換將眼睜開，","poem":1},{"lineBreak":true},{"text":"為要思想你的話語。","poem":1}]},{"type":"verse","number":149,"content":[{"lineBreak":true},{"text":"求你照你的慈愛聽我的聲音；","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你照你的典章將我救活！","poem":1}]},{"type":"verse","number":150,"content":[{"lineBreak":true},{"text":"追求奸惡的人臨近了；","poem":1},{"lineBreak":true},{"text":"他們遠離你的律法。","poem":1}]},{"type":"verse","number":151,"content":[{"lineBreak":true},{"text":"耶和華啊，你與我相近；","poem":1},{"lineBreak":true},{"text":"你一切的命令盡都真實！","poem":1}]},{"type":"verse","number":152,"content":[{"lineBreak":true},{"text":"我因學你的法度，","poem":1},{"lineBreak":true},{"text":"久已知道是你永遠立定的。","poem":1}]},{"type":"heading","content":["請求恩助"]},{"type":"verse","number":153,"content":[{"text":"求你看顧我的苦難，搭救我，","poem":1},{"lineBreak":true},{"text":"因我不忘記你的律法。","poem":1}]},{"type":"verse","number":154,"content":[{"lineBreak":true},{"text":"求你為我辨屈，救贖我，","poem":1},{"lineBreak":true},{"text":"照你的話將我救活。","poem":1}]},{"type":"verse","number":155,"content":[{"lineBreak":true},{"text":"救恩遠離惡人，","poem":1},{"lineBreak":true},{"text":"因為他們不尋求你的律例。","poem":1}]},{"type":"verse","number":156,"content":[{"lineBreak":true},{"text":"耶和華啊，你的慈悲本為大；","poem":1},{"lineBreak":true},{"text":"求你照你的典章將我救活。","poem":1}]},{"type":"verse","number":157,"content":[{"lineBreak":true},{"text":"逼迫我的，抵擋我的，很多，","poem":1},{"lineBreak":true},{"text":"我卻沒有偏離你的法度。","poem":1}]},{"type":"verse","number":158,"content":[{"lineBreak":true},{"text":"我看見奸惡的人就甚憎惡，","poem":1},{"lineBreak":true},{"text":"因為他們不遵守你的話。","poem":1}]},{"type":"verse","number":159,"content":[{"lineBreak":true},{"text":"你看我怎樣愛你的訓詞！","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你照你的慈愛將我救活！","poem":1}]},{"type":"verse","number":160,"content":[{"lineBreak":true},{"text":"你話的總綱是真實；","poem":1},{"lineBreak":true},{"text":"你一切公義的典章是永遠長存。","poem":1}]},{"type":"heading","content":["熱愛耶和華的律法"]},{"type":"verse","number":161,"content":[{"text":"首領無故地逼迫我，","poem":1},{"lineBreak":true},{"text":"但我的心畏懼你的言語。","poem":1}]},{"type":"verse","number":162,"content":[{"lineBreak":true},{"text":"我喜愛你的話，","poem":1},{"lineBreak":true},{"text":"好像人得了許多擄物。","poem":1}]},{"type":"verse","number":163,"content":[{"lineBreak":true},{"text":"謊話是我所恨惡所憎嫌的；","poem":1},{"lineBreak":true},{"text":"惟你的律法是我所愛的。","poem":1}]},{"type":"verse","number":164,"content":[{"lineBreak":true},{"text":"我因你公義的典章一天七次讚美你。","poem":1}]},{"type":"verse","number":165,"content":[{"lineBreak":true},{"text":"愛你律法的人有大平安，","poem":1},{"lineBreak":true},{"text":"甚麼都不能使他們絆腳。","poem":1}]},{"type":"verse","number":166,"content":[{"lineBreak":true},{"text":"耶和華啊，我仰望了你的救恩，","poem":1},{"lineBreak":true},{"text":"遵行了你的命令。","poem":1}]},{"type":"verse","number":167,"content":[{"lineBreak":true},{"text":"我心裏守了你的法度；","poem":1},{"lineBreak":true},{"text":"這法度我甚喜愛。","poem":1}]},{"type":"verse","number":168,"content":[{"lineBreak":true},{"text":"我遵守了你的訓詞和法度，","poem":1},{"lineBreak":true},{"text":"因我一切所行的都在你面前。","poem":1}]},{"type":"heading","content":["求主幫助"]},{"type":"verse","number":169,"content":[{"text":"耶和華啊，願我的呼籲達到你面前，","poem":1},{"lineBreak":true},{"text":"照你的話賜我悟性。","poem":1}]},{"type":"verse","number":170,"content":[{"lineBreak":true},{"text":"願我的懇求達到你面前，","poem":1},{"lineBreak":true},{"text":"照你的話搭救我。","poem":1}]},{"type":"verse","number":171,"content":[{"lineBreak":true},{"text":"願我的嘴發出讚美的話，","poem":1},{"lineBreak":true},{"text":"因為你將律例教訓我。","poem":1}]},{"type":"verse","number":172,"content":[{"lineBreak":true},{"text":"願我的舌頭歌唱你的話，","poem":1},{"lineBreak":true},{"text":"因你一切的命令盡都公義。","poem":1}]},{"type":"verse","number":173,"content":[{"lineBreak":true},{"text":"願你用手幫助我，","poem":1},{"lineBreak":true},{"text":"因我揀選了你的訓詞。","poem":1}]},{"type":"verse","number":174,"content":[{"lineBreak":true},{"text":"耶和華啊，我切慕你的救恩！","poem":1},{"lineBreak":true},{"text":"你的律法也是我所喜愛的。","poem":1}]},{"type":"verse","number":175,"content":[{"lineBreak":true},{"text":"願我的性命存活，得以讚美你！","poem":1},{"lineBreak":true},{"text":"願你的典章幫助我！","poem":1}]},{"type":"verse","number":176,"content":[{"lineBreak":true},{"text":"我如亡羊走迷了路，求你尋找僕人，","poem":1},{"lineBreak":true},{"text":"因我不忘記你的命令。","poem":1}]}],"footnotes":[{"noteId":49,"caller":"-","text":"或譯：我要行在寬闊之地","reference":{"chapter":119,"verse":45}},{"noteId":50,"caller":"-","text":"原文是舉手","reference":{"chapter":119,"verse":48}},{"noteId":51,"caller":"-","text":"或譯：律法","reference":{"chapter":119,"verse":72}}]},"thisChapterLink":"/api/cmn_cuv/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}