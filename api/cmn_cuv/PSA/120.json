{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":120,"content":[{"type":"heading","content":["求主恩助"]},{"type":"hebrew_subtitle","content":["上行（或譯登階，下同）之詩。"]},{"type":"verse","number":1,"content":[{"text":"我在急難中求告耶和華，","poem":1},{"lineBreak":true},{"text":"他就應允我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華啊，求你救我脫離說謊的嘴唇和詭詐的舌頭！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"詭詐的舌頭啊，要給你甚麼呢？","poem":1},{"lineBreak":true},{"text":"要拿甚麼加給你呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"就是勇士的利箭和羅騰木","poem":1},{"noteId":52},{"text":"的炭火。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我寄居在米設，","poem":1},{"lineBreak":true},{"text":"住在基達帳棚之中，有禍了！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我與那恨惡和睦的人許久同住。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我願和睦，","poem":1},{"lineBreak":true},{"text":"但我發言，他們就要爭戰。","poem":1}]}],"footnotes":[{"noteId":52,"caller":"-","text":"小樹名，松類","reference":{"chapter":120,"verse":4}}]},"thisChapterLink":"/api/cmn_cuv/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}