"lineBreak":true},{"text":"他要保護你的性命。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你出你入，耶和華要保護你，","poem":1},{"lineBreak":true},{"text":"從今時直到永遠。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}