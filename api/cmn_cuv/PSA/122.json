{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":122,"content":[{"type":"heading","content":["耶路撒冷頌"]},{"type":"hebrew_subtitle","content":["大衛上行之詩。"]},{"type":"verse","number":1,"content":[{"text":"人對我說：我們往耶和華的殿去，","poem":1},{"lineBreak":true},{"text":"我就歡喜。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，","poem":1},{"lineBreak":true},{"text":"我們的腳站在你的門內。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶路撒冷被建造，","poem":1},{"lineBreak":true},{"text":"如同連絡整齊的一座城。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"眾支派，就是耶和華的支派，上那裏去，","poem":1},{"lineBreak":true},{"text":"按以色列的常例","poem":1},{"noteId":53},{"text":"稱讚耶和華的名。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因為在那裏設立審判的寶座，","poem":1},{"lineBreak":true},{"text":"就是大衛家的寶座。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"你們要為耶路撒冷求平安！","poem":1},{"lineBreak":true},{"text":"耶路撒冷啊，愛你的人必然興旺！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"願你城中平安！","poem":1},{"lineBreak":true},{"text":"願你宮內興旺！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"因我弟兄和同伴的緣故，我要說：","poem":1},{"lineBreak":true},{"text":"願平安在你中間！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因耶和華－我們上帝殿的緣故，","poem":1},{"lineBreak":true},{"text":"我要為你求福！","poem":1}]}],"footnotes":[{"noteId":53,"caller":"-","text":"或譯：作以色列的證據","reference":{"chapter":122,"verse":4}}]},"thisChapterLink":"/api/cmn_cuv/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}