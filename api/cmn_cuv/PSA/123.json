{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":123,"content":[{"type":"heading","content":["求主憐憫"]},{"type":"hebrew_subtitle","content":["上行之詩。"]},{"type":"verse","number":1,"content":[{"text":"坐在天上的主啊，","poem":1},{"lineBreak":true},{"text":"我向你舉目。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"看哪，僕人的眼睛怎樣望主人的手，","poem":1},{"lineBreak":true},{"text":"使女的眼睛怎樣望主母的手，","poem":1},{"lineBreak":true},{"text":"我們的眼睛也照樣望耶和華－我們的上帝，","poem":1},{"lineBreak":true},{"text":"直到他憐憫我們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和華啊，求你憐憫我們，憐憫我們！","poem":1},{"lineBreak":true},{"text":"因為我們被藐視，已到極處。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我們被那些安逸人的譏誚","poem":1},{"lineBreak":true},{"text":"和驕傲人的藐視，已到極處。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}