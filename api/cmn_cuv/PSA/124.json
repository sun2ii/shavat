{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":124,"content":[{"type":"heading","content":["上帝是他子民的保護者"]},{"type":"hebrew_subtitle","content":["大衛上行之詩。"]},{"type":"verse","number":1,"content":[{"text":"以色列人要說：","poem":1},{"lineBreak":true},{"text":"若不是耶和華幫助我們，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"若不是耶和華幫助我們，","poem":1},{"lineBreak":true},{"text":"當人起來攻擊我們、","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"向我們發怒的時候，","poem":1},{"lineBreak":true},{"text":"就把我們活活地吞了。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"那時，波濤必漫過我們，","poem":1},{"lineBreak":true},{"text":"河水必淹沒我們，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"狂傲的水必淹沒我們。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華是應當稱頌的！","poem":1},{"lineBreak":true},{"text":"他沒有把我們當野食交給他們吞吃","poem":1},{"noteId":54},{"text":"。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我們好像雀鳥，從捕鳥人的網羅裏逃脫；","poem":1},{"lineBreak":true},{"text":"網羅破裂，我們逃脫了。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我們得幫助，","poem":1},{"lineBreak":true},{"text":"是在乎倚靠造天地之耶和華的名。","poem":1}]}],"footnotes":[{"noteId":54,"caller":"-","text":"原文是牙齒","reference":{"chapter":124,"verse":6}}]},"thisChapterLink":"/api/cmn_cuv/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}