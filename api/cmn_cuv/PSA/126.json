{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":126,"content":[{"type":"heading","content":["被擄歸回者的歡樂"]},{"type":"hebrew_subtitle","content":["上行之詩。"]},{"type":"verse","number":1,"content":[{"text":"當耶和華將那些被擄的帶回錫安的時候，","poem":1},{"lineBreak":true},{"text":"我們好像做夢的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我們滿口喜笑、","poem":1},{"lineBreak":true},{"text":"滿舌歡呼的時候，","poem":1},{"lineBreak":true},{"text":"外邦中就有人說：","poem":1},{"lineBreak":true},{"text":"耶和華為他們行了大事！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華果然為我們行了大事，","poem":1},{"lineBreak":true},{"text":"我們就歡喜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華啊，求你使我們被擄的人歸回，","poem":1},{"lineBreak":true},{"text":"好像南地的河水復流。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"流淚撒種的，","poem":1},{"lineBreak":true},{"text":"必歡呼收割！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"那帶種流淚出去的，","poem":1},{"lineBreak":true},{"text":"必要歡歡樂樂地帶禾捆回來！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}