{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":127,"content":[{"type":"heading","content":["稱頌上帝的良善"]},{"type":"hebrew_subtitle","content":["所羅門上行之詩。"]},{"type":"verse","number":1,"content":[{"text":"若不是耶和華建造房屋，","poem":1},{"lineBreak":true},{"text":"建造的人就枉然勞力；","poem":1},{"lineBreak":true},{"text":"若不是耶和華看守城池，","poem":1},{"lineBreak":true},{"text":"看守的人就枉然警醒。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們清晨早起，夜晚安歇，","poem":1},{"lineBreak":true},{"text":"吃勞碌得來的飯，本是枉然；","poem":1},{"lineBreak":true},{"text":"惟有耶和華所親愛的，必叫他安然睡覺。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"兒女是耶和華所賜的產業；","poem":1},{"lineBreak":true},{"text":"所懷的胎是他所給的賞賜。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"少年時所生的兒女","poem":1},{"lineBreak":true},{"text":"好像勇士手中的箭。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"箭袋充滿的人便為有福；","poem":1},{"lineBreak":true},{"text":"他們在城門口和仇敵說話的時候，","poem":1},{"lineBreak":true},{"text":"必不至於羞愧。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}