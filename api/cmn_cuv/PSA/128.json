{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":128,"content":[{"type":"heading","content":["順從耶和華的賞報"]},{"type":"hebrew_subtitle","content":["上行之詩。"]},{"type":"verse","number":1,"content":[{"text":"凡敬畏耶和華、","poem":1},{"lineBreak":true},{"text":"遵行他道的人便為有福！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你要吃勞碌得來的；","poem":1},{"lineBreak":true},{"text":"你要享福，事情順利。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你妻子在你的內室，好像多結果子的葡萄樹；","poem":1},{"lineBreak":true},{"text":"你兒女圍繞你的桌子，好像橄欖栽子。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"看哪，敬畏耶和華的人必要這樣蒙福！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"願耶和華從錫安賜福給你！","poem":1},{"lineBreak":true},{"text":"願你一生一世看見耶路撒冷的好處！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"願你看見你兒女的兒女！","poem":1},{"lineBreak":true},{"text":"願平安歸於以色列！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}