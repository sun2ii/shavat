{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":129,"content":[{"type":"heading","content":["求耶和華退敵"]},{"type":"hebrew_subtitle","content":["上行之詩。"]},{"type":"verse","number":1,"content":[{"text":"以色列當說：從我幼年以來，","poem":1},{"lineBreak":true},{"text":"敵人屢次苦害我，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"從我幼年以來，敵人屢次苦害我，","poem":1},{"lineBreak":true},{"text":"卻沒有勝了我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"如同扶犂的在我背上扶犂而耕，","poem":1},{"lineBreak":true},{"text":"耕的犂溝甚長。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華是公義的；","poem":1},{"lineBreak":true},{"text":"他砍斷了惡人的繩索。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"願恨惡錫安的都蒙羞退後！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"願他們像房頂上的草，","poem":1},{"lineBreak":true},{"text":"未長成而枯乾，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"收割的不夠一把，","poem":1},{"lineBreak":true},{"text":"捆禾的也不滿懷。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"過路的也不說：","poem":1},{"lineBreak":true},{"text":"願耶和華所賜的福歸與你們！","poem":1},{"lineBreak":true},{"text":"我們奉耶和華的名給你們祝福！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}