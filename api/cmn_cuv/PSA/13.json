{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":13,"content":[{"type":"heading","content":["求耶和華看顧"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，你忘記我要到幾時呢？要到永遠嗎？","poem":1},{"lineBreak":true},{"text":"你掩面不顧我要到幾時呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我心裏籌算，終日愁苦，要到幾時呢？","poem":1},{"lineBreak":true},{"text":"我的仇敵升高壓制我，要到幾時呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和華－我的上帝啊，求你看顧我，應允我！","poem":1},{"lineBreak":true},{"text":"使我眼目光明，免得我沉睡至死；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"免得我的仇敵說：我勝了他；","poem":1},{"lineBreak":true},{"text":"免得我的敵人在我搖動的時候喜樂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"但我倚靠你的慈愛；","poem":1},{"lineBreak":true},{"text":"我的心因你的救恩快樂。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我要向耶和華歌唱，","poem":1},{"lineBreak":true},{"text":"因他用厚恩待我。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}