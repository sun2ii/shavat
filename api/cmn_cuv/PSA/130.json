{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":130,"content":[{"type":"heading","content":["求助的祈禱"]},{"type":"hebrew_subtitle","content":["上行之詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我從深處向你求告！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"主啊，求你聽我的聲音！","poem":1},{"lineBreak":true},{"text":"願你側耳聽我懇求的聲音！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"主－耶和華啊，你若究察罪孽，","poem":1},{"lineBreak":true},{"text":"誰能站得住呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"但在你有赦免之恩，","poem":1},{"lineBreak":true},{"text":"要叫人敬畏你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我等候耶和華，我的心等候；","poem":1},{"lineBreak":true},{"text":"我也仰望他的話。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我的心等候主，","poem":1},{"lineBreak":true},{"text":"勝於守夜的，等候天亮，","poem":1},{"lineBreak":true},{"text":"勝於守夜的，等候天亮。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"以色列啊，你當仰望耶和華！","poem":1},{"lineBreak":true},{"text":"因他有慈愛，有豐盛的救恩。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他必救贖以色列脫離一切的罪孽。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}