{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":132,"content":[{"type":"heading","content":["聖殿頌"]},{"type":"hebrew_subtitle","content":["上行之詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你記念大衛所受的一切苦難！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他怎樣向耶和華起誓，","poem":1},{"lineBreak":true},{"text":"向雅各的大能者許願，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"說：我必不進我的帳幕，","poem":1},{"lineBreak":true},{"text":"也不上我的床榻；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我不容我的眼睛睡覺，","poem":1},{"lineBreak":true},{"text":"也不容我的眼目打盹；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"直等我為耶和華尋得所在，","poem":1},{"lineBreak":true},{"text":"為雅各的大能者尋得居所。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我們聽說約櫃在以法他，","poem":1},{"lineBreak":true},{"text":"我們在基列‧耶琳就尋見了。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我們要進他的居所，","poem":1},{"lineBreak":true},{"text":"在他腳凳前下拜。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和華啊，求你興起，","poem":1},{"lineBreak":true},{"text":"和你有能力的約櫃同入安息之所！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"願你的祭司披上公義！","poem":1},{"lineBreak":true},{"text":"願你的聖民歡呼！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"求你因你僕人大衛的緣故，","poem":1},{"lineBreak":true},{"text":"不要厭棄你的受膏者！","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和華向大衛、憑誠實起了誓，","poem":1},{"lineBreak":true},{"text":"必不反覆，說：","poem":1},{"lineBreak":true},{"text":"我要使你所生的","poem":1},{"lineBreak":true},{"text":"坐在你的寶座上。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你的眾子若守我的約","poem":1},{"lineBreak":true},{"text":"和我所教訓他們的法度，","poem":1},{"lineBreak":true},{"text":"他們的子孫必永遠坐在你的寶座上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"因為耶和華揀選了錫安，","poem":1},{"lineBreak":true},{"text":"願意當作自己的居所，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"說：這是我永遠安息之所；","poem":1},{"lineBreak":true},{"text":"我要住在這裏，","poem":1},{"lineBreak":true},{"text":"因為是我所願意的。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要使其中的糧食豐滿，","poem":1},{"lineBreak":true},{"text":"使其中的窮人飽足。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要使祭司披上救恩，","poem":1},{"lineBreak":true},{"text":"聖民大聲歡呼！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我要叫大衛的角在那裏發生；","poem":1},{"lineBreak":true},{"text":"我為我的受膏者預備明燈。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要使他的仇敵披上羞恥；","poem":1},{"lineBreak":true},{"text":"但他的冠冕要在頭上發光。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}