{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":135,"content":[{"type":"heading","content":["稱頌的聖詩"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華的名！","poem":1},{"lineBreak":true},{"text":"耶和華的僕人站在耶和華殿中；","poem":1},{"lineBreak":true},{"text":"站在我們上帝殿院中的，你們要讚美他！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"耶和華本為善；","poem":1},{"lineBreak":true},{"text":"要歌頌他的名，","poem":1},{"lineBreak":true},{"text":"因為這是美好的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華揀選雅各歸自己，","poem":1},{"lineBreak":true},{"text":"揀選以色列特作自己的子民。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"原來我知道耶和華為大，","poem":1},{"lineBreak":true},{"text":"也知道我們的主超乎萬神之上。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華在天上，在地下，","poem":1},{"lineBreak":true},{"text":"在海中，在一切的深處，","poem":1},{"lineBreak":true},{"text":"都隨自己的意旨而行。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他使雲霧從地極上騰，","poem":1},{"lineBreak":true},{"text":"造電隨雨而閃，","poem":1},{"lineBreak":true},{"text":"從府庫中帶出風來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"他將埃及頭生的，","poem":1},{"lineBreak":true},{"text":"連人帶牲畜都擊殺了。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"埃及啊，他施行神蹟奇事，","poem":1},{"lineBreak":true},{"text":"在你當中，在法老和他一切臣僕身上。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他擊殺許多的民，","poem":1},{"lineBreak":true},{"text":"又殺戮大能的王，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"就是亞摩利王西宏和巴珊王噩，","poem":1},{"lineBreak":true},{"text":"並迦南一切的國王，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"將他們的地賞賜他的百姓以色列為業。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和華啊，你的名存到永遠！","poem":1},{"lineBreak":true},{"text":"耶和華啊，你可記念的名存到萬代！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華要為他的百姓伸冤，","poem":1},{"lineBreak":true},{"text":"為他的僕人後悔。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"外邦的偶像是金的，銀的，","poem":1},{"lineBreak":true},{"text":"是人手所造的；","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"有口卻不能言，","poem":1},{"lineBreak":true},{"text":"有眼卻不能看，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"有耳卻不能聽，","poem":1},{"lineBreak":true},{"text":"口中也沒有氣息。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"造他的要和他一樣，","poem":1},{"lineBreak":true},{"text":"凡靠他的也要如此。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"以色列家啊，你們要稱頌耶和華！","poem":1},{"lineBreak":true},{"text":"亞倫家啊，你們要稱頌耶和華！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"利未家啊，你們要稱頌耶和華！","poem":1},{"lineBreak":true},{"text":"你們敬畏耶和華的，要稱頌耶和華！","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"住在耶路撒冷的耶和華","poem":1},{"lineBreak":true},{"text":"該從錫安受稱頌。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":20}