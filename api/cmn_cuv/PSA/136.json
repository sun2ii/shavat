{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":136,"content":[{"type":"heading","content":["感恩的聖詩"]},{"type":"verse","number":1,"content":[{"text":"你們要稱謝耶和華，因他本為善；","poem":1},{"lineBreak":true},{"text":"他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們要稱謝萬神之神，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們要稱謝萬主之主，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"稱謝那獨行大奇事的，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"稱謝那用智慧造天的，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"稱謝那鋪地在水以上的，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"稱謝那造成大光的，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他造日頭管白晝，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他造月亮星宿管黑夜，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"稱謝那擊殺埃及人之長子的，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他領以色列人從他們中間出來，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他施展大能的手和伸出來的膀臂，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"稱謝那分裂紅海的，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他領以色列從其中經過，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存；","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"卻把法老和他的軍兵推翻在紅海裏，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"稱謝那引導自己的民行走曠野的，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"稱謝那擊殺大君王的，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他殺戮有名的君王，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"就是殺戮亞摩利王西宏，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存；","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"又殺巴珊王噩，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他將他們的地賜他的百姓為業，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存；","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"就是賜他的僕人以色列為業，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"他顧念我們在卑微的地步，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他救拔我們脫離敵人，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"他賜糧食給凡有血氣的，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"你們要稱謝天上的上帝，","poem":1},{"lineBreak":true},{"text":"因他的慈愛永遠長存。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}