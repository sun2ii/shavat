{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":137,"content":[{"type":"heading","content":["以色列人被擄的哀歌"]},{"type":"verse","number":1,"content":[{"text":"我們曾在巴比倫的河邊坐下，","poem":1},{"lineBreak":true},{"text":"一追想錫安就哭了。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我們把琴掛在那裏的柳樹上；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為在那裏，擄掠我們的要我們唱歌，","poem":1},{"lineBreak":true},{"text":"搶奪我們的要我們作樂，說：","poem":1},{"lineBreak":true},{"text":"給我們唱一首錫安歌吧！","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我們怎能在外邦唱耶和華的歌呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶路撒冷啊，我若忘記你，","poem":1},{"lineBreak":true},{"text":"情願我的右手忘記技巧！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我若不記念你，","poem":1},{"lineBreak":true},{"text":"若不看耶路撒冷過於我所最喜樂的，","poem":1},{"lineBreak":true},{"text":"情願我的舌頭貼於上膛！","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶路撒冷遭難的日子，","poem":1},{"lineBreak":true},{"text":"以東人說：拆毀！拆毀！","poem":1},{"lineBreak":true},{"text":"直拆到根基！","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你記念這仇！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"將要被滅的巴比倫城啊","poem":1},{"noteId":55},{"text":"，","poem":1},{"lineBreak":true},{"text":"報復你像你待我們的，那人便為有福！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"拿你的嬰孩摔在磐石上的，","poem":1},{"lineBreak":true},{"text":"那人便為有福！","poem":1}]}],"footnotes":[{"noteId":55,"caller":"-","text":"城：原文是女子","reference":{"chapter":137,"verse":8}}]},"thisChapterLink":"/api/cmn_cuv/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}