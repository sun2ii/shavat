{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":138,"content":[{"type":"heading","content":["感恩之禱"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"我要一心稱謝你，","poem":1},{"lineBreak":true},{"text":"在諸神面前歌頌你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要向你的聖殿下拜，","poem":1},{"lineBreak":true},{"text":"為你的慈愛和誠實稱讚你的名；","poem":1},{"lineBreak":true},{"text":"因你使你的話顯為大，","poem":1},{"lineBreak":true},{"text":"過於你所應許的","poem":1},{"noteId":56},{"text":"。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我呼求的日子，你就應允我，","poem":1},{"lineBreak":true},{"text":"鼓勵我，使我心裏有能力。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華啊，地上的君王都要稱謝你，","poem":1},{"lineBreak":true},{"text":"因他們聽見了你口中的言語。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們要歌頌耶和華的作為，","poem":1},{"lineBreak":true},{"text":"因耶和華大有榮耀。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華雖高，仍看顧低微的人；","poem":1},{"lineBreak":true},{"text":"他卻從遠處看出驕傲的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我雖行在患難中，你必將我救活；","poem":1},{"lineBreak":true},{"text":"我的仇敵發怒，你必伸手抵擋他們；","poem":1},{"lineBreak":true},{"text":"你的右手也必救我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華必成全關乎我的事；","poem":1},{"lineBreak":true},{"text":"耶和華啊，你的慈愛永遠長存！","poem":1},{"lineBreak":true},{"text":"求你不要離棄你手所造的。","poem":1}]}],"footnotes":[{"noteId":56,"caller":"-","text":"或譯：超乎你的名聲","reference":{"chapter":138,"verse":2}}]},"thisChapterLink":"/api/cmn_cuv/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}