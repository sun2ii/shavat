{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":139,"content":[{"type":"heading","content":["耶和華的全知和眷顧"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，你已經鑒察我，認識我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我坐下，我起來，你都曉得；","poem":1},{"lineBreak":true},{"text":"你從遠處知道我的意念。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我行路，我躺臥，你都細察；","poem":1},{"lineBreak":true},{"text":"你也深知我一切所行的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華啊，我舌頭上的話，","poem":1},{"lineBreak":true},{"text":"你沒有一句不知道的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你在我前後環繞我，","poem":1},{"lineBreak":true},{"text":"按手在我身上。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"這樣的知識奇妙，是我不能測的，","poem":1},{"lineBreak":true},{"text":"至高，是我不能及的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我往哪裏去躲避你的靈？","poem":1},{"lineBreak":true},{"text":"我往哪裏逃、躲避你的面？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我若升到天上，你在那裏；","poem":1},{"lineBreak":true},{"text":"我若在陰間下榻，你也在那裏。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我若展開清晨的翅膀，","poem":1},{"lineBreak":true},{"text":"飛到海極居住，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"就是在那裏，你的手必引導我；","poem":1},{"lineBreak":true},{"text":"你的右手也必扶持我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我若說：黑暗必定遮蔽我，","poem":1},{"lineBreak":true},{"text":"我周圍的亮光必成為黑夜；","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"黑暗也不能遮蔽我，使你不見，","poem":1},{"lineBreak":true},{"text":"黑夜卻如白晝發亮。","poem":1},{"lineBreak":true},{"text":"黑暗和光明，在你看都是一樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我的肺腑是你所造的；","poem":1},{"lineBreak":true},{"text":"我在母腹中，你已覆庇我。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我要稱謝你，因我受造，奇妙可畏；","poem":1},{"lineBreak":true},{"text":"你的作為奇妙，這是我心深知道的。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我在暗中受造，在地的深處被聯絡；","poem":1},{"lineBreak":true},{"text":"那時，我的形體並不向你隱藏。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我未成形的體質，你的眼早已看見了；","poem":1},{"lineBreak":true},{"text":"你所定的日子，我尚未度一日","poem":1},{"noteId":57},{"text":"，","poem":1},{"lineBreak":true},{"text":"你都寫在你的冊上了。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"上帝啊，你的意念向我何等寶貴！","poem":1},{"lineBreak":true},{"text":"其數何等眾多！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我若數點，比海沙更多；","poem":1},{"lineBreak":true},{"text":"我睡醒的時候，仍和你同在。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"上帝啊，你必要殺戮惡人；","poem":1},{"lineBreak":true},{"text":"所以，你們好流人血的，離開我去吧！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"因為他們說惡言頂撞你；","poem":1},{"lineBreak":true},{"text":"你的仇敵也妄稱你的名。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"耶和華啊，恨惡你的，我豈不恨惡他們嗎？","poem":1},{"lineBreak":true},{"text":"攻擊你的，我豈不憎嫌他們嗎？","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我切切地恨惡他們，","poem":1},{"lineBreak":true},{"text":"以他們為仇敵。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"上帝啊，求你鑒察我，知道我的心思，","poem":1},{"lineBreak":true},{"text":"試煉我，知道我的意念，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"看在我裏面有甚麼惡行沒有，","poem":1},{"lineBreak":true},{"text":"引導我走永生的道路。","poem":1}]}],"footnotes":[{"noteId":57,"caller":"-","text":"或譯：我被造的肢體尚未有其一","reference":{"chapter":139,"verse":16}}]},"thisChapterLink":"/api/cmn_cuv/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}