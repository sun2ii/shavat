{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":140,"content":[{"type":"heading","content":["求耶和華護佑"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你拯救我脫離凶惡的人，","poem":1},{"lineBreak":true},{"text":"保護我脫離強暴的人！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他們心中圖謀奸惡，","poem":1},{"lineBreak":true},{"text":"常常聚集要爭戰。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們使舌頭尖利如蛇，","poem":1},{"lineBreak":true},{"text":"嘴裏有虺蛇的毒氣。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華啊，求你拯救我脫離惡人的手，","poem":1},{"lineBreak":true},{"text":"保護我脫離強暴的人！","poem":1},{"lineBreak":true},{"text":"他們圖謀推我跌倒。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"驕傲人為我暗設網羅和繩索；","poem":1},{"lineBreak":true},{"text":"他們在路旁鋪下網，設下圈套。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我曾對耶和華說：你是我的上帝。","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你留心聽我懇求的聲音！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"主－耶和華、我救恩的力量啊，","poem":1},{"lineBreak":true},{"text":"在爭戰的日子，你遮蔽了我的頭。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華啊，求你不要遂惡人的心願；","poem":1},{"lineBreak":true},{"text":"不要成就他們的計謀，恐怕他們自高。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"至於那些昂首圍困我的人，","poem":1},{"lineBreak":true},{"text":"願他們嘴唇的奸惡陷害","poem":1},{"noteId":58},{"text":"自己！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"願火炭落在他們身上！","poem":1},{"lineBreak":true},{"text":"願他們被丟在火中，","poem":1},{"lineBreak":true},{"text":"拋在深坑裏，不能再起來。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"說惡言的人在地上必堅立不住；","poem":1},{"lineBreak":true},{"text":"禍患必獵取強暴的人，將他打倒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"我知道耶和華必為困苦人伸冤，","poem":1},{"lineBreak":true},{"text":"必為窮乏人辨屈。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"義人必要稱讚你的名；","poem":1},{"lineBreak":true},{"text":"正直人必住在你面前。","poem":1}]}],"footnotes":[{"noteId":58,"caller":"-","text":"原文是遮蔽","reference":{"chapter":140,"verse":9}}]},"thisChapterLink":"/api/cmn_cuv/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}