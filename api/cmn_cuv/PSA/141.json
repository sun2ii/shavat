{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":141,"content":[{"type":"heading","content":["晚 禱"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我曾求告你，","poem":1},{"lineBreak":true},{"text":"求你快快臨到我這裏！","poem":1},{"lineBreak":true},{"text":"我求告你的時候，","poem":1},{"lineBreak":true},{"text":"願你留心聽我的聲音！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願我的禱告如香陳列在你面前！","poem":1},{"lineBreak":true},{"text":"願我舉手祈求，如獻晚祭！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和華啊，求你禁止我的口，","poem":1},{"lineBreak":true},{"text":"把守我的嘴！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"求你不叫我的心偏向邪惡，","poem":1},{"lineBreak":true},{"text":"以致我和作孽的人同行惡事；","poem":1},{"lineBreak":true},{"text":"也不叫我吃他們的美食。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"任憑義人擊打我，這算為仁慈；","poem":1},{"lineBreak":true},{"text":"任憑他責備我，這算為頭上的膏油；","poem":1},{"lineBreak":true},{"text":"我的頭不要躲閃。","poem":1},{"lineBreak":true},{"text":"正在他們行惡的時候，我仍要祈禱。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們的審判官被扔在巖下；","poem":1},{"lineBreak":true},{"text":"眾人要聽我的話，因為這話甘甜。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我們的骨頭散在墓旁，","poem":1},{"lineBreak":true},{"text":"好像人耕田、刨地的土塊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"主－耶和華啊，我的眼目仰望你；","poem":1},{"lineBreak":true},{"text":"我投靠你，求你不要將我撇得孤苦！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你保護我脫離惡人為我設的網羅","poem":1},{"lineBreak":true},{"text":"和作孽之人的圈套！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"願惡人落在自己的網裏，","poem":1},{"lineBreak":true},{"text":"我卻得以逃脫。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}