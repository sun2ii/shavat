{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":142,"content":[{"type":"heading","content":["求主眷顧"]},{"type":"hebrew_subtitle","content":["大衛在洞裏作的訓誨詩，乃是祈禱。"]},{"type":"verse","number":1,"content":[{"text":"我發聲哀告耶和華，","poem":1},{"lineBreak":true},{"text":"發聲懇求耶和華。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在他面前吐露我的苦情，","poem":1},{"lineBreak":true},{"text":"陳說我的患難。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的靈在我裏面發昏的時候，","poem":1},{"lineBreak":true},{"text":"你知道我的道路。","poem":1},{"lineBreak":true},{"text":"在我行的路上，","poem":1},{"lineBreak":true},{"text":"敵人為我暗設網羅。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"求你向我右邊觀看，","poem":1},{"lineBreak":true},{"text":"因為沒有人認識我；","poem":1},{"lineBreak":true},{"text":"我無處避難，","poem":1},{"lineBreak":true},{"text":"也沒有人眷顧我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和華啊，我曾向你哀求。","poem":1},{"lineBreak":true},{"text":"我說：你是我的避難所；","poem":1},{"lineBreak":true},{"text":"在活人之地，你是我的福分。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你側耳聽我的呼求，","poem":1},{"lineBreak":true},{"text":"因我落到極卑之地；","poem":1},{"lineBreak":true},{"text":"求你救我脫離逼迫我的人，","poem":1},{"lineBreak":true},{"text":"因為他們比我強盛。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你領我出離被囚之地，","poem":1},{"lineBreak":true},{"text":"我好稱讚你的名。","poem":1},{"lineBreak":true},{"text":"義人必環繞我，","poem":1},{"lineBreak":true},{"text":"因為你是用厚恩待我。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}