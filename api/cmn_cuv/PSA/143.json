{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":143,"content":[{"type":"heading","content":["求主拯救"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你聽我的禱告，","poem":1},{"lineBreak":true},{"text":"留心聽我的懇求，","poem":1},{"lineBreak":true},{"text":"憑你的信實和公義應允我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你不要審問僕人；","poem":1},{"lineBreak":true},{"text":"因為在你面前，凡活着的人沒有一個是義的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"原來仇敵逼迫我，","poem":1},{"lineBreak":true},{"text":"將我打倒在地，","poem":1},{"lineBreak":true},{"text":"使我住在幽暗之處，","poem":1},{"lineBreak":true},{"text":"像死了許久的人一樣。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"所以，我的靈在我裏面發昏；","poem":1},{"lineBreak":true},{"text":"我的心在我裏面悽慘。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我追想古時之日，","poem":1},{"lineBreak":true},{"text":"思想你的一切作為，","poem":1},{"lineBreak":true},{"text":"默念你手的工作。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我向你舉手；","poem":1},{"lineBreak":true},{"text":"我的心渴想你，","poem":1},{"lineBreak":true},{"text":"如乾旱之地盼雨一樣。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和華啊，求你速速應允我！","poem":1},{"lineBreak":true},{"text":"我心神耗盡！","poem":1},{"lineBreak":true},{"text":"不要向我掩面，","poem":1},{"lineBreak":true},{"text":"免得我像那些下坑的人一樣。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你使我清晨得聽你慈愛之言，","poem":1},{"lineBreak":true},{"text":"因我倚靠你；","poem":1},{"lineBreak":true},{"text":"求你使我知道當行的路，","poem":1},{"lineBreak":true},{"text":"因我的心仰望你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和華啊，求你救我脫離我的仇敵！","poem":1},{"lineBreak":true},{"text":"我往你那裏藏身。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"求你指教我遵行你的旨意，","poem":1},{"lineBreak":true},{"text":"因你是我的上帝。","poem":1},{"lineBreak":true},{"text":"你的靈本為善；","poem":1},{"lineBreak":true},{"text":"求你引我到平坦之地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和華啊，求你為你的名將我救活，","poem":1},{"lineBreak":true},{"text":"憑你的公義，將我從患難中領出來，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"憑你的慈愛剪除我的仇敵，","poem":1},{"lineBreak":true},{"text":"滅絕一切苦待我的人，","poem":1},{"lineBreak":true},{"text":"因我是你的僕人。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}