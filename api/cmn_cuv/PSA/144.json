{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":144,"content":[{"type":"heading","content":["君王為勝利感恩"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華－我的磐石是應當稱頌的！","poem":1},{"lineBreak":true},{"text":"他教導我的手爭戰，","poem":1},{"lineBreak":true},{"text":"教導我的指頭打仗。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他是我慈愛的主，我的山寨，","poem":1},{"lineBreak":true},{"text":"我的高臺，我的救主，","poem":1},{"lineBreak":true},{"text":"我的盾牌，是我所投靠的；","poem":1},{"lineBreak":true},{"text":"他使我的百姓服在我以下。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和華啊，人算甚麼，你竟認識他！","poem":1},{"lineBreak":true},{"text":"世人算甚麼，你竟顧念他！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"人好像一口氣；","poem":1},{"lineBreak":true},{"text":"他的年日如同影兒快快過去。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華啊，求你使天下垂，親自降臨，","poem":1},{"lineBreak":true},{"text":"摸山，山就冒煙。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你發出閃電，使他們四散，","poem":1},{"lineBreak":true},{"text":"射出你的箭，使他們擾亂。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你從上伸手救拔我，","poem":1},{"lineBreak":true},{"text":"救我出離大水，","poem":1},{"lineBreak":true},{"text":"救我脫離外邦人的手。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們的口說謊話；","poem":1},{"lineBreak":true},{"text":"他們的右手起假誓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"上帝啊，我要向你唱新歌，","poem":1},{"lineBreak":true},{"text":"用十弦瑟向你歌頌。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你是那拯救君王的；","poem":1},{"lineBreak":true},{"text":"你是那救僕人大衛脫離害命之刀的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你救拔我，","poem":1},{"lineBreak":true},{"text":"救我脫離外邦人的手。","poem":1},{"lineBreak":true},{"text":"他們的口說謊話；","poem":1},{"lineBreak":true},{"text":"他們的右手起假誓。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"我們的兒子從幼年好像樹栽子長大；","poem":1},{"lineBreak":true},{"text":"我們的女兒如同殿角石，","poem":1},{"lineBreak":true},{"text":"是按建宮的樣式鑿成的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我們的倉盈滿，能出各樣的糧食；","poem":1},{"lineBreak":true},{"text":"我們的羊在田間孳生千萬。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我們的牛馱着滿馱，","poem":1},{"lineBreak":true},{"text":"沒有人闖進來搶奪，","poem":1},{"lineBreak":true},{"text":"也沒有人出去爭戰；","poem":1},{"lineBreak":true},{"text":"我們的街市上也沒有哭號的聲音。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"遇見這光景的百姓便為有福！","poem":1},{"lineBreak":true},{"text":"有耶和華為他們的上帝，這百姓便為有福！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}