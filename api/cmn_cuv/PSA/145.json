{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":145,"content":[{"type":"heading","content":["稱頌的聖詩"]},{"type":"hebrew_subtitle","content":["大衛的讚美詩。"]},{"type":"verse","number":1,"content":[{"text":"我的上帝我的王啊，我要尊崇你！","poem":1},{"lineBreak":true},{"text":"我要永永遠遠稱頌你的名！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要天天稱頌你，","poem":1},{"lineBreak":true},{"text":"也要永永遠遠讚美你的名！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華本為大，該受大讚美；","poem":1},{"lineBreak":true},{"text":"其大無法測度。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"這代要對那代頌讚你的作為，","poem":1},{"lineBreak":true},{"text":"也要傳揚你的大能。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我要默念你威嚴的尊榮","poem":1},{"lineBreak":true},{"text":"和你奇妙的作為。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"人要傳說你可畏之事的能力；","poem":1},{"lineBreak":true},{"text":"我也要傳揚你的大德。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們記念你的大恩就要傳出來，","poem":1},{"lineBreak":true},{"text":"並要歌唱你的公義。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和華有恩惠，有憐憫，","poem":1},{"lineBreak":true},{"text":"不輕易發怒，大有慈愛。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華善待萬民；","poem":1},{"lineBreak":true},{"text":"他的慈悲覆庇他一切所造的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和華啊，你一切所造的都要稱謝你；","poem":1},{"lineBreak":true},{"text":"你的聖民也要稱頌你，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"傳說你國的榮耀，","poem":1},{"lineBreak":true},{"text":"談論你的大能，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"好叫世人知道你大能的作為，","poem":1},{"lineBreak":true},{"text":"並你國度威嚴的榮耀。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你的國是永遠的國！","poem":1},{"lineBreak":true},{"text":"你執掌的權柄存到萬代！","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"凡跌倒的，耶和華將他們扶持；","poem":1},{"lineBreak":true},{"text":"凡被壓下的，將他們扶起。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"萬民都舉目仰望你；","poem":1},{"lineBreak":true},{"text":"你隨時給他們食物。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你張手，","poem":1},{"lineBreak":true},{"text":"使有生氣的都隨願飽足。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和華在他一切所行的，無不公義；","poem":1},{"lineBreak":true},{"text":"在他一切所做的都有慈愛。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"凡求告耶和華的，就是誠心求告他的，","poem":1},{"lineBreak":true},{"text":"耶和華便與他們相近。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"敬畏他的，他必成就他們的心願，","poem":1},{"lineBreak":true},{"text":"也必聽他們的呼求，拯救他們。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和華保護一切愛他的人，","poem":1},{"lineBreak":true},{"text":"卻要滅絕一切的惡人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"我的口要說出讚美耶和華的話；","poem":1},{"lineBreak":true},{"text":"惟願凡有血氣的都永永遠遠稱頌他的聖名。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}