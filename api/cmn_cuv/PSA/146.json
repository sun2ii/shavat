{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":146,"content":[{"type":"heading","content":["讚美耶和華的救助"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"我的心哪，你要讚美耶和華！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我一生要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"我還活的時候要歌頌我的上帝！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你們不要倚靠君王，不要倚靠世人；","poem":1},{"lineBreak":true},{"text":"他一點不能幫助。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他的氣一斷，就歸回塵土；","poem":1},{"lineBreak":true},{"text":"他所打算的，當日就消滅了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"以雅各的上帝為幫助、","poem":1},{"lineBreak":true},{"text":"仰望耶和華－他上帝的，這人便為有福！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華造天、地、海，和其中的萬物；","poem":1},{"lineBreak":true},{"text":"他守誠實，直到永遠。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他為受屈的伸冤，","poem":1},{"lineBreak":true},{"text":"賜食物與飢餓的。","poem":1},{"lineBreak":true},{"text":"耶和華釋放被囚的；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華開了瞎子的眼睛；","poem":1},{"lineBreak":true},{"text":"耶和華扶起被壓下的人。","poem":1},{"lineBreak":true},{"text":"耶和華喜愛義人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華保護寄居的，","poem":1},{"lineBreak":true},{"text":"扶持孤兒和寡婦，","poem":1},{"lineBreak":true},{"text":"卻使惡人的道路彎曲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"耶和華要作王，直到永遠！","poem":1},{"lineBreak":true},{"text":"錫安哪，你的上帝要作王，直到萬代！","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}