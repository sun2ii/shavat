{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":147,"content":[{"type":"heading","content":["讚美上帝的全能"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"因歌頌我們的上帝為善為美；","poem":1},{"lineBreak":true},{"text":"讚美的話是合宜的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華建造耶路撒冷，","poem":1},{"lineBreak":true},{"text":"聚集以色列中被趕散的人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他醫好傷心的人，","poem":1},{"lineBreak":true},{"text":"裹好他們的傷處。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他數點星宿的數目，","poem":1},{"lineBreak":true},{"text":"一一稱它的名。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我們的主為大，最有能力；","poem":1},{"lineBreak":true},{"text":"他的智慧無法測度。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"耶和華扶持謙卑人，","poem":1},{"lineBreak":true},{"text":"將惡人傾覆於地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"你們要以感謝向耶和華歌唱，","poem":1},{"lineBreak":true},{"text":"用琴向我們的上帝歌頌。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他用雲遮天，為地降雨，","poem":1},{"lineBreak":true},{"text":"使草生長在山上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他賜食給走獸","poem":1},{"lineBreak":true},{"text":"和啼叫的小烏鴉。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他不喜悅馬的力大，","poem":1},{"lineBreak":true},{"text":"不喜愛人的腿快。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華喜愛敬畏他","poem":1},{"lineBreak":true},{"text":"和盼望他慈愛的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶路撒冷啊，你要頌讚耶和華！","poem":1},{"lineBreak":true},{"text":"錫安哪，你要讚美你的上帝！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因為他堅固了你的門閂，","poem":1},{"lineBreak":true},{"text":"賜福給你中間的兒女。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他使你境內平安，","poem":1},{"lineBreak":true},{"text":"用上好的麥子使你滿足。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他發命在地；","poem":1},{"lineBreak":true},{"text":"他的話頒行最快。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他降雪如羊毛，","poem":1},{"lineBreak":true},{"text":"撒霜如爐灰。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他擲下冰雹如碎渣；","poem":1},{"lineBreak":true},{"text":"他發出寒冷，誰能當得起呢？","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他一出令，這些就都消化；","poem":1},{"lineBreak":true},{"text":"他使風颳起，水便流動。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"他將他的道指示雅各，","poem":1},{"lineBreak":true},{"text":"將他的律例典章指示以色列。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"別國他都沒有這樣待過；","poem":1},{"lineBreak":true},{"text":"至於他的典章，他們向來沒有知道。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}