{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":148,"content":[{"type":"heading","content":["宣召萬有讚美耶和華"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"從天上讚美耶和華，","poem":1},{"lineBreak":true},{"text":"在高處讚美他！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他的眾使者都要讚美他！","poem":1},{"lineBreak":true},{"text":"他的諸軍都要讚美他！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"日頭月亮，你們要讚美他！","poem":1},{"lineBreak":true},{"text":"放光的星宿，你們都要讚美他！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"天上的天和天上的水，","poem":1},{"lineBreak":true},{"text":"你們都要讚美他！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"願這些都讚美耶和華的名！","poem":1},{"lineBreak":true},{"text":"因他一吩咐便都造成。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他將這些立定，直到永永遠遠；","poem":1},{"lineBreak":true},{"text":"他定了命，不能廢去","poem":1},{"noteId":59},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"所有在地上的，","poem":1},{"lineBreak":true},{"text":"大魚和一切深洋，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"火與冰雹，雪和霧氣，","poem":1},{"lineBreak":true},{"text":"成就他命的狂風，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"大山和小山，","poem":1},{"lineBreak":true},{"text":"結果的樹木和一切香柏樹，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"野獸和一切牲畜，","poem":1},{"lineBreak":true},{"text":"昆蟲和飛鳥，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"世上的君王和萬民，","poem":1},{"lineBreak":true},{"text":"首領和世上一切審判官，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"少年人和處女，","poem":1},{"lineBreak":true},{"text":"老年人和孩童，","poem":1},{"lineBreak":true},{"text":"都當讚美耶和華！","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"願這些都讚美耶和華的名！","poem":1},{"lineBreak":true},{"text":"因為獨有他的名被尊崇；","poem":1},{"lineBreak":true},{"text":"他的榮耀在天地之上。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他將他百姓的角高舉，","poem":1},{"lineBreak":true},{"text":"因此他","poem":1},{"noteId":60},{"text":"一切聖民以色列人，","poem":1},{"lineBreak":true},{"text":"就是與他相近的百姓，都讚美他！","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[{"noteId":59,"caller":"-","text":"或譯：越過","reference":{"chapter":148,"verse":6}},{"noteId":60,"caller":"-","text":"或譯：他使","reference":{"chapter":148,"verse":14}}]},"thisChapterLink":"/api/cmn_cuv/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}