{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":149,"content":[{"type":"heading","content":["讚美的聖詩"]},{"type":"verse","number":1,"content":[{"text":"你們要讚美耶和華！","poem":1},{"lineBreak":true},{"text":"向耶和華唱新歌，","poem":1},{"lineBreak":true},{"text":"在聖民的會中讚美他！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願以色列因造他的主歡喜！","poem":1},{"lineBreak":true},{"text":"願錫安的民因他們的王快樂！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"願他們跳舞讚美他的名，","poem":1},{"lineBreak":true},{"text":"擊鼓彈琴歌頌他！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因為耶和華喜愛他的百姓；","poem":1},{"lineBreak":true},{"text":"他要用救恩當作謙卑人的妝飾。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"願聖民因所得的榮耀高興！","poem":1},{"lineBreak":true},{"text":"願他們在床上歡呼！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"願他們口中稱讚上帝為高，","poem":1},{"lineBreak":true},{"text":"手裏有兩刃的刀，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"為要報復列邦，","poem":1},{"lineBreak":true},{"text":"刑罰萬民。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"要用鍊子捆他們的君王，","poem":1},{"lineBreak":true},{"text":"用鐵鐐鎖他們的大臣；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"要在他們身上施行所記錄的審判。","poem":1},{"lineBreak":true},{"text":"他的聖民都有這榮耀。","poem":1},{"lineBreak":true},{"text":"你們要讚美耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}