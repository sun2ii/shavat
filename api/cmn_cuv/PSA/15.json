{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":15,"content":[{"type":"heading","content":["得居聖山者的品行"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，誰能寄居你的帳幕？","poem":1},{"lineBreak":true},{"text":"誰能住在你的聖山？","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"就是行為正直、做事公義、","poem":1},{"lineBreak":true},{"text":"心裏說實話的人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他不以舌頭讒謗人，","poem":1},{"lineBreak":true},{"text":"不惡待朋友，","poem":1},{"lineBreak":true},{"text":"也不隨夥毀謗鄰里。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他眼中藐視匪類，","poem":1},{"lineBreak":true},{"text":"卻尊重那敬畏耶和華的人。","poem":1},{"lineBreak":true},{"text":"他發了誓，雖然自己吃虧也不更改。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他不放債取利，","poem":1},{"lineBreak":true},{"text":"不受賄賂以害無辜。","poem":1},{"lineBreak":true},{"text":"行這些事的人必永不動搖。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}