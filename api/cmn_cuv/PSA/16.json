{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":16,"content":[{"type":"heading","content":["為信心穩固而祈禱"]},{"type":"hebrew_subtitle","content":["大衛的金詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你保佑我，","poem":1},{"lineBreak":true},{"text":"因為我投靠你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的心哪，你曾對耶和華說：你是我的主；","poem":1},{"lineBreak":true},{"text":"我的好處不在你以外。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"論到世上的聖民，他們又美又善，","poem":1},{"lineBreak":true},{"text":"是我最喜悅的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"以別神代替耶和華的","poem":1},{"noteId":6},{"text":"，","poem":1},{"lineBreak":true},{"text":"他們的愁苦必加增；","poem":1},{"lineBreak":true},{"text":"他們所澆奠的血我不獻上；","poem":1},{"lineBreak":true},{"text":"我嘴唇也不提別神的名號。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和華是我的產業，","poem":1},{"lineBreak":true},{"text":"是我杯中的分；","poem":1},{"lineBreak":true},{"text":"我所得的，你為我持守。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"用繩量給我的地界，坐落在佳美之處；","poem":1},{"lineBreak":true},{"text":"我的產業實在美好。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我必稱頌那指教我的耶和華；","poem":1},{"lineBreak":true},{"text":"我的心腸在夜間也警戒我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我將耶和華常擺在我面前，","poem":1},{"lineBreak":true},{"text":"因他在我右邊，我便不致搖動。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"因此，我的心歡喜，我的靈","poem":1},{"noteId":7},{"text":"快樂；","poem":1},{"lineBreak":true},{"text":"我的肉身也要安然居住。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因為你必不將我的靈魂撇在陰間，","poem":1},{"lineBreak":true},{"text":"也不叫你的聖者見朽壞。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你必將生命的道路指示我。","poem":1},{"lineBreak":true},{"text":"在你面前有滿足的喜樂；","poem":1},{"lineBreak":true},{"text":"在你右手中有永遠的福樂。","poem":1}]}],"footnotes":[{"noteId":6,"caller":"-","text":"或譯：送禮物給別神的","reference":{"chapter":16,"verse":4}},{"noteId":7,"caller":"-","text":"原文是榮耀","reference":{"chapter":16,"verse":9}}]},"thisChapterLink":"/api/cmn_cuv/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}