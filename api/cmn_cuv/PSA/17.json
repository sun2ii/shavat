{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":17,"content":[{"type":"heading","content":["無辜的人的禱告"]},{"type":"hebrew_subtitle","content":["大衛的祈禱。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你聽聞公義，","poem":1},{"lineBreak":true},{"text":"側耳聽我的呼籲！","poem":1},{"lineBreak":true},{"text":"求你留心聽我這不出於詭詐嘴唇的祈禱！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願我的判語從你面前發出；","poem":1},{"lineBreak":true},{"text":"願你的眼睛觀看公正。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你已經試驗我的心；","poem":1},{"lineBreak":true},{"text":"你在夜間鑒察我；","poem":1},{"lineBreak":true},{"text":"你熬煉我，卻找不着甚麼；","poem":1},{"lineBreak":true},{"text":"我立志叫我口中沒有過失。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"論到人的行為，我藉着你嘴唇的言語自己謹守，","poem":1},{"lineBreak":true},{"text":"不行強暴人的道路。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的腳踏定了你的路徑；","poem":1},{"lineBreak":true},{"text":"我的兩腳未曾滑跌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"上帝啊，我曾求告你，因為你必應允我；","poem":1},{"lineBreak":true},{"text":"求你向我側耳，聽我的言語。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你顯出你奇妙的慈愛來；","poem":1},{"lineBreak":true},{"text":"你是那用右手拯救投靠你的脫離起來攻擊他們的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"求你保護我，如同保護眼中的瞳人；","poem":1},{"lineBreak":true},{"text":"將我隱藏在你翅膀的蔭下，","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"使我脫離那欺壓我的惡人，","poem":1},{"lineBreak":true},{"text":"就是圍困我要害我命的仇敵。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"他們的心被脂油包裹；","poem":1},{"lineBreak":true},{"text":"他們用口說驕傲的話。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們圍困了我們的腳步；","poem":1},{"lineBreak":true},{"text":"他們瞪着眼，要把我們推倒在地。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他像獅子急要抓食，","poem":1},{"lineBreak":true},{"text":"又像少壯獅子蹲伏在暗處。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和華啊，求你起來，前去迎敵，將他打倒！","poem":1},{"lineBreak":true},{"text":"用你的刀救護我命脫離惡人。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華啊，求你用手救我脫離世人，","poem":1},{"lineBreak":true},{"text":"脫離那只在今生有福分的世人！","poem":1},{"lineBreak":true},{"text":"你把你的財寶充滿他們的肚腹；","poem":1},{"lineBreak":true},{"text":"他們因有兒女就心滿意足，","poem":1},{"lineBreak":true},{"text":"將其餘的財物留給他們的嬰孩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"至於我，我必在義中見你的面；","poem":1},{"lineBreak":true},{"text":"我醒了的時候，得見","poem":1},{"noteId":8},{"text":"你的形像就心滿意足了。","poem":1}]}],"footnotes":[{"noteId":8,"caller":"-","text":"或譯：着","reference":{"chapter":17,"verse":15}}]},"thisChapterLink":"/api/cmn_cuv/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}