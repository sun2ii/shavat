{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":18,"content":[{"type":"heading","content":["大衛的勝利之歌"]},{"type":"hebrew_subtitle","content":["耶和華的僕人大衛的詩，交與伶長。當耶和華救他脫離一切仇敵和掃羅之手的日子，他向耶和華念這詩的話。說："]},{"type":"verse","number":1,"content":[{"text":"耶和華，我的力量啊，我愛你！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華是我的巖石，我的山寨，我的救主，","poem":1},{"lineBreak":true},{"text":"我的上帝，我的磐石，我所投靠的。","poem":1},{"lineBreak":true},{"text":"他是我的盾牌，","poem":1},{"lineBreak":true},{"text":"是拯救我的角，是我的高臺。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我要求告當讚美的耶和華；","poem":1},{"lineBreak":true},{"text":"這樣我必從仇敵手中被救出來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"曾有死亡的繩索纏繞我，","poem":1},{"lineBreak":true},{"text":"匪類的急流使我驚懼，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"陰間的繩索纏繞我，","poem":1},{"lineBreak":true},{"text":"死亡的網羅臨到我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我在急難中求告耶和華，","poem":1},{"lineBreak":true},{"text":"向我的上帝呼求。","poem":1},{"lineBreak":true},{"text":"他從殿中聽了我的聲音；","poem":1},{"lineBreak":true},{"text":"我在他面前的呼求入了他的耳中。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"那時，因他發怒，地就搖撼戰抖；","poem":1},{"lineBreak":true},{"text":"山的根基也震動搖撼。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"從他鼻孔冒煙上騰；","poem":1},{"lineBreak":true},{"text":"從他口中發火焚燒，連炭也着了。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他又使天下垂，親自降臨，","poem":1},{"lineBreak":true},{"text":"有黑雲在他腳下。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他坐着基路伯飛行；","poem":1},{"lineBreak":true},{"text":"他藉着風的翅膀快飛。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他以黑暗為藏身之處，","poem":1},{"lineBreak":true},{"text":"以水的黑暗、天空的厚雲為他四圍的行宮。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因他面前的光輝，","poem":1},{"lineBreak":true},{"text":"他的厚雲行過便有冰雹火炭。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"耶和華也在天上打雷；","poem":1},{"lineBreak":true},{"text":"至高者發出聲音便有冰雹火炭。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他射出箭來，使仇敵四散；","poem":1},{"lineBreak":true},{"text":"多多發出閃電，使他們擾亂。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"耶和華啊，你的斥責一發，","poem":1},{"lineBreak":true},{"text":"你鼻孔的氣一出，","poem":1},{"lineBreak":true},{"text":"海底就出現，","poem":1},{"lineBreak":true},{"text":"大地的根基也顯露。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他從高天伸手抓住我，","poem":1},{"lineBreak":true},{"text":"把我從大水中拉上來。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他救我脫離我的勁敵和那些恨我的人，","poem":1},{"lineBreak":true},{"text":"因為他們比我強盛。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我遭遇災難的日子，他們來攻擊我；","poem":1},{"lineBreak":true},{"text":"但耶和華是我的倚靠。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他又領我到寬闊之處；","poem":1},{"lineBreak":true},{"text":"他救拔我，因他喜悅我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"耶和華按着我的公義報答我，","poem":1},{"lineBreak":true},{"text":"按着我手中的清潔賞賜我。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"因為我遵守了耶和華的道，","poem":1},{"lineBreak":true},{"text":"未曾作惡離開我的上帝。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"他的一切典章常在我面前；","poem":1},{"lineBreak":true},{"text":"他的律例我也未曾丟棄。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我在他面前作了完全人；","poem":1},{"lineBreak":true},{"text":"我也保守自己遠離我的罪孽。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"所以，耶和華按我的公義，","poem":1},{"lineBreak":true},{"text":"按我在他眼前手中的清潔償還我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"慈愛的人，你以慈愛待他；","poem":1},{"lineBreak":true},{"text":"完全的人，你以完全待他。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"清潔的人，你以清潔待他；","poem":1},{"lineBreak":true},{"text":"乖僻的人，你以彎曲待他。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"困苦的百姓，你必拯救；","poem":1},{"lineBreak":true},{"text":"高傲的眼目，你必使他降卑。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"你必點着我的燈；","poem":1},{"lineBreak":true},{"text":"耶和華－我的上帝必照明我的黑暗。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"我藉着你衝入敵軍，","poem":1},{"lineBreak":true},{"text":"藉着我的上帝跳過牆垣。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"至於上帝，他的道是完全的；","poem":1},{"lineBreak":true},{"text":"耶和華的話是煉淨的。","poem":1},{"lineBreak":true},{"text":"凡投靠他的，他便作他們的盾牌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"除了耶和華，誰是上帝呢？","poem":1},{"lineBreak":true},{"text":"除了我們的上帝，誰是磐石呢？","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"惟有那以力量束我的腰、","poem":1},{"lineBreak":true},{"text":"使我行為完全的，他是上帝。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"他使我的腳快如母鹿的蹄，","poem":1},{"lineBreak":true},{"text":"又使我在高處安穩。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"他教導我的手能以爭戰，","poem":1},{"lineBreak":true},{"text":"甚至我的膀臂能開銅弓。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"你把你的救恩給我作盾牌；","poem":1},{"lineBreak":true},{"text":"你的右手扶持我；","poem":1},{"lineBreak":true},{"text":"你的溫和使我為大。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"你使我腳下的地步寬闊；","poem":1},{"lineBreak":true},{"text":"我的腳未曾滑跌。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"我要追趕我的仇敵，並要追上他們；","poem":1},{"lineBreak":true},{"text":"不將他們滅絕，我總不歸回。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"我要打傷他們，使他們不能起來；","poem":1},{"lineBreak":true},{"text":"他們必倒在我的腳下。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"因為你曾以力量束我的腰，使我能爭戰；","poem":1},{"lineBreak":true},{"text":"你也使那起來攻擊我的都服在我以下。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"你又使我的仇敵在我面前轉背逃跑，","poem":1},{"lineBreak":true},{"text":"叫我能以剪除那恨我的人。","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"他們呼求，卻無人拯救；","poem":1},{"lineBreak":true},{"text":"就是呼求耶和華，他也不應允。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"我搗碎他們，如同風前的灰塵，","poem":1},{"lineBreak":true},{"text":"倒出他們，如同街上的泥土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"你救我脫離百姓的爭競，","poem":1},{"lineBreak":true},{"text":"立我作列國的元首；","poem":1},{"lineBreak":true},{"text":"我素不認識的民必事奉我。","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"他們一聽見我的名聲就必順從我；","poem":1},{"lineBreak":true},{"text":"外邦人要投降我。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"外邦人要衰殘，","poem":1},{"lineBreak":true},{"text":"戰戰兢兢地出他們的營寨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"耶和華是活神。","poem":1},{"lineBreak":true},{"text":"願我的磐石被人稱頌；","poem":1},{"lineBreak":true},{"text":"願救我的上帝被人尊崇。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"這位上帝，就是那為我伸冤、","poem":1},{"lineBreak":true},{"text":"使眾民服在我以下的。","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"你救我脫離仇敵，","poem":1},{"lineBreak":true},{"text":"又把我舉起，高過那些起來攻擊我的；","poem":1},{"lineBreak":true},{"text":"你救我脫離強暴的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"耶和華啊，因此我要在外邦中稱謝你，","poem":1},{"lineBreak":true},{"text":"歌頌你的名。","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"耶和華賜極大的救恩給他所立的王，","poem":1},{"lineBreak":true},{"text":"施慈愛給他的受膏者，","poem":1},{"lineBreak":true},{"text":"就是給大衛和他的後裔，直到永遠。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}