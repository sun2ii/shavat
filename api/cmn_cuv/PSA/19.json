{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":19,"content":[{"type":"heading","content":["造化的榮耀"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"諸天述說上帝的榮耀；","poem":1},{"lineBreak":true},{"text":"穹蒼傳揚他的手段。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"這日到那日發出言語；","poem":1},{"lineBreak":true},{"text":"這夜到那夜傳出知識。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"無言無語，","poem":1},{"lineBreak":true},{"text":"也無聲音可聽。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"它的量帶通遍天下，","poem":1},{"lineBreak":true},{"text":"它的言語傳到地極。","poem":1},{"lineBreak":true},{"text":"上帝在其間為太陽安設帳幕；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"太陽如同新郎出洞房，","poem":1},{"lineBreak":true},{"text":"又如勇士歡然奔路。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"它從天這邊出來，繞到天那邊，","poem":1},{"lineBreak":true},{"text":"沒有一物被隱藏不得它的熱氣。","poem":1}]},{"type":"heading","content":["耶和華的律法"]},{"type":"verse","number":7,"content":[{"text":"耶和華的律法全備，能甦醒人心；","poem":1},{"lineBreak":true},{"text":"耶和華的法度確定，能使愚人有智慧。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華的訓詞正直，能快活人的心；","poem":1},{"lineBreak":true},{"text":"耶和華的命令清潔，能明亮人的眼目。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華的道理潔淨，存到永遠；","poem":1},{"lineBreak":true},{"text":"耶和華的典章真實，全然公義－","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"都比金子可羨慕，且比極多的精金可羨慕；","poem":1},{"lineBreak":true},{"text":"比蜜甘甜，且比蜂房下滴的蜜甘甜。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"況且你的僕人因此受警戒，","poem":1},{"lineBreak":true},{"text":"守着這些便有大賞。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"誰能知道自己的錯失呢？","poem":1},{"lineBreak":true},{"text":"願你赦免我隱而未現的過錯。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"求你攔阻僕人不犯任意妄為的罪，","poem":1},{"lineBreak":true},{"text":"不容這罪轄制我，","poem":1},{"lineBreak":true},{"text":"我便完全，免犯大罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"耶和華－我的磐石，我的救贖主啊，","poem":1},{"lineBreak":true},{"text":"願我口中的言語、心裏的意念在你面前蒙悅納。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}