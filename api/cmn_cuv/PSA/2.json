{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":2,"content":[{"type":"heading","content":["上帝所揀選的君王"]},{"type":"verse","number":1,"content":[{"text":"外邦為甚麼爭鬧？","poem":1},{"lineBreak":true},{"text":"萬民為甚麼謀算虛妄的事？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"世上的君王一齊起來，","poem":1},{"lineBreak":true},{"text":"臣宰一同商議，","poem":1},{"lineBreak":true},{"text":"要敵擋耶和華並他的受膏者，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"說：我們要掙開他們的捆綁，","poem":1},{"lineBreak":true},{"text":"脫去他們的繩索。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"那坐在天上的必發笑；","poem":1},{"lineBreak":true},{"text":"主必嗤笑他們。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"那時，他要在怒中責備他們，","poem":1},{"lineBreak":true},{"text":"在烈怒中驚嚇他們，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"說：我已經立我的君","poem":1},{"lineBreak":true},{"text":"在錫安－我的聖山上了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"受膏者說：我要傳聖旨。","poem":1},{"lineBreak":true},{"text":"耶和華曾對我說：你是我的兒子，","poem":1},{"lineBreak":true},{"text":"我今日生你。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你求我，我就將列國賜你為基業，","poem":1},{"lineBreak":true},{"text":"將地極賜你為田產。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你必用鐵杖打破他們；","poem":1},{"lineBreak":true},{"text":"你必將他們如同窯匠的瓦器摔碎。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"現在，你們君王應當省悟！","poem":1},{"lineBreak":true},{"text":"你們世上的審判官該受管教！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"當存畏懼事奉耶和華，","poem":1},{"lineBreak":true},{"text":"又當存戰兢而快樂。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"當以嘴親子，恐怕他發怒，","poem":1},{"lineBreak":true},{"text":"你們便在道中滅亡，","poem":1},{"lineBreak":true},{"text":"因為他的怒氣快要發作。","poem":1},{"lineBreak":true},{"text":"凡投靠他的，都是有福的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}