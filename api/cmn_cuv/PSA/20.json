{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":20,"content":[{"type":"heading","content":["祈求勝利"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"願耶和華在你遭難的日子應允你；","poem":1},{"lineBreak":true},{"text":"願名為雅各上帝的高舉你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願他從聖所救助你，","poem":1},{"lineBreak":true},{"text":"從錫安堅固你，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"記念你的一切供獻，","poem":1},{"lineBreak":true},{"text":"悅納你的燔祭，（細拉）","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"將你心所願的賜給你，","poem":1},{"lineBreak":true},{"text":"成就你的一切籌算。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我們要因你的救恩誇勝，","poem":1},{"lineBreak":true},{"text":"要奉我們上帝的名豎立旌旗。","poem":1},{"lineBreak":true},{"text":"願耶和華成就你一切所求的！","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"現在我知道耶和華救護他的受膏者，","poem":1},{"lineBreak":true},{"text":"必從他的聖天上應允他，","poem":1},{"lineBreak":true},{"text":"用右手的能力救護他。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"有人靠車，有人靠馬，","poem":1},{"lineBreak":true},{"text":"但我們要提到耶和華－我們上帝的名。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們都屈身仆倒，","poem":1},{"lineBreak":true},{"text":"我們卻起來，立得正直。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"求耶和華施行拯救；","poem":1},{"lineBreak":true},{"text":"我們呼求的時候，願王應允我們！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}