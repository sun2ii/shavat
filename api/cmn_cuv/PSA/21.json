{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":21,"content":[{"type":"heading","content":["為勝利而歌頌"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，王必因你的能力歡喜；","poem":1},{"lineBreak":true},{"text":"因你的救恩，他的快樂何其大！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他心裏所願的，你已經賜給他；","poem":1},{"lineBreak":true},{"text":"他嘴唇所求的，你未嘗不應允。（細拉）","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你以美福迎接他，","poem":1},{"lineBreak":true},{"text":"把精金的冠冕戴在他頭上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他向你求壽，你便賜給他，","poem":1},{"lineBreak":true},{"text":"就是日子長久，直到永遠。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他因你的救恩大有榮耀；","poem":1},{"lineBreak":true},{"text":"你又將尊榮威嚴加在他身上。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你使他有洪福，直到永遠，","poem":1},{"lineBreak":true},{"text":"又使他在你面前歡喜快樂。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"王倚靠耶和華，","poem":1},{"lineBreak":true},{"text":"因至高者的慈愛必不搖動。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你的手要搜出你的一切仇敵；","poem":1},{"lineBreak":true},{"text":"你的右手要搜出那些恨你的人。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你發怒的時候，要使他們如在炎熱的火爐中。","poem":1},{"lineBreak":true},{"text":"耶和華要在他的震怒中吞滅他們；","poem":1},{"lineBreak":true},{"text":"那火要把他們燒盡了。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你必從世上滅絕他們的子孫","poem":1},{"noteId":9},{"text":"，","poem":1},{"lineBreak":true},{"text":"從人間滅絕他們的後裔。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因為他們有意加害於你；","poem":1},{"lineBreak":true},{"text":"他們想出計謀，卻不能做成。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你必使他們轉背逃跑，","poem":1},{"lineBreak":true},{"text":"向他們的臉搭箭在弦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和華啊，願你因自己的能力顯為至高！","poem":1},{"lineBreak":true},{"text":"這樣，我們就唱詩，歌頌你的大能。","poem":1}]}],"footnotes":[{"noteId":9,"caller":"-","text":"原文是果子","reference":{"chapter":21,"verse":10}}]},"thisChapterLink":"/api/cmn_cuv/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}