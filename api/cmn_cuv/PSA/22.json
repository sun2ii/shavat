{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":22,"content":[{"type":"heading","content":["痛苦中的禱告和讚美"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。調用朝鹿。"]},{"type":"verse","number":1,"content":[{"text":"我的上帝，我的上帝！為甚麼離棄我？","poem":1},{"lineBreak":true},{"text":"為甚麼遠離不救我？不聽我唉哼的言語？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的上帝啊，我白日呼求，你不應允，","poem":1},{"lineBreak":true},{"text":"夜間呼求，並不住聲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"但你是聖潔的，","poem":1},{"lineBreak":true},{"text":"是用以色列的讚美為寶座","poem":1},{"noteId":10},{"text":"的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我們的祖宗倚靠你；","poem":1},{"lineBreak":true},{"text":"他們倚靠你，你便解救他們。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們哀求你，便蒙解救；","poem":1},{"lineBreak":true},{"text":"他們倚靠你，就不羞愧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"但我是蟲，不是人，","poem":1},{"lineBreak":true},{"text":"被眾人羞辱，被百姓藐視。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"凡看見我的都嗤笑我；","poem":1},{"lineBreak":true},{"text":"他們撇嘴搖頭，說：","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他把自己交託耶和華，耶和華可以救他吧！","poem":1},{"lineBreak":true},{"text":"耶和華既喜悅他，可以搭救他吧！","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"但你是叫我出母腹的；","poem":1},{"lineBreak":true},{"text":"我在母懷裏，你就使我有倚靠的心。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我自出母胎就被交在你手裏；","poem":1},{"lineBreak":true},{"text":"從我母親生我，你就是我的上帝。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你不要遠離我！","poem":1},{"lineBreak":true},{"text":"因為急難臨近了，沒有人幫助我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"有許多公牛圍繞我，","poem":1},{"lineBreak":true},{"text":"巴珊大力的公牛四面困住我。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"牠們向我張口，","poem":1},{"lineBreak":true},{"text":"好像抓撕吼叫的獅子。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"我如水被倒出來；","poem":1},{"lineBreak":true},{"text":"我的骨頭都脫了節；","poem":1},{"lineBreak":true},{"text":"我心在我裏面如蠟鎔化。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的精力枯乾，如同瓦片；","poem":1},{"lineBreak":true},{"text":"我的舌頭貼在我牙床上。","poem":1},{"lineBreak":true},{"text":"你將我安置在死地的塵土中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"犬類圍着我，惡黨環繞我；","poem":1},{"lineBreak":true},{"text":"他們扎了我的手，我的腳。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的骨頭，我都能數過；","poem":1},{"lineBreak":true},{"text":"他們瞪着眼看我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他們分我的外衣，","poem":1},{"lineBreak":true},{"text":"為我的裏衣拈鬮。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和華啊，求你不要遠離我！","poem":1},{"lineBreak":true},{"text":"我的救主啊，求你快來幫助我！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"求你救我的靈魂脫離刀劍，","poem":1},{"lineBreak":true},{"text":"救我的生命","poem":1},{"noteId":11},{"text":"脫離犬類，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"救我脫離獅子的口；","poem":1},{"lineBreak":true},{"text":"你已經應允我，使我脫離野牛的角。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"我要將你的名傳與我的弟兄，","poem":1},{"lineBreak":true},{"text":"在會中我要讚美你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"你們敬畏耶和華的人要讚美他！","poem":1},{"lineBreak":true},{"text":"雅各的後裔都要榮耀他！","poem":1},{"lineBreak":true},{"text":"以色列的後裔都要懼怕他！","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"因為他沒有藐視憎惡受苦的人，","poem":1},{"lineBreak":true},{"text":"也沒有向他掩面；","poem":1},{"lineBreak":true},{"text":"那受苦之人呼籲的時候，他就垂聽。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"我在大會中讚美你的話是從你而來的；","poem":1},{"lineBreak":true},{"text":"我要在敬畏耶和華的人面前還我的願。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"謙卑的人必吃得飽足；","poem":1},{"lineBreak":true},{"text":"尋求耶和華的人必讚美他。","poem":1},{"lineBreak":true},{"text":"願你們的心永遠活着！","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"地的四極都要想念耶和華，並且歸順他；","poem":1},{"lineBreak":true},{"text":"列國的萬族都要在你面前敬拜。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"因為國權是耶和華的；","poem":1},{"lineBreak":true},{"text":"他是管理萬國的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"地上一切豐肥的人必吃喝而敬拜；","poem":1},{"lineBreak":true},{"text":"凡下到塵土中－不能存活自己性命的人","poem":1},{"lineBreak":true},{"text":"－都要在他面前下拜。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他必有後裔事奉他；","poem":1},{"lineBreak":true},{"text":"主所行的事必傳與後代。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"他們必來把他的公義傳給將要生的民，","poem":1},{"lineBreak":true},{"text":"言明這事是他所行的。","poem":1}]}],"footnotes":[{"noteId":10,"caller":"-","text":"或譯：居所","reference":{"chapter":22,"verse":3}},{"noteId":11,"caller":"-","text":"生命：原文是獨一者","reference":{"chapter":22,"verse":20}}]},"thisChapterLink":"/api/cmn_cuv/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}