{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":23,"content":[{"type":"heading","content":["耶和華是我牧者"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華是我的牧者，","poem":1},{"lineBreak":true},{"text":"我必不致缺乏。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他使我躺臥在青草地上，","poem":1},{"lineBreak":true},{"text":"領我在可安歇的水邊。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他使我的靈魂甦醒，","poem":1},{"lineBreak":true},{"text":"為自己的名引導我走義路。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我雖然行過死蔭的幽谷，","poem":1},{"lineBreak":true},{"text":"也不怕遭害，","poem":1},{"lineBreak":true},{"text":"因為你與我同在；","poem":1},{"lineBreak":true},{"text":"你的杖，你的竿，都安慰我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"在我敵人面前，你為我擺設筵席；","poem":1},{"lineBreak":true},{"text":"你用油膏了我的頭，使我的福杯滿溢。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我一生一世必有恩惠慈愛隨着我；","poem":1},{"lineBreak":true},{"text":"我且要住在耶和華的殿中，直到永遠。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}