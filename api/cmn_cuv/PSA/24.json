{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":24,"content":[{"type":"heading","content":["偉大的君王"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"地和其中所充滿的，","poem":1},{"lineBreak":true},{"text":"世界和住在其間的，都屬耶和華。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他把地建立在海上，","poem":1},{"lineBreak":true},{"text":"安定在大水之上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"誰能登耶和華的山？","poem":1},{"lineBreak":true},{"text":"誰能站在他的聖所？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"就是手潔心清，不向虛妄，","poem":1},{"lineBreak":true},{"text":"起誓不懷詭詐的人。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他必蒙耶和華賜福，","poem":1},{"lineBreak":true},{"text":"又蒙救他的上帝使他成義。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"這是尋求耶和華的族類，","poem":1},{"lineBreak":true},{"text":"是尋求你面的雅各。 （細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"眾城門哪，你們要抬起頭來！","poem":1},{"lineBreak":true},{"text":"永久的門戶，你們要被舉起！","poem":1},{"lineBreak":true},{"text":"那榮耀的王將要進來！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"榮耀的王是誰呢？","poem":1},{"lineBreak":true},{"text":"就是有力有能的耶和華，","poem":1},{"lineBreak":true},{"text":"在戰場上有能的耶和華！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"眾城門哪，你們要抬起頭來！","poem":1},{"lineBreak":true},{"text":"永久的門戶，你們要把頭抬起！","poem":1},{"lineBreak":true},{"text":"那榮耀的王將要進來！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"榮耀的王是誰呢？","poem":1},{"lineBreak":true},{"text":"萬軍之耶和華，","poem":1},{"lineBreak":true},{"text":"他是榮耀的王！（細拉）","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}