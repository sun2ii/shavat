{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":25,"content":[{"type":"heading","content":["求主指引保護"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我的心仰望你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的上帝啊，我素來倚靠你；","poem":1},{"lineBreak":true},{"text":"求你不要叫我羞愧，","poem":1},{"lineBreak":true},{"text":"不要叫我的仇敵向我誇勝。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"凡等候你的必不羞愧；","poem":1},{"lineBreak":true},{"text":"惟有那無故行奸詐的必要羞愧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華啊，求你將你的道指示我，","poem":1},{"lineBreak":true},{"text":"將你的路教訓我！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"求你以你的真理引導我，教訓我，","poem":1},{"lineBreak":true},{"text":"因為你是救我的上帝。","poem":1},{"lineBreak":true},{"text":"我終日等候你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和華啊，求你記念你的憐憫和慈愛，","poem":1},{"lineBreak":true},{"text":"因為這是亙古以來所常有的。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你不要記念我幼年的罪愆和我的過犯；","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你因你的恩惠，按你的慈愛記念我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和華是良善正直的，","poem":1},{"lineBreak":true},{"text":"所以他必指示罪人走正路。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他必按公平引領謙卑人，","poem":1},{"lineBreak":true},{"text":"將他的道教訓他們。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"凡遵守他的約和他法度的人，","poem":1},{"lineBreak":true},{"text":"耶和華都以慈愛誠實待他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和華啊，求你因你的名赦免我的罪，","poem":1},{"lineBreak":true},{"text":"因為我的罪重大。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"誰敬畏耶和華，","poem":1},{"lineBreak":true},{"text":"耶和華必指示他當選擇的道路。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他必安然居住；","poem":1},{"lineBreak":true},{"text":"他的後裔必承受地土。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華與敬畏他的人親密；","poem":1},{"lineBreak":true},{"text":"他必將自己的約指示他們。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的眼目時常仰望耶和華，","poem":1},{"lineBreak":true},{"text":"因為他必將我的腳從網裏拉出來。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"求你轉向我，憐恤我，","poem":1},{"lineBreak":true},{"text":"因為我是孤獨困苦。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我心裏的愁苦甚多，","poem":1},{"lineBreak":true},{"text":"求你救我脫離我的禍患。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你看顧我的困苦，我的艱難，","poem":1},{"lineBreak":true},{"text":"赦免我一切的罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"求你察看我的仇敵，","poem":1},{"lineBreak":true},{"text":"因為他們人多，並且痛痛地恨我。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"求你保護我的性命，搭救我，","poem":1},{"lineBreak":true},{"text":"使我不致羞愧，因為我投靠你。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"願純全、正直保守我，","poem":1},{"lineBreak":true},{"text":"因為我等候你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"上帝啊，求你救贖以色列脫離他一切的愁苦。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}