{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":26,"content":[{"type":"heading","content":["義人的祈禱"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你為我伸冤，","poem":1},{"lineBreak":true},{"text":"因我向來行事純全；","poem":1},{"lineBreak":true},{"text":"我又倚靠耶和華，並不搖動。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華啊，求你察看我，試驗我，","poem":1},{"lineBreak":true},{"text":"熬煉我的肺腑心腸。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為你的慈愛常在我眼前，","poem":1},{"lineBreak":true},{"text":"我也按你的真理而行。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我沒有和虛謊人同坐，","poem":1},{"lineBreak":true},{"text":"也不與瞞哄人的同群。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我恨惡惡人的會，","poem":1},{"lineBreak":true},{"text":"必不與惡人同坐。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和華啊，我要洗手表明無辜，","poem":1},{"lineBreak":true},{"text":"才環繞你的祭壇；","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我好發稱謝的聲音，","poem":1},{"lineBreak":true},{"text":"也要述說你一切奇妙的作為。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和華啊，我喜愛你所住的殿","poem":1},{"lineBreak":true},{"text":"和你顯榮耀的居所。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"不要把我的靈魂和罪人一同除掉；","poem":1},{"lineBreak":true},{"text":"不要把我的性命和流人血的一同除掉。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們的手中有奸惡，","poem":1},{"lineBreak":true},{"text":"右手滿有賄賂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"至於我，卻要行事純全；","poem":1},{"lineBreak":true},{"text":"求你救贖我，憐恤我！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我的腳站在平坦地方；","poem":1},{"lineBreak":true},{"text":"在眾會中我要稱頌耶和華！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}