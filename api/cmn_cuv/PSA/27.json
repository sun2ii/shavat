{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":27,"content":[{"type":"heading","content":["讚美的禱告"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華是我的亮光，是我的拯救，","poem":1},{"lineBreak":true},{"text":"我還怕誰呢？","poem":1},{"lineBreak":true},{"text":"耶和華是我性命的保障","poem":1},{"noteId":12},{"text":"，","poem":1},{"lineBreak":true},{"text":"我還懼誰呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"那作惡的就是我的仇敵，","poem":1},{"lineBreak":true},{"text":"前來吃我肉的時候就絆跌仆倒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"雖有軍兵安營攻擊我，我的心也不害怕；","poem":1},{"lineBreak":true},{"text":"雖然興起刀兵攻擊我，我必仍舊安穩。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"有一件事，我曾求耶和華，我仍要尋求：","poem":1},{"lineBreak":true},{"text":"就是一生一世住在耶和華的殿中，","poem":1},{"lineBreak":true},{"text":"瞻仰他的榮美，在他的殿裏求問。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"因為我遭遇患難，他必暗暗地保守我；","poem":1},{"lineBreak":true},{"text":"在他亭子裏，把我藏在他帳幕的隱密處，","poem":1},{"lineBreak":true},{"text":"將我高舉在磐石上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"現在我得以昂首，高過四面的仇敵。","poem":1},{"lineBreak":true},{"text":"我要在他的帳幕裏歡然獻祭；","poem":1},{"lineBreak":true},{"text":"我要唱詩歌頌耶和華。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和華啊，我用聲音呼籲的時候，求你垂聽；","poem":1},{"lineBreak":true},{"text":"並求你憐恤我，應允我。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你說：你們當尋求我的面。","poem":1},{"lineBreak":true},{"text":"那時我心向你說：耶和華啊，","poem":1},{"lineBreak":true},{"text":"你的面我正要尋求。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"不要向我掩面。","poem":1},{"lineBreak":true},{"text":"不要發怒趕逐僕人，","poem":1},{"lineBreak":true},{"text":"你向來是幫助我的。","poem":1},{"lineBreak":true},{"text":"救我的上帝啊，不要丟掉我，","poem":1},{"lineBreak":true},{"text":"也不要離棄我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我父母離棄我，","poem":1},{"lineBreak":true},{"text":"耶和華必收留我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"耶和華啊，求你將你的道指教我，","poem":1},{"lineBreak":true},{"text":"因我仇敵的緣故引導我走平坦的路。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你不要把我交給敵人，遂其所願；","poem":1},{"lineBreak":true},{"text":"因為妄作見證的和口吐凶言的，起來攻擊我。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我若不信在活人之地得見耶和華的恩惠，","poem":1},{"lineBreak":true},{"text":"就早已喪膽了。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"要等候耶和華！","poem":1},{"lineBreak":true},{"text":"當壯膽，堅固你的心！","poem":1},{"lineBreak":true},{"text":"我再說，要等候耶和華！","poem":1}]}],"footnotes":[{"noteId":12,"caller":"-","text":"或譯：力量","reference":{"chapter":27,"verse":1}}]},"thisChapterLink":"/api/cmn_cuv/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}