{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":28,"content":[{"type":"heading","content":["求主幫助"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我要求告你！","poem":1},{"lineBreak":true},{"text":"我的磐石啊，不要向我緘默！","poem":1},{"lineBreak":true},{"text":"倘若你向我閉口，","poem":1},{"lineBreak":true},{"text":"我就如將死的人一樣。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我呼求你，向你至聖所舉手的時候，","poem":1},{"lineBreak":true},{"text":"求你垂聽我懇求的聲音！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"不要把我和惡人並作孽的一同除掉；","poem":1},{"lineBreak":true},{"text":"他們與鄰舍說和平話，心裏卻是奸惡。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"願你按着他們所做的，","poem":1},{"lineBreak":true},{"text":"並他們所行的惡事待他們。","poem":1},{"lineBreak":true},{"text":"願你照着他們手所做的待他們，","poem":1},{"lineBreak":true},{"text":"將他們所應得的報應加給他們。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們既然不留心耶和華所行的和他手所做的，","poem":1},{"lineBreak":true},{"text":"他就必毀壞他們，不建立他們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和華是應當稱頌的，","poem":1},{"lineBreak":true},{"text":"因為他聽了我懇求的聲音。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華是我的力量，是我的盾牌；","poem":1},{"lineBreak":true},{"text":"我心裏倚靠他就得幫助。","poem":1},{"lineBreak":true},{"text":"所以我心中歡樂，","poem":1},{"lineBreak":true},{"text":"我必用詩歌頌讚他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和華是他百姓的力量，","poem":1},{"lineBreak":true},{"text":"又是他受膏者得救的保障。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你拯救你的百姓，賜福給你的產業，","poem":1},{"lineBreak":true},{"text":"牧養他們，扶持他們，直到永遠。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}