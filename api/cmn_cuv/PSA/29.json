{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":29,"content":[{"type":"heading","content":["在暴風雨中耶和華的威聲"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝的眾子啊，你們要將榮耀、能力歸給耶和華，","poem":1},{"lineBreak":true},{"text":"歸給耶和華！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要將耶和華的名所當得的榮耀歸給他，","poem":1},{"lineBreak":true},{"text":"以聖潔的","poem":1},{"noteId":13},{"text":"妝飾敬拜耶和華。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和華的聲音發在水上；","poem":1},{"lineBreak":true},{"text":"榮耀的上帝打雷，","poem":1},{"lineBreak":true},{"text":"耶和華打雷在大水之上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華的聲音大有能力；","poem":1},{"lineBreak":true},{"text":"耶和華的聲音滿有威嚴。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和華的聲音震破香柏樹；","poem":1},{"lineBreak":true},{"text":"耶和華震碎黎巴嫩的香柏樹。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他也使之跳躍如牛犢，","poem":1},{"lineBreak":true},{"text":"使黎巴嫩和西連跳躍如野牛犢。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"耶和華的聲音使火焰分岔。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華的聲音震動曠野；","poem":1},{"lineBreak":true},{"text":"耶和華震動加低斯的曠野。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和華的聲音驚動母鹿落胎，","poem":1},{"lineBreak":true},{"text":"樹木也脫落淨光。","poem":1},{"lineBreak":true},{"text":"凡在他殿中的，都稱說他的榮耀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"洪水泛濫之時，耶和華坐着為王；","poem":1},{"lineBreak":true},{"text":"耶和華坐着為王，直到永遠。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華必賜力量給他的百姓；","poem":1},{"lineBreak":true},{"text":"耶和華必賜平安的福給他的百姓。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"的：或譯為","reference":{"chapter":29,"verse":2}}]},"thisChapterLink":"/api/cmn_cuv/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}