{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["大衛逃避他兒子押沙龍的時候作的詩。"]},{"type":"heading","content":["求助的晨禱"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我的敵人何其加增；","poem":1},{"lineBreak":true},{"text":"有許多人起來攻擊我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"有許多人議論我說：","poem":1},{"lineBreak":true},{"text":"他得不着上帝的幫助。 （細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"但你－耶和華是我四圍的盾牌，","poem":1},{"lineBreak":true},{"text":"是我的榮耀，又是叫我抬起頭來的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我用我的聲音求告耶和華，","poem":1},{"lineBreak":true},{"text":"他就從他的聖山上應允我。 （細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我躺下睡覺，我醒着，","poem":1},{"lineBreak":true},{"text":"耶和華都保佑我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"雖有成萬的百姓來周圍攻擊我，","poem":1},{"lineBreak":true},{"text":"我也不怕。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華啊，求你起來！","poem":1},{"lineBreak":true},{"text":"我的上帝啊，求你救我！","poem":1},{"lineBreak":true},{"text":"因為你打了我一切仇敵的腮骨，","poem":1},{"lineBreak":true},{"text":"敲碎了惡人的牙齒。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"救恩屬乎耶和華；","poem":1},{"lineBreak":true},{"text":"願你賜福給你的百姓。（細拉）","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}