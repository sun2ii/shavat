{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":30,"content":[{"type":"heading","content":["感恩的禱告"]},{"type":"hebrew_subtitle","content":["大衛在獻殿的時候，作這詩歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我要尊崇你，","poem":1},{"lineBreak":true},{"text":"因為你曾提拔我，不叫仇敵向我誇耀。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華－我的上帝啊，","poem":1},{"lineBreak":true},{"text":"我曾呼求你，你醫治了我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華啊，你曾把我的靈魂從陰間救上來，","poem":1},{"lineBreak":true},{"text":"使我存活，不至於下坑。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華的聖民哪，你們要歌頌他，","poem":1},{"lineBreak":true},{"text":"稱讚他可記念的聖名。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因為，他的怒氣不過是轉眼之間；","poem":1},{"lineBreak":true},{"text":"他的恩典乃是一生之久。","poem":1},{"lineBreak":true},{"text":"一宿雖然有哭泣，","poem":1},{"lineBreak":true},{"text":"早晨便必歡呼。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"至於我，我凡事平順，便說：","poem":1},{"lineBreak":true},{"text":"我永不動搖。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華啊，你曾施恩，叫我的江山穩固；","poem":1},{"lineBreak":true},{"text":"你掩了面，我就驚惶。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和華啊，我曾求告你；","poem":1},{"lineBreak":true},{"text":"我向耶和華懇求，說：","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我被害流血，下到坑中，有甚麼益處呢？","poem":1},{"lineBreak":true},{"text":"塵土豈能稱讚你，傳說你的誠實嗎？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華啊，求你應允我，憐恤我！","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你幫助我！","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"你已將我的哀哭變為跳舞，","poem":1},{"lineBreak":true},{"text":"將我的麻衣脫去，給我披上喜樂，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"好叫我的靈","poem":1},{"noteId":14},{"text":"歌頌你，並不住聲。","poem":1},{"lineBreak":true},{"text":"耶和華－我的上帝啊，我要稱謝你，直到永遠！","poem":1}]}],"footnotes":[{"noteId":14,"caller":"-","text":"原文是榮耀","reference":{"chapter":30,"verse":12}}]},"thisChapterLink":"/api/cmn_cuv/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}