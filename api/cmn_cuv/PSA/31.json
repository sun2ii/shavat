{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":31,"content":[{"type":"heading","content":["信靠上帝的祈禱"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我投靠你；","poem":1},{"lineBreak":true},{"text":"求你使我永不羞愧；","poem":1},{"lineBreak":true},{"text":"憑你的公義搭救我！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你側耳而聽，","poem":1},{"lineBreak":true},{"text":"快快救我！","poem":1},{"lineBreak":true},{"text":"作我堅固的磐石，","poem":1},{"lineBreak":true},{"text":"拯救我的保障！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因為你是我的巖石，我的山寨；","poem":1},{"lineBreak":true},{"text":"所以，求你為你名的緣故引導我，指點我。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"求你救我脫離人為我暗設的網羅，","poem":1},{"lineBreak":true},{"text":"因為你是我的保障。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我將我的靈魂交在你手裏；","poem":1},{"lineBreak":true},{"text":"耶和華誠實的上帝啊，你救贖了我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我恨惡那信奉虛無之神的人；","poem":1},{"lineBreak":true},{"text":"我卻倚靠耶和華。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我要為你的慈愛高興歡喜；","poem":1},{"lineBreak":true},{"text":"因為你見過我的困苦，知道我心中的艱難。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你未曾把我交在仇敵手裏；","poem":1},{"lineBreak":true},{"text":"你使我的腳站在寬闊之處。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和華啊，求你憐恤我，","poem":1},{"lineBreak":true},{"text":"因為我在急難之中；","poem":1},{"lineBreak":true},{"text":"我的眼睛因憂愁而乾癟，","poem":1},{"lineBreak":true},{"text":"連我的身心也不安舒。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的生命為愁苦所消耗；","poem":1},{"lineBreak":true},{"text":"我的年歲為歎息所曠廢。","poem":1},{"lineBreak":true},{"text":"我的力量因我的罪孽衰敗；","poem":1},{"lineBreak":true},{"text":"我的骨頭也枯乾。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我因一切敵人成了羞辱，","poem":1},{"lineBreak":true},{"text":"在我的鄰舍跟前更甚；","poem":1},{"lineBreak":true},{"text":"那認識我的都懼怕我，","poem":1},{"lineBreak":true},{"text":"在外頭看見我的都躲避我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我被人忘記，如同死人，無人記念；","poem":1},{"lineBreak":true},{"text":"我好像破碎的器皿。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我聽見了許多人的讒謗，","poem":1},{"lineBreak":true},{"text":"四圍都是驚嚇；","poem":1},{"lineBreak":true},{"text":"他們一同商議攻擊我的時候，","poem":1},{"lineBreak":true},{"text":"就圖謀要害我的性命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"耶和華啊，我仍舊倚靠你；","poem":1},{"lineBreak":true},{"text":"我說：你是我的上帝。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我終身的事在你手中；","poem":1},{"lineBreak":true},{"text":"求你救我脫離仇敵的手和那些逼迫我的人。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"求你使你的臉光照僕人，","poem":1},{"lineBreak":true},{"text":"憑你的慈愛拯救我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"耶和華啊，求你叫我不致羞愧，","poem":1},{"lineBreak":true},{"text":"因為我曾呼籲你；","poem":1},{"lineBreak":true},{"text":"求你使惡人羞愧，","poem":1},{"lineBreak":true},{"text":"使他們在陰間緘默無聲。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"那撒謊的人逞驕傲輕慢，","poem":1},{"lineBreak":true},{"text":"出狂妄的話攻擊義人；","poem":1},{"lineBreak":true},{"text":"願他的嘴啞而無言。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"敬畏你、投靠你的人，你為他們所積存的，","poem":1},{"lineBreak":true},{"text":"在世人面前所施行的恩惠是何等大呢！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你必把他們藏在你面前的隱密處，","poem":1},{"lineBreak":true},{"text":"免得遇見人的計謀；","poem":1},{"lineBreak":true},{"text":"你必暗暗地保守他們在亭子裏，","poem":1},{"lineBreak":true},{"text":"免受口舌的爭鬧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"耶和華是應當稱頌的，","poem":1},{"lineBreak":true},{"text":"因為他在堅固城裏向我施展奇妙的慈愛。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"至於我，我曾急促地說：","poem":1},{"lineBreak":true},{"text":"我從你眼前被隔絕。","poem":1},{"lineBreak":true},{"text":"然而，我呼求你的時候，","poem":1},{"lineBreak":true},{"text":"你仍聽我懇求的聲音。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"耶和華的聖民哪，你們都要愛他！","poem":1},{"lineBreak":true},{"text":"耶和華保護誠實人，","poem":1},{"lineBreak":true},{"text":"足足報應行事驕傲的人。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"凡仰望耶和華的人，","poem":1},{"lineBreak":true},{"text":"你們都要壯膽，堅固你們的心！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}