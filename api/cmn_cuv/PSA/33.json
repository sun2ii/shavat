{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":33,"content":[{"type":"heading","content":["頌讚之歌"]},{"type":"verse","number":1,"content":[{"text":"義人哪，你們應當靠耶和華歡樂；","poem":1},{"lineBreak":true},{"text":"正直人的讚美是合宜的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你們應當彈琴稱謝耶和華，","poem":1},{"lineBreak":true},{"text":"用十弦瑟歌頌他。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"應當向他唱新歌，","poem":1},{"lineBreak":true},{"text":"彈得巧妙，聲音洪亮。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"因為耶和華的言語正直；","poem":1},{"lineBreak":true},{"text":"凡他所做的盡都誠實。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他喜愛仁義公平；","poem":1},{"lineBreak":true},{"text":"遍地滿了耶和華的慈愛。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"諸天藉耶和華的命而造；","poem":1},{"lineBreak":true},{"text":"萬象藉他口中的氣而成。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他聚集海水如壘，","poem":1},{"lineBreak":true},{"text":"收藏深洋在庫房。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"願全地都敬畏耶和華！","poem":1},{"lineBreak":true},{"text":"願世上的居民都懼怕他！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為他說有，就有，","poem":1},{"lineBreak":true},{"text":"命立，就立。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華使列國的籌算歸於無有，","poem":1},{"lineBreak":true},{"text":"使眾民的思念無有功效。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華的籌算永遠立定；","poem":1},{"lineBreak":true},{"text":"他心中的思念萬代常存。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"以耶和華為上帝的，那國是有福的！","poem":1},{"lineBreak":true},{"text":"他所揀選為自己產業的，那民是有福的！","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和華從天上觀看；","poem":1},{"lineBreak":true},{"text":"他看見一切的世人。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"從他的居所往外察看地上一切的居民－","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他是那造成他們眾人心的，","poem":1},{"lineBreak":true},{"text":"留意他們一切作為的。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"君王不能因兵多得勝；","poem":1},{"lineBreak":true},{"text":"勇士不能因力大得救。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"靠馬得救是枉然的；","poem":1},{"lineBreak":true},{"text":"馬也不能因力大救人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"耶和華的眼目看顧敬畏他的人","poem":1},{"lineBreak":true},{"text":"和仰望他慈愛的人，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"要救他們的命脫離死亡，","poem":1},{"lineBreak":true},{"text":"並使他們在饑荒中存活。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"我們的心向來等候耶和華；","poem":1},{"lineBreak":true},{"text":"他是我們的幫助，我們的盾牌。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"我們的心必靠他歡喜，","poem":1},{"lineBreak":true},{"text":"因為我們向來倚靠他的聖名。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和華啊，求你照着我們所仰望你的，","poem":1},{"lineBreak":true},{"text":"向我們施行慈愛！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}