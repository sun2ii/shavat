{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":34,"content":[{"type":"heading","content":["頌讚上帝的美善"]},{"type":"hebrew_subtitle","content":["大衛在亞比米勒面前裝瘋，被他趕出去，就作這詩。"]},{"type":"verse","number":1,"content":[{"text":"我要時時稱頌耶和華；","poem":1},{"lineBreak":true},{"text":"讚美他的話必常在我口中。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的心必因耶和華誇耀；","poem":1},{"lineBreak":true},{"text":"謙卑人聽見就要喜樂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你們和我當稱耶和華為大，","poem":1},{"lineBreak":true},{"text":"一同高舉他的名。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我曾尋求耶和華，他就應允我，","poem":1},{"lineBreak":true},{"text":"救我脫離了一切的恐懼。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"凡仰望他的，便有光榮；","poem":1},{"lineBreak":true},{"text":"他們的臉必不蒙羞。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我這困苦人呼求，耶和華便垂聽，","poem":1},{"lineBreak":true},{"text":"救我脫離一切患難。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華的使者在敬畏他的人四圍安營，","poem":1},{"lineBreak":true},{"text":"搭救他們。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你們要嘗嘗主恩的滋味，便知道他是美善；","poem":1},{"lineBreak":true},{"text":"投靠他的人有福了！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華的聖民哪，你們當敬畏他，","poem":1},{"lineBreak":true},{"text":"因敬畏他的一無所缺。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"少壯獅子還缺食忍餓，","poem":1},{"lineBreak":true},{"text":"但尋求耶和華的甚麼好處都不缺。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"眾弟子啊，你們當來聽我的話！","poem":1},{"lineBreak":true},{"text":"我要將敬畏耶和華的道教訓你們。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"有何人喜好存活，","poem":1},{"lineBreak":true},{"text":"愛慕長壽，得享美福，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"就要禁止舌頭不出惡言，","poem":1},{"lineBreak":true},{"text":"嘴唇不說詭詐的話。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"要離惡行善，","poem":1},{"lineBreak":true},{"text":"尋求和睦，一心追趕。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"耶和華的眼目看顧義人；","poem":1},{"lineBreak":true},{"text":"他的耳朵聽他們的呼求。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華向行惡的人變臉，","poem":1},{"lineBreak":true},{"text":"要從世上除滅他們的名號。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"義人呼求，耶和華聽見了，","poem":1},{"lineBreak":true},{"text":"便救他們脫離一切患難。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"耶和華靠近傷心的人，","poem":1},{"lineBreak":true},{"text":"拯救靈性痛悔的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"義人多有苦難，","poem":1},{"lineBreak":true},{"text":"但耶和華救他脫離這一切，","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"又保全他一身的骨頭，","poem":1},{"lineBreak":true},{"text":"連一根也不折斷。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"惡必害死惡人；","poem":1},{"lineBreak":true},{"text":"恨惡義人的，必被定罪。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"耶和華救贖他僕人的靈魂；","poem":1},{"lineBreak":true},{"text":"凡投靠他的，必不致定罪。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}