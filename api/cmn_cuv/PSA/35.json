{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":35,"content":[{"type":"heading","content":["求助的禱告"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，與我相爭的，求你與他們相爭！","poem":1},{"lineBreak":true},{"text":"與我相戰的，求你與他們相戰！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"拿着大小的盾牌，","poem":1},{"lineBreak":true},{"text":"起來幫助我。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"抽出槍來，擋住那追趕我的；","poem":1},{"lineBreak":true},{"text":"求你對我的靈魂說：我是拯救你的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"願那尋索我命的，蒙羞受辱！","poem":1},{"lineBreak":true},{"text":"願那謀害我的，退後羞愧！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"願他們像風前的糠，","poem":1},{"lineBreak":true},{"text":"有耶和華的使者趕逐他們。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"願他們的道路又暗又滑，","poem":1},{"lineBreak":true},{"text":"有耶和華的使者追趕他們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"因他們無故地為我暗設網羅，","poem":1},{"lineBreak":true},{"text":"無故地挖坑，要害我的性命。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"願災禍忽然臨到他身上！","poem":1},{"lineBreak":true},{"text":"願他暗設的網纏住自己！","poem":1},{"lineBreak":true},{"text":"願他落在其中遭災禍！","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我的心必靠耶和華快樂，","poem":1},{"lineBreak":true},{"text":"靠他的救恩高興。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的骨頭都要說：","poem":1},{"lineBreak":true},{"text":"耶和華啊，誰能像你","poem":1},{"lineBreak":true},{"text":"救護困苦人脫離那比他強壯的，","poem":1},{"lineBreak":true},{"text":"救護困苦窮乏人脫離那搶奪他的？","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"凶惡的見證人起來，","poem":1},{"lineBreak":true},{"text":"盤問我所不知道的事。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們向我以惡報善，","poem":1},{"lineBreak":true},{"text":"使我的靈魂孤苦。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"至於我，當他們有病的時候，","poem":1},{"lineBreak":true},{"text":"我便穿麻衣，禁食，刻苦己心；","poem":1},{"lineBreak":true},{"text":"我所求的都歸到自己的懷中。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我這樣行，好像他是我的朋友，我的弟兄；","poem":1},{"lineBreak":true},{"text":"我屈身悲哀，如同人為母親哀痛。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"我在患難中，他們卻歡喜，大家聚集。","poem":1},{"lineBreak":true},{"text":"我所不認識的那些下流人聚集攻擊我；","poem":1},{"lineBreak":true},{"text":"他們不住地把我撕裂。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他們如同席上好嬉笑的狂妄人向我咬牙。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"主啊，你看着不理要到幾時呢？","poem":1},{"lineBreak":true},{"text":"求你救我的靈魂脫離他們的殘害！","poem":1},{"lineBreak":true},{"text":"救我的生命","poem":1},{"noteId":15},{"text":"脫離少壯獅子！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我在大會中要稱謝你，","poem":1},{"lineBreak":true},{"text":"在眾民中要讚美你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"求你不容那無理與我為仇的向我誇耀！","poem":1},{"lineBreak":true},{"text":"不容那無故恨我的向我擠眼！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"因為他們不說和平話，","poem":1},{"lineBreak":true},{"text":"倒想出詭詐的言語害地上的安靜人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他們大大張口攻擊我，說：","poem":1},{"lineBreak":true},{"text":"阿哈，阿哈，我們的眼已經看見了！","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"耶和華啊，你已經看見了，求你不要閉口！","poem":1},{"lineBreak":true},{"text":"主啊，求你不要遠離我！","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我的上帝我的主啊，求你奮興醒起，","poem":1},{"lineBreak":true},{"text":"判清我的事，伸明我的冤！","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"耶和華－我的上帝啊，求你按你的公義判斷我，","poem":1},{"lineBreak":true},{"text":"不容他們向我誇耀！","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"不容他們心裏說：阿哈，遂我們的心願了！","poem":1},{"lineBreak":true},{"text":"不容他們說：我們已經把他吞了！","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"願那喜歡我遭難的一同抱愧蒙羞！","poem":1},{"lineBreak":true},{"text":"願那向我妄自尊大的披慚愧，蒙羞辱！","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"願那喜悅我冤屈得伸的","poem":1},{"noteId":16},{"text":"歡呼快樂；","poem":1},{"lineBreak":true},{"text":"願他們常說：當尊耶和華為大！","poem":1},{"lineBreak":true},{"text":"耶和華喜悅他的僕人平安。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"我的舌頭要終日論說你的公義，","poem":1},{"lineBreak":true},{"text":"時常讚美你。","poem":1}]}],"footnotes":[{"noteId":15,"caller":"-","text":"生命：原文是獨一者","reference":{"chapter":35,"verse":17}},{"noteId":16,"caller":"-","text":"冤屈得伸：原文是公義","reference":{"chapter":35,"verse":27}}]},"thisChapterLink":"/api/cmn_cuv/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}