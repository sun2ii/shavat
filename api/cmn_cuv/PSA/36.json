{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":36,"content":[{"type":"heading","content":["人的邪惡"]},{"type":"hebrew_subtitle","content":["耶和華的僕人大衛的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"惡人的罪過在他心裏說：","poem":1},{"lineBreak":true},{"text":"我眼中不怕上帝！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他自誇自媚，","poem":1},{"lineBreak":true},{"text":"以為他的罪孽終不顯露，不被恨惡。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他口中的言語盡是罪孽詭詐；","poem":1},{"lineBreak":true},{"text":"他與智慧善行已經斷絕。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他在床上圖謀罪孽，","poem":1},{"lineBreak":true},{"text":"定意行不善的道，不憎惡惡事。","poem":1}]},{"type":"heading","content":["上帝的良善"]},{"type":"verse","number":5,"content":[{"text":"耶和華啊，你的慈愛上及諸天；","poem":1},{"lineBreak":true},{"text":"你的信實達到穹蒼。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你的公義好像高山；","poem":1},{"lineBreak":true},{"text":"你的判斷如同深淵。","poem":1},{"lineBreak":true},{"text":"耶和華啊，人民、牲畜，你都救護。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝啊，你的慈愛何其寶貴！","poem":1},{"lineBreak":true},{"text":"世人投靠在你翅膀的蔭下。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們必因你殿裏的肥甘得以飽足；","poem":1},{"lineBreak":true},{"text":"你也必叫他們喝你樂河的水。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為，在你那裏有生命的源頭；","poem":1},{"lineBreak":true},{"text":"在你的光中，我們必得見光。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"願你常施慈愛給認識你的人，","poem":1},{"lineBreak":true},{"text":"常以公義待心裏正直的人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"不容驕傲人的腳踐踏我；","poem":1},{"lineBreak":true},{"text":"不容凶惡人的手趕逐我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"在那裏，作孽的人已經仆倒；","poem":1},{"lineBreak":true},{"text":"他們被推倒，不能再起來。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}