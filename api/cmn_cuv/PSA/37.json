{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":37,"content":[{"type":"heading","content":["義人和惡人的結局"]},{"type":"hebrew_subtitle","content":["大衛的詩。"]},{"type":"verse","number":1,"content":[{"text":"不要為作惡的心懷不平，","poem":1},{"lineBreak":true},{"text":"也不要向那行不義的生出嫉妒。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為他們如草快被割下，","poem":1},{"lineBreak":true},{"text":"又如青菜快要枯乾。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你當倚靠耶和華而行善，","poem":1},{"lineBreak":true},{"text":"住在地上，以他的信實為糧；","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"又要以耶和華為樂，","poem":1},{"lineBreak":true},{"text":"他就將你心裏所求的賜給你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"當將你的事交託耶和華，","poem":1},{"lineBreak":true},{"text":"並倚靠他，他就必成全。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他要使你的公義如光發出，","poem":1},{"lineBreak":true},{"text":"使你的公平明如正午。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"你當默然倚靠耶和華，耐性等候他；","poem":1},{"lineBreak":true},{"text":"不要因那道路通達的和那惡謀成就的心懷不平。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"當止住怒氣，離棄忿怒；","poem":1},{"lineBreak":true},{"text":"不要心懷不平，以致作惡。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為作惡的必被剪除；","poem":1},{"lineBreak":true},{"text":"惟有等候耶和華的必承受地土。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"還有片時，惡人要歸於無有；","poem":1},{"lineBreak":true},{"text":"你就是細察他的住處也要歸於無有。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"但謙卑人必承受地土，","poem":1},{"lineBreak":true},{"text":"以豐盛的平安為樂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"惡人設謀害義人，","poem":1},{"lineBreak":true},{"text":"又向他咬牙。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"主要笑他，","poem":1},{"lineBreak":true},{"text":"因見他受罰的日子將要來到。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"惡人已經弓上弦，刀出鞘，","poem":1},{"lineBreak":true},{"text":"要打倒困苦窮乏的人，","poem":1},{"lineBreak":true},{"text":"要殺害行動正直的人。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他們的刀必刺入自己的心；","poem":1},{"lineBreak":true},{"text":"他們的弓必被折斷。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"一個義人所有的雖少，","poem":1},{"lineBreak":true},{"text":"強過許多惡人的富餘。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因為惡人的膀臂必被折斷；","poem":1},{"lineBreak":true},{"text":"但耶和華是扶持義人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"耶和華知道完全人的日子；","poem":1},{"lineBreak":true},{"text":"他們的產業要存到永遠。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他們在急難的時候不致羞愧，","poem":1},{"lineBreak":true},{"text":"在饑荒的日子必得飽足。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"惡人卻要滅亡。","poem":1},{"lineBreak":true},{"text":"耶和華的仇敵要像羊羔的脂油","poem":1},{"noteId":17},{"text":"；","poem":1},{"lineBreak":true},{"text":"他們要消滅，要如煙消滅。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"惡人借貸而不償還；","poem":1},{"lineBreak":true},{"text":"義人卻恩待人，並且施捨。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"蒙耶和華賜福的必承受地土；","poem":1},{"lineBreak":true},{"text":"被他咒詛的必被剪除。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"義人的腳步被耶和華立定；","poem":1},{"lineBreak":true},{"text":"他的道路，耶和華也喜愛。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"他雖失腳也不致全身仆倒，","poem":1},{"lineBreak":true},{"text":"因為耶和華用手攙扶他","poem":1},{"noteId":18},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"我從前年幼，現在年老，","poem":1},{"lineBreak":true},{"text":"卻未見過義人被棄，","poem":1},{"lineBreak":true},{"text":"也未見過他的後裔討飯。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他終日恩待人，借給人；","poem":1},{"lineBreak":true},{"text":"他的後裔也蒙福！","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"你當離惡行善，","poem":1},{"lineBreak":true},{"text":"就可永遠安居。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"因為，耶和華喜愛公平，","poem":1},{"lineBreak":true},{"text":"不撇棄他的聖民；","poem":1},{"lineBreak":true},{"text":"他們永蒙保佑，","poem":1},{"lineBreak":true},{"text":"但惡人的後裔必被剪除。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"義人必承受地土，","poem":1},{"lineBreak":true},{"text":"永居其上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"義人的口談論智慧；","poem":1},{"lineBreak":true},{"text":"他的舌頭講說公平。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"上帝的律法在他心裏；","poem":1},{"lineBreak":true},{"text":"他的腳總不滑跌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"惡人窺探義人，","poem":1},{"lineBreak":true},{"text":"想要殺他。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"耶和華必不撇他在惡人手中；","poem":1},{"lineBreak":true},{"text":"當審判的時候，也不定他的罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"你當等候耶和華，遵守他的道，","poem":1},{"lineBreak":true},{"text":"他就抬舉你，使你承受地土；","poem":1},{"lineBreak":true},{"text":"惡人被剪除的時候，你必看見。","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"我見過惡人大有勢力，","poem":1},{"lineBreak":true},{"text":"好像一棵青翠樹在本土生發。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"有人從那裏經過，不料，他沒有了；","poem":1},{"lineBreak":true},{"text":"我也尋找他，卻尋不着。","poem":1}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"你要細察那完全人，觀看那正直人，","poem":1},{"lineBreak":true},{"text":"因為和平人有好結局。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"至於犯法的人，必一同滅絕；","poem":1},{"lineBreak":true},{"text":"惡人終必剪除。","poem":1}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"但義人得救是由於耶和華；","poem":1},{"lineBreak":true},{"text":"他在患難時作他們的營寨。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"耶和華幫助他們，解救他們；","poem":1},{"lineBreak":true},{"text":"他解救他們脫離惡人，把他們救出來，","poem":1},{"lineBreak":true},{"text":"因為他們投靠他。","poem":1}]}],"footnotes":[{"noteId":17,"caller":"-","text":"或譯：像草地的華美","reference":{"chapter":37,"verse":20}},{"noteId":18,"caller":"-","text":"或譯：攙扶他的手","reference":{"chapter":37,"verse":24}}]},"thisChapterLink":"/api/cmn_cuv/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}