{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":38,"content":[{"type":"heading","content":["受苦者的祈禱"]},{"type":"hebrew_subtitle","content":["大衛的紀念詩。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你不要在怒中責備我，","poem":1},{"lineBreak":true},{"text":"不要在烈怒中懲罰我！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為，你的箭射入我身；","poem":1},{"lineBreak":true},{"text":"你的手壓住我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因你的惱怒，我的肉無一完全；","poem":1},{"lineBreak":true},{"text":"因我的罪過，我的骨頭也不安寧。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的罪孽高過我的頭，","poem":1},{"lineBreak":true},{"text":"如同重擔叫我擔當不起。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"因我的愚昧，","poem":1},{"lineBreak":true},{"text":"我的傷發臭流膿。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我疼痛，大大拳曲，","poem":1},{"lineBreak":true},{"text":"終日哀痛。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我滿腰是火；","poem":1},{"lineBreak":true},{"text":"我的肉無一完全。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我被壓傷，身體疲倦；","poem":1},{"lineBreak":true},{"text":"因心裏不安，我就唉哼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"主啊，我的心願都在你面前；","poem":1},{"lineBreak":true},{"text":"我的歎息不向你隱瞞。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我心跳動，我力衰微，","poem":1},{"lineBreak":true},{"text":"連我眼中的光也沒有了。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的良朋密友因我的災病都躲在旁邊站着；","poem":1},{"lineBreak":true},{"text":"我的親戚本家也遠遠地站立。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"那尋索我命的設下網羅；","poem":1},{"lineBreak":true},{"text":"那想要害我的口出惡言，","poem":1},{"lineBreak":true},{"text":"終日思想詭計。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"但我如聾子不聽，","poem":1},{"lineBreak":true},{"text":"像啞巴不開口。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我如不聽見的人，","poem":1},{"lineBreak":true},{"text":"口中沒有回話。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"耶和華啊，我仰望你！","poem":1},{"lineBreak":true},{"text":"主－我的上帝啊，你必應允我！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我曾說：恐怕他們向我誇耀；","poem":1},{"lineBreak":true},{"text":"我失腳的時候，他們向我誇大。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"我幾乎跌倒；","poem":1},{"lineBreak":true},{"text":"我的痛苦常在我面前。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我要承認我的罪孽；","poem":1},{"lineBreak":true},{"text":"我要因我的罪憂愁。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"但我的仇敵又活潑又強壯，","poem":1},{"lineBreak":true},{"text":"無理恨我的增多了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"以惡報善的與我作對，","poem":1},{"lineBreak":true},{"text":"因我是追求良善。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"耶和華啊，求你不要撇棄我！","poem":1},{"lineBreak":true},{"text":"我的上帝啊，求你不要遠離我！","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"拯救我的主啊，求你快快幫助我！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}