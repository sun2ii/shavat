{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":39,"content":[{"type":"heading","content":["受苦者的認罪"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長耶杜頓。"]},{"type":"verse","number":1,"content":[{"text":"我曾說：我要謹慎我的言行，","poem":1},{"lineBreak":true},{"text":"免得我舌頭犯罪；","poem":1},{"lineBreak":true},{"text":"惡人在我面前的時候，","poem":1},{"lineBreak":true},{"text":"我要用嚼環勒住我的口。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我默然無聲，連好話也不出口；","poem":1},{"lineBreak":true},{"text":"我的愁苦就發動了，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我的心在我裏面發熱。","poem":1},{"lineBreak":true},{"text":"我默想的時候，火就燒起，","poem":1},{"lineBreak":true},{"text":"我便用舌頭說話。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華啊，求你叫我曉得我身之終！","poem":1},{"lineBreak":true},{"text":"我的壽數幾何？","poem":1},{"lineBreak":true},{"text":"叫我知道我的生命不長！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你使我的年日窄如手掌；","poem":1},{"lineBreak":true},{"text":"我一生的年數，在你面前如同無有。","poem":1},{"lineBreak":true},{"text":"各人最穩妥的時候，真是全然虛幻。（細拉）","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"世人行動實係幻影。","poem":1},{"lineBreak":true},{"text":"他們忙亂，真是枉然；","poem":1},{"lineBreak":true},{"text":"積蓄財寶，不知將來有誰收取。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"主啊，如今我等甚麼呢？","poem":1},{"lineBreak":true},{"text":"我的指望在乎你！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你救我脫離一切的過犯，","poem":1},{"lineBreak":true},{"text":"不要使我受愚頑人的羞辱。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因我所遭遇的是出於你，","poem":1},{"lineBreak":true},{"text":"我就默然不語。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"求你把你的責罰從我身上免去；","poem":1},{"lineBreak":true},{"text":"因你手的責打，我便消滅。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你因人的罪惡懲罰他的時候，","poem":1},{"lineBreak":true},{"text":"叫他的笑容","poem":1},{"noteId":19},{"text":"消滅，如衣被蟲所咬。","poem":1},{"lineBreak":true},{"text":"世人真是虛幻！（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和華啊，求你聽我的禱告，","poem":1},{"lineBreak":true},{"text":"留心聽我的呼求！","poem":1},{"lineBreak":true},{"text":"我流淚，求你不要靜默無聲！","poem":1},{"lineBreak":true},{"text":"因為我在你面前是客旅，","poem":1},{"lineBreak":true},{"text":"是寄居的，像我列祖一般。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"求你寬容我，","poem":1},{"lineBreak":true},{"text":"使我在去而不返之先可以力量復原。","poem":1}]}],"footnotes":[{"noteId":19,"caller":"-","text":"的笑容：或譯所喜愛的","reference":{"chapter":39,"verse":11}}]},"thisChapterLink":"/api/cmn_cuv/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}