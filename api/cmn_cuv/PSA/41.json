{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":41,"content":[{"type":"heading","content":["病中祈禱"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"眷顧貧窮的有福了！","poem":1},{"lineBreak":true},{"text":"他遭難的日子，耶和華必搭救他。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華必保全他，使他存活；","poem":1},{"lineBreak":true},{"text":"他必在地上享福。","poem":1},{"lineBreak":true},{"text":"求你不要把他交給仇敵，遂其所願。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他病重在榻，耶和華必扶持他；","poem":1},{"lineBreak":true},{"text":"他在病中，你必給他鋪床。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我曾說：耶和華啊，求你憐恤我，醫治我！","poem":1},{"lineBreak":true},{"text":"因為我得罪了你。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的仇敵用惡言議論我說：","poem":1},{"lineBreak":true},{"text":"他幾時死，他的名才滅亡呢？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他來看我就說假話；","poem":1},{"lineBreak":true},{"text":"他心存奸惡，走到外邊才說出來。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"一切恨我的，都交頭接耳地議論我；","poem":1},{"lineBreak":true},{"text":"他們設計要害我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"他們說：有怪病貼在他身上；","poem":1},{"lineBreak":true},{"text":"他已躺臥，必不能再起來。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"連我知己的朋友，","poem":1},{"lineBreak":true},{"text":"我所倚靠、吃過我飯的也用腳踢我。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華啊，求你憐恤我，","poem":1},{"lineBreak":true},{"text":"使我起來，好報復他們！","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"因我的仇敵不得向我誇勝，","poem":1},{"lineBreak":true},{"text":"我從此便知道你喜愛我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你因我純正就扶持我，","poem":1},{"lineBreak":true},{"text":"使我永遠站在你的面前。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和華－以色列的上帝是應當稱頌的，","poem":1},{"lineBreak":true},{"text":"從亙古直到永遠。阿們！阿們！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}