{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":42,"content":[{"type":"heading","content":["流亡異鄉者的禱告﹙一﹚"]},{"type":"hebrew_subtitle","content":["可拉後裔的訓誨詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，我的心切慕你，","poem":1},{"lineBreak":true},{"text":"如鹿切慕溪水。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的心渴想上帝，就是永生上帝；","poem":1},{"lineBreak":true},{"text":"我幾時得朝見上帝呢？","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我晝夜以眼淚當飲食；","poem":1},{"lineBreak":true},{"text":"人不住地對我說：你的上帝在哪裏呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我從前與眾人同往，","poem":1},{"lineBreak":true},{"text":"用歡呼稱讚的聲音","poem":1},{"lineBreak":true},{"text":"領他們到上帝的殿裏，大家守節。","poem":1},{"lineBreak":true},{"text":"我追想這些事，","poem":1},{"lineBreak":true},{"text":"我的心極其悲傷。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我的心哪，你為何憂悶？","poem":1},{"lineBreak":true},{"text":"為何在我裏面煩躁？","poem":1},{"lineBreak":true},{"text":"應當仰望上帝，因他笑臉幫助我；","poem":1},{"lineBreak":true},{"text":"我還要稱讚他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我的上帝啊，我的心在我裏面憂悶，","poem":1},{"lineBreak":true},{"text":"所以我從約旦地，","poem":1},{"lineBreak":true},{"text":"從黑門嶺，從米薩山記念你。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的瀑布發聲，深淵就與深淵響應；","poem":1},{"lineBreak":true},{"text":"你的波浪洪濤漫過我身。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"白晝，耶和華必向我施慈愛；","poem":1},{"lineBreak":true},{"text":"黑夜，我要歌頌禱告賜我生命的上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我要對上帝－我的磐石說：","poem":1},{"lineBreak":true},{"text":"你為何忘記我呢？","poem":1},{"lineBreak":true},{"text":"我為何因仇敵的欺壓時常哀痛呢？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的敵人辱罵我，","poem":1},{"lineBreak":true},{"text":"好像打碎我的骨頭，","poem":1},{"lineBreak":true},{"text":"不住地對我說：","poem":1},{"lineBreak":true},{"text":"你的上帝在哪裏呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我的心哪，你為何憂悶？","poem":1},{"lineBreak":true},{"text":"為何在我裏面煩躁？","poem":1},{"lineBreak":true},{"text":"應當仰望上帝，因我還要稱讚他。","poem":1},{"lineBreak":true},{"text":"他是我臉上的光榮","poem":1},{"noteId":20},{"text":"，是我的上帝。","poem":1}]}],"footnotes":[{"noteId":20,"caller":"-","text":"原文是幫助","reference":{"chapter":42,"verse":11}}]},"thisChapterLink":"/api/cmn_cuv/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}