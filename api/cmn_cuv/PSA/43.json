{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":43,"content":[{"type":"heading","content":["流亡異鄉者的禱告﹙二﹚"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你伸我的冤，","poem":1},{"lineBreak":true},{"text":"向不虔誠的國為我辨屈；","poem":1},{"lineBreak":true},{"text":"求你救我脫離詭詐不義的人。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為你是賜我力量的上帝，為何丟棄我呢？","poem":1},{"lineBreak":true},{"text":"我為何因仇敵的欺壓時常哀痛呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"求你發出你的亮光和真實，好引導我，","poem":1},{"lineBreak":true},{"text":"帶我到你的聖山，到你的居所！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我就走到上帝的祭壇，","poem":1},{"lineBreak":true},{"text":"到我最喜樂的上帝那裏。","poem":1},{"lineBreak":true},{"text":"上帝啊，我的上帝，","poem":1},{"lineBreak":true},{"text":"我要彈琴稱讚你！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我的心哪，你為何憂悶？","poem":1},{"lineBreak":true},{"text":"為何在我裏面煩躁？","poem":1},{"lineBreak":true},{"text":"應當仰望上帝，因我還要稱讚他。","poem":1},{"lineBreak":true},{"text":"他是我臉上的光榮","poem":1},{"noteId":21},{"text":"，是我的上帝。","poem":1}]}],"footnotes":[{"noteId":21,"caller":"-","text":"原文是幫助","reference":{"chapter":43,"verse":5}}]},"thisChapterLink":"/api/cmn_cuv/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}