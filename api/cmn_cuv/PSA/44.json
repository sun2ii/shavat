{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":44,"content":[{"type":"heading","content":["求主保護"]},{"type":"hebrew_subtitle","content":["可拉後裔的訓誨詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，你在古時，","poem":1},{"lineBreak":true},{"text":"我們列祖的日子所行的事，","poem":1},{"lineBreak":true},{"text":"我們親耳聽見了；","poem":1},{"lineBreak":true},{"text":"我們的列祖也給我們述說過。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你曾用手趕出外邦人，","poem":1},{"lineBreak":true},{"text":"卻栽培了我們列祖；","poem":1},{"lineBreak":true},{"text":"你苦待列邦，","poem":1},{"lineBreak":true},{"text":"卻叫我們列祖發達。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為他們不是靠自己的刀劍得地土，","poem":1},{"lineBreak":true},{"text":"也不是靠自己的膀臂得勝，","poem":1},{"lineBreak":true},{"text":"乃是靠你的右手、你的膀臂，","poem":1},{"lineBreak":true},{"text":"和你臉上的亮光，","poem":1},{"lineBreak":true},{"text":"因為你喜悅他們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"上帝啊，你是我的王；","poem":1},{"lineBreak":true},{"text":"求你出令使雅各得勝。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我們靠你要推倒我們的敵人，","poem":1},{"lineBreak":true},{"text":"靠你的名要踐踏那起來攻擊我們的人。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因為，我必不靠我的弓；","poem":1},{"lineBreak":true},{"text":"我的刀也不能使我得勝。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"惟你救了我們脫離敵人，","poem":1},{"lineBreak":true},{"text":"使恨我們的人羞愧。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我們終日因上帝誇耀，","poem":1},{"lineBreak":true},{"text":"還要永遠稱謝你的名。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"但如今你丟棄了我們，使我們受辱，","poem":1},{"lineBreak":true},{"text":"不和我們的軍兵同去。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你使我們向敵人轉身退後；","poem":1},{"lineBreak":true},{"text":"那恨我們的人任意搶奪。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你使我們當作快要被吃的羊，","poem":1},{"lineBreak":true},{"text":"把我們分散在列邦中。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你賣了你的子民也不賺利，","poem":1},{"lineBreak":true},{"text":"所得的價值並不加添你的資財。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"你使我們受鄰國的羞辱，","poem":1},{"lineBreak":true},{"text":"被四圍的人嗤笑譏刺。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你使我們在列邦中作了笑談，","poem":1},{"lineBreak":true},{"text":"使眾民向我們搖頭。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的凌辱終日在我面前，","poem":1},{"lineBreak":true},{"text":"我臉上的羞愧將我遮蔽，","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"都因那辱罵毀謗人的聲音，","poem":1},{"lineBreak":true},{"text":"又因仇敵和報仇人的緣故。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"這都臨到我們身上，","poem":1},{"lineBreak":true},{"text":"我們卻沒有忘記你，","poem":1},{"lineBreak":true},{"text":"也沒有違背你的約。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我們的心沒有退後；","poem":1},{"lineBreak":true},{"text":"我們的腳也沒有偏離你的路。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你在野狗之處壓傷我們，","poem":1},{"lineBreak":true},{"text":"用死蔭遮蔽我們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"倘若我們忘了上帝的名，","poem":1},{"lineBreak":true},{"text":"或向別神舉手，","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"上帝豈不鑒察這事嗎？","poem":1},{"lineBreak":true},{"text":"因為他曉得人心裏的隱秘。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我們為你的緣故終日被殺；","poem":1},{"lineBreak":true},{"text":"人看我們如將宰的羊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"主啊，求你睡醒，為何儘睡呢？","poem":1},{"lineBreak":true},{"text":"求你興起，不要永遠丟棄我們！","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你為何掩面，","poem":1},{"lineBreak":true},{"text":"不顧我們所遭的苦難和所受的欺壓？","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"我們的性命伏於塵土；","poem":1},{"lineBreak":true},{"text":"我們的肚腹緊貼地面。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"求你起來幫助我們！","poem":1},{"lineBreak":true},{"text":"憑你的慈愛救贖我們！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}