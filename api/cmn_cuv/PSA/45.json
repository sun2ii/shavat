{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":45,"content":[{"type":"heading","content":["王家婚禮詩歌"]},{"type":"hebrew_subtitle","content":["可拉後裔的訓誨詩，又是愛慕歌，交與伶長。調用百合花。"]},{"type":"verse","number":1,"content":[{"text":"我心裏湧出美辭；","poem":1},{"lineBreak":true},{"text":"我論到我為王做的事，","poem":1},{"lineBreak":true},{"text":"我的舌頭是快手筆。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"你比世人更美；","poem":1},{"lineBreak":true},{"text":"在你嘴裏滿有恩惠；","poem":1},{"lineBreak":true},{"text":"所以上帝賜福給你，直到永遠。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"大能者啊，願你腰間佩刀，","poem":1},{"lineBreak":true},{"text":"大有榮耀和威嚴！","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"為真理、謙卑、公義赫然坐車前往，無不得勝；","poem":1},{"lineBreak":true},{"text":"你的右手必顯明可畏的事。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的箭鋒快，射中王敵之心；","poem":1},{"lineBreak":true},{"text":"萬民仆倒在你以下。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"上帝啊，你的寶座是永永遠遠的；","poem":1},{"lineBreak":true},{"text":"你的國權是正直的。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你喜愛公義，恨惡罪惡；","poem":1},{"lineBreak":true},{"text":"所以上帝－就是你的上帝－用喜樂油膏你，","poem":1},{"lineBreak":true},{"text":"勝過膏你的同伴。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你的衣服都有沒藥、沉香、肉桂的香氣；","poem":1},{"lineBreak":true},{"text":"象牙宮中有絲弦樂器的聲音使你歡喜。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"有君王的女兒在你尊貴婦女之中；","poem":1},{"lineBreak":true},{"text":"王后佩戴俄斐金飾站在你右邊。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"女子啊，你要聽，要想，要側耳而聽！","poem":1},{"lineBreak":true},{"text":"不要記念你的民和你的父家，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"王就羨慕你的美貌；","poem":1},{"lineBreak":true},{"text":"因為他是你的主，你當敬拜他。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"泰爾的民","poem":1},{"noteId":22},{"text":"必來送禮；","poem":1},{"lineBreak":true},{"text":"民中的富足人也必向你求恩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"王女在宮裏極其榮華；","poem":1},{"lineBreak":true},{"text":"她的衣服是用金線繡的。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"她要穿錦繡的衣服，被引到王前；","poem":1},{"lineBreak":true},{"text":"隨從她的陪伴童女也要被帶到你面前。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"她們要歡喜快樂被引導；","poem":1},{"lineBreak":true},{"text":"她們要進入王宮。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"你的子孫要接續你的列祖；","poem":1},{"lineBreak":true},{"text":"你要立他們在全地作王。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我必叫你的名被萬代記念，","poem":1},{"lineBreak":true},{"text":"所以萬民要永永遠遠稱謝你。","poem":1}]}],"footnotes":[{"noteId":22,"caller":"-","text":"原文是女子","reference":{"chapter":45,"verse":12}}]},"thisChapterLink":"/api/cmn_cuv/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}