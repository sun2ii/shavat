{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":47,"content":[{"type":"heading","content":["至高的主宰"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"萬民哪，你們都要拍掌！","poem":1},{"lineBreak":true},{"text":"要用誇勝的聲音向上帝呼喊！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為耶和華至高者是可畏的；","poem":1},{"lineBreak":true},{"text":"他是治理全地的大君王。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他叫萬民服在我們以下，","poem":1},{"lineBreak":true},{"text":"又叫列邦服在我們腳下。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他為我們選擇產業，","poem":1},{"lineBreak":true},{"text":"就是他所愛之雅各的榮耀。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"上帝上升，有喊聲相送；","poem":1},{"lineBreak":true},{"text":"耶和華上升，有角聲相送。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你們要向上帝歌頌，歌頌！","poem":1},{"lineBreak":true},{"text":"向我們王歌頌，歌頌！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因為上帝是全地的王；","poem":1},{"lineBreak":true},{"text":"你們要用悟性歌頌。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"上帝作王治理萬國；","poem":1},{"lineBreak":true},{"text":"上帝坐在他的聖寶座上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"列邦的君王聚集要作亞伯拉罕之上帝的民。","poem":1},{"lineBreak":true},{"text":"因為世界的盾牌是屬上帝的；","poem":1},{"lineBreak":true},{"text":"他為至高！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}