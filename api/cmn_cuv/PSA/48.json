{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":48,"content":[{"type":"heading","content":["錫安－上帝的城"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和華本為大！","poem":1},{"lineBreak":true},{"text":"在我們上帝的城中，","poem":1},{"lineBreak":true},{"text":"在他的聖山上，該受大讚美。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"錫安山－大君王的城，","poem":1},{"lineBreak":true},{"text":"在北面居高華美，","poem":1},{"lineBreak":true},{"text":"為全地所喜悅。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝在其宮中，","poem":1},{"lineBreak":true},{"text":"自顯為避難所。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"看哪，眾王會合，","poem":1},{"lineBreak":true},{"text":"一同經過。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們見了這城就驚奇喪膽，","poem":1},{"lineBreak":true},{"text":"急忙逃跑。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們在那裏被戰兢疼痛抓住，","poem":1},{"lineBreak":true},{"text":"好像產難的婦人一樣。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝啊，你用東風打破他施的船隻。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我們在萬軍之耶和華的城中","poem":1},{"lineBreak":true},{"text":"－就是我們上帝的城中－所看見的，","poem":1},{"lineBreak":true},{"text":"正如我們所聽見的。","poem":1},{"lineBreak":true},{"text":"上帝必堅立這城，直到永遠。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"上帝啊，我們在你的殿中想念你的慈愛。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，你受的讚美正與你的名相稱，直到地極！","poem":1},{"lineBreak":true},{"text":"你的右手滿了公義。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因你的判斷，錫安山應當歡喜，","poem":1},{"lineBreak":true},{"text":"猶大的城邑","poem":1},{"noteId":23},{"text":"應當快樂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"你們當周遊錫安，","poem":1},{"lineBreak":true},{"text":"四圍旋繞，數點城樓，","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"細看她的外郭，","poem":1},{"lineBreak":true},{"text":"察看她的宮殿，","poem":1},{"lineBreak":true},{"text":"為要傳說到後代。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因為這上帝永永遠遠為我們的上帝；","poem":1},{"lineBreak":true},{"text":"他必作我們引路的，直到死時。","poem":1}]}],"footnotes":[{"noteId":23,"caller":"-","text":"原文是女子","reference":{"chapter":48,"verse":11}}]},"thisChapterLink":"/api/cmn_cuv/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}