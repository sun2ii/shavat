{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":49,"content":[{"type":"heading","content":["恃財之愚"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"萬民哪，你們都當聽這話！","poem":1},{"lineBreak":true},{"text":"世上一切的居民，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"無論上流下流，富足貧窮，","poem":1},{"lineBreak":true},{"text":"都當留心聽！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我口要說智慧的言語；","poem":1},{"lineBreak":true},{"text":"我心要想通達的道理。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要側耳聽比喻，","poem":1},{"lineBreak":true},{"text":"用琴解謎語。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"在患難的日子，奸惡隨我腳跟，四面環繞我，","poem":1},{"lineBreak":true},{"text":"我何必懼怕？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"那些倚仗財貨自誇錢財多的人，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"一個也無法贖自己的弟兄，","poem":1},{"lineBreak":true},{"text":"也不能替他將贖價給上帝，","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"叫他長遠活着，不見朽壞；","poem":1},{"lineBreak":true},{"text":"因為贖他生命的價值極貴，","poem":1},{"lineBreak":true},{"text":"只可永遠罷休。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"他必見智慧人死，","poem":1},{"lineBreak":true},{"text":"又見愚頑人和畜類人一同滅亡，","poem":1},{"lineBreak":true},{"text":"將他們的財貨留給別人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們心裏思想：","poem":1},{"lineBreak":true},{"text":"他們的家室必永存，","poem":1},{"lineBreak":true},{"text":"住宅必留到萬代；","poem":1},{"lineBreak":true},{"text":"他們以自己的名稱自己的地。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"但人居尊貴中不能長久，","poem":1},{"lineBreak":true},{"text":"如同死亡的畜類一樣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"他們行的這道本為自己的愚昧；","poem":1},{"lineBreak":true},{"text":"但他們以後的人還佩服他們的話語。（細拉）","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們如同羊群派定下陰間；","poem":1},{"lineBreak":true},{"text":"死亡必作他們的牧者。","poem":1},{"lineBreak":true},{"text":"到了早晨，正直人必管轄他們；","poem":1},{"lineBreak":true},{"text":"他們的美容必被陰間所滅，以致無處可存。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"只是上帝必救贖我的靈魂脫離陰間的權柄，","poem":1},{"lineBreak":true},{"text":"因他必收納我。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"見人發財、家室增榮的時候，","poem":1},{"lineBreak":true},{"text":"你不要懼怕；","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"因為，他死的時候甚麼也不能帶去；","poem":1},{"lineBreak":true},{"text":"他的榮耀不能隨他下去。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他活着的時候，雖然自誇為有福","poem":1},{"lineBreak":true},{"text":"（你若利己，人必誇獎你）；","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他仍必歸到他歷代的祖宗那裏，","poem":1},{"lineBreak":true},{"text":"永不見光。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"人在尊貴中而不醒悟，","poem":1},{"lineBreak":true},{"text":"就如死亡的畜類一樣。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":19}