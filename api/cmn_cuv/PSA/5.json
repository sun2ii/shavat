{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":5,"content":[{"type":"heading","content":["求主保護"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。用吹的樂器。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你留心聽我的言語，","poem":1},{"lineBreak":true},{"text":"顧念我的心思！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我的王我的上帝啊，求你垂聽我呼求的聲音！","poem":1},{"lineBreak":true},{"text":"因為我向你祈禱。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華啊，早晨你必聽我的聲音；","poem":1},{"lineBreak":true},{"text":"早晨我必向你陳明我的心意，並要警醒！","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"因為你不是喜悅惡事的上帝，","poem":1},{"lineBreak":true},{"text":"惡人不能與你同居。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"狂傲人不能站在你眼前；","poem":1},{"lineBreak":true},{"text":"凡作孽的，都是你所恨惡的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"說謊言的，你必滅絕；","poem":1},{"lineBreak":true},{"text":"好流人血弄詭詐的，都為耶和華所憎惡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"至於我，我必憑你豐盛的慈愛進入你的居所；","poem":1},{"lineBreak":true},{"text":"我必存敬畏你的心向你的聖殿下拜。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華啊，求你因我的仇敵，憑你的公義引領我，","poem":1},{"lineBreak":true},{"text":"使你的道路在我面前正直。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"因為，他們的口中沒有誠實；","poem":1},{"lineBreak":true},{"text":"他們的心裏滿有邪惡；","poem":1},{"lineBreak":true},{"text":"他們的喉嚨是敞開的墳墓；","poem":1},{"lineBreak":true},{"text":"他們用舌頭諂媚人。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，求你定他們的罪！","poem":1},{"lineBreak":true},{"text":"願他們因自己的計謀跌倒；","poem":1},{"lineBreak":true},{"text":"願你在他們許多的過犯中把他們逐出，","poem":1},{"lineBreak":true},{"text":"因為他們背叛了你。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"凡投靠你的，願他們喜樂，時常歡呼，","poem":1},{"lineBreak":true},{"text":"因為你護庇他們；","poem":1},{"lineBreak":true},{"text":"又願那愛你名的人都靠你歡欣。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因為你必賜福與義人；","poem":1},{"lineBreak":true},{"text":"耶和華啊，你必用恩惠如同盾牌四面護衛他。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}