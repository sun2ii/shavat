{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":51,"content":[{"type":"heading","content":["求主赦免"]},{"type":"hebrew_subtitle","content":["大衛與拔示巴同室以後，先知拿單來見他；他作這詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你按你的慈愛憐恤我！","poem":1},{"lineBreak":true},{"text":"按你豐盛的慈悲塗抹我的過犯！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你將我的罪孽洗除淨盡，","poem":1},{"lineBreak":true},{"text":"並潔除我的罪！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因為，我知道我的過犯；","poem":1},{"lineBreak":true},{"text":"我的罪常在我面前。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我向你犯罪，惟獨得罪了你；","poem":1},{"lineBreak":true},{"text":"在你眼前行了這惡，","poem":1},{"lineBreak":true},{"text":"以致你責備我的時候顯為公義，","poem":1},{"lineBreak":true},{"text":"判斷我的時候顯為清正。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我是在罪孽裏生的，","poem":1},{"lineBreak":true},{"text":"在我母親懷胎的時候就有了罪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"你所喜愛的是內裏誠實；","poem":1},{"lineBreak":true},{"text":"你在我隱密處，必使我得智慧。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"求你用牛膝草潔淨我，我就乾淨；","poem":1},{"lineBreak":true},{"text":"求你洗滌我，我就比雪更白。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"求你使我得聽歡喜快樂的聲音，","poem":1},{"lineBreak":true},{"text":"使你所壓傷的骨頭可以踴躍。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你掩面不看我的罪，","poem":1},{"lineBreak":true},{"text":"塗抹我一切的罪孽。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"上帝啊，求你為我造清潔的心，","poem":1},{"lineBreak":true},{"text":"使我裏面重新有正直","poem":1},{"noteId":24},{"text":"的靈。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"不要丟棄我，使我離開你的面；","poem":1},{"lineBreak":true},{"text":"不要從我收回你的聖靈。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你使我仍得救恩之樂，","poem":1},{"lineBreak":true},{"text":"賜我樂意的靈扶持我，","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我就把你的道指教有過犯的人，","poem":1},{"lineBreak":true},{"text":"罪人必歸順你。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"上帝啊，你是拯救我的上帝；","poem":1},{"lineBreak":true},{"text":"求你救我脫離流人血的罪！","poem":1},{"lineBreak":true},{"text":"我的舌頭就高聲歌唱你的公義。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"主啊，求你使我嘴唇張開，","poem":1},{"lineBreak":true},{"text":"我的口便傳揚讚美你的話！","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你本不喜愛祭物，若喜愛，我就獻上；","poem":1},{"lineBreak":true},{"text":"燔祭，你也不喜悅。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"上帝所要的祭就是憂傷的靈；","poem":1},{"lineBreak":true},{"text":"上帝啊，憂傷痛悔的心，你必不輕看。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"求你隨你的美意善待錫安，","poem":1},{"lineBreak":true},{"text":"建造耶路撒冷的城牆。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"那時，你必喜愛公義的祭","poem":1},{"lineBreak":true},{"text":"和燔祭並全牲的燔祭；","poem":1},{"lineBreak":true},{"text":"那時，人必將公牛獻在你壇上。","poem":1}]}],"footnotes":[{"noteId":24,"caller":"-","text":"或譯：堅定","reference":{"chapter":51,"verse":10}}]},"thisChapterLink":"/api/cmn_cuv/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}