{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":55,"content":[{"type":"heading","content":["被友出賣者的禱告"]},{"type":"hebrew_subtitle","content":["大衛的訓誨詩，交與伶長。用絲弦的樂器。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你留心聽我的禱告，","poem":1},{"lineBreak":true},{"text":"不要隱藏不聽我的懇求！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你側耳聽我，應允我。","poem":1},{"lineBreak":true},{"text":"我哀歎不安，發聲唉哼，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"都因仇敵的聲音，惡人的欺壓；","poem":1},{"lineBreak":true},{"text":"因為他們將罪孽加在我身上，發怒氣逼迫我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我心在我裏面甚是疼痛；","poem":1},{"lineBreak":true},{"text":"死的驚惶臨到我身。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"恐懼戰兢歸到我身；","poem":1},{"lineBreak":true},{"text":"驚恐漫過了我。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我說：但願我有翅膀像鴿子，","poem":1},{"lineBreak":true},{"text":"我就飛去，得享安息。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我必遠遊，","poem":1},{"lineBreak":true},{"text":"宿在曠野。（細拉）","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我必速速逃到避所，","poem":1},{"lineBreak":true},{"text":"脫離狂風暴雨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"主啊，求你吞滅他們，變亂他們的舌頭！","poem":1},{"lineBreak":true},{"text":"因為我在城中見了強暴爭競的事。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們在城牆上晝夜繞行；","poem":1},{"lineBreak":true},{"text":"在城內也有罪孽和奸惡。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"邪惡在其中；","poem":1},{"lineBreak":true},{"text":"欺壓和詭詐不離街市。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"原來不是仇敵辱罵我，","poem":1},{"lineBreak":true},{"text":"若是仇敵，還可忍耐；","poem":1},{"lineBreak":true},{"text":"也不是恨我的人向我狂大，","poem":1},{"lineBreak":true},{"text":"若是恨我的人就必躲避他。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"不料是你；你原與我平等，","poem":1},{"lineBreak":true},{"text":"是我的同伴，是我知己的朋友！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我們素常彼此談論，以為甘甜；","poem":1},{"lineBreak":true},{"text":"我們與群眾在上帝的殿中同行。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"願死亡忽然臨到他們！","poem":1},{"lineBreak":true},{"text":"願他們活活地下入陰間！","poem":1},{"lineBreak":true},{"text":"因為他們的住處，他們的心中，都是邪惡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"至於我，我要求告上帝；","poem":1},{"lineBreak":true},{"text":"耶和華必拯救我。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我要晚上、早晨、晌午哀聲悲歎；","poem":1},{"lineBreak":true},{"text":"他也必聽我的聲音。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他救贖我命脫離攻擊我的人，","poem":1},{"lineBreak":true},{"text":"使我得享平安，","poem":1},{"lineBreak":true},{"text":"因為與我相爭的人甚多。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"那沒有更變、不敬畏上帝的人，","poem":1},{"lineBreak":true},{"text":"從太古常存的上帝必聽見而苦待他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"他背了約，","poem":1},{"lineBreak":true},{"text":"伸手攻擊與他和好的人。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他的口如奶油光滑，","poem":1},{"lineBreak":true},{"text":"他的心卻懷着爭戰；","poem":1},{"lineBreak":true},{"text":"他的話比油柔和，","poem":1},{"lineBreak":true},{"text":"其實是拔出來的刀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"你要把你的重擔卸給耶和華，","poem":1},{"lineBreak":true},{"text":"他必撫養你；","poem":1},{"lineBreak":true},{"text":"他永不叫義人動搖。","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"上帝啊，你必使惡人下入滅亡的坑；","poem":1},{"lineBreak":true},{"text":"流人血、行詭詐的人必活不到半世，","poem":1},{"lineBreak":true},{"text":"但我要倚靠你。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}