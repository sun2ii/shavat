{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":57,"content":[{"type":"heading","content":["求主施援"]},{"type":"hebrew_subtitle","content":["大衛逃避掃羅，藏在洞裏。那時，他作這金詩，交與伶長。調用休要毀壞。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你憐憫我，憐憫我！","poem":1},{"lineBreak":true},{"text":"因為我的心投靠你。","poem":1},{"lineBreak":true},{"text":"我要投靠在你翅膀的蔭下，","poem":1},{"lineBreak":true},{"text":"等到災害過去。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要求告至高的上帝，","poem":1},{"lineBreak":true},{"text":"就是為我成全諸事的上帝。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"那要吞我的人辱罵我的時候，","poem":1},{"lineBreak":true},{"text":"上帝從天上必施恩救我，","poem":1},{"lineBreak":true},{"text":"也必向我發出慈愛和誠實。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我的性命在獅子中間；","poem":1},{"lineBreak":true},{"text":"我躺臥在性如烈火的世人當中。","poem":1},{"lineBreak":true},{"text":"他們的牙齒是槍、箭；","poem":1},{"lineBreak":true},{"text":"他們的舌頭是快刀。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"上帝啊，願你崇高過於諸天！","poem":1},{"lineBreak":true},{"text":"願你的榮耀高過全地！","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"他們為我的腳設下網羅，壓制我的心；","poem":1},{"lineBreak":true},{"text":"他們在我面前挖了坑，自己反掉在其中。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"上帝啊，我心堅定，我心堅定；","poem":1},{"lineBreak":true},{"text":"我要唱詩，我要歌頌！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的靈","poem":1},{"noteId":25},{"text":"啊，你當醒起！","poem":1},{"lineBreak":true},{"text":"琴瑟啊，你們當醒起！","poem":1},{"lineBreak":true},{"text":"我自己要極早醒起！","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"主啊，我要在萬民中稱謝你，","poem":1},{"lineBreak":true},{"text":"在列邦中歌頌你！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"因為，你的慈愛高及諸天；","poem":1},{"lineBreak":true},{"text":"你的誠實達到穹蒼。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝啊，願你崇高過於諸天！","poem":1},{"lineBreak":true},{"text":"願你的榮耀高過全地！","poem":1}]}],"footnotes":[{"noteId":25,"caller":"-","text":"原文是榮耀","reference":{"chapter":57,"verse":8}}]},"thisChapterLink":"/api/cmn_cuv/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}