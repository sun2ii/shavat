{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":6,"content":[{"type":"heading","content":["患難中求助的祈禱"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。用絲弦的樂器，調用第八。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，求你不要在怒中責備我，","poem":1},{"lineBreak":true},{"text":"也不要在烈怒中懲罰我！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華啊，求你可憐我，因為我軟弱。","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你醫治我，因為我的骨頭發戰。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我心也大大地驚惶。","poem":1},{"lineBreak":true},{"text":"耶和華啊，你要到幾時才救我呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華啊，求你轉回搭救我！","poem":1},{"lineBreak":true},{"text":"因你的慈愛拯救我。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因為，在死地無人記念你，","poem":1},{"lineBreak":true},{"text":"在陰間有誰稱謝你？","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我因唉哼而困乏；","poem":1},{"lineBreak":true},{"text":"我每夜流淚，把床榻漂起，","poem":1},{"lineBreak":true},{"text":"把褥子濕透。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我因憂愁眼睛乾癟，","poem":1},{"lineBreak":true},{"text":"又因我一切的敵人眼睛昏花。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你們一切作孽的人，離開我吧！","poem":1},{"lineBreak":true},{"text":"因為耶和華聽了我哀哭的聲音。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"耶和華聽了我的懇求；","poem":1},{"lineBreak":true},{"text":"耶和華必收納我的禱告。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的一切仇敵都必羞愧，大大驚惶；","poem":1},{"lineBreak":true},{"text":"他們必要退後，忽然羞愧。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}