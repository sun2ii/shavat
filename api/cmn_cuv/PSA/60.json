{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":60,"content":[{"type":"heading","content":["求主解救"]},{"type":"hebrew_subtitle","content":["大衛與兩河間的亞蘭並瑣巴的亞蘭爭戰的時候，約押轉回，在鹽谷攻擊以東，殺了一萬二千人。那時，大衛作這金詩，叫人學習，交與伶長。調用為證的百合花。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，你丟棄了我們，使我們破敗；","poem":1},{"lineBreak":true},{"text":"你向我們發怒，求你使我們復興！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你使地震動，而且崩裂；","poem":1},{"lineBreak":true},{"text":"求你將裂口醫好，因為地搖動。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你叫你的民遇見艱難；","poem":1},{"lineBreak":true},{"text":"你叫我們喝那使人東倒西歪的酒。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"你把旌旗賜給敬畏你的人，","poem":1},{"lineBreak":true},{"text":"可以為真理揚起來。（細拉）","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"求你應允我們，用右手拯救我們，","poem":1},{"lineBreak":true},{"text":"好叫你所親愛的人得救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"上帝已經指着他的聖潔說","poem":1},{"noteId":26},{"text":"：我要歡樂；","poem":1},{"lineBreak":true},{"text":"我要分開示劍，丈量疏割谷。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"基列是我的，瑪拿西也是我的。","poem":1},{"lineBreak":true},{"text":"以法蓮是護衛我頭的；","poem":1},{"lineBreak":true},{"text":"猶大是我的杖。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"摩押是我的沐浴盆；","poem":1},{"lineBreak":true},{"text":"我要向以東拋鞋。","poem":1},{"lineBreak":true},{"text":"非利士啊，你還能因我歡呼嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"誰能領我進堅固城？","poem":1},{"lineBreak":true},{"text":"誰能引我到以東地？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，你不是丟棄了我們嗎？","poem":1},{"lineBreak":true},{"text":"上帝啊，你不和我們的軍兵同去嗎？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你幫助我們攻擊敵人，","poem":1},{"lineBreak":true},{"text":"因為人的幫助是枉然的。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我們倚靠上帝才得施展大能，","poem":1},{"lineBreak":true},{"text":"因為踐踏我們敵人的就是他。","poem":1}]}],"footnotes":[{"noteId":26,"caller":"-","text":"說：或譯應許我","reference":{"chapter":60,"verse":6}}]},"thisChapterLink":"/api/cmn_cuv/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}