{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":61,"content":[{"type":"heading","content":["求主保佑"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。用絲弦的樂器。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你聽我的呼求，","poem":1},{"lineBreak":true},{"text":"側耳聽我的禱告！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我心裏發昏的時候，","poem":1},{"lineBreak":true},{"text":"我要從地極求告你。","poem":1},{"lineBreak":true},{"text":"求你領我到那比我更高的磐石！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為你作過我的避難所，","poem":1},{"lineBreak":true},{"text":"作過我的堅固臺，脫離仇敵。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我要永遠住在你的帳幕裏！","poem":1},{"lineBreak":true},{"text":"我要投靠在你翅膀下的隱密處！（細拉）","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝啊，你原是聽了我所許的願；","poem":1},{"lineBreak":true},{"text":"你將產業賜給敬畏你名的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"你要加添王的壽數；","poem":1},{"lineBreak":true},{"text":"他的年歲必存到世世。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他必永遠坐在上帝面前；","poem":1},{"lineBreak":true},{"text":"願你預備慈愛和誠實保佑他！","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"這樣，我要歌頌你的名，直到永遠，","poem":1},{"lineBreak":true},{"text":"好天天還我所許的願。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}