{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":62,"content":[{"type":"heading","content":["在上帝保佑中安穩自在"]},{"type":"hebrew_subtitle","content":["大衛的詩，照耶杜頓的作法，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"我的心默默無聲，專等候上帝；","poem":1},{"lineBreak":true},{"text":"我的救恩是從他而來。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"惟獨他是我的磐石，我的拯救；","poem":1},{"lineBreak":true},{"text":"他是我的高臺，我必不很動搖。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你們大家攻擊一人，把他毀壞，","poem":1},{"lineBreak":true},{"text":"如同毀壞歪斜的牆、將倒的壁，要到幾時呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們彼此商議，專要從他的尊位上把他推下；","poem":1},{"lineBreak":true},{"text":"他們喜愛謊話，口雖祝福，心卻咒詛。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我的心哪，你當默默無聲，專等候上帝，","poem":1},{"lineBreak":true},{"text":"因為我的盼望是從他而來。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"惟獨他是我的磐石，我的拯救；","poem":1},{"lineBreak":true},{"text":"他是我的高臺，我必不動搖。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的拯救、我的榮耀都在乎上帝；","poem":1},{"lineBreak":true},{"text":"我力量的磐石、我的避難所都在乎上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你們眾民當時時倚靠他，","poem":1},{"lineBreak":true},{"text":"在他面前傾心吐意；","poem":1},{"lineBreak":true},{"text":"上帝是我們的避難所。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"下流人真是虛空；","poem":1},{"lineBreak":true},{"text":"上流人也是虛假；","poem":1},{"lineBreak":true},{"text":"放在天平裏就必浮起；","poem":1},{"lineBreak":true},{"text":"他們一共比空氣還輕。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"不要仗勢欺人，","poem":1},{"lineBreak":true},{"text":"也不要因搶奪而驕傲；","poem":1},{"lineBreak":true},{"text":"若財寶加增，不要放在心上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"上帝說了一次、兩次，我都聽見：","poem":1},{"lineBreak":true},{"text":"就是能力都屬乎上帝。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"主啊，慈愛也是屬乎你，","poem":1},{"lineBreak":true},{"text":"因為你照着各人所行的報應他。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}