{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":63,"content":[{"type":"heading","content":["渴慕上帝"]},{"type":"hebrew_subtitle","content":["大衛在猶大曠野的時候，作了這詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，你是我的上帝，","poem":1},{"lineBreak":true},{"text":"我要切切地尋求你，","poem":1},{"lineBreak":true},{"text":"在乾旱疲乏無水之地，我渴想你；","poem":1},{"lineBreak":true},{"text":"我的心切慕你。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在聖所中曾如此瞻仰你，","poem":1},{"lineBreak":true},{"text":"為要見你的能力和你的榮耀。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因你的慈愛比生命更好，","poem":1},{"lineBreak":true},{"text":"我的嘴唇要頌讚你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我還活的時候要這樣稱頌你；","poem":1},{"lineBreak":true},{"text":"我要奉你的名舉手。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"我在床上記念你，","poem":1},{"lineBreak":true},{"text":"在夜更的時候思想你；","poem":1},{"lineBreak":true},{"text":"我的心就像飽足了骨髓肥油，","poem":1},{"lineBreak":true},{"text":"我也要以歡樂的嘴唇讚美你。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因為你曾幫助我，","poem":1},{"lineBreak":true},{"text":"我就在你翅膀的蔭下歡呼。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我心緊緊地跟隨你；","poem":1},{"lineBreak":true},{"text":"你的右手扶持我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"但那些尋索要滅我命的人","poem":1},{"lineBreak":true},{"text":"必往地底下去；","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們必被刀劍所殺，","poem":1},{"lineBreak":true},{"text":"被野狗所吃。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"但是王必因上帝歡喜。","poem":1},{"lineBreak":true},{"text":"凡指着他發誓的必要誇口，","poem":1},{"lineBreak":true},{"text":"因為說謊之人的口必被塞住。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":10}