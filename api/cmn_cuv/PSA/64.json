{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":64,"content":[{"type":"heading","content":["求主保護"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，我哀歎的時候，求你聽我的聲音！","poem":1},{"lineBreak":true},{"text":"求你保護我的性命，不受仇敵的驚恐！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你把我隱藏，","poem":1},{"lineBreak":true},{"text":"使我脫離作惡之人的暗謀和作孽之人的擾亂。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們磨舌如刀，","poem":1},{"lineBreak":true},{"text":"發出苦毒的言語，好像比準了的箭，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"要在暗地射完全人；","poem":1},{"lineBreak":true},{"text":"他們忽然射他，並不懼怕。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們彼此勉勵設下惡計；","poem":1},{"lineBreak":true},{"text":"他們商量暗設網羅，","poem":1},{"lineBreak":true},{"text":"說：誰能看見？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們圖謀奸惡，","poem":1},{"lineBreak":true},{"text":"說：我們是極力圖謀的。","poem":1},{"lineBreak":true},{"text":"他們各人的意念心思是深的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"但上帝要射他們；","poem":1},{"lineBreak":true},{"text":"他們忽然被箭射傷。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們必然絆跌，被自己的舌頭所害；","poem":1},{"lineBreak":true},{"text":"凡看見他們的必都搖頭。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"眾人都要害怕，","poem":1},{"lineBreak":true},{"text":"要傳揚上帝的工作，","poem":1},{"lineBreak":true},{"text":"並且明白他的作為。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"義人必因耶和華歡喜， 並要投靠他；","poem":1},{"lineBreak":true},{"text":"凡心裏正直的人都要誇口。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}