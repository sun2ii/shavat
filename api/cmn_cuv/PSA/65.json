{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":65,"content":[{"type":"heading","content":["頌讚主恩"]},{"type":"hebrew_subtitle","content":["大衛的詩歌，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，錫安的人都等候讚美你；","poem":1},{"lineBreak":true},{"text":"所許的願也要向你償還。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"聽禱告的主啊，","poem":1},{"lineBreak":true},{"text":"凡有血氣的都要來就你。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"罪孽勝了我；","poem":1},{"lineBreak":true},{"text":"至於我們的過犯，你都要赦免。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你所揀選、使他親近你、住在你院中的，","poem":1},{"lineBreak":true},{"text":"這人便為有福！","poem":1},{"lineBreak":true},{"text":"我們必因你居所、你聖殿的美福知足了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"拯救我們的上帝啊，你必以威嚴秉公義應允我們；","poem":1},{"lineBreak":true},{"text":"你本是一切地極和海上遠處的人所倚靠的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他既以大能束腰，","poem":1},{"lineBreak":true},{"text":"就用力量安定諸山，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"使諸海的響聲和其中波浪的響聲，","poem":1},{"lineBreak":true},{"text":"並萬民的喧嘩，都平靜了。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"住在地極的人因你的神蹟懼怕；","poem":1},{"lineBreak":true},{"text":"你使日出日落之地都歡呼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"你眷顧地，降下透雨，","poem":1},{"lineBreak":true},{"text":"使地大得肥美。","poem":1},{"lineBreak":true},{"text":"上帝的河滿了水；","poem":1},{"lineBreak":true},{"text":"你這樣澆灌了地，","poem":1},{"lineBreak":true},{"text":"好為人預備五穀。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你澆透地的犂溝，潤平犂脊，","poem":1},{"lineBreak":true},{"text":"降甘霖，使地軟和；","poem":1},{"lineBreak":true},{"text":"其中發長的，蒙你賜福。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你以恩典為年歲的冠冕；","poem":1},{"lineBreak":true},{"text":"你的路徑都滴下脂油，","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"滴在曠野的草場上。","poem":1},{"lineBreak":true},{"text":"小山以歡樂束腰；","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"草場以羊群為衣；","poem":1},{"lineBreak":true},{"text":"谷中也長滿了五穀。","poem":1},{"lineBreak":true},{"text":"這一切都歡呼歌唱。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}