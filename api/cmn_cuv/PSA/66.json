{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":66,"content":[{"type":"heading","content":["頌讚感恩的詩"]},{"type":"hebrew_subtitle","content":["一篇詩歌，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"全地都當向上帝歡呼！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"歌頌他名的榮耀！","poem":1},{"lineBreak":true},{"text":"用讚美的言語將他的榮耀發明！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"當對上帝說：你的作為何等可畏！","poem":1},{"lineBreak":true},{"text":"因你的大能，仇敵要投降你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"全地要敬拜你，歌頌你，","poem":1},{"lineBreak":true},{"text":"要歌頌你的名。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你們來看上帝所行的，","poem":1},{"lineBreak":true},{"text":"他向世人所做之事是可畏的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他將海變成乾地，眾民步行過河；","poem":1},{"lineBreak":true},{"text":"我們在那裏因他歡喜。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他用權能治理萬民，直到永遠。","poem":1},{"lineBreak":true},{"text":"他的眼睛鑒察列邦；","poem":1},{"lineBreak":true},{"text":"悖逆的人不可自高。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"萬民哪，你們當稱頌我們的上帝，","poem":1},{"lineBreak":true},{"text":"使人得聽讚美他的聲音。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他使我們的性命存活，","poem":1},{"lineBreak":true},{"text":"也不叫我們的腳搖動。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，你曾試驗我們，","poem":1},{"lineBreak":true},{"text":"熬煉我們，如熬煉銀子一樣。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你使我們進入網羅，","poem":1},{"lineBreak":true},{"text":"把重擔放在我們的身上。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你使人坐車軋我們的頭；","poem":1},{"lineBreak":true},{"text":"我們經過水火，","poem":1},{"lineBreak":true},{"text":"你卻使我們到豐富之地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我要用燔祭進你的殿，","poem":1},{"lineBreak":true},{"text":"向你還我的願，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"就是在急難時我嘴唇所發的、","poem":1},{"lineBreak":true},{"text":"口中所許的。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我要把肥牛作燔祭，","poem":1},{"lineBreak":true},{"text":"將公羊的香祭獻給你，","poem":1},{"lineBreak":true},{"text":"又把公牛和山羊獻上。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"凡敬畏上帝的人，你們都來聽！","poem":1},{"lineBreak":true},{"text":"我要述說他為我所行的事。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我曾用口求告他；","poem":1},{"lineBreak":true},{"text":"我的舌頭也稱他為高。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我若心裏注重罪孽，","poem":1},{"lineBreak":true},{"text":"主必不聽。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"但上帝實在聽見了；","poem":1},{"lineBreak":true},{"text":"他側耳聽了我禱告的聲音。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"上帝是應當稱頌的！","poem":1},{"lineBreak":true},{"text":"他並沒有推卻我的禱告，","poem":1},{"lineBreak":true},{"text":"也沒有叫他的慈愛離開我。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}