{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":67,"content":[{"type":"heading","content":["感恩的詩"]},{"type":"hebrew_subtitle","content":["一篇詩歌，交與伶長。用絲弦的樂器。"]},{"type":"verse","number":1,"content":[{"text":"願上帝憐憫我們，賜福與我們，","poem":1},{"lineBreak":true},{"text":"用臉光照我們，（細拉）","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"好叫世界得知你的道路，","poem":1},{"lineBreak":true},{"text":"萬國得知你的救恩。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝啊，願列邦稱讚你！","poem":1},{"lineBreak":true},{"text":"願萬民都稱讚你！","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"願萬國都快樂歡呼；","poem":1},{"lineBreak":true},{"text":"因為你必按公正審判萬民，","poem":1},{"lineBreak":true},{"text":"引導世上的萬國。（細拉）","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝啊，願列邦稱讚你！","poem":1},{"lineBreak":true},{"text":"願萬民都稱讚你！","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"地已經出了土產；","poem":1},{"lineBreak":true},{"text":"上帝－就是我們的上帝要賜福與我們。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"上帝要賜福與我們；","poem":1},{"lineBreak":true},{"text":"地的四極都要敬畏他！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}