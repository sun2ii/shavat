{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":68,"content":[{"type":"heading","content":["勝利之歌"]},{"type":"hebrew_subtitle","content":["大衛的詩歌，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"願上帝興起，使他的仇敵四散，","poem":1},{"lineBreak":true},{"text":"叫那恨他的人從他面前逃跑。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他們被驅逐，如煙被風吹散；","poem":1},{"lineBreak":true},{"text":"惡人見上帝之面而消滅，如蠟被火鎔化。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"惟有義人必然歡喜，","poem":1},{"lineBreak":true},{"text":"在上帝面前高興快樂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"你們當向上帝唱詩，歌頌他的名；","poem":1},{"lineBreak":true},{"text":"為那坐車行過曠野的修平大路。","poem":1},{"lineBreak":true},{"text":"他的名是耶和華，","poem":1},{"lineBreak":true},{"text":"要在他面前歡樂！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"上帝在他的聖所作孤兒的父，","poem":1},{"lineBreak":true},{"text":"作寡婦的伸冤者。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"上帝叫孤獨的有家，","poem":1},{"lineBreak":true},{"text":"使被囚的出來享福；","poem":1},{"lineBreak":true},{"text":"惟有悖逆的住在乾燥之地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"上帝啊，你曾在你百姓前頭出來，","poem":1},{"lineBreak":true},{"text":"在曠野行走。（細拉）","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"那時，地見上帝的面而震動，天也落雨；","poem":1},{"lineBreak":true},{"text":"西奈山見以色列上帝的面也震動。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"上帝啊，你降下大雨；","poem":1},{"lineBreak":true},{"text":"你產業以色列疲乏的時候，你使他堅固。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你的會眾住在其中；","poem":1},{"lineBreak":true},{"text":"上帝啊，你的恩惠是為困苦人預備的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"主發命令，","poem":1},{"lineBreak":true},{"text":"傳好信息的婦女成了大群。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"統兵的君王逃跑了，逃跑了；","poem":1},{"lineBreak":true},{"text":"在家等候的婦女分受所奪的。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你們安臥在羊圈的時候，","poem":1},{"lineBreak":true},{"text":"好像鴿子的翅膀鍍白銀，翎毛鍍黃金一般。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"全能者在境內趕散列王的時候，","poem":1},{"lineBreak":true},{"text":"勢如飄雪在撒們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"巴珊山是上帝的山；","poem":1},{"lineBreak":true},{"text":"巴珊山是多峰多嶺的山。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你們多峰多嶺的山哪，","poem":1},{"lineBreak":true},{"text":"為何斜看上帝所願居住的山？","poem":1},{"lineBreak":true},{"text":"耶和華必住這山，直到永遠！","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"上帝的車輦累萬盈千；","poem":1},{"lineBreak":true},{"text":"主在其中，好像在西奈聖山一樣。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你已經升上高天，擄掠仇敵；","poem":1},{"lineBreak":true},{"text":"你在人間，就是在悖逆的人間，受了供獻，","poem":1},{"lineBreak":true},{"text":"叫耶和華上帝可以與他們同住。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"天天背負我們重擔的主，","poem":1},{"lineBreak":true},{"text":"就是拯救我們的上帝，","poem":1},{"lineBreak":true},{"text":"是應當稱頌的！（細拉）","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"上帝是為我們施行諸般救恩的上帝；","poem":1},{"lineBreak":true},{"text":"人能脫離死亡是在乎主耶和華。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"但上帝要打破他仇敵的頭，","poem":1},{"lineBreak":true},{"text":"就是那常犯罪之人的髮頂。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"主說：我要使眾民從巴珊而歸，","poem":1},{"lineBreak":true},{"text":"使他們從深海而回，","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"使你打碎仇敵，你的腳踹在血中，","poem":1},{"lineBreak":true},{"text":"使你狗的舌頭從其中得分。","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"上帝啊，你是我的上帝，我的王；","poem":1},{"lineBreak":true},{"text":"人已經看見你行走，進入聖所。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"歌唱的行在前，作樂的隨在後，","poem":1},{"lineBreak":true},{"text":"都在擊鼓的童女中間。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"從以色列源頭而來的，","poem":1},{"lineBreak":true},{"text":"當在各會中稱頌主上帝！","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"在那裏，有統管他們的小便雅憫，","poem":1},{"lineBreak":true},{"text":"有猶大的首領和他們的群眾，","poem":1},{"lineBreak":true},{"text":"有西布倫的首領，","poem":1},{"lineBreak":true},{"text":"有拿弗他利的首領。","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"以色列的能力是上帝所賜的；","poem":1},{"lineBreak":true},{"text":"上帝啊，求你堅固你為我們所成全的事！","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"因你耶路撒冷的殿，","poem":1},{"lineBreak":true},{"text":"列王必帶貢物獻給你。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"求你叱喝蘆葦中的野獸和群公牛，","poem":1},{"lineBreak":true},{"text":"並列邦中的牛犢。","poem":1},{"lineBreak":true},{"text":"把銀塊踹在腳下；","poem":1},{"lineBreak":true},{"text":"上帝已經趕散好爭戰的列邦。","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"埃及的公侯要出來朝見上帝；","poem":1},{"lineBreak":true},{"text":"古實人要急忙舉手 禱告。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"世上的列國啊， 你們要向上帝歌唱；","poem":1},{"lineBreak":true},{"text":"願你們歌頌主！","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"歌頌那自古駕行在諸天以上的主！","poem":1},{"lineBreak":true},{"text":"他發出聲音，是極大的聲音。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"你們要將能力歸給上帝。","poem":1},{"lineBreak":true},{"text":"他的威榮在以色列之上；","poem":1},{"lineBreak":true},{"text":"他的能力是在穹蒼。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"上帝啊，你從聖所顯為可畏；","poem":1},{"lineBreak":true},{"text":"以色列的上帝是那將力量權能賜給他百姓的。","poem":1},{"lineBreak":true},{"text":"上帝是應當稱頌的！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}