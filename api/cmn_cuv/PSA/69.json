{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":69,"content":[{"type":"heading","content":["求助的禱告"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。調用百合花。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你救我！","poem":1},{"lineBreak":true},{"text":"因為眾水要淹沒我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我陷在深淤泥中，沒有立腳之地；","poem":1},{"lineBreak":true},{"text":"我到了深水中，大水漫過我身。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我因呼求困乏，喉嚨發乾；","poem":1},{"lineBreak":true},{"text":"我因等候上帝，眼睛失明。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"無故恨我的，比我頭髮還多；","poem":1},{"lineBreak":true},{"text":"無理與我為仇、要把我剪除的，甚為強盛。","poem":1},{"lineBreak":true},{"text":"我沒有搶奪的，要叫我償還。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"上帝啊，我的愚昧，你原知道；","poem":1},{"lineBreak":true},{"text":"我的罪愆不能隱瞞。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"萬軍的主－耶和華啊，","poem":1},{"lineBreak":true},{"text":"求你叫那等候你的，不要因我蒙羞！","poem":1},{"lineBreak":true},{"text":"以色列的上帝啊，","poem":1},{"lineBreak":true},{"text":"求你叫那尋求你的，不要因我受辱！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因我為你的緣故受了辱罵，","poem":1},{"lineBreak":true},{"text":"滿面羞愧。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的弟兄看我為外路人；","poem":1},{"lineBreak":true},{"text":"我的同胞看我為外邦人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"因我為你的殿心裏焦急，如同火燒，","poem":1},{"lineBreak":true},{"text":"並且辱罵你人的辱罵都落在我身上。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我哭泣，以禁食刻苦我心；","poem":1},{"lineBreak":true},{"text":"這倒算為我的羞辱。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我拿麻布當衣裳，","poem":1},{"lineBreak":true},{"text":"就成了他們的笑談。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"坐在城門口的談論我；","poem":1},{"lineBreak":true},{"text":"酒徒也以我為歌曲。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"但我在悅納的時候向你－耶和華祈禱。","poem":1},{"lineBreak":true},{"text":"上帝啊，求你按你豐盛的慈愛，","poem":1},{"lineBreak":true},{"text":"憑你拯救的誠實應允我！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"求你搭救我出離淤泥，","poem":1},{"lineBreak":true},{"text":"不叫我陷在其中；","poem":1},{"lineBreak":true},{"text":"求你使我脫離那些恨我的人，","poem":1},{"lineBreak":true},{"text":"使我出離深水。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"求你不容大水漫過我，","poem":1},{"lineBreak":true},{"text":"不容深淵吞滅我，","poem":1},{"lineBreak":true},{"text":"不容坑坎在我以上合口。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"耶和華啊，求你應允我！","poem":1},{"lineBreak":true},{"text":"因為你的慈愛本為美好；","poem":1},{"lineBreak":true},{"text":"求你按你豐盛的慈悲回轉眷顧我！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"不要掩面不顧你的僕人；","poem":1},{"lineBreak":true},{"text":"我是在急難之中，求你速速地應允我！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"求你親近我，救贖我！","poem":1},{"lineBreak":true},{"text":"求你因我的仇敵把我贖回！","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"你知道我受的辱罵、欺凌、羞辱；","poem":1},{"lineBreak":true},{"text":"我的敵人都在你面前。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"辱罵傷破了我的心，","poem":1},{"lineBreak":true},{"text":"我又滿了憂愁。","poem":1},{"lineBreak":true},{"text":"我指望有人體恤，卻沒有一個；","poem":1},{"lineBreak":true},{"text":"我指望有人安慰，卻找不着一個。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他們拿苦膽給我當食物；","poem":1},{"lineBreak":true},{"text":"我渴了，他們拿醋給我喝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"願他們的筵席在他們面前變為網羅，","poem":1},{"lineBreak":true},{"text":"在他們平安的時候變為機檻。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"願他們的眼睛昏矇，不得看見；","poem":1},{"lineBreak":true},{"text":"願你使他們的腰常常戰抖。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"求你將你的惱恨倒在他們身上，","poem":1},{"lineBreak":true},{"text":"叫你的烈怒追上他們。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"願他們的住處變為荒場；","poem":1},{"lineBreak":true},{"text":"願他們的帳棚無人居住。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"因為，你所擊打的，他們就逼迫；","poem":1},{"lineBreak":true},{"text":"你所擊傷的，他們戲說他的愁苦。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"願你在他們的罪上加罪，","poem":1},{"lineBreak":true},{"text":"不容他們在你面前稱義。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"願他們從生命冊上被塗抹，","poem":1},{"lineBreak":true},{"text":"不得記錄在義人之中。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"但我是困苦憂傷的；","poem":1},{"lineBreak":true},{"text":"上帝啊，願你的救恩將我安置在高處。","poem":1}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"我要以詩歌讚美上帝的名，","poem":1},{"lineBreak":true},{"text":"以感謝稱他為大！","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"這便叫耶和華喜悅，勝似獻牛，","poem":1},{"lineBreak":true},{"text":"或是獻有角有蹄的公牛。","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"謙卑的人看見了就喜樂；","poem":1},{"lineBreak":true},{"text":"尋求上帝的人，願你們的心甦醒。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"因為耶和華聽了窮乏人，","poem":1},{"lineBreak":true},{"text":"不藐視被囚的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"願天和地、","poem":1},{"lineBreak":true},{"text":"洋海和其中一切的動物都讚美他！","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"因為上帝要拯救錫安，建造猶大的城邑；","poem":1},{"lineBreak":true},{"text":"他的民要在那裏居住，得以為業。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他僕人的後裔要承受為業；","poem":1},{"lineBreak":true},{"text":"愛他名的人也要住在其中。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}