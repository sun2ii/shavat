{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":7,"content":[{"type":"heading","content":["為公義而祈禱"]},{"type":"hebrew_subtitle","content":["大衛指着便雅憫人古實的話，向耶和華唱的流離歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和華－我的上帝啊，我投靠你！","poem":1},{"lineBreak":true},{"text":"求你救我脫離一切追趕我的人，將我救拔出來！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"恐怕他們像獅子撕裂我，","poem":1},{"lineBreak":true},{"text":"甚至撕碎，無人搭救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和華－我的上帝啊，我若行了這事，","poem":1},{"lineBreak":true},{"text":"若有罪孽在我手裏，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我若以惡報那與我交好的人－","poem":1},{"lineBreak":true},{"text":"連那無故與我為敵的，我也救了他，","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"就任憑仇敵追趕我，直到追上，","poem":1},{"lineBreak":true},{"text":"將我的性命踏在地下，","poem":1},{"lineBreak":true},{"text":"使我的榮耀歸於灰塵。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"耶和華啊，求你在怒中起來，","poem":1},{"lineBreak":true},{"text":"挺身而立，抵擋我敵人的暴怒！","poem":1},{"lineBreak":true},{"text":"求你為我興起！你已經命定施行審判！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"願眾民的會環繞你！","poem":1},{"lineBreak":true},{"text":"願你從其上歸於高位！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華向眾民施行審判；","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你按我的公義和我心中的純正判斷我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"願惡人的惡斷絕！","poem":1},{"lineBreak":true},{"text":"願你堅立義人！","poem":1},{"lineBreak":true},{"text":"因為公義的上帝察驗人的心腸肺腑。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝是我的盾牌；","poem":1},{"lineBreak":true},{"text":"他拯救心裏正直的人。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"上帝是公義的審判者，","poem":1},{"lineBreak":true},{"text":"又是天天向惡人發怒的上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"若有人不回頭，他的刀必磨快，","poem":1},{"lineBreak":true},{"text":"弓必上弦，預備妥當了。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他也預備了殺人的器械；","poem":1},{"lineBreak":true},{"text":"他所射的是火箭。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"試看惡人因奸惡而劬勞，","poem":1},{"lineBreak":true},{"text":"所懷的是毒害，所生的是虛假。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他掘了坑，又挖深了，","poem":1},{"lineBreak":true},{"text":"竟掉在自己所挖的阱裏。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他的毒害必臨到他自己的頭上；","poem":1},{"lineBreak":true},{"text":"他的強暴必落到他自己的腦袋上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"我要照着耶和華的公義稱謝他，","poem":1},{"lineBreak":true},{"text":"歌頌耶和華至高者的名。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}