{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":70,"content":[{"type":"heading","content":["求助的祈禱"]},{"type":"hebrew_subtitle","content":["大衛的紀念詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你快快搭救我！","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你速速幫助我！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願那些尋索我命的，抱愧蒙羞；","poem":1},{"lineBreak":true},{"text":"願那些喜悅我遭害的，退後受辱。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"願那些對我說阿哈、阿哈的，","poem":1},{"lineBreak":true},{"text":"因羞愧退後。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"願一切尋求你的，因你高興歡喜；","poem":1},{"lineBreak":true},{"text":"願那些喜愛你救恩的，常說：當尊上帝為大！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"但我是困苦窮乏的；","poem":1},{"lineBreak":true},{"text":"上帝啊，求你速速到我這裏來！","poem":1},{"lineBreak":true},{"text":"你是幫助我的，搭救我的。","poem":1},{"lineBreak":true},{"text":"耶和華啊，求你不要耽延！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}