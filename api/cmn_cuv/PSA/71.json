{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":71,"content":[{"type":"heading","content":["老年人的祈禱"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，我投靠你；","poem":1},{"lineBreak":true},{"text":"求你叫我永不羞愧！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你憑你的公義搭救我，救拔我；","poem":1},{"lineBreak":true},{"text":"側耳聽我，拯救我！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"求你作我常住的磐石；","poem":1},{"lineBreak":true},{"text":"你已經命定要救我，","poem":1},{"lineBreak":true},{"text":"因為你是我的巖石，我的山寨。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我的上帝啊，求你救我脫離惡人的手，","poem":1},{"lineBreak":true},{"text":"脫離不義和殘暴之人的手。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"主－耶和華啊，你是我所盼望的；","poem":1},{"lineBreak":true},{"text":"從我年幼，你是我所倚靠的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我從出母胎被你扶持；","poem":1},{"lineBreak":true},{"text":"使我出母腹的是你。","poem":1},{"lineBreak":true},{"text":"我必常常讚美你！","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"許多人以我為怪，","poem":1},{"lineBreak":true},{"text":"但你是我堅固的避難所。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你的讚美，你的榮耀","poem":1},{"lineBreak":true},{"text":"終日必滿了我的口。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我年老的時候，求你不要丟棄我！","poem":1},{"lineBreak":true},{"text":"我力氣衰弱的時候，求你不要離棄我！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我的仇敵議論我；","poem":1},{"lineBreak":true},{"text":"那些窺探要害我命的彼此商議，","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"說：上帝已經離棄他；","poem":1},{"lineBreak":true},{"text":"我們追趕他，捉拿他吧！","poem":1},{"lineBreak":true},{"text":"因為沒有人搭救。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"上帝啊，求你不要遠離我！","poem":1},{"lineBreak":true},{"text":"我的上帝啊，求你速速幫助我！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"願那與我性命為敵的，羞愧被滅；","poem":1},{"lineBreak":true},{"text":"願那謀害我的，受辱蒙羞。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我卻要常常盼望，","poem":1},{"lineBreak":true},{"text":"並要越發讚美你。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我的口終日要述說你的公義和你的救恩，","poem":1},{"lineBreak":true},{"text":"因我不計其數。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要來說主－耶和華大能的事；","poem":1},{"lineBreak":true},{"text":"我單要提說你的公義。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"上帝啊，自我年幼時，你就教訓我；","poem":1},{"lineBreak":true},{"text":"直到如今，我傳揚你奇妙的作為。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"上帝啊，我到年老髮白的時候，","poem":1},{"lineBreak":true},{"text":"求你不要離棄我！","poem":1},{"lineBreak":true},{"text":"等我將你的能力指示下代，","poem":1},{"lineBreak":true},{"text":"將你的大能指示後世的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"上帝啊，你的公義甚高；","poem":1},{"lineBreak":true},{"text":"行過大事的上帝啊，誰能像你！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你是叫我們多經歷重大急難的，","poem":1},{"lineBreak":true},{"text":"必使我們復活，","poem":1},{"lineBreak":true},{"text":"從地的深處救上來。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"求你使我越發昌大，","poem":1},{"lineBreak":true},{"text":"又轉來安慰我。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"我的上帝啊，我要鼓瑟稱讚你，","poem":1},{"lineBreak":true},{"text":"稱讚你的誠實！","poem":1},{"lineBreak":true},{"text":"以色列的聖者啊，我要彈琴歌頌你！","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"我歌頌你的時候，","poem":1},{"lineBreak":true},{"text":"我的嘴唇和你所贖我的靈魂都必歡呼；","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"並且我的舌頭必終日講論你的公義，","poem":1},{"lineBreak":true},{"text":"因為那些謀害我的人已經蒙羞受辱了。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}