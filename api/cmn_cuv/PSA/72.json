{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":72,"content":[{"type":"heading","content":["為王祈禱"]},{"type":"hebrew_subtitle","content":["所羅門的詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你將判斷的權柄賜給王，","poem":1},{"lineBreak":true},{"text":"將公義賜給王的兒子。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"他要按公義審判你的民，","poem":1},{"lineBreak":true},{"text":"按公平審判你的困苦人。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"大山小山都要因公義使民得享平安。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他必為民中的困苦人伸冤，","poem":1},{"lineBreak":true},{"text":"拯救窮乏之輩，","poem":1},{"lineBreak":true},{"text":"壓碎那欺壓人的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"太陽還存，月亮還在，","poem":1},{"lineBreak":true},{"text":"人要敬畏你，直到萬代！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他必降臨，像雨降在已割的草地上，","poem":1},{"lineBreak":true},{"text":"如甘霖滋潤田地。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"在他的日子，義人要發旺，","poem":1},{"lineBreak":true},{"text":"大有平安，好像月亮長存。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"他要執掌權柄，從這海直到那海，","poem":1},{"lineBreak":true},{"text":"從大河直到地極。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"住在曠野的，必在他面前下拜；","poem":1},{"lineBreak":true},{"text":"他的仇敵必要舔土。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他施和海島的王要進貢；","poem":1},{"lineBreak":true},{"text":"示巴和西巴的王要獻禮物。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"諸王都要叩拜他；","poem":1},{"lineBreak":true},{"text":"萬國都要事奉他。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"因為，窮乏人呼求的時候，他要搭救；","poem":1},{"lineBreak":true},{"text":"沒有人幫助的困苦人，他也要搭救。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他要憐恤貧寒和窮乏的人，","poem":1},{"lineBreak":true},{"text":"拯救窮苦人的性命。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他要救贖他們脫離欺壓和強暴；","poem":1},{"lineBreak":true},{"text":"他們的血在他眼中看為寶貴。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"他們要存活。","poem":1},{"lineBreak":true},{"text":"示巴的金子要奉給他；","poem":1},{"lineBreak":true},{"text":"人要常常為他禱告，終日稱頌他。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"在地的山頂上，五穀必然茂盛","poem":1},{"noteId":27},{"text":"；","poem":1},{"lineBreak":true},{"text":"所結的穀實要響動，如黎巴嫩的樹林；","poem":1},{"lineBreak":true},{"text":"城裏的人要發旺，如地上的草。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"他的名要存到永遠，","poem":1},{"lineBreak":true},{"text":"要留傳如日之久。","poem":1},{"lineBreak":true},{"text":"人要因他蒙福；","poem":1},{"lineBreak":true},{"text":"萬國要稱他有福。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"獨行奇事的耶和華－以色列的上帝","poem":1},{"lineBreak":true},{"text":"是應當稱頌的！","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他榮耀的名也當稱頌，直到永遠。","poem":1},{"lineBreak":true},{"text":"願他的榮耀充滿全地！","poem":1},{"lineBreak":true},{"text":"阿們！阿們！","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"耶西的兒子－大衛的祈禱完畢。","poem":1}]}],"footnotes":[{"noteId":27,"caller":"-","text":"或譯：有一把五穀","reference":{"chapter":72,"verse":16}}]},"thisChapterLink":"/api/cmn_cuv/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}