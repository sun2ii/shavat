{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":73,"content":[{"type":"heading","content":["上帝的公正"]},{"type":"hebrew_subtitle","content":["亞薩的詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝實在恩待以色列那些清心的人！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"至於我，我的腳幾乎失閃；","poem":1},{"lineBreak":true},{"text":"我的腳險些滑跌。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"我見惡人和狂傲人享平安就心懷不平。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他們死的時候沒有疼痛；","poem":1},{"lineBreak":true},{"text":"他們的力氣卻也壯實。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們不像別人受苦，","poem":1},{"lineBreak":true},{"text":"也不像別人遭災。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"所以，驕傲如鏈子戴在他們的項上；","poem":1},{"lineBreak":true},{"text":"強暴像衣裳遮住他們的身體。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們的眼睛因體胖而凸出；","poem":1},{"lineBreak":true},{"text":"他們所得的，過於心裏所想的。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們譏笑人，憑惡意說欺壓人的話；","poem":1},{"lineBreak":true},{"text":"他們說話自高。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他們的口褻瀆上天；","poem":1},{"lineBreak":true},{"text":"他們的舌毀謗全地。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"所以上帝的民歸到這裏，","poem":1},{"lineBreak":true},{"text":"喝盡了滿杯的苦水。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他們說：上帝怎能曉得？","poem":1},{"lineBreak":true},{"text":"至高者豈有知識呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"看哪，這就是惡人；","poem":1},{"lineBreak":true},{"text":"他們既是常享安逸，財寶便加增。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我實在徒然潔淨了我的心，","poem":1},{"lineBreak":true},{"text":"徒然洗手表明無辜。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因為，我終日遭災難；","poem":1},{"lineBreak":true},{"text":"每早晨受懲治。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"我若說，我要這樣講，","poem":1},{"lineBreak":true},{"text":"這就是以奸詐待你的眾子。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我思索怎能明白這事，","poem":1},{"lineBreak":true},{"text":"眼看實係為難，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"等我進了上帝的聖所，","poem":1},{"lineBreak":true},{"text":"思想他們的結局。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你實在把他們安在滑地，","poem":1},{"lineBreak":true},{"text":"使他們掉在沉淪之中。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"他們轉眼之間成了何等的荒涼！","poem":1},{"lineBreak":true},{"text":"他們被驚恐滅盡了。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"人睡醒了，怎樣看夢；","poem":1},{"lineBreak":true},{"text":"主啊，你醒了也必照樣輕看他們的影像。","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"因而，我心裏發酸，","poem":1},{"lineBreak":true},{"text":"肺腑被刺。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"我這樣愚昧無知，","poem":1},{"lineBreak":true},{"text":"在你面前如畜類一般。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"然而，我常與你同在；","poem":1},{"lineBreak":true},{"text":"你攙着我的右手。","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"你要以你的訓言引導我，","poem":1},{"lineBreak":true},{"text":"以後必接我到榮耀裏。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"除你以外，在天上我有誰呢？","poem":1},{"lineBreak":true},{"text":"除你以外，在地上我也沒有所愛慕的。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"我的肉體和我的心腸衰殘；","poem":1},{"lineBreak":true},{"text":"但上帝是我心裏的力量，","poem":1},{"lineBreak":true},{"text":"又是我的福分，直到永遠。","poem":1}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"遠離你的，必要死亡；","poem":1},{"lineBreak":true},{"text":"凡離棄你行邪淫的，你都滅絕了。","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"但我親近上帝是與我有益；","poem":1},{"lineBreak":true},{"text":"我以主耶和華為我的避難所，","poem":1},{"lineBreak":true},{"text":"好叫我述說你一切的作為。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}