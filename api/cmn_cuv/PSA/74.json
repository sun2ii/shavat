{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":74,"content":[{"type":"heading","content":["求主解救國家"]},{"type":"hebrew_subtitle","content":["亞薩的訓誨詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，你為何永遠丟棄我們呢？","poem":1},{"lineBreak":true},{"text":"你為何向你草場的羊發怒，如煙冒出呢？","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"求你記念你古時所得來的會眾，","poem":1},{"lineBreak":true},{"text":"就是你所贖、作你產業支派的，","poem":1},{"lineBreak":true},{"text":"並記念你向來所居住的錫安山。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"求你舉步去看那日久荒涼之地，","poem":1},{"lineBreak":true},{"text":"仇敵在聖所中所行的一切惡事。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"你的敵人在你會中吼叫；","poem":1},{"lineBreak":true},{"text":"他們豎了自己的旗為記號。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們好像人揚起斧子，","poem":1},{"lineBreak":true},{"text":"砍伐林中的樹。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"聖所中一切雕刻的，","poem":1},{"lineBreak":true},{"text":"他們現在用斧子錘子打壞了。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們用火焚燒你的聖所，","poem":1},{"lineBreak":true},{"text":"褻瀆你名的居所，拆毀到地。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他們心裏說：我們要盡行毀滅；","poem":1},{"lineBreak":true},{"text":"他們就在遍地把上帝的會所都燒毀了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我們不見我們的標幟，不再有先知；","poem":1},{"lineBreak":true},{"text":"我們內中也沒有人知道這災禍要到幾時呢！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"上帝啊，敵人辱罵要到幾時呢？","poem":1},{"lineBreak":true},{"text":"仇敵褻瀆你的名要到永遠嗎？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"你為甚麼縮回你的右手？","poem":1},{"lineBreak":true},{"text":"求你從懷中伸出來，毀滅他們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"上帝自古以來為我的王，","poem":1},{"lineBreak":true},{"text":"在地上施行拯救。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你曾用能力將海分開，","poem":1},{"lineBreak":true},{"text":"將水中大魚的頭打破。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你曾砸碎鱷魚的頭，","poem":1},{"lineBreak":true},{"text":"把牠給曠野的禽獸","poem":1},{"noteId":28},{"text":"為食物。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你曾分裂磐石，水便成了溪河；","poem":1},{"lineBreak":true},{"text":"你使長流的江河乾了。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"白晝屬你，黑夜也屬你；","poem":1},{"lineBreak":true},{"text":"亮光和日頭是你所預備的。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"地的一切疆界是你所立的；","poem":1},{"lineBreak":true},{"text":"夏天和冬天是你所定的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"耶和華啊，仇敵辱罵，","poem":1},{"lineBreak":true},{"text":"愚頑民褻瀆了你的名，求你記念這事。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"不要將你斑鳩的性命交給野獸；","poem":1},{"lineBreak":true},{"text":"不要永遠忘記你困苦人的性命。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"求你顧念所立的約，","poem":1},{"lineBreak":true},{"text":"因為地上黑暗之處都滿了強暴的居所。","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"不要叫受欺壓的人蒙羞回去；","poem":1},{"lineBreak":true},{"text":"要叫困苦窮乏的人讚美你的名。","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"上帝啊，求你起來為自己伸訴！","poem":1},{"lineBreak":true},{"text":"要記念愚頑人怎樣終日辱罵你。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"不要忘記你敵人的聲音；","poem":1},{"lineBreak":true},{"text":"那起來敵你之人的喧嘩時常上升。","poem":1}]}],"footnotes":[{"noteId":28,"caller":"-","text":"禽獸：原文是民","reference":{"chapter":74,"verse":14}}]},"thisChapterLink":"/api/cmn_cuv/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}