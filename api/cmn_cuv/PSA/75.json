{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":75,"content":[{"type":"heading","content":["上帝是審判者"]},{"type":"hebrew_subtitle","content":["亞薩的詩歌，交與伶長。調用休要毀壞。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，我們稱謝你，我們稱謝你！","poem":1},{"lineBreak":true},{"text":"因為你的名相近，人都述說你奇妙的作為。","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"我到了所定的日期，","poem":1},{"lineBreak":true},{"text":"必按正直施行審判。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"地和其上的居民都消化了；","poem":1},{"lineBreak":true},{"text":"我曾立了地的柱子。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我對狂傲人說：不要行事狂傲！","poem":1},{"lineBreak":true},{"text":"對凶惡人說：不要舉角！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"不要把你們的角高舉；","poem":1},{"lineBreak":true},{"text":"不要挺着頸項說話。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"因為高舉非從東，非從西，","poem":1},{"lineBreak":true},{"text":"也非從南而來。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"惟有上帝斷定；","poem":1},{"lineBreak":true},{"text":"他使這人降卑，使那人升高。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華手裏有杯，","poem":1},{"lineBreak":true},{"text":"其中的酒起沫，杯內滿了攙雜的酒；","poem":1},{"lineBreak":true},{"text":"他倒出來，","poem":1},{"lineBreak":true},{"text":"地上的惡人必都喝這酒的渣滓，而且喝盡。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"但我要宣揚，直到永遠！","poem":1},{"lineBreak":true},{"text":"我要歌頌雅各的上帝！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"惡人一切的角，我要砍斷；","poem":1},{"lineBreak":true},{"text":"惟有義人的角必被高舉。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}