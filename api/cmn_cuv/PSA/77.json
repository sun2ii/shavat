{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":77,"content":[{"type":"heading","content":["遇難時得安慰"]},{"type":"hebrew_subtitle","content":["亞薩的詩，照耶杜頓的作法，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"我要向上帝發聲呼求；","poem":1},{"lineBreak":true},{"text":"我向上帝發聲，他必留心聽我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我在患難之日尋求主；","poem":1},{"lineBreak":true},{"text":"我在夜間不住地舉手禱告；","poem":1},{"lineBreak":true},{"text":"我的心不肯受安慰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"我想念上帝，就煩燥不安；","poem":1},{"lineBreak":true},{"text":"我沉吟悲傷，心便發昏。（細拉）","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你叫我不能閉眼；","poem":1},{"lineBreak":true},{"text":"我煩亂不安，甚至不能說話。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我追想古時之日，","poem":1},{"lineBreak":true},{"text":"上古之年。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我想起我夜間的歌曲，捫心自問；","poem":1},{"lineBreak":true},{"text":"我心裏也仔細省察。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"難道主要永遠丟棄我，","poem":1},{"lineBreak":true},{"text":"不再施恩嗎？","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"難道他的慈愛永遠窮盡，","poem":1},{"lineBreak":true},{"text":"他的應許世世廢棄嗎？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"難道上帝忘記開恩，","poem":1},{"lineBreak":true},{"text":"因發怒就止住他的慈悲嗎？（細拉）","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我便說：這是我的懦弱，","poem":1},{"lineBreak":true},{"text":"但我要追念至高者顯出右手之年代。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"我要提說耶和華所行的；","poem":1},{"lineBreak":true},{"text":"我要記念你古時的奇事。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我也要思想你的經營，","poem":1},{"lineBreak":true},{"text":"默念你的作為。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"上帝啊，你的作為是潔淨的；","poem":1},{"lineBreak":true},{"text":"有何神大如上帝呢？","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"你是行奇事的上帝；","poem":1},{"lineBreak":true},{"text":"你曾在列邦中彰顯你的能力。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你曾用你的膀臂贖了你的民，","poem":1},{"lineBreak":true},{"text":"就是雅各和約瑟的子孫。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"上帝啊，諸水見你，","poem":1},{"lineBreak":true},{"text":"一見就都驚惶；","poem":1},{"lineBreak":true},{"text":"深淵也都戰抖。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"雲中倒出水來；","poem":1},{"lineBreak":true},{"text":"天空發出響聲；","poem":1},{"lineBreak":true},{"text":"你的箭也飛行四方。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你的雷聲在旋風中；","poem":1},{"lineBreak":true},{"text":"電光照亮世界；","poem":1},{"lineBreak":true},{"text":"大地戰抖震動。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"你的道在海中；","poem":1},{"lineBreak":true},{"text":"你的路在大水中；","poem":1},{"lineBreak":true},{"text":"你的腳蹤無人知道。","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"你曾藉摩西和亞倫的手引導你的百姓，","poem":1},{"lineBreak":true},{"text":"好像羊群一般。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}