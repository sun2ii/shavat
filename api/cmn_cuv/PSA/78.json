{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":78,"content":[{"type":"heading","content":["上帝與他的子民"]},{"type":"hebrew_subtitle","content":["亞薩的訓誨詩。"]},{"type":"verse","number":1,"content":[{"text":"我的民哪，你們要留心聽我的訓誨，","poem":1},{"lineBreak":true},{"text":"側耳聽我口中的話。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要開口說比喻；","poem":1},{"lineBreak":true},{"text":"我要說出古時的謎語，","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"是我們所聽見、所知道的，","poem":1},{"lineBreak":true},{"text":"也是我們的祖宗告訴我們的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我們不將這些事向他們的子孫隱瞞，","poem":1},{"lineBreak":true},{"text":"要將耶和華的美德和他的能力，","poem":1},{"lineBreak":true},{"text":"並他奇妙的作為，述說給後代聽。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"因為，他在雅各中立法度，","poem":1},{"lineBreak":true},{"text":"在以色列中設律法；","poem":1},{"lineBreak":true},{"text":"是他吩咐我們祖宗要傳給子孫的，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"使將要生的後代子孫可以曉得；","poem":1},{"lineBreak":true},{"text":"他們也要起來告訴他們的子孫，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"好叫他們仰望上帝，","poem":1},{"lineBreak":true},{"text":"不忘記上帝的作為，","poem":1},{"lineBreak":true},{"text":"惟要守他的命令。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"不要像他們的祖宗，","poem":1},{"lineBreak":true},{"text":"是頑梗悖逆、居心不正之輩，","poem":1},{"lineBreak":true},{"text":"向着上帝，心不誠實。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"以法蓮的子孫帶着兵器，拿着弓，","poem":1},{"lineBreak":true},{"text":"臨陣之日轉身退後。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們不遵守上帝的約，","poem":1},{"lineBreak":true},{"text":"不肯照他的律法行；","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"又忘記他所行的","poem":1},{"lineBreak":true},{"text":"和他顯給他們奇妙的作為。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他在埃及地，在瑣安田，","poem":1},{"lineBreak":true},{"text":"在他們祖宗的眼前施行奇事。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他將海分裂，使他們過去，","poem":1},{"lineBreak":true},{"text":"又叫水立起如壘。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他白日用雲彩，","poem":1},{"lineBreak":true},{"text":"終夜用火光引導他們。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他在曠野分裂磐石，","poem":1},{"lineBreak":true},{"text":"多多地給他們水喝，如從深淵而出。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他使水從磐石湧出，","poem":1},{"lineBreak":true},{"text":"叫水如江河下流。","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"他們卻仍舊得罪他，","poem":1},{"lineBreak":true},{"text":"在乾燥之地悖逆至高者。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"他們心中試探上帝，","poem":1},{"lineBreak":true},{"text":"隨自己所欲的求食物，","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"並且妄論上帝說：","poem":1},{"lineBreak":true},{"text":"上帝在曠野豈能擺設筵席嗎？","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"他曾擊打磐石，使水湧出，成了江河；","poem":1},{"lineBreak":true},{"text":"他還能賜糧食嗎？","poem":1},{"lineBreak":true},{"text":"還能為他的百姓預備肉嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"所以，耶和華聽見就發怒；","poem":1},{"lineBreak":true},{"text":"有烈火向雅各燒起；","poem":1},{"lineBreak":true},{"text":"有怒氣向以色列上騰；","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"因為他們不信服上帝，","poem":1},{"lineBreak":true},{"text":"不倚賴他的救恩。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他卻吩咐天空，","poem":1},{"lineBreak":true},{"text":"又敞開天上的門，","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"降嗎哪，像雨給他們吃，","poem":1},{"lineBreak":true},{"text":"將天上的糧食賜給他們。","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"各人","poem":1},{"noteId":29},{"text":"吃大能者的食物；","poem":1},{"lineBreak":true},{"text":"他賜下糧食，使他們飽足。","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"他領東風起在天空，","poem":1},{"lineBreak":true},{"text":"又用能力引了南風來。","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"他降肉，像雨在他們當中，多如塵土，","poem":1},{"lineBreak":true},{"text":"又降飛鳥，多如海沙，","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"落在他們的營中，","poem":1},{"lineBreak":true},{"text":"在他們住處的四面。","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"他們吃了，而且飽足；","poem":1},{"lineBreak":true},{"text":"這樣就隨了他們所欲的。","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"他們貪而無厭，","poem":1},{"lineBreak":true},{"text":"食物還在他們口中的時候，","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"上帝的怒氣就向他們上騰，","poem":1},{"lineBreak":true},{"text":"殺了他們內中的肥壯人，","poem":1},{"lineBreak":true},{"text":"打倒以色列的少年人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"雖是這樣，他們仍舊犯罪，","poem":1},{"lineBreak":true},{"text":"不信他奇妙的作為。","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"因此，他叫他們的日子全歸虛空，","poem":1},{"lineBreak":true},{"text":"叫他們的年歲盡屬驚恐。","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"他殺他們的時候，他們才求問他，","poem":1},{"lineBreak":true},{"text":"回心轉意，切切地尋求上帝。","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"他們也追念上帝是他們的磐石，","poem":1},{"lineBreak":true},{"text":"至高的上帝是他們的救贖主。","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"他們卻用口諂媚他，","poem":1},{"lineBreak":true},{"text":"用舌向他說謊。","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"因他們的心向他不正，","poem":1},{"lineBreak":true},{"text":"在他的約上也不忠心。","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"但他有憐憫，","poem":1},{"lineBreak":true},{"text":"赦免他們的罪孽，","poem":1},{"lineBreak":true},{"text":"不滅絕他們，","poem":1},{"lineBreak":true},{"text":"而且屢次消他的怒氣，","poem":1},{"lineBreak":true},{"text":"不發盡他的忿怒。","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"他想到他們不過是血氣，","poem":1},{"lineBreak":true},{"text":"是一陣去而不返的風。","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"他們在曠野悖逆他，","poem":1},{"lineBreak":true},{"text":"在荒地叫他擔憂，何其多呢！","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"他們再三試探上帝，","poem":1},{"lineBreak":true},{"text":"惹動以色列的聖者。","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"他們不追念他的能力","poem":1},{"noteId":30},{"lineBreak":true},{"text":"和贖他們脫離敵人的日子；","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"他怎樣在埃及地顯神蹟，","poem":1},{"lineBreak":true},{"text":"在瑣安田顯奇事，","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"把他們的江河並河汊的水都變為血，","poem":1},{"lineBreak":true},{"text":"使他們不能喝。","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"他叫蒼蠅成群落在他們當中，嘬盡他們，","poem":1},{"lineBreak":true},{"text":"又叫青蛙滅了他們，","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"把他們的土產交給螞蚱，","poem":1},{"lineBreak":true},{"text":"把他們辛苦得來的交給蝗蟲。","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"他降冰雹打壞他們的葡萄樹，","poem":1},{"lineBreak":true},{"text":"下嚴霜打壞他們的桑樹，","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"又把他們的牲畜交給冰雹，","poem":1},{"lineBreak":true},{"text":"把他們的群畜交給閃電。","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"他使猛烈的怒氣和忿怒、惱恨、苦難","poem":1},{"lineBreak":true},{"text":"成了一群降災的使者，臨到他們。","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"他為自己的怒氣修平了路，","poem":1},{"lineBreak":true},{"text":"將他們交給瘟疫，","poem":1},{"lineBreak":true},{"text":"使他們死亡，","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"在埃及擊殺一切長子，","poem":1},{"lineBreak":true},{"text":"在含的帳棚中擊殺他們強壯時頭生的。","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"他卻領出自己的民如羊，","poem":1},{"lineBreak":true},{"text":"在曠野引他們如羊群。","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"他領他們穩穩妥妥地，使他們不致害怕；","poem":1},{"lineBreak":true},{"text":"海卻淹沒他們的仇敵。","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"他帶他們到自己聖地的邊界，","poem":1},{"lineBreak":true},{"text":"到他右手所得的這山地。","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"他在他們面前趕出外邦人，","poem":1},{"lineBreak":true},{"text":"用繩子將外邦的地量給他們為業，","poem":1},{"lineBreak":true},{"text":"叫以色列支派的人住在他們的帳棚裏。","poem":1}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"他們仍舊試探、悖逆至高的上帝，","poem":1},{"lineBreak":true},{"text":"不守他的法度，","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"反倒退後，行詭詐，像他們的祖宗一樣；","poem":1},{"lineBreak":true},{"text":"他們改變，如同翻背的弓。","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"因他們的邱壇惹了他的怒氣；","poem":1},{"lineBreak":true},{"text":"因他們雕刻的偶像觸動他的憤恨。","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"上帝聽見就發怒，","poem":1},{"lineBreak":true},{"text":"極其憎惡以色列人。","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"甚至他離棄示羅的帳幕，","poem":1},{"lineBreak":true},{"text":"就是他在人間所搭的帳棚；","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"又將他的約櫃","poem":1},{"noteId":31},{"text":"交與人擄去，","poem":1},{"lineBreak":true},{"text":"將他的榮耀交在敵人手中；","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"並將他的百姓交與刀劍，","poem":1},{"lineBreak":true},{"text":"向他的產業發怒。","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"少年人被火燒滅；","poem":1},{"lineBreak":true},{"text":"處女也無喜歌。","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"祭司倒在刀下，","poem":1},{"lineBreak":true},{"text":"寡婦卻不哀哭。","poem":1}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"那時，主像世人睡醒，","poem":1},{"lineBreak":true},{"text":"像勇士飲酒呼喊。","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"他就打退了他的敵人，","poem":1},{"lineBreak":true},{"text":"叫他們永蒙羞辱；","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"並且他棄掉約瑟的帳棚，","poem":1},{"lineBreak":true},{"text":"不揀選以法蓮支派，","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"卻揀選猶大支派－他所喜愛的錫安山；","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"蓋造他的聖所，好像高峰，","poem":1},{"lineBreak":true},{"text":"又像他建立永存之地；","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"又揀選他的僕人大衛，","poem":1},{"lineBreak":true},{"text":"從羊圈中將他召來，","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"叫他不再跟從那些帶奶的母羊，","poem":1},{"lineBreak":true},{"text":"為要牧養自己的百姓雅各","poem":1},{"lineBreak":true},{"text":"和自己的產業以色列。","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"於是，他按心中的純正牧養他們，","poem":1},{"lineBreak":true},{"text":"用手中的巧妙引導他們。","poem":1}]}],"footnotes":[{"noteId":29,"caller":"-","text":"或譯：人","reference":{"chapter":78,"verse":25}},{"noteId":30,"caller":"-","text":"原文是手","reference":{"chapter":78,"verse":42}},{"noteId":31,"caller":"-","text":"原文是能力","reference":{"chapter":78,"verse":61}}]},"thisChapterLink":"/api/cmn_cuv/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}