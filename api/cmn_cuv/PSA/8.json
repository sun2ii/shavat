{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":8,"content":[{"type":"heading","content":["上帝的榮耀和人的尊貴"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。用迦特樂器。"]},{"type":"verse","number":1,"content":[{"text":"耶和華－我們的主啊，","poem":1},{"lineBreak":true},{"text":"你的名在全地何其美！","poem":1},{"lineBreak":true},{"text":"你將你的榮耀彰顯於天。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你因敵人的緣故，","poem":1},{"lineBreak":true},{"text":"從嬰孩和吃奶的口中，","poem":1},{"lineBreak":true},{"text":"建立了能力，","poem":1},{"lineBreak":true},{"text":"使仇敵和報仇的閉口無言。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"我觀看你指頭所造的天，","poem":1},{"lineBreak":true},{"text":"並你所陳設的月亮星宿，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"便說：人算甚麼，你竟顧念他！","poem":1},{"lineBreak":true},{"text":"世人算甚麼，你竟眷顧他！","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你叫他比天使","poem":1},{"noteId":0},{"text":"微小一點，","poem":1},{"lineBreak":true},{"text":"並賜他榮耀尊貴為冠冕。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你派他管理你手所造的，","poem":1},{"lineBreak":true},{"text":"使萬物，就是一切的牛羊、","poem":1},{"lineBreak":true},{"text":"田野的獸、空中的鳥、海裏的魚，","poem":1},{"lineBreak":true},{"text":"凡經行海道的，都服在他的腳下。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和華－我們的主啊，","poem":1},{"lineBreak":true},{"text":"你的名在全地何其美！","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"或譯：上帝","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/cmn_cuv/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":7}