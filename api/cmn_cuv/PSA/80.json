{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":80,"content":[{"type":"heading","content":["求主復興國家"]},{"type":"hebrew_subtitle","content":["亞薩的詩，交與伶長。調用為證的百合花。"]},{"type":"verse","number":1,"content":[{"text":"領約瑟如領羊群之以色列的牧者啊，求你留心聽！","poem":1},{"lineBreak":true},{"text":"坐在二基路伯上的啊，求你發出光來！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"在以法蓮、便雅憫、瑪拿西前面","poem":1},{"lineBreak":true},{"text":"施展你的大能，來救我們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"上帝啊，求你使我們回轉","poem":1},{"noteId":32},{"text":"，","poem":1},{"lineBreak":true},{"text":"使你的臉發光，我們便要得救！","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"耶和華－萬軍之上帝啊，","poem":1},{"lineBreak":true},{"text":"你向你百姓的禱告發怒，要到幾時呢？","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你以眼淚當食物給他們吃，","poem":1},{"lineBreak":true},{"text":"又多量出眼淚給他們喝。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你使鄰邦因我們紛爭；","poem":1},{"lineBreak":true},{"text":"我們的仇敵彼此戲笑。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"萬軍之上帝啊，求你使我們回轉，","poem":1},{"lineBreak":true},{"text":"使你的臉發光，我們便要得救！","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你從埃及挪出一棵葡萄樹，","poem":1},{"lineBreak":true},{"text":"趕出外邦人，把這樹栽上。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你在這樹根前預備了地方，","poem":1},{"lineBreak":true},{"text":"它就深深扎根，爬滿了地。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"它的影子遮滿了山，","poem":1},{"lineBreak":true},{"text":"枝子好像佳美的香柏樹。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"它發出枝子，長到大海，","poem":1},{"lineBreak":true},{"text":"發出蔓子，延到大河。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你為何拆毀這樹的籬笆，","poem":1},{"lineBreak":true},{"text":"任憑一切過路的人摘取？","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"林中出來的野豬把它糟踏；","poem":1},{"lineBreak":true},{"text":"野地的走獸拿它當食物。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"萬軍之上帝啊，求你回轉！","poem":1},{"lineBreak":true},{"text":"從天上垂看，眷顧這葡萄樹，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"保護你右手所栽的","poem":1},{"lineBreak":true},{"text":"和你為自己所堅固的枝子。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"這樹已經被火焚燒，被刀砍伐；","poem":1},{"lineBreak":true},{"text":"他們因你臉上的怒容就滅亡了。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"願你的手扶持你右邊的人，","poem":1},{"lineBreak":true},{"text":"就是你為自己所堅固的人子。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"這樣，我們便不退後離開你；","poem":1},{"lineBreak":true},{"text":"求你救活我們，我們就要求告你的名。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和華－萬軍之上帝啊，求你使我們回轉，","poem":1},{"lineBreak":true},{"text":"使你的臉發光，我們便要得救！","poem":1}]}],"footnotes":[{"noteId":32,"caller":"-","text":"或譯：復興","reference":{"chapter":80,"verse":3}}]},"thisChapterLink":"/api/cmn_cuv/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}