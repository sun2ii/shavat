{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":81,"content":[{"type":"heading","content":["聖潔的詩"]},{"type":"hebrew_subtitle","content":["亞薩的詩，交與伶長。用迦特樂器。"]},{"type":"verse","number":1,"content":[{"text":"你們當向上帝－我們的力量大聲歡呼，","poem":1},{"lineBreak":true},{"text":"向雅各的上帝發聲歡樂！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"唱起詩歌，打手鼓，","poem":1},{"lineBreak":true},{"text":"彈美琴與瑟。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"當在月朔並月望－","poem":1},{"lineBreak":true},{"text":"我們過節的日期吹角，","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因這是為以色列定的律例，","poem":1},{"lineBreak":true},{"text":"是雅各上帝的典章。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他去攻擊埃及地的時候，","poem":1},{"lineBreak":true},{"text":"在約瑟中間立此為證。","poem":1},{"lineBreak":true},{"text":"我在那裏聽見我所不明白的言語：","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"上帝說：我使你的肩得脫重擔，","poem":1},{"lineBreak":true},{"text":"你的手放下筐子。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你在急難中呼求，我就搭救你；","poem":1},{"lineBreak":true},{"text":"我在雷的隱密處應允你，","poem":1},{"lineBreak":true},{"text":"在米利巴水那裏試驗你。（細拉）","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我的民哪，你當聽，我要勸戒你；","poem":1},{"lineBreak":true},{"text":"以色列啊，甚願你肯聽從我。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"在你當中，不可有別的神；","poem":1},{"lineBreak":true},{"text":"外邦的神，你也不可下拜。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我是耶和華－你的上帝，","poem":1},{"lineBreak":true},{"text":"曾把你從埃及地領上來；","poem":1},{"lineBreak":true},{"text":"你要大大張口，我就給你充滿。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"無奈，我的民不聽我的聲音；","poem":1},{"lineBreak":true},{"text":"以色列全不理我。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我便任憑他們心裏剛硬，","poem":1},{"lineBreak":true},{"text":"隨自己的計謀而行。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"甚願我的民肯聽從我，","poem":1},{"lineBreak":true},{"text":"以色列肯行我的道，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我便速速治服他們的仇敵，","poem":1},{"lineBreak":true},{"text":"反手攻擊他們的敵人。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"恨耶和華的人必來投降，","poem":1},{"lineBreak":true},{"text":"但他的百姓必永久長存。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他也必拿上好的麥子給他們吃，","poem":1},{"lineBreak":true},{"text":"又拿從磐石出的蜂蜜叫他們飽足。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}