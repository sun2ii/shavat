{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":82,"content":[{"type":"heading","content":["上帝是最高的主宰"]},{"type":"hebrew_subtitle","content":["亞薩的詩。"]},{"type":"verse","number":1,"content":[{"text":"上帝站在有權力者的會中，","poem":1},{"lineBreak":true},{"text":"在諸神中行審判，","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"說：你們審判不秉公義，","poem":1},{"lineBreak":true},{"text":"徇惡人的情面，要到幾時呢？（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你們當為貧寒的人和孤兒伸冤；","poem":1},{"lineBreak":true},{"text":"當為困苦和窮乏的人施行公義。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"當保護貧寒和窮乏的人，","poem":1},{"lineBreak":true},{"text":"救他們脫離惡人的手。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你們仍不知道，也不明白，","poem":1},{"lineBreak":true},{"text":"在黑暗中走來走去；","poem":1},{"lineBreak":true},{"text":"地的根基都搖動了。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我曾說：你們是神，","poem":1},{"lineBreak":true},{"text":"都是至高者的兒子。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"然而，你們要死，與世人一樣，","poem":1},{"lineBreak":true},{"text":"要仆倒，像王子中的一位。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"上帝啊，求你起來審判世界，","poem":1},{"lineBreak":true},{"text":"因為你要得萬邦為業。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}