{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":83,"content":[{"type":"heading","content":["求主敗敵"]},{"type":"hebrew_subtitle","content":["亞薩的詩歌。"]},{"type":"verse","number":1,"content":[{"text":"上帝啊，求你不要靜默！","poem":1},{"lineBreak":true},{"text":"上帝啊，求你不要閉口，也不要不作聲！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為你的仇敵喧嚷，","poem":1},{"lineBreak":true},{"text":"恨你的抬起頭來。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們同謀奸詐要害你的百姓，","poem":1},{"lineBreak":true},{"text":"彼此商議要害你所隱藏的人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他們說：來吧，我們將他們剪滅，","poem":1},{"lineBreak":true},{"text":"使他們不再成國！","poem":1},{"lineBreak":true},{"text":"使以色列的名不再被人記念！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們同心商議，","poem":1},{"lineBreak":true},{"text":"彼此結盟，要抵擋你，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"就是住帳棚的以東人和以實瑪利人，","poem":1},{"lineBreak":true},{"text":"摩押和夏甲人，","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"迦巴勒、亞捫，","poem":1},{"lineBreak":true},{"text":"和亞瑪力、非利士並泰爾的居民。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"亞述也與他們連合；","poem":1},{"lineBreak":true},{"text":"他們作羅得子孫的幫手。（細拉）","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"求你待他們，如待米甸，","poem":1},{"lineBreak":true},{"text":"如在基順河待西西拉和耶賓一樣。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"他們在隱‧多珥滅亡，","poem":1},{"lineBreak":true},{"text":"成了地上的糞土。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"求你叫他們的首領像俄立和西伊伯，","poem":1},{"lineBreak":true},{"text":"叫他們的王子都像西巴和撒慕拿。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們說：我們要得上帝的住處，","poem":1},{"lineBreak":true},{"text":"作為自己的產業。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"我的上帝啊，求你叫他們像旋風的塵土，","poem":1},{"lineBreak":true},{"text":"像風前的碎稭。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"火怎樣焚燒樹林，","poem":1},{"lineBreak":true},{"text":"火焰怎樣燒着山嶺，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"求你也照樣用狂風追趕他們，","poem":1},{"lineBreak":true},{"text":"用暴雨恐嚇他們。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"願你使他們滿面羞恥，","poem":1},{"lineBreak":true},{"text":"好叫他們尋求你－耶和華的名！","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"願他們永遠羞愧驚惶！","poem":1},{"lineBreak":true},{"text":"願他們慚愧滅亡！","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"使他們知道：惟獨你－","poem":1},{"lineBreak":true},{"text":"名為耶和華的－是全地以上的至高者！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}