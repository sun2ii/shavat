{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":84,"content":[{"type":"heading","content":["渴慕耶和華的殿宇"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩，交與伶長。用迦特樂器。"]},{"type":"verse","number":1,"content":[{"text":"萬軍之耶和華啊，","poem":1},{"lineBreak":true},{"text":"你的居所何等可愛！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我羨慕渴想耶和華的院宇；","poem":1},{"lineBreak":true},{"text":"我的心腸，我的肉體向永生上帝呼籲","poem":1},{"noteId":33},{"text":"。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"萬軍之耶和華－我的王，我的上帝啊，","poem":1},{"lineBreak":true},{"text":"在你祭壇那裏，麻雀為自己找着房屋，","poem":1},{"lineBreak":true},{"text":"燕子為自己找着菢雛之窩。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"如此住在你殿中的便為有福！","poem":1},{"lineBreak":true},{"text":"他們仍要讚美你。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"靠你有力量、心中想往錫安大道的，","poem":1},{"lineBreak":true},{"text":"這人便為有福！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們經過「流淚谷」，叫這谷變為泉源之地；","poem":1},{"lineBreak":true},{"text":"並有秋雨之福蓋滿了全谷。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們行走，力上加力，","poem":1},{"lineBreak":true},{"text":"各人到錫安朝見上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和華－萬軍之上帝啊，求你聽我的禱告！","poem":1},{"lineBreak":true},{"text":"雅各的上帝啊，求你留心聽！（細拉）","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"上帝啊，你是我們的盾牌；","poem":1},{"lineBreak":true},{"text":"求你垂顧觀看你受膏者的面！","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"在你的院宇住一日，","poem":1},{"lineBreak":true},{"text":"勝似在別處住千日；","poem":1},{"lineBreak":true},{"text":"寧可在我上帝殿中看門，","poem":1},{"lineBreak":true},{"text":"不願住在惡人的帳棚裏。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因為耶和華－上帝是日頭，是盾牌，","poem":1},{"lineBreak":true},{"text":"要賜下恩惠和榮耀。","poem":1},{"lineBreak":true},{"text":"他未嘗留下一樣好處不給那些行動正直的人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"萬軍之耶和華啊，","poem":1},{"lineBreak":true},{"text":"倚靠你的人便為有福！","poem":1}]}],"footnotes":[{"noteId":33,"caller":"-","text":"或譯：歡呼","reference":{"chapter":84,"verse":2}}]},"thisChapterLink":"/api/cmn_cuv/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}