{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":85,"content":[{"type":"heading","content":["為國求福"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩，交與伶長。"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，你已經向你的地施恩，","poem":1},{"lineBreak":true},{"text":"救回被擄的雅各。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你赦免了你百姓的罪孽，","poem":1},{"lineBreak":true},{"text":"遮蓋了他們一切的過犯。（細拉）","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你收轉了所發的忿怒","poem":1},{"lineBreak":true},{"text":"和你猛烈的怒氣。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"拯救我們的上帝啊，求你使我們回轉，","poem":1},{"lineBreak":true},{"text":"叫你的惱恨向我們止息。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你要向我們發怒到永遠嗎？","poem":1},{"lineBreak":true},{"text":"你要將你的怒氣延留到萬代嗎？","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你不再將我們救活，","poem":1},{"lineBreak":true},{"text":"使你的百姓靠你歡喜嗎？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶和華啊，求你使我們得見你的慈愛，","poem":1},{"lineBreak":true},{"text":"又將你的救恩賜給我們。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我要聽上帝－耶和華所說的話；","poem":1},{"lineBreak":true},{"text":"因為他必應許將平安賜給他的百姓－他的聖民；","poem":1},{"lineBreak":true},{"text":"他們卻不可再轉去妄行。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"他的救恩誠然與敬畏他的人相近，","poem":1},{"lineBreak":true},{"text":"叫榮耀住在我們的地上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"慈愛和誠實彼此相遇；","poem":1},{"lineBreak":true},{"text":"公義和平安彼此相親。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"誠實從地而生；","poem":1},{"lineBreak":true},{"text":"公義從天而現。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"耶和華必將好處賜給我們；","poem":1},{"lineBreak":true},{"text":"我們的地也要多出土產。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"公義要行在他面前，","poem":1},{"lineBreak":true},{"text":"叫他的腳蹤成為可走的路。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}