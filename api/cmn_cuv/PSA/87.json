{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":87,"content":[{"type":"heading","content":["錫安頌"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩歌。"]},{"type":"verse","number":1,"content":[{"text":"耶和華所立的根基在聖山上。","poem":1}]},{"type":"verse","number":2,"content":[{"text":"他愛錫安的門，","poem":1},{"lineBreak":true},{"text":"勝於愛雅各一切的住處。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"上帝的城啊，","poem":1},{"lineBreak":true},{"text":"有榮耀的事乃指着你說的。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"我要提起拉哈伯和巴比倫人，","poem":1},{"lineBreak":true},{"text":"是在認識我之中的；","poem":1},{"lineBreak":true},{"text":"看哪，非利士和泰爾並古實人，","poem":1},{"lineBreak":true},{"text":"個個生在那裏。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"論到錫安，必說：","poem":1},{"lineBreak":true},{"text":"這一個、那一個都生在其中，","poem":1},{"lineBreak":true},{"text":"而且至高者必親自堅立這城。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"當耶和華記錄萬民的時候，","poem":1},{"lineBreak":true},{"text":"他要點出這一個生在那裏。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"歌唱的，跳舞的，都要說：","poem":1},{"lineBreak":true},{"text":"我的泉源都在你裏面。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}