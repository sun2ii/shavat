{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":88,"content":[{"type":"heading","content":["求主眷顧"]},{"type":"hebrew_subtitle","content":["可拉後裔的詩歌，就是以斯拉人希幔的訓誨詩，交與伶長。調用麻哈拉利暗俄。"]},{"type":"verse","number":1,"content":[{"text":"耶和華－拯救我的上帝啊，","poem":1},{"lineBreak":true},{"text":"我晝夜在你面前呼籲。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"願我的禱告達到你面前；","poem":1},{"lineBreak":true},{"text":"求你側耳聽我的呼求！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"因為我心裏滿了患難；","poem":1},{"lineBreak":true},{"text":"我的性命臨近陰間。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我算和下坑的人同列，","poem":1},{"lineBreak":true},{"text":"如同無力","poem":1},{"noteId":34},{"text":"的人一樣。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我被丟在死人中，","poem":1},{"lineBreak":true},{"text":"好像被殺的人躺在墳墓裏。","poem":1},{"lineBreak":true},{"text":"他們是你不再記念的，","poem":1},{"lineBreak":true},{"text":"與你隔絕了。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"你把我放在極深的坑裏，","poem":1},{"lineBreak":true},{"text":"在黑暗地方，在深處。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的忿怒重壓我身；","poem":1},{"lineBreak":true},{"text":"你用一切的波浪困住我。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你把我所認識的隔在遠處，","poem":1},{"lineBreak":true},{"text":"使我為他們所憎惡；","poem":1},{"lineBreak":true},{"text":"我被拘困，不得出來。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的眼睛因困苦而乾癟。","poem":1},{"lineBreak":true},{"text":"耶和華啊，我天天求告你，向你舉手。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你豈要行奇事給死人看嗎？","poem":1},{"lineBreak":true},{"text":"難道陰魂還能起來稱讚你嗎？（細拉）","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"豈能在墳墓裏述說你的慈愛嗎？","poem":1},{"lineBreak":true},{"text":"豈能在滅亡中述說你的信實嗎？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你的奇事豈能在幽暗裏被知道嗎？","poem":1},{"lineBreak":true},{"text":"你的公義豈能在忘記之地被知道嗎？","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和華啊，我呼求你；","poem":1},{"lineBreak":true},{"text":"我早晨的禱告要達到你面前。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"耶和華啊，你為何丟棄我？","poem":1},{"lineBreak":true},{"text":"為何掩面不顧我？","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"我自幼受苦，幾乎死亡；","poem":1},{"lineBreak":true},{"text":"我受你的驚恐，甚至慌張。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"你的烈怒漫過我身；","poem":1},{"lineBreak":true},{"text":"你的驚嚇把我剪除。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"這些終日如水環繞我，","poem":1},{"lineBreak":true},{"text":"一齊都來圍困我。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"你把我的良朋密友隔在遠處，","poem":1},{"lineBreak":true},{"text":"使我所認識的人進入黑暗裏。","poem":1}]}],"footnotes":[{"noteId":34,"caller":"-","text":"或譯：沒有幫助","reference":{"chapter":88,"verse":4}}]},"thisChapterLink":"/api/cmn_cuv/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}