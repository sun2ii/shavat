{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":9,"content":[{"type":"heading","content":["稱頌耶和華的公義"]},{"type":"hebrew_subtitle","content":["大衛的詩，交與伶長。調用慕拉便。"]},{"type":"verse","number":1,"content":[{"text":"我要一心稱謝耶和華；","poem":1},{"lineBreak":true},{"text":"我要傳揚你一切奇妙的作為。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要因你歡喜快樂；","poem":1},{"lineBreak":true},{"text":"至高者啊，我要歌頌你的名！","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"我的仇敵轉身退去的時候，","poem":1},{"lineBreak":true},{"text":"他們一見你的面就跌倒滅亡。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因你已經為我伸冤，為我辨屈；","poem":1},{"lineBreak":true},{"text":"你坐在寶座上，按公義審判。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你曾斥責外邦，你曾滅絕惡人；","poem":1},{"lineBreak":true},{"text":"你曾塗抹他們的名，直到永永遠遠。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"仇敵到了盡頭；","poem":1},{"lineBreak":true},{"text":"他們被毀壞，直到永遠。","poem":1},{"lineBreak":true},{"text":"你拆毀他們的城邑，","poem":1},{"lineBreak":true},{"text":"連他們的名號都歸於無有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"惟耶和華坐着為王，直到永遠；","poem":1},{"lineBreak":true},{"text":"他已經為審判設擺他的寶座。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"他要按公義審判世界，","poem":1},{"lineBreak":true},{"text":"按正直判斷萬民。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和華又要給受欺壓的人作高臺，","poem":1},{"lineBreak":true},{"text":"在患難的時候作高臺。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"耶和華啊，認識你名的人要倚靠你，","poem":1},{"lineBreak":true},{"text":"因你沒有離棄尋求你的人。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"應當歌頌居錫安的耶和華，","poem":1},{"lineBreak":true},{"text":"將他所行的傳揚在眾民中。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"因為那追討流人血之罪的－他記念受屈的人，","poem":1},{"lineBreak":true},{"text":"不忘記困苦人的哀求。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和華啊，你是從死門把我提拔起來的；","poem":1},{"lineBreak":true},{"text":"求你憐恤我，看那恨我的人所加給我的苦難，","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"好叫我述說你一切的美德；","poem":1},{"lineBreak":true},{"text":"我必在錫安城","poem":1},{"noteId":1},{"text":"的門因你的救恩歡樂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"外邦人陷在自己所掘的坑中；","poem":1},{"lineBreak":true},{"text":"他們的腳在自己暗設的網羅裏纏住了。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"耶和華已將自己顯明了，他已施行審判；","poem":1},{"lineBreak":true},{"text":"惡人被自己手所做的纏住了","poem":1},{"lineBreak":true},{"noteId":2},{"text":"。（細拉）","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"惡人，就是忘記上帝的外邦人，","poem":1},{"lineBreak":true},{"text":"都必歸到陰間。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"窮乏人必不永久被忘；","poem":1},{"lineBreak":true},{"text":"困苦人的指望必不永遠落空。","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"耶和華啊，求你起來，不容人得勝！","poem":1},{"lineBreak":true},{"text":"願外邦人在你面前受審判！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"耶和華啊，求你使外邦人恐懼；","poem":1},{"lineBreak":true},{"text":"願他們知道自己不過是人。（細拉）","poem":1}]}],"footnotes":[{"noteId":1,"caller":"-","text":"原文是女子","reference":{"chapter":9,"verse":14}},{"noteId":2,"caller":"-","text":"或譯：他叫惡人被自己手所做的累住了","reference":{"chapter":9,"verse":16}}]},"thisChapterLink":"/api/cmn_cuv/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}