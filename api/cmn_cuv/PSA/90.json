{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":90,"content":[{"type":"heading","content":["上帝與人"]},{"type":"hebrew_subtitle","content":["神人摩西的祈禱。"]},{"type":"verse","number":1,"content":[{"text":"主啊，你世世代代作我們的居所。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"諸山未曾生出，","poem":1},{"lineBreak":true},{"text":"地與世界你未曾造成，","poem":1},{"lineBreak":true},{"text":"從亙古到永遠，你是上帝。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"你使人歸於塵土，說：","poem":1},{"lineBreak":true},{"text":"你們世人要歸回。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"在你看來，千年如已過的昨日，","poem":1},{"lineBreak":true},{"text":"又如夜間的一更。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"你叫他們如水沖去；","poem":1},{"lineBreak":true},{"text":"他們如睡一覺。","poem":1},{"lineBreak":true},{"text":"早晨，他們如生長的草，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"早晨發芽生長，","poem":1},{"lineBreak":true},{"text":"晚上割下枯乾。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"我們因你的怒氣而消滅，","poem":1},{"lineBreak":true},{"text":"因你的忿怒而驚惶。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你將我們的罪孽擺在你面前，","poem":1},{"lineBreak":true},{"text":"將我們的隱惡擺在你面光之中。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"我們經過的日子都在你震怒之下；","poem":1},{"lineBreak":true},{"text":"我們度盡的年歲好像一聲歎息。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我們一生的年日是七十歲，","poem":1},{"lineBreak":true},{"text":"若是強壯可到八十歲；","poem":1},{"lineBreak":true},{"text":"但其中所矜誇的不過是勞苦愁煩，","poem":1},{"lineBreak":true},{"text":"轉眼成空，我們便如飛而去。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"誰曉得你怒氣的權勢？","poem":1},{"lineBreak":true},{"text":"誰按着你該受的敬畏曉得你的忿怒呢？","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"求你指教我們怎樣數算自己的日子，","poem":1},{"lineBreak":true},{"text":"好叫我們得着智慧的心。","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"耶和華啊，我們要等到幾時呢？","poem":1},{"lineBreak":true},{"text":"求你轉回，為你的僕人後悔。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"求你使我們早早飽得你的慈愛，","poem":1},{"lineBreak":true},{"text":"好叫我們一生一世歡呼喜樂。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"求你照着你使我們受苦的日子，","poem":1},{"lineBreak":true},{"text":"和我們遭難的年歲，叫我們喜樂。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"願你的作為向你僕人顯現；","poem":1},{"lineBreak":true},{"text":"願你的榮耀向他們子孫顯明。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"願主－我們上帝的榮美歸於我們身上。","poem":1},{"lineBreak":true},{"text":"願你堅立我們手所做的工；","poem":1},{"lineBreak":true},{"text":"我們手所做的工，願你堅立。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}