{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":91,"content":[{"type":"heading","content":["上帝是我們的保護者"]},{"type":"verse","number":1,"content":[{"text":"住在至高者隱密處的，","poem":1},{"lineBreak":true},{"text":"必住在全能者的蔭下。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我要論到耶和華說：","poem":1},{"lineBreak":true},{"text":"他是我的避難所，是我的山寨，","poem":1},{"lineBreak":true},{"text":"是我的上帝，是我所倚靠的。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他必救你脫離捕鳥人的網羅","poem":1},{"lineBreak":true},{"text":"和毒害的瘟疫。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他必用自己的翎毛遮蔽你；","poem":1},{"lineBreak":true},{"text":"你要投靠在他的翅膀底下；","poem":1},{"lineBreak":true},{"text":"他的誠實是大小的盾牌。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你必不怕黑夜的驚駭，","poem":1},{"lineBreak":true},{"text":"或是白日飛的箭，","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"也不怕黑夜行的瘟疫，","poem":1},{"lineBreak":true},{"text":"或是午間滅人的毒病。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"雖有千人仆倒在你旁邊，","poem":1},{"lineBreak":true},{"text":"萬人仆倒在你右邊，","poem":1},{"lineBreak":true},{"text":"這災卻不得臨近你。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你惟親眼觀看，","poem":1},{"lineBreak":true},{"text":"見惡人遭報。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和華是我的避難所；","poem":1},{"lineBreak":true},{"text":"你已將至高者當你的居所，","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"禍患必不臨到你，","poem":1},{"lineBreak":true},{"text":"災害也不挨近你的帳棚。","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"因他要為你吩咐他的使者，","poem":1},{"lineBreak":true},{"text":"在你行的一切道路上保護你。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他們要用手托着你，","poem":1},{"lineBreak":true},{"text":"免得你的腳碰在石頭上。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你要踹在獅子和虺蛇的身上，","poem":1},{"lineBreak":true},{"text":"踐踏少壯獅子和大蛇。","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"上帝說：因為他專心愛我，我就要搭救他；","poem":1},{"lineBreak":true},{"text":"因為他知道我的名，我要把他安置在高處。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他若求告我，我就應允他；","poem":1},{"lineBreak":true},{"text":"他在急難中，我要與他同在；","poem":1},{"lineBreak":true},{"text":"我要搭救他，使他尊貴。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"我要使他足享長壽，","poem":1},{"lineBreak":true},{"text":"將我的救恩顯明給他。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}