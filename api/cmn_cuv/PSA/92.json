{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":92,"content":[{"type":"heading","content":["頌讚之詩"]},{"type":"hebrew_subtitle","content":["安息日的詩歌。"]},{"type":"verse","number":1,"content":[{"text":"稱謝耶和華！","poem":1},{"lineBreak":true},{"text":"歌頌你至高者的名！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"用十弦的樂器和瑟，","poem":1},{"lineBreak":true},{"text":"用琴彈幽雅的聲音，","poem":1},{"lineBreak":true},{"text":"早晨傳揚你的慈愛；","poem":1},{"lineBreak":true},{"text":"每夜傳揚你的信實。","poem":1},{"lineBreak":true},{"text":"這本為美事。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因你－耶和華藉着你的作為叫我高興，","poem":1},{"lineBreak":true},{"text":"我要因你手的工作歡呼。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和華啊，你的工作何其大！","poem":1},{"lineBreak":true},{"text":"你的心思極其深！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"畜類人不曉得；","poem":1},{"lineBreak":true},{"text":"愚頑人也不明白。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"惡人茂盛如草，","poem":1},{"lineBreak":true},{"text":"一切作孽之人發旺的時候，","poem":1},{"lineBreak":true},{"text":"正是他們要滅亡，","poem":1},{"lineBreak":true},{"text":"直到永遠。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"惟你－耶和華是至高，","poem":1},{"lineBreak":true},{"text":"直到永遠。","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"耶和華啊，你的仇敵都要滅亡；","poem":1},{"lineBreak":true},{"text":"一切作孽的也要離散。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你卻高舉了我的角，如野牛的角；","poem":1},{"lineBreak":true},{"text":"我是被新油膏了的。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我眼睛看見仇敵遭報；","poem":1},{"lineBreak":true},{"text":"我耳朵聽見那些起來攻擊我的惡人受罰。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"義人要發旺如棕樹，","poem":1},{"lineBreak":true},{"text":"生長如黎巴嫩的香柏樹。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他們栽於耶和華的殿中，","poem":1},{"lineBreak":true},{"text":"發旺在我們上帝的院裏。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他們年老的時候仍要結果子，","poem":1},{"lineBreak":true},{"text":"要滿了汁漿而常發青，","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"好顯明耶和華是正直的。","poem":1},{"lineBreak":true},{"text":"他是我的磐石，在他毫無不義。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":14}