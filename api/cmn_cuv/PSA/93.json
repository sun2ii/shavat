{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":93,"content":[{"type":"heading","content":["上帝是王"]},{"type":"verse","number":1,"content":[{"text":"耶和華作王！","poem":1},{"lineBreak":true},{"text":"他以威嚴為衣穿上；","poem":1},{"lineBreak":true},{"text":"耶和華以能力為衣，以能力束腰，","poem":1},{"lineBreak":true},{"text":"世界就堅定，不得動搖。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你的寶座從太初立定；","poem":1},{"lineBreak":true},{"text":"你從亙古就有。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"耶和華啊，大水揚起，","poem":1},{"lineBreak":true},{"text":"大水發聲，波浪澎湃。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶和華在高處大有能力，","poem":1},{"lineBreak":true},{"text":"勝過諸水的響聲，洋海的大浪。","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"耶和華啊，你的法度最的確；","poem":1},{"lineBreak":true},{"text":"你的殿永稱為聖，是合宜的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}