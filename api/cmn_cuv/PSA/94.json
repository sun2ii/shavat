{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":94,"content":[{"type":"heading","content":["上帝審判萬人"]},{"type":"verse","number":1,"content":[{"text":"耶和華啊，你是伸冤的上帝；","poem":1},{"lineBreak":true},{"text":"伸冤的上帝啊，求你發出光來！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"審判世界的主啊，求你挺身而立，","poem":1},{"lineBreak":true},{"text":"使驕傲人受應得的報應！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"耶和華啊，惡人誇勝要到幾時呢？","poem":1},{"lineBreak":true},{"text":"要到幾時呢？","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"他們絮絮叨叨說傲慢的話；","poem":1},{"lineBreak":true},{"text":"一切作孽的人都自己誇張。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶和華啊，他們強壓你的百姓，","poem":1},{"lineBreak":true},{"text":"苦害你的產業。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他們殺死寡婦和寄居的，","poem":1},{"lineBreak":true},{"text":"又殺害孤兒。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他們說：耶和華必不看見；","poem":1},{"lineBreak":true},{"text":"雅各的上帝必不思念。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"你們民間的畜類人當思想；","poem":1},{"lineBreak":true},{"text":"你們愚頑人到幾時才有智慧呢？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"造耳朵的，難道自己不聽見嗎？","poem":1},{"lineBreak":true},{"text":"造眼睛的，難道自己不看見嗎？","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"管教列邦的，就是叫人得知識的，","poem":1},{"lineBreak":true},{"text":"難道自己不懲治人嗎？","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華知道人的意念是虛妄的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"耶和華啊，你所管教、","poem":1},{"lineBreak":true},{"text":"用律法所教訓的人是有福的！","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你使他在遭難的日子得享平安；","poem":1},{"lineBreak":true},{"text":"惟有惡人陷在所挖的坑中。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"因為耶和華必不丟棄他的百姓，","poem":1},{"lineBreak":true},{"text":"也不離棄他的產業。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"審判要轉向公義；","poem":1},{"lineBreak":true},{"text":"心裏正直的，必都隨從。","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"誰肯為我起來攻擊作惡的？","poem":1},{"lineBreak":true},{"text":"誰肯為我站起抵擋作孽的？","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"若不是耶和華幫助我，","poem":1},{"lineBreak":true},{"text":"我就住在寂靜之中了。","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"我正說我失了腳，","poem":1},{"lineBreak":true},{"text":"耶和華啊，那時你的慈愛扶助我。","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"我心裏多憂多疑，","poem":1},{"lineBreak":true},{"text":"你安慰我，就使我歡樂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"那藉着律例架弄殘害、","poem":1},{"lineBreak":true},{"text":"在位上行奸惡的，豈能與你相交嗎？","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"他們大家聚集攻擊義人，","poem":1},{"lineBreak":true},{"text":"將無辜的人定為死罪。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"但耶和華向來作了我的高臺；","poem":1},{"lineBreak":true},{"text":"我的上帝作了我投靠的磐石。","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"他叫他們的罪孽歸到他們身上。","poem":1},{"lineBreak":true},{"text":"他們正在行惡之中，他要剪除他們；","poem":1},{"lineBreak":true},{"text":"耶和華－我們的上帝要把他們剪除。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}