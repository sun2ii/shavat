{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":95,"content":[{"type":"heading","content":["頌讚之詩"]},{"type":"verse","number":1,"content":[{"text":"來啊，我們要向耶和華歌唱，","poem":1},{"lineBreak":true},{"text":"向拯救我們的磐石歡呼！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我們要來感謝他，","poem":1},{"lineBreak":true},{"text":"用詩歌向他歡呼！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因耶和華為大上帝，","poem":1},{"lineBreak":true},{"text":"為大王，超乎萬神之上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"地的深處在他手中；","poem":1},{"lineBreak":true},{"text":"山的高峰也屬他。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"海洋屬他，是他造的；","poem":1},{"lineBreak":true},{"text":"旱地也是他手造成的。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"來啊，我們要屈身敬拜，","poem":1},{"lineBreak":true},{"text":"在造我們的耶和華面前跪下。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"因為他是我們的上帝；","poem":1},{"lineBreak":true},{"text":"我們是他草場的羊，是他手下的民。","poem":1},{"lineBreak":true},{"text":"惟願你們今天聽他的話：","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"你們不可硬着心，像當日在米利巴，","poem":1},{"lineBreak":true},{"text":"就是在曠野的瑪撒。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"那時，你們的祖宗試我探我，","poem":1},{"lineBreak":true},{"text":"並且觀看我的作為。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"四十年之久，我厭煩那世代，說：","poem":1},{"lineBreak":true},{"text":"這是心裏迷糊的百姓，","poem":1},{"lineBreak":true},{"text":"竟不曉得我的作為！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"所以，我在怒中起誓，說：","poem":1},{"lineBreak":true},{"text":"他們斷不可進入我的安息！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}