{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":96,"content":[{"type":"heading","content":["上帝是最高的君王"]},{"type":"verse","number":1,"content":[{"text":"你們要向耶和華唱新歌！","poem":1},{"lineBreak":true},{"text":"全地都要向耶和華歌唱！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"要向耶和華歌唱，稱頌他的名！","poem":1},{"lineBreak":true},{"text":"天天傳揚他的救恩！","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"在列邦中述說他的榮耀！","poem":1},{"lineBreak":true},{"text":"在萬民中述說他的奇事！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"因耶和華為大，當受極大的讚美；","poem":1},{"lineBreak":true},{"text":"他在萬神之上，當受敬畏。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"外邦的神都屬虛無；","poem":1},{"lineBreak":true},{"text":"惟獨耶和華創造諸天。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"有尊榮和威嚴在他面前；","poem":1},{"lineBreak":true},{"text":"有能力與華美在他聖所。","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"民中的萬族啊，你們要將榮耀、能力歸給耶和華，","poem":1},{"lineBreak":true},{"text":"都歸給耶和華！","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"要將耶和華的名所當得的榮耀歸給他，","poem":1},{"lineBreak":true},{"text":"拿供物來進入他的院宇。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"當以聖潔的","poem":1},{"noteId":35},{"text":"妝飾敬拜耶和華；","poem":1},{"lineBreak":true},{"text":"全地要在他面前戰抖！","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"人在列邦中要說：耶和華作王！","poem":1},{"lineBreak":true},{"text":"世界就堅定，不得動搖；","poem":1},{"lineBreak":true},{"text":"他要按公正審判眾民。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"願天歡喜，願地快樂！","poem":1},{"lineBreak":true},{"text":"願海和其中所充滿的澎湃！","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"願田和其中所有的都歡樂！","poem":1},{"lineBreak":true},{"text":"那時，林中的樹木都要在耶和華面前歡呼。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"因為他來了，他來要審判全地。","poem":1},{"lineBreak":true},{"text":"他要按公義審判世界，","poem":1},{"lineBreak":true},{"text":"按他的信實審判萬民。","poem":1}]}],"footnotes":[{"noteId":35,"caller":"-","text":"的：或譯為","reference":{"chapter":96,"verse":9}}]},"thisChapterLink":"/api/cmn_cuv/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}