{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":97,"content":[{"type":"heading","content":["上帝是最高的統治者"]},{"type":"verse","number":1,"content":[{"text":"耶和華作王！願地快樂！","poem":1},{"lineBreak":true},{"text":"願眾海島歡喜！","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"密雲和幽暗在他的四圍；","poem":1},{"lineBreak":true},{"text":"公義和公平是他寶座的根基。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"有烈火在他前頭行，","poem":1},{"lineBreak":true},{"text":"燒滅他四圍的敵人。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他的閃電光照世界，","poem":1},{"lineBreak":true},{"text":"大地看見便震動。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"諸山見耶和華的面，","poem":1},{"lineBreak":true},{"text":"就是全地之主的面，便消化如蠟。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"諸天表明他的公義；","poem":1},{"lineBreak":true},{"text":"萬民看見他的榮耀。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"願一切事奉雕刻的偶像、","poem":1},{"lineBreak":true},{"text":"靠虛無之神自誇的，都蒙羞愧。","poem":1},{"lineBreak":true},{"text":"萬神哪，你們都當拜他。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶和華啊，錫安聽見你的判斷就歡喜；","poem":1},{"lineBreak":true},{"text":"猶大的城邑","poem":1},{"noteId":36},{"text":"也都快樂。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為你－耶和華至高，超乎全地；","poem":1},{"lineBreak":true},{"text":"你被尊崇，遠超萬神之上。","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"你們愛耶和華的，都當恨惡罪惡；","poem":1},{"lineBreak":true},{"text":"他保護聖民的性命，","poem":1},{"lineBreak":true},{"text":"搭救他們脫離惡人的手。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"散布亮光是為義人；","poem":1},{"lineBreak":true},{"text":"預備喜樂是為正直人。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"你們義人當靠耶和華歡喜，","poem":1},{"lineBreak":true},{"text":"稱謝他可記念的聖名。","poem":1}]}],"footnotes":[{"noteId":36,"caller":"-","text":"原文是女子","reference":{"chapter":97,"verse":8}}]},"thisChapterLink":"/api/cmn_cuv/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}