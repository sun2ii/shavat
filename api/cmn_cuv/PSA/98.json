{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":98,"content":[{"type":"heading","content":["上帝掌管世界"]},{"type":"hebrew_subtitle","content":["一篇詩。"]},{"type":"verse","number":1,"content":[{"text":"你們要向耶和華唱新歌！","poem":1},{"lineBreak":true},{"text":"因為他行過奇妙的事；","poem":1},{"lineBreak":true},{"text":"他的右手和聖臂施行救恩。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華發明了他的救恩，","poem":1},{"lineBreak":true},{"text":"在列邦人眼前顯出公義；","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"記念他向以色列家所發的慈愛，所憑的信實。","poem":1},{"lineBreak":true},{"text":"地的四極都看見我們上帝的救恩。","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"全地都要向耶和華歡樂；","poem":1},{"lineBreak":true},{"text":"要發起大聲，歡呼歌頌！","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"要用琴歌頌耶和華，","poem":1},{"lineBreak":true},{"text":"用琴和詩歌的聲音歌頌他！","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"用號和角聲，","poem":1},{"lineBreak":true},{"text":"在大君王耶和華面前歡呼！","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"願海和其中所充滿的澎湃；","poem":1},{"lineBreak":true},{"text":"世界和住在其間的也要發聲。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"願大水拍手；","poem":1},{"lineBreak":true},{"text":"願諸山在耶和華面前一同歡呼；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"因為他來要審判遍地。","poem":1},{"lineBreak":true},{"text":"他要按公義審判世界，","poem":1},{"lineBreak":true},{"text":"按公正審判萬民。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}