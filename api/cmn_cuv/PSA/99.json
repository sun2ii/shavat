{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"PSA","translationId":"cmn_cuv","name":"詩篇","commonName":"詩篇","title":"詩篇","order":19,"numberOfChapters":150,"sha256":"fcaa20905e646fef52638ee11406d121669ccd5d9c1cdf8154b5f6c31cc2988f","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cmn_cuv/PSA/150.json","totalNumberOfVerses":2452},"chapter":{"number":99,"content":[{"type":"heading","content":["上帝是至高之王"]},{"type":"verse","number":1,"content":[{"text":"耶和華作王；萬民當戰抖！","poem":1},{"lineBreak":true},{"text":"他坐在二基路伯上，地當動搖。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"耶和華在錫安為大；","poem":1},{"lineBreak":true},{"text":"他超乎萬民之上。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他們當稱讚他大而可畏的名；","poem":1},{"lineBreak":true},{"text":"他本為聖！","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"王有能力，喜愛公平，堅立公正，","poem":1},{"lineBreak":true},{"text":"在雅各中施行公平和公義。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你們當尊崇耶和華－我們的上帝，","poem":1},{"lineBreak":true},{"text":"在他腳凳前下拜。","poem":1},{"lineBreak":true},{"text":"他本為聖！","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"在他的祭司中有摩西和亞倫；","poem":1},{"lineBreak":true},{"text":"在求告他名的人中有撒母耳。","poem":1},{"lineBreak":true},{"text":"他們求告耶和華，他就應允他們。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"他在雲柱中對他們說話；","poem":1},{"lineBreak":true},{"text":"他們遵守他的法度和他所賜給他們的律例。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"耶和華－我們的上帝啊，你應允他們；","poem":1},{"lineBreak":true},{"text":"你是赦免他們的上帝，","poem":1},{"lineBreak":true},{"text":"卻按他們所行的報應他們。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你們要尊崇耶和華－我們的上帝，","poem":1},{"lineBreak":true},{"text":"在他的聖山下拜，","poem":1},{"lineBreak":true},{"text":"因為耶和華－我們的上帝本為聖！","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}