{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"REV","translationId":"cmn_cuv","name":"啟示錄","commonName":"啟示錄","title":"啟示錄","order":66,"numberOfChapters":22,"sha256":"1c1809dc5c0852a24fd2e98a16f1c48a0099bb5a8076dad64ee116379fb4b925","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/cmn_cuv/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["巴比倫傾倒"]},{"type":"verse","number":1,"content":["此後，我看見另有一位有大權柄的天使從天降下，地就因他的榮耀發光。"]},{"type":"verse","number":2,"content":["他大聲喊着說：",{"text":"巴比倫大城傾倒了！傾倒了！","poem":1},{"lineBreak":true},{"text":"成了鬼魔的住處","poem":1},{"lineBreak":true},{"text":"和各樣污穢之靈的巢穴","poem":1},{"noteId":13},{"text":"，","poem":1},{"lineBreak":true},{"text":"並各樣污穢可憎之雀鳥的巢穴。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"因為列國都被她邪淫大怒的酒傾倒了。","poem":1},{"lineBreak":true},{"text":"地上的君王與她行淫；","poem":1},{"lineBreak":true},{"text":"地上的客商因她奢華太過就發了財。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我又聽見從天上有聲音說：","poem":1},{"lineBreak":true},{"text":"我的民哪，你們要從那城出來，","poem":1},{"lineBreak":true},{"text":"免得與她一同有罪，受她所受的災殃；","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"因她的罪惡滔天；","poem":1},{"lineBreak":true},{"text":"她的不義，上帝已經想起來了。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"她怎樣待人，也要怎樣待她，","poem":1},{"lineBreak":true},{"text":"按她所行的加倍地報應她；","poem":1},{"lineBreak":true},{"text":"用她調酒的杯加倍地調給她喝。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"她怎樣榮耀自己，怎樣奢華，","poem":1},{"lineBreak":true},{"text":"也當叫她照樣痛苦悲哀，","poem":1},{"lineBreak":true},{"text":"因她心裏說：","poem":1},{"lineBreak":true},{"text":"我坐了皇后的位，","poem":1},{"lineBreak":true},{"text":"並不是寡婦，","poem":1},{"lineBreak":true},{"text":"決不至於悲哀。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"所以在一天之內，","poem":1},{"lineBreak":true},{"text":"她的災殃要一齊來到，","poem":1},{"lineBreak":true},{"text":"就是死亡、悲哀、饑荒。","poem":1},{"lineBreak":true},{"text":"她又要被火燒盡了，","poem":1},{"lineBreak":true},{"text":"因為審判她的主上帝大有能力。","poem":1}]},{"type":"verse","number":9,"content":["地上的君王，素來與她行淫、一同奢華的，看見燒她的煙，就必為她哭泣哀號。"]},{"type":"verse","number":10,"content":["因怕她的痛苦，就遠遠地站着說：哀哉！哀哉！",{"text":"巴比倫大城，堅固的城啊，","poem":1},{"lineBreak":true},{"text":"一時之間你的刑罰就來到了。","poem":1}]},{"type":"verse","number":11,"content":["地上的客商也都為她哭泣悲哀，因為沒有人再買他們的貨物了；"]},{"type":"verse","number":12,"content":["這貨物就是金、銀、寶石、珍珠、細麻布、紫色料、綢子、朱紅色料、各樣香木、各樣象牙的器皿、各樣極寶貴的木頭，和銅、鐵、漢白玉的器皿，"]},{"type":"verse","number":13,"content":["並肉桂、荳蔻、香料、香膏、乳香、酒、油、細麵、麥子、牛、羊、車、馬，和奴僕、人口。"]},{"type":"verse","number":14,"content":[{"text":"巴比倫哪，你所貪愛的果子離開了你；","poem":1},{"lineBreak":true},{"text":"你一切的珍饈美味","poem":1},{"lineBreak":true},{"text":"和華美的物件也從你中間毀滅，","poem":1},{"lineBreak":true},{"text":"決不能再見了。","poem":1}]},{"type":"verse","number":15,"content":["販賣這些貨物、藉着她發了財的客商，因怕她的痛苦，就遠遠地站着哭泣悲哀，說："]},{"type":"verse","number":16,"content":[{"text":"哀哉！哀哉！這大城啊，","poem":1},{"lineBreak":true},{"text":"素常穿着細麻、","poem":1},{"lineBreak":true},{"text":"紫色、朱紅色的衣服，","poem":1},{"lineBreak":true},{"text":"又用金子、寶石，和珍珠為妝飾。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"一時之間，這麼大的富厚就歸於無有了。","poem":1},"凡船主和坐船往各處去的，並眾水手，連所有靠海為業的，都遠遠地站着，"]},{"type":"verse","number":18,"content":["看見燒她的煙，就喊着說：「有何城能比這大城呢？」"]},{"type":"verse","number":19,"content":["他們又把塵土撒在頭上，哭泣悲哀，喊着說：",{"text":"哀哉！哀哉！這大城啊。","poem":1},{"lineBreak":true},{"text":"凡有船在海中的，都因她的珍寶成了富足！","poem":1},{"lineBreak":true},{"text":"她在一時之間就成了荒場！","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"天哪，眾聖徒、眾使徒、眾先知啊，","poem":1},{"lineBreak":true},{"text":"你們都要因她歡喜，","poem":1},{"lineBreak":true},{"text":"因為上帝已經在她身上伸了你們的冤。","poem":1}]},{"type":"verse","number":21,"content":["有一位大力的天使舉起一塊石頭，好像大磨石，扔在海裏，說：",{"text":"巴比倫大城也必這樣猛力地被扔下去，","poem":1},{"lineBreak":true},{"text":"決不能再見了。","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"彈琴、作樂、吹笛、吹號的聲音，","poem":1},{"lineBreak":true},{"text":"在你中間決不能再聽見；","poem":1},{"lineBreak":true},{"text":"各行手藝人在你中間決不能再遇見；","poem":1},{"lineBreak":true},{"text":"推磨的聲音在你中間決不能再聽見；","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"燈光在你中間決不能再照耀；","poem":1},{"lineBreak":true},{"text":"新郎和新婦的聲音，在你中間決不能再聽見。","poem":1},{"lineBreak":true},{"text":"你的客商原來是地上的尊貴人；","poem":1},{"lineBreak":true},{"text":"萬國也被你的邪術迷惑了。","poem":1}]},{"type":"verse","number":24,"content":["先知和聖徒，並地上一切被殺之人的血，都在這城裏看見了。"]}],"footnotes":[{"noteId":13,"caller":"-","text":"或譯：牢獄；下同","reference":{"chapter":18,"verse":2}}]},"thisChapterLink":"/api/cmn_cuv/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}