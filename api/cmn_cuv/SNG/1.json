{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cuv","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"4ea775fef238eea9a89952cfd99e138a86d4e67fc41ffa98bd302be908d54c4e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cuv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["所羅門的歌，是歌中的雅歌。"]},{"type":"heading","content":["第一首"]},{"type":"verse","number":2,"content":[{"text":"願他用口與我親嘴；","poem":1},{"lineBreak":true},{"text":"因你的愛情比酒更美。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的膏油馨香；","poem":1},{"lineBreak":true},{"text":"你的名如同倒出來的香膏，","poem":1},{"lineBreak":true},{"text":"所以眾童女都愛你。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"願你吸引我，我們就快跑跟隨你。","poem":1},{"lineBreak":true},{"text":"王帶我進了內室，","poem":1},{"lineBreak":true},{"text":"我們必因你歡喜快樂。","poem":1},{"lineBreak":true},{"text":"我們要稱讚你的愛情，","poem":1},{"lineBreak":true},{"text":"勝似稱讚美酒。","poem":1},{"lineBreak":true},{"text":"他們愛你是理所當然的。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶路撒冷的眾女子啊，","poem":1},{"lineBreak":true},{"text":"我雖然黑，卻是秀美，","poem":1},{"lineBreak":true},{"text":"如同基達的帳棚，","poem":1},{"lineBreak":true},{"text":"好像所羅門的幔子。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"不要因日頭把我曬黑了就輕看我。","poem":1},{"lineBreak":true},{"text":"我同母的弟兄向我發怒，","poem":1},{"lineBreak":true},{"text":"他們使我看守葡萄園；","poem":1},{"lineBreak":true},{"text":"我自己的葡萄園卻沒有看守。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我心所愛的啊，求你告訴我，","poem":1},{"lineBreak":true},{"text":"你在何處牧羊？","poem":1},{"lineBreak":true},{"text":"晌午在何處使羊歇臥？","poem":1},{"lineBreak":true},{"text":"我何必在你同伴的羊群旁邊","poem":1},{"lineBreak":true},{"text":"好像蒙着臉的人呢？","poem":1}]},{"type":"verse","number":8,"content":[{"text":"你這女子中極美麗的，","poem":1},{"lineBreak":true},{"text":"你若不知道，","poem":1},{"lineBreak":true},{"text":"只管跟隨羊群的腳蹤去，","poem":1},{"lineBreak":true},{"text":"把你的山羊羔牧放在牧人帳棚的旁邊。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的佳偶，","poem":1},{"lineBreak":true},{"text":"我將你比法老車上套的駿馬。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"你的兩腮因髮辮而秀美；","poem":1},{"lineBreak":true},{"text":"你的頸項因珠串而華麗。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我們要為你編上金辮，鑲上銀釘。","poem":1}]},{"type":"verse","number":12,"content":[{"text":"王正坐席的時候，","poem":1},{"lineBreak":true},{"text":"我的哪噠香膏發出香味。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"我以我的良人為一袋沒藥，","poem":1},{"lineBreak":true},{"text":"常在我懷中。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我以我的良人為一棵鳳仙花，","poem":1},{"lineBreak":true},{"text":"在隱‧基底葡萄園中。","poem":1}]},{"type":"verse","number":15,"content":[{"text":"我的佳偶，你甚美麗！你甚美麗！","poem":1},{"lineBreak":true},{"text":"你的眼好像鴿子眼。","poem":1}]},{"type":"verse","number":16,"content":[{"text":"我的良人哪，你甚美麗可愛！","poem":1},{"lineBreak":true},{"text":"我們以青草為床榻，","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"以香柏樹為房屋的棟樑，","poem":1},{"lineBreak":true},{"text":"以松樹為椽子。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}