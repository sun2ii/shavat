{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cuv","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"4ea775fef238eea9a89952cfd99e138a86d4e67fc41ffa98bd302be908d54c4e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cuv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"我是沙崙的玫瑰花","poem":1},{"noteId":0},{"text":"，","poem":1},{"lineBreak":true},{"text":"是谷中的百合花。","poem":1}]},{"type":"verse","number":2,"content":[{"text":"我的佳偶在女子中，","poem":1},{"lineBreak":true},{"text":"好像百合花在荊棘內。","poem":1}]},{"type":"verse","number":3,"content":[{"text":"我的良人在男子中，","poem":1},{"lineBreak":true},{"text":"如同蘋果樹在樹林中。","poem":1},{"lineBreak":true},{"text":"我歡歡喜喜坐在他的蔭下，","poem":1},{"lineBreak":true},{"text":"嘗他果子的滋味，覺得甘甜。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"他帶我入筵宴所，","poem":1},{"lineBreak":true},{"text":"以愛為旗在我以上。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"求你們給我葡萄乾增補我力，","poem":1},{"lineBreak":true},{"text":"給我蘋果暢快我心，","poem":1},{"lineBreak":true},{"text":"因我思愛成病。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"他的左手在我頭下；","poem":1},{"lineBreak":true},{"text":"他的右手將我抱住。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"耶路撒冷的眾女子啊，","poem":1},{"lineBreak":true},{"text":"我指着羚羊或田野的母鹿囑咐你們：","poem":1},{"lineBreak":true},{"text":"不要驚動、不要叫醒我所親愛的，","poem":1},{"lineBreak":true},{"text":"等他自己情願","poem":1},{"noteId":1},{"text":"。","poem":1}]},{"type":"heading","content":["第二首"]},{"type":"verse","number":8,"content":[{"text":"聽啊！是我良人的聲音；","poem":1},{"lineBreak":true},{"text":"看哪！他躥山越嶺而來。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我的良人好像羚羊，或像小鹿。","poem":1},{"lineBreak":true},{"text":"他站在我們牆壁後，","poem":1},{"lineBreak":true},{"text":"從窗戶往裏觀看，","poem":1},{"lineBreak":true},{"text":"從窗欞往裏窺探。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我良人對我說：","poem":1},"〔新郎〕",{"text":"我的佳偶，我的美人，","poem":1},{"lineBreak":true},{"text":"起來，與我同去！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"因為冬天已往，","poem":1},{"lineBreak":true},{"text":"雨水止住過去了。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"地上百花開放，","poem":1},{"lineBreak":true},{"text":"百鳥鳴叫的時候","poem":1},{"noteId":2},{"text":"已經來到；","poem":1},{"lineBreak":true},{"text":"斑鳩的聲音在我們境內也聽見了。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"無花果樹的果子漸漸成熟；","poem":1},{"lineBreak":true},{"text":"葡萄樹開花放香。","poem":1},{"lineBreak":true},{"text":"我的佳偶，我的美人，","poem":1},{"lineBreak":true},{"text":"起來，與我同去！","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"我的鴿子啊，你在磐石穴中，","poem":1},{"lineBreak":true},{"text":"在陡巖的隱密處。","poem":1},{"lineBreak":true},{"text":"求你容我得見你的面貌，","poem":1},{"lineBreak":true},{"text":"得聽你的聲音；","poem":1},{"lineBreak":true},{"text":"因為你的聲音柔和，","poem":1},{"lineBreak":true},{"text":"你的面貌秀美。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"要給我們擒拿狐狸，","poem":1},{"lineBreak":true},{"text":"就是毀壞葡萄園的小狐狸，","poem":1},{"lineBreak":true},{"text":"因為我們的葡萄正在開花。","poem":1}]},{"type":"verse","number":16,"content":[{"text":"良人屬我，我也屬他；","poem":1},{"lineBreak":true},{"text":"他在百合花中牧放群羊。","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"我的良人哪，","poem":1},{"lineBreak":true},{"text":"求你等到天起涼風、","poem":1},{"lineBreak":true},{"text":"日影飛去的時候，","poem":1},{"lineBreak":true},{"text":"你要轉回，好像羚羊，","poem":1},{"lineBreak":true},{"text":"或像小鹿在比特山上。","poem":1}]}],"footnotes":[{"noteId":0,"caller":"-","text":"或譯：水仙花","reference":{"chapter":2,"verse":1}},{"noteId":1,"caller":"-","text":"不要叫醒......情願：或譯不要激動愛情，等它自發","reference":{"chapter":2,"verse":7}},{"noteId":2,"caller":"-","text":"或譯：修理葡萄樹的時候","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/cmn_cuv/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}