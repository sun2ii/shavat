{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cuv","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"4ea775fef238eea9a89952cfd99e138a86d4e67fc41ffa98bd302be908d54c4e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cuv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"我夜間躺臥在床上，","poem":1},{"lineBreak":true},{"text":"尋找我心所愛的；","poem":1},{"lineBreak":true},{"text":"我尋找他，卻尋不見。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我說：我要起來，遊行城中，","poem":1},{"lineBreak":true},{"text":"在街市上，在寬闊處，","poem":1},{"lineBreak":true},{"text":"尋找我心所愛的。","poem":1},{"lineBreak":true},{"text":"我尋找他，卻尋不見。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"城中巡邏看守的人遇見我；","poem":1},{"lineBreak":true},{"text":"我問他們：你們看見我心所愛的沒有？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我剛離開他們就遇見我心所愛的。","poem":1},{"lineBreak":true},{"text":"我拉住他，不容他走，","poem":1},{"lineBreak":true},{"text":"領他入我母家，","poem":1},{"lineBreak":true},{"text":"到懷我者的內室。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"耶路撒冷的眾女子啊，","poem":1},{"lineBreak":true},{"text":"我指着羚羊或田野的母鹿囑咐你們：","poem":1},{"lineBreak":true},{"text":"不要驚動、不要叫醒我所親愛的，","poem":1},{"lineBreak":true},{"text":"等他自己情願","poem":1},{"noteId":3},{"text":"。","poem":1}]},{"type":"heading","content":["第三首"]},{"type":"verse","number":6,"content":[{"text":"那從曠野上來、形狀如煙柱、","poem":1},{"lineBreak":true},{"text":"以沒藥和乳香並商人各樣香粉薰的是誰呢？","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"看哪，是所羅門的轎；","poem":1},{"lineBreak":true},{"text":"四圍有六十個勇士，","poem":1},{"lineBreak":true},{"text":"都是以色列中的勇士；","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"手都持刀，善於爭戰，","poem":1},{"lineBreak":true},{"text":"腰間佩刀，防備夜間有驚慌。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"所羅門王用黎巴嫩木","poem":1},{"lineBreak":true},{"text":"為自己製造一乘華轎。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"轎柱是用銀做的，","poem":1},{"lineBreak":true},{"text":"轎底是用金做的；","poem":1},{"lineBreak":true},{"text":"坐墊是紫色的，","poem":1},{"lineBreak":true},{"text":"其中所鋪的乃耶路撒冷眾女子的愛情。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"錫安的眾女子啊，","poem":1},{"lineBreak":true},{"text":"你們出去觀看所羅門王！","poem":1},{"lineBreak":true},{"text":"頭戴冠冕，就是在他婚筵的日子、","poem":1},{"lineBreak":true},{"text":"心中喜樂的時候，他母親給他戴上的。","poem":1}]}],"footnotes":[{"noteId":3,"caller":"-","text":"不要叫醒......情願：或譯不要激動愛情，等它自發","reference":{"chapter":3,"verse":5}}]},"thisChapterLink":"/api/cmn_cuv/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}