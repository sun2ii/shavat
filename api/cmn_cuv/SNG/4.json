{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cuv","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"4ea775fef238eea9a89952cfd99e138a86d4e67fc41ffa98bd302be908d54c4e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cuv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"我的佳偶，你甚美麗！你甚美麗！","poem":1},{"lineBreak":true},{"text":"你的眼在帕子內好像鴿子眼。","poem":1},{"lineBreak":true},{"text":"你的頭髮如同山羊群臥在基列山旁。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你的牙齒如新剪毛的一群母羊，","poem":1},{"lineBreak":true},{"text":"洗淨上來，個個都有雙生，","poem":1},{"lineBreak":true},{"text":"沒有一隻喪掉子的。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的唇好像一條朱紅線；","poem":1},{"lineBreak":true},{"text":"你的嘴也秀美。","poem":1},{"lineBreak":true},{"text":"你的兩太陽在帕子內，","poem":1},{"lineBreak":true},{"text":"如同一塊石榴。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的頸項好像大衛建造收藏軍器的高臺，","poem":1},{"lineBreak":true},{"text":"其上懸掛一千盾牌，","poem":1},{"lineBreak":true},{"text":"都是勇士的籐牌。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的兩乳好像百合花中吃草的一對小鹿，","poem":1},{"lineBreak":true},{"text":"就是母鹿雙生的。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我要往沒藥山和乳香岡去，","poem":1},{"lineBreak":true},{"text":"直等到天起涼風、","poem":1},{"lineBreak":true},{"text":"日影飛去的時候回來。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"我的佳偶，你全然美麗，","poem":1},{"lineBreak":true},{"text":"毫無瑕疵！","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我的新婦，求你與我一同離開黎巴嫩，","poem":1},{"lineBreak":true},{"text":"與我一同離開黎巴嫩。","poem":1},{"lineBreak":true},{"text":"從亞瑪拿頂，","poem":1},{"lineBreak":true},{"text":"從示尼珥與黑門頂，","poem":1},{"lineBreak":true},{"text":"從有獅子的洞，","poem":1},{"lineBreak":true},{"text":"從有豹子的山往下觀看。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我妹子，我新婦，","poem":1},{"lineBreak":true},{"text":"你奪了我的心。","poem":1},{"lineBreak":true},{"text":"你用眼一看，","poem":1},{"lineBreak":true},{"text":"用你項上的一條金鍊，","poem":1},{"lineBreak":true},{"text":"奪了我的心！","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我妹子，我新婦，","poem":1},{"lineBreak":true},{"text":"你的愛情何其美！","poem":1},{"lineBreak":true},{"text":"你的愛情比酒更美！","poem":1},{"lineBreak":true},{"text":"你膏油的香氣勝過一切香品！","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我新婦，你的嘴唇滴蜜，","poem":1},{"lineBreak":true},{"text":"好像蜂房滴蜜；","poem":1},{"lineBreak":true},{"text":"你的舌下有蜜，有奶。","poem":1},{"lineBreak":true},{"text":"你衣服的香氣如黎巴嫩的香氣。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我妹子，我新婦，","poem":1},{"lineBreak":true},{"text":"乃是關鎖的園，","poem":1},{"lineBreak":true},{"text":"禁閉的井，封閉的泉源。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你園內所種的結了石榴，","poem":1},{"lineBreak":true},{"text":"有佳美的果子，","poem":1},{"lineBreak":true},{"text":"並鳳仙花與哪噠樹。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"有哪噠和番紅花，","poem":1},{"lineBreak":true},{"text":"菖蒲和桂樹，","poem":1},{"lineBreak":true},{"text":"並各樣乳香木、沒藥、沉香，","poem":1},{"lineBreak":true},{"text":"與一切上等的果品。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"你是園中的泉，活水的井，","poem":1},{"lineBreak":true},{"text":"從黎巴嫩流下來的溪水。","poem":1}]},{"type":"verse","number":16,"content":[{"text":"北風啊，興起！","poem":1},{"lineBreak":true},{"text":"南風啊，吹來！","poem":1},{"lineBreak":true},{"text":"吹在我的園內，","poem":1},{"lineBreak":true},{"text":"使其中的香氣發出來。","poem":1},{"lineBreak":true},{"text":"願我的良人進入自己園裏，","poem":1},{"lineBreak":true},{"text":"吃他佳美的果子。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}