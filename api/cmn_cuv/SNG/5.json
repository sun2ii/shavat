{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cuv","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"4ea775fef238eea9a89952cfd99e138a86d4e67fc41ffa98bd302be908d54c4e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cuv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"我妹子，我新婦，","poem":1},{"lineBreak":true},{"text":"我進了我的園中，","poem":1},{"lineBreak":true},{"text":"採了我的沒藥和香料，","poem":1},{"lineBreak":true},{"text":"吃了我的蜜房和蜂蜜，","poem":1},{"lineBreak":true},{"text":"喝了我的酒和奶。","poem":1},"〔耶路撒冷的眾女子〕",{"text":"我的朋友們，請吃！","poem":1},{"lineBreak":true},{"text":"我所親愛的，請喝，且多多地喝！","poem":1}]},{"type":"heading","content":["第四首"]},{"type":"verse","number":2,"content":[{"text":"我身睡臥，我心卻醒。","poem":1},{"lineBreak":true},{"text":"這是我良人的聲音；","poem":1},{"lineBreak":true},{"text":"他敲門說：","poem":1},"〔新郎〕",{"text":"我的妹子，我的佳偶，","poem":1},{"lineBreak":true},{"text":"我的鴿子，我的完全人，","poem":1},{"lineBreak":true},{"text":"求你給我開門；","poem":1},{"lineBreak":true},{"text":"因我的頭滿了露水，","poem":1},{"lineBreak":true},{"text":"我的頭髮被夜露滴濕。","poem":1}]},{"type":"verse","number":3,"content":[{"text":"我回答說：","poem":1},{"lineBreak":true},{"text":"我脫了衣裳，怎能再穿上呢？","poem":1},{"lineBreak":true},{"text":"我洗了腳，怎能再玷污呢？","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"我的良人從門孔裏伸進手來，","poem":1},{"lineBreak":true},{"text":"我便因他動了心。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"我起來，要給我良人開門。","poem":1},{"lineBreak":true},{"text":"我的兩手滴下沒藥；","poem":1},{"lineBreak":true},{"text":"我的指頭有沒藥汁滴在門閂上。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我給我的良人開了門；","poem":1},{"lineBreak":true},{"text":"我的良人卻已轉身走了。","poem":1},{"lineBreak":true},{"text":"他說話的時候，我神不守舍；","poem":1},{"lineBreak":true},{"text":"我尋找他，竟尋不見；","poem":1},{"lineBreak":true},{"text":"我呼叫他，他卻不回答。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"城中巡邏看守的人遇見我，","poem":1},{"lineBreak":true},{"text":"打了我，傷了我；","poem":1},{"lineBreak":true},{"text":"看守城牆的人奪去我的披肩。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"耶路撒冷的眾女子啊，我囑咐你們：","poem":1},{"lineBreak":true},{"text":"若遇見我的良人，","poem":1},{"lineBreak":true},{"text":"要告訴他，我因思愛成病。","poem":1}]},{"type":"verse","number":9,"content":[{"text":"你這女子中極美麗的，","poem":1},{"lineBreak":true},{"text":"你的良人比別人的良人有何強處？","poem":1},{"lineBreak":true},{"text":"你的良人比別人的良人有何強處，","poem":1},{"lineBreak":true},{"text":"你就這樣囑咐我們？","poem":1}]},{"type":"verse","number":10,"content":[{"text":"我的良人白而且紅，","poem":1},{"lineBreak":true},{"text":"超乎萬人之上。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"他的頭像至精的金子；","poem":1},{"lineBreak":true},{"text":"他的頭髮厚密纍垂，黑如烏鴉。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"他的眼如溪水旁的鴿子眼，","poem":1},{"lineBreak":true},{"text":"用奶洗淨，安得合式。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"他的兩腮如香花畦，","poem":1},{"lineBreak":true},{"text":"如香草臺；","poem":1},{"lineBreak":true},{"text":"他的嘴唇像百合花，","poem":1},{"lineBreak":true},{"text":"且滴下沒藥汁。","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"他的兩手好像金管，","poem":1},{"lineBreak":true},{"text":"鑲嵌水蒼玉；","poem":1},{"lineBreak":true},{"text":"他的身體如同雕刻的象牙，","poem":1},{"lineBreak":true},{"text":"周圍鑲嵌藍寶石。","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"他的腿好像白玉石柱，","poem":1},{"lineBreak":true},{"text":"安在精金座上；","poem":1},{"lineBreak":true},{"text":"他的形狀如黎巴嫩，","poem":1},{"lineBreak":true},{"text":"且佳美如香柏樹。","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"他的口極其甘甜；","poem":1},{"lineBreak":true},{"text":"他全然可愛。","poem":1},{"lineBreak":true},{"text":"耶路撒冷的眾女子啊，","poem":1},{"lineBreak":true},{"text":"這是我的良人；","poem":1},{"lineBreak":true},{"text":"這是我的朋友。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}