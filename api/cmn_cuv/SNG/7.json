{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cuv","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"4ea775fef238eea9a89952cfd99e138a86d4e67fc41ffa98bd302be908d54c4e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cuv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"王女啊，你的腳在鞋中何其美好！","poem":1},{"lineBreak":true},{"text":"你的大腿圓潤，好像美玉，","poem":1},{"lineBreak":true},{"text":"是巧匠的手做成的。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"你的肚臍如圓杯，","poem":1},{"lineBreak":true},{"text":"不缺調和的酒；","poem":1},{"lineBreak":true},{"text":"你的腰如一堆麥子，","poem":1},{"lineBreak":true},{"text":"周圍有百合花。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"你的兩乳好像一對小鹿，","poem":1},{"lineBreak":true},{"text":"就是母鹿雙生的。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"你的頸項如象牙臺；","poem":1},{"lineBreak":true},{"text":"你的眼目像希實本、巴特‧拉併門旁的水池；","poem":1},{"lineBreak":true},{"text":"你的鼻子彷彿朝大馬士革的黎巴嫩塔。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"你的頭在你身上好像迦密山；","poem":1},{"lineBreak":true},{"text":"你頭上的髮是紫黑色；","poem":1},{"lineBreak":true},{"text":"王的心因這下垂的髮綹繫住了。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"我所愛的，你何其美好！","poem":1},{"lineBreak":true},{"text":"何其可悅，使人歡暢喜樂！","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"你的身量好像棕樹；","poem":1},{"lineBreak":true},{"text":"你的兩乳如同其上的果子，纍纍下垂。","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"我說：我要上這棕樹，抓住枝子。","poem":1},{"lineBreak":true},{"text":"願你的兩乳好像葡萄纍纍下垂，","poem":1},{"lineBreak":true},{"text":"你鼻子的氣味香如蘋果；","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"你的口如上好的酒。","poem":1},"〔新娘〕",{"text":"女子說：為我的良人下咽舒暢，","poem":1},{"lineBreak":true},{"text":"流入睡覺人的嘴中。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我屬我的良人，","poem":1},{"lineBreak":true},{"text":"他也戀慕我。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"我的良人，來吧！","poem":1},{"lineBreak":true},{"text":"你我可以往田間去；","poem":1},{"lineBreak":true},{"text":"你我可以在村莊住宿。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我們早晨起來往葡萄園去，","poem":1},{"lineBreak":true},{"text":"看看葡萄發芽開花沒有，","poem":1},{"lineBreak":true},{"text":"石榴放蕊沒有；","poem":1},{"lineBreak":true},{"text":"我在那裏要將我的愛情給你。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"風茄放香，","poem":1},{"lineBreak":true},{"text":"在我們的門內有各樣新陳佳美的果子；","poem":1},{"lineBreak":true},{"text":"我的良人，這都是我為你存留的。","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cmn_cuv/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}