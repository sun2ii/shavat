{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"SNG","translationId":"cmn_cuv","name":"雅歌","commonName":"雅歌","title":"雅歌","order":22,"numberOfChapters":8,"sha256":"4ea775fef238eea9a89952cfd99e138a86d4e67fc41ffa98bd302be908d54c4e","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cmn_cuv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"巴不得你像我的兄弟，","poem":1},{"lineBreak":true},{"text":"像吃我母親奶的兄弟；","poem":1},{"lineBreak":true},{"text":"我在外頭遇見你就與你親嘴，","poem":1},{"lineBreak":true},{"text":"誰也不輕看我。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"我必引導你，","poem":1},{"lineBreak":true},{"text":"領你進我母親的家；","poem":1},{"lineBreak":true},{"text":"我可以領受教訓，","poem":1},{"lineBreak":true},{"text":"也就使你喝石榴汁釀的香酒。","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"他的左手必在我頭下；","poem":1},{"lineBreak":true},{"text":"他的右手必將我抱住。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"耶路撒冷的眾女子啊，","poem":1},{"lineBreak":true},{"text":"我囑咐你們：","poem":1},{"lineBreak":true},{"text":"不要驚動、不要叫醒我所親愛的，","poem":1},{"lineBreak":true},{"text":"等他自己情願","poem":1},{"noteId":4},{"text":"。","poem":1}]},{"type":"heading","content":["第六首"]},{"type":"verse","number":5,"content":[{"text":"那靠着良人從曠野上來的是誰呢？","poem":1},"〔新娘〕",{"text":"我在蘋果樹下叫醒你。","poem":1},{"lineBreak":true},{"text":"你母親在那裏為你劬勞；","poem":1},{"lineBreak":true},{"text":"生養你的在那裏為你劬勞。","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"求你將我放在你心上如印記，","poem":1},{"lineBreak":true},{"text":"帶在你臂上如戳記。","poem":1},{"lineBreak":true},{"text":"因為愛情如死之堅強，","poem":1},{"lineBreak":true},{"text":"嫉恨如陰間之殘忍；","poem":1},{"lineBreak":true},{"text":"所發的電光是火焰的電光，","poem":1},{"lineBreak":true},{"text":"是耶和華的烈焰。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"愛情，眾水不能熄滅，","poem":1},{"lineBreak":true},{"text":"大水也不能淹沒。","poem":1},{"lineBreak":true},{"text":"若有人拿家中所有的財寶要換愛情，","poem":1},{"lineBreak":true},{"text":"就全被藐視。","poem":1}]},{"type":"verse","number":8,"content":[{"text":"我們有一小妹；","poem":1},{"lineBreak":true},{"text":"她的兩乳尚未長成，","poem":1},{"lineBreak":true},{"text":"人來提親的日子，","poem":1},{"lineBreak":true},{"text":"我們當為她怎樣辦理？","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"她若是牆，","poem":1},{"lineBreak":true},{"text":"我們要在其上建造銀塔；","poem":1},{"lineBreak":true},{"text":"她若是門，","poem":1},{"lineBreak":true},{"text":"我們要用香柏木板圍護她。","poem":1}]},{"type":"verse","number":10,"content":[{"text":"我是牆；","poem":1},{"lineBreak":true},{"text":"我兩乳像其上的樓。","poem":1},{"lineBreak":true},{"text":"那時，我在他眼中像得平安的人。","poem":1}]},{"type":"verse","number":11,"content":[{"text":"所羅門在巴力‧哈們有一葡萄園；","poem":1},{"lineBreak":true},{"text":"他將這葡萄園交給看守的人，","poem":1},{"lineBreak":true},{"text":"為其中的果子必交一千舍客勒銀子。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我自己的葡萄園在我面前。","poem":1},{"lineBreak":true},{"text":"所羅門哪，一千舍客勒歸你，","poem":1},{"lineBreak":true},{"text":"二百舍客勒歸看守果子的人。","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"你這住在園中的，","poem":1},{"lineBreak":true},{"text":"同伴都要聽你的聲音，","poem":1},{"lineBreak":true},{"text":"求你使我也得聽見。","poem":1}]},{"type":"verse","number":14,"content":[{"text":"我的良人哪，求你快來！","poem":1},{"lineBreak":true},{"text":"如羚羊或小鹿在香草山上。","poem":1}]}],"footnotes":[{"noteId":4,"caller":"-","text":"不要叫醒......情願：或譯不要激動愛情，等它自發","reference":{"chapter":8,"verse":4}}]},"thisChapterLink":"/api/cmn_cuv/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}