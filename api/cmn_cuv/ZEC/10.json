{"translation":{"id":"cmn_cuv","name":"新標點和合本","website":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cmn-cu89t","licenseNotes":null,"shortName":"CUV","englishName":"Chinese Union Version (traditional)","language":"cmn","textDirection":"ltr","sha256":"923f114ccc6ab7fc558e054f84df5214fa9782ca7c02882cf173417a0d1d641e","availableFormats":["json"],"listOfBooksApiLink":"/api/cmn_cuv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31021,"languageName":"中文","languageEnglishName":"Chinese"},"book":{"id":"ZEC","translationId":"cmn_cuv","name":"撒迦利亞書","commonName":"撒迦利亞書","title":"撒迦利亞書","order":38,"numberOfChapters":14,"sha256":"596e12e88f20bda085f475cd8057e433ebcfbd7db4b18a72e7597b0902128ee5","firstChapterNumber":1,"firstChapterApiLink":"/api/cmn_cuv/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cmn_cuv/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["耶和華應許解救"]},{"type":"verse","number":1,"content":[{"text":"當春雨的時候，","poem":1},{"lineBreak":true},{"text":"你們要向發閃電的耶和華求雨。","poem":1},{"lineBreak":true},{"text":"他必為眾人降下甘霖，","poem":1},{"lineBreak":true},{"text":"使田園生長菜蔬。","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"因為，家神所言的是虛空；","poem":1},{"lineBreak":true},{"text":"卜士所見的是虛假；","poem":1},{"lineBreak":true},{"text":"做夢者所說的是假夢。","poem":1},{"lineBreak":true},{"text":"他們白白地安慰人，","poem":1},{"lineBreak":true},{"text":"所以眾人如羊流離，","poem":1},{"lineBreak":true},{"text":"因無牧人就受苦。","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"我的怒氣向牧人發作；","poem":1},{"lineBreak":true},{"text":"我必懲罰公山羊；","poem":1},{"lineBreak":true},{"text":"因我－萬軍之耶和華","poem":1},{"lineBreak":true},{"text":"眷顧自己的羊群，就是猶大家，","poem":1},{"lineBreak":true},{"text":"必使他們如駿馬在陣上。","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"房角石、釘子、爭戰的弓，","poem":1},{"lineBreak":true},{"text":"和一切掌權的都從他而出。","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"他們必如勇士在陣上","poem":1},{"lineBreak":true},{"text":"將仇敵踐踏在街上的泥土中。","poem":1},{"lineBreak":true},{"text":"他們必爭戰，因為耶和華與他們同在；","poem":1},{"lineBreak":true},{"text":"騎馬的也必羞愧。","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"我要堅固猶大家，拯救約瑟家，","poem":1},{"lineBreak":true},{"text":"要領他們歸回。","poem":1},{"lineBreak":true},{"text":"我要憐恤他們；","poem":1},{"lineBreak":true},{"text":"他們必像未曾棄絕的一樣，","poem":1},{"lineBreak":true},{"text":"都因我是耶和華－他們的上帝，","poem":1},{"lineBreak":true},{"text":"我必應允他們的禱告。","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"以法蓮人必如勇士；","poem":1},{"lineBreak":true},{"text":"他們心中暢快如同喝酒；","poem":1},{"lineBreak":true},{"text":"他們的兒女必看見而快活；","poem":1},{"lineBreak":true},{"text":"他們的心必因耶和華喜樂。","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"我要發嘶聲，聚集他們，","poem":1},{"lineBreak":true},{"text":"因我已經救贖他們。","poem":1},{"lineBreak":true},{"text":"他們的人數必加增，","poem":1},{"lineBreak":true},{"text":"如從前加增一樣。","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"我雖然","poem":1},{"noteId":13},{"text":"播散他們在列國中，","poem":1},{"lineBreak":true},{"text":"他們必在遠方記念我。","poem":1},{"lineBreak":true},{"text":"他們與兒女都必存活，且得歸回。","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"我必再領他們出埃及地，","poem":1},{"lineBreak":true},{"text":"招聚他們出亞述，","poem":1},{"lineBreak":true},{"text":"領他們到基列和黎巴嫩；","poem":1},{"lineBreak":true},{"text":"這地尚且不夠他們居住。","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"耶和華必經過苦海，擊打海浪，","poem":1},{"lineBreak":true},{"text":"使尼羅河的深處都枯乾。","poem":1},{"lineBreak":true},{"text":"亞述的驕傲必致卑微；","poem":1},{"lineBreak":true},{"text":"埃及的權柄必然滅沒。","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"我必使他們倚靠我，得以堅固；","poem":1},{"lineBreak":true},{"text":"一舉一動必奉我的名。","poem":1},{"lineBreak":true},{"text":"這是耶和華說的。","poem":1}]}],"footnotes":[{"noteId":13,"caller":"-","text":"或譯：必","reference":{"chapter":10,"verse":9}}]},"thisChapterLink":"/api/cmn_cuv/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_cuv/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_cuv/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}