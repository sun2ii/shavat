apterAudioLinks":{},"nextChapterApiLink":"/api/cmn_feb/REV/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_feb/REV/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}