aller":"+","text":"或“进入。”","reference":{"chapter":4,"verse":1}}]},"thisChapterLink":"/api/cmn_feb/REV/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cmn_feb/REV/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cmn_feb/REV/3.json","previousChapterAudioLinks":{},"numberOfVerses":11}