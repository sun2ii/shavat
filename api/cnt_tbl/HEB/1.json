{"translation":{"id":"cnt_tbl","name":"Jag₁ ʼmɨ́₂ a₂ma₂lɨʼ₅₄ quianʼ₅₄ Diu₄","website":"https://ebible.org/Scriptures/details.php?id=cntNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cntNT","licenseNotes":null,"shortName":"TBL","englishName":"Tepetotutla Chinantec NT","language":"cnt","textDirection":"ltr","sha256":"fe9410ce3730e3911377c6b66babe0217fcc55a2fdc32d16ac2b0b2cbd9c311b","availableFormats":["json"],"listOfBooksApiLink":"/api/cnt_tbl/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7948,"languageName":"Tepetotutla Chinantec","languageEnglishName":"Tepetotutla Chinantec"},"book":{"id":"HEB","translationId":"cnt_tbl","name":"HEBREOS","commonName":"HEBREOS","title":"Si₂ a₂chen₄ ne₄ dsa₂ HEBREOS","order":58,"numberOfChapters":13,"sha256":"414720f0925810447085a439ef5bb56a087744efcde18fa6a6bdf53519b84d00","firstChapterNumber":1,"firstChapterApiLink":"/api/cnt_tbl/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/cnt_tbl/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Ma₂dsia₅ Diú₄ jág₁ quian'₅₄ dsa₂ mɨ₂güɨ́g₃ të₂le₃ quian'₅₄ Ja₁ŋi'₅₄"]},{"type":"verse","number":1,"content":["'Lióng₂ ráun₂ ca₂juá'₂ Diú₄ jág₁ jmɨg₄ ma₂lɨ́g'₂ ca₂tsɨ́'₃ dsa₂ can'₅₄ quián₂ jniog₄, tsá₃ ca₂ne₅₄ jág₁ ca₂'ë́₂ të₂le₃ quian'₅₄ dsa₂ i₂ca₂chein₃."]},{"type":"verse","number":2,"content":["La₁ jmɨg₄ jë₁ca₂tó'₂ rë₂në́₃ në́₃, ma₂ca₂juá'₂ tság₅ jniog₄ të₂le₃ quian'₅₄ Ja₁ŋi'₅₄ i₂ca₂jmo₃ ca₂le₃jë́₃ a₂cha₂ mɨ₂güɨ́g₃; ján₃ bá₄ o₄gú₃ 'éi₂ ma₂dsia₃ ca₂le₃jë́₃."]},{"type":"verse","number":3,"content":["'Éi₂ bá₄ i₂lɨ́n₅ i₂jlán'₁ i₂tág₅ quió'₅ Diú₄; 'éi₂ bá₄ i₂lɨ́n₅ nió'₄ të₃dsón'₂ i₂jáng'₅ léi₄ 'a₂ lia'₂ lɨ́n₅ Diú₄. Ján₃ bá₄ lɨ́n₅ 'éi₂ i₂jmo₅ 'í₁ ca₂le₃jë́₃ quian'₅₄ jág₁ bén₂ quió'₅. Cang₂ jme₁ca₂rɨ́n'₃ 'éi₂ dsáu₁ jniog₄, jaun₂ ca₂guá₂ guei'₅₄ i₂juɨ́g₃ con₂ Diú₄ të₂le₃ gu₂ ne₁ ne₄ta₁ quió'₅."]},{"type":"heading","content":["Ja₁ŋi'₅₄ Diú₄ bá₄ i₂juɨn'₂ guë́₄ lia'₂ con'₂ guë́₄ ángeles"]},{"type":"verse","number":4,"content":["Ma₂ca₂lɨn₃ Ja₁ŋi'₅₄ Diú₄ i₂juɨn'₂ guë́₄ lia'₂ con'₂ guë́₄ ángeles, ia₁ ma₂gue₃ quió'₅ jmei₂ a₂ma₂lɨ́in₅ ta₁ a₂dsen₅₄ guë́₄ lia'₂ con'₂ guë́₄ ángeles."]},{"type":"verse","number":5,"content":["Tsá₃ lɨ́g'₂ ca₂juá'₂ Diú₄ ca₂tsɨ́'₃ ángeles quiáin₅ 'i₁jan₂ le₂la₂:",{"text":"Lɨ́n'₅ 'ne₂ chi'₂-guein₂ quiáng₃;","poem":1},{"text":"jmɨg₄ në₃ ma₂lɨ́n₅ jniá₂ ŋéi'₅.","poem":2},{"noteId":0},"On₃ guë́₄ 'i₁jan₂ ángel tsá₃ ca₂'ɨin₃ jua'₅₄ a₂juá'₂ le₂la₂:",{"text":"Lén₂ jniá₂ jmei₂ 'éi₂,","poem":1},{"text":"'éi₂ guë'₂ lén₂ chi'₂-guein₂ quiáng₃.","poem":2},{"noteId":1}]},{"type":"verse","number":6,"content":["La₁ ja₁siá'₂ në́₃, lia'₂ con'₂ jme₁ca₂o₃jŋiai₃ Ja₁ŋi'₅₄ i₂ne₅₄ mɨ₂güɨ́g₃, jaun₂ juá'₂:",{"text":"Juɨ₁jme₂juag'₂ ca₂le₃jɨ́n₃ ángeles quián₅ Diú₄.","poem":1},{"noteId":2}]},{"type":"verse","number":7,"content":["Juɨ₁lia'₂ të₂le₃ quió'₅ ángeles guë'₂ juá'₂:",{"text":"Jmo₅ Diú₄ a₂lɨ́n₅ ángeles co₂'nió'₄ dsí₂,","poem":1},{"text":"jmo₂₃ a₂lɨ́in₅ i₂jme₂ti₃ ne₅₄","poem":2},{"lineBreak":true},{"text":"co₂'nió'₄ le₁tsɨ'₅₄ si₂.","poem":2},{"noteId":3}]},{"type":"verse","number":8,"content":["La₁ juɨ₁lia'₂ të₂le₃ quió'₅ Ja₁ŋi'₅₄ në́₃, juá'₂:",{"text":"Jiog₅ ca₂le₃jë́₃ jmɨg₄ ne₄ta₁ quián'₂ 'ne₂,","poem":1},{"text":"Diú₄ quiáng₃.","poem":2},{"text":"Quian'₅₄ jág₁ tí₅","poem":1},{"noteId":4},{"text":"qui₂dsɨ́'₁ 'ne₂ 'éi'₃.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A₂'niog'₂ 'ne₂ a₂tí₅, a₂'ŋia'₅₄ 'ne₂ a₂'lɨg'₅₄;","poem":1},{"lineBreak":true},{"text":"'Uɨg₅₄ jaun₂, Diú₄ në́₃, Diú₄ quiáng'₂,","poem":1},{"text":"ma₂ca₂chein'₃ 'ne₂","poem":2},{"lineBreak":true},{"text":"ne₄ juɨ₅ quió'₅ ca₂le₃jɨ́n₃ rɨ́ng'₂,","poem":2},{"text":"ca₂jmo₃ Diú₄ a₂rë₂rɨn₅ 'au'₂ a₂jmo'₂ 'io'₂.","poem":1},{"noteId":5}]},{"type":"verse","number":10,"content":["Ján₃ bá₄ juá'₂:",{"text":"Lia'₂ ne₁, 'ne₂ Te₁gui'₅₄ quiáng₃,","poem":1},{"text":"ca₂jmo'₅₄ 'uɨg₅₄ tag₄ mɨ₂güɨ́g₃;","poem":2},{"text":"guei'₅₄ i₂juɨ́g₃ guë'₂ në́₃,","poem":1},{"text":"ta₁ a₂ca₂lë₃ quian'₅₄ gog'₂ bá₄ jaun₂.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"A₂dsɨ₃ŋɨ́₂ ca₂le₃jë́₃ a₂në₅,","poem":1},{"text":"la₁ 'ne₂ në́₃, con'₂ tan₅₄ bá₄ lɨ́n'₅ 'ne₂;","poem":2},{"text":"rë₃'áu₂ a₂jaun₂ juɨ₁lia'₂ nɨ₁tsɨn'₅₄ dsa₂.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A₂jóng'₅ a₂jaun₂ juɨ₁lia'₂ jë₁jón'₂ dsa₂ tsɨ₁'mɨ'₂.","poem":1},{"lineBreak":true},{"text":"La₁ 'ne₂ në́₃, lia'₂ ma₂lɨ́n'₅ jaun₂ bá₄ 'ne₂.","poem":1},{"text":"Tsá₃ o₁lɨ́g'₂ jmɨg₄ dsiá₃ a₂chan'₂ 'ne₂.","poem":2},{"noteId":6}]},{"type":"verse","number":13,"content":["Tsá₃ lɨ́g'₂ ca₂juá'₂ Diú₄ ca₂tsɨ́'₃ 'i₁jan₂ ángel le₂la₂:",{"text":"Né₂ con₂ jniá₂ të₂le₃ gu₃ ne₁,","poem":1},{"text":"ca₂lia'₂ ca₂të́₂ jmɨg₄","poem":2},{"lineBreak":true},{"text":"a₂tón'₁ jniá₂ dsa₂ i₂'iog₅₄ o₄tag'₄.","poem":2},{"noteId":7}]},{"type":"verse","number":14,"content":["Ia₁ lɨ́n₅ ángeles jme₂dsí₂ i₂jme₂'o₅₄ i₂chen₄ a₂jme₂ti₃ ta₁ ne₄ i₂ca₂tɨ́n₂ gue₃ a₂lió₂ Diú₄."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Salmo 2:7.","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"2 Samuel 7:14.","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"Deuteronomio 32:43.","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"Salmo 104:4.","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"+","text":"lit. “Quian'₅₄ 'ma₂'ɨ₅₄ dsau₅.”","reference":{"chapter":1,"verse":8}},{"noteId":5,"caller":"+","text":"Salmo 45:6-7.","reference":{"chapter":1,"verse":9}},{"noteId":6,"caller":"+","text":"Salmo 102:25-27.","reference":{"chapter":1,"verse":12}},{"noteId":7,"caller":"+","text":"Salmo 110:1.","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/cnt_tbl/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cnt_tbl/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cnt_tbl/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}