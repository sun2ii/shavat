{"translation":{"id":"cnt_tbl","name":"Jag₁ ʼmɨ́₂ a₂ma₂lɨʼ₅₄ quianʼ₅₄ Diu₄","website":"https://ebible.org/Scriptures/details.php?id=cntNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cntNT","licenseNotes":null,"shortName":"TBL","englishName":"Tepetotutla Chinantec NT","language":"cnt","textDirection":"ltr","sha256":"fe9410ce3730e3911377c6b66babe0217fcc55a2fdc32d16ac2b0b2cbd9c311b","availableFormats":["json"],"listOfBooksApiLink":"/api/cnt_tbl/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7948,"languageName":"Tepetotutla Chinantec","languageEnglishName":"Tepetotutla Chinantec"},"book":{"id":"REV","translationId":"cnt_tbl","name":"APOCALIPSIS","commonName":"APOCALIPSIS","title":"Jág₁ a₂ca₂jme₃jnia₅ Jesucristo ne₄ San Juan₅₄","order":66,"numberOfChapters":22,"sha256":"c6acae85f492a5017b0f2dc3d80ca4acaec1da985b8301ea6d24fb762ef4fe89","firstChapterNumber":1,"firstChapterApiLink":"/api/cnt_tbl/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/cnt_tbl/REV/22.json","totalNumberOfVerses":405},"chapter":{"number":18,"content":[{"type":"heading","content":["Jë₁ca₂ŋó₃ 'uë₃ bí₂ quió'₅ Babilonia"]},{"type":"verse","number":1,"content":["Cang₂ jaun₂, ca₂jɨng₅₄ táng₃ jan₂ ángel sián'₂, ca₂sióin₃ guei'₅₄ i₂juɨ́g₃ i₂'io₅ bí₂ 'éi'₃ a₂'uain'₂ lɨn₃. Ta₁caun₂ mɨ₂güɨ́g₃ bá₄ ca₂tág'₃ a₂co₂tág₅ co₂'né'₅ quió'₅."]},{"type":"verse","number":2,"content":["Quian'₅₄ jág₁ tiá₂ lɨn₃, ca₂juá'₂:",{"text":"Ma₂ca₂i₃'én₂, ma₂ca₂i₃'én₂ Babilonia juë'₂,","poem":1},{"text":"'ne₄ ca₂le₃jɨ́n₃ ne₅₄ je₂na'₅₄ bá₄ ca₂lë₃;","poem":2},{"lineBreak":true},{"text":"'né₅ 'má₃ ja₁ŋɨ'₂ ca₂le₃jɨ́n₃ ne₅₄ jme₂dsí₂ 'lɨn'₅₄,","poem":2},{"lineBreak":true},{"text":"ca₂le₃jɨ́n₃ ne₅₄ i₁tan₅ 'lɨn'₅₄ lë₁'ŋio₅.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ia₁ ma₂qui₂ma₂'ɨn'₃ ca₂le₃jë́₃ juɨg₂","poem":1},{"text":"vino a₂ca₂jme₃cón₂ dsɨ́₅ a₂qui₂nió'₃ jág₁ 'lɨg'₅₄ quió'₅.","poem":2},{"text":"Ma₂qui₂ca₂nió'₃ jág₁ rag₅₄ i₂chan₂ gua'₅₄ 'uë₃","poem":1},{"text":"quiain'₅₄ 'io₅₄ 'éi₂.","poem":2},{"text":"Ca₂le₃jɨ́n₃ juɨ₁lia'₂ dsa₂ i₂i₂nio₄ jmo₂₃ 'ma'₅₄,","poem":1},{"lineBreak":true},{"text":"ma₂qui₂ca₂rë₃chá₃ cu₄ 'ŋio₅ lɨn₃","poem":1},{"text":"të₂le₃ quian'₅₄ juɨ₅bí₂ a₂ma₂i₁juɨn₅₄ ŋag₅₄","poem":2},{"lineBreak":true},{"text":"a₂jlá'₁ jmo₂₃ róin₂.","poem":2}]},{"type":"verse","number":4,"content":["Jaun₂ ca₂nag₃ táng₃ caun₂ jág₁ a₂já₅ guei'₅₄ i₂juɨ́g₃, a₂juá'₂:",{"text":"'Uɨn'₂ 'nia'₂ jë₄ juɨg₂ në₅,","poem":1},{"text":"con'₂ 'nia'₂ i₂lɨ́ng'₅ dsa₂ juɨg₂ quiáng₃,","poem":2},{"text":"ia₁jaun₂ tsá₃ le₃quen'₄ 'nia'₂ dso₄ a₂'no₅ 'io₅₄ në₅,","poem":1},{"text":"on₃ guë'₂ tɨn'₃ 'nia'₂ jmɨ₁uɨg₅ a₂já₅ ja₁coin₂.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ia₁ 'lióng₂ lɨn₃ dsáu₁ 'io₅₄ në₅ ma₂rë₂juɨ́₄,","poem":1},{"text":"në₂jag₄ bá₄ ma₂të́₂ ca₂të₂ guei'₅₄ i₂juɨ́g₃.","poem":2},{"text":"Jaun₂ Diú₄ në́₃ ma₂dsáu'₅ dsɨ́₅","poem":1},{"text":"ca₂le₃jë́₃ a₂'lɨg'₅₄ a₂ma₂rë₂cáin'₄.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"A₂le₂jaun₂ cuë'₅₄ 'nia'₂ 'io₅₄ në₅","poem":1},{"text":"juɨ₁lia'₂ lë́₅ a₂ma₂qui₂ma₂cuë́'₃ dsa₂ 'ŋiog₅.","poem":2},{"text":"Qui'₄ 'nia'₂ tɨn₃ ju'₂","poem":1},{"text":"lia'₂ con'₂ guë́₄ a₂ma₂jmo₃.","poem":2},{"text":"Co₂güɨn'₅₄ 'nia'₂ tɨn₃ ráun₂ a₂'ŋio₅ guë́₄","poem":1},{"text":"ŋió'₂ copa quió'₅ 'ŋiog₅,","poem":2},{"lineBreak":true},{"text":"con'₂ guë́₄ a₂ma₂cuë́'₃ i₂sián'₂.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Juɨ₁lia'₂ a₂ŋɨ́₄ lë₃ ma₂qui₂ma₂chain₂ jlá'₁ a₂róin₂,","poem":1},{"text":"co₂jaun₂ cuë'₅₄ 'nia'₂ jmɨ₁uɨg₅ a₂quɨ'₂ dsɨ́₅.","poem":2},{"text":"Ia₁ ma₂juá'₂ bá₄ juɨ₅ të₂dsɨ́₅:","poem":1},{"lineBreak":true},{"text":"“La₂ gua₅₄ a₂lɨ́ng₅ jan₂ 'io₅₄ rag₅₄,","poem":1},{"text":"tsá₃ dsa₂ 'nág₂ lɨ́ng₅.","poem":2},{"lineBreak":true},{"text":"Tsá₃ o₁lɨ́g'₂ ŋag₅₄ uɨg₅ le₃quɨ'₂ dsɨ₃.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"'Uɨg₅₄ jaun₂ në́₃,","poem":1},{"text":"co₂nio₄ co₂jmɨg₄ bá₄ ja₃lé₂ jmɨ₁uɨg₅ ja₁coin₂;","poem":2},{"text":"'mú₃, quɨ'₃-'o₃, le₃'oin₅₄ në́₃;","poem":1},{"text":"jaun₂ guë́₄ dsɨin'₂ co₂ŋei'₅₄.","poem":2},{"text":"Ia₁ i₂'uan'₂ lɨn₃ bá₄ Te₁gui'₅₄ Diú₄","poem":1},{"text":"i₂qui₃dsɨ₅ 'éi'₃ ja₁coin₂ jmɨg₄ jaun₂.","poem":2}]},{"type":"verse","number":9,"content":["'Cán₂ go₂'i₃, quɨ'₃-'o₃ ca₂le₃jɨ́n₃ rag₅₄ quián₅ gua'₅₄ 'uë₃ i₂qui₂ca₂nió'₄ jág₁ quiain'₅₄ 'io₅₄ 'éi₂, i₂qui₂ma₂ca₂rë₃cháin₃ jlá'₁ quiain'₅₄, jë₁ma₂ca₂jág₃ tsau₂ jme₁ŋi₁ guei'₅₄ a₂ma₂qui₂cau₂ quió'₅ 'io₅₄."]},{"type":"verse","number":10,"content":["La₁ uɨ́ng₂ bá₄ qui₂dsɨ₃náu₃, qui₃jág₃ gó'₃ 'ŋio₅ lɨn₃, jaun₂ juá'₂:",{"text":"¡'E₂ guë́₄ juɨ́g'₂, 'e₂ guë́₄ juɨ́g'₂,","poem":1},{"text":"'ne₂ ciudad juë'₂,","poem":2},{"text":"'ne₂ Babilonia i₂jme₁'uang'₂ lɨn₃ në́₃!","poem":1},{"lineBreak":true},{"text":"¡Quian'₅₄ ca₂tiá₂ co₂lág₂ bá₄","poem":1},{"text":"gua₅ uɨg₅ a₂rë₂'ë́₂ ja₁cong'₂!","poem":2}]},{"type":"verse","number":11,"content":["'Cán₂ go₂'i₃, quɨ'₃-'o₃ dsa₂ i₂jme₁i₂nio₄ jmo₅ 'ma'₅₄ ne₄ gua'₅₄ 'uë₃, o₄quió'₄ 'éi₂; ia₁ tsá₃ ma₂'ein₂ le₃chan₂ qui₃lá₃ guë́₄ 'e₂ lio₅₄ i₂quian₅₄:"]},{"type":"verse","number":12,"content":["lio₅₄ a₂lë́₅ cu₄nióg₄, cu₄tiog₂, cang₄ jlá'₁, mɨ́g₂ perlas, ca₂le₃jë́₃ ne₅₄ juɨ₁lia'₂ 'mɨ'₂ jlá'₁, juɨ₁lia'₂ lino quian'₅₄ seda a₂'lióng₂ ne₅₄ jniá₂, a₂'uɨ'₃, a₂guéin₂ në́₃; ca₂le₃jë́₃ ne₅₄ 'ma₂ jlá'₁ në́₃ a₂ja₂ mɨ₂juɨg₂ ma₂ro₂; lióng₂ ne₅₄ cosas jlá'₁ në́₃, juɨ₁lia'₂ a₂lë́₅ nɨ₁mu₅, a₂lë́₅ nɨ₁'ma₂ jlá'₁ a₂'mu'₅₄, a₂lë́₅ nɨ₁ŋí₁ 'ua'₂, a₂lë́₅ nɨ₁ŋí₁ nióg₂ në́₃, nɨ₁cang₁ mármol táng₃;"]},{"type":"verse","number":13,"content":["lio₅₄ canela, ca₂le₃jë́₃ guë́₄ a₂ja₂ mɨ₂juɨg₂ ma₂ro₂ juɨ₁lia'₂ chen₂, mirra, no'₅₄ mɨ₂juɨg₂ në́₃; vino quian'₅₄ no'₅₄ olivo; cuɨg₂ dse₃ quian'₅₄ trigo; já'₂ në́₃, juɨ₁lia'₂ ca₁juɨ₅, já'₂ cha'₂ quian'₅₄ cua₁; nɨ₁ŋí₁ carrozas në́₃. Ca₂le₂jiog₅ dsa₂ mɨ₂güɨ́g₃ rɨn'₅₄ dsa₂ i₂jme₂ti₃ ta₁ ne₅₄."]},{"type":"verse","number":14,"content":["'La₁ jmɨg₄ jaun₂ guë́₄ në́₃, juá'₂ tsɨ́'₃ ciudad jaun₂:",{"text":"¡Ma₂ca₂jŋia'₃ ja₁cong'₂, mɨ́g₂ jlá'₁","poem":1},{"text":"a₂ŋɨ́₄ lë₃ jme₁'ɨ́n₅ 'au'₂ quë'₅₄!","poem":2},{"text":"¡A₂co₂dsia₅ ca₂i₃'én₂ jaun₂ bá₄","poem":1},{"text":"ca₂le₃jë́₃ a₂jlá'₁","poem":2},{"lineBreak":true},{"text":"a₂jme₁quen₅ cu₄ a₂jme₁cha₂ quiáng'₂!","poem":2},{"text":"Tsá₃ ma₃o₁lɨ́g'₂ jmɨg₄ dsiang'₂.","poem":1}]},{"type":"verse","number":15,"content":["'Dsa₂ i₂qui₂ma₂jmo₃ 'ma'₅₄ ca₂le₃jë́₃ a₂në₅, i₂qui₂ca₂rë₃chá₃ cu₄ 'ŋio₅ lɨn₃ të₂le₃ quian'₅₄ 'io₅₄ 'éi₂, qui₂dsɨ₃náu₃ uɨ́ng₂, qui₃jág₃ gó'₃ 'uɨg₅₄ jmɨ₁uɨg₅ a₂go₂'i₃ jaun₂."]},{"type":"verse","number":16,"content":["Jaun₂ juá'₂ tiá₂:",{"text":"¡'E₂ guë́₄ juɨ́g'₂, 'e₂ guë́₄ juɨ́g'₂,","poem":1},{"text":"'ne₂ ciudad juë'₂!","poem":2},{"text":"¡Ia₁ jme₁lë́₄ juɨ₁lia'₂ lɨ́n₅ jan₂ 'io₅₄ jlán'₁","poem":1},{"text":"i₂jme₁qui'₂ tsɨn'₅₄ jlá'₁ lɨn₃","poem":2},{"text":"a₂jme₁jniá₂ 'uɨ'₃ quian'₅₄ a₂guéin₂,","poem":1},{"text":"i₂jme₁rë₂lɨn₄ jlán'₁ quian'₅₄ cu₄nióg₄,","poem":2},{"lineBreak":true},{"text":"nɨ₁cang₁ jlá'₁, mɨ́g₂ perlas në́₃!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"¡Quian'₅₄ ca₂tiá₂ co₂lág₂ bá₄,","poem":1},{"text":"qui₂ca₂dsa₃ ca₂ag₂ a₂jlá'₁ a₂quen₅ 'lióng₂ lɨn₃!","poem":2},"'Ca₂le₃jɨ́n₃ juɨ₁lia'₂ i₂i₂quian₅ nɨ₁barcos, ca₂le₃jɨ́n₃ guë́₄ dsa₂ i₂i₂nio₄ ne₄ jmɨ₁ŋí'₄, ca₂le₃jɨ́n₃ guë́₄ dsa₂ i₂'no₅ a₂dsɨ₂ŋɨ́i₂ ne₄ jmɨ₁ŋí'₄, qui₂dsɨ₃náu₃ uɨ́ng₂,"]},{"type":"verse","number":18,"content":["jë₁ma₂ca₂jág₃ jme₁ŋi₁ a₂ma₂qui₂cau₂ quió'₅, qui₃juá'₂ tiá₂ tóin'₃: ―¿'E₂ bá₄ ciudad lé₂ le₃quɨn₃ quian'₅₄ ciudad juë'₂ në₅?"]},{"type":"verse","number":19,"content":["Jaun₂ qui₂tó'₃ ti₁juɨ₁ ne₄ mɨ₂dsi₅₄ guioin₅₄, quɨ'₂-'o₂₃, a₂juá'₂ tiá₂:",{"text":"¡'E₂ guë́₄ juɨ́g₂, 'e₂ guë́₄ juɨ́g₂","poem":1},{"text":"ciudad juë'₂ në₅!","poem":2},{"text":"Quian'₅₄ ca₂le₃jë́₃ a₂jme₁cha₂ quió'₅,","poem":1},{"text":"ca₂rë₃chá₃ cu₄ ca₂le₃jɨ́n₃ dsa₂","poem":2},{"lineBreak":true},{"text":"i₂qui₂le₁'io₅ barcos ne₄ jmɨ₁ŋí'₄.","poem":2},{"text":"¡Quian'₅₄ ca₂tiá₂ co₂lág₂ bá₄ ca₂'en₃ jë₂!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"La₁ 'nia'₂ në́₃,","poem":1},{"text":"i₂chan'₂ guei'₅₄ i₂juɨ́g₃,","poem":2},{"text":"jmo₄ 'nia'₂ 'io'₂ ne₄ quió'₅ juɨg₂ jaun₂.","poem":1},{"text":"Ca₂le₃jɨ́n'₃ guë'₂ 'nia'₂ i₂tén₅ le₃quió'₅ Diú₄,","poem":2},{"lineBreak":true},{"text":"i₂chen₄ quiáin₅, i₂qui₂'ë́₂ jág₁ quió'₅ në́₃.","poem":2},{"text":"Ia₁ ma₂në₂qui₃dsɨ₅ Diú₄ 'éi'₃ ja₁con₂ juɨg₂ jaun₂,","poem":1},{"text":"ma₂në₂jme₃rë́₃ ca₂le₃jë́₃ a₂ma₂jmái'₂ 'nia'₂ jaun₂.","poem":2}]},{"type":"verse","number":21,"content":["Jaun₂ ca₂chóg'₃ jan₂ ángel 'uan'₂ ca₂mɨ́g₂ nɨ₁cang₁ pa₁, a₂lë́₅ juɨ₁lia'₂ lë́₅ nɨ₁cang₁ éi'₅ cuɨg₂ 'í₅; ca₂ton₃ ne₄ jmɨ₁ŋí'₄, ca₂juá'₂:",{"text":"Quian'₅₄ 'nei₂ uɨg₅ le₂në₅ bá₄","poem":1},{"text":"dsó₃ 'uë₃ ján₃,","poem":2},{"text":"Babilonia ciudad juë'₂,","poem":1},{"lineBreak":true},{"text":"tsá₃ ma₃a₁jaun₂ jua'₅₄ le₃cha₂.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"O₁lɨ́g'₂ jmɨg₄ tsá₃ ma₃qui₂né'₂ a₂jmo₃ dsa₂ son₅₄","poem":1},{"text":"juɨ₁lia'₂ jë₄ calle quiáng'₂:","poem":2},{"text":"juɨ₁lia'₂ son₅₄ tsɨ₁ton₅ arpas,","poem":1},{"noteId":45},{"text":"son₅₄ 'ma₂, son₅₄ ŋí₁ trompeta në́₃.","poem":2},{"text":"Tsá₃ ma₃le₃chan₂ të₅","poem":1},{"text":"i₂tɨn₂ ta₁ 'i₁jan₂, ja₁cong'₂;","poem":2},{"text":"tsá₃ ma₃qui₃né'₂ mɨ'₅₄","poem":1},{"text":"nɨ₁cang₁ éi'₅ cuɨg₂ 'í₅, ja₁cong'₂;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"si₂ nng'₂;","poem":1},{"lineBreak":true},{"text":"jág₁ quió'₅ 'io₅₄,","poem":1},{"lineBreak":true},{"text":"quió'₅ dsa₂ ŋe'₂ i₂jen'₂ gu₂,","poem":1},{"text":"tsá₃ ma₃o₁lɨ́g'₂ qui₃né'₂ ja₁cong'₂.","poem":2},{"text":"Ia₁ dsa₂ dsen₅₄ jɨn₄ dsa₂ mɨ₂güɨ́g₃","poem":1},{"text":"jme₁lɨ́n₄ dsa₂ i₂qui₂jme₁jmo₅ 'ma'₅₄ quiáng'₂,","poem":2},{"text":"ia₁ ca₂jme₁gang'₂ ca₂le₃jë́₃ juɨg₂","poem":1},{"text":"të₂le₃ quian'₅₄ a₂chan₂ 'au'₂.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ia₁ 'éi₂ bá₄ rë₂cán'₄ jmɨ₂ 'an₅₄","poem":1},{"text":"ca₂le₃jɨ́n₃ dsa₂ i₂tén₅ le₃quió'₅ Diú₄,","poem":2},{"lineBreak":true},{"text":"i₂ma₂'ë́₂ jág₁ quió'₅ në́₃,","poem":2},{"text":"quian'₅₄ ca₂le₃jɨ́n₃ i₂ca₂dsan₃","poem":1},{"text":"ca₂jme₃dsiog₅ dsa₂, ne₄ gua'₅₄ 'uë₃.","poem":2}]}],"footnotes":[{"noteId":45,"caller":"+","text":"griego: kithara.","reference":{"chapter":18,"verse":22}}]},"thisChapterLink":"/api/cnt_tbl/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cnt_tbl/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cnt_tbl/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}