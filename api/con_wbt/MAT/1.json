{"translation":{"id":"con_wbt","name":"Chiga Tevaen'Jema Atesuja 1, Aisheve Caña'cho","website":"https://ebible.org/Scriptures/details.php?id=conNTpo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=conNTpo","licenseNotes":null,"shortName":"WBT","englishName":"Cofán Bible","language":"con","textDirection":"ltr","sha256":"7806765f1ad9fb840e2f27683521c1784a8d1a2b10db85d2a5e7414eb7ab53c0","availableFormats":["json"],"listOfBooksApiLink":"/api/con_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":310,"totalNumberOfVerses":9422,"languageName":"Cofán","languageEnglishName":"Cofán"},"book":{"id":"MAT","translationId":"con_wbt","name":"Mateo","commonName":"Mateo","title":"Mateo Ñotsse Condase'cho Jesucristone","order":40,"numberOfChapters":28,"sha256":"0adc12f788adeb96f1521f2c3bfe95c8f319843a4f1360b7d99ec47396ead54b","firstChapterNumber":1,"firstChapterApiLink":"/api/con_wbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/con_wbt/MAT/28.json","totalNumberOfVerses":1067},"chapter":{"number":1,"content":[{"type":"heading","content":["Jesucristo tayopi'su antiandeccu"]},{"type":"verse","number":1,"content":["Qquen tsu Jesucristo tayopi'su antiandeccu. Tiseja tayopi'su David omba'su dutssi'ye tsu. Tayopi'su Abram omba'su dutssi'ye tsu."]},{"type":"verse","number":2,"content":[{"text":"Abrahamjan Isaac quitsa tsu.","poem":1},{"lineBreak":true},{"text":"Isaacja Jacob quitsa.","poem":1},{"lineBreak":true},{"text":"Tiseja Judá quitsa.","poem":1},{"lineBreak":true},{"text":"Judá antiandeccu'qque tsu Jacob dushundeccu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Judá tsu Fares quitsa.","poem":1},{"lineBreak":true},{"text":"Tise faesu du'shuja Zara. Tsendeccumbe mamajan Tamar tsu.","poem":1},{"lineBreak":true},{"text":"Fares tsu Esrom quitsa.","poem":1},{"lineBreak":true},{"text":"Esrom tsu Aram quitsa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Aramja Aminadab quitsa tsu.","poem":1},{"lineBreak":true},{"text":"Aminadabja Naasón quitsa.","poem":1},{"lineBreak":true},{"text":"Naasónjan Salmón quitsa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salmón tsu Booz quitsa.","poem":1},{"lineBreak":true},{"text":"Booz mama tsu Rahab.","poem":1},{"lineBreak":true},{"text":"Booz tsu Obed quitsa.","poem":1},{"lineBreak":true},{"text":"Obed mama tsu Rut.","poem":1},{"lineBreak":true},{"text":"Obedja Isaí quitsa tsu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Isaíja na'su David quitsa tsu.","poem":1},{"lineBreak":true},{"text":"Davidja Urías'ye pasi tsandupajen'choma pushepa Salomón quitsa tsu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Salomónjan Roboam quitsa tsu.","poem":1},{"lineBreak":true},{"text":"Roboam tsu Abías quitsa.","poem":1},{"lineBreak":true},{"text":"Abías tsu Asa quitsa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa tsu Josafat quitsa.","poem":1},{"lineBreak":true},{"text":"Josafat tsu Joram quitsa.","poem":1},{"lineBreak":true},{"text":"Joram tsu Uzías quitsa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Uzíasja Jotam quitsa tsu.","poem":1},{"lineBreak":true},{"text":"Tiseja Acaz quitsa.","poem":1},{"lineBreak":true},{"text":"Acazja Ezequías quitsa tsu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ezequíasja Manasés quitsa.","poem":1},{"lineBreak":true},{"text":"Manasésja Amón quitsa.","poem":1},{"lineBreak":true},{"text":"Tiseja Josías quitsa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Israendeccuma indipa Babilonia andeni angai'te Josíasja Jeconías, tise antiandeccuma'qque isupa Jeconías quitsa tsu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Omboe Babiloniani japa Jeconíasja Salatiel quitsa tsu.","poem":1},{"lineBreak":true},{"text":"Salatiel tsu Zorobabel quitsa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tiseja Abiud quitsa.","poem":1},{"lineBreak":true},{"text":"Abiudja Eliaquim quitsa.","poem":1},{"lineBreak":true},{"text":"Tiseja Azor quitsa.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azor tsu Sadoc quitsa.","poem":1},{"lineBreak":true},{"text":"Sadocja Aquim quitsa.","poem":1},{"lineBreak":true},{"text":"Tiseja Eliud quitsa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tiseja Eleasar quitsa.","poem":1},{"lineBreak":true},{"text":"Tiseja Matán quitsa.","poem":1},{"lineBreak":true},{"text":"Matán tsu Jacob quitsa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Jacobja José quitsa tsu.","poem":1},{"lineBreak":true},{"text":"José tsu Maríama pushe.","poem":1},{"lineBreak":true},{"text":"Maríaja Jesús mama tsu.","poem":1},{"lineBreak":true},{"text":"Jesúsja Cristo tsu.","poem":1}]},{"type":"verse","number":17,"content":["Tsa'caen Abrahamne Davidngae catorce yayandeccu'su du'shuve tsu agatto. Davidne Babiloniani anga'chongae catorce yayandeccu'su du'shuve tsu agatto. Babiloniani anga'chone Cristo jiya'ngae'qque catorce yayandeccu'su du'shuve tsu agatto."]},{"type":"heading","content":["Jesucristoma isu'cho"]},{"type":"verse","number":18,"content":["Qquen tsu Jesucristoma isu'cho. Tise chanjan, María Josénga tayo iñajañemba toya tsandiei'ccu fae'ngae can'jembe'yi surie da. Chiga Quendya'pa tisenga jisi surie da."]},{"type":"verse","number":19,"content":["Surie dasi Joséja ño'a a'ipa tsama atesupa Maríama pusheye in'jambi. Tsa'ma poiyi'cco a'inga tsama condaseye in'jambipa a'tutsse Maríama catiye asi'ttaen."]},{"type":"verse","number":20,"content":["Tsa'caen asi'ttaen'jen'ni Na'su Chigama sefacconi'su shondo'su tisenga ji. José anamba ayo'osi sefacconi'su shondo'su attiamba su: —¡José, David dutssi'ye! Dyombe'yi que pushe Maríama que tsaoni angaja. Tise ttopanga an'du'cho du'shuja Chiga Qquendya'pa du'shu tsu."]},{"type":"verse","number":21,"content":["Tsandie du'shuve tsu isuya. Tise aindeccuma tsu tise'pa egae tsincon'cho'ye ccushaeña. Tsa'cansi tisema qui inisian'faya Jesúsve. Jesús qquenda tsu ccushaen'su qquen su."]},{"type":"verse","number":22,"content":["Qquen tsu Jesúsma isu'choja, Na'su Chiga tayopi suqquia'caen tsoñe. Nane Na'su Chigaja Tise Aya'fama afa'sui'ccu qquen tsu su:"]},{"type":"verse","number":23,"content":[{"text":"Toya tsandiei'ccu cansembi'choa pushesu tsu surie dapa tsandie du'shuve isuya.","poem":1},{"lineBreak":true},{"text":"Du'shumbe iniseja Emanuelya tsu.","poem":1},"Chiga ingi'ccu can'jen, qquen tsu suye in'jan."]},{"type":"verse","number":24,"content":["Tsonsi José ana qquendyapa Na'su Chigama sefacconi'su shondo'su suqquia'caen tson. Maríama i'ngapa tise pusheve tsaoni i."]},{"type":"verse","number":25,"content":["Fae'ngae tsaoni can'je'an'qque du'shuma isuya'ngae toya fae'ngae canse'fambi. Tsandie du'shuve isupa tisema inisian'fa Jesúsve."]}],"footnotes":[]},"thisChapterLink":"/api/con_wbt/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/con_wbt/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/con_wbt/GEN/50.json","previousChapterAudioLinks":{},"numberOfVerses":25}