{"translation":{"id":"con_wbt","name":"Chiga Tevaen'Jema Atesuja 1, Aisheve Caña'cho","website":"https://ebible.org/Scriptures/details.php?id=conNTpo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=conNTpo","licenseNotes":null,"shortName":"WBT","englishName":"Cofán Bible","language":"con","textDirection":"ltr","sha256":"7806765f1ad9fb840e2f27683521c1784a8d1a2b10db85d2a5e7414eb7ab53c0","availableFormats":["json"],"listOfBooksApiLink":"/api/con_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":310,"totalNumberOfVerses":9422,"languageName":"Cofán","languageEnglishName":"Cofán"},"book":{"id":"REV","translationId":"con_wbt","name":"Canjaen'cho","commonName":"Canjaen'cho","title":"Jesucristo canjaen'cho El Apocalipsis","order":66,"numberOfChapters":22,"sha256":"4b9019cb36d666ec3a302bb4088c09383de5ede55bb1d058dada909387652a4c","firstChapterNumber":1,"firstChapterApiLink":"/api/con_wbt/REV/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/con_wbt/REV/22.json","totalNumberOfVerses":403},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":["Tsa'caen pañamba gi faesu sefacconi'su shondo'suma atte. Tisenga Chiga anttesi sefaccone andepa osha'chone na'su tsu. Tsa'caen ti'tsse'tssiapa chanjumba tsu pa'cco andema attian."]},{"type":"verse","number":2,"content":["Tsaja fundondo'e afapa su:",{"text":"¡Tsangae tsu nepi!","poem":1},{"lineBreak":true},{"text":"¡Tsangae tsu Ti'tsse'tssia","poem":1},{"text":"Babilonia canqque nepi!","poem":2},{"text":"Tsangae nepipa cocoya","poem":1},{"text":"can'jen'ttive tsu da.","poem":2},{"text":"Poi ega aya, tse'tti can'jensi","poem":1},{"text":"egae fensian'su chhiriria'qque","poem":2},{"lineBreak":true},{"text":"tse'tti tsao'paemba can'jen'fa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nane Babiloniambe vinoma","poem":1},{"text":"cu'ipa ccusipaqquia'caen","poem":2},{"lineBreak":true},{"text":"poi andesundeccu tisei'ccu egae tsincon'fa.","poem":2},{"text":"Poi ande'su nasundeccu'qque","poem":1},{"text":"tisei'ccu fae'ngae can'jemba","poem":2},{"lineBreak":true},{"text":"tsa'caen egae tsincon'fa.","poem":2},{"text":"Nane poi ganasundeccu'qque","poem":1},{"text":"Babilonia'su injanga patsuye in'jan'choma","poem":2},{"lineBreak":true},{"text":"ipa chavaemba ganamba","poem":2},{"lineBreak":true},{"text":"ricove da'fa.","poem":2}]},{"type":"verse","number":4,"content":["Faesu aya'fa sefaccone afasi gi paña:",{"text":"¡Ña aindeccuja!","poem":1},{"lineBreak":true},{"text":"Va canqque'ye sombo'faja,","poem":1},{"text":"tisei'ccu egae tsinconsa'ne.","poem":2},{"text":"Tisema cati'faja","poem":1},{"text":"fae'ngae tisei'ccu Chiga iyicca'yepa vanaeña'chonga vanasa'ne.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nane tise'pa egae tsincon'choma agattopa","poem":1},{"text":"boñaqquia'caen Chiga sefacconi tsu nepi'fa.","poem":2},{"text":"Chiga Quitsaja tise'pa egae tsincon'choma injan'jemba","poem":1}]},{"type":"verse","number":6,"content":[{"text":"tise'pama egae tsoña.","poem":2},{"text":"Nane tsa canqque egae tsonqquia'caen tsu","poem":1},{"text":"Chigaja ccane'qque tisema egae tsoña.","poem":2},{"text":"Dos se ti'tsse egae tsonqquia'caen","poem":1},{"text":"tsu tisema egae tsoña.","poem":2},{"text":"Tise'pa afe'cho cui'ccuma","poem":1},{"text":"ti'tsse inza'tssia'ma tsu","poem":2},{"lineBreak":true},{"text":"Chigaja tise'panga cui'ñaña.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tisuja ñotssia qquen panshaen in'jamba injanga cansesi","poem":1},{"text":"tsu Chigaja ccane'qque tise'pama iñetsse vanaeña.","poem":2},{"text":"Tisu injama'choni Babiloniaja su:","poem":1},{"text":"“Ña gi na'su pushesu.","poem":2},{"lineBreak":true},{"text":"Na'su dyaipa'chonga dyaipa gi manda.","poem":2},{"text":"Tsandupajen'chombi gi.","poem":1},{"text":"Minguite'qque ñombi'yepa","poem":2},{"lineBreak":true},{"text":"i'naña'bi gi.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tsa'caen supa tsu ñoa'me","poem":1},{"text":"fae a'ta'yi tiseja osha'cho","poem":2},{"lineBreak":true},{"text":"paqque'sui'ccu vanaña.","poem":2},{"text":"Nane paqque'suma setsapa paya.","poem":1},{"text":"Vana'jemba i'naña.","poem":2},{"text":"Aña'chove'qque me'i'onsi","poem":1},{"text":"qquipoe'suya.","poem":2},{"text":"Toya'caen si'ngenga tsu ju'ruya.","poem":1},{"lineBreak":true},{"text":"Na'su Chiga Quitsaja osha'choma oshachopa","poem":1},{"text":"tsu Babiloniambe injama'choma somboeña.","poem":2}]},{"type":"verse","number":9,"content":["Tise pasi tsu va ande'su nasundeccuja tisene ñombi'yepa i'na'faya. Nane tisei'ccu fae'ngae injanga co'fe cansepa tsu fae'ngae egae tsincon'fa. Tsa'camba tsu tsa canqquema oquesi biane ccutsupa onfen'bama can'boen'faya."]},{"type":"verse","number":10,"content":["Nane fae'ngae ju'rusa'ne tsu tsa'caen dyopa biane ccutsupa i'namba su'faya:",{"text":"¡Ay, va'cha qui,","poem":1},{"text":"rande ti'tsse'tssia Babilonia canqque!","poem":2},{"text":"Fae a'tayi qui","poem":1},{"text":"junde tsa'caen vana'jen.","poem":2}]},{"type":"verse","number":11,"content":["Poi ande'su chavapa chavaemba ganasundeccu'qque tisene ñombi'yepa i'na'faya. Majañi'qque tise'pa andu'choma chava'faya'bisi tsu i'na'faya."]},{"type":"verse","number":12,"content":["Nane tise'pa chavaeñe an'bian'cho tsu cori, totoa cori, bare'cho patu, totoa moyo; tise'pa ñotssia totoa sarupa, na'su inzia sarupa, sera, cu'a sarupa'qque; ño'metssia quini'cco, nane erefante tte'ttoma ñoña'cho, bare'cho quini'ccoma ñoña'cho, yoshava, quiopa yoshava, totoa patuma ñoña'cho'qque;"]},{"type":"verse","number":13,"content":["nane ispingo, ñome'ba, oque oraenqque'su ñome'ba, mirra seje'pa, ño'metssia onjonqque'su yayapa; vino, yayapa, panme ñoñaqque'su, ppu'ppu'qque; vaura, oveja, cavayo'qque; cavayoi'ccu qquitssaqque'su caro, a'i semasundeccu'qque. Tsa'caen tsu chavaen'fa. Nane a'i injama'choma chavaenqquia'caen tsu tsa'caen chavaen'fa. Pa'cco va tise'pa an'bian'choma chavaeñe oshambipa tsu ñoa'me i'na'faya."]},{"type":"verse","number":14,"content":["I'namba tsa canqquema su'faya:",{"text":"Que injama'cho tsosipie in'jan'choja","poem":1},{"text":"tsangae tsu nepi.","poem":2},{"text":"Pa'cco que ñotssia jincho'cho","poem":1},{"text":"me'i'en tsu da.","poem":2},{"text":"¡Tsangae tsu nepi'fa!","poem":1}]},{"type":"verse","number":15,"content":["Nane tsa andu'choma chavaemba ricove dasundeccuja Babilonia vana'jen'choma can'boemba dyo'faya. Dyopa fae'ngae ju'rusa'ne biane ñombi'ye ccutsupa i'na'faya."]},{"type":"verse","number":16,"content":["I'namba tsu fundondo'e afa'faya:",{"text":"¡Ay, va'cha tsu tsa ti'tsse'tssia canqque!","poem":1},{"lineBreak":true},{"text":"Ñotssia pushesia'caen tototssia sarupama ondiccupa,","poem":1},{"text":"na'su inzia,","poem":2},{"lineBreak":true},{"text":"cu'ai'ccu opoemba,","poem":2},{"lineBreak":true},{"text":"cori, bare'cho patu,","poem":2},{"lineBreak":true},{"text":"totoa moyoi'ccu veyaratssia've tsu chanjun'jen.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tsa'ma tse'faei'ccuyi","poem":1},{"text":"tsu fae a'ta pa'cco tise ñotssiaja osefa.","poem":2},"Poi mar'ye jacanqque'su shavo nasundeccu, shavongae jacansundeccu, shavonga semasundeccu'qque, nane poiyi'cco majan marnga semamba ganasundeccu'qque biane ccutsupa"]},{"type":"verse","number":18,"content":["Babiloniama oque'je'cho onfen'bama attepa qquen quia'me afa'faya: —¿Minguite tsu qque'an canqqueja jiña?"]},{"type":"verse","number":19,"content":["Ñombi'ye'choma canjaeñe in'jamba ande'su ccuttopa'sima tise'pa tsovenga ttovapa i'na'faya. I'namba attuse'jepa su'faya:",{"text":"¡Ay, va'cha tsu tsa ti'tsse'tssia canqque!","poem":1},{"lineBreak":true},{"text":"Poiyi'cco marni'su shavo nasundeccu tiseni japa","poem":1},{"text":"tise corifin'di'ccu ricove da'fa.","poem":2},{"text":"Tsa'ma tse'faei'ccuyi","poem":1},{"text":"fae a'ta tiseja pa'tssima qqueña.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Tsa'ma Chiga sefacconi","poem":1},{"text":"can'jensundeccu","poem":2},{"lineBreak":true},{"text":"¡avujatssi'faja!","poem":2},{"text":"Chigambe aindeccu'qque","poem":1},{"text":"¡avujatssi'faja!","poem":2},{"text":"Chiga Aya'fama afasundeccu,","poem":1},{"text":"Jesucristone afasundeccu'qque, tsa canqque tsangae nepi'nijan","poem":2},{"lineBreak":true},{"text":"¡poiyi'cco avujatssi'faja!","poem":2},{"text":"Nane tise que'ima vanaensi","poem":1},{"text":"Chiga tise injama'choma tayo somboe'nijan","poem":2},{"lineBreak":true},{"text":"¡avujatssi'faja!","poem":2}]},{"type":"verse","number":21,"content":["Tsonsi quinsetssia Chigama sefacconi'su shondo'su rande patuma isupa marnga ttova. Rande sunda'cho patiaca'on tsu. Marnga ttova catipa su:",{"text":"Qquen tsu ti'tsse'tssia Babilonia canqqueta","poem":1},{"text":"quia'me vanamba nepiya.","poem":2},{"text":"Minguite'qque tsu tisema ccase atte'faya'bi.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Nane, Babilonia, ccase qui paña'faya'bi guitara'ca'ma,","poem":1},{"text":"ni settapoen'choma,","poem":2},{"lineBreak":true},{"text":"ni fororo'ccoma,","poem":2},{"lineBreak":true},{"text":"ni jen'choma'qque.","poem":2},{"text":"Osha'chove semasundeccu'qque queni ccase sema'faya'bi.","poem":1},{"lineBreak":true},{"text":"Nane ppu'ppu sunda'cho patu mutsino'jen'choma'qque queni ccase paña'faya'bi.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Toya'caen tuño, ramparia'qque queni ccase chanjuña'bi.","poem":1},{"lineBreak":true},{"text":"Minguite'qque tsandie pushe'jepa","poem":1},{"text":"avujatsse queni ccase fiestaeña'bi.","poem":2},{"text":"Queni'su chavaemba ganasundeccuja","poem":1},{"text":"poi ande'su ganasundeccuma ti'tsse'tsse gana'fa.","poem":2},{"text":"Queni'su afopa'cho corangadeccuja","poem":1},{"text":"poi ande'su aindeccuma afopoemba qqueña'fa.","poem":2}]},{"type":"verse","number":24,"content":["Nane tsa Babilonia canqqueni tsu Chiga Aya'fama afasundeccuma fi'tti'fa. Chiga aindeccuma'qque fi'ttisi tseni pa'fa. Nane Babiloniaja poi andeni'su aindeccuma fitti'tti'su tsu."]}],"footnotes":[]},"thisChapterLink":"/api/con_wbt/REV/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/con_wbt/REV/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/con_wbt/REV/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}