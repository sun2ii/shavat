{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"EZK","translationId":"cpy_wbt","name":"EZEQUIEL","commonName":"EZEQUIEL","title":"EZEQUIEL","order":26,"numberOfChapters":28,"sha256":"024acad27496e57d0e3bdf50e3d540b08bccca0c5ad3f1e78743ed81e9011874","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/EZK/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/cpy_wbt/EZK/28.json","totalNumberOfVerses":23},"chapter":{"number":28,"content":[{"type":"heading","content":["Kaariperori ñaantsi ikamanteetziriri pinkatharitatsiri nampitsiki Tiro"]},{"type":"verse","number":1,"content":["Ipokaki Tajorentsi jempe nojeeki naaka, ikantakina:"]},{"type":"verse","number":2,"content":["“Shirampari, eeroka noñaanatzi, piyaate pikamanteri iroka ñaantsi pinkatharitatsiri nampitsiki Tiro:",{"lineBreak":true},"‘Iroka ikantaki Tajorentsi:",{"lineBreak":true},{"text":"Owanaana piñaaperowaetaka pishireki,","poem":1},{"lineBreak":true},{"text":"pipinkathatashitakari tajorentsiniro","poem":1},{"lineBreak":true},{"text":"riitaki jeekaentsiri iwinkatharimentoki tajorentsiniro","poem":1},{"lineBreak":true},{"text":"othonka otapotakimi inkaare.","poem":1},{"lineBreak":true},{"text":"Tema eeroka tee pitajorentsitzi, atziri pini,","poem":1},{"lineBreak":true},{"text":"eeroka kenkithashiretashitacha apaniroeni ijeekitantakimi riyomento tajorentsiniro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¿Poshiyakaatzi pawijakiri okaatzi riyotanitari Daniel?","poem":1},{"lineBreak":true},{"text":"¿Tzimatsima nomanimotzimiri kaari piyotzi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tema roori piyotani, okaatzi paawiiri eeroka","poem":1},{"lineBreak":true},{"text":"pimatakiro otzimimotzimi osheki koetyiimotzimiri,","poem":1},{"lineBreak":true},{"text":"piyeekitakiro powantariri ooro eejatzi koriki.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Osheki pashiminthatawo eeroka pipimantawaetzi","poem":1},{"lineBreak":true},{"text":"poshekyaakiro pashaahawo,","poem":1},{"lineBreak":true},{"text":"rootaki pashaahawo ñaaperotakayimiri pishireki.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Rootaki ikantantari Tajorentsi:","poem":1},{"lineBreak":true},{"text":"Pantzirorika riitaki yotanitakayimiri tajorentsiniro,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"nokantakahaeyaawo ipoke paashinijatzi atziri rowayiritemi,","poem":1},{"lineBreak":true},{"text":"mataperori iyatsimate atziripaeni,","poem":1},{"lineBreak":true},{"text":"riitaki ameroni rojataamento rowamayemi,","poem":1},{"lineBreak":true},{"text":"eeroka rompoje, owanaana pikameethatzi, yotaniri,","poem":1},{"lineBreak":true},{"text":"aritaki papaawaeteeya pookawenteeyaawo powaneenkawo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rookaetemi inthomoyaaki,","poem":1},{"lineBreak":true},{"text":"eerowa pikamita niyankyaaki inkaare.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¿Eekiroma pikenkithashiretatziiri tajorentsiniro,","poem":1},{"lineBreak":true},{"text":"arika piñaawakiri ikaate maemanetemini?","poem":1},{"lineBreak":true},{"text":"¡Arika rotaeyemi ompojemini","poem":1},{"lineBreak":true},{"text":"tekatsira piitya eeroka atzirimacheeni pini!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Rowamayemi paashinijatzi atziri,","poem":1},{"lineBreak":true},{"text":"poshiyeeyaari rompojeetziri kaariperoshireri.","poem":1},{"lineBreak":true},{"text":"Naaka Tajorentsi, kenkithawaetatsiri,","poem":1},{"lineBreak":true},{"text":"aritaki nokamantakimi.’”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ikantakina eejatzi Tajorentsi:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"“Atziri pini eeroka, iroka omampahaantsi pomampaakotyaari pinkatharitatsiri nampitsiki Tiro, pikanteri:","poem":1},{"lineBreak":true},{"text":"Iroka iñaane Tajorentsi, ikantzi:","poem":1},{"lineBreak":true},{"text":"Owanaana pikameethawitaka eeroka, yotani pikanta, owaneenkaki pikanta.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Pinampiwitakawo pankirentsimashiki Edén-ki, rashitakaawitakimiri Tajorentsi,","poem":1},{"lineBreak":true},{"text":"Osheki owaneenkataka okantakaawo kantawaeyitachari mapiki poreryaari.","poem":1},{"lineBreak":true},{"text":"Pithatanitari ooro rowetsikaetakimiri owakira pañaanaki.","poem":1},{"noteId":0}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"eenitatsi aayitatsiri, paamaawentyaari, pijeekaki ochempiki itajorentsitakaakiri Tajorentsi.","poem":1},{"lineBreak":true},{"text":"Panashiwaetzi jempe ipiyotapaa ompokiro.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tekatsi pikinakaashitya, kameethari pikanta owakira rowetsikaetakimi","poem":1},{"lineBreak":true},{"text":"Roojatzi pikaariperotantanakari.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tzimanaki osheki pashaahawo, osheki pikoshekawaetanaka, owanaana pikaariperotanaki.","poem":1},{"lineBreak":true},{"text":"Rootaki nookantakimiri, tee nokowe pijeekimotena.","poem":1},{"lineBreak":true},{"text":"Nomishitowakimi pijeekawitaha ochempiki rashitari Tajorentsi.","poem":1},{"lineBreak":true},{"text":"Riitaki omishitowakimiri aayitatsiri, pitsipawitari pinampitawo ompokiromashiki.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Piñaakiro powaneenkata, owanaana piñaaperotanaka pishireki.","poem":1},{"lineBreak":true},{"text":"Osheki omajontyaanakimi pishipakiryaanakira.","poem":1},{"lineBreak":true},{"text":"Nookakimi jaawi, osheki pikaanitaki piñaakirira raminaminthatakimi pinkatharipaeni nomishitowakimira.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Owanaana pikaariperotaki, maperori okoweenkatakaakimi pashaahawo,","poem":1},{"lineBreak":true},{"text":"Iwinkani rowaeta pitajorentsipankote.","poem":1},{"lineBreak":true},{"text":"Rootaki nowantakari paamari jempe pijeeke eeroka, riitaki thonkaemini itaayimi.","poem":1},{"lineBreak":true},{"text":"Iñahaemi pisamampotee jaawi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Maawoeni atziri ikaate ñahaemini, osheki ithaawakaemi.","poem":1},{"lineBreak":true},{"text":"Koweenkaki pikanteeya. Ashi powaero eero pitzimae.”","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"28.13 Ikanteetziri jaka “mapiki poreryaari”, riitaki ikanteetziri eejatzi: rubí, crisólito, jade, topacio, cornalina, jaspe, zafiro, granate eejatzi esmeralda.","reference":{"chapter":28,"verse":13}}]},"thisChapterLink":"/api/cpy_wbt/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/DAN/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":19}