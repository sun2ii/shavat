{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"GEN","translationId":"cpy_wbt","name":"ETANTA-NAKARI","commonName":"ETANTA-NAKARI","title":"ETANTA-NAKARI","order":1,"numberOfChapters":50,"sha256":"3c6b4bc3ddfefa284c722e13b0fd332c021a32814ee5cd6f93b301ff8d138acc","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cpy_wbt/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"verse","number":1,"content":["Ikaemakiri Jacob maawoeni itomipaeni, ikantakiri: “Pontsirokena okaakiini, nokamantatyeemirowa okaate awijimotemini paata."]},{"type":"verse","number":2,"content":[{"text":"¡Itomipaeni Jacob! Pipokaeyeni okaakiini pikemantyaari.","poem":1},{"lineBreak":true},{"text":"Powayempitatyaariri pipaapate Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Eeroka Rubén, neewarite notyomi,","poem":1},{"lineBreak":true},{"text":"Noshintsinka noyimi, eerokataki etakaantanakawori noshintsinka,","poem":1},{"lineBreak":true},{"text":"Eeroka etawori ipinkatheetzimi, oshekitzimotzimi pishintsinka.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ari okaatzimaetapaaka piriroperotane,","poem":1},{"lineBreak":true},{"text":"Poshiyawitapiintakawo oshinchaari nijaa,","poem":1},{"lineBreak":true},{"text":"Tema pitheenkaneentzitakinawo nomaamento.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rooma eeroka Simeón eejatzi Leví, pirentzi powawakaeyaani,","poem":1},{"lineBreak":true},{"text":"Powamaamento powayitakiro pichekopitepaeni.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Eerowa napiiteero notsipateeyeemini jempe pipiyoteeyapiintani.","poem":1},{"lineBreak":true},{"text":"Tema otyahakimi paerani pimashirenka osheki atziri powamaaki.","poem":1},{"lineBreak":true},{"text":"Okantakaantziro pikijawaetaka piitzinkakiiwaetanakiri piratsipaeni.","poem":1},{"noteId":77}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Koweenkari okantaka piyatsimankari,","poem":1},{"lineBreak":true},{"text":"Omaperota pikijanaka.","poem":1},{"lineBreak":true},{"text":"Naaka mataperoteemini notzimpookayiteemi notsipatahaemiri Israel-ite.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Rooma eeroka Judá, rajahaawenteemi pirentzipaeni.","poem":1},{"lineBreak":true},{"text":"Poteeyakentsiyiteeri kijaneentemini.","poem":1},{"lineBreak":true},{"text":"Ipinkathayiteemi pirentziteeyaari.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Eeroka Judá, notyomitari naaka.","poem":1},{"lineBreak":true},{"text":"Poshiyaari iryaani manitzi aririka ipakaeri rowari ratsikane.","poem":1},{"lineBreak":true},{"text":"Roeyoota, romaryaawaeta kepatsiki, ikantaha antari manitzi.","poem":1},{"lineBreak":true},{"text":"¿Iitaka materoni oñaashirenkaerini?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tekatsira materoni raapithateeri ishintsinka Judá,","poem":1},{"lineBreak":true},{"text":"Tekatsi aapithateerini iwinkatharimento roteeyakiri,","poem":1},{"lineBreak":true},{"text":"Roojatzi ipokantakyaari ashitawori iwinkatharimento,","poem":1},{"lineBreak":true},{"text":"Ikemijantawakiri inashiyitachari roshekitawakayitaha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Riitaki oojotakoterini iyawayote oponkitziki pankirentsi rireetziri,","poem":1},{"lineBreak":true},{"text":"Ikiwantawo rireetziri maawoeni iithaari, tema oshekiperotatzi chochoki rireetziri.","poem":1},{"noteId":78}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kameethantzi ikanteeya, tema cheenkaakiri okantayitya rooki awijanakiro ocheenkatzi rireetziri.","poem":1},{"lineBreak":true},{"text":"Kitamaari okantayitya raeki awijanakiro okitamaatzi tenitsi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Inampiteeyaawo Zabulón inkaarecheraki,","poem":1},{"lineBreak":true},{"text":"jempe aatapiintayita amaatakomentotsi.","poem":1},{"lineBreak":true},{"text":"Ari iweyaathapiyiteeyaani roojatzi janta Sidón-ki.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Roshiyeeyaari Isacar piratsi ikyaakahaetari,","poem":1},{"lineBreak":true},{"text":"Ari makoryaapiintatsini piratsipankoki.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ikanta iñaawakirowa kameethari owetsikaka imakoryaanteetyaawo,","poem":1},{"lineBreak":true},{"text":"Oeyootanaka inatakahaeteri.","poem":1},{"lineBreak":true},{"text":"Maeriri ikantaka roshiyakahaetziri omperataarewo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ipinkathariwenteeri Dan isheninka ikimitaa itsipa ipinkathariwenteeri Israel-ite.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Roshiyeeyaari Dan maanki ijeeki awotsinampiki,","poem":1},{"lineBreak":true},{"text":"Riitaki atsikakiiterini kawayo,","poem":1},{"lineBreak":true},{"text":"Rowariimaetyaari kyaakotariri.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"¡Tajorentsi! Nawentahaemi powawijaakoteena.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ikoshekawaetaari Had owayiri-paeni,","poem":1},{"lineBreak":true},{"text":"Riitaki kantacha aritaki nopiyatakyaari paata.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Riima Aser oshekitzimoteeri iwankiri rowaeyaari,","poem":1},{"lineBreak":true},{"text":"Kyaariperori owanawontsi ini, oshiyaawo rowanawo pinkathariperori.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Roshiyaari Neftalí maniro tekatsi ashitakoterini,","poem":1},{"lineBreak":true},{"text":"Owaneenkatacha ikantayita itomipaeni.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Riima José roshiyaawo pankirentsi shookatziiri ocheraki nijaa,","poem":1},{"lineBreak":true},{"text":"Osheki okithokinite,","poem":1},{"lineBreak":true},{"text":"Ithonkiro itaayitziro otanto.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Osheki ikijaneenteeri omanatzinkari,","poem":1},{"lineBreak":true},{"text":"Roma-natantapiinteeyaari chekopi,","poem":1},{"lineBreak":true},{"text":"Ikanteetatyeeyaani roñaashirenkapiinteeri.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Riitaki kantacha José shintsishempa ikanta rirori,","poem":1},{"lineBreak":true},{"text":"kijokiro royiro iwiani.","poem":1},{"lineBreak":true},{"text":"Ikaminthakiri Itajorentsite Jacob Shintsiri,","poem":1},{"lineBreak":true},{"text":"Okamintha iwaero kempoyaawentantaneri, kijakowentariri Israel.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ikamintha Itajorentsite ashitzimiri, ri neshironkateemini.","poem":1},{"lineBreak":true},{"text":"Riitaki Tajorentsi Shintsiperori, riitaki tajonkawenteemini.","poem":1},{"lineBreak":true},{"text":"Opoñaawo itajorenka jenoki ikiteki.","poem":1},{"lineBreak":true},{"text":"Opoñaawo itajorenka inthomoeyaaki inkaareki.","poem":1},{"lineBreak":true},{"text":"Opoñaawo itajorenka tenitsiki eejatzi owamaarentsiki.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Okaatzira ipasonkitakotanakimi ashitzimiri,","poem":1},{"lineBreak":true},{"text":"Awijanakiro okaatzi ipasonkitakotanari ashitanari naaka.","poem":1},{"lineBreak":true},{"text":"Eero opeyaawo, roojatzi paata eero iñahaetantaawo eejatzi ochempi.","poem":1},{"lineBreak":true},{"text":"Oshiyakawo ijeepatziitotanteetyaarimi José irokapaeni tajorenkantsi,","poem":1},{"lineBreak":true},{"text":"Tema riitaki riyoyahaetakiri itsipatakari rirentzipaeni, riitaki riroperoyitaatsini.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Roshiyeeyaari Benjamín owantaneri,","poem":1},{"lineBreak":true},{"text":"rananinki rowamanaari ratsikane,","poem":1},{"lineBreak":true},{"text":"Arika otsireniityaane ipawakaeyaani tzimahaantapaentsiri.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":["Riiyitakira isheninkapaeni Israel, rootaki ñaantsipaeni ikantanakiriri ipaapate ipasonkitakotanakari itomipaeni."]},{"type":"verse","number":29,"content":["Ikantanakiri itomipaeni: “Okaatapaakiini nokamantyaari. Pitsipatahaenari nocharinipaeni pinkitateena, omookira iipatsiteki Efrón Het-jatzi,"]},{"type":"verse","number":30,"content":["jeekatsiri janta Canaán-ki. Rootaki omoowa jeekatsiri Macpela-ki, amontetari Mamre, ramanantakiri paerani Abraham itsipataakiro iipatsite Efrón, okitataaha iina."]},{"type":"verse","number":31,"content":["Jaha ikiteetakiri Abraham itsipatahaetakiri iina Sara, eejatzi Isaac itsipatahaetakiri iina Rebeca. Ari nokitateero eejatzi Lea."]},{"type":"verse","number":32,"content":["Ironta kepatsi eejatzi omookira jeekatsiri janta riira Het-jatzi pimantakirori paerani.”"]},{"type":"verse","number":33,"content":["Ikanta ithonkari Jacob riyotaayitanayiri itomipaeni, ari roma-ryaanakari, kamanaki. Itsipatapaari isheninkapaeni."]}],"footnotes":[{"noteId":77,"caller":"+","text":"49.6 Kantakotachari jaka “piratsipaeni” irijatzi ikanteetzitari “toro”.","reference":{"chapter":49,"verse":6}},{"noteId":78,"caller":"+","text":"49.11 Kantakotachari jaka “riitaki oojotakoterini iyawayote oponkitziki pankirentsi rireetziri,” roo oshiyaawori ikanteete “Oshekiperotatziira pankirentsi rireetziri, tee ineshironkatziro pankirentsi otomipaeni ikawayote rowamayirowa.”","reference":{"chapter":49,"verse":11}}]},"thisChapterLink":"/api/cpy_wbt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}