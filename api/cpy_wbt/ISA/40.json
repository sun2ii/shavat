{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"ISA","translationId":"cpy_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"IKAMANTANTAKIRI ISAÍAS","order":23,"numberOfChapters":61,"sha256":"69b18cbb824696020518770f2ab09c69b0105ae4b74c8fed1d43b5228a3c93ce","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/cpy_wbt/ISA/61.json","totalNumberOfVerses":95},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":[{"text":"Iroka ikantzi Pitajorentsite:","poem":1},{"lineBreak":true},{"text":"“Poetzimoshirenkaeyeenani. Poemoshirenkaeyeenani nonampikika.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pinintathateri piñaanateri nampiwitawori Jerusalén-ki.","poem":1},{"lineBreak":true},{"text":"Pikamanteeri, pikanteri: ‘Ari okaatapaaki romperaetzimi, ipinakowenteetakiro pikinakaashitani,","poem":1},{"lineBreak":true},{"text":"Imaperotakimi rowajankitzimi pikaariperotakira.’”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Icheraapaaki, ikantantapaaki:","poem":1},{"lineBreak":true},{"text":"Powameethateeniri Tajorentsi ikinapaakira ochempimashiki,","poem":1},{"lineBreak":true},{"text":"Poshiyakaahaeniri Tajorentsi itampatzikaetziro awotsi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Omameripathatee otenkanaayitzira,","poem":1},{"lineBreak":true},{"text":"Okarenipathayitee ochempi,","poem":1},{"lineBreak":true},{"text":"Okaatzira otenkanaayitzi nimaeka, okaatzira ochempimashitzi,","poem":1},{"lineBreak":true},{"text":"Karenipankaari okanteeya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Roñaahanteero Tajorentsi rowaniinkawo, ipiyoteeya atziriite ikaatzi ñahaerori.","poem":1},{"lineBreak":true},{"text":"Riitaki Tajorentsi kenkithawaetakirori iroka ñaantsi.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cpy_wbt/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":5}