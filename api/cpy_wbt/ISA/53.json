{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"ISA","translationId":"cpy_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"IKAMANTANTAKIRI ISAÍAS","order":23,"numberOfChapters":61,"sha256":"69b18cbb824696020518770f2ab09c69b0105ae4b74c8fed1d43b5228a3c93ce","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/cpy_wbt/ISA/61.json","totalNumberOfVerses":95},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"¿Iitaka kemijanteroni okaatzi akemakiri?","poem":1},{"lineBreak":true},{"text":"¿Iitaka ñaakirori ishintsinkari Tajorentsi?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ikimotatakaaki nomperatani ijeekanikira Tajorentsi,","poem":1},{"lineBreak":true},{"text":"Roshiyakaakiri owakira parithatatsiri pankirentsi,","poem":1},{"lineBreak":true},{"text":"Rooma kepatsi kaari oshookanta pankirentsi,","poem":1},{"lineBreak":true},{"text":"Tee orooperotzi okameethate, tee owaneenkata,","poem":1},{"lineBreak":true},{"text":"Tekatsi ñaamatyaawoni okantawaetaha,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Maninta royiro maawoeni atziri, tee ikoyiro.","poem":1},{"lineBreak":true},{"text":"Antawoete okatsitzimotziri atziri, rametakawo okantzimoshirewaetari.","poem":1},{"lineBreak":true},{"text":"Roshiyawaetakari kaari ñaamataawo iñahaeteri, manintaarewo oyiri, tee akenkithashiretakoteri.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Omaperotatya, riitaki aanakirori akemaatsiyitakari,","poem":1},{"lineBreak":true},{"text":"Irijatzi aanakirori akemaatsiwaetari.","poem":1},{"lineBreak":true},{"text":"Tema riitaki owatsinaawaetakiriri Tajorentsi,","poem":1},{"lineBreak":true},{"text":"Riitaki owajankiwaetakiri, riitaki owaañaawaetakiriri eejatzi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Rojatahaetakiri okantakaantziro ipiyathawaetaka,","poem":1},{"lineBreak":true},{"text":"Ikemaatsitakahaetakari okantakaantziro iyaariperonkari.","poem":1},{"lineBreak":true},{"text":"Ikanta rowajankitzitakiri rootaki ijeekantaari kameethaeni.","poem":1},{"lineBreak":true},{"text":"Ikanta rowatsinaetakiri, roojatzi retsiyatakotantaari.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Atzipinawaetaki aakaete maawoeni oshiyawaetakari owisha tzipinari, akinawaetashitaka jemperikapaeni,","poem":1},{"lineBreak":true},{"text":"Riitaki kantacha Tajorentsi, ratsipetakaakari irika ayaariperonkari aakaete.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ipajawaeteetakiri, ishinetaka tee ikaaniwaetzi,","poem":1},{"lineBreak":true},{"text":"Tee iñaawaetzi eepichokiini ikenkithawaetapaente.","poem":1},{"lineBreak":true},{"text":"Roshiyakahaetakiri rahaetziri owisha rowamahaeteri.","poem":1},{"lineBreak":true},{"text":"Roshiyakari owisha tee ikaemawaete arika rameeteeteri,","poem":1},{"lineBreak":true},{"text":"Ari ikantakari rirori, maeriri ikantaka.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tsinampashireri ikantakaakari, tee ariperori okaatzi ikantakowiteekariri.","poem":1},{"lineBreak":true},{"text":"Ikanta rowamahaetakiri, tee itzime itomipaeni.","poem":1},{"lineBreak":true},{"text":"Rowamahaetakiri ikantakaantziro natzirite.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Itsipatahaetakiri kaariperoshireri ikitaetakiri,","poem":1},{"lineBreak":true},{"text":"Itsipatahaetakiri kaminkari atziri katsimashireri,","poem":1},{"lineBreak":true},{"text":"Tekatsi iyaariperonkari rirori,","poem":1},{"lineBreak":true},{"text":"Tee itheeyapaantetapaentya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tee ishintsineenteri Tajorentsi ikemaatsitakahaeyaari.","poem":1},{"lineBreak":true},{"text":"Riitaki kowashiteencha ratsipetakowentyaari kaariperori, rañaanteeyaari, iñaayitanteeyaariri ichariniyitari.","poem":1},{"lineBreak":true},{"text":"Riitaki kantakaantakirori omatantakari rantawaeri Tajorentsi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Osheki ikemaatsiwentakawo iñaantawori kitejiinkari, osheki ikimoshirete arika iñaahaero awijeentsiri.","poem":1},{"lineBreak":true},{"text":"Irika tampatzikashireri nomperatani osheki rontsiparyaakowentee, riitaki ikemaatenatakaayita iyaariperonkari atziriite.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Roejeekaeri Tajorentsi ijeekamentoki riroperoriite, itsipateeyaari shintsiperori oetsinampaanteentsiri,","poem":1},{"lineBreak":true},{"text":"Tema ishinetaka ikamimotante, roshiyakahaetakiri riimi kaariperori,","poem":1},{"lineBreak":true},{"text":"Riiwitaka ikematenatakahaetakari iyaariperonkari osheki, rowatsinaryaakotairi kaariperoshireriite.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cpy_wbt/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}