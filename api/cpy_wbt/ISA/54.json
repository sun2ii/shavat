{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"ISA","translationId":"cpy_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"IKAMANTANTAKIRI ISAÍAS","order":23,"numberOfChapters":61,"sha256":"69b18cbb824696020518770f2ab09c69b0105ae4b74c8fed1d43b5228a3c93ce","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/cpy_wbt/ISA/61.json","totalNumberOfVerses":95},"chapter":{"number":54,"content":[{"type":"verse","number":1,"content":[{"text":"Iroka ikantzi Tajorentsi:","poem":1},{"lineBreak":true},{"text":"“Okantawitaka tee powaeyeeya, maaniromanthaki pinawitaka, roori kantzimaetacha antawoete pinkimoshiretee.","poem":1},{"lineBreak":true},{"text":"Tee pikemaatsiwitya powaeyante, pithaamenteeyaani.","poem":1},{"lineBreak":true},{"text":"Osheki tzimaatsini pitomipaeni okantawitaka imaninteetakimi, pawijaero nimaeka tzimatsiri oemi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Poemotero pipankonaki eero pithaawakaawo pomaankero pijeekantakari.","poem":1},{"lineBreak":true},{"text":"Pishiryeero oojotantari, pikentakotero kameethaeni,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tema osheki poewawahayiteeya.","poem":1},{"lineBreak":true},{"text":"Piyaate pisheninkaki otsipaki nampitsi, inampiteeyaawo ochempiki jempe tee inampiiteetawo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Eero ominthaawashiriimi, riroperori pikantya, tekatsi kaweyawaetemini, tekatsi pikaaniwente.","poem":1},{"lineBreak":true},{"text":"Pimaesantero pikantaha paerani pikaaniwenta, eero pikenkithashireteero rowinkatharyeetemi pikinankaritzira,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oshiyawo riimi Tajorentsi inanteeyaatyeemimi.","poem":1},{"lineBreak":true},{"text":"Iroka iwaero Tajorentsi shintsiperori, riitaki pinakowenteemiri, Tajorentsi rini Itajorentsite Israel, Itajorentsite jaawijatzi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Poshiyakawo ookaarewo ewankawo, ashironkaawaetachari,","poem":1},{"lineBreak":true},{"text":"Roori kantzimaetacha ikaemaemi Pitajorentsite, ikanteemi:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"“Eepichoki nookawentakimi, roori kantzimaetacha antawoete netakotzimi nopiyashiteemi notsipateeyeemini.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Antawoete nokijapaenta, eepichokiini nookawentakimi,","poem":1},{"lineBreak":true},{"text":"Roori kantacha ojamani okanteeya noneshironkateemi.”","poem":1},{"lineBreak":true},{"text":"Rootaki iñaane Tajorentsi, pinakowenteeri.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"“Noshinetakiniri Noé, nokantakiri: ‘Eero apiiteero oonkaeya kepatsi.’","poem":1},{"lineBreak":true},{"text":"eenitatsi noshinetakimiri eejatzi eeroka, nokantzimi: ‘Eero napiiteero najariimataami.’","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ataakawitya tonkaariki, pookawita ochempi,","poem":1},{"lineBreak":true},{"text":"Eero napakaero noneshironkatzimi eerokaete, eero pipakayiro paapatziyawakaa eerokaete.”","poem":1},{"lineBreak":true},{"text":"Ari ikantzi iñaawaetaki Tajorentsi, neshironkaperotzimiri.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Rowashironkahaetani nampitsi, atsipetakawori tampyaa, tekatsi kantemini.","poem":1},{"lineBreak":true},{"text":"Naakataki piriinteeroni potanto nowetsikanteeyaawo porekatsiri mapi.","poem":1},{"lineBreak":true},{"text":"Osheki owanawo okanteeya otantotsi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Antawo nowetsikayiteero pankotsi, poreryaari okanteeya mapi nowetsikantyaawori.","poem":1},{"lineBreak":true},{"text":"Oshiyawo oporeryaatzi nijaa opatzimooki.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Niyotaayiteeri maawoeni notomiite, ijeekayitee kameethaeni.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tontashireri pikanteeya pitampatzikashiretee, pijeekashiwaeteeyani eero ishintsineenteeteemi,","poem":1},{"lineBreak":true},{"text":"Eero pithaawashiwaeta, eero okantzimoshirewaeteemi thawankantsi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Arika ikoshekaetemi, tee naaka kantakahaeyaawoni,","poem":1},{"lineBreak":true},{"text":"Roori kantacha, aritaki poetsinampaakiri eeroka ikaatzi maemanetemini.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"“Pikeme, naakataki owetsikakiri kotsiroempeki antawaeteerori paamari rowetsikayitzi omanamentotsi.","poem":1},{"lineBreak":true},{"text":"Naakataki owetsikakiri eejatzi thonkantaniri.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tekiraata otzimeeta omanamento materoni athonkante,","poem":1},{"lineBreak":true},{"text":"Santziko powaeri kantakowaetemini.","poem":1},{"lineBreak":true},{"text":"Noshineteeniri naaka ikaatzi antawaetanari: roetsinampaante.”","poem":1},{"lineBreak":true},{"text":"Riitaki Tajorentsi ñaawaetzirori iroka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cpy_wbt/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}