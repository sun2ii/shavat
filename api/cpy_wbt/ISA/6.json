{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"ISA","translationId":"cpy_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"IKAMANTANTAKIRI ISAÍAS","order":23,"numberOfChapters":61,"sha256":"69b18cbb824696020518770f2ab09c69b0105ae4b74c8fed1d43b5228a3c93ce","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/cpy_wbt/ISA/61.json","totalNumberOfVerses":95},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":["Ikanta ikamae pinkathari Uzías, ari noñaawyaatakari Tajorentsi ijeeki iwinkatharimentoki, ipamankantakawo ikithaari tajorentsipanko."]},{"type":"verse","number":2,"content":["eenitatsi jenokintaweri paamathaeteentsiri rowaatzinkaka ipatziitoki. eenitatsi 6 ishiwankiri. Apite ishiwankiri ipashikapootantari, apite okanta ipashikantari iwathaki, apite raantari."]},{"type":"verse","number":3,"content":["Apiipiitziro ikanteeyini:",{"text":"“Kiteshire, Kiteshire, Kiteshire rini, shintsiperori Tajorentsi,","poem":1},{"lineBreak":true},{"text":"Ipamankantakawo rowaniinkawo kepatsi.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ikanta ikamenitanaki iñaawaetzi, antawoete omoyekanaka ashiroki tajorentsipanko, kachaariinka okantanaka tajorentsipanko.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ari nokantashiretanaki: “¡Ikantamatsiteetana, nimaeka nokame! Nokitateeya Nowinkathariteki Tajorentsi Shintsiperori. Kaariperopaanteri nini, nojeekimotziri atziriite kaariperopaanteri.”","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ikanta apaani jenokintaweri oshiyakawori paamari, ipokashitapaakina. Ramakotaki paamarimenki raakiri taapokimentotsiki,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Rontsirokakiro nopaanteki, ikantana:","poem":1},{"lineBreak":true},{"text":"“Pamine, ontsirokakimi pipaanteki paamarimenki.","poem":1},{"lineBreak":true},{"text":"Ithonkaemiro piyaariperonkari,","poem":1},{"lineBreak":true},{"text":"Ipeyakoeteemiro pikaariperowitakaha.”","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ari nokemaki ikenkithawaetanaki Awinkatharite, ikantzi:","poem":1},{"lineBreak":true},{"text":"“¿Iitaka notyaanteri? ¿Iitaka jatatsini ikamantante?”","poem":1},"Nakanaki naaka, nokantzi:",{"text":"“Naaka potyaante.”","poem":1}]},{"type":"verse","number":9,"content":[{"text":"Ari ikantanakina:","poem":1},{"lineBreak":true},{"text":"“Pimatero, pikamanteeri atziriite, pikanteri:","poem":1},{"lineBreak":true},{"text":"‘Arika pikemawitya, eeromaeta pikemathatziro.","poem":1},{"lineBreak":true},{"text":"Arika paminawitya, eeromaeta piñiiro.’","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Eeroka kantakahaeyaawoni ikijoshiretanteetyaari,","poem":1},{"lineBreak":true},{"text":"witayempitari ikanteetya, imawityaakiyiite.","poem":1},{"lineBreak":true},{"text":"Rootaki eero ikowichaatanta,","poem":1},{"lineBreak":true},{"text":"Eero ikemanta,","poem":1},{"lineBreak":true},{"text":"Eero ikenkithashiretanta,","poem":1},{"lineBreak":true},{"text":"Tee ikemijantzi, rootaki eero rawijakotantaawo.”","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nokantziri:","poem":1},{"lineBreak":true},{"text":"“¡Noyinkatharite! ¿Okaateka ojamanite iroka?”","poem":1},"Ikantzi rirori:",{"text":"“Arika ithonkaeteeri paata jeekatsiri nampitsiki,","poem":1},{"lineBreak":true},{"text":"Kaankipanko okanteeya pankotsipaeni,","poem":1},{"lineBreak":true},{"text":"Kaankiitya okanteeya eejatzi osheki owaantsi.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ramaeri Tajorentsi thaankiini atziriite,","poem":1},{"lineBreak":true},{"text":"Kaankiite okanteeya nampitsiki tekatsi nampiteeyaawoni.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Itzimerika añaaneentsini apawopaeni,","poem":1},{"lineBreak":true},{"text":"Aritaki ithonkaetakiri eejatzi irikaete, roshiyeeyaawo itowaetziro meta ari ookanakiro isankahani.","poem":1},{"lineBreak":true},{"text":"Apatziro oshookamatsitee opiriniki.”","poem":1},{"noteId":0}]}],"footnotes":[{"noteId":0,"caller":"+","text":"6.13 Ikantakoetziri jaka “eepichokiini ikaate,” roojatzi ikantakoetzitari “itzimawita paerani 10 atziri, apaanimacheeni añaatsiri.”","reference":{"chapter":6,"verse":13}}]},"thisChapterLink":"/api/cpy_wbt/ISA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/ISA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/ISA/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}