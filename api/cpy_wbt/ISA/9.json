{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"ISA","translationId":"cpy_wbt","name":"ISAÍAS","commonName":"ISAÍAS","title":"IKAMANTANTAKIRI ISAÍAS","order":23,"numberOfChapters":61,"sha256":"69b18cbb824696020518770f2ab09c69b0105ae4b74c8fed1d43b5228a3c93ce","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/ISA/1.json","lastChapterNumber":61,"lastChapterApiLink":"/api/cpy_wbt/ISA/61.json","totalNumberOfVerses":95},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["Eero ojamanitzimaeta ikemaatsiteetya. Ari retakawo Tajorentsi rowashiwenteeri Zabulón-iite eejatzi Neftalí-ite. Rooma paata kyaariperori okanteeya nampitsi Halilea jempe ipiyotapaa atziri kaari asheninkata janta inkaarecheraki, intatsikero antawaaki nijaa Jordán."]},{"type":"verse","number":2,"content":[{"text":"Riitaki oshiyakawori ikinatyeemi otsirenirikitzira, riitaki ñaayiteeriri ootamentotsi.","poem":1},{"lineBreak":true},{"text":"Otsimankakowitakari raampari kathatayeri ikineemi sarinkaweniki.","poem":1},{"lineBreak":true},{"text":"Kimiwaetaka ijeekaatyeemi okiteenkatzira.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Poshekyaakiri atziriite,","poem":1},{"lineBreak":true},{"text":"Poemoshirenkaperoteeri riroriite.","poem":1},{"lineBreak":true},{"text":"Maawoeni ikimoshirewenteeyimini oshiyawaeteeyaawo ikimoshirewenteetziro arika rowiiteetero pankirentsi,","poem":1},{"lineBreak":true},{"text":"Oshiyawaetyaawo ikimoshirewenteetziro arika ranteteetyaawo ashaahawontsi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tema pontsiparyaakowenteeri eeroka romperanawaeteetari,","poem":1},{"lineBreak":true},{"text":"Powatsinaaryaakoteeri ishintsineentawaeteetziri,","poem":1},{"lineBreak":true},{"text":"Ikaatzi ikemaatsitakaayiitari reewawenteetziri.","poem":1},{"lineBreak":true},{"text":"Kimiwaetaka paerani paperaatantakariri Madián-jatziite.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Itayiteeteeri isapaatote owayiri-paeni ikamenitakayitziri ranashitantari.","poem":1},{"lineBreak":true},{"text":"Itayiteeteeri ikithaari iraatakiri iraantsi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tema tzimaki eenchaanikiri ishinetakayiri Tajorentsi. Ipakiri shintsinkantsi ipinkathariwentante. Ikanteetzi: Kempoyaawenta rowaeteniri ikenkithashiretari, Tajorentsi kaari roetsinampahaetziri, Añaari Ashitaanari, Pinkathariwentantatsiri ijeekaetzira kameethari.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Irijatzi pinkathariwenteerini ichariniyitari David,","poem":1},{"lineBreak":true},{"text":"Ithonkya ikemakoeteero ishintsinkari.","poem":1},{"lineBreak":true},{"text":"Okantaetatyeeya ijeekaetee kameethari,","poem":1},{"lineBreak":true},{"text":"Ashi owatyeero ipinkathariwentantee,","poem":1},{"lineBreak":true},{"text":"Tampatzikashireri rinaatye, kameethashireri ikantante,","poem":1},{"lineBreak":true},{"text":"Ari okantaetaatyeeyaani etanakyaawo nimaeka.","poem":1},{"lineBreak":true},{"text":"Thaamenta ikanteeya, Tajorentsi shintsiperori.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cpy_wbt/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":7}