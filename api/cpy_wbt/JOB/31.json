ntoki,","poem":1},{"lineBreak":true},{"text":"Rootaki tampatzika-tatsiri otenatantzi, otenatziro okaatzi nantziri kameetha-tatsiri!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cpy_wbt/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":5}