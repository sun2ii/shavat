{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"JOB","translationId":"cpy_wbt","name":"JOB","commonName":"JOB","title":"JOB","order":18,"numberOfChapters":42,"sha256":"0dfe36f1dd8c2485cabbfd200c24e656f0602cbe98d37048233acd5901f1d390","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cpy_wbt/JOB/42.json","totalNumberOfVerses":62},"chapter":{"number":38,"content":[{"type":"verse","number":1,"content":["Ari rakanakiri Tajorentsi irika Job ijeekan-takawo tampyaa, ikantakiri:"]},{"type":"verse","number":4,"content":[{"text":"“¡Job! ¿Jempema pijeekika eeroka owakira nowetsikan-taka-wori kepatsi?","poem":1},{"lineBreak":true},{"text":"¡Pakina, kyaari-perorika piyotanitzi!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Tema naaka kowaentsiri jempe iweyaa-thapi-yityaa kepatsi?","poem":1},{"lineBreak":true},{"text":"¿Tema naaka monkaatan-takawori shiwitha iroka keepatsi?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Tema naaka kijotakaa-kirori kepatsi nowetsikan-taka-wori?","poem":1},{"lineBreak":true},{"text":"¿Oshiyawi-takawo nowakityeeromi mapipaeni onampinaki pankotsi okijotan-tyaari?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tema rootaki nantakiri paerani nowetsikan-taka-wori iroka kepatsi, rakishiyeen-kata-ha romampae-yani kiteje-takori ompokiropaeni,","poem":1},{"lineBreak":true},{"text":"Tema thaamenteeyachani irika ronampiripaeni Tajorentsi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cpy_wbt/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":5}