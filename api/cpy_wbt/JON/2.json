{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"JON","translationId":"cpy_wbt","name":"JONÁS","commonName":"JONÁS","title":"JONÁS","order":32,"numberOfChapters":4,"sha256":"cf62f1827699ac1956dd2fac676b04a5536c96e800b35b4ed8500872548bab1c","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/cpy_wbt/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Ikanta ramanaa Jonás ijeekakira imotziki omani,"]},{"type":"verse","number":2,"content":["ikantzi:",{"text":"“íTajorentsi! Noñaakiro nokemaatsi-waetaka, nokowako-takimi. Pikaminthaakina eeroka.","poem":1},{"lineBreak":true},{"text":"Pikemakina nokaemi kaminkari-mashiki.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Pookawi-takina ocheenkaatzira inkaari,","poem":1},{"lineBreak":true},{"text":"Onoshika-nakina oshinchaari.","poem":1},{"lineBreak":true},{"text":"Aanakina omoetonkaari inthomoekinta.”","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ari nokantziri: “íTajorentsi! Pookawentakina.","poem":1},{"lineBreak":true},{"text":"Eero noñahaero pitajorentsi-pankote.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Othonkakina opamankakina nijaa,","poem":1},{"lineBreak":true},{"text":"Opeyakina ocheenkaatzira inkaari.","poem":1},{"lineBreak":true},{"text":"Tema othonkakina ankowiyinatakina jamantoshe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Notsiryaanaki inthomoeki nareeta-paentawo kepatsi.","poem":1},{"lineBreak":true},{"text":"Kimiwitaka ashi noyiromi nojeekemi jempe rashita-koeta-kinami.","poem":1},{"lineBreak":true},{"text":"Roo kanteencha Nowinkatharite Tajorentsi, eeroka owawijaa-kotaana nokamimi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nokanta nokamimataki, nokenkishiryaaneemi eeroka Tajorentsi.","poem":1},{"lineBreak":true},{"text":"Pikemakiro namanani pitajorentsi-pankoteki.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ikaatzi pinkatha-waetziriri roshiya-kaawo tajorentsi-niro,","poem":1},{"lineBreak":true},{"text":"Tee ikinatzimi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Rooma naaka, kamiñeenka nopaasoonkiteemi,","poem":1},{"lineBreak":true},{"text":"Notahaemiri natsipe-takaani nashita-kaemiri.","poem":1},{"lineBreak":true},{"text":"Aritaki nanteemiro nokantzimiri.","poem":1},{"lineBreak":true},{"text":"Tema apatziro pikanta-kaawo Pitajorentsitzi, powawijaa-kotantzi.”","poem":1}]},{"type":"verse","number":10,"content":["Ari ikanta-kahaari Tajorentsi irika omani, ikamaankaeri Jonás othapyaaki inkaari."]}],"footnotes":[]},"thisChapterLink":"/api/cpy_wbt/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}