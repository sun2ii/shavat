{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"MIC","translationId":"cpy_wbt","name":"MIQUEAS","commonName":"MIQUEAS","title":"MIQUEAS","order":33,"numberOfChapters":5,"sha256":"0ad0a70f21853534bc9879ff364ac5f8f0edc9c34069978c17049a6dde992ba6","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/MIC/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/cpy_wbt/MIC/5.json","totalNumberOfVerses":5},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"¡Rishinto owayiri-paeni! Pikijawentyaa rinkiteetakimira tantotsikira,","poem":1},{"lineBreak":true},{"text":"Tema rowayiri-teetatyee.","poem":1},{"lineBreak":true},{"text":"Antawoete rowajankiteeteri reewarite asheninka Israel-paeni,","poem":1},{"lineBreak":true},{"text":"Rompoja-waetan-tyaari pajamentotsi ipooki.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rooma eeroka, Owapankoni jeekatsiri Poshini-pathaniki,","poem":1},{"lineBreak":true},{"text":"Rawijakimi ishekiiyini pisheninka Judá-paeni.","poem":1},{"lineBreak":true},{"text":"Ari ipoñeeyaami pinkathari-wenteerini Israel-paeni.","poem":1},{"lineBreak":true},{"text":"Riitaki etakawori itzimaki paerani,","poem":1},{"lineBreak":true},{"text":"Itziman-tayitakari kañaaniri.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Eepichokiini rookawenta-paentziri rashiyitari,","poem":1},{"lineBreak":true},{"text":"Roojatzi paata otzimaa-nitan-takyaari tsinani ikowakahae-takiri itzime eentsite.","poem":1},{"lineBreak":true},{"text":"Riyoshiiteetani tsinani itzime eentsite.","poem":1},{"lineBreak":true},{"text":"Aripaete ipokayitee isheninka,","poem":1},{"lineBreak":true},{"text":"Itsipayi-teeyaari Israel-paeni.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ari retanakyaawori pinkathari raamaako-wentee-yaari isheninka-paeni,","poem":1},{"lineBreak":true},{"text":"Rootaki imatantee-yaari ishintsinka Tajorentsi.","poem":1},{"lineBreak":true},{"text":"Ari ikantzi-teetyaari ipinkatha-teetero iwaero Itajorentsite.","poem":1},{"lineBreak":true},{"text":"Aritaki ijeekawaetee kameetha,","poem":1},{"lineBreak":true},{"text":"Tema antawoete ipinkathee-teeri Tajorentsi,","poem":1},{"lineBreak":true},{"text":"Imaeteero maawoeni jempe-rika oweyaa-thapi-tapaa kepatsi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cpy_wbt/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/MAL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":4}