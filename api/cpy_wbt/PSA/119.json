{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"PSA","translationId":"cpy_wbt","name":"MAMPAANTSI","commonName":"MAMPAANTSI","title":"Mampaantsi","order":19,"numberOfChapters":150,"sha256":"f88efa6b234430a0a6c44cb18c2f75b9a0ea6cfde150d84d94777679be064ba9","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cpy_wbt/PSA/150.json","totalNumberOfVerses":105},"chapter":{"number":119,"content":[{"type":"verse","number":89,"content":[{"text":"Tajorentsi: Ari ashi owaatyeero piñaani jenokintaki.","poem":1}]},{"type":"verse","number":90,"content":[{"lineBreak":true},{"text":"Eeroka kyaaryoowenteerini maawoeni ikaatzi añaatsiri paerani, eejatzi ikaatzi añaatsiri nimaeka, eejatzi ikaatzi tzimaatsini paata.","poem":1},{"lineBreak":true},{"text":"Eeroka owetsikakirori kepatsi, rootaki opoñaantari otzimi.","poem":1}]},{"type":"verse","number":91,"content":[{"lineBreak":true},{"text":"Maawoeni okaatzi pinintakaantakiri, ari ashi owaatyeero otzimae.","poem":1},{"lineBreak":true},{"text":"Tema maawoeni okaatzira tzimatsiri oshiyawaetakawo riimi pomperatani.","poem":1}]},{"type":"verse","number":92,"content":[{"lineBreak":true},{"text":"Eeroka kimoshiretakaakinari piyotaakina.","poem":1},{"lineBreak":true},{"text":"Eeromi piyotaakinami, aritaki aakinami nowashirenkari.","poem":1}]},{"type":"verse","number":93,"content":[{"lineBreak":true},{"text":"Eero nopeyakoneenteero pikantakaantani,","poem":1},{"lineBreak":true},{"text":"Tema ari okanteeya pijeekakahaena kameethaeni.","poem":1}]},{"type":"verse","number":94,"content":[{"lineBreak":true},{"text":"Powawijaakotaana, tema pashitaanaha,","poem":1},{"lineBreak":true},{"text":"Nokemijantanakiro pikantakaantani.","poem":1}]},{"type":"verse","number":95,"content":[{"lineBreak":true},{"text":"Kijokero rowawitakina thaenkantzinkari ikoyi ithonkaatenami.","poem":1},{"lineBreak":true},{"text":"Roori kantzimaetacha eekiro niyaatakaatziiro nomonkaatziro pikantakaantani,","poem":1}]},{"type":"verse","number":96,"content":[{"lineBreak":true},{"text":"Noñaayitakiro thonkanitachari maawoeni oetarikapaeni,","poem":1},{"lineBreak":true},{"text":"Rooma pinintakaantani, ari ashi owaetaatyeero roori.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cpy_wbt/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":8}