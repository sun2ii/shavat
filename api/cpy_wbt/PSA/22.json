{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"PSA","translationId":"cpy_wbt","name":"MAMPAANTSI","commonName":"MAMPAANTSI","title":"Mampaantsi","order":19,"numberOfChapters":150,"sha256":"f88efa6b234430a0a6c44cb18c2f75b9a0ea6cfde150d84d94777679be064ba9","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cpy_wbt/PSA/150.json","totalNumberOfVerses":105},"chapter":{"number":22,"content":[{"type":"heading","content":["Mampaantsi"]},{"type":"hebrew_subtitle","content":["Romampaani David Ikenkishirya Ishiya-pithateri Kowatsiri Rowamayeri"]},{"type":"verse","number":1,"content":[{"text":"Tajorentsi! Notajorentsite! ¿Iita pookawentan-tanari?","poem":1},{"lineBreak":true},{"text":"¿Iita kaari pipokanta powawijaa-koteena?","poem":1},{"lineBreak":true},{"text":"¿Iita kaari pikemantana nashironkaa-waeta?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tajorentsi! Nokaema-witzimi kitejepaeteki, teemaeta pakana.","poem":1},{"lineBreak":true},{"text":"Nomawitakawo tsireni-paeteki, teemaeta netsinaryaa-kotzi,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Roo kanteencha, eeroka tajorentsi","poem":1},{"lineBreak":true},{"text":"Tema pijeeki eeroka jempe romampahaeyani Israel-paeni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Eeroka rawentaaka paerani nowaejatzite-paeni.","poem":1},{"lineBreak":true},{"text":"Rawentaa-yitakimi, pookakaa-wenta-yitakiri eeroka.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ikowako-takimi pikijawen-tyaari, pimatakiro pookakaa-wenta-yitakiri.","poem":1},{"lineBreak":true},{"text":"Rawentaa-yitakimi eeroka, tekatsi owashiwentaayiteerini.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tema naaka atziri naawita, roo kanteencha ikimita-kaeta-kina chowitsi.","poem":1},{"lineBreak":true},{"text":"Osheki imaninta-waetakina atziri-paeni, itheenka-shire-waetakina.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ishironta-wenta-waetakina ikaatzi ñaayitanari,","poem":1},{"lineBreak":true},{"text":"Itsimetsi-kyaawae-teetakina, roteka-yina-waeta, ikanteeyini:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“Piñaa-matsiteri awentaariri Tajorentsi. Añaawakiri aririka ramitako-teeri.","poem":1},{"lineBreak":true},{"text":"Tema ikantatzi osheki ineshironka-tziri, añaawakiri aririka rowawijaa-koteeri.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tema eeroka kantakaakawo notzimantakari omotzitakinaha ashitanari.","poem":1},{"lineBreak":true},{"text":"Eeroka kantakaakawo nawentaan-tzimiri eenirowa nothotzi noteni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Eeroka ashitakinari tekiraaha notzimi.","poem":1},{"lineBreak":true},{"text":"Eeniro nojeeki omotziki ashitanari, eeroka Notajorentsite.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Eero pijeeka-pithatana inteena, tema okaakitaki nokemaatsi-waetyaa.","poem":1},{"lineBreak":true},{"text":"Tekatsi kijakowente-nani.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tema ithonka rotzikakina kijaneentanari, roshiyakari ipiyoteeyani waakapaeni,","poem":1},{"lineBreak":true},{"text":"Roshiyakari imashirenka poñaachari Kithoki-shaariki, ithonka rinkitee-yakinani.","poem":1},{"noteId":0}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Pahaankaeyakini ikaatzi kijaneentanari,","poem":1},{"lineBreak":true},{"text":"Roshiyakari manitzi rowari iwathatsite, pirinkae-kimashitaki.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tema noshiyakawo naaka nijaa ijakoe-tziri,","poem":1},{"lineBreak":true},{"text":"Tema thonkaka okitho-ryaayitaki notonki.","poem":1},{"lineBreak":true},{"text":"Oshiyakawo najankane iwyaaha-chari,","poem":1},{"lineBreak":true},{"text":"tema thonkaka iwyaahaka inthomoeki.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tema piryaa-kentsitakina, oshiyakawo opiryaatzi chomo-petoki.","poem":1},{"lineBreak":true},{"text":"Tsirekaka nonene nopatzi-thaanteki.","poem":1},{"lineBreak":true},{"text":"Tema pookakina jempe opiryaa-panetzi kepatsi nokami.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Tema roshiyakari otsitzi ipiyowentee-yakinani kaari-perori, ithonka rinkita-paakina.","poem":1},{"lineBreak":true},{"text":"Iwena-waetakina nakoki eejatzi noetziki.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Iyoshii-tashitaka nomashi, koñaa-pookitaki notonki.","poem":1},{"lineBreak":true},{"text":"Osheki ramina-mintha-takina kijaneentanari.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ipawakaakawo nomaatha.","poem":1},{"lineBreak":true},{"text":"Iñaaryaa-wentakawo riyotan-tyaari itzimi-rika ayironi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"¡Rooma eeroka Tajorentsi, eero pookawentana!","poem":1},{"lineBreak":true},{"text":"Eeroka shintsi-takahaanari. Pipoki intsipaete pikijawentena.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"22.12 waakapeni = toro","reference":{"chapter":22,"verse":12}}]},"thisChapterLink":"/api/cpy_wbt/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":19}