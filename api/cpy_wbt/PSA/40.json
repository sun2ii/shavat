{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"PSA","translationId":"cpy_wbt","name":"MAMPAANTSI","commonName":"MAMPAANTSI","title":"Mampaantsi","order":19,"numberOfChapters":150,"sha256":"f88efa6b234430a0a6c44cb18c2f75b9a0ea6cfde150d84d94777679be064ba9","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cpy_wbt/PSA/150.json","totalNumberOfVerses":105},"chapter":{"number":40,"content":[{"type":"heading","content":["Rojankinatakiri David."]},{"type":"heading","content":["Rashi yotaantzirori omampahaantsi."]},{"type":"verse","number":1,"content":[{"text":"Amaanikiini noyeeri Tajorentsi.","poem":1},{"lineBreak":true},{"text":"Ari rowayempitataana, ari ikemaena nokaemirira.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Rowawijaakotaana nokamaemi ikitatanteetenarimi.","poem":1},{"lineBreak":true},{"text":"Rowawijaakotakina eejatzi oniyenami sampowatha.","poem":1},{"lineBreak":true},{"text":"Ikatziyakahaana okijopathatzira kepatsi.","poem":1},{"lineBreak":true},{"text":"Ramitakotaana nanashitantaari kameethari, tee nantziwawaeta.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Roma-mpaakahaanawo owakirari omampahaantsi.","poem":1},{"lineBreak":true},{"text":"Eejatzi weshiryaantsi, rootaki nokimoshirewentantariri Tajorentsi.","poem":1},{"lineBreak":true},{"text":"Osheki ñaayitawakirori iroka, riyokitziiwentayitakiro.","poem":1},{"lineBreak":true},{"text":"Roowa rawentaantanakariri Tajorentsi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kimoshireri ikanteeya awentahaeyaarini Tajorentsi.","poem":1},{"lineBreak":true},{"text":"Kaari aapatziyeeyaarini shamewaetatsiri,","poem":1},{"lineBreak":true},{"text":"Kaari amanariri tajorentsiniro.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Noyinkatharite! Tajorentsi, pitajonkawentantapiintee,","poem":1},{"lineBreak":true},{"text":"Osheki poshiretapiinteena,","poem":1},{"lineBreak":true},{"text":"Tekatsi oshiyeemini eeroka,","poem":1},{"lineBreak":true},{"text":"Noñaawenawitakawo nokamanteri itsipapaeni atziri okaatzi pitajonkawentantayitakira.","poem":1},{"lineBreak":true},{"text":"Roori kantzimaetacha oshekiperotanee jempe okaatzi kaari riyoteetzi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tee pikowamatsiteero ramayiiteemi ratsipetakaani, eejatzi rashitakahaetemiri.","poem":1},{"lineBreak":true},{"text":"Tema pikemathatakahaanawo,","poem":1},{"lineBreak":true},{"text":"Teera intaani onimotemi itayeetzimiri pirahaatsi, eejatzi ikaatzi ramayitzimiri rashitakaayitzimiri.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pikeme nokante naaka: Ari nopokaki.","poem":1},{"lineBreak":true},{"text":"Tema rojankinatakoyiitakina paerani.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ari onimotakina nanteemiro okaatzi pikowakayinari.","poem":1},{"lineBreak":true},{"text":"Oshiyaawo pojankinashiretantatyeenawomi pinintakaantani.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cpy_wbt/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":8}