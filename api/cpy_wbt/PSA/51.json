{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"PSA","translationId":"cpy_wbt","name":"MAMPAANTSI","commonName":"MAMPAANTSI","title":"Mampaantsi","order":19,"numberOfChapters":150,"sha256":"f88efa6b234430a0a6c44cb18c2f75b9a0ea6cfde150d84d94777679be064ba9","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cpy_wbt/PSA/150.json","totalNumberOfVerses":105},"chapter":{"number":51,"content":[{"type":"heading","content":["Mampaantsi"]},{"type":"hebrew_subtitle","content":["Rojankinari David, ikantanaka Kamantantaniri Natán ishintsineentanakiri, tema riyotakoetakirowa rantakiro kaariperori imayempitakiro Betsabé"]},{"type":"verse","number":1,"content":[{"text":"¡Tajorentsi! Eeroka neshironkatantaniri, pikaminthahaena.","poem":1},{"lineBreak":true},{"text":"Tema eerokataki etakotantaniri, pipeyakoteenawo okaatzi nantakiri.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pipakaa-kahaenawo okaatzi kariperotakaakinari.","poem":1},{"lineBreak":true},{"text":"Poetenteena nokaariperotakira.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Niyotzi osheki nopiyathawaetakimi.","poem":1},{"lineBreak":true},{"text":"Tee omata nomaejantero nokaariperotakira.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Apatziro nokaariperotzimotakimi eeroka.","poem":1},{"lineBreak":true},{"text":"Nantashitakawo okaatzi pipinkakaanari.","poem":1},{"lineBreak":true},{"text":"Tema okaate pikanteeri eeroka, kametha otampatzikate,","poem":1},{"lineBreak":true},{"text":"Eeroka kiteshireri pimatantawori pipiyakowentantzi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tema kaariperotakina naaka, ari nokantzita owakira notzimapaaki.","poem":1},{"lineBreak":true},{"text":"Nokaariperotzita inthomoeki omotziki ashitanari, jaka anteetzirowa kaariperoyitatsiri.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pineshironkatziri eeroka kameethashireri,","poem":1},{"lineBreak":true},{"text":"Piyo-shiryaakahaa-nawo piyotaninka.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pikimitakaena poetetantyeenawomi kaawoshirontsi, eero nopitsiwaetanta.","poem":1},{"lineBreak":true},{"text":"Pikaawoshiteena, aritaki nokitamaatanee kameetha, ari nawijanakiro okaatzi okitamaatzi jiriniki.","poem":1},{"noteId":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pikantakaeyaawo nokemanteeyaawori jempe ikimoshireteetzi, eejatzi jempe ithaamenteeta.","poem":1},{"lineBreak":true},{"text":"Piwiriintapookiteena powatsinaawaetakina.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Pomanapithatyaawo nowaariperonka eero piñaantaawo,","poem":1},{"lineBreak":true},{"text":"Posheteenawo maawoeni owaariperotakinari.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Tajorentsí! Poeteshireteena.","poem":1},{"lineBreak":true},{"text":"Powakirateenawo noshire, notampatzi-kashiretan-teeyaari.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Eero pookawentana,","poem":1},{"lineBreak":true},{"text":"Eero paapithatanawo Pitajorenka.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Papiiteero pinintaakahaena pikimitaakiro paerani owakira powawijaakotakina.","poem":1},{"lineBreak":true},{"text":"Potapi-shire-tantenawo roopirori Pitajorenka.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Rootaki niyotaanteeyaariri theenkimawaetzimiri okantakantziro tee ikemijanteemi eeroka,","poem":1},{"lineBreak":true},{"text":"Ipiyashitanteemiri eeroka kaariperoripaeni.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¡Apaa Tajorentsi, Owawijaakotantaniri! Pipeyakoteenawo okaatzi nompojantaki.","poem":1},{"lineBreak":true},{"text":"Ari nomampaawenteemi riyoetantyaari eeroka tampatzikashireri.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"¡Tajorentsi! Pithaamenta-cheratakaena.","poem":1},{"lineBreak":true},{"text":"Nopinkatha-waante-tanteemiro nomampaani.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tema te inimoteeme namashiwaetzimiri notayimiri natsipe-takaani.","poem":1},{"lineBreak":true},{"text":"Te pikowaeri okatziyeenkata iyachaarinka notaashiwaetzimiri.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tema rootaki pikowaperoteeri eeroka Tajorentsi piñiina okatsi-tzimo-shire-teena okaatzi nantzimotzimiri.","poem":1},{"lineBreak":true},{"text":"Tema ikaatzi ikemitakaanteetari riiperori ratsipetakaetani itahaetziniriri Tajorentsi, riitaki atziri okatsi-tzimo-shiretziri iyaariperonka.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Paakameethateeri Kijakowentoni-jatzi, pineshironkateeri.","poem":1},{"lineBreak":true},{"text":"Papiiteero pipiriinteero otantopaeni Apatziyaweni.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ari rinimoteemiri itahaetziri ratsipe-takaetani kameetha-pero-tatsiri,","poem":1},{"lineBreak":true},{"text":"Riitaki mapero-teeroni okatziyeenkate iyachaarinka itahaetemiri, maaroni ikaatzi rashitakaetzimiri itahaetziri.","poem":1},{"lineBreak":true},{"text":"Tema itahaeteemiri ipiraetari tahaerontsiki.","poem":1},{"noteId":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"51.7 kaawoshirontsi = hisopo","reference":{"chapter":51,"verse":7}},{"noteId":2,"caller":"+","text":"51.19 ipiraetari = becerro","reference":{"chapter":51,"verse":19}}]},"thisChapterLink":"/api/cpy_wbt/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}