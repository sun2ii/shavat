{"translation":{"id":"cpy_wbt","name":"Las Escrituras en Ashéninka Ucayali del Sur del Perú","website":"https://ebible.org/Scriptures/details.php?id=cpy","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cpy","licenseNotes":null,"shortName":"WBT","englishName":"South Ucayali Ashéninka Bible","language":"cpy","textDirection":"ltr","sha256":"bab04714c4e465857a3aa533edee6f91d6d132a83d31e15592f74cb142c16f1d","availableFormats":["json"],"listOfBooksApiLink":"/api/cpy_wbt/books.json","numberOfBooks":49,"totalNumberOfChapters":950,"totalNumberOfVerses":10643,"languageName":"South Ucayali Ashéninka","languageEnglishName":"South Ucayali Ashéninka"},"book":{"id":"PSA","translationId":"cpy_wbt","name":"MAMPAANTSI","commonName":"MAMPAANTSI","title":"Mampaantsi","order":19,"numberOfChapters":150,"sha256":"f88efa6b234430a0a6c44cb18c2f75b9a0ea6cfde150d84d94777679be064ba9","firstChapterNumber":1,"firstChapterApiLink":"/api/cpy_wbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cpy_wbt/PSA/150.json","totalNumberOfVerses":105},"chapter":{"number":89,"content":[{"type":"heading","content":["Mampaantsi"]},{"type":"hebrew_subtitle","content":["Rojankinee-takiro romampaa-wentee-tawo ikashiya-kaakiriri Tajorentsi pinkathari David"]},{"type":"verse","number":1,"content":[{"text":"Ashi nowaero nomampaeyaa, nomampaa-wenteero ineshironka-teena Tajorentsi.","poem":1},{"lineBreak":true},{"text":"Nomampaa-wenteeyaari, nokanteeri ikaate icharini-teeyaari: “Tee rookawentanta Tajorentsi.”","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nokantee eejatzi: “Ashi poyiro petakotanta.","poem":1},{"lineBreak":true},{"text":"Tee pipaashini-tanitzi, poshiyakawo inkite ashi oyiro jempe okanta roori.”","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ikantzi Tajorentsi: “Eenitatsi nokashiya-kaeriri ikaatzi niyoshii-teeri naaka.","poem":1},{"lineBreak":true},{"text":"Nokanta-pero-teeri nomperatanewo David, nokantziri:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"‘Eero nookawentaari ikaate picharini-teeyaari,","poem":1},{"lineBreak":true},{"text":"Naaka kantakae-yaawoni rashi rowaero ipinkathari-wentantee.’”","poem":1},"(Pishowi-teeyini, pipiyompi-teeyini eepichokiini.)",{"noteId":3}]},{"type":"verse","number":5,"content":[{"text":"Tajorentsi! Osheki ikimo-shire-wentakiro inkite-jatzi okaatzi pitajonka-wentantziri.","poem":1},{"lineBreak":true},{"text":"Osheki ikenkitha-takotakimi kiteshireriite ashi poyiro eeroka tee pookawentanta.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Eenitatsima inkite-jatzi monkaat-yaarini Tajorentsi?","poem":1},{"lineBreak":true},{"text":"¿Eenitatsima oshiyaarini Tajorentsi? Tema rawijiri riiperori jenoki-jatzi.’","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tema ipiyoteeyani kiteshireri-paeni ipinkatha-tziri Tajorentsi.","poem":1},{"lineBreak":true},{"text":"Maperori iriiperotzi rirori rawijanakiri ikaatzi piyowentariri.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tajorentsi Ñaaperori! ¿Eenitatsima oshiyimini eeroka?","poem":1},{"lineBreak":true},{"text":"Eeroka shintsi-perori. Ashi poyiro pikyaaryoo-wentantzi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Otzimimo-tzimi eeroka pishintsinka pomaeryaan-tawori otamakaatzi inkaari.","poem":1},{"lineBreak":true},{"text":"Pimatzitawo eejatzi oshinkiryaa-takaani tampyaa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Potsinampaakiri Ajahaariweni, poshiya-kaantakari kaminkari.","poem":1},{"lineBreak":true},{"text":"Tema eeroka shintsi-shempari, pomishiyakiri pikoshekani.","poem":1},{"noteId":4}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tema eeroka ashitawo maawoeni inkite eejatzi kepatsi.","poem":1},{"lineBreak":true},{"text":"Eeroka wetsikakiro kepatsi, eejatzi maawoeni tzimatsiri.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Eeroka wetsikakiro okaatzi tzimatsiri katonkonta eejatzi kirinkanta.","poem":1},{"lineBreak":true},{"text":"Oshiyawaetaka omampaa-tyeeyaami ochempi Piyopathee-toni eejatzi Pinkaetoni, opaeriiro piwaero.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tema eeroka shintsi-shempari, eejatzi okimitaka pako.","poem":1},{"lineBreak":true},{"text":"Tema osheki otsinampaantaki pakoperori.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Eeroka kameetha-shireri pipinkathari-wentantzi, eejatzi eeroka tampatsika-shireri.","poem":1},{"lineBreak":true},{"text":"Osheki petakotanta, oshiyakawo roomi jewata-piinteemini pikyaaryooperotani.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tajorentsi! Tema osheki ikimoshiretzi atziri thaamenta-chari romampaa-wentzimi,","poem":1},{"lineBreak":true},{"text":"Oshiyakawo ranashi-tatyeemi jempe pikoñeetyaakotziri eeroka.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ashi rowaero ikimo-shiretzi ipaeriiro piwaero.","poem":1},{"lineBreak":true},{"text":"Ari rajahaawenteemi, tema eeroka tampatzika-shireri.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mapero, jempe pikanta eeroka, ari okanta pishintsinka, eejatzi powaneenkawo.","poem":1},{"lineBreak":true},{"text":"Tema apatziro pikanta-kaawo eeroka, aririka pikoyi, pimatziro pishintsi-takaana.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ikimitawo Tajorentsi riimi otzikaako-mentotsi.","poem":1},{"lineBreak":true},{"text":"Riitaki Itajorentsite Israel, Awinkatharite.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Paerani pikenkitha-waeta-kaakiri piiteshirerite, ikemakimi ishireki.","poem":1},{"lineBreak":true},{"text":"Pikantziri: “Noneshironka-takiri ñaaperori.","poem":1},{"lineBreak":true},{"text":"Nopinkathari-takaakiri ikaatzi niyoyaakiri nashitari naaka.”","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Noñaakiri nomperatanewo David.","poem":1},{"lineBreak":true},{"text":"Nojee-patzii-totan-takari notajorenchaate.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Ashi noyiro notapi-wako-tantee-yaari nako.","poem":1},{"lineBreak":true},{"text":"Ari oshintsi-shempa-takahaeri noshempa.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Eero rotsinampaeri ikaatzi koshekariri.","poem":1},{"lineBreak":true},{"text":"Ari ikimitee-yaari kaari-perori, eero rotsinampaeri.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Naaka thonkirini ikaate owayirityaarini.","poem":1},{"lineBreak":true},{"text":"Nothonkaeri ikaate kijaneenterini.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tema kijokiro nokanteeri noneshironka-teeri,","poem":1},{"lineBreak":true},{"text":"Okantakaawo ipaeryaa-piinteero nowaero otzimimo-tantee-yaariri ishintsinka.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ari nokanta-kaakyaawo ipinkathari-wentantee ijeeki inkaariki.","poem":1},{"lineBreak":true},{"text":"Imatero eejatzi ipinkatharite ijeeki nijaaki-paeni.","poem":1},{"noteId":5}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ari ikantee-teena: “Tajorentsi! Eeroka ashitanari,","poem":1},{"lineBreak":true},{"text":"Eeroka Notajorentsite, poshiyawo mapi nomana-mento omatantari nawijakotee.”","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nokimita-kaanteeri naaka nantarite notyomi.","poem":1},{"lineBreak":true},{"text":"Riitaki awijirini ikaate pinkatha-wenteeroni kepatsi.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Rashi royiro noneshironka-teeri rirori.","poem":1},{"lineBreak":true},{"text":"Eero aminaashita okaatzi nokashiya-kaakiriri.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Tema rashi rowaero ipinkathari-yitee ikaate icharini-teeyaari.","poem":1},{"lineBreak":true},{"text":"Ari ikantee-tatyeero eeniro iñeetziri ooryaa jenokinta.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Aririka ipakaakiro itomi noñaani,","poem":1},{"lineBreak":true},{"text":"Eerorika riyaata-kaero ithotyahero okaatzi niyotaa-kiriri,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Aririka ipiyatha-takyaawo nowinka-kaantani,","poem":1},{"lineBreak":true},{"text":"Eerorika ikemijantziro nokanta-kaantani,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ari nowajankitaakiri ipiyatha-takina,","poem":1},{"lineBreak":true},{"text":"Nopajawenteeri ikaariperotakira.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Eero nopakaemaetawo netakotee-yaari.","poem":1},{"lineBreak":true},{"text":"Noejokiro-peroteeyaari, ashi noyiro notsipa-tyaari.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Eero nomaejantziro okaatzi nokashiya-kaakiriri.","poem":1},{"lineBreak":true},{"text":"Eero nomaeritzi nokanteri okaatzi nokaman-takiriri.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Tema Naaka Tajorentsi kashiya-kaakiriri,","poem":1},{"lineBreak":true},{"text":"Eero namatawi-tziri David, okaatzi nokantakiriri:","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"“Ashi royiro picharini ipinkatharitee pinampiki,","poem":1},{"lineBreak":true},{"text":"Ari ikantee-tatyeero ipinkatharitee eenirowa iñeetziri ooryaa eejatzi kashiri.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Ari ikantee-taatyeeya ijeeki, roshiyaari kashiri,","poem":1},{"lineBreak":true},{"text":"Ashi rowaero ijeekae inkiteki.","poem":1},"(Pishowi-teeyini, pipiyompi-teeyini eepichokiini.)"]}],"footnotes":[{"noteId":3,"caller":"+","text":"89.4 Pishowi-teeyini, pipiyompi-teeyini eepichokiini = Selah","reference":{"chapter":89,"verse":4}},{"noteId":4,"caller":"+","text":"89.10 Ajahaariweni = Rahab = Egipto","reference":{"chapter":89,"verse":10}},{"noteId":5,"caller":"+","text":"89.25 Kantako-tachari jaka, riitaki Tajorentsi kantakae-yaarini pinkathari David ipinkatharite ipoñaakyaawo Antawoki Inkaari, riijatzi pinkathari-tatsini poñaachani antawaaki eniki.","reference":{"chapter":89,"verse":25}}]},"thisChapterLink":"/api/cpy_wbt/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cpy_wbt/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cpy_wbt/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":37}