{"translation":{"id":"crx_wbt","name":"Yak'usda Ooghuni","website":"https://ebible.org/Scriptures/details.php?id=crxNTpo","licenseUrl":"https://ebible.org/Scriptures/details.php?id=crxNTpo","licenseNotes":null,"shortName":"WBT","englishName":"Carrier NT","language":"crx","textDirection":"ltr","sha256":"bd91456c245a4e363019db157b6b3122d3616bfd819301f984f4ee585940ee00","availableFormats":["json"],"listOfBooksApiLink":"/api/crx_wbt/books.json","numberOfBooks":28,"totalNumberOfChapters":310,"totalNumberOfVerses":9480,"languageName":"Carrier","languageEnglishName":"Carrier"},"book":{"id":"GEN","translationId":"crx_wbt","name":"Soo 'Udechoo Whe'whudit'en-i","commonName":"Soo 'Udechoo Whe'whudit'en-i","title":"Soo 'Udechoo Whe'whudit'en-i","order":1,"numberOfChapters":50,"sha256":"23fae04b2deab7f9965902c98ba4499b02668990ddf6197f4fd6c795342c71fa","firstChapterNumber":1,"firstChapterApiLink":"/api/crx_wbt/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/crx_wbt/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["Jacob ooye'ke bubulh dawhutanelh budani'"]},{"type":"verse","number":1,"content":["'Ink'ez Jacob duye'ke buka'dani 'ink'ez 'utni, “'Ilhoozahdilh 'et de sih nohbulh dawhutanelh la 'udek'ez dzin nohudutasnelh."]},{"type":"verse","number":2,"content":[{"text":"'Ilhozahdilh 'ink'ez oozulhts'ai Jacob ooye'ke","poem":1},{"text":"'ink'ez nohbá Israel oozulhts'ai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Reuben nyun 'udetso sye' whuzdli-un inli.","poem":1},{"text":"Ndai la be ustus-i 'ink'ez 'udechoo be ustus suli'-i,","poem":2},{"lineBreak":true},{"text":"ndai la ilhoh tune' zust'en-un 'ink'ez dalcho-i be be ustus-i cha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Too nudutunne oot'aniuznootan ait'oh.","poem":1},{"text":"'Aw hoonzoo lhotuzan'el mbá oolili k'ut 'et inte'","poem":2},{"lineBreak":true},{"text":"'ink'ez whudutsun whuzilhtsi.","poem":2},{"lineBreak":true},{"text":"Ndai la ook'oste'-i 'i ookw'ut inte' 'et huwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Simeon 'ink'ez Levi bulh lhulhutsinke hudli.","poem":1},{"text":"Be dzoh ne'udzut-i bubulh 'unt'oh,","poem":2},{"lineBreak":true},{"text":"ndet la huwhut'i-un.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"'Aw szul buzih neooya' junih.","poem":1},{"text":"Be dasti'-i, ndet la huwhut'i-un bubulh 'uyot'e' junih.","poem":2},{"lineBreak":true},{"text":"Huhunilch'e whe dune huzilhghi 'et huwa,","poem":2},{"lineBreak":true},{"text":"'ink'ez k'une' hut'en whe musdoos dune kechun dugha hininguz.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bube huske-i ookw'ehoodeh,","poem":1},{"text":"tube be oonujut 'et huwa.","poem":2},{"lineBreak":true},{"text":"Huye huske-i tube ookw'ehunduda.","poem":2},{"lineBreak":true},{"text":"Jacob 'et lhk'e butistelh 'ink'ez Israel 'et lhelhdun nebutastelh.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Judah nyun 'utant'elh,","poem":1},{"text":"nyulhutsinke nyuhudutalhti'.","poem":2},{"lineBreak":true},{"text":"Nla 'i mbene la nch'az ditnine buk'udutalni,","poem":2},{"lineBreak":true},{"text":"mbá buzkeh 'enne mbut yo 'uhuntitsulh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Judah 'i khuna-iti lion huyulhni,","poem":1},{"text":"'i ooyaz 'unt'oh.","poem":2},{"text":"Ndai la inghan-i sye',","poem":1},{"text":"'i bulh ndo 'inja.","poem":2},{"lineBreak":true},{"text":"Yo untut'aih 'ink'ez khuna-iti lion huyulhni,","poem":2},{"lineBreak":true},{"text":"'i k'un'a usti 'ink'ez khuna-iti lion unli de,","poem":2},{"lineBreak":true},{"text":"mbe suba hinolhch'eh?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndai la lerwene tuz nuhidutun-i,","poem":1},{"text":"'i Judah yuyit lhe'tist'el.","poem":2},{"text":"'Ink'ez keyoh huwuni ook'une' whut'en-i, 'i 'aw ooke eguz whuch'a naoodzit ait'oh,","poem":1},{"text":"Shiloh whusainya 'et whuts'un.","poem":2},{"text":"'Ink'ez dunene 'en buk'oh ts'e hik'une' oot'en ha.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Oodonkey 'i nyoo duchun nudunulhye 'idutaguz,","poem":1},{"text":"'ink'ez donkey ooyaz 'i duchun nudunulhye 'i soo 'uk'enus unzoo yuzih neitalhtelh.","poem":2},{"text":"Dunaih 'i ts'ekoo too' be tunayuzguz,","poem":1},{"text":"'ink'ez dunaih 'i mai ts'ekoo too' huyilh-i,","poem":2},{"lineBreak":true},{"text":"i ootoo' 'i be tunayuzguz.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Oona 'i ts'ekoo too' anus dunulhgus,","poem":1},{"text":"'ink'ez ooghoo lilet anus 'ulhyul","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Zebulun 'en yatooba hoonzoo-un 'et whutit'elh.","poem":1},{"text":"Ndai la ts'i yanakuk-i,","poem":2},{"lineBreak":true},{"text":"'i ba, 'ink'ez keyoh Sidon 'et whuzih whutit'elh.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Issachar 'en donkey ulhtus-i 'unt'oh.","poem":1},{"text":"Ndai ndaz-i yeguz nanki, 'i 'et tit'elh.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nats'ulyiz-un hoonzoo-un 'et hon'en","poem":1},{"text":"'ink'ez yun k'ut hoonzoo 'utighelh wheni yo 'utinelh.","poem":2},{"lineBreak":true},{"text":"'Ink'ez 'ulhna didohne huzdli'.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dan 'en dudune'ne buba nahutiyeh.","poem":1},{"text":"Israel 'ilhoh didohne oots'u haindene 'enne 'uhint'oh.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dan 'en ti whuzih tl'ughus, viper, tileh.","poem":1},{"text":"Tl'ughus 'oolch'oolh-i ti whuzih,","poem":2},{"lineBreak":true},{"text":"'ink'ez yeztl'i k'ents'ul cha oolhch'oolh.","poem":2},{"text":"'Ink'ez mbe la yuk'usda-un 'en k'oh un'a yuk'udutildus.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"O Moodihti (Yahweh) ndet la whesutalhyih-un hubas'e'!","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gad 'en lhuganne didohne 'enne hik'ut nutidulh,","poem":1},{"text":"'et hoonts'i 'udek'oh 'et whuch'a' tilhdoh.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Asher ut'alh-i oots'u hayults'uk-i,","poem":1},{"text":"'i tube dutati', 'ink'ez nzoo-i oots'u hatikulh.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Naphtali 'en yezts'e oolazditni-i le'unt'oh,","poem":1},{"text":"khuni nzoo-i za huwa'aih.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Joseph 'en duchun zooschum cho oots'a ha'ukat-i unli.","poem":1},{"text":"Too k'et whuzih 'et oots'a hakat-i 'uzooschum unli.","poem":2},{"lineBreak":true},{"text":"'Ink'ez be 'uzoozchum nyo sih hukw'ut ndulcho whe hoonli.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mbene la k'aza be lhuganne tube hidzi undalhda'.","poem":1},{"text":"Nuhinulhtso 'ink'ez huts'uditni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"'Et hoonts'i ook'aza ulhtus-un 'et za 'unt'oh inle'.","poem":1},{"text":"'Ink'ez oogan 'i cha 'onus oonut'i lhtus suli'.","poem":2},{"text":"Jacob ooYak'usda (Elohim) be oonujut-un ulhtus-un,","poem":1},{"text":"oola 'i be 'unt'oh ('en 'Usbai Ghunli-un unli, Israel Whutse' 'unt'oh).","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mbá ooYak'usda (El)","poem":1},{"noteId":10},{"text":", 'en nla'utinelh.","poem":1},{"text":"'Ink'ez 'Uk'enus 'Ultus-un (EL Shaddai),","poem":2},{"lineBreak":true},{"text":"'en soo hoonzoo-i za ntl'aookat.","poem":2},{"text":"Yak'uz ts'e hakat-i, 'i be mba soo hoonzoo-i ntl'aookat.","poem":1},{"text":"Yatoo t'ah ts'e hoonli 'i be cha mba soo hoonzoo-i whutaleh.","poem":2},{"text":"Ts'ekoo buts'oo' ts'oodunne huye 'ulhtuk-i be","poem":1},{"text":"'ink'ez ts'ekoo buchan cha mba soo hoonzoo-i ntl'aookat whutaleh.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mbá soo hoonzoo-i nohtl'aookat,","poem":1},{"text":"'i stsoda'ne 'onus soo hoonzoo-i za butl'ayilts'ut,","poem":2},{"lineBreak":true},{"text":"whanus unzoo suli'.","poem":2},{"text":"Ndo yak'uz 'ilhiz wheni nodist'ai-un soo 'uk'enus nilhdza'-un 'et whuts'un,","poem":1},{"text":"'i Joseph ootsi k'ut 'utit'elh 'ink'ez ootsit'ah hukw'ut,","poem":2},{"lineBreak":true},{"text":"'i bulhutsinke anus 'utit'elh.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Benjamin 'en yus tube ooye'ilts'ul-i unli,","poem":1},{"text":"bundada' 'et si yuzilhghi-i yoo'alh,","poem":2},{"lineBreak":true},{"text":"'ink'ez 'ulhdzis 'et ndai la yughan-i,","poem":2},{"lineBreak":true},{"text":"oogha yunkat-i lhk'eyulih.","poem":2}]},{"type":"verse","number":28,"content":["Ndunne 'enne ts'iyawh Israel ts'u haindene whunizyane 'on 'at nane didohne, 'et ndi khuni 'i be buba hubulh yailhduk 'ink'ez soo hoonzoo-i buts'un tizoo', lhoghun hinli whe nts'en'a la didutch'oh soo hoonzoo-i be ubulh yalhduk."]},{"type":"heading","content":["Jacob dazsai 'ink'ez 'ahuyalhti"]},{"type":"verse","number":29,"content":["'Et 'ink'ez 'ubulhni, “'Awet sulh dune'ne, ubulh 'ist'e'ne 'enne 'awet buts'un tisyalh. Ndet la tse'an Ephron yun k'ut 'i Hitt whut'en-un 'unt'oh, 'en ootse'an 'et sbákene bubulh 'asoolhtelh,"]},{"type":"verse","number":30,"content":["tse'an 'et Machpelah yun k'ut 'et 'uhoont'oh, Mamre whutso Canaan yun k'ut 'i Abraham, Ephron, Hitt whut'en-un unli-un, 'en ooyun, ts'unk'ut wheni 'et honket."]},{"type":"verse","number":31,"content":["'Et Abraham 'ink'ez Sarah oo'at bulh cha 'abuhalhti, 'et Isaac 'ink'ez oo'at Rebekah bulh cha 'abuhalhti, 'ink'ez si cha 'et Leah 'asti."]},{"type":"verse","number":32,"content":["Ndai la yun 'ink'ez tse'an ook'uwhuz'ai-i, 'i Heth ooye'kene ts'un huyonket.”"]},{"type":"verse","number":33,"content":["'Ink'ez Jacob 'awet buzkeh hubulh yalhduk-un 'etsul 'udija whe, lili k'enadil'ez 'ink'ez 'udek'ez hanajiz. 'Ink'ez whutsoda' oonatneke bubulh 'unt'ohne 'enne buts'un whenya."]}],"footnotes":[{"noteId":10,"caller":"*","text":"Ndi boozi' El, 'i “Yak'usda 'En Ts'iyai‑i Anus Ulhtus‑un 'Unt'oh,” ni whe 'utni. Sizi Gri 'en cha ts'iyai‑i anus ulhtus‑un 'unt'oh. Whuz un'a Sizi Gri dant'oh unli. 'Et John Ooba Ts'et Hahónkat‑un 1:8 whe neMoodihti Sizi Gri njan ndutni, “Si 'ust'oh Alpha 'ink'ez Omega usli. 'Udechoo whe'whudit'en‑un 'ink'ez 'etsul 'uwhutánelh‑un, 'en 'ust'oh. Mbe usli 'ink'ez 'ist'e‑un, 'ink'ez whusatíyalh‑un 'ust'oh, 'ink'ez ts'iyai‑i anus ulhtus‑un, 'en 'ust'oh.” 'Et Matthew Uk'unéyuzguz 3:11, John Ooba Ts'et Hahónkat‑un 4:8, 11:17, 'ink'ez 16:5‑7 'et cha nduwhútni.","reference":{"chapter":49,"verse":25}}]},"thisChapterLink":"/api/crx_wbt/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/crx_wbt/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/crx_wbt/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}