{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"JOB","translationId":"cth_bcf","name":"JOB","commonName":"JOB","title":"JOB (The Book of Job)","order":18,"numberOfChapters":42,"sha256":"e464d8878fe2cb35f026d5c6b01e7a20865a8af2b8438636a388ec45fd1c5560","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/cth_bcf/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["Bildad lawk"]},{"type":"verse","number":1,"content":["Hahoi Shuhi tami Bildad ni a pathung teh,"]},{"type":"verse","number":2,"content":[{"text":"Uknae hoi takinae teh amae naw doeh.","poem":1},{"text":"Hmuenrasang dawkvah roumnae naw a sak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"A ransanaw hah apinimaw a touk thai han.","poem":1},{"text":"Apie lathueng maw na angnae hah tâcawt laipalah ao boi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bangtelamaw Cathut e hmalah tami a lan thai han.","poem":1},{"text":"Hoeh pawiteh, bangtelamaw napui ni khe e hah a thoung thai han.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Thapa patenghai ang laipalah, âsinaw hai amae mithmu vah","poem":1},{"text":"thoung awh hoeh pawiteh,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pâri hoi tangraet rumram lah kaawm e taminaw natawng teh","poem":1},{"text":"bangtelamaw hoe thoung thai han vaw, telah ati.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}