{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"heading","content":["Tami kathout hoi tamikalannaw e lamthung"]},{"type":"hebrew_subtitle","content":["Kasakkung: Panuekhoeh"]},{"type":"verse","number":1,"content":[{"text":"Tamikathoutnaw e khokhangnae koe ka cet hoeh e tami,","poem":1},{"text":"tamikayonnaw e lamthung dawk kangdout hoeh e tami,","poem":2},{"lineBreak":true},{"text":"kadudamnaw e kamkhuengnae koe hai ka tahung hoeh e tami,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"BAWIPA e lawk ka ngâi niteh,","poem":1},{"text":"a kâlawknaw hah karum khodai luepluep ka pouk e tami teh a yawhawi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ahni teh tui teng vah ung e,","poem":1},{"text":"a tue a pha torei ka paw niteh,","poem":2},{"lineBreak":true},{"text":"a hna hai kamyai hoeh e thingkung hoi a kâvan.","poem":2},{"lineBreak":true},{"text":"A tawksak e naw dawk hawinae a hmu han.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tamikathoutnaw teh, hottelah laipalah,","poem":1},{"text":"kahlî ni a palek e cahik hoi a kâvan awh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hatdawkvah, tamikathoutnaw teh, lawkcengnae hnin navah kangdout thai awh mahoeh.","poem":1},{"text":"Tamikayonnaw hai tami kalannaw e kamkhuengnae dawk bawk thai mahoeh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bangkongtetpawiteh, BAWIPA ni tami kalannaw e lamthung teh a panue.","poem":1},{"text":"Tamikathoutnaw e lamthung teh rawknae koe a pha han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}