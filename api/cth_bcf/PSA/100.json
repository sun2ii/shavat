oe awh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bangkongtetpawiteh, BAWIPA teh ahawi,","poem":1},{"text":"a pahrenlungmanae teh a yungyoe a kangning,","poem":2},{"lineBreak":true},{"text":"yuemkamcunae teh a yungyoe a cak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}