{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"heading","content":["BAWIPA koe yuemkamcu lawkkamnae"]},{"type":"hebrew_subtitle","content":["Kasakkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"Lungmanae hoi kângingnae la ka sak han.","poem":1},{"text":"BAWIPA nang koe pholennae la ka sak han.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ka kuep e lamthung dawk lungang lahoi ka hring han.","poem":1},{"text":"Oe, nâtuek ne kai koe na tho han vai.","poem":2},{"lineBreak":true},{"text":"Ka imthungkhu dawk ka thoung e lungthin hoi ka o han.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ka mithmu vah hawihoehnae banghai ka tat mahoeh.","poem":1},{"text":"Katâlawnaw ni tawksaknae hah ka hmuhma teh,","poem":2},{"lineBreak":true},{"text":"kai dawk kâbet mahoeh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lungthin longkawinae ni na ceitakhai vaiteh,","poem":1},{"text":"hawihoehnae hah ka panuek mahoeh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Arulahoi a imri ka pathoe e pueng ka raphoe vaiteh,","poem":1},{"text":"a minhmai kâoup niteh,","poem":2},{"lineBreak":true},{"text":"a lungpouk ka rasang e naw hah ka panguep mahoeh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yuemkamcu e khocanaw teh kai koe ao awh nahanelah, ka khetyawt han.","poem":1},{"text":"Ka kuep e lamthung ka dawn e ni kaie thaw a tawk awh han.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tami ka dumyen e teh, ka im dawk awm mahoeh.","poem":1},{"text":"Laithoe kadeinaw teh, ka hmalah pou awm awh mahoeh.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hawihoehnae ka sak e naw hah","poem":1},{"text":"BAWIPA e khopui dawk hoi raphoe nahanlah,","poem":2},{"lineBreak":true},{"text":"tamikathoutnaw pueng teh palang a raphoe han toe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}