{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["BAWIPA lannae dawk kâuepnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA dawk ka kâuep.","poem":1},{"text":"Bangkongtetpawiteh, ka hringnae koevah,","poem":2},{"lineBreak":true},{"text":"na monsom vah tavaca patetlah kamleng telah na dei thai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bangtelah tetpawiteh, na khenhaw!","poem":1},{"text":"Tamikathoutnaw ni licung a sawn awh teh,","poem":2},{"lineBreak":true},{"text":"lungthin kalannaw arulahoi ka hanelah, lirui dawk pala coungkacoe a mawp awh toe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Adunaw hah raphoe lah awm pawiteh,","poem":1},{"text":"tamikalan ni bangmouh a sak thai han.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"BAWIPA teh kathounge Bawkim dawk ao teh,","poem":1},{"text":"BAWIPA bawitungkhung teh kalvan vah ao.","poem":2},{"lineBreak":true},{"text":"A mit hoi a khet teh, tami capanaw teh a mitlakhuem hoi a tanouk.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"BAWIPA ni tamikalan hah ouk a tanouk.","poem":1},{"text":"Hatei, tamikathout hoi thama lah kalawmnaw teh,","poem":2},{"lineBreak":true},{"text":"a hringnae hoi a hmuhma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tamikathoutnaw koe hmaisaan hmaito a rak sak vaiteh,","poem":1},{"text":"hmai hoi gan hoi hmaikahlî teh a coe awh hane manang lah ao han.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bangkongtetpawiteh, BAWIPA teh a lan.","poem":1},{"text":"Lannae hah lung a pataw teh, tamikalan teh a khet.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}