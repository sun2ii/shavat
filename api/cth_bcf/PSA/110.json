{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"heading","content":["Messiah uknae kong pathangnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA ni ka Bawipa koevah,","poem":1},{"text":"na taran hah na khoktoungnae lah ka sak hoehroukrak,","poem":2},{"lineBreak":true},{"text":"kaie kut arang lah tahung atipouh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"BAWIPA ni, na thaonae tahroe teh,","poem":1},{"text":"Zion hoi ka patoun han.","poem":2},{"lineBreak":true},{"text":"Na tarannaw lungui uk haw.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na taran na tuk hnin vah,","poem":1},{"text":"na taminaw teh amamouh lungthocalah hoi na thosin awh han.","poem":2},{"lineBreak":true},{"text":"Na thoundounnaw teh amom e tadamtui patetlah,","poem":2},{"lineBreak":true},{"text":"nang koe monkathoung dawkvah, a tâco awh han.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"BAWIPA ni nang teh, Melkhizedek patetlah","poem":1},{"text":"a yungyoe vaihma bawi telah thoe na bo toung dawkvah,","poem":2},{"lineBreak":true},{"text":"nâtuek hai bout kâhno mahoeh toe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"BAWIPA teh nange aranglah ao teh,","poem":1},{"text":"a lungkhueknae hnin dawk siangpahrangnaw koung na thei han.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Miphunnaw hah lawk koung ceng vaiteh,","poem":1},{"text":"hmuen pueng koe tami ro hoi akawi han.","poem":2},{"lineBreak":true},{"text":"Ram moikapap kahrawikungnaw hah koung a thei han.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lam teng e sawkcanaw a nei awh vaiteh,","poem":1},{"text":"lû hah a tawm awh han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}