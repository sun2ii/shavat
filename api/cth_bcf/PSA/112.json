{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"heading","content":["Kalan e ram yawhawinae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Panuekhoeh"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA teh pholen awh.","poem":1},{"text":"BAWIPA ka taketnaw hoi kâpoelawknaw","poem":2},{"lineBreak":true},{"text":"a lung kahawikhai katang e teh a yaw kahawi e doeh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"A catounnaw ni talai van a thao awh vaiteh,","poem":1},{"text":"tami kalannaw e catounnaw teh a yawhawi awh han.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"A im vah hnopai a tawnta awh vaiteh,","poem":1},{"text":"a lannae teh a yungyoe a kangning han.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tami kalan hanelah teh hmonae koehoi angnae a tâco teh,","poem":1},{"text":"ama teh pahrennae lungmanae, lannae hoi ka kawi e lah ao.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tami kahawi niteh, pahrennae lahoi a cawi sak teh,","poem":1},{"text":"ama teh ka lan lah kho a sak han.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Khoeroe kâhuen mahoeh.","poem":1},{"text":"Tami kalan teh panue e lah pou ao han.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kamthang kahawihoehe ni taket sak mahoeh.","poem":1},{"text":"BAWIPA a kâuep teh a lungthin a cak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"A lungthin caksak lah ao dawkvah,","poem":1},{"text":"a tarannaw koe a ngai e a pha totouh, taket mahoeh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lungthocalah hoi a rei teh,","poem":1},{"text":"karoedengnaw hah a poe toe.","poem":2},{"lineBreak":true},{"text":"A lannae teh a yungyoe a kangning.","poem":2},{"lineBreak":true},{"text":"A ki teh barinae lahoi tawm lah ao han.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tamikathoutnaw ni hmawt awh vaiteh,","poem":1},{"text":"a lungkhuek awh han.","poem":2},{"lineBreak":true},{"text":"A hâkam kata awh vaiteh, koung atum pouh han.","poem":2},{"lineBreak":true},{"text":"Tamikathoutnaw e ngainae teh koung a kahma pouh han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}