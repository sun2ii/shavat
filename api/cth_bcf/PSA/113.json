{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"heading","content":["Cathut dawk hringnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Panuekhoeh"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA teh pholen awh.","poem":1},{"text":"Oe BAWIPA e sannaw, pholen awh.","poem":2},{"lineBreak":true},{"text":"BAWIPA min teh pholen awh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"BAWIPA min teh atuhoi a yungyoe ditouh","poem":1},{"text":"pholen lah awm lawiseh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kanîtho koehoi kanîloum totouh,","poem":1},{"text":"BAWIPA min teh pholen lah awm lawiseh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"BAWIPA teh miphun pueng e lathueng vah ao teh,","poem":1},{"text":"a bawilennae teh kalvan hlak a rasang.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A rasang hmuen koe ao eiteh,","poem":1},{"text":"BAWIPA Cathut patetlah apimouh kaawm .","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kalvan e hno hoi talai hnonaw ka khen e","poem":1},{"text":"BAWIPA patetlah apimaw kaawm.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mathoenaw hah vaiphu koehoi ka pathaw niteh,","poem":1},{"text":"kavoutthoupnaw hah vaipuen koehoi a tawm teh,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"bawinaw hai thoseh, a taminaw hoi","poem":1},{"text":"cungtalah ao thai awh nahanelah thoseh hmuen a poe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Cakaroe e napui o nahan im a poe teh,","poem":1},{"text":"camo ka tawn e napui patetlah a konawm.","poem":2},{"lineBreak":true},{"text":"Hallelujah.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}