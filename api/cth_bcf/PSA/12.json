{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"heading","content":["Cathut yuemkamcu lah onae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA na kabawm haw.","poem":1},{"text":"Bangkongtetpawiteh, cathutlae tami awm hoeh toe.","poem":2},{"lineBreak":true},{"text":"Tami capanaw dawk yuemkamcu e awm hoeh toe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"A imrinaw hoi laithoe lawk a kâdei awh teh,","poem":1},{"text":"lungsamphei laihoi lawk a dei awh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"BAWIPA ni pasawtpanepnae pahni hoi,","poem":1},{"text":"kâoupnae lai hah tâtueng naseh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ahnimouh ni, ka lai hoi ka tâ han.","poem":1},{"text":"Ka pahni hai kama e doeh.","poem":2},{"lineBreak":true},{"text":"Apimouh kaimouh lathueng ka bawi han telah ati awh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"BAWIPA ni, repcoungroe e tami ka roedeng e hoi,","poem":1},{"text":"voutthoup laihoi kacingounaw hanlah,","poem":2},{"lineBreak":true},{"text":"atu ka thaw vaiteh, a ngaihawi awh e roumnae hmuen koe","poem":2},{"lineBreak":true},{"text":"ka o sak han telah ati.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"BAWIPA e lawknaw teh, ka thoung e lawk doeh.","poem":1},{"text":"Talai hoi thoung sak nahanelah,","poem":2},{"lineBreak":true},{"text":"hmai dawk vai sari touh sôlêi tangcoung e ngun patetlah ao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oe BAWIPA, nang ni na khetyawt.","poem":1},{"text":"Hete senaw thung dawk hoi a yungyoe na roum sak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tami capanaw ni tamikapo a tawmrasang awh toteh,","poem":1},{"text":"tamikathoutnaw teh hmuen tangkuem a kâva awh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}