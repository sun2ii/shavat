{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["Kathutkung: Panuekhoeh, tami tangawn ni Hezekiah a ti awh"]},{"type":"verse","number":1,"content":[{"text":"Kai teh runae kâhmo navah,","poem":1},{"text":"BAWIPA ka kaw teh Bawipa ni na pato.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oe BAWIPA, ka muitha hah laithoe e pahni dawk hoi thoseh,","poem":1},{"text":"dumyennae lai dawk hoi thoseh, na rungngang haw.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oe dumyennae lai, Bawipa ni nang hah","poem":1},{"text":"bangtelah vaimoe na ti han vai,","poem":2},{"lineBreak":true},{"text":"nang hah bang hoi vaimoe runae na poe han vai tet pawiteh,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"athakaawmnaw e kahran e pala hoi","poem":1},{"text":"kongkang hmaisaan hoi doeh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kai teh, Meshek ram vah, kahlawng ka cei teh","poem":1},{"text":"Kedarnaw e rim dawk ka o dawkvah,","poem":2},{"lineBreak":true},{"text":"yawthoe lah a o","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ka muitha teh roumnae ka hmuhma e naw hoi","poem":1},{"text":"rei ao e hroung asaw toe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kai teh roumnae ka ngai.","poem":1},{"text":"Hatei, ka dei navah,","poem":2},{"lineBreak":true},{"text":"ahnimouh teh tarantuk hane doeh a ngai awh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}