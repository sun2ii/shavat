{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"heading","content":["Kabawpnae teh BAWIPA koehoi a tho"]},{"type":"hebrew_subtitle","content":["Kathutkung: Panuekhoeh, tami tangawn ni Hezekiah a ti awh"]},{"type":"verse","number":1,"content":[{"text":"Kabawpnae teh nâhoi maw a tho han ka titeh,","poem":1},{"text":"monnaw koelah ka khet.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kalvan hoi talai kasakkung","poem":1},{"text":"BAWIPA koehoi doeh a tho.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bawipa ni na khok tâlaw sak hoeh.","poem":1},{"text":"Nang khenyawnkung teh ngâm boihoeh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Atangcalah Isarelnaw khenyawnkung","poem":1},{"text":"Ahni teh ngâm boihoeh, ip hai ip boihoeh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"BAWIPA ni nang teh, na khetyawt.","poem":1},{"text":"BAWIPA teh, aranglae tâhlip, na kângue e doeh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Khodai vah kanî, karum vah thapa ni","poem":1},{"text":"runae na poe mahoeh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"BAWIPA ni runae pueng thung hoi na khetyawt han,","poem":1},{"text":"na hringnae hai a khetyawt han.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"BAWIPA ni, na ceinae,","poem":1},{"text":"na thonae pueng hah","poem":2},{"lineBreak":true},{"text":"atuhoi pout laipalah, a khetyawt han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}