{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["Jerusalem hanelah ratoum awh sei"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA e im dawk cet awh sei telah,","poem":1},{"text":"kai koe ati awh navah, ka lunghawi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oe Jerusalem, kaimae khok teh,","poem":1},{"text":"nange takhang thungvah a kangdue han.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jerusalem teh kacakpounglah sak e lah ao.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"BAWIPA e miphunnaw teh hote kho dawk a cei awh katang.","poem":1},{"text":"Isarelnaw e phung patetlah BAWIPA e a miphunnaw teh","poem":2},{"lineBreak":true},{"text":"BAWIPA min pholen hanelah,","poem":2},{"lineBreak":true},{"text":"BAWIPA min pholen nahanelah a ceitakhang awh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bangkongtetpawiteh, hote hmuen koevah, bawitungkhungnaw,","poem":1},{"text":"Devit imthung bawitungkhungnaw lawkceng nahanelah a hruek awh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jerusalem a roum nahanlah ratoum awh.","poem":1},{"text":"Nang lungpataw naw teh a hmacawn awh naseh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nange rapannaw roumnae awmseh.","poem":1},{"text":"Na impui hawinae coe awh naseh.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ka hmaunawngha han hoi ka huikonaw hanelah,","poem":1},{"text":"nang dawk roumnae awm seh telah ka dei han.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Maimae BAWIPA Cathut im hane dawkvah,","poem":1},{"text":"nange hawinae hah ka tawng han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}