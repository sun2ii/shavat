{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":123,"content":[{"type":"heading","content":["BAWIPA ngaihawinae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Panuekhoeh, tami tangawn ni Hezekiah a ti awh"]},{"type":"verse","number":1,"content":[{"text":"Kalvan kho a tungkhung kaawm e","poem":1},{"text":"nang koe doeh ka ngaihawi .","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sanpanaw ni a bawipa kut a ngaihawi e patetlah thoseh,","poem":1},{"text":"Sannunaw ni a bawipa kut a ngaihawi e patetlah thoseh,","poem":2},{"lineBreak":true},{"text":"kaimouh ni lungmanae ka coe awh hoehroukrak","poem":2},{"lineBreak":true},{"text":"BAWIPA Cathut doeh na ngaihawi awh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oe BAWIPA, kaimouh na lungma haw.","poem":1},{"text":"Kaimouh na lungma haw. Bangkongtetpawiteh,","poem":2},{"lineBreak":true},{"text":"banglah noutnahoehnae teh koung ka boum awh toe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kaimae hringnae teh, ka kâoupnaw ni yeiraipo saknae hai thoseh,","poem":1},{"text":"lunglenpansa lah kaawm naw ni banglah noutnahoehnae hai thoseh,","poem":2},{"lineBreak":true},{"text":"koung ka boum awh toe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}