{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"heading","content":["Maimouh koe kaawm e BAWIPA"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA ni na awmkhai hoeh pawiteh,","poem":1},{"text":"telah Isarelnaw ni atu a dei awh hane teh,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"BAWIPA teh maimouh koe lah awm hoeh pawiteh,","poem":1},{"text":"taminaw ni na taran awh navah,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"a lungkhuek awh vaiteh, maimouh hah","poem":1},{"text":"hringo na payawp awh toe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hatnavah, tui ni maimanaw teh","poem":1},{"text":"muen na ramuk teh tui ka lawng e ni,","poem":2},{"lineBreak":true},{"text":"maimae hringnae van muen a lawng sin toe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Puenghoi kalawng e tui ni maimae hringnae teh","poem":1},{"text":"muen a lawng sin toe, tie hah doeh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ahnimouh ni hâ hoi na ai awh nahanelah,","poem":1},{"text":"maimanaw hah ahnimouh koe na poe awh hoeh.","poem":2},{"lineBreak":true},{"text":"BAWIPA teh pholen lah awm seh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maimae hringnae teh, tangkam dawk hoi","poem":1},{"text":"kahlout e tava patetlah a hlout toe.","poem":2},{"lineBreak":true},{"text":"Tangkam a lawt teh, maimouh hlout awh toe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Maimouh kabawpnae teh, kalvan hoi talai ka sak e","poem":1},{"text":"BAWIPA min lahoi coe awh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}