{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"heading","content":["Miphunnaw ni kâuepnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Panuekhoeh, tami tangawn ni Hezekiah a ti awh"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA ka kâuep e naw teh,","poem":1},{"text":"kâhuen hoeh niteh, a yungyoe kangning e","poem":2},{"lineBreak":true},{"text":"Zion mon patetlah ao han.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Monnaw ni Jerusalem a kalup e patetlah,","poem":1},{"text":"BAWIPA ni a miphunnaw hah atuhoi pout laipalah a kalup.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tami kalannaw ni amamae kut hoi,","poem":1},{"text":"kahawihoehe hno a sak awh hoeh nahanelah,","poem":2},{"lineBreak":true},{"text":"tamikaponaw e sonron teh,","poem":2},{"lineBreak":true},{"text":"tami kalannaw e râw talai dawk awm hanh naseh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oe BAWIPA, tami kahawinaw hoi","poem":1},{"text":"tami kalannaw koe hawinae sak haw.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amamae dumyennae lam dawk ka cet e naw hateh,","poem":1},{"text":"yonnae ka sak e naw hoi cungtalah,","poem":2},{"lineBreak":true},{"text":"BAWIPA ni a pâlei han. Isarelnaw koe roumnae awm lawiseh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}