{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"heading","content":["Zion hawinae bout a coe sak"]},{"type":"hebrew_subtitle","content":["kathutkung: panuekhoeh"]},{"type":"verse","number":1,"content":[{"text":"A man awh teh a hrawi awh e Zioncanaw hah","poem":1},{"text":"BAWIPA ni bout a ban sak toteh,","poem":2},{"lineBreak":true},{"text":"kai teh mang ka mang e patetlah ka o.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hat toteh, kaimae pahni teh panuinae hoi thoseh,","poem":1},{"text":"kaimae lai teh, la saknae hoi thoseh a kawi han.","poem":2},{"lineBreak":true},{"text":"Ayânaw niteh, BAWIPA ni ahnimouh hanelah","poem":2},{"lineBreak":true},{"text":"hno kalen a sak pouh toe, telah miphunnaw rahak vah a dei awh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"BAWIPA ni kaimouh hanlah hno kalen a sak toe.","poem":1},{"text":"Kaimouh teh ka lunghawi awh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oe BAWIPA, a man awh teh, a hrawi awh e kaimanaw hah,","poem":1},{"text":"Negeb e palangtui patetlah bout tho sak haw.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mitphi tui hoi cati katunaw ni","poem":1},{"text":"lunghawi la sak laihoi a a awh han.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Cati ka phawt niteh, tha thout laipalah,","poem":1},{"text":"khuika laihoi ka tâcawt e tami teh,","poem":2},{"lineBreak":true},{"text":"cabongnaw hrawm vaiteh,","poem":2},{"lineBreak":true},{"text":"lunghawi la sak laihoi bout a ban katang han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}