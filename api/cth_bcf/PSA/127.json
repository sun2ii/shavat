{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"heading","content":["BAWIPA ni im sak hoeh pawiteh"]},{"type":"hebrew_subtitle","content":["kathutkung: Solomon"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA ni im sak hoeh pawiteh,","poem":1},{"text":"ka tawk e pueng ni ayawmyin doeh a tawk awh.","poem":2},{"lineBreak":true},{"text":"BAWIPA ni kho ring hoeh pawiteh,","poem":2},{"lineBreak":true},{"text":"ka ring e pueng ni ayawmyin doeh a ring awh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amom ka thaw niteh, karumsaning torei ka ip niteh,","poem":1},{"text":"nget ka tawn lah tawk laihoi ka cat nakunghai,","poem":2},{"lineBreak":true},{"text":"ayawmyin doeh.","poem":2},{"lineBreak":true},{"text":"Bangkongtetpawiteh, Bawipa ni a pahren e naw koe","poem":2},{"lineBreak":true},{"text":"duedue inae a poe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Khenhaw! Canu capanaw teh, BAWIPA ni na poe e râw doeh.","poem":1},{"text":"Khe e camo teh, tawkphu doeh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na naw nah na khe e canu capanaw teh,","poem":1},{"text":"athakaawme tami kut dawk e pala hoi a kâvan.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ama e palabom hah hote palasamtang hoi","poem":1},{"text":"ka kawi sak e tami teh a yawhawi.","poem":2},{"lineBreak":true},{"text":"Ahnimouh teh, kayanae awm mahoeh.","poem":2},{"lineBreak":true},{"text":"Tarannaw hah longkha koe a ngang awh han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}