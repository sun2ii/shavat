{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"heading","content":["BAWIPA ka taket e imthung"]},{"type":"hebrew_subtitle","content":["Kathutkung: Panuekhoeh, tami tangawn ni Hezekiah a ti awh"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA ka taket niteh, a lamthung ka dawn e tami pueng teh,","poem":1},{"text":"tami yawkahawi e doeh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hottelah na sak pawiteh, nang teh na kut hoi","poem":1},{"text":"na tawk e hah atangcalah na ca han.","poem":2},{"lineBreak":true},{"text":"Yawhawi awm vaiteh, lunghawinae na coe han.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na yu teh na im thung kaawm niteh,","poem":1},{"text":"a paw moi kapaw e misurkung hoi a kâvan.","poem":2},{"lineBreak":true},{"text":"Na canu capanaw teh, na caboi petkâkalup lah,","poem":2},{"lineBreak":true},{"text":"ung e olivekungnaw patetlah ao awh han.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Khenhaw! Bawipa ka taket e teh,","poem":1},{"text":"hot patet e yawhawinae a coe han.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"BAWIPA ni Zion hoi yawhawi na poe seh.","poem":1},{"text":"Na hringyung thung Jerusalem e hawinae na hmawt naseh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Na canaw ni a khe e canaw hai na hmawt naseh.","poem":1},{"text":"Isarelnaw koe roumnae awm seh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}