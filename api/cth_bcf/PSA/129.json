{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"heading","content":["Taran tâ nahanelah ratoumnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Panuekhoeh, tami tangawn ni Hezekiah a ti awh"]},{"type":"verse","number":1,"content":[{"text":"Ka nawca hoiyah ahnimouh ni na rektap awh,","poem":1},{"text":"telah Isarelnaw ni tet awh naseh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ka nawca hoiyah ahnimouh ni kai teh, na rektap awh.","poem":1},{"text":"Hatei, na tâ awh hoeh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ka hnukthun vah talai thawn e patetlah a thawn awh teh,","poem":1},{"text":"laikong kasawlah a sak awh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hatei, BAWIPA teh a lan.","poem":1},{"text":"Ahni ni tamikaponaw e tangronnaw teh,","poem":2},{"lineBreak":true},{"text":"thouk thouk a bouk pouh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zion kahmuhmanaw pueng teh,","poem":1},{"text":"kayak awh naseh, hnuklah ban awh naseh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ahnimouh teh, a kung a len hoehnahlan","poem":1},{"text":"remke e lemphu e phokung patetlah awm awh naseh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hote pho teh, kaanaw hanelah,","poem":1},{"text":"kut kasum khuem hai phat hoeh.","poem":2},{"lineBreak":true},{"text":"Ka tangoungnaw hanelah, tapam khuem hai phat hoeh.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ka cet kaawm pueng nihai,","poem":1},{"text":"BAWIPA e yawhawi teh nangmouh koe awm lawiseh.","poem":2},{"lineBreak":true},{"text":"Kaimouh ni BAWIPA min lahoi nangmouh","poem":2},{"lineBreak":true},{"text":"yawhawi na poe awh telah a dei awh mahoeh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}