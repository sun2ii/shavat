{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"heading","content":["BAWIPA rungngangnae kâuepnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"Oe BAWIPA, nâtotouh maw na pahnim yungyoe han.","poem":1},{"text":"Nâtotouh maw kai koehoi na minhmai na hro han rah.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kai teh, ka lung pou a mathoe.","poem":1},{"text":"Nâtotouh ne kamadueng lungreithai hoi ka i han vai.","poem":2},{"lineBreak":true},{"text":"Nâtotouh ne ka lathueng ka taran ni a kâoup han rah vai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oe BAWIPA ka Cathut, kangvawi nateh ka lawk hah na thai pouh haw.","poem":1},{"text":"Ka mit ang sak haw. Hoehpawiteh, duenae patetlah ka ip payon vaih.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hoehpawiteh, ka taran ni ahni ka tâ toe ati han doeh.","poem":1},{"text":"Hoehpawiteh, ka kâroe navah, runae na kapoenaw a konawm awh langvaih.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hatei, na lungmanae hah ka kâuep teh,","poem":1},{"text":"na rungngangnae dawk ka lungthin a konawm han.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"BAWIPA koe la ka sak han.","poem":1},{"text":"Bangkongtetpawiteh, ka lathueng ahawi tangngak.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}