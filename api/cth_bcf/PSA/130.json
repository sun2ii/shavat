{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["BAWIPA ni ratangnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Panuekhoeh, tami tangawn ni Hezekiah a ti awh"]},{"type":"verse","number":1,"content":[{"text":"Oe BAWIPA, kai ni a dungnae koehoi na kaw.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oe Cathut, kaie lawk hah na thai pouh haw.","poem":1},{"text":"Kai ni ka kâheinae lawk hah hnâpakeng haw.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oe Bawipa Jehovah, nang ni payonnae hah","poem":1},{"text":"na pâkuem pawiteh, apimouh ka khang thai han va.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hatei, nang ni na ngaithoum dawkvah,","poem":1},{"text":"taminaw ni nang teh, na taki awh teh na bari awh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kai teh, BAWIPA doeh ka ngaihawi.","poem":1},{"text":"Ka hringnae ni a ngaihawi.","poem":2},{"lineBreak":true},{"text":"Kai teh Bawipa e a lawk hah ka kâuep.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ramvengnaw ni amom a ngaihawi awh e hlak,","poem":1},{"text":"atangcalah ramvengnaw ni amom a ngaihawi awh e hlak,","poem":2},{"lineBreak":true},{"text":"ka hringnae ni Bawipa teh a ngaihawi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oe Isarel miphun, BAWIPA hah ngaihawi awh haw.","poem":1},{"text":"Bangkongtetpawiteh, BAWIPA dawk pahrenlungmanae ao.","poem":2},{"lineBreak":true},{"text":"Ka kuep e ratangnae hai Bawipa koe ao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bawipa ni Isarel miphunnaw teh","poem":1},{"text":"payonnae kaawm e pueng dawk hoi a ratang han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}