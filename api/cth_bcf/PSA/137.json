{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"heading","content":["Zion la"]},{"type":"hebrew_subtitle","content":["Kathutkung: Panuekhoeh"]},{"type":"verse","number":1,"content":[{"text":"Kaimouh teh Babilon palang teng ka tahung awh teh,","poem":1},{"text":"Zion ka pouk awh dawkvah, ka ka awh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kaimae ratoungnaw hah","poem":1},{"text":"sumpakung dawk ka bang awh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bangkongtetpawiteh, hote hmuen koe maimouh na ka man niteh,","poem":1},{"text":"na kahrawinaw ni kai koe la a hei awh.","poem":2},{"lineBreak":true},{"text":"Kaimouh karektapnaw ni hai amamouh nawm nahanelah","poem":2},{"lineBreak":true},{"text":"Zion la kaimouh hanlah sak haw ati awh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kaimouh ni Jentelnaw e ram dawk bangtelamaw","poem":1},{"text":"BAWIPA pholennae la ka sak thai awh han vaw.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Oe Jerusalem, nang hah kai ni na pahnim pawiteh,","poem":1},{"text":"kama e aranglae kut ni a tawksak thai e hah pahnim naseh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nang hah na pouk hoeh boilah,","poem":1},{"text":"Jerusalem hah ka lunghawinae","poem":2},{"lineBreak":true},{"text":"lathueng ka hrueng hoeh pawiteh,","poem":2},{"lineBreak":true},{"text":"ka lai teh ka dangka dawk kâbet naseh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oe BAWIPA, Jerusalem a rawp nah hnin vah,","poem":1},{"text":"raphoe awh, khomdu totouh raphoe awh telah","poem":2},{"lineBreak":true},{"text":"kahram awh e Edomnaw hah pouk haw.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Oe Babilon canu, raphoe lah na o han toe.","poem":1},{"text":"Kaimouh koe na sak e patetlah,","poem":2},{"lineBreak":true},{"text":"nang koe ka patho e teh a lunghawi naseh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nange camonaw hah kaman niteh,","poem":1},{"text":"talung dawk rekrek ka suk e teh a lunghawi naseh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}