{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"heading","content":["Cathut laipalah pathunae doeh"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"Tamipathu ni a lungthung hoi,","poem":1},{"text":"Cathut awmhoeh ati. A rawk toe.","poem":2},{"lineBreak":true},{"text":"Panuet ka tho e hno doeh a sak.","poem":2},{"lineBreak":true},{"text":"Hawinae ka sak e awm hoeh toe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Cathut ka tawng niteh,","poem":1},{"text":"ka panuek thai e ao han na ou tie panue han ngai dawk,","poem":2},{"lineBreak":true},{"text":"BAWIPA ni kalvan hoi tami capanaw hah a khet cathuk.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Abuemlahoi lam a phen awh teh,","poem":1},{"text":"cungtalah koung a rawk awh toe.","poem":2},{"lineBreak":true},{"text":"Hawinae kasakkung apihai awmhoeh. Buet touh boehai awmhoeh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Payonnae kasaknaw ni panuenae tawn awh hoeh ma aw.","poem":1},{"text":"Rawca ca e patetlah ka taminaw hah a ca awh teh,","poem":2},{"lineBreak":true},{"text":"BAWIPA kaw awh hoeh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hawvah, takinae kalen koe ao awh.","poem":1},{"text":"Bangkongtetpawiteh, Cathut teh tami kalannaw koelah ao.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tami karoedengnaw e pouknae teh a kaya sak awh.","poem":1},{"text":"Hatei, BAWIPA teh ahnimae kânguenae doeh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oe Isarel rungngangnae teh Zion hoi tâcawt naseh.","poem":1},{"text":"BAWIPA ni san lah kaawm e taminaw a bankhai toteh,","poem":2},{"lineBreak":true},{"text":"Jakop teh konawm naseh. Isarel hai lunghawi naseh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}