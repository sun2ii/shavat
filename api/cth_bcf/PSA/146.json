{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"heading","content":["Pahrennae hoi kawi Cathut"]},{"type":"hebrew_subtitle","content":["Kathutkung: Panuekhoeh"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA teh pholen awh.","poem":1},{"text":"Oe ka hringnae BAWIPA hah pholen haw.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kai teh, kahring lahun nah BAWIPA ka pholen han.","poem":1},{"text":"Ka hringyung thung ka Cathut teh la sak hoi ka pholen han.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bawinaw hoi na ka rungngang thai hoeh e","poem":1},{"text":"taminaw hah kâuep awh hanh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ahnimae muitha a tâco toteh, talai lah doeh a ban awh.","poem":1},{"text":"Hatnah hnin vah, ahnimae pouknae pueng teh be a rawk pouh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jakop e Cathut hah na kabawmkung lah kaawm sak e,","poem":1},{"text":"amae Cathut ka ngaihawi e teh, a yaw ahawi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hote Cathut ni kalvan, talai, tuipui,","poem":1},{"text":"hoi hetnaw dawk kaawm e naw pueng hah a sak.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Rektap lah kaawmnaw hanelah, lawk a ceng pouh teh,","poem":1},{"text":"a von kahlamnaw rawca a poe.","poem":2},{"lineBreak":true},{"text":"BAWIPA ni thongkabawtnaw a hlout sak.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"BAWIPA ni mitdawnnaw mit a hmu sak.","poem":1},{"text":"BAWIPA ni katabutnaw hah a loungouk sak teh,","poem":2},{"lineBreak":true},{"text":"tamikalannaw hah a lungpataw.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"BAWIPA ni Jentelnaw hah a khetyawt teh,","poem":1},{"text":"naranaw hoi lahmainunaw hah a kabawp.","poem":2},{"lineBreak":true},{"text":"Tamikathoutnaw e lamthung teh, a rawk sak.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"BAWIPA ni a yungyoe a uk han.","poem":1},{"text":"Oe Zion na Cathut ni catounnaw totouh a uk han.","poem":2},{"lineBreak":true},{"text":"Hallelujah.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}