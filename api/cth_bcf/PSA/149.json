{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"heading","content":["Tami kathoungnaw ni BAWIPA pholennae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Panuekhoeh"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA teh pholen awh.","poem":1},{"text":"BAWIPA koe la katha hah sak awh haw.","poem":2},{"lineBreak":true},{"text":"Tami kathoungnaw kamkhuengnae koe","poem":2},{"lineBreak":true},{"text":"a pahrennae hah pholen awh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Isarelnaw ni amamouh kasakkung koe lunghawi naseh.","poem":1},{"text":"Zion canunaw ni amamae siangpahrang koe konawm naseh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ahnimouh ni lamtu laihoi","poem":1},{"text":"Bawipa min teh pholen awh naseh.","poem":2},{"lineBreak":true},{"text":"Tâbaw khawng laihoi, ratoung kueng laihoi,","poem":2},{"lineBreak":true},{"text":"pholen hoi la sak awh naseh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bangkongtetpawiteh, BAWIPA ni","poem":1},{"text":"amae taminaw dawk a lungyouk.","poem":2},{"lineBreak":true},{"text":"A ma ni kârahnoum e naw hah","poem":2},{"lineBreak":true},{"text":"rungngangnae hoi a kamcu sak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tami kathoungnaw ni a bawilennae dawkvah,","poem":1},{"text":"lunghawi awh naseh.","poem":2},{"lineBreak":true},{"text":"Amamae ikhun dawk lunghawi laihoi la sak awh naseh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ahnimae pahni dawk karasangpoung lah","poem":1},{"text":"Cathut pholennae awm naseh.","poem":2},{"lineBreak":true},{"text":"Ahnimae kut dawk hai,","poem":2},{"lineBreak":true},{"text":"avoivang kahran e tahloi patuem awh naseh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ahnimouh ni khoramnaw moipathung hane hoi","poem":1},{"text":"taminaw reknae thoseh,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ahnimae siangpahrangnaw hai sumrui hoi pâkhi vaiteh,","poem":1},{"text":"ahnimouh thung dawk e bari kaawm e taminaw hah","poem":2},{"lineBreak":true},{"text":"khok dawk hlong buet hoi pâkhi hane thoseh,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"thut e lawkcengnae hah,","poem":1},{"text":"ahnimouh koe pha sak nahane doeh.","poem":2},{"lineBreak":true},{"text":"Hethateh, tami kathoungnaw pueng koe","poem":2},{"lineBreak":true},{"text":"kaawm hane barinae doeh.","poem":2},{"lineBreak":true},{"text":"Hallelujah.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}