m":2}]},{"type":"verse","number":5,"content":[{"text":"a pung lahoi tangka ka cawi boihoeh niteh,","poem":1},{"text":"yonnae ka tawn hoeh e koe tadawnghno ka lat boihoeh e naw han doeh.","poem":2},{"lineBreak":true},{"text":"Hot patet e hno ka sak e naw teh, nâtuek hai kâhuen mahoeh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}