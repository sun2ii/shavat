{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"heading","content":["Cathut rungngangnae thaw"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"Runae hnin dawk BAWIPA ni na pato naseh.","poem":1},{"text":"Jakop Cathut min lahoi na roum sak naseh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hmuen kathoung koehoi kabawpnae teh tâcawt sak naseh.","poem":1},{"text":"Zion hoi tha awm sak naseh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na thuengnae pueng na thai pouh naseh.","poem":1},{"text":"Hmaisawi thuengnae hai dâw naseh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na ngainae patetlah na poe naseh,","poem":1},{"text":"na pouknae patetlah kuep sak naseh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na rungngangnae dawk ka konawm awh vaiteh,","poem":1},{"text":"Cathut min lahoi lukkarei a yap awh han.","poem":2},{"lineBreak":true},{"text":"BAWIPA ni na hei e pueng kuep sak lawiseh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"BAWIPA ni satui awi e a rungngang tie atuvah panue awh toe.","poem":1},{"text":"Kathounge kalvan hoi a rungngangnae aranglae kut,","poem":2},{"lineBreak":true},{"text":"athakaawme hoi na pato han.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Atangawn ni leng a kâuep awh teh,","poem":1},{"text":"atangawn ni marang a kâuep awh.","poem":2},{"lineBreak":true},{"text":"Hatei, kaimouh teh, BAWIPA Cathut min hah pou ka kâuep awh han.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ahnimouh teh tabut hoi a rawp awh.","poem":1},{"text":"Hatei, kaimouh teh ka thaw awh teh, kalancalah ka kangdue awh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"BAWIPA rungngang haw.","poem":1},{"text":"Ka kaw toteh siangpahrang ni na pato naseh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}