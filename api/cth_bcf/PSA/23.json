t":"ka lû dawk satui na awi teh,","poem":2},{"lineBreak":true},{"text":"kaie manang teh poum lah a poum.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ka hring nathung lungmanae hoi","poem":1},{"text":"hawinae ni na kâbang sin vaiteh,","poem":2},{"lineBreak":true},{"text":"BAWIPA im dawk a yungyoe ka o han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}