{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"heading","content":["Ratang nahanelah ratoumnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA, nang ni kai lawk na ceng haw,","poem":1},{"text":"lungcaknae hoi ka cei teh","poem":2},{"lineBreak":true},{"text":"BAWIPA nang na kâuep dawkvah ka kâhuen mahoeh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kai hah na noumcai nateh, oe BAWIPA,","poem":1},{"text":"ka lung ni a ngai e naw hoi ka pouknae hah na khen pouh haw.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ka cak e na lungpatawnae lamthung kai na patue haw,","poem":1},{"text":"yuemkamcunae ni pou na hrawi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dumyennae hoi cungtalah ka hmawng hoeh.","poem":1},{"text":"Tami kahawihoehnaw hai ka hmawng hoeh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tami kahawihoehnaw e kamkhuengnae hah ka hmuhma,","poem":1},{"text":"Tamikathoutnaw hoi reirei ka tahung hoeh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ka kut heh thoungnae hoi ka pâsu teh","poem":1},{"text":"BAWIPA namae thuengnae ka lawngven.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lunghawilawkdeinae la ka sak teh","poem":1},{"text":"kângairu hno na sak e hah ka dei.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"BAWIPA na onae im hah kai lungpataw teh","poem":1},{"text":"na bawilennae hmuen hah kai ni ka ngai.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tamikayonnaw koe kai mek thei sin hanlah","poem":1},{"text":"tami kathetnaw koe kai na tâkhawng sin hanh.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ahnimouh teh hawihoehnae yungyoe a sak awh.","poem":1},{"text":"Tadawnghno ka ngai e taminaw doeh.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kai teh hnokahawi hoeh e ka sak,","poem":1},{"text":"na pahren nateh na rungngang haw.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hnâroumcalah tanghling dawk ka kangdue teh","poem":1},{"text":"maya a kamkhuengnae koe BAWIPA nang na pholen.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}