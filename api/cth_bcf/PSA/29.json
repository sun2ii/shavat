{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"heading","content":["BAWIPA lawk"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"Oe nangmouh athakaawmnaw,","poem":1},{"text":"BAWIPA teh pâtam awh haw.","poem":2},{"lineBreak":true},{"text":"BAWIPA koe bawilennae hoi thayung hah poe awh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"BAWIPA koe a min hoi kamcu e bawilennae hah poe awh","poem":1},{"text":"BAWIPA teh thoungnae kamthoup lahoi bawk awh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"BAWIPA lawk teh tui dawk ao teh,","poem":1},{"text":"Cathut bawilennae teh puenghoi a cai,","poem":2},{"lineBreak":true},{"text":"BAWIPA teh tui moikapap dawk ao.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"BAWIPA lawk teh bahuonae hoi a kawi.","poem":1},{"text":"BAWIPA lawk teh taluenae hoi a kawi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"BAWIPA lawk ni sidar thingnaw a khoe,","poem":1},{"text":"BAWIPa ni Lebanon mon e sidar thingnaw a pâyaw sak.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maitoca patetlah a cawkdawk sak teh,","poem":1},{"text":"Lebanon hoi Sirion hah savica patetlah a cawkdawk sak.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"BAWIPA lawk ni hmaisaan hah a kapek.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"BAWIPA lawk ni kahrawng hai a kahuet,","poem":1},{"text":"BAWIPA ni Kadesh kahrawng hai a kahuet.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"BAWIPA lawk ni sayuk ca a khe sak teh,","poem":1},{"text":"kahrawng e thinghna pueng koung a due.","poem":2},{"lineBreak":true},{"text":"A bawkim dawk tami pueng ni 'a sungren' telah ati awh.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tuikalen dawkvah bawitungkhung dawk","poem":1},{"text":"BAWIPA teh a tahung","poem":2},{"lineBreak":true},{"text":"BAWIPA teh siangpahrang patetlah pou a tahung.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"BAWIPA ni a taminaw hah a thaosak teh,","poem":1},{"text":"BAWIPA ni a taminaw hah roumnae lahoi","poem":2},{"lineBreak":true},{"text":"yawhawi a poe han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}