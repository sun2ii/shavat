{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["BAWIPA ni a taminaw runae a kabawp"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit, Devit ni a sak e la: A capa Absalom koehoi a yawng nah sak e"]},{"type":"verse","number":1,"content":[{"text":"Oe BAWIPA, kaie tarannaw teh apap poung.","poem":1},{"text":"Kai na ka tarannaw apap poung.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Taminaw ni, ahni teh Cathut koehoi e kabawpnae awmhoeh","poem":1},{"text":"telah kai hanelah a dei awh. Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hatei, Oe BAWIPA, nang teh kai hanlah kânguenae bahling,","poem":1},{"text":"kaie bawilennae lah na o teh, kaie lû katawmkung lah na o.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kai ni hram laihoi, BAWIPA hah ka kaw toteh,","poem":1},{"text":"ahni ni kathounge mon dawk hoi kai hah na pato. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"BAWIPA ni na kabawp dawkvah,","poem":1},{"text":"kai teh ka i thai teh, ka kâhlaw thai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kai hah avoivang lahoi na kalup niteh,","poem":1},{"text":"na ka tuk e tami thong hra touh ka phat hai ka taket hoeh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Oe BAWIPA, thaw haw. Kaie Cathut, na rungngang haw.","poem":1},{"text":"Bangkongtetpawiteh, nang ni ka tarannaw pueng e kamhru hah,","poem":2},{"lineBreak":true},{"text":"na hem pouh teh, tamikathoutnaw e a hâ hah na khoe pouh.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Rungngangnae teh BAWIPA e doeh.","poem":1},{"text":"Nange yawhawinae teh,","poem":2},{"lineBreak":true},{"text":"na taminaw koe phat lawiseh. Selah.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}