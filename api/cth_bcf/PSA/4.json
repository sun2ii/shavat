{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"heading","content":["Yuemkamcunaw roumnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"Oe lannae Cathut,","poem":1},{"text":"na kaw toteh na thai pouh haw.","poem":2},{"lineBreak":true},{"text":"Ka runae hah na hlai haw.","poem":2},{"lineBreak":true},{"text":"Na pahren haw, ka ratoumnae hah na thai pouh haw.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oe tami capanaw,","poem":1},{"text":"ka bawilennae hah nâtotouh maw kayanae lah na coung sak awh han.","poem":2},{"lineBreak":true},{"text":"Nâtotouh maw ayawmyin hno hah na lungpataw awh vaiteh,","poem":2},{"lineBreak":true},{"text":"payonnae hah na tawng awh han. Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"BAWIPA ni cathutlae tami teh a rawi tie hah panuek awh haw.","poem":1},{"text":"Ka kaw toteh BAWIPA ni na thai pouh han.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na lungkhuek yawkaw, yonnae teh sak hanh.","poem":1},{"text":"Na ikhun dawk na lung hoi pouk nateh duem awm.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lannae thuengnae hah poe nateh,","poem":1},{"text":"BAWIPA hah kâuep haw.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Apinimaw hawinae na hmusak han na ka tet pouh e moi ao awh.","poem":1},{"text":"BAWIPA kaimouh koe na minhmai angnae hoi na tue haw.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Cakang hoi misur moikapap a hmu awh dawk","poem":1},{"text":"konawmnae hlak kalenhnawn e konawmnae hah","poem":2},{"lineBreak":true},{"text":"ka lung thung na ta toe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Duem ka yan vaiteh, ka i han toe.","poem":1},{"text":"Bangkongtetpawiteh, Oe BAWIPA,","poem":2},{"lineBreak":true},{"text":"nang ni dueng doeh karoumcalah na o sak thai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}