{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["Runae thung hoi Cathut koe ratoumnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Korah capanaw"]},{"type":"verse","number":1,"content":[{"text":"Oe Cathut, lawk na ceng pouh haw.","poem":1},{"text":"Cathutlaipa e miphunnaw hmalah","poem":2},{"lineBreak":true},{"text":"ka kong heh lawk na ceng pouh haw.","poem":2},{"lineBreak":true},{"text":"Oe tamikathoutnaw hoi kadumyennaw koehoi na rungngang haw.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bangkongtetpawiteh, nang teh kaie Cathut rapanim doeh.","poem":1},{"text":"Bangkongmaw na hnoun.","poem":2},{"lineBreak":true},{"text":"Bangkongmaw na ka tarannaw kecu ka lung ouk a mathoe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oe, na angnae hoi lawkkatang hah patoun haw.","poem":1},{"text":"Hot niyah na hrawi naseh.","poem":2},{"lineBreak":true},{"text":"Na mon kathoung hoi na onae lukkareiim dawk na phatkhai naseh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hottelah Cathut e thuengnae khoungroe,","poem":1},{"text":"ka konawmnae Cathut koe ka cei han.","poem":2},{"lineBreak":true},{"text":"Oe Cathut, ka Cathut, ratoung hoi na pholen han.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Oe ka hringnae Bangkongmaw na lung a mathoe.","poem":1},{"text":"Bangkongmaw ka thung vah, runae na kâhmo.","poem":2},{"lineBreak":true},{"text":"Cathut hah kâuep haw, ama teh ka pholen han.","poem":2},{"lineBreak":true},{"text":"Na kabawmkung hoi na kadamsakkung Cathut doeh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}