{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"heading","content":["Talai ukkungnaw Cathut pholen awh"]},{"type":"hebrew_subtitle","content":["Kathutkung: Korah capanaw"]},{"type":"verse","number":1,"content":[{"text":"Oe taminaw pueng, na kuttabawng awh nateh,","poem":1},{"text":"tânae lawk hoi Cathut koe hram awh sei.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jehovah Lathueng Poung teh takitho poung.","poem":1},{"text":"Ama teh talai pueng e Siangpahrang kalen doeh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maimae rahim tamipueng tabut sak vaiteh,","poem":1},{"text":"maimae khok rahim miphunnaw a tabut sak han.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A lungpataw e Jakop hanelah, kahawipoung e bawilennae lah kaawm e,","poem":1},{"text":"maimae râw hah maimouh hanlah na rawi pouh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Cathut teh hram laihoi a luen teh,","poem":1},{"text":"BAWIPA teh mongka lawk hoi a luen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Cathut pholen hoi la sak awh nateh, pholen hoi la sak awh.","poem":1},{"text":"Maimae Siangpahrang koe pholen hoi la sak awh nateh,","poem":2},{"lineBreak":true},{"text":"pholen hoi la sak awh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Cathut teh talai pueng e Siangpahrang doeh.","poem":1},{"text":"Sam la hoi pholen la sak awh.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Cathut teh miphun pueng lathueng Siangpahrang lah ao teh,","poem":1},{"text":"Cathut teh a bawitungkhung dawk lawkceng laihoi a tahung.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Miphun pueng e tami kacuenaw teh,","poem":1},{"text":"Abraham Cathut e miphun koe a kamkhueng awh.","poem":2},{"lineBreak":true},{"text":"Bangkongtetpawiteh, talai siangpahrangnaw teh,","poem":2},{"lineBreak":true},{"text":"Cathut ni a tawn e doeh. Ama teh hoe tawmrasang lah ao.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}