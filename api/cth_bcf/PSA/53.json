{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"heading","content":["Cathut laipalah pathunae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"Tamipathu niteh, a lungthung hoi Cathut awm hoeh ati awh.","poem":1},{"text":"Ka rawk niteh, panuet ka tho e payonnae hah a sak awh teh,","poem":2},{"lineBreak":true},{"text":"hawinae kasakkung awm awh hoeh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Thaipanueknae ka tawn e tami hoi","poem":1},{"text":"Cathut ka tawng e tami ao han vaimoe titeh panue han a ngai dawkvah,","poem":2},{"lineBreak":true},{"text":"Cathut ni kalvan hoi talai van a khet cathuk.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tami pueng koung a payon awh teh, koung a rawk awh.","poem":1},{"text":"Hawinae kasakkung awm hoeh.","poem":2},{"lineBreak":true},{"text":"Buet touh boehai awm hoeh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vaiyei ca e patetlah ka taminaw hah a ca awh teh,","poem":1},{"text":"Cathut ka kaw hoeh e tamikathoutnaw panueknaen tawn laipalah maw ao awh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Taki hane ohoehnae koe puenghoi a taki awh.","poem":1},{"text":"Bangkongtetpawiteh, nang na kalup niteh,","poem":2},{"lineBreak":true},{"text":"na ka tarannaw e hru teh Cathut ni paringparang a kâyat sak.","poem":2},{"lineBreak":true},{"text":"Ahnimouh teh Cathut ni a takhoe dawkvah,","poem":2},{"lineBreak":true},{"text":"kayayeirai phu hoi ao sak han.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oe Isarel rungngangnae teh Zion hoi tâcawt naseh.","poem":1},{"text":"San lah kaawm e taminaw Cathut ni bout a tâcokhai toteh,","poem":2},{"lineBreak":true},{"text":"Jakop konawm naseh, Isarel lunghawi naseh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}