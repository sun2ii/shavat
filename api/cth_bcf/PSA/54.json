{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["Katarankung koehoi hloutnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"Oe Cathut, na min lahoi na rungngang haw.","poem":1},{"text":"Na thaonae hoi lawk na ceng pouh haw.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oe Cathut, ka ratoum e heh thai haw.","poem":1},{"text":"Ka dei e lawk heh na thai pouh haw.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bangkongtetpawiteh, ramlouknaw ni kai taranlahoi a thaw awh teh,","poem":1},{"text":"rep kacuengroenaw ni thei hanlah a kâcai awh.","poem":2},{"lineBreak":true},{"text":"Cathut minhmai khoeroe khen awh hoeh. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Khenhaw! Cathut teh na kabawmkung doeh.","poem":1},{"text":"BAWIPA teh ka hringnae karingkungnaw koe ao.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A tawksak awh e thoenae hah ama ni a patho han.","poem":1},{"text":"Ahnimouh teh na lawkkatang hoi raphoe haw.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kai hai lungthocalah hoi nang koe thuengnae ka sak han.","poem":1},{"text":"Oe BAWIPA, na min teh ka pholen han.","poem":2},{"lineBreak":true},{"text":"Bangkongtetpawiteh, nang teh na hawi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kai hah runae phunkuep thung hoi na hlout sak teh,","poem":1},{"text":"ka tarannaw koe ka phat e hah ka mit ni khei a hmu toe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}