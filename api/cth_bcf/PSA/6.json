{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"heading","content":["Runae thung hoi yuemkamcu ratoumnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"Oe BAWIPA, lungkhuek laihoi na yue hanh,","poem":1},{"text":"na lungphuen laihoi na yue hanh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Oe BAWIPA, na pahren haw. Ka tha a youn.","poem":1},{"text":"Oe BAWIPA, na dam sak haw.","poem":2},{"lineBreak":true},{"text":"Ka hrunaw teh runae a kâhmo toe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ka hringnae hai a ru toe.","poem":1},{"text":"Oe BAWIPA, nâsittouh maw na ro han.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oe BAWIPA, bout ban nateh, na rungngang haw.","poem":1},{"text":"Oe na lungmanae hoi na rungngang haw.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bangkongtetpawiteh, duenae koehoi nang pouknae awmhoeh,","poem":1},{"text":"apinimouh phuen koehoi lunghawinae lawk a dei han.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ka cingounae koe ka tâwn.","poem":1},{"text":"Kho pei ka dai lah ka ikhun dawk ka ka teh,","poem":2},{"lineBreak":true},{"text":"ka mitphi ni lahoung koung a duk sak.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lungmathoenae kecu dawk ka mit koung a ro teh,","poem":1},{"text":"ka tarannaw kecu dawk a mawm toe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Payonnae kasaknaw pueng,","poem":1},{"text":"na cettakhai awh leih.","poem":2},{"lineBreak":true},{"text":"Bangkongtetpawiteh, BAWIPA ni ka kanae lawk hai a thai.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"BAWIPA ni ka kâheinae hah a thai toe.","poem":1},{"text":"BAWIPA ni ka ratoumnae hah a dâw han.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ka taran pueng kaya laihoi ru awh naseh.","poem":1},{"text":"Ban awh naseh, vaitalahoi kayak awh naseh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}