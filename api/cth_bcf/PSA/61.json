{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["Cathut ni yungyoe ringnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit, La kahrawikung hanlah, rui thueng e tumkhawng hoi ni sak e la"]},{"type":"verse","number":1,"content":[{"text":"Oe Cathut, ka hramnae lawk heh na thai pouh haw.","poem":1},{"text":"Ka ratoumnae heh na thai pouh haw.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ka lung tha a tawn teh, talai poutnae koehoi nang koe ka hram.","poem":1},{"text":"Kai hlak ka rasang e lungsong koe na hrawi haw.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bangkongtetpawiteh, nang teh kai hanlah kânguenae lah na o teh,","poem":1},{"text":"tarannaw hmalah kacakpounge imrasang lah na o.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na rim dawk pou ka o han.","poem":1},{"text":"Na rathei hoi na ramuknae koe ka kângue han.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bangkongtetpawiteh Oe Cathut,","poem":1},{"text":"ka lawkkam hah na thai pouh haw.","poem":2},{"lineBreak":true},{"text":"Na min kabarinaw e râw hah kai na poe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Siangpahrang, hringyung na saw sak teh,","poem":1},{"text":"a kum hai se moikasaw kangning naseh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Cathut hmalah a yungyoe a kangning han.","poem":1},{"text":"Oe ahni roum sak nahanlah,","poem":2},{"lineBreak":true},{"text":"lungmanae hoi lawkkatang hah rakueng pouh haw.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ka lawkkam hah hnintangkuem ka kuep sak nahan","poem":1},{"text":"a yungyoe a min pholen hoi la ka sak han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}