{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["Ratoumnae hoi pholennae la"]},{"type":"hebrew_subtitle","content":["Kasakkung: Panuekhoeh"]},{"type":"verse","number":1,"content":[{"text":"Cathut ni na lungma awh teh,","poem":1},{"text":"yawhawi na poe awh naseh.","poem":2},{"lineBreak":true},{"text":"A minhmai angnae teh maimouh koe ang lawiseh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Talai van vah na lamthung pnue lah ao teh,","poem":1},{"text":"na rungngangnae teh miphun pueng koe panue lah awm lawiseh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oe Cathut, taminaw ni na pholen naseh.","poem":1},{"text":"Tami pueng ni na pholen naseh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Oe miphun pueng lunghawi laihoi la sak awh naseh.","poem":1},{"text":"Bangkongtetpawiteh, tami pueng hah kalanlah lawk a ceng teh,","poem":2},{"lineBreak":true},{"text":"talai van e miphunnaw hah na uk. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Oe Cathut, taminaw ni na pholen naseh.","poem":1},{"text":"Tami pueng ni na pholen naseh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hottelah, talai ni a pawhik hoehoe tâcawt sak vaiteh,","poem":1},{"text":"Cathut, maimae Cathut ni yawhawi na poe han.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Cathut ni yawhawi na poe vaiteh,","poem":1},{"text":"tami pueng ni a ma a taki awh han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}