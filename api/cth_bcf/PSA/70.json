{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["Katarankung koehoi hlout nahanlah ratoumnae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Devit"]},{"type":"verse","number":1,"content":[{"text":"Oe Cathut, kai rungngang hanlah karanglah kâroe haw.","poem":1},{"text":"Kai kabawp hanlah karanglah kâroe haw.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kai thei hanlah kakâcainaw teh","poem":1},{"text":"kayayeirai po laihoi awm awh naseh,","poem":2},{"lineBreak":true},{"text":"runae poe hanlah kakâcainaw heh","poem":2},{"lineBreak":true},{"text":"yawng awh naseh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vehveh, na katetsinnaw teh","poem":1},{"text":"kaya laihoi yawng awh naseh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nang na ka tawng pueng teh,","poem":1},{"text":"nang dawk lunghawi thahmeica lah awm awh naseh.","poem":2},{"lineBreak":true},{"text":"Na rungngangnae ka lungpataw naw ni pout laipalah,","poem":2},{"lineBreak":true},{"text":"Cathut teh pholen lah awm seh, telah tet awh naseh.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hatei, kai teh tami ka mathoe hoi ka voutthoup e lah ka o.","poem":1},{"text":"Oe, Cathut, karang na pâtam leih.","poem":2},{"lineBreak":true},{"text":"Nang teh ka rungngangkung hoi kabawmkung doeh.","poem":2},{"lineBreak":true},{"text":"Oe BAWIPA ngailawi awm hanh leih.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}