{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"heading","content":["Lawkcengnae koe Cathut lentoenae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Asaph"]},{"type":"verse","number":1,"content":[{"text":"Judah vah Cathut panue lah ao teh,","poem":1},{"text":"Isarel vah a min teh a lentoe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Salem haiyah lukkareiim ao teh,","poem":1},{"text":"Zion vah a onae hmuen ao.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hawvah, licung pala, tarantuknae,","poem":1},{"text":"bahling hoi tahloinaw hah","poem":2},{"lineBreak":true},{"text":"a khoe awh. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nang teh, tarantuknae monnaw hlak","poem":1},{"text":"na sungren teh na hawihnawn.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A tarankahawinaw lawp lah ao teh,","poem":1},{"text":"mat a i awh toe.","poem":2},{"lineBreak":true},{"text":"Tami a tha kaawm apinihai a kut dâw thai awh hoeh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oe Jakop Cathut, na yuenae dawk hoi","poem":1},{"text":"marang hoi ranglengnaw teh kadout e patetlah","poem":2},{"lineBreak":true},{"text":"koung a rawp awh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nang teh taki na tho doeh.","poem":1},{"text":"Na lungkhuek pawiteh, na hmalah","poem":2},{"lineBreak":true},{"text":"apimouh kangdout thai han.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Talai vah repcoungroe e naw rungngang teh","poem":1},{"text":"lawkceng hanelah Cathut a kangdue toteh,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Na lawkcengnae lawk hah kalvan hoi na patoun teh,","poem":1},{"text":"talai teh taki laihoi duem ao. Selah.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Taminaw e lungkhueknae ni na pholen roeroe han.","poem":1},{"text":"Ka cawi e lungkhueknae hai na keng dawk na kâyeng han.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"BAWIPA na Cathut koevah,","poem":1},{"text":"lawkkam awh nateh, kuep sak awh.","poem":2},{"lineBreak":true},{"text":"Atengpam kaawm e pueng ni,","poem":2},{"lineBreak":true},{"text":"taki hanelah kaawm e koevah, poehno hah poe awh.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ama ni lawkcengkungnaw e lung hah, a rahnoum sak han.","poem":1},{"text":"Talai siangpahrangnaw hanelah takikatho poung e lah ao.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}