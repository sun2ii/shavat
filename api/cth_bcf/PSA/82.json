{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["Lan nahanlah kâheinae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Asaph"]},{"type":"verse","number":1,"content":[{"text":"Cathut teh cathutnaw a kamkhuengnae koe a kangdue teh,","poem":1},{"text":"cathutnaw lawk a ceng.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nâtotouh ne kânging hoeh lah lawk na ceng awh vaiteh,","poem":1},{"text":"tamikathoutnaw hah na kapek awh han vai. Selah.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mathoe hoi naranaw hanlah lawkceng pouh nateh,","poem":1},{"text":"runae kâhmonaw hoi kavoutnaw hah","poem":2},{"lineBreak":true},{"text":"kânging lah lawkceng awh.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mathoe hoi kavoutnaw hah rasat awh nateh,","poem":1},{"text":"tamikathoutnaw kut dawk hoi tâcawt sak awh,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Panuek awh hoeh, thai panuek awh hoeh,","poem":1},{"text":"hmonae koe a kâva awh teh, talaidu pueng teh a kâhuet.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nangmouh teh cathutnaw doeh,","poem":1},{"text":"Lathueng Poung e canaw lah na o awh.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hatei, tami patetlah na due han,","poem":1},{"text":"bawi thung dawk e buet touh patetlah","poem":2},{"lineBreak":true},{"text":"na rawp awh han.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Oe Cathut thaw haw, talai heh lawkceng haw.","poem":1},{"text":"Bangkongtetpawiteh,","poem":2},{"lineBreak":true},{"text":"miphun pueng heh râw lah na pang han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}