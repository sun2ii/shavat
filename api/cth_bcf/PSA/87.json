{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"heading","content":["Cathut khopui bawilennae"]},{"type":"hebrew_subtitle","content":["Kathutkung: Korah capanaw"]},{"type":"verse","number":1,"content":[{"text":"Khopui teh mon ka thoung dawk a kangdue sak.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Jakop khosaknae pueng hlak hai BAWIPA ni","poem":1},{"text":"Zion longkha a lungpatawhnawn.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oe Cathut e khopui, na kong heh","poem":1},{"text":"ka sungren poung lah ouk a dei awh. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na kapanueknaw koe Rahab hoi","poem":1},{"text":"Babilon kong hah ka dei han.","poem":2},{"lineBreak":true},{"text":"Khenhaw! Oe Filistin hoi Taire, Ethiopia,","poem":2},{"lineBreak":true},{"text":"hetheh, haw hoi ka tâcawt e doeh ati awh han.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zion kong dawk hettelah a dei awh han.","poem":1},{"text":"Het hoi hot teh ama dawk hoi ka tâcawt e doeh.","poem":2},{"lineBreak":true},{"text":"Lathueng Poung ni a ma teh, a caksak telah ati awh han.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"BAWIPA ni tami pueng min a thut toteh,","poem":1},{"text":"hethateh, haw e ka tâcawt e doeh telah mitnout a ta awh han.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"La kasaknaw hoi tumkhawng kakhawngnaw ni,","poem":1},{"text":"tuiphuek pueng nang koe ao telah ati awh han.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}