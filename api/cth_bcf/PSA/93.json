{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"heading","content":["A yungyoe BAWIPA uknae"]},{"type":"hebrew_subtitle","content":["Kasakkung: panuekhoeh"]},{"type":"verse","number":1,"content":[{"text":"BAWIPA ni a uk, taluenae hoi a kamthoup.","poem":1},{"text":"BAWIPA kamthoupnae lah ao teh,","poem":2},{"lineBreak":true},{"text":"thaonae hah a keng dawk a kâyeng.","poem":2},{"lineBreak":true},{"text":"Talaivan heh a kâhuet thai hoeh nahanlah caksak lah ao.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Na bawitungkhung teh ayan hoi caksak lah ao teh,","poem":1},{"text":"nang teh a yungyoe hoi na o toe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oe BAWIPA, tuikalen a thaw,","poem":1},{"text":"tuikalen ni a cairing teh","poem":2},{"lineBreak":true},{"text":"tuikalen ni tuicapa a thaw sak.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"A rasangnae koe kaawm e BAWIPA teh,","poem":1},{"text":"tui moikapap pawlawk hoi,","poem":2},{"lineBreak":true},{"text":"talîpui tuicapa thaonae hlak hai a thaohnawn.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Na lawkpanuesaknae naw teh, a kamceng.","poem":1},{"text":"Oe BAWIPA, a yungyoe hoi na im teh","poem":2},{"lineBreak":true},{"text":"thoungnae hoi pathoup e lah ao.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}