{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"PSA","translationId":"cth_bcf","name":"SAM","commonName":"SAM","title":"SAM (The Book of Psalms)","order":19,"numberOfChapters":150,"sha256":"81f4c05fc961138ff8b1e043aa3357e536cc3f4f3fa909256453cd338b89f4a6","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/cth_bcf/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"heading","content":["A lawkcengnae hoi rungngangnae dawk BAWIPA pholennae la"]},{"type":"hebrew_subtitle","content":["Kasakkung: panuekhoeh"]},{"type":"verse","number":1,"content":[{"text":"Oe, BAWIPA koe la katha sak awh.","poem":1},{"text":"Bangkongtetpawiteh, kângairu hno hah a sak.","poem":2},{"lineBreak":true},{"text":"Aranglah a kut hoi kathoung e","poem":2},{"lineBreak":true},{"text":"kut ni tânae teh a pang toe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"BAWIPA ni a rungngangnae teh a kamnue sak toe.","poem":1},{"text":"A lannae teh miphun pueng koe a kamnue sak.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Isarel imthung koe a lungmanae hoi","poem":1},{"text":"yuemkamcu lah a onae hah pahnim hoeh.","poem":2},{"lineBreak":true},{"text":"Talai van pueng ni Cathut rungngangnae teh","poem":2},{"lineBreak":true},{"text":"hmu awh toe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Talai taminaw pueng BAWIPA pholen hoi,","poem":1},{"text":"konawm laihoi hram awh haw.","poem":2},{"lineBreak":true},{"text":"La sak laihoi lunghawi awh haw.","poem":2},{"lineBreak":true},{"text":"Pholen la hah sak awh haw.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ratoung hoi BAWIPA koe la sak awh.","poem":1},{"text":"Ratoung kueng lawk hoi pholennae","poem":2},{"lineBreak":true},{"text":"la kahawi hoi pholen awh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mongka hoi tuki hoi Siangpahrang BAWIPA hmalah,","poem":1},{"text":"lunghawicalah hoi hram awh haw.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Talî hoi a thung kaawm e pueng hoi,","poem":1},{"text":"talai hoi a thung kaawm e pueng ni","poem":2},{"lineBreak":true},{"text":"a lawk tâcawt sak awh.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Palangnaw ni a kuttabawng naseh.","poem":1},{"text":"Monnaw hai BAWIPA hmalah konawm naseh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bangkongtetpawiteh, talai lawkceng hanlah a tho.","poem":1},{"text":"Talaivan heh lannae hoi lawk a ceng vaiteh,","poem":2},{"lineBreak":true},{"text":"suetalah taminaw lawk a ceng han","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}