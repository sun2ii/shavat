{"translation":{"id":"cth_bcf","name":"Thai Phum Holy Bible","website":"https://ebible.org/Scriptures/details.php?id=cth","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cth","licenseNotes":null,"shortName":"BCF","englishName":"Thai Phum Bible","language":"cth","textDirection":"ltr","sha256":"74cc092761a9cdb76818c08b4666948cf899f3497ac9ac8c30ab40f972e3f935","availableFormats":["json"],"listOfBooksApiLink":"/api/cth_bcf/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31104,"languageName":"Thaiphum Chin","languageEnglishName":"Thaiphum Chin"},"book":{"id":"SNG","translationId":"cth_bcf","name":"SOLOMON LA","commonName":"SOLOMON LA","title":"SOLOMON LA","order":22,"numberOfChapters":8,"sha256":"feda4d3d42057c9fa695fc0fb57a7b33ca8b0fdefb4dcc88c5fbc12078bf6825","firstChapterNumber":1,"firstChapterApiLink":"/api/cth_bcf/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/cth_bcf/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Ka lungthung hoi ka pahren e hateh,","poem":1},{"text":"karum vah ka inae koehoi ka tawng.","poem":2},{"lineBreak":true},{"text":"Hateiteh ka hmawt hoeh.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Atu ka thaw teh khothung ka lawngven teh","poem":1},{"text":"lam tangkuem hoi tami a kamkhuengnae","poem":2},{"lineBreak":true},{"text":"hmuennaw koe ka lungthinthung hoi","poem":2},{"lineBreak":true},{"text":"ka pahren nang teh na tawng.","poem":2},{"lineBreak":true},{"text":"Hateiteh na hmawt hoeh.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Khoipui ka ring e ramvengnaw ni hai","poem":1},{"text":"na hmu awh.","poem":2},{"lineBreak":true},{"text":"Ahnimouh koe ka pahren hah","poem":2},{"lineBreak":true},{"text":"na hmu awh maw telah ka pacei.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ahnimouh koung tapoung hoi a ro hoehnahlan,","poem":1},{"text":"ka pahren e teh ka hmu.","poem":2},{"lineBreak":true},{"text":"Ahni hah ka kuet teh, ka khenae,","poem":2},{"lineBreak":true},{"text":"anu imthungkhu totouh ka hrawi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Oe Jerusalem canunaw ka pahren teh","poem":1},{"text":"amahmawk a kâhlaw hoeh roukrak","poem":2},{"lineBreak":true},{"text":"na pâhlaw awh hoeh nahanelah,","poem":2},{"lineBreak":true},{"text":"kahrawng e sayuk sakhinaw thoebo laihoi,","poem":2},{"lineBreak":true},{"text":"nangmouh teh lawk na thui awh.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Murah hoi frankinsen koehoi","poem":1},{"text":"hno kayawtnaw ni","poem":2},{"lineBreak":true},{"text":"a yo e hmuituinaw pueng hah,","poem":2},{"lineBreak":true},{"text":"hmaisawi toteh ka khu e hmaikhukhom patetlah","poem":2},{"lineBreak":true},{"text":"kahrawngum hoi ka tâcawt e teh api nama.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Khenhaw! Solomon kâkayawtnae doeh.","poem":1},{"text":"Isarel athakaawme taminaw,","poem":2},{"lineBreak":true},{"text":"athakaawme 60 touh hoi a tho.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hotnaw abuemlah teh tarantuk hanelah","poem":1},{"text":"tahloi ka patuem e tarankahawinaw doeh.","poem":2},{"lineBreak":true},{"text":"Karum lae atueng nah","poem":2},{"lineBreak":true},{"text":"puen hanelah ao dawkvah,","poem":2},{"lineBreak":true},{"text":"tami pueng ni tahloi coungkacoelah a neng awh.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Solomon siangpahrang ni","poem":1},{"text":"Lebanon thing hoi ama hanelah,","poem":2},{"lineBreak":true},{"text":"kâkayawtnae hah a sak.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Alungui e khomnaw hah, ngun hoi,","poem":1},{"text":"a rahim e naw hah sui hoi,","poem":2},{"lineBreak":true},{"text":"tahung nahane carawng hah","poem":2},{"lineBreak":true},{"text":"Opaou e hni hoi a sak.","poem":2},{"lineBreak":true},{"text":"Athung lae naw teh,","poem":2},{"lineBreak":true},{"text":"Jerusalem canunaw ni lungpatawnae hoi","poem":2},{"lineBreak":true},{"text":"a pathoup awh.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Zion canunaw kâpaluen e hnin hoi,","poem":1},{"text":"lungthin a nawmnae hnin nah,","poem":2},{"lineBreak":true},{"text":"a manu ni oupnae bawilakhung hah","poem":2},{"lineBreak":true},{"text":"kâmuk sak e Solomon siangpahrang hah","poem":2},{"lineBreak":true},{"text":"cet nateh khen awh.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cth_bcf/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cth_bcf/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cth_bcf/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}