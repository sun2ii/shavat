{"translation":{"id":"ctu_cti","name":"JINI WEN BΛ T'AN","website":"https://ebible.org/Scriptures/details.php?id=ctucti","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ctucti","licenseNotes":null,"shortName":"CTI","englishName":"Chol de Tila Bible","language":"ctu","textDirection":"ltr","sha256":"a3f51d4fa93347042bff26dcc08006466d9d572efbb22dfd9ce5e3c4243c31e7","availableFormats":["json"],"listOfBooksApiLink":"/api/ctu_cti/books.json","numberOfBooks":28,"totalNumberOfChapters":287,"totalNumberOfVerses":8359,"languageName":"Chol","languageEnglishName":"Chol"},"book":{"id":"PSA","translationId":"ctu_cti","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":27,"sha256":"d91b00fa0e82544ad9df1f8eb9b970681deeb1c48b593938c90a8a00818a0588","firstChapterNumber":1,"firstChapterApiLink":"/api/ctu_cti/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ctu_cti/PSA/150.json","totalNumberOfVerses":424},"chapter":{"number":100,"content":[{"type":"heading","content":["Yom mi lac suben Dios wocox i yʌlʌ"]},{"type":"verse","number":1,"content":[{"text":"Quixtyañujob ti pejtyelel mulawil, yom tijicña mi laꞌ chaꞌlen tꞌan cheꞌ mi lac tyaj ti tꞌan lac Yum.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chaꞌlibenla i troñel lac Yum tiꞌ tijicñʌyel laꞌ pusicꞌal.","poem":1},{"lineBreak":true},{"text":"Chaꞌlenla cꞌay cheꞌ mi laꞌ wochel tiꞌ tyojlel lac Yum.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ñaꞌtyanla Diosʌch jini lac Yum.","poem":1},{"lineBreak":true},{"text":"Jini tiꞌ meleyonla. I chaꞌañonla.","poem":1},{"lineBreak":true},{"text":"I quixtyañujonla. I tiñʌmeꞌonla muꞌ bʌ i cʌñʌtyan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ochenla tiꞌ tiꞌ tyac i yotyot lac Yum.","poem":1},{"lineBreak":true},{"text":"Subenla wocox i yʌlʌ.","poem":1},{"lineBreak":true},{"text":"Subenla i ñuclel cheꞌ mi laꞌ cꞌotyel tiꞌ pam i yotyot.","poem":1},{"lineBreak":true},{"text":"Subenla wocox i yʌlʌ. Subula ti ñuc i cꞌabaꞌ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Como ñoj wen lac Yum. Mi quej i yajñel i yutslel i pusicꞌal ti pejtyelel ora.","poem":1},{"lineBreak":true},{"text":"Mi quej i pʌsbeñob i xucꞌtyʌlel i pusicꞌal la calobilob, la quijob yicꞌot i yijob la quijob cꞌʌlʌ ti beleꞌ ora.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ctu_cti/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ctu_cti/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ctu_cti/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":5}