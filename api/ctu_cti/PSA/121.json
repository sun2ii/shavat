{"translation":{"id":"ctu_cti","name":"JINI WEN BΛ T'AN","website":"https://ebible.org/Scriptures/details.php?id=ctucti","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ctucti","licenseNotes":null,"shortName":"CTI","englishName":"Chol de Tila Bible","language":"ctu","textDirection":"ltr","sha256":"a3f51d4fa93347042bff26dcc08006466d9d572efbb22dfd9ce5e3c4243c31e7","availableFormats":["json"],"listOfBooksApiLink":"/api/ctu_cti/books.json","numberOfBooks":28,"totalNumberOfChapters":287,"totalNumberOfVerses":8359,"languageName":"Chol","languageEnglishName":"Chol"},"book":{"id":"PSA","translationId":"ctu_cti","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":27,"sha256":"d91b00fa0e82544ad9df1f8eb9b970681deeb1c48b593938c90a8a00818a0588","firstChapterNumber":1,"firstChapterApiLink":"/api/ctu_cti/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ctu_cti/PSA/150.json","totalNumberOfVerses":424},"chapter":{"number":121,"content":[{"type":"heading","content":["Lac Yum miꞌ cʌñʌtyañonla"]},{"type":"verse","number":1,"content":[{"text":"Mic letsan c wut chaꞌan mij qꞌuel wits. ¿Baqui tyʌlem j cotyʌntyel?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yaꞌ tyʌlem j cotyʌntyel ti lac Yum","poem":1},{"lineBreak":true},{"text":"Tsaꞌ bʌ i mele panchan yicꞌot mulawil.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mi quej i wen cʌñʌtyañonla ame tyʌjtsꞌic la coc.","poem":1},{"lineBreak":true},{"text":"Mach yujil wʌyel jini muꞌ bʌ i cʌñʌtyañonla.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Awilan, machꞌan miꞌ poj chaꞌlen wʌyel jini muꞌ bʌ i cʌñʌtyan Israel. Mach yujil wʌyel.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lac Yum jiñʌch ajcʌñʌtya a chaꞌan.","poem":1},{"lineBreak":true},{"text":"Lac Yum cheꞌ bajcheꞌ axñal chaꞌan miꞌ moset.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Jini qꞌuin maꞌan mi quej i pulet ti qꞌuinil,","poem":1},{"lineBreak":true},{"text":"Mi añic chʌ bʌ mi tyumbiñet uw ti acꞌbʌlel.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Lac Yum mi quej i cʌñʌtyañet ti pejtyelel a wocol chaꞌan maꞌ loqꞌuel ti wen.","poem":1},{"lineBreak":true},{"text":"Mi quej i cʌñʌtyan a cuxtyʌlel.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lac Yum mi quej i cʌñʌtyañet cheꞌ maꞌ loqꞌuel majlel, cheꞌ maꞌ sujtyel tyʌlel.","poem":1},{"lineBreak":true},{"text":"Mi quej i cʌñʌtyañet wale yicꞌot ti pejtyelel ora.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ctu_cti/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ctu_cti/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ctu_cti/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":8}