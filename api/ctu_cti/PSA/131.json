{"translation":{"id":"ctu_cti","name":"JINI WEN BΛ T'AN","website":"https://ebible.org/Scriptures/details.php?id=ctucti","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ctucti","licenseNotes":null,"shortName":"CTI","englishName":"Chol de Tila Bible","language":"ctu","textDirection":"ltr","sha256":"a3f51d4fa93347042bff26dcc08006466d9d572efbb22dfd9ce5e3c4243c31e7","availableFormats":["json"],"listOfBooksApiLink":"/api/ctu_cti/books.json","numberOfBooks":28,"totalNumberOfChapters":287,"totalNumberOfVerses":8359,"languageName":"Chol","languageEnglishName":"Chol"},"book":{"id":"PSA","translationId":"ctu_cti","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":27,"sha256":"d91b00fa0e82544ad9df1f8eb9b970681deeb1c48b593938c90a8a00818a0588","firstChapterNumber":1,"firstChapterApiLink":"/api/ctu_cti/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ctu_cti/PSA/150.json","totalNumberOfVerses":424},"chapter":{"number":131,"content":[{"type":"heading","content":["Bajcheꞌ yom mi lac peqꞌuisan lac bʌ"]},{"type":"verse","number":1,"content":[{"text":"C Yum, machꞌan mic chan isan c bʌ.","poem":1},{"lineBreak":true},{"text":"Machꞌan mij qꞌuel c bʌ ti ñuc.","poem":1},{"lineBreak":true},{"text":"Machꞌan mic chaꞌlen pensal chaꞌan jini ñuc tyac bʌ","poem":1},{"lineBreak":true},{"text":"Am bʌ ti a wenta, machꞌʌ baꞌan mic chꞌʌmben i sujmlel.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pero tsaꞌix c ñʌchꞌchoco c pusicꞌal ti jatyet.","poem":1},{"lineBreak":true},{"text":"Tijicñayoñix cheꞌ bajcheꞌ alʌl mach bʌ bej yomox i chuꞌ.","poem":1},{"lineBreak":true},{"text":"Ñʌchꞌʌlix c pusicꞌal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Israel, chʌꞌʌch yom maꞌ pijtyan lac Yum wale iliyi yicꞌot ti beleꞌ ora.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ctu_cti/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ctu_cti/PSA/135.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ctu_cti/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":3}