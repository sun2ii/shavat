{"translation":{"id":"ctu_cti","name":"JINI WEN BΛ T'AN","website":"https://ebible.org/Scriptures/details.php?id=ctucti","licenseUrl":"https://ebible.org/Scriptures/details.php?id=ctucti","licenseNotes":null,"shortName":"CTI","englishName":"Chol de Tila Bible","language":"ctu","textDirection":"ltr","sha256":"a3f51d4fa93347042bff26dcc08006466d9d572efbb22dfd9ce5e3c4243c31e7","availableFormats":["json"],"listOfBooksApiLink":"/api/ctu_cti/books.json","numberOfBooks":28,"totalNumberOfChapters":287,"totalNumberOfVerses":8359,"languageName":"Chol","languageEnglishName":"Chol"},"book":{"id":"PSA","translationId":"ctu_cti","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":27,"sha256":"d91b00fa0e82544ad9df1f8eb9b970681deeb1c48b593938c90a8a00818a0588","firstChapterNumber":1,"firstChapterApiLink":"/api/ctu_cti/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/ctu_cti/PSA/150.json","totalNumberOfVerses":424},"chapter":{"number":23,"content":[{"type":"heading","content":["Cheꞌ bajcheꞌ ajcʌñʌtya tiñʌmeꞌ lac Yum"]},{"type":"verse","number":1,"content":[{"text":"Lac Yum miꞌ cʌñʌtyañon cheꞌ bajcheꞌ ajcʌñʌtya tiñʌmeꞌ.","poem":1},{"lineBreak":true},{"text":"Machꞌan chʌ bʌ tyo yom c chaꞌan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mi yʌcꞌon baꞌ mij cꞌaj coj ti wen bʌ jamil.","poem":1},{"lineBreak":true},{"text":"Miꞌ pʌyon majlel baꞌ sʌmʌcña bʌ jaꞌ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Miꞌ chaꞌ xucꞌchocobeñon c pusicꞌal.","poem":1},{"lineBreak":true},{"text":"Miꞌ pʌyon majlel ti tyoj tyac bʌ bij chaꞌan mi ñuc isʌntyel i cꞌabaꞌ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Cheꞌ mic ñumel ti icꞌtꞌojñal bʌ yebal jajp wits baꞌ bʌbʌqꞌuen mic sajtyel","poem":1},{"lineBreak":true},{"text":"Maꞌan chʌ bʌ mic bʌcꞌñan como wʌꞌ añet quicꞌot.","poem":1},{"lineBreak":true},{"text":"Maꞌ cʌñʌtyañon ti a bara yicꞌot locol bʌ a tyeꞌ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Maꞌ chajpʌbeñon i bʌl c ñʌcꞌ tiꞌ tyojel j contrajob.","poem":1},{"lineBreak":true},{"text":"Mi ñumel loqꞌuel i bʌl c taza.","poem":1},{"lineBreak":true},{"text":"Maꞌ mulbeñon c jol ti aceite chaꞌan i señʌjlel ti jumpꞌej a pusicꞌal maꞌ pʌyon ochel ti a wotyot","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Melel, machꞌan mi quej a cʌy a pꞌuntyañon.","poem":1},{"lineBreak":true},{"text":"Mux a bej pꞌuntyañon ti beleꞌ ora cheꞌ cuxulon tyo.","poem":1},{"lineBreak":true},{"text":"Yaꞌ ti a wotyot, c Yum, mi quejel c chumtyʌl ti beleꞌ ora.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/ctu_cti/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/ctu_cti/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/ctu_cti/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}