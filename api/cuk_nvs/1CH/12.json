{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":12,"content":[{"type":"heading","content":["Sordamar Davidʼba-nagusmalad"]},{"type":"verse","number":1,"content":["We-sordamar David-bendakegala, Siclag-neggweburse nonimalad. Deunni, David, Quis-machi-Saúl-idu wakindigu, we-sordamar, bila-onogedgi David-bendaksa gusmalad."]},{"type":"verse","number":2,"content":["We-sordamar sigu-mimalad-buleganad, degine, dubgi akwa-mimalad-buleganbalid. We-ibmar-ebugegala, argan-abinbela ebumalad. Saúl-e-gwenadgan Davidʼba nagusmalad",{"text":"Benjamín-wagan-Saúl-e-gwenadgan David-bendaksa-gusmalad, wemalad:","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Saúl-e-gwenadgan-e-dummad-Ahiezer,","poem":2},{"lineBreak":true},{"text":"degi, Joás Ahiezer-sorbalid.","poem":2},{"text":"Amala, Semaa-e-masmalad, Gabaad-dule gumalad.","poem":3},{"text":"Jeziel, Peletʼbogwa, Azmavet-e-masmala.","poem":2},{"lineBreak":true},{"text":"Beraca, Anatot-dule-Jehú.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Degi, Gabaónʼgined-Ismaías,","poem":2},{"text":"Ismaíasʼde, sordamar dulagwen-gakambegwadmogad (30),","poem":3},{"lineBreak":true},{"text":"deginbali, a-sordamar-e-dummadbalid.","poem":3},{"text":"Jeremías, Jahaziel, Johanán, Gedera-dule-Jozabad.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Eluzai, Jerimot, Bealías, Semarías, degi, Haruf-dule-Sefatías.","poem":2},"Coré-gwenadgan Davidʼba nagusmalad",{"text":"Coré-e-gwenadgan, wemalad:","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Elcana, Isías, Azareel, Joezer, degi, Jasobeam.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Deginbali, Jeroham-e-masmala, wemalad:","poem":1},{"text":"Joela, degi, Zebadías.","poem":2},{"text":"Wemar-ebogwad Gedorʼginmaladid.","poem":3}]},{"type":"heading","content":["Gad-wagan Davidʼba nagusmalad"]},{"type":"verse","number":8,"content":["Gad-wagan-bila-onomalad nega-dulesulidganba-neg-gandik-siidse, David-maidse wakite-gusmarmogad. We-dulemar, dule-niga-gandikmaladid, dule-bila-onomalad-buleganad. Deginbali, we-dulemar, sigu-abgaed-ebuged nue-wisimaladid, degi, eswargi-nue-wisi bila-onomaladid. Achumiguryob urwemaladid, degi, goe-sapur-abarmakeyob gwae-gwae abarmakmaladid."]},{"type":"verse","number":9,"content":[{"text":"A-dulemar, wemalad:","poem":1},{"text":"Ezer, bur-dummadid, Ezer-yarbalid, Obadías,","poem":2},{"lineBreak":true},{"text":"Obadías-yarbalid, Eliab,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Eliab-yarbalid, Mismana,","poem":2},{"lineBreak":true},{"text":"Mismana-yarbalid, Jeremías,","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jeremías-yarbalid, Atai,","poem":2},{"lineBreak":true},{"text":"Atai-yarbalid, Eliel,","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Eliel-yarbalid, Johanán,","poem":2},{"lineBreak":true},{"text":"Johanán-yarbalid, Elzabad,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Elzabad-yarbalid, Jeremías,","poem":2},{"lineBreak":true},{"text":"degi, Jeremías-yarbalid, Macbanai.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wemar, Gad-sorda-bila-onomalad-e-dummaganad.","poem":3},"Dummad-napi-sorbalid, sorda-dulatar-mergued (100) idudiid. Sorda-bur-dummaddi, sorda-miligwen-mergued (1,000) idudimogad."]},{"type":"verse","number":15,"content":["We-dummaganmar, gebe-nii-gwisgusadgi, Jordán-diwar-nomaigu, Jordán-diwar-obaksa-gusmaladid. We-dulemala, dulemar-nebagi-bukwamalad dad-nakwedsik, degi, dad-argwanedsik-oduurmakega imaksamaladid."]},{"type":"heading","content":["Benjamín-wagan, degi, Judá-wagan Davidʼba nagusmalad"]},{"type":"verse","number":16,"content":["Amba David neg-gandikidgi gudigua, Benjamín-wagan, degi, Judá-wagan-gwenna-gwenna David-maidse nade gusmarmogad."]},{"type":"verse","number":17,"content":["Degi, David amar-abin-nodgu, ega sogded: —Be anse nuedgi danimalale, be an-bendakega danimalale, an bemar-abingaodo. Ar bemar, an-isdarmaladga an-ukega be danimalale, anmar-dadgan-e-Bab-Dummad bemar-sabsur-odurdako. Ar an emar akar-imaksasulid, an dule-isganasulid."]},{"type":"verse","number":18,"content":["Degidgi, Bab-Dummad-Burba Amasaiʼgi aidenonikid. Geb Amasai, sorda-durgwen-gakambe-e-dummad (30) weyob sogded:",{"text":"“¡David, anmar be-sordamalad!","poem":1},{"text":"¡Isaí-machi, anmar beba-naimalad!","poem":2},{"text":"Neg-bogidik bega nagusana gadin.","poem":1},{"text":"Be-bendakmaladgala, neg-bogidik nagusmogana gadin.","poem":2},{"text":"Ar be-Bab-Dummad be-bendakdiid.”","poem":1},"David, Benjamín-wagan, degi, Judá-wagan-ese-nonimalad abingasad, geb sorda-idumaladba a-dulemar-urbisbalid."]},{"type":"heading","content":["Manasés-wagan Davidʼba nagusmalad"]},{"type":"verse","number":19,"content":["Manasés-wagan-gwenna-gwenna, David Filistea-sordamarba Saúlʼgi bila-ononadgusgu, Davidʼba nagusmarmogad. (Deunni, David, Filistea-sordamar-bendaksasurgusad, ar Filistea-e-dummagan igar-itosmargua, sogde gusmalad: “Ar David anmar-oburgwega gunaid, wede anmar-nono-egwannega gunaid. E-dummad-Saúlʼba gannar nagudoed, anmargi aibitoed.”)"]},{"type":"verse","number":20,"content":["Degisoggu, David Siclagʼse nonigua,",{"text":"Manasés-dulemar ese-nonimaladi, wemalad:","poem":1},{"text":"Adnas, Jozabad, Jediael,","poem":2},{"lineBreak":true},{"text":"Micael, Jozabad, Eliú, degi, Ziletai.","poem":2},{"text":"Wemar, Manasés-sordamar milibarmalad (1,000) e-dummaganad.","poem":3}]},{"type":"verse","number":21,"content":["We-sorda-dummagan, dule-gandikmaladid, degi, sorda-bila-onomalad-idumaladga gusmarbalidid. We-dulemar, dule-ibmar-atursaega-yogasaar-ubononidamaladgi David-bendaksa gusmalad."]},{"type":"verse","number":22,"content":["Degi, Davidʼga bane-bane sordamar mergumai gusad. Degisoggu, David, bela-bela sorda-ibedga gunonikid."]},{"type":"heading","content":["Hebrónʼgi sordamar Davidʼba-nagusmalad"]},{"type":"verse","number":23,"content":["Sordamar-bila-onomalad-bulegan, Bab-Jehová sogsa gusadba Davidʼga Saúl-yar-semaid-ukegala Hebrón-neggweburse nonigusmalad."]},{"type":"verse","number":24,"content":["Bila-onomalad-bulegan, eswar-gani-bila-onomalad, degi, sigu-abgaed-gani-bila-onomalad. A-sordagan weyob-mergu nonigusmalad:",{"text":"Judá-dulemar-merguedi:","poem":1},{"text":"Milinergwa gaka dulataled-ilabaabak (6,800) mergued.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Simeón-sordamar gandik-bila-onomalad merguedi:","poem":1},{"text":"Dule-miligugle gaka dulatar (7,100) mergued.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Levita-dulemar-merguedi:","poem":1},{"text":"Milibake gaka dulataled-ilanergwa (4,600) mergued.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Aarón-e-wagan-merguedi:","poem":1},{"text":"Milipaa gaka dulataled-ilagugle (3,700) mergued.","poem":2},{"text":"Joiadaʼdi, Aarón-e-wagan-dummadga maid.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Sadoc, sapingwa-gandikid-buledid, e-gwenadgan-dummagan,","poem":1},{"text":"e-dulagwen-gakabo (22) eba nanaid.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Benjamín-wagan-Saúl-e-gwenadgan-merguedi:","poem":1},{"text":"Milipaa (3,000) mergued.","poem":2},{"text":"A-ibaganse we-dulemar bukidar Saúlʼba nanaimalanad.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Efraín-dulemar-merguedi:","poem":1},{"text":"Mili-dulagwen gaka dulataled-ilabaabak (20,800) mergued.","poem":2},{"text":"Amar, dule-gandikmalad-nanaed,","poem":3},{"lineBreak":true},{"text":"degine, e-babganba nug-nika danimalad.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Manasés-wagan-negabalad-merguedi:","poem":1},{"text":"Miliambe-gakabaabak (18,000) mergued.","poem":2},{"text":"Wemar-nuggusmaladi, reyga David-nug-imakega nugsalesmalad.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Isacar-dulemar-merguedi:","poem":1},{"text":"E-dummagan dulataled-ilabo-mergu (200) bukwad.","poem":2},{"text":"We-dulemar, ibagangi nerguarmaladid.","poem":1},{"text":"We-dulemar wisdamalad, igi Israel-dulemar bila-onogedgi urwemalargebe.","poem":2},{"lineBreak":true},{"text":"Degisoggu, wemar-sogedba e-gwenadgan ibmar-imakdamalad.","poem":2}]},{"type":"verse","number":33,"content":["Zabulón-dulemar, sordamar-bila-onogedgi-durdakarmaladid, e-gingimar-akar-akar-ebumarbalidid, degi, Davidʼba nue-nanaimarbalidid.",{"text":"Zabulón-dulemar, David-bendakega guakwaa bila-onogega-gudimaladi:","poem":1},{"text":"Mili-dulabo-gakambe (50,000) mergued.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Neftalí-dulemar-merguedi:","poem":1},{"text":"E-dummagan miligwen (1,000) mergued.","poem":2},{"text":"Deginbali, sordamar-sigu-abgaed-semalad, degi, eswar-semalad:","poem":1},{"text":"Mili-dulagwen-gakambe-gakagugle (37,000) mergubalid.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Dan-dulemar guakwaa bila-onogega-gudimaladi:","poem":1},{"text":"Mili-dulagwen-gakabaabak gaka dulataled-ilanergwa (28,600) mergued.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Aser-dulemar guakwa-bila-onogega-durdakar-bukwamaladi:","poem":1},{"text":"Mili-dulabo (40,000) mergued.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Degi, Jordán-diwar-obakar sordamar-bukwadi, wemalad:","poem":1},{"text":"Rubén-dulemar, Gad-dulemar, Manasés-dulemar-negabalad.","poem":2},{"text":"Amar weyob mergued:","poem":1},{"text":"Mili-dulanergwa (120,000) mergumalad.","poem":2},{"text":"Degi, wemar, ibmar-bila-onolegedgi-ebulemalad bela-nika bukwamalad.","poem":3}]},{"type":"verse","number":38,"content":["Bela we-sordamar, bila-onogega gudimaladid. Wemar, Hebrón-neggweburse, Israel-yargi reyga David-onugsaega nadgusmaladid."]},{"type":"verse","number":39,"content":["Degi, ar na e-gwenadgan-ega-ibmar-uksadba David-walik ibapaa gobbukwagusmalad, degi, mas-gunbukwagusmalad."]},{"type":"verse","number":40,"content":["Degine, e-neg-dikarba-neggweburmar-bukwamalad, ibmar-bukidar Davidʼga senonimalad. Deginbali, Isacar-dulemar, Zabulón-dulemar, Neftalí-dulemar, amarse-bakar, ega ibmar-bukidar senonimarmogad.",{"text":"Davidʼga ibmar-gullemalad we-ibdurgangi ena-ena senonimalad:","poem":1},{"text":"Moli-uayasuidmargi, moli-yargan-muregedmargi,","poem":2},{"lineBreak":true},{"text":"moli-uaya-senigwadmargi,","poem":2},{"lineBreak":true},{"text":"moli-bebe-nikad-alugwasualedmargi ibmarmar senonimalad.","poem":2},{"text":"We-ibmar Davidʼga senonimalad:","poem":1},{"text":"Madubur, higuera-e-san, uva-dinnagana,","poem":2},{"lineBreak":true},{"text":"vino, olivo-gwallu.","poem":2},{"lineBreak":true},{"text":"Deginbali, Davidʼga moli-bebe-nikamalad,","poem":2},{"lineBreak":true},{"text":"degi, sibad-wawaadmar-bukidar senonimarbalid.","poem":2},{"text":"Ar Israel-yargi neg-weligwar-naidbali, Davidʼga deyob ibmar-gullemalad senonimalad.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1CH/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1CH/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1CH/11.json","previousChapterAudioLinks":{},"numberOfVerses":40}