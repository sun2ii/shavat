{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":15,"content":[{"type":"heading","content":["David, Jerusalénʼse Bab-Jehová-Ulu sesad"]},{"type":"verse","number":1,"content":["David, e-neggweburgi na e-negmar sobsad. Deginbali, Bab-dummad-dadganbo-Igar-Mesisad-Ulu-sigega dordoneg sobsabalid."]},{"type":"verse","number":2,"content":["Degidgi, David sogded: “Bab-Dummad-Dadganbo-Igar-Mesisad-Ulu yogasaar seledosulid. Levita-dulemar, Bab-Dummad-Ulu semaloed. Ar Bab-Jehová, e-Ulu-semalaga, degi, ega degisadegu arbadii gumarbaliga, a-dulemar-nug-imaksa gusad.”"]},{"type":"verse","number":3,"content":["Geb David, Bab-Jehová-Ulu na neg-sobsadse sedmalaga, bela Jerusalénʼgi Israel-dulemar-oambikusad."]},{"type":"verse","number":4,"content":["Deginbali, David, Aarón-wagan-oambikusbalid, degi, Levita-dulemar-oambikusbalid."]},{"type":"verse","number":5,"content":[{"text":"Levita-dulemar Coat-wagansik-sulesmalad, wemalad:","poem":1},{"text":"Uriel e-gwenadgan-e-dummad,","poem":2},{"lineBreak":true},{"text":"degi, e-gwenadgan, dulanergwa (120) mergued.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Merari-wagansiki:","poem":1},{"text":"Asaías e-gwenadgan-e-dummad,","poem":2},{"lineBreak":true},{"text":"degi, e-gwenadgan, dulataled-ilabo gaka dulagwen (220) mergued.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gersón-wagansiki:","poem":1},{"text":"Joel e-gwenadgan-e-dummad,","poem":2},{"lineBreak":true},{"text":"degi, e-gwenadgan, dulanergwa-gakambe (130) mergued.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Elizafán-e-wagansiki:","poem":1},{"text":"Semaías e-gwenadgan-e-dummad,","poem":2},{"lineBreak":true},{"text":"degi, e-gwenadgan, dulataled-ilabo (200) mergued.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hebrón-e-wagansiki:","poem":1},{"text":"Eliel e-gwenadgan-e-dummad,","poem":2},{"lineBreak":true},{"text":"degi, e-gwenadgan, dulabake (80) mergued.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uziel-e-wagansiki:","poem":1},{"text":"Aminadab e-gwenadgan-e-dummad,","poem":2},{"lineBreak":true},{"text":"degi, e-gwenadgan, dulatar-gakambe-gakabo (112) mergued.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Geb degine, David, dule-irwa-Bab-Dummadse-gormaladse gochabalid:","poem":1},{"text":"Sadocʼse, Abiatarʼse.","poem":2},{"lineBreak":true},{"text":"Degi, Levita-dulemarse gochabalid:","poem":2},{"lineBreak":true},{"text":"Urielʼse, Asaíasʼse,","poem":2},{"lineBreak":true},{"text":"Joelʼse, Semaíasʼse,","poem":2},{"lineBreak":true},{"text":"Elielʼse, degi, Aminadabʼse.","poem":2}]},{"type":"verse","number":12,"content":["Geb, David, amarga sogded: “Ar bemar Levita-dulemar-e-gwenadgan-e-gwenadgan-e-dummagansoggu, bemar na be san swilidik imakmar, degi, be-gwenadgan deyob imakmarmogo. Adi, bemar, Israel-e-Bab-Dummad-Jehová-Ulu, an ega dordoneg-guakwa-imaksadse nabir sedmalagar."]},{"type":"verse","number":13,"content":["Gebe-iduale, ar bemar, we-Ulu searsur gusad. Ar ade, anmar igar-maidba anmar-Bab-Dummad-Jehováʼse idaksasulid. Agala, Bab-Dummad, sabsur-anmargi yolesad.”"]},{"type":"verse","number":14,"content":["Degisoggu, dule-irwa-Bab-Dummadse-gormalad, degi, Levita-dulemarmala, na san swilidik imaksamarsunnad, adi, Israel-e-Bab-Dummad-Jehová-Ulu nabir sedamalagar."]},{"type":"verse","number":15,"content":["Degine, Bab-Jehová-Moisésʼga-Igar-Uksagusadba guegala, Levita-dulemar, Bab-Dummad-Igar-Mesisad-Ulu e-gukingi e-suargi-nai searmarsunnad."]},{"type":"verse","number":16,"content":["David, Levita-dummaganga sogsabalid: “Be-gwenadgan-abargi dule-namakmalad-amimaloye.",{"text":"Wemar weligwaledba we-garmar-ogorbukwa namakmalagar:","poem":1},{"text":"Gar-salterioʼmar, gar-arpaʼmar,","poem":2},{"lineBreak":true},{"text":"degi, gar-címbaloʼmar.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Degisoggu, Levita-dulemar we-dulemar-onug-imaksamalad:","poem":1},{"text":"Joel-machi-Hemán.","poem":2},{"lineBreak":true},{"text":"Degi, Berequías-machi-Asaf e-gwenadgan-abargi onugsasmarbalid.","poem":2},{"text":"Degi, Merari-wagansikdi,","poem":1},{"text":"Cusaías-machi-Etán onugsasmarbalid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"We-warbaagwadmarba, e-gwenadgan-sorbarmalad onugsasmarbalid:","poem":1},{"text":"Zacarías, Jaaziel, Semiramot, Jehiel,","poem":2},{"lineBreak":true},{"text":"Uni, Eliab, Benaía, Maasías,","poem":2},{"lineBreak":true},{"text":"Matatías, Elifelehu, degi, Micnías.","poem":2},{"text":"Deginbali, yawagak-dakmalad onugsasmarbalid:","poem":1},{"text":"Obed-Edom, Jeiel.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dulemar-gar-esgoro-gordikid-címbaloʼye-nugad-ogormalad onugsasmarbalid:","poem":1},{"text":"Hemán, Asaf, degi, Etán.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dulemar-gar-salterio-Alamotʼye-nugad-ogormalad, wemalad:","poem":1},{"text":"Zacarías, Aziel, Semiramot, Jehiel,","poem":2},{"lineBreak":true},{"text":"Uni, Eliab, Maasías, degi, Benaía.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Deginbali, gar-arpaʼmar-e-dub-gabaabak-nikad (8) binnalee-ogormalad, degi, namakedgi-emar-idumalad, wemalad:","poem":1},{"text":"Matatías, Elifelehu, Micnías, Obed-Edom,","poem":2},{"lineBreak":true},{"text":"Jeiel, degi, Azazías.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Degi, Levita-dulemar-e-dummad-Quenanías, dule-namakedgi-nergualedsoggu, dule-namakmalad-e-dummadga nugsalesad.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Dordoneggi Bab-Dummad-Dadganbo-Igar-Mesisad-Ulu-siidgi-nakulemaladi, wemalad:","poem":1},{"text":"Berequías, degi, Elcana.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dule-irwa-Bab-Dummadse-gormalad, Bab-Jehová-Ulu-walik gar-trompeta-ogormaladi, wemalad:","poem":1},{"text":"Sebanías, Josafat, Natanael, Amasai,","poem":2},{"lineBreak":true},{"text":"Zacarías, Benaía, degi, Eliezer.","poem":2},{"text":"Dordoneggi Bab-Jehová-Ulu-siidgi nakulemarmogadi, wemarmogad:","poem":1},{"text":"Obed-Edom, degi, Jehías.","poem":2}]},{"type":"verse","number":25,"content":["Degisoggu, David, Israel-girmar-dummaganmala, degi, sorda-miliba (1,000) e-dummaganga-gudimaladmala, Bab-Jehová-Dadganbo-Igar-Mesisad-Ulu-sunaega, weligwaledbali Obed-Edom-negse nadegusmalad."]},{"type":"verse","number":26,"content":["Ar Bab-Dummad Levita-dulemar-bendaksasoggu, Bab-Jehová-Igar-Mesisad-Ulu-semamaigu, Bab-Jehováʼga moli-bebe-nikad-machergan-walagugle (7) ogumakar uksamalad, degi, sibad-wawaad-machergan-walagugle (7) ogumakar uksamarbalid."]},{"type":"verse","number":27,"content":["Abali, David lino-mor-nued-yoi naded. Deyobi, Levita-dulemar lino-mor-yoyoimoga Bab-Dummad-Ulu-semamai guarmalad. Degi, dule-namakmalad, deyob lino-mor-yoyoimarmogad. Quenanías namakmalad-e-dummad, lino-mor-nued-yoi nadmogad. Davidʼdina, lino-mor-efodʼye-nugad yoibalid."]},{"type":"verse","number":28,"content":["Weyob bela Israel-dulemar, Bab-Jehová-Ulu-senadapi guarmalad.",{"text":"Doggus-weligwaledba we-garmar-ogornadapi gusmalad:","poem":1},{"text":"Gar-bocinaʼmar, gar-trompetaʼmar,","poem":2},{"lineBreak":true},{"text":"gar-címbaloʼmar, gar-salterioʼmar,","poem":2},{"lineBreak":true},{"text":"degi, gar-arpaʼmar ogornadapi gusmalad.","poem":2}]},{"type":"verse","number":29,"content":["Geb Bab-Jehová-Dadganbo-Igar-Mesisad-Ulu David-neggweburse-mosgua, Saúl-e-sisgwa-Mical, yawagak-bipigwadba atakded. Agine, Mical, Rey-David weligwaledgi gwirdaniki dakdegua, e-gwagegi David-saedakalid."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1CH/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1CH/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1CH/14.json","previousChapterAudioLinks":{},"numberOfVerses":29}