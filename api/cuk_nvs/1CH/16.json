{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["Deyob, Bab-Dummad-Dadganbo-Igar-Mesisad-Ulu selear gusad. Geb David-dordoneg-ega-sobsadgi sinonimalad. Agine, Bab-Dummadga ibmar-durgan ogumakar uksamalad, degi, gwenatigwar-guega Bab-Dummadga ibmar uksamarbalid."]},{"type":"verse","number":2,"content":["David, Bab-Dummadga ibmar-durgan-ogumakar uksad-sorba, degi, gwenatigwar-guega Bab-Dummadga ibmar uksad-sorba, David, dulemarga, Bab-Jehová-nuggi nued-ibmar-gusana yeerbanye sognai gualid."]},{"type":"verse","number":3,"content":["Degi, David, bela Israel-machergan-iliba, degi, omegan-iliba madu-ologana ega uksad, degi, dátil-dinnagana annugwen ega uksabalid, degi, uva-dinnagana annugwen ega uksabalid."]},{"type":"verse","number":4,"content":["David, Bab-Jehová-Ulu-walik-arbamalagar Levita-dulemar-abar onug-imaksad. Adi, Israel-e-Bab-Dummad-Jehováʼse-gormalaga, degi, ega dog-nuedye-sogega, degi, Bab-Jehová-e-nug-odummomalaga.",{"text":"Wemar-onug-imaksad:","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Asaf, e-dummadid. Zacarías, e-yarbalidid,","poem":2},{"lineBreak":true},{"text":"Jeiel, Semiramot, Jehiel, Matatías,","poem":2},{"lineBreak":true},{"text":"Eliab, Benaía, Obed-Edom, degi, Jeiel.","poem":2},{"text":"Wemar, gar-salterio, degi, gar-arpa ogordamalad.","poem":3},{"lineBreak":true},{"text":"Asafʼdi, gar-címbalo ogoledid.","poem":3}]},{"type":"verse","number":6,"content":["Deginbali, dule-irwa-Bab-Dummadse-gormalad, Benaía, degi, Jahaziel, Bab-Dummad-Dadganbo-Igar-Mesisad-Ulu-asabin gusgu gar-trompeta-ogornai damalad."]},{"type":"heading","content":["David Bab-Dummadga namaked"]},{"type":"verse","number":7,"content":["A-ibagi, David Asafʼga, degi, Asaf-e-gwenadganga gebe igar-uknonikid, adi, Bab-Jehováʼga we-namakedgi namakmalagar:"]},{"type":"verse","number":8,"content":[{"text":"“¡Bab-Jehováʼga dog-nuedye be sogmala!","poem":1},{"text":"¡E-nuggi Bab-Dummadse be gormala!","poem":2},{"text":"Bab-Dummad-ibmar-imaksadgi, dule-yar-baid-baidgi-bukwamaladga be sunmakmala.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"¡Bab-Jehováʼga namakmala!","poem":2},{"text":"Namaklegedgi e-nug-odummomala.","poem":1},{"text":"¡Ega namakmala!","poem":2},{"lineBreak":true},{"text":"”¡Bab-Jehová-ibmar-dummagan-imakmaidgi","poem":1},{"text":"be sunmakmala!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”¡E-nug-isligwaledgi wergumala!","poem":1},{"text":"Dule-Bab-Jehová-e-nug-odummodimalad, ulubgi wergumala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová-Gandik-Maidse be dagmala.","poem":1},{"text":"Bane-bane ese be gordii gumalo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová-ibmar-dummagan-imaksadgi be binsamalo.","poem":1},{"text":"E-ibmar-gegerdakleged-imaksadgi, degi, igarmar-inniki-mesisadgi be binsamarbalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Bemar, Bab-Jehová-e-mai-Israel-e-wagan gumalad.","poem":1},{"text":"Jacob-wagan, Bab-Dummad na bemar-susadid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bab-Jehová, anmar-Bab-Dummad gued.","poem":1},{"text":"Bela e-sogedba napneggi igar-inniki semaid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"E-igar-degisadegu-na-mesisadi, iemaisulid.","poem":1},{"text":"Degi, amba wagan mili-miligwen-nasale (1,000-1,000),","poem":2},{"lineBreak":true},{"text":"na ibmar-imakoye-sogsadi, gwen iegosulid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Deginbali, Bab-Jehová Abrahamʼbo-igar-mesisadi,","poem":1},{"text":"Isaacʼga ise-sogar-igar-mesisadi, iemaisulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Deginbali, Jacobʼga-igarmar-mesisadi, bargindinai gusad.","poem":1},{"text":"Israelʼga deyob degisadegua ega igar-mesisad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Israelʼga Bab-Jehová weyob sogsa gusad:","poem":1},{"text":"‘Canaán-yar an bega ukoed,","poem":2},{"lineBreak":true},{"text":"ar we-yar bega nugsalesad.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”Deunni, bemar-dadgan ichee merguenad,","poem":1},{"text":"amar negsuli gaamakdidimalanad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Deginbali, be-dadgan yar-baid-baid obakdidimalanad,","poem":1},{"text":"reymar-baid-baid-negsemamaidgi obak-obak nanadimarbalinad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Degi-inigwele, Bab-Dummad, dule-bamalad be-dadgan-sabsur-imakega imaksasulid.","poem":1},{"text":"Degine, Bab-Jehová anmar-dadgan-sabedba, reymarga weyob gandikidgi sogsa gusad:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"‘Dulemar-an-maiga-sulesmalad, mer oakalomalo.","poem":1},{"text":"An-gayaburba-barsogmalad, mer ani sabsur-imakmalo.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"”Bela dulemar-napneggi-gudidimalad, Bab-Jehováʼga namakmalo,","poem":1},{"text":"bane-bane e-abonolegedgi sunmakmalo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dulemar-abargi, Bab-Jehová-e-gangued-yeerdaklegedgi be namakmalo,","poem":1},{"text":"degi, e-ibmar-dakledisulid-imaksadgi, dulemar-baid-baidmarga namakmarbalo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ar Bab-Jehová, dule-dummadid,","poem":1},{"text":"e-nug bela-bela odummoleged maid.","poem":2},{"text":"Degi, bab-dummagan-baiganba bur bule gangu maid.","poem":1},{"text":"Degisoggu, dulemar bur bule Bab-Jehová-dobgue-wilubmalad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ar bela bab-dummad-baigan-yar-baid-baidginmaladi, bab-dummagansurmalad, binsarmaladid.","poem":1},{"text":"Bab-Jehováʼdi, nibneg-obinnisadid.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bab-Jehová bela-bela yeerdakleged, degi, bur-gangued-nika maid.","poem":1},{"text":"Bab-Jehová-maidgi, gangued, degi, weligwaled nue-nikad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"”Dulemar-yar-baid-baidgi-bukwamalad, bemar, Bab-Jehová-nug-dummarba-gued odummomarsun.","poem":1},{"text":"Bemar, Bab-Jehová bela-bela yeerdakleged-nikaye sogmarsun.","poem":2},{"lineBreak":true},{"text":"Bemar, Bab-Jehová bela-bela gangued-nikaye sogmarsun.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bab-Jehová-asabin dagmar,","poem":1},{"text":"Bab-Dummad-asabin ega ibmar-ukleged sedamar.","poem":2},{"text":"E-nug-odummomar,","poem":1},{"text":"ar deyob imaklegergebed.","poem":2},{"text":"Bab-Jehová-asabin dulluu ambikumalo,","poem":1},{"text":"Bab-Jehová-neg-islidikid-yeerdaklegedgi, Bab-Jehová-nug odummomalo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bela-neg-ugakaase, Bab-Jehová-asabin dobee itomalo.","poem":1},{"text":"Ar Bab-Jehová neg-dirbir-naid nasiksad.","poem":2},{"lineBreak":true},{"text":"Degisoggu, e-sogedba naigu guoed.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"¡Nibnegmar, wergumar!","poem":1},{"text":"¡Napneg, yeer-itogedba wergumar!","poem":2},{"text":"Dulemar-yar-baid-baidgi-bukwamalad, be sogmar:","poem":1},{"text":"‘Bab-Jehová, rey-dummadye, be sogmar.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"”¡Demar, uurmake!","poem":1},{"text":"¡Bela egi-ibmar-bukwad, uurmake!","poem":2},{"text":"¡Sapur, wergue!","poem":1},{"text":"¡Bela-egi-ibmar-bukwad, wergue!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bela sapimar sapurba-bukwad, Bab-Jehová-asabin, weligwaledba namakmar.","poem":1},{"text":"Ar Bab-Jehová, napneg-seega danikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"”Bab-Jehováʼga doggus-nuedye be sogmar,","poem":1},{"text":"ar Bab-Jehová, dule-nuedid.","poem":2},{"lineBreak":true},{"text":"Ar e-sabguedi, degisadeguad.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ega be sogmar: ‘Bab-Dummadye, be anmar-bendake.","poem":1},{"text":"Ar be anmar-abonogedid.","poem":2},{"text":"Bab-Jehováʼye, bulakwa-ambikuega be anmar-imake,","poem":1},{"text":"dulemar-yar-baid-baidgi-bukwamaladgi be anmar-bendake.","poem":2},{"text":"Adi, be-nug-swilidikid odummogegar,","poem":1},{"text":"adi, weligwaledgi be-nug odummogegar.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Israel-e-Bab-Dummad-Jehová, be-nug dummarba gusun.","poem":1},{"text":"Degisadegu, be-nug odummoledii gusun.”","poem":2},{"text":"Degi, dulemar bela abin sogdemogad: “¡Deyob guo!”","poem":1},{"text":"Degi, geb Bab-Jehová-e-nug odummosmalad.","poem":2}]},{"type":"heading","content":["Levita-dulemarga arbaed uklesad"]},{"type":"verse","number":37,"content":["Degisoggu, David, Asaf-onug-imaksad, degi, Asaf-e-gwenadgan-onug-imaksabalid. Adi, Bab-Jehová-Dadganbo-Igar-Mesisad-Ulu-asabin, bane-bane igar-maidba Bab-Dummad-nug-odummogedgi arbadii gumalagar."]},{"type":"verse","number":38,"content":[{"text":"Deginbali, David, yawagak-dakmalaga, wemar onug-imaksabalid:","poem":1},{"text":"Obed-Edom, degi, e-gwenadgan dulapaa-gakabaabak (68).","poem":2},{"lineBreak":true},{"text":"Obed-Edomʼde, Jedutún-e-machid.","poem":2},"Deginbali, Hosa, yawagakgi-nakulegega onugsasbalid."]},{"type":"verse","number":39,"content":["Degi, David, dule-irwa-Bab-Dummadse-goled-Sadocʼye-nugad, degi, e-gwenadganmala, Bab-Jehováʼse-gorleged-neg-Gabaónʼgi-siidgi arbamalaga onug-imaksabalid."]},{"type":"verse","number":40,"content":["Adi, wemar, Bab-Jehováʼse-gorleged-neggi, bane-bane wakdaradbali, degi, sedogidbali, ibmar-durgan-ogumakar Bab-Jehováʼga ukmalagar. Igi Bab-Jehová Israel-dulemarga gardagi-narmakar Igar-uksa, abali imakmalagar."]},{"type":"verse","number":41,"content":["Wemarba, David, wemar-onug-imaksabalid: Hemán, Jedutún, degine, dule-baigan onug-imaksabalid. Adi, wemar Bab-Jehováʼga doggus-nuedye sogega, degi, we-namaked-swilidikidgi namakmalagar: “Bab-Jehová-e-sabguedi, degisadeguad.”"]},{"type":"verse","number":42,"content":["Degi, Hemán, Jedutúnʼbogwa, we-namakedgi gar-trompeta, gar-címbalo, degi, gar-baigan Bab-Jehováʼga ogormaladid. Jedutún-e-masmaladi yawagak-dakmaladid."]},{"type":"verse","number":43,"content":["Degine, geb bela dulemar na e-neg-e-negse nadmalad. David e-negse nadmogad. Adi, e-neguyaginmaladgi nued-binsaegar."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":43}