{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":2,"content":[{"type":"heading","content":["Israel-masmala"]},{"type":"verse","number":1,"content":[{"text":"Israel-e-masmala, wemalad:","poem":1},{"text":"Rubén, Simeón, Leví,","poem":2},{"lineBreak":true},{"text":"Judá, Isacar, Zabulón,","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dan, José, Benjamín,","poem":2},{"lineBreak":true},{"text":"Neftalí, Gad, degi, Aser.","poem":2}]},{"type":"heading","content":["Judá-wagan"]},{"type":"verse","number":3,"content":[{"text":"Judá-e-masmala, wemalad:","poem":1},{"text":"Er, Onán, degi, Sela.","poem":2},"We-masmala-warbaagwadi, Súa-e-sisgwagi gwalulesmalad. We-omede, Canaán-duled. Judá-machi-gebesailadi, Erʼye nugad. Bab-Jehová-asabin dule-isganaga gusad. Agala, Bab-Jehová, Er-iblosad."]},{"type":"verse","number":4,"content":[{"text":"Judá-bala-Tamar, Judáʼga masmala-warbo baksad:","poem":1},{"text":"Fares, Zera.","poem":2},{"text":"Judá, masmala bela walatar nikusad.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Fares-e-masmaladi, wemarmogad:","poem":1},{"text":"Hezrón, Hamul.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zera-e-masmaladi, wemarmogad:","poem":1},{"text":"Zimri, Etán, Hemán,","poem":2},{"lineBreak":true},{"text":"Calcol, degi, Dara.","poem":2},{"text":"Bergwable, e-atar gumalad.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Carmi-e-machidi, wedid:","poem":1},{"text":"Acán.","poem":2},"We-Acán, Bab-Dummadga-ibmar-nugsalesad atur-imaksa-gusadba, Israel-dulemarga boni-dummad onos gusad. Agi, dummad-neg-gagasad."]},{"type":"verse","number":8,"content":[{"text":"Etán-e-machidi, wedid:","poem":1},{"text":"Azarías.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hezrón-e-masmaladi, wemarmogad:","poem":1},{"text":"Jerameel, Ram, degi, Quelubai.","poem":2}]},{"type":"heading","content":["Hezrón-machi-Ram-e-wagan"]},{"type":"verse","number":10,"content":[{"text":"Ram, machi-Aminadab-nikusad.","poem":1},{"text":"Aminadabʼdi, machi-Naasón-nikusmogad.","poem":2},{"text":"We-Naasónʼde, Judá-dulemar-e-dummadid.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Naasón, machi-Salmón-nikusmogad.","poem":2},{"lineBreak":true},{"text":"Salmónʼdi, machi-Booz-nikusmogad.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Boozʼdi, machi-Obed-nikusmogad.","poem":2},{"lineBreak":true},{"text":"Obedʼdi, machi-Isaí-nikusmogad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Isaí, machi-Eliab-nikunonikid. A-machide, gebesailaginedid.","poem":1},{"text":"Eliab-yarbali, Abinadab gwalulesad.","poem":2},{"lineBreak":true},{"text":"Abinadab-yarbali, Simea gwalulenonimogad.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Simea-yarbali, Natanael gwalulesmogad.","poem":2},{"lineBreak":true},{"text":"Natanael-yarbali, Radai gwalulesmogad.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Radai-yarbali, Ozem gwalulesmogad.","poem":2},{"lineBreak":true},{"text":"Napidgine, David gwalulenonikid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"E-bunmardi, wemarmogad:","poem":1},{"text":"Sarvia, Abigail.","poem":2},{"text":"Sarvia-e-masmala, warbaa gumalad:","poem":1},{"text":"Abisai, Joab, Asael.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Abigailʼga, Amasa gwalulenonikid,","poem":1},{"text":"Amasa-e-baba, Jeterʼye nugad, Ismael-duled.","poem":3}]},{"type":"heading","content":["Hezrón-machi-Caleb-e-wagan"]},{"type":"verse","number":18,"content":["Hezrón-machi-Caleb, e-ome-Azubaʼga masmala-baksad, degi, e-ome-baid-Jeriotʼga masmala-baksabalid.",{"text":"E-masmala, wemalad:","poem":1},{"text":"Jeser, Sobab, Ardón.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Azuba-burgwisgua, Caleb, ome-baid Efrataʼye-nugad nikusad.","poem":1},{"text":"Geb Efrataʼga, machi-Hur-baknonikid.","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Hurʼdi, machi-nikusad, Uriʼye nugad.","poem":2},{"lineBreak":true},{"text":"Uriʼdi, machi-Bezaleel-nikunonimogad.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hezrón, birga-dulapaa (60) nikunonigua,","poem":1},{"text":"Maquir-e-sisgwa nikusad.","poem":2},{"text":"Maquirʼde, Galaad-e-babad.","poem":3},{"text":"Agi, Maquir-e-sisgwa Segub-baknonikid.","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Segubʼdi, machi-Jair-nikunonimogad.","poem":2},{"text":"Jairʼde, Galaad-yargi, neggwebur-gwadulagwen-gakapaa (23) nikunonikid.","poem":3}]},{"type":"verse","number":23,"content":["Gesur-dulemar, degi, Aram-dulemarbogwa, Jair-ibe Kenat-neggwebur, degi, bela e-neggwebur-burwiganase-bakar, sunonimalad. Belagwable, neggwebur-gwadulapaa (60) Jair-ibe susmalad.",{"text":"Bela wemar, Maquir-e-wagan gumalad.","poem":1},{"text":"Maquirʼdi, Galaad-e-babad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hezrón, Caleb-De-Efrata-neggweburgi-burgwisgua, e-ome-Abías, machi-Asur-baksad.","poem":1},{"text":"Asurʼde, Tecoa-e-babad.","poem":2}]},{"type":"heading","content":["Hezrón-machi-Jerameel-e-wagan"]},{"type":"verse","number":25,"content":[{"text":"Hezrón-machi-gebesailagined-Jerameel-e-masmala, wemalad:","poem":1},{"text":"E-machi-gebesailagined, Ramʼye nugad.","poem":2},{"lineBreak":true},{"text":"Baigana, wemalad: Buna, Orén,","poem":2},{"lineBreak":true},{"text":"Ozem, degi, Ahías.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Jerameel ome-baid nikunonikid. A-ome, Ataraʼye nugad.","poem":1},{"text":"Atara, machi-Onam-baknonikid.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Jerameel-machi-gebesailagined-Ram-e-masmala, wemalad:","poem":1},{"text":"Maaz, Jamín, Equer.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Onam-e-masmaladi, wemarmogad:","poem":1},{"text":"Samai, Jada.","poem":2},{"text":"Samai-e-masmaladi, wemarmogad:","poem":1},{"text":"Nadab, Abisur.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Abisur-e-ome, Abihailʼye nugad. Ega masmala-gwalulesadi, wemalad:","poem":1},{"text":"Ahbán, Molid.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nadab-e-masmaladi, wemarmogad:","poem":1},{"text":"Seled, Apaim.","poem":2},{"text":"Seledʼdina mimmigan-nikussuli burgwisad.","poem":1}]},{"type":"verse","number":31,"content":[{"text":"Apaim-e-machidi, Isiʼye nugad.","poem":2},{"lineBreak":true},{"text":"Isi-e-machidi, Sesánʼye nuggunonikid.","poem":2},{"lineBreak":true},{"text":"Sesán-e-machidi, Ahlaiʼye nuggunonikid.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Samai-urba-Jada-e-masmaladi, wemarmogad:","poem":1},{"text":"Jeter, Jonatán.","poem":2},{"text":"Jeterʼdina mimmigan-nikussuli burgwisad.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"Jonatán-e-masmaladi, wemarmogad:","poem":1},{"text":"Pelet, Zaza.","poem":2},{"text":"Bela wemar, Jerameel-e-wagan gumalad.","poem":3}]},{"type":"verse","number":34,"content":["Sesán, masmala-nikussulid, unnila bunamalabi nikusad.",{"text":"Unnila, Sesán, Egipto-dulebi e-maiga sedii gusad.","poem":1},{"text":"We-maide, Jarhaʼye nugad.","poem":2}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Sesán Jarhaʼga e-sisgwa-uksad, adi, nikuegar.","poem":2},{"text":"Degidba, Jarha, Sesán-e-sisgwaga machi-Atai-baknonikid.","poem":1}]},{"type":"verse","number":36,"content":[{"text":"Atai, machi-Natán-nikunonikid.","poem":2},{"lineBreak":true},{"text":"Natánʼdi, machi-Zabad-nikunonikid.","poem":2}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Zabadʼdi, machi-Eflal-nikunonikid.","poem":2},{"lineBreak":true},{"text":"Eflalʼdi, machi-Obed-nikunonikid.","poem":2}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Obedʼdi, machi-Jehú-nikunonikid.","poem":2},{"lineBreak":true},{"text":"Jehúʼdi, machi-Azarías-nikunonikid.","poem":2}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Azaríasʼdi, machi-Heles-nikunonikid.","poem":2},{"lineBreak":true},{"text":"Helesʼdi, machi-Elasa-nikunonikid.","poem":2}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Elasaʼdi, machi-Quismai-nikunonikid,","poem":2},{"lineBreak":true},{"text":"Quismaiʼdi, machi-Salum-nikunonikid.","poem":2}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Salumʼdi, machi-Jecamías-nikunonikid.","poem":2},{"lineBreak":true},{"text":"Degi, Jecamíasʼdi, machi-Elisama-nikunonikid.","poem":2}]},{"type":"heading","content":["Caleb-wagan"]},{"type":"verse","number":42,"content":[{"text":"Jerameel-e-urba-Caleb-e-masmaladi, wemalad:","poem":1},{"text":"E-machi-gebesailagined, Mesaʼye nugad.","poem":2},{"lineBreak":true},{"text":"Mesaʼdi, Zif-e-babad, degi, Maresa-e-babbalid.","poem":2},{"lineBreak":true},{"text":"Maresaʼdi, Hebrón-e-babmogad.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Hebrón-e-masmaladi, wemarmogad:","poem":1},{"text":"Coré, Tapúa, Requem, Sema.","poem":2}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Semaʼdi, machi-Raham-nikunonikid.","poem":2},{"lineBreak":true},{"text":"Rahamʼdi, machi-Jorcoam-nikunonikid.","poem":2},{"lineBreak":true},{"text":"Requemʼdi, machi-Samai-nikunonikid.","poem":2}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Samaiʼdi, machi-Maón-nikunonikid.","poem":2},{"lineBreak":true},{"text":"Degi, Maónʼdi, machi-Bet-Sur-nikunonikid.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Caleb-ome-dikarbalid-Efa, we-masmala nikusad:","poem":1},{"text":"Harán, Mosa, Gazez.","poem":2},{"text":"Haránʼdi, machi-nikusad.","poem":1},{"text":"Gazezʼye onugsasad.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Jahdai-e-masmaladi, wemalad:","poem":1},{"text":"Regem, Jotam, Gesam,","poem":2},{"lineBreak":true},{"text":"Pelet, Efa, degi, Saaf.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Caleb-ome-dikarbalid-Maaca, we-masmala nikusad:","poem":1},{"text":"Seber, Tirhana.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Deginbali, Maaca masmala nikusbalid:","poem":1},{"text":"Saaf, Seva.","poem":2},{"lineBreak":true},{"text":"Saafʼdi, Madmana-e-babad.","poem":2},{"lineBreak":true},{"text":"Sevaʼdi, Macbena-e-babad, degi, Gibea-e-babbalid.","poem":2},{"lineBreak":true},{"text":"Caleb-e-sisgwadi, Acsaʼye nugad.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Bela-wemar, Caleb-e-wagan gumalad.","poem":1},{"lineBreak":true},{"text":"Efrata-machi-gebesailagined-Hur-e-masmala, wemalad:","poem":1},{"text":"Sobal, Salma, Haref.","poem":2}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Sobalʼdi, Quiriat-Jearim-e-babad,","poem":2},{"lineBreak":true},{"text":"Salmaʼdi, Belén-e-babad,","poem":2},{"lineBreak":true},{"text":"Harefʼdi, Bet-Gader-e-babad.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Sobal-e-wagan, wemalad:","poem":1},{"text":"Haroe, degi, Manahet-dulemar-negabalad.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Degi, Quiriat-Jearim-e-anagan, wemalad:","poem":1},{"text":"Itri-dulemar, Fut-dulemar,","poem":2},{"lineBreak":true},{"text":"Sumat-dulemar, degi, Misraim-dulemar.","poem":2},{"lineBreak":true},{"text":"Misraim-dulemargi, Zora-dulemar danimalad,","poem":2},{"lineBreak":true},{"text":"degi, Estaolita-dulemar danimarmogad.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Salma-e-wagan, wemalad:","poem":1},{"text":"Belén, Netofa-dulemar, Atrot-Bet-Joab,","poem":2},{"lineBreak":true},{"text":"Manahat-dule-negabar, degi, Zora-dulemar.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Degine, garda-narmakmalad-e-gwenadgan-Jabesʼgi-mamaid, wemalad:","poem":1},{"text":"Tirat-dulemar, Simea-dulemar, Sucat-dulemar.","poem":2},{"lineBreak":true},{"text":"We-Ceneo-dulemar, Hamatʼgi-danimaladid.","poem":2},{"lineBreak":true},{"text":"Hamatʼde, Recab-dulemar-e-dad-dummadid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1CH/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1CH/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1CH/1.json","previousChapterAudioLinks":{},"numberOfVerses":55}