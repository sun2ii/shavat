{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":23,"content":[{"type":"heading","content":["Levita-dulemarga e-arbaed uklesad"]},{"type":"verse","number":1,"content":["David, e-birga-nue-seleba-gusadgine, Israel-e-reyga-megega e-machi-Salomón-onug-imaksad."]},{"type":"verse","number":2,"content":["Degine, David, Israel-girmar-dummagan onmaksad, dule-irwa-Bab-Dummadse-gormalad onmaksabalid, degi, Levita-dulemar onmaksabalid."]},{"type":"verse","number":3,"content":["Levita-dulemar birga-dulagwen-gakambe-obine-nikamalad (30+) ebislesad. War-wargwengi-ebichilesgu, machergan mili-dulagwen-gakambe-gakabaabak-mergu (38,000) daklealid."]},{"type":"verse","number":4,"content":["David sogded:",{"text":"“We-dulemar-deyob-merguedgi,","poem":1},{"text":"Bab-Jehováʼse-goled-neggi mili-dulagwen-gakabake (24,000) arbamaladid.","poem":2},{"lineBreak":true},{"text":"Sapin-dummagan, degi, igar-nabomalad-dummagan milinergwa (6,000) mergubalid.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A-uki, yawagak-dakmalad milibake (4,000) mergubalid.","poem":2},{"lineBreak":true},{"text":"Deginbali, garmar-ogoledgi Bab-Dummad-nug-odummomalagala milibake (4,000) bukwabalid.","poem":2},{"text":"Ani, Bab-Dummad-nug-odummomalaga a-garmar-sobmalaga imaksad.”","poem":3}]},{"type":"verse","number":6,"content":["David, Leví-e-masmala-warbaagwadba, Leví-wagan danar-danar oambikusad.",{"text":"Leví-e-masmala, wemalad:","poem":1},{"text":"Gersón, Coat, Merari.","poem":2}]},{"type":"heading","content":["Gersón-wagan"]},{"type":"verse","number":7,"content":[{"text":"Gersón-masmala, wemalad:","poem":1},{"text":"Laadán, Simei.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Laadán-e-masmaladi, wemarmogad:","poem":1},{"text":"E-machi-gebesailagined Jehiel.","poem":2},{"lineBreak":true},{"text":"Jehiel-yarbalid, Zetam, degi, Joel.","poem":2},{"text":"Bela walapaa gued.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Simei-e-masmala-warbaagwad, wemalad:","poem":1},{"text":"Selomit, Haziel, Harán.","poem":2},{"text":"Wemar, Laadán-e-gwenadgan-e-dummaganad.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Simei masmala-walabake-nikusbalid, wemalad:","poem":1},{"text":"Jahat, Zina, Jeús, Bería.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Jahatʼde, machi-gebesailaginedid, Zinaʼdi, e-yarbalidid.","poem":2},{"text":"Jeús, degi, Beríaʼbo masmala-ichesur nikussurgusmalad.","poem":3},{"lineBreak":true},{"text":"Degisoggu, neg-gwagwenayob gunonimalad.","poem":3}]},{"type":"heading","content":["Coat-wagan"]},{"type":"verse","number":12,"content":[{"text":"Coat-e-masmala bela walabake gumalad:","poem":1},{"text":"Amram, Izhar, Hebrón, degi, Uziel.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Amram-e-masmala, wemalad:","poem":1},{"text":"Aarón, Moisés.","poem":2},"Aarón, degi, e-waganmala, amarbi Bab-Jehováʼga ibmar-bur bule-swilidikmalad-ukega, degi, ina-wawadikid-ogumakbaliga nuggusmalad. Deginbali, Bab-Dummad-nuggi-arbaega, degi, e-nug-odummodi-gubaliga nuggusmarbalid."]},{"type":"verse","number":14,"content":["Bab-Dummad-e-dule-Moisés-e-masmala, Leví-e-waganmarba dognonimarmogad."]},{"type":"verse","number":15,"content":[{"text":"Moisés-e-masmala, wemalad:","poem":1},{"text":"Gersón, Eliezer.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gersón-e-machidi, wedid:","poem":1},{"text":"Sebuel, machi-sailagined.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Eliezer-e-machidi, wemogad:","poem":1},{"text":"Rehabías, machi-sailagined. Eliezer masmala-baid nikussulid.","poem":2},{"lineBreak":true},{"text":"Rehabíasʼdina masmalad-ichesur nikusad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Coat-machi-Izhar-e-machidi, wedid:","poem":1},{"text":"Selomit, machi-sailagined.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Coat-machi-Hebrón-e-masmaladi, wemalad:","poem":1},{"text":"Jerías, machi-sailagined. Jerías-yarbalid, Amarías.","poem":2},{"lineBreak":true},{"text":"Amarías-yarbalid, Jahaziel. Jahaziel-yarbalid, Jecamán.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Coat-machi-Uziel-e-masmaladi, wemalad:","poem":1},{"text":"Micaía, machi-sailagined. Micaía-yarbalid, Isías.","poem":2}]},{"type":"heading","content":["Merari-wagan"]},{"type":"verse","number":21,"content":[{"text":"Merari-e-masmala, wemalad:","poem":1},{"text":"Mahli, Musi.","poem":2},{"text":"Mahli-e-masmaladi, wemalad:","poem":1},{"text":"Eleazar, Quis.","poem":2}]},{"type":"verse","number":22,"content":["Eleazar masmala-suli burgwisad. Degi-inigwele, bunamalabi nikusad. Degine, we-bunamala, e-gwenadgan-Quis-masmala nikusmalad."]},{"type":"verse","number":23,"content":[{"text":"Musi-e-masmala-warbaagwaddi, wemalad:","poem":1},{"text":"Mahli, Edar, Jeremot.","poem":2}]},{"type":"verse","number":24,"content":["Wemar, Leví-e-waganmalad, e-babgangi-danimalad. Nug-welesadi, e-dummaganba war-wargwengi e-nugmar nagusad. Degi, birga-durgwen (20) nikamalad, birga-durgwen-obine (20+) nikamarbalid. Amar, Bab-Jehováʼse-goled-neggi arbadii damalad."]},{"type":"verse","number":25,"content":["Ar David weyob sogsa gusad: “Israel-e-Bab-Dummad-Jehová, Israel-dulemarga neg-bogidik nasiksad, degi, Jerusalénʼgi-mai sadeguoed."]},{"type":"verse","number":26,"content":["Aga, Levita-dulemar, Bab-Dummadse-goled-neg-sunna-seleged bar-sedii guosurmalad, degi, ibmar-ebulemalad-ebipidii bar guosurmarbalid.”"]},{"type":"verse","number":27,"content":["Degisoggu, David-napi-ibmar-sogsadbali, Levita-dulemar birga-durgwen-nikamalad (20), degi, birga-dulagwen-obine-nikamalad (20+), ebislesad."]},{"type":"verse","number":28,"content":[{"text":"We-Levitaʼmar Aarón-e-masmala-sogedba Bab-Jehováʼse-goled-neggi we-ibmargi-arbamalaga ebislesmalad:","poem":1},{"text":"Babse-goled-neg-imbaba arbaegar,","poem":2},{"lineBreak":true},{"text":"Babse-goled-negyaba neg-burwigana-dakmalagar,","poem":2},{"lineBreak":true},{"text":"ibmar-islidikmalad-bukwad urukegar,","poem":2},{"lineBreak":true},{"text":"degi, Bab-Dummadse-goled-neggi bela ibmar-imakedgi bendakbaligar.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Amba wemala, Bab-Jehováʼga-ukegala, we-ibmar guakwaa imakmarbalid:","poem":1},{"text":"Madu-islidikid, madubur Bab-Dummadga ukegar,","poem":2},{"lineBreak":true},{"text":"madu-ologana-inasulid, ibmar-dibyar-ukleged,","poem":2},{"lineBreak":true},{"text":"ibmar-duar-uklegeddibe.","poem":2},{"lineBreak":true},{"text":"Deginbali, nibir-ibmar-oaidikumalad, ibmar-wilubsamalad, a-dakedmarbalid.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"A-ukine,","poem":1},{"text":"Bab-Jehováʼga-dog-nued-sogegar,","poem":2},{"lineBreak":true},{"text":"degi, Bab-Jehová-e-nug-odummobaligar,","poem":2},{"lineBreak":true},{"text":"bane-bane wakudaradba,","poem":2},{"lineBreak":true},{"text":"degine, sedogidba Bab-Dummadse-goled-negse naddamalad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Degi, Bab-Jehováʼga we-ibmar-ukleged-dakedmarbalid:","poem":1},{"text":"Ibmar-durgan-ogumakar itoged-ibagi-ukleged,","poem":2},{"lineBreak":true},{"text":"nii-gebe-gwisgusadgi-ukleged,","poem":2},{"lineBreak":true},{"text":"degi, iba-dummad-itoakwaa-onolegedgi-ukleged dakedmarbalid.","poem":2},"Emar-merguedba bane-bane, degi, muchub-muchub, e-igar-maidba Bab-Dummadga arbabukwadamalad."]},{"type":"verse","number":32,"content":["Deginbali, Levita-dulemar, Bab-Dummad-dulemarbo-ambikued-neg dakedmarbalid, degi, Neg-Swilidikid-dakedmarbalid. Aarón-masmala-sogedba Bab-Jehováʼse-goled-neggi arbabukwadamalad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1CH/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1CH/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1CH/22.json","previousChapterAudioLinks":{},"numberOfVerses":32}