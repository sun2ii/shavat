{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":24,"content":[{"type":"heading","content":["Aarón-e-masmala-e-arbaed"]},{"type":"verse","number":1,"content":["Weyobi, Aarón-e-masmala danar-danar mimilesmarmogad.",{"text":"Aarón-e-masmala, wemalad:","poem":1},{"text":"Nadab, Abiú, Eleazar, Itamar.","poem":2}]},{"type":"verse","number":2,"content":["Nadab, Abiúʼbogwa, mimmigan-nikussurgusmalad. Deginbali, e-bab-idu burgwismarbalid. Degisoggu, Eleazar, Itamar-ebo, Bab-Dummadse-dule-irwa-goledga arbadmalad."]},{"type":"verse","number":3,"content":["Degine, David, Eleazar-e-wagwa-Sadoc-nugadmala, degine, Itamar-e-wagwa-Ahimelec-nugadmala, dule-irwa-Bab-Dummadse-gormalad nuekwaa arbamalagala, ega e-arbaed-ibagan ilemakar mesisad."]},{"type":"verse","number":4,"content":["Dule-idumalad Eleazar-e-wagan-abargi, Itamar-e-waganba bur merbaasoggu, weyob mimilesad:",{"text":"Eleazar-wagan-dule-idumalad,","poem":1},{"text":"warambe-gakanergwa ambikusad (16).","poem":2},{"text":"Itamar-wagan-dule-idumaladdi,","poem":1},{"text":"walabaabak (8) ambikusmarmogad.","poem":2}]},{"type":"verse","number":5,"content":["Sordamar, wachi-wachiba-arbamalaga danar-danar mimilesad. Weyob-mimilesadi ibmargi-wilubdaklegar imaklesad. Degisoggu, Bab-Dummadse-goled-neg-yagi, Bab-Dummadga-arbamalad-e-dummagan, Eleazar-waganmar-abargi, degi, Itamar-waganmar-abargi deyob gudidii nanamalad."]},{"type":"verse","number":6,"content":[{"text":"Degine, Levita-dule-Natanael-machi-Semaías, we-dulemar-wagab, nugmar gardagi-narmakar mesisad:","poem":1},{"text":"Rey-wagab, dummagan-wagab,","poem":2},{"lineBreak":true},{"text":"dule-irwa-Bab-Dummadse-goled-Sadoc-wagab,","poem":2},{"lineBreak":true},{"text":"Abiatar-machi-Ahimelec-wagab,","poem":2},{"lineBreak":true},{"text":"dule-irwa-Bab-Dummadse-gormalad-e-dummagan-wagab,","poem":2},{"lineBreak":true},{"text":"Levita-dulemar-wagab.","poem":2},{"text":"Eleazar-e-gwenadganga wachi-wachiba-arbamalaga ilabo-wilub uklesad,","poem":1},{"text":"degi, Itamar-e-gwenadgangardina, ilagwen-wilub uklesad.","poem":2},{"text":"Weyob sulenonimalad:","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Gebe-suleargua, Joiarib sulenonikid.","poem":2},{"lineBreak":true},{"text":"Ilabogi, Jedaías sulenonikid.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Irbaagi, Harim sulenonikid.","poem":2},{"lineBreak":true},{"text":"Irbakegi, Seorim sulenonikid.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ilatargi, Malquías sulenonikid.","poem":2},{"lineBreak":true},{"text":"Ilanergwagi (6), Mijamín sulenonikid.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ilaguglegi (7), Cos sulenonikid.","poem":2},{"lineBreak":true},{"text":"Ilabaabakgi (8), Abías sulenonikid.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ilabakebakgi (9), Jesúa sulenonikid.","poem":2},{"lineBreak":true},{"text":"Irambegi (10), Secanías sulenonikid.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Irambe-gakagwensakgi (11), Eliasib sulenonikid.","poem":2},{"lineBreak":true},{"text":"Irambe-gakabogi (12), Jaquim sulenonikid.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Irambe-gakapaagi (13), Hupa sulenonikid.","poem":2},{"lineBreak":true},{"text":"Irambe-gakabakegi (14), Jesebeab sulenonikid.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Irambe-gakatargi (15), Bilga sulenonikid.","poem":2},{"lineBreak":true},{"text":"Irambe-gakanergwagi (16), Imer sulenonikid.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Irambe-gakaguglegi (17), Hezir sulenonikid.","poem":2},{"lineBreak":true},{"text":"Irambe-gakabaabakgi (18), Afses sulenonikid.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Irambe-gakabakebakgi (19), Petaías sulenonikid.","poem":2},{"lineBreak":true},{"text":"Ila-dulagwengi (20), Hezequiel sulenonikid.","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ila-dulagwen-gakagwensakgi (21), Jaquín sulenonikid.","poem":2},{"lineBreak":true},{"text":"Ila-dulagwen-gakabogi (22), Gamul sulenonikid.","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ila-dulagwen-gakapaagi (23), Delaía sulenonikid.","poem":2},{"lineBreak":true},{"text":"Ila-dulagwen-gakabakegi (24), Maazías sulenonikid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wachi-wachiba Bab-Jehováʼse-goled-negyaba arbamalaga, weyob ilemakar-ambikulesmalad.","poem":3},"Igi Israel-e-Bab-Dummad e-dad-Aarónʼba igar-uksagusa, deyob imaksamalad."]},{"type":"heading","content":["Leví-wagan-baigan"]},{"type":"verse","number":20,"content":[{"text":"Leví-wagan-baigan-gudidimalad, wachi-wachiba-arbaega-sulesmarmogad, wemalad:","poem":1},{"text":"Amram-e-wagansik, Subael. Subael-e-wagansik, Jehedías.","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Rehabías-e-wagansik, e-machi-sailagined-Isías.","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Izhar-e-wagansik, Selomot. Selomot e-wagansik, Jahat.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hebrón-e-masmaladi, wemalad:","poem":1},{"text":"Jerías, machi-sailagined. Jerías-yarbalid, Amarías.","poem":2},{"lineBreak":true},{"text":"Amarías-yarbalid, Jahaziel. Jahaziel-yarbalid, Jecamán.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Uziel-e-machi, wedid:","poem":1},{"text":"Micaía. Micaía-e-machidi, Samir.","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Micaía-e-urba, Isías. Isías-e-wagansik, Zacarías.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Merari-wagansik, wemalad:","poem":1},{"text":"Mahli, Musi. Jaazías-machi-Beno.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Merari-wagansik, e-machi-Jaazíasʼgi danimalad, wemalad:","poem":1},{"text":"Beno, Soham, Zacur, Ibri.","poem":2}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Mahli-machi-Eleazar.","poem":2},{"text":"Eleazarʼdi, machimala-nikussur gusad.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Quis-e-machi, Jerameel.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Musi-e-masmala, wemalad:","poem":1},{"text":"Mahli, Edar, Jerimot.","poem":2},{"text":"Wemar, Levita-dulemar e-wagan-e-waganba ambikusmalad.","poem":1}]},{"type":"verse","number":31,"content":["Wemar, e-gwenadgan-Aarón-waganyob ibmargi-wilubdaklegar, we-dulemar-asabin mimilesmarmogad:",{"text":"Rey-David-asabin, Sadoc-asabin, Ahimelec-asabin,","poem":2},{"lineBreak":true},{"text":"dule-irwa-Bab-Dummadse-gormalad-e-dummagan-asabin,","poem":2},{"lineBreak":true},{"text":"degi, Levita-dulemar-asabin mimilesmalad.","poem":2},{"text":"Ia-dummagan-e-gwenadgana, e-urbamar-e-gwenadganyob na yopira imaklesmalad.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1CH/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1CH/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1CH/23.json","previousChapterAudioLinks":{},"numberOfVerses":31}