{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":25,"content":[{"type":"heading","content":["Gar-ogormalad, degi, dule-namakmalad nug-imaklesmalad"]},{"type":"verse","number":1,"content":[{"text":"David, degi, e-sorda-dummaganmala, Bab-Dummadga-namaklegedgi-arbamalaga wemar-onug-imaksamalad:","poem":1},{"text":"Asaf, degi, e-masmala,","poem":2},{"lineBreak":true},{"text":"Hemán, degi, e-masmala,","poem":2},{"lineBreak":true},{"text":"Jedutún, degi, e-masmala.","poem":2},{"text":"Wemala gar-arpaʼba, gar-salterioʼba, gar-címbaloʼba Bab-Dummad-gayaburba-barsogmaladid.","poem":3},{"text":"Gar-ogormaloed, wemalad:","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Asaf-e-masmala:","poem":2},{"text":"Zacur, José, Netanías, Asarela.","poem":3},"E-bab-Asaf e-masmala-iduedga gudiid. Deginbali, Asaf, rey-sogedba Bab-Jehová-gayaburba barsogdiid."]},{"type":"verse","number":3,"content":[{"text":"Jedutún-e-masmala, wemalad:","poem":1},{"text":"Gedalías, Zeri, Jesaías, Hasabías, Matatías, Simei.","poem":2},{"text":"E-bab-Jedutún e-masmala-e-nergwadga (6) iduedga gudiid.","poem":3},"Jedutún, Bab-Jehová-gayaburba-barsokalir, Bab-Jehováʼga dog-nuedye sogega, degi, e-nug-odummobaliga, gar-arpa ogollardaed."]},{"type":"verse","number":4,"content":[{"text":"Hemán-e-masmala, wemalad:","poem":1},{"text":"Buquías, Matanías, Uziel, Sebuel,","poem":2},{"lineBreak":true},{"text":"Jeremot, Hananías, Hanani, Eliata,","poem":2},{"lineBreak":true},{"text":"Gidalti, Romanti-Ezer, Josbecasa, Maloti,","poem":2},{"lineBreak":true},{"text":"Hotir, Mahaziot.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bela wemar, Hemán-e-masmala gued.","poem":3},"Hemanʼde, reyga-Bab-Dummad-igarsik negburgan-dakedid. Bab-Dummad Hemánʼga masmala warambe-gakabake (14) uksad. Bunamaladi ega warbaa uksabalid. Agala, Hemán nug-dummarba-megnonikid, ar Bab-Dummad ega sogsagusad, an deyob be-imakoye."]},{"type":"verse","number":6,"content":[{"text":"E-bab Bab-Jehováʼse-goled-neggi namakedgi e-masmala-idudiid, we-garmarba namakarmalar:","poem":1},{"text":"Gar-címbaloʼba, gar-salterioʼba, gar-arpaʼba namakmalar.","poem":2},"Asaf, Jedutún, degi, Hemán, rey-sogedba arbadii damalad."]},{"type":"verse","number":7,"content":["We-dulemar, e-gwenadganse-bakale, Bab-Jehováʼga-namakbukwa-gumalaga odurdaklesmalad.",{"text":"Bela wemar e-dulataled-ilabo gaka dulabake-gakabaabak (288) mergumalad.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Bela dule-dummaganse-bakar, dule-burwiganase-bakar,","poem":2},{"lineBreak":true},{"text":"odurdaked-sailaganse-bakar, amba ibmar-durdaknaidse-bakar,","poem":2},{"text":"wachi-wachiba-arbaega ibmargi-wilubdaklegar yopira mimilesmalad.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Asaf-gwenad-Joséʼye-nugad, a-inse sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3},{"text":"A-sorbali, Gedalías sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Irbaagi, Zacur sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Irbakegi, Izri sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ilatargi, Netanías sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ilanergwagi (6), Buquías sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Ilaguglegi (7), Jesarela sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Ilabaabakgi (8), Jesahías sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Ilabakebakgi (9), Matanías sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Irambegi (10), Simei sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Irambe-gakagwensakgi (11), Azareel sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Irambe-gakabogi (12), Hasabías sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Irambe-gakapaagi (13), Subael sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Irambe-gakabakegi (14), Matatías sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Irambe-gakatargi (15), Jeremot sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Irambe-gakanergwagi (16), Hananías sulenonikid.","poem":1},{"text":"We-dule, e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Irambe-gakaguglegi (17), Josbecasa sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar, bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Irambe-gakabaabakgi (18), Hanani sulenonikid.","poem":1},{"text":"We-dule e-masmalamala, degi, e-gwenadganmala sulenonikid.","poem":2},{"text":"Wemar bela warambe-gakabo (12) gumalad.","poem":3}]},{"type":"verse","number":26,"cont