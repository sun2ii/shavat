{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":26,"content":[{"type":"heading","content":["Yawagak-dakmalad"]},{"type":"verse","number":1,"content":["Dule-yawagak-dakmalad weyob mimilesmarmogad.",{"text":"Coréʼgi dulemar-danimalad:","poem":1},{"text":"Coré-machi-Meselemías, Asaf-wagwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Meselemías-e-masmaladi, wemalad:","poem":1},{"text":"Zacarías, machi-sailagined. Zacarías-yarbalid, Jediael.","poem":2},{"lineBreak":true},{"text":"Jediael-yarbalid, Zebadías. Zebadías-yarbalid, Jatniel.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Jatniel-yarbalid, Elam. Elam-yarbalid, Johanán.","poem":2},{"lineBreak":true},{"text":"Johanán-yarbalid, Elioenai.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Obed-Edom-e-masmaladi, wemalad:","poem":1},{"text":"Semaías, machi-sailagined, Semaías-yarbalid, Jozabad.","poem":2},{"lineBreak":true},{"text":"Jozabad-yarbalid, Joa. Joa-yarbalid, Sacar.","poem":2},{"lineBreak":true},{"text":"Sacar-yarbalid, Natanael.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Natanael-yarbalid, Amiel.","poem":2},{"lineBreak":true},{"text":"Amiel-yarbalid, Isacar. Isacar-yarbalid, Peultai.","poem":2},{"text":"Ar Bab-Dummad Obed-Edomʼgi nabir binsassoggu, ega masmala-bukidar uksad.","poem":3}]},{"type":"verse","number":6,"content":["Obed-Edom-machi-Semaías masmala-baigan nikusbalid. Wemar, e-babgan-e-gwenadgan-iduedga gudii gusmalad. Ade, we-dulemar, dule-gandikmalad naed."]},{"type":"verse","number":7,"content":[{"text":"Semaías-e-masmaladi, wemalad:","poem":1},{"text":"Otni, Rafael, Obed, Elzabad.","poem":2},{"text":"Wemar, dule-gala-ibegan nanaed.","poem":3},{"text":"Semaías-e-gwenadgan:","poem":1},{"text":"Eliú, degi, Samaquías.","poem":2},{"text":"Wemar, dule-gala-ibegan nanamogad.","poem":3}]},{"type":"verse","number":8,"content":["Bela wemar, Obed-Edom-waganmalad. Wemala, e-wagan-e-masmala, degi, e-gwenadganse-bakar, dule-gala-ibegan-naed, arbaedgi gandikmaladid.",{"text":"Obed-Edom-wagan,","poem":1},{"text":"waladulapaa-gakabo (62) mergued.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Meselemías-e-masmala, degi, e-gwenadganse-bakar,","poem":1},{"text":"warambe-gakabaabak (18) mergued,","poem":2},{"lineBreak":true},{"text":"bela dule-gandikmaladid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Merari-wagwa-Hosaʼye-nugad-e-masmaladi, wemalad:","poem":1},{"text":"Simri, (machi-sailaginedsulinad, degi-inigwele, e-bab, bur-dummadga nug-imaksad).","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Simri-yarbalid, Hilcías.","poem":2},{"lineBreak":true},{"text":"Hilcías-yarbalid, Tebalías.","poem":2},{"lineBreak":true},{"text":"Tebalías-yarbalid, Zacarías.","poem":2},{"text":"Belagwable Hosa-e-masmala, degi, e-gwenadganse-bakar,","poem":1},{"text":"warambe-gakapaa (13) mergued.","poem":2}]},{"type":"verse","number":12,"content":["Weyob dule-yawagak-dakmalad, wachi-wachiba-arbamalaga mimilesmalad. Wemala, degi, e-dummagan, e-gwenadganse-bakale, Bab-Jehováʼse-goled-neggi-arbamalaga mimilesmalad."]},{"type":"verse","number":13,"content":["Yawagak-iliba egi nakulemalagala, burwiganase-bakale, dummaganse-bakale, e-babgan-e-gwenadgan-merguedba, ibmargi-wilubdaklegar yopira mimilesmalad."]},{"type":"verse","number":14,"content":[{"text":"Mimilenaigua, Yawagak-Dad-Nakwedsikid-dakega,","poem":1},{"text":"Selemías sulenonikid.","poem":2},{"text":"Yawagak-Dad-Nakwed-Sapiledsik-dakegardi,","poem":1},{"text":"Selemías-machi-Zacarías sulenonikid.","poem":2},{"lineBreak":true},{"text":"Zacaríasʼde, dule-binsaed-daked-nuedid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yawagak-Dad-Nakwed-Argan-Nuedsikid-dakega,","poem":1},{"text":"Obed-Edom sulenonikid.","poem":2},{"text":"Bab-Dummadse-goled-neggi ibmar-sabolemalad-neg-dakedgi-arbaegardi,","poem":1},{"text":"Obed-Edom-e-masmala sulesmalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dad-argwanedsik Yawagak-Salequetʼye-nugad-dakegardi,","poem":1},{"text":"Supim, Hosaʼbogwa sulesad.","poem":2},{"lineBreak":true},{"text":"A-yawagaksik igar-nakwileged maid.","poem":2},"Wachi-wachiba-arbaleged weyob mimilesad:"]},{"type":"verse","number":17,"content":[{"text":"Iba-ilibali yawagak-dad-nakwedsikidgi,","poem":1},{"text":"Levita-dulemar-nakulemalad, walanergwa (6) bukwamalad.","poem":2},{"text":"Yawagak-dad-nakwed-argan-sapiledsikidgi,","poem":1},{"text":"walabake bukwamarbalid.","poem":2},{"text":"Yawagak-dad-nakwed-argan-nuedsikidgi,","poem":1},{"text":"walabake bukwamarbalid.","poem":2},{"text":"Degi, ibmar-saboleged-neg-iliba,","poem":1},{"text":"agi, ebo-ebo bukwamarbalid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dule dad-argwanedsik neg-imba-naidgi nakulemalaga,","poem":1},{"text":"Levita-dulemar walabake bukwamalad.","poem":2},{"text":"Degi, dule neg-ollor-naid-dakedga,","poem":1},{"text":"walabo gwichibalid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Weyob Coré-wagan, degi, Merari-wagan yawagak-dakmaladgi-arbaega mimiles nanaed.","poem":1}]},{"type":"heading","content":["Dule-mani-dakmalad, degi, dule-dummagan-baigan"]},{"type":"verse","number":20,"content":["Levita-dulemar-baigan, Bab-Dummadse-goled-neggi ibmar-nuegan-gargermalad-bukwad-daked-Ahíasʼga sulesmalad, degi, ibmar-Bab-Dummadga-nugsalegaled-dakedga sulesmarbalid."]},{"type":"verse","number":21,"content":["Gersón-wagwa-Laadán-e-wagan e-neguya-sedimaladi Jehiel-masmala ega gudimalad.",{"text":"Jehiel-e-masmala, wemalad:","poem":1}]},{"type":"verse","number":22,"content":[{"text":"Zetam, degi, Joel.","poem":2},{"text":"Wemar-warbogwad Bab-Jehováʼse-goled-neggi ibmar-nuegan-gargermalad-dakedga sulesmalad.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Deginbali,","poem":1},{"text":"Amram-dulemar-abargi, Izhar-dulemar-abargi,","poem":2},{"lineBreak":true},{"text":"Hebrón-dulemar-abargi, Uziel-dulemar-abargi,","poem":2},{"text":"dule-sulesmalad, wemalad:","poem":1}]},{"type":"verse","number":24,"content":[{"text":"Sebuel, ibmar-Bab-Dummadga-nugsalegaled-daked-e-dummadga nugsalesad.","poem":2},{"text":"Sebuelʼde, Moisés-machi-Gersón-e-wagwad.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Sebuel-e-gwenadgan, e-gwenad-Eliezerʼgi-danikidi, wemar sulesmalad:","poem":1},{"text":"Eliezer-machi-Rehabías. Rehabías-machi-Jesaías.","poem":2},{"lineBreak":true},{"text":"Jesaías-machi-Joram. Joram-machi-Zicri.","poem":2},{"lineBreak":true},{"text":"Zicri-machi-Selomit.","poem":2}]},{"type":"verse","number":26,"content":["Selomit, degi, e-gwenadganmala, Bab-Jehováʼga ibmar-nuegan-nug-imaklegar-bukwad dakedmaladid.",{"text":"We-ibmar-nuegan-nug-imaklegar-bukwad, wemar uksad:","poem":1},{"text":"Rey-David,","poem":2},{"lineBreak":true},{"text":"Israel-e-gwenadgan-e-gwenadgan-e-dummagan,","poem":2},{"lineBreak":true},{"text":"sorda-mili-milibalid-e-dummagan (1,000-1,000),","poem":2},{"lineBreak":true},{"text":"sorda-dulataled-dulataled-e-dummagan (100-100),","poem":2},{"lineBreak":true},{"text":"sorda-dummagan-baigan.","poem":2},{"text":"Selomit, degi, e-gwenadganmala bela a-ibmar dakmaladid.","poem":3}]},{"type":"verse","number":27,"content":["We-ibmarmar bila-onolesadgi sulesmaladid. Degi, we-ibmarmar, Bab-Jehováʼse-goled-neg-nudakega nug-imaksamalad."]},{"type":"verse","number":28,"content":["Deyopira, Selomit, degi, e-gwenadganmala Bab-Dummadga ibmar-belagwable-nug-imaklesad akwismarbalid.",{"text":"We-ibmarmar we-dulemar uksamalad:","poem":1},{"text":"Negburgan-daked-Samuel, Quis-machi-Saúl,","poem":2},{"lineBreak":true},{"text":"Ner-machi-Abner, Sarvia-machi-Joab, degine, dule-baigan.","poem":2},"We-dulemar, Bab-Jehováʼga-we-ibmarmar-belagwable-nug-imaksamalad akwismalad."]},{"type":"verse","number":29,"content":[{"text":"Izhar-e-wagansik:","poem":1},{"text":"Quenanías, degi, e-masmala,","poem":2},{"lineBreak":true},{"text":"Israelʼgi sailaganga mamaid,","poem":2},{"lineBreak":true},{"text":"degi, Israel-dulemarga igar-itoged-dummaganbalid,","poem":2},{"lineBreak":true},{"text":"degine, neggwebur-baiganbo igar-itomaladid.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hebrón-dulemarsik:","poem":1},{"text":"Hasabías, degi, e-gwenadganse-bakar, dule-gandikmalad-naed,","poem":2},{"lineBreak":true},{"text":"bela miligwen gaka dulataled-ilagugle (1,700) mergued.","poem":2},{"text":"Wemar Jordán-diwar-dad-argwanedsik bela Bab-Jehováʼga, degi, reyga arbabukwamalad.","poem":3}]},{"type":"verse","number":31,"content":["Hebrón-dulemar-e-gwenadgan-e-gwenadganga, Jerías e-dummadga maid. Birga-dulabogus (40) Rey-David-yar-semaidgi, nugmar-narmakar-mamaid-gardagi Hebrón-wagan-danimalad amismalad. Agi daklenonikid, Jazer-De-Galaad-neggweburgi Hebrón-waganmar-abargi dule-gandikidmalad gudimala."]},{"type":"verse","number":32,"content":["Jerías-e-gwenadgan dule-gandikmalad-naed. Amarde, bela milibo gaka dulataled-ilagugle (2,700) mergued. Degi, e-gwenadgan-e-gwenadgan-dummadganga maimarbalid.",{"text":"Rey-David wemar-dakega Jerías-e-gwenadgan-onug-imaksad:","poem":1},{"text":"Rubén-wagan-dakega,","poem":2},{"lineBreak":true},{"text":"Gad-wagan-dakega,","poem":2},{"lineBreak":true},{"text":"Manasés-wagan-neg-abalad-dakbaligar.","poem":2},{"lineBreak":true},{"text":"Deginbali, bela Bab-Dummadga negdakega,","poem":2},{"lineBreak":true},{"text":"degi, reyga negdakbaliga onug-imaksabalid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1CH/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1CH/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1CH/25.json","previousChapterAudioLinks":{},"numberOfVerses":32}