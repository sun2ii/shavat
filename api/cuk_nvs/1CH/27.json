{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":27,"content":[{"type":"heading","content":["Sordamar-bila-onomalad-e-dummagan-baigan"]},{"type":"verse","number":1,"content":["Israel-sordamar reyga-arbamalaga, sogambe-gakabo (12) danar-danar bukwamalad. Birgagi nii-irbali, na muchub-muchub arbamalad.",{"text":"Dana-danad-sog-soggwengi mili-dulagwen-gakabake (24,000) sordamar bukwa naed.","poem":1},{"text":"We-dummaganmar, Israel-masmala-nuga-nikamaladid,","poem":2},{"lineBreak":true},{"text":"e-babgan-e-gwenadgan-e-dummaganmalad,","poem":2},{"lineBreak":true},{"text":"sorda-mili-miliba-bukwad-e-dummaganmalad (1,000-1,000),","poem":2},{"lineBreak":true},{"text":"sorda-dulataled-dulataledba-bukwad-e-dummaganmalad (100-100),","poem":2},{"text":"deyob, reyga sordamar-danar-danar-bukwadgi-arbamaladid.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Sorda-mili-dulagwen-gakabakegwad-gebed (24,000), gebe-nii-nagudedgi arbamalad.","poem":1},{"text":"Amar-idugega Fares-e-wagwa-Zabdiel-machi-Jasobeam gudiid.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"We-Jasobeamʼde, bela e-sordamar-idumalad-e-dummadid.","poem":2},{"text":"Wemar gebe-nii-nagudedgi arbamaladid.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Sorda-mili-dulagwen-gakabake-sogbogwad (24,000), nii-warbo-nagudedgi arbamalad.","poem":1},{"text":"Amar-idugega Ahoh-dule-Dodai gudiid.","poem":2},{"lineBreak":true},{"text":"Dodai-e-bendaked Miclotʼye-nugad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sorda-mili-dulagwen-gakabake-sogbaagwad (24,000), nii-warbaa-nagudedgi arbamalad.","poem":1},{"text":"Amar-idugega Joiada-machi-Benaía gudiid.","poem":2},{"text":"Joiadaʼde, dule-irwa-Bab-Dummadse-goled-bur-dummadid.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Benaíaʼdi, sorda-gandikmalad-dulagwen-gakambegid-e-sordad (30), degi, e-dummadbalid.","poem":2},{"text":"Benaía-e-machidi, Amisabadʼye nugad.","poem":1},{"text":"We, sorda-mili-dulagwen-gakabake-sogbaagwad-e-dummadga (24,000) gudiid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sorda-mili-dulagwen-gakabake-sogabakegwad (24,000), nii-warbake-nagudedgi arbamalad.","poem":1},{"text":"Joab-e-urba-Asael, amar-e-dummadid.","poem":2},{"lineBreak":true},{"text":"Geb Asael-sorba, e-machi-Zebadías-nuggusad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sorda-mili-dulagwen-gakabake-sogataled (24,000), nii-walatar-nagudedgi arbamalad.","poem":1},{"text":"Izra-dule-Samhut, amar-e-dummadid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sorda-mili-dulagwen-gakabake-soganergwad (24,000), nii-walanergwa-nagudedgi (6) arbamalad.","poem":1},{"text":"Tecoaʼgined-Iques-e-machi-Ira, amar-e-dummadid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sorda-mili-dulagwen-gakabake-sogagugled (24,000), nii-walagugle-nagudedgi (7) arbamalad.","poem":1},{"text":"Peloni-dule-Efraín-wagwa-Helesʼye-nugad, amar-e-dummadid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sorda-mili-dulagwen-gakabake-sogabaabakad (24,000), nii-walabaabak-nagudedgi (8) arbamalad.","poem":1},{"text":"Husaʼgined, Zera-e-wagwa-Sibecaiʼye-nugad, amar-e-dummadid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sorda-mili-dulagwen-gakabake-sogabakebakad (24,000), nii-walabakebak-nagudedgi (9) arbamalad.","poem":1},{"text":"Anatotʼgined, Benjamín-wagwad-Abiezerʼye-nugad, amar-e-dummadid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sorda-mili-dulagwen-gakabake-sogambegwad (24,000), nii-warambe-nagudedgi (10) arbamalad.","poem":1},{"text":"Netofaʼgined, Zera-wagwa-Maharaiʼye-nugad, amar-e-dummadid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sorda-mili-dulagwen-gakabake-sogambe-gakagwensakad (24,000), nii-warambe-gakagwensakad-nagudedgi (11) arbamalad.","poem":1},{"text":"Piratónʼgined, Efraín-wagwa-Benaíaʼye-nugad, amar-e-dummadid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sorda-mili-dulagwen-gakabake-sogambe-gakabogwad (24,000), nii-warambe-gakabo-nagudedgi (12) arbamalad.","poem":1},{"text":"Netofaʼgined, Otoniel-wagwa-Heldaiʼye-nugad, amar-e-dummadid.","poem":2}]},{"type":"heading","content":["Israel-dulemar-danar-danar-bukwad-e-saila-dummagan"]},{"type":"verse","number":16,"content":["Israel-dulemar-danar-danar-bukwamalad-e-saila-dummagan, wemalad:",{"text":"Rubén-wagan-e-dummad: Zicri-e-machi-Eliezer.","poem":1},{"lineBreak":true},{"text":"Simeón-wagan-e-dummaddi: Maaca-e-machi-Sefatías.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Levita-dulemar-e-dummaddi: Kemuel-e-machi-Hasabías.","poem":1},{"lineBreak":true},{"text":"Aarón-wagan-e-dummaddi: Sadoc.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Judá-wagan-e-dummaddi: David-e-ia-gwensak-Eliú.","poem":1},{"lineBreak":true},{"text":"Isacar-wagan-e-dummaddi: Micael-e-machi-Omri.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Zabulón-wagan-e-dummaddi: Abdías-e-machi-Ismaías.","poem":1},{"lineBreak":true},{"text":"Neftalí-wagan-e-dummaddi: Azriel-e-machi-Jerimot.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Efraín-wagan-e-dummaddi: Azazías-e-machi-Oseas.","poem":1},{"lineBreak":true},{"text":"Manasés-wagan-negabalad-e-dummaddi: Pedaías-e-machi-Joel.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Manasés-wagan-baid-negabar Galaadʼgi-bukwabalid-e-dummaddi:","poem":1},{"text":"Zacarías-e-machi-Iddo.","poem":2},{"text":"Benjamín-wagan-e-dummaddi: Abner-e-machi-Jaasiel.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Dan-wagan-e-dummaddi: Jeroham-e-machi-Azareel.","poem":1},{"text":"Wemar, Israel-e-sailagan-dummaganad.","poem":3}]},{"type":"verse","number":23,"content":["David dulemar-birga-dulagwen-akuar-nikamaladdi (20) ebichissulid. Ar ade, Bab-Jehová sogsagusad: “Israel-dulemar niisgwamar-merguedyob an omelogoye.”"]},{"type":"verse","number":24,"content":["Sarvia-machi-Joab, dule-ebisdegua, obelossurgusad, ar durbas boni-dummad Israel-dulemargi yolenonikid. A-ulale, Rey-David-negsemaid-ibagangi, sordamar-mergued, ibmar-imaklesmalad-narmakar-maid-gardagi narmaklessulid."]},{"type":"heading","content":["Reyga-arbamalad-e-dummagan"]},{"type":"verse","number":25,"content":["Reyga-arbamalad-e-dummagan, wemalad:",{"text":"Adiel-machi-Azmavet,","poem":1},{"text":"reyga-manimar-dakedid.","poem":2},{"text":"Uzías-machi-Jonatánʼdi, we-ibmarmar-dakedid:","poem":1},{"text":"Sapurmar-e-ibmar-nuegan,","poem":2},{"lineBreak":true},{"text":"neggwebur-senigana-e-ibmar-nuegan,","poem":2},{"lineBreak":true},{"text":"neggwebur-dummagan-e-ibmar-nuegan,","poem":2},{"lineBreak":true},{"text":"degi, neg-matusulid-e-ibmar-nuegan-dakedid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Quelub-machi-Ezri,","poem":1},{"text":"dulemar-sapurba-ibmar-digmaladgi-arbamalad-dakedid.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ramat-neggweburgined-Simei,","poem":1},{"text":"uva-nainumar-dakedid.","poem":2},{"text":"Sifmit-neggweburgined-Zabdi,","poem":1},{"text":"uva-nis-saboleged-neg-dakedid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Gederita-dule-Baal-Hanán,","poem":1},{"text":"Sefela-yargi olivo-sapimar-bukwad,","poem":2},{"lineBreak":true},{"text":"degi, higuera-sapimar-bukwad-dakedid.","poem":2},{"text":"Joásʼdi,","poem":1},{"text":"saboleged-neggi olivo-gwallu-bukwad-dakedid.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Sarónʼgined-Sitraiʼdi,","poem":1},{"text":"Sarón-e-gagan-nainumargi moli-bebe-nikmalad-bukwad-dakedid.","poem":2},{"text":"Adlai-machi-Safatʼdi,","poem":1},{"text":"yar-imbaba-neba-naidgi moli-bebe-nikmalad-bukwad-dakedid.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ismael-dule-Obilʼdi,","poem":1},{"text":"moli-yargan-muregemalad-dakedid.","poem":2},{"text":"Meronot-dule-Jehedíasʼdi,","poem":1},{"text":"moli-uayasuid-omemar-dakedid.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Agareno-dule-Jazizʼdi,","poem":1},{"text":"sibad-wawaad-dakedid.","poem":2},{"text":"We-dulemar, belagwable David-nainugangi arbamaladid.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"David-e-gilor-Jonatán,","poem":1},{"text":"reyga binsaed-ukedid,","poem":2},{"lineBreak":true},{"text":"degi, dule-binsaed-nikaa-ibmar-imakedid,","poem":2},{"lineBreak":true},{"text":"deginbali, reyga gardamar-seedbalidid.","poem":2},{"text":"Hacmoni-machi-Jehielʼdi,","poem":1},{"text":"rey-e-masmala-akwediid.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ahitofelʼdi,","poem":1},{"text":"reyga binsaed-dakedid.","poem":2},{"text":"Arquita-dule-Husaiʼdi,","poem":1},{"text":"rey-e-ai-walikagwadid.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Ahitofel-sorbali, Benaía-machi-Joiada, Abiatar-ebo,","poem":1},{"text":"reyga binsaed-dakmarmogadid.","poem":2},{"tex