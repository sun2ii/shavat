,"content":["Deunni, David birgagugle (7) gaka-nii-walanergwa (6) Hebrónʼgi negsemaidgi we-masmala-walanergwadi (6), ega gwalulesad. David, Jerusalénʼgi birga-dulagwen-gakambe-gakapaa (33) yar-semai gusad."]},{"type":"verse","number":5,"content":["Jerusalénʼgi, masmala-walabake ega gwalulesbalid.",{"text":"Amar, wemalad:","poem":1},{"text":"Simea, Sobab, Natán, degi, Salomón.","poem":2},{"text":"Wemar, Amiel-sisgwa-Betsabé-e-masmalad.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"David masmala-baigan walabakebak (9) nikusbalid:","poem":1},{"text":"Ibhar, Elisama, Elifelet,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Noga, Nefeg, Jafía,","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Elisama, Eliada, degi, Elifelet.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bela-wemar, David-e-masmala gued.","poem":3},{"text":"We-masmala-e-bundina, Tamarʼye nugad.","poem":2},{"text":"E-omegan-dikarbarmaladbo-machimala-baklesaddi, soglesulid.","poem":1}]},{"type":"heading","content":["Judá-yar-e-reymar"]},{"type":"verse","number":10,"content":[{"text":"Weyob Salomón-e-waganmar danikid:","poem":1},{"text":"E-machi-Roboam. Roboam-e-machidi, Abías.","poem":2},{"lineBreak":true},{"text":"Abías-e-machidi, Asa. Asa-e-machidi, Josafat.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Josafat-e-machidi, Joram. Joram-e-machidi, Ocozías.","poem":2},{"lineBreak":true},{"text":"Ocozías-e-machidi, Joás.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Joás-e-machidi, Amasías. Amasías-e-machidi, Azarías.","poem":2},{"lineBreak":true},{"text":"Azarías-e-machidi, Jotam.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Jotam-e-machidi, Acaz. Acaz-e-machidi, Ezequías.","poem":2},{"lineBreak":true},{"text":"Ezequías-e-machidi, Manasés.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Manasés-e-machidi, Amón. Amón-e-machidi, Josías.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Josías-e-masmala, wemalad:","poem":1},{"text":"E-machi-sailagined, Johanán.","poem":2},{"lineBreak":true},{"text":"Johanán-yarbalidi, Joacim.","poem":2},{"lineBreak":true},{"text":"Joacim-yarbalidi, Sedequías.","poem":2},{"lineBreak":true},{"text":"Sedequías-yarbalidi, Salum.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Joacim-e-masmaladi, wemalad:","poem":1},{"text":"Jeconías, degi, Sedequías.","poem":2}]},{"type":"heading","content":["Jeconías-wagan"]},{"type":"verse","number":17,"content":[{"text":"Jeconías-gales-selesgusad-e-masmala, wemalad:","poem":1},{"text":"Asir, Salatiel,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Malquiram, Pedaías, Senazar,","poem":2},{"lineBreak":true},{"text":"Jecamías, Hosama, degi, Nedabías.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Pedaías-e-masmaladi, wemarmogad:","poem":1},{"text":"Zorobabel, degi, Simei.","poem":2},{"text":"Zorobabel-e-masmaladi, wemarmogad:","poem":1},{"text":"Mesulam, degi, Hananías.","poem":2},{"text":"We-masmala-e-bundina, Selomitʼye nugad.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Zorobabel, masmala-baigan walatar nikusbalid:","poem":1},{"text":"Hasuba, Ohel, Berequías,","poem":2},{"lineBreak":true},{"text":"Hasadías, degi, Jusab-Hesed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hananías-e-wagan, wemalad:","poem":1},{"text":"E-machi, Pelatías.","poem":2},{"lineBreak":true},{"text":"Pelatías-e-machidi, Jesaías.","poem":2},{"lineBreak":true},{"text":"Jesaías-e-machidi, Jefaías.","poem":2},{"lineBreak":true},{"text":"Jefaías-e-machidi, Refaías.","poem":2},{"lineBreak":true},{"text":"Refaías-e-machidi, Arnán.","poem":2},{"lineBreak":true},{"text":"Arnán-e-machidi, Abdías.","poem":2},{"lineBreak":true},{"text":"Degi, Abdías-e-machidi, Secanías.","poem":2}]},{"type":"verse","number":22,"content":[{"t