{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":4,"content":[{"type":"heading","content":["Judá-wagan-baigan"]},{"type":"verse","number":1,"content":[{"text":"Judá-e-wagan-baigan, wemalad:","poem":1},{"text":"Fares, Hezrón, Carmi,","poem":2},{"lineBreak":true},{"text":"Hur, degi, Sobal.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sobal-machi-Reaía, machi-Jahat-nikusad.","poem":1},{"text":"Jahatʼdi, machi-Ahumai-nikusad,","poem":2},{"lineBreak":true},{"text":"degi, machi-Lahad-nikusbalid.","poem":2},{"text":"Jahatʼgi, Zora-dulemar danikid.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Etam-e-masmala Hur-e-wagan, wemalad:","poem":1},{"text":"Jezreel, Isma, degi, Ibdas.","poem":2},{"lineBreak":true},{"text":"Wemar-e-bundi, Haze-Lelponiʼye nugad.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Penuelʼdi, Gedor-e-babad.","poem":2},{"lineBreak":true},{"text":"Ezerʼdi, Husa-e-babad.","poem":2},{"text":"Wemar, Hur-e-waganad.","poem":3},{"text":"Hurʼde, Efrata-e-machi-sailaginedid.","poem":2},{"text":"Efrataʼde, Belén-neggwebur-dulemar-e-dadsailad.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tecoa-neggwebur-dulemar-e-dadsaila-Asur, ome-walabo nikusad:","poem":1},{"text":"Hela, Naara.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naara, we-masmala baksad:","poem":1},{"text":"Ahuzam, Hefer, Temeni, degi, Ahastari.","poem":2},{"text":"Wemar, Naara-e-masmalad.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Hela-e-masmaladi, wemarmogad:","poem":1},{"text":"Zeret, Jezoar, Etnán, degi, Cos.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Cosʼdi, warbo masmala nikusad:","poem":1},{"text":"Anub, Zobeba.","poem":2},{"lineBreak":true},{"text":"Cosʼde, Aharhel-e-wagan-e-dadsailad.","poem":2},{"lineBreak":true},{"text":"Aharhelʼde, Harum-machid.","poem":2}]},{"type":"verse","number":9,"content":["Jabesʼdi, bur bule e-gwenadganba nug-nika megisad. E-nan Jabesʼye-onug-imaksad, ade soged: “Bonigan-abalagi an na mimmi-nikusye.”"]},{"type":"verse","number":10,"content":["Jabes, Israel-e-Bab-Dummadse gochad, ega sogded: “An bese wilesagwa egise, be ise-nued-angi-binsae, napa-dummad be wis anga uke. Be wis an-bendake, mer bar boni-dummadba wilegegar.” Jabes, Bab-Dummadse-ibmar-egichisadi, Bab-Dummad ega imaksad."]},{"type":"verse","number":11,"content":[{"text":"Súa-urba-Quelub, machi-Mehir-nikunonikid.","poem":1},{"text":"Mehirʼdi, Estón-e-babad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Estón masmala-nikusadi, wemalad:","poem":1},{"text":"Bet-Rafa, Paseah, Tehina.","poem":2},{"text":"Tehinaʼde, Nahas-neggwebur-e-dadsailad.","poem":3},{"lineBreak":true},{"text":"Wemar, Reca-dulemarga gunonikid.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Cenaz-e-masmala, wemalad:","poem":1},{"text":"Otoniel, Seraías.","poem":2},{"text":"Otoniel-e-masmaladi, wemarmogad:","poem":1},{"text":"Hatat, degi, Meonotai.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Meonotaiʼdi, machi-Ofra-nikusad.","poem":2},{"lineBreak":true},{"text":"Seraíasʼdi, machi-Joab-nikusmogad.","poem":2},{"text":"Joabʼde, dulemar-Carisim-nebagi-bukwamalad-e-dadsailad.","poem":3},{"lineBreak":true},{"text":"We-dulemarde, ibmar-sobedgi-arbamaladid.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Jefone-machi-Caleb-e-masmala, wemalad:","poem":1},{"text":"Iru, Ela, Naam.","poem":2},{"text":"Ela-e-machidi, wedid:","poem":1},{"text":"Cenaz.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jehalelel-e-masmala, wemalad:","poem":1},{"text":"Zif, Zifa, Tirías, degi, Asareel.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Esdras-e-masmala, wemalad:","poem":1},{"text":"Jeter, Mered, Efer, degi, Jalón.","poem":2},{"text":"Mered, e-ome-Bitiaʼye-nugadga we-mimmigan-baksad:","poem":1},{"text":"María, Samai, Isba.","poem":2},{"lineBreak":true},{"text":"Isbaʼde, Estemoa-e-babad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wemar, Faraón-e-sisgwa-Bitia-e-mimmiganad.","poem":3},"Mered-e-ome-baid-Jehudaíaʼye-nugad, Judá-duled.",{"text":"A-omede, machimala-baksamogad:","poem":1},{"text":"Jered, Heber, Jecutiel. Jeredʼdi, Gedor-e-babad.","poem":2},{"lineBreak":true},{"text":"Heberʼdi, Soco-e-babad. Jecutielʼdi, Zanoa-e-babad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hodías, Naham-e-bun nikusad. A-ebogwa, wemar-baksad:","poem":1},{"text":"Keila, Estemoa.","poem":2},{"text":"Keilaʼde, Garmita-duled,","poem":3},{"lineBreak":true},{"text":"degi, Estemoaʼdi, Maaca-duled","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Simón-e-masmala, wemalad:","poem":1},{"text":"Amnón, Rina, Ben-Hanán, degi, Tilón.","poem":2},{"text":"Isi-e-wagandi, wemalad:","poem":1},{"text":"Zohet, Benzohet.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Judá-machi-Sela-e-masmala, wemalad:","poem":1},{"text":"Er, Laada","poem":2},{"lineBreak":true},{"text":"Erʼde, Leca-neggwebur-dulemar-e-dadsailad.","poem":2},{"lineBreak":true},{"text":"Laadaʼde, Maresa-e-babad,","poem":2},{"text":"degi, Laadaʼde, Bet-Asbea-neg-nugadgi lino-morgi-arbamalad-e-dadsailabalid.","poem":3}]},{"type":"verse","number":22,"content":["Sela-e-wagandi, wemalad:",{"text":"Joacim, degi, Cozebaʼginmalad.","poem":2},{"lineBreak":true},{"text":"Deginbali, Joás, Saraf.","poem":2},"Wemar-warbogwad Belén-neggweburse gannar-daged-iduale, Moab-yargi negsemai gusmalad. We-ibmar-gusad garda-sergangi narmakar maid."]},{"type":"verse","number":23,"content":["We-dulemar napsagi-arbamaladid. Netaín-neggweburgi, degi, Guederá-neggweburgi gudii gusmalad. Agine, we-dulemar reyga arbadii gusmalad."]},{"type":"heading","content":["Simeón-wagan"]},{"type":"verse","number":24,"content":[{"text":"Simeón-e-waganmar, wemalad:","poem":1},{"text":"Nemuel, Jamín, Jarib, Zera, degi, Saúl.","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Saúlʼdi, Salum-e-babad.","poem":2},{"lineBreak":true},{"text":"Salumʼdi, Mibsam-e-babad. Mibsamʼdi, Misma-e-babad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Misma-e-wagan weyob danikid:","poem":1},{"text":"Misma, Hamuel-e-babad.","poem":2},{"lineBreak":true},{"text":"Hamuelʼdi, Zacur-e-babad.","poem":2},{"lineBreak":true},{"text":"Zacurʼdi, Simei-e-babad.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Simei, masmala warambe-gakanergwa (16) nikusad,","poem":1},{"text":"degi, bunamala walanergwa (6) nikusbalid.","poem":2},"Simei-e-gwenadgandina, mimmigan-ichesur nikussurmalad. Agala, Simeón-e-wagan, Judá-e-wagan-mergueyob gussurmalad."]},{"type":"verse","number":28,"content":[{"text":"Simeón-e-wagan, David reyga-megnonikidse, we-neggweburmargi ambikusmalad:","poem":1},{"text":"Beerseba, Molada, Hazar-Sual,","poem":2}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Bilha, Ezem, Tolad,","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Betuel, Horma, Siclag,","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Bet-Marcabot, Hazar-Susim,","poem":2},{"lineBreak":true},{"text":"Bet-Birai, degi, Saaraim.","poem":2},{"text":"Simeón-e-wagan Rey-David reyga-megnonikidse, we-neggweburmar na e-neggweburga imaksamalad.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Simeón-e-wagan-e-neggwebur-burwigana, wemarbalid:","poem":1},{"text":"Etam, Aín, Rimón, Toquén, degi, Asán.","poem":2},{"text":"Bela we-neggwebur-burwigana gwaatar gued.","poem":3}]},{"type":"verse","number":33,"content":["Deginbali, Baal-neg-nugadse bela neggwebur-burwigana neggwebur-dummagan-dikarba-bubukwadi, amargadbalid. Simeón-wagan we-neggweburmargine ambikusmalad."]},{"type":"verse","number":34,"content":[{"text":"Simeón-wagan-e-dadgan-e-dadgan-e-dummagan-e-nugmar, wemalad:","poem":1},{"text":"Mesobab, Jamlec, Amasías-machi-Josías.","poem":2}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Joel, Josibías-machi-Jehú.","poem":2},{"lineBreak":true},{"text":"Josibíasʼdi, Seraías-e-machi. Seraíasʼdi, Asiel-e-machi.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Degine, e-dummagan-baigan, wemalad:","poem":1},{"text":"Elioenai, Jaacoba, Jesohaía,","poem":2},{"lineBreak":true},{"text":"Asaías, Adiel, Jesimiel, Benaía.","poem":2}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Degi, Sifi-machi-Ziza.","poem":2},{"lineBreak":true},{"text":"Sifiʼdi, Alón-e-machi. Alónʼdi, Jedaías-e-machi.","poem":2},{"lineBreak":true},{"text":"Jedaíasʼdi, Simri-e-machi, degi, Simriʼdi, Semaías-e-machi.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Wemar-nug-bilesmaladi, e-gwenadgan-e-dummaganga gudimalad.","poem":3},{"lineBreak":true},{"text":"Degine, e-gwenadgan bela-bela mergusmalad.","poem":3}]},{"type":"verse","number":39,"content":["We-dulemar sibad-wawaadmarga gagan-nuegan-amiegala, Gedor-neg-nugad-dogedse, neba-neg-dad-nakwedsik-naidse mosmalad."]},{"type":"verse","number":40,"content":["Agi, napa-bipisur-unnitiba amismalad, egi gagan-nuegan-bukidar-nai amismalad. A-yargi nabir-bogidik-gudii guleged amismalad. A-yargine, Cam-e-wagan gudimalanad."]},{"type":"verse","number":41,"content":["We-dulemar-nug-bilesmaladi, Ezequías-Judá-e-reyga-maidgine, nonigusmalad. Bela Cam-e-wagan-danar-bukwad oitononimalad, egi naknoni gusmalad. E-ibe bela neg-burwigana-bukwad obelosmalad. Agi moli-omaed-gagan nue-nikasoggu, Cam-dulemar-muchub ambikusmalad. We-garda-narmaklenaigu, bela nug-iduar-bilesmalad, amba agi bukwamalad."]},{"type":"verse","number":42,"content":["Deginbali, we-Simeón-sordamar, e-dulataled-ilatar (500), Seir-yalaganba nade gusmalad. Wemar-e-dummagan-idumalad, Isi-e-masmalad.",{"text":"Amarde, wemalad:","poem":1},{"text":"Pelatías, Nearías, Refaías, degi, Uziel.","poem":2}]},{"type":"verse","number":43,"content":["Degi, Isi-e-masmala bela Amalec-sordamar-napi-wakicha-gudimalad obelosmalad. Isi-e-wagan we-garda-narmaklenaidse agi amba bukwamalad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1CH/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1CH/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1CH/3.json","previousChapterAudioLinks":{},"numberOfVerses":43}