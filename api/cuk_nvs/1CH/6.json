{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":6,"content":[{"type":"heading","content":["Leví-wagan"]},{"type":"verse","number":1,"content":[{"text":"Leví-e-masmala, wemalad:","poem":1},{"text":"Gersón, Coat, Merari.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Coat-e-masmaladi, wemarmogad:","poem":1},{"text":"Amram, Izhar, Hebrón, degi, Uziel.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amram-e-mimmigandi, wemarmogad:","poem":1},{"text":"Aarón, Moisés, María.","poem":2},{"text":"Aarón-e-masmaladi, wemarmogad:","poem":1},{"text":"Nadab, Abiú, Eleazar, degi, Itamar.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Eleazarʼdi, machi-Finees-nikusad.","poem":2},{"lineBreak":true},{"text":"Fineesʼdi, machi-Abisúa-nikusad.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Abisúaʼdi, machi-Buqui-nikusad.","poem":2},{"lineBreak":true},{"text":"Buquiʼdi, machi-Uzi-nikusad.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Uziʼdi, machi-Zeraías-nikusad.","poem":2},{"lineBreak":true},{"text":"Zeraíasʼdi, machi-Meraiot-nikusad.","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Meraiotʼdi, machi-Amarías-nikusad.","poem":2},{"lineBreak":true},{"text":"Amaríasʼdi, machi-Ahitob-nikusad.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ahitobʼdi, machi-Sadoc-nikusad.","poem":2},{"lineBreak":true},{"text":"Sadocʼdi, machi-Ahimaas-nikusad.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ahimaasʼdi, machi-Azarías-nikusad.","poem":2},{"lineBreak":true},{"text":"Azaríasʼdi, machi-Johanán-nikusad.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Degi, Johanánʼdi, machi-Azarías-nikusad.","poem":2},{"text":"Azaríasʼde, Jerusalénʼgi Salomón-Bab-Dummadse-goled-neg-sobsadgi dule-irwa-Bab-Dummadse-goledga maigusad.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"Azarías, machi-Amarías-nikusad.","poem":2},{"lineBreak":true},{"text":"Amaríasʼdi, machi-Ahitob-nikusad.","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ahitobʼdi, machi-Sadoc-nikusad.","poem":2},{"lineBreak":true},{"text":"Sadocʼdi, machi-Salum-nikusad.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Salumʼdi, machi-Hilcías-nikusad.","poem":2},{"lineBreak":true},{"text":"Hilcíasʼdi, machi-Azarías-nikusad.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Azaríasʼdi, machi-Seraías-nikusad.","poem":2},{"lineBreak":true},{"text":"Degi, Seraíasʼdi, machi-Josadac-nikusad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Degi, Josadac gales-selesad.","poem":3},"Deunni, Bab-Jehová Judá-dulemar, degi, Jerusalén-dulemar, Nabucodonosorʼse-galegega imaksad."]},{"type":"verse","number":16,"content":[{"text":"Leví-e-masmala, wemalad:","poem":1},{"text":"Gersón, Coat, Merari.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gersón-e-masmaladi, wemarmogad:","poem":1},{"text":"Libni, degi, Simei.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Coat-e-masmaladi, wemarmogad:","poem":1},{"text":"Amram, Izhar, Hebrón, degi, Uziel.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Merari-e-masmaladi, wemarmogad:","poem":1},{"text":"Mahli, degi, Musi.","poem":2},"Leví-wagan-e-dadgangi-danimaladi, wemalad."]},{"type":"verse","number":20,"content":[{"text":"Gersón-e-wagandi, wemarmogad:","poem":1},{"text":"Gersón-e-machi, Libni. Libni-e-machi, Jahat. Jahat-e-machi, Zima.","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Zima-e-machi, Joa. Joa-e-machi, Iddo. Iddo-e-machi, Zera.","poem":2},{"lineBreak":true},{"text":"Degi, Zera-e-machi, Jeatrai.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Coat-e-wagandi, wemarmogad:","poem":1},{"text":"Coat-e-machi, Aminadab. Aminadab-e-machi, Coré.","poem":2},{"lineBreak":true},{"text":"Coré-e-machi, Asir.","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Asir-e-machi, Elcana.","poem":2},{"lineBreak":true},{"text":"Elcana-e-machi, Ebiasaf. Ebiasaf-e-machi, Asir.","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Asir-e-machi, Tahat. Tahat-e-machi, Uriel.","poem":2},{"lineBreak":true},{"text":"Uriel-e-machi, Uzías. Degi, Uzías-e-machi, Saúl.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Elcana-e-masmaladi, wemarmogad:","poem":1},{"text":"Amasai, Ahimot.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ahimot-e-wagandi, wemarmogad:","poem":1},{"text":"Ahimot-e-machi, Elcana. Elcana-e-machi, Zofai.","poem":2},{"lineBreak":true},{"text":"Zofai-e-machi, Nahat.","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Nahat-e-machi, Eliab. Eliab-e-machi, Jeroham.","poem":2},{"lineBreak":true},{"text":"Degi, Jeroham-e-machi, Elcana.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Samuel-e-masmaladi, wemarmogad:","poem":1},{"text":"Vasni, e-machi-sailaginedid, degi, Abías.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Merari-e-wagandi, wemarmogad:","poem":1},{"text":"Merari-e-machi, Mahli. Mahli-e-machi, Libni.","poem":2},{"lineBreak":true},{"text":"Libni-e-machi, Simei. Simei-e-machi, Uza.","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Uza-e-machi, Simea. Simea-e-machi, Haguía.","poem":2},{"lineBreak":true},{"text":"Degi, Haguía-e-machi, Asaías.","poem":2}]},{"type":"heading","content":["David dule-namakmalad-onug-imaksad"]},{"type":"verse","number":31,"content":["Bab-Dummad-Israel-Dadganbo-Igar-Mesisad-Ulu Bab-Jehováʼse-goled-neggi-sigisadgine, David dulemar-namakmalad nug-imaksad."]},{"type":"verse","number":32,"content":["Amar, amba yoo Salomón Jerusalénʼgi Bab-Jehováʼse-goled-neg-sobeunni, Bab-Dummadse-goled-neg-asabin Bab-Dummad-dulemarbo-ambikued-neggi, namakbukwadamalad. Geb a-sorba, a-dulemar amba deyob David-ega-igar-mesisadba, namakdii gusmalad."]},{"type":"verse","number":33,"content":["We-dulemar, degi, e-masmalamala, namakdii gusmalad. Amar, wemalad:",{"text":"Coat-e-wagangi-danimalad, wemalad:","poem":1},{"text":"Namaked-dule-Hemán, Joel-e-machi. Joelʼdi, Samuel-e-machi.","poem":2}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Samuelʼdi, Elcana-e-machi. Elcanaʼdi, Jeroham-e-machi.","poem":2},{"lineBreak":true},{"text":"Jerohamʼdi, Eliel-e-machi. Elielʼdi, Toa-e-machi.","poem":2}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Toaʼdi, Zuf-e-machi. Zufʼdi, Elcana-e-machi.","poem":2},{"lineBreak":true},{"text":"Elcanaʼdi, Mahat-e-machi. Mahatʼdi, Amasai-e-machi.","poem":2}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Amasaiʼdi, Elcana-e-machi. Elcanaʼdi, Joel-e-machi.","poem":2},{"lineBreak":true},{"text":"Joelʼdi, Azarías-e-machi. Azaríasʼdi, Sofonías-e-machi.","poem":2}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Sofoníasʼdi, Tahat-e-machi. Tahatʼdi, Asir-e-machi.","poem":2},{"lineBreak":true},{"text":"Asirʼdi, Ebiasaf-e-machi. Ebiasafʼdi, Coré-e-machi.","poem":2}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Coréʼdi, Izhar-e-machi. Izharʼdi, Coat-e-machi.","poem":2},{"lineBreak":true},{"text":"Coatʼdi, Leví-e-machi. Degi, Levíʼdi, Israel-e-machi.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Namaklealile, Hemán-e-argan-nuedsik e-gwenad-Asaf gwisgus daed.","poem":1},{"text":"Asafʼde, Berequías-e-machi, Simea-e-wagwad.","poem":2}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"Simeaʼdi, Micael-e-machi. Micaelʼdi, Baasías-e-machi.","poem":2},{"lineBreak":true},{"text":"Baasíasʼdi, Malquías-e-machi.","poem":2}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Malquíasʼdi, Etni-e-machi.","poem":2},{"lineBreak":true},{"text":"Etniʼdi, Zera-e-machi. Zeraʼdi, Adaía-e-machi.","poem":2}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Adaíaʼdi, Etán-e-machi. Etánʼdi, Zima-e-machi.","poem":2},{"lineBreak":true},{"text":"Zimaʼdi, Simei-e-machi.","poem":2}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Simeiʼdi, Jahat-e-machi.","poem":2},{"lineBreak":true},{"text":"Jahatʼdi, Gersón-e-machi. Degi, Gersónʼdi, Leví-e-machi.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Hemán-e-argan-sapiledsikdina, Merari-e-wagwa-Etán gwisgus daed.","poem":1},{"text":"Etánʼdi, Quisi-e-machi. Quisiʼdi, Abdi-e-machi.","poem":2},{"lineBreak":true},{"text":"Abdiʼdi, Maluc-e-machi.","poem":2}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Malucʼdi, Hasabías-e-machi.","poem":2},{"lineBreak":true},{"text":"Hasabíasʼdi, Amasías-e-machi. Amasíasʼdi, Hilcías-e-machi.","poem":2}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Hilcíasʼdi, Amsi-e-machi. Amsiʼdi, Bani-e-machi.","poem":2},{"lineBreak":true},{"text":"Baniʼdi, Semer-e-machi.","poem":2}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Semerʼdi, Mahli-e-machi.","poem":2},{"lineBreak":true},{"text":"Mahliʼdi, Musi-e-machi. Musiʼdi, Merari-e-machi.","poem":2},{"lineBreak":true},{"text":"Degi, Merariʼdi, Leví-e-machi.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Leví-wagandina, bela Bab-Dummadse-goled-neg-nabir-selegedyagi arbamalaga ogwichilesmalad.","poem":1}]},{"type":"heading","content":["Aarón-wagan"]},{"type":"verse","number":49,"content":["Aarón, degi, e-waganmala, Bab-dummadga-ibmar-ogumakleged-ailagi ibmar-durgan-ogumakar ukdamalad. Degi, ina-wawadikid ogumakar ukdamarbalid. Deginbali, Neg-Ise-Islidikidyaba, Israel-dulemar-e-isgued-eliega, Bab-Dummadga ibmar-durgan-e-abe-ukedgi arbadamarbalid. Igi Moisés-Bab-Dummad-e-mai sogsagusa, deyob imakdamalad."]},{"type":"verse","number":50,"content":[{"text":"Aarón-e-wagandi, wemarmogad:","poem":1},{"text":"Aarón-e-machi, Eleazar, Eleazar-e-machi, Finees.","poem":2},{"lineBreak":true},{"text":"Finees-e-machi, Abisúa.","poem":2}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Abisúa-e-machi, Buqui.","poem":2},{"lineBreak":true},{"text":"Buqui-e-machi, Uzi. Uzi-e-machi, Zeraías.","poem":2}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Zeraías-e-machi, Meraiot. Meraiot-e-machi, Amarías.","poem":2},{"lineBreak":true},{"text":"Amarías-e-machi, Ahitob.","poem":2}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Ahitob-e-machi, Sadoc.","poem":2},{"lineBreak":true},{"text":"Degi, Sadoc-e-machi, Ahimaas.","poem":2}]},{"type":"heading","content":["Levita-dulemar-e-neggweburmar"]},{"type":"verse","number":54,"content":["Aarón-e-waganga neggweburmar, degi, e-moli-ambikued-nainu-abingunanaidi, weyobi mimilesad: Coat-e-waganmargar-inse neggweburmar yamo-sulegarsuli ibmargi-wilubdakar ega uklesad."]},{"type":"verse","number":55,"content":["Amarga, Judá-yargi Hebrón-neggwebur uklesad, degi, we-neggwebur-dikarba moli-ambikumalad-nainuse-bakar, ega uklesad."]},{"type":"verse","number":56,"content":["Jefone-machi-Calebʼga, Hebrón-neggwebur-e-nainugan, degi, e-neggwebur-burwiganase-bakar, uklesad."]},{"type":"verse","number":57,"content":[{"text":"Aarón-e-waganmarga Judá-yargi we-neggweburmar, degi, e-moli-ambikued-nainuse-bakar, ega uklesad:","poem":1},{"text":"Dukued-neggwebur Hebrónʼye-nugad.","poem":2},{"lineBreak":true},{"text":"Libna-neggwebur, Jatir-neggwebur, Estemoa-neggwebur,","poem":2}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"Hilén-neggwebur, Debir-neggwebur,","poem":2}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"Asán-neggwebur, Juta-neggwebur, degi, Bet-Semes-neggwebur.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Benjamín-yargi Aarón-e-waganga we-neggweburmar, degi, e-moli-ambikued-nainuse-bakar, ega uklesad:","poem":1},{"text":"Gabaón-neggwebur, Geba-neggwebur,","poem":2},{"lineBreak":true},{"text":"Alemet-neggwebur, degi, Anatot-neggwebur.","poem":2},{"text":"Bela-neggwebur sogambe-gakapaa (13) Coat-e-waganga uklesad, e-dula-merguedba ega uklesad.","poem":1}]},{"type":"verse","number":61,"content":["Coat-e-dadgan-e-dadganba, Manasés-wagan-negabalad-e-neggwebur-gwaambe (10) ega uklesad, yamo-sulegarsuli, ega ibmargi-wilubdaklegar uklesad."]},{"type":"verse","number":62,"content":[{"text":"Gersón-e-waganga, e-dadgan-e-dadganba ega we-neggweburmar abar-abar uklesad:","poem":1},{"text":"Isacar-e-wagan-e-neggweburmar, Aser-e-wagan-e-neggweburmar,","poem":2},{"lineBreak":true},{"text":"Neftalí-e-wagan-e-neggweburmar,","poem":2},{"lineBreak":true},{"text":"degi, Basán-yargi Manasés-wagan-negabalad-e-neggweburmar ega uklesad.","poem":2},{"text":"Belagwable, neggwebur gwaambe-gakapaa (13) ega uklesad.","poem":1}]},{"type":"verse","number":63,"content":["Merari-e-waganga, e-dadgan-e-dadganba neggweburmar yamo-sulegarsuli, ega ibmargi-wilubdaklegar uklesad.",{"text":"We-neggweburmar abar-abar ega uklesad:","poem":1},{"text":"Rubén-e-wagan-e-neggweburmar, Gad-e-wagan-e-neggweburmar,","poem":2},{"lineBreak":true},{"text":"degi, Zabulón-e-wagan-e-neggweburmar ega uklesad.","poem":2},{"text":"Belagwable, neggwebur gwaambe-gakabo (12) ega uklesad.","poem":1}]},{"type":"verse","number":64,"content":["Israel-dulemar, Levita-dulemarga neggweburmar, degi, e-moli-ambikued-nainuse-bakar, uksamalad."]},{"type":"verse","number":65,"content":["Levita-dulemarga neggweburmar-yamo-sulegarsuli, ega ibmargi-wilubdaklegar uklesad.",{"text":"We-neggweburmar abar-abar ega uklesad:","poem":1},{"text":"Judá-e-wagan-e-neggweburmar,","poem":2},{"lineBreak":true},{"text":"Simeón-e-wagan-e-neggweburmar,","poem":2},{"lineBreak":true},{"text":"Benjamín-e-wagan-e-neggweburmar,","poem":2},{"lineBreak":true},{"text":"bato we-neggwebur-iduar-bilesmalad ega uklesad.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Coat-e-waganga, Efraín-e-wagan-neggweburmar, degi, e-moli-ambikued-nainuse-bakar, ega uklesad:","poem":1}]},{"type":"verse","number":67,"content":[{"text":"Efraín-yalaganba, Siquem-neggwebur-siid ega uklesad.","poem":2},{"text":"Siquem-neggweburde, dukued-neggweburad.","poem":3},{"text":"Deginbali, we-neggweburmar, degi, e-moli-ambikued-nainuse-bakar, ega uklesbalid:","poem":1}]},{"type":"verse","number":68,"content":[{"text":"Geser-neggwebur, Jocmeam-neggwebur, Bet-Horón-neggwebur,","poem":2}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"Ajalón-neggwebur, degi, Gat-Rimón-neggwebur.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Coat-e-wagan-baiganga Manasés-e-wagan-negabalad-e-neggweburmar, degi, e-moli-ambikued-nainuse-bakar, ega uklesad:","poem":1},{"text":"Aner-neggwebur, degi, Bileam-neggwebur.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Gersón-e-waganga, Manasés-e-wagan-negabalad-e-neggweburmar, degi, e-moli-ambikued-nainuse-bakar, ega uklesad:","poem":1},{"text":"Golán-neggwebur-Basán-yargi-siid,","poem":2},{"lineBreak":true},{"text":"degi, Astarot-neggwebur, ega uklesad.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Gersón-e-waganga, Isacar-e-wagan-e-neggweburmar, degi, e-moli-ambikued-nainuse-bakar, ega uklesbalid:","poem":1},{"text":"Cedes-neggwebur, Daberat-neggwebur,","poem":2}]},{"type":"verse","number":73,"content":[{"lineBreak":true},{"text":"Ramot-neggwebur, degi, Anem-neggwebur, ega uklesbalid.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Gersón-e-waganga, Aser-e-wagan-e-neggweburmar, degi, e-moli-ambikued-nainuse-bakar, ega uklesbalid:","poem":1},{"text":"Masal-neggwebur, Abdón-neggwebur,","poem":2}]},{"type":"verse","number":75,"content":[{"lineBreak":true},{"text":"Hucoc-neggwebur, degi, Rehob-neggwebur, ega uklesbalid.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"Gersón-e-waganga, Neftalí-e-wagan-e-neggweburmar, degi, e-moli-ambikued-nainuse-bakar, ega uklesbalid:","poem":1},{"text":"Cedes-neggwebur Galilea-yargi-siid. Hamón-neggwebur,","poem":2},{"lineBreak":true},{"text":"degi, Quiriataim-neggwebur, ega uklesbalid.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Merari-e-wagan-napi-ambikusmaladga, Zabulón-e-wagan-e-neggweburmar, degi, e-moli-ambikued-nainuse-bakar, ega uklesad:","poem":1},{"text":"Rimón-neggwebur, degi, Tabor-neggwebur, ega uklesad.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Merari-e-waganga, dad-nakwedsik, Jordán-diwar-obakar, Jericó-asabin,","poem":1},{"lineBreak":true},{"text":"Rubén-e-wagan-e-neggweburmar, degi, e-moli-ambikued-nainuse-bakar, ega uklesbalid:","poem":1},{"text":"Beser-neggwebur nega-dulesulidganba-siid.","poem":2},{"lineBreak":true},{"text":"Jaza-neggwebur,","poem":2}]},{"type":"verse","number":79,"content":[{"lineBreak":true},{"text":"Cademot-neggwebur,","poem":2},{"lineBreak":true},{"text":"degi, Mefaat-neggwebur, ega uklesbalid.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Merari-e-waganga, Gad-e-wagan-e-neggweburmar, degi, e-moli-ambikued-nainuse-bakar, ega uklesbalid:","poem":1},{"text":"Ramot-De-Galaad-neggwebur, Mahanaim-neggwebur,","poem":2}]},{"type":"verse","number":81,"content":[{"lineBreak":true},{"text":"Hesbón-neggwebur, degi, Jazer-neggwebur, ega uklesbalid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1CH/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1CH/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1CH/5.json","previousChapterAudioLinks":{},"numberOfVerses":81}