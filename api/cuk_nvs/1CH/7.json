{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":7,"content":[{"type":"heading","content":["Isacar-wagan"]},{"type":"verse","number":1,"content":[{"text":"Isacar-e-masmala-walabakegwad, wemalad:","poem":1},{"text":"Tola, Fúa, Jasub, degi, Simrón.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tola-e-masmala, wemalad:","poem":1},{"text":"Uzi, Refaías, Jeriel, Jahmai,","poem":2},{"lineBreak":true},{"text":"Jibsam, degi, Semuel.","poem":2},{"text":"Wemar, e-gwenadgan-e-gwenadgan-e-dummaganad.","poem":3},"Degine, David-negsemaiunni, Tola-e-wagan dule-bila-onomalad-bulegan, mili-dulagwen-gakabo gaka dulataled-ilanergwa (22,600) mergu-nika daklealid."]},{"type":"verse","number":3,"content":[{"text":"Uzi machi-wargwen-nikusad, Israhíasʼye-nugad.","poem":1},{"lineBreak":true},{"text":"Israhías-e-masmala, wemalad:","poem":1},{"text":"Micael, Obadías, Joel, degi, Isías.","poem":2},{"text":"Bela wemar e-dummagan-walataled gumalad.","poem":3}]},{"type":"verse","number":4,"content":["We-dulemarde omegan-bukidar-nikamarsoggua, degi, mimmigan-bukidar-nikusmarbarsoggua, e-gwenadgan-e-gwenadganba-nug-ilemakar-maidgi, sorda-bila-onomalad-e-nugmar, mili-dulagwen-gakambe-gakanergwa (36,000) mergu-nika daklealid."]},{"type":"verse","number":5,"content":["Isacar-wagan-e-gwenadgan-e-gwenadgangi-bela-danimalad, e-dadgansik-e-nug-ilemakar-mamaidgi dule-gandikmalad-bila-onomalad, mili-dulabake-gakagugle (87,000) mergu-nika daklealid."]},{"type":"heading","content":["Benjamín-wagan"]},{"type":"verse","number":6,"content":[{"text":"Benjamín-e-masmala-warbaagwad, wemalad:","poem":1},{"text":"Bela, Bequer, degi, Jediael.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bela-e-masmaladi, wemarmogad:","poem":1},{"text":"Ezbón, Uzi, Uziel, Jerimot, degi, Iri.","poem":2},{"text":"Wemar-e-ataledi, e-gwenadganga dummaganga gudii gusmalad.","poem":3},{"lineBreak":true},{"text":"A-uki, gala-ibegan nanabalid.","poem":3},"E-dadgansik-e-nug-ilemakar-maidgi, sorda-gandikmalad-bila-onomalad, mili-dulagwen-gakabo gaka dulagwen-gakambe-gakabake (22,034) mergu-nika daklealid."]},{"type":"verse","number":8,"content":[{"text":"Bequer-e-masmaladi, wemarmogad:","poem":1},{"text":"Zemira, Joás, Eliezer, Elioenai, Omri,","poem":2},{"lineBreak":true},{"text":"Jerimot, Abías, Anatot, degi, Alamet.","poem":2},{"text":"Bela-wemar, Bequer-e-masmala gumalad.","poem":3}]},{"type":"verse","number":9,"content":["Amarde, e-gwenadgan-e-dummaganga gudii gusmalad. E-dadgansik nug-ilemakar-maidgi, sorda-gandikmalad-bila-onomalad, mili-dulagwen gaka dulataled-ilabo (20,200) mergu-nika daklealid."]},{"type":"verse","number":10,"content":[{"text":"Jediael-machi weyob nugad:","poem":1},{"text":"Bilhán.","poem":2},{"text":"Bilhán-e-masmaladi, wemarmogad:","poem":1},{"text":"Jeús, Benjamín, Aod, Quenaana,","poem":2},{"lineBreak":true},{"text":"Zetán, Tarsis, degi, Ahisahar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bela-wemar, Jediael-e-wagan gumalad.","poem":3},"A-uki, bela we-masmalade, e-gwenadgan-e-dummaganbalid. Bergwable bila-ononaddamalad, miliambe-gakagugle gaka dulataled-ilabo (17,200) mergued."]},{"type":"verse","number":12,"content":[{"text":"Hir-e-wagan, wemalad:","poem":1},{"text":"Supim-dulemar, Hupim-dulemar.","poem":2},{"lineBreak":true},{"text":"Aher-e-wagan, degi, Husim-dulemar.","poem":2},{"text":"Bela-wemar Hir-e-wagan gumalad.","poem":3}]},{"type":"heading","content":["Neftalí-wagan"]},{"type":"verse","number":13,"content":[{"text":"Neftalí-e-masmala, wemalad:","poem":1},{"text":"Jahzeel, Guni, Jezer, degi, Salum.","poem":2},{"text":"Wemar, Bilha-e-wagan gumalad.","poem":3}]},{"type":"heading","content":["Manasés-wagan"]},{"type":"verse","number":14,"content":[{"text":"Manasés-e-wagan, wemalad:","poem":1},{"lineBreak":true},{"text":"Manasés, Siriaʼgined-e-ome-dikarbalidga masmala walabo baksad,","poem":1},{"text":"Asriel, degi, Maquir.","poem":2},{"text":"Maquirʼdi, Galaad-e-babad.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Maquirʼdi, Hupim, degi, Supim-e-bun Maacaʼye-nugad nikusad.","poem":1},{"text":"Maquir baid-machi nikusad, Zelofehadʼye nugad.","poem":2},{"lineBreak":true},{"text":"Zelofehadʼdi, bunamalabi-nikusad, masmala-nikussulid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Maquir-e-ome-Maaca machigwa-baknonikid,","poem":1},{"text":"Peresʼye onug-imaksad.","poem":2},{"text":"Geb baid-machigwa-baksabalid.","poem":1},{"text":"We-e-urbadina, Seresʼye onug-imaksad.","poem":2},{"text":"Seres-e-masmala, wemalad:","poem":1},{"text":"Ulam, Requem.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ulam-e-machidi, wedid:","poem":1},{"text":"Bedán.","poem":2},{"text":"Wemala, Galaad-e-masmala gumalad.","poem":1},{"text":"Galaadʼde, Maquir-e-machid, Manasés-e-wagwabalid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Galaad-e-bun-Hamolequet, we-masmala baknonikid:","poem":1},{"text":"Isod, Abiezer, degi, Mahala.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Semida-e-masmala, wemalad:","poem":1},{"text":"Ahián, Siquem, Likhi, degi, Aniam.","poem":2}]},{"type":"heading","content":["Efraín-wagan"]},{"type":"verse","number":20,"content":[{"text":"Efraín-e-wagan, wemalad:","poem":1},{"text":"Sutela. Sutela-e-machidi, Bered.","poem":2},{"lineBreak":true},{"text":"Bered-e-machidi, Tahat. Tahat-e-machidi, Elada.","poem":2},{"lineBreak":true},{"text":"Elada-e-machidi, Tahat.","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tahat-e-machidi, Zabad.","poem":2},{"lineBreak":true},{"text":"Degi, Zabad-e-machidi, Sutela.","poem":2},{"text":"Degine, Efraín e-machi-baigandi, wemalad:","poem":1},{"text":"Ezer, degi, Elad.","poem":2},"Wemar-ebogwad Gat-neggweburse moli-bebe-nikamalad-atursaega nadegusmalad. Agine, Gat-dulemar, wemar-ebogwad-oburgwismalad."]},{"type":"verse","number":22,"content":["Efraínʼdi, e-masmala-Ezer, degi, Elad, burgwismalad-ular, beedse-bukib-binsadii gusad. Degi, Efraín-e-gwenadgan, Efraín-baisur-ito-imakega ese nonigusmalad."]},{"type":"verse","number":23,"content":["Deyob-neggusad-sorbali, Efraín e-omese gornonikid. Degidba, e-ome, ega machigwa-baksad. Agala, Efraín, e-neguyagi nunmaked-dummad-nagusadba, Beríaʼye e-machi-onug-imaknonikid."]},{"type":"verse","number":24,"content":[{"text":"Bería-e-sisgwade, Seeraʼye nugad.","poem":1},{"text":"Seeraʼde, Bet-Horón-neggwebur-urbalid urbisad,","poem":2},{"lineBreak":true},{"text":"degi, Bet-Horón-neggwebur-birgined urbisbalid.","poem":2},{"lineBreak":true},{"text":"Deginbali, Uzen-Seera-neggwebur urbisbalid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bería-e-wagan, wemalad:","poem":1},{"text":"Bería-e-machi, Refa. Refa-e-machidi, Resef.","poem":2},{"lineBreak":true},{"text":"Resef-e-machidi, Telah. Telah-e-machidi, Tahán.","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Tahán-e-machidi, Laadán. Laadán-e-machidi, Amiud.","poem":2},{"lineBreak":true},{"text":"Amiud-e-machidi, Elisama.","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Elisama-e-machidi, Nun.","poem":2},{"lineBreak":true},{"text":"Degi, Nun-e-machidi, Josué.","poem":2}]},{"type":"verse","number":28,"content":["We-Efraín-e-waganga yar-uklesad. We-yargi neggweburmar, degi, e-neggwebur-burwiganase-bakar, Efraín-waganga uklesad.",{"text":"We-neggweburmargi, ega Betel-neggwebur uklesad.","poem":1},{"lineBreak":true},{"text":"Dad-nakwedsiki, Naarán-neggwebur ega uklesbalid.","poem":1},{"lineBreak":true},{"text":"Dad-argwanedsiki, Gezer-neggwebur ega uklesbalid.","poem":1},{"lineBreak":true},{"text":"Degi, Siquem-neggwebur-akale, Gaza-neggweburse ega uklesbalid.","poem":1}]},{"type":"verse","number":29,"content":["Efraín-yar Manasés-wagan-e-yarbo-abingunaidgi, Efraín-waganga we-neggweburmar, degi, e-neggwebur-burwiganase-bakale, ega uklesbalid:",{"text":"Bet-Seán-neggwebur, Taanac-neggwebur,","poem":1},{"lineBreak":true},{"text":"Meguido-neggwebur, degi, Dor-neggwebur.","poem":1},{"text":"We-neggwebur-gwabakegwadgi Israel-machi-José-masmala-e-wagan ambikusad.","poem":2}]},{"type":"heading","content":["Aser-wagan"]},{"type":"verse","number":30,"content":[{"text":"Aser-e-masmala, wemalad:","poem":1},{"text":"Imna, Isúa, Isúi, Bería.","poem":2},{"lineBreak":true},{"text":"Degi, a-masmala-e-bundi, Seraʼye nugad.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Bería-e-masmaladi, wemarmogad:","poem":1},{"text":"Heber, Malquiel.","poem":2},{"lineBreak":true},{"text":"Malquielʼdi, Birzavit-e-babad.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Heber mimmigan-nikusadi, wemalad:","poem":1},{"text":"Jaflet, Somer, Hotam.","poem":2},{"lineBreak":true},{"text":"Degi, a-masmala-e-bundi, Súaʼye nugad.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Jaflet-e-masmaladi, wemarmogad:","poem":1},{"text":"Pasac, Bimhal, degi, Asvat.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Semer-e-masmaladi, wemarmogad:","poem":1},{"text":"Ahí, Rohga, Jehúba, degi, Aram.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"E-urba-Helem-e-masmaladi, wemarmogad:","poem":1},{"text":"Zofa, Imna, Seles, degi, Amal.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Zofa-e-masmaladi, wemarmogad:","poem":1},{"text":"Súa, Harnefer, Súal, Beri,","poem":2},{"lineBreak":true},{"text":"Imra,","poem":2}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Beser, Hod, Sama,","poem":2},{"lineBreak":true},{"text":"Silsa, Itrán, degi, Beera.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Jeter-e-masmala, wemalad:","poem":1},{"text":"Jefone, Pispa, degi, Ara.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ula-e-masmala, wemalad:","poem":1},{"text":"Ara, Haniel, degi, Rezia.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Bela-wemar, Aser-e-wagan nanaed.","poem":1},"Degi, bela e-gwenadgan-iduedga gusmaladid. De-ukinbali, dule-nug-nikamalad gusmarbalid, dule-gandikmalad gusmarbalid. E-dadgansik-nug-ilemakar-maidgi, wemar-e-nug narmakar-maidi, dule-bila-ononaddamaladi, mili-dulagwen-gakanergwa (26,000) mergu-nika daklealid."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1CH/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1CH/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1CH/6.json","previousChapterAudioLinks":{},"numberOfVerses":40}