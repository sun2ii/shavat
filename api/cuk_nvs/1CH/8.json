{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":8,"content":[{"type":"heading","content":["Benjamín-wagan"]},{"type":"verse","number":1,"content":[{"text":"Benjamín-e-masmala, wemalad:","poem":1},{"text":"E-machi-sailagined Belaʼye nugad.","poem":2},{"lineBreak":true},{"text":"Bela-yarbali, Asbel nikusad, Asbel-yarbali, Ahara nikusad.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ahara-yarbali, Noha nikusad. Noha-yarbali, Rafa nikusad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Belaʼye-nugad-e-masmaladi, wemarmogad:","poem":1},{"text":"Adar, Gera, Abiud,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Abisúa, Naamán, Ahoa,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gera, Sefufán, degi, Hiram.","poem":2}]},{"type":"verse","number":6,"content":["Aod-e-wagan, Geba-neggweburgi e-gwenadgan-e-dummaganga-gudii gusmalanad.",{"text":"Geb Aod-e-wagan, Manahatʼye-neg-nugadse gales-seles-gusmalad, wemalad:","poem":1}]},{"type":"verse","number":7,"content":[{"text":"Naamán, Ahías, degi, Gera.","poem":2},{"lineBreak":true},{"text":"Geraʼdi, Uza-e-babad, degi, Ahiud-e-babbalid.","poem":2},{"text":"Geraʼde, Manahatʼse e-gwenadgan-idumai gusad.","poem":3}]},{"type":"verse","number":8,"content":["Saharaim, e-ome-Husim metegusad, degi, e-ome-baid-Baara metegusbalid. A-sorbali, Saharaim, Moab-yargi baid-omebo masmala-baksabalid."]},{"type":"verse","number":9,"content":[{"text":"Saharaim, e-ome-Hodesʼbo masmala-baksad, wemalad:","poem":1},{"text":"Jobab, Sibia, Mesa, Malcam,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Jeúz, Saquías, degi, Mirma.","poem":2},{"text":"Wemar, e-gwenadgan-e-dummagan gudii gusmalad.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Saharaim, e-ome-Husimʼbo masmala-baksad, wemalad:","poem":1},{"text":"Abitob, Elpaal.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Elpaal-e-masmaladi, wemarmogad:","poem":1},{"text":"Heber, Misam, degi, Semed.","poem":2},{"text":"Semedʼde, Ono-neggwebur, degi, e-neggwebur-burwiganase-bakar, urbisad,","poem":3},{"lineBreak":true},{"text":"degi, Lod-neggwebur, degi, e-neggwebur-burwiganase-bakar, urbisbalid.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Elpaal-e-masmala-baigan, wemarbalid:","poem":1},{"text":"Bería, degi, Sema.","poem":2},{"text":"Wemar-walataled, e-gwenadgan-Ajalónʼgi-bukwamalad-e-dummaganad.","poem":3},{"lineBreak":true},{"text":"Degi, we-walataled, Gatʼgi-dulemar-bukwad ononnosmarbalid.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Bería-e-masmaladi, wemarmogad:","poem":1},{"text":"Ahío, Sasac, Jeremot,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Zebadías, Arad, Ader,","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Micael, Ispa, degi, Joha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Elpaal-e-masmala-baigan, wemarbalid:","poem":1},{"text":"Zebadías, Mesulam, Hizqui, Heber,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ismerai, Jezlías, degi, Jobab.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Simei-e-masmala, wemalad:","poem":1},{"text":"Jaquim, Zicri, Zabdi,","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Elienai, Ziletai, Eliel,","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Adaías, Beraías, degi, Simrat.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sasac-e-masmaladi, wemarmogad:","poem":1},{"text":"Ispán, Heber, Eliel,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Abdón, Zicri, Hanán,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Hananías, Elam, Anatotías,","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Ifdaiás, degi, Peniel.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Jeroham-e-masmala, wemalad:","poem":1},{"text":"Samserai, Seharías, Atalías,","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Jaresías, Elías, degi, Zicri.","poem":2}]},{"type":"verse","number":28,"content":["We-dulemar, e-gwenadgan-dummaganga gudii gusmalad, degi, Jerusalén-neggweburgi maigusmalad. Amarde, Benjamín-e-wagan-e-nug-ilemakar-maidgi maid."]},{"type":"verse","number":29,"content":["Gabaón-e-bab-Jeiel, Gabaón-neg-nugadgi gudii gusad. Jeiel-e-omedi, Maacaʼye nugad."]},{"type":"verse","number":30,"content":[{"text":"Jeiel-e-masmaladi, wemalad:","poem":1},{"text":"Abdón, e-machi-sailaginedid.","poem":2},{"lineBreak":true},{"text":"Zur, Quis, Baal, Ner, Nadab,","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Gedor, Ahío, Zequer, degi, Miclot.","poem":2}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Miclotʼdi, machi-Simea nikusad.","poem":2},{"text":"Wemar, e-gwenadganba Jerusalén-neggweburgi gudii gusmarmogad.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"Nerʼdi, machi-Quis nikusad. Quisʼdi, machi-Saúl nikusad.","poem":2},{"text":"Saúlʼdi, we-masmala nikusad:","poem":1},{"text":"Jonatán, Malquisúa, Abinadab, degi, Es-Baal.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Jonatán-e-machidi, Merib-Baalʼye nugad.","poem":1},{"text":"Merib-Baalʼdi, machi-Micaía nikusad.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Micaía-e-masmaladi, wemarmogad:","poem":1},{"text":"Pitón, Melec, Tarea, degi, Acaz.","poem":2}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Acazʼdi, machi-Joada nikusad.","poem":2},{"text":"Joadaʼdi, we-masmala nikusad:","poem":1},{"text":"Alemet, Azmavet, degi, Zimri.","poem":2},{"lineBreak":true},{"text":"Zimriʼdi, machi-Mosa nikusad.","poem":2}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Mosaʼdi, machi-Bina nikusad.","poem":2},{"lineBreak":true},{"text":"Binaʼdi, Rafa-e-babad. Rafaʼdi, Elasa-e-babad.","poem":2},{"lineBreak":true},{"text":"Elasaʼdi, Azel-e-babad.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Azel-e-masmaladi, walanergwa (6) gumalad:","poem":1},{"text":"Azricam, Bocru, Ismael,","poem":2},{"lineBreak":true},{"text":"Searías, Obadías, degi, Hanán.","poem":2},{"text":"Bela-wemar, Azel-e-masmalad.","poem":3}]},{"type":"verse","number":39,"content":[{"text":"Azel-e-urba Esecʼye nugad.","poem":2},{"text":"Esec-e-masmaladi, wemarmogad:","poem":1},{"text":"Ulam, e-machi-sailaginedid.","poem":2},{"lineBreak":true},{"text":"Jehús, machi-dummad-yarbalidid,","poem":2},{"lineBreak":true},{"text":"Elifelet, Jehús-yarbalidid.","poem":2}]},{"type":"verse","number":40,"content":["Ulam-e-masmala dule-gala-ibeganad, sigu-mied-buleganad. Amarde, mimmigan-bukidar-nikusmalad, degi, wagan-bukidar-nikusmarbalid. Belagwable, dulagugle-gakambe (150) nikusmalad.",{"text":"Bela-wemala, Benjamín-e-wagan gumalad.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1CH/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1CH/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1CH/7.json","previousChapterAudioLinks":{},"numberOfVerses":40}