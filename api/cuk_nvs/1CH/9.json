{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1CH","translationId":"cuk_nvs","name":"1 Crónicas","commonName":"1 Crónicas","title":"NEG-GUSMALAD-GARDA-GEBED 1 CRÓNICAS","order":13,"numberOfChapters":29,"sha256":"09ad230b0cb90aae421d8f7e6fe8ec4e4ab3844ebc5552367c4400f5729c22b6","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/cuk_nvs/1CH/29.json","totalNumberOfVerses":942},"chapter":{"number":9,"content":[{"type":"heading","content":["Judíoʼmar gannar Jerusalénʼse nonimalad"]},{"type":"verse","number":1,"content":["Israel-dulemar-e-nugmar bela e-dadgan-e-dadganba Israel-e-reymar-gardagi ilemakar megisad. Judá-dulemar, Bab-Dummad-sogedba-dasurmaladba, Babilonia-neggweburse gales-selesgusmalad."]},{"type":"verse","number":2,"content":[{"text":"Wemar-inse gannar e-neggweburmarse nonimalad:","poem":1},{"text":"Israel-dulemar-abala,","poem":2},{"lineBreak":true},{"text":"dule-irwa-Bab-Dummadse-gormalad, Levita-dulemar,","poem":2},{"lineBreak":true},{"text":"degi, Bab-Dummadse-goled-neggi-arbamalad.","poem":2},{"text":"Wemar-inse e-neggweburse, degi, e-nainumar-nanaidse gannar nonimalad.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Amar-abargi, wemar nonimarmogad:","poem":1},{"text":"Judá-dulemar, Benjamín-dulemar,","poem":2},{"lineBreak":true},{"text":"Efraín-dulemar, degi, Manasés-dulemar.","poem":2},{"text":"Wemar, Jerusalén-neggweburgi ambikusmalad.","poem":1}]},{"type":"heading","content":["Judá-wagan"]},{"type":"verse","number":4,"content":[{"text":"Judá-wagan-nonimaladi, wemalad:","poem":1},{"text":"Utai, Amiud-e-machi, Amiud, Omri-e-machi,","poem":2},{"lineBreak":true},{"text":"Omri, Imri-e-machi, Imri, Bani-e-machi,","poem":2},{"lineBreak":true},{"text":"Bani, Fares-e-machi, degi, Fares, Judá-e-machi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Silo-dulemar-nonimarmogad, wemalad:","poem":1},{"text":"Asaías, machi-sailagined, degi, e-masmala.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zera-dulemar-nonimarmogad, wemalad:","poem":1},{"text":"Jeuel, degi, e-gwenadgan.","poem":2},{"text":"Judá-e-wagan bela dulataled-ilanergwa gaka dulabake-gakambe (690) mergu nonimalad.","poem":1}]},{"type":"heading","content":["Benjamín-wagan"]},{"type":"verse","number":7,"content":[{"text":"Benjamín-wagan-nonimalad, wemalad:","poem":1},{"text":"Salú, Mesulam-e-machi,","poem":2},{"lineBreak":true},{"text":"Mesulam, Hodavías-e-machi,","poem":2},{"lineBreak":true},{"text":"Hodavías, Asenúa-e-machi.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ibneías, Jeroham-e-machi.","poem":2},{"lineBreak":true},{"text":"Ela, Uzi-e-machi, Micri-e-wagwa.","poem":2},{"lineBreak":true},{"text":"Mesulam, Sefatías-e-machi, Reuel-e-wagwa.","poem":2},{"lineBreak":true},{"text":"Degi, Reuel, Ibnías-e-machi.","poem":2}]},{"type":"verse","number":9,"content":["Degi, Benjamín-e-wagan, e-dadgan-gardagi-e-nug-ilemakar-mamaid, bela e-gwenadgan-neguyagi dummaganga gudidimalad. Bela we-dulemar, dulataled-ilabakebak gaka dulabo-gakambe-gakanergwa (956) mergued."]},{"type":"verse","number":10,"content":[{"text":"Dule-irwa-Bab-Dummadse-gormalad-nonimalad, wemalad:","poem":1},{"text":"Jedaías, Joiarib, Jaquín,","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Azarías, Hilcías-e-machi, Mesulam-e-wagwa.","poem":2},{"lineBreak":true},{"text":"Mesulam, Sadoc-e-machi, Meraiot-e-wagwa.","poem":2},{"lineBreak":true},{"text":"Meraiot, Ahitob-e-machi.","poem":2},{"text":"Ahitobʼde, Bab-Dummadse-goled-neg-iduedid.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Adaía, Jeroham-e-machi, Pasur-e-wagwa.","poem":2},{"lineBreak":true},{"text":"Pasur, Malquías-e-machi. Masai, Adiel-e-machi, Jazera-e-wagwa.","poem":2},{"lineBreak":true},{"text":"Jazera, Mesulam-e-machi, Mesulam, Mesilemit-e-machi,","poem":2},{"lineBreak":true},{"text":"degi, Mesilemit, Imer-e-machi.","poem":2}]},{"type":"verse","number":13,"content":["Wemar, Bab-Dummadse-goled-neggi-arbadimalad, Jerusalén-neggweburse nonimarmogad. We-dulemar, nue-ibmar-wisi ibmar-imakdamalad. Degine, e-gwenadgan-e-dummaganga-gudidimarbalid. Bela e-gwenadgan-gumaladi, miligwen gaka dulataled-ilagugle gaka dulapaa (1,760) mergumalad."]},{"type":"verse","number":14,"content":[{"text":"Levita-dulemar-nonimalad, wemalad:","poem":1},{"text":"Semaías, Hasub-e-machi. Hasub, Azricam-e-machi.","poem":2},{"lineBreak":true},{"text":"Azricam, Hasabías-e-machi.","poem":2},{"text":"Hasabíasʼde, Merari-wagansikidid.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Bacbacar, Heres, Galal, Matanías, Micaía-e-machi.","poem":2},{"lineBreak":true},{"text":"Micaía, Zicri-e-machi. Zicri, Asaf-e-machi.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Obadías, Semaías-e-machi. Semaías, Galal-e-machi.","poem":2},{"lineBreak":true},{"text":"Galal, Jedutún-e-machi. Berequías, Asa-e-machi.","poem":2},{"lineBreak":true},{"text":"Degine, Asa, Elcana-e-machi.","poem":2},{"text":"We-Elcana, Netofa-dulemar-e-neggwebur-burwigangi maigusad.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Dule-yawagak-dakmalad, Jerusalén-neggweburse-nonimarmogad, wemalad:","poem":1},{"text":"Salum, Acub, Talmón, Ahimán, degi, e-gwenadgan.","poem":2},{"text":"Salumʼde, wemar-e-dummadga gusad.","poem":3}]},{"type":"verse","number":18,"content":["We-Leví-e-wagan, we-garda-narmaklenaidse, Rey-Yawagakye-nugad dad-nakwedsik-siidgi nakulemalaga gudimalad."]},{"type":"verse","number":19,"content":[{"text":"Deginbali, yawagak-dakmalad-baigan-nonimarmogad, wemalad:","poem":1},{"text":"Salum, Coré-e-machi. Coré, Ebiasaf-e-machi.","poem":2},{"lineBreak":true},{"text":"Ebiasaf, Coré-e-machi. Degine, Coré-e-gwenadgan.","poem":2},"Wemar, Bab-Dummad-dulemarbo-ambikued-neg-yawagak-dakmaladid. Igi-epenne, e-babgan, Bab-Jehováʼse-goled-neg-e-yawagak-dakega gudii damarmoga, deyob yawagak-dakmarmogadid."]},{"type":"verse","number":20,"content":["Wemar-iduale, Eleazar-machi-Finees, yawagak-dakmalad-e-iduedga gudii gusad. Degine, Bab-Jehová eba-gudii gusad."]},{"type":"verse","number":21,"content":["Meselemías-machi-Zacarías, Bab-Dummad-dulemarbo-ambikued-neg-yawagak-dakedid."]},{"type":"verse","number":22,"content":["Belagwable we-dulemar, yawagakgi-nakulegega-sulesmaladi, dulataled-ilabo gakambe-gakabo (212) mergu daklealid. E-neggwebur-burwiganagi, e-nugmar gardagi-ilemakar-mamaid. David, degi, dule-negburgan-daked-Samuelʼbogwa, nakulegega we-dulemar-nug-imaksa gusad."]},{"type":"verse","number":23,"content":["We-dulemar-yawagakgi-nakulemaladi, degi, e-waganmar, Bab-Jehováʼse-goled-dordoneg-e-yawagakgi nakulemalaga, muchub-muchub ambikudamalad."]},{"type":"verse","number":24,"content":["Dule-yawagakgi-nakulemaladi, Bab-Dummadse-goled-dordoneggi nakulebuk nanaed:",{"text":"Bab-Dummadse-goled-dordoneg-e-dikar-dad-nakwedsik,","poem":1},{"lineBreak":true},{"text":"Bab-Dummadse-goled-dordoneg-e-dikar-dad-argwanedsik,","poem":1},{"lineBreak":true},{"text":"Bab-Dummadse-goled-dordoneg-e-dikar-dad-nakwed-argan-sapiledsik,","poem":1},{"lineBreak":true},{"text":"degi, Bab-Dummadse-goled-dordoneg-e-dikar-dad-nakwed-argan-nuedsik, nakulebuk nanaed.","poem":1}]},{"type":"verse","number":25,"content":["Degine, e-gwenadgan-neggwebur-burwigangi-mamaid, yawagak-nakulegedgi-bendakegala, ibagugle-ibaguglegi (7-7) muchub-muchub gwagbukwad."]},{"type":"verse","number":26,"content":["Dule-yawagak-nakulemalad-e-dummagandina, Levita-dulemar-nanaed. A-dulemardina gusgu nakulebukumalad, ambikumalad-neg dakedid, degi, Bab-Dummadse-goled-neggi-ibmar-gargemalad-bukwadgi nakulemarbalidid."]},{"type":"verse","number":27,"content":["We-dulemar, neg-mutik Bab-Dummadse-goled-neg-naba nakulemalad. Neg-oibosale, bane-bane wakudaradba yawagak-egaar damarbalid."]},{"type":"verse","number":28,"content":["We-Levita-dulemar-gwen-gwen, Bab-Dummadse-goled-neggi-ibmar-ebulemalad-dakmarbalidid. We-dulemar, a-ibmar-ebulemalad-onilealir, abin ebisdamalad, degi, gannar-oubolealir, abin ebisdamarbalid."]},{"type":"verse","number":29,"content":["Levita-dulemar-baigan, Bab-Dummadse-goled-neggi-ibmarmar-bukwad-dakega nug-imaklesmalad.",{"text":"We-ibmarmar-dakegar:","poem":1},{"text":"Madubur, vino, olivo-gwallu, ina-wawadikid, gwallu-wawadmar,","poem":2},{"lineBreak":true},{"text":"degi, bela-ibmar-ebulemalad.","poem":2}]},{"type":"verse","number":30,"content":["Dule-irwa-Bab-Dummadse-gormalad-gwenna-gwenna we-gwallu-wawadmar-oburedgi arbamalad."]},{"type":"verse","number":31,"content":["Levita-dule-Matatíasʼye-nugad, Coré-wagwa-Salum-machi-sailagined, madu-ologana bane-bane-Bab-Dummadga-ukleged-sobedgi arbaed."]},{"type":"verse","number":32,"content":["Degi, gwen-gwen-e-gwenadganmar-Coat-dulemar, obunnoged-iba-irba Bab-Dummadga-madu-ukleged, guakwaa urbisdamalad."]},{"type":"verse","number":33,"content":["Deginbali, dule-namakmalad, Levita-dulemar-e-dummagan-naed. A-dulemar, Bab-Dummadse-goled-neggi gabedneg-bubukwadgi mamaid. We-dulemar mutikidba, degi, ibginedba, e-arbaedginbi arbananai damalad. Degisoggu, arbaed-baigan imaksurmalad."]},{"type":"verse","number":34,"content":["We-dulemar Levita-dulemar-e-dadgan-e-dadganba gardagi-ilemakar-maidgi maid. Wemar Levita-e-gwenadgan-e-dummaganga gusmaladid. Jerusalén-neggweburgi maigusmalad."]},{"type":"heading","content":["Saúl-e-dadgan, degi, e-wagan-nug-ilemakar-maid"]},{"type":"verse","number":35,"content":["Gabaón-neg-nugadgi, Jehiel maigusad. Jehiel, Gabaón-e-babad. E-ome, Maacaʼye-nugad."]},{"type":"verse","number":36,"content":[{"text":"Jehiel-e-masmala, wemalad:","poem":1},{"text":"Abdón, e-machi-sailagined.","poem":2},{"text":"E-urbamar-sorba-gwalulesmalad, wemalad:","poem":1},{"text":"Zur, Quis, Baal, Ner, Nadab,","poem":2}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Gedor, Ahío, Zacarías, degi, Miclot.","poem":2}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Miclotʼde, machi-Simeam-nikusad.","poem":2},{"text":"Wemar, e-gwenadganmar-abargi, Jerusalén-neggweburgi gudii gusmarmogad.","poem":1}]},{"type":"verse","number":39,"content":[{"text":"Ner, machi-Quis-nikusad. Quisʼdi, machi-Saúl-nikusad.","poem":2},{"text":"Saúl, masmala-nikusmogad, wemalad:","poem":1},{"text":"Jonatán, Malquisúa, Abinadab, degi, Es-Baal.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Jonatán-e-machidi,","poem":1},{"text":"Merib-Baalʼye nugad. Merib-Baalʼdi, machi-Micaía-nikusad.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Micaía-e-masmaladi, wemarmogad:","poem":1},{"text":"Pitón, Melec, Tarea, degi, Acaz.","poem":2}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Acazʼdi, machi-Jara-nikusad.","poem":2},{"text":"Jaraʼdi, masmala-baksamogad. E-masmaladi, wemalad:","poem":1},{"text":"Alemet, Azmavet, degi, Zimri.","poem":2},{"lineBreak":true},{"text":"Zimri machigwa-Mosaʼye-nugad nikusad.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Mosa-e-wagan, wemalad:","poem":1},{"text":"Bina, Refaías-e-babad. Refaíasʼdi, Elasa-e-babad.","poem":2},{"lineBreak":true},{"text":"Degi, Elasaʼdi, Azel-e-babad.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Azel masmala walanergwa (6) nikusad. E-nugmar, wemalad:","poem":1},{"text":"Azricam, Bocru, Ismael, Searías,","poem":2},{"lineBreak":true},{"text":"Obadías, degi, Hanán.","poem":2},{"text":"Wemar, Azel-e-masmala nanaed.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1CH/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1CH/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1CH/8.json","previousChapterAudioLinks":{},"numberOfVerses":44}