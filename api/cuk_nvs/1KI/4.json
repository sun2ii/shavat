{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1KI","translationId":"cuk_nvs","name":"1 Reyes","commonName":"1 Reyes","title":"REYMAR-GARDA-GEBED 1 REYES","order":11,"numberOfChapters":22,"sha256":"1c8d6571299890a06d9bbf0a9e4d695c7ae311a730f591eb02a5f3d2e605cc44","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1KI/1.json","lastChapterNumber":22,"lastChapterApiLink":"/api/cuk_nvs/1KI/22.json","totalNumberOfVerses":816},"chapter":{"number":4,"content":[{"type":"heading","content":["Dummagan Salomónʼga-yar-semamaid"]},{"type":"verse","number":1,"content":["Degisoggu, Salomón bela-Israel-dulemar-e-reyga megnonikid."]},{"type":"verse","number":2,"content":["Salomónʼga sordamar-idumalaga gunonimalad, wemalad:",{"text":"Sadoc-machi-Azarías, dule-irwa-Bab-Dummadse-goledga megisad.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sisa-e-masmala, gwen Elihorefʼye-nugad, baiddi Ahíasʼye nugmogad.","poem":1},{"text":"Amala, reyga garda-narmakmaladga megismalad,","poem":2},{"text":"Ahilud-machi-Josafat, negselemaidga-garda-narmakedga megisad.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Joiada-machi-Benaía, sordamar-bila-onomalad-e-dummadga megisad.","poem":1},{"lineBreak":true},{"text":"Sadoc, degi, Abiatar,","poem":1},{"text":"wemar, dule-irwa-Bab-Dummadse-gormaladga megismalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Natán-machi-Azarías, dule-negsedimalad-e-dummadga megisad.","poem":1},{"lineBreak":true},{"text":"Natán-machi-Zabud, dule-irwa-Bab-Dummadse-goledga megisad,","poem":1},{"text":"degi, reyga-binsaed-ukedga megisbalid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ahisar, reyneg-akwedga megisad.","poem":1},{"lineBreak":true},{"text":"Abda-machi-Adoniram,","poem":1},{"text":"reyga-sabsur-oarbaledimalad-e-dummadga megisad.","poem":2}]},{"type":"verse","number":7,"content":["Deginbali, Salomón Israel-dulemargi e-ambe-gakabo (12) ega-negsemalad nugsanonikid. Amar reyga, degi, rey-neguyagi-gudimaladga mas-amidimalad. Wemar-ambe-gakabogwad (12), birgagine war-wargwen niigwen-niigwen, mas-amidimalad."]},{"type":"verse","number":8,"content":["Wemar-ambe-gakabogwad (12), wemalad:",{"text":"Hur-e-machi, Efraín-yalaganba negdakmaid.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Decar-e-machi, we-neggweburmar-e-dummadid:","poem":1},{"text":"Macaz, Saalbim, Bet-Semes, Elón, degi, Bet-Hanán.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hesed-e-machi, we-neggweburmar e-dummadmogad:","poem":1},{"text":"Arubot, Soco, degi, bela Hefer-yar-naid dakmaibalid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Abinadab-e-machi, Dor-yar-naid-dakmaid.","poem":1},{"text":"Deginbali, we-dule Salomón-sisgwa-Tafatʼye-nugad nikusad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ahilud-machi-Baana we-neggweburmar dakmaid:","poem":1},{"text":"Taanac, Meguido, Bet-Seán.","poem":2},{"lineBreak":true},{"text":"We-Bet-Seánʼde, Saretán-neggwebur-dikarba siid,","poem":2},{"lineBreak":true},{"text":"Jezreel-neggwebur-deale bukwad.","poem":2},{"lineBreak":true},{"text":"Baana bela Bet-Seán-neggwebur-siid-akale,","poem":2},{"lineBreak":true},{"text":"degi, Abel-Mehola-neggweburse negdakmaid.","poem":2},{"lineBreak":true},{"text":"Amba Jocmeam-neggwebur-obakar negdakmaibalid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Geber-e-machi,","poem":1},{"text":"Ramot-De-Galaad-neggwebur-e-dummadga-maid,","poem":2},{"lineBreak":true},{"text":"degi, Galaad-yar-naidgi neggwebur-bukmaladse-bakar, dakmaibalid.","poem":2},{"lineBreak":true},{"text":"We-neggweburmarde, Manasés-machi-Jairʼgadinad.","poem":2},{"lineBreak":true},{"text":"Aginbali, Geber-e-machi Basán-yar-naidgi","poem":2},{"lineBreak":true},{"text":"Argob-neg-nugad-e-dummadga gusbalid.","poem":2},{"lineBreak":true},{"text":"Agine, neggwebur gwadulapaa (60) bukwad.","poem":2},{"lineBreak":true},{"text":"A-neggweburmar akwa-galu-matusulid-ebiris-bukwa nanaed.","poem":2},{"lineBreak":true},{"text":"Deginbali, e-yawagak-eduedi esgoro-gordikidgi sobaled.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Iddo-machi-Ahinadab, Mahanaim-neggwebur-e-dummadid.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ahimaas, Neftalí-yar-naid-e-dummadid.","poem":1},{"text":"Deginbali, Ahimaas, Salomón-sisgwa-Basematʼye-nugad nikusad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Husai-machi-Baana, Aser-yar-naid, degi, Alot-yar-naid-e-dummadid.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Parúa-machi-Josafat, Isacar-yar-naid dakmaid.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ela-machi-Simei, Benjamín-yar-naid dakmaid.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Uri-machi-Geber, Galaad-yar-naid dakmaid.","poem":1},{"text":"Galaad-yarde, Rey-Sehónʼgadinad.","poem":2},{"lineBreak":true},{"text":"Sehónʼde Amorreo-dulemar-e-reyga maigusanad.","poem":2},{"lineBreak":true},{"text":"Geberʼde Rey-Og-e-yar ganikinad.","poem":2},{"lineBreak":true},{"text":"Ogʼde Basán-yar-naid-e-reyga maigusanad.","poem":2},{"lineBreak":true},{"text":"Galaad-yargindina, Geber wargwenna yar-semaid.","poem":2}]},{"type":"heading","content":["Salomón ibmar-bukidar-nikusad"]},{"type":"verse","number":20,"content":["Israel-dulemar, degi, Judá-dulemar ichesur gumarsoggu, demar-gakagi-ukub-naidyob gumalad. Aga, geg ebisleged. Ibmar-gobleged, degi, ibmar-gulleged, obinebaka nikasoggu, weligwar itobukwad."]},{"type":"verse","number":21,"content":["Salomón, Éufrates-diwar-maid-akale, Filistea-yar-naidse bela yar-ganonikid. Aginbali, Egipto-yar-abingunaidse-bakar, Salomón bela-we-yar-nanaid-semaigu, bela dulemar-bukmalad ega ibmar-bukidar senonidamalad, degi, Salomón-e-maiga gusmarbalid."]},{"type":"verse","number":22,"content":["Salomónʼga bane-bane weyob ibmar-mergu ebuleged:",{"text":"Madubur-nued,","poem":1},{"text":"nibir-miliambe-gakabake gaka dulataled-ilatar-aidiku (14,500) ebuleged.","poem":2},{"text":"Madubur,","poem":1},{"text":"nibir-milidulagwen-gakambe-aidiku (30,000) ebulebalid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Moli-bebe-nikad-wardadagan mas-nuedbi-madimalad,","poem":1},{"text":"warambe (10) ebulebalid.","poem":2},{"text":"Moli-bebe-nikad gaganbi-madimalad,","poem":1},{"text":"waladulagwen (20) ebulebalid.","poem":2},{"text":"Sibad-wawaadmar, degi, sibadmar,","poem":1},{"text":"waladulatar (100) ebulebalid.","poem":2},{"text":"Goe-sapurmar, goe-sapingan, degi, wasamar ebulebalid.","poem":1},{"lineBreak":true},{"text":"Degi, nuumar-nabir-gullemalad ebulebalid.","poem":1},{"text":"We-nuumar gege ebisleged.","poem":2}]},{"type":"verse","number":24,"content":["Salomón Éufrates-diwar-dad-argwanedsiki, Tifsaʼye-neg-nugad-akale Gaza-neg-nugadse, bela reymar-mamaid-birgi yar-ganonikid. Degisoggu, bela yar-abingunanaidgi neg-bogidikid nagunonikid."]},{"type":"verse","number":25,"content":["Salomón yar-semaigu, bela Judá-dulemar, degi, Israel-dulemar, nabir-gudii gusmalad. Dan-yar-naid-akale, Beersebaʼye-neg-nugadse, bela neg-bogidik nagunonikid. Degisoggu, Israel-dulemar e-nainugi uvaʼdub-urba, degi, higuera-sapi-urba bonisuli ambikudii gusmalad."]},{"type":"verse","number":26,"content":["Salomón molimar miliambe-gakabo (12,000) nikad. Deginbali, moli-ur-bilagi-ebuleged-e-galumar milibake (4,000) nikabalid."]},{"type":"verse","number":27,"content":["Dummagan-ambe-gakabogwad (12) Salomónʼga-yar-sedimaladi, niigwen-niigwengi Salomónʼga mas ukdimalad. Degi, bela e-sordamar-arbadimaladga mas-ukdimarbalid. Degisoggu, mas-sate gudii gussurmalad."]},{"type":"verse","number":28,"content":["We-ambe-gakabogwad-yar-sedimaladi (12) e-mas-uked-nii-mosale, cebada-e-gwag, degi, gagan-molimar-maed, sogedba molimarga senonidamarbalid."]},{"type":"heading","content":["Salomón nue-binsaed-nikarba gusad"]},{"type":"verse","number":29,"content":["Bab-Dummad, Salomón nue-binsaed-ibedga imaksad, degi, nue-itoakwaa-nanaega imaksabalid. Agine, gurgin-bukidar-nika gunonibalid."]},{"type":"verse","number":30,"content":["Salomón-e-ibmar-wisidi, bela dulemar-ibmar-wismaladgi obined, dulemar-ibmar-wismalad yar-dad-nakwedsik-bukwamaladgi obinbalid. Degi, Egipto-dulemar-ibmar-wismaladgi obinbalid."]},{"type":"verse","number":31,"content":["Salomón we-dulemarba bur bule ibmar-wisid:",{"text":"Ezraí-neggined-Etánʼye-nugadgi.","poem":2},{"lineBreak":true},{"text":"Aginbali, Mahol-e-masmalagi,","poem":2},{"lineBreak":true},{"text":"Hemánʼye-nugadgi,","poem":2},{"lineBreak":true},{"text":"Calcolʼye-nugadgi,","poem":2},{"lineBreak":true},{"text":"degi, Dardaʼye-nugadgi obinbalid.","poem":2},{"text":"A-ulale, Salomón-nug-dummarba-guedi, bela dulemar-yar-baid-baidgi-bukwamaladi wisgusmalad.","poem":3}]},{"type":"verse","number":32,"content":["Salomón binsaed-nuegan, milipaa (3,000) narmaksad, degi, namaked miligwen gakatar (1,005) narmaksabalid."]},{"type":"verse","number":33,"content":["Salomón sapi-durbamargi Líbano-urwala-akale, degi, galugi-hisopo-gagan-dungumaladse-bakale, egi sunmaksabalid. Deginbali, Salomón ibdurgangi dulemar-odurdaksad:",{"text":"Ibdurgan-ursirmaladgi,","poem":2},{"lineBreak":true},{"text":"nuumargi,","poem":2},{"lineBreak":true},{"text":"ibdurgan-unimakdimaladgi,","poem":2},{"lineBreak":true},{"text":"degi, uamargi dulemar-odurdaksabalid.","poem":2}]},{"type":"verse","number":34,"content":["Bela yar-nanaid-e-reymar, Salomón-bela-bela-ibmar-wisid wisgunonimalad. Degisoggu, we-reymar Salomón-e-binsaed-nikarba-gued-wisgunonimaladi, Salomón-itogegala, e-sordagan Salomónʼse barmiardamalad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1KI/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1KI/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1KI/3.json","previousChapterAudioLinks":{},"numberOfVerses":34}