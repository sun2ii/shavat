{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"1TI","translationId":"cuk_nvs","name":"1 Timoteo","commonName":"1 Timoteo","title":"TIMOTEOʼSE-NARMAKLESAD-GARDA-GEBED 1 TIMOTEO","order":54,"numberOfChapters":6,"sha256":"858d7f64acd0dc4d0adc8293bc7df711c4aab6b42c37322b7132de8a07befec3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/1TI/1.json","lastChapterNumber":6,"lastChapterApiLink":"/api/cuk_nvs/1TI/6.json","totalNumberOfVerses":113},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["We igar-napiragwaddo: Dule Jesúsʼba-nanaimalad-e-dummadga gubiele, arbaed-nuedbina soged."]},{"type":"verse","number":2,"content":["A-ulale, dule Jesúsʼba-nanaimalad-e-idumalad-e-dummadga gubiele, dule-weyobid abeleged:",{"text":"Dule-egi-ichakwa-sunmaked-sated,","poem":2},{"lineBreak":true},{"text":"dule-unnila-ome-wargwenna-nikad,","poem":2},{"lineBreak":true},{"text":"dule na-dukin-sunna-san-bargaed,","poem":2},{"lineBreak":true},{"text":"dule-binsaed-nikadaed,","poem":2},{"lineBreak":true},{"text":"dule-mag-emar-dakeedaed,","poem":2},{"lineBreak":true},{"text":"dule-nabir-emar-akwed,","poem":2},{"lineBreak":true},{"text":"dule-yeer-dulemar-odurdaked,","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"dule-geg-mumgued,","poem":2},{"lineBreak":true},{"text":"dule-geg-abin-abin-daed-amied,","poem":2},{"lineBreak":true},{"text":"dule-geg-ibmar-isganagi-mani-onoged,","poem":2},{"lineBreak":true},{"text":"dule-gwenadgan-sabguerbad,","poem":2},{"lineBreak":true},{"text":"dule-binnalee-na-san-bargaar-ibmar-saed,","poem":2},{"lineBreak":true},{"text":"dule-maniginbi-dogdar-binsasulid.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dule na-neguya-nued-sediid,","poem":2},{"lineBreak":true},{"text":"dule na-mimmigan-uaya-nikadaed-sediid,","poem":2},{"lineBreak":true},{"text":"degi, e-mimmigan egi-binsaed-nikaa damarmogad.","poem":2}]},{"type":"verse","number":5,"content":["Ar dule na e-neguyagi neg wissur-seele, degite, ¿igi nabir Jesúsʼba-nanaimalad-sebalosunna? Geg nabir sebardo."]},{"type":"verse","number":6,"content":["Deginbali, dule Jesúsʼba-nanaimalad-e-dummadga gubiele, dule-geb-emisgwa-Bab-Jesúsʼba-nagusad, geg gued. Abakalegi, na san dummarba-saedba, nia-saila-isgusadgii isguarmogale."]},{"type":"verse","number":7,"content":["Deginbali, dule Jesúsʼba-nanaimalad-e-dummadga gubiele, dulemar-Bab-Jesúsʼba-nanaisurmalad-abargi e-daed nued oyodibalirgebed. Adi, mer amar egi ichakwa sunmakmalagar. Ar abakalegi, nia-sailase binsaed galealile."]},{"type":"verse","number":8,"content":["Jesúsʼba-nanaimalad-bendakmalad amba weyob damarmogargebed:",{"text":"Dule-nued-nanaed,","poem":2},{"lineBreak":true},{"text":"dule-unnila-inniki-ibmar-soged,","poem":2},{"lineBreak":true},{"text":"dule-geg-mumgued,","poem":2},{"lineBreak":true},{"text":"dule-ibmar-isganagi-geg-mani-onoged,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"dule binsaed-swilidikidgi Bab-Jesúsʼgi-bensulid-igar-epenne-dukuar-maigusad sediid.","poem":2}]},{"type":"verse","number":10,"content":["Ar we-dule, nue wilubdaklegwelergebed. E-daedgi, dule gwen egi akar-sunmaksulile, geb Jesúsʼba-nanaimalad-bendakedga nugsalegodo."]},{"type":"verse","number":11,"content":["Jesúsʼba-nanaimalad-bendaked-omegan amba weyob damogargebed:",{"text":"Dule-nued-nanaed,","poem":2},{"lineBreak":true},{"text":"wissur-gakangi-sunmaked,","poem":2},{"lineBreak":true},{"text":"nue-binsaed-nikadaed,","poem":2},{"lineBreak":true},{"text":"degi, bela ibmar-saedgi dulemar-geg-yardaked.","poem":2}]},{"type":"verse","number":12,"content":["Jesúsʼba-nanaimalad-bendakmalad weyob abeleged:",{"text":"Unnila ome-wargwen-nikad,","poem":2},{"lineBreak":true},{"text":"nue-neguya-wisi-seed-dule,","poem":2},{"lineBreak":true},{"text":"degi, e-mimmigana, nue-akwedibalid-dulebar.","poem":2}]},{"type":"verse","number":13,"content":["Ar ade, Jesúsʼba-nanaimalad-bendakmalad nued arbaele, nue nug-nikaa gwenadgan-abargi gunonidaed. Degine, Cristo-Jesúsʼgi-bensulidgi bur-nue-dobsuli sunmakdamalad."]},{"type":"verse","number":14,"content":["Emisgwasaar, an be-daknaega bese nadapo an insado. Degi-inigwele, an bese garda narmakdo,"]},{"type":"verse","number":15,"content":["adi, be wisguega an wis-yoggud be an-dakele, igi be Bab-Dummad-neg-yaginmalad-abargi be nanaergebe. Bab-Dummad-negyaginmalad-soglegedi, Bab-Dummad-Dula-Maid-e-sordamarye. Amala, igar-napiragwad-ganimaladid, igi buar neg-ganiki, ayobmodo. Degi, amar a-igar-irwa gwisgumarbalidid."]},{"type":"verse","number":16,"content":["Emide, Bab-Jesús-igar geg benguleged. Ar we-igar igar-dakledisulid-igalad, igala-dummadid, ar ade:",{"text":"Bab-Dummad anmarse oyolesad,","poem":1},{"text":"anmar-dule-sunnadyob napnegse aidenonikid.","poem":2},{"text":"Bab-Dummad-Burba-Isligwaled dule-ibmar-oakalossulidye-nik sogsad.","poem":1},{"text":"Baliwiturmar, Bab-Jesús-nue-daksamarmogad,","poem":2},{"text":"Judíoʼsurmaladga Jesús-igar-nuedgi ega sunmaklesad.","poem":1},{"text":"Dulemar-napneggi-bukmalad Jesúsʼgi bengussurmalad.","poem":2},{"text":"Degi, Bab-Dummad na e-nibnegse Jesús-onakwisad,","poem":1},{"text":"agi e-nug odummossunnad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/1TI/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/1TI/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/1TI/2.json","previousChapterAudioLinks":{},"numberOfVerses":16}