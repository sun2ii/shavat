{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"2CH","translationId":"cuk_nvs","name":"2 Crónicas","commonName":"2 Crónicas","title":"NEG-GUSMALAD-GARDA-SOGBOGWAD 2 CRÓNICAS","order":14,"numberOfChapters":36,"sha256":"89da1ba4599b481c7e02d0247c0d722489996f60332cf0cf0b97ef95f35574de","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/2CH/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/cuk_nvs/2CH/36.json","totalNumberOfVerses":822},"chapter":{"number":4,"content":[{"type":"heading","content":["Ibmar-ebulemalad-soblesad"]},{"type":"verse","number":1,"content":[{"text":"Salomón ibmar-ogumakar-ukleged-aila esgoro-gordikidbi sobsabalid.","poem":1},{"text":"E-suguedi, daliatar (5) sugued.","poem":2},{"lineBreak":true},{"text":"E-matardungueddi, daliatar (5) madardungubalid.","poem":2},{"lineBreak":true},{"text":"E-nibgueddi, dalibo-gaka-negabar nibgued.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dii-siged-dummad, esgoro-gordikid-sunnabi orokwaa sobsabalid.","poem":1},{"text":"E-yaadungued, dalibo-gaka-negabar (2½) yaadungued.","poem":2},{"lineBreak":true},{"text":"E-nibguedi, daligwen-gaka-bisgise (1¼) nibgued.","poem":2},{"lineBreak":true},{"text":"E-gakuli-ebiraledi, daligugle-gaka-negabar (7½) ebiraled.","poem":2}]},{"type":"verse","number":3,"content":["Dii-siged-dummad-e-gakuli-urba, moli-bebe-nikad-machergan ilabo-ebiris sobar-sobar-nasiklesad, bisgigwen-bisgigwensakgi-bangue warambe-warambe (10-10) nasikles naed. Dii-siged-dummad esgoro-gordikid-diregwadgi-soblenaigu, yog-eba-soblegar gusad."]},{"type":"verse","number":4,"content":[{"text":"Dii-siged-dummad, moli-bebe-nika-machergan-warambe-gakabogwad-birgi (12) sobar-siid.","poem":1},{"text":"Moli-warbaa, dad-nakwed-argan-sapiledsik atakgwichid,","poem":2},{"lineBreak":true},{"text":"warbaa, dad-argwanedsik atakgwisbalid,","poem":2},{"lineBreak":true},{"text":"warbaa, dad-nakwed-argan-nuedsik atakgwisbalid,","poem":2},{"lineBreak":true},{"text":"warbaa, dad-nakwedsik atakgwisbalid.","poem":2},{"text":"We-molimar-warambe-gakabogwad-birgi (12) dii-siged-dummad siid.","poem":1},{"text":"Moli e-nagmar-sorsikid dii-siged-urba dogar nanaid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dii-siged-dummad argan-goo-walabake-wilub songued.","poem":1},{"text":"E-gakuligi dutu-lirio sobaled, nog-dummadyobi sobaled.","poem":2},{"text":"Dii-siged-dummadgi, galón-miliambe-gakagugle gaka dulataled-ilatar (17,500) dii siged.","poem":3}]},{"type":"verse","number":6,"content":["Rey-Salomón dii-simalad-senigana gwaambe (10) sobsabalid. Dad-nakwed-nuedsik gwaatar urbisad, geb sapiledsik gwaatar urbisbalid. Adi, ibmar-dula-oburgwilesale, we-diimargi ibmar-ebulemalad enuklegegar. Dii-siged-dummaddina, dule-irwa-Bab-Dummadse-gormalad e-argan-enukega siid."]},{"type":"verse","number":7,"content":["Salomón gwallu-simalad-orbiid warambe (10) ega-igar-maidba sobsabalid. Geb Bab-Dummadse-goled-negyaba e-galu-naba urbisad. Argan-nuedsik walatar urbisad, argan-sapiledsik walatar urbisbalid."]},{"type":"verse","number":8,"content":["Degidgi, mese gwaambe (10) sobsabalid. Geb Bab-Dummadse-goled-negyaba e-galu-naba gwaatar argan-nuedsik urbisad, geb gwaatar argan-sapiledsik urbisbalid. Deginbali, or-nog-abe-mimalad dulatale (100) sobsabalid."]},{"type":"verse","number":9,"content":["Salomón dule-irwa-Bab-Dummadse-gormaladga neg-imba sobsabalid, degi, neg-imba-dummad sobsabalid, degi, e-yawagak guar-guar sobsabalid. Geb neg-yawagak-uki esgoro-gordikid nasiksabalid."]},{"type":"verse","number":10,"content":["Degine, dii-siged-dummadi Babse-goled-neg-dad-nakwed-argan-nuedsik, Bab-neg-dikargi argan-nuedsik sisad."]},{"type":"verse","number":11,"content":["Salomón bormomar sobsabalid, degi, buru-wemalad sobsabalid, degi, abe-mied-nog sobsabalid. Rey-Salomón igi Hiramʼga Bab-Dummadse-goled-neg soboye sogsa, deyopira, Hiram bela Bab-Dummadga-neg-sobnaid, ogusad."]},{"type":"verse","number":12,"content":["We-neg-soblesad, weyob soblesad:",{"text":"Buarmar-walabo soblesad.","poem":1},{"text":"We-buarmar-e-nonomar dirbir soblesbalid.","poem":2},{"text":"Degi, esgoro-gordikid-mor-saki-sakid matabo imaksabalid,","poem":1},{"text":"buar-warbogwad-e-nonogi nasikegar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Esgoro-gordikid-mor-saki-sakid-matabogwadgi,","poem":1},{"text":"guseb-dummadgi-dakleged ile-sogabo dulataled-ilabake (400) egi nanaid.","poem":2},{"lineBreak":true},{"text":"A-matabogwad buar-nonomar-dirbiled-ebilis nanaid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Geb ibmar-ebulemalad-enuked,","poem":1},{"text":"degi, ibmar-ebulemalad-enuked-e-siged soblesbalid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dii-sied-dummad soblesbalid,","poem":1},{"text":"molimar-bebe-nikad-machergan warambe-gakabo (12) dii-sied-dummad-bargaega sobar urbisbalid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"A-uki, bormomar soblesbalid,","poem":1},{"lineBreak":true},{"text":"degi, buru-wemalad soblesbalid,","poem":1},{"lineBreak":true},{"text":"degi, wesar-ikomar-dummagan soblesbalid.","poem":1},{"text":"We-ibmar-ebulemalad bela Hiram-Abi Bab-Jehováʼse-goled-negga Rey-Salomónʼga esgoro-gordikid-dakar-gaedgi sobsad.","poem":2}]},{"type":"verse","number":17,"content":["Hiram-Abi, Rey-Salomónʼga-bela-ibmar-sobsadi, Jordán-neba-ukub-naidgi soogi dusad. A-neg-ukub-naidi, neggwebur-Sucot, degi, Seredata-ebo abingunaidgi naid."]},{"type":"verse","number":18,"content":["Salomón belagwable we-ibmar-ebulemalad ichesur-imaksasoggu, esgoro-gordikid-aidikuedi wisgussulid."]},{"type":"verse","number":19,"content":["Deginbali, Salomón ibmar-ebulemalad-baigan Bab-Dummadse-goled-negga-soblesbalid, weyob sobsabalid:",{"text":"Ina-wawadik-ogumakar-ukleged-aila, bela orbi sobsad.","poem":1},{"lineBreak":true},{"text":"Degi, mesemar, madu-Bab-Dummadga-mesmalad bela orbi sobsabalid.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Degi, gwallu-gaed-simalad, degi, gwallumar","poem":1},{"text":"bela or-sunnabi sobsabalid.","poem":2},{"lineBreak":true},{"text":"Adi, igar-soglesadba, Neg-Ise-Islidikid-asabin ogaegar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dutumar-soblesadi,","poem":1},{"lineBreak":true},{"text":"gwallumar-soblesbalidi, degi, maskemar-soblesadi,","poem":1},{"text":"bela amba or-sunnabi sobles nanabalid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Amba dislamar-gwallu-gwillodub-siked soblesbalid,","poem":1},{"lineBreak":true},{"text":"abe-mied-nogmar soblesbalid, wesarmar,","poem":1},{"lineBreak":true},{"text":"degi, sianarmar soblesbalid.","poem":1},{"text":"We-ibmarmar, bela amba or-sunnabi soblesad.","poem":2},{"text":"Deginbali, Bab-Dummadse-goled-neg-doged,","poem":1},{"text":"ber or-sunnabi soblesbalid:","poem":2},{"text":"Neg-Ise-Islidikidgi-doged-e-yawagakmar,","poem":1},{"text":"bela or-sunnabi sobles nanabalid.","poem":2},{"text":"Degi, Bab-Dummadse-goled-negga-gusiid-e-yawagakmar,","poem":1},{"text":"bela or-sunnabi sobarbalid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/2CH/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/2CH/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/2CH/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}