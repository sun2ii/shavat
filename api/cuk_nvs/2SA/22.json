{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"2SA","translationId":"cuk_nvs","name":"2 Samuel","commonName":"2 Samuel","title":"SAMUEL-GARDA-SOGBOGWAD 2 SAMUEL","order":10,"numberOfChapters":24,"sha256":"90e60b5a75cca08ebf9e57adcd394525a7d7ad02122e4159e11c7750c2403a86","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/cuk_nvs/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["David bendaklesadba-namaked"]},{"type":"verse","number":1,"content":["Bab-Jehová, Saúlʼgi David-bendaksa-gusgu, degi, e-isdarmaladgi-bendaksa-gusbargu, weyob David Bab-Jehováʼga namaked narmaksad."]},{"type":"verse","number":2,"content":["David weyob narmaksad:",{"text":"“Bab-Jehová anga akwasailayob an-bendaked gued,","poem":1},{"text":"Bab-Jehová an-garganguedid,","poem":2},{"lineBreak":true},{"text":"an-ollor-imakedid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An-Bab-Dummad an-niga-ogannogedid,","poem":1},{"text":"egi an benguosulid.","poem":2},{"text":"Anga sigu-abgaedyob gued,","poem":1},{"text":"an-abonoged-gandikidid.","poem":2},{"text":"Bab-Jehová an-odukuedga gued,","poem":1},{"text":"an-bendakedid.","poem":2},{"lineBreak":true},{"text":"Neg-bulegangi be an-bendaksadid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehováʼye, innikigwadba be-nug odummoleged.","poem":1},{"text":"An bese gotele, an-isdarmaladgi be an-bendaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Burgwedse an nue sulegednaga gusad,","poem":1},{"text":"demar-dummagan-arwemaiyobi angi yolenonikid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Burgwednaga an gunonikid,","poem":1},{"text":"burgwed, sakiyob an-idu nagusad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An nunmak-itodiidgine, Bab-Jehováʼse an gochad.","poem":1},{"text":"An-Bab-Dummad, e-neg-akale an-itosad.","poem":2},{"lineBreak":true},{"text":"An-gormaked nue-itononikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Bab-Dummad-nue-uludgua, bela ese neg giglimakded.","poem":1},{"text":"Napneg-naid giglimakdegu, bela nibneg-naid-billigan giglimakdemogad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová-e-bunnogedba, waa ainialid,","poem":1},{"text":"e-gaya-yaba, soo-ginnitibi gwabunyealid,","poem":2},{"lineBreak":true},{"text":"ginnitibi soomar milealid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Bab-Jehová-aideargua, nibneg argaded,","poem":1},{"text":"mogir-gudureged-birgi aidealid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová baliwitur-querubin-birgi-sii, gukunadapid,","poem":1},{"text":"burwaba-gukumaiyob nadapid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Negasichid egi ebiris nasiksad,","poem":1},{"text":"mogir-gudureged egi ebiris nasiksad,","poem":2},{"lineBreak":true},{"text":"bela egi ebiris naid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Jehová-e-daklegedi, ibemakar dakleged,","poem":1},{"text":"e-dakarmakedba soo ginnitibi milealid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Bab-Jehová nibneggi-mai sabsur-gollalid,","poem":1},{"text":"Bab-Dummad-Bur-Birigined malayob goted.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"An-isdarmaladgi siguyob egi mar-odenai gualid,","poem":1},{"text":"surbinsa-itogedba wakinmalaga imaksad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad-Uludedbali, dii-suke-dummagan noalid.","poem":1},{"text":"Bab-Jehová-bunnodedbali, napa-dii-urba-naid magar-dakle gunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"”Bab-Jehová e-argan, anse niba-oyononikid,","poem":1},{"text":"an-argan ganonikid,","poem":2},{"lineBreak":true},{"text":"neg-wilasailadgi an-onononikid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"An-isdarad-gannarbaadgi, an-ollor-imaksad.","poem":1},{"text":"Dule-isdar-an-dakdiidgi, anba bur bule ganguedgi, Bab-Dummad an-bendaksad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"An nue-wile-itodiidgi, an-isdarmalad angi gwisgunonikid.","poem":1},{"text":"Agine, Bab-Jehová an-bendaknonikid.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bab-Jehová an nued-nanadiidba an-ollor-imaknonikid.","poem":1},{"text":"Neg-nuedgi an-ogwisgunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Bab-Jehová an-inniki-gudiidba, anga ibmar-uksad.","poem":1},{"text":"An-ibmar-akar-imakdisulidba, nabir angi binsanonikid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar Bab-Jehová-Igar-Mesisadba an nanadii gusad.","poem":1},{"text":"Ibmar-isgana an imaksasulid,","poem":2},{"lineBreak":true},{"text":"an-Bab-Dummadgi an bangussulid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bela e-Igar-Mamaid an-idumaid,","poem":1},{"text":"e-Igar-Mamaidgi an bangussulid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bab-Dummad-asabin islikwaa an gudii gusad,","poem":1},{"text":"ibmar-isgana-imaked an na bargasad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"”An ibmar-inniki-imakdiidba, Bab-Jehová nabir anga ibmar-uksad.","poem":1},{"text":"An ibmar-akar-imakdisulidba, nabir angi binsanonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"”Bab-Jehová, dule-bebaligwaa-gudiidgi, be inniki damogad.","poem":1},{"text":"Dule-wile-emar-dakedi, be wile dakmogad.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Dule-be-sogedba-gudiidga, sogedba ega be ibmar oyomogad.","poem":1},{"text":"Dule-galagwensur-emar-yardakdiiddina, egi be gwisgumogad.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Dule-na-san-bipi-imakdimaladi be bendaked.","poem":1},{"text":"Dule-na-san-dummarba-imakmaladdina, san-bipii be imakoed.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bab-Jehová, gwalluyob be anga gued.","poem":1},{"text":"Bab-Dummad, an negsichidgi-gudiidgi anga be neg-mee imaked.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Be an-bendakdiidgi sorda-bamalad anse ibitomalad.","poem":1},{"text":"An-Bab-Dummad, an bebogwa neggwebur-galu-matusulid-birgi nabir an obakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"”Bab-Dummad-e-igar, innikii maid.","poem":1},{"text":"Bab-Jehová-gayaburba, sunsogedid.","poem":2},{"lineBreak":true},{"text":"Dule-begi-dukued-amimaladga, sigu-abgaedyob be gued.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"¿Doa-baid Bab-Dummadga maisunna?","poem":1},{"text":"Unnila Bab-Jehováʼbi, Bab-Dummadga maid.","poem":2},{"text":"Unnila Bab-Jehováʼbi, akwasailayob gued,","poem":1},{"text":"abi anmar-bendakmaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"”Bab-Dummad, an-niga-ogannogedid,","poem":1},{"text":"igar-nuedbali an-nied.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Igi goe-sapur abarmake,","poem":1},{"text":"deyob-abarmake, Bab-Jehová an-imaked.","poem":2},{"lineBreak":true},{"text":"Yarmar-birgi-baparmaksuli an-imaked.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Bab-Jehová bila-onoged-idu an-odurdaked.","poem":1},{"text":"Warsi-esgoro-gordikid nabir-dopee-imakega, an-surgan-ogannobalid.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Sigu-abgaedyob be an-irwa gwisgued.","poem":1},{"text":"Be-garganguedgi be an-bendaked,","poem":2},{"lineBreak":true},{"text":"be-sabgued nasguega an-imaked.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Igar-nanaed be anga nudaksad,","poem":1},{"text":"adi, an nanadele, mer an yolegegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"”An-isdarmalad anse bargalesmalad,","poem":1},{"text":"anse ibitolesmalad.","poem":2},{"lineBreak":true},{"text":"An-isdarmalad-oitossuli an aibirissulid.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Bela anse naibigusmalad,","poem":1},{"text":"anse galakunonimalad.","poem":2},{"text":"Geg bar gwisgumalad,","poem":1},{"text":"anse burgwismalad.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Bila-onolenaidgi be an-ogannosad.","poem":1},{"text":"An-isdarmalad anse-galakuega be imaksad.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"An-isdarmalad an-abin-sikirmakega be imaksad.","poem":1},{"text":"Deyob isdar-an-dakdimalad an obelosad.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"An-isdarmalad bendaklegega binnasuli-gornai gusmalanad.","poem":1},{"text":"Dule-e-bendakmalad sate gusad.","poem":2},{"text":"Bab-Jehováʼse gochamarbalinad,","poem":1},{"text":"Bab-Jehová bendaksasurmogad.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"An-isdarmalad anse sanyob ichi-ichi gusad.","poem":1},{"text":"Igi ollimargi annalege, deyob an egi annasad,","poem":2},{"lineBreak":true},{"text":"anse ibitosmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"”Dulemar-angi-aibinnanaidgi be an-bendaksad,","poem":1},{"text":"dulemar-iduedga be an-imaksad.","poem":2},{"lineBreak":true},{"text":"Dulemar-aku-an-dakmalad, an-maiga gunonimalad.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Dule-ainebarmalad, an-nug-odummodmalad.","poem":1},{"text":"Wis an-gaya-itosmalale, yog anba ibsaardamalad.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"We-dule-ainebarmalad geggusmalale,","poem":1},{"text":"e-dukuedgi-bukwa wawanmakdani noardamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"”¡Bab-Jehová dula mai!","poem":1},{"text":"¡An be-nug-ogannoged.","poem":2},{"text":"Akwa-gandikidyob be anga gued!","poem":1},{"text":"An-Bab-Dummad-an-abonoged, an be-odummoged.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Bab-Dummad, an-isdarmalad-an-naibi-imaksadi, be anga buged-mai imaked.","poem":1},{"text":"Dulemar-yar-baid-baidgi-bukmaladgi-obinega be an-imaked.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"An-isdarmaladgi be an-onoged,","poem":1},{"text":"angi-yoledimaladgi-obinega be an-imaksad,","poem":2},{"lineBreak":true},{"text":"dule-ursirmaladgi be an-bendaked.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Bab-Jehováʼye, agala, dule-yar-baid-baidginmalad-abargi an be-nug odummoged.","poem":1},{"text":"Bab-Jehová, be-nuggi an namaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"”Bab-Jehová, e-rey-onakwega imaked.","poem":1},{"text":"Bab-Dummad David-na-nug-imaksadga, degi, David-e-wagangala, e-wiledakedbali, e-sabguedi degisadegu oyomai gudoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}