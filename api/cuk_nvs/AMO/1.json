{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"AMO","translationId":"cuk_nvs","name":"Amós","commonName":"Amós","title":"AMÓS-GARDA AMÓS","order":30,"numberOfChapters":9,"sha256":"a953f41321bd5035db243fd9c1ef150ebe855f041d1dc1f9edf1242e6a747498","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cuk_nvs/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"heading","content":["Bab-Jehová nue-urwed"]},{"type":"verse","number":1,"content":["We, Amós-e-gayaburbado. Amósʼde Tecoa-neggweburginedid, sibad-wawaad-akwed-duled. Amós, Israel-yargi birgabose negabandur-noed-iduar, negburgan daksad. Deunni, Uzías, Judá-e-reyga-maid, degi, Joás-machi-Jeroboam, Israel-e-reyga maidginmogad."]},{"type":"verse","number":2,"content":["Amós sogded:",{"text":"“Sión-yala-akale, Bab-Jehová uludagoed,","poem":1},{"text":"Jerusalén-akale, mar-goledyob e-gayaburba gordagoed.","poem":2},{"text":"Sibad-wawaad-nikamalad-e-nainugi gagan-ara-ara-nanaid bela bergudoed.","poem":1},{"text":"Carmelo-yar-birigi-gagan-nanaid dingudoed.”","poem":2}]},{"type":"heading","content":["Bab-Jehová Damasco-yar-naid sabsur-odurdakoed"]},{"type":"verse","number":3,"content":["Bab-Jehová weyob soged:",{"text":"“Damasco-dorgan-e-isgued nue-wilub-obicha naid.","poem":1},{"text":"Sabsur-e-odurdaklegoedi, an ega osulogosulid.","poem":2},{"text":"Ar ade, Damasco-dorgan undar-beedse Galaad-dulemar-wiosad.","poem":1},{"text":"Esgoro-nugar-nikadgi-ibmar-durwilegeyobi Galaad-imaksamalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ani an Rey-Hazael-e-neg, soogi ogumakoed,","poem":1},{"text":"Ben-Adad-e-neg-gandikmalad bela gummakoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Damasco-neggwebur-yawagak-esgoromar an bibisgoed,","poem":1},{"text":"Avén-nebagi dule-bukwad an obelogoed.","poem":2},{"text":"Bet-Edénʼgi dummaganga-mamaid an osulogoed.","poem":1},{"text":"Siria-dulemar yogasaar-gales Kirʼye-yar-nugadse barmiledmaloed.","poem":2},{"lineBreak":true},{"text":"Ani an Bab-Jehová-guedi we-ibmar soged.”","poem":2}]},{"type":"heading","content":["Bab-Jehová Gaza-yar-naid sabsur-odurdakoed"]},{"type":"verse","number":6,"content":["Bab-Jehová weyob soged:",{"text":"“Gaza-dorgan-e-isgued nue-wilub-obicha naid.","poem":1},{"text":"Sabsur-e-odurdaklegoedi, an ega osulogosulid.","poem":2},{"text":"Ar ade, Gaza-dorgan, bela neggweburmargi-dulemar-bukwad galesa sesmalad,","poem":1},{"text":"geb Edom-dorganga maiga manigi uksamalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ani an Gaza-neggwebur-e-galu-matusulid, soogi ogumakoed.","poem":1},{"text":"E-neg-gandikmalad-bukwad bela gummakoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asdod-dorgan-bukwamalad an osulogoed.","poem":1},{"text":"Ascalón-neggweburgi dummagan-mamaid an obelogoed.","poem":2},{"text":"Ecrón-neggweburgi gannar an-ganguedba an gwichigudoed,","poem":1},{"text":"Filistea-dule-napi-ambikumaloed bela an obelomogoed.","poem":2},{"lineBreak":true},{"text":"Ani an Bab-Jehová Bela-Gangued-Nikadi we-ibmar soged.”","poem":2}]},{"type":"heading","content":["Bab-Jehová Tiro-yar-naid sabsur-odurdakoed"]},{"type":"verse","number":9,"content":["Bab-Jehová weyob soged:",{"text":"“Tiro-dorgan-e-isgued nue-wilub-obicha naid.","poem":1},{"text":"Sabsur-e-odurdaklegoedi, an ega osulogosulid.","poem":2},{"text":"Ar ade, Tiro-dorgan, bela dulemar-gasa-sesmaladi, Edom-dorganga maiga manigi uksamalad.","poem":1},{"text":"Na gwenatigwar-gued-igar-ebo-mesismalad iesmalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani an Tiro-galu-matusurmalad, soogi ogumakoed.","poem":1},{"text":"E-neg-gandikmalad-bukwad bela gummakoed.”","poem":2}]},{"type":"heading","content":["Bab-Jehová Edom-yar-naid sabsur-odurdakoed"]},{"type":"verse","number":11,"content":["Bab-Jehová weyob soged:",{"text":"“Edom-dorgan-e-isgued nue-wilub-obicha-naid.","poem":1},{"text":"Sabsur-e-odurdaklegoedi, an ega osulogosulid.","poem":2},{"text":"Ar ade, Edom-dorgan, e-gwenadgan-wile-daksasulid.","poem":1},{"text":"Es-suidyalaba balegicha gusmalad.","poem":2},{"text":"Ar na saed-itoged ulubgi bargadsurmalad,","poem":1},{"text":"e-urwed gwen iessurmalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ani an Temán-neggwebur, soogi ogumakoed,","poem":1},{"text":"Bosra-neggwebur-e-neg-gandikmalad bela gummakoed.”","poem":2}]},{"type":"heading","content":["Bab-Jehová Amón-yar-naid sabsur-odurdakoed"]},{"type":"verse","number":13,"content":["Bab-Jehová weyob soged:",{"text":"“Amón-dorgan-e-isgued nue-wilub-obicha naid.","poem":1},{"text":"Sabsur-e-odurdaklegoedi, an ega osulogosulid.","poem":2},{"text":"Ar Amón-dorgan, na e-yarmar-abingunanaid onasogega,","poem":1},{"text":"Galaad-omegan-gurgin-nikamalad-ibe saban-maris nanaed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ani an Rabá-neggwebur-e-galu-matusurmalad soogi ogumakoed,","poem":1},{"text":"e-neg-gandikmalad bela gummakoed.","poem":2},{"text":"Bila-onolenaidgi oimaknanaidaeyob, sabsur-oimaknanai gumaloed.","poem":1},{"text":"Burwa-dummad-uurmakmaiyob, neg-oimaknai guoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amón-dorgan-e-rey gales seledoed,","poem":1},{"text":"bela e-dummagan eba gales seledmogoed.","poem":2},{"lineBreak":true},{"text":"Ani an Bab-Jehová-guedi we-ibmar soged.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}