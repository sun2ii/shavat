{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"AMO","translationId":"cuk_nvs","name":"Amós","commonName":"Amós","title":"AMÓS-GARDA AMÓS","order":30,"numberOfChapters":9,"sha256":"a953f41321bd5035db243fd9c1ef150ebe855f041d1dc1f9edf1242e6a747498","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cuk_nvs/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"heading","content":["Bab-Jehová Moab-yar-naid sabsur-odurdakoed"]},{"type":"verse","number":1,"content":["Bab-Jehová weyob soged:",{"text":"“Moab-dorgan-e-isgued nue-wilub-obicha-naid.","poem":1},{"text":"Sabsur-e-odurdaklegoedi, an ega osulogosulid.","poem":2},{"text":"Ar Moab-dulemar, Edom-e-rey-garmar ogumaksad,","poem":1},{"text":"burubi-guedse imaksad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ani an Moab-yala, soogi ogumakoed,","poem":1},{"text":"Queriot-neg-gandikmalad bela gummakoed.","poem":2},{"text":"Moab-dulemar bilagi-oimaknanaid-abalagi berguoed,","poem":1},{"text":"gar-trompeta-gornaid-abalagi burgoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"E-dummad-negsemaid, e-dulemar-wagab an osulogoed.","poem":1},{"text":"E-dummagan belagwable an eba obelogoed.","poem":2},{"lineBreak":true},{"text":"Ani an Bab-Jehová-guedi we-ibmar soged.”","poem":2}]},{"type":"heading","content":["Bab-Jehová Judá-yar-naid sabsur-odurdakoed"]},{"type":"verse","number":4,"content":["Bab-Jehová weyob soged:",{"text":"“Judá-dorgan-e-isgued nue-wilub-obicha naid.","poem":1},{"text":"Sabsur-e-odurdaklegoedi, an ega osulogosulid.","poem":2},{"text":"Ar Judá-dorgan, e-gakansamaladba Bab-Jehová-Igar-Maidgi aibatemalad,","poem":1},{"text":"Bab-Jehová-Igar-Sogmaidba nanassurmalad.","poem":2},{"text":"Bab-dummadyob-imaklemaladba nanasmalad,","poem":1},{"text":"e-dadgan-nanasadba nanasmarmogad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A-ulale, ani an Judá-yargi soo barmidoed,","poem":1},{"text":"Jerusalén-e-neg-gandikmalad bela gummakoed.”","poem":2}]},{"type":"verse","number":6,"content":["Bab-Jehová weyob soged:",{"text":"“Israel-dorgan-e-isgued nue-wilub-obicha naid.","poem":1},{"text":"Sabsur-e-odurdaklegoedi, an ega osulogosulid.","poem":2},{"text":"Ar Israel-dorgan, dule-nued manigi uksamalad,","poem":1},{"text":"Israel-dorgan, dule-wilese-gudimalad sapat-gwagwen-muchub uksamarbalid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Dule-wilegana sabsur-ise-wilegar imaksamalad,","poem":1},{"text":"mesagwale imaksamalad.","poem":2},{"text":"Wileganaga igar-maidba igar nabossurmalad.","poem":1},{"text":"Baba, galagwensuli ome-wargwengi nanadidaed,","poem":2},{"lineBreak":true},{"text":"a-omegi, e-machi galagwensuli nanadidamogad.","poem":2},{"text":"Weyob an-nug-isligwaled oichosmalad.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Amarde, yogasaaledgi bab-dummaganga-ibmar-ukleged-ailamar-dikarba, mor-manigi-siid, na megega ebudamalad.","poem":2},{"lineBreak":true},{"text":"Dule-mani-ganikid-ibe-vino-sulesadi, e-bab-dummaganse-goled-neggi gobdamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”We-dulemar-wagab, Amorreo-dulemar an obelosad,","poem":1},{"text":"amar-ibe e-ibmar-nikumaid an osulosad,","poem":2},{"lineBreak":true},{"text":"e-gandik-bukwad an ei osulosad.","poem":2},{"text":"Ar Amorreo-dulemar urwaryobi sugu-inigwele,","poem":1},{"text":"encina-sapimaryob dutusur-inigwele, an obelosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Egipto-yargi-noega an bemar-imaksamalad.","poem":1},{"text":"Nega-dulesulidganba birga-dulabo (40) an bemar-idudii gusad,","poem":2},{"lineBreak":true},{"text":"adi, Amorreo-dulemar-bukwamalad-e-yala bemarga ukegar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Deginbali, be-mimmigan-imbagi, an-gayaburba-barsogmalad an nugsasad.","poem":1},{"text":"Be-sapingan-imbagi, dulemar-anga-nugsalesad an susbalid.","poem":2},{"lineBreak":true},{"text":"A-dulemarde, Nazareo-duleye bilesmalad.","poem":2},{"text":"Israel-dulemar, ¿weyob ibmar-gusadi napirasursi? Deyobdo.","poem":1},{"text":"Ani an Bab-Jehová-guedi we-ibmar soged.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Degi-inigwele, dule-anga-nugsalesad Nazareoʼye-bileged, vino-gobega be imaksamalad.","poem":1},{"text":"An-gayaburba-barsogedga be sogsamalad:","poem":2},{"lineBreak":true},{"text":"‘Mer Bab-Jehová-gayaburbagi sunmakoye.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Israel-dorgan, a-ulale, an sabsur-apor bemar-imakoed,","poem":1},{"text":"igi ur-dummad-napagined orosgwaggi-dakleged ena-danikir, ibmar-birgi-nasar ibmar gullu-gullu imake,","poem":2},{"lineBreak":true},{"text":"deyob an bemar-imakoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dule-gwae-gwae-abarmaked, angi wakinnosurguoed.","poem":1},{"text":"Dule-dutusulid, dukin e-garganguedba bendaklegosulid.","poem":2},{"text":"Dule-gandikidbela, dukin na e-san bendakosurmogad.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Dule-sigumied, an-abin gwisguosurguoed.","poem":2},{"text":"Dule-gwae-gwae-nanaed, angi wakinnosurguoed,","poem":1},{"text":"dule moligi-sii-wakinmaile, na san-onogosulid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"A-ibagi, sorda-bila-onomalad-bur-gandikmaladi, uka-swili wakinmai guoed.","poem":1},{"text":"Ani an Bab-Jehová-guedi we-ibmar soged.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}