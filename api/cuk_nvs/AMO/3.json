{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"AMO","translationId":"cuk_nvs","name":"Amós","commonName":"Amós","title":"AMÓS-GARDA AMÓS","order":30,"numberOfChapters":9,"sha256":"a953f41321bd5035db243fd9c1ef150ebe855f041d1dc1f9edf1242e6a747498","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cuk_nvs/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Amós Israel-dulemarga ibmar-sognaid"]},{"type":"verse","number":1,"content":["¡Israel-dulemar, we-gayaburba be nue itomalo! Bab-Jehová bemar-annik, degi, bela Egipto-yargi dulemar-noargusmalad-annik weyob soged:"]},{"type":"verse","number":2,"content":[{"text":"“Bela-dulemar-napneggi-bukwad-abargi","poem":1},{"lineBreak":true},{"text":"unnila bemarbi an be-susad.","poem":1},{"text":"Degi-inigwele, bela-bemar-ibmar-isgana-imaksadbali, an sabsur-bemar-odurdakoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¿Dule na ebo igar-amisulile,","poem":1},{"text":"sunna ebo-nued-gudiguo be ebinsae? Suli.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"¿Achumigur san ganisulile, uurmako be ebinsae? Suli.","poem":1},{"text":"¿Achumigur-sapingwa, e-gubya-yaba san ganisuli-maile, uurmako be ebinsae? Suli.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Nuu-galu-yaba mas-sisulir, nuu galego be ebinsae? Suli.","poem":1},{"text":"¿Nuu-galu walagwengi ibmar-galesuli atido be ebinsae? Suli.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¿Neggweburgi gar-trompeta gollalile,","poem":1},{"text":"dulemar dobedba oimakardasur be ebinsae? Eye.","poem":2},{"text":"¿Neggweburgi boni-dummadgan-noedi,","poem":1},{"text":"Bab-Jehová imaksur be ebinsae? Eye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ar napiragwad, Bab-Jehová-Bur-Gandik-Maidi,","poem":1},{"text":"e-gayaburba-barsogmaladga ibmar-sogsasuli geg ibmar imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ar achumigur uurmakalile, ¿doa dobguosur be ebinsae?","poem":1},{"text":"Bab-Jehová-Bur-Gandik-Maid sunmakele, ¿doa e-gayaburba barsogosur be ebinsamoga?","poem":2}]},{"type":"heading","content":["Israel-yala sabsur-odurdaklegoed"]},{"type":"verse","number":9,"content":[{"text":"Asdod-e-neggandikmaladgi binnasur be sogmalo,","poem":1},{"text":"Egipto-yar-neg-gandikmaladgi binnasur be sogmarbalo.","poem":2},{"text":"Weyob be sogmalo: “Samaria-yar-birse be ambikudamar,","poem":1},{"text":"agi dobed-dummad-naid be dakdamar,","poem":2},{"lineBreak":true},{"text":"agi sabsur-wilenanaid be dakdamar.”","poem":2}]},{"type":"verse","number":10,"content":["Bab-Jehová soged:",{"text":"“Bemar, igar-innikigwadba geg nanamalad:","poem":1},{"text":"Ar bemar sabsur-urwedgi-ibmar-sumaladid,","poem":2},{"lineBreak":true},{"text":"reyneggi a-ibmar sabomaladid.”","poem":2}]},{"type":"verse","number":11,"content":["A-ulale, Bab-Jehová-Bur-Gandik-Maid weyob soged:",{"text":"“Be-isdarmalad-wargwen gandikidgi be-yar sunonikoed.","poem":1},{"text":"Be-neggandikmaladi bela bei earmaloed.","poem":2},{"lineBreak":true},{"text":"Be-reynegmargi-ibmar-nuegan-bukwad bela bei sumaloed.”","poem":2}]},{"type":"verse","number":12,"content":["Bab-Jehová weyob soged:",{"text":"“Igi-sibad-wawaad-edarbedi, e-sibad-wawaad achumigurse-galealile, aisaar na bendaknaidae,","poem":1},{"text":"degi-inigwele, unnila e-malibi, e-uayadukubidibe na gadapdae,","poem":2},{"text":"deyobi, wis Israel-dorgan-Samariaʼgi-bukwadi san-onogoed.","poem":1},{"text":"Deyobi, wis Israel-dorgan-Damasco-neggweburgi gan-mua-muadgi-sigmaladi, san-onogoed.”","poem":2}]},{"type":"verse","number":13,"content":["Bab-Dummad-Jehová-Bela-Gangued-Nika-Maid weyob soged:",{"text":"“Nuekwa be an-itomalo.","poem":1},{"text":"Jacob-dulemarga iduakwaa be ibmar sogmarmogo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Israel-dorgan e-ibmar-isgana-imaksad-ulale,","poem":1},{"text":"an sabsur-odurdakoed-ibagine, Betelʼgi e-ibmar-ogumakar-ukleged-ailamar an obelogoed.","poem":2},{"text":"Ibmar-ogumakar-ukleged-ailagi moli-bebegiid-bukwad an bibisgoed,","poem":1},{"text":"bela napagi an mioed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dii-wied-ibagi-obunnoged-negmar bela an bibisgoed,","poem":1},{"text":"yorgi-obunnoged-negmar bela an eyaroed.","poem":2},{"text":"Akwa-marfilʼye-nugadgi negmar-sobarmalad bela an osulogoed.","poem":1},{"text":"Bukidar nega-dummagan-bubukwadi an eyaroed.","poem":2},{"lineBreak":true},{"text":"Ani an Bab-Jehová-guedi we-ibmar soged.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}