{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"AMO","translationId":"cuk_nvs","name":"Amós","commonName":"Amós","title":"AMÓS-GARDA AMÓS","order":30,"numberOfChapters":9,"sha256":"a953f41321bd5035db243fd9c1ef150ebe855f041d1dc1f9edf1242e6a747498","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cuk_nvs/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["Omegan-Samariaʼginmalad mani-ibegan"]},{"type":"verse","number":1,"content":[{"text":"Bemar, omegan-Samariaʼginmalad, an bega ibmar-sogoed be itomar:","poem":1},{"text":"Bemar, Basán-yalagi moli-bebe-nikad-ome-wardummaganyob gumalad.","poem":2},{"text":"Bemar, dule-wilegana sabsur-wiobukmalad,","poem":1},{"text":"ise-mesagwale, be dule-wilegana imakbukmalad.","poem":2},{"text":"Be-suimargarbela be sogbukwadamalad:","poem":1},{"text":"“Vino anga sedaye.”","poem":2}]},{"type":"verse","number":2,"content":["Bab-Jehová-Bur-Gandik-Maidi, e-san-isligwaledba ise-sogar soged:",{"text":"“Bemargi ibagan-dani, bemar belagwable akegi ebipilemai gumaloed,","poem":1},{"text":"achwer-nugar-dummagangi-gales be ebipilemai gumaloed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bemar neggwebur-galu-matusulid-ayaroedbali ilekwaa ainimai gumaloed.","poem":1},{"text":"Geb Hermón-yarse be-metemaloed.","poem":2},{"lineBreak":true},{"text":"Ani an Bab-Jehová-guedi weyob soged.”","poem":2}]},{"type":"heading","content":["Israel-dulemar sabsur-odurdakleged amba itosurmalad"]},{"type":"verse","number":4,"content":[{"text":"“Betel-neggweburse be namar,","poem":1},{"text":"ase be isgunamar.","poem":2},{"text":"Gilgal-neggweburse be namar,","poem":1},{"text":"bur bule ase isgudii be sanamar.","poem":2},{"text":"Bane-bane wakudaryalaba ibmar-ukleged be uknamar.","poem":1},{"text":"Ibapaagi ibmar-ambegi-gwensak-ukleged (10%) be uknamar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dog-nuedye-sogega, madu-ina-nikad be ogumaknamar.","poem":1},{"text":"Bela dule be owisomala,","poem":2},{"text":"na ibmar-ukleged e-itoleged-ukbiedba ibmar sedamaloye.","poem":1},{"text":"Ar Israel-dulemar, weyob abemalad.","poem":2},{"lineBreak":true},{"text":"Ani an Bab-Jehová-guedi weyob soged.”","poem":2}]},{"type":"heading","content":["Israel-dulemar Bab-Dummadba yapa ibsaed"]},{"type":"verse","number":6,"content":[{"text":"“Ani an bela be-neggweburmargi ukud-dummad nasiksad,","poem":1},{"text":"bela be-dulemar-bukwadga masgulleged an osulosad.","poem":2},{"text":"Degite, bemar deyob-gusmar-inigwele, gwen gannar anse aibilissurmalad.","poem":1},{"text":"Ani an Bab-Jehová-guedi weyob soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Nii-warbaase ibmar-gwag-welegoed-iduale, dii bar an owissulid.","poem":1},{"text":"Unnila neggwebur-gwagwengi dii an owisad.","poem":2},{"lineBreak":true},{"text":"Neggwebur-baidgindi dii an owissulid.","poem":2},{"text":"Nainu-gwensakgi dii-winai gusad.","poem":1},{"text":"Baid-nainugindi dii wissulid,","poem":2},{"lineBreak":true},{"text":"abali, nainu dingude gusad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Degisoggu, dulemar neggwebur-baid-baidse dii-amidii gusmalad.","poem":1},{"text":"Wis-gobsamar-inigwele, amba uku-uku-itogedi surgussurmalad.","poem":2},{"text":"Degite, bemar deyob-gusmar-inigwele, gwen gannar anse aibilissurmalad.","poem":1},{"text":"Ani an Bab-Jehová-guedi weyob soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Be-ibmar-digarmalad bonigangi an obelosad,","poem":1},{"text":"neg-uedikidba an dinare imaksad.","poem":2},{"text":"Sesmar be-nainugan obelosad,","poem":1},{"text":"sesmar be-uva-digar-nanaid oburgwisad.","poem":2},{"text":"Sesmar be-higuera-sapimar obelosad,","poem":1},{"text":"degi, be-olivo-sapimar obelosbalid.","poem":2},{"text":"Degite, bemar-ibe deyob-ibmar-gus-inigwele, bemar gwen gannar anse aibilissurmalad.","poem":1},{"text":"Ani an Bab-Jehová-guedi weyob soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Egipto-dulemargi bonigan an barmisgusayobi, an bemargi barmisgusad.","poem":1},{"text":"Es-suidgi be-sapingan an oburgwisad,","poem":2},{"text":"e-molimar-galesmalad an ogilosbalid.","poem":1},{"text":"Dule-burgwismalad-e-mui-yapanned neg-gagasa an nasiksad.","poem":2},{"text":"Degite, bemar deyob-gusmar-inigwele, gwen gannar anse aibilissurmalad.","poem":1},{"text":"Ani an Bab-Jehová-guedi weyob soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”An Sodoma-neggwebur-wiosayobi, degi, Gomorra-neggwebur-wiosayobi, an bemar-wiosmogad.","poem":1},{"text":"Bemar suar soose-negabar-gummaksayobi gusmalad.","poem":2},{"text":"Degite, bemar deyob-gusmar-inigwele, gwen gannar anse aibilissurmalad.","poem":1},{"text":"Ani an Bab-Jehová-guedi weyob soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Israel-dulemar, be anse aibilissurmalad-ulale, an begi gwichigumogoed.","poem":1},{"text":"Israel-dulemar, begi an gwisguosoggu, an-iduar guakwa be gudimalo.","poem":2},{"lineBreak":true},{"text":"Ar bemar we-ibmar-guoedi igar-gaosurmalad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Dule-yarmar-nasiksadi, burwamar-obinnisadi, dulemarga-ibmar-guoed-sogedi, Bab-Jehováʼye nugad.","poem":1},{"text":"Neg-meegwad, negsichidga obinyedi, yarmar-birgi-nanaedi, Bab-Jehováʼye nugad,","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-Bela-Gangued-Nikadid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}