{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"AMO","translationId":"cuk_nvs","name":"Amós","commonName":"Amós","title":"AMÓS-GARDA AMÓS","order":30,"numberOfChapters":9,"sha256":"a953f41321bd5035db243fd9c1ef150ebe855f041d1dc1f9edf1242e6a747498","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cuk_nvs/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Israel-dulemar gannar-Bab-Jehováʼba-nanaegala unalesad"]},{"type":"verse","number":1,"content":[{"text":"Israel-dulemar, nue itomalo,","poem":1},{"text":"gayaburba-wile-itoged-namaklegedgi, an bega namaksokalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Israel-dulemar yagwa-swilidik-yeerdaklegedyobid, be sabsur-omukulesmalad.","poem":1},{"text":"Bar be gannar gwisguosulid.","poem":2},{"text":"Napagi meremai be guoed,","poem":1},{"text":"dule-be-ogwised sate guoed.”","poem":2}]},{"type":"verse","number":3,"content":["Bab-Jehová-Bur-Gandik-Maid, Israel-dulemarga weyob soged:",{"text":"“Neggwebur-gwensak sorda-miligwen (1,000) bila-onogedse-naele,","poem":1},{"text":"unnila dulatar (100) durgumaloed.","poem":2},{"text":"Ar neggwebur-gwensak dulatar (100) bila-onogedse-naele,","poem":1},{"text":"unnila e-ambe (10) durgumaloed.”","poem":2}]},{"type":"verse","number":4,"content":["Bab-Jehová Israel-dulemarga weyob soged:",{"text":"“Be an-amimalale, be dula-gudii gumaloed.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Melle be Betel-neggweburse bar namala.","poem":2},{"text":"Gilgal-neggweburse melle be bar namala,","poem":1},{"text":"degi, Beerseba-neggweburse melle be bar namarbali,","poem":2},{"text":"ar ade, Gilgal-dulemar galesa seledmaloed,","poem":1},{"text":"degi, Betel-neggweburdi bela berguoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bab-Jehová be amimala, adi, be dula-gudii gumaloed.","poem":1},{"text":"Degisulile, Bab-Jehová José-wagangi sooyobi aidenonikoed,","poem":2},{"text":"We-soo, bela Betel-neggwebur ogumakoed.","poem":1},{"text":"Dule we-soo-oginnega sate guoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Igar-innikigwadi, igar-isganaga be imakmalad.","poem":1},{"text":"Bur Igar-napiragwadi obanagwar be imakmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad niisgwa-danaled Pléyadesʼye-bileged obinnisad,","poem":1},{"text":"degi, niisgwa-baigan Oriónʼye-bileged obinnisbalid.","poem":2},{"text":"Bab-Dummad neg-sipusulidi, neg-meegwadga imaked,","poem":1},{"text":"degi, neg-meegwad, negsichidga imakbalid.","poem":2},{"text":"Bab-Dummad demar-bukibse goled. Geb napneggi dii-owiega imaked.","poem":1},{"text":"¡E-nuga, Bab-Jehováʼye nugad!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bab-Jehová neggandikmalad osuloged,","poem":1},{"text":"dule-ambikued-neggandikmalad osulobalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bemar, igar-nudaked-neggi dule-igar-nudakega-arbamaladi, isdar dakmalad,","poem":1},{"text":"degi, dule-napira-ibmar-soged, isdar be dakmarbalid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar bemar, dule-wilegana ibigwensuli imakmarsoggu,","poem":1},{"text":"degi, orosgi-dakleged-trigoʼgi, mani-galeged-bennuked ega be igar-mesismarsoggu,","poem":2},{"text":"a-ulale, be-akwa-neg-sobsamaladgi, be megosurmalad.","poem":1},{"text":"Degine, nainugi be-uva-naid-e-vino gwen be gobosurmalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bemar-ibmar-isgana-yaisur-imaksad an wisid,","poem":1},{"text":"be-isgumalad-yaisulid an wisid.","poem":2},{"lineBreak":true},{"text":"Bemar, dule-innikigwad ibgwensur imaked,","poem":1},{"text":"igar-nabolemaladgi emarse be manigi baklemalad.","poem":2},{"lineBreak":true},{"text":"Degine, igar-nabolegedgi dule-wileganagi be gwisgumalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Agala, weyob neg-gunaidgine, dule-binsaed-nikadaedi bogi gudidaed.","poem":1},{"text":"Ar ade, we-ibagande nuedsulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Melle igar-isgana be amimala, bur igar-nued be amimala,","poem":1},{"text":"adi, be dula-gudii gumaloed.","poem":2},{"text":"Degidbali, Bab-Dummad-Jehová-Bela-Gangued-Nikadi,","poem":1},{"text":"bemarba gudii guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Igar-isgana be obane, igar-nuedbina be soge,","poem":1},{"text":"igar-nabiroleged-neggi, igar-innikigwadba igar be nabomala.","poem":2},{"text":"Abakale, Bab-Dummad-Jehová-Bela-Gangued-Nika-Maid,","poem":1},{"text":"José-wagan-besmalad wile dakalile.","poem":2}]},{"type":"verse","number":16,"content":["Agala, Bab-Dummad-Jehová-Bela-Gangued-Nika-Maid weyob soged:",{"text":"“Bela-dule-ambikumaladgi, dulemar-ise-boale itolegoed,","poem":1},{"text":"degi, bela galimbaba wile-itolegedba binnasur-gornanai itolegoed.","poem":2},{"text":"Bomalaga sapur-dorganse gorlegoed,","poem":1},{"text":"degi, bomalaga dulemar-manigi-bomaladse gorlegoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"An sabsur-bemar-wiodanikile,","poem":1},{"text":"bela uva-digarmaladba dule-boe itolegoed.","poem":2},{"lineBreak":true},{"text":"Ani an Bab-Jehová-guedi weyob soged.”","poem":2}]},{"type":"heading","content":["Bab-Jehová-e-iba"]},{"type":"verse","number":18,"content":[{"text":"Dule, Bab-Jehová-sabsur-odurdaked-iba-abitogele, ¡duledar-wilesmar!","poem":1},{"text":"¿Ar ibiga we-ibade edarbesunna?","poem":2},{"text":"Ar we-iba negasichidbi naguoed,","poem":1},{"text":"neg-meegwad naguosulid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dule aisaar achumigur-idu-wakinmaiyob guoenad,","poem":1},{"text":"degi-inigwele, wiob-abingudagoed.","poem":2},{"lineBreak":true},{"text":"Deyobiyobi, a-iba ega guoed.","poem":2},{"text":"Dule e-negyaba-dogmaile, galugi akadapiyob guoed,","poem":1},{"text":"galugi-akadapidba naibegi-warmaksayobi guoed.","poem":2},{"lineBreak":true},{"text":"Deyobiyobi, a-iba ega guoed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bab-Jehová-sabsur-odurdaked-ibade negasichidbi-nai guoed, neg-meegwad-nai guosulid.","poem":1},{"text":"Bela neg-gubyagwaledbi-nai guoed, neg dale-dalesaar daklegosulid.","poem":2}]},{"type":"verse","number":21,"content":["Bab-Jehová sogdebalid:",{"text":"“Ibamar be anga onogedi, an isdar-daked.","poem":1},{"text":"Bemar bulakwaa an-nug-odummogega itoakwaa-anse-gormaladi, yeer-ito an-imaksulid.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar bemar anga be-ibmar-ogumakar-ukleged ukele, an abingaosulid.","poem":1},{"text":"Ibmar-gwagmar anga be ukele, an abingaosurbalid.","poem":2},{"text":"Amba gwenatigwar-guega moli-bebe-nikad-senigana-wardummagan-ukleged,","poem":1},{"text":"an be-ibe abingaosurbalid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Be-namaked-oimaksiid an itobisulid.","poem":1},{"text":"Be-gar-cítara-goled, an itobisulid.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bur, dii-aryomaiyobi, igar-naboleged galesuli selemai abeleged,","poem":1},{"text":"degi, diwar-suurmakmaiyobi, igar-innikimalad selemai abeleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"”Israel-dulemar, bemar birga-dulabo (40) nega-dulesulidganba gudigusmargua,","poem":1},{"lineBreak":true},{"text":"¿anga be napiragwadgi ibmar-ogumakar-ukleged uksamarsi?","poem":1},{"text":"¿Anga be napiragwadgi ibmar-ukleged uksamarsi? Suli.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Emide, bemarde nuchu-Moloc-e-neg-sobaled be semamaid.","poem":1},{"text":"Degi, nuchu-Quiún be semamaid.","poem":2},{"text":"Wemarde niisgwa-e-nuchumar-nanaed,","poem":1},{"text":"bemar we-ibmarmar-sobsamaladi, gwen Bab-Dummadsulid.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Degisoggu, dikasuli Damasco-neggwebur-dakasik an be-balimetemaloed.”","poem":1},"Bab-Jehová deyob soged. E-nuga, Bab-Dummad-Bela-Gangued-Nikadye nugad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}