{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"AMO","translationId":"cuk_nvs","name":"Amós","commonName":"Amós","title":"AMÓS-GARDA AMÓS","order":30,"numberOfChapters":9,"sha256":"a953f41321bd5035db243fd9c1ef150ebe855f041d1dc1f9edf1242e6a747498","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cuk_nvs/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["Bab-Dummad Israel-dulemar-sabsur-imakoed"]},{"type":"verse","number":1,"content":["Amós sogdebalid:",{"text":"“Dule-Sión-neggweburgi-baisuli-itodimalad, ¡duledar-wilesmar!","poem":1},{"text":"Samaria-yargi-dobsulidba-gudidimalad, ¡duledar-wilesmar!","poem":2},{"text":"Dule-nug-nikamalad neggwebur-dummagangi-mamaid, ¡duledar-wilesmar!","poem":1},{"text":"A-dulemarse Israel-dulemar bendakleged egisnaddamalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Calne-neggweburse be namar, nue be dakmalo.","poem":1},{"text":"Agi bukwa, Hamat-neggwebur-dummadse be namarbalo.","poem":2},{"text":"Geb sorba Filistea-neggwebur-Gatʼye-nugadse be namarbalo.","poem":1},{"text":"¿Ar bemarde we-neggweburmargi bur obinmarde?","poem":2},{"lineBreak":true},{"text":"¿Bemar-yarde bur we-yarmarba dummadye sogde?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bemar iba-isgana obangumarye be bimalad,","poem":1},{"text":"aka, be neg-nue-gagaled-iba warmakega imakmalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Be-gabed-megmaladgi elefante-nugar-goamar nanaid, a-megedgi na be megdimalad,","poem":1},{"text":"degi, be-gan-siged-mua-muad-dummadgi be bilikwaa sigdimalad.","poem":2},{"text":"A-gangi-sii, bemar sibad-wawaad-mimmigan-e-galugi-sulearmalad gundimalad,","poem":1},{"text":"degi, moli-bebe-nikad-senigana-wardummagan be gundimarbalid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bemar, David-namakeyob namakye be sogmalanad,","poem":1},{"text":"yogasaar be namakmalad.","poem":2},{"text":"Gar-cítaraʼba be namakdedamalad.","poem":1},{"text":"Be-itoleged, gar-gormalad be obinyedamalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bemar nog-dummagangi vino be gobdimalad.","poem":1},{"text":"Degi, ina-wawadikid-nuegan be ebudimarbalid.","poem":2},{"text":"Ar José-e-wagan-e-neg-bibichisadba","poem":1},{"text":"nunmaked-dummad, eba nunmak be itosurmalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A-ulale, emidi bemar-inse dulemar-galesa-seledmaloed-iduar seledmaloed,","poem":1},{"text":"deyobi, dulemar-galagwensur-iba-onomalad berguoed.”","poem":2}]},{"type":"heading","content":["Israel-dulemar-san-dummarba-itoged-ular, Bab-Jehová sae-itoged"]},{"type":"verse","number":8,"content":["Bab-Dummad-Jehová na dukin ise-sogar imaksad. Bab-Dummad-Jehová-Bela-Gangued-Nikad weyob soged:",{"text":"“Jacob-wagan san-dummarba-imaked an isdar-daked.","poem":1},{"text":"E-neg-gandikmalad an sae-daked.","poem":2},{"text":"Agala, e-neggwebur e-isdarmaladga an urmakoed,","poem":1},{"text":"degi, bela e-ibmar-nikadi an e-isdarmaladga urmakoed.”","poem":2}]},{"type":"verse","number":9,"content":["Weyob neg gudoed: Dule neg-gwagwengi e-ambe (10) dula besale, bela burgwemaloed."]},{"type":"verse","number":10,"content":["Geb e-gwenad-gwensak muimar-ogumakega, a-negse muimar-sudanikile, dule-neggi-gudiidga weyob sogdoed: “¿Dule-baid amba be-walik gudii?” Geb dule weyob abin sogdoed: “Suli.” Geb degidgine, ega sogdoed: “¡Boogwa! Anmar geg Bab-Jehová-nug obared.”"]},{"type":"verse","number":11,"content":[{"text":"Ar Bab-Jehová igar-ukdoed:","poem":1},{"text":"Neg-dummagan bibisgeye,","poem":2},{"lineBreak":true},{"text":"degi, neg-burwigana ubigwar imakye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Ar molimar akwa-dummagan-imbaba abarmaksi?","poem":1},{"text":"¿Ar akwa-dummagangi nabir moli-bebe-nikad napa imusi?","poem":2},{"text":"Ar bemardi, igar-innikigwad, ibmar-isganaga obinnismalad.","poem":1},{"text":"Igar-innikigwad-selemaid, boniga be obinnismalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bemar ibmar-gwen-imaksasulidgi be wergudimalad.","poem":1},{"text":"Be sogmalad: “Anmar-ganguedgi anmarde gargangued nikusmarye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Degisoggu, Israel-dulemar, Bab-Jehová-Bela-Gangued-Nikadi soged:","poem":1},{"text":"“Bemargi neggwebur-soggwen gwichiguega an imakoed.","poem":2},{"text":"A-neggwebur ise-mesagwale bemar-imakoed.","poem":1},{"text":"Hamatʼse-doglemaid-akale, Arabá-diwar-maidse, bemar ese odurdaklegoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}