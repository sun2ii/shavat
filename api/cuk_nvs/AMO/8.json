{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"AMO","translationId":"cuk_nvs","name":"Amós","commonName":"Amós","title":"AMÓS-GARDA AMÓS","order":30,"numberOfChapters":9,"sha256":"a953f41321bd5035db243fd9c1ef150ebe855f041d1dc1f9edf1242e6a747498","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cuk_nvs/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["Amós sapi-san-gorogana garbagi-bukwa daksad"]},{"type":"verse","number":1,"content":["Bab-Jehová-Bur-Gandik-Maid, negburgan anga oyosbalid: Garbagi sapi-san-gorogwad-bukwa an daksad."]},{"type":"verse","number":2,"content":["Degi, anse egichided: —Amós, we, ¿ibu be dake? Degi, an abin-sogde: —Garbagi sapi-san-gorogana-bukwa an daked. Degidgine, Bab-Jehová anga sogded: —Israel-dulemar-e-bergued-ibagan warmaknonikid. Ibmar-san-gorogwayobi berguoed. Israel-dulemarga e-isgued bar an eliosulid."]},{"type":"verse","number":3,"content":["Bab-Jehová-Bur-Gandik-Maid sogded: —A-ibagangi, reyneggi-namaklemalad, boedga guoed. Dulemar-bukidar yogasaar burgwar-burgwar omilede gumaloed. Degi, bogidikidgi muimar yogasaar metemaloed."]},{"type":"verse","number":4,"content":[{"text":"Nue be an itomalo,","poem":1},{"text":"bemar, dulemar-wilegana sabsur-imakmalad,","poem":2},{"lineBreak":true},{"text":"bemar, dule-wilegana obelodimarbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Bemar sogmalad:","poem":1},{"lineBreak":true},{"text":"‘Anmar ibmar-gwagmar manigi ukega, ¿sana we nii-gebe-gwisgusad-e-iba berguoe?","poem":1},{"text":"Anmar ibmar-gwag-orosgi-dakleged-trigo manigi ukega,","poem":2},{"lineBreak":true},{"text":"¿sana we itoged-iba berguoe?’","poem":2},{"lineBreak":true},{"text":"”Bemar ibmar-nibirgi-uked bur ichee-gued abediid.","poem":1},{"text":"E-manidi odummoged abediid.","poem":2},{"lineBreak":true},{"text":"Emar-yardakega nibir-nuedsulid ebudamalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Orosgwaggi-dakleged-e-solamar bemar manigi ukdamalad.","poem":1},{"text":"Bemar dule-wilegana manigi bakdamarbalid,","poem":2},{"lineBreak":true},{"text":"degi, dule-ibmar-abedimalad nag-uka-gwagwengi unnir bakdamarbalid.”","poem":2}]},{"type":"verse","number":7,"content":["Bab-Jehová, Jacob-dulemar-e-san-dummarba-imakedgi, ise-sogar sogded: “Ibmar be imaksamaladi, an gwen iegosulid."]},{"type":"verse","number":8,"content":[{"text":"Deyob bela neg-guoed-ulale, ¿napade giglimakosuli?","poem":1},{"text":"¿Bela e-dulamar boosurmala?","poem":2},{"text":"Bela napa, Nilo-diwar-engumaiyobi megoed, dogdoed.","poem":1},{"text":"Agi Egipto-diwar-ilideyobi, ilidoed.”","poem":2}]},{"type":"verse","number":9,"content":["Bab-Jehová-Bur-Gandik-Maid sogdebalid:",{"text":"“A-ibagi, yorukudba dad-galegega an imakoed,","poem":1},{"text":"degi, napneggi ibginedba negsichid an nasikoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Be-iba-onomalad ise-bukib-binsaleged-ibaga an imakoed.","poem":1},{"text":"Degi, be-namakmalad,","poem":2},{"text":"namakmalad-ise-bukib-binsaedga an imakbaloed.","poem":1},{"text":"Bukib-binsaleged-e-mor-yoega an bemar-imakbaloed.","poem":2},{"text":"Degi, be-nono swanga-imakega an be-imakbaloed.","poem":1},{"text":"Machi-wargwennagwad-burgwisar, ega bonanaidaeyob ise-boar bemar bomaloed,","poem":2},{"lineBreak":true},{"text":"degi, ibagan nunmaked-dummad-nai bergudoed.”","poem":2}]},{"type":"verse","number":11,"content":["Bab-Jehová-Bur-Gandik-Maid sogdebalid:",{"text":"“Ibagan-danikid, napneggi an ukud-dummad nasikoed.","poem":1},{"text":"We-ukudde, masgulleged an obarsulid,","poem":2},{"text":"degi, uku-uku-itogedgi-dii-gobleged an obarsurbalid.","poem":1},{"text":"An obaredi, dulemar an-gayaburba-itobiedba uku-uku-gudiguoed, an obared.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Degisoggu, dulemar, Bab-Jehová-Gayaburba-amiega, igarsuli demar-mataganba namaloed.","poem":1},{"text":"Igarsuli dad-nakwed-argan-sapiledsik, degi, dad-nakwedsik gudii gumaloed.","poem":2},{"lineBreak":true},{"text":"Degi-inigwele, Bab-Jehová-gayaburba gwen amiosurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”A-ibagine, yagana-yeerdaklemalad, sapingana-gandikmalad, uku-uku-itogedba negoedmaloed.","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Dulemar Samaria-dorgan-e-isgudiidga ise-sogar sogdamaladi bergumaloed, bar-durguosurmalad","poem":2},{"text":"Amarde sogmalad: ‘Dan-neggwebur-e-bab-dummad-dula-gudiidba ise-sogar an bega sogye.’","poem":1},{"text":"Degi, sogdamarbalid: ‘Beerseba-neggwebur-e-bab-dummad-dula-gudiidba ise-sogar an bega sogye.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}