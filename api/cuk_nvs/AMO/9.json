{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"AMO","translationId":"cuk_nvs","name":"Amós","commonName":"Amós","title":"AMÓS-GARDA AMÓS","order":30,"numberOfChapters":9,"sha256":"a953f41321bd5035db243fd9c1ef150ebe855f041d1dc1f9edf1242e6a747498","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/cuk_nvs/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["Amós, Babse-goled-neg-bibichilesad-negburgan daksad"]},{"type":"verse","number":1,"content":["Dule-Dummad ibmar-ogumakar-ukleged-aila-dikarba-gwichi an daksad, degi, anga sogded:",{"text":"“Buarmar-e-bargamalad be omukue,","poem":1},{"text":"adi, buarmar giglimakega, dulemar-e-nonogi babatidoed.","poem":2},{"text":"Dulemar-burgosurmaladdi es-suidgi an osulogoed.","poem":1},{"text":"Dulemar-wargwensaar wakinnosulid,","poem":2},{"lineBreak":true},{"text":"wargwensaagwar durguosulid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Israel-dulemar neg-uan-napa-uluba dukuye-sogele, amba an onogoed.","poem":1},{"text":"Ar amba nibanegse nakweye-sogele, amba an amar-odegoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amba Carmelo-yar-birba dukuye-sogele,","poem":1},{"text":"ase an aminaoed, degi, an gaoed.","poem":2},{"text":"Demar-mata-wilasorse angi dukuye-sogele,","poem":1},{"text":"amba naibe-demargined egi-warmakega an barmidoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Israel-dulemar, e-isdarmaladse-galesa selenadapidgine, an igar-ukoed,","poem":1},{"text":"es-suidgi amar-oburgwegar.","poem":2},{"text":"Israel-dulemargi nue an nakulegoed.","poem":1},{"text":"An egi-nakulegoedi, ibmar-nued ega imakegarsulid.","poem":2},{"lineBreak":true},{"text":"Ibmar-isganaga imakegalad.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová-Bur-Gandik-Maid, Bela-Gangued-Nikad-Maid napa ebugele, napa maludoed.","poem":1},{"text":"Napa mullumakmai megoed,","poem":2},{"text":"Egipto-diwar-Nilo-maiyob megoed,","poem":1},{"text":"degi, bela dule-bukwamalad ise-boar gumaloed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad nibaneggi na e-neg nasiksad,","poem":1},{"text":"degi, napaneggi e-neg-sailagan nasiksabalid.","poem":2},{"text":"Dii napaneggi-owiegala, demar-mata-obupurmakega imaked.","poem":1},{"text":"E-nuga, Bab-Jehováʼye nugad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Israel-wagan, Bab-Jehová soged:","poem":1},{"text":"“¿Ar bemarde anga Etiopía-dulemaryob-gusursi?","poem":2},{"text":"¿Ar ande Egiptoʼgi Israel-dulemar-onissursi?","poem":1},{"text":"¿Caftor-yargi Filistea-dulemar an onisbarsursi?","poem":2},{"lineBreak":true},{"text":"Degi, ¿Kir-yargi Arameo-dulemar an onisbarsursi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Ani an Bab-Jehová-Bur-Gandik-Maidi,","poem":1},{"text":"we-yar-isgus-naidgi nakulemaid.","poem":2},{"text":"Jacob-wagan napneg-naidgi an obelogoed,","poem":1},{"text":"degi-inigwele, an bela obelogosulid.”","poem":2},"Bab-Dummad-Jehová soged."]},{"type":"verse","number":9,"content":[{"text":"“Igi ukub bugbugi egwalealile, napagi akwa-gwagwensaar argwansuli,","poem":1},{"text":"deyobi, Israel-dulemar neggwebur-baigan-abargi, an egwaoed.”","poem":2}]},{"type":"verse","number":10,"content":["Bab-Jehová sogdebalid:",{"text":"“Bela an-dulamar-isgudimalad, es-suidgi burgwemaloed.","poem":1},{"text":"Bela sogdimaladi: Bonigan anmarse gwen nonikosurye.","poem":2},{"text":"Anmar-oakalogosurye.","poem":1},{"text":"Dule-deyob-sogdimaladi, bela burgwemaloed.”","poem":2}]},{"type":"verse","number":11,"content":["Bab-Jehová sogdebalid:",{"text":"“A-ibagi, David-meged-neg-ayarisadi, an soboed.","poem":1},{"text":"Neg-yaa-ollogan-ambikusadi, an edioed,","poem":2},{"text":"degi, e-neg-bibichismalad iduar-sobaledyob,","poem":1},{"text":"gannar an sobbaloed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Adi, Israel-dulemar, degi, bela dulemar an-nug-odummodimaladi,","poem":1},{"text":"Edom-neggwebur, degi, bela neggwebur-bamalad suegar.”","poem":2}]},{"type":"verse","number":13,"content":["Bab-Jehová sogdebalid:",{"text":"“Ibmar-san-bukidar-welegoed-ibagan danikid,","poem":1},{"text":"ibmar-gwag-digleged-ibagan-naidgi, amba oros-gwaggiid-dakleged, welenai guoed.","poem":2},{"text":"Uva-digleged-ibagan-naidgi, amba uva-egurlenai guoed.","poem":1},{"text":"Yar-dummaganba vino-binid aryomamai guoed,","poem":2},{"lineBreak":true},{"text":"bela yala-senigana-imbaganba suurmakmai guoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"An-Israel-dulemar-galesmalad an gannar e-yarse sedagoed.","poem":1},{"text":"Neggweburmar-bergusad gannar na sobmarbaloed,","poem":2},{"lineBreak":true},{"text":"agi na ambikumaloed.","poem":2},{"text":"Uva-dubmar digmaloed, degi, e-vino gobdii gumaloed.","poem":1},{"text":"Ibmar-digedgi arbamaloed,","poem":2},{"lineBreak":true},{"text":"a-ibmar-sanmakoedi, gundii gumaloed.”","poem":2}]},{"type":"verse","number":15,"content":["Be-Bab-Dummad-Jehová soged:",{"text":"“Israel-dulemar e-yargi an urboed,","poem":1},{"text":"adi, mer yar-an-ega-uksadgi, bar onilegegar.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}