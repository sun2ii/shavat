{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"DEU","translationId":"cuk_nvs","name":"Deuteronomio","commonName":"Deuteronomio","title":"GANNAR-IGAR-SOGLENAID-GARDA DEUTERONOMIO","order":5,"numberOfChapters":34,"sha256":"df594c0eb59bf130f30812f2ec567d783482d2a1029a88c09a13486479062875","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/cuk_nvs/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":14,"content":[{"type":"heading","content":["Mas-sunna-gulleged, mas-ise-gulleged"]},{"type":"verse","number":1,"content":["Moisés Israel-dulemarga sogdebalid: “Bemar, be-Bab-Dummad-Jehová-mimmigan gumalad. Mer dule-burgwisad-ular, be-san-uka daas-daas imako, mer nono-swiri be ibalo."]},{"type":"verse","number":2,"content":["Ar bemar be-Bab-Dummad-Jehováʼba uklegarmaladid. Ar Bab-Jehová unnila egadgarbi-guega, we-napneggi dulamar-bukidar-bukwad-abargi bemar-sunonikid.”"]},{"type":"verse","number":3,"content":["Moisés Israel-dulemarga sogdebalid: “Melle ibmar-ised gunmalo."]},{"type":"verse","number":4,"content":[{"text":"We-ibmar-durgandi sunna be gunmaloed:","poem":1},{"text":"Moli-bebe-nikad, sibad-wawaad, sibad,","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"goe-ciervoʼye-nugad, goe-gacelaʼye-nugad,","poem":2},{"lineBreak":true},{"text":"goe-corzoʼye-nugad, sibad-ome-sapurbalid,","poem":2},{"lineBreak":true},{"text":"sibad-íbiceʼye-nugad, goe-antílopeʼye-nugad,","poem":2},{"lineBreak":true},{"text":"degine, sibad-wawaad-sapurbalid.","poem":2}]},{"type":"verse","number":6,"content":["”Degine, sunna be ibdurgan e-goonasi-darbo-marar-nikamalad, geb, gagan-masar, gannar-mabaliga-sabanyagi-mas-saboged, be gunmaloed."]},{"type":"verse","number":7,"content":["”We-ibdurgandi be gunnosulid:",{"text":"Moli-yargan-mureged, nubi, ugdun.","poem":2},{"text":"Ar wemar amba gagan-masar, gannar-mabaliga-sabanyagi-mas-saboged-inigwele,","poem":3},{"lineBreak":true},{"text":"e-gonasidi negabar mararsulid.","poem":3},"”We-ibdurgandi be gunnosulid, ise-gullegedga gumaloed:"]},{"type":"verse","number":8,"content":[{"text":"Sina, amba be gunnosurbalid,","poem":1},{"text":"ar goonasi-darbo-marar-nika-inigwele, mas-masar, gannar-mabaliga sabanyagi mas sabosulid.","poem":2},"”Degisoggu, we-ibdurgan ise gullegoed.",{"text":"Sin-e-san bemar gunnosurmalad,","poem":1},{"text":"sin-burgwaledbela gwen be ebuosurmalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bela ibdurgan-diakinmalad e-see-nikamalad, degi, uayob-uka-nikamalad, nabir be gunmaloed.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Ar ibmar-durgan-diakinmalad e-see-nikasulile, degi, uayob-e-uka-nikasulile, be gunnosurmalad, ise gullegedga gumaloed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nuu-nuegan bela sunna be gunmaloed.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Degi-inigwele, ar wemardi be gunnosurmalad:","poem":1},{"text":"Sulubagi, sulubagi-garmar-bisge-bisge-imaked, uabu,","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"mula, degi, bela sulubagi-senigan akar-akar-daklemalad,","poem":2},{"lineBreak":true},{"text":"bela e-sordamar be gunnosulid.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Degine, abgokor,","poem":2},{"lineBreak":true},{"text":"degi, abgokormar-akar-akar-daklemalad be gunnosurbalid.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Nuu-dummad-dukar-suid avestruzʼye-nugad,","poem":2},{"lineBreak":true},{"text":"irmon-senigan,","poem":2},{"lineBreak":true},{"text":"bela dilli-dilli akar-akar-daklemalad,","poem":2},{"lineBreak":true},{"text":"noo-akar-akar-daklemalad be gunnosulid.","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Irmon, dabgala-ibisʼye-nugad, badugiid-calamónʼye-nugad,","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"gorgi, mula-buitreʼye-nugad, diidod,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"dabgala-dummad, garzaʼye-nugad,","poem":2},{"lineBreak":true},{"text":"degi, garza-akar-akar-daklemalad,","poem":2},{"lineBreak":true},{"text":"salligiid-abubillaʼye-nugad, degine, uksir,","poem":2},{"lineBreak":true},{"text":"wemar be gunnosurbalid.","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Gukur-akar-akar-nabir-gukumalad, ise gullegoed.","poem":2},{"lineBreak":true},{"text":"We-ibmarmar-isemalad, melle be gunmalo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar nuumar-nuegandi nabir be gunmaloed.","poem":3}]},{"type":"verse","number":21,"content":["”Ibdurgan be burgwar-mai amisale, melle be gunmalo. We-ibmar, dule-ainebarmalad-be-abargi-mamaidga be ukoed. Amardi, sunna we-ibmar-burgwaled gunmaloed. Sulile, dule-ainebarmalad-bese-atakdanimaladga manigi ega be ukoed. Ar bemardi, be-Bab-Dummad-Jehováʼba uklegarmaladid, unnila egadga nug-imaklesmaladid. ”Sibad-e-mimmi, melle e-nan-nunisgi be duo.”"]},{"type":"heading","content":["Ibmar ambegi gwensak-uklegoed (10%)"]},{"type":"verse","number":22,"content":["Moisés Israel-dulemarga sogdebalid: “Birga-ilibali bela ibmar-gwagmar be-nainugi be wesmaladi, ambegi gwensak (10%) Bab-Dummadga be ukergebmalad."]},{"type":"verse","number":23,"content":["Be-Bab-Dummad-Jehová-asabin, e-neg-susadgi, e-nug-nasiko-sogsadgi ibmar-ambegi-gwensak-ukleged (10%) be gunnoed.",{"text":"Amar wemalad:","poem":1},{"text":"Be-ibmar-gwag-ukleged,","poem":2},{"lineBreak":true},{"text":"be-vino-binid-ukleged,","poem":2},{"lineBreak":true},{"text":"be-olivo-gwallu-binid-ukleged.","poem":2},{"lineBreak":true},{"text":"Degine, be-moli-gebegwalulesmalad,","poem":2},{"lineBreak":true},{"text":"be-sibad-wawaad-gebe-gwalulesmalad,","poem":2},{"lineBreak":true},{"text":"be-sibad-gebe-gwalulesmalad,","poem":2},{"text":"wemar, Bab-Jehová-neg-susadgi be gunnoed,","poem":3},{"lineBreak":true},{"text":"adi, bemar bane-bane be-Bab-Dummad-Jehová-dobee nanamalagar.","poem":3}]},{"type":"verse","number":24,"content":["”Ar be-Bab-Dummad-Jehová megega-neg-susad begi dikasuli siile, ase geg be ibmar-sede-itogele, degidbali, geg be ibmar ambegi-gwensak-ukleged (10%) sede-itogele,"]},{"type":"verse","number":25,"content":["be we-ibmar maniga-obinyoed. Geb be be-Bab-Dummad-Jehová-neg-susadse we-mani be sedoed."]},{"type":"verse","number":26,"content":[{"text":"Agi, geb a-manigi be ibmar-bakbiedba we-ibmar be bakoed:","poem":1},{"text":"Moli-bebe-nikad,","poem":2},{"lineBreak":true},{"text":"sibad-wawaad,","poem":2},{"lineBreak":true},{"text":"vino,","poem":2},{"lineBreak":true},{"text":"degine, gobed-bamalad-sole-solemalad.","poem":2},"”Agi be-Bab-Dummad-Jehová-asabin, be, degine, be-gwenadganse-bakale, mas gunnoed, degi, weligwar itomaloed."]},{"type":"verse","number":27,"content":["”Levita-dulemar-bemar-neggweburgi-maid, nue be akwemalo, melle be obanmalo, ar ade, bemarga nainumar-uklesadyob, wemargardi uklessulid."]},{"type":"verse","number":28,"content":["”Birgapaagwad-iliba, bela be-ibmar-wesadi, ambegi-gwensak-ukleged (10%) be suoed, be-neggweburmargi be sabogoed."]},{"type":"verse","number":29,"content":[{"text":"A-neggweburmarse we-dulemar nonimaloed:","poem":1},{"text":"Levita-dule-bemarba-nainu-nikudsulid,","poem":2},{"lineBreak":true},{"text":"dule-be-yarginsurmalad,","poem":2},{"lineBreak":true},{"text":"dule-sergan-sated,","poem":2},{"lineBreak":true},{"text":"omegan-e-sui-burgwismalad be-neggweburgi-gudidimalad.","poem":2},"”Deyob, a-dulemar mas gunmaloed, nue-immee gudii gumaloed, adi, be-Bab-Dummad-Jehová bela-be-ibmar-nued-imakmaladgi ise-nued bemargi binsamalagar.”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/DEU/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/DEU/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/DEU/13.json","previousChapterAudioLinks":{},"numberOfVerses":29}