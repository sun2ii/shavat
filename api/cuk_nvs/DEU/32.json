{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"DEU","translationId":"cuk_nvs","name":"Deuteronomio","commonName":"Deuteronomio","title":"GANNAR-IGAR-SOGLENAID-GARDA DEUTERONOMIO","order":5,"numberOfChapters":34,"sha256":"df594c0eb59bf130f30812f2ec567d783482d2a1029a88c09a13486479062875","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/cuk_nvs/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"“Nibneg-naid, nue an-sunmaked itomalo.","poem":1},{"text":"Napneg-naid, nue an-ibmar-soged itomalo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An-ibmar-odurdakoedi, dii-wiedyobi babatoed.","poem":1},{"text":"An-sunmakoedi, booyobi babatoed.","poem":2},{"text":"Gagan-gebe-aramakalidgi-dii-wiedyobi,","poem":1},{"text":"an-ibmar-odurdakoedi, guoed.","poem":2},{"text":"Gagan-dutuganagi-boomiedyobi,","poem":1},{"text":"an-sunmakoed guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"”An Bab-Jehová-nug soge-soge imakdii guoed.","poem":1},{"text":"¡Anmar-Bab-Dummad-nug be odummomar!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Dummad akwasailayob anmar-odukued,","poem":1},{"text":"bela ibmar-nueganbi imaked,","poem":2},{"lineBreak":true},{"text":"ar ade, bela e-igarmala igar-innikimaladbiid.","poem":2},{"text":"Bab-Dummad napiragwadid,","poem":1},{"text":"egi ibmar-isgana naisulid.","poem":2},{"text":"Bab-Dummad ibmar-napiragwadbi imaked,","poem":1},{"text":"ibmar-innikigwadbi imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Israel-dulemar, be dule-isganamalad,","poem":1},{"text":"Bab-Dummadgi be nue-dummad-yolesmalad,","poem":2},{"text":"bemar bar e-mimmiganga gusurmalad,","poem":1},{"text":"ar ade, bemar na dukin nug-oichosmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bemar, dulemar-gegeganad,","poem":1},{"text":"bemar, dule-binsaedsurmaladid.","poem":2},{"text":"¿Ar weyob bemar be-Bab-Jehová-abin-imakmarde?","poem":1},{"lineBreak":true},{"text":"¿Ar Bab-Jehováʼde be-Bab-Dummadsursi?","poem":1},{"lineBreak":true},{"text":"¿Ar bemar-obinnisadsursi?","poem":1},{"text":"¡Ar Bab-Dummad we-napnegse bemar-senonikidid!","poem":2},{"lineBreak":true},{"text":"¡A wegi bemar-urbisadid!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Neg-epennemalad be ebinsao,","poem":1},{"text":"birgamar-dikasurgus-nasmalad be ebinsao.","poem":2},{"text":"Neg-epenne-gusmalad be-babse be egiso,","poem":1},{"text":"be-bab bega sogoed.","poem":2},{"text":"Be-girmar-seleganse be egiso,","poem":1},{"text":"amar bega igar-onakoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad-Bur-Birigined,","poem":1},{"text":"yar-baid-baidgi, degi, neggwebur-baid-baidgi, dulemar-urbenaigua,","poem":2},{"text":"amarga sogedba e-yar-abingumalad nasiksad.","poem":1},{"text":"Israel-dulemargindina, nued binsanai gusad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar ade, Israel-dulemar, Bab-Jehováʼgadid,","poem":1},{"text":"ar ade, Jacob, Bab-Jehováʼgadga gunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Bab-Dummad, Israel-dulemar nega-dulesulidgangi-gudii daknonikid,","poem":1},{"text":"neg-isganaganba, gwen ibmarga-guedsulidgi-gudii daknonikid.","poem":2},{"text":"Bab-Dummad amar-angaagwar imaknonikid, amar-akwenonikid.","poem":1},{"text":"Bela-bela, Bab-Jehová na e-ibya-akweyobi, Israel-dulemar-akwedii gusad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ar igi sulubagi na e-mimmi-ogukuega e-uu-siidgi onodae,","poem":1},{"text":"ei-argwate-dakele, na e-sakangi-gasa gannar e-uuse-sesdae,","poem":2},{"lineBreak":true},{"text":"deyobi, Bab-Dummad, Israel-dulemar-semai gusmogad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bab-Jehová na ebi Israel-dulemar-semaigusad,","poem":1},{"text":"bab-dummad-baid eba gwen nadapi gussulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Bab-Dummad yalaganba Israel-dulemar onakwemaigusad.","poem":1},{"text":"Nainugi-ibmar-welesadgi e-dulamar-oguchagusad.","poem":2},{"text":"Achanisgi, degine, olivo-gwallugi na e-dulemar-oguchad.","poem":1},{"text":"We-ibmarmar akwa-dutusulidgi ega onosgusad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Moli-nunis-gwamakaledgi oguchagusad,","poem":1},{"text":"degine, sibad-e-nunisgi ogobsagusad.","poem":2},{"text":"Sibad-wawaad-senigana-gwallu-ibegangi,","poem":1},{"text":"degi, sibad-senigana-gwallu-ibegangi, oguchagusad.","poem":2},{"text":"Basán-yalagi sibad-wawaad-machergangi,","poem":1},{"text":"degine, sibad-machergangi oguchagusbalid.","poem":2},{"text":"Orosgi-dakleged-trigo-bur-nuegangi oguchagusad,","poem":1},{"text":"degine, uva-nis-ginnidgi ogobsagusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Deyobi, Jesurún nue wardunguded,","poem":1},{"text":"agidbali, Jesurún-dulemar Bab-Dummadgi banguded.","poem":2},{"text":"Nue-mas-gundiidbali, nue-wardungussunnad.","poem":1},{"text":"Geb degine, e-Bab-Dummad-e-obinnisadgi banguded,","poem":2},{"lineBreak":true},{"text":"E-bendakdiid ieded.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Baigan-bab-dummaganse-gotemaladgi,","poem":1},{"text":"Bab-Dummad-nobguega imakdemalad.","poem":2},{"text":"E-bab-dummagan-e-ibmar-wilubgan-sunnasurmaladgi,","poem":1},{"text":"Bab-Jehová-ouludmalad.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Niamarga ibmar-ogumakar ukdemalad,","poem":1},{"text":"amardi, bab-dummadgansurmalad.","poem":2},{"text":"Bab-dummadgan-dakdisurmaladga ibmar-ukdemalad.","poem":1},{"text":"Bab-dummagan-binidganga, emis-nomaladgala,","poem":2},{"lineBreak":true},{"text":"be-babgan we-bab-dummagan-e-nug-odummossurmaladgala,","poem":2},{"lineBreak":true},{"text":"bemar ibmar-ogumakar ukdemalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Israel-dulemar, be-Bab-Dummad-be-ogwalulesad, be iedmalad.","poem":1},{"text":"Bemar, be-Bab-Dummad-bega-san-burba-dulad-uksad, be iedmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"”Bab-Jehová, e-mimmigan e-isdar-dake daksagua, sabsur-uluded.","poem":1},{"text":"Degidbali, e-mimmigan-obachasunnad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Agine, Bab-Dummad sogdesunnad:","poem":1},{"text":"‘We-dulemargi an banguoed, gi-na-gudmarsunnodibe.","poem":2},{"text":"Ar wemar an-sogedba dasurmalad,","poem":1},{"text":"dule-isganamalad, we-masmala geg-innikii nanamaladid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Israel-dulemar, Bab-Dummadsulid e-bab-dummadga-imaksamalad.","poem":1},{"text":"Degidbali, Israel-dulemar, nobguega an-imaksad.","poem":2},{"text":"Nuchu-mimmi na e-bab-dummadga-imakdemaladgi an-oulusmalad.","poem":1},{"text":"An-dulasurmalad an sabguoed,","poem":2},{"lineBreak":true},{"text":"bemar, a-dulemargi nobgumaloed.","poem":2},{"text":"An dule-binsaed-satemaladgi nabir binsaoed,","poem":1},{"text":"bemar, a-dulemargi uludoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ar bela-belagwad sae-sae-ito an-imaksamalad,","poem":1},{"text":"an-urwedi soo-ginnitibi-siiyobid.","poem":2},{"text":"An-urwedi, nega-uluse warmaked.","poem":1},{"text":"Bela napaneggi-ibmar-sanmakmalad ese gummakoed.","poem":2},{"lineBreak":true},{"text":"Bela-bela yar-e-sailamar ese gummakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"” ’Ani an Israel-dulemargi boni-dummagan obulogoed.","poem":1},{"text":"Bela an-sigumar Israel-dulemargi an mioed.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"An Israel-dulemargi ukud-dummad barmidagoed.","poem":1},{"text":"Uelleged-dummad, degine, bonigan-dummad,","poem":2},{"lineBreak":true},{"text":"we-dulemar-obelogega an imakoed.","poem":2},{"text":"Degine, Israel-dulemargi achu-sapur-ursilimar an barmidagoed,","poem":1},{"text":"naibe-nuegan napagi-unimakdimalad egi an onioed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"E-mimmigan magaba-nodogu, es-suidgi burgwemaloed.","poem":1},{"text":"Negyabardi, bela-bela dobe-itomaloed.","poem":2},{"text":"Sapingana, bunamala,","poem":1},{"text":"goemar, degi, dadormar, bela-burgwemaloed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"An binsasanad, Israel-dulemar an dikasuli oaisakioye,","poem":1},{"text":"dulemar mer bar egi-binsaega an imakoye.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Degi-inigwele, mer deyob bar imakoye an binsasad,","poem":1},{"text":"adi, an-isdarmalad mer angi dodomalagar.","poem":2},{"text":"An-isdarmalad angi-burgued an abessulid,","poem":1},{"text":"abakalegi sokarmalale: Ar we-ibmar Bab-Jehová imaksasulid.","poem":2},{"text":"Ar anmar bela imaksad.","poem":1},{"text":"We-dulemargi anmar nakwisad.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"”Ar Israel-dulemar aku neg-itomalad,","poem":1},{"text":"ibmar-magar-itoged satemalad.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ar Israel-dulemar, wis binsaed-nikamalana,","poem":1},{"text":"wis mag-neg-itomalana,","poem":2},{"lineBreak":true},{"text":"na-bergumaloed nue magar itononimaloenad.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ar wede, ¿igi-nabir dule-wargwenad","poem":1},{"text":"sorda-miligwenad baregichasunna (1,000)?","poem":2},{"text":"Ar wede, ¿igi-nabir dule-warbogwad","poem":1},{"text":"sorda-miliambegwad oduurmaksasunna (10,000)?","poem":2},{"text":"Ar Bab-Jehová eba-gudiidba deyob nabir gued.","poem":1},{"text":"Ar Bab-Jehová eba-gudisulina,","poem":2},{"lineBreak":true},{"text":"e-isdarmaladgi-nakwega imaksasulinad.","poem":2},{"text":"Deyob e-isdarmaladgi obinosulinad.","poem":1}]},{"type":"verse","number":31,"content":[{"text":"Ar anmar-isdarmalad nue-wismalad,","poem":2},{"lineBreak":true},{"text":"e-bab-dummagan-e-gargangued anmar-Bab-Dummadyobsulid.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"E-uva-nainumala, Sodoma-neggweburyobi isgana-nanaed.","poem":1},{"text":"E-uva-nainumala, Gomorra-neggweburyobi isgana-nanaed.","poem":2},{"text":"E-uvaʼmala, ina-nusuyob-nanaed,","poem":1},{"text":"ber gagbire-nanaed.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"E-vino, naibe-e-gichiyobid,","poem":1},{"text":"naibe-e-boniganyobi dule-oburgwed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"” ‘Ar bela an-sae-itoged an sabodiid.","poem":1},{"text":"An-ibmar-nuedyob an sediid.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ar buged-mai-imakleged angadid, anse berguoed.","poem":1},{"text":"E-ibagan-mosale, anse ibitomaloed,","poem":2},{"lineBreak":true},{"text":"ar ade, na dummad-wilegoed bato warmakdanikid.","poem":2},{"text":"E-sabsur-odurdaklegoed-ibagan warmaksad.’","poem":1}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"”Ar Bab-Jehová e-dulemar-gargangued-sate-dakalir, bendaknonikoed.","poem":1},{"lineBreak":true},{"text":"Bab-Jehová maimar-bergus-dakalir,","poem":1},{"text":"degine, dule-maiga-gudisurmalad-bergus-dakalir,","poem":2},{"text":"Bab-Jehová e-dulemar-wile dakdoed.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Agi, Bab-Dummad Israel-dulemarga sogdagoed:","poem":1},{"text":"‘¿Bia be-bab-dummagan bemar-egi-bengussurmaladde nadmarsunna?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Be-bab-dummagan, ega be ibmar-ogumakar-uksad-e-gwallu-guchamalad, ¿bia nadmarsunna?","poem":1},{"text":"Be-bab-dummagan, ega be gobed-uksad-gobsamalad, ¿bia nadmarsunna?’","poem":2},{"text":"Ar emigindi, a-bab-dummagan be-bendakmalaga, gwisgumardo.","poem":1},{"text":"Ar emigindi, a-bab-dummagan be-bendakega, dagmardo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"”Ar emigindi, Israel-dulemar, be dakmardo.","poem":1},{"text":"‘Anbi unnila Bab-Dummad gued.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-baid sated.","poem":2},{"text":"Ani, an dulemar-odulogedid,","poem":1},{"text":"ani, an dulemar-oburgwedid.","poem":2},{"text":"Ani, an dulemar-naibisaedid,","poem":1},{"text":"ani, an dulemar-nudakedid.","poem":2},{"text":"Dule angi wakinnosur guoed.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"An surgan-onaksun.","poem":1},{"text":"An-dula-degisadegu-maid-nukad.","poem":2},{"text":"Ise-sogar an sogsun:","poem":1}]},{"type":"verse","number":41,"content":[{"text":"An-es-suid bela-bela-dakarmakaled","poem":2},{"text":"an bela-bela e-nugar-ebitele,","poem":1},{"text":"dulemarga-igar-nabogedgi an es-gadele,","poem":2},{"text":"an-isdarmalad-buged-mai an imakoed,","poem":1},{"text":"dulemar-isdar-an-dakmalad an sabsur-odurdakoed.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"An-sigumar ablisbi gunonikoed,","poem":1},{"text":"an-es-suid san-immi-immi imakoed.","poem":2},{"text":"Dule-naibigusmalad-e-ablis ariogoed,","poem":1},{"text":"dule-galesmalad-e-ablis milegoed,","poem":2},{"lineBreak":true},{"text":"dule-isdarmalad-e-dummagan-e-nono anse egwallegoed.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"”Dulemar-yar-baid-baidginmalad, Bab-Dummad-dulamarba be wergumar.","poem":1},{"text":"Bab-Dummad, ega-arbamalad-e-ablis-eosmalad buged-mai imakoed.","poem":2},{"text":"Ar deyob gunonikoed.","poem":1},{"text":"E-isdarmalad-buged-mai imakoed.","poem":2},{"text":"Bab-Dummad e-dulamarga isgued osulogoed,","poem":1},{"text":"degi, e-yala-e-isgued ega osulobaloed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":["Moisés dulemar-bukwadse nadegusad, Nun-machi-Josué, eba nadgusmogad. We-namaked bela dulemarga sogsagusad."]},{"type":"verse","number":45,"content":["Moisés bela Israel-dulemarga we-namaked sogsagua,"]},{"type":"verse","number":46,"content":["a-dulemarga sogded: “Emi we-ibmarmar-an-bemarga-sognaidba bela be nanamalo, degine, be-mimmiganga bela we-Igar-an-bemarga-sognaidba nanamaloye, be sogmalo."]},{"type":"verse","number":47,"content":["Ar we-igarmar-an-bega-sognaid binsa bemarga soglesulid. Ar we-Igar-Maidba be damalale, be nabir dula-gudii gumaloed. Ar we-Igarmar-Maidba be damalale, Jordán-diwar-obakar-yar-be-susokarmaladgi nabir be suiti-gudii gumaloed.”"]},{"type":"heading","content":["Bab-Dummad Moisésʼga Canaán-yar oyosad"]},{"type":"verse","number":48,"content":["Amba a-ibagine, Bab-Jehová Moisésʼga sunmakdebalid, ega sogded:"]},{"type":"verse","number":49,"content":["“Abarim-yalaganse be naknae, agi Jericó-neggwebur-asabin Moab-yargi-Nebo-yala-siid be dakoed. Agi, be Canaán-yar Israel-dulemarga-an-uksokalid be dakoed."]},{"type":"verse","number":50,"content":["Ar be yar-nakoedgi be burgwedapoed, Igi be-ia-Aarón Hor-yargi burgwismoga, degi, e-serganba megnonigusa, deyob, be-serganba be megmogoed."]},{"type":"verse","number":51,"content":["Deyob be guoed, ar bemar bebogwa Israel-dulemar-wagab be angi yolesmalad, nega-dulesulidgan-Zinʼye-nugadgi, Cadesʼgi, Meriba-dii-naba be angi yolesmalad. Agi Israel-dulemar-abargi be an-nug odummossurmalad, be aku an-daksamalad."]},{"type":"verse","number":52,"content":["Degisoggu, Israel-dulemarga-yar-an-ukesokalid be unnila dakoed. A-yarsedi be dogosulid.”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}