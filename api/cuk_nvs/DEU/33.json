{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"DEU","translationId":"cuk_nvs","name":"Deuteronomio","commonName":"Deuteronomio","title":"GANNAR-IGAR-SOGLENAID-GARDA DEUTERONOMIO","order":5,"numberOfChapters":34,"sha256":"df594c0eb59bf130f30812f2ec567d783482d2a1029a88c09a13486479062875","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/cuk_nvs/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Moisés Israel-dadgangi ise-nued binsasad"]},{"type":"verse","number":1,"content":["Bab-Dummad-e-dule-Moisés, burgwed-iduale, Israel-dulemargi ise-nued-binsanaidba weyob sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Bab-Jehová Sinaí-yalagi danikid,","poem":1},{"text":"Seir-akar anmarga gwallu-oganonikid,","poem":2},{"text":"Parán-Yalagi anmarga gwallu-mee imaknonikid.","poem":1},{"lineBreak":true},{"text":"E-dule-islidikmalad-miliambed-abalagi (10,000) nonikid,","poem":1},{"text":"Igar-narmakaled sooyobi gwabunyemai e-argan-nuedsik sedanikid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad, e-dulamar nue-sabed,","poem":1},{"text":"e-argan-yaurgi bela dulemar-egadga-gued ganikid.","poem":2},{"text":"Degisoggu, e-dulamar e-sogedba nadapi gumalad.","poem":1},{"text":"Bab-Dummad, e-dulemarga Igar ukmaiguad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anmar Jacob-wagan-guedba,","poem":1},{"text":"we-Igar, ani Moisés, an bemarga uksagusad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neggwebur-e-dummagan, Israel-dulemar-sogambe-gakabogwadmala (12) danar-ambikunonimargu,","poem":1},{"text":"Bab-Jehová, Jesurúnʼgi reyga maigusad.”","poem":2}]},{"type":"verse","number":6,"content":["Moisés, Rubén-waganga sogded:",{"text":"“Rubén-wagan, be ichegumar-inigwele, be degisadegu dula-gudii gumaloed.","poem":1},{"text":"Be-dulamar mergumai gumarsun.”","poem":2}]},{"type":"verse","number":7,"content":["Moisés, Judá-wagangi ise-nued sunmakdegu, weyob sogded:",{"text":"“Bab-Jehováʼye, Judá-wagan-bese-binnasuli-goled be itoge,","poem":1},{"text":"e-dulemarse gannar be sede.","poem":2},{"text":"Be-garganguedgi be Judá-wagan-bendakdage.”","poem":1}]},{"type":"verse","number":8,"content":["Moisés, Leví-wagangindi sogded:",{"text":"“Bab-Jehováʼye, Tumim, degine, Urim begadid,","poem":1},{"text":"Leví-wagangi-nued-binsasadga be uksad.","poem":2},{"text":"Israel-dulemardi, Masahʼye-neg-nugadgi,","poem":1},{"text":"Meriba-diigi bebo ulusgu, be-wilubdaksad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Leví-wagan, e-babgi, e-nangi, sogsagusad:","poem":1},{"text":"‘Bipisaar an-babgandeeye an binsassurye.’","poem":2},{"text":"Leví-wagan, e-gwenadgan-akudake gusad,","poem":1},{"text":"degine, e-mimmiganbela akudake gusbalid.","poem":2},{"text":"Ar Leví-wagan be-gayaburbabardi nanasmalad,","poem":1},{"text":"Be-Igar-Mesisad-sogedba gudigusmalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Leví-wagan, be-Igarmar-sogedba Jacob-wagan-odurdakoed,","poem":1},{"text":"Be-Igar-Maidgi Israel-dulemar-odurdakoed.","poem":2},{"text":"Leví-wagan, be-asabin ina-wawadikmalad obupurmakmaloed,","poem":1},{"text":"degine, ibmar-ogumakar-ukleged-ailagi bega ibmar ogumakar ukmaloed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehováʼye, Leví-wagan-ibmar-imakmaladgi ise-nued be binsae,","poem":1},{"text":"e-ibmar-imakmalad nue-weligwaledgi be abingae.","poem":2},{"text":"E-isdarmalad-e-gangued be obeloge,","poem":1},{"text":"sae-e-dakmalad, mer bar egi-gwisguega be imake.”","poem":2}]},{"type":"verse","number":12,"content":["Moisés, Benjamín-wagangindi sogded:",{"text":"“Bab-Jehová we-dule-na-nue-sabed,","poem":1},{"text":"bensulidgi e-walikaa gudii imakoed.","poem":2},{"text":"Bab-Dummad we-dule-edarbedii guoed,","poem":1},{"text":"angaagwale sedii imakoed.”","poem":2}]},{"type":"verse","number":13,"content":["Moisés, José-wagangindi sogded:",{"text":"“E-napagi Bab-Jehová ise-nued binsasun.","poem":1},{"text":"Nibneggi dii-bomied bur-nued uksun,","poem":2},{"lineBreak":true},{"text":"degine, napa-urba bur dii-nued-nika imaksun.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Birgagi, bur-ibmar-nued-sanmake gusun,","poem":1},{"text":"degine, niigi, bur-ibmar-nued-sanmake gusun.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yala-sergangi bur-ibmar-nued-sanmake gusun,","poem":1},{"text":"yala-matusurmalad-degisadeguadgi bur-ibmar-nued-sanmake gusun.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Napagi ibmar-sanmakmalad bur-nuegan nikusun,","poem":1},{"text":"degi, sapi-bipi-zarzaʼye-nugadgi-gusadid egi nued binsasun.","poem":2},{"text":"Bela we-ibmar-nuegan José-waganga uklesun.","poem":1},{"text":"We-José-wagande, na e-gwenadgan-abargi bur sulealidid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Moli-bebe-nikad-machered-gebegwaluleged-yeerdaklegedyobi,","poem":1},{"text":"we-José-wagande yeerdaklemogad.","poem":2},{"text":"José-wagande, moli-búfaloʼye-nugad-e-bebeyob nikamogad.","poem":1},{"text":"A-bebegine, bela neggweburmar-baigan ese ibitomaloed,","poem":2},{"lineBreak":true},{"text":"amba dulemar nega-dikasur-bukmaladse-bakale, ese ibitomogoed.","poem":2},{"text":"Wegiid-dulemar, Efraín-wagangi miliambeba (10,000) nodamaloed,","poem":1},{"text":"degine, Manasés-wagangi miliba (1,000) nodamarmogoed.”","poem":2}]},{"type":"verse","number":18,"content":["Moisés, Zabulón-wagangindi, degi, Isacar-wagangindi sogded:",{"text":"“Zabulón-wagan, be demarba node-sogele, be wergusunno.","poem":1},{"text":"Isacar-wagan, bedi be-neggi be besa-sogele, be wergumosunno.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bemarde dulemar-baiganse goloed, an-yarse nakwedamarye,","poem":1},{"text":"adi, agi Bab-Dummadga ibmar-innikigwad-ukleged ukmalagar.","poem":2},{"text":"Demargi-ibmar-nuegan-nikmaladgi nue-wergumaloed,","poem":1},{"text":"Ukubyaba ibmar-nuegan-sabolebukmaladgi nue-wergumarbaloed.”","poem":2}]},{"type":"verse","number":20,"content":["Moisés, Gad-wagangindi, sogded:",{"text":"“Gad-wagan-yala-ganikid-odummosad-dulegi ise-nued binsalesad.","poem":1},{"text":"Gad-wagan achumiguryobi garmakdiid,","poem":2},{"lineBreak":true},{"text":"dulemar-ibe arganmar, degine, nono ichimaked.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Gad-wagan bur yar-nued susad,","poem":1},{"text":"yar-dule-idumaladgad-gued susad.","poem":2},{"text":"E-dulemar-idumai gusad.","poem":1},{"text":"Israel-dulemarmala igar-sogmaidba imaksad,","poem":2},{"lineBreak":true},{"text":"ar igi Bab-Jehová igar-uksa, bela a-sogedba ibmar-imaksad.”","poem":2}]},{"type":"verse","number":22,"content":["Moisés, Dan-wagangindi, sogded:",{"text":"“Dan-wagan achumigur-sapingwagwadyobid,","poem":1},{"text":"Basán-yalagan-akar ichomakdanikid.”","poem":2}]},{"type":"verse","number":23,"content":["Moisés, Neftalí-wagangindi, weyob sogded:",{"text":"“Neftalí-waganga ise-nueganbi ibmar-uklesad,","poem":1},{"text":"ibiyobi, Bab-Jehová ise-nued ega ibmar imaksa.","poem":2},{"lineBreak":true},{"text":"Neftalíʼde dad-argwanedsik, degine, dad-argwaned-nuedsik yar ganikid.”","poem":2}]},{"type":"verse","number":24,"content":["Moisés, Aser-wagangindi, sogded:",{"text":"“¡Jacob-wagan-baiganba, Aser-wagangi bur ise-nued binsalesad!","poem":1},{"text":"Bela e-gwenadgan Aser-wagan sabgumarsun.","poem":2},{"lineBreak":true},{"text":"Olivo-gwallugi e-nag enuksun.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Esgoro, degine, esgoro-gordikidgi be-yawagakmar sobale guoed.","poem":1},{"text":"Be-burgwedse be-gangued be nika guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Jesurún-dulemar-e-Bab-Dummadyobid, Bab-Dummad-baid sulid.","poem":1},{"text":"A-Bab-Dummad be-bendakegala nibneg-akar gukudanikid,","poem":2},{"lineBreak":true},{"text":"mogir-imbaba bela e-ganguedba danikid.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bab-Dummad-degisadeguad, be-odukuedid.","poem":1},{"text":"E-gangued-degisadeguad, be-ganikidid.","poem":2},{"text":"Bab-Dummad be-isdarmalad be-asabin obelogoed.","poem":1},{"text":"Bab-Dummad sogdegusad: ‘¡Be-isdarmalad bela be obelomar!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Israel-dulemar dobsuli bukwagumaloed.","poem":1},{"text":"Israel-dulemar bogidikidgi ambikumaloed.","poem":2},{"text":"Ibmar-gwag-gulleged, degine, uvaʼmar, yaisuli be-nainumargi sanmakoed.","poem":1},{"text":"Nibnega, yaisuli bega dii-bomimai saoed.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"¡Israel-dulemar, begi ise-nued binsalesad!","poem":1},{"text":"¿Ar doa bemaryobi gue?","poem":2},{"lineBreak":true},{"text":"Bab-Jehová bemar-bendaksayobi dule-baid-bendaksasulid.","poem":2},{"text":"Sigu-abgamaladyob, be-irwa gwisgudiid.","poem":1},{"text":"Bab-Jehová be-es-suid-be-onakwedga gued.","poem":2},{"text":"Degisoggu, be-isdarmalad bela bese galakumaloed, bese wilemaloed.","poem":1},{"text":"Bela-bela bese bingegudii gumaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}