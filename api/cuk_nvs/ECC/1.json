{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ECC","translationId":"cuk_nvs","name":"Eclesiastés","commonName":"Eclesiastés","title":"BAB-GAYABURBAGI-SUNMAKLEGED-GARDA ECLESIASTÉS","order":21,"numberOfChapters":12,"sha256":"ac82f636dcf1cce8a6c8d3fe67f879bf09313f384e38f2304d508a2b78af1a6f","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cuk_nvs/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["Bela ibmar binsarsunna imakleged"]},{"type":"verse","number":1,"content":["Odurdaked-Saila David-machi, Jerusalén-neggweburgi-reyga-megisadi, weyob sogsagusad:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“We-napneggi-ibmar-imaklegedi, binsarsunna imakleged,","poem":1},{"text":"bela igarga gwen gusulid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule we-napneggi na gandikidba-alamakdiile,","poem":1},{"text":"¿ibu-nued egi amioe? Ibmar-nued amiosuli.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dulemar gwalulemamaid. Bamaladdi burgwemamaid.","poem":1},{"text":"Ar napnegdi amba gannar naid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dad-ibeler nakwiardaed, argwatedabalid.","poem":1},{"text":"Na-bia-nakwiardaedse gannar gwae-gwae naddabalid, gannar nakwidabaligar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Burwa-goledi, dad-nakwed-argan-nuedsik gollardaed,","poem":1},{"text":"geb sorbali, dad-nakwed-argan-sapiledsik aibiliddaed.","poem":2},{"text":"Deyobi, burwa-goledi, gwen bogigusuli,","poem":1},{"text":"gannar-gannar bipirmakdiguad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bela diwarmar demarse nomaid,","poem":1},{"text":"degi-inigwele, demardi gwen engudasulid.","poem":2},{"text":"Diwarmar na bia gwalulemai, ase gannar aibirsibalid,","poem":1},{"text":"adi, agi gannar nodagegar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bela we-ibmargi-sunmaklegedi, budar-itoleged uked,","poem":1},{"text":"gwen egi bar sunmaklebidasulid.","poem":2},{"text":"Ibya, ibmar-dakedi gwen geggusulid,","poem":1},{"text":"uaya, ibmar-itogedi gwen geggusulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bato ibmar-gusadi, gannar gunonibaloed.","poem":1},{"text":"Bato ibmar-imaklesadi, gannar imaklenonibaloed.","poem":2},{"lineBreak":true},{"text":"We-napneggine, ibmar-gwapid sated.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dule-gwensak, sokardibe:","poem":1},{"text":"“Be dakena, wedi ibmar-gwapidid.”","poem":2},{"text":"Ar we-ibmardi, bato gusgu gudiguad,","poem":1},{"text":"anmar-idu-gudigusmalad-abargi bato gudiguad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ibmar-epenne-gusmaladi, bela ielesad.","poem":1},{"text":"Dule-yoedse-gwalulemaloedi, bela ibmar-yoedse-guoedi, iemarmogoed.","poem":2}]},{"type":"heading","content":["Dule-Sunmakedi, e-san-gusadgi sunmaked"]},{"type":"verse","number":12,"content":["Ani, an emar-odurdakedid, an Israel-yargi, Jerusalén-neggweburgi reyga mai gusad."]},{"type":"verse","number":13,"content":["An nue-binsaed-nikadba bela we-napneggi-ibmar-imakleged-e-burba-baraminai, degi, egi nergunai an gusad. Bab-Dummad dulemarga we-arbaed-dummad uksad, adi, egi arbadii gumalagar."]},{"type":"verse","number":14,"content":["Bela we-napneggi ibmar-imaklegedi, an daksad. Bela a-ibmarmar binsarsunna imakleged, gwage-nunmaked ukbalid."]},{"type":"verse","number":15,"content":[{"text":"Ibmar-doperegwadi, geg bar gannar innikii gued.","poem":1},{"text":"Ibmar-satedi, geg ebisleged.","poem":2}]},{"type":"verse","number":16,"content":["An binsadii gualid: “Emide, an wegi dule-nug-nikadga gunonikid. Jerusalén-neggweburgi an-idu-dummagan-megismaladba an bur nue-binsaed-nikaa gued. Anyobi, dule-baid bela-bela nue-binsaed-nikaa, bela ibmar-wisi megdisulid."]},{"type":"verse","number":17,"content":["”An ulubgi bela-bela wisgubigualid, nue-binsaed-nikaguedi, wede ibi obarleye. Deginbali, an magar-itobiguarbalid, binsaedsuli-ibmar-imaklegedi, wede ibi obarlebarye, degi, yogasaar-sunmaklegedi, ibi obarlebarye. ”Geb an wisgunonikid, amba we-ibmarse-bakale, gwage-nunmaked ukbalid."]},{"type":"verse","number":18,"content":[{"text":"Napiragwa, ar bela-bela nue-binsaed-nikaguedi, bur bule bonigan ukbalid.","poem":1},{"text":"Ar dule bur bule ibmar-wisguedi, bur bule naibid itobalid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}