{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ECC","translationId":"cuk_nvs","name":"Eclesiastés","commonName":"Eclesiastés","title":"BAB-GAYABURBAGI-SUNMAKLEGED-GARDA ECLESIASTÉS","order":21,"numberOfChapters":12,"sha256":"ac82f636dcf1cce8a6c8d3fe67f879bf09313f384e38f2304d508a2b78af1a6f","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cuk_nvs/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"heading","content":["Binsaed-nikagued sunmaknaid"]},{"type":"verse","number":1,"content":[{"text":"Gukur-burgwaled neg-nunu-yapanne imaked,","poem":1},{"text":"degidbali, ina-wawa-sobed-ibe ina-wawadikid oichoged.","poem":2},{"text":"Deyobi, gaya-isgana-sunmakleged, bela dule-binsaed-ibed-e-sunmaked oichoged,","poem":1},{"text":"e-nug-nued oichobalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dule-binsaed-ibed-e-gwage ibmar-nued-imakedgi binsaed.","poem":1},{"text":"Dule-binsaedsulidaed-e-gwagedina, ibmar-isgana-imakedgi binsaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dule-binsaedsulidaed, ar ibu imakalile, e-ibmar-imakedgi magasar na oyoged,","poem":1},{"text":"ede, dule-binsaedsulidye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dule-sapin-dummad-negsemaid bese ulualile, mer be abin-imakdebin sao.","poem":1},{"text":"Ar san-bargaagwar-imaklegedi, bukidar ibmar-noar-imakleged bargaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":["We-napneggi-gudiidgine, an daksabalid, sapin-dummagan-negsemamaidi, weyob ibmar noar-imakdimalad:"]},{"type":"verse","number":6,"content":["Dule-binsaedsulidaedgala, aka arbaed-nuegan ukleged. Ar dule-bur-nabir-binsamaladgardina, arbaed-baisulid ega ukleged."]},{"type":"verse","number":7,"content":["An daksabalid, dule-maiga-gudimaladi, moli-birgi-sii gudidamalad. Ar dule-nuga-nikamaladdina, maiga-gudiiyob nagab galitodidamalad."]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dule yaa-matusur-akwisdibe, sunna egi argwaned.","poem":1},{"text":"Dule gagan-matusulid-eminaidibe, sunna dubgi warmaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dule, akwa mamarye-sogdibe, sunna akwagi nailikgued.","poem":1},{"text":"Dule sapan mamarye-sogdibe, sunna e-dargagi makleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ar akan e-nugar-berguddibe, e-nugar ebillesurbardibe, ibmar-sikegala, sabsur achiklegergebed.","poem":1},{"text":"Binsaed-nikaguedgi ibmar-imaklegedi, nuekwagwadgi-ibmar-imaklegedi, ibmar-nued amileged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ar naibe gar-ogoledba-ododoleged-iduar, dule-ega-gar-ogoledgi warmaksadibe,","poem":1},{"text":"dule gwen egi bar mani amiosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dule-binsaed-ibed-e-sunmaked yeer itoledaed,","poem":1},{"text":"dule-binsaedsulidaed-e-sunmakeddina, na dukin egi aibined.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dule-binsaedsulidaed gebe sunmakdele, e-gaya-miedi, gwen nabir sunmaksulid.","poem":1},{"text":"Deyob gaya-nuedsuli e-sunmaked obeloddaed.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Degite, sunmaknaigusale, gayaburbamar suli-suli amisulid.","poem":2},{"lineBreak":true},{"text":"Dule neg-guoed gwen wissulid.","poem":1},{"text":"Yoedse ibmar-danibaloed gwen-wissurbalid.","poem":2},{"lineBreak":true},{"text":"Ar dule, we-ibmar, gwen wisguosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dule-binsaedsulidaed, arbaedgi baisursunna yegued.","poem":1},{"text":"Neggweburse-naed-igarbela wissurbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Rey amba nuchukwagwar, neggwebur, wilesdakledaed.","poem":1},{"text":"Degine, e-sapingan-dummaganmoga, unnila wakdaradba iba-onogedgi arbadidamalad,","poem":2},{"lineBreak":true},{"text":"deyob osedoddamalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Neggwebur-e-rey dule-nuga-nikaddibe, we-neggweburgi ise-nued binsalesad.","poem":1},{"text":"Degine, e-sapin-dummagandina, e-wachiba na mas-gunmalad,","poem":2},{"text":"deyob na niga-ogannomalad.","poem":1},{"text":"Mumguega ambikusurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Wiedba neg-uas-nudaklesulile, neg-uas ayariddaed,","poem":1},{"text":"degine, wiedgi-neg-soblesadbali, neg maluddaed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wergulegegala, masgulleged-iba onoleged, yeer-itolegegala, vino goblebalid.","poem":1},{"text":"We-ibmar-imakegala, mani abeleged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Reygi mer be ichakwa sunmako,","poem":1},{"text":"mer egi be ichakwa binsabalo.","poem":2},{"text":"Deginbali, dule-mani-ibedgine, mer egi be arbakee isdar sunmakbalo.","poem":1},{"text":"Ar sikwimar-gudidiid sunna be-barsoged,","poem":2},{"text":"ar sikwimarde sakan-nika nanaed,","poem":1},{"text":"degisoggu, baisursunna gayamar berbeged.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}