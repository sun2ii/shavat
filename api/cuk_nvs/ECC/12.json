{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ECC","translationId":"cuk_nvs","name":"Eclesiastés","commonName":"Eclesiastés","title":"BAB-GAYABURBAGI-SUNMAKLEGED-GARDA ECLESIASTÉS","order":21,"numberOfChapters":12,"sha256":"ac82f636dcf1cce8a6c8d3fe67f879bf09313f384e38f2304d508a2b78af1a6f","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/cuk_nvs/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"heading","content":["Sered-ugakgusadgi egi-ibmar-guoed"]},{"type":"verse","number":1,"content":[{"text":"Sapingwa-gudiidgi Bab-Dummad-be-obinnisad be ebinsao.","poem":1},{"text":"Ibagan-bulegan-danikoed-idu, Bab-Dummad be ebinsao.","poem":2},{"text":"Ar birgamar-bulegan-nonikile, be sognonikoed:","poem":1},{"text":"“An-seredgussoggu, ibmar-nuegangi bar an wergudisurye.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dad-ibeler-gaed bar be itogosulid-iduale,","poem":1},{"text":"Bab-Dummad-be-obinnisad be ebinsao.","poem":2},{"text":"Nii-gaed bar be daksuliguoed-iduale,","poem":1},{"text":"Bab-Dummad-be-obinnisad be ebinsao.","poem":2},{"text":"Niisgwamar-gaed bar be daksuliguoed-iduale,","poem":1},{"text":"Bab-Dummad-be-obinnisad be ebinsao.","poem":2},{"text":"Bega dii-dummad-wisad-sorba, gannar mogirmar-nagunonikoedyob-guoed-iduale,","poem":1},{"text":"Bab-Dummad-be-obinnisad be ebinsao.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ibagwengine, be-argan, neggi-nakulemaladyob-gued wawanmakdoed,","poem":1},{"text":"be-mali, bila-onomalad-dulemaryob-gued nollomakdoed.","poem":2},{"text":"Be-nugarmar ibmar-gwag-naged-akwamaryob-gued,","poem":1},{"text":"ichegusadbali, bar ibmar bayogosulid.","poem":2},{"text":"Be-ibya, yawagak-seniganaba-atakmaladyob-gued,","poem":1},{"text":"bar atakosulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Be-uaya, yawagak-neg-imbamaryob-gued, atudoed.","poem":1},{"text":"Bega ibmar-gwag-naged-akwamar-goled, boggumai gudoed.","poem":2},{"text":"Bega sikwimar-namaked bergudoed,","poem":1},{"text":"bela namakmalad bar be itogosulid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neg-matusulidgi-nanalegedgi be dobe itononikoed,","poem":1},{"text":"igarba-bonisar-nanalegedgi dobe be itononibaloed.","poem":2},{"text":"Be-sailagia, ibmar-durba-sibudiksiiyob osibumakdoed.","poem":1},{"text":"Ses-nanaeyob arbaed-dummad be nanadii guoed.","poem":2},{"text":"Ibmar-gullegedi, bar bega nued-gulle gunonikosulid.","poem":1},{"text":"Ar ade, dule degisadegu-yoggued-negse nadapid,","poem":2},{"text":"bar gannar dagegarsulid.","poem":1},{"text":"Bega-dule-bomaladdi, galimba-ebiris obiryamakdoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mani-dub-itired-idu, or-nog-mared-idu,","poem":1},{"text":"Bab-Dummad-be-obinnisad be ebinsao.","poem":2},{"text":"Dii-weenaidgi mete-mared-idu, dii-weed-bipirmaknaid-bibisged-idu,","poem":1},{"text":"Bab-Dummad-be-obinnisad be ebinsao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar napagi be danisoggu, napaga be gannar binnidoed.","poem":1},{"text":"Be-burbadi gannar Bab-Dummadse naoed.","poem":2},{"lineBreak":true},{"text":"Ar Bab-Dummad bega burba-uksadid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Odurdaked-saila weyob soged:","poem":1},{"text":"“We-napneggi-ibmar-imaklegedi, binsarsunna imakleged,","poem":2},{"lineBreak":true},{"text":"bela igarga gwen gusulid.”","poem":2}]},{"type":"verse","number":9,"content":["Odurdaked-saila, binsaed-ibedbar-inigwele, dulemar-odurdakdii gusbalid. Bela nue-ibmar-balaminai gualid, sogedba balaminai gusad. Deginbali, binsaed-nuegan-narmaksad bukidar ilemaknai gusbalid."]},{"type":"verse","number":10,"content":["Odurdaked-saila gayaburba-nuegan ise-amiar imaksagusad. Degine, gayaburba-nuegan innikigwadba narmaksa gusad."]},{"type":"verse","number":11,"content":["Dule-binsaed-ibegan-e-sunmakedi, gammi ur-semaidaebayobi, emar-nied. E-binsaed-nuegan-onmaksadi, buarmar-neg-ganikidyob gued. We-binsaed-nuegan, Bab-Dummadgi danikid."]},{"type":"verse","number":12,"content":["Machi, egi be binsabaliga napi an bega sogbargwelo: Gardamar-bukidar-narmakleged berguosulid, degine, gardamar-doggus-durdaklegedi, dulega geg-gued uked."]},{"type":"verse","number":13,"content":["We-ibmar-sunmaklesad, wese bergunonisunnad: Unnila be Bab-Dummad-dobekwaa-gudii nanao, e-Igarmar-Mamaidba be ibsao. Ar dulega, we-ibmarbi unnila ibnuedga gued."]},{"type":"verse","number":14,"content":["Ar ibmar-nued-imaklesadi, ibmar-isgana-imaklesadi, Bab-Dummad bela wilubdaknonikoed. Amba ibmar dukuar-imaklesdibe, bela wilubdakbaloed."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}