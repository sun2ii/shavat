{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EXO","translationId":"cuk_nvs","name":"Éxodo","commonName":"Éxodo","title":"AINILESAD-GARDA ÉXODO","order":2,"numberOfChapters":40,"sha256":"a0a98dae2973e5c61d5e20a070f2da8b7d02836d116a5fd9ad11b5dea38345b4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/cuk_nvs/EXO/40.json","totalNumberOfVerses":1212},"chapter":{"number":15,"content":[{"type":"heading","content":["Moisés-namaksad"]},{"type":"verse","number":1,"content":["Geb degidgine, Moisés, degi, Israel-dulemar we-namaked, Bab-Jehová-nug-ogannogega namakdemalad:",{"text":"“Bab-Jehová-nug-odummogega an namakoed,","poem":1},{"text":"ar ibibayobi Bab-Jehová-emargi-nakwisad geger-daklege,","poem":2},{"lineBreak":true},{"text":"deunni, molimar, degi, e-birgi-sigmalad, demargi ogundisgu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An-namaked, Bab-Jehováʼga an namaked.","poem":1},{"text":"Ar Bab-Jehová an-ogannogedid, an-abonogedid.","poem":2},{"text":"Bab-Jehová an-Bab-Dummadid, an a-e-nug odummogoed.","poem":1},{"text":"We-Bab-Jehová an-bab-e-Bab-Dummadid, an a-e-nug ogannoged.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehová, dule-bila-onoged-sunsogedid.","poem":1},{"text":"¡Bab-Jehováʼye e-nug nugad!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehová Faraón-e-urmar-napaginmalad, degi, Faraón-sorda-bila-onomalad demargi odosad.","poem":1},{"text":"Faraónʼga-sorda-semalad-e-dummagan-bur-nuegan, Demar-Ginnidye-nugadgi gundilesad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Akwayobi wilasailase argwachamalad,","poem":1},{"text":"degi, muu-wilasailad egi mulus nagusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”Bab-Jehová, be-gargangued dutusulid,","poem":1},{"text":"be-gargangued gandikidba maid.","poem":2},{"lineBreak":true},{"text":"Bab-Jehová, be-garganguedba be be-isdarmalad ogilosad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Be-gangued-dutusulidgi dulemar-begi-gwisgusmalad be ogilosad.","poem":1},{"text":"Be-uluded be barmisgu, be-isdarmalad gaganyob gummakded.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Be-bunnogedgi be dii danar oambikunonikid.","poem":1},{"text":"Demar-billigan gasdibir-matusulidyob megisad,","poem":2},{"lineBreak":true},{"text":"muu-wilasailad bogidik nagusad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Anmar-isdarmalad binsasmalad:","poem":1},{"text":"‘An bargaedse bareginnoye.","poem":2},{"text":"An e-ibmar-suoedi, an mimioye,","poem":1},{"text":"an egi yeer-itogedse, an mimioye.","poem":2},{"text":"An es-suid, an egi onogoye,","poem":1},{"text":"an-sunnagwad an wemar ogilogoye.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Jehová, ar be burwa-ogochadba, be demarse-dolegega imaksad.","poem":1},{"text":"Gingwayobi dii-gandikidba-nukamakmaidgi dogdemalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bab-Jehová, ¡bab-dummad-baid bebo wilubdaked sated!","poem":1},{"text":"¡Beyob-isligwaled, baid sated!","poem":2},{"lineBreak":true},{"text":"¡Beyob-dummadid, satebalid!","poem":2},{"text":"¡Be ibmar-gegerdakleged-imakedi, dobe-ito anmar-imaked!","poem":1},{"text":"¡Ar nabirid, be-nug odummolegergebed!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¡Be-gangued be oyodgu,","poem":1},{"text":"napa we-dulemar-dosad!","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”We-dulemar be abonosadi, be-sabedbali na be semaid.","poem":1},{"text":"Be-ganguedbali, we-dulemar be-neg-swilidikidse na be sedoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dulemar-yar-baid-baidgi-bukmalad wisguarmalale, wawanmakdemaloed.","poem":1},{"text":"Filistea-dulemar sulibinsa itodmaloed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Edom-e-dummagan bela-bela dobgudmaloed.","poem":1},{"text":"Moab-e-dummagan dobedbali, wawanmakdemaloed.","poem":2},{"lineBreak":true},{"text":"Bela Canaán-dulemar dobedba duurmakdemaloed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Jehová, be-surgan-ganguedba we-dulemar bela-belad-gwakidmalodo.","poem":1},{"text":"Bela we-dulemar dobgudmalodo.","poem":2},{"text":"Bab-Jehová, be-gangued-abin we-dulemar akwayob geg sunmak sigmaloed.","poem":1},{"text":"Bela be-dulemar-na-begadga-imaksad bela-obaksadse, we-dulemar bogidik ambikumaloed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Jehová, be-megega na be yar-susadse, be-dulamar be sedoed.","poem":1},{"text":"A-yargi, degisadegu-megega be anmar-imakoed.","poem":2},{"text":"A-yar na be sisadid.","poem":1},{"text":"Agi be megega, be-neg be sisad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"¡Bab-Jehová degisadegu negsemai guoed!”","poem":1}]},{"type":"heading","content":["María-namaksad"]},{"type":"verse","number":19,"content":["Faraón-urmar-napaginmalad, degi, moli-birgi-sii-urwemalad, Israel-dulemar-bargaega demargi-dogdemargu, Bab-Jehová amargi demar-arwega imaksad. Israel-dulemardi demargi napa-dinnagwadgi nadapi obaksamalad."]},{"type":"verse","number":20,"content":["Bab-Dummad-gayaburba-barsoged-bundor-María, Aarón-e-bunad. We-Maríaʼde, gar-panderetaʼye-nugad susad, geb namakded. Bela omegan-baigan gar-pandereta ogornadap gusmarmogad, eba dodonadap gusmarmogad."]},{"type":"verse","number":21,"content":["María ega weyob namaknadapid:",{"text":"“Bab-Jehová-nug-odummogega namakmar.","poem":1},{"text":"Molimar, degi, e-birgi-sigmalad demargi ogundisa.","poem":2},{"lineBreak":true},{"text":"Ibibayobi, Bab-Jehová Egipto-dulemargi-nakwisad geger-daklege.”","poem":2}]},{"type":"heading","content":["Dii-gagbiregedse warmakdapmalad"]},{"type":"verse","number":22,"content":["Moisés, Israel-dulemar Demar-Ginnidye-nugadgi-bukwad sesa gusad. Nega-dulesulidgan-Shurʼye-nugadse sesad. Agine, ibapaa nanasmalad, gwen dii amissurgusmalad, ar dii sated."]},{"type":"verse","number":23,"content":["Maraʼye-neg-nugadse modapmargu, agi-dii-nikadi, geg gobe gusmalad, ar ade, dii gagbisailad. A-ulale, a-neg Maraʼye onugsasmalad. Maraʼde sogleged, “gagbisailadye.”"]},{"type":"verse","number":24,"content":["Dulemar Moisésʼgi ichakwa sunmakarmalad, sognanai guarmalad: “¿Ar wede ibi anmar goboe?”"]},{"type":"verse","number":25,"content":["Geb degine, Moisés Bab-Jehováʼse bendakleged egichided. Agi, Bab-Jehová Moisésʼga sapi-bipi oyosad. A-sapi-bipi Moisés diise meted. Agine, dii sayee naded. Agine, Bab-Jehová Israel-dulemar-wilubdaksad. Deginbali, agi igi-na-nanamaloed-igar ega uksabalid."]},{"type":"verse","number":26,"content":["Bab-Jehová Israel-dulemarga weyob sogded: “Ani an bemar-Bab-Dummad-Jehová gued. Ar bemar, an bemarga-ibmar-soged be nue itomalale, an-ibmar-abegedba be imakele, degi, an igar-bemarga-uksad be imakmalale, degine, an-igar-mamaidba be damalale, Egipto-dulemargi bonigan-dummagan-an-barmialidi, bemargi a-bonigan an barmidagosulid. Ar ade, ani an Bab-Jehová gued. Ar ani an bemar-nudakedid.”"]},{"type":"verse","number":27,"content":["Geb a-sorbali, Elimʼye-neg-nugadse modapmalad. Agi ambe-gakabo (12) dian ariomaid, degine, sapi-ogobgi-dakleged dulapaa-gakambe (70) bukwabalid. Agine, Israel-dulemar dii-naba ambikudapmalad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}