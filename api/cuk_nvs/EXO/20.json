{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EXO","translationId":"cuk_nvs","name":"Éxodo","commonName":"Éxodo","title":"AINILESAD-GARDA ÉXODO","order":2,"numberOfChapters":40,"sha256":"a0a98dae2973e5c61d5e20a070f2da8b7d02836d116a5fd9ad11b5dea38345b4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/cuk_nvs/EXO/40.json","totalNumberOfVerses":1212},"chapter":{"number":20,"content":[{"type":"heading","content":["Bab-Dummad E-Igar-Sogambegwad (10) uksad"]},{"type":"verse","number":1,"content":["Bab-Dummad sunmakded, weyob sogded:"]},{"type":"verse","number":2,"content":["“Ani an be-Bab-Dummad-Jehová gued. Bemar Egipto-yargi maiga-wilebukmargu, ani an bemar-onosadid."]},{"type":"verse","number":3,"content":[{"text":"Melle bab-dummad-baid an-asabin be nikumalo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Melle be ibmar-wilubgan sobmalo,","poem":1},{"text":"nibneggi ibmar-nikad-wilubgandibe,","poem":2},{"lineBreak":true},{"text":"napneggi ibmar-nikad-wilubgandibe,","poem":2},{"lineBreak":true},{"text":"demargi ibmar-nikad-wilubgandibe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A-ibmar-wilubgan-asabin dulluu be imakosurmalad,","poem":1},{"text":"degine, Bab-Dummadyob ese be golosurmalad.","poem":2},{"text":"Ar ade, ani an be-Bab-Dummad-Jehová gued.","poem":1},{"text":"An be-Bab-Dummad gadi-nobguedid.","poem":2},{"text":"Ar an dule-isganamar-isdarsunna-dakmalad sabsur-odurdakedid.","poem":1},{"text":"Degi, e-mimmigan, e-wagan,","poem":2},{"lineBreak":true},{"text":"e-wagan-yokorbarmaladsega","poem":2},{"lineBreak":true},{"text":"an sabsur-odurdakbalidid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar dulemar-an-sabmaladdi,","poem":1},{"text":"dulemar-an-Igarmar-Mamaidba-nanamaladdi,","poem":2},{"lineBreak":true},{"text":"an bela-e-waganmar-danimaloed e-ibe nue-sabguedid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Melle be-Bab-Dummad-Jehová-nug yogasaar be obaro.","poem":1},{"text":"Ar dule yogasaar Bab-Dummad-nug obarisale,","poem":2},{"lineBreak":true},{"text":"a-dule, Bab-Dummad-Jehováʼse sabsur-odurdaklegedsegad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Obunnoged-ibagi be obunnogo,","poem":1},{"text":"adi, a-ibagi, be Bab-Dummad-e-nug odummogegar.","poem":2},{"text":"Igi be-Bab-Dummad-Jehová bega Igar-uksa,","poem":1},{"text":"aba be imako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ibanergwa (6) be arbaoed.","poem":1},{"text":"A-ibagangi bela ibmar-imakbied be imakoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ibagugledgindi (7), obunnoleged-ibad,","poem":1},{"text":"be-Bab-Dummad-Jehová-e-nug-odummolegedid.","poem":2},{"text":"A-ibagi bipisaale be arbaosulid.","poem":1},{"text":"Be-machi, be-bunagwa,","poem":2},{"lineBreak":true},{"text":"bega-arbaed-machered, bega-arbaed-ome,","poem":2},{"lineBreak":true},{"text":"be-moli-bebe-nikad-alugwasualed, be-moli-uayasuid,","poem":2},{"lineBreak":true},{"text":"be-ibdurgan, a-ibagi, arbaosurmarmogad.","poem":2},{"lineBreak":true},{"text":"Deginbali, dule-be-yarginedsulid be-negyagi-gudiid,","poem":2},{"lineBreak":true},{"text":"a-ibagi, arbaosurmarmogad.","poem":2},{"text":"Ar obunnoged-ibagi igi be obunnomoga,","poem":1},{"text":"beyobi bega-arbaed-machered,","poem":2},{"lineBreak":true},{"text":"degine, bega-arbaed-ome, obunnomarmogoed.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ar ade, Bab-Jehová ibanergwa (6) arbasad.","poem":2},{"text":"A-ibagangi we-ibmarmar obinnisad:","poem":1},{"text":"Nibneg obinnisad, napneg obinnisad, demar obinnisad,","poem":2},{"lineBreak":true},{"text":"degi, bela agi ibmarmar-bukwadi obinnisbalid.","poem":2},{"text":"Geb degi, ibagugledgindi (7), Bab-Jehová obunnosad.","poem":1},{"text":"A-ulale, Bab-Jehová, ibagugledgi (7) ise-nued-binsasad.","poem":2},{"lineBreak":true},{"text":"A-ibagi sogsad, we-iba, iba-islidikidye.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be-daedbali, be-bab-nug-odummodii, degi, be-nan-nug-odummodii be nanamalo.","poem":1},{"text":"Adi, be-Bab-Dummad-Jehová we-napneg-bega-uknaidgi sereddii be megegar,","poem":2},{"lineBreak":true},{"text":"degi, bela bega ibmar-nueganbi gubaligar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Melle be dule-oburgo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Melle be be-abirginsulid-ebo galagwensuli nanao.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Melle be ibmar-atursao.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Melle be gakansaar aimargi sunmako.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Melle be dule-baid-ibmarbina be sogo:","poem":1},{"text":"Dule-baid-negbina, dule-baid-omebina,","poem":2},{"lineBreak":true},{"text":"dule-baid-mai-macheredbina, dule-baid-mai-omebina,","poem":2},{"lineBreak":true},{"text":"dule-baid-moli-bebe-nikad-alugwasualedbina,","poem":2},{"lineBreak":true},{"text":"dule-baid-moli-uayasuidbina.","poem":2},{"text":"Bipisaale dule-baid-ibmarbina be sogosulid.”","poem":3}]},{"type":"heading","content":["Israel-dulemar Bab-Dummad-dobee-itosmalad"]},{"type":"verse","number":18,"content":["Bela Israel-dulemala e-sunnagwad mar-gollomakmaid itosmargua, degine, gar-trompeta-binnasur-goled itosmarbargua, deginbali, mar-dakarmakmaid daksamarbargua, degi, yar waa-moodo-siid daksamarbargua, Israel-dulemar nue-dobee itodmalad, wawanmakdemalad. Degisoggu, yargi bannabaa ambikusmalad."]},{"type":"verse","number":19,"content":["Agi, Moisésʼga sogdemalad: —Be anmarga sunmake, anmar be-itogoed. Bab-Dummaddi melle anmarga sunmako, abakale, anmar burgwialile."]},{"type":"verse","number":20,"content":["Moisés Israel-dulemar-abin sogded: —Melle be dobgumar. Bab-Dummad bemar-wilubdakega bemarse nonikid, adi, bemar, degisadegu Bab-Dummad-dobee nanamalagar, adi, melle be isgumalagar."]},{"type":"verse","number":21,"content":["Israel-dulemardi, Moisés mogir-guduregedgi-Bab-Dummad-maidse-nadedi bannabaa dakbuk gusad."]},{"type":"heading","content":["Bab-Dummadga-ibmar-ogumakar-ukleged-aila-igar"]},{"type":"verse","number":22,"content":["Bab-Jehová Moisésʼga sogded: “Israel-dulemarga weyob be soge: ‘Nibneg-akale an bemarbo sunmaksad bato be daksamalad."]},{"type":"verse","number":23,"content":["Melle bemar orgi-ibmar-sobaled, manigi-ibmar-sobaleddibe, be-bab-dummadga anyob be imakmalo."]},{"type":"verse","number":24,"content":["” ’Bab-Dummadga-ibmar-ogumakar-ukleged-aila-sobega, anga be napa sobmaloed. A-ailagi be we-ibmarmar ukmaloed:",{"text":"Be-sibad-wawaadmar, sibadmar, degi, be-moli-bebe-nikamalad,","poem":2},{"text":"anga be ogumakar ukmaloed.","poem":3},{"text":"A-ailagi be anga ibmarmar-ukmaloedi, dulemar-e-isgued-eliedga uklegoed.","poem":1},{"lineBreak":true},{"text":"Deginbali, a-ailagi be anga ibmarmar-ukmaloedi,","poem":1},{"text":"bemar-anbogwa gwenatigwar-gudii gumalaga,","poem":2},{"lineBreak":true},{"text":"degi, bemar na gwenatigwar-gudii gumalaga uklebaloed.","poem":2},"” ’Bia an-nug ebinsalebi an abegoe, ase an nonikoed, agi ise-nued an begi binsanonikoed."]},{"type":"verse","number":25,"content":["Ar bemar anga ibmar-ogumakar-ukleged-aila-akwa be sobbiele, unnila be akwamar-sobarsulid urbe-urbe be imakmalo, ar ade, bemar, akwa esgorogi sobdele, wede bar ibmar-ogumakar-ukleged-aila-nuedga guosulid."]},{"type":"verse","number":26,"content":["Degine, anga ibmar-ogumakar-ukleged-aila melle arsan-nika imako. Ar bemar agi nakwialile, be-abgan daklego-itole.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EXO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EXO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EXO/19.json","previousChapterAudioLinks":{},"numberOfVerses":26}