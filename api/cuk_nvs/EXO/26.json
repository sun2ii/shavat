{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EXO","translationId":"cuk_nvs","name":"Éxodo","commonName":"Éxodo","title":"AINILESAD-GARDA ÉXODO","order":2,"numberOfChapters":40,"sha256":"a0a98dae2973e5c61d5e20a070f2da8b7d02836d116a5fd9ad11b5dea38345b4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/cuk_nvs/EXO/40.json","totalNumberOfVerses":1212},"chapter":{"number":26,"content":[{"type":"heading","content":["Bab-Dummadse-goled-neg-sunna-seleged-soblegoed"]},{"type":"verse","number":1,"content":["Bab-Jehová Moisésʼga sogdebalid:",{"text":"“Anse-goled-neg-sunna-seleged be soboed.","poem":1},{"text":"Be sobega, lino-mor-nued goambe (10) be ebugoed.","poem":2},{"lineBreak":true},{"text":"Deginbali, be nirbadub-arad,","poem":2},{"lineBreak":true},{"text":"nirbadub-suir-akwagiid,","poem":2},{"lineBreak":true},{"text":"degi, nirbadub-ginnid be ebubaloed.","poem":2},{"text":"Agine, baliwitur-dummagan-querubinʼye-nugad,","poem":1},{"text":"bela nue-yeerdakle-imakar, a-morgi be sobbaloed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bela mormar-e-suguedi, daligugledbi (7) be imakoed.","poem":1},{"text":"E-matardungueddi, daligwenadbi be imakoed.","poem":2},{"text":"Mormala bela emarbi-dungu be imakoed.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Mor-dummagan-goatale be gwadi-gwadi imakoed.","poem":1},{"text":"Baid-mormar-goataledi amba gwadi-gwadi be imakbaloed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Degine, mor-goataled-gwadialed-e-dikargi e-uayamar dub-aradgi ega be nasikoed.","poem":1},{"text":"Amba deyob mormar-baigan-goataled","poem":2},{"lineBreak":true},{"text":"gwadiarmalad-e-dikargi be imakbaloed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mormar-goataled-gwadiarmaladgi","poem":1},{"text":"e-uayamar gwadulabo-gakambe (50) be nasikoed.","poem":2},{"text":"Degine, baigan-goataled-gwadiarmaladgi","poem":1},{"text":"amba gwadulabo-gakambe (50) be nasikbaloed.","poem":2},{"text":"E-uayamar abin-abin be nasikoed.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Mor-nasiked orbi dulabo-gakambe (50) be imakbaloed,","poem":1},{"text":"adi, mormar-goataledi, baigan-mormar-goataledbo be oatogegar,","poem":2},{"text":"adi, anse-goled-neg-sunna-seleged-e-mor unnila gogwenayob guegar.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Sibad-absar mor-dummaganga be imakbaloed,","poem":1},{"text":"adi, anse-goled-neg-sunna-seleged-birgi anwegar.","poem":2},{"text":"A-mormar-dummagan goambe-gakagwensak (11) be imakoed.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Mormar-e-sugued, daligugle-gaka-abala sugue (7½) be imakoed,","poem":2},{"lineBreak":true},{"text":"e-matardungueddi, daligwen be imakoed.","poem":2},{"text":"Mormar-dummagan goambe-gakagwensakad (11) bela emarbi-dungu be imakoed.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"We-mormar-dummagan, goatar be gwadioed,","poem":1},{"text":"degine, baid goanergwa (6) be gwadibaloed.","poem":2},{"text":"Geb anse-goled-neg-sunna-seleged-e-yawagak-asabin, mormar-dummagan-goanergwad-e-gogwenad-napid be nubyar nasikoed.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Geb a-sorbali, mor-dummad-dikarba gwadulabo-gakambe (50) e-uayamar be nasikoed.","poem":2},{"lineBreak":true},{"text":"Amba deyob baigan-gwadilesmalad-dikarba e-uayamar be nasikbaloed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Deginbali, esgoro-gordikid-dulabo-gakambe (50) mor-gamalad be imakbaloed.","poem":1},{"text":"Wemala mor-dummad-e-uaya-yaba be odogoed,","poem":2},{"text":"adi, mor-dummagan danar-danaled unnila goa-gwennagwadyob guegar.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Mormar-dummagan, ar bur-suidsoggu,","poem":1},{"text":"anse-goled-neg-sunna-seleged-e-dikarmargi batenai guoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"We-batenanaidi, anse-goled-neg-sunna-seleged-edugoed,","poem":1},{"text":"gwensaksik, achabo batenai be imakoed,","poem":2},{"lineBreak":true},{"text":"baidsik, amba achabo batenai be imakbaloed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sibad-wawaad-machered-e-ukamar-ginnidgi-odolegaled,","poem":1},{"text":"anse-goled-neg-sunna-seleged-edugega be imakbaloed.","poem":2},{"text":"Geb degine, ibdurgan-uka-nuegan, be ebubaloed,","poem":1},{"text":"adi, agi anse-goled-neg-edugegarbar.","poem":2}]},{"type":"verse","number":15,"content":["”Deginbali, anse-goled-neg-sunna-selegedga urgomar-acaciaʼye-nugad be sobbaloed.",{"text":"We-urgomar nue inniki-inniki be imakoed.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"We-urgomar dalibo-abala-sugu be imakoed,","poem":2},{"lineBreak":true},{"text":"e-matardungueddi achapaa be imakoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Deginbali, urgomargi e-nagmar war-warbo-nika be soboed,","poem":1},{"text":"adi, nabir urgomar naga-nagaba matak-matak gwisguegar.","poem":2},{"text":"Weyob bela urgomar be anse-goled-neg-sunna-selegedga be imakoed.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Degisoggu, urgomar mata-dulagwen (20) anse-goled-neg-sunna-selegedga,","poem":1},{"text":"dad-nakwed-argan-nuedsik ogwichega be imakoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Urgomar-mata-dulagwenad-urba e-sigmalad gwadulabo (40) manibi be soboed.","poem":1},{"text":"Urgomar-irbali gwa-gwabo e-sigmalad be imakoed,","poem":2},{"lineBreak":true},{"text":"adi, urgo-e-nagmar e-sigmaladgi dogegar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Anse-goled-neg-sunna-selegedga urgomar-mata-dulagwen (20)","poem":1},{"text":"dad-nakwed-argan-sapiledsik ogwichega be imakbaloed.","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Be e-sigmalad-manibiid gwadulabo (40) be imakbaloed.","poem":2},{"lineBreak":true},{"text":"Urgomar-iliba gwa-gwabo e-sigmalad be imakoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Anse-goled-neg-sunna-seleged-sorsik,","poem":1},{"text":"dad-argwanedsiki urgo-matanergwa (6) be sobbaloed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Deginbali, e-abingunaid-yarganbalidgala,","poem":1},{"text":"urgo-matabo be soboed.","poem":2},{"text":"Deyobi, e-abingunaid-yarganbalid-baidga,","poem":1},{"text":"urgo-matabo be sobbaloed.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"We-urgo-matabogwad-e-nagmar, e-sigmalad-birgi darbo abingunaidgi gwisguoed.","poem":1},{"text":"Geb nibalidse or-dummad-naidgi be urgo darbobela be odogoed.","poem":2},{"text":"Weyob urgo-matabogwad niba ebo-atonai be imakoed.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Degisoggu, urgo-matabaabakgi (8) e-sigmalad-manibiid gwaambe-gakanergwa (16) be sioed.","poem":1},{"text":"A-sogleged, urgo-matagwengi e-urba e-siged be gwa-gwabo sioye.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Deginbali, urgo-warakwagana-acaciaʼye-nugad-biir-megmalad be imakbaloed.","poem":1},{"text":"We-urgo-warakwagana anse-goled-neg-sunna-seleged-e-dikar-soggwensikidga walatar be imakoed.","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Urgo-warakwagana anse-goled-neg-sunna-seleged-e-dikar-baidsikidga, walatar be imakbaloed.","poem":2},{"lineBreak":true},{"text":"Degine, dad-argwaned-yarganbalidga urgo-warakwagana walatar be imakbaloed,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Neg-abargi-urgo-warakwa-megoed bela-baksa urgomar-abargi megoed.","poem":1}]},{"type":"verse","number":29,"content":[{"text":"Bela urgomar-ebilis or be matak-matak nasikoed.","poem":3},{"text":"Degine, e-olua-dummagan orbi be imakbaloed,","poem":1},{"text":"adi, a-yaba urgo-warakwagana-odogegar.","poem":2},{"text":"Bela we-urgo-warakwagana-biir-megmalad-birgi or be nasikbaloed.","poem":3}]},{"type":"verse","number":30,"content":["”Igi-dakle yar-birgi bega oyolesa, ayobi, anse-goled-neg-sunna-seleged be soboed."]},{"type":"verse","number":31,"content":[{"text":"Deginbali, mor-dummad be imakoed.","poem":1},{"lineBreak":true},{"text":"We-dubmargi be imakoed:","poem":1},{"text":"Nirbadub-aradgi,","poem":2},{"lineBreak":true},{"text":"nirbadub-suir-akwagiidgi,","poem":2},{"lineBreak":true},{"text":"nirbadub-ginnidgi,","poem":2},{"lineBreak":true},{"text":"linoʼdub-nuedgi be soboed.","poem":2},{"text":"We-morde nue-yeerdakle-imakar, baliwiturmar-querubinʼye-nugad, egi-ise-nue-sobale be imakoed.","poem":1}]},{"type":"verse","number":32,"content":[{"text":"Buarmar-acacia-walabakegwadgi we-mor-dummad-yeerdakleged be nasikoed.","poem":2},{"text":"We-buarmarde or egi nasiklealed.","poem":3},{"lineBreak":true},{"text":"E-siged-manibiid-birgi we-buarmar gwisguoed.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"We-mor-dummadde mor-nasikmaladgi be nasikoed.","poem":1},{"text":"Degisoggu, we-mor-dummad Neg-Islidikid, Neg-Ise-Islidikid-ebo bachiki-imakega guoed.","poem":2},{"text":"We-mor-dummad-daksik Dulemarbo-An-Igar-Mesisad-Ulu be sioed.","poem":1}]},{"type":"verse","number":34,"content":[{"text":"Geb degine, Dulemar-Ebo-An-Igar-Mesisad-Ulu-birgine, e-eduged be mesoed.","poem":2},{"text":"E-edugedde, Isgued-Elileged-E-Wilubye, sogleged.","poem":3},{"text":"We-ulude, Neg-Ise-Islidikidyaba sioed.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Neg-Islidikidgi, mor-naid-magabali,","poem":1},{"text":"dad-nakwed-argan-sapiledsik, mese be sioed.","poem":2},{"lineBreak":true},{"text":"We-mese an-asabin madu-ukleged-mesed.","poem":2},{"lineBreak":true},{"text":"A-mese-asabinni, dad-nakwed-argan-nuedsik gwallu be sibaloed.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Anse-goled-neg-sunna-seleged-e-yawagakgala, we-dubmargi mor-dummad be soboed:","poem":1},{"text":"Nirbadub-aradgi,","poem":2},{"lineBreak":true},{"text":"nirbadub-suir-akwagiidgi,","poem":2},{"lineBreak":true},{"text":"nirbadub-ginnidgi,","poem":2},{"lineBreak":true},{"text":"linoʼdub-nuedgi be soboed.","poem":2},{"text":"Ise-nue-sobar, bela-bela-nue-yeerdakle-imakale, be we-mor-dummad imakoed.","poem":3}]},{"type":"verse","number":37,"content":[{"text":"Degine, we-mor-dummadgala,","poem":1},{"text":"acacia-buarmar walatale ega be imakoed.","poem":2},{"text":"We-buarmar-ebilis or be matak-matak nasikoed,","poem":1},{"text":"degine, mor-gamalad olobi ega be imakbaloed.","poem":2},{"text":"Deginbali, wemar-buarmar-ataled-abingaega,","poem":1},{"text":"esgoro-gordikidgi gwaatale e-sigmalad be soboed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EXO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EXO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EXO/25.json","previousChapterAudioLinks":{},"numberOfVerses":37}