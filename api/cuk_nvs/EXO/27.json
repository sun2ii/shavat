{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EXO","translationId":"cuk_nvs","name":"Éxodo","commonName":"Éxodo","title":"AINILESAD-GARDA ÉXODO","order":2,"numberOfChapters":40,"sha256":"a0a98dae2973e5c61d5e20a070f2da8b7d02836d116a5fd9ad11b5dea38345b4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/cuk_nvs/EXO/40.json","totalNumberOfVerses":1212},"chapter":{"number":27,"content":[{"type":"heading","content":["Ibmar-ogumakar-ukleged-aila-soblegoed"]},{"type":"verse","number":1,"content":["Bab-Jehová Moisésʼga sogdebalid:",{"text":"“Anga-ibmar-ogumakar-ukleged-aila, be imakbaloed.","poem":1},{"text":"A-aila, urgo-acaciaʼye-nugadgi emarbi yaa-dungu be imakoed.","poem":2},{"lineBreak":true},{"text":"E-sugued, daligwen-gaka-achabo,","poem":2},{"lineBreak":true},{"text":"e-matardungued, daligwen-gaka-achabobar.","poem":2},{"lineBreak":true},{"text":"E-nibgueddi, bisgipaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Degine, moli-bebegii aila-e-dikar-abingunanaid-birgi be ogwisbaloed.","poem":1},{"text":"We-moli-bebegiidmala, ailagi bato eba-mese-sobale be imakoed.","poem":2},{"lineBreak":true},{"text":"Anga-ibmar-ogumakar-ukleged-aila-birgi, esgoro-gordikid be nasikoed.","poem":2}]},{"type":"verse","number":3,"content":["”Deginbali, bela ibmarmar-we-ailagi-ebuleged esgoro-gordikidgi be soboed:",{"text":"Buru-simalad-bormomar.","poem":2},{"lineBreak":true},{"text":"Buru-weemalad-wesar-dummagan,","poem":2},{"lineBreak":true},{"text":"Abe-bomied-nog-dummagan.","poem":2},{"lineBreak":true},{"text":"San-obin-obin-saed-iko-dummagan.","poem":2},{"lineBreak":true},{"text":"Soo-seed-bormomar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Deginbali, esgoro-gordikidgi san-nared-saki-sakid be sobbaloed.","poem":1},{"text":"A-saki-sakidga, e-uaya, e-dikar-abingunanaidgi esgoro-gordikidgi be sobbaloed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Degine, san-nared-saki-sakid anga-ibmar-ogumakar-ukleged-ailagi, negabaladgi be nasikoed.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Deginbali, anga-ibmar-ogumakar-ukleged-ailaga, suar-warakwagana be imakbaloed.","poem":1},{"text":"We-suar-warakwaganaga urgo-acaciaʼye-nugad be ebugoed.","poem":2},{"lineBreak":true},{"text":"We-suar-warakwagana-birgi esgoro-gordikid egi be nasikoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Suarmar we-aila-e-oluaduk-dummagan-nanaid-yaba be odogegalad.","poem":1},{"text":"We-suarmar, anga-ibmar-ogumakar-ukleged-aila seledsokalile, dikarba-nai guoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Anga-ibmar-ogumakar-ukleged-aila be ollor imakoed, degine, we-aila urgomargi be soboed.","poem":1},{"text":"Ar igi bega yar-birgi oyolesa, deyob dakle be soboed.”","poem":2}]},{"type":"heading","content":["Bab-Dummadse-goled-neg-sunna-seleged-neg-imba-nasiklegoed"]},{"type":"verse","number":9,"content":["Bab-Jehová Moisésʼga sogdebalid:",{"text":"“Deginbali, anse-goled-neg-sunna-selegedga neg-imba be nasikbaloed.","poem":1},{"text":"Dali-dulagwen-gakatar-sugu (25) guoed,","poem":2},{"lineBreak":true},{"text":"dad-nakwed-argan-nuedsik be nasikoed.","poem":2},{"text":"Degine, we-neg-imba-e-galugi lino-mor-nued naguoed.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"E-buarmardi, waladulagwen (20) nikuoed,","poem":1},{"text":"degi, e-buar-sigmalad, amba gwadulagwenbar (20).","poem":2},{"lineBreak":true},{"text":"Bela wemar-sobegala, esgoro-gordikid be ebugoed.","poem":2},{"text":"E-gamalad-sobegala, degi, buar-e-nonomar-sobegala, mani be ebugoed.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Amba deyob anse-goled-neg-sunna-seleged-imba dad-nakwed-argan-sapiledsik,","poem":1},{"text":"lino-mor-nued dali-dulagwen-gakatar-sugu (25) be nasikbaloed.","poem":2},{"lineBreak":true},{"text":"E-buarmardi, dulagwen (20),","poem":2},{"lineBreak":true},{"text":"degi, e-buar-sigmalad amba dulagwenbar (20).","poem":2},{"text":"E-buar-sigmalad-imakegala, esgoro-gordikid be ebugoed.","poem":3},{"lineBreak":true},{"text":"E-mor-gamaladgardi, degi, e-buar-nonomargardi, mani be ebugoed.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Anse-goled-neg-sunna-seleged-imba dad-argwanedsik,","poem":1},{"text":"mor-dummad daliambe-gakabo-gaka-abala-matardungu (12½), be nasikoed.","poem":2},{"lineBreak":true},{"text":"E-buarmardi, warambe (10),","poem":2},{"lineBreak":true},{"text":"degi, e-buarmar-sigmalad, gwaambebar (10).","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anse-goled-neg-sunna-seleged-imba","poem":1},{"lineBreak":true},{"text":"dad-nakwedsikid e-matardungued,","poem":1},{"text":"daliambe-gakabo-gaka-abala (12½) guoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yawagak-doged-dikarba mor-dummad naguoedi,","poem":1},{"text":"dalipaa-gaka-bisgipaa, doged-e-dikar-gwensaksik sugu naguoed.","poem":2},{"lineBreak":true},{"text":"E-buarmardi, walapaa, degi, e-sigmalad amba gwapaabar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Degine, doged-e-dikar-baidsiki,","poem":1},{"text":"mor-dummad, dalipaa-gaka-bisgipaa nagubaloed.","poem":2},{"lineBreak":true},{"text":"E-buarmardi, walapaa, degi, e-sigmalad amba gwapaabar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Yawagak-dogedgi mor-dummad daliatar be nasikoed.","poem":1},{"lineBreak":true},{"text":"We-mor-dummad be imakoedi,","poem":1},{"text":"nirbadub-aradgi be imakoed,","poem":2},{"lineBreak":true},{"text":"nirbadub-suir-akwagiidgi be imakoed,","poem":2},{"lineBreak":true},{"text":"nirbadub-ginnidgi be imakoed,","poem":2},{"lineBreak":true},{"text":"linoʼdub-nuedgi, ise-nue-sobar,","poem":2},{"lineBreak":true},{"text":"bela-bela-nue-yeerdakle be imakoed.","poem":2},{"lineBreak":true},{"text":"Degine, e-buarmardi, walabake,","poem":2},{"lineBreak":true},{"text":"degi, e-sigmalad amba gwabakebar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bela we-neg-imba-e-buarmar-ebiroedi, e-buar-nonomar, manigi soblegoed,","poem":3},{"lineBreak":true},{"text":"e-gamalad, manigi soblebaloed.","poem":3},{"lineBreak":true},{"text":"E-sigmaladdi, esgoro-gordikidgi soblegoed.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"”Neg-imba dali-dulagwen-gakatar-sugu (25) guoed,","poem":1},{"text":"e-matardungued, daliambe-gakabo-abala (12½) guoed.","poem":2},{"lineBreak":true},{"text":"E-mor-naguoed, daligwen-bisgise sugu naguoed.","poem":2},{"lineBreak":true},{"text":"We-mor-dummagan-naguoedi, lino-mor-nued guoed.","poem":2},{"lineBreak":true},{"text":"E-sigmaladdi, esgoro-gordikidgi soblegoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Anse-goled-neg-sunna-selegedgi belagwapa-ibmarmar-ebulegoedi, bela esgoro-gordikidbi guoed.","poem":3},{"lineBreak":true},{"text":"Degine, we-a-neg-bargamalad, degi, e-galumar-bargamalad, bela esgoro-gordikidmarbi be imakbaloed.”","poem":3}]},{"type":"heading","content":["Gwallu-dii-ebulegoed"]},{"type":"verse","number":20,"content":["Bab-Jehová Moisésʼga sogdebalid:",{"text":"“Israel-dulemarga be sogo:","poem":1},{"text":"‘Olivo-e-gwallu ibmar-baidba-oburarsuli be sedamalo,","poem":2},{"lineBreak":true},{"text":"adi, gwallu-ogamalagar.","poem":2},{"lineBreak":true},{"text":"Degisadegu gwallu gasii guegar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Aarón, degi, e-machimala, gwallu guakwaa simaloed,","poem":1},{"text":"adi, gwallu gasigu oibodagegar.","poem":2},{"text":"We-gwallu Bab-Jehová-dulemarbo-ambikued-neggi,","poem":1},{"text":"mor-dummad-Bab-Ulu-irwa-naid-magaba sigoed.","poem":2},{"text":"We-igar-an-ukedi, Israel-dulemarga, degine, e-waganga, degisadegu guoed.’ ”","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EXO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EXO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EXO/26.json","previousChapterAudioLinks":{},"numberOfVerses":21}