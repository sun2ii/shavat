{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EXO","translationId":"cuk_nvs","name":"Éxodo","commonName":"Éxodo","title":"AINILESAD-GARDA ÉXODO","order":2,"numberOfChapters":40,"sha256":"a0a98dae2973e5c61d5e20a070f2da8b7d02836d116a5fd9ad11b5dea38345b4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/cuk_nvs/EXO/40.json","totalNumberOfVerses":1212},"chapter":{"number":31,"content":[{"type":"heading","content":["Bezaleel, degi, Aholiab, arbaega sulesmalad"]},{"type":"verse","number":1,"content":["Bab-Jehová Moisésʼga sunmakded, ega sogded:"]},{"type":"verse","number":2,"content":["“Nue be an-itogo. Hur-e-wagwa-Judá-yargined Uri-machi-Bezaleelʼye-nugad an susad."]},{"type":"verse","number":3,"content":["We-Bezaleelʼga An-Burba an ega nue-uksad.",{"text":"Nue-binsaed-nikagued an ega uksad,","poem":2},{"lineBreak":true},{"text":"nue-ibmar-magar-itogued an ega uksad,","poem":2},{"lineBreak":true},{"text":"nue-ibmar-wisigued an ega uksad,","poem":2},{"lineBreak":true},{"text":"degine, nabir-ibmar-obinyemaigued an ega uksad.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Adi, nabir ibmar yeerdakle-sobegar,","poem":2},{"lineBreak":true},{"text":"nabir orgi-arbaegar,","poem":2},{"lineBreak":true},{"text":"nabir manigi-arbaegar,","poem":2},{"lineBreak":true},{"text":"nabir esgoro-gordikidgi-arbaegar.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Degine, nabir akwa-nuegangi-arbaegar,","poem":2},{"lineBreak":true},{"text":"nabir akwa-nuegan ibmar-birgi siegar,","poem":2},{"lineBreak":true},{"text":"nabir urgomargi-arbaegar,","poem":2},{"text":"degine, nabir-galagwensuli ibmar-yeerdakle-imakegar.","poem":3}]},{"type":"verse","number":6,"content":["”Deginbali, Bezaleel-bendakega, Dad-dummad-Dan-wagwa Ahisamac-machi-Aholiab an susbalid. Dule-nue-ibmar-wisimalad, gatik-ibmar-wisguega an imaksad, adi, bela an-ibmar-sogsadba bega imakmalagar, we-ibmargi arbamalagar:"]},{"type":"verse","number":7,"content":[{"text":"Dulemar-anbo-ambikued-neggi,","poem":2},{"lineBreak":true},{"text":"Dulemar-Anbo-Igar-Mesisad-Ulugi,","poem":2},{"lineBreak":true},{"text":"Dulemar-Anbo-Igar-Mesisad-Ulu-edugedgi,","poem":2},{"lineBreak":true},{"text":"degi, anse-goled-neg-sunna-selegedgi bela-ibmar-ebuleged sobegar.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Degine, mese, geb bela-eba-ibmarmar-ebulemalad.","poem":2},{"lineBreak":true},{"text":"Gwallu-sied-bela olobiid, geb bela eba-ibmarmar-ebulemalad.","poem":2},{"lineBreak":true},{"text":"Anga-ina-wawadikid-inciensoʼye-nugad-ogumakleged-aila.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Anga-ibmar-ogumakar-ukleged-aila,","poem":2},{"lineBreak":true},{"text":"geb bela-eba-ibmarmar-ebulemalad.","poem":2},{"lineBreak":true},{"text":"Dii-sied-esgoro-gordikidgi-sobaled,","poem":2},{"lineBreak":true},{"text":"geb bela e-malise-bakar, sobegarbar.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Degine, we-mormar makmarbaloed:","poem":2},{"lineBreak":true},{"text":"Aarón-mor-islidikmalad,","poem":2},{"lineBreak":true},{"text":"degi, e-masmala-mor-anse-dulemar-irwa-gorsokalir-yodamalad.","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Olivo-gwallu-magega-ebuleged,","poem":2},{"lineBreak":true},{"text":"degi, ina-wawadikid Neg-Islidikidgi-ebuleged sobegarbar.","poem":2},{"text":"Wemala, Bezaleel, degi, Aholiab-ebogwa bela sobmaloed.","poem":3},"”Ar igi bela an bega sogsa, deyob sogedba imakmaloed.”"]},{"type":"heading","content":["Obunnoged-iba-igar"]},{"type":"verse","number":12,"content":["Bab-Jehová Moisésʼga sogdebalid:"]},{"type":"verse","number":13,"content":["“Israel-dulemarga be sunmakoed, ega be weyob sogo: ‘Napira an bemarga soged, an-obunnoged-ibagi be obunnomalo, ar ade, wede bemar-ebo an-Igar-Mesnaid e-wilubga gued. Be-waganga we-Igar degisadegu mai guoed, adi, be wisgumalagar, ani an Bab-Jehová gued. Ani an be-sunonimalad, anga arbadii gumalagar."]},{"type":"verse","number":14,"content":[{"text":"Degisoggu, obunnoged-ibagi mer arbamalo, ar ade, a-iba bemargala iba-islidikidid.","poem":2},{"lineBreak":true},{"text":"A-ibagi, dule obunnogergebed.","poem":2},{"lineBreak":true},{"text":"A-ibagi, dule wis arbasale, we-dule e-dulemar-abargi Israel-dulemar-abargi-onolegoed.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ibanergwa (6) arbalegoed,","poem":2},{"lineBreak":true},{"text":"ibagugledgindina (7), obunnoged-ibad.","poem":2},{"lineBreak":true},{"text":"We-iba Bab-Jehováʼgadid.","poem":2},{"lineBreak":true},{"text":"Ar doa-dule we-ibagi arbaye-sogele,","poem":2},{"lineBreak":true},{"text":"napira an bega soged, we-dule oburgwilegedsegad.’","poem":2}]},{"type":"verse","number":16,"content":["”Degisoggu, Israel-dulemala obunnoged-ibagi arbaosurmalad. E-waganmargala we-Igar degisadegu-mai guoed."]},{"type":"verse","number":17,"content":["Israel-dulemar-anbo-we-Igar-Mesnaid e-wilubga guoed, degisadegu-maigu guoed. Ar Bab-Jehová, nibneg-nasikegala, napneg-nasikegala, ibanergwa (6) arbasad. Ibagugledgindi (7), bar arbassulid. Bab-Dummad a-ibagi obunnosad.”"]},{"type":"verse","number":18,"content":["Bab-Jehová, Sinaí-yargi Moisésʼbo-sunmaknaid-bergusgua, Israel-Dulemarbo-Igar-Mesnaid-e-wilubga-guega, Moisésʼga akwa-matargwagwad-matabo uksad. We-akwagi-Igarmar-narmaklesadi, Bab-Dummad na e-sunnad e-googi narmaksad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EXO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EXO/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EXO/30.json","previousChapterAudioLinks":{},"numberOfVerses":18}