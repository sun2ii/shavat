{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EXO","translationId":"cuk_nvs","name":"Éxodo","commonName":"Éxodo","title":"AINILESAD-GARDA ÉXODO","order":2,"numberOfChapters":40,"sha256":"a0a98dae2973e5c61d5e20a070f2da8b7d02836d116a5fd9ad11b5dea38345b4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/cuk_nvs/EXO/40.json","totalNumberOfVerses":1212},"chapter":{"number":35,"content":[{"type":"heading","content":["Obunnoleged-iba, iba-islidikidid"]},{"type":"verse","number":1,"content":["Moisés bela Israel-dulemarse gochad, geb degine amarga sogded: “Weyob Bab-Jehová igar uksad, weyob be imakmaloye:"]},{"type":"verse","number":2,"content":["Ibanergwa (6) arbalegoed, ibagugledgindi (7), iba-islidikidid. A-ibagi, Bab-Jehováʼga obunnolegoed. Ar doa-dule a-ibagi arbaele, we-dule oburgwilegoed."]},{"type":"verse","number":3,"content":["Bemar-neg-yagine, bipisaale obunnoged-ibagi soo be ogaosurmalad.”"]},{"type":"heading","content":["Bab-Dummadse-goled-neg-sunna-seleged-soblegoedga ibmar-ukleged"]},{"type":"verse","number":4,"content":["Moisés, bela Israel-dulemar-danar-ambikunonikidga weyob sunmaksad: “Bab-Jehová sogsad: ‘Weyob be imakmaloye:"]},{"type":"verse","number":5,"content":["Bemar ibmar-nikadi Bab-Jehováʼga be sedamaloed. Dulemar na e-gwagegi ibmar Bab-Jehováʼga ukbi-itomaladba ibmar sedagoed. We-ibmarmar sedagoed:",{"text":"Olo, mani, esgoro-gordikid.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nirbadub-arad, nirbadub-suir-akwagiid, nirbadub-ginnid,","poem":2},{"lineBreak":true},{"text":"linoʼdub-nued, sibad-e-absarmar,","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"sibad-wawaad-machered-e-ukamar-ginnidgi-odolegaled,","poem":2},{"lineBreak":true},{"text":"ibdurgan-uka-nuegan,","poem":2},{"lineBreak":true},{"text":"urgomar-acaciaʼye-nugad.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Olivo-gwallu gwallu-ogaegar.","poem":2},{"lineBreak":true},{"text":"Gwallu-wawad ibmar-magega guegar,","poem":2},{"lineBreak":true},{"text":"degi, olivo-gwallu ina-wawadikmaladgi ebulegegar.","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Akwa-nuegan-óniceʼye-nugmalad,","poem":2},{"text":"akwa-nuegan mor-efodʼye-nugad-birgi nasikegar,","poem":3},{"lineBreak":true},{"text":"degi, mor-binasgargi-nasiklegedgi nasikegarbar.’ ”","poem":3}]},{"type":"heading","content":["Bab-Dummadse-goled-neggi-ibmar-ebulemalad"]},{"type":"verse","number":10,"content":["Moisés Israel-dulemarga sogdebalid: “Bela Bab-Jehová-ibmar-sogsad-sobmalaga, bela dulemar bemar-abargi nue-ibmar-wisi-sobemalad nonimalo."]},{"type":"verse","number":11,"content":["Amar we-ibmarmar sobmaloed:",{"text":"Bab-Dummadse-goled-neg-sunna-seleged,","poem":1},{"text":"e-neg-sunnad, e-uas-mormar,","poem":2},{"lineBreak":true},{"text":"e-mor-gamalad, e-urgomar,","poem":2},{"lineBreak":true},{"text":"e-suarmar, e-buarmar, e-sigmalad.","poem":2}]},{"type":"verse","number":12,"content":["”Deginbali, sobmarbaloed:",{"text":"Bab-Dummad-Israel-Dulemarbo-Igar-Mesisad-Ulu,","poem":1},{"text":"e-suarmar, e-eduged,","poem":2},{"lineBreak":true},{"text":"mor-dummad-Ulu-walik-naguoed.","poem":2}]},{"type":"verse","number":13,"content":["”Deginbali, sobmarbaloed:",{"text":"Mese, mese-suarmar,","poem":1},{"text":"bela mesegi-ibmar-ebulemalad,","poem":2},{"lineBreak":true},{"text":"degi, madu-Bab-Dummadga-ukleged.","poem":2}]},{"type":"verse","number":14,"content":["”Sobmarbaloed:",{"text":"Gwallu-sied, degi, bela eba ibmarmar-ebulegoed.","poem":1},{"text":"E-gwallumar, degi, olivo-gwallu gwallu-ogaegar.","poem":2}]},{"type":"verse","number":15,"content":["”Sobmarbaloed:",{"text":"Ina-wawadikid-inciensoʼye-nugad-ogumakleged-aila, degi, e-suarmar.","poem":1},{"text":"Gwallu-wawa ibmar-magega ebuleged,","poem":2},{"lineBreak":true},{"text":"ina-wawadikmalad.","poem":2},{"lineBreak":true},{"text":"Mormar-dummagan Neg-Sunna-Seleged-e-yawagak-dogedgi-naguoed.","poem":2}]},{"type":"verse","number":16,"content":["”Sobmarbaloed:",{"text":"Bab-Dummadga-ibmar-ogumakar-ukleged-aila,","poem":1},{"text":"e-esgoro-gordikmalad-biir-biir-megoed,","poem":2},{"lineBreak":true},{"text":"degi, e-suarmar, bela eba-ibmarmar-ebulegoed.","poem":2},{"text":"Dii-sied-esgoro-gordikidbiid,","poem":1},{"text":"degi, a-e-malimar.","poem":2}]},{"type":"verse","number":17,"content":["”Sobmarbaloed:",{"text":"Bab-Dummadse-goled-neg-sunna-seleged-e-galugi mormar-dummagan-ebirmaloed,","poem":1},{"text":"e-buarmar, e-sigmalad.","poem":2},{"text":"We-neg-sunna-seleged-e-neg-e-galu-dogedgi mor-dummad-naguoed.","poem":1}]},{"type":"verse","number":18,"content":[{"text":"We-neg-e-bargamalad, e-galu-bargamalad, e-dubmar sobmaloed.","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Aarónʼga, degi, Aarón-masmalaga, Bab-Dummadse-goled-neggi-mormar-ebulemaloed sobmarbaloed.","poem":2},{"text":"Bela we-ibmarmar sobmaloed.”","poem":3}]},{"type":"heading","content":["Israel-dulemar Bab-Dummadga ibmar uksamalad"]},{"type":"verse","number":20,"content":["Degidgine, bela Israel-dulemar Moisés-asabin-bukmaladi ainiarmalad."]},{"type":"verse","number":21,"content":[{"text":"Bela dulemala, bela na e-gwagegi-ibmar-ukbi-itosmaladi,","poem":1},{"text":"Bab-Dummad-dulemarbo-ambikued-neg-sobmalaga,","poem":2},{"lineBreak":true},{"text":"agi-bela-ibmarmar-ebulemalad-sobmalaga,","poem":2},{"lineBreak":true},{"text":"degine, dule-irwa-Bab-Dummadse-goledgi mor-islidikid-yomalad-sobmalaga,","poem":2},{"text":"Bab-Jehováʼga ibmar searmalad.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Bela ibmar-ukbi-itosmaladi, machergan, degi, omegan-ugakse, we-ibmarmar senonimalad:","poem":1},{"text":"Ordub, oluamar,","poem":2},{"lineBreak":true},{"text":"sakwagi-ormar-nagumalad,","poem":2},{"lineBreak":true},{"text":"argangi-or-yolemalad,","poem":2},{"lineBreak":true},{"text":"degi, bela ormar-galagwensuli senonimalad.","poem":2},{"text":"Belagwable Israel-dulemala Bab-Jehováʼga or senonimalad.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Bela dulemar nirbadub-arad-nikamalad,","poem":2},{"lineBreak":true},{"text":"nirbadub-suir-akwagiid, nirbadub-ginnid,","poem":2},{"lineBreak":true},{"text":"linoʼdub-nued, sibad-e-absarmar,","poem":2},{"lineBreak":true},{"text":"sibad-wawaad-machered-e-ukamar-ginnidgi-odolegaled,","poem":2},{"lineBreak":true},{"text":"ibdurgan-uka-nuegan, senonimalad.","poem":2},{"text":"Bela-dulemar we-ibmar-nikamaladi, Bab-Dummadga-ukega senonimalad.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Bab-Dummadse-goled-neg-sunna-selegedgi ebulegega,","poem":1},{"text":"dulemar mani-nikamaladi,","poem":2},{"lineBreak":true},{"text":"esgoro-gordikid-nikamaladi, Bab-Jehováʼga ukdemalad.","poem":2},{"lineBreak":true},{"text":"Degine, urgomar-acaciaʼye-nugad-nikamaladi, ukdemarmogad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Deginbali, omegan-ibmar-nue-wisimalad, e-argangi-dub-sobsamaladi, Bab-Dummadga senonimalad:","poem":1},{"text":"Nirba-dub-aradgi-sobsamalad,","poem":2},{"lineBreak":true},{"text":"nirbadub-suir-akwagiidgi-sobsamalad,","poem":2},{"lineBreak":true},{"text":"nirbadub-ginnidgi-sobsamalad,","poem":2},{"lineBreak":true},{"text":"degi, linoʼdub-nuedgi-sobsamalad, senonimalad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bela omegan ibmar-nue-imakmaladi, e-gwagegi nue-imakbi-itosmaladi,","poem":1},{"text":"sibad-e-absarmar sobsamarmogad.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Israel-dulemar-dummaganga-gudidimaladi,","poem":1},{"text":"akwa-nuegan-óniceʼye-nugad,","poem":2},{"lineBreak":true},{"text":"degi, akwamar-nuegan,","poem":2},{"text":"mor-efodʼye-nugadgi-nasikmalaga,","poem":3},{"lineBreak":true},{"text":"degi, mor-binasgargi-nasikleged-birgi-nasikmalaga, senonimalad.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Deginbali, we-ibmarmar senonimarbalid:","poem":1},{"text":"Ina-nuegan,","poem":2},{"lineBreak":true},{"text":"olivo-gwallu gwallu-ogaegar,","poem":2},{"lineBreak":true},{"text":"gwallu-wawad ibmar-magegar,","poem":2},{"lineBreak":true},{"text":"degi, ina-wawadikmalad obupurmakegar.","poem":2}]},{"type":"verse","number":29,"content":["Bela Israel-dulemar, machergan, degi, omeganse-bakale, na gwagegi-ibmar-ukbi-itosmaladi, Bab-Jehováʼga na e-itogedba-ibmar-ukega senonimalad, adi, Bab-Jehováʼga ibmarmar sobegar. Ar igi Bab-Jehová-Moisésʼga-sogsagusa, deyob imaksamalad."]},{"type":"heading","content":["Bezaleel, degi, Aholiab, arbaega sulesmalad"]},{"type":"verse","number":30,"content":["Geb degine, Moisés Israel-dulemarga sogded: “Nue be an-itomalo. Bab-Jehová, Uri-machi-Bezaleel onugsasad. Bezaleelʼde, Hur-e-wagwad. E-dad-dummad-Judáʼgi danikidid."]},{"type":"verse","number":31,"content":[{"text":"Bab-Dummad Bezaleelʼga E-Burba uksad,","poem":1},{"text":"nue-binsaed-nikaa guegar,","poem":2},{"lineBreak":true},{"text":"nue-ibmar-mag-ito guegar,","poem":2},{"lineBreak":true},{"text":"nue-ibmar-wisi guegar,","poem":2},{"lineBreak":true},{"text":"degi, ibmar-akar-akar-obinyegar.","poem":2}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Adi, ibmar-yeerdakle orgi-sobegar,","poem":2},{"lineBreak":true},{"text":"manigi-sobegar,","poem":2},{"lineBreak":true},{"text":"esgoro-gordikidgi-sobegar.","poem":2}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Deginbali, nabir akwa-nuegangi-arbaegar,","poem":2},{"lineBreak":true},{"text":"akwa-nuegan ibmar-birgi siegar,","poem":2},{"lineBreak":true},{"text":"nabir urgomargi-arbaegar,","poem":2},{"lineBreak":true},{"text":"degi, galagwensuli ibmar-yeerdakle imakegar.","poem":2}]},{"type":"verse","number":34,"content":["”Bab-Dummad Bezaleelʼga, degi, Aholiabʼga nabir-dulemar-odurdaked-gurgin uksad. Aholiab Ahisamac-e-machid, e-dad-dummad-Danʼgi danikidid."]},{"type":"verse","number":35,"content":[{"text":"Bab-Dummad Bezaleelʼga, degi, Aholiabʼga, we-gurginmar uksad:","poem":1},{"text":"Nabir baisursunna-ibmar-imaked,","poem":2},{"lineBreak":true},{"text":"nabir-ibmar-onoged,","poem":2},{"lineBreak":true},{"text":"nabir nirbadub-aradgi-ibmar-sobed,","poem":2},{"lineBreak":true},{"text":"nabir-nirbadub-suir-akwagiidgi-ibmar-sobed,","poem":2},{"lineBreak":true},{"text":"nabir-nirbadub-ginnidgi-ibmar-sobed,","poem":2},{"lineBreak":true},{"text":"nabir-linoʼdub-nuedgi-ibmar-sobed-gurgin, uksabalid.","poem":2},{"text":"We-dulemala, ibmar-yeerdakle sobmaladid, mormargi arbamaladid,","poem":3},{"lineBreak":true},{"text":"degi, nabir na-e-itolegedba sunna ibmar-akar-akar onomaladid.”","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EXO/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EXO/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EXO/34.json","previousChapterAudioLinks":{},"numberOfVerses":35}