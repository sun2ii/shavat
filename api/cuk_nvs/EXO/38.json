{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EXO","translationId":"cuk_nvs","name":"Éxodo","commonName":"Éxodo","title":"AINILESAD-GARDA ÉXODO","order":2,"numberOfChapters":40,"sha256":"a0a98dae2973e5c61d5e20a070f2da8b7d02836d116a5fd9ad11b5dea38345b4","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/cuk_nvs/EXO/40.json","totalNumberOfVerses":1212},"chapter":{"number":38,"content":[{"type":"heading","content":["Ibmar-ogumakar-ukleged-aila-soblesad"]},{"type":"verse","number":1,"content":["Deginbali, Bezaleel urgo-acaciaʼye-nugadgi Bab-Dummadga-ibmar-ogumakar-ukleged-aila sobsabalid. E-sugued, daligwen-gaka-achabo, e-matardungued, daligwen-gaka-achabo-nika sobsad. E-sugued, degi, e-matardungued, emarbi imaksad. E-nibgueddi, bisgipaa-nika imaksad."]},{"type":"verse","number":2,"content":["We-aila mullugwad-sogabake-abingunaidgi moli-bebegiid ogwichisad. We-moli-bebegiid ailaba-mesa sobsad. Bab-Dummadga-ibmar-ogumakar-ukleged-aila-birgi esgoro-gordikid egi nasiksad."]},{"type":"verse","number":3,"content":["Deginbali, bela Bab-Dummadga-ibmar-ogumakar-ukleged-ailagi we-ibmar-ebulemaloed sobsabalid:Ibmar-ogumakar-ukleged-aila. (Éxodo 38:1-7)",{"text":"Buru-simalad-bormomar.","poem":2},{"lineBreak":true},{"text":"Buru-weemalad-wesar-dummagan,","poem":2},{"lineBreak":true},{"text":"Abe-bomied-nog-dummagan.","poem":2},{"lineBreak":true},{"text":"San-obin-obin-saed-iko-dummagan.","poem":2},{"lineBreak":true},{"text":"Soo-seed-bormomar.","poem":2},{"text":"Bela-wemala esgoro-gordikidgi sobsad.","poem":3}]},{"type":"verse","number":4,"content":["Bab-Dummadga-ibmar-ogumakar-ukleged-ailaga, san-nared-saki-sakid esgoro-gordikidgi sobsad. We-san-nared-saki-sakid Bab-Dummadga-ibmar-ogumakar-ukleged-aila-yagi, negabaladgi nasiksad."]},{"type":"verse","number":5,"content":["Deginbali, olua-dummagan-sobega esgoro-gordikid dusbalid. Deyob imaksad, adi, san-nared-saki-sakidgi we-olua-dummagan-gwabake nasikega, adi, agi suarmar-suigan odogegar."]},{"type":"verse","number":6,"content":["Urgo-acaciaʼye-nugad-walagana suitii sobsad. Geb a-suarmar-birgi, esgoro-gordikid nasiksad."]},{"type":"verse","number":7,"content":["Geb degine, Bab-Dummadga-ibmar-ogumakar-ukleged-aila-dikarba oluaduk-dummagan-nanaid-yaba suarmar-walagana odosad, adi, nabir aila selegegar. Bab-Dummadga-ibmar-ogumakar-ukleged-aila ollor sobaled. We-aila urgomargi sobaled."]},{"type":"heading","content":["Dii-sied-soblesad"]},{"type":"verse","number":8,"content":["Bezaleel, dii-sied, degi, e-sigedga-gued, esgoro-gordikidgi sobsabalid. We-sobegala, omegan-Bab-Dummadse-goled-neggi-arbamalad e-isbemar-esgoro-gordikidgi-sobaled ebusad."]},{"type":"heading","content":["Bab-Dummadse-goled-e-imba-nasiklesad"]},{"type":"verse","number":9,"content":["Bezaleel, Bab-Dummadse-goled-neg-sunna-seleged-e-neg-imba, degi, e-galu sobsabalid.",{"text":"Dad-nakwed-argan-nuedsik, a-neg-imba-e-galuga, mor-dummagan imaksad:","poem":1},{"text":"Lino-mor-nued dali-dulagwen-gakatar-sugu (25), sobsad.","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"E-buarmar, dulagwen (20) mergued.","poem":2},{"lineBreak":true},{"text":"Egi-sigmalad, dulagwen (20) mergubalid,","poem":2},{"text":"bela esgoro-gordikidgi sobaled.","poem":3},{"text":"Buarmar-e-nonomar, e-gamalad,","poem":2},{"text":"bela manibi sobaled.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Bab-Dummadse-goled-neg-sunna-selegedgi dad-nakwed-argan-sapiledsik,","poem":1},{"text":"mor-dummad dali-dulagwen-gakatar-sugu (25) naibalid.","poem":2},{"lineBreak":true},{"text":"E-buarmar, dulagwen (20) gwigwisbalid.","poem":2},{"lineBreak":true},{"text":"Degi, e-sigmalad esgoro-gordikidgi dulagwen (20) imakarbalid.","poem":2},{"text":"E-gamalad, degine, e-buar-nonomar, manigi sobarbalid.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Dad-argwanedsik mor-dummad-naidi,","poem":1},{"text":"daliambe-gakabo-abala (12½) sugued.","poem":2},{"lineBreak":true},{"text":"E-buarmar, warambe (10) gwigwichid,","poem":2},{"lineBreak":true},{"text":"degi, e-siged, gwaambebalid (10).","poem":2},{"text":"E-gamalad, degi, e-buar-nonomar, manigi sobarbalid.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Dad-nakwedsik mor-dummad-naidi,","poem":1},{"text":"daliambe-gakabo-abala (12½) sugued.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"E-yawagak-dikarsiki, mor-dummad-naidi, dalipaa-gaka-bisgipaa sugued.","poem":2},{"lineBreak":true},{"text":"E-buarmar walapaa, degine, e-sigmalad, gwapaa sobarbalid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Degine, yawagak-baid-dikarbali,","poem":1},{"text":"mor-dummad dalipaa-gaka-bisgipaa-sugu naid.","poem":2},{"lineBreak":true},{"text":"Degi, buarmar, walapaa,","poem":2},{"lineBreak":true},{"text":"degi, e-sigmarmogad, gwapaa sobarbalid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mor-dummagan neg-galugi-nanaidi, bela lino-mor-nuegan naed.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"E-buarmar-sigmalad bela esgoro-gordikidgi sobaledbiid.","poem":2},{"lineBreak":true},{"text":"E-gamaladi, degi, e-olua-dummagandi, manibi sobaled.","poem":2},{"lineBreak":true},{"text":"Deginbali, e-buar-nonomargi, bela manibi matak-matak ebiris naid.","poem":2},{"text":"Bela Babse-goled-neg-e-buarmar-bukwad-e-olua-dummagan bela manibiid.","poem":3}]},{"type":"verse","number":18,"content":["Yawagakga neg-imba-dogedgi mor-dummad-naidi, mor ise-nue-sobar, bela-bela nue-yeerdakle-imakar naid.",{"text":"We-mor-dummad-sobaledi, we-dubmargi sobaled:","poem":1},{"text":"Nirbadub-aradgi,","poem":2},{"lineBreak":true},{"text":"nirbadub-suir-akwagiidgi,","poem":2},{"lineBreak":true},{"text":"nirbadub-ginnidgi,","poem":2},{"lineBreak":true},{"text":"degi, linoʼdub-nuedgi sobaled.","poem":2},{"text":"E-suguedi, daliataled.","poem":3},{"lineBreak":true},{"text":"E-nibgueddi, daligwen-gaka-bisgise nibgued.","poem":3},{"text":"We-mor-dummagan mor-dummagan-neg-imbagi-nanaidyob-dungu imaklesad.","poem":1}]},{"type":"verse","number":19,"content":[{"text":"E-buarmar, walabake gued,","poem":2},{"lineBreak":true},{"text":"e-sigmalad, gwabakebalid.","poem":2},{"lineBreak":true},{"text":"Wemar, esgoro-gordikidgi sobaled.","poem":2},{"lineBreak":true},{"text":"E-gamalad, e-olua-dummagan manigi sobaled,","poem":2},{"lineBreak":true},{"text":"degi, e-buar-nonomargi, bela manibi matak-matak ebiris naid.","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bab-Dummadse-goled-neg-sunna-seleged-e-bargamalad,","poem":2},{"lineBreak":true},{"text":"degi, neg-imba-e-galu-ebirnaid-e-bargamalad,","poem":2},{"lineBreak":true},{"text":"bela esgoro-gordikidgi sobaled.","poem":2}]},{"type":"heading","content":["Babse-goled-neg-selegedgi ibmarmar-ebulesad"]},{"type":"verse","number":21,"content":["Bab-Dummad-dulemarbo-Igar-Mesisad-neg-sunna-selegedgi ibmarmar-ebulesad ebislesgusad. Leví-e-wagan, Moisés-sogedba ibmar-ebismalaga arbasmalad. Geb Aarón-dule-irwa-Bab-Dummadse-goled-machi-Itamar, ibmarmar-ebislesad narmaksad."]},{"type":"verse","number":22,"content":["Uri-machi-Bezaleel, bela Bab-Jehová igi Moisésʼga sogsagusa, deyob ibmar imaksad. Bezaleel Hur-e-wagwad, dad-dummad-Judáʼgi danikidid."]},{"type":"verse","number":23,"content":["Ahisamac-machi-Aholiab, Bezaleel-bendakega gusad. Aholiab, dad-dummad-Danʼgi danikidid. Aholiabʼde, esgorogi-ibmar-sobed-duled, nabir-ibmar-akar-akar-onogedbalid. Deginbali, nabir we-dubmargi ibmar-sobedbalid:",{"text":"Nirbadub-aradgi,","poem":2},{"lineBreak":true},{"text":"nirbadub-suir-akwagiidgi,","poem":2},{"lineBreak":true},{"text":"nirbadub-ginnidgi,","poem":2},{"lineBreak":true},{"text":"degi, linoʼdub-nuedgi","poem":2},{"text":"mor-yeerdakle sobedid.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Israel-dulemar Bab-Dummad-neg-sunna-selegedgi-ebulegega,","poem":1},{"lineBreak":true},{"text":"Bab-Dummadga-or-uksamalad, bela ebusmalad.","poem":1},{"text":"Nibir-milibo gaka dulabakebak-gakambe-gakatar (2,195), ebusmalad.","poem":2},{"text":"Bab-Dummad-neggi nibirgi-ibmar-wilubsalegedba imaksamalad.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Dulemar-bukwad-ebislesadba,","poem":1},{"text":"e-mani, nibir-miligugle gaka dulataled-ilatar gaka dulabo-gakambe (7,550) gusad.","poem":2},{"text":"Bab-Dummad-neggi nibirgi-ibmar-wilubsalegedba imaksamalad.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Bela-dulemar-birga-dulagwen-gaka-nikmaladi (20+),","poem":1},{"text":"mili-dulataled-ilanergwa-gakapaa gaka dulataled-ilatar gaka dulabo-gakambe-mergu (603,550) daklealid.","poem":2},{"text":"Wemala, e-dule-irba mani-gramo-nergwa uksamalad.","poem":3},{"lineBreak":true},{"text":"Bab-Dummad-neggi nibirgi-ibmar-wilubsalegedba imaksamalad.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Deginbali, Bab-Dummadse-goled-negga e-sigmalad-sobega,","poem":1},{"lineBreak":true},{"text":"degi, mor-dummad-naidga e-sigmalad-sobega,","poem":1},{"text":"mani, nibir-miligugle gaka dulataled-ilatar (7,500) ebulesbalid.","poem":2},{"text":"E-siged-dulatargi (100),","poem":1},{"text":"mani, nibir-miligugle gaka dulataled-ilatar (7,500) ebulesad.","poem":2},{"text":"Degisoggu, e-siged-iliba nibir-dulapaa-gakambe-gakatar (75) ebulesad.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Mani-gwabgusadgindi buarmar-gamalad sobsad,","poem":2},{"lineBreak":true},{"text":"Degine, buar-e-nonomar, degi, e-olua-dummagan sobsabalid.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Dulemar esgoro-gordikid nibir-miliatar gaka dulataled-ilapaa gakambe (5,310) uksamalad.","poem":1}]},{"type":"verse","number":30,"content":[{"text":"We-esgoro-gordikidgi Bab-Dummadse-goled-neg-sunna-seleged-e-yawagak-siged,","poem":2},{"lineBreak":true},{"text":"degine, Bab-Dummadga-ibmar-ogumaker-ukleged-aila, sobsamarbalid.","poem":2},{"lineBreak":true},{"text":"Agine, san-nared-saki-sakid sobsamarbalid,","poem":2},{"lineBreak":true},{"text":"degine, a-ailagi-ibmar-ebulemalad bela sobsamarbalid.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Amba Bab-Dummadse-goled-neg-sunna-seleged-e-sigmalad,","poem":1},{"lineBreak":true},{"text":"e-yawagak-e-sigmalad esgoro-gordikidgi sobsamalad.","poem":1},{"text":"Degine, bela a-neg-bargamalad,","poem":2},{"lineBreak":true},{"text":"degi, bela e-galu-bargamalad-dikarba-gwigwismalad,","poem":2},{"lineBreak":true},{"text":"esgoro-gordikidgi sobsamarbalid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EXO/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EXO/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EXO/37.json","previousChapterAudioLinks":{},"numberOfVerses":31}