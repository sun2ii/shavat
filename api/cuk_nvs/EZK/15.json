{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EZK","translationId":"cuk_nvs","name":"Ezequiel","commonName":"Ezequiel","title":"EZEQUIEL-GARDA EZEQUIEL","order":26,"numberOfChapters":48,"sha256":"313f96fc947fbc532b428727a490a50ff353ae6d86b0b8345a24e553fa5e5cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/cuk_nvs/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":15,"content":[{"type":"heading","content":["Jerusalénʼginmalad uva-dub-isganayob gued"]},{"type":"verse","number":1,"content":["Bab-Jehová anga sogded:"]},{"type":"verse","number":2,"content":[{"text":"“Dule-machi, ¿ibigine, uva-dub-e-saila, sapi-bamalad-e-sailamarba bur-nuedi?","poem":1},{"text":"¿Uva-dub-e-wala, sapi-bamalad-abargi ibuga gumoga?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-uva-dub-e-saila ibmar-sobega gusulid,","poem":1},{"text":"ibmar-nasikega gusurbalid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unnila sapanga gued.","poem":1},{"text":"Ar e-dukumar gummaksale,","poem":2},{"text":"e-gwaa sogunga-gusale,","poem":1},{"text":"¿ibmarga guo be ebinsae?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar amba yoo gummakubela, ibmarga gussulid.","poem":1},{"text":"Emi-bulesunna, ¿sunna bar ibmarga guosi? Geg bar ibmarga gue.”","poem":2}]},{"type":"verse","number":6,"content":["Degisoggu, Bab-Jehová-Bela-Gangued-Nikadi weyob soged:",{"text":"“Ar igi uva-dub-e-saila, soogi gummakega mellege,","poem":1},{"text":"deyobi, an Jerusalén-e-dulemar imakmogoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An wemarbo urwoed.","poem":1},{"text":"Amba soogi wakinmalo-inigwele, ar soo-baidse gummakmaloed.","poem":2},{"text":"Ar an wemarbo ulusale, bemar wisgumaloed,","poem":1},{"text":"ani an Bab-Jehová gue.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E-yala nega-dulesulidganga an imakoed, ar angi nosmalad.","poem":1},{"text":"Ani an Bab-Jehová-Bela-Gangued-Nikadi weyob soged.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EZK/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EZK/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EZK/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}