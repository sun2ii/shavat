{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EZK","translationId":"cuk_nvs","name":"Ezequiel","commonName":"Ezequiel","title":"EZEQUIEL-GARDA EZEQUIEL","order":26,"numberOfChapters":48,"sha256":"313f96fc947fbc532b428727a490a50ff353ae6d86b0b8345a24e553fa5e5cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/cuk_nvs/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Israel-sapin-dummaganga wile-itoged"]},{"type":"verse","number":1,"content":["Bab-Jehová sogdebalid: “Israel-sapin-dummaganga, we-wile-itoged be soge:"]},{"type":"verse","number":2,"content":[{"text":"‘Be-nandi, achumigur-nono-wawaadmar-abargi,","poem":1},{"text":"achumigur-nono-wawaad-omeyob guenad.","poem":2},{"text":"Achumigur-nono-wawaad-e-burwigan-abargi-mai,","poem":1},{"text":"e-mimmigan-onumadaed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na e-mimmi-wargwendi, odummosad,","poem":1},{"text":"wedi achumigur-nono-wawaad gadi-urwedga gunonikid,","poem":2},{"text":"e-mas-ichimaked durdaksad,","poem":1},{"text":"dule-gunned durdaksabalid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dulemar-yar-baid-baidgi-bukwamaladi, achumigur-e-wilub-obichadaed itosmalad,","poem":1},{"text":"geb yamo-yardakar achumigur-gasmalad,","poem":2},{"lineBreak":true},{"text":"geb Egipto-yarse, esgoro-dubgi edinnar sesmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"” ’Ar achumigur-nono-wawaad-ome, e-mimmi bar ese nonikosur daksoggu, e-mimmi-baid odummosbalid,","poem":1},{"text":"geb achumigur-nono-wawaad-ursilidga imaksad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ar we-achumigur-nono-wawaad gangued-nika gunonigua, e-sordamar-bamalad-abargi dobsuli nanadii gusad.","poem":1},{"text":"Na e-mas-ichimaked durdaksad, dule-gunned durdaksabalid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Reynegmar omukusad, neggweburmar obelosad.","poem":1},{"text":"E-uurmakedba bela dulemar-ogwayedii gusad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dulemar-yar-baid-baidgi-bukwamaladi, degi, dikarba neggwebur-baigan bukwamaladi,","poem":1},{"text":"achumigurgi gwisguarmalad.","poem":2},{"text":"Yardakega e-idu galeged sobsamalad,","poem":1},{"text":"geb yaa-ollor-gwisaledgi galessunnad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Galu-yaba esgoro-dubgi edinnar-sii Babilonia-e-reyse sesmalad.","poem":1},{"text":"Israel-yalaganba melle bar e-uurmaked-itolegega, galu-yaba-sii sesmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"” ’Be-nan uva-digaled-abargi uva-dubyobi, dii-dikarba digar-gwichi gusad.","poem":1},{"text":"Ar bela-bela dii-sugwissoggu, yaisur-sanmakgwichi gusad,","poem":2},{"lineBreak":true},{"text":"yaisur-aramakgwichi gusbalid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E-anagan gandikidba-dutusuli-gumai gusad,","poem":1},{"text":"reymar-e-suar-gaapoledga gusad.","poem":2},{"text":"Bela-belad bipisuli gusad.","poem":1},{"text":"Bela-belad muamakgwichi gusad.","poem":2},{"text":"E-matusulidbali dulemar magar daksamalad.","poem":1},{"text":"E-anagan-gandikidbali dulemar magar daksamalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Degi-inigwele, urwedgine sabsur-unnulesad,","poem":1},{"text":"napagi balimetemalad.","poem":2},{"text":"Dad-nakwedsik-burwa-uereged-goledi, uva-dub-odinnosad,","poem":1},{"text":"dulemala e-san-nanaid wesmalad.","poem":2},{"text":"E-anagan-dutusurmalad bela dinare gusad,","poem":1},{"text":"geb soose ogumaklessunnad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Emigindi, we-uva-dub nega-dulesulidganba,","poem":1},{"text":"napa-dinnaregedgi, dii-satedgi, digar gwichid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"E-ana-wargwengi soo gaded,","poem":1},{"text":"we-soo e-sanmar ogumaksad.","poem":2},{"text":"E-anagan-dutusurmalad rey-e-suarmarga-guega,","poem":1},{"text":"bar gwen bessulid.’","poem":2},"”We-namakedi, wile-itogedid. Degisoggu, wile-itogedgi weyob namaklegergebed.”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}