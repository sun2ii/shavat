{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EZK","translationId":"cuk_nvs","name":"Ezequiel","commonName":"Ezequiel","title":"EZEQUIEL-GARDA EZEQUIEL","order":26,"numberOfChapters":48,"sha256":"313f96fc947fbc532b428727a490a50ff353ae6d86b0b8345a24e553fa5e5cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/cuk_nvs/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["Tiro-e-reygi-ibmar-guoed, iduakwaa-soglenaid"]},{"type":"verse","number":1,"content":["Bab-Jehová anga sogded:"]},{"type":"verse","number":2,"content":["“Dule-machi, Tiro-e-reyga be soge: Bab-Jehová-Bela-Gangued-Nikadi weyob sogye:",{"text":"‘Be-gwagegi na be san-dummarba-itogedba sogsagusad:","poem":1},{"text":"Ani an bab-dummadye.","poem":2},{"lineBreak":true},{"text":"Muu-billiganbali bab-dummagan-e-rey-gangi an siiye.","poem":2},{"text":"Ar bab-dummadyob na be ito-inigwele, ar bedi bab-dummad-sulid.","poem":1},{"text":"¡Unnila be dule gued!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Ar Danielʼba bur be binsaed-ibedsi?","poem":1},{"text":"¿Ar ibmar-dukuar-mamaid be bela wissi?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Be-binsaed-nika-guedba, be-ibmar-nue-wisidba, ibmar-nuegan bukidar be nikad.","poem":1},{"text":"Be-ulugwagine or-bukidar, mani-bukidar be sabosad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mani-onogedgi-arbaedi, be nue-wisid,","poem":1},{"text":"a-ulale, mani-ibedga be gunonikid.","poem":2},{"lineBreak":true},{"text":"Bukidar be-ibmar-nuegan-nikadba san-dummarba be imaked.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”A-ulale, ani Bab-Jehová-Bela-Gangued-Nikadi weyob soged:","poem":1},{"text":"‘Emide, bab-dummadyobi na be nue-ibmar-wisi imaked.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A-ulale, dulemar-ainebarmalad begi duurmakdagega an imakoed.","poem":1},{"text":"Dulemar-yar-baid-baidgi-bukwamalad-bur-isganamar an begi barmidagoed.","poem":2},{"text":"We-dulemala, es-suidgi be-ogilogoed,","poem":1},{"text":"be-yeerdakleged, be-nue-binsaed-nikad obelogoed,","poem":2},{"lineBreak":true},{"text":"degi, be-nug-dummarba-nikad oichomaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Napa-yaba be-balimetemaloed,","poem":1},{"text":"muu-billigine, sabsur be burgoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dulemar-be-oburgwemaloed-asabin, ¿amba be sogoe: Ani an Bab-Dummadye?","poem":1},{"text":"Ar dulemar-be-gindakmaladga bab-dummadga be guosulid,","poem":2},{"lineBreak":true},{"text":"unnila be dule gued.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dulemar-ainebarmalad sabsur-be-imakmaloed,","poem":1},{"text":"dulemar-aku-an-dakedyob be burgoed.","poem":2},{"lineBreak":true},{"text":"Ar ani Bab-Jehová-Bela-Gangued-Nikadi, weyob soged.’ ”","poem":2}]},{"type":"verse","number":11,"content":["Bab-Jehová anga sogded:"]},{"type":"verse","number":12,"content":["“Dule-machi, Tiro-e-reyga wile-itoged-namaklegedgi be namake, ega be soge, Bab-Jehová-Bela-Gangued-Nikadi weyob sogye:",{"text":"‘Innikigwad-e-wilubga be guenad,","poem":1},{"text":"nue-binsaed-nikadae be guenad,","poem":2},{"lineBreak":true},{"text":"yeerdaklege be guenad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Dummad-nainu-Edénʼye-nugadgi, be galagwensuli-akwamar uniryeerdaklemalad,","poem":1},{"text":"a yeerdaklemalad-nai gudii gusanad:","poem":2},{"lineBreak":true},{"text":"Akwa-Cornerinaʼye-nugad,","poem":2},{"lineBreak":true},{"text":"akwa-Topacioʼye-nugad,","poem":2},{"lineBreak":true},{"text":"akwa-arad-Jaspeʼye-nugad,","poem":2},{"lineBreak":true},{"text":"akwa-Crisólitoʼye-nugad,","poem":2},{"lineBreak":true},{"text":"akwa-Beriloʼye-nugad,","poem":2},{"lineBreak":true},{"text":"akwa-Óniceʼye-nugad,","poem":2},{"lineBreak":true},{"text":"akwa-Zafiroʼye-nugad,","poem":2},{"lineBreak":true},{"text":"akwa-Carbuncloʼye-nugad,","poem":2},{"lineBreak":true},{"text":"akwa-Esmeraldaʼye-nugad,","poem":2},{"lineBreak":true},{"text":"degine, ormar.","poem":2},{"text":"We-akwa-nuegan-nai be aibirdii gusanad.","poem":3},{"text":"Be-dukargi-nagued, be-sakwagi-nagued, degi, be-uaduki-nagued bela orgi soblesadbiid.","poem":1},{"text":"Be-obinnilesad-akale, we-ormar bega guagwar-dakles bukwa gusad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Baliwitur-querubinʼga an be-nug-imaksad,","poem":1},{"text":"Emar-bendakedga be gwisgusad.","poem":2},{"text":"Bab-Dummad-yar-islidikidgi an be-ogwichisad.","poem":1},{"text":"A-yargi be gudii gusanad,","poem":2},{"lineBreak":true},{"text":"soo-akwamar-birgi be nanadii gusanad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Be-obinnilesad-iba-akale, geb isgued be-ulubgi-nai daklenonikidse,","poem":1},{"text":"be-daedi innikigwadbiinad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Be ibmar-manigi-uked-bukidar-nikadba, sabsur-emar-imakde gusad, degi, isgudegusad.","poem":1},{"text":"A-ulale, Bab-Dummad-yargi ibmar-isganayob an be-onosad.","poem":2},{"text":"Be, baliwitur-querubin-guedi, degi, dulemar-bendakedi,","poem":1},{"text":"soo-akwamar-abargi bar gudii an be-imaksasulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Be-yeerdakleged-ulale, be san-dummarba imaksad.","poem":1},{"text":"Be-nug-dummarba-nikad-ulale, be-binsaed-nikadaed be oichosad.","poem":2},{"text":"A-ulale, napnegse an be-balimeted,","poem":1},{"text":"degi, reymar-asabin-bingegu-gwichi an be-imaksad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bela-bela be-isgusad-ulale, be-mani-onogedgi-isgusad-ulale, be-bab-dummadse-goled-negmar be oichosad.","poem":1},{"text":"A-ulale, an be-abargi soo ogasad,","poem":2},{"lineBreak":true},{"text":"adi, bela be-ogumaksad.","poem":2},{"text":"Bela dulemar-yeer-be-dakmalad-wagab an napagi be-balimeted,","poem":1},{"text":"geb burubi-sii an be-imaksad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bela dulemar-yar-baid-baidgi-bukwamalad-magar-be-dakmaladi, be-dakarmalale, dobgus bukusdamalad.","poem":1},{"text":"Ar bato be bela-bela bergus siid,","poem":2},{"lineBreak":true},{"text":"bar be daklegosulid.’ ”","poem":2}]},{"type":"heading","content":["Sidón-neggweburgi-ibmar-guoed iduakwaa-soglenaid"]},{"type":"verse","number":20,"content":["Bab-Jehová anga sogded:"]},{"type":"verse","number":21,"content":["“Dule-machi, Sidón-neggwebursik be atake, egi ibmar-guoed iduakwaa be soge."]},{"type":"verse","number":22,"content":["Bab-Jehová-Bela-Gangued-Nikadi weyob sogye, ega be soge:",{"text":"‘Sidón-neggwebur, an begi yolegega an wegi gwichi,","poem":1},{"text":"an be-abargi nug-dummarbaa guoed.","poem":2},{"text":"Igar-maidba an sabsur-be-odurdakalile, degi, an-isligwaled an begi oyoalile, wisgumaloed,","poem":1},{"text":"ani an Bab-Jehová gue.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"” ’Uelleged-dummad an begi barmidagoed,","poem":1},{"text":"be-igarba ablis suurmakmai guoed.","poem":2},{"text":"Es-suidgi girgulenanaid-ulale, be-igarba dulemar-nailikgusmalad burgwemai gumaloed.","poem":1},{"text":"Degidbali, wisgumaloed, ani an Bab-Jehová gue.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"” ’Dulemar-e-yar-dikarba-bukwamaladse Israel-dulemar bar isdar-daklegosulid.","poem":1},{"text":"Israel-dulemar, we-isdar-dakleged esgoro-swichwigwadgi maklesadyob nunmaked-itomalad, bar itogosulid.","poem":2},{"text":"Degi, ikogi sikaa-gusayob-itoleged, bar itogosulid.","poem":1},{"text":"Degidbali wisgumaloed, ani an Bab-Jehová-Bela-Gangued-Nikadi, gue.’ ”","poem":2}]},{"type":"verse","number":25,"content":["Bab-Jehová-Bela-Gangued-Nikadi weyob soged: “Ar Israel-dulemar yar-baid-baidse-oaisakiles-gusmalad, an gannar danar-oambikusale, an-isligwaled, dulemar-yar-baid-baidgi-bukwamalad-wagab an ega oyogoed. Geb degine, Israel-dulemar na e-yargi gudii gumaloed. We-yardi, an-mai-Jacobʼga an uksa gusad."]},{"type":"verse","number":26,"content":["A-yargine, dobgued-sate gudimaloed, negmar sobmaloed, uvaʼmar digmaloed, ar ade, dulemar-e-yar-dikarba-bukwamalad, Israel-dulemar-isdar-dakdimalad, igar-maidba an sabsur-odurdakoed. Wisgumaloed, ani an e-Bab-Dummad-Jehová gue.”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}