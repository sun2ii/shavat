{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EZK","translationId":"cuk_nvs","name":"Ezequiel","commonName":"Ezequiel","title":"EZEQUIEL-GARDA EZEQUIEL","order":26,"numberOfChapters":48,"sha256":"313f96fc947fbc532b428727a490a50ff353ae6d86b0b8345a24e553fa5e5cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/cuk_nvs/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"heading","content":["Egipto-yar-ulale nunmak-itoged"]},{"type":"verse","number":1,"content":["Bab-Jehová anga sogded:"]},{"type":"verse","number":2,"content":["“Dule-machi, ibmar-guoed iduakwaa be soge:",{"text":"‘Bab-Jehová weyob soged:","poem":1},{"text":"Nunmakedba binnasuli-gormala:","poem":2},{"lineBreak":true},{"text":"¡A-ibagi nunmaked-dummad naguoed!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An-iba warmakdanikid,","poem":1},{"text":"a-iba bato omodanikid.","poem":2},{"text":"Negasichid-iba omosad,","poem":1},{"text":"dulemar-yar-baid-baidgi-bukwamaladga sabsur-odurdakleged-iba omosad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Egipto-yargi bila-onoged danikoed,","poem":1},{"text":"Etiopía-yargi surbinsa-itoged naguoed.","poem":2},{"text":"Bukidar Egipto-dulemar-oburgwilesmalale, e-ibe ibmar-nuegan atursalegoed,","poem":1},{"text":"e-negsaila-mamaid bibisgoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"” ’Etiopía-dorgan, Fut-dorgan, Lud-dorgan,","poem":2},{"lineBreak":true},{"text":"bela Arabia-dorgan, Libia-dorgan,","poem":2},{"lineBreak":true},{"text":"degi, yarmar-eba-nanaid-e-dulemar,","poem":2},{"text":"es-suidgi burgwemaloed.’ ”","poem":3}]},{"type":"verse","number":6,"content":["Bab-Jehová weyob soged:",{"text":"“Egipto-yar-bendakdimalad bergumaloed,","poem":1},{"text":"Egipto-e-gangued san-dummarba-imaked berguoed.","poem":2},{"text":"Migdol-akar, Seveneʼse es-suidgi burgwemaloed,","poem":1},{"text":"ani Bab-Jehová-Bela-Gangued-Nikadi, weyob soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”E-neggweburmar akwamarbi-ganna-ganna-bukwa guoed.","poem":1},{"text":"Bela yarmar-baiganba bur bule nega-dulesulidganga guoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"An Egipto-yargi soo ogadele, degi, bela yarmar-eba-nanaimalad bergusale, wisgumaloed,","poem":1},{"text":"ani an Bab-Jehová gue.","poem":2}]},{"type":"verse","number":9,"content":["”A-ibagine, an-gayaburba-berbemaladi, Etiopía-dorgan-dobe-itobuksulid-ogwayega, ur-dummagangi ainidmaloed. Egipto-dorgan-sabsur-odurdaklegoed-ibagi, Etiopía-dorgan dummad-gwayemarmogoed. A-iba bato omodanikid."]},{"type":"verse","number":10,"content":[{"text":"Ani Bab-Jehová-Bela-Gangued-Nikadi, weyob soged:","poem":1},{"text":"‘Babilonia-rey-Nabucodonosor, Egipto-ibmar-nuegan-nikad-obelogega an imakoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nabucodonosor, degi, e-sordagan-bila-onomalad, dulemar-yar-baid-baidgi-bukwamaladba bur dule-bulegan gumalad,","poem":1},{"text":"amar Egipto-yar obergunonimaloed.","poem":2},{"text":"Amar es-suidgi Egipto-dorgan-ogilononimaloed,","poem":1},{"text":"Egipto-yargi, muimar-ena metemaloed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"An Nilo-dianmar odinguoed,","poem":1},{"text":"degi, dule-isganamarga an Egipto-yar ukoed.","poem":2},{"text":"Dule-ainebarmalad Egipto-yar, degi, egi-ibmar-bukwamalad-oberguega an imakoed.’","poem":1},{"text":"Ani an Bab-Jehová weyob soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Bab-Jehová-Bela-Gangued-Nikadi, weyob soged: ‘Bela Menfis-e-nuchumar an obelogoed,","poem":1},{"text":"e-bab-dummadyob-ibmarmar-imakleged an osulogoed.","poem":2},{"text":"Egipto-yar bar rey nikuosulid,","poem":1},{"text":"bela Egipto-yargi dobed-dummad an nasikoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"An Patros-neggwebur obelogoed,","poem":1},{"text":"an Zoán-neggwebur soogi ogumakoed,","poem":2},{"lineBreak":true},{"text":"an Tebas-neggwebur sabsur-odurdakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"” ’Sin-neggwebur Egipto-yar-e-ganguedga-siidi, an-urwed itogoed.","poem":1},{"text":"Tebas-neggwebur-e-ibmar-nuegan-nikad an obelogoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Egipto-yar an soogi ogumakoed,","poem":1},{"text":"Sin-neggwebur nunmaked-dummad itogoed.","poem":2},{"text":"Tebas-neggwebur-e-galu-matusur-maidgi yaamar olloo sigoed.","poem":1},{"text":"Menfis-neggwebur bali-bali wile-itosii guoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Avén-neggwebur-sapingan, degi, Pibeset-neggwebur-sapingan es-suidgi burgwemaloed,","poem":1},{"text":"e-omegandi, gales-ebipiledmaloed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Egipto-yar-e-gangued an obelosale, Tafnesʼgi negsichid naguoed.","poem":1},{"text":"Deyobi, na e-gargangued san-dummarba-imaked bergunonikoed.","poem":2},{"text":"Egipto-yar negsichidbi naguoed,","poem":1},{"text":"e-bunamala gales ebipiledmaloed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Weyob Egipto-yar sabsur-odurdaklegoed.","poem":1},{"text":"Geb degidbali, Egipto-dulemar na wisgumaloed, ani an Bab-Jehová gue.’ ”","poem":2}]},{"type":"verse","number":20,"content":["Deunni, anmar birgambe-gakagwensakgus gaka nii-wargwenad-ibaguglegus Babiloniaʼgi-bukwadgine, Bab-Jehová weyob anga sokalid:"]},{"type":"verse","number":21,"content":["“Dule-machi, bato an Egipto-rey-Faraón-ibe sakwa-wargwen bichisad. E-sakwa gannar ganguega, degi, sunna gannar es-suid gaega, dule gwen ega e-sakwa morgi inaba-mesa obipirmassulid, deginbali, ega suarba-mesa edichasurbalid."]},{"type":"verse","number":22,"content":["A-ulale, Bab-Jehová-Bela-Gangued-Nikadi weyob soged: ‘Egipto-rey-Faraónʼgi an gwichid. E-sakwa-nued, e-sakwa-bato-bisgaled, warbobela an e-ibe bisgoed, degi, e-argangi es-suid-argwanega an imakoed."]},{"type":"verse","number":23,"content":["Egipto-dorgan dulemar-yar-baid-baidgi-bukwamaladse an oaisakioed, yar-baid-baidse an oduurmakoed."]},{"type":"verse","number":24,"content":["Babilonia-rey-e-gargangued an ogannogoed, an-es-suid e-argangi an mesoed. Faraón-e-sakwamar an bibisgoed. Geb dule-nailikgusad burgwedani-akiginmaidyob e-isdarad-asabin nunmakedba akiginnoed."]},{"type":"verse","number":25,"content":["Babilonia-rey-e-gargangued an ogannogoed. Faraón-e-gargangueddi an nolloo imakoed. Babilonia-rey-e-argangi an-es-suid an mesisale, geb agi Egipto-dulemar-ogilosale, wisgumaloed, ani an Bab-Jehová gue."]},{"type":"verse","number":26,"content":["Egipto-dorgan dulemar-yar-baid-baidgi-bukwamaladse an oaisakioed, yar-baid-baidse an oduurmakoed. Geb degine, wisgumaloed, ani an Bab-Jehová gue.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}