{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EZK","translationId":"cuk_nvs","name":"Ezequiel","commonName":"Ezequiel","title":"EZEQUIEL-GARDA EZEQUIEL","order":26,"numberOfChapters":48,"sha256":"313f96fc947fbc532b428727a490a50ff353ae6d86b0b8345a24e553fa5e5cd2","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/cuk_nvs/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":7,"content":[{"type":"heading","content":["Neg-bergued-mosad"]},{"type":"verse","number":1,"content":["Bab-Jehová anga sogded:"]},{"type":"verse","number":2,"content":["“Dule-machi, Bab-Jehová-Bela-Gangued-Nikadi Israel-dulemarga weyob-sogye be soge:",{"text":"‘¡Neg-bergued omosad!","poem":1},{"text":"Bela Israel-yar-bergued omosad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Israel-yar, be-bergued omosad,","poem":1},{"text":"an-urwed be-itogoed.","poem":2},{"text":"Be-daedba an bega igar-nabogoed,","poem":1},{"text":"be-ibmar-isgana-imaksadba an sabsur-be-odurdakoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bipisaale, isgussuliyob an be-dakosulid,","poem":1},{"text":"an wile-be-dakosurbalid.","poem":2},{"text":"Be-ichagwadaed-ulale, degi, be-ibmar-isgana-sae-daklemalad-imaked-ulale, an sabsur-be-odurdakoed.","poem":1},{"text":"Degidbali be wisguoed, ani an Bab-Jehová gued.’ ”","poem":2}]},{"type":"verse","number":5,"content":["Bab-Jehová-Bela-Gangued-Nikadi weyob soged:",{"text":"“Sabsur-odurdaklegedi ukin-ukin danikid.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Neg-bergued omosad.","poem":2},{"text":"Israel-yar, be-bergued warmaksad,","poem":1},{"text":"napiragwa, be-bergued warmaksad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israel-dulemar, be-wachi omos.","poem":1},{"text":"Wachimar nae-naegus. Ibagan owarmas.","poem":2},{"text":"Yarmargine, dobegwar neg-itoleged,","poem":1},{"text":"weligwar-itoleged bergusad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"An-sae-itoged bemargi an barmidsokalid,","poem":1},{"text":"an-urwedi bemargi an oyosokalid.","poem":2},{"text":"Be-ibmar-isgana-imakedba an bega igar-nabogoed,","poem":1},{"text":"be-ibmar-isgana-sae-daklemalad-imaksadba an sabsur-be-odurdakoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bipisaale, isgussuliyob an be-dakosulid,","poem":1},{"text":"an wile-be-dakosurbalid.","poem":2},{"text":"Be-ichagwadaed-ulale, degi, be-ibmar-isgana-sae-daklemalad-imaked-ulale, an sabsur-be-odurdakoed.","poem":1},{"text":"Degidbali be wisguoed, ani an Bab-Jehová gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Bato ibagan warmaksad, bato weginbinned.","poem":1},{"text":"Israel-yar, be-ibagan-bergued nonikid.","poem":2},{"text":"Igar-innikigwad-imakleged bar imaklesulid,","poem":1},{"text":"bela san-dummarba-imakedbimalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dule-sabsur-imakleged nasgumaid,","poem":1},{"text":"ibmar-isgana imakedbi neg naid.","poem":2},{"text":"Bemar-ibmarmar gwen bipisaale bar beosulid,","poem":1},{"text":"bemar-ibmar-nuegan, bemar-ibmar-obinebaka-nikadi, gwen bipisaale bar bukuosulid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wachi mosad. Iba warmaknonikid.","poem":1},{"text":"Dule-ibmar-baked, melle be yeer-itoge,","poem":2},{"text":"dule-ibmar-uked, melle be bomoga.","poem":1},{"text":"Ar an-urwed bela Israel-dulemar-sabsur-odurdakoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar dule-ibmar-uked amba dula-beo-inigwele, na ibmar-uksad bar amiosulid.","poem":1},{"text":"Ar dulemar-sabsur-odurdaklegoed-negburgan-daklesad osulolegosulid,","poem":2},{"lineBreak":true},{"text":"na dule-wargwensaale, e-isgued-ular durguosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Ar amba gar-trompeta ogormaloen-inigwele, na guagwar-bukumaloen-inigwele, degite, dule wargwensaale bila-onolegedse naosulid.","poem":1},{"text":"An-urwed bela Israel-dulemar-sabsur-odurdakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Neggwebur-magaba bila-onolenai guoed.","poem":1},{"text":"Neggweburgindi, bonigan-aininai gumogoed.","poem":2},{"lineBreak":true},{"text":"Ukud-dummad-itoged nai guoed.","poem":2},{"text":"Dule sapurba-gudiile, es-suidgi iblolegoed.","poem":1},{"text":"Ar dule amba neggweburgi-gudiile, boniganba burgoed,","poem":2},{"lineBreak":true},{"text":"degi, ukudba burgoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dulemar-durgumaloeddi, wakitemaloed,","poem":1},{"text":"nuu-sibu-sapurbarmaladyob yalaganba gudimaloed,","poem":2},{"lineBreak":true},{"text":"na dukin e-isguedga bodimaloed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bela swidamar nollomakdoed,","poem":1},{"text":"bela malimar dobedbali wawanmakdoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wile-itoged-mor na yomaloed,","poem":1},{"text":"dobed-dummad itodimaloed,","poem":2},{"text":"bela na bingegudimaloed,","poem":1},{"text":"bela na e-sailagia swiri gudimaloed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Igarba e-mani midmaloed,","poem":1},{"text":"ibmar-isganayob, ordi dakdemaloed.","poem":2},{"text":"Bab-Jehová-urwed-ibagi e-mani, degi, e-or gwen e-bendakega guosulid.","poem":1},{"text":"We-ibmar-nuegan e-ukud-itoged ega obelogosulid,","poem":2},{"text":"immerba-imakega guosurbalid.","poem":1},{"text":"Ar olo, emar-isguega imaksad.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Na ormar-yeerdakleged-nikadba, san-dummarbaa imakdemalad.","poem":1},{"text":"A-ormargine, e-bab-dummaganyob-ibmar-imakdimalad sobsamalad.","poem":2},{"lineBreak":true},{"text":"A-ulale, we-ormar an ibmar-isganaga imakoed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Dule-ainebarmalad dagega an imakoed,","poem":1},{"text":"adi, e-ibe ibmar-atursamalagar.","poem":2},{"text":"Dule-isganamar e-ibe ibmar sedmaloed,","poem":1},{"text":"e-ibe ibmar oichomaloed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"We-Israel-dulemargi an bangudoed,","poem":1},{"text":"anse-goled-neg oicholegoed.","poem":2},{"text":"Ar dule-yar-bamaladsikmalad we-yarse ubononikoed,","poem":1},{"text":"anse-goled-neg oichononimaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"”Esgoro-dub guagwar be urbe,","poem":1},{"text":"ar we-yargine, dule-gindakmalad yaisulid,","poem":2},{"lineBreak":true},{"text":"we-neggweburgine, sabsur-emar-imakmalad doggus obichagusad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"E-negmar-suega, dule-bur-isganamaladi an barmidagoed.","poem":1},{"text":"Deyobi, dulemar-gandikmalad na san-dummarba-imakdimaladi, an obelogoed.","poem":2},{"lineBreak":true},{"text":"Deyobi, e-bab-dummaganse-goled-negmar oicholegoed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"¡Dobed-dummad nagunonikoed!","poem":1},{"text":"Neg-bogidikid amimaloenad, degi-inigwele, neg-bogidikid nikuosurmalad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ibagan-sabsur-odurdaklemalad ukin-ukin danikoed,","poem":1},{"text":"gayaburba-isganamar bali-bali itoledagoed.","poem":2},{"text":"Bab-Dummad-gayaburba-barsoged ega negburgan-dakega amimaloenad.","poem":1},{"text":"Ega gwen negburgan dakosulid.","poem":2},{"text":"Dule-irwa-Bab-Dummadse-gormaladi, igar-maidgi geg bar dule-odurdake gumaloed,","poem":1},{"text":"girmar-selegan, binsaed-nuegan bar ukdosurmalad.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Rey, wile-itodoed,","poem":1},{"text":"dummad-negdakmaid, bukib-binsadoed.","poem":2},{"lineBreak":true},{"text":"Dulemar, bela dobee-itodoed.","poem":2},{"text":"E-damaladba an sabsur-odurdakoed,","poem":1},{"text":"e-ibmar-imakedba an ega igar-nabogoed.","poem":2},{"text":"Degidbali wisgumaloed,","poem":1},{"text":"ani an Bab-Jehová gued.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}