{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"EZR","translationId":"cuk_nvs","name":"Esdras","commonName":"Esdras","title":"ESDRAS-GARDA ESDRAS","order":15,"numberOfChapters":10,"sha256":"ee3e4b1efea1faa946af63d667626384d21253ae2e54147470723c7f3357a881","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/EZR/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/cuk_nvs/EZR/10.json","totalNumberOfVerses":280},"chapter":{"number":2,"content":[{"type":"heading","content":["Israel-dulemar gannar e-yarse-nonimalad-e-nugmar"]},{"type":"verse","number":1,"content":["Babilonia-rey-Nabucodonosor, Judá-yargi dulemar-bukidar Babilonia-yarse sesa gusad. Geb a-sorba, ise barmiar Jerusalén-neggweburse imaksad, degi, Judá-yargi neggweburmar-bukwadse barmisbalid. Degine, dulemar na e-neggwebur-e-neggweburse nonigusmalad."]},{"type":"verse","number":2,"content":[{"text":"Dulemar-Zorobabelʼba-nonigusmaladi, wemalad:","poem":1},{"text":"Jesúa, Nehemías, Seraías,","poem":2},{"lineBreak":true},{"text":"Reelaías, Mardoqueo, Bilsán,","poem":2},{"lineBreak":true},{"text":"Mispar, Bigvai, Rehum, Baana.","poem":2},{"text":"Israel-dulemar e-yarse-nonimaladi, wemalad:","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Paros-wagan, milibo gaka dulabaabak-gakambe-gakabo (2,172).","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sefatías-wagan, dulataled-ilapaa gaka dulapaa-gakambe-gakabo (372).","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ara-wagan, dulataled-ilagugle gaka dulapaa-gakambe-gakatar (775).","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Pahat-Moab-wagan, a sogleged, Jesúa-e-waganye, degi, Joab-e-waganye, milibo gaka dulataled-ilabaabak gakambe-gakabo (2,812).","poem":2}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Elam-wagan, miligwen gaka dulataled-ilabo gaka dulabo-gakambe-gakabake (1,254).","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Zatu-wagan, dulataled-ilabakebak gaka dulabo-gakatar (945).","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Zacai-wagan, dulataled-ilagugle gaka dulapaa (760).","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bani-wagan, dulataled-ilanergwa gaka dulabo-gakabo (642).","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bebai-wagan, dulataled-ilanergwa gaka dulagwen-gakapaa (623).","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Azgad-wagan, miligwen gaka dulataled-ilabo gaka dulagwen-gakabo (1,222).","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Adonicam-wagan, dulataled-ilanergwa gaka dulapaa-gakanergwa (666).","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Bigvai-wagan, milibo gaka dulabo-gakambe-gakanergwa (2,056).","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Adín-wagan, dulataled-ilabake gaka dulabo-gakambe-gakabake (454).","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ater-wagan, a sogleged Ezequías-e-waganye, dulabake-gakambe-gakabaabak (98).","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bezai-wagan, dulataled-ilapaa gaka dulagwen-gakapaa (323).","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Jora-wagan, dulatar-gakambe-gakabo (112).","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Hasum-wagan, dulataled-ilabo gaka dulagwen-gakapaa (223).","poem":2}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gibar-wagan, dulabake-gakambe-gakatar (95).","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Belén-neggweburginmalad, dulanergwa-gakapaa (123).","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Netofa-neggweburginmalad, dulabo-gakambe-gakanergwa (56).","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Anatot-neggweburginmalad, dulanergwa-gakabaabak (128).","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Azmavet-neggweburginmalad, dulabo-gakabo (42).","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Quiriat-Jearim-neggweburginmalad, Cafiraʼginmalad, degi, Beerotʼginmalad, dulataled-ilagugle gaka dulabo-gakapaa (743).","poem":2}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Ramá-neggweburginmalad, degi, Gebaʼginmalad, dulataled-ilanergwa gaka dulagwen-gakagwensak (621).","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Micmas-neggweburginmalad, dulanergwa-gakabo (122).","poem":2}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Betel-neggweburginmalad, degi, Haiʼginmalad, dulataled-ilabo gaka dulagwen-gakapaa (223).","poem":2}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Nebo-neggweburginmalad, dulabo-gakambe-gakabo (52).","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Magbis-neggweburginmalad, dulagugle-gakambe-gakanergwa (156).","poem":2}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Elam-neggweburginmalad, miligwen gaka dulataled-ilabo gaka dulabo-gakambe-gakabake (1,254).","poem":2}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Harim-neggweburginmalad, dulataled-ilapaa gaka dulagwen (320).","poem":2}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Lod-neggweburginmalad, Hadidʼginmalad, degi, Onoʼginmalad, dulataled-ilagugle gaka dulagwen-gakatar (725).","poem":2}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Jericó-neggweburginmalad, dulataled-ilapaa gaka dulabo-gakatar (345).","poem":2}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Senaa-neggweburginmalad, milipaa gaka dulataled-ilanergwa gaka dulagwen-gakambe (3,630).","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Dule-irwa-Bab-Dummadse-gormalad-nonimalad, wemalad:","poem":1},{"text":"Jesúa-gwenadgansikid Jedaías-wagan, dulataled-ilabakebak gaka dulapaa-gakambe-gakapaa (973).","poem":2}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Imer-wagan, miligwen gaka dulabo-gakambe-gakabo (1,052).","poem":2}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Pasur-wagan, miligwen gaka dulataled-ilabo gaka dulabo-gakagugle (1,247).","poem":2}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"Harim-wagan, miligwen gakambe-gakagugle (1,017).","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Levita-dulemar-nonimalad, wemalad:","poem":1},{"text":"Jesúa-wagan, degi, Cadmiel-wagan, a sogleged Hodavías-e-waganye, dulapaa-gakambe-gakabake (74).","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Dule-namakmalad-nonimalad, wemalad:","poem":1},{"text":"Asaf-wagan, dulanergwa-gakabaabak (128).","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Bab-Dummadse-goled-neg-yawagak-dakmalad-nonimalad, wemalad:","poem":1},{"text":"Salum-wagan, Ater-wagan, Talmón-wagan,","poem":2},{"lineBreak":true},{"text":"Acub-wagan, Hatita-wagan, degi, Sobai-wagan.","poem":2},{"text":"Amar, dulanergwa-gakambe-gakabakebak (139) mergued.","poem":3}]},{"type":"verse","number":43,"content":[{"text":"Bab-Dummadse-goled-neggi-arbamalad, wemalad:","poem":1},{"text":"Ziha-wagan, Hasufa-wagan, Tabaot-wagan,","poem":2}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"Queros-wagan, Siaha-wagan, Padón-wagan,","poem":2}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"Lebana-wagan, Hagaba-wagan, Acub-wagan,","poem":2}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"Hagab-wagan, Salmai-wagan, Hanán-wagan,","poem":2}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"Gidel-wagan, Gahar-wagan, Reaía-wagan,","poem":2}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"Rezín-wagan, Necoda-wagan, Gazam-wagan,","poem":2}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"Uza-wagan, Paseah-wagan, Besai-wagan,","poem":2}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"Asena-wagan, Meunim-wagan, Nefusim-wagan,","poem":2}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"Bacbuc-wagan, Hacufa-wagan, Harhur-wagan,","poem":2}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"Bazlut-wagan, Mehída-wagan, Harsa-wagan,","poem":2}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"Barcos-wagan, Sísara-wagan, Tema-wagan,","poem":2}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"Nezía-wagan, degi, Hatifa-wagan.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Salomónʼga-arbamalad-e-wagan, wemalad:","poem":1},{"text":"Sotai-wagan, Soferet-wagan, Peruda-wagan,","poem":2}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"Jaala-wagan, Darcón-wagan, Gidel-wagan,","poem":2}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"Sefatías-wagan, Hatil-wagan,","poem":2},{"lineBreak":true},{"text":"Poqueret-Hazebaim-wagan, degi, Ami-wagan.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Bab-Dummadse-goled-neggi-arbamalad-e-wagan, degi, Salomónʼga-arbamalad-e-wagan, bela dulataled-ilapaa gaka dulabake-gakambe-gakabo (392) mergued.","poem":3}]},{"type":"verse","number":59,"content":["Deginbali, dulemar-baigan geg oyo gusmalad, doamar e-dadganmala, degine, emarde bule-nabir Israel-dule-gumarbali.",{"text":"We-neggweburmargi noar gusmalad:","poem":1},{"text":"Tel-Mela-neggweburgi, Tel-Harsa-neggweburgi,","poem":2},{"lineBreak":true},{"text":"Querub-neggweburgi, Addán-neggweburgi,","poem":2},{"lineBreak":true},{"text":"degi, Imer-neggweburgi noarmaladid.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"A-dulemarde, wemalad:","poem":1},{"text":"Delaía-wagan, Tobías-wagan, Necoda-wagan,","poem":2},{"text":"bela dulataled-ilanergwa gaka dulabo-gakambe-gakabo (652) mergued.","poem":3}]},{"type":"verse","number":61,"content":["Dule-irwa-Bab-Dummadse-gormalad abala geg oyo gusmarmogad, doamar e-dadganmala, emarde bule-nabir Israel-dule-gumarbali.",{"text":"Amala, wemalad:","poem":1},{"text":"Habaía-wagan, Cos-wagan, degi, Barzilai-wagan.","poem":2},"Ar ade, dule, Barzilai-Galaadʼgined-e-sisgwa nikus gusad. Degidbali, a-dule e-sakba Barzilaiʼye nuggunonikid, degi, e-wagan Barzilai-waganye bilenonikid."]},{"type":"verse","number":62,"content":["Wemala na e-dadgan-nug amidmargu, amissurgusmalad. Degisoggu, dule-swilidiksulid-soglesadba, dule-irwa-Bab-Dummadse-goledga onolesmalad."]},{"type":"verse","number":63,"content":["Degidgine, dule-dummadga-negdakmaid igar-uksad, we-dulemar melle Bab-Dummadga-ibmar-ukleged gunnamaloye, dule-irwa-Bab-Dummadse-goled-gwensak, Urimʼba, degi, Tumimʼba Bab-Dummadse idakedseye."]},{"type":"verse","number":64,"content":["Bela dulemar dule-wargwennayob danar-ambikunonimaladi mili-dulabo-gakabo gaka dulataled-ilapaa gaka dulapaa (42,360) mergued."]},{"type":"verse","number":65,"content":["Wemar-abargi e-mai-machergan, degi, e-mai-omegan, miligugle gaka dulataled-ilapaa gaka dulagwen-gakambe-gakagugle (7,337) mergueddi obarlesulid. Degine, e-namakmalad-machergan, e-namakmalad-omegan, dulataled-ilabo (200) mergu-nikaddi obarlesurbalid."]},{"type":"verse","number":66,"content":[{"text":"A-ukinbali, dulemar-gannar-nonimaladi, ibmar-durgan-ibmar-semalad, weyob nikamalad:","poem":1},{"text":"Moli, dulataled-ilagugle gaka dulagwen-gakambe-gakanergwa (736).","poem":2},{"lineBreak":true},{"text":"Moli-uaya-senigwadmar, dulataled-ilabo gaka dulabo-gakatar (245).","poem":2}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"Moli-yargan-muremalad, dulataled-ilabake gaka dulagwen-gakambe-gakatar (435).","poem":2},{"lineBreak":true},{"text":"Moli-uayasuid, milinergwa gaka dulataled-ilagugle gaka dulagwen (6,720) nikamalad.","poem":2}]},{"type":"verse","number":68,"content":["Gwenna-gwenna babgan-neguya-sedimaladi, Jerusalén-neggweburgi Bab-Jehováʼse-goled-neg-siidse nonimalad. Agine, na e-binsaed-e-binsaedba ibmar-nuegan Bab-Dummadse-goled-negga uksamalad, adi, Bab-Jehováʼse-goled-neg gebe-iduar-sii-gusadgi gannar sobegar."]},{"type":"verse","number":69,"content":["Degine, dulemar e-ganguedba, Bab-Dummadse-goled-neg-soblenaid-e-mani-dakedga ibmar uksamalad.",{"text":"A-ibmarmar wemalad:","poem":1},{"text":"Or, nibir-miligwen gaka dulatar aidiku (1,100) uksamalad.","poem":2},{"lineBreak":true},{"text":"Mani, nibir-milinergwa aidiku (6,000) uksamarbalid.","poem":2},{"lineBreak":true},{"text":"Degine, dule-irwa-Bab-Dummadse-gormalad-e-mormar, goadulatar (100) uksamarbalid.","poem":2}]},{"type":"verse","number":70,"content":["Degine, dule-irwa-Bab-Dummadse-gormaladi, Levita-dulemar, dule-namakmaladi, degine, dulemar-bamaladi, Jerusalénʼgi megismalad. Degi, dule-yawagak-dakmaladi, dule-Bab-Dummadse-goled-neggi-arbamaladi, e-neggwebur-e-neggweburgi megismalad. Degine, bela Israel-dulemar-baigan na e-neggwebur-e-neggweburgi megis nanaed."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/EZR/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/EZR/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/EZR/1.json","previousChapterAudioLinks":{},"numberOfVerses":70}