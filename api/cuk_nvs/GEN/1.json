{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"GEN","translationId":"cuk_nvs","name":"Génesis","commonName":"Génesis","title":"GEBE-SAILAGWAD-GARDA GÉNESIS","order":1,"numberOfChapters":50,"sha256":"5e80deca1ef0d4dbf4bafa1bc04ba8824097a8063e694f37691e05acbd11904b","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cuk_nvs/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":1,"content":[{"type":"heading","content":["Bab-Dummad nibneg, napnegbo obinnisad-igar"]},{"type":"verse","number":1,"content":["Bab-Dummadi, gebe-negasailaunni, nibneg, napneg obinnisad."]},{"type":"verse","number":2,"content":[{"text":"Deunni, napneg gwen nabir-daklesulid, neg olloo-dakleged,","poem":1},{"text":"unnila dii-wilasailad-birgi negsichidbi naid.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-Burbadi dii-birgi aibannaid.","poem":2}]},{"type":"verse","number":3,"content":["Geb degine, Bab-Dummad sogded:",{"text":"“Neg-meegwad nagu.”","poem":1},{"text":"Agi, neg-meegwad nagunonikid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Geb Bab-Dummad dakded, neg-meegwad, ibnuedi.","poem":1},{"text":"Agi, Bab-Dummad neg-meegwad, negsichid-ebo bachikii imaknonikid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad neg-meegwad ibginedye onug-imaksad.","poem":1},{"text":"Negsichiddi mutikidye onug-imaksad.","poem":2},{"text":"Weyob neg osedosad, geb neg oibosbalid.","poem":1},{"text":"Deyob, ibagwenadgi neg gusad.","poem":3}]},{"type":"verse","number":6,"content":["Geb degine, Bab-Dummad sogdebalid:",{"text":"“Neg-ollor-dummad nagu,","poem":1},{"text":"adi, diimar bachikii naguegar.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Deyobi, Bab-Dummad neg-olloled-dummad nasiksad.","poem":1},{"text":"Neg-ollor-dummad-birgi dii nagunonikid,","poem":2},{"text":"degi, neg-ollor-dummad-urba dii nagunonibalid.","poem":1},{"text":"Deyob gunonikid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad a-neg-olloled-dummad mogir-aradye onugsasad.","poem":1},{"text":"Weyob neg osedosad, geb neg oibosbalid.","poem":2},{"text":"Deyob, ibabogwadgi neg gusad.","poem":3}]},{"type":"verse","number":9,"content":["Geb degine, Bab-Dummad sogdebalid:",{"text":"“Dii-mogir-arad-urba-naid bachiki nagu,","poem":1},{"text":"adi, neg-dinnagwad naguegar.”","poem":2},{"lineBreak":true},{"text":"Deyob gunonikid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bab-Dummad, neg-dinnagwad, napaye onugsasad.","poem":1},{"text":"Geb diidina, demarye onugsanonikid.","poem":2},{"text":"Geb Bab-Dummad dakded, we-ibmar bela nueganbi.","poem":1}]},{"type":"verse","number":11,"content":["Agi, Bab-Dummad sogdebalid:",{"text":"“Bela ibmar-durbamar napagi nagu:","poem":1},{"text":"Gaganmar-gwag-nikad ambikumar,","poem":2},{"text":"degine, akar-akar sapi-sunna-sanmakmalad, e-sangi gwag-nika gusun.","poem":1},{"text":"Ibmar-durbamar akar-akar bela na egad-egad-balibimaladba ambikumarsun.”","poem":2},{"lineBreak":true},{"text":"Deyob gunonikid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Geb napagi ibmar-durbamar nagunonikid:","poem":1},{"text":"Gaganmar-gwag-nikamalad bela na akar-akar egad-egad-balibimaladba,","poem":2},{"text":"degi, sapimar-e-sangi-gwag-nikumalad","poem":1},{"text":"bela akar-akar na egad-egad-balibimaladba ambikunonimalad.","poem":2},{"text":"Bab-Dummad dakdebalid, we-ibmar bela nueganbi.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Weyob neg osedosad, geb neg oibosbalid.","poem":2},{"text":"Deyob, ibapaagwadgi neg gusad.","poem":3}]},{"type":"verse","number":14,"content":["Geb degi, Bab-Dummad sogdebalid:",{"text":"“Nibneggi gwallumar nagu,","poem":1},{"text":"adi, neg-mutikid, neg-ibgined-ebo bachikii guegar.","poem":2},{"text":"Adi, ibagan-nagumaid, yolamar-nagumaid, birgamar-nagumaid magar daklegegar.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"Degi, gwallumar-niba-naid napneg-mee saegar.”","poem":2},{"lineBreak":true},{"text":"Deyob gunonikid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bab-Dummad gwallu-dummagan gwabo obinyenonikid:","poem":1},{"text":"Gwallu-dummad, neg-ibginedgi negdaknai guegar.","poem":2},{"text":"Gwallu-senigwaddi, neg-mutik negdaknai guegar.","poem":1},{"text":"Degine, niisgwamar obinnisbalid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Dummad napneg-mee-imakega,","poem":1},{"text":"gwallumar, niisgwamar, nibneggi nasiksad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Adi, neg-ibginedgi negdaknai guegar,","poem":1},{"lineBreak":true},{"text":"degi, neg-mutikidgi negdaknai gubaligar.","poem":1},{"text":"Adina, neg-meegwad, negsichid-ebo bachikii imakegar.","poem":2},{"text":"Bab-Dummad dakded, we-ibmar bela nueganbi.","poem":1}]},{"type":"verse","number":19,"content":[{"text":"Weyob neg osedosad, geb neg oibosbalid.","poem":2},{"text":"Deyob, ibabakegwadgi neg gusad.","poem":3}]},{"type":"verse","number":20,"content":["Geb degi, Bab-Dummad sogdebalid:",{"text":"“Diigi ibmar-dulamar bela akar-akar ambikumar,","poem":1},{"text":"degine, nuumar ambikumar,","poem":2},{"lineBreak":true},{"text":"we-napneggi nabir niba gukudii gumalagar.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bab-Dummad demargi ibdula-dummagan obinnisad,","poem":1},{"text":"degine, diigi belagwapa ibmar-dulamar obinnisbalid.","poem":2},{"lineBreak":true},{"text":"Bela na egad-egad-balibimaladba obinnisad.","poem":2},{"text":"Degine, Bab-Dummad bela nuumar na egad-egad-balibimalad obinnisbalid.","poem":1},{"lineBreak":true},{"text":"Bab-Dummad dakded, we-ibmar bela nueganbi.","poem":1}]},{"type":"verse","number":22,"content":["Bab-Dummad a-ibmar-durgangi ise-nued-binsaedgi amarga sogded:",{"text":"“Bemar dula-mergumai gumarsun.","poem":1},{"text":"Demargi bukidar-dula-mergumai gumarsun.","poem":2},{"text":"Degine, nuumar, bemar we-napneggi bukidar-dula-mergumai gumarmosun.”","poem":1}]},{"type":"verse","number":23,"content":[{"text":"Weyob neg osedosad, geb neg oibosbalid.","poem":2},{"text":"Deyob, ibataledgi neg gusad.","poem":3}]},{"type":"verse","number":24,"content":["Geb degi, Bab-Dummad sogdebalid:",{"text":"“Napagi bela ibmar-durgan na egad-egad-balibimaladba ambikumar:","poem":1},{"text":"Ibmar-durgan-sunna-akwilemalad,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-napagi-garmakdimalad,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-sapurbarmalad,","poem":2},{"lineBreak":true},{"text":"bela na egad-egad-balibimaladba ambikumar.”","poem":2},{"lineBreak":true},{"text":"Deyob gunonikid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bab-Dummad bela ibmar-durgan-sapurbarmalad","poem":1},{"text":"na egad-egad-balibimaladba obinnisad.","poem":2},{"text":"Ibmar-durgan-sunna-akwilemalad","poem":1},{"text":"bela na egad-egad-balibimaladba obinnisbalid.","poem":2},{"text":"Degine, ibmar-durgan-napagi-garmakdimalad","poem":1},{"text":"bela na egad-egad-balibimaladba obinnisbalid.","poem":2},{"text":"Bab-Dummad dakded, we-ibmar bela nueganbi.","poem":1}]},{"type":"verse","number":26,"content":["Geb degi, Bab-Dummad sogdebalid:",{"text":"“Emisgindi, anmar, dule-obinyesun,","poem":1},{"text":"anmar-sunnague anmar imakoed.","poem":2},{"text":"Dulede, we-ibmar-durganmargi gangued-nika guoed:","poem":1},{"text":"Uamargi, nuumargi,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-sunna-akwilemaladgi,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-sapurbarmaladgi,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-napagi-garmakdimaladgi,","poem":2},{"lineBreak":true},{"text":"bela we-ibmarmargi we-napneggi gangued-nika guoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Bab-Dummad dule-obinyenonikid,","poem":1},{"text":"na e-sunnague obinyenonikid.","poem":2},{"text":"Bab-Dummad e-sunnague na imaksad.","poem":1},{"text":"Machered, ome-ebo obinnisad.","poem":2}]},{"type":"verse","number":28,"content":["Bab-Dummad we-dulemargi ise-nued-binsasadba, ega sogded:",{"text":"“Bemar mimmigan-bukidar nikumar.","poem":1},{"text":"We-napneggi dula-bukidar urbemar,","poem":2},{"text":"degi, bela we-napneg-ugakaase ambikumar.","poem":1},{"text":"Bemar we-napneggi be gangued-nikadba","poem":2},{"text":"bela we-ibdurganmargi be obindii gumarsun:","poem":1},{"text":"Uamargi, nuumargi,","poem":2},{"lineBreak":true},{"text":"degi, ibmar-durgan-napagi-garmakdimaladgi.”","poem":2}]},{"type":"verse","number":29,"content":["Geb degi, Bab-Dummad dulega sogdebalid:",{"text":"“We-napneggi bela gagan-nabir-gwag-nikumalad, degi, bela sapimar-e-sangi-gwag-nikumalad, an bemarga uked.","poem":1},{"text":"A-ibmar-durba bela bemar-masga guoed.”","poem":2}]},{"type":"verse","number":30,"content":["Bab-Dummad we-napneggi bela we-ibmar-durganga sogdebalid:",{"text":"“Bela ibdula-unimaladga,","poem":1},{"lineBreak":true},{"text":"bela nuumarga,","poem":1},{"lineBreak":true},{"text":"bela ibdurgan-napagi-garmakdimaladga,","poem":1},{"text":"bela gagan-ara-aramalad e-masga-guega an ega uked.”","poem":2},{"lineBreak":true},{"text":"Deyob gunonikid.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Geb degine, Bab-Dummad dakded, bela ibmar-na-obinnisadi, bela-bela nueganbi.","poem":1},{"text":"Weyob neg osedosad, geb neg oibosbalid.","poem":2},{"text":"Deyob, ibanergwadgi (6) neg gusad.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/GEN/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/GEN/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":null,"previousChapterAudioLinks":null,"numberOfVerses":31}