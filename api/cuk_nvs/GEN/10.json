{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"GEN","translationId":"cuk_nvs","name":"Génesis","commonName":"Génesis","title":"GEBE-SAILAGWAD-GARDA GÉNESIS","order":1,"numberOfChapters":50,"sha256":"5e80deca1ef0d4dbf4bafa1bc04ba8824097a8063e694f37691e05acbd11904b","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cuk_nvs/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":10,"content":[{"type":"heading","content":["Noé-wagan"]},{"type":"verse","number":1,"content":["Noé-masmala, wemalad: Sem, Cam, Jafet. Wemarde muusaila-mulusad-sorba, na mimmigan nikusmalad. Noé-masmala-e-wagan ambikusmalad, wemalad:"]},{"type":"heading","content":["Jafet-wagan"]},{"type":"verse","number":2,"content":[{"text":"Jafet-masmala, wemalad:","poem":1},{"text":"Gomer, Magog, Madai,","poem":2},{"lineBreak":true},{"text":"Javán, Tubal,","poem":2},{"lineBreak":true},{"text":"Mesec, degi, Tiras.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gomer-masmaladi, wemalad:","poem":1},{"text":"Askenaz, Rifat, Togarma.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Javán-masmaladi, wemalad:","poem":1},{"text":"Elisa, Tarsis,","poem":2},{"lineBreak":true},{"text":"Quitim, degi, Dodanim.","poem":2}]},{"type":"verse","number":5,"content":["Wemar, Jafet-wagan gumalad. Wemar, demar-gakaba ambikusmalad. Gaya emar-emarbi sunmakmalad. Degine, na e-dadgan-e-dadganba, dulemar na emar-emar ambikusmalad."]},{"type":"heading","content":["Cam-wagan"]},{"type":"verse","number":6,"content":[{"text":"Cam-masmala, wemalad:","poem":1},{"text":"Cus, Mizraim,","poem":2},{"lineBreak":true},{"text":"Fut, degi, Canaán.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Cus-masmaladi, wemalad:","poem":1},{"text":"Seba, Havila, Sabta,","poem":2},{"lineBreak":true},{"text":"Raama, degi, Sabteca.","poem":2},{"text":"Raama-masmaladi, wemalad:","poem":1},{"text":"Seba, Dedán.","poem":2}]},{"type":"verse","number":8,"content":["Cus, Nimrod-e-babad. Nimrod-insega we-napneggi nuga-nikad gusad, dule-dutusulid gusad."]},{"type":"verse","number":9,"content":["Nimrod, Bab-Jehová-nabir-egi-binsasadba sapurba ibmar-maked-dule gusad. A-ulale, weyob-sogleged: “Dule-Nimrodʼyob ibmar-maked-duleye.”"]},{"type":"verse","number":10,"content":[{"text":"Nimrod, we-neggweburmargi negsemai gusad:","poem":1},{"text":"Babelʼgi, Erecʼgi,","poem":2},{"lineBreak":true},{"text":"Acadʼgi, degi, Calneʼgi.","poem":2},{"text":"We-neggweburmar, Sinar-yargi bukwagusad.","poem":3}]},{"type":"verse","number":11,"content":["Geb Nimrod Sinar-yargi-nodegusgu, Asiria-yarse nadegusad.",{"text":"Agi, we-neggweburmar urbidapid:","poem":1},{"text":"Nínive, Rehobot,","poem":2},{"lineBreak":true},{"text":"Cala, degi, Resén.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Resén-neggwebur-dummad, Nínive, Cala-ebo-abingunaid-abargi siid.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Mizraim-wagan, wemalad:","poem":1},{"text":"Ludim, Anamim,","poem":2},{"lineBreak":true},{"text":"Lehabim, Naftuhim,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Patrusim, Casluhim,","poem":2},{"lineBreak":true},{"text":"degi, Caftorim.","poem":2},{"text":"Casluhim-dulegi Filistea-dulemar danikid.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Canaánʼdi, Sidón-e-babad.","poem":2},{"lineBreak":true},{"text":"Sidónʼde, Canaán-machi-sailaginedid,","poem":2},{"lineBreak":true},{"text":"geb degine, Hetʼye-nugad, baksabalid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Canaán-wagan, wemalad:","poem":1},{"text":"Jebuseo-dulemar,","poem":2},{"lineBreak":true},{"text":"Amorreo-dulemar,","poem":2},{"lineBreak":true},{"text":"Gergeseo-dulemar,","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Heveo-dulemar,","poem":2},{"lineBreak":true},{"text":"Araceo-dulemar,","poem":2},{"lineBreak":true},{"text":"Sineo-dulemar,","poem":2}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Arvadeo-dulemar,","poem":2},{"lineBreak":true},{"text":"Zemareo-dulemar,","poem":2},{"lineBreak":true},{"text":"Hamateo-dulemar.","poem":2},{"text":"Geb sorbali, Canaán-dulemar na e-dadgan-e-dadganba aisakidmalad.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Canaán-dulemar e-yar-gasadi, wemalad:","poem":1},{"text":"Sidón-neggweburgi onoded,","poem":2},{"lineBreak":true},{"text":"Gerar-yalasik, Gaza-neggweburse warmaksad.","poem":2},{"text":"We-yar-e-neggweburmarde, wemalad:","poem":1},{"text":"Sodoma, Gomorra,","poem":2},{"lineBreak":true},{"text":"Adma, degine, Zeboimʼsik, Lasa-neggweburse.","poem":2}]},{"type":"verse","number":20,"content":["Wemar, Cam-e-wagan gumalad. E-dadgan-e-dadganba, degine, gaya emar-emarbi-sunmake ambikusmalad. Yar-egad-egad, degine, dulemar emar-emarbi ambikusmalad."]},{"type":"heading","content":["Sem-wagan"]},{"type":"verse","number":21,"content":["Deginbali, Jafet-e-ia-Sem, machimala-nikusmogad. Heber-masmala, bela Sem-wagan gumalad."]},{"type":"verse","number":22,"content":[{"text":"Sem-masmala, wemalad:","poem":1},{"text":"Elam, Asur, Arfaxad,","poem":2},{"lineBreak":true},{"text":"Lud, degi, Aram.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Aram-masmaladi, wemalad:","poem":1},{"text":"Uz, Hul,","poem":2},{"lineBreak":true},{"text":"Geter, Mas.","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Arfaxad, Sala-e-babad.","poem":2},{"lineBreak":true},{"text":"Salaʼdi, Heber-e-babad.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Heber machimala-warbo nikusmogad:","poem":1},{"text":"Machi-sailagined Pelegʼye nugad.","poem":2},{"text":"Ar ade, a-ibagangi dulemar aisakided.","poem":3},{"text":"Peleg-e-urba, Joctánʼye nugad.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Joctán-masmala, wemalad:","poem":1},{"text":"Almodad, Selef,","poem":2},{"lineBreak":true},{"text":"Hazarmavet, Jera,","poem":2}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Adoram, Uzal, Dicla,","poem":2}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Obal, Abimael, Seba,","poem":2}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ofir, Havila, degi, Jobab.","poem":2},{"text":"Wemar belagwapa, Joctán-machimala gued.","poem":3}]},{"type":"verse","number":30,"content":["Wemar Sefar-yalagansik, Mesa-nadedgi, bukwagusmalad. We-yalagande dad-nakwedsik naid."]},{"type":"verse","number":31,"content":["Wemar Sem-e-wagan gumalad. E-dadgan-e-dadganba, degine, gaya emar-emarbi-sunmake ambikusmalad. Yar-egad-egad, degine, dulemar emar-emarbi ambikusmalad."]},{"type":"verse","number":32,"content":["Wemar, Noé-machimala, e-gwenadgan-e-gwenadganba ambikusmalad. Na e-wagan-e-wagan yar gasmalad. Wemar muusaila-mulusad-sorba, bela we-napneggi-aisakis ambikusmalad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/GEN/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/GEN/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/GEN/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}