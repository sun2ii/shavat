{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"GEN","translationId":"cuk_nvs","name":"Génesis","commonName":"Génesis","title":"GEBE-SAILAGWAD-GARDA GÉNESIS","order":1,"numberOfChapters":50,"sha256":"5e80deca1ef0d4dbf4bafa1bc04ba8824097a8063e694f37691e05acbd11904b","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cuk_nvs/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":11,"content":[{"type":"heading","content":["Neg-matusulid-Babel"]},{"type":"verse","number":1,"content":["Epennegwa, bela dulemar unnila gaya-gwennaa sunmakmalanad."]},{"type":"verse","number":2,"content":["Dad-nakwedsik dulemar nadgua, Sinarʼgi nebabi-nai dakdapid. Agi ambikudapmalad."]},{"type":"verse","number":3,"content":["Ibagwengi, na ga muchub-muchub sokarmalad: “Anmar dakebinne, anmar napa-ginnid akwayob dutusuli sobe, geb degine, anmar soogine ogumakar imakoed.” Weyob akwa-anar napa-ginnid-akwayob-dutusuli-sobaled ebusmalad, degine, barya ebusmarbalid, ebo acha-acha imakegar."]},{"type":"verse","number":4,"content":["Geb a-sorba, sogdemarbalid: “Anmar dakebinne, anmar neggwebur-dummad sobmala. Geb neg-matusulid nibnegse-warmakedse, anmar sobbaloed. Anmar deyob imakele, bela anmar nug-nika gumaloed, dule-dummaganga anmar gumaloed, degine, adi, mer anmar we-napneggi aisakimalagar.”"]},{"type":"verse","number":5,"content":["Geb Bab-Jehováʼdi, dulemar-neggwebur-dummad-sobnanaid, degine, dulemar-neg-matusulid-sobnanaid-dakega aidenonikid."]},{"type":"verse","number":6,"content":["Geb Bab-Jehová binsaded: “Wemar, unnila dulemar-soggwenna gued, unnila gaya-soggwenna sunmakmalad. We-arbaedgebe-imaklenaid-obelosmalale, sogdamarbaloed, arbaed-baid anmar imakmarbarye. Degisoggu, bar galegosurmalad."]},{"type":"verse","number":7,"content":["A-ulale, anmar aidenaergebed, ei gaya oburnaegar, adi, na aku itomaloed.”"]},{"type":"verse","number":8,"content":["Deyobi, Bab-Jehová belagwapa we-napneggi dulemar-osakisad. Degisoggu, we-neggwebur bar sobsasurmalad."]},{"type":"verse","number":9,"content":["We-neggweburgine, Bab-Jehová weyob dulemar gaya-akar-akar-sunmakega imaksad. A-ulale, we-neggwebur Babelʼye nuggusad. Geb wegine, Bab-Jehová bela dulemar we-napneg-ugakaase osakisad."]},{"type":"heading","content":["Sem-e-wagan"]},{"type":"verse","number":10,"content":[{"text":"Wemar, Sem-e-wagan gumalad:","poem":1},{"text":"Birgabogus muusaila-nasad-sorba, Sem-machi-Arfaxad gwalulesad.","poem":2},{"text":"Deunni, Sem birga-dulatar (100) nikad.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"A-sorbali, Sem birga-dulataled-ilatar (500) napi-gudii gusad.","poem":2},{"text":"Sem machimala-baigan nikusbalid, degine, bunamala nikusbalid.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Arfaxad birga-dulagwen-gakambe-gakatar-nikadgi (35),","poem":1},{"text":"e-machi-Sala gwalulesad.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A-sorbali, Arfaxad birga-dulataled-ilabake-gakapaa (403) napi-gudii gusad.","poem":2},{"text":"Arfaxad machimala-baigan nikusbalid, degine, bunamala nikusbalid.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Sala birga-dulagwen-gakambe-nikadgi (30),","poem":1},{"text":"e-machi-Heber gwalulesad.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A-sorbali, Sala birga-dulataled-ilabake-gakapaa (403) napi-gudii gusad.","poem":2},{"text":"Sala machimala-baigan nikusbalid, degine, bunamala nikusbalid.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Heber birga-dulagwen-gakambe-gakabake-nikadgi (34),","poem":1},{"text":"e-machi-Peleg gwalulesad.","poem":2}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A-sorbali, Heber birga-dulataled-ilabake gaka dulagwen-gakambe (430) napi-gudii gusad.","poem":2},{"text":"Heber machimala-baigan nikusbalid, degine, bunamala nikusbalid.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Peleg birga-dulagwen-gakambe-nikadgi (30),","poem":1},{"text":"e-machi-Reu gwalulesad.","poem":2}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A-sorbali, Peleg birga-dulataled-ilabo-gakabakebak (209) napi-gudii gusad.","poem":2},{"text":"Peleg machimala-baigan nikusbalid, degine, bunamala nikusbalid.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Reu birga-dulagwen-gakambe-gakabo-nikadgi (32),","poem":1},{"text":"e-machi-Serug gwalulesad.","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A-sorbali, Reu birga-dulataled-ilabo-gakagugle (207) napi-gudii gusad.","poem":2},{"text":"Reu machimala-baigan nikusbalid, degine, bunamala nikusbalid.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Serug birga-dulagwen-gakambe-nikadgi (30),","poem":1},{"text":"e-machi-Nacor gwalulesad.","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A-sorbali, Serug birga-dulataled-ilabo (200) napi-gudii gusad.","poem":2},{"text":"Serug machimala-baigan nikusbalid, degine, bunamala nikusbalid.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Nacor birga-dulagwen-gakabakebak-nikadgi (29),","poem":1},{"text":"e-machi-Taré gwalulesad.","poem":2}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"A-sorbali, Nacor birga-dulatar-gakambe-gakabakebak (119) napi-gudii gusad.","poem":2},{"text":"Nacor machimala-baigan nikusbalid, degine, bunamala nikusbalid.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Taré bato birga-dulapaa-gakambe-nikadgi (70),","poem":1},{"text":"e-masmala Abram, Nacor, degi, Harán gwalulesad.","poem":2}]},{"type":"heading","content":["Taré-e-wagan"]},{"type":"verse","number":27,"content":[{"text":"We, Taré-e-igar:","poem":1},{"text":"Taré, Abram-e-babad.","poem":2},{"lineBreak":true},{"text":"Nacor, degi, Harán amba Taré-masmalamogad.","poem":2},{"text":"Haránʼde, Lot-e-babad.","poem":3}]},{"type":"verse","number":28,"content":["Harán e-bab-Taré-iduar Caldea-dulemar-yargi, Ur-neggweburgi burgwisad. Urʼde Harán-gwalulesad-neggweburad."]},{"type":"verse","number":29,"content":[{"text":"Abram, Sarai-nikusad.","poem":2},{"lineBreak":true},{"text":"Nacorʼdi, Milca-nikusad.","poem":2},{"text":"Milcaʼde, degi, Isca, Harán-e-sisgan gumalad.","poem":3}]},{"type":"verse","number":30,"content":["Saraiʼdi geg mimmi nikued, ar ade, gusgu muu-neggi geg mimmi-bake danikid."]},{"type":"verse","number":31,"content":["Taré Canaán-yarse-naega Caldea-dulemar-yargi Ur-neggweburgi noar gusad.",{"text":"Taré na eba wemar sear gusad:","poem":1},{"text":"E-machi-Abram,","poem":2},{"lineBreak":true},{"text":"e-wagwa-Lot Harán-machi,","poem":2},{"lineBreak":true},{"text":"degine, e-bala-Sarai e-machi-Abram-ome.","poem":2},{"text":"Degi-inigwele, Taré, Harán-neggweburse-mosgu, agi megidapmalad.","poem":1}]},{"type":"verse","number":32,"content":[{"text":"Geb Taré, Harán-neggweburgi birga-dulataled-ilabo-gakatar-nikadgi (205) burgwisad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/GEN/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/GEN/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/GEN/10.json","previousChapterAudioLinks":{},"numberOfVerses":32}