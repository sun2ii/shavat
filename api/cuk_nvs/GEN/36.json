{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"GEN","translationId":"cuk_nvs","name":"Génesis","commonName":"Génesis","title":"GEBE-SAILAGWAD-GARDA GÉNESIS","order":1,"numberOfChapters":50,"sha256":"5e80deca1ef0d4dbf4bafa1bc04ba8824097a8063e694f37691e05acbd11904b","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cuk_nvs/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":36,"content":[{"type":"heading","content":["Esaú-e-wagan"]},{"type":"verse","number":1,"content":["Esaú, Edomʼye nugbalid. Esaú e-anagan nikusad."]},{"type":"verse","number":2,"content":[{"text":"Esaú Canaán-yargined-omegan-nikusadi, wemalad:","poem":1},{"text":"Gebesailagine, Ada-nikusad.","poem":2},{"text":"Adaʼde Elón-e-sisgwad, Het-duled.","poem":3},{"text":"Esaú, Aholibama-nikusbalid.","poem":2},{"text":"Aholibamaʼde Aná-e-sisgwad, Zibeón-e-wagwad. Zibeónʼde Heveo-duled.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Degine, Esaú, Basemat-nikusbalid.","poem":2},{"text":"Basematʼde Ismael-e-sisgwad, Nebaiot-e-bunad.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Esaú Canaán-yargi-maigu, machimala-nikusadi, wemalad:","poem":1},{"lineBreak":true},{"text":"Adaʼbo baksadid,","poem":1},{"text":"Elifaz.","poem":2},{"text":"Basematʼbo baksadid,","poem":1},{"text":"Reuel,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aholibamaʼbo baksadid","poem":1},{"text":"Jeús, Jaalam, degi, Coré.","poem":2}]},{"type":"verse","number":6,"content":["Esaú, e-omemar, e-masmala, e-bunamala, degi, bela eba-gudidimalad yar-baidse sesa gusad. Deyob, e-urba-Jacob-idu bangud gusad. Bela e-ibmar-durgan, degi, bela e-ibmar-Canaán-yargi-nikusad sesa gusad."]},{"type":"verse","number":7,"content":["Ar Esaú, Jacob-ebo bela ibmar-durgan-ichesur-nikamarsoggu, geg ebo walikaa-gudii gumalad. Ar e-mamaidgine, ibmar-durgan mas-mamalaga napa unniguarsulid."]},{"type":"verse","number":8,"content":["A-ulale, Esaú Seir-yalaganba megnad gusad. Esaúʼde, Edomʼye nugbalid."]},{"type":"verse","number":9,"content":["Edom-dulemar-e-dadgan Seir-yalaganba bukwagusmalad. Wemala, Esaú-wagan gumalad."]},{"type":"verse","number":10,"content":[{"text":"Esaú-e-masmala weyob nugmalad:","poem":1},{"text":"Ada-e-machi-Elifaz.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wemardi, Elifaz-e-masmala gumarmogad:","poem":1},{"text":"Temán, Omar, Zefo,","poem":2},{"lineBreak":true},{"text":"Gatam, degi, Cenaz.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Esaú-machi-Elifaz, ome-dikarbalid nikagusad, Timnaʼye nugad.","poem":1},{"text":"Elifaz Timnaʼbo machi-nikusad, Amalecʼye nugad.","poem":2},{"text":"Wemar, Ada-e-wagan-gumalad.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Reuel-e-masmaladi, wemalad:","poem":1},{"text":"Nahat, Zera,","poem":2},{"lineBreak":true},{"text":"Sama, degi, Miza.","poem":2},{"text":"Wemar, Esaú-ome-Basemat-e-wagan-gumalad.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Aholibama, Esaú-ome-baid gubalid.","poem":1},{"text":"Aholibamaʼde Aná-e-sisgwad, Zibeón-e-wagwad.","poem":2},{"text":"A-ome Esaúʼbo masmala-baksadi, wemalad:","poem":1},{"text":"Jeús, Jaalam, degi, Coré.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Esaú-e-wagan dule-idumaladga-gusmaladi, wemalad:","poem":1},{"text":"Esaú-machi-gebesailagined, Elifaz.","poem":2},{"text":"Elifaz-e-masmala dule-idumaladga-gusmarmogadi, wemalad:","poem":1},{"text":"Temán, Omar, Zefo, Cenaz,","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Coré, Gatam, degi, Amalec.","poem":2},{"text":"Wemar, Elifaz-e-masmala, Edom-yalagangi dule-idumaladga gusmalad.","poem":3},"Bela wemar. Esaú-e-ome-Ada-wagan gumalad."]},{"type":"verse","number":17,"content":[{"text":"Esaú-machi-Reuel-e-masmala, dule-idumaladga-gusmarmogadi, wemalad:","poem":1},{"text":"Nahat, Zera,","poem":2},{"lineBreak":true},{"text":"Sama, degi, Miza.","poem":2},{"text":"Wemar, Reuelʼsik, Edom-yalagangi dule-idumaladga gusmarmogad.","poem":3},{"lineBreak":true},{"text":"Wemala, Basemat-wagan gumalad.","poem":3},{"lineBreak":true},{"text":"Basematʼde Esaú-e-ome-baid gued.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Esaú-ome-Aholibamaʼdi Aná-sisgwad.","poem":1},{"lineBreak":true},{"text":"Aholibama-e-masmala dule-idumaladga-gusmaladi, wemalad:","poem":1},{"text":"Jeús, Jaalam, degi, Coré.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bela wemala, Esaú-e-wagan gumalad.","poem":3},{"text":"Esaúʼde, Edomʼye nugbalid.","poem":1},{"text":"Bela wemala, e-dulemar-idumaladga gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Seir-e-masmala amba Edom-yalagi bukwa gusmarmogad.","poem":1},{"text":"Seirʼde, Horí-duled.","poem":2},{"text":"Seir-e-masmaladi, wemalad:","poem":1},{"text":"Lotán, Sobal,","poem":2},{"lineBreak":true},{"text":"Zibeón, Aná,","poem":2}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Disón, Ezer, degi, Disán.","poem":2},{"text":"Wemala, Seir-e-wagan, Edom-yalaganba Horí-dulemar-e-idumaladga gusmalad.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Lotán-e-masmala, wemalad:","poem":1},{"text":"Hori, Hemam.","poem":2},{"text":"Lotán-e-bundi, Timnaʼye nugad.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Sobal-e-masmaladi, wemalad:","poem":1},{"text":"Alván, Manahat,","poem":2},{"lineBreak":true},{"text":"Ebal, Sefo, degi, Onam.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Zibeón-e-masmaladi, wemalad:","poem":1},{"text":"Aja, degi, Aná.","poem":2},{"text":"We-Aná e-bab-Zibeónʼga nega-dulesulidganba moli-uayasuid-edarbedigu, dian-diopisulid amisad.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Aná mimmigan-warbo-nikusadi, wemalad:","poem":1},{"text":"Machigwa nugad, Disón.","poem":2},{"lineBreak":true},{"text":"Bunagwa nugad, Aholibama.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Disón-e-masmaladi, wemalad:","poem":1},{"text":"Hemdán, Esbán,","poem":2},{"lineBreak":true},{"text":"Itrán, degi, Querán.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ezer-e-masmaladi, wemalad:","poem":1},{"text":"Bilhán, Zaaván, degi, Acán.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Disán-e-masmaladi, wemalad:","poem":1},{"text":"Uz, degi, Arán.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Horí-dulemar-e-dummaganga gusmaladi, wemalad:","poem":1},{"text":"Lotán, Sobal, Zibeón, Aná,","poem":2}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Disón, Ezer, degi, Disán.","poem":2},{"text":"Wemala, Seir-yalaganba Horí-dulemar-idumaladga e-gwenadgan-e-gwenadganba gusmalad.","poem":3}]},{"type":"heading","content":["Edom-yar-e-reymar"]},{"type":"verse","number":31,"content":["Israel-dulemar amba yoo rey-nikumargu, deun we-reymar Edom-yargi negsemai gusmalad."]},{"type":"verse","number":32,"content":[{"text":"Beor-machi-Belaʼye-nugadi, Edom-yargi reyga megisad.","poem":1},{"text":"E-neggweburga-gusadi, Dinabaʼye nugad.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Rey-Bela burgwisgua, a-sorba, Jobab negdaknonikid.","poem":1},{"text":"Jobabʼde, Zera-e-machid, Bosra-neggweburginedid.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Jobab burgwisgua, a-sorba, Husam negdaknonikid,","poem":1},{"text":"Husamʼde, Temán-yalaginedid.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Husam burgwisgua, a-sorba, Hadad negdaknonimogad.","poem":1},{"text":"Hadadʼde, Bedad-e-machid.","poem":2},{"lineBreak":true},{"text":"Hadad, Moab-yargi Madián-dulemargi nakwisad.","poem":2},{"lineBreak":true},{"text":"Hadad-e-neggweburga-gusadi, Avitʼye nugad.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Hadad burgwisgua, a-sorba, Samla negdaknonikid.","poem":1},{"text":"Samlaʼde, Masreca-neggweburginedid.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Samla burgwisgua, a-sorba, Saúl negdaknonikid.","poem":1},{"text":"Saúlʼde, Rehobotʼginedid.","poem":2},{"text":"Rehobot-neggweburde, Éufrates-diwar-gakaba siid.","poem":3}]},{"type":"verse","number":38,"content":[{"text":"Saúl burgwisgua, a-sorba, Baal-Hanán negdaknonikid.","poem":1},{"text":"Baal-Hanánʼde, Acbor-e-machid.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Acbor-machi-Baal-Hanán burgwisgua, a-sorba, Hadar negdaknonikid.","poem":1},{"text":"Hadar-e-omedi, Mehetabelʼye nugad.","poem":2},{"lineBreak":true},{"text":"Mehetabelʼde, Matred-e-sisgwad, Mezaab-e-wagwad.","poem":2},{"lineBreak":true},{"text":"Hadar-e-neggweburga-gusadi, Pauʼye nugad.","poem":2}]},{"type":"verse","number":40,"content":["We-dulemar, Esaú-e-wagan-dummaganga gumalad. E-gwenadganmarba ilemakar danikid, e-yarmarba ilemakar danikid, degi, e-negmar-megismaladba ilemakar danikid. We, e-nugmalad:",{"text":"Timna, Alva, Jetet,","poem":2}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"Aholibama, Ela, Pinón,","poem":2}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"Cenaz, Temán, Mibzar,","poem":2}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"Magdiel, degi, Iram.","poem":2},{"text":"Wemala e-yargi bia-megismaladgi, Edom-dulemar-idumaladga gusmalad.","poem":3},{"text":"Esaúʼdi, Edom-dulemar-e-dad-sailad.","poem":1},{"text":"Esaúʼde, Edomʼye nugbalid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/GEN/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/GEN/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/GEN/35.json","previousChapterAudioLinks":{},"numberOfVerses":43}