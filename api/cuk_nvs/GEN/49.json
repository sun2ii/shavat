{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"GEN","translationId":"cuk_nvs","name":"Génesis","commonName":"Génesis","title":"GEBE-SAILAGWAD-GARDA GÉNESIS","order":1,"numberOfChapters":50,"sha256":"5e80deca1ef0d4dbf4bafa1bc04ba8824097a8063e694f37691e05acbd11904b","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cuk_nvs/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["Jacob yoedse e-mimmigangi neg-guoedgi sunmaked"]},{"type":"verse","number":1,"content":["Jacob e-machimalase gochad. Ese nonimargu, ega sogded: “Anse walikaa be dagmar. An bega sogoed, igi bemar yoedse guoe."]},{"type":"verse","number":2,"content":[{"text":"Masmala, be an-itomalagala, anse be dagmar,","poem":1},{"text":"be-bab-Israel be nue itodamar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"”Rubén, be an-machi-sailaginedid,","poem":1},{"text":"be an-ganguedid, be-inse an-san-burbagi danikidid.","poem":2},{"text":"Be-inse bur nug-dummarba-nika guedid,","poem":1},{"text":"be-inse bur gangued-nika guedid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar ade, be diwar-nomaidyob gued,","poem":1},{"text":"geg be galeged.","poem":2},{"text":"Ar an-omese be gornonigu, an-gabedgi be dodosad.","poem":1},{"text":"A-ulale, bur dummadga bar be guosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Simeón, Leví, gwenadgan gumalad.","poem":1},{"text":"Es-suidmargi dulemar-sabsur-imakdamalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E-onmakbukwadse, gwen an dogbisulid.","poem":1},{"text":"E-igar-itobukmalad-abargi, gwen an sigbisulid.","poem":2},{"text":"Ar ade, sae-itodmargu, dulemar-oburgwismalad.","poem":1},{"text":"Yogasaar moli-bebe-nikad-e-dua-dub-wardummad siksamalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Be-doggus-urwed bela-bela isdar-itolegega gusun.","poem":1},{"text":"Degine, be-sabsur-ibmar-imaked, bela-bela isdar-daklegega gusun.","poem":2},{"text":"Jacob-yalaganba an bemar-oaisakioed,","poem":1},{"text":"Israel-neggweburmargi bela aisakiega an bemar-imakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Judá, be-gwenadgan be-nug odummomaloed.","poem":1},{"text":"Be-gwenadgan be-abin dulluu e-bebe napase ebulegedse imakmaloed.","poem":2},{"lineBreak":true},{"text":"Be-isdarmaladgi be obindii guoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Judá, be achumigur-sapingwagwadyob gued,","poem":1},{"text":"Masgasa-gunnaid bergusale, obunnomegisdaed.","poem":2},{"text":"¿Doa ese achaoe?","poem":1},{"text":"Dule geg ese achaed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Judá-dulemar-abargi dule-negsemaid gwen surguosulid,","poem":1},{"text":"degine, gaapoled-e-ibed danikidse e-gaapoled-ganikid egi suosurmarbalid.","poem":2},{"text":"Ar ade, dulemar-yar-baid-baidgi-bukmalad e-rey-Siloh-nonikoed,","poem":1},{"text":"a-rey-sogedba nanamaloed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Judá mani-ibedga gunonikosoggu, uva-bukidar-nikadba e-moli-uayasuid uva-sailagi edinnoed,","poem":1},{"text":"e-moli-bipi bur uva-e-wardummadgi edinnoed.","poem":2},{"text":"Degi, Judá vino-obine-nikadba, e-mor vinoʼgi enukoed.","poem":1},{"text":"¡Vinoʼgi, e-mordummad enukbaloed!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"E-ibya vinoʼba bur gudureged.","poem":1},{"text":"E-nugarmar moli-nunisba bur sibudikid.","poem":2},{"text":"Ar Judá, mani-ibedid.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Zabulón, demar-gakagi megoed.","poem":1},{"text":"Agi, urmar-nagued-neg nika guoed.","poem":2},{"lineBreak":true},{"text":"E-ambikuoed, Sidón-yalase warmakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Isacar, moli-uayasuid-dutusulidyob gued.","poem":1},{"text":"Geg-gwisgue e-neg-yagi sagumar-imbagi obunnomaid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Isacar, obunnogega, yar-nued-dakargua,","poem":1},{"text":"degi, yeerdaklege dakargua,","poem":2},{"text":"ibmar-berbegega na san imaksad,","poem":1},{"text":"emar-maiga gunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”Dan, Israel-masmala-ambe-gakabogwad-baiganyobmogad (12).","poem":1},{"text":"Dan, e-sordamarga igar-nudakedga guoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dan, naibe-buled igargi-maidyob guoed,","poem":1},{"text":"a-naibe moli-maligi warmaksale, dule-moli-birgi-siid argwatedaed.”","poem":2}]},{"type":"verse","number":18,"content":["Jacob sogdebalid:",{"text":"“¡Bab-Jehováʼye, bela-bela be an-abonoged,","poem":1},{"text":"an-edarbediid!”","poem":2}]},{"type":"verse","number":19,"content":["Geb degine, Jacob e-masmalaga sogdebalid:",{"text":"“Gadʼgi sordamar-urwemalad bukidar gwisgunonimaloed.","poem":1},{"text":"Degi-inigwele, Gadʼdi, a-sordamar-baregitoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"”Aser mas-yaisur-nika guoed.","poem":1},{"text":"We-masmar reymar-mas-gunnedyob yeer-gulle itomaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"”Neftalí, igi goe-ome sapurba e-itolegedba gudidae,","poem":1},{"text":"degi, e-mimmigan yeerdakle nikabali, deyob gued.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"”José, dian-dikarba sapi-gwichiyob gued,","poem":1},{"text":"sapi-yaisur-sanmakedyobid, e-anagan galu-birgi obakmamaid.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Joséʼga nunmaked-dummad uksamalad,","poem":1},{"text":"sigu-mimalad isdar be-dakmaladba begi sigu mismalad.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Degi-inigwele, bedi sikirmaksasulid,","poem":1},{"text":"be-garganguedba be-warsi be gachii ganigwichi gusad.","poem":2},{"text":"¡Jacob-e-Bab-Dummad-Gandik-Maid, dog-nuedye an bega soged!","poem":1},{"text":"Bedi sibad-wawaad-edarbedyob emar-idumaid,","poem":2},{"text":"bedi, akwasaila-dule-odukuedyob gued,","poem":1},{"text":"be Israel-bendakedid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"¡Ar ade, be-bab-e-Bab-Dummad be-bendakoed!","poem":1},{"text":"Bab-Dummad-Bela-Gangued-Nikad, ise-nued begi binsaoed.","poem":2},{"text":"¡Nibneggi ise-nued begi binsaoed!","poem":1},{"text":"¡Demar-uluba ise-nued begi binsaoed!","poem":2},{"text":"Bemala, ichesur mimmigan-nika gumaloed,","poem":1},{"text":"degi, be-mimmigan masgi be-omadii gumaloed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"An-babgan angi ise-nued-binsasadba, be-bab ise-nued bur begi binsanaid.","poem":1},{"text":"José, we ise-nued begi binsalesadi, yarmar-epenneganagi ibmar-sanmakedba bur nueganad,","poem":2},{"lineBreak":true},{"text":"sapur-epenneganagi ibmar-sanmakedba bur nueganad.","poem":2},{"text":"José, we-ise-nued-binsaleged, begadid.","poem":1},{"text":"Ar be-gwenadgan-abargi be sulesad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"”Benjamín, achu-sapur-gadi-urwedyob gued.","poem":1},{"text":"Wakdar e-masgasad gundaed.","poem":2},{"lineBreak":true},{"text":"Sedodi, e-mas-obichadi, e-sordaganmala gundaed.”","poem":2}]},{"type":"verse","number":28,"content":["Wemala, Israel-dulemar-sogambe-gakabo-ambikusadid (12). Weyob e-bab-Jacob ise-nued-binsaedgi e-masmala-war-wargwenga na emar-guoedgi ega napi sunmaksad."]},{"type":"heading","content":["Jacob-burgwisad"]},{"type":"verse","number":29,"content":["Ibagwengi, Jacob weyob e-masmalaga igar uksad: “An-burgwed warmaksad. An burgwisale, Canaán-yalagi, Het-dule-Efrón-nainugi, akwasaila-ollor-siidgi, an-dadgan-dikarba an-mui be digmalo."]},{"type":"verse","number":30,"content":["A-akwasaila-ollor-siid an bega obared: Mamre-asabin Macpelaʼgi akwasaila-ollor-siid. Deunni, Abraham Het-dule-Efrónʼse nainu-baksagu, we-akwasaila-ollor-siid baksa gusbalid. Adi, agi e-gwenadgan-e-muimar digegar."]},{"type":"verse","number":31,"content":["Agi, Abraham, degi, e-ome-Sara digsamalad. Agi, Isaac, degine, e-ome-Rebeca digsamarbalid. Deginbali, agi, Lea an digsamogad."]},{"type":"verse","number":32,"content":["We-nainude, degine, akwasaila-ollor-siidde Het-dulese bakles gusad.”"]},{"type":"verse","number":33,"content":["Jacob weyob e-masmalaga igar-uksad-bergusgu, gannar megided. Geb degine, burgwissunnad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}