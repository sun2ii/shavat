{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"GEN","translationId":"cuk_nvs","name":"Génesis","commonName":"Génesis","title":"GEBE-SAILAGWAD-GARDA GÉNESIS","order":1,"numberOfChapters":50,"sha256":"5e80deca1ef0d4dbf4bafa1bc04ba8824097a8063e694f37691e05acbd11904b","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/cuk_nvs/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":7,"content":[{"type":"heading","content":["Muusaila-mulusad"]},{"type":"verse","number":1,"content":["Geb a-sorba, Bab-Jehová Noéʼga sogded: “Emi-ibagangi, dulemar-bukwad-abargi, unnila bebi an-asabin inniki nanadiid. Degisoggu, be, be-gwenadganmala ur-dummadyaba be doge."]},{"type":"verse","number":2,"content":[{"text":"Geb bela ibmar-durgan-swilidikmalad:","poem":2},{"text":"Machered-walagugle (7), ome-walagugle, ur-dummadyaba be oubogo.","poem":3},{"text":"Ibmar-durgan-swilidiksurmaladdi","poem":2},{"text":"unnila machered-wargwen, ome-wargwen be oubogo.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Nuumala amba deyob be imakbaloed:","poem":1},{"text":"Nuumar-swilidik-akar-akar-nikadi, gwagugle-gwagugle (7-7), abirgunagwar-abirgunagwar ur-dummadyaba be oubogo.","poem":2},{"text":"Adi, we-napneggi bela ibmar-durgan, nuumarse-bakar, egad-egad balibimalad mer e-dula berguegar.","poem":3}]},{"type":"verse","number":4,"content":["”Ar ade, ibaguglese (7) dii an owioed, iba-dulabo (40) mutikidba, degi, ibginedba dii-winai an imakoed. ¡We-napneggi bela ibmar-dula-obinnilesad, bela an obelogoed!”"]},{"type":"verse","number":5,"content":["Ar igi Bab-Jehová Noéʼga sogsa, aba bela Noé ibmar imaksad."]},{"type":"verse","number":6,"content":["We-napneggi muusaila-nosgua, deunni, Noé birga-dulataled-ilanergwa (600) nikad."]},{"type":"verse","number":7,"content":["Noé-ur-dummad-sobsadyaba-dogsamaladi, wemalad:",{"text":"Noé, e-ome,","poem":2},{"lineBreak":true},{"text":"e-masmala,","poem":2},{"lineBreak":true},{"text":"degi, e-balamar,","poem":2},{"text":"adi, muusailaba melle burgwemalagar.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Ibmar-durgan-swilidikmalad,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-swilidiksurmalad,","poem":2},{"lineBreak":true},{"text":"nuumar,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-napagi-garmakdimalad,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"a-ibmar-durgan, igi Bab-Dummad Noéʼga sogsadyobi, Noéʼba ur-dummadyaba war-warbo abirgunagwar-abirgunagwar dogsamalad.","poem":3}]},{"type":"verse","number":10,"content":["Ibagugle-gusgu (7), muusaila napneggi muluded."]},{"type":"verse","number":11,"content":["Noé birga-dulataled-ilanergwa-nikadgi (600), nii-warbogwad-ibambe-gakagugledgi, dii-wilasailadgi bela napa-urba-dii-sailagan-mamaid utuded, degine, nibneggi-dii-sailagan-mamaid argaded."]},{"type":"verse","number":12,"content":["Napneggi iba-dulabo (40) bane-bane mutikidba, ibginedba, dii-winai gusad."]},{"type":"verse","number":13,"content":["Noé, ur-dummadyaba-dogsad-ibagi, wemar eba dogsamarmogad:",{"text":"E-ome,","poem":2},{"lineBreak":true},{"text":"e-machi-Sem,","poem":2},{"lineBreak":true},{"text":"e-machi-Cam,","poem":2},{"lineBreak":true},{"text":"e-machi-Jafet,","poem":2},{"lineBreak":true},{"text":"degi, e-masmala-omegan.","poem":2},{"text":"We-dulemarbi ur-dummadyaba dogsamalad.","poem":3}]},{"type":"verse","number":14,"content":["Wemarba bela ibmar-durgan-na-egad-egad-balibimalad dogsamarbalid. A-ibdurgan wemalad:",{"text":"Ibmar-durgan-sapurbarmalad,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-sunna-akwilemalad,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-napagi-garmakdimalad,","poem":2},{"lineBreak":true},{"text":"nuumar, degi, bela ibmar-sakan-nikamalad.","poem":2},{"text":"We-ibmar-durgan, Noéʼba ur-dummadgi dogsamarmogad.","poem":3}]},{"type":"verse","number":15,"content":["Bela ibmar-dula-gudidimalad Noéʼba ur-dummadyaba war-warbo dogsamalad."]},{"type":"verse","number":16,"content":["Bab-Dummad Noéʼga-sogsadba bela ibmar-durgan-akar-akar na abirgunagwar-abirgunagwar dogsamalad. Geb a-sorba, Bab-Jehová ur-dummad-yawagak edisad."]},{"type":"verse","number":17,"content":["Iba-dulabo (40) napneggi dii-winai gusad. Dii-muludgu, ur muamakded. Degisoggu, ur-dummad dii-birgi muamaknai gusad."]},{"type":"verse","number":18,"content":["Dii sabsur-muremai-muremai guded. Ur-dummaddi dii-birgi muamaknai gussunnad."]},{"type":"verse","number":19,"content":["Dii bela-bela mulussoggu, napneggi-yar-dummagan-bukmalad bela dogsad."]},{"type":"verse","number":20,"content":["Bela yarmar dogsa-sigisgu, amba dii dalipaa-abala-wilub (3½) muremai gusad."]},{"type":"verse","number":21,"content":["Weyob bela ibmar-durgan-we-napneggi-bukwad burgwisad:",{"text":"Nuumar,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-sunna-akwilemalad,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-sapurbarmalad,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-unimalad,","poem":2},{"lineBreak":true},{"text":"degi, bela dulemar burgwismarmogad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"We-napneggi ibmar-dula-gudimalad, bela burgwisad.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Weyob bela we-napneggi we-ibmarmar obelolesad:","poem":1},{"text":"Dulemar,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan,","poem":2},{"lineBreak":true},{"text":"ibmar-durgan-napagi-garmakdimalad,","poem":2},{"lineBreak":true},{"text":"degi, nuumar,","poem":2},{"text":"amar bela burgwismalad.","poem":3}]},{"type":"verse","number":24,"content":["Unnila, Noé, degi, ur-dummadyaba-bukwamaladbi durgusmalad. Dakargu, iba-dulagugle-gakambe (150) bela napneggi dii-saila mulus nagusad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/GEN/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/GEN/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/GEN/6.json","previousChapterAudioLinks":{},"numberOfVerses":24}