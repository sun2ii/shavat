{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HAB","translationId":"cuk_nvs","name":"Habacuc","commonName":"Habacuc","title":"HABACUC-GARDA HABACUC","order":35,"numberOfChapters":3,"sha256":"800b50f23d14c868c766a77e09f7a3d3377d66f47cffc16fb89e8e506ef559d3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Bab-Dummad-gayaburba-barsoged-Habacuc negburgan-daksagua, we-gayaburba ega soglesad."]},{"type":"heading","content":["Habacuc, Bab-Dummadga ibmar soged"]},{"type":"verse","number":2,"content":[{"text":"Bab-Jehováʼye, ¿sanagwadse an bese bendakleged egisnaiguoe?","poem":1},{"text":"Emide, gwen be an-itosulid.","poem":2},{"text":"¿Sanagwadse dulemar-sabsur-imakledimalad-ular, an bese gornaiguoe?","poem":1},{"text":"Emide, gwen be anmar-bendaksulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¿Ibigala, igar-innikwad-imaklesulid-dakega be an-imake?","poem":1},{"text":"¿Ibiga ibmar-isgana-imaklenaid-dakega be an-imake?","poem":2},{"text":"Unnila neg-gagalenaidbi, degi, dule-sabsur-imaklegedbi an daked.","poem":1},{"text":"Urwelegedbi, degi, na abin-abin-imakmaladbi neg-naid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Agala, igar-maidba ibmar-imaklesulid,","poem":1},{"text":"igar-innikigwad-imakleged bar imaklesulid.","poem":2},{"text":"Dule-isgana dule-nued-balegindiid,","poem":1},{"text":"dulemarga igar-innikigwadba igar nabolesulid.","poem":2}]},{"type":"verse","number":5,"content":["Bab-Jehová sogded:",{"text":"“Dule-yar-baid-baidgi-bukwamalad be dakmala.","poem":1},{"text":"Nuekwaa be dakmala, geger-dakbukwa be gumala.","poem":2},{"text":"We-ibagangi ibmar-gegerdaklemalad an imaksokalid,","poem":1},{"text":"amba dule bemarga a-ibmar-imaklegoed-odulogele, bemar amba bengumaloed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Caldea-dulemar an bemargi bila-onodagega imaknaid,","poem":1},{"text":"we-dulemar, dule-isgana-nanaed, binna-binnasuli ibmar-imakmaladid.","poem":2},{"text":"Dule-baid-ibe napa-suega bela napneg-ebirdii damalad.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"We-dulemar dule-buleganad, dule-ogwayemaladid,","poem":2},{"text":"na e-sogedba igar-innikigwad-imakleged imakmaladid.","poem":1},{"text":"Na e-nugbi-dummarbagued amidimaladid.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"E-molimar, achu-barbadba bur bule abarmakmalad,","poem":1},{"text":"achu-sapurba bur bule ursirmalad.","poem":2},{"text":"E-sordamar-moli-birgi-bila-onomalad sabsur-abarmakmalad,","poem":1},{"text":"we-sordamar dikasur danimalad.","poem":2},{"text":"Igi sulubagi e-mas-daksale, binnasuli egi melleardae,","poem":1},{"text":"deyobi dulemargi mellear damalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"We-dulemar unnila emar-sabsur-imakega danimalad,","poem":1},{"text":"e-nadapmaladba neg-dobedbi nasiknadapmalad.","poem":2},{"lineBreak":true},{"text":"Ukub-weeyobi dulemar-gamalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Reymar-mamaidgi burgunagus damalad,","poem":1},{"text":"sapin-dummagan-negsemamaidgi dodonagus damarbalid.","poem":2},{"text":"Neggwebur-galu-matusur-nikamaladga allenana damalad,","poem":1},{"text":"ar ade, a-neggweburmargi-dogegala arsanyob napamar sobmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"We-dulemar burwa-dummadyobi bela ese ibmar oitoledaed.","poem":1},{"text":"E-gangued e-bab-dummadga imakdimalad. Agi e-isgued siid.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be, Bab-Jehová, bato be negasaila-akale gudiid.","poem":1},{"text":"Be, an-Bab-Dummad-isligwaled, be degisadegu dula maid.","poem":2},{"text":"Be, Bab-Jehová, igar-innikigwad-imakmalaga be Babilonia-dorgan urbisad.","poem":1},{"text":"Be, akwasaila-dukuedyob anmarga gued.","poem":2},{"lineBreak":true},{"text":"Anmar-sabsur-odurdaked-oyogega be Babilonia-dorgan urbisad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Be, bela-bela dule-swilidikgusoggu, ibmar-isgana be abesulid.","poem":1},{"text":"Dule-sabsur-imakleged be yeer daksurbalid,","poem":2},{"text":"degite, ¿ibiga be dule-isganamar baisur-daksunna?","poem":1},{"text":"Dule-isganamar dule-nuegan-sabsur-imaknaid be dakmaidgi,","poem":2},{"lineBreak":true},{"text":"¿ibiga be gayamakar maisunna?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uamar-e-idued-satedyobi be dulemar-imaksad,","poem":1},{"text":"ibmar-unimalad-e-idued-satedyob be dulemar-imaksad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"A-ulale, Babilonia-dorgan achwergi-uasoeyobi dulemar-gamalad.","poem":1},{"text":"E-sakigi ua-galesar-ebipidamaladyobi dulemar-ebipimalad.","poem":2},{"text":"E-saki-ollo-ollogwad-imbaba ua-galesnanaid-weedyobi dulemar-wemalad,","poem":1},{"text":"degidba, yeer itomalad, weligwar itomalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"A-ulale, Babilonia-dorgan na e-sakiga bab-dummadyobi ega ibmar-ukleged ukmalad.","poem":1},{"text":"E-sakiga ina-wawadikid ogumakmalad.","poem":2},{"text":"Ar e-saki-nukad na e-masgunned bukidar nikad,","poem":1},{"text":"e-mas yeer gullebalid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ar deyobi, Babilonia-dorgan, dulemar-wiogega, ¿na e-saki-midii gumaloe?","poem":1},{"text":"¿Dulemar-gwen-wiledaksuli gindakdii gumaloe?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}