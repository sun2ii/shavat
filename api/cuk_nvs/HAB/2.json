{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HAB","translationId":"cuk_nvs","name":"Habacuc","commonName":"Habacuc","title":"HABACUC-GARDA HABACUC","order":35,"numberOfChapters":3,"sha256":"800b50f23d14c868c766a77e09f7a3d3377d66f47cffc16fb89e8e506ef559d3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Habacuc sogdebalid:",{"text":"An nakuledii imakoed,","poem":1},{"text":"aila-birgi an edarbegwichi imakoed.","poem":2},{"text":"Bab-Jehová anga-ibmar-sogdagoed an nue-itoagwar itogoed,","poem":1},{"text":"an ega ibmar-sogsad igi-an-abin-imakdagodibe.","poem":2}]},{"type":"heading","content":["Bab-Jehová, Habacuc-abin-imaksad"]},{"type":"verse","number":2,"content":["Bab-Jehová an-abin-imaksad:",{"text":"“Be negburgan-daknaid narmake,","poem":1},{"text":"urgogi magar-daklege, be nuekwaa narmako,","poem":2},{"lineBreak":true},{"text":"adi, nabir baisursunna absolegegar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar negburgan-oyolenaidi, na e-iba-sogedba gunonikoed,","poem":1},{"text":"bela a-ibmarmar-gunadapid, bela guedsegad.","poem":2},{"text":"Ar we-ibmar gwen emiskwaa guosur-inigwele, be abitogo,","poem":1},{"text":"ar bela guedsegad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Dule-isgana e-gwagegi innikidasulid.","poem":1},{"text":"Dule-gwage-swilidikiddi, Bab-Jehováʼgi-bensulidgi gudii guoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Napiragwa, ibmar-bukidar-nikuedi dulegi aibined.","poem":1},{"text":"A-ulale, dule-na-san-dummarba-imakedi, undar-gudii guosulid.","poem":2},{"text":"Ar a-dule, neg-uan-mui-dodaeyobi sulibinsa ibmarbina itoged.","poem":1},{"text":"Burgwedyobi bogigudisulid, napi-ibmar abedaed.","poem":2},{"text":"Bela yarmar-nanaid ese sulemaid,","poem":1},{"text":"bela dulemar ese galemamaid.”","poem":2}]},{"type":"verse","number":6,"content":["Bab-Jehová sogdebalid:",{"text":"“Dulemar-galesmaladi, yoedsega, dulemar-e-gasmaladgi burgunanai gumaloed,","poem":1},{"text":"galagwensuli egi sunmaknanai gumaloed.","poem":2},{"text":"Weyobi ega namaknanai gumaloed:","poem":1},{"text":"‘Dule, emar-ibe-ibmar-suedba mani-ibedga-guedi, ¡duledar-wiles!","poem":2},{"text":"Dule, emar-ibe ibmar-galemalad egadga-omelodimaladi, ¡duledar-wiles!","poem":1},{"text":"¿Sanagwadse be deyob-gudiid indakoe?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bese dulemar-mesagwar-imaklediid, ukiagwar begi gwisgudagoed.","poem":1},{"text":"We-dulemar wawanmakega be-imaknonimaloed,","poem":2},{"lineBreak":true},{"text":"sabsuli be-annik ibmar sunonimaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar be yarmar-bamalad-ibe ibmar atur-imaksasoggu,","poem":1},{"text":"yarmar-bamalad-bese-atursalessurmaladdi, be-ibe ibmar atursamarmogoed.","poem":2},{"text":"Ar emar-ibe be wilub-obicha ablis-eosad,","poem":1},{"text":"degi, we-yar-naidi be sabsur-imaksad,","poem":2},{"text":"e-neggwebur be sabsur-imaksad,","poem":1},{"text":"e-dulemar be sabsur-imaksabalid,","poem":2},{"lineBreak":true},{"text":"a-ulale, deyobi be-imakmarmogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Dule atursaale ibmar-ena na e-neg-siedi, ¡duledar-wiles!","poem":1},{"text":"Ar na binsasanad, deyobi na e-neguya bendakoye,","poem":2},{"lineBreak":true},{"text":"deyobi bar an wiledii guosurye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Weyobi be binsaedba na be-neguya bingeguega imaksad.","poem":1},{"text":"Bukidar be dulemar-ogilonai-gusadba, na be dukin obeloed amisad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"A-ulale, akwa-galumarse-bakale,","poem":1},{"text":"degi, urgomar nagubirga-mamaid-bakale, begi aibitemaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Dule emar-ibe-ablis-eogar neggwebur-sobed, ¡duledar-wiles!","poem":1},{"text":"Dule-sabsur-imakedgi neggwebur-urbed, ¡duledar-wiles!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar ani Bab-Jehová-Bur-Gangued-Nikadi,","poem":1},{"lineBreak":true},{"text":"dulemar-e-ibmar-imaked, ¿soogi-ogumaklegega igar mesissursi?","poem":1},{"text":"Dulemar binsarsunna, ¿geggus-alamaknaiguega igar mesissursi?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ar igi-dii demar-enarkwaa sigisdae,","poem":1},{"text":"deyobi napnega Bab-Jehová-e-gargangued-yeerdakleged magar-dake guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Dule e-ai-omumguedi, ¡duledar-wiles!","poem":1},{"text":"Dule e-ai-uka-swana-dakega, vinoʼgi e-ai-omumguoedi, ¡duledar-wiles!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Degidba na be dukin be-nug oichosad,","poem":1},{"text":"gwen be na be-nug odummossulid.","poem":2},{"text":"Degisoggu, be vino gobmosunna,","poem":1},{"text":"an na be Bab-Dummad-akudaked oyosunna.","poem":2},{"text":"Bab-Jehová e-argan-nuedgi bingegued-nog-ganisiid gobega be-imake,","poem":1},{"text":"be-nug-dummarba-nikad, bipii imakega imake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Babilonia-dorgan, be Líbano-yar-sabsur-imaksagusad begi aibinoed.","poem":1},{"text":"Be ibdurgan-ogilosgusad, dobguega be-imakoed.","poem":2},{"text":"Ar be dulemar-ibe doggus ablis eosad,","poem":1},{"text":"e-yar-naid be sabsur-imaksad,","poem":2},{"text":"e-neggweburmar, degi, e-dulemar be sabsur-imaksad.","poem":1},{"text":"A-ulale, be sabsur-odurdaklemogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"”Duleyob-ibmar-sobaledi, ¿ibi-nuedga wis gue? Ibmar-nuedga gusuli.","poem":1},{"text":"Nuchu-esgoro-diregwadgi-sobaledi, ¿ibi-nuedga wis gue? Unnila gakansaedginbi emar-odurdaked.","poem":2},{"lineBreak":true},{"text":"Dule nuchu-gege-sunmaked-sobedi, unnila na e-arbaedginbi bensulid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dule suar-sobaledga sogdibe: ‘¡Atake!’","poem":1},{"text":"¡We-dule, duledar-wiles!","poem":2},{"text":"Dule akwa-sobaledga sogdibe: ‘¡Gwisgue!’","poem":1},{"text":"¡We-dule, duledar-wiles!","poem":2},{"text":"Ar we-ibmarmar amba bela or egi-ebiris-nai-inigwele,","poem":1},{"text":"amba bela mani egi-ebiris-nai-inigwele,","poem":2},{"text":"gege ibmargi be-odurdaked,","poem":1},{"text":"ar burba sated, unnila uka-ollobi gued.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar Bab-Jehováʼdi na e-neg-islidikidgi maid.","poem":1},{"text":"Bela dulemar Bab-Jehová-asabin gaya-bogidik gumala.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}