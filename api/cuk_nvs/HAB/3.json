{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HAB","translationId":"cuk_nvs","name":"Habacuc","commonName":"Habacuc","title":"HABACUC-GARDA HABACUC","order":35,"numberOfChapters":3,"sha256":"800b50f23d14c868c766a77e09f7a3d3377d66f47cffc16fb89e8e506ef559d3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/cuk_nvs/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":["Bab-Dummad-gayaburba-barsoged-Habacuc, Bab-Dummadse-goled. We-Bab-Dummadse-goledi, Sigionot-gar-goledba gorlegoed."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bab-Jehová, be-nug-dummarba-gued an itosad,","poem":1},{"text":"Bab-Jehová be-ibmar-imaksadi, be-dobekwaa-nanaega an-imaked.","poem":2},{"text":"Bab-Jehováʼye, emi anmar-dulagudiidgi be gannar a-ibmarmar imake,","poem":1},{"text":"be gannar a-ibmarmar oyoge.","poem":2},{"text":"Bab-Jehováʼye, be uludele,","poem":1},{"text":"be-dule-wiledaked mer be iego.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bab-Dummad neg-Temánʼye-nugad-akale, danikid,","poem":1},{"text":"Dule-Isligwaled yar-Paránʼye-nugad-akale, danikid.","poem":2},{"lineBreak":true},{"text":"Bab-Dummad-e-gangued-yeerdakleged bela nibneg-gasad,","poem":1},{"text":"bela dulemar-we-napneggi-bukwadi e-nug odummomalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E-dakarmakedi, mala-dakarmakmaiyobi gued.","poem":1},{"text":"E-argangine malamar milemaid,","poem":2},{"lineBreak":true},{"text":"agine, e-gargangued dukuar maid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Dummad-daged-idu, bonigan-bulegan ainied.","poem":1},{"text":"Bab-Dummad-sorbali, soo-ginnitibi danidaed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bab-Dummad gwisgunonikile, napaneg giglimakde daed.","poem":1},{"text":"Dulemar-yar-baid-baidgi-bukwad-dakdele, dulemar wawanmakde daed.","poem":2},{"text":"Bela yar-dummagan-dikasurgus-bubukwad malud daed,","poem":1},{"text":"yar-senigana-sergan-bubukwad babatid daed,","poem":2},{"lineBreak":true},{"text":"ar Bab-Dummad-igardi degisadeguad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Cusán-dulemar-danar-danar-bukwadi, suli-suli-itobukwa an daksad.","poem":1},{"text":"Madián-dulemar-bukwadi, bela-bela dobe-itobukwa an daksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bab-Jehová, ¿diwarmarse be ulus gusa?","poem":1},{"text":"¿Suke-iirmakmaidse be urwemai gusa?","poem":2},{"text":"Be-moli-birgi-sii be abarmakmaigua, be-ur-napagined-gege-galakuedgi be nakwisgua,","poem":1},{"text":"¿demarse be nue-urwemai gusa?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Be-warsi na be guagwar ganikid,","poem":1},{"text":"be-saguyaba sigumar be enosad.","poem":2},{"lineBreak":true},{"text":"Be napaneg-marisadgi dii-iirmakega imaksad.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Yarmar-bubukwad be-dakdedba wawanmakdemalad.","poem":2},{"text":"Mogirmala, diidar-dummad owinonikid,","poem":1},{"text":"muu-billi binnasuli uurmakded, demar-mullugana dunguded.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be-mala-ibyemaidba, dad-ibeler geg gaed,","poem":1},{"text":"be-mala-dakarmakmaidba nii geg noed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sae-itodiidba, napneggi be bipirmakdiid.","poem":1},{"text":"Urwedgine, be dulemar-sabsur-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Be-dulamar-bendakegala, be noalid,","poem":1},{"text":"na be dule-nug-imaksad-bendakegala, be noalid.","poem":2},{"text":"Dule-isganamar-e-rey-nono, be maad imaksad,","poem":1},{"text":"bela e-negsemaid e-ibe be obelosad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"E-sordamar-e-nono, be-eswargi be buudu imaksad,","poem":1},{"text":"we-sordamar an-oaisakiega burwa-dummadyobi, angi yolenonikid.","poem":2},{"text":"Dule-wileged dule-e-bendaked-satedba, igi dule egi yolenonidae,","poem":1},{"text":"deyobi, we-sordamar bela-bela-yeer-itogedba angi yolenonikid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Be-moli-birgi-sii, be demargi bipirmakdiid,","poem":1},{"text":"demar-binnasuli-arwemamaid-birgi, be bipirmakdiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"An deyob itosgua, bela an-gwage-ulubse an-ebusad,","poem":1},{"text":"an be-gaya-itosgua, an-gakuli wawanmakded.","poem":2},{"text":"Bela an-garmala gulleded, an-nagmar bela nollomakded.","poem":1},{"text":"Degi-inigwele, andi binnalee, anmar-wionanaid-e-sabsur-odurdaklegoed-iba-nonikoedi, an edarbed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ar amba sapi-higuera sanmaksulile,","poem":1},{"text":"uva-dubmar sanmaksurbalile,","poem":2},{"text":"andi Bab-Jehováʼgi yeer itogoed,","poem":1},{"text":"Bab-Dummad-an-abonogedgi, an weligwar itogoed.","poem":2},{"text":"Amba olivo-sapi e-san nikusulile,","poem":1},{"text":"amba nainumargi ibmar-gwag welesurbalile,","poem":2},{"text":"andi Bab-Jehováʼgi yeer itogoed,","poem":1},{"text":"Bab-Dummad-an-abonogedgi, an weligwar itogoed.","poem":2},{"text":"Amba sibad-wawaadmar e-galugi bar bukwasulile,","poem":1},{"text":"amba moli-bebe-nikad wargwensaale, e-galugi bar bukwasurbalile,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"andi Bab-Jehováʼgi yeer itogoed,","poem":1},{"text":"Bab-Dummad-an-abonogedgi, an weligwar itogoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikadi, an-ogannogedid.","poem":1},{"text":"Goe-sapur-gwae-gwae-abarmakeyobi, an-imaked,","poem":2},{"lineBreak":true},{"text":"nega-matusulidganba nanaega an-imaked.","poem":2},{"lineBreak":true},{"text":"Gar-gormalad-dub-nikadba-namaklegega narmaklesad. Namakmalad-e-iduedga narmaklesad.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}