{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HAG","translationId":"cuk_nvs","name":"Hageo","commonName":"Hageo","title":"HAGEO-GARDA HAGEO","order":37,"numberOfChapters":2,"sha256":"4c323e91e3d5a3ad714369ecb724c21fbb8ce0f67905757e04d4cc874464879c","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HAG/1.json","lastChapterNumber":2,"lastChapterApiLink":"/api/cuk_nvs/HAG/2.json","totalNumberOfVerses":38},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Rey-Darío birgabogus negdakmaidgi, nii-walanergwad gebe-e-iba-onodedgine, Bab-Jehová Judá-yar-dakmaid-Salatiel-machi-Zorobabelʼse, degi, dule-irwa-Babse-goled-bur-dummad-Josadac-machi-Josuéʼse, e-gayaburba-barsoged-Hageoʼye-nugadba e-gayaburba barmialid. Weyobi sognaid:"]},{"type":"verse","number":2,"content":["“Bab-Jehová-Bela-Gangued-Nikad weyob sogye: ‘We-dulemar soged, gannar Bab-Jehováʼse-goled-neg-sobegala amba yoo e-ibagan warmakye.’ ”"]},{"type":"verse","number":3,"content":["Bab-Jehová, e-gayaburba-barsoged-Hageoʼba weyob sogsabalid:"]},{"type":"verse","number":4,"content":[{"text":"“Ar bemardi neg-nuegangi mamaid,","poem":1},{"text":"degite, an-negdi amba bela bibisgar siid.”","poem":2}]},{"type":"verse","number":5,"content":["Bab-Jehová-Bela-Gangued-Nikadi, weyob soged:",{"text":"“Bemar-ibmar-imaknanaidgi be nue binsamar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”Bemar ibmar-durba bukidar makenad,","poem":1},{"text":"degi-inigwele, ichee wis be wemalad.","poem":2},{"text":"Be mas gunmalanad,","poem":1},{"text":"degi-inigwele, amba be ukudmaada itodamalad.","poem":2},{"text":"Be gobmalanad,","poem":1},{"text":"degi-inigwele, amba be uku-uku itodamalad.","poem":2},{"text":"Be mor yodamalanad,","poem":1},{"text":"degi-inigwele, amba be dambe itodamalad.","poem":2},{"text":"Arbasadgi be-mani-bennuklegedi,","poem":1},{"text":"ibmar-bakega amba bega unnisurdaed.”","poem":2}]},{"type":"verse","number":7,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob sogbalid:",{"text":"“Bemar-ibmar-imaknanaidgi be nue binsamar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”An-neg gannar-sobega, bemar sapurba urgo aminamala.","poem":1},{"text":"Anse-goled-neg-soblegoedi an yeerdakoed.","poem":2},{"text":"Agine an-gangued-yeerdakleged an oyogoed.","poem":1},{"text":"Ani Bab-Jehová deyob soged.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Bemar ibmar-bukidar abitodimalanad,","poem":1},{"text":"degi-inigwele, wis be ichee ibmar abingamalad.","poem":2},{"text":"Bemar na neggi ibmar-sabomaladi, an bemar-ibe yoga-obelogar imaked.","poem":1},{"text":"¿An ibiga deyob imaksa?","poem":2},{"text":"‘Ar an-neg bela bibisgar-siid-ular, an deyob imaksad.","poem":1},{"text":"Bemardi, unnila be-negginbi be binsamalad.’","poem":2},{"text":"Ani Bab-Jehová-Bela-Gangued-Nikad deyob soged.","poem":1}]},{"type":"verse","number":10,"content":["”Degisoggu, bemar-ulale, dii bar wisulid, degi, napneggi geg bar ibmar sanmakbalid"]},{"type":"verse","number":11,"content":["Ani an wemargi mer bar dii-wiega imaksad:",{"text":"Orosyob-dakleged-trigo-digar-nanaidgi,","poem":2},{"lineBreak":true},{"text":"uva-digar-nanaidgi,","poem":2},{"lineBreak":true},{"text":"olivo-gwallu-nuegan-digar-nanaidgi,","poem":2},{"lineBreak":true},{"text":"ibmar-durbamar-digarmaladgi,","poem":2},{"lineBreak":true},{"text":"dulemar-bukwadgi,","poem":2},{"lineBreak":true},{"text":"ibdurgan-bukwadgi,","poem":2},{"lineBreak":true},{"text":"degi, dulemar-e-ibmarmar-imakmaladgi,","poem":2},{"text":"ani an mer bar dii-wiega imaksad.”","poem":3}]},{"type":"verse","number":12,"content":["Geb degine, Salatiel-machi-Zorobabel, degi, dule-irwa-Babse-goled-e-dummad-Josadac-machi-Josué, deginbali, bela dulemar e-Bab-Dummad-Jehováʼba ibsasmalad. Ar igi Bab-Dummad na e-gayaburba-barsoged-Hageoʼga ibmar-sogsadi, dulemar itosmalad. Geb dulemar Bab-Jehová dobgudmalad."]},{"type":"verse","number":13,"content":["Geb degine, Bab-Jehová-gayaburba-barsoged-Hageo, Bab-Jehová ega ibmar-sogsadi, dulemarga sogded: “Bab-Jehová sogye, an beba gudimarye.”"]},{"type":"verse","number":14,"content":["Weyobi Bab-Jehová Judá-yar-dakmaid-Salatiel-machi-Zorobabel-ogannosad, degi, dule-irwa-Bab-Dummadse-goled-e-dummad-Josadac-machi-Josué-ogannosad, deginbali, bela-dulemar-ogannosbalid. Geb bela wemar, e-Bab-Dummad-Jehová-Bur-Gangued-Nikad-e-neg-sobmalaga arbadmalad."]},{"type":"verse","number":15,"content":["Deunni, Rey-Darío birgabogus negsemaid. A-Nii-walanergwagi, e-iba-durgwen-gakabakegi neg sobdemalad."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HAG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HAG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ZEP/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}