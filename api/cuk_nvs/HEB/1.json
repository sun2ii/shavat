{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HEB","translationId":"cuk_nvs","name":"Hebreos","commonName":"Hebreos","title":"HEBREOʼMARSE-NARMAKLESAD-GARDA HEBREOS","order":58,"numberOfChapters":13,"sha256":"453129265bdbcf6df70797f408ff3f1367db3fb7f943e5ac16ab7a6377683e53","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/cuk_nvs/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Bab-Dummad, E-Machiba anmarga sunmaksad"]},{"type":"verse","number":1,"content":["Bab-Dummad, dikasurgus na E-gayaburba-barsogmaladba akar-akar anmar-babganga sunmakdanikid."]},{"type":"verse","number":2,"content":["Emisgwasaardi, Bab-Dummad na e-Machiba anmarga sunmaksad. Bab-Dummad bela ibmar na e-Machigadga-guega imaksad, degine, na e-Machiba bela napneg-naid, degine, nibneg-naid nasiksabalid."]},{"type":"verse","number":3,"content":["Bab-Dummad-e-Machi Bab-Dummad-gangued-yeerdakleged nikamogad. Bela Bab-Dummadga-guedi, E-Machi deyob gumogad. Degine, Bab-Dummad-Machi na e-gayaburba-gandik-nikadba, bela ibmar semaid. Bab-Dummad-Machi anmar-isgued-uruknonigu, nibneggi Bab-Dummad-ologana-argan-nuedsik sigidapsunnad."]},{"type":"heading","content":["Bab-Dummad-Machi, baliwiturmarba bur dule-dummadid"]},{"type":"verse","number":4,"content":["Bab-Dummad-Machi, baliwiturmarba bur dule-dummadga gunonikid, ar ade, gusgu baliwiturmarba bur nug-dummarba-nika danikid."]},{"type":"verse","number":5,"content":["Ar bipisaale Bab-Dummad baliwitur-gwensakga gwen weyob sogsasulid:",{"text":"“Be an-machi gued,","poem":1},{"text":"emi-ibagi, an be-babga gunonikid.”","poem":2},"Salmo 2:7 Deginbali, Bab-Dummad baliwitur-gwensakga gwen sogsasurbalid:",{"text":"“Ani an be-babga guoed.","poem":1},{"text":"Bee be, an-machiga gumogoed.”","poem":2},"2 Samuel 7:14"]},{"type":"verse","number":6,"content":["Bab-Dummad na e-Machi-wargwenna-gued we-napnegse-odenonigu, a-nikdi sogsagusad:",{"text":"“Bela Bab-Dummad-baliwiturmar we-dule-nug odummomarsun.”","poem":1},"Deuteronomio 32:43"]},{"type":"verse","number":7,"content":["Baliwiturmargindi, Bab-Dummad sogsagusad:",{"text":"“Bab-Dummad, e-baliwiturmar burwayob imaked,","poem":1},{"text":"degi, e-maigandi, soo-gwabunye-gwichiyob imakbalid.”","poem":2},"Salmo 104:4"]},{"type":"verse","number":8,"content":["Bab-Dummad, na e-Machinikdi soged:",{"text":"“Bab-Dummad, be-negsemaid degisadeguoed.","poem":1},{"text":"Be-negsemaid igar-maidba be imaked.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Igar-innikigwad-imaked be yeer-itodaed,","poem":1},{"text":"igar-isganadi be isdar-daked.","poem":2},{"text":"A-ulale, Bab-Dummad be-Bab-Dummadi,","poem":1},{"text":"be-aimar-baiganba be-susad.","poem":2},{"text":"Be-Bab-Dummad, ina-wawadikidgi be-wawamaksad,","poem":1},{"text":"weligwar-ito be-imaksad.”","poem":2},"Salmo 45:6-7"]},{"type":"verse","number":10,"content":["Degine, Bab-Dummad e-Machinik sogbalid:",{"text":"“Be, Dule-Dummad, we-napneg-naid gebesailaunni be nasiksad.","poem":1},{"text":"Degi, nibneg-naid be-argangi be nasiksabalid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"We-napnegdina berguoed, nibnegmoga bergumogoed.","poem":1},{"text":"Bedina berguosulid.","poem":2},{"text":"Igi mormar serguddae,","poem":1},{"text":"deyobi, bela nibneg, degi, napneg, sergudoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Be dule-mor-dummad-obipirmakeyobi we-napneg, nibneg imakoed.","poem":1},{"lineBreak":true},{"text":"Degine, dule mor-baid-ogwaeyobi, be we-napneg, nibneg be ogwamogoed.","poem":1},{"text":"Ar bedi gwen gwagmaisulid,","poem":2},{"lineBreak":true},{"text":"be-birgamardi gwen berguosulid.”","poem":2},"Salmo 102:25-27"]},{"type":"verse","number":13,"content":["Ar bipisaale Bab-Dummad baliwitur-gwensakga gwen weyob sogsasulid:",{"text":"“An argan-nuedsik be sige,","poem":1},{"text":"be-isdarmalad an bela ogalakuedse be sige.”","poem":2},"Salmo 110:1"]},{"type":"verse","number":14,"content":["Bela baliwiturmar-Bab-Dummadga-arbamaladi, burbaled gumalad. Bab-Dummad dulemar-abonolemaloed-bendakega, a-baliwiturmar barmialid."]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}