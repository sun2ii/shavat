{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HOS","translationId":"cuk_nvs","name":"Oseas","commonName":"Oseas","title":"OSEAS-GARDA OSEAS","order":28,"numberOfChapters":14,"sha256":"83bd62c55a7bba5a48eaf1823a3db7b5a7e35096fd8b9bfc0494b3a51b5aa246","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["Oseas sogdebalid:",{"text":"“Israel-dulemar uva-saila-yeer-sanmakedyob guenad,","poem":1},{"text":"ichesuli sanmakdaenad.","poem":2},{"text":"Ar bur bukidar-sanmakdedaed-inigwele,","poem":1},{"text":"aka bur bab-dummadyob-imaklemaladga bukidar ailamar sobdedamalad.","poem":2},{"text":"Ar e-yar nue-nasguddaed-inigwele,","poem":1},{"text":"aka bur bule e-bab-dummaganga ailamar yeerdakle imakdedamalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar we-dulemar darbo-binsadamalad,","poem":1},{"text":"agala, Bab-Dummad, e-isgumalad-ular sabsur odurdakoed.","poem":2},{"text":"Bab-Jehová e-bab-dummagan-ailamar bela obelogoed,","poem":1},{"text":"e-akwa-sobar-gwismalad bela ei obelobaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"”Ar sunna weyob sogmalad:","poem":1},{"lineBreak":true},{"text":"‘Ar anmar Bab-Dummad-dobsuli-gudii gusye,","poem":1},{"text":"a-ulale, anmar reysuli gudimarye.","poem":2},{"text":"Ar anmar rey-nikana,","poem":1},{"text":"¿ibugi wis anmar-bendakoena?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar unnila binsa sunmakdamalad,","poem":1},{"text":"gakansaar ise-sogar ibmar-sogdamalad,","poem":2},{"text":"binsa dulemarbo igar-omesdamalad.","poem":1},{"text":"Agala, abin-abin-imakmalad,","poem":2},{"lineBreak":true},{"text":"gagan-isgana-ainiardaedyobi noardaed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Samaria-dulemar, Bet-Avén-yargi moli-bebe-nikad-sapingwagwad-orbiid-e-nug-odummodiidga bukib-binsanonimaloed.","poem":1},{"text":"E-dulemar, a-ulale, na wiles itononimaloed,","poem":2},{"text":"e-dule-irwa-ese-gormaladmoga bukib ega binsadmarmogoed,","poem":1},{"text":"ar ade, e-ibe dikasuli yar-baidse sedmaloed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Moli-bebe-nikad-sapingwagwad-orbiidi, Asiria-yarse rey-maniga-guega seledoed.","poem":1},{"text":"Efraín-dulemar bingegumaloed.","poem":2},{"lineBreak":true},{"text":"Israel-dulemardina, na e-bab-dummadga-ibmar-imakdimaladgi dummad-bingegunai guoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Samaria-dulemala, e-reybogwa obelolemaloed.","poem":1},{"text":"Diwar-noedba suarmar-selemaidaedyobi selemai gumaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-dummadyob-imaklemalad-e-negmar, yarmar-birigi-bukwamaladi bela bibislegoed.","poem":1},{"text":"Israel-dulemar egi isgudidamaladid.","poem":2},{"text":"E-aila-matusurmaladgi gagan-ikobimalad egi ammurnai gudoed.","poem":1},{"text":"Degisoggu, yarmarga sogdemaloed:","poem":2},{"lineBreak":true},{"text":"‘¡Be anmargi batedage!’","poem":2},{"text":"Yar-mulluganga sogdemaloed:","poem":1},{"text":"‘¡Be anmar-omursunna!’ ”","poem":2}]},{"type":"verse","number":9,"content":["Bab-Jehová Israel-dulemarga sogded:",{"text":"“¡Bemar, Israel-dulemar! Gabaaʼgi-neggusad-akale, be isgudanigumalad.","poem":1},{"lineBreak":true},{"text":"De-akale, bemar gwen isgued iesurmalad.","poem":1},{"text":"A-ulale, bemar be-isguedba Gabaa-yargi bila-onolegoedgi be obelolemaloed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An-itolegedba an bemar sabsur-odurdakoed.","poem":1},{"text":"Bemargi-yolemalagala, neggwebur-baigan-atomalaga an imakoed.","poem":2},{"text":"Agi bemar sogbo-ibmar-isgana-imaksadba,","poem":1},{"text":"an sabsur-bemar-odurdakoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraín-dulemar moli-bebe-nikad-bipigwad-nuekwa-odurdaklegaledyobinad,","poem":1},{"text":"ibmar-gwag-weed yeer-itodaenad.","poem":2},{"text":"An ega yapa e-dukargi suar nasikgusanad.","poem":1},{"text":"Emisgindi an, Efraín-dulemar-e-dukargi suar nasiksunnoed.","poem":2},{"text":"Judá-dulemar napa-imuedga gudsunnoed,","poem":1},{"text":"Jacob-wagan napa-imulesad-durwinai gudsunnoed.”","poem":2}]},{"type":"verse","number":12,"content":["Oseas Israel-dulemarga sogded:",{"text":"“¡Bab-Jehová-amiega be guakwamalo!","poem":1},{"text":"Ar bemar nainu-binidyob gumalad.","poem":2},{"text":"Gwagegi igar-napiragwad be nasikmar,","poem":1},{"text":"adi, egi sabgued-igar be amimaloed.","poem":2},{"text":"Geb agine, Bab-Jehová, bemar-bendakegala,","poem":1},{"text":"bemarbina danikoed.","poem":2},{"text":"Ar igi dii-wiedi, napa-dinnaregedgi batenonidae,","poem":1},{"text":"deyobi, Bab-Jehová bemar-bendaknonikoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ar bemar, ibmar-isgana imaksamalad,","poem":1},{"text":"agala, bemar boni-dummaganba galitonanaid,","poem":2},{"lineBreak":true},{"text":"gakan-imaksadbali be ibitonanaid.","poem":2},{"text":"Ar ade, bemar, be-moli-ur-bila-onomaladmargi bensulid nikusmalad,","poem":1},{"text":"ar sorda-bila-onomaladgi be bensulid nikusmarbalid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Emide, be-neggweburgine bila onoledoed,","poem":1},{"text":"bela be-neg-gandikmalad bibichidoed.","poem":2},{"text":"Igi Rey-Salmán bila-ononaidgi Bet-Arbel-neggwebur-obelosgusayob negguoed.","poem":1},{"text":"Deunni, nangan na e-mimmiganbo sabsur-odurdaklegar burgwis nanaed.","poem":2},{"lineBreak":true},{"text":"Deyob neg guoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Weyobi Betel-dulemar bemar-imakoed,","poem":1},{"lineBreak":true},{"text":"ar bemar doggus-isgued wilub-obichaa nikad.","poem":1},{"text":"Neg-oibononikile, Israel-e-rey yog-berguar guoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}