{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HOS","translationId":"cuk_nvs","name":"Oseas","commonName":"Oseas","title":"OSEAS-GARDA OSEAS","order":28,"numberOfChapters":14,"sha256":"83bd62c55a7bba5a48eaf1823a3db7b5a7e35096fd8b9bfc0494b3a51b5aa246","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Bab-Dummad Israel-dulemar-wiledaked"]},{"type":"verse","number":1,"content":["Bab-Jehová Israel-dulemarga sogded:",{"text":"“Bipigwaunni an be-sabgusad,","poem":1},{"text":"Egipto-yar-akale an-machise an gochagusad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"An bur bule bese gornaigusdae-inigwele,","poem":1},{"text":"aka bur bule be angi banguddaed.","poem":2},{"text":"Aka bur bule be bab-dummadyob-imaklemaladga ibmar-ogumakar ukdedaed.","poem":1},{"text":"Bab-dummadyob-imaklemaladga ina-wawadikmalad be oburmakdedaed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ani an Efraín-dulemar nanaedgi odurdaksad,","poem":1},{"text":"ani an argangi seali gusad.","poem":2},{"text":"Ani an be-onudaked-gudiid-inigwele,","poem":1},{"text":"degite, gwen deyob be an-daksasulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sabedgi an be-nisad,","poem":1},{"text":"wiledakedgi an be-sesad.","poem":2},{"text":"Mailediidgi an be-onosad,","poem":1},{"text":"wiledakedgi masgi an be-oguchad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Egipto-yarse be naosurmalad,","poem":1},{"text":"Asiria-dulemar bemar-dummadga guoed.","poem":2},{"text":"Ar ade, anse bemar dagbisur-gusmarsoggua,","poem":1},{"text":"a-nukad be deyob gumaloed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Be-yargine bila-onoleged nagunonikoed,","poem":1},{"text":"be-isdarmalad bela be-yawagak-bargamalad bibisgemaloed,","poem":2},{"lineBreak":true},{"text":"bela be-ibmar-imakoed-igar-mamaid obelolenonikoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bemar, an-neggwebur-gumaladi, angi nue-banguega be alamaknanaid.","poem":1},{"text":"Degisoggu, amba anse gorye sogmalale, bar an bendakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Efraín-dulemar, ¿igi an be-iegosunna? Gege an be-ieged.","poem":1},{"text":"Israel-dulemar, ¿igi an dule-bamaladga be-urmakosunna? Gege an be-urmaked.","poem":2},{"text":"Ar gege an Adma-neggwebur-urmaksadyob bemar-urmaked,","poem":1},{"text":"gege an Zeboim-neggwebur-iesayob bemar-ieged.","poem":2},{"text":"An-ulubgine, an-gwage bemar-sabedba bipirmaksiiyob itoleged,","poem":1},{"text":"bela an-samurmar bemar-sabedba nakwamaksiiyob itoleged.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bar an begi urwosulid,","poem":1},{"text":"bar an Efraín-obelogosurbalid,","poem":2},{"lineBreak":true},{"text":"ar an dulemaryob gusulid.","poem":2},{"text":"Ar an Bab-Dummad-Isligwaled gued,","poem":1},{"text":"an-neggwebur-abargi an gudiid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”An achumigur-nono-wawaadyob uurmakdoed,","poem":1},{"text":"geb bemar anba ibsadmaloed.","poem":2},{"text":"An binnasuli-uurmakdele,","poem":1},{"text":"be-wagan, dad-nakwed-akale, dobed-abalagi anse nonimaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Egipto-yala-akale, nuu-emar-dobgudiiyobi, dobed-abalagi anse nonimaloed.","poem":1},{"text":"Asiria-yala-akale, sikwi-emar-dobgudiiyobi, dobed-abalagi anse nonimaloed.","poem":2},{"text":"Ani an e-negmargi-megmalaga imakoed.","poem":1},{"text":"Ani an Bab-Jehová-guedi we-ibmar soged.”","poem":2},"Israel-dulemar-e-isgued Bab-Jehová sogded:"]},{"type":"verse","number":12,"content":[{"text":"“Efraín-dulemar dummad-anga gakansadimalad.","poem":1},{"text":"Israel-dulemar gusgu an-yardakdimalad.","poem":2},{"text":"Judá-dulemar angi aibacha gudimalad,","poem":1},{"text":"bemar, angine dikasur-yoggus gudimalad.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}