{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HOS","translationId":"cuk_nvs","name":"Oseas","commonName":"Oseas","title":"OSEAS-GARDA OSEAS","order":28,"numberOfChapters":14,"sha256":"83bd62c55a7bba5a48eaf1823a3db7b5a7e35096fd8b9bfc0494b3a51b5aa246","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"heading","content":["Efraín-dulemar e-isgued-nukad ese ululesad"]},{"type":"verse","number":1,"content":[{"text":"“Efraín-dulemar unnila burwa-goledba gudidimalad,","poem":1},{"text":"dad-nakwedsik-burwa-goled-sorba gudidimalad.","poem":2},{"text":"Aka bur bule emar-wionaigusdamalad,","poem":1},{"text":"bane-bane gakanginbi gudimalad.","poem":2},{"text":"Asiria-dulemarbo igar mesdidamalad,","poem":1},{"text":"Egipto-dulemarga olivo-gwallu ukdidamarbalid.”","poem":2}]},{"type":"verse","number":2,"content":["Oseas weyob sogded:",{"text":"“Bab-Jehová, Judá-dulemargi yolenonikoed,","poem":1},{"text":"Jacob, e-ichakwadaedba sabsur-odurdaklegoed,","poem":2},{"lineBreak":true},{"text":"e-ibmar-isgana-imaksadba sabsur-odurdaklegoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jacob, gwaluleged-iduale, bato sapibeneggi e-ia-yamosad.","poem":1},{"text":"Degine, bato uka-selebagwadgi, Bab-Dummadbo gala-maada nagusad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Baliwiturbo bengusgusad,","poem":1},{"text":"baliwiturgi obicha gusad.","poem":2},{"text":"Jacob, ise-boale baliwiturga sognaigusad:","poem":1},{"text":"‘Wile be an-dakye.’","poem":2},{"text":"Ar Bab-Dummadi Betel-neggweburgi Jacob-abingusad,","poem":1},{"text":"agine Jacobʼbo sunmaksad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jacob, Bab-Dummad-Bela-Gangued-Nikadbo sunmaksad.","poem":1},{"text":"A-Bab-Dummadi, Bab-Jehováʼye nugad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Israel-dulemar, ar bemardina, be-Bab-Dummadse be gannar dagergebed,","poem":1},{"text":"sabgued be oyogergebed,","poem":2},{"text":"igar-napiragwad be imakergebed,","poem":1},{"text":"Bab-Dummadgi-bensuli be nanaergebbalid.”","poem":2}]},{"type":"verse","number":7,"content":["Bab-Dummad Israel-dulemarga sogded:",{"text":"“Bemar Canaán-dulemar-ibmar-ukmaladyobid.","poem":1},{"text":"Ar we-dulemar, gadi emar-yardakmalad,","poem":2},{"lineBreak":true},{"text":"yamo nibir-isganagi dulemarga ibmar-wilubsadamalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraín-dulemar na san-bule-bule-sunmakmalad.","poem":1},{"lineBreak":true},{"text":"Weyob sogmalad: ‘Ibiyobi an ibmar-ibedga gusa,","poem":1},{"text":"ibmar-bukidar an nikad.","poem":2},{"text":"Dule gwen angi isgued amiosulid,","poem":1},{"text":"degine, an-arbadiidgi dule gwen isgued amiosurbalid.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Ar bemar Egipto-yargi-bukwamalad-akale, bato ani an bemar-Bab-Dummadid.","poem":1},{"text":"Gannar dordoneggi-megmalaga an bemar-imakoed.","poem":2},{"text":"Igi nega-dulesulidganba an bemar-imaksagusa,","poem":1},{"text":"deyob an bemar-imakoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ani an anga-gayaburba-barsogmaladba an bemarga sunmaksad.","poem":1},{"text":"Wemar bukidar-negburgan-dakega an imaksad.","poem":2},{"lineBreak":true},{"text":"Wemarbali an burbar-sunmaklegedgi an sunmaksad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Israel-dulemar-Galaad-yargi-gudimalad dule-isgumaladid.","poem":1},{"text":"Gilgalʼye-neg-nugadse naddamalad,","poem":2},{"text":"agi, moli-bebe-nikad oburgwedamalad,","poem":1},{"text":"adi, e-bab-dummadyob-imaklemaladga ogumakar ukegar.","poem":2},{"text":"Agala, e-aila-matusurmalad bela an ei bibisgoed,","poem":1},{"text":"e-nainugi e-aila-akwamarbi-omilede an imakoed.”","poem":2}]},{"type":"verse","number":12,"content":["Oseas weyob sogded:",{"text":"“Be-dad-Jacob, Aram-yarse wakite gusad,","poem":1},{"text":"agi ome-nikuega sibad-wawaad-edarbedgi arbas gusad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bab-Jehováʼdi, Egipto-yargi Israel-dulemar-onogegala, degi, amar-akwebaligala,","poem":1},{"text":"dule-e-gayaburba-barsoged ebusgusad,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Degi-inigwele, Efraín-dulemar e-Bab-Jehová-ourwega imaksamalad,","poem":1},{"text":"Bab-Dummad-sae-itogega imaksamalad.","poem":2},{"text":"Agala, Bab-Jehováʼdi, wemar emar-ablis-eosmalad-nukad sabsur-odurdakoed.","poem":1},{"text":"E-isgumaladba na dukin odurdaklemaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}