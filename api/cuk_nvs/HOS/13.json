{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HOS","translationId":"cuk_nvs","name":"Oseas","commonName":"Oseas","title":"OSEAS-GARDA OSEAS","order":28,"numberOfChapters":14,"sha256":"83bd62c55a7bba5a48eaf1823a3db7b5a7e35096fd8b9bfc0494b3a51b5aa246","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Bab-Dummad sabsur Israel-dulemar-odurdakoed"]},{"type":"verse","number":1,"content":[{"text":"Gebeunni, Efraín-dulemar, Israel-yargi nuga-nikarbamaladinad.","poem":1},{"text":"Ibmar-sogdemalale, dulemar, dobee itodamalad.","poem":2},{"text":"Emide, Efraín-dulemar, bab-dummad-Baalʼye-nugad-e-nug odummod gusmalad.","poem":1},{"text":"A-isgued-nukad, Efraín-dulemar burgwenoni gusad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Degi-inigwele, amba bur bule isguedgi nanabukmalad.","poem":1},{"text":"Dulemar-ega-ibmar-sobmaladga sogdedamalad:","poem":2},{"text":"“Be anga bab-dummagan-imaklegoyob-manibiid be sobye.”","poem":1},{"text":"Geb a-dulemar na e-dakedba ega sobdamalad.","poem":2},{"text":"Degi, bab-dummadyob-imaklemalad-e-wagar-uddamalad,","poem":1},{"text":"degine, dule-ogumakar-ukleged ega ukdedamarbalid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Agala, igi-bolegoe-boo-bate,","poem":1},{"text":"igi-boo wakudaryalaba-milege,","poem":2},{"lineBreak":true},{"text":"deyob gumaloed.","poem":2},{"text":"Igi-gagan-dinnagana burwaba-seleddae,","poem":1},{"text":"igi-waa soogi-ainakwider seleddae,","poem":2},{"lineBreak":true},{"text":"deyob gumaloed.","poem":2}]},{"type":"verse","number":4,"content":["Bab-Dummad Israel-dulemarga sogded:",{"text":"“Israel-dulemar, Egipto-yargi be bukwamargua,","poem":1},{"text":"bato an bemar-Bab-Dummadid.","poem":2},{"text":"An-imbagi Bab-Dummad-baid be nikuosurmalad,","poem":1},{"text":"an-imbagi Abonoged-baid be nikuosurbalid.","poem":2},{"lineBreak":true},{"text":"Unnila anbi be-Bab-Dummadga gued.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ar ani an nega-dulesulidganba, napa-uedikidba be gudigu be-akwisad.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"An bemarga masgunned uksagusad,","poem":1},{"text":"agi bemar nue-immeles gusmalad.","poem":2},{"text":"Degi-inigwele, ar bemardi san-dummarbaa itosgusmalad,","poem":1},{"text":"degidbali, be an-ies gusmalad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Degisoggu, an bemarga achumigur-nono-wawaadyob gumaloed.","poem":1},{"text":"An bemar-idu achu-sapur-barbadyob dukumaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Igi wiob-ome ei mimmigan-sulesale, uluardae,","poem":1},{"text":"deyobi an bemargi gwichigudoed.","poem":2},{"lineBreak":true},{"text":"Be-gwage-dubmar-mamaid an bei itiroed.","poem":2},{"text":"Achumigur-nono-wawaadyobi an bemar-obelogoed.","poem":1},{"text":"Ibdurgan-ursilimaladyob an bemar-ichimakoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”Israel-dulemar, ani an bemar-obelogoed,","poem":1},{"text":"ar bemar, be-bendakdiidgi be gwisgunanaid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ar bemar gordigusmalad: ‘Anga be rey-udaye,","poem":1},{"text":"dule-negsemalad be anga udabarye.’","poem":2},{"text":"Degite, bemar-neggwebur-bendakega, ¿bia be-reymarde?","poem":1},{"text":"¿Bia dulemar-bega-negsemaladde?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An-urwedgi an bemarga rey-uksad,","poem":1},{"text":"an-urwedgi an bemar-annik susbalid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Efraín-dulemar-e-ibmar-isgana-imakmaladi nue-narmakar maid,","poem":1},{"text":"bela an e-isgumalad semaid.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Israel-dulemarga gwaluleged-ibagan nonikinad,","poem":1},{"text":"degi-inigwele, igi sikwi muu-neggi aidegega geg nuekwaa mege,","poem":2},{"lineBreak":true},{"text":"deyobi be binsaedsuli gusmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”¿Degite, amba neg-uan-e-ganguedgi bemar-bendakbi be an-abede?","poem":1},{"text":"¿Burgwedgi an bemar-bendakode?","poem":2},{"text":"Burgwed, ¿bia be-boni-dummadgande nadsunna?","poem":1},{"text":"Neg-uan, ¿bia be-dule-obeloged nadsunna?","poem":2},{"text":"Burgwed, neg-uan, be dagmar,","poem":1},{"text":"wile bar an wemar-dakosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Ar bemar, Efraín-dulemar, be-gwenadgan-abargi be nasgudele,","poem":1},{"text":"ani an bemar-obelogoed.","poem":2},{"text":"Igi-burwa-dad-nakwedsikid nega-dulesulidgansik-goledi, dianmaid, degi, diwarmaid dinnaa imake,","poem":1},{"text":"deyobi an bemar-imakoed.","poem":2},{"text":"Geb agi, be-isdarmalad be-ibe","poem":1},{"text":"bela be-ibmar-nuegan sumaloed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Samaria-dulemar, e-isgusad-nukad, an sabsur-odurdakoed,","poem":1},{"text":"ar e-Bab-Dummadgi yolesmalad.","poem":2},{"text":"E-dulemar bila-onogedgi burgwemaloed,","poem":1},{"text":"e-mimmigan napagi sabsur-omukulenai gumaloed.","poem":2},{"text":"E-omegan-gurgin-nikamalad-ibe,","poem":1},{"text":"saban sabsur-egalenai guoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}