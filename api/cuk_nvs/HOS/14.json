{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HOS","translationId":"cuk_nvs","name":"Oseas","commonName":"Oseas","title":"OSEAS-GARDA OSEAS","order":28,"numberOfChapters":14,"sha256":"83bd62c55a7bba5a48eaf1823a3db7b5a7e35096fd8b9bfc0494b3a51b5aa246","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Isguedga-wile-itogedba bendaklegoed"]},{"type":"verse","number":1,"content":["Oseas Israel-dulemarga weyob sogded:",{"text":"“Israel-dulemar, be-Bab-Dummad-Jehováʼse be gannar dagmar.","poem":1},{"text":"Ar bemar na be-isguedgi-argwanega na be imaksamalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummadga be ibmar-sogmaloedi, nue egi be binsamalo.","poem":1},{"text":"Bab-Jehováʼse gannar be namar,","poem":2},{"text":"ega be ise-wilesakwaa weyob be sogmaloed:","poem":1},{"text":"‘Be anmarga isgued elie,","poem":2},{"lineBreak":true},{"text":"begi-isgussulidyob be anmar-dake.","poem":2},{"text":"Wiledakedgi be anmar-abingae,","poem":1},{"text":"ar anmar na be-nug odummobimalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bab-Jehováʼye, Asiria-dulemar gwen anmar-bendakosulid,","poem":1},{"text":"bar anmar molimar-bila-onoged-birgi nakosulid.","poem":2},{"text":"Anmar, anmar-ibmar-sobsamaladse anmar-bab-dummaganye, bar golosulid.","poem":1},{"text":"Bab-Jehová, unnila begine babgan-satemalad wile daklesiid.’ ”","poem":2}]},{"type":"heading","content":["Bab-Dummad Israel-dulemarga ibmar-sogsad"]},{"type":"verse","number":4,"content":["Bab-Dummad Israel-dulemarga weyob sogded:",{"text":"“Ani an bemar-isgued nudakoed,","poem":1},{"text":"wile-be-dakedba an be-sabgumaloed,","poem":2},{"lineBreak":true},{"text":"ar ade, bar an bemarse urwosulid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Boo-milegedyob an Israel-dulemarga guoed.","poem":1},{"text":"Dutu-achunnedyob an Israel-dulemar-imakoed.","poem":2},{"text":"Igi Líbano-urwarmar-e-sailamar neg-urba-diglegwichi,","poem":1},{"text":"deyobi, an bemar-imakmaloed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E-anagan nasgudoed,","poem":1},{"text":"olivo-sapi-gandikidba-yeerdaklegwichiyob bemar guoed.","poem":2},{"lineBreak":true},{"text":"E-yapannedi, Líbano-urwar-yeer-yapannedyob yapanmaloed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"An-argan-yaurgi gannar ambikunonimaloed,","poem":1},{"text":"orosgi-dakleged-trigoʼyob dungudmaloed.","poem":2},{"text":"Uva-dub-ainiedyob e-wagan ainidoed,","poem":1},{"text":"Líbano-yar-e-vinoʼyobi, nug-dummarbaa gumaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraín-dulemar, Bab-dummadyob-imaklemalad be iemarsun.","poem":1},{"text":"Ani an bemar-abinsadiidid,","poem":2},{"lineBreak":true},{"text":"ani an bemar-edarbediidid.","poem":2},{"text":"Baryawar-aramakgwichiyob an gued,","poem":1},{"text":"be-sanmakedi angi danikid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ar dule, binsaed-ibedile, we-ibmarmar magar itogoed.","poem":1},{"text":"Ar dule, nue-ibmar-wisile, we-ibmarmar magar itogoed.","poem":2},{"text":"Bab-Jehová-igarmala bela innikigwadbiid.","poem":1},{"lineBreak":true},{"text":"A-igarbali, dule-innikimalad nanamalad.","poem":1},{"text":"Dule-uayasulidamaladdi, we-igargi yoleddamalad.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}