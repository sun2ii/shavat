{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HOS","translationId":"cuk_nvs","name":"Oseas","commonName":"Oseas","title":"OSEAS-GARDA OSEAS","order":28,"numberOfChapters":14,"sha256":"83bd62c55a7bba5a48eaf1823a3db7b5a7e35096fd8b9bfc0494b3a51b5aa246","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"heading","content":["Bab-Jehová e-dulamar-isgus-bukwadgi e-sabgued oyonaid"]},{"type":"verse","number":1,"content":["Bab-Jehová soged:",{"text":"“Agine be-gwenadganse, ‘Bab-Dummad-dulamarye’ be gormaloed.","poem":1},{"text":"Be-bunmarsedi, ‘Wiledaklegarmaladye’ be gormarbaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"”Be-nan abargi-odolegega be imakmar, egi be yolemar.","poem":1},{"text":"Ar we-ome, bar an-omesulid,","poem":2},{"lineBreak":true},{"text":"bar an e-suisurmogad.","poem":2},{"text":"Melle gambasamalad-damaladyob bar san-imake,","poem":1},{"text":"machergan-egi-wergued obeloge.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ar deyob imaksulile, igi-gwalulesad-ibagi aidenonigusadyobi an imakoed.","poem":1},{"text":"Uka-swili an imakoed.","poem":2},{"text":"Nega-dulesulidganga an imakoed.","poem":1},{"text":"Napa-dinnaregedga an saoed,","poem":2},{"lineBreak":true},{"text":"uku-uku-itogedba-burgwega an imakoed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An e-mimmigan wile dakosulid,","poem":1},{"text":"ade, gambasaed-mimmiganad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"E-nande, gambasaedid.","poem":1},{"text":"Ar we-ome-mimmigan-baksadde bingedsulidaedid.","poem":2},{"text":"Ar ade, we-ome weyob sogsad:","poem":1},{"lineBreak":true},{"text":"‘An-suiganmarba an nabie,","poem":1},{"text":"amar anga masgunned ukdaed,","poem":2},{"lineBreak":true},{"text":"amar anga gobed ukmarbalid,","poem":2},{"text":"amar anga mor-wawaad, degi, lino-dubgi-mor-sobaled ukdamarbalid,","poem":1},{"text":"amar anga olivo-gwallu, degine, gobed-nuegan ukdamarbalid.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"A-ulale, ani an Bab-Dummad, an e-iduar igar omuroed,","poem":1},{"text":"e-iduar ikomar-mie-mie an saoed,","poem":2},{"lineBreak":true},{"text":"adi, degidbali, bar igar amiosulid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar e-suiganbina surbinsa miamakdii guoed.","poem":1},{"text":"Gwen amisulidbali weyob sogdoed:","poem":2},{"text":"‘Bur an-sui-sailaginedse an gannar naoe,","poem":1},{"text":"iduardi bur an nued gudiinad.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar we-ome ani an ega masgunned-ukedye binsassulid,","poem":1},{"text":"ani an ega vino-binigan-ukedye binsassulid,","poem":2},{"lineBreak":true},{"text":"degi, olivo-gwallumar-ukedye, gwen binsassulid.","poem":2},{"text":"Ar ani an ega manimar, olomar an ega omelosad.","poem":1},{"text":"Degite, ¿igi-wede we-ibmarmar imaksasunna?","poem":2},{"lineBreak":true},{"text":"¡Aka Baal-bab-dummadyob-imaklemalad egi sobsad!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"”A-ulale, ibagan-omosadgi, e-annik gannar an bela an-ibmar-gwagmar-ega-uksad,","poem":1},{"text":"an-vino-nuegan-ega-uksad an suoed.","poem":2},{"text":"Mor-wawaad an ega yoega-uksad,","poem":1},{"lineBreak":true},{"text":"degi, lino-dubgi-mor-sobarmalad an ega-uksad,","poem":1},{"text":"bela gannar an ei sunonikoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"E-suigan-asabinni obingegsaegala, uka-swana an ogwisguoed.","poem":1},{"text":"We-ibmargi gwen wakinnosulid, ar guedsegad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"E-wergudiid bela an ei obelogoed:","poem":1},{"text":"E-ibamar-onoged, e-nii-binigangi ibamar-onoged,","poem":2},{"text":"degi, e-obunnoged-ibamar, e-itoakwaa-ibamar-onogedgi ibamar-onoged,","poem":1},{"text":"e-ibe bela an obelogoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"E-uva-nainumar an ei bela maada imakoed,","poem":1},{"text":"higuera-sapimar an ei bela obelogoed.","poem":2},{"text":"Ar ‘we-ibmar an-suigan anga uksaye’ gordiid. Sapurbi-moodo nai an imakoed,","poem":1},{"text":"ibmar-durgan-sapurbarmalad bela e-ibmar-naid ei gunmalaga an imakoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"An we-ome sabsur-odurdakoed,","poem":1},{"text":"ar bab-dummadyob-imaklemaladga ina-wawagan-oburmakdii gusad.","poem":2},{"text":"E-suiganba-naega olargan biiri yodii gusad,","poem":1},{"text":"ordubmar ena nasikdii gusad,","poem":2},{"text":"ar gwen angi binsassulid,","poem":1},{"text":"agala, an sabsur-odurdakoed.","poem":2},{"text":"Ani an Bab-Jehová-guedi we-ibmar soged.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Anbina-sogega an imakoed:","poem":1},{"lineBreak":true},{"text":"Nega-dulesulidganba an sedoed,","poem":1},{"text":"ega sabedgi nuekwaa an sunmakoed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Agi, Acor-nebagi, uva-nainumar gannar an ega obiroed,","poem":1},{"text":"sabsur-odurdakleged-neba an ega weligued-nebaga imakoed.","poem":2},{"text":"A-nebagine igi-nuchukwa-unni angadga gusa,","poem":1},{"text":"degi, igi-Egipto-yargi-noargusgu angadga an imaksa,","poem":2},{"lineBreak":true},{"text":"deyob an gannar imakoed.”","poem":2}]},{"type":"verse","number":16,"content":["Bab-Jehová weyob soged:",{"text":"“A-ibagangine, ‘an-dummadye’ be anse golosulid.","poem":1},{"text":"‘An-suiye’ be anse goloed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Be-bab-dummadyob-imaklemalad-e-nug-biega","poem":1},{"lineBreak":true},{"text":"bar an be-imakosulid,","poem":1},{"text":"degi, bipisaale bar ese be gorsii guosulid.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"A-ibagine, we-ibmar-durgan mer bese achamalaga an imakoed:","poem":1},{"text":"Ibmar-durgan-sapurbarmalad, mulamar, ibmar-durgan-unimalad.","poem":2},{"text":"Deginbali, we-yargine, warsigi-urweleged an obelobaloed,","poem":1},{"text":"es-suidmargi-urweleged, bila-onolemaladi an obelobaloed,","poem":2},{"lineBreak":true},{"text":"adi, bela na dobedsuli gabdii gumalagar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"An-omega degisadegu an be-imakoed,","poem":1},{"text":"igar-soglemaidba an-ome-sunnadga an be-imakoed.","poem":2},{"text":"Ar an bela-bela be-sabsoggu,","poem":1},{"text":"deyob an be-imakoed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"An be-nikuoed, an be-dikarba noosulid.","poem":1},{"text":"Degidbali, magar be an-daknonikoed, ani an Bab-Jehová gue.”","poem":2}]},{"type":"verse","number":21,"content":["Bab-Jehová soged:",{"text":"“A-ibagine, mogirmar dii-wiega an imakoed,","poem":1},{"text":"geb abali, napaneg ibmar-gwag-oniega an imakoed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Degidbali, trigoʼmar ainidagoed,","poem":1},{"text":"vino-binid bukidar ainidagoed,","poem":2},{"text":"olivo-gwallumar obinebakaoed.","poem":1},{"text":"Bela we-ibmarmala, an Jezreel-neba-onasguega imakoed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"An-dulamarga napaneg an uknonikoed,","poem":1},{"text":"angadgarbi an-dulamar an imakoed.","poem":2},{"text":"‘Wiledaklegarsurmaladi’ an wiledaknonikoed.","poem":1},{"text":"‘An-dulasurmaladse, an-dulamarye,’ an gornonikoed","poem":2},{"lineBreak":true},{"text":"‘An-Bab-Dummadye,’ anse gormarmogoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}