{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HOS","translationId":"cuk_nvs","name":"Oseas","commonName":"Oseas","title":"OSEAS-GARDA OSEAS","order":28,"numberOfChapters":14,"sha256":"83bd62c55a7bba5a48eaf1823a3db7b5a7e35096fd8b9bfc0494b3a51b5aa246","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Bab-Jehová Israel-dulemarse urwenaid"]},{"type":"verse","number":1,"content":[{"text":"Israel-dulemar, Bab-Jehová-gayaburba be nue itomar,","poem":1},{"text":"Bab-Jehová dulamar-bukwadga igar-nabogesokalid.","poem":2},"Bab-Dummad weyob soged:",{"text":"“Ar an-dulamar-abargine, dule-innikidaed bergusad,","poem":1},{"lineBreak":true},{"text":"emar-sabgued bergusbalid,","poem":1},{"text":"an-igar-amimalad bergusbalid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aka bur we-ibmarmar burgusad:","poem":1},{"text":"Gakangi yamo-ise-sogar-sogleged,","poem":2},{"lineBreak":true},{"text":"gakansaed, atursaed,","poem":2},{"lineBreak":true},{"text":"negsichigi-abirgunagwarsuli-nanaed, dule-gindakmalad.","poem":2},{"lineBreak":true},{"text":"¡Dulemar gindaklemamaigus nanaed!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"A-ulale, yar-naidgi wile-itoleged-dummad nagunonikoed,","poem":1},{"text":"egi-dulemar-gudidiidi niga-galakudmaloed.","poem":2},{"text":"Sapurgi ibmar-durgan-bukwamaladi, bela burgwidmaloed,","poem":1},{"text":"nuumala, uamarse-bakale, bela girgudoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Melle bemar dule-bamaladgi na be gwisgumalo,","poem":1},{"text":"melle be dule-bamaladse urwemarbalo.","poem":2},{"text":"An-urwenaidi, unnila dule-irwa-anse-goledgi an urwenaid.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ar bemala ibginedbali, degi, mutikidbali, oitolenonimaloed.","poem":1},{"text":"Bemarbali dule-an-gayaburba-barsoged ibitononimarmogoed.","poem":2},{"text":"¡Be-nan an be-ibe obelogoed!","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Ar an-dulamar aku an-daksamaladbali bela burgwismalad.","poem":2},{"lineBreak":true},{"text":"”Ar be aku an-daksamarsoggu,","poem":1},{"text":"dule-irwa-anse-goled-igargi an be-obanmarmosunnad.","poem":2},{"text":"Ar be an-igar-mamaid be obachasoggua,","poem":1},{"text":"be-wagan-danimaloed an iemosunnoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar dule-irwa-anse-gormalad-mergudedbali, aka bur bule angi yoled-nanaed.","poem":1},{"text":"Degisoggu, an e-nug-odummoged-anar, anse wilemaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"An-neggwebur-e-isguedgi mas gundimalad,","poem":1},{"text":"aga bur gatik an-neggwebur-isgued abemalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Degi-inigwele, dule-irwa-anse-gormalad sabsur-anse odurdaklemaloed,","poem":1},{"text":"degine, dulamar e-damaladba sabsur-anse odurdaklebaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"”Bab-Jehováʼgi bangusmalad.","poem":1},{"text":"Agala, aisaar mas-gunmalo-inigwele, gwen immelegosurmalad.","poem":2},{"text":"Degine, negsichigi-galagwensur-nanamalo-inigwele,","poem":1},{"text":"gwen dula-omelogosurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Vinoʼgi mumgudimaladbali, gambasamaladbali,","poem":1},{"text":"oes gudidimalad, bar itodisurmalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"An-neggwebur-dulamar suar-nuchuse idakmalad,","poem":1},{"text":"a-suar ega ibmar sogdaed.","poem":2},{"text":"Galagwensur-negsichigi-nanamaladbali aku-neg-itoge gudmalad.","poem":1},{"text":"Negsichigi-galagwensur angi-yolegar nanadimalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yar-birigangine, yar-mullugangine, sapimar-urba e-bab-dummaganga ina-wawad oburmakdamalad,","poem":1},{"text":"degi, ibmar-ogumakar ukdamarbalid.","poem":2},{"text":"A-ulale, e-bunamala, galagwensuli negsichigi-nanaddamalad,","poem":1},{"text":"degi, e-balamar abirgunagwarsuli negsichigi yoleddamalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Be-bunamala galagwensuli negsichigi-nanadimalad-ular,","poem":1},{"text":"be-balamar abirgunagwarsuli negsichigi-yoledimalad-ular, an sabsur-odurdakosulid.","poem":2},{"text":"Ar ade, e-suimarmoga gambasamaladba nanadimarmogad,","poem":1},{"text":"degi, bab-dummagan-neggi-gambasamaladbo ibmar-ogumakar ukmarbalid.","poem":2},{"text":"Degisoggu, neggwebur aku-neg-itogedbali,","poem":1},{"text":"bela bergudoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"”Ar Israel-dulemar galagwensuli negsichidgi nanadimalad,","poem":1},{"text":"Judá-dulemar, bemardi mer be deyob damarmogad.","poem":2},{"lineBreak":true},{"text":"”Judá-dulemar, melle Gilgalʼye-neg-nugadse be namalo,","poem":1},{"text":"melle be Bet-Avénʼye-negye-nugadse be namalo.","poem":2},{"text":"Melle be ‘Bab-Jehová-nuggi’ ise-sogar-imakmalo.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"Ar Israel-dulemar moli-bebe-nikad-bunolo-uayasulidyob guded.","poem":2},{"text":"Degisoggu, ar igi sibad-wawaad-sapingana nainu-olloledgi gagangi omalenaidae,","poem":1},{"text":"¿ar Bab-Jehová, deyob Israel-dulemar-imakoe?","poem":2},{"lineBreak":true},{"text":"Bar deyob imakosulid.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Efraín-dulemar bab-dummadyob-imaklemaladgi alakwaa seledimalad.","poem":1},{"text":"Mer ese bar gormar, ar na deyob nanabimarye soged.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ar Efraín-dulemar sisa-gobed ei bergudele, gambasaedgine burguddamalad.","poem":1},{"text":"Ar e-dummagan-yar-semaladbela, igar-isgana-imakedbina sogdamalad,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"A-ulale, e-bab-dummaganga ibmar-ogumakar-ukmalad-ular, bingegunanai gudmaloed,","poem":1},{"text":"burwa-ooregedbali bela bergumaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}