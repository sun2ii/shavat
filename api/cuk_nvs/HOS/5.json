{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HOS","translationId":"cuk_nvs","name":"Oseas","commonName":"Oseas","title":"OSEAS-GARDA OSEAS","order":28,"numberOfChapters":14,"sha256":"83bd62c55a7bba5a48eaf1823a3db7b5a7e35096fd8b9bfc0494b3a51b5aa246","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Bab-Dummad Israel-dulemargi gwisgunaid"]},{"type":"verse","number":1,"content":[{"text":"“¡Dule-irwa-anse-gormalad, nue be an-itomalo!","poem":1},{"text":"¡Israel-e-dulemar, nue be bogi an-itomalo!","poem":2},{"text":"¡Reyneg-yaginmalad, nue be an-itomalo!","poem":1},{"text":"¡An bemargi yolesokalid!","poem":2},{"text":"Bemar Mizpaʼye-neg-nugadgi an-neggwebur-yardaklegega imaksamalad,","poem":1},{"text":"Bemar Tabor-yalagi an-dulamar-yardaklegega imaksamarbalid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bemar Sitim-nebagi dia-yaa-matusulidyobi an-neggweburga gusmalad.","poem":1},{"text":"A-ulale, an sabsur-bemar-odurdakoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"An wisid, Efraín-dulemar igi-damala,","poem":1},{"text":"an Israel-dulemar-daed ise-wisimakarbalid.","poem":2},{"text":"Emide, Efraín-dulemar galagwensuli-negsichigi nanadmalad.","poem":1},{"text":"Israel-dulemar bela isgudmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Na ibmar-isgana-imakmaladbali, geg anse gannar-dagega gumalad.","poem":1},{"text":"Ar galagwensuli negsichigi-nanaedi, an-geg-magar-dake e-imaked.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Israel-dulemar na e-san-dummarba-imakdimaladi,","poem":1},{"text":"na dukin-egi-yolegega imakoed.","poem":2},{"text":"Ar Israel-dulemar, Efraín-dulemar, na e-isguedgine dukin yolemaloed.","poem":1},{"text":"Judá-dulemarse-bela deyob eba gumarmogoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"E-sibad-wawaadyalaba, e-molimaryalaba, an-amidii gumaloenad,","poem":1},{"text":"degi-inigwele, gwen an-amiosurmalad.","poem":2},{"lineBreak":true},{"text":"¡Ar an e-idu bangudoed!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar angi bela dodosmalad.","poem":1},{"text":"Bab-baigangad mimmi nikusmalad.","poem":2},{"text":"Degisoggu, bemala, be-nainumala,","poem":1},{"text":"niigwengi ilagwen-berguar guoed.”","poem":2},"Bab-Jehová soged:"]},{"type":"verse","number":8,"content":[{"text":"“Gabaa-neggweburgi moli-bebe-gar be ogormar,","poem":1},{"text":"Ramá-neggweburgi gar-trompeta be ogormar.","poem":2},{"text":"Bet-Avén-neggweburgi binnasuli be","poem":1},{"lineBreak":true},{"text":"bila-onogedgi-gormakedyobi be gormakmar:","poem":1},{"text":"‘Benjamín-neggwebur, nue-salakar.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Israel-dulemar, innikii an bemarga soged,","poem":1},{"text":"ibmar-guoedi an oyogoed.","poem":2},{"text":"Ar Efraín-neggwebur sabsur-odurdakleged-ibagi","poem":1},{"text":"bela olloo melledoed.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Judá-dulemar-e-dummagana, dule-nainu-odogedyob gued.","poem":1},{"text":"Degisoggu, an-urwedi, dii-dummad-noedyobi an emargi onogoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraín-dulemar mesagwar imakledisunnad,","poem":1},{"text":"e-igar-nabolemaladgi egi gwisguledisunnad,","poem":2},{"lineBreak":true},{"text":"ar ade, bab-dummadyob-imaklemaladba bur nanaed abemalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Degisoggu, an Efraín-dulemarga samuyob an guoed.","poem":1},{"text":"Deginbali, Judá-dulemarga sibebyob an guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"”Efraín-neggwebur, na e-boni-nika dakargua,","poem":1},{"text":"Judá-neggwebur, e-boni-yaamar dakarmogua,","poem":2},{"text":"Asiria-yalase abarmakdemaloenad,","poem":1},{"text":"Asiria-e-reyse bendakleged aminamaloenad.","poem":2},{"text":"Degi-inigwele, Asiria-e-rey gwen e-bendakosulid,","poem":1},{"text":"degi, gwen Judá-neggweburga boni-yaamar nudakosurbalid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"An Efraín-neggweburgala, achumigur-nono-wawaadyobi an guoed,","poem":1},{"text":"Judá-neggweburgala, achumigur-nono-wawaad-senigwadyobi an guoed.","poem":2},{"text":"An-sunnagwad an gaoed,","poem":1},{"text":"geb an saga-saga imakoed,","poem":2},{"lineBreak":true},{"text":"dule-wargwensaale, gwen bendaknonikosulid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Agine geb an gannar an-maidse nonikoed.","poem":1},{"text":"Na magar e-isgusad-itononimaladse an indakoed.","poem":2},{"text":"Na magar e-isgusad-itononimalale, degine, angi-yolesmalad na magar-itononimalale, suli-suli itodmaloed.","poem":1},{"text":"Degidbali, geb bela-belad an-amidii gumaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}