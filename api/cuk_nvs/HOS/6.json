{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HOS","translationId":"cuk_nvs","name":"Oseas","commonName":"Oseas","title":"OSEAS-GARDA OSEAS","order":28,"numberOfChapters":14,"sha256":"83bd62c55a7bba5a48eaf1823a3db7b5a7e35096fd8b9bfc0494b3a51b5aa246","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Israel-dulemar Bab-Dummadse-gannar-dagedgi sunmaked"]},{"type":"verse","number":1,"content":["Israel-dulemar sogdemalad:",{"text":"“Dagmar, gannar anmar Bab-Jehováʼse namalo.","poem":1},{"text":"Bab-Dummad an-ichimaksa-inigwele, amba anmar-nudakoed.","poem":2},{"lineBreak":true},{"text":"Anmar-onaglik-imaksad-inigwele, anmar-nudakoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ibabogwad-sorbali, anmarga burba-dulad ukoed,","poem":1},{"text":"ibapaagine, gannar anmar-ogwisguoed.","poem":2},{"lineBreak":true},{"text":"Geb, anmar e-asabin deyob gudii gumaloed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anmar magar Bab-Jehová-dakmarsun,","poem":1},{"text":"e-Igarmar-Mamaidi anmar durdakmarsun.","poem":2},{"text":"Igi dad-ibeler-noedyobi, Bab-Dummad anmarse magar-guoed,","poem":1},{"text":"dii-wiedyobi anmarse nonikoed.","poem":2},{"text":"Igi gebe-dii-argwaned napa-nudakdae,","poem":1},{"text":"deyobi anmarse nonikoed.”","poem":2}]},{"type":"heading","content":["Bab-Dummad Israel-dulemar-abinsaded"]},{"type":"verse","number":4,"content":["Bab-Jehová sogded:",{"text":"“Efraín-dulemar, ¿igi-an bemar-saergebe?","poem":1},{"text":"Judá-dulemar, ¿igi-an bemar-imakergebe?","poem":2},{"text":"Ar bemar-an-sabed, mogir bolegoedba-ainakwialir-berguddaedyob guddaed,","poem":1},{"text":"boo wakudaryalaba-ainakwialir-berguddaedyob guddabalid,","poem":2},{"lineBreak":true},{"text":"deyobi, be-an-sabgued berguddaed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A-ulale, an-gayaburba-barsogmaladbali, an bemar-wiosad.","poem":1},{"text":"An-sunmakedgine an bemar-onaglik-imaksad.","poem":2},{"lineBreak":true},{"text":"An-igar-naboged mar-aidegeyob bemar-oitononikoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ibmar-uklemalad an abemaisulid,","poem":1},{"text":"bur an-sabgued an bemar-abemaid.","poem":2},{"text":"Ibmar-ogumakar-uklemalad an abemaisulid,","poem":1},{"text":"unnila dulemar magar-an-dake-gumalad an abemaid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bemar Adánʼyobi gumalad:","poem":1},{"text":"Bemar, anbo-igar-mesisad bichismalad.","poem":2},{"lineBreak":true},{"text":"Ar bemar, angi aibichamalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Galaad-neggwebur dulemar-ibmar-isgana-imakmalad-neggweburad.","poem":1},{"text":"E-dule-ibmar-imakmaladi, bela ber ablis-eogedbi gudinanaed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule-irwa-anse-gormaladi, Siquem-neggwebursik igar-nalemaidbali,","poem":1},{"lineBreak":true},{"text":"emar-atursaega danagwen bin itos-bukwadamalad.","poem":1},{"text":"Igi dule-ibmar-atursamalad, yogasaar ibmar-isgana-imakmala,","poem":2},{"lineBreak":true},{"text":"deyobi, dule-irwa-anse-gormalad ibmar-isgana imakdamalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Israel-yala-naidgi, ibmar-gwen-nabirsulid an daksad:","poem":1},{"text":"A-yalagine, Efraín-dulemar galagwensuli negsichigi-nanabukmalad,","poem":2},{"lineBreak":true},{"text":"Israel-dulemar bela isgus bukmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Judá-dulemar, be-isgued-nukad,","poem":1},{"text":"bemar sabsur-odurdakleged abdakdiid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}