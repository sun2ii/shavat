{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HOS","translationId":"cuk_nvs","name":"Oseas","commonName":"Oseas","title":"OSEAS-GARDA OSEAS","order":28,"numberOfChapters":14,"sha256":"83bd62c55a7bba5a48eaf1823a3db7b5a7e35096fd8b9bfc0494b3a51b5aa246","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"heading","content":["Israel-dulemar Bab-Dummadgi dummad-isgusad"]},{"type":"verse","number":1,"content":["Bab-Jehová sogdebalid:",{"text":"“An-dulamar an na bendakbienad,","poem":1},{"text":"an Israel-yar nudakbienad,","poem":2},{"text":"degi-inigwele, Efraín-dulemar-isgued wilub-obichad,","poem":1},{"text":"degi, Samaria-dulemar-isgued wilub-obichabalid.","poem":2},{"text":"Ar ade, wemar gakangi gudimalad.","poem":1},{"text":"Ar dule-atursaedyobi ibmar-atursaegala, negyaba dogmalad,","poem":2},{"lineBreak":true},{"text":"gandikidgi danagwen galimbaba ibmar-atursaddamalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ar we-dulemar, gwen binsadasurmalad,","poem":1},{"text":"na e-ibmar-isgana-imakmalad angi gwen yoggumaisurye.","poem":2},{"text":"Ar e-ibmar-isgana-imakmaladi, bela na egi e-ebiris naid.","poem":1},{"text":"We-ibmar, bela an-asabin oyolenaid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"”E-ibmar-isgana-imakmaladgi, e-rey-yeer-itogega imakmalad.","poem":1},{"text":"Degi, e-gakansamaladgi, e-dummagan-yeer-itogega imakmarbalid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bela we-dulemar, negsichigi abirgunagwarsuli yoledimaladid.","poem":1},{"text":"Ar we-dulemar madu-yoed-soo ginnitibisiiyob gumalad,","poem":2},{"text":"ar igi dule-madu-sobed bar soo-ogannoged abesurdae,","poem":1},{"text":"unnila madu-mued edarbesidae, deyobi we-dulemar gumalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Rey-ibagi, dummagan, vinoʼgi mumguddamalad.","poem":1},{"text":"Rey, galagwensuli guddamogad.","poem":2},{"lineBreak":true},{"text":"Deyobi, rey, dule-galagwensuli-mumgumalad e-aimarye na sognagusdaed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Urwed-onogega, e-gwage madu-yoed-diopisur-naddaedyob naddaed.","poem":1},{"text":"Mutikgusale, e-urwed geb boggusiid.","poem":2},{"lineBreak":true},{"text":"Neg-oibosale, e-urwed gannar egi noardaed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"We-dulemar, madu-yoed-soo-diopisulidyobi gumalad.","poem":1},{"text":"E-dummagan-negsemamaid-obeloddamalad.","poem":2},{"text":"Bela deyobi e-reymar-obelosdamalad.","poem":1},{"text":"Degite, wemar-wargwensaale, an-amiega gwen anse gorsurmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"”Efraín-dulemar neggwebur-baigan-angi-bengudimaladba apuruded.","poem":1},{"text":"Ar an-dulamar, madu wagar-nailik-akwigusadyobi gumalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dule-baigan Israel-dulemar-e-gangued ei obelonanaid,","poem":1},{"text":"degite, Israel-dulemar, deyob-neg-gunaid akusunna itomalad.","poem":2},{"text":"Bela e-ibe e-gargangued obelosmalad,","poem":1},{"text":"degite, amba aku itomalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Israel-dulemar e-isguedga gwen wile-itobisurmalad,","poem":1},{"text":"an e-Bab-Dummad-guedgi, gwen an-amibisurmalad.","poem":2},{"lineBreak":true},{"text":"Na e-san-dummarba-imaked geg anse-dagega e-imaked.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Efraín-dulemar nuu-aku-neg-itogedyob gumalad,","poem":1},{"text":"gwen magar neg-itosurmalad.","poem":2},{"text":"Imbagwenale, Egipto-dulemarse bendakleged egisdedaed,","poem":1},{"text":"imbagwenar, Asiria-dulemarse bendakleged egisdedabalid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar deyob bendakleged-egisnadmalale, nuumar-galegeyobi an egi saki obatoed.","poem":1},{"text":"E-isgued-ular, an ilagugle (7) sabsur odurdakoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"¡Duledar-wilesmarsun! Ar angi bangusmalad.","poem":1},{"text":"Angi gwisgusmaladba bergumarsunnoed.","poem":2},{"text":"Ar sunna an na bendakenad,","poem":1},{"text":"degi-inigwele, ar emardi unnila anga gakansaar sunmakmalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Anse innikigwadgi gorsurmalad,","poem":1},{"text":"unnila, e-gasgi bomamaidamalad.","poem":2},{"text":"Ibmar-gwag-nikuegala, vino-binid-nikuegala, na dukin esgi san-wionanaidamarbalid.","poem":1},{"text":"Degi, angi aibitedamarbalid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amba an-igargi an odurdaksad-inigwele,","poem":1},{"lineBreak":true},{"text":"amba an ega e-surgan-ogannosad-inigwele,","poem":1},{"text":"degite, amba angi-aibinega angi ichakwa-binsananaid.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Gwen anse Bab-Dummad-Bur-Biriginedse dagbisurmalad.","poem":1},{"text":"Warsi-biir-daklegedyob gumalad.","poem":2},{"text":"E-dummagan sabsur-sunmakmaladbali, es-suidgi oburgwilenai gumaloed,","poem":1},{"text":"degine, Egipto-dulemar egi dodonanai gumarbaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}