{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HOS","translationId":"cuk_nvs","name":"Oseas","commonName":"Oseas","title":"OSEAS-GARDA OSEAS","order":28,"numberOfChapters":14,"sha256":"83bd62c55a7bba5a48eaf1823a3db7b5a7e35096fd8b9bfc0494b3a51b5aa246","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Bab-Dummadsurmaladse-gordimalad-ular, sabsur-odurdaklegoed"]},{"type":"verse","number":1,"content":["Bab-Jehová sogdebalid:",{"text":"“¡Gar-trompeta be ogole!","poem":1},{"text":"Ar sulubagi anse-goled-neggi sigdanikid.","poem":2},{"text":"Ar Israel-dulemar, anbo-igar-mesisad obelosmalad,","poem":1},{"text":"an-Igar-Maidgi yolesmalad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Emide, anse wiledanimalad. Weyob sogmalad:","poem":1},{"text":"‘Israel-Bab-Dummadye, be anmar-Bab-Dummadid, anmar wisye.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Degi-inigwele, Israel-dulemar igar-nued obachamalad,","poem":1},{"text":"a-ulale, e-isdarmalad e-baleginmaloed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"An-sogedbarsuli reymar-omesdimalad.","poem":1},{"text":"Yogasaar dulemar-an-akudaked dummaganga nug-imakdimalad.","poem":2},{"text":"Na dukin san-wiomalaga e-manimargine, e-ormargine,","poem":1},{"text":"bab-dummadyob-imaklemalad sobdimalad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¡Samaria-dulemar! Moli-bebe-nikad-sapingwagwad bab-dummadyob be sedimalad be metemala.","poem":1},{"text":"An bemargi an nue-urwed.","poem":2},{"lineBreak":true},{"text":"¿Ar sana bemar san-swilidiksuli-gudii gumaloe?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¡Israel-dulemar! We-moli-bebe-nikad-sapingwagwad Bab-Dummadsulid.","poem":1},{"text":"Ar wede, dule-sobedid.","poem":2},{"lineBreak":true},{"text":"Samaria-dulemar-e-moli-sobaled, an bela bibisgoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"”Ibmar-isgana be imaksamalad,","poem":1},{"text":"degisoggu, boni-dummad begi aibinnonikoed.","poem":2},{"text":"Trigo-e-war san sated, degisoggu, madubur nikuosulid.","poem":1},{"text":"Ar trigo-e-war wis e-san-nikunonikile, dule-bamalad-e-masga guoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Israel-yar bela ibitosad,","poem":1},{"text":"emi-ibagi, dulemar-yar-baid-baidgi-bukwamalad-abargi bai daklesulid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Israel-dulemar aka Asiria-dulemarse bendakleged egichisgusmalad.","poem":1},{"text":"Moli-sapur-uayasuid-aku-neg-itogedyob angi bangudmalad.","poem":2},{"text":"Efraín-dulemar, igi-ome mani-amiega sui-bamaladbo mege,","poem":1},{"text":"deyobi gudmalad.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Efraín, bendaked-amiega, we-neggwebur-bamalad-manigi-bennus-inigwele,","poem":1},{"lineBreak":true},{"text":"gwen ega igarga guosulid.","poem":1},{"text":"Anse neggwebur-bamalad-dikasuli-bukwadse gales barmiledmaloed.","poem":2},{"text":"Rey-buledsega, dummagansega","poem":1},{"text":"sikwas sabsur-odurdakledii gumargweloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"”Efraín-dulemar, na be-isgued-eliegala,","poem":1},{"lineBreak":true},{"text":"bemar bab-dummadyob-imaklemaladga","poem":1},{"text":"ibmar-ogumakar-ukleged-aila-bukidar sobsamalad.","poem":2},{"lineBreak":true},{"text":"Ar wede, unnila isgued-ailaga be obinnismalad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar sunna an bemarga igar-nuegan-narmakar bukidar uksaled,","poem":1},{"text":"degi-inigwele, ar bemar an-igar gwen bai daksasurmalaled.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Be anga ibmar-ogumakar-uked yeer-itodamalad,","poem":1},{"text":"be a-san gundamarbalid.","poem":2},{"text":"Degi-inigwele, ulubgi-napiragwadgi-imaksulidba we-ibmar-imakleged,","poem":1},{"text":"an gwen nabir daksulid.","poem":2},{"text":"Degisoggu, bemar-isgued an iegosulid,","poem":1},{"text":"an sabsur-bemar-odurdakedsemalad.","poem":2},{"lineBreak":true},{"text":"Gannar bemar Egipto-yarse namaloed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israel-dulemar, ani an bemar-obinyedid,","poem":1},{"text":"degite, bemar an-iedmalad.","poem":2},{"text":"Nega-dummagan-yeerdaklemalad be sobdemalad.","poem":1},{"text":"Judá-dulemar, neggwebur-galu-matusurmalad omelodmalad.","poem":2},{"text":"Degi-inigwele, bela bergumalaga, e-neggweburmargi, e-galu-matusurmaladgi,","poem":1},{"text":"soo an odegoed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}