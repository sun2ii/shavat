{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"HOS","translationId":"cuk_nvs","name":"Oseas","commonName":"Oseas","title":"OSEAS-GARDA OSEAS","order":28,"numberOfChapters":14,"sha256":"83bd62c55a7bba5a48eaf1823a3db7b5a7e35096fd8b9bfc0494b3a51b5aa246","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/cuk_nvs/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Israel-dulemar sabsur-odurdaklegoed"]},{"type":"verse","number":1,"content":["Oseas, Israel-dulemarga sogded:",{"text":"“Israel-dulemar, mer be weligwar-itomar,","poem":1},{"text":"mer be neggwebur-baiganyob iba-onomar.","poem":2},{"text":"Ar bemar galagwensuli nanadmalad.","poem":1},{"text":"Be-Bab-Dummadgi be bangudmalad,","poem":2},{"lineBreak":true},{"text":"bab-dummad-baigan-nug be odummodmalad.","poem":2},{"text":"Bela ibmar-gwag-omukuleged-neggi gambasaed-e-mani-bennukleged bur be abeged.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"A-ulale, ibmar-gwagmar, uvaʼmar gwen be-oimmogosurmalad.","poem":2},{"lineBreak":true},{"text":"Vino-binid bar yeer-goblege guosulid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Efraín-dulemar Bab-Jehová-yargi bar ambikuosurmalad,","poem":1},{"text":"gannar Egipto-yarse-namaloed.","poem":2},{"lineBreak":true},{"text":"Asiria-yargi mas-isemalad gunmaloed.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bab-Jehováʼga bar vino-eoleged ukosurmalad,","poem":1},{"text":"e-ibmar-Bab-Dummadga-ukmalad, bar ega ibnuedga guosulid.","poem":2},{"text":"Madu-gullegoedi dulemarga madu-dule-burgwaled-neggi-gullegedyob ega guoed.","poem":1},{"text":"Dule a-madu-guchale, swilidiksuli guoed.","poem":2},{"text":"Unnila sikwas nabir-itogega ega guoed.","poem":1},{"text":"Degi-inigwele, we-madu, Bab-Jehová-negse seledosulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"”Bab-Dummadga-iba-onolegedgi ¿ibu-be imakmaloe?","poem":1},{"text":"Bab-Dummadga-itoakwaa iba-onolegedgi, ¿ibu-be imakmarbaloe?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amba sabsur-odurdaklegedgi be wakinye sogmalale,","poem":1},{"text":"Egipto-dulemarse be galemaloed,","poem":2},{"lineBreak":true},{"text":"degi, Menfis-neggweburgi be-digmaloed.","poem":2},{"text":"Be-ibmar-nuegan-manigi-sobarmaladgi, dakemar ammurudoed,","poem":1},{"text":"be-dordonegmargi ikomar ammurudoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sabsur-odurdakleged-iba noni,","poem":1},{"text":"buged-imakleged-iba noni.","poem":2},{"text":"Israel-dulemar, ¡be wisigarmar!","poem":1},{"text":"Be-isgued dogdargusad,","poem":2},{"lineBreak":true},{"text":"isdar-emar-dakedi be baligannosad.","poem":2},{"text":"Emide bemar, Bab-Dummad-gayaburba-barsoged dule-gegegwaga imakmalad.","poem":1},{"text":"Deginbali, nia-saedga be Dule-Bab-Dummad-burbaba-ibmar-soged imakmalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bab-Dummad-gayaburba-barsogedi, Bab-Dummadmala, Efraín-neggweburga nakulegedga gumalad.","poem":1},{"text":"Wemar-yolemalagala, bemardi sakiyob e-idu galumar-urbedamalad,","poem":2},{"lineBreak":true},{"text":"deginbali, Bab-Dummadse-goled-neggi bemardi wemar-sae-dakdamarbalid.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bemar Gabaaʼgi-dulemar-gusmaladyobi,","poem":1},{"text":"nue bela-belad be isgudmalad.","poem":2},{"text":"Ar Bab-Dummadi, be-isgued iegosulid,","poem":1},{"text":"be-isguedba sabsur-bemar-odurdakoed.”","poem":2}]},{"type":"verse","number":10,"content":["Bab-Jehová sogded:",{"text":"“An Israel-dulemar-aminonigu,","poem":1},{"text":"nega-dulesulidganba uva-san-amilegedyob an amisgusad.","poem":2},{"text":"An gebe e-dadgan-dakargua,","poem":1},{"text":"higuera-sapigi-e-san-dutuu-ainidanikiyob an daksad.","poem":2},{"text":"Degi-inigwele, emar aka bab-dummadyob-imakleged-Baal-Peorʼba nanadmalad.","poem":1},{"text":"Abali na isgudmalad, dule-isguedga gudmalad.","poem":2},{"lineBreak":true},{"text":"We-bab-dummadbina sulibinsa-itode gudmalad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraín-dulemar-e-ibmar-nuegan-bukidar-nikadi bar daklegosulid. Nuu-gukudeyob guoed.","poem":1},{"text":"E-omegan bar gurgin-nika guosurmalad, bar mimmigan-nikuosulid.","poem":2},{"lineBreak":true},{"text":"E-dula bar sapibeneggi-mai guosulid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar amba e-mimmigan-dungumamai-dakdemalale,","poem":1},{"text":"we-napneggi amba an ei obelogoed.","poem":2},{"text":"An egi bangudele, ¡dummad-wilemaloed!","poem":1}]},{"type":"verse","number":13,"content":[{"text":"Efraín-yala, Tiro-yalayob-dakleged.","poem":2},{"text":"Yala-nuedgi bukwamalad.","poem":1},{"text":"Degi-inigwele, Efraín-dulemardi burgwed-igarba na e-mimmigan-semamaid.”","poem":2}]},{"type":"heading","content":["Oseas-Bab-Dummadse-gochad"]},{"type":"verse","number":14,"content":["Oseas sogded:",{"text":"“Bab-Jehová, ega be ibmar-ukbied ukdo.","poem":1},{"text":"Ega e-omegan mellegega be imake,","poem":2},{"lineBreak":true},{"text":"e-omegan-e-nunismar be odinnoge.”","poem":2}]},{"type":"heading","content":["Bab-Dummad Oseas-abin-imaksad"]},{"type":"verse","number":15,"content":["Bab-Jehová soged:",{"text":"“Israel-dulemala, Gilgal-neggweburgi bela isguali gudmalad.","poem":1},{"text":"De-akale, an bemar isdar dakded.","poem":2},{"text":"Bemar-isgued-ulale, anse-goled-neggi an bemar-onioed.","poem":1},{"text":"Bar an bemar-sabguosulid,","poem":2},{"lineBreak":true},{"text":"ar ade, bela be-dummagan uayasulidamalad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Efraín-dulemar galakuded:","poem":1},{"text":"Sapi-mali-dingudedyob nadmalad,","poem":2},{"text":"sapi-bar-sanmaksurmaladyob nadmalad.","poem":1},{"text":"Amba na mimmigan-nikudmalale, an ei oburgoed.”","poem":2}]},{"type":"heading","content":["Oseas Israel-dulemarga sogded"]},{"type":"verse","number":17,"content":["Oseas Israel-dulemarga sogded:",{"text":"“Ar bemar, an-Bab-Dummadba ibsassurmarsoggu, Bab-Dummad bemar-obanoed.","poem":1},{"text":"Neggwebur-baigan-abargi yarsuli be gudii gumaloed.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}