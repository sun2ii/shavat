{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"heading","content":["Judá-dulemar Bab-Dummadgi nue isgus-bukwad"]},{"type":"verse","number":1,"content":["Judá-e-reymar: Uzías, Jotam, Acaz, degi, Ezequías, amar-negdakmamaidgine, Amoz-machi-Isaías, Judá-yargi, degi, Jerusalén-neggweburgi neg-guoed daksad."]},{"type":"verse","number":2,"content":[{"text":"¡Nibneggi-bukmalad, an-itomalo!","poem":1},{"text":"¡Napneggi-bukmalad, an-itomalo!","poem":2},{"text":"Bab-Jehová weyob soged: “Ani an an-mimmigan akwisad, an na odummosad,","poem":1},{"text":"degi-inigwele, angi gwisgudmalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Moli-bebe-nikad-alugwasualed, e-ibed magar daked.","poem":1},{"text":"Moli-uayasuid, moli-urbed-galu-e-ibedgad magar daked.","poem":2},{"text":"Degite, Israel-dulemardi, akusunna itomalad,","poem":1},{"text":"an-dulamardi, aku ibmar dakmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"”Dulemar-nue-isgus-bukwamalad, ¡ibitosmar!","poem":1},{"text":"Dule-nue-isguedgi-bipirmaksa-bukwamalad, ¡ibitosmar!","poem":2},{"text":"Dule-ibmar-isgana-imakmalad-e-wagan-bukwad, ¡ibitosmar!","poem":1},{"text":"Dule-gwage-isgus-gudimalad-e-mimmigan-bukwad, ¡ibitosmar!”","poem":2},{"text":"Ar bemar, ¡Bab-Jehováʼgi bangudmalad!","poem":1},{"text":"¡Israel-e-Bab-Dummad-Isligwaled isdar dakdemalad!","poem":2},{"lineBreak":true},{"text":"¡Gannar sorsik aibiridmalad!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Ibiga amba sabsur-odurdakledii gubimarsunna?","poem":1},{"text":"¿Ibiga uayasuli-gudii gubimarsunna?","poem":2},{"text":"Bela e-nono, ise-nailikguar siid,","poem":1},{"text":"bela e-gwage nued naisulid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bela e-nag-duku-akale, nonosega, e-san-nued wis naisulid,","poem":1},{"text":"bela oitolesadbi nanaed.","poem":2},{"text":"E-san, gudure-gudure nanaid.","poem":1},{"text":"E-yaamar-bukwadi, nunu-yapanne nanaed,","poem":2},{"text":"ar gwen nugussuli nanaed,","poem":1},{"text":"morgi-obipirmakar naisurbalid,","poem":2},{"lineBreak":true},{"text":"olivo-gwallugi maglegarsurbalid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E-yala, nue-bergus naid.","poem":1},{"text":"E-neggweburmar, bato soogi-ogumakles bubukwad.","poem":2},{"text":"Emar-sunnagwad na dakmaloed,","poem":1},{"text":"igi-dule-baigan e-ibmar-digar-nanaid gutemaloe.","poem":2},{"text":"E-yala, olloo naioed,","poem":1},{"text":"dule-bamaladse e-yala obelolesadyob naguoed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sión-yala, uva-nainugi binsa dukued-neg olloo-siidaedyobi daklenaded.","poem":1},{"text":"Melón-digar-naidgi, binsa neg-ollobi-siidyobi daklenaded,","poem":2},{"lineBreak":true},{"text":"neggwebur, dule-isdarmaladse ebirilessiidyob gued.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ar Bab-Jehová-Bela-Gangued-Nikad anmar-gwenna-gwenna-odulossulina,","poem":1},{"text":"Sodoma-dulemaryob anmar gumogoenad,","poem":2},{"lineBreak":true},{"text":"Gomorra-dulemaryob anmar obelolemogoenad.","poem":2}]},{"type":"heading","content":["Napiragwadgi e-isguedga-bukib-binsamarye ega soglenaid"]},{"type":"verse","number":10,"content":[{"text":"Sodoma-e-dummagan, Bab-Jehová-ibmar-soged be itomar.","poem":1},{"text":"Gomorra-neggwebur, anmar-Bab-Dummad-Igar-Maid be itomar.","poem":2}]},{"type":"verse","number":11,"content":["Bab-Jehová soged:",{"text":"“Be-ibmar-ukleged-bukidaradi, ¿ibi-nuedga anga wis gue?","poem":1},{"text":"Ar gwen an abemaisulid.","poem":2},{"text":"Ar sibad-wawaad-machergan-ogumakar-anga-ukleged an budar dakgusad.","poem":1},{"text":"Ar ibdurgan-wardummagan-e-gwallu-anga-ukleged an budar dakgusad.","poem":2},{"text":"Moli-bebe-nikad-machergan-e-ablis an abesulid,","poem":1},{"text":"sibad-wawaadmar-e-ablis an abesulid,","poem":2},{"text":"sibad-machergan-e-ablis an abesulid,","poem":1},{"text":"we-ibmarmar, gwen bai an daksulid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"¿Ibiga be an-asabin danimala?","poem":1},{"text":"¿Doa bega ibdurgan-sedamaloye sogsa?","poem":2},{"lineBreak":true},{"text":"Unnila anse-goled-neg-imba-oichogega be nonidamalad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Melle bar be anga ibmar-ukleged-gwen-igarga-gusulid sedamalo.","poem":1},{"text":"Ar ina-wawadikid anga ibmar-isganaga gued.","poem":2},{"text":"Nii-binidgi, iba-onoleged an budar dakgusad,","poem":1},{"text":"obunnoged-ibagi, iba-onoleged an budar dakgusad,","poem":2},{"text":"dulemar-bular-onmaknonidamalad an budar dakgusad,","poem":1},{"text":"be-an-nug-odummomalad, aka bur an-ourwe damalad, bar an itobisulid.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bemar nii-binid-gwisguedgi iba-onogedi, an budar itogusad.","poem":1},{"text":"Itoakwaa-iba-onolegedi, an budar itogusad.","poem":2},{"text":"Ibmar-nuedga gwen anga gusulid,","poem":1},{"text":"abali, an budar itogusad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bemar anse-goledgi argan-onakwialile, an bemar-dakosulid,","poem":1},{"text":"wagar-biir an bemar-idu imakoed.","poem":2},{"text":"Ar gandikidgi bemar anse gornanaile, an bemar-itogosulid.","poem":1},{"text":"Ar bemar dulemar-ibe ablis eosmalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”¡Isguedgi be bangumar, swilidik be gumar!","poem":1},{"text":"¡An-asabin ibmar-isgana-imakedgi be bangumar!","poem":2},{"lineBreak":true},{"text":"¡Melle bar ibmar-isgana be imakmar!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"¡Igar-nuegan-imaked be durdakmar!","poem":1},{"text":"¡Igar-napiragwad be imakmar!","poem":2},{"text":"¡Dule-mesagwar-imaklediid be bendakmar!","poem":1},{"text":"¡Dule-sergan-satedga be igar nabomar!","poem":2},{"lineBreak":true},{"text":"¡Siamar-ei-sui-burgwismalad-ular, be gwisgumar!”","poem":2}]},{"type":"verse","number":18,"content":["Bab-Jehová soged:",{"text":"“Be dagmar, anmar igar nudakmargwelo.","poem":1},{"text":"Bemar-isgued, ginnitibiyob-gue-inigwele, boo-sibudikidyob-dakle naoed.","poem":2},{"text":"Bemar-isgued, mor-ginnidyob-gue-inigwele,","poem":1},{"text":"sibad-wawaad-e-absar-dagudikid-daklegedyob naoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ar bemar an-sogedba nanamaloye sogele,","poem":1},{"text":"be-yargi ibmar-nuegan-sanmakoedi be gunmaloed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ar bemar amba an-itosulile, angi be gwisgudmalale, es-suidgi be ogilolemaloed.”","poem":1},{"text":"Ar Bab-Jehová, e-sunnagwad deyob soged.","poem":2}]},{"type":"heading","content":["Jerusalén-neggweburga igar-nabolesad"]},{"type":"verse","number":21,"content":[{"text":"Neggwebur-innikigwad, ¿ibiyobi gambanuchusaedga be gusa?","poem":1},{"text":"Gebe-iduar, igar-napiragwadbi be imakdidaenad.","poem":2},{"text":"Igar-innikigwadbi begi nai gusanad.","poem":1},{"text":"Emide, unnila dule-gindakmaladbi begi gudigusmarsunnad.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Gebeunni be maniyob-gumalanad,","poem":1},{"text":"emidi, durganga-binnideyob be gudnanaed.","poem":2},{"text":"Vino-nuedyob be gumalanad,","poem":1},{"text":"emidi, vino dii-sunnabi-goblegeyob be gudnanaed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Be-dummagan-neg-dakmamaid dulegi-gwisgumaladid.","poem":1},{"text":"Amarde, dule-ibmar-atursamalad-e-sordamalad.","poem":2},{"text":"Manigi-dule-binsaed-gaedgi bela na yeer itodamalad,","poem":1},{"text":"dulemar-ega-ibmar-uked unnila abedamalad,","poem":2},{"text":"dule-sergan-sated-ular sunmakdasurmalad,","poem":1},{"text":"siamar-ei-sui-burgwismalad-e-igar gwen bai dakdasurmalad.","poem":2}]},{"type":"verse","number":24,"content":["A-ulale, Israel-dulemar-e-Bab-Jehová-Bela-Gangued-Nikad, weyob soged:",{"text":"“¡Wese ugaksun!","poem":1},{"text":"An-isdarmaladga an igar nudakoed,","poem":2},{"lineBreak":true},{"text":"an-isdarmalad an buged imakoed.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gannar an-argan an bemarse oyogoed,","poem":1},{"text":"bela be-isgued an elioed,","poem":2},{"lineBreak":true},{"text":"degi, bela begi ibmar-isgana-naid an osulogoed.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Bega dule-igar-nabomalad gebe-iduar-bukusadyob an oambikuoed,","poem":1},{"text":"dule-be-unamalad gebe-iduar-ambikusadyob an oambikuoed.","poem":2},{"text":"Degisoggu, Neggwebur-Innikigwadye be-nugsamaloed,","poem":1},{"text":"Neggwebur-Sogedba-Daedye be-nugsamaloed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Sión-yala, igar-innikigwadba bela-belad bendaklegoed,","poem":1},{"text":"dulemar e-isguedga-bukib-binsamalad igar-napiragwadba, bela-belad bendaklegoed.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Degi-inigwele, dule-uayasulidamaladdi, isguedgi-gudimaladdi, obelolegoed.","poem":1},{"text":"Ar dule-Bab-Jehová-obandimaladdi, oburgwilegoed.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Bemar we-sapimarbina nue-sogdimaladgi bemar nue-bingedar itomaloed,","poem":1},{"text":"we-dutugalubina be nue-sogdimaladgi bemar nue-undar bingegumaloed.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bemar, sapi-e-gagan-dinguddaeyob gudmaloed,","poem":1},{"text":"dutu-digaled dii-sate-gugwichidyob gudmaloed.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Dule-gala-ibedi, gagan-durgan-milegeyob naoed,","poem":1},{"text":"e-arbaedi, ilagwen-bergus naoed,","poem":2},{"text":"ebobela soogi-ogalegoed,","poem":1},{"text":"dule gwen soo oginnosulid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}