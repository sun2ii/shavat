{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":10,"content":[{"type":"heading","content":["Israel-dummaganga ibmar-soglenaid"]},{"type":"verse","number":1,"content":[{"text":"Dule, igar-isgana-omesmalad, be duledar-wilesmar.","poem":1},{"text":"Dule, dulemar-idu igar-yeer-gangu-omesmalad, be duledar-wilesmar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bemar, dule-wilemalad-ibmar-nikuega be imaksurmalad,","poem":1},{"text":"an-dula-wilesagwa-gudimaladga be igar nudaksurmalad.","poem":2},{"text":"Siamar-ei-sui-burgwisadi, be wiodimalad,","poem":1},{"text":"dule-sergan-sated-ibe be ibmar atursadimalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bemar sabsur-odurdaklealile, ¿bemar igi imakoe?","poem":1},{"text":"Boni-dummad bannaba-nosa begi-dani be dakalile, be-bendakega, ¿doase be goloe?","poem":2},{"lineBreak":true},{"text":"¿Bia be-ibmar-nuegan be odukumaloe?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ar be bar oakalogosurmalad.","poem":1},{"text":"Ar bemar gales seledmaloed.","poem":2},{"text":"Emar-gales-bukwad-abargi be mesagwar gumarmogoed.","poem":1},{"text":"Sulile, burgwarmalad-imbagi be oburgwilemarmogoed.","poem":2},{"lineBreak":true},{"text":"Weyob bemar imaklego-inigwele, Bab-Dummad-urwedi, amba bogigumaiosulid,","poem":1},{"text":"Bab-Dummad amba amargi urwemaioed.","poem":2}]},{"type":"heading","content":["Bab-Dummad Israel-dulemargi Asiria-sordamar barmidagoed"]},{"type":"verse","number":5,"content":["Bab-Jehová weyob soged:",{"text":"“An bela-bela sae-itoged,","poem":1},{"text":"Asiria-e-Rey anga sabsur-odurdaked-suaryobi guoed.","poem":2},{"text":"A-suargine, an sabsur-dulemar-odurdakoed.","poem":1},{"text":"An isdar-itogedbali, a-suar an ebugoed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yala-nue-isgus-naidse an barmidoed,","poem":1},{"text":"dulemar an-ourwega-imakbukwadse an barmidoed,","poem":2},{"lineBreak":true},{"text":"adi, ibmar ei atursanaega, e-ibmar ei bela weenaegar.","poem":2},{"text":"Igi-dule dii-dii napa-imake,","poem":1},{"text":"deyob-emar-imaklegega an barmidoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ar Asiria-e-reydi deyob-imakodeeye gwen binsassulid,","poem":1},{"text":"deyob-imakedgi gwen binsassulid.","poem":2},{"text":"Unnila dulemar-obelogedginbi binsaed,","poem":1},{"text":"unnila bukidar yar-baigan-osulogedginbi binsaed.”","poem":2}]},{"type":"verse","number":8,"content":["Bab-Jehová weyob soged:",{"text":"“Ar ade, Asiria-e-rey weyob soged:","poem":1},{"text":"‘¿Ar reymarde anga dummaganga-arbabukwadbisursi?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¿Ar Calno-neggwebur, Carquemis-neggweburyob gussursi?","poem":1},{"text":"¿Hamat-neggwebur, Arfad-neggweburyob gussursi?","poem":2},{"lineBreak":true},{"text":"¿Ar Samaria-neggwebur, Damasco-neggweburyob gusmosursi?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"An ibmar-bab-dummadyob-imakleged-yalamar obelos gusad.","poem":1},{"text":"A-yalamar, Jerusalén-neggweburba, degi, Samaria-neggweburba,","poem":2},{"text":"bur bule melu ibmar-bab-dummadyob-imaklemalad nikagusana,","poem":1},{"text":"degite, an obelosad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"An igi Samaria-neggwebur-imaksa,","poem":1},{"text":"degi, igi e-ibmar-bab-dummadyob-imaklemaladse-bakale, an obelosa,","poem":2},{"text":"deyob an Jerusalén-neggwebur imakoed.","poem":1},{"text":"E-ibmar-bab-dummadyob-imaklemaladse-bakale, an obelomogoed.’ ”","poem":2}]},{"type":"verse","number":12,"content":["Bab-Jehová, Sión-yalagi-ibmar-imakoed bela-obelosale, degi, Jerusalén-neggweburgi-ibmar-imakoed bela-obelosale, sogdagoed: “Asiria-e-rey-san-dummarba-itogedba an sabsur-odurdakoed, emar-saedakedba an sabsur-odurdakoed.”"]},{"type":"verse","number":13,"content":["Ar ade, Asiria-e-rey weyob soged:",{"text":"“We-ibmar an-ganguedba an imaksad,","poem":1},{"text":"an-binsaed-nikaa-daedba an imaksad,","poem":2},{"lineBreak":true},{"text":"ar ande, nue-ibmar-wisid-duled.","poem":2},{"text":"Ani an neggweburmar-e-abingunanaid ogwasad,","poem":1},{"text":"ani an e-ibe ibmar-nuegan atursasad,","poem":2},{"text":"ani an sorda-bila-onoged-buled-guedsoggu,","poem":1},{"text":"an e-reymar-obelosad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"E-yalamar bela e-ibe an susad.","poem":1},{"text":"Igi dule sikwi-e-akwa-bukwad weedae,","poem":2},{"lineBreak":true},{"text":"deyobi, an e-ibe e-yalamar susad.","poem":2},{"text":"Igi dule sikwi-uu sudae,","poem":1},{"text":"deyobi, dule-e-ibmar-nuegan-nikad an susad.","poem":2},{"text":"An-abinni, dule-wargwensaale gochasulid,","poem":1},{"text":"dule gwen akar sogsasulid.”","poem":2}]},{"type":"verse","number":15,"content":["Isaías weyob soged:",{"text":"“¿Ar akande sunna dule-e-ebunaidba bur san-gannarbaa na imaksi?","poem":1},{"text":"¿Ar sunna esnali-sapisikedde dule-e-ebunaidba bur bule-bule na san-imaksi?","poem":2},{"text":"¿Gaapoledde, dule-e-ganikidgi obinosi?","poem":1},{"text":"¿E-nabiedba naosi?","poem":2},{"text":"¿Bia be daksa, suar-garagwadi, sapiwar-dummad-nakwaa imake?","poem":1},{"text":"Deyob be dakdisulid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"”A-ulale, Bab-Jehová, Bab-Jehová-Bela-Gangued-Nikadi, Asiria-e-rey-sorda-bila-onomalad-bulegangi boni-dummad barmidagoed.","poem":1},{"text":"Amar-e-nug-odummoleged-muchubbi, uelleged-dummad ega ukoed,","poem":2},{"lineBreak":true},{"text":"uellegedi sooyobi uegu egi nasikoed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bab-Dummad-wargwenna-guedi, Israel-dulemarga-neg-meegwadyobi-guedi, soo-gaeyobi gudoed.","poem":1},{"text":"Bab-Jehová-Isligwaled soo-gwichigumaidyob gudoed.","poem":2},{"text":"Ibagwen-nuedi, Asiria-sordamar-obelogoed,","poem":1},{"text":"ikomaryobi, gagan-ikomaryobi, soogi bela obelogoed.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bab-Dummad, bela Asiria-e-sapur-yeerdakle-nanaidi, e-nainu-nanaidi, obelogoed.","poem":1},{"text":"Dule-geg-bar-gugus-gegumaiyobi bela ibmar nasikoed.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sapur-naidgi sapimar napi-ichee ambikuoed.","poem":1},{"text":"Ichegwadbali, burwigana sunna ebisge guoed.”","poem":2}]},{"type":"heading","content":["Israel-dulemar-napi-bemaloed"]},{"type":"verse","number":20,"content":[{"text":"A-ibagangine, Israel-dulemar-napi-bemaloedi, Jacob-wagan-napi-gudimaloedi, dule-e-obelosmaladba bar naguosurmalad.","poem":1},{"text":"We-napi-bemaloedi, Israel-e-Bab-Dummad-Jehová-Isligwaledba, nue innikigwadba nagumaloed.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Israel-dulemar-napi-bemaloedi, gannar Bab-Dummadba nagudmaloed,","poem":1},{"text":"Jacob-wagan-dula-napi-gudimaloedi, Bab-Dummad-Bela-Gangued-Nikadba gannar nagudmaloed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Israel-dulemar, bemar ukub-demar-gakaba-mergueyob-guen-inigwele,","poem":1},{"text":"unnila bemar napi-ichee gannar nonimaloed.","poem":2},{"text":"Israel-dulemar-obelolegoye bato soglesmaid.","poem":1},{"text":"Bela ega igar nabolegoed.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ar Bab-Dummad-Jehová-Bela-Gangued-Nikad, Israel-dulemar-obelolegoye bato sogsad.","poem":1},{"text":"Ar deyob yargi-gudimaladgi imakoed.","poem":2}]},{"type":"verse","number":24,"content":["A-ulale, Bab-Dummad-Jehová-Bela-Gangued-Nika-Maid weyob soged:",{"text":"“An-dulamar, be Sión-yalagi-bukwamalad,","poem":1},{"text":"melle be Asiria-dulemar dobee itomalo.","poem":2},{"text":"Asiria-sordamar gaapoledgi be-sarsomalo-inigwele,","poem":1},{"text":"begi suar-oyodamalo-inigwele, melle dobgumalo.","poem":2},{"text":"Igi-Egipto-dulemar bemar-imaksagusa,","poem":1},{"text":"deyob bemar-imakdago-inigwele, melle be dobgumalo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Emisgwasaale, bemargi an-nue-sae-itogedi berguoed.","poem":1},{"text":"An-urwedi, be-isdarmaladgi yoledoed.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Bab-Jehová-Bela-Gangued-Nikad, Asiria-dulemar-sabsur-odurdakoed.","poem":1},{"text":"Bab-Jehová, igi-akwasaila-Orebʼye-nugadgi Madián-dulemar-imaksagusa,","poem":2},{"lineBreak":true},{"text":"deyob Asiria-dulemar-imakoed.","poem":2},{"text":"Bab-Dummad, igi-Egipto-dulemar-igarba-nadapgu e-gaapoled-oyosgu, egi demar-arwega-imaksagusa,","poem":1},{"text":"deyob Asiria-dulemar-sabsur-imakoed.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"A-ibagangine, bemar we-boniganba-galitodiidi bela bega berguoed,","poem":1},{"text":"bemar gangudoedba, sabsur-wilediidgi be ollorgudmaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Be-isdarmalad-Asiria-sordamar Ajatʼye-neg-nugadgingus naid,","poem":1},{"text":"Migrónʼye-neg-nugadgi nadapid,","poem":2},{"lineBreak":true},{"text":"Micmasʼye-neg-nugadgi e-ibmarmar obesad.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Diwar-dinnagwadgi obakmamaid,","poem":1},{"text":"degi weyob sogmalad: “Gebaʼye-neg-nugadgi anmar obunnomaloye.”","poem":2},{"text":"Ramá-dulemar dobedba wawanmakdemalad,","poem":1},{"text":"Saúl-neggwebur-Gabaaʼginmalad duurmakdemalad.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"¡Omegan-Galim-neggweburginmalad binnasur be oimakmala!","poem":1},{"text":"¡Omegan-Lais-neggweburginmalad be itomala!","poem":2},{"lineBreak":true},{"text":"¡Anatot-neggwebur be abinsamarmoga!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Madmena-dulemar wakitemalad,","poem":1},{"text":"Gebim-dulemar dukudmalad.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Emi-ibagi, Asiria-sordamar Nobʼye-neg-nugadse ambikunonimaloed.","poem":1},{"text":"Sión-yalagi gwichiguega, guagwar ambikumaloed.","poem":2},{"lineBreak":true},{"text":"Siónʼde, Jerusalén-e-yalad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"¡Nue be dake!","poem":1},{"text":"Bab-Dummad-Jehová-Bela-Gangued-Nikad-abin, sapi-anagan doos-doos naded.","poem":2},{"text":"Sapi-suigan bibichis nanaed, sapi-dummagan e-abin ailade nanaed.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Sapi-moodo-naidi, akangi immided,","poem":1},{"text":"Líbano-yargi sapimar-yeerdakle-bukwad bela berguded.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}