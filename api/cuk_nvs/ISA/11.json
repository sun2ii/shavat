{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["Mesías Igar-innikigwadba yar-seoed"]},{"type":"verse","number":1,"content":[{"text":"Sapi-siklesad-gannar-ainieyobi, dule-Isaíʼye-nugadgi dule-gwensak nodagoed.","poem":1},{"text":"E-wagangine, a-dule danikoed.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"A-dulegi Bab-Jehová-E-Burba megoed:","poem":1},{"text":"Nue-binsaed-nikagued ega ukoed,","poem":2},{"lineBreak":true},{"text":"nue-ibmar-magar-itoged ega ukoed,","poem":2},{"text":"binsaed-nued-uke imakoed, degi, gangued-nika imakoed,","poem":1},{"text":"gurgin-nikarba imakoed, degi, Bab-Jehová-dobee-nanadii imakoed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"We-dule, Bab-Jehová-dobee-nanaoedba yeer-itodii guoed,","poem":1},{"text":"dulemar-daklegedba dulemarga igar nabogosulid,","poem":2},{"lineBreak":true},{"text":"dulemar-ibmar-sogedba igar nudakosulid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dule-wilemaladga igar-napiragwadba igar nabogoed,","poem":1},{"text":"degi, igar-innikigwadba dule-belagwadaedga igar nudakoed.","poem":2},{"text":"E-sunmakedba dule-bukwad-obelogoed,","poem":1},{"text":"e-ibmar-sogedba dule-isgana-oburgoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Igar-napiragwadi, molidub-saderba-naiyobi, oyodii guoed.","poem":1},{"text":"Innikidaedi, e-musir-edinnedyobi, oyodii guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Achu-burburud, sibad-wawaad-senigwad-ebo gudii guoed.","poem":1},{"text":"Achu-barbad, sibad-bipi-ebo dodomai guoed.","poem":2},{"text":"Moli-bebe-nikad-sapingwagwad, achumigur-nono-wawaad-bipigwadmala garmakdii gumaloed.","poem":1},{"text":"Machi-bipigwa a-ibmar-durgan-idudii guoed.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Moli-bebe-nikad-ome, wiob-omemala garmadii guoed,","poem":1},{"text":"e-mimmigana bulakwaa gudii gumogoed.","poem":2},{"text":"Achumigur-nono-wawaad, moli-bebe-nikad-alugwasualedyob gagan-madii gumogoed.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Goe-susugwa-amba yoo-mam-iargued, naibe-buled-galu-dikarba dodonai guoed.","poem":1},{"text":"Mimmi-gebe-mam-iargusadi, naibe-nued-e-yaa-yaba e-argan ododii guoed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"An-Yala-Islidikid-Naidgi gwen dulemar neg-oichodii guosurmalad,","poem":1},{"text":"gwen oakalogosurmalad,","poem":2},{"text":"ar ade, bela yar-naidgi, Bab-Jehová-magar-dake nanadii gumaloed.","poem":1},{"text":"Muu-billi-dii-bela-engus-naiyobi, bela Bab-Dummad-magar-dake gumaloed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"A-ibagangine, Isaí-e-wagangi-dule-danikoedi, dulemar-iduedga guoed.","poem":1},{"text":"Bela dulemar-yar-baid-baidgi-bukwamalad ese duurmaknonimaloed.","poem":2},{"lineBreak":true},{"text":"E-neg-megoedi gandikidba-yeerdaklege guoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"A-ibagangine, Bab-Jehová bela e-dulamar-amba-yar-baid-baidgi-mimiles-bubukwad","poem":1},{"text":"gannar-sedagega imakoed.","poem":2},{"text":"We-yarmargi mimiles bubukwad:","poem":1},{"text":"Asiria-yalagi, Egipto-yalagi,","poem":2},{"lineBreak":true},{"text":"Patros-yalagi, Cus-yalagi,","poem":2},{"lineBreak":true},{"text":"Elam-yalagi, Sinar-yalagi, degi, Hamat-yalagi,","poem":2},{"lineBreak":true},{"text":"degine, demar-gakagi-besmalad.","poem":2},{"text":"Wemar gannar senonikoed.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"We-dule-danikoedi, dule-ebiega bandergwichiyobi guoed,","poem":1},{"text":"bela-dulemar-yar-baid-baidgi-bukmalad ese duurmaknonimaloed.","poem":2},{"text":"Deginbali, bela Israel-dulemar, degi, Judá-dulemar, galesadba-akar-akar-aisakis-bukwamalad","poem":1},{"text":"gannarse danakwaa urboed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Efraín-dulemar nobed surgudoed,","poem":1},{"text":"Judá-dulemar-e-isdarmalad bela obelolegoed.","poem":2},{"text":"Efraín-dulemar, Judá-dulemargi bar nobguosulid,","poem":1},{"text":"Judá-dulemarmoga Efraín-dulemar-mesagwar bar imakosurmogad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aka, emar ebogwa, Filistea-dulemargi dad-argwanedsik-bukmaladgi gwisgudmaloed.","poem":1},{"text":"Emar ebogwa, dulemar-dad-nakwedsik-bukmalad-ibe ibmar atursadmaloed.","poem":2},{"text":"Edom-dulemar, Moab-dulemar, degi, Amón-wagan, amarse sabsur-wilemarmogoed.","poem":1},{"text":"Amar-sogedba ibmar imakmaloed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bab-Jehová, Egipto-demar-sukun-naid bela dinna nasikoed.","poem":1},{"text":"Éufrates-diwargi e-argan oyogoed,","poem":2},{"text":"egi burwa-uereged barmidagoed,","poem":1},{"text":"geb we-diwargi dian-sogagugle (7) mesoed,","poem":2},{"lineBreak":true},{"text":"adi, nabir nagab obakmalagar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Igi-Israel-dulemar Egipto-yargi-nosmargu, ega nanaed-igar maigusa,","poem":1},{"text":"deyobi, Israel-dulemar-Asiria-yargi-napi-besmaladga nanaed-igar mai gumogoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}