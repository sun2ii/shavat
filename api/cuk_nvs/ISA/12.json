{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Bab-Dummad-nug-odummogedgi namakleged"]},{"type":"verse","number":1,"content":["A-ibagangine, weyob be sogdoed:",{"text":"“Bab-Jehová, be anse ulus-inigwele,","poem":1},{"text":"an bega namakoed.","poem":2},{"text":"Be-urwediid bergunonikid,","poem":1},{"text":"be an-gwage baisur-itogega imaknonikid.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bab-Dummad, an-abonogedid.","poem":1},{"text":"An egi benguosulid, an dobee itogosulid.","poem":2},{"text":"Bab-Jehová, be an-ogannogedid,","poem":1},{"text":"Bab-Jehová, anga namakedga gued,","poem":2},{"lineBreak":true},{"text":"be an-abonogedga gued.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Deginbali, bemar abonolegedgi weligwar itomaloed,","poem":1},{"text":"bela-bela be Bab-Dummad-e-abonolegedgi yeer itomaloed.","poem":2}]},{"type":"verse","number":4,"content":["A-ibagangine, weyob sogledoed:",{"text":"“Bab-Jehováʼga be namakmar,","poem":1},{"text":"e-nug be odummomar,","poem":2},{"text":"bela-dulemar-napneggi-bukmaladga e-ibmar-imakedgi be sunmakmar,","poem":1},{"text":"e-nug-dummarba-guedgi be sunmakmar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehováʼga ega-namaklemaladgi be namakmar,","poem":1},{"text":"ar ade, ibmar-gegerdaklemalad imaksad.","poem":2},{"lineBreak":true},{"text":"We-ibmar-gegerdaklemalad bela we-napneggi dulemar-wisguega be imakmar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sión-yalagi-bukmalad, weligwaledba be namakmar, weligwaledba be gormakmar.","poem":1},{"text":"Israel-dulemar-e-Bab-Dummad-Isligwaled, bemar-abargine Dule-Gandikidid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}