{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["Isaías, Babilonia-yala-yoedse-berguoedgi sunmaksad"]},{"type":"verse","number":1,"content":["Bab-Dummad Amoz-machi-Isaíasʼga Babilonia-dulemar-berguoedgi sunmaksad:"]},{"type":"verse","number":2,"content":[{"text":"Yala-swire-naidgi bander be mer-mer imakmar,","poem":1},{"text":"sorda-bila-onomaladse be binnasuli gormar.","poem":2},{"text":"Argan ese be oyomar,","poem":1},{"text":"adi, dule-nuga-nikamalad-yawagakba ubomalagar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anga-nug-salegarmaladga bato an igar-uksad.","poem":1},{"text":"Anga-dule-bulegan-gumaladi, an-nakwedgi-na-yeer-itodimaladi, an guakwaa urbisad,","poem":2},{"lineBreak":true},{"text":"adi, anga sabsur-dulemar-odurdakegar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¡Be itomar! Yalaganba neg-oimake itoleged,","poem":1},{"text":"dulemar-ichesur-oimakedyob itoleged.","poem":2},{"text":"¡Be itomar! Neggwebur-dummagan-atosmalad-oimaked, be itomar,","poem":1},{"text":"mala-gollomakedyob e-oimaked itoleged.","poem":2},{"text":"Bab-Jehová-Bela-Gangued-Nikad, bila-onogega,","poem":1},{"text":"sorda-bila-onomalad-guagwar urbenaid.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Neggwebur-dikasulidba danimalad,","poem":1},{"text":"yarmar-bergunaid-akale danimalad.","poem":2},{"text":"Bab-Jehová, e-urwedba-ibmar-ebulemalad sedanikid,","poem":1},{"text":"adi, bela napneg obelogegar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"¡Be bomarsun! Bab-Jehová-urwemaid-iba omosad,","poem":1},{"text":"Bab-Dummad-Bela-Gangued-Nikad bemar sabsur-odurdakoed-e-iba danikid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A-ulale, bela argan nollomakdoed,","poem":1},{"text":"bela dulemar niga-argwatemaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bela-belad dobe-itodmaloed,","poem":1},{"text":"suli-suli-itomaloed, nunmaked-dummadi egi nagudmaloed.","poem":2},{"text":"Igi-sior-muu-neggi-ugakgunair nunmaked-itodae,","poem":1},{"text":"deyobi, egi nunmaked nagunonikoed.","poem":2},{"text":"Dukin-dukin geger na dakdemaloed,","poem":1},{"text":"e-wagarmar-daklegoedi, bela-bela dobed-nika daklemaloed.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"¡Be dakmar! Bab-Jehová-urwed-e-iba danikid:","poem":1},{"text":"Iba-buled dani, yeer-gangued-iba, bela-belad-urwed-iba dani,","poem":2},{"text":"napneg ollobi daarmakar nasikoed,","poem":1},{"text":"agine, bela dule-isgubukmalad obelogoed.","poem":2},"Bab-Jehová soged:"]},{"type":"verse","number":10,"content":[{"text":"“Niisgwamar mogir-biriba-nanaidi bar gaosulid,","poem":1},{"text":"niisgwamar-danar-danar nanaidi, bar ibegwar gaosulid.","poem":2},{"text":"Dad-ibeler-noalile, sichii naguoed,","poem":1},{"text":"bar nii ibegwar gaosulid.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Napneggi-dulemar-bukwad e-isgudiid-nukad an sabsur-odurdakoed,","poem":1},{"text":"dule-isganamar e-ibmar-isgana-imakdiidba an sabsur-imakoed.","poem":2},{"text":"Dule-na-san-dummarba-imakmaladi, na san-dummarba-imakega bar guosurmalad.","poem":1},{"text":"Dule-bulegan-na-san-dummarba-imakmaladi, na san-dummarba-san-saega bar guosurmalad","poem":2},{"lineBreak":true},{"text":"bela nug-bipi-gumalaga an imakoed.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Dulemar, olo-sunsoged-icheguedba bur ichee-bukuega an imakoed.","poem":1},{"text":"Dulemar, Ofir-or-nued-icheguedba ichee-bukuega an imakoed.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"A-ulale, ani Bab-Jehová-Bela-Gangued-Nikad, an-urwemaid-ibagangi an-urwedba nibneg giglimakega an imakoed.","poem":1},{"text":"Napneg e-naidgi ainirega an imakoed.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Dulemar igi-goe-sapur balegillemaidae,","poem":1},{"text":"deyob, balegillegoed, e-neggweburse duurmakdemaloed.","poem":2},{"text":"Igi-sibad-wawaad e-idugedsuli duurmakmadaedyobi gumaloed,","poem":1},{"text":"wala-walagwen e-yarse wakitemaloed.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Doa-dule galenonikile, ewarar oburgwilegoed,","poem":1},{"text":"dule yogasaar-galesale, es-suidgi oburgwilegoed.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dulemar-wagaba e-mimmigan omukudmaloed,","poem":1},{"text":"e-negmar-ibe ibmarmar atursadmaloed,","poem":2},{"lineBreak":true},{"text":"e-omegan e-ibe gagadmaloed.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Babilonia-dulemargi Media-dulemar gwichiguega an imakoed.","poem":1},{"text":"We-dulemar mani bai dakdasurmalad,","poem":2},{"lineBreak":true},{"text":"orgi gwen weligwar itodasurmalad.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"E-sigugi ese sapingana, yagana, oburgwilegoed,","poem":1},{"text":"goe-gwarugana gwen wile dakosurmalad,","poem":2},{"lineBreak":true},{"text":"burwigana gwen bai dakosurmalad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Babilonia-neggwebur, be yeerdakleged, gandikidba be yeer-dakleged,","poem":1},{"text":"Caldea-dulemarga be san-dummarbaa gusiid.","poem":2},{"text":"Emidi, Sodoma-neggweburyob be guoed,","poem":1},{"text":"Gomorra-neggweburyob be guoed.","poem":2},{"text":"Ani an Bab-Dummad gued.","poem":1},{"lineBreak":true},{"text":"Igi an we-neggweburmar obelosa,","poem":1},{"text":"deyob an be-imakmaloed.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bipisaale, bar dulemar egi ambikuosulid,","poem":1},{"text":"dulemar-sorba-danimaloedi bar egi ambikuosurmalad.","poem":2},{"text":"Árabe-dulemar we-yargi bar megosulid.","poem":1},{"text":"Sibad-wawaad-edarbedi, bar egi e-sibad-wawaadmar oambikuosulid.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Unnila nega-dulesulidganba ibmar-durgan-ursilimaladbi bukuoed.","poem":1},{"text":"E-negmargine, irmonbi ena ambikuoed,","poem":2},{"text":"nuu-dummad-malisuiganbi a-yargi ambikuoed,","poem":1},{"text":"sibad-omegan-sapurbarmaladbi gudidioed.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"E-neg-gandikmaladgi achu-sapurmarbi gordioed,","poem":1},{"text":"e-reynegmargi achu-sapur-uaya-gannareged-bunnu-wawaadmarbi gordioed.","poem":2},{"text":"Babilonia-neggwebur, Bab-Dummadse be sabsur-odurdakleged-igar omodanigusad,","poem":1},{"text":"bar bega ibamar obannolegosulid.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}