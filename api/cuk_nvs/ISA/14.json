{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"heading","content":["Babilonia-e-reygi dodolegar sunmaklesad"]},{"type":"verse","number":1,"content":["Ar Bab-Jehová wile Jacob-wagan-daknonikoed, gannale Israel-dulemar-sunonikoed. E-yala-sunnadgi-bukuega imaknonikoed. Dule-yar-baiganginmalad ese megnonimaloed, Jacob-waganba garmakdii gumaloed."]},{"type":"verse","number":2,"content":["Dulemar-bukidar Israel-dulemar-bendakmaloed, Israel-yarse sedmaloed. Geb degi, Israel-dulemar, e-galesgusmalayobi Bab-Jehová-yargi e-maiganga amar-imaknonimaloed. Degi, Israel-dulemar, dulemar-mesagwar-e-imaksamaladgi dummadga gumaloed."]},{"type":"verse","number":3,"content":["Israel-dulemar, Bab-Jehová be-bukib-binsadigusadgi baisur-itoge be-imaknonikile, degi, be-nunmak-itodigusadgi, be-ise-mesagwar-imaklesadgi, Bab-Jehová bemar-ollor-imaknonikile,"]},{"type":"verse","number":4,"content":["Babilonia-e-reygi we-sabsur-emar-obingesaar-namaklegedgi be weyob namakmaloed:",{"text":"“Dule-emar-mesagwar-sadiid, igi-gusa be dakmarsunna.","poem":1},{"text":"E-urwedi, igi-bergus be daksunna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bab-Jehová dule-isganamar-e-suar bibichisad,","poem":1},{"text":"dulemar-yeer-neg-gangu-semamaid-e-gaapoled bibichisad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"We-gaapoled dulemar-sabsuli-wiodii gusad,","poem":1},{"text":"urwedgi dulemargi-obindii, degi, balengindii gusad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Emidi, bela napneg bogigus naid,","poem":1},{"text":"weligwaledba binnasuli namakmalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Baryawarse-bakale, degi, Líbano-urwarse-bakale, Babilonia-e-rey, be-bergusadga wergumalad,","poem":1},{"text":"weyob sogmalad: ‘Be-bergusad-akale, bar dulemar anmar-omukudisurmalad.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Be-ibmar-imaksad-ular, neg-urba burgwarmalad-galu bebina itosmaid,","poem":1},{"text":"be-abindakagwar maid.","poem":2},{"text":"Be-ibmar-imaksad-ular, dule-burgwarmalad odaklealid.","poem":1},{"text":"Amala dule-dummaganga megismaladid.","poem":2},{"text":"Ar bela reymar-yar-bamaladgi-megisgusmaladi be-abin ainidagega,","poem":1},{"text":"e-ologanagi-bubukwadgi ogwislealid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bela wemar ibmar sogdamaloed, bega weyob sogdagoed:","poem":1},{"text":"‘Anmaryobi be ganguedsuli gunonisunde.","poem":2},{"lineBreak":true},{"text":"Be anmaryobi gunonimosunde.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Be-san-dummarba-na-be-imakdiid napa-uluba melledsun,","poem":1},{"text":"be-gar-arpa-goled bergunonimosun.","poem":2},{"text":"Emisgindi, nusu-imbagi be megmosunnoed,","poem":1},{"text":"nusubi ber biini be megmosunnoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Niisgwa-dummad-bolegoedba-gaardaed, ibiyobi be niba-nai argwannoniki.","poem":1},{"text":"Bee be, bela-bela dulemar-wiodiidid,","poem":2},{"lineBreak":true},{"text":"napnegse be e-gwallenonisunnad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Be-gwagegi weyob be sogsa gusanad: ‘Nibnegse an naoye.","poem":1},{"text":"Bab-Dummad-e-niisgwamar-birigi an-ologana an sioye.","poem":2},{"text":"Dad-nakwed-argan-sapiled-akar bab-dummad-baigan-e-yalagi,","poem":1},{"text":"dummadga an negsemai guoye.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mogirmar-bur-birise an nakoye,","poem":1},{"text":"Bab-Dummad-Bur-Biriginedyob an guoye.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Emide, burgwarmalad-galuse be balimellealid,","poem":1},{"text":"bela neg-ulubalidse be egwallesad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dulemar-be-dakmaladi, nue-nuu be-dakmaloed,","poem":1},{"text":"ar ade, geger be-dakmaloed, weyob binsadmaloed:","poem":2},{"lineBreak":true},{"text":"‘¿Wee we, napneg-wiodigusadi?","poem":2},{"lineBreak":true},{"text":"¿Wee we, yalamar-ogwayedii gusadi?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"¿We-dule we, napneg nega-dulesulidga imaksadi?","poem":1},{"text":"¿We-dule we, yalamar obelodii gusadi?","poem":2},{"lineBreak":true},{"text":"¿We-dule we, esgaryagi-dulemar-gales-bukwad gannar e-negse-naega gwen imakdasulidi?’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dulemar-yar-baid-baidgi-bukmalad-e-reymardi,","poem":1},{"text":"nug-nikadba nuegwadgi e-neg-uangi digar-digar mamaid.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ar bedi napa-ulugi-maidgi be-onosmalad,","poem":1},{"text":"igi durgan-nunud mileddae, deyob be-imaklesad.","poem":2},{"text":"Dule-es-suidgi-oburgwilegar-burgwismaladi, neg-uluba-melledmaladi,","poem":1},{"lineBreak":true},{"text":"bela be-omurus mamaid.","poem":1},{"text":"Dule, muigi dii-dii-annasadyobi be dakleged.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bedi gwen reymar-diglegeyobi nuedgi be diglegosulid,","poem":1},{"text":"ar be-yala be obelosad,","poem":2},{"lineBreak":true},{"text":"be-dulamar be ogilosad.","poem":2},{"lineBreak":true},{"text":"”Bipisaale dule-isganamar-e-wagan bar obarlegosulid.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Babgan-isgusad-ulale, e-mimmigan ogilolegega, ibmar-oburgwileged-neg guagwar imakmalo.","poem":2},{"text":"Adi, wemar melle yar-seedgi bar binsamalagar,","poem":1},{"text":"adi, melle bar napneggi neggweburmar-urbegar.”","poem":2}]},{"type":"verse","number":22,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob soged:",{"text":"“We-dulemargi ani an gwichiguoed,","poem":2},{"text":"ani an Babilonia-yala osulogoed, e-nuga an obelogoed,","poem":1},{"text":"dulemar-dulagudimaladi ani an obelogoed,","poem":2},{"text":"e-masmala, e-wagana ani an obelogoed.","poem":1},{"text":"Weyobi, ani an Bab-Jehová-guedi soged.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Neg-matabi-naguega an imakoed","poem":1},{"text":"akwanuku-negga an obinyoed.","poem":2},{"text":"Gwalagi-negdurwieyob Babilonia-yala an imakoed,","poem":1},{"text":"bar gudii an imakosulid.","poem":2},{"text":"Weyobi ani an Bab-Jehová-guedi soged.”","poem":1}]},{"type":"heading","content":["Isaías, Asiria-yargi-yoedse-ibmar-guoedgi sunmaksad"]},{"type":"verse","number":24,"content":["Bab-Jehová-Bela-Gangued-Nikad weyob ise-sogar imaksad:",{"text":"“Igi an igar-mesisa, deyob sogedba guodo.","poem":1},{"text":"Igi an sogsa, deyob sogedba imaklegodo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"An-yalagi, an Asiria-dulemar obelogoed,","poem":1},{"text":"an-yarmar-birgi, an amar-ogilogoed.","poem":2},{"text":"An-neggwebur bar ese mailedii guosulid,","poem":1},{"text":"ibmar-buleganba bar galitodii guosulid.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"We-igarde, ani an weyob bela yalamarga igar-mesisad.","poem":1},{"text":"We-igarde, ani an weyob bela yalamarse an oyosad.”","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ar Bab-Jehová-Bela-Gangued-Nikad weyob sogsasoggu,","poem":1},{"text":"¿doa e-igar gaosunna?","poem":2},{"text":"Ar e na igar mesisad, degite, ¿doa e-igar gaosunna?","poem":1},{"text":"¡Suli, dule gwen e-igar gaosuli!","poem":2}]},{"type":"heading","content":["Isaías, Filistea-dulemar-berguoedgi iduakwaa sunmaksad"]},{"type":"verse","number":28,"content":["Rey-Acaz-burgwisad-birgagine, Isaíasʼse we-gayaburba nonikid:"]},{"type":"verse","number":29,"content":[{"text":"“Bemar bela-Filistea-dulemar, yala-be-wiodigusad-bergusadba,","poem":1},{"text":"melle be weligwar itomalo.","poem":2},{"text":"Ar yala-baid bela-bela be-isdaradga guoed,","poem":1},{"text":"naibe-nued-gukualedba bur bule isganaga guoed.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ar dule-wileganadi, nue-mas-gundii gumaloed.","poem":1},{"text":"Ar dulemar ibmar-abesa-gudimaladi, ibmar nue-nikagudii gumaloed.","poem":2},{"text":"Degi-inigwele, Filistea-dulemar, an be-wagandi ukudba oburguoed,","poem":1},{"text":"be-dule-dula-napi-bukwadi bela an obelogoed.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Filistea-dulemar, gwage-nunmak-itogedba be binnasuli bomarsun.","poem":1},{"text":"¡Bela bemar dobe-itogedba be wawanmakmarsun!","poem":2},{"text":"Ar ade, sorda-bila-onomalad dad-nakwed-argan-sapiledsik waa-ainakweyob melledanikid,","poem":1},{"text":"dule bela danagwena duurmakdanikid.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"¿Igi-be we-yalaga-dule-garda-berbemalad-abin be sogoe?","poem":1},{"text":"Weyob be sogoed:","poem":2},{"text":"‘Ar Bab-Jehová Sión-yala sisad,","poem":1},{"text":"ar agi dule-wile-itodimalad dukued-neg amioed.’ ”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}