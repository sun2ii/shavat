{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["Moab-dulemar-yoedse-berguoedgi sunmaklesad"]},{"type":"verse","number":1,"content":["Isaías, Moab-neggwebur-berguoedgi iduakwaa sunmaksad.",{"text":"Moab-neggwebur-Arʼye-nugad bela ayarisad,","poem":1},{"text":"mutiki bergusad.","poem":2},{"text":"Moab-neggwebur-Kirʼye-nugad bela ayarisad,","poem":1},{"text":"mutiki bergusad.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dibón-neggweburginmalad, e-bab-dummadse-goled-negse nadmalad,","poem":1},{"text":"adi, e-bab-dummadga-ibmar-ogumakar-ukleged-ailase bonamalagar.","poem":2},{"text":"Moab-dulemar Nebo-neggwebur-bergusadga,","poem":1},{"text":"degi, Medeba-neggwebur-bergusadga, ogormakbukwad.","poem":2},{"text":"Bela sailagia-swiri-swiri imaksamalad,","poem":1},{"text":"aku-sigamarse-bakale, bela enismalad.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bela-dulemar boedbimalad,","poem":1},{"text":"galimbabali wile-itoged-mor yoyoidbimalad.","poem":2},{"text":"Neg-ubebbali ogormakdemalad,","poem":1},{"text":"dulemar-bukidar-ambikuedgi dulemar boedbimalad.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hesbón-dulemar, degi, Eleale-dulemar, wile-itogedba binnasuli e-bendakmarye gordidimalad,","poem":1},{"text":"e-binnasur-gordiidi Jahaza-neggweburse magar itoleged.","poem":2},{"text":"A-ulale, Moab-sorda-bila-onomalad dobedba-binnasuli gorbukwad,","poem":1},{"text":"bela-bela egi dobed nagunonikid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Moab-yar-ulale, an nue-bukib binsaed,","poem":1},{"text":"E-dulemar, Zoar-neggweburse duurmakmamaid,","poem":2},{"lineBreak":true},{"text":"Eglat-Selesiyáʼye-neg-nugadse duurmakmamaid.","poem":2},{"text":"Luhitʼye-neg-nugadba ise-boar-boar nakwemamaid.","poem":1},{"text":"Horonaim-neggwebur-igarba ise-boar-boar nadapmalad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nimrim-dianmar bela dingusad,","poem":1},{"text":"gagan-ara-aramalad bela dingusad.","poem":2},{"text":"Bar gagan-ara-aramalad nikagussulid,","poem":1},{"text":"bela gagan-ara-aramalad bergusad.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"A-ulale, dulemar-bukidar e-ibmar-nuegan-nikamaladi","poem":1},{"text":"Sauce-sapimar-dian-maid-obakar sesmalad.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dulemar-binnasuli-bodiidi, bela Moab-yalagi itolesad.","poem":1},{"text":"Dulemar-akigindiidi, bela Eglaim-neggweburse warmaksad,","poem":2},{"lineBreak":true},{"text":"degi, Beer-Elimʼye-neg-nugadse warmaksad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dimón-dian bela ablisbi-naid, bonigan napi-egi an barmidagoed:","poem":1},{"text":"Moab-dulemar-duurmakmaidgi achumigur-nono-wawaad an barmidagoed.","poem":2},{"lineBreak":true},{"text":"Amba dulemar-napneggi-bukwadgi achumigur-nono-wawaad an barmidagoed.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}