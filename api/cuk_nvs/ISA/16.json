{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"heading","content":["Moab-dulemar, Judá-yalagi dukusmalad"]},{"type":"verse","number":1,"content":["Isaías sogdebalid:",{"text":"“Sela-neggwebur-nega-dulesulidgi-siid-akale,","poem":1},{"text":"Sión-yalase, Israel-yala-dakmaidga be sibad-wawaad-senigana barmidmar.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moab-dulemar-omegan, nuu-e-uugi-ise-gwayar-noddaedyobi,","poem":1},{"text":"Arnón-diwargi obakmamai guoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"”Moab-dulemar, Sión-dulemarga weyob sogdanimalad:","poem":1},{"text":"‘Be igar-amimala, be sogmalo igi be imakmaloe.","poem":2},{"text":"Neg-ibginedgine mutikidyobi negsichidbi be anmarga nasike.","poem":1},{"text":"Dule-gwakiar-duurmakarmaladi be odukue,","poem":2},{"lineBreak":true},{"text":"melle dule-dukudimalad be urmako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Itoba Moab-dulemar-gwakiar-duurmakarmalad be bemar-walik dukudii imako,","poem":1},{"text":"dule-e-obelobigudiidgi be wis bendako.’","poem":2},{"lineBreak":true},{"text":"”Mesagwar-imakleged-ibagan bergusale,","poem":1},{"text":"sabsur-odurdakleged-ibagan bergusale,","poem":2},{"lineBreak":true},{"text":"napneggi dule-obeloged bergudoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Geb Rey-David-wagwa-gwensak, Israel-reyga megnonikoed.","poem":1},{"text":"E-yar-seoedi, innikigwadba yar seoed,","poem":2},{"text":"binsaed-nikaa yar seoed,","poem":1},{"text":"nueganbi dulemar-idugoed,","poem":2},{"lineBreak":true},{"text":"dulemarga igar-naboged ega gwae imaknonikoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"”Anmar itodiid, Moab-dulemar doggus na san-dummarba-imakmarye.","poem":1},{"text":"Wemar na bule-bule-na-san-imakdimalad.","poem":2},{"text":"Dule-buledye na sogdimalad.","poem":1},{"text":"Doggus-e-sunmakedgi emar-mesagwar imakdimalad.","poem":2},{"lineBreak":true},{"text":"Ar binsarsunna deyob-damalad anmar nue-wisid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Degisoggu, Moab-dulemar ogormakdemaloed,","poem":1},{"text":"bela e-yalaga boedbimaloed.","poem":2},{"text":"Kir-Hareset-uva-maduga bomaloed","poem":1},{"text":"ega bukib-binsamaloed,","poem":2},{"lineBreak":true},{"text":"bukib-binsaedba ega wile itomaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ar Hesbón-dulemar-nainu bela dingusad,","poem":1},{"text":"Sibma-neggwebur-e-uva-nainu deyob naimogad.","poem":2},{"text":"Dulemar-yar-baid-baidgi-bukmalad-negsemamaid, uva-nainu-nuegan obelosmalad.","poem":1},{"text":"E-dubagan-Jazer-yalase-warmaknanainadgi,","poem":2},{"text":"nega-dulesulidganse-warmaknanainadgi,","poem":1},{"text":"e-dubagan-demarse-batenanainadgi, bela dii-dii imaksamalad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"A-ulale, an Jazer-yala-e-uva-nainubina booed,","poem":1},{"text":"an Sibma-neggwebur-e-nainuga bomogoed.","poem":2},{"text":"An Hesbón-dulemarga, Eleale-dulemarga an-ibyanis aryogoed.","poem":1},{"text":"Ar dule-weligwar-imakega bar e-nainugi ibmar-gwagmar nikuosulid,","poem":2},{"lineBreak":true},{"text":"ibmar-gwagmar gwen bar weelegosulid.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nainugi bar wergulegosulid.","poem":1},{"text":"Uva-nainugi dulemar bar namake itolegosulid,","poem":2},{"lineBreak":true},{"text":"binnasuli dulemar-goled bar itolegosulid,","poem":2},{"text":"uva-egurelegedgi dulemar bar uva egured daklegosulid,","poem":1},{"text":"uva-welegedgi binnasur-gorledaedi ani an osulosad.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Degisoggu, an-gwage, Moab-dulemar-ular,","poem":1},{"text":"Kir-Hareset-neggwebur-ular, gar-arpa-dub-nakwamaknaiyobi, wile-itonaid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ar Moab-dulemar aisaar na e-bab-dummaganga-ibmar-ogumakar-ukleged-ailase-namalo-inigwele,","poem":1},{"text":"bendakleged amiosurmalad, yegudamaloed.","poem":2},{"text":"E-bab-dummadse-goled-neg-islidikidse e-bab-dummadse gornamalo-inigwele,","poem":1},{"text":"gwen ega igarga guosulid, bela bergus naoed.”","poem":2}]},{"type":"verse","number":13,"content":["Bab-Jehová weyob epenne Moab-dulemargi ibmar-guoedi sogsagusad."]},{"type":"verse","number":14,"content":["Emidi, Bab-Jehová weyob soged: “Igi-dule unnila birgapaa arbadae, deyobi, birgapaasega Moab-yala-e-yeerdaklegedi, berguoed. E-dulemala burgwemaloed. E-dula, unnila napi-ichee bemaloed, garganguedsuli gumaloed.”"]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}