{"translation":{"id":"cuk_nvs","name":"Bab-Dummad-Garda-Islidikid","website":"https://ebible.org/Scriptures/details.php?id=cuk","licenseUrl":"https://ebible.org/Scriptures/details.php?id=cuk","licenseNotes":null,"shortName":"NVS","englishName":"San Blas Kuna Bible","language":"cuk","textDirection":"ltr","sha256":"cb90ca2966511b886ecc4f8c71b6ff79e09c83bae1e96d536ba69a437b9f63a0","availableFormats":["json"],"listOfBooksApiLink":"/api/cuk_nvs/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31100,"languageName":"San Blas Kuna","languageEnglishName":"San Blas Kuna"},"book":{"id":"ISA","translationId":"cuk_nvs","name":"Isaías","commonName":"Isaías","title":"ISAÍAS-GARDA ISAÍAS","order":23,"numberOfChapters":66,"sha256":"dacfe5a80412134b995a472c66ca1044f0b522a9b6f77575c5c024b9374153c3","firstChapterNumber":1,"firstChapterApiLink":"/api/cuk_nvs/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/cuk_nvs/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":17,"content":[{"type":"heading","content":["Damascoʼgi-yoedse-ibmar-guoedgi sunmaklesad"]},{"type":"verse","number":1,"content":["Isaías, Damasco-neggweburgi iduakwaa sunmaksad: Bab-Jehová-Bela-Gangued-Nikad weyob sogdo.",{"text":"“¡Damasco-neggwebur-siid be nue-dakmar!","poem":1},{"text":"¡Bar neggweburga sii guosulid!","poem":2},{"lineBreak":true},{"text":"¡Nue bibichis sigoed!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aroer-neggweburmar ollobi melledoed,","poem":1},{"text":"gagan-ara-aramaladbi naguoed.","poem":2},{"lineBreak":true},{"text":"Agine, sibad-wawaadmar dobed-nikasuli gagan-madii gumaloed.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Efraín-dulemar-e-neggwebur-gandikid-siid berguoed,","poem":1},{"text":"Damasco-neggwebur-Siriaʼgi-siid bergumogoed.","poem":2},{"lineBreak":true},{"text":"Aram-dulemar-napi-durgumaloedi, e-ibmar-nuegana Israel-dulemargadga guoed.”","poem":2}]},{"type":"heading","content":["Israel-dulemar sabsur-odurdaklegoed"]},{"type":"verse","number":4,"content":["Bab-Dummad sogdebalid:",{"text":"“Siria-yala-gandik-siid bela bergusale,","poem":1},{"text":"Israel-dulemar-e-gangued bela nollomakdemogoed.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dule-ibmar-gwag-weed ibmar-gwag-welesadyobi,","poem":1},{"text":"Israel-dulemar-e-gangued guoed.","poem":2},{"text":"Dule na e-argangi ibmar-gwag-weesayobi,","poem":1},{"text":"Israel-dulemar-e-gangued berguoed.","poem":2},{"text":"Refaim-nebagi ibmar-gwag-welesad-besmaladyobi,","poem":1},{"text":"Israel-dulemar ichee bemaloed.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Degine, igi-dule olivo-san-osiamaksale, e-anagan-matusulid-dukugi napi gwabo, gwapaadibe, nagusdae,","poem":1},{"text":"deyobi, Israel-dulemar napi-ichee bemaloed.","poem":2},{"text":"Ar igi olivo-san bela e-sapi-anagangi","poem":1},{"text":"gwabake, gwaatardibe napi-nagusdae, deyobi, napi-bemaloed.”","poem":2},"Deyobi, Bab-Jehová-Bela-Gangued-Nikad sogdo."]},{"type":"verse","number":7,"content":[{"text":"A-ibagine, Israel-dulemar, e-Obinnisad amidagoed.","poem":1},{"text":"Israel-dulemar, e-Bab-Dummad-Isligwaledse gannar atakdemaloed.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bar bab-dummad-Baalʼga-ibmar-ogumakar-ukleged-aila-sobsamaladgi binsadosurmalad.","poem":1},{"text":"Bar bab-bundor-Asera-sobarmalad-dakdosurmalad,","poem":2},{"text":"ina-wawad-ogumaked-ailase naosurmalad.","poem":1},{"text":"Ar we-bab-dummagan-ibmarmar e-argangi sobsagusmaladid.","poem":2}]},{"type":"verse","number":9,"content":["A-ibagine, Israel-e-neggwebur-gandikmaladi, ollobi mellede gumaloed, sapurbi-moodo, negmar-ollobi-mellenaiyobi naguoed. Igi Israel-dulemar Canaán-e-neggweburmargi dognonigusmargu, neg-imaksamala, deyob bela-neg-ollo naguoed."]},{"type":"verse","number":10,"content":[{"text":"Ar bemarde Bab-Dummad-bemar-abonoged be iesmalad,","poem":1},{"text":"Bab-Dummad bemarga-akwasailayob-gued be iedmalad.","poem":2},{"text":"A-ulale, bemar amba ibmar-durba-nuegan digmalo-inigwele,","poem":1},{"text":"amba neggwebur-baidsik-uva-danikid digmalo-inigwele,","poem":2},{"lineBreak":true},{"text":"bela boniganba ibmar-gwag isgudoed.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Amba bemar-uva-digsad bega dungumalo-inigwele, banegi e-durba ainidago-inigwele, bonigan egi nonikoed.","poem":1},{"text":"Ar bemar ibmar-gwag-weemaloedi, bela boniganba ibmar-gwag isgudoed.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bukidar dule-yar-baid-baidgi-bukmalad-uurmakbukwadi, ¡duledar-wilesmar!","poem":1},{"text":"Demar-uurmakmaiyobi dulemar uurmakbukwad.","poem":2},{"text":"Dulemar-binnasuli-oimakbukwadi, ¡duledar-wilesmar!","poem":1},{"text":"Dii-wilasailad uurmakmaidyobi dulemar oimakbukwad.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"We-dulemar, demar-uurmakmaid-dagumakmaidyob-damar-inigwele,","poem":1},{"text":"Bab-Dummad ese-binnasur-uludele, duurmakdedamalad.","poem":2},{"text":"Igi yarbali gagan-dinnagana burwa-abin seleddae,","poem":1},{"text":"deyobi, dulemar duurmakdedamalad.","poem":2},{"text":"Igi ukub burwa-binnasur-goledba mileddae,","poem":1},{"text":"deyobi, dulemar duurmakdedamalad.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"¡Sedogusale, dobed-dummad egi nagusdamalad!","poem":1},{"text":"Oibosale, dule-isganamar bar dakleddasulid.","poem":2},{"text":"Weyob dulemar-anmar-wiodimalad guodo.","poem":1},{"text":"Anmar-ibe dule-ibmar-atursadimaladga, weyob ega igar idu maid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/cuk_nvs/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/cuk_nvs/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/cuk_nvs/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}